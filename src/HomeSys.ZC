//Place this file in /Home and change
//anything you want.

U0 UserStartUp()
{//Run each time a user a spawned
	DocTermNew;
	Type("::/Doc/Start.DD");
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
	Dir;
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

//Boot terminal geometry, in text cells. Not a tile: the desktop is the
//background, the terminal is a window on it.
#define BOOT_TERM_COLS	96
#define BOOT_TERM_ROWS	40
#define BOOT_TERM_SEED	2	//rows it starts at, before the open animation

CTask *boot_term_task = NULL;

extern Bool yde_boot_done; //StartOS.ZC sets this once boot has finished.

I64 BootTermLeft()
{
	I64 l = (TEXT_COLS - BOOT_TERM_COLS) / 2;

	if (l < 1)
		l = 1;

	return l;
}

I64 BootTermTop()
{//Top row of the FINAL window. The animation grows down from the middle.
	I64 t = (TEXT_ROWS - BOOT_TERM_ROWS) / 2;

	if (t < 1)
		t = 1;

	return t;
}

U0 BootTermOpenTask()
{//Grow the boot terminal to full height once the splash is down. Runs in its
//own task: StartUpTasks is on the boot path and must not sleep for a second.
	CTask	*t = boot_term_task;
	I64		 i, top, bot, mid, steps = 14;
	F64		 t0 = tS;

	top = BootTermTop();
	bot = top + BOOT_TERM_ROWS - 1;
	mid = top + BOOT_TERM_ROWS / 2;

	while (!yde_boot_done && tS - t0 < 60.0)
		Sleep(50);
	Sleep(900); //splash dismisses ~700ms after yde_boot_done; open behind it

	if (!TaskValidate(t))
		return;
	for (i = 1; i <= steps; i++)
	{//Expand from a sliver at the vertical centre out to the full box.
		WinVert(mid - (mid - top) * i / steps,
				mid + (bot - mid) * i / steps, t);
		Sleep(18);
	}
	WinVert(top, bot, t);
	WinToTop(t);
	WinFocus(t);
	WinZBufUpdate;
}

U0 StartUpTasks()
{
	CTask *user = User;
	I64	   l, mid;

	l	= BootTermLeft();
	mid	= BootTermTop() + BOOT_TERM_ROWS / 2;

	//The YDE splash is a full-screen overlay (see DE/Splash.ZC), so the
	//terminal + AutoComplete may spawn normally right now - they render
	//underneath it and appear when it is dismissed. No wait needed.
	boot_term_task = user;
	WinHorz(l, l + BOOT_TERM_COLS - 1, user);
	WinVert(mid - BOOT_TERM_SEED / 2, mid + BOOT_TERM_SEED / 2, user);
	WinToTop(user);
	"Boot Time:%7.3fs\n", tS;
	XTalk(user, "Cd; #include \"Once\";\n");
	Silent; //no output to screen
	ACInit("/*;!*/Bible.TXT;!*/Clementine.TXT;!*/PCIDevices.DD;!*/HTML/*;!*/ChangeLog.DD");
	Silent(OFF); //no output to screen

	Spawn(&BootTermOpenTask, NULL, "Term Open");
}

StartUpTasks;

"\n%s\n\n", sys_os_version_nice;