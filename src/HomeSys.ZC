//Place this file in /Home and change
//anything you want.

U0 UserStartUp()
{//Run each time a user a spawned
	DocTermNew;
	Type("::/Doc/Start.DD");
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
	Dir;
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

extern U0 (*boot_term_fp)(CTask *task); //::/DE/BootTerm.ZC, NULL with no desktop.

U0 StartUpTasks()
{
	CTask *user = User;

	//Geometry precedes anything slow. User() opens at the default full window;
	//ACInit below runs for seconds, and a resize after it is visible.
	if (boot_term_fp)
		(*boot_term_fp)(user);

	//The YDE splash (DE/Splash.ZC) as a full-screen overlay.
	"Boot Time:%7.3fs\n", tS;
	XTalk(user, "Cd; #include \"Once\";\n");
	Silent; //no output to screen

	ACInit("/*;!*/Bible.TXT;!*/Clementine.TXT;!*/PCIDevices.DD;!*/HTML/*;!*/ChangeLog.DD"
		   ";!*/Apps/QuakePlus/*;!*/Apps/UT99/*;!*/Apps/HL1/*;!*/Apps/Diablo1/*"
		   ";!*/Apps/Quake/*;!*/Apps/YTracker/Examples/*;!*/Home/Music/*");

	//<SHIFT-ALT-A> restores it.
	AutoComplete(OFF);
	Silent(OFF); //no output to screen

	if (!boot_term_fp)
	{//No desktop: stock tiling.
		WinToTop(user);
		WinTileVert;
	}
}

StartUpTasks;

"\n%s\n\n", sys_os_version_nice;
