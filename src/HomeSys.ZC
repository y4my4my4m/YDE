//Place this file in /Home and change
//anything you want.

U0 UserStartUp()
{//Run each time a user a spawned
	DocTermNew;
	Type("::/Doc/Start.DD");
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
	Dir;
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

extern U0 (*boot_term_fp)(CTask *task); //::/DE/BootTerm.ZC, NULL with no desktop.

U0 StartUpTasks()
{
	CTask *user = User;

	//Geometry FIRST, before anything slow. User() opens at the default full
	//window; ACInit below can run for seconds, and any of that time spent at
	//the wrong size is a resize the user watches happen.
	if (boot_term_fp)
		(*boot_term_fp)(user);

	//The YDE splash is a full-screen overlay (see DE/Splash.ZC), so the
	//terminal and AutoComplete spawn normally right now: they render
	//underneath it and appear when it clears.
	"Boot Time:%7.3fs\n", tS;
	XTalk(user, "Cd; #include \"Once\";\n");
	Silent; //no output to screen
	ACInit("/*;!*/Bible.TXT;!*/Clementine.TXT;!*/PCIDevices.DD;!*/HTML/*;!*/ChangeLog.DD");
	//Indexed but with no task, so its floating window does not land on the
	//desktop during the boot terminal's open animation. The AC task re-shows
	//itself every 333ms whatever the display flag says, so clearing the flag
	//does not hold. <SHIFT-ALT-A> brings it back.
	AutoComplete(OFF);
	Silent(OFF); //no output to screen

	if (!boot_term_fp)
	{//No desktop: stock tiling.
		WinToTop(user);
		WinTileVert;
	}
}

StartUpTasks;

"\n%s\n\n", sys_os_version_nice;
