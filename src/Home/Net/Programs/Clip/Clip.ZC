// Network clipboard bridge for YKD (QEMU guest <-> host). Syncs sys_clip_doc
// with the host over HTTP. Host side is utils/clipd.py, reached at 10.0.2.2,
// the QEMU user-net gateway. ClipStart; / ClipStop;

#define CLIP_URL	"http://10.0.2.2:9999/"
#define CLIP_POLL_MS	500

Bool	clip_running = FALSE;
U8	   *clip_last	= NULL;		// anti-echo

Bool ClipChanged(U8 *now)
{
	if (!clip_last)
		return TRUE;
	return StrCompare(now, clip_last) != 0;
}

U0 ClipRemember(U8 *text)
{
	if (clip_last)
		Free(clip_last);
	clip_last = text;
}


U8 *ClipHostGet()
{ // MAlloc'd string or NULL
	CHttpResponse	*r = HttpGet(CLIP_URL);
	U8				*s;
	if (!r || r->status != 200)
	{
		if (r) HttpResponseFree(r);
		return NULL;
	}
	s = MAlloc(r->body_length + 1);
	MemCopy(s, r->body, r->body_length);
	s[r->body_length] = 0;
	HttpResponseFree(r);
	return s;
}

Bool ClipHostSet(U8 *text)
{
	CHttpResponse	*r = HttpPost(CLIP_URL, text, "text/plain");
	Bool			 ok = r && r->status == 200;
	if (r) HttpResponseFree(r);
	return ok;
}


U8 *ClipDocGet()
{ // MAlloc'd, never NULL. Multi-line copies may flatten.
	CDoc		*doc = sys_clip_doc;
	Bool		 unlock = DocLock(doc);
	CDocEntry	*e = doc->head.next;
	U8			*buf = MAlloc(0x10000);
	I64			 o = 0, l;

	while (e != doc && o < 0xFF00)
	{
		if (e->de_flags & DOCEF_TAG && e->tag)
		{
			l = StrLen(e->tag);
			if (o + l < 0xFF00)
			{
				MemCopy(buf + o, e->tag, l);
				o += l;
			}
		}
		e = e->next;
	}
	buf[o] = 0;
	if (unlock)
		DocUnlock(doc);
	return buf;
}

U0 ClipDocSet(U8 *text)
{
	CDoc	*doc = sys_clip_doc;
	Bool	 unlock = DocLock(doc);
	DocReset(doc, TRUE);
	DocPrint(doc, "%s", text);			// %s passes text literally
	if (unlock)
		DocUnlock(doc);
}


U0 ClipSyncTask()
{ // one direction per tick; guest copies take priority
	U8 *g, *h;

	clip_running = TRUE;

	h = ClipHostGet();
	if (h && *h)
	{
		ClipDocSet(h);
		ClipRemember(h);
	}
	else if (h)
		Free(h);

	while (clip_running)
	{
		g = ClipDocGet();
		if (*g && ClipChanged(g))
		{
			ClipHostSet(g);
			ClipRemember(g);
		}
		else
		{
			Free(g);
			h = ClipHostGet();
			if (h && *h && ClipChanged(h))
			{
				ClipDocSet(h);
				ClipRemember(h);
			}
			else if (h)
				Free(h);
		}
		Sleep(CLIP_POLL_MS);
	}
}

public U0 ClipStart()
{
	if (clip_running)
	{ "Clipboard bridge already running.\n"; return; }
	Spawn(&ClipSyncTask, NULL, "ClipSync");
	"$$GREEN$$Clipboard bridge on -- Ctrl+C / Ctrl+V now sync with the host.$$FG$$\n";
	"(Make sure clipd.py is running on the host.)\n";
}

public U0 ClipStop()
{
	clip_running = FALSE;
	"Clipboard bridge stopping.\n";
}

public U0 ClipTest()
{
	CHttpResponse	*r;

	"$$LTBLUE$$Bridge test -> %s$$FG$$\n", CLIP_URL;

	r = HttpPost(CLIP_URL, "hello-from-zealos", "text/plain");
	if (!r)
		"$$RED$$POST: no response. Host unreachable -- clipd.py not running, wrong port, or firewall. Try Ping(0x0A000202) [10.0.2.2].$$FG$$\n";
	else
	{
		if (r->status == 200)
			"$$GREEN$$POST HTTP 200 -- check the host clipboard now, it should read: hello-from-zealos$$FG$$\n";
		else
			"$$RED$$POST HTTP %d -- daemon reached but the clipboard set failed (wl-copy/xclip missing on host?).$$FG$$\n", r->status;
		HttpResponseFree(r);
	}

	r = HttpGet(CLIP_URL);
	if (!r)
	{ "$$RED$$GET: no response.$$FG$$\n"; return; }
	"GET HTTP %d, %d bytes read from the host clipboard.\n", r->status, r->body_length;
	HttpResponseFree(r);
}

public U0 ClipPush()
{
	U8 *g = ClipDocGet();
	if (ClipHostSet(g))	"$$GREEN$$Pushed %d bytes to the host.$$FG$$\n", StrLen(g);
	else				"$$RED$$Push failed (is clipd.py running?).$$FG$$\n";
	Free(g);
}

public U0 ClipPull()
{
	U8 *h = ClipHostGet();
	if (h)
	{
		ClipDocSet(h);
		"$$GREEN$$Pulled %d bytes from the host into the clipboard (Ctrl+V to paste).$$FG$$\n", StrLen(h);
		Free(h);
	}
	else
		"$$RED$$Pull failed (is clipd.py running?).$$FG$$\n";
}
