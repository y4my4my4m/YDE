// Clipboard bridge for YKD (QEMU guest <-> host). Syncs sys_clip_doc with the
// host over the SPICE vdagent protocol on virtio-serial, so nothing runs on
// the host side. ClipStart; / ClipStop;
//
// No networking: the transport is a PCI device, not a socket.

#define CLIP_POLL_MS	500

Bool	clip_running = FALSE;
U8	   *clip_last	= NULL;		// anti-echo

Bool ClipChanged(U8 *now)
{
	if (!clip_last)
		return TRUE;
	return StrCompare(now, clip_last) != 0;
}

U0 ClipRemember(U8 *text)
{
	if (clip_last)
		Free(clip_last);
	clip_last = text;
}


U8 *ClipHostGet()
{//What the host published, MAlloc'd, or NULL.
	return VSerClipGet;
}

Bool ClipHostSet(U8 *text)
{
	return VSerClipSet(text);
}

U8 *ClipDocGet()
{ // MAlloc'd, never NULL. Multi-line copies may flatten.
	CDoc		*doc = sys_clip_doc;
	Bool		 unlock = DocLock(doc);
	CDocEntry	*e = doc->head.next;
	U8			*buf = MAlloc(0x10000);
	I64			 o = 0, l;

	while (e != doc && o < 0xFF00)
	{
		if (e->de_flags & DOCEF_TAG && e->tag)
		{
			l = StrLen(e->tag);
			if (o + l < 0xFF00)
			{
				MemCopy(buf + o, e->tag, l);
				o += l;
			}
		}
		e = e->next;
	}
	buf[o] = 0;
	if (unlock)
		DocUnlock(doc);
	return buf;
}

U0 ClipDocSet(U8 *text)
{
	CDoc	*doc = sys_clip_doc;
	Bool	 unlock = DocLock(doc);
	DocReset(doc, TRUE);
	DocPrint(doc, "%s", text);			// %s passes text literally
	if (unlock)
		DocUnlock(doc);
}


U0 ClipSyncTask()
{ // one direction per tick; guest copies take priority
	U8 *g, *h;

	clip_running = TRUE;

	h = ClipHostGet();
	if (h && *h)
	{
		ClipDocSet(h);
		ClipRemember(h);
	}
	else if (h)
		Free(h);

	while (clip_running)
	{
		g = ClipDocGet();
		if (*g && ClipChanged(g))
		{
			ClipHostSet(g);
			ClipRemember(g);
		}
		else
		{
			Free(g);
			h = ClipHostGet();
			if (h && *h && ClipChanged(h))
			{
				ClipDocSet(h);
				ClipRemember(h);
			}
			else if (h)
				Free(h);
		}
		Sleep(CLIP_POLL_MS);
	}
}

public U0 ClipStart()
{
	if (clip_running)
	{ "Clipboard bridge already running.\n"; return; }
	Spawn(&ClipSyncTask, NULL, "ClipSync");
	"$$GREEN$$Clipboard bridge on -- Ctrl+C / Ctrl+V now sync with the host.$$FG$$\n";
	"(vdagent over virtio-serial; nothing runs on the host.)\n";
}

public U0 ClipStop()
{
	clip_running = FALSE;
	"Clipboard bridge stopping.\n";
}

public U0 ClipTest()
{
	if (!VSerPresent)
	{
		VSerRep;
		"$$RED$$No vdagent channel.$$FG$$\n";
		"QEMU needs:\n";
		"  -device virtio-serial-pci\n";
		"  -chardev qemu-vdagent,id=vd,clipboard=on\n";
		"  -device virtserialport,chardev=vd,name=com.redhat.spice.0\n";
		return;
	}
	VSerRep;
	"$$GREEN$$vdagent channel open on port %d.$$FG$$\n", VSerPortOf;
	VSerClipSet("hello-from-zealos");
	"Published to the host. The bytes move when the host asks for them, so\n";
	"check the host clipboard in a moment.\n";
}

public U0 ClipPush()
{
	U8 *g = ClipDocGet();
	if (ClipHostSet(g))	"$$GREEN$$Pushed %d bytes to the host.$$FG$$\n", StrLen(g);
	else				"$$RED$$Push failed (no vdagent channel).$$FG$$\n";
	Free(g);
}

public U0 ClipPull()
{
	U8 *h = ClipHostGet();
	if (h)
	{
		ClipDocSet(h);
		"$$GREEN$$Pulled %d bytes from the host into the clipboard (Ctrl+V to paste).$$FG$$\n", StrLen(h);
		Free(h);
	}
	else
		"$$RED$$Nothing from the host yet (it publishes on demand).$$FG$$\n";
}
