// SSH-2 auth: service request + password userauth. Needs SSHTransport.

#define SSH_MSG_USERAUTH_REQUEST	50
#define SSH_MSG_USERAUTH_FAILURE	51
#define SSH_MSG_USERAUTH_SUCCESS	52
#define SSH_MSG_USERAUTH_BANNER		53
#define SSH_MSG_GLOBAL_REQUEST		80
#define SSH_MSG_REQUEST_SUCCESS		81
#define SSH_MSG_REQUEST_FAILURE		82

I64 SSHRecvFiltered(CSSH *ssh, U8 *payload, I64 *len_out)
{ // one encrypted packet, swallowing transport housekeeping. Channel messages
  // (90-100) and everything else are returned to the caller.
	I64 len;

	while (TRUE)
	{
		if (SSHPacketRecv(ssh, payload, &len) < 0)
			return -1;
		if (len >= 1)
		{
			switch (payload[0])
			{
				case SSH_MSG_DISCONNECT:
					NetErr("SSH: server sent DISCONNECT.");
					return -1;

				case SSH_MSG_IGNORE:
				case SSH_MSG_UNIMPLEMENTED:
				case SSH_MSG_DEBUG:
					break;

				case SSH_MSG_GLOBAL_REQUEST:
				{ // string(name) bool(want_reply). Decline if a reply is wanted.
					I64 nlen = SSHGetU32(payload + 1);
					U8	want_reply = payload[1 + 4 + nlen];
					if (want_reply)
						SSHPacketSendByte(ssh, SSH_MSG_REQUEST_FAILURE);
					break;
				}

				default:
					*len_out = len;
					return 0;
			}
		}
	}
}

I64 SSHServiceRequest(CSSH *ssh, U8 *service)
{
	U8	*pl = MAlloc(SSH_MAX_PACKET);
	I64	 o = 0, len;

	o = SSHPutByte(pl, o, SSH_MSG_SERVICE_REQUEST);
	o = SSHPutStringZ(pl, o, service);
	if (SSHPacketSend(ssh, pl, o) < 0)
		goto fail;

	if (SSHRecvFiltered(ssh, pl, &len) < 0)
		goto fail;
	if (len < 1 || pl[0] != SSH_MSG_SERVICE_ACCEPT)
	{
		NetErr("SSH: expected SERVICE_ACCEPT, got msg %d.", pl[0]);
		goto fail;
	}
	Free(pl);
	return 0;
fail:
	Free(pl);
	return -1;
}

Bool SSHAuthPassword(CSSH *ssh, U8 *user, U8 *password)
{ // returns TRUE on USERAUTH_SUCCESS.
	U8	*pl = MAlloc(SSH_MAX_PACKET);
	I64	 o = 0, len;

	o = SSHPutByte(pl, o, SSH_MSG_USERAUTH_REQUEST);
	o = SSHPutStringZ(pl, o, user);
	o = SSHPutStringZ(pl, o, "ssh-connection");
	o = SSHPutStringZ(pl, o, "password");
	o = SSHPutByte(pl, o, 0);				// FALSE: not a password change
	o = SSHPutStringZ(pl, o, password);
	if (SSHPacketSend(ssh, pl, o) < 0)
		goto fail;

	while (TRUE)
	{
		if (SSHRecvFiltered(ssh, pl, &len) < 0)
			goto fail;
		if (len >= 1)
		{
			if (pl[0] == SSH_MSG_USERAUTH_SUCCESS)
			{
				Free(pl);
				return TRUE;
			}
			else if (pl[0] == SSH_MSG_USERAUTH_FAILURE)
			{
				NetErr("SSH: password auth rejected.");
				goto fail;
			}
			else if (pl[0] != SSH_MSG_USERAUTH_BANNER)
			{ // BANNER: ignore and read the next
				NetErr("SSH: unexpected auth reply msg %d.", pl[0]);
				goto fail;
			}
		}
	}
fail:
	Free(pl);
	return FALSE;
}

Bool SSHAuthPubkey(CSSH *ssh, U8 *user, U8 *sk64, U8 *pk32)
{ // Ed25519 publickey userauth (RFC 4252 7). sk64 = seed||pub, pk32 = pub.
  // Returns TRUE on USERAUTH_SUCCESS.
	U8	*pl	= MAlloc(SSH_MAX_PACKET);
	U8	*sd	= MAlloc(SSH_MAX_PACKET);	// data to be signed
	U8	 keyblob[128], sigblob[128], sig[64];
	I64	 kb = 0, sgb = 0, so = 0, o = 0, len;

	// public key blob = string("ssh-ed25519") + string(pubkey)
	kb = SSHPutStringZ(keyblob, kb, "ssh-ed25519");
	kb = SSHPutString(keyblob, kb, pk32, 32);

	// signed data = string(session_id) + the request through the key blob
	so = SSHPutString(sd, so, ssh->sess_id, 32);
	so = SSHPutByte(sd, so, SSH_MSG_USERAUTH_REQUEST);
	so = SSHPutStringZ(sd, so, user);
	so = SSHPutStringZ(sd, so, "ssh-connection");
	so = SSHPutStringZ(sd, so, "publickey");
	so = SSHPutByte(sd, so, 1);
	so = SSHPutStringZ(sd, so, "ssh-ed25519");
	so = SSHPutString(sd, so, keyblob, kb);

	Ed25519Sign(sig, sd, so, sk64);

	// signature blob = string("ssh-ed25519") + string(R||S)
	sgb = SSHPutStringZ(sigblob, sgb, "ssh-ed25519");
	sgb = SSHPutString(sigblob, sgb, sig, 64);

	// the actual request: same fields + the signature
	o = SSHPutByte(pl, o, SSH_MSG_USERAUTH_REQUEST);
	o = SSHPutStringZ(pl, o, user);
	o = SSHPutStringZ(pl, o, "ssh-connection");
	o = SSHPutStringZ(pl, o, "publickey");
	o = SSHPutByte(pl, o, 1);
	o = SSHPutStringZ(pl, o, "ssh-ed25519");
	o = SSHPutString(pl, o, keyblob, kb);
	o = SSHPutString(pl, o, sigblob, sgb);
	if (SSHPacketSend(ssh, pl, o) < 0)
		goto pkfail;

	while (TRUE)
	{
		if (SSHRecvFiltered(ssh, pl, &len) < 0)
			goto pkfail;
		if (len >= 1)
		{
			if (pl[0] == SSH_MSG_USERAUTH_SUCCESS)
			{ Free(pl); Free(sd); return TRUE; }
			else if (pl[0] == SSH_MSG_USERAUTH_FAILURE)
			{ NetErr("SSH: pubkey auth rejected."); goto pkfail; }
			else if (pl[0] != SSH_MSG_USERAUTH_BANNER)
			{ NetErr("SSH: unexpected pubkey reply msg %d.", pl[0]); goto pkfail; }
		}
	}
pkfail:
	Free(pl);
	Free(sd);
	return FALSE;
}
