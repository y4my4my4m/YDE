// Bookmarks and per-site credentials.
//
// ::/Home/Config/Telnet/Bookmarks.TXT   name<TAB>host<TAB>port
// ::/Home/Config/Telnet/Credentials.TXT host<TAB>port<TAB>user<TAB>password
//
// Both are hand-editable text, one record per line, '#' comments. Passwords are
// stored in the clear: RedSea has no permissions and the wire protocol has no
// encryption either.

#define TN_CFG_DIR    "::/Home/Config/Telnet"
#define TN_BOOK_PATH  "::/Home/Config/Telnet/Bookmarks.TXT"
#define TN_CRED_PATH  "::/Home/Config/Telnet/Credentials.TXT"

#define TN_BOOK_MAX   64
#define TN_CRED_MAX   64
#define TN_TAIL_LEN   96  // rolling window scanned for login prompts

// Autologin states.
#define TN_AL_OFF     0
#define TN_AL_USER    1
#define TN_AL_PASS    2
#define TN_AL_DONE    3

#define TN_NAME_LEN   48
#define TN_HOST_LEN   96
#define TN_USER_LEN   48
#define TN_PASS_LEN   48

class CTnBook {
  U8  name[TN_NAME_LEN];
  U8  host[TN_HOST_LEN];
  I64 port;
};

class CTnCred {
  U8  host[TN_HOST_LEN];
  I64 port;
  U8  user[TN_USER_LEN];
  U8  pass[TN_PASS_LEN];
};

CTnBook tn_book[TN_BOOK_MAX];
I64     tn_book_n;
CTnCred tn_cred[TN_CRED_MAX];
I64     tn_cred_n;

I64 tn_al_state;
U8  tn_al_user[48];
U8  tn_al_pass[48];
U8  tn_al_tail[TN_TAIL_LEN + 1];
I64 tn_al_tail_len;

U0 TnStrSet(U8 *dst, I64 max, U8 *src) {
  I64 i = 0;

  while (src && src[i] && i < max - 1) {
    dst[i] = src[i];
    i++;
  }
  dst[i] = 0;
}

I64 TnSplit(U8 *line, U8 **f, I64 max) {
  I64 n = 0;

  while (line && n < max) {
    f[n++] = line;
    line = StrFirstOcc(line, "\t");
    if (line) {
      *line = 0;
      line++;
    }
  }

  return n;
}

U8 *TnNextLine(U8 *p, U8 **_line) {
  // Cuts one line out of the buffer in place and returns the next start.
  U8 *nl = StrFirstOcc(p, "\n");
  I64 n;

  *_line = p;
  if (nl) {
    *nl = 0;
    p = nl + 1;
  }
  else
    p += StrLen(p);
  n = StrLen(*_line);
  while (n && (*_line)[n - 1] <= ' ')
    (*_line)[--n] = 0;

  return p;
}

U0 TnBookLoad() {
  I64  size;
  U8  *body = FileRead(TN_BOOK_PATH, &size), *p, *line, *f[3];

  tn_book_n = 0;
  if (!body) {
    // No file yet: one entry so Quick Connect is not empty on a fresh install.
    TnStrSet(tn_book[0].name, TN_NAME_LEN, "ZealOS BBS");
    TnStrSet(tn_book[0].host, TN_HOST_LEN, "bbs.zealos.net");
    tn_book[0].port = 4001;
    tn_book_n = 1;
    return;
  }
  p = body;
  while (*p && tn_book_n < TN_BOOK_MAX) {
    p = TnNextLine(p, &line);
    if (*line && *line != '#' && TnSplit(line, f, 3) >= 3) {
      TnStrSet(tn_book[tn_book_n].name, TN_NAME_LEN, f[0]);
      TnStrSet(tn_book[tn_book_n].host, TN_HOST_LEN, f[1]);
      tn_book[tn_book_n].port = Str2I64(f[2]);
      tn_book_n++;
    }
  }
  Free(body);
}

U0 TnBookSave() {
  U8  *buf, *w;
  I64  i, cap = 64 + tn_book_n * (sizeof(CTnBook) + 16);

  if (!DriveIsWritable)
    return;
  DirMake(TN_CFG_DIR);
  buf = CAlloc(cap);
  w = buf;
  StrPrint(w, "# Telnet bookmarks: name<TAB>host<TAB>port\n");
  w += StrLen(w);
  for (i = 0; i < tn_book_n; i++) {
    StrPrint(w, "%s\t%s\t%d\n", tn_book[i].name, tn_book[i].host, tn_book[i].port);
    w += StrLen(w);
  }
  FileWrite(TN_BOOK_PATH, buf, StrLen(buf));
  Free(buf);
}

U0 TnCredLoad() {
  I64  size, nf;
  U8  *body = FileRead(TN_CRED_PATH, &size), *p, *line, *f[4];

  tn_cred_n = 0;
  if (!body)
    return;
  p = body;
  while (*p && tn_cred_n < TN_CRED_MAX) {
    p = TnNextLine(p, &line);
    if (*line && *line != '#') {
      nf = TnSplit(line, f, 4);
      if (nf >= 3) {
        TnStrSet(tn_cred[tn_cred_n].host, TN_HOST_LEN, f[0]);
        tn_cred[tn_cred_n].port = Str2I64(f[1]);
        TnStrSet(tn_cred[tn_cred_n].user, TN_USER_LEN, f[2]);
        if (nf >= 4)
          TnStrSet(tn_cred[tn_cred_n].pass, TN_PASS_LEN, f[3]);
        else
          tn_cred[tn_cred_n].pass[0] = 0;
        tn_cred_n++;
      }
    }
  }
  Free(body);
}

U0 TnCredSave() {
  U8  *buf, *w;
  I64  i, cap = 128 + tn_cred_n * (sizeof(CTnCred) + 16);

  if (!DriveIsWritable)
    return;
  DirMake(TN_CFG_DIR);
  buf = CAlloc(cap);
  w = buf;
  StrPrint(w, "# Telnet credentials, plaintext: host<TAB>port<TAB>user<TAB>password\n");
  w += StrLen(w);
  for (i = 0; i < tn_cred_n; i++) {
    StrPrint(w, "%s\t%d\t%s\t%s\n", tn_cred[i].host, tn_cred[i].port,
             tn_cred[i].user, tn_cred[i].pass);
    w += StrLen(w);
  }
  FileWrite(TN_CRED_PATH, buf, StrLen(buf));
  Free(buf);
}

CTnCred *TnCredFind(U8 *host, I64 port) {
  I64 i;

  for (i = 0; i < tn_cred_n; i++)
    if (!StrICompare(tn_cred[i].host, host) && tn_cred[i].port == port)
      return &tn_cred[i];

  return NULL;
}

U0 TnCredSet(U8 *host, I64 port, U8 *user, U8 *pass) {
  CTnCred *c = TnCredFind(host, port);

  if (!c) {
    if (tn_cred_n >= TN_CRED_MAX)
      return;
    c = &tn_cred[tn_cred_n++];
    TnStrSet(c->host, TN_HOST_LEN, host);
    c->port = port;
  }
  TnStrSet(c->user, TN_USER_LEN, user);
  TnStrSet(c->pass, TN_PASS_LEN, pass);
  TnCredSave;
}

I64 TnBookFind(U8 *host, I64 port) {
  I64 i;

  for (i = 0; i < tn_book_n; i++)
    if (!StrICompare(tn_book[i].host, host) && tn_book[i].port == port)
      return i;

  return -1;
}

U0 TnBookAdd(U8 *name, U8 *host, I64 port) {
  I64 i = TnBookFind(host, port);

  if (i < 0) {
    if (tn_book_n >= TN_BOOK_MAX)
      return;
    i = tn_book_n++;
  }
  TnStrSet(tn_book[i].name, TN_NAME_LEN, name);
  TnStrSet(tn_book[i].host, TN_HOST_LEN, host);
  tn_book[i].port = port;
  TnBookSave;
}

U0 TnBookDel(I64 i) {
  if (!(0 <= i < tn_book_n))
    return;
  while (i < tn_book_n - 1) {
    MemCopy(&tn_book[i], &tn_book[i + 1], sizeof(CTnBook));
    i++;
  }
  tn_book_n--;
  TnBookSave;
}

I64 TnBookPick() {
  // Returns a bookmark index, or -1 on cancel/empty.
  I64  i, sel;
  U8  *list, *w;

  if (!tn_book_n) {
    PopUpOk("\n\n\tNo bookmarks yet.\n\n");
    return -1;
  }
  list = CAlloc(tn_book_n * 160 + 64);
  w = list;
  for (i = 0; i < tn_book_n; i++) {
    StrPrint(w, "%s  -  %s:%d", tn_book[i].name, tn_book[i].host, tn_book[i].port);
    w += StrLen(w) + 1;
  }
  *w = 0;
  sel = PopUpPickList(list);
  Free(list);
  if (!(0 <= sel < tn_book_n))
    return -1;

  return sel;
}

class CTnBookForm {
  U8  name[48] format "\n\n $$DA-P,LEN=47,A=\"Name:%s\"$$\n";
  U8  host[96] format " $$DA-P,LEN=95,A=\"Host:%s\"$$\n";
  U16 port     format " $$DA,LEN=8,A=\"Port:%d\"$$\n\n";
};

class CTnCredForm {
  U8  user[48] format "\n\n $$DA-P,LEN=47,A=\"User:%s\"$$\n";
  U8  pass[48] format " $$DA-P,LEN=47,A=\"Pass:%s\"$$\n\n";
};

U0 TnAutoLoginDisarm() {
  tn_al_state = TN_AL_OFF;
  tn_al_tail_len = 0;
  tn_al_tail[0] = 0;
}

U0 TnAutoLoginArm(U8 *host, I64 port) {
  // Called on every successful connect. No stored credentials leaves it off.
  CTnCred *c;

  TnAutoLoginDisarm;
  if (!host)
    return;
  c = TnCredFind(host, port);
  if (!c || !c->user[0])
    return;
  TnStrSet(tn_al_user, sizeof(tn_al_user), c->user);
  TnStrSet(tn_al_pass, sizeof(tn_al_pass), c->pass);
  tn_al_state = TN_AL_USER;
}

Bool TnTailHas(U8 *needle) {
  return ToBool(StrFirstOcc(tn_al_tail, needle) != NULL);
}

U0 TnAutoLoginFeed(I64 sock, U8 *buf, I64 len) {
  // Prompt detection on the raw receive stream. Keeps the last TN_TAIL_LEN
  // printable bytes, lowercased, and matches the usual BBS/unix prompts.
  I64 i, n;
  U8  ch;

  if (tn_al_state == TN_AL_OFF || tn_al_state == TN_AL_DONE)
    return;
  for (i = 0; i < len; i++) {
    ch = buf[i];
    if ('A' <= ch <= 'Z')
      ch += 32;
    if (ch < ' ' || ch > '~')
      ch = ' ';
    if (tn_al_tail_len >= TN_TAIL_LEN) {
      // Shift by a quarter window so the match survives a prompt straddling
      // the boundary.
      n = TN_TAIL_LEN / 4;
      MemCopy(tn_al_tail, tn_al_tail + n, TN_TAIL_LEN - n);
      tn_al_tail_len -= n;
    }
    tn_al_tail[tn_al_tail_len++] = ch;
    tn_al_tail[tn_al_tail_len] = 0;
  }

  if (tn_al_state == TN_AL_USER) {
    if (TnTailHas("login:") || TnTailHas("username:") || TnTailHas("user:") ||
        TnTailHas("user name") || TnTailHas("handle:") || TnTailHas("your name")) {
      TCPSocketSendString(sock, tn_al_user);
      TCPSocketSendString(sock, "\r\n");
      tn_al_tail_len = 0;
      tn_al_tail[0] = 0;
      if (tn_al_pass[0])
        tn_al_state = TN_AL_PASS;
      else
        tn_al_state = TN_AL_DONE;
    }
  }
  else if (tn_al_state == TN_AL_PASS) {
    if (TnTailHas("password") || TnTailHas("passphrase") || TnTailHas("pass:")) {
      TCPSocketSendString(sock, tn_al_pass);
      TCPSocketSendString(sock, "\r\n");
      TnAutoLoginDisarm;
      tn_al_state = TN_AL_DONE;
    }
  }
}
