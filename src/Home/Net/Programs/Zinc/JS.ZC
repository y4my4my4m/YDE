	JsPropSet(ji, math, "cbrt",	  JsNativeM(ji, JSN_MATH_1ARG, 13));
	JsPropSet(ji, math, "atan2",  JsNativeV(ji, JSN_MATH_ATAN2));
	JsPropSet(ji, math, "hypot",  JsNativeV(ji, JSN_MATH_HYPOT));
