	JsPropSet(ji, math, "deviceMemory",	JsNumV(ji, 8));
	JsPropSet(ji, math, "pdfViewerEnabled", JsBoolV(ji, TRUE));
	JsPropSet(ji, math, "javaEnabled",	JsNativeV(ji, JSN_NOOP_FALSE));
	JsPropSet(ji, math, "sendBeacon",	JsNativeV(ji, JSN_NOOP_TRUE));
	date = JsArrV(ji);
	JsArrPush(ji, date, JsStrV(ji, "en-US"));
	JsArrPush(ji, date, JsStrV(ji, "en"));
	JsPropSet(ji, math, "languages", date);
	uad	  = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, uad, "mobile",   JsBoolV(ji, FALSE));
	JsPropSet(ji, uad, "platform", JsStrV(ji, "Linux"));
	date = JsArrV(ji);
	brand = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, brand, "brand", JsStrV(ji, "Chromium"));
	JsPropSet(ji, brand, "version", JsStrV(ji, "126"));
	JsArrPush(ji, date, brand);
	brand = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, brand, "brand", JsStrV(ji, "Google Chrome"));
	JsPropSet(ji, brand, "version", JsStrV(ji, "126"));
	JsArrPush(ji, date, brand);
	JsPropSet(ji, uad, "brands", date);
	JsPropSet(ji, uad, "getHighEntropyValues", JsNativeV(ji, JSN_UAD_ENTROPY));
	JsPropSet(ji, math, "userAgentData", uad);
	JsEnvDeclare(ji, ji->genv, "navigator", math);

	scr = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, scr, "width",		 JsNumV(ji, 1920));
	JsPropSet(ji, scr, "height",	 JsNumV(ji, 1080));
	JsPropSet(ji, scr, "availWidth",  JsNumV(ji, 1920));
	JsPropSet(ji, scr, "availHeight", JsNumV(ji, 1040));
	JsPropSet(ji, scr, "colorDepth",  JsNumV(ji, 24));
	JsPropSet(ji, scr, "pixelDepth",  JsNumV(ji, 24));
	JsEnvDeclare(ji, ji->genv, "screen", scr);
	JsEnvDeclare(ji, ji->genv, "devicePixelRatio", JsNumV(ji, 1));

	math = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, math, "parse",	 JsNativeV(ji, JSN_JSON_PARSE));
	JsPropSet(ji, math, "stringify", JsNativeV(ji, JSN_JSON_STR));
	JsEnvDeclare(ji, ji->genv, "JSON", math);

	math = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, math, "is",	  JsNativeV(ji, JSN_OBJ_IS));
	JsPropSet(ji, math, "keys",   JsNativeV(ji, JSN_OBJ_KEYS));
	JsPropSet(ji, math, "assign", JsNativeV(ji, JSN_OBJ_ASSIGN));
	JsPropSet(ji, math, "values",  JsNativeV(ji, JSN_OBJ_VALUES));
	JsPropSet(ji, math, "entries", JsNativeV(ji, JSN_OBJ_ENTRIES));
	JsPropSet(ji, math, "fromEntries", JsNativeV(ji, JSN_OBJ_FROMENTRIES));
	JsPropSet(ji, math, "defineProperty",   JsNativeV(ji, JSN_OBJ_DEFINEPROP));
	JsPropSet(ji, math, "defineProperties", JsNativeV(ji, JSN_OBJ_DEFINEPROPS));
	JsPropSet(ji, math, "create",  JsNativeV(ji, JSN_OBJ_CREATE));
	JsPropSet(ji, math, "getPrototypeOf", JsNativeV(ji, JSN_OBJ_GETPROTO));
	JsPropSet(ji, math, "setPrototypeOf", JsNativeV(ji, JSN_OBJ_SETPROTO));
	JsPropSet(ji, math, "getOwnPropertyDescriptor", JsNativeV(ji, JSN_OBJ_GETDESC));
	JsPropSet(ji, math, "getOwnPropertyNames", JsNativeV(ji, JSN_OBJ_KEYS));
	JsPropSet(ji, math, "freeze",  JsNativeV(ji, JSN_OBJ_FREEZE));
	JsPropSet(ji, math, "seal",	   JsNativeV(ji, JSN_OBJ_FREEZE));
	JsPropSet(ji, math, "preventExtensions", JsNativeV(ji, JSN_OBJ_FREEZE));
	JsPropSet(ji, math, "isFrozen",		 JsNativeV(ji, JSN_OBJ_ISFROZEN));
	JsPropSet(ji, math, "isSealed",		 JsNativeV(ji, JSN_OBJ_ISFROZEN));
	JsPropSet(ji, math, "isExtensible",	 JsNativeV(ji, JSN_OBJ_ISFROZEN));
	JsPropSet(ji, math, "hasOwn",		 JsNativeV(ji, JSN_OBJ_HASOWN));
	JsProtoAttach(ji, math, JV_OBJ);
	JsEnvDeclare(ji, ji->genv, "Object", math);

	JsEnvDeclare(ji, ji->genv, "this",		 ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "globalThis", ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "self",	 ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "top",	 ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "parent", ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "frames", ji->win_obj);
	JsEnvDeclare(ji, ji->genv, "innerWidth",	JsNumV(ji, 1024));
	JsEnvDeclare(ji, ji->genv, "innerHeight",	JsNumV(ji, 768));
	JsEnvDeclare(ji, ji->genv, "outerWidth",	JsNumV(ji, 1024));
	JsEnvDeclare(ji, ji->genv, "outerHeight",	JsNumV(ji, 768));
	JsEnvDeclare(ji, ji->genv, "scrollX",		JsNumV(ji, 0));
	JsEnvDeclare(ji, ji->genv, "scrollY",		JsNumV(ji, 0));
	JsEnvDeclare(ji, ji->genv, "pageXOffset",	JsNumV(ji, 0));
	JsEnvDeclare(ji, ji->genv, "pageYOffset",	JsNumV(ji, 0));
	JsEnvDeclare(ji, ji->genv, "screenX",		JsNumV(ji, 0));
	JsEnvDeclare(ji, ji->genv, "screenY",		JsNumV(ji, 0));
	JsGlobalNative(ji, "scrollTo",	JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "scrollBy",	JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "scroll",	JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "focus",		JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "blur",		JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "print",		JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "close",		JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "open",		JSN_NOOP_UNDEF);
	JsGlobalNative(ji, "confirm",	JSN_NOOP_FALSE);
	JsGlobalNative(ji, "requestIdleCallback", JSN_SETTIMEOUT);
	JsGlobalNative(ji, "cancelIdleCallback",  JSN_CLEARTIMER);

	JsGlobalNative(ji, "eval", JSN_EVAL);
	JsProtoAttach(ji, JsGlobalNative(ji, "Function", JSN_EVT_NOOP), JV_NATIVE);
	JsProtoAttach(ji, JsGlobalNative(ji, "Boolean", JSN_BOOLEAN), JV_BOOL);
	JsGlobalNative(ji, "URL", JSN_URL_CTOR);
	math = JsGlobalNative(ji, "Array", JSN_ARRAY_CTOR);
	JsProtoAttach(ji, math, JV_ARR);
	JsPropSet(ji, math, "isArray", JsNativeV(ji, JSN_ARR_ISARR));
	JsPropSet(ji, math, "from",	   JsNativeV(ji, JSN_ARRAY_FROM));
	JsPropSet(ji, math, "of",	   JsNativeV(ji, JSN_ARRAY_OF));

	js_script_n = 0;
	math = JsValNew(ji, JV_OBJ);
	JsPropSet(ji, math, "getItem",	  JsNativeV(ji, JSN_LS_GET));
	JsPropSet(ji, math, "setItem",	  JsNativeV(ji, JSN_LS_SET));
	JsPropSet(ji, math, "removeItem", JsNativeV(ji, JSN_LS_REMOVE));
	JsPropSet(ji, math, "clear",	  JsNativeV(ji, JSN_LS_CLEAR));
	JsEnvDeclare(ji, ji->genv, "localStorage", math);
	JsEnvDeclare(ji, ji->genv, "sessionStorage", math);

	return ji;
}

U0 JsInterpFree(CJsInterp *ji)
{
	CJsAllocHdr *h, *next;

	if (!ji)
		return;
	h = ji->allocs;
	while (h)
	{
		next = h->next;
		Free(h);
		h = next;
	}
	Free(ji);
}


U0 JsScriptReport(CJsInterp *ji, U8 *src, I64 nparsed, I64 nran, U8 *how)
{
	U8	buf[JS_WARN_LEN], head[40];
	I64 i = 0, k = 0;

	js_script_n++;
	while (src && src[i] && k < 32)
	{
		if (src[i] > ' ')
		{
			head[k] = src[i];
			k++;
		}
		i++;
	}
	head[k] = 0;
	StrPrint(buf, "script[%d] %dB lexed=%d cmt=%d toks=%d parsed=%d ran=%d "
			 "perr=%d dropped=%d steps=%d ms=%d %s head=",
			 js_script_n, StrLen(src), ji->lex_end, ji->lex_cmt, ji->tok_count,
			 nparsed, nran, js_parse_errs, js_tok_dropped, ji->steps,
			 ToI64((tS - ji->t_start) * 1000.0), how);
	JsPathCat(buf, JS_WARN_LEN, head);
	if (ji->has_err)
	{
		JsPathCat(buf, JS_WARN_LEN, " err=");
		JsPathCat(buf, JS_WARN_LEN, ji->err);
	}
	JsScrub(buf);
	NetLog("JS: %s", buf);
	if (js_script_n <= 16)
		JsConsoleAdd("script", buf);
}

U0 JsLexEndCheck(CJsInterp *ji, U8 *src)
{
	U8	buf[224], win[96];
	I64 total = StrLen(src), i, k = 0, from;

	if (ji->lex_end == total)
		return;
	from = ji->lex_end - 24;
	if (from < 0)
		from = 0;
	for (i = from; i < ji->lex_end + 40 && src[i] && k < 72; i++)
	{
		if (i == ji->lex_end)
		{
			win[k] = '>';
			k++;
			win[k] = '|';
			k++;
			win[k] = '<';
			k++;
		}
		win[k] = src[i];
		k++;
	}
	win[k] = 0;
	StrPrint(buf, "LEX ENDED at %d of %d: ", ji->lex_end, total);
	JsPathCat(buf, 224, win);
	JsScrub(buf);
	JsConsoleAdd("lex", buf);
	NetLog("JS: %s", buf);
}

Bool JsRunEx(CJsInterp *ji, U8 *src, CJsVal **_last)
{
	CJsNode *stmt, *head, *tail;
	CJsVal	*val;
	I64		 before, nparsed = 0, nran = 0;
	U8		 thrbuf[192];

	if (_last)
		*_last = NULL;
	if (!src || !*src)
		return TRUE;
	ji->lex_end = 0;
	ji->lex_cmt = 0;
	if (StrLen(src) > JS_MAX_SRC)
	{
		js_parse_errs = 0;
		JsScriptReport(ji, src, 0, 0, "SKIPPED-too-big");
		return FALSE;
	}

	ji->has_err = FALSE;
	ji->parse_err = FALSE;
	JsBudgetReset(ji);
	ji->depth	= 0;
	ji->flow	= JF_NORMAL;
	ji->env		= ji->genv;
	js_soft_errs  = 0;
	js_parse_errs = 0;
	js_undef_errs = 0;
	js_warn_n	  = 0;
	js_re_warned  = 0;
	js_tok_dropped = 0;

	if (!JsLex(ji, src))
	{
		NetLog("%s", ji->err);
		JsScriptReport(ji, src, 0, 0, "LEXFAIL");
		if (ji->toks)
		{
			Free(ji->toks);
			ji->toks = NULL;
		}
		return FALSE;
	}

	JsLexEndCheck(ji, src);

	head = NULL;
	tail = NULL;
	while (JsTok(ji)->type != JT_EOF)
	{
		before = ji->pos;
		stmt = JsParseStmt(ji);
		if (ji->parse_err)
			JsParseResync(ji);
		if (stmt)
		{
			if (tail)
				tail->next = stmt;
			else
				head = stmt;
			tail = stmt;
			nparsed++;
		}
		if (ji->pos == before)
			ji->pos++;
	}

	if (ji->toks)
	{
		Free(ji->toks);
		ji->toks = NULL;
	}

	JsHoistList(ji, head, ji->genv);

	stmt = head;
	while (stmt && !ji->has_err)
	{
		val = JsEval(ji, stmt);
		if (_last && ji->flow == JF_NORMAL)
			*_last = val;
		if (ji->flow == JF_THROW)
		{
			JsThrowText(ji, ji->exc, thrbuf, 192);
			JsScrub(thrbuf);
			JsConsoleAdd("THROW", thrbuf);
			NetLog("JS: uncaught throw: %s", thrbuf);
		}
		ji->flow = JF_NORMAL;
		nran++;
		stmt = stmt->next;
	}
	if (ji->has_err)
		JsScriptReport(ji, src, nparsed, nran, "ABORTED");
	else if (nran < nparsed)
		JsScriptReport(ji, src, nparsed, nran, "STOPPED");
	else
		JsScriptReport(ji, src, nparsed, nran, "ok");

	JsFlushWrites(ji);

	if (ji->has_err)
	{
		NetLog("%s", ji->err);
		return FALSE;
	}

	return TRUE;
}

Bool JsRun(CJsInterp *ji, U8 *src)
{
	return JsRunEx(ji, src, NULL);
}

