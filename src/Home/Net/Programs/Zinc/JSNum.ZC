// ============================================================================
// Zinc JS engine - Number -> string (ECMAScript Number::toString).
// Included from JS.ZC via  #include "JSNum"  before JsNumToStr. Self-contained:
// depends on nothing from JS.ZC (pure F64 -> caller buffer), so it can also be
// unit-tested standalone.
//
// Shortest-round-trip digit generation is Grisu2 (Loitsch 2010), same family as
// the algorithm ant's runtime uses. Grisu2 always emits digits that read back as
// the identical F64; it is occasionally (~0.1%) one digit longer than optimal.
// We do NOT use the "print at increasing precision until Str2F64 round-trips"
// trick: the kernel's Str2F64 accumulates the mantissa in an I64 and divides by
// Pow10I64, so it is not correctly rounded and would validate against itself.
// ============================================================================

/* ---- 64x64 -> high 64 bits, and the diy_fp (U64 significand, I64 exp) type ---- */

class CJsDiyFp
{ // value = f * 2^e ; f is always treated as UNSIGNED (shifts must be logical)
	U64 f;
	I64 e;
};

U0 JsDiyMul(CJsDiyFp *x, CJsDiyFp *y, CJsDiyFp *out)
{ // out = round(x * y). Split into 32-bit halves; no 128-bit type in ZealC.
	U64 m32 = 0xFFFFFFFF;
	U64 a = x->f >> 32, b = x->f & m32;
	U64 c = y->f >> 32, d = y->f & m32;
	U64 ac = a * c, bc = b * c, ad = a * d, bd = b * d;
	U64 tmp = (bd >> 32) + (ad & m32) + (bc & m32);

	tmp += 0x80000000; // round the dropped low half
	out->f = ac + (ad >> 32) + (bc >> 32) + (tmp >> 32);
	out->e = x->e + y->e + 64;
}

/* ---- cached powers of ten, 10^-348 .. 10^340 step 8, as normalized diy_fp ----
   Generated exactly with rational arithmetic (not transcribed), 87 entries. */

U64 js_num_pow_f[87] = {
	0xFA8FD5A0081C0288, 0xBAAEE17FA23EBF76, 0x8B16FB203055AC76, 0xCF42894A5DCE35EA,
	0x9A6BB0AA55653B2D, 0xE61ACF033D1A45DF, 0xAB70FE17C79AC6CA, 0xFF77B1FCBEBCDC4F,
	0xBE5691EF416BD60C, 0x8DD01FAD907FFC3C, 0xD3515C2831559A83, 0x9D71AC8FADA6C9B5,
	0xEA9C227723EE8BCB, 0xAECC49914078536D, 0x823C12795DB6CE57, 0xC21094364DFB5637,
	0x9096EA6F3848984F, 0xD77485CB25823AC7, 0xA086CFCD97BF97F4, 0xEF340A98172AACE5,
	0xB23867FB2A35B28E, 0x84C8D4DFD2C63F3B, 0xC5DD44271AD3CDBA, 0x936B9FCEBB25C996,
	0xDBAC6C247D62A584, 0xA3AB66580D5FDAF6, 0xF3E2F893DEC3F126, 0xB5B5ADA8AAFF80B8,
	0x87625F056C7C4A8B, 0xC9BCFF6034C13053, 0x964E858C91BA2655, 0xDFF9772470297EBD,
	0xA6DFBD9FB8E5B88F, 0xF8A95FCF88747D94, 0xB94470938FA89BCF, 0x8A08F0F8BF0F156B,
	0xCDB02555653131B6, 0x993FE2C6D07B7FAC, 0xE45C10C42A2B3B06, 0xAA242499697392D3,
	0xFD87B5F28300CA0E, 0xBCE5086492111AEB, 0x8CBCCC096F5088CC, 0xD1B71758E219652C,
	0x9C40000000000000, 0xE8D4A51000000000, 0xAD78EBC5AC620000, 0x813F3978F8940984,
	0xC097CE7BC90715B3, 0x8F7E32CE7BEA5C70, 0xD5D238A4ABE98068, 0x9F4F2726179A2245,
	0xED63A231D4C4FB27, 0xB0DE65388CC8ADA8, 0x83C7088E1AAB65DB, 0xC45D1DF942711D9A,
	0x924D692CA61BE758, 0xDA01EE641A708DEA, 0xA26DA3999AEF774A, 0xF209787BB47D6B85,
	0xB454E4A179DD1877, 0x865B86925B9BC5C2, 0xC83553C5C8965D3D, 0x952AB45CFA97A0B3,
	0xDE469FBD99A05FE3, 0xA59BC234DB398C25, 0xF6C69A72A3989F5C, 0xB7DCBF5354E9BECE,
	0x88FCF317F22241E2, 0xCC20CE9BD35C78A5, 0x98165AF37B2153DF, 0xE2A0B5DC971F303A,
	0xA8D9D1535CE3B396, 0xFB9B7CD9A4A7443C, 0xBB764C4CA7A44410, 0x8BAB8EEFB6409C1A,
	0xD01FEF10A657842C, 0x9B10A4E5E9913129, 0xE7109BFBA19C0C9D, 0xAC2820D9623BF429,
	0x80444B5E7AA7CF85, 0xBF21E44003ACDD2D, 0x8E679C2F5E44FF8F, 0xD433179D9C8CB841,
	0x9E19DB92B4E31BA9, 0xEB96BF6EBADF77D9, 0xAF87023B9BF0EE6B};

I16 js_num_pow_e[87] = {
	-1220, -1193, -1166, -1140, -1113, -1087, -1060, -1034, -1007, -980, -954, -927,
	-901, -874, -847, -821, -794, -768, -741, -715, -688, -661, -635, -608,
	-582, -555, -529, -502, -475, -449, -422, -396, -369, -343, -316, -289,
	-263, -236, -210, -183, -157, -130, -103, -77, -50, -24, 3, 30,
	56, 83, 109, 136, 162, 189, 216, 242, 269, 295, 322, 348,
	375, 402, 428, 455, 481, 508, 534, 561, 588, 614, 641, 667,
	694, 720, 747, 774, 800, 827, 853, 880, 907, 933, 960, 986,
	1013, 1039, 1066};

U32 js_num_pow10[10] = {
	1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000};

// The fractional digit loop scales wp_w by 10^-kappa, and -kappa reaches ~17 for
// a 17-significant-digit result, so the U32 table above is far too short. It
// used to clamp to zero past 10^9, which silently DISABLED JsGrisuRound (its
// loop starts `rest < wp_w`, never true against 0) and left the last digit
// uncorrected: 0.1+0.2 printed 0.30000000000000007 instead of the closest
// shortest form 0.30000000000000004 that Number::toString requires.
// Stops at 10^18 because 10^19 does not fit an I64 source literal.
U64 js_num_pow10_64[19] = {
	1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000,
	1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,
	100000000000000, 1000000000000000, 10000000000000000, 100000000000000000,
	1000000000000000000};

I64 JsNumCachedPow(I64 e, CJsDiyFp *out)
{ // pick the cached 10^k whose product with a diy_fp of exponent e lands the
  // result in the [alpha,gamma] window; returns k (the decimal exponent).
	F64 dk = (-61 - e) * 0.30102999566398114 + 347.0;
	I64 k  = ToI64(dk);
	I64 idx;

	if (dk - ToF64(k) > 0.0) // ToI64/ToF64 intrinsics: postfix casts are no-ops
		k++;
	idx = (k >> 3) + 1;
	if (idx < 0)
		idx = 0;
	if (idx > 86)
		idx = 86;
	out->f = js_num_pow_f[idx];
	out->e = js_num_pow_e[idx];
	return -(-348 + (idx << 3));
}

/* ---- Grisu2 ---- */

#define JSD_SIG_MASK	0x000FFFFFFFFFFFFF
#define JSD_EXP_MASK	0x7FF0000000000000
#define JSD_HIDDEN_BIT	0x0010000000000000
#define JSD_EXP_BIAS	1075	// 1023 + 52
#define JSD_MIN_EXP		(-1075)	// -(bias); subnormals use JSD_MIN_EXP + 1

U0 JsDiyFromF64(F64 d, CJsDiyFp *out)
{
	U64 bits;
	U64 sig;
	I64 be;

	MemCopy(&bits, &d, 8); // reinterpret: no union, and a postfix cast is a no-op
	sig = bits & JSD_SIG_MASK;
	be	= (bits & JSD_EXP_MASK) >> 52;
	if (be)
	{
		out->f = sig + JSD_HIDDEN_BIT;
		out->e = be - JSD_EXP_BIAS;
	}
	else
	{ // subnormal: no hidden bit, fixed exponent
		out->f = sig;
		out->e = JSD_MIN_EXP + 1;
	}
}

U0 JsDiyNormalize(CJsDiyFp *v)
{
	while (!(v->f & 0x8000000000000000))
	{
		v->f <<= 1;
		v->e--;
	}
}

U0 JsDiyBoundaries(CJsDiyFp *v, CJsDiyFp *minus, CJsDiyFp *plus)
{ // half-way points to the neighbouring F64s, both scaled to plus's exponent
	CJsDiyFp pl, mi;

	pl.f = (v->f << 1) + 1;
	pl.e = v->e - 1;
	while (!(pl.f & (JSD_HIDDEN_BIT << 1))) // normalize to bit 53, then to bit 63
	{
		pl.f <<= 1;
		pl.e--;
	}
	pl.f <<= 10; // 64 - 52 - 2
	pl.e -= 10;

	if (v->f == JSD_HIDDEN_BIT)
	{ // power of two: the lower neighbour is twice as close
		mi.f = (v->f << 2) - 1;
		mi.e = v->e - 2;
	}
	else
	{
		mi.f = (v->f << 1) - 1;
		mi.e = v->e - 1;
	}
	mi.f <<= mi.e - pl.e;
	mi.e = pl.e;

	plus->f	 = pl.f;
	plus->e	 = pl.e;
	minus->f = mi.f;
	minus->e = mi.e;
}

I64 JsNumDecDigits(U32 n)
{
	I64 i = 1;

	while (i < 10 && n >= js_num_pow10[i])
		i++;
	return i;
}

U0 JsGrisuRound(U8 *buf, I64 len, U64 delta, U64 rest, U64 ten_kappa, U64 wp_w)
{ // nudge the last digit down while that stays inside the rounding interval and
  // strictly closer to w
	while (rest < wp_w && delta - rest >= ten_kappa &&
		   (rest + ten_kappa < wp_w || wp_w - rest > rest + ten_kappa - wp_w))
	{
		buf[len - 1]--;
		rest += ten_kappa;
	}
}

I64 JsGrisuDigits(CJsDiyFp *w, CJsDiyFp *mp, U64 delta, U8 *buf, I64 *_k)
{ // emit shortest digits of mp into buf; returns digit count, adjusts *_k
	CJsDiyFp one;
	I64	 sh, kappa, len = 0, idx;
	U64	 p2, tmp, ten_kappa, wp_w, wide; // wide: U64 staging for the <<sh operands
	U32	 p1, d, div;					 // (a postfix p1(U64) cast is a no-op)

	sh	  = -mp->e;
	one.f = 1 << sh;
	one.e = mp->e;
	wp_w  = mp->f - w->f;

	// mask after the shift: mp->f has bit 63 set, so a stray arithmetic shift
	// would sign-extend. p1 is a 32-bit quantity by construction.
	p1 = (mp->f >> sh) & 0xFFFFFFFF;
	p2 = mp->f & (one.f - 1);

	kappa = JsNumDecDigits(p1);
	while (kappa > 0)
	{
		div = js_num_pow10[kappa - 1];
		d	= p1 / div;
		p1	= p1 % div;
		if (d || len)
		{
			buf[len] = '0' + d;
			len++;
		}
		kappa--;
		wide = p1;
		tmp	 = p2 + (wide << sh);
		if (tmp <= delta)
		{
			*_k += kappa;
			wide	  = js_num_pow10[kappa];
			ten_kappa = wide << sh;
			JsGrisuRound(buf, len, delta, tmp, ten_kappa, wp_w);
			return len;
		}
	}

	while (TRUE)
	{ // fractional part: keep multiplying by ten
		p2 *= 10;
		delta *= 10;
		d = (p2 >> sh) & 0xF;
		if (d || len)
		{
			buf[len] = '0' + d;
			len++;
		}
		p2 &= one.f - 1;
		kappa--;
		if (p2 < delta)
		{
			*_k += kappa;
			idx = -kappa;
			if (idx < 19)
				wp_w *= js_num_pow10_64[idx];
			else
				wp_w = 0; // past the table: skip the correction rather than
						  // scale by a bogus factor. Unreachable for normal
						  // doubles, which need at most ~17 fractional digits.
			JsGrisuRound(buf, len, delta, p2, one.f, wp_w);
			return len;
		}
	}
	return len;
}

I64 JsGrisu2(F64 d, U8 *buf, I64 *_k)
{ // digits of d into buf (no sign, no point); value = <buf as int> * 10^*_k
	CJsDiyFp v, wm, wp, cp, w, mp, mm;
	I64		 k;

	JsDiyFromF64(d, &v);
	JsDiyBoundaries(&v, &wm, &wp);
	k = JsNumCachedPow(wp.e, &cp);

	JsDiyNormalize(&v);
	JsDiyMul(&v, &cp, &w);
	JsDiyMul(&wp, &cp, &mp);
	JsDiyMul(&wm, &cp, &mm);
	mm.f++;
	mp.f--;

	*_k = k; // JsNumCachedPow already returns the negated decimal exponent
	return JsGrisuDigits(&w, &mp, mp.f - mm.f, buf, _k);
}

/* ---- ECMAScript Number::toString (spec 6.1.6.1.20) ---- */

U8 *JsF64ToStr(U8 *out, F64 d)
{ // writes out[] (needs >= 40 bytes) and returns out
	U8	 digits[32];
	I64	 k = 0, len, n, i, o = 0, ex, nd;
	U64	 bits;
	U8	 ebuf[8];

	MemCopy(&bits, &d, 8);
	if ((bits & JSD_EXP_MASK) == JSD_EXP_MASK)
	{ // NaN / +-Infinity: JS prints these, %g in the kernel does not
		if (bits & JSD_SIG_MASK)
			StrCopy(out, "NaN"); // StrCopy is U0 in ZealOS, so copy then return
		else if (bits & 0x8000000000000000)
			StrCopy(out, "-Infinity");
		else
			StrCopy(out, "Infinity");
		return out;
	}
	if (!(bits & 0x7FFFFFFFFFFFFFFF))
	{
		StrCopy(out, "0"); // both +0 and -0 stringify as "0"
		return out;
	}

	if (bits & 0x8000000000000000)
	{
		out[o] = '-';
		o++;
		d = -d;
	}

	len = JsGrisu2(d, digits, &k);
	n	= len + k; // value = 0.<digits> * 10^n

	if (len <= n <= 21)
	{ // integer, no exponent: digits then trailing zeros
		for (i = 0; i < len; i++)
		{
			out[o] = digits[i];
			o++;
		}
		while (i < n)
		{
			out[o] = '0';
			o++;
			i++;
		}
	}
	else if (0 < n <= 21)
	{ // point falls inside the digits
		for (i = 0; i < n; i++)
		{
			out[o] = digits[i];
			o++;
		}
		out[o] = '.';
		o++;
		while (i < len)
		{
			out[o] = digits[i];
			o++;
			i++;
		}
	}
	else if (-6 < n <= 0)
	{ // 0.000ddd
		out[o] = '0';
		o++;
		out[o] = '.';
		o++;
		for (i = 0; i < -n; i++)
		{
			out[o] = '0';
			o++;
		}
		for (i = 0; i < len; i++)
		{
			out[o] = digits[i];
			o++;
		}
	}
	else
	{ // exponential: d[.ddd]e{+|-}X
		out[o] = digits[0];
		o++;
		if (len > 1)
		{
			out[o] = '.';
			o++;
			for (i = 1; i < len; i++)
			{
				out[o] = digits[i];
				o++;
			}
		}
		out[o] = 'e';
		o++;
		ex = n - 1;
		if (ex < 0)
		{
			out[o] = '-';
			o++;
			ex = -ex;
		}
		else
		{
			out[o] = '+'; // JS always signs the exponent: 1e+21
			o++;
		}
		nd = 0;
		while (ex)
		{ // digits come out reversed, then flip
			ebuf[nd] = '0' + ex % 10;
			nd++;
			ex /= 10;
		}
		while (nd)
		{
			nd--;
			out[o] = ebuf[nd];
			o++;
		}
	}

	out[o] = 0;
	return out;
}

/* ---- decimal -> F64 (the other direction) ----
   The kernel's Str2F64 accumulates the mantissa into an I64 and divides by
   Pow10I64, so it is not correctly rounded -- the same reason JSNum.ZC refuses
   to use it as a round-trip oracle (see the header). Every numeric literal in
   every script went through it, so `1e21` became 999999999999999600000 and
   Grisu2 then printed that wrong double perfectly.

   Strategy is Clinger's fast path: an integer mantissa below 2^53 times an
   exactly representable power of ten is correctly rounded by a single IEEE
   operation. 10^0..10^22 are all exact (10^22 = 2^22 * 5^22 and 5^22 < 2^53),
   which covers essentially every literal real source contains. Beyond that we
   step in exact 10^22 chunks, so the error stays near one ulp instead of
   compounding per digit. */

F64	 js_num_p10[23];
Bool js_num_p10_ready = FALSE;	// globals are NOT zeroed by the JIT

U0 JsNumP10Init()
{ // built by repeated multiplication rather than written as literals: the
  // compiler would have to parse those literals with a converter of its own,
  // which is the very thing being worked around here. Each step is exact.
	I64 i;

	js_num_p10[0] = 1.0;
	i = 1;
	while (i < 23)
	{
		js_num_p10[i] = js_num_p10[i - 1] * 10.0;
		i++;
	}
	js_num_p10_ready = TRUE;
}

F64 JsNumConst(U64 bits)
{ // reinterpret bits as an F64. KernelA.HH's `inf` uses a postfix cast, which is
  // a no-op on anything but a literal in ZealC, so go through memory the same
  // way JsDiyFromF64 does in the other direction.
	F64 d;

	MemCopy(&d, &bits, 8);

	return d;
}

F64 JsNumNaN()	{ return JsNumConst(0x7FF8000000000000); }
F64 JsNumInf()	{ return JsNumConst(0x7FF0000000000000); }
// -Infinity is 0xFFF0.. which will not fit an I64 source literal, so subtract
F64 JsNumNInf()	{ return 0.0 - JsNumConst(0x7FF0000000000000); }

Bool JsNumIsNaN(F64 d)
{ // NaN is the only value unequal to itself, but F64 comparison in ZealC has
  // enough traps (negative zero, `!` on F64) that testing the bits is safer
	U64 bits;

	MemCopy(&bits, &d, 8);

	return (bits & JSD_EXP_MASK) == JSD_EXP_MASK && (bits & JSD_SIG_MASK) != 0;
}

Bool JsNumIsZero(F64 d)
{ // two relationals, not `== 0.0`: -0.0 fails equality here (gotcha #13)
	return d <= 0.0 && d >= 0.0;
}

F64 JsMantScale(I64 mant, I64 dexp)
{ // mant * 10^dexp
	F64 m;

	if (!js_num_p10_ready)
		JsNumP10Init;
	if (!mant)
		return 0.0;
	m = ToF64(mant); // postfix casts are no-ops in ZealC; ToF64 is the intrinsic
	// clamp first so the chunk loops below cannot spin: past these the result
	// is Infinity or 0 anyway
	if (dexp > 400)
		dexp = 400;
	if (dexp < -400)
		dexp = -400;
	if (mant <= 9007199254740992) // 2^53: mantissa still exact as an F64
	{ // written out rather than chained: ZealC chained comparison is fine for
	  // one operator, but do not make a mixed <=/< chain carry a correctness fix
		if (dexp >= 0 && dexp <= 22)
			return m * js_num_p10[dexp];
		if (dexp < 0 && dexp >= -22)
			return m / js_num_p10[-dexp];
	}
	while (dexp > 22)
	{
		m *= js_num_p10[22];
		dexp -= 22;
	}
	while (dexp < -22)
	{
		m /= js_num_p10[22];
		dexp += 22;
	}
	if (dexp > 0)
		m *= js_num_p10[dexp];
	else if (dexp < 0)
		m /= js_num_p10[-dexp];

	return m;
}

F64 JsStr2F64(U8 *s)
{ // decimal -> F64. Leading space and sign, digits, fraction, exponent; stops
  // at the first byte that cannot continue the number. No hex, no Infinity
  // spelling: JS literals of those forms never reach here.
	I64	 mant = 0, ndig = 0, dexp = 0, eval = 0, esign = 1;
	Bool neg = FALSE, any = FALSE;
	F64	 r;

	if (!s)
		return 0.0;
	while (*s == ' ' || *s == '\t' || *s == '\n' || *s == '\r')
		s++;
	if (*s == '+')
		s++;
	else if (*s == '-')
	{
		neg = TRUE;
		s++;
	}
	while ('0' <= *s <= '9')
	{
		any = TRUE;
		if (ndig < 18) // 18 digits is the most that always fits an I64
		{
			mant = mant * 10 + (*s - '0');
			ndig++;
		}
		else
			dexp++; // past our precision: count it as scale instead
		s++;
	}
	if (*s == '.')
	{
		s++;
		while ('0' <= *s <= '9')
		{
			any = TRUE;
			if (ndig < 18)
			{
				mant = mant * 10 + (*s - '0');
				ndig++;
				dexp--;
			}
			s++;
		}
	}
	if (!any)
		return 0.0;
	if (*s == 'e' || *s == 'E')
	{
		s++;
		if (*s == '+')
			s++;
		else if (*s == '-')
		{
			esign = -1;
			s++;
		}
		while ('0' <= *s <= '9')
		{
			if (eval < 100000)
				eval = eval * 10 + (*s - '0');
			s++;
		}
		dexp += esign * eval;
	}
	r = JsMantScale(mant, dexp);
	if (neg)
		return -r;

	return r;
}

Bool JsNumSpace(U8 c)
{ // StrWhiteSpace: what ToNumber trims from each end
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
		   c == 0x0B || c == 0x0C;
}

I64 JsHexDig(U8 c)
{ // value of one hex digit, -1 when it is not one
	if ('0' <= c <= '9')
		return c - '0';
	if ('a' <= c <= 'f')
		return c - 'a' + 10;
	if ('A' <= c <= 'F')
		return c - 'A' + 10;

	return -1;
}

F64 JsStrToNumber(U8 *s)
{ // ToNumber(String), which is not parseFloat: the WHOLE string must be a
  // numeric literal. "12abc" is NaN here where parseFloat gives 12, and "abc"
  // is NaN rather than 0 - a 0 is a plausible number, so it passes every
  // isNaN() guard a page uses to validate input and lands in the arithmetic.
  // Empty or all-whitespace is 0. The value itself still comes from
  // JsStr2F64, which is correctly rounded; this only decides validity.
	U8	*p, *q;
	F64	 r = 0.0;
	Bool neg = FALSE, sign = FALSE, anyd = FALSE;
	I64	 h;

	if (!s)
		return 0.0;
	p = s;
	while (JsNumSpace(*p))
		p++;
	if (!*p)
		return 0.0;
	q = p;
	if (*q == '+' || *q == '-')
	{
		neg	 = (*q == '-');
		sign = TRUE;
		q++;
	}
	if (!StrNCompare(q, "Infinity", 8))
	{
		q += 8;
		r = JsNumInf;
		if (neg)
			r = -r;
	}
	else if (!sign && *q == '0' && (q[1] == 'x' || q[1] == 'X'))
	{ // a hex StringNumericLiteral, which may not carry a sign
		q += 2;
		h = JsHexDig(*q);
		while (h >= 0)
		{
			r = r * 16.0 + h;
			anyd = TRUE;
			q++;
			h = JsHexDig(*q);
		}
		if (!anyd)
			return JsNumNaN;
	}
	else
	{
		while ('0' <= *q <= '9')
		{
			anyd = TRUE;
			q++;
		}
		if (*q == '.')
		{
			q++;
			while ('0' <= *q <= '9')
			{
				anyd = TRUE;
				q++;
			}
		}
		if (!anyd)
			return JsNumNaN;
		if (*q == 'e' || *q == 'E')
		{
			q++;
			if (*q == '+' || *q == '-')
				q++;
			if (!('0' <= *q <= '9'))
				return JsNumNaN;
			while ('0' <= *q <= '9')
				q++;
		}
		r = JsStr2F64(p); // p still carries the sign
	}
	while (JsNumSpace(*q))
		q++;
	if (*q)
		return JsNumNaN; // trailing bytes: not a numeric literal

	return r;
}
