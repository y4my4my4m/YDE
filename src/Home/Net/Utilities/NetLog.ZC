CTask *net_log_task = NULL;
Bool net_log_enabled = TRUE;

// Verbosity filter for NetLog/NetDebug. 1 = application only (HTTP/DNS/TLS/ZINC/
// JS), 2 = + transport (TCP/UDP/IP/ICMP), 3 = everything (ethernet/ARP/PCNet/
// socket/MAC). Errors + warnings ALWAYS show. Default 3 = old behaviour.
//Default to application level. At 2 every TCP HANDLER / PACKET ALLOCATE /
//SEND FLAGS line prints - dozens per request - which buries the HTTP, DNS and
//app lines that are the reason to read this at all. NetLogV(2) or NetLogV(3)
//from any terminal when the transport is what you are debugging.
I64 net_log_v = 1;

// Lines printed since the clickable filter bar was last shown. The bar scrolls
// off the top under flood, so we reprint it every so often to keep it reachable.

I64 NetLogCat(U8 *msg)
{ // classify a log line by its leading keyword. lower number = higher level.
	//"GET MAC FOR IP" is the per-packet ARP lookup and begins with the same
	//four bytes as an HTTP GET, so it has to be taken out before that test.
	if (!StrNICompare(msg, "GET MAC", 7))
		return 3;
	if (!StrNICompare(msg, "HTTP", 4) || !StrNICompare(msg, "ZINC", 4) ||
		!StrNICompare(msg, "DNS", 3)  || !StrNICompare(msg, "TLS", 3) ||
		!StrNICompare(msg, "JS", 2)   || StrFind("body bytes", msg) ||
		//Apps log with their own name in front. Without these they classify as
		//link layer and vanish at the default level, which is exactly where
		//an app's own diagnostics are least useful.
		!StrNICompare(msg, "yHarmony", 8) || !StrNICompare(msg, "yIRC", 4) ||
		!StrNICompare(msg, "ZMail", 5)    || !StrNICompare(msg, "GIT", 3) ||
		!StrNICompare(msg, "SSH", 3)      || !StrNICompare(msg, "WS", 2) ||
		//Anchored: StrFind scans the whole line, so "GET " also matched
		//"GET MAC FOR IP", the per-packet ARP lookup. That put the single
		//noisiest line in the system into the one category no level filters.
		!StrNICompare(msg, "GET ", 4)     || !StrNICompare(msg, "POST ", 5) ||
		!StrNICompare(msg, "PUT ", 4)     || !StrNICompare(msg, "HEAD ", 5) ||
		!StrNICompare(msg, "PATCH ", 6)   || !StrNICompare(msg, "DELETE ", 7))
		return 1; // application layer
	if (!StrNICompare(msg, "TCP", 3)  || !StrNICompare(msg, "UDP", 3) ||
		!StrNICompare(msg, "IP", 2)   || !StrNICompare(msg, "ICMP", 4) ||
		!StrNICompare(msg, "DHCP", 4))
		return 2; // transport
	return 3; // link layer / everything else (ethernet, ARP, PCNet, socket, MAC)
}

public U0 NetLogV(I64 level)
{ // set the network-log verbosity (1 HTTP, 2 +TCP, 3 all)
	net_log_v = ClampI64(level, 1, 3);
	if (net_log_task)
		DocPrint(net_log_task->put_doc,
				 "$$BG,GREEN$$$$BLACK$$ log level -> %d $$BG$$$$FG$$\n", net_log_v);
}

public U0 NetLogClear()
{ // Wipe the log. The level only gates NEW lines, so without this a filter
  // change looks like it did nothing: the flood already on screen stays.
	CDoc *doc;
	Bool  unlock;

	if (!net_log_task)
		return;
	doc = net_log_task->put_doc;
	unlock = DocLock(doc);
	DocClear(doc);
	if (unlock)
		DocUnlock(doc);
}


U0 NetLogSave()
{
	StrCopy(net_log_task->put_doc->filename.name, "::/Home/Net/Log.DD");
	DocWrite(net_log_task->put_doc);
}

U0 NetLogInit()
{
    if (!net_log_enabled) return;
	net_log_task = Spawn(&ServerCmdLine, NULL, "Network Log");
	TaskWait(net_log_task);

	net_log_task->border_src	= BDS_CONST;
	net_log_task->border_attr	= DKGRAY << 4 + LTGRAY;
	net_log_task->text_attr		= WHITE  << 4 + LTGRAY;
	DocClear(net_log_task->border_doc, TRUE);

	WinHorz(TEXT_COLS / 3, 2 * TEXT_COLS / 3, net_log_task);
	WinVert(2 * TEXT_ROWS / 3, 5 * TEXT_ROWS / 6, net_log_task);
	WinFocus(net_log_task);

	DocPrint(net_log_task->put_doc, "$$WW+H,1$$");
	DocPrint(net_log_task->put_doc,
			 "$$BG,BLUE$$$$WHITE$$ NetLogV(1) app  NetLogV(2) +transport  "
			 "NetLogV(3) all  NetLogClear; $$BG$$$$FG$$\n");

//	net_log_task->put_doc->max_entries = I64_MAX;

	Bts(&net_log_task->win_inhibit, WIf_SELF_FOCUS);
}

U0 NetLogToggle() {
	if (Fs != sys_task)
	{
		"\nMust be ran as system";	
		return;
	}
    net_log_enabled = !net_log_enabled;
	if(!net_log_enabled)
		Kill(net_log_task);
	else
		NetLogInit;
}

U0 NetLogBottom()
{//Move cursor, cur_entry, to bottom.
	Bool unlock;
	CDoc *doc = net_log_task->put_doc;

	unlock = DocLock(doc);
	doc->cur_entry	= doc;
	doc->cur_col	= 0;
	if (unlock)
		DocUnlock(doc);
}

U0 NetLog(U8 *format, ...)
{ // Output text to NetLogTask as Log.
    if (!net_log_enabled) return;
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	if (NetLogCat(buf) > net_log_v)
	{ // filtered out at the current verbosity
		Free(buf);
		return;
	}
	NetLogBottom;

	DocPrint(net_log_task->put_doc, "%s\n", buf);

	Free(buf);
}

U0 NetWarn(U8 *format, ...)
{ // Output text to NetLogTask as Warning. Warnings honour the level: the
  // per-frame ethernet and ARP chatter is warnings, so a filter that skipped
  // them governed nothing that actually floods. Errors stay unconditional.
    if (!net_log_enabled) return;
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	if (NetLogCat(buf) > net_log_v)
	{
		Free(buf);
		return;
	}
	NetLogBottom;

	DocPrint(net_log_task->put_doc, "$$BG,BROWN$$$$WHITE$$%s$$BG$$$$FG$$\n", buf);

	Free(buf);
}

U0 NetErr(U8 *format, ...)
{ // Output text to NetLogTask as Error.
    if (!net_log_enabled) return;
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	NetLogBottom;

	DocPrint(net_log_task->put_doc, "$$BG,RED$$$$WHITE$$%s$$BG$$$$FG$$\n", buf);

	Free(buf);
}

U0 NetDebug(U8 *format, ...)
{ // Output text to NetLogTask as Debug.
    if (!net_log_enabled) return;
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	if (NetLogCat(buf) > net_log_v)
	{
		Free(buf);
		return;
	}
	NetLogBottom;

	DocPrint(net_log_task->put_doc, "$$BG,YELLOW$$$$DKGRAY$$%s$$BG$$$$FG$$\n", buf);

	Free(buf);
}

NetLogInit;