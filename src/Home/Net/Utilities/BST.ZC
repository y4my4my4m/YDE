/***************************************************

Binary Search Tree (BST) Implementation

***************************************************/

class CBST
{
	CBST	*left;
	CBST	*right;
	I64		 value;
};

CBST *BSTInit()
{
	return CAlloc(sizeof(CBST));
}

//A corrupt walk is recorded, not printed: every caller runs inside the
//bound-tree guard, and NetErr reaches DocLock, which Yields. Yielding under CLI
//while holding a spinlock hangs the machine. BSTCorruptionReport drains this
//from outside the guard.
// globals are NOT zeroed
I64	  bst_corrupt_count = 0;
CBST *bst_corrupt_node  = NULL;
I64	  bst_corrupt_value = 0;
U8	 *bst_corrupt_where = NULL;

U0 BSTCorruptionInit()
{
	bst_corrupt_count = 0;
	bst_corrupt_node  = NULL;
	bst_corrupt_value = 0;
	bst_corrupt_where = NULL;
}

BSTCorruptionInit;

Bool BSTNodeIsPlausible(CBST *node)
{ // CAlloc hands out 8-aligned pointers below the 48-bit canonical hole. A node failing this has been freed and its memory reused
	U64 address = node;

	if (address & 7)
		return FALSE;

	if (address < 0x100000 || address >= 0x800000000000)
		return FALSE;

	return TRUE;
}

U0 BSTCorruptionNote(U8 *where, CBST *node, I64 value)
{ // stores only: safe to call with interrupts off and the guard held
	bst_corrupt_count++;
	bst_corrupt_node  = node;
	bst_corrupt_value = value;
	bst_corrupt_where = where;
}

U0 BSTCorruptionReport()
{ // call after releasing the bound-tree guard, never inside it
	if (!bst_corrupt_count)
		return;

	NetErr("BST %s: implausible node 0x%0X at port/value %d. %d corrupt walk(s) abandoned.",
			bst_corrupt_where, bst_corrupt_node, bst_corrupt_value, bst_corrupt_count);

	bst_corrupt_count = 0;
}

U0 BSTAdd(CBST *node, CBST *tree)
{ // using temp and last allows avoiding recursion and non-growing stack issues.
	CBST *temp_tree = tree;
	CBST *last_tree = temp_tree;

	while (temp_tree)
	{ // loop ends when temp_tree hits a NULL node.
		if (!BSTNodeIsPlausible(temp_tree))
		{
			BSTCorruptionNote("ADD", temp_tree, node->value);
			return;
		}

		if (node->value < temp_tree->value)
		{ // if node smaller, go left
			last_tree = temp_tree;
			temp_tree = temp_tree->left;
		}
		else
		{ // if node equal or larger, go right
			last_tree = temp_tree;
			temp_tree = temp_tree->right;
		}
	}
	// once while loop ends, this results in last_tree
	// being the resulting tree to store the node inside of.

	// recompute the direction and set.
	if (node->value < last_tree->value)// if node smaller, go left
		last_tree->left = node;
	else // if node equal or larger, go right
		last_tree->right = node;
}

CBST *BSTParamAdd(I64 value, CBST *tree)
{ // add a node using params, return pointer to the node
	CBST *result = BSTInit;

	result->value = value;

	BSTAdd(result, tree);

	return result;
}

CBST *BSTParamInit(I64 value)
{
	CBST *result = BSTInit;

	result->value = value;

	return result;
}

CBST *BSTFind(I64 value, CBST *tree)
{
	CBST *temp_tree = tree;

	while (temp_tree)
	{
		if (!BSTNodeIsPlausible(temp_tree))
		{
			BSTCorruptionNote("FIND", temp_tree, value);
			return NULL;
		}

		if (value < temp_tree->value) // if value smaller, go left
			temp_tree = temp_tree->left;
		else if (value > temp_tree->value) // if value larger, go right
			temp_tree = temp_tree->right;
		else // if value equal, match found.
			break;
	}
	return temp_tree; // ! NULL if not found.
}

CBST *BSTPop(I64 value, CBST *tree)
{ // mimics TreeNodeFind. pops whole sub-tree, original tree loses whole branch.
	CBST	*parent_tree	= tree;
	CBST	*temp_tree		= parent_tree;
	Bool	 is_left		= FALSE;
	Bool	 is_right		= FALSE;

	while (temp_tree)
	{
		if (!BSTNodeIsPlausible(temp_tree))
		{
			BSTCorruptionNote("POP", temp_tree, value);
			return NULL;
		}

		if (value < temp_tree->value)
		{
			parent_tree	= temp_tree;
			temp_tree	= temp_tree->left;
			is_right	= FALSE;
			is_left		= TRUE;
		}
		else if (value > temp_tree->value)
		{
			parent_tree	= temp_tree;
			temp_tree	= temp_tree->right;
			is_right	= TRUE;
			is_left		= FALSE;
		}
		else // if value equal, match found.
			break;	
	}

	if (temp_tree)
	{ //if we found it, clear its parents link to the node
		if (is_left)
		{
			parent_tree->left = NULL;
		}
		else if (is_right)
		{
			parent_tree->right = NULL;
		}
		else
		{ // the match is the root itself. This function holds a pointer TO the root, not the variable storing it, so it cannot unlink it. Callers that can re-root (TCPSocketClose, UDPSocketClose) handle the root case before calling here
			BSTCorruptionNote("POP-ROOT", temp_tree, value);
			return NULL;
		}
	}

	return temp_tree; // NULL if not found.
}

CBST *BSTSinglePop(I64 value, CBST *tree)
{	// pop a tree off, then add back in its sub-trees to main tree.
	// original node sub-trees are cleared.

	CBST *node	= BSTPop(value, tree);
	CBST *left;
	CBST *right;

	if (node == tree)
		node = NULL; // BSTPop refuses the root
	if (node)
	{
		left	= node->left;
		right	= node->right;

		if (left)
		{ // if node has left tree, add the tree
			BSTAdd(left, tree);
			node->left = NULL;
		}
		if (right)
		{ // if node has right tree, add the tree.
			BSTAdd(right, tree);
			node->right = NULL;
		}
	}

	return node;
}