//http/1.1 client. Responses framed by Content-Length or chunked; live
//connections parked in a small cache to skip the TCP + TLS handshake.
//https uses Protocols/TLS.ZC: encrypted, but the server certificate is NOT verified.

#define HTTP_PORT_DEFAULT	80
#define HTTPS_PORT_DEFAULT	443
#define HTTP_MAX_REDIRECTS	5
#define HTTP_RECV_CHUNK		8192
// the recv loop polls every NET_READ_POLL_MS (TLS.ZC), so net_abort is honoured sub-second; NET_READ_STALL_MS bounds a stalled connection
#define HTTP_BODY_MAX		2097152 // 2 MB cap: keep a giant page from freezing the parser

class CHttpUrl
{
	U8	 host[256];
	U8	 path[4096]; // script bundle URLs run past 3.5 KB of query
	U16	 port;
	Bool is_https;
};

class CHttpResponse
{
	I64	 status;      // e.g. 200, 404; 0 if the status line didn't parse
	U8	*headers;     // raw header block, NUL-terminated
	U8	*body;        // NUL-terminated for convenience
	I64	 body_length; // actual byte count (body may contain NULs)
	U8	*final_url;   // URL after redirects (HttpNav sets it); NULL if none
	I64	 recv_length; // encoded bytes received, before de-chunk and gunzip
	I64	 expect_length; // Content-Length as sent, -1 when unstated
	Bool truncated; // the body is a prefix: framing unsatisfied, the size cap clipped it, or a gzip member failed part-way
};

U0 HttpResponseFree(CHttpResponse *response)
{
	if (!response)
		return;

	Free(response->headers);
	Free(response->body);
	Free(response->final_url);
	Free(response);
}

I64 HttpUrlParse(U8 *url, CHttpUrl *out)
{ // split scheme://host:port/path. Missing scheme means http
	U8	*p = url;
	U8	*host_start;
	U8	*colon = NULL;
	I64	 host_len;

	out->port	  = HTTP_PORT_DEFAULT;
	out->is_https = FALSE;
	StrCopy(out->path, "/");

	if (!StrNICompare(p, "http://", 7))
		p += 7;
	else if (!StrNICompare(p, "https://", 8))
	{
		p += 8;
		out->is_https = TRUE;
		out->port	  = HTTPS_PORT_DEFAULT;
	}

	host_start = p;
	while (*p && *p != '/')
	{
		if (*p == ':')
			colon = p;
		p++;
	}

	if (colon)
	{
		host_len  = colon - host_start;
		out->port = Str2I64(colon + 1);
	}
	else
		host_len = p - host_start;

	if (host_len < 1 || host_len > 255)
	{
		NetErr("HTTP URL PARSE: Bad host in URL: %s", url);
		return -1;
	}

	MemCopy(out->host, host_start, host_len);
	out->host[host_len] = 0;

	if (*p)
	{
		if (StrLen(p) > 4095)
		{
			NetErr("HTTP URL PARSE: path %d bytes, max 4095, host %s.",
				   StrLen(p), out->host);
			return -1;
		}
		StrCopy(out->path, p);
	}

	return 0;
}

U8 *HttpHeaderGet(U8 *headers, U8 *name)
{ // case-insensitive header lookup. Returns an MAlloc'ed value copy or NULL
	U8	*line = headers;
	U8	*value, *end, *result;
	I64	 name_len = StrLen(name);

	while (line && *line)
	{
		if (!StrNICompare(line, name, name_len) && line[name_len] == ':')
		{
			value = line + name_len + 1;
			while (*value == ' ' || *value == '\t')
				value++;

			end = value;
			while (*end && *end != '\r' && *end != '\n')
				end++;

			result = MAlloc(end - value + 1);
			MemCopy(result, value, end - value);
			result[end - value] = 0;

			return result;
		}

		line = StrFind("\n", line);
		if (line)
			line++;
	}

	return NULL;
}


#define HTTP_COOKIE_MAX 48

class CHttpCookie
{
	U8 domain[256]; // no leading dot; matches host itself + subdomains
	U8 path[128];
	U8 name[64];
	U8 value[512];
};

CHttpCookie http_cookies[HTTP_COOKIE_MAX];
I64 http_cookie_count = 0; // the JIT does not zero plain globals

// page/image/script fetch tasks (ZincGX) share this jar: every read and mutation is serialized, since iterating the array must not race a writer of http_cookie_count + slot
I64 http_cookie_lock = 0;

U0 HttpCookieLock()
{
	while (LBts(&http_cookie_lock, 0))
		Yield;
}

U0 HttpCookieUnlock()
{
	LBtr(&http_cookie_lock, 0);
}

Bool HttpCookieDomainMatch(U8 *cookie_domain, U8 *host)
{ // exact host, or host is a subdomain of cookie_domain
	I64 cd = StrLen(cookie_domain), hl = StrLen(host);

	if (!StrICompare(cookie_domain, host))
		return TRUE;
	if (hl > cd + 1 && !StrICompare(host + hl - cd, cookie_domain) &&
		host[hl - cd - 1] == '.')
		return TRUE;

	return FALSE;
}

U0 HttpCookieDel(I64 i)
{
	if (i < 0 || i >= http_cookie_count)
		return;
	if (i != http_cookie_count - 1)
		MemCopy(&http_cookies[i], &http_cookies[http_cookie_count - 1],
				sizeof(CHttpCookie));
	http_cookie_count--;
}

U0 HttpCookieStore(U8 *domain, U8 *path, U8 *name, U8 *value, Bool del)
{ // inputs already bounded by the caller. Holds http_cookie_lock; HttpCookieDel is only called from here, so it must NOT take the lock itself
	I64 i;

	HttpCookieLock;

	for (i = 0; i < http_cookie_count; i++)
		if (!StrICompare(http_cookies[i].domain, domain) &&
			!StrCompare(http_cookies[i].name, name))
			break;

	if (del)
	{
		HttpCookieDel(i);
		HttpCookieUnlock;
		return;
	}
	if (i >= HTTP_COOKIE_MAX)
	{
		HttpCookieUnlock;
		NetErr("HTTP COOKIES: Jar full, dropping %s.", name);
		return;
	}
	StrCopy(http_cookies[i].domain, domain);
	StrCopy(http_cookies[i].path, path);
	StrCopy(http_cookies[i].name, name);
	StrCopy(http_cookies[i].value, value);
	if (i == http_cookie_count)
		http_cookie_count++;

	HttpCookieUnlock;
}

U0 HttpCookiesAccept(CHttpUrl *url, U8 *headers)
{
	U8	*line = headers, *end, *p, *q;
	U8	 name[64], value[512], domain[256], path[128], attr[300];
	I64	 n;
	Bool del;

	while (line && *line)
	{
		if (!StrNICompare(line, "Set-Cookie:", 11))
		{
			p = line + 11;
			while (*p == ' ' || *p == '\t')
				p++;
			end = p;
			while (*end && *end != '\r' && *end != '\n')
				end++;

			StrCopy(domain, url->host);
			StrCopy(path, "/");

			n = 0;
			while (p < end && *p != '=' && *p != ';' && n < 63)
				name[n++] = *p++;
			name[n] = 0;
			value[0] = 0;
			if (p < end && *p == '=')
			{
				p++;
				n = 0;
				while (p < end && *p != ';' && n < 511)
					value[n++] = *p++;
				value[n] = 0;
			}
			del = !value[0]; // empty value = delete

			while (p < end)
			{
				if (*p == ';')
					p++;
				while (p < end && *p == ' ')
					p++;
				n = 0;
				while (p < end && *p != ';' && n < 299)
					attr[n++] = *p++;
				attr[n] = 0;
				if (!StrNICompare(attr, "Domain=", 7))
				{
					q = attr + 7;
					if (*q == '.')
						q++;
					if (StrLen(q) < 255)
						StrCopy(domain, q);
				}
				else if (!StrNICompare(attr, "Path=", 5))
				{
					if (StrLen(attr + 5) < 127)
						StrCopy(path, attr + 5);
				}
				else if (!StrNICompare(attr, "Max-Age=", 8))
				{
					if (Str2I64(attr + 8) <= 0)
						del = TRUE;
				}
				// Expires/Secure/HttpOnly/SameSite ignored: session jar
			}

			if (name[0])
				HttpCookieStore(domain, path, name, value, del);
		}
		line = StrFind("\n", line);
		if (line)
			line++;
	}
}

U8 *HttpCookieHeaderBuild(CHttpUrl *url)
{ // "Cookie: a=b; c=d" CRLF for matching cookies, else "". Always MAlloc'ed
	U8	buf[2048];
	I64 i, used = 0, add;

	buf[0] = 0;
	HttpCookieLock;
	for (i = 0; i < http_cookie_count; i++)
	{
		if (!HttpCookieDomainMatch(http_cookies[i].domain, url->host))
			goto http_ck_next;
		if (StrNCompare(url->path, http_cookies[i].path,
						StrLen(http_cookies[i].path)))
			goto http_ck_next;
		add = StrLen(http_cookies[i].name) + StrLen(http_cookies[i].value) + 3;
		if (used + add > 2000)
			goto http_ck_next;
		if (used)
			CatPrint(buf, "; ");
		CatPrint(buf, "%s=%s", http_cookies[i].name, http_cookies[i].value);
		used = StrLen(buf);
http_ck_next:;
	}
	HttpCookieUnlock;

	if (!buf[0])
		return StrNew("");
	return MStrPrint("Cookie: %s\r\n", buf);
}

public U8 *HttpDocCookieGet(CHttpUrl *url)
{ // bare "a=b; c=d" for document.cookie reads, no header prefix. MAlloc'ed
	U8	buf[2048];
	I64 i;

	buf[0] = 0;
	HttpCookieLock;
	for (i = 0; i < http_cookie_count; i++)
	{
		if (!HttpCookieDomainMatch(http_cookies[i].domain, url->host))
			goto hdc_next;
		if (StrNCompare(url->path, http_cookies[i].path,
						StrLen(http_cookies[i].path)))
			goto hdc_next;
		if (StrLen(buf) > 1900)
			goto hdc_next;
		if (buf[0])
			CatPrint(buf, "; ");
		CatPrint(buf, "%s=%s", http_cookies[i].name, http_cookies[i].value);
hdc_next:;
	}
	HttpCookieUnlock;

	return StrNew(buf);
}

public U0 HttpDocCookieSet(CHttpUrl *url, U8 *s)
{ // document.cookie = "name=value; path=/; ..." -> store name=value for the host
	U8	name[128], value[512];
	I64 i = 0, j = 0;

	while (s[i] == ' ')
		i++;
	while (s[i] && s[i] != '=' && s[i] != ';' && j < 126)
		name[j++] = s[i++];
	name[j] = 0;
	if (s[i] != '=' || !j)
		return;
	i++;
	j = 0;
	while (s[i] && s[i] != ';' && j < 510)
		value[j++] = s[i++];
	value[j] = 0;
	HttpCookieStore(url->host, "/", name, value, FALSE);
}

public U0 HttpCookiesClear()
{
	HttpCookieLock;
	http_cookie_count = 0;
	HttpCookieUnlock;
}

public U0 HttpCookiesShow()
{
	I64 i;

	"%d cookie(s):\n", http_cookie_count;
	for (i = 0; i < http_cookie_count; i++)
		"  %s%s  %s=%s\n", http_cookies[i].domain, http_cookies[i].path,
			http_cookies[i].name, http_cookies[i].value;
}

/* ---- chunked transfer-encoding (RFC 7230 4.1) ---- */

I64 HttpDechunk(U8 *body, I64 len, Bool *_complete)
{ // decode chunked in place: <hex-size>[;ext] CRLF <data> CRLF ... 0 CRLF CRLF. Returns decoded length. *_complete = the terminating 0-chunk was reached
	U8	*src = body, *dst = body, *end = body + len;
	I64	 chunk;
	U8	 c;
	Bool any;

	*_complete = FALSE;
	while (src < end)
	{
		chunk = 0;
		any = FALSE;
		while (src < end)
		{
			c = *src;
			if ('0' <= c <= '9')
				chunk = chunk * 16 + (c - '0');
			else if ('a' <= c <= 'f')
				chunk = chunk * 16 + (c - 'a' + 10);
			else if ('A' <= c <= 'F')
				chunk = chunk * 16 + (c - 'A' + 10);
			else
				break;
			any = TRUE;
			src++;
		}
		while (src < end && *src != '\n') // skip to end of the size line, past any ;ext
			src++;
		if (src < end)
			src++;
		if (chunk <= 0)
		{ // a parsed 0 terminates the body; no digits at all is a malformed stream
			if (any)
				*_complete = TRUE;
			break;
		}
		if (src + chunk > end)
			chunk = end - src;
		MemCopy(dst, src, chunk);
		dst += chunk;
		src += chunk;
		if (src < end && *src == '\r')
			src++;
		if (src < end && *src == '\n')
			src++;
	}
	*dst = 0;

	return dst - body;
}

/* ---- gzip (RFC 1952) ---- */

#define HTTP_GUNZIP_MAX		33554432	// 32MB ceiling on one inflated body

U0 HttpHexHead(U8 *src, I64 len, U8 *out)
{ // first 16 bytes as "1F 8B 08 ". out holds 49 bytes
	U8	*digits = "0123456789ABCDEF";
	I64	 i, n = len;

	if (n > 16)
		n = 16;
	for (i = 0; i < n; i++)
	{
		out[i * 3]	   = digits[(src[i] >> 4) & 15];
		out[i * 3 + 1] = digits[src[i] & 15];
		out[i * 3 + 2] = ' ';
	}
	out[n * 3] = 0;
}

I64 HttpGzipMemberData(U8 *src, I64 src_len, I64 start, U8 *_flg)
{ // offset of the DEFLATE data of the member at start, or -1. RFC 1952 2.3: 10-byte fixed header, then FEXTRA/FNAME/FCOMMENT/FHCRC per FLG
	I64	pos = start + 10;
	U8	flg;

	*_flg = 0;
	if (start < 0 || start + 18 > src_len ||
		src[start] != 0x1F || src[start + 1] != 0x8B || src[start + 2] != 8)
		return -1;
	flg = src[start + 3];
	*_flg = flg;
	if (flg & 4)
	{ // FEXTRA
		if (pos + 2 > src_len)
			return -1;
		pos += 2 + (src[pos] | (src[pos + 1] << 8));
	}
	if (flg & 8) // FNAME
		while (pos < src_len && src[pos++]);
	if (flg & 16) // FCOMMENT
		while (pos < src_len && src[pos++]);
	if (flg & 2) // FHCRC
		pos += 2;
	if (pos >= src_len - 8)
		return -1;

	return pos;
}

U8 *HttpGunzip(U8 *src, I64 src_len, I64 *_out_len, Bool *_partial)
{ // concatenated gzip members through the shared DEFLATE inflater. Returns an MAlloc'ed NUL-terminated buffer, or NULL when nothing decoded. The trailer ISIZE is a starting size, not an allocation contract; *_partial flags a member that failed mid-way, whose bytes are a prefix
	I64			 dpos, isize, cap, used = 0, member = 0;
	U64			 consumed, produced;
	U8			 flg;
	U8			*out, *bigger;
	U8			 hex[64];
	CInflate	 uz;
	Bool		 stop = FALSE, retrying;

	*_out_len = 0;
	*_partial = FALSE;
	HttpHexHead(src, src_len, hex);

	dpos = HttpGzipMemberData(src, src_len, 0, &flg);
	if (dpos < 0)
	{
		NetErr("HTTP GUNZIP: not a gzip stream. src_len %d head [%s]",
			   src_len, hex);
		return NULL;
	}

	// ISIZE is the last member's uncompressed length mod 2^32
	isize = src[src_len - 4] | (src[src_len - 3] << 8) |
			(src[src_len - 2] << 16) | (src[src_len - 1] << 24);
	cap = isize;
	if (cap < 65536 || cap > HTTP_GUNZIP_MAX)
		cap = src_len * 6; // no usable hint: typical HTML DEFLATE ratio
	if (cap < 65536)
		cap = 65536;
	if (cap > HTTP_GUNZIP_MAX)
		cap = HTTP_GUNZIP_MAX;

	out = MAlloc(cap + 1);
	if (!out)
	{
		NetErr("HTTP GUNZIP: cannot allocate %d bytes.", cap + 1);
		return NULL;
	}

	while (!stop)
	{
		member++;
		retrying = TRUE;
		while (retrying)
		{
			MemSet(&uz, 0, sizeof(CInflate));
			consumed = 0;
			produced = 0;
			uz_inflate_data(&uz, out + used, cap - used, src, src_len, dpos,
							&consumed, &produced);
			retrying = FALSE;
			if (uz.error != ZINFL_OK && cap < HTTP_GUNZIP_MAX &&
				(uz.error_line == 489 || uz.error_line == 541 ||
				 uz.error_line == 586))
			{ // a member is a self-contained DEFLATE stream, so redoing it against a larger buffer reproduces the same bytes
				cap *= 2;
				if (cap > HTTP_GUNZIP_MAX)
					cap = HTTP_GUNZIP_MAX;
				bigger = MAlloc(cap + 1);
				if (bigger)
				{
					MemCopy(bigger, out, used);
					Free(out);
					out = bigger;
					retrying = TRUE;
				}
				else
					NetErr("HTTP GUNZIP: cannot grow output to %d bytes.", cap + 1);
			}
		}

		used += produced;

		if (uz.error != ZINFL_OK)
		{
			NetErr("HTTP GUNZIP: member %d inflate error %d at line %d, kept %d bytes.",
				   member, uz.error, uz.error_line, used);
			NetErr("HTTP GUNZIP: src_len %d data@%d FLG 0x%02X ISIZE %d cap %d head [%s]",
				   src_len, dpos, flg, isize, cap, hex);
			*_partial = TRUE;
			stop = TRUE;
		}
		else
		{
			dpos = HttpGzipMemberData(src, src_len, consumed + 8, &flg);
			if (dpos < 0) // CRC32 + ISIZE, then either another member or the end
				stop = TRUE;
		}
	}

	if (!used)
	{
		Free(out);
		return NULL;
	}

	if (member > 1)
		NetLog("HTTP GUNZIP: %d gzip members, %d bytes out.", member, used);

	out[used] = 0;
	*_out_len = used;

	return out;
}

U8 *HttpUrlResolve(CHttpUrl *base, U8 *href)
{ // href absolute against base. MAlloc'ed URL, or NULL for unsupported schemes (mailto:, javascript:, ...)
	U8	*result, *last_slash, *scan;
	U8	*scheme = "http";
	U8	 dir[4096];
	I64	 default_port = HTTP_PORT_DEFAULT;
	I64	 dir_len;

	if (base->is_https)
	{
		scheme = "https";
		default_port = HTTPS_PORT_DEFAULT;
	}

	if (!href || !*href || *href == '#')
		return NULL;

	if (!StrNICompare(href, "http://", 7) || !StrNICompare(href, "https://", 8))
		return StrNew(href);

	if (!StrNICompare(href, "mailto:", 7) || !StrNICompare(href, "javascript:", 11))
		return NULL;

	if (href[0] == '/' && href[1] == '/')
		return MStrPrint("%s:%s", scheme, href); // protocol-relative

	if (*href == '/')
	{
		if (base->port == default_port)
			return MStrPrint("%s://%s%s", scheme, base->host, href);
		return MStrPrint("%s://%s:%d%s", scheme, base->host, base->port, href);
	}

	StrCopy(dir, base->path);
	last_slash = NULL;
	scan = dir;
	while (*scan)
	{
		if (*scan == '/')
			last_slash = scan;
		scan++;
	}
	if (last_slash)
		last_slash[1] = 0;
	dir_len = StrLen(dir);

	if (dir_len + StrLen(href) > 4000)
	{
		NetErr("HTTP URL RESOLVE: %d + %d bytes over the 4000 byte path limit.",
			   dir_len, StrLen(href));
		return NULL;
	}

	if (base->port == default_port)
		result = MStrPrint("%s://%s%s%s", scheme, base->host, dir, href);
	else
		result = MStrPrint("%s://%s:%d%s%s", scheme, base->host, base->port, dir, href);

	return result;
}

/* keep-alive connection cache: completed framed responses park their
   connection here. busy flags under a lock; concurrent fetch tasks each take
   their own slot. */

#define HTTP_CONN_MAX	4

class CHttpConn
{
	U8			 host[256];
	U16			 port;
	Bool		 is_tls, alive, busy;
	CTLS		*tls;
	CTCPSocket	*sock;
};

CHttpConn http_conns[HTTP_CONN_MAX];

#define HTTP_INFLIGHT_MAX	8

class CHttpInflight
{ // the connection a task currently holds open inside HttpRequestRaw. A socket may only be closed by the task that created it: the TCP RX interrupt walks the global socket list, so a cross-task close makes it read freed memory. A throw unwinds past the close, so the owning task's catch handler calls HttpInflightRelease
	CTask		*task;
	CHttpConn	*conn;
	CTCPSocket	*sock;
	CTLS		*tls;
};

CHttpInflight http_inflight[HTTP_INFLIGHT_MAX];
I64		  http_conn_lock = 0; // the JIT zeroes nothing
Bool	  http_conn_init = FALSE;

//Sockets are CAlloc'd on the CALLING task's heap and held by the TCP RX
//interrupt via a global list, so a task dying with a socket open frees that
//memory under the interrupt. ONLY the one persistent task (browser main, set at
//startup) may pool; cancellable fetch tasks always close their connections.
//NEVER add a second pooling task: HttpConnsClose runs from the main task on
//every navigation, and freeing another task's parked socket makes the RX
//interrupt walk freed memory.
public CTask *http_pool_task = NULL;
Bool HttpMayPool()
{
	// TaskValidate, because ZincGX can be killed rather than exited. It catches a freed task, not a new one allocated at the same address: the owner clears the global from its task_end_cb
	return http_pool_task && TaskValidate(http_pool_task) &&
		   Fs == http_pool_task;
}

U0 HttpConnLockAcq()
{
	while (LBts(&http_conn_lock, 0))
		Yield;
}

U0 HttpConnLockRel()
{
	LBtr(&http_conn_lock, 0);
}

U0 HttpConnInitOnce()
{
	HttpConnLockAcq;
	if (!http_conn_init)
	{
		MemSet(http_conns, 0, sizeof(http_conns));
		MemSet(http_inflight, 0, sizeof(http_inflight));
		http_conn_init = TRUE;
	}
	HttpConnLockRel;
}

CHttpConn *HttpConnTake(U8 *host, U16 port, Bool is_tls)
{
	I64 i;
	CHttpConn *c = NULL;

	HttpConnInitOnce;
	HttpConnLockAcq;
	for (i = 0; i < HTTP_CONN_MAX; i++)
	{
		if (http_conns[i].alive && !http_conns[i].busy &&
			http_conns[i].is_tls == is_tls && http_conns[i].port == port &&
			!StrICompare(http_conns[i].host, host))
		{
			http_conns[i].busy = TRUE;
			c = &http_conns[i];
			break;
		}
	}
	HttpConnLockRel;
	return c;
}

U0 HttpConnKill(CHttpConn *c)
{
	if (!c)
		return;
	HttpConnLockAcq;
	if (c->tls)
		TLSClose(c->tls); // closes the socket too
	else if (c->sock)
		TCPSocketClose(c->sock);
	c->tls = NULL;
	c->sock = NULL;
	c->alive = FALSE;
	c->busy = FALSE;
	HttpConnLockRel;
}

U0 HttpInflightReap()
{
	I64 i;

	for (i = 0; i < HTTP_INFLIGHT_MAX; i++)
		if (http_inflight[i].task && !TaskValidate(http_inflight[i].task))
			http_inflight[i].task = NULL;
}

U0 HttpInflightSet(CHttpConn *conn, CTCPSocket *sock, CTLS *tls)
{ // one slot per task: a task runs one request at a time
	I64 i, pick = -1;

	HttpConnInitOnce;
	HttpConnLockAcq;
	HttpInflightReap;
	for (i = 0; (i < HTTP_INFLIGHT_MAX) && (pick < 0); i++)
		if (http_inflight[i].task == Fs)
			pick = i;
	for (i = 0; (i < HTTP_INFLIGHT_MAX) && (pick < 0); i++)
		if (!http_inflight[i].task)
			pick = i;
	if (pick >= 0)
	{
		http_inflight[pick].conn = conn;
		http_inflight[pick].sock = sock;
		http_inflight[pick].tls	 = tls;
		http_inflight[pick].task = Fs; // published last
	}
	HttpConnLockRel;
}

U0 HttpInflightClear()
{
	I64 i;

	HttpConnInitOnce;
	HttpConnLockAcq;
	HttpInflightReap;
	for (i = 0; i < HTTP_INFLIGHT_MAX; i++)
		if (http_inflight[i].task == Fs)
			http_inflight[i].task = NULL;
	HttpConnLockRel;
}

public U0 HttpInflightRelease()
{ // close whatever request this task left open. Call it from a catch handler in the task that ran the request, never from another task
	CHttpConn	*conn = NULL;
	CTCPSocket	*sock = NULL;
	CTLS		*tls  = NULL;
	I64			 i;

	HttpConnInitOnce;
	HttpConnLockAcq;
	HttpInflightReap;
	for (i = 0; i < HTTP_INFLIGHT_MAX; i++)
		if (http_inflight[i].task == Fs)
		{
			conn = http_inflight[i].conn;
			sock = http_inflight[i].sock;
			tls	 = http_inflight[i].tls;
			http_inflight[i].task = NULL; // claim before closing
		}
	HttpConnLockRel; // HttpConnKill takes the same lock
	if (conn)
		HttpConnKill(conn);
	else if (tls)
		TLSClose(tls); // closes the socket too
	else if (sock)
		TCPSocketClose(sock);
}

U0 HttpConnGive(CHttpConn *reuse, U8 *host, U16 port, Bool is_tls,
				CTCPSocket *sock, CTLS *tls)
{ // park a healthy connection. reuse != NULL means it came from the cache, so just clear busy; else store into a free or dead slot
	I64 i, pick = -1;

	if (reuse)
	{
		HttpConnLockAcq;
		reuse->busy = FALSE;
		HttpConnLockRel;
		return;
	}
	HttpConnInitOnce;
	HttpConnLockAcq;
	for (i = 0; i < HTTP_CONN_MAX; i++)
	{
		if (!http_conns[i].alive && !http_conns[i].busy)
		{
			pick = i;
			break;
		}
	}
	if (pick < 0)
	{
		for (i = 0; i < HTTP_CONN_MAX; i++)
		{
			if (!http_conns[i].busy)
			{
				if (http_conns[i].tls)
					TLSClose(http_conns[i].tls);
				else if (http_conns[i].sock)
					TCPSocketClose(http_conns[i].sock);
				http_conns[i].alive = FALSE;
				pick = i;
				break;
			}
		}
	}
	if (pick < 0)
	{
		HttpConnLockRel;
		if (tls)
			TLSClose(tls);
		else if (sock)
			TCPSocketClose(sock);
		return;
	}
	StrCopy(http_conns[pick].host, host);
	http_conns[pick].port = port;
	http_conns[pick].is_tls = is_tls;
	http_conns[pick].tls = tls;
	http_conns[pick].sock = sock;
	http_conns[pick].alive = TRUE;
	http_conns[pick].busy = FALSE;
	HttpConnLockRel;
}

public U0 HttpConnsClose()
{
	I64 i;

	HttpConnInitOnce;
	for (i = 0; i < HTTP_CONN_MAX; i++)
		if (http_conns[i].alive && !http_conns[i].busy)
			HttpConnKill(&http_conns[i]);
}

I64 HttpChunkedComplete(U8 *body, I64 len)
{ // 1 = chunked payload incl. terminating 0-chunk fully arrived, -1 = need more data
	U8	*p = body, *end = body + len;
	I64	 chunk;
	U8	 c;
	Bool any;

	while (TRUE)
	{
		chunk = 0;
		any = FALSE;
		while (p < end)
		{
			c = *p;
			if ('0' <= c <= '9')
				chunk = chunk * 16 + c - '0';
			else if ('a' <= c <= 'f')
				chunk = chunk * 16 + c - 'a' + 10;
			else if ('A' <= c <= 'F')
				chunk = chunk * 16 + c - 'A' + 10;
			else
				break;
			any = TRUE;
			p++;
		}
		if (!any)
			return -1;
		while (p < end && *p != '\n')
			p++;
		if (p >= end)
			return -1;
		p++;
		if (chunk == 0)
		{ // trailer section: zero or more header lines, then an empty one. All of it has to be consumed or it prefixes the next response on a pooled connection
			while (p < end)
			{
				if (*p == '\n')
					return 1;
				if (*p == '\r')
				{
					if (p + 1 >= end)
						return -1;
					return 1;
				}
				while (p < end && *p != '\n')
					p++;
				if (p >= end)
					return -1;
				p++;
			}
			return -1;
		}
		if (p + chunk + 2 > end)
			return -1;
		p += chunk + 2;
	}
}

CHttpResponse *HttpRequestRaw(CHttpUrl *url, U8 *method="GET",
							  U8 *content_type=NULL, U8 *body=NULL, I64 body_len=0,
							  U8 *extra_hdrs=NULL)
{ // one round trip, no redirect handling. Sends the cookie jar, accepts gzip, parses Set-Cookie, inflates the body. extra_hdrs: raw CRLF-terminated header lines
	CTCPSocket	  *sock;
	CTLS		  *tls = NULL;
	CHttpResponse *response;
	U8			  *request, *buf, *new_buf, *header_end, *status_ptr;
	U8			  *cookie_hdr, *encoding, *unzipped;
	I64			   buf_size, buf_used, received, header_block_len, unzipped_len;
	I64			   deadline, tries;
	Bool		   aborted;
	CHttpConn	  *conn;
	Bool		   reused, have_hdr, is_chunked, complete, keep_ok, poolable;
	Bool		   clipped, gz_partial, chunk_ok;
	I64			   content_len, hdr_len, body_have;
	U8			  *hval, *conn_val;
	U8			   save_ch;

	poolable = HttpMayPool;
	conn = NULL;
	if (poolable)
		conn = HttpConnTake(url->host, url->port, url->is_https);

http_fresh:
	if (conn)
	{
		sock = conn->sock;
		tls = conn->tls;
		reused = TRUE;
	}
	else
	{
		reused = FALSE;
		tls = NULL;
		// PCNet can drop the first connection after boot (transient "APAD XMT TRUNCATE")
		sock = TCPConnectionCreate(url->host, url->port);
		for (tries = 0; sock <= 0 && tries < 3 && !net_abort; tries++)
		{
			Sleep(400);
			sock = TCPConnectionCreate(url->host, url->port);
		}
		if (sock <= 0)
		{
			NetErr("HTTP %s: Connection to %s:%d failed.", method, url->host, url->port);
			return NULL;
		}

		sock->timeout = NET_READ_POLL_MS; // short polls: reads stay cancellable

		if (url->is_https)
		{ // TLS 1.3 owns the socket from here on (TLSClose closes it)
			tls = TLSConnect(url->host, sock);
			if (!tls)
			{
				NetErr("HTTP %s: TLS handshake to %s failed.", method, url->host);
				TCPSocketClose(sock);
				return NULL;
			}
		}
	}
	HttpInflightSet(conn, sock, tls);

	cookie_hdr = HttpCookieHeaderBuild(url); // "" or a Cookie header line
	if (!extra_hdrs)
		extra_hdrs = "";
	if (poolable)
		conn_val = "keep-alive"; // this task reuses the socket for the next request
	else
		conn_val = "close"; // spawned/cancellable task: server closes, we EOF
	if (body)
	{
		if (!content_type)
			content_type = "application/x-www-form-urlencoded";
		request = MStrPrint("%s %s HTTP/1.1\r\n"
							"Host: %s\r\n"
							"User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
							"(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36\r\n"
							"Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n"
							"Accept-Language: en-US,en;q=0.9\r\n"
							"Accept-Encoding: gzip\r\n"
							"Sec-CH-UA: \"Chromium\";v=\"126\", \"Not.A/Brand\";v=\"24\", \"Google Chrome\";v=\"126\"\r\n"
							"Sec-CH-UA-Mobile: ?0\r\n"
							"Sec-CH-UA-Platform: \"Linux\"\r\n"
							"Sec-Fetch-Site: none\r\n"
							"Sec-Fetch-Mode: navigate\r\n"
							"Sec-Fetch-User: ?1\r\n"
							"Sec-Fetch-Dest: document\r\n"
							"Upgrade-Insecure-Requests: 1\r\n"
							"%s%s"
							"Content-Type: %s\r\n"
							"Content-Length: %d\r\n"
							"Connection: %s\r\n"
							"\r\n",
							method, url->path, url->host, cookie_hdr, extra_hdrs,
							content_type, body_len, conn_val);
	}
	else
		request = MStrPrint("%s %s HTTP/1.1\r\n"
							"Host: %s\r\n"
							"User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
							"(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36\r\n"
							"Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n"
							"Accept-Language: en-US,en;q=0.9\r\n"
							"Accept-Encoding: gzip\r\n"
							"Sec-CH-UA: \"Chromium\";v=\"126\", \"Not.A/Brand\";v=\"24\", \"Google Chrome\";v=\"126\"\r\n"
							"Sec-CH-UA-Mobile: ?0\r\n"
							"Sec-CH-UA-Platform: \"Linux\"\r\n"
							"Sec-Fetch-Site: none\r\n"
							"Sec-Fetch-Mode: navigate\r\n"
							"Sec-Fetch-User: ?1\r\n"
							"Sec-Fetch-Dest: document\r\n"
							"Upgrade-Insecure-Requests: 1\r\n"
							"%s%s"
							"Connection: %s\r\n"
							"\r\n",
							method, url->path, url->host, cookie_hdr, extra_hdrs,
							conn_val);
	Free(cookie_hdr);
	if (tls)
	{
		TLSWrite(tls, request, StrLen(request));
		if (body)
			TLSWrite(tls, body, body_len);
	}
	else
	{
		TCPSocketSendString(sock, request);
		if (body)
			TCPSocketSend(sock, body, body_len);
	}
	Free(request);

	buf_size = HTTP_RECV_CHUNK * 4;
	buf_used = 0;
	buf = MAlloc(buf_size);
	aborted = FALSE;
	have_hdr = FALSE;
	is_chunked = FALSE;
	complete = FALSE;
	clipped = FALSE;
	gz_partial = FALSE;
	chunk_ok = FALSE;
	keep_ok = FALSE;
	content_len = -1;
	hdr_len = 0;
	deadline = counts.jiffies + NET_READ_STALL_MS * JIFFY_FREQ / 1000;

	while (TRUE)
	{
		if (net_abort)
		{
			aborted = TRUE;
			break;
		}

		if (buf_used + HTTP_RECV_CHUNK + 1 > buf_size)
		{
			buf_size *= 2;
			new_buf = MAlloc(buf_size);
			MemCopy(new_buf, buf, buf_used);
			Free(buf);
			buf = new_buf;
		}

		if (tls)
			received = TLSRead(tls, buf + buf_used, HTTP_RECV_CHUNK);
		else
			received = TCPSocketReceive(sock, buf + buf_used, HTTP_RECV_CHUNK);

		if (received > 0)
		{
			buf_used += received;
			buf[buf_used] = 0;
			deadline = counts.jiffies + NET_READ_STALL_MS * JIFFY_FREQ / 1000;

			if (!have_hdr)
			{
				header_end = StrFind("\r\n\r\n", buf);
				if (header_end)
				{
					have_hdr = TRUE;
					hdr_len = header_end - buf;
					save_ch = buf[hdr_len];
					buf[hdr_len] = 0;
					hval = HttpHeaderGet(buf, "Content-Length");
					if (hval)
					{
						content_len = Str2I64(hval);
						Free(hval);
					}
					hval = HttpHeaderGet(buf, "Transfer-Encoding");
					if (hval)
					{
						if (StrIMatch("chunked", hval))
							is_chunked = TRUE;
						Free(hval);
					}
					keep_ok = !StrNCompare(buf, "HTTP/1.1", 8);
					hval = HttpHeaderGet(buf, "Connection");
					if (hval)
					{
						if (StrIMatch("close", hval))
							keep_ok = FALSE;
						Free(hval);
					}
					buf[hdr_len] = save_ch;
				}
			}
			if (have_hdr)
			{ // stop on framing, not EOF: a keep-alive server never closes
				body_have = buf_used - (hdr_len + 4);
				if (is_chunked)
				{
					if (HttpChunkedComplete(buf + hdr_len + 4, body_have) > 0)
					{
						complete = TRUE;
						break;
					}
				}
				else if (content_len >= 0 && body_have >= content_len)
				{
					complete = TRUE;
					break;
				}
			}
			if (buf_used >= HTTP_BODY_MAX)
			{
				clipped = TRUE;
				NetErr("HTTP %s: %s:%d%s clipped at the %d byte cap; "
					   "%d bytes read, Content-Length %d.",
					   method, url->host, url->port, url->path, HTTP_BODY_MAX,
					   buf_used, content_len);
				break;
			}
		}
		else if (received == 0)
			break;
		else
		{ // -1: TLS already waited internally (real end/error); plain = poll tick
			if (tls)
				break;
			if (counts.jiffies > deadline)
				break;
		}
	}

	if (net_abort)
		aborted = TRUE;

	if (reused && !aborted && !have_hdr && buf_used == 0)
	{ // server idle-closed the parked connection; drop it and retry once on a fresh one
		NetLog("HTTP %s: cached connection stale; reconnecting.", method);
		HttpInflightClear;
		HttpConnKill(conn);
		conn = NULL;
		Free(buf);
		goto http_fresh;
	}

	HttpInflightClear; // every path below this point has released the socket
	if (poolable && complete && keep_ok && !aborted)
		HttpConnGive(conn, url->host, url->port, url->is_https, sock, tls);
	else if (conn)
		HttpConnKill(conn);
	else
	{
		if (tls)
			TLSClose(tls);
		else
			TCPSocketClose(sock);
	}

	buf[buf_used] = 0;

	if (aborted)
	{
		NetLog("HTTP %s: Aborted by user.", method);
		Free(buf);
		return NULL;
	}

	if (buf_used < 12)
	{
		NetErr("HTTP %s: Empty or truncated response (%d bytes).", method, buf_used);
		Free(buf);
		return NULL;
	}

	header_end = StrFind("\r\n\r\n", buf);
	if (!header_end)
	{
		NetErr("HTTP %s: No header terminator in response.", method);
		Free(buf);
		return NULL;
	}

	response = CAlloc(sizeof(CHttpResponse));

	header_block_len   = header_end - buf;
	response->headers  = MAlloc(header_block_len + 1);
	MemCopy(response->headers, buf, header_block_len);
	response->headers[header_block_len] = 0;

	response->body_length = buf_used - (header_block_len + 4);
	response->body		  = MAlloc(response->body_length + 1);
	MemCopy(response->body, header_end + 4, response->body_length);
	response->body[response->body_length] = 0;

	response->recv_length	= response->body_length;
	response->expect_length = content_len;
	if (clipped)
		response->truncated = TRUE;
	else if (!is_chunked && content_len >= 0 && StrCompare(method, "HEAD") &&
			 response->recv_length < content_len)
		response->truncated = TRUE;

	// "HTTP/1.x NNN ...": status follows the first space
	status_ptr = StrFind(" ", response->headers);
	if (status_ptr)
		response->status = Str2I64(status_ptr + 1);

	Free(buf);

	HttpCookiesAccept(url, response->headers);

	// de-chunk FIRST: chunked framing wraps the (maybe gzipped) payload
	encoding = HttpHeaderGet(response->headers, "Transfer-Encoding");
	if (encoding)
	{
		if (StrIMatch("chunked", encoding))
		{
			response->body_length = HttpDechunk(response->body,
												response->body_length, &chunk_ok);
			response->recv_length = response->body_length;
			if (!chunk_ok)
				response->truncated = TRUE;
		}
		Free(encoding);
	}

	encoding = HttpHeaderGet(response->headers, "Content-Encoding");
	if (encoding)
	{
		if (StrIMatch("gzip", encoding))
		{
			unzipped = HttpGunzip(response->body, response->body_length,
								  &unzipped_len, &gz_partial);
			if (unzipped)
			{
				Free(response->body);
				response->body		  = unzipped;
				response->body_length = unzipped_len;
				if (gz_partial)
					response->truncated = TRUE; // a cut gzip stream still inflates
			}
			else
			{ // never hand raw gzip bytes to the HTML parser; the placeholder is a document, so callers needing the real bytes see this as a failed body
				NetErr("HTTP %s: gzip decode failed; discarding %d compressed bytes.",
					   method, response->body_length);
				response->truncated = TRUE;
				Free(response->body);
				response->body = StrNew("<html><body><p>[gzip decode failed]</p></body></html>");
				response->body_length = StrLen(response->body);
			}
		}
		Free(encoding);
	}

	if (response->truncated)
		NetErr("HTTP %s: TRUNCATED %s:%d%s -> %d. %d encoded bytes of %d "
			   "declared, %d after decode. cap-clipped %d, gzip cut %d.",
			   method, url->host, url->port, url->path, response->status,
			   response->recv_length, content_len, response->body_length,
			   clipped, gz_partial);

	NetLog("HTTP %s: %s:%d%s -> %d, %d body bytes.",
		   method, url->host, url->port, url->path, response->status,
		   response->body_length);

	return response;
}

CHttpResponse *HttpGetRaw(CHttpUrl *url)
{
	return HttpRequestRaw(url, "GET");
}

CHttpResponse *HttpNav(U8 *url, U8 *method, U8 *content_type, U8 *body, I64 body_len,
					   U8 *extra_hdrs=NULL)
{ // request with redirect following. Browser rules: 303 (and 301/302 after a POST) become a bodyless GET; 307/308 repeat method + body
	CHttpUrl	   parsed;
	CHttpResponse *response = NULL;
	U8			  *current = StrNew(url);
	U8			  *location, *resolved;
	I64			   redirects = 0;
	Bool		   done = FALSE;

	while (!done && redirects <= HTTP_MAX_REDIRECTS)
	{
		if (net_abort || HttpUrlParse(current, &parsed) < 0)
			done = TRUE;
		else
		{
			response = HttpRequestRaw(&parsed, method, content_type, body, body_len,
									  extra_hdrs);

			if (response &&
				(response->status == 301 || response->status == 302 ||
				 response->status == 303 || response->status == 307 ||
				 response->status == 308))
			{
				location = HttpHeaderGet(response->headers, "Location");
				if (location)
				{
					resolved = HttpUrlResolve(&parsed, location);
					Free(location);

					if (resolved)
					{
						NetLog("HTTP %s: Redirect %d -> %s",
							   method, response->status, resolved);
						if (response->status == 303 ||
							(body && (response->status == 301 || response->status == 302)))
						{
							method	 = "GET";
							body	 = NULL;
							body_len = 0;
						}
						Free(current);
						current = resolved;
						HttpResponseFree(response);
						response = NULL;
						redirects++;
					}
					else
					{
						NetErr("HTTP %s: Unresolvable redirect target.", method);
						done = TRUE;
					}
				}
				else
					done = TRUE;
			}
			else
				done = TRUE;
		}
	}

	if (response)
		response->final_url = StrNew(current); // the URL that actually served it
	Free(current);
	return response;
}

CHttpResponse *HttpGet(U8 *url)
{ // GET with redirect following. Caller frees with HttpResponseFree
	return HttpNav(url, "GET", NULL, NULL, 0);
}

CHttpResponse *HttpPost(U8 *url, U8 *body,
						U8 *content_type="application/x-www-form-urlencoded")
{ // POST with browser-style redirect handling. Caller keeps ownership of body
	return HttpNav(url, "POST", content_type, body, StrLen(body));
}

CHttpResponse *HttpReq(U8 *url, U8 *method="GET", U8 *body=NULL,
					   U8 *content_type="application/json", U8 *extra_hdrs=NULL)
{ // any method, JSON default, custom CRLF-terminated header lines. Caller frees with HttpResponseFree
	I64 body_len = 0;

	if (body)
		body_len = StrLen(body);
	return HttpNav(url, method, content_type, body, body_len, extra_hdrs);
}

public U0 HttpTest(U8 *url="https://example.com")
{ /* GET with diagnostics on THIS terminal: TLS handshake stages
	(tls_verbose), status, sizes, first bytes of the body.
	  HttpTest;                          (https://example.com)
	  HttpTest("https://cloudflare.com");
	  HttpTest("http://frogfind.com/"); */
	CHttpResponse *r;
	I64	 i, show;

	"$$LTBLUE$$--- HTTP test: %s ---$$FG$$\n", url;

	tls_verbose = TRUE;
	r = HttpGet(url);
	tls_verbose = FALSE;

	if (!r)
	{
		"$$RED$$HttpGet returned NULL -- fetch failed.$$FG$$\n";
		"(For https, read the TLS STAGE / alert lines above.)\n";
		return;
	}

	"$$GREEN$$Got response:$$FG$$ status=%d, %d body bytes.\n",
		r->status, r->body_length;

	show = r->body_length;
	if (show > 400)
		show = 400;
	"$$FG,LTGRAY$$--- first %d body bytes ---$$FG$$\n", show;
	for (i = 0; i < show; i++)
	{
		if (r->body[i] == '$$')
			"$$$$";
		else if (r->body[i] >= ' ' || r->body[i] == '\n' || r->body[i] == '\t')
			"%c", r->body[i];
		else
			".";
	}
	"\n$$FG,LTGRAY$$--- end ---$$FG$$\n";

	HttpResponseFree(r);
}
