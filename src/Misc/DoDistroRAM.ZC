//Build the RAM-distro OS image: a RedSea filesystem holding the whole OS,
//snapshotted from a RAM drive. Ships as a Limine module alongside Kernel.ZXE
//(build/build-ram-iso.sh); ZealBooter passes the module address to the kernel,
//which mounts it as RAM drive B:.
//
//Run from an installed, writable system:  #include "::/Misc/DoDistroRAM"
//Output: ::/Tmp/RAMDistro.BIN  (copy to the host, feed to build-ram-iso.sh)
//
//Destroys the contents of RAM drive A: while building.

#define RAMDISTRO_IMAGE		"::/Tmp/RAMDistro.BIN"

//Apps larger than this are left out; the image is loaded whole into memory.
#define RAMDISTRO_APP_MAX_MB	8

//RedSea allocation bitmap and directory entries on top of file data; measured at a few percent.
#define RAMDISTRO_OVERHEAD_PCT	15

I64 RAMDistroTreeSize(CDirEntry *de)
{//Bytes a found tree occupies once copied, files rounded up to whole blocks.
	I64 res = 0;

	while (de)
	{
		if (de->attr & RS_ATTR_DIR)
			res += BLK_SIZE + RAMDistroTreeSize(de->sub);
		else
			res += (de->size + BLK_SIZE - 1) & ~(BLK_SIZE - 1);
		de = de->next;
	}

	return res;
}

I64 RAMDistroDirSize(U8 *mask)
{//Bytes the tree under mask will occupy on the image.
	CDirEntry	*de	 = FilesFind(mask, FUF_RECURSE);
	I64			 res = RAMDistroTreeSize(de);

	DirTreeDel(de);

	return res;
}

I64 RAMDistroAppsSize(I64 max_mb, Bool print)
{//Total of the apps small enough to ship. Lists what it drops.
	CDirEntry	*head = FilesFind("::/Apps/*", FUF_JUST_DIRS);
	CDirEntry	*de	  = head;
	I64			 res  = 0, sz, max = max_mb * 0x100000;
	U8			*mask;

	while (de)
	{
		mask = MStrPrint("%s/*", de->full_name);
		sz	 = RAMDistroDirSize(mask);
		Free(mask);

		if (sz <= max)
			res += sz;
		else if (print)
			"  skipping %-20s %6d MB\n", de->name, sz / 0x100000;

		de = de->next;
	}
	DirTreeDel(head);

	return res;
}

U0 RAMDistroCopyApps(I64 max_mb)
{//Copy each app that fits. Size decides, not a name list.
	CDirEntry	*head = FilesFind("::/Apps/*", FUF_JUST_DIRS);
	CDirEntry	*de	  = head;
	I64			 sz, max = max_mb * 0x100000;
	U8			*mask, *dst;

	DirMake("A:/Apps");
	while (de)
	{
		mask = MStrPrint("%s/*", de->full_name);
		sz	 = RAMDistroDirSize(mask);
		Free(mask);

		if (sz <= max)
		{
			dst = MStrPrint("A:/Apps/%s", de->name);
			CopyTree(de->full_name, dst);
			Free(dst);
		}

		de = de->next;
	}
	DirTreeDel(head);
}

Bool RAMDistroSkipDir(U8 *name)
{//Tmp holds RAMDistro.BIN itself; copying it in would double the image.
	return ToBool(!StrCompare(name, "Tmp"));
}

I64 RAMDistroTreesSize(I64 app_max_mb, Bool print)
{//Bytes every shipped top-level directory will occupy.
	CDirEntry	*head = FilesFind("::/*", FUF_JUST_DIRS);
	CDirEntry	*de	  = head;
	I64			 res  = 0;
	U8			*mask;

	while (de)
	{
		if (!StrCompare(de->name, "Apps"))
			res += RAMDistroAppsSize(app_max_mb, print);
		else if (!RAMDistroSkipDir(de->name))
		{
			mask = MStrPrint("%s/*", de->full_name);
			res += RAMDistroDirSize(mask);
			Free(mask);
		}
		de = de->next;
	}
	DirTreeDel(head);

	return res;
}

U0 RAMDistroCopyTrees(I64 app_max_mb)
{//Every top-level directory, enumerated rather than listed.
	CDirEntry	*head = FilesFind("::/*", FUF_JUST_DIRS);
	CDirEntry	*de	  = head;
	U8			*dst;

	while (de)
	{
		if (!StrCompare(de->name, "Apps"))
			RAMDistroCopyApps(app_max_mb);
		else if (!RAMDistroSkipDir(de->name))
		{
			dst = MStrPrint("A:/%s", de->name);
			CopyTree(de->full_name, dst);
			Free(dst);
		}
		de = de->next;
	}
	DirTreeDel(head);
}

U0 MakeRAMDistro(I64 blks=0x30000, I64 app_max_mb=RAMDISTRO_APP_MAX_MB)
{//blks: image size in 512-byte blocks (default 96MB).
//app_max_mb: per-app size ceiling; 0 ships no apps at all.
	CBlkDev		*bd;
	CDirEntry	 de;
	I64			 need, cap;

	if (!DriveIsWritable)
	{
		"Drive must be writable. Install on hard drive or USB first.\n";
		return;
	}

//Measure before building; FOpen throws partway through the copy on an oversized tree.
	"Measuring source tree...\n";
	need  = RAMDistroTreesSize(app_max_mb, TRUE);
	need += need * RAMDISTRO_OVERHEAD_PCT / 100;
	cap	  = blks * BLK_SIZE;

	"Need ~%d MB, image is %d MB.\n", need / 0x100000, cap / 0x100000;
	if (need > cap)
	{
		"\n$$RED$$Image too small.$$FG$$ Re-run with MakeRAMDistro(0x%X);\n",
			((need / BLK_SIZE) + 0x1000) & ~0xFFF;
		"Or lower the per-app ceiling, e.g. MakeRAMDistro(%d, 2);\n", blks;
		return;
	}

	"Building %d MB RedSea image in RAM drive A:...\n", cap / 0x100000;
	bd = Letter2BlkDev('A', FALSE);
	if (bd)
		BlkDevDel(bd);
	bd = BlkDevNextFreeSlot('A', BDT_RAM);
	bd->max_blk = blks - 1;
	if (!BlkDevAdd(bd,, TRUE, TRUE))
	{
		"Could not create RAM drive A:.\n";
		return;
	}

///Boot is included, unlike the DVD distro where build-iso.sh supplies it.
//Installing from the RAM image needs /Boot/Limine-BIOS-HDD.HH (OSInstall.ZC
//includes it at compile time), Limine-BIOS.SYS and ZealBooter.ELF.
	RAMDistroCopyTrees(app_max_mb);
	Del("A:/Home/Registry.ZC");			//fresh registry on first boot
	Copy("::/*", "A:/");				//root files (StartOS.ZC, MakeHome.ZC, ...)
	DirMake("A:/Tmp");
	DirMake("A:/Tmp/ScreenShots");

//A file present on the source but missing on A: means the copy ran out of space.
	if (FileFind("::/DE/MakeDE.ZC")				&& !FileFind("A:/DE/MakeDE.ZC")				||
		FileFind("::/Doc/Start.DD")				&& !FileFind("A:/Doc/Start.DD")				||
		FileFind("::/StartOS.ZC")				&& !FileFind("A:/StartOS.ZC")				||
		FileFind("::/Boot/Limine-BIOS-HDD.HH")	&& !FileFind("A:/Boot/Limine-BIOS-HDD.HH"))
	{
		"\n$$RED$$RAM drive too small: files were skipped during copy.$$FG$$\n"
		"Re-run with more blocks, e.g. MakeRAMDistro(0x40000); (128MB).\n";
		return;
	}

//BlkDevInit resets max_blk from MSize() of the allocation, rounding up, so the
//RedSea filesystem spans (max_blk+1) blocks, >= blks. The kernel mounts B: with
//max_blk = imagesize/512-1, so the image must be the full filesystem.
	"Writing %s...\n", RAMDISTRO_IMAGE;
	Del(RAMDISTRO_IMAGE);
	FileWrite(RAMDISTRO_IMAGE, bd->RAM_disk, (bd->max_blk + 1) * BLK_SIZE);

	if (FileFind(RAMDISTRO_IMAGE, &de, FUF_JUST_FILES))
	{
		"\nDone: %s (%d MB).\n", RAMDISTRO_IMAGE, de.size / 0x100000;
		"Copy it to the host and run build/build-ram-iso.sh.\n";
		Free(de.full_name);
	}
	else
		"FAILED: image not written.\n";
}

MakeRAMDistro;
