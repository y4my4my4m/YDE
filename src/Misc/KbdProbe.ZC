//8042 configuration byte and keyboard delivery counters.
//
//  #include "::/Misc/KbdProbe"   prints the config byte once
//  KbdCfgRep;                    prints it again
//  KbdWatch;                     samples delivery for 15s while keys are pressed

#define KBD_PROBE_SPIN	1000000

I64 KbdCfgRead()
{//Config byte, or -1 if the controller does not answer.
	I64 i;

	while (InU8(KBD_CTRL) & 1)	//drop a pending byte; it is not the answer
		InU8(KBD_PORT);
	OutU8(KBD_CTRL, 0x20);
	for (i = 0; i < KBD_PROBE_SPIN; i++)
		if (InU8(KBD_CTRL) & 1)
			return InU8(KBD_PORT);

	return -1;
}

public U0 KbdCfgRep()
{
	I64 cfg = KbdCfgRead;

	if (cfg < 0)
	{
		"8042: no response.\n";
		return;
	}

	"cfg 0x%02X  status 0x%02X\n", cfg, InU8(KBD_CTRL);
	"  kbd int    %d   want 1\n",	cfg & 1;
	"  aux int    %d\n",			(cfg >> 1) & 1;
	"  kbd clock  %d   want 1\n",	!((cfg >> 4) & 1);
	"  aux clock  %d\n",			!((cfg >> 5) & 1);
	"  translate  %d   want 1\n",	(cfg >> 6) & 1;
	"irqs_working %d  count %d  fifo2 %d  sc_fifo %d\n",
		kbd.irqs_working, kbd.count, FifoU8Count(kbd.fifo2),
		FifoI64Count(kbd.scan_code_fifo);
}

public U0 AuxEnable()
{//Enable the 8042 AUX port, its interrupt and clock. A laptop trackpad on the
//AUX port is silent while bit 1 is clear or bit 5 set.
	I64 i, cfg = KbdCfgRead;

	if (cfg < 0)
	{
		"8042: no response.\n";
		return;
	}

	for (i = 0; i < KBD_PROBE_SPIN && (InU8(KBD_CTRL) & 2); i++)
		;
	OutU8(KBD_CTRL, 0xA8);				//enable AUX port

	cfg = (cfg | 0x02) & ~0x20;			//AUX interrupt on, AUX clock on
	for (i = 0; i < KBD_PROBE_SPIN && (InU8(KBD_CTRL) & 2); i++)
		;
	OutU8(KBD_CTRL, 0x60);
	for (i = 0; i < KBD_PROBE_SPIN && (InU8(KBD_CTRL) & 2); i++)
		;
	OutU8(KBD_PORT, cfg);

	"AUX enabled. cfg now:\n";
	KbdCfgRep;
}

public U0 AuxWatch(I64 secs=15)
{//Sample the PS/2 mouse path. pos or event moving means the trackpad reports.
	I64 i;

	for (i = 0; i < secs; i++)
	{
		"t=%02d x=%d y=%d z=%d ev=%d installed=%d irqs=%d fifo2=%d status=0x%02X\n",
			i, mouse_hard.pos.x, mouse_hard.pos.y, mouse_hard.pos.z,
			mouse_hard.event, mouse_hard.installed, mouse_hard.irqs_working,
			FifoU8Count(mouse_hard.fifo2), InU8(KBD_CTRL);
		Sleep(1000);
	}
}

public U0 KbdWatch(I64 secs=15)
{//Sample delivery counters. count rising means scancodes reach KbdHandler.
	I64 i;

	for (i = 0; i < secs; i++)
	{
		"t=%02d count=%d fifo2=%d sc_fifo=%d status=0x%02X\n",
			i, kbd.count, FifoU8Count(kbd.fifo2),
			FifoI64Count(kbd.scan_code_fifo), InU8(KBD_CTRL);
		Sleep(1000);
	}
}

KbdCfgRep;
