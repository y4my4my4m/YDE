//Dump the audio descriptors of every enumerated USB device.
//
//  #include "::/Misc/UsbAudioRep"
//
//Reads CUsbDev.raw_config, which the enumerator retains for class drivers, so
//it needs a kernel built after that change.

#define UAR_CS_IF			0x24
#define UAR_CS_EP			0x25

#define UAR_AC_HEADER		0x01
#define UAR_AS_GENERAL		0x01
#define UAR_AS_FORMAT_TYPE	0x02

U0 UsbAudioRepDev(CUsbDev *dev)
{
	U8	*buf = dev->raw_config;
	I64	 len = dev->raw_config_len, off = 0, dlen, dtype, sub, i;

	if (!buf || len < 4)
	{
		"  no retained config descriptor\n";
		return;
	}

	while (off + 2 <= len)
	{
		dlen  = buf[off];
		dtype = buf[off + 1];
		if (!dlen)
			break;

		if (dtype == USB_DESC_IF && off + 9 <= len)
			"  IF %d alt %d  class %02X sub %02X proto %02X  eps %d\n",
				buf[off + 2], buf[off + 3], buf[off + 5], buf[off + 6],
				buf[off + 7], buf[off + 4];
		else if (dtype == UAR_CS_IF && off + 3 <= len)
		{
			sub = buf[off + 2];
			"    CS_IF subtype %02X len %d:", sub, dlen;
			for (i = 3; i < dlen && off + i < len; i++)
				" %02X", buf[off + i];
			'\n';
//UAC1 header carries bcdADC; 0x0100 is class 1, 0x0200 class 2.
			if (sub == UAR_AC_HEADER && dlen >= 5)
				"      bcdADC %02X%02X\n", buf[off + 4], buf[off + 3];
		}
		else if (dtype == UAR_CS_EP && off + 3 <= len)
			"    CS_EP subtype %02X len %d\n", buf[off + 2], dlen;
		else if (dtype == USB_DESC_EP && off + 6 <= len)
			"    EP %02X attr %02X mps %d interval %d\n",
				buf[off + 2], buf[off + 3],
				buf[off + 4] + (buf[off + 5] << 8), buf[off + 6];

		off += dlen;
	}
}

public U0 UsbAudioRep()
{
	CUsbDev	*dev;
	I64		 i, j;
	Bool	 any = FALSE;

	for (i = 0; i < USB_DEVS_MAX; i++)
	{
		dev = &usb_devs[i];
		if (!dev->present)
			goto next_dev;
		for (j = 0; j < dev->if_count; j++)
			if (dev->ifs[j].valid && dev->ifs[j].if_class == USB_CLASS_AUDIO)
			{
				any = TRUE;
				"\n%04X:%04X \"%s\"  %d ifs %d eps\n",
					dev->vendor_id, dev->product_id, dev->desc_name,
					dev->if_count, dev->ep_count;
				UsbAudioRepDev(dev);
				goto next_dev;
			}
next_dev:;
	}
	if (!any)
		"No USB audio device enumerated.\n";
}

UsbAudioRep;
