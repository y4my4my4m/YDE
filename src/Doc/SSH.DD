$LK,"SSHKeyGen.ZC",A="FI:::/Home/Net/Programs/SSH/SSHKeyGen.ZC"$     keygen, storage, the agent
$LK,"SSHEd25519.ZC",A="FI:::/Home/Net/Programs/SSH/SSHEd25519.ZC"$    Ed25519
