//Font descriptors. Glyph tables live in FontStd.ZC and FontAux.ZC; glyph
//packing is known only here.

public CFont sys_font, sys_font_alt, sys_font16;

public I64 FontW()
{//Cell width. All kernel cell math routes through here; the KFONT_WIDTH
//fallback covers the window between task creation and FontInit.
	if (text.cur_font)
		return text.cur_font->width;

	return KFONT_WIDTH;
}

public I64 FontH()
{
	if (text.cur_font)
		return text.cur_font->height;

	return KFONT_HEIGHT;
}

public U8 *FontGlyphRows(CFont *f, I64 ch)
{//First row of a glyph. Rows run down from here, row_bytes apart.
	return f->bitmap + (ch & 0xFF) * f->height * f->row_bytes;
}

public I64 FontRow(CFont *f, I64 ch, I64 row)
{//One row as a bit mask, bit n = column n. Up to 64 columns wide.
	U8	*p = FontGlyphRows(f, ch) + row * f->row_bytes;
	I64	 i, bits = 0;

	for (i = 0; i < f->row_bytes; i++)
		bits |= p[i] << (i * 8);

	return bits;
}

U0 FontDescribe(CFont *f, U8 *name, I64 width, I64 height, U8 *bitmap)
{
	f->name		 = name;
	f->width	 = width;
	f->height	 = height;
	f->row_bytes = (width + 7) / 8;
	f->bitmap	 = bitmap;
}

public U0 FontSet(CFont *f)
{ // switch the system font and re-derive the cell grid. StartOS.ZC injects FONT_WIDTH/FONT_HEIGHT from the font immediately after, freezing the cell size for every file compiled from then on
	if (!f || f->width < 1 || f->height < 1)
		return;
	text.cur_font = f;
	text.cols = sys_framebuffer_width  / f->width;
	text.rows = sys_framebuffer_height / f->height;
}

public U0 FontAltToggle()
{ // <CTRL-ALT-F>. Std <-> aux glyph table, same cell size. No effect on a font without an aux table
	if (text.cur_font == &sys_font)
		text.cur_font = &sys_font_alt;
	else if (text.cur_font == &sys_font_alt)
		text.cur_font = &sys_font;
	SwapI64(&text.font, &text.aux_font);
}

public U0 FontInit()
{ // a U64[256] of 8x8 glyphs is already in bitmap layout: byte n of the U64 is row n, low bit leftmost
	FontDescribe(&sys_font,		"std", KFONT_WIDTH, KFONT_HEIGHT, sys_font_std);
	FontDescribe(&sys_font_alt,	"aux", KFONT_WIDTH, KFONT_HEIGHT, sys_font_aux);
	FontDescribe(&sys_font16,	"std16", 8, 16, sys_font_std16);
}
