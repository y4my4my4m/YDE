//USB HID keyboard, mouse and absolute pointer.
//Keyboard: HID usages -> PS/2 set-1 scancodes -> kbd.fifo2 (reuses kernel KbdHandler).
//Mouse: boot reports -> mouse_hard state (reuses kernel mouse pipeline).
//Tablet: a non-boot HID interface whose report descriptor carries absolute X
//and Y. QEMU's -device usb-tablet is one, and it is what lets the pointer
//track the host cursor without grabbing it.

#define USB_HIDS_MAX		8

#define USB_HID_REPEAT_DELAY	0.400
#define USB_HID_REPEAT_RATE		0.035

#define USB_HID_RQ_GET_DESC		6
#define USB_HID_DT_REPORT		0x22
#define USB_HID_DESC_MAX		256
#define USB_HID_USAGE_QUEUE		8

//Report descriptor item prefixes, HID 1.11 6.2.2.
#define HID_ITEM_INPUT			0x80
#define HID_ITEM_USAGE_PAGE		0x04
#define HID_ITEM_LOGICAL_MIN	0x14
#define HID_ITEM_LOGICAL_MAX	0x24
#define HID_ITEM_REPORT_SIZE	0x74
#define HID_ITEM_REPORT_ID		0x84
#define HID_ITEM_REPORT_COUNT	0x94
#define HID_ITEM_USAGE			0x08
#define HID_ITEM_USAGE_MIN		0x18
#define HID_ITEM_USAGE_MAX		0x28

#define HID_PAGE_DESKTOP		0x01
#define HID_PAGE_BUTTON			0x09
#define HID_USAGE_X				0x30
#define HID_USAGE_Y				0x31
#define HID_USAGE_WHEEL			0x38

//Input item data bit 2: set means the field is a delta.
#define HID_INPUT_RELATIVE		0x04

class CUsbHid
{
	Bool	 valid;
	CUsbDev	*dev;
	CUsbEP	*ep;
	I64		 proto;			//1=kbd, 2=mouse
	U8		 prev[8];
	I64		 repeat_sc;		//held key scancode for software typematic
	F64		 repeat_time;

	//Absolute pointer layout, filled from the report descriptor. Offsets are
	//in bits from the start of the report.
	Bool	 absolute;
	I64		 x_off, x_bits, x_max;
	I64		 y_off, y_bits, y_max;
	I64		 btn_off, btn_count;
	I64		 wheel_off, wheel_bits;
	I64		 rep_bits;
};

CUsbHid usb_hids[USB_HIDS_MAX];

//Absolute cursor position maintained by the USB mouse (pixels).
I64 usb_mouse_x = 0, usb_mouse_y = 0;

//HID usage (page 7) -> set-1 scancode. 0x100 flag = 0xE0-prefixed.
I64 usb_hid_to_sc[0x66] = {
	0,     0,     0,     0,     0x1E,  0x30,  0x2E,  0x20,	//00-07: ---- a b c d
	0x12,  0x21,  0x22,  0x23,  0x17,  0x24,  0x25,  0x26,	//08-0F: e f g h i j k l
	0x32,  0x31,  0x18,  0x19,  0x10,  0x13,  0x1F,  0x14,	//10-17: m n o p q r s t
	0x16,  0x2F,  0x11,  0x2D,  0x15,  0x2C,  0x02,  0x03,	//18-1F: u v w x y z 1 2
	0x04,  0x05,  0x06,  0x07,  0x08,  0x09,  0x0A,  0x0B,	//20-27: 3 4 5 6 7 8 9 0
	0x1C,  0x01,  0x0E,  0x0F,  0x39,  0x0C,  0x0D,  0x1A,	//28-2F: Ent Esc BS Tab Sp - = [
	0x1B,  0x2B,  0x2B,  0x27,  0x28,  0x29,  0x33,  0x34,	//30-37: ] \ # ; ' ` , .
	0x35,  0x3A,  0x3B,  0x3C,  0x3D,  0x3E,  0x3F,  0x40,	//38-3F: / Caps F1-F6
	0x41,  0x42,  0x43,  0x44,  0x57,  0x58,  0x137, 0x46,	//40-47: F7-F12 PrtSc ScrLk
	0,     0x152, 0x147, 0x149, 0x153, 0x14F, 0x151, 0x14D,	//48-4F: Pause Ins Home PgUp Del End PgDn Right
	0x14B, 0x150, 0x148, 0x45,  0x135, 0x37,  0x4A,  0x4E,	//50-57: Left Down Up NumLk KP/ KP* KP- KP+
	0x11C, 0x4F,  0x50,  0x51,  0x4B,  0x4C,  0x4D,  0x47,	//58-5F: KPEnt KP1-KP7
	0x48,  0x49,  0x52,  0x53,  0x56,  0x15D				//60-65: KP8 KP9 KP0 KP. NonUS\ App
};

//Modifier bit -> scancode: LCtrl LShift LAlt LGUI RCtrl RShift RAlt RGUI
I64 usb_hid_mod_sc[8] = {0x1D, 0x2A, 0x38, 0x15B, 0x11D, 0x36, 0x138, 0x15C};

U0 UsbKbdEmit(I64 sc, I64 up)
{
	if (!sc)
		return;
	if (sc & 0x100)
		FifoU8Insert(kbd.fifo2, 0xE0);
	if (up)
		FifoU8Insert(kbd.fifo2, (sc & 0x7F) | 0x80);
	else
		FifoU8Insert(kbd.fifo2, sc & 0x7F);
}

CUsbHid *UsbHidByEP(CUsbEP *ep)
{
	I64 i;

	for (i = 0; i < USB_HIDS_MAX; i++)
		if (usb_hids[i].valid && usb_hids[i].ep == ep)
			return &usb_hids[i];

	return NULL;
}

Bool UsbKbdReportHas(U8 *report, I64 usage)
{
	I64 i;

	for (i = 2; i < 8; i++)
		if (report[i] == usage)
			return TRUE;

	return FALSE;
}

U0 UsbKbdCB(U8 *d, U8 *e)
{//8-byte boot keyboard report.
	CUsbDev	*dev = d;
	CUsbEP	*ep	 = e;
	CUsbHid	*hid = UsbHidByEP(ep);
	U8		*rep;
	I64		 i, mods, prev_mods, sc;

	if (!hid || !dev->present)
		return;
	rep = ep->auto_buf;
	if (rep[2] == 1)
		return;	//error rollover
	mods	  = rep[0];
	prev_mods = hid->prev[0];
	for (i = 0; i < 8; i++)
	{
		if ((mods & (1 << i)) && !(prev_mods & (1 << i)))
			UsbKbdEmit(usb_hid_mod_sc[i], FALSE);
		if (!(mods & (1 << i)) && (prev_mods & (1 << i)))
			UsbKbdEmit(usb_hid_mod_sc[i], TRUE);
	}
	for (i = 2; i < 8; i++)
	{
		if (hid->prev[i] && !UsbKbdReportHas(rep, hid->prev[i]))
		{
			if (hid->prev[i] < 0x66)
			{
				sc = usb_hid_to_sc[hid->prev[i]];
				UsbKbdEmit(sc, TRUE);
				if (hid->repeat_sc == sc)
					hid->repeat_sc = 0;
			}
		}
	}
	for (i = 2; i < 8; i++)
	{
		if (rep[i] && !UsbKbdReportHas(hid->prev, rep[i]))
		{
			if (rep[i] < 0x66)
			{
				sc = usb_hid_to_sc[rep[i]];
				UsbKbdEmit(sc, FALSE);
				hid->repeat_sc	 = sc;
				hid->repeat_time = tS + USB_HID_REPEAT_DELAY;
			}
		}
	}
	MemCopy(hid->prev, rep, 8);
}

I64 UsbHidField(U8 *rep, I64 off, I64 bits)
{//Little endian bit field out of a report.
	I64 v = 0, i;

	for (i = 0; i < bits; i++)
		if (rep[(off + i) >> 3] & (1 << ((off + i) & 7)))
			v |= 1 << i;

	return v;
}

Bool UsbHidParseReport(CUsbHid *hid, U8 *desc, I64 len)
{//Walk the report descriptor far enough to place absolute X and Y, the
//buttons and the wheel. Not a general HID parser: it tracks one report with
//no report IDs, which is what a tablet or a plain mouse presents.
	I64	 pos = 0, tag, size, val, i;
	I64	 page = 0, lmax = 0, rsize = 0, rcount = 0, bit = 0;
	I64	 usage[USB_HID_USAGE_QUEUE], n_usage = 0;
	Bool got_x = FALSE, got_y = FALSE;

	while (pos < len)
	{
		tag  = desc[pos] & 0xFC;
		size = desc[pos] & 3;
		if (size == 3)
			size = 4;
		pos++;
		if (pos + size > len)
			break;
		val = 0;
		for (i = 0; i < size; i++)
			val |= desc[pos + i] << (8 * i);
		pos += size;

		if (tag == HID_ITEM_REPORT_ID)
			return FALSE;		//numbered reports shift every offset by a byte
		else if (tag == HID_ITEM_USAGE_PAGE)
			page = val;
		else if (tag == HID_ITEM_LOGICAL_MAX)
			lmax = val;
		else if (tag == HID_ITEM_REPORT_SIZE)
			rsize = val;
		else if (tag == HID_ITEM_REPORT_COUNT)
			rcount = val;
		else if (tag == HID_ITEM_USAGE)
		{
			if (n_usage < USB_HID_USAGE_QUEUE)
			{
				usage[n_usage] = (page << 16) | val;
				n_usage++;
			}
		}
		else if (tag == HID_ITEM_USAGE_MIN || tag == HID_ITEM_USAGE_MAX)
		{//A button range; the page alone identifies it.
			if (page == HID_PAGE_BUTTON && n_usage < USB_HID_USAGE_QUEUE)
			{
				usage[n_usage] = page << 16;
				n_usage++;
			}
		}
		else if (tag == HID_ITEM_INPUT)
		{
			for (i = 0; i < rcount; i++)
			{
				if (i < n_usage)
				{
					if (usage[i] == ((HID_PAGE_DESKTOP << 16) | HID_USAGE_X) &&
						!(val & HID_INPUT_RELATIVE))
					{
						hid->x_off  = bit + i * rsize;
						hid->x_bits = rsize;
						hid->x_max  = lmax;
						got_x       = TRUE;
					}
					else if (usage[i] == ((HID_PAGE_DESKTOP << 16) | HID_USAGE_Y) &&
							 !(val & HID_INPUT_RELATIVE))
					{
						hid->y_off  = bit + i * rsize;
						hid->y_bits = rsize;
						hid->y_max  = lmax;
						got_y       = TRUE;
					}
					else if (usage[i] == ((HID_PAGE_DESKTOP << 16) | HID_USAGE_WHEEL))
					{
						hid->wheel_off  = bit + i * rsize;
						hid->wheel_bits = rsize;
					}
					else if (usage[i] >> 16 == HID_PAGE_BUTTON && !hid->btn_count)
					{
						hid->btn_off   = bit;
						hid->btn_count = rcount;
						if (hid->btn_count > 3)
							hid->btn_count = 3;
					}
				}
			}
			bit    += rsize * rcount;
			n_usage = 0;
		}
		else if (tag == 0xA0 || tag == 0xC0)
			n_usage = 0;		//collection boundaries clear pending usages
	}
	hid->rep_bits = bit;
	hid->absolute = got_x && got_y && hid->x_max > 1 && hid->y_max > 1;

	return hid->absolute;
}

U0 UsbTabletCB(U8 *d, U8 *e)
{//Absolute pointer: the report carries a position, not a delta, so the guest
//cursor lands wherever the host cursor is and no grab is needed.
	CUsbDev	*dev = d;
	CUsbEP	*ep	 = e;
	CUsbHid	*hid = NULL;
	U8		*rep;
	I64		 i, x, y, dz = 0;

	if (!dev->present)
		return;
	for (i = 0; i < USB_HIDS_MAX; i++)
		if (usb_hids[i].valid && usb_hids[i].ep == ep)
		{
			hid = &usb_hids[i];
			break;
		}
	if (!hid || !hid->absolute)
		return;
	rep = ep->auto_buf;

	x = UsbHidField(rep, hid->x_off, hid->x_bits);
	y = UsbHidField(rep, hid->y_off, hid->y_bits);
	if (hid->x_max > 0)
		x = x * (sys_framebuffer_width  - 1) / hid->x_max;
	if (hid->y_max > 0)
		y = y * (sys_framebuffer_height - 1) / hid->y_max;
	if (hid->wheel_bits)
	{
		dz = UsbHidField(rep, hid->wheel_off, hid->wheel_bits);
		if (dz & (1 << (hid->wheel_bits - 1)))
			dz -= 1 << hid->wheel_bits;
	}

	usb_mouse_x = ClampI64(x, 0, sys_framebuffer_width  - 1);
	usb_mouse_y = ClampI64(y, 0, sys_framebuffer_height - 1);

	mouse_hard.timestamp = TSCGet;
	MemCopy(&mouse_hard_last, &mouse_hard, sizeof(CMouseHardStateGlobals));
	mouse_hard.pos.x   = usb_mouse_x;
	mouse_hard.pos.y   = usb_mouse_y;
	mouse_hard.pos.z  += dz;
	for (i = 0; i < hid->btn_count; i++)
		mouse_hard.bttns[i] = (UsbHidField(rep, hid->btn_off + i, 1)) & 1;
	mouse_hard.event = TRUE;
	mouse.show       = TRUE;
}

U0 UsbMouseCB(U8 *d, U8 *e)
{//Boot mouse report: buttons dx dy [wheel].
	CUsbDev	*dev = d;
	CUsbEP	*ep	 = e;
	U8		*rep;
	I64		 dx, dy, dz = 0;
	Bool	 is_raw;

	if (!dev->present)
		return;
	rep = ep->auto_buf;

	dx = rep[1];
	if (dx & 0x80)
		dx -= 256;
	dy = rep[2];
	if (dy & 0x80)
		dy -= 256;
	if (ep->auto_len >= 4)
	{
		dz = rep[3];
		if (dz & 0x80)
			dz -= 256;
	}

//Raw mode reads mouse_hard.raw_data, which an absolute cursor write never reaches.
//Boot reports carry three buttons; 3 and 4 stay untouched.
	if (mouse_hard.raw_queue->next == mouse_hard.raw_queue)
		is_raw = FALSE;
	else
		is_raw = ToBool(MouseRawQueueFind(sys_focus_task) != NULL);

	if (is_raw)
	{
		mouse_hard.raw_bttns[0] |=  rep[0] & 1;
		mouse_hard.raw_bttns[1] |= (rep[0] & 2) >> 1;
		mouse_hard.raw_bttns[2] |= (rep[0] & 4) >> 2;

		mouse_hard.bttns[0]	=  rep[0] & 1;
		mouse_hard.bttns[1]	= (rep[0] & 2) >> 1;
		mouse_hard.bttns[2]	= (rep[0] & 4) >> 2;

		mouse_hard.raw_data.x += dx;
		mouse_hard.raw_data.y += dy;
		mouse_hard.raw_data.z += dz;

		mouse_hard.timestamp = TSCGet;
		mouse_hard.event     = TRUE;

		mouse.show	= FALSE;
		mouse.lb	= FALSE;
		mouse.rb	= FALSE;
		return;
	}

//Absolute position: WinMgr's per-frame PS/2 polling clobbers the prescale/MouseHardSetPost path.
	usb_mouse_x = ClampI64(usb_mouse_x + dx, 0, sys_framebuffer_width  - 1);
	usb_mouse_y = ClampI64(usb_mouse_y + dy, 0, sys_framebuffer_height - 1);

	mouse_hard.timestamp	 = TSCGet;
	MemCopy(&mouse_hard_last, &mouse_hard, sizeof(CMouseHardStateGlobals));
	mouse_hard.pos.x		 = usb_mouse_x;
	mouse_hard.pos.y		 = usb_mouse_y;
	mouse_hard.pos.z		+= dz;
	mouse_hard.bttns[0]		 =  rep[0] & 1;
	mouse_hard.bttns[1]		 = (rep[0] & 2) >> 1;
	mouse_hard.bttns[2]		 = (rep[0] & 4) >> 2;
	mouse_hard.event		 = TRUE;
	mouse.show				 = TRUE;
}

U0 UsbHidTick()
{//Software typematic repeat; called from USB task main loop.
	CUsbHid	*hid;
	I64		 i;

	for (i = 0; i < USB_HIDS_MAX; i++)
	{
		hid = &usb_hids[i];
		if (hid->valid && hid->proto == USB_HID_PROTO_KBD && hid->repeat_sc)
		{
			if (tS >= hid->repeat_time)
			{
				UsbKbdEmit(hid->repeat_sc, FALSE);
				hid->repeat_time = tS + USB_HID_REPEAT_RATE;
			}
		}
	}
}

U0 UsbHidAttach(CUsbDev *dev, CUsbIf *uif)
{
	CUsbHid	*hid = NULL;
	CUsbEP	*ep	 = NULL, *tmp;
	U8		*desc;
	I64		 i, n;
	Bool	 boot;

	for (i = 0; i < uif->ep_count; i++)
	{
		tmp = &dev->ep_list[uif->ep_idxs[i]];
		if ((tmp->addr & 0x80) && (tmp->attr & 3) == USB_EP_TYPE_INT)
		{
			ep = tmp;
			break;
		}
	}
	if (!ep)
		return;
	for (i = 0; i < USB_HIDS_MAX; i++)
		if (!usb_hids[i].valid)
		{
			hid = &usb_hids[i];
			break;
		}
	if (!hid)
		return;
	MemSet(hid, 0, sizeof(CUsbHid));
	hid->dev   = dev;
	hid->ep	   = ep;
	hid->proto = uif->if_proto;
	hid->valid = TRUE;

	boot = ToBool(uif->if_subclass == USB_HID_SUBCLASS_BOOT &&
				  (uif->if_proto == USB_HID_PROTO_KBD ||
				   uif->if_proto == USB_HID_PROTO_MOUSE));
	if (!boot)
	{//Non-boot interface: keep it only if the report descriptor describes an
	//absolute pointer. Anything else is left alone.
		//UsbCtrl returns an xHCI completion code, not a length. The buffer is
		//zeroed instead: a report descriptor shorter than the request leaves
		//trailing zero bytes, which parse as empty items and end the walk.
		desc = CAlloc(USB_HID_DESC_MAX, sys_task->code_heap);
		if (desc)
		{
			n = UsbCtrl(dev, USB_RT_DEV_TO_HOST | USB_RT_STD | USB_RT_RECIP_IF,
						USB_HID_RQ_GET_DESC, (USB_HID_DT_REPORT << 8),
						uif->if_num, desc, USB_HID_DESC_MAX);
			if (n == XHCI_CC_SUCCESS || n == XHCI_CC_SHORT_PKT)
				UsbHidParseReport(hid, desc, USB_HID_DESC_MAX);
			else
				SysLog("USB: port %d: report descriptor request failed, code %d.\n",
					   dev->port, n);
			Free(desc);
		}
		if (!hid->absolute)
		{
			hid->valid = FALSE;
			SysLog("USB: port %d: HID iface %d not an absolute pointer "
				   "(x %d/%d y %d/%d).\n", dev->port, uif->if_num,
				   hid->x_bits, hid->x_max, hid->y_bits, hid->y_max);
			return;
		}
	}
	else
//Boot protocol; idle=0 -> reports only on change.
		UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_IF,
				USB_HID_RQ_SET_PROTOCOL, 0, uif->if_num, NULL, 0);
	UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_IF,
			USB_HID_RQ_SET_IDLE, 0, uif->if_num, NULL, 0);

	if (!ep->auto_buf)
		ep->auto_buf = CAlloc(16, sys_task->code_heap);
	ep->auto_len = ep->max_packet;
	if (ep->auto_len > 16)
		ep->auto_len = 16;
	if (ep->auto_len < 3)
		ep->auto_len = 3;
	if (hid->absolute)
	{
		n = (hid->rep_bits + 7) >> 3;
		if (n > 0 && n < ep->auto_len)
			ep->auto_len = n;
		ep->auto_kind = USB_AUTO_TABLET;
		mouse_hard.installed	= TRUE;
		mouse_hard.irqs_working	= TRUE;
		SysLog("USB: HID tablet on port %d, %d bits/report.\n", dev->port,
			   hid->rep_bits);
	}
	else if (uif->if_proto == USB_HID_PROTO_KBD)
	{
		ep->auto_len = 8;
		ep->auto_kind = USB_AUTO_KBD;
		SysLog("USB: HID keyboard on port %d.\n", dev->port);
	}
	else
	{
		ep->auto_kind = USB_AUTO_MOUSE;
//installed makes WinMouseUpdate consume these events; irqs_working stops WinMgr polling PS/2.
		mouse_hard.installed	= TRUE;
		mouse_hard.irqs_working	= TRUE;
		usb_mouse_x = sys_framebuffer_width  >> 1;
		usb_mouse_y = sys_framebuffer_height >> 1;
		SysLog("USB: HID mouse on port %d.\n", dev->port);
	}
	XhciIntQueue(dev, ep);
}

U0 UsbHidDetach(CUsbDev *dev)
{
	I64 i;

	for (i = 0; i < USB_HIDS_MAX; i++)
		if (usb_hids[i].valid && usb_hids[i].dev == dev)
			usb_hids[i].valid = FALSE;
}
