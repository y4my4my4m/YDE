//USB Audio Class 1.0 output. Streams the system mixer to an isochronous OUT
//endpoint: any USB-C dongle, headset or DAC, on any machine with USB.
//
//UAC1 only. Class 2 uses an explicit feedback endpoint and a different control
//layout; class 1 covers the bus-powered dongles this is meant for.
//
//Descriptor layout walked here (Audio Device Class 1.0, sections 4.5):
//  IF class 1 subclass 2 alt 0   zero bandwidth, no endpoint
//  IF class 1 subclass 2 alt N   the streaming setting
//    CS_INTERFACE AS_GENERAL     (subtype 1) terminal link, delay, format tag
//    CS_INTERFACE FORMAT_TYPE    (subtype 2) channels, subframe size, rates
//    ENDPOINT isoc OUT           the audio sink
//    CS_ENDPOINT EP_GENERAL      (subtype 1) sample-rate control support

#define UAC_SUBCLASS_CONTROL	0x01
#define UAC_SUBCLASS_STREAMING	0x02

#define UAC_CS_IF_AS_GENERAL	0x01
#define UAC_CS_IF_FORMAT_TYPE	0x02

#define UAC_FORMAT_TYPE_I		0x01
#define UAC_PCM_FORMAT_TAG		0x0001

#define UAC_RQ_SET_CUR			0x01
#define UAC_RQ_GET_CUR			0x81
#define UAC_CS_SAMPLING_FREQ	0x0100	//UAC1 selector 1, channel 0
#define UAC2_CS_SAM_FREQ		0x0100	//UAC2 clock source sampling frequency

//Audio Control entity subtypes used to reach the clock a stream runs on.
#define UAC_AC_INPUT_TERMINAL	0x02
#define UAC_AC_FEATURE_UNIT		0x06
#define UAC2_AC_CLOCK_SOURCE	0x0A

//Feature Unit control selectors. Devices commonly power up muted.
#define UAC_FU_MUTE				0x0100
#define UAC_FU_VOLUME			0x0200
#define UAC_FUS_MAX				4

#define UAC_VER_1				0x0100
#define UAC_VER_2				0x0200

//The mixer emits 48kHz stereo U32 L16|R16. Bytes per service interval depend on
//device speed and are computed in UsbAudioParse.
#define UAC_RATE				48000
//Isoc has no cyclic DMA: every service interval needs a TD queued by software,
//so the depth here is the whole runway when the USB task is off-CPU. 64 TDs is
//64ms at a 1ms interval. The ring holds XHCI_RING_TRBS entries.
#define UAC_TDS_IN_FLIGHT		64

//Mixer ring. Filled from the USB task loop, drained by the completion callback.
//4096 frames is 85ms at UAC_RATE. Power of two; the index is masked.
#define UAC_RING_FRAMES			4096
#define UAC_RING_MASK			(UAC_RING_FRAMES - 1)
#define UAC_FEED_CHUNK			240		//5ms per mixer call

class CUsbAudio
{
	CUsbDev	*dev;
	CUsbEP	*ep;
	I64		 if_num;		//streaming interface
	I64		 alt;			//alternate setting carrying the endpoint
	I64		 channels;
	I64		 bits;
	I64		 ver;			//bcdADC: UAC_VER_1 or UAC_VER_2
	I64		 ac_if;			//audio control interface, target of UAC2 requests
	I64		 clock_id;		//UAC2 clock entity feeding the stream
	I64		 frame_bytes;	//payload per service interval
	I64		 rate;			//rate the device reports, not the one requested
	I64		 hold;			//rate / mixer rate; zero-order hold factor
	I64		 fu[UAC_FUS_MAX];
	I64		 fu_n;
	Bool	 valid;
	Bool	 running;
	U8		*buf[UAC_TDS_IN_FLIGHT];
	I64		 buf_i;			//buffer the next TD uses
	U32		*ring;			//mixer-rate frames, filled by UsbAudioFeed
	I64		 rd, wr;		//monotonic frame counters; index is masked
} usb_audio;

//Installed by the System audio layer. Kernel AOT code cannot call a symbol
//that is JIT compiled later, so the mixer reaches the driver through this.
public U0 (*fp_usb_audio_fill)(U32 *buf, I64 bytes) = NULL;

//TDs the controller has completed. Zero after playback starts means the ring
//stalled: nothing is being consumed.
public I64 usb_audio_frames = 0;

//Intervals sent as silence with the ring dry.
public I64 usb_audio_starved = 0;

public Bool UsbAudioPresent()
{
	return ToBool(usb_audio.valid && usb_audio.running);
}

I64 UsbAudioRateSet(CUsbDev *dev, CUsbAudio *a, I64 rate)
{//UAC1 addresses the endpoint with a 3-byte rate. UAC2 addresses a clock entity
//on the control interface with 4 bytes.
	U8 v[4];

	v[0] = rate			& 0xFF;
	v[1] = (rate >> 8)	& 0xFF;
	v[2] = (rate >> 16)	& 0xFF;
	v[3] = (rate >> 24)	& 0xFF;

	if (a->ver >= UAC_VER_2)
		return UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_IF,
					   UAC_RQ_SET_CUR, UAC2_CS_SAM_FREQ,
					   (a->clock_id << 8) | a->ac_if, v, 4, FALSE);

	return UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_EP,
				   UAC_RQ_SET_CUR, UAC_CS_SAMPLING_FREQ, a->ep->addr, v, 3, FALSE);
}

I64 UsbAudioRateGet(CUsbDev *dev, CUsbAudio *a)
{//Rate the device runs. SET_CUR is advisory; a fixed-clock device keeps its own.
//Returns 0 if unreadable.
	U8	v[4];
	I64	code;

	MemSet(v, 0, sizeof(v));
	if (a->ver >= UAC_VER_2)
		code = UsbCtrl(dev, USB_RT_DEV_TO_HOST | USB_RT_CLASS | USB_RT_RECIP_IF,
					   UAC_RQ_GET_CUR, UAC2_CS_SAM_FREQ,
					   (a->clock_id << 8) | a->ac_if, v, 4, FALSE);
	else
		code = UsbCtrl(dev, USB_RT_DEV_TO_HOST | USB_RT_CLASS | USB_RT_RECIP_EP,
					   UAC_RQ_GET_CUR, UAC_CS_SAMPLING_FREQ, a->ep->addr, v, 3, FALSE);
	if (code != XHCI_CC_SUCCESS && code != XHCI_CC_SHORT_PKT)
		return 0;

	return v[0] | (v[1] << 8) | (v[2] << 16) | (v[3] << 24);
}

U0 UsbAudioRateApply(CUsbDev *dev, CUsbAudio *a)
{//Size the per-interval payload from the device's own rate.
	a->rate = UsbAudioRateGet(dev, a);
	if (a->rate < 8000 || a->rate > 192000)
		a->rate = UAC_RATE;

//Mixer produces UAC_RATE only. An exact multiple is fed by repeating frames;
//any other rate plays at the wrong pitch.
	a->hold = a->rate / UAC_RATE;
	if (a->hold < 1 || a->hold * UAC_RATE != a->rate)
		a->hold = 1;

	if (dev->speed == USB_SPEED_HIGH || dev->speed == USB_SPEED_SUPER)
		a->frame_bytes = a->rate * 4 / 8000;
	else
		a->frame_bytes = a->rate * 4 / 1000;

//A TD longer than wMaxPacketSize babbles and halts the endpoint.
	if (a->ep->max_packet && a->frame_bytes > a->ep->max_packet)
		a->frame_bytes = a->ep->max_packet;
}

U0 UsbAudioUnmute(CUsbDev *dev, CUsbAudio *a)
{//Clear mute and set 0dB on every feature unit. A unit without the control
//stalls the request, which is harmless.
	U8	v[2];
	I64	i;

	for (i = 0; i < a->fu_n; i++)
	{
		v[0] = 0;
		UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_IF,
				UAC_RQ_SET_CUR, UAC_FU_MUTE,
				(a->fu[i] << 8) | a->ac_if, v, 1, FALSE);

		v[0] = 0;			//0dB, 1/256 dB units, signed
		v[1] = 0;
		UsbCtrl(dev, USB_RT_HOST_TO_DEV | USB_RT_CLASS | USB_RT_RECIP_IF,
				UAC_RQ_SET_CUR, UAC_FU_VOLUME,
				(a->fu[i] << 8) | a->ac_if, v, 2, FALSE);
	}
}

Bool UsbAudioParse(CUsbDev *dev, CUsbAudio *a)
{//Find a streaming alt with a 16-bit stereo PCM isoc OUT endpoint, and the
//clock that feeds it.
//
//Format Type I differs by version:
//  UAC1  off4 bNrChannels, off5 bSubframeSize, off6 bBitResolution
//  UAC2  off4 bSubslotSize, off5 bBitResolution; channels live in AS_GENERAL
	U8	*buf = dev->raw_config;
	I64	 len = dev->raw_config_len, off = 0, dlen, dtype, sub;
	I64	 cur_if = -1, cur_alt = -1, chans = 0, bits = 0, link = 0;
	I64	 first_clock = 0;
	Bool in_stream = FALSE, in_ctrl = FALSE, have_fmt = FALSE;

	if (!buf || len < 4)
		return FALSE;

	a->ver	   = UAC_VER_1;
	a->ac_if   = 0;
	a->clock_id = 0;

	while (off + 2 <= len)
	{
		dlen  = buf[off];
		dtype = buf[off + 1];
		if (!dlen)
			break;

		if (dtype == USB_DESC_IF && off + 9 <= len)
		{
			cur_if	  = buf[off + 2];
			cur_alt	  = buf[off + 3];
			in_ctrl	  = ToBool(buf[off + 5] == USB_CLASS_AUDIO &&
						   buf[off + 6] == UAC_SUBCLASS_CONTROL);
			in_stream = ToBool(buf[off + 5] == USB_CLASS_AUDIO &&
						   buf[off + 6] == UAC_SUBCLASS_STREAMING && cur_alt);
			if (in_ctrl)
				a->ac_if = cur_if;
			have_fmt = FALSE;
			chans	 = 0;
			bits	 = 0;
		}
		else if (dtype == USB_DESC_CS_IF && off + 3 <= len)
		{
			sub = buf[off + 2];
			if (in_ctrl)
			{
				if (sub == UAC_CS_IF_AS_GENERAL && off + 5 <= len)
					a->ver = buf[off + 3] | (buf[off + 4] << 8);
				else if (sub == UAC2_AC_CLOCK_SOURCE && off + 4 <= len &&
						 !first_clock)
					first_clock = buf[off + 3];
				else if (sub == UAC_AC_FEATURE_UNIT && off + 4 <= len &&
						 a->fu_n < UAC_FUS_MAX)
					a->fu[a->fu_n++] = buf[off + 3];
//The stream names a terminal; that terminal names its clock.
				else if (sub == UAC_AC_INPUT_TERMINAL && off + 8 <= len &&
						 link && buf[off + 3] == link)
					a->clock_id = buf[off + 7];
			}
			else if (in_stream)
			{
				if (sub == UAC_CS_IF_AS_GENERAL && off + 4 <= len)
				{
					link = buf[off + 3];
					if (a->ver >= UAC_VER_2 && off + 11 <= len)
						chans = buf[off + 10];
				}
				else if (sub == UAC_CS_IF_FORMAT_TYPE && off + 6 <= len &&
						 buf[off + 3] == UAC_FORMAT_TYPE_I)
				{
					if (a->ver >= UAC_VER_2)
						bits = buf[off + 5];
					else
					{
						chans = buf[off + 4];
						if (off + 7 <= len)
							bits = buf[off + 6];
					}
					have_fmt = ToBool(chans == 2 && bits == 16);
				}
			}
		}
		else if (dtype == USB_DESC_EP && in_stream && have_fmt && off + 6 <= len)
		{
			if (!(buf[off + 2] & 0x80) && (buf[off + 3] & 3) == USB_EP_TYPE_ISOCH)
			{
				a->if_num	= cur_if;
				a->alt		= cur_alt;
				a->channels	= chans;
				a->bits		= bits;
				a->ep		= UsbDevEPByAddrMps(dev, buf[off + 2],
									(buf[off + 4] | (buf[off + 5] << 8)) & 0x7FF);
				if (!a->clock_id)
					a->clock_id = first_clock;

//High speed schedules every 125us microframe, full speed every 1ms frame.
				if (dev->speed == USB_SPEED_HIGH || dev->speed == USB_SPEED_SUPER)
					a->frame_bytes = UAC_RATE * 4 / 8000;
				else
					a->frame_bytes = UAC_RATE * 4 / 1000;

//A TD longer than wMaxPacketSize babbles and halts the endpoint.
				if (a->ep && a->ep->max_packet &&
					a->frame_bytes > a->ep->max_packet)
					a->frame_bytes = a->ep->max_packet;

				return ToBool(a->ep != NULL);
			}
		}
		off += dlen;
	}

	return FALSE;
}

//Service intervals of built-in tone still to emit. Non-zero bypasses the mixer.
//Set from a terminal: usb_audio_selftest = 2000;
public I64	usb_audio_selftest	= 0;
I64			usb_audio_phase		= 0;

U0 UsbAudioToneFill(CUsbEP *ep)
{//440Hz square, both channels, interleaved S16LE as U32 R<<16|L.
	U32	*p = ep->auto_buf;
	I64	 i, n = ep->auto_len / 4, v, half = UAC_RATE / 880, period = UAC_RATE / 440;

	for (i = 0; i < n; i++)
	{
		if (usb_audio_phase < half)
			v = 8000;
		else
			v = -8000;
		usb_audio_phase++;
		if (usb_audio_phase >= period)
			usb_audio_phase = 0;
		p[i] = (v & 0xFFFF) | ((v & 0xFFFF) << 16);
	}
}


U0 UsbAudioTxCB(CUsbDev *dev, CUsbEP *ep)
{//XhciEventPoll requeues ep->auto_buf on return. Advance first: earlier TDs may
//still be read by the controller.
	CUsbAudio	*a = &usb_audio;
	U32			*p;
	I64			 i, hold, n_out, n_src, ri;

	no_warn dev;
	usb_audio_frames++;

	if (a->valid)
	{
		a->buf_i = (a->buf_i + 1) % UAC_TDS_IN_FLIGHT;
		ep->auto_buf = a->buf[a->buf_i];
	}

	if (usb_audio_selftest > 0)
	{
		usb_audio_selftest--;
		UsbAudioToneFill(ep);
		return;
	}

	if (!fp_usb_audio_fill)
	{
		MemSet(ep->auto_buf, 0, ep->auto_len);
		return;
	}

	hold = a->hold;
	if (hold < 1)
		hold = 1;
	n_out = ep->auto_len / 4;
	n_src = n_out / hold;
	p = ep->auto_buf;

	if (!a->ring || a->wr - a->rd < n_src)
	{//Ring dry. Emit silence; rd does not advance.
		usb_audio_starved++;
		MemSet(p, 0, ep->auto_len);
		return;
	}

	ri = a->rd & UAC_RING_MASK;
	for (i = 0; i < n_src; i++)
		p[i] = a->ring[(ri + i) & UAC_RING_MASK];
	a->rd += n_src;

//High index first: p[i / hold] is below i and still unwritten.
	if (hold > 1)
		for (i = n_out - 1; i >= 0; i--)
			p[i] = p[i / hold];
}

public U0 UsbAudioFeed()
{//Top the ring up. USB task loop only.
	CUsbAudio	*a = &usb_audio;
	I64			 space, run, wi;

	if (!a->valid || !a->ring || !fp_usb_audio_fill)
		return;

	while (TRUE)
	{
		space = UAC_RING_FRAMES - (a->wr - a->rd);
		if (space < UAC_FEED_CHUNK)
			return;
		wi  = a->wr & UAC_RING_MASK;
		run = UAC_RING_FRAMES - wi;		//mixer writes flat; stop at the wrap
		if (run > UAC_FEED_CHUNK)
			run = UAC_FEED_CHUNK;
		(*fp_usb_audio_fill)(&a->ring[wi], run * 4);
		a->wr += run;
	}
}

public U0 UsbAudioStat()
{//Endpoint geometry and ring health in one line each.
	CUsbAudio	*a = &usb_audio;
	U32			*octx;

	if (!a->valid || !a->ep)
	{
		"USB audio: not attached.\n";
		return;
	}
	"USB audio: speed %d  ep 0x%02X  mps %d  bInterval %d\n",
		a->dev->speed, a->ep->addr, a->ep->max_packet, a->ep->interval;
	"  dev rate %d  mixer %d  hold %d\n", a->rate, UAC_RATE, a->hold;
	"  frame_bytes %d  evts %d  filled %d  last cc %d\n",
		a->frame_bytes, a->ep->xfer_evts, usb_audio_frames, a->ep->xfer_code;
	"  fill hook 0x%08X  selftest %d  starved %d  ring %d\n",
		fp_usb_audio_fill, usb_audio_selftest, usb_audio_starved, a->wr - a->rd;
//EP state 1=Running 2=Halted 3=Stopped 4=Error.
	octx = XhciDevCtxGet(a->dev, a->ep->dci);
	"  dci %d  ep state %d  ctx deq 0x%08X  ring 0x%08X  enq %d cyc %d\n",
		a->ep->dci, octx[0] & 7, octx[2] & 0xFFFFFFF0,
		a->ep->ring->trbs, a->ep->ring->enq, a->ep->ring->cycle;
}

public U0 UsbAudioAttach(CUsbDev *dev, CUsbIf *uif)
{//Bound to the audio control interface; the streaming interface is found here.
	CUsbAudio	*a = &usb_audio;
	I64			 i, code;

	no_warn uif;
	if (a->valid)
		return;						//one output device at a time

	MemSet(a, 0, sizeof(CUsbAudio));
	a->dev = dev;
	if (!UsbAudioParse(dev, a))
	{
		SysLog("USB: audio device has no 16-bit stereo PCM streaming setting.\n");
		return;
	}

	code = UsbSetInterface(dev, a->if_num, a->alt);
	if (code != XHCI_CC_SUCCESS)
	{
		SysLog("USB: audio SET_INTERFACE %d/%d failed (%d).\n",
			   a->if_num, a->alt, code);
		return;
	}

//Bind the endpoint context to this alt's endpoint.
	code = XhciConfigureEP(dev, a->ep);
	if (code != XHCI_CC_SUCCESS)
	{
		SysLog("USB: audio configure EP dci %d failed (%d).\n", a->ep->dci, code);
		return;
	}

//Not every device implements the sample-rate control; a fixed-48k dongle
//answers with a stall and still plays.
	UsbAudioRateSet(dev, a, UAC_RATE);
	UsbAudioRateApply(dev, a);
	UsbAudioUnmute(dev, a);

	for (i = 0; i < UAC_TDS_IN_FLIGHT; i++)
		a->buf[i] = CAllocAligned(a->frame_bytes, 64, sys_task->code_heap);
	a->ring = CAllocAligned(UAC_RING_FRAMES * 4, 64, sys_task->code_heap);
	a->rd	= 0;
	a->wr	= 0;

	a->ep->auto_buf	 = a->buf[0];
	a->ep->auto_len	 = a->frame_bytes;
	a->ep->auto_kind = USB_AUTO_AUDIO;
	dev->drv_data	 = a;
	a->valid		 = TRUE;
	a->running		 = TRUE;

//Prime with silence. Each completion refills and requeues, holding the
//in-flight count steady.
	for (i = 0; i < UAC_TDS_IN_FLIGHT; i++)
	{
		MemSet(a->buf[i], 0, a->frame_bytes);
		XhciIsocQueue(dev, a->ep, a->buf[i], a->frame_bytes);
	}
	a->buf_i = UAC_TDS_IN_FLIGHT - 1;
	UsbAudioFeed;

	"USB: audio out UAC%d, %d ch %d-bit %dHz, if %d alt %d ep 0x%02X, "
	"%d B/interval, clock %d, %d feature unit(s).\n",
		a->ver >> 8, a->channels, a->bits, a->rate, a->if_num, a->alt,
		a->ep->addr, a->frame_bytes, a->clock_id, a->fu_n;
}

public U0 UsbAudioDetach(CUsbDev *dev)
{
	CUsbAudio	*a = &usb_audio;
	I64			 i;

	if (!a->valid || a->dev != dev)
		return;

	a->running = FALSE;
	a->valid   = FALSE;
	if (a->ep)
		a->ep->auto_kind = USB_AUTO_NONE;
	for (i = 0; i < UAC_TDS_IN_FLIGHT; i++)
	{
		Free(a->buf[i]);
		a->buf[i] = NULL;
	}
	Free(a->ring);
	a->ring = NULL;
	a->dev		  = NULL;
	a->ep		  = NULL;
	dev->drv_data = NULL;
}
