// UTProp.ZC - UE1 tagged property stream: skip + typed bind + KeyPos[].
//
// Info byte: type 0..3, size class 4..6, array flag 7. Bool: value in bit7.
// StructProperty: struct name CI then data. FixedArray elems: name + array index.
// AMover KeyPos[8]/KeyRot[8]: EngineClasses.h.

#define UT_RF_HAS_STACK		0x02000000

#define UT_PROP_BYTE		1
#define UT_PROP_INT			2
#define UT_PROP_BOOL		3
#define UT_PROP_FLOAT		4
#define UT_PROP_OBJECT		5
#define UT_PROP_NAME		6
#define UT_PROP_STRING		7
#define UT_PROP_CLASS		8
#define UT_PROP_ARRAY		9
#define UT_PROP_STRUCT		10
#define UT_PROP_VECTOR		11
#define UT_PROP_ROTATOR		12
#define UT_PROP_STR			13
#define UT_PROP_MAP			14
#define UT_PROP_FIXEDARRAY	15

#define UT_PROP_VEC_MAX		24

class CUTPropVecSlot
{
	U8	 name[48];
	I64	 index;
	F64	 v[3];
	Bool set;
};

class CUTPropBag
{//property-bound defaults for FFrame / actor fields
	CUTPropVecSlot vecs[UT_PROP_VEC_MAX];
	I64	 n_vec;
	F64	 location[3];
	I64	 rotation[3];
	Bool has_location;
	Bool has_rotation;
	I64	 move_time_cents;
	I64	 num_keys;
	I64	 key_num;
	F64	 floats[16];
	I64	 ints[16];
	I64	 n_float;
	I64	 n_int;
	F64	 health;
	F64	 draw_scale;
	F64	 collision_radius;
	F64	 collision_height;
	Bool b_colliding;
	Bool b_block_actors;
	Bool b_water;
	F64	 hit_damage;
	F64	 projectile_speed;
	F64	 ammo_amount;
	I64	 max_ammo;
	I64	 team;
	I64	 light_brightness;
	I64	 light_radius;
	I64	 light_hue;		//0..255 SoftDrv corona tint
	I64	 light_sat;		//LightSaturation; 255 = white
	I64	 amb_bright;	//ZoneInfo AmbientBrightness
	I64	 amb_hue;
	I64	 amb_sat;
	I64	 num_touches;		//Counter.NumTouches
	U8	 state_name[48];
	U8	 event_name[48];
	U8	 tag_name[48];
	U8	 url_str[80];
	I64	 defense_time;		//Assault FortStandard minutes
	I64	 defense_priority;	//Assault FortStandard.DefensePriority
	F64	 respawn_time;		//Inventory.RespawnTime seconds
	F64	 damage_per_sec;	//ZoneInfo.DamagePerSec
	F64	 fog_end;		//ZoneInfo.DistanceFogEnd
	F64	 level_bright;	//LevelInfo.Brightness, 1.0 when absent
	//Rendering. AActor in EngineClasses.h; object properties hold refs that
	//UTLinkObjName turns into names.
	I64	 mesh_ref;		//AActor.Mesh
	I64	 skin_ref;		//AActor.Skin
	I64	 multi_skin_ref[8];	//AActor.MultiSkins
	I64	 sprite_ref;		//AActor.Sprite
	I64	 fire_snd_ref;	//Weapon.FireSound
	I64	 altfire_snd_ref;	//Weapon.AltFireSound
	I64	 select_snd_ref;	//Weapon.SelectSound
	I64	 pickup_snd_ref;	//Inventory.PickupSound
	I64	 texture_ref;	//AActor.Texture
	I64	 draw_type;		//DT_None 0, DT_Sprite 1, DT_Mesh 2, DT_Brush 3
	Bool b_hidden;
	U8	 anim_seq[48];	//AActor.AnimSequence
	//Sound object names, resolved at parse time. The ref index is only
	//meaningful against the package that held it.
	//Weapon first-person view: PlayerViewMesh at PlayerViewOffset, scaled by
	//PlayerViewScale. Hardcoding one mesh drew a PulseGun for every weapon.
	U8	 view_mesh[48];
	F64	 view_offset[3];
	F64	 view_scale;
	U8	 fire_snd[48];
	U8	 altfire_snd[48];
	U8	 select_snd[48];
	U8	 pickup_snd[48];
};

U0 UTPropObjNameCopy(CUTPackage *pkg, I64 obj_ref, U8 *out, I64 cap)
{//object ref → object name. Negative indexes imports, positive exports.
	I64 ii;
	U8 *nm;

	if (!out || cap < 1)
		return;
	out[0] = 0;
	if (!pkg || obj_ref == 0)
		return;
	nm = NULL;
	if (obj_ref < 0)
	{
		ii = -obj_ref - 1;
		if (ii >= 0 && ii < pkg->import_count)
			nm = UTPkgNameStr(pkg, pkg->imports[ii].object_name);
	}
	else
	{
		ii = obj_ref - 1;
		if (ii >= 0 && ii < pkg->export_count)
			nm = UTPkgNameStr(pkg, pkg->exports[ii].name_index);
	}
	if (!nm || !nm[0])
		return;
	StrPrint(out, "%s", nm);
	out[cap - 1] = 0;
}

I64 UTPropArrIndex(CUTArc *ar)
{//FPropertyTag array index. Not FCompactIndex: 1 byte for 0..0x7F, 2 bytes
 //when the top bits are 0b10, 4 bytes when 0b11. Reading it as a compact
 //index eats a second byte at index 0x40 and desyncs the rest of the tag
 //stream (GameInfo.IPPolicies[50], MapList.Maps[]).
	I64 b;
	I64 c;
	I64 d;
	I64 e;

	b = UTArcU8(ar);
	if (!(b & 0x80))
		return b;
	if ((b & 0xC0) == 0x80)
		return ((b & 0x7F) << 8) + UTArcU8(ar);
	c = UTArcU8(ar);
	d = UTArcU8(ar);
	e = UTArcU8(ar);
	return ((b & 0x3F) << 24) + (c << 16) + (d << 8) + e;
}

I64 UTPropSizeFromSpec(CUTArc *ar, I64 szspec)
{
	I64 size;

	if (szspec == 0) size = 1;
	else if (szspec == 1) size = 2;
	else if (szspec == 2) size = 4;
	else if (szspec == 3) size = 12;
	else if (szspec == 4) size = 16;
	else if (szspec == 5) size = UTArcU8(ar);
	else if (szspec == 6) size = UTArcU16(ar);
	else size = UTArcI32(ar);
	return size;
}

Bool UTPropSkipStack(CUTArc *ar, U32 object_flags)
{
	I64 node;

	if (!(object_flags & UT_RF_HAS_STACK))
		return TRUE;
	//FStateFrame: Node, StateNode, ProbeMask(QWORD), LatentAction, and Offset
	//only when Node is set. StateNode was missing here and Offset was always
	//consumed, so any actor carrying a state parsed one field out of step.
	node = UTArcIndex(ar);
	UTArcIndex(ar);
	UTArcU32(ar);
	UTArcU32(ar);
	UTArcI32(ar);
	if (node != 0)
		UTArcIndex(ar);
	return !ar->err;
}

Bool UTPropSkipOne(CUTArc *ar, CUTPackage *pkg, U8 *out_name)
{
	I64 ni;
	I64 info;
	I64 typ;
	I64 szspec;
	I64 size;
	I64 arrbit;
	U8 *nm;

	if (out_name)
		out_name[0] = 0;
	ni = UTArcIndex(ar);
	if (ar->err || !pkg || !pkg->names || ni < 0 || ni >= pkg->name_count)
		return FALSE;
	nm = pkg->names[ni].name;
	if (out_name)
		StrCopy(out_name, nm);
	if (!StrCompare(nm, "None"))
		return TRUE;
	info = UTArcU8(ar);
	typ = info & 0x0F;
	szspec = (info >> 4) & 0x07;
	arrbit = info & 0x80;
	if (typ == UT_PROP_BOOL)
	{//value lives in the arr bit. szspec >= 5 still emits a size field
	 //(observed 0) plus that many payload bytes; skipping it desynced the
	 //walk and a stray 0x00 read as name 'None', ending props early.
		if (szspec >= 5)
		{
			size = UTPropSizeFromSpec(ar, szspec);
			if (size > 0 && ar->pos + size <= ar->size)
				ar->pos += size;
		}
		return !ar->err;
	}
	//Header order on disk: info, struct name, size, array index.
	if (typ == UT_PROP_STRUCT)
		UTArcIndex(ar);
	size = UTPropSizeFromSpec(ar, szspec);
	if (arrbit)
		UTPropArrIndex(ar);
	if (size < 0 || ar->pos + size > ar->size)
	{
		ar->err = TRUE;
		return FALSE;
	}
	ar->pos += size;
	return !ar->err;
}

Bool UTPropSkipAll(CUTArc *ar, CUTPackage *pkg)
{
	U8 name[UT_NAME_SIZE];

	while (!ar->err && ar->pos < ar->size)
	{
		if (!UTPropSkipOne(ar, pkg, name))
			return FALSE;
		if (!StrCompare(name, "None"))
			return TRUE;
	}
	return FALSE;
}

U0 UTPropBagInit(CUTPropBag *b)
{
	MemSet(b, 0, sizeof(CUTPropBag));
	b->num_keys = 2;
	b->move_time_cents = 100;
	b->health = 100.0;
	b->draw_scale = 1.0;
	b->collision_radius = 40.0;
	b->collision_height = 40.0;
	b->b_water = FALSE;
	b->hit_damage = 0.0;
	b->projectile_speed = 0.0;
	b->ammo_amount = 0.0;
	b->max_ammo = 0;
	b->team = -1;
	b->light_brightness = -1;
	b->light_radius = -1;
	b->light_hue = -1;
	b->light_sat = -1;
	b->amb_bright = -1;
	b->amb_hue = -1;
	b->amb_sat = -1;
	b->num_touches = 0;
	b->defense_time = 0;
	b->defense_priority = 0;
	b->respawn_time = 0.0;
	b->damage_per_sec = 0.0;
	b->fog_end = 0.0;
	b->level_bright = 1.0;
	b->mesh_ref = 0;
	b->skin_ref = 0;
	b->sprite_ref = 0;
	b->view_scale = 1.0;
	b->fire_snd_ref = 0;
	b->altfire_snd_ref = 0;
	b->select_snd_ref = 0;
	b->pickup_snd_ref = 0;
	b->texture_ref = 0;
	b->draw_type = -1;
	b->b_hidden = FALSE;
	b->anim_seq[0] = 0;
	MemSet(b->multi_skin_ref, 0, sizeof(I64) * 8);
}

U0 UTPropBagSeedLocals(CUTPropBag *b, CUTVMVal *locals, I64 n)
{//FFrame local/instance scratch from tagged defaults.
	I64 i;

	if (!b || !locals || n < 8)
		return;
	i = 0;
	while (i < n)
	{
		UTVMValNone(&locals[i]);
		i++;
	}
	if (b->has_location)
		UTVMValVec(&locals[0], b->location[0], b->location[1],
			b->location[2]);
	UTVMValFloat(&locals[3], ToF64(b->move_time_cents) / 100.0);
	UTVMValFloat(&locals[4], b->health);
	UTVMValFloat(&locals[5], b->draw_scale);
	UTVMValFloat(&locals[6], b->collision_radius);
	UTVMValFloat(&locals[7], b->collision_height);
	i = 0;
	while (i < b->n_float && (8 + i) < n)
	{
		UTVMValFloat(&locals[8 + i], b->floats[i]);
		i++;
	}
}

I64 UTPropBagAddVec(CUTPropBag *b, U8 *name, I64 index, F64 *v)
{
	CUTPropVecSlot *s;
	I64 i;

	i = 0;
	while (i < b->n_vec)
	{
		if (!StrCompare(b->vecs[i].name, name) && b->vecs[i].index == index)
		{
			UTVecCopy(v, b->vecs[i].v);
			b->vecs[i].set = TRUE;
			return i;
		}
		i++;
	}
	if (b->n_vec >= UT_PROP_VEC_MAX)
		return -1;
	s = &b->vecs[b->n_vec];
	StrPrint(s->name, "%s", name);
	s->index = index;
	UTVecCopy(v, s->v);
	s->set = TRUE;
	b->n_vec++;
	return b->n_vec - 1;
}

Bool UTPropBagGetVec(CUTPropBag *b, U8 *name, I64 index, F64 *out)
{
	I64 i;

	i = 0;
	while (i < b->n_vec)
	{
		if (b->vecs[i].set && !StrCompare(b->vecs[i].name, name) &&
			b->vecs[i].index == index)
		{
			UTVecCopy(b->vecs[i].v, out);
			return TRUE;
		}
		i++;
	}
	return FALSE;
}

Bool UTPropLoadBag(CUTPackage *pkg, I64 so, I64 ss, U32 object_flags,
	CUTPropBag *bag)
{//bind tagged props through None into bag.
	CUTArc ar;
	CUTArc tmp;
	I64 ni;
	I64 info;
	I64 typ;
	I64 szspec;
	I64 size;
	I64 arrbit;
	I64 arr_i;
	I64 guard;
	U8 *nm;
	U8 *p;
	F64 vec[3];
	I64 ival;
	F64 fval;

	UTPropBagInit(bag);
	if (!pkg || !pkg->data || so < 0 || ss < 4)
		return FALSE;
	UTArcInit(&ar, pkg->data, pkg->data_size);
	ar.ver = pkg->file_version;
	ar.lic_ver = pkg->licensee_ver;
	if (!UTArcSeek(&ar, so))
		return FALSE;
	UTPropSkipStack(&ar, object_flags);
	guard = 0;
	while (!ar.err && ar.pos < so + ss && guard < 8192)
	{
		ni = UTArcIndex(&ar);
		if (ar.err || ni < 0 || ni >= pkg->name_count)
			break;
		nm = pkg->names[ni].name;
		if (!StrCompare(nm, "None"))
			return TRUE;
		info = UTArcU8(&ar);
		typ = info & 0x0F;
		szspec = (info >> 4) & 0x07;
		arrbit = info & 0x80;
		arr_i = 0;
		if (typ == UT_PROP_BOOL)
		{
			if (szspec >= 5)
			{
				size = UTPropSizeFromSpec(&ar, szspec);
				if (size > 0 && ar.pos + size <= ar.size)
					ar.pos += size;
			}
			if (!StrCompare(nm, "bHidden"))
				bag->b_hidden = (arrbit != 0);
			if (!StrCompare(nm, "bCollideActors") ||
				!StrCompare(nm, "bCollideWorld"))
				bag->b_colliding = (arrbit != 0);
			else if (!StrCompare(nm, "bBlockActors") ||
				!StrCompare(nm, "bBlockPlayers"))
				bag->b_block_actors = (arrbit != 0);
			else if (!StrCompare(nm, "bWaterZone"))
				bag->b_water = (arrbit != 0);
			guard++;
		}
		else
		{
			//Order on disk is info, struct name, size, array index. Reading
			//size first consumed the struct-name byte as a length, so any
			//struct with an explicit size aborted the loop and every later
			//property in that actor silently fell back to its default.
			if (typ == UT_PROP_STRUCT)
				UTArcIndex(&ar);
			size = UTPropSizeFromSpec(&ar, szspec);
			if (arrbit)
				arr_i = UTPropArrIndex(&ar);
			if (size < 0 || ar.pos + size > ar.size)
				break;
			p = ar.data + ar.pos;
			if ((typ == UT_PROP_VECTOR || typ == UT_PROP_STRUCT) && size >= 12)
			{
				vec[0] = UTRdF32(p);
				vec[1] = UTRdF32(p + 4);
				vec[2] = UTRdF32(p + 8);
				if (!StrCompare(nm, "Location") || !StrCompare(nm, "BasePos"))
				{
					UTVecCopy(vec, bag->location);
					bag->has_location = TRUE;
				}
				if (!StrCompare(nm, "PlayerViewOffset"))
					UTVecCopy(vec, bag->view_offset);
				UTPropBagAddVec(bag, nm, arr_i, vec);
			}
			else if ((typ == UT_PROP_ROTATOR || typ == UT_PROP_STRUCT) &&
				size >= 12)
			{
				if (!StrCompare(nm, "Rotation") || !StrCompare(nm, "BaseRot"))
				{
					bag->rotation[0] = UTRdI32(p);
					bag->rotation[1] = UTRdI32(p + 4);
					bag->rotation[2] = UTRdI32(p + 8);
					bag->has_rotation = TRUE;
				}
				if (!StrCompare(nm, "KeyRot"))
				{
					vec[0] = ToF64(UTRdI32(p));
					vec[1] = ToF64(UTRdI32(p + 4));
					vec[2] = ToF64(UTRdI32(p + 8));
					UTPropBagAddVec(bag, nm, arr_i, vec);
				}
			}
			else if (typ == UT_PROP_FLOAT && size >= 4)
			{
				fval = UTRdF32(p);
				if (!StrCompare(nm, "MoveTime"))
					bag->move_time_cents = ToI64(fval * 100.0);
				else if (!StrCompare(nm, "StayOpenTime"))
					bag->floats[1] = fval;
				else if (!StrCompare(nm, "Health") ||
					!StrCompare(nm, "DefaultHealth"))
					bag->health = fval;
				else if (!StrCompare(nm, "DrawScale"))
					bag->draw_scale = fval;
				else if (!StrCompare(nm, "PlayerViewScale"))
					bag->view_scale = fval;
				else if (!StrCompare(nm, "CollisionRadius"))
					bag->collision_radius = fval;
				else if (!StrCompare(nm, "CollisionHeight"))
					bag->collision_height = fval;
				else if (!StrCompare(nm, "HitDamage") ||
					!StrCompare(nm, "Damage"))
					bag->hit_damage = fval;
				else if (!StrCompare(nm, "ProjectileSpeed") ||
					!StrCompare(nm, "Speed"))
					bag->projectile_speed = fval;
				else if (!StrCompare(nm, "AmmoAmount") ||
					!StrCompare(nm, "PickupAmmoCount"))
					bag->ammo_amount = fval;
				else if (!StrCompare(nm, "RespawnTime"))
					bag->respawn_time = fval;
				else if (!StrCompare(nm, "DamagePerSec"))
					bag->damage_per_sec = fval;
				else if (!StrCompare(nm, "DistanceFogEnd") ||
					!StrCompare(nm, "FogDistance"))
					bag->fog_end = fval;
				//LevelInfo.Brightness scales every light: UnLight
				//ComputeFromActor does FloatColor *= Brightness *
				//Actor->Level->Brightness. CTF-Face ships 1.5.
				else if (!StrCompare(nm, "Brightness"))
					bag->level_bright = fval;
				if (bag->n_float < 16)
				{
					bag->floats[bag->n_float] = fval;
					bag->n_float++;
				}
			}
			else if (typ == UT_PROP_BYTE && size >= 1)
			{
				ival = p[0];
				if (!StrCompare(nm, "DrawType"))
					bag->draw_type = ival;
				else if (!StrCompare(nm, "NumKeys"))
					bag->num_keys = ival;
				else if (!StrCompare(nm, "KeyNum"))
					bag->key_num = ival;
				else if (!StrCompare(nm, "Team"))
					bag->team = ival;
				else if (!StrCompare(nm, "LightBrightness"))
					bag->light_brightness = ival;
				else if (!StrCompare(nm, "LightRadius"))
					bag->light_radius = ival;
				else if (!StrCompare(nm, "LightHue"))
					bag->light_hue = ival;
				else if (!StrCompare(nm, "LightSaturation"))
					bag->light_sat = ival;
				else if (!StrCompare(nm, "AmbientBrightness"))
					bag->amb_bright = ival;
				else if (!StrCompare(nm, "AmbientHue"))
					bag->amb_hue = ival;
				else if (!StrCompare(nm, "AmbientSaturation"))
					bag->amb_sat = ival;
				else if (!StrCompare(nm, "NumTouches"))
					bag->num_touches = ival;
				if (bag->n_int < 16)
				{
					bag->ints[bag->n_int] = ival;
					bag->n_int++;
				}
			}
			else if (typ == UT_PROP_INT && size >= 4)
			{
				ival = UTRdI32(p);
				if (!StrCompare(nm, "MaxAmmo") ||
					!StrCompare(nm, "AmmoAmount"))
					bag->max_ammo = ival;
				else if (!StrCompare(nm, "Team"))
					bag->team = ival;
				else if (!StrCompare(nm, "DefenseTime"))
					bag->defense_time = ival;
				else if (!StrCompare(nm, "DefensePriority"))
					bag->defense_priority = ival;
				else if (!StrCompare(nm, "LightBrightness"))
					bag->light_brightness = ival;
				else if (!StrCompare(nm, "LightRadius"))
					bag->light_radius = ival;
				else if (!StrCompare(nm, "LightHue"))
					bag->light_hue = ival;
				else if (!StrCompare(nm, "LightSaturation"))
					bag->light_sat = ival;
				else if (!StrCompare(nm, "NumTouches"))
					bag->num_touches = ival;
				if (bag->n_int < 16)
				{
					bag->ints[bag->n_int] = ival;
					bag->n_int++;
				}
			}
			else if (typ == UT_PROP_OBJECT || typ == UT_PROP_CLASS)
			{
				UTArcInit(&tmp, ar.data, ar.size);
				tmp.ver = ar.ver;
				tmp.lic_ver = ar.lic_ver;
				tmp.pos = ar.pos;
				ival = UTArcIndex(&tmp);
				if (!tmp.err)
				{
					if (!StrCompare(nm, "Mesh"))
						bag->mesh_ref = ival;
					else if (!StrCompare(nm, "Skin"))
						bag->skin_ref = ival;
					else if (!StrCompare(nm, "Sprite"))
						bag->sprite_ref = ival;
					else if (!StrCompare(nm, "Texture"))
						bag->texture_ref = ival;
					//Weapons name their own sounds; ShockRifle carries
					//FireSound=Sound'UnrealShare.ASMD.TazerFire'. One global
					//click for every event is a stand-in, not the port.
					else if (!StrCompare(nm, "PlayerViewMesh"))
						UTPropObjNameCopy(pkg, ival, bag->view_mesh, 48);
					else if (!StrCompare(nm, "FireSound"))
					{
						bag->fire_snd_ref = ival;
						UTPropObjNameCopy(pkg, ival, bag->fire_snd, 48);
					}
					else if (!StrCompare(nm, "AltFireSound"))
					{
						bag->altfire_snd_ref = ival;
						UTPropObjNameCopy(pkg, ival, bag->altfire_snd, 48);
					}
					else if (!StrCompare(nm, "SelectSound"))
					{
						bag->select_snd_ref = ival;
						UTPropObjNameCopy(pkg, ival, bag->select_snd, 48);
					}
					else if (!StrCompare(nm, "PickupSound"))
					{
						bag->pickup_snd_ref = ival;
						UTPropObjNameCopy(pkg, ival, bag->pickup_snd, 48);
					}
					else if (!StrCompare(nm, "MultiSkins") &&
						arr_i >= 0 && arr_i < 8)
						bag->multi_skin_ref[arr_i] = ival;
				}
			}
			else if (typ == UT_PROP_NAME)
			{
				UTArcInit(&tmp, ar.data, ar.size);
				tmp.ver = ar.ver;
				tmp.lic_ver = ar.lic_ver;
				tmp.pos = ar.pos;
				ival = UTArcIndex(&tmp);
				if (!tmp.err && ival >= 0 && ival < pkg->name_count)
				{
					if (!StrCompare(nm, "AnimSequence"))
						StrPrint(bag->anim_seq, "%s", pkg->names[ival].name);
					else if (!StrCompare(nm, "InitialState"))
						StrPrint(bag->state_name, "%s",
							pkg->names[ival].name);
					else if (!StrCompare(nm, "Tag"))
						StrPrint(bag->tag_name, "%s",
							pkg->names[ival].name);
					else if (!StrCompare(nm, "Event"))
						StrPrint(bag->event_name, "%s",
							pkg->names[ival].name);
					else if (!StrCompare(nm, "ThisTag"))
						StrPrint(bag->tag_name, "%s",
							pkg->names[ival].name);
				}
			}
			else if ((typ == UT_PROP_STRING || typ == UT_PROP_STR) &&
				size > 0)
			{
				if (!StrCompare(nm, "URL") ||
					!StrCompare(nm, "OtherSideURL") ||
					!StrCompare(nm, "Message"))
				{
					ival = size;
					if (ival > 79)
						ival = 79;
					if (p[0] < 32 && ival > 1)
					{
						MemCopy(bag->url_str, p + 1, ival - 1);
						bag->url_str[ival - 1] = 0;
					}
					else
					{
						MemCopy(bag->url_str, p, ival);
						bag->url_str[ival] = 0;
					}
				}
			}
			else if (typ == UT_PROP_FIXEDARRAY && size >= 12)
			{
				ival = 0;
				while (ival * 12 + 12 <= size && ival < 8)
				{
					vec[0] = UTRdF32(p + ival * 12);
					vec[1] = UTRdF32(p + ival * 12 + 4);
					vec[2] = UTRdF32(p + ival * 12 + 8);
					UTPropBagAddVec(bag, nm, ival, vec);
					ival++;
				}
			}
			ar.pos += size;
			guard++;
		}
	}
	return bag->has_location || bag->n_vec > 0;
}

Bool UTPropFindStructVec(CUTPackage *pkg, I64 so, I64 ss, U8 *want,
	F64 *out)
{//so/ss = export serial. Callers pass object_flags via LoadBag path below —
 //byte-scan recovers Location when RF_HasStack confuses sequential parse.
	CUTPropBag bag;
	CUTArc ar;
	I64 ni;
	I64 want_i;
	I64 info;
	I64 typ;
	I64 szspec;
	I64 size;
	I64 saved;
	U8 *p;
	F64 x;
	F64 y;
	F64 z;

	//flags=0: HasStack actors fail sequential parse; byte-scan still works.
	if (UTPropLoadBag(pkg, so, ss, 0, &bag))
	{
		if (!StrCompare(want, "Location") && bag.has_location)
		{
			x = bag.location[0];
			y = bag.location[1];
			z = bag.location[2];
			//Reject NaN / absurd coords (stack bytes misread as Vector)
			if (x > -1.0e6 && x < 1.0e6 && y > -1.0e6 && y < 1.0e6 &&
				z > -1.0e6 && z < 1.0e6)
			{
				UTVecCopy(bag.location, out);
				return TRUE;
			}
		}
		if (UTPropBagGetVec(&bag, want, 0, out))
		{
			x = out[0];
			y = out[1];
			z = out[2];
			if (x > -1.0e6 && x < 1.0e6 && y > -1.0e6 && y < 1.0e6 &&
				z > -1.0e6 && z < 1.0e6)
				return TRUE;
		}
	}
	if (!pkg || !pkg->data || so < 0 || ss < 16)
		return FALSE;
	want_i = UTPkgFindName(pkg, want);
	if (want_i < 0)
		return FALSE;
	UTArcInit(&ar, pkg->data, pkg->data_size);
	ar.ver = pkg->file_version;
	saved = so;
	while (saved < so + ss - 8)
	{
		ar.pos = saved;
		ar.err = FALSE;
		ni = UTArcIndex(&ar);
		if (!ar.err && ni == want_i)
		{
			info = UTArcU8(&ar);
			typ = info & 0x0F;
			szspec = (info >> 4) & 0x07;
			if (typ == UT_PROP_STRUCT || typ == UT_PROP_VECTOR)
			{
				//Header order: info, struct name, size, array index.
				if (typ == UT_PROP_STRUCT)
					UTArcIndex(&ar);
				size = UTPropSizeFromSpec(&ar, szspec);
				if (info & 0x80)
					UTArcIndex(&ar);
				if (!ar.err && size >= 12 && ar.pos + 12 <= ar.size)
				{
					p = ar.data + ar.pos;
					out[0] = UTRdF32(p);
					out[1] = UTRdF32(p + 4);
					out[2] = UTRdF32(p + 8);
					x = out[0];
					y = out[1];
					z = out[2];
					if (x > -1.0e6 && x < 1.0e6 && y > -1.0e6 &&
						y < 1.0e6 && z > -1.0e6 && z < 1.0e6)
						return TRUE;
				}
			}
		}
		saved++;
	}
	return FALSE;
}

Bool UTPropFindObjectRef(CUTPackage *pkg, I64 so, I64 ss, U32 object_flags,
	U8 *want, I64 *out_ref)
{//ObjectProperty → compact object ref. DetailTexture / MacroTexture.
	CUTArc ar;
	I64 ni;
	I64 info;
	I64 typ;
	I64 szspec;
	I64 size;
	I64 arrbit;
	I64 guard;
	I64 saved;
	I64 want_i;
	U8 *nm;
	I64 obj;

	if (out_ref)
		*out_ref = 0;
	if (!pkg || !pkg->data || !want || !out_ref || so < 0 || ss < 4)
		return FALSE;
	UTArcInit(&ar, pkg->data, pkg->data_size);
	ar.ver = pkg->file_version;
	ar.lic_ver = pkg->licensee_ver;
	if (!UTArcSeek(&ar, so))
		return FALSE;
	UTPropSkipStack(&ar, object_flags);
	guard = 0;
	while (!ar.err && ar.pos < so + ss && guard < 8192)
	{
		ni = UTArcIndex(&ar);
		if (ar.err || ni < 0 || ni >= pkg->name_count)
			break;
		nm = pkg->names[ni].name;
		if (!StrCompare(nm, "None"))
			break;
		info = UTArcU8(&ar);
		typ = info & 0x0F;
		szspec = (info >> 4) & 0x07;
		arrbit = info & 0x80;
		if (typ == UT_PROP_BOOL)
		{
			guard++;
		}
		else
		{
			//Header order: info, struct name, size, array index.
			if (typ == UT_PROP_STRUCT)
				UTArcIndex(&ar);
			size = UTPropSizeFromSpec(&ar, szspec);
			if (arrbit)
				UTPropArrIndex(&ar);
			if (size < 0 || ar.pos + size > ar.size)
				break;
			if (typ == UT_PROP_OBJECT && !StrCompare(nm, want))
			{
				saved = ar.pos;
				obj = UTArcIndex(&ar);
				if (!ar.err)
				{
					*out_ref = obj;
					return obj != 0;
				}
				ar.pos = saved;
				ar.err = FALSE;
			}
			ar.pos += size;
			guard++;
		}
	}
	//byte-scan recover when HasStack / incomplete sequential parse
	want_i = UTPkgFindName(pkg, want);
	if (want_i < 0)
		return FALSE;
	saved = so;
	while (saved < so + ss - 4)
	{
		ar.pos = saved;
		ar.err = FALSE;
		ni = UTArcIndex(&ar);
		if (!ar.err && ni == want_i)
		{
			info = UTArcU8(&ar);
			typ = info & 0x0F;
			szspec = (info >> 4) & 0x07;
			if (typ == UT_PROP_OBJECT)
			{
				UTPropSizeFromSpec(&ar, szspec);
				if (info & 0x80)
					UTArcIndex(&ar);
				obj = UTArcIndex(&ar);
				if (!ar.err && obj != 0)
				{
					*out_ref = obj;
					return TRUE;
				}
			}
		}
		saved++;
	}
	return FALSE;
}

Bool UTPropFindStructRot(CUTPackage *pkg, I64 so, I64 ss, U8 *want,
	I64 *pitch, I64 *yaw, I64 *roll)
{
	CUTPropBag bag;
	CUTArc ar;
	I64 ni;
	I64 want_i;
	I64 info;
	I64 typ;
	I64 szspec;
	I64 size;
	I64 saved;
	U8 *p;

	if (UTPropLoadBag(pkg, so, ss, 0, &bag) && bag.has_rotation)
	{
		*pitch = bag.rotation[0];
		*yaw = bag.rotation[1];
		*roll = bag.rotation[2];
		return TRUE;
	}
	if (!pkg || !pkg->data || so < 0 || ss < 16)
		return FALSE;
	want_i = UTPkgFindName(pkg, want);
	if (want_i < 0)
		return FALSE;
	UTArcInit(&ar, pkg->data, pkg->data_size);
	ar.ver = pkg->file_version;
	saved = so;
	while (saved < so + ss - 8)
	{
		ar.pos = saved;
		ar.err = FALSE;
		ni = UTArcIndex(&ar);
		if (!ar.err && ni == want_i)
		{
			info = UTArcU8(&ar);
			typ = info & 0x0F;
			szspec = (info >> 4) & 0x07;
			if (typ == UT_PROP_STRUCT || typ == UT_PROP_ROTATOR)
			{
				//Header order: info, struct name, size, array index.
				if (typ == UT_PROP_STRUCT)
					UTArcIndex(&ar);
				size = UTPropSizeFromSpec(&ar, szspec);
				if (info & 0x80)
					UTArcIndex(&ar);
				if (!ar.err && size >= 12 && ar.pos + 12 <= ar.size)
				{
					p = ar.data + ar.pos;
					*pitch = UTRdI32(p);
					*yaw = UTRdI32(p + 4);
					*roll = UTRdI32(p + 8);
					return TRUE;
				}
			}
		}
		saved++;
	}
	return FALSE;
}

Bool UTPropFindKeyPos(CUTPackage *pkg, I64 so, I64 ss, U32 flags,
	F64 *keypos0, I64 stride, I64 *n_keys, F64 *move_time)
{//keypos0 points at F64[8][3] as flat F64*. stride = 3.
	CUTPropBag bag;
	I64 i;
	I64 n;
	F64 v[3];
	F64 *dst;

	*n_keys = 0;
	*move_time = 1.0;
	if (!UTPropLoadBag(pkg, so, ss, flags, &bag))
		return FALSE;
	n = 0;
	i = 0;
	while (i < 8)
	{
		if (UTPropBagGetVec(&bag, "KeyPos", i, v))
		{
			dst = keypos0 + i * stride;
			dst[0] = v[0];
			dst[1] = v[1];
			dst[2] = v[2];
			n = i + 1;
		}
		i++;
	}
	if (bag.num_keys > 1 && bag.num_keys <= 8)
		n = bag.num_keys;
	*n_keys = n;
	if (bag.move_time_cents > 0)
		*move_time = ToF64(bag.move_time_cents) / 100.0;
	return n > 0;
}

//UTVM.ZC compiles after this file; the class walk needs the expr skip.
extern I64 UTVMSerializeScriptSkip(CUTArc *ar, CUTPackage *pkg,
	I64 script_size);

Bool UTPropLoadClassDefaults(U8 *pkg_path, U8 *cls_name, CUTPropBag *bag)
{//UClass default properties. A Class export carries ClassIndex 0, so it never
 //matches a class-name lookup. Defaults trail the whole UStruct/UState/UClass
 //header, not the start of the serial:
 //  UField  SuperField Next
 //  UStruct ScriptText Children FriendlyName Line TextPos ScriptSize Script
 //  UState  ProbeMask IgnoreMask LabelTableOffset StateFlags
 //  UClass  ClassFlags ClassGuid Dependencies PackageImports ClassWithin
 //          ClassConfigName
 //then the tagged defaults. Verified against Botpack BulletBox, whose
 //defaults give Mesh BulletBoxM and Skin BulletBoxT.
	CUTPackage *pkg;
	CUTArc ar;
	CUTExport *e;
	I64 i;
	I64 ci;
	I64 n;
	I64 j;
	I64 script_size;
	Bool ok;

	if (!bag || !cls_name)
		return FALSE;
	pkg = UTPkgLoad(pkg_path);
	if (!pkg)
		return FALSE;
	ci = -1;
	i = 0;
	while (i < pkg->export_count && ci < 0)
	{
		//Botpack authors class names in mixed case: 'ripper', 'enforcer',
		//'ut_biorifle' sit beside 'ShockRifle'. UE1 name lookup is
		//case-insensitive.
		if (pkg->exports[i].class_index == 0 &&
			!StrICompare(UTPkgNameStr(pkg, pkg->exports[i].name_index),
				cls_name))
			ci = i;
		i++;
	}
	if (ci < 0)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	e = &pkg->exports[ci];
	if (!UTPkgArcExport(pkg, ci, &ar))
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	UTPropSkipStack(&ar, e->object_flags);
	UTArcIndex(&ar);	//SuperField
	UTArcIndex(&ar);	//Next
	UTArcIndex(&ar);	//ScriptText
	UTArcIndex(&ar);	//Children
	UTArcIndex(&ar);	//FriendlyName
	UTArcI32(&ar);		//Line
	UTArcI32(&ar);		//TextPos
	script_size = UTArcI32(&ar);
	if (ar.err || script_size < 0)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	//Serialized bytecode is not ScriptSize raw bytes; walk the exprs.
	if (script_size > 0)
		UTVMSerializeScriptSkip(&ar, pkg, script_size);
	ar.pos += 8;		//ProbeMask
	ar.pos += 8;		//IgnoreMask
	ar.pos += 2;		//LabelTableOffset
	ar.pos += 4;		//StateFlags
	UTArcU32(&ar);		//ClassFlags
	ar.pos += 16;		//ClassGuid
	n = UTArcIndex(&ar);	//Dependencies
	if (ar.err || n < 0 || n > 4096)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	j = 0;
	while (j < n)
	{
		UTArcIndex(&ar);	//Class
		UTArcI32(&ar);		//Deep
		UTArcI32(&ar);		//ScriptTextCRC
		j++;
	}
	n = UTArcIndex(&ar);	//PackageImports
	if (ar.err || n < 0 || n > 4096)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	j = 0;
	while (j < n)
	{
		UTArcIndex(&ar);
		j++;
	}
	UTArcIndex(&ar);	//ClassWithin
	UTArcIndex(&ar);	//ClassConfigName
	ok = FALSE;
	//UTPkgArcExport seeks absolute, so ar.pos is a file offset. Object
	//flags are 0 so the state frame is not skipped a second time.
	if (!ar.err && ar.pos < ar.size)
		ok = UTPropLoadBag(pkg, ar.pos,
			e->serial_offset + e->serial_size - ar.pos, 0, bag);
	UTPkgFree(pkg);
	return ok;
}

//---- Prop linker (UnProp.cpp / UStruct::LinkOffsets) ----
//InstanceVariable bytecode stores linked Offset. Host maps Offset→bag field.

extern I64 ut_obj_inv_head;

#define UT_PLINK_MAX		384
#define UT_BAG_NONE			0
#define UT_BAG_LOC_X		1
#define UT_BAG_LOC_Y		2
#define UT_BAG_LOC_Z		3
#define UT_BAG_HEALTH		4
#define UT_BAG_DRAWSCALE	5
#define UT_BAG_AMMO			6
#define UT_BAG_MAXAMMO		7
#define UT_BAG_TEAM			8
#define UT_BAG_COLL_R		9
#define UT_BAG_COLL_H		10
#define UT_BAG_ROT_YAW		11
#define UT_BAG_INV			12
#define UT_BAG_FLOAT		13
#define UT_BAG_INT			14

class CUTPropLink
{
	U8	 name[40];
	I64	 offset;
	I64	 size;
	I64	 bag_id;
	I64	 typ;		//UT_PROP_*
	I64	 bitmask;	//UBoolProperty::BitMask (FIRST_BITFIELD=1)
};

CUTPropLink	ut_plink[UT_PLINK_MAX];
I64		ut_plink_n		= 0;
I64		ut_plink_propsize	= 0;
I64		ut_plink_last_script	= 0;	//UStruct ScriptSize after LinkOffsets

#define UT_PLINK_SCRIPT_MAX	8192

U0 UTPropLinkClear()
{
	ut_plink_n = 0;
	ut_plink_propsize = 0;
	ut_plink_last_script = 0;
}

I64 UTPropLinkBagIdForName(U8 *nm)
{
	if (!nm)
		return UT_BAG_NONE;
	if (!StrCompare(nm, "Location"))
		return UT_BAG_LOC_X;
	if (!StrCompare(nm, "Health"))
		return UT_BAG_HEALTH;
	if (!StrCompare(nm, "DrawScale"))
		return UT_BAG_DRAWSCALE;
	if (!StrCompare(nm, "AmmoAmount") || !StrCompare(nm, "Ammo"))
		return UT_BAG_AMMO;
	if (!StrCompare(nm, "MaxAmmo"))
		return UT_BAG_MAXAMMO;
	if (!StrCompare(nm, "Team") || !StrCompare(nm, "PlayerReplicationInfo"))
		return UT_BAG_TEAM;
	if (!StrCompare(nm, "CollisionRadius"))
		return UT_BAG_COLL_R;
	if (!StrCompare(nm, "CollisionHeight"))
		return UT_BAG_COLL_H;
	if (!StrCompare(nm, "Rotation"))
		return UT_BAG_ROT_YAW;
	if (!StrCompare(nm, "Inventory") || !StrCompare(nm, "SelectedItem") ||
		!StrCompare(nm, "Weapon"))
		return UT_BAG_INV;
	return UT_BAG_NONE;
}

I64 UTPropLinkElemSize(U8 *cls)
{//UProperty::GetElementSize stand-in
	if (!cls)
		return 4;
	if (!StrCompare(cls, "ByteProperty"))
		return 1;
	if (!StrCompare(cls, "BoolProperty"))
		return 4;
	if (!StrCompare(cls, "IntProperty"))
		return 4;
	if (!StrCompare(cls, "FloatProperty"))
		return 4;
	if (!StrCompare(cls, "ObjectProperty") ||
		!StrCompare(cls, "ClassProperty"))
		return 4;
	if (!StrCompare(cls, "NameProperty"))
		return 4;
	if (!StrCompare(cls, "StrProperty") ||
		!StrCompare(cls, "StringProperty"))
		return 16;
	if (!StrCompare(cls, "StructProperty"))
		return 12;
	return 4;
}

Bool UTPropLinkIsPropertyClass(U8 *cls)
{
	if (!cls)
		return FALSE;
	if (!StrCompare(cls, "ByteProperty") ||
		!StrCompare(cls, "IntProperty") ||
		!StrCompare(cls, "BoolProperty") ||
		!StrCompare(cls, "FloatProperty") ||
		!StrCompare(cls, "ObjectProperty") ||
		!StrCompare(cls, "ClassProperty") ||
		!StrCompare(cls, "NameProperty") ||
		!StrCompare(cls, "StrProperty") ||
		!StrCompare(cls, "StringProperty") ||
		!StrCompare(cls, "StructProperty"))
		return TRUE;
	return FALSE;
}

I64 UTPropLinkAdd(U8 *name, I64 offset, I64 size, I64 bag_id, I64 typ)
{
	CUTPropLink *p;

	if (ut_plink_n >= UT_PLINK_MAX || !name)
		return -1;
	p = &ut_plink[ut_plink_n];
	MemSet(p, 0, sizeof(CUTPropLink));
	StrPrint(p->name, "%s", name);
	p->offset = offset;
	p->size = size;
	p->bag_id = bag_id;
	p->typ = typ;
	p->bitmask = 0;
	ut_plink_n++;
	return ut_plink_n - 1;
}

I64 UTPropLinkAddBit(U8 *name, I64 offset, I64 size, I64 bag_id,
	I64 typ, I64 bitmask)
{
	I64 i;
	CUTPropLink *p;

	i = UTPropLinkAdd(name, offset, size, bag_id, typ);
	if (i < 0)
		return -1;
	p = &ut_plink[i];
	p->bitmask = bitmask;
	return i;
}

I64 UTPropLinkFindByOffset(I64 offset)
{
	I64 i;

	i = 0;
	while (i < ut_plink_n)
	{
		if (ut_plink[i].offset == offset)
			return i;
		//Vector/Rotator: script may address component with base+0/+4/+8
		if (ut_plink[i].size >= 12 &&
			offset >= ut_plink[i].offset &&
			offset < ut_plink[i].offset + ut_plink[i].size)
			return i;
		i++;
	}
	return -1;
}

I64 UTPropLinkFindByName(U8 *name)
{
	I64 i;

	if (!name)
		return -1;
	i = 0;
	while (i < ut_plink_n)
	{
		if (!StrCompare(ut_plink[i].name, name))
			return i;
		i++;
	}
	return -1;
}

F64 UTPropLinkReadBag(CUTPropBag *bag, I64 link_i, I64 offset)
{//Resolve InstanceVariable offset through linker → bag value
	CUTPropLink *p;
	I64 comp;

	if (!bag || link_i < 0 || link_i >= ut_plink_n)
		return 0.0;
	p = &ut_plink[link_i];
	comp = offset - p->offset;
	if (p->bag_id == UT_BAG_LOC_X)
	{
		if (comp < 4)
			return bag->location[0];
		if (comp < 8)
			return bag->location[1];
		return bag->location[2];
	}
	if (p->bag_id == UT_BAG_HEALTH)
		return bag->health;
	if (p->bag_id == UT_BAG_DRAWSCALE)
		return bag->draw_scale;
	if (p->bag_id == UT_BAG_AMMO)
		return bag->ammo_amount;
	if (p->bag_id == UT_BAG_MAXAMMO)
		return ToF64(bag->max_ammo);
	if (p->bag_id == UT_BAG_TEAM)
		return ToF64(bag->team);
	if (p->bag_id == UT_BAG_COLL_R)
		return bag->collision_radius;
	if (p->bag_id == UT_BAG_COLL_H)
		return bag->collision_height;
	if (p->bag_id == UT_BAG_ROT_YAW)
	{
		if (bag->has_rotation)
		{
			if (comp < 4)
				return ToF64(bag->rotation[0]);
			if (comp < 8)
				return ToF64(bag->rotation[1]);
			return ToF64(bag->rotation[2]);
		}
		return 0.0;
	}
	if (p->bag_id == UT_BAG_INV)
	{
		if (ut_obj_inv_head >= 0)
			return ToF64(ut_obj_inv_head + 1);
		return 1.0;
	}
	return 0.0;
}

Bool UTPropLinkWriteBag(CUTPropBag *bag, I64 link_i, I64 offset, F64 v)
{//Inverse of UTPropLinkReadBag: script writes land back on the object.
 //Without this a script mutates a local copy and the result is discarded.
	CUTPropLink *p;
	I64 comp;

	if (!bag || link_i < 0 || link_i >= ut_plink_n)
		return FALSE;
	p = &ut_plink[link_i];
	comp = offset - p->offset;
	if (p->bag_id == UT_BAG_LOC_X)
	{
		if (comp < 4)
			bag->location[0] = v;
		else if (comp < 8)
			bag->location[1] = v;
		else
			bag->location[2] = v;
		bag->has_location = TRUE;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_HEALTH)
	{
		bag->health = v;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_DRAWSCALE)
	{
		bag->draw_scale = v;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_AMMO)
	{
		bag->ammo_amount = v;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_MAXAMMO)
	{
		bag->max_ammo = ToI64(v);
		return TRUE;
	}
	if (p->bag_id == UT_BAG_TEAM)
	{
		bag->team = ToI64(v);
		return TRUE;
	}
	if (p->bag_id == UT_BAG_COLL_R)
	{
		bag->collision_radius = v;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_COLL_H)
	{
		bag->collision_height = v;
		return TRUE;
	}
	if (p->bag_id == UT_BAG_ROT_YAW)
	{
		if (comp < 4)
			bag->rotation[0] = ToI64(v);
		else if (comp < 8)
			bag->rotation[1] = ToI64(v);
		else
			bag->rotation[2] = ToI64(v);
		bag->has_rotation = TRUE;
		return TRUE;
	}
	return FALSE;
}

I64 UTPropLinkAlign4(I64 n)
{
	return (n + 3) & ~3;
}

I64 UTPropLinkAlignN(I64 n, I64 a)
{//Align(n,a) — UnType.h Property::Link
	if (a <= 1)
		return n;
	return (n + a - 1) & ~(a - 1);
}

I64 UTPropLinkTypFromClass(U8 *cls)
{
	if (!cls)
		return UT_PROP_INT;
	if (!StrCompare(cls, "ByteProperty"))
		return UT_PROP_BYTE;
	if (!StrCompare(cls, "BoolProperty"))
		return UT_PROP_BOOL;
	if (!StrCompare(cls, "IntProperty"))
		return UT_PROP_INT;
	if (!StrCompare(cls, "FloatProperty"))
		return UT_PROP_FLOAT;
	if (!StrCompare(cls, "ObjectProperty") ||
		!StrCompare(cls, "ClassProperty"))
		return UT_PROP_OBJECT;
	if (!StrCompare(cls, "NameProperty"))
		return UT_PROP_NAME;
	if (!StrCompare(cls, "StrProperty") ||
		!StrCompare(cls, "StringProperty"))
		return UT_PROP_STRING;
	if (!StrCompare(cls, "StructProperty"))
		return UT_PROP_STRUCT;
	return UT_PROP_INT;
}

I64 UTPropLinkAlignFor(U8 *cls, I64 elem_sz)
{//UProperty::Link alignment requirement
	if (!cls)
		return 4;
	if (!StrCompare(cls, "ByteProperty") ||
		!StrCompare(cls, "StrProperty") ||
		!StrCompare(cls, "StringProperty"))
		return 1;
	if (!StrCompare(cls, "StructProperty"))
	{
		if (elem_sz == 2)
			return 2;
		if (elem_sz >= 4)
			return 4;
		return 1;
	}
	return 4;
}

I64 UTPropLinkReadFieldNext(CUTPackage *pkg, I64 exp_i)
{//UField::Serialize → SuperField + Next. Returns Next PackageIndex.
	CUTArc ar;
	CUTExport *e;
	I64 next;

	if (!pkg || exp_i < 0 || exp_i >= pkg->export_count)
		return 0;
	e = &pkg->exports[exp_i];
	if (e->serial_size < 1 || !UTPkgArcExport(pkg, exp_i, &ar))
		return 0;
	UTPropSkipStack(&ar, e->object_flags);
	UTPropSkipAll(&ar, pkg);
	ar.err = FALSE;
	UTArcIndex(&ar); //SuperField
	next = UTArcIndex(&ar); //Next
	if (ar.err)
		return 0;
	return next;
}

I64 UTPropLinkFieldKindOk(U8 *cn)
{//UField subclasses that appear in Children chain
	if (!cn)
		return 0;
	if (UTPropLinkIsPropertyClass(cn))
		return 1;
	if (!StrCompare(cn, "Function") || !StrCompare(cn, "Struct") ||
		!StrCompare(cn, "State") || !StrCompare(cn, "Enum") ||
		!StrCompare(cn, "Const") || !StrCompare(cn, "Class") ||
		!StrCompare(cn, "TextBuffer"))
		return 1;
	return 0;
}

I64 UTPropLinkReadStructChildren(CUTPackage *pkg, I64 cls_exp)
{//UStruct::Serialize after UField: ScriptText + Children + FriendlyName.
 //Validate FriendlyName == Class export name — detects parse shift.
	CUTArc ar;
	CUTExport *e;
	I64 children;
	I64 fname;
	I64 ei;
	U8 *want;
	U8 *got;
	U8 *cn;
	I64 outer;
	I64 i;

	if (!pkg || cls_exp < 0 || cls_exp >= pkg->export_count)
		return 0;
	e = &pkg->exports[cls_exp];
	want = UTPkgNameStr(pkg, e->name_index);
	if (e->serial_size < 1 || !UTPkgArcExport(pkg, cls_exp, &ar))
		return 0;
	//Class exports (class_index 0) start directly at UField: SuperField,
	//Next, ScriptText, Children, FriendlyName. There is no leading tagged
	//property block; skipping one ate two bytes and shifted every field,
	//which is what the 'Children shift ... Outer recover' heuristic was
	//catching on every class.
	if (e->class_index != 0)
	{
		UTPropSkipStack(&ar, e->object_flags);
		UTPropSkipAll(&ar, pkg);
		ar.err = FALSE;
	}
	UTArcIndex(&ar); //SuperField
	UTArcIndex(&ar); //Next
	UTArcIndex(&ar); //ScriptText
	children = UTArcIndex(&ar); //Children
	fname = UTArcIndex(&ar); //FriendlyName
	UTArcI32(&ar); //Line
	UTArcI32(&ar); //TextPos
	got = "";
	if (!ar.err && fname >= 0 && fname < pkg->name_count)
		got = UTPkgNameStr(pkg, fname);
	//Validate Children resolves to a Field; FriendlyName matches Class
	ei = UTPkgObjRefToExport(pkg, children);
	if (ei >= 0)
		cn = UTPkgClassName(pkg, pkg->exports[ei].class_index);
	else
		cn = "";
	if (!ar.err && children > 0 && ei >= 0 && UTPropLinkFieldKindOk(cn) &&
		got[0] && !StrCompare(got, want))
		return children;

	UTLog("UTPropLink: Children shift cls=%s friendly='%s' child=%d cn=%s - Outer recover\n",
		want, got, children, cn);
	//Recover: first Property export Outer==this Class (Children head stand-in)
	i = 0;
	while (i < pkg->export_count)
	{
		cn = UTPkgClassName(pkg, pkg->exports[i].class_index);
		if (UTPropLinkIsPropertyClass(cn))
		{
			outer = pkg->exports[i].package_index;
			if (outer == cls_exp + 1 || outer == cls_exp)
				return i + 1; //PackageIndex 1-based
		}
		i++;
	}
	return 0;
}

I64 UTPropLinkSkipStructScript(CUTPackage *pkg, I64 cls_exp)
{//UStruct::Serialize after Line/TextPos: Ar << ScriptSize; SerializeExpr loop.
	CUTArc ar;
	CUTExport *e;
	I64 script_size;

	ut_plink_last_script = 0;
	if (!pkg || cls_exp < 0 || cls_exp >= pkg->export_count)
		return 0;
	e = &pkg->exports[cls_exp];
	if (e->serial_size < 1 || !UTPkgArcExport(pkg, cls_exp, &ar))
		return 0;
	//Class exports carry no leading tagged props; see ReadStructChildren.
	if (e->class_index != 0)
	{
		UTPropSkipStack(&ar, e->object_flags);
		UTPropSkipAll(&ar, pkg);
		ar.err = FALSE;
	}
	UTArcIndex(&ar); //SuperField
	UTArcIndex(&ar); //Next
	UTArcIndex(&ar); //ScriptText
	UTArcIndex(&ar); //Children
	UTArcIndex(&ar); //FriendlyName
	UTArcI32(&ar);   //Line
	UTArcI32(&ar);   //TextPos
	script_size = UTArcI32(&ar);
	if (ar.err || script_size < 0)
		return 0;
	if (script_size > UT_PLINK_SCRIPT_MAX)
		script_size = UT_PLINK_SCRIPT_MAX;
	//SerializeExpr walk (compact Index ≠ raw ScriptSize Ar bytes)
	UTVMSerializeScriptSkip(&ar, pkg, script_size);
	ut_plink_last_script = script_size;
	return script_size;
}

I64 UTPropLinkReadArrayDim(CUTPackage *pkg, I64 exp_i)
{
	CUTArc ar;
	CUTExport *e;
	I64 dim;

	dim = 1;
	if (!pkg || exp_i < 0 || exp_i >= pkg->export_count)
		return 1;
	e = &pkg->exports[exp_i];
	if (e->serial_size < 1 || !UTPkgArcExport(pkg, exp_i, &ar))
		return 1;
	UTPropSkipStack(&ar, e->object_flags);
	UTPropSkipAll(&ar, pkg);
	ar.err = FALSE;
	UTArcIndex(&ar);
	UTArcIndex(&ar);
	dim = UTArcI32(&ar);
	if (ar.err || dim < 1 || dim > 256)
		return 1;
	return dim;
}

Bool UTPropLinkBuildFromPkg(U8 *pkg_path, U8 *cls_name, I64 base_size)
{//UStruct::Serialize load path: Children → LinkOffsets → ScriptSize.
 //Link mirrors UnType.h Property::Link (Bool bit-pack, Align).
	CUTPackage *pkg;
	I64 cls_exp;
	I64 child_ref;
	I64 exp_i;
	I64 next_ref;
	U8 *cn;
	U8 *nm;
	I64 off;
	I64 sz;
	I64 dim;
	I64 bag_id;
	I64 n_add;
	I64 guard;
	I64 typ;
	I64 align;
	I64 bit;
	I64 prev_bool;
	I64 prev_bit;
	I64 prev_off;
	I64 script_n;
	CUTExport *e;

	if (!pkg_path || !cls_name)
		return FALSE;
	pkg = UTPkgLoad(pkg_path);
	if (!pkg)
		return FALSE;
	cls_exp = UTPkgFindExport(pkg, "Class", cls_name);
	if (cls_exp < 0)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	off = UTPropLinkAlign4(base_size);
	n_add = 0;
	prev_bool = 0;
	prev_bit = 0;
	prev_off = 0;
	child_ref = UTPropLinkReadStructChildren(pkg, cls_exp);
	guard = 0;
	while (child_ref > 0 && ut_plink_n < UT_PLINK_MAX && guard < 512)
	{
		guard++;
		exp_i = UTPkgObjRefToExport(pkg, child_ref);
		if (exp_i < 0)
			break;
		e = &pkg->exports[exp_i];
		cn = UTPkgClassName(pkg, e->class_index);
		next_ref = UTPropLinkReadFieldNext(pkg, exp_i);
		if (UTPropLinkIsPropertyClass(cn))
		{
			nm = UTPkgNameStr(pkg, e->name_index);
			if (UTPropLinkFindByName(nm) < 0)
			{
				sz = UTPropLinkElemSize(cn);
				dim = UTPropLinkReadArrayDim(pkg, exp_i);
				if (!StrCompare(cn, "StructProperty") &&
					(!StrCompare(nm, "Location") ||
					 !StrCompare(nm, "Rotation") ||
					 !StrCompare(nm, "Velocity") ||
					 !StrCompare(nm, "Acceleration")))
					sz = 12;
				bag_id = UTPropLinkBagIdForName(nm);
				if (bag_id == UT_BAG_NONE)
				{
					if (!StrCompare(cn, "FloatProperty"))
						bag_id = UT_BAG_FLOAT;
					else if (!StrCompare(cn, "IntProperty"))
						bag_id = UT_BAG_INT;
				}
				typ = UTPropLinkTypFromClass(cn);
				if (typ == UT_PROP_BOOL)
				{
					//UBoolProperty::Link — MergeBools + NEXT_BITFIELD
					if (prev_bool && ((prev_bit << 1) != 0))
					{
						bit = prev_bit << 1;
						UTPropLinkAddBit(nm, prev_off, 4 * dim,
							bag_id, typ, bit);
						//PropertiesSize = Offset + GetSize(); packed DWORD
						if (prev_off + 4 * dim > off)
							off = prev_off + 4 * dim;
						prev_bit = bit;
					}
					else
					{
						off = UTPropLinkAlignN(off, 4);
						bit = 1;
						UTPropLinkAddBit(nm, off, 4 * dim,
							bag_id, typ, bit);
						prev_off = off;
						off = off + 4 * dim;
						prev_bit = bit;
					}
					prev_bool = 1;
				}
				else
				{
					align = UTPropLinkAlignFor(cn, sz);
					off = UTPropLinkAlignN(off, align);
					UTPropLinkAdd(nm, off, sz * dim, bag_id, typ);
					off = off + sz * dim;
					prev_bool = 0;
					prev_bit = 0;
				}
				n_add++;
			}
		}
		child_ref = next_ref;
	}
	//Fallback: export-table Outer scan when Children chain empty
	if (n_add < 1)
	{
		exp_i = 0;
		while (exp_i < pkg->export_count && ut_plink_n < UT_PLINK_MAX)
		{
			e = &pkg->exports[exp_i];
			cn = UTPkgClassName(pkg, e->class_index);
			if (UTPropLinkIsPropertyClass(cn))
			{
				if (e->package_index == cls_exp + 1 ||
					e->package_index == cls_exp)
				{
					nm = UTPkgNameStr(pkg, e->name_index);
					if (UTPropLinkFindByName(nm) < 0)
					{
						sz = UTPropLinkElemSize(cn);
						dim = UTPropLinkReadArrayDim(pkg, exp_i);
						if (!StrCompare(cn, "StructProperty") &&
							(!StrCompare(nm, "Location") ||
							 !StrCompare(nm, "Rotation") ||
							 !StrCompare(nm, "Velocity") ||
							 !StrCompare(nm, "Acceleration")))
							sz = 12;
						bag_id = UTPropLinkBagIdForName(nm);
						typ = UTPropLinkTypFromClass(cn);
						align = UTPropLinkAlignFor(cn, sz);
						if (typ == UT_PROP_BOOL)
						{
							off = UTPropLinkAlignN(off, 4);
							UTPropLinkAddBit(nm, off, 4 * dim,
								bag_id, typ, 1);
							off = off + 4 * dim;
						}
						else
						{
							off = UTPropLinkAlignN(off, align);
							UTPropLinkAdd(nm, off, sz * dim,
								bag_id, typ);
							off = off + sz * dim;
						}
						n_add++;
					}
				}
			}
			exp_i++;
		}
	}
	//ScriptSize consume after LinkOffsets (UStruct::Serialize order)
	script_n = UTPropLinkSkipStructScript(pkg, cls_exp);
	ut_plink_propsize = UTPropLinkAlign4(off);
	UTLog("UTPropLink: %s.%s ChildrenNext props=%d size=%d base=%d script=%d\n",
		pkg_path, cls_name, n_add, ut_plink_propsize, base_size, script_n);
	UTPkgFree(pkg);
	return n_add > 0;
}

U0 UTPropLinkSeedActor()
{//Intrinsic Actor layout seed before script props (UnType Link from C++ size).
 //Matches LinkOffsets starting from native AActor PropertiesSize floor.
	UTPropLinkClear;
	//Native-ish Actor fields used by script — offsets relative host bag map
	UTPropLinkAdd("Location", 0, 12, UT_BAG_LOC_X, UT_PROP_VECTOR);
	UTPropLinkAdd("Rotation", 12, 12, UT_BAG_ROT_YAW, UT_PROP_ROTATOR);
	UTPropLinkAdd("DrawScale", 24, 4, UT_BAG_DRAWSCALE, UT_PROP_FLOAT);
	UTPropLinkAdd("CollisionRadius", 28, 4, UT_BAG_COLL_R, UT_PROP_FLOAT);
	UTPropLinkAdd("CollisionHeight", 32, 4, UT_BAG_COLL_H, UT_PROP_FLOAT);
	UTPropLinkAdd("Inventory", 36, 4, UT_BAG_INV, UT_PROP_OBJECT);
	UTPropLinkAdd("Weapon", 40, 4, UT_BAG_INV, UT_PROP_OBJECT);
	ut_plink_propsize = 44;
}

Bool UTPropLinkBuildPawn()
{//Actor seed + Engine.Pawn + Botpack.TournamentPlayer property link
	I64 base;

	UTPropLinkSeedActor;
	base = ut_plink_propsize;
	if (UTPropLinkFindByName("Health") < 0)
	{
		UTPropLinkAdd("Health", base, 4, UT_BAG_HEALTH, UT_PROP_INT);
		base += 4;
		ut_plink_propsize = base;
	}
	UTPropLinkBuildFromPkg("::/Apps/UT99/System/Engine.u", "Pawn",
		ut_plink_propsize);
	UTPropLinkBuildFromPkg("::/Apps/UT99/System/Botpack.u",
		"TournamentPlayer", ut_plink_propsize);
	//UWindow Children/Next field order for Root/Window script props
	UTPropLinkBuildFromPkg("::/Apps/UT99/System/UWindow.u",
		"UWindowWindow", ut_plink_propsize);
	UTPropLinkBuildFromPkg("::/Apps/UT99/System/UMenu.u",
		"UMenuRootWindow", ut_plink_propsize);
	UTLog("UTPropLink: pawn+uwindow table n=%d size=%d\n",
		ut_plink_n, ut_plink_propsize);
	return ut_plink_n > 0;
}
