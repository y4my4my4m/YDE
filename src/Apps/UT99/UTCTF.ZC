// UTCTF.ZC - FlagBase / CTFFlag / ControlPoint / FortStandard SoftDrv rules.
//
// Team 0 = Red, Team 1 = Blue. Touch enemy flag → carry; own base + carry → score.
// DOM ControlPoint: hold → claim; claimed points tick score.
// Assault FortStandard: attacker touch destroys fort → score.

extern Bool	ut_alive;
extern I64	ut_frags;
extern I64	ut_player_team;
extern Bool	ut_match_over;
extern F64	ut_origin[3];
extern I64	ut_snd_ann_capture;
extern I64	ut_snd_ann_taken;
extern U0	UTGameAssignAssaultOrders();
extern U0	UTMsgCenter(U8 *s);

#define UT_CTF_MAX_FLAGS	4
#define UT_CTF_MAX_CP		8
#define UT_CTF_MAX_FORT		8
#define UT_TEAM_RED			0
#define UT_TEAM_BLUE		1

class CUTFlag
{
	F64	 home[3];
	F64	 origin[3];
	I64	 team;
	Bool carried;
	Bool at_home;
	Bool active;
};

class CUTCtrlPoint
{
	F64	 origin[3];
	I64	 team;		//-1 neutral, 0 red, 1 blue
	F64	 hold;
	F64	 score_t;
	Bool active;
};

class CUTFort
{
	F64	 origin[3];
	Bool alive;
	Bool final_fort;
	Bool active;
	U8	 name[48];
	I64	 defense_priority;
	I64	 defender_bot;	//-1 none; Assault SetDefenseFor
};

CUTFlag		ut_flags[UT_CTF_MAX_FLAGS];
I64			ut_flag_n		= 0;
CUTCtrlPoint	ut_cps[UT_CTF_MAX_CP];
I64			ut_cp_n			= 0;
CUTFort		ut_forts[UT_CTF_MAX_FORT];
I64			ut_fort_n		= 0;
I64			ut_ctf_score[2]	= {0, 0};
I64			ut_player_flag	= -1;
Bool		ut_ctf_active	= FALSE;
Bool		ut_dom_active	= FALSE;
Bool		ut_as_active	= FALSE;
I64			ut_cap_limit	= 5;
I64			ut_as_defense_mins	= 1;	//max FortStandard.DefenseTime
F64			ut_as_end_t		= 0.0;	//tS when defenders win
Bool		ut_as_attack_won	= FALSE;

U0 UTCTFClear()
{
	ut_flag_n = 0;
	ut_cp_n = 0;
	ut_fort_n = 0;
	ut_ctf_score[0] = 0;
	ut_ctf_score[1] = 0;
	ut_player_flag = -1;
	ut_ctf_active = FALSE;
	ut_dom_active = FALSE;
	ut_as_active = FALSE;
	ut_as_defense_mins = 1;
	ut_as_end_t = 0.0;
	ut_as_attack_won = FALSE;
}

U0 UTCTFCheckWin()
{
	if (ut_cap_limit < 1)
		return;
	if (ut_ctf_score[0] >= ut_cap_limit || ut_ctf_score[1] >= ut_cap_limit)
		ut_match_over = TRUE;
}

U0 UTCTFScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 fi;
	I64 team;
	CUTExport *e;
	U8 *cls;
	U8 *nm;
	F64 v[3];
	CUTPropBag bag;
	CUTFlag *f;
	CUTCtrlPoint *cp;
	CUTFort *ft;

	UTCTFClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		if ((!StrCompare(cls, "FlagBase") || !StrCompare(cls, "CTFFlag") ||
			!StrCompare(cls, "RedFlagBase") || !StrCompare(cls, "BlueFlagBase") ||
			!StrCompare(cls, "RedFlag") || !StrCompare(cls, "BlueFlag")) &&
			ut_flag_n < UT_CTF_MAX_FLAGS)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				fi = ut_flag_n;
				f = &ut_flags[fi];
				MemSet(f, 0, sizeof(CUTFlag));
				UTVecCopy(v, f->home);
				UTVecCopy(v, f->origin);
				team = UT_TEAM_RED;
				nm = UTPkgNameStr(pkg, e->name_index);
				if (!StrCompare(cls, "BlueFlagBase") ||
					!StrCompare(cls, "BlueFlag") ||
					(nm[0] == 'B' || nm[0] == 'b'))
					team = UT_TEAM_BLUE;
				UTPropBagInit(&bag);
				UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
					e->object_flags, &bag);
				if (bag.team == 0 || bag.team == 1)
					team = bag.team;
				f->team = team;
				f->at_home = TRUE;
				f->carried = FALSE;
				f->active = TRUE;
				ut_flag_n++;
				ut_ctf_active = TRUE;
			}
		}
		if ((!StrCompare(cls, "ControlPoint") ||
			!StrCompare(cls, "xControlPoint")) &&
			ut_cp_n < UT_CTF_MAX_CP)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				cp = &ut_cps[ut_cp_n];
				MemSet(cp, 0, sizeof(CUTCtrlPoint));
				UTVecCopy(v, cp->origin);
				cp->team = -1;
				cp->hold = 0.0;
				cp->score_t = 0.0;
				cp->active = TRUE;
				ut_cp_n++;
				ut_dom_active = TRUE;
			}
		}
		if ((!StrCompare(cls, "FortStandard") ||
			!StrCompare(cls, "FortBarricade")) &&
			ut_fort_n < UT_CTF_MAX_FORT)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				ft = &ut_forts[ut_fort_n];
				MemSet(ft, 0, sizeof(CUTFort));
				UTVecCopy(v, ft->origin);
				ft->alive = TRUE;
				ft->active = TRUE;
				ft->defender_bot = -1;
				ft->defense_priority = ut_fort_n;
				nm = UTPkgNameStr(pkg, e->name_index);
				if (nm)
					StrPrint(ft->name, "%s", nm);
				UTPropBagInit(&bag);
				UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
					e->object_flags, &bag);
				if (bag.defense_time > ut_as_defense_mins)
					ut_as_defense_mins = bag.defense_time;
				if (bag.defense_priority > 0)
					ft->defense_priority = bag.defense_priority;
				ut_fort_n++;
				ut_as_active = TRUE;
			}
		}
		i++;
	}
	if (ut_fort_n > 0)
		ut_forts[ut_fort_n - 1].final_fort = TRUE;
	if (ut_as_defense_mins < 1)
		ut_as_defense_mins = 1;
	UTLog("UTCTF: flags=%d cps=%d forts=%d ctf=%d dom=%d as=%d def=%dm\n",
		ut_flag_n, ut_cp_n, ut_fort_n,
		ut_ctf_active, ut_dom_active, ut_as_active, ut_as_defense_mins);
}

U0 UTCTFStartAssault()
{//= Assault.InitGame RemainingTime = max(DefenseTime)*60.
	if (!ut_as_active)
		return;
	if (ut_as_defense_mins < 1)
		ut_as_defense_mins = 1;
	ut_as_end_t = tS + ToF64(ut_as_defense_mins) * 60.0;
	ut_as_attack_won = FALSE;
	UTLog("UTCTF: Assault DefenseTime=%d min end=%3.0f\n",
		ut_as_defense_mins, ut_as_end_t);
}

I64 UTCTFBestAttackFort()
{//= Assault.AttackFort — highest DefensePriority among alive forts.
	I64 i;
	I64 best;
	I64 pri;

	best = -1;
	pri = -1;
	i = 0;
	while (i < ut_fort_n)
	{
		if (ut_forts[i].active && ut_forts[i].alive)
		{
			if (ut_forts[i].defense_priority > pri)
			{
				pri = ut_forts[i].defense_priority;
				best = i;
			}
		}
		i++;
	}
	return best;
}

I64 UTCTFBestDefendFort(I64 bot_i)
{//= Assault.SetDefenseFor / BestFortFor.
	I64 i;
	I64 best;
	CUTFort *f;
	CUTFort *cur;

	best = -1;
	i = 0;
	while (i < ut_fort_n)
	{
		f = &ut_forts[i];
		if (f->active && f->alive)
		{
			if (best < 0)
				best = i;
			else
			{
				cur = &ut_forts[best];
				if (f->defense_priority > cur->defense_priority)
					best = i;
				else if (f->defense_priority == cur->defense_priority)
				{
					if (f->defender_bot < 0 || f->defender_bot == bot_i)
						best = i;
				}
			}
		}
		i++;
	}
	return best;
}

U0 UTCTFClearFortDefenders()
{
	I64 i;

	i = 0;
	while (i < ut_fort_n)
	{
		ut_forts[i].defender_bot = -1;
		i++;
	}
}

U0 UTCTFTickAssault()
{//= Assault: time expires → DefenderSuccess; final fort → Attacker win.
	if (!ut_as_active || ut_match_over)
		return;
	if (ut_as_attack_won)
		return;
	if (ut_as_end_t > 0.0 && tS >= ut_as_end_t)
	{
		ut_ctf_score[UT_TEAM_BLUE]++;
		ut_match_over = TRUE;
		UTMsgCenter("Defenders Held!");
		UTLog("UTCTF: defenders held base\n");
	}
}

U0 UTCTFReturnFlag(I64 fi)
{
	CUTFlag *f;

	if (fi < 0 || fi >= ut_flag_n)
		return;
	f = &ut_flags[fi];
	UTVecCopy(f->home, f->origin);
	f->at_home = TRUE;
	f->carried = FALSE;
	if (ut_player_flag == fi)
		ut_player_flag = -1;
}

U0 UTCTFDropFlag()
{//death — leave flag at corpse.
	CUTFlag *f;

	if (ut_player_flag < 0 || ut_player_flag >= ut_flag_n)
		return;
	f = &ut_flags[ut_player_flag];
	f->carried = FALSE;
	f->at_home = FALSE;
	UTVecCopy(ut_origin, f->origin);
	ut_player_flag = -1;
	UTMsgCenter("Flag Dropped!");
	UTLog("UTCTF: flag dropped\n");
}

U0 UTCTFTouchPlayer(F64 *org)
{
	I64 i;
	CUTFlag *f;
	CUTFort *ft;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	I64 player_team;

	if (!org || !ut_alive)
		return;
	player_team = ut_player_team & 1;
	if (ut_ctf_active)
	{
		i = 0;
		while (i < ut_flag_n)
		{
			f = &ut_flags[i];
			if (f->active && !f->carried)
			{
				dx = f->origin[0] - org[0];
				dy = f->origin[1] - org[1];
				dz = f->origin[2] - org[2];
				d2 = dx * dx + dy * dy + dz * dz;
				if (d2 < 80.0 * 80.0)
				{
					if (f->team != player_team)
					{
						f->carried = TRUE;
						f->at_home = FALSE;
						ut_player_flag = i;
						UTMsgCenter("Got The Flag!");
						if (ut_snd_ann_taken >= 0)
							UTSndPlay(ut_snd_ann_taken, 1.0);
						UTLog("UTCTF: took flag team=%d\n", f->team);
					}
					else if (f->at_home && ut_player_flag >= 0)
					{
						ut_ctf_score[player_team]++;
						UTCTFReturnFlag(ut_player_flag);
						ut_frags++;
						if (ut_snd_ann_capture >= 0)
							UTSndPlay(ut_snd_ann_capture, 1.0);
						UTMsgCenter("Capture!");
						UTLog("UTCTF: capture red=%d blue=%d\n",
							ut_ctf_score[0], ut_ctf_score[1]);
						UTCTFCheckWin;
					}
					else if (!f->at_home && f->team == player_team)
					{
						UTCTFReturnFlag(i);
						UTMsgCenter("Flag Returned!");
					}
				}
			}
			i++;
		}
		if (ut_player_flag >= 0 && ut_player_flag < ut_flag_n)
		{
			f = &ut_flags[ut_player_flag];
			UTVecCopy(org, f->origin);
			f->origin[2] += 40.0;
		}
	}
	if (ut_as_active)
	{
		i = 0;
		while (i < ut_fort_n)
		{
			ft = &ut_forts[i];
			if (ft->active && ft->alive)
			{
				dx = ft->origin[0] - org[0];
				dy = ft->origin[1] - org[1];
				dz = ft->origin[2] - org[2];
				d2 = dx * dx + dy * dy + dz * dz;
				if (d2 < 100.0 * 100.0)
				{//= FortStandard.Touch DestroyFort (attacker Red)
					ft->alive = FALSE;
					ut_ctf_score[UT_TEAM_RED]++;
					ut_frags++;
					UTMsgCenter("Fort Destroyed!");
					UTLog("UTCTF: fort down %s score=%d\n",
						ft->name, ut_ctf_score[0]);
					if (ft->final_fort)
					{
						ut_as_attack_won = TRUE;
						ut_match_over = TRUE;
						UTMsgCenter("Assault Won!");
					}
					else
						UTGameAssignAssaultOrders;
					UTCTFCheckWin;
				}
			}
			i++;
		}
	}
}

U0 UTCTFTickDOM(F64 *org, F64 dt)
{
	I64 i;
	CUTCtrlPoint *cp;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	I64 claim;

	if (!ut_dom_active || !org)
		return;
	i = 0;
	while (i < ut_cp_n)
	{
		cp = &ut_cps[i];
		if (cp->active)
		{
			claim = -2;
			if (ut_alive)
			{
				dx = cp->origin[0] - org[0];
				dy = cp->origin[1] - org[1];
				dz = cp->origin[2] - org[2];
				d2 = dx * dx + dy * dy + dz * dz;
				if (d2 < 120.0 * 120.0)
					claim = ut_player_team & 1;
			}
			if (claim == 0 || claim == 1)
			{
				if (cp->team == claim)
					cp->hold = 0.0;
				else
				{
					cp->hold += dt;
					if (cp->hold > 2.5)
					{
						cp->team = claim;
						cp->hold = 0.0;
						if (claim == 0)
							UTMsgCenter("Control Point — Red");
						else
							UTMsgCenter("Control Point — Blue");
						UTLog("UTCTF: DOM claim team=%d\n", claim);
					}
				}
			}
			else
				cp->hold *= 0.95;
			if (cp->team == 0 || cp->team == 1)
			{
				cp->score_t += dt;
				if (cp->score_t >= 5.0)
				{
					cp->score_t = 0.0;
					ut_ctf_score[cp->team]++;
					if (cp->team == (ut_player_team & 1))
						ut_frags++;
					UTCTFCheckWin;
				}
			}
		}
		i++;
	}
}

U0 UTCTFDraw(CUTCanvas *c)
{
	I64 i;
	CUTFlag *f;
	CUTCtrlPoint *cp;
	CUTFort *ft;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 sx;
	F64 sy;
	F64 iz;
	F64 pulse;
	I64 col;
	I64 bw;
	U8 line[24];

	if (!c)
		return;
	i = 0;
	while (i < ut_flag_n)
	{
		f = &ut_flags[i];
		if (f->active && !f->carried)
		{
			col = 40;
			if (f->team == UT_TEAM_BLUE)
				col = 200;
			a[0] = f->origin[0] - 10; a[1] = f->origin[1]; a[2] = f->origin[2];
			b[0] = f->origin[0] + 10; b[1] = f->origin[1]; b[2] = f->origin[2];
			pulse = 60.0 + Sin(tS * 5.0) * 12.0;
			cc[0] = f->origin[0]; cc[1] = f->origin[1];
			cc[2] = f->origin[2] + pulse;
			UTDrawTri3(c, a, b, cc, col);
			a[2] = f->origin[2] + 70.0;
			if (ut_win_ready && UTDrawProject(c, a, &sx, &sy, &iz) && iz > 0.0)
			{
				if (f->team == UT_TEAM_BLUE)
					StrPrint(line, "BlueFlag");
				else
					StrPrint(line, "RedFlag");
				UTWinTextAt(ToI64(sx) - 20, ToI64(sy) - 10, line, ut_col_sel);
			}
		}
		i++;
	}
	i = 0;
	while (i < ut_cp_n)
	{
		cp = &ut_cps[i];
		if (cp->active)
		{
			col = 120;
			if (cp->team == UT_TEAM_RED)
				col = 50;
			else if (cp->team == UT_TEAM_BLUE)
				col = 180;
			a[0] = cp->origin[0] - 20; a[1] = cp->origin[1] - 20;
			a[2] = cp->origin[2];
			b[0] = cp->origin[0] + 20; b[1] = cp->origin[1] - 20;
			b[2] = cp->origin[2];
			cc[0] = cp->origin[0]; cc[1] = cp->origin[1] + 20;
			cc[2] = cp->origin[2] + 30;
			UTDrawTri3(c, a, b, cc, col);
			a[0] = cp->origin[0];
			a[1] = cp->origin[1];
			a[2] = cp->origin[2] + 40.0;
			if (ut_win_ready && UTDrawProject(c, a, &sx, &sy, &iz) && iz > 0.0)
			{
				StrPrint(line, "CP%d", i);
				UTWinTextAt(ToI64(sx) - 8, ToI64(sy) - 8, line, ut_col_white);
				//DOM hold SoftDrv progress bar
				if (cp->hold > 0.05)
				{
					bw = ToI64(cp->hold / 2.5 * 40.0);
					if (bw > 40)
						bw = 40;
					if (bw < 1)
						bw = 1;
					UTWinFill(ToI64(sx) - 20, ToI64(sy) + 4, 40, 4, ut_col_dim);
					UTWinFill(ToI64(sx) - 20, ToI64(sy) + 4, bw, 4, ut_col_sel);
				}
			}
		}
		i++;
	}
	i = 0;
	while (i < ut_fort_n)
	{
		ft = &ut_forts[i];
		if (ft->active && ft->alive)
		{
			col = 90;
			if (ft->final_fort)
				col = 30;
			a[0] = ft->origin[0] - 24; a[1] = ft->origin[1] - 24;
			a[2] = ft->origin[2];
			b[0] = ft->origin[0] + 24; b[1] = ft->origin[1] - 24;
			b[2] = ft->origin[2];
			cc[0] = ft->origin[0]; cc[1] = ft->origin[1] + 24;
			cc[2] = ft->origin[2] + 48;
			UTDrawTri3(c, a, b, cc, col);
			a[0] = ft->origin[0];
			a[1] = ft->origin[1];
			a[2] = ft->origin[2] + 56.0;
			if (ut_win_ready && UTDrawProject(c, a, &sx, &sy, &iz) && iz > 0.0)
			{
				if (ft->name[0])
					StrPrint(line, "%s", ft->name);
				else
					StrPrint(line, "Fort%d", i);
				UTWinTextAt(ToI64(sx) - 12, ToI64(sy) - 10, line, ut_col_label);
			}
		}
		i++;
	}
}
