// UTCTF.ZC - FlagBase / CTFFlag SoftDrv logic from map exports.
//
// Team 0 = Red, Team 1 = Blue. Touch enemy flag → carry; own base + carry → score.
// DOM ControlPoint: hold near point for soft score ticks.

extern Bool	ut_alive;
extern I64	ut_frags;

#define UT_CTF_MAX_FLAGS	4
#define UT_CTF_MAX_CP		8
#define UT_TEAM_RED			0
#define UT_TEAM_BLUE		1

class CUTFlag
{
	F64	 home[3];
	F64	 origin[3];
	I64	 team;
	Bool carried;
	Bool at_home;
	Bool active;
};

class CUTCtrlPoint
{
	F64	 origin[3];
	I64	 team;		//-1 neutral, 0 red, 1 blue
	F64	 hold;
	Bool active;
};

CUTFlag		ut_flags[UT_CTF_MAX_FLAGS];
I64			ut_flag_n		= 0;
CUTCtrlPoint	ut_cps[UT_CTF_MAX_CP];
I64			ut_cp_n			= 0;
I64			ut_ctf_score[2]	= {0, 0};
I64			ut_player_flag	= -1;	//carried flag index
Bool		ut_ctf_active	= FALSE;
Bool		ut_dom_active	= FALSE;

U0 UTCTFClear()
{
	ut_flag_n = 0;
	ut_cp_n = 0;
	ut_ctf_score[0] = 0;
	ut_ctf_score[1] = 0;
	ut_player_flag = -1;
	ut_ctf_active = FALSE;
	ut_dom_active = FALSE;
}

U0 UTCTFScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 fi;
	I64 team;
	CUTExport *e;
	U8 *cls;
	U8 *nm;
	F64 v[3];
	CUTPropBag bag;
	CUTFlag *f;
	CUTCtrlPoint *cp;

	UTCTFClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		if ((!StrCompare(cls, "FlagBase") || !StrCompare(cls, "CTFFlag") ||
			!StrCompare(cls, "RedFlagBase") || !StrCompare(cls, "BlueFlagBase") ||
			!StrCompare(cls, "RedFlag") || !StrCompare(cls, "BlueFlag")) &&
			ut_flag_n < UT_CTF_MAX_FLAGS)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				fi = ut_flag_n;
				f = &ut_flags[fi];
				MemSet(f, 0, sizeof(CUTFlag));
				UTVecCopy(v, f->home);
				UTVecCopy(v, f->origin);
				team = UT_TEAM_RED;
				nm = UTPkgNameStr(pkg, e->name_index);
				if (!StrCompare(cls, "BlueFlagBase") ||
					!StrCompare(cls, "BlueFlag") ||
					(nm[0] == 'B' || nm[0] == 'b'))
					team = UT_TEAM_BLUE;
				if (UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
					e->object_flags, &bag))
				{
					if (bag.team == 0 || bag.team == 1)
						team = bag.team;
				}
				f->team = team;
				f->at_home = TRUE;
				f->carried = FALSE;
				f->active = TRUE;
				ut_flag_n++;
				ut_ctf_active = TRUE;
			}
		}
		if (!StrCompare(cls, "ControlPoint") && ut_cp_n < UT_CTF_MAX_CP)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				cp = &ut_cps[ut_cp_n];
				MemSet(cp, 0, sizeof(CUTCtrlPoint));
				UTVecCopy(v, cp->origin);
				cp->team = -1;
				cp->hold = 0.0;
				cp->active = TRUE;
				ut_cp_n++;
				ut_dom_active = TRUE;
			}
		}
		i++;
	}
	UTLog("UTCTF: flags=%d cps=%d ctf=%d dom=%d\n",
		ut_flag_n, ut_cp_n, ut_ctf_active, ut_dom_active);
}

U0 UTCTFReturnFlag(I64 fi)
{
	CUTFlag *f;

	if (fi < 0 || fi >= ut_flag_n)
		return;
	f = &ut_flags[fi];
	UTVecCopy(f->home, f->origin);
	f->at_home = TRUE;
	f->carried = FALSE;
	if (ut_player_flag == fi)
		ut_player_flag = -1;
}

U0 UTCTFTouchPlayer(F64 *org)
{
	I64 i;
	CUTFlag *f;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	I64 player_team;

	if (!ut_ctf_active || !org || !ut_alive)
		return;
	//local player is always team Red for SoftDrv DM/CTF hybrid
	player_team = UT_TEAM_RED;
	i = 0;
	while (i < ut_flag_n)
	{
		f = &ut_flags[i];
		if (f->active && !f->carried)
		{
			dx = f->origin[0] - org[0];
			dy = f->origin[1] - org[1];
			dz = f->origin[2] - org[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < 80.0 * 80.0)
			{
				if (f->team != player_team)
				{
					f->carried = TRUE;
					f->at_home = FALSE;
					ut_player_flag = i;
					UTLog("UTCTF: took flag team=%d\n", f->team);
				}
				else if (f->at_home && ut_player_flag >= 0)
				{
					ut_ctf_score[player_team]++;
					UTCTFReturnFlag(ut_player_flag);
					ut_frags++;
					if (ut_snd_ann_capture >= 0)
						UTSndPlay(ut_snd_ann_capture, 1.0);
					UTLog("UTCTF: capture red=%d blue=%d\n",
						ut_ctf_score[0], ut_ctf_score[1]);
				}
				else if (!f->at_home && f->team == player_team)
					UTCTFReturnFlag(i);
			}
		}
		i++;
	}
	if (ut_player_flag >= 0 && ut_player_flag < ut_flag_n)
	{
		f = &ut_flags[ut_player_flag];
		UTVecCopy(org, f->origin);
		f->origin[2] += 40.0;
	}
}

U0 UTCTFTickDOM(F64 *org, F64 dt)
{
	I64 i;
	CUTCtrlPoint *cp;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	if (!ut_dom_active || !org || !ut_alive)
		return;
	i = 0;
	while (i < ut_cp_n)
	{
		cp = &ut_cps[i];
		if (cp->active)
		{
			dx = cp->origin[0] - org[0];
			dy = cp->origin[1] - org[1];
			dz = cp->origin[2] - org[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < 120.0 * 120.0)
			{
				cp->hold += dt;
				if (cp->hold > 3.0)
				{
					cp->team = UT_TEAM_RED;
					cp->hold = 0.0;
					ut_ctf_score[0]++;
				}
			}
			else
				cp->hold *= 0.95;
		}
		i++;
	}
}

U0 UTCTFDraw(CUTCanvas *c)
{
	I64 i;
	CUTFlag *f;
	CUTCtrlPoint *cp;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	I64 col;

	if (!c)
		return;
	i = 0;
	while (i < ut_flag_n)
	{
		f = &ut_flags[i];
		if (f->active)
		{
			col = 40;
			if (f->team == UT_TEAM_BLUE)
				col = 200;
			a[0] = f->origin[0] - 10; a[1] = f->origin[1]; a[2] = f->origin[2];
			b[0] = f->origin[0] + 10; b[1] = f->origin[1]; b[2] = f->origin[2];
			cc[0] = f->origin[0]; cc[1] = f->origin[1]; cc[2] = f->origin[2] + 60;
			UTDrawTri3(c, a, b, cc, col);
		}
		i++;
	}
	i = 0;
	while (i < ut_cp_n)
	{
		cp = &ut_cps[i];
		if (cp->active)
		{
			col = 120;
			if (cp->team == UT_TEAM_RED)
				col = 50;
			else if (cp->team == UT_TEAM_BLUE)
				col = 180;
			a[0] = cp->origin[0] - 20; a[1] = cp->origin[1] - 20;
			a[2] = cp->origin[2];
			b[0] = cp->origin[0] + 20; b[1] = cp->origin[1] - 20;
			b[2] = cp->origin[2];
			cc[0] = cp->origin[0]; cc[1] = cp->origin[1] + 20;
			cc[2] = cp->origin[2] + 30;
			UTDrawTri3(c, a, b, cc, col);
		}
		i++;
	}
}
