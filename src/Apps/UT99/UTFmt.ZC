// UTFmt.ZC - little-endian readers + Unreal FCompactIndex.
//
// ZealC is F64-only and postfix casts are no-ops. Never overlay a class on
// file bytes. PACKAGE_FILE_TAG and compact-index layout: UnObjVer.h,
// Help/PACKAGES.md in Ut99PubSrc.

#define UT_PACKAGE_TAG			0x9E2A83C1	//UnObjVer.h; compare as U32, never signed I32
#define UT_PACKAGE_VERSION		69
#define UT_PACKAGE_MIN_VERSION	60
#define UT_ENGINE_VERSION		430
#define UT_NAME_SIZE			64

// Retail layout under ::/Apps/UT99 — same order as Default.ini Paths=
#define UT99_DIR			"::/Apps/UT99/"
#define UT99_SYSTEM_DIR		"::/Apps/UT99/System/"
#define UT99_MAPS_DIR		"::/Apps/UT99/Maps/"
#define UT99_TEXTURES_DIR	"::/Apps/UT99/Textures/"
#define UT99_SOUNDS_DIR		"::/Apps/UT99/Sounds/"
#define UT99_MUSIC_DIR		"::/Apps/UT99/Music/"
#define UT99_DATA_DIR		"::/Apps/UT99/data/"
#define UT99_LOG_PATH		"::/Apps/UT99/UT99LOG.TXT"

#define UT_LOG_MAX				65536

U8	*ut_log_buf	= NULL;
I64	 ut_log_len	= 0;
Bool ut_log_disk	= TRUE;

U0 UTLogInit()
{
	if (!ut_log_buf)
		ut_log_buf = CAlloc(UT_LOG_MAX);
	ut_log_len = 0;
}

U0 UTLogFlush()
{
	if (!ut_log_disk || !ut_log_buf || ut_log_len <= 0)
		return;
	FileWrite(UT99_LOG_PATH, ut_log_buf, ut_log_len);
}

U0 UTLog(U8 *fmt, ...)
{
	U8	*line;
	I64	 n;
	I64	 room;

	if (!ut_log_buf)
		UTLogInit;

	line = StrPrintJoin(NULL, fmt, argc, argv);
	n    = StrLen(line);
	room = UT_LOG_MAX - ut_log_len - 1;
	if (room > 0)
	{
		if (n > room)
			n = room;
		MemCopy(ut_log_buf + ut_log_len, line, n);
		ut_log_len += n;
		ut_log_buf[ut_log_len] = 0;
		UTLogFlush;
	}
	Free(line);
}

U16 UTRdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

I64 UTRdI16(U8 *p)
{
	I64 v = p[0] | (p[1] << 8);

	if (v & 0x8000)
		v -= 0x10000;
	return v;
}

U32 UTRdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 UTRdI32(U8 *p)
{
	I64 v = UTRdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;
	return v;
}

F64 UTRdF32(U8 *p)
{//binary32 -> F64 by rebuilding the bit pattern
	U32 b   = UTRdU32(p);
	I64 sgn = b >> 31;
	I64 exp = (b >> 23) & 0xFF;
	I64 man = b & 0x7FFFFF;
	I64 d;
	F64 r;

	if (!exp)
		d = sgn << 63;
	else if (exp == 255)
		d = sgn << 63;
	else
		d = (sgn << 63) | ((exp + 896) << 52) | (man << 29);

	MemCopy(&r, &d, 8);
	return r;
}

U0 UTRdVec(U8 *p, F64 *out)
{
	out[0] = UTRdF32(p);
	out[1] = UTRdF32(p + 4);
	out[2] = UTRdF32(p + 8);
}

U0 UTRdPlane(U8 *p, F64 *out)
{//FPlane: X Y Z W
	out[0] = UTRdF32(p);
	out[1] = UTRdF32(p + 4);
	out[2] = UTRdF32(p + 8);
	out[3] = UTRdF32(p + 12);
}

class CUTArc
{//byte cursor over a resident file image. mirrors FArchive load path.
	U8	*data;
	I64	 size;
	I64	 pos;
	I64	 ver;		//Epic package version (low 16 of FileVersion)
	I64	 lic_ver;	//licensee version (high 16)
	Bool err;
};

U0 UTArcInit(CUTArc *ar, U8 *data, I64 size)
{
	ar->data	= data;
	ar->size	= size;
	ar->pos		= 0;
	ar->ver		= UT_PACKAGE_VERSION;
	ar->lic_ver	= 0;
	ar->err		= FALSE;
}

Bool UTArcSeek(CUTArc *ar, I64 pos)
{
	if (pos < 0 || pos > ar->size)
	{
		ar->err = TRUE;
		return FALSE;
	}
	ar->pos = pos;
	return TRUE;
}

U8 *UTArcPtr(CUTArc *ar, I64 n)
{
	U8 *p;

	if (ar->err || ar->pos < 0 || ar->pos + n > ar->size)
	{
		ar->err = TRUE;
		return NULL;
	}
	p = ar->data + ar->pos;
	ar->pos += n;
	return p;
}

U8 UTArcU8(CUTArc *ar)
{
	U8 *p = UTArcPtr(ar, 1);

	if (!p)
		return 0;
	return *p;
}

U16 UTArcU16(CUTArc *ar)
{
	U8 *p = UTArcPtr(ar, 2);

	if (!p)
		return 0;
	return UTRdU16(p);
}

I64 UTArcI32(CUTArc *ar)
{
	U8 *p = UTArcPtr(ar, 4);

	if (!p)
		return 0;
	return UTRdI32(p);
}

U32 UTArcU32(CUTArc *ar)
{
	U8 *p = UTArcPtr(ar, 4);

	if (!p)
		return 0;
	return UTRdU32(p);
}

F64 UTArcF32(CUTArc *ar)
{
	U8 *p = UTArcPtr(ar, 4);

	if (!p)
		return 0.0;
	return UTRdF32(p);
}

I64 UTArcIndex(CUTArc *ar)
{//FCompactIndex loader. Exact rebuild from Help/PACKAGES.md.
	//I64 temps: U8 locals trip "64-bit reg variable" and can corrupt.
	I64	b0;
	I64	b1;
	I64	b2;
	I64	b3;
	I64	b4;
	I64	val;

	b0  = UTArcU8(ar) & 0xFF;
	val = 0;
	if (b0 & 0x40)
	{
		b1 = UTArcU8(ar) & 0xFF;
		if (b1 & 0x80)
		{
			b2 = UTArcU8(ar) & 0xFF;
			if (b2 & 0x80)
			{
				b3 = UTArcU8(ar) & 0xFF;
				if (b3 & 0x80)
				{
					b4  = UTArcU8(ar) & 0xFF;
					val = b4;
				}
				val = (val << 7) + (b3 & 0x7F);
			}
			val = (val << 7) + (b2 & 0x7F);
		}
		val = (val << 7) + (b1 & 0x7F);
	}
	val = (val << 6) + (b0 & 0x3F);
	if (b0 & 0x80)
		val = -val;
	return val;
}

U0 UTArcIndexWrite(U8 *dst, I64 *pos, I64 value)
{//FCompactIndex saver into a scratch buffer. PACKAGES.md encode half.
	I64	v;
	I64	b0;
	I64	b1;
	I64	b2;
	I64	b3;
	I64	b4;
	I64	p;

	p = *pos;
	if (value < 0)
		v = -value;
	else
		v = value;
	if (value >= 0)
		b0 = 0;
	else
		b0 = 0x80;
	if (v < 0x40)
		b0 = b0 + v;
	else
		b0 = b0 + ((v & 0x3F) + 0x40);
	dst[p++] = b0 & 0xFF;
	if (b0 & 0x40)
	{
		v = v >> 6;
		if (v < 0x80)
			b1 = v;
		else
			b1 = (v & 0x7F) + 0x80;
		dst[p++] = b1 & 0xFF;
		if (b1 & 0x80)
		{
			v = v >> 7;
			if (v < 0x80)
				b2 = v;
			else
				b2 = (v & 0x7F) + 0x80;
			dst[p++] = b2 & 0xFF;
			if (b2 & 0x80)
			{
				v = v >> 7;
				if (v < 0x80)
					b3 = v;
				else
					b3 = (v & 0x7F) + 0x80;
				dst[p++] = b3 & 0xFF;
				if (b3 & 0x80)
				{
					v = v >> 7;
					b4 = v;
					dst[p++] = b4 & 0xFF;
				}
			}
		}
	}
	*pos = p;
}

I64 UTIndexEncodeSize(I64 value)
{//byte count a compact index occupies when saved. mirrors PACKAGES.md.
	I64 v;
	I64 n;

	if (value < 0)
		v = -value;
	else
		v = value;
	n = 1;
	if (v >= 0x40)
	{
		v = v >> 6;
		n++;
		while (v >= 0x80)
		{
			v = v >> 7;
			n++;
		}
	}
	return n;
}
