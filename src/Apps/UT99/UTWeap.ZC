// UTWeap.ZC - TournamentWeapon table + Inventory chain Exec for SoftDrv host.
//
// Boot: UTClientTravel → UTWeapInit; Touch pickups → UTInvExecGive.

#define UT_WEAP_HAMMER		0
#define UT_WEAP_ENFORCER	1
#define UT_WEAP_BIO			2
#define UT_WEAP_SHOCK		3
#define UT_WEAP_PULSE		4
#define UT_WEAP_RIPPER		5
#define UT_WEAP_MINIGUN		6
#define UT_WEAP_FLAK		7
#define UT_WEAP_ROCKET		8
#define UT_WEAP_SNIPER		9
#define UT_WEAP_TRANS		10
#define UT_WEAP_REDEEMER	11
#define UT_WEAP_SSHOT		12
#define UT_WEAP_N			13

#define UT_PROJ_MAX			32
#define UT_PROJ_NORMAL		0
#define UT_PROJ_TRANS		1
#define UT_PROJ_REDEEMER	2
#define UT_PROJ_RIPPER		3

extern Bool	ut_mut_arena;
extern Bool	ut_mut_noredeem;

class CUTWeapDef
{
	U8	 name[28];
	U8	 cls_name[32];
	I64	 ammo_max;
	I64	 ammo_start;
	F64	 damage;
	F64	 alt_damage;
	F64	 refire;
	F64	 alt_refire;
	Bool projectile;
	Bool alt_projectile;
	F64	 proj_speed;
	F64	 splash;
	I64	 snd_slot;
	I64	 inv_group;		//Inventory.InventoryGroup 1..10
	//Weapon.FireSound / AltFireSound / SelectSound, Inventory.PickupSound,
	//read from the class defaults in Botpack.u.
	//Weapon.PlayerViewMesh / PlayerViewOffset / PlayerViewScale.
	U8	 view_mesh[48];
	F64	 view_offset[3];
	F64	 view_scale;
	U8	 fire_snd[48];
	U8	 altfire_snd[48];
	U8	 select_snd[48];
	U8	 pickup_snd[48];
};

class CUTProj
{
	F64	 origin[3];
	F64	 vel[3];
	F64	 damage;
	F64	 life;
	F64	 splash;
	Bool alive;
	I64	 owner_weap;
	I64	 kind;
	I64	 bounces;		//Ripper SoftDrv wall bounce count
};

CUTWeapDef	ut_weap_def[UT_WEAP_N];
CUTProj		ut_proj[UT_PROJ_MAX];
I64			ut_weap_cur		= UT_WEAP_SHOCK;
I64			ut_weap_ammo[UT_WEAP_N];
Bool		ut_weap_owned[UT_WEAP_N];
F64			ut_weap_next_fire	= 0.0;
Bool		ut_weap_alt		= FALSE;
F64		ut_hammer_charge	= 0.0;
Bool	ut_hammer_charging	= FALSE;
I64		ut_trans_disk	= -1;
I64		ut_inv_next[UT_WEAP_N];	//Inventory linked list next weap id
I64		ut_inv_head		= -1;	//Pawn.Inventory head
Bool	ut_weap_ready		= FALSE;
F64		ut_minigun_spin		= 0.0;	//0..1 spin-up (Botpack Minigun)
Bool	ut_sniper_zoom		= FALSE;
F64		ut_sniper_fov_saved	= 90.0;
Bool	ut_redeemer_guided	= FALSE;
F64		ut_weap_name_until	= 0.0;

extern F64	ut_health;
extern F64	ut_con_fov;

U0 UTWeapFillDef(I64 id, U8 *name, U8 *cls, I64 ammo_max, I64 ammo_start,
	F64 dmg, F64 alt_dmg, F64 refire, F64 alt_refire, Bool proj,
	Bool alt_proj, F64 speed, F64 splash, I64 inv_group)
{
	CUTWeapDef *d;

	d = &ut_weap_def[id];
	MemSet(d, 0, sizeof(CUTWeapDef));
	StrPrint(d->name, "%s", name);
	StrPrint(d->cls_name, "%s", cls);
	d->ammo_max = ammo_max;
	d->ammo_start = ammo_start;
	d->damage = dmg;
	d->alt_damage = alt_dmg;
	d->refire = refire;
	d->alt_refire = alt_refire;
	d->projectile = proj;
	d->alt_projectile = alt_proj;
	d->proj_speed = speed;
	d->splash = splash;
	d->snd_slot = -1;
	d->inv_group = inv_group;
	d->view_scale = 1.0;
}

U0 UTWeapApplyBag(I64 id, CUTPropBag *bag)
{
	CUTWeapDef *d;

	if (id < 0 || id >= UT_WEAP_N || !bag)
		return;
	d = &ut_weap_def[id];
	if (bag->hit_damage > 0.0)
		d->damage = bag->hit_damage;
	if (bag->projectile_speed > 0.0)
		d->proj_speed = bag->projectile_speed;
	if (bag->max_ammo > 0)
		d->ammo_max = bag->max_ammo;
	if (bag->ammo_amount > 0.0)
		d->ammo_start = ToI64(bag->ammo_amount);
	if (bag->view_mesh[0])
		StrPrint(d->view_mesh, "%s", bag->view_mesh);
	if (bag->view_offset[0] != 0.0 || bag->view_offset[1] != 0.0 ||
		bag->view_offset[2] != 0.0)
		UTVecCopy(bag->view_offset, d->view_offset);
	if (bag->view_scale > 0.0)
		d->view_scale = bag->view_scale;
	if (bag->fire_snd[0])
		StrPrint(d->fire_snd, "%s", bag->fire_snd);
	if (bag->altfire_snd[0])
		StrPrint(d->altfire_snd, "%s", bag->altfire_snd);
	if (bag->select_snd[0])
		StrPrint(d->select_snd, "%s", bag->select_snd);
	if (bag->pickup_snd[0])
		StrPrint(d->pickup_snd, "%s", bag->pickup_snd);
}

U0 UTWeapPlayFireSnd(I64 id, Bool alt)
{//Weapon.FireSound / AltFireSound. Falls back to the shared click only when
 //the class defaults carried no name.
	CUTWeapDef *d;

	if (id < 0 || id >= UT_WEAP_N)
		return;
	d = &ut_weap_def[id];
	if (alt && d->altfire_snd[0])
	{
		UTSndPlayObj(d->altfire_snd, 1.0);
		return;
	}
	if (d->fire_snd[0])
	{
		UTSndPlayObj(d->fire_snd, 1.0);
		return;
	}
	if (ut_snd_fire_i >= 0)
		UTSndPlay(ut_snd_fire_i, 1.0);
}

U0 UTWeapLoadPkgDefaults()
{//Class default properties: HitDamage/MaxAmmo/ProjectileSpeed and the sound
 //names. A Class export carries ClassIndex 0, so UTPkgFindExport(pkg,"Class",
 //..) never matches and this overlay never applies; defaults also trail the
 //script, so the bag must come from UTPropLoadClassDefaults.
 //Weapon classes split across packages: the UT ones are Botpack, the
 //Unreal-inherited ones (Enforcer, ImpactHammer) are UnrealShare.
	CUTPropBag bag;
	I64 i;
	I64 hit;

	hit = 0;
	i = 0;
	while (i < UT_WEAP_N)
	{
		if (ut_weap_def[i].cls_name[0])
		{
			if (UTPropLoadClassDefaults("::/Apps/UT99/System/Botpack.u",
				ut_weap_def[i].cls_name, &bag))
			{
				UTWeapApplyBag(i, &bag);
				hit++;
			}
			else if (UTPropLoadClassDefaults(
				"::/Apps/UT99/System/UnrealShare.u",
				ut_weap_def[i].cls_name, &bag))
			{
				UTWeapApplyBag(i, &bag);
				hit++;
			}
		}
		i++;
	}
	UTLog("UTWeap: class defaults applied %d/%d\n", hit, UT_WEAP_N);
}

U0 UTWeapInitDefs()
{//retail Botpack defaults; package HitDamage/MaxAmmo overlay when present.
 //inv_group = Inventory.InventoryGroup (ChallengeHUD weapon slots).
	UTWeapFillDef(UT_WEAP_HAMMER, "ImpactHammer", "ImpactHammer",
		0, 0, 60, 20, 0.4, 0.2, FALSE, FALSE, 0, 0, 1);
	UTWeapFillDef(UT_WEAP_ENFORCER, "Enforcer", "Enforcer",
		199, 50, 17, 17, 0.2, 0.12, FALSE, FALSE, 0, 0, 2);
	UTWeapFillDef(UT_WEAP_BIO, "BioRifle", "UT_BioRifle",
		100, 30, 20, 40, 0.25, 0.9, TRUE, TRUE, 800, 80, 3);
	UTWeapFillDef(UT_WEAP_SHOCK, "ShockRifle", "ShockRifle",
		50, 40, 40, 55, 0.4, 0.7, FALSE, TRUE, 1000, 0, 4);
	UTWeapFillDef(UT_WEAP_PULSE, "PulseGun", "PulseGun",
		199, 60, 20, 15, 0.12, 0.05, TRUE, FALSE, 2000, 0, 5);
	UTWeapFillDef(UT_WEAP_RIPPER, "Ripper", "Ripper",
		75, 15, 30, 45, 0.35, 0.6, TRUE, TRUE, 1500, 0, 6);
	UTWeapFillDef(UT_WEAP_MINIGUN, "Minigun", "minigun2",
		199, 50, 10, 14, 0.05, 0.08, FALSE, FALSE, 0, 0, 7);
	UTWeapFillDef(UT_WEAP_FLAK, "FlakCannon", "UT_FlakCannon",
		50, 10, 18, 70, 0.75, 1.0, FALSE, TRUE, 900, 120, 8);
	UTWeapFillDef(UT_WEAP_ROCKET, "RocketLauncher", "UT_Eightball",
		48, 6, 75, 75, 0.9, 1.1, TRUE, TRUE, 900, 220, 9);
	UTWeapFillDef(UT_WEAP_SNIPER, "SniperRifle", "SniperRifle",
		50, 8, 70, 70, 1.0, 1.0, FALSE, FALSE, 0, 0, 10);
	UTWeapFillDef(UT_WEAP_TRANS, "Translocator", "Translocator",
		0, 0, 0, 0, 0.3, 0.2, TRUE, FALSE, 1200, 0, 0);
	UTWeapFillDef(UT_WEAP_REDEEMER, "Redeemer", "WarheadLauncher",
		1, 1, 1000, 1000, 1.5, 1.5, TRUE, TRUE, 600, 650, 10);
	UTWeapFillDef(UT_WEAP_SSHOT, "SuperShock", "SuperShockRifle",
		0, 0, 1000, 1000, 1.0, 1.0, FALSE, FALSE, 0, 0, 4);
	UTWeapLoadPkgDefaults;
}

U0 UTInvRebuildChain()
{//Pawn.Inventory: host weap list + full Inventory UObject slots.
	I64 i;
	I64 prev_w;
	I64 prev_o;
	I64 slot;
	CUTObj *o;
	U8 nm[48];

	ut_inv_head = -1;
	prev_w = -1;
	ut_obj_inv_head = -1;
	prev_o = -1;
	i = 0;
	while (i < UT_WEAP_N)
	{
		ut_inv_next[i] = -1;
		if (ut_weap_owned[i])
		{
			if (ut_inv_head < 0)
				ut_inv_head = i;
			if (prev_w >= 0)
				ut_inv_next[prev_w] = i;
			prev_w = i;

			slot = 0;
			while (slot < ut_obj_n)
			{
				if (ut_obj[slot].alive &&
					ut_obj[slot].kind == UT_OBJ_KIND_INVENTORY &&
					ut_obj[slot].weap_id == i)
					break;
				slot++;
			}
			if (slot >= ut_obj_n)
			{
				StrPrint(nm, "Inv_%s", ut_weap_def[i].cls_name);
				slot = UTObjNew(nm, ut_weap_def[i].cls_name,
					"::/Apps/UT99/System/Botpack.u");
				if (slot >= 0)
				{
					o = &ut_obj[slot];
					o->kind = UT_OBJ_KIND_INVENTORY;
					o->weap_id = i;
					o->inv_next = -1;
				}
			}
			if (slot >= 0 && slot < ut_obj_n)
			{
				ut_obj[slot].bag.ammo_amount = ToF64(ut_weap_ammo[i]);
				ut_obj[slot].bag.max_ammo = ut_weap_def[i].ammo_max;
				ut_obj[slot].inv_next = -1;
				if (ut_obj_inv_head < 0)
					ut_obj_inv_head = slot;
				if (prev_o >= 0)
					ut_obj[prev_o].inv_next = slot;
				prev_o = slot;
			}
		}
		i++;
	}
	UTLog("UTInv: weap_head=%d obj_head=%d\n", ut_inv_head, ut_obj_inv_head);
}

U0 UTWeapInit()
{
	I64 i;

	UTWeapInitDefs;
	i = 0;
	while (i < UT_WEAP_N)
	{
		ut_weap_owned[i] = FALSE;
		ut_weap_ammo[i] = 0;
		ut_inv_next[i] = -1;
		i++;
	}
	ut_weap_owned[UT_WEAP_SHOCK] = TRUE;
	ut_weap_ammo[UT_WEAP_SHOCK] = ut_weap_def[UT_WEAP_SHOCK].ammo_start;
	ut_weap_owned[UT_WEAP_ENFORCER] = TRUE;
	ut_weap_ammo[UT_WEAP_ENFORCER] = ut_weap_def[UT_WEAP_ENFORCER].ammo_start;
	ut_weap_owned[UT_WEAP_TRANS] = TRUE;
	ut_weap_owned[UT_WEAP_HAMMER] = TRUE;
	ut_weap_cur = UT_WEAP_SHOCK;
	ut_weap_next_fire = 0.0;
	ut_trans_disk = -1;
	ut_hammer_charge = 0.0;
	ut_hammer_charging = FALSE;
	ut_minigun_spin = 0.0;
	ut_sniper_zoom = FALSE;
	ut_redeemer_guided = FALSE;
	MemSet(ut_proj, 0, sizeof(ut_proj));
	UTInvRebuildChain;
	ut_weap_ready = TRUE;
	UTLog("UTWeap: init cur=%s inv_head=%d\n",
		ut_weap_def[ut_weap_cur].name, ut_inv_head);
}

U0 UTWeapGive(I64 id)
{
	if (id < 0 || id >= UT_WEAP_N)
		return;
	if (ut_mut_noredeem && id == UT_WEAP_REDEEMER)
		return;
	if (ut_mut_arena && id != UT_WEAP_SHOCK && id != UT_WEAP_SSHOT)
		return;
	ut_weap_owned[id] = TRUE;
	ut_weap_ammo[id] += ut_weap_def[id].ammo_start;
	if (ut_weap_ammo[id] > ut_weap_def[id].ammo_max &&
		ut_weap_def[id].ammo_max > 0)
		ut_weap_ammo[id] = ut_weap_def[id].ammo_max;
	ut_weap_cur = id;
	UTInvRebuildChain;
	UTLog("UTWeap: give %s ammo=%d\n", ut_weap_def[id].name, ut_weap_ammo[id]);
}

U0 UTWeapGiveAll()
{
	I64 i;

	i = 0;
	while (i < UT_WEAP_N)
	{
		ut_weap_owned[i] = TRUE;
		ut_weap_ammo[i] = ut_weap_def[i].ammo_max;
		if (ut_weap_ammo[i] < ut_weap_def[i].ammo_start)
			ut_weap_ammo[i] = ut_weap_def[i].ammo_start;
		i++;
	}
	UTInvRebuildChain;
	UTLog("UTWeap: give all\n");
}

I64 UTInvExecGive(I64 id)
{//Inventory Touch/Pickup/GiveTo Exec chain + host Give.
	I64 steps;
	CUTPropBag *bag;

	if (id < 0 || id >= UT_WEAP_N)
		return 0;
	UTWeapGive(id);
	steps = 0;
	bag = NULL;
	if (ut_obj_pawn >= 0)
	{
		bag = &ut_obj[ut_obj_pawn].bag;
		bag->ammo_amount = ToF64(ut_weap_ammo[ut_weap_cur]);
		bag->max_ammo = ut_weap_def[ut_weap_cur].ammo_max;
		bag->health = ut_health;
		UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Touch");
		UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Pickup");
		UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "GiveTo");
		UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "AddInventory");
		UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Pickup");
		steps = UTVMCallSelf("Touch", ut_obj_pawn, bag, 64);
		if (steps < 1)
			steps = UTVMCallSelf("Pickup", ut_obj_pawn, bag, 64);
		if (steps < 1)
			steps = UTVMCallSelf("GiveTo", ut_obj_pawn, bag, 64);
		if (steps < 1)
			steps = UTVMCallSelf("AddInventory", ut_obj_pawn, bag, 32);
	}
	UTLog("UTInv: Give %s group=%d exec_steps=%d\n",
		ut_weap_def[id].name, ut_weap_def[id].inv_group, steps);
	return steps;
}

I64 UTWeapIdForInvGroup(I64 group)
{
	I64 i;

	i = 0;
	while (i < UT_WEAP_N)
	{
		if (ut_weap_owned[i] && ut_weap_def[i].inv_group == group)
			return i;
		i++;
	}
	return -1;
}

U0 UTWeapSelect(I64 id)
{
	if (id < 0 || id >= UT_WEAP_N)
		return;
	if (ut_weap_owned[id])
	{
		ut_weap_cur = id;
		ut_weap_name_until = tS + 1.6;
		if (ut_weap_def[id].select_snd[0])
			UTSndPlayObj(ut_weap_def[id].select_snd, 1.0);
	}
}

U0 UTWeapCycle(I64 dir)
{
	I64 i;
	I64 n;

	n = 0;
	i = ut_weap_cur;
	while (n < UT_WEAP_N)
	{
		i += dir;
		if (i < 0)
			i = UT_WEAP_N - 1;
		if (i >= UT_WEAP_N)
			i = 0;
		if (ut_weap_owned[i])
		{
			ut_weap_cur = i;
			ut_weap_name_until = tS + 1.6;
			if (ut_weap_def[i].select_snd[0])
				UTSndPlayObj(ut_weap_def[i].select_snd, 1.0);
			return;
		}
		n++;
	}
}

I64 UTWeapIdFromClass(U8 *cls)
{
	if (!cls)
		return -1;
	if (!StrCompare(cls, "ImpactHammer") || !StrCompare(cls, "Hammer"))
		return UT_WEAP_HAMMER;
	if (!StrCompare(cls, "Enforcer") || !StrCompare(cls, "DoubleEnforcer"))
		return UT_WEAP_ENFORCER;
	if (!StrCompare(cls, "UT_BioRifle") || !StrCompare(cls, "BioRifle"))
		return UT_WEAP_BIO;
	if (!StrCompare(cls, "ShockRifle"))
		return UT_WEAP_SHOCK;
	if (!StrCompare(cls, "PulseGun"))
		return UT_WEAP_PULSE;
	if (!StrCompare(cls, "Ripper"))
		return UT_WEAP_RIPPER;
	if (!StrCompare(cls, "Minigun"))
		return UT_WEAP_MINIGUN;
	if (!StrCompare(cls, "FlakCannon"))
		return UT_WEAP_FLAK;
	if (!StrCompare(cls, "RocketLauncher") || !StrCompare(cls, "UT_Eightball"))
		return UT_WEAP_ROCKET;
	if (!StrCompare(cls, "SniperRifle"))
		return UT_WEAP_SNIPER;
	if (!StrCompare(cls, "Translocator"))
		return UT_WEAP_TRANS;
	if (!StrCompare(cls, "WarheadLauncher") || !StrCompare(cls, "Redeemer"))
		return UT_WEAP_REDEEMER;
	if (!StrCompare(cls, "SuperShockRifle"))
		return UT_WEAP_SSHOT;
	return -1;
}

I64 UTWeapSpawnProjEx(F64 *org, F64 *dir, F64 speed, F64 damage, I64 weap,
	I64 kind, F64 splash)
{
	I64 i;
	CUTProj *p;

	i = 0;
	while (i < UT_PROJ_MAX)
	{
		if (!ut_proj[i].alive)
		{
			p = &ut_proj[i];
			UTVecCopy(org, p->origin);
			p->vel[0] = dir[0] * speed;
			p->vel[1] = dir[1] * speed;
			p->vel[2] = dir[2] * speed;
			p->damage = damage;
			p->splash = splash;
			p->life = 4.0;
			if (kind == UT_PROJ_TRANS)
				p->life = 30.0;
			if (kind == UT_PROJ_REDEEMER)
				p->life = 8.0;
			p->alive = TRUE;
			p->owner_weap = weap;
			p->kind = kind;
			p->bounces = 0;
			if (kind == UT_PROJ_RIPPER)
				p->bounces = 2;
			return i;
		}
		i++;
	}
	return -1;
}

I64 UTWeapSpawnProj(F64 *org, F64 *dir, F64 speed, F64 damage, I64 weap)
{
	F64 splash;

	splash = ut_weap_def[weap].splash;
	return UTWeapSpawnProjEx(org, dir, speed, damage, weap, UT_PROJ_NORMAL,
		splash);
}

extern U0 UTGameHitScan(F64 *origin, F64 *dir, F64 damage, F64 range);
extern U0 UTGameRadiusDamage(F64 *origin, F64 damage, F64 radius);

U0 UTWeapBeamFrom(F64 *eye, F64 *dir, F64 range, I64 col)
{//SoftDrv TraceFire beam stand-in.
	F64 hit[3];
	F64 end[3];
	F64 hd;
	F64 nd[3];
	F64 len;

	if (!eye || !dir || !ut_opt_beams)
		return;
	UTVecCopy(dir, nd);
	len = UTVecLength(nd);
	if (len < UT_SMALL_NUMBER)
		return;
	nd[0] /= len; nd[1] /= len; nd[2] /= len;
	hd = range;
	if (ut_bsp && UTPhysTrace(ut_bsp, eye, nd, range, hit, &hd))
		UTDrawBeamSet(eye, hit, col, 0.08);
	else
	{
		end[0] = eye[0] + nd[0] * range;
		end[1] = eye[1] + nd[1] * range;
		end[2] = eye[2] + nd[2] * range;
		UTDrawBeamSet(eye, end, col, 0.06);
	}
}

Bool ut_script_weapons = FALSE;	//S8 opt-in: run Botpack Fire/AltFire script

Bool UTWeapFireScript(Bool alt)
{//Run the weapon's own Botpack Fire/AltFire. Returns FALSE when there is no
 //object, no bytecode, or the script did nothing; the caller then falls back
 //to the native path.
	I64 obj;
	I64 steps;

	if (!ut_script_weapons)
		return FALSE;
	obj = UTObjFindByWeapId(ut_weap_cur);
	if (obj < 0)
		return FALSE;
	ut_vm_cmd = UT_VM_CMD_NONE;
	if (alt)
		steps = UTVMCallSelf("AltFire", obj, UTObjBagForSlot(obj), 4096);
	else
		steps = UTVMCallSelf("Fire", obj, UTObjBagForSlot(obj), 4096);
	if (steps < 1)
		return FALSE;
	//ZealC has no ternary operator.
	if (alt)
		UTLog("UTWeap: script AltFire obj=%d steps=%d cmd=%d\n",
			obj, steps, ut_vm_cmd);
	else
		UTLog("UTWeap: script Fire obj=%d steps=%d cmd=%d\n",
			obj, steps, ut_vm_cmd);
	return TRUE;
}

U0 UTWeapFire(Bool alt)
{//Botpack Fire / AltFire SoftDrv path. VM TraceFire/Fire when bytecode cached.
	CUTWeapDef *d;
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	F64 eye[3];
	F64 dmg;
	F64 rate;
	F64 speed;
	I64 i;
	I64 kind;
	Bool do_proj;

	//S8: retail script first, native reimplementation as fallback.
	if (UTWeapFireScript(alt))
		return;

	if (tS < ut_weap_next_fire)
		return;
	d = &ut_weap_def[ut_weap_cur];

	//ImpactHammer: hold fire charges; release (not held) dumps melee TraceFire
	if (ut_weap_cur == UT_WEAP_HAMMER)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		UTVecCopy(ut_origin, eye);
		eye[2] += 20.0;
		if (ut_fire_held || alt)
		{
			ut_hammer_charging = TRUE;
			ut_hammer_charge += 0.05;
			if (ut_hammer_charge > 1.0)
				ut_hammer_charge = 1.0;
			ut_weap_next_fire = tS + 0.05;
			return;
		}
		if (ut_hammer_charging)
		{
			dmg = d->damage * (0.35 + ut_hammer_charge * 1.65);
			ut_hammer_charge = 0.0;
			ut_hammer_charging = FALSE;
			ut_weap_next_fire = tS + d->refire;
			UTWeapPlayFireSnd(ut_weap_cur, alt);
			UTGameHitScan(eye, fwd, dmg, 180.0);
			return;
		}
		//tap fire
		ut_weap_next_fire = tS + d->refire;
		UTGameHitScan(eye, fwd, d->damage * 0.5, 140.0);
		return;
	}

	//Translocator alt: teleport to disk (reject solid)
	if (ut_weap_cur == UT_WEAP_TRANS && alt)
	{
		if (ut_trans_disk >= 0 && ut_trans_disk < UT_PROJ_MAX &&
			ut_proj[ut_trans_disk].alive &&
			ut_proj[ut_trans_disk].kind == UT_PROJ_TRANS)
		{
			UTVecCopy(ut_proj[ut_trans_disk].origin, eye);
			eye[2] += 20.0;
			if (ut_bsp == NULL || !UTBspPointSolid(ut_bsp, eye))
			{
				UTVecCopy(eye, ut_origin);
				ut_proj[ut_trans_disk].alive = FALSE;
				ut_trans_disk = -1;
			}
			ut_weap_next_fire = tS + d->alt_refire;
			return;
		}
		ut_weap_next_fire = tS + 0.15;
		return;
	}

	//SniperRifle AltFire: FOV zoom (Botpack Zoom)
	if (ut_weap_cur == UT_WEAP_SNIPER && alt)
	{
		if (!ut_sniper_zoom)
		{
			ut_sniper_fov_saved = ut_con_fov;
			ut_con_fov = 20.0;
			ut_sniper_zoom = TRUE;
		}
		else
		{
			ut_con_fov = ut_sniper_fov_saved;
			if (ut_con_fov < 60.0)
				ut_con_fov = 90.0;
			ut_sniper_zoom = FALSE;
		}
		ut_weap_next_fire = tS + 0.25;
		return;
	}

	if (d->ammo_max > 0 && ut_weap_ammo[ut_weap_cur] <= 0)
		return;

	ut_weap_alt = alt;
	if (alt)
	{
		dmg = d->alt_damage;
		if (dmg <= 0.0)
			dmg = d->damage * 1.5;
		rate = d->alt_refire;
		if (rate <= 0.0)
			rate = d->refire * 1.5;
	}
	else
	{
		dmg = d->damage;
		rate = d->refire;
	}
	//Minigun: spin-up slows first shots (Botpack Minigun)
	if (ut_weap_cur == UT_WEAP_MINIGUN)
	{
		ut_minigun_spin += 0.12;
		if (ut_minigun_spin > 1.0)
			ut_minigun_spin = 1.0;
		rate = d->refire * (2.2 - ut_minigun_spin * 1.4);
		if (alt)
			rate = d->alt_refire * (2.0 - ut_minigun_spin * 1.2);
	}
	ut_weap_next_fire = tS + rate;
	if (d->ammo_max > 0)
		ut_weap_ammo[ut_weap_cur]--;

	if (UTVMFnFind("TraceFire") >= 0)
		UTVMCall("TraceFire", 256);
	else if (UTVMFnFind("Fire") >= 0)
		UTVMCall("Fire", 256);
	//Inventory weapon Fire Exec (Pawn.Inventory chain slot for cur weap)
	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && ut_obj[i].kind == UT_OBJ_KIND_INVENTORY &&
			ut_obj[i].weap_id == ut_weap_cur)
		{
			if (alt)
			{
				UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "AltFire");
				UTVMCallSelf("AltFire", i, &ut_obj[i].bag, 64);
			}
			else
			{
				UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Fire");
				UTVMCallSelf("Fire", i, &ut_obj[i].bag, 64);
			}
			break;
		}
		i++;
	}
	ut_vm_cmd = UT_VM_CMD_NONE;

	UTWeapPlayFireSnd(ut_weap_cur, alt);

	UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
	UTVecCopy(ut_origin, eye);
	eye[2] += 20.0;
	UTFxMuzzle(eye, fwd);

	do_proj = FALSE;
	if (alt)
		do_proj = d->alt_projectile;
	else
		do_proj = d->projectile;

	if (ut_weap_cur == UT_WEAP_FLAK && !alt)
	{
		i = 0;
		while (i < 7)
		{
			fwd[0] = fwd[0] + right[0] * (ToF64(i) - 3.0) * 0.04;
			fwd[1] = fwd[1] + right[1] * (ToF64(i) - 3.0) * 0.04;
			UTVecNormalize(fwd);
			UTGameHitScan(eye, fwd, dmg, 2048.0);
			i++;
		}
		return;
	}

	//ShockRifle primary: combo with live shock ball (Botpack combo)
	if (ut_weap_cur == UT_WEAP_SHOCK && !alt)
	{
		i = 0;
		while (i < UT_PROJ_MAX)
		{
			if (ut_proj[i].alive && ut_proj[i].owner_weap == UT_WEAP_SHOCK)
			{
				UTDrawBeamSet(eye, ut_proj[i].origin, 211, 0.2);
				UTGameRadiusDamage(ut_proj[i].origin, 165.0, 220.0);
				UTDecalScorch(ut_proj[i].origin);
				UTFxBurst(ut_proj[i].origin, 14, 211);
				ut_proj[i].alive = FALSE;
				ut_weap_next_fire = tS + 0.55;
				return;
			}
			i++;
		}
	}

	if (ut_weap_cur == UT_WEAP_TRANS)
	{
		kind = UT_PROJ_TRANS;
		if (ut_trans_disk >= 0 && ut_trans_disk < UT_PROJ_MAX)
			ut_proj[ut_trans_disk].alive = FALSE;
		i = UTWeapSpawnProjEx(eye, fwd, d->proj_speed, 0, UT_WEAP_TRANS,
			kind, 0);
		if (i >= 0)
			ut_trans_disk = i;
		return;
	}

	if (do_proj)
	{
		speed = d->proj_speed;
		kind = UT_PROJ_NORMAL;
		if (ut_weap_cur == UT_WEAP_REDEEMER)
		{
			kind = UT_PROJ_REDEEMER;
			ut_redeemer_guided = alt;
		}
		if (ut_weap_cur == UT_WEAP_RIPPER)
			kind = UT_PROJ_RIPPER;
		//BioRifle alt: bigger splash goo
		if (ut_weap_cur == UT_WEAP_BIO && alt)
			UTWeapSpawnProjEx(eye, fwd, speed * 0.55, dmg, ut_weap_cur,
				kind, d->splash * 1.8);
		else
			UTWeapSpawnProjEx(eye, fwd, speed, dmg, ut_weap_cur, kind,
				d->splash);
		return;
	}

	//PulseGun alt: continuous beam (Ammo-draining TraceFire)
	if (ut_weap_cur == UT_WEAP_PULSE && alt)
	{
		UTGameHitScan(eye, fwd, dmg, 4096.0);
		UTWeapBeamFrom(eye, fwd, 4096.0, 211);
		return;
	}

	UTGameHitScan(eye, fwd, dmg, 8192.0);
	if (ut_weap_cur == UT_WEAP_SHOCK || ut_weap_cur == UT_WEAP_ENFORCER ||
		ut_weap_cur == UT_WEAP_MINIGUN || ut_weap_cur == UT_WEAP_SNIPER ||
		ut_weap_cur == UT_WEAP_PULSE)
		UTWeapBeamFrom(eye, fwd, 8192.0, 230);
}

U0 UTWeapTickSpecials()
{//ImpactHammer discharge; Minigun spin-down; Pulse beam; Redeemer guide.
	I64 i;
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	F64 speed;

	if (ut_weap_cur == UT_WEAP_HAMMER && ut_hammer_charging &&
		!ut_fire_held && !ut_alt_fire)
		UTWeapFire(FALSE);
	if (ut_weap_cur != UT_WEAP_MINIGUN || (!ut_fire_held && !ut_alt_fire))
	{
		ut_minigun_spin -= 0.04;
		if (ut_minigun_spin < 0.0)
			ut_minigun_spin = 0.0;
	}
	if (ut_weap_cur == UT_WEAP_PULSE && ut_alt_fire &&
		ut_weap_ammo[UT_WEAP_PULSE] > 0)
		UTWeapFire(TRUE);
	if (ut_weap_cur != UT_WEAP_SNIPER && ut_sniper_zoom)
	{
		ut_con_fov = ut_sniper_fov_saved;
		if (ut_con_fov < 60.0)
			ut_con_fov = 90.0;
		ut_sniper_zoom = FALSE;
	}
	if (ut_redeemer_guided)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		i = 0;
		while (i < UT_PROJ_MAX)
		{
			if (ut_proj[i].alive && ut_proj[i].kind == UT_PROJ_REDEEMER)
			{
				speed = Sqrt(ut_proj[i].vel[0] * ut_proj[i].vel[0] +
					ut_proj[i].vel[1] * ut_proj[i].vel[1] +
					ut_proj[i].vel[2] * ut_proj[i].vel[2]);
				if (speed < 1.0)
					speed = ut_weap_def[UT_WEAP_REDEEMER].proj_speed;
				ut_proj[i].vel[0] = fwd[0] * speed;
				ut_proj[i].vel[1] = fwd[1] * speed;
				ut_proj[i].vel[2] = fwd[2] * speed;
			}
			i++;
		}
	}
}

U0 UTWeapTickProjs(F64 dt)
{
	I64 i;
	CUTProj *p;
	F64 next[3];
	F64 rad;

	i = 0;
	while (i < UT_PROJ_MAX)
	{
		p = &ut_proj[i];
		if (p->alive)
		{
			next[0] = p->origin[0] + p->vel[0] * dt;
			next[1] = p->origin[1] + p->vel[1] * dt;
			next[2] = p->origin[2] + p->vel[2] * dt;
			//SoftDrv smoke trail on rockets / redeemer / bio
			if (p->kind != UT_PROJ_TRANS &&
				(p->owner_weap == UT_WEAP_ROCKET ||
				 p->owner_weap == UT_WEAP_REDEEMER ||
				 p->owner_weap == UT_WEAP_BIO ||
				 p->kind == UT_PROJ_REDEEMER))
			{
				if ((ToI64(tS * 20.0) & 1) == 0)
					UTFxSpawn(p->origin, NULL, 0.35, 5.0, 40);
			}
			if (ut_bsp != NULL && UTBspPointSolid(ut_bsp, next))
			{
				if (p->kind == UT_PROJ_TRANS)
				{
					UTVecCopy(p->origin, next);
					p->vel[0] = 0; p->vel[1] = 0; p->vel[2] = 0;
				}
				else if (p->kind == UT_PROJ_RIPPER && p->bounces > 0)
				{
					//SoftDrv Ripper blade bounce
					p->bounces--;
					p->vel[0] = -p->vel[0];
					p->vel[1] = -p->vel[1];
					p->origin[0] += p->vel[0] * dt;
					p->origin[1] += p->vel[1] * dt;
					UTFxSpawn(p->origin, NULL, 0.15, 4.0, 180);
				}
				else
				{
					rad = p->splash;
					if (rad < 1.0)
						rad = 180.0;
					UTGameRadiusDamage(p->origin, p->damage, rad);
					UTDecalScorch(p->origin);
					p->alive = FALSE;
					if (ut_trans_disk == i)
						ut_trans_disk = -1;
					if (p->kind == UT_PROJ_REDEEMER)
					{
						ut_redeemer_guided = FALSE;
						UTSoftDamageFlash(120.0);
						UTFxBurst(p->origin, 24, 230);
						UTMsgCenter("NUCLEAR LAUNCH DETECTED");
					}
				}
			}
			else
			{
				UTVecCopy(next, p->origin);
				p->life -= dt;
				if (p->life <= 0.0)
				{
					p->alive = FALSE;
					if (ut_trans_disk == i)
						ut_trans_disk = -1;
				}
				else if (p->kind != UT_PROJ_TRANS && p->damage > 0.0)
					UTGameHitScan(p->origin, p->vel, p->damage * 0.02, 80.0);
			}
		}
		i++;
	}
}

U0 UTWeapDrawProjs(CUTCanvas *c)
{
	I64 i;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 sx;
	F64 sy;
	F64 iz;
	F64 left;
	CUTProj *p;
	I64 col;

	if (!c)
		return;
	i = 0;
	while (i < UT_PROJ_MAX)
	{
		p = &ut_proj[i];
		if (p->alive)
		{
			if (p->kind == UT_PROJ_TRANS)
			{
				col = 180;
				left = 8.0 + Sin(tS * 8.0) * 3.0;
				a[0] = p->origin[0] - left; a[1] = p->origin[1] - left;
				a[2] = p->origin[2];
				b[0] = p->origin[0] + left; b[1] = p->origin[1] - left;
				b[2] = p->origin[2];
				cc[0] = p->origin[0]; cc[1] = p->origin[1] + left;
				cc[2] = p->origin[2] + left + 4.0;
				UTDrawTri3(c, a, b, cc, col);
				if (ut_win_ready && UTDrawProject(c, p->origin, &sx, &sy, &iz) &&
					iz > 0.0)
					UTWinTextAt(ToI64(sx) - 8, ToI64(sy) - 10, "TL",
						ut_col_sel);
			}
			else
			{
				col = 230;
				if (p->kind == UT_PROJ_REDEEMER)
					col = 40;
				a[0] = p->origin[0] - 6; a[1] = p->origin[1]; a[2] = p->origin[2];
				b[0] = p->origin[0] + 6; b[1] = p->origin[1]; b[2] = p->origin[2];
				cc[0] = p->origin[0]; cc[1] = p->origin[1];
				cc[2] = p->origin[2] + 8;
				UTDrawTri3(c, a, b, cc, col);
			}
		}
		i++;
	}
}

U0 UTWeapDrawView(CUTCanvas *c)
{//LodMesh weapon at eye offset, else screen wedge.
	I64 x;
	I64 y;
	I64 col;
	I64 x0;
	I64 x1;
	F64 eye[3];
	F64 fwd[3];
	F64 right[3];
	F64 up[3];

	if (!c)
		return;
	if (ut_lod_weapon.loaded)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		UTVecCopy(ut_origin, eye);
		eye[0] += fwd[0] * 40.0 + right[0] * 18.0 - up[0] * 12.0;
		eye[1] += fwd[1] * 40.0 + right[1] * 18.0 - up[1] * 12.0;
		eye[2] += fwd[2] * 40.0 + right[2] * 18.0 - up[2] * 12.0;
		UTVecCopy(eye, ut_lod_weapon.draw_origin);
		ut_lod_weapon.draw_yaw = ut_view_yaw & 0xFFFF;
		UTLodDraw(c, &ut_lod_weapon, 200);
		return;
	}
	col = 40 + ut_weap_cur * 14;
	if (col > 250)
		col = 250;
	y = c->height - 70;
	while (y < c->height - 8)
	{
		x0 = c->width - 90 + (y - (c->height - 70)) / 3;
		x1 = c->width - 18;
		if (x0 < 0)
			x0 = 0;
		if (x1 > c->width)
			x1 = c->width;
		x = x0;
		while (x < x1)
		{
			c->pixels[y * c->width + x] = col;
			x++;
		}
		y++;
	}
}
