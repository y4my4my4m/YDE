// UTMap.ZC - load retail .unr: Model1 BSP + PlayerStart camera + surf tex bind.
//
// Package tables + UModel native + property scan for spawn. UTLink resolves .utx.

#define UT_MAP_CAT_MAX		128
#define UT_MAP_MODE_DM		0
#define UT_MAP_MODE_CTF		1
#define UT_MAP_MODE_DOM		2
#define UT_MAP_MODE_AS		3

class CUTMapCat
{
	U8	 name[80];
	I64	 mode;
};

CUTPackage	*ut_map_pkg	= NULL;
Bool		 ut_map_loaded	= FALSE;
U8			 ut_map_name[64];
U8			 ut_map_loaded_name[64];
F64			 ut_spawn[3];
I64			 ut_spawn_yaw	= 0;
I64			 ut_spawn_pitch	= 0;
#define UT_START_MAX		24
F64			 ut_starts[UT_START_MAX * 3];
I64			 ut_start_yaw[UT_START_MAX];
I64			 ut_start_n		= 0;
F64			 ut_map_z_min	= -1.0e6;
F64			 ut_map_z_max	= 1.0e6;
F64			 ut_map_xy_min[2];
F64			 ut_map_xy_max[2];
CUTMapCat	ut_map_cat[UT_MAP_CAT_MAX];
I64			ut_map_cat_n		= 0;
I64			ut_map_cat_i		= 0;
Bool		ut_map_cat_ready	= FALSE;
I64			ut_map_filter		= -1;	//-1 all, else UT_MAP_MODE_*

Bool UTMapFindPlayerStart(CUTPackage *pkg, F64 *loc, I64 *pitch, I64 *yaw)
{
	I64 i;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	I64 p;
	I64 y;
	I64 r;

	ut_start_n = 0;
	if (!pkg)
		return FALSE;
	i = 0;
	while (i < pkg->export_count)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		if (!StrCompare(cls, "PlayerStart") ||
			!StrCompare(cls, "PlayerStart_Trophy"))
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				if (ut_start_n < UT_START_MAX)
				{
					ut_starts[ut_start_n * 3] = v[0];
					ut_starts[ut_start_n * 3 + 1] = v[1];
					ut_starts[ut_start_n * 3 + 2] = v[2];
					ut_start_yaw[ut_start_n] = 0;
					if (UTPropFindStructRot(pkg, e->serial_offset,
						e->serial_size, "Rotation", &p, &y, &r))
						ut_start_yaw[ut_start_n] = y;
					ut_start_n++;
				}
				if (ut_start_n == 1)
				{
					UTVecCopy(v, loc);
					*pitch = 0;
					*yaw = 0;
					if (UTPropFindStructRot(pkg, e->serial_offset,
						e->serial_size, "Rotation", &p, &y, &r))
					{
						*pitch = p;
						*yaw = y;
					}
				}
			}
		}
		i++;
	}
	if (ut_start_n > 0)
	{
		UTLog("UTMap: PlayerStarts=%d\n", ut_start_n);
		return TRUE;
	}
	return FALSE;
}

Bool UTMapLoad(U8 *path)
{//load .unr → Model1 into ut_bsp, place camera at first PlayerStart.
	I64 mi;
	CUTBsp *b;
	F64 mn[3];
	F64 mx[3];
	F64 fz;
	Bool fhit;
	I64 nfac;
	I64 zone;
	I64 i;

	if (ut_map_pkg != NULL)
	{
		UTPkgFree(ut_map_pkg);
		ut_map_pkg = NULL;
	}
	UTLinkFreeAll;
	ut_map_loaded = FALSE;
	ut_use_map = FALSE;
	StrPrint(ut_map_name, "");

	if (!path || !FileFind(path))
	{
		"UTMap: MISSING %s - sync retail Maps/ to guest\n", path;
		UTLog("UTMap: missing %s\n", path);
		return FALSE;
	}

	ut_map_pkg = UTPkgLoad(path);
	if (ut_map_pkg == NULL)
	{
		"UTMap: UTPkgLoad failed %s\n", path;
		UTLog("UTMap: UTPkgLoad failed %s\n", path);
		return FALSE;
	}

	mi = UTPkgFindExport(ut_map_pkg, "Model", "Model1");
	if (mi < 0)
		mi = UTPkgFindExportClass(ut_map_pkg, "Model");
	if (mi < 0)
	{
		"UTMap: no Model export in %s\n", path;
		UTLog("UTMap: no Model export in %s\n", path);
		UTPkgFree(ut_map_pkg);
		ut_map_pkg = NULL;
		return FALSE;
	}

	if (ut_bsp != NULL)
	{
		UTBspFree(ut_bsp);
		ut_bsp = NULL;
	}
	b = UTBspNew;
	if (!UTBspLoadModel(ut_map_pkg, mi, b))
	{
		"UTMap: Model1 decode FAILED %s\n", path;
		UTLog("UTMap: Model load failed\n");
		UTBspFree(b);
		UTPkgFree(ut_map_pkg);
		ut_map_pkg = NULL;
		return FALSE;
	}
	ut_bsp = b;

	if (b->num_surfs > 0)
	{
		b->surf_tex = CAlloc(b->num_surfs * sizeof(CUTTex *));
		UTLinkBindSurfs(ut_map_pkg, b, b->surf_tex);
		UTLog("UTMap: bound %d surf textures\n", b->num_surfs);
	}

	UTVecSet(ut_spawn, 0.0, 0.0, 128.0);
	ut_spawn_yaw = 0;
	ut_spawn_pitch = 0;
	if (UTMapFindPlayerStart(ut_map_pkg, ut_spawn, &ut_spawn_pitch,
		&ut_spawn_yaw))
	{
		UTLog("UTMap: PlayerStart %4.0f %4.0f %4.0f yaw=%d\n",
			ut_spawn[0], ut_spawn[1], ut_spawn[2], ut_spawn_yaw);
	}
	else
		UTLog("UTMap: no PlayerStart Location; origin fallback\n");

	UTBspProbeAABB(b, mn, mx, &nfac);
	ut_map_z_min = mn[2];
	ut_map_z_max = mx[2];
	ut_map_xy_min[0] = mn[0];
	ut_map_xy_min[1] = mn[1];
	ut_map_xy_max[0] = mx[0];
	ut_map_xy_max[1] = mx[1];
	fz = UTBspFloorZ(b, ut_spawn[0], ut_spawn[1], ut_spawn[2] + 120.0,
		&fhit);
	zone = UTBspPointZone(b, ut_spawn);
	UTLog("UTMap: AABB (%.0f,%.0f,%.0f)-(%.0f,%.0f,%.0f) facets=%d\n",
		mn[0], mn[1], mn[2], mx[0], mx[1], mx[2], nfac);
	UTLog("UTMap: spawn zone=%d floor_hit=%d floorZ=%.1f\n",
		zone, fhit, fz);
	"UTMap: spawn %.0f %.0f %.0f zone=%d floorZ=%.0f facets=%d\n",
		ut_spawn[0], ut_spawn[1], ut_spawn[2], zone, fz, nfac;
	if (fhit)
		ut_spawn[2] = fz + UT_PHYS_HEIGHT * 0.5;
	//if spawn still in solid, nudge up until open or give up
	if (UTBspPointSolid(b, ut_spawn))
	{
		ut_spawn[2] += 16.0;
		i = 0;
		while (i < 12 && UTBspPointSolid(b, ut_spawn))
		{
			ut_spawn[2] += 16.0;
			i++;
		}
		UTLog("UTMap: spawn nudged Z=%.0f solid=%d\n",
			ut_spawn[2], ToI64(UTBspPointSolid(b, ut_spawn)));
	}

	UTVecCopy(ut_spawn, ut_origin);
	ut_view_yaw = ut_spawn_yaw & 0xFFFF;
	ut_view_pitch = ut_spawn_pitch;
	ut_view_roll = 0;
	UTPhysInit;
	UTPhysSnapToFloor(b, ut_origin);
	UTVecCopy(ut_origin, ut_spawn);

	ut_map_loaded = TRUE;
	ut_use_map = TRUE;
	StrPrint(ut_map_name, "%s", path);
	"UTMap: ready %s nodes=%d eye=%.0f %.0f %.0f\n",
		path, ut_bsp->num_nodes, ut_origin[0], ut_origin[1], ut_origin[2];
	UTLog("UTMap: ready %s nodes=%d eye=%.0f %.0f %.0f\n",
		path, ut_bsp->num_nodes, ut_origin[0], ut_origin[1], ut_origin[2]);
	return TRUE;
}

Bool UTMapTryOne(U8 *name)
{//Boot preloads a map, then travel requests the same one. Reloading it
 //re-ran the whole texture bind and doubled load time.
	U8 path[256];

	if (ut_map_loaded && ut_bsp != NULL && name && name[0] &&
		!StrCompare(ut_map_loaded_name, name))
		return TRUE;
	StrPrint(path, "%s%s", UT99_MAPS_DIR, name);
	if (!UTMapLoad(path))
		return FALSE;
	StrPrint(ut_map_loaded_name, "%s", name);
	return TRUE;
}

I64 UTMapModeFromName(U8 *name)
{
	if (!name)
		return -1;
	if (name[0] == 'D' && name[1] == 'M' && name[2] == '-')
		return UT_MAP_MODE_DM;
	if (name[0] == 'C' && name[1] == 'T' && name[2] == 'F' && name[3] == '-')
		return UT_MAP_MODE_CTF;
	if (name[0] == 'D' && name[1] == 'O' && name[2] == 'M' && name[3] == '-')
		return UT_MAP_MODE_DOM;
	if (name[0] == 'A' && name[1] == 'S' && name[2] == '-')
		return UT_MAP_MODE_AS;
	return -1;
}

U0 UTMapBuildCatalog()
{//FilesFind Maps/*.unr — DM-/CTF-/DOM-/AS- prefixes.
	CDirEntry *de;
	CDirEntry *tmp;
	I64 mode;
	U8 *nm;

	if (ut_map_cat_ready)
		return;
	ut_map_cat_n = 0;
	de = FilesFind("::/Apps/UT99/Maps/*.unr", FUF_JUST_FILES);
	tmp = de;
	while (tmp && ut_map_cat_n < UT_MAP_CAT_MAX)
	{
		nm = tmp->name;
		mode = UTMapModeFromName(nm);
		if (mode >= 0)
		{
			StrPrint(ut_map_cat[ut_map_cat_n].name, "%s", nm);
			ut_map_cat[ut_map_cat_n].mode = mode;
			ut_map_cat_n++;
		}
		tmp = tmp->next;
	}
	DirTreeDel(de);
	ut_map_cat_ready = TRUE;
	ut_map_cat_i = 0;
	UTLog("UTMap: catalog %d maps\n", ut_map_cat_n);
}

I64 UTMapCatFindName(U8 *name)
{
	I64 i;

	i = 0;
	while (i < ut_map_cat_n)
	{
		if (!StrCompare(ut_map_cat[i].name, name))
			return i;
		i++;
	}
	return -1;
}

Bool UTMapLoadCatalogIndex(I64 i)
{
	if (i < 0 || i >= ut_map_cat_n)
		return FALSE;
	ut_map_cat_i = i;
	return UTMapTryOne(ut_map_cat[i].name);
}

Bool UTMapCycle(I64 delta)
{//walk catalog with optional mode filter.
	I64 tries;
	I64 idx;

	UTMapBuildCatalog;
	if (ut_map_cat_n < 1)
		return FALSE;
	if (delta == 0)
		delta = 1;
	tries = 0;
	idx = ut_map_cat_i;
	while (tries < ut_map_cat_n)
	{
		idx += delta;
		while (idx < 0)
			idx += ut_map_cat_n;
		while (idx >= ut_map_cat_n)
			idx -= ut_map_cat_n;
		if (ut_map_filter < 0 || ut_map_cat[idx].mode == ut_map_filter)
		{
			if (UTMapLoadCatalogIndex(idx))
				return TRUE;
		}
		tries++;
	}
	return FALSE;
}

U0 UTMapTryDefault()
{//prefer compact DM maps first. Demo only when retail Maps absent.
	U8 path[256];

	UTMapBuildCatalog;
	StrPrint(path, "%s%s", UT99_MAPS_DIR, "DM-Codex.unr");
	if (UTMapTryOne("DM-Codex.unr"))
	{
		ut_map_cat_i = UTMapCatFindName("DM-Codex.unr");
		if (ut_map_cat_i < 0)
			ut_map_cat_i = 0;
		return;
	}
	if (UTMapTryOne("DM-Oblivion.unr"))
		return;
	if (UTMapTryOne("DM-Morbias][.unr"))
		return;
	if (UTMapTryOne("DM-Deck16][.unr"))
		return;
	if (ut_map_cat_n > 0 && UTMapLoadCatalogIndex(0))
		return;

	if (ut_map_cat_n < 1 && !FileFind(path))
	{
		"UTMap: no retail Maps under %s - sync Maps/ then rebuild\n",
			UT99_MAPS_DIR;
		UTLog("UTMap: no retail map; demo room\n");
		StrPrint(ut_map_name, "demo (Maps missing)");
	}
	else
	{
		"UTMap: retail files present but EVERY load failed - see UTPkg/Model log\n";
		UTLog("UTMap: loads failed; demo room\n");
		StrPrint(ut_map_name, "demo (map load FAILED)");
	}
}

Bool UTMapSwitchSlot(I64 slot)
{//1=Codex 2=Oblivion 3=Deck16 4=Morbias favorites.
	Bool ok;
	U8 *nm;

	ok = FALSE;
	nm = NULL;
	if (slot == 1)
		nm = "DM-Codex.unr";
	else if (slot == 2)
		nm = "DM-Oblivion.unr";
	else if (slot == 3)
		nm = "DM-Deck16][.unr";
	else if (slot == 4)
		nm = "DM-Morbias][.unr";
	if (nm)
	{
		ok = UTMapTryOne(nm);
		if (ok)
		{
			UTMapBuildCatalog;
			ut_map_cat_i = UTMapCatFindName(nm);
			if (ut_map_cat_i < 0)
				ut_map_cat_i = 0;
		}
	}
	return ok;
}

U0 UTMapCollideMove(F64 *from, F64 *to)
{//legacy slide; prefer UTPhysIntegrate from UTGameTick.
	if (ut_bsp == NULL || !ut_use_map || ut_bsp->num_nodes < 8)
	{
		UTVecCopy(to, from);
		return;
	}
	UTPhysTryMove(ut_bsp, from, to);
}

U0 UTMapExit()
{
	if (ut_map_pkg != NULL)
	{
		UTPkgFree(ut_map_pkg);
		ut_map_pkg = NULL;
	}
	UTLinkFreeAll;
	ut_map_loaded = FALSE;
	ut_use_map = FALSE;
}
