// UTActor.ZC - map specials with property-bound KeyPos movers.
//
// AMover: KeyPos[8] relative to BasePos (EngineClasses.h). Interpolate
// KeyPos[0]→KeyPos[NumKeys-1] over MoveTime, then reverse.

#define UT_ACT_MAX			256
#define UT_ACT_MOVER		1
#define UT_ACT_TRIGGER		2
#define UT_ACT_TELEPORT		3
#define UT_ACT_WEAPON		4
#define UT_ACT_PICKUP		5
#define UT_ACT_KEYS			8

class CUTActor
{
	U8	 name[48];
	U8	 cls[48];
	I64	 kind;
	F64	 origin[3];
	F64	 base[3];
	F64	 keypos[UT_ACT_KEYS * 3];
	I64	 n_keys;
	F64	 move_time;
	F64	 yaw;
	Bool active;
	Bool taken;
	F64	 phase;
	F64	 speed;
	I64	 weap_id;
	F64	 amount;
	Bool opening;
};

CUTActor	ut_actors[UT_ACT_MAX];
I64			ut_actor_n	= 0;

U0 UTActorClear()
{
	ut_actor_n = 0;
}

I64 UTActorAdd(U8 *cls, U8 *name, F64 *loc, I64 kind)
{
	CUTActor *a;

	if (ut_actor_n >= UT_ACT_MAX || !loc)
		return -1;
	a = &ut_actors[ut_actor_n];
	MemSet(a, 0, sizeof(CUTActor));
	StrPrint(a->cls, "%s", cls);
	if (name)
		StrPrint(a->name, "%s", name);
	UTVecCopy(loc, a->origin);
	UTVecCopy(loc, a->base);
	a->kind = kind;
	a->active = TRUE;
	a->n_keys = 2;
	a->move_time = 1.0;
	a->opening = TRUE;
	//default KeyPos[0]=0 KeyPos[1]=up
	a->keypos[0] = 0; a->keypos[1] = 0; a->keypos[2] = 0;
	a->keypos[3] = 0; a->keypos[4] = 0; a->keypos[5] = 128.0;
	ut_actor_n++;
	return ut_actor_n - 1;
}

I64 UTActorKindFromClass(U8 *cls)
{
	if (!cls)
		return 0;
	if (!StrCompare(cls, "Mover") || !StrCompare(cls, "AssertMover") ||
		!StrCompare(cls, "MixMover") || !StrCompare(cls, "ElevatorMover"))
		return UT_ACT_MOVER;
	if (!StrCompare(cls, "Trigger") || !StrCompare(cls, "TriggerOpenTimed") ||
		!StrCompare(cls, "TriggerToggle") || !StrCompare(cls, "Counter") ||
		!StrCompare(cls, "Dispatcher"))
		return UT_ACT_TRIGGER;
	if (!StrCompare(cls, "Teleporter") || !StrCompare(cls, "VisibleTeleporter"))
		return UT_ACT_TELEPORT;
	if (!StrCompare(cls, "ShockRifle") || !StrCompare(cls, "PulseGun") ||
		!StrCompare(cls, "FlakCannon") || !StrCompare(cls, "UT_Eightball") ||
		!StrCompare(cls, "Minigun") || !StrCompare(cls, "Minigun2") ||
		!StrCompare(cls, "Ripper") || !StrCompare(cls, "SniperRifle") ||
		!StrCompare(cls, "BioRifle") || !StrCompare(cls, "ImpactHammer") ||
		!StrCompare(cls, "enforcer") || !StrCompare(cls, "SuperShockRifle"))
		return UT_ACT_WEAPON;
	return 0;
}

U0 UTActorBindMover(CUTPackage *pkg, CUTExport *e, CUTActor *a)
{
	I64 n;
	F64 mt;
	F64 base[3];
	F64 *kp;

	kp = a->keypos;
	n = 0;
	mt = 1.0;
	if (UTPropFindKeyPos(pkg, e->serial_offset, e->serial_size,
		e->object_flags, kp, 3, &n, &mt))
	{
		a->n_keys = n;
		a->move_time = mt;
		if (a->move_time < 0.05)
			a->move_time = 0.05;
	}
	if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
		"BasePos", base))
		UTVecCopy(base, a->base);
	else if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
		"Location", base))
		UTVecCopy(base, a->base);
	//world = BasePos + KeyPos[i]
	a->origin[0] = a->base[0] + a->keypos[0];
	a->origin[1] = a->base[1] + a->keypos[1];
	a->origin[2] = a->base[2] + a->keypos[2];
	UTLog("UTActor: mover %s keys=%d move=%3.2f key1=(%4.0f %4.0f %4.0f)\n",
		a->name, a->n_keys, a->move_time,
		a->keypos[3], a->keypos[4], a->keypos[5]);
}

U0 UTActorScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 kind;
	I64 ai;
	CUTExport *e;
	U8 *cls;
	U8 *nm;
	F64 v[3];

	UTActorClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_actor_n < UT_ACT_MAX)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		kind = UTActorKindFromClass(cls);
		if (kind)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				nm = UTPkgNameStr(pkg, e->name_index);
				ai = UTActorAdd(cls, nm, v, kind);
				if (ai >= 0 && kind == UT_ACT_MOVER)
					UTActorBindMover(pkg, e, &ut_actors[ai]);
				if (ai >= 0 && kind == UT_ACT_WEAPON)
					ut_actors[ai].weap_id = UTWeapIdFromClass(cls);
			}
		}
		i++;
	}
	UTLog("UTActor: scanned %d specials\n", ut_actor_n);
}

U0 UTActorTickMovers(F64 dt)
{
	I64 i;
	I64 k0;
	I64 k1;
	CUTActor *a;
	F64 t;
	F64 seg;
	F64 u;
	F64 *p0;
	F64 *p1;
	F64 total;

	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->kind == UT_ACT_MOVER && a->active && a->n_keys >= 2)
		{
			total = a->move_time * ToF64(a->n_keys - 1);
			if (total < 0.1)
				total = 0.1;
			a->phase += dt;
			t = a->phase;
			//ping-pong across key span
			seg = total * 2.0;
			while (t >= seg)
				t -= seg;
			if (t > total)
				t = seg - t;
			u = t / a->move_time;
			k0 = ToI64(u);
			if (k0 >= a->n_keys - 1)
				k0 = a->n_keys - 2;
			if (k0 < 0)
				k0 = 0;
			k1 = k0 + 1;
			u = u - ToF64(k0);
			if (u < 0.0) u = 0.0;
			if (u > 1.0) u = 1.0;
			p0 = a->keypos + k0 * 3;
			p1 = a->keypos + k1 * 3;
			a->origin[0] = a->base[0] + p0[0] + (p1[0] - p0[0]) * u;
			a->origin[1] = a->base[1] + p0[1] + (p1[1] - p0[1]) * u;
			a->origin[2] = a->base[2] + p0[2] + (p1[2] - p0[2]) * u;
		}
		i++;
	}
}

U0 UTActorTouchPlayer(F64 *org)
{
	I64 i;
	CUTActor *a;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	F64 *kp;

	if (!org)
		return;
	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->active && !a->taken)
		{
			dx = a->origin[0] - org[0];
			dy = a->origin[1] - org[1];
			dz = a->origin[2] - org[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (a->kind == UT_ACT_TELEPORT && d2 < 70.0 * 70.0)
			{
				if (a->n_keys >= 2)
				{
					kp = a->keypos + 3;
					org[0] = a->base[0] + kp[0];
					org[1] = a->base[1] + kp[1];
					org[2] = a->base[2] + kp[2] + 32.0;
				}
				else
				{
					org[0] += 200.0;
					org[2] += 32.0;
				}
				a->taken = TRUE;
				a->phase = tS + 2.0;
			}
			if (a->kind == UT_ACT_WEAPON && d2 < 60.0 * 60.0)
			{
				a->taken = TRUE;
				a->phase = tS + 20.0;
				a->amount = 0.0;
				if (a->weap_id >= 0)
					UTInvExecGive(a->weap_id);
			}
			if (a->kind == UT_ACT_TRIGGER && d2 < 80.0 * 80.0)
			{
				//bump nearby movers' phase
				a->phase = tS;
			}
		}
		else if (a->taken && a->kind == UT_ACT_WEAPON && tS >= a->phase)
			a->taken = FALSE;
		else if (a->taken && a->kind == UT_ACT_TELEPORT && tS >= a->phase)
			a->taken = FALSE;
		i++;
	}
}

U0 UTActorDraw(CUTCanvas *c)
{
	I64 i;
	CUTActor *a;
	F64 p0[3];
	F64 p1[3];
	F64 p2[3];
	I64 col;

	if (!c)
		return;
	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->active && !a->taken)
		{
			col = 100;
			if (a->kind == UT_ACT_MOVER)
				col = 120;
			else if (a->kind == UT_ACT_WEAPON)
				col = 220;
			else if (a->kind == UT_ACT_TELEPORT)
				col = 40;
			else if (a->kind == UT_ACT_TRIGGER)
				col = 180;
			p0[0] = a->origin[0] - 16; p0[1] = a->origin[1] - 16; p0[2] = a->origin[2];
			p1[0] = a->origin[0] + 16; p1[1] = a->origin[1] - 16; p1[2] = a->origin[2];
			p2[0] = a->origin[0]; p2[1] = a->origin[1] + 16; p2[2] = a->origin[2] + 32;
			UTDrawTri3(c, p0, p1, p2, col);
		}
		i++;
	}
}
