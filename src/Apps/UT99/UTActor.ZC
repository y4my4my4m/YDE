// UTActor.ZC - map specials with property-bound KeyPos movers.
//
// AMover: KeyPos[8] relative to BasePos (EngineClasses.h). Tag/Event
// from props: Trigger.Event opens movers with matching Tag. Untagged
// movers ping-pong. Touch/Trigger/Bump Exec via Engine.u Function load.

#define UT_ACT_MAX			256
#define UT_ACT_MOVER		1
#define UT_ACT_TRIGGER		2
#define UT_ACT_TELEPORT		3
#define UT_ACT_WEAPON		4
#define UT_ACT_PICKUP		5
#define UT_ACT_JUMP			6
#define UT_ACT_HURT			7
#define UT_ACT_COUNTER		9
#define UT_ACT_MESSAGE		10
#define UT_ACT_LADDER		11
#define UT_ACT_KEYS			8

class CUTActor
{
	U8	 name[48];
	U8	 cls[48];
	U8	 tag[48];
	U8	 event[48];
	U8	 url[80];
	I64	 kind;
	F64	 origin[3];
	F64	 base[3];
	F64	 keypos[UT_ACT_KEYS * 3];
	I64	 n_keys;
	F64	 move_time;
	F64	 yaw;
	Bool active;
	Bool taken;
	F64	 phase;
	F64	 speed;
	I64	 weap_id;
	F64	 amount;
	Bool opening;
	Bool moving;
	Bool auto_loop;		//TRUE = ping-pong without Trigger
	F64	 stay_open;
	F64	 hold_t;
	Bool enabled;		//Teleporter.bEnabled
};

CUTActor	ut_actors[UT_ACT_MAX];
I64			ut_actor_n	= 0;

extern U0 UTGameTakeDamage(F64 amount);

U0 UTActorClear()
{
	ut_actor_n = 0;
}

I64 UTActorAdd(U8 *cls, U8 *name, F64 *loc, I64 kind)
{
	CUTActor *a;

	if (ut_actor_n >= UT_ACT_MAX || !loc)
		return -1;
	a = &ut_actors[ut_actor_n];
	MemSet(a, 0, sizeof(CUTActor));
	StrPrint(a->cls, "%s", cls);
	if (name)
		StrPrint(a->name, "%s", name);
	UTVecCopy(loc, a->origin);
	UTVecCopy(loc, a->base);
	a->kind = kind;
	a->active = TRUE;
	a->n_keys = 2;
	a->move_time = 1.0;
	a->opening = TRUE;
	a->moving = FALSE;
	a->auto_loop = TRUE;
	a->stay_open = 4.0;
	a->hold_t = 0.0;
	a->tag[0] = 0;
	a->event[0] = 0;
	a->url[0] = 0;
	a->enabled = TRUE;
	//default KeyPos[0]=0 KeyPos[1]=up
	a->keypos[0] = 0; a->keypos[1] = 0; a->keypos[2] = 0;
	a->keypos[3] = 0; a->keypos[4] = 0; a->keypos[5] = 128.0;
	ut_actor_n++;
	return ut_actor_n - 1;
}

I64 UTActorKindFromClass(U8 *cls)
{
	if (!cls)
		return 0;
	if (!StrCompare(cls, "Mover") || !StrCompare(cls, "AssertMover") ||
		!StrCompare(cls, "MixMover") || !StrCompare(cls, "ElevatorMover"))
		return UT_ACT_MOVER;
	if (!StrCompare(cls, "Trigger") || !StrCompare(cls, "TriggerOpenTimed") ||
		!StrCompare(cls, "TriggerToggle") || !StrCompare(cls, "Dispatcher") ||
		!StrCompare(cls, "ElevatorTrigger") || !StrCompare(cls, "RoundRobin"))
		return UT_ACT_TRIGGER;
	if (!StrCompare(cls, "Counter"))
		return UT_ACT_COUNTER;
	if (!StrCompare(cls, "SpecialEvent") || !StrCompare(cls, "TranslatorEvent"))
		return UT_ACT_MESSAGE;
	if (!StrCompare(cls, "Ladder") || !StrCompare(cls, "UT_Ladder") ||
		!StrCompare(cls, "LadderTrigger"))
		return UT_ACT_LADDER;
	if (!StrCompare(cls, "Teleporter") || !StrCompare(cls, "VisibleTeleporter"))
		return UT_ACT_TELEPORT;
	if (!StrCompare(cls, "JumpPad") || !StrCompare(cls, "UT_JumpPad") ||
		!StrCompare(cls, "Kicker"))
		return UT_ACT_JUMP;
	if (!StrCompare(cls, "TriggerHurt") || !StrCompare(cls, "PainZone"))
		return UT_ACT_HURT;
	if (!StrCompare(cls, "ShockRifle") || !StrCompare(cls, "PulseGun") ||
		!StrCompare(cls, "FlakCannon") || !StrCompare(cls, "UT_Eightball") ||
		!StrCompare(cls, "Minigun") || !StrCompare(cls, "Minigun2") ||
		!StrCompare(cls, "Ripper") || !StrCompare(cls, "SniperRifle") ||
		!StrCompare(cls, "BioRifle") || !StrCompare(cls, "ImpactHammer") ||
		!StrCompare(cls, "enforcer") || !StrCompare(cls, "SuperShockRifle"))
		return UT_ACT_WEAPON;
	return 0;
}

U0 UTActorBindNames(CUTPackage *pkg, CUTExport *e, CUTActor *a)
{//Tag / Event / StayOpenTime from tagged property stream.
	CUTPropBag bag;

	if (!pkg || !e || !a)
		return;
	UTPropBagInit(&bag);
	UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
		e->object_flags, &bag);
	if (bag.tag_name[0])
		StrPrint(a->tag, "%s", bag.tag_name);
	if (bag.event_name[0])
		StrPrint(a->event, "%s", bag.event_name);
	if (bag.url_str[0])
		StrPrint(a->url, "%s", bag.url_str);
	if (bag.floats[1] > 0.05)
		a->stay_open = bag.floats[1];
	if (a->kind == UT_ACT_JUMP)
	{
		//JumpVelocity / KickVelocity → keypos[0..2]; default up pad
		a->keypos[0] = 0;
		a->keypos[1] = 0;
		a->keypos[2] = 900.0;
		if (!UTPropBagGetVec(&bag, "JumpVelocity", 0, a->keypos))
			UTPropBagGetVec(&bag, "KickVelocity", 0, a->keypos);
		a->auto_loop = FALSE;
	}
	if (a->kind == UT_ACT_HURT)
	{
		a->amount = 10.0;
		if (bag.hit_damage > 0.0)
			a->amount = bag.hit_damage;
		a->auto_loop = FALSE;
	}
	if (a->kind == UT_ACT_COUNTER)
	{
		a->weap_id = 2;
		if (bag.num_touches > 0)
			a->weap_id = bag.num_touches;
		a->amount = ToF64(a->weap_id);
		a->auto_loop = FALSE;
	}
	if (a->kind == UT_ACT_MESSAGE)
	{
		if (bag.url_str[0])
			StrPrint(a->url, "%s", bag.url_str);
		a->auto_loop = FALSE;
	}
	if (a->kind == UT_ACT_TELEPORT && a->tag[0] == 0 && a->name[0])
		StrPrint(a->tag, "%s", a->name);
	//Tagged movers wait for Trigger.Event == Mover.Tag.
	if (a->kind == UT_ACT_MOVER && a->tag[0])
	{
		a->auto_loop = FALSE;
		a->moving = FALSE;
		a->phase = 0.0;
		a->opening = TRUE;
	}
}

U0 UTActorBindMover(CUTPackage *pkg, CUTExport *e, CUTActor *a)
{
	I64 n;
	F64 mt;
	F64 base[3];
	F64 *kp;

	kp = a->keypos;
	n = 0;
	mt = 1.0;
	if (UTPropFindKeyPos(pkg, e->serial_offset, e->serial_size,
		e->object_flags, kp, 3, &n, &mt))
	{
		a->n_keys = n;
		a->move_time = mt;
		if (a->move_time < 0.05)
			a->move_time = 0.05;
	}
	if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
		"BasePos", base))
		UTVecCopy(base, a->base);
	else if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
		"Location", base))
		UTVecCopy(base, a->base);
	//world = BasePos + KeyPos[i]
	a->origin[0] = a->base[0] + a->keypos[0];
	a->origin[1] = a->base[1] + a->keypos[1];
	a->origin[2] = a->base[2] + a->keypos[2];
	UTActorBindNames(pkg, e, a);
	UTLog("UTActor: mover %s tag=%s keys=%d move=%3.2f auto=%d\n",
		a->name, a->tag, a->n_keys, a->move_time, a->auto_loop);
}

U0 UTActorScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 kind;
	I64 ai;
	CUTExport *e;
	U8 *cls;
	U8 *nm;
	F64 v[3];

	UTActorClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_actor_n < UT_ACT_MAX)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		kind = UTActorKindFromClass(cls);
		if (kind)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				nm = UTPkgNameStr(pkg, e->name_index);
				ai = UTActorAdd(cls, nm, v, kind);
				if (ai >= 0 && kind == UT_ACT_MOVER)
					UTActorBindMover(pkg, e, &ut_actors[ai]);
				else if (ai >= 0)
					UTActorBindNames(pkg, e, &ut_actors[ai]);
				if (ai >= 0 && kind == UT_ACT_WEAPON)
					ut_actors[ai].weap_id = UTWeapIdFromClass(cls);
			}
		}
		i++;
	}
	UTLog("UTActor: scanned %d specials\n", ut_actor_n);
}

U0 UTActorApplyKeyLerp(CUTActor *a, F64 t)
{//t = seconds along open path 0..total (one direction).
	I64 k0;
	I64 k1;
	F64 u;
	F64 *p0;
	F64 *p1;
	F64 total;

	if (!a || a->n_keys < 2)
		return;
	total = a->move_time * ToF64(a->n_keys - 1);
	if (total < 0.1)
		total = 0.1;
	if (t < 0.0) t = 0.0;
	if (t > total) t = total;
	u = t / a->move_time;
	k0 = ToI64(u);
	if (k0 >= a->n_keys - 1)
		k0 = a->n_keys - 2;
	if (k0 < 0)
		k0 = 0;
	k1 = k0 + 1;
	u = u - ToF64(k0);
	if (u < 0.0) u = 0.0;
	if (u > 1.0) u = 1.0;
	p0 = a->keypos + k0 * 3;
	p1 = a->keypos + k1 * 3;
	a->origin[0] = a->base[0] + p0[0] + (p1[0] - p0[0]) * u;
	a->origin[1] = a->base[1] + p0[1] + (p1[1] - p0[1]) * u;
	a->origin[2] = a->base[2] + p0[2] + (p1[2] - p0[2]) * u;
}

U0 UTActorExecEvent(U8 *fn_name)
{//= ProcessEvent(Touch/Trigger/Bump) without map UObject Self.
	if (!fn_name || !fn_name[0])
		return;
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", fn_name);
	UTVMCall(fn_name, 48);
}

U0 UTActorMoverActivate(CUTActor *m)
{//= AMover::Trigger — start or reverse KeyPos interp.
	if (!m || m->kind != UT_ACT_MOVER)
		return;
	if (m->moving && m->hold_t > 0.0)
	{//re-trigger while held open → close early
		m->hold_t = 0.0;
		m->opening = FALSE;
		return;
	}
	if (!m->moving)
	{
		m->moving = TRUE;
		m->opening = TRUE;
		m->hold_t = 0.0;
		UTActorExecEvent("Trigger");
	}
	else
		m->opening = !m->opening;
}

U0 UTActorFireEvent(U8 *ev)
{//Trigger.Event → Actors with matching Tag (Mover open) + TriggerLight.
	I64 i;
	CUTActor *a;

	if (!ev || !ev[0])
		return;
	UTLightToggleByTag(ev);
	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->active && a->kind == UT_ACT_MOVER && a->tag[0] &&
			!StrCompare(a->tag, ev))
			UTActorMoverActivate(a);
		i++;
	}
}

U0 UTActorTickMovers(F64 dt)
{
	I64 i;
	CUTActor *a;
	F64 t;
	F64 seg;
	F64 total;

	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->kind == UT_ACT_MOVER && a->active && a->n_keys >= 2)
		{
			total = a->move_time * ToF64(a->n_keys - 1);
			if (total < 0.1)
				total = 0.1;
			if (a->auto_loop)
			{//untagged demo path — ping-pong
				a->phase += dt;
				t = a->phase;
				seg = total * 2.0;
				while (t >= seg)
					t -= seg;
				if (t > total)
					t = seg - t;
				UTActorApplyKeyLerp(a, t);
			}
			else if (a->moving)
			{
				if (a->hold_t > 0.0)
				{
					a->hold_t -= dt;
					if (a->hold_t <= 0.0)
					{
						a->hold_t = 0.0;
						a->opening = FALSE;
					}
					UTActorApplyKeyLerp(a, total);
				}
				else if (a->opening)
				{
					a->phase += dt;
					if (a->phase >= total)
					{
						a->phase = total;
						a->hold_t = a->stay_open;
						if (a->stay_open < 0.05)
						{
							a->hold_t = 0.0;
							a->opening = FALSE;
						}
					}
					UTActorApplyKeyLerp(a, a->phase);
				}
				else
				{
					a->phase -= dt;
					if (a->phase <= 0.0)
					{
						a->phase = 0.0;
						a->moving = FALSE;
						a->opening = TRUE;
					}
					UTActorApplyKeyLerp(a, a->phase);
				}
			}
			else
				UTActorApplyKeyLerp(a, a->phase);
		}
		i++;
	}
}

U0 UTActorTeleportPlayer(CUTActor *src, F64 *org)
{//= Teleporter.Touch — URL matches dest Tag (same level).
	I64 i;
	CUTActor *d;
	I64 picks;
	I64 chosen;

	if (!src || !org || !src->enabled)
		return;
	if (!src->url[0])
		return;
	//cross-level / net URL absent
	i = 0;
	while (src->url[i])
	{
		if (src->url[i] == '/' || src->url[i] == '#')
			return;
		i++;
	}
	picks = 0;
	chosen = -1;
	i = 0;
	while (i < ut_actor_n)
	{
		d = &ut_actors[i];
		if (d->kind == UT_ACT_TELEPORT && d != src && d->enabled &&
			d->tag[0] && !StrCompare(d->tag, src->url))
		{
			if (picks == 0)
				chosen = i;
			picks++;
		}
		i++;
	}
	if (chosen < 0)
	{//fallback KeyPos[1] offset from BasePos
		if (src->n_keys >= 2)
		{
			org[0] = src->base[0] + src->keypos[3];
			org[1] = src->base[1] + src->keypos[4];
			org[2] = src->base[2] + src->keypos[5] + 32.0;
		}
		else
		{
			org[0] += 200.0;
			org[2] += 32.0;
		}
		return;
	}
	d = &ut_actors[chosen];
	org[0] = d->origin[0];
	org[1] = d->origin[1];
	org[2] = d->origin[2] + 32.0;
	UTActorExecEvent("Touch");
}

U0 UTActorTouchPlayer(F64 *org)
{
	I64 i;
	CUTActor *a;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	if (!org)
		return;
	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->active && !a->taken)
		{
			dx = a->origin[0] - org[0];
			dy = a->origin[1] - org[1];
			dz = a->origin[2] - org[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (a->kind == UT_ACT_JUMP && d2 < 70.0 * 70.0)
			{
				if (tS >= a->phase)
				{
					a->phase = tS + 0.35;
					ut_velocity[0] = a->keypos[0];
					ut_velocity[1] = a->keypos[1];
					ut_velocity[2] = a->keypos[2];
					UTActorExecEvent("Touch");
				}
			}
			if (a->kind == UT_ACT_HURT && d2 < 80.0 * 80.0)
			{
				if (tS >= a->phase)
				{
					a->phase = tS + 0.25;
					UTGameTakeDamage(a->amount * 0.25);
					UTActorExecEvent("Touch");
				}
			}
			if (a->kind == UT_ACT_TELEPORT && d2 < 70.0 * 70.0)
			{
				UTActorTeleportPlayer(a, org);
				a->taken = TRUE;
				a->phase = tS + 1.5;
			}
			if (a->kind == UT_ACT_WEAPON && d2 < 60.0 * 60.0)
			{
				a->taken = TRUE;
				a->phase = tS + 20.0;
				a->amount = 0.0;
				if (a->weap_id >= 0)
					UTInvExecGive(a->weap_id);
				UTActorExecEvent("Touch");
			}
			if (a->kind == UT_ACT_TRIGGER && d2 < 80.0 * 80.0)
			{//cooldown in phase; Event → Tag-matched movers + Exec
				if (tS >= a->phase)
				{
					a->phase = tS + 0.75;
					UTActorExecEvent("Touch");
					UTActorExecEvent("Trigger");
					UTActorFireEvent(a->event);
				}
			}
			if (a->kind == UT_ACT_COUNTER && d2 < 80.0 * 80.0)
			{
				if (tS >= a->phase && a->amount > 0.0)
				{
					a->phase = tS + 0.4;
					a->amount -= 1.0;
					UTActorExecEvent("Touch");
					if (a->amount <= 0.0)
					{
						UTActorExecEvent("Trigger");
						UTActorFireEvent(a->event);
						a->amount = ToF64(a->weap_id);
					}
				}
			}
			if (a->kind == UT_ACT_MESSAGE && d2 < 90.0 * 90.0)
			{
				if (tS >= a->phase)
				{
					a->phase = tS + 2.0;
					if (a->url[0])
						UTMsgCenter(a->url);
					UTActorExecEvent("Touch");
					UTActorFireEvent(a->event);
				}
			}
			if (a->kind == UT_ACT_LADDER && d2 < 70.0 * 70.0)
			{
				ut_velocity[2] = 280.0;
				ut_on_ground = TRUE;
				UTActorExecEvent("Touch");
			}
			if (a->kind == UT_ACT_MOVER && a->moving &&
				d2 < 90.0 * 90.0)
			{
				if (tS >= a->amount)
				{
					a->amount = tS + 0.5;
					UTActorExecEvent("Bump");
				}
			}
		}
		else if (a->taken && a->kind == UT_ACT_WEAPON && tS >= a->phase)
			a->taken = FALSE;
		else if (a->taken && a->kind == UT_ACT_TELEPORT && tS >= a->phase)
			a->taken = FALSE;
		i++;
	}
}

U0 UTSoftDrawActor(CUTCanvas *c, F64 *origin, I64 yaw, I64 color)
{//= URenderDevice::DrawActor mesh path — LodMesh else player mesh else tri.
	F64 p0[3];
	F64 p1[3];
	F64 p2[3];

	if (!c || !origin)
		return;
	if (ut_lod_ready && ut_lod_player.loaded)
	{
		UTVecCopy(origin, ut_lod_player.draw_origin);
		ut_lod_player.draw_yaw = yaw & 0xFFFF;
		UTLodDraw(c, &ut_lod_player, color);
		return;
	}
	if (ut_player_mesh_ready)
	{
		UTVecCopy(origin, ut_player_mesh.origin);
		ut_player_mesh.scale = 1.0;
		UTMeshDraw(c, &ut_player_mesh);
		return;
	}
	p0[0] = origin[0] - 16; p0[1] = origin[1] - 16; p0[2] = origin[2];
	p1[0] = origin[0] + 16; p1[1] = origin[1] - 16; p1[2] = origin[2];
	p2[0] = origin[0]; p2[1] = origin[1] + 16; p2[2] = origin[2] + 32;
	UTDrawTri3(c, p0, p1, p2, color);
}


//---- Drawable map actors (UnRender DrawActor / UMesh::GetTexture) ----
//Map instances rarely override Mesh; it comes from the class defaults, so each
//class is resolved once and its mesh shared by every instance of it.

#define UT_AMESH_MAX		40		//distinct meshes held at once
#define UT_ADRAW_MAX		192		//drawable instances in a level
#define UT_DT_NONE			0
#define UT_DT_SPRITE		1
#define UT_DT_MESH			2
#define UT_DT_BRUSH			3

class CUTActorMesh
{
	U8			name[64];
	CUTLodMesh	mesh;
	Bool		ok;
};

class CUTDrawActor
{
	F64		origin[3];
	I64		yaw;
	F64		draw_scale;
	I64		mesh_i;			//index into ut_amesh
	CUTTex *skin;			//AActor.Skin
	CUTTex *multi[8];		//AActor.MultiSkins
	F64		frame;
	Bool	unlit;
};

CUTActorMesh	ut_amesh[UT_AMESH_MAX];
I64				ut_amesh_n	= 0;
CUTDrawActor	ut_dactor[UT_ADRAW_MAX];
I64				ut_dactor_n	= 0;
Bool			ut_amesh_zeroed = FALSE;

U0 UTActorMeshClear()
{
	I64 i;

	if (!ut_amesh_zeroed)
	{
		MemSet(ut_amesh, 0, sizeof(CUTActorMesh) * UT_AMESH_MAX);
		ut_amesh_zeroed = TRUE;
	}
	else
	{
		i = 0;
		while (i < ut_amesh_n)
		{
			UTLodFree(&ut_amesh[i].mesh);
			i++;
		}
	}
	ut_amesh_n = 0;
	ut_dactor_n = 0;
}

I64 UTActorMeshSlot(U8 *pkg_path, U8 *mesh_name)
{//find or load a mesh by name; -1 when it will not load.
	I64 i;
	CUTActorMesh *am;

	if (!mesh_name || !mesh_name[0])
		return -1;
	i = 0;
	while (i < ut_amesh_n)
	{
		if (!StrCompare(ut_amesh[i].name, mesh_name))
		{
			if (ut_amesh[i].ok)
				return i;
			return -1;
		}
		i++;
	}
	if (ut_amesh_n >= UT_AMESH_MAX)
		return -1;
	am = &ut_amesh[ut_amesh_n];
	MemSet(am, 0, sizeof(CUTActorMesh));
	StrPrint(am->name, "%s", mesh_name);
	am->ok = UTLodLoadNamed(pkg_path, mesh_name, &am->mesh);
	ut_amesh_n++;
	if (!am->ok)
		return -1;
	return ut_amesh_n - 1;
}

U8 *UTActorMeshPkgPath(CUTPackage *pkg, I64 ref, U8 *buf)
{//Object ref -> package file holding it. Imports name their root package.
	U8 *rp;

	if (ref < 0)
	{
		rp = UTLinkObjPkg(pkg, ref);
		if (rp && rp[0])
		{
			StrPrint(buf, "::/Apps/UT99/System/%s.u", rp);
			return buf;
		}
	}
	StrPrint(buf, "::/Apps/UT99/System/Botpack.u");
	return buf;
}

CUTTex *UTActorTexFromRef(CUTPackage *pkg, I64 ref)
{
	U8 *nm;

	if (!ref)
		return NULL;
	nm = UTLinkObjName(pkg, ref);
	if (!nm || !nm[0])
		return NULL;
	return UTLinkLoadTex(nm);
}

U0 UTActorScanDrawables(CUTPackage *pkg)
{//Every export carrying a Location and resolving to a mesh becomes drawable.
	I64 i;
	I64 j;
	I64 mi;
	CUTExport *e;
	U8 *cls;
	U8 *mesh_nm;
	CUTPropBag bag;
	CUTPropBag cbag;
	I64 mesh_ref;
	I64 skin_ref;
	I64 dt;
	CUTDrawActor *d;
	U8 path[128];
	CUTPackage *rpkg;
	Bool live;
	I64 n_cand;
	I64 n_loc;
	I64 n_ref;

	UTActorMeshClear;
	if (!pkg)
		return;
	n_cand = 0;
	n_loc = 0;
	n_ref = 0;
	i = 0;
	while (i < pkg->export_count && ut_dactor_n < UT_ADRAW_MAX)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		//Brushes are BSP; lights and path markers never draw.
		live = ToBool(e->serial_size != 0 &&
			StrCompare(cls, "Brush") && StrCompare(cls, "Light") &&
			StrCompare(cls, "PathNode") && StrCompare(cls, "InventorySpot") &&
			StrCompare(cls, "PlayerStart") && StrCompare(cls, "ZoneInfo") &&
			StrCompare(cls, "LevelInfo") && StrCompare(cls, "Camera"));
		if (live)
		{
			n_cand++;
			live = UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
				e->object_flags, &bag);
		}
		if (live)
		{
			live = ToBool(bag.has_location && !bag.b_hidden);
			if (live)
				n_loc++;
		}
		if (live)
		{
			mesh_ref = bag.mesh_ref;
			skin_ref = bag.skin_ref;
			dt = bag.draw_type;
			rpkg = pkg;
			//Instances rarely override Mesh; it comes from the class
			//defaults, whose object refs index the class package's tables,
			//not the map's. Resolve names against whichever package the ref
			//actually came from.
			j = 0;
			while (j < 4 && !mesh_ref)
			{
				if (j == 0)
					StrPrint(path, "::/Apps/UT99/System/Botpack.u");
				else if (j == 1)
					StrPrint(path, "::/Apps/UT99/System/UnrealShare.u");
				else if (j == 2)
					StrPrint(path, "::/Apps/UT99/System/UnrealI.u");
				else
					StrPrint(path, "::/Apps/UT99/System/Engine.u");
				if (UTPropLoadClassDefaults(path, cls, &cbag))
				{
					if (cbag.mesh_ref)
					{
						mesh_ref = cbag.mesh_ref;
						if (!skin_ref)
							skin_ref = cbag.skin_ref;
						if (dt < 0)
							dt = cbag.draw_type;
						rpkg = UTPkgLoad(path);
						if (!rpkg)
							rpkg = pkg;
					}
				}
				j++;
			}
			if (mesh_ref)
				n_ref++;
			live = ToBool(mesh_ref != 0 && dt != UT_DT_NONE &&
				dt != UT_DT_BRUSH);
		}
		if (live)
		{
			mesh_nm = UTLinkObjName(rpkg, mesh_ref);
			UTActorMeshPkgPath(rpkg, mesh_ref, path);
			mi = UTActorMeshSlot(path, mesh_nm);
			if (mi >= 0)
			{
				d = &ut_dactor[ut_dactor_n];
				MemSet(d, 0, sizeof(CUTDrawActor));
				UTVecCopy(bag.location, d->origin);
				d->yaw = bag.rotation[1];
				d->draw_scale = bag.draw_scale;
				if (d->draw_scale <= 0.0)
					d->draw_scale = 1.0;
				d->mesh_i = mi;
				d->skin = UTActorTexFromRef(rpkg, skin_ref);
				j = 0;
				while (j < 8)
				{
					d->multi[j] = UTActorTexFromRef(pkg,
						bag.multi_skin_ref[j]);
					j++;
				}
				d->frame = 0.0;
				ut_dactor_n++;
			}
		}
		i++;
	}
	UTLog("UTActor: cand=%d loc=%d meshref=%d drawables=%d meshes=%d\n",
		n_cand, n_loc, n_ref, ut_dactor_n, ut_amesh_n);
}

U0 UTActorDrawMeshes(CUTCanvas *c)
{//Shared mesh, per-instance transform and skin. Mesh state is transient.
	I64 i;
	I64 j;
	CUTDrawActor *d;
	CUTLodMesh *m;
	F64 sv[3];

	if (!c)
		return;
	i = 0;
	while (i < ut_dactor_n)
	{
		d = &ut_dactor[i];
		if (d->mesh_i >= 0 && d->mesh_i < ut_amesh_n && ut_amesh[d->mesh_i].ok)
		{
			m = &ut_amesh[d->mesh_i].mesh;
			UTVecCopy(m->scale, sv);
			m->scale[0] = sv[0] * d->draw_scale;
			m->scale[1] = sv[1] * d->draw_scale;
			m->scale[2] = sv[2] * d->draw_scale;
			UTVecCopy(d->origin, m->draw_origin);
			m->draw_yaw = d->yaw;
			m->frame = d->frame;
			m->owner_skin = d->skin;
			j = 0;
			while (j < 8)
			{
				m->multi_skin[j] = d->multi[j];
				j++;
			}
			UTLodDraw(c, m, 100);
			UTVecCopy(sv, m->scale);
			m->owner_skin = NULL;
			j = 0;
			while (j < 8)
			{
				m->multi_skin[j] = NULL;
				j++;
			}
		}
		i++;
	}
}

U0 UTActorDraw(CUTCanvas *c)
{//Map specials via SoftDrv DrawActor mesh path.
	I64 i;
	CUTActor *a;
	I64 col;

	if (!c)
		return;
	i = 0;
	while (i < ut_actor_n)
	{
		a = &ut_actors[i];
		if (a->active && !a->taken)
		{
			col = 100;
			if (a->kind == UT_ACT_MOVER)
				col = 120;
			else if (a->kind == UT_ACT_WEAPON)
				col = 220;
			else if (a->kind == UT_ACT_TELEPORT)
				col = 40;
			else if (a->kind == UT_ACT_TRIGGER)
				col = 180;
			UTSoftDrawActor(c, a->origin, ToI64(a->yaw), col);
		}
		i++;
	}
}

U0 UTVMNativeAllActors(CUTVMFrame *f)
{//= AActor::execAllActors PRE_ITERATOR / POST_ITERATOR over ut_actors.
	I64 w_end;
	I64 start_ip;
	I64 i;
	I64 b;
	Bool body_done;
	Bool stop_all;
	CUTActor *a;

	if (!f)
		return;
	UTVMSkipParms(f);
	w_end = UTVMReadU16(f);
	start_ip = f->ip;
	ut_vm_iter_hits = 0;
	stop_all = FALSE;
	i = 0;
	while (i < ut_actor_n && !stop_all && !f->err)
	{
		a = &ut_actors[i];
		if (a->active)
		{
			UTVMValObj(&f->locals[0], i);
			ut_vm_iter_hits++;
			f->ip = start_ip;
			body_done = FALSE;
			while (!body_done && !f->err && f->ip < f->code_size)
			{
				b = f->code[f->ip] & 255;
				if (b == UT_EX_IteratorNext)
				{
					f->ip++;
					body_done = TRUE;
				}
				else if (b == UT_EX_IteratorPop)
				{
					f->ip++;
					stop_all = TRUE;
					body_done = TRUE;
				}
				else
				{
					if (!UTVMStepExpr(f))
					{
						stop_all = TRUE;
						body_done = TRUE;
					}
				}
			}
		}
		i++;
	}
	if (w_end >= 0 && w_end + 1 < f->code_size)
		f->ip = w_end + 1;
	else if (w_end >= 0 && w_end < f->code_size)
		f->ip = w_end;
}
