// UTMenu.ZC - SoftDrv boot/pause menu. Visual clone of retail UT99 main menu.
//
// No UWindow / UScript stack. Labels from UMenu.int / UTMenu.int.
// 5x7 bitmap font (old 3x5 mapped A as H, dropped Q).

#define UT_MENU_SCR_MAIN	0
#define UT_MENU_SCR_OPT		1

#define UT_MENU_DM		0
#define UT_MENU_TDM		1
#define UT_MENU_CTF		2
#define UT_MENU_DOM		3
#define UT_MENU_SETTINGS	4
#define UT_MENU_START		5
#define UT_MENU_QUIT		6
#define UT_MENU_N		7

#define UT_MENU_OPT_FRAG	0
#define UT_MENU_OPT_BOTS	1
#define UT_MENU_OPT_BACK	2
#define UT_MENU_OPT_N		3

#define UT_MENU_BG		0
#define UT_MENU_PANEL		8
#define UT_MENU_EDGE		16
#define UT_MENU_GOLD		250
#define UT_MENU_WHITE		255
#define UT_MENU_DIM		180
#define UT_MENU_RED		40
#define UT_MENU_BAR		48
#define UT_MENU_TITLE		220

#define UT_MENU_GW		5
#define UT_MENU_GH		7
#define UT_MENU_GIDS		44

Bool	ut_menu_open		= FALSE;
Bool	ut_menu_quit		= FALSE;
I64		ut_menu_sel			= 0;
I64		ut_menu_mode		= 0;	//0 DM 1 TDM 2 CTF 3 DOM
I64		ut_menu_frag		= 30;
I64		ut_menu_bots		= 5;
Bool	ut_menu_apply		= FALSE;
Bool	ut_menu_latched		= FALSE;
Bool	ut_menu_nav_latched	= FALSE;
Bool	ut_menu_boot		= TRUE;
I64		ut_menu_screen		= 0;
Bool	ut_menu_logo_ok		= FALSE;
CUTTex	ut_menu_logo;
Bool	ut_menu_metal_ok	= FALSE;
CUTTex	ut_menu_metal;

//5x7 glyphs: 0-9 A-Z space - . / : ' ( )
//Rows: bits 4..0, MSB left. A is 0x0E/0x11 peak — not H (0x11 bar).
U8 ut_menu_glyph[308] = {
	//0-9
	0x0E,0x11,0x13,0x15,0x19,0x11,0x0E,
	0x04,0x0C,0x04,0x04,0x04,0x04,0x0E,
	0x0E,0x11,0x01,0x06,0x08,0x10,0x1F,
	0x0E,0x11,0x01,0x06,0x01,0x11,0x0E,
	0x02,0x06,0x0A,0x12,0x1F,0x02,0x02,
	0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E,
	0x06,0x08,0x10,0x1E,0x11,0x11,0x0E,
	0x1F,0x01,0x02,0x04,0x08,0x08,0x08,
	0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E,
	0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C,
	//A-Z
	0x0E,0x11,0x11,0x1F,0x11,0x11,0x11,
	0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E,
	0x0E,0x11,0x10,0x10,0x10,0x11,0x0E,
	0x1E,0x11,0x11,0x11,0x11,0x11,0x1E,
	0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F,
	0x1F,0x10,0x10,0x1E,0x10,0x10,0x10,
	0x0E,0x11,0x10,0x17,0x11,0x11,0x0F,
	0x11,0x11,0x11,0x1F,0x11,0x11,0x11,
	0x0E,0x04,0x04,0x04,0x04,0x04,0x0E,
	0x01,0x01,0x01,0x01,0x11,0x11,0x0E,
	0x11,0x12,0x14,0x18,0x14,0x12,0x11,
	0x10,0x10,0x10,0x10,0x10,0x10,0x1F,
	0x11,0x1B,0x15,0x15,0x11,0x11,0x11,
	0x11,0x19,0x15,0x13,0x11,0x11,0x11,
	0x0E,0x11,0x11,0x11,0x11,0x11,0x0E,
	0x1E,0x11,0x11,0x1E,0x10,0x10,0x10,
	0x0E,0x11,0x11,0x11,0x15,0x12,0x0D,
	0x1E,0x11,0x11,0x1E,0x14,0x12,0x11,
	0x0E,0x11,0x10,0x0E,0x01,0x11,0x0E,
	0x1F,0x04,0x04,0x04,0x04,0x04,0x04,
	0x11,0x11,0x11,0x11,0x11,0x11,0x0E,
	0x11,0x11,0x11,0x11,0x11,0x0A,0x04,
	0x11,0x11,0x11,0x15,0x15,0x1B,0x11,
	0x11,0x11,0x0A,0x04,0x0A,0x11,0x11,
	0x11,0x11,0x0A,0x04,0x04,0x04,0x04,
	0x1F,0x01,0x02,0x04,0x08,0x10,0x1F,
	//space - . / : ' ( )
	0x00,0x00,0x00,0x00,0x00,0x00,0x00,
	0x00,0x00,0x00,0x1F,0x00,0x00,0x00,
	0x00,0x00,0x00,0x00,0x00,0x0C,0x0C,
	0x01,0x02,0x04,0x08,0x10,0x00,0x00,
	0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00,
	0x04,0x04,0x00,0x00,0x00,0x00,0x00,
	0x04,0x08,0x10,0x10,0x10,0x08,0x04,
	0x04,0x02,0x01,0x01,0x01,0x02,0x04
};

I64 UTMenuGlyphId(U8 ch)
{
	if (ch >= '0' && ch <= '9')
		return ch - '0';
	if (ch >= 'a' && ch <= 'z')
		ch = ch - 'a' + 'A';
	if (ch >= 'A' && ch <= 'Z')
		return 10 + (ch - 'A');
	if (ch == ' ') return 36;
	if (ch == '-') return 37;
	if (ch == '.') return 38;
	if (ch == '/') return 39;
	if (ch == ':') return 40;
	if (ch == '\'') return 41;
	if (ch == '(') return 42;
	if (ch == ')') return 43;
	if (ch == '&') return 36;
	if (ch == '[') return 42;
	if (ch == ']') return 43;
	return 36;
}

U0 UTMenuFill(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	I64 yy;
	I64 xx;
	I64 x2;
	I64 y2;

	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	yy = y;
	while (yy < y2)
	{
		xx = x;
		while (xx < x2)
		{
			c->pixels[yy * c->width + xx] = col;
			xx++;
		}
		yy++;
	}
}

U0 UTMenuGlyph(CUTCanvas *c, I64 x, I64 y, I64 gid, I64 col, I64 scale)
{
	I64 r;
	I64 b;
	I64 bit;
	I64 xx;
	I64 base;
	I64 px;
	I64 py;

	if (gid < 0 || gid >= UT_MENU_GIDS)
		gid = 36;
	if (scale < 1)
		scale = 1;
	base = gid * UT_MENU_GH;
	r = 0;
	while (r < UT_MENU_GH)
	{
		b = ut_menu_glyph[base + r];
		bit = 16;
		xx = 0;
		while (xx < UT_MENU_GW)
		{
			if (b & bit)
			{
				px = x + xx * scale;
				py = y + r * scale;
				UTMenuFill(c, px, py, scale, scale, col);
			}
			bit = bit / 2;
			xx++;
		}
		r++;
	}
}

U0 UTMenuText(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col)
{
	I64 i;
	U8 ch;
	I64 pitch;

	if (!s)
		return;
	pitch = (UT_MENU_GW + 1) * 1;
	i = 0;
	while (s[i] && i < 48)
	{
		ch = s[i];
		UTMenuGlyph(c, x + i * pitch, y, UTMenuGlyphId(ch), col, 1);
		i++;
	}
}

U0 UTMenuTextBig(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col)
{
	I64 i;
	U8 ch;
	I64 pitch;

	if (!s)
		return;
	pitch = (UT_MENU_GW + 1) * 2;
	i = 0;
	while (s[i] && i < 32)
	{
		ch = s[i];
		UTMenuGlyph(c, x + i * pitch, y, UTMenuGlyphId(ch), col, 2);
		i++;
	}
}

U0 UTMenuDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	if (digit < 0) digit = 0;
	if (digit > 9) digit = 9;
	UTMenuGlyph(c, x, y, digit, col, 1);
}

U0 UTMenuNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	I64 d0;
	I64 d1;
	I64 d2;
	I64 pitch;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	pitch = UT_MENU_GW + 1;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	if (d2)
		UTMenuDigit(c, x, y, d2, col);
	if (d2 || d1)
		UTMenuDigit(c, x + pitch, y, d1, col);
	UTMenuDigit(c, x + pitch * 2, y, d0, col);
}

I64 UTMenuMapFilter()
{//TDM uses DM- maps (TeamGamePlus).
	if (ut_menu_mode == UT_MENU_CTF)
		return UT_MAP_MODE_CTF;
	if (ut_menu_mode == UT_MENU_DOM)
		return UT_MAP_MODE_DOM;
	return UT_MAP_MODE_DM;
}

U0 UTMenuApplyFilter()
{
	ut_map_filter = UTMenuMapFilter;
}

U0 UTMenuBlitTex(CUTCanvas *c, CUTTex *t, I64 dx, I64 dy, I64 dw, I64 dh)
{
	I64 x;
	I64 y;
	I64 x2;
	I64 y2;
	I64 sx;
	I64 sy;
	I64 tw;
	I64 th;
	I64 texel;
	I64 i;

	if (!c || !t || !t->mips[0].pixels || dw < 1 || dh < 1)
		return;
	tw = t->u_size;
	th = t->v_size;
	if (tw < 1 || th < 1)
		return;
	x2 = dx + dw;
	y2 = dy + dh;
	if (dx < 0) dx = 0;
	if (dy < 0) dy = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	y = dy;
	while (y < y2)
	{
		sy = (y - dy) * th / dh;
		x = dx;
		while (x < x2)
		{
			sx = (x - dx) * tw / dw;
			texel = UTTexSample(t, sx, sy);
			if (texel)
			{
				i = y * c->width + x;
				c->pixels[i] = texel;
			}
			x++;
		}
		y++;
	}
}

U0 UTMenuLoadArt()
{
	ut_menu_logo_ok = FALSE;
	ut_menu_metal_ok = FALSE;
	UTTexInit(&ut_menu_logo);
	UTTexInit(&ut_menu_metal);
	if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
	{
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"logo2", &ut_menu_logo))
			ut_menu_logo_ok = TRUE;
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"rmetal", &ut_menu_metal))
			ut_menu_metal_ok = TRUE;
	}
}

U0 UTMenuInit()
{
	ut_menu_open = TRUE;
	ut_menu_boot = TRUE;
	ut_menu_quit = FALSE;
	ut_menu_sel = UT_MENU_START;
	ut_menu_mode = UT_MENU_DM;
	ut_menu_frag = 30;
	ut_menu_bots = 5;
	ut_menu_apply = FALSE;
	ut_menu_latched = FALSE;
	ut_menu_nav_latched = FALSE;
	ut_menu_screen = UT_MENU_SCR_MAIN;
	UTMenuLoadArt;
}

U0 UTMenuToggle()
{
	if (ut_menu_boot)
		return;
	ut_menu_open = !ut_menu_open;
	if (ut_menu_open)
	{
		UTMapBuildCatalog;
		ut_menu_screen = UT_MENU_SCR_MAIN;
		ut_menu_sel = UT_MENU_START;
		ut_menu_frag = ut_frag_limit;
		ut_menu_bots = ut_bot_count;
	}
}

U0 UTMenuAdjust(I64 dir)
{
	if (ut_menu_screen == UT_MENU_SCR_OPT)
	{
		if (ut_menu_sel == UT_MENU_OPT_FRAG)
		{
			ut_menu_frag += dir * 5;
			if (ut_menu_frag < 5)
				ut_menu_frag = 5;
			if (ut_menu_frag > 100)
				ut_menu_frag = 100;
		}
		else if (ut_menu_sel == UT_MENU_OPT_BOTS)
		{
			ut_menu_bots += dir;
			if (ut_menu_bots < 0)
				ut_menu_bots = 0;
			if (ut_menu_bots > UT_GM_BOT_MAX)
				ut_menu_bots = UT_GM_BOT_MAX;
		}
		return;
	}

	if (ut_menu_sel >= UT_MENU_DM && ut_menu_sel <= UT_MENU_DOM)
	{
		ut_menu_mode = ut_menu_sel;
		UTMenuApplyFilter;
		UTMapCycle(dir);
	}
	else if (ut_menu_sel == UT_MENU_START)
		UTMapCycle(dir);
}

U0 UTMenuStartMatch()
{
	ut_menu_apply = TRUE;
	UTMenuApplyFilter;
	ut_menu_open = FALSE;
	ut_menu_boot = FALSE;
}

U0 UTMenuActivate()
{
	if (ut_menu_screen == UT_MENU_SCR_OPT)
	{
		if (ut_menu_sel == UT_MENU_OPT_BACK)
		{
			ut_menu_screen = UT_MENU_SCR_MAIN;
			ut_menu_sel = UT_MENU_SETTINGS;
		}
		else
			UTMenuAdjust(1);
		return;
	}

	if (ut_menu_sel >= UT_MENU_DM && ut_menu_sel <= UT_MENU_DOM)
	{
		ut_menu_mode = ut_menu_sel;
		UTMenuApplyFilter;
		UTMapBuildCatalog;
	}
	else if (ut_menu_sel == UT_MENU_SETTINGS)
	{
		ut_menu_screen = UT_MENU_SCR_OPT;
		ut_menu_sel = UT_MENU_OPT_FRAG;
	}
	else if (ut_menu_sel == UT_MENU_START)
		UTMenuStartMatch;
	else if (ut_menu_sel == UT_MENU_QUIT)
	{
		ut_menu_quit = TRUE;
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
}

U0 UTMenuPoll()
{
	Bool esc;
	Bool up;
	Bool down;
	Bool left;
	Bool right;
	Bool enter;
	I64 nmax;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	if (esc)
	{
		if (!ut_menu_latched)
		{
			ut_menu_latched = TRUE;
			if (ut_menu_open && ut_menu_screen == UT_MENU_SCR_OPT)
			{
				ut_menu_screen = UT_MENU_SCR_MAIN;
				ut_menu_sel = UT_MENU_SETTINGS;
			}
			else
				UTMenuToggle;
		}
	}
	else
		ut_menu_latched = FALSE;

	if (!ut_menu_open)
		return;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	left = Bt(kbd.down_bitmap, SC_CURSOR_LEFT) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('a'));
	right = Bt(kbd.down_bitmap, SC_CURSOR_RIGHT) ||
			Bt(kbd.down_bitmap, Char2ScanCode('d'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	nmax = UT_MENU_N;
	if (ut_menu_screen == UT_MENU_SCR_OPT)
		nmax = UT_MENU_OPT_N;

	if (up || down || left || right || enter)
	{
		if (!ut_menu_nav_latched)
		{
			ut_menu_nav_latched = TRUE;
			if (up)
			{
				ut_menu_sel--;
				if (ut_menu_sel < 0)
					ut_menu_sel = nmax - 1;
			}
			else if (down)
			{
				ut_menu_sel++;
				if (ut_menu_sel >= nmax)
					ut_menu_sel = 0;
			}
			else if (left)
				UTMenuAdjust(-1);
			else if (right)
				UTMenuAdjust(1);
			else if (enter)
				UTMenuActivate;
			if (ut_menu_screen == UT_MENU_SCR_MAIN &&
				ut_menu_sel >= UT_MENU_DM && ut_menu_sel <= UT_MENU_DOM)
			{
				ut_menu_mode = ut_menu_sel;
				UTMenuApplyFilter;
			}
		}
	}
	else
		ut_menu_nav_latched = FALSE;
}

U0 UTMenuDrawFrame(CUTCanvas *c)
{
	I64 i;
	I64 shade;

	UTMenuFill(c, 0, 0, c->width, c->height, UT_MENU_BG);
	if (ut_menu_metal_ok)
		UTMenuBlitTex(c, &ut_menu_metal, 0, 0, c->width, c->height);
	else
	{
		i = 0;
		while (i < c->height)
		{
			shade = 4 + (i * 12) / c->height;
			UTMenuFill(c, 0, i, c->width, 1, shade);
			i++;
		}
	}
	UTMenuFill(c, 0, 0, c->width, 2, UT_MENU_GOLD);
	UTMenuFill(c, 0, c->height - 2, c->width, 2, UT_MENU_GOLD);
	UTMenuFill(c, 0, 0, 2, c->height, UT_MENU_GOLD);
	UTMenuFill(c, c->width - 2, 0, 2, c->height, UT_MENU_GOLD);
}

U0 UTMenuDrawTitle(CUTCanvas *c)
{
	I64 tw;

	if (ut_menu_logo_ok)
	{
		tw = c->width - 40;
		if (tw > 240)
			tw = 240;
		UTMenuBlitTex(c, &ut_menu_logo, (c->width - tw) / 2, 8, tw, 36);
	}
	else
		UTMenuTextBig(c, 28, 10, "UNREAL TOURNAMENT", UT_MENU_TITLE);
	UTMenuText(c, 8, 48, "START PRACTICE SESSION", UT_MENU_DIM);
}

U0 UTMenuDrawMapPanel(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h)
{
	I64 i;
	I64 row;
	I64 idx;
	I64 col;
	I64 shown;
	U8 *nm;
	U8 line[40];

	UTMenuFill(c, x, y, w, h, UT_MENU_PANEL);
	UTMenuFill(c, x, y, w, 1, UT_MENU_EDGE);
	UTMenuFill(c, x, y + h - 1, w, 1, UT_MENU_EDGE);
	UTMenuFill(c, x, y, 1, h, UT_MENU_EDGE);
	UTMenuFill(c, x + w - 1, y, 1, h, UT_MENU_EDGE);
	UTMenuText(c, x + 6, y + 4, "MAP", UT_MENU_GOLD);

	shown = (h - 20) / 10;
	if (shown < 1)
		shown = 1;
	if (shown > 12)
		shown = 12;
	if (ut_map_cat_n < 1)
	{
		UTMenuText(c, x + 6, y + 20, "NO MAPS", UT_MENU_RED);
		return;
	}
	row = 0;
	i = ut_map_cat_i - shown / 2;
	while (row < shown)
	{
		idx = i + row;
		while (idx < 0)
			idx += ut_map_cat_n;
		while (idx >= ut_map_cat_n)
			idx -= ut_map_cat_n;
		col = UT_MENU_DIM;
		if (idx == ut_map_cat_i)
		{
			UTMenuFill(c, x + 2, y + 16 + row * 10, w - 4, 9, UT_MENU_BAR);
			col = UT_MENU_GOLD;
		}
		nm = ut_map_cat[idx].name;
		StrPrint(line, "%s", nm);
		line[22] = 0;
		UTMenuText(c, x + 6, y + 17 + row * 10, line, col);
		row++;
	}
}

U0 UTMenuDrawMain(CUTCanvas *c)
{
	I64 i;
	I64 y;
	I64 col;
	I64 x0;
	I64 row_h;
	U8 *label;
	U8 line[48];

	x0 = 16;
	y = 64;
	row_h = 14;
	i = 0;
	while (i < UT_MENU_N)
	{
		col = UT_MENU_DIM;
		if (i == ut_menu_sel)
		{
			UTMenuFill(c, x0 - 4, y - 2, 150, row_h, UT_MENU_BAR);
			col = UT_MENU_GOLD;
		}
		if (i == ut_menu_mode && i <= UT_MENU_DOM)
			col = UT_MENU_WHITE;
		if (i == ut_menu_sel)
			col = UT_MENU_GOLD;

		label = "";
		if (i == UT_MENU_DM)
			label = "DEATHMATCH";
		else if (i == UT_MENU_TDM)
			label = "TEAM DEATHMATCH";
		else if (i == UT_MENU_CTF)
			label = "CAPTURE THE FLAG";
		else if (i == UT_MENU_DOM)
			label = "DOMINATION";
		else if (i == UT_MENU_SETTINGS)
			label = "SETTINGS";
		else if (i == UT_MENU_START)
			label = "START MATCH";
		else if (i == UT_MENU_QUIT)
			label = "QUIT";
		UTMenuText(c, x0, y, label, col);
		y += row_h;
		i++;
	}

	UTMenuDrawMapPanel(c, 176, 60, 136, 140);

	StrPrint(line, "FRAG:%d  BOTS:%d", ut_menu_frag, ut_menu_bots);
	UTMenuText(c, 16, c->height - 28, line, UT_MENU_DIM);
	UTMenuText(c, 16, c->height - 16, "ARROWS SELECT  ENTER GO", 100);
}

U0 UTMenuDrawOpt(CUTCanvas *c)
{
	I64 i;
	I64 y;
	I64 col;
	I64 x0;
	U8 line[40];

	UTMenuTextBig(c, 40, 20, "SETTINGS", UT_MENU_TITLE);
	x0 = 40;
	y = 70;
	i = 0;
	while (i < UT_MENU_OPT_N)
	{
		col = UT_MENU_DIM;
		if (i == ut_menu_sel)
		{
			UTMenuFill(c, x0 - 4, y - 2, 200, 14, UT_MENU_BAR);
			col = UT_MENU_GOLD;
		}
		if (i == UT_MENU_OPT_FRAG)
		{
			StrPrint(line, "FRAG LIMIT  %d", ut_menu_frag);
			UTMenuText(c, x0, y, line, col);
		}
		else if (i == UT_MENU_OPT_BOTS)
		{
			StrPrint(line, "BOTS  %d", ut_menu_bots);
			UTMenuText(c, x0, y, line, col);
		}
		else if (i == UT_MENU_OPT_BACK)
			UTMenuText(c, x0, y, "BACK", col);
		y += 18;
		i++;
	}
	UTMenuText(c, 16, c->height - 16, "LEFT RIGHT CHANGE  ESC BACK", 100);
}

U0 UTMenuDraw(CUTCanvas *c)
{
	if (!c || !ut_menu_open)
		return;

	UTMapBuildCatalog;
	UTMenuDrawFrame(c);
	if (ut_menu_screen == UT_MENU_SCR_OPT)
		UTMenuDrawOpt(c);
	else
	{
		UTMenuDrawTitle(c);
		UTMenuDrawMain(c);
	}
}
