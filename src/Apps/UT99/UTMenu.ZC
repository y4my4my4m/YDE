// UTMenu.ZC - SoftDrv pause / boot menu: map / gametype / fraglimit / bots.
//
// Not UWindow. Dark panel, yellow select, white labels. ESC toggles; Enter Start.

#define UT_MENU_MAP		0
#define UT_MENU_MODE	1
#define UT_MENU_FRAG	2
#define UT_MENU_BOTS	3
#define UT_MENU_GO		4
#define UT_MENU_QUIT	5
#define UT_MENU_N		6

#define UT_MENU_BG		8
#define UT_MENU_PANEL	12
#define UT_MENU_YELLOW	250
#define UT_MENU_WHITE	255
#define UT_MENU_DIM		180
#define UT_MENU_RED		40

Bool	ut_menu_open		= FALSE;
Bool	ut_menu_quit		= FALSE;
I64		ut_menu_sel			= 0;
I64		ut_menu_mode		= 0;	//0 DM 1 CTF 2 DOM
I64		ut_menu_frag		= 30;
I64		ut_menu_bots		= 5;
Bool	ut_menu_apply		= FALSE;
Bool	ut_menu_latched		= FALSE;
Bool	ut_menu_nav_latched	= FALSE;
Bool	ut_menu_boot		= TRUE;	//first screen before match

//3x5 glyphs for A-Z 0-9 - . SPACE (36+). Rows packed in 5 bits.
U8 ut_menu_glyph[40 * 5] = {
	//0-9
	7,5,5,5,7,
	2,2,2,2,2,
	7,1,7,4,7,
	7,1,7,1,7,
	5,5,7,1,1,
	7,4,7,1,7,
	7,4,7,5,7,
	7,1,1,1,1,
	7,5,7,5,7,
	7,5,7,1,7,
	//A-Z subset used in labels + map names: A B C D E F G H I L M N O P R S T U W X Y Z - . space /
	5,5,7,5,5, //A 10
	6,5,6,5,6, //B
	7,4,4,4,7, //C
	6,5,5,5,6, //D
	7,4,6,4,7, //E
	7,4,6,4,4, //F
	7,4,5,5,7, //G
	5,5,7,5,5, //H
	7,2,2,2,7, //I
	4,4,4,4,7, //L 19
	5,7,5,5,5, //M
	5,7,7,5,5, //N
	7,5,5,5,7, //O
	7,5,7,4,4, //P
	7,5,6,5,5, //R 25
	7,4,7,1,7, //S
	7,2,2,2,2, //T
	5,5,5,5,7, //U
	5,5,5,2,2, //V
	5,5,5,5,2, //W
	5,5,2,5,5, //X
	5,5,2,2,2, //Y
	7,1,2,4,7, //Z
	0,0,7,0,0, //-
	0,0,0,0,2, //.
	0,0,0,0,0, //space
	1,1,2,4,4  // /
};

I64 UTMenuGlyphId(U8 ch)
{
	if (ch >= '0' && ch <= '9')
		return ch - '0';
	if (ch >= 'a' && ch <= 'z')
		ch = ch - 'a' + 'A';
	if (ch == 'A') return 10;
	if (ch == 'B') return 11;
	if (ch == 'C') return 12;
	if (ch == 'D') return 13;
	if (ch == 'E') return 14;
	if (ch == 'F') return 15;
	if (ch == 'G') return 16;
	if (ch == 'H') return 17;
	if (ch == 'I') return 18;
	if (ch == 'L') return 19;
	if (ch == 'M') return 20;
	if (ch == 'N') return 21;
	if (ch == 'O') return 22;
	if (ch == 'P') return 23;
	if (ch == 'R') return 24;
	if (ch == 'S') return 25;
	if (ch == 'T') return 26;
	if (ch == 'U') return 27;
	if (ch == 'V') return 28;
	if (ch == 'W') return 29;
	if (ch == 'X') return 30;
	if (ch == 'Y') return 31;
	if (ch == 'Z') return 32;
	if (ch == '-') return 33;
	if (ch == '.') return 34;
	if (ch == ' ') return 35;
	if (ch == '/') return 36;
	if (ch == ']') return 33;
	if (ch == '[') return 33;
	return 35;
}

U0 UTMenuFill(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	I64 yy;
	I64 xx;
	I64 x2;
	I64 y2;

	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	yy = y;
	while (yy < y2)
	{
		xx = x;
		while (xx < x2)
		{
			c->pixels[yy * c->width + xx] = col;
			xx++;
		}
		yy++;
	}
}

U0 UTMenuGlyph(CUTCanvas *c, I64 x, I64 y, I64 gid, I64 col)
{
	I64 r;
	I64 b;
	I64 bit;
	I64 xx;
	I64 base;

	if (gid < 0 || gid > 36)
		gid = 35;
	base = gid * 5;
	r = 0;
	while (r < 5)
	{
		b = ut_menu_glyph[base + r];
		bit = 4;
		xx = 0;
		while (xx < 3)
		{
			if (b & bit)
				UTMenuFill(c, x + xx * 2, y + r * 2, 2, 2, col);
			bit = bit / 2;
			xx++;
		}
		r++;
	}
}

U0 UTMenuText(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col)
{
	I64 i;
	U8 ch;

	if (!s)
		return;
	i = 0;
	while (s[i] && i < 48)
	{
		ch = s[i];
		UTMenuGlyph(c, x + i * 8, y, UTMenuGlyphId(ch), col);
		i++;
	}
}

U0 UTMenuDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	if (digit < 0) digit = 0;
	if (digit > 9) digit = 9;
	UTMenuGlyph(c, x, y, digit, col);
}

U0 UTMenuNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	I64 d0;
	I64 d1;
	I64 d2;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	if (d2)
		UTMenuDigit(c, x, y, d2, col);
	if (d2 || d1)
		UTMenuDigit(c, x + 8, y, d1, col);
	UTMenuDigit(c, x + 16, y, d0, col);
}

U0 UTMenuInit()
{
	ut_menu_open = TRUE;
	ut_menu_boot = TRUE;
	ut_menu_quit = FALSE;
	ut_menu_sel = UT_MENU_GO;
	ut_menu_mode = 0;
	ut_menu_frag = 30;
	ut_menu_bots = 5;
	ut_menu_apply = FALSE;
	ut_menu_latched = FALSE;
	ut_menu_nav_latched = FALSE;
}

U0 UTMenuToggle()
{
	if (ut_menu_boot)
		return;
	ut_menu_open = !ut_menu_open;
	if (ut_menu_open)
	{
		UTMapBuildCatalog;
		if (ut_map_filter >= 0)
			ut_menu_mode = ut_map_filter;
		ut_menu_frag = ut_frag_limit;
		ut_menu_bots = ut_bot_count;
	}
}

U0 UTMenuAdjust(I64 dir)
{
	if (ut_menu_sel == UT_MENU_MAP)
		UTMapCycle(dir);
	else if (ut_menu_sel == UT_MENU_MODE)
	{
		ut_menu_mode += dir;
		if (ut_menu_mode < 0)
			ut_menu_mode = 2;
		if (ut_menu_mode > 2)
			ut_menu_mode = 0;
		ut_map_filter = ut_menu_mode;
	}
	else if (ut_menu_sel == UT_MENU_FRAG)
	{
		ut_menu_frag += dir * 5;
		if (ut_menu_frag < 5)
			ut_menu_frag = 5;
		if (ut_menu_frag > 100)
			ut_menu_frag = 100;
	}
	else if (ut_menu_sel == UT_MENU_BOTS)
	{
		ut_menu_bots += dir;
		if (ut_menu_bots < 0)
			ut_menu_bots = 0;
		if (ut_menu_bots > UT_GM_BOT_MAX)
			ut_menu_bots = UT_GM_BOT_MAX;
	}
}

U0 UTMenuActivate()
{
	if (ut_menu_sel == UT_MENU_GO)
	{
		ut_menu_apply = TRUE;
		ut_map_filter = ut_menu_mode;
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
	else if (ut_menu_sel == UT_MENU_QUIT)
	{
		ut_menu_quit = TRUE;
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
	else
		UTMenuAdjust(1);
}

U0 UTMenuPoll()
{
	Bool esc;
	Bool up;
	Bool down;
	Bool left;
	Bool right;
	Bool enter;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	if (esc)
	{
		if (!ut_menu_latched)
		{
			ut_menu_latched = TRUE;
			UTMenuToggle;
		}
	}
	else
		ut_menu_latched = FALSE;

	if (!ut_menu_open)
		return;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	left = Bt(kbd.down_bitmap, SC_CURSOR_LEFT) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('a'));
	right = Bt(kbd.down_bitmap, SC_CURSOR_RIGHT) ||
			Bt(kbd.down_bitmap, Char2ScanCode('d'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	if (up || down || left || right || enter)
	{
		if (!ut_menu_nav_latched)
		{
			ut_menu_nav_latched = TRUE;
			if (up)
			{
				ut_menu_sel--;
				if (ut_menu_sel < 0)
					ut_menu_sel = UT_MENU_N - 1;
			}
			else if (down)
			{
				ut_menu_sel++;
				if (ut_menu_sel >= UT_MENU_N)
					ut_menu_sel = 0;
			}
			else if (left)
				UTMenuAdjust(-1);
			else if (right)
				UTMenuAdjust(1);
			else if (enter)
				UTMenuActivate;
		}
	}
	else
		ut_menu_nav_latched = FALSE;
}

U0 UTMenuDraw(CUTCanvas *c)
{
	I64 i;
	I64 y;
	I64 col;
	I64 x0;
	U8 *map_nm;
	U8 line[64];
	U8 *mode_s;

	if (!c || !ut_menu_open)
		return;

	UTMapBuildCatalog;
	UTMenuFill(c, 0, 0, c->width, c->height, UT_MENU_BG);
	UTMenuFill(c, 24, 16, c->width - 48, c->height - 32, UT_MENU_PANEL);
	UTMenuFill(c, 24, 16, c->width - 48, 14, 16);
	UTMenuText(c, 32, 18, "UT99 SOFTDRV", UT_MENU_YELLOW);

	y = 40;
	x0 = 36;
	i = 0;
	while (i < UT_MENU_N)
	{
		col = UT_MENU_DIM;
		if (i == ut_menu_sel)
			col = UT_MENU_YELLOW;
		if (i == UT_MENU_MAP)
		{
			UTMenuText(c, x0, y, "MAP", col);
			map_nm = "";
			if (ut_map_cat_n > 0 && ut_map_cat_i >= 0 &&
				ut_map_cat_i < ut_map_cat_n)
				map_nm = ut_map_cat[ut_map_cat_i].name;
			UTMenuText(c, x0 + 40, y, map_nm, col);
		}
		else if (i == UT_MENU_MODE)
		{
			UTMenuText(c, x0, y, "MODE", col);
			mode_s = "DM";
			if (ut_menu_mode == 1)
				mode_s = "CTF";
			if (ut_menu_mode == 2)
				mode_s = "DOM";
			UTMenuText(c, x0 + 48, y, mode_s, col);
		}
		else if (i == UT_MENU_FRAG)
		{
			UTMenuText(c, x0, y, "FRAG", col);
			UTMenuNumber(c, x0 + 48, y, ut_menu_frag, col);
		}
		else if (i == UT_MENU_BOTS)
		{
			UTMenuText(c, x0, y, "BOTS", col);
			UTMenuNumber(c, x0 + 48, y, ut_menu_bots, col);
		}
		else if (i == UT_MENU_GO)
		{
			UTMenuFill(c, x0, y, 72, 12, col);
			UTMenuText(c, x0 + 8, y + 1, "START", UT_MENU_BG);
		}
		else if (i == UT_MENU_QUIT)
		{
			UTMenuText(c, x0, y, "QUIT", UT_MENU_RED);
		}
		y += 18;
		i++;
	}
	StrPrint(line, "ARROWS SELECT  ENTER GO");
	UTMenuText(c, x0, c->height - 28, line, 100);
}
