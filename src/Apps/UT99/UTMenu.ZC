I64 UTMenuGlyphId(U8 ch)
{
	if (ch >= '0' && ch <= '9')
		return ch - '0';
	if (ch >= 'a' && ch <= 'z')
		ch = ch - 'a' + 'A';
	if (ch >= 'A' && ch <= 'Z')
		return 10 + (ch - 'A');
	if (ch == ' ') return 36;
	if (ch == '-') return 37;
	if (ch == '.') return 38;
	if (ch == '/') return 39;
	if (ch == ':') return 40;
	if (ch == '\'') return 41;
	if (ch == '(') return 42;
	if (ch == ')') return 43;
	if (ch == '&') return 36;
	if (ch == '[') return 42;
	if (ch == ']') return 43;
	return 36;
}

U0 UTMenuFill(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	I64 yy;
	I64 xx;
	I64 x2;
	I64 y2;

	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	yy = y;
	while (yy < y2)
	{
		xx = x;
		while (xx < x2)
		{
			c->pixels[yy * c->width + xx] = col;
			xx++;
		}
		yy++;
	}
}

U0 UTMenuGlyph(CUTCanvas *c, I64 x, I64 y, I64 gid, I64 col, I64 scale)
{
	I64 r;
	I64 b;
	I64 bit;
	I64 xx;
	I64 base;
	I64 px;
	I64 py;

	if (gid < 0 || gid >= UT_MENU_GIDS)
		gid = 36;
	if (scale < 1)
		scale = 1;
	base = gid * UT_MENU_GH;
	r = 0;
	while (r < UT_MENU_GH)
	{
		b = ut_menu_glyph[base + r];
		bit = 16;
		xx = 0;
		while (xx < UT_MENU_GW)
		{
			if (b & bit)
			{
				px = x + xx * scale;
				py = y + r * scale;
				UTMenuFill(c, px, py, scale, scale, col);
			}
			bit = bit / 2;
			xx++;
		}
		r++;
	}
}

U0 UTMenuText(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col)
{
	I64 i;
	I64 ch;
	I64 pitch;

	if (!s)
		return;
	if (ut_win_ready)
	{
		UTWinTextAt(x, y, s, col);
		return;
	}
	pitch = (UT_MENU_GW + 1) * 1;
	i = 0;
	while (s[i] && i < 48)
	{
		ch = s[i];
		UTMenuGlyph(c, x + i * pitch, y, UTMenuGlyphId(ch), col, 1);
		i++;
	}
}

U0 UTMenuTextBig(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col)
{
	I64 i;
	I64 ch;
	I64 pitch;

	if (!s)
		return;
	if (ut_win_ready)
	{
		UTWinTextAtBig(x, y, s, col);
		return;
	}
	pitch = (UT_MENU_GW + 1) * 2;
	i = 0;
	while (s[i] && i < 32)
	{
		ch = s[i];
		UTMenuGlyph(c, x + i * pitch, y, UTMenuGlyphId(ch), col, 2);
		i++;
	}
}

U0 UTMenuDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	U8 buf[4];

	if (digit < 0) digit = 0;
	if (digit > 9) digit = 9;
	if (ut_win_ready)
	{
		buf[0] = '0' + digit;
		buf[1] = 0;
		UTWinTextAt(x, y, buf, col);
		return;
	}
	UTMenuGlyph(c, x, y, digit, col, 1);
}

U0 UTMenuNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	I64 d0;
	I64 d1;
	I64 d2;
	I64 pitch;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	pitch = UT_MENU_GW + 1;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	if (d2)
		UTMenuDigit(c, x, y, d2, col);
	if (d2 || d1)
		UTMenuDigit(c, x + pitch, y, d1, col);
	UTMenuDigit(c, x + pitch * 2, y, d0, col);
}

I64 UTMenuMapFilter()
{//TDM uses DM- maps (TeamGamePlus).
	if (ut_menu_mode == UT_MENU_CTF)
		return UT_MAP_MODE_CTF;
	if (ut_menu_mode == UT_MENU_DOM)
		return UT_MAP_MODE_DOM;
	if (ut_menu_mode == UT_MENU_AS)
		return UT_MAP_MODE_AS;
	return UT_MAP_MODE_DM;
}

U0 UTMenuApplyFilter()
{
	ut_map_filter = UTMenuMapFilter;
}

U8 *UTMenuGameTypeName()
{
	if (ut_menu_mode == UT_MENU_TDM)
		return "Team Deathmatch";
	if (ut_menu_mode == UT_MENU_CTF)
		return "Capture the Flag";
	if (ut_menu_mode == UT_MENU_DOM)
		return "Domination";
	if (ut_menu_mode == UT_MENU_AS)
		return "Assault";
	return "Deathmatch";
}

U8 *UTMenuMapDisplayName()
{
	U8 *nm;
	I64 i;

	if (ut_map_cat_n < 1)
		return "DM-Codex";
	nm = ut_map_cat[ut_map_cat_i].name;
	i = StrLen(nm);
	if (i > 4 && nm[i - 4] == '.' && nm[i - 3] == 'u')
	{
	}
	return nm;
}

U0 UTMenuBlitTex(CUTCanvas *c, CUTTex *t, I64 dx, I64 dy, I64 dw, I64 dh)
{
	I64 x;
	I64 y;
	I64 x2;
	I64 y2;
	I64 sx;
	I64 sy;
	I64 tw;
	I64 th;
	I64 texel;
	I64 i;

	if (!c || !t || !t->mips[0].pixels || dw < 1 || dh < 1)
		return;
	tw = t->u_size;
	th = t->v_size;
	if (tw < 1 || th < 1)
		return;
	x2 = dx + dw;
	y2 = dy + dh;
	if (dx < 0) dx = 0;
	if (dy < 0) dy = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	y = dy;
	while (y < y2)
	{
		sy = (y - dy) * th / dh;
		x = dx;
		while (x < x2)
		{
			sx = (x - dx) * tw / dw;
			texel = UTTexSample(t, sx, sy);
			if (texel)
			{
				i = y * c->width + x;
				c->pixels[i] = texel;
			}
			x++;
		}
		y++;
	}
}

U0 UTMenuLoadArt()
{//Globals not zeroed. Free only after first MemSet (ut_menu_zeroed).
	if (ut_menu_zeroed)
	{
		if (ut_menu_logo_ok)
			UTTexFreeMips(&ut_menu_logo);
		if (ut_menu_metal_ok)
			UTTexFreeMips(&ut_menu_metal);
	}
	else
	{
		MemSet(&ut_menu_logo, 0, sizeof(CUTTex));
		MemSet(&ut_menu_metal, 0, sizeof(CUTTex));
		ut_menu_zeroed = TRUE;
	}
	ut_menu_logo_ok = FALSE;
	ut_menu_metal_ok = FALSE;
	UTTexInit(&ut_menu_logo);
	UTTexInit(&ut_menu_metal);
	if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
	{
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"logo2", &ut_menu_logo))
			ut_menu_logo_ok = TRUE;
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"rmetal", &ut_menu_metal))
			ut_menu_metal_ok = TRUE;
	}
}

U0 UTMenuInit()
{
	ut_menu_quit = FALSE;
	ut_menu_sel = UT_MENU_F_START;
	ut_menu_mode = UT_MENU_DM;
	ut_menu_frag = 30;
	ut_menu_bots = 5;
	ut_menu_time = 0;
	ut_menu_weapons_stay = FALSE;
	ut_menu_force_respawn = FALSE;
	ut_menu_tournament = FALSE;
	ut_menu_bot_skill = 3;
	ut_menu_balance = TRUE;
	ut_menu_friendly_fire = FALSE;
	ut_menu_cap = 5;
	ut_menu_apply = FALSE;
	ut_menu_latched = FALSE;
	ut_menu_nav_latched = FALSE;
	ut_menu_screen = UT_MENU_SCR_MAIN;
	ut_menu_tab = 0;
	ut_menu_auto_levels = TRUE;
	ut_menu_mut_always = FALSE;
	ut_menu_mut_sel = 0;
	ut_menu_mut_used_n = 0;
	UTMenuScanMutators;
	UTMenuLoadArt;
	if (ut_menu_fake_laf)
	{
		ut_menu_open = TRUE;
		ut_menu_boot = TRUE;
	}
	else
	{
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
}

U0 UTMenuToggle()
{
	if (!ut_menu_fake_laf)
		return;
	if (ut_menu_boot)
		return;
	ut_menu_open = !ut_menu_open;
	if (ut_menu_open)
	{
		UTMapBuildCatalog;
		ut_menu_screen = UT_MENU_SCR_MAIN;
		ut_menu_tab = 0;
		ut_menu_sel = UT_MENU_F_START;
		ut_menu_frag = ut_frag_limit;
		ut_menu_bots = ut_bot_count;
	}
}

U0 UTMenuAdjust(I64 dir)
{
	if (ut_menu_screen == UT_MENU_SCR_MUT)
	{
		ut_menu_mut_sel += dir;
		if (ut_menu_mut_sel < 0)
			ut_menu_mut_sel = UT_MENU_MUT_N - 1;
		if (ut_menu_mut_sel >= UT_MENU_MUT_N)
			ut_menu_mut_sel = 0;
		return;
	}
	if (ut_menu_screen == UT_MENU_SCR_RULES ||
		ut_menu_screen == UT_MENU_SCR_SET ||
		ut_menu_screen == UT_MENU_SCR_BOTS)
	{
		if (ut_menu_screen == UT_MENU_SCR_SET)
		{
			ut_menu_force_respawn = !ut_menu_force_respawn;
			return;
		}
		if (ut_menu_screen == UT_MENU_SCR_BOTS)
		{
			if (ut_menu_sel == UT_MENU_OPT_BOTS)
			{
				ut_menu_bots += dir;
				if (ut_menu_bots < 0)
					ut_menu_bots = 0;
				if (ut_menu_bots > UT_GM_BOT_MAX)
					ut_menu_bots = UT_GM_BOT_MAX;
			}
			else
			{
				ut_menu_bot_skill += dir;
				if (ut_menu_bot_skill < 0)
					ut_menu_bot_skill = 0;
				if (ut_menu_bot_skill > 7)
					ut_menu_bot_skill = 7;
			}
			return;
		}
		if (ut_menu_sel == UT_MENU_OPT_FRAG)
		{
			ut_menu_frag += dir * 5;
			if (ut_menu_frag < 5)
				ut_menu_frag = 5;
			if (ut_menu_frag > 100)
				ut_menu_frag = 100;
		}
		else if (ut_menu_sel == UT_MENU_OPT_BOTS)
		{
			ut_menu_bots += dir;
			if (ut_menu_bots < 0)
				ut_menu_bots = 0;
			if (ut_menu_bots > UT_GM_BOT_MAX)
				ut_menu_bots = UT_GM_BOT_MAX;
		}
		else
		{
			ut_menu_cap += dir;
			if (ut_menu_cap < 1)
				ut_menu_cap = 1;
			if (ut_menu_cap > 50)
				ut_menu_cap = 50;
		}
		return;
	}
	if (ut_menu_screen == UT_MENU_SCR_MAIN)
	{
		if (ut_menu_sel == UT_MENU_F_GAMETYPE)
		{
			ut_menu_mode += dir;
			if (ut_menu_mode < 0)
				ut_menu_mode = 4;
			if (ut_menu_mode > 4)
				ut_menu_mode = 0;
			UTMenuApplyFilter;
			UTMapBuildCatalog;
		}
		else if (ut_menu_sel == UT_MENU_F_MAP ||
			ut_menu_sel == UT_MENU_F_MAPLIST)
		{
			UTMenuApplyFilter;
			UTMapCycle(dir);
		}
	}
}

U0 UTMenuStartMatch()
{
	UTClientStartMatch;
}

U0 UTMenuActivate()
{
	I64 i;

	if (ut_menu_screen == UT_MENU_SCR_GAME)
	{
		if (ut_menu_sel == UT_MENU_GAME_PRACTICE ||
			ut_menu_sel == UT_MENU_GAME_TOURNEY)
		{
			ut_menu_screen = UT_MENU_SCR_MAIN;
			ut_menu_tab = 0;
			ut_menu_sel = UT_MENU_F_START;
		}
		else if (ut_menu_sel == UT_MENU_GAME_QUIT)
		{
			ut_menu_quit = TRUE;
			ut_menu_open = FALSE;
			ut_menu_boot = FALSE;
		}
		else
			ut_menu_screen = UT_MENU_SCR_MAIN;
		return;
	}
	if (ut_menu_screen == UT_MENU_SCR_MUT)
	{
		if (ut_menu_mut_sel >= 0 && ut_menu_mut_sel < ut_menu_mut_n)
		{
			if (ut_menu_mut_used_bit[ut_menu_mut_sel])
			{
				ut_menu_mut_used_bit[ut_menu_mut_sel] = FALSE;
			}
			else
			{
				ut_menu_mut_used_bit[ut_menu_mut_sel] = TRUE;
			}
			ut_menu_mut_used_n = 0;
			i = 0;
			while (i < ut_menu_mut_n && ut_menu_mut_used_n < UT_MENU_MUT_N)
			{
				if (ut_menu_mut_used_bit[i])
				{
					StrPrint(ut_menu_mut_used[ut_menu_mut_used_n], "%s",
						ut_menu_mut_names[i]);
					ut_menu_mut_used_n++;
				}
				i++;
			}
		}
		return;
	}
	if (ut_menu_screen == UT_MENU_SCR_RULES ||
		ut_menu_screen == UT_MENU_SCR_SET ||
		ut_menu_screen == UT_MENU_SCR_BOTS)
	{
		if (ut_menu_screen == UT_MENU_SCR_SET)
		{
			ut_menu_tournament = !ut_menu_tournament;
			return;
		}
		if (ut_menu_screen == UT_MENU_SCR_BOTS)
		{
			ut_menu_balance = !ut_menu_balance;
			return;
		}
		if (ut_menu_screen == UT_MENU_SCR_RULES)
		{
			ut_menu_friendly_fire = !ut_menu_friendly_fire;
			return;
		}
		UTMenuAdjust(1);
		return;
	}
	if (ut_menu_sel == UT_MENU_F_GAMETYPE)
		UTMenuAdjust(1);
	else if (ut_menu_sel == UT_MENU_F_MAP || ut_menu_sel == UT_MENU_F_MAPLIST)
		UTMenuAdjust(1);
	else if (ut_menu_sel == UT_MENU_F_MUTATORS)
	{
		ut_menu_screen = UT_MENU_SCR_MUT;
		ut_menu_mut_sel = 0;
	}
	else if (ut_menu_sel == UT_MENU_F_AUTO)
		ut_menu_auto_levels = !ut_menu_auto_levels;
	else if (ut_menu_sel == UT_MENU_F_START)
		UTMenuStartMatch;
	else if (ut_menu_screen == UT_MENU_SCR_MAIN && ut_menu_tab == 2)
		ut_menu_weapons_stay = !ut_menu_weapons_stay;
}

U0 UTMenuPoll()
{
	Bool esc;
	Bool up;
	Bool down;
	Bool left;
	Bool right;
	Bool enter;
	I64 nmax;
	I64 tab;

	if (!ut_menu_fake_laf)
		return;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	if (esc)
	{
		if (!ut_menu_latched)
		{
			ut_menu_latched = TRUE;
			if (ut_menu_open && ut_menu_screen == UT_MENU_SCR_MUT)
				ut_menu_screen = UT_MENU_SCR_MAIN;
			else if (ut_menu_open && ut_menu_screen == UT_MENU_SCR_GAME)
				ut_menu_screen = UT_MENU_SCR_MAIN;
			else
				UTMenuToggle;
		}
	}
	else
		ut_menu_latched = FALSE;

	if (!ut_menu_open)
		return;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	left = Bt(kbd.down_bitmap, SC_CURSOR_LEFT) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('a'));
	right = Bt(kbd.down_bitmap, SC_CURSOR_RIGHT) ||
			Bt(kbd.down_bitmap, Char2ScanCode('d'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	nmax = UT_MENU_F_N;
	if (ut_menu_screen == UT_MENU_SCR_GAME)
		nmax = UT_MENU_GAME_N;
	else if (ut_menu_screen == UT_MENU_SCR_MUT)
		nmax = UT_MENU_MUT_N;
	else if (ut_menu_screen == UT_MENU_SCR_RULES ||
		ut_menu_screen == UT_MENU_SCR_SET ||
		ut_menu_screen == UT_MENU_SCR_BOTS)
		nmax = UT_MENU_OPT_N;

	if (up || down || left || right || enter)
	{
		if (!ut_menu_nav_latched)
		{
			ut_menu_nav_latched = TRUE;
			if (up)
			{
				if (ut_menu_screen == UT_MENU_SCR_MAIN &&
					ut_menu_sel == UT_MENU_F_GAMETYPE)
				{
					ut_menu_screen = UT_MENU_SCR_GAME;
					ut_menu_sel = UT_MENU_GAME_PRACTICE;
				}
				else
				{
					ut_menu_sel--;
					if (ut_menu_sel < 0)
						ut_menu_sel = nmax - 1;
				}
			}
			else if (down)
			{
				ut_menu_sel++;
				if (ut_menu_sel >= nmax)
					ut_menu_sel = 0;
			}
			else if (left)
			{
				if (ut_menu_screen == UT_MENU_SCR_MAIN &&
					(ut_menu_sel == UT_MENU_F_GAMETYPE ||
					 ut_menu_sel == UT_MENU_F_MAP ||
					 ut_menu_sel == UT_MENU_F_MAPLIST))
					UTMenuAdjust(-1);
				else if (ut_menu_screen == UT_MENU_SCR_RULES ||
					ut_menu_screen == UT_MENU_SCR_SET ||
					ut_menu_screen == UT_MENU_SCR_BOTS)
					UTMenuAdjust(-1);
				else if (ut_menu_screen == UT_MENU_SCR_MUT ||
					ut_menu_screen == UT_MENU_SCR_GAME)
					UTMenuAdjust(-1);
				else
				{
					tab = ut_menu_tab - 1;
					if (tab < 0)
						tab = 3;
					ut_menu_tab = tab;
					if (tab == 0)
						ut_menu_screen = UT_MENU_SCR_MAIN;
					else if (tab == 1)
						ut_menu_screen = UT_MENU_SCR_RULES;
					else if (tab == 2)
						ut_menu_screen = UT_MENU_SCR_SET;
					else
						ut_menu_screen = UT_MENU_SCR_BOTS;
					ut_menu_sel = 0;
				}
			}
			else if (right)
			{
				if (ut_menu_screen == UT_MENU_SCR_MAIN &&
					(ut_menu_sel == UT_MENU_F_GAMETYPE ||
					 ut_menu_sel == UT_MENU_F_MAP ||
					 ut_menu_sel == UT_MENU_F_MAPLIST))
					UTMenuAdjust(1);
				else if (ut_menu_screen == UT_MENU_SCR_RULES ||
					ut_menu_screen == UT_MENU_SCR_SET ||
					ut_menu_screen == UT_MENU_SCR_BOTS)
					UTMenuAdjust(1);
				else if (ut_menu_screen == UT_MENU_SCR_MUT ||
					ut_menu_screen == UT_MENU_SCR_GAME)
					UTMenuAdjust(1);
				else
				{
					tab = ut_menu_tab + 1;
					if (tab > 3)
						tab = 0;
					ut_menu_tab = tab;
					if (tab == 0)
						ut_menu_screen = UT_MENU_SCR_MAIN;
					else if (tab == 1)
						ut_menu_screen = UT_MENU_SCR_RULES;
					else if (tab == 2)
						ut_menu_screen = UT_MENU_SCR_SET;
					else
						ut_menu_screen = UT_MENU_SCR_BOTS;
					ut_menu_sel = 0;
				}
			}
			else if (enter)
				UTMenuActivate;
		}
	}
	else
		ut_menu_nav_latched = FALSE;
}

U0 UTMenuDrawMenubar(CUTCanvas *c)
{
	I64 x;
	U8 *items[6];
	I64 i;

	items[0] = "Game";
	items[1] = "Multiplayer";
	items[2] = "Options";
	items[3] = "Stats";
	items[4] = "Tools";
	items[5] = "Help";
	if (ut_win_ready)
	{
		UTWinFill(0, 0, c->width, 16, ut_col_menubar);
		UTWinFill(0, 16, c->width, 1, ut_col_laf_lo);
		x = 6;
		i = 0;
		while (i < 6)
		{
			if (i == 0 && ut_menu_screen == UT_MENU_SCR_GAME)
				UTWinFill(x - 2, 1, UTWinTextW(items[i], ut_ttf_px) + 8,
					14, ut_col_sel);
			UTWinTextAt(x, 2, items[i], ut_col_label);
			x += UTWinTextW(items[i], ut_ttf_px) + 14;
			i++;
		}
		UTWinTextAt(c->width - 72, 2, "Version 436", ut_col_white);
		return;
	}
	UTMenuFill(c, 0, 0, c->width, 16, ut_col_menubar);
	UTMenuText(c, 6, 4, "Game  Multiplayer  Options", ut_col_label);
}

U0 UTMenuDrawStatus(CUTCanvas *c)
{
	U8 *help;

	help = "Start a new game, load a game, or quit.";
	if (ut_menu_screen == UT_MENU_SCR_MUT)
		help = "Select mutators for this practice session.";
	else if (ut_menu_screen == UT_MENU_SCR_MAIN)
		help = "Arrows change fields. Enter starts. Esc pause.";
	if (ut_win_ready)
	{
		UTWinFill(0, c->height - 14, c->width, 14, ut_col_status);
		UTWinTextAt(4, c->height - 12, help, ut_col_white);
		return;
	}
	UTMenuFill(c, 0, c->height - 14, c->width, 14, ut_col_status);
	UTMenuText(c, 4, c->height - 12, help, ut_col_white);
}

U0 UTMenuDrawGamePulldown(CUTCanvas *c)
{
	I64 x;
	I64 y;
	I64 w;
	I64 i;
	U8 *lab;
	I64 col;

	x = 4;
	y = 17;
	w = 160;
	if (ut_win_ready)
	{
		UTWinFill(x, y, w, 72, ut_col_laf_title);
		UTWinDrawBevel(x, y, w, 72, TRUE);
		i = 0;
		while (i < UT_MENU_GAME_N)
		{
			lab = "";
			if (i == UT_MENU_GAME_TOURNEY)
				lab = "Start Unreal Tournament";
			else if (i == UT_MENU_GAME_PRACTICE)
				lab = "Start Practice Session";
			else if (i == UT_MENU_GAME_RESUME)
				lab = "Resume Saved Tournament";
			else
				lab = "Quit";
			col = ut_col_white;
			if (i == ut_menu_sel)
			{
				UTWinFill(x + 2, y + 2 + i * 16, w - 4, 14, ut_col_sel);
				col = ut_col_white;
			}
			if (i == 3)
				UTWinFill(x + 4, y + 2 + i * 16 - 2, w - 8, 1, ut_col_laf_hi);
			UTWinTextAt(x + 6, y + 4 + i * 16, lab, col);
			i++;
		}
		return;
	}
	no_warn c;
}

U0 UTMenuDrawMutators(CUTCanvas *c)
{
	I64 wx;
	I64 wy;
	I64 ww;
	I64 wh;
	I64 i;
	I64 y;
	I64 col;

	wx = 40;
	wy = 40;
	ww = 240;
	wh = 150;
	if (ut_win_ready)
	{
		UTWinDrawLAFFrame(wx, wy, ww, wh, "Configure Mutators");
		UTWinFill(wx + 10, wy + 22, 10, 10, ut_col_edit);
		UTWinDrawBevel(wx + 10, wy + 22, 10, 10, FALSE);
		if (ut_menu_mut_always)
			UTWinFill(wx + 12, wy + 24, 6, 6, ut_col_label);
		UTWinTextAt(wx + 24, wy + 22,
			"Always use this Mutator configuration", ut_col_label);
		UTWinTextAt(wx + 10, wy + 38, "Mutators not Used", ut_col_label);
		UTWinTextAt(wx + 130, wy + 38, "Mutators Used", ut_col_label);
		UTWinDrawListBox(wx + 10, wy + 50, 100, 70);
		UTWinDrawListBox(wx + 130, wy + 50, 100, 70);
		i = 0;
		y = wy + 52;
		while (i < ut_menu_mut_n && i < 6)
		{
			col = ut_col_label;
			if (i == ut_menu_mut_sel)
			{
				UTWinFill(wx + 12, y - 1, 96, 11, ut_col_sel);
				col = ut_col_white;
			}
			UTWinTextAt(wx + 14, y, ut_menu_mut_names[i], col);
			y += 11;
			i++;
		}
		i = 0;
		y = wy + 52;
		while (i < ut_menu_mut_used_n && i < 6)
		{
			UTWinTextAt(wx + 134, y, ut_menu_mut_used[i], ut_col_label);
			y += 11;
			i++;
		}
		UTWinDrawButton(wx + ww - 60, wy + wh - 24, 50, 16, "Close",
			FALSE);
		return;
	}
	no_warn c;
}

U0 UTMenuDrawPractice(CUTCanvas *c)
{
	I64 wx;
	I64 wy;
	I64 ww;
	I64 wh;
	I64 cx;
	I64 cy;
	I64 i;
	I64 tx;
	U8 *tabs[4];
	U8 line[48];
	U8 *mapnm;
	Bool hot;

	wx = 28;
	wy = 28;
	ww = 264;
	wh = 180;
	if (!ut_win_ready)
	{
		UTMenuFill(c, wx, wy, ww, wh, ut_col_laf_client);
		UTMenuText(c, wx + 8, wy + 8, "Start Practice Session", ut_col_white);
		return;
	}
	UTWinDrawLAFFrame(wx, wy, ww, wh, "Start Practice Session");
	cx = wx + 8;
	cy = wy + 20;
	tabs[0] = "Match";
	tabs[1] = "Rules";
	tabs[2] = "Settings";
	tabs[3] = "Bots";
	tx = cx;
	i = 0;
	while (i < 4)
	{
		UTWinDrawTab(tx, cy, 48, 14, tabs[i], ut_menu_tab == i);
		tx += 50;
		i++;
	}
	cy += 18;
	UTWinFill(cx, cy, ww - 16, 1, ut_col_laf_hi);
	cy += 6;

	if (ut_menu_tab == 0)
	{
		UTWinTextAt(cx, cy, "Game Type:", ut_col_label);
		hot = (ut_menu_sel == UT_MENU_F_GAMETYPE);
		UTWinDrawCombo(cx + 70, cy - 2, 110, 14,
			UTMenuGameTypeName(), hot);
		cy += 20;
		UTWinTextAt(cx, cy, "Map Name:", ut_col_label);
		mapnm = UTMenuMapDisplayName();
		hot = (ut_menu_sel == UT_MENU_F_MAP);
		UTWinDrawCombo(cx + 70, cy - 2, 110, 14, mapnm, hot);
		cy += 20;
		hot = (ut_menu_sel == UT_MENU_F_MAPLIST);
		UTWinDrawButton(cx, cy, 70, 16, "Map List", hot);
		hot = (ut_menu_sel == UT_MENU_F_MUTATORS);
		UTWinDrawButton(cx + 76, cy, 70, 16, "Mutators", hot);
		cy += 22;
		UTWinFill(cx, cy, 10, 10, ut_col_edit);
		UTWinDrawBevel(cx, cy, 10, 10, FALSE);
		if (ut_menu_auto_levels)
			UTWinFill(cx + 2, cy + 2, 6, 6, ut_col_label);
		if (ut_menu_sel == UT_MENU_F_AUTO)
			UTWinFill(cx - 1, cy - 1, 12, 12, ut_col_sel);
		UTWinTextAt(cx + 14, cy, "Auto Change Levels", ut_col_label);
		cy += 20;
		hot = (ut_menu_sel == UT_MENU_F_START);
		UTWinDrawButton(cx, cy, 140, 18, "Start Practice Session", hot);
		UTWinDrawListBox(wx + ww - 100, wy + 44, 84, 84);
		if (ut_win_logo_ok)
			UTWinDrawTileStretched(&ut_win_logo,
				wx + ww - 96, wy + 48, 76, 76);
		else if (ut_tex_grid.mips[0].pixels)
			UTWinDrawTileStretched(&ut_tex_grid,
				wx + ww - 96, wy + 48, 76, 76);
		else
			UTWinTextAt(wx + ww - 90, wy + 80, "Map Shot", ut_col_dim);
	}
	else if (ut_menu_tab == 1)
	{
		StrPrint(line, "Frag Limit  %d", ut_menu_frag);
		hot = (ut_menu_sel == UT_MENU_OPT_FRAG);
		if (hot)
			UTWinFill(cx, cy, 160, 14, ut_col_sel);
		UTWinTextAt(cx + 4, cy + 2, line, ut_col_label);
		cy += 18;
		StrPrint(line, "Time Limit  %d", ut_menu_time);
		UTWinTextAt(cx, cy, line, ut_col_label);
		cy += 16;
		StrPrint(line, "Cap Limit  %d", ut_menu_cap);
		UTWinTextAt(cx, cy, line, ut_col_label);
		cy += 16;
		UTWinTextAt(cx, cy, "Max Players  8", ut_col_label);
		cy += 16;
		if (ut_menu_friendly_fire)
			StrPrint(line, "Friendly Fire  ON");
		else
			StrPrint(line, "Friendly Fire  OFF");
		UTWinTextAt(cx, cy, line, ut_col_label);
	}
	else if (ut_menu_tab == 2)
	{
		if (ut_menu_weapons_stay)
			StrPrint(line, "Weapons Stay  ON");
		else
			StrPrint(line, "Weapons Stay  OFF");
		UTWinTextAt(cx, cy, line, ut_col_label);
		cy += 16;
		if (ut_menu_tournament)
			StrPrint(line, "Tournament Mode  ON");
		else
			StrPrint(line, "Tournament Mode  OFF");
		UTWinTextAt(cx, cy, line, ut_col_label);
		cy += 16;
		if (ut_menu_force_respawn)
			StrPrint(line, "Force Respawn  ON");
		else
			StrPrint(line, "Force Respawn  OFF");
		UTWinTextAt(cx, cy, line, ut_col_label);
	}
	else
	{
		StrPrint(line, "Number of Bots  %d", ut_menu_bots);
		hot = (ut_menu_sel == UT_MENU_OPT_BOTS);
		if (hot)
			UTWinFill(cx, cy, 160, 14, ut_col_sel);
		UTWinTextAt(cx + 4, cy + 2, line, ut_col_label);
		cy += 18;
		StrPrint(line, "Bot Skill  %d", ut_menu_bot_skill);
		UTWinTextAt(cx, cy, line, ut_col_label);
		cy += 16;
		if (ut_menu_balance)
			StrPrint(line, "Balance Teams  ON");
		else
			StrPrint(line, "Balance Teams  OFF");
		UTWinTextAt(cx, cy, line, ut_col_label);
	}
}

U0 UTMenuDraw(CUTCanvas *c)
{
	if (!c || !ut_menu_open || !ut_menu_fake_laf)
		return;

	UTMapBuildCatalog;
	if (ut_win_ready)
		ut_win.fb = c;

	if (ut_win_ready)
	{
		UTWinReset;
		UTWinDrawDesktop;
	}
	else
	{
		UTMenuFill(c, 0, 0, c->width, c->height, ut_col_black);
		if (ut_menu_metal_ok)
			UTMenuBlitTex(c, &ut_menu_metal, 0, 0, c->width, c->height);
	}

	UTMenuDrawMenubar(c);
	if (ut_menu_screen == UT_MENU_SCR_MUT)
	{
		UTMenuDrawPractice(c);
		UTMenuDrawMutators(c);
	}
	else if (ut_menu_screen == UT_MENU_SCR_GAME)
	{
		UTMenuDrawPractice(c);
		UTMenuDrawGamePulldown(c);
	}
	else
		UTMenuDrawPractice(c);
	UTMenuDrawStatus(c);
}
