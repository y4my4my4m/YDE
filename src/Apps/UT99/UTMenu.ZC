Bool UTStrHas(U8 *s, U8 *sub)
{
	I64 i;
	I64 j;

	if (!s || !sub || !sub[0])
		return FALSE;
	i = 0;
	while (s[i])
	{
		j = 0;
		while (sub[j] && s[i + j] == sub[j])
			j++;
		if (!sub[j])
			return TRUE;
		i++;
	}
	return FALSE;
}

Bool UTMenuMutatorNameOk(U8 *nm)
{
	if (!nm || !nm[0])
		return FALSE;
	if (!StrCompare(nm, "Mutator"))
		return FALSE;
	if (!StrCompare(nm, "Object") || !StrCompare(nm, "Actor"))
		return FALSE;
	if (UTStrHas(nm, "Mutator"))
		return TRUE;
	if (UTStrHas(nm, "Arena") || UTStrHas(nm, "Gib") ||
		UTStrHas(nm, "Grav") || UTStrHas(nm, "FatBoy") ||
		UTStrHas(nm, "JumpMatch") || UTStrHas(nm, "Chainsaw") ||
		UTStrHas(nm, "Zoom") || UTStrHas(nm, "Redeemer") ||
		UTStrHas(nm, "Rocket") || UTStrHas(nm, "Powerup") ||
		UTStrHas(nm, "Melee") || UTStrHas(nm, "Insta"))
		return TRUE;
	return FALSE;
}

U0 UTMenuScanMutators()
{
	CUTPackage *pkg;
	I64 i;
	U8 *nm;
	I64 n;
	U8 *fb0;
	U8 *fb1;
	U8 *fb2;
	U8 *fb3;
	U8 *fb4;
	U8 *fb5;
	U8 *fb6;
	U8 *fb7;
	U8 *fb8;
	U8 *fb9;

	ut_menu_mut_n = 0;
	ut_menu_mut_used_n = 0;
	i = 0;
	while (i < UT_MENU_MUT_N)
	{
		ut_menu_mut_names[i][0] = 0;
		ut_menu_mut_used[i][0] = 0;
		ut_menu_mut_used_bit[i] = FALSE;
		i++;
	}
	pkg = UTPkgLoad("::/Apps/UT99/System/Botpack.u");
	if (!pkg)
		pkg = UTPkgLoad("::/Apps/UT99/System/UnrealShare.u");
	if (!pkg)
	{
		fb0 = "ChainsawMelee";
		fb1 = "FatBoy";
		fb2 = "FlakArena";
		fb3 = "InstaGibDM";
		fb4 = "InstantRockets";
		fb5 = "JumpMatch";
		fb6 = "LowGrav";
		fb7 = "NoPowerups";
		fb8 = "NoRedeemer";
		fb9 = "ZoomInstagib";
		StrPrint(ut_menu_mut_names[0], "%s", fb0);
		StrPrint(ut_menu_mut_names[1], "%s", fb1);
		StrPrint(ut_menu_mut_names[2], "%s", fb2);
		StrPrint(ut_menu_mut_names[3], "%s", fb3);
		StrPrint(ut_menu_mut_names[4], "%s", fb4);
		StrPrint(ut_menu_mut_names[5], "%s", fb5);
		StrPrint(ut_menu_mut_names[6], "%s", fb6);
		StrPrint(ut_menu_mut_names[7], "%s", fb7);
		StrPrint(ut_menu_mut_names[8], "%s", fb8);
		StrPrint(ut_menu_mut_names[9], "%s", fb9);
		ut_menu_mut_n = 10;
		return;
	}
	i = 0;
	n = 0;
	while (i < pkg->export_count && n < UT_MENU_MUT_N)
	{
		if (pkg->exports[i].class_index == 0)
		{
			nm = UTPkgNameStr(pkg, pkg->exports[i].name_index);
			if (UTMenuMutatorNameOk(nm))
			{
				StrPrint(ut_menu_mut_names[n], "%s", nm);
				n++;
			}
		}
		i++;
	}
	ut_menu_mut_n = n;
	UTPkgFree(pkg);
	UTLog("UTMenu: mutators scanned n=%d\n", ut_menu_mut_n);
}

