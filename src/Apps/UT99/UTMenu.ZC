// UTMenu.ZC - SoftDrv pause menu: map / gametype / fraglimit / bots.
//
// Not UWindow. Digit bars + selection row. ESC toggles; Enter applies.

#define UT_MENU_MAP		0
#define UT_MENU_MODE	1
#define UT_MENU_FRAG	2
#define UT_MENU_BOTS	3
#define UT_MENU_GO		4
#define UT_MENU_QUIT	5
#define UT_MENU_N		6

Bool	ut_menu_open		= FALSE;
Bool	ut_menu_quit		= FALSE;
I64		ut_menu_sel			= 0;
I64		ut_menu_mode		= 0;	//0 DM 1 CTF 2 DOM
I64		ut_menu_frag		= 30;
I64		ut_menu_bots		= 5;
Bool	ut_menu_apply		= FALSE;
Bool	ut_menu_latched		= FALSE;
Bool	ut_menu_nav_latched	= FALSE;

U0 UTMenuFill(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	I64 yy;
	I64 xx;
	I64 x2;
	I64 y2;

	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	yy = y;
	while (yy < y2)
	{
		xx = x;
		while (xx < x2)
		{
			c->pixels[yy * c->width + xx] = col;
			xx++;
		}
		yy++;
	}
}

U0 UTMenuDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	I64 r;
	I64 b;
	I64 bit;
	I64 xx;
	I64 base;

	if (digit < 0) digit = 0;
	if (digit > 9) digit = 9;
	base = digit * 5;
	r = 0;
	while (r < 5)
	{
		b = ut_hud_digit_rows[base + r];
		bit = 4;
		xx = 0;
		while (xx < 3)
		{
			if (b & bit)
				UTMenuFill(c, x + xx * 2, y + r * 2, 2, 2, col);
			bit = bit / 2;
			xx++;
		}
		r++;
	}
}

U0 UTMenuNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	I64 d0;
	I64 d1;
	I64 d2;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	if (d2)
		UTMenuDigit(c, x, y, d2, col);
	if (d2 || d1)
		UTMenuDigit(c, x + 8, y, d1, col);
	UTMenuDigit(c, x + 16, y, d0, col);
}

U0 UTMenuInit()
{
	ut_menu_open = FALSE;
	ut_menu_quit = FALSE;
	ut_menu_sel = 0;
	ut_menu_mode = 0;
	ut_menu_frag = 30;
	ut_menu_bots = 5;
	ut_menu_apply = FALSE;
	ut_menu_latched = FALSE;
	ut_menu_nav_latched = FALSE;
}

U0 UTMenuToggle()
{
	ut_menu_open = !ut_menu_open;
	if (ut_menu_open)
	{
		UTMapBuildCatalog;
		if (ut_map_filter >= 0)
			ut_menu_mode = ut_map_filter;
		ut_menu_frag = ut_frag_limit;
		ut_menu_bots = ut_bot_count;
	}
}

U0 UTMenuAdjust(I64 dir)
{
	if (ut_menu_sel == UT_MENU_MAP)
		UTMapCycle(dir);
	else if (ut_menu_sel == UT_MENU_MODE)
	{
		ut_menu_mode += dir;
		if (ut_menu_mode < 0)
			ut_menu_mode = 2;
		if (ut_menu_mode > 2)
			ut_menu_mode = 0;
		ut_map_filter = ut_menu_mode;
	}
	else if (ut_menu_sel == UT_MENU_FRAG)
	{
		ut_menu_frag += dir * 5;
		if (ut_menu_frag < 5)
			ut_menu_frag = 5;
		if (ut_menu_frag > 100)
			ut_menu_frag = 100;
	}
	else if (ut_menu_sel == UT_MENU_BOTS)
	{
		ut_menu_bots += dir;
		if (ut_menu_bots < 0)
			ut_menu_bots = 0;
		if (ut_menu_bots > UT_GM_BOT_MAX)
			ut_menu_bots = UT_GM_BOT_MAX;
	}
}

U0 UTMenuActivate()
{
	if (ut_menu_sel == UT_MENU_GO)
	{
		ut_menu_apply = TRUE;
		ut_map_filter = ut_menu_mode;
		ut_menu_open = FALSE;
	}
	else if (ut_menu_sel == UT_MENU_QUIT)
	{
		ut_menu_quit = TRUE;
		ut_menu_open = FALSE;
	}
	else
		UTMenuAdjust(1);
}

U0 UTMenuPoll()
{
	Bool esc;
	Bool up;
	Bool down;
	Bool left;
	Bool right;
	Bool enter;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	if (esc)
	{
		if (!ut_menu_latched)
		{
			ut_menu_latched = TRUE;
			UTMenuToggle;
		}
	}
	else
		ut_menu_latched = FALSE;

	if (!ut_menu_open)
		return;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	left = Bt(kbd.down_bitmap, SC_CURSOR_LEFT) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('a'));
	right = Bt(kbd.down_bitmap, SC_CURSOR_RIGHT) ||
			Bt(kbd.down_bitmap, Char2ScanCode('d'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	if (up || down || left || right || enter)
	{
		if (!ut_menu_nav_latched)
		{
			ut_menu_nav_latched = TRUE;
			if (up)
			{
				ut_menu_sel--;
				if (ut_menu_sel < 0)
					ut_menu_sel = UT_MENU_N - 1;
			}
			else if (down)
			{
				ut_menu_sel++;
				if (ut_menu_sel >= UT_MENU_N)
					ut_menu_sel = 0;
			}
			else if (left)
				UTMenuAdjust(-1);
			else if (right)
				UTMenuAdjust(1);
			else if (enter)
				UTMenuActivate;
		}
	}
	else
		ut_menu_nav_latched = FALSE;
}

U0 UTMenuDraw(CUTCanvas *c)
{
	I64 i;
	I64 y;
	I64 col;
	I64 x0;
	I64 bar_w;

	if (!c || !ut_menu_open)
		return;
	UTMenuFill(c, 40, 30, c->width - 80, c->height - 60, 12);
	UTMenuFill(c, 42, 32, c->width - 84, 10, 40);

	y = 50;
	i = 0;
	while (i < UT_MENU_N)
	{
		col = 80;
		if (i == ut_menu_sel)
			col = 250;
		x0 = 56;
		UTMenuFill(c, x0, y, 8, 8, col);
		if (i == UT_MENU_MAP)
		{
			UTMenuNumber(c, x0 + 16, y, ut_map_cat_i + 1, col);
			UTMenuNumber(c, x0 + 48, y, ut_map_cat_n, 100);
		}
		else if (i == UT_MENU_MODE)
			UTMenuNumber(c, x0 + 16, y, ut_menu_mode, col);
		else if (i == UT_MENU_FRAG)
			UTMenuNumber(c, x0 + 16, y, ut_menu_frag, col);
		else if (i == UT_MENU_BOTS)
			UTMenuNumber(c, x0 + 16, y, ut_menu_bots, col);
		else if (i == UT_MENU_GO)
			UTMenuFill(c, x0 + 16, y + 2, 40, 4, col);
		else if (i == UT_MENU_QUIT)
			UTMenuFill(c, x0 + 16, y + 2, 24, 4, 40);
		y += 16;
		i++;
	}
	bar_w = ut_menu_frag;
	if (bar_w > 100)
		bar_w = 100;
	UTMenuFill(c, 56, c->height - 48, bar_w, 4, 180);
}
