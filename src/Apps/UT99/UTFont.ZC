// SoftDrv UI text.
// Glyphs come from ZealOS GrFont TTF (::/System/Gr/UISANS.TTF), stamped onto
// SoftDrv P8 pens. UFont from UWindowFonts.utx is optional.
// Upstream UFont: Engine/Inc/UnTex.h FFontCharacter / FFontPage / UFont.

#define UT_FONT_PAGE_MAX	8
#define UT_FONT_CHAR_MAX	2048

class CUTFontChar
{
	I64 start_u;
	I64 start_v;
	I64 u_size;
	I64 v_size;
};

class CUTFontPage
{
	CUTTex		 tex;
	Bool		 tex_ok;
	I64			 n_chars;
	CUTFontChar	*chars;
};

class CUTFont
{
	U8			 name[64];
	I64			 n_pages;
	CUTFontPage	 pages[UT_FONT_PAGE_MAX];
	I64			 line_h;
	Bool		 ready;
};

CUTFont	ut_font_ui;
Bool	ut_font_ready = FALSE;
Bool	ut_ttf_ready = FALSE;
Bool	ut_ufont_ready = FALSE;
Bool	ut_font_zeroed = FALSE;	//TRUE after first MemSet; Free safe thereafter
I64		ut_ttf_px = 12;
I64		ut_ttf_px_big = 16;

U0 UTFontPageFree(CUTFontPage *p)
{
	if (!p)
		return;
	if (p->chars)
		Free(p->chars);
	p->chars = NULL;
	p->n_chars = 0;
	if (p->tex_ok)
		UTTexFreeMips(&p->tex);
	p->tex_ok = FALSE;
}

U0 UTFontFree(CUTFont *f)
{
	I64 i;

	if (!f)
		return;
	i = 0;
	while (i < f->n_pages && i < UT_FONT_PAGE_MAX)
	{
		UTFontPageFree(&f->pages[i]);
		i++;
	}
	MemSet(f, 0, sizeof(CUTFont));
}

Bool UTFontReadPage(CUTArc *ar, CUTPackage *pkg, CUTFontPage *p)
{//FFontPage << Texture << Characters
	I64 tex_ref;
	I64 nch;
	I64 i;
	I64 exp_i;
	CUTFontChar *ch;

	if (!ar || !pkg || !p)
		return FALSE;
	MemSet(p, 0, sizeof(CUTFontPage));
	UTTexInit(&p->tex);
	tex_ref = UTArcIndex(ar);
	nch = UTArcIndex(ar);
	if (ar->err || nch < 1 || nch > UT_FONT_CHAR_MAX)
		return FALSE;
	if (tex_ref > 0)
	{
		exp_i = tex_ref - 1;
		if (exp_i >= 0 && exp_i < pkg->export_count)
		{
			if (UTTexLoadExport(pkg, exp_i, &p->tex))
				p->tex_ok = TRUE;
		}
	}
	p->chars = CAlloc(sizeof(CUTFontChar) * nch);
	if (!p->chars)
		return FALSE;
	p->n_chars = nch;
	i = 0;
	while (i < nch)
	{
		ch = &p->chars[i];
		ch->start_u = UTArcI32(ar);
		ch->start_v = UTArcI32(ar);
		ch->u_size  = UTArcI32(ar);
		ch->v_size  = UTArcI32(ar);
		if (ar->err)
			return FALSE;
		i++;
	}
	return TRUE;
}

Bool UTFontLoadExport(CUTPackage *pkg, I64 exp_i, CUTFont *f)
{//UFont native after property None.
	CUTArc ar;
	CUTExport *e;
	I64 n_pages;
	I64 i;
	I64 lh;
	CUTFontPage *pg;

	if (!pkg || !f || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (!UTPkgArcExport(pkg, exp_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
		ar.err = FALSE;
	UTFontFree(f);
	StrPrint(f->name, "%s", UTPkgNameStr(pkg, e->name_index));
	n_pages = UTArcIndex(&ar);
	if (ar.err || n_pages < 1 || n_pages > UT_FONT_PAGE_MAX)
		return FALSE;
	lh = 0;
	i = 0;
	while (i < n_pages)
	{
		pg = &f->pages[i];
		if (!UTFontReadPage(&ar, pkg, pg))
		{
			UTFontPageFree(pg);
			return FALSE;
		}
		if (pg->n_chars > 0 && pg->chars[0].v_size > lh)
			lh = pg->chars[0].v_size;
		if (pg->n_chars > 65 && pg->chars[65].v_size > lh)
			lh = pg->chars[65].v_size;
		f->n_pages++;
		i++;
	}
	if (lh < 8)
		lh = 12;
	f->line_h = lh;
	f->ready = f->n_pages > 0 && f->pages[0].tex_ok;
	return f->ready;
}

Bool UTFontLoadNamed(U8 *utx_path, U8 *font_name, CUTFont *f)
{
	CUTPackage *pkg;
	I64 i;
	Bool ok;

	pkg = UTPkgLoad(utx_path);
	if (!pkg)
		return FALSE;
	i = UTPkgFindExport(pkg, "Font", font_name);
	if (i < 0)
		i = UTPkgFindExport(pkg, "Font", NULL);
	ok = FALSE;
	if (i >= 0)
		ok = UTFontLoadExport(pkg, i, f);
	UTPkgFree(pkg);
	return ok;
}

CUTFontChar *UTFontGlyph(CUTFont *f, I64 ch, CUTFontPage **out_page)
{//Remap absent; ASCII index into page0.
	CUTFontPage *p;
	I64 idx;

	if (out_page)
		*out_page = NULL;
	if (!f || !f->ready || f->n_pages < 1)
		return NULL;
	if (ch < 0)
		ch = 0;
	if (ch > 255)
		ch = 32;
	p = &f->pages[0];
	idx = ch;
	if (idx >= p->n_chars)
		idx = 32;
	if (idx >= p->n_chars)
		return NULL;
	if (out_page)
		*out_page = p;
	return &p->chars[idx];
}

I64 UTFontTextW(CUTFont *f, U8 *s)
{
	I64 w;
	CUTFontChar *g;
	CUTFontPage *p;

	w = 0;
	if (!f || !s)
		return 0;
	while (*s)
	{
		g = UTFontGlyph(f, *s, &p);
		if (g && g->u_size > 0)
			w += g->u_size;
		else
			w += 6;
		s++;
	}
	return w;
}

U0 UTFontEnsureTTF()
{
	I64 fsz;
	U8 *fbuf;

	fsz = 0;
	if (grf_ready && grf_ui_font.ok)
	{
		ut_ttf_ready = TRUE;
		UTLog("UTFont: TTF already loaded (GrFont)\n");
		return;
	}
	if (!FileFind("::/System/Gr/UISANS.TTF"))
	{
		"UTFont: TTF FAIL path=::/System/Gr/UISANS.TTF (FileFind)\n";
		UTLog("UTFont: TTF FAIL ::/System/Gr/UISANS.TTF FileFind\n");
		ut_ttf_ready = FALSE;
		return;
	}
	fbuf = FileRead("::/System/Gr/UISANS.TTF", &fsz);
	if (!fbuf || fsz < 12)
	{
		"UTFont: TTF FAIL path=::/System/Gr/UISANS.TTF size=%d\n", fsz;
		UTLog("UTFont: TTF FAIL ::/System/Gr/UISANS.TTF size=%d\n", fsz);
		if (fbuf)
			Free(fbuf);
		ut_ttf_ready = FALSE;
		return;
	}
	GrFontInit(fbuf, fsz);
	Free(fbuf);
	ut_ttf_ready = grf_ready && grf_ui_font.ok;
	if (ut_ttf_ready)
	{
		"UTFont: TTF loaded ::/System/Gr/UISANS.TTF\n";
		UTLog("UTFont: TTF loaded UISANS\n");
	}
	else
	{
		"UTFont: TTF FAIL path=::/System/Gr/UISANS.TTF (GrFontInit)\n";
		UTLog("UTFont: TTF FAIL GrFontInit\n");
	}
}

U0 UTFontInit()
{
	if (ut_font_zeroed)
		UTFontFree(&ut_font_ui);
	else
	{
		MemSet(&ut_font_ui, 0, sizeof(CUTFont));
		ut_font_zeroed = TRUE;
	}
	ut_font_ready = FALSE;
	ut_ttf_ready = FALSE;
	ut_ufont_ready = FALSE;
	ut_ttf_px = 12;
	ut_ttf_px_big = 16;

	UTFontEnsureTTF;

	if (FileFind("::/Apps/UT99/Textures/UWindowFonts.utx"))
	{
		if (UTFontLoadNamed("::/Apps/UT99/Textures/UWindowFonts.utx",
			"TahomaB10", &ut_font_ui))
			ut_ufont_ready = TRUE;
		else if (UTFontLoadNamed("::/Apps/UT99/Textures/UWindowFonts.utx",
			"UTFont12", &ut_font_ui))
			ut_ufont_ready = TRUE;
		else if (UTFontLoadNamed("::/Apps/UT99/Textures/UWindowFonts.utx",
			"Tahoma13", &ut_font_ui))
			ut_ufont_ready = TRUE;
	}
	if (ut_ufont_ready)
		UTLog("UTFont: optional UFont %s pages=%d line=%d\n",
			ut_font_ui.name, ut_font_ui.n_pages, ut_font_ui.line_h);

	if (ut_ttf_ready)
		ut_font_ready = TRUE;
	else if (ut_ufont_ready)
		ut_font_ready = TRUE;

	if (!ut_ttf_ready)
	{
		"UTFont: primary TTF unavailable - tried ::/System/Gr/UISANS.TTF\n";
		UTLog("UTFont: primary TTF unavailable\n");
	}
}

U0 UTFontExit()
{
	if (ut_font_zeroed)
		UTFontFree(&ut_font_ui);
	ut_font_ready = FALSE;
	ut_ttf_ready = FALSE;
	ut_ufont_ready = FALSE;
}
