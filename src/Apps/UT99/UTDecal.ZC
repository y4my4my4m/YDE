// UTDecal.ZC - SoftDrv blood / scorch marks.
//
// Prefer Botpack BloodSplat / Scorch Texture mips when loadable; else P8 quads.

#define UT_DECAL_MAX		96
#define UT_DECAL_BLOOD		1
#define UT_DECAL_SCORCH		2

class CUTDecal
{
	F64	 origin[3];
	F64	 normal[3];
	F64	 life;
	F64	 life0;
	F64	 size;
	I64	 kind;
	I64	 color;
	Bool alive;
};

CUTDecal	ut_decals[UT_DECAL_MAX];
Bool		ut_decal_ready	= FALSE;
CUTTex		ut_decal_blood;
Bool		ut_decal_blood_ok	= FALSE;
CUTTex		ut_decal_scorch;
Bool		ut_decal_scorch_ok	= FALSE;

U0 UTDecalInit()
{
	MemSet(ut_decals, 0, sizeof(ut_decals));
	ut_decal_ready = TRUE;
	ut_decal_blood_ok = UTTexLoadNamed("::/Apps/UT99/System/Botpack.u",
		"BloodSplat", &ut_decal_blood);
	if (!ut_decal_blood_ok)
		ut_decal_blood_ok = UTTexLoadNamed("::/Apps/UT99/System/Botpack.u",
			"BloodSplat1", &ut_decal_blood);
	ut_decal_scorch_ok = UTTexLoadNamed("::/Apps/UT99/System/Botpack.u",
		"Scorch", &ut_decal_scorch);
	if (!ut_decal_scorch_ok)
		ut_decal_scorch_ok = UTTexLoadNamed("::/Apps/UT99/System/Botpack.u",
			"BoltScorch", &ut_decal_scorch);
	UTLog("UTDecal: blood=%d scorch=%d\n",
		ToI64(ut_decal_blood_ok), ToI64(ut_decal_scorch_ok));
}

U0 UTDecalSpawnEx(F64 *org, F64 *nrm, I64 kind)
{
	I64 i;
	CUTDecal *d;
	F64 len;

	if (!org || !ut_decal_ready)
		return;
	i = 0;
	while (i < UT_DECAL_MAX)
	{
		if (!ut_decals[i].alive)
		{
			d = &ut_decals[i];
			UTVecCopy(org, d->origin);
			if (nrm)
			{
				UTVecCopy(nrm, d->normal);
				len = Sqrt(d->normal[0] * d->normal[0] +
					d->normal[1] * d->normal[1] +
					d->normal[2] * d->normal[2]);
				if (len > 0.001)
				{
					d->normal[0] /= len;
					d->normal[1] /= len;
					d->normal[2] /= len;
				}
				else
				{
					d->normal[0] = 0; d->normal[1] = 0; d->normal[2] = 1;
				}
			}
			else
			{
				d->normal[0] = 0; d->normal[1] = 0; d->normal[2] = 1;
			}
			d->kind = kind;
			d->alive = TRUE;
			if (kind == UT_DECAL_BLOOD)
			{
				d->life = 6.0;
				d->life0 = 6.0;
				d->size = 14.0 + ToF64(i & 3) * 2.0;
				d->color = 40;
			}
			else
			{
				d->life = 8.0;
				d->life0 = 8.0;
				d->size = 32.0;
				d->color = 16;
			}
			return;
		}
		i++;
	}
}

U0 UTDecalSpawn(F64 *org, I64 kind)
{
	UTDecalSpawnEx(org, NULL, kind);
}

U0 UTDecalBlood(F64 *org)
{
	F64 p[3];
	F64 n[3];
	I64 i;

	if (!org)
		return;
	n[0] = 0; n[1] = 0; n[2] = 1;
	i = 0;
	while (i < 5)
	{
		p[0] = org[0] + Sin(ToF64(i) * 1.7) * (6.0 + ToF64(i) * 3.0);
		p[1] = org[1] + Cos(ToF64(i) * 1.7) * (6.0 + ToF64(i) * 3.0);
		p[2] = org[2] + ToF64(i & 1) * 3.0;
		UTDecalSpawnEx(p, n, UT_DECAL_BLOOD);
		i++;
	}
	UTFxBlood(org);
}

U0 UTDecalScorch(F64 *org)
{
	F64 n[3];

	if (!org)
		return;
	n[0] = 0; n[1] = 0; n[2] = 1;
	UTDecalSpawnEx(org, n, UT_DECAL_SCORCH);
	UTFxScorch(org);
}

U0 UTDecalTick(F64 dt)
{
	I64 i;

	i = 0;
	while (i < UT_DECAL_MAX)
	{
		if (ut_decals[i].alive)
		{
			ut_decals[i].life -= dt;
			if (ut_decals[i].life <= 0.0)
				ut_decals[i].alive = FALSE;
		}
		i++;
	}
}

U0 UTDecalDrawQuad(CUTCanvas *c, CUTDecal *d)
{//axis-aligned quad from normal (SoftDrv blood/scorch stand-in).
	F64 s;
	F64 hx[3];
	F64 hy[3];
	F64 o[3];
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 dd[3];
	F64 fade;

	if (!c || !d)
		return;
	fade = d->life / d->life0;
	if (fade < 0.15)
		fade = 0.15;
	s = d->size * (0.55 + 0.45 * fade);
	if (Abs(d->normal[2]) < 0.9)
	{
		hx[0] = d->normal[1];
		hx[1] = -d->normal[0];
		hx[2] = 0;
	}
	else
	{
		hx[0] = 1; hx[1] = 0; hx[2] = 0;
	}
	UTVecNormalize(hx);
	hy[0] = d->normal[1] * hx[2] - d->normal[2] * hx[1];
	hy[1] = d->normal[2] * hx[0] - d->normal[0] * hx[2];
	hy[2] = d->normal[0] * hx[1] - d->normal[1] * hx[0];
	UTVecNormalize(hy);
	o[0] = d->origin[0] + d->normal[0] * 1.5;
	o[1] = d->origin[1] + d->normal[1] * 1.5;
	o[2] = d->origin[2] + d->normal[2] * 1.5;
	a[0] = o[0] - hx[0] * s - hy[0] * s;
	a[1] = o[1] - hx[1] * s - hy[1] * s;
	a[2] = o[2] - hx[2] * s - hy[2] * s;
	b[0] = o[0] + hx[0] * s - hy[0] * s;
	b[1] = o[1] + hx[1] * s - hy[1] * s;
	b[2] = o[2] + hx[2] * s - hy[2] * s;
	cc[0] = o[0] + hx[0] * s + hy[0] * s;
	cc[1] = o[1] + hx[1] * s + hy[1] * s;
	cc[2] = o[2] + hx[2] * s + hy[2] * s;
	dd[0] = o[0] - hx[0] * s + hy[0] * s;
	dd[1] = o[1] - hx[1] * s + hy[1] * s;
	dd[2] = o[2] - hx[2] * s + hy[2] * s;
	if (d->kind == UT_DECAL_BLOOD && ut_decal_blood_ok)
	{
		UTDrawTriTex3(c, a, b, cc, 0, 0, 1, 0, 1, 1, &ut_decal_blood, NULL);
		UTDrawTriTex3(c, a, cc, dd, 0, 0, 1, 1, 0, 1, &ut_decal_blood, NULL);
	}
	else if (d->kind == UT_DECAL_SCORCH && ut_decal_scorch_ok)
	{
		UTDrawTriTex3(c, a, b, cc, 0, 0, 1, 0, 1, 1, &ut_decal_scorch, NULL);
		UTDrawTriTex3(c, a, cc, dd, 0, 0, 1, 1, 0, 1, &ut_decal_scorch, NULL);
	}
	else
	{
		UTDrawTri3(c, a, b, cc, d->color);
		UTDrawTri3(c, a, cc, dd, d->color);
	}
}

U0 UTDecalDraw(CUTCanvas *c)
{
	I64 i;

	if (!c || !ut_decal_ready)
		return;
	i = 0;
	while (i < UT_DECAL_MAX)
	{
		if (ut_decals[i].alive)
			UTDecalDrawQuad(c, &ut_decals[i]);
		i++;
	}
}

U0 UTDecalExit()
{
	if (ut_decal_blood_ok)
		UTTexFreeMips(&ut_decal_blood);
	ut_decal_blood_ok = FALSE;
	if (ut_decal_scorch_ok)
		UTTexFreeMips(&ut_decal_scorch);
	ut_decal_scorch_ok = FALSE;
	MemSet(ut_decals, 0, sizeof(ut_decals));
	ut_decal_ready = FALSE;
}
