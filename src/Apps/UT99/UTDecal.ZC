// UTDecal.ZC - SoftDrv blood / scorch marks (no texture sprites).
//
// Hitscan / splash spawn short-lived world tris. SoftDrv fills as P8 colors.

#define UT_DECAL_MAX		64
#define UT_DECAL_BLOOD		1
#define UT_DECAL_SCORCH		2

class CUTDecal
{
	F64	 origin[3];
	F64	 life;
	F64	 size;
	I64	 kind;
	I64	 color;
	Bool alive;
};

CUTDecal	ut_decals[UT_DECAL_MAX];
Bool		ut_decal_ready	= FALSE;

U0 UTDecalInit()
{
	MemSet(ut_decals, 0, sizeof(ut_decals));
	ut_decal_ready = TRUE;
}

U0 UTDecalSpawn(F64 *org, I64 kind)
{
	I64 i;
	CUTDecal *d;

	if (!org || !ut_decal_ready)
		return;
	i = 0;
	while (i < UT_DECAL_MAX)
	{
		if (!ut_decals[i].alive)
		{
			d = &ut_decals[i];
			UTVecCopy(org, d->origin);
			d->kind = kind;
			d->alive = TRUE;
			if (kind == UT_DECAL_BLOOD)
			{
				d->life = 2.5;
				d->size = 12.0;
				d->color = 40;
			}
			else
			{
				d->life = 4.0;
				d->size = 28.0;
				d->color = 16;
			}
			return;
		}
		i++;
	}
}

U0 UTDecalBlood(F64 *org)
{
	F64 p[3];
	I64 i;

	if (!org)
		return;
	i = 0;
	while (i < 3)
	{
		p[0] = org[0] + Sin(ToF64(i) * 2.1) * 8.0;
		p[1] = org[1] + Cos(ToF64(i) * 2.1) * 8.0;
		p[2] = org[2] + ToF64(i) * 4.0;
		UTDecalSpawn(p, UT_DECAL_BLOOD);
		i++;
	}
}

U0 UTDecalScorch(F64 *org)
{
	UTDecalSpawn(org, UT_DECAL_SCORCH);
}

U0 UTDecalTick(F64 dt)
{
	I64 i;

	i = 0;
	while (i < UT_DECAL_MAX)
	{
		if (ut_decals[i].alive)
		{
			ut_decals[i].life -= dt;
			if (ut_decals[i].life <= 0.0)
				ut_decals[i].alive = FALSE;
		}
		i++;
	}
}

U0 UTDecalDraw(CUTCanvas *c)
{
	I64 i;
	CUTDecal *d;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 s;

	if (!c || !ut_decal_ready)
		return;
	i = 0;
	while (i < UT_DECAL_MAX)
	{
		d = &ut_decals[i];
		if (d->alive)
		{
			s = d->size * (0.4 + 0.6 * (d->life / 4.0));
			a[0] = d->origin[0] - s; a[1] = d->origin[1] - s; a[2] = d->origin[2];
			b[0] = d->origin[0] + s; b[1] = d->origin[1] - s; b[2] = d->origin[2];
			cc[0] = d->origin[0]; cc[1] = d->origin[1] + s;
			cc[2] = d->origin[2] + s * 0.3;
			UTDrawTri3(c, a, b, cc, d->color);
		}
		i++;
	}
}

U0 UTDecalExit()
{
	MemSet(ut_decals, 0, sizeof(ut_decals));
	ut_decal_ready = FALSE;
}
