// UTLink.ZC - resolve map object refs → Texture names → .utx P8 loads.
//
// Map imports name packages as groups (Wall, Base); files are UTcrypt.utx etc.
// Resolve by texture object name across Textures/*.utx export tables.

//DM-Codex alone needs ~200 distinct textures; menu/HUD/fonts claim slots
//first, so 128 left every map surface unresolved.
#define UT_LINK_MAX_TEX		1024
#define UT_LINK_MAX_CAT		8192
#define UT_LINK_PATH_SIZE	96

class CUTLinkTex
{
	U8		name[64];
	U8		path[UT_LINK_PATH_SIZE];
	I64		exp_i;
	CUTTex	tex;
	Bool	loaded;
	Bool	failed;
};

class CUTLinkCat
{//lightweight name → file catalog (tables only, no mip decode)
	U8	name[64];
	U8	path[UT_LINK_PATH_SIZE];
	I64	exp_i;
};

CUTLinkTex	ut_link_tex[UT_LINK_MAX_TEX];
I64			ut_link_tex_n	= 0;
CUTLinkCat	ut_link_cat[UT_LINK_MAX_CAT];
I64			ut_link_cat_n	= 0;
Bool		ut_link_cat_ready	= FALSE;
Bool		ut_link_slots_full	= FALSE;
I64			ut_link_fail_logged	= 0;

U0 UTLinkCatClear()
{
	ut_link_cat_n = 0;
	ut_link_cat_ready = FALSE;
}

Bool UTLinkCatAdd(U8 *name, U8 *path, I64 exp_i)
{
	CUTLinkCat *c;

	if (ut_link_cat_n >= UT_LINK_MAX_CAT)
		return FALSE;
	c = &ut_link_cat[ut_link_cat_n];
	StrPrint(c->name, "%s", name);
	StrPrint(c->path, "%s", path);
	c->exp_i = exp_i;
	ut_link_cat_n++;
	return TRUE;
}

U0 UTLinkScanUtx(U8 *path)
{//index Texture exports from one .utx (tables only).
	CUTPackage *pkg;
	I64 i;
	U8 *cls;

	pkg = UTPkgLoad(path);
	if (!pkg)
	{
		UTLog("UTLink: scan FAILED %s\n", path);
		return;
	}
	i = 0;
	while (i < pkg->export_count)
	{
		cls = UTPkgClassName(pkg, pkg->exports[i].class_index);
		if (!StrCompare(cls, "Texture") || !StrCompare(cls, "WetTexture") ||
			!StrCompare(cls, "FireTexture") || !StrCompare(cls, "IceTexture") ||
			!StrCompare(cls, "WaveTexture"))
		{
			UTLinkCatAdd(UTPkgNameStr(pkg, pkg->exports[i].name_index),
				path, i);
		}
		i++;
	}
	UTPkgFree(pkg);
}

U0 UTLinkBuildCatalog()
{//scan ::/Apps/UT99/Textures/*.utx once per session.
	CDirEntry *de;
	CDirEntry *tmp;
	U8 path[256];

	if (ut_link_cat_ready)
		return;
	UTLinkCatClear;
	de = FilesFind("::/Apps/UT99/Textures/*.utx", FUF_JUST_FILES);
	tmp = de;
	while (tmp)
	{
		StrPrint(path, "%s", tmp->full_name);
		UTLinkScanUtx(path);
		tmp = tmp->next;
	}
	DirTreeDel(de);
	ut_link_cat_ready = TRUE;
	UTLog("UTLink: catalog %d textures\n", ut_link_cat_n);
}

I64 UTLinkCatFind(U8 *name)
{
	I64 i;

	if (!name || !name[0])
		return -1;
	i = 0;
	while (i < ut_link_cat_n)
	{
		if (!StrCompare(ut_link_cat[i].name, name))
			return i;
		i++;
	}
	return -1;
}

U8 *UTLinkObjName(CUTPackage *pkg, I64 obj_ref)
{//object ref → object name string. "" if None/bad.
	I64 ii;

	if (!pkg || obj_ref == 0)
		return "";
	if (obj_ref < 0)
	{
		ii = -obj_ref - 1;
		if (ii < 0 || ii >= pkg->import_count)
			return "";
		return UTPkgNameStr(pkg, pkg->imports[ii].object_name);
	}
	ii = obj_ref - 1;
	if (ii < 0 || ii >= pkg->export_count)
		return "";
	return UTPkgNameStr(pkg, pkg->exports[ii].name_index);
}

U8 *UTLinkObjPkg(CUTPackage *pkg, I64 obj_ref)
{//import package/group name for a negative object ref.
	I64 ii;
	I64 pkg_i;
	I64 depth;
	U8 *root;

	if (!pkg || obj_ref >= 0)
		return "";
	ii = -obj_ref - 1;
	if (ii < 0 || ii >= pkg->import_count)
		return "";
	//Outermost Package is the file; inner ones are groups (Wall, Base).
	pkg_i = pkg->imports[ii].package_index;
	depth = 0;
	root = "";
	while (pkg_i < 0 && depth < 6)
	{
		ii = -pkg_i - 1;
		if (ii < 0 || ii >= pkg->import_count)
			break;
		if (!StrCompare(UTPkgNameStr(pkg, pkg->imports[ii].class_name),
			"Package"))
			root = UTPkgNameStr(pkg, pkg->imports[ii].object_name);
		pkg_i = pkg->imports[ii].package_index;
		depth++;
	}
	return root;
}

I64 UTLinkTexSlot(U8 *name)
{//find or alloc cache slot by texture name.
	I64 i;
	CUTLinkTex *t;

	i = 0;
	while (i < ut_link_tex_n)
	{
		if (!StrCompare(ut_link_tex[i].name, name))
			return i;
		i++;
	}
	if (ut_link_tex_n >= UT_LINK_MAX_TEX)
	{
		if (!ut_link_slots_full)
		{
			ut_link_slots_full = TRUE;
			UTLog("UTLink: texture slots exhausted (%d)\n", UT_LINK_MAX_TEX);
		}
		return -1;
	}
	t = &ut_link_tex[ut_link_tex_n];
	MemSet(t, 0, sizeof(CUTLinkTex));
	StrPrint(t->name, "%s", name);
	UTTexInit(&t->tex);
	i = ut_link_tex_n;
	ut_link_tex_n++;
	return i;
}

I64 ut_link_detail_depth = 0;

//Defined below; the return value is assigned here, so the type must be known.
extern CUTTex *UTLinkLoadTex(U8 *name);

U0 UTLinkBindDetailMacro(CUTPackage *pkg, CUTLinkTex *t)
{//UTexture.DetailTexture + MacroTexture ObjectProperty → cached CUTTex*.
	CUTExport *e;
	I64 ref;
	U8 *nm;
	CUTTex *dt;

	if (!pkg || !t || t->exp_i < 0 || t->exp_i >= pkg->export_count)
		return;
	if (ut_link_detail_depth > 1)
		return;
	e = &pkg->exports[t->exp_i];
	t->tex.detail = NULL;
	t->tex.macro = NULL;
	ut_link_detail_depth++;
	if (UTPropFindObjectRef(pkg, e->serial_offset, e->serial_size,
		e->object_flags, "DetailTexture", &ref))
	{
		nm = UTLinkObjName(pkg, ref);
		if (nm[0])
		{
			dt = UTLinkLoadTex(nm);
			if (dt)
				t->tex.detail = dt;
		}
	}
	if (UTPropFindObjectRef(pkg, e->serial_offset, e->serial_size,
		e->object_flags, "MacroTexture", &ref))
	{
		nm = UTLinkObjName(pkg, ref);
		if (nm[0])
		{
			dt = UTLinkLoadTex(nm);
			if (dt)
				t->tex.macro = dt;
		}
	}
	ut_link_detail_depth--;
}

CUTTex *UTLinkLoadTex(U8 *name)
{
	I64 slot;
	I64 cat;
	CUTLinkTex *t;
	CUTPackage *pkg;

	if (!name || !name[0])
		return NULL;
	UTLinkBuildCatalog;
	slot = UTLinkTexSlot(name);
	if (slot < 0)
		return NULL;
	t = &ut_link_tex[slot];
	if (t->loaded)
		return &t->tex;
	if (t->failed)
		return NULL;
	cat = UTLinkCatFind(name);
	if (cat < 0)
	{
		if (ut_link_fail_logged < 6)
		{
			ut_link_fail_logged++;
			UTLog("UTLink: '%s' not in catalog\n", name);
		}
		t->failed = TRUE;
		return NULL;
	}
	StrPrint(t->path, "%s", ut_link_cat[cat].path);
	t->exp_i = ut_link_cat[cat].exp_i;
	pkg = UTPkgLoad(t->path);
	if (!pkg)
	{
		t->failed = TRUE;
		return NULL;
	}
	if (!UTTexLoadExport(pkg, t->exp_i, &t->tex))
	{
		if (ut_link_fail_logged < 6)
		{
			ut_link_fail_logged++;
			UTLog("UTLink: '%s' decode FAILED exp=%d in %s\n",
				name, t->exp_i, t->path);
		}
		UTPkgFree(pkg);
		t->failed = TRUE;
		return NULL;
	}
	t->loaded = TRUE;
	//SoftDrv DrawSurf: Texture.DetailTexture / MacroTexture when exported.
	UTLinkBindDetailMacro(pkg, t);
	UTPkgFree(pkg);
	UTLog("UTLink: %s <- %s\n", name, t->path);
	return &t->tex;
}

CUTTex *UTLinkResolve(CUTPackage *pkg, I64 obj_ref, CUTTex *fallback)
{
	U8 *nm;
	CUTTex *t;

	nm = UTLinkObjName(pkg, obj_ref);
	if (!nm[0])
		return fallback;
	t = UTLinkLoadTex(nm);
	if (t)
		return t;
	return fallback;
}

U0 UTLinkFreeAll()
{//drop decoded mips; keep name→file catalog.
	I64 i;

	i = 0;
	while (i < ut_link_tex_n)
	{
		UTTexFreeMips(&ut_link_tex[i].tex);
		i++;
	}
	ut_link_tex_n = 0;
}

U0 UTLinkBindSurfs(CUTPackage *pkg, CUTBsp *b, CUTTex **out_slots)
{//fill out_slots[num_surfs] with resolved CUTTex* (may share).
	I64 i;
	CUTTex *fb;
	I64 nreal;
	I64 nfb_logged;

	nfb_logged = 0;
	if (!b || !out_slots)
		return;
	fb = &ut_tex_checker;
	nreal = 0;
	i = 0;
	while (i < b->num_surfs)
	{
		out_slots[i] = UTLinkResolve(pkg, b->surfs[i].texture, fb);
		if (out_slots[i] != fb)
			nreal++;
		i++;
	}
	UTLog("UTLink: bound %d/%d surf textures (%d fallback)\n",
		nreal, b->num_surfs, b->num_surfs - nreal);
}
