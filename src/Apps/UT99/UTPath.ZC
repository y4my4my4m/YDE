// UTPath.ZC - NavigationPoint / PathNode scan for SoftDrv bot AI.
//
// When map exports PathNode (or InventorySpot / AmbushPoint / DefensePoint /
// PatrolPoint / LiftCenter), bots greedy-walk node→goal. Patrol idle loops
// PatrolPoints; LiftCenter preferred when goal is far above.

#define UT_PATH_MAX		160
#define UT_PATH_KIND_NODE	0
#define UT_PATH_KIND_PATROL	1
#define UT_PATH_KIND_LIFT	2
#define UT_PATH_KIND_SPOT	3
#define UT_PATH_KIND_AMBUSH	4
#define UT_PATH_KIND_DEFENSE	5
#define UT_PATH_LINK_MAX	6

class CUTPathNode
{
	F64	 origin[3];
	I64	 kind;
	Bool alive;
};

CUTPathNode	ut_path[UT_PATH_MAX];
I64			ut_path_n		= 0;
Bool		ut_path_ready	= FALSE;
I64			ut_path_patrol_n	= 0;
I64			ut_path_lift_n		= 0;
I64			ut_path_spot_n		= 0;
I64			ut_path_ambush_n	= 0;
I64			ut_path_defense_n	= 0;
I64			ut_path_link[UT_PATH_MAX][UT_PATH_LINK_MAX];
I64			ut_path_link_n[UT_PATH_MAX];
I64			ut_path_bfs_q[UT_PATH_MAX];
I64			ut_path_bfs_parent[UT_PATH_MAX];
I64			ut_path_bfs_seen[UT_PATH_MAX];

Bool UTPathClassMatch(U8 *cls)
{
	if (!cls)
		return FALSE;
	if (!StrCompare(cls, "PathNode"))
		return TRUE;
	if (!StrCompare(cls, "InventorySpot"))
		return TRUE;
	if (!StrCompare(cls, "Ambushpoint") || !StrCompare(cls, "AmbushPoint"))
		return TRUE;
	if (!StrCompare(cls, "DefensePoint"))
		return TRUE;
	if (!StrCompare(cls, "PatrolPoint"))
		return TRUE;
	if (!StrCompare(cls, "LiftCenter") || !StrCompare(cls, "LiftExit"))
		return TRUE;
	return FALSE;
}

I64 UTPathKindFromClass(U8 *cls)
{
	if (!cls)
		return UT_PATH_KIND_NODE;
	if (!StrCompare(cls, "PatrolPoint"))
		return UT_PATH_KIND_PATROL;
	if (!StrCompare(cls, "LiftCenter") || !StrCompare(cls, "LiftExit"))
		return UT_PATH_KIND_LIFT;
	if (!StrCompare(cls, "Ambushpoint") || !StrCompare(cls, "AmbushPoint"))
		return UT_PATH_KIND_AMBUSH;
	if (!StrCompare(cls, "DefensePoint"))
		return UT_PATH_KIND_DEFENSE;
	if (!StrCompare(cls, "InventorySpot"))
		return UT_PATH_KIND_SPOT;
	return UT_PATH_KIND_NODE;
}

U0 UTPathClear()
{
	I64 i;

	ut_path_n = 0;
	ut_path_ready = FALSE;
	ut_path_patrol_n = 0;
	ut_path_lift_n = 0;
	ut_path_spot_n = 0;
	ut_path_ambush_n = 0;
	ut_path_defense_n = 0;
	i = 0;
	while (i < UT_PATH_MAX)
	{
		ut_path_link_n[i] = 0;
		i++;
	}
}

U0 UTPathBuildLinks()
{//Soft reach graph: link nodes within horizontal 420 / |ΔZ| 140.
	I64 i;
	I64 j;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	i = 0;
	while (i < ut_path_n)
	{
		ut_path_link_n[i] = 0;
		i++;
	}
	i = 0;
	while (i < ut_path_n)
	{
		j = i + 1;
		while (j < ut_path_n)
		{
			if (ut_path[i].alive && ut_path[j].alive)
			{
				dx = ut_path[j].origin[0] - ut_path[i].origin[0];
				dy = ut_path[j].origin[1] - ut_path[i].origin[1];
				dz = ut_path[j].origin[2] - ut_path[i].origin[2];
				d2 = dx * dx + dy * dy;
				if (d2 < 420.0 * 420.0 && Abs(dz) < 140.0)
				{
					if (ut_path_link_n[i] < UT_PATH_LINK_MAX)
					{
						ut_path_link[i][ut_path_link_n[i]] = j;
						ut_path_link_n[i]++;
					}
					if (ut_path_link_n[j] < UT_PATH_LINK_MAX)
					{
						ut_path_link[j][ut_path_link_n[j]] = i;
						ut_path_link_n[j]++;
					}
				}
			}
			j++;
		}
		i++;
	}
}

U0 UTPathScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 knd;
	CUTExport *e;
	U8 *cls;
	F64 v[3];

	UTPathClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_path_n < UT_PATH_MAX)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		if (UTPathClassMatch(cls))
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				knd = UTPathKindFromClass(cls);
				UTVecCopy(v, ut_path[ut_path_n].origin);
				ut_path[ut_path_n].kind = knd;
				ut_path[ut_path_n].alive = TRUE;
				if (knd == UT_PATH_KIND_PATROL)
					ut_path_patrol_n++;
				if (knd == UT_PATH_KIND_LIFT)
					ut_path_lift_n++;
				if (knd == UT_PATH_KIND_SPOT)
					ut_path_spot_n++;
				if (knd == UT_PATH_KIND_AMBUSH)
					ut_path_ambush_n++;
				if (knd == UT_PATH_KIND_DEFENSE)
					ut_path_defense_n++;
				ut_path_n++;
			}
		}
		i++;
	}
	ut_path_ready = (ut_path_n > 0);
	if (ut_path_ready)
		UTPathBuildLinks;
	UTLog("UTPath: %d nodes patrol=%d lift=%d spot=%d ambush=%d def=%d\n",
		ut_path_n, ut_path_patrol_n, ut_path_lift_n, ut_path_spot_n,
		ut_path_ambush_n, ut_path_defense_n);
}

I64 UTPathNearest(F64 *org)
{
	I64 i;
	I64 best;
	F64 best_d;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d;

	best = -1;
	best_d = 1.0e12;
	if (!org || !ut_path_ready)
		return -1;
	i = 0;
	while (i < ut_path_n)
	{
		if (ut_path[i].alive)
		{
			dx = ut_path[i].origin[0] - org[0];
			dy = ut_path[i].origin[1] - org[1];
			dz = ut_path[i].origin[2] - org[2];
			d = dx * dx + dy * dy + dz * dz;
			if (d < best_d)
			{
				best_d = d;
				best = i;
			}
		}
		i++;
	}
	return best;
}

I64 UTPathNextPatrol(I64 cur)
{//Cycle PatrolPoint indices.
	I64 i;
	I64 first;

	if (ut_path_patrol_n < 1)
		return -1;
	first = -1;
	i = 0;
	while (i < ut_path_n)
	{
		if (ut_path[i].alive && ut_path[i].kind == UT_PATH_KIND_PATROL)
		{
			if (first < 0)
				first = i;
			if (i > cur)
				return i;
		}
		i++;
	}
	return first;
}

I64 UTPathNearestLift(F64 *org)
{
	I64 i;
	I64 best;
	F64 best_d;
	F64 dx;
	F64 dy;
	F64 dz;
