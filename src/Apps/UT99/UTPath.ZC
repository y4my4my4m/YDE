I64 UTPathToward(F64 *from, F64 *goal)
{//Greedy + soft link hop; BFS first hop; Lift when Z gap big.
	I64 i;
	I64 best;
	I64 lift;
	I64 near;
	I64 cand;
	I64 qn;
	I64 qs;
	I64 cur;
	I64 end;
	I64 hop;
	F64 best_c;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d_from;
	F64 d_goal;
	F64 cost;
	F64 gdx;
	F64 gdy;
	F64 gdz;
	F64 g0;

	best = -1;
	best_c = 1.0e12;
	if (!from || !goal || !ut_path_ready || ut_path_n < 1)
		return -1;
	gdx = goal[0] - from[0];
	gdy = goal[1] - from[1];
	gdz = goal[2] - from[2];
	g0 = Sqrt(gdx * gdx + gdy * gdy + gdz * gdz);
	if (Abs(gdz) > 180.0 && ut_path_lift_n > 0)
	{
		lift = UTPathNearestLift(from);
		if (lift >= 0)
		{
			dx = ut_path[lift].origin[0] - from[0];
			dy = ut_path[lift].origin[1] - from[1];
			dz = ut_path[lift].origin[2] - from[2];
			d_from = Sqrt(dx * dx + dy * dy + dz * dz);
			if (d_from > 64.0)
				return lift;
		}
	}
	near = UTPathNearest(from);
	if (near >= 0 && ut_path_link_n[near] > 0)
	{
		i = 0;
		while (i < ut_path_link_n[near])
		{
			cand = ut_path_link[near][i];
			if (cand >= 0 && cand < ut_path_n && ut_path[cand].alive)
			{
				dx = goal[0] - ut_path[cand].origin[0];
				dy = goal[1] - ut_path[cand].origin[1];
				dz = goal[2] - ut_path[cand].origin[2];
				d_goal = Sqrt(dx * dx + dy * dy + dz * dz);
				dx = ut_path[cand].origin[0] - from[0];
				dy = ut_path[cand].origin[1] - from[1];
				dz = ut_path[cand].origin[2] - from[2];
				d_from = Sqrt(dx * dx + dy * dy + dz * dz);
				cost = d_from + d_goal * 0.9;
				if (d_from < 40.0)
					cost += 600.0;
				if (cost < best_c)
				{
					best_c = cost;
					best = cand;
				}
			}
			i++;
		}
		//BFS soft-reach: first hop toward closest-to-goal node
		i = 0;
		while (i < ut_path_n)
		{
			ut_path_bfs_seen[i] = 0;
			ut_path_bfs_parent[i] = -1;
			i++;
		}
		qn = 0;
		qs = 0;
		ut_path_bfs_q[qn] = near;
		qn++;
		ut_path_bfs_seen[near] = 1;
		while (qs < qn && qs < UT_PATH_MAX)
		{
			cur = ut_path_bfs_q[qs];
			qs++;
			i = 0;
			while (i < ut_path_link_n[cur])
			{
				cand = ut_path_link[cur][i];
				if (cand >= 0 && cand < ut_path_n &&
					ut_path[cand].alive && !ut_path_bfs_seen[cand])
				{
					ut_path_bfs_seen[cand] = 1;
					ut_path_bfs_parent[cand] = cur;
					ut_path_bfs_q[qn] = cand;
					qn++;
					if (qn >= UT_PATH_MAX)
						break;
				}
				i++;
			}
		}
		end = -1;
		best_c = 1.0e12;
		i = 0;
		while (i < ut_path_n)
		{
			if (ut_path_bfs_seen[i] && ut_path[i].alive)
			{
				dx = goal[0] - ut_path[i].origin[0];
				dy = goal[1] - ut_path[i].origin[1];
				dz = goal[2] - ut_path[i].origin[2];
				d_goal = Sqrt(dx * dx + dy * dy + dz * dz);
				if (d_goal < best_c)
				{
					best_c = d_goal;
					end = i;
				}
			}
			i++;
		}
		if (end >= 0 && end != near)
		{
			hop = end;
			while (ut_path_bfs_parent[hop] >= 0 &&
				ut_path_bfs_parent[hop] != near)
				hop = ut_path_bfs_parent[hop];
			if (ut_path_bfs_parent[hop] == near)
				return hop;
		}
		if (best >= 0)
			return best;
	}
	best = -1;
	best_c = 1.0e12;
	i = 0;
	while (i < ut_path_n)
	{
		if (ut_path[i].alive)
		{
			dx = ut_path[i].origin[0] - from[0];
			dy = ut_path[i].origin[1] - from[1];
			dz = ut_path[i].origin[2] - from[2];
			d_from = Sqrt(dx * dx + dy * dy + dz * dz);
			dx = goal[0] - ut_path[i].origin[0];
			dy = goal[1] - ut_path[i].origin[1];
			dz = goal[2] - ut_path[i].origin[2];
			d_goal = Sqrt(dx * dx + dy * dy + dz * dz);
			cost = d_from + d_goal;
			if (d_goal < g0 - 40.0)
				cost *= 0.85;
			if (ut_path[i].kind == UT_PATH_KIND_LIFT && Abs(gdz) > 100.0)
				cost *= 0.7;
			if (d_from < 48.0)
				cost += 800.0;
			if (cost < best_c)
			{
				best_c = cost;
				best = i;
			}
		}
		i++;
	}
	return best;
}

U0 UTPathDraw(CUTCanvas *c)
{//SoftDrv NavigationPoint debug markers + soft reach lines.
	I64 i;
	I64 j;
	I64 col;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	if (!c || !ut_opt_pathdraw || !ut_path_ready)
		return;
	i = 0;
	while (i < ut_path_n)
	{
		if (ut_path[i].alive)
		{
			col = 120;
			if (ut_path[i].kind == UT_PATH_KIND_PATROL)
				col = 180;
			else if (ut_path[i].kind == UT_PATH_KIND_LIFT)
				col = 200;
			else if (ut_path[i].kind == UT_PATH_KIND_SPOT)
				col = 160;
			else if (ut_path[i].kind == UT_PATH_KIND_AMBUSH)
				col = 40;
			else if (ut_path[i].kind == UT_PATH_KIND_DEFENSE)
				col = 90;
			a[0] = ut_path[i].origin[0] - 8;
			a[1] = ut_path[i].origin[1] - 8;
			a[2] = ut_path[i].origin[2];
			b[0] = ut_path[i].origin[0] + 8;
			b[1] = ut_path[i].origin[1] - 8;
			b[2] = ut_path[i].origin[2];
			cc[0] = ut_path[i].origin[0];
			cc[1] = ut_path[i].origin[1] + 8;
			cc[2] = ut_path[i].origin[2] + 16;
			UTDrawTri3(c, a, b, cc, col);
			j = i + 1;
			while (j < ut_path_n && j < i + 8)
			{
				if (ut_path[j].alive)
				{
					dx = ut_path[j].origin[0] - ut_path[i].origin[0];
					dy = ut_path[j].origin[1] - ut_path[i].origin[1];
					dz = ut_path[j].origin[2] - ut_path[i].origin[2];
					d2 = dx * dx + dy * dy + dz * dz;
					if (d2 < 420.0 * 420.0)
						UTDrawLine3(c, ut_path[i].origin,
							ut_path[j].origin, 80);
				}
				j++;
			}
		}
		i++;
	}
}
