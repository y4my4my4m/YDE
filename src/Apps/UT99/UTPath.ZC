	{
		if (ut_path[i].alive && ut_path[i].kind == UT_PATH_KIND_LIFT)
		{
			dx = ut_path[i].origin[0] - org[0];
			dy = ut_path[i].origin[1] - org[1];
			dz = ut_path[i].origin[2] - org[2];
			d = dx * dx + dy * dy + dz * dz;
			if (d < best_d)
			{
				best_d = d;
				best = i;
			}
		}
		i++;
	}
	return best;
}

