// tagged UnrealScript value carried by the Step stack.
//
// Separate unit: UTProp seeds FFrame locals and is compiled before UTVM.


#define UT_VT_NONE		0
#define UT_VT_INT		1
#define UT_VT_FLOAT		2
#define UT_VT_BOOL		3
#define UT_VT_BYTE		4
#define UT_VT_OBJ		5
#define UT_VT_NAME		6
#define UT_VT_STR		7
#define UT_VT_VEC		8
#define UT_VT_ROT		9
#define UT_VT_CLASS		10

//Unresolved EX_ObjectConst package refs live above every real UTObj slot.
#define UT_OBJ_PKGREF_BASE	1000000

class CUTVMVal
{//v[] = VEC xyz / ROT pitch,yaw,roll. v[0] doubles as the scalar slot for
 //INT/FLOAT/BOOL/BYTE, so scalar coercion never inspects the tag.
	I64	 tag;
	F64	 v[3];
	I64	 i;		//OBJ slot (-1 None) / NAME index / CLASS export index
	U8	*s;		//STR heap pointer; NULL for every other tag
};

//No GC. Results rotate through a fixed pool. String constants point straight
//into Script and never enter the pool.

#define UT_STR_SLOTS	64
#define UT_STR_LEN		256
#define UT_STR_POOL		16384	//UT_STR_SLOTS * UT_STR_LEN

//Flat, strided by UT_STR_LEN. ZealC globals are declared one-dimensional.
U8		ut_str_pool[UT_STR_POOL];
I64		ut_str_next	= 0;

U8 *UTVMStrSlot()
{
	U8 *p;

	p = &ut_str_pool[ut_str_next * UT_STR_LEN];
	ut_str_next++;
	if (ut_str_next >= UT_STR_SLOTS)
		ut_str_next = 0;
	p[0] = 0;
	return p;
}

U0 UTVMStrCopyN(U8 *dst, U8 *src, I64 max)
{//Truncating copy; always NUL terminated.
	I64 i;

	i = 0;
	if (!dst)
		return;
	if (src)
	{
		while (src[i] && i < max - 1)
		{
			dst[i] = src[i];
			i++;
		}
	}
	dst[i] = 0;
}

U0 UTVMValNone(CUTVMVal *o)
{
	if (!o)
		return;
	MemSet(o, 0, sizeof(CUTVMVal));
	o->tag = UT_VT_NONE;
	o->i = -1;
}

U0 UTVMValFloat(CUTVMVal *o, F64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_FLOAT;
	o->v[0] = x;
}

U0 UTVMValInt(CUTVMVal *o, I64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_INT;
	o->v[0] = ToF64(x);
}

U0 UTVMValBool(CUTVMVal *o, Bool b)
{
	UTVMValNone(o);
	o->tag = UT_VT_BOOL;
	if (b)
		o->v[0] = 1.0;
}

U0 UTVMValByte(CUTVMVal *o, I64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_BYTE;
	o->v[0] = ToF64(x & 255);
}

U0 UTVMValObj(CUTVMVal *o, I64 slot)
{
	UTVMValNone(o);
	o->tag = UT_VT_OBJ;
	o->i = slot;
}

U0 UTVMValName(CUTVMVal *o, I64 idx)
{
	UTVMValNone(o);
	o->tag = UT_VT_NAME;
	o->i = idx;
}

U0 UTVMValClass(CUTVMVal *o, I64 idx)
{
	UTVMValNone(o);
	o->tag = UT_VT_CLASS;
	o->i = idx;
}

U0 UTVMValVec(CUTVMVal *o, F64 x, F64 y, F64 z)
{
	UTVMValNone(o);
	o->tag = UT_VT_VEC;
	o->v[0] = x;
	o->v[1] = y;
	o->v[2] = z;
}

U0 UTVMValRot(CUTVMVal *o, F64 pitch, F64 yaw, F64 roll)
{
	UTVMValNone(o);
	o->tag = UT_VT_ROT;
	o->v[0] = pitch;
	o->v[1] = yaw;
	o->v[2] = roll;
}

U0 UTVMValStr(CUTVMVal *o, U8 *s)
{//Copies into the pool; safe for results built from other pool slots.
	U8 *p;

	p = UTVMStrSlot();
	UTVMStrCopyN(p, s, UT_STR_LEN);
	UTVMValNone(o);
	o->tag = UT_VT_STR;
	o->s = p;
}

U0 UTVMValStrRef(CUTVMVal *o, U8 *s)
{//Borrows storage the caller owns (Script constants, name table entries).
	UTVMValNone(o);
	o->tag = UT_VT_STR;
	o->s = s;
}

U0 UTVMValCopy(CUTVMVal *o, CUTVMVal *a)
{
	if (!o)
		return;
	if (!a)
	{
		UTVMValNone(o);
		return;
	}
	MemCopy(o, a, sizeof(CUTVMVal));
}

F64 UTVMValF(CUTVMVal *a)
{
	if (!a)
		return 0.0;
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS)
		return ToF64(a->i);
	return a->v[0];
}

I64 UTVMValI(CUTVMVal *a)
{
	if (!a)
		return 0;
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS)
		return a->i;
	return ToI64(a->v[0]);
}

Bool UTVMValB(CUTVMVal *a)
{//UnrealScript truthiness: None object is false, empty string is false.
	Bool r;

	r = FALSE;
	if (a)
	{
		if (a->tag == UT_VT_OBJ || a->tag == UT_VT_CLASS)
			r = a->i >= 0;
		else if (a->tag == UT_VT_NAME)
			r = a->i != 0;
		else if (a->tag == UT_VT_STR)
		{
			if (a->s)
				r = a->s[0] != 0;
		}
		else if (a->tag == UT_VT_VEC || a->tag == UT_VT_ROT)
			r = a->v[0] != 0.0 || a->v[1] != 0.0 || a->v[2] != 0.0;
		else
			r = a->v[0] != 0.0;
	}
	return r;
}

U8 *UTVMValS(CUTVMVal *a)
{//String view. Numeric tags render into the pool.
	U8 *p;

	p = UTVMStrSlot();
	p[0] = 0;
	if (!a)
		return p;
	if (a->tag == UT_VT_STR)
	{
		if (a->s)
			UTVMStrCopyN(p, a->s, UT_STR_LEN);
		return p;
	}
	if (a->tag == UT_VT_BOOL)
	{
		if (a->v[0] != 0.0)
			StrPrint(p, "True");
		else
			StrPrint(p, "False");
	}
	else if (a->tag == UT_VT_INT || a->tag == UT_VT_BYTE)
		StrPrint(p, "%d", ToI64(a->v[0]));
	else if (a->tag == UT_VT_FLOAT)
		StrPrint(p, "%f", a->v[0]);
	else if (a->tag == UT_VT_OBJ || a->tag == UT_VT_CLASS)
	{
		if (a->i < 0)
			StrPrint(p, "None");
		else
			StrPrint(p, "Object%d", a->i);
	}
	else if (a->tag == UT_VT_VEC || a->tag == UT_VT_ROT)
		StrPrint(p, "%f,%f,%f", a->v[0], a->v[1], a->v[2]);
	return p;
}

I64 UTVMStrCmpI(U8 *a, U8 *b)
{//ASCII case-insensitive compare; 0 when equal.
	I64 i;
	I64 ca;
	I64 cb;

	if (!a)
		a = "";
	if (!b)
		b = "";
	i = 0;
	while (TRUE)
	{
		ca = a[i];
		cb = b[i];
		if (ca >= 'a' && ca <= 'z')
			ca = ca - 32;
		if (cb >= 'a' && cb <= 'z')
			cb = cb - 32;
		if (ca != cb)
			return ca - cb;
		if (!ca)
			return 0;
		i++;
	}
	return 0;
}

I64 UTVMStrFind(U8 *hay, U8 *needle)
{//First index of needle in hay, -1 when absent. Empty needle matches at 0.
	I64 i;
	I64 j;

	if (!hay || !needle)
		return -1;
	if (!needle[0])
		return 0;
	i = 0;
	while (hay[i])
	{
		j = 0;
		while (needle[j] && hay[i + j] == needle[j])
			j++;
		if (!needle[j])
			return i;
		i++;
	}
	return -1;
}

U0 UTVMStrReplace(U8 *dst, U8 *src, U8 *match, U8 *with)
{
	I64 i;
	I64 j;
	I64 n;
	I64 mlen;

	if (!dst)
		return;
	dst[0] = 0;
	if (!src)
		return;
	if (!match || !match[0])
	{
		UTVMStrCopyN(dst, src, UT_STR_LEN);
		return;
	}
	mlen = StrLen(match);
	i = 0;
	n = 0;
	while (src[i] && n < UT_STR_LEN - 1)
	{
		j = 0;
		while (match[j] && src[i + j] == match[j])
			j++;
		if (!match[j])
		{
			j = 0;
			while (with && with[j] && n < UT_STR_LEN - 1)
			{
				dst[n] = with[j];
				n++;
				j++;
			}
			i = i + mlen;
		}
		else
		{
			dst[n] = src[i];
			n++;
			i++;
		}
	}
	dst[n] = 0;
}

U0 UTVMStrRemove(U8 *buf, U8 *match)
{
	U8 tmp[UT_STR_LEN];

	UTVMStrReplace(tmp, buf, match, "");
	UTVMStrCopyN(buf, tmp, UT_STR_LEN);
}

Bool UTVMValEq(CUTVMVal *a, CUTVMVal *b)
{
	if (!a || !b)
		return FALSE;
	if (a->tag == UT_VT_VEC || a->tag == UT_VT_ROT ||
		b->tag == UT_VT_VEC || b->tag == UT_VT_ROT)
		return a->v[0] == b->v[0] && a->v[1] == b->v[1] && a->v[2] == b->v[2];
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS ||
		b->tag == UT_VT_OBJ || b->tag == UT_VT_NAME || b->tag == UT_VT_CLASS)
		return UTVMValI(a) == UTVMValI(b);
	return a->v[0] == b->v[0];
}
