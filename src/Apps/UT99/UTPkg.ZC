// UTPkg.ZC - Unreal package (.u/.utx/.unr/...) summary + tables.
//
// Layout: UnLinker.h FPackageFileSummary, FObjectExport, FObjectImport.
// Compact indices: Help/PACKAGES.md. Object serial payloads are per-class
// and undocumented in the public source; this loader stops at the tables.

#define UT_RF_PUBLIC			0x00000004
#define UT_RF_LOAD_FOR_CLIENT	0x00010000
#define UT_RF_LOAD_FOR_SERVER	0x00020000
#define UT_RF_LOAD_FOR_EDIT		0x00040000
#define UT_RF_STANDALONE		0x00080000
#define UT_RF_HAS_STACK			0x02000000
#define UT_RF_INTRINSIC			0x04000000

#define UT_PKG_ALLOW_DOWNLOAD	0x0001
#define UT_PKG_CLIENT_OPTIONAL	0x0002
#define UT_PKG_SERVER_SIDE_ONLY	0x0004

#define UT_PKG_MAX_NAMES		16384
#define UT_PKG_MAX_EXPORTS		16384
#define UT_PKG_MAX_IMPORTS		8192
#define UT_PKG_MAX_GENS			64

class CUTGenInfo
{
	I64 export_count;
	I64 name_count;
};

class CUTNameEntry
{
	U8	name[UT_NAME_SIZE];
	U32	flags;
};

class CUTExport
{
	I64	class_index;	//object ref compact index
	I64	super_index;
	I64	package_index;
	I64	name_index;		//into NameMap
	U32	object_flags;
	I64	serial_size;
	I64	serial_offset;
};

class CUTImport
{
	I64	class_package;	//name index
	I64	class_name;
	I64	package_index;
	I64	object_name;
};

class CUTPackage
{
	U8			*data;
	I64			 data_size;
	U32			 tag;			//PACKAGE_FILE_TAG 0x9E2A83C1; U32 — I32 sign-extend breaks ==
	I64			 file_version;	//Epic low 16
	I64			 licensee_ver;
	U32			 package_flags;
	I64			 name_count;
	I64			 name_offset;
	I64			 export_count;
	I64			 export_offset;
	I64			 import_count;
	I64			 import_offset;
	U32			 guid[4];
	I64			 gen_count;
	CUTGenInfo	 gens[UT_PKG_MAX_GENS];
	CUTNameEntry *names;
	CUTExport	 *exports;
	CUTImport	 *imports;
};

U0 UTPkgFree(CUTPackage *pkg)
{
	if (!pkg)
		return;
	if (pkg->names)
		Free(pkg->names);
	if (pkg->exports)
		Free(pkg->exports);
	if (pkg->imports)
		Free(pkg->imports);
	if (pkg->data)
		Free(pkg->data);
	pkg->names   = NULL;
	pkg->exports = NULL;
	pkg->imports = NULL;
	pkg->data    = NULL;
	Free(pkg);
}

Bool UTPkgReadName(CUTArc *ar, CUTNameEntry *e)
{//Name table entry. Ver < 64: NUL string + flags. Ver >= 64: index len + chars.
	I64 i;
	I64 len;
	U8  ch;

	MemSet(e->name, 0, UT_NAME_SIZE);
	if (ar->ver < 64)
	{
		i = 0;
		while (TRUE)
		{
			ch = UTArcU8(ar);
			if (!ch)
				break;
			if (i < UT_NAME_SIZE - 1)
			{
				e->name[i] = ch;
				i++;
			}
		}
	}
	else
	{
		len = UTArcIndex(ar);
		if (len < 0 || len >= UT_NAME_SIZE)
		{
			ar->err = TRUE;
			return FALSE;
		}
		i = 0;
		while (i < len)
		{
			ch = UTArcU8(ar);
			if (i < UT_NAME_SIZE - 1)
				e->name[i] = ch;
			i++;
		}
		e->name[UT_NAME_SIZE - 1] = 0;
	}
	e->flags = UTArcU32(ar);
	return !ar->err;
}

CUTPackage *UTPkgLoad(U8 *filename)
{
	CUTPackage	*pkg;
	CUTArc		 ar;
	U8			*data;
	I64			 size;
	I64			 i;
	I64			 file_ver_raw;
	I64			 gen_count;
	I64			 heritage_count;
	I64			 heritage_offset;
	I64			 saved;

	data = FileRead(filename, &size);
	if (!data)
	{
		UTLog("UTPkg: cannot read %s\n", filename);
		return NULL;
	}
	if (size < 32)
	{
		UTLog("UTPkg: %s too small\n", filename);
		Free(data);
		return NULL;
	}

	pkg = CAlloc(sizeof(CUTPackage));
	pkg->data      = data;
	pkg->data_size = size;
	UTArcInit(&ar, data, size);

	//UnObjVer.h PACKAGE_FILE_TAG. High bit set → UTArcI32 sign-extends to
	//0xFFFFFFFF9E2A83C1 and rejects every retail package. Read as U32 + mask.
	pkg->tag = UTArcU32(&ar);
	if ((pkg->tag & 0xFFFFFFFF) != (UT_PACKAGE_TAG & 0xFFFFFFFF))
	{
		"UTPkg: bad tag %08X (want %08X) in %s\n",
			pkg->tag & 0xFFFFFFFF, UT_PACKAGE_TAG & 0xFFFFFFFF, filename;
		UTLog("UTPkg: bad tag %08X in %s\n",
			pkg->tag & 0xFFFFFFFF, filename);
		UTPkgFree(pkg);
		return NULL;
	}

	file_ver_raw       = UTArcI32(&ar);
	pkg->file_version  = file_ver_raw & 0xFFFF;
	pkg->licensee_ver  = (file_ver_raw >> 16) & 0xFFFF;
	ar.ver             = pkg->file_version;
	ar.lic_ver         = pkg->licensee_ver;
	pkg->package_flags = UTArcU32(&ar);
	pkg->name_count    = UTArcI32(&ar);
	pkg->name_offset   = UTArcI32(&ar);
	pkg->export_count  = UTArcI32(&ar);
	pkg->export_offset = UTArcI32(&ar);
	pkg->import_count  = UTArcI32(&ar);
	pkg->import_offset = UTArcI32(&ar);

	if (pkg->file_version < UT_PACKAGE_MIN_VERSION)
	{
		UTLog("UTPkg: version %d below min %d\n",
			pkg->file_version, UT_PACKAGE_MIN_VERSION);
		UTPkgFree(pkg);
		return NULL;
	}

	pkg->gen_count = 0;
	if (pkg->file_version >= 68)
	{
		pkg->guid[0] = UTArcU32(&ar);
		pkg->guid[1] = UTArcU32(&ar);
		pkg->guid[2] = UTArcU32(&ar);
		pkg->guid[3] = UTArcU32(&ar);
		gen_count    = UTArcI32(&ar);
		//Tables use absolute offsets (Seek). Bad gen_count must not abort load.
		if (gen_count < 1 || gen_count > UT_PKG_MAX_GENS)
		{
			UTLog("UTPkg: bad generation count %d — using 1\n", gen_count);
			pkg->gen_count = 1;
			pkg->gens[0].export_count = pkg->export_count;
			pkg->gens[0].name_count   = pkg->name_count;
		}
		else
		{
			pkg->gen_count = gen_count;
			i = 0;
			while (i < gen_count)
			{
				pkg->gens[i].export_count = UTArcI32(&ar);
				pkg->gens[i].name_count   = UTArcI32(&ar);
				i++;
			}
		}
	}
	else
	{
		heritage_count  = UTArcI32(&ar);
		heritage_offset = UTArcI32(&ar);
		saved = ar.pos;
		if (heritage_count > 0 && heritage_offset >= 0 &&
			heritage_offset + 16 <= size)
		{
			UTArcSeek(&ar, heritage_offset);
			pkg->guid[0] = UTArcU32(&ar);
			pkg->guid[1] = UTArcU32(&ar);
			pkg->guid[2] = UTArcU32(&ar);
			pkg->guid[3] = UTArcU32(&ar);
		}
		UTArcSeek(&ar, saved);
		pkg->gen_count = 1;
		pkg->gens[0].export_count = pkg->export_count;
		pkg->gens[0].name_count   = pkg->name_count;
	}

	if (pkg->name_count < 0 || pkg->name_count > UT_PKG_MAX_NAMES ||
		pkg->export_count < 0 || pkg->export_count > UT_PKG_MAX_EXPORTS ||
		pkg->import_count < 0 || pkg->import_count > UT_PKG_MAX_IMPORTS)
	{
		UTLog("UTPkg: table counts out of range\n");
		UTPkgFree(pkg);
		return NULL;
	}

	if (pkg->name_count > 0)
	{
		pkg->names = CAlloc(pkg->name_count * sizeof(CUTNameEntry));
		if (!UTArcSeek(&ar, pkg->name_offset))
		{
			UTPkgFree(pkg);
			return NULL;
		}
		i = 0;
		while (i < pkg->name_count)
		{
			if (!UTPkgReadName(&ar, &pkg->names[i]))
			{
				UTLog("UTPkg: name %d failed\n", i);
				UTPkgFree(pkg);
				return NULL;
			}
			i++;
		}
	}

	if (pkg->import_count > 0)
	{
		pkg->imports = CAlloc(pkg->import_count * sizeof(CUTImport));
		if (!UTArcSeek(&ar, pkg->import_offset))
		{
			UTPkgFree(pkg);
			return NULL;
		}
		i = 0;
		while (i < pkg->import_count)
		{
			pkg->imports[i].class_package = UTArcIndex(&ar);
			pkg->imports[i].class_name    = UTArcIndex(&ar);
			pkg->imports[i].package_index = UTArcI32(&ar);
			pkg->imports[i].object_name   = UTArcIndex(&ar);
			i++;
		}
	}

	if (pkg->export_count > 0)
	{
		pkg->exports = CAlloc(pkg->export_count * sizeof(CUTExport));
		if (!UTArcSeek(&ar, pkg->export_offset))
		{
			UTPkgFree(pkg);
			return NULL;
		}
		i = 0;
		while (i < pkg->export_count)
		{
			pkg->exports[i].class_index   = UTArcIndex(&ar);
			pkg->exports[i].super_index   = UTArcIndex(&ar);
			pkg->exports[i].package_index = UTArcI32(&ar);
			pkg->exports[i].name_index    = UTArcIndex(&ar);
			pkg->exports[i].object_flags  = UTArcU32(&ar);
			pkg->exports[i].serial_size   = UTArcIndex(&ar);
			pkg->exports[i].serial_offset = 0;
			if (pkg->exports[i].serial_size)
				pkg->exports[i].serial_offset = UTArcIndex(&ar);
			i++;
		}
	}

	if (ar.err)
	{
		UTLog("UTPkg: archive error loading %s\n", filename);
		UTPkgFree(pkg);
		return NULL;
	}

	UTLog("UTPkg: %s ver=%d names=%d exports=%d imports=%d\n",
		filename, pkg->file_version, pkg->name_count,
		pkg->export_count, pkg->import_count);
	return pkg;
}

U8 *UTPkgNameStr(CUTPackage *pkg, I64 idx)
{
	if (!pkg || !pkg->names || idx < 0 || idx >= pkg->name_count)
		return "";
	return pkg->names[idx].name;
}

U8 *UTPkgClassName(CUTPackage *pkg, I64 class_index)
{//export ClassIndex → class name. 0 = Class, <0 = import object name.
	I64 ii;

	if (!pkg)
		return "";
	if (class_index == 0)
		return "Class";
	if (class_index < 0)
	{
		ii = -class_index - 1;
		if (ii < 0 || ii >= pkg->import_count || !pkg->imports)
			return "";
		return UTPkgNameStr(pkg, pkg->imports[ii].object_name);
	}
	ii = class_index - 1;
	if (ii < 0 || ii >= pkg->export_count || !pkg->exports)
		return "";
	return UTPkgNameStr(pkg, pkg->exports[ii].name_index);
}

I64 UTPkgFindExport(CUTPackage *pkg, U8 *cls, U8 *name)
{//first export with class name cls and optional object name. -1 if none.
	I64 i;
	U8 *c;
	Bool cls_ok;
	Bool name_ok;

	if (!pkg || !pkg->exports)
		return -1;
	i = 0;
	while (i < pkg->export_count)
	{
		c = UTPkgClassName(pkg, pkg->exports[i].class_index);
		cls_ok = TRUE;
		if (cls && StrCompare(c, cls))
			cls_ok = FALSE;
		name_ok = TRUE;
		if (name && StrCompare(UTPkgNameStr(pkg, pkg->exports[i].name_index),
			name))
			name_ok = FALSE;
		if (cls_ok && name_ok)
			return i;
		i++;
	}
	return -1;
}

I64 UTPkgFindExportClass(CUTPackage *pkg, U8 *cls)
{
	return UTPkgFindExport(pkg, cls, NULL);
}

Bool UTPkgArcExport(CUTPackage *pkg, I64 exp_i, CUTArc *ar)
{//point arc at export serial payload; size clamped to serial end.
	CUTExport *e;
	I64 end;

	if (!pkg || !ar || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (e->serial_size <= 0 || e->serial_offset < 0)
		return FALSE;
	end = e->serial_offset + e->serial_size;
	if (end > pkg->data_size)
		end = pkg->data_size;
	UTArcInit(ar, pkg->data, end);
	ar->ver = pkg->file_version;
	ar->lic_ver = pkg->licensee_ver;
	return UTArcSeek(ar, e->serial_offset);
}

I64 UTPkgFindName(CUTPackage *pkg, U8 *want)
{
	I64 i;

	if (!pkg || !pkg->names)
		return -1;
	i = 0;
	while (i < pkg->name_count)
	{
		if (!StrCompare(pkg->names[i].name, want))
			return i;
		i++;
	}
	return -1;
}

U0 UTPkgReport(CUTPackage *pkg)
{
	I64 i;
	I64 n;

	if (!pkg)
		return;
	"  tag        %08X\n", pkg->tag & 0xFFFFFFFF;
	"  version    %d (licensee %d)\n", pkg->file_version, pkg->licensee_ver;
	"  flags      %08X\n", pkg->package_flags;
	"  guid       %08X-%08X-%08X-%08X\n",
		pkg->guid[0], pkg->guid[1], pkg->guid[2], pkg->guid[3];
	"  names      %d @ %d\n", pkg->name_count, pkg->name_offset;
	"  exports    %d @ %d\n", pkg->export_count, pkg->export_offset;
	"  imports    %d @ %d\n", pkg->import_count, pkg->import_offset;

	n = pkg->name_count;
	if (n > 12)
		n = 12;
	"  name sample:";
	i = 0;
	while (i < n)
	{
		" %s", pkg->names[i].name;
		i++;
	}
	"\n";

	n = pkg->export_count;
	if (n > 8)
		n = 8;
	"  export sample:\n";
	i = 0;
	while (i < n)
	{
		"    [%d] %s size=%d off=%d flags=%08X\n", i,
			UTPkgNameStr(pkg, pkg->exports[i].name_index),
			pkg->exports[i].serial_size,
			pkg->exports[i].serial_offset,
			pkg->exports[i].object_flags;
		i++;
	}
}
