// UTSnd.ZC - .uax Sound exports → RIFF/WAV → AudioSFXPlay.
//
// USound serial: tagged props then embedded WAV (retail Activates.uax etc.).
// Decode mirrors QSndDecodeWav; mixer owns rate conversion.

#define UT_SND_MAX		64
#define UT_SND_NAME		64

class CUTSnd
{
	U8	 name[UT_SND_NAME];
	U32	*frames;
	I64	 count;
	I64	 rate;
	Bool loaded;
	Bool failed;
};

CUTSnd	ut_snd[UT_SND_MAX];
I64		ut_snd_n		= 0;
Bool	ut_snd_ready	= FALSE;
I64		ut_snd_fire_i	= -1;
I64		ut_snd_pain_i	= -1;
I64		ut_snd_die_i	= -1;
I64		ut_snd_pickup_i	= -1;
I64		ut_snd_taunt_i[4];
I64		ut_snd_taunt_n	= 0;
I64		ut_snd_ann_first	= -1;
I64		ut_snd_ann_double	= -1;
I64		ut_snd_ann_multi	= -1;
I64		ut_snd_ann_spree	= -1;
I64		ut_snd_ann_head		= -1;
I64		ut_snd_ann_capture	= -1;
I64		ut_snd_ann_taken	= -1;
I64		ut_snd_ann_lost		= -1;

I64 UTSndFindRiff(U8 *buf, I64 size)
{
	I64 i;

	if (!buf || size < 12)
		return -1;
	i = 0;
	while (i + 12 <= size)
	{
		if (!MemCompare(buf + i, "RIFF", 4) &&
			!MemCompare(buf + i + 8, "WAVE", 4))
			return i;
		i++;
	}
	return -1;
}

I64 UTSndDecodeWav(U8 *raw, I64 size, U32 **_frames, I64 *_rate)
{//RIFF/WAVE → stereo U32 frames at file rate. QSndDecodeWav pattern.
	U8 *p;
	U8 *end;
	U8 *data;
	I64 chunk;
	I64 channels;
	I64 rate;
	I64 bits;
	I64 dsize;
	I64 in_count;
	I64 out_count;
	I64 i;
	I64 src;
	I64 l;
	I64 r;
	U32 *out;

	*_frames = NULL;
	data = NULL;
	channels = 1;
	rate = 11025;
	bits = 8;
	dsize = 0;

	if (size < 44 || MemCompare(raw, "RIFF", 4) || MemCompare(raw + 8, "WAVE", 4))
		return 0;

	p = raw + 12;
	end = raw + size;
	while (p + 8 <= end)
	{
		chunk = UTRdU32(p + 4);
		if (chunk < 0 || p + 8 + chunk > end)
			chunk = end - (p + 8);
		if (!MemCompare(p, "fmt ", 4) && chunk >= 16)
		{
			channels = UTRdU16(p + 10);
			rate = UTRdU32(p + 12);
			bits = UTRdU16(p + 22);
		}
		else if (!MemCompare(p, "data", 4))
		{
			data = p + 8;
			dsize = chunk;
		}
		p += 8 + chunk + (chunk & 1);
	}

	if (!data || channels < 1 || rate < 1 || dsize < 1)
		return 0;
	if (bits != 8 && bits != 16)
		return 0;

	if (bits == 8)
		in_count = dsize / channels;
	else
		in_count = dsize / (channels * 2);
	if (in_count < 1)
		return 0;

	out_count = in_count;
	out = MAlloc(out_count * sizeof(U32));
	i = 0;
	while (i < out_count)
	{
		src = i;
		if (bits == 8)
		{
			l = (data[src * channels] - 128) << 8;
			if (channels > 1)
				r = (data[src * channels + 1] - 128) << 8;
			else
				r = l;
		}
		else
		{
			l = UTRdI16(data + src * channels * 2);
			if (channels > 1)
				r = UTRdI16(data + (src * channels + 1) * 2);
			else
				r = l;
		}
		out[i] = (l & 0xFFFF) | (r << 16);
		i++;
	}
	*_frames = out;
	if (_rate)
		*_rate = rate;
	return out_count;
}

I64 UTSndSlot(U8 *name)
{
	I64 i;
	CUTSnd *s;

	i = 0;
	while (i < ut_snd_n)
	{
		if (!StrCompare(ut_snd[i].name, name))
			return i;
		i++;
	}
	if (ut_snd_n >= UT_SND_MAX)
		return -1;
	s = &ut_snd[ut_snd_n];
	MemSet(s, 0, sizeof(CUTSnd));
	StrPrint(s->name, "%s", name);
	i = ut_snd_n;
	ut_snd_n++;
	return i;
}

I64 UTSndLoadFromUax(U8 *uax_path, U8 *snd_name)
{//load named Sound export; locate RIFF after props.
	I64 slot;
	I64 ei;
	I64 riff;
	I64 count;
	I64 rate;
	I64 remain;
	U32 *frames;
	CUTSnd *s;
	CUTPackage *pkg;
	CUTExport *e;
	CUTArc ar;
	U8 *base;

	if (!uax_path || !snd_name)
		return -1;
	slot = UTSndSlot(snd_name);
	if (slot < 0)
		return -1;
	s = &ut_snd[slot];
	if (s->loaded)
		return slot;
	if (s->failed)
		return -1;

	pkg = UTPkgLoad(uax_path);
	if (!pkg)
	{
		s->failed = TRUE;
		return -1;
	}
	ei = UTPkgFindExport(pkg, "Sound", snd_name);
	if (ei < 0)
	{
		UTPkgFree(pkg);
		s->failed = TRUE;
		return -1;
	}
	e = &pkg->exports[ei];
	if (!UTPkgArcExport(pkg, ei, &ar))
	{
		UTPkgFree(pkg);
		s->failed = TRUE;
		return -1;
	}
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
		ar.err = FALSE;
	remain = e->serial_offset + e->serial_size - ar.pos;
	if (remain < 12)
	{
		UTPkgFree(pkg);
		s->failed = TRUE;
		return -1;
	}
	base = pkg->data + ar.pos;
	riff = UTSndFindRiff(base, remain);
	if (riff < 0)
	{
		//scan whole serial as fallback
		base = pkg->data + e->serial_offset;
		remain = e->serial_size;
		riff = UTSndFindRiff(base, remain);
	}
	if (riff < 0 || riff >= remain)
	{
		UTPkgFree(pkg);
		s->failed = TRUE;
		return -1;
	}
	count = UTSndDecodeWav(base + riff, remain - riff, &frames, &rate);
	UTPkgFree(pkg);
	if (count < 1 || !frames)
	{
		s->failed = TRUE;
		return -1;
	}
	s->frames = frames;
	s->count = count;
	s->rate = rate;
	s->loaded = TRUE;
	UTLog("UTSnd: %s frames=%d rate=%d\n", snd_name, count, rate);
	return slot;
}

U0 UTSndPlay(I64 slot, F64 vol)
{
	CUTSnd *s;
	I64 v;

	if (slot < 0 || slot >= ut_snd_n)
		return;
	s = &ut_snd[slot];
	if (!s->loaded || !s->frames || s->count < 1)
		return;
	v = ToI64(vol * 256.0);
	if (v < 0)
		v = 0;
	if (v > 256)
		v = 256;
	AudioSFXPlayRef(s->frames, s->count, s->rate, v, v);
}

U0 UTSndPlayName(U8 *uax, U8 *name, F64 vol)
{
	U8 path[256];
	I64 slot;

	StrPrint(path, "%s%s", UT99_SOUNDS_DIR, uax);
	slot = UTSndLoadFromUax(path, name);
	if (slot >= 0)
		UTSndPlay(slot, vol);
}

U0 UTSndAnnounce(U8 *name)
{
	U8 path[256];
	I64 slot;

	if (!name)
		return;
	StrPrint(path, "%sAnnouncer.uax", UT99_SOUNDS_DIR);
	slot = UTSndLoadFromUax(path, name);
	if (slot >= 0)
		UTSndPlay(slot, 1.0);
}

U0 UTSndTaunt()
{
	I64 i;

	if (ut_snd_taunt_n < 1)
		return;
	i = ToI64(tS * 7.0) % ut_snd_taunt_n;
	if (i < 0)
		i = 0;
	UTSndPlay(ut_snd_taunt_i[i], 1.0);
}

U0 UTSndInit()
{
	U8 path[256];
	I64 slot;

	ut_snd_n = 0;
	ut_snd_fire_i = -1;
	ut_snd_pain_i = -1;
	ut_snd_die_i = -1;
	ut_snd_pickup_i = -1;
	ut_snd_taunt_n = 0;
	ut_snd_ann_first = -1;
	ut_snd_ann_double = -1;
	ut_snd_ann_multi = -1;
	ut_snd_ann_spree = -1;
	ut_snd_ann_head = -1;
	ut_snd_ann_capture = -1;
	ut_snd_ann_taken = -1;
	ut_snd_ann_lost = -1;
	ut_snd_ready = FALSE;

	StrPrint(path, "%sActivates.uax", UT99_SOUNDS_DIR);
	ut_snd_fire_i = UTSndLoadFromUax(path, "sclick5");
	if (ut_snd_fire_i < 0)
		ut_snd_fire_i = UTSndLoadFromUax(path, "sclick1");
	ut_snd_pickup_i = UTSndLoadFromUax(path, "sclick1");

	StrPrint(path, "%sMaleSounds.uax", UT99_SOUNDS_DIR);
	ut_snd_pain_i = UTSndLoadFromUax(path, "injurL2");
	if (ut_snd_pain_i < 0)
		ut_snd_pain_i = UTSndLoadFromUax(path, "injurH5");
	ut_snd_die_i = UTSndLoadFromUax(path, "deathc1");
	if (ut_snd_die_i < 0)
		ut_snd_die_i = UTSndLoadFromUax(path, "deathc3");

	StrPrint(path, "%sMale2Voice.uax", UT99_SOUNDS_DIR);
	slot = UTSndLoadFromUax(path, "M2wantsome");
	if (slot >= 0)
	{
		ut_snd_taunt_i[ut_snd_taunt_n] = slot;
		ut_snd_taunt_n++;
	}
	slot = UTSndLoadFromUax(path, "M2laugh");
	if (slot >= 0 && ut_snd_taunt_n < 4)
	{
		ut_snd_taunt_i[ut_snd_taunt_n] = slot;
		ut_snd_taunt_n++;
	}
	slot = UTSndLoadFromUax(path, "M2eatthat");
	if (slot >= 0 && ut_snd_taunt_n < 4)
	{
		ut_snd_taunt_i[ut_snd_taunt_n] = slot;
		ut_snd_taunt_n++;
	}
	slot = UTSndLoadFromUax(path, "M2diebitch");
	if (slot >= 0 && ut_snd_taunt_n < 4)
	{
		ut_snd_taunt_i[ut_snd_taunt_n] = slot;
		ut_snd_taunt_n++;
	}

	StrPrint(path, "%sAnnouncer.uax", UT99_SOUNDS_DIR);
	ut_snd_ann_first = UTSndLoadFromUax(path, "firstblood");
	ut_snd_ann_double = UTSndLoadFromUax(path, "doublekill");
	ut_snd_ann_multi = UTSndLoadFromUax(path, "multikill");
	ut_snd_ann_spree = UTSndLoadFromUax(path, "killingspree");
	ut_snd_ann_head = UTSndLoadFromUax(path, "headshot");
	ut_snd_ann_capture = UTSndLoadFromUax(path, "capture");
	ut_snd_ann_taken = UTSndLoadFromUax(path, "takenlead");
	ut_snd_ann_lost = UTSndLoadFromUax(path, "lostlead");

	ut_snd_ready = TRUE;
	UTLog("UTSnd: fire=%d pain=%d die=%d taunts=%d ann=%d\n",
		ut_snd_fire_i, ut_snd_pain_i, ut_snd_die_i, ut_snd_taunt_n,
		ut_snd_ann_first);
}

U0 UTSndExit()
{
	I64 i;

	i = 0;
	while (i < ut_snd_n)
	{
		if (ut_snd[i].frames)
			Free(ut_snd[i].frames);
		ut_snd[i].frames = NULL;
		ut_snd[i].loaded = FALSE;
		i++;
	}
	ut_snd_n = 0;
	ut_snd_ready = FALSE;
}
