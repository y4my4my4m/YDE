// UTDemo.ZC - SoftDrv host demo record/play stub (.udm).
//
// Not Unreal .dem netstream. Host frames: dt + origin + yaw/pitch + buttons.
// demorec / demoplay / stopdemo via UTCon.

#define UT_DEMO_MAGIC		0x4D445455	//'UTDM' LE
#define UT_DEMO_VER		1
#define UT_DEMO_MAX_FRAMES	120000
#define UT_DEMO_PATH		"::/Apps/UT99/Demos"

class CUTDemoHdr
{
	U32	 magic;
	I64	 ver;
	I64	 n_frames;
	U8	 map[64];
	U8	 name[32];
};

class CUTDemoFrame
{
	F64	 dt;
	F64	 origin[3];
	I64	 yaw;
	I64	 pitch;
	U8	 buttons;	//bit0 fwd 1 back 2 left 3 right 4 jump 5 fire
};

CUTDemoFrame	*ut_demo_frames	= NULL;
I64		ut_demo_n		= 0;
I64		ut_demo_cap		= 0;
I64		ut_demo_play_i		= 0;
Bool		ut_demo_recording	= FALSE;
Bool		ut_demo_playing		= FALSE;
U8		ut_demo_name[32]	= "";
Bool		ut_timedemo		= FALSE;
F64		ut_timedemo_t0		= 0.0;
I64		ut_timedemo_frames	= 0;
F64		ut_timedemo_accum	= 0.0;

extern F64	ut_origin[3];
extern I64	ut_view_yaw;
extern I64	ut_view_pitch;
extern Bool	ut_key_forward;
extern Bool	ut_key_back;
extern Bool	ut_key_left;
extern Bool	ut_key_right;
extern Bool	ut_want_jump;
extern Bool	ut_fire_held;
extern U8	ut_map_name[64];
extern Bool	ut_game_ready;
extern U0	UTDemoStop();

U0 UTDemoFreeBuf()
{
	if (ut_demo_frames)
	{
		Free(ut_demo_frames);
		ut_demo_frames = NULL;
	}
	ut_demo_n = 0;
	ut_demo_cap = 0;
	ut_demo_play_i = 0;
}

U0 UTDemoInit()
{
	UTDemoFreeBuf;
	ut_demo_recording = FALSE;
	ut_demo_playing = FALSE;
	ut_demo_name[0] = 0;
	ut_timedemo = FALSE;
	ut_timedemo_frames = 0;
	ut_timedemo_accum = 0.0;
}

U0 UTDemoPath(U8 *name, U8 *dst)
{
	if (!name || !name[0])
		name = "demo0";
	StrPrint(dst, "%s/%s.udm", UT_DEMO_PATH, name);
}

Bool UTDemoRecStart(U8 *name)
{
	if (ut_demo_playing)
		UTDemoStop;
	UTDemoFreeBuf;
	ut_demo_cap = 4096;
	ut_demo_frames = CAlloc(ut_demo_cap * sizeof(CUTDemoFrame));
	if (!ut_demo_frames)
		return FALSE;
	if (name && name[0])
		StrPrint(ut_demo_name, "%s", name);
	else
		StrPrint(ut_demo_name, "demo0");
	ut_demo_n = 0;
	ut_demo_recording = TRUE;
	UTLog("UTDemo: rec start %s\n", ut_demo_name);
	return TRUE;
}

U0 UTDemoRecGrow()
{
	CUTDemoFrame *nbuf;
	I64 ncap;

	if (ut_demo_n < ut_demo_cap)
		return;
	ncap = ut_demo_cap * 2;
	if (ncap > UT_DEMO_MAX_FRAMES)
		ncap = UT_DEMO_MAX_FRAMES;
	if (ncap <= ut_demo_cap)
		return;
	nbuf = CAlloc(ncap * sizeof(CUTDemoFrame));
	if (!nbuf)
		return;
	MemCopy(nbuf, ut_demo_frames, ut_demo_n * sizeof(CUTDemoFrame));
	Free(ut_demo_frames);
	ut_demo_frames = nbuf;
	ut_demo_cap = ncap;
}

U0 UTDemoRecFrame(F64 dt)
{
	CUTDemoFrame *f;
	U8 b;

	if (!ut_demo_recording || !ut_demo_frames)
		return;
	UTDemoRecGrow;
	if (ut_demo_n >= ut_demo_cap)
		return;
	f = &ut_demo_frames[ut_demo_n];
	f->dt = dt;
	UTVecCopy(ut_origin, f->origin);
	f->yaw = ut_view_yaw;
	f->pitch = ut_view_pitch;
	b = 0;
	if (ut_key_forward) b |= 1;
	if (ut_key_back) b |= 2;
	if (ut_key_left) b |= 4;
	if (ut_key_right) b |= 8;
	if (ut_want_jump) b |= 16;
	if (ut_fire_held) b |= 32;
	f->buttons = b;
	ut_demo_n++;
}

U0 UTDemoRecStop()
{
	U8 path[96];
	U8 *buf;
	CUTDemoHdr *hdr;
	I64 bytes;
	I64 off;

	if (!ut_demo_recording)
		return;
	ut_demo_recording = FALSE;
	if (ut_demo_n < 1 || !ut_demo_frames)
	{
		UTLog("UTDemo: rec empty\n");
		return;
	}
	bytes = sizeof(CUTDemoHdr) + ut_demo_n * sizeof(CUTDemoFrame);
	buf = CAlloc(bytes);
	if (!buf)
		return;
	hdr = buf;
	hdr->magic = UT_DEMO_MAGIC;
	hdr->ver = UT_DEMO_VER;
	hdr->n_frames = ut_demo_n;
	if (ut_map_name[0])
		StrPrint(hdr->map, "%s", ut_map_name);
	StrPrint(hdr->name, "%s", ut_demo_name);
	off = sizeof(CUTDemoHdr);
	MemCopy(buf + off, ut_demo_frames, ut_demo_n * sizeof(CUTDemoFrame));
	UTDemoPath(ut_demo_name, path);
	if (FileWrite(path, buf, bytes) < 1)
		UTLog("UTDemo: write fail %s\n", path);
	else
		UTLog("UTDemo: wrote %s frames=%d\n", path, ut_demo_n);
	Free(buf);
}

Bool UTDemoPlayStart(U8 *name)
{
	U8 path[96];
	U8 *data;
	CUTDemoHdr *hdr;
	I64 sz;
	I64 need;

	if (ut_demo_recording)
		UTDemoRecStop;
	UTDemoFreeBuf;
	if (name && name[0])
		StrPrint(ut_demo_name, "%s", name);
	else
		StrPrint(ut_demo_name, "demo0");
	UTDemoPath(ut_demo_name, path);
	if (!FileFind(path))
		return FALSE;
	data = FileRead(path, &sz);
	if (!data || sz < sizeof(CUTDemoHdr))
	{
		if (data) Free(data);
		return FALSE;
	}
	hdr = data;
	if (hdr->magic != UT_DEMO_MAGIC || hdr->ver != UT_DEMO_VER ||
		hdr->n_frames < 1)
	{
		Free(data);
		return FALSE;
	}
	need = sizeof(CUTDemoHdr) + hdr->n_frames * sizeof(CUTDemoFrame);
	if (sz < need)
	{
		Free(data);
		return FALSE;
	}
	ut_demo_cap = hdr->n_frames;
	ut_demo_frames = CAlloc(ut_demo_cap * sizeof(CUTDemoFrame));
	if (!ut_demo_frames)
	{
		Free(data);
		return FALSE;
	}
	MemCopy(ut_demo_frames, data + sizeof(CUTDemoHdr),
		hdr->n_frames * sizeof(CUTDemoFrame));
	ut_demo_n = hdr->n_frames;
	Free(data);
	ut_demo_play_i = 0;
	ut_demo_playing = TRUE;
	if (ut_timedemo)
	{
		ut_timedemo_t0 = tS;
		ut_timedemo_frames = 0;
		ut_timedemo_accum = 0.0;
	}
	UTLog("UTDemo: play %s frames=%d\n", ut_demo_name, ut_demo_n);
	return TRUE;
}

U0 UTDemoStop()
{
	ut_demo_playing = FALSE;
	ut_demo_play_i = 0;
}

U0 UTDemoPlayTick(F64 dt)
{
	CUTDemoFrame *f;

	no_warn dt;
	if (!ut_demo_playing || !ut_demo_frames || ut_demo_play_i >= ut_demo_n)
	{
		if (ut_demo_playing)
		{
			ut_demo_playing = FALSE;
			if (ut_timedemo && ut_timedemo_t0 > 0.0)
			{
				ut_timedemo_accum = tS - ut_timedemo_t0;
				UTLog("UTDemo: timedemo frames=%d sec=%.2f fps=%.1f\n",
					ut_timedemo_frames, ut_timedemo_accum,
					ToF64(ut_timedemo_frames) /
					(ut_timedemo_accum + 0.001));
			}
		}
		return;
	}
	f = &ut_demo_frames[ut_demo_play_i];
	UTVecCopy(f->origin, ut_origin);
	ut_view_yaw = f->yaw;
	ut_view_pitch = f->pitch;
	ut_key_forward = (f->buttons & 1) != 0;
	ut_key_back = (f->buttons & 2) != 0;
	ut_key_left = (f->buttons & 4) != 0;
	ut_key_right = (f->buttons & 8) != 0;
	ut_want_jump = (f->buttons & 16) != 0;
	ut_fire_held = (f->buttons & 32) != 0;
	ut_demo_play_i++;
	if (ut_timedemo)
		ut_timedemo_frames++;
}

U0 UTTimeDemoToggle()
{
	ut_timedemo = !ut_timedemo;
	ut_timedemo_frames = 0;
	ut_timedemo_accum = 0.0;
	ut_timedemo_t0 = tS;
	UTLog("UTDemo: timedemo=%d\n", ToI64(ut_timedemo));
}

U0 UTDemoDrawStats(CUTCanvas *c)
{
	U8 line[80];
	F64 fps;

	if (!c || !ut_win_ready)
		return;
	if (!ut_timedemo && !ut_demo_recording && !ut_demo_playing)
		return;
	ut_win.fb = c;
	if (ut_demo_recording)
	{
		StrPrint(line, "REC %s  frames=%d", ut_demo_name, ut_demo_n);
		UTWinTextAt(8, 8, line, ut_col_sel);
	}
	if (ut_demo_playing)
	{
		StrPrint(line, "PLAY %s  %d/%d", ut_demo_name,
			ut_demo_play_i, ut_demo_n);
		UTWinTextAt(8, 20, line, ut_col_white);
	}
	if (ut_timedemo)
	{
		fps = 0.0;
		if (ut_timedemo_accum > 0.05)
			fps = ToF64(ut_timedemo_frames) / ut_timedemo_accum;
		else if (tS > ut_timedemo_t0)
			fps = ToF64(ut_timedemo_frames) / (tS - ut_timedemo_t0 + 0.001);
		StrPrint(line, "TimeDemo  frames=%d  fps=%.1f",
			ut_timedemo_frames, fps);
		UTWinTextAt(8, 32, line, ut_col_sel);
	}
}
