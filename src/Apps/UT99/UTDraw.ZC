// UTDraw.ZC - SoftDrv CPU raster: indexed canvas, spans, tiles, window blit.
//
// SoftDrv.dll was never in Ut99PubSrc. This file is the ZealOS SoftDrv:
// SpanBased P8 framebuffer, Quake/HL1 draw_it blit pattern. No OpenGL,
// D3D, or XMesa paths.

#define UT_SCR_W		320
#define UT_SCR_H		240
#define UT_NEAR_CLIP	4.0
#define UT_SPAN_SUB		16		//pixels between exact perspective divides

class CUTCanvas
{
	U8	*pixels;
	F64	*depth;
	I64	 width;
	I64	 height;
	F64	 origin[3];
	F64	 forward[3];
	F64	 right[3];
	F64	 up[3];
	F64	 x_scale;
	F64	 y_scale;
	F64	 center_x;
	F64	 center_y;
	I64	 tris_drawn;
	I64	 verts_drawn;
	I64	 spans_drawn;
	I64	 tiles_drawn;
};

CUTCanvas *UTDrawNew(I64 w, I64 h)
{
	CUTCanvas *c;

	if (w < 1 || h < 1)
		return NULL;
	c = CAlloc(sizeof(CUTCanvas));
	c->width  = w;
	c->height = h;
	c->pixels = CAlloc(w * h);
	c->depth  = CAlloc(w * h * sizeof(F64));
	c->center_x = ToF64(w) * 0.5;
	c->center_y = ToF64(h) * 0.5;
	c->x_scale  = ToF64(w) * 0.5;
	c->y_scale  = ToF64(h) * 0.5;
	UTVecSet(c->origin, 0.0, 0.0, 0.0);
	UTVecSet(c->forward, 1.0, 0.0, 0.0);
	UTVecSet(c->right, 0.0, 1.0, 0.0);
	UTVecSet(c->up, 0.0, 0.0, 1.0);
	return c;
}

U0 UTDrawFree(CUTCanvas *c)
{
	if (!c)
		return;
	if (c->pixels)
		Free(c->pixels);
	if (c->depth)
		Free(c->depth);
	c->pixels = NULL;
	c->depth  = NULL;
	Free(c);
}

U0 UTDrawClear(CUTCanvas *c, I64 color_index)
{
	if (!c || !c->pixels)
		return;
	MemSet(c->pixels, color_index, c->width * c->height);
	MemSet(c->depth, 0, c->width * c->height * sizeof(F64));
	c->tris_drawn  = 0;
	c->verts_drawn = 0;
	c->spans_drawn = 0;
	c->tiles_drawn = 0;
}

U0 UTDrawSetView(CUTCanvas *c, F64 *origin, I64 pitch, I64 yaw, I64 roll,
	F64 fov_deg)
{//eye at origin; GetAxes supplies forward/right/up. FOV horizontal degrees.
	F64 half;
	F64 aspect;

	UTVecCopy(origin, c->origin);
	UTGetAxes(pitch, yaw, roll, c->forward, c->right, c->up);
	half   = Tan(fov_deg * 0.5 * UT_DEG2RAD);
	aspect = ToF64(c->width) / ToF64(c->height);
	c->x_scale  = ToF64(c->width) * 0.5 / (half * aspect);
	c->y_scale  = ToF64(c->height) * 0.5 / half;
	c->center_x = ToF64(c->width) * 0.5;
	c->center_y = ToF64(c->height) * 0.5;
}

Bool UTDrawProject(CUTCanvas *c, F64 *world, F64 *sx, F64 *sy, F64 *inv_z)
{
	F64 cam[3];
	F64 z;

	UTTransformPointBy(world, c->origin, c->right, c->up, c->forward, cam);
	//TransformPointBy with (right,up,forward) as X/Y/Z axes:
	//cam[0]=right, cam[1]=up, cam[2]=forward depth
	z = cam[2];
	if (z < UT_NEAR_CLIP)
		return FALSE;
	*inv_z = 1.0 / z;
	*sx = c->center_x + cam[0] * c->x_scale * (*inv_z);
	*sy = c->center_y - cam[1] * c->y_scale * (*inv_z);
	return TRUE;
}

U0 UTDrawPlot(CUTCanvas *c, I64 x, I64 y, F64 inv_z, I64 color)
{
	I64 i;

	if (x < 0 || y < 0 || x >= c->width || y >= c->height)
		return;
	i = y * c->width + x;
	if (inv_z > c->depth[i])
	{
		c->depth[i]  = inv_z;
		c->pixels[i] = color;
	}
}

U0 UTDrawFillTri(CUTCanvas *c, F64 *ax, F64 *ay, F64 *ainv,
	F64 *bx, F64 *by, F64 *binv,
	F64 *cx, F64 *cy, F64 *cinv, I64 color)
{//barycentric fill. pointers so callers pass projected scalars by address.
	F64	minx;
	F64	maxx;
	F64	miny;
	F64	maxy;
	I64	x0;
	I64	x1;
	I64	y0;
	I64	y1;
	I64	x;
	I64	y;
	F64	px;
	F64	py;
	F64	v0x;
	F64	v0y;
	F64	v1x;
	F64	v1y;
	F64	v2x;
	F64	v2y;
	F64	dot00;
	F64	dot01;
	F64	dot02;
	F64	dot11;
	F64	dot12;
	F64	inv;
	F64	u;
	F64	v;
	F64	w;
	F64	iz;

	minx = *ax;
	if (*bx < minx) minx = *bx;
	if (*cx < minx) minx = *cx;
	maxx = *ax;
	if (*bx > maxx) maxx = *bx;
	if (*cx > maxx) maxx = *cx;
	miny = *ay;
	if (*by < miny) miny = *by;
	if (*cy < miny) miny = *cy;
	maxy = *ay;
	if (*by > maxy) maxy = *by;
	if (*cy > maxy) maxy = *cy;

	x0 = ToI64(minx);
	x1 = ToI64(maxx);
	y0 = ToI64(miny);
	y1 = ToI64(maxy);
	if (x0 < 0) x0 = 0;
	if (y0 < 0) y0 = 0;
	if (x1 >= c->width)  x1 = c->width - 1;
	if (y1 >= c->height) y1 = c->height - 1;
	if (x0 > x1 || y0 > y1)
		return;

	v0x = *cx - *ax;
	v0y = *cy - *ay;
	v1x = *bx - *ax;
	v1y = *by - *ay;
	dot00 = v0x * v0x + v0y * v0y;
	dot01 = v0x * v1x + v0y * v1y;
	dot11 = v1x * v1x + v1y * v1y;
	inv = dot00 * dot11 - dot01 * dot01;
	if (inv > -1.0e-12 && inv < 1.0e-12)
		return;
	inv = 1.0 / inv;

	y = y0;
	while (y <= y1)
	{
		x = x0;
		while (x <= x1)
		{
			px = ToF64(x) + 0.5;
			py = ToF64(y) + 0.5;
			v2x = px - *ax;
			v2y = py - *ay;
			dot02 = v0x * v2x + v0y * v2y;
			dot12 = v1x * v2x + v1y * v2y;
			u = (dot11 * dot02 - dot01 * dot12) * inv;
			v = (dot00 * dot12 - dot01 * dot02) * inv;
			w = 1.0 - u - v;
			if (u >= 0.0 && v >= 0.0 && w >= 0.0)
			{
				iz = w * (*ainv) + v * (*binv) + u * (*cinv);
				UTDrawPlot(c, x, y, iz, color);
			}
			x++;
		}
		y++;
	}
	c->tris_drawn++;
}

U0 UTDrawTri3(CUTCanvas *c, F64 *a, F64 *b, F64 *cc, I64 color)
{
	F64 ax;
	F64 ay;
	F64 aiz;
	F64 bx;
	F64 by;
	F64 biz;
	F64 cx;
	F64 cy;
	F64 ciz;

	if (!UTDrawProject(c, a, &ax, &ay, &aiz))
		return;
	if (!UTDrawProject(c, b, &bx, &by, &biz))
		return;
	if (!UTDrawProject(c, cc, &cx, &cy, &ciz))
		return;
	c->verts_drawn += 3;
	UTDrawFillTri(c, &ax, &ay, &aiz, &bx, &by, &biz, &cx, &cy, &ciz, color);
}

U0 UTDrawBlitFit(CUTCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w,
	I64 dst_h)
{
	U8	*src;
	U32	*dst;
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 sx;
	I64	 pitch;

	if (!c || !c->pixels || !ut_pal_ready)
		return;
	if (dst_w < 1 || dst_h < 1)
		return;

	pitch   = dc->width_internal;
	sx_step = (c->width << 16) / dst_w;
	sy_step = (c->height << 16) / dst_h;

	y = 0;
	while (y < dst_h)
	{
		py = dst_y + y;
		if (py >= 0 && py < dc->height)
		{
			sy = (y * sy_step) >> 16;
			if (sy >= c->height)
				sy = c->height - 1;
			src = c->pixels + sy * c->width;
			dst = dc->body + py * pitch;
			sxf = 0;
			x = 0;
			while (x < dst_w)
			{
				sx = sxf >> 16;
				if (sx >= c->width)
					sx = c->width - 1;
				if (dst_x + x >= 0 && dst_x + x < dc->width)
					dst[dst_x + x] = ut_pal_argb[src[sx]];
				sxf += sx_step;
				x++;
			}
		}
		y++;
	}
}

U0 UTDrawLine2(CUTCanvas *c, I64 x0, I64 y0, I64 x1, I64 y1, I64 color)
{
	I64 dx;
	I64 dy;
	I64 sx;
	I64 sy;
	I64 err;
	I64 e2;

	dx = x1 - x0;
	if (dx < 0) dx = -dx;
	dy = y1 - y0;
	if (dy < 0) dy = -dy;
	if (x0 < x1) sx = 1; else sx = -1;
	if (y0 < y1) sy = 1; else sy = -1;
	err = dx - dy;
	while (TRUE)
	{
		UTDrawPlot(c, x0, y0, 1.0, color);
		if (x0 == x1 && y0 == y1)
			break;
		e2 = 2 * err;
		if (e2 > -dy)
		{
			err -= dy;
			x0  += sx;
		}
		if (e2 < dx)
		{
			err += dx;
			y0  += sy;
		}
	}
}

U0 UTDrawSpanTex(CUTCanvas *c, I64 y, I64 x1, I64 x2,
	F64 iz1, F64 uoz1, F64 voz1, F64 iz2, F64 uoz2, F64 voz2,
	CUTTex *tex, CUTSpanBuf *span)
{//one horizontal SoftDrv textured run. Perspective: u = (u/z)/(1/z).
 //Mirrors QDrawSpan without lightmap. Optional FSpanBuffer clip+punch.
	U8	*row;
	F64	*zrow;
	F64	 span_w;
	F64	 d_iz;
	F64	 d_uoz;
	F64	 d_voz;
	F64	 iz;
	F64	 uoz;
	F64	 voz;
	F64	 z;
	I64	 x;
	I64	 u;
	I64	 v;
	I64	 i;
	I64	 texel;
	I64	 n;
	I64	 step;
	F64	 iz_e;
	F64	 uoz_e;
	F64	 voz_e;
	F64	 u0;
	F64	 v0;
	F64	 u1;
	F64	 v1;
	F64	 du;
	F64	 dv;
	I64	 cx1;
	I64	 cx2;

	if (!c || !tex || y < 0 || y >= c->height)
		return;
	if (x1 >= x2)
		return;

	cx1 = x1;
	cx2 = x2;
	if (span)
	{
		if (!UTSpanClip(span, y, &cx1, &cx2))
			return;
		if (cx1 != x1)
		{
			span_w = ToF64(x2 - x1);
			if (span_w > 0.0)
			{
				iz1  += (iz2 - iz1) * ToF64(cx1 - x1) / span_w;
				uoz1 += (uoz2 - uoz1) * ToF64(cx1 - x1) / span_w;
				voz1 += (voz2 - voz1) * ToF64(cx1 - x1) / span_w;
			}
			x1 = cx1;
		}
		x2 = cx2;
	}
	if (x1 < 0)
	{
		span_w = ToF64(x2 - x1);
		//x1 negative: shift interpolants; clamp after
		if (span_w > 0.0)
		{
			iz1  += (iz2 - iz1) * ToF64(0 - x1) / span_w;
			uoz1 += (uoz2 - uoz1) * ToF64(0 - x1) / span_w;
			voz1 += (voz2 - voz1) * ToF64(0 - x1) / span_w;
		}
		x1 = 0;
	}
	if (x2 > c->width)
		x2 = c->width;
	if (x1 >= x2)
		return;

	span_w = ToF64(x2 - x1);
	d_iz   = (iz2 - iz1) / span_w;
	d_uoz  = (uoz2 - uoz1) / span_w;
	d_voz  = (voz2 - voz1) / span_w;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;
	iz   = iz1;
	uoz  = uoz1;
	voz  = voz1;
	x    = x1;

	while (x < x2)
	{
		n = x2 - x;
		if (n > UT_SPAN_SUB)
			n = UT_SPAN_SUB;
		iz_e  = iz + d_iz * ToF64(n);
		uoz_e = uoz + d_uoz * ToF64(n);
		voz_e = voz + d_voz * ToF64(n);

		if (iz <= 0.0 || iz_e <= 0.0)
		{
			iz = iz_e; uoz = uoz_e; voz = voz_e;
			x += n;
			goto ut_span_next;
		}

		z  = 1.0 / iz;
		u0 = uoz * z;
		v0 = voz * z;
		z  = 1.0 / iz_e;
		u1 = uoz_e * z;
		v1 = voz_e * z;
		du = (u1 - u0) / ToF64(n);
		dv = (v1 - v0) / ToF64(n);

		step = 0;
		while (step < n)
		{
			i = x + step;
			if (iz > zrow[i])
			{
				u = ToI64(u0);
				v = ToI64(v0);
				texel = UTTexSample(tex, u, v);
				if (texel)
				{
					zrow[i] = iz;
					row[i]  = texel;
				}
			}
			u0 += du;
			v0 += dv;
			iz += d_iz;
			step++;
		}
		uoz = uoz_e;
		voz = voz_e;
		x += n;
ut_span_next:
	}

	if (span)
		UTSpanPunch(span, y, x1, x2);
	c->spans_drawn++;
}

U0 UTDrawFillTriTex(CUTCanvas *c,
	F64 ax, F64 ay, F64 aiz, F64 au, F64 av,
	F64 bx, F64 by, F64 biz, F64 bu, F64 bv,
	F64 cx, F64 cy, F64 ciz, F64 cu, F64 cv,
	CUTTex *tex, CUTSpanBuf *span)
{//gouraud-style SoftDrv DrawGouraudPolygon for one triangle, P8 tex.
	F64	minx;
	F64	maxx;
	F64	miny;
	F64	maxy;
	I64	x0;
	I64	x1;
	I64	y0;
	I64	y1;
	I64	x;
	I64	y;
	F64	px;
	F64	py;
	F64	v0x;
	F64	v0y;
	F64	v1x;
	F64	v1y;
	F64	v2x;
	F64	v2y;
	F64	dot00;
	F64	dot01;
	F64	dot02;
	F64	dot11;
	F64	dot12;
	F64	inv;
	F64	u;
	F64	v;
	F64	w;
	F64	iz;
	F64	tu;
	F64	tv;
	F64	uoz;
	F64	voz;
	I64	texel;
	I64	i;

	minx = ax;
	if (bx < minx) minx = bx;
	if (cx < minx) minx = cx;
	maxx = ax;
	if (bx > maxx) maxx = bx;
	if (cx > maxx) maxx = cx;
	miny = ay;
	if (by < miny) miny = by;
	if (cy < miny) miny = cy;
	maxy = ay;
	if (by > maxy) maxy = by;
	if (cy > maxy) maxy = cy;

	x0 = ToI64(minx);
	x1 = ToI64(maxx);
	y0 = ToI64(miny);
	y1 = ToI64(maxy);
	if (x0 < 0) x0 = 0;
	if (y0 < 0) y0 = 0;
	if (x1 >= c->width)  x1 = c->width - 1;
	if (y1 >= c->height) y1 = c->height - 1;
	if (x0 > x1 || y0 > y1)
		return;

	v0x = cx - ax; v0y = cy - ay;
	v1x = bx - ax; v1y = by - ay;
	dot00 = v0x * v0x + v0y * v0y;
	dot01 = v0x * v1x + v0y * v1y;
	dot11 = v1x * v1x + v1y * v1y;
	inv = dot00 * dot11 - dot01 * dot01;
	if (inv > -1.0e-12 && inv < 1.0e-12)
		return;
	inv = 1.0 / inv;

	y = y0;
	while (y <= y1)
	{
		x = x0;
		while (x <= x1)
		{
			px = ToF64(x) + 0.5;
			py = ToF64(y) + 0.5;
			v2x = px - ax;
			v2y = py - ay;
			dot02 = v0x * v2x + v0y * v2y;
			dot12 = v1x * v2x + v1y * v2y;
			u = (dot11 * dot02 - dot01 * dot12) * inv;
			v = (dot00 * dot12 - dot01 * dot02) * inv;
			w = 1.0 - u - v;
			if (u >= 0.0 && v >= 0.0 && w >= 0.0)
			{
				iz  = w * aiz + v * biz + u * ciz;
				tu  = w * au + v * bu + u * cu;
				tv  = w * av + v * bv + u * cv;
				uoz = tu * iz;
				voz = tv * iz;
				no_warn uoz;
				no_warn voz;
				i = y * c->width + x;
				if (iz > c->depth[i])
				{
					texel = UTTexSample(tex, ToI64(tu), ToI64(tv));
					if (texel)
					{
						c->depth[i]  = iz;
						c->pixels[i] = texel;
					}
				}
			}
			x++;
		}
		if (span)
			UTSpanPunch(span, y, x0, x1 + 1);
		y++;
	}
	c->tris_drawn++;
}

U0 UTDrawTriTex3(CUTCanvas *c, F64 *a, F64 *b, F64 *cc,
	F64 au, F64 av, F64 bu, F64 bv, F64 cu, F64 cv,
	CUTTex *tex, CUTSpanBuf *span)
{
	F64 ax;
	F64 ay;
	F64 aiz;
	F64 bx;
	F64 by;
	F64 biz;
	F64 cx;
	F64 cy;
	F64 ciz;

	if (!UTDrawProject(c, a, &ax, &ay, &aiz))
		return;
	if (!UTDrawProject(c, b, &bx, &by, &biz))
		return;
	if (!UTDrawProject(c, cc, &cx, &cy, &ciz))
		return;
	c->verts_drawn += 3;
	UTDrawFillTriTex(c, ax, ay, aiz, au, av, bx, by, biz, bu, bv,
		cx, cy, ciz, cu, cv, tex, span);
}

U0 UTDrawTile(CUTCanvas *c, CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	F64 u0, F64 v0, F64 uw, F64 vh, F64 z, CUTSpanBuf *span)
{//URenderDevice::DrawTile — screen-aligned SoftDrv 2D blit.
	I64	px;
	I64	py;
	I64	x1;
	I64	y1;
	I64	cx1;
	I64	cx2;
	F64	du;
	F64	dv;
	F64	u;
	F64	v;
	F64	iz;
	I64	texel;
	I64	i;

	if (!c || !tex || w < 1 || h < 1)
		return;
	iz = 1.0 / z;
	if (iz <= 0.0)
		return;
	x1 = x + w;
	y1 = y + h;
	if (x1 > c->width)  x1 = c->width;
	if (y1 > c->height) y1 = c->height;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x >= x1 || y >= y1)
		return;

	du = uw / ToF64(w);
	dv = vh / ToF64(h);
	py = y;
	while (py < y1)
	{
		cx1 = x;
		cx2 = x1;
		if (span)
		{
			if (!UTSpanClip(span, py, &cx1, &cx2))
			{
				py++;
				goto ut_tile_row;
			}
		}
		v = v0 + ToF64(py - y) * dv;
		px = cx1;
		while (px < cx2)
		{
			u = u0 + ToF64(px - x) * du;
			i = py * c->width + px;
			if (iz >= c->depth[i])
			{
				texel = UTTexSample(tex, ToI64(u), ToI64(v));
				if (texel)
				{
					c->depth[i]  = iz;
					c->pixels[i] = texel;
				}
			}
			px++;
		}
		if (span)
			UTSpanPunch(span, py, cx1, cx2);
ut_tile_row:
		py++;
	}
	c->tiles_drawn++;
}

