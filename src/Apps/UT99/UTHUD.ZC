// UTHUD.ZC - SoftDrv status HUD + scoreboard. Not UWindow / not retail fonts.
//
// Big health bottom-left, ammo bottom-right, weapon name centre-bottom.
// SoftDrv 3x5 glyphs (same atlas as menu). UWindowFonts.utx optional digi.

#define UT_HUD_HEALTH_COL	250
#define UT_HUD_ARMOR_COL	200
#define UT_HUD_AMMO_COL		180
#define UT_HUD_FRAG_COL		40
#define UT_HUD_WEAP_COL		220
#define UT_HUD_LABEL		255

extern U0 UTMenuFill(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col);
extern U0 UTMenuText(CUTCanvas *c, I64 x, I64 y, U8 *s, I64 col);
extern U0 UTMenuNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col);
extern U0 UTMenuDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col);

CUTTex	ut_hud_font_tex;
Bool	ut_hud_font_ok	= FALSE;

U0 UTHUDFillRect(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	UTMenuFill(c, x, y, w, h, col);
}

//3x5 digit bitmasks — kept for callers that still use ut_hud_digit_rows
U8 ut_hud_digit_rows[50] = {
	7,5,5,5,7,
	2,2,2,2,2,
	7,1,7,4,7,
	7,1,7,1,7,
	5,5,7,1,1,
	7,4,7,1,7,
	7,4,7,5,7,
	7,1,1,1,1,
	7,5,7,5,7,
	7,5,7,1,7
};

U0 UTHUDInit()
{
	ut_hud_font_ok = FALSE;
	UTTexInit(&ut_hud_font_tex);
	if (FileFind("::/Apps/UT99/Textures/UWindowFonts.utx"))
	{
		if (UTTexLoadNamed("::/Apps/UT99/Textures/UWindowFonts.utx",
			"Tahoma10", &ut_hud_font_tex))
		{
			ut_hud_font_ok = TRUE;
			UTLog("UTHUD: UWindowFonts Tahoma10 present\n");
		}
		else if (UTTexLoadNamed("::/Apps/UT99/Textures/UWindowFonts.utx",
			"UTFontComic", &ut_hud_font_tex))
		{
			ut_hud_font_ok = TRUE;
			UTLog("UTHUD: UWindowFonts UTFontComic present\n");
		}
	}
}

U0 UTHUDDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	UTMenuDigit(c, x, y, digit, col);
}

U0 UTHUDNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	UTMenuNumber(c, x, y, value, col);
}

U0 UTHUDNumberBig(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{//2x scale digits for health/ammo.
	I64 d0;
	I64 d1;
	I64 d2;
	I64 ox;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	ox = x;
	if (d2)
	{
		UTMenuDigit(c, ox, y, d2, col);
		UTMenuDigit(c, ox + 1, y + 1, d2, col);
		ox += 16;
	}
	if (d2 || d1)
	{
		UTMenuDigit(c, ox, y, d1, col);
		UTMenuDigit(c, ox + 1, y + 1, d1, col);
		ox += 16;
	}
	UTMenuDigit(c, ox, y, d0, col);
	UTMenuDigit(c, ox + 1, y + 1, d0, col);
}

U0 UTHUDDraw(CUTCanvas *c)
{
	I64 hp;
	I64 ar;
	I64 ammo;
	I64 fr;
	I64 deaths;
	I64 wi;
	I64 i;
	I64 x;
	U8 *wname;

	if (!c || !ut_game_ready || ut_menu_open)
		return;

	hp = ToI64(ut_health);
	ar = ToI64(ut_armor);
	ammo = ut_weap_ammo[ut_weap_cur];
	fr = ut_frags;
	deaths = ut_deaths;

	//health bottom-left big
	UTMenuText(c, 4, c->height - 56, "HEALTH", UT_HUD_LABEL);
	UTHUDNumberBig(c, 4, c->height - 44, hp, UT_HUD_HEALTH_COL);
	UTHUDFillRect(c, 4, c->height - 16, 90, 8, 8);
	UTHUDFillRect(c, 4, c->height - 16, hp * 90 / 100, 8, UT_HUD_HEALTH_COL);

	//armor under health label
	if (ar > 0)
	{
		UTHUDFillRect(c, 100, c->height - 16, 50, 6, 8);
		UTHUDFillRect(c, 100, c->height - 16, ar * 50 / 100, 6, UT_HUD_ARMOR_COL);
	}

	//ammo bottom-right
	UTMenuText(c, c->width - 72, c->height - 56, "AMMO", UT_HUD_LABEL);
	UTHUDNumberBig(c, c->width - 56, c->height - 44, ammo, UT_HUD_AMMO_COL);
	UTHUDFillRect(c, c->width - 94, c->height - 16, 90, 8, 8);
	if (ut_weap_def[ut_weap_cur].ammo_max > 0)
		UTHUDFillRect(c, c->width - 94, c->height - 16,
			ammo * 90 / ut_weap_def[ut_weap_cur].ammo_max, 8, UT_HUD_AMMO_COL);

	//weapon name centre-bottom
	wname = ut_weap_def[ut_weap_cur].name;
	if (wname)
		UTMenuText(c, c->width / 2 - 40, c->height - 56, wname, UT_HUD_WEAP_COL);

	//weapon strip top-centre
	x = c->width / 2 - UT_WEAP_N * 5;
	i = 0;
	while (i < UT_WEAP_N)
	{
		wi = 8;
		if (ut_weap_owned[i])
		{
			if (i == ut_weap_cur)
				UTHUDFillRect(c, x + i * 10, 4, 8, 8, UT_HUD_WEAP_COL);
			else
				UTHUDFillRect(c, x + i * 10, 6, 6, 4, 100);
		}
		no_warn wi;
		i++;
	}

	//score top-left
	UTHUDNumber(c, 4, 4, fr, UT_HUD_FRAG_COL);
	UTHUDFillRect(c, 30, 8, 4, 4, 80);
	UTHUDNumber(c, 36, 4, deaths, 80);
	UTHUDNumber(c, c->width - 40, 4, ut_frag_limit, 100);

	if (ut_ctf_active)
	{
		UTHUDNumber(c, c->width / 2 - 40, 4, ut_ctf_score[0], 40);
		UTHUDFillRect(c, c->width / 2 - 8, 8, 4, 4, 120);
		UTHUDNumber(c, c->width / 2 + 4, 4, ut_ctf_score[1], 200);
	}
	else if (ut_dom_active)
		UTHUDNumber(c, c->width / 2 - 16, 4, ut_ctf_score[0], 180);

	if (ut_zone_in_water)
		UTHUDFillRect(c, c->width / 2 - 10, c->height - 8, 20, 4, 200);

	if (ut_music.playing)
		UTHUDFillRect(c, c->width - 6, 16, 4, 4, 50);

	if (ut_hud_font_ok)
		UTHUDFillRect(c, 4, 20, 4, 4, 50);
}

U0 UTHUDDrawScoreboard(CUTCanvas *c)
{//hold TAB — list frags. SoftDrv text via bars.
	I64 i;
	I64 y;

	if (!c)
		return;
	UTHUDFillRect(c, 40, 40, c->width - 80, c->height - 80, 16);
	UTMenuText(c, 60, 48, "SCORE", UT_HUD_FRAG_COL);
	UTHUDNumber(c, 120, 48, ut_frags, UT_HUD_FRAG_COL);
	if (ut_match_over)
		UTMenuText(c, 60, 66, "MATCH OVER", UT_HUD_HEALTH_COL);
	y = 88;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		UTHUDNumber(c, 60, y, ut_bots[i].score, 180);
		UTHUDNumber(c, 100, y, ToI64(ut_bots[i].health), 100);
		y += 16;
		i++;
	}
}
