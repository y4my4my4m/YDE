// UTHUD.ZC - ChallengeHUD-style status via UTWin Canvas.
//
// SoftDrv P8 pens from ut_col_* after UTPalInstall. Text through UFont
// when UTWin ready (Botpack ChallengeHUD DrawText path).

CUTTex	ut_hud_font_tex;
Bool	ut_hud_font_ok	= FALSE;

U0 UTHUDFillRect(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	UTMenuFill(c, x, y, w, h, col);
}

U8 ut_hud_digit_rows[50] = {
	7,5,5,5,7,
	2,2,2,2,2,
	7,1,7,4,7,
	7,1,7,1,7,
	5,5,7,1,1,
	7,4,7,1,7,
	7,4,7,5,7,
	7,1,1,1,1,
	7,5,7,5,7,
	7,5,7,1,7
};

U0 UTHUDInit()
{
	ut_hud_font_ok = ut_font_ready;
	if (ut_hud_font_ok)
		UTLog("UTHUD: ChallengeHUD text via UFont %s\n", ut_font_ui.name);
}

U0 UTHUDDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	UTMenuDigit(c, x, y, digit, col);
}

U0 UTHUDNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	U8 buf[12];

	no_warn c;
	StrPrint(buf, "%d", value);
	if (ut_win_ready && ut_font_ready)
		UTWinTextAt(x, y, buf, col);
	else
		UTMenuNumber(c, x, y, value, col);
}

U0 UTHUDNumberBig(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	U8 buf[12];

	no_warn c;
	if (value < 0) value = 0;
	if (value > 999) value = 999;
	StrPrint(buf, "%d", value);
	if (ut_win_ready && ut_font_ready)
		UTWinTextAt(x, y, buf, col);
	else
		UTMenuNumber(c, x, y, value, col);
}

U0 UTHUDDraw(CUTCanvas *c)
{
	I64 hp;
	I64 ar;
	I64 ammo;
	I64 fr;
	I64 deaths;
	I64 wi;
	I64 i;
	I64 x;
	U8 *wname;
	U8 line[24];

	if (!c || !ut_game_ready || ut_menu_open)
		return;

	if (ut_win_ready)
		ut_win.fb = c;

	hp = ToI64(ut_health);
	ar = ToI64(ut_armor);
	ammo = ut_weap_ammo[ut_weap_cur];
	fr = ut_frags;
	deaths = ut_deaths;

	UTMenuText(c, 4, c->height - 56, "Health", ut_col_white);
	StrPrint(line, "%d", hp);
	UTMenuText(c, 4, c->height - 42, line, ut_col_health);
	UTHUDFillRect(c, 4, c->height - 16, 90, 8, ut_col_panel);
	UTHUDFillRect(c, 4, c->height - 16, hp * 90 / 100, 8, ut_col_health);

	if (ar > 0)
	{
		UTHUDFillRect(c, 100, c->height - 16, 50, 6, ut_col_panel);
		UTHUDFillRect(c, 100, c->height - 16, ar * 50 / 100, 6, ut_col_armor);
	}

	UTMenuText(c, c->width - 72, c->height - 56, "Ammo", ut_col_white);
	StrPrint(line, "%d", ammo);
	UTMenuText(c, c->width - 56, c->height - 42, line, ut_col_ammo);
	UTHUDFillRect(c, c->width - 94, c->height - 16, 90, 8, ut_col_panel);
	if (ut_weap_def[ut_weap_cur].ammo_max > 0)
		UTHUDFillRect(c, c->width - 94, c->height - 16,
			ammo * 90 / ut_weap_def[ut_weap_cur].ammo_max, 8, ut_col_ammo);

	wname = ut_weap_def[ut_weap_cur].name;
	if (wname)
		UTMenuText(c, c->width / 2 - 40, c->height - 56, wname, ut_col_gold);

	x = c->width / 2 - UT_WEAP_N * 5;
	i = 0;
	while (i < UT_WEAP_N)
	{
		wi = 8;
		if (ut_weap_owned[i])
		{
			if (i == ut_weap_cur)
				UTHUDFillRect(c, x + i * 10, 4, 8, 8, ut_col_gold);
			else
				UTHUDFillRect(c, x + i * 10, 6, 6, 4, ut_col_dim);
		}
		no_warn wi;
		i++;
	}

	StrPrint(line, "%d", fr);
	UTMenuText(c, 4, 4, line, ut_col_frag);
	UTHUDFillRect(c, 30, 8, 4, 4, ut_col_dim);
	StrPrint(line, "%d", deaths);
	UTMenuText(c, 36, 4, line, ut_col_dim);
	StrPrint(line, "%d", ut_frag_limit);
	UTMenuText(c, c->width - 40, 4, line, ut_col_dim);

	if (ut_ctf_active)
	{
		StrPrint(line, "%d", ut_ctf_score[0]);
		UTMenuText(c, c->width / 2 - 40, 4, line, ut_col_frag);
		UTHUDFillRect(c, c->width / 2 - 8, 8, 4, 4, ut_col_dim);
		StrPrint(line, "%d", ut_ctf_score[1]);
		UTMenuText(c, c->width / 2 + 4, 4, line, ut_col_armor);
	}
	else if (ut_dom_active)
	{
		StrPrint(line, "%d", ut_ctf_score[0]);
		UTMenuText(c, c->width / 2 - 16, 4, line, ut_col_ammo);
	}

	if (ut_zone_in_water)
		UTHUDFillRect(c, c->width / 2 - 10, c->height - 8, 20, 4, ut_col_armor);

	if (ut_music.playing)
		UTHUDFillRect(c, c->width - 6, 16, 4, 4, ut_col_gold);
}

U0 UTHUDDrawScoreboard(CUTCanvas *c)
{
	I64 i;
	I64 y;
	U8 line[24];

	if (!c)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	UTHUDFillRect(c, 40, 40, c->width - 80, c->height - 80, ut_col_panel);
	UTMenuText(c, 60, 48, "Score", ut_col_frag);
	StrPrint(line, "%d", ut_frags);
	UTMenuText(c, 120, 48, line, ut_col_frag);
	if (ut_match_over)
		UTMenuText(c, 60, 66, "Match Over", ut_col_health);
	y = 88;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		StrPrint(line, "%d", ut_bots[i].score);
		UTMenuText(c, 60, y, line, ut_col_ammo);
		StrPrint(line, "%d", ToI64(ut_bots[i].health));
		UTMenuText(c, 100, y, line, ut_col_dim);
		y += 16;
		i++;
	}
}
