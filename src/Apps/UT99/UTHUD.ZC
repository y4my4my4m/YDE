// UTHUD.ZC - ChallengeHUD digit tiles + StatusDoll + HUDWeapons.
//
// Boot: UTClientDrawViewChrome → UTObjPostRender + UTHUDDraw.
// Digits = Texture'BotPack.HudElements1' (ChallengeHUD.DrawDigit).
// Doll = Texture'Botpack.Icons.Man' / ManBelt. Weapons = HUDWeapons.

extern F64	ut_health;
extern F64	ut_armor;
extern I64	ut_ammo;

CUTTex	ut_hud_elements;
Bool	ut_hud_elements_ok	= FALSE;
CUTTex	ut_hud_weapons;
Bool	ut_hud_weapons_ok	= FALSE;
CUTTex	ut_hud_doll;
Bool	ut_hud_doll_ok	= FALSE;
CUTTex	ut_hud_belt;
Bool	ut_hud_belt_ok	= FALSE;
CUTTex	ut_hud_font_tex;
Bool	ut_hud_font_ok	= FALSE;
F64		ut_hud_scale	= 1.0;

U0 UTHUDFillRect(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	UTMenuFill(c, x, y, w, h, col);
}

U0 UTHUDInit()
{
	ut_hud_elements_ok = FALSE;
	ut_hud_weapons_ok = FALSE;
	ut_hud_doll_ok = FALSE;
	ut_hud_belt_ok = FALSE;
	ut_hud_font_ok = FALSE;
	ut_hud_scale = 1.0;
	UTTexInit(&ut_hud_elements);
	UTTexInit(&ut_hud_weapons);
	UTTexInit(&ut_hud_doll);
	UTTexInit(&ut_hud_belt);
	if (UTTexLoadNamed("::/Apps/UT99/System/Botpack.u", "HudElements1",
		&ut_hud_elements))
	{
		ut_hud_elements_ok = TRUE;
		UTLog("UTHUD: HudElements1 %dx%d ok\n",
			ut_hud_elements.u_size, ut_hud_elements.v_size);
	}
	else
		UTLog("UTHUD: HudElements1 miss — glyph fallback\n");
	if (UTTexLoadNamed("::/Apps/UT99/System/Botpack.u", "HUDWeapons",
		&ut_hud_weapons))
	{
		ut_hud_weapons_ok = TRUE;
		UTLog("UTHUD: HUDWeapons %dx%d ok\n",
			ut_hud_weapons.u_size, ut_hud_weapons.v_size);
	}
	if (UTTexLoadNamed("::/Apps/UT99/System/Botpack.u", "Man",
		&ut_hud_doll))
	{
		ut_hud_doll_ok = TRUE;
		UTLog("UTHUD: StatusDoll Man %dx%d ok\n",
			ut_hud_doll.u_size, ut_hud_doll.v_size);
	}
	if (UTTexLoadNamed("::/Apps/UT99/System/Botpack.u", "ManBelt",
		&ut_hud_belt))
	{
		ut_hud_belt_ok = TRUE;
		UTLog("UTHUD: ManBelt %dx%d ok\n",
			ut_hud_belt.u_size, ut_hud_belt.v_size);
	}
}

U0 UTHUDExit()
{
	if (ut_hud_elements_ok)
		UTTexFreeMips(&ut_hud_elements);
	if (ut_hud_weapons_ok)
		UTTexFreeMips(&ut_hud_weapons);
	if (ut_hud_doll_ok)
		UTTexFreeMips(&ut_hud_doll);
	if (ut_hud_belt_ok)
		UTTexFreeMips(&ut_hud_belt);
	ut_hud_elements_ok = FALSE;
	ut_hud_weapons_ok = FALSE;
	ut_hud_doll_ok = FALSE;
	ut_hud_belt_ok = FALSE;
}

U0 UTHUDDrawDigitTile(CUTCanvas *c, I64 *cur_x, I64 cur_y, I64 d,
	F64 up_scale, I64 step)
{//ChallengeHUD.DrawDigit — DrawTile HudElements1 strip.
	I64 dw;
	I64 dh;
	I64 x;

	no_warn c;
	if (!ut_hud_elements_ok || !ut_win_ready)
		return;
	if (d < 0) d = 0;
	if (d > 9) d = 9;
	dw = ToI64(25.0 * up_scale);
	dh = ToI64(64.0 * up_scale);
	if (d == 1)
		*cur_x -= ToI64(0.625 * ToF64(step));
	else
		*cur_x -= ToI64(0.25 * ToF64(step));
	x = *cur_x;
	UTWinDrawTile(&ut_hud_elements, x, cur_y, dw, dh,
		d * 25, 0, 25, 64);
	*cur_x = x + ToI64(7.0 * up_scale);
}

U0 UTHUDDrawBigNum(CUTCanvas *c, I64 value, I64 x, I64 y, F64 scale_factor)
{//ChallengeHUD.DrawBigNum
	I64 d;
	I64 mag;
	I64 step;
	I64 cur_x;
	F64 up_scale;
	Bool minus;
	U8 buf[12];

	if (!c)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	if (scale_factor > 0.001)
		up_scale = ut_hud_scale * scale_factor;
	else
		up_scale = ut_hud_scale;
	if (up_scale < 0.35)
		up_scale = 0.35;
	cur_x = x;
	step = ToI64(16.0 * up_scale);
	minus = FALSE;
	if (value < 0)
	{
		minus = TRUE;
		value = -value;
	}
	mag = value;
	if (mag > 9999)
		mag = 9999;

	if (ut_hud_elements_ok)
	{
		if (minus)
		{
			cur_x -= step;
			UTWinDrawTile(&ut_hud_elements, cur_x, y,
				ToI64(25.0 * up_scale), ToI64(64.0 * up_scale),
				0, 64, 25, 64);
		}
		if (mag >= 1000)
		{
			cur_x -= step;
			d = mag / 1000;
			UTHUDDrawDigitTile(c, &cur_x, y, d, up_scale, step);
			mag = mag - 1000 * d;
			d = mag / 100;
			UTHUDDrawDigitTile(c, &cur_x, y, d, up_scale, step);
			mag = mag - 100 * d;
		}
		else if (mag >= 100)
		{
			d = mag / 100;
			UTHUDDrawDigitTile(c, &cur_x, y, d, up_scale, step);
			mag = mag - 100 * d;
		}
		else
			cur_x += step;

		if (mag >= 10)
		{
			d = mag / 10;
			UTHUDDrawDigitTile(c, &cur_x, y, d, up_scale, step);
			mag = mag - 10 * d;
		}
		else if (value >= 100)
			UTHUDDrawDigitTile(c, &cur_x, y, 0, up_scale, step);
		else
			cur_x += step;

		UTHUDDrawDigitTile(c, &cur_x, y, mag, up_scale, step);
		return;
	}

	if (ut_win_ready)
	{
		StrPrint(buf, "%d", value);
		UTWinTextAt(x, y, buf, ut_col_white);
	}
}

U0 UTHUDDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	I64 cx;

	no_warn col;
	cx = x;
	UTHUDDrawDigitTile(c, &cx, y, digit, ut_hud_scale, ToI64(16.0 * ut_hud_scale));
}

U0 UTHUDNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	no_warn col;
	UTHUDDrawBigNum(c, value, x, y, 0.75);
}

U0 UTHUDNumberBig(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	no_warn col;
	UTHUDDrawBigNum(c, value, x, y, 1.0);
}

U0 UTHUDDrawDoll(CUTCanvas *c, F64 scale)
{//ChallengeHUD.DrawStatus StatusDoll — Man standing, top-right.
	I64 x;
	I64 dw;
	I64 dh;

	if (!c || !ut_hud_doll_ok || !ut_win_ready)
		return;
	if (c->width < 400)
		return;
	dw = ToI64(128.0 * scale);
	dh = ToI64(256.0 * scale);
	x = c->width - dw - 4;
	UTWinSetStyle(UT_STY_TRANSLUCENT);
	UTWinSetDrawColor(0, 180, 255);
	UTWinDrawTile(&ut_hud_doll, x, 4, dw, dh, 0, 0, 128, 256);
	UTWinSetStyle(UT_STY_NORMAL);
	UTWinSetDrawColor(255, 255, 255);
	if (ut_hud_belt_ok && ut_armor > 50.0)
		UTWinDrawTile(&ut_hud_belt, x, 4, dw, ToI64(64.0 * scale),
			0, 0, 128, 64);
	//Chest / thigh armor overlays from doll sheet (ChallengeHUD UVs)
	if (ut_armor > 0.0)
	{
		UTWinDrawTile(&ut_hud_doll, x, 4,
			dw, ToI64(64.0 * scale), 128, 0, 128, 64);
		if (ut_armor > 50.0)
			UTWinDrawTile(&ut_hud_doll, x, 4 + ToI64(64.0 * scale),
				dw, ToI64(64.0 * scale), 128, 64, 128, 64);
	}
}

U0 UTHUDDrawWeapons(CUTCanvas *c, F64 scale)
{//ChallengeHUD.DrawWeapons — HUDWeapons icon strip for owned InventoryGroups.
	I64 i;
	I64 g;
	I64 base_x;
	I64 base_y;
	I64 wx;
	I64 wy;
	I64 tex_x;
	I64 tex_y;
	I64 slot_w;
	F64 weap_scale;
	I64 wid;
	I64 cur_g;

	if (!c || !ut_win_ready)
		return;
	weap_scale = scale;
	if (weap_scale < 0.4)
		weap_scale = 0.4;
	slot_w = ToI64(0.1 * ToF64(c->width));
	if (slot_w < 40)
		slot_w = 40;
	base_x = (c->width - 10 * slot_w) / 2;
	if (base_x < 0)
		base_x = 0;
	base_y = c->height - ToI64(63.5 * weap_scale);
	tex_x = ToI64(128.0 * weap_scale);
	tex_y = ToI64(64.0 * weap_scale);
	cur_g = 0;
	if (ut_weap_cur >= 0 && ut_weap_cur < UT_WEAP_N)
		cur_g = ut_weap_def[ut_weap_cur].inv_group;

	i = 1;
	while (i <= 10)
	{
		wid = -1;
		g = 0;
		while (g < UT_WEAP_N)
		{
			if (ut_weap_owned[g] && ut_weap_def[g].inv_group == i)
				wid = g;
			g++;
		}
		wx = base_x + (i - 1) * slot_w;
		wy = base_y;
		if (ut_hud_weapons_ok)
		{
			UTWinDrawTile(&ut_hud_weapons, wx, wy, tex_x, tex_y,
				((i - 1) % 4) * 64, ((i - 1) / 4) * 32, 64, 32);
			if (wid == ut_weap_cur || cur_g == i)
				UTWinDrawTile(&ut_hud_weapons, wx, wy,
					ToI64(128.0 * weap_scale), ToI64(64.0 * weap_scale),
					128, 64, 128, 64);
		}
		if (wid >= 0 && ut_hud_elements_ok)
		{
			UTWinDrawTile(&ut_hud_elements,
				wx + ToI64(4.0 * weap_scale),
				wy + ToI64(4.0 * weap_scale),
				ToI64(0.75 * weap_scale * 25.0),
				ToI64(0.75 * weap_scale * 64.0),
				25 * i, 0, 25, 64);
			if (ut_weap_def[wid].ammo_max > 0)
			{
				g = ToI64(88.0 * weap_scale *
					ToF64(ut_weap_ammo[wid]) /
					ToF64(ut_weap_def[wid].ammo_max));
				if (g < 0) g = 0;
				if (g > ToI64(88.0 * weap_scale))
					g = ToI64(88.0 * weap_scale);
				UTWinDrawTile(&ut_hud_elements,
					wx + ToI64(4.0 * weap_scale),
					wy + ToI64(52.0 * weap_scale),
					g, ToI64(8.0 * weap_scale),
					64, 64, 128, 8);
			}
		}
		i++;
	}
}

U0 UTHUDDraw(CUTCanvas *c)
{//ChallengeHUD.DrawStatus + DrawWeapons subset.
	I64 hp;
	I64 ar;
	I64 am;
	I64 base_y;
	F64 scale;

	if (!c)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	scale = ToF64(c->width) / 640.0;
	if (scale < 0.5)
		scale = 0.5;
	if (scale > 2.0)
		scale = 2.0;
	scale = scale * ut_opt_hud;
	if (scale < 0.4)
		scale = 0.4;
	if (scale > 3.0)
		scale = 3.0;
	ut_hud_scale = scale;
	hp = ToI64(ut_health);
	ar = ToI64(ut_armor);
	am = ut_ammo;
	base_y = c->height - ToI64(64.0 * scale) - 8;

	UTHUDDrawDoll(c, scale);

	//ChallengeHUD DrawColor: White digits, HUD cyan status, gold weapon select
	UTWinSetDrawColor(0, 180, 255);
	UTHUDDrawWeapons(c, scale);
	UTWinSetDrawColor(255, 255, 255);

	//Status icon strips from HudElements1 (ChallengeHUD layout approx)
	if (ut_hud_elements_ok)
	{
		UTWinSetDrawColor(0, 160, 255);
		UTWinDrawTile(&ut_hud_elements, 4, base_y,
			ToI64(128.0 * scale), ToI64(64.0 * scale),
			0, 128, 128, 64);
		UTWinDrawTile(&ut_hud_elements, ToI64(140.0 * scale), base_y,
			ToI64(128.0 * scale), ToI64(64.0 * scale),
			128, 128, 128, 64);
		UTWinSetDrawColor(255, 255, 255);
	}
	UTHUDDrawBigNum(c, hp, ToI64(20.0 * scale), base_y, 1.0);
	UTHUDDrawBigNum(c, ar, ToI64(160.0 * scale), base_y, 1.0);
	UTWinSetDrawColor(255, 220, 64);
	UTHUDDrawBigNum(c, am, c->width - ToI64(100.0 * scale), base_y, 1.0);
	UTWinSetDrawColor(255, 255, 255);
}

U0 UTHUDDrawScoreboard(CUTCanvas *c)
{//ChallengeHUD scoreboard — player + bot frags (prefs gated).
	I64 i;
	I64 y;
	U8 line[64];
	CUTBot *bot;

	if (!c || !ut_win_ready)
		return;
	ut_win.fb = c;
	UTWinFill(c->width / 4, 40, c->width / 2, 24 + (ut_bot_count + 2) * 14,
		ut_col_black);
	UTWinTextAt(c->width / 4 + 8, 44, "SCOREBOARD", ut_col_white);
	if (ut_sb_frags_on && ut_sb_deaths_on)
		StrPrint(line, "%s  %d frags  %d deaths", ut_player_name,
			ut_frags, ut_deaths);
	else if (ut_sb_frags_on)
		StrPrint(line, "%s  %d frags", ut_player_name, ut_frags);
	else
		StrPrint(line, "%s", ut_player_name);
	UTWinTextAt(c->width / 4 + 8, 62, line, ut_col_sel);
	y = 78;
	if (ut_sb_bot_scores)
	{
		i = 0;
		while (i < UT_GM_BOT_N)
		{
			bot = &ut_bots[i];
			if (i < ut_bot_count)
			{
				StrPrint(line, "Bot%d  %d", i + 1, bot->score);
				UTWinTextAt(c->width / 4 + 8, y, line, ut_col_label);
				y += 14;
			}
			i++;
		}
	}
	if (ut_match_over)
		UTWinTextAt(c->width / 4 + 8, y + 4, "MATCH OVER", ut_col_white);
}

#ifdef UT99_CLONE_DEAD
U0 UTHUDInit_DEAD()
{
	ut_hud_font_ok = ut_font_ready;
	if (ut_ttf_ready)
		UTLog("UTHUD: ChallengeHUD text via TTF UISANS\n");
	else if (ut_ufont_ready)
		UTLog("UTHUD: ChallengeHUD text via UFont %s\n", ut_font_ui.name);
	else
		UTLog("UTHUD: ChallengeHUD text fallback\n");
}
#endif
