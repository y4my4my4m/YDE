// UTHUD.ZC - SoftDrv status HUD + scoreboard. Not UWindow.
//
// Index-color bars and digit strips. Matches UT layout: health left,
// armor, ammo, weapon name ticks, frag count.

#define UT_HUD_HEALTH_COL	250
#define UT_HUD_ARMOR_COL	200
#define UT_HUD_AMMO_COL		180
#define UT_HUD_FRAG_COL		40
#define UT_HUD_WEAP_COL		220

U0 UTHUDFillRect(CUTCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 col)
{
	I64 yy;
	I64 xx;
	I64 x2;
	I64 y2;

	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	yy = y;
	while (yy < y2)
	{
		xx = x;
		while (xx < x2)
		{
			c->pixels[yy * c->width + xx] = col;
			xx++;
		}
		yy++;
	}
}

//3x5 digit bitmasks — global (ZealC: no local brace init)
U8 ut_hud_digit_rows[50] = {
	7,5,5,5,7,
	2,2,2,2,2,
	7,1,7,4,7,
	7,1,7,1,7,
	5,5,7,1,1,
	7,4,7,1,7,
	7,4,7,5,7,
	7,1,1,1,1,
	7,5,7,5,7,
	7,5,7,1,7
};

U0 UTHUDDigit(CUTCanvas *c, I64 x, I64 y, I64 digit, I64 col)
{
	I64 r;
	I64 b;
	I64 bit;
	I64 xx;
	I64 base;

	if (digit < 0) digit = 0;
	if (digit > 9) digit = 9;
	base = digit * 5;
	r = 0;
	while (r < 5)
	{
		b = ut_hud_digit_rows[base + r];
		bit = 4;
		xx = 0;
		while (xx < 3)
		{
			if (b & bit)
				UTHUDFillRect(c, x + xx * 2, y + r * 2, 2, 2, col);
			bit = bit / 2;
			xx++;
		}
		r++;
	}
}

U0 UTHUDNumber(CUTCanvas *c, I64 x, I64 y, I64 value, I64 col)
{
	I64 d0;
	I64 d1;
	I64 d2;

	if (value < 0) value = 0;
	if (value > 999) value = 999;
	d2 = value / 100;
	d1 = (value / 10) % 10;
	d0 = value % 10;
	if (d2)
		UTHUDDigit(c, x, y, d2, col);
	if (d2 || d1)
		UTHUDDigit(c, x + 8, y, d1, col);
	UTHUDDigit(c, x + 16, y, d0, col);
}

U0 UTHUDDraw(CUTCanvas *c)
{
	I64 hp;
	I64 ar;
	I64 ammo;
	I64 fr;
	I64 deaths;
	I64 wi;
	I64 i;
	I64 x;

	if (!c || !ut_game_ready)
		return;

	hp = ToI64(ut_health);
	ar = ToI64(ut_armor);
	ammo = ut_weap_ammo[ut_weap_cur];
	fr = ut_frags;
	deaths = ut_deaths;

	//health block bottom-left
	UTHUDFillRect(c, 4, c->height - 28, 70, 10, 8);
	UTHUDFillRect(c, 4, c->height - 28, hp * 70 / 100, 10, UT_HUD_HEALTH_COL);
	UTHUDNumber(c, 4, c->height - 44, hp, UT_HUD_HEALTH_COL);

	//armor
	UTHUDFillRect(c, 80, c->height - 28, 50, 8, 8);
	if (ar > 0)
		UTHUDFillRect(c, 80, c->height - 28, ar * 50 / 100, 8, UT_HUD_ARMOR_COL);

	//ammo bottom-right
	UTHUDNumber(c, c->width - 40, c->height - 44, ammo, UT_HUD_AMMO_COL);
	UTHUDFillRect(c, c->width - 70, c->height - 28, 60, 8, 8);
	if (ut_weap_def[ut_weap_cur].ammo_max > 0)
		UTHUDFillRect(c, c->width - 70, c->height - 28,
			ammo * 60 / ut_weap_def[ut_weap_cur].ammo_max, 8, UT_HUD_AMMO_COL);

	//weapon strip
	x = c->width / 2 - UT_WEAP_N * 5;
	i = 0;
	while (i < UT_WEAP_N)
	{
		wi = 8;
		if (ut_weap_owned[i])
		{
			if (i == ut_weap_cur)
				UTHUDFillRect(c, x + i * 10, 4, 8, 8, UT_HUD_WEAP_COL);
			else
				UTHUDFillRect(c, x + i * 10, 6, 6, 4, 100);
		}
		i++;
	}

	//scoreboard top-left frags/deaths
	UTHUDNumber(c, 4, 4, fr, UT_HUD_FRAG_COL);
	UTHUDFillRect(c, 30, 8, 4, 4, 80);
	UTHUDNumber(c, 36, 4, deaths, 80);

	if (ut_ctf_active)
	{
		UTHUDNumber(c, c->width / 2 - 40, 4, ut_ctf_score[0], 40);
		UTHUDFillRect(c, c->width / 2 - 8, 8, 4, 4, 120);
		UTHUDNumber(c, c->width / 2 + 4, 4, ut_ctf_score[1], 200);
	}
	else if (ut_dom_active)
		UTHUDNumber(c, c->width / 2 - 16, 4, ut_ctf_score[0], 180);

	if (ut_map_cat_n > 0)
		UTHUDNumber(c, c->width - 40, 4, ut_map_cat_i + 1, 100);

	if (ut_zone_in_water)
		UTHUDFillRect(c, c->width / 2 - 10, c->height - 8, 20, 4, 200);

	//music crumb
	if (ut_music.playing)
		UTHUDFillRect(c, c->width - 6, 16, 4, 4, 50);
}

U0 UTHUDDrawScoreboard(CUTCanvas *c)
{//hold TAB — list frags. SoftDrv text via bars.
	I64 i;
	I64 y;

	if (!c)
		return;
	UTHUDFillRect(c, 40, 40, c->width - 80, c->height - 80, 16);
	UTHUDNumber(c, 60, 50, ut_frags, UT_HUD_FRAG_COL);
	if (ut_match_over)
		UTHUDFillRect(c, 60, 70, 80, 8, 250);
	y = 80;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		UTHUDNumber(c, 60, y, ut_bots[i].score, 180);
		UTHUDNumber(c, 100, y, ToI64(ut_bots[i].health), 100);
		y += 16;
		i++;
	}
}
