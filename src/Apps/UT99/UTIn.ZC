// UTIn.ZC - keyboard + mouse look. Unreal rotator units on the view angles.

#define UT_MOVE_SPEED		400.0		//unreal units / second
#define UT_MOVE_FAST		800.0
#define UT_LOOK_YAW_SCALE	64.0		//mouse pixels -> rotator units
#define UT_LOOK_PITCH_SCALE	64.0
#define UT_PITCH_MAX		(64 * 256)	//FAddAngleConfined upper (look up)
#define UT_PITCH_MIN		(-(64 * 256))

I64 ut_view_pitch	= 0;
I64 ut_view_yaw		= 0;
I64 ut_view_roll	= 0;
F64 ut_origin[3];
Bool ut_key_forward	= FALSE;
Bool ut_key_back	= FALSE;
Bool ut_key_left	= FALSE;
Bool ut_key_right	= FALSE;
Bool ut_key_up		= FALSE;
Bool ut_key_down	= FALSE;
Bool ut_key_fast	= FALSE;
Bool ut_use_map		= FALSE;
Bool ut_fire_held	= FALSE;
Bool ut_alt_fire	= FALSE;
Bool ut_want_jump	= FALSE;
Bool ut_want_suicide	= FALSE;
Bool ut_show_scores	= FALSE;
Bool ut_weap_next	= FALSE;
Bool ut_weap_prev	= FALSE;
I64  ut_want_map		= 0;	//1..4 = favorite DM slots
I64  ut_want_map_cycle	= 0;	//-1 / +1 catalog step
I64  ut_want_map_filter	= -2;	//-2 none, -1 all, 0 DM, 1 CTF, 2 DOM

U0 UTInInit()
{
	ut_view_pitch = 0;
	ut_view_yaw   = UTDegToRot(0.0);
	ut_view_roll  = 0;
	UTVecSet(ut_origin, 0.0, 0.0, 48.0);
	ut_key_forward = FALSE;
	ut_key_back    = FALSE;
	ut_key_left    = FALSE;
	ut_key_right   = FALSE;
	ut_key_up      = FALSE;
	ut_key_down    = FALSE;
	ut_key_fast    = FALSE;
	ut_fire_held   = FALSE;
	ut_alt_fire    = FALSE;
	ut_want_jump   = FALSE;
	ut_want_suicide = FALSE;
	ut_show_scores = FALSE;
	ut_weap_next = FALSE;
	ut_weap_prev = FALSE;
	ut_want_map = 0;
	ut_want_map_cycle = 0;
	ut_want_map_filter = -2;
}

U0 UTInMouseLook(I64 dx, I64 dy)
{//Unreal +yaw = turn right → yaw+=dx (Quake +yaw turns left, uses -=).
 //Unreal +pitch = look up → pitch-=dy (Quake +pitch looks down, uses +=).
	ut_view_yaw   = (ut_view_yaw + ToI64(ToF64(dx) * UT_LOOK_YAW_SCALE)) & 0xFFFF;
	ut_view_pitch = ut_view_pitch - ToI64(ToF64(dy) * UT_LOOK_PITCH_SCALE);
	if (ut_view_pitch > UT_PITCH_MAX)
		ut_view_pitch = UT_PITCH_MAX;
	if (ut_view_pitch < UT_PITCH_MIN)
		ut_view_pitch = UT_PITCH_MIN;
}

U0 UTInPollKeys()
{
	ut_key_forward = Bt(kbd.down_bitmap, Char2ScanCode('w')) ||
					 Bt(kbd.down_bitmap, SC_CURSOR_UP);
	ut_key_back    = Bt(kbd.down_bitmap, Char2ScanCode('s')) ||
					 Bt(kbd.down_bitmap, SC_CURSOR_DOWN);
	ut_key_left    = Bt(kbd.down_bitmap, Char2ScanCode('a')) ||
					 Bt(kbd.down_bitmap, SC_CURSOR_LEFT);
	ut_key_right   = Bt(kbd.down_bitmap, Char2ScanCode('d')) ||
					 Bt(kbd.down_bitmap, SC_CURSOR_RIGHT);
	ut_key_up      = Bt(kbd.down_bitmap, Char2ScanCode('e'));
	ut_key_down    = Bt(kbd.down_bitmap, Char2ScanCode('c')) ||
					 Bt(kbd.down_bitmap, Char2ScanCode('q'));
	ut_key_fast    = Bt(kbd.down_bitmap, SC_SHIFT);

	//space jump; LMB/Ctrl fire; RMB alt; [ ] weapons; Tab scores; K suicide
	ut_want_jump = Bt(kbd.down_bitmap, Char2ScanCode(' '));
	ut_fire_held = mouse_hard.bttns[0] ||
				   Bt(kbd.down_bitmap, SC_CTRL);
	ut_alt_fire = mouse_hard.bttns[1];
	ut_want_suicide = Bt(kbd.down_bitmap, Char2ScanCode('k'));
	ut_show_scores = Bt(kbd.down_bitmap, SC_TAB);
	ut_weap_next = Bt(kbd.down_bitmap, Char2ScanCode(']'));
	ut_weap_prev = Bt(kbd.down_bitmap, Char2ScanCode('['));
	ut_want_map = 0;
	ut_want_map_cycle = 0;
	ut_want_map_filter = -2;
	if (Bt(kbd.down_bitmap, Char2ScanCode('1')))
		ut_want_map = 1;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('2')))
		ut_want_map = 2;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('3')))
		ut_want_map = 3;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('4')))
		ut_want_map = 4;
	if (Bt(kbd.down_bitmap, Char2ScanCode('n')))
		ut_want_map_cycle = 1;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('b')))
		ut_want_map_cycle = -1;
	if (Bt(kbd.down_bitmap, Char2ScanCode('5')))
		ut_want_map_filter = -1;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('6')))
		ut_want_map_filter = 0;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('7')))
		ut_want_map_filter = 1;
	else if (Bt(kbd.down_bitmap, Char2ScanCode('8')))
		ut_want_map_filter = 2;
}

U0 UTInMove(F64 dt)
{//free-fly / slide. DM loop calls UTGameTick instead.
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	F64 wish[3];
	F64 dest[3];
	F64 speed;
	F64 flat_fwd[3];

	UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
	UTVecSet(wish, 0.0, 0.0, 0.0);

	flat_fwd[0] = fwd[0];
	flat_fwd[1] = fwd[1];
	flat_fwd[2] = 0.0;
	UTVecNormalize(flat_fwd);

	if (ut_key_forward)
		UTVecAdd(wish, flat_fwd, wish);
	if (ut_key_back)
		UTVecSub(wish, flat_fwd, wish);
	if (ut_key_right)
		UTVecAdd(wish, right, wish);
	if (ut_key_left)
		UTVecSub(wish, right, wish);
	if (ut_key_up)
		wish[2] += 1.0;
	if (ut_key_down)
		wish[2] -= 1.0;

	if (UTVecLength(wish) > UT_SMALL_NUMBER)
	{
		UTVecNormalize(wish);
		if (ut_key_fast)
			speed = UT_MOVE_FAST;
		else
			speed = UT_MOVE_SPEED;
		UTVecMA(ut_origin, speed * dt, wish, dest);
		UTVecCopy(dest, ut_origin);
	}
}
