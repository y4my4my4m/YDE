//after UTPalInit the palette is a grey ramp (slot i = (i,i,i)) with UI colours
//in 232+, so BestMatch(v,v,v,1) == v.
#include "UTFmt"
#include "UTPal"

U0 T24Check()
{
	U8 *rep;
	I64 noreg v;
	I64 noreg got;
	I64 noreg bad;

	UTPalInit;
	bad = 0;
	v = 0;
	while (v < 200)
	{
		got = UTPalBestMatch(v, v, v, 1);
		if (got != v && !(v == 0 && got == 1))
			bad++;
		v++;
	}
	rep = MStrPrint("T24 bad=%d/200  bm(0)=%d bm(50)=%d bm(128)=%d pal50=%d,%d,%d\n",
		bad, UTPalBestMatch(0,0,0,1), UTPalBestMatch(50,50,50,1),
		UTPalBestMatch(128,128,128,1),
		ut_pal_r[50], ut_pal_g[50], ut_pal_b[50]);
	"%s", rep;
	FileWrite("C:/Tmp/T24.TXT", rep, StrLen(rep));
}

T24Check;
