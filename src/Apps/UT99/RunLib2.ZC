// RunLib2.ZC
//
// Stage 2: UnrealScript VM, objects, gameplay, console, UI, tests.
// Requires RunLib.ZC to have been ExeFile'd first.
//
// ZealC is single-pass: a file may reference only earlier symbols,
// so this order is load-bearing.

Cd(__DIR__);;

"UT99 lib 2/2 (VM + game + UI):\n";

"  .. UTVM\n";
#include "UTVM"
"  .. UTObj\n";
#include "UTObj"
"  .. UTIn\n";
#include "UTIn"
"  .. UTMap\n";
#include "UTMap"
"  .. UTLod\n";
#include "UTLod"
"  .. UTWeap\n";
#include "UTWeap"
"  .. UTActor\n";
#include "UTActor"
"  .. UTCTF\n";
#include "UTCTF"
"  .. UTGame\n";
#include "UTGame"
"  .. UTRepl\n";
#include "UTRepl"
"  .. UTSave\n";
#include "UTSave"
"  .. UTDemo\n";
#include "UTDemo"
"  .. UTCon\n";
#include "UTCon"
"  .. UTMenu\n";
#include "UTMenu"
"  .. UTUWin\n";
#include "UTUWin"
"  .. UTClient\n";
#include "UTClient"
"  .. UTHUD\n";
#include "UTHUD"
"  .. UTTest\n";
#include "UTTest"

//UTTest is not run here: UT99 clears the screen on startup.
"\nLibrary built. Type $$LTBLUE$$UTTest;$$FG$$ to run the data-layer check.\n";
