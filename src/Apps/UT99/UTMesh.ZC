// FMeshVert / FMeshTri layout + demo mesh draw.
// Upstream: Engine/Inc/UnMesh.h. UMesh Serialize lives in the closed Engine;
// this module packs and unpacks the documented wire structs.

#define UT_MESH_MAX_VERTS	256
#define UT_MESH_MAX_TRIS	512

class CUTMeshTri
{
	U16	i_vert[3];
	U8	u[3];
	U8	v[3];
	U32	poly_flags;
	I64	texture_index;
};

class CUTMesh
{
	F64			verts[UT_MESH_MAX_VERTS][3];
	I64			num_verts;
	CUTMeshTri	tris[UT_MESH_MAX_TRIS];
	I64			num_tris;
	F64			origin[3];
	F64			scale;
};

CUTMesh ut_demo_mesh;
Bool    ut_demo_mesh_ready = FALSE;

U0 UTMeshInit(CUTMesh *m)
{
	m->num_verts = 0;
	m->num_tris  = 0;
	m->scale     = 1.0;
	UTVecSet(m->origin, 0.0, 0.0, 0.0);
}

U0 UTMeshAddVert(CUTMesh *m, F64 x, F64 y, F64 z)
{
	if (m->num_verts >= UT_MESH_MAX_VERTS)
		return;
	UTVecSet(m->verts[m->num_verts], x, y, z);
	m->num_verts++;
}

U0 UTMeshAddTri(CUTMesh *m, I64 a, I64 b, I64 c, I64 color_as_tex)
{
	CUTMeshTri *t;

	if (m->num_tris >= UT_MESH_MAX_TRIS)
		return;
	t = &m->tris[m->num_tris];
	t->i_vert[0] = a;
	t->i_vert[1] = b;
	t->i_vert[2] = c;
	t->u[0] = 0; t->u[1] = 255; t->u[2] = 0;
	t->v[0] = 0; t->v[1] = 0;   t->v[2] = 255;
	t->poly_flags    = 0;
	t->texture_index = color_as_tex;
	m->num_tris++;
}

U0 UTMeshBuildCube(CUTMesh *m, F64 half)
{//axis-aligned cube centred on origin, size 2*half
	UTMeshInit(m);
	UTMeshAddVert(m, -half, -half, -half);
	UTMeshAddVert(m,  half, -half, -half);
	UTMeshAddVert(m,  half,  half, -half);
	UTMeshAddVert(m, -half,  half, -half);
	UTMeshAddVert(m, -half, -half,  half);
	UTMeshAddVert(m,  half, -half,  half);
	UTMeshAddVert(m,  half,  half,  half);
	UTMeshAddVert(m, -half,  half,  half);

	UTMeshAddTri(m, 0, 1, 2, 180);
	UTMeshAddTri(m, 0, 2, 3, 180);
	UTMeshAddTri(m, 4, 6, 5, 200);
	UTMeshAddTri(m, 4, 7, 6, 200);
	UTMeshAddTri(m, 0, 5, 1, 160);
	UTMeshAddTri(m, 0, 4, 5, 160);
	UTMeshAddTri(m, 3, 2, 6, 220);
	UTMeshAddTri(m, 3, 6, 7, 220);
	UTMeshAddTri(m, 0, 3, 7, 140);
	UTMeshAddTri(m, 0, 7, 4, 140);
	UTMeshAddTri(m, 1, 5, 6, 240);
	UTMeshAddTri(m, 1, 6, 2, 240);
}

U0 UTMeshBuildPlayer(CUTMesh *m, F64 scale)
{//procedural capsule mesh when LodMesh absent
	F64 s;

	s = scale;
	UTMeshInit(m);
	UTMeshAddVert(m, -12 * s, -12 * s, 0);
	UTMeshAddVert(m,  12 * s, -12 * s, 0);
	UTMeshAddVert(m,  12 * s,  12 * s, 0);
	UTMeshAddVert(m, -12 * s,  12 * s, 0);
	UTMeshAddVert(m, -12 * s, -12 * s, 48 * s);
	UTMeshAddVert(m,  12 * s, -12 * s, 48 * s);
	UTMeshAddVert(m,  12 * s,  12 * s, 48 * s);
	UTMeshAddVert(m, -12 * s,  12 * s, 48 * s);
	UTMeshAddTri(m, 0, 1, 2, 60);
	UTMeshAddTri(m, 0, 2, 3, 60);
	UTMeshAddTri(m, 4, 6, 5, 80);
	UTMeshAddTri(m, 4, 7, 6, 80);
	UTMeshAddTri(m, 0, 4, 5, 70);
	UTMeshAddTri(m, 0, 5, 1, 70);
	UTMeshAddTri(m, 1, 5, 6, 90);
	UTMeshAddTri(m, 1, 6, 2, 90);
	UTMeshAddTri(m, 2, 6, 7, 70);
	UTMeshAddTri(m, 2, 7, 3, 70);
	UTMeshAddTri(m, 3, 7, 4, 90);
	UTMeshAddTri(m, 3, 4, 0, 90);
	UTMeshAddVert(m, -8 * s, -8 * s, 48 * s);
	UTMeshAddVert(m,  8 * s, -8 * s, 48 * s);
	UTMeshAddVert(m,  8 * s,  8 * s, 48 * s);
	UTMeshAddVert(m, -8 * s,  8 * s, 48 * s);
	UTMeshAddVert(m, -8 * s, -8 * s, 64 * s);
	UTMeshAddVert(m,  8 * s, -8 * s, 64 * s);
	UTMeshAddVert(m,  8 * s,  8 * s, 64 * s);
	UTMeshAddVert(m, -8 * s,  8 * s, 64 * s);
	UTMeshAddTri(m, 8, 9, 10, 200);
	UTMeshAddTri(m, 8, 10, 11, 200);
	UTMeshAddTri(m, 12, 14, 13, 220);
	UTMeshAddTri(m, 12, 15, 14, 220);
	m->scale = 1.0;
}

CUTMesh ut_player_mesh;
Bool    ut_player_mesh_ready = FALSE;

U0 UTMeshDemoInit()
{
	UTMeshBuildCube(&ut_demo_mesh, 64.0);
	UTVecSet(ut_demo_mesh.origin, 256.0, 0.0, 48.0);
	ut_demo_mesh_ready = TRUE;
	UTMeshBuildPlayer(&ut_player_mesh, 1.0);
	ut_player_mesh_ready = TRUE;
}

U0 UTMeshDraw(CUTCanvas *c, CUTMesh *m)
{
	I64 i;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	CUTMeshTri *t;
	I64 color;
	F64 us;

	if (!c || !m)
		return;
	us = 64.0;
	i = 0;
	while (i < m->num_tris)
	{
		t = &m->tris[i];
		UTVecScale(m->verts[t->i_vert[0]], m->scale, a);
		UTVecScale(m->verts[t->i_vert[1]], m->scale, b);
		UTVecScale(m->verts[t->i_vert[2]], m->scale, cc);
		UTVecAdd(a, m->origin, a);
		UTVecAdd(b, m->origin, b);
		UTVecAdd(cc, m->origin, cc);
		if (ut_tex_ready)
		{
			UTDrawTriTex3(c, a, b, cc,
				0.0, 0.0,
				us, 0.0,
				0.0, us,
				&ut_tex_checker, NULL);
		}
		else
		{
			color = t->texture_index & 255;
			if (color < 32)
				color = 180;
			UTDrawTri3(c, a, b, cc, color);
		}
		i++;
	}
}

I64 UTMeshTriSerialSize()
{//FMeshTri on disk: 3*U16 + 3*(U8+U8) + U32 + I32 = 6+6+4+4 = 20
	return 20;
}

U0 UTMeshTriWrite(U8 *dst, CUTMeshTri *t)
{
	dst[0] = t->i_vert[0] & 0xFF;
	dst[1] = (t->i_vert[0] >> 8) & 0xFF;
	dst[2] = t->i_vert[1] & 0xFF;
	dst[3] = (t->i_vert[1] >> 8) & 0xFF;
	dst[4] = t->i_vert[2] & 0xFF;
	dst[5] = (t->i_vert[2] >> 8) & 0xFF;
	dst[6] = t->u[0];
	dst[7] = t->v[0];
	dst[8] = t->u[1];
	dst[9] = t->v[1];
	dst[10] = t->u[2];
	dst[11] = t->v[2];
	dst[12] = t->poly_flags & 0xFF;
	dst[13] = (t->poly_flags >> 8) & 0xFF;
	dst[14] = (t->poly_flags >> 16) & 0xFF;
	dst[15] = (t->poly_flags >> 24) & 0xFF;
	dst[16] = t->texture_index & 0xFF;
	dst[17] = (t->texture_index >> 8) & 0xFF;
	dst[18] = (t->texture_index >> 16) & 0xFF;
	dst[19] = (t->texture_index >> 24) & 0xFF;
}

Bool UTMeshTriRead(U8 *src, CUTMeshTri *t)
{
	t->i_vert[0] = UTRdU16(src);
	t->i_vert[1] = UTRdU16(src + 2);
	t->i_vert[2] = UTRdU16(src + 4);
	t->u[0] = src[6];
	t->v[0] = src[7];
	t->u[1] = src[8];
	t->v[1] = src[9];
	t->u[2] = src[10];
	t->v[2] = src[11];
	t->poly_flags    = UTRdU32(src + 12);
	t->texture_index  = UTRdI32(src + 16);
	return TRUE;
}
