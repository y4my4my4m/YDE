//Canvas DrawTile path used by Paint / native(466)
U0 UTUWinDrawStretched(CUTTex *tex, I64 x, I64 y, I64 w, I64 h)
{
	if (!tex || !tex->mips[0].pixels)
		return;
	UTWinDrawTileStretched(tex, x, y, w, h);
}

U0 UTUWinDrawClipped(CUTTex *tex, I64 x, I64 y)
{
	if (!tex || !tex->mips[0].pixels)
		return;
	UTWinDrawTile(tex, x, y, tex->u_size, tex->v_size,
		0, 0, tex->u_size, tex->v_size);
}

Bool UTUWinLoadTex(U8 *name, CUTTex *t)
{
	UTTexInit(t);
	return UTTexLoadNamed(ut_uwin_pkg_umenu, name, t);
}

Bool UTUWinIsClassExport(CUTPackage *pkg, I64 exp_i)
{
	U8 *cn;

	if (!pkg || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	cn = UTPkgClassName(pkg, pkg->exports[exp_i].class_index);
	if (!cn)
		return FALSE;
	return !StrCompare(cn, "Class");
}

U0 UTUWinAddClass(U8 *pkg_tag, U8 *name)
{
	CUTUWinClass *c;
	I64 i;

	if (!name || !*name || !StrCompare(name, "None"))
		return;
	if (ut_uwin_cls_n >= UT_UWIN_CLS_MAX)
		return;
	i = 0;
	while (i < ut_uwin_cls_n)
	{
		if (!StrCompare(ut_uwin_cls[i].name, name) &&
			!StrCompare(ut_uwin_cls[i].pkg, pkg_tag))
			return;
		i++;
	}
	c = &ut_uwin_cls[ut_uwin_cls_n];
	MemSet(c, 0, sizeof(CUTUWinClass));
	StrPrint(c->name, "%s", name);
	StrPrint(c->pkg, "%s", pkg_tag);
	ut_uwin_cls_n++;
}

I64 UTUWinLoadPkgClasses(U8 *path, U8 *pkg_tag)
{
	CUTPackage *pkg;
	I64 i;
	I64 n;
	U8 *nm;

	pkg = UTPkgLoad(path);
	if (!pkg)
		return 0;
	n = 0;
	i = 0;
	while (i < pkg->export_count)
	{
		if (UTUWinIsClassExport(pkg, i))
		{
			nm = UTPkgNameStr(pkg, pkg->exports[i].name_index);
			UTUWinAddClass(pkg_tag, nm);
			n++;
		}
		i++;
	}
	UTPkgFree(pkg);
	return n;
}

I64 UTUWinFindClass(U8 *name)
{
	I64 i;

	i = 0;
	while (i < ut_uwin_cls_n)
	{
		if (!StrCompare(ut_uwin_cls[i].name, name))
			return i;
		i++;
	}
	return -1;
}

I64 UTUWinTryExec(U8 *pkg_path, U8 *fn_name, I64 max_steps)
{
	I64 slot;
	I64 steps;

	slot = UTVMLoadNamed(pkg_path, fn_name);
	if (slot < 0)
		return 0;
	steps = UTVMCall(fn_name, max_steps);
	ut_uwin_steps += steps;
	return steps;
}

U0 UTUWinProbeExec()
{
	I64 s;

	ut_uwin_exec_mask = 0;
	ut_uwin_steps = 0;
	s = UTUWinTryExec(ut_uwin_pkg_uwindow, "CreateRootWindow", 512);
	if (s > 0)
		ut_uwin_exec_mask |= UT_UWIN_EXEC_CREATE;
	s = UTUWinTryExec(ut_uwin_pkg_uwindow, "RenderUWindow", 512);
	if (s > 0)
		ut_uwin_exec_mask |= UT_UWIN_EXEC_RENDER;
	s = UTUWinTryExec(ut_uwin_pkg_uwindow, "LaunchUWindow", 512);
	if (s > 0)
		ut_uwin_exec_mask |= UT_UWIN_EXEC_LAUNCH;
	s = UTUWinTryExec(ut_uwin_pkg_uwindow, "Paint", 256);
	if (s > 0)
		ut_uwin_exec_mask |= UT_UWIN_EXEC_PAINT;
	s = UTUWinTryExec(ut_uwin_pkg_utmenu, "PostRender", 256);
	if (s > 0)
		ut_uwin_exec_mask |= UT_UWIN_EXEC_POST;
	UTUWinTryExec(ut_uwin_pkg_utmenu, "CreateRootWindow", 256);
	//Input + DrawMouse bytecode warm — full Exec needs object graph
	UTUWinTryExec(ut_uwin_pkg_uwindow, "MouseMove", 128);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "KeyEvent", 128);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "DrawMouse", 128);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "SetCursor", 64);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "Tick", 128);
	UTLog("UTUWin: exec_mask=%02X steps=%d\n",
		ut_uwin_exec_mask, ut_uwin_steps);
}

U0 UTUWinFreeArt()
{//Globals not zeroed. Free only after first MemSet (ut_uwin_zeroed).
	I64 i;

	if (!ut_uwin_zeroed)
		return;
	if (ut_uwin_black_ok)
		UTTexFreeMips(&ut_uwin_menu_black);
	ut_uwin_black_ok = FALSE;
	i = 0;
	while (i < UT_UWIN_BG_N)
	{
		if (ut_uwin_bg_ok[i])
			UTTexFreeMips(&ut_uwin_bg[i]);
		ut_uwin_bg_ok[i] = FALSE;
		i++;
	}
	if (ut_uwin_bar_art_ok)
	{
		UTTexFreeMips(&ut_uwin_bar_l);
		UTTexFreeMips(&ut_uwin_bar_tile);
		UTTexFreeMips(&ut_uwin_bar_win);
		UTTexFreeMips(&ut_uwin_bar_in_l);
		UTTexFreeMips(&ut_uwin_bar_in_m);
		UTTexFreeMips(&ut_uwin_bar_in_r);
		UTTexFreeMips(&ut_uwin_bar_out_l);
		UTTexFreeMips(&ut_uwin_bar_out_m);
		UTTexFreeMips(&ut_uwin_bar_out_r);
	}
	ut_uwin_bar_art_ok = FALSE;
	if (ut_uwin_pull_art_ok)
	{
		UTTexFreeMips(&ut_uwin_pull_tl);
		UTTexFreeMips(&ut_uwin_pull_t);
		UTTexFreeMips(&ut_uwin_pull_tr);
		UTTexFreeMips(&ut_uwin_pull_l);
		UTTexFreeMips(&ut_uwin_pull_r);
		UTTexFreeMips(&ut_uwin_pull_bl);
		UTTexFreeMips(&ut_uwin_pull_b);
		UTTexFreeMips(&ut_uwin_pull_br);
		UTTexFreeMips(&ut_uwin_pull_area);
	}
	ut_uwin_pull_art_ok = FALSE;
	if (ut_uwin_pull_hl_ok)
	{
		UTTexFreeMips(&ut_uwin_pull_hl);
		UTTexFreeMips(&ut_uwin_pull_hm);
		UTTexFreeMips(&ut_uwin_pull_hr);
		UTTexFreeMips(&ut_uwin_pull_line);
	}
	ut_uwin_pull_hl_ok = FALSE;
	if (ut_uwin_cursor_ok)
		UTTexFreeMips(&ut_uwin_cursor);
	ut_uwin_cursor_ok = FALSE;
}

U0 UTUWinZeroArt()
{//MemSet all SoftDrv art CUTTex + ok flags. BSS not zeroed.
	I64 i;

	MemSet(&ut_uwin_menu_black, 0, sizeof(CUTTex));
	i = 0;
	while (i < UT_UWIN_BG_N)
	{
		MemSet(&ut_uwin_bg[i], 0, sizeof(CUTTex));
		ut_uwin_bg_ok[i] = FALSE;
		i++;
	}
	MemSet(&ut_uwin_bar_l, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_tile, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_win, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_in_l, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_in_m, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_in_r, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_out_l, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_out_m, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_bar_out_r, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_tl, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_t, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_tr, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_l, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_r, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_bl, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_b, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_br, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_area, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_hl, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_hm, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_hr, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_pull_line, 0, sizeof(CUTTex));
	MemSet(&ut_uwin_cursor, 0, sizeof(CUTTex));
	ut_uwin_black_ok = FALSE;
	ut_uwin_bar_art_ok = FALSE;
	ut_uwin_pull_art_ok = FALSE;
	ut_uwin_pull_hl_ok = FALSE;
	ut_uwin_cursor_ok = FALSE;
	ut_uwin_zeroed = TRUE;
}

U0 UTUWinLoadArt()
{//Texture exports from UMenu.u (#exec in UMenuRootWindow / Blue LAF)
	I64 i;
	I64 n;

	if (ut_uwin_zeroed)
		UTUWinFreeArt;
	else
		UTUWinZeroArt;
	UTPalLoadFromUtx(ut_uwin_pkg_umenu);

	ut_uwin_black_ok = UTUWinLoadTex("MenuBlack", &ut_uwin_menu_black);
	n = 0;
	i = 0;
	while (i < UT_UWIN_BG_N)
	{
		ut_uwin_bg_ok[i] = UTUWinLoadTex(ut_uwin_bg_names[i],
			&ut_uwin_bg[i]);
		if (ut_uwin_bg_ok[i])
			n++;
		i++;
	}

	ut_uwin_bar_art_ok = TRUE;
	if (!UTUWinLoadTex("BlueBarL", &ut_uwin_bar_l))
		ut_uwin_bar_art_ok = FALSE;
	if (!UTUWinLoadTex("BlueBarTile", &ut_uwin_bar_tile))
		ut_uwin_bar_art_ok = FALSE;
	if (!UTUWinLoadTex("BlueBarWin", &ut_uwin_bar_win))
		ut_uwin_bar_art_ok = FALSE;
	UTUWinLoadTex("BlueBarInL", &ut_uwin_bar_in_l);
	UTUWinLoadTex("BlueBarInM", &ut_uwin_bar_in_m);
	UTUWinLoadTex("BlueBarInR", &ut_uwin_bar_in_r);
	UTUWinLoadTex("BlueBarOutL", &ut_uwin_bar_out_l);
	UTUWinLoadTex("BlueBarOutM", &ut_uwin_bar_out_m);
	UTUWinLoadTex("BlueBarOutR", &ut_uwin_bar_out_r);

	ut_uwin_pull_art_ok = TRUE;
	if (!UTUWinLoadTex("BlueMenuTL", &ut_uwin_pull_tl))
		ut_uwin_pull_art_ok = FALSE;
	UTUWinLoadTex("BlueMenuT", &ut_uwin_pull_t);
	UTUWinLoadTex("BlueMenuTR", &ut_uwin_pull_tr);
	UTUWinLoadTex("BlueMenuL", &ut_uwin_pull_l);
	UTUWinLoadTex("BlueMenuR", &ut_uwin_pull_r);
	UTUWinLoadTex("BlueMenuBL", &ut_uwin_pull_bl);
	UTUWinLoadTex("BlueMenuB", &ut_uwin_pull_b);
	UTUWinLoadTex("BlueMenuBR", &ut_uwin_pull_br);
	UTUWinLoadTex("BlueMenuArea", &ut_uwin_pull_area);

	ut_uwin_pull_hl_ok = TRUE;
	if (!UTUWinLoadTex("BlueMenuHL", &ut_uwin_pull_hl))
		ut_uwin_pull_hl_ok = FALSE;
	if (!UTUWinLoadTex("BlueMenuHM", &ut_uwin_pull_hm))
		ut_uwin_pull_hl_ok = FALSE;
	if (!UTUWinLoadTex("BlueMenuHR", &ut_uwin_pull_hr))
		ut_uwin_pull_hl_ok = FALSE;
	UTUWinLoadTex("BlueMenuLine", &ut_uwin_pull_line);

	//UWindow.u Texture'MouseCursor' FLAGS=2 masked BMP. Exact name only.
	ut_uwin_cursor_ok = UTTexLoadNamed(ut_uwin_pkg_uwindow,
		"MouseCursor", &ut_uwin_cursor);
	if (ut_uwin_cursor_ok)
	{
		if (ut_uwin_cursor.u_size < 4 || ut_uwin_cursor.v_size < 4 ||
			ut_uwin_cursor.u_size > 64 || ut_uwin_cursor.v_size > 64 ||
			!ut_uwin_cursor.mips[0].pixels)
		{
			UTLog("UTUWin: MouseCursor bad size %dx%d — poly arrow\n",
				ut_uwin_cursor.u_size, ut_uwin_cursor.v_size);
			UTTexFreeMips(&ut_uwin_cursor);
			ut_uwin_cursor_ok = FALSE;
		}
		else
			UTLog("UTUWin: MouseCursor %dx%d mips=%d ok\n",
				ut_uwin_cursor.u_size, ut_uwin_cursor.v_size,
				ut_uwin_cursor.num_mips);
	}
	else
		UTLog("UTUWin: MouseCursor miss — poly arrow\n");

	UTLog("UTUWin: art black=%d bg=%d/12 bar=%d pull=%d hl=%d cursor=%d\n",
		ToI64(ut_uwin_black_ok), n,
		ToI64(ut_uwin_bar_art_ok), ToI64(ut_uwin_pull_art_ok),
		ToI64(ut_uwin_pull_hl_ok), ToI64(ut_uwin_cursor_ok));
}

I64 UTUWinAddNode(U8 *cls, I64 kind, I64 x, I64 y, I64 w, I64 h,
	I64 parent)
{//CreateWindow + ShowChildWindow — new child becomes LastChild (topmost).
	CUTUWinNode *n;
	CUTUWinNode *p;
	I64 idx;

	if (ut_uwin_node_n >= UT_UWIN_NODE_MAX)
		return -1;
	n = &ut_uwin_node[ut_uwin_node_n];
	MemSet(n, 0, sizeof(CUTUWinNode));
	StrPrint(n->class_name, "%s", cls);
	n->kind = kind;
	n->x = x;
	n->y = y;
	n->w = w;
	n->h = h;
	n->parent = parent;
	n->first_child = -1;
	n->next_sib = -1;
	n->last_child = -1;
	n->clip_region.x = 0;
	n->clip_region.y = 0;
	n->clip_region.w = w;
	n->clip_region.h = h;
	n->no_clip = FALSE;
	n->visible = TRUE;
	idx = ut_uwin_node_n;
	ut_uwin_node_n++;
	if (parent >= 0 && parent < idx)
	{
		p = &ut_uwin_node[parent];
		if (p->first_child < 0)
		{
			p->first_child = idx;
			p->last_child = idx;
		}
		else
		{
			//Append after LastChild — PaintClients walks First→Next (bottom→top)
			ut_uwin_node[p->last_child].next_sib = idx;
			p->last_child = idx;
		}
	}
	return idx;
}

U0 UTUWinLayoutBar(I64 bar_w)
{//UMenuMenuBar items from UMenu.int + spacing like UWindowMenuBar
	I64 i;
	I64 x;
	I64 tw;
	I64 spacing;

	ut_uwin_bar_n = UT_UWIN_BAR_N;
	spacing = 12;
	x = 8;
	i = 0;
	while (i < ut_uwin_bar_n)
	{
		StrPrint(ut_uwin_bar[i].caption, "%s", ut_uwin_bar_caps[i]);
		tw = UTWinTextW(ut_uwin_bar[i].caption, ut_ttf_px);
		if (tw < 8)
			tw = StrLen(ut_uwin_bar[i].caption) * 6;
		ut_uwin_bar[i].x = x;
		ut_uwin_bar[i].w = tw + spacing;
		x += ut_uwin_bar[i].w;
		i++;
	}
	no_warn bar_w;
}

I64 UTUWinCountCaps(U8 **caps)
{
	I64 n;

	n = 0;
	while (n < UT_UWIN_PULL_MAX && caps[n] && caps[n][0])
		n++;
	return n;
}

U0 UTUWinLoadPullCaps(U8 **caps)
{
	I64 i;
	I64 n;
	I64 tw;
	I64 maxw;

	n = UTUWinCountCaps(caps);
	ut_uwin_pull_n = n;
	maxw = 160;
	i = 0;
	while (i < n)
	{
		StrPrint(ut_uwin_pull_caps[i], "%s", caps[i]);
		if (caps[i][0] != '-')
		{
			tw = UTWinTextW(ut_uwin_pull_caps[i], ut_ttf_px);
			if (tw < 8)
				tw = StrLen(ut_uwin_pull_caps[i]) * 6;
			if (tw + 24 > maxw)
				maxw = tw + 24;
		}
		i++;
	}
	while (i < UT_UWIN_PULL_MAX)
	{
		ut_uwin_pull_caps[i][0] = 0;
		i++;
	}
	if (ut_uwin_pulldown >= 0 && ut_uwin_pulldown < ut_uwin_node_n)
	{
		ut_uwin_node[ut_uwin_pulldown].w = maxw;
		ut_uwin_node[ut_uwin_pulldown].h = n * 16 + 8;
	}
}

U0 UTUWinCloseClient()
{
	if (ut_uwin_client >= 0 && ut_uwin_client < ut_uwin_node_n)
		ut_uwin_node[ut_uwin_client].visible = FALSE;
}

U0 UTUWinShowPreferences()
{//UMenuOptionsMenu.ShowPreferences → UMenuOptionsWindow host stand-in
	CUTUWinNode *n;
	I64 cw;
	I64 ch;
	I64 ww;
	I64 wh;

	cw = 640;
	ch = 480;
	if (ut_canvas)
	{
		cw = ut_canvas->width;
		ch = ut_canvas->height;
	}
	ww = 420;
	wh = 280;
	if (ww > cw - 40)
		ww = cw - 40;
	if (wh > ch - 40)
		wh = ch - 40;
	if (ut_uwin_client < 0)
	{
		ut_uwin_client = UTUWinAddNode("UMenuOptionsWindow",
			UT_UWIN_KIND_CLIENT,
			(cw - ww) / 2, (ch - wh) / 2, ww, wh, ut_uwin_root);
	}
	if (ut_uwin_client < 0)
		return;
	n = &ut_uwin_node[ut_uwin_client];
	n->x = (cw - ww) / 2;
	n->y = (ch - wh) / 2;
	n->w = ww;
	n->h = wh;
	n->visible = TRUE;
	ut_uwin_opt_tab = 0;
	UTUWinTryExec(ut_uwin_pkg_umenu, "ShowPreferences", 64);
	UTLog("UTUWin: Preferences window open\n");
}

U0 UTUWinOpenBar(I64 bar_i)
{//UWindowMenuBarItem.Select → CreateMenu + Show
	U8 **caps;
	I64 def_sel;

	if (bar_i < 0 || bar_i >= ut_uwin_bar_n)
		return;
	ut_uwin_selected = bar_i;
	ut_uwin_pull_bar = bar_i;
	caps = ut_uwin_game_caps;
	def_sel = 1;
	if (bar_i == UT_UWIN_BAR_MP)
	{
		caps = ut_uwin_mp_caps;
		def_sel = 0;
	}
	else if (bar_i == UT_UWIN_BAR_OPT)
	{
		caps = ut_uwin_opt_caps;
		def_sel = 0;
	}
	else if (bar_i == UT_UWIN_BAR_TOOLS)
	{
		caps = ut_uwin_tools_caps;
		def_sel = 0;
	}
	UTUWinLoadPullCaps(caps);
	if (ut_uwin_pulldown >= 0)
	{
		ut_uwin_node[ut_uwin_pulldown].x = ut_uwin_bar[bar_i].x;
		ut_uwin_node[ut_uwin_pulldown].y = 16;
		ut_uwin_node[ut_uwin_pulldown].visible = TRUE;
		ut_uwin_pull_sel = def_sel;
		if (ut_uwin_pull_sel >= ut_uwin_pull_n)
			ut_uwin_pull_sel = 0;
		while (ut_uwin_pull_sel < ut_uwin_pull_n &&
			ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
			ut_uwin_pull_sel++;
	}
}

U0 UTUWinCreateRootWindow(I64 cw, I64 ch)
{//Host CreateRootWindow — UMenuRootWindow + UMenuMenuBar children
	ut_uwin_node_n = 0;
	ut_uwin_root = -1;
	ut_uwin_menubar = -1;
	ut_uwin_pulldown = -1;
	ut_uwin_client = -1;
	ut_uwin_over = -1;
	ut_uwin_selected = -1;
	ut_uwin_pull_sel = 0;
	ut_uwin_pull_n = 0;
	ut_uwin_pull_bar = 0;
	ut_uwin_opt_tab = 0;

	if (cw < 64)
		cw = 320;
	if (ch < 64)
		ch = 240;

	ut_uwin_root = UTUWinAddNode("UMenuRootWindow", UT_UWIN_KIND_ROOT,
		0, 0, cw, ch, -1);
	ut_uwin_menubar = UTUWinAddNode("UMenuMenuBar", UT_UWIN_KIND_MENUBAR,
		0, 0, cw, 16, ut_uwin_root);
	UTUWinAddNode("UMenuStatusBar", UT_UWIN_KIND_STATUS,
		0, ch - 16, cw, 16, ut_uwin_root);
	ut_uwin_node[ut_uwin_node_n - 1].visible = FALSE;

	ut_uwin_pulldown = UTUWinAddNode("UTGameMenu", UT_UWIN_KIND_PULLDOWN,
		8, 16, 200, 7 * 16 + 8, ut_uwin_menubar);
	ut_uwin_node[ut_uwin_pulldown].visible = FALSE;

	UTUWinLayoutBar(cw);
	UTUWinLoadPullCaps(ut_uwin_game_caps);
	UTLog("UTUWin: CreateRootWindow nodes=%d root=%s laf=%s\n",
		ut_uwin_node_n, ut_uwin_root_cls, ut_uwin_laf_cls);
}

U0 UTUWinMsReset()
{//MouseRaw freezes mouse.pos — soft cursor must re-seed from canvas centre.
	ut_uwin_ms_ok = FALSE;
}

U0 UTUWinMsMove(I64 dx, I64 dy)
{//HLMenuMsMove: integrate raw deltas into SoftDrv canvas space.
	I64 bw;
	I64 bh;

	if (!ut_canvas || ut_canvas->width < 1 || ut_canvas->height < 1)
		return;
	bw = ut_blit_w;
	bh = ut_blit_h;
	if (bw < 1) bw = 1;
	if (bh < 1) bh = 1;
	if (!ut_uwin_ms_ok)
	{
		ut_uwin_mouse_x = ut_canvas->width / 2;
		ut_uwin_mouse_y = ut_canvas->height / 2;
		ut_uwin_ms_ok = TRUE;
	}
	ut_uwin_mouse_x += dx * ut_canvas->width / bw;
	ut_uwin_mouse_y += dy * ut_canvas->height / bh;
	if (ut_uwin_mouse_x < 0)
		ut_uwin_mouse_x = 0;
	if (ut_uwin_mouse_y < 0)
		ut_uwin_mouse_y = 0;
	if (ut_uwin_mouse_x >= ut_canvas->width)
		ut_uwin_mouse_x = ut_canvas->width - 1;
	if (ut_uwin_mouse_y >= ut_canvas->height)
		ut_uwin_mouse_y = ut_canvas->height - 1;
}

U0 UTUWinActivate()
{//Requires SoftDrv canvas when sizing to fb. Call after UTDrawNew.
	I64 cw;
	I64 ch;

	cw = 320;
	ch = 240;
	if (ut_canvas != NULL)
	{
		cw = ut_canvas->width;
		ch = ut_canvas->height;
	}
	if (ut_uwin_root < 0)
		UTUWinCreateRootWindow(cw, ch);
	else if (ut_uwin_root < ut_uwin_node_n)
	{
		ut_uwin_node[ut_uwin_root].w = cw;
		ut_uwin_node[ut_uwin_root].h = ch;
		if (ut_uwin_menubar >= 0 && ut_uwin_menubar < ut_uwin_node_n)
			ut_uwin_node[ut_uwin_menubar].w = cw;
		UTUWinLayoutBar(cw);
	}
	else
	{
		UTLog("UTUWinActivate: bad root=%d nodes=%d — rebuild\n",
			ut_uwin_root, ut_uwin_node_n);
		UTUWinCreateRootWindow(cw, ch);
	}
	//Menu art indices need UMenu/MenuGr palette. ArenaTex left active after
	//Start Match → P8→ARGB noise (false dither). One SoftDrv path only.
	if (FileFind(ut_uwin_pkg_umenu))
		UTPalLoadFromUtx(ut_uwin_pkg_umenu);
	else if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/MenuGr.utx");
	ut_uwin_active = TRUE;
	ut_menu_open = TRUE;
	ut_menu_boot = TRUE;
	ut_client_cursor_on = TRUE;
	UTUWinMsReset;
}

U0 UTUWinDeactivate()
{
	ut_uwin_active = FALSE;
	if (ut_uwin_pulldown >= 0)
		ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
	ut_uwin_selected = -1;
	UTUWinCloseClient;
	if (!ut_menu_fake_laf)
	{
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
	ut_client_cursor_on = FALSE;
	if (FileFind("::/Apps/UT99/Textures/ArenaTex.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/ArenaTex.utx");
	else if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/MenuGr.utx");
}

U0 UTUWinInit()
{
	I64 n;

	ut_uwin_cls_n = 0;
	ut_uwin_pkg_ok = 0;
	ut_uwin_exec_mask = 0;
	ut_uwin_steps = 0;
	ut_uwin_node_n = 0;
	ut_uwin_root = -1;
	ut_uwin_latched = FALSE;
	ut_uwin_nav_latched = FALSE;
	ut_uwin_mb_latched = FALSE;
	ut_uwin_ready = FALSE;

	n = UTUWinLoadPkgClasses(ut_uwin_pkg_uwindow, "UWindow");
	if (n > 0)
		ut_uwin_pkg_ok |= 1;
	n = UTUWinLoadPkgClasses(ut_uwin_pkg_umenu, "UMenu");
	if (n > 0)
		ut_uwin_pkg_ok |= 2;
	n = UTUWinLoadPkgClasses(ut_uwin_pkg_utmenu, "UTMenu");
	if (n > 0)
		ut_uwin_pkg_ok |= 4;

	UTUWinProbeExec;
	UTUWinLoadArt;

	ut_uwin_ready = (ut_uwin_pkg_ok != 0) &&
		(ut_uwin_black_ok || ut_uwin_bar_art_ok);
	//Defer Activate until SoftDrv canvas exists (UT99 after UTDrawNew).
	ut_uwin_active = FALSE;

	UTLog("UTUWin: ready=%d classes=%d\n",
		ToI64(ut_uwin_ready), ut_uwin_cls_n);
}

U0 UTUWinExit()
{
	if (ut_uwin_zeroed)
		UTUWinFreeArt;
	ut_uwin_active = FALSE;
	ut_uwin_ready = FALSE;
	ut_uwin_cls_n = 0;
	ut_uwin_node_n = 0;
}

U0 UTUWinPaintRoot(CUTUWinNode *root)
{//UMenuRootWindow.Paint — MenuBlack + 4x3 Bg mosaic via DrawTile
	I64 ww;
	I64 wh;
	F64 w;
	F64 h;
	I64 xoff;
	I64 yoff;
	I64 row;
	I64 colx;
	I64 idx;
	I64 dx;
	I64 dy;
	I64 dw;
	I64 dh;

	ww = root->w;
	wh = root->h;
	if (ut_uwin_black_ok)
		UTUWinDrawStretched(&ut_uwin_menu_black, 0, 0, ww, wh);
	else
		UTWinFill(0, 0, ww, wh, ut_col_black);

	w = ToF64(ww) / 4.0;
	h = w;
	if (h > ToF64(wh) / 3.0)
	{
		h = ToF64(wh) / 3.0;
		w = h;
	}
	dw = ToI64(w);
	dh = ToI64(h);
	if (dw < 1)
		dw = 1;
	if (dh < 1)
		dh = 1;
	xoff = (ww - (4 * (dw - 1))) / 2;
	yoff = (wh - (3 * (dh - 1))) / 2;

	row = 2;
	while (row >= 0)
	{
		colx = 3;
		while (colx >= 0)
		{
			idx = colx + row * 4;
			dx = xoff + colx * (dw - 1);
			dy = yoff + row * (dh - 1);
			if (idx >= 0 && idx < UT_UWIN_BG_N && ut_uwin_bg_ok[idx])
				UTUWinDrawStretched(&ut_uwin_bg[idx], dx, dy, dw, dh);
			colx--;
		}
		row--;
	}
}

U0 UTUWinPaintMenuBar(CUTUWinNode *bar)
{//UMenuBlueLookAndFeel.Menu_DrawMenuBar + items
 //Retail ClipText uses DrawColor black on light BlueBar. SoftDrv menus
 //paint white so captions stay readable if chrome indices sit dark.
	I64 i;
	I64 x;
	I64 w;
	I64 bw;
	U8 *cap;
	I64 col;

	bw = bar->w;
	if (ut_uwin_bar_art_ok)
	{
		UTUWinDrawClipped(&ut_uwin_bar_l, 0, 0);
		UTUWinDrawStretched(&ut_uwin_bar_tile, 16, 0, bw - 32, 16);
		UTUWinDrawClipped(&ut_uwin_bar_win, bw - 16, 0);
	}
	else
		UTWinFill(0, 0, bw, 16, ut_col_menubar);

	i = 0;
	while (i < ut_uwin_bar_n)
	{
		x = ut_uwin_bar[i].x;
		w = ut_uwin_bar[i].w;
		cap = ut_uwin_bar[i].caption;
		if (ut_uwin_selected == i)
		{
			UTUWinDrawClipped(&ut_uwin_bar_in_l, x, 0);
			UTUWinDrawStretched(&ut_uwin_bar_in_m, x + 1, 0, w - 2, 16);
			UTUWinDrawClipped(&ut_uwin_bar_in_r, x + w - 1, 0);
		}
		else if (ut_uwin_over == i)
		{
			UTUWinDrawClipped(&ut_uwin_bar_out_l, x, 0);
			UTUWinDrawStretched(&ut_uwin_bar_out_m, x + 1, 0, w - 2, 16);
			UTUWinDrawClipped(&ut_uwin_bar_out_r, x + w - 1, 0);
		}
		col = ut_col_white;
		UTWinTextAt(x + 4, 2, cap, col);
		i++;
	}
	UTWinTextAt(bw - 72, 2, ut_uwin_bar_caps[4], ut_col_white);
}

U0 UTUWinPaintPulldown(CUTUWinNode *pd)
{//Menu_DrawPulldownMenuBackground + Menu_DrawPulldownMenuItem
	I64 i;
	I64 y;
	I64 col;
	U8 *cap;
	I64 ww;
	I64 wh;
	I64 ix;
	I64 iy;
	I64 iw;

	ww = pd->w;
	wh = pd->h;
	if (ut_uwin_pull_art_ok)
	{
		UTUWinDrawClipped(&ut_uwin_pull_tl, pd->x, pd->y);
		UTUWinDrawStretched(&ut_uwin_pull_t, pd->x + 4, pd->y,
			ww - 8, 4);
		UTUWinDrawClipped(&ut_uwin_pull_tr, pd->x + ww - 4, pd->y);
		UTUWinDrawStretched(&ut_uwin_pull_l, pd->x, pd->y + 4,
			4, wh - 8);
		UTUWinDrawStretched(&ut_uwin_pull_r, pd->x + ww - 4, pd->y + 4,
			4, wh - 8);
		UTUWinDrawClipped(&ut_uwin_pull_bl, pd->x, pd->y + wh - 4);
		UTUWinDrawStretched(&ut_uwin_pull_b, pd->x + 4, pd->y + wh - 4,
			ww - 8, 4);
		UTUWinDrawClipped(&ut_uwin_pull_br, pd->x + ww - 4,
			pd->y + wh - 4);
		UTUWinDrawStretched(&ut_uwin_pull_area, pd->x + 4, pd->y + 4,
			ww - 8, wh - 8);
	}
	else
		UTWinFill(pd->x, pd->y, ww, wh, ut_col_laf_face);

	y = pd->y + 4;
	i = 0;
	while (i < ut_uwin_pull_n)
	{
		cap = ut_uwin_pull_caps[i];
		if (cap[0] == '-')
		{
			if (ut_uwin_pull_line.mips[0].pixels)
				UTUWinDrawStretched(&ut_uwin_pull_line,
					pd->x + 4, y + 5, ww - 8, 2);
			else
				UTWinFill(pd->x + 6, y + 6, ww - 12, 1, ut_col_white);
		}
		else
		{
			col = ut_col_white;
			if (i == ut_uwin_pull_sel)
			{
				ix = pd->x;
				iy = y;
				iw = ww;
				if (ut_uwin_pull_hl_ok)
				{
					UTUWinDrawClipped(&ut_uwin_pull_hl, ix, iy);
					UTUWinDrawStretched(&ut_uwin_pull_hm,
						ix + 4, iy, iw - 8, 16);
					UTUWinDrawClipped(&ut_uwin_pull_hr,
						ix + iw - 4, iy);
				}
				else
					UTWinFill(pd->x + 4, y, ww - 8, 14, ut_col_sel);
			}
			UTWinTextAt(pd->x + 8, y + 2, cap, col);
		}
		y += 16;
		i++;
	}
}

U0 UTUWinPaintClient(CUTUWinNode *win)
{//UMenuOptionsWindow SoftDrv stand-in — tabs + white list text
	I64 x;
	I64 y;
	I64 w;
	I64 h;
	I64 i;
	I64 tx;
	U8 *tabs[5];
	U8 *lines[6];
	I64 col;

	x = win->x;
	y = win->y;
	w = win->w;
	h = win->h;
	UTWinDrawLAFFrame(x, y, w, h, "Preferences");
	tabs[0] = "Game";
	tabs[1] = "Video";
	tabs[2] = "Audio";
	tabs[3] = "Controls";
	tabs[4] = "HUD";
	tx = x + 8;
	i = 0;
	while (i < 5)
	{
		if (i == ut_uwin_opt_tab)
			UTWinFill(tx, y + 22, 64, 16, ut_col_sel);
		UTWinTextAt(tx + 4, y + 24, tabs[i], ut_col_white);
		tx += 68;
		i++;
	}
	UTWinFill(x + 6, y + 40, w - 12, h - 70, ut_col_laf_client);
	lines[0] = "Game options, audio and video setup.";
	lines[1] = "HUD configuration and controls.";
	lines[2] = "Host Canvas DrawText path.";
	lines[3] = "Esc closes. Click tabs to switch.";
	lines[4] = "";
	lines[5] = "";
	if (ut_uwin_opt_tab == 1)
	{
		lines[0] = "Video: SoftDrv software renderer.";
		lines[1] = "F5 or = cycles resolution slots.";
		lines[2] = "Default 640x480 framebuffer.";
	}
	else if (ut_uwin_opt_tab == 2)
	{
		lines[0] = "Audio: Galaxy / host mixer.";
		lines[1] = "Music via UTMusic when assets present.";
	}
	else if (ut_uwin_opt_tab == 3)
	{
		lines[0] = "Controls: WASD + mouse look in-game.";
		lines[1] = "Esc toggles UWindow.";
	}
	else if (ut_uwin_opt_tab == 4)
	{
		lines[0] = "HUD: ChallengeHUD PostRender gap.";
		lines[1] = "Crosshair from Client until HUD Exec.";
	}
	i = 0;
	while (i < 4)
	{
		if (lines[i][0])
			UTWinTextAt(x + 14, y + 50 + i * 16, lines[i], ut_col_white);
		i++;
	}
	col = ut_col_dim;
	UTWinTextAt(x + 14, y + h - 24, "Close", col);
	no_warn col;
}

U0 UTUWinPaintNode(CUTUWinNode *n)
{//Single window Paint — kind dispatch (BeforePaint/Paint/AfterPaint stand-in).
	if (!n || !n->visible)
		return;
	if (n->kind == UT_UWIN_KIND_ROOT)
		UTUWinPaintRoot(n);
	else if (n->kind == UT_UWIN_KIND_MENUBAR)
		UTUWinPaintMenuBar(n);
	else if (n->kind == UT_UWIN_KIND_PULLDOWN)
		UTUWinPaintPulldown(n);
	else if (n->kind == UT_UWIN_KIND_CLIENT)
		UTUWinPaintClient(n);
	else if (n->kind == UT_UWIN_KIND_STATUS)
	{
		UTWinFill(n->x, n->y, n->w, n->h, ut_col_menubar);
		UTWinTextAt(n->x + 8, n->y + 2, "Version 436", ut_col_white);
	}
}

U0 UTUWinPaintClients(I64 parent_i)
{//UWindowWindow.PaintClients — FirstChildWindow → NextSiblingWindow.
 //Sets child.ClippingRegion; pushes OrgX/OrgY/ClipX/ClipY.
	I64 child;
	I64 guard;
	I64 rel_x;
	I64 rel_y;
	I64 cw;
	I64 ch;
	I64 save_org_x;
	I64 save_org_y;
	I64 save_clip_x;
	I64 save_clip_y;
	CUTUWinNode *n;
	CUTUWinNode *p;
	CUTUWinRegion *cr;
	CUTUWinRegion *pr;

	if (parent_i < 0 || parent_i >= ut_uwin_node_n)
		return;
	p = &ut_uwin_node[parent_i];
	pr = &p->clip_region;
	save_org_x = ut_win.org_x;
	save_org_y = ut_win.org_y;
	save_clip_x = ut_win.clip_x;
	save_clip_y = ut_win.clip_y;
	child = p->first_child;
	guard = 0;
	while (child >= 0 && child < ut_uwin_node_n && guard < UT_UWIN_NODE_MAX)
	{
		guard++;
		n = &ut_uwin_node[child];
		if (n->visible)
		{
			UTWinSetStyle(UT_STY_NORMAL);
			UTWinSetDrawColor(255, 255, 255);
			rel_x = n->x - p->x;
			rel_y = n->y - p->y;
			if (rel_x < 0) rel_x = 0;
			if (rel_y < 0) rel_y = 0;
			cw = p->w - rel_x;
			ch = p->h - rel_y;
			if (cw > n->w) cw = n->w;
			if (ch > n->h) ch = n->h;
			if (cw > save_clip_x - rel_x)
				cw = save_clip_x - rel_x;
			if (ch > save_clip_y - rel_y)
				ch = save_clip_y - rel_y;

			cr = &n->clip_region;
			if (!n->no_clip)
			{
				//UWindowWindow.PaintClients ClippingRegion translate
				cr->x = pr->x - rel_x;
				cr->y = pr->y - rel_y;
				cr->w = pr->w;
				cr->h = pr->h;
				if (cr->x < 0)
				{
					cr->w = cr->w + cr->x;
					cr->x = 0;
				}
				if (cr->y < 0)
				{
					cr->h = cr->h + cr->y;
					cr->y = 0;
				}
				if (cr->w > n->w - cr->x)
					cr->w = n->w - cr->x;
				if (cr->h > n->h - cr->y)
					cr->h = n->h - cr->y;
			}
			else
			{
				cr->x = 0;
				cr->y = 0;
				cr->w = n->w;
				cr->h = n->h;
			}

			if (cr->w > 0 && cr->h > 0 && cw > 0 && ch > 0)
			{
				UTWinPushClip(save_org_x + rel_x + cr->x,
					save_org_y + rel_y + cr->y,
					cr->w, cr->h);
				UTUWinPaintNode(n);
				UTUWinPaintClients(child);
				UTWinPopClip;
			}
			ut_win.org_x = save_org_x;
			ut_win.org_y = save_org_y;
		}
		child = n->next_sib;
	}
	ut_win.clip_x = save_clip_x;
	ut_win.clip_y = save_clip_y;
}

U0 UTUWinRenderUWindow(CUTCanvas *c)
{//WindowConsole.RenderUWindow — root Paint then PaintClients tree
	CUTUWinNode *n;

	if (!c || ut_uwin_root < 0)
		return;
	UTWinReset;
	if (ut_win_ready)
		ut_win.fb = c;

	n = &ut_uwin_node[ut_uwin_root];
	n->clip_region.x = 0;
	n->clip_region.y = 0;
	n->clip_region.w = n->w;
	n->clip_region.h = n->h;
	UTWinSetStyle(UT_STY_NORMAL);
	UTWinSetDrawColor(255, 255, 255);
	UTUWinPaintRoot(n);
	UTUWinPaintClients(ut_uwin_root);

	//Canvas native probe — keep Exec warm for script Paint path
	UTUWinTryExec(ut_uwin_pkg_uwindow, "Paint", 64);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "RenderUWindow", 64);
}

U0 UTUWinDrawCursor(CUTCanvas *c)
{//UWindow.DrawMouse — masked MouseCursor (index0 hole) or poly arrow.
	I64 x;
	I64 y;
	I64 dw;
	I64 dh;

	if (!c)
		return;
	x = ut_uwin_mouse_x;
	y = ut_uwin_mouse_y;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x >= c->width) x = c->width - 1;
	if (y >= c->height) y = c->height - 1;

	if (ut_uwin_cursor_ok && ut_uwin_cursor.mips[0].pixels)
	{
		if (ut_win_ready)
			ut_win.fb = c;
		dw = ut_uwin_cursor.u_size;
		dh = ut_uwin_cursor.v_size;
		if (dw > 32) dw = 32;
		if (dh > 32) dh = 32;
		//UTWinDrawTile: index 0 masked (arrow on transparent)
		UTWinDrawTile(&ut_uwin_cursor, x, y, dw, dh,
			0, 0, ut_uwin_cursor.u_size, ut_uwin_cursor.v_size);
		return;
	}
	UTClientDrawCursor(c);
}

U0 UTUWinDraw(CUTCanvas *c)
{
	if (!c || !ut_uwin_active)
		return;
	UTUWinRenderUWindow(c);
	UTUWinDrawCursor(c);
}

U0 UTUWinUpdateMouse()
{
	I64 i;
	CUTUWinNode *pd;
	I64 py;

	if (!ut_canvas)
		return;
	//Hover hit-tests use soft cursor (UTUWinMsMove). mouse.pos frozen under MouseRaw.

	ut_uwin_over = -1;
	if (ut_uwin_mouse_y >= 0 && ut_uwin_mouse_y < 16)
	{
		i = 0;
		while (i < ut_uwin_bar_n)
		{
			if (ut_uwin_mouse_x >= ut_uwin_bar[i].x &&
				ut_uwin_mouse_x < ut_uwin_bar[i].x + ut_uwin_bar[i].w)
			{
				ut_uwin_over = i;
				break;
			}
			i++;
		}
	}
	if (ut_uwin_pulldown >= 0 && ut_uwin_node[ut_uwin_pulldown].visible)
	{
		pd = &ut_uwin_node[ut_uwin_pulldown];
		i = 0;
		while (i < ut_uwin_pull_n)
		{
			py = pd->y + 4 + i * 16;
			if (ut_uwin_pull_caps[i][0] != '-' &&
				ut_uwin_mouse_y >= py &&
				ut_uwin_mouse_y < py + 16 &&
				ut_uwin_mouse_x >= pd->x &&
				ut_uwin_mouse_x < pd->x + pd->w)
				ut_uwin_pull_sel = i;
			i++;
		}
	}
}

U0 UTUWinExecutePull()
{//UTGameMenu / UTOptionsMenu / Multiplayer / Tools ExecuteItem subset
	U8 *cap;

	if (ut_uwin_pull_sel < 0 || ut_uwin_pull_sel >= ut_uwin_pull_n)
		return;
	cap = ut_uwin_pull_caps[ut_uwin_pull_sel];
	if (cap[0] == '-')
		return;

	if (ut_uwin_pull_bar == UT_UWIN_BAR_GAME)
	{
		if (!StrCompare(cap, "Quit"))
		{
			ut_menu_quit = TRUE;
			UTUWinDeactivate;
			return;
		}
		if (!StrCompare(cap, "Start Practice Session") ||
			!StrCompare(cap, "Return to Current Game") ||
			!StrCompare(cap, "Start Unreal Tournament"))
		{
			UTClientStartMatch;
			UTUWinDeactivate;
			return;
		}
		if (!StrCompare(cap, "Resume Saved Tournament"))
		{
			UTClientStartMatch;
			UTUWinDeactivate;
			return;
		}
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_OPT)
	{
		if (!StrCompare(cap, "Preferences"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowPreferences;
			return;
		}
		if (!StrCompare(cap, "Player Setup"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			ut_uwin_opt_tab = 0;
			UTUWinShowPreferences;
			UTUWinTryExec(ut_uwin_pkg_utmenu, "PlayerSetup", 64);
			return;
		}
		if (!StrCompare(cap, "Weapons"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			ut_uwin_opt_tab = 3;
			UTUWinShowPreferences;
			UTUWinTryExec(ut_uwin_pkg_umenu, "Prioritize", 64);
			return;
		}
		if (!StrCompare(cap, "Show Desktop"))
		{
			ut_uwin_desktop = !ut_uwin_desktop;
			UTLog("UTUWin: ShowDesktop=%d\n", ToI64(ut_uwin_desktop));
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			return;
		}
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_MP)
	{
		if (!StrCompare(cap, "Start New Multiplayer Game") ||
			!StrCompare(cap, "Start Practice Session") ||
			!StrCompare(cap, "Start Multiplayer Game"))
		{
			UTClientStartMatch;
			UTUWinDeactivate;
			return;
		}
		if (!StrCompare(cap, "Get Botpack") ||
			!StrCompare(cap, "Check for Botpack Updates") ||
			!StrCompare(cap, "Join Multiplayer Game") ||
			!StrCompare(cap, "Find Internet Games") ||
			!StrCompare(cap, "Open Location") ||
			!StrCompare(cap, "Disconnect") ||
			!StrCompare(cap, "Reconnect"))
		{
			//LAN/net absent — practice SoftDrv travel
			UTClientStartMatch;
			UTUWinDeactivate;
			return;
		}
		UTLog("UTUWin: Multiplayer '%s' → practice travel\n", cap);
		UTClientStartMatch;
		UTUWinDeactivate;
		return;
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_TOOLS)
	{
		if (!StrCompare(cap, "System Console"))
			UTUWinTryExec(ut_uwin_pkg_uwindow, "ShowConsole", 64);
		else if (!StrCompare(cap, "TimeDemo Statistics"))
			UTUWinTryExec(ut_uwin_pkg_uwindow, "TimeDemo", 64);
		else if (!StrCompare(cap, "Show Log"))
		{
			UTLog("UTUWin: Show Log — dump SoftDrv client gaps\n");
			UTClientProbeGaps;
			UTClientBuildGapNote;
			UTLog("UTUWin: gaps=%02X %s\n",
				ut_client_gap_mask, ut_client_gap_note);
		}
	}

	if (ut_uwin_pulldown >= 0)
		ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
	ut_uwin_selected = -1;
}

Bool UTUWinClientClick()
{//Preferences tabs / close. TRUE if click consumed.
	CUTUWinNode *win;
	I64 x;
	I64 y;
	I64 w;
	I64 h;
	I64 tx;
	I64 i;

	if (ut_uwin_client < 0 || !ut_uwin_node[ut_uwin_client].visible)
		return FALSE;
	win = &ut_uwin_node[ut_uwin_client];
	x = win->x;
	y = win->y;
	w = win->w;
	h = win->h;
	if (ut_uwin_mouse_x < x || ut_uwin_mouse_x >= x + w ||
		ut_uwin_mouse_y < y || ut_uwin_mouse_y >= y + h)
		return FALSE;
	if (ut_uwin_mouse_y >= y + 22 && ut_uwin_mouse_y < y + 38)
	{
		tx = x + 8;
		i = 0;
		while (i < 5)
		{
			if (ut_uwin_mouse_x >= tx && ut_uwin_mouse_x < tx + 64)
			{
				ut_uwin_opt_tab = i;
				return TRUE;
			}
			tx += 68;
			i++;
		}
	}
	if (ut_uwin_mouse_y >= y + h - 28)
	{
		UTUWinCloseClient;
		return TRUE;
	}
	return TRUE;
}

U0 UTUWinKeyEvent(I64 key, Bool down)
{//WindowConsole.KeyEvent / Root KeyFocus — subset
	if (!down)
		return;
	UTUWinTryExec(ut_uwin_pkg_uwindow, "KeyEvent", 32);
	if (key == SC_ESC)
	{
		if (ut_uwin_client >= 0 && ut_uwin_node[ut_uwin_client].visible)
			UTUWinCloseClient;
		else if (ut_uwin_pulldown >= 0 &&
			ut_uwin_node[ut_uwin_pulldown].visible)
		{
			ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
		}
		else
		{
			ut_menu_quit = TRUE;
			UTUWinDeactivate;
		}
	}
}

U0 UTUWinPoll()
{
	Bool esc;
	Bool enter;
	Bool up;
	Bool down;
	Bool quitk;
	Bool lmb;

	if (!ut_uwin_active)
	{
		esc = Bt(kbd.down_bitmap, SC_ESC);
		quitk = Bt(kbd.down_bitmap, Char2ScanCode('q'));
		if (esc)
		{
			if (!ut_uwin_latched && !ut_menu_fake_laf &&
				ut_uwin_ready)
			{
				ut_uwin_latched = TRUE;
				UTUWinActivate;
			}
		}
		else if (quitk)
		{
			if (!ut_uwin_latched)
			{
				ut_uwin_latched = TRUE;
				ut_menu_quit = TRUE;
			}
		}
		else
			ut_uwin_latched = FALSE;
		return;
	}

	UTUWinUpdateMouse;
	UTUWinTryExec(ut_uwin_pkg_uwindow, "MouseMove", 32);
	//UWindow Tick/Paint with RootWindow Self bag
	if (ut_obj_root >= 0)
	{
		UTVMCallSelf("Tick", ut_obj_root, &ut_obj[ut_obj_root].bag, 64);
		UTVMCallSelf("Paint", ut_obj_root, &ut_obj[ut_obj_root].bag, 64);
	}
	else
		UTUWinTryExec(ut_uwin_pkg_uwindow, "Tick", 32);

	lmb = mouse_hard.bttns[0];
	if (lmb)
	{
		if (!ut_uwin_mb_latched)
		{
			ut_uwin_mb_latched = TRUE;
			if (UTUWinClientClick)
			{
				//Preferences ate the click
			}
			else if (ut_uwin_pulldown >= 0 &&
				ut_uwin_node[ut_uwin_pulldown].visible &&
				ut_uwin_mouse_y >= 16)
				UTUWinExecutePull;
			else if (ut_uwin_over >= 0)
				UTUWinOpenBar(ut_uwin_over);
			else
			{
				ut_uwin_selected = -1;
				if (ut_uwin_pulldown >= 0)
					ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			}
		}
	}
	else
		ut_uwin_mb_latched = FALSE;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	quitk = Bt(kbd.down_bitmap, Char2ScanCode('q'));
	if (esc)
	{
		if (!ut_uwin_latched)
		{
			ut_uwin_latched = TRUE;
			UTUWinKeyEvent(SC_ESC, TRUE);
		}
	}
	else if (quitk)
	{
		if (!ut_uwin_latched)
		{
			ut_uwin_latched = TRUE;
			ut_menu_quit = TRUE;
			UTUWinDeactivate;
		}
	}
	else
		ut_uwin_latched = FALSE;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	if (up || down || enter)
	{
		if (!ut_uwin_nav_latched)
		{
			ut_uwin_nav_latched = TRUE;
			if (ut_uwin_pulldown >= 0 &&
				ut_uwin_node[ut_uwin_pulldown].visible)
			{
				if (up)
				{
					ut_uwin_pull_sel--;
					if (ut_uwin_pull_sel < 0)
						ut_uwin_pull_sel = ut_uwin_pull_n - 1;
					while (ut_uwin_pull_sel >= 0 &&
						ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
						ut_uwin_pull_sel--;
					if (ut_uwin_pull_sel < 0)
						ut_uwin_pull_sel = 0;
				}
				else if (down)
				{
					ut_uwin_pull_sel++;
					if (ut_uwin_pull_sel >= ut_uwin_pull_n)
						ut_uwin_pull_sel = 0;
					while (ut_uwin_pull_sel < ut_uwin_pull_n &&
						ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
						ut_uwin_pull_sel++;
					if (ut_uwin_pull_sel >= ut_uwin_pull_n)
						ut_uwin_pull_sel = 0;
				}
				else if (enter)
					UTUWinExecutePull;
			}
			else if (enter)
			{
				UTUWinOpenBar(0);
			}
		}
	}
	else
		ut_uwin_nav_latched = FALSE;
}
