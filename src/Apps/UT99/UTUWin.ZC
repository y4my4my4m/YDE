// UTUWin.ZC - package-driven UWindow client (Engine Client shape).
//
// PubSrc: Window/=Win32 only; Engine Canvas natives. No UWindow.uc.
// Retail bytecode embeds class text + Texture exports in UMenu.u / UWindow.u.
// SoftDrv = URenderDevice. Paint = Canvas DrawTile/DrawText → P8.
//
// Host mirrors CreateRootWindow / UMenuRootWindow.Paint / LookAndFeel
// Menu_Draw* from System/*.u ScriptText. Art = UMenu.u Texture exports.
// Start Match → UTClientStartMatch. See docs/Apps/UT99/PORT.md.

extern U0	UTClientStartMatch();
extern U0	UTClientDrawCursor(CUTCanvas *c);

#define UT_UWIN_CLS_MAX		256
#define UT_UWIN_NODE_MAX	16
#define UT_UWIN_ITEM_MAX	8
#define UT_UWIN_BG_N		12

#define UT_UWIN_KIND_ROOT	0
#define UT_UWIN_KIND_MENUBAR	1
#define UT_UWIN_KIND_PULLDOWN	2
#define UT_UWIN_KIND_STATUS	3

#define UT_UWIN_EXEC_CREATE	1
#define UT_UWIN_EXEC_RENDER	2
#define UT_UWIN_EXEC_LAUNCH	4
#define UT_UWIN_EXEC_PAINT	8
#define UT_UWIN_EXEC_POST	16

class CUTUWinClass
{
	U8	name[56];
	U8	pkg[24];
};

class CUTUWinNode
{
	U8	class_name[48];
	I64	kind;
	I64	x;
	I64	y;
	I64	w;
	I64	h;
	I64	parent;
	Bool visible;
	Bool always_on_top;
};

class CUTUWinBarItem
{
	U8	caption[32];
	I64	x;
	I64	w;
};

CUTUWinClass	ut_uwin_cls[UT_UWIN_CLS_MAX];
I64		ut_uwin_cls_n		= 0;
CUTUWinNode	ut_uwin_node[UT_UWIN_NODE_MAX];
I64		ut_uwin_node_n		= 0;
I64		ut_uwin_root		= -1;
I64		ut_uwin_menubar		= -1;
I64		ut_uwin_pulldown	= -1;

Bool	ut_uwin_active		= FALSE;
Bool	ut_uwin_ready		= FALSE;
Bool	ut_uwin_latched		= FALSE;
Bool	ut_uwin_nav_latched	= FALSE;
Bool	ut_uwin_mb_latched	= FALSE;
I64		ut_uwin_exec_mask	= 0;
I64		ut_uwin_steps		= 0;
I64		ut_uwin_pkg_ok		= 0;
I64		ut_uwin_mouse_x		= 0;
I64		ut_uwin_mouse_y		= 0;
Bool	ut_uwin_ms_ok		= FALSE;
I64		ut_uwin_over		= -1;
I64		ut_uwin_selected	= -1;
I64		ut_uwin_pull_sel	= 0;
I64		ut_uwin_pull_n		= 0;

U8 *ut_uwin_console_cls	= "UTMenu.UTConsole";
U8 *ut_uwin_root_cls	= "UMenu.UMenuRootWindow";
U8 *ut_uwin_laf_cls		= "UMenu.UMenuBlueLookAndFeel";

U8 *ut_uwin_bar_caps[5] = {
	"Game", "Multiplayer", "Options", "Tools", "Version 436"
};
CUTUWinBarItem	ut_uwin_bar[UT_UWIN_ITEM_MAX];
I64		ut_uwin_bar_n		= 0;

U8 *ut_uwin_pull_caps[UT_UWIN_ITEM_MAX] = {
	"Start Unreal Tournament",
	"Start Practice Session",
	"-",
	"Resume Saved Tournament",
	"Return to Current Game",
	"-",
	"Quit",
	""
};

// UMenu.u Texture'MenuBlack' + Bg11..Bg43 (UMenuRootWindow.Paint)
CUTTex	ut_uwin_menu_black;
CUTTex	ut_uwin_bg[UT_UWIN_BG_N];
Bool	ut_uwin_black_ok	= FALSE;
Bool	ut_uwin_bg_ok[UT_UWIN_BG_N];	//MemSet on first LoadArt; BSS not zeroed
Bool	ut_uwin_zeroed		= FALSE;	//TRUE after first MemSet; Free safe thereafter

// UMenuBlueLookAndFeel Menu_DrawMenuBar art
CUTTex	ut_uwin_bar_l;
CUTTex	ut_uwin_bar_tile;
CUTTex	ut_uwin_bar_win;
CUTTex	ut_uwin_bar_in_l;
CUTTex	ut_uwin_bar_in_m;
CUTTex	ut_uwin_bar_in_r;
CUTTex	ut_uwin_bar_out_l;
CUTTex	ut_uwin_bar_out_m;
CUTTex	ut_uwin_bar_out_r;
Bool	ut_uwin_bar_art_ok	= FALSE;

CUTTex	ut_uwin_pull_tl;
CUTTex	ut_uwin_pull_t;
CUTTex	ut_uwin_pull_tr;
CUTTex	ut_uwin_pull_l;
CUTTex	ut_uwin_pull_r;
CUTTex	ut_uwin_pull_bl;
CUTTex	ut_uwin_pull_b;
CUTTex	ut_uwin_pull_br;
CUTTex	ut_uwin_pull_area;
Bool	ut_uwin_pull_art_ok	= FALSE;

