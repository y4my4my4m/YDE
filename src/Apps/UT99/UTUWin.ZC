U0 UTUWinOpenBar(I64 bar_i)
{//UWindowMenuBarItem.Select → CreateMenu + Show
	U8 **caps;
	I64 def_sel;

	if (bar_i < 0 || bar_i >= ut_uwin_bar_n)
		return;
	ut_uwin_selected = bar_i;
	ut_uwin_pull_bar = bar_i;
	caps = ut_uwin_game_caps;
	def_sel = 1;
	if (bar_i == UT_UWIN_BAR_MP)
	{
		caps = ut_uwin_mp_caps;
		def_sel = 0;
	}
	else if (bar_i == UT_UWIN_BAR_OPT)
	{
		caps = ut_uwin_opt_caps;
		def_sel = 0;
	}
	else if (bar_i == UT_UWIN_BAR_TOOLS)
	{
		caps = ut_uwin_tools_caps;
		def_sel = 0;
	}
	UTUWinLoadPullCaps(caps);
	if (ut_uwin_pulldown >= 0)
	{
		ut_uwin_node[ut_uwin_pulldown].x = ut_uwin_bar[bar_i].x;
		ut_uwin_node[ut_uwin_pulldown].y = 16;
		ut_uwin_node[ut_uwin_pulldown].visible = TRUE;
		ut_uwin_pull_sel = def_sel;
		if (ut_uwin_pull_sel >= ut_uwin_pull_n)
			ut_uwin_pull_sel = 0;
		while (ut_uwin_pull_sel < ut_uwin_pull_n &&
			ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
			ut_uwin_pull_sel++;
	}
}

U0 UTUWinCreateRootWindow(I64 cw, I64 ch)
{//Host CreateRootWindow — UMenuRootWindow + UMenuMenuBar children
	ut_uwin_node_n = 0;
	ut_uwin_root = -1;
	ut_uwin_menubar = -1;
	ut_uwin_pulldown = -1;
	ut_uwin_client = -1;
	ut_uwin_over = -1;
	ut_uwin_selected = -1;
	ut_uwin_pull_sel = 0;
	ut_uwin_pull_n = 0;
	ut_uwin_pull_bar = 0;
	ut_uwin_opt_tab = 0;

	if (cw < 64)
		cw = 320;
	if (ch < 64)
		ch = 240;

	ut_uwin_root = UTUWinAddNode("UMenuRootWindow", UT_UWIN_KIND_ROOT,
		0, 0, cw, ch, -1);
	ut_uwin_menubar = UTUWinAddNode("UMenuMenuBar", UT_UWIN_KIND_MENUBAR,
		0, 0, cw, 16, ut_uwin_root);
	UTUWinAddNode("UMenuStatusBar", UT_UWIN_KIND_STATUS,
		0, ch - 16, cw, 16, ut_uwin_root);
	ut_uwin_node[ut_uwin_node_n - 1].visible = FALSE;

	ut_uwin_pulldown = UTUWinAddNode("UTGameMenu", UT_UWIN_KIND_PULLDOWN,
		8, 16, 200, 7 * 16 + 8, ut_uwin_menubar);
	ut_uwin_node[ut_uwin_pulldown].visible = FALSE;

	UTUWinLayoutBar(cw);
	UTUWinLoadPullCaps(ut_uwin_game_caps);
	UTLog("UTUWin: CreateRootWindow nodes=%d root=%s laf=%s\n",
		ut_uwin_node_n, ut_uwin_root_cls, ut_uwin_laf_cls);
}

U0 UTUWinMsReset()
{//MouseRaw freezes mouse.pos — soft cursor must re-seed from canvas centre.
	ut_uwin_ms_ok = FALSE;
}

U0 UTUWinMsMove(I64 dx, I64 dy)
{//HLMenuMsMove: integrate raw deltas into SoftDrv canvas space.
	I64 bw;
	I64 bh;

	if (!ut_canvas || ut_canvas->width < 1 || ut_canvas->height < 1)
		return;
	bw = ut_blit_w;
	bh = ut_blit_h;
	if (bw < 1) bw = 1;
	if (bh < 1) bh = 1;
	if (!ut_uwin_ms_ok)
	{
		ut_uwin_mouse_x = ut_canvas->width / 2;
		ut_uwin_mouse_y = ut_canvas->height / 2;
		ut_uwin_ms_ok = TRUE;
	}
	ut_uwin_mouse_x += dx * ut_canvas->width / bw;
	ut_uwin_mouse_y += dy * ut_canvas->height / bh;
	if (ut_uwin_mouse_x < 0)
		ut_uwin_mouse_x = 0;
	if (ut_uwin_mouse_y < 0)
		ut_uwin_mouse_y = 0;
	if (ut_uwin_mouse_x >= ut_canvas->width)
		ut_uwin_mouse_x = ut_canvas->width - 1;
	if (ut_uwin_mouse_y >= ut_canvas->height)
		ut_uwin_mouse_y = ut_canvas->height - 1;
}

U0 UTUWinActivate()
{//Requires SoftDrv canvas when sizing to fb. Call after UTDrawNew.
	I64 cw;
	I64 ch;

	cw = 320;
	ch = 240;
	if (ut_canvas != NULL)
	{
		cw = ut_canvas->width;
		ch = ut_canvas->height;
	}
	if (ut_uwin_root < 0)
		UTUWinCreateRootWindow(cw, ch);
	else if (ut_uwin_root < ut_uwin_node_n)
	{
		ut_uwin_node[ut_uwin_root].w = cw;
		ut_uwin_node[ut_uwin_root].h = ch;
		if (ut_uwin_menubar >= 0 && ut_uwin_menubar < ut_uwin_node_n)
			ut_uwin_node[ut_uwin_menubar].w = cw;
		UTUWinLayoutBar(cw);
	}
	else
	{
		UTLog("UTUWinActivate: bad root=%d nodes=%d — rebuild\n",
			ut_uwin_root, ut_uwin_node_n);
		UTUWinCreateRootWindow(cw, ch);
	}
	//Menu art indices need UMenu/MenuGr palette. ArenaTex left active after
	//Start Match → P8→ARGB noise (false dither). One SoftDrv path only.
	if (FileFind(ut_uwin_pkg_umenu))
		UTPalLoadFromUtx(ut_uwin_pkg_umenu);
	else if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/MenuGr.utx");
	ut_uwin_active = TRUE;
	ut_menu_open = TRUE;
	ut_menu_boot = TRUE;
	ut_client_cursor_on = TRUE;
	UTUWinMsReset;
}

U0 UTUWinDeactivate()
{
	ut_uwin_active = FALSE;
	if (ut_uwin_pulldown >= 0)
		ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
	ut_uwin_selected = -1;
	UTUWinCloseClient;
	if (!ut_menu_fake_laf)
	{
		ut_menu_open = FALSE;
		ut_menu_boot = FALSE;
	}
	ut_client_cursor_on = FALSE;
	if (FileFind("::/Apps/UT99/Textures/ArenaTex.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/ArenaTex.utx");
	else if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
		UTPalLoadFromUtx("::/Apps/UT99/Textures/MenuGr.utx");
}

U0 UTUWinInit()
{
	I64 n;

	ut_uwin_cls_n = 0;
	ut_uwin_pkg_ok = 0;
	ut_uwin_exec_mask = 0;
	ut_uwin_steps = 0;
	ut_uwin_node_n = 0;
	ut_uwin_root = -1;
	ut_uwin_latched = FALSE;
	ut_uwin_nav_latched = FALSE;
	ut_uwin_mb_latched = FALSE;
	ut_uwin_ready = FALSE;

	n = UTUWinLoadPkgClasses(ut_uwin_pkg_uwindow, "UWindow");
	if (n > 0)
		ut_uwin_pkg_ok |= 1;
	n = UTUWinLoadPkgClasses(ut_uwin_pkg_umenu, "UMenu");
	if (n > 0)
		ut_uwin_pkg_ok |= 2;
	n = UTUWinLoadPkgClasses(ut_uwin_pkg_utmenu, "UTMenu");
	if (n > 0)
		ut_uwin_pkg_ok |= 4;

	UTUWinProbeExec;
	UTUWinLoadArt;

	ut_uwin_ready = (ut_uwin_pkg_ok != 0) &&
		(ut_uwin_black_ok || ut_uwin_bar_art_ok);
	//Defer Activate until SoftDrv canvas exists (UT99 after UTDrawNew).
	ut_uwin_active = FALSE;

	UTLog("UTUWin: ready=%d classes=%d\n",
		ToI64(ut_uwin_ready), ut_uwin_cls_n);
}

U0 UTUWinExit()
{
	if (ut_uwin_zeroed)
		UTUWinFreeArt;
	ut_uwin_active = FALSE;
	ut_uwin_ready = FALSE;
	ut_uwin_cls_n = 0;
	ut_uwin_node_n = 0;
}

U0 UTUWinPaintRoot(CUTUWinNode *root)
{//UMenuRootWindow.Paint — MenuBlack + 4x3 Bg mosaic via DrawTile
	I64 ww;
	I64 wh;
	F64 w;
	F64 h;
	I64 xoff;
	I64 yoff;
	I64 row;
	I64 colx;
	I64 idx;
	I64 dx;
	I64 dy;
	I64 dw;
	I64 dh;

	ww = root->w;
	wh = root->h;
	if (ut_uwin_black_ok)
		UTUWinDrawStretched(&ut_uwin_menu_black, 0, 0, ww, wh);
	else
		UTWinFill(0, 0, ww, wh, ut_col_black);

	w = ToF64(ww) / 4.0;
	h = w;
	if (h > ToF64(wh) / 3.0)
	{
		h = ToF64(wh) / 3.0;
		w = h;
	}
	dw = ToI64(w);
	dh = ToI64(h);
	if (dw < 1)
		dw = 1;
	if (dh < 1)
		dh = 1;
	xoff = (ww - (4 * (dw - 1))) / 2;
	yoff = (wh - (3 * (dh - 1))) / 2;

	row = 2;
	while (row >= 0)
	{
		colx = 3;
		while (colx >= 0)
		{
			idx = colx + row * 4;
			dx = xoff + colx * (dw - 1);
			dy = yoff + row * (dh - 1);
			if (idx >= 0 && idx < UT_UWIN_BG_N && ut_uwin_bg_ok[idx])
				UTUWinDrawStretched(&ut_uwin_bg[idx], dx, dy, dw, dh);
			colx--;
		}
		row--;
	}
}

U0 UTUWinPaintMenuBar(CUTUWinNode *bar)
{//UMenuBlueLookAndFeel.Menu_DrawMenuBar + items
 //Retail ClipText uses DrawColor black on light BlueBar. SoftDrv menus
 //paint white so captions stay readable if chrome indices sit dark.
	I64 i;
	I64 x;
	I64 w;
	I64 bw;
	U8 *cap;
	I64 col;

	bw = bar->w;
	if (ut_uwin_bar_art_ok)
	{
		UTUWinDrawClipped(&ut_uwin_bar_l, 0, 0);
		UTUWinDrawStretched(&ut_uwin_bar_tile, 16, 0, bw - 32, 16);
		UTUWinDrawClipped(&ut_uwin_bar_win, bw - 16, 0);
	}
	else
		UTWinFill(0, 0, bw, 16, ut_col_menubar);

	i = 0;
	while (i < ut_uwin_bar_n)
	{
		x = ut_uwin_bar[i].x;
		w = ut_uwin_bar[i].w;
		cap = ut_uwin_bar[i].caption;
		if (ut_uwin_selected == i)
		{
			UTUWinDrawClipped(&ut_uwin_bar_in_l, x, 0);
			UTUWinDrawStretched(&ut_uwin_bar_in_m, x + 1, 0, w - 2, 16);
			UTUWinDrawClipped(&ut_uwin_bar_in_r, x + w - 1, 0);
		}
		else if (ut_uwin_over == i)
		{
			UTUWinDrawClipped(&ut_uwin_bar_out_l, x, 0);
			UTUWinDrawStretched(&ut_uwin_bar_out_m, x + 1, 0, w - 2, 16);
			UTUWinDrawClipped(&ut_uwin_bar_out_r, x + w - 1, 0);
		}
		col = ut_col_white;
		UTWinTextAt(x + 4, 2, cap, col);
		i++;
	}
	UTWinTextAt(bw - 72, 2, ut_uwin_bar_caps[4], ut_col_white);
}

U0 UTUWinPaintPulldown(CUTUWinNode *pd)
{//Menu_DrawPulldownMenuBackground + Menu_DrawPulldownMenuItem
	I64 i;
	I64 y;
	I64 col;
	U8 *cap;
	I64 ww;
	I64 wh;
	I64 ix;
	I64 iy;
	I64 iw;

	ww = pd->w;
	wh = pd->h;
	if (ut_uwin_pull_art_ok)
	{
		UTUWinDrawClipped(&ut_uwin_pull_tl, pd->x, pd->y);
		UTUWinDrawStretched(&ut_uwin_pull_t, pd->x + 4, pd->y,
			ww - 8, 4);
		UTUWinDrawClipped(&ut_uwin_pull_tr, pd->x + ww - 4, pd->y);
		UTUWinDrawStretched(&ut_uwin_pull_l, pd->x, pd->y + 4,
			4, wh - 8);
		UTUWinDrawStretched(&ut_uwin_pull_r, pd->x + ww - 4, pd->y + 4,
			4, wh - 8);
		UTUWinDrawClipped(&ut_uwin_pull_bl, pd->x, pd->y + wh - 4);
		UTUWinDrawStretched(&ut_uwin_pull_b, pd->x + 4, pd->y + wh - 4,
			ww - 8, 4);
		UTUWinDrawClipped(&ut_uwin_pull_br, pd->x + ww - 4,
			pd->y + wh - 4);
		UTUWinDrawStretched(&ut_uwin_pull_area, pd->x + 4, pd->y + 4,
			ww - 8, wh - 8);
	}
	else
		UTWinFill(pd->x, pd->y, ww, wh, ut_col_laf_face);

	y = pd->y + 4;
	i = 0;
	while (i < ut_uwin_pull_n)
	{
		cap = ut_uwin_pull_caps[i];
		if (cap[0] == '-')
		{
			if (ut_uwin_pull_line.mips[0].pixels)
				UTUWinDrawStretched(&ut_uwin_pull_line,
					pd->x + 4, y + 5, ww - 8, 2);
			else
				UTWinFill(pd->x + 6, y + 6, ww - 12, 1, ut_col_white);
		}
		else
		{
			col = ut_col_white;
			if (i == ut_uwin_pull_sel)
			{
				ix = pd->x;
				iy = y;
				iw = ww;
				if (ut_uwin_pull_hl_ok)
				{
					UTUWinDrawClipped(&ut_uwin_pull_hl, ix, iy);
					UTUWinDrawStretched(&ut_uwin_pull_hm,
						ix + 4, iy, iw - 8, 16);
					UTUWinDrawClipped(&ut_uwin_pull_hr,
						ix + iw - 4, iy);
				}
				else
					UTWinFill(pd->x + 4, y, ww - 8, 14, ut_col_sel);
			}
			UTWinTextAt(pd->x + 8, y + 2, cap, col);
		}
		y += 16;
		i++;
	}
}

U0 UTUWinPaintClient(CUTUWinNode *win)
{//UMenuOptionsWindow / Botmatch SoftDrv stand-in
	I64 x;
	I64 y;
	I64 w;
	I64 h;
	I64 i;
	I64 tx;
	U8 *tabs[5];
	U8 line[72];
	I64 col;
	I64 rw;
	I64 rh;
	I64 row;
	U8 *mapnm;
	U8 *gt;

	x = win->x;
	y = win->y;
	w = win->w;
	h = win->h;

	if (ut_uwin_client_mode == UT_UWIN_MODE_BOTMATCH)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Start Practice Session");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		gt = UTMenuGameTypeName;
		mapnm = UTMenuMapDisplayName;
		StrPrint(line, "Game Type: %s  (click)", gt);
		UTWinTextAt(x + 14, y + 36, line, ut_col_white);
		StrPrint(line, "Map: %s  (click cycle)", mapnm);
		UTWinTextAt(x + 14, y + 56, line, ut_col_white);
		StrPrint(line, "Frag Limit: %d  [- / +]", ut_menu_frag);
		UTWinTextAt(x + 14, y + 76, line, ut_col_white);
		StrPrint(line, "Bots: %d  [- / +]", ut_menu_bots);
		UTWinTextAt(x + 14, y + 96, line, ut_col_white);
		StrPrint(line, "Bot Skill: %d  [- / +]", ut_menu_bot_skill);
		UTWinTextAt(x + 14, y + 116, line, ut_col_white);
		StrPrint(line, "Time Limit: %d min  [- / +]", ut_menu_time);
		UTWinTextAt(x + 14, y + 136, line, ut_col_white);
		StrPrint(line, "Cap Limit: %d  [- / +]", ut_menu_cap);
		UTWinTextAt(x + 14, y + 156, line, ut_col_white);
		if (ut_menu_balance)
			StrPrint(line, "Balance Teams: ON  (click)");
		else
			StrPrint(line, "Balance Teams: OFF (click)");
		UTWinTextAt(x + 200, y + 156, line, ut_col_white);
		UTWinTextAt(x + 14, y + 184, "[ Start Match ]", ut_col_sel);
		UTWinTextAt(x + 160, y + 184, "[ Mutators ]", ut_col_label);
		UTWinTextAt(x + 280, y + 184, "[ Map List ]", ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_PLAYER)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Player Setup");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		StrPrint(line, "Name: %s", ut_player_name);
		UTWinTextAt(x + 14, y + 36, line, ut_col_white);
		StrPrint(line, "Team: %d  (click cycle 0-3)", ut_player_team);
		UTWinTextAt(x + 14, y + 56, line, ut_col_white);
		StrPrint(line, "Skin: %s  (click)",
			ut_player_skin_names[ut_player_skin & 3]);
		UTWinTextAt(x + 14, y + 76, line, ut_col_white);
		UTWinTextAt(x + 14, y + 100, "Click rows to edit. Esc closes.",
			ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_MUTATORS)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Configure Mutators");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		UTWinTextAt(x + 14, y + 36, "Available (package Class scan)",
			ut_col_label);
		UTWinTextAt(x + 220, y + 36, "Used", ut_col_label);
		i = 0;
		while (i < ut_menu_mut_n && i < 8)
		{
			col = ut_col_label;
			if (i == ut_menu_mut_sel)
				col = ut_col_sel;
			UTWinTextAt(x + 14, y + 52 + i * 14, ut_menu_mut_names[i], col);
			i++;
		}
		i = 0;
		while (i < ut_menu_mut_used_n && i < 8)
		{
			UTWinTextAt(x + 220, y + 52 + i * 14, ut_menu_mut_used[i],
				ut_col_white);
			i++;
		}
		UTWinTextAt(x + 14, y + h - 40, "Click = toggle into Used",
			ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_SCOREBOARD)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Scoreboard Setup");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		if (ut_sb_frags_on)
			StrPrint(line, "Show Frags: ON  (click)");
		else
			StrPrint(line, "Show Frags: OFF (click)");
		UTWinTextAt(x + 14, y + 40, line, ut_col_white);
		if (ut_sb_deaths_on)
			StrPrint(line, "Show Deaths: ON  (click)");
		else
			StrPrint(line, "Show Deaths: OFF (click)");
		UTWinTextAt(x + 14, y + 60, line, ut_col_white);
		if (ut_sb_bot_scores)
			StrPrint(line, "Bot Scores: ON  (click)");
		else
			StrPrint(line, "Bot Scores: OFF (click)");
		UTWinTextAt(x + 14, y + 80, line, ut_col_white);
		UTWinTextAt(x + 14, y + 110, "TAB in-game shows scoreboard.",
			ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_BROWSER)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Find Internet Games");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		UTWinTextAt(x + 14, y + 40, "Servers: 0  (IpDrv absent)",
			ut_col_white);
		if (ut_listen_active)
			StrPrint(line, "[ Local Listen ] ON  port=%d  %s",
				ut_listen_port, ut_listen_map);
		else
			StrPrint(line, "[ Local Listen ] OFF (click)");
		UTWinTextAt(x + 14, y + 60, line, ut_col_sel);
		UTWinTextAt(x + 14, y + 80, "[ Practice Session ] → Botmatch",
			ut_col_sel);
		UTWinTextAt(x + 14, y + 100,
			"Listen = host flag only; no sockets.", ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_SAVE ||
		ut_uwin_client_mode == UT_UWIN_MODE_LOAD)
	{
		if (ut_uwin_client_mode == UT_UWIN_MODE_SAVE)
			UTWinDrawLAFFrame(x, y, w, h, "Save Game");
		else
			UTWinDrawLAFFrame(x, y, w, h, "Load Game");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		if (ut_uwin_client_mode == UT_UWIN_MODE_SAVE &&
			(!ut_game_ready || !ut_alive))
			UTWinTextAt(x + 14, y + 40, "Cannot Save: You are dead.",
				ut_col_sel);
		i = 0;
		while (i < 9)
		{
			if (ut_save_slot_used[i])
				StrPrint(line, "%d: %s", i, ut_save_slot_label[i]);
			else
				StrPrint(line, "%d: Empty Slot", i);
			UTWinTextAt(x + 14, y + 56 + i * 18, line, ut_col_white);
			i++;
		}
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_QUIT)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Confirm Quit");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		UTWinTextAt(x + 14, y + 50, "Are you sure you want to quit?",
			ut_col_white);
		UTWinTextAt(x + 40, y + 90, "[ Yes ]", ut_col_sel);
		UTWinTextAt(x + 140, y + 90, "[ No ]", ut_col_sel);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_ADMIN)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Admin");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		StrPrint(line, "Bots: %d / %d", ut_bot_count, UT_GM_BOT_MAX);
		UTWinTextAt(x + 14, y + 40, line, ut_col_white);
		StrPrint(line, "Frag Limit: %d  [- / +]", ut_frag_limit);
		UTWinTextAt(x + 14, y + 60, line, ut_col_white);
		StrPrint(line, "PathNodes: %d  Lights: %d", ut_path_n, ut_light_n);
		UTWinTextAt(x + 14, y + 80, line, ut_col_label);
		UTWinTextAt(x + 14, y + 110, "[ +Bot ]", ut_col_sel);
		UTWinTextAt(x + 100, y + 110, "[ KickAll ]", ut_col_sel);
		UTWinTextAt(x + 14, y + 140, "[ Restart Map ]", ut_col_sel);
		UTWinTextAt(x + 160, y + 140, "[ God ]", ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_MAPLIST)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Map List");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		UTWinTextAt(x + 14, y + 36, "Filter: All DM CTF DOM AS (click)",
			ut_col_label);
		StrPrint(line, "n=%d scr=%d", ut_map_cat_n, ut_uwin_maplist_scroll);
		UTWinTextAt(x + 280, y + 36, line, ut_col_dim);
		i = 0;
		row = 0;
		col = 0;
		while (i < ut_map_cat_n && col < 10)
		{
			if (ut_uwin_maplist_filter < 0 ||
				ut_map_cat[i].mode == ut_uwin_maplist_filter)
			{
				if (row >= ut_uwin_maplist_scroll)
				{
					tx = ut_col_white;
					if (i == ut_map_cat_i)
						tx = ut_col_sel;
					StrPrint(line, "%s", ut_map_cat[i].name);
					UTWinTextAt(x + 14, y + 56 + col * 16, line, tx);
					col++;
				}
				row++;
			}
			i++;
		}
		UTWinTextAt(x + 14, y + h - 40, "[ Prev ]  [ Next ]  click = load",
			ut_col_label);
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_WEAPONS)
	{
		UTWinDrawLAFFrame(x, y, w, h, "Weapons Priority");
		UTWinFill(x + 6, y + 22, w - 12, h - 52, ut_col_laf_client);
		UTWinTextAt(x + 14, y + 36, "Click row = switch to weapon",
			ut_col_label);
		i = 0;
		while (i < ut_uwin_weap_n && i < 12)
		{
			row = ut_uwin_weap_pri[i];
			col = ut_col_white;
			if (row == ut_weap_cur)
				col = ut_col_sel;
			StrPrint(line, "%d  %s  ammo=%d", i + 1,
				ut_weap_def[row].name, ut_weap_ammo[row]);
			UTWinTextAt(x + 14, y + 56 + i * 16, line, col);
			i++;
		}
		UTWinTextAt(x + 14, y + h - 24, "Close", ut_col_dim);
		return;
	}

	UTWinDrawLAFFrame(x, y, w, h, "Preferences");
	tabs[0] = "Game";
	tabs[1] = "Video";
	tabs[2] = "Audio";
	tabs[3] = "Controls";
	tabs[4] = "HUD";
	tx = x + 8;
	i = 0;
	while (i < 5)
	{
		if (i == ut_uwin_opt_tab)
			UTWinFill(tx, y + 22, 64, 16, ut_col_sel);
		UTWinTextAt(tx + 4, y + 24, tabs[i], ut_col_white);
		tx += 68;
		i++;
	}
	UTWinFill(x + 6, y + 40, w - 12, h - 70, ut_col_laf_client);
	if (ut_uwin_opt_tab == 0)
	{
		StrPrint(line, "Brightness: %d%%  [click - / +]",
			ToI64(ut_opt_brightness * 100.0));
		UTWinTextAt(x + 14, y + 50, line, ut_col_white);
		UTWinTextAt(x + 14, y + 70, "[-] darker", ut_col_label);
		UTWinTextAt(x + 120, y + 70, "[+] brighter", ut_col_label);
		if (ut_menu_weapons_stay)
			StrPrint(line, "Weapons Stay: ON  (click)");
		else
			StrPrint(line, "Weapons Stay: OFF (click)");
		UTWinTextAt(x + 14, y + 94, line, ut_col_white);
		if (ut_menu_force_respawn)
			StrPrint(line, "Force Respawn: ON  (click)");
		else
			StrPrint(line, "Force Respawn: OFF (click)");
		UTWinTextAt(x + 14, y + 114, line, ut_col_white);
		if (ut_menu_tournament)
			StrPrint(line, "Tournament: ON  (click)");
		else
			StrPrint(line, "Tournament: OFF (click)");
		UTWinTextAt(x + 14, y + 134, line, ut_col_white);
		if (ut_menu_friendly_fire)
			StrPrint(line, "Friendly Fire: ON  (click)");
		else
			StrPrint(line, "Friendly Fire: OFF (click)");
		UTWinTextAt(x + 14, y + 154, line, ut_col_white);
	}
	else if (ut_uwin_opt_tab == 1)
	{
		rw = ut_res_w[ut_opt_res];
		rh = ut_res_h[ut_opt_res];
		if (rw < 1) rw = UT_SCR_W;
		if (rh < 1) rh = UT_SCR_H;
		StrPrint(line, "Resolution: %dx%d  (slot %d)", rw, rh, ut_opt_res);
		UTWinTextAt(x + 14, y + 50, line, ut_col_white);
		UTWinTextAt(x + 14, y + 70, "Click body = cycle SoftDrv canvas.", ut_col_label);
		UTWinTextAt(x + 14, y + 90, "SoftDrv software renderer.", ut_col_label);
	}
	else if (ut_uwin_opt_tab == 2)
	{
		if (ut_opt_music)
			StrPrint(line, "Music: ON  (click to toggle)");
		else
			StrPrint(line, "Music: OFF (click to toggle)");
		UTWinTextAt(x + 14, y + 50, line, ut_col_white);
		StrPrint(line, "SFX Vol: %d%%  [click - / +]",
			ToI64(ut_opt_sfx * 100.0));
		UTWinTextAt(x + 14, y + 70, line, ut_col_white);
		UTWinTextAt(x + 14, y + 94, "Galaxy / host mixer + UTMusic.",
			ut_col_label);
	}
	else if (ut_uwin_opt_tab == 3)
	{
		StrPrint(line, "Mouse Sens: %d%%  [click - / +]",
			ToI64(ut_opt_mouse * 100.0));
		UTWinTextAt(x + 14, y + 50, line, ut_col_white);
		UTWinTextAt(x + 14, y + 70, "[-] slower", ut_col_label);
		UTWinTextAt(x + 120, y + 70, "[+] faster", ut_col_label);
		UTWinTextAt(x + 14, y + 94, "WASD + mouse look; Esc = UWindow.",
			ut_col_label);
	}
	else if (ut_uwin_opt_tab == 4)
	{
		StrPrint(line, "HUD Scale: %d%%  [click - / +]",
			ToI64(ut_opt_hud * 100.0));
		UTWinTextAt(x + 14, y + 50, line, ut_col_white);
		UTWinTextAt(x + 14, y + 70, "[-] smaller", ut_col_label);
		UTWinTextAt(x + 120, y + 70, "[+] larger", ut_col_label);
		if (ut_opt_crosshair)
			StrPrint(line, "Crosshair: ON  style=%d (click)",
				ut_opt_cross_style);
		else
			StrPrint(line, "Crosshair: OFF style=%d (click)",
				ut_opt_cross_style);
		UTWinTextAt(x + 14, y + 94, line, ut_col_white);
		UTWinTextAt(x + 14, y + 114, "Click body = cycle style / toggle",
			ut_col_label);
	}
	col = ut_col_dim;
	UTWinTextAt(x + 14, y + h - 24, "Close", col);
	no_warn col;
}

U0 UTUWinApplyBrightness()
{//Map ut_opt_brightness → SoftDrv FlashScale (128 = identity).
	F64 s;

	if (ut_opt_brightness < 0.4)
		ut_opt_brightness = 0.4;
	if (ut_opt_brightness > 1.6)
		ut_opt_brightness = 1.6;
	s = 128.0 * ut_opt_brightness;
	UTSoftSetFlash(s, s, s, 0.0, 0.0, 0.0);
}

U0 UTUWinPaintNode(CUTUWinNode *n)
{//Single window Paint — kind dispatch (BeforePaint/Paint/AfterPaint stand-in).
	if (!n || !n->visible)
		return;
	if (n->kind == UT_UWIN_KIND_ROOT)
		UTUWinPaintRoot(n);
	else if (n->kind == UT_UWIN_KIND_MENUBAR)
		UTUWinPaintMenuBar(n);
	else if (n->kind == UT_UWIN_KIND_PULLDOWN)
		UTUWinPaintPulldown(n);
	else if (n->kind == UT_UWIN_KIND_CLIENT)
		UTUWinPaintClient(n);
	else if (n->kind == UT_UWIN_KIND_STATUS)
	{
		UTWinFill(n->x, n->y, n->w, n->h, ut_col_menubar);
		UTWinTextAt(n->x + 8, n->y + 2, "Version 436", ut_col_white);
	}
}

U0 UTUWinPaintClients(I64 parent_i)
{//UWindowWindow.PaintClients — FirstChildWindow → NextSiblingWindow.
 //Sets child.ClippingRegion; pushes OrgX/OrgY/ClipX/ClipY.
	I64 child;
	I64 guard;
	I64 rel_x;
	I64 rel_y;
	I64 cw;
	I64 ch;
	I64 save_org_x;
	I64 save_org_y;
	I64 save_clip_x;
	I64 save_clip_y;
	CUTUWinNode *n;
	CUTUWinNode *p;
	CUTUWinRegion *cr;
	CUTUWinRegion *pr;

	if (parent_i < 0 || parent_i >= ut_uwin_node_n)
		return;
	p = &ut_uwin_node[parent_i];
	pr = &p->clip_region;
	save_org_x = ut_win.org_x;
	save_org_y = ut_win.org_y;
	save_clip_x = ut_win.clip_x;
	save_clip_y = ut_win.clip_y;
	child = p->first_child;
	guard = 0;
	while (child >= 0 && child < ut_uwin_node_n && guard < UT_UWIN_NODE_MAX)
	{
		guard++;
		n = &ut_uwin_node[child];
		if (n->visible)
		{
			UTWinSetStyle(UT_STY_NORMAL);
			UTWinSetDrawColor(255, 255, 255);
			rel_x = n->x - p->x;
			rel_y = n->y - p->y;
			if (rel_x < 0) rel_x = 0;
			if (rel_y < 0) rel_y = 0;
			cw = p->w - rel_x;
			ch = p->h - rel_y;
			if (cw > n->w) cw = n->w;
			if (ch > n->h) ch = n->h;
			if (cw > save_clip_x - rel_x)
				cw = save_clip_x - rel_x;
			if (ch > save_clip_y - rel_y)
				ch = save_clip_y - rel_y;

			cr = &n->clip_region;
			if (!n->no_clip)
			{
				//UWindowWindow.PaintClients ClippingRegion translate
				cr->x = pr->x - rel_x;
				cr->y = pr->y - rel_y;
				cr->w = pr->w;
				cr->h = pr->h;
				if (cr->x < 0)
				{
					cr->w = cr->w + cr->x;
					cr->x = 0;
				}
				if (cr->y < 0)
				{
					cr->h = cr->h + cr->y;
					cr->y = 0;
				}
				if (cr->w > n->w - cr->x)
					cr->w = n->w - cr->x;
				if (cr->h > n->h - cr->y)
					cr->h = n->h - cr->y;
			}
			else
			{
				cr->x = 0;
				cr->y = 0;
				cr->w = n->w;
				cr->h = n->h;
			}

			if (cr->w > 0 && cr->h > 0 && cw > 0 && ch > 0)
			{
				UTWinPushClip(save_org_x + rel_x + cr->x,
					save_org_y + rel_y + cr->y,
					cr->w, cr->h);
				UTUWinPaintNode(n);
				UTUWinPaintClients(child);
				UTWinPopClip;
			}
			ut_win.org_x = save_org_x;
			ut_win.org_y = save_org_y;
		}
		child = n->next_sib;
	}
	ut_win.clip_x = save_clip_x;
	ut_win.clip_y = save_clip_y;
}

U0 UTUWinRenderUWindow(CUTCanvas *c)
{//WindowConsole.RenderUWindow — root Paint then PaintClients tree
	CUTUWinNode *n;

	if (!c || ut_uwin_root < 0)
		return;
	UTWinReset;
	if (ut_win_ready)
		ut_win.fb = c;

	n = &ut_uwin_node[ut_uwin_root];
	n->clip_region.x = 0;
	n->clip_region.y = 0;
	n->clip_region.w = n->w;
	n->clip_region.h = n->h;
	UTWinSetStyle(UT_STY_NORMAL);
	UTWinSetDrawColor(255, 255, 255);
	UTUWinPaintRoot(n);
	UTUWinPaintClients(ut_uwin_root);

	//Canvas native probe — keep Exec warm for script Paint path
	UTUWinTryExec(ut_uwin_pkg_uwindow, "Paint", 64);
	UTUWinTryExec(ut_uwin_pkg_uwindow, "RenderUWindow", 64);
}

U0 UTUWinDrawCursor(CUTCanvas *c)
{//UWindow.DrawMouse — masked MouseCursor (index0 hole) or poly arrow.
	I64 x;
	I64 y;
	I64 dw;
	I64 dh;

	if (!c)
		return;
	x = ut_uwin_mouse_x;
	y = ut_uwin_mouse_y;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x >= c->width) x = c->width - 1;
	if (y >= c->height) y = c->height - 1;

	if (ut_uwin_cursor_ok && ut_uwin_cursor.mips[0].pixels)
	{
		if (ut_win_ready)
			ut_win.fb = c;
		dw = ut_uwin_cursor.u_size;
		dh = ut_uwin_cursor.v_size;
		if (dw > 32) dw = 32;
		if (dh > 32) dh = 32;
		//UTWinDrawTile: index 0 masked (arrow on transparent)
		UTWinDrawTile(&ut_uwin_cursor, x, y, dw, dh,
			0, 0, ut_uwin_cursor.u_size, ut_uwin_cursor.v_size);
		return;
	}
	UTClientDrawCursor(c);
}

U0 UTUWinDraw(CUTCanvas *c)
{
	if (!c || !ut_uwin_active)
		return;
	UTUWinRenderUWindow(c);
	UTUWinDrawCursor(c);
}

U0 UTUWinUpdateMouse()
{
	I64 i;
	CUTUWinNode *pd;
	I64 py;

	if (!ut_canvas)
		return;
	//Hover hit-tests use soft cursor (UTUWinMsMove). mouse.pos frozen under MouseRaw.

	ut_uwin_over = -1;
	if (ut_uwin_mouse_y >= 0 && ut_uwin_mouse_y < 16)
	{
		i = 0;
		while (i < ut_uwin_bar_n)
		{
			if (ut_uwin_mouse_x >= ut_uwin_bar[i].x &&
				ut_uwin_mouse_x < ut_uwin_bar[i].x + ut_uwin_bar[i].w)
			{
				ut_uwin_over = i;
				break;
			}
			i++;
		}
	}
	if (ut_uwin_pulldown >= 0 && ut_uwin_node[ut_uwin_pulldown].visible)
	{
		pd = &ut_uwin_node[ut_uwin_pulldown];
		i = 0;
		while (i < ut_uwin_pull_n)
		{
			py = pd->y + 4 + i * 16;
			if (ut_uwin_pull_caps[i][0] != '-' &&
				ut_uwin_mouse_y >= py &&
				ut_uwin_mouse_y < py + 16 &&
				ut_uwin_mouse_x >= pd->x &&
				ut_uwin_mouse_x < pd->x + pd->w)
				ut_uwin_pull_sel = i;
			i++;
		}
	}
}

U0 UTUWinExecutePull()
{//UTGameMenu / UTOptionsMenu / Multiplayer / Tools ExecuteItem subset
	U8 *cap;

	if (ut_uwin_pull_sel < 0 || ut_uwin_pull_sel >= ut_uwin_pull_n)
		return;
	cap = ut_uwin_pull_caps[ut_uwin_pull_sel];
	if (cap[0] == '-')
		return;

	if (ut_uwin_pull_bar == UT_UWIN_BAR_GAME)
	{
		if (!StrCompare(cap, "Quit"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowQuitConfirm;
			return;
		}
		if (!StrCompare(cap, "Save Game"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowSaveGame;
			return;
		}
		if (!StrCompare(cap, "Load Game") ||
			!StrCompare(cap, "Resume Saved Tournament"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowLoadGame;
			return;
		}
		if (!StrCompare(cap, "Start Practice Session"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowBotmatch;
			return;
		}
		if (!StrCompare(cap, "Start Unreal Tournament") ||
			!StrCompare(cap, "Return to Current Game"))
		{
			UTClientStartMatch;
			UTUWinDeactivate;
			return;
		}
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_OPT)
	{
		if (!StrCompare(cap, "Preferences"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowPreferences;
			return;
		}
		if (!StrCompare(cap, "Player Setup"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowPlayerSetup;
			return;
		}
		if (!StrCompare(cap, "Weapons"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowWeapons;
			return;
		}
		if (!StrCompare(cap, "Scoreboard Setup"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowScoreboardSetup;
			return;
		}
		if (!StrCompare(cap, "Show Desktop"))
		{
			ut_uwin_desktop = !ut_uwin_desktop;
			UTLog("UTUWin: ShowDesktop=%d\n", ToI64(ut_uwin_desktop));
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			return;
		}
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_MP)
	{
		if (!StrCompare(cap, "Start New Multiplayer Game") ||
			!StrCompare(cap, "Start Practice Session") ||
			!StrCompare(cap, "Start Multiplayer Game"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowBotmatch;
			return;
		}
		if (!StrCompare(cap, "Get Botpack") ||
			!StrCompare(cap, "Check for Botpack Updates") ||
			!StrCompare(cap, "Disconnect") ||
			!StrCompare(cap, "Reconnect") ||
			!StrCompare(cap, "Disconnect from Server") ||
			!StrCompare(cap, "Reconnect to Server") ||
			!StrCompare(cap, "Download Latest Update"))
		{
			UTUWinShowBrowser;
			return;
		}
		if (!StrCompare(cap, "Join Multiplayer Game") ||
			!StrCompare(cap, "Find Internet Games") ||
			!StrCompare(cap, "Find LAN Games") ||
			!StrCompare(cap, "Open Location"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowBrowser;
			return;
		}
		UTLog("UTUWin: Multiplayer '%s' → browser stub\n", cap);
		UTUWinShowBrowser;
		return;
	}
	else if (ut_uwin_pull_bar == UT_UWIN_BAR_TOOLS)
	{
		if (!StrCompare(cap, "System Console"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowConsole;
			return;
		}
		if (!StrCompare(cap, "TimeDemo Statistics"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTTimeDemoToggle;
			UTUWinDeactivate;
			return;
		}
		else if (!StrCompare(cap, "Show Log"))
		{
			UTLog("UTUWin: Show Log — dump SoftDrv client gaps\n");
			UTClientProbeGaps;
			UTClientBuildGapNote;
			UTLog("UTUWin: gaps=%02X %s\n",
				ut_client_gap_mask, ut_client_gap_note);
		}
		else if (!StrCompare(cap, "Admin"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowAdmin;
			return;
		}
		else if (!StrCompare(cap, "Map List"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowMapList;
			return;
		}
		else if (!StrCompare(cap, "Voice Menu"))
		{
			if (ut_uwin_pulldown >= 0)
				ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
			UTUWinShowVoice;
			return;
		}
	}

	if (ut_uwin_pulldown >= 0)
		ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
	ut_uwin_selected = -1;
}

Bool UTUWinClientClick()
{//Preferences / Botmatch / close. TRUE if click consumed.
	CUTUWinNode *win;
	I64 x;
	I64 y;
	I64 w;
	I64 h;
	I64 tx;
	I64 i;
	I64 mx;
	I64 my;
	I64 row;
	I64 col;

	if (ut_uwin_client < 0 || !ut_uwin_node[ut_uwin_client].visible)
		return FALSE;
	win = &ut_uwin_node[ut_uwin_client];
	x = win->x;
	y = win->y;
	w = win->w;
	h = win->h;
	mx = ut_uwin_mouse_x;
	my = ut_uwin_mouse_y;
	if (mx < x || mx >= x + w || my < y || my >= y + h)
		return FALSE;
	if (my >= y + h - 28)
	{
		UTUWinCloseClient;
		return TRUE;
	}

	if (ut_uwin_client_mode == UT_UWIN_MODE_BOTMATCH)
	{
		row = (my - (y + 36)) / 20;
		if (row == 0)
		{
			ut_menu_mode++;
			if (ut_menu_mode > 4)
				ut_menu_mode = 0;
			UTMenuApplyFilter;
			return TRUE;
		}
		if (row == 1)
		{
			UTMapCycle(1);
			return TRUE;
		}
		if (row == 2)
		{
			if (mx < x + w / 2)
				ut_menu_frag -= 5;
			else
				ut_menu_frag += 5;
			if (ut_menu_frag < 5)
				ut_menu_frag = 5;
			if (ut_menu_frag > 100)
				ut_menu_frag = 100;
			return TRUE;
		}
		if (row == 3)
		{
			if (mx < x + w / 2)
				ut_menu_bots--;
			else
				ut_menu_bots++;
			if (ut_menu_bots < 0)
				ut_menu_bots = 0;
			if (ut_menu_bots > UT_GM_BOT_MAX)
				ut_menu_bots = UT_GM_BOT_MAX;
			return TRUE;
		}
		if (row == 4)
		{
			if (mx < x + w / 2)
				ut_menu_bot_skill--;
			else
				ut_menu_bot_skill++;
			if (ut_menu_bot_skill < 0)
				ut_menu_bot_skill = 0;
			if (ut_menu_bot_skill > 7)
				ut_menu_bot_skill = 7;
			return TRUE;
		}
		if (row == 5)
		{
			if (mx < x + w / 2)
				ut_menu_time -= 5;
			else
				ut_menu_time += 5;
			if (ut_menu_time < 0)
				ut_menu_time = 0;
			if (ut_menu_time > 60)
				ut_menu_time = 60;
			return TRUE;
		}
		if (row == 6)
		{
			if (mx >= x + 190)
				ut_menu_balance = !ut_menu_balance;
			else if (mx < x + w / 2)
				ut_menu_cap--;
			else
				ut_menu_cap++;
			if (ut_menu_cap < 1)
				ut_menu_cap = 1;
			if (ut_menu_cap > 50)
				ut_menu_cap = 50;
			return TRUE;
		}
		if (my >= y + 180 && my < y + 200)
		{
			if (mx >= x + 270)
			{
				UTUWinShowMapList;
				return TRUE;
			}
			if (mx >= x + 150)
			{
				UTUWinShowMutators;
				return TRUE;
			}
			ut_frag_limit = ut_menu_frag;
			ut_bot_count = ut_menu_bots;
			ut_time_limit = ut_menu_time;
			UTUWinCloseClient;
			UTClientStartMatch;
			UTUWinDeactivate;
			return TRUE;
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_PLAYER)
	{
		row = (my - (y + 36)) / 20;
		if (row == 0)
		{
			//Cycle name suffix
			if (!StrCompare(ut_player_name, "Player"))
				StrPrint(ut_player_name, "Player2");
			else if (!StrCompare(ut_player_name, "Player2"))
				StrPrint(ut_player_name, "Xan");
			else
				StrPrint(ut_player_name, "Player");
			return TRUE;
		}
		if (row == 1)
		{
			ut_player_team++;
			if (ut_player_team > 3)
				ut_player_team = 0;
			return TRUE;
		}
		if (row == 2)
		{
			ut_player_skin++;
			if (ut_player_skin > 3)
				ut_player_skin = 0;
			//Reload LodMesh skin class when SoftDrv ready
			if (ut_lod_zeroed)
			{
				UTLodLoadNamed("::/Apps/UT99/System/Botpack.u",
					ut_player_skin_names[ut_player_skin],
					&ut_lod_player);
				if (!ut_lod_player.loaded)
					UTLodLoadNamed("::/Apps/UT99/System/UnrealShare.u",
						ut_player_skin_names[ut_player_skin],
						&ut_lod_player);
				if (ut_lod_player.loaded)
					UTLodSetSeqFirst(&ut_lod_player);
			}
			return TRUE;
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_MUTATORS)
	{
		row = (my - (y + 52)) / 14;
		if (row >= 0 && row < ut_menu_mut_n && row < 8)
		{
			ut_menu_mut_sel = row;
			if (ut_menu_mut_used_bit[row])
				ut_menu_mut_used_bit[row] = FALSE;
			else
				ut_menu_mut_used_bit[row] = TRUE;
			ut_menu_mut_used_n = 0;
			i = 0;
			while (i < ut_menu_mut_n && ut_menu_mut_used_n < UT_MENU_MUT_N)
			{
				if (ut_menu_mut_used_bit[i])
				{
					StrPrint(ut_menu_mut_used[ut_menu_mut_used_n], "%s",
						ut_menu_mut_names[i]);
					ut_menu_mut_used_n++;
				}
				i++;
			}
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_SCOREBOARD)
	{
		row = (my - (y + 40)) / 20;
		if (row == 0)
			ut_sb_frags_on = !ut_sb_frags_on;
		else if (row == 1)
			ut_sb_deaths_on = !ut_sb_deaths_on;
		else if (row == 2)
			ut_sb_bot_scores = !ut_sb_bot_scores;
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_BROWSER)
	{
		if (my >= y + 55 && my < y + 75)
		{
			ut_listen_active = !ut_listen_active;
			if (ut_listen_active)
			{
				UTLog("UTUWin: Local Listen ON port=%d map=%s\n",
					ut_listen_port, ut_listen_map);
				UTUWinShowBotmatch;
			}
			else
				UTLog("UTUWin: Local Listen OFF\n");
			return TRUE;
		}
		if (my >= y + 75 && my < y + 95)
		{
			UTUWinShowBotmatch;
			return TRUE;
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_SAVE ||
		ut_uwin_client_mode == UT_UWIN_MODE_LOAD)
	{
		row = (my - (y + 56)) / 18;
		if (row >= 0 && row < 9)
		{
			if (ut_uwin_client_mode == UT_UWIN_MODE_SAVE)
			{
				if (UTSaveWrite(row))
				{
					UTUWinDeactivate;
					return TRUE;
				}
			}
			else
			{
				if (UTSaveLoad(row))
				{
					UTClientStartMatch;
					UTUWinDeactivate;
					return TRUE;
				}
			}
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_QUIT)
	{
		if (my >= y + 85 && my < y + 105)
		{
			if (mx < x + 120)
			{
				ut_menu_quit = TRUE;
				UTUWinDeactivate;
			}
			else
				UTUWinDeactivate;
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_ADMIN)
	{
		if (my >= y + 55 && my < y + 75)
		{
			if (mx < x + w / 2)
				ut_frag_limit -= 5;
			else
				ut_frag_limit += 5;
			if (ut_frag_limit < 5)
				ut_frag_limit = 5;
			if (ut_frag_limit > 100)
				ut_frag_limit = 100;
			return TRUE;
		}
		if (my >= y + 105 && my < y + 125)
		{
			if (mx < x + 90)
				UTGameAddBots(1);
			else
			{
				i = 0;
				while (i < UT_GM_BOT_MAX)
				{
					ut_bots[i].alive = FALSE;
					i++;
				}
				ut_bot_count = 0;
			}
			return TRUE;
		}
		if (my >= y + 135 && my < y + 155)
		{
			if (mx < x + 150)
			{
				if (ut_map_name[0])
					UTClientTravel(ut_map_name);
				UTUWinDeactivate;
			}
			else
				ut_god = !ut_god;
			return TRUE;
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_MAPLIST)
	{
		if (my >= y + 36 && my < y + 52)
		{
			ut_uwin_maplist_filter++;
			if (ut_uwin_maplist_filter > UT_MAP_MODE_AS)
				ut_uwin_maplist_filter = -1;
			ut_uwin_maplist_scroll = 0;
			return TRUE;
		}
		if (my >= y + h - 44 && my < y + h - 28)
		{
			if (mx < x + 80)
			{
				ut_uwin_maplist_scroll -= 5;
				if (ut_uwin_maplist_scroll < 0)
					ut_uwin_maplist_scroll = 0;
			}
			else
				ut_uwin_maplist_scroll += 5;
			return TRUE;
		}
		row = (my - (y + 56)) / 16;
		if (row >= 0 && row < 10)
		{
			i = 0;
			col = 0;
			while (i < ut_map_cat_n)
			{
				if (ut_uwin_maplist_filter < 0 ||
					ut_map_cat[i].mode == ut_uwin_maplist_filter)
				{
					if (col == ut_uwin_maplist_scroll + row)
					{
						ut_map_filter = ut_uwin_maplist_filter;
						UTMapLoadCatalogIndex(i);
						UTClientTravel(ut_map_cat[i].name);
						UTUWinDeactivate;
						return TRUE;
					}
					col++;
				}
				i++;
			}
		}
		return TRUE;
	}
	if (ut_uwin_client_mode == UT_UWIN_MODE_WEAPONS)
	{
		row = (my - (y + 56)) / 16;
		if (row >= 0 && row < ut_uwin_weap_n)
		{
			UTWeapSelect(ut_uwin_weap_pri[row]);
			return TRUE;
		}
		return TRUE;
	}

	if (my >= y + 22 && my < y + 38)
	{
		tx = x + 8;
		i = 0;
		while (i < 5)
		{
			if (mx >= tx && mx < tx + 64)
			{
				ut_uwin_opt_tab = i;
				return TRUE;
			}
			tx += 68;
			i++;
		}
	}
	if (my >= y + 40 && my < y + h - 28)
	{
		if (ut_uwin_opt_tab == 0)
		{
			if (my >= y + 148)
				ut_menu_friendly_fire = !ut_menu_friendly_fire;
			else if (my >= y + 128)
				ut_menu_tournament = !ut_menu_tournament;
			else if (my >= y + 108)
				ut_menu_force_respawn = !ut_menu_force_respawn;
			else if (my >= y + 88)
				ut_menu_weapons_stay = !ut_menu_weapons_stay;
			else if (mx < x + 100)
				ut_opt_brightness -= 0.1;
			else
				ut_opt_brightness += 0.1;
			UTUWinApplyBrightness;
			return TRUE;
		}
		if (ut_uwin_opt_tab == 1)
		{
			ut_opt_res++;
			if (ut_opt_res >= UT_RES_COUNT)
				ut_opt_res = 0;
			ut_res_dirty = TRUE;
			return TRUE;
		}
		if (ut_uwin_opt_tab == 2)
		{
			if (my < y + 64)
			{
				if (ut_opt_music)
				{
					ut_opt_music = FALSE;
					UTMusicStop;
				}
				else
				{
					ut_opt_music = TRUE;
					UTMusicStart;
				}
			}
			else
			{
				if (mx < x + 100)
					ut_opt_sfx -= 0.1;
				else
					ut_opt_sfx += 0.1;
				if (ut_opt_sfx < 0.0)
					ut_opt_sfx = 0.0;
				if (ut_opt_sfx > 1.5)
					ut_opt_sfx = 1.5;
			}
			return TRUE;
		}
		if (ut_uwin_opt_tab == 3)
		{
			if (mx < x + 100)
				ut_opt_mouse -= 0.1;
			else
				ut_opt_mouse += 0.1;
			if (ut_opt_mouse < 0.2)
				ut_opt_mouse = 0.2;
			if (ut_opt_mouse > 3.0)
				ut_opt_mouse = 3.0;
			return TRUE;
		}
		if (ut_uwin_opt_tab == 4)
		{
			if (my >= y + 108)
			{
				ut_opt_cross_style++;
				if (ut_opt_cross_style > 3)
					ut_opt_cross_style = 0;
			}
			else if (my >= y + 88)
				ut_opt_crosshair = !ut_opt_crosshair;
			else if (mx < x + 100)
				ut_opt_hud -= 0.1;
			else
				ut_opt_hud += 0.1;
			if (ut_opt_hud < 0.5)
				ut_opt_hud = 0.5;
			if (ut_opt_hud > 2.0)
				ut_opt_hud = 2.0;
			return TRUE;
		}
	}
	return TRUE;
}

U0 UTUWinKeyEvent(I64 key, Bool down)
{//WindowConsole.KeyEvent / Root KeyFocus — subset
	if (!down)
		return;
	UTUWinTryExec(ut_uwin_pkg_uwindow, "KeyEvent", 32);
	if (key == SC_ESC)
	{
		if (ut_uwin_client >= 0 && ut_uwin_node[ut_uwin_client].visible)
			UTUWinCloseClient;
		else if (ut_uwin_pulldown >= 0 &&
			ut_uwin_node[ut_uwin_pulldown].visible)
		{
			ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			ut_uwin_selected = -1;
		}
		else
		{
			ut_menu_quit = TRUE;
			UTUWinDeactivate;
		}
	}
}

U0 UTUWinPoll()
{
	Bool esc;
	Bool enter;
	Bool up;
	Bool down;
	Bool quitk;
	Bool lmb;

	if (!ut_uwin_active)
	{
		esc = Bt(kbd.down_bitmap, SC_ESC);
		quitk = Bt(kbd.down_bitmap, Char2ScanCode('q'));
		if (esc)
		{
			if (!ut_uwin_latched && !ut_menu_fake_laf &&
				ut_uwin_ready)
			{
				ut_uwin_latched = TRUE;
				UTUWinActivate;
			}
		}
		else if (quitk)
		{
			if (!ut_uwin_latched)
			{
				ut_uwin_latched = TRUE;
				ut_menu_quit = TRUE;
			}
		}
		else
			ut_uwin_latched = FALSE;
		return;
	}

	UTUWinUpdateMouse;
	UTUWinTryExec(ut_uwin_pkg_uwindow, "MouseMove", 32);
	//UWindow Tick/Paint with RootWindow Self bag
	if (ut_obj_root >= 0)
	{
		UTVMCallSelf("Tick", ut_obj_root, &ut_obj[ut_obj_root].bag, 64);
		UTVMCallSelf("Paint", ut_obj_root, &ut_obj[ut_obj_root].bag, 64);
	}
	else
		UTUWinTryExec(ut_uwin_pkg_uwindow, "Tick", 32);

	lmb = mouse_hard.bttns[0];
	if (lmb)
	{
		if (!ut_uwin_mb_latched)
		{
			ut_uwin_mb_latched = TRUE;
			if (UTUWinClientClick)
			{
				//Preferences ate the click
			}
			else if (ut_uwin_pulldown >= 0 &&
				ut_uwin_node[ut_uwin_pulldown].visible &&
				ut_uwin_mouse_y >= 16)
				UTUWinExecutePull;
			else if (ut_uwin_over >= 0)
				UTUWinOpenBar(ut_uwin_over);
			else
			{
				ut_uwin_selected = -1;
				if (ut_uwin_pulldown >= 0)
					ut_uwin_node[ut_uwin_pulldown].visible = FALSE;
			}
		}
	}
	else
		ut_uwin_mb_latched = FALSE;

	esc = Bt(kbd.down_bitmap, SC_ESC);
	quitk = Bt(kbd.down_bitmap, Char2ScanCode('q'));
	if (esc)
	{
		if (!ut_uwin_latched)
		{
			ut_uwin_latched = TRUE;
			UTUWinKeyEvent(SC_ESC, TRUE);
		}
	}
	else if (quitk)
	{
		if (!ut_uwin_latched)
		{
			ut_uwin_latched = TRUE;
			ut_menu_quit = TRUE;
			UTUWinDeactivate;
		}
	}
	else
		ut_uwin_latched = FALSE;

	up = Bt(kbd.down_bitmap, SC_CURSOR_UP) ||
		 Bt(kbd.down_bitmap, Char2ScanCode('w'));
	down = Bt(kbd.down_bitmap, SC_CURSOR_DOWN) ||
		   Bt(kbd.down_bitmap, Char2ScanCode('s'));
	enter = Bt(kbd.down_bitmap, SC_ENTER) ||
			Bt(kbd.down_bitmap, Char2ScanCode(' '));

	if (up || down || enter)
	{
		if (!ut_uwin_nav_latched)
		{
			ut_uwin_nav_latched = TRUE;
			if (ut_uwin_pulldown >= 0 &&
				ut_uwin_node[ut_uwin_pulldown].visible)
			{
				if (up)
				{
					ut_uwin_pull_sel--;
					if (ut_uwin_pull_sel < 0)
						ut_uwin_pull_sel = ut_uwin_pull_n - 1;
					while (ut_uwin_pull_sel >= 0 &&
						ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
						ut_uwin_pull_sel--;
					if (ut_uwin_pull_sel < 0)
						ut_uwin_pull_sel = 0;
				}
				else if (down)
				{
					ut_uwin_pull_sel++;
					if (ut_uwin_pull_sel >= ut_uwin_pull_n)
						ut_uwin_pull_sel = 0;
					while (ut_uwin_pull_sel < ut_uwin_pull_n &&
						ut_uwin_pull_caps[ut_uwin_pull_sel][0] == '-')
						ut_uwin_pull_sel++;
					if (ut_uwin_pull_sel >= ut_uwin_pull_n)
						ut_uwin_pull_sel = 0;
				}
				else if (enter)
					UTUWinExecutePull;
			}
			else if (enter)
			{
				UTUWinOpenBar(0);
			}
		}
	}
	else
		ut_uwin_nav_latched = FALSE;
}
