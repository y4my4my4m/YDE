// WindowConsole / UTConsole host (SoftDrv in-game console).
// Tilde/` opens. Non-blocking Char2ScanCode edge poll (QuakePlus QCon shape).

#define UT_CON_LINES		32
#define UT_CON_WIDTH		78
#define UT_CON_INPUT_MAX	72
#define UT_CON_HIST		16

Bool	ut_con_open		= FALSE;
U8	ut_con_text[UT_CON_LINES * (UT_CON_WIDTH + 2)];
I64	ut_con_line		= 0;
U8	ut_con_input[UT_CON_INPUT_MAX + 2];
I64	ut_con_input_len	= 0;
U8	ut_con_hist[UT_CON_HIST * (UT_CON_INPUT_MAX + 2)];
I64	ut_con_edit_line	= 0;
I64	ut_con_hist_line	= 0;
U8	ut_con_key_prev[256];
Bool	ut_con_want_quit	= FALSE;
Bool	ut_god			= FALSE;
Bool	ut_fly			= FALSE;
Bool	ut_ghost		= FALSE;
F64	ut_con_fov		= 90.0;
Bool	ut_behind_view		= FALSE;
Bool	ut_spectate		= FALSE;
I64	ut_view_target		= -1;	//-1 self/free; 0..bots chase

extern Bool	ut_menu_quit;
extern Bool	ut_uwin_active;
extern U0	UTUWinDumpTree();	//def in UTUWin (after this file)
extern Bool	ut_uwin_script_paint;
extern U0	UTUWinShowConsole();
extern U0	UTClientTravel(U8 *url);
extern Bool	ut_menu_weapons_stay;
extern Bool	ut_menu_force_respawn;
extern Bool	ut_menu_tournament;
extern I64	ut_menu_bot_skill;
extern Bool	ut_menu_friendly_fire;
extern Bool	ut_menu_balance;
U8 *ut_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ./_";

U0 UTConClear()
{
	I64 i;

	i = 0;
	while (i < UT_CON_LINES)
	{
		ut_con_text[i * (UT_CON_WIDTH + 2)] = 0;
		i++;
	}
	ut_con_line = 0;
	ut_con_input[0] = 0;
	ut_con_input_len = 0;
	i = 0;
	while (i < 256)
	{
		ut_con_key_prev[i] = 0;
		i++;
	}
}

U0 UTConPrint(U8 *msg)
{
	U8 *row;
	I64 n;

	if (!msg)
		return;
	row = ut_con_text + (ut_con_line % UT_CON_LINES) * (UT_CON_WIDTH + 2);
	n = StrLen(msg);
	if (n > UT_CON_WIDTH)
		n = UT_CON_WIDTH;
	MemCopy(row, msg, n);
	row[n] = 0;
	ut_con_line++;
	UTLog("UTCon: %s\n", msg);
}

U0 UTConToggle()
{
	ut_con_open = !ut_con_open;
	if (ut_con_open)
	{
		ut_con_input[0] = 0;
		ut_con_input_len = 0;
		UTConPrint("---- console ----");
	}
}

Bool UTConKeyEdge(I64 sc)
{
	Bool down;
	Bool was;

	if (sc < 0 || sc > 255)
		return FALSE;
	down = Bt(kbd.down_bitmap, sc) != 0;
	was = ut_con_key_prev[sc] != 0;
	ut_con_key_prev[sc] = down;
	if (down && !was)
		return TRUE;
	return FALSE;
}

U0 UTConHistoryPush()
{
	U8 *dst;

	dst = &ut_con_hist[ut_con_edit_line * (UT_CON_INPUT_MAX + 2)];
	StrPrint(dst, "%s", ut_con_input);
	ut_con_edit_line = (ut_con_edit_line + 1) % UT_CON_HIST;
	ut_con_hist_line = ut_con_edit_line;
}

U0 UTConHistoryRecall(I64 line)
{
	U8 *src;

	if (line < 0 || line >= UT_CON_HIST)
		return;
	src = &ut_con_hist[line * (UT_CON_INPUT_MAX + 2)];
	StrPrint(ut_con_input, "%s", src);
	ut_con_input_len = StrLen(ut_con_input);
}

U0 UTConExec(U8 *line)
{
	U8 cmd[80];
	U8 arg[64];
	U8 msg[96];
	I64 i;
	I64 n;

	if (!line || !line[0])
		return;
	cmd[0] = 0;
	arg[0] = 0;
	i = 0;
	while (line[i] && line[i] != ' ' && i < 78)
	{
		cmd[i] = line[i];
		i++;
	}
	cmd[i] = 0;
	while (line[i] == ' ')
		i++;
	n = 0;
	while (line[i] && n < 62)
	{
		arg[n] = line[i];
		n++;
		i++;
	}
	arg[n] = 0;

	if (!StrCompare(cmd, "quit") || !StrCompare(cmd, "exit"))
	{
		ut_con_want_quit = TRUE;
		ut_menu_quit = TRUE;
		UTConPrint("quit");
		return;
	}
	if (!StrCompare(cmd, "scriptactors"))
	{
		ut_script_actors = !ut_script_actors;
		if (ut_script_actors)
			UTConPrint("script actors ON");
		else
			UTConPrint("script actors OFF");
		return;
	}
	if (!StrCompare(cmd, "scriptgame"))
	{
		ut_script_gameinfo = !ut_script_gameinfo;
		if (ut_script_gameinfo)
			UTConPrint("script gameinfo ON");
		else
			UTConPrint("script gameinfo OFF");
		return;
	}
	if (!StrCompare(cmd, "scriptbots"))
	{
		ut_script_bots = !ut_script_bots;
		if (ut_script_bots)
			UTConPrint("script bots ON");
		else
			UTConPrint("script bots OFF");
		return;
	}
	if (!StrCompare(cmd, "uwintree"))
	{
		UTUWinDumpTree;
		return;
	}
	if (!StrCompare(cmd, "scriptpaint"))
	{
		ut_uwin_script_paint = !ut_uwin_script_paint;
		if (ut_uwin_script_paint)
			UTConPrint("script paint ON");
		else
			UTConPrint("script paint OFF");
		return;
	}
	if (!StrCompare(cmd, "nests"))
	{
		ut_bsp_portals_on = !ut_bsp_portals_on;
		if (ut_bsp_portals_on)
			UTConPrint("portal/mirror nests ON (costs a frame each)");
		else
			UTConPrint("portal/mirror nests OFF");
		return;
	}
	if (!StrCompare(cmd, "sky"))
	{
		ut_bsp_sky_on = !ut_bsp_sky_on;
		if (ut_bsp_sky_on)
			UTConPrint("sky nest ON");
		else
			UTConPrint("sky nest OFF");
		return;
	}
	if (!StrCompare(cmd, "tcworld"))
	{
		ut_draw_truecolor = !ut_draw_truecolor;
		if (ut_draw_truecolor)
			UTConPrint("truecolor world ON");
		else
			UTConPrint("truecolor world OFF");
		return;
	}
	if (!StrCompare(cmd, "scriptweap"))
	{
		ut_script_weapons = !ut_script_weapons;
		if (ut_script_weapons)
			UTConPrint("script weapons ON");
		else
			UTConPrint("script weapons OFF");
		return;
	}
	if (!StrCompare(cmd, "god"))
	{
		ut_god = !ut_god;
		if (ut_god)
			UTConPrint("godmode ON");
		else
			UTConPrint("godmode OFF");
		return;
	}
	if (!StrCompare(cmd, "fly"))
	{
		ut_fly = !ut_fly;
		if (ut_fly)
			UTConPrint("fly ON");
		else
			UTConPrint("fly OFF");
		return;
	}
	if (!StrCompare(cmd, "ghost") || !StrCompare(cmd, "walk"))
	{
		ut_ghost = !ut_ghost;
		if (ut_ghost)
			UTConPrint("ghost ON");
		else
			UTConPrint("ghost OFF");
		return;
	}
	if (!StrCompare(cmd, "kill") || !StrCompare(cmd, "suicide"))
	{
		if (ut_alive)
			UTGameKillPlayer;
		UTConPrint("suicide");
		return;
	}
	if (!StrCompare(cmd, "behindview"))
	{
		ut_behind_view = !ut_behind_view;
		if (ut_behind_view)
			UTConPrint("behindview ON");
		else
			UTConPrint("behindview OFF");
		return;
	}
	if (!StrCompare(cmd, "spectate") || !StrCompare(cmd, "spec"))
	{
		ut_spectate = !ut_spectate;
		if (ut_spectate)
		{
			ut_ghost = TRUE;
			ut_fly = TRUE;
			ut_god = TRUE;
			ut_view_target = -1;
			UTConPrint("spectate ON (ghost fly)");
		}
		else
		{
			ut_ghost = FALSE;
			ut_fly = FALSE;
			ut_view_target = -1;
			UTConPrint("spectate OFF");
		}
		return;
	}
	if (!StrCompare(cmd, "viewbot") || !StrCompare(cmd, "viewclass"))
	{
		if (arg[0])
			ut_view_target = Str2I64(arg);
		else
			UTGameViewCycle(1);
		StrPrint(msg, "viewtarget %d", ut_view_target);
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "addbots") || !StrCompare(cmd, "addbot"))
	{
		n = 1;
		if (arg[0])
			n = Str2I64(arg);
		if (n < 1)
			n = 1;
		if (n > 4)
			n = 4;
		UTGameAddBots(n);
		StrPrint(msg, "addbots %d (count=%d)", n, ut_bot_count);
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "players") || !StrCompare(cmd, "scoreboard"))
	{
		UTGamePlayersDump;
		return;
	}
	if (!StrCompare(cmd, "restart"))
	{
		if (ut_map_name[0])
			UTClientTravel(ut_map_name);
		else
			UTClientTravel("start");
		UTConPrint("restart");
		return;
	}
	if (!StrCompare(cmd, "switchweapon") || !StrCompare(cmd, "weapon"))
	{
		if (arg[0])
		{
			n = Str2I64(arg);
			UTWeapSelect(n);
		}
		else
			UTWeapCycle(1);
		StrPrint(msg, "weapon %d", ut_weap_cur);
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "summon") || !StrCompare(cmd, "give"))
	{
		if (!StrCompare(arg, "all") || !arg[0])
		{
			ut_health = 199.0;
			ut_ammo = 999;
			UTWeapGiveAll;
			UTConPrint("give all");
		}
		else if (!StrCompare(arg, "health"))
		{
			ut_health = 199.0;
			UTConPrint("give health");
		}
		else if (!StrCompare(arg, "ammo"))
		{
			ut_ammo = 999;
			UTConPrint("give ammo");
		}
		else
			UTConPrint("give: all|health|ammo");
		return;
	}
	if (!StrCompare(cmd, "fov"))
	{
		if (arg[0])
			ut_con_fov = Str2F64(arg);
		if (ut_con_fov < 30.0)
			ut_con_fov = 30.0;
		if (ut_con_fov > 120.0)
			ut_con_fov = 120.0;
		StrPrint(msg, "fov %d", ToI64(ut_con_fov));
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "brightness") || !StrCompare(cmd, "gamma"))
	{
		if (arg[0])
			ut_opt_brightness = Str2F64(arg);
		if (ut_opt_brightness < 0.3)
			ut_opt_brightness = 0.3;
		if (ut_opt_brightness > 2.0)
			ut_opt_brightness = 2.0;
		StrPrint(msg, "brightness %.2f", ut_opt_brightness);
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "music"))
	{
		if (!StrCompare(arg, "stop"))
		{
			UTMusicStop;
			UTConPrint("music stop");
		}
		else if (!StrCompare(arg, "off"))
		{
			ut_opt_music = FALSE;
			UTMusicFadeTo(0.0, 1.0);
			UTConPrint("music off");
		}
		else if (!StrCompare(arg, "on"))
		{
			ut_opt_music = TRUE;
			UTMusicFadeTo(0.70, 1.0);
			UTMusicStart;
			UTConPrint("music on");
		}
		else if (arg[0])
		{
			if (UTMusicPlayNamed(arg))
			{
				StrPrint(msg, "music %s", arg);
				UTConPrint(msg);
			}
			else
				UTConPrint("music: not found");
		}
		else
			UTConPrint("music: on|off|stop|<name>");
		return;
	}
	if (!StrCompare(cmd, "demorec") || !StrCompare(cmd, "record"))
	{
		if (!arg[0])
			StrPrint(arg, "demo0");
		if (UTDemoRecStart(arg))
		{
			StrPrint(msg, "recording %s", arg);
			UTConPrint(msg);
		}
		else
			UTConPrint("demorec failed");
		return;
	}
	if (!StrCompare(cmd, "stopdemo") || !StrCompare(cmd, "stop"))
	{
		UTDemoRecStop;
		UTDemoStop;
		UTConPrint("demo stopped");
		return;
	}
	if (!StrCompare(cmd, "demoplay") || !StrCompare(cmd, "playdemo"))
	{
		if (!arg[0])
			StrPrint(arg, "demo0");
		if (UTDemoPlayStart(arg))
		{
			StrPrint(msg, "playing %s", arg);
			UTConPrint(msg);
		}
		else
			UTConPrint("demoplay failed");
		return;
	}
	if (!StrCompare(cmd, "timedemo"))
	{
		UTTimeDemoToggle;
		UTConPrint("timedemo toggled");
		return;
	}
	if (!StrCompare(cmd, "reconnect") || !StrCompare(cmd, "open"))
	{
		if (arg[0])
			UTClientTravel(arg);
		else
			UTConPrint("open <mapurl>");
		return;
	}
	if (!StrCompare(cmd, "say"))
	{
		if (arg[0])
		{
			StrPrint(msg, "say: %s", arg);
			UTConPrint(msg);
			UTMsgCenter(arg);
		}
		else
			UTConPrint("say <text>");
		return;
	}
	if (!StrCompare(cmd, "teamsay") || !StrCompare(cmd, "tsay"))
	{
		if (!arg[0])
		{
			UTConPrint("teamsay <text>");
			return;
		}
		if (!(ut_ctf_active || ut_dom_active || ut_as_active))
		{
			UTConPrint("teamsay: not a team game");
			return;
		}
		StrPrint(msg, "team: %s", arg);
		UTConPrint(msg);
		UTMsgCenter(msg);
		return;
	}
	if (!StrCompare(cmd, "autoaim"))
	{
		ut_opt_autoaim = !ut_opt_autoaim;
		if (ut_opt_autoaim)
			UTConPrint("autoaim ON");
		else
			UTConPrint("autoaim OFF");
		return;
	}
	if (!StrCompare(cmd, "viewbob") || !StrCompare(cmd, "bob"))
	{
		ut_opt_viewbob = !ut_opt_viewbob;
		if (ut_opt_viewbob)
			UTConPrint("viewbob ON");
		else
			UTConPrint("viewbob OFF");
		return;
	}
	if (!StrCompare(cmd, "dropflag") || !StrCompare(cmd, "drop"))
	{
		if (ut_player_flag >= 0)
		{
			UTCTFDropFlag;
			UTConPrint("flag dropped");
		}
		else
			UTConPrint("no flag");
		return;
	}
	if (!StrCompare(cmd, "aircontrol"))
	{
		ut_opt_aircontrol = !ut_opt_aircontrol;
		if (ut_opt_aircontrol)
			UTConPrint("aircontrol ON");
		else
			UTConPrint("aircontrol OFF");
		return;
	}
	if (!StrCompare(cmd, "pathdraw") || !StrCompare(cmd, "showpath"))
	{
		ut_opt_pathdraw = !ut_opt_pathdraw;
		if (ut_opt_pathdraw)
			UTConPrint("pathdraw ON");
		else
			UTConPrint("pathdraw OFF");
		return;
	}
	if (!StrCompare(cmd, "beams"))
	{
		ut_opt_beams = !ut_opt_beams;
		if (ut_opt_beams)
			UTConPrint("beams ON");
		else
			UTConPrint("beams OFF");
		return;
	}
	if (!StrCompare(cmd, "showhud") || !StrCompare(cmd, "hud"))
	{
		ut_opt_hud_on = !ut_opt_hud_on;
		if (ut_opt_hud_on)
			UTConPrint("hud ON");
		else
			UTConPrint("hud OFF");
		return;
	}
	if (!StrCompare(cmd, "weaponsstay") || !StrCompare(cmd, "weaponstay"))
	{
		ut_weapons_stay = !ut_weapons_stay;
		ut_menu_weapons_stay = ut_weapons_stay;
		if (ut_weapons_stay)
			UTConPrint("weaponsstay ON");
		else
			UTConPrint("weaponsstay OFF");
		return;
	}
	if (!StrCompare(cmd, "forcerespawn") || !StrCompare(cmd, "forcespawn"))
	{
		ut_force_respawn = !ut_force_respawn;
		ut_menu_force_respawn = ut_force_respawn;
		if (ut_force_respawn)
			UTConPrint("forcerespawn ON");
		else
			UTConPrint("forcerespawn OFF");
		return;
	}
	if (!StrCompare(cmd, "tournament"))
	{
		ut_tournament = !ut_tournament;
		ut_menu_tournament = ut_tournament;
		if (ut_tournament)
		{
			ut_force_respawn = TRUE;
			ut_weapons_stay = FALSE;
			UTConPrint("tournament ON");
		}
		else
			UTConPrint("tournament OFF");
		return;
	}
	if (!StrCompare(cmd, "botskill") || !StrCompare(cmd, "skill"))
	{
		if (arg[0])
			ut_bot_skill = Str2I64(arg);
		else
			ut_bot_skill++;
		if (ut_bot_skill < 0)
			ut_bot_skill = 0;
		if (ut_bot_skill > 7)
			ut_bot_skill = 0;
		ut_menu_bot_skill = ut_bot_skill;
		ut_bot_sight = 1800.0 * (0.45 + ToF64(ut_bot_skill) * 0.12);
		ut_bot_shot_cd = 0.85 * (1.45 - ToF64(ut_bot_skill) * 0.12);
		if (ut_bot_shot_cd < 0.35)
			ut_bot_shot_cd = 0.35;
		StrPrint(msg, "botskill %d", ut_bot_skill);
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "crosshair") || !StrCompare(cmd, "cross"))
	{
		if (!StrCompare(arg, "off"))
			ut_opt_crosshair = FALSE;
		else if (!StrCompare(arg, "on"))
			ut_opt_crosshair = TRUE;
		else
		{
			ut_opt_cross_style++;
			if (ut_opt_cross_style > 3)
				ut_opt_cross_style = 0;
			ut_opt_crosshair = TRUE;
		}
		StrPrint(msg, "crosshair style=%d on=%d",
			ut_opt_cross_style, ToI64(ut_opt_crosshair));
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "friendlyfire") || !StrCompare(cmd, "ff"))
	{
		ut_friendly_fire = !ut_friendly_fire;
		ut_menu_friendly_fire = ut_friendly_fire;
		if (ut_friendly_fire)
			UTConPrint("friendlyfire ON");
		else
			UTConPrint("friendlyfire OFF");
		return;
	}
	if (!StrCompare(cmd, "balanceteams") || !StrCompare(cmd, "balance"))
	{
		ut_balance_teams = !ut_balance_teams;
		ut_menu_balance = ut_balance_teams;
		if (ut_balance_teams)
			UTConPrint("balanceteams ON");
		else
			UTConPrint("balanceteams OFF");
		return;
	}
	if (!StrCompare(cmd, "stat") || !StrCompare(cmd, "status"))
	{
		StrPrint(msg, "hp=%.0f ammo=%d frags=%d path=%d corona=%d",
			ut_health, ut_ammo, ut_frags, ut_path_n, ToI64(ut_fx_corona_on));
		UTConPrint(msg);
		return;
	}
	if (!StrCompare(cmd, "corona"))
	{
		ut_fx_corona_on = !ut_fx_corona_on;
		if (ut_fx_corona_on)
			UTConPrint("corona ON");
		else
			UTConPrint("corona OFF");
		return;
	}
	if (!StrCompare(cmd, "help") || !StrCompare(cmd, "?"))
	{
		UTConPrint("god fly ghost kill give fov music demorec demoplay");
		UTConPrint("behindview spectate viewbot addbots players restart");
		UTConPrint("switchweapon corona weaponsstay forcerespawn");
		UTConPrint("tournament botskill crosshair friendlyfire balance");
		UTConPrint("autoaim viewbob dropflag aircontrol pathdraw beams hud");
		UTConPrint("stopdemo timedemo open say teamsay quit");
		return;
	}
	StrPrint(msg, "unknown: %s", cmd);
	UTConPrint(msg);
}

U0 UTConPoll()
{
	I64 i;
	I64 sc;
	U8 ch;
	Bool shift;

	if (UTConKeyEdge(Char2ScanCode('`')) ||
		UTConKeyEdge(Char2ScanCode('~')))
	{
		if (!ut_uwin_active)
			UTConToggle;
		return;
	}
	if (!ut_con_open)
		return;

	if (UTConKeyEdge(SC_ESC))
	{
		ut_con_open = FALSE;
		return;
	}
	if (UTConKeyEdge(SC_ENTER))
	{
		UTConPrint(ut_con_input);
		UTConHistoryPush;
		UTConExec(ut_con_input);
		ut_con_input[0] = 0;
		ut_con_input_len = 0;
		return;
	}
	if (UTConKeyEdge(SC_BACKSPACE) && ut_con_input_len > 0)
	{
		ut_con_input_len--;
		ut_con_input[ut_con_input_len] = 0;
		return;
	}
	if (UTConKeyEdge(SC_CURSOR_UP))
	{
		ut_con_hist_line--;
		if (ut_con_hist_line < 0)
			ut_con_hist_line = UT_CON_HIST - 1;
		UTConHistoryRecall(ut_con_hist_line);
		return;
	}
	if (UTConKeyEdge(SC_CURSOR_DOWN))
	{
		ut_con_hist_line++;
		if (ut_con_hist_line >= UT_CON_HIST)
			ut_con_hist_line = 0;
		UTConHistoryRecall(ut_con_hist_line);
		return;
	}
	shift = Bt(kbd.down_bitmap, SC_SHIFT) != 0;
	i = 0;
	while (ut_con_charset[i])
	{
		ch = ut_con_charset[i];
		sc = Char2ScanCode(ch);
		if (UTConKeyEdge(sc) && ut_con_input_len < UT_CON_INPUT_MAX)
		{
			if (shift && ch >= 'a' && ch <= 'z')
				ch = ch - 'a' + 'A';
			ut_con_input[ut_con_input_len] = ch;
			ut_con_input_len++;
			ut_con_input[ut_con_input_len] = 0;
		}
		i++;
	}
	if (UTConKeyEdge(Char2ScanCode('-')) && ut_con_input_len < UT_CON_INPUT_MAX)
	{
		if (shift)
			ut_con_input[ut_con_input_len] = '_';
		else
			ut_con_input[ut_con_input_len] = '-';
		ut_con_input_len++;
		ut_con_input[ut_con_input_len] = 0;
	}
}

U0 UTConDraw(CUTCanvas *c)
{
	I64 h;
	I64 y;
	I64 i;
	I64 idx;
	U8 *row;
	U8 line[96];

	if (!ut_con_open || !c || !ut_win_ready)
		return;
	ut_win.fb = c;
	h = c->height / 3;
	if (h < 80)
		h = 80;
	UTWinFill(0, 0, c->width, h, ut_col_black);
	UTWinTextAt(4, 4, "UTConsole", ut_col_sel);
	y = 18;
	i = UT_CON_LINES - 1;
	while (i >= 0 && y < h - 20)
	{
		idx = (ut_con_line - 1 - i + UT_CON_LINES * 8) % UT_CON_LINES;
		row = ut_con_text + idx * (UT_CON_WIDTH + 2);
		if (row[0])
			UTWinTextAt(4, y, row, ut_col_white);
		y += 12;
		i--;
	}
	StrPrint(line, "] %s_", ut_con_input);
	UTWinTextAt(4, h - 16, line, ut_col_sel);
}
