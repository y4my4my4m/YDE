// UTSoft.ZC - USoftwareRenderDevice (SoftDrv.cpp / UnRenDev.h).
//
// SoftDrv.dll absent from Ut99PubSrc. ZealC clean-room of v200 SoftDrv body:
// Init SpanBased=1, Lock/Unlock, DrawGouraudPolygon, DrawTile, DrawComplexSurface,
// ClearZ. Engine/Canvas calls SoftDrv. No OpenGLDrv / D3DDrv / XMesaGLDrv.

#define UT_LOCKR_CLEAR_SCREEN	1
#define UT_LOCKR_LIGHT_DIMINISH	2

#define UT_PF_MASKED		0x00000002
#define UT_PF_TRANSLUCENT	0x00000004
#define UT_PF_MODULATED		0x00000040
#define UT_PF_TWO_SIDED		0x00000100

//SoftDrv color depths (SoftDrvPrivate.h). ZealOS CDC body = ARGB32 only.
#define UT_SOFT_DEPTH_P8	1
#define UT_SOFT_DEPTH_15	2
#define UT_SOFT_DEPTH_16	3
#define UT_SOFT_DEPTH_32	4

extern Bool	ut_zone_in_water;
extern Bool	ut_zone_in_hurt;
extern F64	ut_zone_fog;
extern F64	ut_invis_until;
extern F64	ut_armor_belt;
extern F64	ut_damage_scale;
extern F64	ut_health;
extern I64	ut_player_flag;
extern I64	ut_ammo;
extern F64	ut_bot_grace_until;

class CUTSoftDev
{//USoftwareRenderDevice facts from SoftDrvPrivate.h / SoftDrv.cpp::Init
	Bool	span_based;			//= TRUE (SoftDrv SpanBased=1)
	Bool	frame_buffered;		//= TRUE
	Bool	fullscreen_only;
	Bool	supports_fog_maps;
	Bool	locked;
	I64		lock_flags;
	I64		frame_locks;		//SoftDrv FrameLocksCounter
	I64		color_depth;		//internal raster = P8; display path = 32
	I64		display_bpp;		//=32 ZealOS CDC ARGB
	F64		flash_scale_r;		//SoftDrv FlashScale; 128 = normal
	F64		flash_scale_g;
	F64		flash_scale_b;
	F64		flash_fog_r;		//SoftDrv FlashFog; 0 = none
	F64		flash_fog_g;
	F64		flash_fog_b;
	CUTCanvas	*canvas;
	CUTSpanBuf	 span;			//screen open FSpanBuffer
	I64		stat_complex;
	I64		stat_gouraud;
	I64		stat_tile;
	I64		stat_line;
	I64		stat_point;
};

CUTSoftDev ut_soft;
Bool        ut_soft_ready = FALSE;

U0 UTSoftInit(CUTCanvas *c)
{//USoftwareRenderDevice::Init
 //ZealOS shows ARGB32 CDC only — no 15/16 framebuffer surface.
 //Internal SoftDrv raster stays P8; Unlock blit = P8→ARGB via Flash32 pal.
	ut_soft.span_based         = TRUE;
	ut_soft.frame_buffered     = TRUE;
	ut_soft.fullscreen_only    = FALSE;
	ut_soft.supports_fog_maps  = TRUE;
	ut_soft.locked             = FALSE;
	ut_soft.lock_flags         = 0;
	ut_soft.frame_locks        = 0;
	ut_soft.color_depth        = UT_SOFT_DEPTH_P8;
	ut_soft.display_bpp        = 32;
	ut_soft.flash_scale_r      = 128.0;
	ut_soft.flash_scale_g      = 128.0;
	ut_soft.flash_scale_b      = 128.0;
	ut_soft.flash_fog_r        = 0.0;
	ut_soft.flash_fog_g        = 0.0;
	ut_soft.flash_fog_b        = 0.0;
	ut_soft.canvas             = c;
	ut_soft.stat_complex       = 0;
	ut_soft.stat_gouraud       = 0;
	ut_soft.stat_tile          = 0;
	ut_soft.stat_line          = 0;
	ut_soft.stat_point         = 0;
	if (c)
		UTSpanClear(&ut_soft.span, c->width, c->height);
	ut_soft_ready = TRUE;
	UTLog("UTSoft: Init P8 raster display_bpp=%d (ZealOS CDC ARGB32)\n",
		ut_soft.display_bpp);
}

U0 UTSoftExit()
{//USoftwareRenderDevice::Exit
	ut_soft.locked      = FALSE;
	ut_soft.canvas      = NULL;
	ut_soft_ready       = FALSE;
}

Bool UTSoftLock(I64 flags, I64 clear_color)
{//USoftwareRenderDevice::Lock — SoftDrv.cpp
	CUTCanvas *c;

	if (!ut_soft_ready || !ut_soft.canvas)
		return FALSE;
	c = ut_soft.canvas;
	ut_soft.lock_flags = flags;
	ut_soft.locked     = TRUE;
	ut_soft.frame_locks++;
	if (flags & UT_LOCKR_CLEAR_SCREEN)
		UTDrawClear(c, clear_color);
	//AllocIndexForScreen each frame: full open before OccludeBsp / draw.
	UTSpanClear(&ut_soft.span, c->width, c->height);
	ut_soft.stat_complex = 0;
	ut_soft.stat_gouraud = 0;
	ut_soft.stat_tile    = 0;
	ut_soft.stat_line    = 0;
	ut_soft.stat_point   = 0;
	return TRUE;
}

U0 UTSoftSetFlash(F64 scale_r, F64 scale_g, F64 scale_b,
	F64 fog_r, F64 fog_g, F64 fog_b)
{//SoftDrv Lock FlashScale/FlashFog — 128 scale = identity; fog 0..255.
	ut_soft.flash_scale_r = scale_r;
	ut_soft.flash_scale_g = scale_g;
	ut_soft.flash_scale_b = scale_b;
	ut_soft.flash_fog_r = fog_r;
	ut_soft.flash_fog_g = fog_g;
	ut_soft.flash_fog_b = fog_b;
}

F64	ut_soft_dmg_flash_t	= 0.0;	//until tS
F64	ut_soft_dmg_flash_a	= 0.0;	//0..1 red fog strength

U0 UTSoftDamageFlash(F64 amount)
{//= PlayerPawn ViewFlash on pain — red FlashFog burst
	F64 a;

	a = amount / 40.0;
	if (a < 0.15) a = 0.15;
	if (a > 1.0) a = 1.0;
	ut_soft_dmg_flash_a = a;
	ut_soft_dmg_flash_t = tS + 0.35;
}

U0 UTSoftTickFlash()
{//Decay damage flash into SoftDrv FlashFog
	F64 a;
	F64 br;
	F64 fog;

	br = 128.0 * ut_opt_brightness;
	if (br < 64.0) br = 64.0;
	if (br > 200.0) br = 200.0;
	fog = 0.0;
	a = 0.0;
	if (tS < ut_soft_dmg_flash_t)
	{
		a = ut_soft_dmg_flash_a *
			(ut_soft_dmg_flash_t - tS) / 0.35;
		fog = a * 90.0;
	}
	else
		ut_soft_dmg_flash_a = 0.0;
	//UViewport::Lock — neutral is FlashScale identity, FlashFog zero:
	//  FlashScale = ScreenFlashes ? 0.5*Actor->FlashScale : (0.5,0.5,0.5)
	//  FlashFog   = ScreenFlashes ? Actor->FlashFog       : (0,0,0)
	//PlayerPawn drives it from DesiredFlashScale/Fog (transient, decaying),
	//ConstantGlow, and the zone's ViewFlash/ViewFog. Health, ammo, armor,
	//flag and spawn-grace tints are not part of it; keying the whole screen
	//to those recoloured every frame.
	if (a > 0.0)
		UTSoftSetFlash(br, br, br, fog, fog * 0.25, fog * 0.15);
	else if (ut_zone_in_water)
		UTSoftSetFlash(br, br, br, 0.0, 6.0, 14.0);	//Zone ViewFog
	else if (ut_zone_in_hurt)
		UTSoftSetFlash(br, br, br, 14.0, 3.0, 0.0);	//Zone ViewFog
	else
		UTSoftSetFlash(br, br, br, 0.0, 0.0, 0.0);
}

U0 UTSoftApplyFlash(CDC *dc)
{//Post-blit FlashScale/FlashFog on ARGB32 CDC (SoftDrv Lock flash).
 //Scale 128 = identity. Fog added after scale. No-op when neutral.
	I64 n;
	I64 i;
	U32 *p;
	I64 r;
	I64 g;
	I64 b;
	I64 sr;
	I64 sg;
	I64 sb;
	Bool identity;

	if (!dc || !dc->body)
		return;
	identity = (ut_soft.flash_scale_r == 128.0 &&
		ut_soft.flash_scale_g == 128.0 &&
		ut_soft.flash_scale_b == 128.0 &&
		ut_soft.flash_fog_r == 0.0 &&
		ut_soft.flash_fog_g == 0.0 &&
		ut_soft.flash_fog_b == 0.0);
	if (identity)
		return;
	n = dc->width_internal * dc->height;
	p = dc->body;
	i = 0;
	while (i < n)
	{
		r = (p[i] >> 16) & 255;
		g = (p[i] >> 8) & 255;
		b = p[i] & 255;
		sr = ToI64(ToF64(r) * ut_soft.flash_scale_r / 128.0 +
			ut_soft.flash_fog_r);
		sg = ToI64(ToF64(g) * ut_soft.flash_scale_g / 128.0 +
			ut_soft.flash_fog_g);
		sb = ToI64(ToF64(b) * ut_soft.flash_scale_b / 128.0 +
			ut_soft.flash_fog_b);
		if (sr > 255) sr = 255;
		if (sg > 255) sg = 255;
		if (sb > 255) sb = 255;
		if (sr < 0) sr = 0;
		if (sg < 0) sg = 0;
		if (sb < 0) sb = 0;
		p[i] = (sr << 16) | (sg << 8) | sb;
		i++;
	}
}

U0 UTSoftUnlock()
{//USoftwareRenderDevice::Unlock — SoftDrv blit is separate draw_it
	ut_soft.locked = FALSE;
}

U0 UTSoftClearZ()
{//USoftwareRenderDevice::ClearZ — SoftDrv empty; host clears depth buffer.
	CUTCanvas *c;
	I64 n;
	I64 i;

	if (!ut_soft.locked || !ut_soft.canvas)
		return;
	c = ut_soft.canvas;
	if (!c->depth)
		return;
	n = c->width * c->height;
	i = 0;
	while (i < n)
	{
		c->depth[i] = 0.0;
		i++;
	}
}

U0 UTSoftDrawGouraudTri(F64 *a, F64 *b, F64 *cc,
	F64 au, F64 av, F64 bu, F64 bv, F64 cu, F64 cv, CUTTex *tex)
{//USoftwareRenderDevice::DrawGouraudPolygon, one triangle (fan unit)
	if (!ut_soft.locked || !ut_soft.canvas || !tex)
		return;
	UTDrawTriTex3(ut_soft.canvas, a, b, cc, au, av, bu, bv, cu, cv,
		tex, &ut_soft.span);
	ut_soft.stat_gouraud++;
}

U0 UTSoftDrawTile(CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	F64 u0, F64 v0, F64 uw, F64 vh, F64 z)
{//USoftwareRenderDevice::DrawTile — opaque / masked default
	if (!ut_soft.locked || !ut_soft.canvas || !tex)
		return;
	ut_draw_poly_flags = 0;
	UTDrawTile(ut_soft.canvas, tex, x, y, w, h, u0, v0, uw, vh, z,
		&ut_soft.span);
	ut_soft.stat_tile++;
}

U0 UTSoftDrawTileFlags(CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	F64 u0, F64 v0, F64 uw, F64 vh, F64 z, I64 poly_flags)
{//DrawTile with PolyFlags — PF_Translucent / PF_Modulated SoftDrv path
	if (!ut_soft.locked || !ut_soft.canvas || !tex)
		return;
	ut_draw_poly_flags = poly_flags;
	UTDrawTile(ut_soft.canvas, tex, x, y, w, h, u0, v0, uw, vh, z, NULL);
	ut_draw_poly_flags = 0;
	ut_soft.stat_tile++;
}

U0 UTSoftDraw2DLine(I64 x0, I64 y0, I64 x1, I64 y1, I64 color)
{//USoftwareRenderDevice::Draw2DLine
	if (!ut_soft.locked || !ut_soft.canvas)
		return;
	UTDrawLine2(ut_soft.canvas, x0, y0, x1, y1, color);
	ut_soft.stat_line++;
}

U0 UTSoftDraw2DPoint(I64 x1, I64 y1, I64 x2, I64 y2, I64 color)
{//USoftwareRenderDevice::Draw2DPoint — axis-aligned fill (Line2D.cpp).
	I64 x;
	I64 y;
	I64 t;
	CUTCanvas *c;

	if (!ut_soft.locked || !ut_soft.canvas)
		return;
	c = ut_soft.canvas;
	if (x2 < x1)
	{
		t = x1; x1 = x2; x2 = t;
	}
	if (y2 < y1)
	{
		t = y1; y1 = y2; y2 = t;
	}
	if (x1 < 0) x1 = 0;
	if (y1 < 0) y1 = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	y = y1;
	while (y < y2)
	{
		x = x1;
		while (x < x2)
		{
			UTDrawPlot(c, x, y, 1.0, color);
			x++;
		}
		y++;
	}
	ut_soft.stat_point++;
}

U0 UTSoftDrawComplexQuad(F64 *p0, F64 *p1, F64 *p2, F64 *p3,
	F64 u0, F64 v0, F64 u1, F64 v1, F64 u2, F64 v2, F64 u3, F64 v3,
	CUTTex *tex)
{//USoftwareRenderDevice::DrawComplexSurface — one quad facet as two tris.
 //Full BSP facets use UTBspDrawFacet → UTDrawTriTex3 with screen span.
	UTSoftDrawGouraudTri(p0, p1, p2, u0, v0, u1, v1, u2, v2, tex);
	UTSoftDrawGouraudTri(p0, p2, p3, u0, v0, u2, v2, u3, v3, tex);
	ut_soft.stat_complex++;
}

//legacy name
U0 UTSoftDrawQuadTex(F64 *p0, F64 *p1, F64 *p2, F64 *p3,
	F64 u0, F64 v0, F64 u1, F64 v1, F64 u2, F64 v2, F64 u3, F64 v3,
	CUTTex *tex)
{
	UTSoftDrawComplexQuad(p0, p1, p2, p3,
		u0, v0, u1, v1, u2, v2, u3, v3, tex);
}

CUTSpanBuf *UTSoftSpan()
{//screen FSpanBuffer for DrawComplexSurface / BSP FTB
	if (!ut_soft_ready)
		return NULL;
	return &ut_soft.span;
}

U0 UTSoftGetStats(U8 *buf, I64 buf_size)
{//USoftwareRenderDevice::GetStats
	I64 spans;
	I64 open;

	no_warn buf_size;
	spans = 0;
	open  = 0;
	if (ut_soft.canvas)
		spans = ut_soft.canvas->spans_drawn;
	open = UTSpanOpenCount(&ut_soft.span);
	StrPrint(buf,
		"SoftDrv spans=%d gouraud=%d tile=%d line=%d point=%d open=%d abort=%d depth=P8 display=%dbpp",
		spans,
		ut_soft.stat_gouraud,
		ut_soft.stat_tile,
		ut_soft.stat_line,
		ut_soft.stat_point,
		open,
		ut_soft.span.punch_abort,
		ut_soft.display_bpp);
}
