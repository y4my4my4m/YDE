// UTGame.ZC - deathmatch loop: health, hitscan, score, respawn, bots.
//
// No full UScript gametype. Natives consume ut_vm_cmd from UTVM.

extern Bool	ut_menu_open;
extern Bool	ut_menu_apply;
extern I64	ut_menu_frag;
extern I64	ut_menu_bots;
extern I64	ut_menu_mode;
extern U0	UTHUDDraw(CUTCanvas *c);
extern U0	UTHUDDrawScoreboard(CUTCanvas *c);

#define UT_GM_MAX_HEALTH	199
#define UT_GM_MAX_ARMOR		150
#define UT_GM_MAX_AMMO		999
#define UT_GM_FIRE_DAMAGE	25.0
#define UT_GM_FIRE_RANGE	4096.0
#define UT_GM_FIRE_COOLDOWN	0.25
#define UT_GM_BOT_MAX		8
#define UT_GM_BOT_N			UT_GM_BOT_MAX
#define UT_GM_PICK_N		96
#define UT_GM_PICK_RADIUS	70.0
#define UT_GM_BOT_SIGHT		1800.0
#define UT_GM_BOT_SHOT_CD	0.85
#define UT_GM_FRAG_LIMIT	30

#define UT_PICK_HEALTH		1
#define UT_PICK_ARMOR		2
#define UT_PICK_AMMO		3
#define UT_PICK_WEAPON		4
#define UT_PICK_SHIELD		5
#define UT_PICK_UDAMAGE		6
#define UT_PICK_THIGHS		7
#define UT_PICK_SUPERHEALTH	8

//Engine-ish armor layers: belt 100% → body 75% → pads 50%
#define UT_ARM_ABSORB_BELT	1.00
#define UT_ARM_ABSORB_BODY	0.75
#define UT_ARM_ABSORB_PADS	0.50
#define UT_ARM_MAX_BELT		150.0
#define UT_ARM_MAX_BODY		100.0
#define UT_ARM_MAX_PADS		50.0
#define UT_HEALTH_MAX_NORMAL	100.0
#define UT_HEALTH_MAX_SUPER		199.0

class CUTBot
{
	F64	 origin[3];
	F64	 vel[3];
	F64	 yaw;
	F64	 health;
	F64	 armor;
	F64	 shoot_t;
	Bool alive;
	I64	 score;
	I64	 weap;
	I64	 state;		//0 idle 1 chase 2 attack
};

class CUTPickup
{
	F64	 origin[3];
	I64	 kind;
	F64	 amount;
	I64	 weap_id;
	Bool taken;
	F64	 respawn_at;
	F64	 respawn_time;
};

F64		ut_health		= 100.0;
F64		ut_armor		= 0.0;		//HUD sum of layers
F64		ut_armor_belt	= 0.0;
F64		ut_armor_body	= 0.0;
F64		ut_armor_pads	= 0.0;
I64		ut_ammo			= 50;
I64		ut_frags		= 0;
I64		ut_deaths		= 0;
I64		ut_kill_streak	= 0;
F64		ut_multi_until	= 0.0;
Bool	ut_alive		= TRUE;
F64		ut_fire_t		= 0.0;
F64		ut_respawn_t	= 0.0;
F64		ut_death_cam_yaw	= 0.0;
F64		ut_death_look[3]	= {0, 0, 0};
I64		ut_killer_bot		= -1;
CUTBot	ut_bots[UT_GM_BOT_MAX];
CUTPickup	ut_picks[UT_GM_PICK_N];
I64		ut_pick_n		= 0;
Bool	ut_game_ready	= FALSE;
Bool	ut_suicide_latched	= FALSE;
Bool	ut_weap_cycle_latched	= FALSE;
I64		ut_map_latched		= 0;
Bool	ut_map_cycle_latched	= FALSE;
I64		ut_frag_limit		= UT_GM_FRAG_LIMIT;
I64		ut_bot_count		= 5;
Bool	ut_match_over		= FALSE;
F64		ut_damage_scale		= 1.0;	//UDamage
F64		ut_udamage_until	= 0.0;
Bool	ut_taunt_latched	= FALSE;
Bool	ut_first_blood		= FALSE;


U0 UTGameArmorSyncHUD()
{
	ut_armor = ut_armor_belt + ut_armor_body + ut_armor_pads;
	if (ut_armor > UT_GM_MAX_ARMOR)
		ut_armor = UT_GM_MAX_ARMOR;
}

U0 UTGameArmorClear()
{
	ut_armor_belt = 0.0;
	ut_armor_body = 0.0;
	ut_armor_pads = 0.0;
	ut_armor = 0.0;
}

U0 UTGameAddArmorLayer(I64 kind, F64 amount)
{//TournamentArmor / ThighPads / ShieldBelt stacking.
	if (kind == UT_PICK_SHIELD)
	{
		ut_armor_belt += amount;
		if (ut_armor_belt > UT_ARM_MAX_BELT)
			ut_armor_belt = UT_ARM_MAX_BELT;
	}
	else if (kind == UT_PICK_THIGHS)
	{
		ut_armor_pads += amount;
		if (ut_armor_pads > UT_ARM_MAX_PADS)
			ut_armor_pads = UT_ARM_MAX_PADS;
	}
	else
	{
		ut_armor_body += amount;
		if (ut_armor_body > UT_ARM_MAX_BODY)
			ut_armor_body = UT_ARM_MAX_BODY;
	}
	UTGameArmorSyncHUD;
}

U0 UTGameAddPickup(F64 *loc, I64 kind, F64 amount, I64 weap_id, F64 respawn)
{
	CUTPickup *p;

	if (ut_pick_n >= UT_GM_PICK_N || !loc)
		return;
	p = &ut_picks[ut_pick_n];
	UTVecCopy(loc, p->origin);
	p->kind = kind;
	p->amount = amount;
	p->weap_id = weap_id;
	p->taken = FALSE;
	p->respawn_at = 0.0;
	p->respawn_time = respawn;
	ut_pick_n++;
}

U0 UTGameScanPickups(CUTPackage *pkg)
{//Location of Health/Armor/Ammo/Weapon exports → touch pickups.
	I64 i;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	I64 kind;
	F64 amt;
	I64 wid;
	F64 rtime;
	CUTPropBag bag;

	ut_pick_n = 0;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_pick_n < UT_GM_PICK_N)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		kind = 0;
		amt = 0.0;
		wid = -1;
		rtime = 27.0;
		if (!StrCompare(cls, "HealthPack") || !StrCompare(cls, "MedBox") ||
			!StrCompare(cls, "TournamentHealth") || !StrCompare(cls, "Health"))
		{
			kind = UT_PICK_HEALTH;
			amt = 20.0;
			rtime = 20.0;
		}
		else if (!StrCompare(cls, "HealthVial") || !StrCompare(cls, "Vial") ||
			!StrCompare(cls, "Bandages"))
		{
			kind = UT_PICK_HEALTH;
			amt = 5.0;
			rtime = 20.0;
		}
		else if (!StrCompare(cls, "SuperHealthPack") ||
			!StrCompare(cls, "SuperHealth") ||
			!StrCompare(cls, "HealthPackNali"))
		{
			kind = UT_PICK_SUPERHEALTH;
			amt = 100.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "Armor") || !StrCompare(cls, "Armor2") ||
			!StrCompare(cls, "TournamentArmor"))
		{
			kind = UT_PICK_ARMOR;
			amt = 50.0;
		}
		else if (!StrCompare(cls, "ThighPads"))
		{
			kind = UT_PICK_THIGHS;
			amt = 50.0;
		}
		else if (!StrCompare(cls, "ShieldBelt") ||
			!StrCompare(cls, "UT_ShieldBelt"))
		{
			kind = UT_PICK_SHIELD;
			amt = 150.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "UDamage") || !StrCompare(cls, "UT_Invisibility"))
		{
			kind = UT_PICK_UDAMAGE;
			amt = 30.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "MiniAmmo") || !StrCompare(cls, "BioAmmo") ||
			!StrCompare(cls, "RocketAmmo") || !StrCompare(cls, "FlakAmmo") ||
			!StrCompare(cls, "PulseAmmo") || !StrCompare(cls, "ShockCore") ||
			!StrCompare(cls, "BulletBox") || !StrCompare(cls, "BladeHopper") ||
			!StrCompare(cls, "PAmmo") || !StrCompare(cls, "EClip"))
		{
			kind = UT_PICK_AMMO;
			amt = 20.0;
			rtime = 15.0;
		}
		else if (!StrCompare(cls, "ShockRifle") ||
			!StrCompare(cls, "SuperShockRifle") ||
			!StrCompare(cls, "PulseGun") ||
			!StrCompare(cls, "FlakCannon") ||
			!StrCompare(cls, "UT_Eightball") ||
			!StrCompare(cls, "Eightball") ||
			!StrCompare(cls, "RocketLauncher") ||
			!StrCompare(cls, "Minigun") ||
			!StrCompare(cls, "Minigun2") ||
			!StrCompare(cls, "SniperRifle") ||
			!StrCompare(cls, "Rifle") ||
			!StrCompare(cls, "Ripper") ||
			!StrCompare(cls, "BioRifle") ||
			!StrCompare(cls, "UT_BioRifle") ||
			!StrCompare(cls, "Enforcer") ||
			!StrCompare(cls, "Translocator") ||
			!StrCompare(cls, "WarheadLauncher") ||
			!StrCompare(cls, "ImpactHammer"))
		{
			kind = UT_PICK_WEAPON;
			wid = UTWeapIdFromClass(cls);
			amt = 20.0;
		}
		if (kind)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				if (UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
					e->object_flags, &bag))
				{
					if (kind == UT_PICK_HEALTH && bag.health > 0.0)
						amt = bag.health;
					if (bag.n_float > 0 && kind == UT_PICK_ARMOR &&
						bag.floats[0] > 1.0)
						amt = bag.floats[0];
				}
				UTGameAddPickup(v, kind, amt, wid, rtime);
			}
		}
		i++;
	}
	UTLog("UTGame: pickups=%d\n", ut_pick_n);
}

U0 UTGameTouchPickups()
{
	I64 i;
	CUTPickup *p;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	F64 r2;
	F64 maxh;

	if (!ut_alive)
		return;
	if (tS >= ut_udamage_until)
		ut_damage_scale = 1.0;
	r2 = UT_GM_PICK_RADIUS * UT_GM_PICK_RADIUS;
	i = 0;
	while (i < ut_pick_n)
	{
		p = &ut_picks[i];
		if (p->taken)
		{
			if (tS >= p->respawn_at)
				p->taken = FALSE;
		}
		else
		{
			dx = p->origin[0] - ut_origin[0];
			dy = p->origin[1] - ut_origin[1];
			dz = p->origin[2] - ut_origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < r2)
			{
				if (p->kind == UT_PICK_HEALTH || p->kind == UT_PICK_SUPERHEALTH)
				{
					maxh = UT_HEALTH_MAX_NORMAL;
					if (p->kind == UT_PICK_SUPERHEALTH || p->amount >= 100.0)
						maxh = UT_HEALTH_MAX_SUPER;
					if (ut_health < maxh)
					{
						ut_health += p->amount;
						if (ut_health > maxh)
							ut_health = maxh;
						p->taken = TRUE;
						p->respawn_at = tS + p->respawn_time;
						if (ut_snd_pickup_i >= 0)
							UTSndPlay(ut_snd_pickup_i, 0.5);
					}
				}
				else if (p->kind == UT_PICK_ARMOR || p->kind == UT_PICK_SHIELD ||
					p->kind == UT_PICK_THIGHS)
				{
					UTGameAddArmorLayer(p->kind, p->amount);
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					if (ut_snd_pickup_i >= 0)
						UTSndPlay(ut_snd_pickup_i, 0.5);
				}
				else if (p->kind == UT_PICK_AMMO)
				{
					ut_ammo += ToI64(p->amount);
					ut_weap_ammo[ut_weap_cur] += ToI64(p->amount);
					if (ut_ammo > UT_GM_MAX_AMMO)
						ut_ammo = UT_GM_MAX_AMMO;
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					if (ut_snd_pickup_i >= 0)
						UTSndPlay(ut_snd_pickup_i, 0.5);
				}
				else if (p->kind == UT_PICK_WEAPON)
				{
					if (p->weap_id >= 0)
						UTWeapGive(p->weap_id);
					ut_ammo += ToI64(p->amount);
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					if (ut_snd_pickup_i >= 0)
						UTSndPlay(ut_snd_pickup_i, 0.5);
				}
				else if (p->kind == UT_PICK_UDAMAGE)
				{
					ut_damage_scale = 3.0;
					ut_udamage_until = tS + p->amount;
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					if (ut_snd_pickup_i >= 0)
						UTSndPlay(ut_snd_pickup_i, 0.5);
				}
			}
		}
		i++;
	}
}

U0 UTGamePlaceBots()
{//PlayerStarts + scatter. Chase AI uses yaw toward player.
	I64 i;
	F64 ang;
	I64 starts;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	F64 spots[UT_GM_BOT_MAX * 3];

	starts = 0;
	if (ut_bot_count < 0)
		ut_bot_count = 0;
	if (ut_bot_count > UT_GM_BOT_MAX)
		ut_bot_count = UT_GM_BOT_MAX;
	if (ut_map_pkg != NULL)
	{
		i = 0;
		while (i < ut_map_pkg->export_count && starts < ut_bot_count)
		{
			e = &ut_map_pkg->exports[i];
			cls = UTPkgClassName(ut_map_pkg, e->class_index);
			if (!StrCompare(cls, "PlayerStart") ||
				!StrCompare(cls, "PlayerStart_Trophy"))
			{
				if (UTPropFindStructVec(ut_map_pkg, e->serial_offset,
					e->serial_size, "Location", v))
				{
					spots[starts * 3] = v[0];
					spots[starts * 3 + 1] = v[1];
					spots[starts * 3 + 2] = v[2];
					starts++;
				}
			}
			i++;
		}
	}
	i = 0;
	while (i < UT_GM_BOT_MAX)
	{
		ang = ToF64(i) * 1.3;
		if (i < starts)
		{
			ut_bots[i].origin[0] = spots[i * 3];
			ut_bots[i].origin[1] = spots[i * 3 + 1];
			ut_bots[i].origin[2] = spots[i * 3 + 2];
		}
		else
		{
			ut_bots[i].origin[0] = ut_spawn[0] + Cos(ang) * 300.0;
			ut_bots[i].origin[1] = ut_spawn[1] + Sin(ang) * 300.0;
			ut_bots[i].origin[2] = ut_spawn[2];
		}
		ut_bots[i].vel[0] = 0;
		ut_bots[i].vel[1] = 0;
		ut_bots[i].vel[2] = 0;
		ut_bots[i].yaw = ang * 10000.0;
		ut_bots[i].health = 100.0;
		ut_bots[i].armor = 0.0;
		ut_bots[i].shoot_t = 0.0;
		ut_bots[i].alive = (i < ut_bot_count);
		ut_bots[i].score = 0;
		ut_bots[i].weap = UT_WEAP_SHOCK;
		ut_bots[i].state = 0;
		i++;
	}
}

U0 UTGameInit()
{
	ut_health = 100.0;
	UTGameArmorClear;
	ut_ammo = 50;
	ut_frags = 0;
	ut_deaths = 0;
	ut_kill_streak = 0;
	ut_first_blood = FALSE;
	ut_multi_until = 0.0;
	ut_alive = TRUE;
	ut_fire_t = 0.0;
	ut_respawn_t = 0.0;
	ut_pick_n = 0;
	ut_suicide_latched = FALSE;
	ut_killer_bot = -1;
	ut_match_over = FALSE;
	ut_damage_scale = 1.0;
	ut_udamage_until = 0.0;
	if (ut_menu_frag >= 5)
		ut_frag_limit = ut_menu_frag;
	if (ut_menu_bots >= 0)
		ut_bot_count = ut_menu_bots;
	UTWeapInit;
	UTDecalInit;
	if (ut_map_pkg != NULL)
	{
		UTGameScanPickups(ut_map_pkg);
		UTActorScanPackage(ut_map_pkg);
		UTZoneScanPackage(ut_map_pkg);
		UTCTFScanPackage(ut_map_pkg);
		UTLightScanPackage(ut_map_pkg);
	}
	UTGamePlaceBots;
	UTPhysInit;
	ut_phys_gravity = UTZoneGravityMag;
	if (ut_bsp != NULL)
		UTPhysSnapToFloor(ut_bsp, ut_origin);
	ut_game_ready = TRUE;
	UTLog("UTGame: ready bots=%d picks=%d lights=%d fraglimit=%d eye=%.0f %.0f %.0f\n",
		ut_bot_count, ut_pick_n, ut_light_n, ut_frag_limit,
		ut_origin[0], ut_origin[1], ut_origin[2]);
}

U0 UTGameRespawn()
{
	UTVecCopy(ut_spawn, ut_origin);
	ut_view_yaw = ut_spawn_yaw & 0xFFFF;
	ut_view_pitch = ut_spawn_pitch;
	ut_health = 100.0;
	UTGameArmorClear;
	ut_ammo = 50;
	ut_alive = TRUE;
	ut_respawn_t = 0.0;
	ut_killer_bot = -1;
	ut_damage_scale = 1.0;
	UTPhysInit;
	if (ut_bsp != NULL)
		UTPhysSnapToFloor(ut_bsp, ut_origin);
	UTLog("UTGame: respawn eye=%.0f %.0f %.0f floor=%d\n",
		ut_origin[0], ut_origin[1], ut_origin[2], ut_floor_hit);
}

U0 UTGameKillPlayer()
{
	if (!ut_alive)
		return;
	ut_alive = FALSE;
	ut_deaths++;
	ut_respawn_t = tS + 3.0;
	ut_health = 0.0;
	ut_kill_streak = 0;
	UTGameArmorClear;
	if (ut_killer_bot >= 0 && ut_killer_bot < UT_GM_BOT_MAX)
		ut_bots[ut_killer_bot].score++;
	ut_death_look[0] = ut_origin[0];
	ut_death_look[1] = ut_origin[1];
	ut_death_look[2] = ut_origin[2] + 48.0;
	ut_death_cam_yaw = ToF64(ut_view_yaw);
	if (ut_snd_die_i >= 0)
		UTSndPlay(ut_snd_die_i, 1.0);
	if (ut_snd_ann_lost >= 0)
		UTSndPlay(ut_snd_ann_lost, 0.7);
	UTLog("UTGame: death deaths=%d\n", ut_deaths);
}

U0 UTGameTakeDamage(F64 amount)
{
	F64 left;
	F64 absorbed;
	F64 take;

	if (!ut_alive || amount <= 0.0)
		return;
	left = amount;
	//ShieldBelt 100%
	if (ut_armor_belt > 0.0 && left > 0.0)
	{
		take = left;
		if (take > ut_armor_belt)
			take = ut_armor_belt;
		ut_armor_belt -= take;
		left -= take;
	}
	//body armor 75%
	if (ut_armor_body > 0.0 && left > 0.0)
	{
		absorbed = left * UT_ARM_ABSORB_BODY;
		if (absorbed > ut_armor_body)
			absorbed = ut_armor_body;
		ut_armor_body -= absorbed;
		left -= absorbed;
	}
	//thigh pads 50%
	if (ut_armor_pads > 0.0 && left > 0.0)
	{
		absorbed = left * UT_ARM_ABSORB_PADS;
		if (absorbed > ut_armor_pads)
			absorbed = ut_armor_pads;
		ut_armor_pads -= absorbed;
		left -= absorbed;
	}
	UTGameArmorSyncHUD;
	ut_health -= left;
	if (ut_snd_pain_i >= 0)
		UTSndPlay(ut_snd_pain_i, 0.8);
	if (ut_health <= 0.0)
		UTGameKillPlayer;
}

Bool UTGameTraceBot(F64 *start, F64 *dir, F64 range, I64 *hit_i, F64 *hit_dist)
{//axis-aligned cylinder hit vs bots. Returns nearest.
	I64 i;
	I64 best;
	F64 best_t;
	F64 to[3];
	F64 lat[3];
	F64 along;
	F64 lat_len;
	F64 rad;

	best = -1;
	best_t = range;
	rad = 40.0;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			to[0] = ut_bots[i].origin[0] - start[0];
			to[1] = ut_bots[i].origin[1] - start[1];
			to[2] = ut_bots[i].origin[2] - start[2];
			along = to[0] * dir[0] + to[1] * dir[1] + to[2] * dir[2];
			if (along > 0.0 && along < best_t)
			{
				lat[0] = to[0] - dir[0] * along;
				lat[1] = to[1] - dir[1] * along;
				lat[2] = to[2] - dir[2] * along;
				lat_len = Sqrt(lat[0] * lat[0] + lat[1] * lat[1] + lat[2] * lat[2]);
				if (lat_len < rad)
				{
					best = i;
					best_t = along;
				}
			}
		}
		i++;
	}
	*hit_i = best;
	*hit_dist = best_t;
	return best >= 0;
}

U0 UTGameFragBot(I64 hit)
{
	CUTBot *bot;
	F64 ang;

	if (hit < 0 || hit >= UT_GM_BOT_MAX)
		return;
	bot = &ut_bots[hit];
	bot->alive = FALSE;
	bot->health = 0.0;
	ut_frags++;
	if (!ut_first_blood)
	{
		ut_first_blood = TRUE;
		if (ut_snd_ann_first >= 0)
			UTSndPlay(ut_snd_ann_first, 1.0);
	}
	if (tS < ut_multi_until)
		ut_kill_streak++;
	else
		ut_kill_streak = 1;
	ut_multi_until = tS + 3.0;
	if (ut_kill_streak == 2 && ut_snd_ann_double >= 0)
		UTSndPlay(ut_snd_ann_double, 1.0);
	else if (ut_kill_streak == 3 && ut_snd_ann_multi >= 0)
		UTSndPlay(ut_snd_ann_multi, 1.0);
	else if (ut_kill_streak >= 5 && ut_snd_ann_spree >= 0)
		UTSndPlay(ut_snd_ann_spree, 1.0);
	if (ut_frags >= ut_frag_limit)
		ut_match_over = TRUE;
	UTLog("UTGame: frag bot=%d frags=%d streak=%d\n", hit, ut_frags,
		ut_kill_streak);
	ang = ToF64(hit + ut_frags) * 1.7;
	bot->origin[0] = ut_spawn[0] + Cos(ang) * 280.0;
	bot->origin[1] = ut_spawn[1] + Sin(ang) * 280.0;
	bot->origin[2] = ut_spawn[2];
	bot->health = 100.0;
	bot->armor = 0.0;
	bot->alive = TRUE;
	bot->state = 1;
}

U0 UTGameHitScan(F64 *origin, F64 *dir, F64 damage, F64 range)
{
	I64 hit;
	F64 dist;
	F64 ndir[3];
	F64 len;
	F64 dmg;
	F64 impact[3];

	if (!ut_alive || !origin || !dir || damage <= 0.0)
		return;
	dmg = damage * ut_damage_scale;
	UTVecCopy(dir, ndir);
	len = UTVecLength(ndir);
	if (len < UT_SMALL_NUMBER)
		return;
	ndir[0] /= len; ndir[1] /= len; ndir[2] /= len;
	if (UTGameTraceBot(origin, ndir, range, &hit, &dist))
	{
		ut_bots[hit].health -= dmg;
		impact[0] = origin[0] + ndir[0] * dist;
		impact[1] = origin[1] + ndir[1] * dist;
		impact[2] = origin[2] + ndir[2] * dist;
		UTDecalBlood(impact);
		if (ut_bots[hit].health <= 0.0)
			UTGameFragBot(hit);
	}
}

U0 UTGameBotShootPlayer(I64 bi)
{//bot hitscan toward player — TournamentBot TraceFire soft.
	CUTBot *bot;
	F64 dir[3];
	F64 len;
	F64 dmg;

	bot = &ut_bots[bi];
	if (!bot->alive || !ut_alive)
		return;
	if (tS < bot->shoot_t)
		return;
	dir[0] = ut_origin[0] - bot->origin[0];
	dir[1] = ut_origin[1] - bot->origin[1];
	dir[2] = ut_origin[2] + 20.0 - bot->origin[2];
	len = UTVecLength(dir);
	if (len < 1.0 || len > UT_GM_BOT_SIGHT)
		return;
	dir[0] /= len; dir[1] /= len; dir[2] /= len;
	bot->yaw = ToF64(UTVecYaw(dir));
	dmg = 12.0 + ToF64(bot->weap) * 2.0;
	UTGameTakeDamage(dmg);
	ut_killer_bot = bi;
	bot->shoot_t = tS + UT_GM_BOT_SHOT_CD;
	if (ut_snd_fire_i >= 0)
		UTSndPlay(ut_snd_fire_i, 0.35);
}

U0 UTGameTickBots(F64 dt)
{
	I64 i;
	CUTBot *bot;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 dist;
	F64 speed;
	F64 wish[3];

	i = 0;
	while (i < UT_GM_BOT_N)
	{
		bot = &ut_bots[i];
		if (bot->alive)
		{
			dx = ut_origin[0] - bot->origin[0];
			dy = ut_origin[1] - bot->origin[1];
			dz = ut_origin[2] - bot->origin[2];
			dist = Sqrt(dx * dx + dy * dy + dz * dz);
			if (!ut_alive)
				bot->state = 0;
			else if (dist < 350.0)
				bot->state = 2;
			else if (dist < UT_GM_BOT_SIGHT)
				bot->state = 1;
			else
				bot->state = 0;

			if (bot->state == 0)
			{
				bot->origin[0] += Sin(tS * 0.6 + ToF64(i)) * 40.0 * dt;
				bot->origin[1] += Cos(tS * 0.45 + ToF64(i)) * 40.0 * dt;
			}
			else
			{
				wish[0] = dx; wish[1] = dy; wish[2] = 0.0;
				UTVecNormalize(wish);
				speed = 280.0;
				if (bot->state == 2)
					speed = 220.0;
				bot->origin[0] += wish[0] * speed * dt;
				bot->origin[1] += wish[1] * speed * dt;
				if (dz > 8.0)
					bot->origin[2] += 60.0 * dt;
				else if (dz < -8.0)
					bot->origin[2] -= 60.0 * dt;
				bot->yaw = ToF64(UTVecYaw(wish));
				if (bot->state == 2)
					UTGameBotShootPlayer(i);
				else if (dist < 900.0 && (ToI64(tS * 2.0) & 7) == i)
					UTGameBotShootPlayer(i);
			}
			if (ut_lod_player.loaded)
			{
				if (bot->state >= 1)
					UTLodSetSeq(&ut_lod_player, "RunLg");
				else
					UTLodSetSeq(&ut_lod_player, "WalkLg");
			}
		}
		i++;
	}
}

U0 UTGameRadiusDamage(F64 *origin, F64 damage, F64 radius)
{
	I64 i;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d;
	F64 fall;

	if (!origin || damage <= 0.0)
		return;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			dx = ut_bots[i].origin[0] - origin[0];
			dy = ut_bots[i].origin[1] - origin[1];
			dz = ut_bots[i].origin[2] - origin[2];
			d = Sqrt(dx * dx + dy * dy + dz * dz);
			if (d < radius)
			{
				fall = damage * (1.0 - d / radius);
				ut_bots[i].health -= fall;
				if (ut_bots[i].health <= 0.0)
					UTGameFragBot(i);
			}
		}
		i++;
	}
	//self splash
	dx = ut_origin[0] - origin[0];
	dy = ut_origin[1] - origin[1];
	dz = ut_origin[2] - origin[2];
	d = Sqrt(dx * dx + dy * dy + dz * dz);
	if (d < radius)
		UTGameTakeDamage(damage * (1.0 - d / radius) * 0.5);
}

U0 UTGameDoFire()
{
	if (!ut_alive)
		return;
	UTWeapFire(FALSE);
}

U0 UTGameDispatchVM()
{
	if (ut_vm_cmd == UT_VM_CMD_FIRE)
		UTGameDoFire;
	else if (ut_vm_cmd == UT_VM_CMD_DAMAGE)
		UTGameTakeDamage(ut_vm_arg);
	else if (ut_vm_cmd == UT_VM_CMD_PLAYSND)
		UTSndPlay(ToI64(ut_vm_arg), 1.0);
	else if (ut_vm_cmd == UT_VM_CMD_TRACE)
		UTGameDoFire;
	ut_vm_cmd = UT_VM_CMD_NONE;
}

U0 UTGameFireVM()
{
	if (!ut_alive)
		return;
	if (ut_alt_fire)
		UTWeapFire(TRUE);
	else
		UTWeapFire(FALSE);
}

U0 UTGameTick(F64 dt)
{
	F64 wish[3];
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	F64 flat[3];
	F64 speed;
	I64 i;

	if (!ut_game_ready)
		return;

	if (ut_menu_open)
	{
		if (ut_menu_apply)
		{
			ut_menu_apply = FALSE;
			ut_frag_limit = ut_menu_frag;
			ut_bot_count = ut_menu_bots;
			//ut_menu_mode: 0 DM 1 TDM 2 CTF 3 DOM — TDM shares DM- maps
			if (ut_menu_mode == 2)
				ut_map_filter = UT_MAP_MODE_CTF;
			else if (ut_menu_mode == 3)
				ut_map_filter = UT_MAP_MODE_DOM;
			else
				ut_map_filter = UT_MAP_MODE_DM;
			UTMapLoadCatalogIndex(ut_map_cat_i);
			UTGameInit;
			return;
		}
		return;
	}

	if (Bt(kbd.down_bitmap, Char2ScanCode('t')))
	{
		if (!ut_taunt_latched)
		{
			ut_taunt_latched = TRUE;
			UTSndTaunt;
		}
	}
	else
		ut_taunt_latched = FALSE;

	if (ut_want_map && ut_want_map != ut_map_latched)
	{
		ut_map_latched = ut_want_map;
		if (UTMapSwitchSlot(ut_want_map))
		{
			UTGameInit;
			return;
		}
	}
	if (!ut_want_map)
		ut_map_latched = 0;

	if (ut_want_map_cycle)
	{
		if (!ut_map_cycle_latched)
		{
			ut_map_cycle_latched = TRUE;
			if (ut_want_map_filter >= -1)
				ut_map_filter = ut_want_map_filter;
			if (UTMapCycle(ut_want_map_cycle))
			{
				UTGameInit;
				return;
			}
		}
	}
	else
		ut_map_cycle_latched = FALSE;

	if (ut_want_map_filter >= -1 && ut_want_map_filter != ut_map_filter)
		ut_map_filter = ut_want_map_filter;

	if (!ut_alive)
	{
		//death cam: orbit corpse / look at killer
		ut_death_cam_yaw += 8000.0 * dt;
		if (ut_killer_bot >= 0 && ut_killer_bot < UT_GM_BOT_N &&
			ut_bots[ut_killer_bot].alive)
		{
			UTVecCopy(ut_bots[ut_killer_bot].origin, ut_death_look);
			ut_death_look[2] += 40.0;
		}
		ut_origin[0] = ut_death_look[0] +
			Cos(ut_death_cam_yaw * UT_ROT2RAD) * 180.0;
		ut_origin[1] = ut_death_look[1] +
			Sin(ut_death_cam_yaw * UT_ROT2RAD) * 180.0;
		ut_origin[2] = ut_death_look[2] + 80.0;
		wish[0] = ut_death_look[0] - ut_origin[0];
		wish[1] = ut_death_look[1] - ut_origin[1];
		wish[2] = 0.0;
		ut_view_yaw = UTVecYaw(wish) & 0xFFFF;
		ut_view_pitch = -2000;
		UTGameTickBots(dt);
		UTActorTickMovers(dt);
		if (ut_lod_player.loaded)
			UTLodTick(&ut_lod_player, dt, 10.0);
		if (tS >= ut_respawn_t && !ut_match_over)
			UTGameRespawn;
		return;
	}

	if (ut_want_suicide)
	{
		if (!ut_suicide_latched)
		{
			ut_suicide_latched = TRUE;
			UTGameKillPlayer;
			return;
		}
	}
	else
		ut_suicide_latched = FALSE;

	UTGameTouchPickups;
	UTActorTickMovers(dt);
	UTActorTouchPlayer(ut_origin);
	UTCTFTouchPlayer(ut_origin);
	UTCTFTickDOM(ut_origin, dt);
	UTZoneUpdatePlayer(ut_origin);
	ut_phys_gravity = UTZoneGravityMag;
	if (ut_zone_in_hurt && ut_alive)
		UTGameTakeDamage(25.0 * dt);
	i = 0;
	while (i < ut_actor_n)
	{
		if (ut_actors[i].kind == UT_ACT_WEAPON && ut_actors[i].amount >= 1.0)
		{
			UTWeapGive(ut_actors[i].weap_id);
			ut_actors[i].amount = 0.0;
		}
		i++;
	}
	UTWeapTickProjs(dt);
	UTWeapTickSpecials;
	UTDecalTick(dt);
	UTMusicUpdate;
	if (ut_lod_player.loaded)
		UTLodTick(&ut_lod_player, dt, 12.0);
	if (ut_lod_weapon.loaded)
		UTLodTick(&ut_lod_weapon, dt, 8.0);
	UTGameTickBots(dt);

	if (ut_weap_next || ut_weap_prev)
	{
		if (!ut_weap_cycle_latched)
		{
			ut_weap_cycle_latched = TRUE;
			if (ut_weap_next)
				UTWeapCycle(1);
			else
				UTWeapCycle(-1);
		}
	}
	else
		ut_weap_cycle_latched = FALSE;

	if (ut_want_jump)
	{
		UTPhysJump;
		ut_want_jump = FALSE;
	}

	UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
	UTVecSet(wish, 0.0, 0.0, 0.0);
	flat[0] = fwd[0];
	flat[1] = fwd[1];
	flat[2] = 0.0;
	UTVecNormalize(flat);
	if (ut_key_forward)
		UTVecAdd(wish, flat, wish);
	if (ut_key_back)
		UTVecSub(wish, flat, wish);
	if (ut_key_right)
		UTVecAdd(wish, right, wish);
	if (ut_key_left)
		UTVecSub(wish, right, wish);
	if (UTVecLength(wish) > UT_SMALL_NUMBER)
		UTVecNormalize(wish);

	if (ut_key_fast)
		speed = UT_MOVE_FAST;
	else
		speed = UT_MOVE_SPEED;

	if (ut_use_map && ut_bsp != NULL)
		UTPhysIntegrate(ut_bsp, ut_origin, dt, wish, speed);
	else
	{
		UTVecMA(ut_origin, speed * dt, wish, ut_origin);
		if (ut_key_up)
			ut_origin[2] += speed * dt;
		if (ut_key_down)
			ut_origin[2] -= speed * dt;
	}

	if (ut_fire_held || ut_alt_fire)
		UTGameFireVM;

	ut_ammo = ut_weap_ammo[ut_weap_cur];
}

U0 UTGameDrawHUD(CUTCanvas *c)
{
	UTHUDDraw(c);
	if (ut_show_scores)
		UTHUDDrawScoreboard(c);
}

U0 UTGameDrawBots(CUTCanvas *c)
{//LodMesh pawns + pickup markers.
	I64 i;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 z;
	CUTBot *bot;
	CUTPickup *p;
	I64 col;

	if (!c || !ut_game_ready)
		return;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		bot = &ut_bots[i];
		if (bot->alive)
		{
			if (ut_lod_player.loaded)
			{
				UTVecCopy(bot->origin, ut_lod_player.draw_origin);
				ut_lod_player.draw_yaw = ToI64(bot->yaw) & 0xFFFF;
				UTLodDraw(c, &ut_lod_player, 50 + i * 25);
			}
			else if (ut_player_mesh_ready)
			{
				UTVecCopy(bot->origin, ut_player_mesh.origin);
				ut_player_mesh.scale = 1.0;
				UTMeshDraw(c, &ut_player_mesh);
			}
			else
			{
				z = bot->origin[2];
				a[0] = bot->origin[0] - 20; a[1] = bot->origin[1] - 20; a[2] = z;
				b[0] = bot->origin[0] + 20; b[1] = bot->origin[1] - 20; b[2] = z;
				cc[0] = bot->origin[0] + 20; cc[1] = bot->origin[1] + 20; cc[2] = z + 70;
				UTDrawTri3(c, a, b, cc, 40 + i * 20);
			}
		}
		i++;
	}
	i = 0;
	while (i < ut_pick_n)
	{
		p = &ut_picks[i];
		if (!p->taken)
		{
			col = 180;
			if (p->kind == UT_PICK_HEALTH)
				col = 250;
			else if (p->kind == UT_PICK_ARMOR || p->kind == UT_PICK_SHIELD)
				col = 200;
			else if (p->kind == UT_PICK_AMMO)
				col = 160;
			else if (p->kind == UT_PICK_UDAMAGE)
				col = 230;
			z = p->origin[2];
			a[0] = p->origin[0] - 12; a[1] = p->origin[1] - 12; a[2] = z;
			b[0] = p->origin[0] + 12; b[1] = p->origin[1] - 12; b[2] = z;
			cc[0] = p->origin[0] + 12; cc[1] = p->origin[1] + 12; cc[2] = z + 24;
			UTDrawTri3(c, a, b, cc, col);
		}
		i++;
	}
}

U0 UTGameExit()
{
	UTDecalExit;
	ut_game_ready = FALSE;
}
