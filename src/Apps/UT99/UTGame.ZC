I64		ut_deaths		= 0;
I64		ut_kill_streak	= 0;
I64		ut_spree_count	= 0;
F64		ut_multi_until	= 0.0;
Bool	ut_alive		= TRUE;
F64		ut_fire_t		= 0.0;
F64		ut_respawn_t	= 0.0;
F64		ut_death_cam_yaw	= 0.0;
F64		ut_death_look[3]	= {0, 0, 0};
I64		ut_killer_bot		= -1;
CUTBot	ut_bots[UT_GM_BOT_MAX];
CUTPickup	ut_picks[UT_GM_PICK_N];
I64		ut_pick_n		= 0;
Bool	ut_game_ready	= FALSE;
Bool	ut_suicide_latched	= FALSE;
Bool	ut_dropflag_latched	= FALSE;
Bool	ut_weap_cycle_latched	= FALSE;
I64		ut_map_latched		= 0;
Bool	ut_map_cycle_latched	= FALSE;
I64		ut_frag_limit		= UT_GM_FRAG_LIMIT;
I64		ut_time_limit		= 0;		//minutes; 0 = none
F64		ut_match_end_t		= 0.0;
I64		ut_bot_count		= 5;
Bool	ut_match_over		= FALSE;
F64		ut_damage_scale		= 1.0;
F64		ut_udamage_until	= 0.0;
F64		ut_invis_until		= 0.0;
Bool	ut_friendly_fire	= FALSE;
Bool	ut_balance_teams	= TRUE;
F64		ut_foot_t		= 0.0;
Bool	ut_taunt_latched	= FALSE;
Bool	ut_first_blood		= FALSE;
Bool	ut_mut_arena		= FALSE;
Bool	ut_mut_noredeem		= FALSE;
Bool	ut_mut_nopower		= FALSE;
Bool	ut_mut_stealth		= FALSE;
Bool	ut_mut_relic_death	= FALSE;
Bool	ut_mut_relic_redemp	= FALSE;
Bool	ut_weapons_stay		= FALSE;
Bool	ut_force_respawn	= FALSE;
