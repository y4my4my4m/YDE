U0 UTGameArmorSyncHUD()
{
	ut_armor = ut_armor_belt + ut_armor_body + ut_armor_pads;
	if (ut_armor > UT_GM_MAX_ARMOR)
		ut_armor = UT_GM_MAX_ARMOR;
}

U0 UTGameArmorClear()
{
	ut_armor_belt = 0.0;
	ut_armor_body = 0.0;
	ut_armor_pads = 0.0;
	ut_armor = 0.0;
}

U0 UTGameAddArmorLayer(I64 kind, F64 amount)
{//TournamentArmor / ThighPads / ShieldBelt stacking.
	if (kind == UT_PICK_SHIELD)
	{
		ut_armor_belt += amount;
		if (ut_armor_belt > UT_ARM_MAX_BELT)
			ut_armor_belt = UT_ARM_MAX_BELT;
	}
	else if (kind == UT_PICK_THIGHS)
	{
		ut_armor_pads += amount;
		if (ut_armor_pads > UT_ARM_MAX_PADS)
			ut_armor_pads = UT_ARM_MAX_PADS;
	}
	else
	{
		ut_armor_body += amount;
		if (ut_armor_body > UT_ARM_MAX_BODY)
			ut_armor_body = UT_ARM_MAX_BODY;
	}
	UTGameArmorSyncHUD;
}

U0 UTGameAddPickup(F64 *loc, I64 kind, F64 amount, I64 weap_id, F64 respawn,
	U8 *snd)
{
	CUTPickup *p;

	if (ut_pick_n >= UT_GM_PICK_N || !loc)
		return;
	p = &ut_picks[ut_pick_n];
	UTVecCopy(loc, p->origin);
	p->kind = kind;
	p->amount = amount;
	p->weap_id = weap_id;
	p->taken = FALSE;
	p->respawn_at = 0.0;
	p->respawn_time = respawn;
	p->pickup_snd[0] = 0;
	if (snd && snd[0])
	{
		StrPrint(p->pickup_snd, "%s", snd);
		p->pickup_snd[47] = 0;
	}
	ut_pick_n++;
}

U0 UTGamePickupSnd(CUTPickup *p)
{//Inventory.PickupSound
	if (p && p->pickup_snd[0])
	{
		UTSndPlayObj(p->pickup_snd, 0.5);
		return;
	}
	if (ut_snd_pickup_i >= 0)
		UTSndPlay(ut_snd_pickup_i, 0.5);
}

U0 UTGameScanPickups(CUTPackage *pkg)
{
	I64 i;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	I64 kind;
	F64 amt;
	I64 wid;
	F64 rtime;
	CUTPropBag bag;
	CUTPropBag cbag;
	U8 psnd[48];

	ut_pick_n = 0;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_pick_n < UT_GM_PICK_N)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		kind = 0;
		amt = 0.0;
		wid = -1;
		rtime = 27.0;
		if (!StrCompare(cls, "HealthPack") || !StrCompare(cls, "MedBox") ||
			!StrCompare(cls, "TournamentHealth") || !StrCompare(cls, "Health"))
		{
			kind = UT_PICK_HEALTH;
			amt = 20.0;
			rtime = 20.0;
		}
		else if (!StrCompare(cls, "HealthVial") || !StrCompare(cls, "Vial") ||
			!StrCompare(cls, "Bandages"))
		{
			kind = UT_PICK_HEALTH;
			amt = 5.0;
			rtime = 20.0;
		}
		else if (!StrCompare(cls, "SuperHealthPack") ||
			!StrCompare(cls, "SuperHealth") ||
			!StrCompare(cls, "HealthPackNali"))
		{
			kind = UT_PICK_SUPERHEALTH;
			amt = 100.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "Armor") || !StrCompare(cls, "Armor2") ||
			!StrCompare(cls, "TournamentArmor"))
		{
			kind = UT_PICK_ARMOR;
			amt = 50.0;
			rtime = 27.0;
		}
		else if (!StrCompare(cls, "ThighPads"))
		{
			kind = UT_PICK_THIGHS;
			amt = 50.0;
			rtime = 27.0;
		}
		else if (!StrCompare(cls, "ShieldBelt") ||
			!StrCompare(cls, "UT_ShieldBelt"))
		{
			kind = UT_PICK_SHIELD;
			amt = 150.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "UDamage"))
		{
			kind = UT_PICK_UDAMAGE;
			amt = 30.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "UT_Invisibility") ||
			!StrCompare(cls, "Invisibility"))
		{
			kind = UT_PICK_INVIS;
			amt = 30.0;
			rtime = 55.0;
		}
		else if (!StrCompare(cls, "MiniAmmo") || !StrCompare(cls, "BioAmmo") ||
			!StrCompare(cls, "RocketAmmo") || !StrCompare(cls, "FlakAmmo") ||
			!StrCompare(cls, "PulseAmmo") || !StrCompare(cls, "ShockCore") ||
			!StrCompare(cls, "BulletBox") || !StrCompare(cls, "BladeHopper") ||
			!StrCompare(cls, "PAmmo") || !StrCompare(cls, "EClip"))
		{
			kind = UT_PICK_AMMO;
			amt = 20.0;
			rtime = 15.0;
		}
		else if (!StrCompare(cls, "ShockRifle") ||
			!StrCompare(cls, "SuperShockRifle") ||
			!StrCompare(cls, "PulseGun") ||
			!StrCompare(cls, "FlakCannon") ||
			!StrCompare(cls, "UT_Eightball") ||
			!StrCompare(cls, "Eightball") ||
			!StrCompare(cls, "RocketLauncher") ||
			!StrCompare(cls, "Minigun") ||
			!StrCompare(cls, "Minigun2") ||
			!StrCompare(cls, "SniperRifle") ||
			!StrCompare(cls, "Rifle") ||
			!StrCompare(cls, "Ripper") ||
			!StrCompare(cls, "BioRifle") ||
			!StrCompare(cls, "UT_BioRifle") ||
			!StrCompare(cls, "Enforcer") ||
			!StrCompare(cls, "Translocator") ||
			!StrCompare(cls, "WarheadLauncher") ||
			!StrCompare(cls, "ImpactHammer"))
		{
			kind = UT_PICK_WEAPON;
			wid = UTWeapIdFromClass(cls);
			amt = 20.0;
			rtime = 27.0;
		}
		if (kind)
		{
			if (ut_mut_nopower && (kind == UT_PICK_UDAMAGE ||
				kind == UT_PICK_INVIS ||
				kind == UT_PICK_SHIELD || kind == UT_PICK_SUPERHEALTH))
				kind = 0;
			if (ut_mut_noredeem && kind == UT_PICK_WEAPON &&
				wid == UT_WEAP_REDEEMER)
				kind = 0;
			if (ut_mut_arena && kind == UT_PICK_WEAPON &&
				wid != UT_WEAP_SHOCK && wid != UT_WEAP_SSHOT)
				kind = 0;
		}
		if (kind)
		{
			if (UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v))
			{
				if (UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
					e->object_flags, &bag))
				{
					if (kind == UT_PICK_HEALTH && bag.health > 0.0)
						amt = bag.health;
					if (bag.n_float > 0 && kind == UT_PICK_ARMOR &&
						bag.floats[0] > 1.0)
						amt = bag.floats[0];
					if (bag.respawn_time > 0.5)
						rtime = bag.respawn_time;
				}
				psnd[0] = 0;
				if (bag.pickup_snd[0])
					StrPrint(psnd, "%s", bag.pickup_snd);
				else
				{
					if (UTPropLoadClassDefaults(
						"::/Apps/UT99/System/Botpack.u", cls, &cbag) &&
						cbag.pickup_snd[0])
						StrPrint(psnd, "%s", cbag.pickup_snd);
					else if (UTPropLoadClassDefaults(
						"::/Apps/UT99/System/UnrealShare.u", cls, &cbag) &&
						cbag.pickup_snd[0])
						StrPrint(psnd, "%s", cbag.pickup_snd);
				}
				UTGameAddPickup(v, kind, amt, wid, rtime, psnd);
			}
		}
		i++;
	}
	UTLog("UTGame: pickups=%d\n", ut_pick_n);
}

U0 UTGameTouchPickups()
{
	I64 i;
	CUTPickup *p;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	F64 r2;
	F64 maxh;

	if (!ut_alive)
		return;
	if (tS >= ut_udamage_until)
		ut_damage_scale = 1.0;
	r2 = UT_GM_PICK_RADIUS * UT_GM_PICK_RADIUS;
	i = 0;
	while (i < ut_pick_n)
	{
		p = &ut_picks[i];
		if (p->taken)
		{
			if (tS >= p->respawn_at)
				p->taken = FALSE;
		}
		else
		{
			dx = p->origin[0] - ut_origin[0];
			dy = p->origin[1] - ut_origin[1];
			dz = p->origin[2] - ut_origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < r2)
			{
				if (p->kind == UT_PICK_HEALTH || p->kind == UT_PICK_SUPERHEALTH)
				{
					maxh = UT_HEALTH_MAX_NORMAL;
					if (p->kind == UT_PICK_SUPERHEALTH || p->amount >= 100.0)
						maxh = UT_HEALTH_MAX_SUPER;
					if (ut_health < maxh)
					{
						ut_health += p->amount;
						if (ut_health > maxh)
							ut_health = maxh;
						p->taken = TRUE;
						p->respawn_at = tS + p->respawn_time;
						UTGamePickupSnd(p);
					}
				}
				else if (p->kind == UT_PICK_ARMOR || p->kind == UT_PICK_SHIELD ||
					p->kind == UT_PICK_THIGHS)
				{
					UTGameAddArmorLayer(p->kind, p->amount);
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					UTGamePickupSnd(p);
				}
				else if (p->kind == UT_PICK_AMMO)
				{
					ut_ammo += ToI64(p->amount);
					ut_weap_ammo[ut_weap_cur] += ToI64(p->amount);
					if (ut_ammo > UT_GM_MAX_AMMO)
						ut_ammo = UT_GM_MAX_AMMO;
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					UTGamePickupSnd(p);
				}
				else if (p->kind == UT_PICK_WEAPON)
				{
					if (p->weap_id >= 0)
						UTWeapGive(p->weap_id);
					ut_ammo += ToI64(p->amount);
					p->taken = TRUE;
					if (ut_weapons_stay)
						p->respawn_at = tS + 0.75;
					else
						p->respawn_at = tS + p->respawn_time;
					UTGamePickupSnd(p);
					if (p->weap_id >= 0)
						UTMsgCenter(ut_weap_def[p->weap_id].name);
				}
				else if (p->kind == UT_PICK_UDAMAGE)
				{
					ut_damage_scale = 3.0;
					ut_udamage_until = tS + p->amount;
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					UTGamePickupSnd(p);
					UTMsgCenter("DAMAGE AMP!");
				}
				else if (p->kind == UT_PICK_INVIS)
				{
					ut_invis_until = tS + p->amount;
					p->taken = TRUE;
					p->respawn_at = tS + p->respawn_time;
					UTGamePickupSnd(p);
					UTMsgCenter("INVISIBILITY!");
				}
			}
		}
		i++;
	}
}

U0 UTGamePlaceBots()
{
	I64 i;
	F64 ang;
	I64 starts;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	F64 spots[UT_GM_BOT_MAX * 3];
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	starts = 0;
	if (ut_bot_count < 0)
		ut_bot_count = 0;
	if (ut_bot_count > UT_GM_BOT_MAX)
		ut_bot_count = UT_GM_BOT_MAX;
	if (ut_map_pkg != NULL)
	{
		i = 0;
		while (i < ut_map_pkg->export_count && starts < UT_GM_BOT_MAX)
		{
			e = &ut_map_pkg->exports[i];
			cls = UTPkgClassName(ut_map_pkg, e->class_index);
			if (!StrCompare(cls, "PlayerStart") ||
				!StrCompare(cls, "PlayerStart_Trophy"))
			{
				if (UTPropFindStructVec(ut_map_pkg, e->serial_offset,
					e->serial_size, "Location", v))
				{
					dx = v[0] - ut_spawn[0];
					dy = v[1] - ut_spawn[1];
					dz = v[2] - ut_spawn[2];
					d2 = dx * dx + dy * dy + dz * dz;
					if (d2 > 200.0 * 200.0)
					{
						spots[starts * 3] = v[0];
						spots[starts * 3 + 1] = v[1];
						spots[starts * 3 + 2] = v[2];
						starts++;
					}
				}
			}
			i++;
		}
	}
	i = 0;
	while (i < UT_GM_BOT_MAX)
	{
		ang = ToF64(i) * 1.3;
		if (i < starts)
		{
			ut_bots[i].origin[0] = spots[i * 3];
			ut_bots[i].origin[1] = spots[i * 3 + 1];
			ut_bots[i].origin[2] = spots[i * 3 + 2];
		}
		else
		{
			ut_bots[i].origin[0] = ut_spawn[0] + Cos(ang) * 500.0;
			ut_bots[i].origin[1] = ut_spawn[1] + Sin(ang) * 500.0;
			ut_bots[i].origin[2] = ut_spawn[2];
		}
		if (ut_bsp != NULL)
			UTPhysSnapToFloor(ut_bsp, ut_bots[i].origin);
		ut_bots[i].vel[0] = 0;
		ut_bots[i].vel[1] = 0;
		ut_bots[i].vel[2] = 0;
		ut_bots[i].yaw = ang * 10000.0;
		ut_bots[i].health = 100.0;
		ut_bots[i].armor = 0.0;
		ut_bots[i].shoot_t = tS + 4.0;
		ut_bots[i].alive = (i < ut_bot_count);
		ut_bots[i].obj_id = -1;
		ut_bots[i].score = 0;
		ut_bots[i].weap = UT_WEAP_SHOCK;
		ut_bots[i].state = 0;
		ut_bots[i].team = 0;
		ut_bots[i].order = 0;
		ut_bots[i].fort_i = -1;
		ut_bots[i].path_i = -1;
		ut_bots[i].patrol_i = -1;
		if (ut_balance_teams && (ut_ctf_active || ut_dom_active))
			ut_bots[i].team = i & 1;
		i++;
	}
	UTGameAssignAssaultOrders;
}

U0 UTGameAssignAssaultOrders()
{//= Assault.SetDefenseFor / AttackFort / SetOrders.
	I64 i;
	I64 fi;
	I64 n_def;
	I64 n_atk;

	if (!ut_as_active || ut_fort_n < 1)
		return;
	UTCTFClearFortDefenders;
	n_def = 0;
	n_atk = 0;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			//even = defend (Blue), odd = attack (Red)
			if ((i & 1) == 0)
			{
				ut_bots[i].team = UT_TEAM_BLUE;
				ut_bots[i].order = 2;
				fi = UTCTFBestDefendFort(i);
				ut_bots[i].fort_i = fi;
				if (fi >= 0)
					ut_forts[fi].defender_bot = i;
				n_def++;
			}
			else
			{
				ut_bots[i].team = UT_TEAM_RED;
				ut_bots[i].order = 1;
				ut_bots[i].fort_i = UTCTFBestAttackFort;
				n_atk++;
			}
		}
		i++;
	}
	UTLog("UTGame: AS orders def=%d atk=%d forts=%d\n",
		n_def, n_atk, ut_fort_n);
}

U0 UTGameMutFlagsFromMenu()
{
	I64 i;
	U8 *nm;

	ut_mut_arena = FALSE;
	ut_mut_noredeem = FALSE;
	ut_mut_nopower = FALSE;
	ut_mut_stealth = FALSE;
	ut_mut_relic_death = FALSE;
	ut_mut_relic_redemp = FALSE;
	ut_mut_fatboy = FALSE;
	i = 0;
	while (i < ut_menu_mut_used_n)
	{
		nm = ut_menu_mut_used[i];
		if (StrFind("Arena", nm))
			ut_mut_arena = TRUE;
		else if (StrFind("NoRedeemer", nm))
			ut_mut_noredeem = TRUE;
		else if (StrFind("NoPowerups", nm))
			ut_mut_nopower = TRUE;
		else if (StrFind("Stealth", nm))
			ut_mut_stealth = TRUE;
		else if (StrFind("RelicDeath", nm) || StrFind("DeathRelic", nm))
			ut_mut_relic_death = TRUE;
		else if (StrFind("RelicRedemption", nm) || StrFind("Redemption", nm))
			ut_mut_relic_redemp = TRUE;
		else if (StrFind("FatBoy", nm) || StrFind("Fatboy", nm))
			ut_mut_fatboy = TRUE;
		i++;
	}
}

U0 UTGameApplyMutators()
{//= Botpack Mutator chain host effects from UWindow used list
	I64 i;
	U8 *nm;

	ut_phys_gravity = UTZoneGravityMag;
	ut_damage_scale = 1.0;
	ut_bot_sight = UT_GM_BOT_SIGHT * (0.45 + ToF64(ut_bot_skill) * 0.12);
	ut_bot_shot_cd = UT_GM_BOT_SHOT_CD * (1.45 - ToF64(ut_bot_skill) * 0.12);
	if (ut_bot_shot_cd < 0.35)
		ut_bot_shot_cd = 0.35;
	UTGameMutFlagsFromMenu;
	i = 0;
	while (i < ut_menu_mut_used_n)
	{
		nm = ut_menu_mut_used[i];
		if (StrFind("LowGrav", nm) || StrFind("Gravity", nm))
		{
			ut_phys_gravity *= 0.35;
			UTLog("UTGame: mut LowGrav g=%.0f\n", ut_phys_gravity);
		}
		else if (StrFind("InstaGib", nm) || StrFind("Instagib", nm))
		{
			ut_damage_scale = 10.0;
			ut_ammo = 999;
			UTLog("UTGame: mut InstaGib\n");
		}
		else if (StrFind("Arena", nm))
			UTLog("UTGame: mut Arena (Shock only)\n");
		else if (StrFind("NoRedeemer", nm))
			UTLog("UTGame: mut NoRedeemer\n");
		else if (StrFind("NoPowerups", nm))
			UTLog("UTGame: mut NoPowerups\n");
		else if (StrFind("Stealth", nm))
		{
			ut_bot_sight *= 0.35;
			UTLog("UTGame: mut Stealth sight=%.0f\n", ut_bot_sight);
		}
		else if (StrFind("RelicDeath", nm) || StrFind("DeathRelic", nm))
		{
			ut_mut_relic_death = TRUE;
			ut_damage_scale = 2.5;
			UTLog("UTGame: mut RelicDeath\n");
		}
		else if (StrFind("RelicRedemption", nm) || StrFind("Redemption", nm))
		{
			ut_mut_relic_redemp = TRUE;
			UTLog("UTGame: mut RelicRedemption\n");
		}
		else if (StrFind("FatBoy", nm) || StrFind("Fatboy", nm))
		{
			ut_mut_fatboy = TRUE;
			ut_health = 199.0;
			UTLog("UTGame: mut FatBoy\n");
		}
		else
			UTLog("UTGame: mut %s\n", nm);
		i++;
	}
	if (ut_mut_arena)
	{
		i = 0;
		while (i < UT_WEAP_N)
		{
			ut_weap_owned[i] = FALSE;
			ut_weap_ammo[i] = 0;
			i++;
		}
		ut_weap_owned[UT_WEAP_SHOCK] = TRUE;
		ut_weap_ammo[UT_WEAP_SHOCK] = 999;
		ut_weap_cur = UT_WEAP_SHOCK;
		ut_ammo = 999;
	}
	if (ut_mut_noredeem)
	{
		ut_weap_owned[UT_WEAP_REDEEMER] = FALSE;
		ut_weap_ammo[UT_WEAP_REDEEMER] = 0;
	}
	if (ut_menu_mut_used_n > 0 && ut_obj_gameinfo >= 0)
		UTVMCallSelf("SetOrders", ut_obj_gameinfo,
			UTObjBagForSlot(ut_obj_gameinfo), 32);
}

U0 UTGameInit()
{
	ut_health = 100.0;
	UTGameArmorClear;
	ut_ammo = 50;
	ut_frags = 0;
	ut_deaths = 0;
	ut_kill_streak = 0;
	ut_spree_count = 0;
	ut_first_blood = FALSE;
	ut_multi_until = 0.0;
	ut_alive = TRUE;
	ut_fire_t = 0.0;
	ut_respawn_t = 0.0;
	ut_pick_n = 0;
	ut_suicide_latched = FALSE;
	ut_dropflag_latched = FALSE;
	ut_killer_bot = -1;
	ut_match_over = FALSE;
	ut_damage_scale = 1.0;
	ut_udamage_until = 0.0;
	ut_invis_until = 0.0;
	if (ut_menu_frag >= 5)
		ut_frag_limit = ut_menu_frag;
	if (ut_menu_bots >= 0)
		ut_bot_count = ut_menu_bots;
	ut_time_limit = ut_menu_time;
	if (ut_time_limit < 0)
		ut_time_limit = 0;
	if (ut_time_limit > 60)
		ut_time_limit = 60;
	ut_match_end_t = 0.0;
	if (ut_time_limit > 0)
		ut_match_end_t = tS + ToF64(ut_time_limit) * 60.0;
	ut_was_in_water = FALSE;
	ut_bot_sight = UT_GM_BOT_SIGHT;
	ut_bot_shot_cd = UT_GM_BOT_SHOT_CD;
	ut_weapons_stay = ut_menu_weapons_stay;
	ut_force_respawn = ut_menu_force_respawn;
	ut_tournament = ut_menu_tournament;
	ut_bot_skill = ut_menu_bot_skill;
	ut_balance_teams = ut_menu_balance;
	ut_friendly_fire = ut_menu_friendly_fire;
	if (ut_bot_skill < 0)
		ut_bot_skill = 0;
	if (ut_bot_skill > 7)
		ut_bot_skill = 7;
	ut_bot_sight = UT_GM_BOT_SIGHT * (0.45 + ToF64(ut_bot_skill) * 0.12);
	ut_bot_shot_cd = UT_GM_BOT_SHOT_CD * (1.45 - ToF64(ut_bot_skill) * 0.12);
	if (ut_bot_shot_cd < 0.35)
		ut_bot_shot_cd = 0.35;
	if (ut_tournament)
	{
		ut_force_respawn = TRUE;
		ut_weapons_stay = FALSE;
	}
	UTWeapInit;
	UTDecalInit;
	UTFxInit;
	UTGameMutFlagsFromMenu;
	if (ut_map_pkg != NULL)
	{
		UTGameScanPickups(ut_map_pkg);
		UTActorScanPackage(ut_map_pkg);
		UTActorScanDrawables(ut_map_pkg);
		UTZoneScanPackage(ut_map_pkg);
		UTCTFScanPackage(ut_map_pkg);
		UTLightScanPackage(ut_map_pkg);
		UTPathScanPackage(ut_map_pkg);
	}
	UTGamePlaceBots;
	UTPhysInit;
	ut_phys_gravity = UTZoneGravityMag;
	UTVecCopy(ut_spawn, ut_origin);
	ut_view_yaw = ut_spawn_yaw & 0xFFFF;
	ut_view_pitch = ut_spawn_pitch;
	if (ut_bsp != NULL)
		UTPhysSnapToFloor(ut_bsp, ut_origin);
	UTVecCopy(ut_origin, ut_spawn);
	ut_health = 100.0;
	ut_alive = TRUE;
	ut_bot_grace_until = tS + 5.0;
	ut_oob_since = 0.0;
	ut_breath = 20.0;
	ut_game_ready = TRUE;
	UTObjInitGame;
	if (ut_ctf_active || ut_dom_active || ut_as_active)
	{
		ut_cap_limit = ut_menu_cap;
		if (ut_cap_limit < 1)
			ut_cap_limit = ut_frag_limit;
		if (ut_cap_limit < 1)
			ut_cap_limit = 5;
	}
	UTCTFStartAssault;
	UTGameAssignAssaultOrders;
	UTGameApplyMutators;
	UTReplClear;
	UTReplBindObj;
	UTReplSync;
	UTSaveScanSlots;
	UTLog("UTGame: ready bots=%d picks=%d lights=%d fraglimit=%d eye=%.0f %.0f %.0f floor=%d\n",
		ut_bot_count, ut_pick_n, ut_light_n, ut_frag_limit,
		ut_origin[0], ut_origin[1], ut_origin[2], ToI64(ut_floor_hit));
}

Bool ut_script_gameinfo = FALSE;
F64  ut_gameinfo_acc = 0.0;		//seconds since the last GameInfo.Timer

Bool UTGameInfoEvent(U8 *fn_name, F64 arg)
{
	I64 steps;

	if (!ut_script_gameinfo || ut_obj_gameinfo < 0)
		return FALSE;
	ut_vm_arg_seed = arg;
	ut_vm_arg_seed_on = TRUE;
	steps = UTVMCallSelf(fn_name, ut_obj_gameinfo,
		UTObjBagForSlot(ut_obj_gameinfo), 4096);
	return steps > 0;
}

U0 UTGameRespawn()
{
	I64 i;
	I64 j;
	I64 best;
	I64 yaw;
	F64 best_d;
	F64 d;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 min_bot;
	F64 pos[3];

	yaw = ut_spawn_yaw;
	UTVecCopy(ut_spawn, pos);
	if (ut_start_n > 0)
	{
		best = 0;
		best_d = -1.0;
		i = 0;
		while (i < ut_start_n)
		{
			min_bot = 1.0e12;
			j = 0;
			while (j < UT_GM_BOT_MAX)
			{
				if (ut_bots[j].alive)
				{
					dx = ut_starts[i * 3] - ut_bots[j].origin[0];
					dy = ut_starts[i * 3 + 1] - ut_bots[j].origin[1];
					dz = ut_starts[i * 3 + 2] - ut_bots[j].origin[2];
					d = dx * dx + dy * dy + dz * dz;
					if (d < min_bot)
						min_bot = d;
				}
				j++;
			}
			if (min_bot > best_d)
			{
				best_d = min_bot;
				best = i;
			}
			i++;
		}
		pos[0] = ut_starts[best * 3];
		pos[1] = ut_starts[best * 3 + 1];
		pos[2] = ut_starts[best * 3 + 2];
		yaw = ut_start_yaw[best];
	}
	UTVecCopy(pos, ut_origin);
	ut_view_yaw = yaw & 0xFFFF;
	ut_view_pitch = ut_spawn_pitch;
	ut_health = 100.0;
	UTGameArmorClear;
	ut_ammo = 50;
	ut_alive = TRUE;
	ut_respawn_t = 0.0;
	ut_killer_bot = -1;
	ut_damage_scale = 1.0;
	ut_view_target = -1;
	ut_suicide_latched = FALSE;
	ut_dropflag_latched = FALSE;
	ut_breath = 20.0;
	ut_invis_until = 0.0;
	UTPhysInit;
	if (ut_bsp != NULL)
		UTPhysSnapToFloor(ut_bsp, ut_origin);
	UTLog("UTGame: respawn eye=%.0f %.0f %.0f floor=%d\n",
		ut_origin[0], ut_origin[1], ut_origin[2], ut_floor_hit);
}

U0 UTGameKillPlayer()
{
	if (!ut_alive)
		return;
	ut_alive = FALSE;
	ut_deaths++;
	if (ut_force_respawn)
		ut_respawn_t = tS;
	else
		ut_respawn_t = tS + 3.0;
	ut_health = 0.0;
	ut_kill_streak = 0;
	ut_spree_count = 0;
	UTCTFDropFlag;
	UTGameArmorClear;
	if (ut_killer_bot >= 0 && ut_killer_bot < UT_GM_BOT_MAX)
		ut_bots[ut_killer_bot].score++;
	ut_death_look[0] = ut_origin[0];
	ut_death_look[1] = ut_origin[1];
	ut_death_look[2] = ut_origin[2] + 48.0;
	ut_death_cam_yaw = ToF64(ut_view_yaw);
	if (ut_snd_die_i >= 0)
		UTSndPlay(ut_snd_die_i, 1.0);
	if (ut_snd_ann_lost >= 0)
		UTSndPlay(ut_snd_ann_lost, 0.7);
	UTMsgCenter("You were killed");
	UTLog("UTGame: death deaths=%d\n", ut_deaths);
}

Bool UTGameTakeDamageScript(F64 amount)
{
	I64 obj;
	I64 steps;

	if (!ut_script_actors || ut_obj_pawn < 0)
		return FALSE;
	ut_vm_arg_seed = amount;
	ut_vm_arg_seed_on = TRUE;
	steps = UTVMCallSelf("TakeDamage", ut_obj_pawn,
		UTObjBagForSlot(ut_obj_pawn), 4096);
	if (steps < 1)
		return FALSE;
	if (UTObjBagForSlot(ut_obj_pawn))
		ut_health = UTObjBagForSlot(ut_obj_pawn)->health;
	if (ut_health <= 0.0)
		UTGameKillPlayer;
	return TRUE;
}

U0 UTGameTakeDamage(F64 amount)
{
	F64 left;
	F64 absorbed;
	F64 take;

	if (!ut_alive || amount <= 0.0)
		return;
	if (UTGameTakeDamageScript(amount))
		return;
	if (ut_god)
		return;
	left = amount;
	if (ut_armor_belt > 0.0 && left > 0.0)
	{
		take = left;
		if (take > ut_armor_belt)
			take = ut_armor_belt;
		ut_armor_belt -= take;
		left -= take;
	}
	if (ut_armor_body > 0.0 && left > 0.0)
	{
		absorbed = left * UT_ARM_ABSORB_BODY;
		if (absorbed > ut_armor_body)
			absorbed = ut_armor_body;
		ut_armor_body -= absorbed;
		left -= absorbed;
	}
	if (ut_armor_pads > 0.0 && left > 0.0)
	{
		absorbed = left * UT_ARM_ABSORB_PADS;
		if (absorbed > ut_armor_pads)
			absorbed = ut_armor_pads;
		ut_armor_pads -= absorbed;
		left -= absorbed;
	}
	UTGameArmorSyncHUD;
	ut_health -= left;
	UTSoftDamageFlash(amount);
	ut_hit_flash_t = tS + 0.55;
	ut_view_shake = amount * 0.12;
	if (ut_view_shake > 18.0)
		ut_view_shake = 18.0;
	if (ut_killer_bot >= 0 && ut_killer_bot < UT_GM_BOT_MAX)
	{
		ut_hit_dir_x = ut_bots[ut_killer_bot].origin[0] - ut_origin[0];
		ut_hit_dir_y = ut_bots[ut_killer_bot].origin[1] - ut_origin[1];
	}
	if (ut_snd_pain_i >= 0 && tS >= ut_pain_snd_t)
	{
		UTSndPlay(ut_snd_pain_i, 0.8);
		ut_pain_snd_t = tS + 0.45;
	}
	if (ut_health <= 0.0)
		UTGameKillPlayer;
}

Bool UTGameTraceBot(F64 *start, F64 *dir, F64 range, I64 *hit_i, F64 *hit_dist)
{
	I64 i;
	I64 best;
	F64 best_t;
	F64 to[3];
	F64 lat[3];
	F64 along;
	F64 lat_len;
	F64 rad;

	best = -1;
	best_t = range;
	rad = 40.0;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			to[0] = ut_bots[i].origin[0] - start[0];
			to[1] = ut_bots[i].origin[1] - start[1];
			to[2] = ut_bots[i].origin[2] - start[2];
			along = to[0] * dir[0] + to[1] * dir[1] + to[2] * dir[2];
			if (along > 0.0 && along < best_t)
			{
				lat[0] = to[0] - dir[0] * along;
				lat[1] = to[1] - dir[1] * along;
				lat[2] = to[2] - dir[2] * along;
				lat_len = Sqrt(lat[0] * lat[0] + lat[1] * lat[1] + lat[2] * lat[2]);
				if (lat_len < rad)
				{
					best = i;
					best_t = along;
				}
			}
		}
		i++;
	}
	*hit_i = best;
	*hit_dist = best_t;
	return best >= 0;
}

U0 UTGameAnnounceMulti(I64 streak)
{//Botpack multi-kill chain (3s window).
	if (streak == 2 && ut_snd_ann_double >= 0)
		UTSndPlay(ut_snd_ann_double, 1.0);
	else if (streak == 3)
	{
		if (ut_snd_ann_triple >= 0)
			UTSndPlay(ut_snd_ann_triple, 1.0);
		else if (ut_snd_ann_multi >= 0)
			UTSndPlay(ut_snd_ann_multi, 1.0);
	}
	else if (streak == 4 && ut_snd_ann_multi >= 0)
		UTSndPlay(ut_snd_ann_multi, 1.0);
	else if (streak == 5 && ut_snd_ann_ultra >= 0)
		UTSndPlay(ut_snd_ann_ultra, 1.0);
	else if (streak == 6 && ut_snd_ann_monster >= 0)
		UTSndPlay(ut_snd_ann_monster, 1.0);
	else if (streak >= 7)
	{
		if (ut_snd_ann_mega >= 0)
			UTSndPlay(ut_snd_ann_mega, 1.0);
		else if (ut_snd_ann_monster >= 0)
			UTSndPlay(ut_snd_ann_monster, 1.0);
	}
}

U0 UTGameAnnounceSpree(I64 spree)
{
	if (spree == 5 && ut_snd_ann_spree >= 0)
		UTSndPlay(ut_snd_ann_spree, 1.0);
	else if (spree == 10 && ut_snd_ann_rampage >= 0)
		UTSndPlay(ut_snd_ann_rampage, 1.0);
	else if (spree == 15 && ut_snd_ann_dominating >= 0)
		UTSndPlay(ut_snd_ann_dominating, 1.0);
	else if (spree == 20 && ut_snd_ann_unstoppable >= 0)
		UTSndPlay(ut_snd_ann_unstoppable, 1.0);
	else if (spree == 25 && ut_snd_ann_godlike >= 0)
		UTSndPlay(ut_snd_ann_godlike, 1.0);
}

U0 UTGameFragBot(I64 hit)
{
	CUTBot *bot;
	F64 ang;

	if (hit < 0 || hit >= UT_GM_BOT_MAX)
		return;
	bot = &ut_bots[hit];
	bot->alive = FALSE;
	bot->health = 0.0;
	ut_frags++;
	if (!ut_first_blood)
	{
		ut_first_blood = TRUE;
		if (ut_snd_ann_first >= 0)
			UTSndPlay(ut_snd_ann_first, 1.0);
	}
	if (tS < ut_multi_until)
		ut_kill_streak++;
	else
		ut_kill_streak = 1;
	ut_multi_until = tS + 3.0;
	ut_spree_count++;
	UTGameAnnounceMulti(ut_kill_streak);
	UTGameAnnounceSpree(ut_spree_count);
	UTMsgCenter("You fragged a bot");
	if (ut_mut_relic_redemp)
	{
		ut_health += 25.0;
		if (ut_health > 199.0)
			ut_health = 199.0;
		UTMsgCenter("Redemption!");
	}
	if (ut_mut_relic_death)
		UTSoftDamageFlash(40.0);
	if (ut_weap_cur == UT_WEAP_SNIPER && ut_snd_ann_head >= 0)
		UTSndPlay(ut_snd_ann_head, 1.0);
	if (ut_frags >= ut_frag_limit)
	{
		ut_match_over = TRUE;
		UTMsgCenter("Frag Limit!");
	}
	UTLog("UTGame: frag bot=%d frags=%d multi=%d spree=%d\n", hit, ut_frags,
		ut_kill_streak, ut_spree_count);
	UTFxBurst(bot->origin, 10, 40);
	ang = ToF64(hit + ut_frags) * 1.7;
	bot->origin[0] = ut_spawn[0] + Cos(ang) * 280.0;
	bot->origin[1] = ut_spawn[1] + Sin(ang) * 280.0;
	bot->origin[2] = ut_spawn[2];
	bot->health = 100.0;
	bot->armor = 0.0;
	bot->alive = TRUE;
	bot->state = 1;
	bot->path_i = -1;
}

U0 UTGameAutoAim(F64 *origin, F64 *dir, F64 range)
{
	I64 i;
	I64 best;
	F64 best_score;
	F64 to[3];
	F64 len;
	F64 along;
	F64 lat;
	F64 score;
	F64 aim[3];

	if (!ut_opt_autoaim)
		return;
	if (!origin || !dir || range < 1.0)
		return;
	best = -1;
	best_score = 0.0;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			to[0] = ut_bots[i].origin[0] - origin[0];
			to[1] = ut_bots[i].origin[1] - origin[1];
			to[2] = ut_bots[i].origin[2] + 20.0 - origin[2];
			len = UTVecLength(to);
			if (len > 1.0 && len < range)
			{
				along = (to[0] * dir[0] + to[1] * dir[1] + to[2] * dir[2]) / len;
				if (along > 0.92)
				{
					if (along > 1.0)
						along = 1.0;
					lat = Sqrt(1.0 - along * along) * len;
					if (lat < 90.0)
					{
						score = along * (1.0 - lat / 90.0);
						if (score > best_score)
						{
							best_score = score;
							best = i;
						}
					}
				}
			}
		}
		i++;
	}
	if (best < 0)
		return;
	aim[0] = ut_bots[best].origin[0] - origin[0];
	aim[1] = ut_bots[best].origin[1] - origin[1];
	aim[2] = ut_bots[best].origin[2] + 20.0 - origin[2];
	len = UTVecLength(aim);
	if (len < UT_SMALL_NUMBER)
		return;
	aim[0] /= len; aim[1] /= len; aim[2] /= len;
	dir[0] = dir[0] * 0.35 + aim[0] * 0.65;
	dir[1] = dir[1] * 0.35 + aim[1] * 0.65;
	dir[2] = dir[2] * 0.35 + aim[2] * 0.65;
	len = UTVecLength(dir);
	if (len < UT_SMALL_NUMBER)
		return;
	dir[0] /= len; dir[1] /= len; dir[2] /= len;
}

U0 UTGameHitScan(F64 *origin, F64 *dir, F64 damage, F64 range)
{//TournamentWeapon TraceFire; UModel UnTrace when !ut_alive.
	I64 hit;
	F64 dist;
	F64 ndir[3];
	F64 len;
	F64 dmg;
	F64 impact[3];
	F64 hit_d;

	if (!origin || !dir || damage <= 0.0)
		return;
	UTVecCopy(dir, ndir);
	len = UTVecLength(ndir);
	if (len < UT_SMALL_NUMBER)
		return;
	ndir[0] /= len; ndir[1] /= len; ndir[2] /= len;
	UTGameAutoAim(origin, ndir, range);

	if (!ut_alive)
	{
		hit_d = 0.0;
		if (ut_bsp && UTPhysTrace(ut_bsp, origin, ndir, range, impact, &hit_d))
		{
			if (ut_snd_fire_i >= 0)
				UTSndPlay(ut_snd_fire_i, 0.6);
			no_warn damage;
			no_warn hit_d;
		}
		return;
	}

	dmg = damage * ut_damage_scale;
	if (UTGameTraceBot(origin, ndir, range, &hit, &dist))
	{
		ut_bots[hit].health -= dmg;
		impact[0] = origin[0] + ndir[0] * dist;
		impact[1] = origin[1] + ndir[1] * dist;
		impact[2] = origin[2] + ndir[2] * dist;
		UTDecalBlood(impact);
		if (ut_bots[hit].health <= 0.0)
			UTGameFragBot(hit);
	}
}

U0 UTGameBotShootPlayer(I64 bi)
{//bot hitscan toward player — TournamentBot TraceFire soft.
	CUTBot *bot;
	F64 dir[3];
	F64 len;
	F64 dmg;

	bot = &ut_bots[bi];
	if (!bot->alive || !ut_alive)
		return;
	if (tS < ut_bot_grace_until)
		return;
	if (tS < bot->shoot_t)
		return;
	if (tS < ut_invis_until)
	{
		dir[0] = ut_origin[0] - bot->origin[0];
		dir[1] = ut_origin[1] - bot->origin[1];
		dir[2] = ut_origin[2] - bot->origin[2];
		len = UTVecLength(dir);
		if (len > 220.0)
			return;
	}
	if (!ut_friendly_fire && (ut_ctf_active || ut_dom_active || ut_as_active))
	{
		if ((bot->team & 1) == (ut_player_team & 1))
			return;
	}
	dir[0] = ut_origin[0] - bot->origin[0];
	dir[1] = ut_origin[1] - bot->origin[1];
	dir[2] = ut_origin[2] + 20.0 - bot->origin[2];
	len = UTVecLength(dir);
	if (len < 1.0 || len > ut_bot_sight)
		return;
	dir[0] /= len; dir[1] /= len; dir[2] /= len;
	bot->yaw = ToF64(UTVecYaw(dir));
	dmg = 12.0 + ToF64(bot->weap) * 2.0;
	UTGameTakeDamage(dmg);
	ut_killer_bot = bi;
	bot->shoot_t = tS + ut_bot_shot_cd;
	if (ut_snd_fire_i >= 0)
		UTSndPlay(ut_snd_fire_i, 0.35);
}

I64 UTGameNearestPickup(F64 *org, I64 want_kind)
{//Nearest untaken pickup; want_kind 0 = any useful (health/armor/ammo).
	I64 i;
	I64 best;
	F64 best_d;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d;
	CUTPickup *p;
	Bool ok;

	best = -1;
	best_d = 1.0e12;
	if (!org)
		return -1;
	i = 0;
	while (i < ut_pick_n)
	{
		p = &ut_picks[i];
		ok = FALSE;
		if (!p->taken)
		{
			if (want_kind == 0)
			{
				if (p->kind == UT_PICK_HEALTH ||
					p->kind == UT_PICK_SUPERHEALTH ||
					p->kind == UT_PICK_ARMOR ||
					p->kind == UT_PICK_SHIELD ||
					p->kind == UT_PICK_THIGHS ||
					p->kind == UT_PICK_AMMO)
					ok = TRUE;
			}
			else if (p->kind == want_kind)
				ok = TRUE;
		}
		if (ok)
		{
			dx = p->origin[0] - org[0];
			dy = p->origin[1] - org[1];
			dz = p->origin[2] - org[2];
			d = dx * dx + dy * dy + dz * dz;
			if (d < best_d)
			{
				best_d = d;
				best = i;
			}
		}
		i++;
	}
	return best;
}

U0 UTGameBotSteer(CUTBot *bot, F64 *goal, F64 speed, F64 dt)
{
	F64 wish[3];
	F64 dx;
	F64 dy;
	F64 dz;
	F64 dist;
	I64 ni;

	if (!bot || !goal)
		return;
	if (ut_path_ready && ut_path_n > 0)
	{
		ni = bot->path_i;
		if (ni < 0 || ni >= ut_path_n || !ut_path[ni].alive)
			ni = UTPathToward(bot->origin, goal);
		if (ni >= 0)
		{
			dx = ut_path[ni].origin[0] - bot->origin[0];
			dy = ut_path[ni].origin[1] - bot->origin[1];
			dz = ut_path[ni].origin[2] - bot->origin[2];
			dist = Sqrt(dx * dx + dy * dy + dz * dz);
			if (dist < 72.0)
			{
				bot->path_i = UTPathToward(bot->origin, goal);
				ni = bot->path_i;
				if (ni >= 0)
				{
					dx = ut_path[ni].origin[0] - bot->origin[0];
					dy = ut_path[ni].origin[1] - bot->origin[1];
					dz = ut_path[ni].origin[2] - bot->origin[2];
					dist = Sqrt(dx * dx + dy * dy + dz * dz);
				}
			}
			else
				bot->path_i = ni;
			if (ni >= 0 && dist > 1.0)
			{
				wish[0] = dx; wish[1] = dy; wish[2] = 0.0;
				UTVecNormalize(wish);
				bot->origin[0] += wish[0] * speed * dt;
				bot->origin[1] += wish[1] * speed * dt;
				if (dz > 8.0)
					bot->origin[2] += 60.0 * dt;
				else if (dz < -8.0)
					bot->origin[2] -= 60.0 * dt;
				bot->yaw = ToF64(UTVecYaw(wish));
				return;
			}
		}
	}
	dx = goal[0] - bot->origin[0];
	dy = goal[1] - bot->origin[1];
	dz = goal[2] - bot->origin[2];
	wish[0] = dx; wish[1] = dy; wish[2] = 0.0;
	if (UTVecLength(wish) > UT_SMALL_NUMBER)
	{
		UTVecNormalize(wish);
		bot->origin[0] += wish[0] * speed * dt;
		bot->origin[1] += wish[1] * speed * dt;
		if (dz > 8.0)
			bot->origin[2] += 60.0 * dt;
		else if (dz < -8.0)
			bot->origin[2] -= 60.0 * dt;
		bot->yaw = ToF64(UTVecYaw(wish));
	}
}

Bool ut_script_bots = FALSE;

I64 UTGameBotEnsureObj(I64 i)
{
	U8 nm[48];

	if (i < 0 || i >= UT_GM_BOT_MAX)
		return -1;
	if (ut_bots[i].obj_id >= 0)
		return ut_bots[i].obj_id;
	StrPrint(nm, "Bot%d", i);
	ut_bots[i].obj_id = UTObjNew(nm, "TMale1",
		"::/Apps/UT99/System/Botpack.u");
	if (ut_bots[i].obj_id < 0)
		ut_bots[i].obj_id = UTObjNew(nm, "Bot",
			"::/Apps/UT99/System/Botpack.u");
	return ut_bots[i].obj_id;
}

Bool UTGameBotTickScript(I64 i, F64 dt)
{//State/position live in the bag; copy in before and out after, the native mover and renderer read the struct.
	I64 obj;
	I64 steps;
	CUTPropBag *bag;

	if (!ut_script_bots || i < 0 || i >= UT_GM_BOT_MAX)
		return FALSE;
	if (!ut_bots[i].alive)
		return FALSE;
	obj = UTGameBotEnsureObj(i);
	if (obj < 0)
		return FALSE;
	bag = UTObjBagForSlot(obj);
	if (!bag)
		return FALSE;
	UTVecCopy(ut_bots[i].origin, bag->location);
	bag->has_location = TRUE;
	bag->health = ut_bots[i].health;
	bag->rotation[1] = ToI64(ut_bots[i].yaw);
	bag->has_rotation = TRUE;
	ut_vm_arg_seed = dt;
	ut_vm_arg_seed_on = TRUE;
	steps = UTVMCallSelf("Tick", obj, bag, 4096);
	if (steps < 1)
		return FALSE;
	UTVecCopy(bag->location, ut_bots[i].origin);
	ut_bots[i].health = bag->health;
	ut_bots[i].yaw = ToF64(bag->rotation[1]);
	if (ut_bots[i].health <= 0.0)
		ut_bots[i].alive = FALSE;
	return TRUE;
}

U0 UTGameTickBots(F64 dt)
{
	I64 i;
	I64 ni;
	I64 hk;
	CUTBot *bot;
	CUTFort *ft;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 dist;
	F64 speed;
	F64 wish[3];
	F64 goal[3];
	F64 tx;
	F64 ty;
	F64 tz;

	i = 0;
	while (i < UT_GM_BOT_N)
	{
		bot = &ut_bots[i];
		//ZealC has no continue.
		if (bot->alive && !UTGameBotTickScript(i, dt))
		{
			if (ut_as_active && bot->fort_i >= 0 &&
				bot->fort_i < ut_fort_n &&
				ut_forts[bot->fort_i].alive)
			{
				ft = &ut_forts[bot->fort_i];
				tx = ft->origin[0];
				ty = ft->origin[1];
				tz = ft->origin[2];
				dx = tx - bot->origin[0];
				dy = ty - bot->origin[1];
				dz = tz - bot->origin[2];
				dist = Sqrt(dx * dx + dy * dy + dz * dz);
				goal[0] = tx; goal[1] = ty; goal[2] = tz;
				if (bot->order == 2)
				{
					if (dist > 180.0)
					{
						UTGameBotSteer(bot, goal, 220.0, dt);
						bot->state = 1;
					}
					else
					{
						bot->state = 0;
						if (ut_path_defense_n > 0)
						{
							ni = UTPathNearestDefense(bot->origin);
							if (ni >= 0)
							{
								goal[0] = ut_path[ni].origin[0];
								goal[1] = ut_path[ni].origin[1];
								goal[2] = ut_path[ni].origin[2];
								dx = goal[0] - bot->origin[0];
								dy = goal[1] - bot->origin[1];
								dz = goal[2] - bot->origin[2];
								dist = Sqrt(dx * dx + dy * dy + dz * dz);
								if (dist > 60.0)
									UTGameBotSteer(bot, goal, 160.0, dt);
							}
						}
					}
					dx = ut_origin[0] - bot->origin[0];
					dy = ut_origin[1] - bot->origin[1];
					dz = ut_origin[2] - bot->origin[2];
					dist = Sqrt(dx * dx + dy * dy + dz * dz);
					if (ut_alive && dist < 700.0)
					{
						bot->state = 2;
						UTGameBotShootPlayer(i);
					}
				}
				else
				{
					if (!ft->alive)
					{
						bot->fort_i = UTCTFBestAttackFort;
						if (bot->fort_i >= 0)
						{
							ft = &ut_forts[bot->fort_i];
							goal[0] = ft->origin[0];
							goal[1] = ft->origin[1];
							goal[2] = ft->origin[2];
							dx = goal[0] - bot->origin[0];
							dy = goal[1] - bot->origin[1];
							dz = goal[2] - bot->origin[2];
							dist = Sqrt(dx * dx + dy * dy + dz * dz);
						}
					}
					if (dist > 80.0)
					{
						UTGameBotSteer(bot, goal, 300.0, dt);
						bot->state = 1;
					}
					else
						bot->state = 2;
					dx = ut_origin[0] - bot->origin[0];
					dy = ut_origin[1] - bot->origin[1];
					dist = Sqrt(dx * dx + dy * dy);
					if (ut_alive && dist < 500.0)
						UTGameBotShootPlayer(i);
				}
			}
			else
			{
				//Voice SetOrders: 3=follow player, 4=hold (patrol/idle)
				if (bot->order == 3 && ut_alive)
				{
					goal[0] = ut_origin[0];
					goal[1] = ut_origin[1];
					goal[2] = ut_origin[2];
					dx = goal[0] - bot->origin[0];
					dy = goal[1] - bot->origin[1];
					dz = goal[2] - bot->origin[2];
					dist = Sqrt(dx * dx + dy * dy + dz * dz);
					if (dist > 90.0)
					{
						UTGameBotSteer(bot, goal, 280.0, dt);
						bot->state = 1;
					}
					else
						bot->state = 0;
				}
				else if (bot->order == 4)
				{
					bot->state = 0;
					if (ut_path_patrol_n > 0)
					{
						if (bot->patrol_i < 0 ||
							bot->patrol_i >= ut_path_n ||
							!ut_path[bot->patrol_i].alive)
							bot->patrol_i = UTPathNextPatrol(-1);
						if (bot->patrol_i >= 0)
						{
							goal[0] = ut_path[bot->patrol_i].origin[0];
							goal[1] = ut_path[bot->patrol_i].origin[1];
							goal[2] = ut_path[bot->patrol_i].origin[2];
							dx = goal[0] - bot->origin[0];
							dy = goal[1] - bot->origin[1];
							dz = goal[2] - bot->origin[2];
							dist = Sqrt(dx * dx + dy * dy + dz * dz);
							if (dist < 80.0)
								bot->patrol_i =
									UTPathNextPatrol(bot->patrol_i);
							else
								UTGameBotSteer(bot, goal, 140.0, dt);
						}
					}
				}
				else
				{
				dx = ut_origin[0] - bot->origin[0];
				dy = ut_origin[1] - bot->origin[1];
				dz = ut_origin[2] - bot->origin[2];
				dist = Sqrt(dx * dx + dy * dy + dz * dz);
				if (!ut_alive)
					bot->state = 0;
				else if (dist < 350.0)
					bot->state = 2;
				else if (dist < ut_bot_sight)
					bot->state = 1;
				else
					bot->state = 0;

				if (bot->state == 0)
				{
					if (bot->health < 50.0)
					{
						ni = UTGameNearestPickup(bot->origin, 0);
						if (ni >= 0)
						{
							goal[0] = ut_picks[ni].origin[0];
							goal[1] = ut_picks[ni].origin[1];
							goal[2] = ut_picks[ni].origin[2];
							UTGameBotSteer(bot, goal, 240.0, dt);
						}
						else
						{
							ni = UTPathNearestSpot(bot->origin);
							if (ni >= 0)
							{
								goal[0] = ut_path[ni].origin[0];
								goal[1] = ut_path[ni].origin[1];
								goal[2] = ut_path[ni].origin[2];
								UTGameBotSteer(bot, goal, 200.0, dt);
							}
						}
					}
					else if (ut_path_ambush_n > 0 && dist > 900.0)
					{
						ni = UTPathNearestAmbush(bot->origin);
						if (ni >= 0)
						{
							goal[0] = ut_path[ni].origin[0];
							goal[1] = ut_path[ni].origin[1];
							goal[2] = ut_path[ni].origin[2];
							UTGameBotSteer(bot, goal, 180.0, dt);
						}
					}
					else if (ut_path_patrol_n > 0)
					{
						if (bot->patrol_i < 0 ||
							bot->patrol_i >= ut_path_n ||
							!ut_path[bot->patrol_i].alive)
							bot->patrol_i = UTPathNextPatrol(-1);
						if (bot->patrol_i >= 0)
						{
							goal[0] = ut_path[bot->patrol_i].origin[0];
							goal[1] = ut_path[bot->patrol_i].origin[1];
							goal[2] = ut_path[bot->patrol_i].origin[2];
							dx = goal[0] - bot->origin[0];
							dy = goal[1] - bot->origin[1];
							dz = goal[2] - bot->origin[2];
							dist = Sqrt(dx * dx + dy * dy + dz * dz);
							if (dist < 80.0)
								bot->patrol_i =
									UTPathNextPatrol(bot->patrol_i);
							else
								UTGameBotSteer(bot, goal, 160.0, dt);
						}
					}
					else
					{
						bot->origin[0] +=
							Sin(tS * 0.6 + ToF64(i)) * 40.0 * dt;
						bot->origin[1] +=
							Cos(tS * 0.45 + ToF64(i)) * 40.0 * dt;
					}
				}
				else
				{
					goal[0] = ut_origin[0];
					goal[1] = ut_origin[1];
					goal[2] = ut_origin[2];
					speed = 280.0;
					if (bot->state == 2)
						speed = 220.0;
					UTGameBotSteer(bot, goal, speed, dt);
					if (bot->state == 2)
						UTGameBotShootPlayer(i);
					else if (dist < 900.0 && (ToI64(tS * 2.0) & 7) == i)
						UTGameBotShootPlayer(i);
				}
				}
			}
			hk = UTZoneHurtAt(bot->origin);
			if (hk == UT_ZONE_KIND_LAVA)
			{
				bot->health -= 40.0 * dt;
				if (bot->health <= 0.0)
					bot->alive = FALSE;
			}
			else if (hk == UT_ZONE_KIND_SLIME)
			{
				bot->health -= 20.0 * dt;
				if (bot->health <= 0.0)
					bot->alive = FALSE;
			}
			if (ut_lod_player.loaded)
			{
				if (bot->state >= 1)
					UTLodSetSeq(&ut_lod_player, "RunLg");
				else
					UTLodSetSeq(&ut_lod_player, "WalkLg");
			}
		}
		i++;
	}
}

U0 UTGameRadiusDamage(F64 *origin, F64 damage, F64 radius)
{
	I64 i;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d;
	F64 fall;

	if (!origin || damage <= 0.0)
		return;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		if (ut_bots[i].alive)
		{
			dx = ut_bots[i].origin[0] - origin[0];
			dy = ut_bots[i].origin[1] - origin[1];
			dz = ut_bots[i].origin[2] - origin[2];
			d = Sqrt(dx * dx + dy * dy + dz * dz);
			if (d < radius)
			{
				fall = damage * (1.0 - d / radius);
				ut_bots[i].health -= fall;
				if (ut_bots[i].health <= 0.0)
					UTGameFragBot(i);
			}
		}
		i++;
	}
	dx = ut_origin[0] - origin[0];
	dy = ut_origin[1] - origin[1];
	dz = ut_origin[2] - origin[2];
	d = Sqrt(dx * dx + dy * dy + dz * dz);
	if (d < radius)
		UTGameTakeDamage(damage * (1.0 - d / radius) * 0.5);
}

U0 UTGameDoFire()
{
	if (!ut_alive)
		return;
	UTWeapFire(FALSE);
}

U0 UTGameDispatchVM()
{
	I64 slot;

	if (ut_vm_cmd == UT_VM_CMD_FIRE)
		UTGameDoFire;
	else if (ut_vm_cmd == UT_VM_CMD_DAMAGE)
		UTGameTakeDamage(ut_vm_arg);
	else if (ut_vm_cmd == UT_VM_CMD_PLAYSND)
	{//PlaySound(264) — prefer fire, else first loaded slot
		slot = ut_snd_fire_i;
		if (slot < 0)
			slot = ut_snd_pickup_i;
		if (slot < 0 && ut_snd_n > 0)
			slot = 0;
		if (slot >= 0)
			UTSndPlay(slot, ut_vm_arg);
	}
	else if (ut_vm_cmd == UT_VM_CMD_TRACE)
		UTGameDoFire;
	else if (ut_vm_cmd == UT_VM_CMD_DRAWTEXT ||
		ut_vm_cmd == UT_VM_CMD_DRAWTILE)
	{
	}
	ut_vm_cmd = UT_VM_CMD_NONE;
}

U0 UTGameFireVM()
{
	if (!ut_alive)
		return;
	if (ut_alt_fire)
		UTWeapFire(TRUE);
	else
		UTWeapFire(FALSE);
}

U0 UTGameTick(F64 dt)
{
	F64 wish[3];
	F64 a[3];
	I64 i;

	if (!ut_game_ready)
		return;
	//GameInfo.Timer is the retail per-second rules hook.
	ut_gameinfo_acc += dt;
	if (ut_gameinfo_acc >= 1.0)
	{
		ut_gameinfo_acc = 0.0;
		UTGameInfoEvent("Timer", 1.0);
	}

	if (ut_menu_apply)
	{
		ut_menu_apply = FALSE;
		ut_frag_limit = ut_menu_frag;
		ut_bot_count = ut_menu_bots;
		if (ut_menu_mode == 2)
			ut_map_filter = UT_MAP_MODE_CTF;
		else if (ut_menu_mode == 3)
			ut_map_filter = UT_MAP_MODE_DOM;
		else if (ut_menu_mode == 4)
			ut_map_filter = UT_MAP_MODE_AS;
		else
			ut_map_filter = UT_MAP_MODE_DM;
		UTMapLoadCatalogIndex(ut_map_cat_i);
		UTGameInit;
		ut_diag_once = FALSE;
		return;
	}

	if (ut_menu_open || ut_uwin_active)
		return;

	if (ut_udamage_until > 0.0 && tS >= ut_udamage_until)
	{
		ut_damage_scale = 1.0;
		ut_udamage_until = 0.0;
	}
	if (ut_invis_until > 0.0 && tS >= ut_invis_until)
		ut_invis_until = 0.0;

	if (!ut_alive)
	{
		if (ut_fire_held && !ut_suicide_latched)
		{
			UTGameViewCycle(1);
			ut_suicide_latched = TRUE;
		}
		else if (!ut_fire_held)
			ut_suicide_latched = FALSE;
		if (ut_view_target >= 0 && ut_view_target < UT_GM_BOT_N &&
			ut_bots[ut_view_target].alive)
		{
			UTVecCopy(ut_bots[ut_view_target].origin, ut_death_look);
			ut_death_look[2] += 40.0;
		}
		else if (ut_killer_bot >= 0 && ut_killer_bot < UT_GM_BOT_N &&
			ut_bots[ut_killer_bot].alive)
		{
			UTVecCopy(ut_bots[ut_killer_bot].origin, ut_death_look);
			ut_death_look[2] += 40.0;
			if (ut_view_target < 0)
				ut_view_target = ut_killer_bot;
		}
		ut_death_cam_yaw += 8000.0 * dt;
		ut_origin[0] = ut_death_look[0] +
			Cos(ut_death_cam_yaw * UT_ROT2RAD) * 120.0;
		ut_origin[1] = ut_death_look[1] +
			Sin(ut_death_cam_yaw * UT_ROT2RAD) * 120.0;
		ut_origin[2] = ut_death_look[2] + 48.0;
		if (ut_origin[2] < ut_map_z_min + 32.0)
			ut_origin[2] = ut_map_z_min + 32.0;
		if (ut_origin[2] > ut_map_z_max - 32.0)
			ut_origin[2] = ut_map_z_max - 32.0;
		wish[0] = ut_death_look[0] - ut_origin[0];
		wish[1] = ut_death_look[1] - ut_origin[1];
		wish[2] = 0.0;
		ut_view_yaw = UTVecYaw(wish) & 0xFFFF;
		ut_view_pitch = -1500;
		UTGameTickBots(dt);
		UTActorTickMovers(dt);
		if (ut_lod_player.loaded)
			UTLodTick(&ut_lod_player, dt, 10.0);
		if (tS >= ut_respawn_t && !ut_match_over)
		{
			ut_view_target = -1;
			UTGameRespawn;
		}
		return;
	}

	if (ut_use_map && ut_bsp != NULL)
	{
		if (ut_origin[2] < ut_map_z_min - 64.0)
		{
			UTVecCopy(ut_spawn, ut_origin);
			UTPhysInit;
			UTPhysSnapToFloor(ut_bsp, ut_origin);
			ut_health = 100.0;
			ut_oob_since = 0.0;
		}
		else if (!ut_floor_hit && ut_origin[2] < ut_spawn[2] - 500.0)
		{
			if (ut_oob_since <= 0.0)
				ut_oob_since = tS;
			else if (tS - ut_oob_since > 1.5)
			{
				UTVecCopy(ut_spawn, ut_origin);
				UTPhysInit;
				UTPhysSnapToFloor(ut_bsp, ut_origin);
				ut_oob_since = 0.0;
			}
		}
		else
			ut_oob_since = 0.0;
	}

	if (ut_want_suicide)
	{
		if (!ut_suicide_latched)
		{
			ut_suicide_latched = TRUE;
			UTGameKillPlayer;
			return;
		}
	}
	else
		ut_suicide_latched = FALSE;

	if (ut_want_dropflag)
	{
		if (!ut_dropflag_latched)
		{
			ut_dropflag_latched = TRUE;
			if (ut_player_flag >= 0)
				UTCTFDropFlag;
		}
	}
	else
		ut_dropflag_latched = FALSE;

	if (ut_want_taunt)
	{
		if (!ut_taunt_latched)
		{
			ut_taunt_latched = TRUE;
			UTSndTaunt;
			UTMsgCenter("Taunt!");
		}
	}
	else
		ut_taunt_latched = FALSE;

	UTGameTouchPickups;
	if (ut_fall_damage_pending > 0.0)
	{
		UTGameTakeDamage(ut_fall_damage_pending);
		ut_fall_damage_pending = 0.0;
		UTMsgCenter("Oof!");
	}
	if (ut_zone_in_water && !ut_was_in_water)
		UTFxBurst(ut_origin, 8, 200);
	if (ut_zone_in_water && (ToI64(tS * 8.0) & 3) == 0)
	{
		a[0] = ut_origin[0] + Sin(tS * 5.0) * 12.0;
		a[1] = ut_origin[1] + Cos(tS * 4.0) * 12.0;
		a[2] = ut_origin[2] + 10.0;
		UTFxSpawn(a, NULL, 0.7, 4.0, 211);
	}
	ut_was_in_water = ut_zone_in_water;
	UTCTFTouchPlayer(ut_origin);
	UTCTFTickDOM(ut_origin, dt);
	UTCTFTickAssault;
	ut_phys_gravity = UTZoneGravityMag;
	if (ut_alive)
	{
		if (ut_zone_in_water)
		{
			ut_breath -= dt;
			if (ut_breath < 0.0)
			{
				ut_breath = 0.0;
				UTGameTakeDamage(10.0 * dt);
			}
		}
		else
		{
			ut_breath += dt * 4.0;
			if (ut_breath > 20.0)
				ut_breath = 20.0;
		}
		if (ut_zone_in_hurt)
		{
			if (ut_zone_hurt_kind == UT_ZONE_KIND_LAVA)
				UTGameTakeDamage(40.0 * dt);
			else if (ut_zone_hurt_kind == UT_ZONE_KIND_SLIME)
				UTGameTakeDamage(20.0 * dt);
			else if (ut_zone_hurt_kind == UT_ZONE_KIND_VACUUM)
				UTGameTakeDamage(40.0 * dt);
			else if (ut_zone_hurt_kind == UT_ZONE_KIND_PRESSURE)
				UTGameTakeDamage(25.0 * dt);
			else
				UTGameTakeDamage(20.0 * dt);
		}
	}
	i = 0;
	while (i < ut_actor_n)
	{
		if (ut_actors[i].kind == UT_ACT_WEAPON && ut_actors[i].amount >= 1.0)
		{
			UTInvExecGive(ut_actors[i].weap_id);
			ut_actors[i].amount = 0.0;
		}
		i++;
	}
	UTDecalTick(dt);
	UTFxTick(dt);
	UTMusicUpdate;
	UTGameTickBots(dt);
	UTGameDispatchVM;
	UTReplSync;

	if (ut_frags >= ut_frag_limit && ut_frag_limit > 0)
	{
		ut_match_over = TRUE;
		UTMsgCenter("Frag Limit!");
	}
	if (ut_time_limit > 0 && ut_match_end_t > 0.0 &&
		tS >= ut_match_end_t && !ut_match_over)
	{
		ut_match_over = TRUE;
		UTMsgCenter("Time Limit!");
	}
}

U0 UTGameApplyVoiceOrder(I64 voice_i)
{//Male2Voice menu → bot.order (TournamentPlayer SetOrders host).
	I64 i;
	I64 ord;

	ord = -1;
	if (voice_i == 0 || voice_i == 7)
		ord = 1;
	else if (voice_i == 1 || voice_i == 3)
		ord = 4;
	else if (voice_i == 2 || voice_i == 4 || voice_i == 5)
		ord = 3;
	if (ord < 0)
		return;
	i = 0;
	while (i < UT_GM_BOT_MAX)
	{
		if (ut_bots[i].alive)
			ut_bots[i].order = ord;
		i++;
	}
	UTLog("UTGame: voice order=%d bots\n", ord);
}

U0 UTGameDrawBots(CUTCanvas *c)
{
	I64 i;
	F64 a[3];
	F64 b[3];
	F64 cc[3];
	F64 z;
	CUTBot *bot;
	CUTPickup *p;
	I64 col;
	F64 sx;
	F64 sy;
	F64 iz;
	F64 left;
	U8 line[32];

	if (!c || !ut_game_ready)
		return;
	i = 0;
	while (i < UT_GM_BOT_N)
	{
		bot = &ut_bots[i];
		if (bot->alive)
		{
			if (ut_lod_player.loaded)
			{
				UTVecCopy(bot->origin, ut_lod_player.draw_origin);
				ut_lod_player.draw_yaw = ToI64(bot->yaw) & 0xFFFF;
				UTLodDraw(c, &ut_lod_player, 50 + i * 25);
			}
			else if (ut_player_mesh_ready)
			{
				UTVecCopy(bot->origin, ut_player_mesh.origin);
				ut_player_mesh.scale = 1.0;
				UTMeshDraw(c, &ut_player_mesh);
			}
			else
			{
				z = bot->origin[2];
				a[0] = bot->origin[0] - 20; a[1] = bot->origin[1] - 20; a[2] = z;
				b[0] = bot->origin[0] + 20; b[1] = bot->origin[1] - 20; b[2] = z;
				cc[0] = bot->origin[0] + 20; cc[1] = bot->origin[1] + 20; cc[2] = z + 70;
				UTDrawTri3(c, a, b, cc, 40 + i * 20);
			}
			a[0] = bot->origin[0];
			a[1] = bot->origin[1];
			a[2] = bot->origin[2] + 80.0;
			if (ut_win_ready && UTDrawProject(c, a, &sx, &sy, &iz) && iz > 0.0)
			{
				StrPrint(line, "Bot%d", i);
				col = ut_col_white;
				if (bot->team & 1)
					col = ut_col_label;
				UTWinTextAt(ToI64(sx) - 12, ToI64(sy) - 12, line, col);
			}
		}
		i++;
	}
	i = 0;
	while (i < ut_pick_n)
	{
		p = &ut_picks[i];
		z = p->origin[2];
		if (!p->taken)
		{
			col = 180;
			if (p->kind == UT_PICK_HEALTH)
				col = 250;
			else if (p->kind == UT_PICK_ARMOR || p->kind == UT_PICK_SHIELD)
				col = 200;
			else if (p->kind == UT_PICK_AMMO)
				col = 160;
			else if (p->kind == UT_PICK_UDAMAGE)
				col = 230;
			else if (p->kind == UT_PICK_INVIS)
				col = 211;
			left = 10.0 + Sin(tS * 6.0 + ToF64(i)) * 4.0;
			a[0] = p->origin[0] - left; a[1] = p->origin[1] - left; a[2] = z;
			b[0] = p->origin[0] + left; b[1] = p->origin[1] - left; b[2] = z;
			cc[0] = p->origin[0] + left; cc[1] = p->origin[1] + left;
			cc[2] = z + 16.0 + left;
			UTDrawTri3(c, a, b, cc, col);
		}
		else if (p->respawn_at > tS)
		{
			col = 40;
			a[0] = p->origin[0] - 8; a[1] = p->origin[1] - 8; a[2] = z;
			b[0] = p->origin[0] + 8; b[1] = p->origin[1] - 8; b[2] = z;
			cc[0] = p->origin[0] + 8; cc[1] = p->origin[1] + 8; cc[2] = z + 16;
			UTDrawTri3(c, a, b, cc, col);
			left = p->respawn_at - tS;
			if (left > 0.0 && left < 60.0 &&
				UTDrawProject(c, p->origin, &sx, &sy, &iz))
			{
				StrPrint(line, "%.0f", left);
				if (ut_win_ready)
					UTWinTextAt(ToI64(sx) - 4, ToI64(sy) - 10, line,
						ut_col_dim);
			}
		}
		i++;
	}
}

U0 UTGameDrawHUD(CUTCanvas *c)
{
	if (ut_show_scores)
		UTHUDDrawScoreboard(c);
}

U0 UTGameExit()
{
	ut_game_ready = FALSE;
}

U0 UTGameAddBots(I64 n)
{
	I64 i;
	I64 added;
	F64 ang;

	if (n < 1)
		return;
	added = 0;
	i = 0;
	while (i < UT_GM_BOT_MAX && added < n)
	{
		if (!ut_bots[i].alive)
		{
			ang = ToF64(i) * 0.9;
			ut_bots[i].origin[0] = ut_spawn[0] + Cos(ang) * 400.0;
			ut_bots[i].origin[1] = ut_spawn[1] + Sin(ang) * 400.0;
			ut_bots[i].origin[2] = ut_spawn[2];
			if (ut_bsp != NULL)
				UTPhysSnapToFloor(ut_bsp, ut_bots[i].origin);
			ut_bots[i].vel[0] = 0;
			ut_bots[i].vel[1] = 0;
			ut_bots[i].vel[2] = 0;
			ut_bots[i].yaw = ang * 10000.0;
			ut_bots[i].health = 100.0;
			ut_bots[i].armor = 0.0;
			ut_bots[i].shoot_t = tS + 2.0;
			ut_bots[i].alive = TRUE;
			ut_bots[i].weap = UT_WEAP_SHOCK;
			ut_bots[i].state = 0;
			added++;
			if (i >= ut_bot_count)
				ut_bot_count = i + 1;
		}
		i++;
	}
	UTGameAssignAssaultOrders;
}

U0 UTGamePlayersDump()
{
	I64 i;
	U8 msg[80];

	StrPrint(msg, "You frags=%d deaths=%d hp=%.0f",
		ut_frags, ut_deaths, ut_health);
	UTConPrint(msg);
	i = 0;
	while (i < ut_bot_count && i < UT_GM_BOT_MAX)
	{
		if (ut_bots[i].alive)
			StrPrint(msg, "Bot%d score=%d hp=%.0f",
				i, ut_bots[i].score, ut_bots[i].health);
		else
			StrPrint(msg, "Bot%d DEAD score=%d", i, ut_bots[i].score);
		UTConPrint(msg);
		i++;
	}
}

U0 UTGameViewCycle(I64 dir)
{
	I64 i;
	I64 n;
	I64 start;

	if (dir == 0)
		dir = 1;
	start = ut_view_target;
	n = 0;
	i = start;
	while (n < UT_GM_BOT_MAX + 1)
	{
		i += dir;
		if (i < -1)
			i = UT_GM_BOT_MAX - 1;
		if (i >= UT_GM_BOT_MAX)
			i = -1;
		if (i < 0)
		{
			ut_view_target = -1;
			return;
		}
		if (ut_bots[i].alive)
		{
			ut_view_target = i;
			return;
		}
		n++;
	}
	ut_view_target = -1;
}
