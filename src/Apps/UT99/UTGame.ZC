#define UT_GM_MAX_HEALTH	199
#define UT_GM_MAX_ARMOR		150
#define UT_GM_MAX_AMMO		999
#define UT_GM_FIRE_DAMAGE	25.0
#define UT_GM_FIRE_RANGE	4096.0
#define UT_GM_FIRE_COOLDOWN	0.25
#define UT_GM_BOT_MAX		8
#define UT_GM_BOT_N			UT_GM_BOT_MAX
#define UT_GM_PICK_N		96
#define UT_GM_PICK_RADIUS	70.0
#define UT_GM_BOT_SIGHT		1800.0
#define UT_GM_BOT_SHOT_CD	0.85
#define UT_GM_FRAG_LIMIT	30

#define UT_PICK_HEALTH		1
#define UT_PICK_ARMOR		2
#define UT_PICK_AMMO		3
#define UT_PICK_WEAPON		4
#define UT_PICK_SHIELD		5
#define UT_PICK_UDAMAGE		6
#define UT_PICK_THIGHS		7
#define UT_PICK_SUPERHEALTH	8
#define UT_PICK_INVIS		9

//Engine-ish armor layers: belt 100% → body 75% → pads 50%
#define UT_ARM_ABSORB_BELT	1.00
#define UT_ARM_ABSORB_BODY	0.75
#define UT_ARM_ABSORB_PADS	0.50
#define UT_ARM_MAX_BELT		150.0
#define UT_ARM_MAX_BODY		100.0
#define UT_ARM_MAX_PADS		50.0
#define UT_HEALTH_MAX_NORMAL	100.0
#define UT_HEALTH_MAX_SUPER		199.0

class CUTBot
{
	F64	 origin[3];
	F64	 vel[3];
	F64	 yaw;
	F64	 health;
	F64	 armor;
	F64	 shoot_t;
	Bool alive;
	I64	 score;
	I64	 weap;
	I64	 state;		//0 idle 1 chase 2 attack
	I64	 team;		//0 attacker / 1 defender (Assault)
	I64	 order;		//0 free 1 attack 2 defend 3 follow 4 hold
	I64	 fort_i;
	I64	 obj_id;	//UTObj slot backing this bot, -1 = native-only
	I64	 path_i;
	I64	 patrol_i;
};

class CUTPickup
{
	F64	 origin[3];
	I64	 kind;
	F64	 amount;
	I64	 weap_id;
	Bool taken;
	F64	 respawn_at;
	F64	 respawn_time;
	U8	 pickup_snd[48];	//Inventory.PickupSound from the class defaults
};

