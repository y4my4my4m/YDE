// UT99.ZC - app shell: window, input, frame loop, demo scene.
//
// Rendering on this task; blit in draw_it on the window manager task.

#define UT_FOV			90.0
#define UT_HUD_COLOR	255

CUTCanvas	*ut_canvas	= NULL;
CUTBsp		*ut_bsp		= NULL;
Bool		 ut_ready	= FALSE;
F64			 ut_fps		= 0.0;
I64			 ut_frames	= 0;
I64			 ut_blit_x	= 0;
I64			 ut_blit_y	= 0;
I64			 ut_blit_w	= 320;
I64			 ut_blit_h	= 240;

U0 UTDrawIt(CTask *task, CDC *dc)
{
	I64 w;
	I64 h;
	I64 bw;
	I64 bh;
	F64 aspect;
	F64 win_asp;

	no_warn task;

	if (!ut_ready || !ut_canvas)
		return;

	w = dc->width;
	h = dc->height;
	if (w < 1 || h < 1)
		return;

	aspect  = ToF64(ut_canvas->width) / ToF64(ut_canvas->height);
	win_asp = ToF64(w) / ToF64(h);
	if (win_asp > aspect)
	{
		bh = h;
		bw = ToI64(ToF64(h) * aspect);
	}
	else
	{
		bw = w;
		bh = ToI64(ToF64(w) / aspect);
	}
	ut_blit_w = bw;
	ut_blit_h = bh;
	ut_blit_x = (w - bw) / 2;
	ut_blit_y = (h - bh) / 2;

	UTDrawBlitFit(ut_canvas, dc, ut_blit_x, ut_blit_y, ut_blit_w, ut_blit_h);
}

U0 UTCenterView(CTask *task)
{
	I64 w = task->pix_width;
	I64 h = task->pix_height;

	no_warn w;
	no_warn h;
}

U0 UTRenderFrame()
{
	I64 hx;
	I64 hy;
	I64 tw;

	if (!ut_canvas)
		return;

	UTSoftLock(UT_LOCKR_CLEAR_SCREEN, 1);
	UTDrawSetView(ut_canvas, ut_origin, ut_view_pitch, ut_view_yaw,
		ut_view_roll, UT_FOV);

	if (ut_bsp)
		UTBspDrawRoom(ut_canvas, ut_bsp);
	if (ut_demo_mesh_ready)
		UTMeshDraw(ut_canvas, &ut_demo_mesh);

	//HUD tile: SoftDrv DrawTile of the checker in the corner
	if (ut_tex_ready)
	{
		tw = 32;
		UTSoftDrawTile(&ut_tex_checker, 4, 4, tw, tw,
			0.0, 0.0, 64.0, 64.0, 8.0);
	}

	hx = ut_canvas->width / 2;
	hy = ut_canvas->height / 2;
	UTSoftDraw2DLine(hx - 4, hy, hx + 4, hy, UT_HUD_COLOR);
	UTSoftDraw2DLine(hx, hy - 4, hx, hy + 4, UT_HUD_COLOR);

	UTSoftUnlock;
}

U0 UTGameLoop()
{
	F64	t0;
	F64	t1;
	F64	dt;
	F64	fps_t;
	I64	fps_n;
	I64	dx;
	I64	dy;
	Bool done;

	t0    = tS;
	fps_t = t0;
	fps_n = 0;
	done  = FALSE;
	ut_ready = TRUE;

	while (!done)
	{
		if (Bt(kbd.down_bitmap, SC_ESC))
			done = TRUE;

		dx = mouse_hard.raw_data.x;
		dy = mouse_hard.raw_data.y;
		MouseRawReset;
		UTInMouseLook(dx, dy);
		UTInPollKeys;
		t1 = tS;
		dt = t1 - t0;
		if (dt > 0.1)
			dt = 0.1;
		t0 = t1;
		UTInMove(dt);
		UTRenderFrame;

		fps_n++;
		ut_frames++;
		if (t1 - fps_t >= 1.0)
		{
			ut_fps = ToF64(fps_n) / (t1 - fps_t);
			fps_n  = 0;
			fps_t  = t1;
		}

		Refresh;
	}

	ut_ready = FALSE;
}

U0 UT99()
{
	Bool raw_was_on = FALSE;

	UTLogInit;
	UTLog("UT99 start\n");

	ut_canvas = NULL;
	ut_bsp    = NULL;
	ut_ready  = FALSE;
	ut_fps    = 0.0;
	ut_frames = 0;

	UTPalInit;
	UTInInit;
	UTTexDemoInit;
	UTMeshDemoInit;
	ut_bsp = UTBspBuildDemoRoom;

	ut_canvas = UTDrawNew(UT_SCR_W, UT_SCR_H);
	if (!ut_canvas)
	{
		"UT99: canvas alloc failed\n";
		return;
	}
	UTSoftInit(ut_canvas);

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		AutoComplete;
		WinBorder;
		WinMax;
		DocCursor;
		DocClear;

		UTCenterView(Fs);
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;
		mouse_hard.bttns[0] = FALSE;
		mouse_hard.bttns[1] = FALSE;
		mouse_hard.bttns[2] = FALSE;

		Fs->draw_it = &UTDrawIt;

		"UT99 SoftDrv demo. WASD move, mouse look, ESC quit.\n";
		"CPU P8 span raster only. No OpenGL/D3D.\n";
		"Retail tree under ::/Apps/UT99/{System,Maps,Textures,Sounds,Music}. UTTest;\n";

		UTGameLoop;
	}
	catch
		PutExcept;

	ut_ready     = FALSE;
	Fs->draw_it  = NULL;
	Sleep(100);

	MouseRaw(FALSE);
	no_warn raw_was_on;

	SettingsPop;
	MenuPop;

	UTSoftExit;
	UTTexDemoFree;

	if (ut_canvas)
	{
		UTDrawFree(ut_canvas);
		ut_canvas = NULL;
	}
	if (ut_bsp)
	{
		UTBspFree(ut_bsp);
		ut_bsp = NULL;
	}

	UTLog("UT99 exit frames=%d fps=%4.1f\n", ut_frames, ut_fps);
	"UT99 done. Type $$LTBLUE$$UTTest;$$FG$$ for data-layer checks.\n";
}
