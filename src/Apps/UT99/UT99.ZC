// UT99.ZC - app shell: window, input, frame loop.
//
// Engine Client path (UTClient). SoftDrv = URenderDevice only.
// See docs/Apps/UT99/PORT.md.
//
// Rendering on this task; blit in draw_it on the window manager task.

#define UT_FOV			90.0


Bool		 ut_ready	= FALSE;
F64			 ut_fps		= 0.0;
I64			 ut_frames	= 0;
Bool		 ut_raw_on	= TRUE;	//current MouseRaw mode; UI needs it off
//Screen origin of the blit target DC, captured in UTDrawIt. mouse.pos is in
//screen pixels, so this is what turns it into canvas pixels. Fs->pix_left is
//the text-grid origin and does not match the draw_it DC.
Bool		 ut_play_latched = FALSE;
Bool		 ut_frame0_logged = FALSE;
Bool		 ut_addr_logged = FALSE;
//ShockRifle PlayerViewOffset (4.4, -1.7, -1.6) from Botpack class defaults.
//Weapon.uc scales it by 100 for network transport and Inventory.uc undoes
//that on use: DrawOffset = (0.01 * PlayerViewOffset) >> ViewRotation. So the
//effective offset is the authored vector, rotated into the view frame.
#define UT_WEAP_VIEW_X	4.4
#define UT_WEAP_VIEW_Y	-1.7
#define UT_WEAP_VIEW_Z	-1.6
F64			 dt_frame = 0.016;
I64			 ut_pal_sum = 0;
I64			 ut_pal_i = 0;
I64			 ut_dc_x0	= 0;
I64			 ut_dc_w	= 0;
I64			 ut_dc_h	= 0;
I64			 ut_dc_y0	= 0;
I64			 ut_blit_x	= 0;
I64			 ut_blit_y	= 0;
I64			 ut_blit_w	= 320;
I64			 ut_blit_h	= 240;
Bool		 ut_diag_once	= FALSE;
Bool		 ut_res_latched	= FALSE;
Bool		 ut_aspect_applied	= FALSE;

//Present snapshot. The window manager task blits while the game task is
//still drawing the next frame, so handing it the live canvas shows torn and
//half-built frames — and during a map load, a canvas nobody is updating,
//which reads as a freeze. QuakePlus keeps the same split.
U8			*ut_present_pix		= NULL;
U32			*ut_present_argb	= NULL;
CUTCanvas	 ut_present_shell;
Bool		 ut_present_ok		= FALSE;
I64			 ut_present_w		= 0;
I64			 ut_present_h		= 0;

U0 UTPresentFree()
{
	ut_present_ok = FALSE;
	if (ut_present_pix)
	{
		Free(ut_present_pix);
		ut_present_pix = NULL;
	}
	if (ut_present_argb)
	{
		Free(ut_present_argb);
		ut_present_argb = NULL;
	}
	ut_present_w = 0;
	ut_present_h = 0;
}

Bool UTPresentEnsure(CUTCanvas *c)
{//Resize follows the canvas; a stale size would blit the wrong stride.
	if (!c || c->width < 1 || c->height < 1)
		return FALSE;
	if (ut_present_pix && ut_present_argb &&
		ut_present_w == c->width && ut_present_h == c->height)
		return TRUE;
	UTPresentFree;
	ut_present_pix = MAlloc(c->width * c->height);
	ut_present_argb = MAlloc(c->width * c->height * sizeof(U32));
	if (!ut_present_pix || !ut_present_argb)
	{
		UTPresentFree;
		return FALSE;
	}
	ut_present_w = c->width;
	ut_present_h = c->height;
	return TRUE;
}

U0 UTPresentPublish(CUTCanvas *c)
{//Called once the frame is complete; the blit only ever sees whole frames.
	I64 n;

	if (!UTPresentEnsure(c))
		return;
	n = c->width * c->height;
	MemCopy(ut_present_pix, c->pixels, n);
	MemCopy(ut_present_argb, c->argb, n * sizeof(U32));
	MemCopy(&ut_present_shell, c, sizeof(CUTCanvas));
	ut_present_shell.pixels = ut_present_pix;
	ut_present_shell.argb = ut_present_argb;
	ut_present_shell.depth = NULL;
	ut_present_ok = TRUE;
}

U0 UTDrawIt(CTask *task, CDC *dc)
{//SoftDrv Unlock display: P8→ARGB32 CDC (ZealOS has no 15/16 surface).
 //FlashSprite32 pal (`ut_flash32_pal`) when tables built; else ut_pal_argb.
 //Fill window (no letterbox). Letterbox + GrRect(BLACK) leaves a solid
 //white right strip on this tree's draw_it DC.
	I64 w;
	I64 h;
	I64 n;

	no_warn task;

	if (!ut_ready || !ut_present_ok || ut_present_pix == NULL)
		return;

	w = dc->width;
	h = dc->height;
	if (w < 1 || h < 1)
		return;

	//No clear: the blit fills the window edge to edge; clearing first writes
	//every pixel twice. QuakePlus does not clear either.
	no_warn n;

	ut_blit_w = w;
	ut_blit_h = h;
	ut_blit_x = 0;
	ut_blit_y = 0;
	ut_dc_x0 = dc->x0;
	ut_dc_y0 = dc->y0;
	ut_dc_w  = dc->width;
	ut_dc_h  = dc->height;

	UTDrawBlitFit(&ut_present_shell, dc, 0, 0, w, h);
	UTSoftApplyFlash(dc);
}

U0 UTCenterView(CTask *task)
{
	I64 w = task->pix_width;
	I64 h = task->pix_height;

	no_warn w;
	no_warn h;
}

U0 UTApplyVideo()
{//Rebuild SoftDrv canvas. Quake QApplyVideo: drain draw_it before Free.
	CUTCanvas *old;
	I64 w;
	I64 h;

	ut_ready = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);

	w = ut_res_w[ut_opt_res];
	h = ut_res_h[ut_opt_res];
	//UTDrawBlitFit fills the DC without letterboxing and the projection has
	//no aspect term (UTDraw y_scale = x_scale), so a 4:3 canvas on a 16:9 DC
	//renders 1.33x too wide. Keep the listed height, take width from the DC.
	if (w > 0 && h > 0 && ut_dc_w > 0 && ut_dc_h > 0)
	{
		w = ToI64(ToF64(h) * ToF64(ut_dc_w) / ToF64(ut_dc_h));
		w = (w + 3) & (~3);
		if (w < 320) w = 320;
		if (w > 1280) w = 1280;
	}
	if (w < 1 || h < 1)
	{
		//The blit target DC is the authoritative size. Fs->pix_* is the text
		//grid, roughly half that, and stretches the canvas 2x.
		w = ut_dc_w;
		h = ut_dc_h;
		if (w < 1 || h < 1)
		{
			w = Fs->pix_width;
			h = Fs->pix_height;
		}
		if (w < 320) w = 320;
		if (h < 200) h = 200;
		if (w > 1280) w = 1280;
		if (h > 960) h = 960;
	}

	old = ut_canvas;
	ut_canvas = NULL;
	if (old != NULL)
	{
		UTSoftExit;
		UTDrawFree(old);
	}

	ut_canvas = UTDrawNew(w, h);
	if (ut_canvas == NULL)
	{
		UTLog("UT99: UTApplyVideo alloc fail %dx%d\n", w, h);
		ut_res_dirty = FALSE;
		return;
	}
	UTSoftInit(ut_canvas);
	UTWinInit(ut_canvas);
	//Font stays at its authored size: the menu bar, pulldowns and dialog rows
	//are all laid out in fixed pixels against it. Scaling the glyphs without
	//scaling that layout clips the bar text and shifts its hit rects.
	ut_uwin_bar_h = ut_ttf_px + 4;
	if (ut_uwin_bar_h < 16)
		ut_uwin_bar_h = 16;
	if (ut_uwin_active)
		UTUWinActivate;

	UTLog("UT99: SoftDrv canvas %dx%d (res slot %d)\n", w, h, ut_opt_res);
	"UT99: SoftDrv %dx%d\n", w, h;

	Fs->draw_it = &UTDrawIt;
	ut_res_dirty = FALSE;
	ut_ready = TRUE;
}

U0 UTCycleRes()
{
	ut_opt_res++;
	if (ut_opt_res >= UT_RES_COUNT)
		ut_opt_res = 0;
	ut_res_dirty = TRUE;
}

U0 UTRenderFrame()
{
	I64 nz;
	I64 pidx;
	I64 nfac;
	I64 zone;
	F64 eye[3];
	F64 mn[3];
	F64 mx[3];
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	U8 *px;
	U8 line[80];
	Bool world;
	CUTWeapDef *wd;
	F64 vx;
	F64 vy;
	F64 vz;

	if (ut_canvas == NULL)
		return;

	UTSoftLock(UT_LOCKR_CLEAR_SCREEN, 0);
	//View from pawn eye: Location (=cylinder centre) + BaseEyeHeight.
	eye[0] = ut_origin[0];
	eye[1] = ut_origin[1];
	eye[2] = ut_origin[2] + UT_PHYS_EYE;
	if (ut_crouching)
		eye[2] = ut_origin[2] + UT_PHYS_EYE * 0.55;
	//Spectate chase: sit on bot eyes when view_target live.
	if ((ut_spectate || !ut_alive) && ut_view_target >= 0 &&
		ut_view_target < UT_GM_BOT_MAX && ut_bots[ut_view_target].alive)
	{
		eye[0] = ut_bots[ut_view_target].origin[0];
		eye[1] = ut_bots[ut_view_target].origin[1];
		eye[2] = ut_bots[ut_view_target].origin[2] + UT_PHYS_EYE;
		ut_view_yaw = ToI64(ut_bots[ut_view_target].yaw) & 0xFFFF;
	}
	else if (ut_behind_view && ut_alive)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		eye[0] -= fwd[0] * 140.0;
		eye[1] -= fwd[1] * 140.0;
		eye[2] -= fwd[2] * 140.0;
		eye[2] += 28.0;
	}
	else if (ut_alive)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		if (ut_opt_viewbob)
		{
			eye[2] += Sin(ut_view_bob) * 2.4;
			eye[0] += right[0] * Cos(ut_view_bob * 0.5) * 1.2;
			eye[1] += right[1] * Cos(ut_view_bob * 0.5) * 1.2;
		}
		if (ut_view_shake > 0.05)
		{
			eye[0] += right[0] * Sin(tS * 40.0) * ut_view_shake * 0.35;
			eye[1] += right[1] * Sin(tS * 40.0) * ut_view_shake * 0.35;
			eye[2] += Cos(tS * 55.0) * ut_view_shake * 0.25;
			ut_view_shake = ut_view_shake * 0.88;
		}
		else
			ut_view_shake = 0.0;
	}
	UTDrawSetView(ut_canvas, eye, ut_view_pitch, ut_view_yaw,
		ut_view_roll, ut_con_fov);

	world = UTClientWantsWorldDraw;

	if (world && ut_bsp != NULL && !ut_menu_open && !ut_uwin_active)
	{
		//World only. Native bots, pickups, projectiles, decals, beams and
		//path markers are absent, not gated; none came from retail data.
		//Actors return with UMesh/ULodMesh rendering driven from the
		//packages.
		UTBspDrawRoom(ut_canvas, ut_bsp);
		//Map actors: pickups, decorations, flames. Shared meshes,
		//per-instance transform and skin.
		UTActorDrawMeshes(ut_canvas);
		//First-person weapon. Weapon.uc SetHand: PlayerViewOffset.Y scales
		//by Hand, then the whole vector is multiplied by 100 (the comment in
		//Weapon.uc notes the network passes the components as ints). View
		//frame is X forward, Y right, Z up.
		//PlayerViewMesh/Offset/Scale of the held weapon, from its class
		//defaults.
		wd = &ut_weap_def[ut_weap_cur];
		if (wd->view_mesh[0])
			UTLodBindViewMesh(wd->view_mesh);
		vx = UT_WEAP_VIEW_X;
		vy = UT_WEAP_VIEW_Y;
		vz = UT_WEAP_VIEW_Z;
		if (wd->view_offset[0] != 0.0 || wd->view_offset[1] != 0.0 ||
			wd->view_offset[2] != 0.0)
		{
			vx = wd->view_offset[0];
			vy = wd->view_offset[1];
			vz = wd->view_offset[2];
		}
		if (ut_lod_weapon.loaded)
		{
			UTLodTick(&ut_lod_weapon, dt_frame, 10.0);
			ut_lod_weapon.draw_origin[0] = eye[0] +
				ut_canvas->forward[0] * vx +
				ut_canvas->right[0] * vy +
				ut_canvas->up[0] * vz;
			ut_lod_weapon.draw_origin[1] = eye[1] +
				ut_canvas->forward[1] * vx +
				ut_canvas->right[1] * vy +
				ut_canvas->up[1] * vz;
			ut_lod_weapon.draw_origin[2] = eye[2] +
				ut_canvas->forward[2] * vx +
				ut_canvas->right[2] * vy +
				ut_canvas->up[2] * vz;
			//Weapon.Rotation = ViewRotation; welded to the view, so it takes
			//the whole rotator, not yaw.
			ut_lod_weapon.draw_yaw = ut_view_yaw;
			ut_lod_weapon.draw_pitch = ut_view_pitch;
			ut_lod_weapon.draw_roll = ut_view_roll;
			UTLodDraw(ut_canvas, &ut_lod_weapon, ut_col_white);
		}
	}

	if (ut_uwin_active)
		UTUWinDraw(ut_canvas);
	else if (ut_menu_open && ut_menu_fake_laf)
	{
		UTMenuDraw(ut_canvas);
		if (ut_client_cursor_on)
			UTUWinDrawCursor(ut_canvas);
	}
	else
	{
		UTClientRender(ut_canvas);
		UTVoiceDraw(ut_canvas);
		//World: crosshair only. Soft cursor is UWindow / incomplete path.
	}

	if (!ut_diag_once && ut_use_map && ut_bsp != NULL &&
		world && !ut_menu_open && !ut_uwin_active)
	{
		nz = 0;
		px = ut_canvas->pixels;
		pidx = 0;
		while (pidx < ut_canvas->width * ut_canvas->height)
		{
			if (px[pidx])
				nz++;
			pidx++;
		}
		UTBspProbeAABB(ut_bsp, mn, mx, &nfac);
		zone = UTBspPointZone(ut_bsp, eye);
		UTLog("UT99: eye=%.0f %.0f %.0f yaw=%d tris=%d spans=%d nzpix=%d zone=%d facets=%d\n",
			eye[0], eye[1], eye[2], ut_view_yaw,
			ut_canvas->tris_drawn, ut_canvas->spans_drawn, nz, zone, nfac);
		"UT99: eye %.0f %.0f %.0f tris=%d nz=%d zone=%d\n",
			eye[0], eye[1], eye[2], ut_canvas->tris_drawn, nz, zone;
		//Latch once coverage is a real room (not black void scraps).
		if (nz > (ut_canvas->width * ut_canvas->height) / 8)
			ut_diag_once = TRUE;
	}

	no_warn line;

	UTSoftUnlock;
	UTPresentPublish(ut_canvas);
}

U0 UTInputDrain()
{//Consume queued key messages.
 //
 //Input is read as raw state through kbd.down_bitmap, so MessageGet is never
 //called and KEY_DOWN/UP pairs pile up for the whole session. On return the
 //terminal drains that backlog as typed input, which is how gameplay keys end
 //up written into the document. QuakePlus drains for the same reason.
 //
 //Bounded: a frame never holds many.
	I64 ch;
	I64 sc;
	I64 guard;

	guard = 0;
	while (guard < 64 && KeyScan(&ch, &sc))
		guard++;
}

U0 UTInputDrainAll()
{//Same drain on exit, unbounded. The frame cap of 64
 //clears a rounding error, not a session's backlog. Repeat because messages
 //can still be posted between passes.
	I64 ch;
	I64 sc;
	I64 guard;
	I64 pass;

	pass = 0;
	while (pass < 4)
	{
		guard = 0;
		while (guard < 65536 && KeyScan(&ch, &sc))
			guard++;
		if (!guard)
			return;
		Sleep(10);
		pass++;
	}
}

U0 UTGameLoop()
{
	F64	t0;
	F64	t1;
	F64	dt;
	F64	fps_t;
	I64	fps_n;
	I64	dx;
	I64	dy;
	Bool done;
	Bool reskey;
	Bool want_raw;

	ut_raw_on = TRUE;
	t0    = tS;
	fps_t = t0;
	fps_n = 0;
	done  = FALSE;
	ut_ready = TRUE;

	while (!done)
	{
		if (ut_menu_quit)
			done = TRUE;

		//One pointer at a time. In world: MouseRaw on, OS pointer hidden, raw
		//deltas drive mouselook. In any UI: MouseRaw off so the OS pointer is
		//live, the soft arrow is hidden, and the hit test reads that same
		//pointer through UTUWinMsAbs. Aiming and hit testing then use one
		//coordinate, so they cannot disagree.
		want_raw = UTClientInWorld && !ut_menu_open && !ut_uwin_active &&
			!ut_con_open;
		if (want_raw != ut_raw_on)
		{
			MouseRaw(want_raw);
			MouseRawReset;
			ut_raw_on = want_raw;
		}
		//Soft arrow only in world; the OS pointer is the UI cursor.
		ut_client_cursor_on = ut_raw_on;
		if (ut_raw_on)
		{
			dx = mouse_hard.raw_data.x;
			dy = mouse_hard.raw_data.y;
			MouseRawReset;
			UTInMouseLook(dx, dy);
		}
		else
			UTUWinMsAbs;
		if (!ut_con_open)
			UTInPollKeys;
		UTUWinPoll;
		if (ut_menu_fake_laf)
			UTMenuPoll;

		//P: jump straight into a match, skipping the menus.
		UTInputDrain;

		if (Bt(kbd.down_bitmap, Char2ScanCode('p')))
		{
			if (!ut_play_latched)
			{
				ut_play_latched = TRUE;
				UTLog("UT99: debug launch (P)\n");
				ut_uwin_active = FALSE;
				ut_menu_open = FALSE;
				ut_menu_fake_laf = FALSE;
				UTClientStartMatch;
			}
		}
		else
			ut_play_latched = FALSE;

		reskey = Bt(kbd.down_bitmap, Char2ScanCode('=')) ||
			Bt(kbd.down_bitmap, SC_F5);
		if (reskey)
		{
			if (!ut_res_latched)
			{
				ut_res_latched = TRUE;
				UTCycleRes;
			}
		}
		else
			ut_res_latched = FALSE;

		//Boot allocates before draw_it has ever run, so ut_dc_w is 0 and the
		//canvas cannot be matched to the DC aspect there. Re-apply once the
		//first blit has reported the real DC.
		if (!ut_aspect_applied && ut_dc_w > 0 && ut_dc_h > 0 &&
			ut_canvas != NULL)
		{
			ut_aspect_applied = TRUE;
			if (ut_canvas->width * ut_dc_h != ut_canvas->height * ut_dc_w)
				ut_res_dirty = TRUE;
		}
		if (ut_res_dirty)
			UTApplyVideo;

		t1 = tS;
		dt = t1 - t0;
		if (dt > 0.1)
			dt = 0.1;
		t0 = t1;
		UTClientTick(dt);
		UTRenderFrame;

		fps_n++;
		ut_frames++;
		if (t1 - fps_t >= 1.0)
		{
			ut_fps = ToF64(fps_n) / (t1 - fps_t);
			fps_n  = 0;
			fps_t  = t1;
			UTLog("UT99: fps=%4.1f bound=%d possess=%d gaps=%02X\n",
				ut_fps, ToI64(ut_client_level_bound),
				ToI64(ut_client_possessed), ut_client_gap_mask);
		}

		Refresh;
	}

	ut_ready = FALSE;
}

U0 UT99()
{
	Bool raw_was_on = FALSE;
	I64 boot_w;
	I64 boot_h;

	UTLogInit;
	UTLog("UT99 start\n");
	"UT99: SoftDrv + Engine Client. See docs/Apps/UT99/PORT.md\n";

	ut_canvas = NULL;
	ut_bsp    = NULL;
	ut_ready  = FALSE;
	ut_fps    = 0.0;
	ut_frames = 0;
	//640x480. The whole UI is authored against this; the cursor mapping
	//divides by the blit rect, so a stretched canvas still maps correctly.
	ut_opt_res = 3;
	ut_res_dirty = FALSE;
	ut_res_latched = FALSE;

	UTPalInit;
	UTInInit;
	UTTexDemoInit;
	if (UTPalLoadFromUtx("::/Apps/UT99/Textures/ArenaTex.utx"))
		UTLog("UT99: UPalette from ArenaTex.utx\n");
	else if (UTPalLoadFromUtx("::/Apps/UT99/Textures/MenuGr.utx"))
		UTLog("UT99: UPalette from MenuGr.utx\n");
	else
	{
		UTPalInstall;
		UTLog("UT99: UPalette missing - grey ramp + GrPalette install\n");
	}
	if (UTTexLoadNamed("::/Apps/UT99/Textures/ArenaTex.utx", "Greywall",
		&ut_tex_grid))
		UTLog("UT99: loaded ArenaTex.Greywall\n");
	if (UTTexLoadNamed("::/Apps/UT99/Textures/ArenaTex.utx", "Arenaflr",
		&ut_tex_checker))
		UTLog("UT99: loaded ArenaTex.Arenaflr\n");
	UTSndInit;
	UTVoiceInit;
	UTVMProbeEngine;
	UTVMProbeUWindow;
	UTVMBindPlayer;
	UTMusicInit;
	UTLodInit;
	UTMeshDemoInit;
	//Demo cube off SoftDrv path; player mesh stays for DrawActor fallback.
	ut_demo_mesh_ready = FALSE;
	UTFontInit;
	UTMenuInit;
	UTUWinInit;
	UTObjInit;
	UTClientInit;
	UTHUDInit;

	ut_bsp = NULL;
	UTMapTryDefault;
	if (ut_bsp == NULL)
		ut_bsp = UTBspBuildDemoRoom;

	ut_game_ready = FALSE;

	boot_w = ut_res_w[ut_opt_res];
	boot_h = ut_res_h[ut_opt_res];
	if (boot_w < 1) boot_w = UT_SCR_W;
	if (boot_h < 1) boot_h = UT_SCR_H;
	ut_canvas = UTDrawNew(boot_w, boot_h);
	if (ut_canvas == NULL)
	{
		"UT99: canvas alloc failed\n";
		return;
	}
	UTSoftInit(ut_canvas);
	UTWinInit(ut_canvas);
	//Activate only after SoftDrv canvas exists (UTUWinInit must not).
	if (ut_uwin_ready && !ut_menu_fake_laf)
		UTUWinActivate;

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		Fs->text_attr = BLACK << 4 + BLACK;
		Fs->border_attr = BLACK << 4 + BLACK;
		//No GrPalette install: the frame is truecolor and reaches the CDC as
		//literal RGB. QuakePlus does the same and never touches gr_palette.
		//Rewriting the 16-slot system palette recolours the DE globally.
		AutoComplete(OFF);
		WinBorder(OFF);
		WinMax;
		DocCursor(OFF);
		DocClear;

		UTCenterView(Fs);
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;
		mouse_hard.bttns[0] = FALSE;
		mouse_hard.bttns[1] = FALSE;
		mouse_hard.bttns[2] = FALSE;
		UTUWinMsReset;

		Fs->draw_it = &UTDrawIt;
		DocClear;

		"UT99: SoftDrv canvas %dx%d  F5/= cycle res\n",
			ut_canvas->width, ut_canvas->height;

		UTGameLoop;
	}
	catch
		PutExcept;

	ut_ready     = FALSE;
	Fs->draw_it  = NULL;
	Sleep(100);

	if (!raw_was_on)
		MouseRaw(FALSE);

	UTInputDrainAll;
	UTPresentFree;
	SettingsPop;
	MenuPop;

	UTWinExit;
	UTUWinExit;
	UTHUDExit;
	UTObjExit;
	UTClientExit;
	UTFontExit;
	UTSoftExit;
	UTLodExit;
	UTMusicExit;
	UTVMFreeAll;
	UTSndExit;
	UTTexDemoFree;

	if (ut_canvas != NULL)
	{
		UTDrawFree(ut_canvas);
		ut_canvas = NULL;
	}
	if (ut_bsp != NULL)
	{
		UTBspFree(ut_bsp);
		ut_bsp = NULL;
	}
	UTMapExit;

	UTLog("UT99 exit frames=%d fps=%4.1f\n", ut_frames, ut_fps);
	"UT99 done. Type $$LTBLUE$$UTTest;$$FG$$ for data-layer checks.\n";
}
