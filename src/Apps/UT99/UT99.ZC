// UT99.ZC - app shell: window, input, frame loop, SoftDrv DM scene.
//
// Rendering on this task; blit in draw_it on the window manager task.

#define UT_FOV			90.0
#define UT_HUD_COLOR	255

CUTCanvas	*ut_canvas	= NULL;
CUTBsp		*ut_bsp		= NULL;
Bool		 ut_ready	= FALSE;
F64			 ut_fps		= 0.0;
I64			 ut_frames	= 0;
I64			 ut_blit_x	= 0;
I64			 ut_blit_y	= 0;
I64			 ut_blit_w	= 320;
I64			 ut_blit_h	= 240;

U0 UTDrawIt(CTask *task, CDC *dc)
{
	I64 w;
	I64 h;
	I64 bw;
	I64 bh;
	F64 aspect;
	F64 win_asp;

	no_warn task;

	if (!ut_ready || !ut_canvas)
		return;

	w = dc->width;
	h = dc->height;
	if (w < 1 || h < 1)
		return;

	aspect  = ToF64(ut_canvas->width) / ToF64(ut_canvas->height);
	win_asp = ToF64(w) / ToF64(h);
	if (win_asp > aspect)
	{
		bh = h;
		bw = ToI64(ToF64(h) * aspect);
	}
	else
	{
		bw = w;
		bh = ToI64(ToF64(w) / aspect);
	}
	ut_blit_w = bw;
	ut_blit_h = bh;
	ut_blit_x = (w - bw) / 2;
	ut_blit_y = (h - bh) / 2;

	UTDrawBlitFit(ut_canvas, dc, ut_blit_x, ut_blit_y, ut_blit_w, ut_blit_h);
}

U0 UTCenterView(CTask *task)
{
	I64 w = task->pix_width;
	I64 h = task->pix_height;

	no_warn w;
	no_warn h;
}

U0 UTRenderFrame()
{
	I64 hx;
	I64 hy;
	U8 line[80];

	if (!ut_canvas)
		return;

	UTSoftLock(UT_LOCKR_CLEAR_SCREEN, 1);
	UTDrawSetView(ut_canvas, ut_origin, ut_view_pitch, ut_view_yaw,
		ut_view_roll, UT_FOV);

	if (ut_bsp)
		UTBspDrawRoom(ut_canvas, ut_bsp);
	if (ut_demo_mesh_ready && !ut_use_map)
		UTMeshDraw(ut_canvas, &ut_demo_mesh);

	if (ut_game_ready)
	{
		UTGameDrawBots(ut_canvas);
		UTActorDraw(ut_canvas);
		UTCTFDraw(ut_canvas);
		UTWeapDrawProjs(ut_canvas);
		UTDecalDraw(ut_canvas);
		UTWeapDrawView(ut_canvas);
		UTGameDrawHUD(ut_canvas);
		UTMenuDraw(ut_canvas);
	}

	hx = ut_canvas->width / 2;
	hy = ut_canvas->height / 2;
	UTSoftDraw2DLine(hx - 4, hy, hx + 4, hy, UT_HUD_COLOR);
	UTSoftDraw2DLine(hx, hy - 4, hx, hy + 4, UT_HUD_COLOR);

	//frag line top-left via soft pixels already; Print to log occasionally
	no_warn line;

	UTSoftUnlock;
}

U0 UTGameLoop()
{
	F64	t0;
	F64	t1;
	F64	dt;
	F64	fps_t;
	I64	fps_n;
	I64	dx;
	I64	dy;
	Bool done;

	t0    = tS;
	fps_t = t0;
	fps_n = 0;
	done  = FALSE;
	ut_ready = TRUE;

	while (!done)
	{
		if (ut_menu_quit)
			done = TRUE;

		dx = mouse_hard.raw_data.x;
		dy = mouse_hard.raw_data.y;
		MouseRawReset;
		if (!ut_menu_open)
			UTInMouseLook(dx, dy);
		UTInPollKeys;
		UTMenuPoll;
		t1 = tS;
		dt = t1 - t0;
		if (dt > 0.1)
			dt = 0.1;
		t0 = t1;
		if (ut_game_ready)
			UTGameTick(dt);
		else
			UTInMove(dt);
		UTRenderFrame;

		fps_n++;
		ut_frames++;
		if (t1 - fps_t >= 1.0)
		{
			ut_fps = ToF64(fps_n) / (t1 - fps_t);
			fps_n  = 0;
			fps_t  = t1;
			if (ut_game_ready)
				UTLog("UT99: fps=%4.1f hp=%3.0f ammo=%d frags=%d deaths=%d\n",
					ut_fps, ut_health, ut_ammo, ut_frags, ut_deaths);
		}

		Refresh;
	}

	ut_ready = FALSE;
}

U0 UT99()
{
	Bool raw_was_on = FALSE;

	UTLogInit;
	UTLog("UT99 start\n");

	ut_canvas = NULL;
	ut_bsp    = NULL;
	ut_ready  = FALSE;
	ut_fps    = 0.0;
	ut_frames = 0;

	UTPalInit;
	UTInInit;
	UTTexDemoInit;
	UTPalLoadFromUtx("::/Apps/UT99/Textures/ArenaTex.utx");
	if (UTTexLoadNamed("::/Apps/UT99/Textures/ArenaTex.utx", "Greywall",
		&ut_tex_grid))
		UTLog("UT99: loaded ArenaTex.Greywall\n");
	if (UTTexLoadNamed("::/Apps/UT99/Textures/ArenaTex.utx", "Arenaflr",
		&ut_tex_checker))
		UTLog("UT99: loaded ArenaTex.Arenaflr\n");
	UTMeshDemoInit;
	UTSndInit;
	UTVMProbeEngine;
	UTMusicInit;
	UTLodInit;
	UTMenuInit;

	ut_bsp = NULL;
	UTMapTryDefault;
	if (!ut_bsp)
		ut_bsp = UTBspBuildDemoRoom;

	UTGameInit;

	ut_canvas = UTDrawNew(UT_SCR_W, UT_SCR_H);
	if (!ut_canvas)
	{
		"UT99: canvas alloc failed\n";
		return;
	}
	UTSoftInit(ut_canvas);

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		AutoComplete;
		WinBorder;
		WinMax;
		DocCursor;
		DocClear;

		UTCenterView(Fs);
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;
		mouse_hard.bttns[0] = FALSE;
		mouse_hard.bttns[1] = FALSE;
		mouse_hard.bttns[2] = FALSE;

		Fs->draw_it = &UTDrawIt;

		if (ut_use_map)
			"UT99 SoftDrv DM %s\nWASD move, mouse look, SPACE jump, LMB fire, RMB alt, [ ] weapons, Tab scores, 1-4 maps, K suicide, ESC quit.\n",
				ut_map_name;
		else
			"UT99 SoftDrv demo room. WASD+mouse, ESC quit.\n";
		"Botpack weapons + movers + IT music samples. SoftDrv CPU only.\n";

		UTGameLoop;
	}
	catch
		PutExcept;

	ut_ready     = FALSE;
	Fs->draw_it  = NULL;
	Sleep(100);

	MouseRaw(FALSE);
	no_warn raw_was_on;

	SettingsPop;
	MenuPop;

	UTSoftExit;
	UTGameExit;
	UTLodExit;
	UTMusicExit;
	UTVMFreeAll;
	UTSndExit;
	UTTexDemoFree;

	if (ut_canvas)
	{
		UTDrawFree(ut_canvas);
		ut_canvas = NULL;
	}
	if (ut_bsp)
	{
		UTBspFree(ut_bsp);
		ut_bsp = NULL;
	}
	UTMapExit;

	UTLog("UT99 exit frames=%d fps=%4.1f frags=%d deaths=%d\n",
		ut_frames, ut_fps, ut_frags, ut_deaths);
	"UT99 done. Type $$LTBLUE$$UTTest;$$FG$$ for data-layer checks.\n";
}
