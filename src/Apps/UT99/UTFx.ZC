// UTFx.ZC - SoftDrv corona + particle billboard sprites (CPU).
//
// Corona: UnRender GAddCorona stand-in — translucent discs at Light actors.
// Particles: short SoftDrv additive sprites (blood puff / scorch / muzzle).

#define UT_FX_PART_MAX		128
#define UT_FX_CORONA_MAX	96

class CUTPart
{
	F64	 origin[3];
	F64	 vel[3];
	F64	 life;
	F64	 life0;
	F64	 size;
	I64	 color;
	Bool alive;
};

CUTPart	ut_fx_part[UT_FX_PART_MAX];
Bool	ut_fx_ready		= FALSE;
Bool	ut_fx_corona_on	= TRUE;
F64		ut_fx_corona_bright[UT_FX_CORONA_MAX];

U0 UTFxInit()
{
	MemSet(ut_fx_part, 0, sizeof(ut_fx_part));
	MemSet(ut_fx_corona_bright, 0, sizeof(ut_fx_corona_bright));
	ut_fx_ready = TRUE;
	ut_fx_corona_on = TRUE;
}

U0 UTFxExit()
{
	MemSet(ut_fx_part, 0, sizeof(ut_fx_part));
	ut_fx_ready = FALSE;
}

U0 UTFxSpawn(F64 *org, F64 *vel, F64 life, F64 size, I64 color)
{
	I64 i;
	CUTPart *p;

	if (!org || !ut_fx_ready)
		return;
	i = 0;
	while (i < UT_FX_PART_MAX)
	{
		if (!ut_fx_part[i].alive)
		{
			p = &ut_fx_part[i];
			UTVecCopy(org, p->origin);
			if (vel)
				UTVecCopy(vel, p->vel);
			else
			{
				p->vel[0] = 0; p->vel[1] = 0; p->vel[2] = 40.0;
			}
			p->life = life;
			p->life0 = life;
			p->size = size;
			p->color = color;
			p->alive = TRUE;
			return;
		}
		i++;
	}
}

U0 UTFxBurst(F64 *org, I64 n, I64 color)
{
	F64 v[3];
	F64 p[3];
	I64 i;

	if (!org)
		return;
	i = 0;
	while (i < n)
	{
		v[0] = Sin(ToF64(i) * 1.9 + tS) * 120.0;
		v[1] = Cos(ToF64(i) * 1.7 + tS) * 120.0;
		v[2] = 80.0 + ToF64(i & 3) * 30.0;
		p[0] = org[0] + v[0] * 0.02;
		p[1] = org[1] + v[1] * 0.02;
		p[2] = org[2] + ToF64(i) * 2.0;
		UTFxSpawn(p, v, 0.45 + ToF64(i & 3) * 0.08, 6.0 + ToF64(i & 2),
			color);
		i++;
	}
}

U0 UTFxBlood(F64 *org)
{
	UTFxBurst(org, 8, 40);
}

U0 UTFxScorch(F64 *org)
{
	UTFxBurst(org, 6, 16);
}

U0 UTFxMuzzle(F64 *org, F64 *dir)
{
	F64 v[3];
	F64 p[3];

	if (!org || !dir)
		return;
	v[0] = dir[0] * 200.0;
	v[1] = dir[1] * 200.0;
	v[2] = dir[2] * 200.0;
	p[0] = org[0] + dir[0] * 24.0;
	p[1] = org[1] + dir[1] * 24.0;
	p[2] = org[2] + dir[2] * 24.0;
	UTFxSpawn(p, v, 0.12, 10.0, 230);
}

U0 UTFxTick(F64 dt)
{
	I64 i;
	CUTPart *p;

	if (!ut_fx_ready)
		return;
	i = 0;
	while (i < UT_FX_PART_MAX)
	{
		p = &ut_fx_part[i];
		if (p->alive)
		{
			p->origin[0] += p->vel[0] * dt;
			p->origin[1] += p->vel[1] * dt;
			p->origin[2] += p->vel[2] * dt;
			p->vel[2] -= 280.0 * dt;
			p->life -= dt;
			if (p->life <= 0.0)
				p->alive = FALSE;
		}
		i++;
	}
}

U0 UTFxDrawSoftDisc(CUTCanvas *c, I64 cx, I64 cy, I64 rad, F64 iz,
	I64 color, F64 alpha)
{//SoftDrv corona / particle disc — PF_Translucent add falloff.
	I64 x;
	I64 y;
	I64 x0;
	I64 x1;
	I64 y0;
	I64 y1;
	I64 dx;
	I64 dy;
	I64 rr;
	I64 i;
	F64 d;
	F64 a;
	U8 *row;

	if (!c || rad < 1 || alpha < 0.02)
		return;
	rr = rad * rad;
	x0 = cx - rad;
	x1 = cx + rad;
	y0 = cy - rad;
	y1 = cy + rad;
	if (x0 < 0) x0 = 0;
	if (y0 < 0) y0 = 0;
	if (x1 >= c->width) x1 = c->width - 1;
	if (y1 >= c->height) y1 = c->height - 1;
	y = y0;
	while (y <= y1)
	{
		dy = y - cy;
		row = c->pixels + y * c->width;
		x = x0;
		while (x <= x1)
		{
			dx = x - cx;
			if (dx * dx + dy * dy <= rr)
			{
				d = Sqrt(ToF64(dx * dx + dy * dy)) / ToF64(rad);
				a = (1.0 - d) * (1.0 - d) * alpha;
				if (a > 0.04)
				{
					i = x;
					if (iz >= c->depth[y * c->width + i] * 0.98)
						row[i] = UTPalBlendAdd(color & 255, row[i]);
				}
			}
			x++;
		}
		y++;
	}
}

U0 UTFxDrawParts(CUTCanvas *c)
{
	I64 i;
	CUTPart *p;
	F64 sx;
	F64 sy;
	F64 iz;
	F64 fade;
	I64 rad;

	if (!c || !ut_fx_ready)
		return;
	i = 0;
	while (i < UT_FX_PART_MAX)
	{
		p = &ut_fx_part[i];
		if (p->alive)
		{
			if (UTDrawProject(c, p->origin, &sx, &sy, &iz))
			{
				fade = p->life / p->life0;
				rad = ToI64(p->size * (0.4 + 0.6 * fade) *
					(iz * 80.0));
				if (rad < 1)
					rad = 1;
				if (rad > 48)
					rad = 48;
				UTFxDrawSoftDisc(c, ToI64(sx), ToI64(sy), rad, iz,
					p->color, fade);
			}
		}
		i++;
	}
}

U0 UTFxDrawCoronas(CUTCanvas *c)
{//UnRender corona pass — Light actors with distance fade.
	I64 i;
	I64 n;
	CUTLight *L;
	F64 sx;
	F64 sy;
	F64 iz;
	F64 z;
	F64 bright;
	F64 target;
	I64 rad;
	I64 col;

	if (!c || !ut_fx_corona_on || !ut_light_ready)
		return;
	n = ut_light_n;
	if (n > UT_FX_CORONA_MAX)
		n = UT_FX_CORONA_MAX;
	i = 0;
	while (i < n)
	{
		L = &ut_lights[i];
		target = 0.0;
		if (L->active && UTDrawProject(c, L->origin, &sx, &sy, &iz))
		{
			z = 1.0 / iz;
			if (z < L->radius * 2.5)
			{
				target = L->bright * (1.0 - z / (L->radius * 2.5));
				if (target < 0.0)
					target = 0.0;
				if (target > 1.0)
					target = 1.0;
			}
		}
		//fade in/out like GAddCorona Bright ramp
		if (target > ut_fx_corona_bright[i])
		{
			ut_fx_corona_bright[i] += 0.08;
			if (ut_fx_corona_bright[i] > target)
				ut_fx_corona_bright[i] = target;
		}
		else
		{
			ut_fx_corona_bright[i] -= 0.05;
			if (ut_fx_corona_bright[i] < target)
				ut_fx_corona_bright[i] = target;
			if (ut_fx_corona_bright[i] < 0.0)
				ut_fx_corona_bright[i] = 0.0;
		}
		bright = ut_fx_corona_bright[i];
		if (bright > 0.05 && UTDrawProject(c, L->origin, &sx, &sy, &iz))
		{
			rad = ToI64(18.0 + bright * 40.0 * iz * 120.0);
			if (rad > 64)
				rad = 64;
			if (rad < 3)
				rad = 3;
			col = 231;
			if (L->bright < 0.4)
				col = 200;
			//LightHue → SoftDrv pen bands (approx Unreal Hue wheel)
			if (L->hue >= 0)
			{
				if (L->hue < 21)
					col = 249;
				else if (L->hue < 43)
					col = 237;
				else if (L->hue < 85)
					col = 250;
				else if (L->hue < 128)
					col = 200;
				else if (L->hue < 170)
					col = 211;
				else if (L->hue < 213)
					col = 13;
				else
					col = 249;
			}
			UTFxDrawSoftDisc(c, ToI64(sx), ToI64(sy), rad, iz, col,
				bright * 0.85);
		}
		i++;
	}
}

U0 UTFxDraw(CUTCanvas *c)
{
	UTFxDrawCoronas(c);
	UTFxDrawParts(c);
}
