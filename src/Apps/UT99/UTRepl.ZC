// UTRepl.ZC - host-local PlayerReplicationInfo stand-in (no sockets).
//
// SoftDrv single-player: PRI fields mirror GameInfo scoreboard state.
// RemoteRole / NetPriority absent; Sync each tick from host vars.

#define UT_REPL_NAME_LEN	32
#define UT_REPL_BOT_MAX		8

class CUTPRI
{//= PlayerReplicationInfo host mirror
	U8	 name[UT_REPL_NAME_LEN];
	I64	 score;
	I64	 deaths;
	I64	 team;
	I64	 ping;
	Bool bot;
	Bool alive;
};

CUTPRI	ut_pri_player;
CUTPRI	ut_pri_bots[UT_REPL_BOT_MAX];
I64		ut_pri_bot_n	= 0;
I64		ut_obj_pri	= -1;	//UObject slot for player PRI

extern I64	ut_player_team;

U0 UTReplClear()
{
	I64 i;

	MemSet(&ut_pri_player, 0, sizeof(CUTPRI));
	StrPrint(ut_pri_player.name, "Player");
	ut_pri_player.team = 0;
	ut_pri_player.alive = TRUE;
	i = 0;
	while (i < UT_REPL_BOT_MAX)
	{
		MemSet(&ut_pri_bots[i], 0, sizeof(CUTPRI));
		i++;
	}
	ut_pri_bot_n = 0;
	ut_obj_pri = -1;
}

Bool UTReplBindObj()
{//Pool PlayerReplicationInfo0 under Pawn
	I64 slot;

	slot = UTObjNew("PlayerReplicationInfo0", "PlayerReplicationInfo",
		"::/Apps/UT99/System/Engine.u");
	if (slot < 0)
		return FALSE;
	ut_obj_pri = slot;
	if (ut_obj_pawn >= 0)
	{
		UTObjSetOuter(slot, ut_obj_pawn);
		UTObjSetOwner(slot, ut_obj_pawn);
	}
	ut_obj[slot].bag.team = ut_pri_player.team;
	ut_obj[slot].bag.health = ut_health;
	return TRUE;
}

U0 UTReplSync()
{//= SimulateRelevant — host copy Game → PRI (no net channel)
	I64 i;
	I64 n;

	if (!ut_game_ready)
		return;
	ut_pri_player.score = ut_frags;
	ut_pri_player.deaths = ut_deaths;
	ut_pri_player.team = ut_player_team & 1;
	ut_pri_player.alive = ut_alive;
	ut_pri_player.ping = 0;
	ut_pri_player.bot = FALSE;
	if (ut_obj_pri >= 0 && ut_obj_pri < ut_obj_n)
	{
		ut_obj[ut_obj_pri].bag.team = ut_pri_player.team;
		ut_obj[ut_obj_pri].bag.health = ut_health;
		ut_obj[ut_obj_pri].bag.ints[0] = ut_pri_player.score;
		ut_obj[ut_obj_pri].bag.ints[1] = ut_pri_player.deaths;
	}
	n = ut_bot_count;
	if (n > UT_REPL_BOT_MAX)
		n = UT_REPL_BOT_MAX;
	if (n > UT_GM_BOT_MAX)
		n = UT_GM_BOT_MAX;
	ut_pri_bot_n = n;
	i = 0;
	while (i < n)
	{
		ut_pri_bots[i].bot = TRUE;
		ut_pri_bots[i].alive = ut_bots[i].alive;
		ut_pri_bots[i].score = ut_bots[i].score;
		ut_pri_bots[i].team = ut_bots[i].team;
		ut_pri_bots[i].deaths = 0;
		ut_pri_bots[i].ping = 0;
		StrPrint(ut_pri_bots[i].name, "Bot%d", i + 1);
		i++;
	}
}
