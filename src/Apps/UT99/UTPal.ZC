// UTPal.ZC - SoftDrv 256-colour palette + ARGB blit table.
//
// Upstream: Engine/Inc/UnTex.h FColor / UPalette. SoftDrv canvas is P8;
// draw_it expands through ut_pal_argb into truecolor CDC (Quake/HL1 path).
// GrPalette is 16-slot legacy only — sampled from UT pal so Doc/chrome
// cannot keep YDE red while SoftDrv runs. SettingsPop restores it.

U32 ut_pal_argb[256];
U8  ut_pal_r[256];
U8  ut_pal_g[256];
U8  ut_pal_b[256];
Bool ut_pal_ready = FALSE;
Bool ut_pal_gr_saved = FALSE;
CBGR24 ut_pal_gr_backup[COLORS_NUM];

// SoftDrv UI pens — BestMatch after UPalette load (not YDE RED/WHITE consts)
I64 ut_col_black	= 0;
I64 ut_col_white	= 255;
I64 ut_col_dim		= 180;
I64 ut_col_gold		= 250;
I64 ut_col_health	= 250;
I64 ut_col_armor	= 200;
I64 ut_col_ammo		= 180;
I64 ut_col_frag		= 40;
I64 ut_col_bar		= 48;
I64 ut_col_panel	= 8;
I64 ut_col_edge		= 16;
I64 ut_col_cross	= 255;

U0 UTPalSet(I64 idx, U8 r, U8 g, U8 b)
{
	if (idx < 0 || idx > 255)
		return;
	ut_pal_r[idx] = r;
	ut_pal_g[idx] = g;
	ut_pal_b[idx] = b;
	ut_pal_argb[idx] = (r << 16) | (g << 8) | b;
}

I64 UTPalBestMatch(U8 r, U8 g, U8 b, I64 first)
{//UPalette::BestMatch, squared RGB distance
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best   = first;
	best_d = 0x7FFFFFFF;
	i      = first;
	while (i < 256)
	{
		dr = ToI64(ut_pal_r[i]) - ToI64(r);
		dg = ToI64(ut_pal_g[i]) - ToI64(g);
		db = ToI64(ut_pal_b[i]) - ToI64(b);
		d  = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best   = i;
		}
		i++;
	}
	return best;
}

U0 UTPalBindUI()
{//map HUD/menu RGB to SoftDrv indices after palette install
	ut_col_black  = 0;
	UTPalSet(0, 0, 0, 0);
	ut_col_white  = UTPalBestMatch(255, 255, 255, 1);
	ut_col_dim    = UTPalBestMatch(160, 160, 160, 1);
	ut_col_gold   = UTPalBestMatch(255, 200, 64, 1);
	ut_col_health = UTPalBestMatch(255, 48, 48, 1);
	ut_col_armor  = UTPalBestMatch(64, 160, 255, 1);
	ut_col_ammo   = UTPalBestMatch(255, 220, 64, 1);
	ut_col_frag   = UTPalBestMatch(255, 64, 32, 1);
	ut_col_bar    = UTPalBestMatch(96, 24, 24, 1);
	ut_col_panel  = UTPalBestMatch(32, 32, 40, 1);
	ut_col_edge   = UTPalBestMatch(180, 140, 48, 1);
	ut_col_cross  = ut_col_white;
}

U0 UTPalGrInstall()
{//16-slot GrPalette sample from UT 256. Doc bleed / legacy pens stop using YDE.
	I64 i;
	I64 src;
	CBGR24 c;

	if (!ut_pal_gr_saved)
	{
		GrPaletteGet(ut_pal_gr_backup);
		ut_pal_gr_saved = TRUE;
	}
	i = 0;
	while (i < COLORS_NUM)
	{
		src = i * 16;
		if (src > 255)
			src = 255;
		if (i == 0)
			src = 0;
		c.b = ut_pal_b[src];
		c.g = ut_pal_g[src];
		c.r = ut_pal_r[src];
		c.pad = 0;
		gr_palette[i] = c;
		i++;
	}
	c.b = ut_pal_b[ut_col_health & 255];
	c.g = ut_pal_g[ut_col_health & 255];
	c.r = ut_pal_r[ut_col_health & 255];
	c.pad = 0;
	gr_palette[RED] = c;
	c.b = 0;
	c.g = 0;
	c.r = 0;
	c.pad = 0;
	gr_palette[BLACK] = c;
	c.b = 255;
	c.g = 255;
	c.r = 255;
	gr_palette[WHITE] = c;
	GrPaletteSet(gr_palette);
}

U0 UTPalGrRestore()
{
	if (!ut_pal_gr_saved)
		return;
	GrPaletteSet(ut_pal_gr_backup);
	ut_pal_gr_saved = FALSE;
}

U0 UTPalInstall()
{//index 0 forced black; UI pens; truecolor blit table ready.
 //GrPalette install is separate — call UTPalGrInstall after SettingsPush.
	UTPalSet(0, 0, 0, 0);
	UTPalBindUI;
	ut_pal_ready = TRUE;
}

U0 UTPalInit()
{//neutral grey ramp until a UPalette serial loads. Index 0 = black.
	I64 i;
	I64 v;

	i = 0;
	while (i < 256)
	{
		v = i;
		UTPalSet(i, v, v, v);
		i++;
	}
	UTPalSet(0, 0, 0, 0);
	ut_pal_ready = TRUE;
	UTPalBindUI;
}

Bool UTPalLoadRaw(U8 *data, I64 size)
{//raw 256 * FColor (R G B A), Intel order from UnTex.h
	I64 i;
	U8 *p;

	if (!data || size < 256 * 4)
		return FALSE;
	p = data;
	i = 0;
	while (i < 256)
	{
		UTPalSet(i, p[0], p[1], p[2]);
		p += 4;
		i++;
	}
	UTPalInstall;
	return TRUE;
}
