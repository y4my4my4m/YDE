// UTPal.ZC - 256-colour palette + ARGB expansion.
//
// Upstream: Engine/Inc/UnTex.h FColor / UPalette. Default ramp is procedural
// until a UPalette serial blob is decoded from a .utx.

U32 ut_pal_argb[256];
U8  ut_pal_r[256];
U8  ut_pal_g[256];
U8  ut_pal_b[256];
Bool ut_pal_ready = FALSE;

U0 UTPalInit()
{//flat grey ramp + primary accents so a clear screen is never black-on-black
	I64 i;
	I64 v;

	i = 0;
	while (i < 256)
	{
		v = i;
		ut_pal_r[i] = v;
		ut_pal_g[i] = v;
		ut_pal_b[i] = v;
		ut_pal_argb[i] = (v << 16) | (v << 8) | v;
		i++;
	}
	//UT orange-ish accent at 255
	ut_pal_r[255] = 0xE0;
	ut_pal_g[255] = 0x80;
	ut_pal_b[255] = 0x20;
	ut_pal_argb[255] = 0x00E08020;
	ut_pal_r[1] = 0x40;
	ut_pal_g[1] = 0x40;
	ut_pal_b[1] = 0x80;
	ut_pal_argb[1] = 0x00404080;
	ut_pal_ready = TRUE;
}

U0 UTPalSet(I64 idx, U8 r, U8 g, U8 b)
{
	if (idx < 0 || idx > 255)
		return;
	ut_pal_r[idx] = r;
	ut_pal_g[idx] = g;
	ut_pal_b[idx] = b;
	ut_pal_argb[idx] = (r << 16) | (g << 8) | b;
}

Bool UTPalLoadRaw(U8 *data, I64 size)
{//raw 256 * FColor (R G B A), Intel order from UnTex.h
	I64 i;
	U8 *p;

	if (!data || size < 256 * 4)
		return FALSE;
	p = data;
	i = 0;
	while (i < 256)
	{
		UTPalSet(i, p[0], p[1], p[2]);
		p += 4;
		i++;
	}
	ut_pal_ready = TRUE;
	return TRUE;
}

I64 UTPalBestMatch(U8 r, U8 g, U8 b, I64 first)
{//UPalette::BestMatch, squared RGB distance
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best   = first;
	best_d = 0x7FFFFFFF;
	i      = first;
	while (i < 256)
	{
		dr = ToI64(ut_pal_r[i]) - ToI64(r);
		dg = ToI64(ut_pal_g[i]) - ToI64(g);
		db = ToI64(ut_pal_b[i]) - ToI64(b);
		d  = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best   = i;
		}
		i++;
	}
	return best;
}
