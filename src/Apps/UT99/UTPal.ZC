// UTPal.ZC - SoftDrv 256-colour palette + ARGB blit table.
//
// Upstream: Engine/Inc/UnTex.h FColor / UPalette. SoftDrv canvas is P8;
// draw_it expands through ut_pal_argb into truecolor CDC (Quake/HL1 path).
// GrPalette is 16-slot legacy only — forced UT dark chrome while SoftDrv
// runs so Doc/YDE RED cannot wash the window. SettingsPop restores it.
//
// UI pens live in reserved high slots (240+) with hardcoded ARGB. BestMatch
// alone picks ArenaTex reds and paints the menu YDE-red.

U32 ut_pal_argb[256];
U8  ut_pal_r[256];
U8  ut_pal_g[256];
U8  ut_pal_b[256];
Bool ut_pal_ready = FALSE;
Bool ut_pal_gr_saved = FALSE;
CBGR24 ut_pal_gr_backup[COLORS_NUM];

// SoftDrv UI pens — reserved indices, never YDE RED/theme consts
I64 ut_col_black	= 0;
I64 ut_col_white	= 255;
I64 ut_col_dim		= 254;
I64 ut_col_gold		= 253;
I64 ut_col_health	= 249;
I64 ut_col_armor	= 248;
I64 ut_col_ammo		= 247;
I64 ut_col_frag		= 246;
I64 ut_col_bar		= 251;
I64 ut_col_panel	= 252;
I64 ut_col_edge		= 250;
I64 ut_col_cross	= 255;
I64 ut_col_blue0	= 245;
I64 ut_col_blue1	= 244;
I64 ut_col_blue2	= 243;
//UWindow Win95 LookAndFeel pens (debug SoftDrv chrome / ut_menu_fake_laf)
I64 ut_col_laf_title	= 242;
I64 ut_col_laf_title2	= 241;
I64 ut_col_laf_client	= 240;
I64 ut_col_laf_face	= 239;
I64 ut_col_laf_hi	= 238;
I64 ut_col_laf_lo	= 237;
I64 ut_col_menubar	= 236;
I64 ut_col_status	= 235;
I64 ut_col_edit		= 234;
I64 ut_col_sel		= 233;
I64 ut_col_label	= 232;

U0 UTPalSet(I64 idx, U8 r, U8 g, U8 b)
{
	if (idx < 0 || idx > 255)
		return;
	ut_pal_r[idx] = r;
	ut_pal_g[idx] = g;
	ut_pal_b[idx] = b;
	ut_pal_argb[idx] = (r << 16) | (g << 8) | b;
}

I64 UTPalBestMatch(U8 r, U8 g, U8 b, I64 first)
{//UPalette::BestMatch, squared RGB distance
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best   = first;
	best_d = 0x7FFFFFFF;
	i      = first;
	while (i < 256)
	{
		dr = ToI64(ut_pal_r[i]) - ToI64(r);
		dg = ToI64(ut_pal_g[i]) - ToI64(g);
		db = ToI64(ut_pal_b[i]) - ToI64(b);
		d  = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best   = i;
		}
		i++;
	}
	return best;
}

U8 UTPalShadeIndex(U8 texel, F64 shade)
{//SoftDrv light without lightmaps: dim RGB, re-quantize. Never index*shade.
	I64 r;
	I64 g;
	I64 b;
	I64 t;

	if (shade >= 0.99)
		return texel;
	if (shade < 0.12)
		shade = 0.12;
	t = texel & 255;
	r = ToI64(ToF64(ut_pal_r[t]) * shade);
	g = ToI64(ToF64(ut_pal_g[t]) * shade);
	b = ToI64(ToF64(ut_pal_b[t]) * shade);
	if (r > 255) r = 255;
	if (g > 255) g = 255;
	if (b > 255) b = 255;
	return UTPalBestMatch(r, g, b, 1) & 255;
}

U0 UTPalBindUI()
{//Force UT menu/HUD pens into reserved slots. Dark blue chrome, gold select.
 //Index 0 stays black (SoftDrv mask / clear).
	ut_col_black = 0;
	UTPalSet(0, 0, 0, 0);

	//Form labels on dark panels. Menubar/pulldown use ut_col_white (Blue LAF
	//retail is black on light BlueBar/BlueMenuArea; SoftDrv lists need white).
	ut_col_label = 232;
	UTPalSet(232, 220, 224, 236);
	ut_col_sel = 233;
	UTPalSet(233, 64, 112, 200);
	ut_col_edit = 234;
	UTPalSet(234, 255, 255, 255);
	ut_col_status = 235;
	UTPalSet(235, 48, 72, 168);
	ut_col_menubar = 236;
	UTPalSet(236, 168, 168, 176);
	ut_col_laf_lo = 237;
	UTPalSet(237, 48, 56, 80);
	ut_col_laf_hi = 238;
	UTPalSet(238, 220, 224, 236);
	ut_col_laf_face = 239;
	UTPalSet(239, 152, 156, 176);
	ut_col_laf_client = 240;
	UTPalSet(240, 176, 180, 200);
	ut_col_laf_title2 = 241;
	UTPalSet(241, 96, 128, 220);
	ut_col_laf_title = 242;
	UTPalSet(242, 40, 64, 176);

	ut_col_blue2 = 243;
	UTPalSet(243, 8, 12, 32);
	ut_col_blue1 = 244;
	UTPalSet(244, 12, 20, 48);
	ut_col_blue0 = 245;
	UTPalSet(245, 20, 32, 72);

	ut_col_frag = 246;
	UTPalSet(246, 220, 48, 32);
	ut_col_ammo = 247;
	UTPalSet(247, 255, 220, 64);
	ut_col_armor = 248;
	UTPalSet(248, 64, 160, 255);
	ut_col_health = 249;
	UTPalSet(249, 220, 40, 40);

	ut_col_edge = 250;
	UTPalSet(250, 72, 88, 128);
	ut_col_bar = 251;
	UTPalSet(251, 80, 120, 200);
	ut_col_panel = 252;
	UTPalSet(252, 16, 24, 56);
	ut_col_gold = 253;
	UTPalSet(253, 255, 220, 96);
	ut_col_dim = 254;
	UTPalSet(254, 168, 176, 196);
	ut_col_white = 255;
	UTPalSet(255, 255, 255, 255);
	ut_col_cross = ut_col_white;
}

U0 UTPalGrInstall()
{//16-slot GrPalette = UT dark chrome. RED slot is dark blue, not health.
	I64 i;
	CBGR24 c;

	if (!ut_pal_gr_saved)
	{
		GrPaletteGet(ut_pal_gr_backup);
		ut_pal_gr_saved = TRUE;
	}
	i = 0;
	while (i < COLORS_NUM)
	{
		c.b = ut_pal_b[ut_col_panel & 255];
		c.g = ut_pal_g[ut_col_panel & 255];
		c.r = ut_pal_r[ut_col_panel & 255];
		c.pad = 0;
		gr_palette[i] = c;
		i++;
	}
	c.b = 0;
	c.g = 0;
	c.r = 0;
	c.pad = 0;
	gr_palette[BLACK] = c;
	c.b = ut_pal_b[ut_col_blue0 & 255];
	c.g = ut_pal_g[ut_col_blue0 & 255];
	c.r = ut_pal_r[ut_col_blue0 & 255];
	gr_palette[BLUE] = c;
	gr_palette[RED] = c;
	c.b = ut_pal_b[ut_col_dim & 255];
	c.g = ut_pal_g[ut_col_dim & 255];
	c.r = ut_pal_r[ut_col_dim & 255];
	gr_palette[DKGRAY] = c;
	c.b = 255;
	c.g = 255;
	c.r = 255;
	gr_palette[WHITE] = c;
	GrPaletteSet(gr_palette);
}

U0 UTPalGrRestore()
{
	if (!ut_pal_gr_saved)
		return;
	GrPaletteSet(ut_pal_gr_backup);
	ut_pal_gr_saved = FALSE;
}

U0 UTPalInstall()
{//index 0 forced black; UI pens; truecolor blit table ready.
 //GrPalette install is separate — call UTPalGrInstall after SettingsPush.
	UTPalSet(0, 0, 0, 0);
	UTPalBindUI;
	ut_pal_ready = TRUE;
}

U0 UTPalInit()
{//neutral grey ramp until a UPalette serial loads. Index 0 = black.
	I64 i;
	I64 v;

	i = 0;
	while (i < 256)
	{
		v = i;
		UTPalSet(i, v, v, v);
		i++;
	}
	UTPalSet(0, 0, 0, 0);
	ut_pal_ready = TRUE;
	UTPalBindUI;
}

Bool UTPalLoadRaw(U8 *data, I64 size)
{//raw 256 * FColor (R G B A), Intel order from UnTex.h
	I64 i;
	U8 *p;

	if (!data || size < 256 * 4)
		return FALSE;
	p = data;
	i = 0;
	while (i < 256)
	{
		UTPalSet(i, p[0], p[1], p[2]);
		p += 4;
		i++;
	}
	UTPalInstall;
	return TRUE;
}
