// UTTex.ZC - SoftDrv P8 textures. Upstream: UnTex.h UBitmap/UTexture/FMipmap.
//
// TEXF_P8 only. DXT1 and truecolor paths are GPU SoftDrv alternatives; this
// tree is SpanBased indexed colour, same class as Quake's 8bpp canvas.

#define UT_TEXF_P8		0x00
#define UT_TEXF_RGBA7	0x01
#define UT_TEXF_RGB16	0x02
#define UT_TEXF_DXT1	0x03
#define UT_TEXF_RGB8	0x04
#define UT_TEXF_RGBA8	0x05

//1024x1024 serializes 11 levels. At 8 every texture >=256 was rejected
//outright, so the map drew the fallback.
#define UT_TEX_MAX_MIPS	13
#define UT_TEX_MAX_SIDE	256

class CUTMip
{
	U8	*pixels;
	I64	 u_size;
	I64	 v_size;
	I64	 u_bits;
	I64	 v_bits;
};

class CUTTex
{
	U8		format;		//ETextureFormat; SoftDrv uses TEXF_P8
	I64		u_size;
	I64		v_size;
	I64		u_bits;
	I64		v_bits;
	U32		poly_flags;
	I64		num_mips;
	CUTMip	mips[UT_TEX_MAX_MIPS];
	U8		name[64];
	Bool	has_remap;		//source UPalette → global SoftDrv pens
	U8		remap[256];
	//Truecolor: this texture's own UPalette as ARGB. Every UT texture carries
	//its own palette, so remapping them all into one global 256-pen table is
	//lossy by construction. Kept verbatim and sampled directly.
	Bool	has_argb;
	U32		argb[256];
	CUTTex	*detail;		//UTexture.DetailTexture; SoftDrv modulate pass
	CUTTex	*macro;			//UTexture.MacroTexture when present
};

CUTTex ut_tex_checker;
CUTTex ut_tex_grid;
Bool   ut_tex_ready = FALSE;

U0 UTTexFreeMips(CUTTex *t)
{//Only Free heap mip pixels. Caller must MemSet CUTTex before first use.
	I64 i;
	I64 n;

	if (!t)
		return;
	n = t->num_mips;
	if (n < 0)
		n = 0;
	if (n > UT_TEX_MAX_MIPS)
		n = UT_TEX_MAX_MIPS;
	i = 0;
	while (i < n)
	{
		if (t->mips[i].pixels)
		{
			Free(t->mips[i].pixels);
			t->mips[i].pixels = NULL;
		}
		t->mips[i].u_size = 0;
		t->mips[i].v_size = 0;
		t->mips[i].u_bits = 0;
		t->mips[i].v_bits = 0;
		i++;
	}
	t->num_mips = 0;
}

U0 UTTexInit(CUTTex *t)
{
	MemSet(t, 0, sizeof(CUTTex));
	t->format = UT_TEXF_P8;
}

Bool UTTexAllocMip0(CUTTex *t, I64 u_bits, I64 v_bits)
{
	I64 us;
	I64 vs;

	if (u_bits < 1 || v_bits < 1 || u_bits > 8 || v_bits > 8)
		return FALSE;
	us = 1 << u_bits;
	vs = 1 << v_bits;
	UTTexFreeMips(t);
	t->format  = UT_TEXF_P8;
	t->u_bits  = u_bits;
	t->v_bits  = v_bits;
	t->u_size  = us;
	t->v_size  = vs;
	t->num_mips = 1;
	t->mips[0].u_bits  = u_bits;
	t->mips[0].v_bits  = v_bits;
	t->mips[0].u_size  = us;
	t->mips[0].v_size  = vs;
	t->mips[0].pixels = CAlloc(us * vs);
	return t->mips[0].pixels != NULL;
}

U8 UTTexSampleMip(CUTTex *t, I64 u, I64 v, I64 mip)
{//DrawSurf picks a mip per span from the texel step and masks with that mip's
 //size. Sampling mip 0 at every distance aliases oblique and far surfaces into
 //speckle, which reads as noise over the whole scene.
	I64 um;
	I64 vm;
	I64 texel;
	CUTMip *m;

	if (!t || t->num_mips < 1)
		return 0;
	if (mip < 0)
		mip = 0;
	if (mip > t->num_mips - 1)
		mip = t->num_mips - 1;
	m = &t->mips[mip];
	if (!m->pixels || m->u_size < 1 || m->v_size < 1)
	{
		m = &t->mips[0];
		if (!m->pixels)
			return 0;
		mip = 0;
	}
	um = (u >> mip) & (m->u_size - 1);
	vm = (v >> mip) & (m->v_size - 1);
	texel = m->pixels[vm * m->u_size + um] & 255;
	//Raw source index. remap[] is a global-palette pen while argb[] is keyed
	//by the source index, so returning the pen made the truecolor path read
	//argb[remap[i]] and scatter adjacent texels into unrelated entries.
	//DrawSurf indexes the quad palette with the raw texel. Indexed callers
	//convert with UTTexPen.
	return texel & 255;
}

U8 UTTexPen(CUTTex *t, I64 raw)
{//source index -> active SoftDrv pen. Indexed (P8) path only.
	if (!t)
		return 0;
	if (t->has_remap)
		return t->remap[raw & 255];
	return raw & 255;
}

I64 UTTexMipForStep(CUTTex *t, F64 du, F64 dv)
{//log2 of texels crossed per pixel; the span's level of detail.
	F64 d;
	I64 mip;

	if (!t || t->num_mips < 2)
		return 0;
	d = du;
	if (d < 0.0)
		d = -d;
	if (dv > d)
		d = dv;
	else if (-dv > d)
		d = -dv;
	mip = 0;
	while (d >= 2.0 && mip < t->num_mips - 1)
	{
		d = d * 0.5;
		mip++;
	}
	return mip;
}

U8 UTTexSample(CUTTex *t, I64 u, I64 v)
{//point sample mip0, tiled. mask = size-1 for power-of-two.
 //Optional per-tex remap: source .utx UPalette → active SoftDrv pens.
	I64 um;
	I64 vm;
	I64 texel;
	CUTMip *m;

	if (!t || t->num_mips < 1 || !t->mips[0].pixels)
		return 0;
	m  = &t->mips[0];
	um = u & (m->u_size - 1);
	vm = v & (m->v_size - 1);
	texel = m->pixels[vm * m->u_size + um] & 255;
	//Raw source index. remap[] is a global-palette pen while argb[] is keyed
	//by the source index, so returning the pen made the truecolor path read
	//argb[remap[i]] and scatter adjacent texels into unrelated entries.
	//DrawSurf indexes the quad palette with the raw texel. Indexed callers
	//convert with UTTexPen.
	return texel & 255;
}

U0 UTTexClearRemap(CUTTex *t)
{
	I64 i;

	if (!t)
		return;
	t->has_remap = FALSE;
	i = 0;
	while (i < 256)
	{
		t->remap[i] = i & 255;
		i++;
	}
}

Bool UTTexBuildRemapFromPal(CUTTex *t, U8 *pal_rgba, I64 pal_bytes)
{//Map each source palette index onto global ut_pal via BestMatch.
	I64 i;
	U8 *p;
	I64 dst;

	if (!t || !pal_rgba || pal_bytes < 256 * 4)
		return FALSE;
	p = pal_rgba;
	i = 0;
	while (i < 256)
	{
		if (i == 0)
			dst = 0;
		else
			dst = UTPalBestMatch(p[0], p[1], p[2], 1) & 255;
		t->remap[i] = dst & 255;
		//Keep the true colour alongside the index remap.
		t->argb[i] = ((p[0] & 255) << 16) | ((p[1] & 255) << 8) |
			(p[2] & 255);
		p += 4;
		i++;
	}
	t->has_remap = TRUE;
	t->has_argb = TRUE;
	return TRUE;
}

Bool UTTexRemapFromPaletteExport(CUTPackage *pkg, CUTTex *t, I64 pal_i)
{//UPalette export -> this texture's palette. TArray<FColor>: count, 256*RGBA.
	CUTExport *e;
	CUTArc ar;
	U8 *raw;
	I64 n;

	if (!pkg || !t || pal_i < 0 || pal_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[pal_i];
	if (!UTPkgArcExport(pkg, pal_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	UTPropSkipAll(&ar, pkg);
	ar.err = FALSE;
	n = UTArcIndex(&ar);
	if (ar.err || n < 256)
	{
		//No count prefix: raw 1024 bytes from the property end.
		ar.pos = e->serial_offset;
		ar.err = FALSE;
		UTPropSkipStack(&ar, e->object_flags);
		UTPropSkipAll(&ar, pkg);
		ar.err = FALSE;
		raw = UTArcPtr(&ar, 256 * 4);
		if (!raw)
			return FALSE;
		return UTTexBuildRemapFromPal(t, raw, 256 * 4);
	}
	raw = UTArcPtr(&ar, n * 4);
	if (!raw)
		return FALSE;
	return UTTexBuildRemapFromPal(t, raw, 256 * 4);
}

Bool UTTexRemapFromPackage(CUTPackage *pkg, CUTTex *t)
{//If package carries a UPalette, remap texels into active SoftDrv palette.
	I64 i;
	CUTExport *e;
	CUTArc ar;
	U8 *raw;
	I64 n;
	Bool ok;

	if (!pkg || !t)
		return FALSE;
	UTTexClearRemap(t);
	i = UTPkgFindExport(pkg, "Palette", NULL);
	if (i < 0)
		return FALSE;
	e = &pkg->exports[i];
	if (!UTPkgArcExport(pkg, i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	UTPropSkipAll(&ar, pkg);
	ar.err = FALSE;
	//UPalette: TArray<FColor> — count then 256*RGBA, or raw 1024.
	n = UTArcIndex(&ar);
	if (ar.err || n < 256)
	{
		ar.pos = e->serial_offset;
		ar.err = FALSE;
		UTPropSkipStack(&ar, e->object_flags);
		UTPropSkipAll(&ar, pkg);
		ar.err = FALSE;
		raw = UTArcPtr(&ar, 256 * 4);
		if (!raw)
			return FALSE;
		return UTTexBuildRemapFromPal(t, raw, 256 * 4);
	}
	raw = UTArcPtr(&ar, n * 4);
	if (!raw || n < 256)
		return FALSE;
	ok = UTTexBuildRemapFromPal(t, raw, 256 * 4);
	return ok;
}

U0 UTTexArgbFromGlobalPal(CUTTex *t)
{//Procedural textures own no UPalette. Without ARGB the truecolor path
 //samples zeros and paints black.
	I64 i;

	if (!t)
		return;
	i = 0;
	while (i < 256)
	{
		t->argb[i] = ((ut_pal_r[i] & 255) << 16) |
			((ut_pal_g[i] & 255) << 8) | (ut_pal_b[i] & 255);
		i++;
	}
	t->has_argb = TRUE;
}

U0 UTTexBuildChecker(CUTTex *t, I64 bits, I64 a, I64 b)
{
	I64 x;
	I64 y;
	I64 s;
	U8 *p;
	I64 cell;

	UTTexInit(t);
	if (!UTTexAllocMip0(t, bits, bits))
		return;
	s = t->u_size;
	p = t->mips[0].pixels;
	cell = s / 4;
	if (cell < 1)
		cell = 1;
	y = 0;
	while (y < s)
	{
		x = 0;
		while (x < s)
		{
			if (((x / cell) + (y / cell)) & 1)
				p[y * s + x] = b;
			else
				p[y * s + x] = a;
			x++;
		}
		y++;
	}
	StrPrint(t->name, "Checker");
}

U0 UTTexBuildGrid(CUTTex *t, I64 bits, I64 bg, I64 line)
{
	I64 x;
	I64 y;
	I64 s;
	U8 *p;

	UTTexInit(t);
	if (!UTTexAllocMip0(t, bits, bits))
		return;
	s = t->u_size;
	p = t->mips[0].pixels;
	MemSet(p, bg, s * s);
	y = 0;
	while (y < s)
	{
		x = 0;
		while (x < s)
		{
			if ((x & 15) == 0 || (y & 15) == 0)
				p[y * s + x] = line;
			x++;
		}
		y++;
	}
	StrPrint(t->name, "Grid");
}

U0 UTTexDemoInit()
{
	UTTexBuildChecker(&ut_tex_checker, 6, 40, 200);	//64x64
	UTTexBuildGrid(&ut_tex_grid, 6, 24, 180);
	UTTexArgbFromGlobalPal(&ut_tex_checker);
	UTTexArgbFromGlobalPal(&ut_tex_grid);
	ut_tex_ready = TRUE;
}

U0 UTTexDemoFree()
{
	if (!ut_tex_ready)
		return;
	UTTexFreeMips(&ut_tex_checker);
	UTTexFreeMips(&ut_tex_grid);
	ut_tex_ready = FALSE;
}

Bool UTTexReadLazyBytes(CUTArc *ar, U8 **out, I64 *out_n)
{//TLazyArray<BYTE>. Ver<=61: AR_INDEX count then bytes.
 //Ver>61: INT endpos, AR_INDEX count, bytes; seek endpos.
	I64 n;
	I64 endpos;
	U8 *p;
	U8 *dst;

	*out = NULL;
	*out_n = 0;
	if (ar->ver > 61)
	{
		endpos = UTArcI32(ar);
		n = UTArcIndex(ar);
		if (ar->err || n < 0 || n > (1 << 24))
			return FALSE;
		p = UTArcPtr(ar, n);
		if (!p)
			return FALSE;
		dst = CAlloc(n);
		MemCopy(dst, p, n);
		*out = dst;
		*out_n = n;
		if (endpos > 0 && endpos <= ar->size)
			ar->pos = endpos;
		return TRUE;
	}
	n = UTArcIndex(ar);
	if (ar->err || n < 0 || n > (1 << 24))
		return FALSE;
	p = UTArcPtr(ar, n);
	if (!p)
		return FALSE;
	dst = CAlloc(n);
	MemCopy(dst, p, n);
	*out = dst;
	*out_n = n;
	return TRUE;
}

Bool UTTexReadMips(CUTArc *ar, CUTTex *t)
{//TArray<FMipmap> after UTexture properties. SoftDrv uses mip0.
	I64 count;
	I64 i;
	I64 n;
	I64 us;
	I64 vs;
	I64 ub;
	I64 vb;
	U8 *pix;

	count = UTArcIndex(ar);
	if (ar->err || count < 1 || count > 32)
		return FALSE;
	UTTexFreeMips(t);
	t->format = UT_TEXF_P8;
	t->num_mips = 0;
	i = 0;
	while (i < count)
	{
		if (!UTTexReadLazyBytes(ar, &pix, &n))
			return FALSE;
		us = UTArcI32(ar);
		vs = UTArcI32(ar);
		ub = UTArcU8(ar);
		vb = UTArcU8(ar);
		if (ar->err || us < 1 || vs < 1 || us * vs != n)
		{
			if (pix) Free(pix);
			return FALSE;
		}
		if (i == 0)
		{
			t->u_size = us;
			t->v_size = vs;
			t->u_bits = ub;
			t->v_bits = vb;
		}
		if (t->num_mips < UT_TEX_MAX_MIPS)
		{
			t->mips[t->num_mips].pixels = pix;
			t->mips[t->num_mips].u_size = us;
			t->mips[t->num_mips].v_size = vs;
			t->mips[t->num_mips].u_bits = ub;
			t->mips[t->num_mips].v_bits = vb;
			t->num_mips++;
		}
		else
			Free(pix);
		i++;
	}
	return t->num_mips > 0;
}

Bool UTTexLoadExport(CUTPackage *pkg, I64 exp_i, CUTTex *t)
{//decode one Texture export → P8 mip0(+).
	CUTArc ar;
	CUTExport *e;
	I64 pal_ref;
	Bool pal_ok;

	if (!pkg || !t || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (!UTPkgArcExport(pkg, exp_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
	{
		//FireTexture / incomplete props: still try mips from remaining
		ar.err = FALSE;
	}
	UTTexInit(t);
	StrPrint(t->name, "%s", UTPkgNameStr(pkg, e->name_index));
	if (!UTTexReadMips(&ar, t))
		return FALSE;
	//Each Texture owns a UPalette. A .utx holds one per texture, so the
	//first-export search painted every surface with one arbitrary palette.
	pal_ok = FALSE;
	if (UTPropFindObjectRef(pkg, e->serial_offset, e->serial_size,
		e->object_flags, "Palette", &pal_ref))
	{
		if (pal_ref > 0)
			pal_ok = UTTexRemapFromPaletteExport(pkg, t, pal_ref - 1);
	}
	if (!pal_ok)
		UTTexRemapFromPackage(pkg, t);
	return TRUE;
}

Bool UTTexLoadNamed(U8 *utx_path, U8 *tex_name, CUTTex *t)
{//Named load requires exact Texture export. No first-export fallback —
 //that handed MouseCursor a solid white icon from UWindow.u.
	CUTPackage *pkg;
	I64 i;
	Bool ok;
	CUTTex tmp;

	pkg = UTPkgLoad(utx_path);
	if (!pkg)
		return FALSE;
	ok = FALSE;
	if (tex_name && tex_name[0])
		i = UTPkgFindExport(pkg, "Texture", tex_name);
	else
		i = UTPkgFindExport(pkg, "Texture", NULL);
	if (i >= 0)
	{
		//Decode into tmp: UTTexLoadExport inits the target up front, so a
		//failed read left the destination empty. That erased the fallback.
		ok = UTTexLoadExport(pkg, i, &tmp);
		if (ok)
		{
			UTTexFreeMips(t);
			MemCopy(t, &tmp, sizeof(CUTTex));
		}
		else
		{
			UTTexFreeMips(&tmp);
			UTLog("UTTex: load %s.%s FAILED (target kept)\n",
				utx_path, tex_name);
		}
	}
	UTPkgFree(pkg);
	return ok;
}

Bool UTPalLoadFromUtx(U8 *utx_path)
{//first Palette export → global SoftDrv palette.
	CUTPackage *pkg;
	I64 i;
	CUTArc ar;
	CUTExport *e;
	I64 count;
	I64 k;
	U8 *p;

	if (ut_pal_locked)
		return FALSE;
	pkg = UTPkgLoad(utx_path);
	if (!pkg)
		return FALSE;
	i = UTPkgFindExport(pkg, "Palette", NULL);
	if (i < 0)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	e = &pkg->exports[i];
	if (!UTPkgArcExport(pkg, i, &ar))
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	UTPropSkipStack(&ar, e->object_flags);
	UTPropSkipAll(&ar, pkg);
	ar.err = FALSE;
	count = UTArcIndex(&ar);
	if (count < 256)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	p = UTArcPtr(&ar, 256 * 4);
	if (!p)
	{
		UTPkgFree(pkg);
		return FALSE;
	}
	k = 0;
	while (k < 256)
	{
		UTPalSet(k, p[0], p[1], p[2]);
		p += 4;
		k++;
	}
	UTPkgFree(pkg);
	UTPalInstall;
	return TRUE;
}

