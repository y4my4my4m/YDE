//---- Tagged value (UnrealScript property types the Step stack carries) ----

#define UT_VT_NONE		0
#define UT_VT_INT		1
#define UT_VT_FLOAT		2
#define UT_VT_BOOL		3
#define UT_VT_BYTE		4
#define UT_VT_OBJ		5
#define UT_VT_NAME		6
#define UT_VT_STR		7
#define UT_VT_VEC		8
#define UT_VT_ROT		9
#define UT_VT_CLASS		10

//Unresolved EX_ObjectConst package refs live above every real UTObj slot.
#define UT_OBJ_PKGREF_BASE	1000000

class CUTVMVal
{//v[] = VEC xyz / ROT pitch,yaw,roll. v[0] doubles as the scalar slot for
 //INT/FLOAT/BOOL/BYTE, so scalar coercion never inspects the tag.
	I64	 tag;
	F64	 v[3];
	I64	 i;		//OBJ slot (-1 None) / NAME index / CLASS export index
	U8	*s;		//STR heap pointer; NULL for every other tag
};

U0 UTVMValNone(CUTVMVal *o)
{
	if (!o) return;
	MemSet(o, 0, sizeof(CUTVMVal));
	o->tag = UT_VT_NONE;
	o->i = -1;
}

U0 UTVMValFloat(CUTVMVal *o, F64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_FLOAT;
	o->v[0] = x;
}

U0 UTVMValInt(CUTVMVal *o, I64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_INT;
	o->v[0] = ToF64(x);
}

U0 UTVMValBool(CUTVMVal *o, Bool b)
{
	UTVMValNone(o);
	o->tag = UT_VT_BOOL;
	if (b)
		o->v[0] = 1.0;
}

U0 UTVMValByte(CUTVMVal *o, I64 x)
{
	UTVMValNone(o);
	o->tag = UT_VT_BYTE;
	o->v[0] = ToF64(x & 255);
}

U0 UTVMValObj(CUTVMVal *o, I64 slot)
{
	UTVMValNone(o);
	o->tag = UT_VT_OBJ;
	o->i = slot;
}

U0 UTVMValName(CUTVMVal *o, I64 idx)
{
	UTVMValNone(o);
	o->tag = UT_VT_NAME;
	o->i = idx;
}

U0 UTVMValClass(CUTVMVal *o, I64 idx)
{
	UTVMValNone(o);
	o->tag = UT_VT_CLASS;
	o->i = idx;
}

U0 UTVMValVec(CUTVMVal *o, F64 x, F64 y, F64 z)
{
	UTVMValNone(o);
	o->tag = UT_VT_VEC;
	o->v[0] = x;
	o->v[1] = y;
	o->v[2] = z;
}

U0 UTVMValRot(CUTVMVal *o, F64 pitch, F64 yaw, F64 roll)
{
	UTVMValNone(o);
	o->tag = UT_VT_ROT;
	o->v[0] = pitch;
	o->v[1] = yaw;
	o->v[2] = roll;
}

U0 UTVMValCopy(CUTVMVal *o, CUTVMVal *a)
{
	if (!o) return;
	if (!a)
	{
		UTVMValNone(o);
		return;
	}
	MemCopy(o, a, sizeof(CUTVMVal));
}

F64 UTVMValF(CUTVMVal *a)
{
	if (!a)
		return 0.0;
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS)
		return ToF64(a->i);
	return a->v[0];
}

I64 UTVMValI(CUTVMVal *a)
{
	if (!a)
		return 0;
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS)
		return a->i;
	return ToI64(a->v[0]);
}

Bool UTVMValB(CUTVMVal *a)
{//UnrealScript truthiness: None object is false, empty string is false.
	if (!a)
		return FALSE;
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_CLASS)
		return a->i >= 0;
	if (a->tag == UT_VT_NAME)
		return a->i != 0;
	if (a->tag == UT_VT_STR)
		return a->s != NULL && a->s[0] != 0;
	if (a->tag == UT_VT_VEC || a->tag == UT_VT_ROT)
		return a->v[0] != 0.0 || a->v[1] != 0.0 || a->v[2] != 0.0;
	return a->v[0] != 0.0;
}

Bool UTVMValEq(CUTVMVal *a, CUTVMVal *b)
{
	if (!a || !b)
		return FALSE;
	if (a->tag == UT_VT_VEC || a->tag == UT_VT_ROT ||
		b->tag == UT_VT_VEC || b->tag == UT_VT_ROT)
		return a->v[0] == b->v[0] && a->v[1] == b->v[1] && a->v[2] == b->v[2];
	if (a->tag == UT_VT_OBJ || a->tag == UT_VT_NAME || a->tag == UT_VT_CLASS ||
		b->tag == UT_VT_OBJ || b->tag == UT_VT_NAME || b->tag == UT_VT_CLASS)
		return UTVMValI(a) == UTVMValI(b);
	return a->v[0] == b->v[0];
}

class CUTVMFrame
{//FFrame (UnStack.h) + FMainFrame latent fields used by SoftDrv host Exec
	U8	*code;			//= FFrame::Code base
	I64	 code_size;
	I64	 ip;			//= Code - Script(0)
	CUTVMVal stack[UT_VM_STACK];
	I64	 sp;
	CUTVMVal locals[UT_VM_LOCALS];	//= FFrame::Locals
	CUTPropBag *bag;
	I64	 node_fn;		//= FFrame::Node (ut_vm_fn index, -1 none)
	I64	 object_id;		//= FFrame::Object (UTObj slot, -1 none)
	I64	 context_id;		//nested EX_Context Self override
	I64	 nest;			//CHECK_RUNAWAY depth
	I64	 latent;		//= FMainFrame::LatentAction
	CUTVMVal switch_val;		//EX_Switch compare buffer
	Bool	 has_switch;
	Bool stopped;
	Bool err;
	I64	 native_op;
};

class CUTVMFn
{
	U8	 name[64];
	U8	 pkg[64];
	U8	*code;
	I64	 size;
	I64	 i_native;
	U32	 func_flags;
	Bool loaded;
};

CUTVMFn	ut_vm_fn[UT_VM_FN_MAX];
I64		ut_vm_fn_n		= 0;
I64		ut_vm_cmd		= UT_VM_CMD_NONE;
F64		ut_vm_arg		= 0.0;
F64		ut_vm_arg2		= 0.0;
I64		ut_vm_steps_run	= 0;
I64		ut_vm_skip_unk	= 0;
I64		ut_vm_self_id	= -1;		//live UObject slot (UTObj index)
CUTPropBag	*ut_vm_self_bag	= NULL;	//Self instance props

//FMainFrame stand-in — ProcessState keeps Code across ticks while latent
CUTVMFrame	ut_vm_main;
Bool		ut_vm_main_ok		= FALSE;
Bool		ut_vm_state_tried	= FALSE;
F64		ut_vm_latent_float	= 0.0;	//= AActor::LatentFloat
Bool		ut_vm_anim_finished	= TRUE;
Bool		ut_vm_interpolating	= FALSE;
I64		ut_vm_iter_hits		= 0;
U8		ut_vm_state_name[64]	= "";
U8		ut_vm_state_label[32]	= "";
I64		ut_vm_label_ip[UT_VM_LABEL_MAX];
I64		ut_vm_label_name[UT_VM_LABEL_MAX];
I64		ut_vm_label_n		= 0;
I64		ut_vm_state_obj		= -1;	//UObject slot owning FMainFrame state

extern U0 UTVMNativeAllActors(CUTVMFrame *f);
extern CUTPropBag *UTObjBagForSlot(I64 slot);
extern U0 UTObjSetState(I64 slot, U8 *state_name);
extern Bool UTObjIsInState(I64 slot, U8 *state_name);
extern U0 UTObjSetOwner(I64 child, I64 owner);
extern U0 UTObjSetBase(I64 child, I64 base);
extern Bool UTObjIsA(I64 slot, U8 *cls_name);
extern Bool UTVMGotoState(U8 *state_name, CUTPropBag *bag);
extern I64 UTVMCallSelf(U8 *fn_name, I64 obj_id, CUTPropBag *bag, I64 max_steps);

U0 UTVMSetSelf(I64 obj_id, CUTPropBag *bag)
{//Bind FFrame Self for UWindow/HUD/Actor Exec
	ut_vm_self_id = obj_id;
	ut_vm_self_bag = bag;
}

U0 UTVMClearSelf()
{
	ut_vm_self_id = -1;
	ut_vm_self_bag = NULL;
}

U0 UTVMFrameInit(CUTVMFrame *f, U8 *code, I64 size)
{
	MemSet(f, 0, sizeof(CUTVMFrame));
	f->code = code;
	f->code_size = size;
	f->ip = 0;
	f->sp = 0;
	f->bag = NULL;
	f->node_fn = -1;
	f->object_id = ut_vm_self_id;
	f->context_id = ut_vm_self_id;
	f->nest = 0;
	f->latent = 0;
	f->has_switch = FALSE;
	ut_vm_cmd = UT_VM_CMD_NONE;
	ut_vm_arg = 0.0;
	ut_vm_arg2 = 0.0;
}

U0 UTVMFrameInitBag(CUTVMFrame *f, U8 *code, I64 size, CUTPropBag *bag)
{
	UTVMFrameInit(f, code, size);
	f->bag = bag;
	if (!f->bag)
		f->bag = ut_vm_self_bag;
	if (f->bag)
		UTPropBagSeedLocals(f->bag, f->locals, UT_VM_LOCALS);
}

U0 UTVMFrameInitNode(CUTVMFrame *f, I64 fn_i, CUTPropBag *bag)
{//FFrame(Object, Node, 0, Locals) — ProcessEvent entry
	CUTVMFn *fn;

	if (fn_i < 0 || fn_i >= ut_vm_fn_n)
		return;
	fn = &ut_vm_fn[fn_i];
	if (!fn->loaded || !fn->code)
		return;
	UTVMFrameInitBag(f, fn->code, fn->size, bag);
	f->node_fn = fn_i;
}

U0 UTVMPushV(CUTVMFrame *f, CUTVMVal *v)
{
	if (f->sp >= UT_VM_STACK)
	{
		f->err = TRUE;
		return;
	}
	UTVMValCopy(&f->stack[f->sp], v);
	f->sp++;
}

U0 UTVMPopV(CUTVMFrame *f, CUTVMVal *out)
{
	if (f->sp <= 0)
	{
		f->err = TRUE;
		UTVMValNone(out);
		return;
	}
	f->sp--;
	UTVMValCopy(out, &f->stack[f->sp]);
}

U0 UTVMPeekV(CUTVMFrame *f, CUTVMVal *out)
{
	if (f->sp <= 0)
	{
		UTVMValNone(out);
		return;
	}
	UTVMValCopy(out, &f->stack[f->sp - 1]);
}

U0 UTVMPush(CUTVMFrame *f, F64 v)
{//Scalar shim — tags FLOAT. Typed pushes use UTVMPushV.
	CUTVMVal t;

	UTVMValFloat(&t, v);
	UTVMPushV(f, &t);
}

U0 UTVMPushI(CUTVMFrame *f, I64 v)
{
	CUTVMVal t;

	UTVMValInt(&t, v);
	UTVMPushV(f, &t);
}

U0 UTVMPushB(CUTVMFrame *f, Bool v)
{
	CUTVMVal t;

	UTVMValBool(&t, v);
	UTVMPushV(f, &t);
}

U0 UTVMPushObj(CUTVMFrame *f, I64 slot)
{
	CUTVMVal t;

	UTVMValObj(&t, slot);
	UTVMPushV(f, &t);
}

U0 UTVMPushVec(CUTVMFrame *f, F64 x, F64 y, F64 z)
{
	CUTVMVal t;

	UTVMValVec(&t, x, y, z);
	UTVMPushV(f, &t);
}

F64 UTVMPop(CUTVMFrame *f)
{//Scalar shim — coerces whatever tag is on top.
	CUTVMVal t;

	UTVMPopV(f, &t);
	return UTVMValF(&t);
}

Bool UTVMPopBool(CUTVMFrame *f)
{
	CUTVMVal t;

	UTVMPopV(f, &t);
	return UTVMValB(&t);
}

I64 UTVMPopObj(CUTVMFrame *f)
{//Object slot, -1 = None.
	CUTVMVal t;

	UTVMPopV(f, &t);
	if (t.tag == UT_VT_OBJ || t.tag == UT_VT_CLASS || t.tag == UT_VT_NAME)
		return t.i;
	return ToI64(t.v[0]);
}

U0 UTVMPopVec(CUTVMFrame *f, F64 *out)
{//Reads a VEC/ROT off the stack; scalars broadcast to x.
	CUTVMVal t;

	UTVMPopV(f, &t);
	if (!out)
		return;
	out[0] = t.v[0];
	out[1] = t.v[1];
	out[2] = t.v[2];
}

U8 UTVMReadU8(CUTVMFrame *f)
{
	I64 b;

	if (f->ip >= f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	b = f->code[f->ip];
	f->ip++;
	return b;
}

I64 UTVMReadI32(CUTVMFrame *f)
{
	I64 v;

	if (f->ip + 4 > f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	v = UTRdI32(f->code + f->ip);
	f->ip += 4;
	return v;
}

U16 UTVMReadU16(CUTVMFrame *f)
{
	U16 v;

	if (f->ip + 2 > f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	v = UTRdU16(f->code + f->ip);
	f->ip += 2;
	return v;
}

F64 UTVMReadF32(CUTVMFrame *f)
{
	F64 v;

	if (f->ip + 4 > f->code_size)
	{
		f->err = TRUE;
		return 0.0;
	}
	v = UTRdF32(f->code + f->ip);
	f->ip += 4;
	return v;
}

I64 UTVMObjFromPkgIndex(I64 pkg_index)
{//EX_ObjectConst carries a package index (>0 export, <0 import), not a live
 //slot. No export→UTObj resolver yet; bias into a reserved range so the ref
 //stays non-None and cannot alias a real slot.
	if (pkg_index == 0)
		return -1;
	return UT_OBJ_PKGREF_BASE + AbsI64(pkg_index);
}

U0 UTVMReadStringConst(CUTVMFrame *f, CUTVMVal *out)
{//EX_StringConst: inline ASCIIZ. Points into Script; not owned.
	I64 start;
	I64 b;

	UTVMValNone(out);
	start = f->ip;
	b = 1;
	while (b && !f->err)
		b = UTVMReadU8(f);
	out->tag = UT_VT_STR;
	if (start < f->code_size)
		out->s = f->code + start;
}

U0 UTVMSkipString(CUTVMFrame *f)
{//EX_StringConst: ASCIIZ. I64 temp — ZealC warns on U8 reg locals.
	I64 b;

	b = 1;
	while (b && !f->err)
		b = UTVMReadU8(f);
}

U0 UTVMSkipParms(CUTVMFrame *f)
{//Advance past native parameter expressions to EndFunctionParms.
 //Non-recursive token skip — avoids re-entering StepExpr.
	I64 op;
	I64 guard;

	guard = 0;
	while (guard < 1024 && !f->err && f->ip < f->code_size)
	{
		op = UTVMReadU8(f);
		guard++;
		if (op == UT_EX_EndFunctionParms)
			return;
		if (op == UT_EX_Stop || op == UT_EX_Return)
		{
			f->ip--;
			return;
		}
		if (op == UT_EX_Jump || op == UT_EX_JumpIfNot ||
			op == UT_EX_Assert || op == UT_EX_Case || op == UT_EX_Skip)
			UTVMReadU16(f);
		else if (op == UT_EX_IntConst || op == UT_EX_NameConst ||
			op == UT_EX_ObjectConst || op == UT_EX_GotoLabel ||
			op == UT_EX_LocalVariable || op == UT_EX_InstanceVariable ||
			op == UT_EX_DefaultVariable || op == UT_EX_NativeParm ||
			op == UT_EX_BoolVariable || op == UT_EX_VirtualFunction ||
			op == UT_EX_FinalFunction || op == UT_EX_GlobalFunction)
			UTVMReadI32(f);
		else if (op == UT_EX_FloatConst)
			UTVMReadF32(f);
		else if (op == UT_EX_ByteConst || op == UT_EX_IntConstByte ||
			op == UT_EX_Switch)
			UTVMReadU8(f);
		else if (op == UT_EX_StringConst)
			UTVMSkipString(f);
		else if (op == UT_EX_VectorConst)
		{
			UTVMReadF32(f);
			UTVMReadF32(f);
			UTVMReadF32(f);
		}
		else if (op == UT_EX_RotationConst)
		{
			UTVMReadI32(f);
			UTVMReadI32(f);
			UTVMReadI32(f);
		}
		else if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
			UTVMReadU8(f);
		else if (op >= UT_EX_FirstNative)
		{
			//nested native opcode in parm stream — ignore body
		}
	}
}

U0 UTVMNative(CUTVMFrame *f, I64 op)
{
	F64 secs;
	F64 a;
	F64 b;
	F64 vp[3];
	F64 vq[3];
	I64 j;

	f->native_op = op;
	if (op == UT_VM_NATIVE_FIRE)
		ut_vm_cmd = UT_VM_CMD_FIRE;
	else if (op == UT_VM_NATIVE_DAMAGE)
	{
		ut_vm_arg = UTVMPop(f);
		ut_vm_cmd = UT_VM_CMD_DAMAGE;
	}
	else if (op == UT_VM_NATIVE_HUD)
		ut_vm_cmd = UT_VM_CMD_HUD;
	else if (op == UT_VM_NATIVE_PLAYSND || op == UT_NATIVE_PLAYSOUND)
	{//= AActor::execPlaySound (264) — SoftDrv host → UTSnd
		UTVMSkipParms(f);
		ut_vm_arg = 0.7;
		ut_vm_cmd = UT_VM_CMD_PLAYSND;
	}
	else if (op == UT_VM_NATIVE_TRACE || op == UT_NATIVE_TRACE ||
		op == UT_NATIVE_FASTTRACE)
	{
		UTVMSkipParms(f);
		ut_vm_arg = 10000.0;
		ut_vm_cmd = UT_VM_CMD_TRACE;
	}
	else if (op == UT_VM_NATIVE_SPAWN || op == UT_NATIVE_SPAWN)
	{
		UTVMSkipParms(f);
		ut_vm_arg = 0.0;
		ut_vm_cmd = UT_VM_CMD_SPAWN;
		UTVMPush(f, 0.0);	//null actor return
	}
	else if (op == UT_NATIVE_DESTROY || op == UT_NATIVE_SETTIMER ||
		op == UT_NATIVE_SETCOLLISION || op == UT_NATIVE_SETPHYSICS ||
		op == UT_NATIVE_SETCOLLISIONSIZE || op == UT_NATIVE_ENABLE ||
		op == UT_NATIVE_DISABLE || op == UT_NATIVE_MAKENOISE ||
		op == UT_NATIVE_LOG || op == UT_NATIVE_WARN ||
		op == UT_NATIVE_ERROR || op == UT_NATIVE_GETMAPNAME ||
		op == UT_NATIVE_GETURLMAP)
	{
		UTVMSkipParms(f);
		if (op == UT_NATIVE_DESTROY)
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_SETOWNER || op == UT_NATIVE_SETBASE)
	{//= Actor.SetOwner / SetBase
		j = -1;
		if (UTVMStepNested(f))
			j = UTVMPopObj(f);
		UTVMSkipParms(f);
		if (ut_vm_self_id >= 0)
		{
			if (op == UT_NATIVE_SETOWNER)
				UTObjSetOwner(ut_vm_self_id, j);
			else
				UTObjSetBase(ut_vm_self_id, j);
		}
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_ISANIMATING)
	{
		UTVMSkipParms(f);
		if (ut_vm_anim_finished)
			UTVMPush(f, 0.0);
		else
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_HASANIM || op == UT_NATIVE_PLAYERCANSEEME ||
		op == UT_NATIVE_LINEOFSIGHT || op == UT_NATIVE_CANSEE ||
		op == UT_NATIVE_ACTORREACHABLE || op == UT_NATIVE_POINTREACHABLE ||
		op == UT_NATIVE_CLASSISTCHILDOF)
	{
		UTVMSkipParms(f);
		UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_ISA)
	{
		UTVMSkipParms(f);
		if (ut_vm_self_id >= 0 && UTObjIsA(ut_vm_self_id, ""))
			UTVMPush(f, 1.0);
		else
			UTVMPush(f, 0.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_ISINSTATE)
	{
		UTVMSkipParms(f);
		if (ut_vm_self_id >= 0 &&
			UTObjIsInState(ut_vm_self_id, ut_vm_state_name))
			UTVMPush(f, 1.0);
		else if (ut_vm_state_name[0])
			UTVMPush(f, 1.0);
		else
			UTVMPush(f, 0.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_GETSTATENAME)
	{
		UTVMSkipParms(f);
		if (ut_vm_state_name[0])
			UTVMPush(f, 1.0);
		else
			UTVMPush(f, 0.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_GETANIMGROUP)
	{
		UTVMSkipParms(f);
		UTVMPush(f, 0.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_FRAND || op == UT_NATIVE_VRAND)
	{
		UTVMSkipParms(f);
		if (op == UT_NATIVE_VRAND)
		{
			vp[0] = Rand * 2.0 - 1.0;
			vp[1] = Rand * 2.0 - 1.0;
			vp[2] = Rand * 2.0 - 1.0;
			a = Sqrt(vp[0] * vp[0] + vp[1] * vp[1] + vp[2] * vp[2]);
			if (a > 0.00001)
				UTVMPushVec(f, vp[0] / a, vp[1] / a, vp[2] / a);
			else
				UTVMPushVec(f, 1.0, 0.0, 0.0);
		}
		else
			UTVMPush(f, Rand);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_ABS || op == UT_NATIVE_SIN ||
		op == UT_NATIVE_COS || op == UT_NATIVE_TAN ||
		op == UT_NATIVE_ATAN || op == UT_NATIVE_EXP ||
		op == UT_NATIVE_LOGE || op == UT_NATIVE_SQRT ||
		op == UT_NATIVE_SQUARE)
	{
		a = 0.0;
		if (UTVMStepNested(f))
			a = UTVMPop(f);
		UTVMSkipParms(f);
		if (op == UT_NATIVE_ABS)
			UTVMPush(f, Abs(a));
		else if (op == UT_NATIVE_SIN)
			UTVMPush(f, Sin(a));
		else if (op == UT_NATIVE_COS)
			UTVMPush(f, Cos(a));
		else if (op == UT_NATIVE_TAN)
			UTVMPush(f, Tan(a));
		else if (op == UT_NATIVE_ATAN)
			UTVMPush(f, ATan(a));
		else if (op == UT_NATIVE_EXP)
			UTVMPush(f, Exp(a));
		else if (op == UT_NATIVE_LOGE)
		{
			if (a > 0.0)
				UTVMPush(f, Ln(a));
			else
				UTVMPush(f, 0.0);
		}
		else if (op == UT_NATIVE_SQRT)
		{
			if (a > 0.0)
				UTVMPush(f, Sqrt(a));
			else
				UTVMPush(f, 0.0);
		}
		else
			UTVMPush(f, a * a);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_FMIN || op == UT_NATIVE_FMAX ||
		op == UT_NATIVE_MIN || op == UT_NATIVE_MAX ||
		op == UT_NATIVE_RAND)
	{
		a = 0.0;
		b = 0.0;
		if (UTVMStepNested(f))
			a = UTVMPop(f);
		if (op != UT_NATIVE_RAND && UTVMStepNested(f))
			b = UTVMPop(f);
		UTVMSkipParms(f);
		if (op == UT_NATIVE_RAND)
		{
			if (a < 1.0)
				UTVMPush(f, 0.0);
			else
				UTVMPush(f, ToF64(ToI64(Rand * a)));
		}
		else if (op == UT_NATIVE_FMIN || op == UT_NATIVE_MIN)
		{
			if (a < b)
				UTVMPush(f, a);
			else
				UTVMPush(f, b);
		}
		else
		{
			if (a > b)
				UTVMPush(f, a);
			else
				UTVMPush(f, b);
		}
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_FCLAMP || op == UT_NATIVE_CLAMP)
	{
		a = 0.0;
		b = 0.0;
		secs = 0.0;
		if (UTVMStepNested(f))
			a = UTVMPop(f);
		if (UTVMStepNested(f))
			b = UTVMPop(f);
		if (UTVMStepNested(f))
			secs = UTVMPop(f);
		UTVMSkipParms(f);
		if (a < b)
			a = b;
		if (a > secs)
			a = secs;
		UTVMPush(f, a);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_LERP || op == UT_NATIVE_SMERP ||
		op == UT_NATIVE_RANDRANGE)
	{
		a = 0.0;
		b = 0.0;
		secs = 0.0;
		if (UTVMStepNested(f))
			a = UTVMPop(f);
		if (UTVMStepNested(f))
			b = UTVMPop(f);
		if (op != UT_NATIVE_RANDRANGE && UTVMStepNested(f))
			secs = UTVMPop(f);
		UTVMSkipParms(f);
		if (op == UT_NATIVE_RANDRANGE)
			UTVMPush(f, a + (b - a) * Rand);
		else if (op == UT_NATIVE_SMERP)
		{
			//Smerp Alpha A B — cubic smoothstep
			if (a < 0.0)
				a = 0.0;
			if (a > 1.0)
				a = 1.0;
			a = a * a * (3.0 - 2.0 * a);
			UTVMPush(f, b + (secs - b) * a);
		}
		else
			UTVMPush(f, b + (secs - b) * a);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_VSIZE || op == UT_NATIVE_NORMAL)
	{
		UTVecSet(vp, 0.0, 0.0, 0.0);
		if (UTVMStepNested(f))
			UTVMPopVec(f, vp);
		UTVMSkipParms(f);
		a = Sqrt(vp[0] * vp[0] + vp[1] * vp[1] + vp[2] * vp[2]);
		if (op == UT_NATIVE_VSIZE)
			UTVMPush(f, a);
		else if (a > 0.00001)
			UTVMPushVec(f, vp[0] / a, vp[1] / a, vp[2] / a);
		else
			UTVMPushVec(f, 0.0, 0.0, 0.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_MIRRORVEC)
	{//MirrorVectorByNormal(V, N) = V - 2*(V dot N)*N, N normalized first.
		UTVecSet(vp, 0.0, 0.0, 0.0);
		UTVecSet(vq, 0.0, 0.0, 0.0);
		if (UTVMStepNested(f))
			UTVMPopVec(f, vp);
		if (UTVMStepNested(f))
			UTVMPopVec(f, vq);
		UTVMSkipParms(f);
		a = Sqrt(vq[0] * vq[0] + vq[1] * vq[1] + vq[2] * vq[2]);
		if (a > 0.00001)
		{
			vq[0] /= a;
			vq[1] /= a;
			vq[2] /= a;
		}
		b = 2.0 * (vp[0] * vq[0] + vp[1] * vq[1] + vp[2] * vq[2]);
		UTVMPushVec(f, vp[0] - b * vq[0], vp[1] - b * vq[1],
			vp[2] - b * vq[2]);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_DRAWTILE || op == UT_NATIVE_DRAWTILECLIP ||
		op == UT_NATIVE_DRAWTILE_XY)
	{
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTILE;
	}
	else if (op == UT_NATIVE_DRAWTEXT || op == UT_NATIVE_DRAWTEXTCLIP ||
		op == UT_NATIVE_DRAWTEXT_XY || op == UT_NATIVE_DRAWCOLOREDTEXT)
	{
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTEXT;
	}
	else if (op == UT_NATIVE_DRAWACTOR)
	{//= Canvas.DrawActor — SoftDrv host draws current LodMesh/player
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTILE;
	}
	else if (op == UT_NATIVE_DRAWPORTAL)
	{//= Canvas.DrawPortal — SoftDrv PF_Portal nest + FSpan scissor
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_WARP || op == UT_NATIVE_UNWARP)
	{//= AWarpZoneInfo::execWarp / UnWarp — SoftDrv host WarpCoords path
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_MOVE;
	}
	else if (op == UT_NATIVE_MOVE || op == UT_NATIVE_MOVESMOOTH ||
		op == UT_NATIVE_SETLOCATION || op == UT_NATIVE_SETROTATION ||
		op == UT_NATIVE_AUTONOMOUSPHYSICS)
	{
		UTVMSkipParms(f);
		if (op == UT_NATIVE_MOVE || op == UT_NATIVE_MOVESMOOTH ||
			op == UT_NATIVE_SETLOCATION || op == UT_NATIVE_SETROTATION)
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_MOVE;
	}
	else if (op == UT_NATIVE_SLEEP || op == UT_NATIVE_MOVETO ||
		op == UT_NATIVE_MOVETOWARD || op == UT_NATIVE_STRAFETO ||
		op == UT_NATIVE_STRAFEFACING || op == UT_NATIVE_TURNTO ||
		op == UT_NATIVE_TURNTOWARD || op == UT_NATIVE_WAITLANDING)
	{//= latent — Sleep Seconds; Move*/Turn* ≈ short Sleep host stand-in
		secs = 0.05;
		if (op == UT_NATIVE_SLEEP)
		{
			if (UTVMStepNested(f))
				secs = UTVMPop(f);
		}
		UTVMSkipParms(f);
		ut_vm_latent_float = secs;
		f->latent = UT_EPOLL_SLEEP;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_FINISHANIM)
	{//= AActor::execFinishAnim
		UTVMSkipParms(f);
		if (!ut_vm_anim_finished)
			f->latent = UT_EPOLL_FINISHANIM;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_FINISHINTERP)
	{//= AActor::execFinishInterpolation
		UTVMSkipParms(f);
		if (ut_vm_interpolating)
			f->latent = UT_EPOLL_FINISHINTERP;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_PLAYANIM || op == UT_NATIVE_LOOPANIM ||
		op == UT_NATIVE_TWEENANIM)
	{//Anim initiator — mark unfinished; Lod tick clears when seq ends
		UTVMSkipParms(f);
		ut_vm_anim_finished = FALSE;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_GOTOSTATE)
	{//= UObject::execGotoState — EndState → load Script → BeginState
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_STATE;
		if (f->bag && f->bag->state_name[0])
			UTVMGotoState(f->bag->state_name, f->bag);
		else if (ut_vm_state_name[0])
			UTVMGotoState(ut_vm_state_name, f->bag);
	}
	else if (op == UT_NATIVE_ALLACTORS || op == UT_NATIVE_CHILDACTORS ||
		op == UT_NATIVE_BASEDACTORS || op == UT_NATIVE_TOUCHINGACTORS ||
		op == UT_NATIVE_TRACEACTORS || op == UT_NATIVE_RADIUSACTORS ||
		op == UT_NATIVE_VISIBLEACTORS || op == UT_NATIVE_VISIBLECOLLIDING ||
		op == UT_NATIVE_ZONEACTORS)
	{//PRE_ITERATOR natives — body in UTActor (ut_actors visible there)
		UTVMNativeAllActors(f);
		ut_vm_cmd = UT_VM_CMD_ITER;
	}
	else if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
		ut_vm_cmd = UT_VM_CMD_NONE;
	else
	{//Unknown Engine iNative — skip parms so Script continues
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
}

extern Bool UTVMStepExpr(CUTVMFrame *f);

Bool UTVMStepNested(CUTVMFrame *f)
{//FFrame::Step recursive — Context / JumpIfNot / Let / CallFunction parms.
	Bool ok;

	if (!f || f->err || f->stopped)
		return FALSE;
	if (f->nest >= UT_VM_NEST_MAX)
	{
		f->err = TRUE;
		ut_vm_skip_unk++;
		return FALSE;
	}
	f->nest++;
	ok = UTVMStepExpr(f);
	f->nest--;
	return ok;
}

Bool UTVMStep(CUTVMFrame *f)
{//= FFrame::Step(Context, Result) — one token
	return UTVMStepExpr(f);
}

Bool UTVMStepExpr(CUTVMFrame *f)
{//one token. SoftDrv host: skip unknown with soft stop only on hard errors.
	I64 op;
	I64 dest;
	I64 i;
	I64 j;
	I64 n;
	I64 w_skip;
	I64 b_size;
	I64 save_self;
	I64 save_ctx;
	CUTPropBag *save_bag;
	CUTPropBag *ctx_bag;
	CUTVMVal tv;
	CUTVMVal tv2;
	F64 v;
	F64 a;
	F64 b;

	if (!f || f->stopped || f->err || f->ip >= f->code_size)
		return FALSE;
	op = UTVMReadU8(f);
	ut_vm_steps_run++;

	if (op == UT_EX_Nothing)
		return TRUE;
	if (op == UT_EX_Stop || op == UT_EX_Return)
	{
		f->stopped = TRUE;
		return FALSE;
	}
	if (op == UT_EX_Jump)
	{
		dest = UTVMReadU16(f);
		if (dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_JumpIfNot)
	{//ReadWord then Step boolean (UnCorSc execJumpIfNot)
		dest = UTVMReadU16(f);
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);
		if (!UTVMValB(&tv) && dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_Case)
	{
		dest = UTVMReadU16(f);
		if (dest == 0xFFFF)
			return TRUE;
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);
		if (f->has_switch && !UTVMValEq(&tv, &f->switch_val) &&
			dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_Switch)
	{//bSize + Step(switch expr) — Case tokens follow
		UTVMReadU8(f);
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &f->switch_val);
		f->has_switch = TRUE;
		return TRUE;
	}
	if (op == UT_EX_Assert)
	{
		UTVMReadU16(f); //line
		if (!UTVMStepNested(f))
			return FALSE;
		v = UTVMPop(f);
		no_warn v;
		return TRUE;
	}
	if (op == UT_EX_Skip)
	{
		dest = UTVMReadU16(f);
		no_warn dest;
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_GotoLabel)
	{//= jump to LabelTable iCode matching NameConst index
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);
		i = UTVMValI(&tv);	//NameConst index
		j = 0;
		while (j < ut_vm_label_n)
		{
			if (ut_vm_label_name[j] == i)
			{
				f->ip = ut_vm_label_ip[j];
				return TRUE;
			}
			j++;
		}
		if (ut_vm_label_n > 0)
			f->ip = ut_vm_label_ip[0];
		else
			f->ip = 0;
		return TRUE;
	}
	if (op == UT_EX_LabelTable)
	{//FLabelEntry Name+iCode until NAME_None — cache for GotoLabel
		ut_vm_label_n = 0;
		while (!f->err && f->ip + 8 <= f->code_size)
		{
			i = UTVMReadI32(f);
			j = UTVMReadI32(f);
			if (i == 0)
				break;
			if (ut_vm_label_n < UT_VM_LABEL_MAX)
			{
				ut_vm_label_name[ut_vm_label_n] = i;
				ut_vm_label_ip[ut_vm_label_n] = j;
				ut_vm_label_n++;
			}
		}
		return TRUE;
	}
	if (op == UT_EX_ValidateObject)
		return TRUE;
	if (op == UT_EX_IntZero)
	{
		UTVMPushI(f, 0);
		return TRUE;
	}
	if (op == UT_EX_IntOne)
	{
		UTVMPushI(f, 1);
		return TRUE;
	}
	if (op == UT_EX_True)
	{
		UTVMPushB(f, TRUE);
		return TRUE;
	}
	if (op == UT_EX_False)
	{
		UTVMPushB(f, FALSE);
		return TRUE;
	}
	if (op == UT_EX_NoObject)
	{
		UTVMPushObj(f, -1);
		return TRUE;
	}
	if (op == UT_EX_IntConst)
	{
		UTVMPushI(f, UTVMReadI32(f));
		return TRUE;
	}
	if (op == UT_EX_FloatConst)
	{
		UTVMPush(f, UTVMReadF32(f));
		return TRUE;
	}
	if (op == UT_EX_ByteConst || op == UT_EX_IntConstByte)
	{
		UTVMValByte(&tv, UTVMReadU8(f));
		UTVMPushV(f, &tv);
		return TRUE;
	}
	if (op == UT_EX_NameConst)
	{
		UTVMValName(&tv, UTVMReadI32(f));
		UTVMPushV(f, &tv);
		return TRUE;
	}
	if (op == UT_EX_ObjectConst)
	{
		i = UTVMReadI32(f);
		UTVMPushObj(f, UTVMObjFromPkgIndex(i));
		return TRUE;
	}
	if (op == UT_EX_StringConst)
	{
		UTVMReadStringConst(f, &tv);
		UTVMPushV(f, &tv);
		return TRUE;
	}
	if (op == UT_EX_VectorConst)
	{
		a = UTVMReadF32(f);
		b = UTVMReadF32(f);
		v = UTVMReadF32(f);
		UTVMPushVec(f, a, b, v);
		return TRUE;
	}
	if (op == UT_EX_RotationConst)
	{//Pitch/Yaw/Roll as raw UE1 rotation units (65536 = full turn).
		a = ToF64(UTVMReadI32(f));
		b = ToF64(UTVMReadI32(f));
		v = ToF64(UTVMReadI32(f));
		UTVMValRot(&tv, a, b, v);
		UTVMPushV(f, &tv);
		return TRUE;
	}
	if (op == UT_EX_Self)
	{
		if (f->context_id >= 0)
			UTVMPushObj(f, f->context_id);
		else
			UTVMPushObj(f, ut_vm_self_id);
		return TRUE;
	}
	if (op == UT_EX_EndFunctionParms)
		return TRUE;
	if (op == UT_EX_LocalVariable || op == UT_EX_InstanceVariable ||
		op == UT_EX_DefaultVariable || op == UT_EX_NativeParm ||
		op == UT_EX_BoolVariable)
	{
		i = UTVMReadI32(f); //property offset / object
		if (!f->bag && ut_vm_self_bag)
			f->bag = ut_vm_self_bag;
		if (f->bag && (op == UT_EX_InstanceVariable ||
			op == UT_EX_DefaultVariable || op == UT_EX_BoolVariable))
		{
			//UStruct::LinkOffsets — bytecode Offset → bag via prop linker
			j = UTPropLinkFindByOffset(i);
			if (j >= 0)
				UTVMPush(f, UTPropLinkReadBag(f->bag, j, i));
			else if (i == 0 && f->bag->has_location)
				UTVMPush(f, f->bag->location[0]);
			else if (i == 1 && f->bag->has_location)
				UTVMPush(f, f->bag->location[1]);
			else if (i == 2 && f->bag->has_location)
				UTVMPush(f, f->bag->location[2]);
			else if (i == 3)
				UTVMPush(f, f->bag->health);
			else if (i == 4)
				UTVMPush(f, f->bag->draw_scale);
			else if (i == 5)
				UTVMPush(f, f->bag->ammo_amount);
			else if (i == 6)
				UTVMPush(f, ToF64(f->bag->max_ammo));
			else if (i == 7)
				UTVMPush(f, ToF64(f->bag->team));
			else if (i >= 0 && i < f->bag->n_vec)
				UTVMPush(f, f->bag->vecs[i].v[0]);
			else if (i >= 0 && i < UT_VM_LOCALS)
				UTVMPush(f, f->locals[i]);
			else
				UTVMPush(f, 0.0);
		}
		else if (i >= 0 && i < UT_VM_LOCALS)
			UTVMPush(f, f->locals[i]);
		else
			UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_Let)
	{//execLet: lvalue address then rvalue Step (UnCorSc)
		if (f->ip < f->code_size)
		{
			n = f->code[f->ip] & 255;
			if (n == UT_EX_LocalVariable || n == UT_EX_InstanceVariable ||
				n == UT_EX_DefaultVariable || n == UT_EX_NativeParm ||
				n == UT_EX_BoolVariable)
			{
				UTVMReadU8(f);
				i = UTVMReadI32(f);
				if (!UTVMStepNested(f))
					return FALSE;
				UTVMPopV(f, &tv);
				if (i >= 0 && i < UT_VM_LOCALS)
					UTVMValCopy(&f->locals[i], &tv);
				UTVMPushV(f, &tv);
				return TRUE;
			}
		}
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv2);	//lvalue slot
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);
		i = UTVMValI(&tv2);
		if (i >= 0 && i < UT_VM_LOCALS)
			UTVMValCopy(&f->locals[i], &tv);
		UTVMPushV(f, &tv);
		return TRUE;
	}
	if (op == UT_EX_VirtualFunction || op == UT_EX_FinalFunction ||
		op == UT_EX_GlobalFunction)
	{//CallFunction: name/node then Step parms until EndFunctionParms
		UTVMReadI32(f);
		n = 0;
		while (n < 64 && !f->err && !f->stopped && f->ip < f->code_size)
		{
			if (f->code[f->ip] == UT_EX_EndFunctionParms)
			{
				UTVMReadU8(f);
				break;
			}
			if (!UTVMStepNested(f))
				break;
			n++;
		}
		UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_Context || op == UT_EX_ClassContext)
	{//execContext / execClassContext — nested ObjectExpr then ContextExpr
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);	//NewContext object, None = slot -1
		if (UTVMValB(&tv))
		{
			//non-null: Code += 3 (WORD+BYTE), Step in new context
			if (f->ip + 3 > f->code_size)
			{
				f->err = TRUE;
				return FALSE;
			}
			f->ip = f->ip + 3;
			save_self = ut_vm_self_id;
			save_bag = ut_vm_self_bag;
			save_ctx = f->context_id;
			f->context_id = UTVMValI(&tv);
			if (f->context_id >= 0)
			{
				ctx_bag = UTObjBagForSlot(f->context_id);
				if (ctx_bag)
					UTVMSetSelf(f->context_id, ctx_bag);
				else
					UTVMSetSelf(f->context_id, f->bag);
			}
			if (!UTVMStepNested(f))
			{
				f->context_id = save_ctx;
				UTVMSetSelf(save_self, save_bag);
				return FALSE;
			}
			f->context_id = save_ctx;
			UTVMSetSelf(save_self, save_bag);
		}
		else
		{
			//Accessed None — ReadWord skip, BYTE size, Code += wSkip, zero result
			w_skip = UTVMReadU16(f);
			b_size = UTVMReadU8(f);
			no_warn b_size;
			if (w_skip > 0)
			{
				if (f->ip + w_skip > f->code_size)
					f->ip = f->code_size;
				else
					f->ip = f->ip + w_skip;
			}
			UTVMPushObj(f, -1);
		}
		return TRUE;
	}
	if (op == UT_EX_BeginFunction)
	{
		while (!f->err)
		{
			i = UTVMReadU8(f);
			if (i == 0)
				break;
			UTVMReadU8(f); //OutParm
		}
		return TRUE;
	}
	if (op == UT_EX_EndCode)
	{
		f->stopped = TRUE;
		return FALSE;
	}
	if (op == UT_EX_ResizeString)
	{
		UTVMReadU8(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_MetaCast || op == UT_EX_DynamicCast || op == UT_EX_New)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_ArrayElement || op == UT_EX_DynArrayElement)
	{
		if (!UTVMStepNested(f))
			return FALSE;
		a = UTVMPop(f); //index
		if (!UTVMStepNested(f))
			return FALSE;
		b = UTVMPop(f); //base
		no_warn a;
		UTVMPush(f, b);
		return TRUE;
	}
	if (op == UT_EX_StructMember)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_StructCmpEq || op == UT_EX_StructCmpNe)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv);
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPopV(f, &tv2);
		if (op == UT_EX_StructCmpEq)
			UTVMPushB(f, UTVMValEq(&tv, &tv2));
		else
			UTVMPushB(f, !UTVMValEq(&tv, &tv2));
		return TRUE;
	}
	if (op == UT_EX_Iterator)
	{//Marker only — next Step is AllActors (etc) which runs PRE_ITERATOR.
	 //v200 execIterator is empty; EndWord lives inside the iterator native.
		return TRUE;
	}
	if (op == UT_EX_IteratorNext || op == UT_EX_IteratorPop)
	{//Consumed inside UTVMNativeAllActors POST_ITERATOR; lone hits = no-op.
		return TRUE;
	}
	if (op >= UT_EX_MinConversion && op < UT_EX_MaxConversion)
	{
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
	{
		//high: (op-0x60)<<8 | next
		n = ((op - UT_EX_ExtendedNative) << 8) | UTVMReadU8(f);
		UTVMNative(f, n);
		return !f->err;
	}
	if (op >= UT_EX_FirstNative)
	{
		UTVMNative(f, op);
		return !f->err;
	}
	ut_vm_skip_unk++;
	f->stopped = TRUE;
	return FALSE;
}

I64 UTVMRun(CUTVMFrame *f, I64 max_steps)
{//= ProcessEvent body loop until Return/Stop/budget
	I64 n;

	n = 0;
	while (n < max_steps && UTVMStepExpr(f))
		n++;
	return n;
}

I64 UTVMExecFn(I64 fn_i, CUTPropBag *bag, I64 max_steps)
{//UObject::ProcessEvent stand-in — FFrame(Object,Node,0,Locals) then Step loop
	CUTVMFrame f;

	if (fn_i < 0 || fn_i >= ut_vm_fn_n)
		return 0;
	UTVMFrameInitNode(&f, fn_i, bag);
	if (!f.code || f.code_size < 1)
		return 0;
	return UTVMRun(&f, max_steps);
}

extern I64 UTVMFnFind(U8 *name);
extern I64 UTVMLoadNamed(U8 *pkg_path, U8 *fn_name);

I64 UTVMExecNamed(U8 *fn_name, CUTPropBag *bag, I64 max_steps)
{
	I64 i;

	i = UTVMFnFind(fn_name);
	if (i < 0)
		return 0;
	return UTVMExecFn(i, bag, max_steps);
}

U0 UTVMPollLatent(CUTVMFrame *f, F64 dt)
{//= ProcessState latent poll via GIntrinsics[LatentAction]
	if (!f || !f->latent)
		return;
	if (f->latent == UT_EPOLL_SLEEP)
	{
		ut_vm_latent_float -= dt;
		if (ut_vm_latent_float < 0.5 * dt)
			f->latent = UT_EPOLL_NONE;
	}
	else if (f->latent == UT_EPOLL_FINISHANIM)
	{
		if (ut_vm_anim_finished)
			f->latent = UT_EPOLL_NONE;
	}
	else if (f->latent == UT_EPOLL_FINISHINTERP)
	{
		if (!ut_vm_interpolating)
			f->latent = UT_EPOLL_NONE;
	}
	else
		f->latent = UT_EPOLL_NONE;
}

Bool UTVMGotoState(U8 *state_name, CUTPropBag *bag)
{//= UObject::GotoState — EndState → bind Script → BeginState (Begin label)
	I64 slot;
	I64 obj;

	if (!state_name || !state_name[0])
	{
		ut_vm_main_ok = FALSE;
		ut_vm_state_name[0] = 0;
		ut_vm_state_label[0] = 0;
		return FALSE;
	}
	obj = ut_vm_self_id;
	if (ut_vm_main_ok && ut_vm_state_name[0] &&
		StrCompare(ut_vm_state_name, state_name))
		UTVMCallSelf("EndState", obj, bag, 32);
	slot = UTVMFnFind(state_name);
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", state_name);
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", state_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return FALSE;
	UTVMFrameInitNode(&ut_vm_main, slot, bag);
	if (!ut_vm_main.code || ut_vm_main.code_size < 1)
		return FALSE;
	ut_vm_main.latent = UT_EPOLL_NONE;
	ut_vm_main.object_id = obj;
	ut_vm_main_ok = TRUE;
	ut_vm_state_obj = obj;
	ut_vm_label_n = 0;
	StrPrint(ut_vm_state_name, "%s", state_name);
	StrPrint(ut_vm_state_label, "Begin");
	if (obj >= 0)
		UTObjSetState(obj, state_name);
	if (bag)
		StrPrint(bag->state_name, "%s", state_name);
	UTVMCallSelf("BeginState", obj, bag, 48);
	//Prime LabelTable if first opcode — GotoLabel / Begin seek
	if (ut_vm_main.code[0] == UT_EX_LabelTable)
		UTVMStep(&ut_vm_main);
	if (ut_vm_label_n > 0)
		ut_vm_main.ip = ut_vm_label_ip[0];
	return TRUE;
}

I64 UTVMProcessState(F64 dt)
{//= AActor::ProcessState — poll latent then Step while !LatentAction
	I64 n;
	I64 guard;

	if (!ut_vm_main_ok || !ut_vm_main.code)
		return 0;
	UTVMPollLatent(&ut_vm_main, dt);
	n = 0;
	guard = 0;
	while (!ut_vm_main.latent && !ut_vm_main.stopped &&
		!ut_vm_main.err && guard < 256)
	{
		if (!UTVMStep(&ut_vm_main))
			break;
		n++;
		guard++;
	}
	if (ut_vm_main.stopped || ut_vm_main.err ||
		ut_vm_main.ip >= ut_vm_main.code_size)
		ut_vm_main_ok = FALSE;
	return n;
}

//---- UStruct::SerializeExpr (v200 UnClass.cpp) ----
//Ar uses compact Index for UObject*/FName; Script[] gets fixed I32 slots.
//rewrite_prop: PackageIndex → host LinkOffsets Offset for Property refs.

U0 UTVMScriptPutU8(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code >= max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
		script[*i_code] = v & 255;
	*i_code = *i_code + 1;
}

U0 UTVMScriptPutU16(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code + 2 > max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
	{
		script[*i_code] = v & 255;
		script[*i_code + 1] = (v >> 8) & 255;
	}
	*i_code = *i_code + 2;
}

U0 UTVMScriptPutI32(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code + 4 > max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
	{
		script[*i_code] = v & 255;
		script[*i_code + 1] = (v >> 8) & 255;
		script[*i_code + 2] = (v >> 16) & 255;
		script[*i_code + 3] = (v >> 24) & 255;
	}
	*i_code = *i_code + 4;
}

I64 UTVMXferObjRef(CUTArc *ar, CUTPackage *pkg, U8 *script, I64 *i_code,
	I64 max, Bool rewrite_prop)
{//Ar << UObject*/UProperty*/UClass* — compact Index → Script I32.
	I64 ref;
	I64 out_v;
	I64 ei;
	I64 link_i;
	U8 *cn;
	U8 *nm;

	ref = UTArcIndex(ar);
	out_v = ref;
	if (rewrite_prop && pkg && ref != 0)
	{
		ei = UTPkgObjRefToExport(pkg, ref);
		if (ei >= 0)
		{
			cn = UTPkgClassName(pkg, pkg->exports[ei].class_index);
			if (UTPropLinkIsPropertyClass(cn))
			{
				nm = UTPkgNameStr(pkg, pkg->exports[ei].name_index);
				link_i = UTPropLinkFindByName(nm);
				if (link_i >= 0)
					out_v = ut_plink[link_i].offset;
			}
		}
	}
	UTVMScriptPutI32(script, i_code, max, out_v, ar);
	return out_v;
}

I64 UTVMXferName(CUTArc *ar, U8 *script, I64 *i_code, I64 max)
{//Ar << FName — Index into Script I32.
	I64 ni;

	ni = UTArcIndex(ar);
	UTVMScriptPutI32(script, i_code, max, ni, ar);
	return ni;
}

I64 UTVMSerializeExpr(CUTArc *ar, CUTPackage *pkg, U8 *script, I64 *i_code,
	I64 script_max, Bool rewrite_prop)
{//UStruct::SerializeExpr — returns EExprToken. Advances *i_code and Ar.
	I64 expr;
	I64 b;
	I64 w;
	I64 tok;
	I64 name_i;

	if (!ar || !i_code || ar->err)
		return 0;
	b = UTArcU8(ar) & 255;
	UTVMScriptPutU8(script, i_code, script_max, b, ar);
	expr = b;
	if (ar->err)
		return expr;

	if (expr >= UT_EX_MinConversion && expr < UT_EX_MaxConversion)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr >= UT_EX_FirstNative)
	{
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr >= UT_EX_ExtendedNative && expr < UT_EX_FirstNative)
	{
		b = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, b, ar);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}

	if (expr == UT_EX_LocalVariable || expr == UT_EX_InstanceVariable ||
		expr == UT_EX_DefaultVariable || expr == UT_EX_NativeParm)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_BoolVariable || expr == UT_EX_ValidateObject ||
		expr == UT_EX_Nothing || expr == UT_EX_EndFunctionParms ||
		expr == UT_EX_IntZero || expr == UT_EX_IntOne ||
		expr == UT_EX_True || expr == UT_EX_False ||
		expr == UT_EX_NoObject || expr == UT_EX_Self ||
		expr == UT_EX_IteratorPop || expr == UT_EX_EndCode ||
		expr == UT_EX_Stop || expr == UT_EX_Return ||
		expr == UT_EX_IteratorNext)
		return expr;

	if (expr == UT_EX_ClassContext || expr == UT_EX_Context)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		b = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, b, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_ArrayElement || expr == UT_EX_DynArrayElement)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_VirtualFunction || expr == UT_EX_GlobalFunction)
	{
		UTVMXferName(ar, script, i_code, script_max);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_FinalFunction)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_IntConst)
	{
		w = UTArcI32(ar);
		UTVMScriptPutI32(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_FloatConst)
	{
		//4 raw bytes from Ar into Script
		b = 0;
		while (b < 4)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_StringConst)
	{
		b = 1;
		while (b && !ar->err)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b = w;
		}
		return expr;
	}
	if (expr == UT_EX_ObjectConst)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		return expr;
	}
	if (expr == UT_EX_NameConst)
	{
		UTVMXferName(ar, script, i_code, script_max);
		return expr;
	}
	if (expr == UT_EX_RotationConst)
	{
		b = 0;
		while (b < 3)
		{
			w = UTArcI32(ar);
			UTVMScriptPutI32(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_VectorConst)
	{
		b = 0;
		while (b < 12)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_ByteConst || expr == UT_EX_IntConstByte)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_ResizeString)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_MetaCast || expr == UT_EX_DynamicCast ||
		expr == UT_EX_New)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_JumpIfNot)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Iterator)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_Switch)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Jump)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_Assert)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Case)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		if (w != 0xFFFF)
			UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_LabelTable)
	{
		//FLabelEntry: FName + INT until NAME_None
		while (!ar->err)
		{
			name_i = UTVMXferName(ar, script, i_code, script_max);
			w = UTArcI32(ar);
			UTVMScriptPutI32(script, i_code, script_max, w, ar);
			if (name_i == 0)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_GotoLabel)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Let)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_BeginFunction)
	{
		while (!ar->err)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			if (w == 0)
				break;
			b = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, b, ar);
		}
		return expr;
	}
	if (expr == UT_EX_Skip)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_StructCmpEq || expr == UT_EX_StructCmpNe)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_StructMember)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	//Unknown token — stop Ar walk
	ar->err = TRUE;
	return expr;
}

Bool UTVMReadScriptSerialize(CUTArc *ar, CUTPackage *pkg, U8 **out_code,
	I64 *out_size)
{//Ar << ScriptSize; while iCode < ScriptSize: SerializeExpr.
	I64 script_size;
	I64 i_code;
	U8 *buf;

	*out_code = NULL;
	*out_size = 0;
	if (!ar)
		return FALSE;
	script_size = UTArcI32(ar);
	if (ar->err || script_size < 0 || script_size > UT_VM_CODE_MAX)
		return FALSE;
	if (script_size == 0)
		return TRUE;
	buf = CAlloc(script_size);
	i_code = 0;
	while (i_code < script_size && !ar->err)
		UTVMSerializeExpr(ar, pkg, buf, &i_code, script_size, TRUE);
	if (ar->err || i_code != script_size)
	{
		UTLog("UTVM: SerializeExpr mismatch got=%d want=%d err=%d\n",
			i_code, script_size, ToI64(ar->err));
		//Keep partial if any bytes landed; else free
		if (i_code < 1)
		{
			Free(buf);
			return FALSE;
		}
		//Truncate to what we wrote if short; if over, keep script_size buf
		if (i_code < script_size)
			script_size = i_code;
	}
	*out_code = buf;
	*out_size = script_size;
	return TRUE;
}

I64 UTVMSerializeScriptSkip(CUTArc *ar, CUTPackage *pkg, I64 script_size)
{//Consume ScriptSize bytes worth of exprs from Ar (Class serial path).
	I64 i_code;

	if (!ar || script_size < 1)
		return 0;
	if (script_size > UT_VM_CODE_MAX)
		script_size = UT_VM_CODE_MAX;
	i_code = 0;
	ar->err = FALSE;
	while (i_code < script_size && !ar->err)
		UTVMSerializeExpr(ar, pkg, NULL, &i_code, script_size, FALSE);
	return i_code;
}

Bool UTVMReadScriptArray(CUTArc *ar, U8 **out_code, I64 *out_size)
{//TArray<BYTE> Script: INT count + bytes (UE1).
	I64 n;
	U8 *buf;
	U8 *p;

	*out_code = NULL;
	*out_size = 0;
	n = UTArcI32(ar);
	if (ar->err || n < 0 || n > UT_VM_CODE_MAX)
		return FALSE;
	if (n == 0)
		return TRUE;
	p = UTArcPtr(ar, n);
	if (!p || ar->err)
		return FALSE;
	buf = CAlloc(n);
	MemCopy(buf, p, n);
	*out_code = buf;
	*out_size = n;
	return TRUE;
}

Bool UTVMLoadFunctionScript(CUTPackage *pkg, I64 exp_i, CUTVMFn *fn)
{//UStruct::Serialize after props → ScriptText,Children,FriendlyName,Line,TextPos
 //then LinkOffsets (class props) then ScriptSize + SerializeExpr bytes.
 //UFunction trailer: FunctionFlags,iNative,RepOffset,OperPrecedence.
	CUTArc ar;
	CUTExport *e;
	U8 *code;
	I64 size;
	I64 remain;
	I64 try_n;

	if (pkg == NULL || fn == NULL || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (!UTPkgArcExport(pkg, exp_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
		ar.err = FALSE;

	//UStruct trailer: ScriptText,Children,FriendlyName,Line,TextPos
	UTArcIndex(&ar);
	UTArcIndex(&ar);
	UTArcIndex(&ar);
	UTArcI32(&ar);
	UTArcI32(&ar);

	code = NULL;
	size = 0;
	//Primary: ScriptSize + SerializeExpr (v200 UStruct::Serialize)
	if (!UTVMReadScriptSerialize(&ar, pkg, &code, &size) || size < 1)
	{
		if (code != NULL)
			Free(code);
		code = NULL;
		size = 0;
		ar.err = FALSE;
		//fallback: raw TArray INT + bytes
		if (!UTVMReadScriptArray(&ar, &code, &size) || size < 1)
		{
			//fallback: remainder after UFunction header fields
			if (code != NULL)
				Free(code);
			code = NULL;
			fn->func_flags = UTArcU32(&ar);
			fn->i_native = UTArcU16(&ar);
			UTArcU16(&ar); //RepOffset
			UTArcU8(&ar);  //OperPrecedence
			remain = e->serial_offset + e->serial_size - ar.pos;
			if (remain < 1 || remain > UT_VM_CODE_MAX)
				return FALSE;
			//try INT count at current
			try_n = UTRdI32(pkg->data + ar.pos);
			if (try_n > 0 && try_n + 4 <= remain && try_n <= UT_VM_CODE_MAX)
			{
				code = CAlloc(try_n);
				MemCopy(code, pkg->data + ar.pos + 4, try_n);
				size = try_n;
			}
			else
			{
				code = CAlloc(remain);
				MemCopy(code, pkg->data + ar.pos, remain);
				size = remain;
			}
		}
		else
		{
			fn->func_flags = UTArcU32(&ar);
			fn->i_native = UTArcU16(&ar);
			UTArcU16(&ar);
			UTArcU8(&ar);
		}
	}
	else
	{
		fn->func_flags = UTArcU32(&ar);
		fn->i_native = UTArcU16(&ar);
		UTArcU16(&ar);
		UTArcU8(&ar);
	}

	if (fn->code)
		Free(fn->code);
	fn->code = code;
	fn->size = size;
	fn->loaded = size > 0;
	return fn->loaded;
}

I64 UTVMFnFind(U8 *name)
{
	I64 i;

	i = 0;
	while (i < ut_vm_fn_n)
	{
		if (!StrCompare(ut_vm_fn[i].name, name))
			return i;
		i++;
	}
	return -1;
}

I64 UTVMLoadNamed(U8 *pkg_path, U8 *fn_name)
{
	CUTPackage *pkg;
	I64 ei;
	I64 slot;
	CUTVMFn *fn;

	slot = UTVMFnFind(fn_name);
	if (slot >= 0 && ut_vm_fn[slot].loaded)
		return slot;
	if (ut_vm_fn_n >= UT_VM_FN_MAX && slot < 0)
		return -1;
	pkg = UTPkgLoad(pkg_path);
	if (!pkg)
		return -1;
	ei = UTPkgFindExport(pkg, "Function", fn_name);
	if (ei < 0)
	{
		UTPkgFree(pkg);
		return -1;
	}
	if (slot < 0)
	{
		slot = ut_vm_fn_n;
		fn = &ut_vm_fn[slot];
		MemSet(fn, 0, sizeof(CUTVMFn));
		StrPrint(fn->name, "%s", fn_name);
		StrPrint(fn->pkg, "%s", pkg_path);
		ut_vm_fn_n++;
	}
	else
		fn = &ut_vm_fn[slot];
	if (!UTVMLoadFunctionScript(pkg, ei, fn))
	{
		UTPkgFree(pkg);
		return -1;
	}
	UTLog("UTVM: loaded %s size=%d iNative=%d flags=%08X\n",
		fn_name, fn->size, fn->i_native, fn->func_flags);
	UTPkgFree(pkg);
	return slot;
}

I64 UTVMCall(U8 *fn_name, I64 max_steps)
{
	I64 slot;
	CUTVMFrame fr;

	slot = UTVMFnFind(fn_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return 0;
	UTVMFrameInit(&fr, ut_vm_fn[slot].code, ut_vm_fn[slot].size);
	return UTVMRun(&fr, max_steps);
}

I64 UTVMCallBag(U8 *fn_name, CUTPropBag *bag, I64 max_steps)
{
	I64 slot;
	CUTVMFrame fr;

	slot = UTVMFnFind(fn_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return 0;
	if (bag)
		UTVMSetSelf(ut_vm_self_id, bag);
	UTVMFrameInitBag(&fr, ut_vm_fn[slot].code, ut_vm_fn[slot].size, bag);
	return UTVMRun(&fr, max_steps);
}

I64 UTVMCallSelf(U8 *fn_name, I64 obj_id, CUTPropBag *bag, I64 max_steps)
{
	I64 steps;

	UTVMSetSelf(obj_id, bag);
	steps = UTVMCallBag(fn_name, bag, max_steps);
	return steps;
}

U0 UTVMProbeEngine()
{
	I64 n;
	CUTPropBag bag;

	n = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Fire");
	if (n < 0)
		n = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "TakeDamage");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerMove");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerTick");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "AutonomousPhysics");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "MoveSmooth");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Fire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "AltFire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "TraceFire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "TakeDamage");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Died");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Landed");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Touch");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Trigger");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Bump");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Spawn");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "SetLocation");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "SetPhysics");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "BeginState");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "EndState");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "RemoveFort");
	UTPropBagInit(&bag);
	UTPropLoadClassDefaults("::/Apps/UT99/System/Engine.u", "Pawn", &bag);
	UTPropLoadClassDefaults("::/Apps/UT99/System/Engine.u", "Mover", &bag);
	UTVMCallBag("Fire", &bag, 256);
	UTLog("UTVM: fn_cache=%d steps=%d skip_unk=%d bag_f=%d health=%3.0f\n",
		ut_vm_fn_n, ut_vm_steps_run, ut_vm_skip_unk, bag.n_float, bag.health);
}

U0 UTVMProbeUWindow()
{//UWindow.WindowConsole / UTMenu.UTConsole entry scripts from retail .u
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "CreateRootWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "RenderUWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "LaunchUWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "GetPlayerOwner");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "MouseMove");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "KeyEvent");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "DrawMouse");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "SetCursor");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "Tick");
	UTVMLoadNamed("::/Apps/UT99/System/UTMenu.u", "CreateRootWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UTMenu.u", "PostRender");
	UTLog("UTVM: UWindow probe fn_cache=%d\n", ut_vm_fn_n);
}

U0 UTVMFreeAll()
{
	I64 i;

	i = 0;
	while (i < ut_vm_fn_n)
	{
		if (ut_vm_fn[i].code)
			Free(ut_vm_fn[i].code);
		ut_vm_fn[i].code = NULL;
		ut_vm_fn[i].loaded = FALSE;
		i++;
	}
	ut_vm_fn_n = 0;
}

//hand-authored fallback Fire
U8 ut_vm_fire_code[4] = {UT_VM_NATIVE_FIRE, UT_EX_Stop, 0, 0};
U8 ut_vm_hud_code[4] = {UT_VM_NATIVE_HUD, UT_EX_Stop, 0, 0};
