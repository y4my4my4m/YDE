// UTVM.ZC - UnrealScript bytecode: Script TArray load + FFrame::Step subset.
//
// Full Step lives in closed Engine. Loads UFunction Script bytes from packages
// (UStruct tail after tagged props) and executes a wide opcode set.
// Property-bound FFrame: CUTPropBag seeds locals (UTVMFrameInitBag).
// Canvas iNative 465–474 → SoftDrv via host. PlayerPawn/UWindow natives:
// skip-parms until full object graph. Clone stub Fire table (0x70–0x75) is
// NOT the port path — see docs/Apps/UT99/PORT.md.

#define UT_EX_LocalVariable		0x00
#define UT_EX_InstanceVariable	0x01
#define UT_EX_DefaultVariable	0x02
#define UT_EX_Return			0x04
#define UT_EX_Switch			0x05
#define UT_EX_Jump				0x06
#define UT_EX_JumpIfNot			0x07
#define UT_EX_Stop				0x08
#define UT_EX_Assert			0x09
#define UT_EX_Case				0x0A
#define UT_EX_Nothing			0x0B
#define UT_EX_LabelTable		0x0C
#define UT_EX_GotoLabel			0x0D
#define UT_EX_ValidateObject	0x0E	//v200 UnScript.h (EatString alias)
#define UT_EX_Let				0x0F
#define UT_EX_DynArrayElement	0x10	//UT99+
#define UT_EX_New				0x11	//UT99+
#define UT_EX_ClassContext		0x12
#define UT_EX_MetaCast			0x13
#define UT_EX_BeginFunction		0x14	//v200 UnScript.h
#define UT_EX_EndCode			0x15
#define UT_EX_EndFunctionParms	0x16
#define UT_EX_Self				0x17
#define UT_EX_Skip				0x18
#define UT_EX_Context			0x19
#define UT_EX_ArrayElement		0x1A
#define UT_EX_VirtualFunction	0x1B
#define UT_EX_FinalFunction		0x1C
#define UT_EX_IntConst			0x1D
#define UT_EX_FloatConst		0x1E
#define UT_EX_StringConst		0x1F
#define UT_EX_ObjectConst		0x20
#define UT_EX_NameConst			0x21
#define UT_EX_RotationConst		0x22
#define UT_EX_VectorConst		0x23
#define UT_EX_ByteConst			0x24
#define UT_EX_IntZero			0x25
#define UT_EX_IntOne			0x26
#define UT_EX_True				0x27
#define UT_EX_False				0x28
#define UT_EX_NativeParm		0x29
#define UT_EX_NoObject			0x2A
#define UT_EX_ResizeString		0x2B
#define UT_EX_IntConstByte		0x2C
#define UT_EX_BoolVariable		0x2D
#define UT_EX_DynamicCast		0x2E
#define UT_EX_Iterator			0x2F
#define UT_EX_IteratorPop		0x30
#define UT_EX_IteratorNext		0x31
#define UT_EX_StructCmpEq		0x32
#define UT_EX_StructCmpNe		0x33
#define UT_EX_StructMember		0x36
#define UT_EX_GlobalFunction	0x38
#define UT_EX_MinConversion		0x39
#define UT_EX_MaxConversion		0x5A
#define UT_EX_ExtendedNative	0x60
#define UT_EX_FirstNative		0x70

#define UT_VM_STACK			128
#define UT_VM_LOCALS		64
#define UT_VM_CODE_MAX		8192
#define UT_VM_FN_MAX		48
#define UT_VM_NEST_MAX		64

#define UT_VM_NATIVE_FIRE	0x70
#define UT_VM_NATIVE_DAMAGE	0x71
#define UT_VM_NATIVE_HUD	0x72
#define UT_VM_NATIVE_PLAYSND	0x73
#define UT_VM_NATIVE_TRACE	0x74
#define UT_VM_NATIVE_SPAWN	0x75

#define UT_VM_CMD_NONE		0
#define UT_VM_CMD_FIRE		1
#define UT_VM_CMD_DAMAGE	2
#define UT_VM_CMD_HUD		3
#define UT_VM_CMD_PLAYSND	4
#define UT_VM_CMD_TRACE		5
#define UT_VM_CMD_SPAWN		6
#define UT_VM_CMD_DRAWTILE	7
#define UT_VM_CMD_DRAWTEXT	8

//Engine.u Canvas natives (ScriptText)
#define UT_NATIVE_DRAWTEXT		465
#define UT_NATIVE_DRAWTILE		466
#define UT_NATIVE_DRAWTILECLIP	468
#define UT_NATIVE_DRAWTEXTCLIP	469
#define UT_NATIVE_DRAWTEXT_XY	472
#define UT_NATIVE_DRAWTILE_XY	473
#define UT_NATIVE_DRAWCOLOREDTEXT	474

//Engine / Core iNative (UnScript.cpp / Object.uc)
#define UT_NATIVE_GOTOSTATE		113
#define UT_NATIVE_SLEEP			256
#define UT_NATIVE_PLAYANIM		259
#define UT_NATIVE_LOOPANIM		260
#define UT_NATIVE_FINISHANIM		261
#define UT_NATIVE_SETCOLLISION		262
#define UT_NATIVE_HASANIM		263
#define UT_NATIVE_PLAYSOUND		264
#define UT_NATIVE_MOVE				266
#define UT_NATIVE_SETLOCATION			267
#define UT_NATIVE_TRACE			277
#define UT_NATIVE_SPAWN			278
#define UT_NATIVE_DESTROY		279
#define UT_NATIVE_SETTIMER		280
#define UT_NATIVE_ISANIMATING		282
#define UT_NATIVE_TWEENANIM		294
#define UT_NATIVE_SETBASE			298
#define UT_NATIVE_SETROTATION			299
#define UT_NATIVE_FINISHINTERP		301
#define UT_NATIVE_ALLACTORS		304
#define UT_NATIVE_CHILDACTORS		305
#define UT_NATIVE_BASEDACTORS		306
#define UT_NATIVE_TOUCHINGACTORS	307
#define UT_NATIVE_TRACEACTORS		309
#define UT_NATIVE_RADIUSACTORS		310
#define UT_NATIVE_VISIBLEACTORS		311
#define UT_NATIVE_VISIBLECOLLIDING	312
#define UT_NATIVE_DRAWACTOR		467
#define UT_NATIVE_DRAWPORTAL		480
#define UT_NATIVE_FASTTRACE		548
#define UT_NATIVE_MOVESMOOTH			3969
#define UT_NATIVE_SETPHYSICS			3970
#define UT_NATIVE_AUTONOMOUSPHYSICS		3971

//EPollSlowFuncs (Core UnScript.h)
#define UT_EPOLL_NONE			0
#define UT_EPOLL_SLEEP			384
#define UT_EPOLL_FINISHANIM		385
#define UT_EPOLL_FINISHINTERP		302

#define UT_VM_CMD_MOVE			9
#define UT_VM_CMD_UWIN			10
#define UT_VM_CMD_STATE			11
#define UT_VM_CMD_ITER			12

class CUTVMFrame
{//FFrame (UnStack.h) + FMainFrame latent fields used by SoftDrv host Exec
	U8	*code;			//= FFrame::Code base
	I64	 code_size;
	I64	 ip;			//= Code - Script(0)
	F64	 stack[UT_VM_STACK];
	I64	 sp;
	F64	 locals[UT_VM_LOCALS];	//= FFrame::Locals (F64 slots)
	CUTPropBag *bag;
	I64	 node_fn;		//= FFrame::Node (ut_vm_fn index, -1 none)
	I64	 object_id;		//= FFrame::Object (UTObj slot, -1 none)
	I64	 context_id;		//nested EX_Context Self override
	I64	 nest;			//CHECK_RUNAWAY depth
	I64	 latent;		//= FMainFrame::LatentAction
	F64	 switch_val;		//EX_Switch compare buffer
	Bool	 has_switch;
	Bool stopped;
	Bool err;
	I64	 native_op;
};

class CUTVMFn
{
	U8	 name[64];
	U8	 pkg[64];
	U8	*code;
	I64	 size;
	I64	 i_native;
	U32	 func_flags;
	Bool loaded;
};

CUTVMFn	ut_vm_fn[UT_VM_FN_MAX];
I64		ut_vm_fn_n		= 0;
I64		ut_vm_cmd		= UT_VM_CMD_NONE;
F64		ut_vm_arg		= 0.0;
F64		ut_vm_arg2		= 0.0;
I64		ut_vm_steps_run	= 0;
I64		ut_vm_skip_unk	= 0;
I64		ut_vm_self_id	= -1;		//live UObject slot (UTObj index)
CUTPropBag	*ut_vm_self_bag	= NULL;	//Self instance props

//FMainFrame stand-in — ProcessState keeps Code across ticks while latent
CUTVMFrame	ut_vm_main;
Bool		ut_vm_main_ok		= FALSE;
Bool		ut_vm_state_tried	= FALSE;
F64		ut_vm_latent_float	= 0.0;	//= AActor::LatentFloat
Bool		ut_vm_anim_finished	= TRUE;
Bool		ut_vm_interpolating	= FALSE;
I64		ut_vm_iter_hits		= 0;
U8		ut_vm_state_name[64]	= "";

extern U0 UTVMNativeAllActors(CUTVMFrame *f);

U0 UTVMSetSelf(I64 obj_id, CUTPropBag *bag)
{//Bind FFrame Self for UWindow/HUD/Actor Exec
	ut_vm_self_id = obj_id;
	ut_vm_self_bag = bag;
}

U0 UTVMClearSelf()
{
	ut_vm_self_id = -1;
	ut_vm_self_bag = NULL;
}

U0 UTVMFrameInit(CUTVMFrame *f, U8 *code, I64 size)
{
	MemSet(f, 0, sizeof(CUTVMFrame));
	f->code = code;
	f->code_size = size;
	f->ip = 0;
	f->sp = 0;
	f->bag = NULL;
	f->node_fn = -1;
	f->object_id = ut_vm_self_id;
	f->context_id = ut_vm_self_id;
	f->nest = 0;
	f->latent = 0;
	f->has_switch = FALSE;
	ut_vm_cmd = UT_VM_CMD_NONE;
	ut_vm_arg = 0.0;
	ut_vm_arg2 = 0.0;
}

U0 UTVMFrameInitBag(CUTVMFrame *f, U8 *code, I64 size, CUTPropBag *bag)
{
	UTVMFrameInit(f, code, size);
	f->bag = bag;
	if (!f->bag)
		f->bag = ut_vm_self_bag;
	if (f->bag)
		UTPropBagSeedLocals(f->bag, f->locals, UT_VM_LOCALS);
}

U0 UTVMFrameInitNode(CUTVMFrame *f, I64 fn_i, CUTPropBag *bag)
{//FFrame(Object, Node, 0, Locals) — ProcessEvent entry
	CUTVMFn *fn;

	if (fn_i < 0 || fn_i >= ut_vm_fn_n)
		return;
	fn = &ut_vm_fn[fn_i];
	if (!fn->loaded || !fn->code)
		return;
	UTVMFrameInitBag(f, fn->code, fn->size, bag);
	f->node_fn = fn_i;
}

U0 UTVMPush(CUTVMFrame *f, F64 v)
{
	if (f->sp >= UT_VM_STACK)
	{
		f->err = TRUE;
		return;
	}
	f->stack[f->sp] = v;
	f->sp++;
}

F64 UTVMPop(CUTVMFrame *f)
{
	if (f->sp <= 0)
	{
		f->err = TRUE;
		return 0.0;
	}
	f->sp--;
	return f->stack[f->sp];
}

U8 UTVMReadU8(CUTVMFrame *f)
{
	I64 b;

	if (f->ip >= f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	b = f->code[f->ip];
	f->ip++;
	return b;
}

I64 UTVMReadI32(CUTVMFrame *f)
{
	I64 v;

	if (f->ip + 4 > f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	v = UTRdI32(f->code + f->ip);
	f->ip += 4;
	return v;
}

U16 UTVMReadU16(CUTVMFrame *f)
{
	U16 v;

	if (f->ip + 2 > f->code_size)
	{
		f->err = TRUE;
		return 0;
	}
	v = UTRdU16(f->code + f->ip);
	f->ip += 2;
	return v;
}

F64 UTVMReadF32(CUTVMFrame *f)
{
	F64 v;

	if (f->ip + 4 > f->code_size)
	{
		f->err = TRUE;
		return 0.0;
	}
	v = UTRdF32(f->code + f->ip);
	f->ip += 4;
	return v;
}

U0 UTVMSkipString(CUTVMFrame *f)
{//EX_StringConst: ASCIIZ. I64 temp — ZealC warns on U8 reg locals.
	I64 b;

	b = 1;
	while (b && !f->err)
		b = UTVMReadU8(f);
}

U0 UTVMSkipParms(CUTVMFrame *f)
{//Advance past native parameter expressions to EndFunctionParms.
 //Non-recursive token skip — avoids re-entering StepExpr.
	I64 op;
	I64 guard;

	guard = 0;
	while (guard < 1024 && !f->err && f->ip < f->code_size)
	{
		op = UTVMReadU8(f);
		guard++;
		if (op == UT_EX_EndFunctionParms)
			return;
		if (op == UT_EX_Stop || op == UT_EX_Return)
		{
			f->ip--;
			return;
		}
		if (op == UT_EX_Jump || op == UT_EX_JumpIfNot ||
			op == UT_EX_Assert || op == UT_EX_Case || op == UT_EX_Skip)
			UTVMReadU16(f);
		else if (op == UT_EX_IntConst || op == UT_EX_NameConst ||
			op == UT_EX_ObjectConst || op == UT_EX_GotoLabel ||
			op == UT_EX_LocalVariable || op == UT_EX_InstanceVariable ||
			op == UT_EX_DefaultVariable || op == UT_EX_NativeParm ||
			op == UT_EX_BoolVariable || op == UT_EX_VirtualFunction ||
			op == UT_EX_FinalFunction || op == UT_EX_GlobalFunction)
			UTVMReadI32(f);
		else if (op == UT_EX_FloatConst)
			UTVMReadF32(f);
		else if (op == UT_EX_ByteConst || op == UT_EX_IntConstByte ||
			op == UT_EX_Switch)
			UTVMReadU8(f);
		else if (op == UT_EX_StringConst)
			UTVMSkipString(f);
		else if (op == UT_EX_VectorConst)
		{
			UTVMReadF32(f);
			UTVMReadF32(f);
			UTVMReadF32(f);
		}
		else if (op == UT_EX_RotationConst)
		{
			UTVMReadI32(f);
			UTVMReadI32(f);
			UTVMReadI32(f);
		}
		else if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
			UTVMReadU8(f);
		else if (op >= UT_EX_FirstNative)
		{
			//nested native opcode in parm stream — ignore body
		}
	}
}

U0 UTVMNative(CUTVMFrame *f, I64 op)
{
	F64 secs;

	f->native_op = op;
	if (op == UT_VM_NATIVE_FIRE)
		ut_vm_cmd = UT_VM_CMD_FIRE;
	else if (op == UT_VM_NATIVE_DAMAGE)
	{
		ut_vm_arg = UTVMPop(f);
		ut_vm_cmd = UT_VM_CMD_DAMAGE;
	}
	else if (op == UT_VM_NATIVE_HUD)
		ut_vm_cmd = UT_VM_CMD_HUD;
	else if (op == UT_VM_NATIVE_PLAYSND || op == UT_NATIVE_PLAYSOUND)
	{//= AActor::execPlaySound (264) — SoftDrv host → UTSnd
		UTVMSkipParms(f);
		ut_vm_arg = 0.7;
		ut_vm_cmd = UT_VM_CMD_PLAYSND;
	}
	else if (op == UT_VM_NATIVE_TRACE || op == UT_NATIVE_TRACE ||
		op == UT_NATIVE_FASTTRACE)
	{
		UTVMSkipParms(f);
		ut_vm_arg = 10000.0;
		ut_vm_cmd = UT_VM_CMD_TRACE;
	}
	else if (op == UT_VM_NATIVE_SPAWN || op == UT_NATIVE_SPAWN)
	{
		UTVMSkipParms(f);
		ut_vm_arg = 0.0;
		ut_vm_cmd = UT_VM_CMD_SPAWN;
		UTVMPush(f, 0.0);	//null actor return
	}
	else if (op == UT_NATIVE_DESTROY || op == UT_NATIVE_SETTIMER ||
		op == UT_NATIVE_SETCOLLISION || op == UT_NATIVE_SETBASE ||
		op == UT_NATIVE_SETPHYSICS)
	{
		UTVMSkipParms(f);
		if (op == UT_NATIVE_DESTROY)
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_ISANIMATING)
	{
		UTVMSkipParms(f);
		if (ut_vm_anim_finished)
			UTVMPush(f, 0.0);
		else
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_HASANIM)
	{
		UTVMSkipParms(f);
		UTVMPush(f, 1.0);	//seq table incomplete — assume present
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_DRAWTILE || op == UT_NATIVE_DRAWTILECLIP ||
		op == UT_NATIVE_DRAWTILE_XY)
	{
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTILE;
	}
	else if (op == UT_NATIVE_DRAWTEXT || op == UT_NATIVE_DRAWTEXTCLIP ||
		op == UT_NATIVE_DRAWTEXT_XY || op == UT_NATIVE_DRAWCOLOREDTEXT)
	{
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTEXT;
	}
	else if (op == UT_NATIVE_DRAWACTOR)
	{//= Canvas.DrawActor — SoftDrv host draws current LodMesh/player
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_DRAWTILE;
	}
	else if (op == UT_NATIVE_DRAWPORTAL)
	{//= Canvas.DrawPortal — SoftDrv skips portal fill (PF_Portal path)
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
	else if (op == UT_NATIVE_MOVE || op == UT_NATIVE_MOVESMOOTH ||
		op == UT_NATIVE_SETLOCATION || op == UT_NATIVE_SETROTATION ||
		op == UT_NATIVE_AUTONOMOUSPHYSICS)
	{
		UTVMSkipParms(f);
		if (op == UT_NATIVE_MOVE || op == UT_NATIVE_MOVESMOOTH ||
			op == UT_NATIVE_SETLOCATION || op == UT_NATIVE_SETROTATION)
			UTVMPush(f, 1.0);
		ut_vm_cmd = UT_VM_CMD_MOVE;
	}
	else if (op == UT_NATIVE_SLEEP)
	{//= AActor::execSleep — LatentFloat + EPOLL_Sleep
		if (UTVMStepNested(f))
			secs = UTVMPop(f);
		else
			secs = 0.0;
		UTVMSkipParms(f);
		ut_vm_latent_float = secs;
		f->latent = UT_EPOLL_SLEEP;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_FINISHANIM)
	{//= AActor::execFinishAnim
		UTVMSkipParms(f);
		if (!ut_vm_anim_finished)
			f->latent = UT_EPOLL_FINISHANIM;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_FINISHINTERP)
	{//= AActor::execFinishInterpolation
		UTVMSkipParms(f);
		if (ut_vm_interpolating)
			f->latent = UT_EPOLL_FINISHINTERP;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_PLAYANIM || op == UT_NATIVE_LOOPANIM ||
		op == UT_NATIVE_TWEENANIM)
	{//Anim initiator — mark unfinished; Lod tick clears when seq ends
		UTVMSkipParms(f);
		ut_vm_anim_finished = FALSE;
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_GOTOSTATE)
	{//UObject::execGotoState — host rebinds FMainFrame via UTVMGotoState
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_STATE;
	}
	else if (op == UT_NATIVE_ALLACTORS || op == UT_NATIVE_CHILDACTORS ||
		op == UT_NATIVE_BASEDACTORS || op == UT_NATIVE_TOUCHINGACTORS ||
		op == UT_NATIVE_TRACEACTORS || op == UT_NATIVE_RADIUSACTORS ||
		op == UT_NATIVE_VISIBLEACTORS || op == UT_NATIVE_VISIBLECOLLIDING)
	{//PRE_ITERATOR natives — body in UTActor (ut_actors visible there)
		UTVMNativeAllActors(f);
		ut_vm_cmd = UT_VM_CMD_ITER;
	}
	else if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
		ut_vm_cmd = UT_VM_CMD_NONE;
	else
	{//Unknown Engine iNative — skip parms so Script continues
		UTVMSkipParms(f);
		ut_vm_cmd = UT_VM_CMD_NONE;
	}
}

extern Bool UTVMStepExpr(CUTVMFrame *f);

Bool UTVMStepNested(CUTVMFrame *f)
{//FFrame::Step recursive — Context / JumpIfNot / Let / CallFunction parms.
	Bool ok;

	if (!f || f->err || f->stopped)
		return FALSE;
	if (f->nest >= UT_VM_NEST_MAX)
	{
		f->err = TRUE;
		ut_vm_skip_unk++;
		return FALSE;
	}
	f->nest++;
	ok = UTVMStepExpr(f);
	f->nest--;
	return ok;
}

Bool UTVMStep(CUTVMFrame *f)
{//= FFrame::Step(Context, Result) — one token
	return UTVMStepExpr(f);
}

Bool UTVMStepExpr(CUTVMFrame *f)
{//one token. SoftDrv host: skip unknown with soft stop only on hard errors.
	I64 op;
	I64 dest;
	I64 i;
	I64 j;
	I64 n;
	I64 w_skip;
	I64 b_size;
	I64 save_self;
	I64 save_ctx;
	CUTPropBag *save_bag;
	F64 v;
	F64 a;
	F64 b;

	if (!f || f->stopped || f->err || f->ip >= f->code_size)
		return FALSE;
	op = UTVMReadU8(f);
	ut_vm_steps_run++;

	if (op == UT_EX_Nothing)
		return TRUE;
	if (op == UT_EX_Stop || op == UT_EX_Return)
	{
		f->stopped = TRUE;
		return FALSE;
	}
	if (op == UT_EX_Jump)
	{
		dest = UTVMReadU16(f);
		if (dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_JumpIfNot)
	{//ReadWord then Step boolean (UnCorSc execJumpIfNot)
		dest = UTVMReadU16(f);
		if (!UTVMStepNested(f))
			return FALSE;
		v = UTVMPop(f);
		if (v == 0.0 && dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_Case)
	{
		dest = UTVMReadU16(f);
		if (dest == 0xFFFF)
			return TRUE;
		if (!UTVMStepNested(f))
			return FALSE;
		v = UTVMPop(f);
		if (f->has_switch && v != f->switch_val &&
			dest >= 0 && dest < f->code_size)
			f->ip = dest;
		return TRUE;
	}
	if (op == UT_EX_Switch)
	{//bSize + Step(switch expr) — Case tokens follow
		UTVMReadU8(f);
		if (!UTVMStepNested(f))
			return FALSE;
		f->switch_val = UTVMPop(f);
		f->has_switch = TRUE;
		return TRUE;
	}
	if (op == UT_EX_Assert)
	{
		UTVMReadU16(f); //line
		if (!UTVMStepNested(f))
			return FALSE;
		v = UTVMPop(f);
		no_warn v;
		return TRUE;
	}
	if (op == UT_EX_Skip)
	{
		dest = UTVMReadU16(f);
		no_warn dest;
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_GotoLabel)
	{
		if (!UTVMStepNested(f))
			return FALSE;
		UTVMPop(f);
		return TRUE;
	}
	if (op == UT_EX_LabelTable)
	{//FLabelEntry Name+iCode until NAME_None
		while (!f->err && f->ip + 8 <= f->code_size)
		{
			i = UTVMReadI32(f);
			UTVMReadI32(f);
			if (i == 0)
				break;
		}
		return TRUE;
	}
	if (op == UT_EX_ValidateObject)
		return TRUE;
	if (op == UT_EX_IntZero)
	{
		UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_IntOne)
	{
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_True)
	{
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_False)
	{
		UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_NoObject)
	{
		UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_IntConst)
	{
		UTVMPush(f, ToF64(UTVMReadI32(f)));
		return TRUE;
	}
	if (op == UT_EX_FloatConst)
	{
		UTVMPush(f, UTVMReadF32(f));
		return TRUE;
	}
	if (op == UT_EX_ByteConst || op == UT_EX_IntConstByte)
	{
		UTVMPush(f, ToF64(UTVMReadU8(f)));
		return TRUE;
	}
	if (op == UT_EX_NameConst || op == UT_EX_ObjectConst)
	{
		UTVMReadI32(f);
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_StringConst)
	{
		UTVMSkipString(f);
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_VectorConst)
	{
		UTVMReadF32(f);
		UTVMReadF32(f);
		UTVMReadF32(f);
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_RotationConst)
	{
		UTVMReadI32(f);
		UTVMReadI32(f);
		UTVMReadI32(f);
		UTVMPush(f, 1.0);
		return TRUE;
	}
	if (op == UT_EX_Self)
	{
		if (f->context_id >= 0)
			UTVMPush(f, ToF64(f->context_id + 1));
		else if (ut_vm_self_id >= 0)
			UTVMPush(f, ToF64(ut_vm_self_id + 1));
		else if (f->bag)
			UTVMPush(f, 1.0);
		else
			UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_EndFunctionParms)
		return TRUE;
	if (op == UT_EX_LocalVariable || op == UT_EX_InstanceVariable ||
		op == UT_EX_DefaultVariable || op == UT_EX_NativeParm ||
		op == UT_EX_BoolVariable)
	{
		i = UTVMReadI32(f); //property offset / object
		if (!f->bag && ut_vm_self_bag)
			f->bag = ut_vm_self_bag;
		if (f->bag && (op == UT_EX_InstanceVariable ||
			op == UT_EX_DefaultVariable || op == UT_EX_BoolVariable))
		{
			//UStruct::LinkOffsets — bytecode Offset → bag via prop linker
			j = UTPropLinkFindByOffset(i);
			if (j >= 0)
				UTVMPush(f, UTPropLinkReadBag(f->bag, j, i));
			else if (i == 0 && f->bag->has_location)
				UTVMPush(f, f->bag->location[0]);
			else if (i == 1 && f->bag->has_location)
				UTVMPush(f, f->bag->location[1]);
			else if (i == 2 && f->bag->has_location)
				UTVMPush(f, f->bag->location[2]);
			else if (i == 3)
				UTVMPush(f, f->bag->health);
			else if (i == 4)
				UTVMPush(f, f->bag->draw_scale);
			else if (i == 5)
				UTVMPush(f, f->bag->ammo_amount);
			else if (i == 6)
				UTVMPush(f, ToF64(f->bag->max_ammo));
			else if (i == 7)
				UTVMPush(f, ToF64(f->bag->team));
			else if (i >= 0 && i < f->bag->n_vec)
				UTVMPush(f, f->bag->vecs[i].v[0]);
			else if (i >= 0 && i < UT_VM_LOCALS)
				UTVMPush(f, f->locals[i]);
			else
				UTVMPush(f, 0.0);
		}
		else if (i >= 0 && i < UT_VM_LOCALS)
			UTVMPush(f, f->locals[i]);
		else
			UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_Let)
	{//execLet: lvalue address then rvalue Step (UnCorSc)
		if (f->ip < f->code_size)
		{
			n = f->code[f->ip] & 255;
			if (n == UT_EX_LocalVariable || n == UT_EX_InstanceVariable ||
				n == UT_EX_DefaultVariable || n == UT_EX_NativeParm ||
				n == UT_EX_BoolVariable)
			{
				UTVMReadU8(f);
				i = UTVMReadI32(f);
				if (!UTVMStepNested(f))
					return FALSE;
				b = UTVMPop(f);
				if (i >= 0 && i < UT_VM_LOCALS)
					f->locals[i] = b;
				UTVMPush(f, b);
				return TRUE;
			}
		}
		if (!UTVMStepNested(f))
			return FALSE;
		a = UTVMPop(f);
		if (!UTVMStepNested(f))
			return FALSE;
		b = UTVMPop(f);
		i = ToI64(a);
		if (i >= 0 && i < UT_VM_LOCALS)
			f->locals[i] = b;
		UTVMPush(f, b);
		return TRUE;
	}
	if (op == UT_EX_VirtualFunction || op == UT_EX_FinalFunction ||
		op == UT_EX_GlobalFunction)
	{//CallFunction: name/node then Step parms until EndFunctionParms
		UTVMReadI32(f);
		n = 0;
		while (n < 64 && !f->err && !f->stopped && f->ip < f->code_size)
		{
			if (f->code[f->ip] == UT_EX_EndFunctionParms)
			{
				UTVMReadU8(f);
				break;
			}
			if (!UTVMStepNested(f))
				break;
			n++;
		}
		UTVMPush(f, 0.0);
		return TRUE;
	}
	if (op == UT_EX_Context || op == UT_EX_ClassContext)
	{//execContext / execClassContext — nested ObjectExpr then ContextExpr
		if (!UTVMStepNested(f))
			return FALSE;
		a = UTVMPop(f); //NewContext object id (+1 form) or 0
		if (a != 0.0)
		{
			//non-null: Code += 3 (WORD+BYTE), Step in new context
			if (f->ip + 3 > f->code_size)
			{
				f->err = TRUE;
				return FALSE;
			}
			f->ip = f->ip + 3;
			save_self = ut_vm_self_id;
			save_bag = ut_vm_self_bag;
			save_ctx = f->context_id;
			f->context_id = ToI64(a) - 1;
			if (f->context_id >= 0)
				UTVMSetSelf(f->context_id, f->bag);
			if (!UTVMStepNested(f))
			{
				f->context_id = save_ctx;
				UTVMSetSelf(save_self, save_bag);
				return FALSE;
			}
			f->context_id = save_ctx;
			UTVMSetSelf(save_self, save_bag);
		}
		else
		{
			//Accessed None — ReadWord skip, BYTE size, Code += wSkip, zero result
			w_skip = UTVMReadU16(f);
			b_size = UTVMReadU8(f);
			no_warn b_size;
			if (w_skip > 0)
			{
				if (f->ip + w_skip > f->code_size)
					f->ip = f->code_size;
				else
					f->ip = f->ip + w_skip;
			}
			UTVMPush(f, 0.0);
		}
		return TRUE;
	}
	if (op == UT_EX_BeginFunction)
	{
		while (!f->err)
		{
			i = UTVMReadU8(f);
			if (i == 0)
				break;
			UTVMReadU8(f); //OutParm
		}
		return TRUE;
	}
	if (op == UT_EX_EndCode)
	{
		f->stopped = TRUE;
		return FALSE;
	}
	if (op == UT_EX_ResizeString)
	{
		UTVMReadU8(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_MetaCast || op == UT_EX_DynamicCast || op == UT_EX_New)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_ArrayElement || op == UT_EX_DynArrayElement)
	{
		if (!UTVMStepNested(f))
			return FALSE;
		a = UTVMPop(f); //index
		if (!UTVMStepNested(f))
			return FALSE;
		b = UTVMPop(f); //base
		no_warn a;
		UTVMPush(f, b);
		return TRUE;
	}
	if (op == UT_EX_StructMember)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op == UT_EX_StructCmpEq || op == UT_EX_StructCmpNe)
	{
		UTVMReadI32(f);
		if (!UTVMStepNested(f))
			return FALSE;
		a = UTVMPop(f);
		if (!UTVMStepNested(f))
			return FALSE;
		b = UTVMPop(f);
		if (op == UT_EX_StructCmpEq)
			UTVMPush(f, ToF64(a == b));
		else
			UTVMPush(f, ToF64(a != b));
		return TRUE;
	}
	if (op == UT_EX_Iterator)
	{//Marker only — next Step is AllActors (etc) which runs PRE_ITERATOR.
	 //v200 execIterator is empty; EndWord lives inside the iterator native.
		return TRUE;
	}
	if (op == UT_EX_IteratorNext || op == UT_EX_IteratorPop)
	{//Consumed inside UTVMNativeAllActors POST_ITERATOR; lone hits = no-op.
		return TRUE;
	}
	if (op >= UT_EX_MinConversion && op < UT_EX_MaxConversion)
	{
		if (!UTVMStepNested(f))
			return FALSE;
		return TRUE;
	}
	if (op >= UT_EX_ExtendedNative && op < UT_EX_FirstNative)
	{
		//high: (op-0x60)<<8 | next
		n = ((op - UT_EX_ExtendedNative) << 8) | UTVMReadU8(f);
		UTVMNative(f, n);
		return !f->err;
	}
	if (op >= UT_EX_FirstNative)
	{
		UTVMNative(f, op);
		return !f->err;
	}
	ut_vm_skip_unk++;
	f->stopped = TRUE;
	return FALSE;
}

I64 UTVMRun(CUTVMFrame *f, I64 max_steps)
{//= ProcessEvent body loop until Return/Stop/budget
	I64 n;

	n = 0;
	while (n < max_steps && UTVMStepExpr(f))
		n++;
	return n;
}

I64 UTVMExecFn(I64 fn_i, CUTPropBag *bag, I64 max_steps)
{//UObject::ProcessEvent stand-in — FFrame(Object,Node,0,Locals) then Step loop
	CUTVMFrame f;

	if (fn_i < 0 || fn_i >= ut_vm_fn_n)
		return 0;
	UTVMFrameInitNode(&f, fn_i, bag);
	if (!f.code || f.code_size < 1)
		return 0;
	return UTVMRun(&f, max_steps);
}

extern I64 UTVMFnFind(U8 *name);
extern I64 UTVMLoadNamed(U8 *pkg_path, U8 *fn_name);

I64 UTVMExecNamed(U8 *fn_name, CUTPropBag *bag, I64 max_steps)
{
	I64 i;

	i = UTVMFnFind(fn_name);
	if (i < 0)
		return 0;
	return UTVMExecFn(i, bag, max_steps);
}

U0 UTVMPollLatent(CUTVMFrame *f, F64 dt)
{//= ProcessState latent poll via GIntrinsics[LatentAction]
	if (!f || !f->latent)
		return;
	if (f->latent == UT_EPOLL_SLEEP)
	{
		ut_vm_latent_float -= dt;
		if (ut_vm_latent_float < 0.5 * dt)
			f->latent = UT_EPOLL_NONE;
	}
	else if (f->latent == UT_EPOLL_FINISHANIM)
	{
		if (ut_vm_anim_finished)
			f->latent = UT_EPOLL_NONE;
	}
	else if (f->latent == UT_EPOLL_FINISHINTERP)
	{
		if (!ut_vm_interpolating)
			f->latent = UT_EPOLL_NONE;
	}
	else
		f->latent = UT_EPOLL_NONE;
}

Bool UTVMGotoState(U8 *state_name, CUTPropBag *bag)
{//= UObject::GotoState — bind FMainFrame to named Script (Begin label = ip0)
	I64 slot;

	if (!state_name || !state_name[0])
	{
		ut_vm_main_ok = FALSE;
		ut_vm_state_name[0] = 0;
		return FALSE;
	}
	slot = UTVMFnFind(state_name);
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", state_name);
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", state_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return FALSE;
	UTVMFrameInitNode(&ut_vm_main, slot, bag);
	if (!ut_vm_main.code || ut_vm_main.code_size < 1)
		return FALSE;
	ut_vm_main.latent = UT_EPOLL_NONE;
	ut_vm_main_ok = TRUE;
	StrPrint(ut_vm_state_name, "%s", state_name);
	return TRUE;
}

I64 UTVMProcessState(F64 dt)
{//= AActor::ProcessState — poll latent then Step while !LatentAction
	I64 n;
	I64 guard;

	if (!ut_vm_main_ok || !ut_vm_main.code)
		return 0;
	UTVMPollLatent(&ut_vm_main, dt);
	n = 0;
	guard = 0;
	while (!ut_vm_main.latent && !ut_vm_main.stopped &&
		!ut_vm_main.err && guard < 256)
	{
		if (!UTVMStep(&ut_vm_main))
			break;
		n++;
		guard++;
	}
	if (ut_vm_main.stopped || ut_vm_main.err ||
		ut_vm_main.ip >= ut_vm_main.code_size)
		ut_vm_main_ok = FALSE;
	return n;
}

//---- UStruct::SerializeExpr (v200 UnClass.cpp) ----
//Ar uses compact Index for UObject*/FName; Script[] gets fixed I32 slots.
//rewrite_prop: PackageIndex → host LinkOffsets Offset for Property refs.

U0 UTVMScriptPutU8(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code >= max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
		script[*i_code] = v & 255;
	*i_code = *i_code + 1;
}

U0 UTVMScriptPutU16(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code + 2 > max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
	{
		script[*i_code] = v & 255;
		script[*i_code + 1] = (v >> 8) & 255;
	}
	*i_code = *i_code + 2;
}

U0 UTVMScriptPutI32(U8 *script, I64 *i_code, I64 max, I64 v, CUTArc *ar)
{
	if (!i_code || *i_code + 4 > max)
	{
		if (ar) ar->err = TRUE;
		return;
	}
	if (script)
	{
		script[*i_code] = v & 255;
		script[*i_code + 1] = (v >> 8) & 255;
		script[*i_code + 2] = (v >> 16) & 255;
		script[*i_code + 3] = (v >> 24) & 255;
	}
	*i_code = *i_code + 4;
}

I64 UTVMXferObjRef(CUTArc *ar, CUTPackage *pkg, U8 *script, I64 *i_code,
	I64 max, Bool rewrite_prop)
{//Ar << UObject*/UProperty*/UClass* — compact Index → Script I32.
	I64 ref;
	I64 out_v;
	I64 ei;
	I64 link_i;
	U8 *cn;
	U8 *nm;

	ref = UTArcIndex(ar);
	out_v = ref;
	if (rewrite_prop && pkg && ref != 0)
	{
		ei = UTPkgObjRefToExport(pkg, ref);
		if (ei >= 0)
		{
			cn = UTPkgClassName(pkg, pkg->exports[ei].class_index);
			if (UTPropLinkIsPropertyClass(cn))
			{
				nm = UTPkgNameStr(pkg, pkg->exports[ei].name_index);
				link_i = UTPropLinkFindByName(nm);
				if (link_i >= 0)
					out_v = ut_plink[link_i].offset;
			}
		}
	}
	UTVMScriptPutI32(script, i_code, max, out_v, ar);
	return out_v;
}

I64 UTVMXferName(CUTArc *ar, U8 *script, I64 *i_code, I64 max)
{//Ar << FName — Index into Script I32.
	I64 ni;

	ni = UTArcIndex(ar);
	UTVMScriptPutI32(script, i_code, max, ni, ar);
	return ni;
}

I64 UTVMSerializeExpr(CUTArc *ar, CUTPackage *pkg, U8 *script, I64 *i_code,
	I64 script_max, Bool rewrite_prop)
{//UStruct::SerializeExpr — returns EExprToken. Advances *i_code and Ar.
	I64 expr;
	I64 b;
	I64 w;
	I64 tok;
	I64 name_i;

	if (!ar || !i_code || ar->err)
		return 0;
	b = UTArcU8(ar) & 255;
	UTVMScriptPutU8(script, i_code, script_max, b, ar);
	expr = b;
	if (ar->err)
		return expr;

	if (expr >= UT_EX_MinConversion && expr < UT_EX_MaxConversion)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr >= UT_EX_FirstNative)
	{
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr >= UT_EX_ExtendedNative && expr < UT_EX_FirstNative)
	{
		b = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, b, ar);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}

	if (expr == UT_EX_LocalVariable || expr == UT_EX_InstanceVariable ||
		expr == UT_EX_DefaultVariable || expr == UT_EX_NativeParm)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_BoolVariable || expr == UT_EX_ValidateObject ||
		expr == UT_EX_Nothing || expr == UT_EX_EndFunctionParms ||
		expr == UT_EX_IntZero || expr == UT_EX_IntOne ||
		expr == UT_EX_True || expr == UT_EX_False ||
		expr == UT_EX_NoObject || expr == UT_EX_Self ||
		expr == UT_EX_IteratorPop || expr == UT_EX_EndCode ||
		expr == UT_EX_Stop || expr == UT_EX_Return ||
		expr == UT_EX_IteratorNext)
		return expr;

	if (expr == UT_EX_ClassContext || expr == UT_EX_Context)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		b = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, b, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_ArrayElement || expr == UT_EX_DynArrayElement)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_VirtualFunction || expr == UT_EX_GlobalFunction)
	{
		UTVMXferName(ar, script, i_code, script_max);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_FinalFunction)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		tok = 0;
		while (!ar->err)
		{
			tok = UTVMSerializeExpr(ar, pkg, script, i_code, script_max,
				rewrite_prop);
			if (tok == UT_EX_EndFunctionParms)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_IntConst)
	{
		w = UTArcI32(ar);
		UTVMScriptPutI32(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_FloatConst)
	{
		//4 raw bytes from Ar into Script
		b = 0;
		while (b < 4)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_StringConst)
	{
		b = 1;
		while (b && !ar->err)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b = w;
		}
		return expr;
	}
	if (expr == UT_EX_ObjectConst)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		return expr;
	}
	if (expr == UT_EX_NameConst)
	{
		UTVMXferName(ar, script, i_code, script_max);
		return expr;
	}
	if (expr == UT_EX_RotationConst)
	{
		b = 0;
		while (b < 3)
		{
			w = UTArcI32(ar);
			UTVMScriptPutI32(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_VectorConst)
	{
		b = 0;
		while (b < 12)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			b++;
		}
		return expr;
	}
	if (expr == UT_EX_ByteConst || expr == UT_EX_IntConstByte)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_ResizeString)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_MetaCast || expr == UT_EX_DynamicCast ||
		expr == UT_EX_New)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_JumpIfNot)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Iterator)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_Switch)
	{
		w = UTArcU8(ar) & 255;
		UTVMScriptPutU8(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Jump)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		return expr;
	}
	if (expr == UT_EX_Assert)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Case)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		if (w != 0xFFFF)
			UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_LabelTable)
	{
		//FLabelEntry: FName + INT until NAME_None
		while (!ar->err)
		{
			name_i = UTVMXferName(ar, script, i_code, script_max);
			w = UTArcI32(ar);
			UTVMScriptPutI32(script, i_code, script_max, w, ar);
			if (name_i == 0)
				break;
		}
		return expr;
	}
	if (expr == UT_EX_GotoLabel)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_Let)
	{
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_BeginFunction)
	{
		while (!ar->err)
		{
			w = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, w, ar);
			if (w == 0)
				break;
			b = UTArcU8(ar) & 255;
			UTVMScriptPutU8(script, i_code, script_max, b, ar);
		}
		return expr;
	}
	if (expr == UT_EX_Skip)
	{
		w = UTArcU16(ar) & 0xFFFF;
		UTVMScriptPutU16(script, i_code, script_max, w, ar);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_StructCmpEq || expr == UT_EX_StructCmpNe)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, FALSE);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	if (expr == UT_EX_StructMember)
	{
		UTVMXferObjRef(ar, pkg, script, i_code, script_max, rewrite_prop);
		UTVMSerializeExpr(ar, pkg, script, i_code, script_max, rewrite_prop);
		return expr;
	}
	//Unknown token — stop Ar walk
	ar->err = TRUE;
	return expr;
}

Bool UTVMReadScriptSerialize(CUTArc *ar, CUTPackage *pkg, U8 **out_code,
	I64 *out_size)
{//Ar << ScriptSize; while iCode < ScriptSize: SerializeExpr.
	I64 script_size;
	I64 i_code;
	U8 *buf;

	*out_code = NULL;
	*out_size = 0;
	if (!ar)
		return FALSE;
	script_size = UTArcI32(ar);
	if (ar->err || script_size < 0 || script_size > UT_VM_CODE_MAX)
		return FALSE;
	if (script_size == 0)
		return TRUE;
	buf = CAlloc(script_size);
	i_code = 0;
	while (i_code < script_size && !ar->err)
		UTVMSerializeExpr(ar, pkg, buf, &i_code, script_size, TRUE);
	if (ar->err || i_code != script_size)
	{
		UTLog("UTVM: SerializeExpr mismatch got=%d want=%d err=%d\n",
			i_code, script_size, ToI64(ar->err));
		//Keep partial if any bytes landed; else free
		if (i_code < 1)
		{
			Free(buf);
			return FALSE;
		}
		//Truncate to what we wrote if short; if over, keep script_size buf
		if (i_code < script_size)
			script_size = i_code;
	}
	*out_code = buf;
	*out_size = script_size;
	return TRUE;
}

I64 UTVMSerializeScriptSkip(CUTArc *ar, CUTPackage *pkg, I64 script_size)
{//Consume ScriptSize bytes worth of exprs from Ar (Class serial path).
	I64 i_code;

	if (!ar || script_size < 1)
		return 0;
	if (script_size > UT_VM_CODE_MAX)
		script_size = UT_VM_CODE_MAX;
	i_code = 0;
	ar->err = FALSE;
	while (i_code < script_size && !ar->err)
		UTVMSerializeExpr(ar, pkg, NULL, &i_code, script_size, FALSE);
	return i_code;
}

Bool UTVMReadScriptArray(CUTArc *ar, U8 **out_code, I64 *out_size)
{//TArray<BYTE> Script: INT count + bytes (UE1).
	I64 n;
	U8 *buf;
	U8 *p;

	*out_code = NULL;
	*out_size = 0;
	n = UTArcI32(ar);
	if (ar->err || n < 0 || n > UT_VM_CODE_MAX)
		return FALSE;
	if (n == 0)
		return TRUE;
	p = UTArcPtr(ar, n);
	if (!p || ar->err)
		return FALSE;
	buf = CAlloc(n);
	MemCopy(buf, p, n);
	*out_code = buf;
	*out_size = n;
	return TRUE;
}

Bool UTVMLoadFunctionScript(CUTPackage *pkg, I64 exp_i, CUTVMFn *fn)
{//UStruct::Serialize after props → ScriptText,Children,FriendlyName,Line,TextPos
 //then LinkOffsets (class props) then ScriptSize + SerializeExpr bytes.
 //UFunction trailer: FunctionFlags,iNative,RepOffset,OperPrecedence.
	CUTArc ar;
	CUTExport *e;
	U8 *code;
	I64 size;
	I64 remain;
	I64 try_n;

	if (pkg == NULL || fn == NULL || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (!UTPkgArcExport(pkg, exp_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
		ar.err = FALSE;

	//UStruct trailer: ScriptText,Children,FriendlyName,Line,TextPos
	UTArcIndex(&ar);
	UTArcIndex(&ar);
	UTArcIndex(&ar);
	UTArcI32(&ar);
	UTArcI32(&ar);

	code = NULL;
	size = 0;
	//Primary: ScriptSize + SerializeExpr (v200 UStruct::Serialize)
	if (!UTVMReadScriptSerialize(&ar, pkg, &code, &size) || size < 1)
	{
		if (code != NULL)
			Free(code);
		code = NULL;
		size = 0;
		ar.err = FALSE;
		//fallback: raw TArray INT + bytes
		if (!UTVMReadScriptArray(&ar, &code, &size) || size < 1)
		{
			//fallback: remainder after UFunction header fields
			if (code != NULL)
				Free(code);
			code = NULL;
			fn->func_flags = UTArcU32(&ar);
			fn->i_native = UTArcU16(&ar);
			UTArcU16(&ar); //RepOffset
			UTArcU8(&ar);  //OperPrecedence
			remain = e->serial_offset + e->serial_size - ar.pos;
			if (remain < 1 || remain > UT_VM_CODE_MAX)
				return FALSE;
			//try INT count at current
			try_n = UTRdI32(pkg->data + ar.pos);
			if (try_n > 0 && try_n + 4 <= remain && try_n <= UT_VM_CODE_MAX)
			{
				code = CAlloc(try_n);
				MemCopy(code, pkg->data + ar.pos + 4, try_n);
				size = try_n;
			}
			else
			{
				code = CAlloc(remain);
				MemCopy(code, pkg->data + ar.pos, remain);
				size = remain;
			}
		}
		else
		{
			fn->func_flags = UTArcU32(&ar);
			fn->i_native = UTArcU16(&ar);
			UTArcU16(&ar);
			UTArcU8(&ar);
		}
	}
	else
	{
		fn->func_flags = UTArcU32(&ar);
		fn->i_native = UTArcU16(&ar);
		UTArcU16(&ar);
		UTArcU8(&ar);
	}

	if (fn->code)
		Free(fn->code);
	fn->code = code;
	fn->size = size;
	fn->loaded = size > 0;
	return fn->loaded;
}

I64 UTVMFnFind(U8 *name)
{
	I64 i;

	i = 0;
	while (i < ut_vm_fn_n)
	{
		if (!StrCompare(ut_vm_fn[i].name, name))
			return i;
		i++;
	}
	return -1;
}

I64 UTVMLoadNamed(U8 *pkg_path, U8 *fn_name)
{
	CUTPackage *pkg;
	I64 ei;
	I64 slot;
	CUTVMFn *fn;

	slot = UTVMFnFind(fn_name);
	if (slot >= 0 && ut_vm_fn[slot].loaded)
		return slot;
	if (ut_vm_fn_n >= UT_VM_FN_MAX && slot < 0)
		return -1;
	pkg = UTPkgLoad(pkg_path);
	if (!pkg)
		return -1;
	ei = UTPkgFindExport(pkg, "Function", fn_name);
	if (ei < 0)
	{
		UTPkgFree(pkg);
		return -1;
	}
	if (slot < 0)
	{
		slot = ut_vm_fn_n;
		fn = &ut_vm_fn[slot];
		MemSet(fn, 0, sizeof(CUTVMFn));
		StrPrint(fn->name, "%s", fn_name);
		StrPrint(fn->pkg, "%s", pkg_path);
		ut_vm_fn_n++;
	}
	else
		fn = &ut_vm_fn[slot];
	if (!UTVMLoadFunctionScript(pkg, ei, fn))
	{
		UTPkgFree(pkg);
		return -1;
	}
	UTLog("UTVM: loaded %s size=%d iNative=%d flags=%08X\n",
		fn_name, fn->size, fn->i_native, fn->func_flags);
	UTPkgFree(pkg);
	return slot;
}

I64 UTVMCall(U8 *fn_name, I64 max_steps)
{
	I64 slot;
	CUTVMFrame fr;

	slot = UTVMFnFind(fn_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return 0;
	UTVMFrameInit(&fr, ut_vm_fn[slot].code, ut_vm_fn[slot].size);
	return UTVMRun(&fr, max_steps);
}

I64 UTVMCallBag(U8 *fn_name, CUTPropBag *bag, I64 max_steps)
{
	I64 slot;
	CUTVMFrame fr;

	slot = UTVMFnFind(fn_name);
	if (slot < 0 || !ut_vm_fn[slot].loaded)
		return 0;
	if (bag)
		UTVMSetSelf(ut_vm_self_id, bag);
	UTVMFrameInitBag(&fr, ut_vm_fn[slot].code, ut_vm_fn[slot].size, bag);
	return UTVMRun(&fr, max_steps);
}

I64 UTVMCallSelf(U8 *fn_name, I64 obj_id, CUTPropBag *bag, I64 max_steps)
{
	I64 steps;

	UTVMSetSelf(obj_id, bag);
	steps = UTVMCallBag(fn_name, bag, max_steps);
	return steps;
}

U0 UTVMProbeEngine()
{
	I64 n;
	CUTPropBag bag;

	n = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Fire");
	if (n < 0)
		n = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "TakeDamage");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerMove");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerTick");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "AutonomousPhysics");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "MoveSmooth");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Fire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "AltFire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "TraceFire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "TakeDamage");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Died");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Landed");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Touch");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Trigger");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Bump");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Spawn");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "SetLocation");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "SetPhysics");
	UTPropBagInit(&bag);
	UTPropLoadClassDefaults("::/Apps/UT99/System/Engine.u", "Pawn", &bag);
	UTPropLoadClassDefaults("::/Apps/UT99/System/Engine.u", "Mover", &bag);
	UTVMCallBag("Fire", &bag, 256);
	UTLog("UTVM: fn_cache=%d steps=%d skip_unk=%d bag_f=%d health=%3.0f\n",
		ut_vm_fn_n, ut_vm_steps_run, ut_vm_skip_unk, bag.n_float, bag.health);
}

U0 UTVMProbeUWindow()
{//UWindow.WindowConsole / UTMenu.UTConsole entry scripts from retail .u
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "CreateRootWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "RenderUWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "LaunchUWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "GetPlayerOwner");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "MouseMove");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "KeyEvent");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "DrawMouse");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "SetCursor");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "Tick");
	UTVMLoadNamed("::/Apps/UT99/System/UTMenu.u", "CreateRootWindow");
	UTVMLoadNamed("::/Apps/UT99/System/UTMenu.u", "PostRender");
	UTLog("UTVM: UWindow probe fn_cache=%d\n", ut_vm_fn_n);
}

U0 UTVMFreeAll()
{
	I64 i;

	i = 0;
	while (i < ut_vm_fn_n)
	{
		if (ut_vm_fn[i].code)
			Free(ut_vm_fn[i].code);
		ut_vm_fn[i].code = NULL;
		ut_vm_fn[i].loaded = FALSE;
		i++;
	}
	ut_vm_fn_n = 0;
}

//hand-authored fallback Fire
U8 ut_vm_fire_code[4] = {UT_VM_NATIVE_FIRE, UT_EX_Stop, 0, 0};
U8 ut_vm_hud_code[4] = {UT_VM_NATIVE_HUD, UT_EX_Stop, 0, 0};
