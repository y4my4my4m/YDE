U0 UTVMFreeAll()
{
	I64 i;

	i = 0;
	while (i < ut_vm_fn_n)
	{
		if (ut_vm_fn[i].code)
			Free(ut_vm_fn[i].code);
		ut_vm_fn[i].code = NULL;
		ut_vm_fn[i].loaded = FALSE;
		i++;
	}
	ut_vm_fn_n = 0;
}

