// UTVoice.ZC - TournamentPlayer voice menu SoftDrv host (Male2Voice.uax).
//
// V key / Tools→Voice. Orders: Attack Defend Cover Hold Follow Taunt Medic.

#define UT_VOICE_N		8

U8 *ut_voice_caps[UT_VOICE_N] = {
	"Attack",
	"Defend",
	"Cover Me",
	"Hold Position",
	"Follow Me",
	"Medic",
	"Taunt",
	"Incoming"
};

U8 *ut_voice_snd[UT_VOICE_N] = {
	"M2assault",
	"M2defend",
	"M2coverme",
	"M2hold",
	"M2gotyourback",
	"M2Medic",
	"M2laugh",
	"M2incoming"
};

I64		ut_voice_slot[UT_VOICE_N];
Bool	ut_voice_ready	= FALSE;
Bool	ut_voice_menu	= FALSE;
I64		ut_voice_sel	= 0;
F64		ut_voice_cool	= 0.0;

extern U0 UTGameApplyVoiceOrder(I64 voice_i);

U0 UTVoiceInit()
{
	I64 i;
	U8 path[256];

	i = 0;
	while (i < UT_VOICE_N)
	{
		ut_voice_slot[i] = -1;
		i++;
	}
	StrPrint(path, "%sMale2Voice.uax", UT99_SOUNDS_DIR);
	i = 0;
	while (i < UT_VOICE_N)
	{
		ut_voice_slot[i] = UTSndLoadFromUax(path, ut_voice_snd[i]);
		i++;
	}
	ut_voice_ready = TRUE;
	ut_voice_menu = FALSE;
	ut_voice_sel = 0;
	ut_voice_cool = 0.0;
	UTLog("UTVoice: slots ready\n");
}

U0 UTVoicePlay(I64 i)
{
	if (!ut_voice_ready || i < 0 || i >= UT_VOICE_N)
		return;
	if (tS < ut_voice_cool)
		return;
	if (ut_voice_slot[i] >= 0)
		UTSndPlay(ut_voice_slot[i], 1.0);
	ut_voice_cool = tS + 1.2;
}

U0 UTVoiceToggle()
{
	ut_voice_menu = !ut_voice_menu;
	if (ut_voice_menu)
		ut_voice_sel = 0;
}

U0 UTVoiceCycle(I64 dir)
{
	ut_voice_sel += dir;
	if (ut_voice_sel < 0)
		ut_voice_sel = UT_VOICE_N - 1;
	if (ut_voice_sel >= UT_VOICE_N)
		ut_voice_sel = 0;
}

U0 UTVoiceConfirm()
{
	UTVoicePlay(ut_voice_sel);
	UTGameApplyVoiceOrder(ut_voice_sel);
	ut_voice_menu = FALSE;
}

U0 UTVoicePick(I64 i)
{//Digit 1..8 → select + confirm.
	if (i < 0 || i >= UT_VOICE_N)
		return;
	ut_voice_sel = i;
	UTVoiceConfirm;
}

U0 UTVoiceDraw(CUTCanvas *c)
{
	I64 i;
	I64 y;
	I64 col;
	U8 line[48];

	if (!c || !ut_voice_menu || !ut_win_ready)
		return;
	UTWinFill(8, 40, 160, 20 + UT_VOICE_N * 16, ut_col_laf_client);
	UTWinTextAt(12, 44, "VOICE MENU (V)", ut_col_sel);
	i = 0;
	while (i < UT_VOICE_N)
	{
		y = 64 + i * 16;
		col = ut_col_label;
		if (i == ut_voice_sel)
			col = ut_col_sel;
		StrPrint(line, "%d  %s", i + 1, ut_voice_caps[i]);
		UTWinTextAt(16, y, line, col);
		i++;
	}
	UTWinTextAt(12, 64 + UT_VOICE_N * 16 + 4, "1-8 / [ ] Enter",
		ut_col_dim);
}
