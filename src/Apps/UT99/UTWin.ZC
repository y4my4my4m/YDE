// UCanvas SoftDrv path (Engine Canvas natives).
//
// SoftDrv = URenderDevice framebuffer. DrawTile writes P8 indices.
// DrawText: GrFont TTF → SoftDrv pens. Optional UFont glyphs if TTF absent.

//UCanvas / Actor ERenderStyle (Engine Actor.uc)
#define UT_STY_NONE			0
#define UT_STY_NORMAL		1
#define UT_STY_MASKED		2
#define UT_STY_TRANSLUCENT	3
#define UT_STY_MODULATED	4

class CUTWinCanvas
{
	CUTCanvas	*fb;
	CUTFont		*font;
	I64			 cur_x;
	I64			 cur_y;
	I64			 org_x;
	I64			 org_y;
	I64			 clip_x;	//UCanvas.ClipX — width from Org
	I64			 clip_y;	//UCanvas.ClipY — height from Org
	I64			 color;		//SoftDrv palette index
	I64			 draw_r;	//UCanvas.DrawColor R 0..255
	I64			 draw_g;
	I64			 draw_b;
	I64			 style;		//ERenderStyle STY_*
	I64			 space_x;
	I64			 space_y;
	I64			 font_px;	//TTF pixel size for this draw
	Bool		 center;
};

#define UT_WIN_CLIP_STACK	16

class CUTWinClipFrame
{//PaintClients save/restore of OrgX/OrgY/ClipX/ClipY
	I64	org_x;
	I64	org_y;
	I64	clip_x;
	I64	clip_y;
};

CUTWinCanvas ut_win;
Bool         ut_win_ready = FALSE;
Bool         ut_win_zeroed = FALSE;	//TRUE after first MemSet; Free safe thereafter
CUTWinClipFrame ut_win_clip_stack[UT_WIN_CLIP_STACK];
I64		ut_win_clip_sp	= 0;

CUTTex	ut_win_logo;
CUTTex	ut_win_metal;
CUTTex	ut_win_ulogo;
Bool	ut_win_logo_ok	= FALSE;
Bool	ut_win_metal_ok	= FALSE;
Bool	ut_win_ulogo_ok	= FALSE;

U0 UTWinFreeArt()
{//Globals not zeroed. Free only after first MemSet (ut_win_zeroed).
	if (!ut_win_zeroed)
		return;
	if (ut_win_logo_ok)
		UTTexFreeMips(&ut_win_logo);
	if (ut_win_metal_ok)
		UTTexFreeMips(&ut_win_metal);
	if (ut_win_ulogo_ok)
		UTTexFreeMips(&ut_win_ulogo);
	ut_win_logo_ok = FALSE;
	ut_win_metal_ok = FALSE;
	ut_win_ulogo_ok = FALSE;
}

U0 UTWinLoadArt()
{
	if (ut_win_zeroed)
		UTWinFreeArt;
	else
	{
		MemSet(&ut_win_logo, 0, sizeof(CUTTex));
		MemSet(&ut_win_metal, 0, sizeof(CUTTex));
		MemSet(&ut_win_ulogo, 0, sizeof(CUTTex));
		ut_win_logo_ok = FALSE;
		ut_win_metal_ok = FALSE;
		ut_win_ulogo_ok = FALSE;
		ut_win_zeroed = TRUE;
	}
	UTTexInit(&ut_win_logo);
	UTTexInit(&ut_win_metal);
	UTTexInit(&ut_win_ulogo);
	if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
	{
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"logo2", &ut_win_logo))
			ut_win_logo_ok = TRUE;
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"rmetal", &ut_win_metal))
			ut_win_metal_ok = TRUE;
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"epic", &ut_win_ulogo))
			ut_win_ulogo_ok = TRUE;
		else if (ut_win_logo_ok)
		{
			ut_win_ulogo_ok = FALSE;
		}
	}
}

U0 UTWinInit(CUTCanvas *fb)
{
	MemSet(&ut_win, 0, sizeof(CUTWinCanvas));
	ut_win.fb = fb;
	ut_win.font = &ut_font_ui;
	ut_win.color = ut_col_white;
	ut_win.draw_r = 255;
	ut_win.draw_g = 255;
	ut_win.draw_b = 255;
	ut_win.style = UT_STY_NORMAL;
	ut_win.font_px = ut_ttf_px;
	ut_win.clip_x = 320;
	ut_win.clip_y = 240;
	if (fb)
	{
		ut_win.clip_x = fb->width;
		ut_win.clip_y = fb->height;
	}
	UTWinLoadArt;
	ut_win_ready = fb != NULL;
	UTLog("UTWin: canvas=%d ttf=%d ufont=%d logo=%d metal=%d ulogo=%d\n",
		ToI64(ut_win_ready), ToI64(ut_ttf_ready), ToI64(ut_ufont_ready),
		ToI64(ut_win_logo_ok), ToI64(ut_win_metal_ok),
		ToI64(ut_win_ulogo_ok));
}

U0 UTWinExit()
{
	UTWinFreeArt;
	ut_win.fb = NULL;
	ut_win_ready = FALSE;
}

U0 UTWinReset()
{//UCanvas.Reset - origin/clip full framebuffer
	if (!ut_win.fb)
		return;
	ut_win.cur_x = 0;
	ut_win.cur_y = 0;
	ut_win.org_x = 0;
	ut_win.org_y = 0;
	ut_win.clip_x = ut_win.fb->width;
	ut_win.clip_y = ut_win.fb->height;
	ut_win.space_x = 0;
	ut_win.space_y = 0;
	ut_win.center = FALSE;
	ut_win.color = ut_col_white;
	ut_win.draw_r = 255;
	ut_win.draw_g = 255;
	ut_win.draw_b = 255;
	ut_win.style = UT_STY_NORMAL;
	ut_win.font = &ut_font_ui;
	ut_win.font_px = ut_ttf_px;
	ut_win_clip_sp = 0;
}

U0 UTWinSetOrigin(I64 x, I64 y)
{//UCanvas.SetOrigin
	ut_win.org_x = x;
	ut_win.org_y = y;
}

U0 UTWinSetClip(I64 w, I64 h)
{//UCanvas.SetClip — ClipX/ClipY = region size from Org
	if (w < 0) w = 0;
	if (h < 0) h = 0;
	ut_win.clip_x = w;
	ut_win.clip_y = h;
}

Bool UTWinPushClip(I64 org_x, I64 org_y, I64 clip_w, I64 clip_h)
{
	CUTWinClipFrame *f;

	if (ut_win_clip_sp >= UT_WIN_CLIP_STACK)
		return FALSE;
	f = &ut_win_clip_stack[ut_win_clip_sp];
	f->org_x = ut_win.org_x;
	f->org_y = ut_win.org_y;
	f->clip_x = ut_win.clip_x;
	f->clip_y = ut_win.clip_y;
	ut_win_clip_sp++;
	ut_win.org_x = org_x;
	ut_win.org_y = org_y;
	if (clip_w < 0) clip_w = 0;
	if (clip_h < 0) clip_h = 0;
	ut_win.clip_x = clip_w;
	ut_win.clip_y = clip_h;
	return TRUE;
}

U0 UTWinPopClip()
{
	CUTWinClipFrame *f;

	if (ut_win_clip_sp < 1)
		return;
	ut_win_clip_sp--;
	f = &ut_win_clip_stack[ut_win_clip_sp];
	ut_win.org_x = f->org_x;
	ut_win.org_y = f->org_y;
	ut_win.clip_x = f->clip_x;
	ut_win.clip_y = f->clip_y;
}

U0 UTWinClipScreen(I64 *x0, I64 *y0, I64 *x1, I64 *y1)
{
	I64 cx0;
	I64 cy0;
	I64 cx1;
	I64 cy1;

	if (!ut_win.fb || !x0 || !y0 || !x1 || !y1)
		return;
	cx0 = ut_win.org_x;
	cy0 = ut_win.org_y;
	cx1 = ut_win.org_x + ut_win.clip_x;
	cy1 = ut_win.org_y + ut_win.clip_y;
	if (cx0 < 0) cx0 = 0;
	if (cy0 < 0) cy0 = 0;
	if (cx1 > ut_win.fb->width) cx1 = ut_win.fb->width;
	if (cy1 > ut_win.fb->height) cy1 = ut_win.fb->height;
	if (*x0 < cx0) *x0 = cx0;
	if (*y0 < cy0) *y0 = cy0;
	if (*x1 > cx1) *x1 = cx1;
	if (*y1 > cy1) *y1 = cy1;
}

U0 UTWinSetPos(I64 x, I64 y)
{
	ut_win.cur_x = x;
	ut_win.cur_y = y;
}

U0 UTWinSetColor(I64 pal_idx)
{
	ut_win.color = pal_idx & 255;
}

U0 UTWinPutIndex(CUTCanvas *c, I64 i, I64 col)
{//Writing a palette index clears argb: bit 31 left set keeps the pixel owned
 //by the truecolor plane and the blit ignores the write.
	c->pixels[i] = col & 255;
	c->argb[i] = 0;
}

U0 UTWinFill(I64 x, I64 y, I64 w, I64 h, I64 col)
{
	CUTCanvas *c;
	I64 px;
	I64 py;
	I64 x2;
	I64 y2;
	I64 i;

	c = ut_win.fb;
	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	UTWinClipScreen(&x, &y, &x2, &y2);
	if (x >= x2 || y >= y2)
		return;
	py = y;
	while (py < y2)
	{
		px = x;
		while (px < x2)
		{
			i = py * c->width + px;
			UTWinPutIndex(c, i, col);
			px++;
		}
		py++;
	}
}

U0 UTWinSetDrawColor(I64 r, I64 g, I64 b)
{//UCanvas.DrawColor — SoftDrv tile/text modulate.
	if (r < 0) r = 0;
	if (g < 0) g = 0;
	if (b < 0) b = 0;
	if (r > 255) r = 255;
	if (g > 255) g = 255;
	if (b > 255) b = 255;
	ut_win.draw_r = r;
	ut_win.draw_g = g;
	ut_win.draw_b = b;
}

U0 UTWinSetStyle(I64 style)
{
	ut_win.style = style;
}

U8 UTWinBlendTranslucent(U8 src, U8 dst)
{//SoftDrv PF_Translucent DrawTile — additive saturate.
	return UTPalBlendAdd(src, dst);
}

U8 UTWinBlendModulated(U8 src, U8 dst)
{//STY_Modulated — multiply then /255
	return UTPalBlendMod(src, dst);
}

U0 UTWinDrawTile(CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	I64 u0, I64 v0, I64 uw, I64 vh)
{//UCanvas.DrawTile - SoftDrv blit. STY_Translucent = additive; Masked skips 0.
	CUTCanvas *c;
	I64 px;
	I64 py;
	I64 x2;
	I64 y2;
	I64 ox;
	I64 oy;
	I64 sx;
	I64 sy;
	I64 tw;
	I64 th;
	I64 texel;
	I64 i;
	I64 r;
	I64 g;
	I64 b;
	Bool modulate;
	U8 dst;

	c = ut_win.fb;
	if (!c || !tex || !tex->mips[0].pixels || w < 1 || h < 1)
		return;
	if (ut_win.style == UT_STY_NONE)
		return;
	tw = tex->u_size;
	th = tex->v_size;
	if (tw < 1 || th < 1)
		return;
	if (uw < 1) uw = tw;
	if (vh < 1) vh = th;
	ox = x;
	oy = y;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	UTWinClipScreen(&x, &y, &x2, &y2);
	if (x >= x2 || y >= y2)
		return;
	modulate = !(ut_win.draw_r == 255 && ut_win.draw_g == 255 &&
		ut_win.draw_b == 255);
	py = y;
	while (py < y2)
	{
		sy = v0 + (py - oy) * vh / h;
		px = x;
		while (px < x2)
		{
			sx = u0 + (px - ox) * uw / w;
			texel = UTTexSample(tex, sx, sy);
			if (texel || ut_win.style == UT_STY_TRANSLUCENT ||
				ut_win.style == UT_STY_MODULATED)
			{
				if (texel && modulate && !(tex && tex->has_argb))
				{
					r = (ToI64(ut_pal_r[texel & 255]) * ut_win.draw_r) / 255;
					g = (ToI64(ut_pal_g[texel & 255]) * ut_win.draw_g) / 255;
					b = (ToI64(ut_pal_b[texel & 255]) * ut_win.draw_b) / 255;
					if (r > 255) r = 255;
					if (g > 255) g = 255;
					if (b > 255) b = 255;
					texel = UTPalBestMatch(r & 255, g & 255, b & 255, 1) & 255;
				}
				i = py * c->width + px;
					//Truecolor when the texture kept its own UPalette.
				if (tex && tex->has_argb && texel)
				{
					UTDrawPutTexel(c, i, tex, texel,
						ut_win.style == UT_STY_TRANSLUCENT,
						ut_win.style == UT_STY_MODULATED, 1.0e30);
				}
				else if (ut_win.style == UT_STY_TRANSLUCENT && texel)
				{
					dst = c->pixels[i];
					UTWinPutIndex(c, i,
						UTWinBlendTranslucent(texel & 255, dst));
				}
				else if (ut_win.style == UT_STY_MODULATED && texel)
				{
					dst = c->pixels[i];
					UTWinPutIndex(c, i,
						UTWinBlendModulated(texel & 255, dst));
				}
				else if (texel)
					UTWinPutIndex(c, i, texel);
			}
			px++;
		}
		py++;
	}
}

U0 UTWinDrawTileStretched(CUTTex *tex, I64 x, I64 y, I64 w, I64 h)
{
	if (!tex)
		return;
	UTWinDrawTile(tex, x, y, w, h, 0, 0, tex->u_size, tex->v_size);
}

U0 UTWinDrawTileClipped(CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	I64 u0, I64 v0, I64 uw, I64 vh)
{//UCanvas.DrawTileClipped — draw inside current Org/Clip region.
	UTWinDrawTile(tex, x, y, w, h, u0, v0, uw, vh);
}

U0 UTWinBlitCov(CDC *fdc, I64 dx, I64 dy, I64 col)
{//GrFont coverage DC → SoftDrv P8. Alpha>=96 stamps palette index.
	CUTCanvas *c;
	I64 x;
	I64 y;
	I64 sx;
	I64 sy;
	I64 a;
	I64 i;
	I64 stride;
	U32 pix;
	U32 *body;

	c = ut_win.fb;
	if (!c || !fdc || !fdc->body)
		return;
	body = fdc->body;
	stride = fdc->width_internal;
	y = 0;
	while (y < fdc->height)
	{
		sy = dy + y;
		if (sy >= 0 && sy < c->height)
		{
			x = 0;
			while (x < fdc->width)
			{
				sx = dx + x;
				if (sx >= 0 && sx < c->width)
				{
					pix = body[y * stride + x];
					a = (pix >> 24) & 0xFF;
					if (a >= 96)
					{
						i = sy * c->width + sx;
						UTWinPutIndex(c, i, col);
					}
				}
				x++;
			}
		}
		y++;
	}
}

U0 UTWinPlotGlyph(CUTFontPage *page, CUTFontChar *g, I64 dx, I64 dy, I64 col)
{
	CUTCanvas *c;
	I64 x;
	I64 y;
	I64 sx;
	I64 sy;
	I64 i;
	I64 texel;

	c = ut_win.fb;
	if (!c || !page || !g || !page->tex_ok)
		return;
	if (g->u_size < 1 || g->v_size < 1)
		return;
	y = 0;
	while (y < g->v_size)
	{
		sy = g->start_v + y;
		x = 0;
		while (x < g->u_size)
		{
			sx = g->start_u + x;
			texel = UTTexSample(&page->tex, sx, sy);
			if (texel)
			{
				if (dx + x >= 0 && dy + y >= 0 &&
					dx + x < c->width && dy + y < c->height)
				{
					i = (dy + y) * c->width + (dx + x);
					UTWinPutIndex(c, i, col);
				}
			}
			x++;
		}
		y++;
	}
}

U0 UTWinPlotSysChar(I64 dx, I64 dy, U8 ch, I64 col)
{//8x8 DolDoc bitmap last resort (no TTF / UFont)
	CUTCanvas *c;
	I64 px;
	I64 py;
	I64 i;
	U64 bits;

	c = ut_win.fb;
	if (!c)
		return;
	bits = text.font[ch];
	py = 0;
	while (py < FONT_HEIGHT)
	{
		px = 0;
		while (px < FONT_WIDTH)
		{
			if (((bits >> (py * 8 + px)) & 1))
			{
				if (dx + px >= 0 && dy + py >= 0 &&
					dx + px < c->width && dy + py < c->height)
				{
					i = (dy + py) * c->width + (dx + px);
					UTWinPutIndex(c, i, col);
				}
			}
			px++;
		}
		py++;
	}
}

I64 UTWinTextW(U8 *s, I64 size)
{
	if (!s)
		return 0;
	if (ut_ttf_ready && grf_ready && grf_ui_font.ok)
		return GrFontWidth(&grf_ui_font, size, s);
	if (ut_ufont_ready && ut_font_ui.ready)
		return UTFontTextW(&ut_font_ui, s);
	return StrLen(s) * FONT_WIDTH;
}

U0 UTWinDrawTextSized(U8 *s, I64 size)
{//DrawText at CurX/CurY. TTF first, optional UFont, then 8x8.
	CUTFont *f;
	CUTFontChar *g;
	CUTFontPage *page;
	CDC *fdc;
	I64 x;
	I64 y;
	I64 col;
	I64 w;
	I64 adv;

	if (!s || !ut_win.fb)
		return;
	col = ut_win.color;
	x = ut_win.org_x + ut_win.cur_x;
	y = ut_win.org_y + ut_win.cur_y;
	if (size < 8)
		size = 8;

	if (ut_win.center)
	{
		w = UTWinTextW(s, size);
		x = (ut_win.fb->width - w) / 2;
	}

	if (ut_ttf_ready && grf_ready && grf_ui_font.ok)
	{
		fdc = GrFontRenderCovDC(&grf_ui_font, size, 0xFFFFFF, s);
		if (fdc)
		{
			UTWinBlitCov(fdc, x, y, col);
			adv = fdc->width + ut_win.space_x;
			ut_win.cur_x += adv;
			DCDel(fdc);
			return;
		}
	}

	f = ut_win.font;
	if (f && f->ready)
	{
		while (*s)
		{
			g = UTFontGlyph(f, *s, &page);
			if (g && page)
			{
				UTWinPlotGlyph(page, g, x, y, col);
				x += g->u_size + ut_win.space_x;
				ut_win.cur_x += g->u_size + ut_win.space_x;
			}
			else
			{
				x += 6;
				ut_win.cur_x += 6;
			}
			s++;
		}
		return;
	}

	while (*s)
	{
		UTWinPlotSysChar(x, y, *s, col);
		x += FONT_WIDTH;
		ut_win.cur_x += FONT_WIDTH;
		s++;
	}
}

U0 UTWinDrawText(U8 *s)
{
	UTWinDrawTextSized(s, ut_win.font_px);
}

U0 UTWinTextAt(I64 x, I64 y, U8 *s, I64 col)
{
	UTWinSetPos(x, y);
	UTWinSetColor(col);
	ut_win.font_px = ut_ttf_px;
	UTWinDrawText(s);
}

U0 UTWinTextAtBig(I64 x, I64 y, U8 *s, I64 col)
{
	UTWinSetPos(x, y);
	UTWinSetColor(col);
	ut_win.font_px = ut_ttf_px_big;
	UTWinDrawTextSized(s, ut_ttf_px_big);
	ut_win.font_px = ut_ttf_px;
}

U0 UTWinDrawBevel(I64 x, I64 y, I64 w, I64 h, Bool raised)
{//raised = button face; sunk = edit/list.
	I64 hi;
	I64 lo;

	if (w < 2 || h < 2)
		return;
	if (raised)
	{
		hi = ut_col_laf_hi;
		lo = ut_col_laf_lo;
	}
	else
	{
		hi = ut_col_laf_lo;
		lo = ut_col_laf_hi;
	}
	UTWinFill(x, y, w, 1, hi);
	UTWinFill(x, y, 1, h, hi);
	UTWinFill(x, y + h - 1, w, 1, lo);
	UTWinFill(x + w - 1, y, 1, h, lo);
}

U0 UTWinDrawLAFFrame(I64 x, I64 y, I64 w, I64 h, U8 *title)
{//Debug SoftDrv LAF chrome (ut_menu_fake_laf). Not UWindow Paint.
	I64 th;
	I64 i;
	I64 shade;

	if (w < 40 || h < 40)
		return;
	th = 14;
	UTWinFill(x, y, w, h, ut_col_laf_lo);
	UTWinFill(x + 1, y + 1, w - 2, h - 2, ut_col_laf_face);
	i = 0;
	while (i < th)
	{
		if (i < th / 2)
			shade = ut_col_laf_title;
		else
			shade = ut_col_laf_title2;
		UTWinFill(x + 2, y + 2 + i, w - 4, 1, shade);
		i++;
	}
	if (title)
		UTWinTextAt(x + 6, y + 3, title, ut_col_white);
	UTWinFill(x + w - 16, y + 3, 11, 11, ut_col_laf_face);
	UTWinDrawBevel(x + w - 16, y + 3, 11, 11, TRUE);
	UTWinTextAt(x + w - 14, y + 4, "X", ut_col_label);
	UTWinFill(x + 3, y + 2 + th, w - 6, h - th - 5, ut_col_laf_client);
	UTWinDrawBevel(x + 3, y + 2 + th, w - 6, h - th - 5, FALSE);
}

U0 UTWinDrawButton(I64 x, I64 y, I64 w, I64 h, U8 *label, Bool hot)
{
	I64 tw;

	UTWinFill(x, y, w, h, ut_col_laf_face);
	UTWinDrawBevel(x, y, w, h, TRUE);
	if (hot)
		UTWinFill(x + 2, y + 2, w - 4, h - 4, ut_col_sel);
	if (label)
	{
		tw = UTWinTextW(label, ut_ttf_px);
		UTWinTextAt(x + (w - tw) / 2, y + (h - ut_ttf_px) / 2,
			label, ut_col_label);
	}
}

U0 UTWinDrawCombo(I64 x, I64 y, I64 w, I64 h, U8 *text, Bool hot)
{
	UTWinFill(x, y, w, h, ut_col_edit);
	UTWinDrawBevel(x, y, w, h, FALSE);
	if (hot)
		UTWinFill(x + 1, y + 1, w - 14, h - 2, ut_col_sel);
	if (text)
		UTWinTextAt(x + 4, y + (h - ut_ttf_px) / 2, text,
			ut_col_label);
	UTWinFill(x + w - 13, y + 1, 12, h - 2, ut_col_laf_face);
	UTWinDrawBevel(x + w - 13, y + 1, 12, h - 2, TRUE);
	UTWinTextAt(x + w - 11, y + (h - ut_ttf_px) / 2, "v", ut_col_label);
}

U0 UTWinDrawTab(I64 x, I64 y, I64 w, I64 h, U8 *label, Bool selected)
{
	if (selected)
	{
		UTWinFill(x, y, w, h + 2, ut_col_laf_client);
		UTWinFill(x, y, w, 1, ut_col_laf_hi);
		UTWinFill(x, y, 1, h + 2, ut_col_laf_hi);
		UTWinFill(x + w - 1, y, 1, h + 2, ut_col_laf_lo);
	}
	else
	{
		UTWinFill(x, y + 2, w, h, ut_col_laf_face);
		UTWinDrawBevel(x, y + 2, w, h, TRUE);
	}
	if (label)
		UTWinTextAt(x + 6, y + 4, label, ut_col_label);
}

U0 UTWinDrawListBox(I64 x, I64 y, I64 w, I64 h)
{
	UTWinFill(x, y, w, h, ut_col_edit);
	UTWinDrawBevel(x, y, w, h, FALSE);
}

U0 UTWinDrawDesktop()
{//UMenu root: MenuGr rmetal + large embossed U (epic/logo2)
	CUTCanvas *c;
	I64 shade;
	I64 i;
	I64 band;
	I64 uw;
	I64 uh;
	CUTTex *ulo;

	c = ut_win.fb;
	if (!c)
		return;
	UTWinFill(0, 0, c->width, c->height, ut_col_black);
	if (ut_win_metal_ok)
		UTWinDrawTileStretched(&ut_win_metal, 0, 0, c->width, c->height);
	else
	{
		band = c->height / 3;
		if (band < 1)
			band = 1;
		i = 0;
		while (i < c->height)
		{
			if (i < band)
				shade = ut_col_blue2;
			else if (i < band * 2)
				shade = ut_col_blue1;
			else
				shade = ut_col_panel;
			UTWinFill(0, i, c->width, 1, shade);
			i++;
		}
	}
	ulo = NULL;
	if (ut_win_ulogo_ok)
		ulo = &ut_win_ulogo;
	else if (ut_win_logo_ok)
		ulo = &ut_win_logo;
	if (ulo)
	{
		uw = c->width * 2 / 3;
		uh = c->height * 2 / 3;
		UTWinDrawTileStretched(ulo,
			(c->width - uw) / 2, (c->height - uh) / 2 - 8, uw, uh);
	}
}

U8		ut_msg_text[96];
F64		ut_msg_until	= 0.0;
#define UT_KILLFEED_N		5
U8		ut_killfeed[UT_KILLFEED_N][72];
F64		ut_killfeed_t[UT_KILLFEED_N];
I64		ut_killfeed_n	= 0;

U0 UTMsgCenter(U8 *s)
{//ChallengeHUD LocalizedMessage center-print host.
	I64 i;

	if (!s)
		return;
	StrPrint(ut_msg_text, "%s", s);
	ut_msg_until = tS + 2.8;
	if (ut_killfeed_n < UT_KILLFEED_N)
	{
		StrPrint(ut_killfeed[ut_killfeed_n], "%s", s);
		ut_killfeed_t[ut_killfeed_n] = tS + 6.0;
		ut_killfeed_n++;
	}
	else
	{
		i = 0;
		while (i < UT_KILLFEED_N - 1)
		{
			StrPrint(ut_killfeed[i], "%s", ut_killfeed[i + 1]);
			ut_killfeed_t[i] = ut_killfeed_t[i + 1];
			i++;
		}
		StrPrint(ut_killfeed[UT_KILLFEED_N - 1], "%s", s);
		ut_killfeed_t[UT_KILLFEED_N - 1] = tS + 6.0;
	}
}

U0 UTMsgDraw(CUTCanvas *c)
{
	I64 tw;
	I64 i;
	I64 y;

	if (!c || !ut_win_ready)
		return;
	ut_win.fb = c;
	if (tS < ut_msg_until && ut_msg_text[0])
	{
		tw = UTWinTextW(ut_msg_text, ut_ttf_px);
		if (tw < 1)
			tw = StrLen(ut_msg_text) * 6;
		UTWinTextAt((c->width - tw) / 2, c->height / 3, ut_msg_text, ut_col_sel);
	}
	y = 90;
	i = 0;
	while (i < ut_killfeed_n)
	{
		if (tS < ut_killfeed_t[i] && ut_killfeed[i][0])
		{
			UTWinTextAt(8, y, ut_killfeed[i], ut_col_dim);
			y += 12;
		}
		i++;
	}
}
