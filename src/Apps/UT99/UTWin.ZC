// UTWin.ZC - UCanvas SoftDrv path (UWindow / Engine Canvas natives).
//
// SoftDrv stays the framebuffer. DrawTile / DrawText write P8 indices.
// Upstream: Engine/Inc/UnCamera.h UCanvas. LookAndFeel art from MenuGr.utx.

class CUTWinCanvas
{
	CUTCanvas	*fb;
	CUTFont		*font;
	I64			 cur_x;
	I64			 cur_y;
	I64			 org_x;
	I64			 org_y;
	I64			 clip_x;
	I64			 clip_y;
	I64			 color;		//SoftDrv palette index
	I64			 space_x;
	I64			 space_y;
	Bool		 center;
};

CUTWinCanvas ut_win;
Bool         ut_win_ready = FALSE;

// Retail MenuGr tiles for root chrome
CUTTex	ut_win_logo;
CUTTex	ut_win_metal;
Bool	ut_win_logo_ok	= FALSE;
Bool	ut_win_metal_ok	= FALSE;

U0 UTWinInit(CUTCanvas *fb)
{
	if (ut_win_logo_ok)
		UTTexFreeMips(&ut_win_logo);
	if (ut_win_metal_ok)
		UTTexFreeMips(&ut_win_metal);
	ut_win_logo_ok = FALSE;
	ut_win_metal_ok = FALSE;
	MemSet(&ut_win, 0, sizeof(CUTWinCanvas));
	ut_win.fb = fb;
	ut_win.font = &ut_font_ui;
	ut_win.color = ut_col_white;
	ut_win.clip_x = 320;
	ut_win.clip_y = 240;
	if (fb)
	{
		ut_win.clip_x = fb->width;
		ut_win.clip_y = fb->height;
	}
	UTTexInit(&ut_win_logo);
	UTTexInit(&ut_win_metal);
	if (FileFind("::/Apps/UT99/Textures/MenuGr.utx"))
	{
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"logo2", &ut_win_logo))
			ut_win_logo_ok = TRUE;
		if (UTTexLoadNamed("::/Apps/UT99/Textures/MenuGr.utx",
			"rmetal", &ut_win_metal))
			ut_win_metal_ok = TRUE;
	}
	ut_win_ready = fb != NULL;
	UTLog("UTWin: canvas=%d font=%d logo=%d metal=%d\n",
		ToI64(ut_win_ready), ToI64(ut_font_ready),
		ToI64(ut_win_logo_ok), ToI64(ut_win_metal_ok));
}

U0 UTWinExit()
{
	if (ut_win_logo_ok)
		UTTexFreeMips(&ut_win_logo);
	if (ut_win_metal_ok)
		UTTexFreeMips(&ut_win_metal);
	ut_win_logo_ok = FALSE;
	ut_win_metal_ok = FALSE;
	ut_win.fb = NULL;
	ut_win_ready = FALSE;
}

U0 UTWinReset()
{//UCanvas.Reset - origin/clip full framebuffer
	if (!ut_win.fb)
		return;
	ut_win.cur_x = 0;
	ut_win.cur_y = 0;
	ut_win.org_x = 0;
	ut_win.org_y = 0;
	ut_win.clip_x = ut_win.fb->width;
	ut_win.clip_y = ut_win.fb->height;
	ut_win.space_x = 0;
	ut_win.space_y = 0;
	ut_win.center = FALSE;
	ut_win.color = ut_col_white;
	ut_win.font = &ut_font_ui;
}

U0 UTWinSetPos(I64 x, I64 y)
{
	ut_win.cur_x = x;
	ut_win.cur_y = y;
}

U0 UTWinSetColor(I64 pal_idx)
{
	ut_win.color = pal_idx & 255;
}

U0 UTWinFill(I64 x, I64 y, I64 w, I64 h, I64 col)
{
	CUTCanvas *c;
	I64 px;
	I64 py;
	I64 x2;
	I64 y2;
	I64 i;

	c = ut_win.fb;
	if (!c || w < 1 || h < 1)
		return;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	py = y;
	while (py < y2)
	{
		px = x;
		while (px < x2)
		{
			i = py * c->width + px;
			c->pixels[i] = col;
			px++;
		}
		py++;
	}
}

U0 UTWinDrawTile(CUTTex *tex, I64 x, I64 y, I64 w, I64 h,
	I64 u0, I64 v0, I64 uw, I64 vh)
{//UCanvas.DrawTile - screen-aligned SoftDrv blit, index0 masked
	CUTCanvas *c;
	I64 px;
	I64 py;
	I64 x2;
	I64 y2;
	I64 sx;
	I64 sy;
	I64 tw;
	I64 th;
	I64 texel;
	I64 i;

	c = ut_win.fb;
	if (!c || !tex || !tex->mips[0].pixels || w < 1 || h < 1)
		return;
	tw = tex->u_size;
	th = tex->v_size;
	if (tw < 1 || th < 1)
		return;
	if (uw < 1) uw = tw;
	if (vh < 1) vh = th;
	x2 = x + w;
	y2 = y + h;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x2 > c->width) x2 = c->width;
	if (y2 > c->height) y2 = c->height;
	py = y;
	while (py < y2)
	{
		sy = v0 + (py - y) * vh / h;
		px = x;
		while (px < x2)
		{
			sx = u0 + (px - x) * uw / w;
			texel = UTTexSample(tex, sx, sy);
			if (texel)
			{
				i = py * c->width + px;
				c->pixels[i] = texel;
			}
			px++;
		}
		py++;
	}
}

U0 UTWinDrawTileStretched(CUTTex *tex, I64 x, I64 y, I64 w, I64 h)
{
	if (!tex)
		return;
	UTWinDrawTile(tex, x, y, w, h, 0, 0, tex->u_size, tex->v_size);
}

U0 UTWinPlotGlyph(CUTFontPage *page, CUTFontChar *g, I64 dx, I64 dy, I64 col)
{//glyph mask: non-zero texel → Canvas.Color (SoftDrv index)
	CUTCanvas *c;
	I64 x;
	I64 y;
	I64 sx;
	I64 sy;
	I64 i;
	I64 texel;

	c = ut_win.fb;
	if (!c || !page || !g || !page->tex_ok)
		return;
	if (g->u_size < 1 || g->v_size < 1)
		return;
	y = 0;
	while (y < g->v_size)
	{
		sy = g->start_v + y;
		x = 0;
		while (x < g->u_size)
		{
			sx = g->start_u + x;
			texel = UTTexSample(&page->tex, sx, sy);
			if (texel)
			{
				if (dx + x >= 0 && dy + y >= 0 &&
					dx + x < c->width && dy + y < c->height)
				{
					i = (dy + y) * c->width + (dx + x);
					c->pixels[i] = col;
				}
			}
			x++;
		}
		y++;
	}
}

U0 UTWinDrawText(U8 *s)
{//UCanvas.DrawText at CurX/CurY with Font + Color
	CUTFont *f;
	CUTFontChar *g;
	CUTFontPage *page;
	I64 x;
	I64 y;
	I64 col;
	I64 w;

	if (!s || !ut_win.fb)
		return;
	f = ut_win.font;
	col = ut_win.color;
	x = ut_win.org_x + ut_win.cur_x;
	y = ut_win.org_y + ut_win.cur_y;
	if (ut_win.center && f)
	{
		w = UTFontTextW(f, s);
		x = (ut_win.fb->width - w) / 2;
	}
	if (!f || !f->ready)
	{
		//no UFont: solid bars per char (SoftDrv DIY demoted)
		while (*s)
		{
			UTWinFill(x, y, 5, 8, col);
			x += 6;
			ut_win.cur_x += 6;
			s++;
		}
		return;
	}
	while (*s)
	{
		g = UTFontGlyph(f, *s, &page);
		if (g && page)
		{
			UTWinPlotGlyph(page, g, x, y, col);
			x += g->u_size + ut_win.space_x;
			ut_win.cur_x += g->u_size + ut_win.space_x;
		}
		else
		{
			x += 6;
			ut_win.cur_x += 6;
		}
		s++;
	}
}

U0 UTWinTextAt(I64 x, I64 y, U8 *s, I64 col)
{
	UTWinSetPos(x, y);
	UTWinSetColor(col);
	UTWinDrawText(s);
}

U0 UTWinDrawDesktop()
{//UWindow root chrome: MenuGr metal + logo
	CUTCanvas *c;
	I64 shade;
	I64 i;

	c = ut_win.fb;
	if (!c)
		return;
	UTWinFill(0, 0, c->width, c->height, ut_col_black);
	if (ut_win_metal_ok)
		UTWinDrawTileStretched(&ut_win_metal, 0, 0, c->width, c->height);
	else
	{
		i = 0;
		while (i < c->height)
		{
			shade = 4 + (i * 12) / c->height;
			UTWinFill(0, i, c->width, 1, shade);
			i++;
		}
	}
	if (ut_win_logo_ok)
		UTWinDrawTileStretched(&ut_win_logo,
			(c->width - 240) / 2, 4, 240, 36);
}
