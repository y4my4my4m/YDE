// UTTest.ZC - data-layer self checks. Run UTTest; after quitting the shell.

U0 UTTestFmt()
{
	U8	buf[4];
	U8	idx_buf[8];
	I64	pos;
	CUTArc ar;
	I64	v;
	F64	f;

	"$$LTBLUE$$--- UTFmt ---$$FG$$\n";

	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x80; buf[3] = 0x3F;
	f = UTRdF32(buf);
	"  1.0f       -> %8.5f  expect 1.00000\n", f;

	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0xC0;
	f = UTRdF32(buf);
	"  -2.5f      -> %8.5f  expect -2.50000\n", f;

	pos = 0;
	UTArcIndexWrite(idx_buf, &pos, 0);
	UTArcIndexWrite(idx_buf, &pos, 63);
	UTArcIndexWrite(idx_buf, &pos, 64);
	UTArcIndexWrite(idx_buf, &pos, -1);
	UTArcIndexWrite(idx_buf, &pos, 127);
	UTArcInit(&ar, idx_buf, pos);
	v = UTArcIndex(&ar); "  idx 0   -> %d expect 0\n", v;
	v = UTArcIndex(&ar); "  idx 63  -> %d expect 63\n", v;
	v = UTArcIndex(&ar); "  idx 64  -> %d expect 64\n", v;
	v = UTArcIndex(&ar); "  idx -1  -> %d expect -1\n", v;
	v = UTArcIndex(&ar); "  idx 127 -> %d expect 127\n", v;
}

U0 UTTestMath()
{
	F64 a[3];
	F64 b[3];
	F64 c[3];
	F64 x[3];
	F64 y[3];
	F64 z[3];
	U32 packed;
	F64 unpacked[3];

	"$$LTBLUE$$--- UTMath ---$$FG$$\n";

	UTVecSet(a, 3.0, 0.0, 0.0);
	UTVecSet(b, 0.0, 4.0, 0.0);
	UTVecAdd(a, b, c);
	"  add       -> %4.1f %4.1f %4.1f  expect 3.0 4.0 0.0\n",
		c[0], c[1], c[2];
	"  length 3-4-0 -> %4.1f expect 5.0\n", UTVecLength(c);

	UTGetAxes(0, 0, 0, x, y, z);
	"  axes0 X   -> %5.2f %5.2f %5.2f  expect 1 0 0\n", x[0], x[1], x[2];
	"  axes0 Y   -> %5.2f %5.2f %5.2f  expect 0 1 0\n", y[0], y[1], y[2];
	"  axes0 Z   -> %5.2f %5.2f %5.2f  expect 0 0 1\n", z[0], z[1], z[2];

	//90 deg yaw = 16384 rotator units
	UTGetAxes(0, 16384, 0, x, y, z);
	"  yaw90 X   -> %5.2f %5.2f %5.2f  expect 0 1 0\n", x[0], x[1], x[2];

	packed = UTMeshVertPack(10.0, -20.0, 30.0);
	UTMeshVertUnpack(packed, unpacked);
	"  meshvert  -> %4.0f %4.0f %4.0f  expect 10 -20 30\n",
		unpacked[0], unpacked[1], unpacked[2];

	"  deg2rot 90 -> %d expect 16384\n", UTDegToRot(90.0);
}

U0 UTTestMesh()
{
	U8		buf[20];
	CUTMeshTri t;
	CUTMeshTri u;

	"$$LTBLUE$$--- UTMesh ---$$FG$$\n";
	t.i_vert[0] = 1; t.i_vert[1] = 2; t.i_vert[2] = 3;
	t.u[0] = 10; t.v[0] = 20;
	t.u[1] = 30; t.v[1] = 40;
	t.u[2] = 50; t.v[2] = 60;
	t.poly_flags = 0x12345678;
	t.texture_index = 7;
	UTMeshTriWrite(buf, &t);
	UTMeshTriRead(buf, &u);
	"  tri verts %d %d %d  expect 1 2 3\n",
		u.i_vert[0], u.i_vert[1], u.i_vert[2];
	"  tri flags %08X expect 12345678\n", u.poly_flags;
	"  tri tex   %d expect 7\n", u.texture_index;
	"  demo tris %d verts %d\n",
		ut_demo_mesh.num_tris, ut_demo_mesh.num_verts;
}

U0 UTTestPkg(U8 *path)
{
	CUTPackage *pkg;

	"$$LTBLUE$$--- UTPkg %s ---$$FG$$\n", path;
	if (!FileFind(path))
	{
		"  file absent (drop a .u/.utx/.unr here to exercise the loader)\n";
		return;
	}
	pkg = UTPkgLoad(path);
	if (!pkg)
	{
		"  load FAILED\n";
		return;
	}
	UTPkgReport(pkg);
	UTPkgFree(pkg);
}

U0 UTTestSoft()
{
	CUTCanvas *c;
	U8 stats[128];
	CUTSpanBuf sb;
	I64 x1;
	I64 x2;

	"$$LTBLUE$$--- UTSoft (CPU SoftDrv) ---$$FG$$\n";

	c = UTDrawNew(64, 48);
	if (!c)
	{
		"  canvas FAILED\n";
		return;
	}
	UTTexDemoInit;
	UTSoftInit(c);
	UTSoftLock(UT_LOCKR_CLEAR_SCREEN, 0);
	UTSoftDrawTile(&ut_tex_checker, 8, 8, 16, 16, 0.0, 0.0, 64.0, 64.0, 4.0);
	UTSoftDraw2DLine(0, 0, 63, 47, 255);
	UTSoftGetStats(stats, 128);
	"  %s\n", stats;
	if (ut_soft.span_based)
		"  span_based=1 (SoftDrv)\n";
	else
		"  span_based=0 (unexpected)\n";
	UTSoftUnlock;
	UTSoftExit;

	UTSpanClear(&sb, 64, 1);
	x1 = 10; x2 = 50;
	if (UTSpanClip(&sb, 0, &x1, &x2))
		"  span clip [10,50) -> [%d,%d)\n", x1, x2;
	UTSpanPunch(&sb, 0, 20, 40);
	x1 = 0; x2 = 64;
	if (UTSpanClip(&sb, 0, &x1, &x2))
		"  after punch first open starts %d\n", x1;
	"  open pixels %d (expect 44)\n", UTSpanOpenCount(&sb);

	UTDrawFree(c);
	UTTexDemoFree;
}

U0 UTTestMap()
{
	CUTPackage *pkg;
	I64 mi;
	CUTBsp *b;

	"$$LTBLUE$$--- UTMap Model1 ---$$FG$$\n";
	if (!FileFind("::/Apps/UT99/Maps/DM-Codex.unr"))
	{
		"  DM-Codex.unr absent\n";
		return;
	}
	pkg = UTPkgLoad("::/Apps/UT99/Maps/DM-Codex.unr");
	if (!pkg)
	{
		"  package load FAILED\n";
		return;
	}
	mi = UTPkgFindExport(pkg, "Model", "Model1");
	"  Model1 export %d\n", mi;
	b = UTBspNew;
	if (mi >= 0 && UTBspLoadModel(pkg, mi, b))
		"  nodes=%d points=%d surfs=%d verts=%d\n",
			b->num_nodes, b->num_points, b->num_surfs, b->num_verts;
	else
		"  Model1 decode FAILED\n";
	UTBspFree(b);
	UTPkgFree(pkg);
}

U0 UTTest()
{
	UTLogInit;
	UTPalInit;
	UTMeshDemoInit;
	UTTestFmt;
	UTTestMath;
	UTTestMesh;
	UTTestSoft;
	UTTestPkg("::/Apps/UT99/System/Engine.u");
	UTTestPkg("::/Apps/UT99/Textures/UWindowFonts.utx");
	UTTestPkg("::/Apps/UT99/Maps/DM-Codex.unr");
	UTTestPkg("::/Apps/UT99/data/test.u");
	UTTestMap;
	"\nUTTest done.\n";
}
