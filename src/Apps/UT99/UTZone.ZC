// ZoneInfo / WaterZone / LavaZone / SlimeZone / WarpZoneInfo.
// SoftDrv Location + radius samples. WarpZoneInfo: OtherSideURL↔ThisTag.
// WarpCoords: Rotation→axes (engine const Coords stand-in). Child frame =
// UnRender CreateChildFrame Coords * Warp * Other.Transpose().

#define UT_ZONE_MAX			64
#define UT_ZONE_KIND_NORMAL	0
#define UT_ZONE_KIND_WATER	1
#define UT_ZONE_KIND_LAVA	2
#define UT_ZONE_KIND_SLIME	3
#define UT_ZONE_KIND_WARP	4
#define UT_ZONE_KIND_SKY	5
#define UT_ZONE_KIND_VACUUM	6
#define UT_ZONE_KIND_PRESSURE	7

class CUTZone
{
	F64	 origin[3];
	F64	 gravity[3];
	F64	 radius;
	I64	 kind;
	Bool water;
	Bool active;
	U8	 tag[48];
	U8	 other_url[80];
	I64	 pair_i;
	F64	 cool_t;
	F64	 warp_x[3];		//WarpCoords axes (Rotation)
	F64	 warp_y[3];
	F64	 warp_z[3];
	F64	 damage_per_sec;
	F64	 velocity[3];	//ZoneVelocity push
	F64	 fog_dist;		//DistanceFog soft haze radius
};

CUTZone	ut_zones[UT_ZONE_MAX];
I64		ut_zone_n		= 0;
F64		ut_zone_gravity_z	= -950.0;
Bool	ut_zone_in_water	= FALSE;
Bool	ut_zone_in_hurt		= FALSE;
Bool	ut_zone_in_warp		= FALSE;
F64		ut_zone_push[3]		= {0, 0, 0};	//active ZoneVelocity
F64		ut_zone_fog		= 0.0;	//DistanceFogEnd soft haze
I64		ut_zone_hurt_kind	= 0;	//UT_ZONE_KIND_LAVA / SLIME when hurt
F64		ut_breath			= 20.0;	//underwater air seconds
Bool	ut_sky_ready		= FALSE;
I64		ut_sky_zone		= -1;	//BSP zone owned by SkyZoneInfo
F64		ut_sky_origin[3]	= {0, 0, 0};
I64		ut_sky_nests		= 0;

//CreateChildFrame save stack
F64		ut_zone_cf_org[3];
F64		ut_zone_cf_fwd[3];
F64		ut_zone_cf_right[3];
F64		ut_zone_cf_up[3];
Bool	ut_zone_cf_pushed	= FALSE;

U0 UTZoneClear()
{
	I64 zk;

	ut_zone_n = 0;
	zk = 0;
	while (zk < UT_MAX_ZONES)
	{
		ut_zone_amb_r[zk] = 0.0;
		ut_zone_amb_g[zk] = 0.0;
		ut_zone_amb_b[zk] = 0.0;
		zk++;
	}
	ut_zone_gravity_z = -950.0;
	ut_zone_in_water = FALSE;
	ut_zone_in_hurt = FALSE;
	ut_zone_in_warp = FALSE;
	ut_zone_hurt_kind = 0;
	ut_zone_push[0] = 0;
	ut_zone_push[1] = 0;
	ut_zone_push[2] = 0;
	ut_zone_fog = 0.0;
	ut_breath = 20.0;
	ut_zone_cf_pushed = FALSE;
	ut_sky_ready = FALSE;
	ut_sky_zone = -1;
	ut_sky_nests = 0;
	ut_sky_origin[0] = 0;
	ut_sky_origin[1] = 0;
	ut_sky_origin[2] = 0;
}

U0 UTZoneIdentAxes(CUTZone *z)
{
	if (!z)
		return;
	z->warp_x[0] = 1; z->warp_x[1] = 0; z->warp_x[2] = 0;
	z->warp_y[0] = 0; z->warp_y[1] = 1; z->warp_y[2] = 0;
	z->warp_z[0] = 0; z->warp_z[1] = 0; z->warp_z[2] = 1;
}

I64 UTZoneKindFromClass(U8 *cls)
{
	if (!cls)
		return -1;
	if (!StrCompare(cls, "WaterZone"))
		return UT_ZONE_KIND_WATER;
	if (!StrCompare(cls, "LavaZone"))
		return UT_ZONE_KIND_LAVA;
	if (!StrCompare(cls, "SlimeZone"))
		return UT_ZONE_KIND_SLIME;
	if (!StrCompare(cls, "WarpZoneInfo"))
		return UT_ZONE_KIND_WARP;
	if (!StrCompare(cls, "SkyZoneInfo"))
		return UT_ZONE_KIND_SKY;
	if (!StrCompare(cls, "VacuumZone") || !StrCompare(cls, "NitrogenZone"))
		return UT_ZONE_KIND_VACUUM;
	if (!StrCompare(cls, "PressureZone"))
		return UT_ZONE_KIND_PRESSURE;
	if (!StrCompare(cls, "ZoneInfo") || !StrCompare(cls, "LevelInfo"))
		return UT_ZONE_KIND_NORMAL;
	return -1;
}

U0 UTZonePairWarps()
{//= WarpZoneInfo.ForceGenerate local OtherSideURL ↔ ThisTag.
	I64 i;
	I64 j;
	CUTZone *a;
	CUTZone *b;

	i = 0;
	while (i < ut_zone_n)
	{
		a = &ut_zones[i];
		a->pair_i = -1;
		if (a->kind == UT_ZONE_KIND_WARP && a->other_url[0])
		{
			j = 0;
			while (j < ut_zone_n)
			{
				b = &ut_zones[j];
				if (j != i && b->kind == UT_ZONE_KIND_WARP &&
					b->tag[0] && !StrCompare(b->tag, a->other_url))
				{
					a->pair_i = j;
					break;
				}
				j++;
			}
		}
		i++;
	}
}

U0 UTZoneWarpPoint(CUTZone *from, CUTZone *to, F64 *pin, F64 *pout)
{//= AWarpZoneInfo::UnWarp then Other.Warp (Coords transpose).
	F64 rel[3];
	F64 lx;
	F64 ly;
	F64 lz;

	if (!from || !to || !pin || !pout)
		return;
	rel[0] = pin[0] - from->origin[0];
	rel[1] = pin[1] - from->origin[1];
	rel[2] = pin[2] - from->origin[2];
	lx = rel[0] * from->warp_x[0] + rel[1] * from->warp_x[1] +
		rel[2] * from->warp_x[2];
	ly = rel[0] * from->warp_y[0] + rel[1] * from->warp_y[1] +
		rel[2] * from->warp_y[2];
	lz = rel[0] * from->warp_z[0] + rel[1] * from->warp_z[1] +
		rel[2] * from->warp_z[2];
	pout[0] = to->origin[0] + lx * to->warp_x[0] + ly * to->warp_y[0] +
		lz * to->warp_z[0];
	pout[1] = to->origin[1] + lx * to->warp_x[1] + ly * to->warp_y[1] +
		lz * to->warp_z[1];
	pout[2] = to->origin[2] + lx * to->warp_x[2] + ly * to->warp_y[2] +
		lz * to->warp_z[2];
}

U0 UTZoneWarpVec(CUTZone *from, CUTZone *to, F64 *vin, F64 *vout)
{//direction through WarpCoords (no origin).
	F64 lx;
	F64 ly;
	F64 lz;

	if (!from || !to || !vin || !vout)
		return;
	lx = vin[0] * from->warp_x[0] + vin[1] * from->warp_x[1] +
		vin[2] * from->warp_x[2];
	ly = vin[0] * from->warp_y[0] + vin[1] * from->warp_y[1] +
		vin[2] * from->warp_y[2];
	lz = vin[0] * from->warp_z[0] + vin[1] * from->warp_z[1] +
		vin[2] * from->warp_z[2];
	vout[0] = lx * to->warp_x[0] + ly * to->warp_y[0] + lz * to->warp_z[0];
	vout[1] = lx * to->warp_x[1] + ly * to->warp_y[1] + lz * to->warp_z[1];
	vout[2] = lx * to->warp_x[2] + ly * to->warp_y[2] + lz * to->warp_z[2];
}

I64 UTZoneFindWarpNear(F64 *org)
{
	I64 i;
	I64 best;
	F64 best_d;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	CUTZone *z;

	best = -1;
	best_d = 1e30;
	if (!org)
		return -1;
	i = 0;
	while (i < ut_zone_n)
	{
		z = &ut_zones[i];
		if (z->active && z->kind == UT_ZONE_KIND_WARP && z->pair_i >= 0)
		{
			dx = org[0] - z->origin[0];
			dy = org[1] - z->origin[1];
			dz = org[2] - z->origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < z->radius * z->radius * 4.0 && d2 < best_d)
			{
				best_d = d2;
				best = i;
			}
		}
		i++;
	}
	return best;
}

I64 UTZoneWarpPair(I64 from_i)
{
	if (from_i < 0 || from_i >= ut_zone_n)
		return -1;
	return ut_zones[from_i].pair_i;
}

U0 UTZoneChildFramePush(CUTCanvas *c, I64 from_i, I64 to_i, F64 *eye)
{//= CreateChildFrame Coords warp for SoftDrv nest eye + canvas axes.
	CUTZone *from;
	CUTZone *to;
	F64 nfwd[3];
	F64 nright[3];
	F64 nup[3];
	F64 neye[3];

	if (!c || !eye || from_i < 0 || to_i < 0)
		return;
	if (from_i >= ut_zone_n || to_i >= ut_zone_n)
		return;
	from = &ut_zones[from_i];
	to = &ut_zones[to_i];
	UTVecCopy(c->origin, ut_zone_cf_org);
	UTVecCopy(c->forward, ut_zone_cf_fwd);
	UTVecCopy(c->right, ut_zone_cf_right);
	UTVecCopy(c->up, ut_zone_cf_up);
	UTZoneWarpPoint(from, to, eye, neye);
	UTZoneWarpVec(from, to, c->forward, nfwd);
	UTZoneWarpVec(from, to, c->right, nright);
	UTZoneWarpVec(from, to, c->up, nup);
	UTVecNormalize(nfwd);
	UTVecNormalize(nright);
	UTVecNormalize(nup);
	UTVecCopy(neye, eye);
	UTVecCopy(neye, c->origin);
	UTVecCopy(nfwd, c->forward);
	UTVecCopy(nright, c->right);
	UTVecCopy(nup, c->up);
	ut_zone_cf_pushed = TRUE;
}

U0 UTZoneChildFramePop(CUTCanvas *c, F64 *eye)
{
	if (!c || !ut_zone_cf_pushed)
		return;
	UTVecCopy(ut_zone_cf_org, c->origin);
	UTVecCopy(ut_zone_cf_fwd, c->forward);
	UTVecCopy(ut_zone_cf_right, c->right);
	UTVecCopy(ut_zone_cf_up, c->up);
	if (eye)
		UTVecCopy(ut_zone_cf_org, eye);
	ut_zone_cf_pushed = FALSE;
}

U0 UTZoneScanPackage(CUTPackage *pkg)
{
	I64 i;
	I64 kind;
	I64 zi;
	CUTExport *e;
	U8 *cls;
	F64 v[3];
	F64 g[3];
	CUTPropBag bag;
	CUTZone *z;
	F64 ax[3];
	F64 ay[3];
	F64 az[3];
	F64 ar;
	F64 ag;
	F64 ab;
	I64 zk;

	UTZoneClear;
	if (!pkg)
		return;
	i = 0;
	while (i < pkg->export_count && ut_zone_n < UT_ZONE_MAX)
	{
		e = &pkg->exports[i];
		cls = UTPkgClassName(pkg, e->class_index);
		kind = UTZoneKindFromClass(cls);
		if (kind >= 0)
		{
			UTVecSet(v, 0, 0, 0);
			UTPropFindStructVec(pkg, e->serial_offset, e->serial_size,
				"Location", v);
			zi = ut_zone_n;
			z = &ut_zones[zi];
			MemSet(z, 0, sizeof(CUTZone));
			UTVecCopy(v, z->origin);
			z->kind = kind;
			z->gravity[0] = 0; z->gravity[1] = 0; z->gravity[2] = -950.0;
			z->radius = 512.0;
			z->water = (kind == UT_ZONE_KIND_WATER);
			z->active = TRUE;
			z->pair_i = -1;
			z->cool_t = 0.0;
			UTZoneIdentAxes(z);
			UTPropBagInit(&bag);
			UTPropLoadBag(pkg, e->serial_offset, e->serial_size,
				e->object_flags, &bag);
			if (UTPropBagGetVec(&bag, "ZoneGravity", 0, g))
			{
				UTVecCopy(g, z->gravity);
				if (kind == UT_ZONE_KIND_NORMAL ||
					!StrCompare(cls, "LevelInfo"))
					ut_zone_gravity_z = g[2];
			}
			if (UTPropBagGetVec(&bag, "ZoneVelocity", 0, g))
				UTVecCopy(g, z->velocity);
			//FZoneProperties.ZoneActor points at this export; that ties a BSP zone
			//index to its ZoneInfo.
			if (!StrCompare(cls, "LevelInfo") && bag.level_bright > 0.0)
			{
				ut_level_bright = bag.level_bright;
				UTLog("UTZone: level brightness %.3f\n", ut_level_bright);
			}
			if (ut_bsp != NULL && bag.amb_bright > 0)
			{
				UTLightHueRGB(bag.amb_hue, bag.amb_sat, &ar, &ag, &ab);
				zk = 0;
				while (zk < ut_bsp->num_zones && zk < UT_MAX_ZONES)
				{
					if (ut_bsp->zone_actor[zk] == i + 1)
					{
						ut_zone_amb_r[zk] = ar * ToF64(bag.amb_bright);
						ut_zone_amb_g[zk] = ag * ToF64(bag.amb_bright);
						ut_zone_amb_b[zk] = ab * ToF64(bag.amb_bright);
					}
					zk++;
				}
			}
			z->fog_dist = 0.0;
			if (bag.fog_end > 1.0)
				z->fog_dist = bag.fog_end;
			if (bag.collision_radius > 1.0)
				z->radius = bag.collision_radius * 8.0;
			if (bag.b_water)
				z->water = TRUE;
			if (bag.tag_name[0])
				StrPrint(z->tag, "%s", bag.tag_name);
			if (bag.url_str[0])
				StrPrint(z->other_url, "%s", bag.url_str);
			z->damage_per_sec = 0.0;
			if (bag.damage_per_sec > 0.0)
				z->damage_per_sec = bag.damage_per_sec;
			else if (kind == UT_ZONE_KIND_VACUUM)
				z->damage_per_sec = 40.0;
			else if (kind == UT_ZONE_KIND_PRESSURE)
				z->damage_per_sec = 25.0;
			if (bag.has_rotation)
			{//= WarpCoords from actor Rotation
				UTGetAxes(bag.rotation[0], bag.rotation[1], bag.rotation[2],
					az, ax, ay);
				UTVecCopy(ax, z->warp_x);
				UTVecCopy(ay, z->warp_y);
				UTVecCopy(az, z->warp_z);
			}
			if (kind == UT_ZONE_KIND_WATER)
				z->water = TRUE;
			if (kind == UT_ZONE_KIND_SKY)
			{
				UTVecCopy(z->origin, ut_sky_origin);
				ut_sky_ready = TRUE;
				//FZoneProperties.ZoneActor points back at this export; that ties the
				//SkyZoneInfo to a BSP zone index.
				if (ut_bsp != NULL)
				{
					zk = 0;
					while (zk < ut_bsp->num_zones && zk < UT_MAX_ZONES)
					{
						if (ut_bsp->zone_actor[zk] == i + 1)
							ut_sky_zone = zk;
						zk++;
					}
				}
			}
			if (kind == UT_ZONE_KIND_WARP)
				z->radius = 256.0;
			ut_zone_n++;
		}
		i++;
	}
	UTZonePairWarps;
	UTLog("UTZone: %d zones gravZ=%4.0f sky=%d\n", ut_zone_n,
		ut_zone_gravity_z, ToI64(ut_sky_ready));
}

U0 UTZoneUpdatePlayer(F64 *org)
{
	I64 i;
	CUTZone *z;
	CUTZone *dst;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	F64 best;
	I64 best_i;
	F64 out[3];

	ut_zone_in_water = FALSE;
	ut_zone_in_hurt = FALSE;
	ut_zone_in_warp = FALSE;
	ut_zone_hurt_kind = 0;
	ut_zone_push[0] = 0;
	ut_zone_push[1] = 0;
	ut_zone_push[2] = 0;
	ut_zone_fog = 0.0;
	if (!org || ut_zone_n < 1)
		return;
	best = 1e30;
	best_i = -1;
	i = 0;
	while (i < ut_zone_n)
	{
		z = &ut_zones[i];
		if (z->active && z->kind != UT_ZONE_KIND_NORMAL)
		{
			dx = org[0] - z->origin[0];
			dy = org[1] - z->origin[1];
			dz = org[2] - z->origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < z->radius * z->radius && d2 < best)
			{
				best = d2;
				best_i = i;
			}
		}
		i++;
	}
	best = 1e30;
	i = 0;
	while (i < ut_zone_n)
	{
		z = &ut_zones[i];
		if (z->active &&
			(z->velocity[0] != 0.0 || z->velocity[1] != 0.0 ||
			 z->velocity[2] != 0.0 || z->fog_dist > 1.0))
		{
			dx = org[0] - z->origin[0];
			dy = org[1] - z->origin[1];
			dz = org[2] - z->origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < z->radius * z->radius && d2 < best)
			{
				best = d2;
				ut_zone_push[0] = z->velocity[0];
				ut_zone_push[1] = z->velocity[1];
				ut_zone_push[2] = z->velocity[2];
				ut_zone_fog = z->fog_dist;
			}
		}
		i++;
	}
	if (best_i < 0)
		return;
	z = &ut_zones[best_i];
	if (z->kind == UT_ZONE_KIND_WATER)
		ut_zone_in_water = TRUE;
	if (z->kind == UT_ZONE_KIND_LAVA || z->kind == UT_ZONE_KIND_SLIME ||
		z->kind == UT_ZONE_KIND_VACUUM || z->kind == UT_ZONE_KIND_PRESSURE)
	{
		ut_zone_in_hurt = TRUE;
		ut_zone_hurt_kind = z->kind;
	}
	if (z->gravity[2] != 0.0)
		ut_zone_gravity_z = z->gravity[2];
	if (z->kind == UT_ZONE_KIND_WARP && z->pair_i >= 0 &&
		z->pair_i < ut_zone_n && tS >= z->cool_t)
	{
		dst = &ut_zones[z->pair_i];
		UTZoneWarpPoint(z, dst, org, out);
		org[0] = out[0];
		org[1] = out[1];
		org[2] = out[2] + 40.0;
		z->cool_t = tS + 1.0;
		dst->cool_t = tS + 1.0;
		ut_zone_in_warp = TRUE;
		UTLog("UTZone: warp %s -> %s\n", z->tag, dst->tag);
	}
}

F64 UTZoneGravityMag()
{
	F64 g;

	g = ut_zone_gravity_z;
	if (g < 0.0)
		g = -g;
	if (g < 1.0)
		g = 950.0;
	return g;
}

I64 UTZoneHurtAt(F64 *org)
{//LAVA/SLIME kind when org is inside a hurt zone radius; else 0.
	I64 i;
	CUTZone *z;
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;

	if (!org)
		return 0;
	i = 0;
	while (i < ut_zone_n)
	{
		z = &ut_zones[i];
		if (z->active && (z->kind == UT_ZONE_KIND_LAVA ||
			z->kind == UT_ZONE_KIND_SLIME ||
			z->kind == UT_ZONE_KIND_VACUUM ||
			z->kind == UT_ZONE_KIND_PRESSURE))
		{
			dx = org[0] - z->origin[0];
			dy = org[1] - z->origin[1];
			dz = org[2] - z->origin[2];
			d2 = dx * dx + dy * dy + dz * dz;
			if (d2 < z->radius * z->radius)
				return z->kind;
		}
		i++;
	}
	return 0;
}
