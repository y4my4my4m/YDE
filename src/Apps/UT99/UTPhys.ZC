// UTPhys.ZC - cylinder collide, gravity, step-up against UModel BSP.
//
// Zone 0 volume solid + upward facet floors. Thin same-zone floors are not
// volumes — FloorZ heightfield. Not Epic's full extent trace.

#define UT_PHYS_RADIUS		30.0
#define UT_PHYS_HEIGHT		78.0		//cylinder height; Location = centre
#define UT_PHYS_EYE		27.0		//BaseEyeHeight — camera above Location
#define UT_PHYS_STEP		25.0
#define UT_PHYS_GRAVITY		650.0
#define UT_PHYS_MAX_FALL	1200.0
#define UT_PHYS_GROUND_EPS	2.0

F64	ut_velocity[3];
Bool	ut_on_ground	= FALSE;
F64	ut_phys_gravity	= UT_PHYS_GRAVITY;
F64	ut_floor_z		= 0.0;
Bool	ut_floor_hit	= FALSE;
F64	ut_fall_damage_pending	= 0.0;	//Landed impact → GameTakeDamage
Bool	ut_was_airborne		= FALSE;

extern I64	ut_snd_land_i;
extern U0	UTSndPlay(I64 slot, F64 vol);

U0 UTPhysInit()
{
	UTVecSet(ut_velocity, 0.0, 0.0, 0.0);
	ut_on_ground = FALSE;
	ut_phys_gravity = UT_PHYS_GRAVITY;
	ut_floor_z = 0.0;
	ut_floor_hit = FALSE;
	ut_fall_damage_pending = 0.0;
	ut_was_airborne = FALSE;
}

Bool UTPhysPointBlocked(CUTBsp *b, F64 *p)
{
	if (!b || b->num_nodes < 1)
		return FALSE;
	return UTBspPointSolid(b, p);
}

Bool UTPhysCylinderBlocked(CUTBsp *b, F64 *org)
{//sample centre + 4 radius offsets at feet and torso. Floor embed = blocked.
	F64 p[3];
	F64 r;
	I64 i;
	F64 ox[4];
	F64 oy[4];
	F64 fz;
	Bool hit;

	if (!b)
		return FALSE;
	r = UT_PHYS_RADIUS;
	ox[0] = r;  oy[0] = 0.0;
	ox[1] = -r; oy[1] = 0.0;
	ox[2] = 0.0; oy[2] = r;
	ox[3] = 0.0; oy[3] = -r;

	p[0] = org[0]; p[1] = org[1]; p[2] = org[2];
	if (UTPhysPointBlocked(b, p))
		return TRUE;
	p[2] = org[2] - UT_PHYS_HEIGHT * 0.5;
	if (UTPhysPointBlocked(b, p))
		return TRUE;

	fz = UTBspFloorZ(b, org[0], org[1], org[2] + 8.0, &hit);
	if (hit && org[2] - UT_PHYS_HEIGHT * 0.5 < fz - 1.0)
		return TRUE;

	i = 0;
	while (i < 4)
	{
		p[0] = org[0] + ox[i];
		p[1] = org[1] + oy[i];
		p[2] = org[2];
		if (UTPhysPointBlocked(b, p))
			return TRUE;
		p[2] = org[2] - UT_PHYS_HEIGHT * 0.4;
		if (UTPhysPointBlocked(b, p))
			return TRUE;
		i++;
	}
	return FALSE;
}

Bool UTPhysTryMove(CUTBsp *b, F64 *from, F64 *to)
{
	F64 try_p[3];
	F64 step[3];

	if (!b)
	{
		UTVecCopy(to, from);
		return TRUE;
	}
	UTVecCopy(to, try_p);
	if (!UTPhysCylinderBlocked(b, try_p))
	{
		UTVecCopy(try_p, from);
		return TRUE;
	}
	//step-up
	step[0] = to[0];
	step[1] = to[1];
	step[2] = to[2] + UT_PHYS_STEP;
	if (!UTPhysCylinderBlocked(b, step))
	{
		UTVecCopy(step, from);
		ut_on_ground = TRUE;
		return TRUE;
	}
	//slide XY
	try_p[0] = to[0];
	try_p[1] = from[1];
	try_p[2] = from[2];
	if (!UTPhysCylinderBlocked(b, try_p))
	{
		UTVecCopy(try_p, from);
		return TRUE;
	}
	try_p[0] = from[0];
	try_p[1] = to[1];
	try_p[2] = from[2];
	if (!UTPhysCylinderBlocked(b, try_p))
	{
		UTVecCopy(try_p, from);
		return TRUE;
	}
	return FALSE;
}

U0 UTPhysSnapToFloor(CUTBsp *b, F64 *org)
{//place cylinder centre so feet rest on highest floor under XY.
	F64 fz;
	Bool hit;

	if (!b || !org)
		return;
	fz = UTBspFloorZ(b, org[0], org[1], org[2] + 120.0, &hit);
	ut_floor_hit = hit;
	ut_floor_z = fz;
	if (hit)
	{
		org[2] = fz + UT_PHYS_HEIGHT * 0.5;
		ut_on_ground = TRUE;
		if (ut_velocity[2] < 0.0)
			ut_velocity[2] = 0.0;
	}
}

U0 UTPhysIntegrate(CUTBsp *b, F64 *org, F64 dt, F64 *wish_dir, F64 wish_speed)
{//wish_dir unit horizontal intent; gravity + move + floor snap.
	F64 dest[3];
	F64 wish_v[3];
	F64 fz;
	F64 feet;
	F64 impact;
	Bool hit;
	Bool was_air;

	if (dt < 0.0)
		dt = 0.0;
	if (dt > 0.1)
		dt = 0.1;

	was_air = !ut_on_ground;
	if (wish_speed > 0.0 && UTVecLength(wish_dir) > UT_SMALL_NUMBER)
	{
		wish_v[0] = wish_dir[0] * wish_speed;
		wish_v[1] = wish_dir[1] * wish_speed;
		wish_v[2] = 0.0;
		ut_velocity[0] = wish_v[0];
		ut_velocity[1] = wish_v[1];
	}
	else
	{
		ut_velocity[0] *= 0.8;
		ut_velocity[1] *= 0.8;
	}

	ut_velocity[2] -= ut_phys_gravity * dt;
	if (ut_velocity[2] < -UT_PHYS_MAX_FALL)
		ut_velocity[2] = -UT_PHYS_MAX_FALL;

	dest[0] = org[0] + ut_velocity[0] * dt;
	dest[1] = org[1] + ut_velocity[1] * dt;
	dest[2] = org[2] + ut_velocity[2] * dt;

	if (!UTPhysTryMove(b, org, dest))
	{
		dest[0] = org[0];
		dest[1] = org[1];
		dest[2] = org[2] + ut_velocity[2] * dt;
		if (!UTPhysTryMove(b, org, dest))
			ut_velocity[2] = 0.0;
	}

	//facet floor: thin BSP sheets between same zone
	fz = UTBspFloorZ(b, org[0], org[1], org[2] + 16.0, &hit);
	ut_floor_hit = hit;
	ut_floor_z = fz;
	feet = org[2] - UT_PHYS_HEIGHT * 0.5;
	if (hit && feet <= fz + UT_PHYS_GROUND_EPS)
	{
		org[2] = fz + UT_PHYS_HEIGHT * 0.5;
		//Landed: fall damage when impact speed past soft land (~750 uu/s)
		if ((was_air || ut_was_airborne) && ut_velocity[2] < -750.0)
		{
			impact = -ut_velocity[2] - 750.0;
			ut_fall_damage_pending += impact * 0.12;
			if (ut_snd_land_i >= 0)
				UTSndPlay(ut_snd_land_i, 0.7);
		}
		else if ((was_air || ut_was_airborne) && ut_velocity[2] < -200.0)
		{
			if (ut_snd_land_i >= 0)
				UTSndPlay(ut_snd_land_i, 0.45);
		}
		if (ut_velocity[2] < 0.0)
			ut_velocity[2] = 0.0;
		ut_on_ground = TRUE;
		ut_was_airborne = FALSE;
	}
	else
	{
		ut_on_ground = FALSE;
		ut_was_airborne = TRUE;
	}
}

U0 UTPhysJump()
{
	if (ut_on_ground || ut_zone_in_water)
	{
		if (ut_zone_in_water)
			ut_velocity[2] = 220.0;
		else
			ut_velocity[2] = 350.0;
		ut_on_ground = FALSE;
	}
}

Bool UTPhysTrace(CUTBsp *b, F64 *start, F64 *dir, F64 max_dist,
	F64 *hit_pos, F64 *hit_dist)
{//UnTrace stand-in: walk ray in steps against UModel solid. Not Epic extent.
	F64 p[3];
	F64 step;
	F64 d;
	F64 len;
	F64 nd[3];

	if (hit_dist)
		*hit_dist = 0.0;
	if (!b || !start || !dir || max_dist < 1.0)
		return FALSE;
	nd[0] = dir[0];
	nd[1] = dir[1];
	nd[2] = dir[2];
	len = UTVecLength(nd);
	if (len < UT_SMALL_NUMBER)
		return FALSE;
	nd[0] /= len;
	nd[1] /= len;
	nd[2] /= len;
	step = 8.0;
	d = step;
	while (d <= max_dist)
	{
		p[0] = start[0] + nd[0] * d;
		p[1] = start[1] + nd[1] * d;
		p[2] = start[2] + nd[2] * d;
		if (UTPhysPointBlocked(b, p))
		{
			if (hit_pos)
				UTVecCopy(p, hit_pos);
			if (hit_dist)
				*hit_dist = d;
			return TRUE;
		}
		d += step;
	}
	return FALSE;
}
