//standalone repro of UTPalBuildFlashTables: same array sizes, same loops, no
//includes.

U8	t_pal_r[256];
U8	t_pal_g[256];
U8	t_pal_b[256];
U8	t_add[65536];
U8	t_mod[65536];
U8	t_cube[32768];

I64 T18Best(I64 r, I64 g, I64 b)
{
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best = 1;
	best_d = 0x7FFFFFFF;
	i = 1;
	while (i < 256)
	{
		dr = ToI64(t_pal_r[i]) - r;
		dg = ToI64(t_pal_g[i]) - g;
		db = ToI64(t_pal_b[i]) - b;
		d = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best = i;
		}
		i++;
	}
	return best;
}

U0 T18Build()
{
	I64 noreg s;
	I64 noreg d;
	I64 noreg i;
	I64 noreg r;
	I64 noreg g;
	I64 noreg b;
	I64 noreg qi;
	I64 noreg rs;
	I64 noreg gs;
	I64 noreg bs;

	s = 0;
	while (s < 256)
	{
		rs = t_pal_r[s];
		gs = t_pal_g[s];
		bs = t_pal_b[s];
		d = 0;
		while (d < 256)
		{
			i = (s << 8) | d;
			r = ToI64(rs) + ToI64(t_pal_r[d]);
			g = ToI64(gs) + ToI64(t_pal_g[d]);
			b = ToI64(bs) + ToI64(t_pal_b[d]);
			if (r > 255) r = 255;
			if (g > 255) g = 255;
			if (b > 255) b = 255;
			qi = ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
			t_add[i] = t_cube[qi];
			d++;
		}
		s++;
	}
}

"T18 start\n";
T18Build;
"T18-ADDONLY-OK a=%d\n", t_add[0];
