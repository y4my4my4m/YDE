//Standalone repro of UTPalBuildFlashTables: same array sizes, same loops,
//no includes. Isolates whether the fault is codegen for these statics.

U8	t_pal_r[256];
U8	t_pal_g[256];
U8	t_pal_b[256];
U8	t_add[32768];
U8	t_mod[32768];
U8	t_cube[32768];

I64 TBest(I64 r, I64 g, I64 b)
{
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best = 1;
	best_d = 0x7FFFFFFF;
	i = 1;
	while (i < 256)
	{
		dr = ToI64(t_pal_r[i]) - r;
		dg = ToI64(t_pal_g[i]) - g;
		db = ToI64(t_pal_b[i]) - b;
		d = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best = i;
		}
		i++;
	}
	return best;
}

U0 T15Build()
{
	I64 noreg s;
	I64 noreg d;
	I64 noreg i;
	I64 noreg r;
	I64 noreg g;
	I64 noreg b;
	I64 noreg qi;
	I64 noreg rs;
	I64 noreg gs;
	I64 noreg bs;

	r = 0;
	while (r < 32)
	{
		g = 0;
		while (g < 32)
		{
			b = 0;
			while (b < 32)
			{
				qi = (r << 10) | (g << 5) | b;
				t_cube[qi] = TBest((r << 3) | (r >> 2),
					(g << 3) | (g >> 2), (b << 3) | (b >> 2)) & 255;
				b++;
			}
			g++;
		}
		r++;
	}
	"  cube built\n";
	s = 0;
	while (s < 128)
	{
		rs = t_pal_r[s];
		gs = t_pal_g[s];
		bs = t_pal_b[s];
		d = 0;
		while (d < 256)
		{
			i = (s << 8) | d;
			r = ToI64(rs) + ToI64(t_pal_r[d]);
			g = ToI64(gs) + ToI64(t_pal_g[d]);
			b = ToI64(bs) + ToI64(t_pal_b[d]);
			if (r > 255) r = 255;
			if (g > 255) g = 255;
			if (b > 255) b = 255;
			qi = ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
			t_add[i] = t_cube[qi];
			r = (ToI64(rs) * ToI64(t_pal_r[d])) / 255;
			g = (ToI64(gs) * ToI64(t_pal_g[d])) / 255;
			b = (ToI64(bs) * ToI64(t_pal_b[d])) / 255;
			qi = ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
			t_mod[i] = t_cube[qi];
			d++;
		}
		s++;
	}
}

"T15 start\n";
T15Build;
"T15-HALF-OK add0=%d mod0=%d\n", t_add[0], t_mod[0];
