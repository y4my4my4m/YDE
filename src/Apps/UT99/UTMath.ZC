// UTMath.ZC - Unreal FVector / FRotator / FCoords as F64 arrays.
//
// Upstream: Core/Inc/UnMath.h. World: X east, Y north, Z up.
// Rotator units: 65536 = 360 degrees. Pitch +look up, Yaw +north from east,
// Roll +clockwise. GetAxes: X forward, Y right, Z up.
//
// pi is a KernelA #define. Never use it as an identifier.

#define UT_DEG2RAD		(pi / 180.0)
#define UT_ROT2RAD		(2.0 * pi / 65536.0)
#define UT_RAD2ROT		(65536.0 / (2.0 * pi))
#define UT_SMALL_NUMBER	1.0e-8

U0 UTVecCopy(F64 *src, F64 *dst)
{
	dst[0] = src[0];
	dst[1] = src[1];
	dst[2] = src[2];
}

U0 UTVecSet(F64 *v, F64 x, F64 y, F64 z)
{
	v[0] = x;
	v[1] = y;
	v[2] = z;
}

U0 UTVecAdd(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[0] + b[0];
	dst[1] = a[1] + b[1];
	dst[2] = a[2] + b[2];
}

U0 UTVecSub(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[0] - b[0];
	dst[1] = a[1] - b[1];
	dst[2] = a[2] - b[2];
}

U0 UTVecScale(F64 *v, F64 s, F64 *dst)
{
	dst[0] = v[0] * s;
	dst[1] = v[1] * s;
	dst[2] = v[2] * s;
}

U0 UTVecMA(F64 *base, F64 s, F64 *dir, F64 *dst)
{
	dst[0] = base[0] + s * dir[0];
	dst[1] = base[1] + s * dir[1];
	dst[2] = base[2] + s * dir[2];
}

F64 UTVecDot(F64 *a, F64 *b)
{
	return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
}

U0 UTVecCross(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[1] * b[2] - a[2] * b[1];
	dst[1] = a[2] * b[0] - a[0] * b[2];
	dst[2] = a[0] * b[1] - a[1] * b[0];
}

F64 UTVecLength(F64 *v)
{
	return Sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
}

F64 UTVecNormalize(F64 *v)
{
	F64 len = UTVecLength(v);
	F64 inv;

	if (len > UT_SMALL_NUMBER)
	{
		inv = 1.0 / len;
		v[0] *= inv;
		v[1] *= inv;
		v[2] *= inv;
	}
	return len;
}

I64 UTRotReduce(I64 angle)
{//ReduceAngle: keep bits used by the trig table (ANGLE_MASK).
	return angle & 0xFFFC;
}

F64 UTSinRot(I64 angle)
{//GMath.SinTab without the 16k table: F64 Sin on masked rotator units.
	return Sin(ToF64(angle & 0xFFFF) * UT_ROT2RAD);
}

F64 UTCosRot(I64 angle)
{
	return Cos(ToF64(angle & 0xFFFF) * UT_ROT2RAD);
}

U0 UTGetAxes(I64 pitch, I64 yaw, I64 roll, F64 *x_axis, F64 *y_axis, F64 *z_axis)
{//GetAxes. Mirrors FCoords identity *= FRotator (yaw, pitch, roll order).
	F64	sy;
	F64	cy;
	F64	sp;
	F64	cp;
	F64	sr;
	F64	cr;
	F64	x0;
	F64	x1;
	F64	x2;
	F64	y0;
	F64	y1;
	F64	y2;
	F64	z0;
	F64	z1;
	F64	z2;
	F64	nx0;
	F64	nx1;
	F64	nx2;
	F64	ny0;
	F64	ny1;
	F64	ny2;
	F64	nz0;
	F64	nz1;
	F64	nz2;

	sy = UTSinRot(yaw);
	cy = UTCosRot(yaw);
	sp = UTSinRot(pitch);
	cp = UTCosRot(pitch);
	sr = UTSinRot(roll);
	cr = UTCosRot(roll);

	//yaw
	x0 = cy;	x1 = sy;	x2 = 0.0;
	y0 = -sy;	y1 = cy;	y2 = 0.0;
	z0 = 0.0;	z1 = 0.0;	z2 = 1.0;

	//pitch about Y: X'=(cp,0,sp), Z'=(-sp,0,cp) against current axes
	nx0 =  cp * x0 + sp * z0;
	nx1 =  cp * x1 + sp * z1;
	nx2 =  cp * x2 + sp * z2;
	nz0 = -sp * x0 + cp * z0;
	nz1 = -sp * x1 + cp * z1;
	nz2 = -sp * x2 + cp * z2;
	x0 = nx0; x1 = nx1; x2 = nx2;
	z0 = nz0; z1 = nz1; z2 = nz2;

	//roll about X: Y'=(0,cr,-sr), Z'=(0,sr,cr)
	ny0 = cr * y0 - sr * z0;
	ny1 = cr * y1 - sr * z1;
	ny2 = cr * y2 - sr * z2;
	nz0 = sr * y0 + cr * z0;
	nz1 = sr * y1 + cr * z1;
	nz2 = sr * y2 + cr * z2;
	y0 = ny0; y1 = ny1; y2 = ny2;
	z0 = nz0; z1 = nz1; z2 = nz2;

	UTVecSet(x_axis, x0, x1, x2);
	UTVecSet(y_axis, y0, y1, y2);
	UTVecSet(z_axis, z0, z1, z2);
}

U0 UTTransformVectorBy(F64 *v, F64 *x_axis, F64 *y_axis, F64 *z_axis, F64 *out)
{//FVector::TransformVectorBy
	out[0] = UTVecDot(v, x_axis);
	out[1] = UTVecDot(v, y_axis);
	out[2] = UTVecDot(v, z_axis);
}

U0 UTTransformPointBy(F64 *p, F64 *origin, F64 *x_axis, F64 *y_axis,
	F64 *z_axis, F64 *out)
{//FVector::TransformPointBy
	F64 tmp_vec[3];

	UTVecSub(p, origin, tmp_vec);
	UTTransformVectorBy(tmp_vec, x_axis, y_axis, z_axis, out);
}

I64 UTDegToRot(F64 deg)
{
	return ToI64(deg * 65536.0 / 360.0) & 0xFFFF;
}

F64 UTRotToDeg(I64 rot)
{
	return ToF64(rot & 0xFFFF) * 360.0 / 65536.0;
}

I64 UTNextPow2(I64 n)
{//FNextPowerOfTwo
	if (n <= 0) return 0;
	if (n <= 1) return 1;
	if (n <= 2) return 2;
	if (n <= 4) return 4;
	if (n <= 8) return 8;
	if (n <= 16) return 16;
	if (n <= 32) return 32;
	if (n <= 64) return 64;
	if (n <= 128) return 128;
	if (n <= 256) return 256;
	if (n <= 512) return 512;
	if (n <= 1024) return 1024;
	if (n <= 2048) return 2048;
	if (n <= 4096) return 4096;
	if (n <= 8192) return 8192;
	if (n <= 16384) return 16384;
	if (n <= 32768) return 32768;
	if (n <= 65536) return 65536;
	return 0;
}

U0 UTMeshVertUnpack(U32 d, F64 *out)
{//FMeshVert: Intel bitfield X:11 Y:11 Z:10 packed in one DWORD.
	I64 x;
	I64 y;
	I64 z;

	x = d & 0x7FF;
	y = (d >> 11) & 0x7FF;
	z = (d >> 22) & 0x3FF;
	if (x & 0x400)
		x -= 0x800;
	if (y & 0x400)
		y -= 0x800;
	if (z & 0x200)
		z -= 0x400;
	out[0] = ToF64(x);
	out[1] = ToF64(y);
	out[2] = ToF64(z);
}

U32 UTMeshVertPack(F64 x, F64 y, F64 z)
{
	I64 ix = ToI64(x);
	I64 iy = ToI64(y);
	I64 iz = ToI64(z);

	return (ix & 0x7FF) | ((iy & 0x7FF) << 11) | ((iz & 0x3FF) << 22);
}
