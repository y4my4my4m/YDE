//standalone repro of UTPalBuildFlashTables: same array sizes, same loops, no
//includes.

U8	t_pal_r[256];
U8	t_pal_g[256];
U8	t_pal_b[256];
U8	t_add[65536];
U8	t_mod[65536];
U8	t_cube[32768];

I64 T16Best(I64 r, I64 g, I64 b)
{
	I64 i;
	I64 best;
	I64 best_d;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;

	best = 1;
	best_d = 0x7FFFFFFF;
	i = 1;
	while (i < 256)
	{
		dr = ToI64(t_pal_r[i]) - r;
		dg = ToI64(t_pal_g[i]) - g;
		db = ToI64(t_pal_b[i]) - b;
		d = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best = i;
		}
		i++;
	}
	return best;
}

U0 T16Build()
{
	I64 noreg s;
	I64 noreg d;
	I64 noreg i;
	I64 noreg r;
	I64 noreg g;
	I64 noreg b;
	I64 noreg qi;
	I64 noreg rs;
	I64 noreg gs;
	I64 noreg bs;

	r = 0;
	while (r < 32)
	{
		g = 0;
		while (g < 32)
		{
			b = 0;
			while (b < 32)
			{
				qi = (r << 10) | (g << 5) | b;
				t_cube[qi] = T16Best((r << 3) | (r >> 2),
					(g << 3) | (g >> 2), (b << 3) | (b >> 2)) & 255;
				b++;
			}
			g++;
		}
		r++;
	}
}

"T16 start\n";
T16Build;
"T16-CUBEONLY-OK c=%d\n", t_cube[0];
