	UTNatReg("Add_VectorVector", UT_NOP_ADD_VV);
	UTNatReg("Subtract_VectorVector", UT_NOP_SUB_VV);
	UTNatReg("Multiply_VectorFloat", UT_NOP_MUL_VF);
	UTNatReg("Multiply_FloatVector", UT_NOP_MUL_FV);
