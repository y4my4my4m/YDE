I64 UT_NOP_VSIZE = 160;
I64 UT_NOP_NORMAL = 161;
I64 UT_NOP_VRAND = 162;
I64 UT_NOP_MIRROR_VN = 163;
I64 UT_NOP_INVERT = 164;
I64 UT_NOP_GETAXES = 165;
I64 UT_NOP_GETUNAXES = 166;
I64 UT_NOP_ORTHOROT = 167;
I64 UT_NOP_ROTRAND = 168;
