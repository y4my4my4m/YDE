I64 UT_NOP_ADDEQ_BB = 64;
I64 UT_NOP_SUBEQ_BB = 65;
I64 UT_NOP_MULEQ_BB = 66;
I64 UT_NOP_DIVEQ_BB = 67;

I64 UT_NOP_ADD_VV = 70;
I64 UT_NOP_SUB_VV = 71;
I64 UT_NOP_MUL_VF = 72;
I64 UT_NOP_MUL_FV = 73;
I64 UT_NOP_MUL_VV = 74;
I64 UT_NOP_DIV_VF = 75;
I64 UT_NOP_NEG_V = 76;
