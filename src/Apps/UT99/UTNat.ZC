I64 UT_NOP_ISA = 187;
I64 UT_NOP_ENABLE = 188;
I64 UT_NOP_DISABLE = 189;

I64 UT_NOP_CREATEWINDOW = 200;

//Flat parallel arrays, strided by UT_NAT_NAME_LEN.
U8		ut_nat_name[UT_NAT_NAME_POOL];
I64		ut_nat_opid[UT_NAT_NAMES_MAX];
I64		ut_nat_names_n	= 0;
I64		ut_nat_op[UT_NAT_INATIVE_MAX];
I64		ut_nat_bound	= 0;
Bool	ut_nat_ready	= FALSE;

U0 UTNatReg(U8 *nm, I64 op_id)
{
	U8 *dst;

	if (ut_nat_names_n >= UT_NAT_NAMES_MAX)
		return;
	dst = &ut_nat_name[ut_nat_names_n * UT_NAT_NAME_LEN];
	StrPrint(dst, "%s", nm);
	ut_nat_opid[ut_nat_names_n] = op_id;
	ut_nat_names_n++;
}

I64 UTNatOpByName(U8 *nm)
{
	I64 i;

	if (!nm || !nm[0])
		return UT_NOP_NONE;
	i = 0;
	while (i < ut_nat_names_n)
	{
		if (!StrCompare(&ut_nat_name[i * UT_NAT_NAME_LEN], nm))
			return ut_nat_opid[i];
		i++;
	}
	return UT_NOP_NONE;
}

U0 UTNatBind(I64 i_native, U8 *nm)
{
	I64 op_id;

	if (i_native <= 0 || i_native >= UT_NAT_INATIVE_MAX)
		return;
	op_id = UTNatOpByName(nm);
	if (op_id == UT_NOP_NONE)
		return;
	if (!ut_nat_op[i_native])
		ut_nat_bound++;
	ut_nat_op[i_native] = op_id;
}

I64 UTNatOp(I64 i_native)
{
	if (i_native <= 0 || i_native >= UT_NAT_INATIVE_MAX)
		return UT_NOP_NONE;
	return ut_nat_op[i_native];
}

U0 UTNatInitTable()
{
	I64 i;

	if (ut_nat_ready)
		return;
	ut_nat_names_n = 0;
	ut_nat_bound = 0;
	i = 0;
	while (i < UT_NAT_INATIVE_MAX)
	{
		ut_nat_op[i] = 0;
		i++;
	}

	UTNatReg("Add_IntInt", UT_NOP_ADD_II);
	UTNatReg("Subtract_IntInt", UT_NOP_SUB_II);
	UTNatReg("Multiply_IntInt", UT_NOP_MUL_II);
	UTNatReg("Divide_IntInt", UT_NOP_DIV_II);
	UTNatReg("Subtract_PreInt", UT_NOP_NEG_I);
	UTNatReg("AddAdd_Int", UT_NOP_INC_I);
	UTNatReg("SubtractSubtract_Int", UT_NOP_DEC_I);
	UTNatReg("AddAdd_PreInt", UT_NOP_PREINC_I);
	UTNatReg("SubtractSubtract_PreInt", UT_NOP_PREDEC_I);
	UTNatReg("AddEqual_IntInt", UT_NOP_ADDEQ_II);
	UTNatReg("SubtractEqual_IntInt", UT_NOP_SUBEQ_II);
	UTNatReg("MultiplyEqual_IntFloat", UT_NOP_MULEQ_IF);
	UTNatReg("DivideEqual_IntFloat", UT_NOP_DIVEQ_IF);
	UTNatReg("And_IntInt", UT_NOP_AND_II);
	UTNatReg("Or_IntInt", UT_NOP_OR_II);
	UTNatReg("Xor_IntInt", UT_NOP_XOR_II);
	UTNatReg("LessLess_IntInt", UT_NOP_SHL_II);
	UTNatReg("GreaterGreater_IntInt", UT_NOP_SHR_II);
	UTNatReg("GreaterGreaterGreater_IntInt", UT_NOP_USHR_II);
	UTNatReg("Complement_PreInt", UT_NOP_COMP_I);
	UTNatReg("Less_IntInt", UT_NOP_LT_II);
	UTNatReg("Greater_IntInt", UT_NOP_GT_II);
	UTNatReg("LessEqual_IntInt", UT_NOP_LE_II);
	UTNatReg("GreaterEqual_IntInt", UT_NOP_GE_II);
	UTNatReg("EqualEqual_IntInt", UT_NOP_EQ_II);
	UTNatReg("NotEqual_IntInt", UT_NOP_NE_II);

	UTNatReg("Add_FloatFloat", UT_NOP_ADD_FF);
	UTNatReg("Subtract_FloatFloat", UT_NOP_SUB_FF);
	UTNatReg("Multiply_FloatFloat", UT_NOP_MUL_FF);
	UTNatReg("Divide_FloatFloat", UT_NOP_DIV_FF);
	UTNatReg("Percent_FloatFloat", UT_NOP_MOD_FF);
	UTNatReg("MultiplyMultiply_FloatFloat", UT_NOP_POW_FF);
	UTNatReg("Subtract_PreFloat", UT_NOP_NEG_F);
	UTNatReg("AddEqual_FloatFloat", UT_NOP_ADDEQ_FF);
	UTNatReg("SubtractEqual_FloatFloat", UT_NOP_SUBEQ_FF);
	UTNatReg("MultiplyEqual_FloatFloat", UT_NOP_MULEQ_FF);
	UTNatReg("DivideEqual_FloatFloat", UT_NOP_DIVEQ_FF);
	UTNatReg("Less_FloatFloat", UT_NOP_LT_FF);
	UTNatReg("Greater_FloatFloat", UT_NOP_GT_FF);
	UTNatReg("LessEqual_FloatFloat", UT_NOP_LE_FF);
	UTNatReg("GreaterEqual_FloatFloat", UT_NOP_GE_FF);
	UTNatReg("EqualEqual_FloatFloat", UT_NOP_EQ_FF);
	UTNatReg("NotEqual_FloatFloat", UT_NOP_NE_FF);
	UTNatReg("ComplementEqual_FloatFloat", UT_NOP_APPROX_FF);

	UTNatReg("AndAnd_BoolBool", UT_NOP_ANDAND);
	UTNatReg("OrOr_BoolBool", UT_NOP_OROR);
	UTNatReg("XorXor_BoolBool", UT_NOP_XORXOR);
