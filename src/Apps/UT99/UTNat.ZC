// native function identity, resolved from package Function exports.
//
// iNative indices are not stable across builds: the map is built at load time
// from the UFunction trailer iNative of each Function export.
//
// Op ids are I64 globals, not #defines: ZealC mis-parses the next function
// definition once a unit accumulates roughly 150+ preprocessor symbols.
//
// Names are the FriendlyName-mangled forms Epic's compiler emits for operators
// (Add_IntInt for int +, LessLess_VectorRotator for vector << rotator).

#define UT_NAT_INATIVE_MAX	4096
#define UT_NAT_NAMES_MAX	256
#define UT_NAT_NAME_LEN		40
#define UT_NAT_NAME_POOL	10240	//UT_NAT_NAMES_MAX * UT_NAT_NAME_LEN

I64 UT_NOP_NONE = 0;

I64 UT_NOP_ADD_II = 1;
I64 UT_NOP_SUB_II = 2;
I64 UT_NOP_MUL_II = 3;
I64 UT_NOP_DIV_II = 4;
I64 UT_NOP_NEG_I = 5;
I64 UT_NOP_INC_I = 6;
I64 UT_NOP_DEC_I = 7;
I64 UT_NOP_PREINC_I = 8;
I64 UT_NOP_PREDEC_I = 9;
