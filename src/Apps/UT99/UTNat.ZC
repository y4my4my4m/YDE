	UTNatReg("FMin", UT_NOP_FMIN);
	UTNatReg("FMax", UT_NOP_FMAX);
	UTNatReg("Clamp", UT_NOP_CLAMP);
	UTNatReg("FClamp", UT_NOP_FCLAMP);
	UTNatReg("Lerp", UT_NOP_LERP);
	UTNatReg("Smerp", UT_NOP_SMERP);
	UTNatReg("RandRange", UT_NOP_RANDRANGE);
	UTNatReg("VSize", UT_NOP_VSIZE);
	UTNatReg("Normal", UT_NOP_NORMAL);
	UTNatReg("VRand", UT_NOP_VRAND);
	UTNatReg("MirrorVectorByNormal", UT_NOP_MIRROR_VN);
	UTNatReg("Invert", UT_NOP_INVERT);
	UTNatReg("GetAxes", UT_NOP_GETAXES);
	UTNatReg("GetUnAxes", UT_NOP_GETUNAXES);
	UTNatReg("OrthoRotation", UT_NOP_ORTHOROT);
	UTNatReg("RotRand", UT_NOP_ROTRAND);
