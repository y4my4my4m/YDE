//Validate ut_rgb_cube contents, not just that the build survives.
//UTPalInit sets slot i = (i,i,i), so a grey key must map to a near-grey slot.
#include "UTFmt"
#include "UTPal"

U0 T23Check()
{
	I64 noreg i;
	I64 noreg bad;
	I64 noreg qi;
	I64 noreg got;
	I64 noreg want;

	UTPalInit;
	bad = 0;
	i = 0;
	while (i < 32)
	{
		qi = (i << 10) | (i << 5) | i;
		got = ut_rgb_cube[qi & 32767];
		want = (i << 3) | (i >> 2);
		if (got < want - 8 || got > want + 8)
		{
			if (bad < 6)
				"  grey %d -> slot %d, want ~%d\n", i, got, want;
			bad++;
		}
		i++;
	}
	U8 *rep;
	rep = MStrPrint("T23-CUBE bad=%d of 32 flash_ready=%d cube0=%d cube_mid=%d\n",
		bad, ut_flash_ready, ut_rgb_cube[0], ut_rgb_cube[16383]);
	"%s", rep;
	FileWrite("C:/Tmp/T23.TXT", rep, StrLen(rep));
}

T23Check;
