//Same nearest-palette loop inline vs via UTPalBestMatch.
#include "UTFmt"
#include "UTPal"

U0 T25Check()
{
	U8 *rep;
	I64 noreg i;
	I64 noreg best;
	I64 noreg best_d;
	I64 noreg dr;
	I64 noreg dg;
	I64 noreg db;
	I64 noreg d;
	I64 noreg inline50;
	I64 noreg called50;

	UTPalInit;

	best = 1;
	best_d = 0x7FFFFFFF;
	i = 1;
	while (i < 256)
	{
		dr = ToI64(ut_pal_r[i]) - 50;
		dg = ToI64(ut_pal_g[i]) - 50;
		db = ToI64(ut_pal_b[i]) - 50;
		d = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best = i;
		}
		i++;
	}
	inline50 = best;
	called50 = UTPalBestMatch(50, 50, 50, 1);

	rep = MStrPrint("T25 inline=%d called=%d best_d=%d pal50=%d pal226=%d\n",
		inline50, called50, best_d, ut_pal_r[50], ut_pal_r[226]);
	"%s", rep;
	FileWrite("C:/Tmp/T25.TXT", rep, StrLen(rep));
}

T25Check;
