#define T_MAX	256
#define T_LEN	40

U8		t_name[T_MAX * T_LEN];
I64		t_opid[T_MAX];
I64		t_n		= 0;
Bool	t_ready	= FALSE;

U0 TReg(U8 *nm, I64 op_id)
{
	U8 *dst;

	dst = &t_name[t_n * T_LEN];
	StrPrint(dst, "%s", nm);
	t_opid[t_n] = op_id;
	t_n++;
}

TReg("hello", 7);
"T1-OK n=%d ready=%d name=%s\n", t_n, t_ready, t_name;
