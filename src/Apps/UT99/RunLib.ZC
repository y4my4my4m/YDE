// RunLib.ZC
//
// Stage 1: formats, packages, palette, rasteriser, world data.
// split from RunLib2: one 40+ file unit faults at run time with a corrupt
// stack. each ExeFile is a separate compile.
//
// ZealC is single-pass: a file may reference only earlier symbols,
// so this order is load-bearing.

Cd(__DIR__);;

"UT99 lib 1/2 (data + render):\n";

"  .. UTFmt\n";
#include "UTFmt"
"  .. UTMath\n";
