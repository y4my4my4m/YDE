// UTObj.ZC - UObject New + class slot pool (Core UnObjBas shape).
//
// Full UnLinker/UnProp graph absent. Host pool holds named objects with
// CUTPropBag defaults from Class export serial. Outer/Owner/Base slot links
// feed EX_Context Self bag. GameInfo / ChallengeHUD / PlayerPawn slots.

extern F64	ut_health;
extern I64	ut_ammo;
extern Bool	ut_as_active;

#define UT_OBJ_MAX		192
#define UT_OBJ_NAME_LEN	48
#define UT_OBJ_CLS_LEN	56

#define UT_OBJ_KIND_NONE		0
#define UT_OBJ_KIND_OBJECT		1
#define UT_OBJ_KIND_ACTOR		2
#define UT_OBJ_KIND_GAMEINFO	3
#define UT_OBJ_KIND_HUD			4
#define UT_OBJ_KIND_PAWN		5
#define UT_OBJ_KIND_WINDOW		6
#define UT_OBJ_KIND_INVENTORY	7

class CUTObj
{
	U8		name[UT_OBJ_NAME_LEN];
	U8		class_name[UT_OBJ_CLS_LEN];
	U8		pkg_path[96];
	U8		state_name[48];	//UObject.GetStateName
	I64		kind;
	I64		index;
	I64		outer_id;	//Outer object slot
	I64		owner_id;	//Actor.Owner
	I64		base_id;	//Actor.Base
	I64		class_slot;	//Class meta object (-1 none)
	I64		inv_next;	//Inventory.Inventory next obj slot (-1 end)
	I64		weap_id;	//host weapon table id when kind=INVENTORY
	Bool	alive;
	Bool	defaults_ok;
	//Actor.SetTimer: seconds remaining, period, and repeat flag. rate <= 0
	//cancels. Timer() fires from UTObjTickTimers.
	F64		timer_left;
	F64		timer_rate;
	Bool	timer_loop;
	//Per-object state frame (FStateFrame). One global frame could only ever
	//run a single actor's state code.
	CUTVMFrame	state_frame;
	Bool	state_ok;
	CUTPropBag	bag;
};

CUTObj	ut_obj[UT_OBJ_MAX];
I64		ut_obj_n		= 0;
I64		ut_obj_gameinfo	= -1;
I64		ut_obj_hud		= -1;
I64		ut_obj_pawn		= -1;
I64		ut_obj_root		= -1;
I64		ut_obj_inv_head	= -1;	//Pawn.Inventory head obj slot
I64		ut_obj_level		= -1;	//LevelInfo stand-in Outer root
Bool	ut_obj_ready	= FALSE;
I64		ut_obj_initgame_steps	= 0;
I64		ut_obj_postrender_steps	= 0;

extern I64 UTObjEnsureClassMeta(U8 *cls, U8 *pkg_path);

U0 UTObjClear()
{
	I64 i;

	i = 0;
	while (i < UT_OBJ_MAX)
	{
		MemSet(&ut_obj[i], 0, sizeof(CUTObj));
		i++;
	}
	ut_obj_n = 0;
	ut_obj_gameinfo = -1;
	ut_obj_hud = -1;
	ut_obj_pawn = -1;
	ut_obj_root = -1;
	ut_obj_inv_head = -1;
	ut_obj_level = -1;
	ut_obj_initgame_steps = 0;
	ut_obj_postrender_steps = 0;
}

I64 UTObjFind(U8 *name)
{
	I64 i;

	if (!name || !name[0])
		return -1;
	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && !StrCompare(ut_obj[i].name, name))
			return i;
		i++;
	}
	return -1;
}

I64 UTObjKindFromClass(U8 *cls)
{
	if (!cls)
		return UT_OBJ_KIND_OBJECT;
	if (!StrCompare(cls, "DeathMatchPlus") ||
		!StrCompare(cls, "TeamGamePlus") ||
		!StrCompare(cls, "CTFGame") ||
		!StrCompare(cls, "Domination") ||
		!StrCompare(cls, "Assault") ||
		!StrCompare(cls, "GameInfo") ||
		!StrCompare(cls, "TournamentGameInfo"))
		return UT_OBJ_KIND_GAMEINFO;
	if (!StrCompare(cls, "ChallengeHUD") ||
		!StrCompare(cls, "HUD") ||
		!StrCompare(cls, "TournamentHUD"))
		return UT_OBJ_KIND_HUD;
	if (!StrCompare(cls, "PlayerPawn") ||
		!StrCompare(cls, "TournamentPlayer") ||
		!StrCompare(cls, "bbPlayer"))
		return UT_OBJ_KIND_PAWN;
	if (!StrCompare(cls, "UMenuRootWindow") ||
		!StrCompare(cls, "UWindowRootWindow") ||
		!StrCompare(cls, "WindowConsole"))
		return UT_OBJ_KIND_WINDOW;
	if (!StrCompare(cls, "Weapon") || !StrCompare(cls, "TournamentWeapon") ||
		!StrCompare(cls, "Inventory") || !StrCompare(cls, "Ammo") ||
		!StrCompare(cls, "ShockRifle") || !StrCompare(cls, "Enforcer") ||
		!StrCompare(cls, "PulseGun") || !StrCompare(cls, "Minigun") ||
		!StrCompare(cls, "FlakCannon") || !StrCompare(cls, "RocketLauncher") ||
		!StrCompare(cls, "SniperRifle") || !StrCompare(cls, "Ripper") ||
		!StrCompare(cls, "UT_BioRifle") || !StrCompare(cls, "ImpactHammer") ||
		!StrCompare(cls, "Translocator") || !StrCompare(cls, "WarheadLauncher") ||
		!StrCompare(cls, "SuperShockRifle") || !StrCompare(cls, "UT_Shieldbelt") ||
		!StrCompare(cls, "Thighpads") || !StrCompare(cls, "UT_JumpBoots"))
		return UT_OBJ_KIND_INVENTORY;
	if (StrLen(cls) > 0)
		return UT_OBJ_KIND_ACTOR;
	return UT_OBJ_KIND_OBJECT;
}

I64 UTObjNew(U8 *name, U8 *cls, U8 *pkg_path)
{//UObject::StaticConstructObject stand-in — pool slot + optional Class defaults.
	CUTObj *o;
	I64 slot;
	I64 kind;

	if (!name || !name[0] || !cls || !cls[0])
		return -1;
	slot = UTObjFind(name);
	if (slot >= 0)
		return slot;
	if (ut_obj_n >= UT_OBJ_MAX)
		return -1;
	o = &ut_obj[ut_obj_n];
	MemSet(o, 0, sizeof(CUTObj));
	StrPrint(o->name, "%s", name);
	StrPrint(o->class_name, "%s", cls);
	if (pkg_path)
		StrPrint(o->pkg_path, "%s", pkg_path);
	kind = UTObjKindFromClass(cls);
	o->kind = kind;
	o->index = ut_obj_n;
	o->outer_id = -1;
	o->owner_id = -1;
	o->base_id = -1;
	o->class_slot = -1;
	o->inv_next = -1;
	o->weap_id = -1;
	o->alive = TRUE;
	o->defaults_ok = FALSE;
	o->state_name[0] = 0;
	if (pkg_path && pkg_path[0] && FileFind(pkg_path))
	{
		if (UTPropLoadClassDefaults(pkg_path, cls, &o->bag))
			o->defaults_ok = TRUE;
	}
	ut_obj_n++;
	if (StrCompare(cls, "Class") && StrCompare(cls, "LevelInfo"))
		o->class_slot = UTObjEnsureClassMeta(cls, pkg_path);
	if (kind == UT_OBJ_KIND_GAMEINFO && ut_obj_gameinfo < 0)
		ut_obj_gameinfo = o->index;
	if (kind == UT_OBJ_KIND_HUD && ut_obj_hud < 0)
		ut_obj_hud = o->index;
	if (kind == UT_OBJ_KIND_PAWN && ut_obj_pawn < 0)
		ut_obj_pawn = o->index;
	if (kind == UT_OBJ_KIND_WINDOW && ut_obj_root < 0)
		ut_obj_root = o->index;
	UTLog("UTObj: New %s class=%s kind=%d def=%d\n",
		name, cls, kind, ToI64(o->defaults_ok));
	return o->index;
}

CUTPropBag *UTObjBagForSlot(I64 slot)
{//= FFrame::Object bag for EX_Context Self override
	if (slot < 0 || slot >= ut_obj_n)
		return NULL;
	if (!ut_obj[slot].alive)
		return NULL;
	return &ut_obj[slot].bag;
}

U0 UTObjSetOuter(I64 child, I64 outer)
{
	if (child < 0 || child >= ut_obj_n)
		return;
	ut_obj[child].outer_id = outer;
}

U0 UTObjSetOwner(I64 child, I64 owner)
{
	if (child < 0 || child >= ut_obj_n)
		return;
	ut_obj[child].owner_id = owner;
}

U0 UTObjSetBase(I64 child, I64 base)
{
	if (child < 0 || child >= ut_obj_n)
		return;
	ut_obj[child].base_id = base;
}

Bool UTObjIsA(I64 slot, U8 *cls_name)
{//= UObject::IsA — empty cls_name = any live object
	if (slot < 0 || slot >= ut_obj_n)
		return FALSE;
	if (!ut_obj[slot].alive)
		return FALSE;
	if (!cls_name || !cls_name[0])
		return TRUE;
	if (!StrCompare(ut_obj[slot].class_name, cls_name))
		return TRUE;
	return FALSE;
}

I64 UTObjEnsureClassMeta(U8 *cls, U8 *pkg_path)
{//Class UObject stand-in named after class_name
	I64 slot;
	U8 nm[UT_OBJ_NAME_LEN];

	if (!cls || !cls[0])
		return -1;
	if (!StrCompare(cls, "Class"))
		return -1;
	StrPrint(nm, "Class_%s", cls);
	slot = UTObjFind(nm);
	if (slot >= 0)
		return slot;
	return UTObjNew(nm, "Class", pkg_path);
}

U0 UTObjSetState(I64 slot, U8 *state_name)
{
	if (slot < 0 || slot >= ut_obj_n)
		return;
	if (!state_name)
		ut_obj[slot].state_name[0] = 0;
	else
		StrPrint(ut_obj[slot].state_name, "%s", state_name);
}




I64 UTObjFindByWeapId(I64 weap_id)
{//Live inventory object backing a host weapon table slot, -1 if none.
	I64 i;

	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && ut_obj[i].weap_id == weap_id)
			return i;
		i++;
	}
	return -1;
}


Bool ut_script_actors = FALSE;	//S8 opt-in: run Actor.Tick from script
F64  ut_obj_delta = 0.0;		//DeltaTime for the current script Tick

U0 UTObjTickScripts(F64 dt)
{//Actor.Tick per live scripted object. Spawned actors are inert without it:
 //Spawn builds them, but nothing advances their script until Tick runs.
	I64 i;
	I64 k;

	if (!ut_script_actors)
		return;
	ut_obj_delta = dt;
	i = 0;
	while (i < ut_obj_n)
	{
		k = ut_obj[i].kind;
		if (ut_obj[i].alive && ut_obj[i].defaults_ok &&
			(k == UT_OBJ_KIND_ACTOR || k == UT_OBJ_KIND_PAWN ||
			 k == UT_OBJ_KIND_INVENTORY))
		{
			ut_vm_arg_seed = dt;
			ut_vm_arg_seed_on = TRUE;
			UTVMCallSelf("Tick", i, &ut_obj[i].bag, 2048);
		}
		i++;
	}
	UTVMClearSelf;
}


I64 UTObjFirstOwnedBy(I64 owner, I64 after)
{//Next live object owned by `owner`, scanning past slot `after`. Spawn sets
 //owner_id, so ownership is the widget tree for script-created windows.
	I64 i;

	i = after + 1;
	if (i < 0)
		i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && ut_obj[i].owner_id == owner)
			return i;
		i++;
	}
	return -1;
}

CUTVMFrame *UTObjStateFrame(I64 slot)
{//FStateFrame for one object. Each actor runs its own state code.
	if (slot < 0 || slot >= UT_OBJ_MAX)
		return NULL;
	return &ut_obj[slot].state_frame;
}

U0 UTObjSetStateOk(I64 slot, Bool v)
{
	if (slot < 0 || slot >= UT_OBJ_MAX)
		return;
	ut_obj[slot].state_ok = v;
}

U0 UTObjTickStates(F64 dt)
{//Run every live actor's state code. UTVMProcessState drives only one.
	I64 i;

	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && ut_obj[i].state_ok)
		{
			UTVMSetSelf(i, &ut_obj[i].bag);
			UTVMStepFrame(&ut_obj[i].state_frame, dt);
			if (ut_obj[i].state_frame.stopped || ut_obj[i].state_frame.err)
				ut_obj[i].state_ok = FALSE;
		}
		i++;
	}
	UTVMClearSelf;
}

Bool UTObjDestroy(I64 slot)
{//= AActor::Destroy. Frees the slot and drops every reference to it so a
 //later lookup cannot resurrect a dead object through a stale link.
	I64 i;

	if (slot < 0 || slot >= ut_obj_n || !ut_obj[slot].alive)
		return FALSE;
	ut_obj[slot].alive = FALSE;
	ut_obj[slot].timer_rate = 0.0;
	ut_obj[slot].timer_left = 0.0;
	ut_obj[slot].state_ok = FALSE;
	ut_obj[slot].state_name[0] = 0;
	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].outer_id == slot)
			ut_obj[i].outer_id = -1;
		if (ut_obj[i].owner_id == slot)
			ut_obj[i].owner_id = -1;
		if (ut_obj[i].base_id == slot)
			ut_obj[i].base_id = -1;
		if (ut_obj[i].inv_next == slot)
			ut_obj[i].inv_next = ut_obj[slot].inv_next;
		i++;
	}
	if (ut_obj_inv_head == slot)
		ut_obj_inv_head = ut_obj[slot].inv_next;
	if (ut_obj_gameinfo == slot)
		ut_obj_gameinfo = -1;
	if (ut_obj_hud == slot)
		ut_obj_hud = -1;
	ut_obj[slot].inv_next = -1;
	return TRUE;
}

U0 UTObjSetTimer(I64 slot, F64 rate, Bool loop)
{//= AActor::SetTimer. Rate <= 0 cancels a pending timer.
	if (slot < 0 || slot >= UT_OBJ_MAX)
		return;
	if (rate <= 0.0)
	{
		ut_obj[slot].timer_rate = 0.0;
		ut_obj[slot].timer_left = 0.0;
		ut_obj[slot].timer_loop = FALSE;
		return;
	}
	ut_obj[slot].timer_rate = rate;
	ut_obj[slot].timer_left = rate;
	ut_obj[slot].timer_loop = loop;
}

U0 UTObjTickTimers(F64 dt)
{//Fire Timer() on every live object whose timer elapsed. One-shots clear.
	I64 i;

	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && ut_obj[i].timer_rate > 0.0)
		{
			ut_obj[i].timer_left -= dt;
			if (ut_obj[i].timer_left <= 0.0)
			{
				if (ut_obj[i].timer_loop)
					ut_obj[i].timer_left += ut_obj[i].timer_rate;
				else
				{
					ut_obj[i].timer_rate = 0.0;
					ut_obj[i].timer_left = 0.0;
				}
				UTVMCallSelf("Timer", i, &ut_obj[i].bag, 256);
			}
		}
		i++;
	}
}

Bool UTObjIsInState(I64 slot, U8 *state_name)
{
	if (slot < 0 || slot >= ut_obj_n || !state_name)
		return FALSE;
	if (!ut_obj[slot].state_name[0])
		return FALSE;
	if (!StrCompare(ut_obj[slot].state_name, state_name))
		return TRUE;
	return FALSE;
}

I64 UTObjFindByClass(U8 *cls)
{
	I64 i;

	if (!cls)
		return -1;
	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && !StrCompare(ut_obj[i].class_name, cls))
			return i;
		i++;
	}
	return -1;
}

U0 UTObjLinkGraph()
{//Level Outer root; GameInfo/Pawn/HUD/Root Outer → Level; Pawn owns Inventory.
	I64 i;
	I64 inv;

	if (ut_obj_level < 0)
		ut_obj_level = UTObjNew("LevelInfo0", "LevelInfo",
			"::/Apps/UT99/System/Engine.u");
	if (ut_obj_level >= 0)
		ut_obj[ut_obj_level].outer_id = -1;
	if (ut_obj_gameinfo >= 0)
		UTObjSetOuter(ut_obj_gameinfo, ut_obj_level);
	if (ut_obj_pawn >= 0)
	{
		UTObjSetOuter(ut_obj_pawn, ut_obj_level);
		UTObjSetOwner(ut_obj_pawn, ut_obj_pawn);
		UTObjSetBase(ut_obj_pawn, -1);
	}
	if (ut_obj_hud >= 0)
	{
		UTObjSetOuter(ut_obj_hud, ut_obj_level);
		if (ut_obj_pawn >= 0)
			UTObjSetOwner(ut_obj_hud, ut_obj_pawn);
	}
	if (ut_obj_root >= 0)
		UTObjSetOuter(ut_obj_root, ut_obj_level);
	inv = ut_obj_inv_head;
	i = 0;
	while (inv >= 0 && inv < ut_obj_n && i < UT_OBJ_MAX)
	{
		UTObjSetOuter(inv, ut_obj_pawn);
		UTObjSetOwner(inv, ut_obj_pawn);
		if (ut_obj[inv].class_slot < 0)
			ut_obj[inv].class_slot =
				UTObjEnsureClassMeta(ut_obj[inv].class_name,
					ut_obj[inv].pkg_path);
		inv = ut_obj[inv].inv_next;
		i++;
	}
	//Class meta Outer → Level
	i = 0;
	while (i < ut_obj_n)
	{
		if (ut_obj[i].alive && !StrCompare(ut_obj[i].class_name, "Class"))
			UTObjSetOuter(i, ut_obj_level);
		if (ut_obj[i].alive && ut_obj[i].class_slot < 0 &&
			StrCompare(ut_obj[i].class_name, "Class") &&
			StrCompare(ut_obj[i].class_name, "LevelInfo"))
			ut_obj[i].class_slot =
				UTObjEnsureClassMeta(ut_obj[i].class_name,
					ut_obj[i].pkg_path);
		i++;
	}
	UTLog("UTObj: graph level=%d gi=%d pawn=%d hud=%d root=%d n=%d\n",
		ut_obj_level, ut_obj_gameinfo, ut_obj_pawn, ut_obj_hud,
		ut_obj_root, ut_obj_n);
}

Bool UTObjInitGame()
{//DeathMatchPlus / Assault.InitGame — load Exec + mark GameInfo live.
	I64 steps;
	I64 slot;
	CUTPropBag *bag;

	if (ut_as_active)
		slot = UTObjNew("Assault0", "Assault",
			"::/Apps/UT99/System/Botpack.u");
	else
		slot = -1;
	if (slot < 0)
		slot = UTObjNew("DeathMatchPlus0", "DeathMatchPlus",
			"::/Apps/UT99/System/Botpack.u");
	if (slot < 0)
		return FALSE;
	ut_obj_gameinfo = slot;
	bag = &ut_obj[slot].bag;
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "InitGame");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostBeginPlay");
	steps = UTVMCallSelf("InitGame", slot, bag, 256);
	if (steps < 1)
		steps = UTVMCallSelf("PostBeginPlay", slot, bag, 128);
	ut_obj_initgame_steps = steps;
	UTObjLinkGraph;
	if (bag->state_name[0])
		UTVMGotoState(bag->state_name, bag);
	UTLog("UTObj: InitGame steps=%d gi=%d\n", steps, ut_obj_gameinfo);
	return steps > 0 || ut_obj_gameinfo >= 0;
}

Bool UTObjBindHUD()
{
	I64 slot;

	slot = UTObjNew("ChallengeHUD0", "ChallengeHUD",
		"::/Apps/UT99/System/Botpack.u");
	if (slot < 0)
		return FALSE;
	ut_obj_hud = slot;
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostRender");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "DrawHUD");
	return TRUE;
}

Bool UTObjBindPawn()
{
	I64 slot;

	slot = UTObjNew("PlayerPawn0", "TournamentPlayer",
		"::/Apps/UT99/System/Botpack.u");
	if (slot < 0)
		slot = UTObjNew("PlayerPawn0", "PlayerPawn",
			"::/Apps/UT99/System/Engine.u");
	if (slot < 0)
		return FALSE;
	ut_obj_pawn = slot;
	return TRUE;
}

Bool UTObjBindRootWindow()
{
	I64 slot;

	slot = UTObjNew("RootWindow0", "UMenuRootWindow",
		"::/Apps/UT99/System/UMenu.u");
	if (slot < 0)
		return FALSE;
	ut_obj_root = slot;
	return TRUE;
}

I64 UTObjPostRender()
{//ChallengeHUD.PostRender via Canvas natives when bytecode warms.
	I64 steps;
	CUTPropBag *bag;

	if (ut_obj_hud < 0)
		return 0;
	bag = &ut_obj[ut_obj_hud].bag;
	bag->health = ut_health;
	bag->ammo_amount = ToF64(ut_ammo);
	steps = UTVMCallSelf("PostRender", ut_obj_hud, bag, 128);
	if (steps < 1)
		steps = UTVMCallSelf("DrawHUD", ut_obj_hud, bag, 64);
	ut_obj_postrender_steps = steps;
	return steps;
}

U0 UTObjInit()
{
	UTObjClear;
	UTPropLinkBuildPawn;
	UTObjBindRootWindow;
	UTObjBindPawn;
	UTObjBindHUD;
	UTObjLinkGraph;
	ut_obj_ready = TRUE;
	UTLog("UTObj: ready n=%d gi=%d hud=%d pawn=%d root=%d level=%d\n",
		ut_obj_n, ut_obj_gameinfo, ut_obj_hud, ut_obj_pawn, ut_obj_root,
		ut_obj_level);
}

U0 UTObjExit()
{
	UTObjClear;
	ut_obj_ready = FALSE;
}
