// UTSpan.ZC - SoftDrv span buffer. Upstream: UnRender.h FSpan / FSpanBuffer.
//
// SoftDrv sets URenderDevice::SpanBased. Spans are the CPU occlusion
// representation: per scanline, ordered open [start,end) segments. Hardware
// devices ignore this and use a Z buffer alone; this port keeps both.

#define UT_SPAN_MAX_ROWS	480
#define UT_SPAN_MAX_SEGS	8		//open segments per row

class CUTSpanSeg
{
	I64 start;
	I64 end;
};

class CUTSpanRow
{
	I64			n;
	CUTSpanSeg	seg[UT_SPAN_MAX_SEGS];
};

class CUTSpanBuf
{
	I64			width;
	I64			height;
	CUTSpanRow	row[UT_SPAN_MAX_ROWS];
	I64			spans_drawn;
	I64			spans_clipped;
};

U0 UTSpanClear(CUTSpanBuf *sb, I64 w, I64 h)
{//full-screen open: one segment [0,w) per row. Lock() with ClearScreen.
	I64 y;

	if (h > UT_SPAN_MAX_ROWS)
		h = UT_SPAN_MAX_ROWS;
	if (w < 1)
		w = 1;
	sb->width  = w;
	sb->height = h;
	sb->spans_drawn   = 0;
	sb->spans_clipped = 0;
	y = 0;
	while (y < h)
	{
		sb->row[y].n = 1;
		sb->row[y].seg[0].start = 0;
		sb->row[y].seg[0].end   = w;
		y++;
	}
}

U0 UTSpanEmpty(CUTSpanBuf *sb, I64 w, I64 h)
{//no open pixels (fully occluded)
	I64 y;

	if (h > UT_SPAN_MAX_ROWS)
		h = UT_SPAN_MAX_ROWS;
	sb->width  = w;
	sb->height = h;
	sb->spans_drawn   = 0;
	sb->spans_clipped = 0;
	y = 0;
	while (y < h)
	{
		sb->row[y].n = 0;
		y++;
	}
}

Bool UTSpanClip(CUTSpanBuf *sb, I64 y, I64 *x1, I64 *x2)
{//clip [x1,x2) against first overlapping open segment. SoftDrv Draw* path.
	CUTSpanRow *r;
	I64 i;
	I64 a;
	I64 b;
	I64 s0;
	I64 s1;

	if (!sb || y < 0 || y >= sb->height)
		return FALSE;
	a = *x1;
	b = *x2;
	if (a < 0) a = 0;
	if (b > sb->width) b = sb->width;
	if (a >= b)
		return FALSE;
	r = &sb->row[y];
	i = 0;
	while (i < r->n)
	{
		s0 = r->seg[i].start;
		s1 = r->seg[i].end;
		if (b > s0 && a < s1)
		{
			if (a < s0) a = s0;
			if (b > s1) b = s1;
			if (a < b)
			{
				*x1 = a;
				*x2 = b;
				return TRUE;
			}
		}
		i++;
	}
	sb->spans_clipped++;
	return FALSE;
}

U0 UTSpanPunch(CUTSpanBuf *sb, I64 y, I64 x1, I64 x2)
{//mark [x1,x2) drawn: split/remove open segments. SoftDrv occlusion update.
	CUTSpanRow *r;
	CUTSpanSeg	tmp_seg[UT_SPAN_MAX_SEGS];
	I64			tn;
	I64			i;
	I64			s0;
	I64			s1;

	if (!sb || y < 0 || y >= sb->height)
		return;
	if (x1 < 0) x1 = 0;
	if (x2 > sb->width) x2 = sb->width;
	if (x1 >= x2)
		return;
	r  = &sb->row[y];
	tn = 0;
	i  = 0;
	while (i < r->n)
	{
		s0 = r->seg[i].start;
		s1 = r->seg[i].end;
		if (s1 <= x1 || s0 >= x2)
		{
			if (tn < UT_SPAN_MAX_SEGS)
			{
				tmp_seg[tn].start = s0;
				tmp_seg[tn].end   = s1;
				tn++;
			}
		}
		else
		{
			if (s0 < x1 && tn < UT_SPAN_MAX_SEGS)
			{
				tmp_seg[tn].start = s0;
				tmp_seg[tn].end   = x1;
				tn++;
			}
			if (s1 > x2 && tn < UT_SPAN_MAX_SEGS)
			{
				tmp_seg[tn].start = x2;
				tmp_seg[tn].end   = s1;
				tn++;
			}
		}
		i++;
	}
	r->n = tn;
	if (tn > 0)
		MemCopy(r->seg, tmp_seg, tn * sizeof(CUTSpanSeg));
	sb->spans_drawn++;
}

I64 UTSpanOpenCount(CUTSpanBuf *sb)
{
	I64 y;
	I64 n;
	I64 i;

	n = 0;
	y = 0;
	while (y < sb->height)
	{
		i = 0;
		while (i < sb->row[y].n)
		{
			n += sb->row[y].seg[i].end - sb->row[y].seg[i].start;
			i++;
		}
		y++;
	}
	return n;
}
