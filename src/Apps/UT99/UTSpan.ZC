// UTSpan.ZC - SoftDrv FSpan / FSpanBuffer (UnSpan.h).
//
// SoftDrv SpanBased=1. Screen holds free (undrawn) [start,end) runs per Y.
// Render FSpanBuffer::CopyFromRasterUpdate claims raster ∩ open into Facet.Span
// and punches the screen. SoftDrv DrawComplexSurface / DrawGouraudPolygon then
// walks Facet.Span->Index[y] linked list (every FSpan on the row).
//
// This buffer is the screen open set. Draw clips against it then punches.
// Overflow must not drop leftover opens — dropping them seals the view black.

#define UT_SPAN_MAX_ROWS	1200
#define UT_SPAN_MAX_SEGS	64		//UnSpan grows from FMemStack; fixed pool here
#define UT_SPAN_MAX_HIT		32		//intersect results per row for one raster

class CUTSpanSeg
{
	I64 start;
	I64 end;
};

class CUTSpanRow
{
	I64			n;
	CUTSpanSeg	seg[UT_SPAN_MAX_SEGS];
};

class CUTSpanBuf
{
	I64			width;
	I64			height;
	CUTSpanRow	row[UT_SPAN_MAX_ROWS];
	I64			spans_drawn;
	I64			spans_clipped;
	I64			punch_abort;	//overflow refused punch (kept opens)
};

U0 UTSpanClear(CUTSpanBuf *sb, I64 w, I64 h)
{//AllocIndexForScreen: one open [0,w) per row. SoftDrv Lock + ClearScreen.
	I64 y;

	if (h > UT_SPAN_MAX_ROWS)
		h = UT_SPAN_MAX_ROWS;
	if (w < 1)
		w = 1;
	sb->width  = w;
	sb->height = h;
	sb->spans_drawn   = 0;
	sb->spans_clipped = 0;
	sb->punch_abort   = 0;
	y = 0;
	while (y < h)
	{
		sb->row[y].n = 1;
		sb->row[y].seg[0].start = 0;
		sb->row[y].seg[0].end   = w;
		y++;
	}
}

U0 UTSpanEmpty(CUTSpanBuf *sb, I64 w, I64 h)
{//fully occluded
	I64 y;

	if (h > UT_SPAN_MAX_ROWS)
		h = UT_SPAN_MAX_ROWS;
	sb->width  = w;
	sb->height = h;
	sb->spans_drawn   = 0;
	sb->spans_clipped = 0;
	sb->punch_abort   = 0;
	y = 0;
	while (y < h)
	{
		sb->row[y].n = 0;
		y++;
	}
}

I64 UTSpanIntersect(CUTSpanBuf *sb, I64 y, I64 x1, I64 x2,
	I64 *out_a, I64 *out_b, I64 max_out)
{//raster ∩ open segs. SoftDrv: for (FSpan* S=Index[y]; S; S=S->Next).
	CUTSpanRow *r;
	I64 i;
	I64 n;
	I64 a;
	I64 b;
	I64 s0;
	I64 s1;

	n = 0;
	if (!sb || !out_a || !out_b || max_out < 1)
		return 0;
	if (y < 0 || y >= sb->height)
		return 0;
	if (x1 < 0) x1 = 0;
	if (x2 > sb->width) x2 = sb->width;
	if (x1 >= x2)
		return 0;
	r = &sb->row[y];
	i = 0;
	while (i < r->n && n < max_out)
	{
		s0 = r->seg[i].start;
		s1 = r->seg[i].end;
		a = x1;
		b = x2;
		if (a < s0) a = s0;
		if (b > s1) b = s1;
		if (a < b)
		{
			out_a[n] = a;
			out_b[n] = b;
			n++;
		}
		i++;
	}
	if (n == 0)
		sb->spans_clipped++;
	return n;
}

Bool UTSpanClip(CUTSpanBuf *sb, I64 y, I64 *x1, I64 *x2)
{//first overlapping open only. Prefer UTSpanIntersect for SoftDrv fill.
	I64 a[1];
	I64 b[1];
	I64 n;

	n = UTSpanIntersect(sb, y, *x1, *x2, a, b, 1);
	if (n < 1)
		return FALSE;
	*x1 = a[0];
	*x2 = b[0];
	return TRUE;
}

Bool UTSpanBoxVisible(CUTSpanBuf *sb, I64 x1, I64 y1, I64 x2, I64 y2)
{//FSpanBuffer::BoxIsVisible — any open pixel in AABB.
	I64 y;
	I64 i;
	CUTSpanRow *r;
	I64 s0;
	I64 s1;

	if (!sb)
		return TRUE;
	if (y1 < 0) y1 = 0;
	if (y2 > sb->height) y2 = sb->height;
	if (x1 < 0) x1 = 0;
	if (x2 > sb->width) x2 = sb->width;
	if (x1 >= x2 || y1 >= y2)
		return FALSE;
	y = y1;
	while (y < y2)
	{
		r = &sb->row[y];
		i = 0;
		while (i < r->n)
		{
			s0 = r->seg[i].start;
			s1 = r->seg[i].end;
			if (x2 > s0 && x1 < s1)
				return TRUE;
			i++;
		}
		y++;
	}
	return FALSE;
}

U0 UTSpanPunch(CUTSpanBuf *sb, I64 y, I64 x1, I64 x2)
{//remove [x1,x2) from open set. SoftDrv occlusion update (screen side of
 //CopyFromRasterUpdate). Abort whole row update on pool overflow — never
 //drop leftover opens (dropping them seals near walls black).
	CUTSpanRow *r;
	CUTSpanSeg	tmp_seg[UT_SPAN_MAX_SEGS];
	I64			tn;
	I64			i;
	I64			s0;
	I64			s1;
	Bool		overflow;

	if (!sb || y < 0 || y >= sb->height)
		return;
	if (x1 < 0) x1 = 0;
	if (x2 > sb->width) x2 = sb->width;
	if (x1 >= x2)
		return;
	r  = &sb->row[y];
	tn = 0;
	overflow = FALSE;
	i  = 0;
	while (i < r->n)
	{
		s0 = r->seg[i].start;
		s1 = r->seg[i].end;
		if (s1 <= x1 || s0 >= x2)
		{
			if (tn >= UT_SPAN_MAX_SEGS)
			{
				overflow = TRUE;
				goto punch_done;
			}
			tmp_seg[tn].start = s0;
			tmp_seg[tn].end   = s1;
			tn++;
		}
		else
		{
			if (s0 < x1)
			{
				if (tn >= UT_SPAN_MAX_SEGS)
				{
					overflow = TRUE;
					goto punch_done;
				}
				tmp_seg[tn].start = s0;
				tmp_seg[tn].end   = x1;
				tn++;
			}
			if (s1 > x2)
			{
				if (tn >= UT_SPAN_MAX_SEGS)
				{
					overflow = TRUE;
					goto punch_done;
				}
				tmp_seg[tn].start = x2;
				tmp_seg[tn].end   = s1;
				tn++;
			}
		}
		i++;
	}
punch_done:
	if (overflow)
	{
		sb->punch_abort++;
		return;
	}
	r->n = tn;
	if (tn > 0)
		MemCopy(r->seg, tmp_seg, tn * sizeof(CUTSpanSeg));
	sb->spans_drawn++;
}

I64 UTSpanOpenCount(CUTSpanBuf *sb)
{
	I64 y;
	I64 n;
	I64 i;

	n = 0;
	if (!sb)
		return 0;
	y = 0;
	while (y < sb->height)
	{
		i = 0;
		while (i < sb->row[y].n)
		{
			n += sb->row[y].seg[i].end - sb->row[y].seg[i].start;
			i++;
		}
		y++;
	}
	return n;
}

U0 UTSpanCopy(CUTSpanBuf *dst, CUTSpanBuf *src)
{//= FSpanBuffer index copy for portal child Span.
	I64 y;
	I64 n;

	if (!dst || !src)
		return;
	dst->width = src->width;
	dst->height = src->height;
	dst->spans_drawn = 0;
	dst->spans_clipped = 0;
	dst->punch_abort = 0;
	y = 0;
	while (y < src->height)
	{
		n = src->row[y].n;
		if (n > UT_SPAN_MAX_SEGS)
			n = UT_SPAN_MAX_SEGS;
		dst->row[y].n = n;
		if (n > 0)
			MemCopy(dst->row[y].seg, src->row[y].seg,
				n * sizeof(CUTSpanSeg));
		y++;
	}
}

U0 UTSpanAnd(CUTSpanBuf *dst, CUTSpanBuf *mask)
{//= dst opens ∩ mask opens (portal scissor ∩ screen open).
	I64 y;
	I64 i;
	I64 j;
	I64 tn;
	I64 a;
	I64 b;
	I64 s0;
	I64 s1;
	I64 m0;
	I64 m1;
	CUTSpanSeg tmp_seg[UT_SPAN_MAX_SEGS];
	CUTSpanRow *dr;
	CUTSpanRow *mr;

	if (!dst || !mask)
		return;
	y = 0;
	while (y < dst->height && y < mask->height)
	{
		dr = &dst->row[y];
		mr = &mask->row[y];
		tn = 0;
		i = 0;
		while (i < dr->n && tn < UT_SPAN_MAX_SEGS)
		{
			s0 = dr->seg[i].start;
			s1 = dr->seg[i].end;
			j = 0;
			while (j < mr->n && tn < UT_SPAN_MAX_SEGS)
			{
				m0 = mr->seg[j].start;
				m1 = mr->seg[j].end;
				a = s0;
				b = s1;
				if (a < m0) a = m0;
				if (b > m1) b = m1;
				if (a < b)
				{
					tmp_seg[tn].start = a;
					tmp_seg[tn].end = b;
					tn++;
				}
				j++;
			}
			i++;
		}
		dr->n = tn;
		if (tn > 0)
			MemCopy(dr->seg, tmp_seg, tn * sizeof(CUTSpanSeg));
		y++;
	}
}

U0 UTSpanRasterConvex(CUTSpanBuf *sb, F64 *sx, F64 *sy, I64 n)
{//= SetupRaster + AllocIndex for convex portal poly → open spans.
 //sb starts Empty; scanline fill [x0,x1) per Y.
	I64 y;
	I64 y0;
	I64 y1;
	I64 i;
	I64 j;
	F64 x_l;
	F64 x_r;
	F64 x;
	F64 y_a;
	F64 y_b;
	F64 x_a;
	F64 x_b;
	F64 t;
	I64 ix0;
	I64 ix1;
	CUTSpanRow *r;

	if (!sb || !sx || !sy || n < 3)
		return;
	UTSpanEmpty(sb, sb->width, sb->height);
	y0 = ToI64(sy[0]);
	y1 = y0;
	i = 1;
	while (i < n)
	{
		y = ToI64(sy[i]);
		if (y < y0) y0 = y;
		if (y > y1) y1 = y;
		i++;
	}
	if (y0 < 0) y0 = 0;
	if (y1 >= sb->height) y1 = sb->height - 1;
	y = y0;
	while (y <= y1)
	{
		x_l = 1e30;
		x_r = -1e30;
		i = 0;
		while (i < n)
		{
			j = i + 1;
			if (j >= n)
				j = 0;
			y_a = sy[i];
			y_b = sy[j];
			x_a = sx[i];
			x_b = sx[j];
			if ((y_a <= ToF64(y) && y_b > ToF64(y)) ||
				(y_b <= ToF64(y) && y_a > ToF64(y)))
			{
				if (y_b != y_a)
				{
					t = (ToF64(y) - y_a) / (y_b - y_a);
					x = x_a + t * (x_b - x_a);
					if (x < x_l) x_l = x;
					if (x > x_r) x_r = x;
				}
			}
			i++;
		}
		if (x_r > x_l)
		{
			ix0 = ToI64(x_l);
			ix1 = ToI64(x_r) + 1;
			if (ix0 < 0) ix0 = 0;
			if (ix1 > sb->width) ix1 = sb->width;
			if (ix0 < ix1)
			{
				r = &sb->row[y];
				r->n = 1;
				r->seg[0].start = ix0;
				r->seg[0].end = ix1;
			}
		}
		y++;
	}
}

CUTSpanBuf	ut_span_scratch;	//portal raster / punch scratch (not screen)

U0 UTSpanPunchPoly(CUTSpanBuf *sb, F64 *sx, F64 *sy, I64 n)
{//occlude convex portal silhouette from screen open (PF_Occlude).
	I64 y;

	if (!sb || n < 3)
		return;
	ut_span_scratch.width = sb->width;
	ut_span_scratch.height = sb->height;
	UTSpanRasterConvex(&ut_span_scratch, sx, sy, n);
	y = 0;
	while (y < sb->height)
	{
		if (ut_span_scratch.row[y].n > 0)
			UTSpanPunch(sb, y, ut_span_scratch.row[y].seg[0].start,
				ut_span_scratch.row[y].seg[0].end);
		y++;
	}
}
