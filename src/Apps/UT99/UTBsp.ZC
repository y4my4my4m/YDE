// UTBsp.ZC - FBspNode / FBspSurf / FVert / EPolyFlags from UnObj.h.
//
// Node Serialize is not in the public tree. Structures and flags are fact;
// a resident node array can be walked for point-side tests once filled.

#define UT_MAX_NODE_VERTS	16
#define UT_MAX_ZONES		64
#define UT_INDEX_NONE		-1

#define UT_NF_NOT_CSG			0x01
#define UT_NF_SHOOT_THROUGH		0x02
#define UT_NF_NOT_VIS_BLOCKING	0x04
#define UT_NF_POLY_OCCLUDED		0x08
#define UT_NF_BOX_OCCLUDED		0x10
#define UT_NF_IS_NEW			0x20
#define UT_NF_IS_FRONT			0x40
#define UT_NF_IS_BACK			0x80

#define UT_PF_INVISIBLE			0x00000001
#define UT_PF_MASKED			0x00000002
#define UT_PF_TRANSLUCENT		0x00000004
#define UT_PF_NOT_SOLID			0x00000008
#define UT_PF_ENVIRONMENT		0x00000010
#define UT_PF_FORCE_VIEW_ZONE	0x00000040
#define UT_PF_FAKE_BACKDROP		0x00000080	//UnObj.h — sky portal
#define UT_PF_TWO_SIDED			0x00000100
#define UT_PF_NO_SMOOTH			0x00000800
#define UT_PF_FLAT				0x00004000
#define UT_PF_NO_MERGE			0x00010000
#define UT_PF_SPECIAL_LIT		0x00100000
#define UT_PF_UNLIT				0x40000000	//UnObj.h — fullbright
#define UT_PF_PORTAL			0x04000000	//UnObj.h — portal between iZones
#define UT_PF_MIRRORED			0x08000000
#define UT_PORTAL_MAX			3		//UnRender MAX_FRAME_RECURSION soft cap
//Lightmap byte scale: UT_LM_UNIT is unit light, so two overlapping lights
//can reach 2x before clamping. The composite divides by the same constant.
#define UT_LM_UNIT				128.0
//ShadowMapGen filters the shadow bits rather than sampling them: a 3x3
//kernel (centre 64, edge 40, corner 24, sum 320) scaled so a fully lit
//neighbourhood is 255. Epic packs it into a 7-bit sliding-window table;
//the kernel is the algorithm, the table is the optimisation.
#define UT_SHADOW_SUM			320.0

#define UT_PORTAL_NESTS_MAX		1		//nested walks per frame
#define UT_SKY_NESTS_MAX		1

I64 ut_portal_depth	= 0;
I64 ut_portal_zone	= -1;	//-1 main; else opposite iZone nest filter
I64 ut_portal_nests	= 0;	//nested Walk count this frame
I64 ut_sky_frames	= 0;	//sky nests this frame
//One scissor per recursion depth. A single shared buffer made the nested
//walk receive span_opaque aliased to the buffer it then re-rasterized and
//self-ANDed, which never terminated.
CUTSpanBuf ut_portal_scissor[UT_PORTAL_MAX + 2];

extern I64 UTZoneFindWarpNear(F64 *org);
extern I64 UTZoneWarpPair(I64 from_i);
extern U0 UTZoneChildFramePush(CUTCanvas *c, I64 from_i, I64 to_i, F64 *eye);
extern U0 UTZoneChildFramePop(CUTCanvas *c, F64 *eye);
extern I64 ut_view_pitch;
extern I64 ut_view_yaw;
extern I64 ut_view_roll;
extern F64 ut_con_fov;
extern Bool ut_sky_ready;
extern F64 ut_sky_origin[3];
extern I64 ut_sky_nests;

#define UT_BSP_MAX_NODES		4096
#define UT_BSP_MAX_POINTS		16384
#define UT_BSP_MAX_VECTS		4096
#define UT_BSP_MAX_SURFS		4096
#define UT_BSP_MAX_VERTS		65536

class CUTBspNode
{//FBspNode. In-memory layout; on-disk uses AR_INDEX (Moloch wire recipe).
	F64	plane[4];		//X Y Z W
	U64	zone_mask;
	I64	i_vert_pool;
	I64	i_surf;
	I64	i_back;
	I64	i_front;
	I64	i_plane;
	I64	i_collision_bound;
	I64	i_render_bound;
	U8	i_zone[2];
	U8	num_vertices;
	U8	node_flags;
	I64	i_leaf[2];
};

class CUTBspSurf
{
	I64	texture;		//object ref; stored opaque here
	U32	poly_flags;
	I64	p_base;
	I64	v_normal;
	I64	v_texture_u;
	I64	v_texture_v;
	I64	i_light_map;
	I64	i_brush_poly;
	I16	pan_u;
	I16	pan_v;
	I64	actor;			//object ref
};

class CUTLightMapIdx
{//FLightMapIndex — UnObj.h. SoftDrv samples LightBits[DataOffset+…]
	I64	 data_offset;
	F64	 pan[3];
	I64	 u_clamp;
	I64	 v_clamp;
	F64	 u_scale;
	F64	 v_scale;
	I64	 i_light_actors;
};

class CUTBspVert
{//FVert: compact point index + side
	I64 p_vertex;
	I64 i_side;
};

class CUTVec3
{
	F64 v[3];
};

class CUTBsp
{
	CUTBspNode	*nodes;
	I64			 num_nodes;
	CUTVec3		*points;
	I64			 num_points;
	CUTVec3		*vectors;
	I64			 num_vectors;
	CUTBspSurf	*surfs;
	I64			 num_surfs;
	CUTBspVert	*verts;
	I64			 num_verts;
	CUTTex		**surf_tex;	//per-surf resolved Texture*; owned as pointer table
	I64			 num_zones;
	I64			 zone_actor[UT_MAX_ZONES];	//ZoneInfo export ref per zone
	U8			*surf_zone;	//zone index per surf, from the owning node
	U8			*lm_done;	//lightmap already accumulated
	CUTLightMapIdx	*light_maps;
	I64			 num_light_maps;
	U8			*light_bits;
	I64			 light_bits_n;
	I64			*lights;		//flat light-actor refs; NULL-terminated runs
	I64			 num_lights;
	U8			*lm_rgb;		//built RGB lightmaps, concatenated
	I64			 lm_rgb_n;
	I64			*lm_off;		//byte offset per FLightMapIndex, -1 = none
	U32			*fog_rgb;		//SoftDrv FogMap Photon DWORD* stand-in
	I64			 fog_rgb_n;
};

//Zone ambient, indexed by BSP zone. UTZone fills these from the ZoneInfo
//actors once the map is scanned; the lightmap build reads them as its base.
I64 ut_shadow_w[9] = {24, 40, 24, 40, 64, 40, 24, 40, 24};

//OccludeBsp separates traversal from drawing: it walks the tree collecting
//visible nodes into bins, then rendering runs bin by bin. Drawing inline
//during the walk interleaves opaque and blended surfaces, which is why span
//occlusion alone could not order the frame. Bin 0 occludes and claims spans;
//1 is masked; 2 is blended and draws last.
#define UT_DRAW_BINS		3
#define UT_DRAW_MAX			8192

I64 ut_draw_bin[UT_DRAW_BINS][UT_DRAW_MAX];
I64 ut_draw_bin_n[UT_DRAW_BINS];
Bool ut_draw_collect = FALSE;	//TRUE while the walk is collecting
F64 ut_order_first = 0.0;
F64 ut_order_last = 0.0;
Bool ut_order_logged = FALSE;
Bool ut_lm_dumped = FALSE;

I64 UTBspDrawBinOf(U32 pf)
{
	if (pf & UT_PF_TRANSLUCENT)
		return 2;
	if (pf & (UT_PF_MASKED | UT_PF_TWO_SIDED))
		return 1;
	return 0;
}

F64 ut_zone_amb_r[UT_MAX_ZONES];
F64 ut_zone_amb_g[UT_MAX_ZONES];
F64 ut_zone_amb_b[UT_MAX_ZONES];

CUTBsp *ut_bsp = NULL;	//active world BSP; here so UTMap/UTWeap/UTGame see it before UT99

//Forward call from portal nest before body — after CUTBsp defined
extern U0 UTBspWalkFTB(CUTCanvas *c, CUTBsp *b, I64 ni, F64 *eye,
	CUTTex *fallback, CUTSpanBuf *span, I64 depth);

extern Bool	ut_zone_in_water;
extern Bool	ut_zone_in_hurt;

//SoftDrv SampleLight bind — facet sets these; span fill samples
CUTBsp		*ut_lm_bsp	= NULL;
CUTBspSurf	*ut_lm_surf	= NULL;
F64			ut_fog_centroid[3]	= {0, 0, 0};

CUTBsp *UTBspNew()
{
	CUTBsp *b = CAlloc(sizeof(CUTBsp));
	return b;
}

U0 UTBspFree(CUTBsp *b)
{
	if (!b)
		return;
	if (b->nodes)   Free(b->nodes);
	if (b->points)  Free(b->points);
	if (b->vectors) Free(b->vectors);
	if (b->surfs)   Free(b->surfs);
	if (b->verts)   Free(b->verts);
	if (b->surf_tex) Free(b->surf_tex);
	if (b->light_maps) Free(b->light_maps);
	if (b->lights) Free(b->lights);
	if (b->lm_rgb) Free(b->lm_rgb);
	if (b->lm_off) Free(b->lm_off);
	if (b->surf_zone) Free(b->surf_zone);
	if (b->lm_done) Free(b->lm_done);
	if (b->light_bits) Free(b->light_bits);
	if (b->fog_rgb) Free(b->fog_rgb);
	Free(b);
}

F64 UTBspPlaneDot(F64 *plane, F64 *p)
{
	return plane[0] * p[0] + plane[1] * p[1] + plane[2] * p[2] - plane[3];
}

I64 UTBspPointLeaf(CUTBsp *b, F64 *p)
{//walk iFront/iBack until a leaf. INDEX_NONE if empty tree.
	I64		i;
	CUTBspNode *n;
	F64		d;

	if (!b || b->num_nodes <= 0)
		return UT_INDEX_NONE;
	i = 0;
	while (i != UT_INDEX_NONE && i >= 0 && i < b->num_nodes)
	{
		n = &b->nodes[i];
		d = UTBspPlaneDot(n->plane, p);
		if (d >= 0.0)
		{
			if (n->i_front == UT_INDEX_NONE)
				return n->i_leaf[1];
			i = n->i_front;
		}
		else
		{
			if (n->i_back == UT_INDEX_NONE)
				return n->i_leaf[0];
			i = n->i_back;
		}
	}
	return UT_INDEX_NONE;
}

I64 UTBspPointZone(CUTBsp *b, F64 *p)
{//iZone on terminating leaf. Zone 0 = solid/outside (UnObj PointRegion).
 //UnObj: iBack = child on normal (front) side; iFront = back side.
 //Moloch wire stores Epic iBack first as i_front — d>=0 walks i_front.
 //Defined here (before facet draw) — ZealC needs callee above or extern.
	I64 i;
	CUTBspNode *n;
	F64 d;

	if (!b || b->num_nodes <= 0)
		return 0;
	i = 0;
	while (i >= 0 && i < b->num_nodes)
	{
		n = &b->nodes[i];
		d = UTBspPlaneDot(n->plane, p);
		if (d >= 0.0)
		{
			if (n->i_front == UT_INDEX_NONE)
				return n->i_zone[1];
			i = n->i_front;
		}
		else
		{
			if (n->i_back == UT_INDEX_NONE)
				return n->i_zone[0];
			i = n->i_back;
		}
	}
	return 0;
}

CUTBsp *UTBspBuildDemoRoom()
{//six outward planes as a trivial BSP for the demo viewer. Not a real .unr.
	CUTBsp		*b;
	F64			 half = 512.0;
	F64			 tall = 128.0;

	b = UTBspNew();
	b->num_nodes   = 6;
	b->num_points  = 8;
	b->num_vectors = 6;
	b->num_surfs   = 6;
	b->nodes   = CAlloc(b->num_nodes * sizeof(CUTBspNode));
	b->points  = CAlloc(b->num_points * sizeof(CUTVec3));
	b->vectors = CAlloc(b->num_vectors * sizeof(CUTVec3));
	b->surfs   = CAlloc(b->num_surfs * sizeof(CUTBspSurf));

	UTVecSet(b->points[0].v, -half, -half, 0.0);
	UTVecSet(b->points[1].v,  half, -half, 0.0);
	UTVecSet(b->points[2].v,  half,  half, 0.0);
	UTVecSet(b->points[3].v, -half,  half, 0.0);
	UTVecSet(b->points[4].v, -half, -half, tall);
	UTVecSet(b->points[5].v,  half, -half, tall);
	UTVecSet(b->points[6].v,  half,  half, tall);
	UTVecSet(b->points[7].v, -half,  half, tall);

	UTVecSet(b->vectors[0].v,  0.0,  0.0,  1.0);
	UTVecSet(b->vectors[1].v,  0.0,  0.0, -1.0);
	UTVecSet(b->vectors[2].v,  1.0,  0.0,  0.0);
	UTVecSet(b->vectors[3].v, -1.0,  0.0,  0.0);
	UTVecSet(b->vectors[4].v,  0.0,  1.0,  0.0);
	UTVecSet(b->vectors[5].v,  0.0, -1.0,  0.0);

	//floor z=0, normal +Z, W = n·p = 0
	b->nodes[0].plane[0] = 0.0; b->nodes[0].plane[1] = 0.0;
	b->nodes[0].plane[2] = 1.0; b->nodes[0].plane[3] = 0.0;
	b->nodes[0].i_front = 1; b->nodes[0].i_back = UT_INDEX_NONE;
	b->nodes[0].i_leaf[0] = UT_INDEX_NONE; b->nodes[0].i_leaf[1] = 0;
	b->nodes[0].num_vertices = 4; b->nodes[0].i_surf = 0;

	//ceiling z=tall
	b->nodes[1].plane[0] = 0.0; b->nodes[1].plane[1] = 0.0;
	b->nodes[1].plane[2] = -1.0; b->nodes[1].plane[3] = -tall;
	b->nodes[1].i_front = 2; b->nodes[1].i_back = UT_INDEX_NONE;
	b->nodes[1].i_leaf[0] = UT_INDEX_NONE; b->nodes[1].i_leaf[1] = 0;
	b->nodes[1].num_vertices = 4; b->nodes[1].i_surf = 1;

	//+X wall
	b->nodes[2].plane[0] = -1.0; b->nodes[2].plane[1] = 0.0;
	b->nodes[2].plane[2] = 0.0; b->nodes[2].plane[3] = -half;
	b->nodes[2].i_front = 3; b->nodes[2].i_back = UT_INDEX_NONE;
	b->nodes[2].num_vertices = 4; b->nodes[2].i_surf = 2;

	//-X wall
	b->nodes[3].plane[0] = 1.0; b->nodes[3].plane[1] = 0.0;
	b->nodes[3].plane[2] = 0.0; b->nodes[3].plane[3] = -half;
	b->nodes[3].i_front = 4; b->nodes[3].i_back = UT_INDEX_NONE;
	b->nodes[3].num_vertices = 4; b->nodes[3].i_surf = 3;

	//+Y wall
	b->nodes[4].plane[0] = 0.0; b->nodes[4].plane[1] = -1.0;
	b->nodes[4].plane[2] = 0.0; b->nodes[4].plane[3] = -half;
	b->nodes[4].i_front = 5; b->nodes[4].i_back = UT_INDEX_NONE;
	b->nodes[4].num_vertices = 4; b->nodes[4].i_surf = 4;

	//-Y wall -> inside leaf
	b->nodes[5].plane[0] = 0.0; b->nodes[5].plane[1] = 1.0;
	b->nodes[5].plane[2] = 0.0; b->nodes[5].plane[3] = -half;
	b->nodes[5].i_front = UT_INDEX_NONE; b->nodes[5].i_back = UT_INDEX_NONE;
	b->nodes[5].i_leaf[0] = UT_INDEX_NONE; b->nodes[5].i_leaf[1] = 1;
	b->nodes[5].num_vertices = 4; b->nodes[5].i_surf = 5;

	return b;
}

Bool UTBspReadNode(CUTArc *ar, CUTBspNode *n)
{//Moloch / ut99-bsp-extractor FBspNode<<. Not the 64-byte memory image.
	n->plane[0] = UTArcF32(ar);
	n->plane[1] = UTArcF32(ar);
	n->plane[2] = UTArcF32(ar);
	n->plane[3] = UTArcF32(ar);
	//ZoneMask QWORD — unused by SoftDrv draw path
	UTArcU32(ar);
	UTArcU32(ar);
	n->zone_mask = 0;
	n->node_flags = UTArcU8(ar);
	n->i_vert_pool = UTArcIndex(ar);
	n->i_surf = UTArcIndex(ar);
	//iChild[0] then iChild[1]. Epic's field names contradict their comments
	//here, so the assignment is settled by measurement: mapping iChild[0] to
	//the near child made the walk collect far-to-near (first node 3638 units
	//out, last 364), which makes span occlusion useless.
	n->i_back = UTArcIndex(ar);
	n->i_front = UTArcIndex(ar);
	n->i_plane = UTArcIndex(ar);
	n->i_collision_bound = UTArcIndex(ar);
	n->i_render_bound = UTArcIndex(ar);
	n->i_zone[0] = UTArcIndex(ar) & 0xFF;
	n->i_zone[1] = UTArcIndex(ar) & 0xFF;
	n->num_vertices = UTArcU8(ar);
	n->i_leaf[0] = UTArcI32(ar);
	n->i_leaf[1] = UTArcI32(ar);
	return !ar->err;
}

Bool UTBspReadSurf(CUTArc *ar, CUTBspSurf *s)
{
	s->texture = UTArcIndex(ar);
	s->poly_flags = UTArcU32(ar);
	s->p_base = UTArcIndex(ar);
	s->v_normal = UTArcIndex(ar);
	s->v_texture_u = UTArcIndex(ar);
	s->v_texture_v = UTArcIndex(ar);
	s->i_light_map = UTArcIndex(ar);
	s->i_brush_poly = UTArcIndex(ar);
	s->pan_u = UTRdI16(ar->data + ar->pos);
	ar->pos += 2;
	s->pan_v = UTRdI16(ar->data + ar->pos);
	ar->pos += 2;
	s->actor = UTArcIndex(ar);
	return !ar->err;
}

Bool UTBspLoadModel(CUTPackage *pkg, I64 exp_i, CUTBsp *b)
{//UModel native after None: FBox(25)+FSphere(16) then Vectors Points Nodes Surfs Verts.
	CUTArc ar;
	CUTExport *e;
	I64 i;
	I64 n;
	I64 endpos;
	I64 nz;
	I64 save;
	I64 p_nz;
	I64 p_lm;
	I64 p_bits;

	if (!pkg || !b || exp_i < 0 || exp_i >= pkg->export_count)
		return FALSE;
	e = &pkg->exports[exp_i];
	if (!UTPkgArcExport(pkg, exp_i, &ar))
		return FALSE;
	UTPropSkipStack(&ar, e->object_flags);
	if (!UTPropSkipAll(&ar, pkg))
	{
		ar.err = FALSE;
		//Model exports are usually a lone None; seek past name index 1 (None)
		UTArcSeek(&ar, e->serial_offset);
		UTArcIndex(&ar);
	}
	endpos = e->serial_offset + e->serial_size;

	//FBox: Min Max IsValid(U8)
	ar.pos += 12 + 12 + 1;
	//FSphere: centre + radius (ver>61)
	ar.pos += 12;
	if (pkg->file_version > 61)
		ar.pos += 4;
	if (ar.pos >= endpos)
		return FALSE;

	n = UTArcIndex(&ar);
	if (ar.err || n < 0 || n > UT_BSP_MAX_VECTS)
		return FALSE;
	b->num_vectors = n;
	b->vectors = CAlloc(n * sizeof(CUTVec3));
	i = 0;
	while (i < n)
	{
		b->vectors[i].v[0] = UTArcF32(&ar);
		b->vectors[i].v[1] = UTArcF32(&ar);
		b->vectors[i].v[2] = UTArcF32(&ar);
		i++;
	}

	n = UTArcIndex(&ar);
	if (ar.err || n < 0 || n > UT_BSP_MAX_POINTS)
		return FALSE;
	b->num_points = n;
	b->points = CAlloc(n * sizeof(CUTVec3));
	i = 0;
	while (i < n)
	{
		b->points[i].v[0] = UTArcF32(&ar);
		b->points[i].v[1] = UTArcF32(&ar);
		b->points[i].v[2] = UTArcF32(&ar);
		i++;
	}

	n = UTArcIndex(&ar);
	if (ar.err || n < 0 || n > UT_BSP_MAX_NODES)
		return FALSE;
	b->num_nodes = n;
	b->nodes = CAlloc(n * sizeof(CUTBspNode));
	i = 0;
	while (i < n)
	{
		if (!UTBspReadNode(&ar, &b->nodes[i]))
			return FALSE;
		i++;
	}

	n = UTArcIndex(&ar);
	if (ar.err || n < 0 || n > UT_BSP_MAX_SURFS)
		return FALSE;
	b->num_surfs = n;
	b->surfs = CAlloc(n * sizeof(CUTBspSurf));
	i = 0;
	while (i < n)
	{
		if (!UTBspReadSurf(&ar, &b->surfs[i]))
			return FALSE;
		i++;
	}

	n = UTArcIndex(&ar);
	if (ar.err || n < 0 || n > UT_BSP_MAX_VERTS)
		return FALSE;
	b->num_verts = n;
	b->verts = CAlloc(n * sizeof(CUTBspVert));
	i = 0;
	while (i < n)
	{
		b->verts[i].p_vertex = UTArcIndex(&ar);
		b->verts[i].i_side = UTArcIndex(&ar);
		i++;
	}

	//NumSharedSides then NumZones, both INT32, then that many
	//FZoneProperties: ZoneActor(index) + Connectivity + Visibility (QWORDs).
	//Omitting this read LightMap's count from zone bytes: 25 instead of 1654.
	if (!ar.err && ar.pos < endpos)
	{
		UTArcI32(&ar);				//NumSharedSides
		nz = UTArcI32(&ar);
		if (nz < 0 || nz > UT_MAX_ZONES)
			nz = 0;
		b->num_zones = nz;
		i = 0;
		while (i < nz && !ar.err)
		{
			b->zone_actor[i] = UTArcIndex(&ar);	//ZoneInfo export ref
			ar.pos += 16;						//Connectivity + Visibility
			i++;
		}
	}

	//Polys UObject* — skip one index (UModel::Serialize)
	if (!ar.err && ar.pos < endpos)
		UTArcIndex(&ar);

	//LightMap TArray<FLightMapIndex>
	b->num_light_maps = 0;
	b->light_maps = NULL;
	b->light_bits_n = 0;
	b->light_bits = NULL;
	b->fog_rgb = NULL;
	b->fog_rgb_n = 0;
	if (!ar.err && ar.pos < endpos)
	{
		n = UTArcIndex(&ar);
		if (!ar.err && n > 0 && n < 65536)
		{
			b->num_light_maps = n;
			b->light_maps = CAlloc(n * sizeof(CUTLightMapIdx));
			i = 0;
			while (i < n && !ar.err)
			{
				b->light_maps[i].data_offset = UTArcI32(&ar);
				b->light_maps[i].pan[0] = UTArcF32(&ar);
				b->light_maps[i].pan[1] = UTArcF32(&ar);
				b->light_maps[i].pan[2] = UTArcF32(&ar);
				b->light_maps[i].u_clamp = UTArcIndex(&ar);
				b->light_maps[i].v_clamp = UTArcIndex(&ar);
				b->light_maps[i].u_scale = UTArcF32(&ar);
				b->light_maps[i].v_scale = UTArcF32(&ar);
				b->light_maps[i].i_light_actors = UTArcI32(&ar);
				if (b->light_maps[i].u_clamp < 1)
					b->light_maps[i].u_clamp = 1;
				if (b->light_maps[i].v_clamp < 1)
					b->light_maps[i].v_clamp = 1;
				if (b->light_maps[i].u_scale < 0.0001)
					b->light_maps[i].u_scale = 1.0;
				if (b->light_maps[i].v_scale < 0.0001)
					b->light_maps[i].v_scale = 1.0;
				i++;
			}
		}
	}
	//LightBits TArray<BYTE>
	if (!ar.err && ar.pos < endpos)
	{
		n = UTArcIndex(&ar);
		if (!ar.err && n > 0 && n < (1 << 26))
		{
			b->light_bits_n = n;
			b->light_bits = CAlloc(n);
			i = 0;
			while (i < n && ar.pos < endpos)
			{
				b->light_bits[i] = UTArcU8(&ar) & 255;
				i++;
			}
		}
	}
	//Bounds, LeafHulls, Leaves, then Lights (UModel::Serialize). Lights is a
	//flat NULL-terminated run per surface; FLightMapIndex.iLightActors indexes
	//into it. FBox = Min + Max + IsValid(BYTE). FLeaf = 3 indices + QWORD.
	b->lights = NULL;
	b->num_lights = 0;
	if (!ar.err && ar.pos < endpos)
	{
		n = UTArcIndex(&ar);				//Bounds
		if (n > 0 && n < (1 << 22))
			ar.pos += n * 25;
		n = UTArcIndex(&ar);				//LeafHulls
		if (n > 0 && n < (1 << 22))
			ar.pos += n * 4;
		n = UTArcIndex(&ar);				//Leaves
		i = 0;
		while (i < n && !ar.err && ar.pos < endpos)
		{
			UTArcIndex(&ar);
			UTArcIndex(&ar);
			UTArcIndex(&ar);
			ar.pos += 8;
			i++;
		}
		n = UTArcIndex(&ar);				//Lights
		if (!ar.err && n > 0 && n < (1 << 22))
		{
			b->lights = CAlloc(n * sizeof(I64));
			i = 0;
			while (i < n && !ar.err && ar.pos < endpos)
			{
				b->lights[i] = UTArcIndex(&ar);
				i++;
			}
			b->num_lights = i;
		}
	}

	//GLightManager FogMap mip stand-in: DWORD Photon RGB from LightBits
	//density. SoftDrv FogData.Ptr = Surface.FogMap->Mips[0]->DataPtr.
	if (b->light_bits_n > 0 && b->light_bits)
	{
		b->fog_rgb_n = b->light_bits_n;
		b->fog_rgb = CAlloc(b->fog_rgb_n * sizeof(U32));
		i = 0;
		while (i < b->fog_rgb_n)
		{
			//dens = dark light → more fog photon
			n = 255 - (b->light_bits[i] & 255);
			if (n < 0) n = 0;
			if (n > 255) n = 255;
			//Default fog hue: cool blue-grey (water/zone tint overlays later)
			b->fog_rgb[i] = (n << 16) | ((n * 7 / 8) << 8) | (n * 6 / 8);
			i++;
		}
	}

	UTLog("UTBsp: Model vectors=%d points=%d nodes=%d surfs=%d verts=%d lm=%d bits=%d fog=%d\n",
		b->num_vectors, b->num_points, b->num_nodes, b->num_surfs, b->num_verts,
		b->num_light_maps, b->light_bits_n, b->fog_rgb_n);
	return b->num_nodes > 0;
}


U0 UTBspLightMapVertex(CUTBsp *b, CUTBspSurf *s, CUTLightMapIdx *lm,
	F64 *base, F64 *du, F64 *dv)
{//UnLight SetupForSurf: MapUncoords = MapCoords.Inverse().Transpose().
 //MapCoords is (Origin=Points[pBase], X=TextureU, Y=TextureV, Z=Normal), so
 //the inverse-transpose rows are the dual basis, built here with crosses.
	F64 *U;
	F64 *V;
	F64 *N;
	F64 *O;
	F64 c1[3];
	F64 c2[3];
	F64 det;
	I64 k;

	U = b->vectors[s->v_texture_u].v;
	V = b->vectors[s->v_texture_v].v;
	N = b->vectors[s->v_normal].v;
	O = b->points[s->p_base].v;

	UTVecCross(V, N, c1);
	det = UTVecDot(U, c1);
	if (det > -0.000001 && det < 0.000001)
		det = 1.0;
	UTVecCross(N, U, c2);
	k = 0;
	while (k < 3)
	{
		c1[k] /= det;
		c2[k] /= det;
		k++;
	}
	//VertexBase = Origin + XAxis*Pan.X + YAxis*Pan.Y
	k = 0;
	while (k < 3)
	{
		base[k] = O[k] + c1[k] * lm->pan[0] + c2[k] * lm->pan[1];
		du[k] = c1[k] * lm->u_scale;
		dv[k] = c2[k] * lm->v_scale;
		k++;
	}
}

U0 UTBspBuildLightMaps(CUTBsp *b)
{//LightBits is a shadow bitmask per light, not intensity: one bit per texel,
 //rows padded to bytes, ShadowMaskSpace bytes per light. Light colour comes
 //from the actors, attenuated by distance and gated by those bits.
 //UnLight: RRadiusMult = 4093/Radius^2, in range while SqrtOfs < 4096.
	I64 si;
	I64 li;
	I64 u;
	I64 v;
	I64 k;
	I64 total;
	I64 uc;
	I64 vc;
	I64 mask_u;
	I64 mask_space;
	I64 shadow;
	I64 lref;
	I64 lslot;
	I64 bitidx;
	I64 off;
	I64 built;
	I64 lit_texels;
	CUTBspSurf *s;
	CUTLightMapIdx *lm;
	CUTLight *L;
	Bool ok;
	I64 zi;
	I64 sum_lm;
	I64 max_lm;
	I64 sh_acc;
	I64 sdv;
	I64 sdu;
	I64 uu;
	I64 vv;
	F64 amb_r;
	F64 amb_g;
	F64 amb_b;
	F64 base[3];
	F64 du[3];
	F64 dv[3];
	F64 p[3];
	F64 dx;
	F64 dy;
	F64 dz;
	F64 d2;
	F64 ofs;
	F64 atten;
	F64 acc_r;
	F64 acc_g;
	F64 acc_b;
	F64 lr;
	F64 lg;
	F64 lb;
	F64 rrmult;
	F64 peak;
	F64 rad;
	F64 perp;
	F64 dist;
	F64 *nrm_l;
	F64 *org_l;
	I64 vi;

	if (!b || !b->light_maps || b->num_light_maps < 1 || !b->light_bits)
		return;
	//A surface's zone comes from a node that references it; iZone[1] is the
	//front side. Needed because ambient is a per-zone property.
	if (!b->surf_zone && b->num_surfs > 0)
	{
		b->surf_zone = CAlloc(b->num_surfs);
		si = 0;
		while (si < b->num_nodes)
		{
			k = b->nodes[si].i_surf;
			if (k >= 0 && k < b->num_surfs)
				b->surf_zone[k] = b->nodes[si].i_zone[1];
			si++;
		}
	}
	b->lm_off = CAlloc(b->num_light_maps * sizeof(I64));
	b->lm_done = CAlloc(b->num_light_maps);
	li = 0;
	while (li < b->num_light_maps)
	{
		b->lm_off[li] = -1;
		li++;
	}
	//Offsets first so one allocation holds every map.
	total = 0;
	si = 0;
	while (si < b->num_surfs)
	{
		s = &b->surfs[si];
		li = s->i_light_map;
		if (li >= 0 && li < b->num_light_maps && b->lm_off[li] < 0)
		{
			lm = &b->light_maps[li];
			b->lm_off[li] = total;
			total += lm->u_clamp * lm->v_clamp * 3;
		}
		si++;
	}
	if (total < 1)
		return;
	b->lm_rgb = CAlloc(total);
	b->lm_rgb_n = total;

	built = 0;
	lit_texels = 0;
	si = 0;
	while (si < b->num_surfs)
	{
		s = &b->surfs[si];
		li = s->i_light_map;
		ok = TRUE;
		if (li < 0 || li >= b->num_light_maps)
			ok = FALSE;
		if (ok)
		{
			lm = &b->light_maps[li];
			off = b->lm_off[li];
			//A map whose texels all resolved to zero looked unbuilt, so the
			//next surface sharing it accumulated a second time. Track built
			//state explicitly.
			if (off < 0 || b->lm_done[li] || lm->i_light_actors < 0)
				ok = FALSE;
			if (s->v_texture_u < 0 || s->v_texture_u >= b->num_vectors ||
				s->v_texture_v < 0 || s->v_texture_v >= b->num_vectors ||
				s->v_normal < 0 || s->v_normal >= b->num_vectors ||
				s->p_base < 0 || s->p_base >= b->num_points)
				ok = FALSE;
		}
		if (ok)
		{
		uc = lm->u_clamp;
		vc = lm->v_clamp;
		mask_u = (uc + 7) >> 3;
		mask_space = mask_u * vc;
		//UnLight fills the map with the zone ambient at quarter scale, then
		//adds static lights on top.
		zi = 0;
		if (b->surf_zone)
			zi = b->surf_zone[si] & (UT_MAX_ZONES - 1);
		amb_r = ut_zone_amb_r[zi] * 0.25;
		amb_g = ut_zone_amb_g[zi] * 0.25;
		amb_b = ut_zone_amb_b[zi] * 0.25;
		if (amb_r > 0.0 || amb_g > 0.0 || amb_b > 0.0)
		{
			v = 0;
			while (v < vc)
			{
				u = 0;
				while (u < uc)
				{
					vi = off + (v * uc + u) * 3;
					b->lm_rgb[vi] = ToI64(amb_r) & 255;
					b->lm_rgb[vi + 1] = ToI64(amb_g) & 255;
					b->lm_rgb[vi + 2] = ToI64(amb_b) & 255;
					u++;
				}
				v++;
			}
		}
		UTBspLightMapVertex(b, s, lm, base, du, dv);
		shadow = lm->data_offset;
		k = lm->i_light_actors;
		while (k >= 0 && k < b->num_lights && b->lights[k] != 0)
		{
			lslot = UTLightFindByExport(b->lights[k]);
			if (lslot >= 0)
			{
				L = &ut_lights[lslot];
				lr = 1.0;
				lg = 1.0;
				lb = 1.0;
				UTLightHueRGB(L->hue, L->sat, &lr, &lg, &lb);
				//Peak contribution is the light palette's value: FloatColor
				//is HSV(hue,sat,255) scaled by Brightness, then clamped per
				//channel at 127. Scaling by UT_LM_UNIT*Brightness instead
				//halved every light dimmer than half brightness.
				peak = 255.0 * L->bright;
				if (peak > 127.0)
					peak = 127.0;
				lr = lr * peak;
				lg = lg * peak;
				lb = lb * peak;
				rad = L->radius;
				if (rad < 1.0)
					rad = 1.0;
				rrmult = 4093.0 / (rad * rad);
				//ComputeFromActor: Diffuse is the light's perpendicular
				//distance to the surface plane over the radius. The mesh
				//value is shadow * Diffuse * LightSqrt[ofs], and because
				//LightSqrt carries a 1/S the radius and distance cancel
				//into falloff * cos(theta) — Lambert, folded into a table.
				nrm_l = b->vectors[s->v_normal].v;
				org_l = b->points[s->p_base].v;
				perp = (L->origin[0] - org_l[0]) * nrm_l[0] +
					(L->origin[1] - org_l[1]) * nrm_l[1] +
					(L->origin[2] - org_l[2]) * nrm_l[2];
				if (perp < 0.0)
					perp = -perp;
				v = 0;
				while (v < vc)
				{
					u = 0;
					while (u < uc)
					{
						//Filtered occlusion, not a single bit: soft edges
						//come from the neighbourhood, and a texel whose
						//neighbours are lit is partly lit itself.
						sh_acc = 0;
						sdv = -1;
						while (sdv <= 1)
						{
							vv = v + sdv;
							if (vv >= 0 && vv < vc)
							{
								sdu = -1;
								while (sdu <= 1)
								{
									uu = u + sdu;
									if (uu >= 0 && uu < uc)
									{
										bitidx = shadow + vv * mask_u +
											(uu >> 3);
										if (bitidx >= 0 &&
											bitidx < b->light_bits_n &&
											(b->light_bits[bitidx] &
											(1 << (uu & 7))))
											sh_acc += ut_shadow_w[
												(sdv + 1) * 3 + sdu + 1];
									}
									sdu++;
								}
							}
							sdv++;
						}
						if (sh_acc > 0)
						{
							vi = 0;
							while (vi < 3)
							{
								p[vi] = base[vi] + du[vi] * ToF64(u) +
									dv[vi] * ToF64(v);
								vi++;
							}
							dx = p[0] - L->origin[0];
							dy = p[1] - L->origin[1];
							dz = p[2] - L->origin[2];
							d2 = dx * dx + dy * dy + dz * dz;
							ofs = d2 * rrmult;
							if (ofs < 4096.0)
							{
								//S = dist/radius. Falloff 2S^3-3S^2+1 is the
								//curve LightSqrt bakes; cos = perp/dist.
								dist = Sqrt(d2);
								atten = Sqrt(ofs / 4096.0);
								atten = 2.0 * atten * atten * atten -
									3.0 * atten * atten + 1.0;
								if (dist > 0.001)
									atten = atten * (perp / dist);
								if (atten > 0.0)
								{
									//UT_LM_UNIT is full light; brighter
									//overlaps overbright past it.
									atten = atten *
										ToF64(sh_acc) / UT_SHADOW_SUM;
									vi = off + (v * uc + u) * 3;
									acc_r = ToF64(b->lm_rgb[vi]) + atten * lr;
									acc_g = ToF64(b->lm_rgb[vi + 1]) +
										atten * lg;
									acc_b = ToF64(b->lm_rgb[vi + 2]) +
										atten * lb;
									if (acc_r > 255.0) acc_r = 255.0;
									if (acc_g > 255.0) acc_g = 255.0;
									if (acc_b > 255.0) acc_b = 255.0;
									b->lm_rgb[vi] = ToI64(acc_r) & 255;
									b->lm_rgb[vi + 1] = ToI64(acc_g) & 255;
									b->lm_rgb[vi + 2] = ToI64(acc_b) & 255;
									lit_texels++;
								}
							}
						}
						u++;
					}
					v++;
				}
			}
			shadow += mask_space;
			k++;
		}
		b->lm_done[li] = TRUE;
		//Dump one map so the same surface can be computed independently from
		//the package and the two compared texel by texel.
		if (!ut_lm_dumped && lm->i_light_actors > 0 && uc >= 4 && vc >= 4)
		{
			ut_lm_dumped = TRUE;
			UTLog("UTLMDUMP li=%d surf=%d uc=%d vc=%d off=%d ila=%d\n",
				li, si, uc, vc, lm->data_offset, lm->i_light_actors);
			UTLog("UTLMDUMP r: %d %d %d %d %d %d %d %d\n",
				b->lm_rgb[off] & 255, b->lm_rgb[off + 3] & 255,
				b->lm_rgb[off + 6] & 255, b->lm_rgb[off + 9] & 255,
				b->lm_rgb[off + 12] & 255, b->lm_rgb[off + 15] & 255,
				b->lm_rgb[off + 18] & 255, b->lm_rgb[off + 21] & 255);
			UTLogFlush;
		}
		built++;
		}
		si++;
	}
	//Mean and peak of the built mesh, so the values can be compared against
	//the same map computed independently from the package data.
	sum_lm = 0;
	max_lm = 0;
	vi = 0;
	while (vi < b->lm_rgb_n)
	{
		sum_lm += b->lm_rgb[vi] & 255;
		if ((b->lm_rgb[vi] & 255) > max_lm)
			max_lm = b->lm_rgb[vi] & 255;
		vi++;
	}
	UTLog("UTBsp: lightmaps built=%d bytes=%d lit=%d mean=%d max=%d\n",
		built, b->lm_rgb_n, lit_texels,
		sum_lm * 100 / (b->lm_rgb_n + 1), max_lm);
}

F64 UTBspSampleLightMap(CUTBsp *b, CUTBspSurf *s, F64 u, F64 v)
{//SoftDrv SampleLight stand-in: LightBits byte → 0..1 shade.
 //UV: SoftDrv LightMip.UScale = TexUScale/LightUScale; pan delta applied.
 //Host stores world texels already pan-adjusted; divide by LM scale + LM pan.
	CUTLightMapIdx *lm;
	I64 lu;
	I64 lv;
	I64 uw;
	I64 vh;
	I64 off;
	I64 idx;
	U8 byte;

	if (!b || !s || !b->light_bits || b->light_bits_n < 1)
		return -1.0;
	if (s->i_light_map < 0 || s->i_light_map >= b->num_light_maps)
		return -1.0;
	lm = &b->light_maps[s->i_light_map];
	uw = lm->u_clamp;
	vh = lm->v_clamp;
	if (uw < 1) uw = 1;
	if (vh < 1) vh = 1;
	lu = ToI64((u - lm->pan[0]) / lm->u_scale);
	lv = ToI64((v - lm->pan[1]) / lm->v_scale);
	if (lu < 0) lu = 0;
	if (lv < 0) lv = 0;
	if (lu >= uw) lu = uw - 1;
	if (lv >= vh) lv = vh - 1;
	off = lm->data_offset;
	if (off < 0)
		off = 0;
	idx = off + lv * uw + lu;
	if (idx < 0 || idx >= b->light_bits_n)
	{
		//Bit-packed fallback: one bit per texel
		idx = off + (lv * uw + lu) / 8;
		if (idx < 0 || idx >= b->light_bits_n)
			return 0.55;
		byte = b->light_bits[idx];
		if (byte & (1 << ((lv * uw + lu) & 7)))
			return 0.95;
		return 0.35;
	}
	byte = b->light_bits[idx];
	return ToF64(byte) / 255.0;
}

U0 UTBspSampleLMRGBActive(F64 u, F64 v, F64 *lr, F64 *lg, F64 *lb)
{//Built RGB lightmap for the facet in flight. 1.0 = unlit, so a surface with
 //no map keeps its texture unchanged.
	CUTBsp *b;
	CUTBspSurf *s;
	CUTLightMapIdx *lm;
	I64 lu;
	I64 lv;
	I64 off;
	I64 i;

	*lr = -1.0;
	b = ut_lm_bsp;
	s = ut_lm_surf;
	if (!b || !s || !b->lm_rgb || !b->lm_off)
		return;
	if (s->i_light_map < 0 || s->i_light_map >= b->num_light_maps)
		return;
	off = b->lm_off[s->i_light_map];
	if (off < 0)
		return;
	lm = &b->light_maps[s->i_light_map];
	lu = ToI64((u - lm->pan[0]) / lm->u_scale);
	lv = ToI64((v - lm->pan[1]) / lm->v_scale);
	if (lu < 0) lu = 0;
	if (lv < 0) lv = 0;
	if (lu >= lm->u_clamp) lu = lm->u_clamp - 1;
	if (lv >= lm->v_clamp) lv = lm->v_clamp - 1;
	i = off + (lv * lm->u_clamp + lu) * 3;
	if (i < 0 || i + 2 >= b->lm_rgb_n)
		return;
	*lr = ToF64(b->lm_rgb[i] & 255) / 255.0;
	*lg = ToF64(b->lm_rgb[i + 1] & 255) / 255.0;
	*lb = ToF64(b->lm_rgb[i + 2] & 255) / 255.0;
}

F64 UTBspSampleLightMapActive(F64 u, F64 v)
{//per-texel SoftDrv SampleLight from bound facet
	F64 s;

	if (!ut_draw_lm_on || !ut_lm_bsp || !ut_lm_surf)
		return -1.0;
	s = UTBspSampleLightMap(ut_lm_bsp, ut_lm_surf, u, v);
	return s;
}


U0 UTBspSampleFogPhoton(CUTBsp *b, CUTBspSurf *s, F64 u, F64 v,
	F64 *fr, F64 *fg, F64 *fb, F64 *fa)
{//SoftDrv FogMap->Mips[0] DWORD Photon sample. Host fog_rgb from LightBits.
	CUTLightMapIdx *lm;
	I64 lu;
	I64 lv;
	I64 uw;
	I64 vh;
	I64 off;
	I64 idx;
	U32 rgb;
	F64 dens;
	F64 zr;
	F64 zg;
	F64 zb;

	if (fr) *fr = 0.0;
	if (fg) *fg = 0.0;
	if (fb) *fb = 0.0;
	if (fa) *fa = 0.0;
	if (!b || !s || !b->fog_rgb || b->fog_rgb_n < 1)
		return;
	if (s->i_light_map < 0 || s->i_light_map >= b->num_light_maps)
		return;
	lm = &b->light_maps[s->i_light_map];
	uw = lm->u_clamp;
	vh = lm->v_clamp;
	if (uw < 1) uw = 1;
	if (vh < 1) vh = 1;
	lu = ToI64((u - lm->pan[0]) / lm->u_scale);
	lv = ToI64((v - lm->pan[1]) / lm->v_scale);
	if (lu < 0) lu = 0;
	if (lv < 0) lv = 0;
	if (lu >= uw) lu = uw - 1;
	if (lv >= vh) lv = vh - 1;
	off = lm->data_offset;
	if (off < 0) off = 0;
	idx = off + lv * uw + lu;
	if (idx < 0 || idx >= b->fog_rgb_n)
		return;
	rgb = b->fog_rgb[idx];
	zr = ToF64((rgb >> 16) & 255) / 255.0;
	zg = ToF64((rgb >> 8) & 255) / 255.0;
	zb = ToF64(rgb & 255) / 255.0;
	dens = (zr + zg + zb) / 3.0;
	if (ut_zone_in_water)
	{
		zr = dens * 0.25;
		zg = dens * 0.55;
		zb = dens * 0.85;
		dens = dens * 0.65 + 0.15;
	}
	if (ut_zone_in_hurt)
	{
		zr = dens * 0.90;
		zg = dens * 0.25;
		zb = dens * 0.15;
		dens = dens * 0.70 + 0.20;
	}
	if (fr) *fr = zr;
	if (fg) *fg = zg;
	if (fb) *fb = zb;
	if (fa)
	{
		*fa = dens;
		if (*fa > 0.85) *fa = 0.85;
	}
}

U0 UTBspSampleFogPhotonActive(F64 u, F64 v,
	F64 *fr, F64 *fg, F64 *fb, F64 *fa)
{
	if (!ut_draw_fog_on || !ut_lm_bsp || !ut_lm_surf)
	{
		if (fr) *fr = 0.0;
		if (fg) *fg = 0.0;
		if (fb) *fb = 0.0;
		if (fa) *fa = 0.0;
		return;
	}
	UTBspSampleFogPhoton(ut_lm_bsp, ut_lm_surf, u, v, fr, fg, fb, fa);
}

F64 UTBspSampleFogMap(CUTBsp *b, CUTBspSurf *s, F64 u, F64 v)
{//SoftDrv FogMap multiply for facet shade. Photon RGB sampled separately.
	F64 fr;
	F64 fg;
	F64 fb;
	F64 fa;
	F64 shade;

	UTBspSampleFogPhoton(b, s, u, v, &fr, &fg, &fb, &fa);
	shade = 1.0 - fa * 0.55;
	shade *= UTLightFogAt(ut_fog_centroid);
	if (ut_zone_in_water)
		shade *= 0.85;
	if (ut_zone_in_hurt)
		shade *= 0.70;
	if (shade < 0.25)
		shade = 0.25;
	if (shade > 1.0)
		shade = 1.0;
	return shade;
}

U0 UTBspSurfUV(CUTBsp *b, CUTBspSurf *s, F64 *pos, F64 *u, F64 *v)
{//Moloch compute_uv: (p-base)·texU/V, V negated. base/axes live in Vectors[].
	F64 *base;
	F64 *tu;
	F64 *tv;
	F64 dx;
	F64 dy;
	F64 dz;

	*u = 0.0;
	*v = 0.0;
	if (!b || !s)
		return;
	if (s->p_base < 0 || s->p_base >= b->num_vectors)
		return;
	if (s->v_texture_u < 0 || s->v_texture_u >= b->num_vectors)
		return;
	if (s->v_texture_v < 0 || s->v_texture_v >= b->num_vectors)
		return;
	base = b->vectors[s->p_base].v;
	tu = b->vectors[s->v_texture_u].v;
	tv = b->vectors[s->v_texture_v].v;
	dx = pos[0] - base[0];
	dy = pos[1] - base[1];
	dz = pos[2] - base[2];
	*u = dx * tu[0] + dy * tu[1] + dz * tu[2] + ToF64(s->pan_u);
	*v = -(dx * tv[0] + dy * tv[1] + dz * tv[2]) + ToF64(s->pan_v);
	//PF_Mirrored → SoftDrv flip U
	if (s->poly_flags & UT_PF_MIRRORED)
		*u = -*u;
}

CUTTex *UTBspSurfTex(CUTBsp *b, I64 i_surf, CUTTex *fallback)
{
	CUTTex *t;
	I64 n;
	I64 i;
	U8 *p;

	if (!b || i_surf < 0 || i_surf >= b->num_surfs)
		return fallback;
	if (b->surf_tex)
	{
		t = b->surf_tex[i_surf];
		if (t && t->num_mips > 0 && t->mips[0].pixels)
		{
			//Sparse probe — all-zero mip seals room black under opaque idx0.
			n = t->mips[0].u_size * t->mips[0].v_size;
			p = t->mips[0].pixels;
			if (n > 0 && (p[0] || p[n / 2] || p[n - 1]))
				return t;
			i = n / 8;
			if (i < 1)
				i = 1;
			while (i < n)
			{
				if (p[i])
					return t;
				i += n / 8;
			}
		}
	}
	return fallback;
}

//Nested walks share one global scissor (ut_portal_scissor); the inner call
//receives span_opaque aliased to it. Off until each nest owns a buffer.


Bool ut_bsp_portals_on = FALSE;
Bool ut_bsp_sky_on = FALSE;

U0 UTBspDrawFacet(CUTCanvas *c, CUTBsp *b, CUTBspNode *n, F64 *eye,
	CUTTex *fallback, CUTSpanBuf *span_opaque)
{//one node poly → triangle fan. Opaque punches FSpan; masked/translucent Z only.
	I64 vi;
	CUTBspSurf *s;
	CUTTex *tex;
	CUTSpanBuf *span;
	F64 p0[3];
	F64 p1[3];
	F64 p2[3];
	F64 u0;
	F64 v0;
	F64 u1;
	F64 v1;
	F64 u2;
	F64 v2;
	F64 *nrm;
	F64 facing;
	F64 centroid[3];
	F64 lm_s;
	F64 fog_s;
	I64 pv;
	I64 zone;
	U32 pf;
	I64 is_front;
	I64 opp;
	I64 save_z;
	I64 nv;
	I64 k;
	I64 warp_from;
	I64 warp_to;
	F64 psx[UT_MAX_NODE_VERTS];
	F64 psy[UT_MAX_NODE_VERTS];
	F64 invz;
	F64 eye_save[3];
	CUTSpanBuf *nest_span;
	CUTSpanBuf *scis;
	I64 lm_off_f;
	CUTLightMapIdx *lm_f;
	Bool got_scissor;

	if (!c || !b || !n || !fallback)
		return;
	if (n->num_vertices < 3)
		return;
	if (n->i_surf < 0 || n->i_surf >= b->num_surfs)
		return;
	if (n->i_vert_pool < 0 ||
		n->i_vert_pool + n->num_vertices > b->num_verts)
		return;
	s = &b->surfs[n->i_surf];
	pf = s->poly_flags;
	if (pf & UT_PF_INVISIBLE)
	{
		//Invisible+Portal still opens zone (UnRender RenderPortal path).
		if (!(pf & UT_PF_PORTAL))
			return;
	}
	if (s->v_normal < 0 || s->v_normal >= b->num_vectors)
		return;
	nrm = b->vectors[s->v_normal].v;
	pv = b->verts[n->i_vert_pool].p_vertex;
	if (pv < 0 || pv >= b->num_points)
		return;
	UTVecCopy(b->points[pv].v, p0);
	facing = (eye[0] - p0[0]) * nrm[0] +
		(eye[1] - p0[1]) * nrm[1] +
		(eye[2] - p0[2]) * nrm[2];
	zone = UTBspPointZone(b, eye);
	if (facing <= 0.0 && !(pf & UT_PF_TWO_SIDED) && zone != 0 &&
		!(pf & UT_PF_PORTAL))
		return;
	//PF_Portal: SoftDrv CreateChildFrame (UnRender NormalZone / Warp).
	//Child Span = portal silhouette ∩ screen open (FSpan scissor).
	if (pf & UT_PF_PORTAL)
	{
		//Every nest re-walks the whole BSP, so a wall of portal facets costs
		//a full frame each. UnRender caps recursion; cap the per-frame count
		//too — beyond this the facet draws flat.
		if (ut_bsp_portals_on && ut_portal_depth < UT_PORTAL_MAX &&
			ut_portal_nests < UT_PORTAL_NESTS_MAX)
		{
			is_front = 1;
			if (facing < 0.0)
				is_front = 0;
			opp = n->i_zone[1 - is_front] & 0xFF;
			if (opp != 0)
			{
				got_scissor = FALSE;
				nest_span = span_opaque;
				nv = n->num_vertices;
				if (nv > UT_MAX_NODE_VERTS)
					nv = UT_MAX_NODE_VERTS;
				k = 0;
				while (k < nv)
				{
					pv = b->verts[n->i_vert_pool + k].p_vertex;
					if (pv < 0 || pv >= b->num_points)
						break;
					if (!UTDrawProject(c, b->points[pv].v,
						&psx[k], &psy[k], &invz))
						break;
					k++;
				}
				if (k == nv && nv >= 3)
				{
					scis = &ut_portal_scissor[ut_portal_depth &
						UT_PORTAL_MAX];
					scis->width = c->width;
					scis->height = c->height;
					UTSpanRasterConvex(scis, psx, psy, nv);
					if (span_opaque && span_opaque != scis)
						UTSpanAnd(scis, span_opaque);
					nest_span = scis;
					got_scissor = TRUE;
				}
				save_z = ut_portal_zone;
				ut_portal_zone = opp;
				ut_portal_depth++;
				ut_portal_nests++;
				UTVecCopy(eye, eye_save);
				warp_from = UTZoneFindWarpNear(eye);
				warp_to = UTZoneWarpPair(warp_from);
				if (warp_from >= 0 && warp_to >= 0)
					UTZoneChildFramePush(c, warp_from, warp_to, eye);
				UTBspWalkFTB(c, b, 0, eye, fallback, nest_span, 0);
				if (warp_from >= 0 && warp_to >= 0)
					UTZoneChildFramePop(c, eye);
				else
					UTVecCopy(eye_save, eye);
				ut_portal_depth--;
				ut_portal_zone = save_z;
				//PF_Occlude portal hole on parent Span
				if (got_scissor && span_opaque)
					UTSpanPunchPoly(span_opaque, psx, psy, nv);
			}
		}
		return;
	}
	//PF_FakeBackdrop + SkyZoneInfo → SoftDrv sky child frame (UnRender HandleSkyWarp).
	if (ut_bsp_sky_on && (pf & UT_PF_FAKE_BACKDROP) && ut_sky_ready &&
		ut_portal_depth < UT_PORTAL_MAX && ut_sky_nests < 1 &&
		ut_sky_frames < UT_SKY_NESTS_MAX)
	{
		got_scissor = FALSE;
		nest_span = span_opaque;
		nv = n->num_vertices;
		if (nv > UT_MAX_NODE_VERTS)
			nv = UT_MAX_NODE_VERTS;
		k = 0;
		while (k < nv)
		{
			pv = b->verts[n->i_vert_pool + k].p_vertex;
			if (pv < 0 || pv >= b->num_points)
				break;
			if (!UTDrawProject(c, b->points[pv].v,
				&psx[k], &psy[k], &invz))
				break;
			k++;
		}
		if (k == nv && nv >= 3)
		{
			scis = &ut_portal_scissor[ut_portal_depth & UT_PORTAL_MAX];
			scis->width = c->width;
			scis->height = c->height;
			UTSpanRasterConvex(scis, psx, psy, nv);
			if (span_opaque && span_opaque != scis)
				UTSpanAnd(scis, span_opaque);
			nest_span = scis;
			got_scissor = TRUE;
		}
		//Without its own scissor the nest would render through the parent's
		//span buffer and punch it across the whole screen, rejecting every
		//facet drawn afterwards. A child frame owns its spans or does not
		//run at all.
		if (!got_scissor)
			return;
		UTVecCopy(eye, eye_save);
		//Sky camera at SkyZoneInfo.Location; keep player view angles via canvas.
		eye[0] = ut_sky_origin[0];
		eye[1] = ut_sky_origin[1];
		eye[2] = ut_sky_origin[2];
		UTDrawSetView(c, eye, ut_view_pitch, ut_view_yaw, ut_view_roll,
			ut_con_fov);
		ut_portal_depth++;
		ut_sky_nests++;
		ut_sky_frames++;
		UTBspWalkFTB(c, b, 0, eye, fallback, nest_span, 0);
		ut_sky_nests--;
		ut_portal_depth--;
		UTVecCopy(eye_save, eye);
		UTDrawSetView(c, eye, ut_view_pitch, ut_view_yaw, ut_view_roll,
			ut_con_fov);
		if (got_scissor && span_opaque)
			UTSpanPunchPoly(span_opaque, psx, psy, nv);
		return;
	}
	//Nest filter: only facets belonging to opposite iZone.
	if (ut_portal_zone >= 0)
	{
		if (n->i_zone[0] != ut_portal_zone &&
			n->i_zone[1] != ut_portal_zone)
			return;
	}
	tex = UTBspSurfTex(b, n->i_surf, fallback);
	span = span_opaque;
	if ((pf & UT_PF_MASKED) || (pf & UT_PF_TRANSLUCENT))
		span = NULL;
	UTBspSurfUV(b, s, p0, &u0, &v0);
	//facet centroid shade from Light actors
	centroid[0] = p0[0];
	centroid[1] = p0[1];
	centroid[2] = p0[2];
	vi = 1;
	while (vi < n->num_vertices)
	{
		pv = b->verts[n->i_vert_pool + vi].p_vertex;
		if (pv >= 0 && pv < b->num_points)
		{
			centroid[0] += b->points[pv].v[0];
			centroid[1] += b->points[pv].v[1];
			centroid[2] += b->points[pv].v[2];
		}
		vi++;
	}
	centroid[0] /= ToF64(n->num_vertices);
	centroid[1] /= ToF64(n->num_vertices);
	centroid[2] /= ToF64(n->num_vertices);
	UTVecCopy(centroid, ut_fog_centroid);
	ut_draw_shade = UTLightShadeAt(centroid);
	//PF_Environment — SoftDrv view-bright unlit-ish surfaces
	if (pf & UT_PF_ENVIRONMENT)
	{
		ut_draw_shade = ut_draw_shade * 0.35 + 0.75;
		if (ut_draw_shade > 1.0)
			ut_draw_shade = 1.0;
		u0 += eye[0] * 0.02;
		v0 += eye[1] * 0.02;
	}
	//PF_SpecialLit — SoftDrv boost (UnRender SpecialLit path soft)
	if (pf & UT_PF_SPECIAL_LIT)
	{
		ut_draw_shade = ut_draw_shade * 0.55 + 0.55;
		if (ut_draw_shade > 1.0)
			ut_draw_shade = 1.0;
	}
	//SoftDrv DrawSurf: if Surface.LightMap sample photons; else unlit path.
	//Facet bind LM for per-texel SampleLight in UTDrawSpanTexRun.
	ut_lm_bsp = b;
	ut_lm_surf = s;
	//Resolve the lightmap once per facet; the span loop then only indexes.
	ut_lm_ptr = NULL;
	if (b->lm_rgb && b->lm_off && s->i_light_map >= 0 &&
		s->i_light_map < b->num_light_maps)
	{
		lm_off_f = b->lm_off[s->i_light_map];
		if (lm_off_f >= 0)
		{
			lm_f = &b->light_maps[s->i_light_map];
			ut_lm_ptr = &b->lm_rgb[lm_off_f];
			ut_lm_uc = lm_f->u_clamp;
			ut_lm_vc = lm_f->v_clamp;
			ut_lm_pan0 = lm_f->pan[0];
			ut_lm_pan1 = lm_f->pan[1];
			ut_lm_ru = 1.0 / lm_f->u_scale;
			ut_lm_rv = 1.0 / lm_f->v_scale;
			ut_lm_k = 1.0 / UT_LM_UNIT;
		}
	}
	ut_draw_lm_on = FALSE;
	if (s->i_light_map >= 0 && b->num_light_maps > 0 && b->light_bits)
	{
		ut_draw_lm_on = TRUE;
		lm_s = UTBspSampleLightMap(b, s, u0, v0);
		if (lm_s >= 0.0)
		{
			ut_draw_shade = lm_s * 0.65 + ut_draw_shade * 0.35;
			if (ut_draw_shade > 1.0)
				ut_draw_shade = 1.0;
			if (ut_draw_shade < 0.12)
				ut_draw_shade = 0.12;
		}
	}
	fog_s = UTBspSampleFogMap(b, s, u0, v0);
	//Surfaces with no fog volume sample 0; multiplying zeroed the shade and
	//sealed lit geometry black. Absent fog is unity.
	if (fog_s > 0.0)
		ut_draw_shade = ut_draw_shade * fog_s;
	if (ut_draw_shade > 1.0)
		ut_draw_shade = 1.0;
	if (ut_draw_shade < 0.12)
		ut_draw_shade = 0.12;
	//PF_Unlit wins after LM/Fog sample
	if (pf & UT_PF_UNLIT)
		ut_draw_shade = 1.0;
	//PF_Flat — SoftDrv flatten shade (no N·L variance soft)
	if (pf & UT_PF_FLAT)
	{
		ut_draw_shade = ut_draw_shade * 0.5 + 0.5;
		if (ut_draw_shade > 1.0)
			ut_draw_shade = 1.0;
	}
	ut_draw_fog_on = (b->fog_rgb_n > 0 && b->fog_rgb != NULL);
	vi = 1;
	while (vi + 1 < n->num_vertices)
	{
		pv = b->verts[n->i_vert_pool + vi].p_vertex;
		if (pv >= 0 && pv < b->num_points)
		{
			UTVecCopy(b->points[pv].v, p1);
			UTBspSurfUV(b, s, p1, &u1, &v1);
			pv = b->verts[n->i_vert_pool + vi + 1].p_vertex;
			if (pv >= 0 && pv < b->num_points)
			{
				UTVecCopy(b->points[pv].v, p2);
				UTBspSurfUV(b, s, p2, &u2, &v2);
				UTDrawTriTex3(c, p0, p1, p2,
					u0, v0, u1, v1, u2, v2, tex, span);
			}
		}
		vi++;
	}
	//SoftDrv DetailTexture / MacroTexture modulate (near facets only).
	if (!(pf & UT_PF_PORTAL) && tex &&
		(tex->macro || tex->detail))
	{
		save_z = ut_draw_poly_flags;
		ut_draw_poly_flags = UT_DRAW_PF_MODULATED;
		ut_draw_lm_on = FALSE;
		ut_draw_fog_on = FALSE;
		if (tex->macro && tex->macro->num_mips > 0)
		{
			vi = 1;
			while (vi + 1 < n->num_vertices)
			{
				pv = b->verts[n->i_vert_pool + vi].p_vertex;
				if (pv >= 0 && pv < b->num_points)
				{
					UTVecCopy(b->points[pv].v, p1);
					UTBspSurfUV(b, s, p1, &u1, &v1);
					pv = b->verts[n->i_vert_pool + vi + 1].p_vertex;
					if (pv >= 0 && pv < b->num_points)
					{
						UTVecCopy(b->points[pv].v, p2);
						UTBspSurfUV(b, s, p2, &u2, &v2);
						UTDrawTriTex3(c, p0, p1, p2,
							u0 * 0.25, v0 * 0.25,
							u1 * 0.25, v1 * 0.25,
							u2 * 0.25, v2 * 0.25,
							tex->macro, NULL);
					}
				}
				vi++;
			}
		}
		if (tex->detail && tex->detail->num_mips > 0)
		{
			vi = 1;
			while (vi + 1 < n->num_vertices)
			{
				pv = b->verts[n->i_vert_pool + vi].p_vertex;
				if (pv >= 0 && pv < b->num_points)
				{
					UTVecCopy(b->points[pv].v, p1);
					UTBspSurfUV(b, s, p1, &u1, &v1);
					pv = b->verts[n->i_vert_pool + vi + 1].p_vertex;
					if (pv >= 0 && pv < b->num_points)
					{
						UTVecCopy(b->points[pv].v, p2);
						UTBspSurfUV(b, s, p2, &u2, &v2);
						UTDrawTriTex3(c, p0, p1, p2,
							u0 * 8.0, v0 * 8.0,
							u1 * 8.0, v1 * 8.0,
							u2 * 8.0, v2 * 8.0,
							tex->detail, NULL);
					}
				}
				vi++;
			}
		}
		ut_draw_poly_flags = save_z;
	}
	ut_draw_shade = 1.0;
	ut_draw_lm_on = FALSE;
	ut_draw_fog_on = FALSE;
	ut_lm_bsp = NULL;
	ut_lm_surf = NULL;
	ut_lm_ptr = NULL;
}

I64 ut_bsp_facets_frame = 0;
Bool ut_bsp_model_logged = FALSE;
Bool ut_bsp_room_logged = FALSE;

I64 ut_bsp_cur_node = -1;	//node in flight; read by the catch in DrawModel

U0 UTBspDrawCoplanars(CUTCanvas *c, CUTBsp *b, I64 ni, F64 *eye,
	CUTTex *fallback, CUTSpanBuf *span)
{//iPlane chain: coplanars only (UnObj.h — no front/back on plane kids).
	I64 i;
	I64 guard;
	I64 bin;
	I64 si;
	I64 pv_o;
	F64 dxo;
	F64 dyo;
	F64 dzo;
	F64 do_d;

	i = ni;
	guard = 0;
	while (i >= 0 && i < b->num_nodes && guard < 64)
	{
		ut_bsp_cur_node = i;
		if (ut_draw_collect)
		{
			bin = 0;
			si = b->nodes[i].i_surf;
			if (si >= 0 && si < b->num_surfs)
				bin = UTBspDrawBinOf(b->surfs[si].poly_flags);
			if (ut_draw_bin_n[bin] < UT_DRAW_MAX)
			{
				ut_draw_bin[bin][ut_draw_bin_n[bin]] = i;
				ut_draw_bin_n[bin]++;
				//Order probe: eye distance of the first and last opaque
				//node collected. Front-to-back means first < last.
				if (bin == 0 && b->nodes[i].num_vertices > 0)
				{
					pv_o = b->verts[b->nodes[i].i_vert_pool].p_vertex;
					if (pv_o >= 0 && pv_o < b->num_points)
					{
						dxo = b->points[pv_o].v[0] - eye[0];
						dyo = b->points[pv_o].v[1] - eye[1];
						dzo = b->points[pv_o].v[2] - eye[2];
						do_d = Sqrt(dxo * dxo + dyo * dyo + dzo * dzo);
						if (ut_draw_bin_n[0] == 1)
							ut_order_first = do_d;
						ut_order_last = do_d;
					}
				}
			}
		}
		else
			UTBspDrawFacet(c, b, &b->nodes[i], eye, fallback, span);
		i = b->nodes[i].i_plane;
		guard++;
	}
}

I64 ut_bsp_facets_frame = 0;
Bool ut_bsp_model_logged = FALSE;	//runaway detector: logs once past 1M

U0 UTBspWalkFTB(CUTCanvas *c, CUTBsp *b, I64 ni, F64 *eye,
	CUTTex *fallback, CUTSpanBuf *span, I64 depth)
{//front-to-back SoftDrv OccludeBsp order: near → claim/draw → far.
 //Moloch i_front = Epic iBack (normal/front side).
	CUTBspNode *n;
	F64 d;

	if (!c || !b || ni < 0 || ni >= b->num_nodes)
		return;
	if (depth > 512)
		return;
	ut_bsp_facets_frame++;
	if (ut_bsp_facets_frame > 200000)
	{
		if (ut_bsp_facets_frame == 200001)
		{
			UTLog("UTBsp: RUNAWAY at node %d depth %d\n", ni, depth);
			UTLogFlush;
		}
		return;
	}
	n = &b->nodes[ni];
	d = UTBspPlaneDot(n->plane, eye);
	if (d >= 0.0)
	{
		UTBspWalkFTB(c, b, n->i_front, eye, fallback, span, depth + 1);
		UTBspDrawCoplanars(c, b, ni, eye, fallback, span);
		UTBspWalkFTB(c, b, n->i_back, eye, fallback, span, depth + 1);
	}
	else
	{
		UTBspWalkFTB(c, b, n->i_back, eye, fallback, span, depth + 1);
		UTBspDrawCoplanars(c, b, ni, eye, fallback, span);
		UTBspWalkFTB(c, b, n->i_front, eye, fallback, span, depth + 1);
	}
}

U0 UTBspDrawModel(CUTCanvas *c, CUTBsp *b, CUTTex *tex, CUTSpanBuf *span)
{//SoftDrv DrawComplexSurface path: FTB + FSpan occlusion when span set.
	I64 bin_i;
	I64 ent_i;
	I64 ni_d;
	F64 eye[3];

	if (!c || !b || !tex || b->num_nodes < 1)
		return;
	ut_portal_depth = 0;
	ut_portal_zone = -1;
	ut_bsp_facets_frame = 0;
	ut_portal_nests = 0;
	ut_sky_frames = 0;
	UTVecCopy(c->origin, eye);
	try
	{
		//Pass one collects visible nodes in traversal order; pass two draws
		//bin by bin so every occluder is down before anything blended.
		ut_draw_bin_n[0] = 0;
		ut_draw_bin_n[1] = 0;
		ut_draw_bin_n[2] = 0;
		ut_draw_collect = TRUE;
		UTBspWalkFTB(c, b, 0, eye, tex, span, 0);
		ut_draw_collect = FALSE;
		if (!ut_order_logged)
		{
			ut_order_logged = TRUE;
			UTLog("UTBsp: order first=%.0f last=%.0f (front-to-back if first<last)\n",
				ut_order_first, ut_order_last);
			UTLogFlush;
		}
		bin_i = 0;
		while (bin_i < UT_DRAW_BINS)
		{
			ent_i = 0;
			while (ent_i < ut_draw_bin_n[bin_i])
			{
				ni_d = ut_draw_bin[bin_i][ent_i];
				if (ni_d >= 0 && ni_d < b->num_nodes)
				{
					ut_bsp_cur_node = ni_d;
					UTBspDrawFacet(c, b, &b->nodes[ni_d], eye, tex, span);
				}
				ent_i++;
			}
			bin_i++;
		}
	}
	catch
	{
		ut_draw_collect = FALSE;
		Fs->catch_except = TRUE;
		UTLog("UTBsp: FAULT node=%d facets=%d surf=%d nv=%d\n",
			ut_bsp_cur_node, ut_bsp_facets_frame,
			b->nodes[ut_bsp_cur_node].i_surf,
			b->nodes[ut_bsp_cur_node].num_vertices);
		UTLogFlush;
	}
}

Bool UTBspPointSolid(CUTBsp *b, F64 *p)
{//TRUE in solid volume. Zone 0 = outside. Thin same-zone floors need FloorZ.
	I64 zone;

	zone = UTBspPointZone(b, p);
	return zone == 0;
}

Bool UTBspPointInFacetXY(CUTBsp *b, CUTBspNode *n, F64 x, F64 y)
{//convex facet XY test. BSP polys are convex.
	I64 k;
	I64 pv0;
	I64 pv1;
	F64 x0;
	F64 y0;
	F64 x1;
	F64 y1;
	F64 cross;
	F64 first;
	Bool have;

	if (!b || !n || n->num_vertices < 3)
		return FALSE;
	have = FALSE;
	first = 0.0;
	k = 0;
	while (k < n->num_vertices)
	{
		pv0 = b->verts[n->i_vert_pool + k].p_vertex;
		if (k + 1 < n->num_vertices)
			pv1 = b->verts[n->i_vert_pool + k + 1].p_vertex;
		else
			pv1 = b->verts[n->i_vert_pool].p_vertex;
		if (pv0 < 0 || pv0 >= b->num_points || pv1 < 0 || pv1 >= b->num_points)
			return FALSE;
		x0 = b->points[pv0].v[0];
		y0 = b->points[pv0].v[1];
		x1 = b->points[pv1].v[0];
		y1 = b->points[pv1].v[1];
		cross = (x1 - x0) * (y - y0) - (y1 - y0) * (x - x0);
		if (!have)
		{
			first = cross;
			have = TRUE;
		}
		else if (first * cross < 0.0)
			return FALSE;
		k++;
	}
	return TRUE;
}

F64 UTBspFloorZ(CUTBsp *b, F64 x, F64 y, F64 z_top, Bool *hit)
{//highest upward solid facet under (x,y) with z <= z_top.
 //Thin floors share zone on both sides — PointSolid misses them.
	I64 i;
	I64 k;
	I64 pv;
	CUTBspNode *n;
	CUTBspSurf *s;
	F64 *nrm;
	F64 z;
	F64 zsum;
	F64 best;
	I64 cnt;

	*hit = FALSE;
	best = -1.0e12;
	if (!b || b->num_nodes < 1 || b->num_verts < 1)
		return best;
	i = 0;
	while (i < b->num_nodes)
	{
		n = &b->nodes[i];
		if (n->num_vertices >= 3 && n->i_surf >= 0 && n->i_surf < b->num_surfs &&
			n->i_vert_pool >= 0 &&
			n->i_vert_pool + n->num_vertices <= b->num_verts)
		{
			s = &b->surfs[n->i_surf];
			if (!(s->poly_flags & UT_PF_NOT_SOLID) &&
				s->v_normal >= 0 && s->v_normal < b->num_vectors)
			{
				nrm = b->vectors[s->v_normal].v;
				if (nrm[2] >= 0.7)
				{
					if (UTBspPointInFacetXY(b, n, x, y))
					{
						zsum = 0.0;
						cnt = 0;
						k = 0;
						while (k < n->num_vertices)
						{
							pv = b->verts[n->i_vert_pool + k].p_vertex;
							if (pv >= 0 && pv < b->num_points)
							{
								zsum += b->points[pv].v[2];
								cnt++;
							}
							k++;
						}
						if (cnt > 0)
						{
							z = zsum / ToF64(cnt);
							if (z <= z_top + 2.0 && z > best)
							{
								best = z;
								*hit = TRUE;
							}
						}
					}
				}
			}
		}
		i++;
	}
	return best;
}

U0 UTBspProbeAABB(CUTBsp *b, F64 *mn, F64 *mx, I64 *facet_n)
{
	I64 i;
	I64 nfac;
	F64 *p;

	mn[0] = 0; mn[1] = 0; mn[2] = 0;
	mx[0] = 0; mx[1] = 0; mx[2] = 0;
	*facet_n = 0;
	if (!b || b->num_points < 1)
		return;
	p = b->points[0].v;
	mn[0] = p[0]; mn[1] = p[1]; mn[2] = p[2];
	mx[0] = p[0]; mx[1] = p[1]; mx[2] = p[2];
	i = 1;
	while (i < b->num_points)
	{
		p = b->points[i].v;
		if (p[0] < mn[0]) mn[0] = p[0];
		if (p[1] < mn[1]) mn[1] = p[1];
		if (p[2] < mn[2]) mn[2] = p[2];
		if (p[0] > mx[0]) mx[0] = p[0];
		if (p[1] > mx[1]) mx[1] = p[1];
		if (p[2] > mx[2]) mx[2] = p[2];
		i++;
	}
	nfac = 0;
	i = 0;
	while (i < b->num_nodes)
	{
		if (b->nodes[i].num_vertices >= 3)
			nfac++;
		i++;
	}
	*facet_n = nfac;
}

U0 UTBspDrawRoom(CUTCanvas *c, CUTBsp *b)
{//SoftDrv textured room. Floor/ceiling = checker, walls = grid.
	CUTTex *floor_tex;
	CUTTex *wall_tex;
	CUTSpanBuf *span;
	F64 us;

	if (!c || !b)
		return;
	//retail Model: SoftDrv FTB + screen FSpan (CopyFromRasterUpdate role).
	//Multi-seg intersect + punch-abort-on-overflow — no black seal.
	if (b->num_nodes > 6 && b->num_verts > 0 && ut_tex_ready)
	{
		span = NULL;
		if (ut_soft_ready && ut_soft.span_based)
			span = UTSoftSpan();
		ut_sky_nests = 0;
		ut_portal_depth = 0;
		ut_portal_nests = 0;
		ut_sky_frames = 0;
		UTBspDrawModel(c, b, &ut_tex_checker, span);

		return;
	}
	if (b->num_points < 8)
		return;
	if (ut_tex_ready)
	{
		floor_tex = &ut_tex_checker;
		wall_tex  = &ut_tex_grid;
	}
	else
	{
		UTDrawTri3(c, b->points[0].v, b->points[1].v, b->points[2].v, 100);
		UTDrawTri3(c, b->points[0].v, b->points[2].v, b->points[3].v, 100);
		return;
	}

	us = 256.0;
	UTDrawTriTex3(c, b->points[0].v, b->points[1].v, b->points[2].v,
		0.0, 0.0, us, 0.0, us, us, floor_tex, NULL);
	UTDrawTriTex3(c, b->points[0].v, b->points[2].v, b->points[3].v,
		0.0, 0.0, us, us, 0.0, us, floor_tex, NULL);
	UTDrawTriTex3(c, b->points[4].v, b->points[6].v, b->points[5].v,
		0.0, 0.0, us, us, us, 0.0, floor_tex, NULL);
	UTDrawTriTex3(c, b->points[4].v, b->points[7].v, b->points[6].v,
		0.0, 0.0, 0.0, us, us, us, floor_tex, NULL);
	UTDrawTriTex3(c, b->points[0].v, b->points[5].v, b->points[1].v,
		0.0, 0.0, 0.0, 64.0, us, 0.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[0].v, b->points[4].v, b->points[5].v,
		0.0, 0.0, 0.0, 64.0, 0.0, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[3].v, b->points[2].v, b->points[6].v,
		0.0, 0.0, us, 0.0, us, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[3].v, b->points[6].v, b->points[7].v,
		0.0, 0.0, us, 64.0, 0.0, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[0].v, b->points[3].v, b->points[7].v,
		0.0, 0.0, us, 0.0, us, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[0].v, b->points[7].v, b->points[4].v,
		0.0, 0.0, us, 64.0, 0.0, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[1].v, b->points[5].v, b->points[6].v,
		0.0, 0.0, 0.0, 64.0, us, 64.0, wall_tex, NULL);
	UTDrawTriTex3(c, b->points[1].v, b->points[6].v, b->points[2].v,
		0.0, 0.0, us, 64.0, us, 0.0, wall_tex, NULL);
}
