// SoftDrv host SaveN.usa stub (not full UnLinker package).
// Engine SaveGame writes SavePath\Save%i.usa via GObj.SavePackage(Level).
// Host blob magic UTHS: origin/health/frags/map/bots.

#define UT_SAVE_MAGIC		0x53485455	//'UTHS' LE
#define UT_SAVE_VER		1
#define UT_SAVE_SLOTS		9
#define UT_SAVE_NAME_LEN	48
#define UT_SAVE_PATH		"::/Apps/UT99/Save"
#define UT_SAVE_BUF_MAX		(sizeof(CUTSaveHdr) + 16 * 512)

class CUTSaveHdr
{
	U32	 magic;
	I64	 ver;
	I64	 slot;
	U8	 map[UT_SAVE_NAME_LEN];
	U8	 title[UT_SAVE_NAME_LEN];
	F64	 origin[3];
	I64	 yaw;
	I64	 pitch;
	F64	 health;
	I64	 ammo;
	I64	 frags;
	I64	 deaths;
	I64	 team;
	I64	 bot_n;
	Bool alive;
};

U8	ut_save_slot_label[UT_SAVE_SLOTS][UT_SAVE_NAME_LEN];
Bool	ut_save_slot_used[UT_SAVE_SLOTS];
U8	ut_save_buf[65536];

extern I64	ut_player_team;

U0 UTSavePath(I64 slot, U8 *dst)
{
	if (!dst)
		return;
	StrPrint(dst, "%s/Save%d.usa", UT_SAVE_PATH, slot);
}

U0 UTSaveScanSlots()
{
	I64 i;
	I64 sz;
	U8 path[96];
	U8 *data;
	CUTSaveHdr *hdr;

	i = 0;
	while (i < UT_SAVE_SLOTS)
	{
		ut_save_slot_used[i] = FALSE;
		StrPrint(ut_save_slot_label[i], "Empty Slot %d", i);
		UTSavePath(i, path);
		if (FileFind(path))
		{
			data = FileRead(path, &sz);
			if (data && sz >= sizeof(CUTSaveHdr))
			{
				hdr = data;
				if (hdr->magic == UT_SAVE_MAGIC && hdr->ver == UT_SAVE_VER)
				{
					ut_save_slot_used[i] = TRUE;
					if (hdr->title[0])
						StrPrint(ut_save_slot_label[i], "%s", hdr->title);
					else
						StrPrint(ut_save_slot_label[i], "%s  frags=%d",
							hdr->map, hdr->frags);
				}
				Free(data);
			}
			else if (data)
				Free(data);
		}
		i++;
	}
}

Bool UTSaveWrite(I64 slot)
{//= UGameEngine::SaveGame Position — host UTHS blob, not Level package
	U8 path[96];
	CUTSaveHdr *hdr;
	I64 i;
	I64 n;
	I64 off;
	I64 bytes;

	if (slot < 0 || slot >= UT_SAVE_SLOTS)
		return FALSE;
	if (!ut_game_ready || !ut_alive)
		return FALSE;
	MemSet(ut_save_buf, 0, sizeof(ut_save_buf));
	hdr = ut_save_buf;
	hdr->magic = UT_SAVE_MAGIC;
	hdr->ver = UT_SAVE_VER;
	hdr->slot = slot;
	if (ut_map_name[0])
		StrPrint(hdr->map, "%s", ut_map_name);
	else
		StrPrint(hdr->map, "unknown");
	StrPrint(hdr->title, "%s  %d frags", hdr->map, ut_frags);
	UTVecCopy(ut_origin, hdr->origin);
	hdr->yaw = ut_view_yaw;
	hdr->pitch = ut_view_pitch;
	hdr->health = ut_health;
	hdr->ammo = ut_ammo;
	hdr->frags = ut_frags;
	hdr->deaths = ut_deaths;
	hdr->team = ut_player_team;
	hdr->alive = ut_alive;
	n = ut_bot_count;
	if (n > UT_GM_BOT_MAX)
		n = UT_GM_BOT_MAX;
	hdr->bot_n = n;
	off = sizeof(CUTSaveHdr);
	i = 0;
	while (i < n)
	{
		if (off + sizeof(CUTBot) > sizeof(ut_save_buf))
			break;
		MemCopy(ut_save_buf + off, &ut_bots[i], sizeof(CUTBot));
		off += sizeof(CUTBot);
		i++;
	}
	bytes = off;
	UTSavePath(slot, path);
	if (FileWrite(path, ut_save_buf, bytes) < 1)
	{
		UTLog("UTSave: write fail %s\n", path);
		return FALSE;
	}
	ut_save_slot_used[slot] = TRUE;
	StrPrint(ut_save_slot_label[slot], "%s", hdr->title);
	UTLog("UTSave: wrote %s bytes=%d\n", path, bytes);
	return TRUE;
}

Bool UTSaveLoad(I64 slot)
{
	U8 path[96];
	U8 *data;
	CUTSaveHdr *hdr;
	I64 sz;
	I64 i;
	I64 n;
	I64 off;

	if (slot < 0 || slot >= UT_SAVE_SLOTS)
		return FALSE;
	UTSavePath(slot, path);
	if (!FileFind(path))
		return FALSE;
	data = FileRead(path, &sz);
	if (!data || sz < sizeof(CUTSaveHdr))
	{
		if (data) Free(data);
		return FALSE;
	}
	hdr = data;
	if (hdr->magic != UT_SAVE_MAGIC || hdr->ver != UT_SAVE_VER)
	{
		Free(data);
		return FALSE;
	}
	UTVecCopy(hdr->origin, ut_origin);
	ut_view_yaw = hdr->yaw;
	ut_view_pitch = hdr->pitch;
	ut_health = hdr->health;
	ut_ammo = hdr->ammo;
	ut_frags = hdr->frags;
	ut_deaths = hdr->deaths;
	ut_player_team = hdr->team;
	ut_alive = hdr->alive;
	n = hdr->bot_n;
	if (n > UT_GM_BOT_MAX)
		n = UT_GM_BOT_MAX;
	off = sizeof(CUTSaveHdr);
	i = 0;
	while (i < n && off + sizeof(CUTBot) <= sz)
	{
		MemCopy(&ut_bots[i], data + off, sizeof(CUTBot));
		off += sizeof(CUTBot);
		i++;
	}
	Free(data);
	ut_bot_count = n;
	UTLog("UTSave: loaded slot=%d frags=%d bots=%d\n", slot, ut_frags, n);
	return TRUE;
}
