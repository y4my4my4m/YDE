// Run.ZC - build and launch entry point.
//
// single-pass compiler: include order is load-bearing
//
//   UTFmt   byte readers + FCompactIndex
//   UTMath  vectors, GetAxes, meshvert
//   UTPkg   package summary + tables         -> UTFmt
//   UTPal   256 palette
//   UTTex   SoftDrv P8 textures              -> UTPal
//   UTSpan  FSpanBuffer occlusion            (no deps)
//   UTDraw  SoftDrv canvas + spans + tiles   -> UTMath, UTPal, UTTex, UTSpan
//   UTSoft  URenderDevice SoftDrv facade     -> UTDraw, UTSpan, UTTex
//   UTMesh  FMeshTri + demo cube             -> UTMath, UTDraw
//   UTBsp   nodes + textured demo room       -> UTMath, UTDraw, UTTex
//   UTIn    input                            -> UTMath
//   UTTest  self-checks
//   UT99    app shell
//
// OpenGLDrv / D3DDrv / XMesaGLDrv are not included. SoftDrv.dll was never
// public; UTDraw+UTSoft are the CPU raster path.

Cd(__DIR__);;

#include "UTFmt"
#include "UTMath"
#include "UTPkg"
#include "UTPal"
#include "UTTex"
#include "UTSpan"
#include "UTDraw"
#include "UTSoft"
#include "UTMesh"
#include "UTBsp"
#include "UTIn"
#include "UTTest"
#include "UT99"

UT99;

"\nType $$LTBLUE$$UTTest;$$FG$$ to run the data-layer self-check.\n";
