// UTClient.ZC - Engine Client spine.
//
// SoftDrv = URenderDevice only. ClientTravel loads .unr Model + PlayerStart,
// binds Level→SoftDrv draw, possesses PlayerPawn stand-in (host phys + VM
// PlayerMove/PlayerTick Exec). GameInfo / ChallengeHUD still open gaps —
// overlay those natives. See docs/Apps/UT99/PORT.md.

//UTMenu + UTUWin already defined (Run.ZC include order). Re-extern after
//define -> Undefined Extern / garbage hash -> GPF inside ExeCmdLine.
//ut_diag_once lives in UT99 (after this file) - forward only.
extern Bool	ut_diag_once;
extern U0	UTHUDDraw(CUTCanvas *c);

Bool	ut_client_ready		= FALSE;
Bool	ut_client_incomplete	= FALSE;
Bool	ut_client_level_bound	= FALSE;	//Model BSP → SoftDrv DrawModel
Bool	ut_client_traveled	= FALSE;
Bool	ut_client_possessed	= FALSE;	//PlayerPawn stand-in at PlayerStart
Bool	ut_client_cursor_on	= TRUE;
I64		ut_client_gap_mask	= 0;
U8		ut_client_url[128];
U8		ut_client_err[160];
U8		ut_client_gap_note[96];

#define UT_CLIENT_GAP_VM		1
#define UT_CLIENT_GAP_UWINDOW	2
#define UT_CLIENT_GAP_GAMEINFO	4
#define UT_CLIENT_GAP_LEVEL		8
#define UT_CLIENT_GAP_HUD		16
#define UT_CLIENT_GAP_PLAYER	32

U0 UTClientSetErr(U8 *msg)
{
	StrPrint(ut_client_err, "%s", msg);
	ut_client_incomplete = TRUE;
	UTLog("UTClient: %s\n", ut_client_err);
}

U0 UTClientBuildGapNote()
{//Exact missing pieces for overlay / banner. Level bind clears GAP_LEVEL.
	U8 *p;
	I64 n;

	ut_client_gap_note[0] = 0;
	if (!ut_client_gap_mask)
	{
		StrPrint(ut_client_gap_note, "gaps=none");
		return;
	}
	p = ut_client_gap_note;
	n = 0;
	p += StrPrint(p, "need:");
	if (ut_client_gap_mask & UT_CLIENT_GAP_LEVEL)
	{
		p += StrPrint(p, " Level");
		n++;
	}
	if (ut_client_gap_mask & UT_CLIENT_GAP_PLAYER)
	{
		p += StrPrint(p, " PlayerPawn");
		n++;
	}
	if (ut_client_gap_mask & UT_CLIENT_GAP_GAMEINFO)
	{
		p += StrPrint(p, " GameInfo");
		n++;
	}
	if (ut_client_gap_mask & UT_CLIENT_GAP_HUD)
	{
		p += StrPrint(p, " ChallengeHUD");
		n++;
	}
	if (ut_client_gap_mask & UT_CLIENT_GAP_UWINDOW)
	{
		p += StrPrint(p, " UWindow");
		n++;
	}
	if (ut_client_gap_mask & UT_CLIENT_GAP_VM)
	{
		p += StrPrint(p, " VM");
		n++;
	}
	no_warn n;
}

U0 UTClientProbeGaps()
{//Facts only. Does not clear a live Level bind.
	I64 slot;
	Bool level_ok;
	Bool player_ok;

	ut_client_gap_mask = 0;

	level_ok = ut_map_loaded && ut_bsp != NULL && ut_bsp->num_nodes > 0 &&
		ut_use_map;
	if (!level_ok)
		ut_client_gap_mask |= UT_CLIENT_GAP_LEVEL;

	player_ok = ut_client_possessed;
	slot = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerTick");
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerMove");
	if (!player_ok)
		ut_client_gap_mask |= UT_CLIENT_GAP_PLAYER;
	no_warn slot;

	slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostBeginPlay");
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "InitGame");
	if (slot < 0 && ut_obj_gameinfo < 0)
		ut_client_gap_mask |= UT_CLIENT_GAP_GAMEINFO;

	slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostRender");
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "DrawHUD");
	if (slot < 0 && ut_obj_hud < 0)
		ut_client_gap_mask |= UT_CLIENT_GAP_HUD;

	slot = UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "MouseMove");
	if (slot < 0)
		slot = UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "Paint");
	if (slot < 0)
		ut_client_gap_mask |= UT_CLIENT_GAP_UWINDOW;

	if (ut_vm_fn_n < 4)
		ut_client_gap_mask |= UT_CLIENT_GAP_VM;

	UTClientBuildGapNote;
	UTLog("UTClient: gap_mask=%02X level=%d possess=%d fn=%d note=%s\n",
		ut_client_gap_mask, ToI64(level_ok), ToI64(ut_client_possessed),
		ut_vm_fn_n, ut_client_gap_note);
}

Bool UTClientPossess()
{//PlayerPawn stand-in: Location/Rotation from map PlayerStart, phys ready.
	I64 steps;

	if (!ut_map_loaded || ut_bsp == NULL || ut_bsp->num_nodes < 1)
		return FALSE;

	UTVecCopy(ut_spawn, ut_origin);
	ut_view_yaw = ut_spawn_yaw & 0xFFFF;
	ut_view_pitch = ut_spawn_pitch;
	ut_view_roll = 0;
	UTPhysInit;
	UTPhysSnapToFloor(ut_bsp, ut_origin);
	UTVecCopy(ut_origin, ut_spawn);

	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerMove");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerTick");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "AutonomousPhysics");
	steps = UTVMCall("PlayerTick", 128);
	if (steps < 1)
		steps = UTVMCall("PlayerMove", 128);

	ut_client_possessed = TRUE;
	ut_client_cursor_on = FALSE;
	if (ut_health < 1.0)
		ut_health = 100.0;
	if (ut_weap_ready)
		ut_ammo = ut_weap_ammo[ut_weap_cur];
	if (ut_obj_pawn >= 0)
	{
		ut_obj[ut_obj_pawn].bag.health = ut_health;
		ut_obj[ut_obj_pawn].bag.has_location = TRUE;
		ut_obj[ut_obj_pawn].bag.ammo_amount = ToF64(ut_ammo);
		UTVecCopy(ut_origin, ut_obj[ut_obj_pawn].bag.location);
		UTVMSetSelf(ut_obj_pawn, &ut_obj[ut_obj_pawn].bag);
	}
	UTLog("UTClient: possess eye=%.0f %.0f %.0f yaw=%d vm_steps=%d\n",
		ut_origin[0], ut_origin[1], ut_origin[2], ut_view_yaw, steps);
	return TRUE;
}

U0 UTClientInit()
{
	ut_client_incomplete = FALSE;
	ut_client_traveled = FALSE;
	ut_client_level_bound = FALSE;
	ut_client_possessed = FALSE;
	ut_client_url[0] = 0;
	ut_client_err[0] = 0;
	ut_client_gap_note[0] = 0;
	ut_client_cursor_on = TRUE;

	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerMove");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "PlayerTick");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "ClientTravel");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Travel");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "AutonomousPhysics");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "InitGame");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostBeginPlay");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "PostRender");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "DrawHUD");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "Fire");
	UTVMLoadNamed("::/Apps/UT99/System/Botpack.u", "AltFire");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Touch");
	UTVMLoadNamed("::/Apps/UT99/System/Engine.u", "Pickup");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "MouseMove");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "KeyEvent");
	UTVMLoadNamed("::/Apps/UT99/System/UWindow.u", "Tick");

	if (ut_obj_ready)
	{
		UTObjInitGame;
		UTObjBindHUD;
	}

	UTClientProbeGaps;

	ut_client_ready = TRUE;
	UTLog("UTClient: ready gaps=%02X — Start Match binds Level SoftDrv\n",
		ut_client_gap_mask);
}

U0 UTClientExit()
{
	ut_client_ready = FALSE;
	ut_client_traveled = FALSE;
	ut_client_level_bound = FALSE;
	ut_client_possessed = FALSE;
}

Bool UTClientBindLevel()
{//Model1 BSP + surf tex already in ut_bsp via UTMapLoad. SoftDrv draw path.
	if (!ut_map_loaded || ut_bsp == NULL || ut_bsp->num_nodes < 1)
	{
		ut_client_level_bound = FALSE;
		return FALSE;
	}
	ut_client_level_bound = TRUE;
	ut_use_map = TRUE;
	if (ut_map_pkg != NULL)
	{
		UTZoneScanPackage(ut_map_pkg);
		UTLightScanPackage(ut_map_pkg);
		UTActorScanPackage(ut_map_pkg);
	}
	UTLog("UTClient: Level bound SoftDrv nodes=%d surfs=%d verts=%d\n",
		ut_bsp->num_nodes, ut_bsp->num_surfs, ut_bsp->num_verts);
	return TRUE;
}

Bool UTClientTravel(U8 *url)
{//Engine Console ClientTravel: load map package → bind Level → possess.
	I64 steps;
	Bool map_ok;

	if (url == NULL || !url[0])
		url = "?";
	StrPrint(ut_client_url, "%s", url);

	if (ut_menu_mode == 2)
		ut_map_filter = UT_MAP_MODE_CTF;
	else if (ut_menu_mode == 3)
		ut_map_filter = UT_MAP_MODE_DOM;
	else
		ut_map_filter = UT_MAP_MODE_DM;

	UTMapBuildCatalog;
	map_ok = FALSE;
	if (ut_map_cat_n > 0)
	{
		map_ok = UTMapLoadCatalogIndex(ut_map_cat_i);
		if (!map_ok)
			map_ok = UTMapCycle(1);
	}
	if (!map_ok)
		map_ok = UTMapTryOne("DM-Codex.unr");
	if (!map_ok)
		map_ok = UTMapTryOne("DM-Turbine.unr");
	ut_diag_once = FALSE;
	ut_client_traveled = TRUE;
	ut_client_possessed = FALSE;
	ut_client_level_bound = FALSE;

	steps = UTVMCall("ClientTravel", 256);
	if (steps < 1)
		steps = UTVMCall("Travel", 256);
	no_warn steps;

	if (!map_ok || !UTClientBindLevel)
	{
		ut_client_incomplete = TRUE;
		ut_client_level_bound = FALSE;
		UTClientProbeGaps;
		StrPrint(ut_client_err, "Level load failed");
		UTClientBuildGapNote;
		UTLog("UTClient: travel FAIL url=%s %s\n",
			ut_client_url, ut_client_gap_note);
		return FALSE;
	}

	UTObjInitGame;
	UTObjBindHUD;
	UTObjBindPawn;
	UTWeapInit;
	UTPropLinkBuildPawn;

	if (!UTClientPossess)
	{
		ut_client_incomplete = TRUE;
		UTClientProbeGaps;
		StrPrint(ut_client_err, "PlayerPawn possess failed");
		UTClientBuildGapNote;
		UTLog("UTClient: possess FAIL %s\n", ut_client_gap_note);
		return FALSE;
	}

	UTClientProbeGaps;
	//Playable when Level+possess ok. Remaining gaps = overlay, not blackout.
	if (ut_client_gap_mask & UT_CLIENT_GAP_LEVEL)
	{
		ut_client_incomplete = TRUE;
		StrPrint(ut_client_err, "Level unbound");
	}
	else
	{
		ut_client_incomplete = FALSE;
		ut_client_err[0] = 0;
	}

	UTLog("UTClient: travel OK url=%s map=%s gaps=%02X %s\n",
		ut_client_url, ut_map_name, ut_client_gap_mask, ut_client_gap_note);
	UTMusicPlayMapDefault;
	return TRUE;
}

U0 UTClientStartMatch()
{//Start Practice / Start Match from UWindow.
	ut_menu_open = FALSE;
	ut_menu_boot = FALSE;
	UTClientTravel("start");
}

U0 UTClientPlayerTick(F64 dt)
{//PlayerPawn move: host axes + UModel phys; VM PlayerMove/PlayerTick warm.
	F64 fwd[3];
	F64 right[3];
	F64 up[3];
	F64 wish[3];
	F64 flat[3];
	F64 hit_p[3];
	F64 hit_d;
	F64 speed;
	I64 steps;

	if (!ut_client_possessed || ut_bsp == NULL)
		return;

	if (ut_want_jump)
	{
		UTPhysJump;
		ut_want_jump = FALSE;
	}

	UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
	UTVecSet(wish, 0.0, 0.0, 0.0);
	flat[0] = fwd[0];
	flat[1] = fwd[1];
	flat[2] = 0.0;
	UTVecNormalize(flat);
	if (ut_key_forward)
		UTVecAdd(wish, flat, wish);
	if (ut_key_back)
		UTVecSub(wish, flat, wish);
	if (ut_key_right)
		UTVecAdd(wish, right, wish);
	if (ut_key_left)
		UTVecSub(wish, right, wish);
	if (UTVecLength(wish) > UT_SMALL_NUMBER)
		UTVecNormalize(wish);

	if (ut_key_fast)
		speed = UT_MOVE_FAST;
	else
		speed = UT_MOVE_SPEED;

	UTPhysIntegrate(ut_bsp, ut_origin, dt, wish, speed);
	UTZoneUpdatePlayer(ut_origin);

	UTActorTickMovers(dt);
	UTActorTouchPlayer(ut_origin);

	if (ut_weap_next || ut_weap_prev)
	{
		if (!ut_weap_cycle_latched)
		{
			ut_weap_cycle_latched = TRUE;
			if (ut_weap_next)
				UTWeapCycle(1);
			else
				UTWeapCycle(-1);
		}
	}
	else
		ut_weap_cycle_latched = FALSE;
	if (ut_fire_held)
		UTWeapFire(FALSE);
	if (ut_alt_fire)
		UTWeapFire(TRUE);
	UTWeapTickSpecials;
	UTWeapTickProjs(dt);
	ut_ammo = ut_weap_ammo[ut_weap_cur];
	if (ut_obj_pawn >= 0)
	{
		ut_obj[ut_obj_pawn].bag.health = ut_health;
		ut_obj[ut_obj_pawn].bag.ammo_amount = ToF64(ut_ammo);
		ut_obj[ut_obj_pawn].bag.has_location = TRUE;
		UTVecCopy(ut_origin, ut_obj[ut_obj_pawn].bag.location);
		UTVMSetSelf(ut_obj_pawn, &ut_obj[ut_obj_pawn].bag);
	}

	steps = UTVMCall("PlayerMove", 64);
	if (steps < 1)
		steps = UTVMCall("PlayerTick", 64);
	if (ut_vm_cmd == UT_VM_CMD_MOVE)
		ut_vm_cmd = UT_VM_CMD_NONE;
	if (ut_vm_cmd == UT_VM_CMD_TRACE)
	{
		UTGetAxes(ut_view_pitch, ut_view_yaw, ut_view_roll, fwd, right, up);
		hit_d = 0.0;
		UTPhysTrace(ut_bsp, ut_origin, fwd, ut_vm_arg, hit_p, &hit_d);
		ut_vm_cmd = UT_VM_CMD_NONE;
		no_warn hit_d;
	}
	no_warn steps;
}

U0 UTClientTick(F64 dt)
{
	I64 steps;

	if (!ut_client_ready)
		return;
	if (ut_menu_open || ut_uwin_active)
	{
		steps = UTVMCall("Tick", 64);
		no_warn steps;
		return;
	}
	if (ut_client_level_bound && ut_client_possessed)
	{
		UTClientPlayerTick(dt);
		return;
	}
	if (ut_client_traveled && !ut_client_level_bound)
	{
		//Idle incomplete — ESC reopens UWindow.
		return;
	}
	no_warn dt;
}

U0 UTClientDrawCursor(CUTCanvas *c)
{//SoftDrv poly arrow. Hotspot = tip. Not a filled rect.
	I64 x;
	I64 y;
	I64 i;
	I64 w;

	if (!c || !ut_client_cursor_on)
		return;
	x = ut_uwin_mouse_x;
	y = ut_uwin_mouse_y;
	if (x < 0) x = 0;
	if (y < 0) y = 0;
	if (x >= c->width) x = c->width - 1;
	if (y >= c->height) y = c->height - 1;

	//White body + black outline — 11px tall wedge.
	i = 0;
	while (i < 11)
	{
		w = i / 2;
		if (w > 5)
			w = 5;
		if (i >= 8)
			w = 2;
		if (y + i < c->height)
		{
			if (x + 1 + w < c->width)
				UTSoftDraw2DLine(x + 1, y + i, x + 1 + w, y + i,
					ut_col_black);
			if (x + w < c->width)
				UTSoftDraw2DLine(x, y + i, x + w, y + i, ut_col_white);
		}
		i++;
	}
}

U0 UTClientDrawIncomplete(CUTCanvas *c)
{
	I64 y;
	U8 line[80];

	if (!c)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	UTWinReset;

	UTWinFill(0, 0, c->width, c->height, ut_col_black);
	y = 40;
	UTWinTextAt(16, y, "Engine Client incomplete", ut_col_white);
	y += 16;
	if (ut_client_err[0])
	{
		UTWinTextAt(16, y, ut_client_err, ut_col_label);
		y += 14;
	}
	StrPrint(line, "gaps=%02X %s", ut_client_gap_mask, ut_client_gap_note);
	UTWinTextAt(16, y, line, ut_col_label);
	y += 14;
	StrPrint(line, "url=%s", ut_client_url);
	UTWinTextAt(16, y, line, ut_col_label);
	y += 14;
	UTWinTextAt(16, y, "ESC = UWindow   Q = quit", ut_col_label);
	y += 18;
	UTWinTextAt(16, y, "docs/Apps/UT99/PORT.md", ut_col_label);
}

U0 UTClientDrawGapOverlay(CUTCanvas *c)
{//Soft remaining gaps while Level SoftDrv draws. Not full-screen theater.
	U8 line[96];

	if (!c || !ut_client_gap_mask)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	StrPrint(line, "%s", ut_client_gap_note);
	UTWinTextAt(4, 4, line, ut_col_label);
}

U0 UTClientDrawViewChrome(CUTCanvas *c)
{//ChallengeHUD PostRender + digit tiles; crosshair underlay.
	I64 hx;
	I64 hy;
	I64 steps;

	if (!c || !ut_client_level_bound)
		return;
	if (ut_win_ready)
		ut_win.fb = c;
	steps = 0;
	if (ut_obj_hud >= 0)
		steps = UTObjPostRender;
	UTHUDDraw(c);
	hx = c->width / 2;
	hy = c->height / 2;
	UTSoftDraw2DLine(hx - 3, hy, hx + 3, hy, ut_col_cross);
	UTSoftDraw2DLine(hx, hy - 3, hx, hy + 3, ut_col_cross);
	no_warn steps;
	UTClientDrawGapOverlay(c);
}

U0 UTClientRender(CUTCanvas *c)
{//Frame body after SoftDrv world. No ZealC DM HUD.
	if (!c)
		return;

	if (ut_uwin_active || (ut_menu_open && !ut_client_traveled))
		return;

	if (ut_client_level_bound)
	{
		UTClientDrawViewChrome(c);
		return;
	}

	if (ut_client_traveled && !ut_client_level_bound)
	{
		UTClientDrawIncomplete(c);
		return;
	}

	if (!ut_client_traveled)
	{
		UTClientDrawIncomplete(c);
		return;
	}
}

Bool UTClientWantsWorldDraw()
{//TRUE when Level Model bound SoftDrv.
	return ut_client_level_bound;
}

Bool UTClientInWorld()
{
	return ut_client_level_bound && ut_client_possessed &&
		!ut_menu_open && !ut_uwin_active;
}
