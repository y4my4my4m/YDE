//TrTest.ZC - in-OS self checks for the tracker engine and loaders.
//Run TrTest; from the shell. It replaces whatever song is loaded, so quit
//YTracker first.

I64 trt_pass = 0;
I64 trt_fail = 0;

U0 TrTOk(Bool cond, U8 *fmt, ...)
{
	U8 *s = StrPrintJoin(NULL, fmt, argc, argv);

	if (cond)
	{
		trt_pass++;
		"$$GREEN$$ ok $$FG$$  %s\n", s;
	}
	else
	{
		trt_fail++;
		"$$RED$$FAIL$$FG$$  %s\n", s;
	}
	Free(s);
}

U0 TrTSetup()
{
	TrDataInit;
	MemSet(&tr, 0, sizeof(CTrGlobals));
	tr.master	= 128;
	tr.interp	= TRUE;
	tr.octave	= 4;
	tr.inst		= TRI_SINE;
	tr.step_add	= 1;
	tr.mix_idle	= TRUE;
	tr.stream	= AudioAvailableOutputStreamGet();
	if (tr.stream < 0)
		tr.stream = 0;
}

U0 TrTPeriods()
{
	I64 i, ok = 1;

	"\n$$LTBLUE$$period table$$FG$$\n";
	//Note 49 is C-4 at Amiga period 428, the anchor XM/S3M/IT share.
	//ProTracker C-1 (period 856) is note 37 and displays as C-3.
	TrTOk(TrNotePeriod(49, 0) == 428 * TR_PERIOD_SCALE,
		  "note 49 period %d, want %d", TrNotePeriod(49, 0),
		  428 * TR_PERIOD_SCALE);
	TrTOk(TrNotePeriod(37, 0) == 856 * TR_PERIOD_SCALE,
		  "note 37 period %d, want %d", TrNotePeriod(37, 0),
		  856 * TR_PERIOD_SCALE);
	TrTOk(TrNotePeriod(61, 0) == 214 * TR_PERIOD_SCALE,
		  "note 61 period %d, want %d", TrNotePeriod(61, 0),
		  214 * TR_PERIOD_SCALE);
	for (i = 2; i <= TR_NOTES; i++)
		if (TrNotePeriod(i, 0) >= TrNotePeriod(i - 1, 0))
			ok = 0;
	TrTOk(ok, "periods fall monotonically across all 120 notes");
	TrTOk(TrNotePeriod(49, -8) > TrNotePeriod(49, 0),
		  "negative finetune raises the period");
	//ProTracker's C-1..B-3 is notes 37..72 in this numbering.
	TrTOk(TrPeriodNote(856 * TR_PERIOD_SCALE, 0) == 37 &&
		  TrPeriodNote(428 * TR_PERIOD_SCALE, 0) == 49 &&
		  TrPeriodNote(113 * TR_PERIOD_SCALE, 0) == 72,
		  "period to note round trips at 856 / 428 / 113");
}

U0 TrTSynth()
{
	I64 i, cross = 0, prev = 0, v, blocks = 47, frames;
	CTrChan *c;

	"\n$$LTBLUE$$synthetic waveforms$$FG$$\n";
	TrSynthBuild;
	TrTOk(tr_smp[TRI_SINE].len == 256 && tr_smp[TRI_SINE].data != NULL,
		  "sine slot holds a 256 frame cycle");
	TrTOk(tr_smp[TRI_PULSE1].data[0] > 0 && tr_smp[TRI_PULSE1].data[200] < 0,
		  "pulse50 is high in the first half, low in the second");
	TrTOk(tr_smp[TRI_NOISE].len == 32767,
		  "noise slot holds one full LFSR period");
	TrTOk(tr_smp[TRI_SINE].loop_len == 256 &&
		  tr_smp[TRI_SINE].loop_type == TR_LOOP_FWD,
		  "generated waves loop over their whole length");
	TrTOk(tr_smp[TRI_SINE].data[256] == tr_smp[TRI_SINE].data[0],
		  "interpolation guard frame mirrors the loop point");

	//Count positive-going zero crossings of one second of C-4. The period
	//table, step_mul and resampler all have to be right to land on 261.6 Hz.
	tr_song.channels = 1;
	TrChanInit(0);
	c = &tr_ch[0];
	c->smp			= &tr_smp[TRI_SINE];
	c->inst			= TRI_SINE;
	c->vol			= 64;
	c->mix_vol		= 64;
	c->pan			= 128;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	tr.playing = FALSE;
	for (i = 0; i < blocks; i++)
	{
		TrMixFrames(TR_BLOCK);
		for (v = 0; v < TR_BLOCK; v++)
		{
			if (prev <= 0 && tr_mix_l[v] > 0)
				cross++;
			prev = tr_mix_l[v];
		}
	}
	frames = blocks * TR_BLOCK;
	v = cross * TR_RATE / frames;
	TrTOk(259 <= v <= 264, "C-4 sine measures %d Hz, want 262", v);
	FifoI64Flush(audio.output[tr.stream].data);
}

U8 *TrTMakeWav(I64 *_size)
{//16-bit mono PCM, 8 frames, values 0, 1000, ... 7000.
	I64	 i, n = 8, dsize = 16, size = 44 + 16;
	U8	*b = CAlloc(size);
	I64	 v;

	MemCopy(b, "RIFF", 4);
	v = size - 8;
	MemCopy(b + 4, &v, 4);
	MemCopy(b + 8, "WAVEfmt ", 8);
	v = 16;
	MemCopy(b + 16, &v, 4);
	b[20] = 1;			//PCM
	b[22] = 1;			//mono
	v = 22050;
	MemCopy(b + 24, &v, 4);
	v = 44100;
	MemCopy(b + 28, &v, 4);
	b[32] = 2;			//block align
	b[34] = 16;			//bits
	MemCopy(b + 36, "data", 4);
	MemCopy(b + 40, &dsize, 4);
	for (i = 0; i < n; i++)
	{
		v = i * 1000;
		b[44 + i * 2]		= v & 0xFF;
		b[44 + i * 2 + 1]	= (v >> 8) & 0xFF;
	}
	*_size = size;

	return b;
}

U0 TrTWav()
{
	I64	 size = 0, n;
	U8	*w;

	"\n$$LTBLUE$$WAV import$$FG$$\n";
	w = TrTMakeWav(&size);
	n = TrSampleImportWav(40, w, size);
	TrTOk(n == 8, "imported %d frames, want 8", n);
	TrTOk(tr_smp[40].data[3] == 3000, "frame 3 is %d, want 3000",
		  tr_smp[40].data[3]);
	//65536 * 22050 * TR_REF_PERIOD / TR_STEP_NUM = 174375.
	TrTOk(174300 < tr_smp[40].step_mul < 174450,
		  "22050 Hz maps to step_mul %d, want 174375", tr_smp[40].step_mul);
	TrTOk(!TrSampleImportWav(41, "not a wav at all............................",
							 44),
		  "non-RIFF input is rejected");
	Free(w);
}

U0 TrTModCell(U8 *b, I64 row, I64 ch, I64 smp, I64 period, I64 eff, I64 par)
{//Write one 4 byte ProTracker cell into a 4 channel pattern at offset 1084.
	U8 *p = b + 1084 + (row * 4 + ch) * 4;

	p[0] = (smp & 0xF0) | ((period >> 8) & 0x0F);
	p[1] = period & 0xFF;
	p[2] = ((smp & 0x0F) << 4) | (eff & 0x0F);
	p[3] = par;
}

U8 *TrTMakeMod(I64 *_size)
{//4 channels, one pattern, one 32 byte looping sample, one cell per effect
//the walk in TrTEffects checks.
	I64	 i, smp_base = 1084 + 1024;
	I64	 size = smp_base + 32;
	U8	*b = CAlloc(size);

	MemCopy(b, "TESTMOD", 7);
	MemCopy(b + 20, "testsample", 10);
	b[20 + 23]	= 16;		//Length 16 words = 32 bytes.
	b[20 + 25]	= 64;		//Volume.
	b[20 + 29]	= 8;		//Loop length 8 words = 16 bytes.
	b[950]		= 1;		//Song length.
	b[952]		= 0;		//order[0]
	MemCopy(b + 1080, "M.K.", 4);

	TrTModCell(b, 0, 0, 1, 428, 0x0C, 0x20);	//Set volume 32.
	TrTModCell(b, 0, 1, 1, 428, 0x00, 0x47);	//Arpeggio.
	TrTModCell(b, 0, 2, 1, 428, 0x04, 0x84);	//Vibrato.
	TrTModCell(b, 0, 3, 1, 428, 0x0A, 0x02);	//Volume slide down 2.
	TrTModCell(b, 1, 0, 0, 214, 0x03, 0x08);	//Tone portamento to 214.
	TrTModCell(b, 2, 0, 0,	 0, 0x0E, 0xC1);	//Note cut on tick 1.
	TrTModCell(b, 3, 1, 1, 428, 0x0E, 0xD3);	//Note delay to tick 3.
	TrTModCell(b, 4, 0, 1, 428, 0x0E, 0x12);	//Fine portamento up 2.
	TrTModCell(b, 5, 0, 0,	 0, 0x0D, 0x10);	//Pattern break to row 10.
	TrTModCell(b, 8, 0, 1, 428, 0x09, 0x02);	//Offset 512, past the end.
	for (i = 0; i < 32; i++)
		b[smp_base + i] = i * 4;
	*_size = size;

	return b;
}

U0 TrTMod()
{
	I64		 size = 0, n_smp, hdr;
	U8		*m;
	CTrCell	*c;

	"\n$$LTBLUE$$MOD loader$$FG$$\n";
	m = TrTMakeMod(&size);
	TrTOk(TrModProbe(m, size, &n_smp, &hdr) == 4 && n_smp == 31 && hdr == 1084,
		  "M.K. probes as 4 channels, 31 samples, header 1084");
	TrTOk(TrModLoad(m, size), "loader accepts the file");
	TrTOk(tr_song.channels == 4, "channels %d, want 4", tr_song.channels);
	TrTOk(tr_song.n_patterns == 1, "patterns %d, want 1", tr_song.n_patterns);
	TrTOk(tr_song.order_len == 1, "order length %d, want 1", tr_song.order_len);
	TrTOk(tr_song.speed == 6 && tr_song.bpm == 125,
		  "default tempo is speed 6, bpm 125");
	c = TrCell(0, 0, 0);
	TrTOk(c != NULL, "pattern 0 exists");
	if (c)
	{
		TrTOk(c->note == 49, "note %d, want 49 (period 428)", c->note);
		TrTOk(c->inst == 1, "instrument %d, want 1", c->inst);
		TrTOk(c->eff == 0x0C && c->param == 0x20,
			  "effect %02X%02X, want 0C20", c->eff, c->param);
	}
	TrTOk(tr_smp[1].len == 32, "sample length %d, want 32", tr_smp[1].len);
	TrTOk(tr_smp[1].volume == 64 && tr_smp[1].finetune == 0,
		  "sample volume 64, finetune 0");
	TrTOk(tr_smp[1].loop_len == 16 && tr_smp[1].loop_type == TR_LOOP_FWD,
		  "loop length %d, want 16", tr_smp[1].loop_len);
	//Signed 8-bit widened to 16: byte 4 * 4 = 16, so 16 * 256 = 4096.
	TrTOk(tr_smp[1].data[4] == 4096, "frame 4 is %d, want 4096",
		  tr_smp[1].data[4]);
	TrTOk(tr_smp[1].data[32] == tr_smp[1].data[0],
		  "guard frame mirrors the loop start");
	Free(m);
}

U0 TrTEffects()
{//Walks the pattern TrTMakeMod built. TrTMod must have loaded it first.
	I64 i, vp, before;

	"\n$$LTBLUE$$sequencer and effects$$FG$$\n";
	tr.pat_mode = FALSE;
	TrPlayReset(0, 0);
	tr.playing = TRUE;

	TrSeqTick;						//Row 0, tick 0.
	TrTOk(tr_ch[0].vol == 32, "Cxx set volume to %d, want 32", tr_ch[0].vol);
	TrTOk(tr_ch[0].active, "note on sounding: smp %d len %d inst %d per %d",
		  tr_ch[0].smp != NULL, tr_smp[1].len, tr_ch[0].inst, tr_ch[0].period);
	TrTOk(tr_ch[3].vol == 64, "instrument default volume applied");
	TrTOk(tr_play.tick_frames == 960, "tick is %d frames at bpm 125, want 960",
		  tr_play.tick_frames);
	vp = tr_ch[2].sound_period;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[2].sound_period != vp, "vibrato moved the period");
	TrTOk(tr_ch[3].vol == 60, "Axy slid 64 to %d over two ticks, want 60",
		  tr_ch[3].vol);
	TrTOk(tr_ch[1].sound_period != tr_ch[0].sound_period,
		  "arpeggio offset the period");
	for (i = 3; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 1.
	TrTOk(tr_play.row == 1, "advanced to row %d, want 1", tr_play.row);
	TrTOk(tr_ch[0].dest_period == 214 * TR_PERIOD_SCALE,
		  "3xx latched target %d, want %d", tr_ch[0].dest_period,
		  214 * TR_PERIOD_SCALE);
	before = tr_ch[0].period;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[0].period < before, "3xx slid the period toward the target");
	for (i = 3; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 2, ECx.
	TrTOk(tr_ch[0].vol != 0, "EC1 has not fired on tick 0");
	TrSeqTick;
	TrTOk(tr_ch[0].vol == 0, "EC1 cut the volume on tick 1");
	for (i = 2; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 3, EDx on channel 1.
	TrTOk(tr_ch[1].delay_ticks == 3, "ED3 armed a %d tick delay, want 3",
		  tr_ch[1].delay_ticks);
	TrSeqTick;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[1].delay_ticks == -1 && tr_ch[1].active,
		  "ED3 fired on tick 3");
	for (i = 4; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 4, E1x.
	TrTOk(tr_ch[0].period == TrNotePeriod(49, 0) - 2 * TR_PERIOD_SCALE,
		  "E12 fine-ported up by 2 raw units");
	for (i = 1; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 5, Dxx.
	for (i = 1; i < 6; i++)
		TrSeqTick;
	TrSeqTick;
	TrTOk(tr_play.row == 10, "D10 broke to row %d, want 10", tr_play.row);

	//9xx past the end restarts a looping sample at its loop point.
	TrPlayReset(0, 8);
	tr.playing = TRUE;
	TrSeqTick;
	TrTOk(tr_ch[0].active, "902 looping: smp %d len %d loop %d pos %d",
		  tr_ch[0].smp != NULL, tr_smp[1].len, tr_smp[1].loop_len,
		  tr_ch[0].pos_fp >> TR_POS_SHIFT);
	TrTOk((tr_ch[0].pos_fp >> TR_POS_SHIFT) == tr_smp[1].loop_start,
		  "902 landed on the loop start");
	tr_smp[1].loop_len	= 0;
	tr_smp[1].loop_type	= TR_LOOP_NONE;
	TrPlayReset(0, 8);
	tr.playing = TRUE;
	TrSeqTick;
	TrTOk(!tr_ch[0].active, "902 past a one shot sample silences the channel");
	tr_smp[1].loop_len	= 16;
	tr_smp[1].loop_type	= TR_LOOP_FWD;

	tr_song.bpm = 250;
	TrSeqTick;
	TrTOk(tr_play.tick_frames == 480, "at bpm 250 a tick is %d frames, want 480",
		  tr_play.tick_frames);
	tr.playing = FALSE;
	FifoI64Flush(audio.output[tr.stream].data);
}

U0 TrTFile()
{
	I64		 size, kind;
	CTrCell	*c;
	CTrSongV2 *v2;

	"\n$$LTBLUE$$song file round trip$$FG$$\n";
	TrSongNew(6, 3, 32);
	StrCopy(tr_song.title, "roundtrip");
	tr_song.bpm			= 140;
	tr_song.speed		= 4;
	tr_song.order_len	= 2;
	tr_song.order[0]	= 2;
	tr_song.order[1]	= 1;
	c = TrCell(1, 5, 17);
	c->note		= 70;
	c->inst		= 3;
	c->volcmd	= TRV_SET;
	c->volparam	= 33;
	c->eff		= 0x0A;
	c->param	= 0xF0;
	TrTOk(TrSongSave("~/TRTEST.DAT"), "saved YTK3");

	TrSongNew(4, 1, 64);	//Wipe, then read it back.
	kind = TrLoadFile("~/TRTEST.DAT");
	TrTOk(kind == 1, "reload reports kind %d, want 1", kind);
	TrTOk(tr_song.channels == 6, "channels %d, want 6", tr_song.channels);
	TrTOk(tr_song.bpm == 140 && tr_song.speed == 4, "tempo survived");
	TrTOk(tr_song.order_len == 2 && tr_song.order[0] == 2,
		  "order list survived");
	TrTOk(!StrCompare(tr_song.title, "roundtrip"), "title is %s",
		  tr_song.title);
	TrTOk(tr_pat_rows[1] == 32, "pattern 1 has %d rows, want 32",
		  tr_pat_rows[1]);
	c = TrCell(1, 5, 17);
	TrTOk(c && c->note == 70 && c->inst == 3 && c->volcmd == TRV_SET &&
		  c->volparam == 33 && c->eff == 0x0A && c->param == 0xF0,
		  "cell survived intact");
	TrTOk(tr_smp[TRI_SINE].len == 256 && tr_smp[TRI_SINE].data[64] != 0,
		  "generated samples survived the round trip");
	TrTOk(tr_smp[TRI_NOISE].len == 32767, "noise sample survived");
	//Short files must be rejected outright: the fixed header is 344 bytes.
	TrTOk(!TrSongLoadYTK3("YTK3short", 9), "a 9 byte YTK3 file is rejected");

	//YTK2 import.
	size = sizeof(CTrSongV2);
	v2 = CAlloc(size);
	v2->magic		= 'YTK2';
	v2->bpm			= 110;
	v2->order_len	= 2;
	v2->order[0]	= 0;
	v2->order[1]	= 3;
	v2->pat[0].note	= 60;	//MIDI middle C.
	v2->pat[0].vel	= 127;
	v2->pat[0].inst	= TRI_PULSE1;
	TrTOk(TrSongLoadYTK2(v2, size), "YTK2 import accepted");
	c = TrCell(0, 0, 0);
	TrTOk(c && c->note == 49, "MIDI 60 became note %d, want 49", c->note);
	TrTOk(c && c->inst == TRI_PULSE1, "instrument carried over");
	TrTOk(c && c->volcmd == TRV_SET && c->volparam == 64,
		  "velocity 127 became volume column %d, want 64", c->volparam);
	TrTOk(tr_song.bpm == 110, "bpm %d, want 110", tr_song.bpm);
	Free(v2);
}

U0 TrTMixer()
{
	I64	 i, peak = 0, v;
	CTrChan *c;

	"\n$$LTBLUE$$mixer$$FG$$\n";
	TrSongNew(2, 1, 8);
	tr.master = 128;
	TrChanInit(0);
	TrChanInit(1);
	c = &tr_ch[0];
	c->smp			= &tr_smp[TRI_PULSE1];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->pan			= 0;			//Hard left.
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	TrMixFrames(512);
	for (i = 0; i < 512; i++)
	{
		v = tr_mix_l[i];
		if (v < 0)
			v = -v;
		if (v > peak)
			peak = v;
	}
	TrTOk(peak > 0, "left bus carries signal");
	peak = 0;
	for (i = 0; i < 512; i++)
	{
		v = tr_mix_r[i];
		if (v < 0)
			v = -v;
		if (v > peak)
			peak = v;
	}
	TrTOk(peak == 0, "hard left pan leaves the right bus silent, got %d", peak);

	//A non-looping sample must stop on its own.
	TrChanInit(1);
	c = &tr_ch[1];
	TrSampleAlloc(60, 100);
	tr_smp[60].loop_len		= 0;
	tr_smp[60].loop_type	= TR_LOOP_NONE;
	tr_smp[60].step_mul		= 65536;
	for (i = 0; i < 100; i++)
		tr_smp[60].data[i] = 10000;
	TrSampleGuard(&tr_smp[60]);
	c->smp			= &tr_smp[60];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	//At C-4 the step is 0.173 source frames per output frame, so 100 frames
	//of sample take ~580 output frames.
	TrMixFrames(TR_BLOCK);
	TrMixFrames(TR_BLOCK);
	TrTOk(!c->active, "one shot sample deactivated at its end");

	//A looping sample must not.
	TrChanInit(1);
	c = &tr_ch[1];
	tr_smp[60].loop_start	= 0;
	tr_smp[60].loop_len		= 100;
	tr_smp[60].loop_type	= TR_LOOP_FWD;
	TrSampleGuard(&tr_smp[60]);
	c->smp			= &tr_smp[60];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	TrMixFrames(TR_BLOCK);
	TrMixFrames(TR_BLOCK);
	TrTOk(c->active, "looping sample still sounding past its end");
	TrTOk((c->pos_fp >> TR_POS_SHIFT) < 100, "loop kept the position in range");
	FifoI64Flush(audio.output[tr.stream].data);
}

U0 TrTMenu()
{//The menu string is lexed when MenuPush runs, not when the file compiles, so
//a typo in it is invisible until the app opens. Build it here.
	CMenuEntry *e;

	"\n$$LTBLUE$$pull-down menu$$FG$$\n";
	TrMenuPush;
	TrTOk(Fs->cur_menu != NULL, "menu string parsed and pushed");
	e = MenuEntryFind(Fs->cur_menu, "File/SaveAs");
	TrTOk(e && e->message_code == MESSAGE_CMD && e->arg1 == TRM_SAVE,
		  "File/SaveAs sends MESSAGE_CMD %d", TRM_SAVE);
	TrTOk(MenuEntryFind(Fs->cur_menu, "Play/Song") != NULL, "Play/Song exists");
	TrTOk(MenuEntryFind(Fs->cur_menu, "Edit/InsertRow") != NULL,
		  "Edit/InsertRow exists");
	e = MenuEntryFind(Fs->cur_menu, "View/Interpolate");
	TrTOk(e != NULL, "View/Interpolate exists");
	tr.interp = TRUE;
	TrMenuSync;
	TrTOk(e && e->checked, "check mark follows tr.interp on");
	tr.interp = FALSE;
	TrMenuSync;
	TrTOk(e && !e->checked, "check mark follows tr.interp off");
	TrTOk(!Bt(&Fs->win_inhibit, WIf_FOCUS_TASK_MENU),
		  "menu is not inhibited for this task");
	//Every command must be reachable; run them all past the dispatcher. The
	//file ones open pickers, so they are excluded.
	TrMenuCmd(TRM_FOLLOW);
	TrMenuCmd(TRM_EDIT);
	TrMenuCmd(TRM_PANE_INST);
	TrMenuCmd(TRM_PAT_NEXT);
	TrMenuCmd(TRM_PAT_PREV);
	TrMenuCmd(TRM_MUTE);
	TrMenuCmd(TRM_MUTE);
	TrMenuCmd(TRM_STOP);
	TrTOk(tr.pane == TR_PANE_INST, "View/Instruments opened the pane");
	TrMenuCmd(TRM_PANE_INST);
	TrTOk(tr.pane == TR_PANE_NONE, "selecting it again closed the pane");
	MenuPop;
	TrTOk(TRUE, "menu popped without fault");
}

U0 TrTest()
{
	trt_pass = 0;
	trt_fail = 0;
	"$$LTBLUE$$TrTest: YTracker engine$$FG$$\n";
	TrTSetup;
	TrTPeriods;
	TrTSynth;
	TrTWav;
	TrTMod;
	TrTEffects;
	TrTFile;
	TrTMixer;
	TrTMenu;
	TrSongFreeAll;
	"\nTrTest: %d pass, %d fail\n", trt_pass, trt_fail;
	"Run $$LTBLUE$$YTracker;$$FG$$ for the editor.\n";
}
