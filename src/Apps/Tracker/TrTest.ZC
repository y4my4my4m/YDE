//TrTest.ZC - in-OS self checks for the tracker engine and loaders.
//Run TrTest; from the shell. It replaces whatever song is loaded, so quit
//YTracker first.

I64 trt_pass = 0;
I64 trt_fail = 0;

U0 TrTOk(Bool cond, U8 *fmt, ...)
{
	U8 *s = StrPrintJoin(NULL, fmt, argc, argv);

	if (cond)
	{
		trt_pass++;
		"$$GREEN$$ ok $$FG$$  %s\n", s;
	}
	else
	{
		trt_fail++;
		"$$RED$$FAIL$$FG$$  %s\n", s;
	}
	Free(s);
}

U0 TrTSetup()
{
	TrDataInit;
	MemSet(&tr, 0, sizeof(CTrGlobals));
	tr.master	= 128;
	tr.interp	= TRUE;
	tr.octave	= 4;
	tr.inst		= TRI_SINE;
	tr.step_add	= 1;
	tr.mix_idle	= TRUE;
	tr.stream	= AudioAvailableOutputStreamGet();
	if (tr.stream < 0)
		tr.stream = 0;
}

U0 TrTPeriods()
{
	I64 i, ok = 1;

	"\n$$LTBLUE$$period table$$FG$$\n";
	//Note 49 is C-4 at Amiga period 428, the anchor XM/S3M/IT share.
	//ProTracker C-1 (period 856) is note 37 and displays as C-3.
	TrTOk(TrNotePeriod(49, 0) == 428 * TR_PERIOD_SCALE,
		  "note 49 period %d, want %d", TrNotePeriod(49, 0),
		  428 * TR_PERIOD_SCALE);
	TrTOk(TrNotePeriod(37, 0) == 856 * TR_PERIOD_SCALE,
		  "note 37 period %d, want %d", TrNotePeriod(37, 0),
		  856 * TR_PERIOD_SCALE);
	TrTOk(TrNotePeriod(61, 0) == 214 * TR_PERIOD_SCALE,
		  "note 61 period %d, want %d", TrNotePeriod(61, 0),
		  214 * TR_PERIOD_SCALE);
	for (i = 2; i <= TR_NOTES; i++)
		if (TrNotePeriod(i, 0) >= TrNotePeriod(i - 1, 0))
			ok = 0;
	TrTOk(ok, "periods fall monotonically across all 120 notes");
	TrTOk(TrNotePeriod(49, -8) > TrNotePeriod(49, 0),
		  "negative finetune raises the period");
	//ProTracker's C-1..B-3 is notes 37..72 in this numbering.
	TrTOk(TrPeriodNote(856 * TR_PERIOD_SCALE, 0) == 37 &&
		  TrPeriodNote(428 * TR_PERIOD_SCALE, 0) == 49 &&
		  TrPeriodNote(113 * TR_PERIOD_SCALE, 0) == 72,
		  "period to note round trips at 856 / 428 / 113");
}

U0 TrTSynth()
{
	I64 i, cross = 0, prev = 0, v, blocks = 47, frames;
	CTrChan *c;

	"\n$$LTBLUE$$synthetic waveforms$$FG$$\n";
	TrSynthBuild;
	TrTOk(tr_smp[TRI_SINE].len == 256 && tr_smp[TRI_SINE].data != NULL,
		  "sine slot holds a 256 frame cycle");
	TrTOk(tr_smp[TRI_PULSE1].data[0] > 0 && tr_smp[TRI_PULSE1].data[200] < 0,
		  "pulse50 is high in the first half, low in the second");
	TrTOk(tr_smp[TRI_NOISE].len == 32767,
		  "noise slot holds one full LFSR period");
	TrTOk(tr_smp[TRI_SINE].loop_len == 256 &&
		  tr_smp[TRI_SINE].loop_type == TR_LOOP_FWD,
		  "generated waves loop over their whole length");
	TrTOk(tr_smp[TRI_SINE].data[256] == tr_smp[TRI_SINE].data[0],
		  "interpolation guard frame mirrors the loop point");

	//Count positive-going zero crossings of one second of C-4. The period
	//table, step_mul and resampler all have to be right to land on 261.6 Hz.
	tr_song.channels = 1;
	TrChanInit(0);
	c = &tr_ch[0];
	c->smp			= &tr_smp[TRI_SINE];
	c->inst			= TRI_SINE;
	c->vol			= 64;
	c->mix_vol		= 64;
	c->pan			= 128;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	tr.playing = FALSE;
	for (i = 0; i < blocks; i++)
	{
		TrMixFrames(TR_BLOCK);
		for (v = 0; v < TR_BLOCK; v++)
		{
			if (prev <= 0 && tr_mix_l[v] > 0)
				cross++;
			prev = tr_mix_l[v];
		}
	}
	frames = blocks * TR_BLOCK;
	v = cross * TR_RATE / frames;
	TrTOk(259 <= v <= 264, "C-4 sine measures %d Hz, want 262", v);
	FifoI64Flush(audio.output[tr.stream].data);
}

U8 *TrTMakeWav(I64 *_size)
{//16-bit mono PCM, 8 frames, values 0, 1000, ... 7000.
	I64	 i, n = 8, dsize = 16, size = 44 + 16;
	U8	*b = CAlloc(size);
	I64	 v;

	MemCopy(b, "RIFF", 4);
	v = size - 8;
	MemCopy(b + 4, &v, 4);
	MemCopy(b + 8, "WAVEfmt ", 8);
	v = 16;
	MemCopy(b + 16, &v, 4);
	b[20] = 1;			//PCM
	b[22] = 1;			//mono
	v = 22050;
	MemCopy(b + 24, &v, 4);
	v = 44100;
	MemCopy(b + 28, &v, 4);
	b[32] = 2;			//block align
	b[34] = 16;			//bits
	MemCopy(b + 36, "data", 4);
	MemCopy(b + 40, &dsize, 4);
	for (i = 0; i < n; i++)
	{
		v = i * 1000;
		b[44 + i * 2]		= v & 0xFF;
		b[44 + i * 2 + 1]	= (v >> 8) & 0xFF;
	}
	*_size = size;

	return b;
}

U0 TrTWav()
{
	I64	 size = 0, n;
	U8	*w;

	"\n$$LTBLUE$$WAV import$$FG$$\n";
	w = TrTMakeWav(&size);
	n = TrSampleImportWav(40, w, size);
	TrTOk(n == 8, "imported %d frames, want 8", n);
	TrTOk(tr_smp[40].data[3] == 3000, "frame 3 is %d, want 3000",
		  tr_smp[40].data[3]);
	//65536 * 22050 * TR_REF_PERIOD / TR_STEP_NUM = 174375.
	TrTOk(174300 < tr_smp[40].step_mul < 174450,
		  "22050 Hz maps to step_mul %d, want 174375", tr_smp[40].step_mul);
	TrTOk(!TrSampleImportWav(41, "not a wav at all............................",
							 44),
		  "non-RIFF input is rejected");
	Free(w);
}

U0 TrTModCell(U8 *b, I64 row, I64 ch, I64 smp, I64 period, I64 eff, I64 par)
{//Write one 4 byte ProTracker cell into a 4 channel pattern at offset 1084.
	U8 *p = b + 1084 + (row * 4 + ch) * 4;

	p[0] = (smp & 0xF0) | ((period >> 8) & 0x0F);
	p[1] = period & 0xFF;
	p[2] = ((smp & 0x0F) << 4) | (eff & 0x0F);
	p[3] = par;
}

U8 *TrTMakeMod(I64 *_size)
{//4 channels, one pattern, one 32 byte looping sample, one cell per effect
//the walk in TrTEffects checks.
	I64	 i, smp_base = 1084 + 1024;
	I64	 size = smp_base + 32;
	U8	*b = CAlloc(size);

	MemCopy(b, "TESTMOD", 7);
	MemCopy(b + 20, "testsample", 10);
	b[20 + 23]	= 16;		//Length 16 words = 32 bytes.
	b[20 + 25]	= 64;		//Volume.
	b[20 + 29]	= 8;		//Loop length 8 words = 16 bytes.
	b[950]		= 1;		//Song length.
	b[952]		= 0;		//order[0]
	MemCopy(b + 1080, "M.K.", 4);

	TrTModCell(b, 0, 0, 1, 428, 0x0C, 0x20);	//Set volume 32.
	TrTModCell(b, 0, 1, 1, 428, 0x00, 0x47);	//Arpeggio.
	TrTModCell(b, 0, 2, 1, 428, 0x04, 0x84);	//Vibrato.
	TrTModCell(b, 0, 3, 1, 428, 0x0A, 0x02);	//Volume slide down 2.
	TrTModCell(b, 1, 0, 0, 214, 0x03, 0x08);	//Tone portamento to 214.
	TrTModCell(b, 2, 0, 0,	 0, 0x0E, 0xC1);	//Note cut on tick 1.
	TrTModCell(b, 3, 1, 1, 428, 0x0E, 0xD3);	//Note delay to tick 3.
	TrTModCell(b, 4, 0, 1, 428, 0x0E, 0x12);	//Fine portamento up 2.
	TrTModCell(b, 5, 0, 0,	 0, 0x0D, 0x10);	//Pattern break to row 10.
	TrTModCell(b, 8, 0, 1, 428, 0x09, 0x02);	//Offset 512, past the end.
	for (i = 0; i < 32; i++)
		b[smp_base + i] = i * 4;
	*_size = size;

	return b;
}

U8 *trt_ftm_p;
//Scratch instrument for the N163 transposition check, which depends on the
//wave length the instrument declares.
CTrFtmInst trt_ftm_n163;
//Scratch GROOVES payload for the block parse check.
U8 trt_groove_blk[32];
//Scratch instrument for the VRC7 envelope check.
CTrInst trt_vrc7_inst;

U0 TrTFU8(I64 v)
{
	*trt_ftm_p++ = v;
}

U0 TrTFU32(I64 v)
{//Little endian, the only order FTM uses.
	I64 i;

	for (i = 0; i < 4; i++)
		TrTFU8((v >> (i * 8)) & 0xFF);
}

U0 TrTFBlock(U8 *id, I64 ver, I64 size)
{//Block header: 16-byte zero-padded ID, u32 version, u32 payload size.
	I64 i, n = StrLen(id);

	for (i = 0; i < 16; i++)
	{
		if (i < n)
			TrTFU8(id[i]);
		else
			TrTFU8(0);
	}
	TrTFU32(ver);
	TrTFU32(size);
}

U8 *TrTMakeFtm(I64 *_size)
{//Smallest FTM that still exercises the block walk: base 2A03, one track, one
//frame, one pattern, a C-4 on pulse 1 and an F-1 on noise. PATTERNS at block
//version 6, where the row index is one byte and an empty effect carries no
//parameter. Real files use version 5, which inverts both; TrTFtmV5 covers it.
	I64	 i;
	U8	*b = CAlloc(1024);

	trt_ftm_p = b;
	MemCopy(trt_ftm_p, TRFTM_SIG, TRFTM_SIG_LEN);
	trt_ftm_p += TRFTM_SIG_LEN;
	TrTFU32(0x0440);

	//PARAMS ver 6: chip mask, channels, machine, engine speed, vibrato style,
	//two row highlights, Fxx split point.
	TrTFBlock("PARAMS", 6, 1 + 4 * 7);
	TrTFU8(0);					//No expansion chips.
	TrTFU32(TRFTM_CHANS);
	TrTFU32(0);					//NTSC.
	TrTFU32(0);					//Engine speed, 0 = machine default.
	TrTFU32(1);					//New vibrato.
	TrTFU32(4);
	TrTFU32(16);
	TrTFU32(21);				//Split point.

	//HEADER ver 3: one track, its name, then per channel a type byte and one
	//effect-column count. The count is stored minus one, so 0 means one.
	TrTFBlock("HEADER", 3, 1 + 2 + TRFTM_CHANS * 2);
	TrTFU8(0);					//Track count - 1.
	TrTFU8('T'); TrTFU8(0);		//Track name.
	TrTFU8(0); TrTFU8(0);
	TrTFU8(1); TrTFU8(0);
	TrTFU8(2); TrTFU8(0);
	TrTFU8(3); TrTFU8(0);
	TrTFU8(4); TrTFU8(0);

	//INSTRUMENTS ver 6: one 2A03 instrument, every sequence disabled. The
	//shared header is five (enabled, index) pairs whatever the stored count
	//says, then a DPCM key table of eight octaves; at block version above 5
	//each key carries a delta byte as well.
	TrTFBlock("INSTRUMENTS", 6, 4 + 4 + 1 + 4 + 10 + 96 * 3 + 4 + 4);
	TrTFU32(1);					//Instrument count.
	TrTFU32(0);					//Index.
	TrTFU8(1);					//Type 1 = 2A03.
	TrTFU32(5);					//Sequence type count, discarded.
	for (i = 0; i < 5; i++)
	{
		TrTFU8(0);				//Not enabled.
		TrTFU8(0);				//Sequence index.
	}
	for (i = 0; i < 96; i++)
	{
		TrTFU8(0);				//No DPCM sample on this key.
		TrTFU8(0);				//Pitch.
		TrTFU8(0);				//Delta counter.
	}
	TrTFU32(4);
	TrTFU8('n'); TrTFU8('e'); TrTFU8('s'); TrTFU8('1');

	//FRAMES ver 3: frame count, speed, tempo, rows, then the frame table.
	TrTFBlock("FRAMES", 3, 16 + TRFTM_CHANS);
	TrTFU32(1);
	TrTFU32(6);					//Speed.
	TrTFU32(150);				//Tempo.
	TrTFU32(64);				//Rows per pattern.
	TrTFU8(0); TrTFU8(0); TrTFU8(0); TrTFU8(0); TrTFU8(0);

	//PATTERNS ver 6: one record, one row. Note 1 is C, octave 4, so the
	//engine note is 4 * 12 + 1 = 49. Instrument 0x40 and volume 0x10 are the
	//"none" codes. Four effect columns, all empty and so all one byte.
	//Two records: 9 payload bytes for the pulse row, 10 for the noise row,
	//whose first effect column is used and so carries a parameter byte.
	TrTFBlock("PATTERNS", 6, (16 + 9) + (16 + 10));
	TrTFU32(0);					//Track.
	TrTFU32(0);					//Channel position, pulse 1.
	TrTFU32(0);					//Pattern index.
	TrTFU32(1);					//Stored rows.
	TrTFU8(0);					//Row index.
	TrTFU8(1);					//Note C.
	TrTFU8(4);					//Octave.
	TrTFU8(0x40);				//No instrument.
	TrTFU8(0x10);				//No volume.
	TrTFU8(0); TrTFU8(0); TrTFU8(0); TrTFU8(0);
	//Noise, F-1: engine note 18, whose low nibble picks a period.
	TrTFU32(0);
	TrTFU32(3);					//Channel position, noise.
	TrTFU32(0);
	TrTFU32(1);
	TrTFU8(0);
	TrTFU8(6);					//Note F.
	TrTFU8(1);					//Octave.
	TrTFU8(0);					//Instrument 0.
	TrTFU8(0x10);
	//Vxx with parameter 1: on the noise channel that is the short LFSR.
	TrTFU8(18); TrTFU8(1);
	TrTFU8(0); TrTFU8(0); TrTFU8(0);

	TrTFU8('E'); TrTFU8('N'); TrTFU8('D');
	*_size = trt_ftm_p - b;

	return b;
}

U0 TrTFtm()
{
	I64		 size = 0, note, kind, ins;

	U8		*f;
	CTrCell	*c;

	"\n$$LTBLUE$$FTM loader$$FG$$\n";
	f = TrTMakeFtm(&size);
	TrTOk(TrFtmProbe(f, size) == TRFTM_CHANS,
		  "probes as %d channels, want %d", TrFtmProbe(f, size), TRFTM_CHANS);
	//The signature is long and unique, so no other prober may claim it and it
	//may claim nothing else. FTM sits ahead of MOD in TrLoadFile, which has no
	//magic at all.
	TrTOk(!TrXmProbe(f, size) && !TrItProbe(f, size) && !TrS3mProbe(f, size),
		  "no other loader claims an FTM");
	TrTOk(TrFtmLoad(f, size), "loader accepts the file");
	TrTOk(tr_song.channels == TRFTM_CHANS,
		  "channels %d, want %d", tr_song.channels, TRFTM_CHANS);
	TrTOk(tr_song.order_len == 1, "order length %d, want 1", tr_song.order_len);
	//FamiTracker's tempo sets the row rate directly, so it maps to bpm 1:1.
	TrTOk(tr_song.speed == 6 && tr_song.bpm == 150,
		  "speed %d bpm %d, want 6 and 150", tr_song.speed, tr_song.bpm);
	c    = TrCell(tr_song.order[0], 0, 0);
	note = -1;
	if (c)
		note = c->note;
	TrTOk(note == 49, "C-4 lands on note %d, want 49", note);

	//Noise is not pitched: the note's low nibble, inverted, picks one of the
	//sixteen 2A03 periods, and the octave is discarded. Engine note 18 gives
	//nibble 1, so period index 14 and the transpose 13.
	c    = TrCell(tr_song.order[0], 3, 0);
	note = -1;
	if (c)
		note = c->note;
	TrTOk(note == 18, "noise F-1 lands on note %d, want 18", note);
	ins = 0;
	if (c)
		ins = c->inst;
	TrTOk(ins > 0 && tr_inst[ins] != NULL, "noise cell carries instrument %d",
		  ins);
	if (ins > 0 && tr_inst[ins])
	{
		TrTOk(tr_inst[ins]->xpose_of_note[18] == 13,
			  "note 18 transposes to %d, want 13",
			  tr_inst[ins]->xpose_of_note[18]);
		//Every note plays the one LFSR waveform; only the rate changes.
		TrTOk(tr_inst[ins]->smp_of_note[18] ==
			  tr_inst[ins]->smp_of_note[30] &&
			  tr_inst[ins]->smp_of_note[18] > 0,
			  "all noise notes share one sample");
		TrTOk(tr_inst[ins]->xpose_of_note[30] !=
			  tr_inst[ins]->xpose_of_note[18],
			  "a different nibble picks a different period");
		//Vxx reaches the cell and selects through the noise bank, which is
		//how the short LFSR is reachable at all.
		TrTOk(c->eff == TRX_SET_DUTY && c->param == 1,
			  "Vxx became effect %d param %d, want %d and 1",
			  c->eff, c->param, TRX_SET_DUTY);
		TrTOk(tr_inst[ins]->bank == TR_BANK_NOISE,
			  "the noise instrument banks on LFSR mode");
		TrTOk(tr_noise_slot[0] > 0 && tr_noise_slot[1] > 0 &&
			  tr_noise_slot[0] != tr_noise_slot[1],
			  "both LFSR modes are built, slots %d and %d",
			  tr_noise_slot[0], tr_noise_slot[1]);
		//The short sequence repeats after 93 steps, which is what makes it a
		//pitch rather than noise.
		TrTOk(tr_smp[tr_noise_slot[1]].len == 93,
			  "short LFSR is %d frames, want 93",
			  tr_smp[tr_noise_slot[1]].len);
		TrTOk(TrBankSample(tr_inst[ins], 1) == tr_noise_slot[1],
			  "bank entry 1 resolves to the short LFSR");
	}

	//Per-chip transposition is deliberately zero. FTM_CHIPS.md derives an
	//octave down for triangle, S5B and VRC7 and two for FDS, but the modules
	//refute it: written triangle parts already sit where a bass line belongs,
	//and one module writes its triangle above the pulses as a lead.
	//Piano roll. A tracker cell stores a pitch, never a duration, so a note's
	//length is however many rows pass before the next note event on the same
	//channel. That derivation is what the roll draws.
	TrSongNew(2, 1, 16);
	c = TrCell(0, 0, 0);
	if (c)
	{
		c->note = 49;
		c->inst = 1;
	}
	c = TrCell(0, 0, 4);
	if (c)
	{
		c->note = 52;
		c->inst = 1;
	}
	c = TrCell(0, 0, 6);
	if (c)
		c->note = TR_NOTE_OFF;
	TrTOk(TrRollLen(0, 0, 0, 16) == 4,
		  "a note runs until the next one, got %d", TrRollLen(0, 0, 0, 16));
	TrTOk(TrRollLen(0, 0, 4, 16) == 2,
		  "and a note-off ends it, got %d", TrRollLen(0, 0, 4, 16));
	TrTOk(TrRollLen(0, 1, 0, 16) == 16,
		  "an empty channel leaves one note running to the end, got %d",
		  TrRollLen(0, 1, 0, 16));
	//Black keys are the pitch classes a keyboard draws raised.
	TrTOk(!TrRollBlack(49) && TrRollBlack(50) && !TrRollBlack(51),
		  "C is white, C# is black, D is white");

	//Setting a length writes the note-off that ends the note, since a cell
	//carries no duration of its own.
	TrSongNew(2, 1, 16);
	c = TrCell(0, 0, 0);
	if (c)
	{
		c->note = 49;
		c->inst = 1;
	}
	TrRollSetLen(0, 0, 0, 4, 16);
	TrTOk(TrRollLen(0, 0, 0, 16) == 4,
		  "a length of 4 places the note-off, got %d",
		  TrRollLen(0, 0, 0, 16));
	c = TrCell(0, 0, 4);
	TrTOk(c && c->note == TR_NOTE_OFF, "and the off is a real cell");
	//Dragging longer clears the off it previously owned.
	TrRollSetLen(0, 0, 0, 8, 16);
	TrTOk(TrRollLen(0, 0, 0, 16) == 8,
		  "growing to 8 moves it, got %d", TrRollLen(0, 0, 0, 16));
	c = TrCell(0, 0, 4);
	TrTOk(c && !c->note, "leaving the old row empty");

	//Which note a click lands inside, which is what makes a note draggable.
	TrTOk(TrRollNoteRow(0, 0, 3, 49, 16) == 0,
		  "a click three rows into the block finds the note at row 0");
	TrTOk(TrRollNoteRow(0, 0, 3, 50, 16) == -1,
		  "a different pitch is not that note");
	TrTOk(TrRollNoteRow(0, 0, 9, 49, 16) == -1,
		  "and past the end is nothing");

	TrTOk(TrFtmKindXpose(TRFTM_KIND_PULSE, NULL) == 0 &&
		  TrFtmKindXpose(TRFTM_KIND_TRI, NULL) == 0 &&
		  TrFtmKindXpose(TRFTM_KIND_FDS, NULL) == 0 &&
		  TrFtmKindXpose(TRFTM_KIND_VRC7, NULL) == 0 &&
		  TrFtmKindXpose(TRFTM_KIND_S5B, NULL) == 0,
		  "every kind plays at the written pitch");
	MemSet(&trt_ftm_n163, 0, sizeof(CTrFtmInst));
	trt_ftm_n163.wave_len = 32;
	TrTOk(TrFtmKindXpose(TRFTM_KIND_N163, &trt_ftm_n163) == 0,
		  "including N163 whatever its wave length");

	//Effect ordinals 26..28 are the FDS modulator. The same letters are a
	//hardware sweep elsewhere, so the channel's chip has to decide; mapping
	//them on a pulse channel would detune it instead.
	note = 0x3F;
	TrTOk(TrFtmEffect(TRFTM_KIND_FDS, 26, &note, 0x0440) == TRX_FDS_DEPTH &&
		  note == 0x3F, "Hxx on FDS is modulation depth");
	note = 0x1F;
	TrTOk(TrFtmEffect(TRFTM_KIND_FDS, 27, &note, 0x0440) == TRX_FDS_RATE_HI &&
		  note == 0x0F, "Ixx on FDS is the rate high nibble, masked to 4 bits");
	note = 0xAB;
	TrTOk(TrFtmEffect(TRFTM_KIND_FDS, 28, &note, 0x0440) == TRX_FDS_RATE_LO &&
		  note == 0xAB, "Jxx on FDS is the rate low byte");
	note = 0x3F;
	TrTOk(TrFtmEffect(TRFTM_KIND_PULSE, 26, &note, 0x0440) == -1,
		  "the same ordinal on a pulse channel maps to nothing");
	note = 0x3F;
	TrTOk(TrFtmEffect(TRFTM_KIND_V6SAW, 28, &note, 0x0440) == -1,
		  "and nothing on a VRC6 saw");

	//S5B. Its DAC is logarithmic at 3 dB a step where every other chip here is
	//linear, so volume 8 is a twelfth of full scale, not half.
	TrTOk(tr_ftm_s5b_vol[15] == 64 && tr_ftm_s5b_vol[0] == 0,
		  "S5B volume spans the full range");
	TrTOk(tr_ftm_s5b_vol[8] < 64 / 4,
		  "S5B volume 8 is %d of 64, well under half", tr_ftm_s5b_vol[8]);
	note = 0;
	for (kind = 1; kind < 16; kind++)
		if (tr_ftm_s5b_vol[kind] < tr_ftm_s5b_vol[kind - 1])
			note = 1;
	TrTOk(!note, "the S5B volume table never decreases");
	TrTOk(TrFtmS5bSlot(0) > 0 && TrFtmS5bSlot(1) > 0 &&
		  TrFtmS5bSlot(0) != TrFtmS5bSlot(1),
		  "S5B tone and noise are separate samples");
	//The noise LFSR is 17-bit tapped at 16 and 13, a different polynomial and
	//a far longer period than the 2A03's 15-bit one.
	TrTOk(tr_smp[TrFtmS5bSlot(1)].len == 131071,
		  "S5B noise is %d frames, want 131071",
		  tr_smp[TrFtmS5bSlot(1)].len);
	note = 3;
	TrTOk(TrFtmEffect(TRFTM_KIND_S5B, 18, &note, 0x0440) == TRX_SET_DUTY &&
		  note == 1, "Vxx with the noise bit selects noise");
	note = 1;
	TrTOk(TrFtmEffect(TRFTM_KIND_S5B, 18, &note, 0x0440) == TRX_SET_DUTY &&
		  note == 0, "Vxx with tone alone selects the square");

	//DPCM rate tables. Both are tuned to the same pitches, so the rates agree
	//closely even though the clock and the periods both differ. A PAL module
	//played off the NTSC table runs about 7 per cent sharp.
	TrTOk(tr_ftm_dpcm_period_pal[0] == 398 && tr_ftm_dpcm_period[0] == 428,
		  "the two DPCM period tables are distinct");
	note = TRFTM_CPU_NTSC / tr_ftm_dpcm_period[0];
	kind = TRFTM_CPU_PAL / tr_ftm_dpcm_period_pal[0];
	TrTOk(note - kind < 64 && kind - note < 64,
		  "index 0 is %d Hz NTSC and %d Hz PAL, within a per cent", note, kind);

	//Effect ordinals 33..41 are stored permuted. Both forks apply this on
	//write unconditionally, so it is not confined to old files; reading a
	//stored 34 as ordinal 34 gives a VRC7 register write instead of a groove.
	TrTOk(TrFtmStoredEffect(32) == 32 && TrFtmStoredEffect(42) == 42,
		  "ordinals outside 33..41 are stored as written");
	TrTOk(TrFtmStoredEffect(33) == 36 && TrFtmStoredEffect(34) == 37 &&
		  TrFtmStoredEffect(38) == 41,
		  "stored 33, 34 and 38 mean 36, 37 and 41");
	TrTOk(TrFtmStoredEffect(39) == 33 && TrFtmStoredEffect(41) == 35,
		  "stored 39 and 41 mean 33 and 35");
	note = 0;
	for (kind = 33; kind <= 41; kind++)
	{//The permutation is a bijection over its own range.
		ins = TrFtmStoredEffect(kind);
		if (ins < 33 || ins > 41)
			note = 1;
	}
	TrTOk(!note, "the permutation stays inside 33..41");
	note = 5;
	TrTOk(TrFtmEffect(TRFTM_KIND_PULSE, 37, &note, 0x0440) == TRX_GROOVE &&
		  note == 5, "ordinal 37 is the groove select, on any channel");

	//GROOVES. Two grooves, then the tail carrying one flag per track. The
	//use-groove flag lives here rather than in PARAMS or FRAMES, so the
	//FRAMES speed field only becomes readable once this block is parsed.
	MemSet(trt_groove_blk, 0, 32);
	trt_groove_blk[0]  = 2;			//Two grooves present.
	trt_groove_blk[1]  = 0;			//Slot 0.
	trt_groove_blk[2]  = 3;			//Three entries.
	trt_groove_blk[3]  = 7;
	trt_groove_blk[4]  = 4;
	trt_groove_blk[5]  = 5;
	trt_groove_blk[6]  = 5;			//Slot 5.
	trt_groove_blk[7]  = 2;			//Two entries.
	trt_groove_blk[8]  = 9;
	trt_groove_blk[9]  = 3;
	trt_groove_blk[10] = 1;			//Track count.
	trt_groove_blk[11] = 1;			//Track 0 uses a groove.
	MemSet(tr_groove_len, 0, sizeof(tr_groove_len));
	TrTOk(TrFtmGrooveLoad(trt_groove_blk, 0, 12, 1),
		  "the tail reports track 0 as groove driven");
	TrTOk(tr_groove_len[0] == 3 && tr_groove[0][0] == 7 &&
		  tr_groove[0][2] == 5, "slot 0 holds 7 4 5");
	TrTOk(tr_groove_len[5] == 2 && tr_groove[5][0] == 9,
		  "the table is sparse: slot 5 carries its own index");
	TrTOk(tr_groove_len[1] == 0, "slots between stay empty");

	//Runtime: one entry per row, cycling, and Fxx in its speed branch cancels
	//the groove for good rather than for one row.
	tr_groove_idx = 0;
	tr_groove_pos = 0;
	TrSongNew(1, 1, 8);
	tr_groove_idx = 0;
	tr_groove_pos = 0;
	TrSeqRow;
	note = tr_song.speed;
	TrSeqRow;
	kind = tr_song.speed;
	TrSeqRow;
	ins = tr_song.speed;
	TrTOk(note == 7 && kind == 4 && ins == 5,
		  "the groove steps 7 4 5, got %d %d %d", note, kind, ins);
	TrSeqRow;
	TrTOk(tr_song.speed == 7, "and wraps to the start, got %d",
		  tr_song.speed);
	tr_groove_idx = -1;
	TrTOk(TRUE, "an Fxx speed clears the index, which stops the stepping");

	//VRC7. The patch ROM, the baked FM wave and the carrier envelope, which is
	//the only envelope the chip has: without it every note holds at full level
	//until something cuts it.
	TrTOk(tr_ftm_vrc7_patch[0][0] == 0x03 && tr_ftm_vrc7_patch[0][7] == 0x27,
		  "patch 1 is the Buzzy Bell row");
	TrTOk(tr_ftm_vrc7_patch[14][0] == 0x21 && tr_ftm_vrc7_patch[14][7] == 0x06,
		  "patch 15 is the Sweep row");
	note = TrSampleNextFree();
	TrFmFill(note, tr_ftm_vrc7_patch[2]);
	TrTOk(tr_smp[note].data != NULL && tr_smp[note].len == TR_WAVE_LEN * 2,
		  "a baked voice spans two fundamental periods");
	kind = 0;
	for (ins = 0; ins < tr_smp[note].len; ins++)
		if (tr_smp[note].data[ins] != tr_smp[note].data[0])
			kind = 1;
	TrTOk(kind, "and is not a constant");
	TrSampleFree(note);

	//EG-type is bit 5 of the carrier byte. Clear decays to silence, which is
	//what a percussive patch wants; set holds at the sustain level.
	MemSet(&trt_vrc7_inst, 0, sizeof(CTrInst));
	MemSet(trt_groove_blk, 0, 8);
	trt_groove_blk[1] = 0;			//Carrier byte, EG-type clear.
	trt_groove_blk[5] = 0xF4;		//Fast attack, mid decay.
	trt_groove_blk[7] = 0x00;		//Sustain level 0.
	TrFtmVrc7Env(&trt_vrc7_inst, trt_groove_blk);
	TrTOk(trt_vrc7_inst.vol_env.flags & TR_ENV_ON,
		  "a percussive patch gets a volume envelope");
	TrTOk(!(trt_vrc7_inst.vol_env.flags & TR_ENV_SUSTAIN),
		  "with no sustain, so it decays away");
	note = trt_vrc7_inst.vol_env.n_points - 1;
	TrTOk(trt_vrc7_inst.vol_env.value[note] == 0,
		  "ending at silence, got %d", trt_vrc7_inst.vol_env.value[note]);
	trt_groove_blk[1] = 0x20;		//EG-type set.
	TrFtmVrc7Env(&trt_vrc7_inst, trt_groove_blk);
	TrTOk(trt_vrc7_inst.vol_env.flags & TR_ENV_SUSTAIN,
		  "a sustained patch holds while the key is down");
	//Reaching the loader through the dispatcher, which is what the editor
	//uses. Deliberately the wrong extension: detection is by content.
	FileWrite("~/TRFAMI.DAT", f, size);
	TrSongNew(4, 1, 64);
	kind = TrLoadFile("~/TRFAMI.DAT");
	TrTOk(kind == 7, "TrLoadFile reports kind %d, want 7", kind);
	TrTOk(tr_song.channels == TRFTM_CHANS,
		  "and loaded %d channels", tr_song.channels);
	Free(f);

	//A truncated file must be refused rather than faulted on.
	f = TrTMakeFtm(&size);
	TrTOk(!TrFtmProbe(f, TRFTM_SIG_LEN), "a header-only file does not probe");
	Free(f);
	TrTOk(!TrFtmProbe("FamiTracker Modul", 17), "a short signature is refused");
}

U0 TrTItComp()
{//IT214 16-bit sample decompression.
//
//The stream sets width 17 -> 8, then emits four literals. At width 8 the
//width-change window is 120..135; the literal 140 sits just above it. A bound
//that is too wide reads it as a width change, runs the width past 17 and
//aborts the block, which the loader turns into a silent sample.
	U8	blk[9];
	I16	out[4];
	I64	i, r;
	I64	want[4];

	"\n$$LTBLUE$$IT sample decompression$$FG$$\n";
	blk[0] = 0x07; blk[1] = 0x00; blk[2] = 0x07; blk[3] = 0x00; blk[4] = 0x19;
	blk[5] = 0x15; blk[6] = 0x90; blk[7] = 0x0B; blk[8] = 0x00;
	want[0] = -116; want[1] = -106; want[2] = -162; want[3] = -157;
	MemSet(out, 0, sizeof(out));
	//bits16 is the raw sample flag bit, so it arrives as 2, not 1.
	r = TrItDecompress(blk, 9, 0, out, 4, 2, FALSE);
	TrTOk(r > 0, "16-bit block decodes, got %d", r);
	for (i = 0; i < 4; i++)
		TrTOk(out[i] == want[i], "point %d is %d, want %d",
			  i, out[i], want[i]);
}

U0 TrTMod()
{
	I64		 size = 0, n_smp, hdr;
	U8		*m;
	CTrCell	*c;

	"\n$$LTBLUE$$MOD loader$$FG$$\n";
	m = TrTMakeMod(&size);
	TrTOk(TrModProbe(m, size, &n_smp, &hdr) == 4 && n_smp == 31 && hdr == 1084,
		  "M.K. probes as 4 channels, 31 samples, header 1084");
	TrTOk(TrModLoad(m, size), "loader accepts the file");
	TrTOk(tr_song.channels == 4, "channels %d, want 4", tr_song.channels);
	TrTOk(tr_song.n_patterns == 1, "patterns %d, want 1", tr_song.n_patterns);
	TrTOk(tr_song.order_len == 1, "order length %d, want 1", tr_song.order_len);
	TrTOk(tr_song.speed == 6 && tr_song.bpm == 125,
		  "default tempo is speed 6, bpm 125");
	c = TrCell(0, 0, 0);
	TrTOk(c != NULL, "pattern 0 exists");
	if (c)
	{
		TrTOk(c->note == 49, "note %d, want 49 (period 428)", c->note);
		TrTOk(c->inst == 1, "instrument %d, want 1", c->inst);
		TrTOk(c->eff == 0x0C && c->param == 0x20,
			  "effect %02X%02X, want 0C20", c->eff, c->param);
	}
	TrTOk(tr_smp[1].len == 32, "sample length %d, want 32", tr_smp[1].len);
	TrTOk(tr_smp[1].volume == 64 && tr_smp[1].finetune == 0,
		  "sample volume 64, finetune 0");
	TrTOk(tr_smp[1].loop_len == 16 && tr_smp[1].loop_type == TR_LOOP_FWD,
		  "loop length %d, want 16", tr_smp[1].loop_len);
	//Signed 8-bit widened to 16: byte 4 * 4 = 16, so 16 * 256 = 4096.
	TrTOk(tr_smp[1].data[4] == 4096, "frame 4 is %d, want 4096",
		  tr_smp[1].data[4]);
	TrTOk(tr_smp[1].data[32] == tr_smp[1].data[0],
		  "guard frame mirrors the loop start");
	Free(m);
}

U0 TrTEffects()
{//Walks the pattern TrTMakeMod built. TrTMod must have loaded it first.
	I64 i, vp, before;

	"\n$$LTBLUE$$sequencer and effects$$FG$$\n";
	tr.pat_mode = FALSE;
	TrPlayReset(0, 0);
	tr.playing = TRUE;

	TrSeqTick;						//Row 0, tick 0.
	TrTOk(tr_ch[0].vol == 32, "Cxx set volume to %d, want 32", tr_ch[0].vol);
	TrTOk(tr_ch[0].active, "note on sounding: smp %d len %d inst %d per %d",
		  tr_ch[0].smp != NULL, tr_smp[1].len, tr_ch[0].inst, tr_ch[0].period);
	TrTOk(tr_ch[3].vol == 64, "instrument default volume applied");
	TrTOk(tr_play.tick_frames == 960, "tick is %d frames at bpm 125, want 960",
		  tr_play.tick_frames);
	vp = tr_ch[2].sound_period;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[2].sound_period != vp, "vibrato moved the period");
	TrTOk(tr_ch[3].vol == 60, "Axy slid 64 to %d over two ticks, want 60",
		  tr_ch[3].vol);
	TrTOk(tr_ch[1].sound_period != tr_ch[0].sound_period,
		  "arpeggio offset the period");
	for (i = 3; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 1.
	TrTOk(tr_play.row == 1, "advanced to row %d, want 1", tr_play.row);
	TrTOk(tr_ch[0].dest_period == 214 * TR_PERIOD_SCALE,
		  "3xx latched target %d, want %d", tr_ch[0].dest_period,
		  214 * TR_PERIOD_SCALE);
	before = tr_ch[0].period;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[0].period < before, "3xx slid the period toward the target");
	for (i = 3; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 2, ECx.
	TrTOk(tr_ch[0].vol != 0, "EC1 has not fired on tick 0");
	TrSeqTick;
	TrTOk(tr_ch[0].vol == 0, "EC1 cut the volume on tick 1");
	for (i = 2; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 3, EDx on channel 1.
	TrTOk(tr_ch[1].delay_ticks == 3, "ED3 armed a %d tick delay, want 3",
		  tr_ch[1].delay_ticks);
	TrSeqTick;
	TrSeqTick;
	TrSeqTick;
	TrTOk(tr_ch[1].delay_ticks == -1 && tr_ch[1].active,
		  "ED3 fired on tick 3");
	for (i = 4; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 4, E1x.
	TrTOk(tr_ch[0].period == TrNotePeriod(49, 0) - 2 * TR_PERIOD_SCALE,
		  "E12 fine-ported up by 2 raw units");
	for (i = 1; i < 6; i++)
		TrSeqTick;
	TrSeqTick;						//Row 5, Dxx.
	for (i = 1; i < 6; i++)
		TrSeqTick;
	TrSeqTick;
	TrTOk(tr_play.row == 10, "D10 broke to row %d, want 10", tr_play.row);

	//9xx past the end restarts a looping sample at its loop point.
	TrPlayReset(0, 8);
	tr.playing = TRUE;
	TrSeqTick;
	TrTOk(tr_ch[0].active, "902 looping: smp %d len %d loop %d pos %d",
		  tr_ch[0].smp != NULL, tr_smp[1].len, tr_smp[1].loop_len,
		  tr_ch[0].pos_fp >> TR_POS_SHIFT);
	TrTOk((tr_ch[0].pos_fp >> TR_POS_SHIFT) == tr_smp[1].loop_start,
		  "902 landed on the loop start");
	tr_smp[1].loop_len	= 0;
	tr_smp[1].loop_type	= TR_LOOP_NONE;
	TrPlayReset(0, 8);
	tr.playing = TRUE;
	TrSeqTick;
	TrTOk(!tr_ch[0].active, "902 past a one shot sample silences the channel");
	tr_smp[1].loop_len	= 16;
	tr_smp[1].loop_type	= TR_LOOP_FWD;

	tr_song.bpm = 250;
	TrSeqTick;
	TrTOk(tr_play.tick_frames == 480, "at bpm 250 a tick is %d frames, want 480",
		  tr_play.tick_frames);
	tr.playing = FALSE;
	FifoI64Flush(audio.output[tr.stream].data);
}

U0 TrTFile()
{
	I64		 size, kind;
	CTrCell	*c;
	CTrSongV2 *v2;

	"\n$$LTBLUE$$song file round trip$$FG$$\n";
	TrSongNew(6, 3, 32);
	StrCopy(tr_song.title, "roundtrip");
	tr_song.bpm			= 140;
	tr_song.speed		= 4;
	tr_song.order_len	= 2;
	tr_song.order[0]	= 2;
	tr_song.order[1]	= 1;
	c = TrCell(1, 5, 17);
	c->note		= 70;
	c->inst		= 3;
	c->volcmd	= TRV_SET;
	c->volparam	= 33;
	c->eff		= 0x0A;
	c->param	= 0xF0;
	TrTOk(TrSongSave("~/TRTEST.DAT"), "saved YTK3");

	TrSongNew(4, 1, 64);	//Wipe, then read it back.
	kind = TrLoadFile("~/TRTEST.DAT");
	TrTOk(kind == 1, "reload reports kind %d, want 1", kind);
	TrTOk(tr_song.channels == 6, "channels %d, want 6", tr_song.channels);
	TrTOk(tr_song.bpm == 140 && tr_song.speed == 4, "tempo survived");
	TrTOk(tr_song.order_len == 2 && tr_song.order[0] == 2,
		  "order list survived");
	TrTOk(!StrCompare(tr_song.title, "roundtrip"), "title is %s",
		  tr_song.title);
	TrTOk(tr_pat_rows[1] == 32, "pattern 1 has %d rows, want 32",
		  tr_pat_rows[1]);
	c = TrCell(1, 5, 17);
	TrTOk(c && c->note == 70 && c->inst == 3 && c->volcmd == TRV_SET &&
		  c->volparam == 33 && c->eff == 0x0A && c->param == 0xF0,
		  "cell survived intact");
	TrTOk(tr_smp[TRI_SINE].len == 256 && tr_smp[TRI_SINE].data[64] != 0,
		  "generated samples survived the round trip");
	TrTOk(tr_smp[TRI_NOISE].len == 32767, "noise sample survived");
	//Short files must be rejected outright: the fixed header is 344 bytes.
	TrTOk(!TrSongLoadYTK3("YTK3short", 9), "a 9 byte YTK3 file is rejected");

	//YTK2 import.
	size = sizeof(CTrSongV2);
	v2 = CAlloc(size);
	v2->magic		= 'YTK2';
	v2->bpm			= 110;
	v2->order_len	= 2;
	v2->order[0]	= 0;
	v2->order[1]	= 3;
	v2->pat[0].note	= 60;	//MIDI middle C.
	v2->pat[0].vel	= 127;
	v2->pat[0].inst	= TRI_PULSE1;
	TrTOk(TrSongLoadYTK2(v2, size), "YTK2 import accepted");
	c = TrCell(0, 0, 0);
	TrTOk(c && c->note == 49, "MIDI 60 became note %d, want 49", c->note);
	TrTOk(c && c->inst == TRI_PULSE1, "instrument carried over");
	TrTOk(c && c->volcmd == TRV_SET && c->volparam == 64,
		  "velocity 127 became volume column %d, want 64", c->volparam);
	TrTOk(tr_song.bpm == 110, "bpm %d, want 110", tr_song.bpm);
	Free(v2);
}

U0 TrTMixer()
{
	I64	 i, peak = 0, v;
	CTrChan *c;

	"\n$$LTBLUE$$mixer$$FG$$\n";
	TrSongNew(2, 1, 8);
	tr.master = 128;
	TrChanInit(0);
	TrChanInit(1);
	c = &tr_ch[0];
	c->smp			= &tr_smp[TRI_PULSE1];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->pan			= 0;			//Hard left.
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	TrMixFrames(512);
	for (i = 0; i < 512; i++)
	{
		v = tr_mix_l[i];
		if (v < 0)
			v = -v;
		if (v > peak)
			peak = v;
	}
	TrTOk(peak > 0, "left bus carries signal");
	peak = 0;
	for (i = 0; i < 512; i++)
	{
		v = tr_mix_r[i];
		if (v < 0)
			v = -v;
		if (v > peak)
			peak = v;
	}
	TrTOk(peak == 0, "hard left pan leaves the right bus silent, got %d", peak);

	//A non-looping sample must stop on its own.
	TrChanInit(1);
	c = &tr_ch[1];
	TrSampleAlloc(60, 100);
	tr_smp[60].loop_len		= 0;
	tr_smp[60].loop_type	= TR_LOOP_NONE;
	tr_smp[60].step_mul		= 65536;
	for (i = 0; i < 100; i++)
		tr_smp[60].data[i] = 10000;
	TrSampleGuard(&tr_smp[60]);
	c->smp			= &tr_smp[60];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	//At C-4 the step is 0.173 source frames per output frame, so 100 frames
	//of sample take ~580 output frames.
	TrMixFrames(TR_BLOCK);
	TrMixFrames(TR_BLOCK);
	TrTOk(!c->active, "one shot sample deactivated at its end");

	//A looping sample must not.
	TrChanInit(1);
	c = &tr_ch[1];
	tr_smp[60].loop_start	= 0;
	tr_smp[60].loop_len		= 100;
	tr_smp[60].loop_type	= TR_LOOP_FWD;
	TrSampleGuard(&tr_smp[60]);
	c->smp			= &tr_smp[60];
	c->vol			= 64;
	c->mix_vol		= 64;
	c->period		= TrNotePeriod(49, 0);
	c->sound_period	= c->period;
	TrChanStep(c);
	TrChanTrigger(c, 0);
	TrMixFrames(TR_BLOCK);
	TrMixFrames(TR_BLOCK);
	TrTOk(c->active, "looping sample still sounding past its end");
	TrTOk((c->pos_fp >> TR_POS_SHIFT) < 100, "loop kept the position in range");
	FifoI64Flush(audio.output[tr.stream].data);
}

U0 TrTMacro()
{//Macros, the duty bank and wavetables: the DefleMask-style instrument layer.
	CTrInst	 *ins;
	CTrChan	 *c;
	CTrMacro *m;
	I64		  i, pos, hi, slot, n, sum;

	"\n$$LTBLUE$$instrument macros and wave banks$$FG$$\n";
	TrSongNew(4, 1, 8);

	TrTOk(tr_duty_slot[0] > 0 && tr_smp[tr_duty_slot[0]].data != NULL,
		  "duty bank built, slot %d", tr_duty_slot[0]);
	TrTOk(tr_wave_slot[0] > 0 && tr_smp[tr_wave_slot[0]].data != NULL,
		  "wave bank built, slot %d", tr_wave_slot[0]);
	TrTOk(tr_duty_slot[3] != tr_duty_slot[0], "each duty has its own slot");

	//12.5 per cent duty: one eighth of the cycle high.
	slot = tr_duty_slot[0];
	hi = 0;
	for (i = 0; i < TR_WAVE_LEN; i++)
		if (tr_smp[slot].data[i] > 0)
			hi++;
	TrTOk(hi == TR_WAVE_LEN / 8, "duty 0 is %d of %d frames high, want %d",
		  hi, TR_WAVE_LEN, TR_WAVE_LEN / 8);
	slot = tr_duty_slot[2];
	hi = 0;
	for (i = 0; i < TR_WAVE_LEN; i++)
		if (tr_smp[slot].data[i] > 0)
			hi++;
	TrTOk(hi == TR_WAVE_LEN / 2, "duty 2 is half high, got %d", hi);
	TrTOk(tr_smp[tr_duty_slot[0]].loop_len == TR_WAVE_LEN,
		  "duty waves loop over the whole cycle");

	//Every duty wave carries no DC. A plain +/- square does: at 12.5% it sits
	//at -0.75 full scale and at 75% at +0.5, so a duty macro would step the
	//output on every change and the offset would eat headroom.
	for (n = 0; n < TR_DUTY_COUNT; n++)
	{
		slot = tr_duty_slot[n];
		if (slot && tr_smp[slot].data)
		{
			sum = 0;
			for (i = 0; i < TR_WAVE_LEN; i++)
				sum += tr_smp[slot].data[i];
			//Integer rounding leaves a few units per frame at worst.
			TrTOk(-TR_WAVE_LEN <= sum <= TR_WAVE_LEN,
				  "duty %d sums to %d over %d frames, want near 0",
				  n, sum, TR_WAVE_LEN);
		}
	}
	//Peak-to-peak is the same for all four, which is what a DC block leaves,
	//so duty sets timbre and not level.
	TrTOk(tr_smp[tr_duty_slot[0]].data[0] - tr_smp[tr_duty_slot[0]].data[TR_WAVE_LEN - 1] ==
		  tr_smp[tr_duty_slot[2]].data[0] - tr_smp[tr_duty_slot[2]].data[TR_WAVE_LEN - 1],
		  "12.5%% and 50%% duty have the same peak-to-peak");

	slot = tr_wave_slot[0];
	TrTOk(tr_smp[slot].data[0] < tr_smp[slot].data[TR_WAVE_LEN - 1],
		  "default ramp wavetable renders rising");
	//The default ramp maps 32 steps onto 0..15, so neighbours repeat. Use a
	//table whose first two steps differ to see the hold boundary.
	for (i = 0; i < TR_WAVE_STEPS; i++)
		tr_wave[2].step[i] = 0;
	tr_wave[2].step[1] = TR_WAVE_MAX;
	TrWaveRender(2);
	slot = tr_wave_slot[2];
	TrTOk(tr_smp[slot].data[0] == tr_smp[slot].data[7] &&
		  tr_smp[slot].data[0] != tr_smp[slot].data[8],
		  "wavetable steps are held for 8 frames");
	for (i = 0; i < TR_WAVE_STEPS; i++)
		tr_wave[1].step[i] = 7;
	TrWaveRender(1);
	slot = tr_wave_slot[1];
	TrTOk(AbsI64(tr_smp[slot].data[0]) < 2000, "flat table renders quiet, %d",
		  tr_smp[slot].data[0]);

	//Stepping: loop while the key is down, release section after key off.
	ins = TrInstAlloc(20);
	TrTOk(ins != NULL, "instrument record allocated");
	m = &ins->macro[TR_MACRO_VOL];
	m->len		= 6;
	m->loop		= 2;
	m->release	= 4;
	for (i = 0; i < 6; i++)
		m->val[i] = i * 10;
	pos = 0;
	TrMacroStep(m, &pos, TRUE);
	TrTOk(pos == 1, "macro advanced to %d", pos);
	TrMacroStep(m, &pos, TRUE);
	TrMacroStep(m, &pos, TRUE);
	TrTOk(pos == 3, "advances up to the release point, got %d", pos);
	TrMacroStep(m, &pos, TRUE);
	TrTOk(pos == 2, "reaching release with the key down loops back, got %d",
		  pos);
	pos = 4;
	TrMacroStep(m, &pos, FALSE);
	TrTOk(pos == 5, "release section runs on, got %d", pos);
	TrMacroStep(m, &pos, FALSE);
	TrTOk(pos == 5, "and then holds, got %d", pos);
	TrTOk(TrMacroValue(m, 99) == 50, "value past the end holds the last step");

	//Volume and duty macros applied to a channel.
	MemSet(&ins->macro[TR_MACRO_VOL], 0, sizeof(CTrMacro));
	ins->macro[TR_MACRO_VOL].len	 = 2;
	ins->macro[TR_MACRO_VOL].loop	 = -1;
	ins->macro[TR_MACRO_VOL].release = -1;
	ins->macro[TR_MACRO_VOL].val[0]	 = 32;
	ins->macro[TR_MACRO_VOL].val[1]	 = 0;
	ins->bank = TR_BANK_DUTY;
	ins->macro[TR_MACRO_DUTY].len	  = 2;
	ins->macro[TR_MACRO_DUTY].loop	  = -1;
	ins->macro[TR_MACRO_DUTY].release = -1;
	ins->macro[TR_MACRO_DUTY].val[0]  = 0;
	ins->macro[TR_MACRO_DUTY].val[1]  = 2;

	TrChanInit(0);
	c = &tr_ch[0];
	c->ins		= ins;
	c->inst		= 20;
	c->smp		= &tr_smp[tr_duty_slot[0]];
	c->note		= 49;
	c->vol		= 64;
	c->mix_vol	= 64;
	c->key_on	= TRUE;
	c->period	= TrNotePeriod(49, 0);
	c->sound_period = c->period;
	c->macro_wave	= -1;
	TrMacroApply(c);
	TrTOk(c->mix_vol == 32, "volume macro halved the level, got %d", c->mix_vol);
	TrTOk(c->smp_idx == tr_duty_slot[0], "duty macro selected bank entry 0");
	c->mix_vol = 64;
	TrMacroApply(c);
	TrTOk(c->mix_vol == 0, "second step silences");
	TrTOk(c->smp_idx == tr_duty_slot[2], "duty macro switched to entry 2");

	//Arpeggio macro, absolute: 12 is one octave up.
	MemSet(&ins->macro[TR_MACRO_VOL], 0, sizeof(CTrMacro));
	MemSet(&ins->macro[TR_MACRO_DUTY], 0, sizeof(CTrMacro));
	ins->macro[TR_MACRO_ARP].len	 = 1;
	ins->macro[TR_MACRO_ARP].loop	 = -1;
	ins->macro[TR_MACRO_ARP].release = -1;
	ins->macro[TR_MACRO_ARP].mode	 = TR_ARP_ABSOLUTE;
	ins->macro[TR_MACRO_ARP].val[0]	 = 12;
	c->macro_pos[TR_MACRO_ARP] = 0;
	c->sound_period = c->period;
	TrMacroApply(c);
	TrTOk(c->sound_period == TrNotePeriod(61, 0),
		  "arpeggio macro of 12 raised an octave: %d want %d",
		  c->sound_period, TrNotePeriod(61, 0));
	TrInstFree(20);
}

U0 TrTLoadPath()
{//Format detection is by content, and the two failure modes are reported
//apart. Also settles empirically what the file layer does with awkward names.
	I64	 kind, sz;
	U8	*buf;

	"\n$$LTBLUE$$file detection and names$$FG$$\n";
	TrSongNew(5, 2, 32);
	StrCopy(tr_song.title, "sniffme");
	tr_song.bpm = 133;
	TrSongSave("~/TRSNIFF.MOD");	//Deliberately the wrong extension.
	TrSongNew(4, 1, 64);
	kind = TrLoadFile("~/TRSNIFF.MOD");
	TrTOk(kind == 1, "a YTK3 song named .MOD still loads as YTK3, kind %d",
		  kind);
	TrTOk(tr_song.channels == 5 && tr_song.bpm == 133,
		  "and carries its own header, not the extension's");

	TrTOk(TrLoadFile("~/TRNOSUCH.DAT") == -1,
		  "a missing file reports unreadable rather than unrecognised");

	//Random bytes are readable but match no format.
	FileWrite("~/TRJUNK.DAT", "not a module at all, just some ASCII bytes", 41);
	kind = TrLoadFile("~/TRJUNK.DAT");
	TrTOk(kind == 0, "readable junk reports unrecognised, kind %d", kind);

	//Does the file layer accept a name with a space? The answer decides
	//whether module files have to be renamed before they can be opened.
	sz = 0;
	FileWrite("~/TRPLAIN.DAT", "hello", 5);
	buf = FileRead("~/TRPLAIN.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "plain name round trips, %d bytes", sz);
	if (buf)
		Free(buf);
	sz = 0;
	FileWrite("~/TR NAME.DAT", "hello", 5);
	buf = FileRead("~/TR NAME.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "name with a space round trips, %d bytes", sz);
	if (buf)
		Free(buf);
	sz = 0;
	FileWrite("~/TR&AMP.DAT", "hello", 5);
	buf = FileRead("~/TR&AMP.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "name with '&' round trips, %d bytes", sz);
	if (buf)
		Free(buf);
	sz = 0;
	FileWrite("~/!TRBANG.DAT", "hello", 5);
	buf = FileRead("~/!TRBANG.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "name starting with '!' round trips, %d bytes",
		  sz);
	if (buf)
		Free(buf);
	//Narrow down what a real module name trips over. Uppercase names with a
	//space, an ampersand or a leading bang all pass above.
	sz = 0;
	FileWrite("~/TRLOW.it", "hello", 5);
	buf = FileRead("~/TRLOW.it", &sz);
	TrTOk(buf != NULL && sz == 5, "lowercase EXTENSION, %d bytes", sz);
	if (buf)
		Free(buf);
	sz = 0;
	FileWrite("~/trlower.DAT", "hello", 5);
	buf = FileRead("~/trlower.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "lowercase STEM, %d bytes", sz);
	if (buf)
		Free(buf);
	sz = 0;
	FileWrite("~/TR A B C.DAT", "hello", 5);
	buf = FileRead("~/TR A B C.DAT", &sz);
	TrTOk(buf != NULL && sz == 5, "several spaces, %d bytes", sz);
	if (buf)
		Free(buf);
	//WRITING a name too long for 8.3 throws inside FAT32DirNew, so saving
	//must not hand one straight to FileWrite. Reading an existing long name
	//is fine, which is why modules load under any name.
	TrTOk(!TrSongSave("~/TRAVERYLONGMODULENAMEINDEED.DAT"),
		  "save refuses a name the file layer cannot create");
	TrTOk(TrSongSave("~/TRSHORT.DAT"), "and still accepts a short one");
}

U0 TrTSeek()
{//The song position bar maps the order list across the window width.
	"\n$$LTBLUE$$song position bar$$FG$$\n";
	TrSongNew(4, 4, 64);
	tr_song.order_len	= 8;
	tr_song.order[0]	= 0;
	tr_song.order[4]	= 2;
	tr_song.order[7]	= 3;
	tr.playing			= FALSE;
	tr_view_w			= 1024;

	//Bar spans x 12 .. 12 + (1024 - 24). Halfway is order 4 of 8.
	//TrSeekY pins the bar to the bottom of the window, so the hit test needs
	//the height a draw would have set.
	tr_view_w = 1024;
	tr_view_h = 768;
	TrClick(12 + (1024 - 24) / 2, TrSeekY() + 2);
	TrTOk(tr.order_sel == 4, "clicking mid-bar selects order %d, want 4",
		  tr.order_sel);
	TrTOk(tr.cur_pat == 2, "and follows the order to pattern %d, want 2",
		  tr.cur_pat);
	TrClick(12, TrSeekY() + 2);
	TrTOk(tr.order_sel == 0, "clicking the far left selects order 0");
	TrClick(12 + (1024 - 24) - 1, TrSeekY() + 2);
	TrTOk(tr.order_sel == 7, "clicking the far right selects the last order");
	//A click outside the band must not seek.
	tr.order_sel = 3;
	TrClick(400, TrSeekY() + TR_SEEK_H + 40);
	TrTOk(tr.order_sel == 3, "a click below the bar does not seek");
	//An empty order list must not divide by zero or seek anywhere.
	tr_song.order_len = 0;
	TrClick(400, TrSeekY() + 2);
	TrTOk(TRUE, "empty order list survives a click on the bar");
	tr_song.order_len = 1;
}

U0 TrTPickerDir()
{//The file picker reopens where it was last used, and that survives a restart.
	U8 buf[256];

	"\n$$LTBLUE$$file picker directory$$FG$$\n";
	MemSet(buf, 0, sizeof(buf));
	TrDirOf("::/Home/Music/song.mod", buf, sizeof(buf));
	TrTOk(!StrCompare(buf, "::/Home/Music"), "directory split gives %s", buf);
	TrDirOf("::/Apps/Tracker/Examples/Krii & Tricolore - Flesh.it", buf,
			sizeof(buf));
	TrTOk(!StrCompare(buf, "::/Apps/Tracker/Examples"),
		  "and copes with spaces and '&': %s", buf);
	StrCopy(buf, "unchanged");
	TrDirOf("bare.mod", buf, sizeof(buf));
	TrTOk(!StrCompare(buf, "unchanged"),
		  "a bare filename leaves the remembered directory alone");
	TrDirOf("/top.mod", buf, sizeof(buf));
	TrTOk(!StrCompare(buf, "/"), "a file at the root gives /, got %s", buf);

	//Songs and samples are remembered apart, and round trip through the
	//config file.
	StrCopy(tr.dir_song, "::/Apps/Tracker/Examples");
	StrCopy(tr.dir_smp,  "::/Home/Wav");
	TrConfigSave;
	StrCopy(tr.dir_song, "~");
	StrCopy(tr.dir_smp,  "~");
	TrConfigLoad;
	TrTOk(!StrCompare(tr.dir_song, "::/Apps/Tracker/Examples"),
		  "song directory reloaded as %s", tr.dir_song);
	TrTOk(!StrCompare(tr.dir_smp, "::/Home/Wav"),
		  "sample directory reloaded as %s", tr.dir_smp);
	TrTOk(StrCompare(tr.dir_song, tr.dir_smp) != 0,
		  "the two are kept apart");
}

U0 TrTEditors()
{//Macro and wavetable editors, and that what they produce survives a save.
	CTrMacro *m;
	CTrInst	 *ins;
	I64		  gx, gy, w, before;

	"\n$$LTBLUE$$macro and wavetable editors$$FG$$\n";
	TrSongNew(4, 1, 16);
	tr.inst			= 30;
	tr.pane			= TR_PANE_MACRO;
	tr.macro_sel	= TR_MACRO_VOL;
	tr.macro_step	= 0;

	//Touching a macro allocates the instrument record on demand.
	m = TrMacroCur();
	TrTOk(m != NULL && tr_inst[30] != NULL,
		  "editing allocates the instrument record");

	//Raising a value past the end extends the sequence.
	TrEdKey(0, SC_CURSOR_UP, 0);
	TrTOk(m->val[0] == 1 && m->len >= 1, "up raises step 0 to %d, len %d",
		  m->val[0], m->len);
	TrEdKey(0, SC_CURSOR_UP, SCF_SHIFT);
	TrTOk(m->val[0] == 9, "shift-up steps by 8, got %d", m->val[0]);
	TrEdKey(0, SC_CURSOR_DOWN, SCF_SHIFT);
	TrTOk(m->val[0] == 1, "shift-down comes back, got %d", m->val[0]);

	TrEdKey(0, SC_CURSOR_RIGHT, 0);
	TrTOk(tr.macro_step == 1, "right moves the step cursor");
	TrEdKey('l', 0, 0);
	TrTOk(m->loop == 1, "L sets the loop point at the cursor");
	TrEdKey('l', 0, 0);
	TrTOk(m->loop == -1, "and pressing it again clears it");
	TrEdKey('r', 0, 0);
	TrTOk(m->release == 1, "R sets the release point");

	//Volume clamps to the engine range, arpeggio is signed.
	tr.macro_step = 0;
	for (before = 0; before < 100; before++)
		TrEdKey(0, SC_CURSOR_UP, SCF_SHIFT);
	TrTOk(m->val[0] == 64, "volume clamps to 64, got %d", m->val[0]);
	tr.macro_sel = TR_MACRO_ARP;
	m = TrMacroCur();
	TrEdKey(0, SC_CURSOR_DOWN, 0);
	TrTOk(m->val[0] == -1, "arpeggio goes negative, got %d", m->val[0]);
	TrTOk(TrMacroCur() == &tr_inst[30]->macro[TR_MACRO_ARP],
		  "Tab-selected macro is the one edited");

	//Shortening drops markers that would dangle past the end.
	m->len		= 4;
	m->loop		= 3;
	m->release	= 3;
	TrEdKey(0, SC_DELETE, 0);
	TrTOk(m->len == 3 && m->loop == -1 && m->release == -1,
		  "shrinking clears markers past the end");

	//Drawing with the pointer. The graph starts at 60+TR_ED_GX, 120+TR_ED_GY.
	gx = 60 + TR_ED_GX;
	gy = 120 + TR_ED_GY;
	w  = (TR_ED_W - 2 * TR_ED_GX) / TR_MACRO_LEN;
	tr.macro_sel = TR_MACRO_VOL;
	TrEdClick(gx + 5 * w + 1, gy);				//Top of the graph.
	m = TrMacroCur();
	TrTOk(tr.macro_step == 5, "clicking selects step %d, want 5",
		  tr.macro_step);
	TrTOk(m->val[5] >= 60, "clicking the top draws a high value, got %d",
		  m->val[5]);
	TrEdClick(gx + 5 * w + 1, gy + TR_ED_GH - 1);
	TrTOk(m->val[5] <= 4, "clicking the bottom draws a low value, got %d",
		  m->val[5]);

	//Wavetable editor.
	tr.pane		= TR_PANE_WAVE;
	tr.wave_sel	= 3;
	tr.wave_step = 0;
	TrEdKey('f', 0, 0);						//Hex digit sets the value.
	TrTOk(tr_wave[3].step[0] == 15, "hex digit sets the step, got %d",
		  tr_wave[3].step[0]);
	TrTOk(tr.wave_step == 1, "and advances the cursor");
	TrTOk(tr_smp[tr_wave_slot[3]].data[0] > 10000,
		  "editing re-renders the wave into its sample slot");
	TrEdKey(0, SC_CURSOR_DOWN, 0);
	TrTOk(tr_wave[3].step[1] == 0, "down clamps at zero, got %d",
		  tr_wave[3].step[1]);

	//The editors must not leak keys into the pattern behind them.
	TrTOk(TrEdKey(0, SC_CURSOR_LEFT, 0), "an editor consumes cursor keys");
	tr.pane = TR_PANE_NONE;
	TrTOk(!TrEdKey(0, SC_CURSOR_LEFT, 0),
		  "and passes them through when closed");

	//Everything above must survive a save and reload.
	ins = tr_inst[30];
	ins->macro[TR_MACRO_VOL].len	= 5;
	ins->macro[TR_MACRO_VOL].loop	= 2;
	ins->macro[TR_MACRO_VOL].val[3]	= 41;
	ins->bank						= TR_BANK_WAVE;
	ins->fadeout					= 77;
	TrTOk(TrSongSave("~/TRMAC.DAT"), "saved a song carrying macros");
	TrSongNew(4, 1, 64);
	TrTOk(!tr_inst[30], "a fresh song has no instrument 30");
	TrTOk(TrLoadFile("~/TRMAC.DAT") == 1, "reloaded");
	ins = tr_inst[30];
	TrTOk(ins != NULL, "instrument 30 came back");
	if (ins)
	{
		TrTOk(ins->macro[TR_MACRO_VOL].len == 5 &&
			  ins->macro[TR_MACRO_VOL].loop == 2 &&
			  ins->macro[TR_MACRO_VOL].val[3] == 41,
			  "its volume macro survived intact");
		TrTOk(ins->bank == TR_BANK_WAVE && ins->fadeout == 77,
			  "and so did the bank and fadeout");
	}
	TrTOk(tr_wave[3].step[0] == 15, "the wavetable bank survived, step0 %d",
		  tr_wave[3].step[0]);
	TrTOk(tr_smp[tr_wave_slot[3]].data[0] > 10000,
		  "and was re-rendered into its sample slot on load");
}

U8 *trt_doc = NULL;
I64 trt_doc_sz = 0;

U0 TrTMenu()
{//The menu string is lexed when MenuPush runs, not when the file compiles, so
//a typo in it is invisible until the app opens. Build it here.
	CMenuEntry *e;

	"\n$$LTBLUE$$pull-down menu$$FG$$\n";
	TrMenuPush;
	TrTOk(Fs->cur_menu != NULL, "menu string parsed and pushed");
	e = MenuEntryFind(Fs->cur_menu, "File/SaveAs");
	TrTOk(e && e->message_code == MESSAGE_CMD && e->arg1 == TRM_SAVE,
		  "File/SaveAs sends MESSAGE_CMD %d", TRM_SAVE);
	TrTOk(MenuEntryFind(Fs->cur_menu, "Play/Song") != NULL, "Play/Song exists");
	TrTOk(MenuEntryFind(Fs->cur_menu, "Edit/InsertRow") != NULL,
		  "Edit/InsertRow exists");
	TrTOk(MenuEntryFind(Fs->cur_menu, "Help/Manual") != NULL,
		  "Help/Manual exists");
	TrTOk(MenuEntryFind(Fs->cur_menu, "Help/Keys") != NULL, "Help/Keys exists");
	//The manual is a separate file; a menu entry pointing at nothing is worse
	//than no entry.
	trt_doc = FileRead("::/Doc/Tracker.DD", &trt_doc_sz);
	TrTOk(trt_doc != NULL && trt_doc_sz > 4000,
		  "the manual is installed and readable, %d bytes", trt_doc_sz);
	if (trt_doc)
		Free(trt_doc);
	e = MenuEntryFind(Fs->cur_menu, "View/Interpolate");
	TrTOk(e != NULL, "View/Interpolate exists");
	tr.interp = TRUE;
	TrMenuSync;
	TrTOk(e && e->checked, "check mark follows tr.interp on");
	tr.interp = FALSE;
	TrMenuSync;
	TrTOk(e && !e->checked, "check mark follows tr.interp off");
	TrTOk(!Bt(&Fs->win_inhibit, WIf_FOCUS_TASK_MENU),
		  "menu is not inhibited for this task");
	//Every command must be reachable; run them all past the dispatcher. The
	//file ones open pickers, so they are excluded.
	TrMenuCmd(TRM_FOLLOW);
	TrMenuCmd(TRM_EDIT);
	TrMenuCmd(TRM_PANE_INST);
	TrMenuCmd(TRM_PAT_NEXT);
	TrMenuCmd(TRM_PAT_PREV);
	TrMenuCmd(TRM_MUTE);
	TrMenuCmd(TRM_MUTE);
	TrMenuCmd(TRM_STOP);
	TrTOk(tr.pane == TR_PANE_INST, "View/Instruments opened the pane");
	TrMenuCmd(TRM_PANE_INST);
	TrTOk(tr.pane == TR_PANE_NONE, "selecting it again closed the pane");
	MenuPop;
	TrTOk(TRUE, "menu popped without fault");
}

U0 TrTest()
{
	trt_pass = 0;
	trt_fail = 0;
	"$$LTBLUE$$TrTest: YTracker engine$$FG$$\n";
	TrTSetup;
	TrTPeriods;
	TrTSynth;
	TrTWav;
	TrTMod;
	TrTItComp;
	TrTEffects;
	TrTFile;
	TrTMixer;
	TrTMacro;
	TrTLoadPath;
	TrTSeek;
	TrTEditors;
	TrTPickerDir;
	TrTMenu;
	//Last: it replaces the loaded song, which TrTEffects onward inherit from
	//TrTMod.
	TrTFtm;
	TrSongFreeAll;
	"\nTrTest: %d pass, %d fail\n", trt_pass, trt_fail;
	"Run $$LTBLUE$$YTracker;$$FG$$ for the editor.\n";
}
