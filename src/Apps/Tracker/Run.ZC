// Run.ZC - build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier
// one, so this order is load-bearing
//
//   TrDef   data model, period tables      (no deps)
//   TrSmp   sample bank, waveforms, WAV    -> TrDef
//   TrMix   mixer, sequencer, effects      -> TrDef, TrSmp
//   TrMod   ProTracker .MOD reader         -> TrDef, TrSmp
//   TrXm    FastTracker 2 .XM reader       -> TrDef, TrSmp, TrMix
//   TrS3m   Scream Tracker 3 .S3M reader   -> TrDef, TrSmp, TrMix
//   TrIt    Impulse Tracker .IT reader     -> TrDef, TrSmp, TrMix
//   TrFtm   FamiTracker .FTM reader        -> TrDef, TrSmp, TrMix
//   TrFile  YTK3 / YTK2 disk formats       -> TrDef, TrSmp, TrMix, TrMod
//   TrUI    drawing and input              -> everything above
//   Tracker app shell                      -> everything above
//   TrTest  engine self checks             -> everything above

Cd(__DIR__);;

#include "TrDef"
#include "TrSmp"
#include "TrMix"
#include "TrMod"
#include "TrXm"
#include "TrS3m"
#include "TrIt"
#include "TrFtm"
#include "TrFile"
#include "TrUI"
#include "Tracker"
#include "TrTest"

YTracker;

"\nType $$LTBLUE$$TrTest;$$FG$$ to run the engine self-check.\n";
