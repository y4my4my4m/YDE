//TrDef.ZC - YTracker data model: samples, cells, patterns, channel state,
//period tables. No dependencies.

#define TR_RATE				48000
#define TR_MAX_CHANNELS		64		//IT allows 64.
#define TR_MAX_PATTERNS		256
#define TR_MAX_ROWS			256
#define TR_MAX_SAMPLES		512		//XM instruments hold up to 16 samples each.
#define TR_ORDER_MAX		256
#define TR_NOTES			120		//note 1 = C-0, note 120 = B-9. IT range.
#define TR_NOTE_OFF			121
#define TR_NOTE_CUT			122
#define TR_NOTE_FADE		123

//Name field widths. ZealC's sizeof rejects an indexed member expression
//(sizeof(tr_smp[i].name) is a parse error), so the lengths are constants.
#define TR_SMP_NAME			28		//IT sample names are 26 plus a terminator.
#define TR_TITLE_LEN		32

//Instruments are a layer above samples: XM and IT map each note to one of an
//instrument's samples and drive envelopes from the instrument. MOD and S3M
//have no such layer, so tr_inst[n] stays NULL there and instrument n plays
//sample n directly. See TrInstSample.
#define TR_MAX_INSTRUMENTS	256
#define TR_ENV_POINTS		25		//IT allows 25, XM 12.

//Voices beyond tr_song.channels hold notes cut loose by an IT new-note
//action. The sequencer only writes 0..channels-1; the mixer runs all of them.
#define TR_MAX_VOICES		192

//Periods carry 4 fractional bits. MOD file periods are integers, so they
//scale by 16 exactly and effect params scale the same way; the extra bits
//only buy resolution above the MOD range, where 1 raw unit is 30 cents.
#define TR_PERIOD_SCALE		16
#define TR_PERIOD_MIN		64
#define TR_PERIOD_MAX		219136

//Note 49 is C-4, the note XM tunes to 8363 Hz. Its Amiga period is 428, the
//ProTracker value: that anchor makes this note numbering agree with XM, S3M
//and IT, so an imported MOD shows the same octave here as in OpenMPT.
//ProTracker C-1 (period 856) is note 37 and displays as C-3.
#define TR_REF_NOTE			49
#define TR_REF_PERIOD		6848		//428 * TR_PERIOD_SCALE
//TR_REF_PERIOD * 2^((TR_REF_NOTE - 1) / 12), the period of note 1.
#define TR_PERIOD_BASE		109568

//PAL Amiga clock / 2. Playback rate = TR_PAL_HZ2 * TR_PERIOD_SCALE / period.
#define TR_PAL_HZ2			3546895
//TR_PAL_HZ2 * TR_PERIOD_SCALE, precomputed: shifting this left by 32 must not
//be reassociated by the parser. This is CTrSong.clock for MOD: C-4 = 8287 Hz.
#define TR_STEP_NUM			56750320
//8363 * 1712 * 4. XM's Amiga table and every S3M period are normalised so
//C-4 is exactly 8363 Hz rather than the real PAL rate.
#define TR_CLOCK_8363		57269824
//Rate of note 61 (C-5) at unit step_mul, identical in both pitch models.
//S3M and IT tune samples against this; see TrC5StepMul.
#define TR_C5_BASE_HZ		16726

//Sample position is 32.32 fixed point. 16.16 caps at 65536 frames; MOD
//samples reach 131070.
#define TR_POS_SHIFT		32

//Accumulator scale. Per channel the mixer accumulates sample * vol * pan *
//master / 256, so one channel at volume 64, centre pan and master 128 peaks
//at 8192 after the shift; four such channels reach full scale exactly.
//TrMasterDefault keeps that relation as the channel count changes.
#define TR_MIX_SHIFT		14

#define TR_BLOCK			1024	//Frames rendered per mixer call.
#define TR_SCOPE_N			1024
#define TR_MARKS			256		//Playhead history ring.

//Instrument macros: a per-tick step sequence with a loop and a release
//point, the FamiTracker and DefleMask model. Distinct from the XM/IT
//envelopes above, which interpolate between sparse points over ticks;
//a macro is one value per tick and drives pitch and waveform as well as
//volume. An instrument may carry both.
#define TR_MACRO_LEN		64
#define TR_MACRO_VOL		0	//0..64, scales channel volume
#define TR_MACRO_ARP		1	//semitone offset
#define TR_MACRO_PITCH		2	//period delta per tick, accumulates
#define TR_MACRO_DUTY		3	//index into the instrument's wave bank
#define TR_MACRO_COUNT		4

//Arpeggio macro interpretation.
#define TR_ARP_ABSOLUTE		0	//offset from the played note
#define TR_ARP_FIXED		1	//absolute note, ignores the played one
#define TR_ARP_RELATIVE		2	//accumulates

//Which bank TR_MACRO_DUTY indexes.
#define TR_BANK_NONE		0	//PCM: the duty macro does nothing
#define TR_BANK_DUTY		1	//the four NES pulse widths
#define TR_BANK_WAVE		2	//user wavetables

//NES pulse widths, in the order the 2A03 numbers them.
#define TR_DUTY_COUNT		4
//Game Boy and PC Engine shape: 32 steps, 4-bit. Rendered into a
//TR_WAVE_LEN sample by holding each step, so the pitch model is unchanged.
#define TR_WAVE_SLOTS		16
#define TR_WAVE_STEPS		32
#define TR_WAVE_MAX			15

//Loop modes.
#define TR_LOOP_NONE		0
#define TR_LOOP_FWD			1
#define TR_LOOP_PINGPONG	2

//Envelope flags.
#define TR_ENV_ON			1
#define TR_ENV_SUSTAIN		2
#define TR_ENV_LOOP			4
#define TR_ENV_FILTER		8	//IT pitch envelope repurposed as filter cutoff.

//New note actions and duplicate check, IT.
#define TR_NNA_CUT			0
#define TR_NNA_CONTINUE		1
#define TR_NNA_OFF			2
#define TR_NNA_FADE			3
#define TR_DCT_OFF			0
#define TR_DCT_NOTE			1
#define TR_DCT_SAMPLE		2
#define TR_DCT_INST			3
#define TR_DCA_CUT			0
#define TR_DCA_OFF			1
#define TR_DCA_FADE			2

//Volume column commands. MOD and S3M only ever emit TRV_SET.
#define TRV_NONE			0
#define TRV_SET				1	//param 0..64
#define TRV_SLIDE_UP		2
#define TRV_SLIDE_DOWN		3
#define TRV_FINE_UP			4
#define TRV_FINE_DOWN		5
#define TRV_VIB_SPEED		6
#define TRV_VIB_DEPTH		7
#define TRV_SET_PAN			8	//param 0..64, widened to 0..255 at use
#define TRV_PAN_LEFT		9
#define TRV_PAN_RIGHT		10
#define TRV_TONE_PORTA		11
#define TRV_PITCH_UP		12	//IT
#define TRV_PITCH_DOWN		13	//IT

//Synthetic waveforms. Slot values match YTracker 1's instrument numbering so
//YTK2 songs import without a note change.
#define TRI_NONE			0
#define TRI_SINE			1
#define TRI_PULSE1			2
#define TRI_PULSE2			3
#define TRI_TRIANGLE		4
#define TRI_NOISE			5
#define TRI_SAW				6
#define TRI_COUNT			7

//Effects. Values are the MOD nibble; extended E-commands are stored as
//0xE0 | subcommand so one switch covers both.
#define TRX_ARPEGGIO		0x0
#define TRX_PORTA_UP		0x1
#define TRX_PORTA_DOWN		0x2
#define TRX_TONE_PORTA		0x3
#define TRX_VIBRATO			0x4
#define TRX_PORTA_VOLSLIDE	0x5
#define TRX_VIB_VOLSLIDE	0x6
#define TRX_TREMOLO			0x7
#define TRX_SET_PAN			0x8
#define TRX_OFFSET			0x9
#define TRX_VOLSLIDE		0xA
#define TRX_POS_JUMP		0xB
#define TRX_SET_VOL			0xC
#define TRX_PAT_BREAK		0xD
#define TRX_EXTENDED		0xE
#define TRX_SET_SPEED		0xF
//Beyond the MOD nibble. Loaders translate XM letters and S3M/IT letters into
//this one space, so the tick code has a single switch.
#define TRX_GLOBAL_VOL		0x10	//XM Gxx, S3M/IT Vxx
#define TRX_GLOBAL_VOLSLIDE	0x11	//XM Hxy, S3M/IT Wxy
#define TRX_KEY_OFF			0x12	//XM Kxx
#define TRX_ENV_POS			0x13	//XM Lxx
#define TRX_PAN_SLIDE		0x14	//Pxy
#define TRX_MULTI_RETRIG	0x15	//XM Rxy, S3M/IT Qxy
#define TRX_TREMOR			0x16	//XM Txy, S3M/IT Ixy
#define TRX_XFINE_PORTA_UP	0x17	//XM X1x
#define TRX_XFINE_PORTA_DN	0x18	//XM X2x
#define TRX_PANBRELLO		0x19	//Yxy
#define TRX_SET_TEMPO		0x1A	//S3M/IT Txx, distinct from XM's Txy tremor
#define TRX_FINE_VIBRATO	0x1B	//S3M/IT Uxy
#define TRX_CHANNEL_VOL		0x1C	//IT Mxx
#define TRX_CHANNEL_VOLSLIDE 0x1D	//IT Nxy
#define TRX_COUNT			0x1E

class CTrSample
{
	U8	 name[TR_SMP_NAME];
	I16	*data;			//Owned. Mono signed 16-bit, len+1 frames allocated.
	I64	 len;			//Frames, excluding the interpolation guard frame.
	I64	 loop_start;
	I64	 loop_len;		//0 = no loop.
	I64	 loop_type;
	I64	 sus_start;		//IT sustain loop, used while the key is down.
	I64	 sus_len;
	I64	 sus_type;
	I64	 volume;		//0..64
	I64	 global_vol;	//IT per-sample gain, 0..64. 64 = unity.
	I64	 finetune;		//-128..127, units of 1/128 semitone.
	I64	 rel_note;		//Semitone offset applied at note-on.
	I64	 pan;			//0..255, 128 centre. -1 = no sample pan.
	I64	 c5speed;		//S3M/IT middle-C rate. 0 = tuned by finetune instead.
	I64	 synth;			//TRI_* if generated, TRI_NONE if PCM.
	I64	 step_mul;		//16.16 pitch correction; see TrSynthBuild.
};

class CTrEnvelope
{
	I64	 flags;			//TR_ENV_*
	I64	 n_points;
	I64	 tick[TR_ENV_POINTS];
	I64	 value[TR_ENV_POINTS];
	I64	 sus_start, sus_end;
	I64	 loop_start, loop_end;
};

class CTrMacro
{
	I64 len;			//0 = unused.
	I64 loop;			//Step to jump back to, -1 for none.
	I64 release;		//Step the key-off jumps to, -1 for none.
	I64 mode;			//TR_ARP_* for the arpeggio macro, else unused.
	I8	val[TR_MACRO_LEN];
};

class CTrWave
{//One user wavetable. Steps are 0..TR_WAVE_MAX.
	U8	 step[TR_WAVE_STEPS];
	Bool used;
};

class CTrInst
{//Heap allocated and only for formats that have an instrument layer.
	U8	 name[TR_SMP_NAME];
	I64	 n_samples;
	U16	 smp_of_note[TR_NOTES + 2];	//Sample slot per note, 0 = none.
	U8	 xpose_of_note[TR_NOTES + 2];//IT remaps the note as well as the sample.
	CTrEnvelope vol_env, pan_env, pitch_env;
	I64	 fadeout;		//Subtracted from 32768 per tick after key off.
	I64	 nna, dct, dca;
	I64	 global_vol;	//0..128, 128 = unity.
	I64	 default_pan;	//0..255, or -1 to keep the sample's.
	I64	 vib_type, vib_sweep, vib_depth, vib_rate;	//Auto-vibrato.
	CTrMacro macro[TR_MACRO_COUNT];
	I64	 bank;			//TR_BANK_*, what TR_MACRO_DUTY selects.
	I64	 wave_slot;		//Starting entry in that bank.
};

class CTrCell
{
	U8 note;		//0 empty, 1..120 note, then TR_NOTE_OFF / CUT / FADE.
	U8 inst;		//0 none, else instrument slot.
	U8 volcmd;		//TRV_*
	U8 volparam;
	U8 eff;			//TRX_*
	U8 param;
};

class CTrSong
{
	U8	title[TR_TITLE_LEN];
	I64	channels;
	I64	n_patterns;
	I64	n_instruments;
	I64	order_len;
	I64	restart;
	I64	speed;		//Ticks per row.
	I64	bpm;
	I64	global_vol;	//0..128
	I64	mix_vol;	//IT master mix volume, 0..128
	Bool linear;	//Linear frequency slides (XM flag bit 0, IT flag bit 3).
	//S3M and IT fold fine volume slides into the Dxy parameter as DFx and
	//DxF, applied once on tick 0. MOD and XM have no such form there and
	//spell fine slides EAx/EBx, so the decode has to be format-gated.
	Bool fine_slides;
	//Numerator of rate = clock / period in Amiga mode. MOD uses the real PAL
	//clock (C-4 = 8287 Hz); XM's Amiga table is normalised so C-4 is 8363 Hz,
	//0.9% sharp of a real Amiga. Same formula, different constant.
	I64	clock;
	U8	order[TR_ORDER_MAX];
};

class CTrChan
{
	CTrSample *smp;
	CTrInst	  *ins;			//NULL for MOD and S3M: no instrument layer.
	I64	 inst;			//Instrument slot, 1-based. 0 = none selected.
	I64	 smp_idx;		//Sample slot the instrument resolved to.
	I64	 pos_fp;		//32.32 into smp->data.
	I64	 step_fp;		//32.32 source frames per output frame.
	I64	 period;		//Amiga: scaled by TR_PERIOD_SCALE. Linear: XM units * 4.
	I64	 dest_period;	//Tone portamento target.
	I64	 note;
	I64	 vol;			//0..64
	I64	 pan;			//0..255
	I64	 finetune;		//-128..127
	Bool active, backwards, mute;

	//Instrument layer state.
	Bool key_on;			//FALSE once note off arrives; drives release + fade.
	Bool background;		//An NNA voice: the sequencer no longer writes here.
	Bool sustained;			//Playing the sustain loop rather than the main one.
	I64	 fade_vol;			//32768 down to 0 after key off.
	I64	 chan_vol;			//IT channel volume, 0..64.
	I64	 vol_env_pos, pan_env_pos, pitch_env_pos;
	I64	 avib_pos, avib_sweep;	//Instrument auto-vibrato.
	I64	 owner;				//Physical channel an NNA voice came from, else -1.
	I64	 macro_pos[TR_MACRO_COUNT];
	I64	 macro_pitch;		//Running total from the pitch macro.
	I64	 macro_wave;		//Bank entry the duty macro last selected, -1 none.

	I64	 eff, param;
	I64	 porta_speed;
	I64	 vib_pos, vib_speed, vib_depth, vib_wave;
	I64	 trem_pos, trem_speed, trem_depth, trem_wave;
	I64	 pan_pos, pan_speed, pan_depth, pan_wave;	//Panbrello.
	I64	 offset_mem, fine_up_mem, fine_dn_mem, finevol_mem;
	I64	 retrig_mem, tremor_mem, tremor_pos;
	I64	 porta_mem, volslide_mem, panslide_mem, gvolslide_mem, cvolslide_mem;
	I64	 sound_period;		//Period after arpeggio and vibrato.
	I64	 mix_vol;			//Volume after every envelope and modulator, 0..64.
	I64	 mix_pan;			//Pan after the panning envelope and panbrello.
	I64	 delay_ticks;		//EDx countdown, -1 idle.
	I64	 delay_note, delay_inst;
	I64	 cut_tick;			//ECx, -1 idle.
	I64	 loop_row, loop_count;
	Bool glissando;
	I64	 peak;				//VU, decayed by the UI.
};

class CTrMark
{//Sequencer position stamped with the output-frame count it starts at.
	I64 frame, order, pat, row;
};

class CTrPlayer
{
	I64	 tick;
	I64	 row;
	I64	 order_pos;
	I64	 pattern;
	I64	 tick_frames;	//Frames per tick at the current bpm.
	I64	 frames_left;	//Frames remaining in the current tick.
	I64	 pat_delay;		//EEx rows still to repeat.
	I64	 break_row;		//-1 idle.
	I64	 jump_order;	//-1 idle.
	I64	 loop_jump;		//E6x target row, -1 idle.
	I64	 frames_out;	//Total frames handed to the mixer this run.
	Bool ended;
};

//Editor cursor columns within one channel.
#define TR_COL_NOTE		0
#define TR_COL_INST1	1
#define TR_COL_INST2	2
#define TR_COL_VOL1		3
#define TR_COL_VOL2		4
#define TR_COL_EFF		5
#define TR_COL_PARAM1	6
#define TR_COL_PARAM2	7
#define TR_COLS			8

#define TR_PANE_NONE	0
#define TR_PANE_HELP	1
#define TR_PANE_INST	2
#define TR_PANE_ORDER	3

class CTrGlobals
{
	I64	 stream;			//Mixer stream we own.
	I64	 master;			//0..256 output gain.
	Bool interp;			//Linear interpolation between source frames.
	Bool playing, quit, follow, edit, pat_mode;
	//Handshake that keeps the mixer task out of song data while the editor
	//frees or replaces it. See TrMixSuspend.
	Bool busy, mix_idle;
	I64	 pane;				//TR_PANE_*
	I64	 pane_sel;			//Selection inside the open pane.

	I64	 cur_ch, cur_col, cur_row, cur_pat;
	I64	 view_top, view_ch;	//First visible row / channel.
	I64	 octave, inst, vol_default, step_add;
	I64	 order_sel;

	CTask *play_task, *win_task;
	U8	 file[256];
	U8	 status[128];

	I16	 scope[TR_SCOPE_N];
	I64	 scope_pos;
} tr;

CTrSong		tr_song;
CTrSample	tr_smp[TR_MAX_SAMPLES];
CTrInst	   *tr_inst[TR_MAX_INSTRUMENTS];	//NULL = instrument n is sample n.
CTrCell	   *tr_pat[TR_MAX_PATTERNS];
I64			tr_pat_rows[TR_MAX_PATTERNS];
CTrChan		tr_ch[TR_MAX_VOICES];
CTrPlayer	tr_play;
CTrMark		tr_marks[TR_MARKS];
I64			tr_mark_pos = 0;

//Per-channel default pan, set by the loader through TrChanPanDefault.
I64			tr_chan_pan[TR_MAX_VOICES];

//Sample slots holding the generated single-cycle banks. Filled by
//TrSynthBuild; 0 means the entry was never built.
I64			tr_duty_slot[TR_DUTY_COUNT];
I64			tr_wave_slot[TR_WAVE_SLOTS];
CTrWave		tr_wave[TR_WAVE_SLOTS];

//[note][finetune index]. Filled by TrTablesInit; never read before it runs.
I64			tr_period_tab[TR_NOTES + 1][16];
I64			tr_mix_l[TR_BLOCK];
I64			tr_mix_r[TR_BLOCK];

//ProTracker vibrato/tremolo sine, half a period in 32 steps.
I64 tr_sine_tab[32] = {
	  0, 24, 49, 74, 97,120,141,161,180,197,212,224,235,244,250,253,
	255,253,250,244,235,224,212,197,180,161,141,120, 97, 74, 49, 24};

U8 *tr_note_names = "C-C#D-D#E-F-F#G-G#A-A#B-";
U8 *tr_synth_names[TRI_COUNT] = {
	"---", "Sine", "Pulse50", "Pulse25", "Triangle", "Noise", "Saw"};

U0 TrTablesInit()
{//period(n, ft) = TR_PERIOD_BASE * 2^(-(n - 1 + ft/8) / 12), scaled.
//Anchored so note 49 is period 428 raw; ProTracker's C-1..B-3 then occupies
//notes 37..72 and every file period lands on a table entry exactly.
	I64 n, f;
	F64 semis;

	MemSet(tr_period_tab, 0, sizeof(tr_period_tab));
	for (n = 1; n <= TR_NOTES; n++)
		for (f = 0; f < 16; f++)
		{
			semis = ToF64(n - 1) + ToF64(f - 8) / 8.0;
			tr_period_tab[n][f] = ToI64(TR_PERIOD_BASE *
										Pow(2.0, -semis / 12.0) + 0.5);
		}
}

I64 TrFineIndex(I64 finetune)
{//Finetune is carried at XM resolution (-128..127) but the Amiga table is
//built at MOD resolution. Amiga-mode XM files are rare and the quantisation
//is 1/16 semitone, so the table index is simply the rounded MOD value.
	return ClampI64((finetune + 128) / 16, 0, 15);
}

I64 TrNotePeriod(I64 note, I64 finetune)
{//Amiga period, scaled by TR_PERIOD_SCALE.
	note = ClampI64(note, 1, TR_NOTES);

	return tr_period_tab[note][TrFineIndex(finetune)];
}

I64 TrLinearPeriod(I64 note, I64 finetune)
{//XM linear period, held at 4x the file's units so that a portamento step of
//param * TR_PERIOD_SCALE moves the same musical distance as in Amiga mode.
	note = ClampI64(note, 1, TR_NOTES);

	return (7680 - (note - 1) * 64 - finetune / 2) * 4;
}

I64 TrPitchPeriod(I64 note, I64 finetune)
{//Whichever model the song is in.
	if (tr_song.linear)
		return TrLinearPeriod(note, finetune);

	return TrNotePeriod(note, finetune);
}

I64 TrPeriodNote(I64 period, I64 finetune)
{//Nearest note. MOD stores periods; the editor and glissando want notes.
	I64 n, best = 1, bestd = 0x7FFFFFFFFFFF, d;

	if (tr_song.linear)
	{
		n = (7680 - period / 4 - finetune / 2 + 32) / 64 + 1;
		return ClampI64(n, 1, TR_NOTES);
	}
	for (n = 1; n <= TR_NOTES; n++)
	{
		d = AbsI64(tr_period_tab[n][TrFineIndex(finetune)] - period);
		if (d < bestd)
		{
			bestd = d;
			best  = n;
		}
	}

	return best;
}

I64 TrStepFP(I64 period, I64 step_mul)
{//32.32 source frames advanced per output frame.
	I64 s;
	F64 hz;

	if (tr_song.linear)
	{//hz = 8363 * 2^((4608 - xm_period) / 768), and period is 4x xm_period.
		period = ClampI64(period, -16384, 30720);
		hz = 8363.0 * Pow(2.0, (4608.0 - ToF64(period) / 4.0) / 768.0);
		s  = ToI64(hz * 4294967296.0 / TR_RATE);
	}
	else
	{
		period = ClampI64(period, TR_PERIOD_MIN, TR_PERIOD_MAX);
		if (tr_song.clock < 1)
			tr_song.clock = TR_STEP_NUM;
		//Shift binds tighter than '*' and '/' here; parenthesize every term.
		s = (tr_song.clock << 32) / (period * TR_RATE);
	}
	if (step_mul != 65536)
		s = ((s >> 8) * step_mul) >> 8;
	if (s < 1)
		s = 1;

	return s;
}

CTrCell *TrCell(I64 pat, I64 ch, I64 row)
{//Row-major, matching every module format on disk.
	if (pat < 0 || pat >= TR_MAX_PATTERNS || !tr_pat[pat])
		return NULL;
	if (ch < 0 || ch >= tr_song.channels)
		return NULL;
	if (row < 0 || row >= tr_pat_rows[pat])
		return NULL;

	return &tr_pat[pat][row * tr_song.channels + ch];
}

U0 TrPatternFree(I64 pat)
{
	if (0 <= pat < TR_MAX_PATTERNS && tr_pat[pat])
	{
		Free(tr_pat[pat]);
		tr_pat[pat]		= NULL;
		tr_pat_rows[pat]	= 0;
	}
}

Bool TrPatternAlloc(I64 pat, I64 rows)
{//Allocates zeroed cells. Existing contents are discarded.
	I64 n;

	if (pat < 0 || pat >= TR_MAX_PATTERNS)
		return FALSE;
	rows = ClampI64(rows, 1, TR_MAX_ROWS);
	TrPatternFree(pat);
	n = rows * tr_song.channels * sizeof(CTrCell);
	tr_pat[pat] = CAlloc(n);
	if (!tr_pat[pat])
		return FALSE;
	tr_pat_rows[pat] = rows;

	return TRUE;
}

U0 TrSampleFree(I64 i)
{
	if (0 <= i < TR_MAX_SAMPLES)
	{
		if (tr_smp[i].data)
			Free(tr_smp[i].data);
		MemSet(&tr_smp[i], 0, sizeof(CTrSample));
		tr_smp[i].volume		= 64;
		tr_smp[i].global_vol	= 64;
		tr_smp[i].pan			= 128;
		tr_smp[i].step_mul		= 65536;
	}
}

U0 TrInstFree(I64 i)
{
	if (0 <= i < TR_MAX_INSTRUMENTS && tr_inst[i])
	{
		Free(tr_inst[i]);
		tr_inst[i] = NULL;
	}
}

CTrInst *TrInstAlloc(I64 i)
{//An instrument record only exists for formats that have the layer.
	CTrInst *p;
	I64		 n;

	if (i < 1 || i >= TR_MAX_INSTRUMENTS)
		return NULL;
	TrInstFree(i);
	p = CAlloc(sizeof(CTrInst));
	if (!p)
		return NULL;
	p->global_vol	= 128;
	p->default_pan	= -1;
	p->fadeout		= 0;
	p->nna			= TR_NNA_CUT;
	for (n = 0; n <= TR_NOTES + 1; n++)
	{
		p->smp_of_note[n]	= 0;
		p->xpose_of_note[n]	= n;
	}
	tr_inst[i] = p;

	return p;
}

I64 TrInstSample(I64 inst, I64 note, I64 *_note)
{//Resolve an instrument plus note to a sample slot. Without an instrument
//record the mapping is the identity, which is what MOD and S3M want.
	CTrInst *p;

	*_note = note;
	if (inst < 1 || inst >= TR_MAX_INSTRUMENTS)
		return 0;
	p = tr_inst[inst];
	if (!p)
	{
		if (inst < TR_MAX_SAMPLES)
			return inst;
		return 0;
	}
	if (note < 1 || note > TR_NOTES)
		return 0;
	*_note = ClampI64(p->xpose_of_note[note], 1, TR_NOTES);

	return p->smp_of_note[note];
}

U0 TrSampleGuard(CTrSample *s)
{//Interpolation reads data[idx + 1]; fill the guard frame so it never has to
//branch on the last frame.
	if (!s->data || s->len < 1)
		return;
	if (s->loop_len > 1 && s->loop_type != TR_LOOP_NONE)
		s->data[s->len] = s->data[s->loop_start];
	else
		s->data[s->len] = 0;
}

U0 TrSongFreeAll()
{
	I64 i;

	for (i = 0; i < TR_MAX_PATTERNS; i++)
		TrPatternFree(i);
	for (i = 0; i < TR_MAX_SAMPLES; i++)
		TrSampleFree(i);
	for (i = 0; i < TR_MAX_INSTRUMENTS; i++)
		TrInstFree(i);
}

U0 TrDataInit()
{//Every file-scope array here is written before first read. ZealC leaves
//globals holding heap garbage otherwise.
	I64 i;

	MemSet(tr_pat, 0, sizeof(tr_pat));
	MemSet(tr_pat_rows, 0, sizeof(tr_pat_rows));
	MemSet(tr_inst, 0, sizeof(tr_inst));
	MemSet(tr_wave, 0, sizeof(tr_wave));
	MemSet(tr_duty_slot, 0, sizeof(tr_duty_slot));
	MemSet(tr_wave_slot, 0, sizeof(tr_wave_slot));
	//File-scope array: garbage until something fills it. TrChanInit reads it.
	for (i = 0; i < TR_MAX_VOICES; i++)
		tr_chan_pan[i] = 128;
	MemSet(tr_ch, 0, sizeof(tr_ch));
	MemSet(&tr_play, 0, sizeof(CTrPlayer));
	MemSet(tr_marks, 0, sizeof(tr_marks));
	MemSet(tr_mix_l, 0, sizeof(tr_mix_l));
	MemSet(tr_mix_r, 0, sizeof(tr_mix_r));
	MemSet(&tr_song, 0, sizeof(CTrSong));
	//A zeroed song cannot make sound: clock 0 collapses every step to nothing.
	//Give the model defaults here, not only in the loaders.
	tr_song.channels	= 4;
	tr_song.speed		= 6;
	tr_song.bpm			= 125;
	tr_song.global_vol	= 128;
	tr_song.mix_vol		= 128;
	tr_song.clock		= TR_STEP_NUM;
	for (i = 0; i < TR_MAX_SAMPLES; i++)
	{
		MemSet(&tr_smp[i], 0, sizeof(CTrSample));
		tr_smp[i].volume		= 64;
		tr_smp[i].global_vol	= 64;
		tr_smp[i].pan			= 128;
		tr_smp[i].step_mul		= 65536;
	}
	tr_mark_pos = 0;
	TrTablesInit;
}
