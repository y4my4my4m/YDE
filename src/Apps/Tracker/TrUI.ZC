//TrUI.ZC - editor drawing and input. Depends on TrDef, TrSmp, TrMix, TrMod,
//TrFile.

#define TR_CELL_W	108		//13 glyphs plus a gap.
#define TR_CELL_H	12
#define TR_GRID_X	40
//The grid starts where the scope and the channel headers end. The seek bar
//used to sit between them; it now pins to the bottom of the window, so the
//grid reclaims that space.
#define TR_GRID_Y	138
#define TR_SCOPE_Y	46
#define TR_SCOPE_H	64
#define TR_SEEK_H	10
#define TR_SEEK_PAD	4		//Gap between the seek bar and the window edge.
//Header button that swaps the pattern grid for the piano roll. Sits just left
//of the right-aligned status flags, clear of the song title.
#define TR_VIEWBTN_W	56

//Glyph offset and width of each cursor sub-column inside a cell.
I64 tr_col_x[TR_COLS] = {0, 4, 5, 7, 8, 10, 11, 12};
I64 tr_col_w[TR_COLS] = {3, 1, 1, 1, 1, 1, 1, 1};

I64 tr_view_rows = 32;
I64 tr_view_chs	 = 4;
//Window width the last draw used. Click handling runs on the app task and has
//no CTask to ask, and tr.win_task is not guaranteed set.
I64 tr_view_w	 = 1024;
I64 tr_view_h	 = 768;

I64 TrSeekY()
{//Pinned to the bottom of the window rather than to a fixed offset.
	return tr_view_h - TR_SEEK_H - TR_SEEK_PAD;
}

I64 TrViewBtnX()
{//The status flags start at w - 260; this sits to their left. A fixed offset
//would land on the song title, which runs from x 96.
	return tr_view_w - 260 - 72;
}

//One glyph per volume-column command, indexed by TRV_*.
U8 *tr_volcmd_letters = ".vdufeSPpLRGHh";

//Pull-down menu commands. Every entry sends MESSAGE_CMD rather than a
//synthesised keystroke: the letter keys here are a piano keyboard, so a menu
//item bound to a character would enter a note.
#define TRM_NEW			1
#define TRM_LOAD		2
#define TRM_SAVE		3
#define TRM_LOADSMP		4
#define TRM_EXIT		5
#define TRM_PLAY_SONG	6
#define TRM_PLAY_PAT	7
#define TRM_STOP		8
#define TRM_FOLLOW		9
#define TRM_EDIT		10
#define TRM_INS_ROW		11
#define TRM_DEL_ROW		12
#define TRM_CLR_CELL	13
#define TRM_PANE_INST	14
#define TRM_PANE_ORDER	15
#define TRM_PANE_HELP	16
#define TRM_INTERP		17
#define TRM_PAT_PREV	18
#define TRM_PAT_NEXT	19
#define TRM_MUTE		20
#define TRM_HELPDOC	21
#define TRM_KEYS		22
#define TRM_PANE_MACRO	23
#define TRM_PANE_WAVE	24
#define TRM_VIEW_ROLL	25

U8 TrHexDigit(I64 v)
{
	v &= 0x0F;
	if (v < 10)
		return '0' + v;

	return 'A' + v - 10;
}

U0 TrStatus(U8 *fmt, ...)
{//The compositor reads tr.status from another task, so stage the whole field
//and copy it in one pass: a partial StrCopy can leave it unterminated.
	U8	 tmp[128];
	U8	*s = StrPrintJoin(NULL, fmt, argc, argv);

	MemSet(tmp, 0, sizeof(tmp));
	if (StrLen(s) >= sizeof(tmp))
		s[sizeof(tmp) - 1] = 0;
	StrCopy(tmp, s);
	MemCopy(tr.status, tmp, sizeof(tmp));
	Free(s);
}

Bool TrEnsurePattern(I64 p)
{
	if (p < 0 || p >= TR_MAX_PATTERNS)
		return FALSE;
	if (tr_pat[p])
		return TRUE;
	if (!TrPatternAlloc(p, 64))
		return FALSE;
	if (p >= tr_song.n_patterns)
		tr_song.n_patterns = p + 1;

	return TRUE;
}

I64 TrCurRows()
{
	I64 r = tr_pat_rows[ClampI64(tr.cur_pat, 0, TR_MAX_PATTERNS - 1)];

	if (r < 1)
		return 64;

	return r;
}

U0 TrCellText(CTrCell *c, U8 *buf)
{//Fixed 13-glyph layout: "C-4 01 40 A08". Empty fields read as dots.
	I64 i;

	for (i = 0; i < 13; i++)
		buf[i] = '.';
	buf[3]	= ' ';
	buf[6]	= ' ';
	buf[9]	= ' ';
	buf[13]	= 0;
	if (!c)
		return;
	if (c->note == TR_NOTE_OFF)
	{
		buf[0] = '^';
		buf[1] = '^';
		buf[2] = '-';
	}
	else if (c->note)
	{
		buf[0] = tr_note_names[(c->note - 1) % 12 * 2];
		buf[1] = tr_note_names[(c->note - 1) % 12 * 2 + 1];
		buf[2] = '0' + (c->note - 1) / 12;
	}
	if (c->inst)
	{
		buf[4] = TrHexDigit(c->inst >> 4);
		buf[5] = TrHexDigit(c->inst);
	}
	if (c->volcmd == TRV_SET)
	{
		buf[7] = TrHexDigit(c->volparam >> 4);
		buf[8] = TrHexDigit(c->volparam);
	}
	else if (c->volcmd)
	{//Slides and the other column commands show as a letter plus one digit.
		buf[7] = tr_volcmd_letters[ClampI64(c->volcmd, 0, TRV_PITCH_DOWN)];
		buf[8] = TrHexDigit(c->volparam);
	}
	if (c->eff || c->param)
	{
		buf[10] = TrHexDigit(c->eff);
		buf[11] = TrHexDigit(c->param >> 4);
		buf[12] = TrHexDigit(c->param);
	}
}

U0 TrDrawScope(CDC *dc, I64 w)
{
	I64 i, v, prev, mid = TR_SCOPE_Y + TR_SCOPE_H / 2, n = w - 28;

	dc->color = de_theme.panel;
	GrRect(dc, 12, TR_SCOPE_Y, w - 24, TR_SCOPE_H);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, TR_SCOPE_Y, w - 24, 1);
	GrRect(dc, 12, TR_SCOPE_Y + TR_SCOPE_H - 1, w - 24, 1);
	if (n < 2)
		return;
	dc->color = de_theme.accent;
	prev = mid;
	for (i = 0; i < n; i++)
	{
		v = tr.scope[(tr.scope_pos + i * TR_SCOPE_N / n) & (TR_SCOPE_N - 1)];
		v = mid - v * (TR_SCOPE_H / 2 - 2) / 32768;
		v = ClampI64(v, TR_SCOPE_Y + 1, TR_SCOPE_Y + TR_SCOPE_H - 2);
		GrLine(dc, 14 + i - 1, prev, 14 + i, v);
		prev = v;
	}
}

U0 TrDrawSeek(CDC *dc, I64 w, I64 play_ord, I64 play_row, I64 play_pat)
{//Song position across the order list. Each order gets an equal slice, and
//the row inside the playing order fills its slice, so the bar advances
//smoothly rather than jumping once per pattern.
	I64	 i, x0, x1, n = tr_song.order_len, rows, frac, cur, bw = w - 24;
	U8	 buf[64];

	dc->color = de_theme.panel;
	GrRect(dc, 12, TrSeekY(), bw, TR_SEEK_H);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, TrSeekY(), bw, 1);
	GrRect(dc, 12, TrSeekY() + TR_SEEK_H - 1, bw, 1);
	if (n < 1)
		return;

	//Order boundaries, so the bar doubles as a map of the song.
	if (n <= bw / 3)
		for (i = 1; i < n; i++)
		{
			x0 = 12 + i * bw / n;
			dc->color = de_theme.panel_edge;
			GrRect(dc, x0, TrSeekY() + 2, 1, TR_SEEK_H - 4);
		}

	cur = play_ord;
	if (cur < 0)
		cur = tr.order_sel;			//Stopped: show where play would start.
	cur = ClampI64(cur, 0, n - 1);
	x0 = 12 + cur * bw / n;
	x1 = 12 + (cur + 1) * bw / n;
	if (play_ord >= 0 && play_row >= 0)
	{//Fill the slice in proportion to the row inside the playing pattern.
		rows = tr_pat_rows[ClampI64(play_pat, 0, TR_MAX_PATTERNS - 1)];
		if (rows < 1)
			rows = 64;
		frac = (x1 - x0) * ClampI64(play_row, 0, rows - 1) / rows;
	}
	else
		frac = 0;

	dc->color = de_theme.bttn_focus;
	GrRect(dc, 12, TrSeekY() + 1, x0 - 12, TR_SEEK_H - 2);
	dc->color = de_theme.accent;
	GrRect(dc, x0, TrSeekY() + 1, MaxI64(2, frac), TR_SEEK_H - 2);

	dc->color = de_theme.text_dim;
	StrPrint(buf, "%03d/%03d", cur, n);
	GrPrint(dc, w - 12 - 8 * StrLen(buf), TrSeekY() + 1, "%s", buf);
}

U0 TrDrawPaneHelp(CDC *dc, I64 x, I64 y)
{
	I64 h = 20;

	dc->color = de_theme.panel;
	GrRect(dc, x, y, 470, 330);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, 470, 1);
	GrRect(dc, x, y + 329, 470, 1);
	GrRect(dc, x, y, 1, 330);
	GrRect(dc, x + 469, y, 1, 330);
	GrPrint(dc, x + 12, y + 6, "YTRACKER KEYS");
	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + h,		"Arrows        move cursor by sub-column");
	GrPrint(dc, x + 12, y + h + 13,	"Tab / Sh-Tab  next / previous channel");
	GrPrint(dc, x + 12, y + h + 26,	"Ctrl-Lt/Rt    channel   Ctrl-Up/Dn  pattern");
	GrPrint(dc, x + 12, y + h + 39,	"Sh-Up/Dn      instrument   Sh-Lt/Rt  octave");
	GrPrint(dc, x + 12, y + h + 52,	"PgUp / PgDn   move 16 rows  Home/End  ends");
	GrPrint(dc, x + 12, y + h + 65,	"ZSXDCVGBHNJM  notes, lower octave");
	GrPrint(dc, x + 12, y + h + 78,	"Q2W3ER5T6Y7U  notes, upper octave");
	GrPrint(dc, x + 12, y + h + 91,	"1             note off      0  clear cell");
	GrPrint(dc, x + 12, y + h + 104,"0-9 A-F       hex digits in the other columns");
	GrPrint(dc, x + 12, y + h + 117,"Ins / Del     insert / delete row in channel");
	GrPrint(dc, x + 12, y + h + 130,"Backspace     clear cell");
	GrPrint(dc, x + 12, y + h + 143,"Space         play / stop song");
	GrPrint(dc, x + 12, y + h + 156,"Enter         play pattern from cursor row");
	GrPrint(dc, x + 12, y + h + 169,"F1 F2 F3      help / instruments / order");
	GrPrint(dc, x + 12, y + h + 182,"F4 F7 F12     interpolate / follow / edit");
	GrPrint(dc, x + 12, y + h + 195,"F5 F6 F8      play song / play pattern / stop");
	GrPrint(dc, x + 12, y + h + 208,"F9 F10        save song / load song or .MOD");
	GrPrint(dc, x + 12, y + h + 221,"F11           load .WAV into current slot");
	GrPrint(dc, x + 12, y + h + 234,"- =           previous / next pattern");
	GrPrint(dc, x + 12, y + h + 247,"[ ]           tempo      ; '  speed (ticks)");
	GrPrint(dc, x + 12, y + h + 260,", .           master gain down / up");
	GrPrint(dc, x + 12, y + h + 273,"Click cell    move cursor   click CHn  mute");
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + h + 292, "F1 closes this - ESC quits YTracker");
}

U0 TrDrawPaneInst(CDC *dc, I64 x, I64 y)
{
	I64	 i, row = 0, top, n;
	U8	 buf[STR_LEN];

	dc->color = de_theme.panel;
	GrRect(dc, x, y, 420, 330);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, 420, 1);
	GrRect(dc, x, y + 329, 420, 1);
	GrRect(dc, x, y, 1, 330);
	GrRect(dc, x + 419, y, 1, 330);
	GrPrint(dc, x + 10, y + 6, "INSTRUMENTS - up/down select, F11 loads a WAV");

	top = ClampI64(tr.inst - 11, 1, TR_MAX_SAMPLES - 22);
	for (i = top; i < top + 22 && i < TR_MAX_SAMPLES; i++)
	{
		if (i == tr.inst)
		{
			dc->color = de_theme.bttn_focus;
			GrRect(dc, x + 6, y + 22 + row * 13 - 1, 408, 12);
			dc->color = de_theme.accent;
		}
		else if (tr_smp[i].data)
			dc->color = de_theme.text;
		else
			dc->color = de_theme.text_dim;
		if (tr_smp[i].data)
		{
			n = tr_smp[i].len;
			if (tr_smp[i].loop_len > 1)
				StrPrint(buf, "%02X %-22s %6d v%02d ft %2d loop", i,
						 tr_smp[i].name, n, tr_smp[i].volume,
						 tr_smp[i].finetune);
			else
				StrPrint(buf, "%02X %-22s %6d v%02d ft %2d", i,
						 tr_smp[i].name, n, tr_smp[i].volume,
						 tr_smp[i].finetune);
		}
		else
			StrPrint(buf, "%02X %-22s      -", i, "(empty)");
		GrPrint(dc, x + 10, y + 22 + row * 13, "%s", buf);
		row++;
	}
}

U0 TrDrawPaneOrder(CDC *dc, I64 x, I64 y)
{
	I64	 i, row = 0, top;
	U8	 buf[STR_LEN];

	dc->color = de_theme.panel;
	GrRect(dc, x, y, 300, 330);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, 300, 1);
	GrRect(dc, x, y + 329, 300, 1);
	GrRect(dc, x, y, 1, 330);
	GrRect(dc, x + 299, y, 1, 330);
	GrPrint(dc, x + 10, y + 6, "ORDER - Ins adds, Del removes, -/= sets pattern");

	top = ClampI64(tr.order_sel - 11, 0, TR_ORDER_MAX - 22);
	for (i = top; i < top + 22 && i < tr_song.order_len; i++)
	{
		if (i == tr.order_sel)
		{
			dc->color = de_theme.bttn_focus;
			GrRect(dc, x + 6, y + 22 + row * 13 - 1, 288, 12);
			dc->color = de_theme.accent;
		}
		else
			dc->color = de_theme.text;
		StrPrint(buf, "%03d   pattern %02X", i, tr_song.order[i]);
		GrPrint(dc, x + 10, y + 22 + row * 13, "%s", buf);
		row++;
	}
	if (!tr_song.order_len)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x + 10, y + 22, "(empty - Ins appends the current pattern)");
	}
}

U8 *tr_macro_names[TR_MACRO_COUNT] = {"Volume", "Arpeggio", "Pitch", "Duty"};
U8 *tr_arp_modes[3] = {"absolute", "fixed", "relative"};

//Geometry shared by the macro and wavetable editors.
#define TR_ED_W		470
#define TR_ED_H		330
#define TR_ED_GX	16		//Graph inset from the pane edge.
#define TR_ED_GY	64
#define TR_ED_GH	180

I64 TrMacroRange(I64 which, I64 *_lo)
{//Value range per macro type. Volume is the engine's 0..64; arpeggio and
//pitch are signed; duty indexes a bank.
	switch (which)
	{
		case TR_MACRO_ARP:
			*_lo = -48;
			return 48;
		case TR_MACRO_PITCH:
			*_lo = -64;
			return 64;
		case TR_MACRO_DUTY:
			*_lo = 0;
			return TR_WAVE_SLOTS - 1;
	}
	*_lo = 0;

	return 64;
}

CTrMacro *TrMacroCur()
{//Macro under the editor cursor, allocating the instrument if needed.
	CTrInst *ins;

	if (tr.inst < 1 || tr.inst >= TR_MAX_INSTRUMENTS)
		return NULL;
	ins = tr_inst[tr.inst];
	if (!ins)
		ins = TrInstAlloc(tr.inst);
	if (!ins)
		return NULL;

	return &ins->macro[ClampI64(tr.macro_sel, 0, TR_MACRO_COUNT - 1)];
}

U0 TrDrawPaneMacro(CDC *dc, I64 x, I64 y)
{
	CTrMacro *m = TrMacroCur();
	I64		  i, lo, hi, span, w, bx, bh, zero, v, n;
	U8		  buf[STR_LEN];

	dc->color = de_theme.panel;
	GrRect(dc, x, y, TR_ED_W, TR_ED_H);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, TR_ED_W, 1);
	GrRect(dc, x, y + TR_ED_H - 1, TR_ED_W, 1);
	GrRect(dc, x, y, 1, TR_ED_H);
	GrRect(dc, x + TR_ED_W - 1, y, 1, TR_ED_H);
	GrPrint(dc, x + 12, y + 6, "MACRO EDITOR - instrument %02X", tr.inst);
	if (!m)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x + 12, y + 24, "No instrument slot selected.");
		return;
	}

	hi = TrMacroRange(tr.macro_sel, &lo);
	span = hi - lo;
	if (span < 1)
		span = 1;

	//Type strip: the selected macro is highlighted, the rest dim.
	for (i = 0; i < TR_MACRO_COUNT; i++)
	{
		if (i == tr.macro_sel)
			dc->color = de_theme.accent;
		else if (tr_inst[tr.inst]->macro[i].len > 0)
			dc->color = de_theme.text;
		else
			dc->color = de_theme.text_dim;
		GrPrint(dc, x + 12 + i * 84, y + 24, "%s", tr_macro_names[i]);
	}

	dc->color = de_theme.text_dim;
	if (tr.macro_sel == TR_MACRO_ARP)
		StrPrint(buf, "len %2d  loop %2d  release %2d  mode %s",
				 m->len, m->loop, m->release,
				 tr_arp_modes[ClampI64(m->mode, 0, 2)]);
	else
		StrPrint(buf, "len %2d  loop %2d  release %2d", m->len, m->loop,
				 m->release);
	GrPrint(dc, x + 12, y + 42, "%s", buf);

	//Graph. One column per step, bar drawn from the zero line.
	n = m->len;
	if (n < 1)
		n = 1;
	w  = (TR_ED_W - 2 * TR_ED_GX) / TR_MACRO_LEN;
	if (w < 1)
		w = 1;
	zero = y + TR_ED_GY + TR_ED_GH * hi / span;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY, TR_MACRO_LEN * w, TR_ED_GH);
	GrRect(dc, x + TR_ED_GX, zero, TR_MACRO_LEN * w, 1);

	for (i = 0; i < TR_MACRO_LEN; i++)
	{
		bx = x + TR_ED_GX + i * w;
		if (i >= m->len)
		{//Past the end: nothing plays here.
			dc->color = de_theme.panel;
			GrRect(dc, bx, y + TR_ED_GY, w - 1, TR_ED_GH);
		}
		else
		{
			v  = ClampI64(m->val[i], lo, hi);
			bh = (v - lo) * TR_ED_GH / span;
			if (bh < 1)
				bh = 1;
			if (i == tr.macro_step)
				dc->color = de_theme.accent;
			else
				dc->color = de_theme.bttn_focus;
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH - bh, w - 1, bh);
		}
		//Loop and release markers sit under their step.
		if (i == m->loop)
		{
			dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH + 2, w - 1, 3);
		}
		if (i == m->release)
		{
			dc->color = ColorRGB(0xF0, 0x9A, 0x50);
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH + 6, w - 1, 3);
		}
	}

	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 14,
			"step %02d = %d", tr.macro_step,
			m->val[ClampI64(tr.macro_step, 0, TR_MACRO_LEN - 1)]);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 30,
			"Left/Right step   Up/Down value   Shift for big steps");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 44,
			"Tab macro   Ins/Del length   L loop   R release   M mode");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 58,
			"Click or drag in the graph to draw.  F4 closes.");
	dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 74, "green = loop point");
	dc->color = ColorRGB(0xF0, 0x9A, 0x50);
	GrPrint(dc, x + 190, y + TR_ED_GY + TR_ED_GH + 74, "orange = release");
}

U0 TrDrawPaneWave(CDC *dc, I64 x, I64 y)
{
	I64	 i, w, bx, bh, slot;
	U8	 buf[STR_LEN];

	dc->color = de_theme.panel;
	GrRect(dc, x, y, TR_ED_W, TR_ED_H);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, TR_ED_W, 1);
	GrRect(dc, x, y + TR_ED_H - 1, TR_ED_W, 1);
	GrRect(dc, x, y, 1, TR_ED_H);
	GrRect(dc, x + TR_ED_W - 1, y, 1, TR_ED_H);

	slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
	GrPrint(dc, x + 12, y + 6, "WAVETABLE EDITOR - table %02d of %d", slot,
			TR_WAVE_SLOTS);
	dc->color = de_theme.text_dim;
	StrPrint(buf, "%d steps, 0..%d, rendered into sample slot %02X",
			 TR_WAVE_STEPS, TR_WAVE_MAX, tr_wave_slot[slot]);
	GrPrint(dc, x + 12, y + 24, "%s", buf);

	w = (TR_ED_W - 2 * TR_ED_GX) / TR_WAVE_STEPS;
	if (w < 1)
		w = 1;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY, TR_WAVE_STEPS * w, TR_ED_GH);
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY + TR_ED_GH / 2,
		   TR_WAVE_STEPS * w, 1);

	for (i = 0; i < TR_WAVE_STEPS; i++)
	{
		bx = x + TR_ED_GX + i * w;
		bh = (tr_wave[slot].step[i] + 1) * TR_ED_GH / (TR_WAVE_MAX + 1);
		if (i == tr.wave_step)
			dc->color = de_theme.accent;
		else
			dc->color = de_theme.bttn_focus;
		GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH - bh, w - 1, bh);
	}

	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 14, "step %02d = %2d",
			tr.wave_step, tr_wave[slot].step[ClampI64(tr.wave_step, 0,
													  TR_WAVE_STEPS - 1)]);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 30,
			"Left/Right step   Up/Down value   Tab next table");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 44,
			"Click or drag to draw.  Set an instrument's bank to Wave and");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 58,
			"point its Duty macro at this table.  Shift-F4 closes.");
}


//Piano roll geometry. Time runs left to right in rows, pitch bottom to top.
#define TR_ROLL_X		56		//Keyboard gutter width.
#define TR_ROLL_KEYH	9		//Pixels per semitone.
#define TR_ROLL_COLW	14		//Pixels per row.

I64 tr_roll_keys = 24;			//Semitones visible, set by the last draw.

Bool TrRollBlack(I64 note)
{//note 1 is C-0, so the pitch class is (note - 1) % 12.
	I64 pc = (note - 1) % 12;

	return pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
}

I64 TrRollNoteAt(I64 my)
{//Screen row to note. The roll draws high pitches at the top.
	I64 k = (my - TR_GRID_Y) / TR_ROLL_KEYH;

	if (k < 0 || k >= tr_roll_keys)
		return 0;

	return tr.roll_top + tr_roll_keys - 1 - k;
}

I64 TrRollRowAt(I64 mx)
{
	if (mx < TR_ROLL_X + TR_GRID_X)
		return -1;

	return tr.view_top + (mx - TR_ROLL_X - TR_GRID_X) / TR_ROLL_COLW;
}

I64 TrRollLen(I64 pat, I64 ch, I64 row, I64 rows)
{//How long the note at this row sounds: until the next note, note-off or cut
//on the same channel. That is what a note's length IS in a tracker; there is
//no stored duration.
	CTrCell	*c;
	I64		 r, n = 1;

	for (r = row + 1; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && c->note)
			break;
		n++;
	}

	return n;
}

I64 TrRollNoteRow(I64 pat, I64 ch, I64 row, I64 note, I64 rows)
{//Row of the note whose block covers this row at this pitch, or -1. A note's
//block runs from its own row until the next note event, so this walks back
//to the nearest note and checks it is the right pitch and still sounding.
	CTrCell	*c;
	I64		 r;

	for (r = row; r >= 0; r--)
	{
		c = TrCell(pat, ch, r);
		if (c && c->note)
		{
			if (c->note != note)
				return -1;		//A different note owns this stretch.
			if (r + TrRollLen(pat, ch, r, rows) <= row)
				return -1;
			return r;
		}
	}

	return -1;
}

U0 TrViewToggle()
{//Grid to roll and back. Both read the same patterns, so this is a redraw.
	if (tr.view_mode == TR_VIEW_ROLL)
		tr.view_mode = TR_VIEW_GRID;
	else
	{
		tr.view_mode = TR_VIEW_ROLL;
		TrRollCenter;
	}
}

U0 TrRollSetLen(I64 pat, I64 ch, I64 row, I64 len, I64 rows)
{//Give the note at row the length len by placing a note-off after it. A cell
//stores no duration, so length IS the gap to the next event; writing one is
//the only way to shorten a note. Anything already at the target row wins,
//since that is real song data.
	CTrCell	*c;
	I64		 r, end;

	if (len < 1)
		len = 1;
	end = row + len;
	//Clear a note-off this note previously owned, so dragging longer works.
	for (r = row + 1; r < rows && r < end; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && (c->note == TR_NOTE_OFF || c->note == TR_NOTE_CUT) && !c->inst)
			MemSet(c, 0, sizeof(CTrCell));
	}
	if (end >= rows)
		return;
	c = TrCell(pat, ch, end);
	if (c && !c->note)
		c->note = TR_NOTE_OFF;
}

U0 TrRollDrag(I64 row0, I64 note0, Bool resize)
{//Hold the button to move a note or drag its tail.
//
//Polls rather than blocking on MessageGet: whether this window is delivered
//MS_MOVE depends on how it was spawned, and a blocking wait for a message
//that never comes would hang the app. The guard caps the wait at about ten
//seconds, so the worst case is a stall and a click that behaved like a click.
	CTrCell	*src, *dst;
	CTrCell	 held;
	I64		 msg, a1, a2, rows = TrCurRows(), row, note, len;
	I64		 last_row, last_note, guard = 0;
	Bool	 done = FALSE;

	src = TrCell(tr.cur_pat, tr.cur_ch, row0);
	if (!src || !src->note)
		return;
	MemCopy(&held, src, sizeof(CTrCell));
	len			= TrRollLen(tr.cur_pat, tr.cur_ch, row0, rows);
	last_row	= row0;
	last_note	= note0;
	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard	= 0;
			row		= TrRollRowAt(a1);
			note	= TrRollNoteAt(a2);
			if (resize)
			{
				if (last_row <= row < rows)
					TrRollSetLen(tr.cur_pat, tr.cur_ch, last_row,
								 row - last_row + 1, rows);
			}
			else if (0 <= row < rows && 1 <= note <= TR_NOTES &&
					 (row != last_row || note != last_note))
			{//Lift the cell, drop it on the new row, keep the length.
				src = TrCell(tr.cur_pat, tr.cur_ch, last_row);
				dst = TrCell(tr.cur_pat, tr.cur_ch, row);
				if (src && dst)
				{
					if (last_row != row)
						MemSet(src, 0, sizeof(CTrCell));
					MemCopy(dst, &held, sizeof(CTrCell));
					dst->note	= note;
					last_row	= row;
					last_note	= note;
					tr.cur_row	= row;
					TrRollSetLen(tr.cur_pat, tr.cur_ch, row, len, rows);
				}
			}
		}
	}
}

U0 TrRollCenter()
{//Put the cursor's note, or the first note in the channel, in the middle.
	CTrCell	*c;
	I64		 r, note = 0, rows = TrCurRows();

	c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
	if (c && 1 <= c->note <= TR_NOTES)
		note = c->note;
	else
		for (r = 0; r < rows && !note; r++)
		{
			c = TrCell(tr.cur_pat, tr.cur_ch, r);
			if (c && 1 <= c->note <= TR_NOTES)
				note = c->note;
		}
	if (!note)
		note = 49;			//C-4, the middle of the written range.
	tr.roll_top = ClampI64(note - tr_roll_keys / 2, 1,
						   MaxI64(1, TR_NOTES - tr_roll_keys));
}

U0 TrDrawRoll(CDC *dc, I64 w, I64 play_row, I64 play_pat)
{//The current pattern and channel as pitch against time. Same cells as the
//grid: this is a second reading of the song, not a second copy of it.
	I64		 rows = TrCurRows(), i, k, r, note, x, y, len, cols;
	CTrCell	*c;
	U8		 buf[16];

	tr_roll_keys = ClampI64((TrSeekY() - TR_GRID_Y - 4) / TR_ROLL_KEYH,
							4, TR_NOTES);
	cols = ClampI64((w - TR_GRID_X - TR_ROLL_X - 8) / TR_ROLL_COLW, 1,
					TR_MAX_ROWS);
	//Follow the tracker cursor so switching views keeps your place.
	if (tr.cur_row < tr.view_top)
		tr.view_top = tr.cur_row;
	if (tr.cur_row >= tr.view_top + cols)
		tr.view_top = tr.cur_row - cols + 1;
	tr.view_top = ClampI64(tr.view_top, 0, MaxI64(0, rows - cols));
	tr.roll_top = ClampI64(tr.roll_top, 1, TR_NOTES - tr_roll_keys);

	StrPrint(buf, "CH%02d", tr.cur_ch + 1);
	dc->color = de_theme.accent;
	GrPrint(dc, 12, TR_GRID_Y - 14, "%s  piano roll", buf);

	//Keyboard gutter and the lane stripes it labels.
	for (k = 0; k < tr_roll_keys; k++)
	{
		note = tr.roll_top + tr_roll_keys - 1 - k;
		y	 = TR_GRID_Y + k * TR_ROLL_KEYH;
		if (TrRollBlack(note))
			dc->color = de_theme.win_bg;
		else
			dc->color = de_theme.panel;
		GrRect(dc, TR_GRID_X, y, w - TR_GRID_X - 8, TR_ROLL_KEYH - 1);
		if (TrRollBlack(note))
			dc->color = de_theme.panel_edge;
		else
			dc->color = de_theme.text_dim;
		GrRect(dc, TR_GRID_X, y, TR_ROLL_X - 2, TR_ROLL_KEYH - 1);
		//Octave boundaries carry the label; anything closer is unreadable.
		if ((note - 1) % 12 == 0)
		{
			dc->color = de_theme.text;
			GrPrint(dc, TR_GRID_X + 2, y, "C%d", (note - 1) / 12);
		}
	}

	//Bar lines every four rows, in the secondary accent every sixteen.
	for (r = 0; r < cols; r++)
	{
		i = tr.view_top + r;
		x = TR_GRID_X + TR_ROLL_X + r * TR_ROLL_COLW;
		if (i % 4 == 0)
		{
			if (i % 16 == 0)
				dc->color = de_theme.accent2_dim;
			else
				dc->color = de_theme.panel_edge;
			GrRect(dc, x, TR_GRID_Y, 1, tr_roll_keys * TR_ROLL_KEYH);
		}
	}

	//Ghost notes: every other channel, dimmed. A single-channel roll hides the
	//harmony you are writing against, which is the main thing a DAW view is
	//for. Not clickable; the current channel owns the pointer.
	for (i = 0; i < tr_song.channels; i++)
	{
		if (i != tr.cur_ch)
		for (r = tr.view_top; r < rows && r < tr.view_top + cols; r++)
		{
			c = TrCell(tr.cur_pat, i, r);
			note = 0;
			if (c)
				note = c->note;
			if (1 <= note <= TR_NOTES &&
				tr.roll_top <= note < tr.roll_top + tr_roll_keys)
			{
				len = TrRollLen(tr.cur_pat, i, r, rows);
				if (r + len > tr.view_top + cols)
					len = tr.view_top + cols - r;
				x = TR_GRID_X + TR_ROLL_X + (r - tr.view_top) * TR_ROLL_COLW;
				y = TR_GRID_Y + (tr.roll_top + tr_roll_keys - 1 - note) *
					TR_ROLL_KEYH;
				dc->color = de_theme.panel_edge;
				GrRect(dc, x + 1, y + TR_ROLL_KEYH / 2 - 1,
					   len * TR_ROLL_COLW - 2, 2);
			}
		}
	}

	//Notes. A cell holds a pitch, not a duration, so the block runs to
	//whatever ends it.
	for (r = 0; r < rows; r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, r);
		note = 0;
		if (c)
			note = c->note;
		if (1 <= note <= TR_NOTES && tr.view_top <= r < tr.view_top + cols &&
			tr.roll_top <= note < tr.roll_top + tr_roll_keys)
		{
			len	= TrRollLen(tr.cur_pat, tr.cur_ch, r, rows);
			if (r + len > tr.view_top + cols)
				len = tr.view_top + cols - r;
			x	= TR_GRID_X + TR_ROLL_X + (r - tr.view_top) * TR_ROLL_COLW;
			y	= TR_GRID_Y + (tr.roll_top + tr_roll_keys - 1 - note) *
				  TR_ROLL_KEYH;
			if (r == tr.cur_row)
				dc->color = de_theme.accent;
			else
				dc->color = de_theme.accent_dim;
			GrRect(dc, x + 1, y + 1, len * TR_ROLL_COLW - 2, TR_ROLL_KEYH - 3);
			if (c->inst)
			{
				dc->color = de_theme.win_bg;
				GrPrint(dc, x + 2, y - 1, "%02X", c->inst);
			}
		}
	}

	//Playhead, then the edit cursor.
	if (tr.playing && play_pat == tr.cur_pat &&
		tr.view_top <= play_row < tr.view_top + cols)
	{
		dc->color = de_theme.accent2;
		GrRect(dc, TR_GRID_X + TR_ROLL_X +
			   (play_row - tr.view_top) * TR_ROLL_COLW, TR_GRID_Y, 2,
			   tr_roll_keys * TR_ROLL_KEYH);
	}
	if (tr.view_top <= tr.cur_row < tr.view_top + cols)
	{
		dc->color = de_theme.text;
		GrRect(dc, TR_GRID_X + TR_ROLL_X +
			   (tr.cur_row - tr.view_top) * TR_ROLL_COLW,
			   TR_GRID_Y + tr_roll_keys * TR_ROLL_KEYH, TR_ROLL_COLW, 2);
	}
}

U0 TrDrawIt(CTask *task, CDC *dc)
{
	I64	 ch, row, col, x, y, i, v, n, gx;
	I64	 w = task->pix_width, h = task->pix_height;
	I64	 play_ord = -1, play_pat = -1, play_row = -1;
	I64	 rows = TrCurRows();
	CTrCell	*c;
	U8	 buf[256], fld[8];

	dc->color = de_theme.win_bg;
	GrRect(dc, 0, 0, w, h);
	if (tr.busy)
	{//Patterns and samples are being replaced; nothing here is safe to read.
		dc->color = de_theme.text;
		GrPrint(dc, 12, 12, "loading...");
		return;
	}

	tr_view_w	 = w;
	tr_view_h	 = h;
	tr_view_chs	 = ClampI64((w - TR_GRID_X - 8) / TR_CELL_W, 1, TR_MAX_CHANNELS);
	//The grid stops above the seek bar, which now owns the bottom strip.
	tr_view_rows = ClampI64((TrSeekY() - TR_GRID_Y - 4) / TR_CELL_H,
							4, TR_MAX_ROWS);

	if (tr.playing)
		TrMarkNow(&play_ord, &play_pat, &play_row);

	//Header.
	dc->color = de_theme.accent;
	GrPrint(dc, 12, 6, "YTRACKER");
	dc->color = de_theme.text;
	GrPrint(dc, 96, 6, "%s", tr_song.title);
	dc->color = de_theme.text_dim;
	if (*tr.status)
		GrPrint(dc, 12, 18, "%s", tr.status);

	dc->color = de_theme.text;
	StrPrint(buf, "BPM %3d  Spd %2d  Pat %02X/%02X  Row %02X/%02X  Ord %03d/%03d  "
				  "Ch %d  Oct %d  Ins %02X  Gain %3d",
			 tr_song.bpm, tr_song.speed, tr.cur_pat, tr_song.n_patterns - 1,
			 tr.cur_row, rows - 1, tr.order_sel, tr_song.order_len,
			 tr_song.channels, tr.octave, tr.inst, tr.master);
	GrPrint(dc, 12, 30, "%s", buf);
	x = w - 260;
	if (tr.edit)
	{
		dc->color = ColorRGB(0xF0, 0x70, 0x70);
		GrPrint(dc, x, 6, "EDIT");
	}
	else
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x, 6, "VIEW");
	}
	{
		//Clickable: says what it switches to, so there is always a visible way
		//back from either view.
		dc->color = de_theme.bttn;
		GrRect(dc, TrViewBtnX() - 4, 2, TR_VIEWBTN_W, 14);
		dc->color = de_theme.accent2;
		if (tr.view_mode == TR_VIEW_ROLL)
			GrPrint(dc, TrViewBtnX(), 6, "[GRID]");
		else
			GrPrint(dc, TrViewBtnX(), 6, "[ROLL]");
	}
	if (tr.playing)
	{
		dc->color = de_theme.accent;
		if (tr.pat_mode)
			GrPrint(dc, x + 48, 6, "PLAY PAT");
		else
			GrPrint(dc, x + 48, 6, "PLAY SONG");
	}
	dc->color = de_theme.text_dim;
	if (tr.follow)
		GrPrint(dc, x + 144, 6, "FOLLOW");
	if (tr.interp)
		GrPrint(dc, x + 204, 6, "INTERP");

	TrDrawScope(dc, w);
	TrDrawSeek(dc, w, play_ord, play_row, play_pat);

	//Channel headers: name, mute state, VU.
	gx = TR_GRID_X;
	for (i = 0; i < tr_view_chs; i++)
	{
		ch = tr.view_ch + i;
		if (ch < tr_song.channels)
		{
			x = gx + i * TR_CELL_W;
			if (tr_ch[ch].mute)
			{
				dc->color = de_theme.text_dim;
				GrPrint(dc, x, TR_GRID_Y - 26, "CH%02d MUTE", ch + 1);
			}
			else
			{
				dc->color = de_theme.text;
				GrPrint(dc, x, TR_GRID_Y - 26, "CH%02d", ch + 1);
			}
			v = ClampI64(tr_ch[ch].peak * 96 / 32768, 0, 96);
			dc->color = de_theme.panel;
			GrRect(dc, x, TR_GRID_Y - 14, 96, 5);
			if (v > 0)
			{
				dc->color = de_theme.accent;
				GrRect(dc, x, TR_GRID_Y - 14, v, 5);
			}
		}
	}

	if (tr.view_mode == TR_VIEW_ROLL)
	{//Same pattern, drawn as pitch against time.
		TrDrawRoll(dc, w, play_row, play_pat);
		TrDrawSeek(dc, w, play_ord, play_row, play_pat);
		switch (tr.pane)
		{
			case TR_PANE_HELP:	TrDrawPaneHelp(dc, 60, 120);	break;
			case TR_PANE_INST:	TrDrawPaneInst(dc, 60, 120);	break;
			case TR_PANE_ORDER:	TrDrawPaneOrder(dc, 60, 120);	break;
			case TR_PANE_MACRO:	TrDrawPaneMacro(dc, 60, 120);	break;
			case TR_PANE_WAVE:	TrDrawPaneWave(dc, 60, 120);	break;
		}
		return;
	}

	//Keep the cursor, or the playhead in follow mode, on screen.
		tr.view_top = tr.cur_row;
	if (tr.cur_row >= tr.view_top + tr_view_rows)
		tr.view_top = tr.cur_row - tr_view_rows + 1;
	tr.view_top = ClampI64(tr.view_top, 0, MaxI64(0, rows - tr_view_rows));
	if (tr.cur_ch < tr.view_ch)
		tr.view_ch = tr.cur_ch;
	if (tr.cur_ch >= tr.view_ch + tr_view_chs)
		tr.view_ch = tr.cur_ch - tr_view_chs + 1;
	tr.view_ch = ClampI64(tr.view_ch, 0,
						  MaxI64(0, tr_song.channels - tr_view_chs));

	for (row = 0; row < tr_view_rows; row++)
	{
		n = tr.view_top + row;
		if (n < rows)
		{
			y = TR_GRID_Y + row * TR_CELL_H;
			if (n == play_row && play_pat == tr.cur_pat)
			{
				dc->color = de_theme.bttn_focus;
				GrRect(dc, 8, y - 1, w - 16, TR_CELL_H - 1);
			}
			//Beat rows in the secondary accent so the bar lines read without
			//counting; the DE's Settings panel sets the hue.
			if (n % 16 == 0)
			{
				dc->color = de_theme.accent2;
				GrRect(dc, 8, y - 1, w - 16, 1);
			}
			if (n % 4)
				dc->color = de_theme.text_dim;
			else if (n % 16)
				dc->color = de_theme.accent2_dim;
			else
				dc->color = de_theme.accent2;
			GrPrint(dc, 12, y, "%02X", n);
			for (i = 0; i < tr_view_chs; i++)
			{
				ch = tr.view_ch + i;
				if (ch < tr_song.channels)
				{
					x = gx + i * TR_CELL_W;
					c = TrCell(tr.cur_pat, ch, n);
					TrCellText(c, buf);
					if (ch == tr.cur_ch && n == tr.cur_row)
					{//Highlight the whole cell, then the active sub-column.
						dc->color = de_theme.panel;
						GrRect(dc, x - 2, y - 1, 108, TR_CELL_H - 1);
						col = ClampI64(tr.cur_col, 0, TR_COLS - 1);
						if (tr.edit)
							dc->color = ColorRGB(0xF0, 0x70, 0x70);
						else
							dc->color = de_theme.accent;
						GrRect(dc, x + tr_col_x[col] * FONT_WIDTH - 1, y - 1,
							   tr_col_w[col] * FONT_WIDTH + 1, TR_CELL_H - 1);
						dc->color = ColorRGB(0x10, 0x14, 0x1E);
						GrPrint(dc, x, y, "%s", buf);
					}
					else if (tr_ch[ch].mute)
					{
						dc->color = de_theme.text_dim;
						GrPrint(dc, x, y, "%s", buf);
					}
					else
					{//Colour the columns so effects stand out from notes.
						if (c && c->note)
							dc->color = ColorRGB(0xC8, 0xDC, 0xFF);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf, 3);
						fld[3] = 0;
						GrPrint(dc, x, y, "%s", fld);
						if (c && c->inst)
							dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 4, 2);
						fld[2] = 0;
						GrPrint(dc, x + 4 * FONT_WIDTH, y, "%s", fld);
						if (c && c->volcmd)
							dc->color = ColorRGB(0xF2, 0xD9, 0x60);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 7, 2);
						fld[2] = 0;
						GrPrint(dc, x + 7 * FONT_WIDTH, y, "%s", fld);
						if (c && (c->eff || c->param))
							dc->color = ColorRGB(0xF0, 0x9A, 0x50);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 10, 3);
						fld[3] = 0;
						GrPrint(dc, x + 10 * FONT_WIDTH, y, "%s", fld);
					}
				}
			}
		}
	}

	switch (tr.pane)
	{
		case TR_PANE_HELP:	TrDrawPaneHelp(dc, 60, 120);	break;
		case TR_PANE_INST:	TrDrawPaneInst(dc, 60, 120);	break;
		case TR_PANE_ORDER:	TrDrawPaneOrder(dc, 60, 120);	break;
		case TR_PANE_MACRO:	TrDrawPaneMacro(dc, 60, 120);	break;
		case TR_PANE_WAVE:	TrDrawPaneWave(dc, 60, 120);	break;
	}
}

I64 TrKeyNote(I64 key)
{//Two piano rows. -1 if the key is not a note.
	U8	*low = "zsxdcvgbhnjm", *high = "q2w3er5t6y7u";
	I64	 i;

	for (i = 0; low[i]; i++)
		if (key == low[i])
			return tr.octave * 12 + i + 1;
	for (i = 0; high[i]; i++)
		if (key == high[i])
			return (tr.octave + 1) * 12 + i + 1;

	return -1;
}

I64 TrKeyHex(I64 key)
{//-1 if the key is not a hex digit.
	if ('0' <= key <= '9')
		return key - '0';
	if ('a' <= key <= 'f')
		return key - 'a' + 10;
	if ('A' <= key <= 'F')
		return key - 'A' + 10;

	return -1;
}

U0 TrRowInsert(I64 ch)
{//Shift this channel down from the cursor; the last row falls off.
	I64		 r, rows = TrCurRows();
	CTrCell	*a, *b;

	if (!TrEnsurePattern(tr.cur_pat))
		return;
	for (r = rows - 1; r > tr.cur_row; r--)
	{
		a = TrCell(tr.cur_pat, ch, r);
		b = TrCell(tr.cur_pat, ch, r - 1);
		if (a && b)
			MemCopy(a, b, sizeof(CTrCell));
	}
	a = TrCell(tr.cur_pat, ch, tr.cur_row);
	if (a)
		MemSet(a, 0, sizeof(CTrCell));
}

U0 TrRowDelete(I64 ch)
{
	I64		 r, rows = TrCurRows();
	CTrCell	*a, *b;

	if (!tr_pat[tr.cur_pat])
		return;
	for (r = tr.cur_row; r < rows - 1; r++)
	{
		a = TrCell(tr.cur_pat, ch, r);
		b = TrCell(tr.cur_pat, ch, r + 1);
		if (a && b)
			MemCopy(a, b, sizeof(CTrCell));
	}
	a = TrCell(tr.cur_pat, ch, rows - 1);
	if (a)
		MemSet(a, 0, sizeof(CTrCell));
}

U0 TrMenuPane(I64 pane)
{
	if (tr.pane == pane)
		tr.pane = TR_PANE_NONE;
	else
		tr.pane = pane;
}

Bool TrEdKey(I64 key, I64 sc, I64 flags)
{//The macro and wavetable editors take the keyboard while open. Returns TRUE
//when the key was consumed, so the pattern editor never sees it and the note
//keys cannot enter notes behind an open editor.
	CTrMacro *m;
	I64		  lo, hi, step, big = 1, slot;
	Bool	  shift = (flags & SCF_SHIFT) != 0;

	if (tr.pane != TR_PANE_MACRO && tr.pane != TR_PANE_WAVE)
		return FALSE;
	if (shift)
		big = 8;

	if (tr.pane == TR_PANE_WAVE)
	{
		slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
		step = ClampI64(tr.wave_step, 0, TR_WAVE_STEPS - 1);
		switch (sc)
		{
			case SC_CURSOR_LEFT:
				tr.wave_step = (step + TR_WAVE_STEPS - 1) % TR_WAVE_STEPS;
				return TRUE;
			case SC_CURSOR_RIGHT:
				tr.wave_step = (step + 1) % TR_WAVE_STEPS;
				return TRUE;
			case SC_CURSOR_UP:
				tr_wave[slot].step[step] =
					ClampI64(tr_wave[slot].step[step] + big, 0, TR_WAVE_MAX);
				tr_wave[slot].used = TRUE;
				TrWaveRender(slot);
				return TRUE;
			case SC_CURSOR_DOWN:
				tr_wave[slot].step[step] =
					ClampI64(tr_wave[slot].step[step] - big, 0, TR_WAVE_MAX);
				tr_wave[slot].used = TRUE;
				TrWaveRender(slot);
				return TRUE;
		}
		if (key == '\t')
		{
			if (shift)
				tr.wave_sel = (slot + TR_WAVE_SLOTS - 1) % TR_WAVE_SLOTS;
			else
				tr.wave_sel = (slot + 1) % TR_WAVE_SLOTS;
			return TRUE;
		}
		//Digits type a value directly; hex covers the full 0..15 range.
		if (TrKeyHex(key) >= 0)
		{
			tr_wave[slot].step[step] = ClampI64(TrKeyHex(key), 0, TR_WAVE_MAX);
			tr_wave[slot].used = TRUE;
			TrWaveRender(slot);
			tr.wave_step = (step + 1) % TR_WAVE_STEPS;
			return TRUE;
		}
		return FALSE;
	}

	m = TrMacroCur();
	if (!m)
		return FALSE;
	hi	 = TrMacroRange(tr.macro_sel, &lo);
	step = ClampI64(tr.macro_step, 0, TR_MACRO_LEN - 1);
	switch (sc)
	{
		case SC_CURSOR_LEFT:
			tr.macro_step = (step + TR_MACRO_LEN - 1) % TR_MACRO_LEN;
			return TRUE;
		case SC_CURSOR_RIGHT:
			tr.macro_step = (step + 1) % TR_MACRO_LEN;
			return TRUE;
		case SC_CURSOR_UP:
			m->val[step] = ClampI64(m->val[step] + big, lo, hi);
			if (m->len <= step)
				m->len = step + 1;
			return TRUE;
		case SC_CURSOR_DOWN:
			m->val[step] = ClampI64(m->val[step] - big, lo, hi);
			if (m->len <= step)
				m->len = step + 1;
			return TRUE;
		case SC_INS:
			m->len = ClampI64(m->len + 1, 0, TR_MACRO_LEN);
			return TRUE;
		case SC_DELETE:
			m->len = ClampI64(m->len - 1, 0, TR_MACRO_LEN);
			if (m->loop >= m->len)
				m->loop = -1;
			if (m->release >= m->len)
				m->release = -1;
			return TRUE;
	}
	if (key == '\t')
	{
		if (shift)
			tr.macro_sel = (tr.macro_sel + TR_MACRO_COUNT - 1) %
						   TR_MACRO_COUNT;
		else
			tr.macro_sel = (tr.macro_sel + 1) % TR_MACRO_COUNT;
		return TRUE;
	}
	if (key == 'l' || key == 'L')
	{//Toggle the loop point on this step.
		if (m->loop == step)
			m->loop = -1;
		else
			m->loop = step;
		return TRUE;
	}
	if (key == 'r' || key == 'R')
	{
		if (m->release == step)
			m->release = -1;
		else
			m->release = step;
		return TRUE;
	}
	if (key == 'm' || key == 'M')
	{
		if (tr.macro_sel == TR_MACRO_ARP)
			m->mode = (m->mode + 1) % 3;
		return TRUE;
	}
	return FALSE;
}

U0 TrEdClick(I64 mx, I64 my)
{//Draw into whichever editor is open. Called on press and on drag.
	CTrMacro *m;
	I64		  gx = 60 + TR_ED_GX, gy = 120 + TR_ED_GY;
	I64		  i, w, lo, hi, v, slot;

	if (my < gy || my >= gy + TR_ED_GH)
		return;
	if (tr.pane == TR_PANE_WAVE)
	{
		w = (TR_ED_W - 2 * TR_ED_GX) / TR_WAVE_STEPS;
		if (w < 1)
			return;
		i = (mx - gx) / w;
		if (i < 0 || i >= TR_WAVE_STEPS)
			return;
		slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
		//Top of the graph is the maximum, so invert the pointer's y.
		v = (gy + TR_ED_GH - my) * (TR_WAVE_MAX + 1) / TR_ED_GH;
		tr_wave[slot].step[i]	= ClampI64(v, 0, TR_WAVE_MAX);
		tr_wave[slot].used		= TRUE;
		tr.wave_step			= i;
		TrWaveRender(slot);
		return;
	}
	if (tr.pane != TR_PANE_MACRO)
		return;
	m = TrMacroCur();
	if (!m)
		return;
	w = (TR_ED_W - 2 * TR_ED_GX) / TR_MACRO_LEN;
	if (w < 1)
		return;
	i = (mx - gx) / w;
	if (i < 0 || i >= TR_MACRO_LEN)
		return;
	hi = TrMacroRange(tr.macro_sel, &lo);
	v  = lo + (gy + TR_ED_GH - my) * (hi - lo) / TR_ED_GH;
	m->val[i]		= ClampI64(v, lo, hi);
	tr.macro_step	= i;
	if (m->len <= i)
		m->len = i + 1;
}

U0 TrClick(I64 mx, I64 my)
{
	I64		 i, row, col, gl, ord, bw, bar;
	CTrCell	*cell;

	//An open editor owns the pointer inside its panel.
	if (tr.pane == TR_PANE_MACRO || tr.pane == TR_PANE_WAVE)
	{
		if (60 <= mx && mx < 60 + TR_ED_W && 120 <= my && my < 120 + TR_ED_H)
		{
			TrEdClick(mx, my);
			return;
		}
	}

	//Header button, live in both views so there is always a way back.
	if (my < 18 && TrViewBtnX() - 4 <= mx < TrViewBtnX() - 4 + TR_VIEWBTN_W)
	{
		TrViewToggle;
		return;
	}

	//Piano roll: a click places the current instrument's note at the pitch and
	//row under the pointer, and clicking a note again removes it. The cell is
	//the same one the grid edits.
	if (tr.view_mode == TR_VIEW_ROLL && my >= TR_GRID_Y && my < TrSeekY())
	{
		row	= TrRollRowAt(mx);
		gl	= TrRollNoteAt(my);
		if (0 <= row < TrCurRows() && 1 <= gl <= TR_NOTES)
		{
			//A click inside a sounding note grabs it; the note's own row moves
			//it, its last row drags the tail.
			bar = TrRollNoteRow(tr.cur_pat, tr.cur_ch, row, gl, TrCurRows());
			if (bar >= 0)
			{
				tr.cur_row = bar;
				TrRollDrag(bar, gl,
						   row >= bar + TrRollLen(tr.cur_pat, tr.cur_ch, bar,
												  TrCurRows()) - 1);
				return;
			}
			cell = TrCell(tr.cur_pat, tr.cur_ch, row);
			if (cell)
			{
				tr.cur_row = row;
				if (cell->note == gl)
					MemSet(cell, 0, sizeof(CTrCell));
				else
				{
					cell->note = gl;
					cell->inst = tr.inst;
					//Drag straight out of the click to set the length.
					TrRollDrag(row, gl, TRUE);
				}
			}
		}
		return;
	}

	//Song position bar: seek to the order under the pointer. Seeking while
	//stopped moves the cursor there instead of starting playback.
	if (TrSeekY() <= my && my < TrSeekY() + TR_SEEK_H && tr_song.order_len > 0)
	{
		bw	= tr_view_w - 24;
		ord	= ClampI64((mx - 12) * tr_song.order_len / MaxI64(1, bw),
					   0, tr_song.order_len - 1);
		tr.order_sel	= ord;
		tr.cur_pat		= TrPatternForOrder(ord);
		tr.cur_row		= 0;
		tr.view_top		= 0;
		if (tr.playing)
		{
			tr.pat_mode = FALSE;
			TrPlayStart(ord, 0);
		}
		TrStatus("Order %03d, pattern %02X", ord, tr.cur_pat);
		return;
	}

	i = (mx - TR_GRID_X) / TR_CELL_W;
	if (i < 0 || i >= tr_view_chs)
		return;
	if (my >= TR_GRID_Y - 28 && my < TR_GRID_Y - 8)
	{//Channel header: toggle mute.
		i += tr.view_ch;
		if (i < tr_song.channels)
			tr_ch[i].mute = !tr_ch[i].mute;
		return;
	}
	if (my < TR_GRID_Y)
		return;
	row = (my - TR_GRID_Y) / TR_CELL_H;
	if (row < 0 || row >= tr_view_rows)
		return;
	if (tr.view_ch + i >= tr_song.channels)
		return;
	tr.cur_ch	= tr.view_ch + i;
	tr.cur_row	= ClampI64(tr.view_top + row, 0, TrCurRows() - 1);
	//Glyph index inside the cell picks the sub-column.
	gl = (mx - TR_GRID_X - i * TR_CELL_W) / FONT_WIDTH;
	for (col = TR_COLS - 1; col >= 0; col--)
		if (gl >= tr_col_x[col])
		{
			tr.cur_col = col;
			col = -1;
		}
}

U0 TrSaveAs()
{
	U8	 hdr[300];
	U8	*name;

	StrPrint(hdr, "Save song as (ENTER keeps %s):", tr.file);
	name = PopUpGetStr(hdr);
	WinFocus(tr.win_task);
	if (!name)
		return;
	if (*name)
	{
		StrCopy(tr.file, name);
		if (StrLen(tr.file) > 4 &&
			StrICompare(tr.file + StrLen(tr.file) - 4, ".DAT"))
			CatPrint(tr.file, ".DAT");
	}
	Free(name);
	if (TrSongSave(tr.file))
		TrStatus("Saved %s (%d bytes)", tr.file, TrSongSize());
	else if (!TrNameOk(tr.file))
	{
		TrStatus("Cannot save as %s", tr.file);
		PopUpOk("That name cannot be created.\n\n"
				"The file layer faults rather than erring on a name longer "
				"than 8 characters plus a 3 character extension, so saving "
				"screens it first. Existing long names still LOAD fine.");
		WinFocus(tr.win_task);
	}
	else
		TrStatus("Save failed - out of memory");
}

U0 TrLoadAs()
{
	I64	 kind;
	U8	*name = PopUpPickFile(tr.dir_song);

	WinFocus(tr.win_task);
	if (!name)
		return;
	//Remember where this came from, whatever the load then makes of it.
	TrDirOf(name, tr.dir_song, sizeof(tr.dir_song));
	TrConfigSave;
	TrMixSuspend;
	kind = TrLoadFile(name);
	switch (kind)
	{
		case 1:
			StrCopy(tr.file, name);
			TrStatus("Loaded YTK3 %s - %d ch, %d pat", name,
					 tr_song.channels, tr_song.n_patterns);
			break;
		case 2:
			TrStatus("Loaded MOD %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 3:
			TrStatus("Imported YTK2 %s", name);
			break;
		case 4:
			TrStatus("Loaded XM %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 5:
			TrStatus("Loaded IT %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 6:
			TrStatus("Loaded S3M %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 7:
			TrStatus("Loaded FTM %s - %d ch, %d pat (2A03 only)", name,
					 tr_song.channels, tr_song.n_patterns);
			break;
		case -1:
			TrStatus("Could not read %s", name);
			PopUpOk("Could not read that file.\n\n"
					"The format is detected from the file's contents, not its "
					"extension, so this is the file layer refusing the name "
					"rather than an unsupported format. Names with spaces, "
					"'&' or a leading '~' are the usual cause; rename to "
					"letters, digits, '.', '-' and '_' and try again.");
			WinFocus(tr.win_task);
			break;
		default:
			//A failed parse can leave the song half torn down.
			if (!tr_pat[0])
				TrSongNew(4, 8, 64);
			TrStatus("%s is not a module this build recognises", name);
			PopUpOk("Unrecognised file.\n\n"
					"Reads .MOD, .XM, .S3M, .IT, .FTM and YTracker's own YTK3 "
					"and YTK2 songs. Detection is by content, so the extension "
					"does not matter.\n\n"
					"A file using a feature this build skips still loads; a "
					"file that reaches here matched none of the formats.");
			WinFocus(tr.win_task);
	}
	Free(name);
	tr.cur_pat	= 0;
	tr.cur_ch	= 0;
	tr.cur_row	= 0;
	tr.cur_col	= 0;
	tr.view_ch	= 0;
	tr.view_top	= 0;
	tr.order_sel = 0;
	TrMixResume;
}

U0 TrLoadSample()
{
	I64	 n, slot = tr.inst;
	U8	*name = PopUpPickFile(tr.dir_smp);

	WinFocus(tr.win_task);
	if (!name)
		return;
	TrDirOf(name, tr.dir_smp, sizeof(tr.dir_smp));
	TrConfigSave;
	TrMixSuspend;
	n = TrSampleLoadFile(slot, name);
	TrMixResume;
	if (n)
		TrStatus("Slot %02X: %s, %d frames", slot, tr_smp[slot].name, n);
	else
	{
		TrStatus("Not an 8/16-bit PCM WAV");
		PopUpOk("Need an uncompressed 8- or 16-bit PCM WAV.");
		WinFocus(tr.win_task);
	}
	Free(name);
}

U0 TrEditCell(I64 key)
{//Type into the cell under the cursor. Only reached in edit mode.
	CTrCell	*c;
	I64		 n, d;

	if (!TrEnsurePattern(tr.cur_pat))
		return;
	c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
	if (!c)
		return;

	if (key == CH_BACKSPACE)
	{
		MemSet(c, 0, sizeof(CTrCell));
		return;
	}

	if (tr.cur_col == TR_COL_NOTE)
	{
		if (key == '0')
		{
			MemSet(c, 0, sizeof(CTrCell));
			tr.cur_row = (tr.cur_row + 1) % TrCurRows();
			return;
		}
		if (key == '1')
		{
			c->note = TR_NOTE_OFF;
			c->inst = 0;
			tr.cur_row = (tr.cur_row + 1) % TrCurRows();
			return;
		}
		n = TrKeyNote(key);
		if (n >= 1 && n <= TR_NOTES)
		{
			c->note = n;
			c->inst = tr.inst;
			if (!c->volcmd)
			{
				c->volcmd  = TRV_SET;
				c->volparam = tr.vol_default;
			}
			TrPreview(n, tr.inst, tr.vol_default);
			tr.cur_row = (tr.cur_row + tr.step_add) % TrCurRows();
		}
		return;
	}

	d = TrKeyHex(key);
	if (d < 0)
		return;
	switch (tr.cur_col)
	{
		case TR_COL_INST1:	c->inst = (d << 4) | (c->inst & 0x0F);	break;
		case TR_COL_INST2:	c->inst = (c->inst & 0xF0) | d;			break;
		case TR_COL_VOL1:
			n = c->volparam;
			if (c->volcmd != TRV_SET)
				n = 0;
			n = (d << 4) | (n & 0x0F);
			c->volcmd  = TRV_SET;
			c->volparam = ClampI64(n, 0, 64);
			break;
		case TR_COL_VOL2:
			n = c->volparam;
			if (c->volcmd != TRV_SET)
				n = 0;
			n = (n & 0xF0) | d;
			c->volcmd  = TRV_SET;
			c->volparam = ClampI64(n, 0, 64);
			break;
		case TR_COL_EFF:	c->eff = d;								break;
		case TR_COL_PARAM1:	c->param = (d << 4) | (c->param & 0x0F);break;
		case TR_COL_PARAM2:	c->param = (c->param & 0xF0) | d;		break;
	}
	if (tr.cur_col == TR_COL_INST2 || tr.cur_col == TR_COL_VOL2 ||
		tr.cur_col == TR_COL_PARAM2)
		tr.cur_row = (tr.cur_row + tr.step_add) % TrCurRows();
	else
		tr.cur_col++;
	if (tr.cur_col >= TR_COLS)
		tr.cur_col = TR_COLS - 1;
}

U0 TrKeyScan(I64 sc, I64 flags)
{//Non-character keys. flags carries SCF_SHIFT / SCF_CTRL.
	I64	 rows = TrCurRows(), n;
	Bool shift = (flags & SCF_SHIFT) != 0, ctrl = (flags & SCF_CTRL) != 0;

	//F4 and F5 still toggle the editors, so they are not offered to it.
	if (sc != SC_F4 && TrEdKey(0, sc, flags))
		return;

	switch (sc)
	{
		case SC_CURSOR_UP:
			if (shift)
				tr.inst = ClampI64(tr.inst + 1, 1, TR_MAX_SAMPLES - 1);
			else if (ctrl)
				tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			else if (tr.pane == TR_PANE_INST)
				tr.inst = ClampI64(tr.inst - 1, 1, TR_MAX_SAMPLES - 1);
			else if (tr.pane == TR_PANE_ORDER)
				tr.order_sel = MaxI64(0, tr.order_sel - 1);
			else
				tr.cur_row = (tr.cur_row + rows - 1) % rows;
			break;
		case SC_CURSOR_DOWN:
			if (shift)
				tr.inst = ClampI64(tr.inst - 1, 1, TR_MAX_SAMPLES - 1);
			else if (ctrl)
				tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			else if (tr.pane == TR_PANE_INST)
				tr.inst = ClampI64(tr.inst + 1, 1, TR_MAX_SAMPLES - 1);
			else if (tr.pane == TR_PANE_ORDER)
				tr.order_sel = MinI64(tr_song.order_len - 1, tr.order_sel + 1);
			else
				tr.cur_row = (tr.cur_row + 1) % rows;
			break;
		case SC_CURSOR_LEFT:
			if (shift)
				tr.octave = ClampI64(tr.octave - 1, 0, 6);
			else if (ctrl)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) % tr_song.channels;
			else
			{
				tr.cur_col--;
				if (tr.cur_col < 0)
				{
					tr.cur_col = TR_COLS - 1;
					tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) %
								tr_song.channels;
				}
			}
			break;
		case SC_CURSOR_RIGHT:
			if (shift)
				tr.octave = ClampI64(tr.octave + 1, 0, 6);
			else if (ctrl)
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			else
			{
				tr.cur_col++;
				if (tr.cur_col >= TR_COLS)
				{
					tr.cur_col = 0;
					tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
				}
			}
			break;
		case SC_TAB:
			if (ctrl)
			{//Ctrl-Tab swaps the grid for the piano roll and back.
				TrViewToggle;
				break;
			}
			if (shift)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) % tr_song.channels;
			else
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			tr.cur_col = 0;
			break;
		case SC_PAGE_UP:
			if (tr.view_mode == TR_VIEW_ROLL && ctrl)
			{
				tr.roll_top = ClampI64(tr.roll_top + 12, 1,
									   MaxI64(1, TR_NOTES - tr_roll_keys));
				break;
			}
			tr.cur_row = MaxI64(0, tr.cur_row - 16);
			break;
		case SC_PAGE_DOWN:
			if (tr.view_mode == TR_VIEW_ROLL && ctrl)
			{
				tr.roll_top = ClampI64(tr.roll_top - 12, 1,
									   MaxI64(1, TR_NOTES - tr_roll_keys));
				break;
			}
			tr.cur_row = MinI64(rows - 1, tr.cur_row + 16);
			break;
		case SC_HOME:
			tr.cur_row = 0;
			break;
		case SC_END:
			tr.cur_row = rows - 1;
			break;
		case SC_INS:
			if (tr.pane == TR_PANE_ORDER)
			{
				if (tr_song.order_len < TR_ORDER_MAX)
				{//MemCopy only runs forward, so shift by hand.
					tr.order_sel = ClampI64(tr.order_sel, 0, tr_song.order_len);
					for (n = tr_song.order_len; n > tr.order_sel; n--)
						tr_song.order[n] = tr_song.order[n - 1];
					tr_song.order[tr.order_sel] = tr.cur_pat;
					tr_song.order_len++;
				}
			}
			else
				TrRowInsert(tr.cur_ch);
			break;
		case SC_DELETE:
			if (tr.pane == TR_PANE_ORDER)
			{
				if (tr_song.order_len > 0)
				{
					tr_song.order_len--;
					for (n = tr.order_sel; n < tr_song.order_len; n++)
						tr_song.order[n] = tr_song.order[n + 1];
					tr.order_sel = ClampI64(tr.order_sel, 0,
											MaxI64(0, tr_song.order_len - 1));
				}
			}
			else if (shift)
				TrRowDelete(tr.cur_ch);
			else
				TrEditCell(CH_BACKSPACE);
			break;
		case SC_F1:
			if (tr.pane == TR_PANE_HELP)
				tr.pane = TR_PANE_NONE;
			else
				tr.pane = TR_PANE_HELP;
			break;
		case SC_F2:
			if (tr.pane == TR_PANE_INST)
				tr.pane = TR_PANE_NONE;
			else
				tr.pane = TR_PANE_INST;
			break;
		case SC_F3:
			if (tr.pane == TR_PANE_ORDER)
				tr.pane = TR_PANE_NONE;
			else
				tr.pane = TR_PANE_ORDER;
			break;
		case SC_F4:
			//Shift picks the wavetable editor. Interpolation is a
			//set-and-forget switch and lives on the View menu now.
			if (shift)
				TrMenuPane(TR_PANE_WAVE);
			else
				TrMenuPane(TR_PANE_MACRO);
			break;
		case SC_F5:
			tr.pat_mode = FALSE;
			TrPlayStart(0, 0);
			break;
		case SC_F6:
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			break;
		case SC_F7:
			tr.follow = !tr.follow;
			break;
		case SC_F8:
			TrPlayStop;
			break;
		case SC_F9:
			TrSaveAs;
			break;
		case SC_F10:
			TrLoadAs;
			break;
		case SC_F11:
			TrLoadSample;
			break;
		case SC_F12:
			tr.edit = !tr.edit;
			break;
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
	tr.cur_col = ClampI64(tr.cur_col, 0, TR_COLS - 1);
	tr.cur_ch  = ClampI64(tr.cur_ch, 0, tr_song.channels - 1);
}

U0 TrKeyChar(I64 key, I64 flags)
{
	I64 n;

	//An open macro or wavetable editor consumes the keyboard: the piano keys
	//would otherwise enter notes into the pattern behind it.
	if (key != CH_ESC && key != CH_SHIFT_ESC && TrEdKey(key, 0, flags))
		return;

	switch (key)
	{
		case '\t':
			//Tab arrives as a character, not as a bare scan code.
			if (flags & SCF_SHIFT)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) %
							tr_song.channels;
			else
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			tr.cur_col = 0;
			return;
		case ' ':
			if (tr.playing)
				TrPlayStop;
			else
			{
				tr.pat_mode = FALSE;
				TrPlayStart(tr.order_sel, 0);
			}
			return;
		case CH_ESC:
			//From the roll, Esc returns to the grid rather than quitting: one
			//key out of a mode is worth more than a second way to exit.
			if (tr.view_mode == TR_VIEW_ROLL)
			{
				tr.view_mode = TR_VIEW_GRID;
				return;
			}
			tr.quit = TRUE;
			return;
		case CH_SHIFT_ESC:
			tr.quit = TRUE;
			return;
		case '\n':
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			return;
		case '-':
			tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			if (tr.pane == TR_PANE_ORDER && tr_song.order_len)
				tr_song.order[tr.order_sel] = tr.cur_pat;
			return;
		case '=':
			tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			if (tr.pane == TR_PANE_ORDER && tr_song.order_len)
				tr_song.order[tr.order_sel] = tr.cur_pat;
			return;
		case '[':
			tr_song.bpm = ClampI64(tr_song.bpm - 1, 32, 255);
			return;
		case ']':
			tr_song.bpm = ClampI64(tr_song.bpm + 1, 32, 255);
			return;
		case ';':
			tr_song.speed = ClampI64(tr_song.speed - 1, 1, 31);
			return;
		case '\'':
			tr_song.speed = ClampI64(tr_song.speed + 1, 1, 31);
			return;
		case ',':
			//The tracker's own gain, separate from the DE's master volume and
			//remembered across song loads.
			tr.user_master	= ClampI64(tr.user_master - 8, 8, 256);
			tr.master		= tr.user_master;
			TrConfigSave;
			return;
		case '.':
			tr.user_master	= ClampI64(tr.user_master + 8, 8, 256);
			tr.master		= tr.user_master;
			TrConfigSave;
			return;
	}

	if (tr.edit)
		TrEditCell(key);
	else if (tr.cur_col == TR_COL_NOTE)
	{//Auditioning without editing.
		n = TrKeyNote(key);
		if (n >= 1 && n <= TR_NOTES)
			TrPreview(n, tr.inst, tr.vol_default);
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
}

U0 TrMenuPush()
{//Native ZealOS pull-down menu. Appears when the mouse reaches the top of the
//screen, or on the GUI key. Entry names are lexed as identifiers, so no spaces.
	MenuPush("File {"
			 "  New(MESSAGE_CMD,TRM_NEW);"
			 "  Load(MESSAGE_CMD,TRM_LOAD);"
			 "  SaveAs(MESSAGE_CMD,TRM_SAVE);"
			 "  LoadSample(MESSAGE_CMD,TRM_LOADSMP);"
			 "  Exit(MESSAGE_CMD,TRM_EXIT);"
			 "}"
			 "Play {"
			 "  Song(MESSAGE_CMD,TRM_PLAY_SONG);"
			 "  Pattern(MESSAGE_CMD,TRM_PLAY_PAT);"
			 "  Stop(MESSAGE_CMD,TRM_STOP);"
			 "  Follow(MESSAGE_CMD,TRM_FOLLOW);"
			 "}"
			 "Edit {"
			 "  EditMode(MESSAGE_CMD,TRM_EDIT);"
			 "  PrevPattern(MESSAGE_CMD,TRM_PAT_PREV);"
			 "  NextPattern(MESSAGE_CMD,TRM_PAT_NEXT);"
			 "  InsertRow(MESSAGE_CMD,TRM_INS_ROW);"
			 "  DeleteRow(MESSAGE_CMD,TRM_DEL_ROW);"
			 "  ClearCell(MESSAGE_CMD,TRM_CLR_CELL);"
			 "  MuteChannel(MESSAGE_CMD,TRM_MUTE);"
			 "}"
			 "View {"
			 "  PianoRoll(MESSAGE_CMD,TRM_VIEW_ROLL);"
			 "  Instruments(MESSAGE_CMD,TRM_PANE_INST);"
			 "  Order(MESSAGE_CMD,TRM_PANE_ORDER);"
			 "  Macros(MESSAGE_CMD,TRM_PANE_MACRO);"
			 "  Wavetables(MESSAGE_CMD,TRM_PANE_WAVE);"
			 "  Interpolate(MESSAGE_CMD,TRM_INTERP);"
			 "}"
			 "Help {"
			 "  Manual(MESSAGE_CMD,TRM_HELPDOC);"
			 "  Keys(MESSAGE_CMD,TRM_KEYS);"
			 "}");
	//WIG_USER_TASK_DEFAULT does not inhibit the menu, but a task spawned with
	//the system default would. Clear it either way.
	LBtr(&Fs->win_inhibit, WIf_FOCUS_TASK_MENU);
}

U0 TrMenuCheck(U8 *path, Bool on)
{
	CMenuEntry *e = MenuEntryFind(Fs->cur_menu, path);

	if (e)
		e->checked = on;
}

U0 TrMenuSync()
{//Mirror the toggles into the menu so the check marks are not stale when it
//opens. Cheap enough to run every frame.
	TrMenuCheck("Play/Follow", tr.follow);
	TrMenuCheck("Edit/EditMode", tr.edit);
	TrMenuCheck("View/PianoRoll", tr.view_mode == TR_VIEW_ROLL);
	TrMenuCheck("View/Interpolate", tr.interp);
	TrMenuCheck("View/Instruments", tr.pane == TR_PANE_INST);
	TrMenuCheck("View/Order", tr.pane == TR_PANE_ORDER);
	TrMenuCheck("View/Macros", tr.pane == TR_PANE_MACRO);
	TrMenuCheck("View/Wavetables", tr.pane == TR_PANE_WAVE);
	TrMenuCheck("Help/Keys", tr.pane == TR_PANE_HELP);
	TrMenuCheck("Edit/MuteChannel",
				tr_ch[ClampI64(tr.cur_ch, 0, TR_MAX_VOICES - 1)].mute);
}

U0 TrMenuCmd(I64 cmd)
{
	switch (cmd)
	{
		case TRM_NEW:
			TrMixSuspend;
			TrSongNew(4, 8, 64);
			TrMixResume;
			tr.cur_pat	= 0;
			tr.cur_row	= 0;
			tr.cur_ch	= 0;
			tr.order_sel = 0;
			TrStatus("New song: 4 channels, 8 patterns, 64 rows");
			break;
		case TRM_LOAD:		TrLoadAs;					break;
		case TRM_SAVE:		TrSaveAs;					break;
		case TRM_LOADSMP:	TrLoadSample;				break;
		case TRM_EXIT:		tr.quit = TRUE;				break;
		case TRM_PLAY_SONG:
			tr.pat_mode = FALSE;
			TrPlayStart(0, 0);
			break;
		case TRM_PLAY_PAT:
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			break;
		case TRM_STOP:		TrPlayStop;					break;
		case TRM_FOLLOW:	tr.follow = !tr.follow;		break;
		case TRM_EDIT:		tr.edit = !tr.edit;			break;
		case TRM_INS_ROW:	TrRowInsert(tr.cur_ch);		break;
		case TRM_DEL_ROW:	TrRowDelete(tr.cur_ch);		break;
		case TRM_CLR_CELL:	TrEditCell(CH_BACKSPACE);	break;
		case TRM_PANE_INST:	TrMenuPane(TR_PANE_INST);	break;
		case TRM_PANE_ORDER: TrMenuPane(TR_PANE_ORDER);	break;
		case TRM_KEYS:		TrMenuPane(TR_PANE_HELP);	break;
		case TRM_PANE_MACRO: TrMenuPane(TR_PANE_MACRO);	break;
		case TRM_PANE_WAVE:	TrMenuPane(TR_PANE_WAVE);	break;
		case TRM_HELPDOC:
			//The manual is a DolDoc; open it in a pop-up editor the way
			//Psalmody opens its help, then take focus back.
			PopUpEd("::/Doc/Tracker.DD", Fs);
			WinFocus(tr.win_task);
			break;
		case TRM_INTERP:	tr.interp = !tr.interp;		break;
		case TRM_VIEW_ROLL:	TrViewToggle;	break;
		case TRM_PAT_PREV:
			tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			break;
		case TRM_PAT_NEXT:
			tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			break;
		case TRM_MUTE:
			if (0 <= tr.cur_ch < tr_song.channels)
				tr_ch[tr.cur_ch].mute = !tr_ch[tr.cur_ch].mute;
			break;
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
}
