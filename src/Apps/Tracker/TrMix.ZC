//TrMix.ZC - sample mixer and tick sequencer. Depends on TrDef, TrSmp.
//
//Timing follows the Amiga model: tempo is ticks per row (speed) and rows per
//minute (bpm); one tick lasts TR_RATE * 2.5 / bpm output frames. Row data is
//read on tick 0, continuous effects run on every later tick.

U0 TrMasterDefault()
{//Master is independent of channel count. Scaling by 1/channels assumes every
//channel peaks at once and in phase, which no music does; against libopenmpt
//it left 30-channel songs 20 dB down while 6-channel songs clipped. Fitting
//the level error of 39 modules gives an exponent of -0.12, i.e. constant.
//
//Per-song level lives in tr_song.mix_vol instead, which is what the formats
//carry it in. 176 centres the residual near 0 dB across all four formats;
//loud songs reaching full scale is expected, as the reference does the same.
	if (tr.user_master < 1)
		tr.user_master = TR_MASTER_DEFAULT;
	tr.master = tr.user_master;
}

U0 TrChanInit(I64 ch)
{
	CTrChan *c = &tr_ch[ch];

	MemSet(c, 0, sizeof(CTrChan));
	c->vol			= 64;
	c->mix_vol		= 64;
	c->chan_vol		= tr_chan_vol[ClampI64(ch, 0, TR_MAX_VOICES - 1)];
	c->fade_vol		= 32768;
	c->key_on		= FALSE;
	c->owner		= -1;
	c->period		= TR_PERIOD_MAX;
	c->sound_period	= TR_PERIOD_MAX;
	c->delay_ticks	= -1;
	c->cut_tick		= -1;
	c->loop_row		= 0;
	c->macro_wave	= -1;
	c->duty			= -1;
	c->fine_pitch	= 0;
	c->fds_depth	= 0;
	c->fds_rate		= 0;
	c->fds_pos		= 0;
	c->pan			= tr_chan_pan[ClampI64(ch, 0, TR_MAX_VOICES - 1)];
	c->mix_pan		= c->pan;
}

U0 TrChanPanDefault(Bool amiga)
{//MOD and S3M pan LRRL; XM and IT start every channel centred. Softened to a
//3/4 throw: full separation is unlistenable on headphones.
	I64 ch;

	for (ch = 0; ch < TR_MAX_VOICES; ch++)
	{
		if (!amiga)
			tr_chan_pan[ch] = 128;
		else if (ch % 4 == 0 || ch % 4 == 3)
			tr_chan_pan[ch] = 64;
		else
			tr_chan_pan[ch] = 192;
		//Only IT carries per-channel volume; every loader passes through here,
		//so full volume is the default the others keep.
		tr_chan_vol[ch] = 64;
	}
}

U0 TrChansInit()
{
	I64 ch;

	for (ch = 0; ch < TR_MAX_VOICES; ch++)
		TrChanInit(ch);
}

I64 TrWaveDelta(I64 wave, I64 pos, I64 depth, I64 div)
{//ProTracker vibrato/tremolo generator. div is 128 for vibrato, 64 for
//tremolo. Waveform 3 (random) falls back to sine.
	I64 v;

	pos &= 63;
	switch (wave & 3)
	{
		case 1:		//Ramp down.
			v = (pos & 31) * 8;
			break;
		case 2:		//Square.
			v = 255;
			break;
		default:
			v = tr_sine_tab[pos & 31];
	}
	v = v * depth / div;
	if (pos >= 32)
		v = -v;

	return v;
}

U0 TrChanStep(CTrChan *c)
{//Recompute the resample rate from the period actually sounding.
	I64 mul = 65536;

	if (c->smp)
		mul = c->smp->step_mul;
	c->step_fp = TrStepFP(c->sound_period, mul);
}

U0 TrChanTrigger(CTrChan *c, I64 offset)
{//Restart the sample. offset is in frames (effect 9xx).
	CTrSample *s = c->smp;

	if (!s || !s->data || s->len < 1)
	{
		c->active = FALSE;
		return;
	}
	if (offset >= s->len)
	{
		if (s->loop_len > 1 && s->loop_type != TR_LOOP_NONE)
			offset = s->loop_start;
		else
		{//ProTracker leaves the channel silent when 9xx overruns the sample.
			c->active = FALSE;
			return;
		}
	}
	c->pos_fp	 = offset << TR_POS_SHIFT;
	c->backwards = FALSE;
	c->active	 = TRUE;
	//The mixer pans by mix_pan, which only the tick recomputes. Note preview
	//and any other trigger outside the sequencer would otherwise mix with a
	//stale value.
	c->mix_pan	 = c->pan;
}

U0 TrMixFrames(I64 n)
{//Channel-outer so per-channel state stays in registers across the run.
	I64	 ch, i, idx, frac, s, s1, vl, vr, pos, step, pk, v;
	I64	 slen, lstart, llen, lend, l, r, mono;
	CTrChan	  *c;
	CTrSample *sm;

	if (n < 1)
		return;
	MemSet(tr_mix_l, 0, n * sizeof(I64));
	MemSet(tr_mix_r, 0, n * sizeof(I64));

	//Every voice mixes, not just the pattern channels: an IT new-note action
	//moves a still-sounding note onto a background voice.
	for (ch = 0; ch < TR_MAX_VOICES; ch++)
	{
		c  = &tr_ch[ch];
		sm = c->smp;
		if (c->active && sm && sm->data && !c->mute && c->mix_vol > 0)
		{
			pos	   = c->pos_fp;
			step   = c->step_fp;
			slen   = sm->len;
			lstart = sm->loop_start;
			llen   = sm->loop_len;
			if (sm->loop_type == TR_LOOP_NONE)
				llen = 0;
			lend = lstart + llen;
			if (lend > slen)
				lend = slen;
			vl = c->mix_vol * (255 - c->mix_pan) * tr.master / 256;
			vr = c->mix_vol * c->mix_pan * tr.master / 256;
			pk = 0;
			i  = 0;
			while (i < n && c->active)
			{
				idx = pos >> TR_POS_SHIFT;
				if (idx < 0 || idx >= slen)
					c->active = FALSE;
				else
				{
					s = sm->data[idx];
					if (tr.interp)
					{
						s1	 = sm->data[idx + 1];
						frac = (pos >> 16) & 0xFFFF;
						s	 = s + ((s1 - s) * frac) / 65536;
					}
					tr_mix_l[i] += s * vl;
					tr_mix_r[i] += s * vr;
					v = s;
					if (v < 0)
						v = -v;
					if (v > pk)
						pk = v;
					if (c->backwards)
						pos -= step;
					else
						pos += step;
					if (llen > 1)
					{
						if (c->backwards)
						{
							if ((pos >> TR_POS_SHIFT) < lstart)
							{
								pos = (lstart << TR_POS_SHIFT) * 2 - pos;
								c->backwards = FALSE;
							}
						}
						else if ((pos >> TR_POS_SHIFT) >= lend)
						{
							if (sm->loop_type == TR_LOOP_PINGPONG)
							{
								pos = ((lend - 1) << TR_POS_SHIFT) * 2 - pos;
								c->backwards = TRUE;
							}
							else
								pos -= (lend - lstart) << TR_POS_SHIFT;
						}
					}
					else if ((pos >> TR_POS_SHIFT) >= slen)
						c->active = FALSE;
					i++;
				}
			}
			c->pos_fp = pos;
			c->peak	  = pk * c->mix_vol / 64;
		}
		else
			c->peak = c->peak * 3 / 4;
	}

	for (i = 0; i < n; i++)
	{
		l = tr_mix_l[i] >> TR_MIX_SHIFT;
		r = tr_mix_r[i] >> TR_MIX_SHIFT;
		l = ClampI64(l, -32767, 32767);
		r = ClampI64(r, -32767, 32767);
		FifoI64Ins(audio.output[tr.stream].data,
				   (l & 0xFFFF) | ((r & 0xFFFF) << 16));
		mono = (l + r) / 2;
		tr.scope[tr.scope_pos & (TR_SCOPE_N - 1)] = mono;
		tr.scope_pos++;
	}
	tr_play.frames_out += n;
}

I64 TrSlideDelta(I64 param, I64 tick)
{//Dxy-family decode shared by the volume, channel volume, global volume and
//panning slides. Fine forms act once on tick 0, continuous ones on later
//ticks only, matching ProTracker's rule that tick 0 never slides.
	I64 x = param >> 4, y = param & 0x0F;

	if (tr_song.fine_slides)
	{
		if (x == 0x0F && y != 0)
		{//DFx, fine down.
			if (!tick)
				return -y;
			return 0;
		}
		if (y == 0x0F && x != 0)
		{//DxF, fine up.
			if (!tick)
				return x;
			return 0;
		}
	}
	if (!tick)
		return 0;
	if (x)
		return x;

	return -y;
}

U0 TrEffVolSlide(CTrChan *c, I64 param, I64 tick)
{
	c->vol = ClampI64(c->vol + TrSlideDelta(param, tick), 0, 64);
}

U0 TrEffTonePorta(CTrChan *c)
{
	I64 speed = c->porta_speed * TR_PERIOD_SCALE;

	if (!c->dest_period)
		return;
	if (c->period < c->dest_period)
	{
		c->period += speed;
		if (c->period > c->dest_period)
			c->period = c->dest_period;
	}
	else if (c->period > c->dest_period)
	{
		c->period -= speed;
		if (c->period < c->dest_period)
			c->period = c->dest_period;
	}
	if (c->glissando)
		c->period = TrNotePeriod(TrPeriodNote(c->period, c->finetune),
								 c->finetune);
}

I64 TrMacroValue(CTrMacro *m, I64 pos)
{//Held at the last step once the sequence runs out.
	if (m->len < 1)
		return 0;

	return m->val[ClampI64(pos, 0, m->len - 1)];
}

U0 TrMacroStep(CTrMacro *m, I64 *pos, Bool key_on)
{//One tick. While the key is down the sequence loops within the section
//before the release point; after key off it runs to the end and holds.
	if (m->len < 1)
		return;
	*pos = *pos + 1;
	if (key_on && m->release >= 0 && m->release < m->len)
	{
		if (*pos >= m->release)
		{
			if (m->loop >= 0 && m->loop < m->release)
				*pos = m->loop;
			else
				*pos = m->release - 1;
		}
	}
	else if (*pos >= m->len)
	{
		if (key_on && m->loop >= 0 && m->loop < m->len)
			*pos = m->loop;
		else
			*pos = m->len - 1;
	}
}

I64 TrBankSample(CTrInst *ins, I64 entry)
{//Sample slot for a bank entry, or 0 if the instrument has no bank.
	if (!ins)
		return 0;
	if (ins->bank == TR_BANK_DUTY)
		return tr_duty_slot[ClampI64(entry, 0, TR_DUTY_COUNT - 1)];
	if (ins->bank == TR_BANK_WAVE)
		return tr_wave_slot[ClampI64(entry, 0, TR_WAVE_SLOTS - 1)];
	if (ins->bank == TR_BANK_NOISE)
		return tr_noise_slot[ClampI64(entry, 0, TR_NOISE_MODES - 1)];
	if (ins->bank == TR_BANK_V6DUTY)
		return tr_v6duty_slot[ClampI64(entry, 0, TR_V6DUTY_COUNT - 1)];
	if (ins->bank == TR_BANK_S5B)
		return tr_s5b_slot[ClampI64(entry, 0, TR_S5B_MODES - 1)];
	if (ins->bank == TR_BANK_INST)
	{
		if (ins->bank_n < 1)
			return 0;
		return ins->bank_slot[ClampI64(entry, 0, ins->bank_n - 1)];
	}

	return 0;
}

U0 TrMacroApply(CTrChan *c)
{//Runs after the pattern effects and before the envelopes, so a macro sets
//the level the envelopes then scale. Every bank wave is TR_WAVE_LEN frames,
//so switching waveform mid-note keeps the phase.
	CTrInst	*ins = c->ins;
	CTrMacro *m;
	I64		 v, slot;

	if (!ins)
		return;

	m = &ins->macro[TR_MACRO_VOL];
	if (m->len > 0)
	{
		v = TrMacroValue(m, c->macro_pos[TR_MACRO_VOL]);
		c->mix_vol = c->mix_vol * ClampI64(v, 0, 64) / 64;
	}

	m = &ins->macro[TR_MACRO_ARP];
	if (m->len > 0)
	{
		v = TrMacroValue(m, c->macro_pos[TR_MACRO_ARP]);
		if (m->mode == TR_ARP_FIXED)
			c->sound_period = TrPitchPeriod(ClampI64(v + 1, 1, TR_NOTES),
											c->finetune);
		else
			c->sound_period = TrPitchPeriod(ClampI64(c->note + v, 1, TR_NOTES),
											c->finetune);
	}

	m = &ins->macro[TR_MACRO_PITCH];
	if (m->len > 0)
	{
		//Accumulates: the macro gives a per-tick delta, not a position.
		c->macro_pitch += TrMacroValue(m, c->macro_pos[TR_MACRO_PITCH]);
		c->sound_period -= c->macro_pitch;
	}

	//The duty sequence wins while it runs; Vxx sets what plays without one.
	m = &ins->macro[TR_MACRO_DUTY];
	if (ins->bank != TR_BANK_NONE)
	{
		v = -1;
		if (m->len > 0)
			v = TrMacroValue(m, c->macro_pos[TR_MACRO_DUTY]);
		else if (c->duty >= 0)
			v = c->duty;
		if (v >= 0 && v != c->macro_wave)
		{
			slot = TrBankSample(ins, v);
			if (slot > 0 && slot < TR_MAX_SAMPLES && tr_smp[slot].data)
			{
				c->smp		= &tr_smp[slot];
				c->smp_idx	= slot;
				c->macro_wave = v;
			}
		}
	}

	for (v = 0; v < TR_MACRO_COUNT; v++)
		TrMacroStep(&ins->macro[v], &c->macro_pos[v], c->key_on);
}

U0 TrEffRetrigVol(CTrChan *c, I64 x)
{//Rxy / Qxy volume change applied on each retrigger.
	switch (x)
	{
		case 1:	c->vol -= 1;			break;
		case 2:	c->vol -= 2;			break;
		case 3:	c->vol -= 4;			break;
		case 4:	c->vol -= 8;			break;
		case 5:	c->vol -= 16;			break;
		case 6:	c->vol = c->vol * 2 / 3;	break;
		case 7:	c->vol = c->vol / 2;	break;
		case 9:	c->vol += 1;			break;
		case 0xA: c->vol += 2;			break;
		case 0xB: c->vol += 4;			break;
		case 0xC: c->vol += 8;			break;
		case 0xD: c->vol += 16;			break;
		case 0xE: c->vol = c->vol * 3 / 2;	break;
		case 0xF: c->vol = c->vol * 2;	break;
	}
	c->vol = ClampI64(c->vol, 0, 64);
}

I64 TrEnvValue(CTrEnvelope *e, I64 pos)
{//Linear between the bracketing points, held past the last one. -1 means the
//envelope carries no value and the caller should leave its input alone.
	I64 i, x0, x1, y0, y1;

	if (e->n_points < 1)
		return -1;
	if (pos <= e->tick[0])
		return e->value[0];
	for (i = 0; i < e->n_points - 1; i++)
	{
		x0 = e->tick[i];
		x1 = e->tick[i + 1];
		if (x0 <= pos && pos < x1)
		{
			y0 = e->value[i];
			y1 = e->value[i + 1];
			if (x1 <= x0)
				return y0;
			return y0 + (y1 - y0) * (pos - x0) / (x1 - x0);
		}
	}

	return e->value[e->n_points - 1];
}

I64 TrEnvStep(CTrEnvelope *e, I64 pos, Bool key_on)
{//One tick of envelope position. Sustain freezes while the key is down; the
//loop jumps back at its end point. XM increments before the point is read, so
//callers evaluate first and step after.
	if (!(e->flags & TR_ENV_ON) || e->n_points < 1)
		return pos;
	if (key_on && e->flags & TR_ENV_SUSTAIN && e->sus_start < e->n_points &&
		pos >= e->tick[e->sus_start])
		return e->tick[e->sus_start];
	pos++;
	if (e->flags & TR_ENV_LOOP && e->loop_end < e->n_points &&
		e->loop_start < e->n_points && pos >= e->tick[e->loop_end])
		pos = e->tick[e->loop_start];

	return pos;
}

I64 TrVoiceAlloc()
{//A background voice for an IT new-note action: first idle one, else the
//quietest background voice. Foreground channels are never stolen.
	I64 i, best = -1, quietest = 0x7FFFFFFF;

	for (i = tr_song.channels; i < TR_MAX_VOICES; i++)
		if (!tr_ch[i].active)
			return i;
	for (i = tr_song.channels; i < TR_MAX_VOICES; i++)
		if (tr_ch[i].background && tr_ch[i].mix_vol < quietest)
		{
			quietest = tr_ch[i].mix_vol;
			best	 = i;
		}

	return best;
}

U0 TrNNA(I64 ch, I64 new_note, I64 new_smp)
{//Move the sounding note onto a background voice so the pattern channel is
//free. Note-off and note-fade both clear key_on, which is what starts the
//fade; they differ only in whether an envelope loop can still hold the note.
	CTrChan	*c = &tr_ch[ch], *b;
	I64		 v, i;

	if (!c->active || !c->ins)
		return;
	//Duplicate check runs against voices this channel already backgrounded,
	//before the new one joins them.
	if (c->ins->dct != TR_DCT_OFF)
		for (i = tr_song.channels; i < TR_MAX_VOICES; i++)
		{
			b = &tr_ch[i];
			if (b->active && b->background && b->owner == ch &&
				((c->ins->dct == TR_DCT_NOTE && b->note == new_note) ||
				 (c->ins->dct == TR_DCT_SAMPLE && b->smp_idx == new_smp) ||
				 (c->ins->dct == TR_DCT_INST && b->inst == c->inst)))
			{
				if (c->ins->dca == TR_DCA_CUT)
					b->active = FALSE;
				else
					b->key_on = FALSE;
			}
		}
	if (c->ins->nna == TR_NNA_CUT)
		return;
	v = TrVoiceAlloc();
	if (v < 0)
		return;			//Pool exhausted: the old note is cut instead.
	b = &tr_ch[v];
	MemCopy(b, c, sizeof(CTrChan));
	b->background	= TRUE;
	b->owner		= ch;
	b->mute			= FALSE;
	if (c->ins->nna != TR_NNA_CONTINUE)
		b->key_on = FALSE;
}

U0 TrRowChannel(I64 ch, CTrCell *cell)
{//Tick 0 of a row: latch instrument, note and effect.
	CTrChan	*c = &tr_ch[ch];
	I64		 note, eff, param, sub, target, off, ft, ins, smp, play_note, n;
	Bool	 porta;

	note  = cell->note;
	eff	  = cell->eff;
	param = cell->param;
	sub	  = param & 0x0F;
	porta = eff == TRX_TONE_PORTA || eff == TRX_PORTA_VOLSLIDE;

	c->eff			= eff;
	c->param		= param;
	c->delay_ticks	= -1;
	c->cut_tick		= -1;

	//Instrument column selects the instrument and resets volume, even with no
	//note. Amiga behaviour, relied on by countless modules. The sample the
	//instrument resolves to depends on the note, so that happens at note-on.
	//Widen to I64 first: comparing a U8 member against a constant that does
	//not fit in 8 bits makes the whole test false in ZealC.
	ins = cell->inst;
	if (ins > 0 && ins < TR_MAX_INSTRUMENTS)
	{
		c->inst		= ins;
		c->ins		= tr_inst[ins];
		//Channel volume is a property of the channel, not the note: Mxx holds
		//until another Mxx or Nxy changes it.
		//Without an instrument record the slot maps straight to the sample,
		//which is what MOD and S3M want. Resolve now so a bare instrument
		//column still latches the default volume.
		smp = TrInstSample(ins, c->note, &play_note);
		if (smp > 0 && smp < TR_MAX_SAMPLES && tr_smp[smp].data)
		{
			c->smp		= &tr_smp[smp];
			c->smp_idx	= smp;
			c->vol		= c->smp->volume;
			c->finetune	= c->smp->finetune;
			if (c->smp->pan >= 0)
				c->pan = c->smp->pan;
		}
		else
			c->smp = NULL;
		if (c->ins && c->ins->default_pan >= 0)
			c->pan = c->ins->default_pan;
	}

	//E5x retunes before the period is computed from the note.
	if (eff == TRX_EXTENDED && (param >> 4) == 0x5)
	{
		ft = sub;
		if (ft > 7)
			ft -= 16;
		c->finetune = ft;
	}

	if (note == TR_NOTE_CUT)
	{
		c->vol	  = 0;
		c->active = FALSE;
		note	  = 0;
	}
	else if (note == TR_NOTE_OFF)
	{//Release. With no volume envelope there is nothing to fade, so FT2 cuts.
		c->key_on = FALSE;
		if (c->ins)
			for (n = 0; n < TR_MACRO_COUNT; n++)
				if (c->ins->macro[n].release >= 0)
					c->macro_pos[n] = c->ins->macro[n].release;
		if (!c->ins || !(c->ins->vol_env.flags & TR_ENV_ON))
		{
			c->vol	  = 0;
			c->active = FALSE;
		}
		note = 0;
	}
	else if (note == TR_NOTE_FADE)
	{
		c->key_on = FALSE;
		note	  = 0;
	}

	if (note)
	{
		//Resolve the instrument's sample for THIS note before anything reads
		//rel_note: XM and IT map each note to a different sample.
		play_note = note;
		if (c->inst)
		{
			smp = TrInstSample(c->inst, note, &play_note);
			if (smp > 0 && smp < TR_MAX_SAMPLES && tr_smp[smp].data)
			{
				if (!porta)
				{
					c->smp		= &tr_smp[smp];
					c->smp_idx	= smp;
				}
			}
			else if (!porta)
				c->smp = NULL;
		}
		c->note = note;
		if (c->smp)
			target = TrPitchPeriod(ClampI64(play_note + c->smp->rel_note,
											1, TR_NOTES), c->finetune);
		else
			target = TrPitchPeriod(play_note, c->finetune);
		if (porta)
			c->dest_period = target;
		else if (eff == TRX_EXTENDED && (param >> 4) == 0xD && sub)
		{//EDx: hold the note until the given tick.
			c->delay_ticks	= sub;
			c->delay_note	= note;
			c->delay_inst	= cell->inst;
		}
		else
		{
			//The previous note leaves the channel before the new one lands.
			//Without an instrument record this is a no-op, so MOD is unchanged.
			TrNNA(ch, note, smp);
			c->period		= target;
			c->dest_period	= target;
			off				= 0;
			if (eff == TRX_OFFSET)
			{
				if (param)
					c->offset_mem = param;
				off = c->offset_mem * 256;
			}
			TrChanTrigger(c, off);
			c->background	= FALSE;
			c->owner		= -1;
			c->key_on		= TRUE;
			c->fade_vol		= 32768;
			c->sustained	= FALSE;
			//Envelope carry is not implemented; every note restarts them.
			c->vol_env_pos	= 0;
			c->pan_env_pos	= 0;
			c->pitch_env_pos = 0;
			for (n = 0; n < TR_MACRO_COUNT; n++)
				c->macro_pos[n] = 0;
			c->macro_pitch	= 0;
			c->macro_wave	= -1;
			c->avib_pos		= 0;
			c->avib_sweep	= 0;
			if (c->vib_wave < 4)
				c->vib_pos = 0;
			if (c->trem_wave < 4)
				c->trem_pos = 0;
		}
	}

	//Volume column. Only TRV_SET reaches here from MOD and S3M; the slide
	//and vibrato forms are XM and IT and run again on later ticks.
	switch (cell->volcmd)
	{
		case TRV_SET:
			c->vol = ClampI64(cell->volparam, 0, 64);
			break;
		case TRV_SET_PAN:
			c->pan = ClampI64(cell->volparam * 4, 0, 255);
			break;
		case TRV_FINE_UP:
			c->vol = ClampI64(c->vol + cell->volparam, 0, 64);
			break;
		case TRV_FINE_DOWN:
			c->vol = ClampI64(c->vol - cell->volparam, 0, 64);
			break;
		case TRV_VIB_SPEED:
			if (cell->volparam)
				c->vib_speed = cell->volparam;
			break;
		case TRV_VIB_DEPTH:
			if (cell->volparam)
				c->vib_depth = cell->volparam;
			break;
		case TRV_TONE_PORTA:
			if (cell->volparam)
				c->porta_speed = cell->volparam;
			break;
	}

	switch (eff)
	{
		case TRX_TONE_PORTA:
			if (param)
				c->porta_speed = param;
			break;
		case TRX_PORTA_VOLSLIDE:
			break;			//Slide param belongs to the volume slide.
		case TRX_VIBRATO:
			if (param >> 4)
				c->vib_speed = param >> 4;
			if (sub)
				c->vib_depth = sub;
			break;
		case TRX_TREMOLO:
			if (param >> 4)
				c->trem_speed = param >> 4;
			if (sub)
				c->trem_depth = sub;
			break;
		case TRX_SET_PAN:
			c->pan = ClampI64(param, 0, 255);
			break;
		case TRX_SET_VOL:
			c->vol = ClampI64(param, 0, 64);
			break;
		case TRX_POS_JUMP:
			tr_play.jump_order = param;
			break;
		case TRX_PAT_BREAK:
			//Param is two decimal digits, not hex.
			tr_play.break_row = (param >> 4) * 10 + sub;
			break;
		case TRX_SET_SPEED:
			if (!param)
				tr_play.ended = TRUE;
			else if (param < 0x20)
			{//An Fxx that sets speed cancels the groove for the rest of the
			//track, not just for this row. Only another Oxx or a restart
			//brings it back. An Fxx that sets tempo leaves it running.
				tr_song.speed	= param;
				tr_groove_idx	= -1;
			}
			else
				tr_song.bpm = param;
			break;
		case TRX_SET_TEMPO:
			//S3M and IT split speed and tempo; below 0x20 is a tempo slide.
			if (param >= 0x20)
				tr_song.bpm = param;
			break;
		case TRX_GLOBAL_VOL:
			tr_song.global_vol = ClampI64(param, 0, 128);
			break;
		case TRX_CHANNEL_VOL:
			c->chan_vol = ClampI64(param, 0, 64);
			break;
		case TRX_GROOVE:
			//Oxx always enters at entry 0; an empty slot is ignored outright.
			n = param & (TR_GROOVES - 1);
			if (tr_groove_len[n] > 0)
			{
				tr_groove_idx	= n;
				tr_groove_pos	= 1;
				tr_song.speed	= tr_groove[n][0];
				if (tr_song.speed < 1)
					tr_song.speed = 6;
			}
			break;
		case TRX_SET_DUTY:
			//Sets the channel's bank entry and holds until the next Vxx. The
			//bank decides what an entry means: a pulse width, or the noise
			//LFSR mode.
			c->duty = param;
			break;
		case TRX_NOTE_SLIDE_UP:
		case TRX_NOTE_SLIDE_DN:
			//Qxy and Rxy: glide y semitones from the note now sounding, at
			//speed x. Runs on the tone portamento path, so only the target
			//and speed are set here.
			n = ClampI64(param & 0x0F, 0, 15);
			if (eff == TRX_NOTE_SLIDE_DN)
				n = -n;
			n = ClampI64(c->note + n, 1, TR_NOTES);
			c->dest_period = TrPitchPeriod(n, c->finetune);
			c->porta_speed = ClampI64(param >> 4, 1, 15);
			break;
		case TRX_FINE_PITCH:
			//Pxx detunes the channel, 0x80 centre. Held until changed.
			c->fine_pitch = 0x80 - param;
			break;
		case TRX_FDS_DEPTH:
			c->fds_depth = ClampI64(param, 0, 63);
			break;
		case TRX_FDS_RATE_HI:
			c->fds_rate = (c->fds_rate & 0xFF) | ((param & 0x0F) << 8);
			break;
		case TRX_FDS_RATE_LO:
			c->fds_rate = (c->fds_rate & 0xF00) | (param & 0xFF);
			break;
		case TRX_KEY_OFF:
			if (!param)
			{
				c->key_on = FALSE;
				if (!c->ins || !(c->ins->vol_env.flags & TR_ENV_ON))
				{
					c->vol	  = 0;
					c->active = FALSE;
				}
			}
			break;
		case TRX_ENV_POS:
			c->vol_env_pos = param;
			break;
		case TRX_PANBRELLO:
			if (param >> 4)
				c->pan_speed = param >> 4;
			if (sub)
				c->pan_depth = sub;
			break;
		case TRX_TREMOR:
			if (param)
				c->tremor_mem = param;
			c->tremor_pos = 0;
			break;
		case TRX_MULTI_RETRIG:
			if (sub)
				c->retrig_mem = sub;
			break;
		case TRX_FINE_VIBRATO:
			if (param >> 4)
				c->vib_speed = param >> 4;
			if (sub)
				c->vib_depth = sub;
			break;
		case TRX_XFINE_PORTA_UP:
			c->period -= sub * TR_PERIOD_SCALE / 4;
			break;
		case TRX_XFINE_PORTA_DN:
			c->period += sub * TR_PERIOD_SCALE / 4;
			break;
		case TRX_EXTENDED:
			switch (param >> 4)
			{
				case 0x1:	//Fine portamento up.
					if (sub)
						c->fine_up_mem = sub;
					c->period -= c->fine_up_mem * TR_PERIOD_SCALE;
					break;
				case 0x2:	//Fine portamento down.
					if (sub)
						c->fine_dn_mem = sub;
					c->period += c->fine_dn_mem * TR_PERIOD_SCALE;
					break;
				case 0x3:
					c->glissando = sub != 0;
					break;
				case 0x4:
					c->vib_wave = sub;
					break;
				case 0x6:	//Pattern loop.
					if (!sub)
						c->loop_row = tr_play.row;
					else
					{
						if (!c->loop_count)
							c->loop_count = sub;
						else
							c->loop_count--;
						if (c->loop_count)
							tr_play.loop_jump = c->loop_row;
					}
					break;
				case 0x7:
					c->trem_wave = sub;
					break;
				case 0x8:	//Coarse pan, 0..15 spread over 0..255.
					c->pan = sub * 17;
					break;
				case 0x9:	//Retrigger.
					if (sub)
						c->retrig_mem = sub;
					break;
				case 0xA:	//Fine volume up.
					if (sub)
						c->finevol_mem = sub;
					c->vol = ClampI64(c->vol + c->finevol_mem, 0, 64);
					break;
				case 0xB:	//Fine volume down.
					if (sub)
						c->finevol_mem = sub;
					c->vol = ClampI64(c->vol - c->finevol_mem, 0, 64);
					break;
				case 0xC:
					c->cut_tick = sub;
					break;
				case 0xE:	//Pattern delay, in rows.
					if (sub)
						tr_play.pat_delay = sub;
					break;
			}
			break;
	}
}

U0 TrTickChannel(I64 ch, I64 tick)
{//Ticks 1..speed-1, plus the deferred triggers scheduled on tick 0.
	CTrChan *c = &tr_ch[ch];
	I64		 eff = c->eff, param = c->param, sub = param & 0x0F, n, mv;

	if (c->delay_ticks >= 0 && tick >= c->delay_ticks)
	{
		if (c->delay_inst && c->delay_inst < TR_MAX_SAMPLES)
		{
			c->smp = &tr_smp[c->delay_inst];
			if (c->smp->data)
			{
				c->vol		= c->smp->volume;
				c->finetune	= c->smp->finetune;
			}
		}
		c->period		= TrNotePeriod(c->delay_note, c->finetune);
		c->dest_period	= c->period;
		c->delay_ticks	= -1;
		TrChanTrigger(c, 0);
	}
	if (c->cut_tick >= 0 && tick >= c->cut_tick)
	{
		c->vol		= 0;
		c->cut_tick	= -1;
	}

	if (tick)
		switch (eff)
		{
			case TRX_ARPEGGIO:
				break;		//Handled below; it needs the tick index.
			case TRX_PORTA_UP:
				c->period -= param * TR_PERIOD_SCALE;
				break;
			case TRX_PORTA_DOWN:
				c->period += param * TR_PERIOD_SCALE;
				break;
			case TRX_TONE_PORTA:
				TrEffTonePorta(c);
				break;
			case TRX_NOTE_SLIDE_UP:
				TrEffTonePorta(c);
				break;
			case TRX_NOTE_SLIDE_DN:
				TrEffTonePorta(c);
				break;
			case TRX_VIBRATO:
				c->vib_pos += c->vib_speed;
				break;
			case TRX_PORTA_VOLSLIDE:
				TrEffTonePorta(c);
				break;
			case TRX_VIB_VOLSLIDE:
				c->vib_pos += c->vib_speed;
				break;
			case TRX_TREMOLO:
				c->trem_pos += c->trem_speed;
				break;
			case TRX_VOLSLIDE:
				break;		//Handled every tick, below.
			case TRX_GLOBAL_VOLSLIDE:
			case TRX_CHANNEL_VOLSLIDE:
			case TRX_PAN_SLIDE:
				break;		//Handled every tick, including tick 0, below.
			case TRX_PANBRELLO:
				c->pan_pos += c->pan_speed;
				break;
			case TRX_FINE_VIBRATO:
				c->vib_pos += c->vib_speed;
				break;
			case TRX_TREMOR:
				c->tremor_pos++;
				break;
			case TRX_MULTI_RETRIG:
				if (c->retrig_mem && tick % c->retrig_mem == 0)
				{
					TrChanTrigger(c, 0);
					TrEffRetrigVol(c, param >> 4);
				}
				break;
			case TRX_EXTENDED:
				if ((param >> 4) == 0x9 && c->retrig_mem)
				{
					n = c->retrig_mem;
					if (tick % n == 0)
						TrChanTrigger(c, 0);
				}
				break;
		}

	//Slides that carry fine forms run on every tick; TrSlideDelta decides
	//whether this particular tick does anything.
	if (eff == TRX_VOLSLIDE || eff == TRX_PORTA_VOLSLIDE ||
		eff == TRX_VIB_VOLSLIDE)
		TrEffVolSlide(c, param, tick);
	else if (eff == TRX_GLOBAL_VOLSLIDE)
		tr_song.global_vol = ClampI64(tr_song.global_vol +
									  TrSlideDelta(param, tick), 0, 128);
	else if (eff == TRX_CHANNEL_VOLSLIDE)
		c->chan_vol = ClampI64(c->chan_vol + TrSlideDelta(param, tick), 0, 64);
	else if (eff == TRX_PAN_SLIDE)
		//FT2 inverts the nibbles here, so the sign is flipped against volume.
		c->pan = ClampI64(c->pan - TrSlideDelta(param, tick), 0, 255);

	c->period		= ClampI64(c->period, TR_PERIOD_MIN, TR_PERIOD_MAX);
	c->sound_period	= c->period;
	c->mix_vol		= c->vol;

	if (eff == TRX_ARPEGGIO && param)
	{
		n = tick % 3;
		if (n == 1)
			c->sound_period = TrNotePeriod(c->note + (param >> 4),
										   c->finetune);
		else if (n == 2)
			c->sound_period = TrNotePeriod(c->note + sub, c->finetune);
	}
	if (eff == TRX_VIBRATO || eff == TRX_VIB_VOLSLIDE)
		c->sound_period += TrWaveDelta(c->vib_wave, c->vib_pos,
									   c->vib_depth, 128) * TR_PERIOD_SCALE;
	//FDS modulator. On the chip this is frequency modulation by a 64-entry
	//table clocked against the carrier, which at audio rate rewrites the
	//timbre; a single-cycle sample cannot carry that. What survives here is
	//the musical use, a pitch LFO, so it is applied as one. It runs whether or
	//not it is the current effect, because Hxx, Ixx and Jxx set it and then
	//other effects take the column.
	if (c->fds_depth > 0 && c->fds_rate > 0)
	{
		c->fds_pos += c->fds_rate / 64;
		c->sound_period += TrWaveDelta(0, c->fds_pos / 4, c->fds_depth / 4,
									   128) * TR_PERIOD_SCALE;
	}
	if (eff == TRX_TREMOLO)
		c->mix_vol = ClampI64(c->vol + TrWaveDelta(c->trem_wave, c->trem_pos,
												   c->trem_depth, 64), 0, 64);
	if (eff == TRX_FINE_VIBRATO)
		c->sound_period += TrWaveDelta(c->vib_wave, c->vib_pos,
									   c->vib_depth, 128) * TR_PERIOD_SCALE / 4;
	if (eff == TRX_TREMOR && c->tremor_mem)
	{//On for x+1 ticks, off for y+1, repeating.
		n = (c->tremor_mem >> 4) + 1;
		if (c->tremor_pos % (n + (c->tremor_mem & 0x0F) + 1) >= n)
			c->mix_vol = 0;
	}
	if (eff == TRX_PANBRELLO)
		c->pan = ClampI64(c->pan + TrWaveDelta(c->pan_wave, c->pan_pos,
											   c->pan_depth, 64), 0, 255);
	//Instrument layer. Everything above produced the pattern's idea of volume
	//and pan; envelopes, fadeout and the volume chain scale it. Accumulate at
	//4096x so six successive divides do not quantise the result to steps of
	//1/64.
	TrMacroApply(c);
	mv			= c->mix_vol * 4096;
	c->mix_pan	= c->pan;
	if (c->ins)
	{
		if (c->ins->vol_env.flags & TR_ENV_ON)
		{
			n = TrEnvValue(&c->ins->vol_env, c->vol_env_pos);
			if (n >= 0)
				mv = mv * ClampI64(n, 0, 64) / 64;
		}
		c->vol_env_pos = TrEnvStep(&c->ins->vol_env, c->vol_env_pos, c->key_on);

		if (c->ins->pan_env.flags & TR_ENV_ON)
		{
			n = TrEnvValue(&c->ins->pan_env, c->pan_env_pos);
			//Envelope pan is an offset from centre, scaled by the headroom
			//left on whichever side the channel is already panned toward.
			if (n >= -32)
				c->mix_pan = c->pan + (n - 32) *
							 (128 - AbsI64(c->pan - 128)) / 32;
		}
		c->pan_env_pos = TrEnvStep(&c->ins->pan_env, c->pan_env_pos, c->key_on);

		//Auto-vibrato ramps in over the sweep, then holds at full depth.
		if (c->ins->vib_depth)
		{
			if (c->ins->vib_sweep > 0 && c->avib_sweep < c->ins->vib_sweep)
				c->avib_sweep++;
			n = c->ins->vib_depth;
			if (c->ins->vib_sweep > 0)
				n = n * c->avib_sweep / c->ins->vib_sweep;
			c->avib_pos += c->ins->vib_rate;
			c->sound_period += TrWaveDelta(c->ins->vib_type, c->avib_pos / 4,
										   n, 128) * TR_PERIOD_SCALE;
		}

		if (!c->key_on && c->ins->fadeout > 0)
		{
			c->fade_vol -= c->ins->fadeout;
			if (c->fade_vol <= 0)
			{
				c->fade_vol	= 0;
				c->active	= FALSE;
			}
		}
		mv = mv * c->fade_vol / 32768;
		mv = mv * ClampI64(c->ins->global_vol, 0, 128) / 128;
	}
	if (c->smp)
		mv = mv * ClampI64(c->smp->global_vol, 0, 64) / 64;
	mv = mv * ClampI64(c->chan_vol, 0, 64) / 64;
	//Pxx detune. One engine period unit is a sixteenth of a NES one, so the
	//stored offset is applied directly and reaches a sixteenth of the depth
	//FamiTracker gives it.
	c->sound_period -= c->fine_pitch;
	mv = mv * ClampI64(tr_song.global_vol, 0, 128) / 128;
	//Song mix volume. IT byte 0x31, S3M master volume doubled, 128 elsewhere.
	mv = mv * ClampI64(tr_song.mix_vol, 0, 128) / 128;
	c->mix_vol	= ClampI64(mv / 4096, 0, 64);
	c->mix_pan	= ClampI64(c->mix_pan, 0, 255);

	c->sound_period = ClampI64(c->sound_period, TR_PERIOD_MIN, TR_PERIOD_MAX);
	TrChanStep(c);
}

I64 TrPatternForOrder(I64 pos)
{
	I64 p;

	if (tr.pat_mode)
		return ClampI64(tr.cur_pat, 0, TR_MAX_PATTERNS - 1);
	if (pos < 0 || pos >= tr_song.order_len)
		return 0;
	p = tr_song.order[pos];
	if (p >= TR_MAX_PATTERNS)
		p = 0;

	return p;
}

U0 TrMarkPush()
{//Stamp the sequencer position with the output frame it starts at, so the
//display can follow what the mixer has actually drained.
	CTrMark *m = &tr_marks[tr_mark_pos & (TR_MARKS - 1)];

	m->frame = tr_play.frames_out;
	m->order = tr_play.order_pos;
	m->pat	 = tr_play.pattern;
	m->row	 = tr_play.row;
	tr_mark_pos++;
}

U0 TrSeqRow()
{
	I64		 ch;
	CTrCell	*cell;
	CTrCell	 blank;

	MemSet(&blank, 0, sizeof(CTrCell));
	//The groove sets this row's tick count and then steps, once per row and
	//independent of frame or pattern boundaries.
	if (0 <= tr_groove_idx < TR_GROOVES && tr_groove_len[tr_groove_idx] > 0)
	{
		tr_song.speed = tr_groove[tr_groove_idx]
					   [tr_groove_pos % tr_groove_len[tr_groove_idx]];
		if (tr_song.speed < 1)
			tr_song.speed = 6;
		tr_groove_pos++;
	}
	TrMarkPush;
	tr_play.jump_order	= -1;
	tr_play.break_row	= -1;
	tr_play.loop_jump	= -1;
	for (ch = 0; ch < tr_song.channels; ch++)
	{
		cell = TrCell(tr_play.pattern, ch, tr_play.row);
		if (!cell)
			cell = &blank;
		TrRowChannel(ch, cell);
	}
	for (ch = 0; ch < tr_song.channels; ch++)
		TrTickChannel(ch, 0);
}

U0 TrSeqAdvance()
{
	I64	 rows, nrow, nord;
	Bool moved = FALSE;

	rows = tr_pat_rows[tr_play.pattern];
	if (rows < 1)
		rows = 64;
	nrow = tr_play.row + 1;
	nord = tr_play.order_pos;

	if (tr_play.loop_jump >= 0)
	{
		nrow  = tr_play.loop_jump;
		moved = TRUE;
	}
	if (tr_play.jump_order >= 0)
	{
		nord  = tr_play.jump_order;
		nrow  = 0;
		moved = TRUE;
	}
	if (tr_play.break_row >= 0)
	{
		nrow = tr_play.break_row;
		if (tr_play.jump_order < 0)
			nord = tr_play.order_pos + 1;
		moved = TRUE;
	}
	if (!moved && nrow >= rows)
	{
		nrow = 0;
		nord = tr_play.order_pos + 1;
	}

	if (!tr.pat_mode && nord >= tr_song.order_len)
	{
		nord = tr_song.restart;
		if (nord < 0 || nord >= tr_song.order_len)
			nord = 0;
		tr_play.ended = TRUE;
	}
	tr_play.order_pos	= nord;
	tr_play.pattern		= TrPatternForOrder(nord);
	rows = tr_pat_rows[tr_play.pattern];
	if (rows < 1)
		rows = 1;
	if (nrow >= rows)
		nrow = 0;
	tr_play.row = nrow;
}

U0 TrSeqTick()
{//One sequencer tick. Sets frames_left for the mixer to consume.
	I64 ch, speed = tr_song.speed;

	if (speed < 1)
		speed = 6;
	if (tr_play.tick == 0)
		TrSeqRow;
	else
		for (ch = 0; ch < tr_song.channels; ch++)
			TrTickChannel(ch, tr_play.tick);

	tr_play.tick++;
	if (tr_play.tick >= speed)
	{
		tr_play.tick = 0;
		if (tr_play.pat_delay > 0)
			tr_play.pat_delay--;
		else
			TrSeqAdvance;
	}
	//frames per tick = rate * 2.5 / bpm
	tr_play.tick_frames = TR_RATE * 5 / (ClampI64(tr_song.bpm, 32, 255) * 2);
	tr_play.frames_left = tr_play.tick_frames;
}

U0 TrRender(I64 frames)
{//Split the request at tick boundaries. Mixing runs whether or not the
//sequencer does, so previewing notes while stopped costs nothing extra.
	I64 n;

	while (frames > 0)
	{
		n = frames;
		if (tr.playing)
		{
			if (tr_play.frames_left <= 0)
				TrSeqTick;
			n = MinI64(frames, tr_play.frames_left);
		}
		//Cap before charging the tick, or a slow tempo loses the remainder.
		if (n > TR_BLOCK)
			n = TR_BLOCK;
		if (n < 1)
			n = 1;
		if (tr.playing)
			tr_play.frames_left -= n;
		TrMixFrames(n);
		frames -= n;
	}
}

U0 TrPlayTask()
{//Feeds the mixer stream ahead of the DMA. Runs for the whole session.
	I64 target = TR_RATE / 8;	//125ms of queued audio.

	while (!tr.quit)
	{
		if (tr.busy)
		{//Editor owns the song data; hold off and say so.
			tr.mix_idle = TRUE;
			Sleep(2);
		}
		else
		{
			tr.mix_idle = FALSE;
			if (FifoI64Count(audio.output[tr.stream].data) < target)
				TrRender(TR_BLOCK);
			else
				Sleep(4);
		}
	}
	tr.mix_idle	 = TRUE;
	tr.play_task = NULL;
}

U0 TrPlayReset(I64 order_pos, I64 row)
{
	I64 ch;

	for (ch = 0; ch < TR_MAX_CHANNELS; ch++)
	{
		tr_ch[ch].active	 = FALSE;
		tr_ch[ch].loop_count = 0;
		tr_ch[ch].loop_row	 = 0;
	}
	tr_play.tick		= 0;
	tr_play.row			= row;
	tr_play.order_pos	= order_pos;
	tr_play.pattern		= TrPatternForOrder(order_pos);
	tr_play.pat_delay	= 0;
	tr_play.break_row	= -1;
	tr_play.jump_order	= -1;
	tr_play.loop_jump	= -1;
	tr_play.frames_left	= 0;
	tr_play.ended		= FALSE;
}

U0 TrPlayStart(I64 order_pos, I64 row)
{
	TrPlayReset(order_pos, row);
	FifoI64Flush(audio.output[tr.stream].data);
	audio.output_frames[tr.stream]	= 0;
	tr_play.frames_out				= 0;
	tr_mark_pos						= 0;
	MemSet(tr_marks, 0, sizeof(tr_marks));
	tr.playing = TRUE;
}

U0 TrPlayStop()
{
	I64 ch;

	tr.playing = FALSE;
	for (ch = 0; ch < TR_MAX_CHANNELS; ch++)
		tr_ch[ch].active = FALSE;
}

U0 TrMixSuspend()
{//Park the mixer before freeing or replacing patterns and samples. Returns
//once the render task is provably outside TrRender. The draw handler checks
//tr.busy too, so give the compositor a frame to notice.
	I64 spins = 0;

	tr.busy = TRUE;
	TrPlayStop;
	while (!tr.mix_idle && TaskValidate(tr.play_task) && spins < 500)
	{
		Sleep(1);
		spins++;
	}
	Sleep(40);
}

U0 TrMixResume()
{
	tr.busy = FALSE;
}

Bool TrMarkNow(I64 *_order, I64 *_pat, I64 *_row)
{//Latest mark the DMA has already reached.
	I64		 i, n, played = audio.output_frames[tr.stream];
	CTrMark	*m, *best = NULL;

	n = tr_mark_pos;
	if (n > TR_MARKS)
		n = TR_MARKS;
	for (i = 0; i < n; i++)
	{
		m = &tr_marks[(tr_mark_pos - 1 - i) & (TR_MARKS - 1)];
		if (m->frame <= played)
		{
			best = m;
			i = n;
		}
	}
	if (!best)
		return FALSE;
	*_order	= best->order;
	*_pat	= best->pat;
	*_row	= best->row;

	return TRUE;
}

U0 TrPreview(I64 note, I64 inst, I64 vol)
{//Audition on a spare channel. The mixer is always running, so this is just
//a voice trigger; it does not block the UI.
	I64		 ch, best = 0, quietest = 0x7FFFFFFF;
	CTrChan	*c;

	if (inst < 1 || inst >= TR_MAX_SAMPLES || !tr_smp[inst].data)
		return;
	//Prefer an idle channel; otherwise steal the quietest.
	for (ch = tr_song.channels - 1; ch >= 0; ch--)
	{
		c = &tr_ch[ch];
		if (!c->active)
		{
			best = ch;
			ch	 = -1;
		}
		else if (c->peak < quietest)
		{
			quietest = c->peak;
			best	 = ch;
		}
	}
	c = &tr_ch[best];
	c->smp			= &tr_smp[inst];
	c->inst			= inst;
	c->finetune		= c->smp->finetune;
	c->vol			= ClampI64(vol, 0, 64);
	c->mix_vol		= c->vol;
	c->eff			= 0;
	c->param		= 0;
	c->period		= TrNotePeriod(ClampI64(note + c->smp->rel_note,
											1, TR_NOTES), c->finetune);
	c->sound_period	= c->period;
	c->note			= note;
	TrChanStep(c);
	TrChanTrigger(c, 0);
}
