// status bar
//
// built from the game art, not text. SBAR and IBAR are 320x24 strips, big
// digits are 24x24 pics (NUM_ health, ANUM_ ammo), icons and faces are lumps

#define QSBAR_H			24
#define QSBAR_INV_H		24		//IBAR row, sits directly above SBAR
#define QSBAR_W			320		//the art is a fixed width strip, centred
#define QSBAR_DIGIT_W	24
#define QSBAR_LINES		2		//IBAR inventory above SBAR status

#define QIT_SHOTGUN			1
#define QIT_SUPER_SHOTGUN	2
#define QIT_NAILGUN			4
#define QIT_SUPER_NAILGUN	8
#define QIT_GRENADE_LAUNCHER 16
#define QIT_ROCKET_LAUNCHER	32
#define QIT_LIGHTNING		64
#define QIT_ARMOR1			8192
#define QIT_ARMOR2			16384
#define QIT_ARMOR3			32768
#define QIT_INVISIBILITY	524288
#define QIT_INVULNERABILITY	1048576
#define QIT_SUIT			2097152
#define QIT_QUAD			4194304

Bool q_sbar_ready = FALSE;

CQPic q_pic_sbar;
CQPic q_pic_ibar;
CQPic q_pic_backtile;	//gfx.wad "backtile", the fill beside the bar
CQPic q_pic_nums[10];
CQPic q_pic_anums[10];
CQPic q_pic_minus;
CQPic q_pic_faces[5];
CQPic q_pic_face_pain[5];
CQPic q_pic_armor[3];
CQPic q_pic_ammo[4];

//Sbar_DrawInventory art. INV_ unselected, INV2_ selected, INVA flash unused
CQPic q_pic_weap[2 * 7];
CQPic q_pic_items[6];		//keys, then the four powerups
CQPic q_pic_sigil[4];

//Sbar_IntermissionOverlay art
CQPic q_pic_complete;		//gfx/complete.lmp
CQPic q_pic_inter;			//gfx/inter.lmp, stat sheet background
CQPic q_pic_finale;			//gfx/finale.lmp
CQPic q_pic_loading;		//gfx/loading.lmp
CQPic q_pic_ranking;		//gfx/ranking.lmp, deathmatch scoreboard header
CQPic q_pic_scorebar;		//SCOREBAR, replaces SBAR while scores are held

//Sbar_DrawFace tests these before the health face
CQPic q_pic_face_quad;
CQPic q_pic_face_invis;
CQPic q_pic_face_invuln;
CQPic q_pic_face_invis_invuln;
CQPic q_pic_colon;
CQPic q_pic_slash;
I64   q_sbar_num_y = 0;	//row the small ammo digits sit on

U0 QSbarInit()
{//resolve every pic once. a missing lump leaves a zeroed CQPic, which the blit
 //skips.
	U8	name[24];
	I64	i;

	q_sbar_ready = FALSE;

	QWadPic("SBAR", &q_pic_sbar);
	QWadPic("IBAR", &q_pic_ibar);
	QWadPic("BACKTILE", &q_pic_backtile);
	QWadPic("NUM_MINUS", &q_pic_minus);

	for (i = 0; i < 10; i++)
	{
		StrPrint(name, "NUM_%d", i);
		QWadPic(name, &q_pic_nums[i]);

		StrPrint(name, "ANUM_%d", i);
		QWadPic(name, &q_pic_anums[i]);
	}

	//FACE1 healthy to FACE5 nearly dead, each with a _P pain variant
	for (i = 0; i < 5; i++)
	{
		StrPrint(name, "FACE%d", i + 1);
		QWadPic(name, &q_pic_faces[i]);

		StrPrint(name, "FACE_P%d", i + 1);
		QWadPic(name, &q_pic_face_pain[i]);
	}

	QWadPic("FACE_QUAD",   &q_pic_face_quad);
	QWadPic("FACE_INVIS",  &q_pic_face_invis);
	QWadPic("FACE_INVUL2", &q_pic_face_invuln);
	QWadPic("FACE_INV2",   &q_pic_face_invis_invuln);

	for (i = 0; i < 3; i++)
	{
		StrPrint(name, "SB_ARMOR%d", i + 1);
		QWadPic(name, &q_pic_armor[i]);
	}

	QWadPic("SB_SHELLS", &q_pic_ammo[0]);
	QWadPic("SB_NAILS",  &q_pic_ammo[1]);
	QWadPic("SB_ROCKET", &q_pic_ammo[2]);
	QWadPic("SB_CELLS",  &q_pic_ammo[3]);

	QWadPic("INV_SHOTGUN",   &q_pic_weap[0]);
	QWadPic("INV_SSHOTGUN",  &q_pic_weap[1]);
	QWadPic("INV_NAILGUN",   &q_pic_weap[2]);
	QWadPic("INV_SNAILGUN",  &q_pic_weap[3]);
	QWadPic("INV_RLAUNCH",   &q_pic_weap[4]);
	QWadPic("INV_SRLAUNCH",  &q_pic_weap[5]);
	QWadPic("INV_LIGHTNG",   &q_pic_weap[6]);

	QWadPic("INV2_SHOTGUN",  &q_pic_weap[7]);
	QWadPic("INV2_SSHOTGUN", &q_pic_weap[8]);
	QWadPic("INV2_NAILGUN",  &q_pic_weap[9]);
	QWadPic("INV2_SNAILGUN", &q_pic_weap[10]);
	QWadPic("INV2_RLAUNCH",  &q_pic_weap[11]);
	QWadPic("INV2_SRLAUNCH", &q_pic_weap[12]);
	QWadPic("INV2_LIGHTNG",  &q_pic_weap[13]);

	QWadPic("SB_KEY1",  &q_pic_items[0]);
	QWadPic("SB_KEY2",  &q_pic_items[1]);
	QWadPic("SB_INVIS", &q_pic_items[2]);
	QWadPic("SB_INVULN",&q_pic_items[3]);
	QWadPic("SB_SUIT",  &q_pic_items[4]);
	QWadPic("SB_QUAD",  &q_pic_items[5]);

	QWadPic("SB_SIGIL1", &q_pic_sigil[0]);
	QWadPic("SB_SIGIL2", &q_pic_sigil[1]);
	QWadPic("SB_SIGIL3", &q_pic_sigil[2]);
	QWadPic("SB_SIGIL4", &q_pic_sigil[3]);

	QWadPic("NUM_COLON", &q_pic_colon);
	QWadPic("NUM_SLASH", &q_pic_slash);

	//standalone lumps, not gfx.wad entries
	QPicLoad("gfx/complete.lmp", &q_pic_complete);
	QPicLoad("gfx/inter.lmp",    &q_pic_inter);
	QPicLoad("gfx/finale.lmp",   &q_pic_finale);
	QPicLoad("gfx/loading.lmp",  &q_pic_loading);
	QPicLoad("gfx/ranking.lmp",  &q_pic_ranking);
	QWadPic("SCOREBAR",          &q_pic_scorebar);

	q_sbar_ready = ToBool(q_pic_sbar.pixels != NULL);
}

U0 QSbarNumber(CQCanvas *c, I64 x, I64 y, I64 value, I64 digits, Bool alt,
	I64 scale = 1)
{//right aligned big number, clamped to the field. x and y are screen space,
 //the field width is not.
	U8		str[16];
	CQPic	*pic;
	I64		 len;
	I64		 i;
	I64		 ch;
	I64		 draw_x;

	if (value > 999)
		value = 999;
	if (value < -99)
		value = -99;

	StrPrint(str, "%d", value);
	len = StrLen(str);

	draw_x = x + (digits - len) * QSBAR_DIGIT_W * scale;

	for (i = 0; i < len; i++)
	{
		ch = str[i];

		if (ch == '-')
			pic = &q_pic_minus;
		else if ('0' <= ch <= '9')
		{
			if (alt)
				pic = &q_pic_anums[ch - '0'];
			else
				pic = &q_pic_nums[ch - '0'];
		}
		else
			pic = NULL;

		if (pic)
			QPicDrawScaled(c, pic, draw_x + i * QSBAR_DIGIT_W * scale, y,
				scale);
	}
}

I64 QSbarFaceIndex(I64 health)
{//FACE1 healthy, FACE5 nearly dead
	if (health >= 100)	return 0;
	if (health >= 80)	return 1;
	if (health >= 60)	return 2;
	if (health >= 40)	return 3;

	return 4;
}

Bool QIsBreak(U8 *s, I64 i)
{//message text arrives with the escape unprocessed: a literal backslash then
 //'n'. both forms are accepted.
	if (s[i] == '\n')
		return TRUE;

	//0x5C is backslash, as a number so it never needs escaping here
	if (s[i] == 0x5C && s[i + 1] == 'n')
		return TRUE;

	return FALSE;
}

U0 QSbarCenterPrint(CQCanvas *c)
{//SCR_DrawCenterString. wraps on its own newlines, block at 0.35 screen height
 //or 48 when tall. during an intermission it types out at scr_printspeed, 8
 //chars a second from when the string was posted.
	U8	line[128];
	I64 i = 0;
	I64 n = 0;
	I64 y;
	I64 rows = 1;
	I64 k;
	I64 remaining;

	if (!q_center_text[0])
		return;

	//SCR_CheckDrawCenterString: no timeout during an intermission
	if (!q_intermission && tS > q_center_until)
		return;

	if (q_intermission)
		remaining = ToI64(8.0 * (tS - q_center_start));
	else
		remaining = 9999;

	for (k = 0; q_center_text[k]; k++)
	{
		if (QIsBreak(q_center_text, k))
			rows++;
	}

	if (rows <= 4)
		y = ToI64(ToF64(c->height) * 0.35);
	else
		y = 48 * c->height / 200;

	while (TRUE)
	{
		if (q_center_text[i] == 0 || QIsBreak(q_center_text, i))
		{
			line[n] = 0;
			if (n)
				QStrDrawCenter(c, y, line);

			y += QCHAR_H;
			n  = 0;

			if (!q_center_text[i] || remaining <= 0)
				return;

			//the two char escape eats an extra byte
			if (q_center_text[i] != '\n')
				i++;
		}
		else if (n < 127)
		{
			if (remaining <= 0)
			{
				line[n] = 0;
				if (n)
					QStrDrawCenter(c, y, line);
				return;
			}

			line[n] = q_center_text[i];
			n++;
			remaining--;
		}

		i++;
	}
}

U0 QSbarIntermission(CQCanvas *c, F64 level_time)
{//end of level screen: time, secrets, kills. single player only -
 //Sbar_IntermissionOverlay hands a deathmatch to the rankings instead.
 //draw only: QuakeC parked the camera and IntermissionThink watches button0.
	I64 mins;
	I64 secs;
	I64 ox;
	I64 oy;

	if (!q_intermission)
		return;


	//Sbar_FinaleOverlay: plaque only. svc_finale text goes through the
	//centerprint path, which owns the wrap and the typing.
	if (q_finale)
	{
		if (q_pic_finale.pixels)
			QPicDraw(c, &q_pic_finale,
				(c->width - q_pic_finale.width) / 2, 16 * c->height / 200);
		return;
	}

	mins = ToI64(level_time) / 60;
	secs = ToI64(level_time) % 60;

	//Sbar_IntermissionOverlay layout, 320x200 coords offset onto the canvas
	ox = (c->width - 320) / 2;
	if (ox < 0)
		ox = 0;
	oy = (c->height - 200) / 2;
	if (oy < 0)
		oy = 0;

	QPicDraw(c, &q_pic_complete, ox + 64, oy + 24);
	QPicDraw(c, &q_pic_inter, ox, oy + 56);

	//minutes, colon, two digits of seconds
	QSbarNumber(c, ox + 160, oy + 64, mins, 3, FALSE);
	QPicDraw(c, &q_pic_colon, ox + 234, oy + 64);
	QPicDraw(c, &q_pic_nums[(secs / 10) % 10], ox + 246, oy + 64);
	QPicDraw(c, &q_pic_nums[secs % 10], ox + 266, oy + 64);

	if (q_ofs_found_secrets >= 0 && q_ofs_total_secrets >= 0)
	{
		QSbarNumber(c, ox + 160, oy + 104,
			ToI64(QPrGetF(q_ofs_found_secrets)), 3, FALSE);
		QPicDraw(c, &q_pic_slash, ox + 232, oy + 104);
		QSbarNumber(c, ox + 240, oy + 104,
			ToI64(QPrGetF(q_ofs_total_secrets)), 3, FALSE);
	}

	if (q_ofs_killed_monsters >= 0 && q_ofs_total_monsters >= 0)
	{
		QSbarNumber(c, ox + 160, oy + 144,
			ToI64(QPrGetF(q_ofs_killed_monsters)), 3, FALSE);
		QPicDraw(c, &q_pic_slash, ox + 232, oy + 144);
		QSbarNumber(c, ox + 240, oy + 144,
			ToI64(QPrGetF(q_ofs_total_monsters)), 3, FALSE);
	}
}

U0 QSbarSmallNumber(CQCanvas *c, I64 x, I64 value, I64 scale = 1)
{//Sbar_DrawCharacter with 18 + digit - CONCHARS holds the small gold digits at
 //18. right aligned over three columns, leading zeroes blank.
	I64 digits[3];
	I64 i;

	if (value < 0)
		value = 0;
	if (value > 999)
		value = 999;

	digits[0] = value / 100;
	digits[1] = (value / 10) % 10;
	digits[2] = value % 10;

	for (i = 0; i < 3; i++)
	{
		//"%3i" leaves leading zeroes as spaces, and a space draws nothing
		if (i == 0 && digits[0] == 0)
			goto qsn_next;
		if (i == 1 && digits[0] == 0 && digits[1] == 0)
			goto qsn_next;

		QCharDrawScaled(c, x + i * QCHAR_W * scale, q_sbar_num_y,
			18 + digits[i], scale);

qsn_next:
	}
}

U0 QSbarDrawInventory(CQCanvas *c, I64 bx, I64 top, I64 items,
	I64 scale = 1)
{//Sbar_DrawInventory: weapons, four ammo counts, keys, powerups, sigils.
 //offsets are the original's, from the top of the IBAR, in 320x200 units
	CQPic	*pic;
	I64		 ibar_y = top - 24 * scale;
	I64		 active;
	I64		 ammo[4];
	I64		 i;
	I64		 sel;

	if (!q_pic_ibar.pixels)
		return;

	QPicDrawScaled(c, &q_pic_ibar, bx, ibar_y, scale);

	//STAT_ACTIVEWEAPON, .weapon is the item bit of the current weapon
	active = 0;
	if (q_fld_weapon >= 0)
		active = ToI64(QPrFieldF(q_player_edict, q_fld_weapon));

	for (i = 0; i < 7; i++)
	{
		if (!(items & (QIT_SHOTGUN << i)))
			goto qsi_next_weap;

		sel = 0;
		if (active == (QIT_SHOTGUN << i))
			sel = 7;

		pic = &q_pic_weap[sel + i];
		if (pic->pixels)
			QPicDrawScaled(c, pic, bx + i * 24 * scale,
				ibar_y + 8 * scale, scale);

qsi_next_weap:
	}

	ammo[0] = 0;
	ammo[1] = 0;
	ammo[2] = 0;
	ammo[3] = 0;

	if (q_fld_ammo_shells >= 0)
		ammo[0] = ToI64(QPrFieldF(q_player_edict, q_fld_ammo_shells));
	if (q_fld_ammo_nails >= 0)
		ammo[1] = ToI64(QPrFieldF(q_player_edict, q_fld_ammo_nails));
	if (q_fld_ammo_rockets >= 0)
		ammo[2] = ToI64(QPrFieldF(q_player_edict, q_fld_ammo_rockets));
	if (q_fld_ammo_cells >= 0)
		ammo[3] = ToI64(QPrFieldF(q_player_edict, q_fld_ammo_cells));

	//three small digits per count, at (6*i+1)*8 - 2
	for (i = 0; i < 4; i++)
	{
		q_sbar_num_y = ibar_y;
		QSbarSmallNumber(c, bx + ((6 * i + 1) * 8 - 2) * scale, ammo[i],
			scale);
	}

	//keys and powerups are bits 17..22, from x=192 in 16 pixel steps
	for (i = 0; i < 6; i++)
	{
		if (!(items & (1 << (17 + i))))
			goto qsi_next_item;

		pic = &q_pic_items[i];
		if (pic->pixels)
			QPicDrawScaled(c, pic, bx + (192 + i * 16) * scale,
				ibar_y + 8 * scale, scale);

qsi_next_item:
	}

	//sigils are bits 28..31, right aligned on the 320 wide bar
	for (i = 0; i < 4; i++)
	{
		if (!(items & (1 << (28 + i))))
			goto qsi_next_sigil;

		pic = &q_pic_sigil[i];
		if (pic->pixels)
			QPicDrawScaled(c, pic, bx + (320 - 32 + i * 8) * scale,
				ibar_y + 8 * scale, scale);

qsi_next_sigil:
	}
}

Bool q_cs_hud_live = FALSE;

I64 QSbarLines()
{//SCR_CalcRefdef's sb_lines:
 //    if (size >= 120 || cl.intermission || scr_sbaralpha.value < 1 ||
 //        hudstyle != HUD_CLASSIC || cl.qcvm.extfuncs.CSQC_DrawHud)
 //        sb_lines = 0;
 //    else if (size >= 110) sb_lines = 24 * scale;
 //    else                  sb_lines = 48 * scale;
	F64 view = QCvarGet("viewsize");

	if (view >= 120.0)
		return 0;

	if (q_intermission)
		return 0;

	if (QCvarGet("scr_sbaralpha") < 1.0)
		return 0;

	if (q_opt_hudstyle != QHUD_CLASSIC)
		return 0;

	if (q_cs_hud_live)
		return 0;

	if (view >= 110.0)
		return QSBAR_H;

	return QSBAR_H + QSBAR_INV_H;
}

I64 QSbarDrawRows()
{//rows the bar draws, which differ from sb_lines. Sbar_Draw tests scr_viewsize
 //directly - johnfitz, "check viewsize instead of sb_lines".
	F64 view = QCvarGet("viewsize");

	if (view >= 120.0)
		return 0;

	if (q_opt_hudstyle == QHUD_QUAKEWORLD)
		return QSBAR_H;

	if (view >= 110.0)
		return QSBAR_H;

	return QSBAR_H + QSBAR_INV_H;
}

I64 QSbarLinesScaled(CQCanvas *c)
{//QSbarLines is in 320x200 rows; this is the on-screen height
	return QSbarLines * QHudScale(c);
}

U0 QSbarTileClear(CQCanvas *c)
{//SCR_TileClear: border around a shrunken view, nothing at viewsize 100.
 //the backdrop stops at height - sb_lines, not at a fixed bar height.
	I64 bottom = c->height - QSbarLinesScaled(c);

	if (!q_sbar_ready)
		return;

	if (c->vx > 0)
		QPicTile(c, &q_pic_backtile, 0, 0, c->vx, bottom);

	if (c->vx + c->vw < c->width)
		QPicTile(c, &q_pic_backtile, c->vx + c->vw, 0,
			c->width - (c->vx + c->vw), bottom);

	if (c->vy > 0)
		QPicTile(c, &q_pic_backtile, c->vx, 0, c->vw, c->vy);

	if (c->vy + c->vh < bottom)
		QPicTile(c, &q_pic_backtile, c->vx, c->vy + c->vh, c->vw,
			bottom - (c->vy + c->vh));
}

//widest ammo row the corner block can hold
#define QSBAR_AMMO_ICONS	8

U0 QSbarDrawKeysModern(CQCanvas *c, I64 s, I64 items, I64 right, I64 row)
{//keys, powerups and sigils for the floating style, right aligned
	CQPic	*pic;
	I64		 x = right + QSBAR_DIGIT_W * 3 * s;
	I64		 i;

	for (i = 3; i >= 0; i--)
	{
		if (!(items & (1 << (28 + i))))
			goto qkm_next_sigil;

		pic = &q_pic_sigil[i];
		if (pic->pixels)
		{
			x -= 8 * s;
			QPicDrawScaled(c, pic, x, row, s);
		}

qkm_next_sigil:
	}

	for (i = 5; i >= 0; i--)
	{
		if (!(items & (1 << (17 + i))))
			goto qkm_next_item;

		pic = &q_pic_items[i];
		if (pic->pixels)
		{
			x -= 16 * s;
			QPicDrawScaled(c, pic, x, row, s);
		}

qkm_next_item:
	}
}

U0 QSbarDrawModern(CQCanvas *c, I64 s, I64 health, I64 armor, I64 ammo,
	I64 items)
{//scr_hudstyle 1: the same art anchored to the corners over a full height view
	CQPic	*icon;
	CQPic	*facepic;
	I64		 pad = 8 * s;
	I64		 row;
	I64		 ax;
	I64		 lx;
	I64		 units;
	I64		 i;

	//big number pics are 24 tall, so one row up is one row of them
	row = c->height - QSBAR_H * s - pad;

	lx = pad;
	if (q_opt_hudstyle == QHUD_MODERN_C)
		lx = c->width / 2 - QSBAR_DIGIT_W * 5 * s;

	if (items & QIT_ARMOR3)
		icon = &q_pic_armor[2];
	else if (items & QIT_ARMOR2)
		icon = &q_pic_armor[1];
	else if (items & QIT_ARMOR1)
		icon = &q_pic_armor[0];
	else
		icon = NULL;

	if (icon && armor > 0)
	{
		QPicDrawScaled(c, icon, lx, row - QSBAR_H * s, s);
		QSbarNumber(c, lx + QSBAR_H * s, row - QSBAR_H * s, armor, 3,
			FALSE, s);
	}

	//Sbar_DrawFace order: both rings, quad, each ring alone, then health
	facepic = NULL;
	if ((items & (QIT_INVISIBILITY | QIT_INVULNERABILITY)) ==
		(QIT_INVISIBILITY | QIT_INVULNERABILITY))
		facepic = &q_pic_face_invis_invuln;
	else if (items & QIT_QUAD)
		facepic = &q_pic_face_quad;
	else if (items & QIT_INVISIBILITY)
		facepic = &q_pic_face_invis;
	else if (items & QIT_INVULNERABILITY)
		facepic = &q_pic_face_invuln;

	if (!facepic || !facepic->pixels)
		facepic = &q_pic_faces[QSbarFaceIndex(health)];

	if (facepic->pixels)
		QPicDrawScaled(c, facepic, lx, row, s);

	QSbarNumber(c, lx + QSBAR_H * s, row, health, 3, FALSE, s);

	//bottom right: ammo, the number right aligned on the canvas edge
	//QHUD_MODERN_C pulls both blocks toward the middle instead of the edges
	icon = NULL;
	if (items & (QIT_SHOTGUN | QIT_SUPER_SHOTGUN))
		icon = &q_pic_ammo[0];
	if (items & (QIT_NAILGUN | QIT_SUPER_NAILGUN))
		icon = &q_pic_ammo[1];
	if (items & (QIT_GRENADE_LAUNCHER | QIT_ROCKET_LAUNCHER))
		icon = &q_pic_ammo[2];
	if (items & QIT_LIGHTNING)
		icon = &q_pic_ammo[3];

	if (q_opt_hudstyle == QHUD_MODERN_C)
		ax = c->width / 2 + QSBAR_DIGIT_W * 2 * s;
	else
		ax = c->width - pad - QSBAR_DIGIT_W * 3 * s;

	if (icon)
		QPicDrawScaled(c, icon, ax - QSBAR_H * s, row, s);

	QSbarNumber(c, ax, row, ammo, 3, TRUE, s);

	QSbarDrawKeysModern(c, s, items, ax, row - QSBAR_H * s);
}

//sbar.c:1618: the CSQC HUD, when loaded, replaces the classic bar. QCsqc
//compiles after this file, so the call goes through a pointer.
Bool (*q_sbar_cs_hook)(CQCanvas *c, Bool showscores) = NULL;

U0 QSbarDraw(CQCanvas *c)
{//Sbar_Draw
	CQPic	*icon;
	I64		 top;
	I64		 bx;
	I64		 health;
	I64		 armor;
	I64		 ammo;
	I64		 items;
	I64		 face;
	CQPic	*facepic;
	I64		 lines;
	I64		 s;

	//sbar.c reads cl.stats, not the edict - playback and remote play have no
	//local quakec world
	if (!q_sbar_ready || (!q_player_active && !QClientMode))
		return;

	if (q_sbar_cs_hook && q_sbar_cs_hook(c, q_scoreboard_show))
		return;

	s = QHudScale(c);

	if (q_player_active)
	{
		health = ToI64(QPlayerHealth);
		armor  = ToI64(QPlayerArmor);
		ammo   = ToI64(QPlayerAmmo);
		items  = ToI64(QPrFieldF(q_player_edict, q_fld_items));
	}
	else
	{
		//svc_clientdata carries all four, the only source during playback
		health = q_cl.health;
		armor  = q_cl.armorvalue;
		ammo   = q_cl.currentammo;
		items  = q_cl.items;
	}

	if (q_opt_hudstyle == QHUD_MODERN_C || q_opt_hudstyle == QHUD_MODERN_S)
	{
		QSbarDrawModern(c, s, health, armor, ammo, items);
		return;
	}

	lines = QSbarDrawRows;
	if (lines < 1)
		return;

	lines = lines * s;

	top = c->height - QSBAR_H * s;

	//art is a fixed 320 wide, centred not stretched. offsets below are in
	//320x200 units and scale here.
	bx = (c->width - QSBAR_W * s) / 2;
	if (bx < 0)
		bx = 0;

	//Sbar_Draw tiles first when the screen is wider than the art, over exactly
	//the sb_lines rows still on screen
	if (c->width > QSBAR_W * s)
		QPicTile(c, &q_pic_backtile, 0, c->height - lines, c->width, lines);

	if (lines > QSBAR_H * s)
		QSbarDrawInventory(c, bx, top, items, s);

	QPicDrawScaled(c, &q_pic_sbar, bx, top, s);

	if (items & QIT_ARMOR3)
		icon = &q_pic_armor[2];
	else if (items & QIT_ARMOR2)
		icon = &q_pic_armor[1];
	else if (items & QIT_ARMOR1)
		icon = &q_pic_armor[0];
	else
		icon = NULL;

	if (icon && armor > 0)
	{
		QPicDrawScaled(c, icon, bx, top, s);
		QSbarNumber(c, bx + 24 * s, top, armor, 3, FALSE, s);
	}

	//Sbar_DrawFace order: both rings, quad, each ring alone, then health.
	facepic = NULL;
	if ((items & (QIT_INVISIBILITY | QIT_INVULNERABILITY)) ==
		(QIT_INVISIBILITY | QIT_INVULNERABILITY))
		facepic = &q_pic_face_invis_invuln;
	else if (items & QIT_QUAD)
		facepic = &q_pic_face_quad;
	else if (items & QIT_INVISIBILITY)
		facepic = &q_pic_face_invis;
	else if (items & QIT_INVULNERABILITY)
		facepic = &q_pic_face_invuln;

	if (!facepic || !facepic->pixels)
	{
		face   = QSbarFaceIndex(health);
		facepic = &q_pic_faces[face];
	}

	if (facepic->pixels)
		QPicDrawScaled(c, facepic, bx + 112 * s, top, s);
	QSbarNumber(c, bx + 136 * s, top, health, 3, FALSE, s);

	icon = NULL;
	if (items & (QIT_SHOTGUN | QIT_SUPER_SHOTGUN))
		icon = &q_pic_ammo[0];
	if (items & (QIT_NAILGUN | QIT_SUPER_NAILGUN))
		icon = &q_pic_ammo[1];
	if (items & (QIT_GRENADE_LAUNCHER | QIT_ROCKET_LAUNCHER))
		icon = &q_pic_ammo[2];
	if (items & QIT_LIGHTNING)
		icon = &q_pic_ammo[3];

	if (icon)
		QPicDrawScaled(c, icon, bx + 224 * s, top, s);

	QSbarNumber(c, bx + 248 * s, top, ammo, 3, TRUE, s);
}

U0 QSbarFill(CQCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 color)
{//Draw_Fill: solid palette rect for the scoreboard color bars
	I64	 i;
	I64	 j;
	I64	 yy;
	I64	 xx;
	U8	*row;

	if (!c || !c->pixels || w < 1 || h < 1)
		return;

	color = color & 255;
	for (j = 0; j < h; j++)
	{
		yy = y + j;
		if (yy >= 0 && yy < c->height)
		{
			row = c->pixels + yy * c->width;
			for (i = 0; i < w; i++)
			{
				xx = x + i;
				if (xx >= 0 && xx < c->width)
				{
					row[xx] = color;
					QRGBDrop(c, xx, yy);
				}
			}
		}
	}
}

I64 QSbarColorForMap(I64 m)
{//Sbar_ColorForMap: color nibble to palette index
	return (m & 255) + 8;
}

U0 QSbarSoloScoreboard(CQCanvas *c)
{//Sbar_SoloScoreboard, drawn in the status bar strip while scores are held
	U8	line[64];
	I64	mins;
	I64	secs;
	I64	bx;
	I64	top;
	I64	len;
	I64	s;

	if (!c)
		return;

	s   = QHudScale(c);
	top = c->height - QSBAR_H * s;
	bx  = (c->width - QSBAR_W * s) / 2;
	if (bx < 0)
		bx = 0;

	if (q_pic_scorebar.pixels)
		QPicDrawScaled(c, &q_pic_scorebar, bx, top, s);

	mins = ToI64(q_game_time) / 60;
	secs = ToI64(q_game_time) % 60;

	StrPrint(line, "Monsters:%3d /%3d",
		ToI64(QPrGetF(q_ofs_killed_monsters)),
		ToI64(QPrGetF(q_ofs_total_monsters)));
	QStrDrawScaled(c, bx + 8 * s, top + 4 * s, line, s);

	StrPrint(line, "Secrets :%3d /%3d",
		ToI64(QPrGetF(q_ofs_found_secrets)),
		ToI64(QPrGetF(q_ofs_total_secrets)));
	QStrDrawScaled(c, bx + 8 * s, top + 12 * s, line, s);

	StrPrint(line, "Time :%3d:%02d", mins, secs);
	QStrDrawScaled(c, bx + 184 * s, top + 4 * s, line, s);

	if (q_net_level_name[0])
		QStrCopy(line, q_net_level_name, 64);
	else
		QStrCopy(line, q_map_name, 64);

	len = StrLen(line);
	QStrDrawScaled(c, bx + (232 - len * 4) * s, top + 12 * s, line, s);
}

U0 QSbarDrawScoreboard(CQCanvas *c)
{//Sbar_DeathmatchOverlay, ranked by frags with shirt/pants bars
	I64		fragsort[QSV_MAX_CLIENTS];
	I64		n;
	I64		i;
	I64		j;
	I64		k;
	I64		tmp;
	I64		x;
	I64		y;
	I64		top;
	I64		bottom;
	I64		f;
	U8		line[40];

	if (!c)
		return;

	//Sbar_DrawScoreboard: solo stats always, the frag list only in deathmatch
	QSbarSoloScoreboard(c);

	if (QCvarGet("deathmatch") == 0.0)
		return;

	n = 0;
	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (q_scores[i].active && q_scores[i].name[0])
		{
			fragsort[n] = i;
			n++;
		}
	}
	if (n < 1)
		return;

	for (i = 0; i < n; i++)
	{
		for (j = 0; j < n - 1 - i; j++)
		{
			if (q_scores[fragsort[j]].frags < q_scores[fragsort[j + 1]].frags)
			{
				tmp = fragsort[j];
				fragsort[j] = fragsort[j + 1];
				fragsort[j + 1] = tmp;
			}
		}
	}

	//Sbar_DeathmatchOverlay opens with the ranking plaque, centred at y 8
	if (q_pic_ranking.pixels)
		QPicDraw(c, &q_pic_ranking,
			(c->width - q_pic_ranking.width) / 2, 8);
	else
		QStrDrawCenterAlt(c, 8, "FRAGS");

	x = (c->width - 200) / 2;
	if (x < 8)
		x = 8;

	y = 28;
	if (q_pic_ranking.pixels && q_pic_ranking.height + 12 > y)
		y = q_pic_ranking.height + 12;

	for (i = 0; i < n; i++)
	{
		k = fragsort[i];

		top    = q_scores[k].colors & 0xF0;
		bottom = (q_scores[k].colors & 15) << 4;
		top    = QSbarColorForMap(top);
		bottom = QSbarColorForMap(bottom);

		QSbarFill(c, x, y, 40, 4, top);
		QSbarFill(c, x, y + 4, 40, 4, bottom);

		f = q_scores[k].frags;
		StrPrint(line, "%3d", f);
		QStrDraw(c, x + 8, y, line);
		QStrDraw(c, x + 64, y, q_scores[k].name);

		y += 10;
	}
}

U0 QSbarLoadingPlaque(CQCanvas *c)
{//SCR_DrawLoading, centred at y=48 in the 320x200 layout
	if (!q_pic_loading.pixels)
		return;

	QPicDraw(c, &q_pic_loading,
		(c->width - q_pic_loading.width) / 2, 48 * c->height / 200);
}

U0 QSbarCrosshair(CQCanvas *c)
{//SCR_DrawCrosshair. a glyph from the console font, centred on the view rect
 //not the screen, nudged by cl_crossx/y.
 //
 //V_Crosshair_f picks the glyph:
 //    !value      none
 //    value < 0   custom character index, ((int)-value) & 255
 //    value > 1   15, the dot
 //    else        '+'
	F64 v = QCvarGet("crosshair");
	I64 ch;
	I64 x;
	I64 y;
	I64 cs;

	if (v == 0.0)
		return;

	if (QCvarGet("viewsize") >= 130.0 || q_intermission)
		return;

	if (v < 0.0)
		ch = ToI64(-v) & 255;
	else if (v > 1.0)
		ch = 15;
	else
		ch = '+';

	if (!ch)
		return;

	x = c->vx + c->vw / 2 + ToI64(QCvarGet("cl_crossx"));
	y = c->vy + c->vh / 2 + ToI64(QCvarGet("cl_crossy"));

	//scr_crosshairscale, gl_screen.c. 0 or absent reads as 1
	cs = ToI64(QCvarGet("scr_crosshairscale"));
	if (cs < 1)
		cs = 1;
	if (cs > 8)
		cs = 8;

	//Draw_Character(-4, -4, ...) - the 8x8 glyph is centred, not corner-hung
	if (cs == 1)
		QCharDraw(c, x - 4, y - 4, ch);
	else
		QCharDrawScaled(c, x - 4 * cs, y - 4 * cs, ch, cs);
}
