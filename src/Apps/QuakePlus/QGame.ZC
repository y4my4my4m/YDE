// QGame.ZC - drives the QuakeC VM: spawning, thinking, drawing
//
// the entity text is the input to the game. each block becomes an edict whose
// fields come from the key/value pairs, then the spawn function named by its
// classname runs
//
// after that, entities advance by running any think whose nextthink has come
// due - that one mechanism animates monsters, opens doors and bobs items

#define QGAME_MAX_EDICTS	600
#define QGAME_FRAME_TIME	0.1		//QuakeC assumes 10Hz thinking
#define QGAME_LIGHT			170		//no lit surface found
#define QGAME_STATIC_DIST	2000.0	//statics are range limited like entities

//QuakeC value types, as emitted in the def tables
#define QTYPE_VOID		0
#define QTYPE_STRING	1
#define QTYPE_FLOAT		2
#define QTYPE_VECTOR	3
#define QTYPE_ENTITY	4
#define QTYPE_FIELD		5
#define QTYPE_FUNCTION	6
#define QTYPE_POINTER	7

Bool q_game_active	= FALSE;
F64	 q_game_time	= 0.0;
I64	 q_game_spawned	= 0;
I64	 q_game_thinks	= 0;

//inventory carried between levels. SetChangeParms packs it into parm1..parm16
//and reloading the bytecode wipes the global pool, so the engine holds it
//across the transition. the parm globals ARE the spawn parms
#define QGAME_MAX_PARMS	QPR_MAX_PARM_GLOBALS
F64	 q_saved_parms[QGAME_MAX_PARMS];

F64	 q_saved_serverflags	= 0.0;
Bool q_have_saved_parms		= FALSE;
Bool q_world_warned			= FALSE;

I64 QGameFindFieldDef(U8 *name, I64 *_type)
{//the field def type decides how a map value converts
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
		{
			if (_type)
				*_type = q_pr_fielddefs[i].type & 0x7FFF;	//high bit is a flag
			return q_pr_fielddefs[i].ofs;
		}
	}

	if (_type)
		*_type = QTYPE_VOID;

	return -1;
}

Bool QGameSetField(I64 ent, U8 *key, U8 *value)
{//one map key/value onto an entity field
	I64 ftype;
	I64 ofs;
	F64 v[3];
	I64 fn;
	U8	anglebuf[64];
	I64	n;

	//the "angle" hack, as ED_ParseEdict does it. maps write a bare yaw as
	//"angle", progs.dat only has the vector "angles" - without the rewrite the
	//key is silently DROPPED and every entity spawns facing east
	//
	//SetMovedir reads self.angles for which way a door travels, so this is not
	//cosmetic. -1 and -2 (up / down) pass straight through, SetMovedir reads
	//those
	if (!StrCompare(key, "angle"))
	{
		//built by hand, not StrPrint - the value is up to 160 chars straight
		//out of the entity lump and would not fit "0 %s 0" here. a yaw is a
		//handful of digits, anything longer is malformed
		anglebuf[0] = '0';
		anglebuf[1] = ' ';

		//leaves room for the trailing " 0" and the terminator
		QStrCopy(anglebuf + 2, value, sizeof(anglebuf) - 5);

		n = StrLen(anglebuf);
		anglebuf[n]     = ' ';
		anglebuf[n + 1] = '0';
		anglebuf[n + 2] = 0;

		key   = "angles";
		value = anglebuf;
	}

	ofs = QGameFindFieldDef(key, &ftype);
	if (ofs < 0)
		return FALSE;

	switch (ftype)
	{
		case QTYPE_FLOAT:
			QPrSetFieldF(ent, ofs, QAtoF(value));
			break;

		case QTYPE_VECTOR:
			QParseVec(value, v);
			QPrSetFieldF(ent, ofs, v[0]);
			QPrSetFieldF(ent, ofs + 1, v[1]);
			QPrSetFieldF(ent, ofs + 2, v[2]);
			break;

		case QTYPE_STRING:
			//map strings aren't in the compiled blob, copy to the heap first
			QPrSetFieldI(ent, ofs, QPrNewString(value));
			break;

		case QTYPE_ENTITY:
			QPrSetFieldI(ent, ofs, QPrEdictValue(ToI64(QAtoF(value))));
			break;

		case QTYPE_FUNCTION:
			fn = QPrFindFunction(value);
			if (fn < 0)
				fn = 0;
			QPrSetFieldI(ent, ofs, fn);
			break;

		default:
			return FALSE;
	}

	return TRUE;
}

//defs.qc spawnflags the engine reserves for entity filtering
#define QSPAWNFLAG_NOT_EASY			256
#define QSPAWNFLAG_NOT_MEDIUM		512
#define QSPAWNFLAG_NOT_HARD			1024
#define QSPAWNFLAG_NOT_DEATHMATCH	2048

//coop resolved for this level. NOT zeroed by the loader, QGameApplyModeCvars
//is the init and every reader goes through it first
Bool q_coop_active = FALSE;

U0 QGameApplyModeCvars()
{//resolve the game mode, then publish it to the VM
 //
 //coop and deathmatch are mutually exclusive - Host_InitLocal forces
 //deathmatch off whenever coop is set. every later test (entity inhibit,
 //SelectSpawnPoint, respawn) reads the resolved pair, so it is settled once
 //here and never re-derived
 //
 //SV_SpawnServer publishes these as progs GLOBALS, not cvars - CheatCommand
 //(impulse 9) returns early on deathmatch || coop, and SelectSpawnPoint reads
 //coop to pick info_player_coop. left at 0 the QuakeC side plays single player
	q_coop_active = FALSE;

	if (QCvarGet("coop") != 0.0)
	{
		q_coop_active = TRUE;

		if (QCvarGet("deathmatch") != 0.0)
			QCvarSet("deathmatch", 0.0);
	}

	if (q_ofs_coop >= 0)
		QPrSetF(q_ofs_coop, QCvarGet("coop"));
	if (q_ofs_deathmatch >= 0)
		QPrSetF(q_ofs_deathmatch, QCvarGet("deathmatch"));

	//teamplay is a progs global too, and T_Damage is the only thing that reads
	//it - 1 blocks damage between team mates, 2 lets it through. never
	//published, so every friendly fire setting read as 0 and did nothing
	if (q_ofs_teamplay >= 0)
		QPrSetF(q_ofs_teamplay, QCvarGet("teamplay"));
}

Bool QGameInhibitEntity(I64 ent)
{//ED_LoadFromFile - does this entity belong in the game being started
	I64 flags;
	I64 skill;

	//edict 0 is worldspawn, not optional
	if (ent <= 0 || q_fld_spawnflags < 0)
		return FALSE;

	flags = ToI64(QPrFieldF(ent, q_fld_spawnflags));

	//coop takes the SKILL path, not the deathmatch one - deathmatch is forced
	//to 0 above, so monsters spawn exactly as in single player. the coop test
	//is belt and braces in case a cvar was written behind our back
	//
	//deathmatch-only entities carry 1792 (NOT_EASY|NOT_MEDIUM|NOT_HARD) and so
	//stay inhibited by whichever skill line matches - that is how the original
	//keeps DM pads out of a coop game
	if (!q_coop_active && QCvarGet("deathmatch") != 0.0)
		return ToBool(flags & QSPAWNFLAG_NOT_DEATHMATCH);

	//current_skill is the clamped integer, not the raw cvar - skill 3 uses
	//the hard set
	skill = ToI64(QCvarGet("skill") + 0.5);
	skill = ClampI64(skill, 0, 3);

	if (skill == 0 && (flags & QSPAWNFLAG_NOT_EASY))
		return TRUE;
	if (skill == 1 && (flags & QSPAWNFLAG_NOT_MEDIUM))
		return TRUE;
	if (skill >= 2 && (flags & QSPAWNFLAG_NOT_HARD))
		return TRUE;

	return FALSE;
}

I64 QGameSpawnEntities(CQMap *map)
{//walk the entity text, build each edict, run its spawn function
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[160];
	U8	 classname[64];
	U8	 line[128];
	I64	 inhibited = 0;
	I64	 ent;
	I64	 k;
	I64	 fn;
	I64	 spawned = 0;
	Bool first    = TRUE;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end)
	{
		if (*p == '{')
		{
			//the first block is worldspawn, which owns edict 0
			if (first)
			{
				ent   = 0;
				first = FALSE;
			}
			else
				ent = QPrSpawnEdict;

			classname[0] = 0;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 63)
				{
					key[k] = *p;
					k++;
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 159)
				{
					val[k] = *p;
					k++;
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					QStrCopy(classname, val, 64);

				QGameSetField(ent, key, val);
			}

			//ED_LoadFromFile's inhibit test. the map carries EVERY entity for
			//every skill, the engine drops the ones that don't belong
			if (QGameInhibitEntity(ent))
			{
				//name what is dropped - over-inhibiting and a map that really
				//has nothing there look identical on screen
				if (inhibited < 24 && classname[0])
				{
					StrPrint(line, "  inhibit %s (spawnflags %d)\n",
						classname,
						ToI64(QPrFieldF(ent, q_fld_spawnflags)));
					QLog(line);
				}

				QPrFreeEdict(ent);
				inhibited++;
				goto qge_next_ent;
			}

			if (classname[0])
			{
				//the spawn function shares the classname. anything without one
				//(lights, path corners) is data only
				fn = QPrFindFunction(classname);
				if (fn > 0)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(ent));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(fn);
					spawned++;

					if (q_pr_error)
					{
						"QGame: error spawning %s\n", classname;
						q_pr_error = FALSE;
					}

					//the world must stay non-damageable. if a spawn made it
					//damageable, that function ran with self pointing at edict
					//0. name it and repair the invariant
					if (QPrFieldF(0, q_fld_takedamage) != 0.0)
					{
						StrPrint(line, "QGame: %s corrupted world.takedamage\n",
							classname);
						QLog(line);

						QPrSetFieldF(0, q_fld_takedamage, 0.0);
						QPrSetFieldF(0, q_fld_health, 0.0);
					}
				}
			}

qge_next_ent:
		}

		if (p < end)
			p++;
	}

	if (inhibited)
	{
		StrPrint(line, "QGame: %d entities inhibited by skill/deathmatch\n",
			inhibited);
		QLog(line);
	}

	return spawned;
}

//--- entity physics --------------------------------------------------------
//
// SV_Physics. thinks decide what an entity WANTS, this is what moves it -
// without the pass a rocket gets a velocity and hangs motionless in the air
//
// .movetype selects the rule. the split that matters is between things that
// translate (NOCLIP, PUSH), things that fall (TOSS, BOUNCE, STEP), and things
// that must report a collision to QuakeC so it can explode them (FLYMISSILE)

#define QMOVETYPE_NONE			0
#define QMOVETYPE_ANGLENOCLIP	1
#define QMOVETYPE_ANGLECLIP		2
#define QMOVETYPE_WALK			3
#define QMOVETYPE_STEP			4
#define QMOVETYPE_FLY			5
#define QMOVETYPE_TOSS			6
#define QMOVETYPE_PUSH			7
#define QMOVETYPE_NOCLIP		8
#define QMOVETYPE_FLYMISSILE	9
#define QMOVETYPE_BOUNCE		10

#define QPHYS_SV_GRAVITY	800.0
#define QFL_ONGROUND_		512
#define QFL_CLIENT			8
#define QFL_ITEM_			256


U0 QGameLinkAll()
{//refresh every live entity's bounds, once per frame before thinking
	I64 i;

	for (i = 0; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
			QGameLinkEdict(i);
	}
}

U0 QGameCallTouch(I64 self_ent, I64 other_ent)
{//run a touch function with the self/other pair the server would pass
	I64 fn;

	//the world has no touch, and running one puts edict 0 in self inside
	//damage code that was never meant to see it
	if (self_ent <= 0)
		return;

	//touch only dispatches for solid entities - a trigger sets SOLID_NOT the
	//moment it fires and must stop receiving impacts
	if (QPrFieldF(self_ent, q_fld_solid) == ToF64(QSOLID_NOT_))
		return;

	fn = QPrFieldI(self_ent, q_fld_touch);

	if (fn <= 0 || fn >= q_pr_num_functions)
		return;

	QPrSetI(q_ofs_self, QPrEdictValue(self_ent));
	QPrSetI(q_ofs_other, QPrEdictValue(other_ent));
	QPrExecute(fn);
	q_pr_error = FALSE;
}

I64 QGameGroundEntUnder(I64 ent)
{//what this box is resting on, or 0 for none. SV_PushMove carries a rider
 //only when FL_ONGROUND is set AND groundentity IS the pusher, so an entity
 //with the flag but no ground entity is treated as an obstruction and gets
 //crushed instead of lifted
	CQTrace	tr;
	F64		start[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	if (!q_bi_map)
		return 0;

	for (j = 0; j < 3; j++)
	{
		start[j] = QPrFieldF(ent, q_fld_origin + j);
		mins[j]  = QPrFieldF(ent, q_fld_mins + j);
		maxs[j]  = QPrFieldF(ent, q_fld_maxs + j);
	}

	QVecCopy(start, end);
	end[2] -= 1.0;

	QTraceEntity(q_bi_map, start, end, mins, maxs, ent, FALSE, &tr);

	if (tr.fraction >= 1.0 && !tr.all_solid && !tr.start_solid)
		return 0;

	if (tr.ent < 0)
		return 0;			//the world

	return tr.ent;
}

Bool QGameHasGroundUnder(I64 ent)
{//is anything actually supporting this box? one unit is what SV_movestep and
 //the step code treat as contact
	CQTrace	tr;
	F64		start[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	if (!q_bi_map)
		return TRUE;		//no world to test against, do not start falling

	for (j = 0; j < 3; j++)
	{
		start[j] = QPrFieldF(ent, q_fld_origin + j);
		mins[j]  = QPrFieldF(ent, q_fld_mins + j);
		maxs[j]  = QPrFieldF(ent, q_fld_maxs + j);
	}

	QVecCopy(start, end);
	end[2] -= 1.0;

	QTraceEntity(q_bi_map, start, end, mins, maxs, ent, FALSE, &tr);

	return ToBool(tr.fraction < 1.0 || tr.all_solid || tr.start_solid);
}

U0 QGamePhysicsEntity(I64 ent, F64 dt)
{//one entity, one tick
	CQTrace	tr;
	F64		origin[3];
	F64		velocity[3];
	F64		avelocity[3];
	F64		end[3];
	F64		emins[3];
	F64		emaxs[3];
	F64		grav;
	I64		movetype;
	I64		hit;
	I64		j;
	I64		solid;
	Bool	ground_ok;

	movetype = ToI64(QPrFieldF(ent, q_fld_movetype));

	//dispatch by MOVETYPE like SV_Physics_Client, NOT by "is this the player".
	//a WALK player is moved by the player code, but PlayerDie sets TOSS and
	//from there the corpse belongs to SV_Physics_Toss like anything else
	if (movetype == QMOVETYPE_NONE || movetype == QMOVETYPE_WALK)
		return;

	for (j = 0; j < 3; j++)
	{
		origin[j]    = QPrFieldF(ent, q_fld_origin + j);
		velocity[j]  = QPrFieldF(ent, q_fld_velocity + j);
		avelocity[j] = QPrFieldF(ent, q_fld_avelocity + j);
	}

	//anything with an angular velocity spins - rockets, gibs
	if (avelocity[0] != 0.0 || avelocity[1] != 0.0 || avelocity[2] != 0.0)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_angles + j,
				QAngleNorm(QPrFieldF(ent, q_fld_angles + j) +
					avelocity[j] * dt));
	}

	if (movetype == QMOVETYPE_ANGLENOCLIP || movetype == QMOVETYPE_ANGLECLIP)
		return;		//angles only, no translation

	//an entity at rest on the floor is finished - SV_Physics_Toss and _Step
	//both return before gravity AND before the sweep when FL_ONGROUND is set.
	//skipping only gravity isn't enough, nothing here applies friction
	if (movetype == QMOVETYPE_TOSS || movetype == QMOVETYPE_BOUNCE ||
		movetype == QMOVETYPE_STEP)
	{
		if (ToBool(ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_ONGROUND_))
		{
			//NOTE: deviation. FL_ONGROUND is set by the move builtins and by
			//droptofloor, and nothing here ever clears it - SV_movestep does
			//that through FL_PARTIALGROUND, which this port does not carry.
			//so an entity whose floor went away keeps the flag, skips gravity
			//and hangs in the air. re-prove the ground instead of trusting the
			//flag, and drop it when there is nothing underneath
			if (!QGameHasGroundUnder(ent))
			{
				QPrSetFieldF(ent, q_fld_flags,
					ToF64(ToI64(QPrFieldF(ent, q_fld_flags)) &
						~QFL_ONGROUND_));
			}
			else
				return;
		}

		//gravity, scaled by the entity's own multiplier if it has one
		grav = QPrFieldF(ent, q_fld_gravity);
		if (grav <= 0.0)
			grav = 1.0;

		velocity[2] -= QPHYS_SV_GRAVITY * grav * dt;
	}

	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);
		return;
	}

	QVecMA(origin, dt, velocity, end);

	//NOCLIP and PUSH pass through geometry - a door has to move through its
	//own brush volume
	if (movetype == QMOVETYPE_NOCLIP || movetype == QMOVETYPE_PUSH)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_origin + j, end[j]);

		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);

		//brush movers think on their own local clock
		if (movetype == QMOVETYPE_PUSH && q_fld_ltime >= 0)
			QPrSetFieldF(ent, q_fld_ltime, QPrFieldF(ent, q_fld_ltime) + dt);

		return;
	}

	//everything else sweeps against the world AND every solid entity
	for (j = 0; j < 3; j++)
	{
		emins[j] = QPrFieldF(ent, q_fld_mins + j);
		emaxs[j] = QPrFieldF(ent, q_fld_maxs + j);
	}

	//SV_PushEntity's MOVE_NOMONSTERS rule - TRIGGER and NOT clip against
	//brush models only, or a dropped backpack lands on its own corpse
	solid = ToI64(QPrFieldF(ent, q_fld_solid));

	QTraceEntity(q_bi_map, origin, end, emins, emaxs, ent,
		ToBool(solid == QSOLID_TRIGGER_ || solid == QSOLID_NOT_), &tr);
	hit = tr.ent;

	for (j = 0; j < 3; j++)
		QPrSetFieldF(ent, q_fld_origin + j, tr.end_pos[j]);

	if (tr.fraction < 1.0 || hit >= 0)
	{
		if (movetype == QMOVETYPE_BOUNCE || movetype == QMOVETYPE_TOSS ||
			movetype == QMOVETYPE_STEP)
		{
			//BOUNCE reflects and loses energy, everything else slides
			if (movetype == QMOVETYPE_BOUNCE)
				QClipVelocity(velocity, tr.plane_normal, 1.5, velocity);
			else
				QClipVelocity(velocity, tr.plane_normal, 1.0, velocity);

			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);

			//landing flat brings it to REST, not merely grounded - velocity
			//AND avelocity are zeroed. BOUNCE is exempt until it has slowed,
			//so grenades still bounce
			//
			//STEP may only take ground from a brush surface, SV_FlyMove's
			//gate - that is why nothing can stand on a monster. TOSS and
			//BOUNCE have no such gate, a gib really can settle on a corpse
			if (movetype == QMOVETYPE_STEP && tr.ent > 0 &&
				ToI64(QPrFieldF(tr.ent, q_fld_solid)) != QSOLID_BSP_)
				ground_ok = FALSE;
			else
				ground_ok = TRUE;

			if (tr.plane_normal[2] > 0.7 && ground_ok &&
				(movetype != QMOVETYPE_BOUNCE || velocity[2] < 60.0))
			{
				QPrSetFieldF(ent, q_fld_flags,
					ToF64(ToI64(QPrFieldF(ent, q_fld_flags)) | QFL_ONGROUND_));

				//record WHICH entity it landed on, not merely that it landed -
				//SV_PushMove decides who rides by comparing .groundentity
				//against the pusher, and FL_ONGROUND without it leaves a body
				//hanging where the lift abandoned it.
				//the world traces as -1 here but is edict 0 to QuakeC
				if (q_fld_groundentity >= 0)
				{
					if (tr.ent > 0)
						QPrSetFieldI(ent, q_fld_groundentity,
							QPrEdictValue(tr.ent));
					else
						QPrSetFieldI(ent, q_fld_groundentity,
							QPrEdictValue(0));
				}

				for (j = 0; j < 3; j++)
				{
					QPrSetFieldF(ent, q_fld_velocity + j, 0.0);
					QPrSetFieldF(ent, q_fld_avelocity + j, 0.0);
				}
			}
		}
		else
		{
			//FLY and FLYMISSILE just stop, the touch handler decides what
			//that means - for a rocket, exploding
			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, 0.0);
		}

		//tell QuakeC about the collision. the world is edict 0, which is what
		//the missile code expects
		if (hit >= 0)
		{
			QGameCallTouch(ent, hit);
			QGameCallTouch(hit, ent);
		}
		else
			QGameCallTouch(ent, 0);
	}
	else
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);
	}
}

#define QGAME_MAX_PUSHED	256

I64 q_pushed_ent[QGAME_MAX_PUSHED];
F64 q_pushed_from[QGAME_MAX_PUSHED * 3];

U0 QGamePushMove(I64 pusher, F64 movetime)
{//SV_PushMove - translate a door or platform and carry, or crush, whatever
 //is in the way
 //
 //the pusher moves first, then anything inside its new volume is shoved by
 //the same offset. a rider that can't be shoved clear rolls back the WHOLE
 //move and calls .blocked - that rollback is how a door reverses and how a
 //crusher does damage
	F64  move[3];
	F64  mins[3];
	F64  maxs[3];
	F64  pushorig[3];
	F64  entorig[3];
	F64  velocity[3];
	CQTrace tr;
	I64  num_pushed = 0;
	I64  i;
	I64  j;
	I64  movetype;
	I64  solid;
	I64  blocked_fn;
	I64  ground;
	Bool overlaps;

	for (j = 0; j < 3; j++)
		velocity[j] = QPrFieldF(pusher, q_fld_velocity + j);

	//standing still, just advance its clock
	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		QPrSetFieldF(pusher, q_fld_ltime,
			QPrFieldF(pusher, q_fld_ltime) + movetime);
		return;
	}


	for (j = 0; j < 3; j++)
	{
		move[j]     = velocity[j] * movetime;
		pushorig[j] = QPrFieldF(pusher, q_fld_origin + j);
		mins[j]     = QPrFieldF(pusher, q_fld_absmin + j) + move[j];
		maxs[j]     = QPrFieldF(pusher, q_fld_absmax + j) + move[j];
	}

	//pusher to its final position first
	for (j = 0; j < 3; j++)
		QPrSetFieldF(pusher, q_fld_origin + j, pushorig[j] + move[j]);

	QPrSetFieldF(pusher, q_fld_ltime,
		QPrFieldF(pusher, q_fld_ltime) + movetime);
	QGameLinkEdict(pusher);

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == pusher)
			goto qpm_next;

		movetype = ToI64(QPrFieldF(i, q_fld_movetype));
		if (movetype == QMOVETYPE_PUSH || movetype == QMOVETYPE_NONE ||
			movetype == QMOVETYPE_NOCLIP)
			goto qpm_next;

		//anything standing ON the pusher rides unconditionally, otherwise it
		//only matters inside the new volume
		ground = QPrEdictNum(QPrFieldI(i, q_fld_groundentity));

		if (!(ToI64(QPrFieldF(i, q_fld_flags)) & QFL_ONGROUND_) ||
			ground != pusher)
		{
			overlaps = TRUE;
			for (j = 0; j < 3; j++)
			{
				if (QPrFieldF(i, q_fld_absmin + j) >= maxs[j] ||
					QPrFieldF(i, q_fld_absmax + j) <= mins[j])
					overlaps = FALSE;
			}

			if (!overlaps)
				goto qpm_next;

			if (QTestEntityPosition(q_bi_map, i) < 0)
				goto qpm_next;
		}

		//riders other than the player lose ground contact while carried
		if (movetype != QMOVETYPE_WALK)
			QPrSetFieldF(i, q_fld_flags,
				ToF64(ToI64(QPrFieldF(i, q_fld_flags)) & ~QFL_ONGROUND_));

		for (j = 0; j < 3; j++)
			entorig[j] = QPrFieldF(i, q_fld_origin + j);

		if (num_pushed < QGAME_MAX_PUSHED)
		{
			q_pushed_ent[num_pushed] = i;
			for (j = 0; j < 3; j++)
				q_pushed_from[num_pushed * 3 + j] = entorig[j];
			num_pushed++;
		}

		//pusher goes non-solid for the shove, or the rider is blocked by the
		//thing carrying it
		solid = ToI64(QPrFieldF(pusher, q_fld_solid));
		QPrSetFieldF(pusher, q_fld_solid, ToF64(QSOLID_NOT_));

		QPushEntity(q_bi_map, i, move, &tr);

		QPrSetFieldF(pusher, q_fld_solid, ToF64(solid));
		QGameLinkEdict(i);

		//still stuck in the pusher, so this move cannot happen
		if (QTestEntityPosition(q_bi_map, i) >= 0)
		{
			//a zero-width entity can't block anything
			if (QPrFieldF(i, q_fld_mins + 0) == QPrFieldF(i, q_fld_maxs + 0))
				goto qpm_next;

			//corpses and triggers flatten out of the way instead of jamming
			//the door
			solid = ToI64(QPrFieldF(i, q_fld_solid));
			if (solid == QSOLID_NOT_ || solid == QSOLID_TRIGGER_)
			{
				QPrSetFieldF(i, q_fld_mins + 0, 0.0);
				QPrSetFieldF(i, q_fld_mins + 1, 0.0);
				for (j = 0; j < 3; j++)
					QPrSetFieldF(i, q_fld_maxs + j,
						QPrFieldF(i, q_fld_mins + j));
				QGameLinkEdict(i);
				goto qpm_next;
			}

			//rider back
			for (j = 0; j < 3; j++)
				QPrSetFieldF(i, q_fld_origin + j, entorig[j]);
			QGameLinkEdict(i);

			//pusher back, and un-advance its clock
			for (j = 0; j < 3; j++)
				QPrSetFieldF(pusher, q_fld_origin + j, pushorig[j]);
			QPrSetFieldF(pusher, q_fld_ltime,
				QPrFieldF(pusher, q_fld_ltime) - movetime);
			QGameLinkEdict(pusher);

			//QuakeC decides what blocked means - door reverses, crusher does
			//damage, no handler just waits
			blocked_fn = QPrFieldI(pusher, q_fld_blocked);
			if (blocked_fn > 0 && blocked_fn < q_pr_num_functions)
			{
				QPrSetI(q_ofs_self, QPrEdictValue(pusher));
				QPrSetI(q_ofs_other, QPrEdictValue(i));
				QPrExecute(blocked_fn);
				q_pr_error = FALSE;
			}

			//undo everything already carried this move
			for (j = 0; j < num_pushed; j++)
			{
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 0,
					q_pushed_from[j * 3 + 0]);
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 1,
					q_pushed_from[j * 3 + 1]);
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 2,
					q_pushed_from[j * 3 + 2]);
				QGameLinkEdict(q_pushed_ent[j]);
			}

			return;
		}

qpm_next:
	}
}

U0 QGamePhysicsPusher(I64 ent, F64 dt)
{//SV_Physics_Pusher - doors, platforms, buttons
 //
 //these run on their OWN clock. SUB_CalcMove schedules nextthink as
 //ltime + traveltime, NOT time + traveltime, so comparing nextthink against
 //game time fires them at the wrong moment or never
	F64 old_ltime;
	F64 thinktime;
	F64 movetime;
	F64 avelocity[3];
	I64 think;
	I64 j;

	old_ltime = QPrFieldF(ent, q_fld_ltime);
	thinktime = QPrFieldF(ent, q_fld_nextthink);

	//move only as far as the scheduled think, so it lands exactly on time
	//
	//NOTE: there is deliberately no thinktime > 0 guard, SV_Physics_Pusher has
	//none. with nothing scheduled nextthink is 0, movetime clamps to zero, and
	//an idle pusher neither moves nor advances its clock. adding the guard
	//sends it down the else branch and drifts ltime ahead of the schedule its
	//own think times are expressed in
	if (thinktime < old_ltime + dt)
	{
		movetime = thinktime - old_ltime;
		if (movetime < 0.0)
			movetime = 0.0;
	}
	else
		movetime = dt;

	if (movetime > 0.0)
	{
		for (j = 0; j < 3; j++)
			avelocity[j] = QPrFieldF(ent, q_fld_avelocity + j);

		//rotation applies directly, only translation can shove anything
		for (j = 0; j < 3; j++)
		{
			if (avelocity[j] != 0.0)
				QPrSetFieldF(ent, q_fld_angles + j,
					QAngleNorm(QPrFieldF(ent, q_fld_angles + j) +
						avelocity[j] * movetime));
		}

		QGamePushMove(ent, movetime);
	}

	//think when the local clock reaches the scheduled time
	if (thinktime > old_ltime && thinktime <= QPrFieldF(ent, q_fld_ltime))
	{
		QPrSetFieldF(ent, q_fld_nextthink, 0.0);

		think = QPrFieldI(ent, q_fld_think);
		if (think > 0 && think < q_pr_num_functions)
		{
			QPrSetI(q_ofs_self, QPrEdictValue(ent));
			QPrSetI(q_ofs_other, 0);
			QPrExecute(think);
			q_pr_error = FALSE;
			q_game_thinks++;
		}
	}
}

U0 QGameRunPhysics(F64 dt)
{//a touch handler can remove entities mid-pass, so recheck the free flag
	I64 i;
	I64 movetype;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qrp_next;

		movetype = ToI64(QPrFieldF(i, q_fld_movetype));

		//pushers own their think scheduling and skip the ordinary pass
		if (movetype == QMOVETYPE_PUSH)
			QGamePhysicsPusher(i, dt);
		else
			QGamePhysicsEntity(i, dt);

qrp_next:
	}
}

U0 QGameTouchTriggersFor(I64 client)
{//triggers overlapping one client edict, for REMOTE players after their
 //origin is snapped - QGameFrame's pass still sees last frame's position
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	k;
	I64	touch;
	Bool overlap;

	if (client <= 0 || q_pr_edict_free[client])
		return;

	for (k = 0; k < 3; k++)
	{
		amins[k] = QPrFieldF(client, q_fld_absmin + k);
		amaxs[k] = QPrFieldF(client, q_fld_absmax + k);
	}

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == client)
			goto qgtf_next;

		if (ToI64(QPrFieldF(i, q_fld_solid)) != QSOLID_TRIGGER_)
			goto qgtf_next;

		touch = QPrFieldI(i, q_fld_touch);
		if (touch <= 0 || touch >= q_pr_num_functions)
			goto qgtf_next;

		overlap = TRUE;
		for (k = 0; k < 3; k++)
		{
			bmins[k] = QPrFieldF(i, q_fld_absmin + k);
			bmaxs[k] = QPrFieldF(i, q_fld_absmax + k);
			if (amins[k] > bmaxs[k] || amaxs[k] < bmins[k])
				overlap = FALSE;
		}

		if (!overlap)
			goto qgtf_next;

		QPrSetI(q_ofs_self, QPrEdictValue(i));
		QPrSetI(q_ofs_other, QPrEdictValue(client));
		QPrExecute(touch);
		q_pr_error = FALSE;

		//teleporters relocate the client mid-pass
		QGameLinkEdict(client);
		for (k = 0; k < 3; k++)
		{
			amins[k] = QPrFieldF(client, q_fld_absmin + k);
			amaxs[k] = QPrFieldF(client, q_fld_absmax + k);
		}

qgtf_next:
	}
}

U0 QGameTouchTriggersAll()
{//SV_TouchLinks, without the area tree
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	j;
	I64	k;
	I64	touch;
	Bool overlap;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == q_player_edict)
			goto qtt_next;

		if (ToI64(QPrFieldF(i, q_fld_solid)) != QSOLID_TRIGGER_)
			goto qtt_next;

		touch = QPrFieldI(i, q_fld_touch);
		if (touch <= 0 || touch >= q_pr_num_functions)
			goto qtt_next;

		for (k = 0; k < 3; k++)
		{
			amins[k] = QPrFieldF(i, q_fld_absmin + k);
			amaxs[k] = QPrFieldF(i, q_fld_absmax + k);
		}

		for (j = 1; j < q_pr_num_edicts; j++)
		{
			if (q_pr_edict_free[j] || j == i)
				goto qtt_inner;

			//only touchable things, and never another trigger
			if (ToI64(QPrFieldF(j, q_fld_solid)) == QSOLID_TRIGGER_ ||
				ToI64(QPrFieldF(j, q_fld_solid)) == QSOLID_NOT_)
				goto qtt_inner;

			overlap = TRUE;
			for (k = 0; k < 3; k++)
			{
				bmins[k] = QPrFieldF(j, q_fld_absmin + k);
				bmaxs[k] = QPrFieldF(j, q_fld_absmax + k);

				if (bmins[k] > amaxs[k] || bmaxs[k] < amins[k])
					overlap = FALSE;
			}

			if (!overlap)
				goto qtt_inner;

			QPrSetI(q_ofs_self, QPrEdictValue(i));
			QPrSetI(q_ofs_other, QPrEdictValue(j));
			QPrExecute(touch);
			q_pr_error = FALSE;

qtt_inner:
		}

qtt_next:
	}
}

U0 QGameForceRetouch()
{//re-link every entity and re-run trigger touches for a frame or two
 //
 //touches normally only fire when something MOVES, so spawn_tdeath sets
 //force_retouch = 2 to catch an entity resting inside a freshly spawned
 //trigger. without it a telefrag on an occupied destination silently fails
	I64 retouch;
	I64 i;

	if (q_ofs_force_retouch < 0)
		return;

	retouch = ToI64(QPrGetF(q_ofs_force_retouch));
	if (retouch <= 0)
		return;

	//bounds first, a trigger spawned this frame has none yet
	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
			QGameLinkEdict(i);
	}

	QGameTouchTriggersAll;

	QPrSetF(q_ofs_force_retouch, ToF64(retouch - 1));
}

U0 QGameRunThinks()
{//thinks can spawn or free other entities, so re-read the bound each pass
	I64 i;
	I64 think;
	I64 flags;
	F64 nextthink;
	U8  wline[128];

	i = 0;
	while (i < q_pr_num_edicts)
	{
		//pushers already thought in the physics pass on their local clock,
		//running them here fires the think twice. FL_CLIENT thinks run after
		//PlayerPostThink, the SV_Physics_Client order
		flags = 0;
		if (!q_pr_edict_free[i])
			flags = ToI64(QPrFieldF(i, q_fld_flags));

		if (!q_pr_edict_free[i] &&
			ToI64(QPrFieldF(i, q_fld_movetype)) != QMOVETYPE_PUSH &&
			!(flags & QFL_CLIENT))
		{
			nextthink = QPrFieldF(i, q_fld_nextthink);

			if (nextthink > 0.0 && nextthink <= q_game_time)
			{
				//clear BEFORE calling, the think usually reschedules itself
				QPrSetFieldF(i, q_fld_nextthink, 0.0);

				think = QPrFieldI(i, q_fld_think);
				if (think > 0 && think < q_pr_num_functions)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(think);
					q_game_thinks++;

					if (q_pr_error)
						q_pr_error = FALSE;

					//same invariant as at spawn - whichever think leaves the
					//world damageable ran with self pointing at edict 0.
					//reported once, so the log names it
					if (QPrFieldF(0, q_fld_takedamage) != 0.0)
					{
						if (!q_world_warned)
						{
							StrPrint(wline,
								"QGame: think of %s corrupted world.takedamage\n",
								QPrStr(QPrFieldI(i, q_fld_classname)));
							QLog(wline);
							q_world_warned = TRUE;
						}

						QPrSetFieldF(0, q_fld_takedamage, 0.0);
						QPrSetFieldF(0, q_fld_health, 0.0);
					}
				}
			}
		}

		i++;
	}
}

//set when a coop game swallowed a "restart" - the remote pass in QSvRunClients
//picks it up and respawns the other bodies. NOT zeroed by the loader
Bool q_coop_respawn_pending = FALSE;

Bool QGameCoopRespawn(I64 ent)
{//respawn(), coop branch of client.qc:
 //    CopyToBodyQue (self); setspawnparms (self); PutClientInServer ();
 //
 //back into the RUNNING level - no map reload, so nobody else loses progress
	I64 fn;
	I64 slot;
	I64 ofs;
	I64 i;

	if (ent <= 0 || ent >= q_pr_num_edicts || q_pr_edict_free[ent])
		return FALSE;

	//leave a corpse where they fell, as the original does
	fn = QPrFindFunction("CopyToBodyQue");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//setspawnparms: the kit this client had at LEVEL START, not at death.
	//clients are edicts 1..maxclients, so the slot is the edict minus one
	slot = ent - 1;
	if (slot >= 0 && slot < QSV_MAX_CLIENTS && q_client_parms_set[slot])
	{
		for (i = 0; i < QGAME_MAX_PARMS; i++)
		{
			ofs = q_ofs_parms[i];
			if (ofs >= 0)
				QPrSetF(ofs,
					q_client_parms[slot * QPR_MAX_PARM_GLOBALS + i]);
		}
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
		return FALSE;

	QPrSetI(q_ofs_self, QPrEdictValue(ent));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	QGameLinkEdict(ent);

	return TRUE;
}

U0 QGameFrame(F64 dt)
{//advance game time, run one round of thinking
	I64 fn;

	if (!q_game_active)
		return;

	q_game_time += dt;

	//SV_SpawnServer publishes the game mode globals. they must be explicitly
	//zero in single player - CheatCommand (impulse 9) returns early on
	//deathmatch || coop
	QGameApplyModeCvars;

	//skill sits outside pr_global_struct, at global offset 349, and progs
	//never writes it - the engine publishes it by name via ED_FindGlobal.
	//left at 0, every monster behaves as if on Easy
	if (q_ofs_skill >= 0)
		QPrSetF(q_ofs_skill, QCvarGet("skill"));

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, dt);

	fn = QPrFindFunction("StartFrame");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, 0);
		QPrExecute(fn);
		if (q_pr_error)
			q_pr_error = FALSE;
	}

	//bounds first, so absmin/absmax match where entities actually are
	QGameLinkAll;

	//physics before thinks, the server order - move, touch, then think.
	//reversed, rockets explode a tick late.
	//retouch runs before physics, as SV_Physics does
	QGameForceRetouch;

	QGameRunPhysics(dt);
	QGameRunThinks;

	//COOP MUST NOT RELOAD THE LEVEL ON A DEATH. stock client.qc already avoids
	//it - respawn() only reaches localcmd("restart\n") on the single player
	//branch - but a mod that got here anyway would throw away every other
	//player's progress, so the request is swallowed and serviced in place
	//
	//the local body is done here, right before the shell adopts .origin off the
	//edict. remotes are cached in the server slots, so QSvRunClients redoes
	//them where it can also fix the cache
	if (q_coop_active && q_restart_pending)
	{
		q_restart_pending = FALSE;
		QLog("QGame: coop - respawning in place, not restarting\n");

		if (q_player_edict > 0 &&
			QPrFieldF(q_player_edict, q_fld_health) <= 0.0)
			QGameCoopRespawn(q_player_edict);

		q_coop_respawn_pending = TRUE;
	}
}

U0 QGameSaveParms()
{//SetChangeParms packs the inventory into parm1..parm16, keep a copy. the
 //game logic owns the rules, the engine only carries the result
	I64	fn;
	I64	ofs;
	I64	i;
	I64	slot;
	I64	ent;
	F64	value;

	q_have_saved_parms = FALSE;

	if (!q_game_active || q_player_edict <= 0)
		return;

	fn = QPrFindFunction("SetChangeParms");

	//SV_SaveSpawnparms runs SetChangeParms for EVERY client and stores the
	//result on that client - in coop each player carries their own kit across
	//the level change, so one shared copy would hand everyone the host's
	//loadout. clients are edicts 1..maxclients
	for (slot = 0; slot < QSV_MAX_CLIENTS; slot++)
	{
		ent = slot + 1;

		if (ent >= q_pr_num_edicts || q_pr_edict_free[ent])
			goto qsp_next;
		if (!(ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_CLIENT))
			goto qsp_next;

		if (fn > 0)
		{
			QPrSetI(q_ofs_self, QPrEdictValue(ent));
			QPrExecute(fn);
			q_pr_error = FALSE;
		}

		for (i = 0; i < QGAME_MAX_PARMS; i++)
		{
			ofs = q_ofs_parms[i];
			if (ofs < 0)
				goto qsp_next_parm;

			//via a temp - this compiler computes the slot address before
			//evaluating the call and can lose the store
			value = QPrGetF(ofs);
			q_client_parms[slot * QPR_MAX_PARM_GLOBALS + i] = value;

qsp_next_parm:
		}

		q_client_parms_set[slot] = TRUE;

qsp_next:
	}

	//the local player's set is also the one restored into the freshly loaded
	//bytecode, so worldspawn and the first ClientConnect see something sane
	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		q_saved_parms[i] = 0.0;
		ofs = q_ofs_parms[i];

		if (ofs >= 0)
		{
			value = q_client_parms[i];
			q_saved_parms[i] = value;
		}
	}

	//serverflags tracks which episode runes are collected. it is a progs
	//GLOBAL, not a client field - episode progression is SHARED in coop, so it
	//is read once here and never stamped per player
	if (q_ofs_serverflags >= 0)
	{
		value = QPrGetF(q_ofs_serverflags);
		q_saved_serverflags = value;
	}

	q_have_saved_parms = TRUE;
}

U0 QGameClearParms()
{//a death restart must NOT hand back the items the player died with
	q_have_saved_parms = FALSE;
}

U0 QGameRestoreParms()
{//back into the freshly loaded bytecode before the player spawns -
 //ClientConnect reads these to rebuild the loadout
	I64	ofs;
	I64	i;

	if (!q_have_saved_parms)
		return;

	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		ofs = q_ofs_parms[i];
		if (ofs >= 0)
			QPrSetF(ofs, q_saved_parms[i]);
	}

	if (q_ofs_serverflags >= 0)
		QPrSetF(q_ofs_serverflags, q_saved_serverflags);
}

U0 QDropPunchAngle(I64 ent, F64 dt)
{//DropPunchAngle, top of SV_ClientThink
 //
 //the decay lives HERE, not in QuakeC - the weapons set .punchangle and never
 //clear it, so without this the view stays pitched down forever
 //
 //normalise, shorten by 10/sec, scale back, so it decays along its own axis
	F64 v[3];
	F64 len;
	I64 j;

	if (ent <= 0 || q_fld_punchangle < 0)
		return;

	for (j = 0; j < 3; j++)
		v[j] = QPrFieldF(ent, q_fld_punchangle + j);

	len = QVecLength(v);
	if (len <= 0.0)
		return;

	for (j = 0; j < 3; j++)
		v[j] /= len;

	len -= 10.0 * dt;
	if (len < 0.0)
		len = 0.0;

	for (j = 0; j < 3; j++)
		QPrSetFieldF(ent, q_fld_punchangle + j, v[j] * len);
}

Bool QGameInit(CQMap *map, Bool spawn_entities = TRUE)
{//load the bytecode, wire the builtins, populate the world
 //
 //spawn_entities is FALSE when a savegame supplies the entity state - the
 //bytecode still has to come up, but spawn side effects would linger past
 //the restore that overwrites them
	I64 i;
	I64 ent;

	q_game_active  = FALSE;

	q_game_time    = 1.0;		//QuakeC reads time 0 as never scheduled
	q_game_thinks  = 0;
	q_game_spawned = 0;

	//globals aren't zeroed
	q_coop_active          = FALSE;
	q_coop_respawn_pending = FALSE;

	if (!QPrLoad("progs.dat", QGAME_MAX_EDICTS))
		return FALSE;

	QPrCacheOffsets;
	QBiInit;
	q_bi_map = map;

	//BEFORE ANY SPAWN RUNS. QGameInhibitEntity reads the resolved pair for
	//every map entity, and PutClientInServer -> SelectSpawnPoint reads the
	//coop global to pick info_player_coop over info_player_start. published
	//only per-frame it would be 0 for the whole spawn pass, and coop players
	//would all pile onto the single player start
	QGameApplyModeCvars;

	//before any spawn runs - slot 1 = world, 2..N = its submodels
	QBiPrecacheWorld(map, q_map_name);

	//without these the image isn't stock QuakeC and would fault confusingly
	if (q_ofs_self < 0 || q_ofs_time < 0 || q_fld_nextthink < 0 ||
		q_fld_think < 0)
	{
		"QGame: progs.dat is missing required symbols\n";
		return FALSE;
	}

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, QGAME_FRAME_TIME);

	//RESERVE EVERY CLIENT EDICT BEFORE ANY MAP ENTITY SPAWNS. SV_SpawnServer:
	//    sv.num_edicts = svs.maxclients + 1;
	//    for (i = 0; i < svs.maxclients; i++)
	//        svs.clients[i].edict = EDICT_NUM(i + 1);
	//clients are always edicts 1..maxclients. .colormap IS the edict number
	//and the client reads cl.scores[colormap - 1], so a player at edict 11
	//with maxclients 4 is not representable on the wire
	//svs.maxclients, NOT the compile-time ceiling. the original reserves
	//exactly as many as the server accepts, so a solo game reserves one and
	//world entities start at edict 2
	for (i = 0; i < q_sv_maxclients; i++)
	{
		ent = QPrSpawnEdict;

		if (i == 0)
			q_player_edict = ent;
	}

	//carried in from the previous level, restored before anything spawns so
	//worldspawn and ClientConnect both see it
	QGameRestoreParms;

	//NOTE: no main() call. world.qc defines one but documents it as test
	//scaffolding, and SV_SpawnServer never runs it

	if (spawn_entities)
	{
		q_game_spawned = QGameSpawnEntities(map);
		QHeapCheck("after map spawn");
	}
	else
	{
		//a savegame restores the precache lists from the file instead
		q_game_spawned = 0;
	}

	//the world must never be damageable - T_Damage bails on it, and edict 0
	//has no death function, so getting through means a null call on every hit
	QPrSetFieldF(0, q_fld_takedamage, 0.0);
	QPrSetFieldF(0, q_fld_health, 0.0);
	QPrSetFieldF(0, q_fld_solid, ToF64(QSOLID_BSP_));

	q_game_active  = TRUE;

	"QGame: %d entities spawned, %d edicts live\n",
		q_game_spawned, q_pr_num_edicts;

	return TRUE;
}

U0 QGameShutdown()
{//the player handle dies WITH the vm - QPrStr hands back pointers into the
 //string blob QPrFree is about to release, and every QPlayer accessor gates on
 //q_player_active alone
	q_game_active    = FALSE;
	q_player_active  = FALSE;
	q_player_edict   = 0;
	q_bi_map      = NULL;

	//per-map state, all pointing at things about to be freed
	//
	//breadcrumbed: a fault in any of these lands inside the allocator, where
	//the backtrace names Free and nothing else. the last line names the step
	QLog("  shutdown: statics\n");	QLogFlush;
	QBiStaticClear;
	QBiBeamsClear;
	QBiIntermissionClear;
	QBiCenterClear;

	QLog("  shutdown: lights/ambients\n");	QLogFlush;
	QDlightClear;
	QSndAmbientClear;
	QLightInit;

	QLog("  shutdown: precache\n");	QLogFlush;
	QBiFreePrecache;

	QLog("  shutdown: bsp models\n");	QLogFlush;
	QBiBspCacheFree;
	QBiSprCacheFree;

	QLog("  shutdown: progs\n");	QLogFlush;
	QPrFree;

	QLog("  shutdown: ok\n");	QLogFlush;
}

U0 QGameDrawStatics(CQCanvas *c, CQMap *map)
{//statics are not edicts any more, so they draw from their own list
	CQStaticEnt	*se;
	F64			 d[3];
	I64			 i;

	for (i = 0; i < q_static_count; i++)
	{
		se = &q_static_ent[i];

		if (!se->mdl)
			goto qds_next;

		QVecSub(se->origin, c->origin, d);
		if (QVecLength(d) > QGAME_STATIC_DIST)
			goto qds_next;

		QMdlDraw(c, se->mdl, se->frame, se->origin, se->angles[1],
			QLightPoint(map, se->origin));

qds_next:
	}
}

//protocol effect flags. QuakeC sets .effects, the client turns them into light
#define QEF_BRIGHTFIELD		1
#define QEF_MUZZLEFLASH		2
#define QEF_BRIGHTLIGHT		4
#define QEF_DIMLIGHT		8

U0 QGameEntityLights(F64 time)
{//.effects -> dynamic lights, once per frame
 //
 //these move, so none of it can come from the compiled lightmap. re-added
 //every frame with a one frame lifetime, which pins them to the entity
	F64 org[3];
	I64 effects;
	I64 i;
	I64 j;

	if (q_fld_effects < 0)
		return;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qel_next;

		effects = ToI64(QPrFieldF(i, q_fld_effects));
		if (!effects)
			goto qel_next;

		for (j = 0; j < 3; j++)
			org[j] = QPrFieldF(i, q_fld_origin + j);

		if (effects & QEF_MUZZLEFLASH)
		{
			//the flash sits in front of the eye, not at the feet
			org[2] += 16.0;
			QDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.1, 0.0, time);
			org[2] -= 16.0;

			//the SERVER clears this bit after showing it once, which is what
			//makes it a FLASH - QuakeC only ever sets it. without the clear
			//the light is stuck on for the rest of the level.
			//SV_WriteEntitiesToClient does this
			QPrSetFieldF(i, q_fld_effects,
				ToF64(effects & ~QEF_MUZZLEFLASH));
		}

		if (effects & QEF_BRIGHTLIGHT)
		{
			org[2] += 16.0;
			QDlightAdd(org, 400.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);
			org[2] -= 16.0;
		}

		if (effects & QEF_DIMLIGHT)
			QDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);

qel_next:
	}
}

//QFL_CLIENT is defined with the physics flags above

#define QPL_MINS_XY		-16.0
#define QPL_MAXS_XY		16.0
#define QPL_MINS_Z		-24.0
#define QPL_MAXS_Z		32.0
#define QPL_VIEW_OFS_Z	22.0

U0 QEdictSetVec(I64 ent, I64 fld, F64 x, F64 y, F64 z)
{
	QPrSetFieldF(ent, fld, x);
	QPrSetFieldF(ent, fld + 1, y);
	QPrSetFieldF(ent, fld + 2, z);
}

Bool QClientSpawnAt(I64 ent, F64 *origin, F64 *angles, U8 *player_name)
{//outfit ANY edict as a client. the local player is just the first
 //
 //split out of QPlayerSpawn so a remote client gets a body through the
 //identical path - SetNewParms, ClientConnect, PutClientInServer
 //
 //.netname is set BEFORE ClientConnect so the join bprint has a name
	I64  fn;
	U8  *netname;

	if (ent <= 0)
		return FALSE;

	//SelectSpawnPoint reads the coop and deathmatch GLOBALS, not the cvars:
	//coop -> "info_player_coop" (falling back to info_player_start when the
	//map has none), deathmatch -> the info_player_deathmatch ring. resolve
	//them again here so a mode change between levels cannot spawn a late
	//joiner by the previous game's rules
	QGameApplyModeCvars;

	if (!player_name || !player_name[0])
		netname = "player";
	else
		netname = player_name;

	QEdictSetVec(ent, q_fld_origin, origin[0], origin[1], origin[2]);
	QEdictSetVec(ent, q_fld_angles, 0.0, angles[1], 0.0);
	QEdictSetVec(ent, q_fld_v_angle, 0.0, angles[1], 0.0);
	QEdictSetVec(ent, q_fld_velocity, 0.0, 0.0, 0.0);
	QEdictSetVec(ent, q_fld_mins, QPL_MINS_XY, QPL_MINS_XY, QPL_MINS_Z);
	QEdictSetVec(ent, q_fld_maxs, QPL_MAXS_XY, QPL_MAXS_XY, QPL_MAXS_Z);
	QEdictSetVec(ent, q_fld_view_ofs, 0.0, 0.0, QPL_VIEW_OFS_Z);

	QPrSetFieldF(ent, q_fld_flags, ToF64(QFL_CLIENT));
	QPrSetFieldI(ent, q_fld_classname, QPrNewString("player"));
	QPrSetFieldI(ent, q_fld_netname, QPrNewString(netname));

	fn = QPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
		return FALSE;

	QPrSetI(q_ofs_self, QPrEdictValue(ent));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	//PutClientInServer can wipe runtime fields, pin the name again so frags
	//and obituaries still see it
	QPrSetFieldI(ent, q_fld_netname, QPrNewString(netname));

	//PutClientInServer picks the spawn point, so hand back what it chose
	origin[0] = QPrFieldF(ent, q_fld_origin);
	origin[1] = QPrFieldF(ent, q_fld_origin + 1);
	origin[2] = QPrFieldF(ent, q_fld_origin + 2);

	return TRUE;
}

U0 QGameDrawEntities(CQCanvas *c, CQMap *map, F64 *view_origin, F64 max_dist)
{//every live entity with a model
	F64		eorg[3];
	F64		eang[3];
	F64		d[3];
	CQMdl	*mdl;
	I64		 i;
	I64		 idx;
	I64		 frame;
	I64		 bm;
	I64		 top;
	I64		 bottom;
	I64		 cmap;
	U8		*name;
	U8		*mstr;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qg_next;

		//never draw the player's own body in first person - the model exists
		//for other clients and demos, from inside the head it wraps the camera
		if (i == q_player_edict)
			goto qg_next;

		idx = ToI64(QPrFieldF(i, q_fld_modelindex));
		if (idx <= 0 || idx >= q_precache_model_count)
			goto qg_next;

		//THE MODEL STRING MUST BE CHECKED TOO, not just the index. QuakeC
		//hides a picked-up item by nulling .model, which leaves .modelindex
		//alone - only setmodel writes that. SV_WriteEntitiesToClient:
		//    if (!ent->v.modelindex || !pr_strings[ent->v.model])
		mstr = QPrStr(QPrFieldI(i, q_fld_model));
		if (!mstr || !mstr[0])
			goto qg_next;

		eorg[0] = QPrFieldF(i, q_fld_origin);
		eorg[1] = QPrFieldF(i, q_fld_origin + 1);
		eorg[2] = QPrFieldF(i, q_fld_origin + 2);

		name = q_precache_model[idx];

		//brush models are map geometry and go through the face path. the
		//ORIGIN goes with them or every door draws shut
		//
		//BEFORE the distance cull and deliberately not subject to it: a brush
		//entity's .origin is an OFFSET from where the brushes were authored,
		//not a position - e1m1's water lift parks at (0,0,-400). culling on
		//that offset made the lift vanish while its collision stayed. the
		//original culls these by PVS and frustum, never by distance
		if (name[0] == '*')
		{
			bm = QClipBrushModel(idx);
			if (bm > 0)
				//.frame selects the alternate texture chain - a button lit
				//while pressed, a door with its lamp on
				QDrawBrushModel(c, map, bm, eorg,
					ToI64(QPrFieldF(i, q_fld_frame)));
			goto qg_next;
		}

		//sprites always face the eye, so they need no angles
		if (idx > 0 && idx < QBI_MAX_PRECACHE && q_precache_spr[idx])
		{
			QVecSub(eorg, view_origin, d);
			if (QVecLength(d) > max_dist)
				goto qg_next;

			QSprDraw(c, q_precache_spr[idx],
				ToI64(QPrFieldF(i, q_fld_frame)), eorg,
				QLightPoint(map, eorg));
			goto qg_next;
		}

		//an external .bsp (ammo box, crate) is a brush model in its own file,
		//and its origin IS a real position, unlike a submodel's
		if (idx > 0 && idx < QBI_MAX_PRECACHE && q_precache_bsp[idx])
		{
			QVecSub(eorg, view_origin, d);
			if (QVecLength(d) > max_dist)
				goto qg_next;

			QDrawBrushModel(c, q_precache_bsp[idx], 0, eorg,
				ToI64(QPrFieldF(i, q_fld_frame)));
			goto qg_next;
		}

		//CL_RelinkEntities' trail pass, BEFORE the distance reject on purpose
		//- the trail is particles in the world, not this entity's drawing
		if (idx > 0 && idx < QBI_MAX_PRECACHE && q_precache_mdl[idx])
			QPartEntityTrail(i, eorg, q_precache_mdl[idx]->flags, tS);

		//alias models are point entities, so a distance reject is meaningful
		QVecSub(eorg, view_origin, d);
		if (QVecLength(d) > max_dist)
			goto qg_next;

		eang[0] = QPrFieldF(i, q_fld_angles);
		eang[1] = QPrFieldF(i, q_fld_angles + 1);
		eang[2] = QPrFieldF(i, q_fld_angles + 2);

		if (!StrICompare(name, "progs/player.mdl"))
		{
			cmap = 0;
			if (q_fld_colormap >= 0)
				cmap = ToI64(QPrFieldF(i, q_fld_colormap));

			//.colormap is a client number, the colours are in the scoreboard
			QSvColorsForColormap(cmap, &top, &bottom);
			mdl = QMdlPreviewGet(top, bottom);
		}
		else
			mdl = q_precache_mdl[idx];

		if (!mdl)
			goto qg_next;

		frame = ToI64(QPrFieldF(i, q_fld_frame));
		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		//CL_RelinkEntities spins powerups and runes on the CLIENT from one
		//shared clock, so they turn in unison - nothing in QuakeC drives it,
		//the flag is in the model file. drawn copy only, writing the edict
		//would fight the game logic
		if (mdl->flags & QMDLF_ROTATE)
			eang[1] = QAngleNorm(100.0 * q_game_time);

		//lit from the surface underneath, not a flat constant
		//full orientation, not just yaw - SV_ClientThink leans a player's body
		//by a third of their view pitch and the yaw-only call threw it away,
		//so remote players always looked level here while other engines
		//rendered them correctly off the same wire data
		QMdlDrawAngles(c, mdl, frame, eorg, eang, QLightPoint(map, eorg));

qg_next:
	}
}
