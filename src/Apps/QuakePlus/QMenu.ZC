//--- preferences ------------------------------------------------------------
//
// plain text beside the game data, one "key value" per line. not a struct dump
// so it survives fields being added or removed - unknown keys are skipped and
// missing ones keep their default
//
// per-machine state, not source. in .gitignore
#define QCFG_PATH	"QUAKECFG.TXT"

U0 QSetupDefaults()
{//globals aren't zeroed and QCfgLoad runs before QMenuInit, so defaults must
 //land first or a config with no name line leaves junk in the buffer
	//bindings included - a config predating the customize page has no bind
	//lines, and an unset scancode matches nothing
	QBindDefaults;
	QHostNameInit;
	QAliasInit;

	//the host cache is a global table with a global count - unset, slist walks
	//off the end of it before a single reply has arrived
	QSlistInit;

	//the episode/level tables are globals too - unset, game options reads
	//null map names
	QGoInit;

	q_opt_crosshair = 0;

	QStrCopy(q_setup_name, "player", 16);
	q_setup_top     = 0;
	q_setup_bottom  = 0;
	q_setup_editing   = FALSE;
	q_setup_ate_enter = FALSE;
	q_setup_len       = 6;

	QStrCopy(q_lan_addr, "10.0.0.1", 24);
	q_lan_len       = 8;
	q_lan_row       = 0;
	q_lan_editing   = FALSE;
	q_lan_ate_enter = FALSE;
	q_mp_start_dm   = FALSE;
	q_mp_row        = 0;
	q_set_row       = 0;

	//QCfgLoad reads this before the archives are mounted
	q_game_dir[0]   = 0;
}

U0 QCfgSave()
{//called whenever an option changes
	U8 buf[512];

	StrPrint(buf,
		"sensitivity %d\n"
		"volume %d\n"
		"res %d\n"
		"fullscreen %d\n"
		"gamma %d\n"
		"gunclip %d\n"
		"musicvol %d\n"
		"hostname %s\n"
		"crosshair %d\n"
		"bindfwd %d\n"
		"bindback %d\n"
		"bindleft %d\n"
		"bindright %d\n"
		"bindjump %d\n"
		"topcolor %d\n"
		"bottomcolor %d\n"
		"name %s\n"
		"game %s\n",
		ToI64(q_opt_sensitivity * 1000.0),
		q_opt_volume,
		q_opt_res,
		ToI64(q_opt_fullscreen),
		ToI64(q_opt_gamma * 1000.0),
		ToI64(q_opt_gunclip),
		ToI64(q_music_volume * 1000.0),
		q_host_name,
		q_opt_crosshair,
		q_bind_key[QBIND_FORWARD],
		q_bind_key[QBIND_BACK],
		q_bind_key[QBIND_LEFT],
		q_bind_key[QBIND_RIGHT],
		q_bind_key[QBIND_JUMP],
		q_setup_top,
		q_setup_bottom,
		q_setup_name,
		q_game_dir);

	//thousandths, so the file holds no float text to parse
	if (!q_disk_writes)
		return;

	FileWrite(QCFG_PATH, buf, StrLen(buf));
}

I64 QCfgValue(U8 *line)
{//the integer after the first space, or 0
	I64 i = 0;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	return Str2I64(line + i);
}

U0 QCfgLoad()
{//anything missing or unparsable keeps its default
	U8	*raw;
	U8	 line[128];
	I64	 size = 0;
	I64	 i    = 0;
	I64	 n;
	I64	 v;

	raw = FileRead(QCFG_PATH, &size);
	if (!raw)
		return;

	while (i < size)
	{
		//bounded line copy
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 127)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qcl_next;

		v = QCfgValue(line);

		if (!StrNICompare(line, "sensitivity ", 12))
			q_opt_sensitivity = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "volume ", 7))
			q_opt_volume = ClampI64(v, 0, 100);
		else if (!StrNICompare(line, "res ", 4))
			q_opt_res = ClampI64(v, 0, QRES_COUNT - 1);
		else if (!StrNICompare(line, "gunclip ", 8))
			q_opt_gunclip = ToBool(v != 0);
		else if (!StrNICompare(line, "musicvol ", 9))
			q_music_volume = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "hostname ", 9))
			QStrCopy(q_host_name, line + 9, 32);
		else if (!StrNICompare(line, "crosshair ", 10))
			q_opt_crosshair = v;
		else if (!StrNICompare(line, "bindfwd ", 8))
			q_bind_key[QBIND_FORWARD] = v;
		else if (!StrNICompare(line, "bindback ", 9))
			q_bind_key[QBIND_BACK] = v;
		else if (!StrNICompare(line, "bindleft ", 9))
			q_bind_key[QBIND_LEFT] = v;
		else if (!StrNICompare(line, "bindright ", 10))
			q_bind_key[QBIND_RIGHT] = v;
		else if (!StrNICompare(line, "bindjump ", 9))
			q_bind_key[QBIND_JUMP] = v;
		else if (!StrNICompare(line, "topcolor ", 9))
			q_setup_top = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "bottomcolor ", 12))
			q_setup_bottom = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "name ", 5))
			QStrCopy(q_setup_name, line + 5, 16);
		else if (!StrNICompare(line, "game ", 5))
			QStrCopy(q_game_dir, line + 5, 32);
		else if (!StrNICompare(line, "fullscreen ", 11))
			q_opt_fullscreen = ToBool(v);
		else if (!StrNICompare(line, "gamma ", 6))
			q_opt_gamma = ToF64(v) / 1000.0;

qcl_next:
	}

	Free(raw);

	//a hand-edited file can hold anything, clamp before pushing to hardware
	if (q_opt_sensitivity < 0.02)	q_opt_sensitivity = 0.02;
	if (q_opt_sensitivity > 0.60)	q_opt_sensitivity = 0.60;

	//scale the mix, not the AC97 master - that register is system wide
	q_snd_master = ToF64(q_opt_volume) / 100.0;
	QPalSetGamma(q_opt_gamma);
}

//the menu is authored for 320x200. every fixed coordinate is offset by this
//so the page moves as one block, the same term M_DrawPic adds
#define QMENU_VW	320

//M_DrawSlider's conchars pieces: 128 left cap, 129 trough, 130 right cap,
//131 handle. range 0..1 positions the handle
#define QSLIDER_CELLS	10

U0 QMenuBackdrop(CQCanvas *c)
{//M_Draw's rule: with a game running the world stays up and dimmed, so the
 //menu reads as an overlay. only outside a game does conback fill the screen
	if (q_menu_ingame)
	{
		QDrawFadeScreen(c);
		return;
	}

	MemSet(c->pixels, 0, c->width * c->height);

	if (q_pic_conback.pixels)
		QPicDrawFill(c, &q_pic_conback);
}

U0 QMenuSlider(CQCanvas *c, I64 x, I64 y, F64 range)
{
	I64 i;

	if (range < 0.0)	range = 0.0;
	if (range > 1.0)	range = 1.0;

	QCharDraw(c, x - QCHAR_W, y, 128);

	for (i = 0; i < QSLIDER_CELLS; i++)
		QCharDraw(c, x + i * QCHAR_W, y, 129);

	QCharDraw(c, x + QSLIDER_CELLS * QCHAR_W, y, 130);

	QCharDraw(c, x + ToI64((QSLIDER_CELLS - 1) * QCHAR_W * range), y, 131);
}

I64 QMenuXOfs(CQCanvas *c)
{
	I64 ofs = (c->width - QMENU_VW) / 2;

	if (ofs < 0)
		ofs = 0;

	return ofs;
}

U0 QMenuSound(U8 *name)
{
	QSndPlayAt(name, q_snd_listener, 1.0, 0.0);
}

U0 QMenuInit()
{//globals aren't zeroed, a junk request flag saves or loads with no world
	q_sp_row        = 0;
	q_menu_save_req = FALSE;
	q_menu_load_req = FALSE;

	U8	name[24];
	I64	i;

	QPicLoad("gfx/mainmenu.lmp", &q_pic_mainmenu);
	QPicLoad("gfx/ttl_main.lmp", &q_pic_ttlmain);
	QPicLoad("gfx/qplaque.lmp", &q_pic_qplaque);
	QPicLoad("gfx/conback.lmp", &q_pic_conback);

	for (i = 0; i < QHELP_PAGES; i++)
	{
		StrPrint(name, "gfx/help%d.lmp", i);
		QPicLoad(name, &q_pic_help[i]);
	}
	QPicLoad("gfx/sp_menu.lmp", &q_pic_sp_menu);
	QPicLoad("gfx/ttl_sgl.lmp", &q_pic_p_single);
	QPicLoad("gfx/p_multi.lmp", &q_pic_p_multi);
	QPicLoad("gfx/mp_menu.lmp", &q_pic_mp_menu);
	QPicLoad("gfx/p_option.lmp", &q_pic_p_option);
	QPicLoad("gfx/menuplyr.lmp", &q_pic_menuplyr);

	for (i = 0; i < 6; i++)
	{
		StrPrint(name, "gfx/menudot%d.lmp", i + 1);
		QPicLoad(name, &q_pic_cursor[i]);
	}

	for (i = 0; i < QCON_LINES; i++)
		q_con_time[i] = -1000.0;

	for (i = 0; i < QCON_LINES * QCON_WIDTH; i++)
		q_con_text[i] = 0;

	q_con_line     = 0;
	q_con_ready    = TRUE;
	q_state        = QST_MENU;
	q_menu_row     = 0;
	q_menu_ingame  = FALSE;
	q_quit_request = FALSE;
}

U0 QConPrint(U8 *s)
{//wraps, never truncates. 40 columns, and dropping the tail hides exactly the
 //part worth reading - QuakeC's sprint output is not width aware either
	I64	 i = 0;
	I64	 n;
	U8	*row;

	if (!q_con_ready)
		return;

	//an empty string still costs a blank line
	while (TRUE)
	{
		row = q_con_text + (q_con_line % QCON_LINES) * QCON_WIDTH;
		n   = 0;

		while (s[i] && n < QCON_WIDTH - 1)
		{
			row[n] = s[i];
			n++;
			i++;
		}

		row[n] = 0;
		q_con_time[q_con_line % QCON_LINES] = tS;
		q_con_line++;

		if (!s[i])
			return;
	}
}

//--- console input ---------------------------------------------------------
//
// CharGet and KeyGet block, so typing runs off the same non-blocking scancode
// poll the game uses. every key needs its own edge detect or one tap repeats
// per frame - a screenful of characters at 190fps

#define QCON_INPUT_MAX	62

U8	 q_con_input[QCON_INPUT_MAX + 2];
I64	 q_con_input_len	= 0;

//Key_Console's history ring. edit_line is where typing goes, history_line is
//where the cursor-key walk sits
#define QCON_HISTORY	32

U8	 q_con_hist[QCON_HISTORY * (QCON_INPUT_MAX + 2)];
I64	 q_con_edit_line	= 0;
I64	 q_con_hist_line	= 0;

U0 QConHistoryInit()
{//globals aren't zeroed, and these index a fixed array
	I64 i;

	for (i = 0; i < QCON_HISTORY; i++)
		q_con_hist[i * (QCON_INPUT_MAX + 2)] = 0;

	q_con_edit_line = 0;
	q_con_hist_line = 0;
}

U0 QConHistoryRecall(I64 line)
{//stored line into the edit buffer
	U8 *src;

	if (line < 0 || line >= QCON_HISTORY)
		return;

	src = &q_con_hist[line * (QCON_INPUT_MAX + 2)];
	QStrCopy(q_con_input, src, QCON_INPUT_MAX + 1);
	q_con_input_len = StrLen(q_con_input);
}
U8	 q_key_prev[256];

//Key_Message: chat prompt without opening the console
Bool q_msg_mode		= FALSE;
Bool q_msg_team		= FALSE;
U8	 q_chat_buf[32];
I64	 q_chat_len		= 0;

Bool q_con_want_noclip	= FALSE;	//console asked for a noclip toggle
Bool q_con_want_quit	= FALSE;

//printable keys, walked by character and mapped through Char2ScanCode. minus
//is deliberately absent - it carries both '-' and '_', so whichever appeared
//first always won and sv_cheats came out sv-cheats. handled below, where the
//shift state is available
U8 *q_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ./";

U0 QConInputReset()
{
	I64 i;

	for (i = 0; i < 256; i++)
		q_key_prev[i] = 0;

	q_con_input[0]   = 0;
	q_con_input_len  = 0;
	q_con_want_noclip = FALSE;
	q_con_want_quit   = FALSE;
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

Bool QConKeyEdge(I64 sc)
{//TRUE only on the frame a key goes down
	Bool down;
	Bool was;

	if (sc <= 0 || sc >= 256)
		return FALSE;

	down = ToBool(Bt(kbd.down_bitmap, sc));
	was  = ToBool(q_key_prev[sc]);

	if (down)
		q_key_prev[sc] = 1;
	else
		q_key_prev[sc] = 0;

	return ToBool(down && !was);
}

//--- console command helpers ------------------------------------------------

//FL_ bits from defs.qc
#define QFL_GODMODE_	64
#define QFL_NOTARGET_	128

F64  q_con_fov_want	= 0.0;	//non-zero, console asked for a new fov
Bool q_con_want_save	= FALSE;
Bool q_con_want_load	= FALSE;
Bool q_con_save_ok		= TRUE;

//the shell owns the counter and is compiled after this file, so it publishes
//a copy here
I64 q_net_mismatch_report = 0;
U8  q_con_net_line[128];

U0 QConDrainProgs()
{//drain the QuakeC print buffer into the console, one line per newline
	U8	line[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (q_bi_print_len < 1)
		return;

	for (i = 0; i < q_bi_print_len; i++)
	{
		c = q_bi_print_buf[i];

		if (c == '\n' || n >= 126)
		{
			line[n] = 0;
			if (n > 0)
				QConPrint(line);
			n = 0;
		}

		if (c != '\n')
		{
			line[n] = c;
			n++;
		}
	}

	//QuakeC does not always terminate its lines, so flush the tail rather than
	//hold it until the next print
	if (n > 0)
	{
		line[n] = 0;
		QConPrint(line);
	}

	q_bi_print_len    = 0;
	q_bi_print_buf[0] = 0;
}

U32 QConParseIPV4(U8 *s)
{//dotted quad to host-order U32, 0 on failure
	I64 part[4];
	I64 n = 0;
	I64 v;
	I64 digits;
	I64 i = 0;

	while (n < 4)
	{
		v      = 0;
		digits = 0;

		while (s[i] >= '0' && s[i] <= '9')
		{
			v = v * 10 + (s[i] - '0');
			digits++;
			i++;

			if (v > 255)
				return 0;
		}

		if (!digits)
			return 0;

		part[n] = v;
		n++;

		if (n < 4)
		{
			if (s[i] != '.')
				return 0;
			i++;
		}
	}

	//an optional :port is accepted and ignored - every host we speak to is on
	//QNET_PORT_DEFAULT, and CCREP_SERVER_INFO advertises itself as ip:port, so
	//rejecting the suffix meant a server picked off the slist would not join
	//while the same address typed by hand would
	if (s[i] == ':')
	{
		i++;
		while (s[i] >= '0' && s[i] <= '9')
			i++;
	}

	//anything else trailing means it was not an address
	if (s[i] && s[i] != ' ')
		return 0;

	//ipv4_globals layout: little-endian host order, first octet in the low byte
	return part[0] | (part[1] << 8) | (part[2] << 16) | (part[3] << 24);
}

U0 QConConnectIP(U32 ip)
{//the connect itself, by address. slist already holds the U32 it answered
 //from, so joining a discovered server never formats or re-parses a string
	U8	msg[96];
	U32	me;

	if (!QNetUdpAvailable())
	{
		QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	if (!ip)
	{
		QConPrint("no address to connect to");
		return;
	}

	StrPrint(msg, "connecting to %d.%d.%d.%d...",
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	QConPrint(msg);

	//pick an address when the link has no DHCP, the direct VM-to-VM case.
	//the qip command overrides it
	QNetAutoIP(ip);

	if (!QNetUdpOpen(QNET_PORT_DEFAULT))
	{
		QConPrint(q_udp_status);
		return;
	}

	q_udp_server = FALSE;
	QNetDgrmInit;
	QNetUdpSetPeer(ip);

	//resolve the server MAC here, where a stall is acceptable, never in the
	//frame loop. doubles as the reachability test - no ARP reply, no machine
	if (!QNetUdpResolvePeer)
	{
		QConPrint("no arp reply - is the other vm up and on this link?");
		return;
	}

	//join now rather than wait for the retry tick
	QNetClientSendConnect(q_setup_name, q_setup_top, q_setup_bottom);

	me = QNetLocalIP();

	StrPrint(msg, "me %d.%d.%d.%d -> server %d.%d.%d.%d",
		me & 255, (me >> 8) & 255, (me >> 16) & 255, (me >> 24) & 255,
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	QConPrint(msg);
}

U0 QConConnect(U8 *args)
{//"connect <ip>" - parse, then hand off. accepts an optional :port suffix
	U32 ip = QConParseIPV4(args);

	if (!ip)
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	QConConnectIP(ip);
}

U0 QConSlist()
{//NET_Slist_f - start a scan and print the cache as it stands
 //
 //nothing here waits. the CCREPs land in the recv path over the next second,
 //so the first slist usually prints an empty list and the next one prints the
 //servers. that is why the searching line exists - without it an empty table
 //is indistinguishable from a broken scan
	U8	line[80];
	I64	i;

	if (!QNetUdpAvailable())
	{
		QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	//no autoip: 10.0.0.1 is the address a host takes, and handing it to a
	//scanning client collides with the very server it is looking for
	if (!QNetLocalIP())
	{
		QConPrint("set ip first: qip 10.0.0.2");
		return;
	}

	if (!QNetUdpOpen(QNET_PORT_DEFAULT))
	{
		QConPrint(q_udp_status);
		return;
	}

	//a listen host answers CCREQ instead of collecting CCREP, so it can only
	//ever find itself - say so rather than print an empty list forever
	if (q_udp_server)
	{
		QConPrint("hosting - slist is for clients");
		return;
	}

	if (!QNetSlistBroadcast)
		QConPrint("broadcast failed - no link?");
	else
		QConPrint("searching for lan servers...");

	if (!q_slist_count)
	{
		QConPrint("no servers yet - run slist again");
		return;
	}

	QConPrint("address        host    map     players");

	for (i = 0; i < q_slist_count; i++)
	{
		StrPrint(line, "%s %s %s %d/%d",
			q_slist[i].addr,
			q_slist[i].name,
			q_slist[i].map,
			q_slist[i].players,
			q_slist[i].max_players);
		QConPrint(line);
	}
}

U0 QCvarValueStr(U8 *out, F64 v)
{//cvars are strings in the original, so 1 prints back as 1, not 1.00
	if (v == ToF64(ToI64(v)))
		StrPrint(out, "%d", ToI64(v));
	else
		StrPrint(out, "%g", v);
}

Bool QConCvarCommand(U8 *line)
{//Cvar_Command. TRUE when the line named a cvar, set or reported
	U8	name[24];
	U8	out[64];
	U8	vbuf[32];
	I64	i = 0;
	I64	j;

	while (line[i] && line[i] != ' ' && i < 23)
	{
		name[i] = line[i];
		i++;
	}
	name[i] = 0;

	//unknown names are rejected here, unlike QCvarSet which creates on demand -
	//a typo becoming a new cvar reports success for a setting nothing reads
	if (QCvarIndex(name) < 0)
		return FALSE;

	j = i;
	while (line[j] == ' ')
		j++;

	if (!line[j])
	{
		QCvarValueStr(vbuf, QCvarGet(name));
		StrPrint(out, "\"%s\" is \"%s\"", name, vbuf);
		QConPrint(out);
		return TRUE;
	}

	QCvarSet(name, QAtoF(line + j));

	QCvarValueStr(vbuf, QCvarGet(name));
	StrPrint(out, "%s set to %s", name, vbuf);
	QConPrint(out);

	return TRUE;
}

U0 QConCvar(U8 *args)
{//Cvar_Command: "name value" sets, bare "name" reports
	U8	 name[24];
	U8	 line[64];
	U8	 vbuf[32];
	I64	 i = 0;
	I64	 j;

	while (args[i] && args[i] != ' ' && i < 23)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
		return;

	j = i;
	while (args[j] == ' ')
		j++;

	if (!args[j])
	{
		QCvarValueStr(vbuf, QCvarGet(name));
		StrPrint(line, "\"%s\" is \"%s\"", name, vbuf);
		QConPrint(line);
		return;
	}

	QCvarSet(name, QAtoF(args + j));
	QCvarValueStr(vbuf, QCvarGet(name));
	StrPrint(line, "%s set to %s", name, vbuf);
	QConPrint(line);
}

Bool QConCheatAllowed()
{//Host_God_f / Host_Noclip_f / Host_Fly_f / Host_Give_f all open with
 //
 //    if (pr_global_struct->deathmatch && !host_client->privileged)
 //        return;
 //
 //so the engine cheats are refused outright in deathmatch. nothing gated them
 //here, which left god and give available to anyone on a dm server.
 //
 //NOTE: sv_cheats is not an NQ cvar - deathmatch is the whole rule there. it is
 //honoured as an extra lock so cheats can be shut off in a coop or solo game too
	if (QCvarGet("deathmatch") != 0.0)
	{
		QConPrint("no cheats in deathmatch");
		return FALSE;
	}

	if (QCvarGet("sv_cheats") == 0.0)
	{
		QConPrint("cheats are disabled");
		return FALSE;
	}

	return TRUE;
}

U0 QConCheatFlag(I64 bit, U8 *name)
{//Host_God_f's shape: XOR a flag bit and report the new state
	U8	msg[64];
	I64	flags;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags = flags ^ bit;
	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	if (flags & bit)
		StrPrint(msg, "%s ON", name);
	else
		StrPrint(msg, "%s OFF", name);

	QConPrint(msg);
}

U0 QConRunPlayerFunc(U8 *name)
{//call a QuakeC function with self = the player, as the host commands do
	I64 fn = QPrFindFunction(name);

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	if (fn <= 0)
	{
		QConPrint("no such QuakeC function");
		return;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;
}

//Host_Impulse_f sets cl.impulse for the NEXT move message, it does not poke
//the edict - the input block overwrites .impulse every tick. queued for that
//block to deliver, survives exactly one tick
I64 q_con_impulse_want = 0;

U0 QConImpulse(I64 n)
{//Host_Impulse_f
	U8 msg[48];

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	q_con_impulse_want = n;
	StrPrint(msg, "impulse %d", n);
	QConPrint(msg);
}

U0 QConGive(U8 *args)
{//Host_Give_f. first character selects what, the number is the amount, a
 //digit sets the matching weapon's .items bit
	U8	msg[64];
	I64	v = 0;
	I64	i = 0;
	I64	items;
	U8	what;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	what = args[0];

	//skip to the number, if any
	while (args[i] && args[i] != ' ')
		i++;
	while (args[i] == ' ')
		i++;
	if (args[i])
		v = Str2I64(args + i);

	if ('2' <= what <= '8')
	{
		//IT_SHOTGUN << (n - 2), the original's expression. IT_SHOTGUN is 1
		items = ToI64(QPrFieldF(q_player_edict, q_fld_items));
		items = items | (1 << (what - '2'));
		QPrSetFieldF(q_player_edict, q_fld_items, ToF64(items));
		StrPrint(msg, "gave weapon %c", what);
	}
	else if (what == 's' && q_fld_ammo_shells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_shells, ToF64(v));
		StrPrint(msg, "shells %d", v);
	}
	else if (what == 'n' && q_fld_ammo_nails >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_nails, ToF64(v));
		StrPrint(msg, "nails %d", v);
	}
	else if (what == 'r' && q_fld_ammo_rockets >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_rockets, ToF64(v));
		StrPrint(msg, "rockets %d", v);
	}
	else if (what == 'c' && q_fld_ammo_cells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_cells, ToF64(v));
		StrPrint(msg, "cells %d", v);
	}
	else if (what == 'h')
	{
		QPrSetFieldF(q_player_edict, q_fld_health, ToF64(v));
		StrPrint(msg, "health %d", v);
	}
	else
		StrPrint(msg, "give: s n r c h or 2-8");

	QConPrint(msg);
}

U0 QConStatus()
{//Host_Status_f, cut to what this build can report
	U8 msg[96];

	StrPrint(msg, "map %s", q_map_name);
	QConPrint(msg);

	StrPrint(msg, "edicts %d  time %4.1f", q_pr_num_edicts, q_game_time);
	QConPrint(msg);

	if (q_player_active)
	{
		StrPrint(msg, "health %d  armor %d  ammo %d",
			ToI64(QPlayerHealth), ToI64(QPlayerArmor), ToI64(QPlayerAmmo));
		QConPrint(msg);
	}
}

//--- Cmd_ token walk --------------------------------------------------------

I64 QConToken(U8 *out, U8 *src, I64 i, I64 max)
{//one space-delimited word into out, returns the index just past it
	I64 n = 0;

	while (src[i] == ' ' || src[i] == '\t')
		i++;

	while (src[i] && src[i] != ' ' && src[i] != '\t' && n < max - 1)
	{
		out[n] = src[i];
		n++;
		i++;
	}
	out[n] = 0;

	//an over-long word must not leave the rest of it as the next token
	while (src[i] && src[i] != ' ' && src[i] != '\t')
		i++;

	return i;
}

I64 QConSkipSpace(U8 *src, I64 i)
{
	while (src[i] == ' ' || src[i] == '\t')
		i++;
	return i;
}

U0 QCmdBindList()
{//Key_WriteBindings' shape, to the console instead of a file
	U8	msg[80];
	U8	keyname[24];
	I64	i;

	for (i = 0; i < QBIND_COUNT; i++)
	{
		QBindKeyName(keyname, q_bind_key[i]);
		StrPrint(msg, "\"%s\" = \"%s\"", keyname, q_bind_cmd[i]);
		QConPrint(msg);
	}
}

U0 QCmdBind(U8 *args)
{//Key_Bind_f. no args lists, key alone reports, key+action binds
	U8	key[24];
	U8	act[32];
	U8	keyname[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	I64	slot;

	i = QConSkipSpace(args, 0);
	if (!args[i])
	{
		QCmdBindList;
		return;
	}

	i = QConToken(key, args, i, 24);
	sc = QBindKeyParse(key);
	if (sc <= 0)
	{
		StrPrint(msg, "\"%s\" isn't a valid key", key);
		QConPrint(msg);
		return;
	}

	i = QConSkipSpace(args, i);
	if (!args[i])
	{
		for (slot = 0; slot < QBIND_COUNT; slot++)
		{
			if (q_bind_key[slot] == sc)
			{
				StrPrint(msg, "\"%s\" = \"%s\"", key, q_bind_cmd[slot]);
				QConPrint(msg);
				return;
			}
		}

		StrPrint(msg, "\"%s\" is not bound", key);
		QConPrint(msg);
		return;
	}

	QConToken(act, args, i, 32);
	slot = QBindFindAction(act);
	if (slot < 0)
	{
		StrPrint(msg, "no such action: %s", act);
		QConPrint(msg);
		return;
	}

	//one key drives one action, as the customize page enforces
	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (i != slot && q_bind_key[i] == sc)
			q_bind_key[i] = 0;
	}

	q_bind_key[slot] = sc;
	QCfgSave;

	QBindKeyName(keyname, sc);
	StrPrint(msg, "bound %s to %s", keyname, q_bind_cmd[slot]);
	QConPrint(msg);
}

U0 QCmdUnbind(U8 *args)
{//Key_Unbind_f
	U8	key[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	Bool hit = FALSE;

	QConToken(key, args, 0, 24);
	sc = QBindKeyParse(key);
	if (sc <= 0)
	{
		QConPrint("unbind <key>");
		return;
	}

	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (q_bind_key[i] == sc)
		{
			q_bind_key[i] = 0;
			hit = TRUE;
		}
	}

	if (!hit)
	{
		StrPrint(msg, "\"%s\" is not bound", key);
		QConPrint(msg);
		return;
	}

	QCfgSave;
	StrPrint(msg, "unbound %s", key);
	QConPrint(msg);
}

U0 QCmdUnbindAll()
{//Key_Unbindall_f. the config keeps its bind lines, they just read 0
	I64 i;

	for (i = 0; i < QBIND_COUNT; i++)
		q_bind_key[i] = 0;

	QCfgSave;
	QConPrint("all keys unbound");
}

U0 QCmdCvarList()
{//Cvar_List_f
	U8	msg[80];
	U8	vbuf[32];
	I64	i;

	for (i = 0; i < q_cvar_count; i++)
	{
		QCvarValueStr(vbuf, q_cvars[i].value);
		StrPrint(msg, "%s \"%s\"", q_cvars[i].name, vbuf);
		QConPrint(msg);
	}

	StrPrint(msg, "%d cvars", q_cvar_count);
	QConPrint(msg);
}

U0 QCmdAliasList()
{
	U8	msg[80];
	I64	i;

	if (!q_alias_count)
	{
		QConPrint("no alias commands");
		return;
	}

	for (i = 0; i < q_alias_count; i++)
	{
		StrPrint(msg, "%s : %s", q_alias_name + i * QALIAS_NAME,
			q_alias_text + i * QALIAS_TEXT);
		QConPrint(msg);
	}
}

U0 QCmdAlias(U8 *args)
{//Cmd_Alias_f. no args lists, name alone is a redefine to nothing useful so
 //it lists that one instead
	U8	name[QALIAS_NAME];
	U8	msg[80];
	I64	i;
	I64	slot;

	i = QConSkipSpace(args, 0);
	if (!args[i])
	{
		QCmdAliasList;
		return;
	}

	i = QConToken(name, args, i, QALIAS_NAME);
	i = QConSkipSpace(args, i);

	slot = QAliasFind(name);

	if (!args[i])
	{
		if (slot < 0)
			StrPrint(msg, "no alias named %s", name);
		else
			StrPrint(msg, "%s : %s", name, q_alias_text + slot * QALIAS_TEXT);
		QConPrint(msg);
		return;
	}

	if (slot < 0)
	{
		if (q_alias_count >= QALIAS_MAX)
		{
			QConPrint("alias table full");
			return;
		}
		slot = q_alias_count;
		q_alias_count++;
	}

	QStrCopy(q_alias_name + slot * QALIAS_NAME, name, QALIAS_NAME);
	QStrCopy(q_alias_text + slot * QALIAS_TEXT, args + i, QALIAS_TEXT);

	StrPrint(msg, "%s : %s", q_alias_name + slot * QALIAS_NAME,
		q_alias_text + slot * QALIAS_TEXT);
	QConPrint(msg);
}

U0 QCmdUnalias(U8 *args)
{//not in id, but unbind has no counterpart here without it
	U8	name[QALIAS_NAME];
	U8	msg[80];
	I64	slot;
	I64	i;

	QConToken(name, args, 0, QALIAS_NAME);
	if (!name[0])
	{
		QConPrint("unalias <name>");
		return;
	}

	slot = QAliasFind(name);
	if (slot < 0)
	{
		StrPrint(msg, "no alias named %s", name);
		QConPrint(msg);
		return;
	}

	//swap the tail down, the table has no ordering to keep
	for (i = slot; i < q_alias_count - 1; i++)
	{
		QStrCopy(q_alias_name + i * QALIAS_NAME,
			q_alias_name + (i + 1) * QALIAS_NAME, QALIAS_NAME);
		QStrCopy(q_alias_text + i * QALIAS_TEXT,
			q_alias_text + (i + 1) * QALIAS_TEXT, QALIAS_TEXT);
	}

	q_alias_count--;
	q_alias_name[q_alias_count * QALIAS_NAME] = 0;
	q_alias_text[q_alias_count * QALIAS_TEXT] = 0;

	StrPrint(msg, "removed alias %s", name);
	QConPrint(msg);
}

Bool q_con_want_bf = FALSE;

U0 QConExec(U8 *line, Bool echo = TRUE)
{//unknown input is echoed, not swallowed, so a typo looks like a typo
 //
 //echo: the "]line" receipt belongs to what the user typed. Cbuf_AddText
 //prints nothing, so a stuffcmd must not either - QuakeC sends bf on every
 //pickup
	U8  msg[80];
	U8 *role;
	U32 myip;
	I64 si;
	I64 e;
	CQNetSock *sock;

	//Host_Color_f scratch
	U8 *p;
	I64 ctop;
	I64 cbot;

	//exec / alias scratch. one line at a time, so nothing here outlives the
	//call that filled it
	U8  *raw;
	U8   fline[128];
	U8   acmd[QALIAS_TEXT];
	U8   aname[QALIAS_NAME];
	I64  fsize;
	I64  fi;
	I64  fn;
	I64  ai;
	I64  an;
	I64  aslot;

	if (!line[0])
		return;

	if (echo)
	{
		StrPrint(msg, "]%s", line);
		QConPrint(msg);
	}

	//--- level control ---
	//heap sweep, off by default - it walks every live allocation. needs the
	//kernel built with _CONFIG_HEAP_DEBUG to catch overruns into live blocks
	if (!StrNICompare(line, "heapcheck", 9))
	{
		if (line[9] == ' ')
			q_heap_check_on = ToBool(QAtoF(line + 10) != 0.0);
		else
			q_heap_check_on = !q_heap_check_on;

		if (q_heap_check_on)
			QConPrint("heapcheck on");
		else
			QConPrint("heapcheck off");
		return;
	}

	//COM_AddGameDirectory. mounting happens at startup, and the archives back
	//every model and sound in use, so this only records the directory
	//"game <dir>" and "game" for plain id1. deferred rather than done here:
	//this file compiles before the shell that owns the archives, and the swap
	//frees every pak while lookups are still handing out interior pointers
	if (!StrNICompare(line, "game ", 5) || !StrICompare(line, "game"))
	{
		if (line[4])
			QStrCopy(q_gamedir_next, line + 5, 32);
		else
			q_gamedir_next[0] = 0;

		q_gamedir_pending = TRUE;
		QConPrint("switching gamedir");
		return;
	}

	//CL_PlayDemo_f / CL_Stop_f
	if (!StrNICompare(line, "playdemo ", 9))
	{
		if (QDemoStart(line + 9))
			QConPrint("playing demo");
		else
			QConPrint("couldn't open demo");
		return;
	}

	//Host_Demos_f: the attract loop cycles demo1..3 behind the main menu
	if (!StrICompare(line, "demos"))
	{
		q_demo_loop_index = 0;
		if (QDemoNextInLoop)
			QConPrint("demo loop started");
		else
			QConPrint("no demos found");
		return;
	}

	//Host_Color_f. one argument sets both, two set shirt then trousers.
	//THE TROUSER COLOUR IS THE TEAM - QSvApplyClientColors writes .team from
	//it, so this has to reach the edict rather than only the config, or a
	//player who changes colour mid-game keeps their old team
	if (!StrNICompare(line, "color ", 6))
	{
		p = line + 6;
		while (*p == ' ')
			p++;

		ctop = ClampI64(ToI64(QAtoF(p)), 0, 13);

		//second number if there is one, else shirt and trousers match
		while (*p && *p != ' ')
			p++;
		while (*p == ' ')
			p++;

		if (*p)
			cbot = ClampI64(ToI64(QAtoF(p)), 0, 13);
		else
			cbot = ctop;

		q_setup_top    = ctop;
		q_setup_bottom = cbot;

		if (q_player_active && q_player_edict > 0)
			QSvApplyClientColors(q_player_edict, ctop, cbot);

		//force the identity out again so remotes see the new colours
		si = QSvFindLocalSlot;
		if (si >= 0)
			q_sv_clients[si].sent_ident = FALSE;

		QCfgSave;
		StrPrint(msg, "color %d %d", ctop, cbot);
		QConPrint(msg);
		return;
	}

	//"edicts <classname>" - dump the link fields for a class. LinkDoors pairs
	//neighbouring doors through .enemy and .owner, and a half that never moves
	//is a half that never got linked. this shows which
	if (!StrNICompare(line, "edicts ", 7))
	{
		p = line + 7;
		while (*p == ' ')
			p++;

		if (!q_game_active || q_fld_classname < 0)
		{
			QConPrint("no world");
			return;
		}

		e = 0;
		for (si = 1; si < q_pr_num_edicts; si++)
		{
			if (q_pr_edict_free[si])
				goto qed_next;

			if (StrCompare(QPrStr(QPrFieldI(si, q_fld_classname)), p))
				goto qed_next;

			StrPrint(msg, "%3d %-14s enemy %3d owner %3d org %.0f %.0f %.0f",
				si, p,
				QPrEdictNum(QPrFieldI(si, q_fld_enemy)),
				QPrEdictNum(QPrFieldI(si, q_fld_owner)),
				QPrFieldF(si, q_fld_origin),
				QPrFieldF(si, q_fld_origin + 1),
				QPrFieldF(si, q_fld_origin + 2));
			QConPrint(msg);
			e++;

qed_next:
		}

		StrPrint(msg, "%d edicts", e);
		QConPrint(msg);
		return;
	}

	//Cvar hostname. a string, so it is a command here rather than a cvar row
	if (!StrNICompare(line, "hostname ", 9))
	{
		QStrCopy(q_host_name, line + 9, 32);
		QCfgSave;
		QConPrint("hostname set");
		return;
	}

	if (!StrICompare(line, "hostname"))
	{
		StrPrint(msg, "hostname is %s", q_host_name);
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "stopdemo"))
	{
		QDemoStop;
		q_demo_loop = FALSE;
		QConPrint("demo stopped");
		return;
	}

	if (!StrNICompare(line, "map ", 4))
	{
		QStrCopy(q_change_map, line + 4, 64);
		q_change_pending = TRUE;
		return;
	}

	if (!StrNICompare(line, "changelevel ", 12))
	{
		QStrCopy(q_change_map, line + 12, 64);
		q_change_pending = TRUE;
		return;
	}

	//NET_Slist_f. asynchronous by design, see QConSlist
	if (!StrICompare(line, "slist"))
	{
		QConSlist;
		return;
	}

	//netstat - what the client/server split is doing. not original, net_stats
	//is the closest thing
	if (!StrICompare(line, "netstat"))
	{
		//40 columns each. the mismatch count gets its own line - it decides
		//whether the client's reconstruction can be drawn from at all
		StrPrint(q_con_net_line, "net: %d ents, %d bytes, %d parsed",
			q_net_num_ents, q_net_datagram.len, q_net_parsed);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: MISMATCHED %d, dropped %d",
			q_net_mismatch_report, q_net_dropped);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: hp %d ar %d am %d wp %d",
			q_cl.health, q_cl.armorvalue, q_cl.currentammo, q_cl.weapon);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: %d clients connected",
			q_sv_client_count);
		QConPrint(q_con_net_line);

		//host side: where each remote body is right now
		if (q_udp_ready && q_udp_server)
		{
			for (si = 0; si < QSV_MAX_CLIENTS; si++)
			{
				if (!q_sv_clients[si].active || q_sv_clients[si].local)
					goto ns_next;

				e = q_sv_clients[si].edict;
				if (e > 0)
					StrPrint(q_con_net_line,
						"net: remote[%d] edict %d at %.0f %.0f %.0f mdl %d",
						si, e,
						q_sv_clients[si].origin[0],
						q_sv_clients[si].origin[1],
						q_sv_clients[si].origin[2],
						ToI64(QPrFieldF(e, q_fld_modelindex)));
				else
					StrPrint(q_con_net_line,
						"net: remote[%d] edict 0 (not spawned)", si);
				QConPrint(q_con_net_line);

				sock = QNetDgrmSock(si);
				if (sock && sock->active)
				{
					StrPrint(q_con_net_line,
						"net: remote[%d] udp %d.%d.%d.%d:%d signon %d",
						si,
						sock->ip & 255, (sock->ip >> 8) & 255,
						(sock->ip >> 16) & 255, (sock->ip >> 24) & 255,
						sock->port, q_sv_clients[si].signon);
					QConPrint(q_con_net_line);
				}

ns_next:
			}
		}

		StrPrint(q_con_net_line, "net: moves %d/%d ping %4.1fms",
			q_net_moves_sent, q_net_moves_read, q_net_move_ping * 1000.0);
		QConPrint(q_con_net_line);

		QConPrint(q_udp_status);

		myip = QNetLocalIP();
		StrPrint(q_con_net_line, "udp: local ip %d.%d.%d.%d",
			myip & 255, (myip >> 8) & 255,
			(myip >> 16) & 255, (myip >> 24) & 255);
		QConPrint(q_con_net_line);

		if (q_udp_ready)
		{
			if (q_udp_server)
				role = "hosting";
			else
				role = "joined";

			StrPrint(q_con_net_line, "udp: %s peer %d.%d.%d.%d",
				role,
				q_udp_peer_ip & 255, (q_udp_peer_ip >> 8) & 255,
				(q_udp_peer_ip >> 16) & 255, (q_udp_peer_ip >> 24) & 255);
			QConPrint(q_con_net_line);

			StrPrint(q_con_net_line, "udp: %d sent %d recvd %d err %d unresolved",
				q_udp_sent, q_udp_recvd, q_udp_errors, q_udp_unresolved);
			QConPrint(q_con_net_line);

			if (q_udp_peer_ip)
			{
				if (QNetUdpPeerResolved)
					QConPrint("udp: peer mac RESOLVED");
				else
				{
					StrPrint(q_con_net_line,
						"udp: peer mac UNRESOLVED, %d sends skipped",
						q_udp_unresolved);
					QConPrint(q_con_net_line);
				}
			}
		}
		return;
	}

	//qip <a.b.c.d> - static address for a link with no DHCP, which is two QEMU
	//guests wired together with -netdev socket
	if (!StrNICompare(line, "qip ", 4))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
			return;
		}

		//print the status either way, it names which failure
		QNetUdpSetLocalIP(QConParseIPV4(line + 4));
		QConPrint(q_udp_status);
		return;
	}

	//netdhcp - useless on a direct VM-to-VM link, it just times out
	if (!StrICompare(line, "netdhcp"))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC");
			return;
		}

		QConPrint("dhcp: asking, this may take a few seconds...");
		QNetDhcp;
		QConPrint(q_udp_status);
		return;
	}

	//stairlog 1 - every step-up attempt and whether it was kept
	if (!StrNICompare(line, "stairlog ", 9))
	{
		q_stair_log     = ToBool(Str2I64(line + 9) != 0);
		q_stair_reports = 0;

		if (q_stair_log)
			QConPrint("stair logging ON - see QUAKELOG.TXT");
		else
			QConPrint("stair logging off");
		return;
	}

	//bf - V_BonusFlash_f. stuffed by QuakeC on every pickup, so it arrives far
	//more often than it is typed
	if (!StrICompare(line, "bf"))
	{
		q_con_want_bf = TRUE;
		return;
	}

	//CDAudio_Play / CDAudio_Stop
	if (!StrNICompare(line, "music ", 6))
	{
		if (!StrICompare(line + 6, "stop"))
		{
			QMusicFree;
			AudioSFXStopAll;
			QConPrint("music stopped");
		}
		else
		{
			QMusicPlay(Str2I64(line + 6), tS);
			QConPrint(q_music_status);
		}
		return;
	}

	//Host_Connect_f. parses the quad itself instead of calling
	//PresentationToNetwork, so this file compiles with no net stack
	if (!StrNICompare(line, "connect ", 8))
	{
		QConConnect(line + 8);
		return;
	}

	//bare connect would fall through to the cvar lookup and come back as
	//"unknown command", which reads as the command not existing
	if (!StrICompare(line, "connect"))
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	if (!StrICompare(line, "disconnect"))
	{
		QNetUdpClose;
		q_cl_viewent = 0;
		QConPrint("disconnected");
		return;
	}

	//Host_Say_f via Cmd_ForwardToServer. on a listen host the console pauses
	//the server tick, so call Host_Say directly; a guest forwards over UDP
	if (!StrNICompare(line, "say_team ", 9))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 9, TRUE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say_team\", not connected");
		return;
	}
	if (!StrICompare(line, "say_team"))
	{
		QConPrint("usage: say_team <text>");
		return;
	}
	if (!StrNICompare(line, "say ", 4))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 4, FALSE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say\", not connected");
		return;
	}
	if (!StrICompare(line, "say"))
	{
		QConPrint("usage: say <text>");
		return;
	}
	if (!StrNICompare(line, "tell ", 5))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostTell(QSvFindLocalSlot, line + 5);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"tell\", not connected");
		return;
	}
	if (!StrICompare(line, "tell"))
	{
		QConPrint("usage: tell <name> <text>");
		return;
	}

	if (!StrICompare(line, "host"))
	{
		//under SLIRP prefer DHCP (10.0.2.15) - AutoIP 10.0.0.1 is socket MP
		//only and breaks hostfwd replies
		if (!QNetLocalIP)
			QNetDhcp;
		if (!QNetLocalIP)
			QNetAutoIP(0);

		if (QNetUdpOpen(QNET_PORT_DEFAULT))
		{
			q_udp_server = TRUE;
			QNetDgrmInit;
			QConPrint(q_udp_status);
			QConPrint("hosting - clients may connect to this ip");
		}
		else
			QConPrint(q_udp_status);
		return;
	}

	//diskwrite 0|1 - kill every write this app makes, for bisecting the crash
	//on quit. not an original command
	if (!StrNICompare(line, "diskwrite ", 10))
	{
		q_disk_writes = ToBool(Str2I64(line + 10) != 0);
		if (q_disk_writes)
			QConPrint("disk writes enabled");
		else
			QConPrint("disk writes DISABLED");
		return;
	}

	//explicit set, the fallthrough at the bottom handles the bare form
	if (!StrNICompare(line, "set ", 4))
	{
		QConCvar(line + 4);
		return;
	}

	if (!StrICompare(line, "restart"))
	{
		//what QuakeC's respawn() stuffs on a single-player death
		q_restart_pending = TRUE;
		return;
	}

	//--- movement cheats. Host_Noclip_f and Host_Fly_f swap the movetype; the
	//--- flycam stands in, player movement is driven from this side
	if (!StrICompare(line, "noclip"))
	{
		if (!QConCheatAllowed)
			return;

		q_con_want_noclip = TRUE;
		QConPrint("noclip toggled");
		return;
	}

	if (!StrICompare(line, "fly"))
	{
		if (!QConCheatAllowed)
			return;

		q_con_want_noclip = TRUE;
		QConPrint("fly mode toggled");
		return;
	}

	//--- flag cheats, as Host_God_f and Host_Notarget_f do it
	if (!StrICompare(line, "god"))
	{
		if (!QConCheatAllowed)
			return;
		QConCheatFlag(QFL_GODMODE_, "godmode");
		return;
	}

	if (!StrICompare(line, "notarget"))
	{
		if (!QConCheatAllowed)
			return;
		QConCheatFlag(QFL_NOTARGET_, "notarget");
		return;
	}

	if (!StrICompare(line, "kill"))
	{
		QConRunPlayerFunc("ClientKill");
		return;
	}

	//--- impulse: QuakeC consumes .impulse once. every weapon switch and
	//--- cheat code arrives this way
	if (!StrNICompare(line, "impulse ", 8))
	{
		QConImpulse(Str2I64(line + 8));
		return;
	}

	if (!StrNICompare(line, "give ", 5))
	{
		if (!QConCheatAllowed)
			return;
		QConGive(line + 5);
		return;
	}

	if (!StrNICompare(line, "fov ", 4))
	{
		//q_fov is in the app shell, compiled after this file - request it
		q_con_fov_want = ToF64(Str2I64(line + 4));
		if (q_con_fov_want < 30.0)	q_con_fov_want = 30.0;
		if (q_con_fov_want > 130.0)	q_con_fov_want = 130.0;
		StrPrint(msg, "fov %d", ToI64(q_con_fov_want));
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "save"))
	{
		if (q_con_save_ok)
			QConPrint("saved");
		else
			QConPrint("save failed");
		q_con_want_save = TRUE;
		return;
	}

	if (!StrICompare(line, "load"))
	{
		q_con_want_load = TRUE;
		return;
	}

	if (!StrICompare(line, "status"))
	{
		QConStatus;
		return;
	}

	if (!StrICompare(line, "version"))
	{
		QConPrint("Quake shareware data, engine written for ZealOS");
		return;
	}

	if (!StrICompare(line, "quit"))
	{
		q_con_want_quit = TRUE;
		return;
	}

	//--- binds, aliases and scripts ---
	if (!StrNICompare(line, "bind ", 5))
	{
		QCmdBind(line + 5);
		return;
	}

	if (!StrICompare(line, "bind"))
	{
		QCmdBindList;
		return;
	}

	if (!StrNICompare(line, "unbindall", 9))
	{
		QCmdUnbindAll;
		return;
	}

	if (!StrNICompare(line, "unbind ", 7))
	{
		QCmdUnbind(line + 7);
		return;
	}

	//Cmd_Echo_f: everything after the keyword, verbatim
	if (!StrNICompare(line, "echo ", 5))
	{
		QConPrint(line + 5);
		return;
	}

	if (!StrICompare(line, "echo"))
	{
		QConPrint("");
		return;
	}

	if (!StrICompare(line, "cvarlist"))
	{
		QCmdCvarList;
		return;
	}

	if (!StrNICompare(line, "alias ", 6))
	{
		QCmdAlias(line + 6);
		return;
	}

	if (!StrICompare(line, "alias"))
	{
		QCmdAliasList;
		return;
	}

	if (!StrNICompare(line, "unalias ", 8))
	{
		QCmdUnalias(line + 8);
		return;
	}

	//Cmd_Wait_f defers the rest of the command buffer by a frame. this
	//dispatcher runs one line to completion with nothing queued behind it,
	//so there is nothing to defer - accepted and ignored
	if (!StrICompare(line, "wait"))
		return;

	//Cmd_Exec_f. pak first like COM_LoadFile, then the disk
	if (!StrNICompare(line, "exec ", 5))
	{
		fi = QConSkipSpace(line, 5);
		QConToken(fline, line, fi, 128);

		fsize = 0;
		raw   = QPakLoad(fline, &fsize);

		if (!raw && FileFind(fline))
			raw = FileRead(fline, &fsize);

		if (!raw || fsize <= 0)
		{
			if (raw)
				Free(raw);
			StrPrint(msg, "couldn't exec %s", fline);
			QConPrint(msg);
			return;
		}

		StrPrint(msg, "execing %s", fline);
		QConPrint(msg);

		fi = 0;
		while (fi < fsize)
		{
			fn = 0;
			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r' && fn < 127)
			{
				fline[fn] = raw[fi];
				fn++;
				fi++;
			}
			fline[fn] = 0;

			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r')
				fi++;
			while (fi < fsize && (raw[fi] == '\n' || raw[fi] == '\r'))
				fi++;

			//strip a // comment tail, then trailing blanks
			for (an = 0; an < fn - 1; an++)
			{
				if (fline[an] == '/' && fline[an + 1] == '/')
				{
					fline[an] = 0;
					fn = an;
					break;
				}
			}
			while (fn > 0 && (fline[fn - 1] == ' ' || fline[fn - 1] == '\t'))
			{
				fn--;
				fline[fn] = 0;
			}

			//leading blanks too, a config is indented like source
			an = 0;
			while (fline[an] == ' ' || fline[an] == '\t')
				an++;

			if (fline[an])
				QConExec(fline + an, FALSE);
		}

		Free(raw);
		return;
	}

	if (!StrICompare(line, "help"))
	{
		QConPrint("map <n>  changelevel <n>  restart  save  load");
		QConPrint("god  notarget  noclip  fly  kill");
		QConPrint("impulse <n>  give <s|n|r|c|h|1-8> <v>  fov <n>");
		QConPrint("say <text>  say_team <text>  tell <name> <text>");
		QConPrint("bind <key> <action>  unbind <key>  unbindall");
		QConPrint("alias <n> <text>  unalias <n>  exec <file>");
		QConPrint("echo <text>  cvarlist  wait");
		QConPrint("status  version  quit");
		return;
	}

	//--- alias expansion ---
	//Cmd_ExecuteString checks the alias list after the builtins and before
	//Cvar_Command, so an alias can't shadow a real command
	QConToken(aname, line, 0, QALIAS_NAME);
	aslot = QAliasFind(aname);
	if (aslot >= 0)
	{
		//an alias naming itself would spin forever, so cap the nesting the
		//way the original caps its alias loop
		if (q_alias_depth >= QALIAS_DEPTH)
		{
			QConPrint("alias recursion too deep");
			return;
		}

		QStrCopy(acmd, q_alias_text + aslot * QALIAS_TEXT, QALIAS_TEXT);
		q_alias_depth++;

		//semicolons split, as Cbuf_InsertText's parse does
		ai = 0;
		while (acmd[ai])
		{
			an = 0;
			while (acmd[ai] && acmd[ai] != ';' && an < QALIAS_TEXT - 1)
			{
				fline[an] = acmd[ai];
				an++;
				ai++;
			}
			fline[an] = 0;

			while (acmd[ai] == ';')
				ai++;

			while (an > 0 && (fline[an - 1] == ' ' || fline[an - 1] == '\t'))
			{
				an--;
				fline[an] = 0;
			}

			fn = 0;
			while (fline[fn] == ' ' || fline[fn] == '\t')
				fn++;

			if (fline[fn])
				QConExec(fline + fn, FALSE);
		}

		q_alias_depth--;
		return;
	}

	//last resort, as Cmd_ExecuteString does: no command matched, so fall
	//through to Cvar_Command. this is why the original has no set keyword
	if (QConCvarCommand(line))
		return;

	QConPrint("unknown command");
}

U0 QMsgModeBegin(Bool team)
{//Con_MessageMode_f / Con_MessageMode2_f
	q_msg_mode  = TRUE;
	q_msg_team  = team;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeCancel()
{
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeInput()
{//Key_Message: type into chat_buffer, Enter sends say / say_team.
 //sits after QConExec, single-pass compiler
	I64	 i;
	I64	 sc;
	U8	 ch;
	U8	 cmd[48];

	if (!q_msg_mode)
		return;

	if (QConKeyEdge(SC_ESC))
	{
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		if (q_chat_len > 0)
		{
			if (q_msg_team)
				StrPrint(cmd, "say_team %s", q_chat_buf);
			else
				StrPrint(cmd, "say %s", q_chat_buf);

			//no receipt. the "]say lol" line belongs to a command TYPED at the
			//console; messagemode already showed the text as it was entered,
			//and the server echoes it back as "name: lol" for everyone. three
			//copies of one message is two too many
			QConExec(cmd, FALSE);
		}
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_chat_len > 0)
	{
		q_chat_len--;
		q_chat_buf[q_chat_len] = 0;
		return;
	}

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);
		if (QConKeyEdge(sc) && q_chat_len < 31)
		{
			q_chat_buf[q_chat_len] = ch;
			q_chat_len++;
			q_chat_buf[q_chat_len] = 0;
		}
		i++;
	}

	if (QConKeyEdge(Char2ScanCode('-')) && q_chat_len < 31)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			q_chat_buf[q_chat_len] = '_';
		else
			q_chat_buf[q_chat_len] = '-';
		q_chat_len++;
		q_chat_buf[q_chat_len] = 0;
	}
}

U0 QConDrainStuff()
{//Cbuf_Execute. stuffcmd text IS console text, so it goes through the same
 //executor and anything the console understands works
	U8	cmd[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (q_bi_stuff_len < 1)
		return;

	for (i = 0; i < q_bi_stuff_len; i++)
	{
		c = q_bi_stuff_buf[i];

		if (c == '\n' || c == ';' || n >= 126)
		{
			cmd[n] = 0;
			if (n > 0)
				QConExec(cmd, FALSE);
			n = 0;
		}

		if (c != '\n' && c != ';')
		{
			cmd[n] = c;
			n++;
		}
	}

	if (n > 0)
	{
		cmd[n] = 0;
		QConExec(cmd);
	}

	q_bi_stuff_len    = 0;
	q_bi_stuff_buf[0] = 0;
}

U0 QConInput()
{//one frame of typing
	I64 i;
	I64 sc;
	I64 ch;

	//printable characters
	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_con_input_len < QCON_INPUT_MAX)
		{
			q_con_input[q_con_input_len] = ch;
			q_con_input_len++;
			q_con_input[q_con_input_len] = 0;
		}

		i++;
	}

	//minus resolved by shift, one edge check so the two characters can't
	//fight over the key
	if (QConKeyEdge(Char2ScanCode('-')) && q_con_input_len < QCON_INPUT_MAX)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			q_con_input[q_con_input_len] = '_';
		else
			q_con_input[q_con_input_len] = '-';

		q_con_input_len++;
		q_con_input[q_con_input_len] = 0;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_con_input_len > 0)
	{
		q_con_input_len--;
		q_con_input[q_con_input_len] = 0;
	}

	//Key_Console's history walk. an empty slot ends it rather than cycling
	//through blanks
	if (QConKeyEdge(SC_CURSOR_UP))
	{
		I64 probe = q_con_hist_line;
		I64 tries;

		for (tries = 0; tries < QCON_HISTORY; tries++)
		{
			probe--;
			if (probe < 0)
				probe = QCON_HISTORY - 1;

			if (probe == q_con_edit_line)
				break;

			if (q_con_hist[probe * (QCON_INPUT_MAX + 2)])
			{
				q_con_hist_line = probe;
				QConHistoryRecall(probe);
				break;
			}
		}
	}

	if (QConKeyEdge(SC_CURSOR_DOWN))
	{
		if (q_con_hist_line == q_con_edit_line)
		{
			q_con_input[0]  = 0;
			q_con_input_len = 0;
		}
		else
		{
			q_con_hist_line++;
			if (q_con_hist_line >= QCON_HISTORY)
				q_con_hist_line = 0;

			if (q_con_hist_line == q_con_edit_line)
			{
				q_con_input[0]  = 0;
				q_con_input_len = 0;
			}
			else
				QConHistoryRecall(q_con_hist_line);
		}
	}

	if (QConKeyEdge(SC_ENTER))
	{
		//store before executing, a command that changes state must still
		//be recallable
		if (q_con_input_len > 0)
		{
			QStrCopy(&q_con_hist[q_con_edit_line * (QCON_INPUT_MAX + 2)],
				q_con_input, QCON_INPUT_MAX + 1);

			q_con_edit_line++;
			if (q_con_edit_line >= QCON_HISTORY)
				q_con_edit_line = 0;

			q_con_hist[q_con_edit_line * (QCON_INPUT_MAX + 2)] = 0;
			q_con_hist_line = q_con_edit_line;
		}

		QConExec(q_con_input);
		q_con_input[0]  = 0;
		q_con_input_len = 0;
	}
}

U0 QConDrawNotify(CQCanvas *c)
{//Con_DrawNotify: newest few lines, top left, while still fresh. suppressed
 //with the console down or the same text appears twice
	I64	 i;
	I64	 line;
	I64	 y = 0;
	I64	 x;
	U8	*row;
	U8	 prompt[16];

	if (!q_con_ready)
		return;

	for (i = QCON_NOTIFY_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qcn_next;

		if (tS - q_con_time[line % QCON_LINES] > QCON_NOTIFY_TIME)
			goto qcn_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0])
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qcn_next:
	}

	//Con_DrawNotify's key_message branch
	if (q_msg_mode)
	{
		if (q_msg_team)
			StrPrint(prompt, "say_team:");
		else
			StrPrint(prompt, "say:");
		QStrDraw(c, 8, y, prompt);
		x = 8 + StrLen(prompt) * QCHAR_W;
		QStrDraw(c, x, y, q_chat_buf);
		if ((ToI64(tS * 4.0) & 1) == 0)
			QStrDraw(c, x + q_chat_len * QCHAR_W, y, "_");
	}
}

U0 QConDraw(CQCanvas *c)
{//slides over whatever is behind it
	I64	 i;
	I64	 line;
	I64	 y;
	I64	 con_h;
	U8	*row;

	//a fraction of the screen, not a fixed 128 - at 640x480 a fixed slice
	//covers a quarter of the view and the background stops part way across
	con_h = c->height / 2;
	if (con_h < QCON_HEIGHT)
		con_h = QCON_HEIGHT;

	if (q_pic_conback.pixels)
		QPicDrawFillPart(c, &q_pic_conback, con_h);

	//oldest first, so new text lands at the bottom
	y = 4;
	for (i = QCON_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qc_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0] && y + QCHAR_H < con_h)
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qc_next:
	}

	//prompt, input line, blinking caret
	QStrDraw(c, 8, con_h - QCHAR_H - 2, "]");
	QStrDraw(c, 8 + QCHAR_W, con_h - QCHAR_H - 2, q_con_input);

	if (ToI64(tS * 3.0) & 1)
		QStrDraw(c, 8 + QCHAR_W * (q_con_input_len + 1),
			con_h - QCHAR_H - 2, "_");
}

U0 QMenuPlaque(CQCanvas *c, CQPic *title)
{//shared submenu furniture, placed as M_Multiplayer_Draw places it
	I64 mx = QMenuXOfs(c);

	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, mx + 16, 4);

	if (title && title->pixels)
		QPicDraw(c, title, mx + (QMENU_VW - title->width) / 2, 4);
}

U0 QMenuCursor(CQCanvas *c, I64 x, I64 y)
{//the main menu's six-frame 10Hz cursor
	I64 frame = ToI64(tS * 10.0) % 6;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);
}

U0 QOptDraw(CQCanvas *c)
{//M_Options_Draw. values as text beside each label
	U8	line[64];
	I64	y;
	I64	pitch;
	I64	mx;

	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_option);

	//the list must fit the canvas: 200 rows at the lowest resolution, and a
	//fixed 16 pitch runs the last entries off the bottom where they can't be
	//reached. three steps down to M_Options_Draw's own 8 from y=32
	y     = 60;
	pitch = 16;

	if (y + QOPT_ROWS * pitch + 24 > c->height)
	{
		y     = 40;
		pitch = 12;
	}

	if (y + QOPT_ROWS * pitch + 24 > c->height)
	{
		y     = 32;
		pitch = QCHAR_H;
	}

	//every row is placed by its own constant, not a running offset, so the
	//caret below cannot drift out of step with the labels

	//the viewsize cvar, so the menu and the - / = keys move one value
	QStrDrawAlt(c, mx + 64, y + QOPT_SCRSIZE * pitch, "screen size");
	QMenuSlider(c, mx + 220, y + QOPT_SCRSIZE * pitch,
		(QCvarGet("viewsize") - 30.0) / 90.0);

	QStrDrawAlt(c, mx + 64, y + QOPT_SENS * pitch, "mouse speed");
	QMenuSlider(c, mx + 220, y + QOPT_SENS * pitch,
		(q_opt_sensitivity - 0.02) / (0.60 - 0.02));

	QStrDrawAlt(c, mx + 64, y + QOPT_VOLUME * pitch, "sound volume");
	QMenuSlider(c, mx + 220, y + QOPT_VOLUME * pitch,
		ToF64(q_opt_volume) / 100.0);

	//"music volume", not "CD audio" - the tracks come from the music folder
	QStrDrawAlt(c, mx + 64, y + QOPT_MUSICVOL * pitch, "music volume");
	QMenuSlider(c, mx + 220, y + QOPT_MUSICVOL * pitch, q_music_volume);

	//cl_forwardspeed 200 walks, 400 runs
	if (QCvarGet("cl_forwardspeed") > 200.0)
		QStrDrawAlt(c, mx + 64, y + QOPT_ALWAYSRUN * pitch,
			"always run     on");
	else
		QStrDrawAlt(c, mx + 64, y + QOPT_ALWAYSRUN * pitch,
			"always run     off");

	if (QCvarGet("m_pitch") < 0.0)
		QStrDrawAlt(c, mx + 64, y + QOPT_INVERT * pitch,
			"invert mouse   on");
	else
		QStrDrawAlt(c, mx + 64, y + QOPT_INVERT * pitch,
			"invert mouse   off");

	StrPrint(line, "resolution    %dx%d",
		q_res_w[q_opt_res], q_res_h[q_opt_res]);
	QStrDrawAlt(c, mx + 64, y + QOPT_RES * pitch, line);

	if (q_opt_fullscreen)
		StrPrint(line, "screen        fullscreen");
	else
		StrPrint(line, "screen        windowed");
	QStrDrawAlt(c, mx + 64, y + QOPT_FULLSCREEN * pitch, line);

	//bar fills as the picture brightens, the exponent runs the other way
	QStrDrawAlt(c, mx + 64, y + QOPT_GAMMA * pitch, "brightness");
	QMenuSlider(c, mx + 220, y + QOPT_GAMMA * pitch,
		(QGAMMA_MAX - q_opt_gamma) / (QGAMMA_MAX - QGAMMA_MIN));

	//names the two renderers, not on/off - "gun clipping off" reads as a bug
	if (q_opt_gunclip)
		QStrDrawAlt(c, mx + 64, y + QOPT_GUNCLIP * pitch,
			"gun depth      gl (no clip)");
	else
		QStrDrawAlt(c, mx + 64, y + QOPT_GUNCLIP * pitch,
			"gun depth      software");

	if (QCvarGet("crosshair") != 0.0)
		QStrDrawAlt(c, mx + 64, y + QOPT_CROSSHAIR * pitch,
			"crosshair      on");
	else
		QStrDrawAlt(c, mx + 64, y + QOPT_CROSSHAIR * pitch,
			"crosshair      off");

	QStrDrawAlt(c, mx + 64, y + QOPT_CUSTOMIZE * pitch, "customize controls");
	QStrDrawAlt(c, mx + 64, y + QOPT_RESET * pitch, "reset to defaults");
	QStrDrawAlt(c, mx + 64, y + QOPT_BACK * pitch, "back");

	//a caret, not the spinning cursor - that belongs to the main page and is
	//oversized at this pitch
	QStrDrawAlt(c, mx + 48, y + q_opt_row * pitch, ">");

	QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

U0 QOptResetDefaults()
{//every value this page owns back to a fresh install, bindings included,
 //then written out so it survives a restart
	QCvarSet("viewsize",		100.0);

	//400 is QCvarInit's default, always run ON. 200 is a state a fresh
	//install never starts in
	QCvarSet("cl_forwardspeed",	400.0);
	QCvarSet("cl_backspeed",	400.0);
	QCvarSet("m_pitch",			0.022);
	QCvarSet("lookspring",		0.0);
	QCvarSet("lookstrafe",		0.0);
	QCvarSet("crosshair",		0.0);
	q_opt_crosshair = 0;

	q_opt_sensitivity = 0.15;
	q_opt_volume      = 70;
	q_snd_master      = ToF64(q_opt_volume) / 100.0;
	q_music_volume    = 0.7;
	q_opt_gamma       = 1.0;
	q_opt_gunclip     = TRUE;

	QMusicApplyVolume;
	QBindDefaults;
	QCfgSave;

	QMenuSound(QMSND_VALUE);
}

U0 QKeysDraw(CQCanvas *c)
{//M_Keys_Draw: every bindable action and the key that runs it
	U8	line[64];
	U8	keyname[24];
	I64	mx = QMenuXOfs(c);
	I64	y  = 60;
	I64	i;

	QMenuPlaque(c, &q_pic_p_option);

	for (i = 0; i < QBIND_COUNT; i++)
	{
		QBindKeyName(keyname, q_bind_key[i]);
		StrPrint(line, "%-18s %s", q_bind_label[i], keyname);
		QStrDrawAlt(c, mx + 64, y + i * 16, line);
	}

	QStrDrawAlt(c, mx + 64, y + QBIND_COUNT * 16, "back");

	//capturing swaps the caret for "=", as the original does
	if (q_keys_capture)
		QStrDrawAlt(c, mx + 48, y + q_keys_row * 16, "=");
	else
		QStrDrawAlt(c, mx + 48, y + q_keys_row * 16, ">");

	if (q_keys_capture)
		QStrDrawCenterAlt(c, c->height - 20, "press a key, or escape to cancel");
	else
		QStrDrawCenterAlt(c, c->height - 20, "enter rebinds, escape exits");
}

Bool QKeysKey(I64 sc)
{//capture swallows the next key whole. escape is tested first or it can be
 //bound, and the way out of the menu goes with it
	I64 i;

	if (q_keys_capture)
	{
		q_keys_capture = FALSE;

		if (sc != SC_ESC && q_keys_row >= 0 && q_keys_row < QBIND_COUNT)
		{
			//clear the key off its old action or one press fires two
			for (i = 0; i < QBIND_COUNT; i++)
			{
				if (i != q_keys_row && q_bind_key[i] == sc)
					q_bind_key[i] = 0;
			}

			q_bind_key[q_keys_row] = sc;
			QCfgSave;
		}

		QMenuSound(QMSND_VALUE);
		return TRUE;
	}

	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_OPTIONS;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_keys_row--;
		if (q_keys_row < 0)
			q_keys_row = QBIND_COUNT;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_keys_row++;
		if (q_keys_row > QBIND_COUNT)
			q_keys_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//the row past the last binding is back
		if (q_keys_row >= QBIND_COUNT)
		{
			QMenuSound(QMSND_MOVE);
			q_menu_page = QPAGE_OPTIONS;
			return TRUE;
		}

		QMenuSound(QMSND_ENTER);
		q_keys_capture = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 QNoticeDraw(CQCanvas *c)
{//plain message page, for what the shareware build cannot offer
	QMenuBackdrop(c);

	QStrDrawCenterAlt(c, 90, q_notice);
	QStrDrawCenterAlt(c, c->height - 20, "press enter or escape");
}

U0 QHelpDraw(CQCanvas *c)
{//M_Help_Draw: one full-screen picture per page
	CQPic *p = &q_pic_help[q_help_page];

	QMenuBackdrop(c);

	//authored at 320x200, centred in the virtual box rather than stretched
	if (p->pixels)
		QPicDraw(c, p, QMenuXOfs(c) + (QMENU_VW - p->width) / 2, 4);
	else
		QStrDrawCenterAlt(c, 90, "help pages not found in pak");

	QStrDrawCenterAlt(c, c->height - 20, "left/right pages, escape exits");
}

Bool QHelpKey(I64 sc)
{
	if (sc == SC_CURSOR_LEFT)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page--;
		if (q_help_page < 0)
			q_help_page = QHELP_PAGES - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_RIGHT || sc == SC_ENTER)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page++;
		if (q_help_page >= QHELP_PAGES)
			q_help_page = 0;
		return TRUE;
	}

	return FALSE;
}

U0 QLanDraw(CQCanvas *c)
{//M_LanConfig_Draw: title, address field, JOIN row
	U8	line[64];
	I64	mx = QMenuXOfs(c);
	I64	y  = 56;
	I64	i;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawCenterAlt(c, 40, "join game - tcp/ip");

	QStrDrawAlt(c, mx + 56, y, "address");

	//plain field. M_DrawTextBox would need the gfx/box_*.lmp tiles assembled
	if (q_lan_editing)
		StrPrint(line, "%s_", q_lan_addr);
	else
		StrPrint(line, "%s", q_lan_addr);

	QStrDrawAlt(c, mx + 144, y, line);

	QStrDrawAlt(c, mx + 56, y + 24, "search for local games");
	QStrDrawAlt(c, mx + 56, y + 40, "join game");
	QStrDrawAlt(c, mx + 56, y + 56, "back");

	if (q_lan_row == QLAN_ADDRESS)		QMenuCursor(c, mx + 40, y - 4);
	else if (q_lan_row == QLAN_SEARCH)	QMenuCursor(c, mx + 40, y + 20);
	else if (q_lan_row == QLAN_JOIN)	QMenuCursor(c, mx + 40, y + 36);
	else								QMenuCursor(c, mx + 40, y + 52);

	//M_Slist_Draw. replies land asynchronously, so the list is whatever has
	//arrived so far - picking one copies it into the address field
	if (QNetSlistSearching)
		QStrDrawAlt(c, mx + 56, y + 80, "searching...");
	else if (q_slist_count < 1 && q_slist_asked)
		QStrDrawAlt(c, mx + 56, y + 80, "no servers found");

	for (i = 0; i < q_slist_count && i < 6; i++)
	{
		StrPrint(line, "%d %-16s %s %d/%d", i + 1,
			q_slist[i].name, q_slist[i].map,
			q_slist[i].players, q_slist[i].max_players);
		QStrDrawAlt(c, mx + 56, y + 96 + i * 10, line);
	}

	if (q_slist_count > 0)
		QStrDrawCenterAlt(c, c->height - 30,
			"number key copies that server's address");

	if (q_lan_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type the address, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "enter selects, escape returns");
}

U0 QLanInput()
{//digits and dots only, so the field can't hold what the parser rejects
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_lan_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];

		if ((ch >= '0' && ch <= '9') || ch == '.')
		{
			sc = Char2ScanCode(ch);

			if (QConKeyEdge(sc) && q_lan_len < 23)
			{
				q_lan_addr[q_lan_len] = ch;
				q_lan_len++;
				q_lan_addr[q_lan_len] = 0;
			}
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_lan_len > 0)
	{
		q_lan_len--;
		q_lan_addr[q_lan_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_lan_editing   = FALSE;
		q_lan_ate_enter = TRUE;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QLanKey(I64 sc)
{
	I64 i;
	I64 n;

	if (q_lan_editing)
		return TRUE;

	//the ENTER that ended editing must not be seen twice or the field reopens
	if (q_lan_ate_enter)
	{
		q_lan_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	//1..6 join that server outright - the original's slist is a list you pick
	//from, not a way to fill in a text field
	i = -1;
	for (n = 0; n < 6; n++)
	{
		if (sc == Char2ScanCode('1' + n))
			i = n;
	}

	if (i >= 0)
	{
		if (i < q_slist_count)
		{
			//join the U32 it ANSWERED FROM. the printable form is for the
			//list only - formatting an address and parsing it back is two
			//more places for a join to fail than there need to be
			QStrCopy(q_lan_addr, q_slist[i].addr, 24);
			q_lan_len = StrLen(q_lan_addr);
			QMenuSound(QMSND_ENTER);
			QConConnectIP(q_slist[i].ip);
			q_menu_page = QPAGE_MAIN;
		}
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row--;
		if (q_lan_row < 0)
			q_lan_row = QLAN_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row++;
		if (q_lan_row >= QLAN_ROWS)
			q_lan_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_lan_row == QLAN_ADDRESS)
		{
			q_lan_editing = TRUE;
			q_lan_len     = StrLen(q_lan_addr);
		}
		else if (q_lan_row == QLAN_SEARCH)
		{
			//Datagram_SearchForHosts. returns at once, replies fill the table
			//over the next couple of seconds
			QNetSlistBroadcast;
		}
		else if (q_lan_row == QLAN_JOIN)
		{
			//straight through the connect command, one join path not two
			QConConnect(q_lan_addr);
			q_menu_page = QPAGE_MAIN;
		}
		else
			q_menu_page = QPAGE_MULTI;

		return TRUE;
	}

	return FALSE;
}

U0 QSingleDraw(CQCanvas *c)
{//M_SinglePlayer_Draw. the three rows are one image, 20 pixel pitch
	I64 mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_single);

	if (q_pic_sp_menu.pixels)
		QPicDraw(c, &q_pic_sp_menu, mx + 72, QMENU_Y);

	QMenuCursor(c, mx + 72 - 18, QMENU_Y + q_sp_row * QMENU_ROW_H - 4);
}

Bool QSingleKey(I64 sc, Bool *_start_game)
{
	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_sp_row--;
		if (q_sp_row < 0)
			q_sp_row = QSP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_sp_row++;
		if (q_sp_row >= QSP_ROWS)
			q_sp_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_sp_row == QSP_NEWGAME)
		{
			//M_SinglePlayer_Key: New Game always restarts at "start" with one
			//player. cvars first, they govern how QuakeC spawns everything
			QCvarSet("deathmatch", 0.0);
			QCvarSet("coop", 0.0);

			//svs.maxclients 1 - solo reserves one edict, as the original does
			QSvMaxClientsSet(1);

			QStrCopy(q_change_map, "start", 64);
			q_change_pending = TRUE;

			if (_start_game)
				*_start_game = TRUE;

			q_menu_page = QPAGE_MAIN;
		}
		else if (q_sp_row == QSP_LOAD)
		{
			//one slot. deferred - loading tears the world down and this runs
			//inside the menu's own frame
			q_menu_load_req = TRUE;
			q_menu_page     = QPAGE_MAIN;

			if (_start_game)
				*_start_game = TRUE;
		}
		else
		{
			//saving needs a world to save
			if (q_game_active)
			{
				q_menu_save_req = TRUE;
				q_menu_page     = QPAGE_MAIN;

				if (_start_game)
					*_start_game = TRUE;
			}
		}

		return TRUE;
	}

	return FALSE;
}

U0 QMultiDraw(CQCanvas *c)
{//M_Multiplayer_Draw. the rows are artwork, gfx/mp_menu.lmp, not console font
	I64	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_multi);

	//one image at x=72 y=32, the original's 20 pixel row pitch
	if (q_pic_mp_menu.pixels)
		QPicDraw(c, &q_pic_mp_menu, mx + 72, QMENU_Y);

	//no artwork for back, it is not one of the three baked rows
	QStrDrawAlt(c, mx + 72, QMENU_Y + 3 * QMENU_ROW_H, "back");

	QMenuCursor(c, mx + 72 - 18, QMENU_Y + q_mp_row * QMENU_ROW_H - 4);

	//join needs a UDP socket; new game runs a real deathmatch server the local
	//client reaches over loopback
	if (QNetUdpAvailable())
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game hosts on this machine");
		QStrDrawCenterAlt(c, c->height - 20, "join: console, then connect <ip>");
	}
	else
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game runs a local deathmatch");
		QStrDrawCenterAlt(c, c->height - 20, "network play: run RunNet.ZC");
	}
}

U0 QSetupDraw(CQCanvas *c)
{
	CQMdl	*preview;
	U8		 line[64];
	F64		 porg[3];
	F64		 pang[3];
	F64		 veye[3];
	F64		 vang[3];
	I64		 mx = QMenuXOfs(c);
	I64		 y  = 40;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawAlt(c, mx + 32, y, "your name");
	if (q_setup_editing)
	{
		StrPrint(line, "%s_", q_setup_name);
		QStrDrawAlt(c, mx + 32, y + 8, line);
	}
	else
		QStrDrawAlt(c, mx + 32, y + 8, q_setup_name);

	StrPrint(line, "shirt colour    %d", q_setup_top);
	QStrDrawAlt(c, mx + 32, y + 32, line);

	StrPrint(line, "trouser colour  %d", q_setup_bottom);
	QStrDrawAlt(c, mx + 32, y + 64, line);

	QStrDrawAlt(c, mx + 32, y + 72, "back");

	//the rotating player model. real world path with a synthetic camera, not a
	//sprite, so the colours are the translated skin others actually see
	preview = QMdlPreviewGet(q_setup_top, q_setup_bottom);
	if (preview)
	{
		//needs a camera and a CLEAN depth buffer - both live on the canvas and
		//still hold the last rendered frame, whose geometry would win the
		//depth test and eat the model
		QVecSet(veye, 0.0, 0.0, 0.0);
		QVecSet(vang, 0.0, 0.0, 0.0);
		QDrawSetView(c, veye, vang, 90.0);

		MemSet(c->depth, 0, c->width * c->height * sizeof(F64));

		//down +x from the eye, offset right of the text, spun by the clock
		QVecSet(porg, 76.0, -26.0, -22.0);
		QVecSet(pang, 0.0, QAngleNorm(tS * 60.0), 0.0);

		QMdlDrawAngles(c, preview, 0, porg, pang, 176);
	}

	if (q_set_row == QSET_NAME)			QStrDrawAlt(c, mx + 16, y,      ">");
	else if (q_set_row == QSET_TOP)		QStrDrawAlt(c, mx + 16, y + 32, ">");
	else if (q_set_row == QSET_BOTTOM)	QStrDrawAlt(c, mx + 16, y + 48, ">");
	else								QStrDrawAlt(c, mx + 16, y + 72, ">");

	if (q_setup_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type a name, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool QMultiKey(I64 sc)
{
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row--;
		if (q_mp_row < 0)
			q_mp_row = QMP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row++;
		if (q_mp_row >= QMP_ROWS)
			q_mp_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
		return TRUE;	//nothing on this page is a value

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_mp_row == QMP_JOIN)
		{
			if (QNetUdpAvailable())
			{
				q_menu_page = QPAGE_LANCONFIG;
				q_lan_row   = 0;
				return TRUE;
			}

			//only reachable without a net stack, the branch above returns
			QStrCopy(q_notice, "quit and run RunNet.ZC for network play", 64);
			q_menu_page = QPAGE_NOTICE;
		}
		else if (q_mp_row == QMP_NEW)
		{
			//M_Menu_Net_f: NEW GAME opens game options, it does not start
			//anything. the map, the mode and the limits are chosen there
			q_menu_page = QPAGE_GAMEOPT;
			q_go_row    = 0;

			//the page shows a mode, so one must be set. neither cvar on
			//resolves to single player and the label would be lying
			if (QCvarGet("coop") == 0.0 && QCvarGet("deathmatch") == 0.0)
			{
				QCvarSet("deathmatch", 1.0);
				QCvarSet("coop", 0.0);
			}
		}
		else if (q_mp_row == QMP_SETUP)
		{
			q_menu_page = QPAGE_SETUP;
			q_set_row   = 0;
		}
		else
			q_menu_page = QPAGE_MAIN;

		return TRUE;
	}

	return FALSE;
}

U0 QGoDraw(CQCanvas *c)
{//M_GameOptions_Draw. the values are read back off the cvars, never cached -
 //the console can set any of them behind this page
	U8	line[64];
	I64	y;
	I64	pitch;
	I64	mx;
	I64	v;

	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_multi);

	//nine rows at a 16 pitch run off a 200 row canvas and the last ones can
	//never be reached. same three steps down QOptDraw takes
	y     = 60;
	pitch = 16;

	if (y + QGO_ROWS * pitch + 24 > c->height)
	{
		y     = 40;
		pitch = 12;
	}

	if (y + QGO_ROWS * pitch + 24 > c->height)
	{
		y     = 32;
		pitch = QCHAR_H;
	}

	QStrDrawAlt(c, mx + 64, y + QGO_BEGIN * pitch, "begin game");

	StrPrint(line, "%-14s %d", "max players", q_go_maxplayers);
	QStrDrawAlt(c, mx + 64, y + QGO_MAXPLAYERS * pitch, line);

	//coop and deathmatch are never both set, so coop alone names the mode
	if (QCvarGet("coop") != 0.0)
		StrPrint(line, "%-14s %s", "game type", "cooperative");
	else
		StrPrint(line, "%-14s %s", "game type", "deathmatch");
	QStrDrawAlt(c, mx + 64, y + QGO_GAMETYPE * pitch, line);

	v = ToI64(QCvarGet("teamplay"));
	if (v == 1)
		StrPrint(line, "%-14s %s", "teamplay", "no friendly fire");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "teamplay", "friendly fire");
	else
		StrPrint(line, "%-14s %s", "teamplay", "off");
	QStrDrawAlt(c, mx + 64, y + QGO_TEAMPLAY * pitch, line);

	v = ToI64(QCvarGet("skill"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "skill", "easy");
	else if (v == 1)
		StrPrint(line, "%-14s %s", "skill", "normal");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "skill", "hard");
	else
		StrPrint(line, "%-14s %s", "skill", "nightmare");
	QStrDrawAlt(c, mx + 64, y + QGO_SKILL * pitch, line);

	//zero is off in both, not a limit of nothing
	v = ToI64(QCvarGet("fraglimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "frag limit", "none");
	else
		StrPrint(line, "%-14s %d frags", "frag limit", v);
	QStrDrawAlt(c, mx + 64, y + QGO_FRAGLIMIT * pitch, line);

	v = ToI64(QCvarGet("timelimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "time limit", "none");
	else
		StrPrint(line, "%-14s %d minutes", "time limit", v);
	QStrDrawAlt(c, mx + 64, y + QGO_TIMELIMIT * pitch, line);

	StrPrint(line, "%-14s %s", "episode", q_go_ep_name[q_go_episode]);
	QStrDrawAlt(c, mx + 64, y + QGO_EPISODE * pitch, line);

	StrPrint(line, "%-14s %s", "level",
		q_go_map[q_go_ep_first[q_go_episode] + q_go_level]);
	QStrDrawAlt(c, mx + 64, y + QGO_LEVEL * pitch, line);

	//a caret, the spinning cursor is oversized at this pitch
	QStrDrawAlt(c, mx + 48, y + q_go_row * pitch, ">");

	QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool QGoKey(I64 sc)
{//M_GameOptions_Key. every row writes its cvar as it is edited, so the world
 //is already configured by the time begin game queues the map
	I64 dir;
	I64 v;
	I64 count;

	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_MULTI;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_go_row--;
		if (q_go_row < 0)
			q_go_row = QGO_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_go_row++;
		if (q_go_row >= QGO_ROWS)
			q_go_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_NetStart_Change is never called for the begin row
		if (q_go_row == QGO_BEGIN)
			return TRUE;

		QMenuSound(QMSND_VALUE);

		dir = 1;
		if (sc == SC_CURSOR_LEFT)
			dir = -1;

		switch (q_go_row)
		{
			case QGO_MAXPLAYERS:
				//the slot table is allocated at QSV_MAX_CLIENTS before any map
				//spawns, so there is no cvar to write - this bounds the choice
				q_go_maxplayers += dir;
				if (q_go_maxplayers > QSV_MAX_CLIENTS)
					q_go_maxplayers = 2;
				if (q_go_maxplayers < 2)
					q_go_maxplayers = QSV_MAX_CLIENTS;
				break;

			case QGO_GAMETYPE:
				//MUTUALLY EXCLUSIVE. both set is a state the mode resolver
				//cannot describe, so the pair is always written together
				if (QCvarGet("coop") != 0.0)
				{
					QCvarSet("coop", 0.0);
					QCvarSet("deathmatch", 1.0);
				}
				else
				{
					QCvarSet("coop", 1.0);
					QCvarSet("deathmatch", 0.0);
				}
				break;

			case QGO_TEAMPLAY:
				v = ToI64(QCvarGet("teamplay")) + dir;
				if (v > 2)	v = 0;
				if (v < 0)	v = 2;
				QCvarSet("teamplay", ToF64(v));
				break;

			case QGO_SKILL:
				v = ToI64(QCvarGet("skill")) + dir;
				if (v > 3)	v = 0;
				if (v < 0)	v = 3;
				QCvarSet("skill", ToF64(v));
				break;

			case QGO_FRAGLIMIT:
				v = ToI64(QCvarGet("fraglimit")) + dir * 10;
				if (v > 100)	v = 0;
				if (v < 0)		v = 100;
				QCvarSet("fraglimit", ToF64(v));
				break;

			case QGO_TIMELIMIT:
				v = ToI64(QCvarGet("timelimit")) + dir * 5;
				if (v > 60)	v = 0;
				if (v < 0)	v = 60;
				QCvarSet("timelimit", ToF64(v));
				break;

			case QGO_EPISODE:
				//shareware wraps at two, which is what hides episodes 2-4,
				//end and the dm maps - their files are not on the disc
				count = QGoEpisodeCount();
				q_go_episode += dir;
				if (q_go_episode >= count)	q_go_episode = 0;
				if (q_go_episode < 0)		q_go_episode = count - 1;

				//episodes are different lengths, the old index can be past
				//the end of the new one
				q_go_level = 0;
				break;

			case QGO_LEVEL:
				count = QGoLevelCount();
				q_go_level += dir;
				if (q_go_level >= count)	q_go_level = 0;
				if (q_go_level < 0)			q_go_level = count - 1;
				break;

			default:
				break;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//only the top row does anything, the rest are left/right values
		if (q_go_row != QGO_BEGIN)
			return TRUE;

		QMenuSound(QMSND_ENTER);

		//bind so a remote client has something to reach. not fatal if it
		//fails - a listen server with nobody connected still runs
		if (QNetUdpAvailable())
		{
			//DHCP first under SLIRP, AutoIP 10.0.0.1 only without it - that
			//address is socket MP, not hostfwd
			if (!QNetLocalIP)
				QNetDhcp;
			if (!QNetLocalIP)
				QNetAutoIP(0);

			if (QNetUdpOpen(QNET_PORT_DEFAULT))
			{
				q_udp_server = TRUE;
				QNetDgrmInit;
			}
		}

		//the map must RESTART so items spawn with the mode already active.
		//q_mp_start_dm is what drops the attract loop and leaves the menu, the
		//frame loop services the pending change
		//before the changelevel: QGameInit reserves this many edicts
		QSvMaxClientsSet(q_go_maxplayers);

		QStrCopy(q_change_map,
			q_go_map[q_go_ep_first[q_go_episode] + q_go_level], 64);
		q_change_pending = TRUE;
		q_mp_start_dm    = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 QSetupInput()
{//same charset and edge detection the console uses
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_setup_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_setup_len < 15)
		{
			q_setup_name[q_setup_len] = ch;
			q_setup_len++;
			q_setup_name[q_setup_len] = 0;
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_setup_len > 0)
	{
		q_setup_len--;
		q_setup_name[q_setup_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_setup_editing = FALSE;
		q_setup_ate_enter = TRUE;
		QCfgSave;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QSetupKey(I64 sc)
{

	//while editing, every key belongs to QSetupInput, which polls the keyboard
	//directly - the shell only forwards a handful of scancodes here
	if (q_setup_editing)
		return TRUE;

	//this and QSetupInput see the same physical press, so swallow the ENTER
	//that ended editing or the row handler below re-enters it at once
	if (q_setup_ate_enter)
	{
		q_setup_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row--;
		if (q_set_row < 0)
			q_set_row = QSET_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row++;
		if (q_set_row >= QSET_ROWS)
			q_set_row = 0;
		return TRUE;
	}

	//14 colours, the colormap's player-shirt range
	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		if (q_set_row == QSET_TOP || q_set_row == QSET_BOTTOM)
		{
			QMenuSound(QMSND_VALUE);

			if (q_set_row == QSET_TOP)
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_top++;
				else						q_setup_top--;

				if (q_setup_top > 13)	q_setup_top = 0;
				if (q_setup_top < 0)	q_setup_top = 13;
			}
			else
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_bottom++;
				else						q_setup_bottom--;

				if (q_setup_bottom > 13)	q_setup_bottom = 0;
				if (q_setup_bottom < 0)		q_setup_bottom = 13;
			}

			QCfgSave;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_set_row == QSET_NAME)
		{
			q_setup_editing = TRUE;
			q_setup_len     = StrLen(q_setup_name);
		}
		else if (q_set_row == QSET_BACK)
		{
			QCfgSave;
			q_menu_page = QPAGE_MULTI;
		}

		return TRUE;
	}

	return FALSE;
}

U0 QMenuDraw(CQCanvas *c)
{//M_Main_Draw: banner, spine plaque, item block, spinning cursor
	I64 frame;
	I64 x;
	I64 y;

	if (q_menu_page == QPAGE_OPTIONS)
	{
		QOptDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_KEYS)
	{
		QKeysDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_NOTICE)
	{
		QNoticeDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_HELP)
	{
		QHelpDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_LANCONFIG)
	{
		QLanDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_SINGLE)
	{
		QSingleDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_MULTI)
	{
		QMultiDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_SETUP)
	{
		QSetupDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_GAMEOPT)
	{
		QGoDraw(c);
		return;
	}

	//dark backdrop, so the menu reads over the last rendered frame
	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, QMenuXOfs(c) + 16, 4);

	//centred in the virtual box, NOT the canvas - mix the two and the plaque
	//and the artwork drift apart as the canvas grows
	if (q_pic_ttlmain.pixels)
		QPicDraw(c, &q_pic_ttlmain,
			QMenuXOfs(c) + (QMENU_VW - q_pic_ttlmain.width) / 2, 4);

	//x=72, where the original puts the item block
	if (q_pic_mainmenu.pixels)
		QPicDraw(c, &q_pic_mainmenu, QMenuXOfs(c) + 72, QMENU_Y);

	//six frames at 10Hz
	frame = ToI64(tS * 10.0) % 6;
	x     = QMenuXOfs(c) + 72 - 18;
	y     = QMENU_Y + q_menu_row * QMENU_ROW_H - 4;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);

	if (q_menu_ingame)
		QStrDrawCenterAlt(c, c->height - 20, "ESC resumes the game");
	else
		QStrDrawCenterAlt(c, c->height - 20, "arrows move, enter selects");
}

Bool QOptKey(I64 sc)
{//left/right adjust, enter activates, escape returns
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row--;
		if (q_opt_row < 0)
			q_opt_row = QOPT_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row++;
		if (q_opt_row >= QOPT_ROWS)
			q_opt_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_AdjustSliders plays this once per value change
		QMenuSound(QMSND_VALUE);

		switch (q_opt_row)
		{
			case QOPT_SCRSIZE:
				//SCR_SizeUp_f / SCR_SizeDown_f: 10 at a time, 30..120
				if (sc == SC_CURSOR_LEFT)
					QCvarSet("viewsize", QCvarGet("viewsize") - 10.0);
				else
					QCvarSet("viewsize", QCvarGet("viewsize") + 10.0);

				if (QCvarGet("viewsize") < 30.0)
					QCvarSet("viewsize", 30.0);
				if (QCvarGet("viewsize") > 120.0)
					QCvarSet("viewsize", 120.0);
				break;

			case QOPT_ALWAYSRUN:
				//M_AdjustSliders moves the speed cvars together
				if (QCvarGet("cl_forwardspeed") > 200.0)
				{
					QCvarSet("cl_forwardspeed", 200.0);
					QCvarSet("cl_backspeed", 200.0);
				}
				else
				{
					QCvarSet("cl_forwardspeed", 400.0);
					QCvarSet("cl_backspeed", 400.0);
				}
				break;

			case QOPT_INVERT:
				//invert is the sign of m_pitch, not a separate flag
				QCvarSet("m_pitch", -QCvarGet("m_pitch"));
				break;

			case QOPT_SENS:
				if (sc == SC_CURSOR_LEFT)
					q_opt_sensitivity -= 0.02;
				else
					q_opt_sensitivity += 0.02;

				if (q_opt_sensitivity < 0.02)
					q_opt_sensitivity = 0.02;
				if (q_opt_sensitivity > 0.60)
					q_opt_sensitivity = 0.60;
				break;

			case QOPT_VOLUME:
				if (sc == SC_CURSOR_LEFT)
					q_opt_volume -= 10;
				else
					q_opt_volume += 10;

				q_opt_volume = ClampI64(q_opt_volume, 0, 100);
				q_snd_master = ToF64(q_opt_volume) / 100.0;
				break;

			case QOPT_CROSSHAIR:
				if (QCvarGet("crosshair") != 0.0)
					q_opt_crosshair = 0;
				else
					q_opt_crosshair = 1;

				QCvarSet("crosshair", ToF64(q_opt_crosshair));
				QCfgSave;
				break;

			case QOPT_MUSICVOL:
				//bgmvolume, applied to the running track so the slider is
				//audible while it moves
				if (sc == SC_CURSOR_LEFT)
					q_music_volume -= 0.1;
				else
					q_music_volume += 0.1;

				if (q_music_volume < 0.0)
					q_music_volume = 0.0;
				if (q_music_volume > 1.0)
					q_music_volume = 1.0;

				QMusicApplyVolume;
				break;

			case QOPT_RES:
				if (sc == SC_CURSOR_LEFT)
					q_opt_res--;
				else
					q_opt_res++;

				q_opt_res = ClampI64(q_opt_res, 0, QRES_COUNT - 1);

				//can't reallocate the render target here, the compositor may
				//be mid-blit. the app rebuilds between frames on this flag
				q_res_dirty = TRUE;
				break;

			case QOPT_FULLSCREEN:
				q_opt_fullscreen = !q_opt_fullscreen;
				q_res_dirty      = TRUE;
				break;

			case QOPT_GAMMA:
				//left darkens and shrinks the bar. M_AdjustSliders does
				//gamma -= dir * 0.05 with dir -1 for left, so left raises the
				//exponent; the bar shows (max - gamma), so both track
				if (sc == SC_CURSOR_LEFT)
					q_opt_gamma += 0.05;
				else
					q_opt_gamma -= 0.05;

				if (q_opt_gamma < QGAMMA_MIN)
					q_opt_gamma = QGAMMA_MIN;
				if (q_opt_gamma > QGAMMA_MAX)
					q_opt_gamma = QGAMMA_MAX;

				QPalSetGamma(q_opt_gamma);
				break;

			case QOPT_GUNCLIP:
				q_opt_gunclip = !q_opt_gunclip;
				break;

			default:
				break;
		}

		//written straight out, there is no apply step
		QCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_opt_row == QOPT_BACK)
			q_menu_page = QPAGE_MAIN;
		else if (q_opt_row == QOPT_CUSTOMIZE)
		{
			q_keys_row     = 0;
			q_keys_capture = FALSE;
			q_menu_page    = QPAGE_KEYS;
		}
		else if (q_opt_row == QOPT_RESET)
			QOptResetDefaults;

		return TRUE;
	}

	return FALSE;
}

Bool QMenuKey(I64 sc, Bool *_start_game)
{//M_Keydown. TRUE when the key was consumed
	*_start_game = FALSE;

	if (q_menu_page == QPAGE_NOTICE)
	{
		if (sc == SC_ENTER)
		{
			QMenuSound(QMSND_ENTER);
			q_menu_page = QPAGE_MAIN;
			return TRUE;
		}
		return FALSE;
	}

	if (q_menu_page == QPAGE_OPTIONS)
		return QOptKey(sc);

	if (q_menu_page == QPAGE_KEYS)
		return QKeysKey(sc);

	if (q_menu_page == QPAGE_HELP)
		return QHelpKey(sc);

	if (q_menu_page == QPAGE_LANCONFIG)
		return QLanKey(sc);

	if (q_menu_page == QPAGE_SINGLE)
		return QSingleKey(sc, _start_game);

	if (q_menu_page == QPAGE_MULTI)
		return QMultiKey(sc);

	if (q_menu_page == QPAGE_SETUP)
		return QSetupKey(sc);

	if (q_menu_page == QPAGE_GAMEOPT)
		return QGoKey(sc);

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row--;
		if (q_menu_row < 0)
			q_menu_row = QMENU_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row++;
		if (q_menu_row >= QMENU_ROWS)
			q_menu_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		switch (q_menu_row)
		{
			case QMENU_SINGLE:
				//M_Menu_SinglePlayer_f opens a page, it does not drop straight
				//into the world - save and load live on it
				q_menu_page = QPAGE_SINGLE;
				q_sp_row    = 0;
				break;

			case QMENU_OPTIONS:
				q_menu_page = QPAGE_OPTIONS;
				q_opt_row   = 0;
				break;

			case QMENU_MULTI:
				q_menu_page = QPAGE_MULTI;
				q_mp_row    = 0;
				break;

			case QMENU_HELP:
				//the real help/ordering screens, not an invented caption
				q_menu_page = QPAGE_HELP;
				q_help_page = 0;
				break;

			case QMENU_QUIT:
				q_quit_request = TRUE;
				break;

			default:
				break;
		}
		return TRUE;
	}

	return FALSE;
}
