//live settings the options page edits
F64		q_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		q_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		q_opt_res			= 0;		//index into q_res_w / q_res_h
Bool	q_opt_fullscreen	= TRUE;
F64		q_opt_gamma			= 1.0;		//1.0 untouched, lower is brighter

//FALSE is the software renderer's behaviour - the gun goes in the depth buffer
//like any model and sinks into a wall pressed against. TRUE is GLQuake's
//glDepthRange(0, 0.3), which never intersects anything
Bool	q_opt_gunclip		= FALSE;
Bool	q_res_dirty			= FALSE;	//the app must rebuild the canvas

CQPic	q_pic_mainmenu;
CQPic	q_pic_ttlmain;
