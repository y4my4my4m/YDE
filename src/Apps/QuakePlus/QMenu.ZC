#define QOPT_SENS		1
#define QOPT_VOLUME		2
#define QOPT_MUSICVOL	3		//the /music folder, not a CD
#define QOPT_ALWAYSRUN	4		//cl_forwardspeed 200 or 400
#define QOPT_INVERT		5		//m_pitch sign
//no lookspring/lookstrafe rows: both need a +mlook key to hold, and this port
//mouse-looks permanently. the cvars still exist for the console
#define QOPT_RES		6
#define QOPT_FULLSCREEN	7
#define QOPT_GAMMA		8
#define QOPT_GUNCLIP	9
#define QOPT_CROSSHAIR	10
#define QOPT_CUSTOMIZE	11
#define QOPT_RESET		12
#define QOPT_BACK		13
#define QOPT_ROWS		14

//render target sizes, not window sizes - the result is centred and integer
//scaled into whatever window it lands in. this is the performance dial,
//640x480 is four times the rasteriser work of 320x240
#define QRES_COUNT		5
I64 q_res_w[QRES_COUNT] = {320, 400, 512, 640, 800};
I64 q_res_h[QRES_COUNT] = {240, 300, 384, 480, 600};

I64		q_state			= QST_MENU;
I64		q_menu_row		= 0;
I64		q_menu_page		= QPAGE_MAIN;
I64		q_opt_row		= 0;
Bool	q_menu_ingame	= FALSE;	//a map is running, enables Resume
Bool	q_quit_request	= FALSE;
U8		q_notice[64];
I64		q_mp_row		= 0;

