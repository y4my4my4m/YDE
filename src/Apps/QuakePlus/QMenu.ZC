// QMenu.ZC - main menu, console, and the game state machine
//
// engine side, not QuakeC. the menu is built from PAK artwork - mainmenu,
// ttl_main, the qplaque spine, the six-frame cursor - and the console draws
// over conback in CONCHARS. all of it into the indexed canvas, so it goes
// through the game palette like the world does

#define QST_MENU		0
#define QST_PLAYING		1
#define QST_CONSOLE		2

//main menu rows, in draw order
#define QMENU_SINGLE	0
#define QMENU_MULTI		1
#define QMENU_OPTIONS	2
#define QMENU_HELP		3
#define QMENU_QUIT		4
#define QMENU_ROWS		5

//gfx/mainmenu.lmp layout: rows 20 apart from y=32, picture drawn at x=72
#define QMENU_X			72
#define QMENU_Y			32
#define QMENU_ROW_H		20
#define QMENU_CURSOR_X	54

#define QCON_LINES		24
#define QCON_WIDTH		40
#define QCON_HEIGHT		128		//console drops down this far

//current page
#define QPAGE_MAIN		0
#define QPAGE_OPTIONS	1
#define QPAGE_NOTICE	2
#define QPAGE_MULTI		3
#define QPAGE_SETUP		4
#define QPAGE_HELP		5
#define QPAGE_LANCONFIG	6
#define QPAGE_SINGLE	7
#define QPAGE_KEYS		8
#define QPAGE_GAMEOPT	9

//M_Menu_SinglePlayer_f's rows, in the original's order
#define QSP_NEWGAME		0
#define QSP_LOAD		1
#define QSP_SAVE		2
#define QSP_ROWS		3

I64  q_sp_row       = 0;
Bool q_menu_save_req = FALSE;	//polled by the main loop, it owns save/load
Bool q_menu_load_req = FALSE;

//M_LanConfig, the JOIN GAME - TCP/IP page. address typed here, not console
#define QLAN_ADDRESS	0
#define QLAN_SEARCH		1		//broadcast query, results listed below
#define QLAN_JOIN		2
#define QLAN_BACK		3
#define QLAN_ROWS		4

//M_Help's NUM_HELP_PAGES. help0..help5.lmp are in PAK0 on both releases - the
//pages are the ordering info, which is why the row reads HELP/ORDERING either
//way. that label is baked into gfx/mainmenu.lmp, not gated on a version
#define QHELP_PAGES		6

//multiplayer rows. the first three MUST match gfx/mp_menu.lmp - JOIN A GAME,
//NEW GAME, SETUP. back is ours, drawn small underneath. no level row: the map
//is chosen on game options, where the original keeps it
#define QMP_JOIN		0
#define QMP_NEW			1
#define QMP_SETUP		2
#define QMP_BACK		3
#define QMP_ROWS		4

//setup rows. no "accept changes" row - values apply as they are edited
#define QSET_NAME		0
#define QSET_TOP		1
#define QSET_BOTTOM		2
#define QSET_BACK		3
#define QSET_ROWS		4

//M_Options_Draw's rows, in its order. resolution, screen and gun depth are
//ours - the original has no windowed video to configure
//--- key bindings -----------------------------------------------------------
//
// movement keys live in a table so the customize page can rebind and save
// them. same idea as the original's bind commands with default.cfg

#define QBIND_FORWARD	0
#define QBIND_BACK		1
#define QBIND_LEFT		2
#define QBIND_RIGHT		3
#define QBIND_JUMP		4
#define QBIND_COUNT		5

I64		q_bind_key[QBIND_COUNT];
U8		*q_bind_label[QBIND_COUNT];
//console spelling of the same actions, so bind/unbind talk in id's names
U8		*q_bind_cmd[QBIND_COUNT];
//QCfgLoad runs BEFORE QCvarInit, so it parks crosshair here - setting the
//cvar early gets a second entry appended by the init that follows
I64		q_opt_crosshair	= 0;
I64		q_keys_row		= 0;
Bool	q_keys_capture	= FALSE;	//next keypress is the new binding

U0 QBindDefaults()
{//globals aren't zeroed, set every slot
	q_bind_key[QBIND_FORWARD] = Char2ScanCode('w');
	q_bind_key[QBIND_BACK]    = Char2ScanCode('s');
	q_bind_key[QBIND_LEFT]    = Char2ScanCode('a');
	q_bind_key[QBIND_RIGHT]   = Char2ScanCode('d');
	q_bind_key[QBIND_JUMP]    = Char2ScanCode(' ');

	q_bind_label[QBIND_FORWARD] = "move forward";
	q_bind_label[QBIND_BACK]    = "move back";
	q_bind_label[QBIND_LEFT]    = "move left";
	q_bind_label[QBIND_RIGHT]   = "move right";
	q_bind_label[QBIND_JUMP]    = "jump / swim up";

	q_bind_cmd[QBIND_FORWARD] = "+forward";
	q_bind_cmd[QBIND_BACK]    = "+back";
	q_bind_cmd[QBIND_LEFT]    = "+moveleft";
	q_bind_cmd[QBIND_RIGHT]   = "+moveright";
	q_bind_cmd[QBIND_JUMP]    = "+jump";
}

U0 QBindKeyName(U8 *out, I64 sc)
{//printable name for a scancode, spelling out the non-character keys
	I64 ch;

	//the customize page clears a slot to 0, and unbind does the same. no
	//scancode of 0 arrives from the keyboard, so it reads as empty
	if (sc <= 0)
	{
		StrPrint(out, "???");
		return;
	}

	if (sc == Char2ScanCode(' '))
	{
		StrPrint(out, "space");
		return;
	}

	ch = ScanCode2Char(sc);
	if (ch > 32 && ch < 127)
		StrPrint(out, "%c", ch);
	else
		StrPrint(out, "key %d", sc);
}

I64 QBindKeyParse(U8 *name)
{//inverse of QBindKeyName: 0 when nothing sane comes out
	I64 sc;
	I64 ch;

	if (!name[0])
		return 0;

	if (!StrICompare(name, "space"))
		return Char2ScanCode(' ');

	if (!name[1])
	{
		ch = name[0];
		if (ch >= 'A' && ch <= 'Z')
			ch += 32;
		return Char2ScanCode(ch);
	}

	//"key 42" prints as two tokens, so accept the bare number too
	if (!StrNICompare(name, "key", 3))
	{
		sc = Str2I64(name + 3);
		if (sc > 0)
			return sc;
		return 0;
	}

	if (name[0] >= '0' && name[0] <= '9')
	{
		sc = Str2I64(name);
		if (sc > 0)
			return sc;
	}

	return 0;
}

I64 QBindFindAction(U8 *cmd)
{//action name to QBIND_ index, -1 for none. leading + optional
	I64 i;

	if (!cmd[0])
		return -1;

	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (!StrICompare(cmd, q_bind_cmd[i]))
			return i;
		if (!StrICompare(cmd, q_bind_cmd[i] + 1))
			return i;
	}

	return -1;
}

//--- aliases ---------------------------------------------------------------
//
// Cmd_Alias_f's list. a fixed table, not a malloc'd chain: nothing here frees
// and 32 is more than any config ships with

#define QALIAS_MAX		32
#define QALIAS_NAME		64
#define QALIAS_TEXT		128
#define QALIAS_DEPTH	8		//Cmd_ExecuteString's recursion guard

U8	q_alias_name[QALIAS_MAX * QALIAS_NAME];
U8	q_alias_text[QALIAS_MAX * QALIAS_TEXT];
I64	q_alias_count = 0;
I64	q_alias_depth = 0;

U0 QAliasInit()
{//globals aren't zeroed and the count indexes a fixed array
	I64 i;

	for (i = 0; i < QALIAS_MAX; i++)
	{
		q_alias_name[i * QALIAS_NAME] = 0;
		q_alias_text[i * QALIAS_TEXT] = 0;
	}

	q_alias_count = 0;
	q_alias_depth = 0;
}

I64 QAliasFind(U8 *name)
{//index or -1
	I64 i;

	for (i = 0; i < q_alias_count; i++)
	{
		if (!StrICompare(q_alias_name + i * QALIAS_NAME, name))
			return i;
	}

	return -1;
}

