I64 QGoEpisodeCount()
{//M_GameOptions_Key's own count: 7 registered, 2 otherwise. episodes 2-4, end
 //and the dm maps are all PAK1, so shareware reaches start and episode 1 only
	if (QCvarGet("registered") != 0.0)
		return QGO_EPISODES;

	return 2;
}

I64 QGoLevelCount()
{//levels in the selected episode, never zero
	return q_go_ep_count[q_go_episode];
}

I64		q_set_row		= 0;

//player identity, the original's name and color client commands. held here
//and published on the wire at signon
U8		q_setup_name[16];

//q_game_dir lives in QPak.ZC - COM search path reads it
I64		q_setup_top		= 0;	//shirt, 0-13
I64		q_setup_bottom	= 0;	//trousers, 0-13
Bool	q_setup_editing	= FALSE;
Bool	q_setup_ate_enter = FALSE;

//join page address field
I64		q_lan_row		= 0;
U8		q_lan_addr[24];
Bool	q_lan_editing	= FALSE;
I64		q_lan_len		= 0;
Bool	q_lan_ate_enter	= FALSE;
I64		q_setup_len		= 0;

//the multiplayer page wants a listen server, the app shell owns the world
Bool	q_mp_start_dm	= FALSE;

//live settings the options page edits
F64		q_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		q_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		q_opt_res			= QRES_DEFAULT;	//index into q_res_w / q_res_h
Bool	q_opt_fullscreen	= TRUE;
F64		q_opt_gamma			= 1.0;		//1.0 untouched, lower is brighter

//FALSE is the software renderer's behaviour - the gun goes in the depth buffer
//like any model and sinks into a wall pressed against. TRUE is GLQuake's
//glDepthRange(0, 0.3), which never intersects anything
Bool	q_opt_gunclip		= FALSE;
Bool	q_res_dirty			= FALSE;	//the app must rebuild the canvas

CQPic	q_pic_mainmenu;
CQPic	q_pic_ttlmain;
CQPic	q_pic_qplaque;
CQPic	q_pic_conback;
CQPic	q_pic_help[QHELP_PAGES];
I64		q_help_page = 0;
CQPic	q_pic_sp_menu;
CQPic	q_pic_cursor[6];
CQPic	q_pic_p_single;		//SINGLE PLAYER title plaque
CQPic	q_pic_p_multi;		//MULTIPLAYER title plaque
CQPic	q_pic_mp_menu;		//the three multiplayer rows, as artwork
CQPic	q_pic_p_option;		//OPTIONS title plaque
CQPic	q_pic_menuplyr;		//the setup page's player portrait

//scrollback, fixed rows - this is a diagnostic surface, not a text editor
U8		q_con_text[QCON_LINES * QCON_WIDTH];

//print time per line. Con_DrawNotify shows the last few at the top for
//con_notifytime seconds - without it every pickup message lives only inside a
//console nobody has open
F64		q_con_time[QCON_LINES];

#define QCON_NOTIFY_LINES	4
#define QCON_NOTIFY_TIME	3.0
I64		q_con_line		= 0;
I64		q_con_scroll	= 0;	//lines scrolled back from the newest
Bool	q_con_ready		= FALSE;

//S_LocalSound's menu feedback:
//  menu1 - moving the highlight
//  menu2 - entering a page or confirming
//  menu3 - changing a value
//played at the listener with zero attenuation, always full volume
//stuffcmd/unknown-command logging - a settings loop is the same line per
//frame, and console prints scroll away
I64 q_stuff_logged   = 0;
I64 q_unknown_logged = 0;
U8  q_stuff_line[160];

#define QMSND_MOVE		"misc/menu1.wav"
#define QMSND_ENTER		"misc/menu2.wav"
#define QMSND_VALUE		"misc/menu3.wav"

//--- preferences ------------------------------------------------------------
//
// plain text beside the game data, one "key value" per line. not a struct dump
// so it survives fields being added or removed - unknown keys are skipped and
// missing ones keep their default
//
// per-machine state, not source. in .gitignore
#define QCFG_PATH	"QUAKECFG.TXT"

U0 QSetupDefaults()
{//globals aren't zeroed and QCfgLoad runs before QMenuInit, so defaults must
 //land first or a config with no name line leaves junk in the buffer
	//bindings included - a config predating the customize page has no bind
	//lines, and an unset scancode matches nothing
	QBindDefaults;
	QHostNameInit;
	QAliasInit;

	//the host cache is a global table with a global count - unset, slist walks
	//off the end of it before a single reply has arrived
	QSlistInit;

	//the episode/level tables are globals too - unset, game options reads
	//null map names
	QGoInit;

	q_opt_crosshair = 0;

	QStrCopy(q_setup_name, "player", 16);
	q_setup_top     = 0;
	q_setup_bottom  = 0;
	q_setup_editing   = FALSE;
	q_setup_ate_enter = FALSE;
	q_setup_len       = 6;

	QStrCopy(q_lan_addr, "10.0.0.1", 24);
	q_lan_len       = 8;
	q_lan_row       = 0;
	q_lan_editing   = FALSE;
	q_lan_ate_enter = FALSE;
	q_mp_start_dm   = FALSE;
	q_mp_row        = 0;
	q_set_row       = 0;

	//QCfgLoad reads this before the archives are mounted
	q_game_dir[0]   = 0;
}

//the fixed settings block plus room for a full 256 key command table
#define QCFG_BUF	24576

U0 QCfgSave()
{//called whenever an option changes
	U8  buf[QCFG_BUF];
	U8  kbline[96];
	I64 kb;

	StrPrint(buf,
		"sensitivity %d\n"
		"volume %d\n"
		"viewsize %d\n"
		"alwaysrun %d\n"
		"invert %d\n"
		"farclip %d\n"
		"resw %d\n"
		"resh %d\n"
		"fullscreen %d\n"
		"truecolor %d\n"
		"tclight %d\n"
		"fog %d\n"
		"texfilter %d\n"
		"exttex %d\n"
		"litrgb %d\n"
		"rgbmips %d\n"
		"fps %d\n"
		"cachemb %d\n"
		"hudscale %d\n"
		"hudstyle %d\n"
		"sbaralpha %d\n"
		"gamma %d\n"
		"gunclip %d\n"
		"musicvol %d\n"
		"hostname %s\n"
		"crosshair %d\n"
		"cl_csqc %d\n"
		"fov %d\n"
		"mipscale %d\n"
		"animlerp %d\n"
		"mdlwarp %d\n"
		"progmips %d\n"
		"contrast %d\n"
		"topcolor %d\n"
		"bottomcolor %d\n"
		"name %s\n"
		"game %s\n",
		ToI64(q_opt_sensitivity * 1000.0),
		q_opt_volume,
		ToI64(QCvarGet("viewsize")),
		ToI64(QCvarGet("cl_forwardspeed") > 200.0),
		ToI64(QCvarGet("m_pitch") < 0.0),
		ToI64(QCvarGet("gl_farclip")),
		q_res_w[q_opt_res],
		q_res_h[q_opt_res],
		ToI64(q_opt_fullscreen),
		ToI64(q_opt_truecolor),
		ToI64(q_opt_tclight),
		ToI64(q_opt_fog),
		ToI64(q_opt_texfilter),
		ToI64(q_opt_exttex),
		ToI64(q_opt_litrgb),
		ToI64(q_opt_rgbmips),
		ToI64(q_opt_fps),
		q_surf_budget / 1048576,
		q_opt_hudscale,
		q_opt_hudstyle,
		q_opt_sbaralpha,
		ToI64(q_opt_gamma * 1000.0),
		ToI64(q_opt_gunclip),
		ToI64(q_music_volume * 1000.0),
		q_host_name,
		q_opt_crosshair,
		ToI64(q_cs_enable),
		ToI64(QCvarGet("scr_fov")),
		ToI64(q_mipscale * 1000.0),
		ToI64(q_lerp_models),
		ToI64(q_mdl_warp),
		ToI64(q_prog_mips),
		ToI64(q_contrast * 1000.0),
		q_setup_top,
		q_setup_bottom,
		q_setup_name,
		q_game_dir);

	//command binds are variable in number, so they follow the fixed block
	//rather than sitting in its StrPrint. one "keybind <scancode> <cmd>" per
	//bound key - the scancode, not the name, so parsing needs no key table
	for (kb = 0; kb < QKB_KEYS; kb++)
	{
		if (!q_keybind[kb * QKB_CMD_MAX])
			goto qcs_next_bind;

		StrPrint(kbline, "keybind %d %s\n", kb, &q_keybind[kb * QKB_CMD_MAX]);

		//the buffer is sized for the fixed block plus a full key table, but
		//truncating mid-line would leave a parseable half-setting behind
		if (StrLen(buf) + StrLen(kbline) >= QCFG_BUF - 1)
			goto qcs_binds_done;

		StrCopy(buf + StrLen(buf), kbline);

qcs_next_bind:
	}

qcs_binds_done:

	//thousandths, so the file holds no float text to parse
	if (!q_disk_writes || q_cfg_exec)
		return;

	//delete first: a shorter write over a longer file leaves the old tail
	//behind, and those stale lines parse as live settings on the next load
	if (FileFind(QCFG_PATH))
		Del(QCFG_PATH, FALSE, FALSE, FALSE);	//last arg silences the print

	FileWrite(QCFG_PATH, buf, StrLen(buf));
	q_cfg_saves++;
}

I64 QCfgValue(U8 *line)
{//the integer after the first space, or 0
 //
 //Str2I64 does NOT return 0 on text - it returns whatever the characters
 //parse to. a stale or malformed line fed that straight into ToBool(v != 0),
 //which reads as TRUE and pinned every boolean option on at load
	I64  i = 0;
	I64  st;
	Bool neg = FALSE;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	if (line[i] == '-')
	{
		neg = TRUE;
		i++;
	}

	st = i;
	while (line[i] >= '0' && line[i] <= '9')
		i++;

	//nothing numeric, or trailing junk after the digits
	if (i == st)
		return 0;
	if (line[i] && line[i] != ' ' && line[i] != '\t')
		return 0;

	if (neg)
		return -Str2I64(line + st);

	return Str2I64(line + st);
}

F64 QCfgValueF(U8 *line)
{//the number after the first space, fraction kept. cvars like scr_sbaralpha
 //are written "0.75" and QCfgValue would read that as 0
 //
 //hand rolled rather than Str2F64: the kernel parser accepts forms a cvar
 //never uses and returns junk on the ones it does
	I64  i = 0;
	F64  whole = 0.0;
	F64  frac  = 0.0;
	F64  scale = 1.0;
	Bool neg = FALSE;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	if (line[i] == '-')
	{
		neg = TRUE;
		i++;
	}
	else if (line[i] == '+')
		i++;

	while (line[i] >= '0' && line[i] <= '9')
	{
		whole = whole * 10.0 + ToF64(line[i] - '0');
		i++;
	}

	if (line[i] == '.')
	{
		i++;
		while (line[i] >= '0' && line[i] <= '9')
		{
			scale *= 0.1;
			frac  += ToF64(line[i] - '0') * scale;
			i++;
		}
	}

	whole += frac;

	if (neg)
		return -whole;

	return whole;
}

U0 QCfgLoad()
{//anything missing or unparsable keeps its default
	U8	*raw;
	U8	 line[128];
	I64	 size = 0;
	I64	 i    = 0;
	I64	 n;
	I64	 v;
	I64	 q_cfg_resw;
	I64	 q_cfg_resh;
	I64	 want;
	I64	 best;
	I64	 bestd;
	I64	 ri;
	I64	 d;
	I64	 kb;

	q_cfg_resw = 0;
	q_cfg_resh = 0;

	raw = FileRead(QCFG_PATH, &size);
	if (!raw)
		return;

	while (i < size)
	{
		//bounded line copy
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 127)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qcl_next;

		v = QCfgValue(line);

		if (!StrNICompare(line, "sensitivity ", 12))
			q_opt_sensitivity = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "volume ", 7))
			q_opt_volume = ClampI64(v, 0, 100);
		else if (!StrNICompare(line, "viewsize ", 9))
			q_cfg_viewsize = ClampI64(v, 30, 130);
		else if (!StrNICompare(line, "alwaysrun ", 10))
			q_cfg_run = ToI64(v != 0);
		else if (!StrNICompare(line, "invert ", 7))
			q_cfg_invert = ToI64(v != 0);
		else if (!StrNICompare(line, "farclip ", 8))
			q_cfg_farclip = v;
		else if (!StrNICompare(line, "truecolor ", 10))
			q_opt_truecolor = ToBool(v != 0);
		else if (!StrNICompare(line, "tclight ", 8))
			q_opt_tclight = ToBool(v != 0);
		else if (!StrNICompare(line, "fog ", 4))
			q_opt_fog = ToBool(v != 0);
		else if (!StrNICompare(line, "texfilter ", 10))
		{
			q_opt_texfilter = ToBool(v != 0);
			q_cfg_texfilter = v;
		}
		else if (!StrNICompare(line, "exttex ", 7))
			q_opt_exttex = ToBool(v != 0);
		else if (!StrNICompare(line, "litrgb ", 7))
			q_opt_litrgb = ToBool(v != 0);
		else if (!StrNICompare(line, "rgbmips ", 8))
			q_opt_rgbmips = ToBool(v != 0);
		else if (!StrNICompare(line, "fps ", 4))
			q_opt_fps = ToBool(v != 0);
		else if (!StrNICompare(line, "hudscale ", 9))
			q_opt_hudscale = ClampI64(v, 0, 8);
		else if (!StrNICompare(line, "hudstyle ", 9))
		{
			q_opt_hudstyle = ClampI64(v, 0, QHUD_STYLES - 1);
			QCvarSet("hudstyle", ToF64(q_opt_hudstyle));
		}
		else if (!StrNICompare(line, "sbaralpha ", 10))
			q_opt_sbaralpha = ClampI64(v, 0, 255);
		else if (!StrNICompare(line, "keybind ", 8))
		{
			//"keybind <scancode> <command>" - v is the scancode, the command
			//is everything past the space after it
			if (v > 0 && v < QKB_KEYS)
			{
				kb = 8;
				while (line[kb] && line[kb] != ' ')
					kb++;
				while (line[kb] == ' ')
					kb++;

				if (line[kb])
					QStrCopy(&q_keybind[v * QKB_CMD_MAX], line + kb,
						QKB_CMD_MAX);
			}
		}
		else if (!StrNICompare(line, "cachemb ", 8))
		{
			if (v >= 64 && v <= 4096)
				q_surf_budget = v * 1048576;
		}
		else if (!StrNICompare(line, "resw ", 5))
			q_cfg_resw = v;
		else if (!StrNICompare(line, "resh ", 5))
			q_cfg_resh = v;
		else if (!StrNICompare(line, "gunclip ", 8))
			q_opt_gunclip = ToBool(v != 0);
		else if (!StrNICompare(line, "musicvol ", 9))
			q_music_volume = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "hostname ", 9))
			QStrCopy(q_host_name, line + 9, 32);
		else if (!StrNICompare(line, "crosshair ", 10))
			q_opt_crosshair = v;
		else if (!StrNICompare(line, "cl_csqc ", 8))
			q_cs_enable = ToBool(v != 0);
		else if (!StrNICompare(line, "fov ", 4))
		{
			//the shell picks this up through the cvar; q_con_fov_want is
			//declared later in this file and QCfgLoad runs before any frame
			QCvarSet("scr_fov", ToF64(ClampI64(v, 10, 170)));
			QCvarSet("fov", QCvarGet("scr_fov"));
		}
		//stored in thousandths: the config is integer lines throughout
		else if (!StrNICompare(line, "progmips ", 9))
		{
			q_prog_mips = ToBool(v != 0);
			QCvarSet("r_progmips", ToF64(q_prog_mips));
		}
		else if (!StrNICompare(line, "mdlwarp ", 8))
		{
			q_mdl_warp = ToBool(v != 0);
			QCvarSet("r_softemu_mdl_warp", ToF64(q_mdl_warp));
		}
		else if (!StrNICompare(line, "animlerp ", 9))
		{
			q_lerp_models = ToBool(v != 0);
			QCvarSet("r_lerpmodels", ToF64(q_lerp_models));
		}
		else if (!StrNICompare(line, "mipscale ", 9))
		{
			q_mipscale = ToF64(ClampI64(v, 0, 8000)) / 1000.0;
			QCvarSet("d_mipscale", q_mipscale);
		}
		else if (!StrNICompare(line, "contrast ", 9))
		{
			QPalSetContrast(ToF64(ClampI64(v, 1000, 2000)) / 1000.0);
			QCvarSet("contrast", q_contrast);
		}
		//bindfwd/bindback/bindleft/bindright/bindjump are gone: they held one
		//key each. an old config still carrying them is ignored, and the
		//generic "bind" lines below restore the layout
		else if (!StrNICompare(line, "topcolor ", 9))
			q_setup_top = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "bottomcolor ", 12))
			q_setup_bottom = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "name ", 5))
			QStrCopy(q_setup_name, line + 5, 16);
		else if (!StrNICompare(line, "game ", 5))
		{
			//startup only, see q_pak_game_mounted
			if (!q_pak_game_mounted)
				QStrCopy(q_game_dir, line + 5, 32);
		}
		else if (!StrNICompare(line, "fullscreen ", 11))
			q_opt_fullscreen = ToBool(v);
		else if (!StrNICompare(line, "gamma ", 6))
			q_opt_gamma = ToF64(v) / 1000.0;

qcl_next:
	}

	Free(raw);

	//the file holds a size, not a table index, so entries can be reordered.
	//nearest by pixel count keeps a dropped mode from resetting to the default
	if (q_cfg_resw > 0 && q_cfg_resh > 0)
	{
		want = q_cfg_resw * q_cfg_resh;
		best = 0;
		bestd = -1;
		for (ri = 0; ri < QRES_COUNT; ri++)
		{
			d = q_res_w[ri] * q_res_h[ri] - want;
			if (d < 0)
				d = -d;
			if (q_res_w[ri] == q_cfg_resw && q_res_h[ri] == q_cfg_resh)
			{
				best = ri;
				break;
			}
			if (bestd < 0 || d < bestd)
			{
				bestd = d;
				best  = ri;
			}
		}
		q_opt_res = best;
	}

	//a hand-edited file can hold anything, clamp before pushing to hardware
	if (q_opt_sensitivity < 0.02)	q_opt_sensitivity = 0.02;
	if (q_opt_sensitivity > 0.60)	q_opt_sensitivity = 0.60;

	//scale the mix, not the AC97 master - that register is system wide
	q_snd_master = ToF64(q_opt_volume) / 100.0;
	QPalSetGamma(q_opt_gamma);
	QRGBUpdateActive;
}

//the menu is authored for 320x200. every fixed coordinate is offset by this
//so the page moves as one block, the same term M_DrawPic adds
#define QMENU_VW	320

//M_DrawSlider's conchars pieces: 128 left cap, 129 trough, 130 right cap,
//131 handle. range 0..1 positions the handle
#define QSLIDER_CELLS	10

U0 QMenuBackdrop(CQCanvas *c)
{//M_Draw's rule: with a game running the world stays up and dimmed, so the
 //menu reads as an overlay. only outside a game does conback fill the screen
	if (q_menu_ingame)
	{
		QDrawFadeScreen(c);
		return;
	}

	MemSet(c->pixels, 0, c->width * c->height);
	if (c->rgb)
		MemSet(c->rgb, 0, c->width * c->height * sizeof(U32));

	if (q_pic_conback.pixels)
		QPicDrawFill(c, &q_pic_conback);
}

U0 QMenuSlider(CQCanvas *c, I64 x, I64 y, F64 range)
{
	I64 i;

	if (range < 0.0)	range = 0.0;
	if (range > 1.0)	range = 1.0;

	QCharDraw(c, x - QCHAR_W, y, 128);

	for (i = 0; i < QSLIDER_CELLS; i++)
		QCharDraw(c, x + i * QCHAR_W, y, 129);

	QCharDraw(c, x + QSLIDER_CELLS * QCHAR_W, y, 130);

	QCharDraw(c, x + ToI64((QSLIDER_CELLS - 1) * QCHAR_W * range), y, 131);
}

I64 QMenuXOfs(CQCanvas *c)
{
	I64 ofs = (c->width - QMENU_VW) / 2;

	if (ofs < 0)
		ofs = 0;

	return ofs;
}

U0 QMenuSound(U8 *name)
{
	QSndPlayAt(name, q_snd_listener, 1.0, 0.0);
}

U0 QMenuInit()
{//globals aren't zeroed, a junk request flag saves or loads with no world
	q_sp_row        = 0;
	q_menu_save_req = FALSE;
	q_menu_load_req = FALSE;

	U8	name[24];
	I64	i;

	QPicLoad("gfx/mainmenu.lmp", &q_pic_mainmenu);
	QPicLoad("gfx/ttl_main.lmp", &q_pic_ttlmain);
	QPicLoad("gfx/qplaque.lmp", &q_pic_qplaque);
	QPicLoad("gfx/conback.lmp", &q_pic_conback);

	for (i = 0; i < QHELP_PAGES; i++)
	{
		StrPrint(name, "gfx/help%d.lmp", i);
		QPicLoad(name, &q_pic_help[i]);
	}
	QPicLoad("gfx/sp_menu.lmp", &q_pic_sp_menu);
	QPicLoad("gfx/ttl_sgl.lmp", &q_pic_p_single);
	QPicLoad("gfx/p_multi.lmp", &q_pic_p_multi);
	QPicLoad("gfx/mp_menu.lmp", &q_pic_mp_menu);
	QPicLoad("gfx/p_option.lmp", &q_pic_p_option);
	QPicLoad("gfx/menuplyr.lmp", &q_pic_menuplyr);

	for (i = 0; i < 6; i++)
	{
		StrPrint(name, "gfx/menudot%d.lmp", i + 1);
		QPicLoad(name, &q_pic_cursor[i]);
	}

	for (i = 0; i < QCON_LINES; i++)
		q_con_time[i] = -1000.0;

	for (i = 0; i < QCON_LINES * QCON_WIDTH; i++)
		q_con_text[i] = 0;

	q_con_line     = 0;
	q_con_scroll   = 0;
	q_con_ready    = TRUE;
	q_state        = QST_MENU;
	q_menu_row     = 0;
	q_menu_ingame  = FALSE;
	q_quit_request = FALSE;
}

U0 QConPrint(U8 *s)
{//wraps, never truncates. 40 columns, and dropping the tail hides exactly the
 //part worth reading - QuakeC's sprint output is not width aware either
	I64	 i = 0;
	I64	 n;
	U8	*row;

	if (!q_con_ready)
		return;

	//an empty string still costs a blank line
	while (TRUE)
	{
		row = q_con_text + (q_con_line % QCON_LINES) * QCON_WIDTH;
		n   = 0;

		while (s[i] && n < QCON_WIDTH - 1)
		{
			row[n] = s[i];
			n++;
			i++;
		}

		row[n] = 0;
		q_con_time[q_con_line % QCON_LINES] = tS;
		q_con_line++;

		if (!s[i])
			return;
	}
}

//--- console input ---------------------------------------------------------
//
// CharGet and KeyGet block, so typing runs off the same non-blocking scancode
// poll the game uses. every key needs its own edge detect or one tap repeats
// per frame - a screenful of characters at 190fps

#define QCON_INPUT_MAX	62

U8	 q_con_input[QCON_INPUT_MAX + 2];
I64	 q_con_input_len	= 0;

//Key_Console's history ring. edit_line is where typing goes, history_line is
//where the cursor-key walk sits
#define QCON_HISTORY	32

U8	 q_con_hist[QCON_HISTORY * (QCON_INPUT_MAX + 2)];
I64	 q_con_edit_line	= 0;
I64	 q_con_hist_line	= 0;

U0 QConHistoryInit()
{//globals aren't zeroed, and these index a fixed array
	I64 i;

	for (i = 0; i < QCON_HISTORY; i++)
		q_con_hist[i * (QCON_INPUT_MAX + 2)] = 0;

	q_con_edit_line = 0;
	q_con_hist_line = 0;
}

U0 QConHistoryRecall(I64 line)
{//stored line into the edit buffer
	U8 *src;

	if (line < 0 || line >= QCON_HISTORY)
		return;

	src = &q_con_hist[line * (QCON_INPUT_MAX + 2)];
	QStrCopy(q_con_input, src, QCON_INPUT_MAX + 1);
	q_con_input_len = StrLen(q_con_input);
}
U8	 q_key_prev[256];

//Key_Message: chat prompt without opening the console
Bool q_msg_mode		= FALSE;
Bool q_msg_team		= FALSE;
U8	 q_chat_buf[32];
I64	 q_chat_len		= 0;

Bool q_con_want_noclip	= FALSE;	//console asked for a noclip toggle
Bool q_con_want_quit	= FALSE;

//serviced by the frame loop, which owns the state machine and the view. a
//bind runs through the console executor, so these cannot act in place
//--- +command button state -------------------------------------------------
//
// a config binds MOVEMENT to +forward/+moveleft/... and the engine polls only
// its own five scancodes. anything rebound through those commands did nothing
// at all. these are level triggered: +cmd sets, -cmd clears, and QKeyBindFrame
// runs the - variant on release
#define QBTN_FORWARD	0
#define QBTN_BACK		1
#define QBTN_LEFT		2
#define QBTN_RIGHT		3
#define QBTN_MOVELEFT	4
#define QBTN_MOVERIGHT	5
#define QBTN_MOVEUP		6
#define QBTN_MOVEDOWN	7
#define QBTN_JUMP		8
#define QBTN_ATTACK		9
#define QBTN_SPEED		10
#define QBTN_STRAFE		11
#define QBTN_USE		12
#define QBTN_KLOOK		13
#define QBTN_MLOOK		14
#define QBTN_LOOKUP		15
#define QBTN_LOOKDOWN	16
#define QBTN_COUNT		17

Bool q_btn[QBTN_COUNT];			//level this frame: keys OR console
Bool q_btn_con[QBTN_COUNT];		//held by a console or stuffcmd +command

U0 QBtnClear()
{//globals are not zeroed, and a stuck button walks the player into a wall
	I64 i;

	for (i = 0; i < QBTN_COUNT; i++)
		q_btn_con[i] = FALSE;

	for (i = 0; i < QBTN_COUNT; i++)
		q_btn[i] = FALSE;
}

I64 QBtnIndex(U8 *name)
{//name WITHOUT the leading +/-
	if (!StrICompare(name, "forward"))		return QBTN_FORWARD;
	if (!StrICompare(name, "back"))			return QBTN_BACK;
	if (!StrICompare(name, "left"))			return QBTN_LEFT;
	if (!StrICompare(name, "right"))		return QBTN_RIGHT;
	if (!StrICompare(name, "moveleft"))		return QBTN_MOVELEFT;
	if (!StrICompare(name, "moveright"))	return QBTN_MOVERIGHT;
	if (!StrICompare(name, "moveup"))		return QBTN_MOVEUP;
	if (!StrICompare(name, "movedown"))		return QBTN_MOVEDOWN;
	if (!StrICompare(name, "jump"))			return QBTN_JUMP;
	if (!StrICompare(name, "attack"))		return QBTN_ATTACK;
	if (!StrICompare(name, "speed"))		return QBTN_SPEED;
	if (!StrICompare(name, "strafe"))		return QBTN_STRAFE;
	if (!StrICompare(name, "use"))			return QBTN_USE;
	if (!StrICompare(name, "klook"))		return QBTN_KLOOK;
	if (!StrICompare(name, "mlook"))		return QBTN_MLOOK;
	if (!StrICompare(name, "lookup"))		return QBTN_LOOKUP;
	if (!StrICompare(name, "lookdown"))		return QBTN_LOOKDOWN;

	return -1;
}

//SCR_UpdateZoom. the zoom is a 0..1 RAMP, not a switch:
//    float speed = scr_zoomspeed.value > 0 ? scr_zoomspeed.value : 1e6;
//    float delta = cl.zoomdir * speed * (cl.time - cl.oldtime);
//    cl.zoom += delta;  clamped to 0..1, zoomdir cleared at either end
//and SCR_CalcRefdef smoothsteps it before lerping the fov:
//    zoom *= zoom * (3 - 2 * zoom);
//    r_refdef.basefov = LERP (scr_fov.value, scr_zoomfov.value, zoom);
Bool q_zoom_on			= FALSE;	//+zoom / togglezoom, scr_zoomfov
F64  q_zoom			= 0.0;		//cl.zoom, 0 = normal fov, 1 = zoomed
F64  q_zoom_dir			= 0.0;		//cl.zoomdir, -1 out, +1 in, 0 at rest
Bool q_con_want_menu	= FALSE;	//togglemenu
I64  q_con_want_page	= -1;		//menu_* asked for a SPECIFIC page
Bool q_con_want_viewpos	= FALSE;	//viewpos, printed by the frame loop
Bool q_con_want_toggle	= FALSE;	//toggleconsole
Bool q_con_want_center	= FALSE;	//centerview
I64  q_con_want_msg		= 0;		//1 messagemode, 2 messagemode2

//printable keys, walked by character and mapped through Char2ScanCode. one
//entry per PHYSICAL key, in its unshifted form - the shifted form comes from
//QConShiftChar, so a key can carry both without either winning
U8 *q_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ./;',=[]\\-\`";

I64 QConShiftChar(I64 ch)
{//US layout. a semicolon is the command separator and was unreachable, so
 //"unbindall; exec default.cfg" could not be typed at all
	if (ch >= 'a' && ch <= 'z')	return ch - 32;

	switch (ch)
	{
		case '1':	return '!';
		case '2':	return '@';
		case '3':	return '#';
		case '4':	return '$$';	//dollar sign, doubled: a bare one
								//opens a HolyC doc command and eats
								//source to the next one
		case '5':	return '%';
		case '6':	return '^';
		case '7':	return '&';
		case '8':	return '*';
		case '9':	return '(';
		case '0':	return ')';
		case '-':	return '_';
		case '=':	return '+';
		case '[':	return '{';
		case ']':	return '}';
		case '\\':	return '|';
		case ';':	return ':';
		case '\'':	return '"';
		case ',':	return '<';
		case '.':	return '>';
		case '/':	return '?';
		case 96:	return 126;		//backtick to tilde, by value: HolyC gives
								//that character its own escape
	}

	return ch;
}

U0 QConInputReset()
{
	I64 i;

	//SEED from the keyboard, do not zero it. zeroing makes every key held at
	//the moment the console opens read as a fresh press on the next frame -
	//the console key itself first of all, which typed itself into the prompt
	for (i = 0; i < 256; i++)
		q_key_prev[i] = ToI64(ToBool(Bt(kbd.down_bitmap, i)));

	q_con_input[0]   = 0;
	q_con_input_len  = 0;
	q_con_scroll     = 0;
	q_con_want_noclip = FALSE;
	q_con_want_toggle = FALSE;
	q_con_want_center = FALSE;
	q_con_want_msg    = 0;
	q_zoom_on         = FALSE;
	q_zoom            = 0.0;
	q_zoom_dir        = 0.0;
	q_con_want_menu   = FALSE;
	q_con_want_page   = -1;
	q_con_want_viewpos = FALSE;
	q_con_want_quit   = FALSE;
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

Bool QConKeyEdge(I64 sc)
{//TRUE only on the frame a key goes down
	Bool down;
	Bool was;

	if (sc <= 0 || sc >= 256)
		return FALSE;

	down = ToBool(Bt(kbd.down_bitmap, sc));
	was  = ToBool(q_key_prev[sc]);

	if (down)
		q_key_prev[sc] = 1;
	else
		q_key_prev[sc] = 0;

	return ToBool(down && !was);
}

U0 QConScroll(I64 lines)
{//positive scrolls back toward older text. 0 just reclamps
	I64 top;

	q_con_scroll += lines;

	//never past the oldest line still in the ring, never below the newest
	top = q_con_line - 1;
	if (top > QCON_LINES - 1)
		top = QCON_LINES - 1;
	if (top < 0)
		top = 0;

	if (q_con_scroll > top)
		q_con_scroll = top;
	if (q_con_scroll < 0)
		q_con_scroll = 0;
}

//--- console command helpers ------------------------------------------------

//FL_ bits from defs.qc
#define QFL_GODMODE_	64
#define QFL_NOTARGET_	128

F64  q_con_fov_want	= 0.0;	//non-zero, console asked for a new fov
Bool q_con_want_save	= FALSE;
Bool q_con_want_load	= FALSE;
Bool q_con_save_ok		= TRUE;

//the shell owns the counter and is compiled after this file, so it publishes
//a copy here
I64 q_net_mismatch_report = 0;
U8  q_con_net_line[128];

U0 QConDrainProgs()
{//drain the QuakeC print buffer into the console, one line per newline
	U8	line[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (q_bi_print_len < 1)
		return;

	for (i = 0; i < q_bi_print_len; i++)
	{
		c = q_bi_print_buf[i];

		if (c == '\n' || n >= 126)
		{
			line[n] = 0;
			if (n > 0)
				QConPrint(line);
			n = 0;
		}

		if (c != '\n')
		{
			line[n] = c;
			n++;
		}
	}

	//QuakeC does not always terminate its lines, so flush the tail rather than
	//hold it until the next print
	if (n > 0)
	{
		line[n] = 0;
		QConPrint(line);
	}

	q_bi_print_len    = 0;
	q_bi_print_buf[0] = 0;
}

U32 QConParseIPV4(U8 *s)
{//dotted quad to host-order U32, 0 on failure
	I64 part[4];
	I64 n = 0;
	I64 v;
	I64 digits;
	I64 i = 0;

	while (n < 4)
	{
		v      = 0;
		digits = 0;

		while (s[i] >= '0' && s[i] <= '9')
		{
			v = v * 10 + (s[i] - '0');
			digits++;
			i++;

			if (v > 255)
				return 0;
		}

		if (!digits)
			return 0;

		part[n] = v;
		n++;

		if (n < 4)
		{
			if (s[i] != '.')
				return 0;
			i++;
		}
	}

	//an optional :port is accepted and ignored - every host we speak to is on
	//QNET_PORT_DEFAULT, and CCREP_SERVER_INFO advertises itself as ip:port, so
	//rejecting the suffix meant a server picked off the slist would not join
	//while the same address typed by hand would
	if (s[i] == ':')
	{
		i++;
		while (s[i] >= '0' && s[i] <= '9')
			i++;
	}

	//anything else trailing means it was not an address
	if (s[i] && s[i] != ' ')
		return 0;

	//ipv4_globals layout: little-endian host order, first octet in the low byte
	return part[0] | (part[1] << 8) | (part[2] << 16) | (part[3] << 24);
}

U0 QConConnectIP(U32 ip)
{//the connect itself, by address. slist already holds the U32 it answered
 //from, so joining a discovered server never formats or re-parses a string
	U8	msg[96];
	U32	me;

	if (!QNetUdpAvailable())
	{
		QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	if (!ip)
	{
		QConPrint("no address to connect to");
		return;
	}

	StrPrint(msg, "connecting to %d.%d.%d.%d...",
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	QConPrint(msg);

	//pick an address when the link has no DHCP, the direct VM-to-VM case.
	//the qip command overrides it
	QNetAutoIP(ip);

	if (!QNetUdpOpen(QNET_PORT_DEFAULT))
	{
		QConPrint(q_udp_status);
		return;
	}

	q_udp_server = FALSE;
	QNetDgrmInit;
	QNetUdpSetPeer(ip);

	//resolve the server MAC here, where a stall is acceptable, never in the
	//frame loop. doubles as the reachability test - no ARP reply, no machine
	if (!QNetUdpResolvePeer)
	{
		QConPrint("no arp reply - is the other vm up and on this link?");
		return;
	}

	//join now rather than wait for the retry tick
	QNetClientSendConnect(q_setup_name, q_setup_top, q_setup_bottom);

	me = QNetLocalIP();

	StrPrint(msg, "me %d.%d.%d.%d -> server %d.%d.%d.%d",
		me & 255, (me >> 8) & 255, (me >> 16) & 255, (me >> 24) & 255,
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	QConPrint(msg);
}

U0 QConConnect(U8 *args)
{//"connect <ip>" - parse, then hand off. accepts an optional :port suffix
	U32 ip = QConParseIPV4(args);

	if (!ip)
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	QConConnectIP(ip);
}

U0 QConSlist()
{//NET_Slist_f - start a scan and print the cache as it stands
 //
 //nothing here waits. the CCREPs land in the recv path over the next second,
 //so the first slist usually prints an empty list and the next one prints the
 //servers. that is why the searching line exists - without it an empty table
 //is indistinguishable from a broken scan
	U8	line[80];
	I64	i;

	if (!QNetUdpAvailable())
	{
		QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	//no autoip: 10.0.0.1 is the address a host takes, and handing it to a
	//scanning client collides with the very server it is looking for
	if (!QNetLocalIP())
	{
		QConPrint("set ip first: qip 10.0.0.2");
		return;
	}

	if (!QNetUdpOpen(QNET_PORT_DEFAULT))
	{
		QConPrint(q_udp_status);
		return;
	}

	//a listen host answers CCREQ instead of collecting CCREP, so it can only
	//ever find itself - say so rather than print an empty list forever
	if (q_udp_server)
	{
		QConPrint("hosting - slist is for clients");
		return;
	}

	if (!QNetSlistBroadcast)
		QConPrint("broadcast failed - no link?");
	else
		QConPrint("searching for lan servers...");

	if (!q_slist_count)
	{
		QConPrint("no servers yet - run slist again");
		return;
	}

	QConPrint("address        host    map     players");

	for (i = 0; i < q_slist_count; i++)
	{
		StrPrint(line, "%s %s %s %d/%d",
			q_slist[i].addr,
			q_slist[i].name,
			q_slist[i].map,
			q_slist[i].players,
			q_slist[i].max_players);
		QConPrint(line);
	}
}

U0 QCvarValueStr(U8 *out, F64 v)
{//cvars are strings in the original, so 1 prints back as 1, not 1.00
 //
 //NOT %g: the kernel's is not trustworthy for this, and a fractional cvar
 //printing as garbage reads as "the value did not take" when it did. three
 //decimals, trailing zeros trimmed
	I64 whole;
	I64 frac;
	U8	sign[2];
	U8	fbuf[8];
	I64 n;

	if (v == ToF64(ToI64(v)))
	{
		StrPrint(out, "%d", ToI64(v));
		return;
	}

	sign[0] = 0;
	sign[1] = 0;
	if (v < 0.0)
	{
		sign[0] = '-';
		v       = -v;
	}

	whole = ToI64(v);
	frac  = ToI64((v - ToF64(whole)) * 1000.0 + 0.5);

	if (frac >= 1000)
	{
		whole++;
		frac -= 1000;
	}

	StrPrint(fbuf, "%03d", frac);

	n = 3;
	while (n > 1 && fbuf[n - 1] == '0')
		n--;
	fbuf[n] = 0;

	StrPrint(out, "%s%d.%s", sign, whole, fbuf);
}

Bool QConCvarCommand(U8 *line, Bool echo = TRUE)
{//Cvar_Command. TRUE when the line named a cvar, set or reported
 //
 //echo FALSE for stuffcmd: Copper/qbj3 W_SetCrosshair stuffs crosshair every
 //PreThink. printing each set freezes the notify flood with "CROSSHAIR SET TO 0"
	U8	name[24];
	U8	out[64];
	U8	vbuf[32];
	I64	i = 0;
	I64	j;
	F64	old;
	F64	neu;

	while (line[i] && line[i] != ' ' && i < 23)
	{
		name[i] = line[i];
		i++;
	}
	name[i] = 0;

	//unknown names are rejected here, unlike QCvarSet which creates on demand -
	//a typo becoming a new cvar reports success for a setting nothing reads
	if (QCvarIndex(name) < 0)
		return FALSE;

	j = i;
	while (line[j] == ' ')
		j++;

	if (!line[j])
	{
		QCvarValueStr(vbuf, QCvarGet(name));
		StrPrint(out, "\"%s\" is \"%s\"", name, vbuf);
		QConPrint(out);
		return TRUE;
	}

	old = QCvarGet(name);
	neu = QAtoF(line + j);
	QCvarSet(name, neu);

	//gl_screen.c spells several settings scr_*; they are the SAME setting the
	//engine already owns, so the two names have to stay in step
	if (!StrICompare(name, "scr_viewsize"))
		QCvarSet("viewsize", neu);
	else if (!StrICompare(name, "viewsize"))
		QCvarSet("scr_viewsize", neu);
	else if (!StrICompare(name, "scr_fov"))
	{
		q_con_fov_want = neu;
		if (q_con_fov_want < 10.0)	q_con_fov_want = 10.0;
		if (q_con_fov_want > 170.0)	q_con_fov_want = 170.0;
	}
	else if (!StrICompare(name, "scr_showfps"))
		q_opt_fps = ToBool(neu != 0.0);
	else if (!StrICompare(name, "scr_fov_adapt"))
		q_opt_fov_adapt = ToBool(neu != 0.0);
	else if (!StrICompare(name, "d_mipscale"))
	{
		q_mipscale = neu;
		if (q_mipscale < 0.0)	q_mipscale = 0.0;
		if (q_mipscale > 8.0)	q_mipscale = 8.0;
		QSurfCacheFlush;		//every cached surface was built at a mip
	}
	else if (!StrICompare(name, "d_mipcap"))
	{
		q_mipcap = ClampI64(ToI64(neu), 0, 3);
		QSurfCacheFlush;
	}
	else if (!StrICompare(name, "r_softemu_mdl_warp"))
		q_mdl_warp = ToBool(neu != 0.0);
	else if (!StrICompare(name, "r_lerpmodels"))
		q_lerp_models = ToBool(neu != 0.0);
	else if (!StrICompare(name, "r_skywind"))
		q_skywind_en = ToBool(neu != 0.0);
	else if (!StrICompare(name, "r_progmips"))
		q_prog_mips = ToBool(neu != 0.0);
	else if (!StrICompare(name, "r_mipzoomhold"))
		q_mip_zoom_hold = ToBool(neu != 0.0);
	else if (!StrICompare(name, "r_zbias"))
	{
		q_mdl_zbias = neu;
		if (q_mdl_zbias < 1.0)		q_mdl_zbias = 1.0;
		if (q_mdl_zbias > 1.05)		q_mdl_zbias = 1.05;
	}
	else if (!StrICompare(name, "zoom_speed"))
		QCvarSet("scr_zoomspeed", neu);
	else if (!StrICompare(name, "scr_zoomspeed"))
		QCvarSet("zoom_speed", neu);

	//cvars the ENGINE also reads through an option variable. without the
	//write-back a mod's "crosshair -1" hid nothing and both crosshairs drew
	if (!StrICompare(name, "crosshair"))
		q_opt_crosshair = ToI64(neu);
	else if (!StrICompare(name, "hudstyle"))
		q_opt_hudstyle = ClampI64(ToI64(neu), 0, QHUD_STYLES - 1);
	else if (!StrICompare(name, "scr_sbarscale"))
		q_opt_hudscale = ClampI64(ToI64(neu), 0, 8);
	else if (!StrICompare(name, "scr_sbaralpha"))
		q_opt_sbaralpha = ClampI64(ToI64(neu * 255.0), 0, 255);
	else if (!StrICompare(name, "sensitivity"))
	{
		//id units: "sensitivity 3" is the stock value. q_opt_sensitivity is
		//degrees of view per mouse count, and 3 maps to the 0.12 default
		q_opt_sensitivity = neu * 0.04;
		if (q_opt_sensitivity < 0.02)	q_opt_sensitivity = 0.02;
		if (q_opt_sensitivity > 0.60)	q_opt_sensitivity = 0.60;
	}
	else if (!StrICompare(name, "volume"))
	{
		//q_snd_master is the value the mixer actually reads; setting only the
		//option left the cvar and the audible level disagreeing
		q_opt_volume = ClampI64(ToI64(neu * 100.0), 0, 100);
		q_snd_master = ToF64(q_opt_volume) / 100.0;
	}
	else if (!StrICompare(name, "contrast"))
		QPalSetContrast(neu);
	else if (!StrICompare(name, "gamma"))
	{
		//the cvar and the option are one setting. registered but unmirrored,
		//"gamma 0.95" from a config set a number nothing read
		q_opt_gamma = neu;
		if (q_opt_gamma < QGAMMA_MIN)	q_opt_gamma = QGAMMA_MIN;
		if (q_opt_gamma > QGAMMA_MAX)	q_opt_gamma = QGAMMA_MAX;
		QPalSetGamma(q_opt_gamma);
	}

	//typed sets only, and only when the value actually changed
	if (echo && old != neu)
	{
		QCvarValueStr(vbuf, QCvarGet(name));
		StrPrint(out, "%s set to %s", name, vbuf);
		QConPrint(out);
	}

	return TRUE;
}

U0 QConCvar(U8 *args)
{//Cvar_Command: "name value" sets, bare "name" reports
	U8	 name[24];
	U8	 line[64];
	U8	 vbuf[32];
	I64	 i = 0;
	I64	 j;

	while (args[i] && args[i] != ' ' && i < 23)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
		return;

	j = i;
	while (args[j] == ' ')
		j++;

	if (!args[j])
	{
		QCvarValueStr(vbuf, QCvarGet(name));
		StrPrint(line, "\"%s\" is \"%s\"", name, vbuf);
		QConPrint(line);
		return;
	}

	QCvarSet(name, QAtoF(args + j));
	QCvarValueStr(vbuf, QCvarGet(name));
	StrPrint(line, "%s set to %s", name, vbuf);
	QConPrint(line);
}

Bool QConCheatAllowed()
{//Host_God_f / Host_Noclip_f / Host_Fly_f / Host_Give_f all open with
 //
 //    if (pr_global_struct->deathmatch && !host_client->privileged)
 //        return;
 //
 //so the engine cheats are refused outright in deathmatch. nothing gated them
 //here, which left god and give available to anyone on a dm server.
 //
 //NOTE: sv_cheats is not an NQ cvar - deathmatch is the whole rule there. it is
 //honoured as an extra lock so cheats can be shut off in a coop or solo game too
	if (QCvarGet("deathmatch") != 0.0)
	{
		QConPrint("no cheats in deathmatch");
		return FALSE;
	}

	if (QCvarGet("sv_cheats") == 0.0)
	{
		QConPrint("cheats are disabled");
		return FALSE;
	}

	return TRUE;
}

U0 QConCheatFlag(I64 bit, U8 *name)
{//Host_God_f's shape: XOR a flag bit and report the new state
	U8	msg[64];
	I64	flags;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags = flags ^ bit;
	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	if (flags & bit)
		StrPrint(msg, "%s ON", name);
	else
		StrPrint(msg, "%s OFF", name);

	QConPrint(msg);
}

U0 QConRunPlayerFunc(U8 *name)
{//call a QuakeC function with self = the player, as the host commands do
	I64 fn = QPrFindFunction(name);

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	if (fn <= 0)
	{
		QConPrint("no such QuakeC function");
		return;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;
}

//Host_Impulse_f sets cl.impulse for the NEXT move message, it does not poke
//the edict - the input block overwrites .impulse every tick. queued for that
//block to deliver, survives exactly one tick
I64 q_con_impulse_want = 0;

U0 QConImpulse(I64 n)
{//Host_Impulse_f
	U8 msg[48];

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	q_con_impulse_want = n;
	StrPrint(msg, "impulse %d", n);
	QConPrint(msg);
}

U0 QConGive(U8 *args)
{//Host_Give_f. first character selects what, the number is the amount, a
 //digit sets the matching weapon's .items bit
	U8	msg[64];
	I64	v = 0;
	I64	i = 0;
	I64	items;
	U8	what;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	what = args[0];

	//skip to the number, if any
	while (args[i] && args[i] != ' ')
		i++;
	while (args[i] == ' ')
		i++;
	if (args[i])
		v = Str2I64(args + i);

	if ('2' <= what <= '8')
	{
		//IT_SHOTGUN << (n - 2), the original's expression. IT_SHOTGUN is 1
		items = ToI64(QPrFieldF(q_player_edict, q_fld_items));
		items = items | (1 << (what - '2'));
		QPrSetFieldF(q_player_edict, q_fld_items, ToF64(items));
		StrPrint(msg, "gave weapon %c", what);
	}
	else if (what == 's' && q_fld_ammo_shells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_shells, ToF64(v));
		StrPrint(msg, "shells %d", v);
	}
	else if (what == 'n' && q_fld_ammo_nails >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_nails, ToF64(v));
		StrPrint(msg, "nails %d", v);
	}
	else if (what == 'r' && q_fld_ammo_rockets >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_rockets, ToF64(v));
		StrPrint(msg, "rockets %d", v);
	}
	else if (what == 'c' && q_fld_ammo_cells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_cells, ToF64(v));
		StrPrint(msg, "cells %d", v);
	}
	else if (what == 'h')
	{
		QPrSetFieldF(q_player_edict, q_fld_health, ToF64(v));
		StrPrint(msg, "health %d", v);
	}
	else
		StrPrint(msg, "give: s n r c h or 2-8");

	QConPrint(msg);
}

U0 QConStatus()
{//Host_Status_f, cut to what this build can report
	U8 msg[96];

	StrPrint(msg, "map %s", q_map_name);
	QConPrint(msg);

	StrPrint(msg, "edicts %d  time %4.1f", q_pr_num_edicts, q_game_time);
	QConPrint(msg);

	if (q_player_active)
	{
		StrPrint(msg, "health %d  armor %d  ammo %d",
			ToI64(QPlayerHealth), ToI64(QPlayerArmor), ToI64(QPlayerAmmo));
		QConPrint(msg);
	}
}

//--- Cmd_ token walk --------------------------------------------------------

I64 QConToken(U8 *out, U8 *src, I64 i, I64 max)
{//one space-delimited word into out, returns the index just past it
	I64 n = 0;

	while (src[i] == ' ' || src[i] == '\t')
		i++;

	while (src[i] && src[i] != ' ' && src[i] != '\t' && n < max - 1)
	{
		out[n] = src[i];
		n++;
		i++;
	}
	out[n] = 0;

	//an over-long word must not leave the rest of it as the next token
	while (src[i] && src[i] != ' ' && src[i] != '\t')
		i++;

	return i;
}

I64 QConSkipSpace(U8 *src, I64 i)
{
	while (src[i] == ' ' || src[i] == '\t')
		i++;
	return i;
}

U0 QConUnquote(U8 *s)
{//strip one layer of surrounding double quotes, in place
 //
 //QConToken splits on whitespace and keeps the quotes, so default.cfg's
 //bind w "+forward" hands back "+forward" with them still attached and no
 //action lookup can match it
	I64 n = StrLen(s);
	I64 i;

	if (n < 2 || s[0] != '"')
		return;

	if (s[n - 1] != '"')
		return;

	for (i = 0; i < n - 2; i++)
		s[i] = s[i + 1];

	s[n - 2] = 0;
}

U0 QCmdBindList()
{//Key_WriteBindings' shape, to the console instead of a file
	U8	msg[80];
	U8	keyname[24];
	I64	i;

	for (i = 0; i < QKB_KEYS; i++)
	{
		if (!q_keybind[i * QKB_CMD_MAX])
			goto qbl_next;

		QBindKeyName(keyname, i);
		StrPrint(msg, "\"%s\" = \"%s\"", keyname, &q_keybind[i * QKB_CMD_MAX]);
		QConPrint(msg);

qbl_next:
	}
}

U0 QCmdBind(U8 *args)
{//Key_Bind_f. no args lists, key alone reports, key+action binds
	U8	key[24];
	U8	act[32];
	U8	keyname[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	I64	slot;

	i = QConSkipSpace(args, 0);
	if (!args[i])
	{
		QCmdBindList;
		return;
	}

	i = QConToken(key, args, i, 24);
	QConUnquote(key);
	sc = QBindKeyParse(key);
	if (sc <= 0)
	{
		StrPrint(msg, "\"%s\" isn't a valid key", key);
		QConPrint(msg);
		return;
	}

	i = QConSkipSpace(args, i);
	if (!args[i])
	{
		for (slot = 0; slot < QBIND_COUNT; slot++)
		{
			if (q_bind_key[slot] == sc)
			{
				StrPrint(msg, "\"%s\" = \"%s\"", key, q_bind_cmd[slot]);
				QConPrint(msg);
				return;
			}
		}

		if (q_keybind[sc * QKB_CMD_MAX])
		{
			StrPrint(msg, "\"%s\" = \"%s\"", key,
				&q_keybind[sc * QKB_CMD_MAX]);
			QConPrint(msg);
			return;
		}

		StrPrint(msg, "\"%s\" is not bound", key);
		QConPrint(msg);
		return;
	}

	QConToken(act, args, i, 32);
	QConUnquote(act);
	slot = QBindFindAction(act);

	//anything that is not one of the five polled actions is stored verbatim
	//and run on keydown - "impulse 13", "say hi", a chain with ;
	if (slot < 0)
	{
		//the whole remainder is the command, quotes and all - "impulse 13"
		//is one command with a space in it, not a token
		QStrCopy(&q_keybind[sc * QKB_CMD_MAX], args + i, QKB_CMD_MAX);
		QConUnquote(&q_keybind[sc * QKB_CMD_MAX]);

		//a key drives one thing: taking it for a command frees the action
		for (i = 0; i < QBIND_COUNT; i++)
		{
			if (q_bind_key[i] == sc)
				q_bind_key[i] = 0;
		}

		QCfgSave;
		QBindKeyName(keyname, sc);
		StrPrint(msg, "bound %s to \"%s\"", keyname,
			&q_keybind[sc * QKB_CMD_MAX]);
		QConPrint(msg);
		return;
	}

	//and the reverse: an action reclaims a key a command was holding
	q_keybind[sc * QKB_CMD_MAX] = 0;

	//one key drives one action, as the customize page enforces
	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (i != slot && q_bind_key[i] == sc)
			q_bind_key[i] = 0;
	}

	q_bind_key[slot] = sc;
	QCfgSave;

	QBindKeyName(keyname, sc);
	StrPrint(msg, "bound %s to %s", keyname, q_bind_cmd[slot]);
	QConPrint(msg);
}

U0 QCmdUnbind(U8 *args)
{//Key_Unbind_f
	U8	key[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	Bool hit = FALSE;

	QConToken(key, args, 0, 24);
	QConUnquote(key);
	sc = QBindKeyParse(key);
	if (sc <= 0)
	{
		QConPrint("unbind <key>");
		return;
	}

	if (q_keybind[sc * QKB_CMD_MAX])
	{
		q_keybind[sc * QKB_CMD_MAX] = 0;
		hit = TRUE;
	}

	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (q_bind_key[i] == sc)
		{
			q_bind_key[i] = 0;
			hit = TRUE;
		}
	}

	if (!hit)
	{
		StrPrint(msg, "\"%s\" is not bound", key);
		QConPrint(msg);
		return;
	}

	QCfgSave;
	StrPrint(msg, "unbound %s", key);
	QConPrint(msg);
}

U0 QCmdUnbindAll()
{//Key_Unbindall_f. the config keeps its bind lines, they just read 0
	I64 i;

	for (i = 0; i < QBIND_COUNT; i++)
		q_bind_key[i] = 0;

	for (i = 0; i < QKB_KEYS; i++)
		q_keybind[i * QKB_CMD_MAX] = 0;

	QCfgSave;
	QConPrint("all keys unbound");
}

U0 QCmdCvarList()
{//Cvar_List_f
	U8	msg[80];
	U8	vbuf[32];
	I64	i;

	for (i = 0; i < q_cvar_count; i++)
	{
		QCvarValueStr(vbuf, q_cvars[i].value);
		StrPrint(msg, "%s \"%s\"", q_cvars[i].name, vbuf);
		QConPrint(msg);
	}

	StrPrint(msg, "%d cvars", q_cvar_count);
	QConPrint(msg);
}

U0 QCmdAliasList()
{
	U8	msg[80];
	I64	i;

	if (!q_alias_count)
	{
		QConPrint("no alias commands");
		return;
	}

	for (i = 0; i < q_alias_count; i++)
	{
		StrPrint(msg, "%s : %s", q_alias_name + i * QALIAS_NAME,
			q_alias_text + i * QALIAS_TEXT);
		QConPrint(msg);
	}
}

U0 QCmdAlias(U8 *args)
{//Cmd_Alias_f. no args lists, name alone is a redefine to nothing useful so
 //it lists that one instead
	U8	name[QALIAS_NAME];
	U8	msg[80];
	I64	i;
	I64	slot;

	i = QConSkipSpace(args, 0);
	if (!args[i])
	{
		QCmdAliasList;
		return;
	}

	i = QConToken(name, args, i, QALIAS_NAME);
	i = QConSkipSpace(args, i);

	slot = QAliasFind(name);

	if (!args[i])
	{
		if (slot < 0)
			StrPrint(msg, "no alias named %s", name);
		else
			StrPrint(msg, "%s : %s", name, q_alias_text + slot * QALIAS_TEXT);
		QConPrint(msg);
		return;
	}

	if (slot < 0)
	{
		if (q_alias_count >= QALIAS_MAX)
		{
			QConPrint("alias table full");
			return;
		}
		slot = q_alias_count;
		q_alias_count++;
	}

	QStrCopy(q_alias_name + slot * QALIAS_NAME, name, QALIAS_NAME);
	QStrCopy(q_alias_text + slot * QALIAS_TEXT, args + i, QALIAS_TEXT);

	//Cmd_Alias_f builds the text from Cmd_Argv, which is already TOKENIZED -
	//the quotes are gone by then. storing the raw remainder kept them, so
	//    alias gohome "changelevel start"
	//expanded to a line beginning with a quote and matched no command
	QConUnquote(q_alias_text + slot * QALIAS_TEXT);

	StrPrint(msg, "%s : %s", q_alias_name + slot * QALIAS_NAME,
		q_alias_text + slot * QALIAS_TEXT);
	QConPrint(msg);
}

U0 QCmdUnalias(U8 *args)
{//not in id, but unbind has no counterpart here without it
	U8	name[QALIAS_NAME];
	U8	msg[80];
	I64	slot;
	I64	i;

	QConToken(name, args, 0, QALIAS_NAME);
	if (!name[0])
	{
		QConPrint("unalias <name>");
		return;
	}

	slot = QAliasFind(name);
	if (slot < 0)
	{
		StrPrint(msg, "no alias named %s", name);
		QConPrint(msg);
		return;
	}

	//swap the tail down, the table has no ordering to keep
	for (i = slot; i < q_alias_count - 1; i++)
	{
		QStrCopy(q_alias_name + i * QALIAS_NAME,
			q_alias_name + (i + 1) * QALIAS_NAME, QALIAS_NAME);
		QStrCopy(q_alias_text + i * QALIAS_TEXT,
			q_alias_text + (i + 1) * QALIAS_TEXT, QALIAS_TEXT);
	}

	q_alias_count--;
	q_alias_name[q_alias_count * QALIAS_NAME] = 0;
	q_alias_text[q_alias_count * QALIAS_TEXT] = 0;

	StrPrint(msg, "removed alias %s", name);
	QConPrint(msg);
}

Bool q_con_want_bf = FALSE;

U0 QConExec(U8 *line, Bool echo = TRUE)
{//unknown input is echoed, not swallowed, so a typo looks like a typo
 //
 //echo: the "]line" receipt belongs to what the user typed. Cbuf_AddText
 //prints nothing, so a stuffcmd must not either - QuakeC sends bf on every
 //pickup
	U8  msg[80];
	U8 *role;
	U8 *arg;
	U32 myip;
	I64 si;
	I64 e;
	CQNetSock *sock;

	//Host_Color_f scratch
	U8 *p;
	I64 ctop;
	I64 cbot;

	//exec / alias scratch. one line at a time, so nothing here outlives the
	//call that filled it
	U8  *raw;
	Bool embedded = FALSE;
	U8   fline[128];
	U8   acmd[QALIAS_TEXT];
	U8   aname[QALIAS_NAME];
	U8   norm[256];
	F64  sizev;			//sizeup / sizedown
	I64  fsize;
	I64  fi;
	I64  fn;
	I64  ai;
	I64  an;
	I64  aslot;

	if (!line[0])
		return;

	//TABS. a mod's default.cfg separates "bind\tALT\t+strafe" with tabs and
	//every dispatch below matches on a SPACE - the whole file fell through to
	//"unknown command". leading whitespace goes with them
	si = 0;
	while (line[si] == ' ' || line[si] == '\t')
		si++;
	e = 0;
	while (line[si] && e < 254)
	{
		if (line[si] == '\t')
			norm[e] = ' ';
		else
			norm[e] = line[si];
		e++;
		si++;
	}
	norm[e] = 0;
	line = norm;

	if (!line[0])
		return;

	//SEMICOLONS. Cbuf_Execute splits the text on ; outside quotes and runs
	//each piece as its own command, which is what makes "unbindall; exec
	//default.cfg" one line. only stuffcmd text was ever split before, so a
	//typed chain ran as a single unknown command
	e = 0;
	fn = 0;
	while (norm[e])
	{
		if (norm[e] == '"')
			fn = !fn;
		else if (norm[e] == ';' && !fn)
			break;
		e++;
	}

	if (norm[e] == ';')
	{
		//split in place: the tail is copied out first, the head truncated
		QStrCopy(fline, norm + e + 1, 128);
		norm[e] = 0;

		si = 0;
		while (norm[si] == ' ')
			si++;
		if (norm[si])
			QConExec(norm + si, echo);

		si = 0;
		while (fline[si] == ' ')
			si++;
		if (fline[si])
			QConExec(fline + si, echo);

		return;
	}

	if (echo)
	{
		StrPrint(msg, "]%s", line);
		QConPrint(msg);
	}

	//+commands are level triggered: the state lives in q_btn and the movement
	//code ORs it with its own scancode polls
	if (line[0] == '+' || line[0] == '-')
	{
		if (!StrNICompare(line + 1, "showscores", 10))
		{
			q_scoreboard_show = ToBool(line[0] == '+');
			return;
		}

		//SCR_ZoomDown_f / SCR_ZoomUp_f set only the DIRECTION
		if (!StrNICompare(line + 1, "zoom", 4))
		{
			q_zoom_on = ToBool(line[0] == '+');
			if (q_zoom_on)
				q_zoom_dir = 1.0;
			else
				q_zoom_dir = -1.0;
			return;
		}

		//a +command TYPED or stuffed has no key behind it, so it latches here.
		//key-driven ones are rebuilt from the bind table every frame by
		//QKeyBindFrame and must not latch, or releasing one of two keys
		//bound to the same action would stop the action
		si = QBtnIndex(line + 1);
		if (si >= 0)
		{
			q_btn_con[si] = ToBool(line[0] == '+');
			q_btn[si]     = q_btn_con[si];
		}

		//+altmodifier, +gyroaction and friends have no meaning here, but they
		//must not read as unknown - a config binds them and the notify floods
		return;
	}

	//--- level control ---
	//heap sweep, off by default - it walks every live allocation. needs the
	//kernel built with _CONFIG_HEAP_DEBUG to catch overruns into live blocks
	//names the texture and draw path at the crosshair. the pixel is sampled
	//on the NEXT frame, so the report lands one frame later
	//mods set fog with stuffcmd, and stuffed text is executed HERE - the
	//localcmd path alone never saw it
	if (!StrNICompare(line, "fog", 3) && (!line[3] || line[3] == ' '))
	{
		//"fog" alone REPORTS, as Fog_FogCommand_f does. clearing on a bare
		//fog threw away what worldspawn set with nothing able to name it
		//again - and "fog 1" is density 1.0, roughly 30x what a map asks for
		if (!StrNICompare(line + 3, " reset", 6))
		{
			if (q_fog_map_density > 0.0)
				QFogSet(q_fog_map_density, q_fog_map_r, q_fog_map_g,
					q_fog_map_b);
			else
				QFogClear;
		}
		else if (line[3] == ' ')
			QFogCommand(line + 4);

		StrPrint(msg, "fog %d.%03d %d %d %d (map %d.%03d)",
			ToI64(q_fog_density),
			ToI64(q_fog_density * 1000.0) % 1000,
			q_fog_r, q_fog_g, q_fog_b,
			ToI64(q_fog_map_density),
			ToI64(q_fog_map_density * 1000.0) % 1000);
		QConPrint(msg);

		//the numbers that decide what is actually ON SCREEN: the sky blend,
		//whether the option is even on, and the blend the table hands back at
		//a few distances. a colour that reads right in this line but wrong in
		//the world has to differ in one of these
		//ToI64 on a Bool does not widen cleanly through varargs here - it
		//printed raw stack. compare instead
		si = 0;
		if (q_opt_fog)	si = 1;
		e = 0;
		if (q_fog_on)	e = 1;

		StrPrint(msg, "  sky %d/255  enabled %d  fogon %d",
			q_fog_sky_alpha, si, e);
		QConPrint(msg);

		StrPrint(msg, "  alpha @500 %d  @1000 %d  @2000 %d  @4000 %d",
			QFogAlphaFor(500.0), QFogAlphaFor(1000.0),
			QFogAlphaFor(2000.0), QFogAlphaFor(4000.0));
		QConPrint(msg);
		return;
	}

	//render pass switches. deliberately not saved - they answer "which draw
	//path put that on screen", they are not a preference
	if (!StrNICompare(line, "r_drawentities", 14) &&
		(!line[14] || line[14] == ' '))
	{
		if (line[14] == ' ')
			q_opt_drawents = ToBool(QCfgValue(line) != 0);
		else
			q_opt_drawents = !q_opt_drawents;

		if (q_opt_drawents)
			QConPrint("r_drawentities 1");
		else
			QConPrint("r_drawentities 0");
		return;
	}

	//a mod stuffcmds these to pick its own HUD. the cvar Ironwail registers is
	//"hudstyle"; scr_hudstyle is its C symbol and configs in the wild use both
	if ((!StrNICompare(line, "scr_hudstyle", 12) &&
		 (!line[12] || line[12] == ' ')) ||
		(!StrNICompare(line, "hudstyle", 8) &&
		 (!line[8] || line[8] == ' ')))
	{
		if (line[0] == 'h' || line[0] == 'H')
			arg = line + 8;
		else
			arg = line + 12;

		if (*arg == ' ')
			q_opt_hudstyle = ClampI64(QCfgValue(line), 0, QHUD_STYLES - 1);
		else
		{
			q_opt_hudstyle++;
			if (q_opt_hudstyle >= QHUD_STYLES)
				q_opt_hudstyle = 0;
		}

		//the mod polls cvar("hudstyle") and RE-SETS it on mismatch - stuffcmd
		//"hudstyle 2" landing only in q_opt_hudstyle looped that check every
		//frame, style blip and relayout included
		QCvarSet("hudstyle", ToF64(q_opt_hudstyle));

		StrPrint(msg, "hudstyle %d", q_opt_hudstyle);
		QConPrint(msg);
		QCfgSave;
		return;
	}

	//r_skyfog: fraction of the fog colour applied to sky, 0..1. same quantity
	//q_fog_sky_alpha holds in 0..255, so worldspawn's _skyfog and this cvar
	//are the same setting reached two ways
	//"qcwatch <ent> <field>": log every pointer store into that cell, with
	//the writing QC function. "qcwatch off" clears
	if (!StrNICompare(line, "qcwatch ", 8))
	{
		if (!StrICompare(line + 8, "off"))
		{
			QPrWatchSet(-1, "");
			QConPrint("watch off");
			return;
		}

		arg = line + 8;
		si  = ToI64(QAtoF(arg));
		while (*arg && *arg != ' ')
			arg++;
		while (*arg == ' ')
			arg++;

		if (*arg)
		{
			QPrWatchSet(si, arg);
			QConPrint("watching - survives map loads, qcwatch off to stop");
		}
		else
			QConPrint("usage: qcwatch <ent> <field>");
		return;
	}

	//--- engine commands a config or a bind expects ---
	//
	//the remaining Cmd_AddCommand names from the reference tree. some do real
	//work, some report, and the dev-only ones are ACCEPTED SILENTLY - a config
	//binds them and an unknown-command notify on every press is worse than a
	//no-op
	if (!StrICompare(line, "togglemenu"))
	{
		q_con_want_menu = TRUE;
		return;
	}

	//M_Menu_*_f. the page is REQUESTED, not set: the shell's toggle rewrites
	//q_menu_page to QPAGE_MAIN when it raises the menu, so writing the page
	//here was overwritten a moment later and every menu_* opened the main menu
	if (!StrNICompare(line, "menu_", 5))
	{
		if (!StrICompare(line + 5, "load"))
			q_con_want_page = QPAGE_SINGLE;
		else if (!StrICompare(line + 5, "save"))
			q_con_want_page = QPAGE_SINGLE;
		else if (!StrICompare(line + 5, "options"))
			q_con_want_page = QPAGE_OPTIONS;
		else if (!StrICompare(line + 5, "keys"))
			q_con_want_page = QPAGE_KEYS;
		else if (!StrICompare(line + 5, "multiplayer"))
			q_con_want_page = QPAGE_MULTI;
		else if (!StrICompare(line + 5, "setup"))
			q_con_want_page = QPAGE_SETUP;
		else if (!StrICompare(line + 5, "help"))
			q_con_want_page = QPAGE_HELP;
		else if (!StrICompare(line + 5, "single"))
			q_con_want_page = QPAGE_SINGLE;
		else
			q_con_want_page = QPAGE_MAIN;

		q_con_want_menu = TRUE;
		return;
	}

	//live mixer state. a drop and an attenuated-to-silence sound are both
	//"nothing played", and they have different causes
	//touchtrace: one line per trigger touch, to the log. a trigger that never
	//fires and a trigger that fires and does nothing look the same on screen
	if (!StrNICompare(line, "touchtrace", 10))
	{
		if (line[10] == ' ')
			q_touch_trace = ToBool(QCfgValue(line) != 0);
		else
			q_touch_trace = !q_touch_trace;

		if (q_touch_trace)
			QConPrint("touchtrace 1 - see QUAKELOG.TXT");
		else
			QConPrint("touchtrace 0");
		return;
	}

	//one burst of traceline results. "tracetrace 40" then fire once
	if (!StrNICompare(line, "tracetrace", 10))
	{
		if (line[10] == ' ')
			q_trace_log = ClampI64(ToI64(QCfgValue(line)), 0, 4000);
		else
			q_trace_log = 40;

		StrPrint(msg, "logging %d traces to QUAKELOG.TXT", q_trace_log);
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "sndstat"))
	{
		si = 0;
		for (e = 0; e < QSND_DYNAMIC_CHANNELS; e++)
			if (AudioSFXPlaying(q_snd_chan[e].voice))
				si++;

		StrPrint(msg, "%d/%d channels live", si, QSND_DYNAMIC_CHANNELS);
		QConPrint(msg);

		//the MIXER census, not the channel table. a voice the engine has
		//stopped tracking still occupies a slot, and a LOOPING one never
		//frees itself - that is what exhaustion looks like from here
		si = 0;
		e  = 0;
		for (ctop = 0; ctop < AUDIO_MAX_SFX_VOICES; ctop++)
		{
			if (!audio.voice[ctop].active)
				goto qss_next;

			si++;
			if (audio.voice[ctop].loop)
				e++;

qss_next:
		}

		StrPrint(msg, "mixer: %d/%d voices, %d looping",
			si, AUDIO_MAX_SFX_VOICES, e);
		QConPrint(msg);

		//every voice the engine still has a handle for. the difference
		//between this and the mixer count is the leak
		si = 0;
		for (e = 0; e < QNUM_AMBIENTS; e++)
			if (q_ambient_voice[e] >= 0)
				si++;
		if (q_music_voice >= 0)
			si++;

		StrPrint(msg, "tracked: %d leaf ambient + music", si);
		QConPrint(msg);

		//the cache is the resource that actually runs out on a big mod
		StrPrint(msg, "cache: %d/%d entries, %d/%d KB, %d evicted",
			q_snd_used, QSND_MAX_CACHE, q_snd_bytes / 1024,
			QSND_CACHE_BUDGET / 1024, q_snd_evicted);
		QConPrint(msg);

		StrPrint(msg, "%d played, %d dropped, %d silent",
			q_snd_played, q_snd_dropped, q_snd_silent);
		QConPrint(msg);
		return;
	}

	//S_Restart. stops every voice the mixer holds, tracked or not, and
	//rebuilds the channel tables. a leak is recoverable without a reboot,
	//and whether it recovers says where the leak is
	if (!StrICompare(line, "snd_restart"))
	{
		AudioSFXStopAll;
		QSndStopAll;

		for (e = 0; e < QNUM_AMBIENTS; e++)
			q_ambient_voice[e] = -1;

		q_snd_dropped = 0;
		q_snd_silent  = 0;
		QConPrint("sound restarted");
		return;
	}

	if (!StrICompare(line, "edictcount"))
	{
		StrPrint(msg, "%d edicts", q_pr_num_edicts);
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "mapname"))
	{
		QConPrint(q_map_name);
		return;
	}

	//server, demo and input commands with no counterpart here
	if (!StrICompare(line, "ban")		|| !StrICompare(line, "kick") ||
		!StrICompare(line, "listen")	|| !StrICompare(line, "maxplayers") ||
		!StrICompare(line, "port")		|| !StrICompare(line, "ping") ||
		!StrICompare(line, "reconnect")	|| !StrICompare(line, "record") ||
		!StrICompare(line, "timedemo")	|| !StrICompare(line, "playvol") ||
		!StrICompare(line, "setpos")	|| !StrICompare(line, "entities") ||
		!StrICompare(line, "cycle")		|| !StrICompare(line, "cycleback") ||
		!StrICompare(line, "inc")		|| !StrICompare(line, "sts") ||
		!StrICompare(line, "pause")		|| !StrICompare(line, "v_water"))
		return;

	if (!StrICompare(line, "stopsound"))
	{
		QSndStopAll;
		return;
	}

	if (!StrICompare(line, "clear"))
	{
		MemSet(q_con_text, 0, QCON_LINES * QCON_WIDTH);
		q_con_line = 0;
		return;
	}

	if (!StrICompare(line, "unaliasall"))
	{
		q_alias_count = 0;
		QConPrint("aliases cleared");
		return;
	}

	if (!StrICompare(line, "writeconfig"))
	{
		QCfgSave;
		QConPrint("config written");
		return;
	}

	//viewpos needs the shell's view globals, which compile after this file
	if (!StrICompare(line, "viewpos"))
	{
		q_con_want_viewpos = TRUE;
		return;
	}

	//dev, host and video commands with no counterpart here. swallowed rather
	//than reported: every one of these appears in a stock config
	if (!StrICompare(line, "screenshot")	|| !StrICompare(line, "scr_autoscale") ||
		!StrICompare(line, "vid_restart")	|| !StrICompare(line, "vid_test") ||
		!StrICompare(line, "vid_unlock")	|| !StrICompare(line, "vid_describemodes") ||
		!StrICompare(line, "vid_describecurrentmode") ||
		!StrICompare(line, "gl_info")		|| !StrICompare(line, "gl_describetexturemodes") ||
		!StrICompare(line, "imagelist")		|| !StrICompare(line, "imagedump") ||
		!StrICompare(line, "hunk_print")	|| !StrICompare(line, "mcache") ||
		!StrICompare(line, "soundlist")		|| !StrICompare(line, "soundinfo") ||
		!StrICompare(line, "net_stats")		|| !StrICompare(line, "path") ||
		!StrICompare(line, "flush")			|| !StrICompare(line, "pointfile") ||
		!StrICompare(line, "timerefresh")	|| !StrICompare(line, "tracepos") ||
		!StrICompare(line, "viewframe")		|| !StrICompare(line, "viewnext") ||
		!StrICompare(line, "viewprev")		|| !StrICompare(line, "viewmodel") ||
		!StrICompare(line, "test")			|| !StrICompare(line, "test2") ||
		!StrICompare(line, "resetall")		|| !StrICompare(line, "resetcfg") ||
		!StrICompare(line, "stuffcmds")		|| !StrICompare(line, "startdemos") ||
		!StrICompare(line, "cmdlist")		|| !StrICompare(line, "bindlist") ||
		!StrICompare(line, "condump")		|| !StrICompare(line, "apropos") ||
		!StrICompare(line, "mods")			|| !StrICompare(line, "games") ||
		!StrICompare(line, "skies")			|| !StrICompare(line, "randmap") ||
		!StrICompare(line, "__cfgmarker")	|| !StrNICompare(line, "menu_", 5) ||
		!StrNICompare(line, "skywind", 7)	|| !StrNICompare(line, "music_", 6) ||
		!StrNICompare(line, "r_showbboxes_filter", 19))
		return;


	//
	//SCR_SizeUp_f / SCR_SizeDown_f: viewsize by 10, clamped 30..130 as the
	//original does. the "-" and "=" keys already do this directly, but a
	//config binds the COMMANDS
	if (!StrICompare(line, "sizeup") || !StrICompare(line, "sizedown"))
	{
		sizev = QCvarGet("viewsize");
		if (line[4] == 'u' || line[4] == 'U')
			sizev += 10.0;
		else
			sizev -= 10.0;

		if (sizev < 30.0)	sizev = 30.0;
		if (sizev > 130.0)	sizev = 130.0;

		QCvarSet("viewsize", sizev);
		QCvarSet("scr_viewsize", sizev);
		q_res_dirty = TRUE;
		return;
	}

	//SCR_ToggleZoom_f / SCR_ZoomDown_f / SCR_ZoomUp_f. scr_zoomfov is the
	//target, and the fov the frame loop applies
	//SCR_ToggleZoom_f reverses a ramp in flight rather than restarting it:
	//    if (cl.zoomdir) cl.zoomdir = -cl.zoomdir;
	//    else cl.zoomdir = cl.zoom > 0.5f ? -1.f : 1.f;
	if (!StrICompare(line, "togglezoom"))
	{
		if (q_zoom_dir != 0.0)
			q_zoom_dir = -q_zoom_dir;
		else if (q_zoom > 0.5)
			q_zoom_dir = -1.0;
		else
			q_zoom_dir = 1.0;

		q_zoom_on = ToBool(q_zoom_dir > 0.0);
		return;
	}

	if (!StrICompare(line, "+zoom"))
	{
		q_zoom_on  = TRUE;
		q_zoom_dir = 1.0;
		return;
	}

	if (!StrICompare(line, "-zoom"))
	{
		q_zoom_on  = FALSE;
		q_zoom_dir = -1.0;
		return;
	}

	if (!StrICompare(line, "zoom_in"))
	{
		q_zoom_on  = TRUE;
		q_zoom_dir = 1.0;
		return;
	}

	if (!StrICompare(line, "zoom_out"))
	{
		q_zoom_on  = FALSE;
		q_zoom_dir = -1.0;
		return;
	}


	//
	//Con_ToggleConsole_f and friends. a default.cfg binds these by name, and
	//an unknown one is a key that silently does nothing
	if (!StrICompare(line, "toggleconsole"))
	{
		q_con_want_toggle = TRUE;
		return;
	}

	//deferred: QMsgModeBegin is declared further down this file
	if (!StrICompare(line, "messagemode"))
	{
		q_con_want_msg = 1;
		return;
	}

	if (!StrICompare(line, "messagemode2"))
	{
		q_con_want_msg = 2;
		return;
	}

	//V_StartPitchDrift's target: the view returns to level
	if (!StrICompare(line, "centerview"))
	{
		q_con_want_center = TRUE;
		return;
	}

	//edict inspection: the door and item chains cannot be diagnosed from
	//symptoms, only read
	//bare "edict": whatever brush entity is under the crosshair, resolved by
	//the debugtex probe. -1 there is the world
	if (!StrICompare(line, "edict"))
	{
		if (q_probe_ent > 0)
			QPrEdictDump(q_probe_ent);
		else
			QConPrint("crosshair is on the world - aim at the door first");
		return;
	}

	if (!StrNICompare(line, "edict ", 6))
	{
		//a name is a find, not edict 0 - QAtoF reads text as zero and the
		//dump of worldspawn it produced read as an answer
		if (line[6] >= '0' && line[6] <= '9')
			QPrEdictDump(ToI64(QAtoF(line + 6)));
		else
			QPrEdictFind(line + 6);
		return;
	}

	if (!StrNICompare(line, "edicts ", 7))
	{
		QPrEdictFind(line + 7);
		return;
	}

	//PR_Profile_f. counts are exclusive of callees and are zeroed by the
	//report, so two runs in a row measure two different intervals
	if (!StrICompare(line, "profile"))
	{
		QPrProfile;
		return;
	}

	//V_cshift_f: "v_cshift r g b pct" sets the base screen tint. mods
	//stuffcmd it for ambience and damage feedback
	if (!StrNICompare(line, "v_cshift", 8) &&
		(line[8] == ' ' || line[8] == 0))
	{
		arg = line + 8;
		q_cshift_base_r = 0;
		q_cshift_base_g = 0;
		q_cshift_base_b = 0;
		q_cshift_base_a = 0;

		while (*arg == ' ')
			arg++;
		if (*arg)
		{
			q_cshift_base_r = ClampI64(ToI64(QAtoF(arg)), 0, 255);
			while (*arg && *arg != ' ') arg++;
			while (*arg == ' ') arg++;
			q_cshift_base_g = ClampI64(ToI64(QAtoF(arg)), 0, 255);
			while (*arg && *arg != ' ') arg++;
			while (*arg == ' ') arg++;
			q_cshift_base_b = ClampI64(ToI64(QAtoF(arg)), 0, 255);
			while (*arg && *arg != ' ') arg++;
			while (*arg == ' ') arg++;
			q_cshift_base_a = ClampI64(ToI64(QAtoF(arg)), 0, 255);
		}
		return;
	}

	//r_simd 0: scalar span fallback, the bisect switch for the SSE2 kernel
	if (!StrNICompare(line, "r_simd", 6) && line[6] == ' ')
	{
		q_opt_simd = ToBool(QCfgValue(line));
		return;
	}

	//csqcdump: one frame of the mod HUD's draw calls into the log
	if (!StrICompare(line, "csqcdump"))
	{
		q_cs_trace = TRUE;
		QConPrint("csqc: tracing one frame to the log");
		return;
	}

	//cl_csqc 0: force the classic status bar over the mod HUD
	if (!StrNICompare(line, "cl_csqc", 7) && line[7] == ' ')
	{
		q_cs_enable = ToBool(QCfgValue(line));
		return;
	}

	//occlusion switches, so a suspect frame can be split without a rebuild
	if (!StrNICompare(line, "r_occents", 9) && line[9] == ' ')
	{
		q_occ_enable = ToBool(QCfgValue(line));
		return;
	}

	if (!StrNICompare(line, "r_occworld", 10) && line[10] == ' ')
	{
		q_occworld = ToBool(QCfgValue(line));
		return;
	}

	if (!StrNICompare(line, "r_skyfog", 8) && line[8] == ' ')
	{
		q_fog_sky_alpha = ClampI64(ToI64(QCfgValueF(line) * 255.0), 0, 255);
		QCvarSet("r_skyfog", QCfgValueF(line));
		return;
	}

	if (!StrNICompare(line, "scr_sbarscale", 13) && line[13] == ' ')
	{
		q_opt_hudscale = ClampI64(QCfgValue(line), 0, 8);
		//mirrored: a mod polling cvar("scr_sbarscale") on a mismatch re-sets
		//it every frame, the hudstyle loop with a different name
		QCvarSet("scr_sbarscale", ToF64(q_opt_hudscale));
		QCfgSave;
		return;
	}

	//scr_sbaralpha is 0..1 in the config, 0..255 here
	if (!StrNICompare(line, "scr_sbaralpha", 13) && line[13] == ' ')
	{
		q_opt_sbaralpha = ClampI64(ToI64(QCfgValueF(line) * 255.0), 0, 255);
		QCvarSet("scr_sbaralpha", ToF64(q_opt_sbaralpha) / 255.0);
		QCfgSave;
		return;
	}

	if (!StrNICompare(line, "r_showents", 10) && (!line[10] || line[10] == ' '))
	{
		if (line[10] == ' ')
			q_opt_showents = ToBool(QCfgValue(line) != 0);
		else
			q_opt_showents = !q_opt_showents;

		if (q_opt_showents)
			QConPrint("r_showents 1 - names go to the log");
		else
			QConPrint("r_showents 0");
		return;
	}

	if (!StrNICompare(line, "r_speeds", 8) && (!line[8] || line[8] == ' '))
	{
		if (line[8] == ' ')
			q_opt_speeds = ToBool(QCfgValue(line) != 0);
		else
			q_opt_speeds = !q_opt_speeds;

		if (q_opt_speeds)
			QConPrint("r_speeds 1");
		else
			QConPrint("r_speeds 0");
		return;
	}

	if (!StrNICompare(line, "r_particles", 11) &&
		(!line[11] || line[11] == ' '))
	{
		if (line[11] == ' ')
			q_opt_drawparts = ToBool(QCfgValue(line) != 0);
		else
			q_opt_drawparts = !q_opt_drawparts;

		if (q_opt_drawparts)
			QConPrint("r_particles 1");
		else
			QConPrint("r_particles 0");
		return;
	}

	if (!StrNICompare(line, "debugtex", 8) && (!line[8] || line[8] == ' '))
	{
		q_opt_debugtex = !q_opt_debugtex;
		QCfgSave;
		return;
	}

	//"fps" toggles, "fps 0"/"fps 1" sets
	if (!StrNICompare(line, "fps", 3) &&
		(!line[3] || line[3] == ' '))
	{
		if (line[3] == ' ')
			q_opt_fps = ToBool(QCfgValue(line) != 0);
		else
			q_opt_fps = !q_opt_fps;

		QCfgSave;

		if (q_opt_fps)
			QConPrint("fps on");
		else
			QConPrint("fps off");

		QCfgSave;
		return;
	}

	if (!StrNICompare(line, "probe", 5))
	{
		//q_canvas lives in the app shell, which compiles after this file, so
		//the pixel is chosen there once the frame starts
		q_probe_iz    = -1.0;
		q_probe_hit   = FALSE;
		q_probe_arm   = TRUE;
		q_probe_req   = TRUE;
		QConPrint("probe: armed at crosshair");
		return;
	}

	if (!StrNICompare(line, "heapcheck", 9))
	{
		if (line[9] == ' ')
			q_heap_check_on = ToBool(QAtoF(line + 10) != 0.0);
		else
			q_heap_check_on = !q_heap_check_on;

		if (q_heap_check_on)
			QConPrint("heapcheck on");
		else
			QConPrint("heapcheck off");
		return;
	}

	//COM_AddGameDirectory. mounting happens at startup, and the archives back
	//every model and sound in use, so this only records the directory
	//"game <dir>" and "game" for plain id1. deferred rather than done here:
	//this file compiles before the shell that owns the archives, and the swap
	//frees every pak while lookups are still handing out interior pointers
	if (!StrNICompare(line, "game ", 5) || !StrICompare(line, "game"))
	{
		if (line[4])
			QStrCopy(q_gamedir_next, line + 5, 32);
		else
			q_gamedir_next[0] = 0;

		q_gamedir_pending = TRUE;
		QConPrint("switching gamedir");
		return;
	}

	//CL_PlayDemo_f / CL_Stop_f
	if (!StrNICompare(line, "playdemo ", 9))
	{
		if (QDemoStart(line + 9))
			QConPrint("playing demo");
		else
			QConPrint("couldn't open demo");
		return;
	}

	//Host_Demos_f: the attract loop cycles demo1..3 behind the main menu
	if (!StrICompare(line, "demos"))
	{
		q_demo_loop_index = 0;
		if (QDemoNextInLoop)
			QConPrint("demo loop started");
		else
			QConPrint("no demos found");
		return;
	}

	//Host_Color_f. one argument sets both, two set shirt then trousers.
	//THE TROUSER COLOUR IS THE TEAM - QSvApplyClientColors writes .team from
	//it, so this has to reach the edict rather than only the config, or a
	//player who changes colour mid-game keeps their old team
	if (!StrNICompare(line, "color ", 6))
	{
		p = line + 6;
		while (*p == ' ')
			p++;

		ctop = ClampI64(ToI64(QAtoF(p)), 0, 13);

		//second number if there is one, else shirt and trousers match
		while (*p && *p != ' ')
			p++;
		while (*p == ' ')
			p++;

		if (*p)
			cbot = ClampI64(ToI64(QAtoF(p)), 0, 13);
		else
			cbot = ctop;

		q_setup_top    = ctop;
		q_setup_bottom = cbot;

		if (q_player_active && q_player_edict > 0)
			QSvApplyClientColors(q_player_edict, ctop, cbot);

		//force the identity out again so remotes see the new colours
		si = QSvFindLocalSlot;
		if (si >= 0)
			q_sv_clients[si].sent_ident = FALSE;

		QCfgSave;
		StrPrint(msg, "color %d %d", ctop, cbot);
		QConPrint(msg);
		return;
	}

	//"edicts <classname>" - dump the link fields for a class. LinkDoors pairs
	//neighbouring doors through .enemy and .owner, and a half that never moves
	//is a half that never got linked. this shows which
	if (!StrNICompare(line, "edicts ", 7))
	{
		p = line + 7;
		while (*p == ' ')
			p++;

		if (!q_game_active || q_fld_classname < 0)
		{
			QConPrint("no world");
			return;
		}

		e = 0;
		for (si = 1; si < q_pr_num_edicts; si++)
		{
			if (q_pr_edict_free[si])
				goto qed_next;

			if (StrCompare(QPrStr(QPrFieldI(si, q_fld_classname)), p))
				goto qed_next;

			StrPrint(msg, "%3d %-14s enemy %3d owner %3d org %.0f %.0f %.0f",
				si, p,
				QPrEdictNum(QPrFieldI(si, q_fld_enemy)),
				QPrEdictNum(QPrFieldI(si, q_fld_owner)),
				QPrFieldF(si, q_fld_origin),
				QPrFieldF(si, q_fld_origin + 1),
				QPrFieldF(si, q_fld_origin + 2));
			QConPrint(msg);
			e++;

qed_next:
		}

		StrPrint(msg, "%d edicts", e);
		QConPrint(msg);
		return;
	}

	//Cvar hostname. a string, so it is a command here rather than a cvar row
	if (!StrNICompare(line, "hostname ", 9))
	{
		QStrCopy(q_host_name, line + 9, 32);
		QCfgSave;
		QConPrint("hostname set");
		return;
	}

	if (!StrICompare(line, "hostname"))
	{
		StrPrint(msg, "hostname is %s", q_host_name);
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "stopdemo"))
	{
		QDemoStop;
		q_demo_loop = FALSE;
		QConPrint("demo stopped");
		return;
	}

	if (!StrNICompare(line, "map ", 4))
	{
		//Host_Map_f: drop attract loop and enter the world. without this the
		//pending changelevel sits forever under the title-menu early-out, or
		//loads under q_demo_playing and the cam stays demo-owned
		QDemoStop;
		q_demo_loop = FALSE;
		QStrCopy(q_change_map, line + 4, 64);
		q_change_pending = TRUE;
		q_menu_ingame = TRUE;
		if (q_state != QST_CONSOLE)
			q_state = QST_PLAYING;
		return;
	}

	if (!StrNICompare(line, "changelevel ", 12))
	{
		QDemoStop;
		q_demo_loop = FALSE;
		QStrCopy(q_change_map, line + 12, 64);
		q_change_pending = TRUE;
		q_menu_ingame = TRUE;
		if (q_state != QST_CONSOLE)
			q_state = QST_PLAYING;
		return;
	}

	//NET_Slist_f. asynchronous by design, see QConSlist
	if (!StrICompare(line, "slist"))
	{
		QConSlist;
		return;
	}

	//netstat - what the client/server split is doing. not original, net_stats
	//is the closest thing
	if (!StrICompare(line, "netstat"))
	{
		//40 columns each. the mismatch count gets its own line - it decides
		//whether the client's reconstruction can be drawn from at all
		StrPrint(q_con_net_line, "net: %d ents, %d bytes, %d parsed",
			q_net_num_ents, q_net_datagram.len, q_net_parsed);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: MISMATCHED %d, dropped %d",
			q_net_mismatch_report, q_net_dropped);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: hp %d ar %d am %d wp %d",
			q_cl.health, q_cl.armorvalue, q_cl.currentammo, q_cl.weapon);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: %d clients connected",
			q_sv_client_count);
		QConPrint(q_con_net_line);

		//host side: where each remote body is right now
		if (q_udp_ready && q_udp_server)
		{
			for (si = 0; si < QSV_MAX_CLIENTS; si++)
			{
				if (!q_sv_clients[si].active || q_sv_clients[si].local)
					goto ns_next;

				e = q_sv_clients[si].edict;
				if (e > 0)
					StrPrint(q_con_net_line,
						"net: remote[%d] edict %d at %.0f %.0f %.0f mdl %d",
						si, e,
						q_sv_clients[si].origin[0],
						q_sv_clients[si].origin[1],
						q_sv_clients[si].origin[2],
						ToI64(QPrFieldF(e, q_fld_modelindex)));
				else
					StrPrint(q_con_net_line,
						"net: remote[%d] edict 0 (not spawned)", si);
				QConPrint(q_con_net_line);

				sock = QNetDgrmSock(si);
				if (sock && sock->active)
				{
					StrPrint(q_con_net_line,
						"net: remote[%d] udp %d.%d.%d.%d:%d signon %d",
						si,
						sock->ip & 255, (sock->ip >> 8) & 255,
						(sock->ip >> 16) & 255, (sock->ip >> 24) & 255,
						sock->port, q_sv_clients[si].signon);
					QConPrint(q_con_net_line);
				}

ns_next:
			}
		}

		StrPrint(q_con_net_line, "net: moves %d/%d ping %4.1fms",
			q_net_moves_sent, q_net_moves_read, q_net_move_ping * 1000.0);
		QConPrint(q_con_net_line);

		QConPrint(q_udp_status);

		myip = QNetLocalIP();
		StrPrint(q_con_net_line, "udp: local ip %d.%d.%d.%d",
			myip & 255, (myip >> 8) & 255,
			(myip >> 16) & 255, (myip >> 24) & 255);
		QConPrint(q_con_net_line);

		if (q_udp_ready)
		{
			if (q_udp_server)
				role = "hosting";
			else
				role = "joined";

			StrPrint(q_con_net_line, "udp: %s peer %d.%d.%d.%d",
				role,
				q_udp_peer_ip & 255, (q_udp_peer_ip >> 8) & 255,
				(q_udp_peer_ip >> 16) & 255, (q_udp_peer_ip >> 24) & 255);
			QConPrint(q_con_net_line);

			StrPrint(q_con_net_line, "udp: %d sent %d recvd %d err %d unresolved",
				q_udp_sent, q_udp_recvd, q_udp_errors, q_udp_unresolved);
			QConPrint(q_con_net_line);

			if (q_udp_peer_ip)
			{
				if (QNetUdpPeerResolved)
					QConPrint("udp: peer mac RESOLVED");
				else
				{
					StrPrint(q_con_net_line,
						"udp: peer mac UNRESOLVED, %d sends skipped",
						q_udp_unresolved);
					QConPrint(q_con_net_line);
				}
			}
		}
		return;
	}

	//qip <a.b.c.d> - static address for a link with no DHCP, which is two QEMU
	//guests wired together with -netdev socket
	if (!StrNICompare(line, "qip ", 4))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
			return;
		}

		//print the status either way, it names which failure
		QNetUdpSetLocalIP(QConParseIPV4(line + 4));
		QConPrint(q_udp_status);
		return;
	}

	//netdhcp - useless on a direct VM-to-VM link, it just times out
	if (!StrICompare(line, "netdhcp"))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC");
			return;
		}

		QConPrint("dhcp: asking, this may take a few seconds...");
		QNetDhcp;
		QConPrint(q_udp_status);
		return;
	}

	//stairlog 1 - every step-up attempt and whether it was kept
	if (!StrNICompare(line, "stairlog ", 9))
	{
		q_stair_log     = ToBool(Str2I64(line + 9) != 0);
		q_stair_reports = 0;

		if (q_stair_log)
			QConPrint("stair logging ON - see QUAKELOG.TXT");
		else
			QConPrint("stair logging off");
		return;
	}

	//bf - V_BonusFlash_f. stuffed by QuakeC on every pickup, so it arrives far
	//more often than it is typed
	if (!StrICompare(line, "bf"))
	{
		q_con_want_bf = TRUE;
		return;
	}

	//CDAudio_Play / CDAudio_Stop
	if (!StrNICompare(line, "music ", 6))
	{
		if (!StrICompare(line + 6, "stop"))
		{
			QMusicFree;
			AudioSFXStopAll;
			QConPrint("music stopped");
		}
		else
		{
			QMusicPlay(Str2I64(line + 6), tS);
			QConPrint(q_music_status);
		}
		return;
	}

	//Host_Connect_f. parses the quad itself instead of calling
	//PresentationToNetwork, so this file compiles with no net stack
	if (!StrNICompare(line, "connect ", 8))
	{
		QConConnect(line + 8);
		return;
	}

	//bare connect would fall through to the cvar lookup and come back as
	//"unknown command", which reads as the command not existing
	if (!StrICompare(line, "connect"))
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	if (!StrICompare(line, "disconnect"))
	{
		QNetUdpClose;
		q_cl_viewent = 0;
		QConPrint("disconnected");
		return;
	}

	//Host_Say_f via Cmd_ForwardToServer. on a listen host the console pauses
	//the server tick, so call Host_Say directly; a guest forwards over UDP
	if (!StrNICompare(line, "say_team ", 9))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 9, TRUE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say_team\", not connected");
		return;
	}
	if (!StrICompare(line, "say_team"))
	{
		QConPrint("usage: say_team <text>");
		return;
	}
	if (!StrNICompare(line, "say ", 4))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 4, FALSE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say\", not connected");
		return;
	}
	if (!StrICompare(line, "say"))
	{
		QConPrint("usage: say <text>");
		return;
	}
	if (!StrNICompare(line, "tell ", 5))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostTell(QSvFindLocalSlot, line + 5);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"tell\", not connected");
		return;
	}
	if (!StrICompare(line, "tell"))
	{
		QConPrint("usage: tell <name> <text>");
		return;
	}

	if (!StrICompare(line, "host"))
	{
		//under SLIRP prefer DHCP (10.0.2.15) - AutoIP 10.0.0.1 is socket MP
		//only and breaks hostfwd replies
		if (!QNetLocalIP)
			QNetDhcp;
		if (!QNetLocalIP)
			QNetAutoIP(0);

		if (QNetUdpOpen(QNET_PORT_DEFAULT))
		{
			q_udp_server = TRUE;
			QNetDgrmInit;
			QConPrint(q_udp_status);
			QConPrint("hosting - clients may connect to this ip");
		}
		else
			QConPrint(q_udp_status);
		return;
	}

	//diskwrite 0|1 - kill every write this app makes, for bisecting the crash
	//on quit. not an original command
	if (!StrNICompare(line, "diskwrite ", 10))
	{
		q_disk_writes = ToBool(Str2I64(line + 10) != 0);
		if (q_disk_writes)
			QConPrint("disk writes enabled");
		else
			QConPrint("disk writes DISABLED");
		return;
	}

	//explicit set, the fallthrough at the bottom handles the bare form
	if (!StrNICompare(line, "set ", 4))
	{
		QConCvar(line + 4);
		return;
	}

	if (!StrICompare(line, "restart"))
	{
		//what QuakeC's respawn() stuffs on a single-player death
		q_restart_pending = TRUE;
		return;
	}

	//--- movement cheats. Host_Noclip_f and Host_Fly_f swap the movetype; the
	//--- flycam stands in, player movement is driven from this side
	if (!StrICompare(line, "noclip"))
	{
		if (!QConCheatAllowed)
			return;

		q_con_want_noclip = TRUE;
		QConPrint("noclip toggled");
		return;
	}

	if (!StrICompare(line, "fly"))
	{
		if (!QConCheatAllowed)
			return;

		q_con_want_noclip = TRUE;
		QConPrint("fly mode toggled");
		return;
	}

	//--- flag cheats, as Host_God_f and Host_Notarget_f do it
	if (!StrICompare(line, "god"))
	{
		if (!QConCheatAllowed)
			return;
		QConCheatFlag(QFL_GODMODE_, "godmode");
		return;
	}

	if (!StrICompare(line, "notarget"))
	{
		if (!QConCheatAllowed)
			return;
		QConCheatFlag(QFL_NOTARGET_, "notarget");
		return;
	}

	if (!StrICompare(line, "kill"))
	{
		QConRunPlayerFunc("ClientKill");
		return;
	}

	//--- impulse: QuakeC consumes .impulse once. every weapon switch and
	//--- cheat code arrives this way
	if (!StrNICompare(line, "impulse ", 8))
	{
		QConImpulse(Str2I64(line + 8));
		return;
	}

	if (!StrNICompare(line, "give ", 5))
	{
		if (!QConCheatAllowed)
			return;
		QConGive(line + 5);
		return;
	}

	if (!StrNICompare(line, "fov ", 4))
	{
		//q_fov is in the app shell, compiled after this file - request it
		q_con_fov_want = ToF64(Str2I64(line + 4));
		if (q_con_fov_want < 30.0)	q_con_fov_want = 30.0;
		if (q_con_fov_want > 130.0)	q_con_fov_want = 130.0;
		StrPrint(msg, "fov %d", ToI64(q_con_fov_want));
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "save"))
	{
		if (q_con_save_ok)
			QConPrint("saved");
		else
			QConPrint("save failed");
		q_con_want_save = TRUE;
		return;
	}

	if (!StrICompare(line, "load"))
	{
		q_con_want_load = TRUE;
		return;
	}

	if (!StrICompare(line, "status"))
	{
		QConStatus;
		return;
	}

	if (!StrICompare(line, "version"))
	{
		QConPrint("Quake shareware data, engine written for ZealOS");
		return;
	}

	if (!StrICompare(line, "quit"))
	{
		q_con_want_quit = TRUE;
		return;
	}

	//--- binds, aliases and scripts ---
	if (!StrNICompare(line, "bind ", 5))
	{
		QCmdBind(line + 5);
		return;
	}

	if (!StrICompare(line, "bind"))
	{
		QCmdBindList;
		return;
	}

	if (!StrNICompare(line, "unbindall", 9))
	{
		QCmdUnbindAll;
		return;
	}

	if (!StrNICompare(line, "unbind ", 7))
	{
		QCmdUnbind(line + 7);
		return;
	}

	//Cmd_Echo_f: everything after the keyword, verbatim
	if (!StrNICompare(line, "echo ", 5))
	{
		QConPrint(line + 5);
		return;
	}

	if (!StrICompare(line, "echo"))
	{
		QConPrint("");
		return;
	}

	if (!StrICompare(line, "cvarlist"))
	{
		QCmdCvarList;
		return;
	}

	if (!StrNICompare(line, "alias ", 6))
	{
		QCmdAlias(line + 6);
		return;
	}

	if (!StrICompare(line, "alias"))
	{
		QCmdAliasList;
		return;
	}

	if (!StrNICompare(line, "unalias ", 8))
	{
		QCmdUnalias(line + 8);
		return;
	}

	//Cmd_Wait_f defers the rest of the command buffer by a frame. this
	//dispatcher runs one line to completion with nothing queued behind it,
	//so there is nothing to defer - accepted and ignored
	if (!StrICompare(line, "wait"))
		return;

	//Cmd_Exec_f. pak first like COM_LoadFile, then the disk
	if (!StrNICompare(line, "exec ", 5))
	{
		fi = QConSkipSpace(line, 5);
		QConToken(fline, line, fi, 128);

		fsize = 0;
		raw   = NULL;

		//Ironwail ships its own default.cfg in qs_pak, which overrides id1's.
		//that file, not the 1996 one, is what its users get: WASD, mouse look,
		//e/c to swim, wheel to cycle weapons. same text, embedded because
		//there is no qs_pak here
		if (!StrICompare(fline, "default.cfg"))
		{
			raw =
				"unbindall\n"
				"bind ALT +strafe\n"
				"bind a +moveleft\n"
				"bind d +moveright\n"
				"bind w +forward\n"
				"bind s +back\n"
				"bind e +moveup\n"
				"bind c +movedown\n"
				"bind SHIFT +speed\n"
				"bind CTRL +attack\n"
				"bind SPACE +jump\n"
				"bind UPARROW +forward\n"
				"bind DOWNARROW +back\n"
				"bind LEFTARROW +left\n"
				"bind RIGHTARROW +right\n"
				"bind DEL +lookdown\n"
				"bind PGDN +lookup\n"
				"bind END centerview\n"
				"bind TAB +showscores\n"
				"bind 1 \"impulse 1\"\n"
				"bind 2 \"impulse 2\"\n"
				"bind 3 \"impulse 3\"\n"
				"bind 4 \"impulse 4\"\n"
				"bind 5 \"impulse 5\"\n"
				"bind 6 \"impulse 6\"\n"
				"bind 7 \"impulse 7\"\n"
				"bind 8 \"impulse 8\"\n"
				"bind 0 \"impulse 0\"\n"
				"bind / \"impulse 10\"\n"
				"bind MWHEELDOWN \"impulse 10\"\n"
				"bind MWHEELUP \"impulse 12\"\n"
				"bind MOUSE1 +attack\n"
				"bind MOUSE2 +jump\n"
				"bind MOUSE3 +zoom\n"
				"bind F1 help\n"
				"bind F2 menu_save\n"
				"bind F3 menu_load\n"
				"bind F4 menu_options\n"
				"bind F5 menu_multiplayer\n"
				"bind F6 \"save quick\"\n"
				"bind F9 \"load quick\"\n"
				"bind F10 quit\n"
				"bind F11 togglezoom\n"
				"bind F12 screenshot\n"
				"bind PAUSE pause\n"
				"bind t messagemode\n"
				"bind = sizeup\n"
				"bind - sizedown\n"
				"bind INS +klook\n"
				"gamma 0.95\n"
				"contrast 1.2\n"
				"volume 0.7\n"
				"sensitivity 3\n"
				"viewsize 110\n";

			fsize    = StrLen(raw);
			embedded = TRUE;
		}

		if (!raw)
			raw = QPakLoad(fline, &fsize);

		if (!raw && FileFind(fline))
			raw = FileRead(fline, &fsize);

		if (!raw || fsize <= 0)
		{
			if (raw)
				Free(raw);
			StrPrint(msg, "couldn't exec %s", fline);
			QConPrint(msg);
			return;
		}

		StrPrint(msg, "execing %s", fline);
		QConPrint(msg);

		fi = 0;
		while (fi < fsize)
		{
			fn = 0;
			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r' && fn < 127)
			{
				fline[fn] = raw[fi];
				fn++;
				fi++;
			}
			fline[fn] = 0;

			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r')
				fi++;
			while (fi < fsize && (raw[fi] == '\n' || raw[fi] == '\r'))
				fi++;

			//strip a // comment tail, then trailing blanks
			for (an = 0; an < fn - 1; an++)
			{
				if (fline[an] == '/' && fline[an + 1] == '/')
				{
					fline[an] = 0;
					fn = an;
					break;
				}
			}
			while (fn > 0 && (fline[fn - 1] == ' ' || fline[fn - 1] == '\t'))
			{
				fn--;
				fline[fn] = 0;
			}

			//leading blanks too, a config is indented like source
			an = 0;
			while (fline[an] == ' ' || fline[an] == '\t')
				an++;

			if (fline[an])
				QConExec(fline + an, FALSE);
		}

		if (!embedded)
			Free(raw);
		return;
	}

	if (!StrICompare(line, "help"))
	{
		QConPrint("map <n>  changelevel <n>  restart  save  load");
		QConPrint("god  notarget  noclip  fly  kill");
		QConPrint("impulse <n>  give <s|n|r|c|h|1-8> <v>  fov <n>");
		QConPrint("say <text>  say_team <text>  tell <name> <text>");
		QConPrint("bind <key> <action>  unbind <key>  unbindall");
		QConPrint("alias <n> <text>  unalias <n>  exec <file>");
		QConPrint("echo <text>  cvarlist  wait");
		QConPrint("status  version  quit");
		return;
	}

	//--- alias expansion ---
	//Cmd_ExecuteString checks the alias list after the builtins and before
	//Cvar_Command, so an alias can't shadow a real command
	QConToken(aname, line, 0, QALIAS_NAME);
	aslot = QAliasFind(aname);
	if (aslot >= 0)
	{
		//an alias naming itself would spin forever, so cap the nesting the
		//way the original caps its alias loop
		if (q_alias_depth >= QALIAS_DEPTH)
		{
			QConPrint("alias recursion too deep");
			return;
		}

		QStrCopy(acmd, q_alias_text + aslot * QALIAS_TEXT, QALIAS_TEXT);
		q_alias_depth++;

		//semicolons split, as Cbuf_InsertText's parse does
		ai = 0;
		while (acmd[ai])
		{
			an = 0;
			while (acmd[ai] && acmd[ai] != ';' && an < QALIAS_TEXT - 1)
			{
				fline[an] = acmd[ai];
				an++;
				ai++;
			}
			fline[an] = 0;

			while (acmd[ai] == ';')
				ai++;

			while (an > 0 && (fline[an - 1] == ' ' || fline[an - 1] == '\t'))
			{
				an--;
				fline[an] = 0;
			}

			fn = 0;
			while (fline[fn] == ' ' || fline[fn] == '\t')
				fn++;

			if (fline[fn])
				QConExec(fline + fn, FALSE);
		}

		q_alias_depth--;
		return;
	}

	//last resort, as Cmd_ExecuteString does: no command matched, so fall
	//through to Cvar_Command. this is why the original has no set keyword
	if (QConCvarCommand(line, echo))
		return;

	//name it. a mod stuffcmds whatever it expects the engine to have, and a
	//bare "unknown command" hides which one is missing. logged as well -
	//console lines scroll away and a per-frame repeat is the diagnosis
	StrPrint(msg, "unknown command: %s", line);
	QConPrint(msg);
	if (q_unknown_logged < 24)
	{
		q_unknown_logged++;
		StrPrint(q_stuff_line, "%s\n", msg);
		QLog(q_stuff_line);
	}
}

U0 QMsgModeBegin(Bool team)
{//Con_MessageMode_f / Con_MessageMode2_f
	I64 i;

	//the key that opened chat is still held, and its edge has never been seen
	//by QConKeyEdge - without this the bound key types itself as the first
	//character of every message
	for (i = 0; i < 256; i++)
		q_key_prev[i] = ToI64(ToBool(Bt(kbd.down_bitmap, i)));

	q_msg_mode  = TRUE;
	q_msg_team  = team;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeCancel()
{
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeInput()
{//Key_Message: type into chat_buffer, Enter sends say / say_team.
 //sits after QConExec, single-pass compiler
	I64	 i;
	I64	 sc;
	U8	 ch;
	U8	 cmd[48];

	if (!q_msg_mode)
		return;

	if (QConKeyEdge(SC_ESC))
	{
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		if (q_chat_len > 0)
		{
			if (q_msg_team)
				StrPrint(cmd, "say_team %s", q_chat_buf);
			else
				StrPrint(cmd, "say %s", q_chat_buf);

			//no receipt. the "]say lol" line belongs to a command TYPED at the
			//console; messagemode already showed the text as it was entered,
			//and the server echoes it back as "name: lol" for everyone. three
			//copies of one message is two too many
			QConExec(cmd, FALSE);
		}
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_chat_len > 0)
	{
		q_chat_len--;
		q_chat_buf[q_chat_len] = 0;
		return;
	}

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			ch = QConShiftChar(ch);

		if (QConKeyEdge(sc) && q_chat_len < 31)
		{
			q_chat_buf[q_chat_len] = ch;
			q_chat_len++;
			q_chat_buf[q_chat_len] = 0;
		}
		i++;
	}

	if (QConKeyEdge(Char2ScanCode('-')) && q_chat_len < 31)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			q_chat_buf[q_chat_len] = '_';
		else
			q_chat_buf[q_chat_len] = '-';
		q_chat_len++;
		q_chat_buf[q_chat_len] = 0;
	}
}

U8 q_kb_release[QKB_CMD_MAX];

//scancode the engine handles natively for the console, set at startup
I64 q_kb_console_sc = -1;

U0 QZoomUpdate(F64 dt)
{//SCR_UpdateZoom. a ramp with no direction is already at an end and costs
 //nothing; zoom_speed 0 means instant, which is the 1e6 in the original
	F64 speed = QCvarGet("zoom_speed");

	if (q_zoom_dir == 0.0)
		return;

	if (speed <= 0.0)
		speed = 1000000.0;

	q_zoom += q_zoom_dir * speed * dt;

	if (q_zoom >= 1.0)
	{
		q_zoom     = 1.0;
		q_zoom_dir = 0.0;
	}
	else if (q_zoom <= 0.0)
	{
		q_zoom     = 0.0;
		q_zoom_dir = 0.0;
	}
}

F64 QZoomFov(F64 base)
{//SCR_CalcRefdef:
 //    zoom *= zoom * (3.f - 2.f * zoom);   // smoothstep
 //    r_refdef.basefov = LERP (scr_fov.value, scr_zoomfov.value, zoom);
	F64 z = q_zoom;
	F64 target;

	if (z <= 0.0)
		return base;

	target = QCvarGet("scr_zoomfov");
	if (target < 10.0 || target > 170.0)
		target = 30.0;

	z = z * z * (3.0 - 2.0 * z);

	return base + (target - base) * z;
}

U0 QKeyBindFrame(Bool typing)
{//run the command bound to every key that went down this frame, then rebuild
 //the +command levels from every key currently held
 //
 //plain commands are edge triggered, like the impulse poll: a held key fires
 //once. +commands are LEVEL, and rebuilt rather than latched - two keys on
 //one action (MOUSE2 and SPACE both +jump) means releasing either would send
 //the -jump that a latch obeys, stopping an action the other key still holds
 //
 //typing means the console or messagemode owns the keyboard. Key_Event routes
 //those keys to the editor and never to a binding, so every key reads as UP:
 //new presses are blocked and the levels fall to whatever the console holds,
 //which is what Key_ClearStates does on a key_dest change
	Bool down;
	U8	*cmd;
	I64  i;
	I64  b;

	for (i = 0; i < QBTN_COUNT; i++)
		q_btn[i] = q_btn_con[i];

	for (i = 0; i < QKB_KEYS; i++)
	{
		down = FALSE;
		if (!typing)
			down = QKeyDown(i);

		cmd = &q_keybind[i * QKB_CMD_MAX];

		//the console key is consumed by the engine BEFORE bindings, as
		//Key_Event does. a config that also binds it to "toggleconsole" would
		//otherwise request a second flip and the console strobed open/shut
		if (i == q_kb_console_sc)
			goto qkb_next;

		if (cmd[0] == '+')
		{
			if (down)
			{
				b = QBtnIndex(cmd + 1);
				if (b >= 0)
					q_btn[b] = TRUE;
				else if (!q_keybind_down[i])
					QConExec(cmd, FALSE);		//+zoom and friends
			}
			else if (q_keybind_down[i])
			{
				b = QBtnIndex(cmd + 1);
				if (b < 0)
				{
					StrCopy(q_kb_release, cmd);
					q_kb_release[0] = '-';
					QConExec(q_kb_release, FALSE);
				}
			}
		}
		else if (down && !q_keybind_down[i] && cmd[0])
			QConExec(cmd, FALSE);

		q_keybind_down[i] = down;

qkb_next:
	}
}

U0 QConExecStartupCfgs()
{//Host_Init's "exec quake.rc". the engine names exactly one file: quake.rc
 //execs default.cfg, config.cfg and autoexec.cfg itself, and a mod ships its
 //own. COM_FindFile searches the gamedir before id1, so the mod's copy wins
 //
 //a gamedir with no quake.rc gets the files quake.rc would have run, which is
 //what QuakeSpasm falls back to
	U8	*probe;
	I64	 psize = 0;

	//nothing a config does may write the config back out - see q_cfg_exec
	q_cfg_exec = TRUE;

	probe = QPakLoad("quake.rc", &psize);
	if (probe)
	{
		Free(probe);
		QConExec("exec quake.rc", FALSE);
	}
	else
	{
		QConExec("exec default.cfg", FALSE);
		QConExec("exec autoexec.cfg", FALSE);
	}

	q_cfg_exec = FALSE;
}

U0 QConDrainStuff()
{//Cbuf_Execute. stuffcmd text IS console text, so it goes through the same
 //executor and anything the console understands works
	U8	cmd[128];
	I64	n = 0;
	I64	i;
	I64	done = 0;		//bytes consumed by a terminated command
	U8	c;

	if (q_bi_stuff_len < 1)
		return;

	for (i = 0; i < q_bi_stuff_len; i++)
	{
		c = q_bi_stuff_buf[i];

		if (c == '\n' || c == ';' || n >= 126)
		{
			cmd[n] = 0;
			if (n > 0)
			{
				//the mod drives the engine through here - a settings loop
				//shows as the same line every frame
				if (q_stuff_logged < 40)
				{
					q_stuff_logged++;
					StrPrint(q_stuff_line, "stuff: %s\n", cmd);
					QLog(q_stuff_line);
				}
				QConExec(cmd, FALSE);
			}
			n    = 0;
			done = i + 1;
		}

		if (c != '\n' && c != ';')
		{
			cmd[n] = c;
			n++;
		}
	}

	//an unterminated tail is a command still being ASSEMBLED, not a command:
	//QuakeC builds the level exit out of three localcmd calls and only the
	//last carries the newline. running the tail here fired "changelevel "
	//with no map name
	if (done < q_bi_stuff_len)
	{
		q_bi_stuff_len -= done;
		MemCopy(q_bi_stuff_buf, q_bi_stuff_buf + done, q_bi_stuff_len);
		q_bi_stuff_buf[q_bi_stuff_len] = 0;

		//a tail longer than any command is not a partial, it is a writer that
		//never sends a newline. held forever it fills the queue, and a full
		//queue makes QBiCbufAdd drop EVERY later stuffcmd and localcmd
		//silently - level changes included
		if (q_bi_stuff_len > 126)
		{
			QStrCopy(cmd, q_bi_stuff_buf, 128);
			QConExec(cmd, FALSE);
			q_bi_stuff_len    = 0;
			q_bi_stuff_buf[0] = 0;
		}
	}
	else
	{
		q_bi_stuff_len    = 0;
		q_bi_stuff_buf[0] = 0;
	}
}

U0 QConInput()
{//one frame of typing
	I64 i;
	I64 sc;
	I64 ch;

	//printable characters
	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		//the key that opens the console is consumed by the engine and never
		//reaches the editor, as Key_Event does - it is in the charset because
		//a backquote is a typeable character everywhere else
		if (sc == q_kb_console_sc)
			goto qci_next;

		if (QConKeyEdge(sc) && q_con_input_len < QCON_INPUT_MAX)
		{
			if (Bt(kbd.down_bitmap, SC_SHIFT))
				ch = QConShiftChar(ch);

			q_con_input[q_con_input_len] = ch;
			q_con_input_len++;
			q_con_input[q_con_input_len] = 0;
		}

qci_next:
		i++;
	}

	//Key_Console's scrollback. the wheel is read here because the frame loop
	//clears raw_data after this runs
	QConScroll(0);
	if (QConKeyEdge(SC_PAGE_UP))
		QConScroll(4);
	if (QConKeyEdge(SC_PAGE_DOWN))
		QConScroll(-4);
	if (mouse_hard.raw_data.z > 0)
		QConScroll(2);
	if (mouse_hard.raw_data.z < 0)
		QConScroll(-2);

	//consumed here: the frame loop's MouseRawReset is not reached on the
	//title-screen console path, and an unconsumed delta scrolls every frame
	mouse_hard.raw_data.z = 0;
	if (QConKeyEdge(SC_HOME))
		QConScroll(QCON_LINES);
	if (QConKeyEdge(SC_END))
		QConScroll(-QCON_LINES);

	if (QConKeyEdge(SC_BACKSPACE) && q_con_input_len > 0)
	{
		q_con_input_len--;
		q_con_input[q_con_input_len] = 0;
	}

	//Key_Console's history walk. an empty slot ends it rather than cycling
	//through blanks
	if (QConKeyEdge(SC_CURSOR_UP))
	{
		I64 probe = q_con_hist_line;
		I64 tries;

		for (tries = 0; tries < QCON_HISTORY; tries++)
		{
			probe--;
			if (probe < 0)
				probe = QCON_HISTORY - 1;

			if (probe == q_con_edit_line)
				break;

			if (q_con_hist[probe * (QCON_INPUT_MAX + 2)])
			{
				q_con_hist_line = probe;
				QConHistoryRecall(probe);
				break;
			}
		}
	}

	if (QConKeyEdge(SC_CURSOR_DOWN))
	{
		if (q_con_hist_line == q_con_edit_line)
		{
			q_con_input[0]  = 0;
			q_con_input_len = 0;
		}
		else
		{
			q_con_hist_line++;
			if (q_con_hist_line >= QCON_HISTORY)
				q_con_hist_line = 0;

			if (q_con_hist_line == q_con_edit_line)
			{
				q_con_input[0]  = 0;
				q_con_input_len = 0;
			}
			else
				QConHistoryRecall(q_con_hist_line);
		}
	}

	if (QConKeyEdge(SC_ENTER))
	{
		//store before executing, a command that changes state must still
		//be recallable
		if (q_con_input_len > 0)
		{
			QStrCopy(&q_con_hist[q_con_edit_line * (QCON_INPUT_MAX + 2)],
				q_con_input, QCON_INPUT_MAX + 1);

			q_con_edit_line++;
			if (q_con_edit_line >= QCON_HISTORY)
				q_con_edit_line = 0;

			q_con_hist[q_con_edit_line * (QCON_INPUT_MAX + 2)] = 0;
			q_con_hist_line = q_con_edit_line;
		}

		QConExec(q_con_input);
		q_con_input[0]  = 0;
		q_con_input_len = 0;
	}
}

U0 QConDrawNotify(CQCanvas *c)
{//Con_DrawNotify: newest few lines, top left, while still fresh. suppressed
 //with the console down or the same text appears twice
	I64	 i;
	I64	 line;
	I64	 y = 0;
	I64	 x;
	U8	*row;
	U8	 prompt[16];

	if (!q_con_ready)
		return;

	for (i = QCON_NOTIFY_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qcn_next;

		if (tS - q_con_time[line % QCON_LINES] > QCON_NOTIFY_TIME)
			goto qcn_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0])
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qcn_next:
	}

	//Con_DrawNotify's key_message branch
	if (q_msg_mode)
	{
		if (q_msg_team)
			StrPrint(prompt, "say_team:");
		else
			StrPrint(prompt, "say:");
		QStrDraw(c, 8, y, prompt);
		x = 8 + StrLen(prompt) * QCHAR_W;
		QStrDraw(c, x, y, q_chat_buf);
		if ((ToI64(tS * 4.0) & 1) == 0)
			QStrDraw(c, x + q_chat_len * QCHAR_W, y, "_");
	}
}

U0 QConDraw(CQCanvas *c)
{//slides over whatever is behind it
	I64	 i;
	I64	 line;
	I64	 y;
	I64	 con_h;
	U8	*row;

	//a fraction of the screen, not a fixed 128 - at 640x480 a fixed slice
	//covers a quarter of the view and the background stops part way across
	con_h = c->height / 2;
	if (con_h < QCON_HEIGHT)
		con_h = QCON_HEIGHT;

	if (q_pic_conback.pixels)
		QPicDrawFillPart(c, &q_pic_conback, con_h);

	//NEWEST FIRST, walking UP from just above the input line. filling
	//downward from the top instead ran out of room at the bottom and dropped
	//the most recent lines - the ones worth reading - and left nothing
	//reserved for the prompt, so the last row drew underneath it
	y = con_h - QCHAR_H - 2 - QCHAR_H;

	for (i = 1; i <= QCON_LINES; i++)
	{
		if (y < 0)
			goto qc_done;

		line = q_con_line - q_con_scroll - i;
		if (line < 0)
			goto qc_done;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0])
			QStrDraw(c, 8, y, row);

		y -= QCHAR_H;
	}

qc_done:
	//prompt, input line, blinking caret
	QStrDraw(c, 8, con_h - QCHAR_H - 2, "]");
	QStrDraw(c, 8 + QCHAR_W, con_h - QCHAR_H - 2, q_con_input);

	if (ToI64(tS * 3.0) & 1)
		QStrDraw(c, 8 + QCHAR_W * (q_con_input_len + 1),
			con_h - QCHAR_H - 2, "_");
}

U0 QMenuPlaque(CQCanvas *c, CQPic *title)
{//shared submenu furniture, placed as M_Multiplayer_Draw places it
	I64 mx = QMenuXOfs(c);

	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, mx + 16, 4);

	if (title && title->pixels)
		QPicDraw(c, title, mx + (QMENU_VW - title->width) / 2, 4);
}

U0 QMenuCursor(CQCanvas *c, I64 x, I64 y)
{//the main menu's six-frame 10Hz cursor
	I64 frame = ToI64(tS * 10.0) % 6;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);
}

U0 QOptDrawRow(CQCanvas *c, I64 item, I64 x, I64 ry)
{//one options row, placed by the caller. sliders sit 156 right of the label
	U8  line[64];
	F64 sizev;

	switch (item)
	{
		//the viewsize cvar, so the menu and the - / = keys move one value
		//M_Options OPT_HUDLEVEL. the slider spans 30..130, and the top three
		//notches are HUD tiers rather than sizes - naming them is the only way
		//to tell 110/120/130 apart, since the view is full height for all
		//three:
		//    >=130 Photo   no gun, no crosshair, no hud
		//    >=120 Off     gun and crosshair only
		//    >=110 Mini    status line
		//    else  Full
		case QOPT_SCRSIZE:
			QStrDrawAlt(c, x, ry, "hud detail");
			QMenuSlider(c, x + 156, ry, (QCvarGet("viewsize") - 30.0) / 100.0);

			sizev = QCvarGet("viewsize");
			if (sizev >= 130.0)
				QStrDrawAlt(c, x + 156 + 12 * 8, ry, "photo");
			else if (sizev >= 120.0)
				QStrDrawAlt(c, x + 156 + 12 * 8, ry, "off");
			else if (sizev >= 110.0)
				QStrDrawAlt(c, x + 156 + 12 * 8, ry, "mini");
			else
				QStrDrawAlt(c, x + 156 + 12 * 8, ry, "full");
			break;

		case QOPT_SENS:
			QStrDrawAlt(c, x, ry, "mouse speed");
			QMenuSlider(c, x + 156, ry,
				(q_opt_sensitivity - 0.02) / (0.60 - 0.02));
			break;

		case QOPT_VOLUME:
			QStrDrawAlt(c, x, ry, "sound volume");
			QMenuSlider(c, x + 156, ry, ToF64(q_opt_volume) / 100.0);
			break;

		//"music volume", not "CD audio" - the tracks come from the music folder
		case QOPT_MUSICVOL:
			QStrDrawAlt(c, x, ry, "music volume");
			QMenuSlider(c, x + 156, ry, q_music_volume);
			break;

		//cl_forwardspeed 200 walks, 400 runs
		case QOPT_ALWAYSRUN:
			if (QCvarGet("cl_forwardspeed") > 200.0)
				QStrDrawAlt(c, x, ry, "always run     on");
			else
				QStrDrawAlt(c, x, ry, "always run     off");
			break;

		//invert is the sign of m_pitch, not a separate flag
		case QOPT_INVERT:
			if (QCvarGet("m_pitch") < 0.0)
				QStrDrawAlt(c, x, ry, "invert mouse   on");
			else
				QStrDrawAlt(c, x, ry, "invert mouse   off");
			break;

		case QOPT_RES:
			StrPrint(line, "resolution    %dx%d",
				q_res_w[q_opt_res], q_res_h[q_opt_res]);
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_FULLSCREEN:
			if (q_opt_fullscreen)
				StrPrint(line, "screen        fullscreen");
			else
				StrPrint(line, "screen        windowed");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_COLOR:
			if (q_opt_truecolor)
				StrPrint(line, "color depth   truecolor");
			else
				StrPrint(line, "color depth   8-bit palette");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_TCLIGHT:
			if (!q_opt_truecolor)
				StrPrint(line, "smooth light  n/a");
			else if (q_opt_tclight)
				StrPrint(line, "smooth light  on");
			else
				StrPrint(line, "smooth light  banded");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_FOG:
			if (!q_opt_fog)
				StrPrint(line, "fog           off");
			else if (q_fog_on)
				StrPrint(line, "fog           on");
			else
				StrPrint(line, "fog           on (none in map)");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_TEXFILTER:
			if (!q_opt_truecolor)
				StrPrint(line, "texture filter n/a");
			else if (q_opt_texfilter)
				StrPrint(line, "texture filter smooth");
			else
				StrPrint(line, "texture filter sharp");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_EXTTEX:
			if (!q_opt_exttex)
				StrPrint(line, "hi-res tex    off");
			else if (q_ext_loaded)
				StrPrint(line, "hi-res tex    on (%d loaded)", q_ext_loaded);
			else
				StrPrint(line, "hi-res tex    on (none in gamedir)");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_LITRGB:
			if (!q_opt_tclight)
				StrPrint(line, "colored light n/a");
			else if (q_opt_litrgb)
				StrPrint(line, "colored light on");
			else
				StrPrint(line, "colored light off");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_RGBMIPS:
			if (!q_opt_rgbmips)
				StrPrint(line, "rgb mipmaps   off");
			else if (q_rgbmip_count)
				StrPrint(line, "rgb mipmaps   on (%d MB)",
					q_rgbmip_bytes / 1048576);
			else
				StrPrint(line, "rgb mipmaps   on");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_CACHEMB:
			StrPrint(line, "surf cache    %d MB", q_surf_budget / 1048576);
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_HUDSTYLE:
			//M_Options prints these four names verbatim
			if (q_opt_hudstyle == QHUD_MODERN_C)
				StrPrint(line, "hud layout    modern 1");
			else if (q_opt_hudstyle == QHUD_MODERN_S)
				StrPrint(line, "hud layout    modern 2");
			else if (q_opt_hudstyle == QHUD_QUAKEWORLD)
				StrPrint(line, "hud layout    quakeworld");
			else
				StrPrint(line, "hud layout    classic");
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_HUDSCALE:
			if (q_opt_hudscale > 0)
				StrPrint(line, "hud scale     %dx", q_opt_hudscale);
			else
				StrPrint(line, "hud scale     auto (%dx)", QHudScale(c));
			QStrDrawAlt(c, x, ry, line);
			break;

		//bar fills as the picture brightens, the exponent runs the other way
		case QOPT_GAMMA:
			QStrDrawAlt(c, x, ry, "brightness");
			QMenuSlider(c, x + 156, ry,
				(QGAMMA_MAX - q_opt_gamma) / (QGAMMA_MAX - QGAMMA_MIN));
			break;

		//names the two renderers, not on/off - "gun clipping off" reads as a bug
		case QOPT_GUNCLIP:
			if (q_opt_gunclip)
				QStrDrawAlt(c, x, ry, "gun depth      gl (no clip)");
			else
				QStrDrawAlt(c, x, ry, "gun depth      software");
			break;

		//M_Options draws the GLYPH, not a number:
		//    if (!crosshair.value) M_Print (x, y, "Off");
		//    else M_PrintWhite (x, y, va ("%c", crosshair_char));
		//a mod picking a per-weapon crosshair with a negative value is then
		//visible in the menu as the shape it actually draws
		case QOPT_CROSSHAIR:
			QStrDrawAlt(c, x, ry, "crosshair");
			sizev = QCvarGet("crosshair");

			if (sizev == 0.0)
				QStrDrawAlt(c, x + 156, ry, "off");
			else if (sizev < 0.0)
				QCharDraw(c, x + 156, ry, ToI64(-sizev) & 255);
			else if (sizev > 1.0)
				QCharDraw(c, x + 156, ry, 15);
			else
				QCharDraw(c, x + 156, ry, '+');
			break;

		case QOPT_CUSTOMIZE:
			QStrDrawAlt(c, x, ry, "customize controls");
			break;

		case QOPT_RESET:
			QStrDrawAlt(c, x, ry, "reset to defaults");
			break;

		case QOPT_BACK:
			QStrDrawAlt(c, x, ry, "back");
			break;

		case QOPT_P_VIDEO:
			QStrDrawAlt(c, x, ry, "video...");
			break;

		case QOPT_P_GFX:
			QStrDrawAlt(c, x, ry, "graphics...");
			break;

		case QOPT_P_CTRL:
			QStrDrawAlt(c, x, ry, "controls...");
			break;

		case QOPT_P_SOUND:
			QStrDrawAlt(c, x, ry, "sound...");
			break;

		case QOPT_P_IFACE:
			QStrDrawAlt(c, x, ry, "interface...");
			break;

		//CLAMP (1.0f, vid_contrast.value, 2.0f) - the slider spans exactly
		//that, so full left is the untouched image
		//d_mipscale. off means every face at mip 0 - sharper, and the surface
		//cache holds four times the texels per face
		case QOPT_MIPMAP:
			if (q_mipscale <= 0.0)
				StrPrint(line, "mipmaps       off");
			else
				StrPrint(line, "mipmaps       %d%%",
					ToI64(q_mipscale * 100.0));
			QStrDrawAlt(c, x, ry, line);
			break;

		case QOPT_PROGMIPS:
			if (q_prog_mips)
				QStrDrawAlt(c, x, ry, "progressive    on");
			else
				QStrDrawAlt(c, x, ry, "progressive    off");
			break;

		//r_softemu_mdl_warp. affine model mapping, which is what the software
		//renderer did - and it is the cheaper of the two
		case QOPT_MDLWARP:
			if (q_mdl_warp)
				QStrDrawAlt(c, x, ry, "model warping  on");
			else
				QStrDrawAlt(c, x, ry, "model warping  off");
			break;

		//r_lerpmodels. M_Options calls this row "Animations"
		case QOPT_ANIMLERP:
			if (q_lerp_models)
				QStrDrawAlt(c, x, ry, "animations    smooth");
			else
				QStrDrawAlt(c, x, ry, "animations    classic");
			break;

		case QOPT_CONTRAST:
			QStrDrawAlt(c, x, ry, "contrast");
			QMenuSlider(c, x + 156, ry, q_contrast - 1.0);
			break;

		//M_Options: r = 1 - scr_sbaralpha, shown as a percentage. the slider
		//reads as TRANSPARENCY, so full right is an invisible bar
		case QOPT_SBALPHA:
			StrPrint(line, "hud alpha");
			QStrDrawAlt(c, x, ry, line);
			QMenuSlider(c, x + 156, ry,
				1.0 - ToF64(q_opt_sbaralpha) / 255.0);
			break;

		case QOPT_SHOWFPS:
			if (q_opt_fps)
				QStrDrawAlt(c, x, ry, "show fps       on");
			else
				QStrDrawAlt(c, x, ry, "show fps       off");
			break;

		case QOPT_SHOWSPEED:
			if (QCvarGet("scr_showspeed") != 0.0)
				QStrDrawAlt(c, x, ry, "show speed     on");
			else
				QStrDrawAlt(c, x, ry, "show speed     off");
			break;

		//the cvar is a 4:3 fov; QDrawAdaptFovX widens it for this screen
		case QOPT_FOV:
			StrPrint(line, "field of view  %d",
				ToI64(QCvarGet("scr_fov")));
			QStrDrawAlt(c, x, ry, line);
			break;

		default:
			break;
	}
}

U0 QOptDraw(CQCanvas *c)
{//M_Options_Draw, one sub-page at a time. values as text beside each label
	I64	rows;
	I64	i;
	I64	y;
	I64	pitch;
	I64	mx;

	mx   = QMenuXOfs(c);
	rows = q_optp_count[q_optp];

	QMenuPlaque(c, &q_pic_p_option);

	//the list must fit the canvas: 200 rows at the lowest resolution, and a
	//fixed 16 pitch runs the last entries off the bottom where they can't be
	//reached. three steps down to M_Options_Draw's own 8 from y=32
	y     = 60;
	pitch = 16;

	if (y + rows * pitch + 24 > c->height)
	{
		y     = 40;
		pitch = 12;
	}

	if (y + rows * pitch + 24 > c->height)
	{
		y     = 32;
		pitch = QCHAR_H;
	}

	//last resort: anchor the list to the bottom of the canvas
	if (y + rows * pitch + 24 > c->height)
	{
		pitch = QCHAR_H;
		y     = c->height - rows * pitch - 8;
		if (y < 2)
			y = 2;
	}

	//which sub-page this is. the plaque art only says OPTIONS
	if (q_optp != QOPTP_ROOT)
		QStrDrawAlt(c, mx + 64, y - pitch, q_optp_name[q_optp]);

	for (i = 0; i < rows; i++)
		QOptDrawRow(c, q_optp_item[q_optp * QOPT_PAGE_MAX + i],
			mx + 64, y + i * pitch);

	//a caret, not the spinning cursor - that belongs to the main page and is
	//oversized at this pitch
	QStrDrawAlt(c, mx + 48, y + q_opt_row * pitch, ">");

	QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

U0 QOptResetDefaults()
{//every value this page owns back to a fresh install, bindings included,
 //then written out so it survives a restart
	QCvarSet("viewsize",		100.0);

	//400 is QCvarInit's default, always run ON. 200 is a state a fresh
	//install never starts in
	QCvarSet("cl_forwardspeed",	400.0);
	QCvarSet("cl_backspeed",	400.0);
	QCvarSet("m_pitch",			0.022);
	QCvarSet("lookspring",		0.0);
	QCvarSet("lookstrafe",		0.0);
	QCvarSet("crosshair",		0.0);
	q_opt_crosshair = 0;

	q_opt_sensitivity = 0.15;
	q_opt_volume      = 70;
	q_snd_master      = ToF64(q_opt_volume) / 100.0;
	q_music_volume    = 0.7;
	q_opt_gamma       = 1.0;
	q_opt_gunclip     = TRUE;
	q_opt_truecolor   = TRUE;
	q_opt_tclight     = TRUE;
	q_opt_fog         = TRUE;
	q_opt_texfilter   = FALSE;
	q_opt_exttex      = FALSE;
	q_opt_litrgb      = TRUE;
	q_opt_debugtex    = FALSE;
	q_opt_rgbmips     = TRUE;
	q_surf_budget     = 335544320;
	q_opt_hudscale    = 0;
	q_opt_hudstyle    = QHUD_MODERN_S;	//gl_screen.c:100
	QCvarSet("hudstyle", ToF64(q_opt_hudstyle));
	q_opt_sbaralpha   = 191;			//gl_screen.c:88, 0.75
	QRGBUpdateActive;
	q_opt_res         = QRES_DEFAULT;
	q_res_dirty       = TRUE;

	QMusicApplyVolume;
	QBindDefaults;
	QCfgSave;

	QMenuSound(QMSND_VALUE);
}

//M_Keys' own bind table, trimmed to what this engine can act on. gamepad and
//bindlist entries are dropped; everything else keeps the reference wording
#define QKEYS_ROWS	41

U8 *q_keys_cmd[QKEYS_ROWS];
U8 *q_keys_label[QKEYS_ROWS];

U0 QKeysTableInit()
{//globals are not zeroed and these are drawn as strings
	q_keys_cmd[0]  = "+forward";	q_keys_label[0]  = "move forward";
	q_keys_cmd[1]  = "+back";		q_keys_label[1]  = "move backward";
	q_keys_cmd[2]  = "+moveleft";	q_keys_label[2]  = "move left";
	q_keys_cmd[3]  = "+moveright";	q_keys_label[3]  = "move right";
	q_keys_cmd[4]  = "+jump";		q_keys_label[4]  = "jump / swim up";
	q_keys_cmd[5]  = "+moveup";		q_keys_label[5]  = "swim up";
	q_keys_cmd[6]  = "+movedown";	q_keys_label[6]  = "swim down";
	q_keys_cmd[7]  = "+speed";		q_keys_label[7]  = "run";
	q_keys_cmd[8]  = "+strafe";		q_keys_label[8]  = "sidestep";
	q_keys_cmd[9]  = "+left";		q_keys_label[9]  = "turn left";
	q_keys_cmd[10] = "+right";		q_keys_label[10] = "turn right";
	q_keys_cmd[11] = "+lookup";		q_keys_label[11] = "look up";
	q_keys_cmd[12] = "+lookdown";	q_keys_label[12] = "look down";
	q_keys_cmd[13] = "centerview";	q_keys_label[13] = "center view";
	q_keys_cmd[14] = "togglezoom";	q_keys_label[14] = "toggle zoom";
	q_keys_cmd[15] = "+attack";		q_keys_label[15] = "attack";
	q_keys_cmd[16] = "impulse 10";	q_keys_label[16] = "next weapon";
	q_keys_cmd[17] = "impulse 12";	q_keys_label[17] = "prev weapon";
	q_keys_cmd[18] = "+showscores";	q_keys_label[18] = "show scores";
	q_keys_cmd[19] = "messagemode";	q_keys_label[19] = "text chat";
	q_keys_cmd[20] = "save quick";	q_keys_label[20] = "quick save";
	q_keys_cmd[21] = "load quick";	q_keys_label[21] = "quick load";
	q_keys_cmd[22] = "toggleconsole"; q_keys_label[22] = "console";
	q_keys_cmd[23] = "impulse 1";	q_keys_label[23] = "axe";
	q_keys_cmd[24] = "impulse 2";	q_keys_label[24] = "shotgun";
	q_keys_cmd[25] = "impulse 3";	q_keys_label[25] = "super shotgun";
	q_keys_cmd[26] = "impulse 4";	q_keys_label[26] = "nailgun";
	q_keys_cmd[27] = "impulse 5";	q_keys_label[27] = "super nailgun";
	q_keys_cmd[28] = "impulse 6";	q_keys_label[28] = "grenade launcher";
	q_keys_cmd[29] = "impulse 7";	q_keys_label[29] = "rocket launcher";
	q_keys_cmd[30] = "impulse 8";	q_keys_label[30] = "thunderbolt";
	q_keys_cmd[31] = "+mlook";		q_keys_label[31] = "mouse look";
	q_keys_cmd[32] = "+klook";		q_keys_label[32] = "keyboard look";
	q_keys_cmd[33] = "screenshot";	q_keys_label[33] = "screenshot";
	q_keys_cmd[34] = "+zoom";		q_keys_label[34] = "quick zoom";
	q_keys_cmd[35] = "impulse 225";	q_keys_label[35] = "laser cannon";
	q_keys_cmd[36] = "impulse 226";	q_keys_label[36] = "mjolnir";
	q_keys_cmd[37] = "menu_load";	q_keys_label[37] = "load menu";
	q_keys_cmd[38] = "menu_save";	q_keys_label[38] = "save menu";
	q_keys_cmd[39] = "menu_options";q_keys_label[39] = "options menu";
	q_keys_cmd[40] = "pause";		q_keys_label[40] = "pause";
}

I64 QKeysFindKey(I64 row)
{//lowest scancode running this row's command, 0 for none
	I64 i;

	for (i = 0; i < QKB_KEYS; i++)
	{
		if (!StrICompare(&q_keybind[i * QKB_CMD_MAX], q_keys_cmd[row]))
			return i;
	}

	return 0;
}

U0 QKeysUnbind(I64 row)
{//strip this action off every key it holds
	I64 i;

	for (i = 0; i < QKB_KEYS; i++)
	{
		if (!StrICompare(&q_keybind[i * QKB_CMD_MAX], q_keys_cmd[row]))
			q_keybind[i * QKB_CMD_MAX] = 0;
	}
}

U0 QKeysBind(I64 row, I64 sc)
{//one key drives one thing, and one action is driven by one key
	U8	line[96];
	U8	kname[32];
	I64	i;

	if (sc <= 0 || sc >= QKB_KEYS)
		return;

	//drop this key's old duty and this action's old key
	q_keybind[sc * QKB_CMD_MAX] = 0;
	for (i = 0; i < QBIND_COUNT; i++)
	{
		if (q_bind_key[i] == sc)
			q_bind_key[i] = 0;
		if (!StrICompare(q_bind_cmd[i], q_keys_cmd[row]))
			q_bind_key[i] = 0;
	}
	for (i = 0; i < QKB_KEYS; i++)
	{
		if (!StrICompare(&q_keybind[i * QKB_CMD_MAX], q_keys_cmd[row]))
			q_keybind[i * QKB_CMD_MAX] = 0;
	}

	//through the console executor, so menu and "bind" agree on every rule.
	//SEPARATE buffers: StrPrint lays down its prefix before reading %s, so
	//formatting a buffer from itself produced "bind bind ..."
	QBindKeyName(kname, sc);
	StrPrint(line, "bind %s \"%s\"", kname, q_keys_cmd[row]);
	QConExec(line, FALSE);
}

U0 QKeysDraw(CQCanvas *c)
{//M_Keys_Draw: every bindable action and the key that runs it
	U8	line[64];
	U8	keyname[24];
	I64	mx = QMenuXOfs(c);
	I64	y  = 56;
	I64	i;
	I64	r;
	I64	top;
	I64	vis;

	QMenuPlaque(c, &q_pic_p_option);

	//the list outgrew the screen, so it scrolls with the cursor as M_Keys does
	vis = (c->height - 100) / 10;
	if (vis > QKEYS_ROWS + 1)
		vis = QKEYS_ROWS + 1;
	if (vis < 4)
		vis = 4;

	top = q_keys_row - vis / 2;
	if (top > QKEYS_ROWS + 1 - vis)
		top = QKEYS_ROWS + 1 - vis;
	if (top < 0)
		top = 0;

	for (i = 0; i < vis; i++)
	{
		r = top + i;
		if (r >= QKEYS_ROWS)
			goto qkd_back;

		QBindKeyName(keyname, QKeysFindKey(r));
		StrPrint(line, "%-17s %s", q_keys_label[r], keyname);
		QStrDrawAlt(c, mx + 48, y + i * 10, line);

		if (r == q_keys_row)
		{
			if (q_keys_capture)
				QStrDrawAlt(c, mx + 32, y + i * 10, "=");
			else
				QStrDrawAlt(c, mx + 32, y + i * 10, ">");
		}

		goto qkd_next;

qkd_back:
		QStrDrawAlt(c, mx + 48, y + i * 10, "back");
		if (r == q_keys_row)
			QStrDrawAlt(c, mx + 32, y + i * 10, ">");

qkd_next:
	}

	if (q_keys_capture)
		QStrDrawCenterAlt(c, c->height - 20, "press a key, or escape to cancel");
	else
		QStrDrawCenterAlt(c, c->height - 20, "enter rebinds, escape exits");
}

Bool QKeysKey(I64 sc)
{//capture swallows the next key whole. escape is tested first or it can be
 //bound, and the way out of the menu goes with it
	I64 i;

	if (q_keys_capture)
	{
		q_keys_capture = FALSE;

		if (sc != SC_ESC && q_keys_row >= 0 && q_keys_row < QKEYS_ROWS)
		{
			QKeysBind(q_keys_row, sc);
			QCfgSave;
		}

		QMenuSound(QMSND_VALUE);
		return TRUE;
	}

	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_OPTIONS;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_keys_row--;
		if (q_keys_row < 0)
			q_keys_row = QKEYS_ROWS;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_keys_row++;
		if (q_keys_row > QKEYS_ROWS)
			q_keys_row = 0;
		return TRUE;
	}

	//M_Keys: backspace or delete unbinds the row
	if ((sc == SC_BACKSPACE || sc == SC_DELETE) &&
		q_keys_row >= 0 && q_keys_row < QKEYS_ROWS)
	{
		QMenuSound(QMSND_VALUE);
		QKeysUnbind(q_keys_row);
		QCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//the row past the last binding is back
		if (q_keys_row >= QKEYS_ROWS)
		{
			QMenuSound(QMSND_MOVE);
			q_menu_page = QPAGE_OPTIONS;
			return TRUE;
		}

		QMenuSound(QMSND_ENTER);
		q_keys_capture = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 QNoticeDraw(CQCanvas *c)
{//plain message page, for what the shareware build cannot offer
	QMenuBackdrop(c);

	QStrDrawCenterAlt(c, 90, q_notice);
	QStrDrawCenterAlt(c, c->height - 20, "press enter or escape");
}

U0 QHelpDraw(CQCanvas *c)
{//M_Help_Draw: one full-screen picture per page
	CQPic *p = &q_pic_help[q_help_page];

	QMenuBackdrop(c);

	//authored at 320x200, centred in the virtual box rather than stretched
	if (p->pixels)
		QPicDraw(c, p, QMenuXOfs(c) + (QMENU_VW - p->width) / 2, 4);
	else
		QStrDrawCenterAlt(c, 90, "help pages not found in pak");

	QStrDrawCenterAlt(c, c->height - 20, "left/right pages, escape exits");
}

Bool QHelpKey(I64 sc)
{
	if (sc == SC_CURSOR_LEFT)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page--;
		if (q_help_page < 0)
			q_help_page = QHELP_PAGES - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_RIGHT || sc == SC_ENTER)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page++;
		if (q_help_page >= QHELP_PAGES)
			q_help_page = 0;
		return TRUE;
	}

	return FALSE;
}

U0 QLanDraw(CQCanvas *c)
{//M_LanConfig_Draw: title, address field, JOIN row
	U8	line[64];
	I64	mx = QMenuXOfs(c);
	I64	y  = 56;
	I64	i;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawCenterAlt(c, 40, "join game - tcp/ip");

	QStrDrawAlt(c, mx + 56, y, "address");

	//plain field. M_DrawTextBox would need the gfx/box_*.lmp tiles assembled
	if (q_lan_editing)
		StrPrint(line, "%s_", q_lan_addr);
	else
		StrPrint(line, "%s", q_lan_addr);

	QStrDrawAlt(c, mx + 144, y, line);

	QStrDrawAlt(c, mx + 56, y + 24, "search for local games");
	QStrDrawAlt(c, mx + 56, y + 40, "join game");
	QStrDrawAlt(c, mx + 56, y + 56, "back");

	if (q_lan_row == QLAN_ADDRESS)		QMenuCursor(c, mx + 40, y - 4);
	else if (q_lan_row == QLAN_SEARCH)	QMenuCursor(c, mx + 40, y + 20);
	else if (q_lan_row == QLAN_JOIN)	QMenuCursor(c, mx + 40, y + 36);
	else								QMenuCursor(c, mx + 40, y + 52);

	//M_Slist_Draw. replies land asynchronously, so the list is whatever has
	//arrived so far - picking one copies it into the address field
	if (QNetSlistSearching)
		QStrDrawAlt(c, mx + 56, y + 80, "searching...");
	else if (q_slist_count < 1 && q_slist_asked)
		QStrDrawAlt(c, mx + 56, y + 80, "no servers found");

	for (i = 0; i < q_slist_count && i < 6; i++)
	{
		StrPrint(line, "%d %-16s %s %d/%d", i + 1,
			q_slist[i].name, q_slist[i].map,
			q_slist[i].players, q_slist[i].max_players);
		QStrDrawAlt(c, mx + 56, y + 96 + i * 10, line);
	}

	if (q_slist_count > 0)
		QStrDrawCenterAlt(c, c->height - 30,
			"number key copies that server's address");

	if (q_lan_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type the address, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "enter selects, escape returns");
}

U0 QLanInput()
{//digits and dots only, so the field can't hold what the parser rejects
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_lan_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];

		if ((ch >= '0' && ch <= '9') || ch == '.')
		{
			sc = Char2ScanCode(ch);

			if (QConKeyEdge(sc) && q_lan_len < 23)
			{
				q_lan_addr[q_lan_len] = ch;
				q_lan_len++;
				q_lan_addr[q_lan_len] = 0;
			}
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_lan_len > 0)
	{
		q_lan_len--;
		q_lan_addr[q_lan_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_lan_editing   = FALSE;
		q_lan_ate_enter = TRUE;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QLanKey(I64 sc)
{
	I64 i;
	I64 n;

	if (q_lan_editing)
		return TRUE;

	//the ENTER that ended editing must not be seen twice or the field reopens
	if (q_lan_ate_enter)
	{
		q_lan_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	//1..6 join that server outright - the original's slist is a list you pick
	//from, not a way to fill in a text field
	i = -1;
	for (n = 0; n < 6; n++)
	{
		if (sc == Char2ScanCode('1' + n))
			i = n;
	}

	if (i >= 0)
	{
		if (i < q_slist_count)
		{
			//join the U32 it ANSWERED FROM. the printable form is for the
			//list only - formatting an address and parsing it back is two
			//more places for a join to fail than there need to be
			QStrCopy(q_lan_addr, q_slist[i].addr, 24);
			q_lan_len = StrLen(q_lan_addr);
			QMenuSound(QMSND_ENTER);
			QConConnectIP(q_slist[i].ip);
			q_menu_page = QPAGE_MAIN;
		}
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row--;
		if (q_lan_row < 0)
			q_lan_row = QLAN_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row++;
		if (q_lan_row >= QLAN_ROWS)
			q_lan_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_lan_row == QLAN_ADDRESS)
		{
			q_lan_editing = TRUE;
			q_lan_len     = StrLen(q_lan_addr);
		}
		else if (q_lan_row == QLAN_SEARCH)
		{
			//Datagram_SearchForHosts. returns at once, replies fill the table
			//over the next couple of seconds
			QNetSlistBroadcast;
		}
		else if (q_lan_row == QLAN_JOIN)
		{
			//straight through the connect command, one join path not two
			QConConnect(q_lan_addr);
			q_menu_page = QPAGE_MAIN;
		}
		else
			q_menu_page = QPAGE_MULTI;

		return TRUE;
	}

	return FALSE;
}

U0 QSingleDraw(CQCanvas *c)
{//M_SinglePlayer_Draw. the three rows are one image, 20 pixel pitch
	I64 mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_single);

	if (q_pic_sp_menu.pixels)
		QPicDraw(c, &q_pic_sp_menu, mx + 72, QMENU_Y);

	QMenuCursor(c, mx + 72 - 18, QMENU_Y + q_sp_row * QMENU_ROW_H - 4);
}

Bool QSingleKey(I64 sc, Bool *_start_game)
{
	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_sp_row--;
		if (q_sp_row < 0)
			q_sp_row = QSP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_sp_row++;
		if (q_sp_row >= QSP_ROWS)
			q_sp_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_sp_row == QSP_NEWGAME)
		{
			//M_SinglePlayer_Key: New Game always restarts at "start" with one
			//player. cvars first, they govern how QuakeC spawns everything
			QCvarSet("deathmatch", 0.0);
			QCvarSet("coop", 0.0);

			//svs.maxclients 1 - solo reserves one edict, as the original does
			QSvMaxClientsSet(1);

			QStrCopy(q_change_map, "start", 64);
			q_change_pending = TRUE;

			if (_start_game)
				*_start_game = TRUE;

			q_menu_page = QPAGE_MAIN;
		}
		else if (q_sp_row == QSP_LOAD)
		{
			//one slot. deferred - loading tears the world down and this runs
			//inside the menu's own frame
			q_menu_load_req = TRUE;
			q_menu_page     = QPAGE_MAIN;

			if (_start_game)
				*_start_game = TRUE;
		}
		else
		{
			//saving needs a world to save
			if (q_game_active)
			{
				q_menu_save_req = TRUE;
				q_menu_page     = QPAGE_MAIN;

				if (_start_game)
					*_start_game = TRUE;
			}
		}

		return TRUE;
	}

	return FALSE;
}

U0 QMultiDraw(CQCanvas *c)
{//M_Multiplayer_Draw. the rows are artwork, gfx/mp_menu.lmp, not console font
	I64	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_multi);

	//one image at x=72 y=32, the original's 20 pixel row pitch
	if (q_pic_mp_menu.pixels)
		QPicDraw(c, &q_pic_mp_menu, mx + 72, QMENU_Y);

	//no artwork for back, it is not one of the three baked rows
	QStrDrawAlt(c, mx + 72, QMENU_Y + 3 * QMENU_ROW_H, "back");

	QMenuCursor(c, mx + 72 - 18, QMENU_Y + q_mp_row * QMENU_ROW_H - 4);

	//join needs a UDP socket; new game runs a real deathmatch server the local
	//client reaches over loopback
	if (QNetUdpAvailable())
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game hosts on this machine");
		QStrDrawCenterAlt(c, c->height - 20, "join: console, then connect <ip>");
	}
	else
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game runs a local deathmatch");
		QStrDrawCenterAlt(c, c->height - 20, "network play: run RunNet.ZC");
	}
}

U0 QSetupDraw(CQCanvas *c)
{
	CQMdl	*preview;
	U8		 line[64];
	F64		 porg[3];
	F64		 pang[3];
	F64		 veye[3];
	F64		 vang[3];
	I64		 mx = QMenuXOfs(c);
	I64		 y  = 40;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawAlt(c, mx + 32, y, "your name");
	if (q_setup_editing)
	{
		StrPrint(line, "%s_", q_setup_name);
		QStrDrawAlt(c, mx + 32, y + 8, line);
	}
	else
		QStrDrawAlt(c, mx + 32, y + 8, q_setup_name);

	StrPrint(line, "shirt colour    %d", q_setup_top);
	QStrDrawAlt(c, mx + 32, y + 32, line);

	StrPrint(line, "trouser colour  %d", q_setup_bottom);
	QStrDrawAlt(c, mx + 32, y + 64, line);

	QStrDrawAlt(c, mx + 32, y + 72, "back");

	//the rotating player model. real world path with a synthetic camera, not a
	//sprite, so the colours are the translated skin others actually see
	preview = QMdlPreviewGet(q_setup_top, q_setup_bottom);
	if (preview)
	{
		//needs a camera and a CLEAN depth buffer - both live on the canvas and
		//still hold the last rendered frame, whose geometry would win the
		//depth test and eat the model
		QVecSet(veye, 0.0, 0.0, 0.0);
		QVecSet(vang, 0.0, 0.0, 0.0);
		QDrawSetView(c, veye, vang, 90.0);

		MemSet(c->depth, 0, c->width * c->height * sizeof(F64));

		//down +x from the eye, offset right of the text, spun by the clock
		QVecSet(porg, 76.0, -26.0, -22.0);
		QVecSet(pang, 0.0, QAngleNorm(tS * 60.0), 0.0);

		QMdlDrawAngles(c, preview, 0, porg, pang, 176);
	}

	if (q_set_row == QSET_NAME)			QStrDrawAlt(c, mx + 16, y,      ">");
	else if (q_set_row == QSET_TOP)		QStrDrawAlt(c, mx + 16, y + 32, ">");
	else if (q_set_row == QSET_BOTTOM)	QStrDrawAlt(c, mx + 16, y + 48, ">");
	else								QStrDrawAlt(c, mx + 16, y + 72, ">");

	if (q_setup_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type a name, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool QMultiKey(I64 sc)
{
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row--;
		if (q_mp_row < 0)
			q_mp_row = QMP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row++;
		if (q_mp_row >= QMP_ROWS)
			q_mp_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
		return TRUE;	//nothing on this page is a value

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_mp_row == QMP_JOIN)
		{
			if (QNetUdpAvailable())
			{
				q_menu_page = QPAGE_LANCONFIG;
				q_lan_row   = 0;
				return TRUE;
			}

			//only reachable without a net stack, the branch above returns
			QStrCopy(q_notice, "quit and run RunNet.ZC for network play", 64);
			q_menu_page = QPAGE_NOTICE;
		}
		else if (q_mp_row == QMP_NEW)
		{
			//M_Menu_Net_f: NEW GAME opens game options, it does not start
			//anything. the map, the mode and the limits are chosen there
			q_menu_page = QPAGE_GAMEOPT;
			q_go_row    = 0;

			//the page shows a mode, so one must be set. neither cvar on
			//resolves to single player and the label would be lying
			if (QCvarGet("coop") == 0.0 && QCvarGet("deathmatch") == 0.0)
			{
				QCvarSet("deathmatch", 1.0);
				QCvarSet("coop", 0.0);
			}
		}
		else if (q_mp_row == QMP_SETUP)
		{
			q_menu_page = QPAGE_SETUP;
			q_set_row   = 0;
		}
		else
			q_menu_page = QPAGE_MAIN;

		return TRUE;
	}

	return FALSE;
}

U0 QGoDraw(CQCanvas *c)
{//M_GameOptions_Draw. the values are read back off the cvars, never cached -
 //the console can set any of them behind this page
	U8	line[64];
	I64	y;
	I64	pitch;
	I64	mx;
	I64	v;

	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_multi);

	//nine rows at a 16 pitch run off a 200 row canvas and the last ones can
	//never be reached. same three steps down QOptDraw takes
	y     = 60;
	pitch = 16;

	if (y + QGO_ROWS * pitch + 24 > c->height)
	{
		y     = 40;
		pitch = 12;
	}

	if (y + QGO_ROWS * pitch + 24 > c->height)
	{
		y     = 32;
		pitch = QCHAR_H;
	}

	QStrDrawAlt(c, mx + 64, y + QGO_BEGIN * pitch, "begin game");

	StrPrint(line, "%-14s %d", "max players", q_go_maxplayers);
	QStrDrawAlt(c, mx + 64, y + QGO_MAXPLAYERS * pitch, line);

	//coop and deathmatch are never both set, so coop alone names the mode
	if (QCvarGet("coop") != 0.0)
		StrPrint(line, "%-14s %s", "game type", "cooperative");
	else
		StrPrint(line, "%-14s %s", "game type", "deathmatch");
	QStrDrawAlt(c, mx + 64, y + QGO_GAMETYPE * pitch, line);

	v = ToI64(QCvarGet("teamplay"));
	if (v == 1)
		StrPrint(line, "%-14s %s", "teamplay", "no friendly fire");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "teamplay", "friendly fire");
	else
		StrPrint(line, "%-14s %s", "teamplay", "off");
	QStrDrawAlt(c, mx + 64, y + QGO_TEAMPLAY * pitch, line);

	v = ToI64(QCvarGet("skill"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "skill", "easy");
	else if (v == 1)
		StrPrint(line, "%-14s %s", "skill", "normal");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "skill", "hard");
	else
		StrPrint(line, "%-14s %s", "skill", "nightmare");
	QStrDrawAlt(c, mx + 64, y + QGO_SKILL * pitch, line);

	//zero is off in both, not a limit of nothing
	v = ToI64(QCvarGet("fraglimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "frag limit", "none");
	else
		StrPrint(line, "%-14s %d frags", "frag limit", v);
	QStrDrawAlt(c, mx + 64, y + QGO_FRAGLIMIT * pitch, line);

	v = ToI64(QCvarGet("timelimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "time limit", "none");
	else
		StrPrint(line, "%-14s %d minutes", "time limit", v);
	QStrDrawAlt(c, mx + 64, y + QGO_TIMELIMIT * pitch, line);

	StrPrint(line, "%-14s %s", "episode", q_go_ep_name[q_go_episode]);
	QStrDrawAlt(c, mx + 64, y + QGO_EPISODE * pitch, line);

	StrPrint(line, "%-14s %s", "level",
		q_go_map[q_go_ep_first[q_go_episode] + q_go_level]);
	QStrDrawAlt(c, mx + 64, y + QGO_LEVEL * pitch, line);

	//a caret, the spinning cursor is oversized at this pitch
	QStrDrawAlt(c, mx + 48, y + q_go_row * pitch, ">");

	QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool QGoKey(I64 sc)
{//M_GameOptions_Key. every row writes its cvar as it is edited, so the world
 //is already configured by the time begin game queues the map
	I64 dir;
	I64 v;
	I64 count;

	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_page = QPAGE_MULTI;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_go_row--;
		if (q_go_row < 0)
			q_go_row = QGO_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_go_row++;
		if (q_go_row >= QGO_ROWS)
			q_go_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_NetStart_Change is never called for the begin row
		if (q_go_row == QGO_BEGIN)
			return TRUE;

		QMenuSound(QMSND_VALUE);

		dir = 1;
		if (sc == SC_CURSOR_LEFT)
			dir = -1;

		switch (q_go_row)
		{
			case QGO_MAXPLAYERS:
				//the slot table is allocated at QSV_MAX_CLIENTS before any map
				//spawns, so there is no cvar to write - this bounds the choice
				q_go_maxplayers += dir;
				if (q_go_maxplayers > QSV_MAX_CLIENTS)
					q_go_maxplayers = 2;
				if (q_go_maxplayers < 2)
					q_go_maxplayers = QSV_MAX_CLIENTS;
				break;

			case QGO_GAMETYPE:
				//MUTUALLY EXCLUSIVE. both set is a state the mode resolver
				//cannot describe, so the pair is always written together
				if (QCvarGet("coop") != 0.0)
				{
					QCvarSet("coop", 0.0);
					QCvarSet("deathmatch", 1.0);
				}
				else
				{
					QCvarSet("coop", 1.0);
					QCvarSet("deathmatch", 0.0);
				}
				break;

			case QGO_TEAMPLAY:
				v = ToI64(QCvarGet("teamplay")) + dir;
				if (v > 2)	v = 0;
				if (v < 0)	v = 2;
				QCvarSet("teamplay", ToF64(v));
				break;

			case QGO_SKILL:
				v = ToI64(QCvarGet("skill")) + dir;
				if (v > 3)	v = 0;
				if (v < 0)	v = 3;
				QCvarSet("skill", ToF64(v));
				break;

			case QGO_FRAGLIMIT:
				v = ToI64(QCvarGet("fraglimit")) + dir * 10;
				if (v > 100)	v = 0;
				if (v < 0)		v = 100;
				QCvarSet("fraglimit", ToF64(v));
				break;

			case QGO_TIMELIMIT:
				v = ToI64(QCvarGet("timelimit")) + dir * 5;
				if (v > 60)	v = 0;
				if (v < 0)	v = 60;
				QCvarSet("timelimit", ToF64(v));
				break;

			case QGO_EPISODE:
				//shareware wraps at two, which is what hides episodes 2-4,
				//end and the dm maps - their files are not on the disc
				count = QGoEpisodeCount();
				q_go_episode += dir;
				if (q_go_episode >= count)	q_go_episode = 0;
				if (q_go_episode < 0)		q_go_episode = count - 1;

				//episodes are different lengths, the old index can be past
				//the end of the new one
				q_go_level = 0;
				break;

			case QGO_LEVEL:
				count = QGoLevelCount();
				q_go_level += dir;
				if (q_go_level >= count)	q_go_level = 0;
				if (q_go_level < 0)			q_go_level = count - 1;
				break;

			default:
				break;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//only the top row does anything, the rest are left/right values
		if (q_go_row != QGO_BEGIN)
			return TRUE;

		QMenuSound(QMSND_ENTER);

		//bind so a remote client has something to reach. not fatal if it
		//fails - a listen server with nobody connected still runs
		if (QNetUdpAvailable())
		{
			//DHCP first under SLIRP, AutoIP 10.0.0.1 only without it - that
			//address is socket MP, not hostfwd
			if (!QNetLocalIP)
				QNetDhcp;
			if (!QNetLocalIP)
				QNetAutoIP(0);

			if (QNetUdpOpen(QNET_PORT_DEFAULT))
			{
				q_udp_server = TRUE;
				QNetDgrmInit;
			}
		}

		//the map must RESTART so items spawn with the mode already active.
		//q_mp_start_dm is what drops the attract loop and leaves the menu, the
		//frame loop services the pending change
		//before the changelevel: QGameInit reserves this many edicts
		QSvMaxClientsSet(q_go_maxplayers);

		QStrCopy(q_change_map,
			q_go_map[q_go_ep_first[q_go_episode] + q_go_level], 64);
		q_change_pending = TRUE;
		q_mp_start_dm    = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 QSetupInput()
{//same charset and edge detection the console uses
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_setup_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_setup_len < 15)
		{
			q_setup_name[q_setup_len] = ch;
			q_setup_len++;
			q_setup_name[q_setup_len] = 0;
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_setup_len > 0)
	{
		q_setup_len--;
		q_setup_name[q_setup_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_setup_editing = FALSE;
		q_setup_ate_enter = TRUE;
		QCfgSave;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QSetupKey(I64 sc)
{

	//while editing, every key belongs to QSetupInput, which polls the keyboard
	//directly - the shell only forwards a handful of scancodes here
	if (q_setup_editing)
		return TRUE;

	//this and QSetupInput see the same physical press, so swallow the ENTER
	//that ended editing or the row handler below re-enters it at once
	if (q_setup_ate_enter)
	{
		q_setup_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row--;
		if (q_set_row < 0)
			q_set_row = QSET_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row++;
		if (q_set_row >= QSET_ROWS)
			q_set_row = 0;
		return TRUE;
	}

	//14 colours, the colormap's player-shirt range
	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		if (q_set_row == QSET_TOP || q_set_row == QSET_BOTTOM)
		{
			QMenuSound(QMSND_VALUE);

			if (q_set_row == QSET_TOP)
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_top++;
				else						q_setup_top--;

				if (q_setup_top > 13)	q_setup_top = 0;
				if (q_setup_top < 0)	q_setup_top = 13;
			}
			else
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_bottom++;
				else						q_setup_bottom--;

				if (q_setup_bottom > 13)	q_setup_bottom = 0;
				if (q_setup_bottom < 0)		q_setup_bottom = 13;
			}

			QCfgSave;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_set_row == QSET_NAME)
		{
			q_setup_editing = TRUE;
			q_setup_len     = StrLen(q_setup_name);
		}
		else if (q_set_row == QSET_BACK)
		{
			QCfgSave;
			q_menu_page = QPAGE_MULTI;
		}

		return TRUE;
	}

	return FALSE;
}

U0 QMenuDraw(CQCanvas *c)
{//M_Main_Draw: banner, spine plaque, item block, spinning cursor
	I64 frame;
	I64 x;
	I64 y;

	if (q_menu_page == QPAGE_OPTIONS)
	{
		QOptDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_KEYS)
	{
		QKeysDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_NOTICE)
	{
		QNoticeDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_HELP)
	{
		QHelpDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_LANCONFIG)
	{
		QLanDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_SINGLE)
	{
		QSingleDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_MULTI)
	{
		QMultiDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_SETUP)
	{
		QSetupDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_GAMEOPT)
	{
		QGoDraw(c);
		return;
	}

	//dark backdrop, so the menu reads over the last rendered frame
	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, QMenuXOfs(c) + 16, 4);

	//centred in the virtual box, NOT the canvas - mix the two and the plaque
	//and the artwork drift apart as the canvas grows
	if (q_pic_ttlmain.pixels)
		QPicDraw(c, &q_pic_ttlmain,
			QMenuXOfs(c) + (QMENU_VW - q_pic_ttlmain.width) / 2, 4);

	//x=72, where the original puts the item block
	if (q_pic_mainmenu.pixels)
		QPicDraw(c, &q_pic_mainmenu, QMenuXOfs(c) + 72, QMENU_Y);

	//six frames at 10Hz
	frame = ToI64(tS * 10.0) % 6;
	x     = QMenuXOfs(c) + 72 - 18;
	y     = QMENU_Y + q_menu_row * QMENU_ROW_H - 4;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);

	if (q_menu_ingame)
		QStrDrawCenterAlt(c, c->height - 20, "ESC resumes the game");
	else
		QStrDrawCenterAlt(c, c->height - 20, "arrows move, enter selects");
}

U0 QOptPageOpen(I64 page)
{//descend into a sub-page, remembering where the caret sat on the root
	QMenuSound(QMSND_ENTER);
	q_optp_ret = q_opt_row;
	q_optp     = page;
	q_opt_row  = 0;
}

U0 QOptPageLeave()
{//a sub-page returns to the root, the root returns to the main menu
	if (q_optp == QOPTP_ROOT)
	{
		q_menu_page = QPAGE_MAIN;
		return;
	}

	q_optp    = QOPTP_ROOT;
	q_opt_row = q_optp_ret;

	if (q_opt_row >= q_optp_count[QOPTP_ROOT])
		q_opt_row = 0;
}

Bool QOptKey(I64 sc)
{//left/right adjust, enter activates, escape climbs one page
	I64 rows = q_optp_count[q_optp];
	I64 item;
	F64 sizev;

	if (q_opt_row >= rows)
		q_opt_row = 0;

	item = q_optp_item[q_optp * QOPT_PAGE_MAX + q_opt_row];

	if (sc == SC_ESC)
	{
		QMenuSound(QMSND_MOVE);
		QOptPageLeave;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row--;
		if (q_opt_row < 0)
			q_opt_row = rows - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row++;
		if (q_opt_row >= rows)
			q_opt_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_AdjustSliders plays this once per value change
		QMenuSound(QMSND_VALUE);

		switch (item)
		{
			case QOPT_SCRSIZE:
				//SCR_SizeUp_f / SCR_SizeDown_f: 10 at a time, 30..120
				if (sc == SC_CURSOR_LEFT)
					QCvarSet("viewsize", QCvarGet("viewsize") - 10.0);
				else
					QCvarSet("viewsize", QCvarGet("viewsize") + 10.0);

				if (QCvarGet("viewsize") < 30.0)
					QCvarSet("viewsize", 30.0);
				if (QCvarGet("viewsize") > 130.0)
					QCvarSet("viewsize", 130.0);
				break;

			case QOPT_ALWAYSRUN:
				//M_AdjustSliders moves the speed cvars together
				if (QCvarGet("cl_forwardspeed") > 200.0)
				{
					QCvarSet("cl_forwardspeed", 200.0);
					QCvarSet("cl_backspeed", 200.0);
				}
				else
				{
					QCvarSet("cl_forwardspeed", 400.0);
					QCvarSet("cl_backspeed", 400.0);
				}
				break;

			case QOPT_INVERT:
				//invert is the sign of m_pitch, not a separate flag
				QCvarSet("m_pitch", -QCvarGet("m_pitch"));
				break;

			case QOPT_SENS:
				if (sc == SC_CURSOR_LEFT)
					q_opt_sensitivity -= 0.02;
				else
					q_opt_sensitivity += 0.02;

				if (q_opt_sensitivity < 0.02)
					q_opt_sensitivity = 0.02;
				if (q_opt_sensitivity > 0.60)
					q_opt_sensitivity = 0.60;
				break;

			case QOPT_VOLUME:
				if (sc == SC_CURSOR_LEFT)
					q_opt_volume -= 10;
				else
					q_opt_volume += 10;

				q_opt_volume = ClampI64(q_opt_volume, 0, 100);
				q_snd_master = ToF64(q_opt_volume) / 100.0;
				break;

			//V_Crosshair_f gives the cvar THREE meanings, not two:
			//    !value   none
			//    == 1     '+', the standard Quake crosshair
			//    > 1      15, the dot
			//so the row cycles 0, 1, 2. negative values are a mod picking a
			//console glyph per weapon and are not reachable from here
			case QOPT_CROSSHAIR:
				q_opt_crosshair = ToI64(QCvarGet("crosshair"));

				if (sc == SC_CURSOR_LEFT)
					q_opt_crosshair--;
				else
					q_opt_crosshair++;

				if (q_opt_crosshair < 0)	q_opt_crosshair = 2;
				if (q_opt_crosshair > 2)	q_opt_crosshair = 0;

				QCvarSet("crosshair", ToF64(q_opt_crosshair));
				break;

			case QOPT_MUSICVOL:
				//bgmvolume, applied to the running track so the slider is
				//audible while it moves
				if (sc == SC_CURSOR_LEFT)
					q_music_volume -= 0.1;
				else
					q_music_volume += 0.1;

				if (q_music_volume < 0.0)
					q_music_volume = 0.0;
				if (q_music_volume > 1.0)
					q_music_volume = 1.0;

				QMusicApplyVolume;
				break;

			case QOPT_RES:
				if (sc == SC_CURSOR_LEFT)
					q_opt_res--;
				else
					q_opt_res++;

				q_opt_res = ClampI64(q_opt_res, 0, QRES_COUNT - 1);

				//can't reallocate the render target here, the compositor may
				//be mid-blit. the app rebuilds between frames on this flag
				q_res_dirty = TRUE;
				break;

			case QOPT_FULLSCREEN:
				q_opt_fullscreen = !q_opt_fullscreen;
				q_res_dirty      = TRUE;
				break;

			case QOPT_COLOR:
				q_opt_truecolor = !q_opt_truecolor;
				QRGBUpdateActive;
				//the overlay plane is allocated with the canvas
				q_res_dirty = TRUE;
				break;

			case QOPT_FOG:
				q_opt_fog = !q_opt_fog;
				break;

			case QOPT_RGBMIPS:
				q_opt_rgbmips = !q_opt_rgbmips;
				//chains are built at map load
				QConPrint("rgb mipmaps apply on next map load");
				break;

			case QOPT_HUDSTYLE:
				//sb_lines changes with it, so the view resizes next frame
				if (sc == SC_CURSOR_LEFT)
					q_opt_hudstyle--;
				else
					q_opt_hudstyle++;

				if (q_opt_hudstyle < 0)
					q_opt_hudstyle = QHUD_STYLES - 1;
				if (q_opt_hudstyle >= QHUD_STYLES)
					q_opt_hudstyle = 0;
				QCvarSet("hudstyle", ToF64(q_opt_hudstyle));
				break;

			case QOPT_HUDSCALE:
				if (sc == SC_CURSOR_LEFT)
					q_opt_hudscale--;
				else
					q_opt_hudscale++;

				q_opt_hudscale = ClampI64(q_opt_hudscale, 0, 8);
				break;

			//scr_sbaralpha 1 is opaque; the slider shows transparency, so
			//right increases it and the stored value goes DOWN
			case QOPT_SBALPHA:
				if (sc == SC_CURSOR_LEFT)
					q_opt_sbaralpha += 26;
				else
					q_opt_sbaralpha -= 26;

				q_opt_sbaralpha = ClampI64(q_opt_sbaralpha, 0, 255);
				QCvarSet("scr_sbaralpha",
					ToF64(q_opt_sbaralpha) / 255.0);
				break;

			case QOPT_PROGMIPS:
				q_prog_mips = !q_prog_mips;
				QCvarSet("r_progmips", ToF64(q_prog_mips));
				break;

			case QOPT_MDLWARP:
				q_mdl_warp = !q_mdl_warp;
				QCvarSet("r_softemu_mdl_warp", ToF64(q_mdl_warp));
				break;

			case QOPT_ANIMLERP:
				q_lerp_models = !q_lerp_models;
				QCvarSet("r_lerpmodels", ToF64(q_lerp_models));
				break;

			case QOPT_MIPMAP:
				if (sc == SC_CURSOR_LEFT)
					q_mipscale -= 0.25;
				else
					q_mipscale += 0.25;

				if (q_mipscale < 0.0)	q_mipscale = 0.0;
				if (q_mipscale > 4.0)	q_mipscale = 4.0;

				QCvarSet("d_mipscale", q_mipscale);
				QSurfCacheFlush;
				break;

			case QOPT_CONTRAST:
				if (sc == SC_CURSOR_LEFT)
					sizev = q_contrast - 0.05;
				else
					sizev = q_contrast + 0.05;

				QPalSetContrast(sizev);
				QCvarSet("contrast", q_contrast);
				break;

			case QOPT_SHOWFPS:
				q_opt_fps = !q_opt_fps;
				QCvarSet("scr_showfps", ToF64(q_opt_fps));
				break;

			case QOPT_SHOWSPEED:
				if (QCvarGet("scr_showspeed") != 0.0)
					QCvarSet("scr_showspeed", 0.0);
				else
					QCvarSet("scr_showspeed", 1.0);
				break;

			//SCR_CalcRefdef bounds fov at 10..170. the shell owns q_fov, so
			//the change is requested the way the console requests it
			case QOPT_FOV:
				sizev = QCvarGet("scr_fov");
				if (sc == SC_CURSOR_LEFT)
					sizev -= 5.0;
				else
					sizev += 5.0;

				if (sizev < 10.0)	sizev = 10.0;
				if (sizev > 170.0)	sizev = 170.0;

				QCvarSet("scr_fov", sizev);
				QCvarSet("fov", sizev);
				q_con_fov_want = sizev;
				break;

			case QOPT_CACHEMB:
				//doubling steps, 64MB..4GB. lowering trims on the next build
				if (sc == SC_CURSOR_LEFT)
					q_surf_budget = q_surf_budget / 2;
				else
					q_surf_budget = q_surf_budget * 2;

				if (q_surf_budget < 67108864)
					q_surf_budget = 67108864;
				if (q_surf_budget > 4294967296)
					q_surf_budget = 4294967296;
				break;

			case QOPT_LITRGB:
				//in the cache key, so surfaces rebuild themselves
				q_opt_litrgb = !q_opt_litrgb;
				break;

			case QOPT_EXTTEX:
				q_opt_exttex = !q_opt_exttex;
				//loaded at map load, so this lands on the next one
				QConPrint("hi-res textures apply on next map load");
				break;

			case QOPT_TEXFILTER:
				//folded into the surface cache key, so it rebuilds itself
				q_opt_texfilter = !q_opt_texfilter;
				break;

			case QOPT_TCLIGHT:
				//cached surfaces rebuild themselves when the plane they were
				//built with no longer matches
				q_opt_tclight = !q_opt_tclight;
				QRGBUpdateActive;
				break;

			case QOPT_GAMMA:
				//left darkens and shrinks the bar. M_AdjustSliders does
				//gamma -= dir * 0.05 with dir -1 for left, so left raises the
				//exponent; the bar shows (max - gamma), so both track
				if (sc == SC_CURSOR_LEFT)
					q_opt_gamma += 0.05;
				else
					q_opt_gamma -= 0.05;

				if (q_opt_gamma < QGAMMA_MIN)
					q_opt_gamma = QGAMMA_MIN;
				if (q_opt_gamma > QGAMMA_MAX)
					q_opt_gamma = QGAMMA_MAX;

				QPalSetGamma(q_opt_gamma);
				break;

			case QOPT_GUNCLIP:
				q_opt_gunclip = !q_opt_gunclip;
				break;

			default:
				break;
		}

		//written straight out, there is no apply step
		QCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		if (item == QOPT_P_VIDEO)
			QOptPageOpen(QOPTP_VIDEO);
		else if (item == QOPT_P_GFX)
			QOptPageOpen(QOPTP_GFX);
		else if (item == QOPT_P_CTRL)
			QOptPageOpen(QOPTP_CTRL);
		else if (item == QOPT_P_SOUND)
			QOptPageOpen(QOPTP_SOUND);
		else if (item == QOPT_P_IFACE)
			QOptPageOpen(QOPTP_IFACE);
		else if (item == QOPT_BACK)
		{
			QMenuSound(QMSND_ENTER);
			QOptPageLeave;
		}
		else if (item == QOPT_CUSTOMIZE)
		{
			QMenuSound(QMSND_ENTER);
			q_keys_row     = 0;
			q_keys_capture = FALSE;
			q_menu_page    = QPAGE_KEYS;
		}
		else if (item == QOPT_RESET)
		{
			QMenuSound(QMSND_ENTER);
			QOptResetDefaults;
		}

		return TRUE;
	}

	return FALSE;
}

Bool QMenuKey(I64 sc, Bool *_start_game)
{//M_Keydown. TRUE when the key was consumed
	*_start_game = FALSE;

	if (q_menu_page == QPAGE_NOTICE)
	{
		if (sc == SC_ENTER)
		{
			QMenuSound(QMSND_ENTER);
			q_menu_page = QPAGE_MAIN;
			return TRUE;
		}
		return FALSE;
	}

	if (q_menu_page == QPAGE_OPTIONS)
		return QOptKey(sc);

	if (q_menu_page == QPAGE_KEYS)
		return QKeysKey(sc);

	if (q_menu_page == QPAGE_HELP)
		return QHelpKey(sc);

	if (q_menu_page == QPAGE_LANCONFIG)
		return QLanKey(sc);

	if (q_menu_page == QPAGE_SINGLE)
		return QSingleKey(sc, _start_game);

	if (q_menu_page == QPAGE_MULTI)
		return QMultiKey(sc);

	if (q_menu_page == QPAGE_SETUP)
		return QSetupKey(sc);

	if (q_menu_page == QPAGE_GAMEOPT)
		return QGoKey(sc);

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row--;
		if (q_menu_row < 0)
			q_menu_row = QMENU_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row++;
		if (q_menu_row >= QMENU_ROWS)
			q_menu_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		switch (q_menu_row)
		{
			case QMENU_SINGLE:
				//M_Menu_SinglePlayer_f opens a page, it does not drop straight
				//into the world - save and load live on it
				q_menu_page = QPAGE_SINGLE;
				q_sp_row    = 0;
				break;

			case QMENU_OPTIONS:
				q_menu_page = QPAGE_OPTIONS;
				q_optp      = QOPTP_ROOT;
				q_opt_row   = 0;
				break;

			case QMENU_MULTI:
				q_menu_page = QPAGE_MULTI;
				q_mp_row    = 0;
				break;

			case QMENU_HELP:
				//the real help/ordering screens, not an invented caption
				q_menu_page = QPAGE_HELP;
				q_help_page = 0;
				break;

			case QMENU_QUIT:
				q_quit_request = TRUE;
				break;

			default:
				break;
		}
		return TRUE;
	}

	return FALSE;
}
