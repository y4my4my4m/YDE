I64 QGoEpisodeCount()
{//M_GameOptions_Key's own count: 7 registered, 2 otherwise. episodes 2-4, end
 //and the dm maps are all PAK1, so shareware reaches start and episode 1 only
	if (QCvarGet("registered") != 0.0)
		return QGO_EPISODES;

	return 2;
}

I64 QGoLevelCount()
{//levels in the selected episode, never zero
	return q_go_ep_count[q_go_episode];
}

I64		q_set_row		= 0;

//player identity, the original's name and color client commands. held here
//and published on the wire at signon
U8		q_setup_name[16];

//COM_AddGameDirectory's target, empty means id1 only
U8		q_game_dir[32];
I64		q_setup_top		= 0;	//shirt, 0-13
I64		q_setup_bottom	= 0;	//trousers, 0-13
Bool	q_setup_editing	= FALSE;
Bool	q_setup_ate_enter = FALSE;

//join page address field
I64		q_lan_row		= 0;
U8		q_lan_addr[24];
