// the engine services QuakeC calls into.

//qbj3_hcm has 2934 inline submodels, all of which precache as "*N".
#define QBI_MAX_PRECACHE	4096

//NOTE: must be a function. ZealC #define substitutes a bare token only, so a

CQMap	*q_bi_map		= NULL;		//set by the app before the VM runs
Bool	 q_bi_dprint	= FALSE;	//dprint is noisy, off by default

//globals aren't zeroed, and the precache free walks every slot - garbage here
U8		*q_precache_model[QBI_MAX_PRECACHE];

//backing store for the world entry and its "*N" submodel names - the precache
U8		 q_world_model_name[96];
U8		 q_submodel_names[QBI_MAX_PRECACHE * 8];
CQMdl	*q_precache_mdl[QBI_MAX_PRECACHE];
CQMap	*q_precache_bsp[QBI_MAX_PRECACHE];	//external .bsp models
CQSpr	*q_precache_spr[QBI_MAX_PRECACHE];	//.spr sprite models
I64		 q_precache_model_count = 0;
U8		*q_precache_sound[QBI_MAX_PRECACHE];
I64		 q_precache_sound_count = 0;

//trace result globals, resolved by name at init
I64 q_ofs_trace_allsolid	= -1;
I64 q_ofs_trace_startsolid	= -1;
I64 q_ofs_trace_fraction	= -1;
I64 q_ofs_trace_endpos		= -1;
I64 q_ofs_trace_plane_normal = -1;
I64 q_ofs_trace_plane_dist	= -1;
I64 q_ofs_trace_ent			= -1;
I64 q_ofs_trace_inopen		= -1;
I64 q_ofs_trace_inwater		= -1;

U8 q_bi_err_line[256];


#define QCVAR_MAX	192		//mods declare dozens of autocvars

class CQCvar
{
	U8	name[32];
	F64	value;
};

CQCvar	q_cvars[QCVAR_MAX];
I64		q_cvar_count = 0;

U0 QCvarDefine(U8 *name, F64 value)
{
	if (q_cvar_count >= QCVAR_MAX)
		return;

	QStrCopy(q_cvars[q_cvar_count].name, name, 32);
	q_cvars[q_cvar_count].value = value;
	q_cvar_count++;
}

I64 QCvarIndex(U8 *name)
{
	I64 i;

	for (i = 0; i < q_cvar_count; i++)
		if (!StrICompare(q_cvars[i].name, name))
			return i;

	return -1;
}

F64 QCvarGet(U8 *name)
{//unknown names read as 0, as Cvar_VariableValue does
	I64 i = QCvarIndex(name);

	if (i < 0)
		return 0.0;

	return q_cvars[i].value;
}

//autocvar_<name> globals mirror the cvar <name>: the QC reads its global, the
#define QAUTOCVAR_MAX	128
I64	q_autocvar_ofs[QAUTOCVAR_MAX];		//global cell of the autocvar_ float
I64	q_autocvar_cvar[QAUTOCVAR_MAX];		//index into q_cvars
I64	q_autocvar_count = 0;

U0 QCvarSet(U8 *name, F64 value)
{//an unknown name is created, as Cvar_Set does for cvar_set from progs
	I64 i = QCvarIndex(name);
	I64 j;

	if (i < 0)
	{
		QCvarDefine(name, value);
		i = q_cvar_count - 1;
	}
	else
		q_cvars[i].value = value;

	for (j = 0; j < q_autocvar_count; j++)
		if (q_autocvar_cvar[j] == i)
			QPrSetF(q_autocvar_ofs[j], value);
}

U0 QAutoCvarScan()
{//register every float global named autocvar_<name> as cvar <name>
	I64	 i;
	I64	 idx;
	I64	 type;
	U8	*n;
	U8	 line[96];

	q_autocvar_count = 0;

	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		n = QPrStr(q_pr_globaldefs[i].name);
		if (StrNCompare(n, "autocvar_", 9))
			goto qac_next;

		//DEF_SAVEGLOBAL rides bit 15; ev_float is 2. vectors and strings are
		type = q_pr_globaldefs[i].type & 0x7FFF;
		if (type != 2)
			goto qac_next;

		if (q_autocvar_count >= QAUTOCVAR_MAX)
			return;

		idx = QCvarIndex(n + 9);
		if (idx < 0)
		{
			QCvarDefine(n + 9, QPrGetF(q_pr_globaldefs[i].ofs));
			idx = q_cvar_count - 1;
		}
		else
			QPrSetF(q_pr_globaldefs[i].ofs, q_cvars[idx].value);

		q_autocvar_ofs[q_autocvar_count]  = q_pr_globaldefs[i].ofs;
		q_autocvar_cvar[q_autocvar_count] = idx;
		q_autocvar_count++;

qac_next:
	}

	if (q_autocvar_count)
	{
		StrPrint(line, "QGame: %d autocvars registered\n", q_autocvar_count);
		QLog(line);
	}
}

