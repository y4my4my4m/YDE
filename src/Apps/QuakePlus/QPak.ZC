// QPak.ZC - PAK archives + COM_LoadFile search path
//
// header: "PACK", dir offset, dir length. dir entry is 64 bytes -
// 56-byte NUL-padded path, i32 offset, i32 size.
//
// whole archive stays resident (PAK0 is ~18MB) - ZealOS FileRead has no
// seek, so lookups hand back interior pointers instead of copying
//
// search order (Ironwail COM_FindFile intent):
//   mod paks (newest first) → mod loose → id1 paks → id1 loose
// within one gamedir, a pak beats a loose file of the same name

#define QPAK_MAX_PAKS		16
#define QCOM_MAX_LOOSE		4096
#define QCOM_BASE			"::/Apps/QuakePlus"

//COM_AddGameDirectory target. empty = id1 only. owned here so QPakLoad can
//see it (QMenu / Quake compile later)
U8	q_game_dir[32];

//TRUE once the archives for q_game_dir are mounted. the config's "game" line
//is startup state: applying it after a live "game <dir>" switch overwrites the
//new dir with the old one, and the save at the switch's tail writes the old
//name back, reverting the switch
Bool q_pak_game_mounted = FALSE;

class CQPakEntry
{
	U8	name[56];
	I64	offset;
	I64	size;
};

class CQPak
{
	U8			*data;
	I64			 data_size;
	CQPakEntry	*files;
	I64			 num_files;
	U8			 gamedir[32];
};

//loose FileRead blobs kept until unmount so QPakData can return borrowed ptrs
class CQComLoose
{
	U8	*data;
	I64	 size;
	U8	 name[64];
	U8	 gamedir[32];
};

CQPak		*qpaks[QPAK_MAX_PAKS];
I64			 qpak_count = 0;
CQComLoose	 q_com_loose[QCOM_MAX_LOOSE];
I64			 q_com_loose_count = 0;

U0 QPakInit()
{//globals aren't zeroed
	I64 i;

	qpak_count = 0;
	q_com_loose_count = 0;
	q_game_dir[0] = 0;
	for (i = 0; i < QPAK_MAX_PAKS; i++)
		qpaks[i] = NULL;
	for (i = 0; i < QCOM_MAX_LOOSE; i++)
	{
		q_com_loose[i].data = NULL;
		q_com_loose[i].size = 0;
		q_com_loose[i].name[0] = 0;
		q_com_loose[i].gamedir[0] = 0;
	}
}

Bool QPakMount(U8 *filename, U8 *gamedir)
{//index one archive, later mounts win on lookup within that gamedir
	CQPak		*pak;
	CQPakEntry	*e;
	U8			*d;
	U8			*rec;
	I64			 size = 0;
	I64			 dir_offset;
	I64			 dir_length;
	I64			 count;
	I64			 i;

	if (qpak_count >= QPAK_MAX_PAKS)
	{
		"QPak: too many archives mounted\n";
		return FALSE;
	}

	d = FileRead(filename, &size);
	if (!d)
	{
		"QPak: cannot read %s\n", filename;
		return FALSE;
	}

	if (size < 12 || d[0] != 'P' || d[1] != 'A' || d[2] != 'C' || d[3] != 'K')
	{
		"QPak: %s is not a PACK archive\n", filename;
		Free(d);
		return FALSE;
	}

	dir_offset = QRdI32(d + 4);
	dir_length = QRdI32(d + 8);
	count      = dir_length / 64;

	if (dir_offset < 0 || dir_length < 0 || dir_offset + dir_length > size)
	{
		"QPak: %s has a corrupt directory\n", filename;
		Free(d);
		return FALSE;
	}

	pak				= CAlloc(sizeof(CQPak));
	pak->data		= d;
	pak->data_size	= size;
	pak->num_files	= count;
	pak->files		= CAlloc(count * sizeof(CQPakEntry));
	if (gamedir)
		QStrCopy(pak->gamedir, gamedir, 32);
	else
		pak->gamedir[0] = 0;

	for (i = 0; i < count; i++)
	{
		rec = d + dir_offset + i * 64;
		e   = &pak->files[i];
		QRdName(rec, e->name, 56);
		e->offset = QRdI32(rec + 56);
		e->size   = QRdI32(rec + 60);
	}

	qpaks[qpak_count] = pak;
	qpak_count++;

	"QPak: mounted %s (%d files, %d bytes)\n", filename, count, size;

	return TRUE;
}

U0 QComLooseFreeAll()
{
	I64 i;

	for (i = 0; i < q_com_loose_count; i++)
	{
		if (q_com_loose[i].data)
			Free(q_com_loose[i].data);
		q_com_loose[i].data = NULL;
		q_com_loose[i].size = 0;
		q_com_loose[i].name[0] = 0;
		q_com_loose[i].gamedir[0] = 0;
	}
	q_com_loose_count = 0;
}

U0 QPakUnmountAll()
{//release every archive and sticky loose blob. lookups hand back interior
 //pointers, so nothing may still hold one when this runs
	CQPak	*pak;
	I64		 i;

	for (i = 0; i < QPAK_MAX_PAKS; i++)
	{
		pak = qpaks[i];
		qpaks[i] = NULL;

		if (!pak)
			goto qpu_next;

		if (pak->files)
			Free(pak->files);
		if (pak->data)
			Free(pak->data);

		Free(pak);

qpu_next:
	}

	qpak_count = 0;
	QComLooseFreeAll;
}

CQPakEntry *QPakFindInDir(U8 *name, U8 *gamedir, CQPak **_pak)
{//newest pak that belongs to gamedir first
	CQPak		*pak;
	CQPakEntry	*e;
	I64			 p;
	I64			 i;

	for (p = qpak_count - 1; p >= 0; p--)
	{
		pak = qpaks[p];
		if (!pak)
			goto qfid_next;
		if (StrICompare(pak->gamedir, gamedir))
			goto qfid_next;

		for (i = 0; i < pak->num_files; i++)
		{
			e = &pak->files[i];
			if (!StrICompare(e->name, name))
			{
				if (_pak)
					*_pak = pak;
				return e;
			}
		}

qfid_next:
	}

	if (_pak)
		*_pak = NULL;
	return NULL;
}

U8 *QComLooseReadOwned(U8 *gamedir, U8 *name, I64 *_size)
{//FileRead copy with trailing NUL, caller Frees. no sticky cache
	U8	 path[256];
	U8	*d;
	U8	*dst;
	I64	 size = 0;
	Bool found;
	Bool was_silent;

	StrPrint(path, "%s/%s/%s", QCOM_BASE, gamedir, name);

	//a miss is the normal case - the asset lives in a pak, or in id1 rather
	//than the gamedir. Name2ParentDirClus PrintErrs the first absent path
	//component, so an unprobed lookup floods the console with "progs"
	was_silent = Silent(ON);
	found      = ToBool(FileFind(path));
	Silent(was_silent);

	if (!found)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	d = FileRead(path, &size);
	if (!d)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	dst = MAlloc(size + 1);
	MemCopy(dst, d, size);
	dst[size] = 0;
	Free(d);

	if (_size)
		*_size = size;
	return dst;
}

U8 *QComLooseGet(U8 *gamedir, U8 *name, I64 *_size)
{//FileRead into sticky cache, or return an existing entry
	U8	 path[256];
	U8	*d;
	I64	 size = 0;
	I64	 i;
	Bool found;
	Bool was_silent;

	for (i = 0; i < q_com_loose_count; i++)
	{
		if (!StrICompare(q_com_loose[i].gamedir, gamedir) &&
			!StrICompare(q_com_loose[i].name, name))
		{
			if (_size)
				*_size = q_com_loose[i].size;
			return q_com_loose[i].data;
		}
	}

	StrPrint(path, "%s/%s/%s", QCOM_BASE, gamedir, name);

	//see QComLooseReadOwned - the probe is silenced, a miss is expected
	was_silent = Silent(ON);
	found      = ToBool(FileFind(path));
	Silent(was_silent);

	if (!found)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	d = FileRead(path, &size);
	if (!d)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	if (q_com_loose_count >= QCOM_MAX_LOOSE)
	{
		//still hand back the bytes - QPakData needs a stable pointer, so this
		//path leaks until unmount. better than dropping the asset
		"QPak: loose cache full, leaking %s\n", path;
		if (_size)
			*_size = size;
		return d;
	}

	i = q_com_loose_count;
	q_com_loose_count++;
	q_com_loose[i].data = d;
	q_com_loose[i].size = size;
	QStrCopy(q_com_loose[i].name, name, 64);
	QStrCopy(q_com_loose[i].gamedir, gamedir, 32);

	if (_size)
		*_size = size;
	return d;
}

U8 *QPakData(U8 *name, I64 *_size = NULL)
{//borrowed pointer - pak interior or sticky loose blob. do not Free
	CQPak		*pak = NULL;
	CQPakEntry	*e;
	U8			*src;
	I64			 size = 0;

	if (q_game_dir[0])
	{
		e = QPakFindInDir(name, q_game_dir, &pak);
		if (e && pak)
		{
			if (e->offset < 0 || e->offset + e->size > pak->data_size)
			{
				"QPak: %s has an out-of-range extent\n", name;
				if (_size)
					*_size = 0;
				return NULL;
			}
			if (_size)
				*_size = e->size;
			return pak->data + e->offset;
		}

		src = QComLooseGet(q_game_dir, name, &size);
		if (src)
		{
			if (_size)
				*_size = size;
			return src;
		}
	}

	e = QPakFindInDir(name, "id1", &pak);
	if (e && pak)
	{
		if (e->offset < 0 || e->offset + e->size > pak->data_size)
		{
			"QPak: %s has an out-of-range extent\n", name;
			if (_size)
				*_size = 0;
			return NULL;
		}
		if (_size)
			*_size = e->size;
		return pak->data + e->offset;
	}

	src = QComLooseGet("id1", name, &size);
	if (src)
	{
		if (_size)
			*_size = size;
		return src;
	}

	if (_size)
		*_size = 0;
	return NULL;
}

CQPakEntry *QPakFind(U8 *name, CQPak **_pak = NULL)
{//compat: first match in COM order that lives in a pak (not loose)
	CQPakEntry *e;

	if (q_game_dir[0])
	{
		e = QPakFindInDir(name, q_game_dir, _pak);
		if (e)
			return e;
	}

	return QPakFindInDir(name, "id1", _pak);
}

U8 *QPakLoad(U8 *name, I64 *_size = NULL)
{//owned copy, caller Frees. COM_LoadFile
 //
 //loose files FileRead directly - sharing the sticky QPakData cache lets its
 //entry cap drop maps/models/sprites once the cache fills
	CQPak		*pak = NULL;
	CQPakEntry	*e;
	U8			*src;
	U8			*dst;
	I64			 size = 0;

	if (q_game_dir[0])
	{
		e = QPakFindInDir(name, q_game_dir, &pak);
		if (e && pak)
		{
			if (e->offset < 0 || e->offset + e->size > pak->data_size)
			{
				if (_size)
					*_size = 0;
				return NULL;
			}
			size = e->size;
			src  = pak->data + e->offset;
			dst  = MAlloc(size + 1);
			MemCopy(dst, src, size);
			dst[size] = 0;
			if (_size)
				*_size = size;
			return dst;
		}

		dst = QComLooseReadOwned(q_game_dir, name, &size);
		if (dst)
		{
			if (_size)
				*_size = size;
			return dst;
		}
	}

	e = QPakFindInDir(name, "id1", &pak);
	if (e && pak)
	{
		if (e->offset < 0 || e->offset + e->size > pak->data_size)
		{
			if (_size)
				*_size = 0;
			return NULL;
		}
		size = e->size;
		src  = pak->data + e->offset;
		dst  = MAlloc(size + 1);
		MemCopy(dst, src, size);
		dst[size] = 0;
		if (_size)
			*_size = size;
		return dst;
	}

	dst = QComLooseReadOwned("id1", name, &size);
	if (dst)
	{
		if (_size)
			*_size = size;
		return dst;
	}

	if (_size)
		*_size = 0;
	return NULL;
}

U0 QPakList(U8 *prefix = NULL)
{//debug, dump dir filtered by path prefix
	CQPak		*pak;
	CQPakEntry	*e;
	I64			 p;
	I64			 i;
	I64			 n = 0;

	for (p = 0; p < qpak_count; p++)
	{
		pak = qpaks[p];
		if (pak)
		{
			for (i = 0; i < pak->num_files; i++)
			{
				e = &pak->files[i];
				if (!prefix || !StrNCompare(e->name, prefix, StrLen(prefix)))
				{
					"  %-40s %8d\n", e->name, e->size;
					n++;
				}
			}
		}
	}

	"QPak: %d entries listed\n", n;
}
