// QPak.ZC - id PAK archive reader, COM_LoadPackFile
//
// header: "PACK", dir offset, dir length. dir entry is 64 bytes -
// 56-byte NUL-padded path, i32 offset, i32 size.
//
// whole archive stays resident (PAK0 is ~18MB) - ZealOS FileRead has no
// seek, so lookups hand back interior pointers instead of copying

#define QPAK_MAX_PAKS	8

class CQPakEntry
{
	U8	name[56];
	I64	offset;
	I64	size;
};

class CQPak
{
	U8			*data;
	I64			 data_size;
	CQPakEntry	*files;
	I64			 num_files;
};

CQPak	*qpaks[QPAK_MAX_PAKS];
I64		 qpak_count = 0;

U0 QPakInit()
{//globals aren't zeroed
	I64 i;

	qpak_count = 0;
	for (i = 0; i < QPAK_MAX_PAKS; i++)
		qpaks[i] = NULL;
}

Bool QPakMount(U8 *filename)
{//index one archive, later mounts win on lookup
	CQPak		*pak;
	CQPakEntry	*e;
	U8			*d;
	U8			*rec;
	I64			 size = 0;
	I64			 dir_offset;
	I64			 dir_length;
	I64			 count;
	I64			 i;

	if (qpak_count >= QPAK_MAX_PAKS)
	{
		"QPak: too many archives mounted\n";
		return FALSE;
	}

	d = FileRead(filename, &size);
	if (!d)
	{
		"QPak: cannot read %s\n", filename;
		return FALSE;
	}

	if (size < 12 || d[0] != 'P' || d[1] != 'A' || d[2] != 'C' || d[3] != 'K')
	{
		"QPak: %s is not a PACK archive\n", filename;
		Free(d);
		return FALSE;
	}

	dir_offset = QRdI32(d + 4);
	dir_length = QRdI32(d + 8);
	count      = dir_length / 64;

	if (dir_offset < 0 || dir_length < 0 || dir_offset + dir_length > size)
	{
		"QPak: %s has a corrupt directory\n", filename;
		Free(d);
		return FALSE;
	}

	pak				= CAlloc(sizeof(CQPak));
	pak->data		= d;
	pak->data_size	= size;
	pak->num_files	= count;
	pak->files		= CAlloc(count * sizeof(CQPakEntry));

	for (i = 0; i < count; i++)
	{
		rec = d + dir_offset + i * 64;
		e   = &pak->files[i];
		QRdName(rec, e->name, 56);
		e->offset = QRdI32(rec + 56);
		e->size   = QRdI32(rec + 60);
	}

	qpaks[qpak_count] = pak;
	qpak_count++;

	"QPak: mounted %s (%d files, %d bytes)\n", filename, count, size;

	return TRUE;
}

U0 QPakUnmountAll()
{//release every archive. the whole file stays resident and lookups hand back
 //interior pointers, so NOTHING may still hold one when this runs - flush every
 //cache first
	CQPak	*pak;
	I64		 i;

	for (i = 0; i < QPAK_MAX_PAKS; i++)
	{
		pak = qpaks[i];
		qpaks[i] = NULL;		//cleared before the free, not after

		if (!pak)
			goto qpu_next;

		if (pak->files)
			Free(pak->files);
		if (pak->data)
			Free(pak->data);

		Free(pak);

qpu_next:
	}

	qpak_count = 0;
}

CQPakEntry *QPakFind(U8 *name, CQPak **_pak = NULL)
{//newest pak first so it overrides
	CQPak		*pak;
	CQPakEntry	*e;
	I64			 p;
	I64			 i;

	for (p = qpak_count - 1; p >= 0; p--)
	{
		pak = qpaks[p];
		if (pak)
		{
			for (i = 0; i < pak->num_files; i++)
			{
				e = &pak->files[i];
				if (!StrICompare(e->name, name))
				{
					if (_pak)
						*_pak = pak;
					return e;
				}
			}
		}
	}

	if (_pak)
		*_pak = NULL;

	return NULL;
}

U8 *QPakData(U8 *name, I64 *_size = NULL)
{//borrowed pointer into the pak, do NOT Free
	CQPak		*pak = NULL;
	CQPakEntry	*e   = QPakFind(name, &pak);

	if (!e || !pak)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	if (e->offset < 0 || e->offset + e->size > pak->data_size)
	{
		"QPak: %s has an out-of-range extent\n", name;
		if (_size)
			*_size = 0;
		return NULL;
	}

	if (_size)
		*_size = e->size;

	return pak->data + e->offset;
}

U8 *QPakLoad(U8 *name, I64 *_size = NULL)
{//owned copy, caller Frees
	I64  size = 0;
	U8  *src  = QPakData(name, &size);
	U8  *dst;

	if (!src)
	{
		if (_size)
			*_size = 0;
		return NULL;
	}

	dst = MAlloc(size + 1);
	MemCopy(dst, src, size);
	dst[size] = 0;

	if (_size)
		*_size = size;

	return dst;
}

U0 QPakList(U8 *prefix = NULL)
{//debug, dump dir filtered by path prefix
	CQPak		*pak;
	CQPakEntry	*e;
	I64			 p;
	I64			 i;
	I64			 n = 0;

	for (p = 0; p < qpak_count; p++)
	{
		pak = qpaks[p];
		if (pak)
		{
			for (i = 0; i < pak->num_files; i++)
			{
				e = &pak->files[i];
				if (!prefix || !StrNCompare(e->name, prefix, StrLen(prefix)))
				{
					"  %-40s %8d\n", e->name, e->size;
					n++;
				}
			}
		}
	}

	"QPak: %d entries listed\n", n;
}
