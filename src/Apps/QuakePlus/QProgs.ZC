// QProgs.ZC - the QuakeC bytecode virtual machine
//
// progs.dat is a 60-byte header and six sections: statements, global defs,
// field defs, functions, string blob, global pool
//
// the pool is 32-bit cells and stays that way. a vector is three consecutive
// cells and QuakeC aliases them (.origin written, .origin_x read), so widening
// to F64 would silently break every vector access - convert only for math
//
// entity fields are one contiguous block at a fixed stride, the bytecode
// addresses them by byte offset from its start

#define QPR_VERSION		6

//calling convention slots, three cells wide so a vector needs no special case
#define QPR_OFS_RETURN	1
#define QPR_OFS_PARM0	4
#define QPR_PARM_STRIDE	3
#define QPR_MAX_PARMS	8

#define QPR_MAX_STACK	64		//call frames
#define QPR_MAX_LOCALS	2048	//saved local cells across nested calls
#define QPR_MAX_RUNAWAY	500000	//statements before assuming an infinite loop
#define QPR_SOFT_RUNAWAY	50000	//statements before complaining, no abort
#define QPR_STRING_HEAP	65536	//room to append map strings after the blob

//opcodes, in emit order
#define OP_DONE			0
#define OP_MUL_F		1
#define OP_MUL_V		2
#define OP_MUL_FV		3
#define OP_MUL_VF		4
#define OP_DIV_F		5
#define OP_ADD_F		6
#define OP_ADD_V		7
#define OP_SUB_F		8
#define OP_SUB_V		9
#define OP_EQ_F			10
#define OP_EQ_V			11
#define OP_EQ_S			12
#define OP_EQ_E			13
#define OP_EQ_FNC		14
#define OP_NE_F			15
#define OP_NE_V			16
#define OP_NE_S			17
#define OP_NE_E			18
#define OP_NE_FNC		19
#define OP_LE			20
#define OP_GE			21
#define OP_LT			22
#define OP_GT			23
#define OP_LOAD_F		24
#define OP_LOAD_V		25
#define OP_LOAD_S		26
#define OP_LOAD_ENT		27
#define OP_LOAD_FLD		28
#define OP_LOAD_FNC		29
#define OP_ADDRESS		30
#define OP_STORE_F		31
#define OP_STORE_V		32
#define OP_STORE_S		33
#define OP_STORE_ENT	34
#define OP_STORE_FLD	35
#define OP_STORE_FNC	36
#define OP_STOREP_F		37
#define OP_STOREP_V		38
#define OP_STOREP_S		39
#define OP_STOREP_ENT	40
#define OP_STOREP_FLD	41
#define OP_STOREP_FNC	42
#define OP_RETURN		43
#define OP_NOT_F		44
#define OP_NOT_V		45
#define OP_NOT_S		46
#define OP_NOT_ENT		47
#define OP_NOT_FNC		48
#define OP_IF			49
#define OP_IFNOT		50
#define OP_CALL0		51
#define OP_CALL8		59
#define OP_STATE		60
#define OP_GOTO			61
#define OP_AND			62
#define OP_OR			63
#define OP_BITAND		64
#define OP_BITOR		65

class CQPrStatement
{
	I64	op;
	I64	a;
	I64	b;
	I64	c;
};

class CQPrDef
{
	I64	type;
	I64	ofs;
	I64	name;		//offset into the string blob
};

class CQPrFunction
{
	I64	first_statement;	//negative is a builtin, index -n
	I64	parm_start;
	I64	locals;
	I64	name;
	I64	file;
	I64	num_parms;
	U8	parm_size[QPR_MAX_PARMS];
};

class CQPrStack
{
	I64	statement;
	I64	function;
};

//--- loaded image ---
U8				*q_pr_raw			= NULL;
I64				 q_pr_raw_size		= 0;
CQPrStatement	*q_pr_statements	= NULL;
I64				 q_pr_num_statements = 0;
CQPrDef			*q_pr_globaldefs	= NULL;
I64				 q_pr_num_globaldefs = 0;
CQPrDef			*q_pr_fielddefs		= NULL;
I64				 q_pr_num_fielddefs	= 0;
CQPrFunction	*q_pr_functions		= NULL;
I64				 q_pr_num_functions	= 0;
U8				*q_pr_strings		= NULL;	//owned, blob plus a runtime heap
I64				 q_pr_strings_size	= 0;
I64				 q_pr_string_alloc	= 0;	//next free byte in the heap

#define QPR_TEMP_STR_LEN	32

I64				 q_pr_temp_str		= 0;	//reusable scratch for ftos/vtos
U32				*q_pr_globals		= NULL;	//raw 32-bit cells
I64				 q_pr_num_globals	= 0;
I64				 q_pr_entity_fields	= 0;

//--- entities ---
U8	*q_pr_edicts		= NULL;		//contiguous field storage
I64	 q_pr_edict_stride	= 0;		//bytes per entity
I64	 q_pr_max_edicts	= 0;
I64	 q_pr_num_edicts	= 0;
Bool *q_pr_edict_free	= NULL;

//--- execution state ---
CQPrStack	 q_pr_stack[QPR_MAX_STACK];
I64			 q_pr_depth			= 0;
I64			 q_pr_localstack[QPR_MAX_LOCALS];
I64			 q_pr_localdepth	= 0;
I64			 q_pr_xfunction		= 0;
I64			 q_pr_xstatement	= 0;
Bool		 q_pr_trace			= FALSE;
Bool		 q_pr_error			= FALSE;

//rate limited. these fire from inside the per-frame execution loop, and every
//console line allocates a document entry - an error repeating each tick eats
//the console heap and faults in the print path, far from the real cause
#define QPR_MAX_REPORTS	8
I64	 q_pr_errors	= 0;		//total, including suppressed
I64	 q_pr_reported	= 0;		//how many actually printed
U8	 q_pr_detail[128];			//scratch for a diagnostic string

U0 QPrReport2(U8 *msg, U8 *detail)
{//one line, only while under the cap. logged too - console lines scroll away
 //and the window is torn down on exit
	U8 line[192];

	q_pr_errors++;

	if (q_pr_reported >= QPR_MAX_REPORTS)
		return;

	q_pr_reported++;

	if (detail)
		StrPrint(line, "QProgs: %s (%s)\n", msg, detail);
	else
		StrPrint(line, "QProgs: %s\n", msg);

	QLog(line);

	if (q_pr_reported == QPR_MAX_REPORTS)
		QLog("QProgs: further errors suppressed\n");
}

//builtins live in a later file, single-pass compiler can't forward reference
U0 (*q_pr_builtin_call)(I64 num) = NULL;

//pr_argc. variadic builtins (bprint/sprint/dprint/centerprint) must use it -
//the OFS_PARM slots are never cleared, so scanning for a zero prints leftovers
I64 q_pr_argc = 0;

//hot symbols, resolved by name at load - the global struct layout is a
//compiler detail that differs between QuakeC builds
I64 q_ofs_self		= -1;
I64 q_ofs_other		= -1;
I64 q_ofs_world		= -1;
I64 q_ofs_time		= -1;
I64 q_ofs_frametime	= -1;
//intermission screen stats
I64 q_ofs_total_secrets		= -1;
I64 q_ofs_total_monsters	= -1;
I64 q_ofs_found_secrets		= -1;
I64 q_ofs_killed_monsters	= -1;
