I64 q_ofs_v_right	= -1;
I64 q_ofs_v_up		= -1;
I64 q_ofs_force_retouch	= -1;
I64 q_ofs_deathmatch	= -1;
I64 q_ofs_skill			= -1;
I64 q_ofs_teamplay		= -1;
I64 q_ofs_coop			= -1;
I64 q_ofs_msg_entity	= -1;

I64 q_fld_frame		= -1;
I64 q_fld_nextthink	= -1;
I64 q_fld_think		= -1;
I64 q_fld_origin	= -1;
I64 q_fld_angles	= -1;
I64 q_fld_velocity	= -1;
I64 q_fld_model		= -1;
I64 q_fld_modelindex = -1;
I64 q_fld_classname	= -1;
I64 q_fld_mins		= -1;
