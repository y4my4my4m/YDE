I64 q_fld_size		= -1;
I64 q_fld_solid		= -1;
I64 q_fld_movetype	= -1;
I64 q_fld_flags		= -1;
I64 q_fld_health	= -1;
I64 q_fld_yaw_speed	= -1;
I64 q_fld_ideal_yaw	= -1;
I64 q_fld_enemy		= -1;
I64 q_fld_owner		= -1;
I64 q_fld_goalentity = -1;
I64 q_fld_takedamage = -1;
I64 q_fld_effects	= -1;
I64 q_fld_skin		= -1;
