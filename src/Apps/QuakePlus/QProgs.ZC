I64 q_fld_groundentity	= -1;

//engine maintained. QuakeC reads absmin/absmax constantly (FireBullets aims
//off absmin_z, findradius measures with them) and never writes them
I64 q_fld_absmin		= -1;
I64 q_fld_punchangle	= -1;
I64 q_fld_dmg_take		= -1;
I64 q_fld_dmg_save		= -1;
I64 q_fld_dmg_inflictor	= -1;
I64 q_fld_style		= -1;
I64 q_fld_sounds	= -1;
I64 q_fld_ammo_shells	= -1;
I64 q_fld_ammo_nails	= -1;
I64 q_fld_ammo_rockets	= -1;
I64 q_fld_ammo_cells	= -1;
I64 q_fld_absmax		= -1;
I64 q_fld_movedir		= -1;
I64 q_fld_teleport_time	= -1;
I64 q_fld_th_die		= -1;

//the player's edict, reserved before map entities so it lands in the client
//slot QuakeC expects. checkclient reads it
//
//file-scope initialisers are NOT honoured here, these hold junk until
//QPlayerStateInit runs, and QPlayerHealth trusts the flag alone - the attract
//loop draws a status bar before any map spawns
I64  q_player_edict;
Bool q_player_active;			//here, not QPlayer.ZC, because QNetSv is earlier

U0 QPlayerStateInit()
{
	q_player_edict  = 0;
	q_player_active = FALSE;
}

//changelevel can't tear the world down from inside a think - that frees the
//bytecode it is running in - so it records here and the app acts between
//frames. declared early so the builtin layer needs no forward call
U8	 q_change_map[64];
Bool q_change_pending	= FALSE;

//gamedir switch, deferred the same way for the same reason: the console lives
//in QMenu.ZC which compiles before the shell that owns the archives, and the
//swap frees every pak while lookups are handing out interior pointers
U8	 q_gamedir_next[32];
Bool q_gamedir_pending	= FALSE;

//parm1..parm16 offsets, resolved once at load rather than by building
//"parm%d" in a loop on every level change
#define QPR_MAX_PARM_GLOBALS	16
I64	 q_ofs_parms[QPR_MAX_PARM_GLOBALS];


//SV_SaveSpawnparms writes every client's set at a level change, and
//PF_setspawnparms reads one back into the parm globals - this is what keeps
//carried inventory separate per player across a changelevel
F64	 q_client_parms[QSV_MAX_CLIENTS * QPR_MAX_PARM_GLOBALS];
Bool q_client_parms_set[QSV_MAX_CLIENTS];

U0 QClientParmsInit()
{//globals aren't zeroed
	I64 i;

	for (i = 0; i < QSV_MAX_CLIENTS * QPR_MAX_PARM_GLOBALS; i++)
		q_client_parms[i] = 0.0;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
		q_client_parms_set[i] = FALSE;
}
I64	 q_ofs_serverflags	= -1;
I64	 q_ofs_mapname		= -1;

//--- cell access -----------------------------------------------------------
// read widens a 32-bit cell to F64, write narrows it back

F64 QPrGetF(I64 ofs)
{//the global pool is already U32 cells, so the bits go straight across. the
 //previous route split the cell into four bytes for QRdF32 to reassemble
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0.0;

	return QF32Bits(q_pr_globals[ofs]);
}

U0 QPrSetF(I64 ofs, F64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = QWrF32(v);
}

I64 QPrGetI(I64 ofs)
{//entity numbers, string offsets and function indices are ints, not floats
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0;

	return q_pr_globals[ofs];
}

U0 QPrSetI(I64 ofs, I64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = v & 0xFFFFFFFF;
}

U0 QPrGetV(I64 ofs, F64 *out)
{
	out[0] = QPrGetF(ofs);
	out[1] = QPrGetF(ofs + 1);
	out[2] = QPrGetF(ofs + 2);
}

U0 QPrSetV(I64 ofs, F64 *v)
{
	QPrSetF(ofs, v[0]);
	QPrSetF(ofs + 1, v[1]);
	QPrSetF(ofs + 2, v[2]);
}

U8 *QPrStr(I64 ofs)
{//string values are byte offsets into the blob
	if (ofs < 0 || ofs >= q_pr_strings_size)
		return "";

	return q_pr_strings + ofs;
}

U8 *QPrFuncName(I64 fnum)
{//"-" when there is no function, so a readout never prints a stale name
	if (fnum <= 0 || fnum >= q_pr_num_functions || !q_pr_functions)
		return "-";

	return QPrStr(q_pr_functions[fnum].name);
}

//--- entity access ---------------------------------------------------------
// entity values are byte offsets into the edict block, so the world is offset
// 0 and the bytecode's own pointer arithmetic works unchanged

I64 QPrEdictNum(I64 ent_value)
{
	if (q_pr_edict_stride <= 0)
		return 0;

	return ent_value / q_pr_edict_stride;
}

I64 QPrEdictValue(I64 num)
{
	return num * q_pr_edict_stride;
}

F64 QPrFieldF(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!q_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0.0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0.0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdF32(p);
}

U0 QPrSetFieldF(I64 ent_num, I64 field_ofs, F64 v)
{
	U8	*p;
	U32	 bits;

	if (!q_pr_edicts)
		return;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	bits = QWrF32(v);

	p[0] = bits & 0xFF;
	p[1] = (bits >> 8) & 0xFF;
	p[2] = (bits >> 16) & 0xFF;
	p[3] = (bits >> 24) & 0xFF;
}

I64 QPrFieldI(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!q_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdU32(p);
}

U0 QPrSetFieldI(I64 ent_num, I64 field_ofs, I64 v)
{
	U8 *p;

	if (!q_pr_edicts)
		return;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

//raw byte-offset access for the pointer opcodes
F64 QPrPtrGetF(I64 byte_ofs)
{
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0.0;

	return QRdF32(q_pr_edicts + byte_ofs);
}

//watchpoint: one edict field cell, byte offset into the edict block. every
//pointer store that hits it logs the writing function - the door-link chain
//was diagnosed by exactly this
I64 q_pr_watch_ent		= -1;
U8	q_pr_watch_fname[24];
I64 q_pr_watch_lo		= -1;

U0 QPrPtrSetI(I64 byte_ofs, I64 v)
{
	U8 *p;
	U8	wline[160];

	if (!q_pr_edicts)
		return;

	if (byte_ofs == q_pr_watch_lo)
	{
		StrPrint(wline, "watch: %s stmt %d wrote ent %d -> %d.%s\n",
			QPrFuncName(q_pr_xfunction), q_pr_xstatement,
			QPrEdictNum(v), q_pr_watch_ent, q_pr_watch_fname);
		QLog(wline);
		if (q_pr_print)
			q_pr_print(wline);
	}

	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return;

	p    = q_pr_edicts + byte_ofs;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

I64 QPrPtrGetI(I64 byte_ofs)
{
	if (!q_pr_edicts)
		return 0;
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0;

	return QRdU32(q_pr_edicts + byte_ofs);
}

U0 QPrPtrSetF(I64 byte_ofs, F64 v)
{
	QPrPtrSetI(byte_ofs, QWrF32(v));
}

//--- symbol lookup ---------------------------------------------------------
// by name, never by hardcoded offset - the layout is a compiler detail

I64 QPrFindGlobal(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_globaldefs[i].name), name))
			return q_pr_globaldefs[i].ofs;
	}

	return -1;
}

I64 QPrFindField(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
			return q_pr_fielddefs[i].ofs;
	}

	return -1;
}

I64 QPrFindFunction(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_functions; i++)
	{
		if (!StrCompare(QPrStr(q_pr_functions[i].name), name))
			return i;
	}

	return -1;
}

//--- loading ---------------------------------------------------------------

U0 QPrFree()
{
	if (q_pr_statements)	Free(q_pr_statements);
	if (q_pr_globaldefs)	Free(q_pr_globaldefs);
	if (q_pr_fielddefs)		Free(q_pr_fielddefs);
	if (q_pr_functions)		Free(q_pr_functions);
	if (q_pr_globals)		Free(q_pr_globals);
	if (q_pr_strings)		Free(q_pr_strings);
	if (q_pr_edicts)		Free(q_pr_edicts);
	if (q_pr_edict_free)	Free(q_pr_edict_free);
	if (q_pr_raw)			Free(q_pr_raw);

	q_pr_statements		= NULL;
	q_pr_globaldefs		= NULL;
	q_pr_fielddefs		= NULL;
	q_pr_functions		= NULL;
	q_pr_globals		= NULL;
	q_pr_strings		= NULL;
	q_pr_string_alloc	= 0;
	q_pr_temp_str		= 0;
	q_pr_edicts			= NULL;
	q_pr_edict_free		= NULL;
	q_pr_raw			= NULL;
	q_pr_num_edicts		= 0;

	//the SIZES go too. every field accessor bounds-checks against these and
	//then indexes off q_pr_edicts - leaving them set after the block is freed
	//means the guards pass and the write lands at NULL + offset
	q_pr_max_edicts		= 0;
	q_pr_entity_fields	= 0;
	q_pr_edict_stride	= 0;
	q_pr_strings_size	= 0;
	q_pr_num_globals	= 0;
	q_pr_num_functions	= 0;
	q_pr_num_statements	= 0;
	q_pr_depth			= 0;
	q_pr_localdepth		= 0;
	q_pr_error			= FALSE;
	q_pr_slow_said		= 0;
}

U0 QPrProfile(I64 top = 10)
{//PR_Profile_f - repeatedly take the busiest function, print it, zero it
 //
 //the counts are exclusive of callees, so a caller that only dispatches shows
 //a small number and the work shows up under whatever it called
	I64	 i;
	I64	 num  = 0;
	I64	 pmax;
	I64	 best;
	U8	 line[160];

	if (!q_pr_functions)
	{
		"no progs loaded\n";
		return;
	}

	while (TRUE)
	{
		pmax = 0;
		best = -1;

		for (i = 0; i < q_pr_num_functions; i++)
		{
			if (q_pr_functions[i].profile > pmax)
			{
				pmax = q_pr_functions[i].profile;
				best = i;
			}
		}

		if (best < 0)
			break;

		if (num < top)
		{
			StrPrint(line, "%7d %s\n", pmax, QPrStr(q_pr_functions[best].name));
			if (q_pr_print) q_pr_print(line);
			QLog(line);
		}

		num++;
		q_pr_functions[best].profile = 0;
	}

	StrPrint(line, "%d functions ran\n", num);
	if (q_pr_print) q_pr_print(line);
	QLog(line);
	QLogFlush;
}

U0 QPrEdictDump(I64 ent)
{//one edict, the fields the door and item chains run on
	U8	line[192];
	I64	fn;

	if (ent < 0 || ent >= q_pr_num_edicts || !q_pr_edicts)
	{
		if (q_pr_print) q_pr_print("no such edict\n");
		return;
	}

	StrPrint(line, "edict %d %s%s\n", ent,
		QPrStr(QPrFieldI(ent, q_fld_classname)),
		"");
	if (q_pr_edict_free[ent])
		StrPrint(line, "edict %d FREE\n", ent);
	if (q_pr_print) q_pr_print(line);
	QLog(line);

	StrPrint(line,
		"  org %d %d %d  model '%s' idx %d  solid %d move %d hp %d\n",
		ToI64(QPrFieldF(ent, q_fld_origin)),
		ToI64(QPrFieldF(ent, q_fld_origin + 1)),
		ToI64(QPrFieldF(ent, q_fld_origin + 2)),
		QPrStr(QPrFieldI(ent, q_fld_model)),
		ToI64(QPrFieldF(ent, q_fld_modelindex)),
		ToI64(QPrFieldF(ent, q_fld_solid)),
		ToI64(QPrFieldF(ent, q_fld_movetype)),
		ToI64(QPrFieldF(ent, q_fld_health)));
	if (q_pr_print) q_pr_print(line);
	QLog(line);

	StrPrint(line,
		"  tn '%s' -> '%s'  spawnflags %d  flags %d  alpha %d.%03d (fld %d)\n",
		QPrStr(QPrFieldI(ent, q_fld_targetname)),
		QPrStr(QPrFieldI(ent, q_fld_target)),
		ToI64(QPrFieldF(ent, q_fld_spawnflags)),
		ToI64(QPrFieldF(ent, q_fld_flags)),
		ToI64(QPrFieldF(ent, q_fld_alpha)),
		ToI64(QPrFieldF(ent, q_fld_alpha) * 1000.0) % 1000,
		q_fld_alpha);
	if (q_pr_print) q_pr_print(line);
	QLog(line);

	StrPrint(line, "  owner %d  enemy %d  ltime %d.%03d\n",
		QPrEdictNum(QPrFieldI(ent, q_fld_owner)),
		QPrEdictNum(QPrFieldI(ent, q_fld_enemy)),
		ToI64(QPrFieldF(ent, q_fld_ltime)),
		ToI64(QPrFieldF(ent, q_fld_ltime) * 1000.0) % 1000);
	if (q_pr_print) q_pr_print(line);
	QLog(line);

	fn = QPrFieldI(ent, q_fld_think);
	StrPrint(line, "  think %s @%d.%03d  touch %s  use %s\n",
		QPrFuncName(fn),
		ToI64(QPrFieldF(ent, q_fld_nextthink)),
		ToI64(QPrFieldF(ent, q_fld_nextthink) * 1000.0) % 1000,
		QPrFuncName(QPrFieldI(ent, q_fld_touch)),
		QPrFuncName(QPrFieldI(ent, q_fld_use)));
	if (q_pr_print) q_pr_print(line);
	QLog(line);
	QLogFlush;
}

U0 QPrEdictFind(U8 *match)
{//every live edict whose classname or targetname contains the string
	I64	i;
	I64	shown = 0;
	U8	*cn;
	U8	*tn;
	U8	line[128];

	for (i = 0; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qed_next;

		cn = QPrStr(QPrFieldI(i, q_fld_classname));
		tn = QPrStr(QPrFieldI(i, q_fld_targetname));

		if (!StrFind(match, cn, SFF_IGNORE_CASE) &&
			!StrFind(match, tn, SFF_IGNORE_CASE))
			goto qed_next;

		StrPrint(line, "%5d %s '%s' -> '%s'\n", i, cn, tn,
			QPrStr(QPrFieldI(i, q_fld_target)));
		if (q_pr_print) q_pr_print(line);
		QLog(line);

		shown++;
		if (shown >= 20)
		{
			if (q_pr_print) q_pr_print("...\n");
			return;
		}

qed_next:
	}

	StrPrint(line, "%d matched\n", shown);
	if (q_pr_print) q_pr_print(line);
	QLogFlush;
}

//--- second VM -------------------------------------------------------------
//
// csprogs.dat runs in its own image. the VM state is these flat globals, so a
// second progs is a capture/restore of them - PR_SwitchQCVM with the pointer
// set copied instead of swapped. the q_ofs_/q_fld_ caches are NOT included:
// they stay resolved against the SERVER progs, and the client VM resolves its
// few globals into its own variables at load
//
// swap only between executes - depth is 0 and the shared stack scratch holds
// nothing

class CQPrVM
{
	U8				*raw;
	I64				 raw_size;
	CQPrStatement	*statements;
	I64				 num_statements;
	CQPrDef			*globaldefs;
	I64				 num_globaldefs;
	CQPrDef			*fielddefs;
	I64				 num_fielddefs;
	CQPrFunction	*functions;
	I64				 num_functions;
	U8				*strings;
	I64				 strings_size;
	I64				 string_alloc;
	I64				 temp_str;
	U32				*globals;
	I64				 num_globals;
	I64				 entity_fields;
	U8				*edicts;
	I64				 edict_stride;
	I64				 max_edicts;
	I64				 num_edicts;
	Bool			*edict_free;
};

U0 QPrVMStore(CQPrVM *vm)
{//active image -> struct
	vm->raw             = q_pr_raw;
	vm->raw_size        = q_pr_raw_size;
	vm->statements      = q_pr_statements;
	vm->num_statements  = q_pr_num_statements;
	vm->globaldefs      = q_pr_globaldefs;
	vm->num_globaldefs  = q_pr_num_globaldefs;
	vm->fielddefs       = q_pr_fielddefs;
	vm->num_fielddefs   = q_pr_num_fielddefs;
	vm->functions       = q_pr_functions;
	vm->num_functions   = q_pr_num_functions;
	vm->strings         = q_pr_strings;
	vm->strings_size    = q_pr_strings_size;
	vm->string_alloc    = q_pr_string_alloc;
	vm->temp_str        = q_pr_temp_str;
	vm->globals         = q_pr_globals;
	vm->num_globals     = q_pr_num_globals;
	vm->entity_fields   = q_pr_entity_fields;
	vm->edicts          = q_pr_edicts;
	vm->edict_stride    = q_pr_edict_stride;
	vm->max_edicts      = q_pr_max_edicts;
	vm->num_edicts      = q_pr_num_edicts;
	vm->edict_free      = q_pr_edict_free;
}

U0 QPrVMLoad(CQPrVM *vm)
{//struct -> active image
	q_pr_raw            = vm->raw;
	q_pr_raw_size       = vm->raw_size;
	q_pr_statements     = vm->statements;
	q_pr_num_statements = vm->num_statements;
	q_pr_globaldefs     = vm->globaldefs;
	q_pr_num_globaldefs = vm->num_globaldefs;
	q_pr_fielddefs      = vm->fielddefs;
	q_pr_num_fielddefs  = vm->num_fielddefs;
	q_pr_functions      = vm->functions;
	q_pr_num_functions  = vm->num_functions;
	q_pr_strings        = vm->strings;
	q_pr_strings_size   = vm->strings_size;
	q_pr_string_alloc   = vm->string_alloc;
	q_pr_temp_str       = vm->temp_str;
	q_pr_globals        = vm->globals;
	q_pr_num_globals    = vm->num_globals;
	q_pr_entity_fields  = vm->entity_fields;
	q_pr_edicts         = vm->edicts;
	q_pr_edict_stride   = vm->edict_stride;
	q_pr_max_edicts     = vm->max_edicts;
	q_pr_num_edicts     = vm->num_edicts;
	q_pr_edict_free     = vm->edict_free;
}

U0 QPrVMClearActive()
{//NULL the active pointers so a following QPrLoad frees nothing it does not
 //own. the saved struct still references the memory
	q_pr_raw         = NULL;
	q_pr_statements  = NULL;
	q_pr_globaldefs  = NULL;
	q_pr_fielddefs   = NULL;
	q_pr_functions   = NULL;
	q_pr_strings     = NULL;
	q_pr_globals     = NULL;
	q_pr_edicts      = NULL;
	q_pr_edict_free  = NULL;
	q_pr_num_statements = 0;
	q_pr_num_functions  = 0;
	q_pr_num_globals    = 0;
	q_pr_num_edicts     = 0;
}

Bool QPrLoad(U8 *name, I64 max_edicts)
{
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 ofs_statements;
	I64	 ofs_globaldefs;
	I64	 ofs_fielddefs;
	I64	 ofs_functions;
	I64	 ofs_strings;
	I64	 ofs_globals;
	I64	 i;
	I64	 j;

	QPrFree;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QProgs: %s not found\n", name;
		return FALSE;
	}

	if (size < 60 || QRdI32(d) != QPR_VERSION)
	{
		"QProgs: %s is not a version %d image\n", name, QPR_VERSION;
		Free(d);
		return FALSE;
	}

	q_pr_raw      = d;
	q_pr_raw_size = size;

	ofs_statements       = QRdI32(d + 8);
	q_pr_num_statements  = QRdI32(d + 12);
	ofs_globaldefs       = QRdI32(d + 16);
	q_pr_num_globaldefs  = QRdI32(d + 20);
	ofs_fielddefs        = QRdI32(d + 24);
	q_pr_num_fielddefs   = QRdI32(d + 28);
	ofs_functions        = QRdI32(d + 32);
	q_pr_num_functions   = QRdI32(d + 36);
	ofs_strings          = QRdI32(d + 40);
	q_pr_strings_size    = QRdI32(d + 44);
	ofs_globals          = QRdI32(d + 48);
	q_pr_num_globals     = QRdI32(d + 52);
	q_pr_entity_fields   = QRdI32(d + 56);

	//--- statements: op, then three signed operands ---
	q_pr_statements = CAlloc(q_pr_num_statements * sizeof(CQPrStatement));
	for (i = 0; i < q_pr_num_statements; i++)
	{
		rec = d + ofs_statements + i * 8;
		q_pr_statements[i].op = QRdU16(rec);

		//UNSIGNED. a mod's global pool exceeds 32767 cells and a signed read
		//turned every high offset negative - the bounds check then ate the
		//access, so those stores vanished SILENTLY. QuakeSpasm reads these
		//unsigned for the same reason. only the jump ops carry signed values,
		//sign-extended at the branch
		q_pr_statements[i].a = QRdU16(rec + 2);
		q_pr_statements[i].b = QRdU16(rec + 4);
		q_pr_statements[i].c = QRdU16(rec + 6);
	}

	//--- defs ---
	q_pr_globaldefs = CAlloc(q_pr_num_globaldefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		rec = d + ofs_globaldefs + i * 8;
		q_pr_globaldefs[i].type = QRdU16(rec);
		q_pr_globaldefs[i].ofs  = QRdU16(rec + 2);
		q_pr_globaldefs[i].name = QRdI32(rec + 4);
	}

	q_pr_fielddefs = CAlloc(q_pr_num_fielddefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		rec = d + ofs_fielddefs + i * 8;
		q_pr_fielddefs[i].type = QRdU16(rec);
		q_pr_fielddefs[i].ofs  = QRdU16(rec + 2);
		q_pr_fielddefs[i].name = QRdI32(rec + 4);
	}

	//--- functions ---
	q_pr_functions = CAlloc(q_pr_num_functions * sizeof(CQPrFunction));
	for (i = 0; i < q_pr_num_functions; i++)
	{
		rec = d + ofs_functions + i * 36;
		q_pr_functions[i].first_statement = QRdI32(rec);
		q_pr_functions[i].parm_start      = QRdI32(rec + 4);
		q_pr_functions[i].locals          = QRdI32(rec + 8);
		//rec + 12 is a profile counter, unused
		q_pr_functions[i].name            = QRdI32(rec + 16);
		q_pr_functions[i].file            = QRdI32(rec + 20);
		q_pr_functions[i].num_parms       = QRdI32(rec + 24);
		for (j = 0; j < QPR_MAX_PARM_GLOBALS; j++)
			q_pr_functions[i].parm_size[j] = rec[28 + j];
	}

	//--- strings ---
	//copied into a larger owned buffer so map entity values can be appended.
	//string values are offsets into this space, anything handed to the VM
	//must live here
	q_pr_strings_size = q_pr_strings_size + QPR_STRING_HEAP;
	q_pr_strings      = CAlloc(q_pr_strings_size);
	MemCopy(q_pr_strings, d + ofs_strings, QRdI32(d + 44));
	q_pr_string_alloc = QRdI32(d + 44);

	//padded to the full 16-bit operand range: any statement cell then indexes
	//in-bounds BY CONSTRUCTION, and the hot opcodes skip the per-operand
	//bounds check entirely. 256KB against a VM that was all call overhead
	q_pr_globals = CAlloc(65538 * 4);
	for (i = 0; i < q_pr_num_globals; i++)
		q_pr_globals[i] = QRdU32(d + ofs_globals + i * 4);

	//--- entities ---
	q_pr_edict_stride = q_pr_entity_fields * 4;
	q_pr_max_edicts   = max_edicts;
	q_pr_edicts       = CAlloc(q_pr_max_edicts * q_pr_edict_stride);
	q_pr_edict_free   = CAlloc(q_pr_max_edicts * sizeof(Bool));
	q_pr_num_edicts   = 1;		//entity 0 is always the world

	for (i = 0; i < q_pr_max_edicts; i++)
		q_pr_edict_free[i] = TRUE;
	q_pr_edict_free[0] = FALSE;

	return TRUE;
}

//--- execution -------------------------------------------------------------

U0 QPrChainDump()
{//self plus the .enemy chain hanging off it
 //
 //door_fire and friends walk a circular .enemy list and stop on arriving back
 //at the start. if the list isn't circular, or excludes the starting entity,
 //the loop never ends - this says which, and whether links are stored at all
	U8	line[192];
	I64	self_ent;
	I64	ent;
	I64	i;

	if (q_ofs_self < 0 || q_fld_enemy < 0)
		return;

	self_ent = QPrEdictNum(QPrGetI(q_ofs_self));

	StrPrint(line, "  self=%d (%s) owner=%d enemy=%d\n", self_ent,
		QPrStr(QPrFieldI(self_ent, q_fld_classname)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_owner)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_enemy)));
	QLog(line);

	//closing back onto self within a few links is well formed, running to the
	//cap is either long or cyclic somewhere that excludes self
	ent = self_ent;
	for (i = 0; i < 12; i++)
	{
		ent = QPrEdictNum(QPrFieldI(ent, q_fld_enemy));

		StrPrint(line, "    chain[%d] -> %d (%s)\n", i, ent,
			QPrStr(QPrFieldI(ent, q_fld_classname)));
		QLog(line);

		if (ent == 0 || ent == self_ent)
			return;
	}

	QLog("    chain did not close within 12 links\n");
}

U0 QPrStackDump(Bool aborted = TRUE)
{//the QuakeC call chain, outermost first - the abort site alone rarely names
 //the cause
 //
 //the soft runaway complains and keeps executing, so its dump must not claim
 //an abort: a slow function at map load reads as a crash otherwise
	U8	line[128];
	I64 i;
	I64 f;
	U8 *mark = " <- aborted here";

	if (!aborted)
		mark = " <- still running";

	for (i = 0; i < q_pr_depth; i++)
	{
		f = q_pr_stack[i].function;
		if (f > 0 && f < q_pr_num_functions)
		{
			StrPrint(line, "  stack[%d] %s\n", i,
				QPrStr(q_pr_functions[f].name));
			QLog(line);
		}
	}

	if (q_pr_xfunction > 0 && q_pr_xfunction < q_pr_num_functions)
	{
		StrPrint(line, "  stack[%d] %s%s\n", q_pr_depth,
			QPrStr(q_pr_functions[q_pr_xfunction].name), mark);
		QLog(line);
	}

	//the chain walk only means something at an abort site. a slow function is
	//not a corrupt list, and mods reuse .chain as scratch
	if (aborted)
		QPrChainDump;

	QLogFlush;
}

U0 QPrEnterFunction(I64 fnum)
{//push the caller, save the callee's locals, copy the arguments in
	CQPrFunction	*f = &q_pr_functions[fnum];
	I64				 i;
	I64				 j;
	I64				 o;
	I64				 c;

	if (q_pr_depth >= QPR_MAX_STACK)
	{
		QPrReport2("call stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	q_pr_stack[q_pr_depth].statement = q_pr_xstatement;
	q_pr_stack[q_pr_depth].function  = q_pr_xfunction;
	q_pr_depth++;

	//locals are statically allocated, recursion needs them saved and restored
	c = f->locals;
	if (q_pr_localdepth + c > QPR_MAX_LOCALS)
	{
		QPrReport2("local stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	for (i = 0; i < c; i++)
	{
		q_pr_localstack[q_pr_localdepth] = QPrGetI(f->parm_start + i);
		q_pr_localdepth++;
	}

	//arguments arrive in the reserved parm cells
	o = f->parm_start;
	for (i = 0; i < f->num_parms; i++)
	{
		for (j = 0; j < f->parm_size[i]; j++)
		{
			QPrSetI(o, QPrGetI(QPR_OFS_PARM0 + i * QPR_PARM_STRIDE + j));
			o++;
		}
	}

	q_pr_xfunction  = fnum;
	q_pr_xstatement = f->first_statement - 1;	//the loop pre-increments
}

U0 QPrLeaveFunction()
{
	CQPrFunction	*f;
	I64				 i;
	I64				 c;

	if (q_pr_depth <= 0)
	{
		QPrReport2("call stack underflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	f = &q_pr_functions[q_pr_xfunction];
	c = f->locals;

	//reverse, the save loop pushed forwards
	for (i = c - 1; i >= 0; i--)
	{
		q_pr_localdepth--;
		QPrSetI(f->parm_start + i, q_pr_localstack[q_pr_localdepth]);
	}

	q_pr_depth--;
	q_pr_xfunction  = q_pr_stack[q_pr_depth].function;
	q_pr_xstatement = q_pr_stack[q_pr_depth].statement;
}

U0 QPrStateInit()
{//declaration initialisers on globals are ignored, and these gate reports and
 //a watchpoint that dereferences an edict offset
	q_pr_slow_said   = 0;
	q_pr_stmts       = 0;
	q_pr_stmts_worst = 0;
	q_pr_worst_fn    = 0;
	q_pr_execs       = 0;
	q_pr_watch_ent   = -1;
	q_pr_watch_lo    = -1;
	q_pr_watch_fname[0] = 0;
	q_pr_print       = NULL;
}

U0 QPrExecute(I64 fnum)
{//PR_ExecuteProgram: run a QuakeC function to completion
	CQPrStatement	*st;
	CQPrFunction	*newf;
	F64				 va[3];
	F64				 vb[3];
	F64				 vc[3];
	F64				 fa;
	F64				 fb;
	I64				 exit_depth;
	I64				 startprofile;
	I64				 entry_local;
	I64				 runaway = 0;
	I64				 op;
	I64				 i;
	I64				 ptr;
	I64				 ent;
	U32				*g = q_pr_globals;	//pool padded to 64K cells, see QPrLoad
	I64				 fld;
	I64				 newfnum;
	I64				 caller;

	if (fnum <= 0 || fnum >= q_pr_num_functions)
		return;

	q_pr_error  = FALSE;
	exit_depth   = q_pr_depth;
	entry_local  = q_pr_localdepth;
	startprofile = 0;

	//EnterFunction pushes the current function before switching, so frame 0
	//would carry q_pr_xfunction from the PREVIOUS execute and show a bogus
	//outermost frame in every abort dump
	q_pr_xfunction = 0;
	q_pr_execs++;

	QPrEnterFunction(fnum);

	while (TRUE)
	{
		runaway++;
		q_pr_stmts++;
		if (runaway > q_pr_stmts_worst)
		{
			q_pr_stmts_worst = runaway;
			q_pr_worst_fn    = q_pr_xfunction;
		}

		//a loop can wreck the frame without ever reaching the runaway cap,
		//so complain once per execute well below it
		if (runaway == QPR_SOFT_RUNAWAY && q_pr_slow_said < QPR_SLOW_REPORTS)
		{
			q_pr_slow_said++;
			QPrReport2("slow execute in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			QPrStackDump(FALSE);
		}

		if (runaway > QPR_MAX_RUNAWAY)
		{
			QPrReport2("runaway loop in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));

			//the innermost function is not the culprit - the loop that never
			//exits lives further up the stack than wherever the counter tripped
			QPrStackDump;

			q_pr_error = TRUE;
			goto qpr_abort;
		}

		if (q_pr_error)
			goto qpr_abort;

		q_pr_xstatement++;

		if (q_pr_xstatement < 0 || q_pr_xstatement >= q_pr_num_statements)
		{
			QPrReport2("statement out of range",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			q_pr_error = TRUE;
			goto qpr_abort;
		}

		st = &q_pr_statements[q_pr_xstatement];
		op = st->op;

		switch (op)
		{
			case OP_DONE:
			case OP_RETURN:
				q_pr_functions[q_pr_xfunction].profile +=
					runaway - startprofile;
				startprofile = runaway;

				//a bare DONE returns nothing, but the operand cells are always
				//in range so copying them is harmless
				QPrSetI(QPR_OFS_RETURN, QPrGetI(st->a));
				QPrSetI(QPR_OFS_RETURN + 1, QPrGetI(st->a + 1));
				QPrSetI(QPR_OFS_RETURN + 2, QPrGetI(st->a + 2));

				QPrLeaveFunction;
				if (q_pr_depth == exit_depth)
					return;
				break;

			//--- arithmetic ---
			case OP_MUL_F:
				g[st->c] = QWrF32(QF32Bits(g[st->a]) * QF32Bits(g[st->b]));
				break;
			case OP_MUL_V:
				g[st->c] = QWrF32(
					QF32Bits(g[st->a])     * QF32Bits(g[st->b]) +
					QF32Bits(g[st->a + 1]) * QF32Bits(g[st->b + 1]) +
					QF32Bits(g[st->a + 2]) * QF32Bits(g[st->b + 2]));
				break;
			case OP_MUL_FV:
				fa = QF32Bits(g[st->a]);
				g[st->c]     = QWrF32(fa * QF32Bits(g[st->b]));
				g[st->c + 1] = QWrF32(fa * QF32Bits(g[st->b + 1]));
				g[st->c + 2] = QWrF32(fa * QF32Bits(g[st->b + 2]));
				break;
			case OP_MUL_VF:
				fb = QF32Bits(g[st->b]);
				g[st->c]     = QWrF32(QF32Bits(g[st->a]) * fb);
				g[st->c + 1] = QWrF32(QF32Bits(g[st->a + 1]) * fb);
				g[st->c + 2] = QWrF32(QF32Bits(g[st->a + 2]) * fb);
				break;
			case OP_DIV_F:
				fb = QF32Bits(g[st->b]);
				if (fb == 0.0)
					g[st->c] = 0;
				else
					g[st->c] = QWrF32(QF32Bits(g[st->a]) / fb);
				break;
			case OP_ADD_F:
				g[st->c] = QWrF32(QF32Bits(g[st->a]) + QF32Bits(g[st->b]));
				break;
			case OP_ADD_V:
				g[st->c]     = QWrF32(QF32Bits(g[st->a]) + QF32Bits(g[st->b]));
				g[st->c + 1] = QWrF32(QF32Bits(g[st->a + 1]) +
									  QF32Bits(g[st->b + 1]));
				g[st->c + 2] = QWrF32(QF32Bits(g[st->a + 2]) +
									  QF32Bits(g[st->b + 2]));
				break;
			case OP_SUB_F:
				g[st->c] = QWrF32(QF32Bits(g[st->a]) - QF32Bits(g[st->b]));
				break;
			case OP_SUB_V:
				g[st->c]     = QWrF32(QF32Bits(g[st->a]) - QF32Bits(g[st->b]));
				g[st->c + 1] = QWrF32(QF32Bits(g[st->a + 1]) -
									  QF32Bits(g[st->b + 1]));
				g[st->c + 2] = QWrF32(QF32Bits(g[st->a + 2]) -
									  QF32Bits(g[st->b + 2]));
				break;

			//--- comparison ---
			case OP_EQ_F:
				//1.0f is 0x3F800000; the compare needs no store helper
				if (QF32Bits(g[st->a]) == QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_EQ_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] == vb[0] && va[1] == vb[1] &&
					va[2] == vb[2]));
				break;
			case OP_EQ_S:
				QPrSetF(st->c, ToF64(!StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b)))));
				break;
			case OP_EQ_E:
			case OP_EQ_FNC:
				if (g[st->a] == g[st->b])
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_NE_F:
				if (QF32Bits(g[st->a]) != QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_NE_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] != vb[0] || va[1] != vb[1] ||
					va[2] != vb[2]));
				break;
			case OP_NE_S:
				QPrSetF(st->c, ToF64(ToBool(StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b))))));
				break;
			case OP_NE_E:
			case OP_NE_FNC:
				if (g[st->a] != g[st->b])
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_LE:
				if (QF32Bits(g[st->a]) <= QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_GE:
				if (QF32Bits(g[st->a]) >= QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_LT:
				if (QF32Bits(g[st->a]) < QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_GT:
				if (QF32Bits(g[st->a]) > QF32Bits(g[st->b]))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;

			//--- field loads: a is the entity, b the field index ---
			case OP_LOAD_F:
			case OP_LOAD_S:
			case OP_LOAD_ENT:
			case OP_LOAD_FLD:
			case OP_LOAD_FNC:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				break;
			case OP_LOAD_V:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				QPrSetI(st->c + 1, QPrFieldI(ent, fld + 1));
				QPrSetI(st->c + 2, QPrFieldI(ent, fld + 2));
				break;

			case OP_ADDRESS:
				//yields a byte offset into the edict block
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, ent * q_pr_edict_stride + fld * 4);
				break;

			//--- global stores ---
			case OP_STORE_F:
			case OP_STORE_S:
			case OP_STORE_ENT:
			case OP_STORE_FLD:
			case OP_STORE_FNC:
				g[st->b] = g[st->a];
				break;
			case OP_STORE_V:
				//a vector's third cell can sit at 65535+2: the pad covers it,
				//sized 65538 in QPrLoad
				g[st->b]     = g[st->a];
				g[st->b + 1] = g[st->a + 1];
				g[st->b + 2] = g[st->a + 2];
				break;

			//--- pointer stores ---
			case OP_STOREP_F:
			case OP_STOREP_S:
			case OP_STOREP_ENT:
			case OP_STOREP_FLD:
			case OP_STOREP_FNC:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				break;
			case OP_STOREP_V:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				QPrPtrSetI(ptr + 4, QPrGetI(st->a + 1));
				QPrPtrSetI(ptr + 8, QPrGetI(st->a + 2));
				break;

			//--- logic ---
			case OP_NOT_F:
				//same denormal rule as AND/OR: !x is true only for +-0.0.
				//the bits-sans-sign test preserves denormal truth where a
				//float conversion flushed it
				if (g[st->a] & 0x7FFFFFFF)
					g[st->c] = 0;
				else
					g[st->c] = 0x3F800000;
				break;
			case OP_NOT_V:
				QPrGetV(st->a, va);
				if (va[0] == 0.0 && va[1] == 0.0 && va[2] == 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_S:
				//same reasoning, no ! on values out of the pool
				i = QPrGetI(st->a);
				if (!i)
					QPrSetF(st->c, 1.0);
				else if (QPrStr(i)[0] == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_FNC:
				//an integer test, matching how a function ref is stored
				if (!QPrGetI(st->a))
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_ENT:
				//only the world counts as no entity
				if (QPrEdictNum(QPrGetI(st->a)) == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_AND:
				//C float truth: false ONLY for +0.0 and -0.0, so the test is
				//the bits sans sign. QF32Bits flushes denormals - and every
				//ENTITY value is one: a byte offset like 16000 is 2e-41 as a
				//float32. qcc emits AND/OR for && on any type, so
				//    if (d1.owner && d2.owner)
				//read false for every linked door and alkaline's LinkDoors
				//re-linked and stomped its own chains. half the door opened
				if ((g[st->a] & 0x7FFFFFFF) && (g[st->b] & 0x7FFFFFFF))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_OR:
				if ((g[st->a] & 0x7FFFFFFF) || (g[st->b] & 0x7FFFFFFF))
					g[st->c] = 0x3F800000;
				else
					g[st->c] = 0;
				break;
			case OP_BITAND:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) &
					ToI64(QPrGetF(st->b))));
				break;
			case OP_BITOR:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) |
					ToI64(QPrGetF(st->b))));
				break;

			//--- flow. jumps are relative and the loop pre-increments ---
			//branch tests read the operand as a raw int, as the original does:
			//
			//    case OP_IF:    if (a->_int) ...
			//    case OP_IFNOT: if (!a->_int) ...
			//
			//conditions arrive as every type - floats from comparisons, but
			//also entity, string and function refs stored as small ints. int
			//and float tests agree on most bit patterns, not all: negative
			//zero equals 0.0 while its _int is non-zero
			case OP_IF:
				if (g[st->a])
					q_pr_xstatement += QPrJump(st->b) - 1;
				break;
			case OP_IFNOT:
				if (!g[st->a])
					q_pr_xstatement += QPrJump(st->b) - 1;
				break;
			case OP_GOTO:
				q_pr_xstatement += QPrJump(st->a) - 1;
				break;

			case OP_STATE:
				//animation step: frame a now, think b in 0.1s. drives every
				//monster and door animation, so it has to be exact
				ent = QPrEdictNum(QPrGetI(q_ofs_self));
				QPrSetFieldF(ent, q_fld_frame, QPrGetF(st->a));
				QPrSetFieldF(ent, q_fld_nextthink, QPrGetF(q_ofs_time) + 0.1);
				QPrSetFieldI(ent, q_fld_think, QPrGetI(st->b));
				break;

			default:
				//--- calls: CALL0..CALL8 encode the argument count ---
				if (OP_CALL0 <= op <= OP_CALL8)
				{
					//close this function's tally before the callee opens its
					//own, or every caller absorbs its children's cost
					q_pr_functions[q_pr_xfunction].profile +=
						runaway - startprofile;
					startprofile = runaway;

					newfnum = QPrGetI(st->a);
					if (newfnum <= 0 || newfnum >= q_pr_num_functions)
					{
						//caller, callee, self classname, entnum and damage
						//state. Killed on a null th_die says a death function
						//is missing but not on what; entnum 0 with a real
						//classname is the world, entnum 0 with junk is a
						//corrupted self - opposite fixes. the caller separates
						//a bad damage path from a bad T_Damage gate
						ent = QPrEdictNum(QPrGetI(q_ofs_self));

						if (q_pr_depth > 0)
							caller = q_pr_stack[q_pr_depth - 1].function;
						else
							caller = 0;

						StrPrint(q_pr_detail, "%s<-%s self=%s #%d dmg=%d mt=%d",
							QPrStr(q_pr_functions[q_pr_xfunction].name),
							QPrStr(q_pr_functions[caller].name),
							QPrStr(QPrFieldI(ent, q_fld_classname)),
							ent,
							ToI64(QPrFieldF(ent, q_fld_takedamage)),
							ToI64(QPrFieldF(ent, q_fld_movetype)));

						QPrReport2("call to null function from", q_pr_detail);
						q_pr_error = TRUE;
						goto qpr_abort;
					}

					newf = &q_pr_functions[newfnum];

					if (newf->first_statement < 0)
					{
						//builtin, index is the negated first statement
						q_pr_argc = op - OP_CALL0;

						if (q_pr_builtin_call)
							q_pr_builtin_call(-newf->first_statement);
					}
					else
						QPrEnterFunction(newfnum);
				}
				else
				{
					QPrReport2("unknown opcode in",
						QPrStr(q_pr_functions[q_pr_xfunction].name));
					q_pr_error = TRUE;
					goto qpr_abort;
				}
				break;
		}
	}

qpr_abort:
	//an abort MUST put the stacks back. callers just clear the flag and carry
	//on, so a leaked frame per error ratchets depth to the ceiling and every
	//later think, touch and builtin fails - one bad function looks like the
	//whole VM dying
	q_pr_depth      = exit_depth;
	q_pr_localdepth = entry_local;
}

I64 QPrTempString(U8 *s)
{//the one reusable scratch, as PF_ftos/PF_vtos use. NOT a fresh allocation -
 //ftos runs in loops and would exhaust the string heap inside a level
	I64 len;

	if (!q_pr_temp_str)
	{
		if (q_pr_string_alloc + QPR_TEMP_STR_LEN > q_pr_strings_size)
			return 0;

		q_pr_temp_str      = q_pr_string_alloc;
		q_pr_string_alloc += QPR_TEMP_STR_LEN;
	}

	if (!s)
		s = "";

	len = StrLen(s);
	if (len > QPR_TEMP_STR_LEN - 1)
		len = QPR_TEMP_STR_LEN - 1;

	MemCopy(q_pr_strings + q_pr_temp_str, s, len);
	q_pr_strings[q_pr_temp_str + len] = 0;

	return q_pr_temp_str;
}

I64 QPrNewString(U8 *s)
{//append a runtime string, returns its offset. map entity values are not in
 //the compiled blob
	I64 len = StrLen(s);
	I64 ofs;

	if (q_pr_string_alloc + len + 1 > q_pr_strings_size)
	{
		QPrReport2("string heap full", NULL);
		return 0;
	}

	ofs = q_pr_string_alloc;
	MemCopy(q_pr_strings + ofs, s, len);
	q_pr_strings[ofs + len] = 0;
	q_pr_string_alloc += len + 1;

	return ofs;
}

U0 QPrWatchResolve()
{//stride and field offsets change per progs, so the raw address is derived
	I64 fld;

	q_pr_watch_lo = -1;
	if (q_pr_watch_ent < 0 || !q_pr_watch_fname[0])
		return;

	fld = QPrFindField(q_pr_watch_fname);
	if (fld < 0 || !q_pr_edict_stride)
		return;

	q_pr_watch_lo = q_pr_watch_ent * q_pr_edict_stride + fld * 4;
}

U0 QPrWatchSet(I64 ent, U8 *fname)
{
	q_pr_watch_ent = ent;
	QStrCopy(q_pr_watch_fname, fname, 24);
	QPrWatchResolve;
}

U0 QPrCacheOffsets()
{//resolve the hot symbols once. a miss stays -1 and every accessor range
	QPrWatchResolve;
 //checks, so an unexpected QuakeC build degrades instead of faulting

	q_ofs_self		= QPrFindGlobal("self");
	q_ofs_other		= QPrFindGlobal("other");
	q_ofs_world		= QPrFindGlobal("world");
	q_ofs_time		= QPrFindGlobal("time");
	q_ofs_frametime	= QPrFindGlobal("frametime");
	q_ofs_msg_entity = QPrFindGlobal("msg_entity");
	q_ofs_total_secrets		= QPrFindGlobal("total_secrets");
	q_ofs_total_monsters	= QPrFindGlobal("total_monsters");
	q_ofs_found_secrets		= QPrFindGlobal("found_secrets");
	q_ofs_killed_monsters	= QPrFindGlobal("killed_monsters");
	q_ofs_v_forward	= QPrFindGlobal("v_forward");
	q_ofs_v_right	= QPrFindGlobal("v_right");
	q_ofs_v_up		= QPrFindGlobal("v_up");

	q_fld_frame			= QPrFindField("frame");
	q_fld_nextthink		= QPrFindField("nextthink");
	q_fld_think			= QPrFindField("think");
	q_fld_origin		= QPrFindField("origin");
	q_fld_angles		= QPrFindField("angles");
	q_fld_velocity		= QPrFindField("velocity");
	q_fld_model			= QPrFindField("model");
	q_fld_modelindex	= QPrFindField("modelindex");
	q_fld_classname		= QPrFindField("classname");
	q_fld_mins			= QPrFindField("mins");
	q_fld_maxs			= QPrFindField("maxs");
	q_fld_size			= QPrFindField("size");
	q_fld_solid			= QPrFindField("solid");
	q_fld_movetype		= QPrFindField("movetype");
	q_fld_flags			= QPrFindField("flags");
	q_fld_health		= QPrFindField("health");
	q_fld_yaw_speed		= QPrFindField("yaw_speed");
	q_fld_ideal_yaw		= QPrFindField("ideal_yaw");
	q_fld_enemy			= QPrFindField("enemy");
	q_fld_owner			= QPrFindField("owner");
	q_fld_goalentity	= QPrFindField("goalentity");
	q_fld_takedamage	= QPrFindField("takedamage");
	q_fld_effects		= QPrFindField("effects");
	q_fld_punchangle	= QPrFindField("punchangle");
	q_fld_dmg_take		= QPrFindField("dmg_take");
	q_fld_dmg_save		= QPrFindField("dmg_save");
	q_fld_dmg_inflictor	= QPrFindField("dmg_inflictor");
	q_fld_style			= QPrFindField("style");
	q_fld_sounds		= QPrFindField("sounds");
	q_fld_ammo_shells	= QPrFindField("ammo_shells");
	q_fld_ammo_nails	= QPrFindField("ammo_nails");
	q_fld_ammo_rockets	= QPrFindField("ammo_rockets");
	q_fld_ammo_cells	= QPrFindField("ammo_cells");
	q_fld_skin			= QPrFindField("skin");
	q_fld_spawnflags	= QPrFindField("spawnflags");
	q_fld_colormap		= QPrFindField("colormap");
	q_fld_frags			= QPrFindField("frags");
	q_fld_ltime			= QPrFindField("ltime");
	q_fld_alpha			= QPrFindField("alpha");
	q_fld_scale			= QPrFindField("scale");
	q_fld_touch			= QPrFindField("touch");
	q_fld_targetname	= QPrFindField("targetname");
	q_fld_target		= QPrFindField("target");
	q_fld_use			= QPrFindField("use");
	q_fld_blocked		= QPrFindField("blocked");
	q_fld_chain			= QPrFindField("chain");

	q_fld_v_angle		= QPrFindField("v_angle");
	q_fld_fixangle		= QPrFindField("fixangle");
	q_fld_button0		= QPrFindField("button0");
	q_fld_button1		= QPrFindField("button1");
	q_fld_button2		= QPrFindField("button2");
	q_fld_impulse		= QPrFindField("impulse");
	q_fld_view_ofs		= QPrFindField("view_ofs");
	q_fld_items			= QPrFindField("items");
	q_fld_weapon		= QPrFindField("weapon");
	q_fld_weaponmodel	= QPrFindField("weaponmodel");
	q_fld_weaponframe	= QPrFindField("weaponframe");
	q_fld_currentammo	= QPrFindField("currentammo");
	q_fld_max_health	= QPrFindField("max_health");
	q_fld_deadflag		= QPrFindField("deadflag");
	q_fld_netname		= QPrFindField("netname");
	q_fld_message		= QPrFindField("message");
	q_fld_team			= QPrFindField("team");
	q_fld_armorvalue	= QPrFindField("armorvalue");
	q_fld_waterlevel	= QPrFindField("waterlevel");
	q_fld_watertype		= QPrFindField("watertype");
	q_fld_avelocity		= QPrFindField("avelocity");
	q_fld_gravity		= QPrFindField("gravity");
	q_fld_groundentity	= QPrFindField("groundentity");
	q_fld_absmin		= QPrFindField("absmin");
	q_fld_absmax		= QPrFindField("absmax");
	q_fld_movedir		= QPrFindField("movedir");
	q_fld_teleport_time	= QPrFindField("teleport_time");
	q_fld_th_die		= QPrFindField("th_die");
	q_fld_ltime			= QPrFindField("ltime");
	q_fld_alpha			= QPrFindField("alpha");
	q_fld_scale			= QPrFindField("scale");

	//spawn parms, by explicit name rather than a built string
	q_ofs_parms[0]  = QPrFindGlobal("parm1");
	q_ofs_parms[1]  = QPrFindGlobal("parm2");
	q_ofs_parms[2]  = QPrFindGlobal("parm3");
	q_ofs_parms[3]  = QPrFindGlobal("parm4");
	q_ofs_parms[4]  = QPrFindGlobal("parm5");
	q_ofs_parms[5]  = QPrFindGlobal("parm6");
	q_ofs_parms[6]  = QPrFindGlobal("parm7");
	q_ofs_parms[7]  = QPrFindGlobal("parm8");
	q_ofs_parms[8]  = QPrFindGlobal("parm9");
	q_ofs_parms[9]  = QPrFindGlobal("parm10");
	q_ofs_parms[10] = QPrFindGlobal("parm11");
	q_ofs_parms[11] = QPrFindGlobal("parm12");
	q_ofs_parms[12] = QPrFindGlobal("parm13");
	q_ofs_parms[13] = QPrFindGlobal("parm14");
	q_ofs_parms[14] = QPrFindGlobal("parm15");
	q_ofs_parms[15] = QPrFindGlobal("parm16");

	q_ofs_serverflags = QPrFindGlobal("serverflags");
	q_ofs_mapname	  = QPrFindGlobal("mapname");
	q_ofs_force_retouch = QPrFindGlobal("force_retouch");
	q_ofs_deathmatch	= QPrFindGlobal("deathmatch");
	q_ofs_skill			= QPrFindGlobal("skill");
	q_ofs_teamplay		= QPrFindGlobal("teamplay");
	q_ofs_coop			= QPrFindGlobal("coop");

	//FIXME: e1m1 throws two "cross connected doors" objerrors, one per
	//double-door pair - the shape of LinkDoors running twice per master door
	//with the .enemy guard failing to stop it
}

I64 QPrSpawnEdict()
{//reuse a freed slot, otherwise extend the list
	I64 i;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
		{
			q_pr_edict_free[i] = FALSE;
			MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);
			return i;
		}
	}

	if (q_pr_num_edicts >= q_pr_max_edicts)
	{
		QPrReport2("out of edicts", NULL);
		return 0;
	}

	i = q_pr_num_edicts;
	q_pr_num_edicts++;
	q_pr_edict_free[i] = FALSE;
	MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);

	return i;
}

U0 QPrFreeEdict(I64 num)
{
	if (num <= 0 || num >= q_pr_max_edicts)
		return;

	MemSet(q_pr_edicts + num * q_pr_edict_stride, 0, q_pr_edict_stride);
	q_pr_edict_free[num] = TRUE;
}

U0 QPrReport()
{
	"  version      %d\n", QPR_VERSION;
	"  statements   %6d\n", q_pr_num_statements;
	"  globaldefs   %6d\n", q_pr_num_globaldefs;
	"  fielddefs    %6d\n", q_pr_num_fielddefs;
	"  functions    %6d\n", q_pr_num_functions;
	"  strings      %6d bytes\n", q_pr_strings_size;
	"  globals      %6d cells\n", q_pr_num_globals;
	"  entityfields %6d (stride %d bytes)\n", q_pr_entity_fields,
		q_pr_edict_stride;
}
