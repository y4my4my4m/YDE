//QuakeSpasm's .alpha extension, which Ironwail inherits: a brush entity sets
//it 0..1 and the surface blends. absent from id progs, so -1 is normal
I64 q_fld_alpha		= -1;
I64 q_fld_scale		= -1;	//QuakeSpasm .scale, 0 means unset
I64 q_fld_touch		= -1;
