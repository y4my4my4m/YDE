I64 q_fld_th_die		= -1;

//the player's edict, reserved before map entities so it lands in the client
//slot QuakeC expects. checkclient reads it
//
//file-scope initialisers are NOT honoured here, these hold junk until
//QPlayerStateInit runs, and QPlayerHealth trusts the flag alone - the attract
//loop draws a status bar before any map spawns
I64  q_player_edict;
Bool q_player_active;			//here, not QPlayer.ZC, because QNetSv is earlier

U0 QPlayerStateInit()
{
	q_player_edict  = 0;
	q_player_active = FALSE;
}

//changelevel can't tear the world down from inside a think - that frees the
//bytecode it is running in - so it records here and the app acts between
//frames. declared early so the builtin layer needs no forward call
U8	 q_change_map[64];
Bool q_change_pending	= FALSE;

//gamedir switch, deferred the same way for the same reason: the console lives
//in QMenu.ZC which compiles before the shell that owns the archives, and the
//swap frees every pak while lookups are handing out interior pointers
U8	 q_gamedir_next[32];
Bool q_gamedir_pending	= FALSE;

//parm1..parm16 offsets, resolved once at load rather than by building
//"parm%d" in a loop on every level change
#define QPR_MAX_PARM_GLOBALS	16
I64	 q_ofs_parms[QPR_MAX_PARM_GLOBALS];


//SV_SaveSpawnparms writes every client's set at a level change, and
//PF_setspawnparms reads one back into the parm globals - this is what keeps
//carried inventory separate per player across a changelevel
F64	 q_client_parms[QSV_MAX_CLIENTS * QPR_MAX_PARM_GLOBALS];
Bool q_client_parms_set[QSV_MAX_CLIENTS];

U0 QClientParmsInit()
{//globals aren't zeroed
	I64 i;

	for (i = 0; i < QSV_MAX_CLIENTS * QPR_MAX_PARM_GLOBALS; i++)
		q_client_parms[i] = 0.0;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
		q_client_parms_set[i] = FALSE;
}
I64	 q_ofs_serverflags	= -1;

//--- cell access -----------------------------------------------------------
// read widens a 32-bit cell to F64, write narrows it back

F64 QPrGetF(I64 ofs)
{
	U8 tmp[4];
	U32 v;

	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0.0;

	v      = q_pr_globals[ofs];
	tmp[0] = v & 0xFF;
	tmp[1] = (v >> 8) & 0xFF;
	tmp[2] = (v >> 16) & 0xFF;
	tmp[3] = (v >> 24) & 0xFF;

	return QRdF32(tmp);
}

U0 QPrSetF(I64 ofs, F64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = QWrF32(v);
}

I64 QPrGetI(I64 ofs)
{//entity numbers, string offsets and function indices are ints, not floats
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0;

	return q_pr_globals[ofs];
}

U0 QPrSetI(I64 ofs, I64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = v & 0xFFFFFFFF;
}

U0 QPrGetV(I64 ofs, F64 *out)
{
	out[0] = QPrGetF(ofs);
	out[1] = QPrGetF(ofs + 1);
	out[2] = QPrGetF(ofs + 2);
}

U0 QPrSetV(I64 ofs, F64 *v)
{
	QPrSetF(ofs, v[0]);
	QPrSetF(ofs + 1, v[1]);
	QPrSetF(ofs + 2, v[2]);
}

U8 *QPrStr(I64 ofs)
{//string values are byte offsets into the blob
	if (ofs < 0 || ofs >= q_pr_strings_size)
		return "";

	return q_pr_strings + ofs;
}

//--- entity access ---------------------------------------------------------
// entity values are byte offsets into the edict block, so the world is offset
// 0 and the bytecode's own pointer arithmetic works unchanged

I64 QPrEdictNum(I64 ent_value)
{
	if (q_pr_edict_stride <= 0)
		return 0;

	return ent_value / q_pr_edict_stride;
}

I64 QPrEdictValue(I64 num)
{
	return num * q_pr_edict_stride;
}

F64 QPrFieldF(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!q_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0.0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0.0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdF32(p);
}

U0 QPrSetFieldF(I64 ent_num, I64 field_ofs, F64 v)
{
	U8	*p;
	U32	 bits;

	if (!q_pr_edicts)
		return;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	bits = QWrF32(v);

	p[0] = bits & 0xFF;
	p[1] = (bits >> 8) & 0xFF;
	p[2] = (bits >> 16) & 0xFF;
	p[3] = (bits >> 24) & 0xFF;
}

I64 QPrFieldI(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!q_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdU32(p);
}

U0 QPrSetFieldI(I64 ent_num, I64 field_ofs, I64 v)
{
	U8 *p;

	if (!q_pr_edicts)
		return;
	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

//raw byte-offset access for the pointer opcodes
F64 QPrPtrGetF(I64 byte_ofs)
{
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0.0;

	return QRdF32(q_pr_edicts + byte_ofs);
}

U0 QPrPtrSetI(I64 byte_ofs, I64 v)
{
	U8 *p;

	if (!q_pr_edicts)
		return;
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return;

	p    = q_pr_edicts + byte_ofs;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

I64 QPrPtrGetI(I64 byte_ofs)
{
	if (!q_pr_edicts)
		return 0;
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0;

	return QRdU32(q_pr_edicts + byte_ofs);
}

U0 QPrPtrSetF(I64 byte_ofs, F64 v)
{
	QPrPtrSetI(byte_ofs, QWrF32(v));
}

//--- symbol lookup ---------------------------------------------------------
// by name, never by hardcoded offset - the layout is a compiler detail

I64 QPrFindGlobal(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_globaldefs[i].name), name))
			return q_pr_globaldefs[i].ofs;
	}

	return -1;
}

I64 QPrFindField(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
			return q_pr_fielddefs[i].ofs;
	}

	return -1;
}

I64 QPrFindFunction(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_functions; i++)
	{
		if (!StrCompare(QPrStr(q_pr_functions[i].name), name))
			return i;
	}

	return -1;
}

//--- loading ---------------------------------------------------------------

U0 QPrFree()
{
	if (q_pr_statements)	Free(q_pr_statements);
	if (q_pr_globaldefs)	Free(q_pr_globaldefs);
	if (q_pr_fielddefs)		Free(q_pr_fielddefs);
	if (q_pr_functions)		Free(q_pr_functions);
	if (q_pr_globals)		Free(q_pr_globals);
	if (q_pr_strings)		Free(q_pr_strings);
	if (q_pr_edicts)		Free(q_pr_edicts);
	if (q_pr_edict_free)	Free(q_pr_edict_free);
	if (q_pr_raw)			Free(q_pr_raw);

	q_pr_statements		= NULL;
	q_pr_globaldefs		= NULL;
	q_pr_fielddefs		= NULL;
	q_pr_functions		= NULL;
	q_pr_globals		= NULL;
	q_pr_strings		= NULL;
	q_pr_string_alloc	= 0;
	q_pr_temp_str		= 0;
	q_pr_edicts			= NULL;
	q_pr_edict_free		= NULL;
	q_pr_raw			= NULL;
	q_pr_num_edicts		= 0;

	//the SIZES go too. every field accessor bounds-checks against these and
	//then indexes off q_pr_edicts - leaving them set after the block is freed
	//means the guards pass and the write lands at NULL + offset
	q_pr_max_edicts		= 0;
	q_pr_entity_fields	= 0;
	q_pr_edict_stride	= 0;
	q_pr_strings_size	= 0;
	q_pr_num_globals	= 0;
	q_pr_num_functions	= 0;
	q_pr_num_statements	= 0;
	q_pr_depth			= 0;
	q_pr_localdepth		= 0;
	q_pr_error			= FALSE;
}

Bool QPrLoad(U8 *name, I64 max_edicts)
{
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 ofs_statements;
	I64	 ofs_globaldefs;
	I64	 ofs_fielddefs;
	I64	 ofs_functions;
	I64	 ofs_strings;
	I64	 ofs_globals;
	I64	 i;
	I64	 j;

	QPrFree;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QProgs: %s not found\n", name;
		return FALSE;
	}

	if (size < 60 || QRdI32(d) != QPR_VERSION)
	{
		"QProgs: %s is not a version %d image\n", name, QPR_VERSION;
		Free(d);
		return FALSE;
	}

	q_pr_raw      = d;
	q_pr_raw_size = size;

	ofs_statements       = QRdI32(d + 8);
	q_pr_num_statements  = QRdI32(d + 12);
	ofs_globaldefs       = QRdI32(d + 16);
	q_pr_num_globaldefs  = QRdI32(d + 20);
	ofs_fielddefs        = QRdI32(d + 24);
	q_pr_num_fielddefs   = QRdI32(d + 28);
	ofs_functions        = QRdI32(d + 32);
	q_pr_num_functions   = QRdI32(d + 36);
	ofs_strings          = QRdI32(d + 40);
	q_pr_strings_size    = QRdI32(d + 44);
	ofs_globals          = QRdI32(d + 48);
	q_pr_num_globals     = QRdI32(d + 52);
	q_pr_entity_fields   = QRdI32(d + 56);

	//--- statements: op, then three signed operands ---
	q_pr_statements = CAlloc(q_pr_num_statements * sizeof(CQPrStatement));
	for (i = 0; i < q_pr_num_statements; i++)
	{
		rec = d + ofs_statements + i * 8;
		q_pr_statements[i].op = QRdU16(rec);

		//signed, jumps are relative and go backwards for loops
		q_pr_statements[i].a = QRdI16(rec + 2);
		q_pr_statements[i].b = QRdI16(rec + 4);
		q_pr_statements[i].c = QRdI16(rec + 6);
	}

	//--- defs ---
	q_pr_globaldefs = CAlloc(q_pr_num_globaldefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		rec = d + ofs_globaldefs + i * 8;
		q_pr_globaldefs[i].type = QRdU16(rec);
		q_pr_globaldefs[i].ofs  = QRdU16(rec + 2);
		q_pr_globaldefs[i].name = QRdI32(rec + 4);
	}

	q_pr_fielddefs = CAlloc(q_pr_num_fielddefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		rec = d + ofs_fielddefs + i * 8;
		q_pr_fielddefs[i].type = QRdU16(rec);
		q_pr_fielddefs[i].ofs  = QRdU16(rec + 2);
		q_pr_fielddefs[i].name = QRdI32(rec + 4);
	}

	//--- functions ---
	q_pr_functions = CAlloc(q_pr_num_functions * sizeof(CQPrFunction));
	for (i = 0; i < q_pr_num_functions; i++)
	{
		rec = d + ofs_functions + i * 36;
		q_pr_functions[i].first_statement = QRdI32(rec);
		q_pr_functions[i].parm_start      = QRdI32(rec + 4);
		q_pr_functions[i].locals          = QRdI32(rec + 8);
		//rec + 12 is a profile counter, unused
		q_pr_functions[i].name            = QRdI32(rec + 16);
		q_pr_functions[i].file            = QRdI32(rec + 20);
		q_pr_functions[i].num_parms       = QRdI32(rec + 24);
		for (j = 0; j < QPR_MAX_PARM_GLOBALS; j++)
			q_pr_functions[i].parm_size[j] = rec[28 + j];
	}

	//--- strings ---
	//copied into a larger owned buffer so map entity values can be appended.
	//string values are offsets into this space, anything handed to the VM
	//must live here
	q_pr_strings_size = q_pr_strings_size + QPR_STRING_HEAP;
	q_pr_strings      = CAlloc(q_pr_strings_size);
	MemCopy(q_pr_strings, d + ofs_strings, QRdI32(d + 44));
	q_pr_string_alloc = QRdI32(d + 44);

	q_pr_globals = CAlloc(q_pr_num_globals * 4);
	for (i = 0; i < q_pr_num_globals; i++)
		q_pr_globals[i] = QRdU32(d + ofs_globals + i * 4);

	//--- entities ---
	q_pr_edict_stride = q_pr_entity_fields * 4;
	q_pr_max_edicts   = max_edicts;
	q_pr_edicts       = CAlloc(q_pr_max_edicts * q_pr_edict_stride);
	q_pr_edict_free   = CAlloc(q_pr_max_edicts * sizeof(Bool));
	q_pr_num_edicts   = 1;		//entity 0 is always the world

	for (i = 0; i < q_pr_max_edicts; i++)
		q_pr_edict_free[i] = TRUE;
	q_pr_edict_free[0] = FALSE;

	return TRUE;
}

//--- execution -------------------------------------------------------------

U0 QPrChainDump()
{//self plus the .enemy chain hanging off it
 //
 //door_fire and friends walk a circular .enemy list and stop on arriving back
 //at the start. if the list isn't circular, or excludes the starting entity,
 //the loop never ends - this says which, and whether links are stored at all
	U8	line[192];
	I64	self_ent;
	I64	ent;
	I64	i;

	if (q_ofs_self < 0 || q_fld_enemy < 0)
		return;

	self_ent = QPrEdictNum(QPrGetI(q_ofs_self));

	StrPrint(line, "  self=%d (%s) owner=%d enemy=%d\n", self_ent,
		QPrStr(QPrFieldI(self_ent, q_fld_classname)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_owner)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_enemy)));
	QLog(line);

	//closing back onto self within a few links is well formed, running to the
	//cap is either long or cyclic somewhere that excludes self
	ent = self_ent;
	for (i = 0; i < 12; i++)
	{
		ent = QPrEdictNum(QPrFieldI(ent, q_fld_enemy));

		StrPrint(line, "    chain[%d] -> %d (%s)\n", i, ent,
			QPrStr(QPrFieldI(ent, q_fld_classname)));
		QLog(line);

		if (ent == 0 || ent == self_ent)
			return;
	}

	QLog("    chain did not close within 12 links\n");
}

U0 QPrStackDump()
{//the QuakeC call chain, outermost first - the abort site alone rarely names
 //the cause
	U8	line[128];
	I64 i;
	I64 f;

	for (i = 0; i < q_pr_depth; i++)
	{
		f = q_pr_stack[i].function;
		if (f > 0 && f < q_pr_num_functions)
		{
			StrPrint(line, "  stack[%d] %s\n", i,
				QPrStr(q_pr_functions[f].name));
			QLog(line);
		}
	}

	if (q_pr_xfunction > 0 && q_pr_xfunction < q_pr_num_functions)
	{
		StrPrint(line, "  stack[%d] %s <- aborted here\n", q_pr_depth,
			QPrStr(q_pr_functions[q_pr_xfunction].name));
		QLog(line);
	}

	QPrChainDump;
	QLogFlush;
}

U0 QPrEnterFunction(I64 fnum)
{//push the caller, save the callee's locals, copy the arguments in
	CQPrFunction	*f = &q_pr_functions[fnum];
	I64				 i;
	I64				 j;
	I64				 o;
	I64				 c;

	if (q_pr_depth >= QPR_MAX_STACK)
	{
		QPrReport2("call stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	q_pr_stack[q_pr_depth].statement = q_pr_xstatement;
	q_pr_stack[q_pr_depth].function  = q_pr_xfunction;
	q_pr_depth++;

	//locals are statically allocated, recursion needs them saved and restored
	c = f->locals;
	if (q_pr_localdepth + c > QPR_MAX_LOCALS)
	{
		QPrReport2("local stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	for (i = 0; i < c; i++)
	{
		q_pr_localstack[q_pr_localdepth] = QPrGetI(f->parm_start + i);
		q_pr_localdepth++;
	}

	//arguments arrive in the reserved parm cells
	o = f->parm_start;
	for (i = 0; i < f->num_parms; i++)
	{
		for (j = 0; j < f->parm_size[i]; j++)
		{
			QPrSetI(o, QPrGetI(QPR_OFS_PARM0 + i * QPR_PARM_STRIDE + j));
			o++;
		}
	}

	q_pr_xfunction  = fnum;
	q_pr_xstatement = f->first_statement - 1;	//the loop pre-increments
}

U0 QPrLeaveFunction()
{
	CQPrFunction	*f;
	I64				 i;
	I64				 c;

	if (q_pr_depth <= 0)
	{
		QPrReport2("call stack underflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	f = &q_pr_functions[q_pr_xfunction];
	c = f->locals;

	//reverse, the save loop pushed forwards
	for (i = c - 1; i >= 0; i--)
	{
		q_pr_localdepth--;
		QPrSetI(f->parm_start + i, q_pr_localstack[q_pr_localdepth]);
	}

	q_pr_depth--;
	q_pr_xfunction  = q_pr_stack[q_pr_depth].function;
	q_pr_xstatement = q_pr_stack[q_pr_depth].statement;
}

U0 QPrExecute(I64 fnum)
{//PR_ExecuteProgram: run a QuakeC function to completion
	CQPrStatement	*st;
	CQPrFunction	*newf;
	F64				 va[3];
	F64				 vb[3];
	F64				 vc[3];
	F64				 fa;
	F64				 fb;
	I64				 exit_depth;
	I64				 entry_local;
	I64				 runaway = 0;
	I64				 op;
	I64				 i;
	I64				 ptr;
	I64				 ent;
	I64				 fld;
	I64				 newfnum;
	I64				 caller;

	if (fnum <= 0 || fnum >= q_pr_num_functions)
		return;

	q_pr_error  = FALSE;
	exit_depth  = q_pr_depth;
	entry_local = q_pr_localdepth;

	//EnterFunction pushes the current function before switching, so frame 0
	//would carry q_pr_xfunction from the PREVIOUS execute and show a bogus
	//outermost frame in every abort dump
	q_pr_xfunction = 0;

	QPrEnterFunction(fnum);

	while (TRUE)
	{
		runaway++;
		//a loop can wreck the frame without ever reaching the runaway cap,
		//so complain once per execute well below it
		if (runaway == QPR_SOFT_RUNAWAY)
		{
			QPrReport2("slow execute in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			QPrStackDump;
		}

		if (runaway > QPR_MAX_RUNAWAY)
		{
			QPrReport2("runaway loop in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));

			//the innermost function is not the culprit - the loop that never
			//exits lives further up the stack than wherever the counter tripped
			QPrStackDump;

			q_pr_error = TRUE;
			goto qpr_abort;
		}

		if (q_pr_error)
			goto qpr_abort;

		q_pr_xstatement++;

		if (q_pr_xstatement < 0 || q_pr_xstatement >= q_pr_num_statements)
		{
			QPrReport2("statement out of range",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			q_pr_error = TRUE;
			goto qpr_abort;
		}

		st = &q_pr_statements[q_pr_xstatement];
		op = st->op;

		switch (op)
		{
			case OP_DONE:
			case OP_RETURN:
				//a bare DONE returns nothing, but the operand cells are always
				//in range so copying them is harmless
				QPrSetI(QPR_OFS_RETURN, QPrGetI(st->a));
				QPrSetI(QPR_OFS_RETURN + 1, QPrGetI(st->a + 1));
				QPrSetI(QPR_OFS_RETURN + 2, QPrGetI(st->a + 2));

				QPrLeaveFunction;
				if (q_pr_depth == exit_depth)
					return;
				break;

			//--- arithmetic ---
			case OP_MUL_F:
				QPrSetF(st->c, QPrGetF(st->a) * QPrGetF(st->b));
				break;
			case OP_MUL_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, va[0] * vb[0] + va[1] * vb[1] + va[2] * vb[2]);
				break;
			case OP_MUL_FV:
				fa = QPrGetF(st->a);
				QPrGetV(st->b, vb);
				QVecScale(vb, fa, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_MUL_VF:
				QPrGetV(st->a, va);
				fb = QPrGetF(st->b);
				QVecScale(va, fb, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_DIV_F:
				fb = QPrGetF(st->b);
				if (fb == 0.0)
					QPrSetF(st->c, 0.0);
				else
					QPrSetF(st->c, QPrGetF(st->a) / fb);
				break;
			case OP_ADD_F:
				QPrSetF(st->c, QPrGetF(st->a) + QPrGetF(st->b));
				break;
			case OP_ADD_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QVecAdd(va, vb, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_SUB_F:
				QPrSetF(st->c, QPrGetF(st->a) - QPrGetF(st->b));
				break;
			case OP_SUB_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QVecSub(va, vb, vc);
				QPrSetV(st->c, vc);
				break;

			//--- comparison ---
			case OP_EQ_F:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) == QPrGetF(st->b)));
				break;
			case OP_EQ_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] == vb[0] && va[1] == vb[1] &&
					va[2] == vb[2]));
				break;
			case OP_EQ_S:
				QPrSetF(st->c, ToF64(!StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b)))));
				break;
			case OP_EQ_E:
			case OP_EQ_FNC:
				QPrSetF(st->c, ToF64(QPrGetI(st->a) == QPrGetI(st->b)));
				break;
			case OP_NE_F:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) != QPrGetF(st->b)));
				break;
			case OP_NE_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] != vb[0] || va[1] != vb[1] ||
					va[2] != vb[2]));
				break;
			case OP_NE_S:
				QPrSetF(st->c, ToF64(ToBool(StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b))))));
				break;
			case OP_NE_E:
			case OP_NE_FNC:
				QPrSetF(st->c, ToF64(QPrGetI(st->a) != QPrGetI(st->b)));
				break;
			case OP_LE:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) <= QPrGetF(st->b)));
				break;
			case OP_GE:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) >= QPrGetF(st->b)));
				break;
			case OP_LT:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) < QPrGetF(st->b)));
				break;
			case OP_GT:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) > QPrGetF(st->b)));
				break;

			//--- field loads: a is the entity, b the field index ---
			case OP_LOAD_F:
			case OP_LOAD_S:
			case OP_LOAD_ENT:
			case OP_LOAD_FLD:
			case OP_LOAD_FNC:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				break;
			case OP_LOAD_V:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				QPrSetI(st->c + 1, QPrFieldI(ent, fld + 1));
				QPrSetI(st->c + 2, QPrFieldI(ent, fld + 2));
				break;

			case OP_ADDRESS:
				//yields a byte offset into the edict block
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, ent * q_pr_edict_stride + fld * 4);
				break;

			//--- global stores ---
			case OP_STORE_F:
			case OP_STORE_S:
			case OP_STORE_ENT:
			case OP_STORE_FLD:
			case OP_STORE_FNC:
				QPrSetI(st->b, QPrGetI(st->a));
				break;
			case OP_STORE_V:
				QPrSetI(st->b, QPrGetI(st->a));
				QPrSetI(st->b + 1, QPrGetI(st->a + 1));
				QPrSetI(st->b + 2, QPrGetI(st->a + 2));
				break;

			//--- pointer stores ---
			case OP_STOREP_F:
			case OP_STOREP_S:
			case OP_STOREP_ENT:
			case OP_STOREP_FLD:
			case OP_STOREP_FNC:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				break;
			case OP_STOREP_V:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				QPrPtrSetI(ptr + 4, QPrGetI(st->a + 1));
				QPrPtrSetI(ptr + 8, QPrGetI(st->a + 2));
				break;

			//--- logic ---
			case OP_NOT_F:
				//explicit compare against 0.0. ZealC ! on an F64 does not
				//behave like C, and this opcode carries half of QuakeC:
				//  if (!self.yaw_speed) -> monsters that never turn
				//  if (!targ.takedamage) -> the world becomes damageable
				//  if (!self.speed) -> zero-speed doors, divide by zero in
				//    SUB_CalcMove, a think at zero delay that locks the frame
				if (QPrGetF(st->a) == 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_V:
				QPrGetV(st->a, va);
				if (va[0] == 0.0 && va[1] == 0.0 && va[2] == 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_S:
				//same reasoning, no ! on values out of the pool
				i = QPrGetI(st->a);
				if (!i)
					QPrSetF(st->c, 1.0);
				else if (QPrStr(i)[0] == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_FNC:
				//an integer test, matching how a function ref is stored
				if (!QPrGetI(st->a))
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_ENT:
				//only the world counts as no entity
				if (QPrEdictNum(QPrGetI(st->a)) == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_AND:
				//ToBool takes an I64, an F64 arrives as raw bits
				if (QPrGetF(st->a) != 0.0 && QPrGetF(st->b) != 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_OR:
				if (QPrGetF(st->a) != 0.0 || QPrGetF(st->b) != 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_BITAND:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) &
					ToI64(QPrGetF(st->b))));
				break;
			case OP_BITOR:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) |
					ToI64(QPrGetF(st->b))));
				break;

			//--- flow. jumps are relative and the loop pre-increments ---
			//branch tests read the operand as a raw int, as the original does:
			//
			//    case OP_IF:    if (a->_int) ...
			//    case OP_IFNOT: if (!a->_int) ...
			//
			//conditions arrive as every type - floats from comparisons, but
			//also entity, string and function refs stored as small ints. int
			//and float tests agree on most bit patterns, not all: negative
			//zero equals 0.0 while its _int is non-zero
			case OP_IF:
				if (QPrGetI(st->a))
					q_pr_xstatement += st->b - 1;
				break;
			case OP_IFNOT:
				if (!QPrGetI(st->a))
					q_pr_xstatement += st->b - 1;
				break;
			case OP_GOTO:
				q_pr_xstatement += st->a - 1;
				break;

			case OP_STATE:
				//animation step: frame a now, think b in 0.1s. drives every
				//monster and door animation, so it has to be exact
				ent = QPrEdictNum(QPrGetI(q_ofs_self));
				QPrSetFieldF(ent, q_fld_frame, QPrGetF(st->a));
				QPrSetFieldF(ent, q_fld_nextthink, QPrGetF(q_ofs_time) + 0.1);
				QPrSetFieldI(ent, q_fld_think, QPrGetI(st->b));
				break;

			default:
				//--- calls: CALL0..CALL8 encode the argument count ---
				if (OP_CALL0 <= op <= OP_CALL8)
				{
					newfnum = QPrGetI(st->a);
					if (newfnum <= 0 || newfnum >= q_pr_num_functions)
					{
						//caller, callee, self classname, entnum and damage
						//state. Killed on a null th_die says a death function
						//is missing but not on what; entnum 0 with a real
						//classname is the world, entnum 0 with junk is a
						//corrupted self - opposite fixes. the caller separates
						//a bad damage path from a bad T_Damage gate
						ent = QPrEdictNum(QPrGetI(q_ofs_self));

						if (q_pr_depth > 0)
							caller = q_pr_stack[q_pr_depth - 1].function;
						else
							caller = 0;

						StrPrint(q_pr_detail, "%s<-%s self=%s #%d dmg=%d mt=%d",
							QPrStr(q_pr_functions[q_pr_xfunction].name),
							QPrStr(q_pr_functions[caller].name),
							QPrStr(QPrFieldI(ent, q_fld_classname)),
							ent,
							ToI64(QPrFieldF(ent, q_fld_takedamage)),
							ToI64(QPrFieldF(ent, q_fld_movetype)));

						QPrReport2("call to null function from", q_pr_detail);
						q_pr_error = TRUE;
						goto qpr_abort;
					}

					newf = &q_pr_functions[newfnum];

					if (newf->first_statement < 0)
					{
						//builtin, index is the negated first statement
						q_pr_argc = op - OP_CALL0;

						if (q_pr_builtin_call)
							q_pr_builtin_call(-newf->first_statement);
					}
					else
						QPrEnterFunction(newfnum);
				}
				else
				{
					QPrReport2("unknown opcode in",
						QPrStr(q_pr_functions[q_pr_xfunction].name));
					q_pr_error = TRUE;
					goto qpr_abort;
				}
				break;
		}
	}

qpr_abort:
	//an abort MUST put the stacks back. callers just clear the flag and carry
	//on, so a leaked frame per error ratchets depth to the ceiling and every
	//later think, touch and builtin fails - one bad function looks like the
	//whole VM dying
	q_pr_depth      = exit_depth;
	q_pr_localdepth = entry_local;
}

I64 QPrTempString(U8 *s)
{//the one reusable scratch, as PF_ftos/PF_vtos use. NOT a fresh allocation -
 //ftos runs in loops and would exhaust the string heap inside a level
	I64 len;

	if (!q_pr_temp_str)
	{
		if (q_pr_string_alloc + QPR_TEMP_STR_LEN > q_pr_strings_size)
			return 0;

		q_pr_temp_str      = q_pr_string_alloc;
		q_pr_string_alloc += QPR_TEMP_STR_LEN;
	}

	if (!s)
		s = "";

	len = StrLen(s);
	if (len > QPR_TEMP_STR_LEN - 1)
		len = QPR_TEMP_STR_LEN - 1;

	MemCopy(q_pr_strings + q_pr_temp_str, s, len);
	q_pr_strings[q_pr_temp_str + len] = 0;

	return q_pr_temp_str;
}

I64 QPrNewString(U8 *s)
{//append a runtime string, returns its offset. map entity values are not in
 //the compiled blob
	I64 len = StrLen(s);
	I64 ofs;

	if (q_pr_string_alloc + len + 1 > q_pr_strings_size)
	{
		QPrReport2("string heap full", NULL);
		return 0;
	}

	ofs = q_pr_string_alloc;
	MemCopy(q_pr_strings + ofs, s, len);
	q_pr_strings[ofs + len] = 0;
	q_pr_string_alloc += len + 1;

	return ofs;
}

