I64 QPrSpawnEdict()
{//reuse a freed slot, otherwise extend the list
	I64 i;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
		{
			q_pr_edict_free[i] = FALSE;
			MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);
			return i;
		}
	}

	if (q_pr_num_edicts >= q_pr_max_edicts)
	{
		QPrReport2("out of edicts", NULL);
		return 0;
	}

	i = q_pr_num_edicts;
	q_pr_num_edicts++;
	q_pr_edict_free[i] = FALSE;
	MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);

	return i;
}

U0 QPrFreeEdict(I64 num)
{
	if (num <= 0 || num >= q_pr_max_edicts)
		return;

	MemSet(q_pr_edicts + num * q_pr_edict_stride, 0, q_pr_edict_stride);
	q_pr_edict_free[num] = TRUE;
}

U0 QPrReport()
{
	"  version      %d\n", QPR_VERSION;
	"  statements   %6d\n", q_pr_num_statements;
	"  globaldefs   %6d\n", q_pr_num_globaldefs;
	"  fielddefs    %6d\n", q_pr_num_fielddefs;
	"  functions    %6d\n", q_pr_num_functions;
	"  strings      %6d bytes\n", q_pr_strings_size;
	"  globals      %6d cells\n", q_pr_num_globals;
	"  entityfields %6d (stride %d bytes)\n", q_pr_entity_fields,
		q_pr_edict_stride;
}
