I64 q_fld_blocked	= -1;
I64 q_fld_chain		= -1;	//findradius list, T_RadiusDamage walks it

//client fields, driven every frame
I64 q_fld_v_angle		= -1;
I64 q_fld_fixangle		= -1;
I64 q_fld_button0		= -1;
I64 q_fld_button1		= -1;
I64 q_fld_button2		= -1;
I64 q_fld_impulse		= -1;
