// RunNet.ZC - Quake with networking. Run this instead of Run.ZC to play UDP.
//
// Separate entry point because the binding is compile-time: single-pass
// compiler, so UDPSocket must resolve when QNetUdp.ZC is read. Picking
// Multiplayer from the menu is too late.
//
// The driver probe throws 'NODRIVER' with no supported NIC, and pulls in TCP,
// TLS, crypto and HTTP. Single player skips it.

Cd(__DIR__);;

#ifndef UDP_MAX_PORT
#include "::/Home/Net/Load"
Cd(__DIR__);;
#endif

#include "Run"
