// Quake with networking. Run this instead of Run.ZC to play UDP.
//
// separate entry point because the binding is compile-time: single-pass
// compiler, so UDPSocket must resolve when QNetUdp.ZC is read.
//
// the driver probe throws 'NODRIVER' with no supported NIC, and pulls in TCP,
// TLS, crypto and HTTP.

Cd(__DIR__);;

#ifndef UDP_MAX_PORT
#include "::/Home/Net/Load"
Cd(__DIR__);;
#endif

#include "Run"
