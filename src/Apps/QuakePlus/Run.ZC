// Run.ZC - build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier one,
// so this order is load-bearing
//
//   QFmt  byte readers            (no deps)
//   QPak  archive                 -> QFmt
//   QPal  palette/colormap        -> QPak
//   QMath vectors, view basis     (no deps)
//   QBSP  map loader              -> QFmt, QPak
//   QVis  PVS + traversal         -> QMath, QBSP
//   QPhys collision + movement    -> QMath, QBSP
//   QDraw rasterizer              -> QMath, QBSP, QPal, QVis
//   QMDL  alias models            -> QDraw, QBSP
//   QProgs QuakeC bytecode VM     -> QFmt, QPak, QMath
//   QBuiltin QuakeC engine calls  -> QProgs, QPhys, QMDL
//   QEnt  entities + spawning     -> QMath, QBSP, QMDL
//   QNetUdp real transport         -> QNet (+ ::/Home/Net if loaded)
//   QNetSv server datagram/client parse -> QNet, QNetUdp, QProgs, QGame, QVis
//   QTest self-checks             -> everything above
//   Quake app shell               -> everything above

Cd(__DIR__);;

#include "QFmt"
#include "QPak"
#include "QPal"
#include "QMath"
#include "QNet"

// net stack is NOT loaded here - the NIC probe THROWS with no supported card,
// and drags in TCP/TLS/HTTP. RunNet.ZC loads it first, then this file; QNetUdp
// builds real transport or stubs depending on what's already present.

#include "QNetUdp"
#include "QNetDgrm"
#include "QDemo"
#include "QBSP"
#include "QVis"
#include "QPhys"
#include "QDraw"
#include "QMDL"
#include "QSpr"
#include "QPart"
#include "QSound"
#include "QWad"
#include "QProgs"
#include "QClip"
#include "QBuiltin"
#include "QEnt"
#include "QGame"
#include "QNetSv"
#include "QSave"
#include "QPlayer"
#include "QSbar"
#include "QMenu"
#include "QTest"
#include "Quake"

Quake;

//QTest is not run here - Quake DocClears on startup and wipes anything
//printed first. symbols stay live in this task, so run QTest; from the
//prompt after quitting.
"\nType $$LTBLUE$$QTest;$$FG$$ to run the data-layer self-check.\n";
