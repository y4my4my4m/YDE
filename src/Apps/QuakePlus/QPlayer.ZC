// QPlayer.ZC - the player as a real QuakeC client edict
//
//   spawn   ClientConnect then PutClientInServer - health, weapon, inventory
//   frame   publish input and position, PlayerPreThink, move,
//           PlayerPostThink, then read back what QuakeC changed
//
// QuakeC owns health, weapons and teleports, so the read-back is mandatory

//entity flags and solidity for the touch pass, QFL_CLIENT lives in QGame.ZC
#define QFL_ONGROUND	512
#define QFL_WATERJUMP	2048

#define QSOLID_NOT		0
#define QSOLID_TRIGGER	1

#define QDEAD_NO		0

//q_player_active lives next to q_player_edict in QProgs.ZC (QNetSv needs it)
I64	 q_player_touches	= 0;

U0 QPlayerSetVec(I64 fld, F64 x, F64 y, F64 z)
{
	QPrSetFieldF(q_player_edict, fld, x);
	QPrSetFieldF(q_player_edict, fld + 1, y);
	QPrSetFieldF(q_player_edict, fld + 2, z);
}

Bool QPlayerSpawn(F64 *origin, F64 *angles, U8 *player_name)
{//hand the reserved edict to QuakeC and let it outfit the player
	I64 fn;
	U8 *netname;

	q_player_active  = FALSE;
	q_player_touches = 0;

	if (q_player_edict <= 0)
		return FALSE;

	if (!player_name || !player_name[0])
		netname = "player";
	else
		netname = player_name;

	//minimum state PutClientInServer expects to find already set
	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_angles, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_velocity, 0.0, 0.0, 0.0);
	QPlayerSetVec(q_fld_mins, QPL_MINS_XY, QPL_MINS_XY, QPL_MINS_Z);
	QPlayerSetVec(q_fld_maxs, QPL_MAXS_XY, QPL_MAXS_XY, QPL_MAXS_Z);
	QPlayerSetVec(q_fld_view_ofs, 0.0, 0.0, QPL_VIEW_OFS_Z);

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(QFL_CLIENT));
	QPrSetFieldI(q_player_edict, q_fld_classname, QPrNewString("player"));
	//ClientConnect bprints self.netname
	QPrSetFieldI(q_player_edict, q_fld_netname, QPrNewString(netname));

	//SetNewParms fills the spawn parm globals ClientConnect reads
	fn = QPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
	{
		"QPlayer: PutClientInServer missing\n";
		return FALSE;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	//PutClientInServer wipes runtime fields, pin the name again
	QPrSetFieldI(q_player_edict, q_fld_netname, QPrNewString(netname));

	//PutClientInServer picks its own spawn point, adopt what it chose
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	q_player_active = TRUE;

	//PutClientInServer assigns th_die = PlayerDie, and a VM error aborts
	//mid-function - unset th_die means death never runs at all
	if (q_fld_th_die >= 0 && !QPrFieldI(q_player_edict, q_fld_th_die))
		QLog("player: WARNING th_die unset, death will not work\n");

	return TRUE;
}

Bool QPlayerBoxTouches(I64 ent, F64 *org)
{//SV_TouchLinks overlap test - the two STORED absolute boxes, never boxes
 //rebuilt from origin and size. SV_LinkEdict PADS what it stores:
 //  FL_ITEM   15 units in X and Y, so items grab from beside and off ledges
 //  everything 1 unit on every axis, moves stop an epsilon short of a surface
	F64 emins[3];
	F64 emaxs[3];
	F64 pmins[3];
	F64 pmaxs[3];
	F64 eorg[3];
	I64 i;

	if (q_fld_absmin >= 0 && q_fld_absmax >= 0)
	{
		//caller linked the player box just before this, both sides current
		for (i = 0; i < 3; i++)
		{
			emins[i] = QPrFieldF(ent, q_fld_absmin + i);
			emaxs[i] = QPrFieldF(ent, q_fld_absmax + i);
			pmins[i] = QPrFieldF(q_player_edict, q_fld_absmin + i);
			pmaxs[i] = QPrFieldF(q_player_edict, q_fld_absmax + i);
		}
	}
	else
	{
		//no abs fields in this progs.dat - raw boxes plus the 1 unit
		//slack SV_LinkEdict would have applied
		eorg[0] = QPrFieldF(ent, q_fld_origin);
		eorg[1] = QPrFieldF(ent, q_fld_origin + 1);
		eorg[2] = QPrFieldF(ent, q_fld_origin + 2);

		for (i = 0; i < 3; i++)
		{
			emins[i] = eorg[i] + QPrFieldF(ent, q_fld_mins + i) - 1.0;
			emaxs[i] = eorg[i] + QPrFieldF(ent, q_fld_maxs + i) + 1.0;
		}

		pmins[0] = org[0] + QPL_MINS_XY - 1.0;
		pmins[1] = org[1] + QPL_MINS_XY - 1.0;
		pmins[2] = org[2] + QPL_MINS_Z  - 1.0;
		pmaxs[0] = org[0] + QPL_MAXS_XY + 1.0;
		pmaxs[1] = org[1] + QPL_MAXS_XY + 1.0;
		pmaxs[2] = org[2] + QPL_MAXS_Z  + 1.0;
	}

	for (i = 0; i < 3; i++)
	{
		if (pmins[i] > emaxs[i] || pmaxs[i] < emins[i])
			return FALSE;
	}

	return TRUE;
}

U0 QPlayerTouchTriggers(F64 *org, F64 *velocity)
{//run touch on every trigger the player is inside - doors, items, teleporters
	I64 i;
	I64 touch;
	I64 j;

	//publish the CURRENT position before touching anything - the read-back
	//below is unconditional and a stale edict drags the player backwards
	//every step. QuakeC's own box tests read .origin and .absmin/.absmax too
	for (j = 0; j < 3; j++)
	{
		QPrSetFieldF(q_player_edict, q_fld_origin + j, org[j]);
		QPrSetFieldF(q_player_edict, q_fld_velocity + j, velocity[j]);
	}

	QGameLinkEdict(q_player_edict);

	i = 1;
	while (i < q_pr_num_edicts)
	{
		if (!q_pr_edict_free[i] && i != q_player_edict)
		{
			if (QPrFieldF(i, q_fld_solid) == ToF64(QSOLID_TRIGGER))
			{
				touch = QPrFieldI(i, q_fld_touch);

				if (touch > 0 && touch < q_pr_num_functions &&
					QPlayerBoxTouches(i, org))
				{
					//touch runs on the trigger, player is "other"
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, QPrEdictValue(q_player_edict));
					QPrExecute(touch);
					q_pr_error = FALSE;
					q_player_touches++;

					//a touch can MOVE the player - teleporters do - so adopt
					//the new position now or post-think pushes the old one
					//back and the trigger refires forever. safe to read
					//unconditionally only because of the publish above
					org[0] = QPrFieldF(q_player_edict, q_fld_origin);
					org[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
					org[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

					//teleporters set a launch velocity too
					velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
					velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
					velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

					//relink so later triggers this pass see the new bounds
					QGameLinkEdict(q_player_edict);
				}
			}
		}

		i++;
	}
}

Bool QPlayerWaterJump(F64 *velocity, F64 game_time)
{//service an in-progress water jump, TRUE while one runs
 //QuakeC sets the flag and the up velocity, the engine owns the END - clear
 //it out of liquid or on timeout, else gravity is skipped forever
	I64 flags;

	if (!q_player_active)
		return FALSE;

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));

	if (!(flags & QFL_WATERJUMP))
		return FALSE;

	//out of the water, or timed out
	if (QPrFieldF(q_player_edict, q_fld_waterlevel) == 0.0 ||
		game_time > QPrFieldF(q_player_edict, q_fld_teleport_time))
	{
		QPrSetFieldF(q_player_edict, q_fld_flags,
			ToF64(flags & ~QFL_WATERJUMP));
		QPrSetFieldF(q_player_edict, q_fld_teleport_time, 0.0);
		return FALSE;
	}

	//horizontal push comes from movedir, the ledge normal QuakeC recorded
	velocity[0] = QPrFieldF(q_player_edict, q_fld_movedir);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_movedir + 1);

	return TRUE;
}

U0 QPlayerWater(I64 level, I64 type)
{//publish liquid depth - QuakeC keys swimming, drowning, splash and tint here
	if (!q_player_active)
		return;

	QPrSetFieldF(q_player_edict, q_fld_waterlevel, ToF64(level));
	QPrSetFieldF(q_player_edict, q_fld_watertype, ToF64(type));
}

U0 QPlayerPreThink(F64 *origin, F64 *velocity, F64 *angles, Bool on_ground,
	Bool attack, Bool jump, I64 impulse)
{//publish the engine's view of the player, then let QuakeC react
	I64 fn;
	I64 flags;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//SV_ClientThink: the body leans a THIRD of the view pitch, inverted -
	//    ent->v.angles[PITCH] = -ent->v.v_angle[PITCH] / 3
	//zeroing it left every player standing bolt upright to everyone else.
	//v_angle keeps the full view, which is what the weapon code aims along
	QPlayerSetVec(q_fld_angles, -angles[0] / 3.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, angles[0], angles[1], angles[2]);

	//touch only the two bits the engine owns - overwriting the field destroys
	//FL_JUMPRELEASED, FL_INWATER, FL_WATERJUMP and FL_GODMODE
	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags |= QFL_CLIENT;

	if (on_ground)
		flags |= QFL_ONGROUND;
	else
		flags &= ~QFL_ONGROUND;

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	QPrSetFieldF(q_player_edict, q_fld_button0, ToF64(attack));
	QPrSetFieldF(q_player_edict, q_fld_button2, ToF64(jump));
	//only when non-zero, as SV_ReadClientMove does. ImpulseCommands clears the
	//field in post-think, so an empty tick must not wipe a pending impulse
	if (impulse)
		QPrSetFieldF(q_player_edict, q_fld_impulse, ToF64(impulse));

	fn = QPrFindFunction("PlayerPreThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//read velocity back - PlayerJump runs inside PreThink and adds the jump
	//impulse onto the edict. a stale copy discards it inside the same tick
	velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
	velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

	//QuakeC can teleport or shove during pre-think
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	//.impulse is DELIBERATELY NOT CLEARED HERE - ImpulseCommands reaches it
	//from PlayerPOSTthink via W_WeaponFrame and zeroes it once it has acted.
	//SV_ReadClientMove only ever sets it
}

U0 QPlayerPostThink(F64 *origin, F64 *velocity, F64 *angles,
	Bool on_ground = FALSE, I64 water_level = 0, I64 water_type = 0)
{//run the post-move logic, then accept whatever QuakeC decided
	I64  fn;
	I64  flags;
	F64  fixangle;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//refresh FL_ONGROUND after the move - PostThink's landing test reads
	//    (self.jump_flag < -300) && (self.flags & FL_ONGROUND)
	//and PreThink's pre-move value says airborne on the frame that matters.
	//SV_WalkMove sets it on the edict itself
	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	if (on_ground)
		flags |= QFL_ONGROUND;
	else
		flags &= ~QFL_ONGROUND;
	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	//watertype picks the splash variant of the landing sound
	if (q_fld_waterlevel >= 0)
		QPrSetFieldF(q_player_edict, q_fld_waterlevel, ToF64(water_level));
	if (q_fld_watertype >= 0)
		QPrSetFieldF(q_player_edict, q_fld_watertype, ToF64(water_type));

	fn = QPrFindFunction("PlayerPostThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//QuakeC owns teleports and knockback, its position wins
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
	velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

	//fixangle: a teleporter asking for a view snap
	fixangle = QPrFieldF(q_player_edict, q_fld_fixangle);
	if (fixangle != 0.0)
	{
		angles[0] = QPrFieldF(q_player_edict, q_fld_angles);
		angles[1] = QPrFieldF(q_player_edict, q_fld_angles + 1);
		angles[2] = QPrFieldF(q_player_edict, q_fld_angles + 2);
		QPrSetFieldF(q_player_edict, q_fld_fixangle, 0.0);
	}
}

F64 QPlayerHealth()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_health);
}

F64 QPlayerArmor()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_armorvalue);
}

F64 QPlayerAmmo()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_currentammo);
}

F64 QPlayerViewHeight()
{//cl.viewheight - NOT a constant, QuakeC owns .view_ofs
 //PlayerDie sets it to '0 0 -8' so the camera drops with the body, and it
 //moves for crouching in liquid
	if (!q_player_active || q_player_edict <= 0 || q_fld_view_ofs < 0)
		return QPL_VIEW_OFS_Z;

	return QPrFieldF(q_player_edict, q_fld_view_ofs + 2);
}

Bool QPlayerDead()
{
	if (!q_player_active)
		return FALSE;

	return ToBool(QPrFieldF(q_player_edict, q_fld_deadflag) != ToF64(QDEAD_NO)
		|| QPlayerHealth <= 0.0);
}

Bool QPlayerWalking()
{//TRUE while the player entity is still MOVETYPE_WALK
 //PlayerDie switches to MOVETYPE_TOSS and the corpse becomes an ordinary
 //falling object, the way SV_Physics_Client dispatches it
	if (!q_player_active || q_player_edict <= 0)
		return TRUE;

	return ToBool(ToI64(QPrFieldF(q_player_edict, q_fld_movetype)) ==
		QMOVETYPE_WALK);
}

Bool QPlayerFrozen()
{//TRUE when movement input must be ignored entirely
 //SV_ClientThink returns early on MOVETYPE_NONE (intermission parks the
 //client there) and on health <= 0, before it reads the move
	I64 movetype;

	if (!q_player_active || q_player_edict <= 0)
		return FALSE;

	movetype = ToI64(QPrFieldF(q_player_edict, q_fld_movetype));
	if (movetype == QMOVETYPE_NONE)
		return TRUE;

	return ToBool(QPlayerHealth <= 0.0);
}

U8 *QPlayerWeaponModel()
{//view model QuakeC wants shown, e.g. "progs/v_shot.mdl"
	I64 s;

	if (!q_player_active)
		return NULL;

	s = QPrFieldI(q_player_edict, q_fld_weaponmodel);
	if (!s)
		return NULL;

	return QPrStr(s);
}

I64 QPlayerWeaponFrame()
{
	if (!q_player_active)
		return 0;

	return ToI64(QPrFieldF(q_player_edict, q_fld_weaponframe));
}
