// FBCache.ZC - framebuffer page cache attributes and delivered write bandwidth.
//
// Run from the ZealOS prompt:  #include "::/Apps/QuakePlus/FBCache"
//
// GrScreen.ZC:623 copies text.buffer_size bytes to text.fb_alias every frame.
// fb_alias is sys_framebuffer_addr, mapped by the identity map in
// PageTables.ZC. The kernel programs no MTRRs and no PAT, so the attribute is
// whatever the PTE carries.
//
// PTE bit 3 PWT, bit 4 PCD:
//   PCD=0        write-back, ~10 GB/s
//   PCD=1        uncached, one PCIe transaction per store, ~100-200 MB/s
//
// UC on a framebuffer costs 50-100x on the blit and nothing on anything else.

U0 FBCache()
{
	I64		*pte;
	I64		 e;
	I64		 i;
	I64		 bytes;
	U8		*scratch;
	F64		 t0;
	F64		 fb_secs;
	F64		 ram_secs;
	F64		 ratio;
	I64		 reps = 16;

	bytes = text.buffer_size;

	"\n$$LTBLUE$$FBCache$$FG$$\n";
	"  fb_alias      %016X\n", text.fb_alias;
	"  buffer_size   %10d bytes  (%d KiB)\n", bytes, bytes >> 10;

	pte = MemPageTable(text.fb_alias);
	if (!pte)
	{
		"$$RED$$  no page table entry$$FG$$\n";
		return;
	}
	e = *pte;

	"  PTE           %016X\n", e;
	"  present       %d\n", e & 1;
	"  writable      %d\n", (e >> 1) & 1;
	"  PWT           %d\n", (e >> 3) & 1;
	"  PCD           %d\n", (e >> 4) & 1;
	"  2MiB page     %d\n", (e >> 7) & 1;

	//write into the real framebuffer, then into ordinary heap of equal size
	t0 = tS;
	for (i = 0; i < reps; i++)
		MemSetU32(text.fb_alias, BLACK32, text.screen_size);
	fb_secs = tS - t0;

	scratch = MAlloc(bytes);
	t0 = tS;
	for (i = 0; i < reps; i++)
		MemSetU32(scratch, BLACK32, text.screen_size);
	ram_secs = tS - t0;
	Free(scratch);

	"\n  framebuffer   %8.1f MB/s\n",
		ToF64(bytes * reps) / fb_secs / 1000000.0;
	"  heap RAM      %8.1f MB/s\n",
		ToF64(bytes * reps) / ram_secs / 1000000.0;
	ratio = 0.0;
	if (ram_secs > 0.0)
		ratio = fb_secs / ram_secs;
	"  ratio         %8.1fx\n", ratio;

	if (e & 0x10)
		"\n$$RED$$  PCD set: framebuffer is uncached.$$FG$$\n";
	else
		"\n$$GREEN$$  PCD clear: framebuffer is cacheable.$$FG$$\n";
}

FBCache;
