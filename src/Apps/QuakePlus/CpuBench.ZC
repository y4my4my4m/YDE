// delivered per-core compute and memory latency. CPURep reports
// nominal TSC rate only.
//   ops   - dependent integer chain, clock and IPC bound, cache resident
//   chase - pointer chase over 64MiB, DRAM latency bound, defeats prefetch

#define CB_CHASE_BYTES	(64 * 1024 * 1024)
#define CB_LINE			64

U0 CpuBench(F64 secs = 1.5)
{
	I64	 i;
	I64	 acc = 0;
	I64	 iters = 0;
	I64	 tsc0;
	I64	 tsc1;
	I64	 n;
	I64	 idx;
	I64	 hops;
	I64	 rng;
	I64	 j;
	I64	 tmp;
	I64	*chase;
	F64	 t0;
	F64	 elapsed;
	F64	 fa;
	F64	 fb;
	I64	 fops;
	F64	 mops;
	F64	 tsc_ghz;
	F64	 ns;

	"\n$$LTBLUE$$CpuBench$$FG$$\n";

	t0   = tS;
	tsc0 = TSCGet;
	while (tS - t0 < secs)
	{
		for (i = 0; i < 1000000; i++)
			acc = (acc + i) ^ iters;
		iters++;
	}
	tsc1    = TSCGet;
	elapsed = tS - t0;

	mops    = ToF64(iters) * 1000000.0 / elapsed / 1000000.0;
	tsc_ghz = ToF64(tsc1 - tsc0) / elapsed / 1000000000.0;

	"  ops        %10.1f Mops/s\n", mops;
	"  TSC rate   %10.3f GHz   (nominal, not the running clock)\n", tsc_ghz;

	n     = CB_CHASE_BYTES / CB_LINE;
	chase = MAlloc(CB_CHASE_BYTES);
	if (!chase)
	{
		"$$RED$$  no memory for the chase buffer$$FG$$\n";
		return;
	}

	for (i = 0; i < n; i++)
		chase[i * (CB_LINE / 8)] = i;

	//Fisher-Yates with an LCG
	rng = 0x2545F4914F6CDD1D;
	for (i = n - 1; i > 0; i--)
	{
		rng = rng * 6364136223846793005 + 1442695040888963407;
		j   = ((rng >> 33) & 0x7FFFFFFF) % (i + 1);
		tmp = chase[i * (CB_LINE / 8)];
		chase[i * (CB_LINE / 8)] = chase[j * (CB_LINE / 8)];
		chase[j * (CB_LINE / 8)] = tmp;
	}

	hops = 0;
	idx  = 0;
	t0   = tS;
	while (tS - t0 < secs)
	{
		for (i = 0; i < 100000; i++)
			idx = chase[idx * (CB_LINE / 8)];
		hops += 100000;
	}
	elapsed = tS - t0;
	Free(chase);

	ns = elapsed * 1000000000.0 / ToF64(hops);
	"  chase      %10.1f ns/access  (64MiB random, idx %d)\n", ns, idx;

	fa   = 1.0;
	fb   = 1.0000001;
	fops = 0;
	t0   = tS;
	while (tS - t0 < secs)
	{
		for (i = 0; i < 1000000; i++)
			fa = fa * fb + 0.5;
		fops += 1000000;
	}
	elapsed = tS - t0;
	"  fmul       %10.1f Mops/s  (dependent, acc %8.4f)\n",
		ToF64(fops) / elapsed / 1000000.0, fa - ToI64(fa);

	fa   = 1.0;
	fops = 0;
	t0   = tS;
	while (tS - t0 < secs)
	{
		for (i = 0; i < 1000000; i++)
			fa = 1000000.0 / (fa + 1.5);
		fops += 1000000;
	}
	elapsed = tS - t0;
	"  fdiv       %10.1f Mops/s  (dependent, acc %8.4f)\n",
		ToF64(fops) / elapsed / 1000000.0, fa - ToI64(fa);

	"\n  ops/chase gap  -> integer speed or memory latency\n";
	"  fdiv gap       -> float divide, one per span for 1/z\n";
}

CpuBench;
