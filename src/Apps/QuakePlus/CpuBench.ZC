// CpuBench.ZC - actual delivered CPU throughput.
//
// Run from the ZealOS prompt:  #include "::/Apps/QuakePlus/CpuBench"
//
// ZealOS programs no P-states and no HWP, so the core runs at whatever the
// firmware left. A laptop parked at its lowest multiplier on battery delivers
// a fraction of its rated clock, and nothing in the OS reports it.
//
// Two figures: integer ops via TSC (nominal, invariant) and via tS (wall).
// TSC counts at the nominal frequency regardless of the current P-state, so
// wall-clock is the one that reflects delivered speed.

U0 CpuBench(F64 secs = 2.0)
{
	I64	i;
	I64	acc = 0;
	I64	iters = 0;
	I64	tsc0;
	I64	tsc1;
	F64	t0;
	F64	elapsed;
	F64	mops;
	F64	tsc_ghz;

	"\n$$LTBLUE$$CpuBench$$FG$$  %2.1fs tight integer loop\n", secs;

	t0   = tS;
	tsc0 = TSCGet;

	while (tS - t0 < secs)
	{
		//1M ops between clock reads: tS is a SysTimerRead and costs
		//microseconds, so checking it per op would measure the clock
		for (i = 0; i < 1000000; i++)
			acc += i ^ iters;
		iters++;
	}

	tsc1    = TSCGet;
	elapsed = tS - t0;

	mops    = ToF64(iters) * 1000000.0 / elapsed / 1000000.0;
	tsc_ghz = ToF64(tsc1 - tsc0) / elapsed / 1000000000.0;

	"  loop ops   %10.1f Mops/s\n", mops;
	"  TSC rate   %10.3f GHz  (nominal, not the running clock)\n", tsc_ghz;
	"  acc        %10d  (keeps the loop alive)\n", acc & 0xFFFF;
	"\n  compare this number between QEMU and hardware.\n";
	"  a large gap is the core parked at a low multiplier.\n";
}

CpuBench;
