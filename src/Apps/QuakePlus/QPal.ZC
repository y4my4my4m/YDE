// QPal.ZC - palette and colormap
//
//   gfx/palette.lmp   768 bytes, 256 RGB triples
//   gfx/colormap.lmp  64 shade rows of 256 bytes, row r maps an index to what
//                     that colour becomes at light level r
//
// this tree's CDC is truecolor, so the palette is also kept expanded to
// 0x00RRGGBB for the blit

#define QPAL_COLORS			256
#define QPAL_SHADES			64
#define QPAL_FULLBRIGHT		224		//indices >= this ignore lighting

U8	 qpal_rgb[QPAL_COLORS * 3];
U32	 qpal_argb[QPAL_COLORS];		//gamma and contrast, no cshift
U32	 qpal_raw_argb[QPAL_COLORS];	//no gamma, no cshift - fog blends in this
U8	*qpal_colormap = NULL;
Bool qpal_loaded = FALSE;

//5-5-5 RGB → palette index. skybox TGA quantize and any truecolor→8bpp path
U8	 qpal_nearest555[32768];
Bool qpal_nearest_ready = FALSE;

U0 QPalBuildNearest()
{//32*32*32 * 256 distance checks, once per palette load
	I64 r;
	I64 g;
	I64 b;
	I64 i;
	I64 best;
	I64 bd;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;
	I64 rr;
	I64 gg;
	I64 bb;

	for (r = 0; r < 32; r++)
	{
		rr = r << 3;
		for (g = 0; g < 32; g++)
		{
			gg = g << 3;
			for (b = 0; b < 32; b++)
			{
				bb   = b << 3;
				best = 0;
				bd   = 1 << 30;

				for (i = 0; i < QPAL_COLORS; i++)
				{
					dr = rr - qpal_rgb[i * 3];
					dg = gg - qpal_rgb[i * 3 + 1];
					db = bb - qpal_rgb[i * 3 + 2];
					d  = dr * dr + dg * dg + db * db;
					if (d < bd)
					{
						bd   = d;
						best = i;
					}
				}

				qpal_nearest555[(r << 10) | (g << 5) | b] = best;
			}
		}
	}

	qpal_nearest_ready = TRUE;
}

U8 QPalNearestRGB(I64 r, I64 g, I64 b)
{
	if (!qpal_nearest_ready)
		return 0;

	if (r < 0)	r = 0;
	if (r > 255)	r = 255;
	if (g < 0)	g = 0;
	if (g > 255)	g = 255;
	if (b < 0)	b = 0;
	if (b > 255)	b = 255;

	return qpal_nearest555[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)];
}

//the multiplier each colormap row applies, as a continuous scalar.
//
//interpolating between the palette colours two colormap rows name quantizes
//both endpoints to the 256-entry palette, so a smooth lightmap walks a coarse
//staircase of palette entries - banding on any large lit gradient.
//
//not normalised against row 0. Quake's colormap is overbright at the top: the
//median per-texel ratio of row 0 against the raw palette is 1.90, so treating
//row 0 as unity throws away most of a lit surface's brightness and crushes
//every midtone.
//
//luma-weighted least squares over the whole palette rather than one reference
//entry. a single entry stair-steps (index 15 quantizes to itself for the top
//24 rows), and a plain average is dragged down by dark entries that clamp to
//black long before the bright ones do.
F64 qpal_shade_scale[QPAL_SHADES];

U0 QPalBuildShadeScale()
{//least squares fit of row r against the identity mapping
	I64 row;
	I64 i;
	I64 c;
	F64 num;
	F64 den = 0.0;
	F64 lum;

	//fullbrights are exempt from lighting and would bias the fit
	for (i = 0; i < QPAL_FULLBRIGHT; i++)
	{
		lum  = ToF64(qpal_rgb[i * 3]) + ToF64(qpal_rgb[i * 3 + 1]) +
			   ToF64(qpal_rgb[i * 3 + 2]);
		den += lum * lum;
	}

	if (den <= 0.0)
		den = 1.0;

	for (row = 0; row < QPAL_SHADES; row++)
	{
		num = 0.0;

		for (i = 0; i < QPAL_FULLBRIGHT; i++)
		{
			c    = qpal_colormap[row * QPAL_COLORS + i];
			lum  = ToF64(qpal_rgb[i * 3]) + ToF64(qpal_rgb[i * 3 + 1]) +
				   ToF64(qpal_rgb[i * 3 + 2]);
			num += (ToF64(qpal_rgb[c * 3]) + ToF64(qpal_rgb[c * 3 + 1]) +
					ToF64(qpal_rgb[c * 3 + 2])) * lum;
		}

		qpal_shade_scale[row] = num / den;
	}
}

Bool QPalLoad()
{//pull both tables out of the mounted paks
	U8  *p;
	I64  size = 0;
	I64  i;

	qpal_loaded   = FALSE;
	qpal_colormap = NULL;

	p = QPakData("gfx/palette.lmp", &size);
	if (!p || size < QPAL_COLORS * 3)
	{
		"QPal: gfx/palette.lmp missing or short\n";
		return FALSE;
	}
	MemCopy(qpal_rgb, p, QPAL_COLORS * 3);

	for (i = 0; i < QPAL_COLORS; i++)
	{
		qpal_argb[i] = (qpal_rgb[i * 3] << 16) |
					   (qpal_rgb[i * 3 + 1] << 8) |
						qpal_rgb[i * 3 + 2];
		qpal_raw_argb[i] = qpal_argb[i];
	}

	p = QPakData("gfx/colormap.lmp", &size);
	if (!p || size < QPAL_COLORS * QPAL_SHADES)
	{
		"QPal: gfx/colormap.lmp missing or short\n";
		return FALSE;
	}

	//borrowed, the pak stays mounted for the life of the program
	qpal_colormap = p;
	qpal_loaded   = TRUE;

	QPalBuildNearest;
	QPalBuildShadeScale;

	return TRUE;
}

U32 QPalColor(I64 index)
{//palette index to 0x00RRGGBB
	return qpal_argb[index & 255];
}

//--- screen tint -----------------------------------------------------------
//
// 8bpp indices can't be blended - averaging index 10 and 14 gives an unrelated
// colour - so the wash is folded into the palette, as the original does

I64	 q_tint_r	= 0;
I64	 q_tint_g	= 0;
I64	 q_tint_b	= 0;
I64	 q_tint_a	= 0;		//0 = no tint, 255 = fully the tint colour

//--- gamma -----------------------------------------------------------------
//
// applied by rebuilding the palette, so it costs nothing per frame and covers
// the HUD and menus too
//
// 1.0 is untouched, lower brightens - same sense as the original's slider
#define QGAMMA_MIN	0.5
#define QGAMMA_MAX	1.0

F64 q_gamma			= 1.0;
F64 q_contrast		= 1.0;		//vid_contrast, clamped 1..2 as the shader does
U8	q_gamma_ramp[256];
Bool q_gamma_dirty	= TRUE;

//the fused fog+gamma table in QDraw is built from both the fog colour and the
//gamma ramp, and neither file can see the other's globals - the flag lives
//here because QPal compiles first
Bool q_fogpost_dirty = TRUE;

U0 QPalBuildGammaRamp()
{//the postprocess shader, in its order:
 //    out_fragcolor.rgb *= contrast;
 //    out_fragcolor = vec4(pow(out_fragcolor.rgb, vec3(gamma)), 1.0);
 //contrast is a plain multiply BEFORE the gamma curve, clamped 1..2:
 //    GL_Uniform2fFunc (0, vid_gamma.value, CLAMP (1.0f, vid_contrast.value, 2.0f))
	F64 g = q_gamma;
	F64 k = q_contrast;
	F64 v;
	I64 i;

	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	if (k < 1.0)	k = 1.0;
	if (k > 2.0)	k = 2.0;

	for (i = 0; i < 256; i++)
	{
		if (g == 1.0 && k == 1.0)
			q_gamma_ramp[i] = i;
		else
		{
			v = ToF64(i) / 255.0 * k;
			if (v > 1.0)
				v = 1.0;

			v = Pow(v, g) * 255.0;
			q_gamma_ramp[i] = ClampI64(ToI64(v + 0.5), 0, 255);
		}
	}

	q_gamma_dirty   = FALSE;
	q_fogpost_dirty = TRUE;		//the ramp is baked into it
}

//TRUE when gamma is a no-op, so truecolor pixels can go to the screen
//untouched. the cshift is not part of this: it belongs to the 3D view and is
//applied by QFogBakeCanvas, not by the blit
Bool qpal_post_identity = TRUE;

U0 QPalRebuild()
{//rebuild the display palette from tint and gamma
 //
 //one palette, gamma and contrast only. the cshift is not in it: R_PolyBlend
 //is a blend over the 3D view that Sbar_Draw and the console draw on top of,
 //and QFogBakeCanvas stages it per pixel between the fog and the ramp. baking
 //it into the palette tints the HUD and the menu along with the world
	I64 i;
	I64 sr;
	I64 sg;
	I64 sb;

	if (q_gamma_dirty)
		QPalBuildGammaRamp;

	for (i = 0; i < QPAL_COLORS; i++)
	{
		sr = q_gamma_ramp[qpal_rgb[i * 3]];
		sg = q_gamma_ramp[qpal_rgb[i * 3 + 1]];
		sb = q_gamma_ramp[qpal_rgb[i * 3 + 2]];

		qpal_argb[i] = (sr << 16) | (sg << 8) | sb;

		qpal_raw_argb[i] = (qpal_rgb[i * 3] << 16) |
						   (qpal_rgb[i * 3 + 1] << 8) |
							qpal_rgb[i * 3 + 2];
	}

	qpal_post_identity = ToBool(q_gamma == 1.0 && q_contrast == 1.0);
}


U32 QPalTintRGB(U32 rgb)
{//the cshift alone. R_PolyBlend sits between the world pass and the gamma
 //postprocess, so it is applied after fog and before the ramp
	I64 sr = (rgb >> 16) & 255;
	I64 sg = (rgb >> 8) & 255;
	I64 sb = rgb & 255;
	I64 a  = q_tint_a;

	if (!a)
		return rgb;

	//same shift trick as the fog blend: this is per blitted pixel
	a++;
	sr = sr + (((q_tint_r - sr) * a) >> 8);
	sg = sg + (((q_tint_g - sg) * a) >> 8);
	sb = sb + (((q_tint_b - sb) * a) >> 8);

	return (ClampI64(sr, 0, 255) << 16) | (ClampI64(sg, 0, 255) << 8) |
			ClampI64(sb, 0, 255);
}

U32 QPalGammaRGB(U32 rgb)
{//gamma over a literal colour. truecolor pixels bypass the palette, so they
 //have to be put through the ramp here instead. no tint - this is the 2D path
	I64 sr = q_gamma_ramp[(rgb >> 16) & 255];
	I64 sg = q_gamma_ramp[(rgb >> 8) & 255];
	I64 sb = q_gamma_ramp[rgb & 255];

	return (sr << 16) | (sg << 8) | sb;
}


U0 QPalSetContrast(F64 k)
{
	if (k < 1.0)	k = 1.0;
	if (k > 2.0)	k = 2.0;

	if (k == q_contrast)
		return;

	q_contrast    = k;
	q_gamma_dirty = TRUE;
	QPalRebuild;
}

U0 QPalSetGamma(F64 g)
{
	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	if (g == q_gamma)
		return;

	q_gamma       = g;
	q_gamma_dirty = TRUE;

	//apply now - only the in-game water/damage path dirties the palette,
	//so a menu gamma change wouldn't show until a map was running
	QPalRebuild;
}

U0 QPalSetTint(I64 r, I64 g, I64 b, I64 a)
{//underwater/damage wash. the palette no longer carries it - QFogBakeCanvas
 //applies it per pixel - so this only stores it, and rebuilds when gamma or
 //contrast moved underneath
	q_tint_r = r;
	q_tint_g = g;
	q_tint_b = b;
	q_tint_a = ClampI64(a, 0, 255);

	if (q_gamma_dirty)
		QPalRebuild;
}

//v_cshift: a mod-commanded base tint, the cshift_empty slot. stuffcmd'd per
//frame by mods for ambience; folded by QLiquidView when the eye is dry
I64 q_cshift_base_r = 0;
I64 q_cshift_base_g = 0;
I64 q_cshift_base_b = 0;
I64 q_cshift_base_a = 0;
