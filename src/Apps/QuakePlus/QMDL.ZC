// QMDL.ZC - alias model (.mdl) loading and drawing
//
// layout, all little-endian:
//   header       84 bytes - "IDPO", version 6, scale/translate, skin size,
//                vertex/triangle/frame counts
//   skins        one raw skin_w*skin_h image, or a group of them
//   texcoords    per vertex - onseam, s, t in skin pixels
//   triangles    per triangle - faces-front flag, three vertex indices
//   frames       per frame - bounds, 16-char name, one packed vertex each
//
// vertices are 3 bytes plus a normal index, unpacked as scale*v + translate

#define QMDL_MAGIC		0x4F504449	//"IDPO" little-endian
#define QMDL_VERSION	6
#define QMDL_MAX_TRIS	4096

class CQMdlTexCoord
{
	I64	on_seam;
	I64	s;
	I64	t;
};

class CQMdlTri
{
	I64	faces_front;
	I64	vert[3];
};

//a frame may be a GROUP of poses cycling on its own clock - torches and flames
//animate with nothing driving them. R_SetupAliasFrame picks the pose off cl.time
#define QMDL_MAX_POSES	16

class CQMdlFrame
{
	U8	 name[16];
	U8	*verts;					//pose 0, borrowed from the file buffer
	U8	*poses[QMDL_MAX_POSES];
	I64	 num_poses;
	F64	 interval;				//seconds per pose
};

//the .mdl header flags word - lives in the FILE, not in QuakeC, which is why a
//rocket trails smoke with nothing asking it to.
//NOT the QEF_ entity effects in QGame.ZC: id calls both sets EF_ (modelgen.h
//and quakedef.h) and the values collide - EF_ROTATE and EF_DIMLIGHT are both 8
#define QMDLF_ROCKET		1
#define QMDLF_GRENADE		2
#define QMDLF_GIB			4
#define QMDLF_ROTATE		8
#define QMDLF_TRACER		16
#define QMDLF_ZOMGIB		32
#define QMDLF_TRACER2		64
#define QMDLF_TRACER3		128

class CQMdl
{
	U8				*raw;
	I64				 raw_size;

	F64				 scale[3];
	F64				 translate[3];

	I64				 skin_width;
	I64				 skin_height;
	I64				 num_skins;
	I64				 num_verts;
	I64				 num_tris;
	I64				 num_frames;
	I64				 flags;		//the EF_ bits at offset 76 - trail type

	CQMdlTexCoord	*tc;
	CQMdlTri		*tris;
	CQMdlFrame		*frames;

	CQTexture		 skin;		//wraps the first skin for the rasterizer
};

U0 QMdlFree(CQMdl *m)
{
	if (!m)
		return;

	if (m->tc)		Free(m->tc);
	if (m->tris)	Free(m->tris);
	if (m->frames)	Free(m->frames);
	if (m->raw)		Free(m->raw);

	Free(m);
}

CQMdl *QMdlLoad(U8 *name)
{
	CQMdl	*m;
	U8		*d;
	I64		 size = 0;
	I64		 p;
	I64		 i;
	I64		 j;
	I64		 group;
	I64		 sub;
	I64		 skin_bytes;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QMdl: %s not found\n", name;
		return NULL;
	}

	if (size < 84 || QRdU32(d) != QMDL_MAGIC || QRdI32(d + 4) != QMDL_VERSION)
	{
		"QMdl: %s is not an IDPO version 6 model\n", name;
		Free(d);
		return NULL;
	}

	m           = CAlloc(sizeof(CQMdl));
	m->raw      = d;
	m->raw_size = size;

	QRdVec(d + 8, m->scale);
	QRdVec(d + 20, m->translate);

	m->num_skins   = QRdI32(d + 48);
	m->skin_width  = QRdI32(d + 52);
	m->skin_height = QRdI32(d + 56);
	m->num_verts   = QRdI32(d + 60);
	m->num_tris    = QRdI32(d + 64);
	m->num_frames  = QRdI32(d + 68);

	//CL_RelinkEntities reads this to pick the trail - rocket, grenade, gib
	//blood - so a model loaded without it can never trail anything
	m->flags       = QRdI32(d + 76);

	if (m->num_verts <= 0 || m->num_tris <= 0 || m->num_frames <= 0 ||
		m->skin_width <= 0 || m->skin_height <= 0)
	{
		"QMdl: %s has degenerate counts\n", name;
		QMdlFree(m);
		return NULL;
	}

	skin_bytes = m->skin_width * m->skin_height;
	p          = 84;

	//--- skins: keep the first, skip the rest ---
	for (i = 0; i < m->num_skins; i++)
	{
		if (p + 4 > size)
		{
			QMdlFree(m);
			return NULL;
		}

		group = QRdI32(d + p);
		p += 4;

		if (group)
		{
			//skin group: count, per-skin intervals, then the images
			sub = QRdI32(d + p);
			p += 4 + sub * 4;
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += sub * skin_bytes;
		}
		else
		{
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += skin_bytes;
		}
	}

	m->skin.width  = m->skin_width;
	m->skin.height = m->skin_height;
	m->skin.clamp  = TRUE;		//skins are not power-of-two and never tile
	QRdName(name, m->skin.name, 16);

	if (!m->skin.texels[0])
	{
		"QMdl: %s has no usable skin\n", name;
		QMdlFree(m);
		return NULL;
	}

	//--- texture coordinates ---
	if (p + m->num_verts * 12 > size)
	{
		QMdlFree(m);
		return NULL;
	}

	m->tc = CAlloc(m->num_verts * sizeof(CQMdlTexCoord));
	for (i = 0; i < m->num_verts; i++)
	{
		m->tc[i].on_seam = QRdI32(d + p);
		m->tc[i].s       = QRdI32(d + p + 4);
		m->tc[i].t       = QRdI32(d + p + 8);
		p += 12;
	}

	//--- triangles ---
	if (p + m->num_tris * 16 > size)
	{
		QMdlFree(m);
		return NULL;
	}

	m->tris = CAlloc(m->num_tris * sizeof(CQMdlTri));
	for (i = 0; i < m->num_tris; i++)
	{
		m->tris[i].faces_front = QRdI32(d + p);
		for (j = 0; j < 3; j++)
			m->tris[i].vert[j] = QRdI32(d + p + 4 + j * 4);
		p += 16;
	}

	//--- frames ---
	m->frames = CAlloc(m->num_frames * sizeof(CQMdlFrame));
	for (i = 0; i < m->num_frames; i++)
	{
		if (p + 4 > size)
			break;

		group = QRdI32(d + p);
		p += 4;

		if (group)
		{
			//group: count, bounds (two 8-byte verts), one interval per
			//pose, then the poses
			sub = QRdI32(d + p);
			p += 4 + 8;

			//file intervals are cumulative, the first is the per-pose period
			if (sub > 0 && p + 4 <= size)
				m->frames[i].interval = QRdF32(d + p);

			if (m->frames[i].interval <= 0.0)
				m->frames[i].interval = 0.1;

			p += sub * 4;

			for (j = 0; j < sub; j++)
			{
				if (p + 24 + m->num_verts * 4 > size)
					break;

				if (j == 0)
				{
					QRdName(d + p + 8, m->frames[i].name, 16);
					m->frames[i].verts = d + p + 24;
				}

				if (j < QMDL_MAX_POSES)
				{
					m->frames[i].poses[j] = d + p + 24;
					m->frames[i].num_poses = j + 1;
				}

				p += 24 + m->num_verts * 4;
			}
		}
		else
		{
			if (p + 24 + m->num_verts * 4 > size)
				break;

			QRdName(d + p + 8, m->frames[i].name, 16);
			m->frames[i].verts     = d + p + 24;
			m->frames[i].poses[0]  = d + p + 24;
			m->frames[i].num_poses = 1;
			m->frames[i].interval  = 0.1;
			p += 24 + m->num_verts * 4;
		}
	}

	return m;
}


//--- shared model cache ---------------------------------------------------
//
// alias models are immutable once loaded - per-entity state lives on the
// entity, so one copy serves every entity using that model. e1m1 alone spawns
// dozens of soldiers.
//
// the cache OWNS what it hands out. only QMdlCacheFree frees it, at shutdown

#define QMDL_CACHE_MAX	256
#define QMDL_NAME_MAX	64

U8		q_mdl_cache_name[QMDL_CACHE_MAX * QMDL_NAME_MAX];
CQMdl  *q_mdl_cache_mdl[QMDL_CACHE_MAX];
I64		q_mdl_cache_count = 0;

U0 QMdlCacheInit()
{//globals aren't zeroed, and a stale pointer here gets freed at shutdown
	I64 i;

	for (i = 0; i < QMDL_CACHE_MAX; i++)
	{
		q_mdl_cache_mdl[i]                    = NULL;
		q_mdl_cache_name[i * QMDL_NAME_MAX]   = 0;
	}

	q_mdl_cache_count = 0;
}

CQMdl *QMdlCacheGet(U8 *name)
{//the one copy of this model, loaded on first request
	I64 i;
	U8 *slot;

	if (!name || !name[0])
		return NULL;

	for (i = 0; i < q_mdl_cache_count; i++)
	{
		if (!StrICompare(&q_mdl_cache_name[i * QMDL_NAME_MAX], name))
			return q_mdl_cache_mdl[i];
	}

	if (q_mdl_cache_count >= QMDL_CACHE_MAX)
		return QMdlLoad(name);	//cache full, hand back an owned copy

	i    = q_mdl_cache_count;
	slot = &q_mdl_cache_name[i * QMDL_NAME_MAX];

	QStrCopy(slot, name, QMDL_NAME_MAX);
	q_mdl_cache_mdl[i] = QMdlLoad(name);
	q_mdl_cache_count++;

	return q_mdl_cache_mdl[i];
}

U0 QMdlCacheFree()
{//release every cached model, nothing else may free them
	I64 i;

	for (i = 0; i < q_mdl_cache_count; i++)
	{
		if (q_mdl_cache_mdl[i])
			QMdlFree(q_mdl_cache_mdl[i]);
		q_mdl_cache_mdl[i] = NULL;
	}

	q_mdl_cache_count = 0;
}

I64 QMdlFrameByName(CQMdl *m, U8 *name)
{//frames carry names like "axrun1", -1 when absent
	I64 i;

	for (i = 0; i < m->num_frames; i++)
	{
		if (!StrICompare(m->frames[i].name, name))
			return i;
	}

	return -1;
}

U8 *QMdlPoseVerts(CQMdlFrame *fr, F64 time)
{//R_SetupAliasFrame pose pick:
 //    pose += (int)(cl.time / interval) % numposes;
 //a grouped frame runs on its own clock - a torch flickers while static
	I64 pose;

	if (!fr)
		return NULL;

	if (fr->num_poses <= 1 || fr->interval <= 0.0)
		return fr->verts;

	pose = ToI64(time / fr->interval) % fr->num_poses;
	if (pose < 0)
		pose += fr->num_poses;

	if (!fr->poses[pose])
		return fr->verts;

	return fr->poses[pose];
}

U0 QMdlDrawView(CQCanvas *c, CQMdl *m, I64 frame, F64 fwd, F64 rgt, F64 up,
	F64 scale, I64 light, F64 depth_bias = 1.0)
{//first-person weapon model, locked to the screen, no world transform
 //view models use the world axes (x fwd, y left, z up) at the origin:
 //   camera x (right)   = -model y
 //   camera y (up)      =  model z
 //   camera z (forward) =  model x
 //sitting a few units from the eye its 1/z is large, so it wins depth anyway
	CQMdlFrame		*fr;
	U8				*verts;
	CQMdlTri		*tri;
	CQPolyVert		 poly[3];
	CQPolyVert		 clipped[QMAX_POLY_VERTS];
	CQScreenVert	 scr[QMAX_POLY_VERTS];
	U8				*vp;
	F64				 local[3];
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = QMdlPoseVerts(fr, q_light_time);
	if (!verts)
		return;

	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				//bailing must skip the draw too - a half-filled poly[]
				//mixes these verts with the PREVIOUS triangle's stale
				//ones and smears a long polygon across the screen
				valid = FALSE;
				break;
			}

			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			//scale before the offset - the model reaches back past the eye
			//and geometry near the clip plane projects enormous
			poly[j].cam[0] = -local[1] * scale + rgt;
			poly[j].cam[1] =  local[2] * scale + up;
			poly[j].cam[2] =  local[0] * scale + fwd;

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;
		}

		if (!valid)
			goto qvm_next;

		count = QDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];

				//screen position uses the TRUE 1/z - bias only the depth
				//key, and only after projecting, or the weapon resizes
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;

				//GLQuake's glDepthRange(0, 0.3) equivalent - a larger 1/z
				//reads as nearer. s_over_z and t_over_z MUST scale by the
				//same factor: the rasterizer recovers s as s_over_z/inv_z,
				//so biasing inv_z alone swims the skin
				inv_z *= depth_bias;

				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
			}

			QDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qvm_next:
	}
}

//--- colour translation ----------------------------------------------------
//
// CL_NewTranslation. a player skin reserves two 16-entry palette ranges, 16-31
// shirt and 96-111 trousers, remapped to the colours the player picked. model
// data is never touched, only palette indices in a private copy of the skin

#define QTOP_RANGE		16
#define QBOTTOM_RANGE	96

U0 QMdlTranslation(I64 top, I64 bottom, U8 *table)
{//build the 256-entry index map for one pair of colours
	I64 i;

	for (i = 0; i < 256; i++)
		table[i] = i;

	//colours are 0-13, each naming a 16-entry block
	top    = (top & 15) << 4;
	bottom = (bottom & 15) << 4;

	for (i = 0; i < 16; i++)
	{
		//"the artists made some backwards ranges. sigh." - the upper half of
		//the palette runs bright-to-dark, so read those blocks in reverse
		if (top < 128)
			table[QTOP_RANGE + i] = top + i;
		else
			table[QTOP_RANGE + i] = top + 15 - i;

		if (bottom < 128)
			table[QBOTTOM_RANGE + i] = bottom + i;
		else
			table[QBOTTOM_RANGE + i] = bottom + 15 - i;
	}
}

CQMdl *q_mdl_preview		= NULL;
U8    *q_mdl_preview_skin	= NULL;	//the private, translated copy
U8    *q_mdl_preview_src	= NULL;	//the untouched skin in the file buffer
I64    q_mdl_preview_top	= -1;
I64    q_mdl_preview_bottom	= -1;

CQMdl *QMdlPreviewGet(I64 top, I64 bottom)
{//player.mdl with a privately translated skin, rebuilt only on a colour
 //change - the remap walks the whole skin, no reason to redo it every frame
	U8	table[256];
	I64	bytes;
	I64	i;

	if (!q_mdl_preview)
	{
		q_mdl_preview = QMdlLoad("progs/player.mdl");
		if (!q_mdl_preview)
			return NULL;

		bytes = q_mdl_preview->skin_width * q_mdl_preview->skin_height;

		//keep the ORIGINAL pointer, every later translation reads from it
		q_mdl_preview_src  = q_mdl_preview->skin.texels[0];
		q_mdl_preview_skin = MAlloc(bytes);

		if (!q_mdl_preview_src)
		{
			QMdlFree(q_mdl_preview);
			q_mdl_preview = NULL;
			return NULL;
		}

		MemCopy(q_mdl_preview_skin, q_mdl_preview_src, bytes);

		//redirect once so the draw path needs no special case
		q_mdl_preview->skin.texels[0] = q_mdl_preview_skin;
	}

	if (top == q_mdl_preview_top && bottom == q_mdl_preview_bottom)
		return q_mdl_preview;

	QMdlTranslation(top, bottom, table);

	bytes = q_mdl_preview->skin_width * q_mdl_preview->skin_height;

	//translate from the ORIGINAL skin, never the copy - translating a
	//translation compounds the remap and the colours drift
	for (i = 0; i < bytes; i++)
		q_mdl_preview_skin[i] = table[q_mdl_preview_src[i]];

	q_mdl_preview_top    = top;
	q_mdl_preview_bottom = bottom;

	return q_mdl_preview;
}

U0 QMdlPreviewFree()
{//the private skin is ours, the raw buffer belongs to QMdlFree
	if (q_mdl_preview)
	{
		//put the borrowed pointer back or QMdlFree frees the wrong block
		q_mdl_preview->skin.texels[0] = q_mdl_preview_src;
		QMdlFree(q_mdl_preview);
	}

	if (q_mdl_preview_skin)
		Free(q_mdl_preview_skin);

	q_mdl_preview        = NULL;
	q_mdl_preview_skin   = NULL;
	q_mdl_preview_src    = NULL;
	q_mdl_preview_top    = -1;
	q_mdl_preview_bottom = -1;
}

U0 QMdlDrawAngles(CQCanvas *c, CQMdl *m, I64 frame, F64 *origin, F64 *angles,
	I64 light)
{//draw a model with a FULL orientation, not just a yaw - a lightning beam
 //points wherever it was fired, often straight up or down.
 //model pitch is INVERTED against a view angle, as the original's alias
 //transform has it, and model y points left - hence the minus on right
	CQMdlFrame		*fr;
	U8				*verts;
	CQMdlTri		*tri;
	CQPolyVert		 poly[3];
	CQPolyVert		 clipped[QMAX_POLY_VERTS];
	CQScreenVert	 scr[QMAX_POLY_VERTS];
	U8				*vp;
	F64				 mang[3];
	F64				 fwd[3];
	F64				 rgt[3];
	F64				 upv[3];
	F64				 world[3];
	F64				 local[3];
	F64				 rel[3];
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = QMdlPoseVerts(fr, q_light_time);
	if (!verts)
		return;

	mang[0] = -angles[0];
	mang[1] =  angles[1];
	mang[2] =  angles[2];
	QAngleVectors(mang, fwd, rgt, upv);

	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				valid = FALSE;
				break;
			}

			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			world[0] = origin[0] + local[0] * fwd[0] - local[1] * rgt[0] +
				local[2] * upv[0];
			world[1] = origin[1] + local[0] * fwd[1] - local[1] * rgt[1] +
				local[2] * upv[1];
			world[2] = origin[2] + local[0] * fwd[2] - local[1] * rgt[2] +
				local[2] * upv[2];

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;

			QVecSub(world, c->origin, rel);
			poly[j].cam[0] = QVecDot(rel, c->right);
			poly[j].cam[1] = QVecDot(rel, c->up);
			poly[j].cam[2] = QVecDot(rel, c->forward);
		}

		if (!valid)
			goto qma_next;

		count = QDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
			}

			QDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qma_next:
	}
}

U0 QMdlDraw(CQCanvas *c, CQMdl *m, I64 frame, F64 *origin, F64 yaw,
	I64 light)
{//draw one frame at a world position, rotated about the vertical axis
	CQMdlFrame		*fr;
	U8				*verts;
	CQMdlTri		*tri;
	CQPolyVert		 poly[3];
	CQPolyVert		 clipped[QMAX_POLY_VERTS];
	CQScreenVert	 scr[QMAX_POLY_VERTS];
	U8				*vp;
	F64				 world[3];
	F64				 local[3];
	F64				 rel[3];
	F64				 sy;
	F64				 cy;
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = QMdlPoseVerts(fr, q_light_time);
	if (!verts)
		return;

	sy        = Sin(yaw * QDEG2RAD);
	cy        = Cos(yaw * QDEG2RAD);
	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				//must skip the draw as well, see QMdlDrawView
				valid = FALSE;
				break;
			}

			//unpack: three bytes scaled and offset by the header pair
			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			//yaw, then translate into the world
			world[0] = local[0] * cy - local[1] * sy + origin[0];
			world[1] = local[0] * sy + local[1] * cy + origin[1];
			world[2] = local[2] + origin[2];

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			//back-facing tris on a seam vertex read the right half of
			//the skin, else the seam column smears
			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;

			QVecSub(world, c->origin, rel);
			poly[j].cam[0] = QVecDot(rel, c->right);
			poly[j].cam[1] = QVecDot(rel, c->up);
			poly[j].cam[2] = QVecDot(rel, c->forward);
		}

		if (!valid)
			goto qm_next;

		count = QDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
			}

			QDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qm_next:
	}
}
