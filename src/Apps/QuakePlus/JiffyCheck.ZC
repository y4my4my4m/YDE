
// counts.jiffies comes from the LAPIC timer, calibrated against CPUID or PIT

U0 JiffyCheck(F64 secs = 2.0)
{
	I64	j0;
	I64	j1;
	F64	t0;
	F64	measured;
	F64	ratio;

	"\n$$LTBLUE$$JiffyCheck$$FG$$  measuring %2.1fs against SysTimerRead\n", secs;

	j0 = counts.jiffies;
	t0 = tS;

	while (tS - t0 < secs)
		Yield;

	j1 = counts.jiffies;

	measured = ToF64(j1 - j0) / (tS - t0);
	ratio    = measured / ToF64(JIFFY_FREQ);

	"  JIFFY_FREQ  %8d Hz  (expected)\n", JIFFY_FREQ;
	"  measured    %8.1f Hz\n", measured;
	"  ratio       %8.3f\n", ratio;

	if (ratio < 0.9 || ratio > 1.1)
	{
		"$$RED$$timer is miscalibrated - every Sleep is off by 1/%3.2f$$FG$$\n",
			ratio;
		"$$RED$$a 16.68ms window manager slot really takes %5.1fms$$FG$$\n",
			16.68 / ratio;
	}
	else
		"$$GREEN$$timer calibration is correct$$FG$$\n";
}

JiffyCheck;
