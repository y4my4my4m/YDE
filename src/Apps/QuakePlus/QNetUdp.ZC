// udp transport.
// UDP_MAX_PORT is defined only when the net stack is loaded (RunNet.ZC), which
// is what the #ifdef tests.

#define QNET_PORT_DEFAULT	26000

//limited broadcast, the only address a slist query can use (Datagram_SearchForHosts)
#define QNET_BROADCAST_IP	0xFFFFFFFF

I64		q_udp_port		= QNET_PORT_DEFAULT;
U32		q_udp_peer_ip	= 0;		//peer address, 0 = none
U32		q_udp_from_ip	= 0;
I64		q_udp_from_port	= QNET_PORT_DEFAULT;
Bool	q_udp_ready		= FALSE;
Bool	q_udp_server	= FALSE;
I64		q_udp_sent		= 0;
I64		q_udp_recvd		= 0;
I64		q_udp_errors	= 0;
I64		q_udp_unresolved = 0;
Bool	q_dhcp_failed	= FALSE;
U8		q_udp_status[96];

#ifdef UDP_MAX_PORT

CUDPSocket			*q_udp_socket	= NULL;
CSocketAddressIPV4	*q_udp_bind		= NULL;

Bool QNetUdpOpen(I64 port)
{//both ends bind the same port, as the original does
	if (q_udp_ready)
		return TRUE;

	if (!ipv4_globals.local_ip)
	{
		QStrCopy(q_udp_status,
			"set ip first: qip 10.0.0.2, THEN connect", 96);
		return FALSE;
	}

	q_udp_socket = UDPSocket(AF_INET);
	if (!q_udp_socket)
	{
		QStrCopy(q_udp_status, "UDPSocket failed", 96);
		return FALSE;
	}

	q_udp_bind = CAlloc(sizeof(CSocketAddressIPV4));

	//ports go on the wire big endian, the socket layer doesn't swap
	q_udp_bind->family	= AF_INET;
	q_udp_bind->port	= EndianU16(port);

	//INADDR_ANY: UDPHandler matches the bound address against the packet source
	q_udp_bind->address.address	= INADDR_ANY;

	if (UDPSocketBind(q_udp_socket, q_udp_bind) == -1)
	{
		QStrCopy(q_udp_status, "UDPSocketBind failed", 96);
		Free(q_udp_bind);
		q_udp_bind = NULL;
		UDPSocketClose(q_udp_socket);
		q_udp_socket = NULL;
		return FALSE;
	}

	//non blocking - with a timeout set UDPSocketReceiveFrom sleeps
	q_udp_socket->receive_timeout_ms = 0;

	q_udp_port  = port;
	q_udp_ready = TRUE;
	q_udp_sent  = 0;
	q_udp_recvd = 0;

	StrPrint(q_udp_status, "bound to port %d", port);

	return TRUE;
}

U0 QNetUdpClose()
{
	if (!q_udp_ready)
		return;

	if (q_udp_socket)
		UDPSocketClose(q_udp_socket);

	if (q_udp_bind)
		Free(q_udp_bind);

	q_udp_socket = NULL;
	q_udp_bind   = NULL;
	q_udp_ready  = FALSE;
	q_udp_server = FALSE;
	q_udp_peer_ip = 0;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip, I64 dest_port=0)
{//NET_SendPacket - one message, one datagram, never blocks
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !dest_ip || m->len < 1 || m->overflowed)
		return FALSE;

	//ethernet mtu. no ip fragmentation on this stack; entity updates are capped
	//at QNET_MAX_DATAGRAM.
	if (m->len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	//cache only - IPV4AddressMACGet blocks 2s on a miss
	if (!ARPCacheFind(dest_ip))
	{
		q_udp_unresolved++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		dest_ip, dport, m->len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, m->data, m->len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpSend(CQMsg *m)
{
	return QNetUdpSendTo(m, q_udp_peer_ip);
}

Bool QNetUdpSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port=0)
{//raw NETFLAG framed bytes, dest_port 0 means QNET_PORT_DEFAULT
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !dest_ip || !data || len < 1)
		return FALSE;

	if (len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	if (!ARPCacheFind(dest_ip))
	{
		q_udp_unresolved++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		dest_ip, dport, len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpSendRawBroadcast(U8 *data, I64 len, I64 dest_port=0)
{//raw NETFLAG framed bytes to the whole subnet, for the slist query only
 //
 //IPV4AddressMACGet short circuits 255.255.255.255 to the ethernet broadcast,
 //so no ARPCacheFind is needed. source port stays q_udp_port, where the CCREP
 //comes back to.
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !data || len < 1)
		return FALSE;

	if (len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		QNET_BROADCAST_IP, dport, len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpRecv(CQMsg *out)
{//one datagram if one is waiting, never blocks
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (!q_udp_ready)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));

	got = UDPSocketReceiveFrom(q_udp_socket, out->data, QNET_MAX_MSG, &from);
	if (got < 1)
		return FALSE;

	QMsgClear(out);
	out->len = got;

	if (from.family == AF_INET)
	{
		v4 = &from;

		/*	sockaddr ipv4 is network order. quake, ARPCache and
			UDPPacketAllocate all want host order, first octet in the low
			byte, the layout IPV4AddressParse produces. */
		q_udp_from_ip = EndianU32(v4->address.address);

		if (!q_udp_peer_ip)
			q_udp_peer_ip = q_udp_from_ip;

		q_udp_from_port = EndianU16(v4->port);
		if (q_udp_from_port < 1)
			q_udp_from_port = QNET_PORT_DEFAULT;
	}
	else
	{
		q_udp_from_ip = 0;
		q_udp_from_port = QNET_PORT_DEFAULT;
	}

	q_udp_recvd++;

	return TRUE;
}

Bool QNetUdpRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{//raw bytes for QNetDgrm framing, never blocks
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;

	if (!q_udp_ready || !buf || max < 1)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));

	got = UDPSocketReceiveFrom(q_udp_socket, buf, max, &from);
	if (got < 1)
		return FALSE;

	if (out_len)
		*out_len = got;

	if (from.family == AF_INET)
	{
		v4 = &from;
		q_udp_from_ip = EndianU32(v4->address.address);
		//sockaddr port is network order
		q_udp_from_port = EndianU16(v4->port);
		if (q_udp_from_port < 1)
			q_udp_from_port = QNET_PORT_DEFAULT;
		if (!q_udp_peer_ip)
			q_udp_peer_ip = q_udp_from_ip;
	}
	else
	{
		q_udp_from_ip = 0;
		q_udp_from_port = QNET_PORT_DEFAULT;
	}

	if (from_ip)
		*from_ip = q_udp_from_ip;

	q_udp_recvd++;

	return TRUE;
}

Bool QNetUdpAvailable()
{
	return TRUE;
}

#else


Bool QNetUdpOpen(I64 port)
{
	QStrCopy(q_udp_status,
		"net stack not loaded - run ::/Home/Net/Start, then rebuild", 96);

	return FALSE;
}

U0 QNetUdpClose()
{
}

Bool QNetUdpSend(CQMsg *m)
{
	return FALSE;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpSendRawBroadcast(U8 *data, I64 len, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpRecv(CQMsg *out)
{
	return FALSE;
}

Bool QNetUdpRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{
	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;
	return FALSE;
}

Bool QNetUdpAvailable()
{
	return FALSE;
}

#endif

U0 QNetUdpInit()
{//globals aren't zeroed
#ifdef UDP_MAX_PORT
	q_udp_bind = NULL;
#endif

	q_udp_port    = QNET_PORT_DEFAULT;
	q_dhcp_failed = FALSE;
	q_udp_peer_ip = 0;
	q_udp_from_ip = 0;
	q_udp_from_port = QNET_PORT_DEFAULT;
	q_udp_ready   = FALSE;
	q_udp_server  = FALSE;
	q_udp_sent       = 0;
	q_udp_recvd      = 0;
	q_udp_errors     = 0;
	q_udp_unresolved = 0;

	if (QNetUdpAvailable())
		QStrCopy(q_udp_status, "udp available", 96);
	else
		QStrCopy(q_udp_status, "udp not compiled in", 96);
}

U0 QNetUdpSetPeer(U32 ip)
{
	q_udp_peer_ip = ip;
}

#ifdef UDP_MAX_PORT

Bool QNetUdpPeerResolved()
{//cache lookup only, sends nothing
	if (!q_udp_peer_ip)
		return FALSE;

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

U0 QNetUdpArpProbe()
{//ARPSend returns at once and ARPHandler caches the reply; IPV4AddressMACGet
 //blocks, this does not.
	if (!q_udp_ready || !q_udp_peer_ip)
		return;

	ARPSend(ARP_REQUEST,
		ethernet_globals.ethernet_broadcast,
		EthernetMACGet,
		ipv4_globals.local_ip_be,
		ethernet_globals.ethernet_null,
		EndianU32(q_udp_peer_ip));
}

Bool QNetUdpResolvePeer()
{//resolve the peer mac once, blocking up to two seconds. also the reachability
 //test: no arp answer means the other machine is not on the wire.
	U8 *mac = NULL;

	if (!q_udp_ready || !q_udp_peer_ip)
		return FALSE;

	if (ARPCacheFind(q_udp_peer_ip))
		return TRUE;

	IPV4AddressMACGet(q_udp_peer_ip, &mac);

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

Bool QNetUdpEnsureArp(U32 ip)
{//block until the dest mac is known
	U8 *mac = NULL;

	if (!ip)
		return FALSE;
	if (ARPCacheFind(ip))
		return TRUE;

	IPV4AddressMACGet(ip, &mac);
	return ToBool(ARPCacheFind(ip) != NULL);
}

#else

U0 QNetUdpArpProbe()
{
}

Bool QNetUdpPeerResolved()
{
	return FALSE;
}

Bool QNetUdpResolvePeer()
{
	return FALSE;
}

Bool QNetUdpEnsureArp(U32 ip)
{
	return FALSE;
}

#endif

#ifdef UDP_MAX_PORT

U32 QNetLocalIP()
{//ipv4_globals.local_ip is host order, first octet high. local_ip_be is first
 //octet low, the order every address in this port uses - what QConParseIPV4
 //builds, what the arp cache takes, and what a packet's from_ip carries.
	return ipv4_globals.local_ip_be;
}

U0 QNetDhcp()
{
	if (q_dhcp_failed)
	{
		QStrCopy(q_udp_status, "dhcp already failed - use qip", 96);
		return;
	}

	NetConfigure;

	if (ipv4_globals.local_ip)
		StrPrint(q_udp_status, "dhcp ok: %d.%d.%d.%d",
			ipv4_globals.local_ip & 255,
			(ipv4_globals.local_ip >> 8) & 255,
			(ipv4_globals.local_ip >> 16) & 255,
			(ipv4_globals.local_ip >> 24) & 255);
	else
	{
		q_dhcp_failed = TRUE;
		QStrCopy(q_udp_status, "dhcp failed - no server? use qip", 96);
	}
}

Bool QNetUdpSetLocalIP(U32 ip)
{
	U32 got;

	if (!ip)
	{
		QStrCopy(q_udp_status, "qip: could not parse that address", 96);
		return FALSE;
	}

	IPV4AddressSet(ip);

	//a /24 with no router
	IPV4SubnetSet(0, 0x00FFFFFF);

	got = ipv4_globals.local_ip;

	StrPrint(q_udp_status, "ip now %d.%d.%d.%d",
		got & 255, (got >> 8) & 255, (got >> 16) & 255, (got >> 24) & 255);

	return ToBool(got == ip);
}

Bool QNetAutoIP(U32 server_ip)
{
	U32 ip;
	U32 last;

	if (ipv4_globals.local_ip)
		return TRUE;

	if (!server_ip)
		//first octet in the low byte, matching IPV4AddressParse
		ip = 10 | (0 << 8) | (0 << 16) | (1 << 24);	//10.0.0.1, host
	else
	{
		//move only the host octet, away from .0 and .255
		last = (server_ip >> 24) & 255;

		if (last >= 253)
			last -= 1;
		else
			last += 1;

		ip = (server_ip & 0x00FFFFFF) | (last << 24);
	}

	return QNetUdpSetLocalIP(ip);
}

#else

Bool QNetAutoIP(U32 server_ip)
{
	return FALSE;
}

U32 QNetLocalIP()
{
	return 0;
}

U0 QNetDhcp()
{
	QStrCopy(q_udp_status, "no net stack - run RunNet.ZC", 96);
}

Bool QNetUdpSetLocalIP(U32 ip)
{
	return FALSE;
}

#endif
