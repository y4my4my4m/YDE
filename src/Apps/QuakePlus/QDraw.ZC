// QDraw.ZC - 8bpp span rasterizer
//
// stays 8 bit indexed until blit time - lighting is a colormap lookup
// (index, shade) -> index, one byte per pixel, no per-pixel multiply
//
// per face: world verts -> camera space -> near clip -> project -> scanline
// fill with perspective-correct texture and lightmap
//
// FIXME: span loop is the thing to hand-write in asm

#define QSCR_W			320
#define QSCR_H			240
#define QMAX_POLY_VERTS	64
#define QNEAR_CLIP		4.0		//world units in front of the eye

//pixels between exact perspective divides, error stays under a texel
#define QSPAN_SUB		16

class CQPolyVert
{
	F64	cam[3];		//x right, y up, z forward
	F64	s;			//texel units
	F64	t;
};

class CQScreenVert
{
	F64	x;
	F64	y;
	F64	inv_z;
	F64	s_over_z;
	F64	t_over_z;
};

//truecolor render path. the world stays 8bpp indexed; sources that own real
//RGB (external skybox) write a parallel plane instead of quantizing down.
//QDrawNew reads this, so a change needs a canvas rebuild
Bool	q_opt_truecolor = TRUE;

//sample the colormap ramp between rows instead of snapping to one. only the
//smoothness of the light gradient - the RGB plane itself is not conditional
//on this, it follows q_opt_truecolor
Bool	q_opt_tclight	= TRUE;

//2x2 filter over the lit surface cache. trades sharpness for the palette
//dither that point sampling turns into colour speckle. off by default: the
//softening is more objectionable than the speckle at native resolution
Bool	q_opt_texfilter	= FALSE;

//colour from .lit. separate from q_opt_tclight so a chroma fault can be told
//apart from a lighting fault
Bool	q_opt_litrgb	= TRUE;

//faces skipped by the fog cull this frame. declared here because QDrawClear
//zeroes it well before the fog block below
I64		q_fog_culled	= 0;

//surface cache work this frame. declared here because QDrawClear zeroes them
//well before the cache itself is defined
I64		q_surf_builds_frame	= 0;
I64		q_surf_hits_frame	= 0;

//--- draw probe -------------------------------------------------------------
//
// reports what the rasteriser actually put at one pixel, which names the
// texture and the path a stray colour came from. checked per span, never per
// pixel, so it costs nothing in the inner loop
Bool	q_probe_req		= FALSE;
I64		q_probe_x		= 0;
I64		q_probe_y		= 0;
I64		q_probe_iz		= -1;
U8		q_probe_tex[16];
I64		q_probe_texel	= -1;
I64		q_probe_mip		= -1;
Bool	q_probe_fence	= FALSE;
Bool	q_probe_surf	= FALSE;
Bool	q_probe_rgb		= FALSE;
Bool	q_probe_sky		= FALSE;
Bool	q_probe_hit		= FALSE;
U8		q_probe_msg[128];
Bool	q_probe_arm		= FALSE;	//coords not chosen yet
I64		q_probe_lmw		= -1;
I64		q_probe_lmh		= -1;
I64		q_probe_light	= -1;
Bool	q_probe_lit		= FALSE;	//.lit chroma reached this surface
U8		q_probe_line1[96];
U8		q_probe_line2[96];
I64		q_probe_show	= 0;		//frames left to draw the result on screen
I64		q_probe_own		= -1;		//depth this span left at the probe column
//what QCfgLoad actually parsed for texfilter: -1 = the key was never seen in
//the file at all, 0/1 = the value it applied
I64		q_cfg_texfilter	= -1;
I64		q_cfg_saves		= 0;		//times QCfgSave reached the FileWrite

I64		q_probe_raw		= -1;		//texel straight out of the texture
I64		q_probe_cmap	= -1;		//what the colormap turned it into
I64		q_probe_tw		= -1;
I64		q_probe_th		= -1;

//continuous crosshair readout. the console is unusable mid-game, so this is
//how the probe is meant to be driven
Bool	q_opt_debugtex	= FALSE;

//frame rate readout. counts frames over a window rather than inverting a
//single frame time, which otherwise flickers unreadably
Bool	q_opt_fps		= FALSE;
F64		q_fps_value		= 0.0;
F64		q_fps_window	= 0.0;
I64		q_fps_frames	= 0;
U8		q_fps_line[32];

//TRUE only while a truecolor source is actually feeding the overlay. declared
//here because the span writers below run before the sky code is defined
Bool	q_rgb_active	= FALSE;

#define QRGB_SET	0x80000000	//bit 31 marks the overlay pixel as live

//palette index 255 is the cutout key in '{' textures
#define QFENCE_CUTOUT	255

//1/z is bounded by the near clip: QNEAR_CLIP 4.0 means iz <= 0.25, so 2^32
//keeps the nearest value near 2^30 and still leaves ~500k steps at z=8192
#define QDEPTH_SCALE	4294967296.0

//top of the palette's grey ramp. external art has no palette index, so the
//lighting curve is sampled here and applied as a scale
#define QPAL_GREY_REF	15

class CQCanvas
{
	U8	*pixels;		//width * height palette indices
	//1/z in QDEPTH_SCALE fixed point, larger is nearer. 32 bit halves the
	//bandwidth of the most-touched buffer in the renderer
	I32	*depth;
	//truecolor overlay, NULL unless q_opt_truecolor. bit 31 set means this
	//pixel holds a literal 0xRRGGBB and the index plane is ignored at blit
	U32	*rgb;
	I64	 width;
	I64	 height;

	//view state for the frame being drawn
	F64	 origin[3];
	F64	 forward[3];
	F64	 right[3];
	F64	 up[3];
	F64	 x_scale;
	F64	 y_scale;
	F64	 center_x;
	F64	 center_y;

	//SCR_CalcRefdef r_refdef.vrect - outside it is left alone so the border
	//and status bar show through
	I64	 vx;
	I64	 vy;
	I64	 vw;
	I64	 vh;

	I64	 faces_drawn;
	I64	 spans_drawn;
};

//--- turbulent surfaces ----------------------------------------------------
//
// R_InitTurb / D_DrawTurbulent8Span. each axis is displaced by the table
// indexed with the OTHER axis - the cross coupling is what swirls it
//
//     sturb = ((s + turb[(t>>16) & (CYCLE-1)]) >> 16) & 63
//     tturb = ((t + turb[(s>>16) & (CYCLE-1)]) >> 16) & 63
//
// table is AMP + sin(i*2pi/CYCLE)*AMP, AMP = 8 texels. turb textures are
// always 64x64, hence the & 63
#define QTURB_CYCLE		128
#define QTURB_AMP		8.0
#define QTURB_SPEED		20.0

F64 q_turb_table[QTURB_CYCLE];
I64 q_turb_phase = 0;

U0 QTurbInit()
{//R_InitTurb
	I64 i;

	for (i = 0; i < QTURB_CYCLE; i++)
		q_turb_table[i] = QTURB_AMP +
			Sin(ToF64(i) * 2.0 * pi / ToF64(QTURB_CYCLE)) * QTURB_AMP;
}

U0 QTurbFrame(F64 time)
{//cl.time*SPEED, wrapped to the table
	q_turb_phase = ToI64(time * QTURB_SPEED) & (QTURB_CYCLE - 1);
}

//--- dynamic lights --------------------------------------------------------
//
// muzzle flashes, explosions, rocket glow. these move, so they are not in the
// compiled lightmap and get folded in at draw time by R_AddDynamicLights
//
// the light is projected onto the surface plane and each luxel brightened by
// distance from the impact, using the cheap approximation, no sqrt

#define QMAX_DLIGHTS		32
#define QDLIGHT_MINLIGHT	4.0

class CQDlight
{
	F64	origin[3];
	F64	radius;
	F64	die;			//absolute time
	F64	decay;			//radius lost per second
	F64	min_light;
};

CQDlight	q_dlight[QMAX_DLIGHTS];
I64			q_dlight_count = 0;

U0 QDlightClear()
{
	q_dlight_count = 0;
}

U0 QDlightAdd(F64 *origin, F64 radius, F64 life, F64 decay, F64 time)
{//oldest slot is recycled when full - these are all short lived
	CQDlight	*d;
	I64			 slot = -1;
	I64			 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= time)
		{
			slot = i;
			break;
		}
	}

	if (slot < 0)
	{
		if (q_dlight_count < QMAX_DLIGHTS)
		{
			slot = q_dlight_count;
			q_dlight_count++;
		}
		else
			slot = 0;
	}

	d = &q_dlight[slot];
	QVecCopy(origin, d->origin);
	d->radius    = radius;
	d->die       = time + life;
	d->decay     = decay;
	d->min_light = QDLIGHT_MINLIGHT;
}

U0 QDlightUpdate(F64 dt, F64 time)
{//shrink live lights, drop expired
	I64 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= time)
			goto qdl_next;

		q_dlight[i].radius -= dt * q_dlight[i].decay;
		if (q_dlight[i].radius < 0.0)
			q_dlight[i].die = 0.0;

qdl_next:
	}
}

Bool QDlightsActive(F64 time)
{//cheap gate, most frames have none
	I64 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die > time && q_dlight[i].radius > 0.0)
			return TRUE;
	}

	return FALSE;
}

//--- animated light styles -------------------------------------------------
//
// a style is a letter string sampled at 10Hz: 'a' black, 'm' normal, 'z' about
// double. R_AnimateLight turns the current letter into a scale and a face's
// lightmap is the sum of one block per style, each scaled by its value
//
// faces whose styles are all steady take the fast path and use the map data
// directly, only animated faces get recombined

#define QMAX_LIGHTSTYLES	64
#define QLIGHTSTYLE_LEN		64
#define QLIGHTSTYLE_NORMAL	256		//style with no string

//what a STEADY style resolves to - worldspawn sets style 0 to "m", and
//('m'-'a')*22 = 264, NOT 256. divide by this or every face comes out 3%
//bright and the fast path never fires
#define QLIGHT_UNITY		264
#define QLIGHT_SCRATCH		4096	//one face's lightmap block, generously

//no lit surface found under a model
#define QLIGHT_FALLBACK		170

U8	q_lightstyle[QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN];
I64	q_lightstyle_value[QMAX_LIGHTSTYLES];
U8	q_light_scratch[QLIGHT_SCRATCH];
U8	q_light_black[QLIGHT_SCRATCH];	//unlit face lightmap, all zeros

//counters, so the recombine path can be measured instead of guessed at
I64	q_light_acc[QLIGHT_SCRATCH];	//per-luxel accumulator, 8 bits of fraction
Bool q_dlight_any	= FALSE;		//any live dynamic light this frame
I64	q_light_fast	= 0;
I64	q_light_slow	= 0;
I64	q_light_clamped	= 0;

//R_PushDlights. the frame counter makes face marks self-expiring - a face
//carrying last frame's number has no lights on it now
I64 q_dlight_frame	= 0;
I64 q_ambient_light	= 0;		//r_refdef.ambientlight

F64 q_light_time = 0.0;		//time this frame is drawn at
F64 q_light_last = 0.0;		//previous frame, for dynamic light decay

U0 QLightInit()
{//globals aren't zeroed, so every style starts explicitly steady
	I64 i;

	MemSet(q_light_black, 0, QLIGHT_SCRATCH);

	q_dlight_any  = FALSE;
	q_dlight_count = 0;
	q_dlight_frame = 0;
	q_ambient_light = 0;
	q_light_last  = 0.0;
	q_light_time  = 0.0;

	for (i = 0; i < QMAX_LIGHTSTYLES; i++)
	{
		q_lightstyle[i * QLIGHTSTYLE_LEN] = 0;
		q_lightstyle_value[i]             = QLIGHTSTYLE_NORMAL;
	}
}

U0 QLightStyleSet(I64 style, U8 *str)
{//the lightstyle builtin, called at spawn for every switchable light
	if (style < 0 || style >= QMAX_LIGHTSTYLES || !str)
		return;

	QStrCopy(&q_lightstyle[style * QLIGHTSTYLE_LEN], str, QLIGHTSTYLE_LEN);
}

U0 QLightFrame(F64 time)
{//expire and shrink dynamic lights, cache whether any survive
 //
 //dt is tracked here, not passed in - dlights decay in real time, independent
 //of the fixed server step
	F64 dt = time - q_light_last;

	q_light_last = time;

	//a level load must not decay everything at once
	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	q_light_time = time;
	QDlightUpdate(dt, time);
	q_dlight_any = QDlightsActive(time);
}

U0 QLightAnimate(F64 time)
{//R_AnimateLight
	U8	*str;
	I64	 frame = ToI64(time * 10.0);
	I64	 len;
	I64	 i;
	I64	 k;

	for (i = 0; i < QMAX_LIGHTSTYLES; i++)
	{
		str = &q_lightstyle[i * QLIGHTSTYLE_LEN];
		len = StrLen(str);

		if (!len)
		{
			q_lightstyle_value[i] = QLIGHTSTYLE_NORMAL;
			goto ql_next;
		}

		k = frame % len;
		if (k < 0)
			k = 0;

		//'a'..'z' -> 0..550 in steps of 22
		q_lightstyle_value[i] = (str[k] - 'a') * 22;

ql_next:
	}
}

U0 QMarkLights(CQMap *map, CQDlight *light, I64 bit, I64 node_index)
{//R_MarkLights - flag every face the light sphere reaches, descending only
 //the side(s) it straddles
	CQNode	*node;
	CQPlane	*plane;
	CQFace	*f;
	F64		 dist;
	I64		 i;

	if (node_index < 0 || node_index >= map->num_nodes)
		return;

	node = &map->nodes[node_index];

	if (node->plane_num < 0 || node->plane_num >= map->num_planes)
		return;

	plane = &map->planes[node->plane_num];
	dist  = QVecDot(light->origin, plane->normal) - plane->dist;

	//entirely on one side, only that child can be lit
	if (dist > light->radius)
	{
		QMarkLights(map, light, bit, node->children[0]);
		return;
	}
	if (dist < -light->radius)
	{
		QMarkLights(map, light, bit, node->children[1]);
		return;
	}

	for (i = 0; i < node->num_faces; i++)
	{
		if (node->first_face + i < 0 ||
			node->first_face + i >= map->num_faces)
			goto qml_next;

		f = &map->faces[node->first_face + i];

		//first light to reach this face this frame resets the mask
		if (f->dlight_frame != q_dlight_frame)
		{
			f->dlight_bits  = 0;
			f->dlight_frame = q_dlight_frame;
		}

		f->dlight_bits |= bit;

qml_next:
	}

	QMarkLights(map, light, bit, node->children[0]);
	QMarkLights(map, light, bit, node->children[1]);
}

U0 QPushDlights(CQMap *map, F64 time)
{//R_PushDlights, once per frame before anything is drawn
	I64 i;

	q_dlight_frame++;

	if (!map || !map->nodes || map->num_nodes < 1)
		return;

	for (i = 0; i < q_dlight_count && i < QMAX_DLIGHTS; i++)
	{
		if (q_dlight[i].die <= time || q_dlight[i].radius <= 0.0)
			goto qpd_next;

		QMarkLights(map, &q_dlight[i], 1 << i, 0);

qpd_next:
	}
}

U0 QLightAddDynamic(CQMap *map, CQFace *f, I64 lm_w, I64 lm_h, F64 time)
{//R_AddDynamicLights - fold every light touching this face into the acc
	CQDlight	*d;
	CQPlane		*plane;
	CQTexInfo	*ti;
	F64			 impact[3];
	F64			 local_s;
	F64			 local_t;
	F64			 dist;
	F64			 rad;
	F64			 minlight;
	F64			 sd;
	F64			 td;
	F64			 adist;
	I64			 lnum;
	I64			 sx;
	I64			 ty;
	I64			 j;

	//BSP indices used to form pointers - out of range is a wild address, not
	//a wrong colour
	if (f->plane_num < 0 || f->plane_num >= map->num_planes)
		return;
	if (f->tex_info < 0 || f->tex_info >= map->num_texinfo)
		return;

	plane = &map->planes[f->plane_num];
	ti    = &map->texinfo[f->tex_info];

	for (lnum = 0; lnum < q_dlight_count; lnum++)
	{
		//R_MarkLights already decided which lights reach this face
		if (!(f->dlight_bits & (1 << lnum)))
			goto qad_next;

		d = &q_dlight[lnum];

		if (d->die <= time || d->radius <= 0.0)
			goto qad_next;

		//distance off the plane - a back side face has its normal flipped
		dist = QVecDot(d->origin, plane->normal) - plane->dist;
		if (f->side)
			dist = -dist;

		rad = d->radius;
		if (dist < 0.0)
			rad -= -dist;
		else
			rad -= dist;

		minlight = d->min_light;
		if (rad < minlight)
			goto qad_next;

		minlight = rad - minlight;

		//project onto the surface
		for (j = 0; j < 3; j++)
		{
			if (f->side)
				impact[j] = d->origin[j] + plane->normal[j] * dist;
			else
				impact[j] = d->origin[j] - plane->normal[j] * dist;
		}

		local_s = QVecDot(impact, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		local_t = QVecDot(impact, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		for (ty = 0; ty < lm_h; ty++)
		{
			td = local_t - ToF64(ty * 16);
			if (td < 0.0)
				td = -td;

			for (sx = 0; sx < lm_w; sx++)
			{
				sd = local_s - ToF64(sx * 16);
				if (sd < 0.0)
					sd = -sd;

				//cheap distance - larger axis plus half the smaller, no sqrt
				if (sd > td)
					adist = sd + td * 0.5;
				else
					adist = td + sd * 0.5;

				if (adist < minlight)
					q_light_acc[ty * lm_w + sx] +=
						ToI64((rad - adist) * 256.0);
			}
		}

qad_next:
	}
}

U8 *QLightFaceMap(CQMap *map, CQFace *f, I64 lm_w, I64 lm_h, F64 time)
{//R_BuildLightMap - compiled lighting scaled by each style, plus dlights
 //
 //returns the map's own data untouched when nothing is animated, so the
 //common case costs one compare instead of a per-texel recombine
	U8	*base;
	I64	 size = lm_w * lm_h;
	I64	 count;
	I64	 acc;
	I64	 scale;
	I64	 i;
	I64	 j;
	Bool dyn;

	//only a map with NO lightdata renders fullbright - R_BuildLightMap's
	//!lightdata case. a face with no samples in a LIT map renders BLACK
	if (!map->lightdata)
		return NULL;
	if (f->light_offset < 0)
	{
		//a flash still lands on an unlit face, the zeros are just the base
		if (q_dlight_any && f->dlight_frame == q_dlight_frame &&
			f->dlight_bits != 0 && size > 0 && size <= QLIGHT_SCRATCH)
		{
			for (i = 0; i < size; i++)
				q_light_acc[i] = 0;

			QLightAddDynamic(map, f, lm_w, lm_h, time);

			for (i = 0; i < size; i++)
			{
				acc = q_light_acc[i] / QLIGHT_UNITY;
				if (acc > 255)
					acc = 255;
				if (acc < 0)
					acc = 0;
				q_light_scratch[i] = acc;
			}

			return q_light_scratch;
		}

		//bounded by the scratch length, like every other return here
		if (size > QLIGHT_SCRATCH)
			return NULL;

		return q_light_black;
	}

	if (q_ambient_light < 0)
		q_ambient_light = 0;
	if (q_ambient_light > 255)
		q_ambient_light = 255;

	base = map->lightdata + f->light_offset;

	//styles in use. 255 terminates, and so does any out of range index
	count = 0;
	while (count < 4 && f->styles[count] != 255 &&
		f->styles[count] < QMAX_LIGHTSTYLES)
		count++;

	if (!count)
		return base;

	if (size <= 0 || size > QLIGHT_SCRATCH)
		return base;

	//marked by R_MarkLights this frame, not just "some light exists"
	dyn = ToBool(q_dlight_any && f->dlight_frame == q_dlight_frame &&
			f->dlight_bits != 0);

	//one steady style and no dlight makes the recombine a no-op
	//ambient hits every luxel, so it rules out the fast path
	if (!dyn && !q_ambient_light && count == 1 &&
		q_lightstyle_value[f->styles[0]] == QLIGHT_UNITY)
	{
		q_light_fast++;
		return base;
	}

	//each extra style is another block, past the caller's single-block check
	if (f->light_offset + count * size > map->lightdata_size)
		return base;

	q_light_slow++;

	//8 bits of fraction so dlights add before any rounding or clamp
	for (i = 0; i < size; i++)
	{
		//R_BuildLightMap clears to ambient first, in accumulator units
		acc = q_ambient_light * QLIGHT_UNITY;

		for (j = 0; j < count; j++)
		{
			scale = q_lightstyle_value[f->styles[j]];
			//NOT ToI64: base[] is a U8 and ToI64 is the F64->I64 intrinsic,
			//it would read the byte as a double bit pattern. U8 widens
			acc  += base[j * size + i] * scale;
		}

		q_light_acc[i] = acc;
	}

	if (dyn)
		QLightAddDynamic(map, f, lm_w, lm_h, time);

	for (i = 0; i < size; i++)
	{
		//divide by what a STEADY style resolves to, not 256 - 256 puts every
		//luxel above 248 into the clamp
		acc = q_light_acc[i] / QLIGHT_UNITY;

		if (acc > 255)
		{
			acc = 255;
			q_light_clamped++;
		}
		if (acc < 0)
			acc = 0;

		q_light_scratch[i] = acc;
	}

	return q_light_scratch;
}

I64 QLightPoint(CQMap *map, F64 *point)
{//R_LightPoint - sample the lightmap of the surface below a point
 //
 //alias models carry no lightmap, this is their only shading input
	F64		  end[3];
	F64		  dl[3];
	F64		  add;
	CQTrace	  tr;
	CQFace	 *f;
	CQTexInfo *ti;
	CQLeaf	 *leaf;
	F64		  s_coord;
	F64		 t_coord;
	I64		 ds;
	I64		 dt;
	I64		 lm_w;
	I64		 lm_h;
	I64		 i;
	I64		 node;
	I64		 best = -1;

	if (!map || !map->lightdata)
		return QLIGHT_FALLBACK;

	//straight down, past any room height
	QVecCopy(point, end);
	end[2] -= 2048.0;

	QTraceMove(map, point, end, &tr);

	if (!tr.hit || tr.fraction == 1.0)
		return QLIGHT_FALLBACK;

	//the trace gives a position but not a face, so test the leaf's surfaces
	node = QVisLeafForPoint(map, tr.end_pos);
	if (node <= 0 || node >= map->num_leafs)
		return QLIGHT_FALLBACK;

	leaf = &map->leafs[node];

	for (i = 0; i < leaf->num_marksurfaces; i++)
	{
		f = &map->faces[map->marksurfaces[leaf->first_marksurface + i]];

		if (f->light_offset < 0)
			goto qlp_next;

		//texture axes live on the texinfo, not the face
		ti      = &map->texinfo[f->tex_info];
		s_coord = QVecDot(tr.end_pos, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		t_coord = QVecDot(tr.end_pos, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		if (s_coord < 0.0 || t_coord < 0.0)
			goto qlp_next;
		if (s_coord > ToF64(f->extent_s) || t_coord > ToF64(f->extent_t))
			goto qlp_next;

		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;
		ds   = ToI64(s_coord) / 16;
		dt   = ToI64(t_coord) / 16;

		if (ds < 0)   ds = 0;
		if (dt < 0)   dt = 0;
		if (ds >= lm_w) ds = lm_w - 1;
		if (dt >= lm_h) dt = lm_h - 1;

		if (f->light_offset + dt * lm_w + ds >= map->lightdata_size)
			goto qlp_next;

		//U8, so no ToI64
		best = map->lightdata[f->light_offset + dt * lm_w + ds];
		break;

qlp_next:
	}

	if (best < 0)
		best = QLIGHT_FALLBACK;

	//dlights reach models too, radius minus distance from the origin.
	//R_DrawAliasModel does this before the shading setup
	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= q_light_time || q_dlight[i].radius <= 0.0)
			goto qlp_dl_next;

		QVecSub(point, q_dlight[i].origin, dl);
		add = q_dlight[i].radius - QVecLength(dl);

		if (add > 0.0)
			best += ToI64(add);

qlp_dl_next:
	}

	//cap so a nearby light doesn't wash the model out
	if (best > 128)
		best = 128;

	//floor so models don't go black in unlit corners
	if (best < 24)
		best = 24;

	return best;
}

CQCanvas *QDrawNew(I64 w, I64 h)
{//cost scales with pixel count - this is the main performance dial
	CQCanvas *c = CAlloc(sizeof(CQCanvas));

	if (w < 64)		w = 64;
	if (h < 64)		h = 64;
	if (w > 1920)	w = 1920;
	if (h > 1200)	h = 1200;

	c->width  = w;
	c->height = h;

	//full canvas until SCR_CalcRefdef says otherwise
	c->vx = 0;
	c->vy = 0;
	c->vw = w;
	c->vh = h;
	c->pixels = CAlloc(w * h);
	c->depth  = CAlloc(w * h * sizeof(I32));

	if (q_opt_truecolor)
		c->rgb = CAlloc(w * h * sizeof(U32));

	return c;
}

U0 QDrawFree(CQCanvas *c)
{
	if (!c)
		return;

	if (c->pixels)	Free(c->pixels);
	if (c->depth)	Free(c->depth);
	if (c->rgb)		Free(c->rgb);

	Free(c);
}

U0 QDrawClear(CQCanvas *c, I64 color_index)
{
	I64 y;
	I64 rows;

	MemSet(c->pixels, color_index, c->width * c->height);

	//depth and the overlay are read only inside the view rect: the border and
	//the status bar strip are 2D. clearing the full canvas wrote megabytes a
	//frame that nothing ever looked at
	if (c->vx == 0 && c->vw == c->width)
	{
		//contiguous, so one pass covers the rows in the rect
		rows = c->vh;
		if (c->vy + rows > c->height)
			rows = c->height - c->vy;

		if (rows > 0)
		{
			MemSet(c->depth + c->vy * c->width, 0,
				rows * c->width * sizeof(I32));

			if (c->rgb)
				MemSet(c->rgb + c->vy * c->width, 0,
					rows * c->width * sizeof(U32));
		}
	}
	else
	{
		for (y = c->vy; y < c->vy + c->vh && y < c->height; y++)
		{
			MemSet(c->depth + y * c->width + c->vx, 0,
				c->vw * sizeof(I32));

			if (c->rgb)
				MemSet(c->rgb + y * c->width + c->vx, 0,
					c->vw * sizeof(U32));
		}
	}

	c->faces_drawn = 0;
	c->spans_drawn = 0;
	q_fog_culled   = 0;
	q_surf_builds_frame = 0;
	q_surf_hits_frame   = 0;
}

U0 QRGBDrop(CQCanvas *c, I64 x, I64 y)
{//an index was written at this pixel, so the truecolor overlay under it is
 //stale. every writer that is not the sky must call this
	if (c->rgb && q_rgb_active)
		c->rgb[y * c->width + x] = 0;
}

U0 QDrawSetViewRect(CQCanvas *c, F64 viewsize, I64 sbar_h)
{//SCR_CalcRefdef - 100 and up fills the width, below that the view shrinks
 //and is centred above the status bar
	F64 size;
	I64 avail;

	if (viewsize < 30.0)	viewsize = 30.0;
	if (viewsize > 120.0)	viewsize = 120.0;

	//sbar_h is sb_lines, decided by the caller. deciding it again here made
	//110 drop the whole bar instead of just the inventory row
	size = viewsize;
	if (size > 100.0)
		size = 100.0;
	size = size / 100.0;

	avail = c->height - sbar_h;

	c->vw = ToI64(ToF64(c->width) * size);
	c->vh = ToI64(ToF64(c->height) * size);

	if (c->vw < 96)
		c->vw = 96;
	if (c->vh > avail)
		c->vh = avail;
	if (c->vh < 64)
		c->vh = 64;

	c->vx = (c->width - c->vw) / 2;
	c->vy = (avail - c->vh) / 2;

	if (c->vx < 0)	c->vx = 0;
	if (c->vy < 0)	c->vy = 0;
}

U0 QDrawSetView(CQCanvas *c, F64 *origin, F64 *angles, F64 fov_x)
{//projection scales from the horizontal fov, y reuses x so pixels stay square
	F64 half = fov_x * 0.5 * QDEG2RAD;

	QVecCopy(origin, c->origin);
	QAngleVectors(angles, c->forward, c->right, c->up);

	//centred on the VIEW RECT, not the canvas
	c->center_x = ToF64(c->vx) + ToF64(c->vw) * 0.5;
	c->center_y = ToF64(c->vy) + ToF64(c->vh) * 0.5;
	c->x_scale  = ToF64(c->vw) * 0.5 / Tan(half);
	c->y_scale  = c->x_scale;
}

F64 QDrawFovY(F64 fov_x, I64 width, I64 height)
{//matching vertical fov for square pixels, in degrees
	F64 half = fov_x * 0.5 * QDEG2RAD;
	F64 t    = Tan(half) * ToF64(height) / ToF64(width);

	return ATan(t) * 2.0 / QDEG2RAD;
}

I64 QDrawClipNear(CQPolyVert *in, I64 count, CQPolyVert *out)
{//Sutherland-Hodgman against z = QNEAR_CLIP. the only plane that must be
 //exact - the rest is clamped at scan time
	I64 i;
	I64 j;
	I64 n = 0;
	F64 d1;
	F64 d2;
	F64 frac;

	for (i = 0; i < count; i++)
	{
		j  = (i + 1) % count;
		d1 = in[i].cam[2] - QNEAR_CLIP;
		d2 = in[j].cam[2] - QNEAR_CLIP;

		if (d1 >= 0.0)
		{
			if (n < QMAX_POLY_VERTS)
			{
				MemCopy(&out[n], &in[i], sizeof(CQPolyVert));
				n++;
			}
		}

		//crossing either way contributes one new vertex
		if ((d1 >= 0.0) != (d2 >= 0.0))
		{
			if (n < QMAX_POLY_VERTS && (d1 - d2) != 0.0)
			{
				frac = d1 / (d1 - d2);
				out[n].cam[0] = in[i].cam[0] + frac * (in[j].cam[0] - in[i].cam[0]);
				out[n].cam[1] = in[i].cam[1] + frac * (in[j].cam[1] - in[i].cam[1]);
				out[n].cam[2] = in[i].cam[2] + frac * (in[j].cam[2] - in[i].cam[2]);
				out[n].s      = in[i].s + frac * (in[j].s - in[i].s);
				out[n].t      = in[i].t + frac * (in[j].t - in[i].t);
				n++;
			}
		}
	}

	return n;
}

F64 QLightBilinear(U8 *lightmap, I64 lm_w, I64 lm_h, F64 ls, F64 lt)
{//one lightmap sample, four neighbours blended
 //
 //R_DrawSurfaceBlock8 interpolates with lightleftstep/lightstep. nearest
 //luxel makes every 16-texel cell a flat slab with hard edges
	I64 lx0, ly0, lx1, ly1;
	F64 fs, ft;
	F64 top, bot;

	if (ls < 0.0)	ls = 0.0;
	if (lt < 0.0)	lt = 0.0;

	lx0 = ToI64(Floor(ls));
	ly0 = ToI64(Floor(lt));
	fs  = ls - ToF64(lx0);
	ft  = lt - ToF64(ly0);

	lx1 = lx0 + 1;
	ly1 = ly0 + 1;

	lx0 = ClampI64(lx0, 0, lm_w - 1);
	lx1 = ClampI64(lx1, 0, lm_w - 1);
	ly0 = ClampI64(ly0, 0, lm_h - 1);
	ly1 = ClampI64(ly1, 0, lm_h - 1);

	top = ToF64(lightmap[ly0 * lm_w + lx0]) * (1.0 - fs) +
		  ToF64(lightmap[ly0 * lm_w + lx1]) * fs;
	bot = ToF64(lightmap[ly1 * lm_w + lx0]) * (1.0 - fs) +
		  ToF64(lightmap[ly1 * lm_w + lx1]) * fs;

	return top * (1.0 - ft) + bot * ft;
}

I64 QTextureAnimation(CQMap *map, I64 miptex, I64 frame, F64 time)
{//R_TextureAnimation - walk the ring to the frame covering this tick, after
 //swapping to the alternate chain if the entity asked
	CQTexture	*base;
	I64			 idx;
	I64			 rel;
	I64			 count;

	if (miptex < 0 || miptex >= map->num_textures)
		return -1;

	idx  = miptex;
	base = &map->textures[idx];

	//.frame selects the alternate sequence - pressed button, open door
	if (frame && base->alt_anims >= 0 &&
		base->alt_anims < map->num_textures)
	{
		idx  = base->alt_anims;
		base = &map->textures[idx];
	}

	if (!base->anim_total)
		return idx;

	rel = ToI64(time * 10.0) % base->anim_total;
	if (rel < 0)
		rel += base->anim_total;

	count = 0;
	while (base->anim_min > rel || base->anim_max <= rel)
	{
		idx = base->anim_next;
		if (idx < 0 || idx >= map->num_textures)
			break;

		base = &map->textures[idx];

		//a malformed ring must not hang the renderer
		count++;
		if (count > 100)
			break;
	}

	//an INDEX, not a pointer: ZealC pointer subtraction isn't reliably scaled
	//by element size, and the caller needs the number to key the cache
	return idx;
}

//--- surface cache ----------------------------------------------------------
//
// D_CacheSurface. a wall is not lit per pixel per frame - the texture is built
// once with its lighting folded in at the mip being drawn, and the span loop
// is then a plain fetch. unchanged surfaces are reused next frame
//
// keyed on mip AND a lighting key, so an animated style or a dlight rebuilds
// while a static wall never does

//one slot per cached face. 512 was sized for id1, where a view holds a few
//hundred faces; a qbj3 view holds thousands, so every face evicted before it
//was reused and fell to the uncached path - which has no RGB plane, so the
//truecolor lighting silently turned itself off with distance
//one slot per cached face. turning the view brings a whole new set of faces
//into frame, and every miss rebuilds a full lit surface - which now carries an
//RGB plane too, so a miss costs ~5x what it used to. the working set has to
//fit or rotation stutters while it thrashes
#define QSURF_SLOTS			32768
//a truecolor surface carries an RGB plane four times the size of its index
//plane, so the same working set needs five times the room. at 6MB the cache
//ran dry mid-scene and the faces that missed it lost their colour entirely
//runtime settable: the machine has the RAM, and the right size depends on the
//map. QSurfCacheRelease trims down on the next build if it is lowered
I64 q_surf_budget = 335544320;		//320MB default

//a face touched by a dynamic light rebuilds EVERY frame, and a rebuild now
//carries an RGB plane. past this many per frame the stale surface is reused
//instead: the lighting lags a frame or two rather than the frame stalling
I64 q_surf_build_max	= 96;


class CQSurfCache
{
	U8	*pixels;
	U32	*rgb;			//lit in RGB, NULL unless q_opt_truecolor
	I64	 bytes;			//charged to the budget, both planes
	I64	 w;
	I64	 h;
	I64	 mip;
	I64	 face;			//owning face index, -1 when free
	I64	 frame;			//last used, for eviction
	I64	 light_key;		//lighting state built from
	I64	 texture;		//animation frame built from
};

CQSurfCache	 q_surf[QSURF_SLOTS];
I64			*q_face_surf	= NULL;		//face index -> slot, -1 for none
I64			 q_face_surf_n	= 0;
CQMap		*q_surf_map		= NULL;
I64			 q_surf_bytes	= 0;
I64			 q_surf_frame	= 0;
I64			 q_surf_builds	= 0;
I64			 q_surf_hits	= 0;

U0 QSurfCacheInit()
{//globals aren't zeroed, and every pointer here goes to Free on map load -
 //garbage faults inside the allocator, nowhere near here
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		q_surf[i].pixels    = NULL;
		q_surf[i].rgb       = NULL;
		q_surf[i].bytes     = 0;
		q_surf[i].w         = 0;
		q_surf[i].h         = 0;
		q_surf[i].face      = -1;
		q_surf[i].frame     = -1;
		q_surf[i].mip       = -1;
		q_surf[i].light_key = -1;
		q_surf[i].texture   = -1;
	}

	q_face_surf   = NULL;
	q_face_surf_n = 0;
	q_surf_map    = NULL;
	q_surf_bytes  = 0;
	q_surf_frame  = 0;
	q_surf_builds = 0;
	q_surf_hits   = 0;
}

U0 QSurfCacheFlush()
{//map change or palette change
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (q_surf[i].pixels)
			Free(q_surf[i].pixels);
		if (q_surf[i].rgb)
			Free(q_surf[i].rgb);

		q_surf[i].pixels    = NULL;
		q_surf[i].rgb       = NULL;
		q_surf[i].bytes     = 0;
		q_surf[i].face      = -1;
		q_surf[i].frame     = -1;
		q_surf[i].mip       = -1;
		q_surf[i].light_key = -1;
		q_surf[i].texture   = -1;
	}

	if (q_face_surf)
	{
		for (i = 0; i < q_face_surf_n; i++)
			q_face_surf[i] = -1;
	}

	q_surf_bytes = 0;
}

U0 QSurfCacheSetMap(CQMap *map)
{//one slot table per map - face indices only mean anything within one
	if (map == q_surf_map)
		return;

	QSurfCacheFlush;

	if (q_face_surf)
	{
		Free(q_face_surf);
		q_face_surf   = NULL;
		q_face_surf_n = 0;
	}

	q_surf_map = map;

	if (map && map->num_faces > 0)
	{
		q_face_surf_n = map->num_faces;
		q_face_surf   = MAlloc(q_face_surf_n * sizeof(I64));
		MemSet(q_face_surf, 0xFF, q_face_surf_n * sizeof(I64));
	}
}

Bool QSurfCacheRelease()
{//free the LRU slot that actually holds memory, report whether any did
 //
 //an empty slot frees nothing and the caller's release-until-it-fits loop
 //would spin on it forever
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (!q_surf[i].pixels)
			goto qsr_next;

		//in use this frame, about to be drawn
		if (q_surf[i].frame == q_surf_frame)
			goto qsr_next;

		if (q_surf[i].frame < best_frame)
		{
			best_frame = q_surf[i].frame;
			best       = i;
		}

qsr_next:
	}

	if (best < 0)
		return FALSE;

	if (q_face_surf && q_surf[best].face >= 0 &&
		q_surf[best].face < q_face_surf_n)
		q_face_surf[q_surf[best].face] = -1;

	q_surf_bytes -= q_surf[best].bytes;
	Free(q_surf[best].pixels);
	if (q_surf[best].rgb)
		Free(q_surf[best].rgb);

	q_surf[best].pixels    = NULL;
	q_surf[best].rgb       = NULL;
	q_surf[best].bytes     = 0;
	q_surf[best].face      = -1;
	q_surf[best].frame     = -1;
	q_surf[best].mip       = -1;
	q_surf[best].light_key = -1;

	return TRUE;
}

I64 QSurfCacheEvict()
{//a slot to build into, free or LRU
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (q_surf[i].face < 0)
			return i;

		if (q_surf[i].frame < best_frame)
		{
			best_frame = q_surf[i].frame;
			best       = i;
		}
	}

	if (best < 0)
		return -1;

	//never take a slot already used this frame
	if (q_surf[best].frame == q_surf_frame)
		return -1;

	if (q_face_surf && q_surf[best].face >= 0 &&
		q_surf[best].face < q_face_surf_n)
		q_face_surf[q_surf[best].face] = -1;

	q_surf[best].face = -1;

	return best;
}

I64 QTexWrap(I64 v, I64 n)
{//tile into 0..n-1 for ANY n
 //
 //quake texture dimensions are multiples of SIXTEEN, not powers of two -
 //96x64 is an ordinary size. masking with (n-1) folds coordinates back on
 //themselves there. power of two still masks, it is most textures
	if (n < 1)
		return 0;

	if (!(n & (n - 1)))
		return v & (n - 1);

	v = v % n;
	if (v < 0)
		v += n;

	return v;
}

I64 QSurfLightKey(CQFace *f)
{//any change here means rebuild
	I64 key = 0;
	I64 j;

	for (j = 0; j < 4; j++)
	{
		if (f->styles[j] == 255)
			break;
		if (f->styles[j] < QMAX_LIGHTSTYLES)
			key = key * 31 + q_lightstyle_value[f->styles[j]];
	}

	key = key * 31 + q_ambient_light;

	//a filter change alters every cached texel, so it rebuilds like a light
	//change rather than needing its own flush
	key = key * 31 + ToI64(q_opt_texfilter);
	key = key * 31 + ToI64(q_opt_litrgb);
	key = key * 31 + ToI64(q_opt_rgbmips);

	//a marked face rebuilds every frame, plus once more when the light leaves
	if (f->dlight_frame == q_dlight_frame && f->dlight_bits)
		key = key * 31 + q_dlight_frame + 1;

	return key;
}

U0 QLitTexelRGB(I64 texel, F64 lightv, I64 *_r, I64 *_g, I64 *_b)
{//raw palette RGB for one texel at a fractional light level. walks the
 //colormap in fractional rows instead of snapping to one: the rows carry
 //Quake's intensity curve, so tone is unchanged while the 64 steps and the
 //palette snap between them both go away
	F64 shadef;
	F64 frac;
	I64 row0;
	I64 row1;
	I64 c0;
	I64 c1;

	//fullbrights ignore lighting
	if (texel >= QPAL_FULLBRIGHT)
	{
		*_r = qpal_rgb[texel * 3];
		*_g = qpal_rgb[texel * 3 + 1];
		*_b = qpal_rgb[texel * 3 + 2];
		return;
	}

	shadef = (255.0 - lightv) / 4.0;

	//q_opt_tclight now selects only how the ramp is sampled: interpolated
	//between rows, or snapped to one the way the 8bpp path does
	if (!q_opt_tclight)
		shadef = ToF64(ToI64(shadef));

	if (shadef < 0.0)
		shadef = 0.0;
	if (shadef > ToF64(QPAL_SHADES - 1))
		shadef = ToF64(QPAL_SHADES - 1);

	row0 = ToI64(shadef);
	row1 = row0 + 1;
	if (row1 > QPAL_SHADES - 1)
		row1 = QPAL_SHADES - 1;
	frac = shadef - ToF64(row0);

	c0 = qpal_colormap[row0 * QPAL_COLORS + texel];
	c1 = qpal_colormap[row1 * QPAL_COLORS + texel];

	*_r = ToI64(ToF64(qpal_rgb[c0 * 3]) +
			(ToF64(qpal_rgb[c1 * 3]) - ToF64(qpal_rgb[c0 * 3])) * frac);
	*_g = ToI64(ToF64(qpal_rgb[c0 * 3 + 1]) +
			(ToF64(qpal_rgb[c1 * 3 + 1]) - ToF64(qpal_rgb[c0 * 3 + 1])) * frac);
	*_b = ToI64(ToF64(qpal_rgb[c0 * 3 + 2]) +
			(ToF64(qpal_rgb[c1 * 3 + 2]) - ToF64(qpal_rgb[c0 * 3 + 2])) * frac);
}

U0 QLitBilinearRGB(U8 *lit, I64 lm_w, I64 lm_h, F64 s, F64 t,
	I64 *_r, I64 *_g, I64 *_b)
{//QLightBilinear over interleaved RGB triples
	I64 s0, t0, s1, t1, i00, i10, i01, i11, k;
	F64 fs, ft, a, b0, c, d;
	F64 acc;

	if (s < 0.0)	s = 0.0;
	if (t < 0.0)	t = 0.0;

	s0 = ToI64(s);
	t0 = ToI64(t);
	if (s0 > lm_w - 1)	s0 = lm_w - 1;
	if (t0 > lm_h - 1)	t0 = lm_h - 1;

	s1 = s0 + 1;
	t1 = t0 + 1;
	if (s1 > lm_w - 1)	s1 = lm_w - 1;
	if (t1 > lm_h - 1)	t1 = lm_h - 1;

	fs = s - ToF64(s0);
	ft = t - ToF64(t0);
	if (fs < 0.0)	fs = 0.0;
	if (fs > 1.0)	fs = 1.0;
	if (ft < 0.0)	ft = 0.0;
	if (ft > 1.0)	ft = 1.0;

	i00 = (t0 * lm_w + s0) * 3;
	i10 = (t0 * lm_w + s1) * 3;
	i01 = (t1 * lm_w + s0) * 3;
	i11 = (t1 * lm_w + s1) * 3;

	for (k = 0; k < 3; k++)
	{
		a   = ToF64(lit[i00 + k]);
		b0  = ToF64(lit[i10 + k]);
		c   = ToF64(lit[i01 + k]);
		d   = ToF64(lit[i11 + k]);
		acc = a + (b0 - a) * fs + (c - a) * ft + (a - b0 - c + d) * fs * ft;

		if (k == 0)			*_r = ToI64(acc);
		else if (k == 1)	*_g = ToI64(acc);
		else				*_b = ToI64(acc);
	}
}

U8 *QSurfCacheGet(CQMap *map, CQFace *f, I64 face_index, CQTexture *tex,
	I64 mip, U8 *lightmap, I64 lm_w, I64 lm_h, I64 *_cw, I64 *_ch,
	I64 tex_key = 0, U32 **_rgb = NULL)
{//R_DrawSurface - texture with lighting applied at the mip being drawn.
 //NULL means not cached, light it per pixel
	CQSurfCache	*sc;
	U8			*texels;
	U8			*out;
	I64			 slot;
	I64			 cw, ch;
	I64			 tw, th;
	I64			 need;
	I64			 key;
	I64			 u, v;
	I64			 tx, ty;
	I64			 s0, t0;
	I64			 mins_s_i, mins_t_i;
	I64			 texel;
	I64			 light;
	I64			 shade;
	F64			 lightv;
	U32			 argb;
	I64			 total;
	Bool		 want_rgb;
	I64			 acc_r;
	I64			 acc_g;
	I64			 acc_b;
	I64			 acc_n;
	I64			 fi;
	I64			 ftx;
	I64			 fty;
	I64			 ftex;
	I64			 fr2;
	I64			 fg2;
	I64			 fb2;
	I64			 cr;
	I64			 cg;
	I64			 cb;
	I64			 ex;
	I64			 ey;
	U32			 eargb;
	I64			 wr;
	I64			 wg;
	I64			 wb;
	I64			 refv;
	U8			*lit_base;
	I64			 lr;
	I64			 lg;
	I64			 lb;
	I64			 lm;

	//slots are indexed by face number within ONE map - an external brush model
	//numbers its own faces and would collide with the world
	if (_rgb)
		*_rgb = NULL;

	if (map != q_surf_map)
		return NULL;

	if (!q_face_surf || face_index < 0 || face_index >= q_face_surf_n)
		return NULL;

	texels = tex->texels[mip];
	tw     = tex->width >> mip;
	th     = tex->height >> mip;

	if (!texels || tw <= 0 || th <= 0)
		return NULL;

	cw = (f->extent_s >> mip) + 1;
	ch = (f->extent_t >> mip) + 1;

	if (cw <= 0 || ch <= 0)
		return NULL;

	need = cw * ch;

	//the RGB plane is four times the index plane, so both are charged
	//the RGB plane carries the mip chain and any replacement texture, not
	//just lighting. gating it on q_opt_tclight meant turning lighting off
	//also threw away the texture quality, which are separate choices
	want_rgb = ToBool(q_opt_truecolor && _rgb != NULL);
	total    = need;
	if (want_rgb)
		total = need * 5;

	if (total > q_surf_budget / 4)
		return NULL;			//absurdly large surface, not worth caching

	key  = QSurfLightKey(f);
	slot = q_face_surf[face_index];

	if (slot >= 0 && slot < QSURF_SLOTS)
	{
		sc = &q_surf[slot];

		//same face and mip, only the lighting moved on: if the frame has
		//spent its rebuild budget, hand back what is already built
		if (sc->face == face_index && sc->mip == mip &&
			sc->texture == tex_key && sc->pixels &&
			ToBool(sc->rgb != NULL) == want_rgb &&
			(sc->light_key == key ||
			 q_surf_builds_frame >= q_surf_build_max))
		{
			sc->frame = q_surf_frame;
			*_cw = sc->w;
			*_ch = sc->h;
			if (_rgb)
				*_rgb = sc->rgb;
			q_surf_hits++;
			q_surf_hits_frame++;
			return sc->pixels;
		}
	}
	else
	{
		slot = QSurfCacheEvict;
		if (slot < 0)
			return NULL;
	}

	sc = &q_surf[slot];

	//grow only - a surface bounces between mips as the player walks. a slot
	//that gained or lost its RGB plane must be rebuilt whatever its size
	if (sc->bytes < total || ToBool(sc->rgb != NULL) != want_rgb)
	{
		//release until it fits, give up the moment nothing more can go
		while (q_surf_bytes + total - sc->bytes > q_surf_budget)
		{
			if (!QSurfCacheRelease)
				break;
		}

		//still over budget with nothing left, draw it the slow way
		if (q_surf_bytes + total - sc->bytes > q_surf_budget)
			return NULL;

		if (sc->pixels)
		{
			q_surf_bytes -= sc->bytes;
			Free(sc->pixels);
			sc->pixels = NULL;
			sc->bytes  = 0;
		}

		if (sc->rgb)
		{
			Free(sc->rgb);
			sc->rgb = NULL;
		}

		sc->pixels = MAlloc(need);
		if (!sc->pixels)
		{
			sc->bytes = 0;
			return NULL;
		}

		if (want_rgb)
		{
			sc->rgb = MAlloc(need * sizeof(U32));
			if (!sc->rgb)
			{
				Free(sc->pixels);
				sc->pixels = NULL;
				sc->bytes  = 0;
				return NULL;
			}
		}

		sc->bytes = total;
		q_surf_bytes += total;
	}

	//style 0 luxels for this face, indexed exactly like the mono lightmap
	lit_base = NULL;
	if (want_rgb && q_opt_litrgb && map->litdata && f->light_offset >= 0 &&
		f->light_offset + lm_w * lm_h <= map->lightdata_size &&
		lm_w > 0 && lm_h > 0)
		lit_base = map->litdata + f->light_offset * 3;

	out      = sc->pixels;
	mins_s_i = ToI64(f->mins_s);
	mins_t_i = ToI64(f->mins_t);

	for (v = 0; v < ch; v++)
	{
		t0 = v << mip;
		ty = QTexWrap((mins_t_i + t0) >> mip, th);

		for (u = 0; u < cw; u++)
		{
			s0 = u << mip;
			tx = QTexWrap((mins_s_i + s0) >> mip, tw);

			texel = texels[ty * tw + tx];

			if (lightmap && lm_w > 0 && lm_h > 0)
			{
				lightv = QLightBilinear(lightmap, lm_w, lm_h,
							ToF64(s0) / 16.0, ToF64(t0) / 16.0);
				light  = ClampI64(ToI64(lightv), 0, 255);
			}
			else
			{
				lightv = 255.0;
				light  = 255;
			}

			shade = ClampI64((255 - light) >> 2, 0, QPAL_SHADES - 1);

			if (texel >= QPAL_FULLBRIGHT)
				out[v * cw + u] = texel;
			else
				out[v * cw + u] = qpal_colormap[shade * QPAL_COLORS + texel];

			if (!want_rgb)
				goto qsc_next_texel;

			//a cutout carries no colour, and the span skips it by index
			if (tex->is_fence && texel == QFENCE_CUTOUT)
			{
				sc->rgb[v * cw + u] = 0;
				goto qsc_next_texel;
			}

			//an RGB mip is a clean filter of the artist's texture, where the
			//BSP level is a re-quantized palette average. same lighting path
			//as an external replacement, just a different source
			if (mip > 0 && tex->rgb_mips[mip] && !tex->ext_rgb)
			{
				eargb = tex->rgb_mips[mip][ty * tw + tx];

				if (!eargb)
				{
					sc->rgb[v * cw + u] = 0;
					goto qsc_next_texel;
				}

				QLitTexelRGB(QPAL_GREY_REF, lightv, &wr, &wg, &wb);
				refv = qpal_rgb[QPAL_GREY_REF * 3];
				if (refv < 1)
					refv = 1;

				cr = ((eargb >> 16) & 255) * wr / refv;
				cg = ((eargb >> 8) & 255) * wg / refv;
				cb = (eargb & 255) * wb / refv;
			}
			//an external replacement supplies real colour; the 8bpp texel
			//still decides the cutout and still fills the index plane
			else if (tex->ext_rgb && tex->ext_w > 0 && tex->ext_h > 0)
			{
				ex = tx * tex->ext_w / tw;
				ey = ty * tex->ext_h / th;
				if (ex < 0) ex = 0;
				if (ey < 0) ey = 0;
				if (ex > tex->ext_w - 1) ex = tex->ext_w - 1;
				if (ey > tex->ext_h - 1) ey = tex->ext_h - 1;

				eargb = tex->ext_rgb[ey * tex->ext_w + ex];

				//the replacement's own alpha is a cutout too
				if (!eargb)
				{
					sc->rgb[v * cw + u] = 0;
					goto qsc_next_texel;
				}

				//Quake's intensity curve read off the grey ramp, so external
				//art dims exactly as the palette path would
				QLitTexelRGB(QPAL_GREY_REF, lightv, &wr, &wg, &wb);
				refv = qpal_rgb[QPAL_GREY_REF * 3];
				if (refv < 1)
					refv = 1;

				cr = ((eargb >> 16) & 255) * wr / refv;
				cg = ((eargb >> 8) & 255) * wg / refv;
				cb = (eargb & 255) * wb / refv;
			}
			else
			{
				//RAW palette RGB, before gamma and tint: those are applied
				//to the overlay at blit, so a tint costs no cache rebuild
				QLitTexelRGB(texel, lightv, &cr, &cg, &cb);
			}

			//the 512x512 art is palette-dithered, and point sampling turns
			//that dither into colour speckle. lighting is near constant over
			//a 2x2, so averaging the LIT colours filters the texture without
			//a divide. the index plane stays point sampled
			if (q_opt_texfilter && !tex->ext_rgb &&
				!(mip > 0 && tex->rgb_mips[mip]))
			{
				acc_r = cr;
				acc_g = cg;
				acc_b = cb;
				acc_n = 1;

				for (fi = 1; fi < 4; fi++)
				{
					ftx = QTexWrap(tx + (fi & 1), tw);
					fty = QTexWrap(ty + (fi >> 1), th);
					ftex = texels[fty * tw + ftx];

					//a cutout carries no colour and would halo the edge
					if (tex->is_fence && ftex == QFENCE_CUTOUT)
						goto qsc_next_tap;

					QLitTexelRGB(ftex, lightv, &fr2, &fg2, &fb2);
					acc_r += fr2;
					acc_g += fg2;
					acc_b += fb2;
					acc_n++;

qsc_next_tap:
				}

				cr = acc_r / acc_n;
				cg = acc_g / acc_n;
				cb = acc_b / acc_n;
			}

			//.lit carries the colour the mono plane averaged away. the mono
			//value already holds styles and dlights, so only the chroma
			//ratio is taken from the RGB luxels
			if (lit_base && texel < QPAL_FULLBRIGHT)
			{
				QLitBilinearRGB(lit_base, lm_w, lm_h, ToF64(s0) / 16.0,
					ToF64(t0) / 16.0, &lr, &lg, &lb);

				lm = (lr + lg + lb) / 3;
				if (lm > 0)
				{
					cr = cr * lr / lm;
					cg = cg * lg / lm;
					cb = cb * lb / lm;
				}
			}

			argb = (ClampI64(cr, 0, 255) << 16) |
				   (ClampI64(cg, 0, 255) << 8) | ClampI64(cb, 0, 255);

			sc->rgb[v * cw + u] = argb | QRGB_SET;

qsc_next_texel:
		}
	}

	if (_rgb)
		*_rgb = sc->rgb;

	q_probe_lit = ToBool(lit_base != NULL);

	sc->w         = cw;
	sc->h         = ch;
	sc->mip       = mip;
	sc->face      = face_index;
	sc->frame     = q_surf_frame;
	sc->light_key = key;
	sc->texture   = tex_key;

	q_face_surf[face_index] = slot;
	q_surf_builds++;
	q_surf_builds_frame++;

	*_cw = cw;
	*_ch = ch;

	return out;
}

U0 QDrawSpan(CQCanvas *c, I64 y, I64 x1, I64 x2,
	F64 iz1, F64 soz1, F64 toz1, F64 iz2, F64 soz2, F64 toz2,
	CQTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U8 *surf = NULL, I64 sw = 0, I64 sh = 0, U32 *surf_rgb = NULL)
{//fill one horizontal run. HOT LOOP - everything else runs a few thousand
 //times a frame, this runs a few hundred thousand
	U8	*row;
	U8	*texels;
	I32	*zrow;
	F64	 span;
	F64	 d_iz;
	F64	 d_soz;
	F64	 d_toz;
	F64	 iz;
	F64	 soz;
	F64	 toz;
	F64	 z;
	F64	 s;
	F64	 t;
	F64	 ws;
	F64	 wt;
	Bool	 turb;
	I64	 x;
	I64	 tw;
	I64	 th;
	I64	 tx;
	I64	 ty;
	F64	 lightv;
	F64	 dlight;
	F64	 light_e;
	I64	 light;
	I64	 shade;
	I64	 texel;
	I64	 xe;
	I64	 n;
	I64	 mins_s_i;
	I64	 mins_t_i;
	I64	 ufx;
	I64	 vfx;
	I64	 dufx;
	I64	 dvfx;
	F64	 iz_e;
	F64	 soz_e;
	F64	 toz_e;
	F64	 s_e;
	F64	 t_e;
	F64	 ds;
	F64	 dt;
	Bool clamp_tex;
	Bool fence;
	I64	 pend_raw;
	I64	 pend_cmap;
	I64	 izi;
	I64	 d_izi;
	U32	*crow;
	U32	 argb;

	//clipped to the VIEW RECT, not the canvas - outside is border or sbar
	if (y < c->vy || y >= c->vy + c->vh)
		return;

	//clamp horizontally, carrying the interpolants with the clamp
	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz  = (iz2 - iz1) / span;
	d_soz = (soz2 - soz1) / span;
	d_toz = (toz2 - toz1) / span;

	if (x1 < c->vx)
	{
		iz1  += d_iz * ToF64(c->vx - x1);
		soz1 += d_soz * ToF64(c->vx - x1);
		toz1 += d_toz * ToF64(c->vx - x1);
		x1 = c->vx;
	}

	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;

	if (x1 >= x2)
		return;

	//four mips per texture in the BSP. the small ones kill point-sample
	//shimmer and keep distant geometry in cache
	if (mip < 0)
		mip = 0;
	if (mip > 3)
		mip = 3;

	while (mip > 0 && !tex->texels[mip])
		mip--;

	//a cached surface is already lit and addressed in SURFACE space, so it
	//needs neither the wrap nor the colormap below
	if (surf && sw > 0 && sh > 0)
	{
		texels = surf;
		tw     = sw;
		th     = sh;
	}
	else
	{
		//a degenerate cache extent must clear surf too, or the loops below
		//address the texture with surface-space coordinates
		surf   = NULL;
		texels = tex->texels[mip];
		tw     = tex->width >> mip;
		th     = tex->height >> mip;
	}

	if (tw <= 0 || th <= 0 || !texels)
		return;

	mins_s_i = ToI64(mins_s);
	mins_t_i = ToI64(mins_t);

	clamp_tex = tex->clamp;

	//'{' textures: index 255 is a cutout. the surface cache keeps 255 intact
	//because it is already above QPAL_FULLBRIGHT and so skips the colormap
	fence = tex->is_fence;

	//turb never mips - the warp is defined in level 0 texels
	turb = tex->is_turb;
	if (turb)
		mip = 0;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;

	//the overlay is dropped per pixel, not per span: a span that loses the
	//depth test must not clear the RGB of whatever is in front of it
	crow = NULL;
	if (c->rgb && q_rgb_active)
		crow = c->rgb + y * c->width;

	q_probe_own = -1.0;
	pend_raw    = -1;
	pend_cmap   = -1;

	//the RGB plane only indexes alongside the index plane it was built with
	if (!crow || !surf)
		surf_rgb = NULL;

	iz  = iz1;
	soz = soz1;
	toz = toz1;

	//exact coords at the start of the run
	if (iz != 0.0)
	{
		z = 1.0 / iz;
		s = soz * z;
		t = toz * z;
	}
	else
	{
		s = 0.0;
		t = 0.0;
	}

	x = x1;

	//exact only at block ends, linear between - one divide per block instead
	//of per pixel, error stays well under a texel over 16
	while (x < x2)
	{
		xe = x + QSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		//interpolants at the far end of this block
		iz_e  = iz + d_iz * ToF64(n);
		soz_e = soz + d_soz * ToF64(n);
		toz_e = toz + d_toz * ToF64(n);

		if (iz_e != 0.0)
		{
			z   = 1.0 / iz_e;
			s_e = soz_e * z;
			t_e = toz_e * z;
		}
		else
		{
			s_e = s;
			t_e = t;
		}

		ds = (s_e - s) / ToF64(n);
		dt = (t_e - t) / ToF64(n);

		//a cached surface carries its own light, so the bilinear fetches and
		//the per-pixel light step below are dead work on that path
		if (surf)
		{
			lightv = 0.0;
			dlight = 0.0;
		}
		else if (lightmap && lm_w > 0 && lm_h > 0)
		{
			lightv  = QLightBilinear(lightmap, lm_w, lm_h,
						(s - mins_s) / 16.0, (t - mins_t) / 16.0);
			light_e = QLightBilinear(lightmap, lm_w, lm_h,
						(s_e - mins_s) / 16.0, (t_e - mins_t) / 16.0);
			dlight  = (light_e - lightv) / ToF64(n);
		}
		else
		{
			lightv = ToF64(flat_light);
			dlight = 0.0;
		}

		//cached surface: texel coords are surface space and already clamped,
		//so the whole per-pixel float path collapses to 16.16 integer steps.
		//mins_s_i is integral, so Floor(s) - mins_s_i == Floor(s - mins_s_i)
		if (surf)
		{
			//one conversion per block; the pixel loop steps integers only
			izi   = ToI64(iz * QDEPTH_SCALE);
			d_izi = ToI64(d_iz * QDEPTH_SCALE);

			ufx  = ToI64((s - ToF64(mins_s_i)) * 65536.0);
			vfx  = ToI64((t - ToF64(mins_t_i)) * 65536.0);
			dufx = ToI64(ds * 65536.0);
			dvfx = ToI64(dt * 65536.0);

			while (x < xe)
			{
				if (izi > zrow[x])
				{
					tx = ClampI64((ufx >> 16) >> mip, 0, tw - 1);
					ty = ClampI64((vfx >> 16) >> mip, 0, th - 1);

					texel = texels[ty * tw + tx];

					//a cutout writes neither color nor depth
					if (!fence || texel != QFENCE_CUTOUT)
					{
						argb = 0;
						if (crow && surf_rgb)
							argb = surf_rgb[ty * tw + tx];

						//with a live overlay texel the index under it is
						//never read: every writer that drops the overlay
						//(sprites, particles, hud, menu dim) writes the
						//index at the same pixel itself. skipping the
						//store saves a byte per world pixel
						if (argb)
							crow[x] = argb;
						else
						{
							row[x] = texel;
							if (crow)
								crow[x] = 0;
						}

						zrow[x] = izi;
						if (x == q_probe_x)
							q_probe_own = izi;
					}
				}

				ufx += dufx;
				vfx += dvfx;
				iz  += d_iz;
				izi += d_izi;
				x++;
			}

			goto qds_block_end;
		}

		//same block-level conversion for the uncached path
		izi   = ToI64(iz * QDEPTH_SCALE);
		d_izi = ToI64(d_iz * QDEPTH_SCALE);

		while (x < xe)
		{
			//depth test first, a rejected pixel costs only the adds below
			if (izi > zrow[x])
			{
			//Floor, not ToI64 - ToI64 truncates toward zero and leaves a
			//one-texel seam wherever s or t crosses 0
			//
			//s and t stay in level 0 space and are shifted to the mip here,
			//so the lightmap lookup below still sees unshifted values
			if (surf)
			{
				//surface space, one cache texel per drawn texel at this mip
				tx = ClampI64((ToI64(Floor(s)) - mins_s_i) >> mip, 0, tw - 1);
				ty = ClampI64((ToI64(Floor(t)) - mins_t_i) >> mip, 0, th - 1);
			}
			else if (turb)
			{
				//cross-coupled sine warp, each axis indexed by the OTHER
				ws = s + q_turb_table[(ToI64(Floor(t)) + q_turb_phase) &
						(QTURB_CYCLE - 1)];
				wt = t + q_turb_table[(ToI64(Floor(s)) + q_turb_phase) &
						(QTURB_CYCLE - 1)];

				tx = ToI64(Floor(ws)) >> mip;
				ty = ToI64(Floor(wt)) >> mip;
			}
			else
			{
				tx = ToI64(Floor(s)) >> mip;
				ty = ToI64(Floor(t)) >> mip;
			}

			if (surf)
			{
				//already clamped above
			}
			else if (clamp_tex)
			{
				//model skin, arbitrary size, never tiles
				tx = ClampI64(tx, 0, tw - 1);
				ty = ClampI64(ty, 0, th - 1);
			}
			else
			{
				//world texture, tiles at whatever size it is
				tx = QTexWrap(tx, tw);
				ty = QTexWrap(ty, th);
			}

			texel = texels[ty * tw + tx];

			if (fence && texel == QFENCE_CUTOUT)
				goto qds_next_pixel;

			if (surf)
				row[x] = texel;			//lit when the surface was built
			else
			{
				light = ClampI64(ToI64(lightv), 0, 255);

				//colormap row 0 is brightest, 63 darkest
				shade = (255 - light) >> 2;
				shade = ClampI64(shade, 0, QPAL_SHADES - 1);

				if (texel >= QPAL_FULLBRIGHT)
					row[x] = texel;		//fullbrights ignore lighting
				else
					row[x] = qpal_colormap[shade * QPAL_COLORS + texel];
			}

			if (crow)
				crow[x] = 0;

			zrow[x] = izi;
			if (x == q_probe_x)
			{
				q_probe_own = izi;
				pend_raw    = texel;
				pend_cmap   = row[x];
			}
			}

qds_next_pixel:
			s      += ds;
			t      += dt;
			lightv += dlight;
			iz     += d_iz;
			izi    += d_izi;
			x++;
		}

qds_block_end:
		//resync exact, don't carry stepping error into the next block
		iz  = iz_e;
		soz = soz_e;
		toz = toz_e;
		s   = s_e;
		t   = t_e;
	}

	//probe: only the span that actually owns the pixel may describe it.
	//comparing against the depth buffer alone let one span's texture name be
	//reported next to another span's texel
	if (q_probe_req && y == q_probe_y &&
		q_probe_x >= x1 && q_probe_x < x2)
	{
		izi = c->depth[y * c->width + q_probe_x];

		//what THIS span left at that pixel; anything else means another
		//surface won and this one has nothing to say
		if (izi > 0 && izi == q_probe_own && izi >= q_probe_iz)
		{
			q_probe_iz    = izi;
			q_probe_hit   = TRUE;
			q_probe_sky   = FALSE;
			q_probe_texel = row[q_probe_x];
			q_probe_mip   = mip;
			q_probe_fence = fence;
			q_probe_surf  = ToBool(surf != NULL);
			q_probe_raw   = pend_raw;
			q_probe_cmap  = pend_cmap;
			q_probe_tw    = tw;
			q_probe_th    = th;
			q_probe_lmw   = lm_w;
			q_probe_lmh   = lm_h;
			q_probe_light = ToI64(lightv);
			q_probe_rgb   = ToBool(crow != NULL &&
								(crow[q_probe_x] & QRGB_SET) != 0);
			QStrCopy(q_probe_tex, tex->name, 16);
		}
	}

	c->spans_drawn++;
}

U0 QDrawPolygon(CQCanvas *c, CQScreenVert *v, I64 count,
	CQTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U8 *surf = NULL, I64 sw = 0, I64 sh = 0, U32 *surf_rgb = NULL)
{//scanline fill of a convex poly - intersect every edge per row, extremes
 //become the span. O(edges), but rarely more than eight after clipping, and
 //no active edge table to get the winding order wrong in
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 sozl;
	F64	 sozr;
	F64	 tozl;
	F64	 tozr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 sozi;
	F64	 tozi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;
		sozl  = 0.0;
		sozr  = 0.0;
		tozl  = 0.0;
		tozr  = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			//half open so a shared vertex isn't counted twice
			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);
				sozi = v[i].s_over_z + frac * (v[j].s_over_z - v[i].s_over_z);
				tozi = v[i].t_over_z + frac * (v[j].t_over_z - v[i].t_over_z);

				if (!found)
				{
					xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					}
				}
			}
		}

		if (found && xr > xl)
		{
			QDrawSpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)),
				izl, sozl, tozl, izr, sozr, tozr,
				tex, lightmap, lm_w, lm_h, mins_s, mins_t, flat_light, mip,
				surf, sw, sh, surf_rgb);
		}
	}
}

//--- skybox (Fitz/QS/Ironwail gfx/env) ------------------------------------
//
// worldspawn "sky" / "skyname" → gfx/env/<name>{rt,bk,lf,ft,up,dn}.tga
// faces quantized to the Quake palette. when ready, QDrawSkySpan samples the
// cube; otherwise classic scroll runs

#define QSKY_FACES		6
#define QSKY_RT			0
#define QSKY_LF			1
#define QSKY_BK			2
#define QSKY_FT			3
#define QSKY_UP			4
#define QSKY_DN			5

U8	*q_sky_pix[QSKY_FACES];		//quantized, used when truecolor is off
U32	*q_sky_rgb[QSKY_FACES];		//source 0xRRGGBB, kept so the toggle is live
I64	 q_sky_w[QSKY_FACES];
I64	 q_sky_h[QSKY_FACES];
U8	 q_sky_name[64];
Bool q_sky_ready	= FALSE;
I64	 q_sky_loaded	= 0;
U8	 q_sky_solid	= 0;

//--- fog --------------------------------------------------------------------
//
// worldspawn carries it three ways: "fog" "density r g b", or the ericw pair
// "fog_density" / "fog_color". colour is 0-1 in the first form and 0-255 in
// the second, and some maps mix them, so the scale is detected per value
//
// applied at blit from the depth buffer, so world, models, sprites and sky all
// fog through one path instead of each rasteriser growing its own blend

#define QFOG_LUT		1024

//iz at z=64. nearer than that is unfogged, so the table spends its resolution
//on the mid and far range where fog actually varies
#define QFOG_IZ_MAX		0.015625

Bool	q_opt_fog		= TRUE;
Bool	q_fog_on		= FALSE;
F64		q_fog_density	= 0.0;
I64		q_fog_r			= 0;
I64		q_fog_g			= 0;
I64		q_fog_b			= 0;
U8		q_fog_lut[QFOG_LUT];	//fog alpha 0-255 by quantized iz
//depth 0 is sky. fogging it fully would flatten the skybox, so it stays clear
//unless the map asks for it with _skyfog. QS and Ironwail default this to
//0.5: fully clear reads as a hole punched in the weather
#define QFOG_SKY_DEFAULT	128
I64		q_fog_sky_alpha	= QFOG_SKY_DEFAULT;

//0 disables the cull. set from density, see QFogSet
F64		q_fog_cull_dist	= 0.0;

U0 QFogBuild()
{//f = 1 - exp(-(density * z)^2), the exp2 curve GLQuake and Ironwail use
	F64 iz;
	F64 z;
	F64 f;
	I64 i;

	for (i = 0; i < QFOG_LUT; i++)
	{
		iz = QFOG_IZ_MAX * ToF64(i) / ToF64(QFOG_LUT - 1);

		//index 0 is z at infinity
		if (iz <= 0.0)
		{
			q_fog_lut[i] = 255;
			goto qfb_next;
		}

		z = 1.0 / iz;

		//GLQuake and Ironwail feed GL_FOG_DENSITY density/64, so map values
		//are in those units. using the raw value fogs solid within ~80 units
		f = q_fog_density * z / 64.0;
		f = 1.0 - Exp(-(f * f));

		q_fog_lut[i] = ClampI64(ToI64(f * 255.0 + 0.5), 0, 255);

qfb_next:
	}
}

U0 QFogSet(F64 density, I64 r, I64 g, I64 b)
{
	q_fog_density = density;

	//distance where the blend is 99% fog: beyond it geometry cannot show, so
	//the face walk skips it. -ln(0.01) = 4.605, sqrt = 2.146
	if (density > 0.0)
		q_fog_cull_dist = 2.146 * 64.0 / density;
	else
		q_fog_cull_dist = 0.0;

	q_fog_r       = ClampI64(r, 0, 255);
	q_fog_g       = ClampI64(g, 0, 255);
	q_fog_b       = ClampI64(b, 0, 255);
	q_fog_on      = ToBool(density > 0.0);

	//the console/stuffcmd path carries no _skyfog, so it takes the default.
	//worldspawn overrides this afterwards only when the key was present
	q_fog_sky_alpha = QFOG_SKY_DEFAULT;

	if (q_fog_on)
		QFogBuild;
}

U0 QFogClear()
{
	q_fog_on        = FALSE;
	q_fog_density   = 0.0;
	q_fog_sky_alpha = QFOG_SKY_DEFAULT;
	q_fog_cull_dist = 0.0;
}

U0 QRGBUpdateActive()
{//the overlay costs a clear per frame and a branch per blitted pixel, so it
 //stays off unless something is actually feeding it
	//the world feeds the overlay whenever truecolor is on, so the plane is
	//live independently of the sky or the lighting mode
	q_rgb_active = q_opt_truecolor;
}

U8 *QSkySuffix(I64 face)
{
	if (face == QSKY_RT)	return "rt";
	if (face == QSKY_LF)	return "lf";
	if (face == QSKY_BK)	return "bk";
	if (face == QSKY_FT)	return "ft";
	if (face == QSKY_UP)	return "up";
	return "dn";
}

U0 QSkyFree()
{
	I64 i;

	for (i = 0; i < QSKY_FACES; i++)
	{
		if (q_sky_pix[i])
			Free(q_sky_pix[i]);
		if (q_sky_rgb[i])
			Free(q_sky_rgb[i]);
		q_sky_pix[i] = NULL;
		q_sky_rgb[i] = NULL;
		q_sky_w[i]   = 0;
		q_sky_h[i]   = 0;
	}

	q_sky_ready   = FALSE;
	q_sky_loaded  = 0;
	q_sky_name[0] = 0;
	QRGBUpdateActive;
}

U0 QSkyInit()
{
	I64 i;

	for (i = 0; i < QSKY_FACES; i++)
	{
		q_sky_pix[i] = NULL;
		q_sky_rgb[i] = NULL;
		q_sky_w[i]   = 0;
		q_sky_h[i]   = 0;
	}

	q_sky_ready   = FALSE;
	q_sky_loaded  = 0;
	q_sky_name[0] = 0;
	q_sky_solid   = 0;
	QRGBUpdateActive;
}

Bool QSkyLoadFace(U8 *name, I64 face)
{
	U8	*data;
	U8	*out;
	U32	*rgb;
	U8	*sfx;
	CDC	*dc;
	U8	 path[96];
	I64	 size = 0;
	I64	 w;
	I64	 h;
	I64	 x;
	I64	 y;
	U32	 pix;

	sfx = QSkySuffix(face);
	StrPrint(path, "gfx/env/%s%s.tga", name, sfx);

	data = QPakLoad(path, &size);
	if (!data)
		return FALSE;

	dc = TGAReadBuf(data, size);
	Free(data);
	if (!dc)
		return FALSE;

	w = dc->width;
	h = dc->height;
	if (w < 1 || h < 1)
	{
		DCDel(dc);
		return FALSE;
	}

	out = MAlloc(w * h);
	rgb = MAlloc(w * h * sizeof(U32));
	if (!out || !rgb)
	{
		if (out)	Free(out);
		if (rgb)	Free(rgb);
		DCDel(dc);
		return FALSE;
	}

	for (y = 0; y < h; y++)
	{
		for (x = 0; x < w; x++)
		{
			pix = dc->body[y * dc->width_internal + x] & 0x00FFFFFF;
			rgb[y * w + x] = pix | QRGB_SET;
			out[y * w + x] = QPalNearestRGB(
				(pix >> 16) & 255, (pix >> 8) & 255, pix & 255);
		}
	}

	DCDel(dc);
	q_sky_pix[face] = out;
	q_sky_rgb[face] = rgb;
	q_sky_w[face]   = w;
	q_sky_h[face]   = h;
	return TRUE;
}

U0 QSkyLoad(U8 *name)
{
	I64 ok = 0;
	I64 i;

	QSkyFree;
	if (!name || !name[0])
		return;

	QStrCopy(q_sky_name, name, 64);
	for (i = 0; i < QSKY_FACES; i++)
	{
		if (QSkyLoadFace(name, i))
			ok++;
	}

	q_sky_loaded = ok;
	if (ok > 0)
		q_sky_ready = TRUE;
	else
		q_sky_name[0] = 0;

	QRGBUpdateActive;

	if (ok == QSKY_FACES)
		"QSky: %s, six faces\n", name;
	else if (ok > 0)
		"QSky: %s, %d of 6 faces\n", name, ok;
	else
		"QSky: gfx/env/%s* missing, classic scroll\n", name;
}

I64 QFogParseFloats(U8 *sv, F64 *out, I64 max)
{//space separated floats, returns how many were read
	I64	 n = 0;
	I64	 i = 0;
	I64	 st;
	U8	 tok[32];
	I64	 t;

	while (sv[i] && n < max)
	{
		while (sv[i] == ' ' || sv[i] == '\t')
			i++;
		if (!sv[i])
			break;

		st = i;
		t  = 0;
		while (sv[i] && sv[i] != ' ' && sv[i] != '\t' && t < 31)
		{
			tok[t] = sv[i];
			t++;
			i++;
		}
		tok[t] = 0;

		if (t > 0)
		{
			out[n] = Str2F64(tok);
			n++;
		}

		if (st == i)
			break;
	}

	return n;
}

U0 QFogCommand(U8 *args)
{//"<density> [r g b]" - colour omitted keeps the current one, density 0 is
 //off. QS treats the colour as 0-1, but maps written against the 0-255 form
 //exist, so the scale is detected the same way the worldspawn parser does
	F64 fv[4];
	I64 n;
	F64 r;
	F64 g;
	F64 b;

	n = QFogParseFloats(args, fv, 4);
	if (n < 1)
		return;

	if (fv[0] <= 0.0)
	{
		QFogClear;
		return;
	}

	if (n >= 4)
	{
		r = fv[1];
		g = fv[2];
		b = fv[3];

		if (r > 1.0 || g > 1.0 || b > 1.0)
		{
			r = r / 255.0;
			g = g / 255.0;
			b = b / 255.0;
		}

		QFogSet(fv[0], ToI64(r * 255.0), ToI64(g * 255.0), ToI64(b * 255.0));
	}
	else
		QFogSet(fv[0], q_fog_r, q_fog_g, q_fog_b);
}

U0 QSkyParseWorldspawn(CQMap *map, U8 *out, I64 max)
{
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[64];
	I64	 k;
	Bool in_world;
	F64	 fv[4];
	I64	 fn;
	F64	 fog_d = 0.0;
	F64	 fog_r = 0.0;
	F64	 fog_g = 0.0;
	F64	 fog_b = 0.0;
	F64	 sky_f = 0.0;
	Bool sky_f_set = FALSE;
	Bool fog_c = FALSE;

	QFogClear;
	out[0] = 0;
	if (!map || !map->entities || map->entities_size < 2 || max < 2)
		return;

	p   = map->entities;
	end = p + map->entities_size;

	while (p < end)
	{
		while (p < end && *p != '{')
			p++;
		if (p >= end)
			return;
		p++;

		in_world = FALSE;
		out[0]   = 0;

		while (p < end && *p != '}')
		{
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;
			p++;
			k = 0;
			while (p < end && *p != '"' && k < 63)
			{
				key[k] = *p;
				k++;
				p++;
			}
			key[k] = 0;
			if (p < end)
				p++;

			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;
			p++;
			k = 0;
			while (p < end && *p != '"' && k < 63)
			{
				val[k] = *p;
				k++;
				p++;
			}
			val[k] = 0;
			if (p < end)
				p++;

			if (!StrCompare(key, "classname") &&
				!StrCompare(val, "worldspawn"))
				in_world = TRUE;

			if (!StrCompare(key, "sky") || !StrCompare(key, "skyname"))
				QStrCopy(out, val, max);

			//"fog" "density r g b" - colour 0-1 here
			if (!StrCompare(key, "fog"))
			{
				fn = QFogParseFloats(val, fv, 4);
				if (fn >= 1)
					fog_d = fv[0];
				if (fn >= 4)
				{
					fog_r = fv[1];
					fog_g = fv[2];
					fog_b = fv[3];
					fog_c = TRUE;
				}
			}

			if (!StrCompare(key, "fog_density"))
			{
				if (QFogParseFloats(val, fv, 1) >= 1)
					fog_d = fv[0];
			}

			//"_skyfog" is a 0-1 scalar, sometimes written as three copies
			if (!StrCompare(key, "_skyfog"))
			{
				if (QFogParseFloats(val, fv, 1) >= 1)
				{
					sky_f     = fv[0];
					sky_f_set = TRUE;
				}
			}

			//ericw writes this one 0-255
			if (!StrCompare(key, "fog_color"))
			{
				if (QFogParseFloats(val, fv, 3) >= 3)
				{
					fog_r = fv[0];
					fog_g = fv[1];
					fog_b = fv[2];
					fog_c = TRUE;
				}
			}
		}

		if (in_world)
		{
			//0-1 and 0-255 both appear, sometimes in the same map
			if (fog_c && (fog_r > 1.0 || fog_g > 1.0 || fog_b > 1.0))
			{
				fog_r = fog_r / 255.0;
				fog_g = fog_g / 255.0;
				fog_b = fog_b / 255.0;
			}

			if (fog_d > 0.0)
			{
				QFogSet(fog_d, ToI64(fog_r * 255.0), ToI64(fog_g * 255.0),
					ToI64(fog_b * 255.0));
				if (sky_f_set)
					q_fog_sky_alpha = ClampI64(ToI64(sky_f * 255.0), 0, 255);
			}
			return;
		}

		fog_d  = 0.0;
		sky_f     = 0.0;
		sky_f_set = FALSE;
		fog_c  = FALSE;
		out[0] = 0;
		if (p < end)
			p++;
	}
}

U0 QSkyNewMap(CQMap *map)
{
	U8 name[64];

	QSkyParseWorldspawn(map, name, 64);
	if (name[0])
		QSkyLoad(name);
	else
		QSkyFree;
}

U0 QSkyRay(F64 *d, I64 *_face, F64 *_u, F64 *_v)
{
	F64 ax;
	F64 ay;
	F64 az;
	F64 den;
	F64 s;
	F64 t;
	I64 face;

	ax = d[0];
	if (ax < 0.0) ax = -ax;
	ay = d[1];
	if (ay < 0.0) ay = -ay;
	az = d[2];
	if (az < 0.0) az = -az;

	if (ax >= ay && ax >= az)
	{
		if (d[0] > 0.0)
		{
			face = QSKY_RT; den = d[0]; s = -d[1]; t = d[2];
		}
		else
		{
			face = QSKY_LF; den = -d[0]; s = d[1]; t = d[2];
		}
	}
	else if (ay >= az)
	{
		if (d[1] > 0.0)
		{
			face = QSKY_BK; den = d[1]; s = d[0]; t = d[2];
		}
		else
		{
			face = QSKY_FT; den = -d[1]; s = -d[0]; t = d[2];
		}
	}
	else
	{
		if (d[2] > 0.0)
		{
			face = QSKY_UP; den = d[2]; s = -d[1]; t = -d[0];
		}
		else
		{
			face = QSKY_DN; den = -d[2]; s = -d[1]; t = d[0];
		}
	}

	if (den < 0.000001)
		den = 0.000001;
	s /= den;
	t /= den;

	*_face = face;
	*_u = (s + 1.0) * 0.5 * ToF64(q_sky_w[face]);
	*_v = (1.0 - t) * 0.5 * ToF64(q_sky_h[face]);
}

U8 QSkyTexel(I64 face, F64 u, F64 v)
{
	U8 *p;
	I64 w;
	I64 h;
	I64 iu;
	I64 iv;

	if (!q_sky_ready || face < 0 || face >= QSKY_FACES)
		return q_sky_solid;
	p = q_sky_pix[face];
	if (!p)
		return q_sky_solid;

	w = q_sky_w[face];
	h = q_sky_h[face];
	iu = ToI64(u);
	iv = ToI64(v);
	if (iu < 0) iu = 0;
	if (iu >= w) iu = w - 1;
	if (iv < 0) iv = 0;
	if (iv >= h) iv = h - 1;
	return p[iv * w + iu];
}

U32 QSkyTexelRGB(I64 face, F64 u, F64 v)
{//0 when this face has no RGB source; caller falls back to the index plane
	U32 *p;
	I64	 w;
	I64	 h;
	I64	 iu;
	I64	 iv;

	if (!q_sky_ready || face < 0 || face >= QSKY_FACES)
		return 0;
	p = q_sky_rgb[face];
	if (!p)
		return 0;

	w = q_sky_w[face];
	h = q_sky_h[face];
	iu = ToI64(u);
	iv = ToI64(v);
	if (iu < 0) iu = 0;
	if (iu >= w) iu = w - 1;
	if (iv < 0) iv = 0;
	if (iv >= h) iv = h - 1;
	return p[iv * w + iu];
}

U0 QDrawSkyBoxSpan(CQCanvas *c, I64 y, I64 x1, I64 x2, F64 iz1, F64 iz2)
{
	U8	*row;
	U32	*crow;
	U32	 texel;
	I32	*zrow;
	F64	 dir[3];
	F64	 step[3];
	F64	 cur[3];
	F64	 sxf;
	F64	 syf;
	F64	 span;
	F64	 d_iz;
	F64	 iz;
	F64	 u0;
	F64	 v0;
	F64	 u1;
	F64	 v1;
	F64	 du;
	F64	 dv;
	F64	 u;
	F64	 v;
	I64	 x;
	I64	 i;
	I64	 xe;
	I64	 n;
	I64	 f0;
	I64	 f1;
	I64	 fc;

	if (y < c->vy || y >= c->vy + c->vh)
		return;
	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;
	d_iz = (iz2 - iz1) / span;
	if (x1 < 0)
	{
		iz1 += d_iz * ToF64(-x1);
		x1 = c->vx;
	}
	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;
	if (x1 >= x2)
		return;

	sxf = (ToF64(x1) - c->center_x) / c->x_scale;
	syf = (c->center_y - ToF64(y)) / c->y_scale;
	for (i = 0; i < 3; i++)
	{
		dir[i] = c->forward[i] + c->right[i] * sxf + c->up[i] * syf;
		step[i] = c->right[i] / c->x_scale;
	}

	row = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;
	crow = NULL;
	if (c->rgb)
		crow = c->rgb + y * c->width;
	iz = iz1;
	x = x1;
	while (x < x2)
	{
		xe = x + 8;
		if (xe > x2)
			xe = x2;
		n = xe - x;
		if (n < 1)
			goto qsb_adv;

		for (i = 0; i < 3; i++)
			cur[i] = dir[i] + step[i] * ToF64(n);

		QSkyRay(dir, &f0, &u0, &v0);
		QSkyRay(cur, &f1, &u1, &v1);

		if (f0 == f1 && n > 1)
		{
			du = (u1 - u0) / ToF64(n);
			dv = (v1 - v0) / ToF64(n);
			u = u0;
			v = v0;
			fc = f0;
			while (x < xe)
			{
				if (ToI64(iz * QDEPTH_SCALE) >= zrow[x])
				{
					//the index plane is filled either way: if anything
					//later drops the overlay at this pixel, the 8bpp
					//quantized sky is what has to show through
					row[x] = QSkyTexel(fc, u, v);

					texel = 0;
					if (crow)
					{
						texel = QSkyTexelRGB(fc, u, v);
						crow[x] = texel;
					}
					zrow[x] = 0;
				}
				iz += d_iz;
				u += du;
				v += dv;
				x++;
			}
			for (i = 0; i < 3; i++)
				dir[i] = cur[i];
		}
		else
		{
			while (x < xe)
			{
				if (ToI64(iz * QDEPTH_SCALE) >= zrow[x])
				{
					QSkyRay(dir, &fc, &u, &v);
					//the index plane is filled either way: if anything
					//later drops the overlay at this pixel, the 8bpp
					//quantized sky is what has to show through
					row[x] = QSkyTexel(fc, u, v);

					texel = 0;
					if (crow)
					{
						texel = QSkyTexelRGB(fc, u, v);
						crow[x] = texel;
					}
					zrow[x] = 0;
				}
				iz += d_iz;
				for (i = 0; i < 3; i++)
					dir[i] = dir[i] + step[i];
				x++;
			}
		}

qsb_adv:
	}
	if (q_probe_req && y == q_probe_y &&
		q_probe_x >= x1 && q_probe_x < x2)
	{
		if (!q_probe_hit)
		{
			q_probe_hit   = TRUE;
			q_probe_sky   = TRUE;
			q_probe_texel = row[q_probe_x];
			q_probe_rgb   = ToBool(crow != NULL &&
								(crow[q_probe_x] & QRGB_SET) != 0);
			QStrCopy(q_probe_tex, "<skybox>", 16);
		}
	}

	c->spans_drawn++;
}

//--- sky -------------------------------------------------------------------
//
// a sky texture is 256x128 holding two 128x128 layers side by side: RIGHT is
// the solid starfield, LEFT is clouds where index 0 shows the layer behind
//
// sky is textured by the direction from the eye through each pixel, not by
// surface position, so it never slides as the player walks. the direction is
// flattened vertically onto a fixed-radius dome and the two layers scroll at
// different speeds for parallax. if QSkyNewMap loaded an env set, the box
// path above runs instead

#define QSKY_LAYER		128		//each layer is 128x128
#define QSKY_MASK		127
#define QSKY_DOME		378.0	//dome radius
#define QSKY_FLATTEN	3.0		//vertical squash, reads as a ceiling
#define QSKY_SPEED_BG	8.0		//starfield drift, units/sec
#define QSKY_SPEED_FG	16.0	//clouds twice as fast, parallax

F64 q_sky_time = 0.0;

//underwater view distortion, set from the player's water level. amount is in
//source pixels of sideways shear, zero disables the path
F64 q_warp_amount = 0.0;
F64 q_warp_time   = 0.0;

U0 QDrawSkySpan(CQCanvas *c, I64 y, I64 x1, I64 x2, F64 iz1, F64 iz2,
	CQTexture *tex)
{//env cube when ready, else classic dual-layer dome
	U8	*row;
	U8	*texels;
	I32	*zrow;
	F64	 dir[3];
	F64	 step[3];
	F64	 sxf;
	F64	 syf;
	F64	 vx;
	F64	 vy;
	F64	 vz;
	F64	 len;
	F64	 scale;
	F64	 dx;
	F64	 dy;
	F64	 span;
	F64	 d_iz;
	F64	 iz;
	F64	 bg;
	F64	 fg;
	I64	 x;
	I64	 tw;
	I64	 s1;
	I64	 t1;
	I64	 s2;
	I64	 t2;
	I64	 texel;
	I64	 cloud;
	I64	 i;
	I64	 xe;
	I64	 n;
	F64	 dx_e;
	F64	 dy_e;
	F64	 ddx;
	F64	 ddy;

	if (q_sky_ready)
	{
		QDrawSkyBoxSpan(c, y, x1, x2, iz1, iz2);
		return;
	}

	//clipped to the VIEW RECT, not the canvas - outside is border or sbar
	if (y < c->vy || y >= c->vy + c->vh)
		return;

	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz = (iz2 - iz1) / span;

	if (x1 < 0)
	{
		iz1 += d_iz * ToF64(-x1);
		x1 = c->vx;
	}
	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;
	if (x1 >= x2)
		return;

	tw     = tex->width;
	texels = tex->texels[0];
	if (!texels || tw < 2 * QSKY_LAYER || tex->height < QSKY_LAYER)
		return;

	//ray through the first pixel, and the per-pixel step along it
	sxf = (ToF64(x1) - c->center_x) / c->x_scale;
	syf = (c->center_y - ToF64(y)) / c->y_scale;

	for (i = 0; i < 3; i++)
	{
		dir[i]  = c->forward[i] + c->right[i] * sxf + c->up[i] * syf;
		step[i] = c->right[i] / c->x_scale;
	}

	bg = q_sky_time * QSKY_SPEED_BG;
	fg = q_sky_time * QSKY_SPEED_FG;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;
	iz   = iz1;

	//the dome warp costs a sqrt and a divide, so it goes at block boundaries
	//only - the sky is smooth and distant, the error is invisible
	vx  = dir[0];
	vy  = dir[1];
	vz  = dir[2] * QSKY_FLATTEN;
	len = Sqrt(vx * vx + vy * vy + vz * vz);
	if (len > 0.0)
	{
		scale = QSKY_DOME / len;
		dx    = vx * scale;
		dy    = vy * scale;
	}
	else
	{
		dx = 0.0;
		dy = 0.0;
	}

	x = x1;

	while (x < x2)
	{
		xe = x + QSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		//ray at the far end of this block, warped exactly
		vx  = dir[0] + step[0] * ToF64(n);
		vy  = dir[1] + step[1] * ToF64(n);
		vz  = (dir[2] + step[2] * ToF64(n)) * QSKY_FLATTEN;
		len = Sqrt(vx * vx + vy * vy + vz * vz);

		if (len > 0.0)
		{
			scale = QSKY_DOME / len;
			dx_e  = vx * scale;
			dy_e  = vy * scale;
		}
		else
		{
			dx_e = dx;
			dy_e = dy;
		}

		ddx = (dx_e - dx) / ToF64(n);
		ddy = (dy_e - dy) / ToF64(n);

		while (x < xe)
		{
			if (ToI64(iz * QDEPTH_SCALE) > zrow[x])
			{
				//clouds in front, index 0 there lets the starfield show
				s2    = ToI64(Floor(fg + dx)) & QSKY_MASK;
				t2    = ToI64(Floor(fg + dy)) & QSKY_MASK;
				cloud = texels[t2 * tw + s2];

				if (cloud)
					texel = cloud;
				else
				{
					s1    = ToI64(Floor(bg + dx)) & QSKY_MASK;
					t1    = ToI64(Floor(bg + dy)) & QSKY_MASK;
					texel = texels[t1 * tw + s1 + QSKY_LAYER];
				}

				//sky is emissive, never shaded by the colormap
				row[x]  = texel;
				zrow[x] = ToI64(iz * QDEPTH_SCALE);
			}

			dx += ddx;
			dy += ddy;
			iz += d_iz;
			x++;
		}

		dir[0] += step[0] * ToF64(n);
		dir[1] += step[1] * ToF64(n);
		dir[2] += step[2] * ToF64(n);
		dx      = dx_e;
		dy      = dy_e;
	}

	c->spans_drawn++;
}

U0 QDrawSkyPolygon(CQCanvas *c, CQScreenVert *v, I64 count, CQTexture *tex)
{//same edge walk as the textured path, but only depth interpolates - the
 //texture comes from the view ray, not surface coords
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);

				if (!found)
				{
					xl = xi; izl = izi;
					xr = xi; izr = izi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi;
					}
				}
			}
		}

		if (found && xr > xl)
			QDrawSkySpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)), izl, izr, tex);
	}
}

U0 QDrawFace(CQCanvas *c, CQMap *map, I64 face_index, F64 *offset = NULL,
	I64 ent_frame = 0)
{//transform, clip, project and fill one BSP face
 //
 //offset translates the face in world space, which is what lets a BRUSH MODEL
 //follow its entity - submodel verts are authored where the designer put the
 //brush, so without it every door draws shut. NULL is the world
 //
 //texture coords come from the UNSHIFTED position: the texture is fixed to
 //the brush, so a moving door doesn't drag its texture with it
	CQFace		*f  = &map->faces[face_index];
	CQTexInfo	*ti;
	CQTexture	*tex;
	CQPolyVert	 poly[QMAX_POLY_VERTS];
	CQPolyVert	 clipped[QMAX_POLY_VERTS];
	CQScreenVert scr[QMAX_POLY_VERTS];
	CQVertex	*wv;
	U8			*lightmap = NULL;
	U8			*surf = NULL;
	U32			*surf_rgb = NULL;
	I64			 sw = 0;
	I64			 sh = 0;
	F64			 rel[3];
	F64			 inv_z;
	I64			 n = 0;
	I64			 count;
	I64			 lm_w = 0;
	I64			 lm_h = 0;
	I64			 i;
	I64			 e;
	I64			 anim_tex;
	I64			 mip;
	F64			 near_z;
	F64			 ratio;
	F64		   shifted[3];
	F64		   cull_d[3];

	if (f->num_edges < 3 || f->num_edges > QMAX_POLY_VERTS)
		return;

	//fog cull: past the distance where the blend saturates, a face cannot
	//show through. rejecting here skips the transform, clip and raster.
	//the sphere is world space, so a brush model's offset shifts it too
	if (q_opt_fog && q_fog_on && q_fog_cull_dist > 0.0)
	{
		cull_d[0] = f->center[0] - c->origin[0];
		cull_d[1] = f->center[1] - c->origin[1];
		cull_d[2] = f->center[2] - c->origin[2];

		if (offset)
		{
			cull_d[0] += offset[0];
			cull_d[1] += offset[1];
			cull_d[2] += offset[2];
		}

		if (QVecLength(cull_d) - f->radius > q_fog_cull_dist)
		{
			q_fog_culled++;
			return;
		}
	}

	ti = &map->texinfo[f->tex_info];
	if (ti->miptex < 0 || ti->miptex >= map->num_textures)
		return;

	//R_TextureAnimation - miptex names the FIRST frame, not the one to draw.
	//ent_frame picks the alternate chain
	anim_tex = QTextureAnimation(map, ti->miptex, ent_frame, q_light_time);
	if (anim_tex < 0)
		return;

	tex = &map->textures[anim_tex];
	if (!tex->texels[0] || tex->width <= 0 || tex->height <= 0)
		return;

	//gather the outline. a negative surfedge runs the other way, so its
	//second vertex leads
	for (i = 0; i < f->num_edges; i++)
	{
		e = map->surfedges[f->first_edge + i];
		if (e >= 0)
			wv = &map->vertices[map->edges[e].v[0]];
		else
			wv = &map->vertices[map->edges[-e].v[1]];

		//from the world position, before the view moves
		poly[n].s = QVecDot(wv->pt, &ti->vecs[0]) + ti->vecs[3];
		poly[n].t = QVecDot(wv->pt, &ti->vecs[4]) + ti->vecs[7];

		if (offset)
		{
			QVecAdd(wv->pt, offset, shifted);
			QVecSub(shifted, c->origin, rel);
		}
		else
			QVecSub(wv->pt, c->origin, rel);
		poly[n].cam[0] = QVecDot(rel, c->right);
		poly[n].cam[1] = QVecDot(rel, c->up);
		poly[n].cam[2] = QVecDot(rel, c->forward);
		n++;
	}

	count = QDrawClipNear(poly, n, clipped);
	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		inv_z = 1.0 / clipped[i].cam[2];

		//screen y grows down, camera y grows up
		scr[i].x = c->center_x + clipped[i].cam[0] * c->x_scale * inv_z;
		scr[i].y = c->center_y - clipped[i].cam[1] * c->y_scale * inv_z;

		//interpolate s/z and t/z, not s and t, or the texture swims
		scr[i].inv_z    = inv_z;
		scr[i].s_over_z = clipped[i].s * inv_z;
		scr[i].t_over_z = clipped[i].t * inv_z;
	}

	//a face with NO samples is BLACK, not fullbright - R_BuildLightMap clears
	//to zero. NULL lightmap means 255 to every drawer below, so it must not
	//be handed out here
	//
	//turb and sky are EMISSIVE and reach us with light_offset -1 for a
	//different reason, so they have to be told apart HERE rather than by the
	//absence of samples
	if (map->lightdata && !tex->is_turb && !tex->is_sky)
	{
		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;

		//only a face that HAS samples needs room in the lump
		if (f->light_offset >= 0 &&
			(f->light_offset >= map->lightdata_size ||
			 f->light_offset + lm_w * lm_h > map->lightdata_size))
		{
			lm_w = 0;
			lm_h = 0;
		}
		else
			lightmap = QLightFaceMap(map, f, lm_w, lm_h, q_light_time);
	}

	if (tex->is_sky)
		QDrawSkyPolygon(c, scr, count, tex);
	else
	{
		//mip from EYE DISTANCE, not camera-space Z. cam[2] is dot(rel,
		//forward), so a face at a fixed distance sweeps across the mip
		//thresholds purely from turning the view - and every crossing
		//changes the cache key and rebuilds the surface. that is the
		//rotation stutter: the geometry never moved, the mip did
		cull_d[0] = f->center[0] - c->origin[0];
		cull_d[1] = f->center[1] - c->origin[1];
		cull_d[2] = f->center[2] - c->origin[2];

		if (offset)
		{
			cull_d[0] += offset[0];
			cull_d[1] += offset[1];
			cull_d[2] += offset[2];
		}

		near_z = QVecLength(cull_d) - f->radius;
		if (near_z < QNEAR_CLIP)
			near_z = QNEAR_CLIP;

		ratio = near_z / c->x_scale;

		if (ratio < 0.5)
			mip = 0;
		else if (ratio < 1.5)
			mip = 1;
		else if (ratio < 4.0)
			mip = 2;
		else
			mip = 3;

		//D_CacheSurface. turb warps every frame and sky is drawn by direction,
		//so neither caches
		if (!tex->is_turb && !tex->clamp)
			surf = QSurfCacheGet(map, f, face_index, tex, mip,
					lightmap, lm_w, lm_h, &sw, &sh, anim_tex, &surf_rgb);

		//NULL lightmap means fullbright, and by here that is only turb
		QDrawPolygon(c, scr, count, tex, lightmap, lm_w, lm_h,
			f->mins_s, f->mins_t, 255, mip, surf, sw, sh, surf_rgb);
	}

	c->faces_drawn++;
}

U0 QDrawWorld(CQCanvas *c, CQMap *map, CQVisState *vs)
{//faces arrive front to back, so the depth test kills most overdraw
	I64 i;

	for (i = 0; i < vs->face_count; i++)
		QDrawFace(c, map, vs->face_list[i]);
}

U0 QDrawBrushModel(CQCanvas *c, CQMap *map, I64 model_index,
	F64 *origin = NULL, I64 ent_frame = 0)
{//BSP submodel (door, platform, button). not in the PVS, so every face is
 //submitted and the depth buffer sorts it out
 //
 //origin MUST be passed for anything that moves, or the geometry stays where
 //the brush was authored
	CQModel *m;
	I64		 i;

	if (model_index < 0 || model_index >= map->num_models)
		return;

	m = &map->models[model_index];

	for (i = 0; i < m->num_faces; i++)
	{
		if (m->first_face + i < map->num_faces)
			QDrawFace(c, map, m->first_face + i, origin, ent_frame);
	}
}

U0 QDrawFadeScreen(CQCanvas *c)
{//Draw_FadeScreen - dim the frame so a menu reads over it. M_Draw only falls
 //back to conback when the console is actually down
 //
 //a dither, not a blend: palette indices can't be averaged. one pixel in four
 //survives, and the kept column shifts per row so it reads as a screen door
	U8	*row;
	I64	 x;
	I64	 y;
	I64	 t;
	I64	 step;

	//the pattern is defined in 320x200 pixels. an unscaled one-in-four mask on
	//a wider canvas stops reading as a screen door and turns into a flat wash
	//with moire, so the cell scales to keep the same apparent size
	step = c->width / 320;
	if (step < 1)
		step = 1;

	for (y = 0; y < c->height; y++)
	{
		row = c->pixels + y * c->width;

		//alternates the kept column between 0 and 2
		t = ((y / step) & 1) << 1;

		for (x = 0; x < c->width; x++)
		{
			if (((x / step) & 3) != t)
			{
				row[x] = 0;
				QRGBDrop(c, x, y);
			}
		}
	}
}

U32 QFogApply(U32 rgb, I64 izi)
{//blend toward the fog colour by depth. izi is 1/z in QDEPTH_SCALE fixed
 //point, and 0 means sky
	I64 a;
	I64 idx;
	I64 sr;
	I64 sg;
	I64 sb;

	if (izi <= 0)
		a = q_fog_sky_alpha;
	else
	{
		idx = ToI64(ToF64(izi) / QDEPTH_SCALE *
				ToF64(QFOG_LUT - 1) / QFOG_IZ_MAX);
		if (idx > QFOG_LUT - 1)
			return rgb;			//nearer than the table starts, no fog
		if (idx < 0)
			idx = 0;
		a = q_fog_lut[idx];
	}

	if (a <= 0)
		return rgb;

	sr = (rgb >> 16) & 255;
	sg = (rgb >> 8) & 255;
	sb = rgb & 255;

	sr = sr + ((q_fog_r - sr) * a) / 255;
	sg = sg + ((q_fog_g - sg) * a) / 255;
	sb = sb + ((q_fog_b - sb) * a) / 255;

	return (ClampI64(sr, 0, 255) << 16) | (ClampI64(sg, 0, 255) << 8) |
			ClampI64(sb, 0, 255);
}

U0 QDrawBlitFit(CQCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w,
	I64 dst_h)
{//stretch the indexed canvas into any destination rect
 //
 //integer-only scaling made higher render resolutions display SMALLER. a
 //fixed-point source step lets any render size fill the same rectangle
	U8	*src;
	U32	*dst;
	U32	*crow;
	I32	*zrow;
	U32	 col;
	Bool fog = ToBool(q_opt_fog && q_fog_on);
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 warp;
	I64	 sx;
	I64	 pitch = dc->width_internal;

	if (dst_w < 1 || dst_h < 1)
		return;

	//16.16 fixed point. parenthesised - shifts bind tighter than divide in
	//this compiler and it reorders these silently
	sx_step = (c->width << 16) / dst_w;
	sy_step = (c->height << 16) / dst_h;

	for (y = 0; y < dst_h; y++)
	{
		py = dst_y + y;
		if (py < 0 || py >= dc->height)
			goto qbf_next_row;

		sy = (y * sy_step) >> 16;
		if (sy >= c->height)
			sy = c->height - 1;

		src = c->pixels + sy * c->width;
		crow = NULL;
		if (c->rgb && q_rgb_active)
			crow = c->rgb + sy * c->width;
		zrow = NULL;
		if (fog)
			zrow = c->depth + sy * c->width;
		dst = dc->body + py * pitch;

		//underwater warp - shear each row along a travelling sine. a view
		//space effect on the finished image, one sine per row at blit time
		if (q_warp_amount > 0.0)
		{
			warp = ToI64(Sin(ToF64(sy) * 0.06 + q_warp_time * 3.0) *
				q_warp_amount);
			sxf = warp << 16;
		}
		else
			sxf = 0;

		for (x = 0; x < dst_w; x++)
		{
			//clamp, not wrap - wrapping tears the image across the screen
			sx = sxf >> 16;
			if (sx < 0)
				sx = 0;
			if (sx >= c->width)
				sx = c->width - 1;

			if (dst_x + x >= 0 && dst_x + x < dc->width)
			{
				if (crow && (crow[sx] & QRGB_SET))
				{
					//the overlay holds raw colour, so it takes the tint and
					//gamma the palette path already carries
					if (qpal_post_identity)
						col = crow[sx] & 0x00FFFFFF;
					else
						col = QPalPostRGB(crow[sx] & 0x00FFFFFF);
				}
				else
					col = qpal_argb[src[sx]];

				if (fog)
					col = QFogApply(col, zrow[sx]);

				dst[dst_x + x] = col;
			}

			sxf += sx_step;
		}

qbf_next_row:
	}
}

U0 QDrawBlit(CQCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 scale)
{//indexed -> truecolor CDC at an integer magnification, one palette lookup
 //per source pixel
	U8	*src;
	U32	*dst;
	U32	*crow;
	I32	*zrow;
	U32	 color;
	Bool fog = ToBool(q_opt_fog && q_fog_on);
	I64	 x;
	I64	 y;
	I64	 sx;
	I64	 sy;
	I64	 px;
	I64	 py;
	I64	 pitch = dc->width_internal;

	for (y = 0; y < c->height; y++)
	{
		src = c->pixels + y * c->width;
		crow = NULL;
		if (c->rgb && q_rgb_active)
			crow = c->rgb + y * c->width;
		zrow = NULL;
		if (fog)
			zrow = c->depth + y * c->width;

		for (sy = 0; sy < scale; sy++)
		{
			py = dst_y + y * scale + sy;
			if (py < 0 || py >= dc->height)
				break;

			dst = dc->body + py * pitch;

			for (x = 0; x < c->width; x++)
			{
				if (crow && (crow[x] & QRGB_SET))
				{
					color = crow[x] & 0x00FFFFFF;
					if (!qpal_post_identity)
						color = QPalPostRGB(color);
				}
				else
					color = qpal_argb[src[x]];

				if (fog)
					color = QFogApply(color, zrow[x]);

				px = dst_x + x * scale;

				for (sx = 0; sx < scale; sx++)
				{
					if (px + sx >= 0 && px + sx < dc->width)
						dst[px + sx] = color;
				}
			}
		}
	}
}
