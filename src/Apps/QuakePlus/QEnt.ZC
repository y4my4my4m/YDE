// QEnt.ZC - ED_LoadFromFile, entity lump parsing and static spawning
//
// the lump is brace-delimited quoted key/value text sliced out of the map
// buffer, not NUL terminated - every scan is bounded by an end pointer
//
//   brush entities  "model" "*N", index into the bsp's model list
//   point entities  origin only, model normally comes from progs precache
//
// NOTE: no QuakeC VM yet, so point entities get their model from the table
// below and everything spawns in its rest pose

#define QENT_MAX	1024

class CQEntity
{
	U8		 classname[64];
	U8		 model_name[64];	//raw "model" value, "*N" for brush models
	F64		 origin[3];
	F64		 angles[3];
	I64		 brush_model;		//BSP model index, or -1
	CQMdl	*mdl;				//resolved alias model, or NULL
	I64		 frame;
};

CQEntity	*q_entities		= NULL;
I64			 q_num_entities	= 0;

U8 *QEntModelForClass(U8 *classname)
{//classname to model path, fallback for the missing precache
 //
 //HACK: a comparison chain, not a NUL-separated table - adjacent-literal
 //concatenation is length-based and truncates at the first embedded \0, so
 //the table collapsed to one entry and the walk ran off into the heap
	if (!StrCompare(classname, "item_artifact_invulnerability"))
		return "progs/invulner.mdl";
	if (!StrCompare(classname, "item_artifact_super_damage"))
		return "progs/quaddama.mdl";
	if (!StrCompare(classname, "item_artifact_envirosuit"))
		return "progs/suit.mdl";
	if (!StrCompare(classname, "item_artifact_invisibility"))
		return "progs/invisibl.mdl";

	if (!StrCompare(classname, "item_armor1"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armor2"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armorInv"))	return "progs/armor.mdl";
	if (!StrCompare(classname, "item_key1"))		return "progs/w_s_key.mdl";
	if (!StrCompare(classname, "item_key2"))		return "progs/w_g_key.mdl";
	if (!StrCompare(classname, "item_backpack"))	return "progs/backpack.mdl";

	if (!StrCompare(classname, "weapon_supershotgun"))
		return "progs/g_shot.mdl";
	if (!StrCompare(classname, "weapon_nailgun"))	return "progs/g_nail.mdl";
	if (!StrCompare(classname, "weapon_supernailgun"))
		return "progs/g_nail2.mdl";
	if (!StrCompare(classname, "weapon_grenadelauncher"))
		return "progs/g_rock.mdl";
	if (!StrCompare(classname, "weapon_rocketlauncher"))
		return "progs/g_rock2.mdl";
	if (!StrCompare(classname, "weapon_lightning"))	return "progs/g_light.mdl";

	if (!StrCompare(classname, "monster_army"))		return "progs/soldier.mdl";
	if (!StrCompare(classname, "monster_dog"))		return "progs/dog.mdl";
	if (!StrCompare(classname, "monster_ogre"))		return "progs/ogre.mdl";
	if (!StrCompare(classname, "monster_knight"))	return "progs/knight.mdl";
	if (!StrCompare(classname, "monster_hell_knight"))
		return "progs/hknight.mdl";
	if (!StrCompare(classname, "monster_zombie"))	return "progs/zombie.mdl";
	if (!StrCompare(classname, "monster_wizard"))	return "progs/wizard.mdl";
	if (!StrCompare(classname, "monster_demon1"))	return "progs/demon.mdl";
	if (!StrCompare(classname, "monster_shambler"))	return "progs/shambler.mdl";
	if (!StrCompare(classname, "monster_enforcer"))	return "progs/enforcer.mdl";
	if (!StrCompare(classname, "monster_fish"))		return "progs/fish.mdl";
	if (!StrCompare(classname, "monster_tarbaby"))	return "progs/tarbaby.mdl";
	if (!StrCompare(classname, "monster_boss"))		return "progs/boss.mdl";

	return NULL;
}

U0 QEntFree()
{
	I64 i;

	if (!q_entities)
		return;

	for (i = 0; i < q_num_entities; i++)
	{
		if (q_entities[i].mdl)
		{
			//owned by the model cache
			q_entities[i].mdl = NULL;
		}
	}

	Free(q_entities);
	q_entities     = NULL;
	q_num_entities = 0;
}

I64 QEntParse(CQMap *map)
{//ED_LoadFromFile - returns the count
	CQEntity	*e;
	U8			*p;
	U8			*end;
	U8			 key[64];
	U8			 val[160];
	I64			 k;
	Bool		 in_block = FALSE;

	QEntFree;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	q_entities     = CAlloc(QENT_MAX * sizeof(CQEntity));
	q_num_entities = 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && q_num_entities < QENT_MAX)
	{
		if (*p == '{')
		{
			e = &q_entities[q_num_entities];
			e->classname[0]  = 0;
			e->model_name[0] = 0;
			e->brush_model   = -1;
			e->mdl           = NULL;
			e->frame         = 0;
			QVecSet(e->origin, 0.0, 0.0, 0.0);
			QVecSet(e->angles, 0.0, 0.0, 0.0);
			in_block = TRUE;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 63)
				{
					key[k] = *p;
					k++;
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 159)
				{
					val[k] = *p;
					k++;
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					QStrCopy(e->classname, val, 64);
				else if (!StrCompare(key, "model"))
					QStrCopy(e->model_name, val, 64);
				else if (!StrCompare(key, "origin"))
					QParseVec(val, e->origin);
				else if (!StrCompare(key, "angle"))
					e->angles[1] = QAtoF(val);
				else if (!StrCompare(key, "angles"))
					QParseVec(val, e->angles);
			}

			if (in_block && e->classname[0])
			{
				//"*N" is an inline bsp model
				if (e->model_name[0] == '*')
					e->brush_model = ToI64(QAtoF(e->model_name + 1));

				q_num_entities++;
			}

			in_block = FALSE;
		}

		if (p < end)
			p++;
	}

	return q_num_entities;
}

I64 QEntLoadModels()
{//resolve alias models for point entities
 //FIXME: no sharing, each entity gets its own copy - e1m1's 34 soldiers are
 //the worst case at a few hundred KB
	CQEntity	*e;
	U8			*path;
	I64			 i;
	I64			 loaded = 0;

	for (i = 0; i < q_num_entities; i++)
	{
		e = &q_entities[i];

		if (e->brush_model < 0 && !e->mdl)
		{
			path = QEntModelForClass(e->classname);

			//.mdl only, some items are brush models in their own .bsp
			if (path && StrLen(path) > 4 &&
				!StrICompare(path + StrLen(path) - 4, ".mdl"))
			{
				e->mdl = QMdlCacheGet(path);
				if (e->mdl)
					loaded++;
			}
		}
	}

	return loaded;
}

Bool QEntFindPlayerStart(CQMap *map, F64 *origin, F64 *angles)
{//info_player_start
	I64 i;

	QVecSet(origin, 0.0, 0.0, 0.0);
	QVecSet(angles, 0.0, 0.0, 0.0);

	for (i = 0; i < q_num_entities; i++)
	{
		if (!StrCompare(q_entities[i].classname, "info_player_start"))
		{
			//this is the origin, not the eye - the caller adds view height
			QVecCopy(q_entities[i].origin, origin);
			QVecCopy(q_entities[i].angles, angles);
			return TRUE;
		}
	}

	return FALSE;
}
