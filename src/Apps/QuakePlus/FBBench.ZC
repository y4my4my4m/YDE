// FBBench.ZC - linear framebuffer write bandwidth against ordinary RAM.
//
// Run from the ZealOS prompt:  #include "::/Apps/QuakePlus/FBBench"
//
// A framebuffer mapped uncacheable writes an order of magnitude slower than
// RAM and the stores do not coalesce. ZealOS sets no MTRR or PAT, so the LFB
// takes whatever cache type the firmware left.
//
// Writes garbage to the screen for the duration. The window manager repaints.

U0 FBBench(I64 mb = 8)
{
	U8	*ram;
	U8	*fb		= sys_framebuffer_addr;
	I64	 fb_max = sys_framebuffer_width * sys_framebuffer_height * 4;
	I64	 n		= mb * 1024 * 1024;
	I64	 reps	= 4;
	I64	 i;
	F64	 t0;
	F64	 t_ram;
	F64	 t_fb;

	//never write past the mapped framebuffer
	if (n > fb_max)
		n = fb_max;

	ram = MAlloc(n);
	if (!ram)
	{
		"no memory for %d bytes\n", n;
		return;
	}

	//touch it first so the RAM figure is not a page-fault measurement
	MemSet(ram, 0, n);

	t0 = tS;
	for (i = 0; i < reps; i++)
		MemSet(ram, i, n);
	t_ram = tS - t0;

	t0 = tS;
	for (i = 0; i < reps; i++)
		MemSet(fb, 0, n);
	t_fb = tS - t0;

	Free(ram);

	"\n$$LTBLUE$$FBBench$$FG$$  %d MB x %d\n", n / 1048576, reps;
	"  fb   %8.1f MB/s   (%6.1f ms)\n",
		reps * n / t_fb  / 1048576.0, t_fb  * 1000.0;
	"  ram  %8.1f MB/s   (%6.1f ms)\n",
		reps * n / t_ram / 1048576.0, t_ram * 1000.0;
	"  ratio %7.1fx\n", t_fb / t_ram;

	if (t_fb / t_ram > 5.0)
		"$$RED$$framebuffer is uncached - needs MTRR/PAT write-combining$$FG$$\n";
	else
		"$$GREEN$$framebuffer write speed is not the bottleneck$$FG$$\n";
}

FBBench;
