// D1Lvl.ZC - dungeon data: pieces, micros, solidity, town assembly
//
// dPiece[x][y]: 1-based level piece id, 0 = empty (gendung.cpp).
// MIN file: per piece, `blocks` U16 micro entries, 2 per 32px row, listed
// top row first. entry: low 12 bits = 1-based frame in the level CEL,
// bits 12-14 = tile encoding type, 0 frame = nothing.
// stored here bottom row first via the gendung.cpp SetDungeonMicros
// reversal: mt[i] = min[(i & 1) + blocks - 2 - (i & 0xE)].
//
// TIL file: 4 U16 piece ids per square (2x2 dPiece cells).
// SOL file: 1 byte flags per piece. bit 0 solid, bit 1 blocks light,
// bit 2 blocks missiles.
//
// town (town.cpp T_Pass3): 4 pre-lit sector DUNs pasted into a 112x112
// dPiece grid. sector DUN: U16 w, U16 h, then w*h U16 1-based TIL squares.

#define D1_MAXDUN	112
#define D1_MT_MAX	16

U16	 d1_dpiece[D1_MAXDUN * D1_MAXDUN];	//[x + y * D1_MAXDUN]
U8	*d1_lvl_cel   = NULL;				//level CEL, resident
U16	*d1_piece_mt  = NULL;				//[piece * D1_MT_MAX + i], bottom first
U8	*d1_sol       = NULL;
I64	 d1_npieces   = 0;
I64	 d1_blocks    = 16;					//micro entries per piece this level
Bool d1_lvl_ready = FALSE;

U16 D1Piece(I64 x, I64 y)
{
	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return 0;
	return d1_dpiece[x + y * D1_MAXDUN];
}

Bool D1Walkable(I64 x, I64 y)
{
	I64 p = D1Piece(x, y);

	if (!p)
		return FALSE;
	if (p > d1_npieces)
		return FALSE;
	return (d1_sol[p - 1] & 1) == 0;
}

U0 D1LvlFree()
{
	d1_lvl_ready = FALSE;
	if (d1_lvl_cel)
	{
		Free(d1_lvl_cel);
		d1_lvl_cel = NULL;
	}
	if (d1_piece_mt)
	{
		Free(d1_piece_mt);
		d1_piece_mt = NULL;
	}
	if (d1_sol)
	{
		Free(d1_sol);
		d1_sol = NULL;
	}
	d1_npieces = 0;
}

Bool D1LvlLoadGfx(U8 *cel_name, U8 *min_name, U8 *sol_name, I64 blocks)
{//level sprite sheet + micro table + solidity
	I64	 size = 0;
	U8	*min;
	I64	 i;
	I64	 p;
	U16	*mt;

	D1LvlFree;
	d1_blocks = blocks;

	d1_lvl_cel = D1MpqRead(cel_name, &size);
	if (!d1_lvl_cel)
	{
		"D1Lvl: no %s\n", cel_name;
		return FALSE;
	}

	min = D1MpqRead(min_name, &size);
	if (!min)
	{
		"D1Lvl: no %s\n", min_name;
		return FALSE;
	}
	d1_npieces  = size / (blocks * 2);
	d1_piece_mt = CAlloc(d1_npieces * D1_MT_MAX * 2);
	for (p = 0; p < d1_npieces; p++)
	{
		mt = d1_piece_mt + p * D1_MT_MAX;
		for (i = 0; i < blocks; i++)
			mt[i] = D1RdU16(min + (p * blocks + ((i & 1) + blocks - 2 - (i & 0xE))) * 2);
	}
	Free(min);

	d1_sol = D1MpqRead(sol_name, &size);
	if (!d1_sol)
	{
		"D1Lvl: no %s\n", sol_name;
		return FALSE;
	}
	if (size < d1_npieces)
		"D1Lvl: %s short: %d < %d\n", sol_name, size, d1_npieces;

	return TRUE;
}

U0 D1FillSector(U8 *til, I64 til_size, U8 *sec, I64 sec_size, I64 xi, I64 yi)
{//town.cpp T_FillSector: sector DUN squares -> 2x2 dPiece cells
	I64 w  = D1RdU16(sec);
	I64 h  = D1RdU16(sec + 2);
	I64 ii = 4;
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 t;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	yy = yi;
	for (j = 0; j < h; j++)
	{
		xx = xi;
		for (i = 0; i < w; i++)
		{
			v1 = 0;
			v2 = 0;
			v3 = 0;
			v4 = 0;
			if (ii + 1 < sec_size)
			{
				t = D1RdU16(sec + ii);
				if (t && (t - 1) * 8 + 7 < til_size)
				{
					v1 = D1RdU16(til + (t - 1) * 8)     + 1;
					v2 = D1RdU16(til + (t - 1) * 8 + 2) + 1;
					v3 = D1RdU16(til + (t - 1) * 8 + 4) + 1;
					v4 = D1RdU16(til + (t - 1) * 8 + 6) + 1;
				}
			}
			if (xx + 1 < D1_MAXDUN && yy + 1 < D1_MAXDUN)
			{
				d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
				d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
				d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
				d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			}
			xx += 2;
			ii += 2;
		}
		yy += 2;
	}
}

Bool D1TownLoad()
{//T_Pass3: four sectors into the fixed spots
	I64	 til_size = 0;
	I64	 sec_size = 0;
	U8	*til;
	U8	*sec;
	I64	 i;

	if (!D1LvlLoadGfx("Levels\\TownData\\Town.CEL",
					  "Levels\\TownData\\Town.MIN",
					  "Levels\\TownData\\Town.SOL", 16))
		return FALSE;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dpiece[i] = 0;

	til = D1MpqRead("Levels\\TownData\\Town.TIL", &til_size);
	if (!til)
	{
		"D1Lvl: no Town.TIL\n";
		return FALSE;
	}

	sec = D1MpqRead("Levels\\TownData\\Sector1s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(til, til_size, sec, sec_size, 46, 46);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector2s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(til, til_size, sec, sec_size, 46, 0);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector3s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(til, til_size, sec, sec_size, 0, 46);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector4s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(til, til_size, sec, sec_size, 0, 0);
		Free(sec);
	}
	Free(til);

	if (!D1PalLoad("Levels\\TownData\\Town.pal"))
		return FALSE;

	d1_lvl_ready = TRUE;
	return TRUE;
}
