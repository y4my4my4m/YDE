// D1Lvl.ZC - dungeon data: pieces, micros, solidity, town assembly
//
// dPiece[x][y]: 1-based level piece id, 0 = empty (gendung.cpp).
// MIN file: per piece, `blocks` U16 micro entries, 2 per 32px row, listed
// top row first. entry: low 12 bits = 1-based frame in the level CEL,
// bits 12-14 = tile encoding type, 0 frame = nothing.
// stored here bottom row first via the gendung.cpp SetDungeonMicros
// reversal: mt[i] = min[(i & 1) + blocks - 2 - (i & 0xE)].
//
// TIL file: 4 U16 piece ids per square (2x2 dPiece cells).
// SOL file: 1 byte flags per piece. bit 0 solid, bit 1 blocks light,
// bit 2 blocks missiles, bit 3 transparent (nTransTable).
//
// town (town.cpp T_Pass3): 4 pre-lit sector DUNs pasted into a 112x112
// dPiece grid. sector DUN: U16 w, U16 h, then w*h U16 1-based TIL squares.

#define D1_MAXDUN	112
#define D1_MT_MAX	16

U16	 d1_dpiece[D1_MAXDUN * D1_MAXDUN];	//[x + y * D1_MAXDUN]
U8	*d1_lvl_cel   = NULL;				//level CEL, resident
U16	*d1_piece_mt  = NULL;				//[piece * D1_MT_MAX + i], bottom first
U8	*d1_sol       = NULL;
U8	*d1_til       = NULL;				//TIL megatiles, kept for drlg Pass3
I64	 d1_til_size  = 0;
I64	 d1_npieces   = 0;
I64	 d1_blocks    = 16;					//micro entries per piece this level
I64	 d1_currlevel = 0;					//0 = town, 1-4 = cathedral
Bool d1_lvl_ready = FALSE;

//occupancy: 1-based index into the monster / towner / object lists, 0 = free
I32	 d1_dmon[D1_MAXDUN * D1_MAXDUN];
U8	 d1_dtwn[D1_MAXDUN * D1_MAXDUN];
U8	 d1_dobj[D1_MAXDUN * D1_MAXDUN];	//obj idx+1 (D1Obj fills; Item needs it early)

//tile step per facing: 0 S, 1 SW, 2 W, 3 NW, 4 N, 5 NE, 6 E, 7 SE.
//derives from the screen transform sxd = 32*(dx-dy), syd = 16*(dx+dy).
I64 d1_dir_dx[8] = { 1,  0, -1, -1, -1,  0,  1,  1};
I64 d1_dir_dy[8] = { 1,  1,  1,  0, -1, -1, -1,  0};

//player combat state, this early so items/objects/monsters can reach it
I64	 d1_plr_hp    = 70 << 6;		//64ths, as the original tracks life
I64	 d1_plr_maxhp = 70 << 6;
I64	 d1_plr_lvl   = 1;
I64	 d1_plr_str   = 30;				//starting warrior
I64	 d1_plr_dex   = 20;
Bool d1_plr_dead  = FALSE;
I64	 d1_plr_hitflash = 0;			//legacy; unused (no red border)
I64	 d1_plr_hitpend  = 0;			//StartPlrHit pending damage (Mon -> Play)
I64	 d1_plr_tile_x = 75;
I64	 d1_plr_tile_y = 68;
I64	 d1_plr_exp   = 0;
I64	 d1_plr_mana  = 10 << 6;
I64	 d1_plr_maxmana = 10 << 6;

U8	 d1_dspecial[D1_MAXDUN * D1_MAXDUN];	//arch / door special frame, 0 = none
U8	*d1_special_cel = NULL;			//L1S / L2S / TownS.CEL

//gendung dTransVal / TransList: room-region ids so wall micros and L1S
//arches dither only when the player shares that region (PlrDoTrans), not
//every cell with x+y > player.
U8	 d1_dtrans[D1_MAXDUN * D1_MAXDUN];
Bool d1_translist[256];
I64	 d1_transval = 1;

U0 D1GridsClear()
{
	I64 i;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
	{
		d1_dmon[i] = 0;
		d1_dtwn[i] = 0;
		d1_dobj[i] = 0;
		d1_dspecial[i] = 0;
	}
}

U0 D1DrlgInitTrans()
{//DRLG_InitTrans
	I64 i;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dtrans[i] = 0;
	for (i = 0; i < 256; i++)
		d1_translist[i] = FALSE;
	d1_transval = 1;
}

U0 D1DrlgCopyTrans(I64 sx, I64 sy, I64 dx, I64 dy)
{
	if (sx < 0 || sy < 0 || dx < 0 || dy < 0)
		return;
	if (sx >= D1_MAXDUN || sy >= D1_MAXDUN || dx >= D1_MAXDUN || dy >= D1_MAXDUN)
		return;
	d1_dtrans[dx + dy * D1_MAXDUN] = d1_dtrans[sx + sy * D1_MAXDUN];
}

U0 D1SpecialFree()
{
	if (d1_special_cel)
	{
		Free(d1_special_cel);
		d1_special_cel = NULL;
	}
}

Bool D1SpecialLoad(U8 *path)
{//pSpecialCels for this level type
	I64 size = 0;

	D1SpecialFree;
	d1_special_cel = D1MpqRead(path, &size);
	if (!d1_special_cel)
	{
		"D1Lvl: no %s\n", path;
		return FALSE;
	}
	return TRUE;
}

U0 D1SpecialSet(I64 x, I64 y, I64 frame)
{//1-based Special.CEL frame, 0 clears
	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return;
	d1_dspecial[x + y * D1_MAXDUN] = frame;
}

U16 D1Piece(I64 x, I64 y)
{
	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return 0;
	return d1_dpiece[x + y * D1_MAXDUN];
}

U0 D1SpecialL1Fill()
{//gendung.cpp InitDungeonPieces / objects.cpp ObjL1Special
	I64 x;
	I64 y;
	I64 p;
	I64 pc;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			p  = D1Piece(x, y);
			pc = 0;
			if (p == 11 || p == 70 || p == 320 || p == 210 ||
				p == 340 || p == 417)
				pc = 1;
			else if (p == 10 || p == 248 || p == 324 || p == 343 ||
				p == 330 || p == 420)
				pc = 2;
			else if (p == 252)
				pc = 3;
			else if (p == 254)
				pc = 4;
			else if (p == 258)
				pc = 5;
			else if (p == 266)
				pc = 6;
			d1_dspecial[x + y * D1_MAXDUN] = pc;
		}
}

U0 D1SpecialL2Fill()
{//objects.cpp ObjL2Special over the whole map
	I64 x;
	I64 y;
	I64 p;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
			d1_dspecial[x + y * D1_MAXDUN] = 0;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			p = D1Piece(x, y);
			if (p == 540 || p == 177 || p == 550)
				d1_dspecial[x + y * D1_MAXDUN] = 5;
			if (p == 541 || p == 552)
				d1_dspecial[x + y * D1_MAXDUN] = 6;
		}
	for (y = 0; y < D1_MAXDUN - 2; y++)
		for (x = 0; x < D1_MAXDUN - 2; x++)
		{
			p = D1Piece(x, y);
			if (p == 131)
			{
				d1_dspecial[x + (y + 1) * D1_MAXDUN] = 2;
				d1_dspecial[x + (y + 2) * D1_MAXDUN] = 1;
			}
			if (p == 134 || p == 138)
			{
				d1_dspecial[(x + 1) + y * D1_MAXDUN] = 3;
				d1_dspecial[(x + 2) + y * D1_MAXDUN] = 4;
			}
		}
}

Bool D1Walkable(I64 x, I64 y)
{//terrain only
	I64 p = D1Piece(x, y);

	if (!p)
		return FALSE;
	if (p > d1_npieces)
		return FALSE;
	return (d1_sol[p - 1] & 1) == 0;
}

U0 D1PlrDoTrans(I64 x, I64 y)
{//player.cpp PlrDoTrans: mark TransList for regions touching the player.
 //cathedral/catacombs (1..8) use the 3x3 walkable set; other dungeon
 //types force TransList[1] like retail's non-cathedral path.
	I64 i;
	I64 j;
	I64 tv;

	for (i = 0; i < 256; i++)
		d1_translist[i] = FALSE;
	if (d1_currlevel == 0)
		return;
	if (d1_currlevel >= 1 && d1_currlevel <= 8)
	{
		for (i = y - 1; i <= y + 1; i++)
		{
			for (j = x - 1; j <= x + 1; j++)
			{
				if (j >= 0 && j < D1_MAXDUN && i >= 0 && i < D1_MAXDUN &&
					D1Walkable(j, i))
				{
					tv = d1_dtrans[j + i * D1_MAXDUN];
					if (tv)
						d1_translist[tv] = TRUE;
				}
			}
		}
	}
	else
		d1_translist[1] = TRUE;
}

Bool D1CelTransAt(I64 x, I64 y)
{//TransList[dTransVal]: specials / doors use this alone
	I64 tv;

	if (x < 0 || y < 0 || x >= D1_MAXDUN || y >= D1_MAXDUN)
		return FALSE;
	tv = d1_dtrans[x + y * D1_MAXDUN];
	if (!tv)
		return FALSE;
	return d1_translist[tv];
}

Bool D1WallTransAt(I64 x, I64 y)
{//nTransTable[piece] & TransList[dTransVal]
	I64 p;

	if (!D1CelTransAt(x, y))
		return FALSE;
	p = D1Piece(x, y);
	if (!p || p > d1_npieces || !d1_sol)
		return FALSE;
	return ToBool(d1_sol[p - 1] & 8);
}

Bool D1WalkableM(I64 x, I64 y)
{//terrain + actors; what movement and pathing use
	if (!D1Walkable(x, y))
		return FALSE;
	if (d1_dmon[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dtwn[x + y * D1_MAXDUN])
		return FALSE;
	return TRUE;
}

U0 D1LvlFree()
{
	d1_lvl_ready = FALSE;
	D1SpecialFree;
	if (d1_lvl_cel)
	{
		Free(d1_lvl_cel);
		d1_lvl_cel = NULL;
	}
	if (d1_piece_mt)
	{
		Free(d1_piece_mt);
		d1_piece_mt = NULL;
	}
	if (d1_sol)
	{
		Free(d1_sol);
		d1_sol = NULL;
	}
	if (d1_til)
	{
		Free(d1_til);
		d1_til = NULL;
	}
	d1_til_size = 0;
	d1_npieces  = 0;
}

Bool D1LvlLoadGfx(U8 *cel_name, U8 *min_name, U8 *sol_name, U8 *til_name,
	I64 blocks)
{//level sprite sheet + micro table + solidity + megatiles
	I64	 size = 0;
	U8	*min;
	I64	 i;
	I64	 p;
	U16	*mt;

	D1LvlFree;
	d1_blocks = blocks;

	d1_lvl_cel = D1MpqRead(cel_name, &size);
	if (!d1_lvl_cel)
	{
		"D1Lvl: no %s\n", cel_name;
		return FALSE;
	}

	min = D1MpqRead(min_name, &size);
	if (!min)
	{
		"D1Lvl: no %s\n", min_name;
		return FALSE;
	}
	d1_npieces  = size / (blocks * 2);
	d1_piece_mt = CAlloc(d1_npieces * D1_MT_MAX * 2);
	for (p = 0; p < d1_npieces; p++)
	{
		mt = d1_piece_mt + p * D1_MT_MAX;
		for (i = 0; i < blocks; i++)
			mt[i] = D1RdU16(min + (p * blocks + ((i & 1) + blocks - 2 - (i & 0xE))) * 2);
	}
	Free(min);

	d1_sol = D1MpqRead(sol_name, &size);
	if (!d1_sol)
	{
		"D1Lvl: no %s\n", sol_name;
		return FALSE;
	}
	if (size < d1_npieces)
		"D1Lvl: %s short: %d < %d\n", sol_name, size, d1_npieces;

	d1_til = D1MpqRead(til_name, &d1_til_size);
	if (!d1_til)
	{
		"D1Lvl: no %s\n", til_name;
		return FALSE;
	}

	return TRUE;
}

U0 D1FillSector(U8 *til, I64 til_size, U8 *sec, I64 sec_size, I64 xi, I64 yi)
{//town.cpp T_FillSector: sector DUN squares -> 2x2 dPiece cells
	I64 w  = D1RdU16(sec);
	I64 h  = D1RdU16(sec + 2);
	I64 ii = 4;
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 t;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	yy = yi;
	for (j = 0; j < h; j++)
	{
		xx = xi;
		for (i = 0; i < w; i++)
		{
			v1 = 0;
			v2 = 0;
			v3 = 0;
			v4 = 0;
			if (ii + 1 < sec_size)
			{
				t = D1RdU16(sec + ii);
				if (t && (t - 1) * 8 + 7 < til_size)
				{
					v1 = D1RdU16(til + (t - 1) * 8)     + 1;
					v2 = D1RdU16(til + (t - 1) * 8 + 2) + 1;
					v3 = D1RdU16(til + (t - 1) * 8 + 4) + 1;
					v4 = D1RdU16(til + (t - 1) * 8 + 6) + 1;
				}
			}
			if (xx + 1 < D1_MAXDUN && yy + 1 < D1_MAXDUN)
			{
				d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
				d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
				d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
				d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			}
			xx += 2;
			ii += 2;
		}
		yy += 2;
	}
}

Bool D1TownLoad()
{//T_Pass3: four sectors into the fixed spots
	I64	 sec_size = 0;
	U8	*sec;
	I64	 i;

	if (!D1LvlLoadGfx("Levels\\TownData\\Town.CEL",
					  "Levels\\TownData\\Town.MIN",
					  "Levels\\TownData\\Town.SOL",
					  "Levels\\TownData\\Town.TIL", 16))
		return FALSE;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dpiece[i] = 0;
	D1GridsClear;

	sec = D1MpqRead("Levels\\TownData\\Sector1s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(d1_til, d1_til_size, sec, sec_size, 46, 46);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector2s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(d1_til, d1_til_size, sec, sec_size, 46, 0);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector3s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(d1_til, d1_til_size, sec, sec_size, 0, 46);
		Free(sec);
	}
	sec = D1MpqRead("Levels\\TownData\\Sector4s.DUN", &sec_size);
	if (sec)
	{
		D1FillSector(d1_til, d1_til_size, sec, sec_size, 0, 0);
		Free(sec);
	}

	if (!D1PalLoad("Levels\\TownData\\Town.pal"))
		return FALSE;

	if (!D1SpecialLoad("Levels\\TownData\\TownS.CEL"))
		return FALSE;

	d1_currlevel = 0;
	D1DrlgInitTrans;
	d1_lvl_ready = TRUE;
	return TRUE;
}
