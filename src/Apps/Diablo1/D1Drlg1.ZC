U8 D1DunGet(I64 i, I64 j)
{//OOB reads match nothing
	if (i < 0 || i >= D1_DMAX || j < 0 || j >= D1_DMAX)
		return 255;
	return d1_dun[i * D1_DMAX + j];
}

U0 D1DunSet(I64 i, I64 j, I64 v)
{
	if (i >= 0 && i < D1_DMAX && j >= 0 && j < D1_DMAX)
		d1_dun[i * D1_DMAX + j] = v;
}

U8 D1DunFlag(I64 i, I64 j)
{
	if (i < 0 || i >= D1_DMAX || j < 0 || j >= D1_DMAX)
		return 0;
	return d1_dunflag[i * D1_DMAX + j];
}

U0 D1DrlgPlaceDoor(I64 x, I64 y)
{
	I64 df;
	I64 c;

	if (!(D1DunFlag(x, y) & DLRG_PROTECTED))
	{
		df = D1DunFlag(x, y) & 0x7F;
		c  = D1DunGet(x, y);

		if (df == 1)
		{
			if (y != 1 && c == 2)
				D1DunSet(x, y, 26);
			if (y != 1 && c == 7)
				D1DunSet(x, y, 31);
			if (y != 1 && c == 14)
				D1DunSet(x, y, 42);
			if (y != 1 && c == 4)
				D1DunSet(x, y, 43);
			if (x != 1 && c == 1)
				D1DunSet(x, y, 25);
			if (x != 1 && c == 10)
				D1DunSet(x, y, 40);
			if (x != 1 && c == 6)
				D1DunSet(x, y, 30);
		}
		if (df == 2)
		{
			if (x != 1 && c == 1)
				D1DunSet(x, y, 25);
			if (x != 1 && c == 6)
				D1DunSet(x, y, 30);
			if (x != 1 && c == 10)
				D1DunSet(x, y, 40);
			if (x != 1 && c == 4)
				D1DunSet(x, y, 41);
			if (y != 1 && c == 2)
				D1DunSet(x, y, 26);
			if (y != 1 && c == 14)
				D1DunSet(x, y, 42);
			if (y != 1 && c == 7)
				D1DunSet(x, y, 31);
		}
		if (df == 3)
		{
			if (x != 1 && y != 1 && c == 4)
				D1DunSet(x, y, 28);
			if (x != 1 && c == 10)
				D1DunSet(x, y, 40);
			if (y != 1 && c == 14)
				D1DunSet(x, y, 42);
			if (y != 1 && c == 2)
				D1DunSet(x, y, 26);
			if (x != 1 && c == 1)
				D1DunSet(x, y, 25);
			if (y != 1 && c == 7)
				D1DunSet(x, y, 31);
			if (x != 1 && c == 6)
				D1DunSet(x, y, 30);
		}
	}

	d1_dunflag[x * D1_DMAX + y] = DLRG_PROTECTED;
}

U0 D1DrlgL1Shadows()
{
	I64	 x;
	I64	 y;
	I64	 i;
	I64	 s00;
	I64	 s10;
	I64	 s01;
	I64	 s11;
	Bool patflag;
	I64	 tnv3;
	U8	*sp;

	for (y = 1; y < D1_DMAX; y++)
		for (x = 1; x < D1_DMAX; x++)
		{
			s00 = d1_bstypes[D1DunGet(x, y)];
			s10 = d1_bstypes[D1DunGet(x - 1, y)];
			s01 = d1_bstypes[D1DunGet(x, y - 1)];
			s11 = d1_bstypes[D1DunGet(x - 1, y - 1)];

			for (i = 0; i < 37; i++)
			{
				sp = d1_spats + i * 7;
				if (sp[0] == s00)
				{
					patflag = TRUE;
					if (sp[1] && sp[1] != s11)
						patflag = FALSE;
					if (sp[2] && sp[2] != s01)
						patflag = FALSE;
					if (sp[3] && sp[3] != s10)
						patflag = FALSE;
					if (patflag)
					{
						if (sp[4] && !D1DunFlag(x - 1, y - 1))
							D1DunSet(x - 1, y - 1, sp[4]);
						if (sp[5] && !D1DunFlag(x, y - 1))
							D1DunSet(x, y - 1, sp[5]);
						if (sp[6] && !D1DunFlag(x - 1, y))
							D1DunSet(x - 1, y, sp[6]);
					}
				}
			}
		}

	for (y = 1; y < D1_DMAX; y++)
		for (x = 1; x < D1_DMAX; x++)
		{
			if (D1DunGet(x - 1, y) == 139 && !D1DunFlag(x - 1, y))
			{
				tnv3 = 139;
				if (D1DunGet(x, y) == 29)
					tnv3 = 141;
				if (D1DunGet(x, y) == 32)
					tnv3 = 141;
				if (D1DunGet(x, y) == 35)
					tnv3 = 141;
				if (D1DunGet(x, y) == 37)
					tnv3 = 141;
				if (D1DunGet(x, y) == 38)
					tnv3 = 141;
				if (D1DunGet(x, y) == 39)
					tnv3 = 141;
				D1DunSet(x - 1, y, tnv3);
			}
			if (D1DunGet(x - 1, y) == 149 && !D1DunFlag(x - 1, y))
			{
				tnv3 = 149;
				if (D1DunGet(x, y) == 29)
					tnv3 = 153;
				if (D1DunGet(x, y) == 32)
					tnv3 = 153;
				if (D1DunGet(x, y) == 35)
					tnv3 = 153;
				if (D1DunGet(x, y) == 37)
					tnv3 = 153;
				if (D1DunGet(x, y) == 38)
					tnv3 = 153;
				if (D1DunGet(x, y) == 39)
					tnv3 = 153;
				D1DunSet(x - 1, y, tnv3);
			}
			if (D1DunGet(x - 1, y) == 148 && !D1DunFlag(x - 1, y))
			{
				tnv3 = 148;
				if (D1DunGet(x, y) == 29)
					tnv3 = 154;
				if (D1DunGet(x, y) == 32)
					tnv3 = 154;
				if (D1DunGet(x, y) == 35)
					tnv3 = 154;
				if (D1DunGet(x, y) == 37)
					tnv3 = 154;
				if (D1DunGet(x, y) == 38)
					tnv3 = 154;
				if (D1DunGet(x, y) == 39)
					tnv3 = 154;
				D1DunSet(x - 1, y, tnv3);
			}
		}
}

I64 D1DrlgPlaceMiniSet(U8 *miniset, I64 tmin, I64 tmax, I64 cx, I64 cy,
	Bool setview, I64 noquad, I64 ldir)
{//-1 = no spot found. sx/sy of the LAST instance feed setview, as upstream.
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 i;
	I64	 ii;
	I64	 numt;
	I64	 found;
	Bool abort;

	no_warn ldir;

	if (tmax - tmin == 0)
		numt = 1;
	else
		numt = D1Rnd(tmax - tmin) + tmin;

	sx = 0;
	sy = 0;
	for (i = 0; i < numt; i++)
	{
		sx    = D1Rnd(D1_DMAX - sw);
		sy    = D1Rnd(D1_DMAX - sh);
		abort = FALSE;
		found = 0;

		while (!abort)
		{
			abort = TRUE;
			//upstream keeps this no-purpose nudge; it shapes placement
			if (cx != -1 && sx >= cx - sw && sx <= cx + 12)
			{
				sx++;
				abort = FALSE;
			}
			if (cy != -1 && sy >= cy - sh && sy <= cy + 12)
			{
				sy++;
				abort = FALSE;
			}

			switch (noquad)
			{
				case 0:
					if (sx < cx && sy < cy)
						abort = FALSE;
					break;
				case 1:
					if (sx > cx && sy < cy)
						abort = FALSE;
					break;
				case 2:
					if (sx < cx && sy > cy)
						abort = FALSE;
					break;
				case 3:
					if (sx > cx && sy > cy)
						abort = FALSE;
					break;
			}

			ii = 2;
			for (yy = 0; yy < sh && abort; yy++)
				for (xx = 0; xx < sw && abort; xx++)
				{
					if (miniset[ii] && D1DunGet(xx + sx, sy + yy) != miniset[ii])
						abort = FALSE;
					if (D1DunFlag(xx + sx, sy + yy))
						abort = FALSE;
					ii++;
				}

			if (!abort)
			{
				sx++;
				if (sx == D1_DMAX - sw)
				{
					sx = 0;
					sy++;
					if (sy == D1_DMAX - sh)
						sy = 0;
				}
				found++;
				if (found > 4000)
					return -1;
			}
		}

		ii = sw * sh + 2;
		for (yy = 0; yy < sh; yy++)
			for (xx = 0; xx < sw; xx++)
			{
				if (miniset[ii])
					D1DunSet(xx + sx, sy + yy, miniset[ii]);
				ii++;
			}
	}

	if (setview)
	{
		d1_lvl_vx = 2 * sx + 19;
		d1_lvl_vy = 2 * sy + 20;
	}

	if (sx < cx && sy < cy)
		return 0;
	if (sx > cx && sy < cy)
		return 1;
	if (sx < cx && sy > cy)
		return 2;
	return 3;
}

U0 D1DrlgL1Floor()
{
	I64 i;
	I64 j;
	I64 rv;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunFlag(i, j) == 0 && D1DunGet(i, j) == 13)
			{
				rv = D1Rnd(3);
				if (rv == 1)
					D1DunSet(i, j, 162);
				if (rv == 2)
					D1DunSet(i, j, 163);
			}
		}
}

U0 D1DrlgL1Pass3()
{//expand dungeon through the TIL megatiles into dPiece at 16,16
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 lv;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	lv = 22 - 1;
	v1 = D1RdU16(d1_til + lv * 8)     + 1;
	v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
	v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
	v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;

	for (j = 0; j < D1_MAXDUN; j += 2)
		for (i = 0; i < D1_MAXDUN; i += 2)
		{
			d1_dpiece[i     +  j      * D1_MAXDUN] = v1;
			d1_dpiece[i + 1 +  j      * D1_MAXDUN] = v2;
			d1_dpiece[i     + (j + 1) * D1_MAXDUN] = v3;
			d1_dpiece[i + 1 + (j + 1) * D1_MAXDUN] = v4;
		}

	yy = 16;
	for (j = 0; j < D1_DMAX; j++)
	{
		xx = 16;
		for (i = 0; i < D1_DMAX; i++)
		{
			lv = D1DunGet(i, j) - 1;
			if (lv >= 0)
			{
				v1 = D1RdU16(d1_til + lv * 8)     + 1;
				v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
				v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
				v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;
			}
			else
			{
				v1 = 0;
				v2 = 0;
				v3 = 0;
				v4 = 0;
			}
			d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
			d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
			d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
			d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			xx += 2;
		}
		yy += 2;
	}
}

U0 D1InitL5Dungeon()
{
	I64 i;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
	{
		d1_dun[i]     = 0;
		d1_dunflag[i] = 0;
	}
}

U0 D1L5ClearFlags()
{
	I64 i;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
		d1_dunflag[i] &= 0xBF;
}

U0 D1L5drawRoom(I64 x, I64 y, I64 w, I64 h)
{
	I64 i;
	I64 j;

	for (j = 0; j < h; j++)
		for (i = 0; i < w; i++)
			D1DunSet(x + i, y + j, 1);
}

Bool D1L5checkRoom(I64 x, I64 y, I64 width, I64 height)
{
	I64 i;
	I64 j;

	for (j = 0; j < height; j++)
		for (i = 0; i < width; i++)
		{
			if (i + x < 0 || i + x >= D1_DMAX || j + y < 0 || j + y >= D1_DMAX)
				return FALSE;
			if (d1_dun[(i + x) * D1_DMAX + j + y])
				return FALSE;
		}

	return TRUE;
}

U0 D1L5roomGen(I64 x, I64 y, I64 w, I64 h, I64 dir)
{
	I64	 num;
	I64	 dirProb;
	Bool ran;
	Bool ran2;
	Bool vert;
	I64	 width;
	I64	 height;
	I64	 rx;
	I64	 ry;
	I64	 ry2;
	I64	 cw;
	I64	 ch;
	I64	 cx1;
	I64	 cy1;
	I64	 cx2;

	dirProb = D1Rnd(4);

	if (dir == 1)
		vert = ToBool(dirProb != 0);
	else
		vert = ToBool(dirProb == 0);

	if (!vert)
	{//rooms to the left and right
		num = 0;
		ran = FALSE;
		do
		{
			cw  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			ch  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			cy1 = h / 2 + y - ch / 2;
			cx1 = x - cw;
			//upstream swaps args 3 and 4 here; kept
			ran = D1L5checkRoom(cx1 - 1, cy1 - 1, ch + 2, cw + 1);
			num++;
		}
		while (!ran && num < 20);

		if (ran)
			D1L5drawRoom(cx1, cy1, cw, ch);
		cx2  = x + w;
		ran2 = D1L5checkRoom(cx2, cy1 - 1, cw + 1, ch + 2);
		if (ran2)
			D1L5drawRoom(cx2, cy1, cw, ch);
		if (ran)
			D1L5roomGen(cx1, cy1, cw, ch, 1);
		if (ran2)
			D1L5roomGen(cx2, cy1, cw, ch, 1);
	}
	else
	{//rooms above and below
		num = 0;
		ran = FALSE;
		do
		{
			width  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			height = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			rx     = w / 2 + x - width / 2;
			ry     = y - height;
			ran    = D1L5checkRoom(rx - 1, ry - 1, width + 2, height + 1);
			num++;
		}
		while (!ran && num < 20);

		if (ran)
			D1L5drawRoom(rx, ry, width, height);
		ry2  = y + h;
		ran2 = D1L5checkRoom(rx - 1, ry2, width + 2, height + 1);
		if (ran2)
			D1L5drawRoom(rx, ry2, width, height);
		if (ran)
			D1L5roomGen(rx, ry, width, height, 0);
		if (ran2)
			D1L5roomGen(rx, ry2, width, height, 0);
	}
}

U0 D1L5firstRoom()
{
	I64 ys;
	I64 ye;
	I64 y;
	I64 xs;
	I64 xe;
	I64 x;

	if (D1Rnd(2) == 0)
	{
		ys = 1;
		ye = D1_DMAX - 1;

		d1_vr1 = D1Rnd(2);
		d1_vr2 = D1Rnd(2);
		d1_vr3 = D1Rnd(2);

		if (d1_vr1 + d1_vr3 <= 1)
			d1_vr2 = 1;
		if (d1_vr1)
			D1L5drawRoom(15, 1, 10, 10);
		else
			ys = 18;

		if (d1_vr2)
			D1L5drawRoom(15, 15, 10, 10);
		if (d1_vr3)
			D1L5drawRoom(15, 29, 10, 10);
		else
			ye = 22;

		for (y = ys; y < ye; y++)
		{
			D1DunSet(17, y, 1);
			D1DunSet(18, y, 1);
			D1DunSet(19, y, 1);
			D1DunSet(20, y, 1);
			D1DunSet(21, y, 1);
			D1DunSet(22, y, 1);
		}

		if (d1_vr1)
			D1L5roomGen(15, 1, 10, 10, 0);
		if (d1_vr2)
			D1L5roomGen(15, 15, 10, 10, 0);
		if (d1_vr3)
			D1L5roomGen(15, 29, 10, 10, 0);

		d1_hr3 = 0;
		d1_hr2 = 0;
		d1_hr1 = 0;
	}
	else
	{
		xs = 1;
		xe = D1_DMAX - 1;

		d1_hr1 = D1Rnd(2);
		d1_hr2 = D1Rnd(2);
		d1_hr3 = D1Rnd(2);

		if (d1_hr1 + d1_hr3 <= 1)
			d1_hr2 = 1;
		if (d1_hr1)
			D1L5drawRoom(1, 15, 10, 10);
		else
			xs = 18;

		if (d1_hr2)
			D1L5drawRoom(15, 15, 10, 10);
		if (d1_hr3)
			D1L5drawRoom(29, 15, 10, 10);
		else
			xe = 22;

		for (x = xs; x < xe; x++)
		{
			D1DunSet(x, 17, 1);
			D1DunSet(x, 18, 1);
			D1DunSet(x, 19, 1);
			D1DunSet(x, 20, 1);
			D1DunSet(x, 21, 1);
			D1DunSet(x, 22, 1);
		}

		if (d1_hr1)
			D1L5roomGen(1, 15, 10, 10, 1);
		if (d1_hr2)
			D1L5roomGen(15, 15, 10, 10, 1);
		if (d1_hr3)
			D1L5roomGen(29, 15, 10, 10, 1);

		d1_vr3 = 0;
		d1_vr2 = 0;
		d1_vr1 = 0;
	}
}

I64 D1L5GetArea()
{
	I64 i;
	I64 rv = 0;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
		if (d1_dun[i] == 1)
			rv++;

	return rv;
}

U0 D1L5makeDungeon()
{
	I64 i;
	I64 j;
	I64 v;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			v = d1_dun[i * D1_DMAX + j];
			d1_l5dun[(i * 2)     * 80 + j * 2]     = v;
			d1_l5dun[(i * 2)     * 80 + j * 2 + 1] = v;
			d1_l5dun[(i * 2 + 1) * 80 + j * 2]     = v;
			d1_l5dun[(i * 2 + 1) * 80 + j * 2 + 1] = v;
		}
}

U0 D1L5makeDmt()
{
	I64 i;
	I64 j;
	I64 idx;
	I64 val;
	I64 dmtx;
	I64 dmty;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
		d1_dun[i] = 22;

	dmty = 1;
	for (j = 0; dmty <= 77; j++)
	{
		dmtx = 1;
		for (i = 0; dmtx <= 77; i++)
		{
			val = 8 * d1_l5dun[(dmtx + 1) * 80 + dmty + 1]
				+ 4 * d1_l5dun[dmtx * 80 + dmty + 1]
				+ 2 * d1_l5dun[(dmtx + 1) * 80 + dmty]
				+ d1_l5dun[dmtx * 80 + dmty];
			idx = d1_l5convtbl[val];
			D1DunSet(i, j, idx);
			dmtx += 2;
		}
		dmty += 2;
	}
}

I64 D1L5HWallOk(I64 i, I64 j)
{
	I64	 x;
	Bool wallok;

	x = 1;
	while (D1DunGet(i + x, j) == 13)
	{
		if (D1DunGet(i + x, j - 1) != 13 || D1DunGet(i + x, j + 1) != 13 ||
			D1DunFlag(i + x, j))
			break;
		x++;
	}

	wallok = FALSE;
	if (D1DunGet(i + x, j) >= 3 && D1DunGet(i + x, j) <= 7)
		wallok = TRUE;
	if (D1DunGet(i + x, j) >= 16 && D1DunGet(i + x, j) <= 24)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 22)
		wallok = FALSE;
	if (x == 1)
		wallok = FALSE;

	if (wallok)
		return x;
	return -1;
}

I64 D1L5VWallOk(I64 i, I64 j)
{
	I64	 y;
	Bool wallok;

	y = 1;
	while (D1DunGet(i, j + y) == 13)
	{
		if (D1DunGet(i - 1, j + y) != 13 || D1DunGet(i + 1, j + y) != 13 ||
			D1DunFlag(i, j + y))
			break;
		y++;
	}

	wallok = FALSE;
	if (D1DunGet(i, j + y) >= 3 && D1DunGet(i, j + y) <= 7)
		wallok = TRUE;
	if (D1DunGet(i, j + y) >= 16 && D1DunGet(i, j + y) <= 24)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 22)
		wallok = FALSE;
	if (y == 1)
		wallok = FALSE;

	if (wallok)
		return y;
	return -1;
}

U0 D1L5HorizWall(I64 i, I64 j, I64 p, I64 dx)
{
	I64 xx;
	I64 wt;
	I64 dt;

	switch (D1Rnd(4))
	{
		case 0:
		case 1:
			dt = 2;
			break;
		case 2:
			dt = 12;
			if (p == 2)
				p = 12;
			if (p == 4)
				p = 10;
			break;
		case 3:
			dt = 36;
			if (p == 2)
				p = 36;
			if (p == 4)
				p = 27;
			break;
	}

	if (D1Rnd(6) == 5)
		wt = 12;
	else
		wt = 26;
	if (dt == 12)
		wt = 12;

	D1DunSet(i, j, p);

	for (xx = 1; xx < dx; xx++)
		D1DunSet(i + xx, j, dt);

	xx = D1Rnd(dx - 1) + 1;

	if (wt == 12)
		D1DunSet(i + xx, j, wt);
	else
	{
		D1DunSet(i + xx, j, 2);
		d1_dunflag[(i + xx) * D1_DMAX + j] |= DLRG_HDOOR;
	}
}

U0 D1L5VertWall(I64 i, I64 j, I64 p, I64 dy)
{
	I64 yy;
	I64 wt;
	I64 dt;

	switch (D1Rnd(4))
	{
		case 0:
		case 1:
			dt = 1;
			break;
		case 2:
			dt = 11;
			if (p == 1)
				p = 11;
			if (p == 4)
				p = 14;
			break;
		case 3:
			dt = 35;
			if (p == 1)
				p = 35;
			if (p == 4)
				p = 37;
			break;
	}

	if (D1Rnd(6) == 5)
		wt = 11;
	else
		wt = 25;
	if (dt == 11)
		wt = 11;

	D1DunSet(i, j, p);

	for (yy = 1; yy < dy; yy++)
		D1DunSet(i, j + yy, dt);

	yy = D1Rnd(dy - 1) + 1;

	if (wt == 11)
		D1DunSet(i, j + yy, wt);
	else
	{
		D1DunSet(i, j + yy, 1);
		d1_dunflag[i * D1_DMAX + j + yy] |= DLRG_VDOOR;
	}
}

U0 D1L5AddWall()
{
	I64 i;
	I64 j;
	I64 x;
	I64 y;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (!D1DunFlag(i, j))
			{
				if (D1DunGet(i, j) == 3 && D1Rnd(100) < 100)
				{
					x = D1L5HWallOk(i, j);
					if (x != -1)
						D1L5HorizWall(i, j, 2, x);
				}
				if (D1DunGet(i, j) == 3 && D1Rnd(100) < 100)
				{
					y = D1L5VWallOk(i, j);
					if (y != -1)
						D1L5VertWall(i, j, 1, y);
				}
				if (D1DunGet(i, j) == 6 && D1Rnd(100) < 100)
				{
					x = D1L5HWallOk(i, j);
					if (x != -1)
						D1L5HorizWall(i, j, 4, x);
				}
				if (D1DunGet(i, j) == 7 && D1Rnd(100) < 100)
				{
					y = D1L5VWallOk(i, j);
					if (y != -1)
						D1L5VertWall(i, j, 4, y);
				}
				if (D1DunGet(i, j) == 2 && D1Rnd(100) < 100)
				{
					x = D1L5HWallOk(i, j);
					if (x != -1)
						D1L5HorizWall(i, j, 2, x);
				}
				if (D1DunGet(i, j) == 1 && D1Rnd(100) < 100)
				{
					y = D1L5VWallOk(i, j);
					if (y != -1)
						D1L5VertWall(i, j, 1, y);
				}
			}
		}
}

U0 D1L5GChamber(I64 sx, I64 sy, Bool topflag, Bool bottomflag, Bool leftflag,
	Bool rightflag)
{
	I64 i;
	I64 j;

	if (topflag)
	{
		D1DunSet(sx + 2, sy, 12);
		D1DunSet(sx + 3, sy, 12);
		D1DunSet(sx + 4, sy, 3);
		D1DunSet(sx + 7, sy, 9);
		D1DunSet(sx + 8, sy, 12);
		D1DunSet(sx + 9, sy, 2);
	}
	if (bottomflag)
	{
		sy += 11;
		D1DunSet(sx + 2, sy, 10);
		D1DunSet(sx + 3, sy, 12);
		D1DunSet(sx + 4, sy, 8);
		D1DunSet(sx + 7, sy, 5);
		D1DunSet(sx + 8, sy, 12);
		if (D1DunGet(sx + 9, sy) != 4)
			D1DunSet(sx + 9, sy, 21);
		sy -= 11;
	}
	if (leftflag)
	{
		D1DunSet(sx, sy + 2, 11);
		D1DunSet(sx, sy + 3, 11);
		D1DunSet(sx, sy + 4, 3);
		D1DunSet(sx, sy + 7, 8);
		D1DunSet(sx, sy + 8, 11);
		D1DunSet(sx, sy + 9, 1);
	}
	if (rightflag)
	{
		sx += 11;
		D1DunSet(sx, sy + 2, 14);
		D1DunSet(sx, sy + 3, 11);
		D1DunSet(sx, sy + 4, 9);
		D1DunSet(sx, sy + 7, 5);
		D1DunSet(sx, sy + 8, 11);
		if (D1DunGet(sx, sy + 9) != 4)
			D1DunSet(sx, sy + 9, 21);
		sx -= 11;
	}

	for (j = 1; j < 11; j++)
		for (i = 1; i < 11; i++)
		{
			D1DunSet(i + sx, j + sy, 13);
			d1_dunflag[(i + sx) * D1_DMAX + j + sy] |= DLRG_CHAMBER;
		}

	D1DunSet(sx + 4, sy + 4, 15);
	D1DunSet(sx + 7, sy + 4, 15);
	D1DunSet(sx + 4, sy + 7, 15);
	D1DunSet(sx + 7, sy + 7, 15);
}

U0 D1L5GHall(I64 x1, I64 y1, I64 x2, I64 y2)
{
	I64 i;

	if (y1 == y2)
	{
		for (i = x1; i < x2; i++)
		{
			D1DunSet(i, y1, 12);
			D1DunSet(i, y1 + 3, 12);
		}
	}
	else
	{
		for (i = y1; i < y2; i++)
		{
			D1DunSet(x1, i, 11);
			D1DunSet(x1 + 3, i, 11);
		}
	}
}

U0 D1L5tileFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 23);
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 18);
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) == 2)
				D1DunSet(i + 1, j, 7);
			if (D1DunGet(i, j) == 6 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 24);
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 22)
				D1DunSet(i, j + 1, 24);
			if (D1DunGet(i, j) == 13 && D1DunGet(i, j + 1) == 1)
				D1DunSet(i, j + 1, 6);
			if (D1DunGet(i, j) == 13 && D1DunGet(i, j + 1) == 22)
				D1DunSet(i, j + 1, 19);
		}

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) == 19)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 20);
			if (D1DunGet(i, j) == 7 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 23);
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) == 24)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 19 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 20);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 19)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 19 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 6);
			if (D1DunGet(i, j) == 7 && D1DunGet(i + 1, j) == 19)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 6);
			if (D1DunGet(i, j) == 3 && D1DunGet(i + 1, j) == 22)
				D1DunSet(i + 1, j, 24);
			if (D1DunGet(i, j) == 21 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 6);
			if (D1DunGet(i, j) == 7 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 6);
			if (D1DunGet(i, j) == 7 && D1DunGet(i + 1, j) == 24)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 4 && D1DunGet(i + 1, j) == 16)
				D1DunSet(i + 1, j, 17);
			if (D1DunGet(i, j) == 7 && D1DunGet(i + 1, j) == 13)
				D1DunSet(i + 1, j, 17);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 24)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 13)
				D1DunSet(i + 1, j, 17);
			if (D1DunGet(i, j) == 23 && D1DunGet(i - 1, j) == 22)
				D1DunSet(i - 1, j, 19);
			if (D1DunGet(i, j) == 19 && D1DunGet(i - 1, j) == 23)
				D1DunSet(i - 1, j, 21);
			if (D1DunGet(i, j) == 6 && D1DunGet(i - 1, j) == 22)
				D1DunSet(i - 1, j, 24);
			if (D1DunGet(i, j) == 6 && D1DunGet(i - 1, j) == 23)
				D1DunSet(i - 1, j, 21);
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 7);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j + 1) == 18)
				D1DunSet(i, j + 1, 21);
			if (D1DunGet(i, j) == 18 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 7);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 7);
			if (D1DunGet(i, j) == 21 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 7);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j + 1) == 22)
				D1DunSet(i, j + 1, 24);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j + 1) == 13)
				D1DunSet(i, j + 1, 16);
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 13)
				D1DunSet(i, j + 1, 16);
			if (D1DunGet(i, j) == 13 && D1DunGet(i, j + 1) == 16)
				D1DunSet(i, j + 1, 17);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j - 1) == 22)
				D1DunSet(i, j - 1, 7);
			if (D1DunGet(i, j) == 6 && D1DunGet(i, j - 1) == 22)
				D1DunSet(i, j - 1, 24);
			if (D1DunGet(i, j) == 7 && D1DunGet(i, j - 1) == 24)
				D1DunSet(i, j - 1, 21);
			if (D1DunGet(i, j) == 18 && D1DunGet(i, j - 1) == 24)
				D1DunSet(i, j - 1, 21);
		}

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 4 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 7);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 19)
				D1DunSet(i + 1, j, 21);
			if (D1DunGet(i, j) == 18 && D1DunGet(i, j + 1) == 22)
				D1DunSet(i, j + 1, 20);
		}
}

U0 D1L5Subs()
{
	I64 x;
	I64 y;
	I64 rv;
	I64 i;
	I64 c;

	for (y = 0; y < D1_DMAX; y++)
		for (x = 0; x < D1_DMAX; x++)
		{
			if (D1Rnd(4) == 0)
			{
				c = d1_l5btypes[D1DunGet(x, y)];
				if (c && !D1DunFlag(x, y))
				{
					rv = D1Rnd(16);
					i  = -1;

					while (rv >= 0)
					{
						i++;
						if (i == 206)
							i = 0;
						if (c == d1_l5btypes[i])
							rv--;
					}

					if (i == 89)
					{
						if (y < 1 || d1_l5btypes[D1DunGet(x, y - 1)] != 79 ||
							D1DunFlag(x, y - 1))
							i = 79;
						else
							D1DunSet(x, y - 1, 90);
					}
					if (i == 91)
					{
						if (x + 1 >= D1_DMAX ||
							d1_l5btypes[D1DunGet(x + 1, y)] != 80 ||
							D1DunFlag(x + 1, y))
							i = 80;
						else
							D1DunSet(x + 1, y, 92);
					}
					D1DunSet(x, y, i);
				}
			}
		}
}

U0 D1L5FillChambers()
{
	if (d1_hr1)
		D1L5GChamber(0, 14, 0, 0, 0, 1);

	if (d1_hr2)
	{
		if (d1_hr1 && !d1_hr3)
			D1L5GChamber(14, 14, 0, 0, 1, 0);
		if (!d1_hr1 && d1_hr3)
			D1L5GChamber(14, 14, 0, 0, 0, 1);
		if (d1_hr1 && d1_hr3)
			D1L5GChamber(14, 14, 0, 0, 1, 1);
		if (!d1_hr1 && !d1_hr3)
			D1L5GChamber(14, 14, 0, 0, 0, 0);
	}

	if (d1_hr3)
		D1L5GChamber(28, 14, 0, 0, 1, 0);
	if (d1_hr1 && d1_hr2)
		D1L5GHall(12, 18, 14, 18);
	if (d1_hr2 && d1_hr3)
		D1L5GHall(26, 18, 28, 18);
	if (d1_hr1 && !d1_hr2 && d1_hr3)
		D1L5GHall(12, 18, 28, 18);
	if (d1_vr1)
		D1L5GChamber(14, 0, 0, 1, 0, 0);

	if (d1_vr2)
	{
		if (d1_vr1 && !d1_vr3)
			D1L5GChamber(14, 14, 1, 0, 0, 0);
		if (!d1_vr1 && d1_vr3)
			D1L5GChamber(14, 14, 0, 1, 0, 0);
		if (d1_vr1 && d1_vr3)
			D1L5GChamber(14, 14, 1, 1, 0, 0);
		if (!d1_vr1 && !d1_vr3)
			D1L5GChamber(14, 14, 0, 0, 0, 0);
	}

	if (d1_vr3)
		D1L5GChamber(14, 28, 1, 0, 0, 0);
	if (d1_vr1 && d1_vr2)
		D1L5GHall(18, 12, 18, 14);
	if (d1_vr2 && d1_vr3)
		D1L5GHall(18, 26, 18, 28);
	if (d1_vr1 && !d1_vr2 && d1_vr3)
		D1L5GHall(18, 12, 18, 28);
}

U0 D1L5DirtFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 21 && D1DunGet(i + 1, j) != 19)
				D1DunSet(i, j, 202);
			if (D1DunGet(i, j) == 19 && D1DunGet(i + 1, j) != 19)
				D1DunSet(i, j, 200);
			if (D1DunGet(i, j) == 24 && D1DunGet(i + 1, j) != 19)
				D1DunSet(i, j, 205);
			if (D1DunGet(i, j) == 18 && D1DunGet(i, j + 1) != 18)
				D1DunSet(i, j, 199);
			if (D1DunGet(i, j) == 21 && D1DunGet(i, j + 1) != 18)
				D1DunSet(i, j, 202);
			if (D1DunGet(i, j) == 23 && D1DunGet(i, j + 1) != 18)
				D1DunSet(i, j, 204);
		}
}

U0 D1L5CornerFix()
{
	I64 i;
	I64 j;

	for (j = 1; j < D1_DMAX - 1; j++)
		for (i = 1; i < D1_DMAX - 1; i++)
		{
			if (!(D1DunFlag(i, j) & DLRG_PROTECTED) && D1DunGet(i, j) == 17 &&
				D1DunGet(i - 1, j) == 13 && D1DunGet(i, j - 1) == 1)
			{
				D1DunSet(i, j, 16);
				d1_dunflag[i * D1_DMAX + j - 1] &= DLRG_PROTECTED;
			}
			if (D1DunGet(i, j) == 202 && D1DunGet(i + 1, j) == 13 &&
				D1DunGet(i, j + 1) == 1)
				D1DunSet(i, j, 8);
		}
}

U0 D1DrlgL5(I64 level, I64 entry)
{//entry 0 = from above (view at stairs up), 1 = from below (at stairs down)
	I64	 i;
	I64	 j;
	I64	 minarea;
	Bool doneflag;

	switch (level)
	{
		case 1:
			minarea = 533;
			break;
		case 2:
			minarea = 693;
			break;
		default:
			minarea = 761;
	}

	do
	{
		do
		{
			D1InitL5Dungeon;
			D1L5firstRoom;
		}
		while (D1L5GetArea() < minarea);

		D1L5makeDungeon;
		D1L5makeDmt;
		D1L5FillChambers;
		D1L5tileFix;
		D1L5AddWall;
		D1L5ClearFlags;

		doneflag = TRUE;

		if (entry == 0)
		{
			if (D1DrlgPlaceMiniSet(d1_stairsup, 1, 1, 0, 0, TRUE, -1, 0) < 0)
				doneflag = FALSE;
			else if (D1DrlgPlaceMiniSet(d1_stairsdown, 1, 1, 0, 0, FALSE, -1, 1) < 0)
				doneflag = FALSE;
		}
		else
		{
			if (D1DrlgPlaceMiniSet(d1_stairsup, 1, 1, 0, 0, FALSE, -1, 0) < 0)
				doneflag = FALSE;
			else if (D1DrlgPlaceMiniSet(d1_stairsdown, 1, 1, 0, 0, TRUE, -1, 1) < 0)
				doneflag = FALSE;
			d1_lvl_vy--;
		}
	}
	while (!doneflag);

	D1L5DirtFix;
	D1L5CornerFix;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunFlag(i, j) & 0x7F)
				D1DrlgPlaceDoor(i, j);
		}

	D1L5Subs;
	D1DrlgL1Shadows;
	D1DrlgPlaceMiniSet(d1_lamps, 5, 10, 0, 0, FALSE, -1, 4);
	D1DrlgL1Floor;
}

U0 D1CreateL1Dungeon(I64 level, I64 seed, I64 entry)
{//dungeon + dPiece. caller loads gfx (CEL/MIN/SOL/TIL) first.
	D1SetRndSeed(seed);
	D1DrlgL5(level, entry);
	D1DrlgL1Pass3;
}

//trigger tiles, found by piece scan (trigs.cpp InitL1Triggers)
I64 d1_trig_up_x   = -1;
I64 d1_trig_up_y   = -1;
I64 d1_trig_down_x = -1;
I64 d1_trig_down_y = -1;

U0 D1L1TrigScan()
{//129 = stairs up piece, 115 = stairs down
	I64 x;
	I64 y;

	d1_trig_up_x   = -1;
	d1_trig_up_y   = -1;
	d1_trig_down_x = -1;
	d1_trig_down_y = -1;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			if (D1Piece(x, y) == 129)
			{
				d1_trig_up_x = x;
				d1_trig_up_y = y;
			}
			if (D1Piece(x, y) == 115)
			{
				d1_trig_down_x = x;
				d1_trig_down_y = y;
			}
		}
}

Bool D1L1LevelLoad(I64 level, I64 seed, I64 entry)
{//cathedral level 1-4; entry 0 = arriving from above, 1 = from below
	U8 pal[32];

	if (!D1LvlLoadGfx("Levels\\L1Data\\L1.CEL",
					  "Levels\\L1Data\\L1.MIN",
					  "Levels\\L1Data\\L1.SOL",
					  "Levels\\L1Data\\L1.TIL", 10))
		return FALSE;

	D1CreateL1Dungeon(level, seed, entry);
	D1L1TrigScan;
	D1GridsClear;

	//palette variant 1-4 rides the same seed stream (LoadRndLvlPal)
	StrPrint(pal, "Levels\\L1Data\\L1_%d.pal", D1Rnd(4) + 1);
	if (!D1PalLoad(pal))
		return FALSE;

	d1_currlevel = level;
	d1_lvl_ready = TRUE;
	return TRUE;
}
