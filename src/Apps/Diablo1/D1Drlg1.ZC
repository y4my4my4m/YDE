// D1Drlg1.ZC - cathedral level generation (drlg_l1.cpp, retail path)
//
// layout is a pure function of the seed: every random_ call below happens
// in the original's order. quest set pieces and the transparency subsystem
// are absent - neither consumes RNG in the no-quest retail path.
//
// dungeon[40][40] holds base tile ids; Pass3 expands each through the TIL
// megatile into 2x2 dPiece cells at offset 16,16. out-of-bounds reads that
// are buffer overruns in the original go through guarded accessors instead
// (devilutionX PR#401).
//
// flags: 1 HDOOR, 2 VDOOR, 64 CHAMBER, 128 PROTECTED.

#define D1_DMAX		40

#define DLRG_HDOOR		0x01
#define DLRG_VDOOR		0x02
#define DLRG_CHAMBER	0x40
#define DLRG_PROTECTED	0x80

U8	d1_dun[D1_DMAX * D1_DMAX];			//[i * 40 + j]
U8	d1_dunflag[D1_DMAX * D1_DMAX];
U8	d1_l5dun[80 * 80];					//[i * 80 + j]
I64	d1_hr1 = 0;
I64	d1_hr2 = 0;
I64	d1_hr3 = 0;
I64	d1_vr1 = 0;
I64	d1_vr2 = 0;
I64	d1_vr3 = 0;
I64	d1_lvl_vx = 0;						//view position out of generation
I64	d1_lvl_vy = 0;

//SPATS shadow patterns: strig, s1, s2, s3, nv1, nv2, nv3
