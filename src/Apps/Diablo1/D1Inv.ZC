// D1Inv.ZC - inventory screen: panel, equip slots, grid, stat getters
//
// Data\Inv\Inv.CEL: one unclipped 320x352 frame over the right half of the
// screen, bottom anchor at y 351 (inv.cpp DrawInv). item icons are clipped
// Objcurs.CEL frames, base row frame field, drawn bottom-left anchored at
// the cell positions of the inv.cpp InvRect table. ring and amulet sockets
// are panel art only.
//
// storage (grid, entries, equip slots, placement) is D1Item; this file adds
// the screen, click handling and the equipment stat getters. equip rules
// (CheckInvPaste reduced): weapons to the left hand, shields to the right,
// a two-hander clears both, str requirement gates. displaced gear first-fits
// into the grid; when even the clicked item cannot return, it drops to the
// ground at the player - items are never destroyed by a move.
//
// the stat getters route through hooks D1Affix installs, because affixes and
// unique powers are compiled after this file. with no hook they return the
// plain base-row numbers. IPL_NOMINSTR, IPL_ONEHAND and IPL_INVCURS read out
// of the item's CD1ItmSt and only take effect once it is identified.
// D1InvBreak is the zero-durability destruction of player.cpp WeaponDur.
// staves are two-handed, so equipping one clears the shield hand; the spell
// they cast reaches D1Spell through d1_pow_equipped.

//panel-local left edge; the panel draws at D1UiOrgX() + D1_INV_X, rows at
//D1UiOrgY(), and D1InvClick subtracts the same origins before its rect tests
#define D1_INV_X		320

//SetSpellTrans / InvDrawSlotBack ramp bases (defs.h). before D1Panel.
#define D1_PAL8_YELLOW	144
#define D1_PAL16_BEIGE	160
#define D1_PAL16_BLUE	176
#define D1_PAL16_YELLOW	192
#define D1_PAL16_ORANGE	208
#define D1_PAL16_RED	224
#define D1_PAL16_GRAY	240

//devilutionX ICOL_* (outline). WHITE = gray+5, YELLOW unique, BLUE magic.
#define D1_ICOL_YELLOW	(D1_PAL16_YELLOW + 5)
#define D1_ICOL_WHITE	(D1_PAL16_GRAY + 5)
#define D1_ICOL_BLUE	(D1_PAL16_BLUE + 5)
#define D1_ICOL_RED	(D1_PAL16_RED + 5)

//slot-back quality (devilutionX item_quality → InvDrawSlotBack)
#define D1_IQ_NORMAL	0
#define D1_IQ_MAGIC	1
#define D1_IQ_UNIQUE	2

Bool d1_inv_open = FALSE;
U8	*d1_inv_cel  = NULL;
U8	*d1_duricons = NULL;		//Items\DurIcons.CEL — low-dur silhouettes
U8	*d1_infra_trn = NULL;		//PlrGFX\Infra.TRN — CelDrawLightRed

//InvRect grid columns/row bottoms, canvas coords (RIGHT_PANEL 320 included)
I64 d1_inv_gx[10] = {337, 366, 394, 423, 451, 480, 509, 538, 567, 596};
I64 d1_inv_gy[4]  = {250, 279, 308, 336};

//item-power hooks, installed by D1Affix (included after this file). NULL
//leaves the plain base-table values.
I64	(*d1_pow_dmgmin)() = NULL;
I64	(*d1_pow_dmgmax)() = NULL;
I64	(*d1_pow_ac)()     = NULL;
I64	(*d1_pow_str)()    = NULL;		//equipment strength bonus

U0 D1InvToggle()
{
	I64 size;

	D1ItemInit;
	if (!d1_inv_cel)
		d1_inv_cel = D1MpqRead("Data\\Inv\\Inv.CEL", &size);
	d1_inv_open = !d1_inv_open;
}

I64 D1InvDmgMinBase()
{//bare hands keep the old 2-6
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
		return d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].dmin;
	return 2;
}

I64 D1InvDmgMaxBase()
{
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
		return d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].dmax;
	return 6;
}

I64 D1InvACBase()
{//sum of the per-instance AC rolls; weapons carry 0
	I64 s;
	I64 ac = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
			ac += d1_equip_val[s];
	}
	return ac;
}

I64 D1InvDmgMin()
{
	if (d1_pow_dmgmin)
		return (*d1_pow_dmgmin)();
	return D1InvDmgMinBase();
}

I64 D1InvDmgMax()
{
	if (d1_pow_dmgmax)
		return (*d1_pow_dmgmax)();
	return D1InvDmgMaxBase();
}

I64 D1InvAC()
{
	if (d1_pow_ac)
		return (*d1_pow_ac)();
	return D1InvACBase();
}

I64 D1InvStr()
{//strength as the equip gate sees it: base plus equipment bonuses
	if (d1_pow_str)
		return d1_plr_str + (*d1_pow_str)();
	return d1_plr_str;
}

I64 D1InvCurs(CD1ItmSt *st, I64 itm)
{//IPL_INVCURS replaces the base row's Objcurs frame, once identified
	if (st->ident && st->curs > 0)
		return st->curs;
	return d1_itmdefs[itm].frame;
}

I64 D1InvQuality(CD1ItmSt *st)
{//_iMagical: unique / magic / normal
	if (!st)
		return D1_IQ_NORMAL;
	if (st->unq)
		return D1_IQ_UNIQUE;
	if (st->pfx || st->sfx)
		return D1_IQ_MAGIC;
	return D1_IQ_NORMAL;
}

Bool D1InvStatOk(I64 itm, CD1ItmSt *st)
{//items.cpp ItemMinStats / StoreStatOk — only minstr in this port
	CD1ItmDef *d;

	if (itm < 0 || itm >= d1_n_itmdefs)
		return TRUE;
	d = &d1_itmdefs[itm];
	if (st && st->ident && st->nominstr)
		return TRUE;
	if (d->minstr && D1InvStr() < d->minstr)
		return FALSE;
	return TRUE;
}

I64 D1InvOutlineCol(I64 itm, CD1ItmSt *st)
{//devilutionX GetOutlineColor(checkReq=TRUE)
	I64 q;

	if (!D1InvStatOk(itm, st))
		return D1_ICOL_RED;
	q = D1InvQuality(st);
	if (q == D1_IQ_UNIQUE)
		return D1_ICOL_YELLOW;
	if (q == D1_IQ_MAGIC)
		return D1_ICOL_BLUE;
	return D1_ICOL_WHITE;
}

U0 D1InvInfraLoad()
{
	I64 size = 0;

	if (d1_infra_trn)
		return;
	d1_infra_trn = D1MpqRead("PlrGFX\\Infra.TRN", &size);
}

U0 D1InvDrawIcon(I64 sx, I64 sy, I64 itm, CD1ItmSt *st, Bool hov)
{//DrawItem: outline on hover, Infra red tint if !_iStatFlag
	CD1ItmDef *d;
	I64 fr;
	I64 w;

	if (itm < 0 || !d1_objcurs)
		return;
	d  = &d1_itmdefs[itm];
	fr = D1InvCurs(st, itm);
	w  = d->gw * 28;
	if (hov)
		D1CelDrawOutlineClipped(sx, sy, d1_objcurs, fr, w,
			D1InvOutlineCol(itm, st));
	if (D1InvStatOk(itm, st))
		D1CelDrawClipped(sx, sy, d1_objcurs, fr, w);
	else
	{
		D1InvInfraLoad;
		if (d1_infra_trn)
			D1CelDrawClippedTrn(sx, sy, d1_objcurs, fr, w, d1_infra_trn);
		else
			D1CelDrawClipped(sx, sy, d1_objcurs, fr, w);
	}
}

I64 D1InvSlotFor(I64 itm)
{//-1 = not equipment
	CD1ItmDef *d = &d1_itmdefs[itm];

	if (d->cls == D1IC_WEAPON)
		return D1EQ_LEFT;
	if (d->cls == D1IC_ARMOR)
	{
		if (d->loc == D1IL_ONEHAND)
			return D1EQ_RIGHT;
		if (d->loc == D1IL_ARMOR)
			return D1EQ_BODY;
		if (d->loc == D1IL_HELM)
			return D1EQ_HEAD;
	}
	return -1;
}

Bool D1InvUnequip(I64 slot)
{//to the grid. FALSE = no room, slot untouched.
	if (d1_equip_itm[slot] < 0)
		return TRUE;
	if (!D1InvPut(d1_equip_itm[slot], d1_equip_val[slot]))
		return FALSE;
	if (d1_inv_last >= 0)
		D1StCopy(&d1_st_inv[d1_inv_last], &d1_st_equip[slot]);
	d1_equip_itm[slot] = -1;
	d1_equip_val[slot] = 0;
	D1StClear(&d1_st_equip[slot]);
	return TRUE;
}

U0 D1InvBreak(I64 slot)
{//player.cpp WeaponDur/ArmorDur at zero durability: the item is destroyed.
 //retail leaves the *fkd.wav rows mostly unused; play them anyway so the
 //break is audible (port previously used Barlfire — silent/wrong).
	I64 itm;
	CD1ItmDef *d;
	U8 *sfx;

	if (slot < 0 || slot >= D1EQ_N)
		return;
	itm = d1_equip_itm[slot];
	if (itm < 0)
		return;
	d = &d1_itmdefs[itm];
	if (d1_opt_sfx)
	{
		if (slot == D1EQ_HEAD)
			sfx = "Sfx\\Items\\Hlmtfkd.wav";
		else if (slot == D1EQ_BODY)
			sfx = "Sfx\\Items\\Armrfkd.wav";
		else if (d->cls == D1IC_WEAPON)
			sfx = "Sfx\\Items\\Swrdfkd.wav";
		else
			sfx = "Sfx\\Items\\Shielfkd.wav";
		D1SndPlay(sfx);
	}
	d1_equip_itm[slot] = -1;
	d1_equip_val[slot] = 0;
	D1StClear(&d1_st_equip[slot]);
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
}

Bool D1InvFitPair(I64 a, I64 b)
{//can both displaced items land in the pack, first-fit in that order?
 //the grid is marked and restored, so nothing commits. inv.cpp CheckInvPaste
 //settles the whole two-hand case before it mutates anything.
	I64	 save[D1_MAXINV];
	I64	 i;
	I64	 j;
	I64	 cell;
	I64	 cx;
	I64	 cy;
	I64	 nfree = 0;
	I64	 need  = 0;
	CD1ItmDef *d;
	Bool ok = TRUE;

	for (i = 0; i < D1_MAXINV; i++)
	{
		save[i] = d1_inv_grid[i];
		if (d1_inv_itm[i] < 0)
			nfree++;
	}
	if (a >= 0)
		need++;
	if (b >= 0)
		need++;
	if (nfree < need)
		return FALSE;

	if (a >= 0)
	{
		d    = &d1_itmdefs[a];
		cell = D1InvFindFit(d->gw, d->gh);
		if (cell < 0)
			ok = FALSE;
		else
		{
			cx = cell % 10;
			cy = cell / 10;
			for (j = 0; j < d->gh; j++)
				for (i = 0; i < d->gw; i++)
					d1_inv_grid[cx + i + (cy + j) * 10] = -1;
		}
	}
	if (ok && b >= 0)
	{
		d = &d1_itmdefs[b];
		if (D1InvFindFit(d->gw, d->gh) < 0)
			ok = FALSE;
	}

	for (i = 0; i < D1_MAXINV; i++)
		d1_inv_grid[i] = save[i];
	return ok;
}

U0 D1InvEquipFromGrid(I64 entry)
{
	I64	 itm = d1_inv_itm[entry];
	I64	 val = d1_inv_val[entry];
	CD1ItmDef *d = &d1_itmdefs[itm];
	I64	 slot;
	I64	 anchor;
	I64	 topleft;
	I64	 pair;
	I64	 i;
	I64	 e;
	Bool ok;
	Bool twohand;
	CD1ItmSt st;

	slot = D1InvSlotFor(itm);
	if (slot < 0)
		return;
	D1StCopy(&st, &d1_st_inv[entry]);
	if (!D1InvStatOk(itm, &st))
		return;
	twohand = d->loc == D1IL_TWOHAND && !(st.ident && st.onehand);

	anchor = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (d1_inv_grid[i] == entry + 1)
			anchor = i;
	}
	D1InvRemove(entry);

	//the paired hand a two-hand conflict also evicts
	pair = -1;
	if (slot == D1EQ_LEFT && twohand)
		pair = D1EQ_RIGHT;
	if (slot == D1EQ_RIGHT && d1_equip_itm[D1EQ_LEFT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].loc == D1IL_TWOHAND &&
		!(d1_st_equip[D1EQ_LEFT].ident && d1_st_equip[D1EQ_LEFT].onehand))
		pair = D1EQ_LEFT;

	//both evictions are settled before either commits: a half-applied swap
	//would leave one hand empty and the incoming item nowhere
	if (pair < 0)
		ok = D1InvFitPair(d1_equip_itm[slot], -1);
	else
		ok = D1InvFitPair(d1_equip_itm[slot], d1_equip_itm[pair]);
	if (ok)
	{
		D1InvUnequip(slot);
		if (pair >= 0)
			D1InvUnequip(pair);
	}

	if (!ok)
	{//grid too full for the displaced gear; the item goes back where it was,
	 //carrying its state. its own cells are still free, so this always fits.
		topleft = anchor - (d->gh - 1) * 10;
		e = -1;
		for (i = 0; i < D1_MAXINV; i++)
		{
			if (e < 0 && d1_inv_itm[i] < 0)
				e = i;
		}
		if (e >= 0 && D1InvFitAt(topleft, d->gw, d->gh))
		{
			d1_inv_itm[e] = itm;
			d1_inv_val[e] = val;
			D1StCopy(&d1_st_inv[e], &st);
			D1InvPlaceAt(topleft, e);
		}
		else if (D1InvPut(itm, val))
		{
			if (d1_inv_last >= 0)
				D1StCopy(&d1_st_inv[d1_inv_last], &st);
		}
		return;
	}

	d1_equip_itm[slot] = itm;
	d1_equip_val[slot] = val;
	D1StCopy(&d1_st_equip[slot], &st);
	D1ItmSndPlay(itm);		//CheckInvPaste (inv.cpp:1158)
	if (d1_pow_equipped)
		(*d1_pow_equipped)(slot);
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
}

U0 D1InvClickGrid(I64 cell)
{//CheckInvCut / CheckInvPaste on a backpack cell
	I64	 v = d1_inv_grid[cell];
	I64	 entry;
	I64	 itm;
	I64	 val;
	CD1ItmSt st;
	I64	 hitm;
	I64	 hval;
	CD1ItmSt hst;

	if (D1HoldHas())
	{
		if (!v)
		{
			D1HoldPlaceAt(cell);
			return;
		}
		//swap: lift resident, paste hold, put resident on cursor
		if (v < 0)
			entry = -v - 1;
		else
			entry = v - 1;
		itm = d1_inv_itm[entry];
		val = d1_inv_val[entry];
		D1StCopy(&st, &d1_st_inv[entry]);
		hitm = d1_hold_itm;
		hval = d1_hold_val;
		D1StCopy(&hst, &d1_hold_st);
		D1InvRemove(entry);
		D1HoldClear;
		d1_hold_itm = hitm;
		d1_hold_val = hval;
		D1StCopy(&d1_hold_st, &hst);
		if (!D1HoldPlaceAt(cell))
		{//paste failed - put resident back, restore hold
			D1HoldClear;
			if (D1InvPut(itm, val) && d1_inv_last >= 0)
				D1StCopy(&d1_st_inv[d1_inv_last], &st);
			D1HoldTake(hitm, hval, &hst);
			return;
		}
		D1HoldTake(itm, val, &st);
		return;
	}

	if (!v)
		return;
	if (v < 0)
		entry = -v - 1;
	else
		entry = v - 1;
	itm = d1_inv_itm[entry];
	val = d1_inv_val[entry];
	D1HoldTake(itm, val, &d1_st_inv[entry]);
	D1InvRemove(entry);
}

Bool D1InvOver(I64 cx, I64 cy)
{//canvas coords land on the open panel half
	if (!d1_inv_open)
		return FALSE;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	return cx >= D1_INV_X && cy >= 0 && cy <= 351;
}

I64 D1InvHitSlot(I64 cx, I64 cy)
{//equip slot under the cursor, -1 none; InvRect slot cells
	if (!D1InvOver(cx, cy))
		return -1;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx >= 452 && cx < 508 && cy >= 3 && cy < 59)
		return D1EQ_HEAD;
	if (cx >= 452 && cx < 508 && cy >= 76 && cy < 160)
		return D1EQ_BODY;
	if (cx >= 337 && cx < 394 && cy >= 76 && cy < 160)
		return D1EQ_LEFT;
	if (cx >= 567 && cx < 624 && cy >= 76 && cy < 160)
		return D1EQ_RIGHT;
	return -1;
}

I64 D1InvHitEntry(I64 cx, I64 cy)
{//inventory entry under the cursor, -1 none (CheckInvHLight grid arm)
	I64 col = -1;
	I64 row = -1;
	I64 c;
	I64 r;
	I64 v;

	if (!D1InvOver(cx, cy))
		return -1;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	for (c = 0; c < 10; c++)
	{
		if (cx >= d1_inv_gx[c] && cx < d1_inv_gx[c] + 28)
			col = c;
	}
	for (r = 0; r < 4; r++)
	{
		if (cy >= d1_inv_gy[r] - 28 && cy < d1_inv_gy[r])
			row = r;
	}
	if (col < 0 || row < 0)
		return -1;
	v = d1_inv_grid[col + row * 10];
	if (!v)
		return -1;
	if (v < 0)
		return -v - 1;
	return v - 1;
}

Bool D1InvClick(I64 cx, I64 cy)
{//canvas coords. TRUE = consumed (any click on the open panel half).
	I64 col;
	I64 row;
	I64 c;
	I64 r;
	I64 s;
	I64 e;
	I64 itm;
	I64 val;
	I64 slot;
	CD1ItmSt st;
	Bool twohand;
	Bool from_hand;

	if (!D1InvOver(cx, cy))
		return FALSE;

	s = D1InvHitSlot(cx, cy);
	if (d1_spl_curs)
	{
		e = -1;
		if (s < 0)
			e = D1InvHitEntry(cx, cy);
		if ((*d1_spl_curs)(e, s))
			return TRUE;
	}
	if (s >= 0)
	{
		if (D1HoldHas())
		{//CheckInvPaste onto an equip slot
			slot = D1InvSlotFor(d1_hold_itm);
			//inv.cpp CheckInvPaste (1132): an item whose _iStatFlag is clear
			//never reaches the slot, and the class says so
			if (slot == s && !D1InvStatOk(d1_hold_itm, &d1_hold_st))
			{
				if (d1_opt_sfx)
				{
					if (d1_plr_class == 1)
						D1SndPlay("Sfx\\Rogue\\Rogue13.wav");
					else if (d1_plr_class == 2)
						D1SndPlay("Sfx\\Sorceror\\Mage13.wav");
					else
						D1SndPlay("Sfx\\Warrior\\Warior13.wav");
				}
				return TRUE;
			}
			if (slot == s)
			{
				twohand = d1_itmdefs[d1_hold_itm].loc == D1IL_TWOHAND &&
					!(d1_hold_st.ident && d1_hold_st.onehand);
				//two-hander clears the shield; try pack, else abort paste
				if (twohand && slot == D1EQ_LEFT && d1_equip_itm[D1EQ_RIGHT] >= 0)
				{
					if (!D1InvUnequip(D1EQ_RIGHT))
						return TRUE;
					d1_wep_gfx_dirty = TRUE;
				}
				//shield onto right while a two-hander is worn: clear weapon
				if (slot == D1EQ_RIGHT && d1_equip_itm[D1EQ_LEFT] >= 0 &&
					d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].loc == D1IL_TWOHAND &&
					!(d1_st_equip[D1EQ_LEFT].ident &&
					d1_st_equip[D1EQ_LEFT].onehand))
				{
					if (!D1InvUnequip(D1EQ_LEFT))
						return TRUE;
					d1_wep_gfx_dirty = TRUE;
				}
				itm = d1_equip_itm[s];
				val = d1_equip_val[s];
				D1StCopy(&st, &d1_st_equip[s]);
				d1_equip_itm[s] = d1_hold_itm;
				d1_equip_val[s] = d1_hold_val;
				D1StCopy(&d1_st_equip[s], &d1_hold_st);
				D1HoldClear;
				if (itm >= 0)
					D1HoldTake(itm, val, &st);
				else
					D1ItmSndPlay(d1_equip_itm[s]);
				if (d1_pow_equipped)
					(*d1_pow_equipped)(s);
				if (s == D1EQ_LEFT || s == D1EQ_RIGHT)
					d1_wep_gfx_dirty = TRUE;
			}
			return TRUE;
		}
		//lift worn gear onto the cursor
		if (d1_equip_itm[s] >= 0)
		{
			from_hand = ToBool(s == D1EQ_LEFT || s == D1EQ_RIGHT);
			D1HoldTake(d1_equip_itm[s], d1_equip_val[s], &d1_st_equip[s]);
			d1_equip_itm[s] = -1;
			d1_equip_val[s] = 0;
			D1StClear(&d1_st_equip[s]);
			if (from_hand)
				d1_wep_gfx_dirty = TRUE;
			if (d1_pow_equipped)
				(*d1_pow_equipped)(s);
		}
		return TRUE;
	}

	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	col = -1;
	row = -1;
	for (c = 0; c < 10; c++)
	{
		if (cx >= d1_inv_gx[c] && cx < d1_inv_gx[c] + 28)
			col = c;
	}
	for (r = 0; r < 4; r++)
	{
		if (cy >= d1_inv_gy[r] - 28 && cy < d1_inv_gy[r])
			row = r;
	}
	if (col >= 0 && row >= 0)
		D1InvClickGrid(col + row * 10);
	return TRUE;
}

Bool D1InvUseEntry(I64 entry)
{//inv.cpp UseInvItem (inv.cpp:2797): potions + spell books.
 //TRUE = the item was used and consumed.
	I64 itm;
	I64 misc;
	I64 s;

	if (entry < 0 || entry >= D1_MAXINV || d1_inv_itm[entry] < 0)
		return FALSE;
	itm = d1_inv_itm[entry];
	misc = d1_itmdefs[itm].misc;
	if (!misc || d1_plr_dead)
		return FALSE;
	if (misc == D1IM_BOOK)
	{
		s = itm - D1IT_BOOK0;
		if (!d1_spl_book || !(*d1_spl_book)(s))
			return FALSE;
		D1ItmSndPlay(itm);
		D1InvRemove(entry);
		return TRUE;
	}
	D1ItmSndPlay(itm);
	D1ItemUseMisc(misc);
	D1InvRemove(entry);
	return TRUE;
}

Bool D1InvRClick(I64 cx, I64 cy)
{//right-click uses the grid item under the cursor (UseInvItem); equipment
 //is a no-op, as retail. belt chips UseBeltItem. TRUE = consumed.
	I64 e;
	I64 s;
	I64 bx;
	I64 by;

	if (D1InvOver(cx, cy))
	{
		e = D1InvHitEntry(cx, cy);
		if (e >= 0)
			D1InvUseEntry(e);
		return TRUE;
	}
	bx = cx - D1UiOrgX();
	by = cy - D1PanelTop();
	if (by >= 5 && by < 36)
	{
		for (s = 0; s < 8; s++)
		{
			if (bx >= 205 + s * 29 && bx < 233 + s * 29)
			{
				D1BeltUse(s);
				return TRUE;
			}
		}
	}
	return FALSE;
}

U0 D1InvSlotBack(I64 X, I64 Y, I64 W, I64 H, I64 qual)
{//devilutionX InvDrawSlotBack(quality): gray band → beige/blue/yellow.
 //old retail always remapped blue+gray→beige (everything looked brown/red).
	I64	 x;
	I64	 y;
	I64	 yy;
	I64	 pix;
	I64	 shift;

	if (qual == D1_IQ_MAGIC)
		shift = D1_PAL16_GRAY - D1_PAL16_BLUE - 1;
	else if (qual == D1_IQ_UNIQUE)
		shift = D1_PAL16_GRAY - D1_PAL16_YELLOW - 1;
	else
		shift = D1_PAL16_GRAY - D1_PAL16_BEIGE - 1;

	if (!d1_screen)
		return;
	for (y = 0; y < H; y++)
	{
		yy = Y - y;
		if (yy >= 0 && yy < d1_h)
		{
			for (x = 0; x < W; x++)
			{
				if (X + x >= 0 && X + x < d1_w)
				{
					pix = d1_screen[yy * D1_W_MAX + X + x];
					if (pix >= D1_PAL16_GRAY)
						pix -= shift;
					d1_screen[yy * D1_W_MAX + X + x] = pix;
				}
			}
		}
	}
}

U0 D1InvDrawEquip(I64 slot, I64 sx, I64 sy, Bool hov)
{//fixed-anchor slots (head, body)
	if (d1_equip_itm[slot] < 0)
		return;
	D1InvDrawIcon(sx, sy, d1_equip_itm[slot], &d1_st_equip[slot], hov);
}

U0 D1InvDrawHand(I64 slot, I64 x1, I64 x2, Bool hov)
{//inv.cpp centers sub-2x3 weapons: narrow +14px, short -14px
	CD1ItmDef *d;
	I64	 sx;
	I64	 sy;

	if (d1_equip_itm[slot] < 0)
		return;
	d  = &d1_itmdefs[d1_equip_itm[slot]];
	sx = x2;
	if (d->gw == 1)
		sx = x1;
	sy = D1UiOrgY() + 160;
	if (d->gh != 3)
		sy = D1UiOrgY() + 146;
	D1InvDrawIcon(sx, sy, d1_equip_itm[slot], &d1_st_equip[slot], hov);
}

U0 D1InvDraw()
{
	I64	 c;
	I64	 e;
	I64	 uo = D1UiOrgX();
	I64	 uy = D1UiOrgY();
	I64	 ox = uo + D1_INV_X;
	I64	 mx = D1MouseX();
	I64	 my = D1MouseY();
	I64	 hs;
	I64	 he;
	I64	 q;
	Bool hov;

	if (!d1_inv_open || !d1_inv_cel)
		return;

	hs = D1InvHitSlot(mx, my);
	he = D1InvHitEntry(mx, my);

	D1CelDraw(ox, uy + 351, d1_inv_cel, 1, 320);

	if (d1_equip_itm[D1EQ_HEAD] >= 0)
	{
		D1InvSlotBack(ox + 133, uy + 59, 56, 56,
			D1InvQuality(&d1_st_equip[D1EQ_HEAD]));
		D1InvDrawEquip(D1EQ_HEAD, ox + 133, uy + 59, hs == D1EQ_HEAD);
	}
	if (d1_equip_itm[D1EQ_BODY] >= 0)
	{
		D1InvSlotBack(ox + 133, uy + 160, 56, 84,
			D1InvQuality(&d1_st_equip[D1EQ_BODY]));
		D1InvDrawEquip(D1EQ_BODY, ox + 133, uy + 160, hs == D1EQ_BODY);
	}
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
	{
		D1InvSlotBack(ox + 17, uy + 160, 56, 84,
			D1InvQuality(&d1_st_equip[D1EQ_LEFT]));
		D1InvDrawHand(D1EQ_LEFT, ox + 31, ox + 17, hs == D1EQ_LEFT);
	}
	if (d1_equip_itm[D1EQ_RIGHT] >= 0)
	{
		D1InvSlotBack(ox + 247, uy + 160, 56, 84,
			D1InvQuality(&d1_st_equip[D1EQ_RIGHT]));
		D1InvDrawHand(D1EQ_RIGHT, ox + 261, ox + 249, hs == D1EQ_RIGHT);
	}

	for (c = 0; c < D1_MAXINV; c++)
	{
		if (d1_inv_grid[c] != 0)
		{
			if (d1_inv_grid[c] < 0)
				e = -d1_inv_grid[c] - 1;
			else
				e = d1_inv_grid[c] - 1;
			q = D1InvQuality(&d1_st_inv[e]);
			D1InvSlotBack(uo + d1_inv_gx[c % 10],
				uy + d1_inv_gy[c / 10] - 1, 28, 28, q);
		}
	}

	for (c = 0; c < D1_MAXINV; c++)
	{
		if (d1_inv_grid[c] > 0)
		{
			e = d1_inv_grid[c] - 1;
			hov = (he == e);
			D1InvDrawIcon(uo + d1_inv_gx[c % 10],
				uy + d1_inv_gy[c / 10] - 1,
				d1_inv_itm[e], &d1_st_inv[e], hov);
		}
	}
}

I64 D1DurIcon4(I64 slot, I64 x, I64 c)
{//control.cpp DrawDurIcon4Item: show when durability <= 5. frames 1..8
 //red (critical), +8 gold (warn). c=0 picks weapon/armor from class.
	I64 itm;
	CD1ItmSt *st;
	CD1ItmDef *d;

	itm = d1_equip_itm[slot];
	if (itm < 0)
		return x;
	st = &d1_st_equip[slot];
	if (st->dur == D1_DURINF || st->maxdur == 0)
		return x;
	if (st->dur > 5)
		return x;
	if (c == 0)
	{
		d = &d1_itmdefs[itm];
		if (d->cls == D1IC_WEAPON)
			c = 2;				//sword; axe/bow/mace/staff share warn art
		else
			c = 1;				//shield / misc armor
	}
	if (st->dur > 2)
		c += 8;
	if (d1_duricons)
		D1CelDraw(x, D1PanelTop() - 17, d1_duricons, c, 32);
	return x - 40;
}

U0 D1DurIconDraw()
{//control.cpp DrawDurIcon — right of the play area, above the panel
	I64 x;
	I64 size = 0;

	if (!d1_duricons)
		d1_duricons = D1MpqRead("Items\\DurIcons.CEL", &size);
	if (!d1_duricons)
		return;
	x = D1UiOrgX() + D1_UI_W - 32 - 16;
	if (d1_inv_open)
		x -= 320;				//SPANEL_WIDTH
	x = D1DurIcon4(D1EQ_HEAD, x, 4);
	x = D1DurIcon4(D1EQ_BODY, x, 3);
	x = D1DurIcon4(D1EQ_LEFT, x, 0);
	D1DurIcon4(D1EQ_RIGHT, x, 0);
}
