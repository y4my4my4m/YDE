// D1Inv.ZC - inventory screen: panel, equip slots, grid, stat getters
//
// Data\Inv\Inv.CEL: one unclipped 320x352 frame over the right half of the
// screen, bottom anchor at y 351 (inv.cpp DrawInv). item icons are clipped
// Objcurs.CEL frames, base row frame field, drawn bottom-left anchored at
// the cell positions of the inv.cpp InvRect table. ring and amulet sockets
// are panel art only.
//
// storage (grid, entries, equip slots, placement) is D1Item; this file adds
// the screen, click handling and the equipment stat getters. equip rules
// (CheckInvPaste reduced): weapons to the left hand, shields to the right,
// a two-hander clears both, str requirement gates. displaced gear first-fits
// into the grid; when even the clicked item cannot return, it drops to the
// ground at the player - items are never destroyed by a move.
//
// the stat getters route through hooks D1Affix installs, because affixes and
// unique powers are compiled after this file. with no hook they return the
// plain base-row numbers. IPL_NOMINSTR, IPL_ONEHAND and IPL_INVCURS read out
// of the item's CD1ItmSt and only take effect once it is identified.
// D1InvBreak is the zero-durability destruction of player.cpp WeaponDur.
// staves are two-handed, so equipping one clears the shield hand; the spell
// they cast reaches D1Spell through d1_pow_equipped.

//panel-local left edge; the panel draws at D1UiOrgX() + D1_INV_X, rows at
//D1UiOrgY(), and D1InvClick subtracts the same origins before its rect tests
#define D1_INV_X		320

//SetSpellTrans / InvDrawSlotBack ramp bases (defs.h). before D1Panel.
#define D1_PAL8_YELLOW	144
#define D1_PAL16_BEIGE	160
#define D1_PAL16_BLUE	176
#define D1_PAL16_YELLOW	192
#define D1_PAL16_ORANGE	208
#define D1_PAL16_RED	224
#define D1_PAL16_GRAY	240

Bool d1_inv_open = FALSE;
U8	*d1_inv_cel  = NULL;

//InvRect grid columns/row bottoms, canvas coords (RIGHT_PANEL 320 included)
I64 d1_inv_gx[10] = {337, 366, 394, 423, 451, 480, 509, 538, 567, 596};
I64 d1_inv_gy[4]  = {250, 279, 308, 336};

//item-power hooks, installed by D1Affix (included after this file). NULL
//leaves the plain base-table values.
I64	(*d1_pow_dmgmin)() = NULL;
I64	(*d1_pow_dmgmax)() = NULL;
I64	(*d1_pow_ac)()     = NULL;
I64	(*d1_pow_str)()    = NULL;		//equipment strength bonus

U0 D1InvToggle()
{
	I64 size;

	D1ItemInit;
	if (!d1_inv_cel)
		d1_inv_cel = D1MpqRead("Data\\Inv\\Inv.CEL", &size);
	d1_inv_open = !d1_inv_open;
}

I64 D1InvDmgMinBase()
{//bare hands keep the old 2-6
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
		return d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].dmin;
	return 2;
}

I64 D1InvDmgMaxBase()
{
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
		return d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].dmax;
	return 6;
}

I64 D1InvACBase()
{//sum of the per-instance AC rolls; weapons carry 0
	I64 s;
	I64 ac = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
			ac += d1_equip_val[s];
	}
	return ac;
}

I64 D1InvDmgMin()
{
	if (d1_pow_dmgmin)
		return (*d1_pow_dmgmin)();
	return D1InvDmgMinBase();
}

I64 D1InvDmgMax()
{
	if (d1_pow_dmgmax)
		return (*d1_pow_dmgmax)();
	return D1InvDmgMaxBase();
}

I64 D1InvAC()
{
	if (d1_pow_ac)
		return (*d1_pow_ac)();
	return D1InvACBase();
}

I64 D1InvStr()
{//strength as the equip gate sees it: base plus equipment bonuses
	if (d1_pow_str)
		return d1_plr_str + (*d1_pow_str)();
	return d1_plr_str;
}

I64 D1InvCurs(CD1ItmSt *st, I64 itm)
{//IPL_INVCURS replaces the base row's Objcurs frame, once identified
	if (st->ident && st->curs > 0)
		return st->curs;
	return d1_itmdefs[itm].frame;
}

I64 D1InvSlotFor(I64 itm)
{//-1 = not equipment
	CD1ItmDef *d = &d1_itmdefs[itm];

	if (d->cls == D1IC_WEAPON)
		return D1EQ_LEFT;
	if (d->cls == D1IC_ARMOR)
	{
		if (d->loc == D1IL_ONEHAND)
			return D1EQ_RIGHT;
		if (d->loc == D1IL_ARMOR)
			return D1EQ_BODY;
		if (d->loc == D1IL_HELM)
			return D1EQ_HEAD;
	}
	return -1;
}

Bool D1InvUnequip(I64 slot)
{//to the grid. FALSE = no room, slot untouched.
	if (d1_equip_itm[slot] < 0)
		return TRUE;
	if (!D1InvPut(d1_equip_itm[slot], d1_equip_val[slot]))
		return FALSE;
	if (d1_inv_last >= 0)
		D1StCopy(&d1_st_inv[d1_inv_last], &d1_st_equip[slot]);
	d1_equip_itm[slot] = -1;
	d1_equip_val[slot] = 0;
	D1StClear(&d1_st_equip[slot]);
	return TRUE;
}

U0 D1InvBreak(I64 slot)
{//player.cpp WeaponDur/ArmorDur at zero durability: the item is destroyed
	if (d1_equip_itm[slot] < 0)
		return;
	d1_equip_itm[slot] = -1;
	d1_equip_val[slot] = 0;
	D1StClear(&d1_st_equip[slot]);
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Barlfire.wav");
}

U0 D1InvEquipFromGrid(I64 entry)
{
	I64	 itm = d1_inv_itm[entry];
	I64	 val = d1_inv_val[entry];
	CD1ItmDef *d = &d1_itmdefs[itm];
	I64	 slot;
	I64	 anchor;
	I64	 topleft;
	I64	 i;
	I64	 e;
	Bool ok;
	Bool twohand;
	CD1ItmSt st;

	slot = D1InvSlotFor(itm);
	if (slot < 0)
		return;
	D1StCopy(&st, &d1_st_inv[entry]);
	if (!(st.ident && st.nominstr) && D1InvStr() < d->minstr)
		return;
	twohand = d->loc == D1IL_TWOHAND && !(st.ident && st.onehand);

	anchor = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (d1_inv_grid[i] == entry + 1)
			anchor = i;
	}
	D1InvRemove(entry);

	//clear the target slot, and the paired hand for two-hand conflicts
	ok = D1InvUnequip(slot);
	if (ok && slot == D1EQ_LEFT && twohand)
		ok = D1InvUnequip(D1EQ_RIGHT);
	if (ok && slot == D1EQ_RIGHT && d1_equip_itm[D1EQ_LEFT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].loc == D1IL_TWOHAND &&
		!(d1_st_equip[D1EQ_LEFT].ident && d1_st_equip[D1EQ_LEFT].onehand))
		ok = D1InvUnequip(D1EQ_LEFT);

	if (!ok)
	{//grid too full for the displaced gear; put the item back
		topleft = anchor - (d->gh - 1) * 10;
		if (D1InvFitAt(topleft, d->gw, d->gh))
		{
			e = -1;
			for (i = 0; i < D1_MAXINV; i++)
			{
				if (e < 0 && d1_inv_itm[i] < 0)
					e = i;
			}
			d1_inv_itm[e] = itm;
			d1_inv_val[e] = val;
			D1StCopy(&d1_st_inv[e], &st);
			D1InvPlaceAt(topleft, e);
		}
		else if (D1InvPut(itm, val))
		{
			if (d1_inv_last >= 0)
				D1StCopy(&d1_st_inv[d1_inv_last], &st);
		}
		else
			D1ItemDrop(itm, d1_plr_tile_x, d1_plr_tile_y, 0);
		return;
	}

	d1_equip_itm[slot] = itm;
	d1_equip_val[slot] = val;
	D1StCopy(&d1_st_equip[slot], &st);
	D1ItmSndPlay(itm);		//CheckInvPaste (inv.cpp:1158)
	if (d1_pow_equipped)
		(*d1_pow_equipped)(slot);
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
}

U0 D1InvClickGrid(I64 cell)
{//CheckInvCut / CheckInvPaste on a backpack cell
	I64	 v = d1_inv_grid[cell];
	I64	 entry;
	I64	 itm;
	I64	 val;
	CD1ItmSt st;
	I64	 hitm;
	I64	 hval;
	CD1ItmSt hst;

	if (D1HoldHas())
	{
		if (!v)
		{
			D1HoldPlaceAt(cell);
			return;
		}
		//swap: lift resident, paste hold, put resident on cursor
		if (v < 0)
			entry = -v - 1;
		else
			entry = v - 1;
		itm = d1_inv_itm[entry];
		val = d1_inv_val[entry];
		D1StCopy(&st, &d1_st_inv[entry]);
		hitm = d1_hold_itm;
		hval = d1_hold_val;
		D1StCopy(&hst, &d1_hold_st);
		D1InvRemove(entry);
		D1HoldClear;
		d1_hold_itm = hitm;
		d1_hold_val = hval;
		D1StCopy(&d1_hold_st, &hst);
		if (!D1HoldPlaceAt(cell))
		{//paste failed - put resident back, restore hold
			D1HoldClear;
			if (D1InvPut(itm, val) && d1_inv_last >= 0)
				D1StCopy(&d1_st_inv[d1_inv_last], &st);
			D1HoldTake(hitm, hval, &hst);
			return;
		}
		D1HoldTake(itm, val, &st);
		return;
	}

	if (!v)
		return;
	if (v < 0)
		entry = -v - 1;
	else
		entry = v - 1;
	itm = d1_inv_itm[entry];
	val = d1_inv_val[entry];
	D1HoldTake(itm, val, &d1_st_inv[entry]);
	D1InvRemove(entry);
}

Bool D1InvOver(I64 cx, I64 cy)
{//canvas coords land on the open panel half
	if (!d1_inv_open)
		return FALSE;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	return cx >= D1_INV_X && cy >= 0 && cy <= 351;
}

I64 D1InvHitSlot(I64 cx, I64 cy)
{//equip slot under the cursor, -1 none; InvRect slot cells
	if (!D1InvOver(cx, cy))
		return -1;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx >= 452 && cx < 508 && cy >= 3 && cy < 59)
		return D1EQ_HEAD;
	if (cx >= 452 && cx < 508 && cy >= 76 && cy < 160)
		return D1EQ_BODY;
	if (cx >= 337 && cx < 394 && cy >= 76 && cy < 160)
		return D1EQ_LEFT;
	if (cx >= 567 && cx < 624 && cy >= 76 && cy < 160)
		return D1EQ_RIGHT;
	return -1;
}

I64 D1InvHitEntry(I64 cx, I64 cy)
{//inventory entry under the cursor, -1 none (CheckInvHLight grid arm)
	I64 col = -1;
	I64 row = -1;
	I64 c;
	I64 r;
	I64 v;

	if (!D1InvOver(cx, cy))
		return -1;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	for (c = 0; c < 10; c++)
	{
		if (cx >= d1_inv_gx[c] && cx < d1_inv_gx[c] + 28)
			col = c;
	}
	for (r = 0; r < 4; r++)
	{
		if (cy >= d1_inv_gy[r] - 28 && cy < d1_inv_gy[r])
			row = r;
	}
	if (col < 0 || row < 0)
		return -1;
	v = d1_inv_grid[col + row * 10];
	if (!v)
		return -1;
	if (v < 0)
		return -v - 1;
	return v - 1;
}

Bool D1InvClick(I64 cx, I64 cy)
{//canvas coords. TRUE = consumed (any click on the open panel half).
	I64 col;
	I64 row;
	I64 c;
	I64 r;
	I64 s;
	I64 e;
	I64 itm;
	I64 val;
	I64 slot;
	CD1ItmSt st;
	Bool twohand;
	Bool from_hand;

	if (!D1InvOver(cx, cy))
		return FALSE;

	s = D1InvHitSlot(cx, cy);
	if (d1_spl_curs)
	{
		e = -1;
		if (s < 0)
			e = D1InvHitEntry(cx, cy);
		if ((*d1_spl_curs)(e, s))
			return TRUE;
	}
	if (s >= 0)
	{
		if (D1HoldHas())
		{//CheckInvPaste onto an equip slot
			slot = D1InvSlotFor(d1_hold_itm);
			if (slot == s)
			{
				twohand = d1_itmdefs[d1_hold_itm].loc == D1IL_TWOHAND &&
					!(d1_hold_st.ident && d1_hold_st.onehand);
				//two-hander clears the shield; try pack, else abort paste
				if (twohand && slot == D1EQ_LEFT && d1_equip_itm[D1EQ_RIGHT] >= 0)
				{
					if (!D1InvUnequip(D1EQ_RIGHT))
						return TRUE;
					d1_wep_gfx_dirty = TRUE;
				}
				//shield onto right while a two-hander is worn: clear weapon
				if (slot == D1EQ_RIGHT && d1_equip_itm[D1EQ_LEFT] >= 0 &&
					d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].loc == D1IL_TWOHAND &&
					!(d1_st_equip[D1EQ_LEFT].ident &&
					d1_st_equip[D1EQ_LEFT].onehand))
				{
					if (!D1InvUnequip(D1EQ_LEFT))
						return TRUE;
					d1_wep_gfx_dirty = TRUE;
				}
				itm = d1_equip_itm[s];
				val = d1_equip_val[s];
				D1StCopy(&st, &d1_st_equip[s]);
				d1_equip_itm[s] = d1_hold_itm;
				d1_equip_val[s] = d1_hold_val;
				D1StCopy(&d1_st_equip[s], &d1_hold_st);
				D1HoldClear;
				if (itm >= 0)
					D1HoldTake(itm, val, &st);
				else
					D1ItmSndPlay(d1_equip_itm[s]);
				if (d1_pow_equipped)
					(*d1_pow_equipped)(s);
				if (s == D1EQ_LEFT || s == D1EQ_RIGHT)
					d1_wep_gfx_dirty = TRUE;
			}
			return TRUE;
		}
		//lift worn gear onto the cursor
		if (d1_equip_itm[s] >= 0)
		{
			from_hand = ToBool(s == D1EQ_LEFT || s == D1EQ_RIGHT);
			D1HoldTake(d1_equip_itm[s], d1_equip_val[s], &d1_st_equip[s]);
			d1_equip_itm[s] = -1;
			d1_equip_val[s] = 0;
			D1StClear(&d1_st_equip[s]);
			if (from_hand)
				d1_wep_gfx_dirty = TRUE;
			if (d1_pow_equipped)
				(*d1_pow_equipped)(s);
		}
		return TRUE;
	}

	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	col = -1;
	row = -1;
	for (c = 0; c < 10; c++)
	{
		if (cx >= d1_inv_gx[c] && cx < d1_inv_gx[c] + 28)
			col = c;
	}
	for (r = 0; r < 4; r++)
	{
		if (cy >= d1_inv_gy[r] - 28 && cy < d1_inv_gy[r])
			row = r;
	}
	if (col >= 0 && row >= 0)
		D1InvClickGrid(col + row * 10);
	return TRUE;
}

Bool D1InvUseEntry(I64 entry)
{//inv.cpp UseInvItem (inv.cpp:2797): potions + spell books.
 //TRUE = the item was used and consumed.
	I64 itm;
	I64 misc;
	I64 s;

	if (entry < 0 || entry >= D1_MAXINV || d1_inv_itm[entry] < 0)
		return FALSE;
	itm = d1_inv_itm[entry];
	misc = d1_itmdefs[itm].misc;
	if (!misc || d1_plr_dead)
		return FALSE;
	if (misc == D1IM_BOOK)
	{
		s = itm - D1IT_BOOK0;
		if (!d1_spl_book || !(*d1_spl_book)(s))
			return FALSE;
		D1ItmSndPlay(itm);
		D1InvRemove(entry);
		return TRUE;
	}
	D1ItmSndPlay(itm);
	D1ItemUseMisc(misc);
	D1InvRemove(entry);
	return TRUE;
}

Bool D1InvRClick(I64 cx, I64 cy)
{//right-click uses the grid item under the cursor (UseInvItem); equipment
 //is a no-op, as retail. belt chips UseBeltItem. TRUE = consumed.
	I64 e;
	I64 s;
	I64 bx;
	I64 by;

	if (D1InvOver(cx, cy))
	{
		e = D1InvHitEntry(cx, cy);
		if (e >= 0)
			D1InvUseEntry(e);
		return TRUE;
	}
	bx = cx - D1UiOrgX();
	by = cy - D1PanelTop();
	if (by >= 5 && by < 36)
	{
		for (s = 0; s < 8; s++)
		{
			if (bx >= 205 + s * 29 && bx < 233 + s * 29)
			{
				D1BeltUse(s);
				return TRUE;
			}
		}
	}
	return FALSE;
}

U0 D1InvSlotBack(I64 X, I64 Y, I64 W, I64 H)
{//inv.cpp InvDrawSlotBack: BLUE..+15 and GRAY.. → BEIGE band in W×H.
 //Y = CelDraw bottom-left row; walk up H rows (retail PitchTbl --).
	I64	 x;
	I64	 y;
	I64	 yy;
	I64	 pix;

	if (!d1_screen)
		return;
	for (y = 0; y < H; y++)
	{
		yy = Y - y;
		if (yy >= 0 && yy < d1_h)
		{
			for (x = 0; x < W; x++)
			{
				if (X + x >= 0 && X + x < d1_w)
				{
					pix = d1_screen[yy * D1_W_MAX + X + x];
					if (pix >= D1_PAL16_BLUE)
					{
						if (pix <= D1_PAL16_BLUE + 15)
							pix -= D1_PAL16_BLUE - D1_PAL16_BEIGE;
						else if (pix >= D1_PAL16_GRAY)
							pix -= D1_PAL16_GRAY - D1_PAL16_BEIGE;
					}
					d1_screen[yy * D1_W_MAX + X + x] = pix;
				}
			}
		}
	}
}

U0 D1InvDrawEquip(I64 slot, I64 sx, I64 sy)
{//fixed-anchor slots (head, body)
	CD1ItmDef *d;

	if (d1_equip_itm[slot] < 0 || !d1_objcurs)
		return;
	d = &d1_itmdefs[d1_equip_itm[slot]];
	D1CelDrawClipped(sx, sy, d1_objcurs,
		D1InvCurs(&d1_st_equip[slot], d1_equip_itm[slot]), d->gw * 28);
}

U0 D1InvDrawHand(I64 slot, I64 x1, I64 x2)
{//inv.cpp centers sub-2x3 weapons: narrow +14px, short -14px
	CD1ItmDef *d;
	I64	 sx;
	I64	 sy;

	if (d1_equip_itm[slot] < 0 || !d1_objcurs)
		return;
	d  = &d1_itmdefs[d1_equip_itm[slot]];
	sx = x2;
	if (d->gw == 1)
		sx = x1;
	sy = D1UiOrgY() + 160;
	if (d->gh != 3)
		sy = D1UiOrgY() + 146;
	D1CelDrawClipped(sx, sy, d1_objcurs,
		D1InvCurs(&d1_st_equip[slot], d1_equip_itm[slot]), d->gw * 28);
}

U0 D1InvDraw()
{
	I64	 c;
	I64	 e;
	I64	 uo = D1UiOrgX();
	I64	 uy = D1UiOrgY();
	I64	 ox = uo + D1_INV_X;
	CD1ItmDef *d;

	if (!d1_inv_open || !d1_inv_cel)
		return;

	D1CelDraw(ox, uy + 351, d1_inv_cel, 1, 320);

	if (d1_equip_itm[D1EQ_HEAD] >= 0)
		D1InvSlotBack(ox + 133, uy + 59, 56, 56);
	D1InvDrawEquip(D1EQ_HEAD, ox + 133, uy + 59);
	if (d1_equip_itm[D1EQ_BODY] >= 0)
		D1InvSlotBack(ox + 133, uy + 160, 56, 84);
	D1InvDrawEquip(D1EQ_BODY, ox + 133, uy + 160);
	if (d1_equip_itm[D1EQ_LEFT] >= 0)
		D1InvSlotBack(ox + 17, uy + 160, 56, 84);
	D1InvDrawHand(D1EQ_LEFT,  ox + 31,  ox + 17);
	if (d1_equip_itm[D1EQ_RIGHT] >= 0)
		D1InvSlotBack(ox + 247, uy + 160, 56, 84);
	D1InvDrawHand(D1EQ_RIGHT, ox + 261, ox + 249);

	for (c = 0; c < D1_MAXINV; c++)
	{
		if (d1_inv_grid[c] != 0)
			D1InvSlotBack(uo + d1_inv_gx[c % 10],
				uy + d1_inv_gy[c / 10] - 1, 28, 28);
	}

	if (d1_objcurs)
	{
		for (c = 0; c < D1_MAXINV; c++)
		{
			if (d1_inv_grid[c] > 0)
			{//anchor cell, icon spans up-right from it
				e = d1_inv_grid[c] - 1;
				d = &d1_itmdefs[d1_inv_itm[e]];
				D1CelDrawClipped(uo + d1_inv_gx[c % 10],
					uy + d1_inv_gy[c / 10] - 1,
					d1_objcurs, D1InvCurs(&d1_st_inv[e], d1_inv_itm[e]),
					d->gw * 28);
			}
		}
	}
}
