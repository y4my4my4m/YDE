// D1Mis.ZC - missiles
//
// position in 64ths of a tile; velocity added per 20Hz tick; a missile
// dies on walls, targets, or range-out. gfx are CL2 under Missiles\, named
// by misfiledata mAnimName (misdat.cpp:136): a file count of 1 is a single
// file, 8 or 16 is one file per facing suffixed 1..N.
//
// facing picks the best of 16 unit vectors by dot product in screen space;
// an 8-file set indexes with dir16 >> 1.
//
// missiles draw after the world pass - a missile crossing behind a wall
// draws over it, which the original avoids with per-cell insertion; not
// worth the sorting yet.
//
// missile ids, the damage school table and D1PlrHurt live in D1Mon, which
// is compiled first so the generated roster can name a caster's missile.

#define D1_MAXMIS		48

class CD1Mis
{
	I64	 type;
	I64	 px;			//tile * 64
	I64	 py;
	I64	 vx;			//per tick, 64ths of a tile
	I64	 vy;
	I64	 dir16;
	I64	 frame;
	I64	 owner;			//-1 player, else monster index
	I64	 dmg;			//64ths
	I64	 range;			//ticks left
	Bool active;
};

CD1Mis	d1_mis[D1_MAXMIS];
Bool	d1_mis_init = FALSE;

//one CL2 per facing per type, flat: type * 16 + facing
U8	*d1_mis_gfx[D1_NMISTYPE * 16];
I64	 d1_mis_nfr[D1_NMISTYPE];

//misfiledata mAnimName; a %d marks a per-facing set
U8 *d1_mis_file[D1_NMISTYPE] = {
	"Missiles\\Arrows.CL2",		//MFILE_ARROWS
	"Missiles\\Fireba%d.CL2",	//MFILE_FIREBA
	"Missiles\\Fireba%d.CL2",	//MFILE_FIREBA, Fireball shares the bolt gfx
	"Missiles\\Holy%d.CL2",		//MFILE_HOLY
	"Missiles\\Flare.CL2",		//MFILE_FLARE
	"Missiles\\Sklball%d.CL2",	//MFILE_SKLBALL
	"Missiles\\Firerun%d.CL2",	//MFILE_FIRERUN
	"Missiles\\Miniltng.CL2",	//MFILE_MINILTNG
	"Missiles\\Magball%d.CL2",	//MFILE_MAGBALL
	"Missiles\\Acidbf%d.CL2",	//MFILE_ACIDBF
	"Missiles\\Thinlght.CL2"};	//MFILE_THINLGHT

//misfiledata mAnimFAmt. Sklball ships 9 files; the ninth is the impact anim,
//which this port does not draw, so only 1..8 are the facings.
I64 d1_mis_ndir[D1_NMISTYPE] = {1, 16, 16, 16, 1, 8, 8, 1, 8, 16, 1};

//Arrows.CL2 holds one frame per facing instead of an animation
Bool d1_mis_dirframe[D1_NMISTYPE] = {TRUE, FALSE, FALSE, FALSE, FALSE, FALSE,
	FALSE, FALSE, FALSE, FALSE, FALSE};

//missiledata mResist (misdat.cpp:11)
I64 d1_mis_school[D1_NMISTYPE] = {D1RES_NONE, D1RES_FIRE, D1RES_FIRE,
	D1RES_NONE, D1RES_MAGIC, D1RES_MAGIC, D1RES_FIRE, D1RES_LIGHTNING,
	D1RES_FIRE, D1RES_ACID, D1RES_LIGHTNING};

//64ths of a tile per tick
I64 d1_mis_speed[D1_NMISTYPE] = {48, 32, 32, 40, 32, 32, 32, 40, 32, 32, 40};

//impact hits the eight neighbors for half (MI_Fireball, MI_Element)
Bool d1_mis_splash[D1_NMISTYPE] = {FALSE, FALSE, TRUE, FALSE, FALSE, FALSE,
	TRUE, FALSE, FALSE, FALSE, FALSE};

//misfiledata mAnimWidth
I64 d1_mis_width[D1_NMISTYPE] = {96, 96, 96, 96, 128, 96, 96, 64, 128, 96, 96};

//screen-space unit vectors for the 16 facings, 0 = south (down), clockwise,
//scaled by 256. screen y grows downward.
I64 d1_dir16_x[16] = {0, -98, -181, -237, -256, -237, -181, -98,
	0, 98, 181, 237, 256, 237, 181, 98};
I64 d1_dir16_y[16] = {256, 237, 181, 98, 0, -98, -181, -237,
	-256, -237, -181, -98, 0, 98, 181, 237};

U0 D1MisInit()
{
	I64 t;
	I64 d;
	I64 n;
	I64 size;
	U8	path[48];
	U8	*buf;

	if (d1_mis_init)
		return;

	for (t = 0; t < D1_MAXMIS; t++)
		d1_mis[t].active = FALSE;

	for (t = 0; t < D1_NMISTYPE; t++)
	{
		d1_mis_nfr[t] = 1;
		n = d1_mis_ndir[t];
		for (d = 0; d < 16; d++)
			d1_mis_gfx[t * 16 + d] = NULL;

		for (d = 0; d < n; d++)
		{
			if (n == 1)
				buf = D1MpqRead(d1_mis_file[t], &size);
			else
			{
				StrPrint(path, d1_mis_file[t], d + 1);
				buf = D1MpqRead(path, &size);
			}
			d1_mis_gfx[t * 16 + d] = buf;
			if (buf && d == 0)
				d1_mis_nfr[t] = D1CelNFrames(buf);
		}
	}

	d1_mis_init = TRUE;
}

U0 D1MisClear()
{
	I64 i;

	for (i = 0; i < D1_MAXMIS; i++)
		d1_mis[i].active = FALSE;
}

I64 D1MisDir16(I64 tdx, I64 tdy)
{//tile-space delta -> facing, via screen space
	I64 sdx = (tdx - tdy) * 2;		//screen dx ~ 32 * per-tile
	I64 sdy = tdx + tdy;			//screen dy ~ 16 * per-tile
	I64 best = 0;
	I64 best_d = 0x8000000000000000;
	I64 d;
	I64 i;

	for (i = 0; i < 16; i++)
	{
		d = sdx * d1_dir16_x[i] + sdy * d1_dir16_y[i];
		if (d > best_d)
		{
			best_d = d;
			best   = i;
		}
	}
	return best;
}

U0 D1MisSpawn(I64 type, I64 owner, I64 sx, I64 sy, I64 tx, I64 ty, I64 dmg)
{//from tile sx,sy toward tile tx,ty
	CD1Mis *ms = NULL;
	I64	 i;
	I64	 dx;
	I64	 dy;
	I64	 len;
	I64	 speed;

	D1MisInit;

	if (type < 0 || type >= D1_NMISTYPE)
		return;

	for (i = 0; i < D1_MAXMIS; i++)
	{
		if (!ms && !d1_mis[i].active)
			ms = &d1_mis[i];
	}
	if (!ms)
		return;
	if (sx == tx && sy == ty)
		ty++;

	dx = (tx - sx) * 64;
	dy = (ty - sy) * 64;
	len = 0;
	while ((len + 1) * (len + 1) <= dx * dx + dy * dy)
		len++;
	if (len < 1)
		len = 1;

	speed = d1_mis_speed[type];

	ms->type   = type;
	ms->px     = sx * 64 + 32;
	ms->py     = sy * 64 + 32;
	ms->vx     = (dx * speed) / len;
	ms->vy     = (dy * speed) / len;
	ms->dir16  = D1MisDir16(tx - sx, ty - sy);
	ms->frame  = 1;
	ms->owner  = owner;
	ms->dmg    = dmg;
	ms->range  = 48;
	ms->active = TRUE;
}

U0 D1MisHitPlayer(CD1Mis *ms)
{//ranged hit roll against the player
	I64 chance = 30 + 2 * d1_plr_lvl;
	CD1MonType *t;

	if (d1_plr_dead)
		return;
	if (ms->owner >= 0)
	{
		t = &d1_montypes[d1_mons[ms->owner].type];
		chance = 30 + t->hit + 2 * t->mlvl - 2 * d1_plr_lvl - d1_plr_dex / 2;
	}
	if (chance < 15)
		chance = 15;

	if (D1Rnd(100) < chance)
	{
		D1PlrHurt(ms->dmg);
		if (d1_opt_sfx)
		{
			if (D1SndRnd2())
				D1SndPlay("Sfx\\Warrior\\Wario69b.wav");
			else
				D1SndPlay("Sfx\\Warrior\\Warior69.wav");
		}
	}
}

Bool D1MisCanHit(I64 type, I64 mi)
{//MonsterMHit: Holy Bolt passes through anything that is not undead
	if (type != D1MIS_HOLY)
		return TRUE;
	if (d1_mons[mi].type == D1_MT_DIABLO)
		return TRUE;
	return ToBool(d1_montypes[d1_mons[mi].type].mclass == D1MC_UNDEAD);
}

U0 D1MisImpact(CD1Mis *ms, I64 mi, I64 tx, I64 ty)
{//apply a player missile's damage at the tile it died on
	I64 school = d1_mis_school[ms->type];
	I64 dmg    = ms->dmg;
	I64 d;
	I64 nx;
	I64 ny;
	I64 ni;

	if (mi >= 0)
	{
		//MI_Bonespirit: the spirit takes half of what the target has left
		if (ms->type == D1MIS_BONESPIRIT)
			dmg = d1_mons[mi].hp >> 1;
		D1MonHurtType(mi, dmg, school);
	}

	if (!d1_mis_splash[ms->type])
		return;

	for (d = 0; d < 8; d++)
	{
		nx = tx + d1_dir_dx[d];
		ny = ty + d1_dir_dy[d];
		ni = D1MonAtTile(nx, ny);
		if (ni >= 0 && ni != mi)
			D1MonHurtType(ni, ms->dmg >> 1, school);
	}
}

U0 D1MisTick()
{
	CD1Mis *ms;
	I64	 i;
	I64	 tx;
	I64	 ty;
	I64	 mi;

	for (i = 0; i < D1_MAXMIS; i++)
	{
		ms = &d1_mis[i];
		if (ms->active)
		{
			ms->px += ms->vx;
			ms->py += ms->vy;
			ms->range--;
			ms->frame++;
			if (ms->frame > d1_mis_nfr[ms->type])
				ms->frame = 1;

			tx = ms->px / 64;
			ty = ms->py / 64;

			if (ms->range <= 0 || !D1Walkable(tx, ty))
			{
				if (d1_mis_school[ms->type] == D1RES_FIRE && d1_opt_sfx)
					D1SndPlay("Sfx\\Misc\\Firimp2.wav");
				ms->active = FALSE;
			}
			else
			{
				if (ms->owner < 0)
				{//player missile: hits monsters
					mi = D1MonAtTile(tx, ty);
					if (mi >= 0 && D1MisCanHit(ms->type, mi))
					{
						D1MisImpact(ms, mi, tx, ty);
						if (d1_mis_school[ms->type] == D1RES_FIRE &&
							d1_opt_sfx)
							D1SndPlay("Sfx\\Misc\\Firimp2.wav");
						ms->active = FALSE;
					}
				}
				else if (tx == d1_plr_tile_x && ty == d1_plr_tile_y)
				{
					D1MisHitPlayer(ms);
					ms->active = FALSE;
				}
			}
		}
	}
}

U0 D1MisDrawAll()
{//after the world pass; positions map through the same camera transform
	CD1Mis *ms;
	I64	 i;
	I64	 rx;
	I64	 ry;
	I64	 sx;
	I64	 sy;
	I64	 n;
	I64	 f;
	U8	*buf;

	d1_shade = NULL;			//missiles glow

	for (i = 0; i < D1_MAXMIS; i++)
	{
		ms = &d1_mis[i];
		if (ms->active)
		{
			rx = ms->px - d1_view_x * 64 - 32;
			ry = ms->py - d1_view_y * 64 - 32;
			sx = d1_w / 2 + ((rx - ry) * 32) / 64 - d1_view_xoff;
			sy = d1_vp_h / 2 + ((rx + ry) * 16) / 64 - d1_view_yoff + 16;

			n = d1_mis_ndir[ms->type];
			if (n == 1)
				buf = d1_mis_gfx[ms->type * 16];
			else if (n == 8)
				buf = d1_mis_gfx[ms->type * 16 + (ms->dir16 >> 1)];
			else
				buf = d1_mis_gfx[ms->type * 16 + ms->dir16];

			f = ms->frame;
			if (d1_mis_dirframe[ms->type])
				f = ms->dir16 + 1;

			if (buf)
			{
				if (f > D1CelNFrames(buf))
					f = 1;
				D1Cl2Draw(sx - d1_mis_width[ms->type] / 2, sy, buf, f,
					d1_mis_width[ms->type]);
			}
		}
	}
}

U0 D1MisMonShoot(I64 mi)
{//ranged monster attack, hooked into d1_mon_shoot_cb. the missile is the
 //one its AI fires in monster.cpp (MAI_Magma MIS_MAGMABALL, MAI_Acid
 //MIS_ACID, MAI_Succ MIS_FLARE, MAI_Storm MIS_LIGHTCTRL2).
	CD1Mon	   *m = &d1_mons[mi];
	CD1MonType *t = &d1_montypes[m->type];
	I64 dmg = (t->dmin + D1Rnd(t->dmax - t->dmin + 1)) << 6;

	if (t->missile < 0)
		return;
	D1MisSpawn(t->missile, mi, m->x, m->y, d1_plr_tile_x, d1_plr_tile_y, dmg);
}

U0 D1MisHookInit()
{
	d1_mon_shoot_cb = &D1MisMonShoot;
}
