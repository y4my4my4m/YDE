// D1Mis.ZC - missiles: arrows and firebolts
//
// position in 64ths of a tile; velocity added per 20Hz tick; a missile
// dies on walls, targets, or range-out. gfx are CL2:
//   Missiles\Arrows.CL2      16 frames, one per facing, width 96
//   Missiles\Fireba1-16.CL2  one file per facing, 14 frames, width 96
//
// facing picks the best of 16 unit vectors by dot product in screen space.
// missiles draw after the world pass - a missile crossing behind a wall
// draws over it, which the original avoids with per-cell insertion; not
// worth the sorting yet.

#define D1_MAXMIS		48
#define D1MIS_ARROW		0
#define D1MIS_FIREBOLT	1

class CD1Mis
{
	I64	 type;
	I64	 px;			//tile * 64
	I64	 py;
	I64	 vx;			//per tick, 64ths of a tile
	I64	 vy;
	I64	 dir16;
	I64	 frame;			//firebolt anim
	I64	 owner;			//-1 player, else monster index
	I64	 dmg;			//64ths
	I64	 range;			//ticks left
	Bool active;
};

CD1Mis	d1_mis[D1_MAXMIS];
Bool	d1_mis_init = FALSE;

U8	*d1_mis_arrows = NULL;			//single CL2
U8	*d1_mis_fireba[16];				//one CL2 per facing

//screen-space unit vectors for the 16 facings, 0 = south (down), clockwise,
//scaled by 256. screen y grows downward.
I64 d1_dir16_x[16] = {0, -98, -181, -237, -256, -237, -181, -98,
	0, 98, 181, 237, 256, 237, 181, 98};
I64 d1_dir16_y[16] = {256, 237, 181, 98, 0, -98, -181, -237,
	-256, -237, -181, -98, 0, 98, 181, 237};

U0 D1MisInit()
{
	I64 i;
	I64 size;
	U8	path[40];

	if (d1_mis_init)
		return;

	for (i = 0; i < D1_MAXMIS; i++)
		d1_mis[i].active = FALSE;

	d1_mis_arrows = D1MpqRead("Missiles\\Arrows.CL2", &size);
	for (i = 0; i < 16; i++)
	{
		StrPrint(path, "Missiles\\Fireba%d.CL2", i + 1);
		d1_mis_fireba[i] = D1MpqRead(path, &size);
	}

	d1_mis_init = TRUE;
}

U0 D1MisClear()
{
	I64 i;

	for (i = 0; i < D1_MAXMIS; i++)
		d1_mis[i].active = FALSE;
}

I64 D1MisDir16(I64 tdx, I64 tdy)
{//tile-space delta -> facing, via screen space
	I64 sdx = (tdx - tdy) * 2;		//screen dx ~ 32 * per-tile
	I64 sdy = tdx + tdy;			//screen dy ~ 16 * per-tile
	I64 best = 0;
	I64 best_d = 0x8000000000000000;
	I64 d;
	I64 i;

	for (i = 0; i < 16; i++)
	{
		d = sdx * d1_dir16_x[i] + sdy * d1_dir16_y[i];
		if (d > best_d)
		{
			best_d = d;
			best   = i;
		}
	}
	return best;
}

U0 D1MisSpawn(I64 type, I64 owner, I64 sx, I64 sy, I64 tx, I64 ty, I64 dmg)
{//from tile sx,sy toward tile tx,ty
	CD1Mis *ms = NULL;
	I64	 i;
	I64	 dx;
	I64	 dy;
	I64	 len;
	I64	 speed;

	D1MisInit;

	for (i = 0; i < D1_MAXMIS; i++)
	{
		if (!ms && !d1_mis[i].active)
			ms = &d1_mis[i];
	}
	if (!ms)
		return;
	if (sx == tx && sy == ty)
		ty++;

	dx = (tx - sx) * 64;
	dy = (ty - sy) * 64;
	len = 0;
	while ((len + 1) * (len + 1) <= dx * dx + dy * dy)
		len++;
	if (len < 1)
		len = 1;

	speed = 48;					//64ths of a tile per tick
	if (type == D1MIS_FIREBOLT)
		speed = 32;

	ms->type   = type;
	ms->px     = sx * 64 + 32;
	ms->py     = sy * 64 + 32;
	ms->vx     = (dx * speed) / len;
	ms->vy     = (dy * speed) / len;
	ms->dir16  = D1MisDir16(tx - sx, ty - sy);
	ms->frame  = 1;
	ms->owner  = owner;
	ms->dmg    = dmg;
	ms->range  = 48;
	ms->active = TRUE;
}

U0 D1MisHitPlayer(CD1Mis *ms)
{//ranged hit roll against the player
	I64 chance = 30 + 2 * d1_plr_lvl;
	CD1MonType *t;

	if (d1_plr_dead)
		return;
	if (ms->owner >= 0)
	{
		t = &d1_montypes[d1_mons[ms->owner].type];
		chance = 30 + t->hit + 2 * t->mlvl - 2 * d1_plr_lvl - d1_plr_dex / 2;
	}
	if (chance < 15)
		chance = 15;

	if (D1Rnd(100) < chance)
	{
		d1_plr_hp -= ms->dmg;
		d1_plr_hitflash = 4;
		if (d1_plr_hp <= 0)
		{
			d1_plr_hp   = 0;
			d1_plr_dead = TRUE;
		}
	}
}

U0 D1MisTick()
{
	CD1Mis *ms;
	I64	 i;
	I64	 tx;
	I64	 ty;
	I64	 mi;

	for (i = 0; i < D1_MAXMIS; i++)
	{
		ms = &d1_mis[i];
		if (ms->active)
		{
			ms->px += ms->vx;
			ms->py += ms->vy;
			ms->range--;
			ms->frame++;
			if (ms->frame > 14)
				ms->frame = 1;

			tx = ms->px / 64;
			ty = ms->py / 64;

			if (ms->range <= 0 || !D1Walkable(tx, ty))
				ms->active = FALSE;
			else
			{
				if (ms->owner < 0)
				{//player missile: hits monsters
					mi = D1MonAtTile(tx, ty);
					if (mi >= 0)
					{
						D1MonHurt(mi, ms->dmg);
						ms->active = FALSE;
					}
				}
				else if (tx == d1_plr_tile_x && ty == d1_plr_tile_y)
				{
					D1MisHitPlayer(ms);
					ms->active = FALSE;
				}
			}
		}
	}
}

U0 D1MisDrawAll()
{//after the world pass; positions map through the same camera transform
	CD1Mis *ms;
	I64	 i;
	I64	 rx;
	I64	 ry;
	I64	 sx;
	I64	 sy;
	U8	*buf;

	d1_shade = NULL;			//missiles glow

	for (i = 0; i < D1_MAXMIS; i++)
	{
		ms = &d1_mis[i];
		if (ms->active)
		{
			rx = ms->px - d1_view_x * 64 - 32;
			ry = ms->py - d1_view_y * 64 - 32;
			sx = D1_W / 2 + ((rx - ry) * 32) / 64 - d1_view_xoff;
			sy = d1_vp_h / 2 + ((rx + ry) * 16) / 64 - d1_view_yoff + 16;

			if (ms->type == D1MIS_ARROW)
			{
				if (d1_mis_arrows)
					D1Cl2Draw(sx - 48, sy, d1_mis_arrows, ms->dir16 + 1, 96);
			}
			else
			{
				buf = d1_mis_fireba[ms->dir16];
				if (buf)
					D1Cl2Draw(sx - 48, sy, buf, ms->frame, 96);
			}
		}
	}
}

U0 D1MisMonShoot(I64 mi)
{//ranged monster arrow, hooked into d1_mon_shoot_cb
	CD1Mon	   *m = &d1_mons[mi];
	CD1MonType *t = &d1_montypes[m->type];
	I64 dmg = (t->dmin + D1Rnd(t->dmax - t->dmin + 1)) << 6;

	D1MisSpawn(D1MIS_ARROW, mi, m->x, m->y, d1_plr_tile_x, d1_plr_tile_y, dmg);
}

U0 D1MisHookInit()
{
	d1_mon_shoot_cb = &D1MisMonShoot;
}
