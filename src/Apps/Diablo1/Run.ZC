// Run.ZC - build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier one,
// so this order is load-bearing
//
//   D1Fmt    byte readers                (no deps)
//   D1Mpq    MPQ archive                 -> D1Fmt
//   D1Pal    palette + fades             -> D1Mpq
//   D1Rnd    game RNG                    (no deps)
//   D1Draw   8bpp canvas + window blit   -> D1Pal
//   D1Lvl    dungeon data + town         -> D1Fmt, D1Mpq, D1Pal
//   D1Light  shade tables + light grid   -> D1Lvl, D1Draw
//   D1Cel    CEL/CL2/PCX decode, font    -> D1Fmt, D1Mpq, D1Draw, D1Light
//   D1Menu   title + main menu           -> D1Pal, D1Draw, D1Cel
//   D1Drlg1  cathedral generation        -> D1Rnd, D1Lvl
//   D1Render dungeon world renderer      -> D1Lvl, D1Light, D1Cel
//   D1Mon    monsters + combat           -> D1Lvl, D1Cel, D1Rnd
//   D1Towner town NPCs                   -> D1Lvl, D1Cel
//   D1Play   player, melee, warps        -> D1Mon, D1Towner, D1Render
//   D1Panel  control panel + orbs        -> D1Cel, D1Mon
//   D1Test   data-layer self check       -> everything above
//   Diablo1  app shell + game loop       -> everything above

Cd(__DIR__);;

#include "D1Fmt"
#include "D1Mpq"
#include "D1Pal"
#include "D1Rnd"
#include "D1Draw"
#include "D1Lvl"
#include "D1Light"
#include "D1Cel"
#include "D1Menu"
#include "D1Drlg1"
#include "D1Drlg2"
#include "D1Drlg3"
#include "D1Drlg4"
#include "D1Render"
#include "D1Item"
#include "D1Obj"
#include "D1Mon"
#include "D1Mis"
#include "D1Towner"
#include "D1Play"
#include "D1Panel"
#include "D1Test"
#include "Diablo1"

Diablo1;

"\nType $$LTBLUE$$D1Test;$$FG$$ to run the data-layer self-check.\n";
