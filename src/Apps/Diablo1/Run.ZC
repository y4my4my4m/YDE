// build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier one,
// so the include order below is load-bearing.

Cd(__DIR__);;

#include "D1Fmt"
#include "D1Mpq"
#include "D1Pal"
#include "D1Rnd"
#include "D1Net"
#include "D1Snd"
#include "D1Draw"
