// engine.cpp SetRndSeed/GetRndSeed/random_
//
// Borland LCG: seed = seed * 0x015A4E35 + 1 in i32, result abs(seed).
// abs(INT_MIN) stays negative in i32.

I64 d1_seed = 0;

I64 D1Sext32(I64 v)
{
	v &= 0xFFFFFFFF;
	if (v & 0x80000000)
		v -= 0x100000000;
	return v;
}

U0 D1SetRndSeed(I64 s)
{
	d1_seed = D1Sext32(s);
}

I64 D1GetRndSeed()
{
	I64 v;

	d1_seed = D1Sext32(d1_seed * 0x015A4E35 + 1);
	v = d1_seed;
	if (v < 0)
		v = D1Sext32(-v);
	return v;
}

I64 D1Rnd(I64 v)
{//random_; idx arg unused
	if (v <= 0)
		return 0;
	if (v < 0xFFFF)
		return (D1GetRndSeed() >> 16) % v;
	return D1GetRndSeed() % v;
}
