// D1Rnd.ZC - the game RNG (engine.cpp SetRndSeed/GetRndSeed/random_)
//
// Borland LCG: seed = seed * 0x015A4E35 + 1 in i32 arithmetic, result is
// abs(seed). i32 wraparound is load-bearing - dungeon layout is a pure
// function of the seed sequence - so every step is wrapped to 32 bits.
// abs(INT_MIN) stays negative in i32; kept.

I64 d1_seed = 0;

I64 D1Sext32(I64 v)
{
	v &= 0xFFFFFFFF;
	if (v & 0x80000000)
		v -= 0x100000000;
	return v;
}

U0 D1SetRndSeed(I64 s)
{
	d1_seed = D1Sext32(s);
}

I64 D1GetRndSeed()
{//abs of the new seed, in i32 semantics
	I64 v;

	d1_seed = D1Sext32(d1_seed * 0x015A4E35 + 1);
	v = d1_seed;
	if (v < 0)
		v = D1Sext32(-v);
	return v;
}

I64 D1Rnd(I64 v)
{//0 .. v-1 (random_; the idx arg was unused)
	if (v <= 0)
		return 0;
	if (v < 0xFFFF)
		return (D1GetRndSeed() >> 16) % v;
	return D1GetRndSeed() % v;
}
