// player: warrior, walking, melee, death, level transitions
//
// facing directions and tile steps are d1_dir_dx/dy (D1Lvl).
// gfx sets ("wls" = warrior, light armor, sword+shield): town ST/WL, dungeon
// AS/AW/AT/HT/DT (player.cpp suffix table). the attack lands on frame 9
// (warrior _pAFNum). walking is 8 ticks per tile at 20Hz.
//
// anim rates are player.cpp NewPlrAnim Delay values. ProcessPlayers advances on
// _pAnimCnt > _pAnimDelay, so a frame lasts Delay + 1 game ticks: stand 4,
// death 2, walk and attack 1.

#define D1PM_STAND		0
#define D1PM_WALK		1
#define D1PM_ATTACK		2
#define D1PM_DEATH		3
#define D1PM_HIT		4

#define D1_WALK_TICKS	8
#define D1_PATH_MAX		96
#define D1_PLR_AFNUM	9

#define D1_STAND_DELAY	3
#define D1_DEATH_DELAY	1
#define D1_HIT_DELAY	0		//StartPlrHit NewPlrAnim delay 0

#define D1PG_ST	0
#define D1PG_WL	1
#define D1PG_AS	2
#define D1PG_AW	3
#define D1PG_AT	4
#define D1PG_HT	5
#define D1PG_DT	6

I64	 d1_plr_x     = 75;
I64	 d1_plr_y     = 68;
I64	 d1_plr_dir   = 0;
I64	 d1_plr_mode  = D1PM_STAND;
I64	 d1_plr_frame = 1;
I64	 d1_plr_animcnt = 0;
I64	 d1_plr_step  = 0;
I64	 d1_plr_xoff  = 0;
I64	 d1_plr_yoff  = 0;
I64	 d1_plr_target = -1;
I64	 d1_plr_atx = 0;
I64	 d1_plr_aty = 0;
I64	 d1_plr_deadtime = 0;

U8	*d1_plr_gfx[7] = {NULL, NULL, NULL, NULL, NULL, NULL, NULL};
Bool d1_plr_gfx_init = FALSE;
I64	 d1_plr_gfx_class = -1;
U8	 d1_plr_wep[4] = "s";

I64	 d1_path[D1_PATH_MAX];
I64	 d1_path_len  = 0;
I64	 d1_path_pos  = 0;

I64	 d1_warp_to   = -1;				//-1 none, 0 town, 1-4 cathedral
I64	 d1_warp_entry = 0;				//0 = arriving from above, 1 = from below

I64	 d1_lvl_seeds[17];
Bool d1_seeds_init = FALSE;

Bool d1_play_ready = FALSE;

I64 d1_plr_obj_x = -1;
I64 d1_plr_obj_y = -1;

I64 d1_plr_talk_x = -1;
I64 d1_plr_talk_y = -1;
U8	*d1_talk_txt   = NULL;
I64	 d1_talk_timer = 0;

I64 D1GetDir(I64 dx, I64 dy)
{
	if (dx > 0)
	{
		if (dy > 0)  return 0;
		if (dy < 0)  return 6;
		return 7;
	}
	if (dx < 0)
	{
		if (dy > 0)  return 2;
		if (dy < 0)  return 4;
		return 3;
	}
	if (dy > 0)  return 1;
	if (dy < 0)  return 5;
	return d1_plr_dir;
}

Bool D1StepOk(I64 x, I64 y, I64 dir)
{
	I64 nx = x + d1_dir_dx[dir];
	I64 ny = y + d1_dir_dy[dir];

	if (!D1WalkableM(nx, ny))
		return FALSE;
	if (D1ObjBlocks(nx, ny))
		return FALSE;
	if (d1_dir_dx[dir] && d1_dir_dy[dir])
	{
		if (!D1Walkable(x + d1_dir_dx[dir], y))
			return FALSE;
		if (!D1Walkable(x, y + d1_dir_dy[dir]))
			return FALSE;
	}
	return TRUE;
}

I32 d1_bfs_prev[D1_MAXDUN * D1_MAXDUN];
I32 d1_bfs_queue[D1_MAXDUN * D1_MAXDUN];

Bool D1PathFind(I64 sx, I64 sy, I64 tx, I64 ty, Bool adjacent_ok)
{
	I64 head = 0;
	I64 tail = 0;
	I64 cur;
	I64 cx;
	I64 cy;
	I64 d;
	I64 nx;
	I64 ny;
	I64 n;
	I64 i;
	I64 goal = -1;
	I64 dx;
	I64 dy;
	I64 steps[D1_PATH_MAX];

	d1_path_len = 0;
	d1_path_pos = 0;

	if (tx == sx && ty == sy)
		return FALSE;
	if (!adjacent_ok && !D1Walkable(tx, ty))
		return FALSE;

	//path.cpp A* first; BFS below covers walks past its 24-step cap
	i = D1AStar(sx, sy, tx, ty, adjacent_ok, d1_path, D1_PATH_MAX);
	if (i > 0)
	{
		d1_path_len = i;
		return TRUE;
	}

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_bfs_prev[i] = -1;

	cur = sx + sy * D1_MAXDUN;
	d1_bfs_prev[cur]     = cur;
	d1_bfs_queue[tail++] = cur;

	while (head < tail)
	{
		cur = d1_bfs_queue[head++];
		cx  = cur % D1_MAXDUN;
		cy  = cur / D1_MAXDUN;

		if (cx == tx && cy == ty)
		{
			goal = cur;
			break;
		}
		if (adjacent_ok)
		{
			dx = tx - cx;
			dy = ty - cy;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				goal = cur;
				break;
			}
		}

		for (d = 0; d < 8; d++)
		{
			if (D1StepOk(cx, cy, d))
			{
				nx = cx + d1_dir_dx[d];
				ny = cy + d1_dir_dy[d];
				n  = nx + ny * D1_MAXDUN;
				if (d1_bfs_prev[n] < 0)
				{
					d1_bfs_prev[n]       = cur;
					d1_bfs_queue[tail++] = n;
				}
			}
		}
	}

	if (goal < 0)
		return FALSE;
	if (goal == sx + sy * D1_MAXDUN)
		return TRUE;

	n = goal;
	i = 0;
	while (n != sx + sy * D1_MAXDUN && i < D1_PATH_MAX)
	{
		cur = d1_bfs_prev[n];
		steps[i] = D1GetDir(n % D1_MAXDUN - cur % D1_MAXDUN,
							n / D1_MAXDUN - cur / D1_MAXDUN);
		n = cur;
		i++;
	}
	if (n != sx + sy * D1_MAXDUN)
		return FALSE;

	d1_path_len = i;
	for (d = 0; d < i; d++)
		d1_path[d] = steps[i - 1 - d];

	return TRUE;
}

U8 *D1PlrGrp(I64 slot)
{
	if (!d1_plr_gfx[slot])
		return NULL;
	return D1Cl2Dir(d1_plr_gfx[slot], d1_plr_dir);
}

I64 D1PlrGfxSlotStand()
{
	if (d1_currlevel == 0)
		return D1PG_ST;
	return D1PG_AS;
}

I64 D1PlrGfxSlotWalk()
{
	if (d1_currlevel == 0)
		return D1PG_WL;
	return D1PG_AW;
}

I64 D1WalkTicks()
{
	if (d1_currlevel == 0 && d1_opt_jog)
		return 5;
	return D1_WALK_TICKS;
}

Bool D1PlrHasBow()
{
	I64 itm = d1_equip_itm[D1EQ_LEFT];

	return ToBool(itm >= 0 && D1ItmIsBow(itm));
}

I64 D1PlrGfxW(I64 slot)
{
	if (slot == D1PG_DT)
		return 128;
	if (slot == D1PG_AT)
	{
		if (D1PlrHasBow())
			return 96;
		return 128;
	}
	return 96;
}

U8 *D1PlrWepCode()
{//items.cpp CalcPlrItemVals → WepChar letter (lowercase path form).
	I64 itm = d1_equip_itm[D1EQ_LEFT];
	I64 drop;
	Bool shield;

	if (itm < 0)
	{
		if (d1_equip_itm[D1EQ_RIGHT] >= 0)
			return "u";
		return "n";
	}
	drop   = d1_itmdefs[itm].drop;
	shield = ToBool(d1_equip_itm[D1EQ_RIGHT] >= 0);
	if (drop == 16)
		return "b";
	if (drop == 17 || d1_itmdefs[itm].stf)
		return "t";
	if (drop == 14)
		return "a";
	if (drop == 15)
	{
		if (shield)
			return "h";
		return "m";
	}
	if (shield)
		return "d";
	return "s";
}

I64 D1PlrAFNum()
{
	if (D1PlrHasBow())
	{
		if (d1_plr_class == D1CL_ROGUE)
			return 7;
		return 11;
	}
	return D1_PLR_AFNUM;
}

U0 D1WalkStart(I64 dir)
{//player.cpp StartWalk
	d1_plr_futx  = d1_plr_x + d1_dir_dx[dir];
	d1_plr_futy  = d1_plr_y + d1_dir_dy[dir];
	d1_plr_dir   = dir;
	d1_plr_mode  = D1PM_WALK;
	d1_plr_step  = 0;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
}

U0 D1PlrWalkSfx(I64 oldf, I64 newf, I64 nf)
{
 //(Walk2-4 exist in the table but are never picked).
	if (!d1_opt_sfx)
		return;
	if (newf == oldf)
		return;
	if (newf == 3 || (nf == 8 && newf == 7) || (nf != 8 && newf == 4))
		D1SndPlay("Sfx\\Misc\\Walk1.wav");
}

U0 D1AttackStart(I64 dir)
{
	d1_plr_dir   = dir;
	d1_plr_mode  = D1PM_ATTACK;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	if (D1PlrHasBow())
		return;
	if (d1_opt_sfx)
	{
		if (D1SndRnd2())
			D1SndPlay("Sfx\\Misc\\Swing2.wav");
		else
			D1SndPlay("Sfx\\Misc\\Swing.wav");
	}
}

U0 D1RangeAttackStart(I64 dir, I64 tx, I64 ty)
{
	d1_plr_atx = tx;
	d1_plr_aty = ty;
	D1AttackStart(dir);
}

U0 D1PlayerArrowFire()
{
	I64 slot;

	slot = D1MisSpawn(D1MIS_ARROW, -1, d1_plr_x, d1_plr_y,
		d1_plr_atx, d1_plr_aty, 0);
	D1MisSetDamRange(slot, D1InvDmgMin(), D1InvDmgMax());
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Misc\\BFire.wav");
	D1DurBowHit;
}

U0 D1PlayClickTo(I64 tx, I64 ty)
{
	I64 mi;
	I64 ti;
	I64 oi;
	I64 ii;
	I64 dx;
	I64 dy;

	if (!d1_play_ready || d1_plr_dead)
		return;

	if (d1_net_on)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
		{
			D1NetQueue(D1NC_STAND, tx, ty, 0);
			return;
		}
		mi = D1MonAtCurs(tx, ty);
		if (mi >= 0)
		{
			D1NetQueue(D1NC_ATTACK, mi, 0, 0);
			return;
		}
		ii = D1ItemAtCurs(tx, ty);
		if (ii >= 0)
		{
			D1NetQueue(D1NC_PICKUP, d1_items[ii].x, d1_items[ii].y, 0);
			return;
		}
		oi = D1ObjAtCurs(tx, ty);
		if (oi >= 0)
		{
			D1NetQueue(D1NC_OPEN, d1_objs[oi].x, d1_objs[oi].y, 0);
			return;
		}
		D1NetQueue(D1NC_WALK, tx, ty, 0);
		return;
	}

	if (Bt(kbd.down_bitmap, SC_SHIFT))
	{
		d1_plr_target = -1;
		d1_plr_obj_x  = -1;
		d1_path_len   = 0;
		d1_path_pos   = 0;
		mi = D1MonAtCurs(tx, ty);
		if (mi >= 0)
			d1_plr_target = mi;
		if (d1_plr_mode == D1PM_STAND)
		{
			if (D1PlrHasBow())
			{
				if (mi >= 0)
					D1RangeAttackStart(
						D1GetDir(d1_mons[mi].x - d1_plr_x,
							d1_mons[mi].y - d1_plr_y),
						d1_mons[mi].x, d1_mons[mi].y);
				else
					D1RangeAttackStart(D1GetDir(tx - d1_plr_x, ty - d1_plr_y),
						tx, ty);
			}
			else
				D1AttackStart(D1GetDir(tx - d1_plr_x, ty - d1_plr_y));
		}
		return;
	}

	mi = D1MonAtCurs(tx, ty);
	if (mi >= 0)
	{
		d1_plr_target = mi;
		d1_plr_obj_x  = -1;
		if (D1PlrHasBow())
		{
			d1_path_len = 0;
			d1_path_pos = 0;
			if (d1_plr_mode == D1PM_STAND)
				D1RangeAttackStart(
					D1GetDir(d1_mons[mi].x - d1_plr_x,
						d1_mons[mi].y - d1_plr_y),
					d1_mons[mi].x, d1_mons[mi].y);
			return;
		}
		D1PathFind(d1_plr_x, d1_plr_y, d1_mons[mi].x, d1_mons[mi].y, TRUE);
		return;
	}

	d1_plr_target = -1;

	if (d1_currlevel == 0)
	{
		ti = D1TownerAtCurs(tx, ty);
		if (ti >= 0)
		{
			d1_plr_talk_x = d1_twn[ti].x;
			d1_plr_talk_y = d1_twn[ti].y;
			d1_plr_obj_x  = -1;
			dx = d1_plr_talk_x - d1_plr_x;
			dy = d1_plr_talk_y - d1_plr_y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				d1_plr_dir = D1GetDir(dx, dy);
				if (!D1TownerUse(ti))
				{
					d1_talk_txt   = D1TownerQuote(ti);
					d1_talk_timer = 80;
				}
				d1_plr_talk_x = -1;
				return;
			}
			if (!D1PathFind(d1_plr_x, d1_plr_y, d1_plr_talk_x,
				d1_plr_talk_y, TRUE))
				d1_plr_talk_x = -1;
			return;
		}
	}
	d1_plr_talk_x = -1;

	ii = D1ItemAtCurs(tx, ty);
	if (ii >= 0)
	{
		d1_plr_obj_x = -1;
		tx = d1_items[ii].x;
		ty = d1_items[ii].y;
		if (tx == d1_plr_x && ty == d1_plr_y)
		{
			D1ItemPickup(tx, ty);
			return;
		}
		D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
		return;
	}

	oi = D1ObjAtCurs(tx, ty);
	if (oi >= 0)
	{
		tx = d1_objs[oi].x;
		ty = d1_objs[oi].y;
		d1_plr_obj_x = tx;
		d1_plr_obj_y = ty;
		dx = tx - d1_plr_x;
		dy = ty - d1_plr_y;
		if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
		{
			d1_plr_dir = D1GetDir(dx, dy);
			if (D1ObjIsBreakable(oi))
				D1AttackStart(d1_plr_dir);
			else
				D1ObjOperate(tx, ty, d1_currlevel);
			d1_plr_obj_x = -1;
			return;
		}
		if (!D1PathFind(d1_plr_x, d1_plr_y, tx, ty, TRUE))
			d1_plr_obj_x = -1;
		return;
	}

	d1_plr_obj_x = -1;
	D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
}

U0 D1PlayHeldWalk(I64 tx, I64 ty)
{//diablo.cpp sgbMouseDown
	if (!d1_play_ready || d1_plr_dead)
		return;
	if (d1_net_on)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			return;
		if (D1MonAtCurs(tx, ty) >= 0)
			return;
		if (D1ObjBlocks(tx, ty))
			return;
		if (tx == d1_plr_x && ty == d1_plr_y)
			return;
		D1NetQueue(D1NC_WALK, tx, ty, 0);
		return;
	}
	if (d1_plr_mode != D1PM_STAND)
		return;
	if (d1_path_pos < d1_path_len)
		return;
	if (Bt(kbd.down_bitmap, SC_SHIFT))
		return;
	if (D1MonAtCurs(tx, ty) >= 0)
		return;
	if (d1_currlevel == 0 && D1TownerAtCurs(tx, ty) >= 0)
		return;
	if (D1ObjBlocks(tx, ty))
		return;
	if (tx == d1_plr_x && ty == d1_plr_y)
		return;
	d1_plr_target = -1;
	d1_plr_obj_x  = -1;
	d1_plr_talk_x = -1;
	D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
}

I64 D1PlayerHitChance(I64 mi)
{//PlrHitMonst (player.cpp:2876): hper = (dex>>1) + level + 50 - mArmorClass,
 //+20 for the Warrior, plus _pIBonusToHit, clamped 5..95
	I64 hper = 50 + (d1_plr_dex >> 1) + d1_plr_lvl -
		d1_montypes[d1_mons[mi].type].ac;

	if (d1_plr_class == D1CL_WARRIOR)
		hper += 20;
	hper += D1PowToHit();
	if (hper < 5)
		hper = 5;
	if (hper > 95)
		hper = 95;
	return hper;
}

U0 D1PlayerAttackRoll(I64 mi)
{
	CD1Mon *m = &d1_mons[mi];
	I64 hper = D1PlayerHitChance(mi);
	I64 hit = D1Rnd(100);
	I64 dmg;

	if (m->stone > 0)
		hit = 0;

	if (hit < hper)
	{
		dmg = D1InvDmgMin() + D1Rnd(D1InvDmgMax() - D1InvDmgMin() + 1) +
			D1PlrDamageMod();
		D1MonHurt(mi, dmg << 6);
		D1DurWeaponHit;
	}
}

U0 D1PlayerDie()
{
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Misc\\Dead.wav");
	d1_plr_mode     = D1PM_DEATH;
	d1_plr_frame    = 1;
	d1_plr_animcnt  = 0;
	d1_plr_deadtime = 0;
	d1_path_len     = 0;
	d1_path_pos     = 0;
	d1_plr_target   = -1;
}

U0 D1CheckTriggers()
{
	if (d1_currlevel == 0)
	{
		if (d1_plr_x == 25 && d1_plr_y == 29)
		{
			d1_warp_to    = 1;
			d1_warp_entry = 0;
		}
	}
	else
	{
		if (d1_plr_x == d1_trig_up_x && d1_plr_y == d1_trig_up_y)
		{
			d1_warp_to    = d1_currlevel - 1;
			d1_warp_entry = 1;
		}
		if (d1_plr_x == d1_trig_down_x && d1_plr_y == d1_trig_down_y)
		{
			if (d1_currlevel < 16)
			{
				d1_warp_to    = d1_currlevel + 1;
				d1_warp_entry = 0;
			}
		}
	}
}

U8 d1_trig_label[32];

U8 *D1TrigLabelAt(I64 tx, I64 ty)
{//trigs.cpp CheckTriggers strings for the tile under the cursor
	if (d1_currlevel == 0)
	{
		if (tx == 25 && ty == 29)
			return "Down to dungeon";
		return NULL;
	}
	if (tx == d1_trig_up_x && ty == d1_trig_up_y)
	{
		if (d1_currlevel == 1)
			return "Up to town";
		StrPrint(d1_trig_label, "Up to level %d", d1_currlevel - 1);
		return d1_trig_label;
	}
	if (tx == d1_trig_down_x && ty == d1_trig_down_y && d1_currlevel < 16)
	{
		StrPrint(d1_trig_label, "Down to level %d", d1_currlevel + 1);
		return d1_trig_label;
	}
	return NULL;
}

//player.cpp ExpLvlsTbl, first entries; level cap where the table ends
I64 d1_exp_tbl[10] = {0, 2000, 4620, 8040, 12489, 18258, 25712, 35309,
	47622, 63364};

U0 D1PlayerLevelUp()
{
	d1_plr_lvl++;
	d1_plr_pts += 5;
	D1CharRecalc;
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_mana = d1_plr_maxmana;
	if (d1_opt_sfx)
	{
		D1SndPlay("Sfx\\Items\\Invharm.wav");
		D1SndPlay("Sfx\\Items\\Invsign.wav");
	}
	d1_talk_txt   = "You have gained a level!";
	d1_talk_timer = 100;
}

U0 D1PlayerXPCheck()
{
	while (d1_plr_lvl < 10 && d1_plr_exp >= d1_exp_tbl[d1_plr_lvl])
		D1PlayerLevelUp;
}

U0 D1PlayCastFirebolt(I64 tx, I64 ty)
{//right-click spell; costs 6 mana
	I64 dmg;

	if (!d1_play_ready || d1_plr_dead || d1_currlevel == 0)
		return;
	if (d1_plr_mana < 6 << 6)
		return;

	d1_plr_mana -= 6 << 6;
	d1_plr_dir = D1GetDir(tx - d1_plr_x, ty - d1_plr_y);
	dmg = (2 + D1Rnd(8) + d1_plr_lvl) << 6;
	D1MisSpawn(D1MIS_FIREBOLT, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Misc\\Fbolt1.wav");
}

U8 *D1PlrGfxNameW(U8 *dst, U8 *wep, U8 *suffix)
{
	StrPrint(dst, "PlrGFX\\%s\\%sl%s\\%sl%s%s.cl2",
		d1_cls_dir[d1_plr_class], d1_cls_code[d1_plr_class], wep,
		d1_cls_code[d1_plr_class], wep, suffix);
	return dst;
}

U8 *D1PlrGfxName(U8 *dst, U8 *suffix)
{
	return D1PlrGfxNameW(dst, D1PlrWepCode(), suffix);
}

U0 D1PlrGfxUnload()
{
	I64 i;
	U8 *p;

	for (i = 0; i < 7; i++)
	{
		p = d1_plr_gfx[i];
		d1_plr_gfx[i] = NULL;
		if (p)
			Free(p);
	}
	d1_plr_gfx_init = FALSE;
}

Bool D1PlrGfxTryLoad(U8 *wep)
{
	I64 size = 0;
	U8 path[64];
	I64 i;
	U8 *tmp[7];

	for (i = 0; i < 7; i++)
		tmp[i] = NULL;
	tmp[D1PG_ST] = D1MpqRead(D1PlrGfxNameW(path, wep, "st"), &size);
	tmp[D1PG_WL] = D1MpqRead(D1PlrGfxNameW(path, wep, "wl"), &size);
	tmp[D1PG_AS] = D1MpqRead(D1PlrGfxNameW(path, wep, "as"), &size);
	tmp[D1PG_AW] = D1MpqRead(D1PlrGfxNameW(path, wep, "aw"), &size);
	tmp[D1PG_AT] = D1MpqRead(D1PlrGfxNameW(path, wep, "at"), &size);
	tmp[D1PG_HT] = D1MpqRead(D1PlrGfxNameW(path, wep, "ht"), &size);
	tmp[D1PG_DT] = D1MpqRead(D1PlrGfxNameW(path, "n", "dt"), &size);
	if (!tmp[D1PG_ST] || !tmp[D1PG_WL])
	{
		for (i = 0; i < 7; i++)
		{
			if (tmp[i])
				Free(tmp[i]);
		}
		return FALSE;
	}
	for (i = 0; i < 7; i++)
		d1_plr_gfx[i] = tmp[i];
	d1_plr_wep[0] = wep[0];
	d1_plr_wep[1] = 0;
	d1_plr_gfx_init  = TRUE;
	d1_plr_gfx_class = d1_plr_class;
	return TRUE;
}

Bool D1PlrGfxEnsure()
{
	U8 *want;
	Bool dirty;

	want  = D1PlrWepCode();
	dirty = d1_wep_gfx_dirty;
	d1_wep_gfx_dirty = FALSE;

	if (!dirty && d1_plr_gfx_init && d1_plr_wep[0] == want[0] &&
		d1_plr_gfx_class == d1_plr_class)
		return TRUE;

	D1PlrGfxUnload;
	if (D1PlrGfxTryLoad(want))
		return TRUE;
	if (want[0] == 'd' && D1PlrGfxTryLoad("s"))
		return TRUE;
	if ((want[0] == 'b' || want[0] == 't' || want[0] == 'a' ||
		want[0] == 'm' || want[0] == 'h' || want[0] == 'u') &&
		D1PlrGfxTryLoad("n"))
		return TRUE;
	return FALSE;
}

U0 D1PlayTick()
{//20Hz game tick
	I64	 dir;
	I64	 nf;
	I64	 dx;
	I64	 dy;
	I64	 oi;
	I64	 dam;
	I64	 ticks;
	I64	 prog;
	I64	 oldf;
	U8	*grp;

	if (!d1_play_ready)
		return;

	if (d1_wep_gfx_dirty)
		D1PlrGfxEnsure;

	D1FloatTick;

	if (d1_plr_dead && d1_plr_mode != D1PM_DEATH)
		D1PlayerDie;

	d1_plr_tile_x = d1_plr_x;
	d1_plr_tile_y = d1_plr_y;
	if (d1_plr_mode != D1PM_WALK)
	{
		d1_plr_futx = d1_plr_x;
		d1_plr_futy = d1_plr_y;
	}

	if (d1_plr_hitpend > 0)
	{
		dam = d1_plr_hitpend;
		d1_plr_hitpend = 0;
		if (!d1_plr_dead && (dam >> 6) >= d1_plr_lvl &&
			d1_plr_mode != D1PM_DEATH)
		{
			d1_plr_mode    = D1PM_HIT;
			d1_plr_frame   = 1;
			d1_plr_animcnt = 0;
			d1_plr_step    = 0;
			d1_plr_xoff    = 0;
			d1_plr_yoff    = 0;
			d1_path_len    = 0;
			d1_path_pos    = 0;
		}
	}

	if (d1_plr_hitflash > 0)
		d1_plr_hitflash--;
	if (d1_talk_timer > 0)
		d1_talk_timer--;

	if (d1_plr_mode == D1PM_DEATH)
	{
		grp = D1PlrGrp(D1PG_DT);
		if (grp)
		{
			nf = D1CelNFrames(grp);
			d1_plr_animcnt++;
			if (d1_plr_animcnt > D1_DEATH_DELAY)
			{
				d1_plr_animcnt = 0;
				if (d1_plr_frame < nf)
					d1_plr_frame++;
			}
		}
		d1_plr_deadtime++;
		if (d1_plr_deadtime > 60)
		{
			d1_plr_hp   = d1_plr_maxhp;
			d1_plr_dead = FALSE;
			d1_plr_mode = D1PM_STAND;
			d1_plr_frame   = 1;
			d1_plr_animcnt = 0;
			d1_warp_to  = 0;
			d1_warp_entry = 0;
		}
		return;
	}

	if (d1_plr_mode == D1PM_STAND && d1_path_pos < d1_path_len)
	{
		dir = d1_path[d1_path_pos];
		if (D1StepOk(d1_plr_x, d1_plr_y, dir))
		{
			d1_path_pos++;
			D1WalkStart(dir);
		}
		else
		{
			d1_path_len = 0;
			d1_path_pos = 0;
		}
	}

	if (d1_plr_mode == D1PM_STAND && d1_plr_target >= 0)
	{
		if (D1MonAtTile(d1_mons[d1_plr_target].x,
			d1_mons[d1_plr_target].y) != d1_plr_target)
			d1_plr_target = -1;
		else if (D1PlrHasBow())
		{
			D1RangeAttackStart(
				D1GetDir(d1_mons[d1_plr_target].x - d1_plr_x,
					d1_mons[d1_plr_target].y - d1_plr_y),
				d1_mons[d1_plr_target].x, d1_mons[d1_plr_target].y);
		}
		else
		{
			dx = d1_mons[d1_plr_target].x - d1_plr_x;
			dy = d1_mons[d1_plr_target].y - d1_plr_y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
				D1AttackStart(D1GetDir(dx, dy));
			else if (d1_path_pos >= d1_path_len)
				D1PathFind(d1_plr_x, d1_plr_y, d1_mons[d1_plr_target].x,
					d1_mons[d1_plr_target].y, TRUE);
		}
	}

	if (d1_plr_mode == D1PM_ATTACK)
	{
		grp = D1PlrGrp(D1PG_AT);
		nf  = 16;
		if (grp)
			nf = D1CelNFrames(grp);
		d1_plr_frame++;
		if (d1_plr_frame == D1PlrAFNum())
		{
			if (D1PlrHasBow())
			{
				if (d1_plr_target >= 0)
				{
					d1_plr_atx = d1_mons[d1_plr_target].x;
					d1_plr_aty = d1_mons[d1_plr_target].y;
				}
				D1PlayerArrowFire;
			}
			else if (d1_plr_target >= 0)
			{
				dx = d1_mons[d1_plr_target].x - d1_plr_x;
				dy = d1_mons[d1_plr_target].y - d1_plr_y;
				if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
					D1PlayerAttackRoll(d1_plr_target);
			}
			else
				D1ObjHitAt(d1_plr_x + d1_dir_dx[d1_plr_dir],
					d1_plr_y + d1_dir_dy[d1_plr_dir]);
		}
		if (d1_plr_frame > nf)
		{
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
		}
	}
	else if (d1_plr_mode == D1PM_WALK)
	{
		dx = d1_dir_dx[d1_plr_dir];
		dy = d1_dir_dy[d1_plr_dir];
		grp = D1PlrGrp(D1PlrGfxSlotWalk());
		nf  = 8;
		if (grp)
			nf = D1CelNFrames(grp);
		if (nf < 1)
			nf = 1;
		ticks = nf;
		if (D1WalkTicks() < nf)
			ticks = D1WalkTicks();

		d1_plr_step++;
		prog = d1_plr_step;
		if (prog > ticks)
			prog = ticks;
		d1_plr_xoff = (32 * (dx - dy) * prog) / ticks;
		d1_plr_yoff = (16 * (dx + dy) * prog) / ticks;
		oldf = d1_plr_frame;
		d1_plr_frame = 1 + ((prog - 1) * nf) / ticks;
		if (d1_plr_frame < 1)
			d1_plr_frame = 1;
		if (d1_plr_frame > nf)
			d1_plr_frame = nf;
		D1PlrWalkSfx(oldf, d1_plr_frame, nf);

		if (d1_plr_step >= ticks)
		{
			d1_plr_x    += d1_dir_dx[d1_plr_dir];
			d1_plr_y    += d1_dir_dy[d1_plr_dir];
			d1_plr_xoff  = 0;
			d1_plr_yoff  = 0;
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
			d1_plr_step  = 0;
			d1_plr_tile_x = d1_plr_x;
			d1_plr_tile_y = d1_plr_y;
			D1PlrDoTrans(d1_plr_x, d1_plr_y);
			D1ItemAutoPickup(d1_plr_x, d1_plr_y);
			if (d1_plr_obj_x >= 0 &&
				d1_plr_obj_x >= d1_plr_x - 1 && d1_plr_obj_x <= d1_plr_x + 1 &&
				d1_plr_obj_y >= d1_plr_y - 1 && d1_plr_obj_y <= d1_plr_y + 1)
			{
				d1_plr_dir = D1GetDir(d1_plr_obj_x - d1_plr_x,
					d1_plr_obj_y - d1_plr_y);
				oi = D1ObjAtTile(d1_plr_obj_x, d1_plr_obj_y);
				if (D1ObjIsBreakable(oi))
					D1AttackStart(d1_plr_dir);
				else
					D1ObjOperate(d1_plr_obj_x, d1_plr_obj_y, d1_currlevel);
				d1_plr_obj_x = -1;
			}
			if (d1_plr_talk_x >= 0 &&
				d1_plr_talk_x >= d1_plr_x - 1 && d1_plr_talk_x <= d1_plr_x + 1 &&
				d1_plr_talk_y >= d1_plr_y - 1 && d1_plr_talk_y <= d1_plr_y + 1)
			{
				d1_plr_dir = D1GetDir(d1_plr_talk_x - d1_plr_x,
					d1_plr_talk_y - d1_plr_y);
				if (!D1TownerUse(D1TownerAt(d1_plr_talk_x, d1_plr_talk_y)))
				{
					d1_talk_txt   = D1TownerQuote(D1TownerAt(d1_plr_talk_x,
						d1_plr_talk_y));
					d1_talk_timer = 80;
				}
				d1_plr_talk_x = -1;
			}
			D1PlayerXPCheck;
			D1LightUpdate(d1_plr_x, d1_plr_y);
			D1CheckTriggers;
		}
	}
	else if (d1_plr_mode == D1PM_HIT)
	{//DoGotHit: HT strip, delay 0, then StartStand
		grp = D1PlrGrp(D1PG_HT);
		nf  = 8;
		if (grp)
			nf = D1CelNFrames(grp);
		d1_plr_frame++;
		if (d1_plr_frame > nf)
		{
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
		}
	}
	else
	{//stand cycle, player.cpp StartStand
		grp = D1PlrGrp(D1PlrGfxSlotStand());
		if (grp)
		{
			nf = D1CelNFrames(grp);
			d1_plr_animcnt++;
			if (d1_plr_animcnt > D1_STAND_DELAY)
			{
				d1_plr_animcnt = 0;
				d1_plr_frame++;
				if (d1_plr_frame > nf)
					d1_plr_frame = 1;
			}
		}
	}

	if (d1_plr_mode == D1PM_STAND && d1_path_pos < d1_path_len)
	{
		dir = d1_path[d1_path_pos];
		if (D1StepOk(d1_plr_x, d1_plr_y, dir))
		{
			d1_path_pos++;
			D1WalkStart(dir);
		}
		else
		{
			d1_path_len = 0;
			d1_path_pos = 0;
		}
	}

	//camera rides the walk offset
	d1_view_x    = d1_plr_x;
	d1_view_y    = d1_plr_y;
	d1_view_xoff = d1_plr_xoff;
	d1_view_yoff = d1_plr_yoff;
}

U0 (*d1_peer_draw_cb)(I64 x, I64 y, I64 sx, I64 sy) = NULL;

U0 D1PlayCellCb(I64 x, I64 y, I64 sx, I64 sy)
{
	U8	*grp;
	I64	 frame;
	I64	 slot;
	I64	 w;

	if (!d1_play_ready)
		return;

	D1ItemDrawCell(x, y, sx, sy);
	D1ObjDrawDoor(x, y, sx, sy);
	D1MonDrawCell(x, y, sx, sy);
	if (d1_currlevel == 0)
		D1TownerDrawCell(x, y, sx, sy);
	if (d1_peer_draw_cb)
		(*d1_peer_draw_cb)(x, y, sx, sy);

	if (x == d1_plr_x && y == d1_plr_y)
	{
		if (d1_plr_mode == D1PM_WALK)
			slot = D1PlrGfxSlotWalk();
		else if (d1_plr_mode == D1PM_ATTACK)
			slot = D1PG_AT;
		else if (d1_plr_mode == D1PM_DEATH)
			slot = D1PG_DT;
		else if (d1_plr_mode == D1PM_HIT)
			slot = D1PG_HT;
		else
			slot = D1PlrGfxSlotStand();

		grp = D1PlrGrp(slot);
		if (!grp)
			grp = D1PlrGrp(D1PlrGfxSlotStand());
		if (grp)
		{
			frame = d1_plr_frame;
			if (frame > D1CelNFrames(grp))
				frame = 1;
			w = D1PlrGfxW(slot);
			D1Cl2Draw(sx - (w - 64) / 2 + d1_plr_xoff, sy + d1_plr_yoff,
				grp, frame, w);
		}
	}

	D1ObjDrawProp(x, y, sx, sy);
	D1MisDrawAt(x, y);
	if (d1_special_cel)
	{
		w = d1_dspecial[x + y * D1_MAXDUN];
		if (w && w <= D1CelNFrames(d1_special_cel))
		{
			if (D1CelTransAt(x, y) ||
				(x == d1_plr_x && y == d1_plr_y && w >= 5))
				d1_cel_trans = TRUE;
			D1CelDrawClipped(sx, sy, d1_special_cel, w, 64);
			d1_cel_trans = FALSE;
		}
	}
}

Bool D1PlayInit()
{//all gfx sets stay resident; ~1MB total
	I64 i;

	d1_wep_gfx_dirty = TRUE;
	if (!D1PlrGfxEnsure())
	{
		"D1Play: player gfx missing\n";
		return FALSE;
	}

	if (!d1_seeds_init)
	{
		D1SetRndSeed(ToI64(tS * 1000.0));
		for (i = 0; i < 17; i++)
			d1_lvl_seeds[i] = D1GetRndSeed();
		d1_seeds_init = TRUE;
	}

	d1_plr_mode  = D1PM_STAND;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
	d1_path_len  = 0;
	d1_path_pos  = 0;
	d1_plr_target = -1;
	d1_warp_to   = -1;

	d1_cell_sprite_cb = &D1PlayCellCb;
	D1MisHookInit;
	d1_play_ready     = TRUE;
	return TRUE;
}

U0 D1PlacePlayer(I64 x, I64 y)
{
	I64 d;
	I64 t;

	if (!D1Walkable(x, y))
	{
		t = -1;
		for (d = 0; d < 8; d++)
		{
			if (t < 0 && D1Walkable(x + d1_dir_dx[d], y + d1_dir_dy[d]))
				t = d;
		}
		if (t >= 0)
		{
			x += d1_dir_dx[t];
			y += d1_dir_dy[t];
		}
	}

	d1_plr_x = x;
	d1_plr_y = y;
	d1_plr_tile_x = x;
	d1_plr_tile_y = y;
	d1_plr_futx = x;
	d1_plr_futy = y;
	d1_view_x = x;
	d1_view_y = y;
	d1_view_xoff = 0;
	d1_view_yoff = 0;
	d1_plr_xoff = 0;
	d1_plr_yoff = 0;
	d1_plr_mode = D1PM_STAND;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_path_len = 0;
	d1_path_pos = 0;
	d1_plr_target = -1;
	D1PlrDoTrans(x, y);
}


U8	*d1_cls_gfx[D1_NCLASS * 7] = {
	NULL, NULL, NULL, NULL, NULL, NULL, NULL,
	NULL, NULL, NULL, NULL, NULL, NULL, NULL,
	NULL, NULL, NULL, NULL, NULL, NULL, NULL
};
Bool d1_cls_gfx_ok[D1_NCLASS] = {FALSE, FALSE, FALSE};

U0 D1PeerGfxClear()
{
	I64 i;
	U8 *p;

	for (i = 0; i < D1_NCLASS * 7; i++)
	{
		p = d1_cls_gfx[i];
		d1_cls_gfx[i] = NULL;
		if (p)
			Free(p);
	}
	for (i = 0; i < D1_NCLASS; i++)
		d1_cls_gfx_ok[i] = FALSE;
}

U8 *D1ClsGfxName(U8 *dst, I64 cls, U8 *wep, U8 *suffix)
{
	StrPrint(dst, "PlrGFX\\%s\\%sl%s\\%sl%s%s.cl2",
		d1_cls_dir[cls], d1_cls_code[cls], wep,
		d1_cls_code[cls], wep, suffix);
	return dst;
}

Bool D1PeerGfxLoad(I64 cls)
{
	I64	 size = 0;
	U8	 path[64];
	I64	 b;

	if (cls < 0 || cls >= D1_NCLASS)
		return FALSE;
	if (d1_cls_gfx_ok[cls])
		return TRUE;

	b = cls * 7;
	d1_cls_gfx[b + D1PG_ST] = D1MpqRead(D1ClsGfxName(path, cls, "s", "st"),
		&size);
	d1_cls_gfx[b + D1PG_WL] = D1MpqRead(D1ClsGfxName(path, cls, "s", "wl"),
		&size);
	d1_cls_gfx[b + D1PG_AS] = D1MpqRead(D1ClsGfxName(path, cls, "s", "as"),
		&size);
	d1_cls_gfx[b + D1PG_AW] = D1MpqRead(D1ClsGfxName(path, cls, "s", "aw"),
		&size);
	d1_cls_gfx[b + D1PG_AT] = D1MpqRead(D1ClsGfxName(path, cls, "s", "at"),
		&size);
	d1_cls_gfx[b + D1PG_HT] = D1MpqRead(D1ClsGfxName(path, cls, "s", "ht"),
		&size);
	d1_cls_gfx[b + D1PG_DT] = D1MpqRead(D1ClsGfxName(path, cls, "n", "dt"),
		&size);

	if (!d1_cls_gfx[b + D1PG_ST])
		return FALSE;
	d1_cls_gfx_ok[cls] = TRUE;
	return TRUE;
}

Bool D1PeerAtTile(I64 x, I64 y)
{
	I64 i;

	if (!d1_net_on)
		return ToBool(x == d1_plr_tile_x && y == d1_plr_tile_y);
	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].dead &&
			d1_peers[i].x == x && d1_peers[i].y == y)
			return TRUE;
	}
	return FALSE;
}

U0 D1PeerPathFind(I64 pidx, I64 tx, I64 ty, Bool adjacent_ok)
{
	CD1Peer *p = &d1_peers[pidx];
	I64 i;

	p->pathlen = 0;
	p->pathpos = 0;
	if (!D1PathFind(p->x, p->y, tx, ty, adjacent_ok))
		return;
	if (d1_path_len > D1NET_PATHMAX)
		d1_path_len = D1NET_PATHMAX;
	for (i = 0; i < d1_path_len; i++)
		p->path[i] = d1_path[i];
	p->pathlen = d1_path_len;
	p->pathpos = 0;
}

U0 D1PeerAttackRoll(I64 pidx, I64 mi)
{
	CD1Peer *p = &d1_peers[pidx];
	I64 chance;
	I64 dmg;
	Bool was;

	if (mi < 0 || mi >= d1_nmons)
		return;
	chance = 50 + p->dex / 2 + p->lvl - d1_montypes[d1_mons[mi].type].ac;
	if (chance < 20)
		chance = 20;
	if (D1Rnd(100) < chance)
	{
		dmg = p->dmin + D1Rnd(p->dmax - p->dmin + 1) +
			(p->str * p->lvl) / 100;
		d1_mon_hurt_by = pidx;
		D1MonHurt(mi, dmg << 6);
		d1_mon_hurt_by = -1;
		if (p->local)
		{
			was = D1NetLocalIn();
			D1DurWeaponHit;
			D1NetLocalOut(was);
		}
	}
}

U0 D1PeerPickup(I64 pidx, I64 x, I64 y)
{
	CD1Peer *p = &d1_peers[pidx];
	I64 ii;
	Bool was;

	if (p->local)
	{
		was = D1NetLocalIn();
		D1ItemPickup(x, y);
		D1NetLocalOut(was);
	}
	ii = d1_ditem[x + y * D1_MAXDUN];
	if (ii)
	{
		d1_items[ii - 1].active = FALSE;
		d1_ditem[x + y * D1_MAXDUN] = 0;
	}
}

U0 D1PeerApplyCmd(I64 pidx, I64 cmd, I64 a, I64 b, I64 c)
{//one turn's input for one peer. msg.cpp's ParseCmd dispatch reduced.
	CD1Peer *p = &d1_peers[pidx];
	I64 dx;
	I64 dy;
	I64 hp_max;
	I64 mn_max;
	I64 heal;
	I64 mana;

	no_warn c;
	if (p->dead)
		return;

	if (cmd == D1NC_WALK)
	{
		p->target = -1;
		D1PeerPathFind(pidx, a, b, FALSE);
	}
	else if (cmd == D1NC_ATTACK)
	{
		if (a >= 0 && a < d1_nmons)
		{
			p->target = a;
			D1PeerPathFind(pidx, d1_mons[a].x, d1_mons[a].y, TRUE);
		}
	}
	else if (cmd == D1NC_STAND)
	{
		p->target  = -1;
		p->pathlen = 0;
		p->pathpos = 0;
		if (p->mode == D1PM_STAND)
		{
			p->dir     = D1GetDir(a - p->x, b - p->y);
			p->mode    = D1PM_ATTACK;
			p->frame   = 1;
			p->animcnt = 0;
		}
	}
	else if (cmd == D1NC_PICKUP)
		D1PeerPickup(pidx, a, b);
	else if (cmd == D1NC_OPEN)
	{
		dx = a - p->x;
		dy = b - p->y;
		if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
		{
			p->dir = D1GetDir(dx, dy);
			D1ObjOperate(a, b, d1_currlevel);
		}
	}
	else if (cmd == D1NC_BELT)
	{
		hp_max = p->maxhp;
		mn_max = p->maxmana;
		heal   = 0;
		mana   = 0;

		if (b == D1IM_HEAL || b == D1IM_REJUV)
			heal = hp_max / 2 + D1Rnd(hp_max / 4 + 1);
		if (b == D1IM_MANA || b == D1IM_REJUV)
			mana = mn_max / 2 + D1Rnd(mn_max / 4 + 1);
		if (b == D1IM_FULLHEAL || b == D1IM_FULLREJUV)
			heal = hp_max;
		if (b == D1IM_FULLMANA || b == D1IM_FULLREJUV)
			mana = mn_max;

		p->hp += heal;
		if (p->hp > hp_max)
			p->hp = hp_max;
		p->mana += mana;
		if (p->mana > mn_max)
			p->mana = mn_max;
		if (p->local)
		{
			d1_plr_hp   = p->hp;
			d1_plr_mana = p->mana;
			if (a >= 0 && a < 8)
				d1_belt[a] = 0;
		}
	}
	else if (cmd == D1NC_WARP)
	{
		d1_warp_to    = a;
		d1_warp_entry = b;
	}
}

U0 D1PeerTick(I64 pidx)
{
	CD1Peer *p = &d1_peers[pidx];
	I64	 dir;
	I64	 nf;
	I64	 dx;
	I64	 dy;
	I64	 oldf;
	U8	*grp;
	I64	 b;

	if (!p->used)
		return;

	b   = p->cls * 7;
	grp = NULL;

	if (p->dead)
		return;

	if (p->mode == D1PM_STAND && p->pathpos < p->pathlen)
	{
		dir = p->path[p->pathpos];
		if (D1StepOk(p->x, p->y, dir) &&
			!D1PeerAtTile(p->x + d1_dir_dx[dir], p->y + d1_dir_dy[dir]))
		{
			p->pathpos++;
			p->dir     = dir;
			p->mode    = D1PM_WALK;
			p->step    = 0;
			p->frame   = 1;
			p->animcnt = 0;
			p->xoff    = 0;
			p->yoff    = 0;
		}
		else
		{
			p->pathlen = 0;
			p->pathpos = 0;
		}
	}

	if (p->mode == D1PM_STAND && p->target >= 0)
	{
		if (D1MonAtTile(d1_mons[p->target].x, d1_mons[p->target].y) !=
			p->target)
			p->target = -1;
		else
		{
			dx = d1_mons[p->target].x - p->x;
			dy = d1_mons[p->target].y - p->y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				p->dir     = D1GetDir(dx, dy);
				p->mode    = D1PM_ATTACK;
				p->frame   = 1;
				p->animcnt = 0;
			}
			else if (p->pathpos >= p->pathlen)
				D1PeerPathFind(pidx, d1_mons[p->target].x, d1_mons[p->target].y,
					TRUE);
		}
	}

	if (p->mode == D1PM_ATTACK)
	{
		nf = 16;
		if (d1_cls_gfx_ok[p->cls] && d1_cls_gfx[b + D1PG_AT])
			nf = D1CelNFrames(D1Cl2Dir(d1_cls_gfx[b + D1PG_AT], p->dir));
		p->frame++;
		if (p->frame == D1_PLR_AFNUM && p->target >= 0)
		{
			dx = d1_mons[p->target].x - p->x;
			dy = d1_mons[p->target].y - p->y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
				D1PeerAttackRoll(pidx, p->target);
		}
		if (p->frame > nf)
		{
			p->mode    = D1PM_STAND;
			p->frame   = 1;
			p->animcnt = 0;
		}
	}
	else if (p->mode == D1PM_WALK)
	{
		p->step++;
		p->xoff = (32 * (d1_dir_dx[p->dir] - d1_dir_dy[p->dir]) * p->step) /
			D1_WALK_TICKS;
		p->yoff = (16 * (d1_dir_dx[p->dir] + d1_dir_dy[p->dir]) * p->step) /
			D1_WALK_TICKS;
		if (d1_cls_gfx_ok[p->cls])
		{
			if (d1_currlevel == 0)
				grp = d1_cls_gfx[b + D1PG_WL];
			else
				grp = d1_cls_gfx[b + D1PG_AW];
		}
		if (grp)
		{
			nf = D1CelNFrames(D1Cl2Dir(grp, p->dir));
			oldf = p->frame;
			p->frame = 1 + ((p->step - 1) * nf) / D1_WALK_TICKS;
			if (p->frame < 1)
				p->frame = 1;
			if (p->frame > nf)
				p->frame = nf;
			D1PlrWalkSfx(oldf, p->frame, nf);
		}
		if (p->step >= D1_WALK_TICKS)
		{
			p->x      += d1_dir_dx[p->dir];
			p->y      += d1_dir_dy[p->dir];
			p->xoff    = 0;
			p->yoff    = 0;
			p->mode    = D1PM_STAND;
			p->frame   = 1;
			p->animcnt = 0;
			p->step    = 0;
			if (d1_ditem[p->x + p->y * D1_MAXDUN])
				D1PeerPickup(pidx, p->x, p->y);
		}
	}
	else
	{//stand cycle, StartStand's delay 3
		if (d1_cls_gfx_ok[p->cls])
		{
			if (d1_currlevel == 0)
				grp = d1_cls_gfx[b + D1PG_ST];
			else
				grp = d1_cls_gfx[b + D1PG_AS];
		}
		if (grp)
		{
			nf = D1CelNFrames(D1Cl2Dir(grp, p->dir));
			p->animcnt++;
			if (p->animcnt > D1_STAND_DELAY)
			{
				p->animcnt = 0;
				p->frame++;
				if (p->frame > nf)
					p->frame = 1;
			}
		}
	}
}

U0 D1PeerTickAll()
{
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
			D1PeerTick(i);
	}
}

U0 D1PeerFromLocal()
{
	CD1Peer *p = &d1_peers[d1_net_self];

	p->used    = TRUE;
	p->local   = TRUE;
	p->cls     = d1_plr_class;
	p->lvl     = d1_plr_lvl;
	p->str     = d1_plr_str;
	p->dex     = d1_plr_dex;
	p->ac      = D1InvAC();
	p->dmin    = D1InvDmgMin();
	p->dmax    = D1InvDmgMax();
	p->hp      = d1_plr_hp;
	p->maxhp   = d1_plr_maxhp;
	p->mana    = d1_plr_mana;
	p->maxmana = d1_plr_maxmana;
	p->dlvl    = d1_currlevel;
	p->dead    = d1_plr_dead;
	D1StrCopy(p->name, d1_plr_name, 32);
}

U0 D1PeerPlaceLocal()
{
	CD1Peer *p = &d1_peers[d1_net_self];

	p->x       = d1_plr_x;
	p->y       = d1_plr_y;
	p->dir     = d1_plr_dir;
	p->mode    = D1PM_STAND;
	p->frame   = 1;
	p->animcnt = 0;
	p->step    = 0;
	p->xoff    = 0;
	p->yoff    = 0;
	p->target  = -1;
	p->pathlen = 0;
	p->pathpos = 0;
}

U0 D1PeerToLocal()
{
	CD1Peer *p = &d1_peers[d1_net_self];

	d1_plr_x      = p->x;
	d1_plr_y      = p->y;
	d1_plr_tile_x = p->x;
	d1_plr_tile_y = p->y;
	d1_plr_dir    = p->dir;
	d1_plr_mode   = p->mode;
	d1_plr_frame  = p->frame;
	d1_plr_animcnt = p->animcnt;
	d1_plr_xoff   = p->xoff;
	d1_plr_yoff   = p->yoff;
	d1_plr_target = p->target;
	d1_plr_hp     = p->hp;
	d1_plr_dead   = p->dead;
	d1_view_x     = p->x;
	d1_view_y     = p->y;
	d1_view_xoff  = p->xoff;
	d1_view_yoff  = p->yoff;
}

U0 D1PeerDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{
	CD1Peer *p;
	U8	*grp;
	I64	 i;
	I64	 f;
	I64	 b;
	I64	 slot;
	I64	 w;

	if (!d1_net_on)
		return;
	for (i = 0; i < D1_MAXPEER; i++)
	{
		p = &d1_peers[i];
		if (p->used && !p->local && p->x == x && p->y == y &&
			d1_cls_gfx_ok[p->cls])
		{
			b    = p->cls * 7;
			slot = D1PG_AS;
			grp  = d1_cls_gfx[b + D1PG_AS];
			if (d1_currlevel == 0)
			{
				slot = D1PG_ST;
				grp  = d1_cls_gfx[b + D1PG_ST];
			}
			if (p->mode == D1PM_WALK)
			{
				slot = D1PG_AW;
				grp  = d1_cls_gfx[b + D1PG_AW];
				if (d1_currlevel == 0)
				{
					slot = D1PG_WL;
					grp  = d1_cls_gfx[b + D1PG_WL];
				}
			}
			else if (p->mode == D1PM_ATTACK)
			{
				slot = D1PG_AT;
				grp  = d1_cls_gfx[b + D1PG_AT];
			}
			else if (p->mode == D1PM_DEATH)
			{
				slot = D1PG_DT;
				grp  = d1_cls_gfx[b + D1PG_DT];
			}
			if (!grp)
				return;
			grp = D1Cl2Dir(grp, p->dir);
			f   = p->frame;
			if (f > D1CelNFrames(grp))
				f = 1;
			w = D1PlrGfxW(slot);
			D1Cl2Draw(sx - (w - 64) / 2 + p->xoff, sy + p->yoff, grp, f, w);
			D1TextDrawSolid(sx + 32 - D1TextWidth(p->name) / 2, sy - 44,
				p->name, D1PalBrightest());
		}
	}
}

U0 D1PeerInit()
{
	D1PeerGfxClear;
	d1_peer_draw_cb = &D1PeerDrawCell;
}

D1PeerInit;

Bool D1PeerNetFrame()
{
	I64 i;
	I64 cmd;
	I64 a;
	I64 b;
	I64 c;
	CD1Peer *p;

	D1NetPump;
	if (D1NetTurnDue())
	{
		if (!D1NetTurnReady())
		{
			d1_net_tick = D1NET_TICKS;
			return FALSE;
		}
		D1NetSimEnter;
		for (i = 0; i < D1_MAXPEER; i++)
		{
			if (d1_peers[i].used)
			{
				D1NetTakeCmd(i, d1_net_turn, &cmd, &a, &b, &c);
				D1PeerApplyCmd(i, cmd, a, b, c);
			}
		}
		D1NetTurnDone;
	}
	else
		D1NetSimEnter;

	D1PeerTickAll;
	D1MonTickAll;
	D1ItemTickAll;
	D1ObjTickAll;
	D1NetSimLeave;
	D1PeerToLocal;
	p = &d1_peers[d1_net_self];
	if (p->used && !p->dead && p->mode == D1PM_STAND)
	{
		if (d1_currlevel == 0)
		{
			if (p->x == 25 && p->y == 29)
				D1NetQueue(D1NC_WARP, 1, 0, 0);
		}
		else if (p->x == d1_trig_up_x && p->y == d1_trig_up_y)
			D1NetQueue(D1NC_WARP, d1_currlevel - 1, 1, 0);
		else if (p->x == d1_trig_down_x && p->y == d1_trig_down_y &&
			d1_currlevel < 16)
			D1NetQueue(D1NC_WARP, d1_currlevel + 1, 0, 0);
	}
	return TRUE;
}


#define D1_SNAP_P0	4
#define D1_SNAP_M0	(D1_SNAP_P0 + D1_MAXPEER * 8)
#define D1_SNAP_I0	(D1_SNAP_M0 + D1_MAXMON * 7)
#define D1_SNAP_LEN	(D1_SNAP_I0 + D1_MAXITEM * 4)

U8 d1_snap_name[64];

I64 D1GridSumU16(U16 *g, I64 n)
{
	I64 i;
	I64 s = 0;

	for (i = 0; i < n; i++)
		s = (s * 31 + g[i]) & 0xFFFFFFFF;
	return s;
}

I64 D1GridSumI32(I32 *g, I64 n)
{
	I64 i;
	I64 s = 0;

	for (i = 0; i < n; i++)
		s = (s * 31 + g[i]) & 0xFFFFFFFF;
	return s;
}

I64 D1GridSumU8(U8 *g, I64 n)
{
	I64 i;
	I64 s = 0;

	for (i = 0; i < n; i++)
		s = (s * 31 + g[i]) & 0xFFFFFFFF;
	return s;
}

U0 D1PeerSnapWrite(I64 *dst)
{
	I64 i;
	I64 o;
	CD1Peer *p;
	CD1Mon	*m;

	dst[0] = d1_net_simseed;
	dst[1] = D1GridSumU16(d1_dpiece, D1_MAXDUN * D1_MAXDUN);
	dst[2] = D1GridSumI32(d1_dmon, D1_MAXDUN * D1_MAXDUN);
	dst[3] = D1GridSumU8(d1_ditem, D1_MAXDUN * D1_MAXDUN);

	for (i = 0; i < D1_MAXPEER; i++)
	{
		p = &d1_peers[i];
		o = D1_SNAP_P0 + i * 8;
		dst[o]     = p->used;
		dst[o + 1] = p->x;
		dst[o + 2] = p->y;
		dst[o + 3] = p->hp;
		dst[o + 4] = p->dead;
		dst[o + 5] = p->mode;
		dst[o + 6] = p->dir;
		dst[o + 7] = p->target;
	}
	for (i = 0; i < D1_MAXMON; i++)
	{
		m = &d1_mons[i];
		o = D1_SNAP_M0 + i * 7;
		dst[o]     = m->active;
		dst[o + 1] = m->x;
		dst[o + 2] = m->y;
		dst[o + 3] = m->hp;
		dst[o + 4] = m->mode;
		dst[o + 5] = m->dir;
		dst[o + 6] = m->delay;
	}
	for (i = 0; i < D1_MAXITEM; i++)
	{
		o = D1_SNAP_I0 + i * 4;
		dst[o]     = d1_items[i].active;
		dst[o + 1] = d1_items[i].x;
		dst[o + 2] = d1_items[i].y;
		dst[o + 3] = d1_items[i].itm;
	}
}

U8 *d1_snap_pf[8] = {"used", "x", "y", "hp", "dead", "mode", "dir", "target"};
U8 *d1_snap_mf[7] = {"active", "x", "y", "hp", "mode", "dir", "delay"};
U8 *d1_snap_if[4] = {"active", "x", "y", "row"};

U8 *D1PeerSnapName(I64 idx)
{
	I64 i;
	I64 f;

	if (idx == 0)
		return "shared RNG seed";
	if (idx == 1)
		return "dPiece checksum";
	if (idx == 2)
		return "dMonster checksum";
	if (idx == 3)
		return "dItem checksum";
	if (idx < D1_SNAP_M0)
	{
		i = (idx - D1_SNAP_P0) / 8;
		f = (idx - D1_SNAP_P0) % 8;
		StrPrint(d1_snap_name, "peer %d %s", i, d1_snap_pf[f]);
		return d1_snap_name;
	}
	if (idx < D1_SNAP_I0)
	{
		i = (idx - D1_SNAP_M0) / 7;
		f = (idx - D1_SNAP_M0) % 7;
		StrPrint(d1_snap_name, "monster %d %s", i, d1_snap_mf[f]);
		return d1_snap_name;
	}
	i = (idx - D1_SNAP_I0) / 4;
	f = (idx - D1_SNAP_I0) % 4;
	StrPrint(d1_snap_name, "ground item %d %s", i, d1_snap_if[f]);
	return d1_snap_name;
}

I64 D1PeerSnapHash()
{
	I64 hash = d1_seed;
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
		{
			hash = hash * 31 + d1_peers[i].x;
			hash = hash * 31 + d1_peers[i].y;
			hash = hash * 31 + d1_peers[i].hp;
			hash = hash * 31 + d1_peers[i].dead;
			hash = hash * 31 + d1_peers[i].mode;
			hash = hash * 31 + d1_peers[i].target;
		}
	}
	for (i = 0; i < d1_nmons; i++)
	{
		if (d1_mons[i].active)
		{
			hash = hash * 31 + d1_mons[i].x;
			hash = hash * 31 + d1_mons[i].y;
			hash = hash * 31 + d1_mons[i].hp;
			hash = hash * 31 + d1_mons[i].mode;
			hash = hash * 31 + d1_mons[i].dir;
		}
	}
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active)
		{
			hash = hash * 31 + d1_items[i].x;
			hash = hash * 31 + d1_items[i].y;
			hash = hash * 31 + d1_items[i].itm;
		}
	}
	return hash;
}

U0 D1PeerFill(I64 pidx, Bool local, U8 *name, I64 x, I64 y)
{
	CD1Peer *p = &d1_peers[pidx];

	D1PeerClear(pidx);
	p->used    = TRUE;
	p->local   = local;
	p->cls     = d1_plr_class;
	p->lvl     = d1_plr_lvl;
	p->str     = d1_plr_str;
	p->dex     = d1_plr_dex;
	p->ac      = D1InvAC();
	p->dmin    = D1InvDmgMin();
	p->dmax    = D1InvDmgMax();
	p->hp      = d1_plr_maxhp;
	p->maxhp   = d1_plr_maxhp;
	p->mana    = d1_plr_maxmana;
	p->maxmana = d1_plr_maxmana;
	p->dlvl    = d1_currlevel;
	p->x       = x;
	p->y       = y;
	p->dir     = 0;
	p->mode    = D1PM_STAND;
	p->frame   = 1;
	p->target  = -1;
	D1StrCopy(p->name, name, 32);
}

U0 D1PeerSimScript(I64 turn, I64 bx0, I64 by0, I64 bx1, I64 by1,
	I64 *c0, I64 *a0, I64 *b0, I64 *c1, I64 *a1, I64 *b1)
{
	*c0 = D1NC_NONE; *a0 = 0; *b0 = 0;
	*c1 = D1NC_NONE; *a1 = 0; *b1 = 0;

	if (turn < 8)
	{
		*c0 = D1NC_WALK;
		*a0 = bx0 + 1 + (turn & 3);
		*b0 = by0;
		*c1 = D1NC_WALK;
		*a1 = bx1 - 1 - (turn & 3);
		*b1 = by1;
	}
	else if (turn < 16)
	{
		*c0 = D1NC_WALK;
		*a0 = bx0;
		*b0 = by0 + 1 + (turn & 3);
		*c1 = D1NC_WALK;
		*a1 = bx1;
		*b1 = by1 - 1 - (turn & 3);
	}
	else if (turn < 24)
	{
		//monster 0 is the first spawn from a fixed seed; both passes share it
		*c0 = D1NC_ATTACK;
		*a0 = 0;
		*c1 = D1NC_STAND;
		*a1 = bx1 - 1;
		*b1 = by1;
	}
	else if (turn < 32)
	{
		*c0 = D1NC_STAND;
		*a0 = bx0 + 1;
		*b0 = by0;
		*c1 = D1NC_ATTACK;
		*a1 = 0;
	}
	else
	{
		*c0 = D1NC_WALK;
		*a0 = bx0;
		*b0 = by0;
		*c1 = D1NC_WALK;
		*a1 = bx1;
		*b1 = by1;
		if (turn & 1)
		{
			*a0 = bx0 + 2;
			*a1 = bx1 - 2;
		}
		if (turn & 2)
		{
			*b0 = by0 + 1;
			*b1 = by1 - 1;
		}
	}
}

U0 D1PeerSimRun(I64 *out_hash, I64 nturns, I64 bx0, I64 by0, I64 bx1,
	I64 by1)
{
	I64 t;
	I64 f;
	I64 c0;
	I64 a0;
	I64 b0;
	I64 c1;
	I64 a1;
	I64 b1;

	for (t = 0; t < nturns; t++)
	{
		D1PeerSimScript(t, bx0, by0, bx1, by1, &c0, &a0, &b0, &c1, &a1, &b1);
		D1NetSimEnter;
		D1PeerApplyCmd(0, c0, a0, b0, 0);
		D1PeerApplyCmd(1, c1, a1, b1, 0);
		for (f = 0; f < D1NET_TICKS; f++)
		{
			D1PeerTickAll;
			D1MonTickAll;
			D1ItemTickAll;
			D1ObjTickAll;
		}
		D1NetSimLeave;
		out_hash[t] = D1PeerSnapHash();
	}
}

