// D1Play.ZC - player: town warrior, stand/walk animation, click-to-walk
//
// facing directions as player.cpp has them:
//   0 S, 1 SW, 2 W, 3 NW, 4 N, 5 NE, 6 E, 7 SE
// tile step per direction derives from the screen transform:
// sxd = 32*(dx - dy), syd = 16*(dx + dy).
//
// player CL2 group: 8 directions, town stand 20 frames, town walk 8.
// frame counts are read from the file, not assumed.
//
// walking: 8 game ticks per tile (20Hz), pixel offset interpolates the
// tile's screen delta. camera carries the same offset so the player stays
// screen-centered, as the original does.

#define D1PM_STAND		0
#define D1PM_WALK		1

#define D1_WALK_TICKS	8
#define D1_PATH_MAX		96

I64 d1_dir_dx[8] = { 1,  0, -1, -1, -1,  0,  1,  1};
I64 d1_dir_dy[8] = { 1,  1,  1,  0, -1, -1, -1,  0};

I64	 d1_plr_x     = 75;
I64	 d1_plr_y     = 68;
I64	 d1_plr_dir   = 0;
I64	 d1_plr_mode  = D1PM_STAND;
I64	 d1_plr_frame = 1;
I64	 d1_plr_step  = 0;			//walk tick 0..7
I64	 d1_plr_xoff  = 0;
I64	 d1_plr_yoff  = 0;

U8	*d1_gfx_stand = NULL;		//CL2 groups
U8	*d1_gfx_walk  = NULL;

I64	 d1_path[D1_PATH_MAX];		//queued directions
I64	 d1_path_len  = 0;
I64	 d1_path_pos  = 0;

Bool d1_play_ready = FALSE;

I64 D1GetDir(I64 dx, I64 dy)
{//facing from a tile delta
	if (dx > 0)
	{
		if (dy > 0)  return 0;
		if (dy < 0)  return 6;
		return 7;
	}
	if (dx < 0)
	{
		if (dy > 0)  return 2;
		if (dy < 0)  return 4;
		return 3;
	}
	if (dy > 0)  return 1;
	if (dy < 0)  return 5;
	return d1_plr_dir;
}

Bool D1StepOk(I64 x, I64 y, I64 dir)
{//no corner cutting: a diagonal needs both orthogonal neighbors open
	I64 nx = x + d1_dir_dx[dir];
	I64 ny = y + d1_dir_dy[dir];

	if (!D1Walkable(nx, ny))
		return FALSE;
	if (d1_dir_dx[dir] && d1_dir_dy[dir])
	{
		if (!D1Walkable(x + d1_dir_dx[dir], y))
			return FALSE;
		if (!D1Walkable(x, y + d1_dir_dy[dir]))
			return FALSE;
	}
	return TRUE;
}

//BFS over the walkable grid. prev[] doubles as the visited mark.
I32 d1_bfs_prev[D1_MAXDUN * D1_MAXDUN];
I32 d1_bfs_queue[D1_MAXDUN * D1_MAXDUN];

Bool D1PathFind(I64 sx, I64 sy, I64 tx, I64 ty)
{//fills d1_path with directions, oldest first
	I64 head = 0;
	I64 tail = 0;
	I64 cur;
	I64 cx;
	I64 cy;
	I64 d;
	I64 nx;
	I64 ny;
	I64 n;
	I64 i;
	I64 steps[D1_PATH_MAX];

	d1_path_len = 0;
	d1_path_pos = 0;

	if (tx == sx && ty == sy)
		return FALSE;
	if (!D1Walkable(tx, ty))
		return FALSE;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_bfs_prev[i] = -1;

	cur = sx + sy * D1_MAXDUN;
	d1_bfs_prev[cur]     = cur;
	d1_bfs_queue[tail++] = cur;

	while (head < tail)
	{
		cur = d1_bfs_queue[head++];
		cx  = cur % D1_MAXDUN;
		cy  = cur / D1_MAXDUN;
		if (cx == tx && cy == ty)
			break;
		for (d = 0; d < 8; d++)
		{
			if (D1StepOk(cx, cy, d))
			{
				nx = cx + d1_dir_dx[d];
				ny = cy + d1_dir_dy[d];
				n  = nx + ny * D1_MAXDUN;
				if (d1_bfs_prev[n] < 0)
				{
					d1_bfs_prev[n]       = cur;
					d1_bfs_queue[tail++] = n;
				}
			}
		}
	}

	n = tx + ty * D1_MAXDUN;
	if (d1_bfs_prev[n] < 0)
		return FALSE;

	//walk back to the start, recording each hop's direction
	i = 0;
	while (n != sx + sy * D1_MAXDUN && i < D1_PATH_MAX)
	{
		cur = d1_bfs_prev[n];
		steps[i] = D1GetDir(n % D1_MAXDUN - cur % D1_MAXDUN,
							n / D1_MAXDUN - cur / D1_MAXDUN);
		n = cur;
		i++;
	}
	if (n != sx + sy * D1_MAXDUN)
		return FALSE;		//path longer than the buffer

	//reverse into play order
	d1_path_len = i;
	for (d = 0; d < i; d++)
		d1_path[d] = steps[i - 1 - d];

	return TRUE;
}

U0 D1WalkStart(I64 dir)
{
	d1_plr_dir   = dir;
	d1_plr_mode  = D1PM_WALK;
	d1_plr_step  = 0;
	d1_plr_frame = 1;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
}

U0 D1PlayClickTo(I64 tx, I64 ty)
{
	if (!d1_play_ready)
		return;
	D1PathFind(d1_plr_x, d1_plr_y, tx, ty);
}

U0 D1PlayTick()
{//20Hz game tick
	I64 dir;
	I64 nf;

	if (!d1_play_ready)
		return;

	if (d1_plr_mode == D1PM_STAND && d1_path_pos < d1_path_len)
	{
		dir = d1_path[d1_path_pos];
		if (D1StepOk(d1_plr_x, d1_plr_y, dir))
		{
			d1_path_pos++;
			D1WalkStart(dir);
		}
		else
		{//world changed under the path - drop it
			d1_path_len = 0;
			d1_path_pos = 0;
		}
	}

	if (d1_plr_mode == D1PM_WALK)
	{
		d1_plr_step++;
		d1_plr_xoff = (32 * (d1_dir_dx[d1_plr_dir] - d1_dir_dy[d1_plr_dir]) *
			d1_plr_step) / D1_WALK_TICKS;
		d1_plr_yoff = (16 * (d1_dir_dx[d1_plr_dir] + d1_dir_dy[d1_plr_dir]) *
			d1_plr_step) / D1_WALK_TICKS;

		nf = D1CelNFrames(D1Cl2Dir(d1_gfx_walk, d1_plr_dir));
		d1_plr_frame = 1 + (d1_plr_step * nf / D1_WALK_TICKS) % nf;

		if (d1_plr_step >= D1_WALK_TICKS)
		{
			d1_plr_x    += d1_dir_dx[d1_plr_dir];
			d1_plr_y    += d1_dir_dy[d1_plr_dir];
			d1_plr_xoff  = 0;
			d1_plr_yoff  = 0;
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_step  = 0;
		}
	}
	else
	{//stand cycle
		nf = D1CelNFrames(D1Cl2Dir(d1_gfx_stand, d1_plr_dir));
		d1_plr_frame++;
		if (d1_plr_frame > nf)
			d1_plr_frame = 1;
	}

	//camera rides the walk offset
	d1_view_x    = d1_plr_x;
	d1_view_y    = d1_plr_y;
	d1_view_xoff = d1_plr_xoff;
	d1_view_yoff = d1_plr_yoff;
}

U0 D1PlayCellCb(I64 x, I64 y, I64 sx, I64 sy)
{//sprite pass: called for every drawn cell, draws the player on their tile
	U8	*grp;
	I64	 frame;

	if (!d1_play_ready)
		return;
	if (x != d1_plr_x || y != d1_plr_y)
		return;

	if (d1_plr_mode == D1PM_WALK)
		grp = D1Cl2Dir(d1_gfx_walk, d1_plr_dir);
	else
		grp = D1Cl2Dir(d1_gfx_stand, d1_plr_dir);

	frame = d1_plr_frame;
	if (frame > D1CelNFrames(grp))
		frame = 1;

	//96 wide, centered over the 64 wide tile, feet on the cell base
	D1Cl2Draw(sx - 16 + d1_plr_xoff, sy + d1_plr_yoff, grp, frame, 96);
}

Bool D1PlayInit()
{//town warrior, light armor + sword and shield ("wls")
	I64 size = 0;

	d1_play_ready = FALSE;

	if (!d1_gfx_stand)
		d1_gfx_stand = D1MpqRead("PlrGFX\\Warrior\\wls\\wlsst.cl2", &size);
	if (!d1_gfx_walk)
		d1_gfx_walk = D1MpqRead("PlrGFX\\Warrior\\wls\\wlswl.cl2", &size);

	if (!d1_gfx_stand || !d1_gfx_walk)
	{
		"D1Play: player gfx missing\n";
		return FALSE;
	}

	d1_plr_x     = 75;
	d1_plr_y     = 68;
	d1_plr_dir   = 0;
	d1_plr_mode  = D1PM_STAND;
	d1_plr_frame = 1;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
	d1_path_len  = 0;
	d1_path_pos  = 0;

	d1_cell_sprite_cb = &D1PlayCellCb;
	d1_play_ready     = TRUE;
	return TRUE;
}
