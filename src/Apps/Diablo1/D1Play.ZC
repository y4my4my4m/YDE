// D1Play.ZC - player: warrior, walking, melee, death, level transitions
//
// facing directions and tile steps are d1_dir_dx/dy (D1Lvl).
// gfx sets ("wls" = warrior, light armor, sword+shield): town ST/WL,
// dungeon AS/AW/AT/HT/DT (player.cpp suffix table). frame counts come
// from the files; the attack lands on frame 9 (warrior _pAFNum).
//
// walking: 8 ticks per tile at 20Hz. camera carries the walk offset so the
// player stays centered. combat state (HP, level, str/dex) lives in D1Mon
// for include order.
//
// anim rates are player.cpp NewPlrAnim Delay values. ProcessPlayers advances
// on _pAnimCnt > _pAnimDelay, so a frame lasts Delay + 1 game ticks: stand 4,
// death 2, walk and attack 1. at the shell's 20Hz that is 5 stand frames a
// second (devilutionx player.cpp getAnimationFramesAndTicksPerFrame states the
// same 4 and 2 as ticksPerFrame).

#define D1PM_STAND		0
#define D1PM_WALK		1
#define D1PM_ATTACK		2
#define D1PM_DEATH		3
#define D1PM_HIT		4		//PM_GOTHIT / StartPlrHit

#define D1_WALK_TICKS	8
#define D1_PATH_MAX		96
#define D1_PLR_AFNUM	9

#define D1_STAND_DELAY	3		//StartStand
#define D1_DEATH_DELAY	1		//StartPlrKill
#define D1_HIT_DELAY	0		//StartPlrHit NewPlrAnim delay 0

//gfx slots
#define D1PG_ST	0
#define D1PG_WL	1
#define D1PG_AS	2
#define D1PG_AW	3
#define D1PG_AT	4
#define D1PG_HT	5
#define D1PG_DT	6

I64	 d1_plr_x     = 75;
I64	 d1_plr_y     = 68;
I64	 d1_plr_dir   = 0;
I64	 d1_plr_mode  = D1PM_STAND;
I64	 d1_plr_frame = 1;
I64	 d1_plr_animcnt = 0;			//_pAnimCnt
I64	 d1_plr_step  = 0;
I64	 d1_plr_xoff  = 0;
I64	 d1_plr_yoff  = 0;
I64	 d1_plr_target = -1;			//monster index being attacked
I64	 d1_plr_deadtime = 0;			//ticks since death

U8	*d1_plr_gfx[7];
Bool d1_plr_gfx_init = FALSE;
I64	 d1_plr_gfx_class = -1;

I64	 d1_path[D1_PATH_MAX];
I64	 d1_path_len  = 0;
I64	 d1_path_pos  = 0;

//pending level change, applied by the shell between frames
I64	 d1_warp_to   = -1;				//-1 none, 0 town, 1-4 cathedral
I64	 d1_warp_entry = 0;				//0 = arriving from above, 1 = from below

I64	 d1_lvl_seeds[17];
Bool d1_seeds_init = FALSE;

Bool d1_play_ready = FALSE;

//pending object interaction, walked to first
I64 d1_plr_obj_x = -1;
I64 d1_plr_obj_y = -1;

//pending towner talk + active speech line
I64 d1_plr_talk_x = -1;
I64 d1_plr_talk_y = -1;
U8	*d1_talk_txt   = NULL;
I64	 d1_talk_timer = 0;			//ticks left showing the line

I64 D1GetDir(I64 dx, I64 dy)
{//facing from a tile delta
	if (dx > 0)
	{
		if (dy > 0)  return 0;
		if (dy < 0)  return 6;
		return 7;
	}
	if (dx < 0)
	{
		if (dy > 0)  return 2;
		if (dy < 0)  return 4;
		return 3;
	}
	if (dy > 0)  return 1;
	if (dy < 0)  return 5;
	return d1_plr_dir;
}

Bool D1StepOk(I64 x, I64 y, I64 dir)
{//no corner cutting: a diagonal needs both orthogonal neighbors open
	I64 nx = x + d1_dir_dx[dir];
	I64 ny = y + d1_dir_dy[dir];

	if (!D1WalkableM(nx, ny))
		return FALSE;
	if (D1ObjBlocks(nx, ny))
		return FALSE;
	if (d1_dir_dx[dir] && d1_dir_dy[dir])
	{
		if (!D1Walkable(x + d1_dir_dx[dir], y))
			return FALSE;
		if (!D1Walkable(x, y + d1_dir_dy[dir]))
			return FALSE;
	}
	return TRUE;
}

//BFS over the walkable grid. prev[] doubles as the visited mark.
I32 d1_bfs_prev[D1_MAXDUN * D1_MAXDUN];
I32 d1_bfs_queue[D1_MAXDUN * D1_MAXDUN];

Bool D1PathFind(I64 sx, I64 sy, I64 tx, I64 ty, Bool adjacent_ok)
{//fills d1_path with directions. adjacent_ok stops next to the target
 //(attack/talk); the target tile itself may be occupied then.
	I64 head = 0;
	I64 tail = 0;
	I64 cur;
	I64 cx;
	I64 cy;
	I64 d;
	I64 nx;
	I64 ny;
	I64 n;
	I64 i;
	I64 goal = -1;
	I64 dx;
	I64 dy;
	I64 steps[D1_PATH_MAX];

	d1_path_len = 0;
	d1_path_pos = 0;

	if (tx == sx && ty == sy)
		return FALSE;
	if (!adjacent_ok && !D1Walkable(tx, ty))
		return FALSE;

	//path.cpp A* first; BFS below covers walks past its 24-step cap
	i = D1AStar(sx, sy, tx, ty, adjacent_ok, d1_path, D1_PATH_MAX);
	if (i > 0)
	{
		d1_path_len = i;
		return TRUE;
	}

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_bfs_prev[i] = -1;

	cur = sx + sy * D1_MAXDUN;
	d1_bfs_prev[cur]     = cur;
	d1_bfs_queue[tail++] = cur;

	while (head < tail)
	{
		cur = d1_bfs_queue[head++];
		cx  = cur % D1_MAXDUN;
		cy  = cur / D1_MAXDUN;

		if (cx == tx && cy == ty)
		{
			goal = cur;
			break;
		}
		if (adjacent_ok)
		{
			dx = tx - cx;
			dy = ty - cy;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				goal = cur;
				break;
			}
		}

		for (d = 0; d < 8; d++)
		{
			if (D1StepOk(cx, cy, d))
			{
				nx = cx + d1_dir_dx[d];
				ny = cy + d1_dir_dy[d];
				n  = nx + ny * D1_MAXDUN;
				if (d1_bfs_prev[n] < 0)
				{
					d1_bfs_prev[n]       = cur;
					d1_bfs_queue[tail++] = n;
				}
			}
		}
	}

	if (goal < 0)
		return FALSE;
	if (goal == sx + sy * D1_MAXDUN)
		return TRUE;			//already adjacent

	n = goal;
	i = 0;
	while (n != sx + sy * D1_MAXDUN && i < D1_PATH_MAX)
	{
		cur = d1_bfs_prev[n];
		steps[i] = D1GetDir(n % D1_MAXDUN - cur % D1_MAXDUN,
							n / D1_MAXDUN - cur / D1_MAXDUN);
		n = cur;
		i++;
	}
	if (n != sx + sy * D1_MAXDUN)
		return FALSE;

	d1_path_len = i;
	for (d = 0; d < i; d++)
		d1_path[d] = steps[i - 1 - d];

	return TRUE;
}

U8 *D1PlrGrp(I64 slot)
{//current-mode CL2 group for the facing direction
	if (!d1_plr_gfx[slot])
		return NULL;
	return D1Cl2Dir(d1_plr_gfx[slot], d1_plr_dir);
}

I64 D1PlrGfxSlotStand()
{
	if (d1_currlevel == 0)
		return D1PG_ST;
	return D1PG_AS;
}

I64 D1PlrGfxSlotWalk()
{
	if (d1_currlevel == 0)
		return D1PG_WL;
	return D1PG_AW;
}

I64 D1WalkTicks()
{//town jog: faster steps above ground (devilutionX QOL)
	if (d1_currlevel == 0 && d1_opt_jog)
		return 5;
	return D1_WALK_TICKS;
}

I64 D1PlrGfxW(I64 slot)
{//GetPlayerSpriteWidth: stand/walk 96, attack+death 128 for sword+shield
	if (slot == D1PG_AT || slot == D1PG_DT)
		return 128;
	return 96;
}

U0 D1WalkStart(I64 dir)
{
	d1_plr_dir   = dir;
	d1_plr_mode  = D1PM_WALK;
	d1_plr_step  = 0;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
}

U0 D1AttackStart(I64 dir)
{
	d1_plr_dir   = dir;
	d1_plr_mode  = D1PM_ATTACK;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	if (d1_opt_sfx)
	{
		if (D1SndRnd2())
			D1SndPlay("Sfx\\Misc\\Swing2.wav");
		else
			D1SndPlay("Sfx\\Misc\\Swing.wav");
	}
}

U0 D1PlayClickTo(I64 tx, I64 ty)
{//dispatch: monster = fight, anything else = walk. SHIFT held = stand
 //ground, devilutionx diablo.cpp LeftMouseDown's isShiftHeld: swing toward
 //the tile without pathing to it.
	I64 mi;
	I64 ti;
	I64 oi;
	I64 ii;
	I64 dx;
	I64 dy;

	if (!d1_play_ready || d1_plr_dead)
		return;

	//lockstep: latch a command for the next turn; the local path is not
	//walked here - D1PeerApplyCmd does it on every machine
	if (d1_net_on)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
		{
			D1NetQueue(D1NC_STAND, tx, ty, 0);
			return;
		}
		mi = D1MonAtCurs(tx, ty);
		if (mi >= 0)
		{
			D1NetQueue(D1NC_ATTACK, mi, 0, 0);
			return;
		}
		ii = D1ItemAtCurs(tx, ty);
		if (ii >= 0)
		{
			D1NetQueue(D1NC_PICKUP, d1_items[ii].x, d1_items[ii].y, 0);
			return;
		}
		oi = D1ObjAtCurs(tx, ty);
		if (oi >= 0)
		{
			D1NetQueue(D1NC_OPEN, d1_objs[oi].x, d1_objs[oi].y, 0);
			return;
		}
		D1NetQueue(D1NC_WALK, tx, ty, 0);
		return;
	}

	if (Bt(kbd.down_bitmap, SC_SHIFT))
	{
		d1_plr_target = -1;
		d1_plr_obj_x  = -1;
		d1_path_len   = 0;
		d1_path_pos   = 0;
		mi = D1MonAtCurs(tx, ty);
		if (mi >= 0)
			d1_plr_target = mi;
		if (d1_plr_mode == D1PM_STAND)
			D1AttackStart(D1GetDir(tx - d1_plr_x, ty - d1_plr_y));
		return;
	}

	//CheckCursMove accepts the actor one tile down-screen of the cursor, so
	//the target tile is the actor's own, not the clicked one
	mi = D1MonAtCurs(tx, ty);
	if (mi >= 0)
	{
		d1_plr_target = mi;
		d1_plr_obj_x  = -1;
		D1PathFind(d1_plr_x, d1_plr_y, d1_mons[mi].x, d1_mons[mi].y, TRUE);
		return;
	}

	d1_plr_target = -1;

	if (d1_currlevel == 0)
	{
		ti = D1TownerAtCurs(tx, ty);
		if (ti >= 0)
		{//walk up and talk. already adjacent: talk now (empty path
		 //never reaches the arrive-and-talk arm in D1PlayTick)
			d1_plr_talk_x = d1_twn[ti].x;
			d1_plr_talk_y = d1_twn[ti].y;
			d1_plr_obj_x  = -1;
			dx = d1_plr_talk_x - d1_plr_x;
			dy = d1_plr_talk_y - d1_plr_y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				d1_plr_dir = D1GetDir(dx, dy);
				if (!D1StoreEnter(ti))
				{
					d1_talk_txt   = D1TownerQuote(ti);
					d1_talk_timer = 80;
				}
				d1_plr_talk_x = -1;
				return;
			}
			if (!D1PathFind(d1_plr_x, d1_plr_y, d1_plr_talk_x,
				d1_plr_talk_y, TRUE))
				d1_plr_talk_x = -1;
			return;
		}
	}
	d1_plr_talk_x = -1;

	//item before object: standing loot beats the chest under it
	ii = D1ItemAtCurs(tx, ty);
	if (ii >= 0)
	{
		d1_plr_obj_x = -1;
		tx = d1_items[ii].x;
		ty = d1_items[ii].y;
		if (tx == d1_plr_x && ty == d1_plr_y)
		{
			D1ItemPickup(tx, ty);
			return;
		}
		D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
		return;
	}

	oi = D1ObjAtCurs(tx, ty);
	if (oi >= 0)
	{//doors/chests: walk then Operate. barrels (_oBreak): walk then
	 //StartAttack; the hit frame PlrHitObj-breaks them (player.cpp
	 //ACTION_OPERATE). PathFind empty-path never reaches arrive arm.
		tx = d1_objs[oi].x;
		ty = d1_objs[oi].y;
		d1_plr_obj_x = tx;
		d1_plr_obj_y = ty;
		dx = tx - d1_plr_x;
		dy = ty - d1_plr_y;
		if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
		{
			d1_plr_dir = D1GetDir(dx, dy);
			if (D1ObjIsBreakable(oi))
				D1AttackStart(d1_plr_dir);
			else
				D1ObjOperate(tx, ty, d1_currlevel);
			d1_plr_obj_x = -1;
			return;
		}
		if (!D1PathFind(d1_plr_x, d1_plr_y, tx, ty, TRUE))
			d1_plr_obj_x = -1;
		return;
	}

	d1_plr_obj_x = -1;
	D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
}

U0 D1PlayHeldWalk(I64 tx, I64 ty)
{//diablo.cpp sgbMouseDown: a held left button renews the walk toward the
 //cursor once the queued path is spent. walk only - attacks, talks and
 //object operates stay click-edge; an adjacent attack target already
 //re-swings from the target logic in D1PlayTick. stale obj/talk/target
 //latches from a prior click must clear or hold-walk never resumes.
	if (!d1_play_ready || d1_plr_dead)
		return;
	if (d1_net_on)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			return;
		if (D1MonAtCurs(tx, ty) >= 0)
			return;
		if (D1ObjBlocks(tx, ty))
			return;
		if (tx == d1_plr_x && ty == d1_plr_y)
			return;
		D1NetQueue(D1NC_WALK, tx, ty, 0);
		return;
	}
	if (d1_plr_mode != D1PM_STAND)
		return;
	if (d1_path_pos < d1_path_len)
		return;
	if (Bt(kbd.down_bitmap, SC_SHIFT))
		return;
	if (D1MonAtCurs(tx, ty) >= 0)
		return;
	if (d1_currlevel == 0 && D1TownerAtCurs(tx, ty) >= 0)
		return;
	if (D1ObjBlocks(tx, ty))
		return;
	if (tx == d1_plr_x && ty == d1_plr_y)
		return;
	d1_plr_target = -1;
	d1_plr_obj_x  = -1;
	d1_plr_talk_x = -1;
	D1PathFind(d1_plr_x, d1_plr_y, tx, ty, FALSE);
}

U0 D1PlayerAttackRoll(I64 mi)
{//PM_DoAttack reduced: base weapon 2-6, str scaling
	CD1Mon *m = &d1_mons[mi];
	I64 chance = 50 + d1_plr_dex / 2 + d1_plr_lvl -
		d1_montypes[m->type].ac;
	I64 dmg;

	if (chance < 20)
		chance = 20;
	if (D1Rnd(100) < chance)
	{
		dmg = D1InvDmgMin() + D1Rnd(D1InvDmgMax() - D1InvDmgMin() + 1) +
			(d1_plr_str * d1_plr_lvl) / 100;
		D1MonHurt(mi, dmg << 6);
		D1DurWeaponHit;
	}
}

U0 D1PlayerDie()
{
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Misc\\Dead.wav");
	d1_plr_mode     = D1PM_DEATH;
	d1_plr_frame    = 1;
	d1_plr_animcnt  = 0;
	d1_plr_deadtime = 0;
	d1_path_len     = 0;
	d1_path_pos     = 0;
	d1_plr_target   = -1;
}

U0 D1CheckTriggers()
{//standing on stairs warps; the shell performs the load
	if (d1_currlevel == 0)
	{
		if (d1_plr_x == 25 && d1_plr_y == 29)
		{
			d1_warp_to    = 1;
			d1_warp_entry = 0;
		}
	}
	else
	{
		if (d1_plr_x == d1_trig_up_x && d1_plr_y == d1_trig_up_y)
		{
			d1_warp_to    = d1_currlevel - 1;
			d1_warp_entry = 1;
		}
		if (d1_plr_x == d1_trig_down_x && d1_plr_y == d1_trig_down_y)
		{
			if (d1_currlevel < 16)
			{
				d1_warp_to    = d1_currlevel + 1;
				d1_warp_entry = 0;
			}
		}
	}
}

U8 d1_trig_label[32];

U8 *D1TrigLabelAt(I64 tx, I64 ty)
{//trigs.cpp CheckTriggers strings for the tile under the cursor, NULL when
 //no trigger is there. town holds one trigger, (25,29), retail
 //InitTownTriggers.
	if (d1_currlevel == 0)
	{
		if (tx == 25 && ty == 29)
			return "Down to dungeon";
		return NULL;
	}
	if (tx == d1_trig_up_x && ty == d1_trig_up_y)
	{
		if (d1_currlevel == 1)
			return "Up to town";
		StrPrint(d1_trig_label, "Up to level %d", d1_currlevel - 1);
		return d1_trig_label;
	}
	if (tx == d1_trig_down_x && ty == d1_trig_down_y && d1_currlevel < 16)
	{
		StrPrint(d1_trig_label, "Down to level %d", d1_currlevel + 1);
		return d1_trig_label;
	}
	return NULL;
}

//player.cpp ExpLvlsTbl, first entries; level cap where the table ends
I64 d1_exp_tbl[10] = {0, 2000, 4620, 8040, 12489, 18258, 25712, 35309,
	47622, 63364};

U0 D1PlayerLevelUp()
{//NextPlrLevel: five attribute points, derived maxima refreshed
	d1_plr_lvl++;
	d1_plr_pts += 5;
	D1CharRecalc;
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_mana = d1_plr_maxmana;
}

U0 D1PlayerXPCheck()
{
	while (d1_plr_lvl < 10 && d1_plr_exp >= d1_exp_tbl[d1_plr_lvl])
		D1PlayerLevelUp;
}

U0 D1PlayCastFirebolt(I64 tx, I64 ty)
{//right-click spell; costs 6 mana
	I64 dmg;

	if (!d1_play_ready || d1_plr_dead || d1_currlevel == 0)
		return;
	if (d1_plr_mana < 6 << 6)
		return;

	d1_plr_mana -= 6 << 6;
	d1_plr_dir = D1GetDir(tx - d1_plr_x, ty - d1_plr_y);
	dmg = (2 + D1Rnd(8) + d1_plr_lvl) << 6;
	D1MisSpawn(D1MIS_FIREBOLT, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Misc\\Fbolt1.wav");
}

U0 D1PlayTick()
{//20Hz game tick
	I64	 dir;
	I64	 nf;
	I64	 dx;
	I64	 dy;
	I64	 oi;
	I64	 dam;
	I64	 ticks;
	I64	 prog;
	U8	*grp;

	if (!d1_play_ready)
		return;

	D1FloatTick;

	if (d1_plr_dead && d1_plr_mode != D1PM_DEATH)
		D1PlayerDie;

	d1_plr_tile_x = d1_plr_x;
	d1_plr_tile_y = d1_plr_y;

	if (d1_plr_hitpend > 0)
	{//StartPlrHit from D1PlrHurt (Mon include is earlier)
		dam = d1_plr_hitpend;
		d1_plr_hitpend = 0;
		if (!d1_plr_dead && (dam >> 6) >= d1_plr_lvl &&
			d1_plr_mode != D1PM_DEATH)
		{
			d1_plr_mode    = D1PM_HIT;
			d1_plr_frame   = 1;
			d1_plr_animcnt = 0;
			d1_plr_step    = 0;
			d1_plr_xoff    = 0;
			d1_plr_yoff    = 0;
			d1_path_len    = 0;
			d1_path_pos    = 0;
			//ArghClang (Warior69) already fired by D1Mon/D1Mis hit path
		}
	}

	if (d1_plr_hitflash > 0)
		d1_plr_hitflash--;
	if (d1_talk_timer > 0)
		d1_talk_timer--;

	if (d1_plr_mode == D1PM_DEATH)
	{
		grp = D1PlrGrp(D1PG_DT);
		if (grp)
		{
			nf = D1CelNFrames(grp);
			d1_plr_animcnt++;
			if (d1_plr_animcnt > D1_DEATH_DELAY)
			{
				d1_plr_animcnt = 0;
				if (d1_plr_frame < nf)
					d1_plr_frame++;
			}
		}
		d1_plr_deadtime++;
		if (d1_plr_deadtime > 60)
		{//back to town, restored
			d1_plr_hp   = d1_plr_maxhp;
			d1_plr_dead = FALSE;
			d1_plr_mode = D1PM_STAND;
			d1_plr_frame   = 1;
			d1_plr_animcnt = 0;
			d1_warp_to  = 0;
			d1_warp_entry = 0;
		}
		return;
	}

	//queued path (also re-armed after walk below so tile finish chains)
	if (d1_plr_mode == D1PM_STAND && d1_path_pos < d1_path_len)
	{
		dir = d1_path[d1_path_pos];
		if (D1StepOk(d1_plr_x, d1_plr_y, dir))
		{
			d1_path_pos++;
			D1WalkStart(dir);
		}
		else
		{
			d1_path_len = 0;
			d1_path_pos = 0;
		}
	}

	//fight the target once path is exhausted
	if (d1_plr_mode == D1PM_STAND && d1_plr_target >= 0)
	{
		if (D1MonAtTile(d1_mons[d1_plr_target].x,
			d1_mons[d1_plr_target].y) != d1_plr_target)
			d1_plr_target = -1;		//died or moved on
		else
		{
			dx = d1_mons[d1_plr_target].x - d1_plr_x;
			dy = d1_mons[d1_plr_target].y - d1_plr_y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
				D1AttackStart(D1GetDir(dx, dy));
			else if (d1_path_pos >= d1_path_len)
				D1PathFind(d1_plr_x, d1_plr_y, d1_mons[d1_plr_target].x,
					d1_mons[d1_plr_target].y, TRUE);
		}
	}

	if (d1_plr_mode == D1PM_ATTACK)
	{
		grp = D1PlrGrp(D1PG_AT);
		nf  = 16;
		if (grp)
			nf = D1CelNFrames(grp);
		d1_plr_frame++;
		if (d1_plr_frame == D1_PLR_AFNUM)
		{//DoAttack: mon first, else PlrHitObj on the facing tile
			if (d1_plr_target >= 0)
			{
				dx = d1_mons[d1_plr_target].x - d1_plr_x;
				dy = d1_mons[d1_plr_target].y - d1_plr_y;
				if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
					D1PlayerAttackRoll(d1_plr_target);
			}
			else
				D1ObjHitAt(d1_plr_x + d1_dir_dx[d1_plr_dir],
					d1_plr_y + d1_dir_dy[d1_plr_dir]);
		}
		if (d1_plr_frame > nf)
		{
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
		}
	}
	else if (d1_plr_mode == D1PM_WALK)
	{//DoWalk + GetOffsetForWalking: pixel offset tracks anim progress;
	 //tile completes when the walk strip finishes - last frame held, no wrap.
		dx = d1_dir_dx[d1_plr_dir];
		dy = d1_dir_dy[d1_plr_dir];
		grp = D1PlrGrp(D1PlrGfxSlotWalk());
		nf  = 8;
		if (grp)
			nf = D1CelNFrames(grp);
		if (nf < 1)
			nf = 1;
		//town jog shortens the walk; dungeon uses the full strip length
		ticks = nf;
		if (D1WalkTicks() < nf)
			ticks = D1WalkTicks();

		d1_plr_step++;
		prog = d1_plr_step;
		if (prog > ticks)
			prog = ticks;
		d1_plr_xoff = (32 * (dx - dy) * prog) / ticks;
		d1_plr_yoff = (16 * (dx + dy) * prog) / ticks;
		d1_plr_frame = 1 + ((prog - 1) * nf) / ticks;
		if (d1_plr_frame < 1)
			d1_plr_frame = 1;
		if (d1_plr_frame > nf)
			d1_plr_frame = nf;

		if (d1_plr_step >= ticks)
		{
			d1_plr_x    += d1_dir_dx[d1_plr_dir];
			d1_plr_y    += d1_dir_dy[d1_plr_dir];
			d1_plr_xoff  = 0;
			d1_plr_yoff  = 0;
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
			d1_plr_step  = 0;
			d1_plr_tile_x = d1_plr_x;
			d1_plr_tile_y = d1_plr_y;
			D1ItemAutoPickup(d1_plr_x, d1_plr_y);
			if (d1_plr_obj_x >= 0 &&
				d1_plr_obj_x >= d1_plr_x - 1 && d1_plr_obj_x <= d1_plr_x + 1 &&
				d1_plr_obj_y >= d1_plr_y - 1 && d1_plr_obj_y <= d1_plr_y + 1)
			{
				d1_plr_dir = D1GetDir(d1_plr_obj_x - d1_plr_x,
					d1_plr_obj_y - d1_plr_y);
				oi = D1ObjAtTile(d1_plr_obj_x, d1_plr_obj_y);
				if (D1ObjIsBreakable(oi))
					D1AttackStart(d1_plr_dir);
				else
					D1ObjOperate(d1_plr_obj_x, d1_plr_obj_y, d1_currlevel);
				d1_plr_obj_x = -1;
			}
			if (d1_plr_talk_x >= 0 &&
				d1_plr_talk_x >= d1_plr_x - 1 && d1_plr_talk_x <= d1_plr_x + 1 &&
				d1_plr_talk_y >= d1_plr_y - 1 && d1_plr_talk_y <= d1_plr_y + 1)
			{
				d1_plr_dir = D1GetDir(d1_plr_talk_x - d1_plr_x,
					d1_plr_talk_y - d1_plr_y);
				if (!D1StoreEnter(D1TownerAt(d1_plr_talk_x, d1_plr_talk_y)))
				{
					d1_talk_txt   = D1TownerQuote(D1TownerAt(d1_plr_talk_x,
						d1_plr_talk_y));
					d1_talk_timer = 80;
				}
				d1_plr_talk_x = -1;
			}
			D1PlayerXPCheck;
			D1LightUpdate(d1_plr_x, d1_plr_y);
			D1CheckTriggers;
		}
	}
	else if (d1_plr_mode == D1PM_HIT)
	{//DoGotHit: HT strip, delay 0, then StartStand
		grp = D1PlrGrp(D1PG_HT);
		nf  = 8;
		if (grp)
			nf = D1CelNFrames(grp);
		d1_plr_frame++;
		if (d1_plr_frame > nf)
		{
			d1_plr_mode  = D1PM_STAND;
			d1_plr_frame = 1;
			d1_plr_animcnt = 0;
		}
	}
	else
	{//stand cycle, player.cpp StartStand: NewPlrAnim delay 3, one frame every
	 //fourth game tick
		grp = D1PlrGrp(D1PlrGfxSlotStand());
		if (grp)
		{
			nf = D1CelNFrames(grp);
			d1_plr_animcnt++;
			if (d1_plr_animcnt > D1_STAND_DELAY)
			{
				d1_plr_animcnt = 0;
				d1_plr_frame++;
				if (d1_plr_frame > nf)
					d1_plr_frame = 1;
			}
		}
	}

	//queued path: after mode so walk-complete -> STAND chains next step now
	if (d1_plr_mode == D1PM_STAND && d1_path_pos < d1_path_len)
	{
		dir = d1_path[d1_path_pos];
		if (D1StepOk(d1_plr_x, d1_plr_y, dir))
		{
			d1_path_pos++;
			D1WalkStart(dir);
		}
		else
		{
			d1_path_len = 0;
			d1_path_pos = 0;
		}
	}

	//camera rides the walk offset
	d1_view_x    = d1_plr_x;
	d1_view_y    = d1_plr_y;
	d1_view_xoff = d1_plr_xoff;
	d1_view_yoff = d1_plr_yoff;
}

//remote peer sprites. The drawer is defined at the end of this file, after
//the peer table it reads; a pointer bridges the single-pass include order.
U0 (*d1_peer_draw_cb)(I64 x, I64 y, I64 sx, I64 sy) = NULL;

U0 D1PlayCellCb(I64 x, I64 y, I64 sx, I64 sy)
{//sprite pass. items under actors; objects AFTER the local player so an
 //opened chest that shares the tile (loot drop, walk-on) covers the
 //feet instead of the warrior standing on the lid.
	U8	*grp;
	I64	 frame;
	I64	 slot;
	I64	 w;

	if (!d1_play_ready)
		return;

	D1ItemDrawCell(x, y, sx, sy);
	D1MonDrawCell(x, y, sx, sy);
	if (d1_currlevel == 0)
		D1TownerDrawCell(x, y, sx, sy);
	if (d1_peer_draw_cb)
		(*d1_peer_draw_cb)(x, y, sx, sy);

	if (x == d1_plr_x && y == d1_plr_y)
	{
		if (d1_plr_mode == D1PM_WALK)
			slot = D1PlrGfxSlotWalk();
		else if (d1_plr_mode == D1PM_ATTACK)
			slot = D1PG_AT;
		else if (d1_plr_mode == D1PM_DEATH)
			slot = D1PG_DT;
		else if (d1_plr_mode == D1PM_HIT)
			slot = D1PG_HT;
		else
			slot = D1PlrGfxSlotStand();

		grp = D1PlrGrp(slot);
		if (!grp)
			grp = D1PlrGrp(D1PlrGfxSlotStand());
		if (grp)
		{
			frame = d1_plr_frame;
			if (frame > D1CelNFrames(grp))
				frame = 1;
			w = D1PlrGfxW(slot);
			D1Cl2Draw(sx - (w - 64) / 2 + d1_plr_xoff, sy + d1_plr_yoff,
				grp, frame, w);
		}
	}

	D1ObjDrawCell(x, y, sx, sy);
	//arch / open-door specials over everything on the cell (scrollrt)
	if (d1_special_cel)
	{
		w = d1_dspecial[x + y * D1_MAXDUN];
		if (w && w <= D1CelNFrames(d1_special_cel))
			D1CelDrawClipped(sx, sy, d1_special_cel, w, 64);
	}
}

U8 *D1PlrGfxNameW(U8 *dst, U8 *wep, U8 *suffix)
{//PlrGFX\<dir>\<c>l<w>\<c>l<w><suffix>.cl2 - light armor for every class;
 //the armor/weapon codes track equipment upstream
	StrPrint(dst, "PlrGFX\\%s\\%sl%s\\%sl%s%s.cl2",
		d1_cls_dir[d1_plr_class], d1_cls_code[d1_plr_class], wep,
		d1_cls_code[d1_plr_class], wep, suffix);
	return dst;
}

U8 *D1PlrGfxName(U8 *dst, U8 *suffix)
{//sword+shield, the port's fixed loadout
	return D1PlrGfxNameW(dst, "s", suffix);
}

Bool D1PlayInit()
{//all gfx sets stay resident; ~1MB total
	I64 size = 0;
	U8	path[64];
	I64 i;

	if (d1_plr_gfx_init && d1_plr_gfx_class != d1_plr_class)
	{//class changed: drop the old set
		for (i = 0; i < 7; i++)
		{
			if (d1_plr_gfx[i])
				Free(d1_plr_gfx[i]);
			d1_plr_gfx[i] = NULL;
		}
		d1_plr_gfx_init = FALSE;
	}

	if (!d1_plr_gfx_init)
	{
		for (i = 0; i < 7; i++)
			d1_plr_gfx[i] = NULL;
		d1_plr_gfx[D1PG_ST] = D1MpqRead(D1PlrGfxName(path, "st"), &size);
		d1_plr_gfx[D1PG_WL] = D1MpqRead(D1PlrGfxName(path, "wl"), &size);
		d1_plr_gfx[D1PG_AS] = D1MpqRead(D1PlrGfxName(path, "as"), &size);
		d1_plr_gfx[D1PG_AW] = D1MpqRead(D1PlrGfxName(path, "aw"), &size);
		d1_plr_gfx[D1PG_AT] = D1MpqRead(D1PlrGfxName(path, "at"), &size);
		d1_plr_gfx[D1PG_HT] = D1MpqRead(D1PlrGfxName(path, "ht"), &size);
		//DT ships only under the unarmed weapon code; LoadPlrGFX zeroes
		//_pgfxnum before PFILE_DEATH for the same reason
		d1_plr_gfx[D1PG_DT] = D1MpqRead(D1PlrGfxNameW(path, "n", "dt"), &size);
		d1_plr_gfx_init  = TRUE;
		d1_plr_gfx_class = d1_plr_class;
	}

	if (!d1_plr_gfx[D1PG_ST] || !d1_plr_gfx[D1PG_WL])
	{
		"D1Play: player gfx missing\n";
		return FALSE;
	}

	if (!d1_seeds_init)
	{
		D1SetRndSeed(ToI64(tS * 1000.0));
		for (i = 0; i < 17; i++)
			d1_lvl_seeds[i] = D1GetRndSeed();
		d1_seeds_init = TRUE;
	}

	d1_plr_mode  = D1PM_STAND;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_plr_xoff  = 0;
	d1_plr_yoff  = 0;
	d1_path_len  = 0;
	d1_path_pos  = 0;
	d1_plr_target = -1;
	d1_warp_to   = -1;

	d1_cell_sprite_cb = &D1PlayCellCb;
	D1MisHookInit;
	d1_play_ready     = TRUE;
	return TRUE;
}

U0 D1PlacePlayer(I64 x, I64 y)
{//nudge to the nearest open tile
	I64 d;
	I64 t;

	if (!D1Walkable(x, y))
	{
		t = -1;
		for (d = 0; d < 8; d++)
		{
			if (t < 0 && D1Walkable(x + d1_dir_dx[d], y + d1_dir_dy[d]))
				t = d;
		}
		if (t >= 0)
		{
			x += d1_dir_dx[t];
			y += d1_dir_dy[t];
		}
	}

	d1_plr_x = x;
	d1_plr_y = y;
	d1_plr_tile_x = x;
	d1_plr_tile_y = y;
	d1_view_x = x;
	d1_view_y = y;
	d1_view_xoff = 0;
	d1_view_yoff = 0;
	d1_plr_xoff = 0;
	d1_plr_yoff = 0;
	d1_plr_mode = D1PM_STAND;
	d1_plr_frame = 1;
	d1_plr_animcnt = 0;
	d1_path_len = 0;
	d1_path_pos = 0;
	d1_plr_target = -1;
}

//--- multiplayer peer simulation -------------------------------------------
//
// devilution runs peer-to-peer lockstep: every machine executes the same
// commands for turn N and arrives at the same world. Here every peer,
// including the local one, moves through D1PeerTick over the same command
// stream, so the local player is not a special case - what draws on this
// machine for turn N is what the other machine computed for turn N.
//
// peers are executed in slot order, 0 first, on every machine. That order is
// what fixes the sequence D1Rnd is consumed in.
//
// deviations from retail, all forced by what this port carries:
//   - peers share one loaded level: any peer taking stairs warps all of them.
//     Retail keeps a level per player and streams deltas (msg.cpp DeltaLoad).
//   - a ground item is removed on every peer when one walks over it. Whether
//     it fits in the taker's pack is local knowledge and cannot gate a shared
//     world edit; an item that does not fit is lost.
//   - spells, missiles and the mana shield are off in a session. Their code
//     is outside this file's reach, so their rolls cannot be brought into the
//     shared RNG window.

//per-class gfx sets for remote peers, loaded on demand. The local player
//keeps d1_plr_gfx; sharing one cache per class costs nothing extra when two
//peers pick the same class.
U8	*d1_cls_gfx[D1_NCLASS * 7];
Bool d1_cls_gfx_ok[D1_NCLASS];

U0 D1PeerGfxClear()
{//globals are not zeroed
	I64 i;

	for (i = 0; i < D1_NCLASS * 7; i++)
		d1_cls_gfx[i] = NULL;
	for (i = 0; i < D1_NCLASS; i++)
		d1_cls_gfx_ok[i] = FALSE;
}

U8 *D1ClsGfxName(U8 *dst, I64 cls, U8 *wep, U8 *suffix)
{//D1PlrGfxNameW against an explicit class rather than the local one
	StrPrint(dst, "PlrGFX\\%s\\%sl%s\\%sl%s%s.cl2",
		d1_cls_dir[cls], d1_cls_code[cls], wep,
		d1_cls_code[cls], wep, suffix);
	return dst;
}

Bool D1PeerGfxLoad(I64 cls)
{
	I64	 size = 0;
	U8	 path[64];
	I64	 b;

	if (cls < 0 || cls >= D1_NCLASS)
		return FALSE;
	if (d1_cls_gfx_ok[cls])
		return TRUE;

	b = cls * 7;
	d1_cls_gfx[b + D1PG_ST] = D1MpqRead(D1ClsGfxName(path, cls, "s", "st"),
		&size);
	d1_cls_gfx[b + D1PG_WL] = D1MpqRead(D1ClsGfxName(path, cls, "s", "wl"),
		&size);
	d1_cls_gfx[b + D1PG_AS] = D1MpqRead(D1ClsGfxName(path, cls, "s", "as"),
		&size);
	d1_cls_gfx[b + D1PG_AW] = D1MpqRead(D1ClsGfxName(path, cls, "s", "aw"),
		&size);
	d1_cls_gfx[b + D1PG_AT] = D1MpqRead(D1ClsGfxName(path, cls, "s", "at"),
		&size);
	d1_cls_gfx[b + D1PG_HT] = D1MpqRead(D1ClsGfxName(path, cls, "s", "ht"),
		&size);
	//DT ships only under the unarmed weapon code, as LoadPlrGFX's
	//_pgfxnum reset before PFILE_DEATH records
	d1_cls_gfx[b + D1PG_DT] = D1MpqRead(D1ClsGfxName(path, cls, "n", "dt"),
		&size);

	if (!d1_cls_gfx[b + D1PG_ST])
		return FALSE;
	d1_cls_gfx_ok[cls] = TRUE;
	return TRUE;
}

Bool D1PeerAtTile(I64 x, I64 y)
{//any live peer standing on or stepping into this tile
	I64 i;

	if (!d1_net_on)
		return ToBool(x == d1_plr_tile_x && y == d1_plr_tile_y);
	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].dead &&
			d1_peers[i].x == x && d1_peers[i].y == y)
			return TRUE;
	}
	return FALSE;
}

U0 D1PeerPathFind(I64 pidx, I64 tx, I64 ty, Bool adjacent_ok)
{//the shared A*/BFS, copied into the peer's own queue. Both are pure
 //functions of the grid, so every machine gets the same steps.
	CD1Peer *p = &d1_peers[pidx];
	I64 i;

	p->pathlen = 0;
	p->pathpos = 0;
	if (!D1PathFind(p->x, p->y, tx, ty, adjacent_ok))
		return;
	if (d1_path_len > D1NET_PATHMAX)
		d1_path_len = D1NET_PATHMAX;
	for (i = 0; i < d1_path_len; i++)
		p->path[i] = d1_path[i];
	p->pathlen = d1_path_len;
	p->pathpos = 0;
}

U0 D1PeerAttackRoll(I64 pidx, I64 mi)
{//D1PlayerAttackRoll against the stats shipped in the peer record, so the
 //roll and its RNG draw are identical on every machine
	CD1Peer *p = &d1_peers[pidx];
	I64 chance;
	I64 dmg;

	if (mi < 0 || mi >= d1_nmons)
		return;
	chance = 50 + p->dex / 2 + p->lvl - d1_montypes[d1_mons[mi].type].ac;
	if (chance < 20)
		chance = 20;
	if (D1Rnd(100) < chance)
	{
		dmg = p->dmin + D1Rnd(p->dmax - p->dmin + 1) +
			(p->str * p->lvl) / 100;
		d1_mon_hurt_by = pidx;
		D1MonHurt(mi, dmg << 6);
		d1_mon_hurt_by = -1;
		if (p->local)
			D1DurWeaponHit;			//local equipment only, draws no RNG
	}
}

U0 D1PeerPickup(I64 pidx, I64 x, I64 y)
{//the world edit happens on every machine; the pack only on the owner's
	CD1Peer *p = &d1_peers[pidx];
	I64 ii;

	if (p->local)
	{
		D1ItemPickup(x, y);
		//lost when the pack is full: the removal below is unconditional
	}
	ii = d1_ditem[x + y * D1_MAXDUN];
	if (ii)
	{
		d1_items[ii - 1].active = FALSE;
		d1_ditem[x + y * D1_MAXDUN] = 0;
	}
}

U0 D1PeerApplyCmd(I64 pidx, I64 cmd, I64 a, I64 b, I64 c)
{//one turn's input for one peer. msg.cpp's ParseCmd dispatch reduced.
	CD1Peer *p = &d1_peers[pidx];
	I64 dx;
	I64 dy;
	I64 hp_max;
	I64 mn_max;
	I64 heal;
	I64 mana;

	no_warn c;
	if (p->dead)
		return;

	if (cmd == D1NC_WALK)
	{
		p->target = -1;
		D1PeerPathFind(pidx, a, b, FALSE);
	}
	else if (cmd == D1NC_ATTACK)
	{
		if (a >= 0 && a < d1_nmons)
		{
			p->target = a;
			D1PeerPathFind(pidx, d1_mons[a].x, d1_mons[a].y, TRUE);
		}
	}
	else if (cmd == D1NC_STAND)
	{//SHIFT-click: swing toward the tile without pathing to it
		p->target  = -1;
		p->pathlen = 0;
		p->pathpos = 0;
		if (p->mode == D1PM_STAND)
		{
			p->dir     = D1GetDir(a - p->x, b - p->y);
			p->mode    = D1PM_ATTACK;
			p->frame   = 1;
			p->animcnt = 0;
		}
	}
	else if (cmd == D1NC_PICKUP)
		D1PeerPickup(pidx, a, b);
	else if (cmd == D1NC_OPEN)
	{
		dx = a - p->x;
		dy = b - p->y;
		if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
		{
			p->dir = D1GetDir(dx, dy);
			D1ObjOperate(a, b, d1_currlevel);
		}
	}
	else if (cmd == D1NC_BELT)
	{//the misc code travels with the command: what sits in another peer's
	 //belt is not known here, and the potion roll must still be drawn
		hp_max = p->maxhp;
		mn_max = p->maxmana;
		heal   = 0;
		mana   = 0;

		if (b == D1IM_HEAL || b == D1IM_REJUV)
			heal = hp_max / 2 + D1Rnd(hp_max / 4 + 1);
		if (b == D1IM_MANA || b == D1IM_REJUV)
			mana = mn_max / 2 + D1Rnd(mn_max / 4 + 1);
		if (b == D1IM_FULLHEAL || b == D1IM_FULLREJUV)
			heal = hp_max;
		if (b == D1IM_FULLMANA || b == D1IM_FULLREJUV)
			mana = mn_max;

		p->hp += heal;
		if (p->hp > hp_max)
			p->hp = hp_max;
		p->mana += mana;
		if (p->mana > mn_max)
			p->mana = mn_max;
		if (p->local)
		{
			d1_plr_hp   = p->hp;
			d1_plr_mana = p->mana;
			if (a >= 0 && a < 8)
				d1_belt[a] = 0;
		}
	}
	else if (cmd == D1NC_WARP)
	{//one level is loaded for the whole session; the shell performs it
		d1_warp_to    = a;
		d1_warp_entry = b;
	}
}

U0 D1PeerTick(I64 pidx)
{//D1PlayTick's motion, per peer. No local state is read here.
	CD1Peer *p = &d1_peers[pidx];
	I64	 dir;
	I64	 nf;
	I64	 dx;
	I64	 dy;
	U8	*grp;
	I64	 b;

	if (!p->used)
		return;

	b   = p->cls * 7;
	grp = NULL;

	if (p->dead)
		return;

	//queued path
	if (p->mode == D1PM_STAND && p->pathpos < p->pathlen)
	{
		dir = p->path[p->pathpos];
		if (D1StepOk(p->x, p->y, dir) &&
			!D1PeerAtTile(p->x + d1_dir_dx[dir], p->y + d1_dir_dy[dir]))
		{
			p->pathpos++;
			p->dir     = dir;
			p->mode    = D1PM_WALK;
			p->step    = 0;
			p->frame   = 1;
			p->animcnt = 0;
			p->xoff    = 0;
			p->yoff    = 0;
		}
		else
		{
			p->pathlen = 0;
			p->pathpos = 0;
		}
	}

	//fight the target once the path is spent
	if (p->mode == D1PM_STAND && p->target >= 0)
	{
		if (D1MonAtTile(d1_mons[p->target].x, d1_mons[p->target].y) !=
			p->target)
			p->target = -1;
		else
		{
			dx = d1_mons[p->target].x - p->x;
			dy = d1_mons[p->target].y - p->y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
			{
				p->dir     = D1GetDir(dx, dy);
				p->mode    = D1PM_ATTACK;
				p->frame   = 1;
				p->animcnt = 0;
			}
			else if (p->pathpos >= p->pathlen)
				D1PeerPathFind(pidx, d1_mons[p->target].x, d1_mons[p->target].y,
					TRUE);
		}
	}

	if (p->mode == D1PM_ATTACK)
	{
		nf = 16;
		if (d1_cls_gfx_ok[p->cls] && d1_cls_gfx[b + D1PG_AT])
			nf = D1CelNFrames(D1Cl2Dir(d1_cls_gfx[b + D1PG_AT], p->dir));
		p->frame++;
		if (p->frame == D1_PLR_AFNUM && p->target >= 0)
		{
			dx = d1_mons[p->target].x - p->x;
			dy = d1_mons[p->target].y - p->y;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
				D1PeerAttackRoll(pidx, p->target);
		}
		if (p->frame > nf)
		{
			p->mode    = D1PM_STAND;
			p->frame   = 1;
			p->animcnt = 0;
		}
	}
	else if (p->mode == D1PM_WALK)
	{
		p->step++;
		p->xoff = (32 * (d1_dir_dx[p->dir] - d1_dir_dy[p->dir]) * p->step) /
			D1_WALK_TICKS;
		p->yoff = (16 * (d1_dir_dx[p->dir] + d1_dir_dy[p->dir]) * p->step) /
			D1_WALK_TICKS;
		if (d1_cls_gfx_ok[p->cls])
		{
			if (d1_currlevel == 0)
				grp = d1_cls_gfx[b + D1PG_WL];
			else
				grp = d1_cls_gfx[b + D1PG_AW];
		}
		if (grp)
		{
			nf = D1CelNFrames(D1Cl2Dir(grp, p->dir));
			p->frame = 1 + ((p->step - 1) * nf) / D1_WALK_TICKS;
			if (p->frame < 1)
				p->frame = 1;
			if (p->frame > nf)
				p->frame = nf;
		}
		if (p->step >= D1_WALK_TICKS)
		{
			p->x      += d1_dir_dx[p->dir];
			p->y      += d1_dir_dy[p->dir];
			p->xoff    = 0;
			p->yoff    = 0;
			p->mode    = D1PM_STAND;
			p->frame   = 1;
			p->animcnt = 0;
			p->step    = 0;
			if (d1_ditem[p->x + p->y * D1_MAXDUN])
				D1PeerPickup(pidx, p->x, p->y);
		}
	}
	else
	{//stand cycle, StartStand's delay 3
		if (d1_cls_gfx_ok[p->cls])
		{
			if (d1_currlevel == 0)
				grp = d1_cls_gfx[b + D1PG_ST];
			else
				grp = d1_cls_gfx[b + D1PG_AS];
		}
		if (grp)
		{
			nf = D1CelNFrames(D1Cl2Dir(grp, p->dir));
			p->animcnt++;
			if (p->animcnt > D1_STAND_DELAY)
			{
				p->animcnt = 0;
				p->frame++;
				if (p->frame > nf)
					p->frame = 1;
			}
		}
	}
}

U0 D1PeerTickAll()
{//slot order, on every machine. This is the order D1Rnd is consumed in.
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
			D1PeerTick(i);
	}
}

U0 D1PeerFromLocal()
{//push the local character into its slot. Called before the session goes
 //live and after anything that changes a combat input: level up, equipment.
	CD1Peer *p = &d1_peers[d1_net_self];

	p->used    = TRUE;
	p->local   = TRUE;
	p->cls     = d1_plr_class;
	p->lvl     = d1_plr_lvl;
	p->str     = d1_plr_str;
	p->dex     = d1_plr_dex;
	p->ac      = D1InvAC();
	p->dmin    = D1InvDmgMin();
	p->dmax    = D1InvDmgMax();
	p->hp      = d1_plr_hp;
	p->maxhp   = d1_plr_maxhp;
	p->mana    = d1_plr_mana;
	p->maxmana = d1_plr_maxmana;
	p->dlvl    = d1_currlevel;
	p->dead    = d1_plr_dead;
	D1StrCopy(p->name, d1_plr_name, 32);
}

U0 D1PeerPlaceLocal()
{//the simulated position starts where the shell dropped the player
	CD1Peer *p = &d1_peers[d1_net_self];

	p->x       = d1_plr_x;
	p->y       = d1_plr_y;
	p->dir     = d1_plr_dir;
	p->mode    = D1PM_STAND;
	p->frame   = 1;
	p->animcnt = 0;
	p->step    = 0;
	p->xoff    = 0;
	p->yoff    = 0;
	p->target  = -1;
	p->pathlen = 0;
	p->pathpos = 0;
}

U0 D1PeerToLocal()
{//pull the simulated position back out. The player globals stay the single
 //source the renderer, the automap and the panel read.
	CD1Peer *p = &d1_peers[d1_net_self];

	d1_plr_x      = p->x;
	d1_plr_y      = p->y;
	d1_plr_tile_x = p->x;
	d1_plr_tile_y = p->y;
	d1_plr_dir    = p->dir;
	d1_plr_mode   = p->mode;
	d1_plr_frame  = p->frame;
	d1_plr_animcnt = p->animcnt;
	d1_plr_xoff   = p->xoff;
	d1_plr_yoff   = p->yoff;
	d1_plr_target = p->target;
	d1_plr_hp     = p->hp;
	d1_plr_dead   = p->dead;
	d1_view_x     = p->x;
	d1_view_y     = p->y;
	d1_view_xoff  = p->xoff;
	d1_view_yoff  = p->yoff;
}

U0 D1PeerDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{//remote peers only; the local one still draws through D1PlayCellCb
	CD1Peer *p;
	U8	*grp;
	I64	 i;
	I64	 f;
	I64	 b;
	I64	 slot;
	I64	 w;

	if (!d1_net_on)
		return;
	for (i = 0; i < D1_MAXPEER; i++)
	{
		p = &d1_peers[i];
		if (p->used && !p->local && p->x == x && p->y == y &&
			d1_cls_gfx_ok[p->cls])
		{
			b    = p->cls * 7;
			slot = D1PG_AS;
			grp  = d1_cls_gfx[b + D1PG_AS];
			if (d1_currlevel == 0)
			{
				slot = D1PG_ST;
				grp  = d1_cls_gfx[b + D1PG_ST];
			}
			if (p->mode == D1PM_WALK)
			{
				slot = D1PG_AW;
				grp  = d1_cls_gfx[b + D1PG_AW];
				if (d1_currlevel == 0)
				{
					slot = D1PG_WL;
					grp  = d1_cls_gfx[b + D1PG_WL];
				}
			}
			else if (p->mode == D1PM_ATTACK)
			{
				slot = D1PG_AT;
				grp  = d1_cls_gfx[b + D1PG_AT];
			}
			else if (p->mode == D1PM_DEATH)
			{
				slot = D1PG_DT;
				grp  = d1_cls_gfx[b + D1PG_DT];
			}
			if (!grp)
				return;
			grp = D1Cl2Dir(grp, p->dir);
			f   = p->frame;
			if (f > D1CelNFrames(grp))
				f = 1;
			w = D1PlrGfxW(slot);
			D1Cl2Draw(sx - (w - 64) / 2 + p->xoff, sy + p->yoff, grp, f, w);
			D1TextDrawSolid(sx + 32 - D1TextWidth(p->name) / 2, sy - 44,
				p->name, D1PalBrightest());
		}
	}
}

U0 D1PeerInit()
{//globals are not zeroed, and the draw hook cannot be installed at its
 //definition: D1PlayCellCb compiles first
	D1PeerGfxClear;
	d1_peer_draw_cb = &D1PeerDrawCell;
}

D1PeerInit;

Bool D1PeerNetFrame()
{//one 50 ms frame while lockstep is live. FALSE = stalled on a peer.
	I64 i;
	I64 cmd;
	I64 a;
	I64 b;
	I64 c;
	CD1Peer *p;

	D1NetPump;
	if (D1NetTurnDue())
	{
		if (!D1NetTurnReady())
		{
			//TurnDue already zeroed the counter; hold the boundary
			d1_net_tick = D1NET_TICKS;
			return FALSE;
		}
		D1NetSimEnter;
		for (i = 0; i < D1_MAXPEER; i++)
		{
			if (d1_peers[i].used)
			{
				D1NetTakeCmd(i, d1_net_turn, &cmd, &a, &b, &c);
				D1PeerApplyCmd(i, cmd, a, b, c);
			}
		}
		D1NetTurnDone;
	}
	else
		D1NetSimEnter;

	D1PeerTickAll;
	D1MonTickAll;
	D1ItemTickAll;
	D1ObjTickAll;
	D1NetSimLeave;
	D1PeerToLocal;
	//stairs: latch D1NC_WARP for the local peer. D1CheckTriggers is SP-only
	//because D1PlayTick does not run in a session.
	p = &d1_peers[d1_net_self];
	if (p->used && !p->dead && p->mode == D1PM_STAND)
	{
		if (d1_currlevel == 0)
		{
			if (p->x == 25 && p->y == 29)
				D1NetQueue(D1NC_WARP, 1, 0, 0);
		}
		else if (p->x == d1_trig_up_x && p->y == d1_trig_up_y)
			D1NetQueue(D1NC_WARP, d1_currlevel - 1, 1, 0);
		else if (p->x == d1_trig_down_x && p->y == d1_trig_down_y &&
			d1_currlevel < 16)
			D1NetQueue(D1NC_WARP, d1_currlevel + 1, 0, 0);
	}
	return TRUE;
}

I64 D1PeerSnapHash()
{//fingerprint of the shared sim: peers, monsters, ground items, RNG.
 //used by the lockstep harness; a packet round-trip alone proves nothing.
 //ZealC has no continue: filter with plain if.
	I64 hash = d1_seed;
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
		{
			hash = hash * 31 + d1_peers[i].x;
			hash = hash * 31 + d1_peers[i].y;
			hash = hash * 31 + d1_peers[i].hp;
			hash = hash * 31 + d1_peers[i].dead;
			hash = hash * 31 + d1_peers[i].mode;
			hash = hash * 31 + d1_peers[i].target;
		}
	}
	for (i = 0; i < d1_nmons; i++)
	{
		if (d1_mons[i].active)
		{
			hash = hash * 31 + d1_mons[i].x;
			hash = hash * 31 + d1_mons[i].y;
			hash = hash * 31 + d1_mons[i].hp;
			hash = hash * 31 + d1_mons[i].mode;
			hash = hash * 31 + d1_mons[i].dir;
		}
	}
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active)
		{
			hash = hash * 31 + d1_items[i].x;
			hash = hash * 31 + d1_items[i].y;
			hash = hash * 31 + d1_items[i].itm;
		}
	}
	return hash;
}

U0 D1PeerFill(I64 pidx, Bool local, U8 *name, I64 x, I64 y)
{//seed a peer record from the local character's combat inputs
	CD1Peer *p = &d1_peers[pidx];

	D1PeerClear(pidx);
	p->used    = TRUE;
	p->local   = local;
	p->cls     = d1_plr_class;
	p->lvl     = d1_plr_lvl;
	p->str     = d1_plr_str;
	p->dex     = d1_plr_dex;
	p->ac      = D1InvAC();
	p->dmin    = D1InvDmgMin();
	p->dmax    = D1InvDmgMax();
	p->hp      = d1_plr_maxhp;
	p->maxhp   = d1_plr_maxhp;
	p->mana    = d1_plr_maxmana;
	p->maxmana = d1_plr_maxmana;
	p->dlvl    = d1_currlevel;
	p->x       = x;
	p->y       = y;
	p->dir     = 0;
	p->mode    = D1PM_STAND;
	p->frame   = 1;
	p->target  = -1;
	D1StrCopy(p->name, name, 32);
}

U0 D1PeerSimScript(I64 turn, I64 bx0, I64 by0, I64 bx1, I64 by1,
	I64 *c0, I64 *a0, I64 *b0, I64 *c1, I64 *a1, I64 *b1)
{//absolute command stream. both harness passes feed the same numbers; any
 //state-derived input would hide a divergence behind a re-rolled command.
	*c0 = D1NC_NONE; *a0 = 0; *b0 = 0;
	*c1 = D1NC_NONE; *a1 = 0; *b1 = 0;

	if (turn < 8)
	{
		*c0 = D1NC_WALK;
		*a0 = bx0 + 1 + (turn & 3);
		*b0 = by0;
		*c1 = D1NC_WALK;
		*a1 = bx1 - 1 - (turn & 3);
		*b1 = by1;
	}
	else if (turn < 16)
	{
		*c0 = D1NC_WALK;
		*a0 = bx0;
		*b0 = by0 + 1 + (turn & 3);
		*c1 = D1NC_WALK;
		*a1 = bx1;
		*b1 = by1 - 1 - (turn & 3);
	}
	else if (turn < 24)
	{
		//monster 0 is the first spawn from a fixed seed; both passes share it
		*c0 = D1NC_ATTACK;
		*a0 = 0;
		*c1 = D1NC_STAND;
		*a1 = bx1 - 1;
		*b1 = by1;
	}
	else if (turn < 32)
	{
		*c0 = D1NC_STAND;
		*a0 = bx0 + 1;
		*b0 = by0;
		*c1 = D1NC_ATTACK;
		*a1 = 0;
	}
	else
	{
		*c0 = D1NC_WALK;
		*a0 = bx0;
		*b0 = by0;
		*c1 = D1NC_WALK;
		*a1 = bx1;
		*b1 = by1;
		if (turn & 1)
		{
			*a0 = bx0 + 2;
			*a1 = bx1 - 2;
		}
		if (turn & 2)
		{
			*b0 = by0 + 1;
			*b1 = by1 - 1;
		}
	}
}

U0 D1PeerSimRun(I64 *out_hash, I64 nturns, I64 bx0, I64 by0, I64 bx1,
	I64 by1)
{//drive both peers over the scripted stream for nturns. one shared world;
 //re-running from a reset world with the same seed must match every hash.
	I64 t;
	I64 f;
	I64 c0;
	I64 a0;
	I64 b0;
	I64 c1;
	I64 a1;
	I64 b1;

	for (t = 0; t < nturns; t++)
	{
		D1PeerSimScript(t, bx0, by0, bx1, by1, &c0, &a0, &b0, &c1, &a1, &b1);
		D1NetSimEnter;
		D1PeerApplyCmd(0, c0, a0, b0, 0);
		D1PeerApplyCmd(1, c1, a1, b1, 0);
		for (f = 0; f < D1NET_TICKS; f++)
		{
			D1PeerTickAll;
			D1MonTickAll;
			D1ItemTickAll;
			D1ObjTickAll;
		}
		D1NetSimLeave;
		out_hash[t] = D1PeerSnapHash();
	}
}

