// D1Item.ZC - base items, ground drops, inventory storage, the belt
//
// base rows come from D1ItmT (itemdat.cpp AllItemsList, generated). a ground
// item is a base row index plus one instance value: gold amount for gold,
// rolled AC for armor (GetItemAttrs rolls iMinAC..iMaxAC once, at drop).
// drop cels are unclipped 96-wide flip anims under Items\, demand-loaded and
// cached per cel; the resting frame is the last.
//
// inventory storage lives here so pickup can place into it; the screen,
// equip logic and stat getters are D1Inv. grid is 10x4 cells (inv.cpp
// InvGrid): a placed entry writes idx+1 on its bottom-left anchor cell and
// -(idx+1) on the covered rest (AutoPlace convention). belt slots hold a
// base row index, 0 empty; heal=1 and mana=2 keep the D1Panel chip colors.
//
// per-instance state (unique id, identified flag, durability, spell charges,
// the fields GetUniqueItem's powers override) lives here rather than beside
// the affix side tables: D1Inv reads it and the single-pass include order puts
// D1Inv before D1Affix. D1Affix fills it through the hooks below.
//
// staves (itemdat IMISC_STAFF) carry a spell and a charge count in the same
// record. the spell numbering belongs to D1Spell, which compiles later, so the
// roll and the name lookup arrive as installed pointers.

#define D1_MAXITEM		64
#define D1_MAXITMDEF	96
#define D1_MAXIDROP		24
#define D1_MAXINV		40

//fixed base rows (D1ItmT order contract); D1Obj drops by these
#define D1IT_GOLD		0
#define D1IT_HEAL		1
#define D1IT_MANA		2

//itemdat.cpp item_class values
#define D1IC_WEAPON		1
#define D1IC_ARMOR		2
#define D1IC_MISC		3
#define D1IC_GOLD		4

//itemdat.cpp item_equip_type values
#define D1IL_ONEHAND	1
#define D1IL_TWOHAND	2
#define D1IL_ARMOR		3
#define D1IL_HELM		4

//misc codes: potion effects
#define D1IM_HEAL		1
#define D1IM_FULLHEAL	2
#define D1IM_MANA		3
#define D1IM_FULLMANA	4
#define D1IM_REJUV		5
#define D1IM_FULLREJUV	6

//equip slots. left hand holds the weapon, right the shield.
#define D1EQ_HEAD		0
#define D1EQ_BODY		1
#define D1EQ_LEFT		2
#define D1EQ_RIGHT		3
#define D1EQ_N			4

//set when left/right hand changes; D1Play reloads PlrGFX wep letter
Bool d1_wep_gfx_dirty = FALSE;
class CD1ItmDef
{
	U8	 name[32];
	I64	 cls;
	I64	 loc;
	I64	 frame;			//Objcurs.CEL frame (iCurs + CURSOR_FIRSTITEM 12)
	I64	 gw;			//inventory cells
	I64	 gh;
	I64	 dmin;
	I64	 dmax;
	I64	 acmin;
	I64	 acmax;
	I64	 dur;
	I64	 mlvl;			//min monster level to drop
	I64	 minstr;
	I64	 value;
	I64	 misc;			//D1IM_*, 0 for equipment
	I64	 drop;			//index into the drop cel table
	I64	 rnd;			//drop weight; 2 = IDROP_DOUBLE (bows)
	I64	 stf;			//IMISC_STAFF: the row carries a spell and charges
	I64	 snd;			//material sound: d1_isnd_name index,
						//ItemInvSnds[ItemCAnimTbl[iCurs]] (inv.cpp:1158)
};

class CD1Item
{
	I64	 itm;			//base row
	I64	 x;
	I64	 y;
	I64	 val;			//gold amount / rolled AC
	I64	 frame;			//flip anim, counts up to rest
	Bool active;
};

//durability sentinel, items.cpp DUR_INDESTRUCTIBLE
#define D1_DURINF		255

class CD1ItmSt
{//one item instance's state, keyed by ground index / inventory entry /
 //equip slot. D1Affix reads and writes it through D1AffSet*/D1AffGet*.
	I64	 pfx;			//prefix id + 1, 0 = none
	I64	 sfx;			//suffix id + 1, 0 = none
	I64	 pfxval;		//SaveItemPower roll r, param1..param2, at creation
	I64	 sfxval;
	I64	 pfxval2;		//IPL_TOHIT_DAMP second roll: the banded to-hit
	I64	 sfxval2;
	I64	 unq;			//unique id + 1, 0 = not unique
	Bool ident;			//powers apply and the full name shows
	I64	 dur;			//current durability, D1_DURINF = indestructible
	I64	 maxdur;
	I64	 curs;			//IPL_INVCURS Objcurs frame, 0 = the base row frame
	Bool nominstr;		//IPL_NOMINSTR
	Bool onehand;		//IPL_ONEHAND
	I64	 spl;			//_iSpell + 1, 0 = the item casts nothing
	I64	 chg;			//_iCharges
	I64	 maxchg;		//_iMaxCharges
};

CD1ItmDef d1_itmdefs[D1_MAXITMDEF];
I64	 d1_n_itmdefs = 0;

//material sound wav table (effects.cpp sgSFX rows ItemInvSnds selects)
#define D1_MAXISND		16
U8	 d1_isnd_name[D1_MAXISND][32];
I64	 d1_n_isnd = 0;

U8	 d1_idrop_name[D1_MAXIDROP][32];
I64	 d1_idrop_len[D1_MAXIDROP];
U8	*d1_idrop_cel[D1_MAXIDROP];
I64	 d1_n_idrops = 0;

CD1Item d1_items[D1_MAXITEM];
U8	 d1_ditem[D1_MAXDUN * D1_MAXDUN];	//item idx+1
I64	 d1_plr_gold = 0;
I64	 d1_belt[8];						//0 empty, else base row
Bool d1_item_init = FALSE;

//inventory grid + entries + equipment
I64	 d1_inv_grid[D1_MAXINV];			//0 free, +e+1 anchor, -(e+1) covered
I64	 d1_inv_itm[D1_MAXINV];				//base row per entry, -1 free
I64	 d1_inv_val[D1_MAXINV];				//instance value (rolled AC)
I64	 d1_equip_itm[D1EQ_N];				//base row, -1 empty
I64	 d1_equip_val[D1EQ_N];

CD1ItmSt d1_st_ground[D1_MAXITEM];
CD1ItmSt d1_st_inv[D1_MAXINV];
CD1ItmSt d1_st_equip[D1EQ_N];

I64	 d1_inv_last = -1;					//entry D1InvPut claimed last, -1 none

//cursor-held item (player.cpp HoldItem / pcurs >= CURSOR_FIRSTITEM)
I64	 d1_hold_itm = -1;
I64	 d1_hold_val = 0;
CD1ItmSt d1_hold_st;

//deepest dungeon level entered, tracked from the item tick because it runs
//on every level. D1Towner gates quest dialog on it, matching D1QuestLevelEnter.
I64	 d1_deepest_lvl = 0;

//D1Affix installs these once its tables exist; the include order forbids a
//direct call. NULL leaves every item plain and indestructible.
U0	(*d1_pow_drop)(I64 gi, I64 itm, I64 lvl) = NULL;	//roll affixes/unique
U0	(*d1_pow_take)(I64 gi, I64 e)            = NULL;	//ground -> inventory
U0	(*d1_pow_tick)()                         = NULL;	//20Hz upkeep

//D1Spell installs these; it compiles after this file, so the spell numbering
//is reached through pointers rather than by name. NULL leaves staves without
//a spell: they keep their base damage and cast nothing.
U8	*(*d1_spl_name)(I64 s)                       = NULL;	//spelldat sNameText
I64	 (*d1_spl_find)(U8 *name)                    = NULL;	//id by sNameText, -1
I64	 (*d1_spl_cost)(I64 s)                       = NULL;	//spelldat sStaffCost
U0	 (*d1_spl_staff)(I64 lvl, I64 *sp, I64 *ch)  = NULL;	//GetStaffSpell roll

//inv.cpp CheckInvPaste's ILOC_ONEHAND/TWOHAND arm: a staff landing in the
//weapon hand takes the spell selection with it. D1Inv and D1Char both fire it.
U0	 (*d1_pow_equipped)(I64 slot)                = NULL;

U8	*d1_objcurs = NULL;					//Data\Inv\Objcurs.CEL, icon source

U0 D1StClear(CD1ItmSt *s)
{
	s->pfx      = 0;
	s->sfx      = 0;
	s->pfxval   = 0;
	s->sfxval   = 0;
	s->pfxval2  = 0;
	s->sfxval2  = 0;
	s->unq      = 0;
	s->ident    = FALSE;
	s->dur      = 0;
	s->maxdur   = 0;
	s->curs     = 0;
	s->nominstr = FALSE;
	s->onehand  = FALSE;
	s->spl      = 0;
	s->chg      = 0;
	s->maxchg   = 0;
}

U0 D1StCopy(CD1ItmSt *dst, CD1ItmSt *src)
{
	dst->pfx      = src->pfx;
	dst->sfx      = src->sfx;
	dst->pfxval   = src->pfxval;
	dst->sfxval   = src->sfxval;
	dst->pfxval2  = src->pfxval2;
	dst->sfxval2  = src->sfxval2;
	dst->unq      = src->unq;
	dst->ident    = src->ident;
	dst->dur      = src->dur;
	dst->maxdur   = src->maxdur;
	dst->curs     = src->curs;
	dst->nominstr = src->nominstr;
	dst->onehand  = src->onehand;
	dst->spl      = src->spl;
	dst->chg      = src->chg;
	dst->maxchg   = src->maxchg;
}

U0 D1ItmSet(I64 i, U8 *name, I64 cls, I64 loc, I64 frame, I64 gw, I64 gh,
	I64 dmin, I64 dmax, I64 acmin, I64 acmax, I64 dur, I64 mlvl, I64 minstr,
	I64 value, I64 misc, I64 drop, I64 rnd, I64 stf, I64 snd)
{
	CD1ItmDef *d = &d1_itmdefs[i];

	D1StrCopy(d->name, name, 32);
	d->cls    = cls;
	d->loc    = loc;
	d->frame  = frame;
	d->gw     = gw;
	d->gh     = gh;
	d->dmin   = dmin;
	d->dmax   = dmax;
	d->acmin  = acmin;
	d->acmax  = acmax;
	d->dur    = dur;
	d->mlvl   = mlvl;
	d->minstr = minstr;
	d->value  = value;
	d->misc   = misc;
	d->drop   = drop;
	d->rnd    = rnd;
	d->stf    = stf;
	d->snd    = snd;
	if (i + 1 > d1_n_itmdefs)
		d1_n_itmdefs = i + 1;
}

U0 D1ItmSndSet(I64 i, U8 *path)
{
	D1StrCopy(d1_isnd_name[i], path, 32);
	if (i + 1 > d1_n_isnd)
		d1_n_isnd = i + 1;
}

U0 D1ItmDropSet(I64 i, U8 *name, I64 len)
{
	D1StrCopy(d1_idrop_name[i], name, 32);
	d1_idrop_len[i] = len;
	d1_idrop_cel[i] = NULL;
	if (i + 1 > d1_n_idrops)
		d1_n_idrops = i + 1;
}

#include "D1ItmT"

U8 *D1ItmDropCel(I64 di)
{//flip cel cache, one buffer per distinct Items\ cel
	I64 size;

	if (di < 0 || di >= d1_n_idrops)
		return NULL;
	if (!d1_idrop_cel[di])
		d1_idrop_cel[di] = D1MpqRead(d1_idrop_name[di], &size);
	return d1_idrop_cel[di];
}

U0 D1ItmSndPlay(I64 itm)
{//material sound: PlaySFX(ItemInvSnds[ItemCAnimTbl[iCurs]]) (inv.cpp:1158).
 //one call per item move: equip, place, belt, pickup, buy, sell, use.
	I64 s;

	if (itm < 0 || itm >= d1_n_itmdefs || !d1_opt_sfx)
		return;
	s = d1_itmdefs[itm].snd;
	if (s >= 0 && s < d1_n_isnd)
		D1SndPlay(d1_isnd_name[s]);
}

U0 D1ItmSndGrab()
{//IS_IGRAB, the lift sound (inv.cpp:1635 CheckInvCut)
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Invgrab.wav");
}

U0 D1ItemUseMisc(I64 misc)
{//items.cpp UseItem potion arms; the belt and right-click use share it
	if (misc == D1IM_HEAL || misc == D1IM_REJUV)
		d1_plr_hp += d1_plr_maxhp / 2 + D1Rnd(d1_plr_maxhp / 4 + 1);
	if (misc == D1IM_MANA || misc == D1IM_REJUV)
		d1_plr_mana += d1_plr_maxmana / 2 + D1Rnd(d1_plr_maxmana / 4 + 1);
	if (misc == D1IM_FULLHEAL || misc == D1IM_FULLREJUV)
		d1_plr_hp = d1_plr_maxhp;
	if (misc == D1IM_FULLMANA || misc == D1IM_FULLREJUV)
		d1_plr_mana = d1_plr_maxmana;

	if (d1_plr_hp > d1_plr_maxhp)
		d1_plr_hp = d1_plr_maxhp;
	if (d1_plr_mana > d1_plr_maxmana)
		d1_plr_mana = d1_plr_maxmana;
}

U0 D1ItemInit()
{
	I64 i;
	I64 size;

	if (!d1_item_init)
	{
		d1_n_itmdefs = 0;
		d1_n_idrops  = 0;
		d1_n_isnd    = 0;
		D1ItmTFill;
		d1_objcurs = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);
		for (i = 0; i < D1_MAXITEM; i++)
		{
			d1_items[i].active = FALSE;
			D1StClear(&d1_st_ground[i]);
		}
		for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
			d1_ditem[i] = 0;
		for (i = 0; i < 8; i++)
			d1_belt[i] = 0;
		for (i = 0; i < D1_MAXINV; i++)
		{
			d1_inv_grid[i] = 0;
			d1_inv_itm[i]  = -1;
			d1_inv_val[i]  = 0;
			D1StClear(&d1_st_inv[i]);
		}
		for (i = 0; i < D1EQ_N; i++)
		{
			d1_equip_itm[i] = -1;
			d1_equip_val[i] = 0;
			D1StClear(&d1_st_equip[i]);
		}
		d1_inv_last  = -1;
		d1_plr_gold  = 0;
		d1_item_init = TRUE;
	}
}

U0 D1ItemClear()
{//ground items only; inventory and belt survive level changes
	I64 i;

	D1ItemInit;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		d1_items[i].active = FALSE;
		D1StClear(&d1_st_ground[i]);
	}
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_ditem[i] = 0;
}

I64 D1ItemRndDur(I64 maxdur)
{//items.cpp ItemRndDur: random_(0, maxdur >> 1) + (maxdur >> 2) + 1
	if (maxdur <= 0)
		return 0;
	return D1Rnd(maxdur >> 1) + (maxdur >> 2) + 1;
}

Bool D1ItemPlaceOk(I64 x, I64 y)
{//items.cpp ItemPlace / CanPut: no item, actor, object, or solid tile
	if (!D1Walkable(x, y))
		return FALSE;
	if (d1_ditem[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dmon[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dobj[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dtwn[x + y * D1_MAXDUN])
		return FALSE;
	return TRUE;
}

U0 D1ItemDrop(I64 itm, I64 x, I64 y, I64 amount)
{//itm is a base row; amount is the gold value, ignored for the rest.
 //ItemPlace: refuse the chest/barrel tile - nudge to a free neighbor.
	CD1Item *it = NULL;
	CD1ItmDef *d;
	I64	 i;
	I64	 dd;

	D1ItemInit;
	if (itm < 0 || itm >= d1_n_itmdefs)
		return;

	if (!D1ItemPlaceOk(x, y))
	{
		i = -1;
		for (dd = 0; dd < 8; dd++)
		{
			if (i < 0 && D1ItemPlaceOk(x + d1_dir_dx[dd], y + d1_dir_dy[dd]))
				i = dd;
		}
		if (i < 0)
			return;
		x += d1_dir_dx[i];
		y += d1_dir_dy[i];
	}

	dd = -1;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (dd < 0 && !d1_items[i].active)
			dd = i;
	}
	if (dd < 0)
		return;
	it = &d1_items[dd];
	d  = &d1_itmdefs[itm];

	it->itm = itm;
	it->x   = x;
	it->y   = y;
	it->val = amount;
	if (d->acmax > 0)
		it->val = d->acmin + D1Rnd(d->acmax - d->acmin + 1);
	it->frame  = 1;
	it->active = TRUE;
	d1_ditem[x + y * D1_MAXDUN] = dd + 1;

	D1StClear(&d1_st_ground[dd]);
	d1_st_ground[dd].maxdur = d->dur;
	d1_st_ground[dd].dur    = D1ItemRndDur(d->dur);
	if (d1_pow_drop)
		(*d1_pow_drop)(dd, itm, d1_currlevel);
}

I64 D1ItemRndBase(I64 mlvl)
{//RndItem pool reduced: every row with mlvl >= its min level, IDROP_DOUBLE
 //rows twice. returns a base row.
	I64 pool[2 * D1_MAXITMDEF];
	I64 n = 0;
	I64 i;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (mlvl >= d1_itmdefs[i].mlvl)
		{
			pool[n] = i;
			n++;
			if (d1_itmdefs[i].rnd == 2)
			{
				pool[n] = i;
				n++;
			}
		}
	}
	if (n == 0)
		return D1IT_GOLD;
	return pool[D1Rnd(n)];
}

I64 D1ItemGoldAmount()
{//GetItemAttrs, normal difficulty: 5*dlvl + random(10*dlvl), town as 1
	I64 lvl = d1_currlevel;

	if (lvl < 1)
		lvl = 1;
	return 5 * lvl + D1Rnd(10 * lvl);
}

U0 D1ItemMonsterDrop(I64 x, I64 y, I64 mlvl)
{//SpawnItem odds: 40% drop; of those 3 in 4 gold, else a level-fit base
	I64 itm;

	if (D1Rnd(100) > 40)
		return;
	if (D1Rnd(100) > 25)
	{
		D1ItemDrop(D1IT_GOLD, x, y, D1ItemGoldAmount());
		return;
	}
	itm = D1ItemRndBase(mlvl);
	if (itm == D1IT_GOLD)
		D1ItemDrop(D1IT_GOLD, x, y, D1ItemGoldAmount());
	else
		D1ItemDrop(itm, x, y, 0);
}

//--- inventory placement ---------------------------------------------------
//cells run left-right, top-down; a gw x gh item spans down-right from the
//top-left cell. anchor (positive entry) is the bottom-left cell, where
//inv.cpp draws the icon from.

Bool D1ItmIsBow(I64 itm)
{//itemdat ITYPE_BOW. drop-cel group 16 is bow-only in D1ItmT; name
 //suffix catches any future bow rows that share the flip set.
	U8 *n;
	I64 l;

	if (itm < 0 || itm >= d1_n_itmdefs)
		return FALSE;
	if (d1_itmdefs[itm].drop == 16)
		return TRUE;
	n = d1_itmdefs[itm].name;
	l = 0;
	while (n[l])
		l++;
	if (l < 3)
		return FALSE;
	return n[l - 3] == 'B' && n[l - 2] == 'o' && n[l - 1] == 'w';
}

I64 D1InvPasteOrigin(I64 cell, I64 gw, I64 gh)
{//CheckInvPaste: cursor cell is near the item's center. return top-left
 //grid cell, clamped so gw x gh fits the 10x4 pack.
	I64 cx;
	I64 cy;

	if (gw < 1)
		gw = 1;
	if (gh < 1)
		gh = 1;
	if (gw > 10 || gh > 4)
		return -1;
	cx = cell % 10 - (gw - 1) / 2;
	cy = cell / 10 - (gh - 1) / 2;
	if (cx < 0)
		cx = 0;
	if (cy < 0)
		cy = 0;
	if (cx + gw > 10)
		cx = 10 - gw;
	if (cy + gh > 4)
		cy = 4 - gh;
	return cx + cy * 10;
}

Bool D1InvFitAt(I64 cell, I64 gw, I64 gh)
{
	I64 cx = cell % 10;
	I64 cy = cell / 10;
	I64 i;
	I64 j;

	if (cx + gw > 10 || cy + gh > 4)
		return FALSE;
	for (j = 0; j < gh; j++)
		for (i = 0; i < gw; i++)
		{
			if (d1_inv_grid[cx + i + (cy + j) * 10])
				return FALSE;
		}
	return TRUE;
}

I64 D1InvFindFit(I64 gw, I64 gh)
{//first fit, scan order = cell order. -1 when nothing fits.
	I64 c;

	for (c = 0; c < D1_MAXINV; c++)
	{
		if (D1InvFitAt(c, gw, gh))
			return c;
	}
	return -1;
}

U0 D1InvPlaceAt(I64 cell, I64 entry)
{
	CD1ItmDef *d = &d1_itmdefs[d1_inv_itm[entry]];
	I64 cx = cell % 10;
	I64 cy = cell / 10;
	I64 i;
	I64 j;

	for (j = 0; j < d->gh; j++)
		for (i = 0; i < d->gw; i++)
		{
			if (i == 0 && j == d->gh - 1)
				d1_inv_grid[cx + i + (cy + j) * 10] = entry + 1;
			else
				d1_inv_grid[cx + i + (cy + j) * 10] = -(entry + 1);
		}
}

Bool D1InvPut(I64 itm, I64 val)
{//first-fit place; FALSE when full
	I64 cell;
	I64 e;
	I64 i;

	d1_inv_last = -1;
	cell = D1InvFindFit(d1_itmdefs[itm].gw, d1_itmdefs[itm].gh);
	if (cell < 0)
		return FALSE;
	e = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	if (e < 0)
		return FALSE;
	d1_inv_itm[e] = itm;
	d1_inv_val[e] = val;
	D1StClear(&d1_st_inv[e]);
	d1_st_inv[e].maxdur = d1_itmdefs[itm].dur;
	d1_st_inv[e].dur    = d1_itmdefs[itm].dur;
	D1InvPlaceAt(cell, e);
	d1_inv_last = e;
	return TRUE;
}

U0 D1InvRemove(I64 entry)
{
	I64 i;

	for (i = 0; i < D1_MAXINV; i++)
	{
		if (d1_inv_grid[i] == entry + 1 || d1_inv_grid[i] == -(entry + 1))
			d1_inv_grid[i] = 0;
	}
	d1_inv_itm[entry] = -1;
	d1_inv_val[entry] = 0;
	D1StClear(&d1_st_inv[entry]);
}

Bool D1HoldHas()
{
	return d1_hold_itm >= 0;
}

U0 D1HoldClear()
{
	d1_hold_itm = -1;
	d1_hold_val = 0;
	D1StClear(&d1_hold_st);
}

U0 D1HoldTake(I64 itm, I64 val, CD1ItmSt *st)
{//lift onto the cursor
	d1_hold_itm = itm;
	d1_hold_val = val;
	if (st)
		D1StCopy(&d1_hold_st, st);
	else
		D1StClear(&d1_hold_st);
	D1ItmSndGrab;
}

Bool D1HoldPlaceOrigin(I64 origin)
{//paste HoldItem with origin as the top-left pack cell. FALSE = no fit.
	CD1ItmDef *d;
	I64 e;
	I64 i;

	if (!D1HoldHas())
		return FALSE;
	d = &d1_itmdefs[d1_hold_itm];
	if (origin < 0 || !D1InvFitAt(origin, d->gw, d->gh))
		return FALSE;
	e = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	if (e < 0)
		return FALSE;
	d1_inv_itm[e] = d1_hold_itm;
	d1_inv_val[e] = d1_hold_val;
	D1StCopy(&d1_st_inv[e], &d1_hold_st);
	D1InvPlaceAt(origin, e);
	D1HoldClear;
	D1ItmSndPlay(d1_inv_itm[e]);
	return TRUE;
}

Bool D1HoldPlaceAt(I64 cell)
{//paste HoldItem; cell is the clicked pack cell (CheckInvPaste center)
	I64 origin;

	if (!D1HoldHas())
		return FALSE;
	origin = D1InvPasteOrigin(cell, d1_itmdefs[d1_hold_itm].gw,
		d1_itmdefs[d1_hold_itm].gh);
	return D1HoldPlaceOrigin(origin);
}

Bool D1HoldDropWorld(I64 x, I64 y)
{//drop at dungeon tile (InvPutItem path)
	I64 s;

	if (!D1HoldHas())
		return FALSE;
	D1ItmSndPlay(d1_hold_itm);
	D1ItemDrop(d1_hold_itm, x, y, d1_hold_val);
	s = d1_ditem[x + y * D1_MAXDUN];
	if (s > 0)
		D1StCopy(&d1_st_ground[s - 1], &d1_hold_st);
	D1HoldClear;
	return TRUE;
}

Bool D1HoldToBelt()
{//potion onto first free belt chip
	I64 s;

	if (!D1HoldHas() || !d1_itmdefs[d1_hold_itm].misc)
		return FALSE;
	for (s = 0; s < 8; s++)
	{
		if (!d1_belt[s])
		{
			d1_belt[s] = d1_hold_itm;
			D1ItmSndPlay(d1_hold_itm);
			D1HoldClear;
			return TRUE;
		}
	}
	return FALSE;
}

U0 D1HoldStashForSave()
{//HoldItem is not in the save body. park it before write so a save mid-
 //drag does not erase the item. belt → pack → feet.
	I64 cell;

	if (!D1HoldHas())
		return;
	if (D1HoldToBelt())
		return;
	cell = D1InvFindFit(d1_itmdefs[d1_hold_itm].gw, d1_itmdefs[d1_hold_itm].gh);
	if (cell >= 0 && D1HoldPlaceOrigin(cell))
		return;
	D1HoldDropWorld(d1_plr_tile_x, d1_plr_tile_y);
}

//--- named lookup and direct placement -------------------------------------
//
// the generated table only carries the rows this port supports, so a row index
// shifts whenever the generator's filter does. anything that needs a specific
// item asks for it by name.

Bool D1ItmNameEq(U8 *a, U8 *b)
{
	I64 i = 0;

	while (a[i] && a[i] == b[i])
		i++;
	return a[i] == b[i];
}

I64 D1ItmFind(U8 *name)
{//base row by name, -1 when the table lacks it
	I64 i;
	I64 r = -1;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (r < 0 && D1ItmNameEq(d1_itmdefs[i].name, name))
			r = i;
	}
	return r;
}

U0 D1ItmCarryClear()
{//grid, equipment and belt; the ground and the purse are untouched
	I64 i;

	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = 0;
		d1_inv_itm[i]  = -1;
		d1_inv_val[i]  = 0;
		D1StClear(&d1_st_inv[i]);
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = -1;
		d1_equip_val[i] = 0;
		D1StClear(&d1_st_equip[i]);
	}
	for (i = 0; i < 8; i++)
		d1_belt[i] = 0;
	d1_inv_last = -1;
}

Bool D1ItmGive(I64 slot, U8 *name, I64 val, I64 dur)
{//SetPlrHandItem: normal quality, full durability, AC at iMinAC. slot is an
 //equip slot, or -1 for the first grid fit. FALSE = the row is absent or the
 //grid is full.
	I64 itm = D1ItmFind(name);
	CD1ItmSt *st;

	if (itm < 0)
		return FALSE;
	if (slot >= 0)
	{
		d1_equip_itm[slot] = itm;
		d1_equip_val[slot] = val;
		st = &d1_st_equip[slot];
	}
	else
	{
		if (!D1InvPut(itm, val) || d1_inv_last < 0)
			return FALSE;
		st = &d1_st_inv[d1_inv_last];
	}
	D1StClear(st);
	st->ident  = TRUE;			//ITEM_QUALITY_NORMAL: no powers to reveal
	st->dur    = dur;
	st->maxdur = dur;
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
	return TRUE;
}

Bool D1ItmIsStaff(I64 itm)
{
	if (itm < 0 || itm >= d1_n_itmdefs)
		return FALSE;
	return ToBool(d1_itmdefs[itm].stf);
}

Bool D1ItmGiveStaff(I64 slot, U8 *name, U8 *spell, I64 chg, I64 dur)
{//D1ItmGive plus GetItemAttrs' IMISC_STAFF arm: _iSpell from the row, charges
 //at their creation count. spell is a spelldat sNameText; FALSE when the base
 //row, the spell or the grid is missing.
	I64	 s;
	CD1ItmSt *st;

	if (!d1_spl_find)
		return FALSE;
	s = (*d1_spl_find)(spell);
	if (s < 0)
		return FALSE;
	if (!D1ItmGive(slot, name, 0, dur))
		return FALSE;

	if (slot >= 0)
		st = &d1_st_equip[slot];
	else
		st = &d1_st_inv[d1_inv_last];
	st->spl    = s + 1;
	st->chg    = chg;
	st->maxchg = chg;
	return TRUE;
}

Bool D1ItmGiveBelt(I64 slot, U8 *name)
{
	I64 itm = D1ItmFind(name);

	if (itm < 0 || slot < 0 || slot > 7)
		return FALSE;
	d1_belt[slot] = itm;
	return TRUE;
}

//--- pickup, belt, ticks, ground draw --------------------------------------

Bool D1ItemPickup(I64 x, I64 y)
{//TRUE when something was taken. gold to the purse, potions to the belt
 //(inventory when full), equipment to the inventory grid.
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	CD1ItmDef *d;
	I64	 s;
	Bool took;

	if (!ii)
		return FALSE;
	it = &d1_items[ii - 1];
	if (!it->active)
		return FALSE;
	d = &d1_itmdefs[it->itm];

	took = FALSE;
	if (d->cls == D1IC_GOLD)
	{//gold's material sound is IS_GOLD, through the same table
		d1_plr_gold += it->val;
		took = TRUE;
	}
	else if (d->misc)
	{//potion: first free belt slot, else the grid
		for (s = 0; s < 8; s++)
		{
			if (!took && !d1_belt[s])
			{
				d1_belt[s] = it->itm;
				took = TRUE;
			}
		}
		if (!took)
			took = D1InvPut(it->itm, it->val);
	}
	else
	{
		took = D1InvPut(it->itm, it->val);
		if (took && d1_inv_last >= 0)
		{
			D1StCopy(&d1_st_inv[d1_inv_last], &d1_st_ground[ii - 1]);
			if (d1_pow_take)
				(*d1_pow_take)(ii - 1, d1_inv_last);
		}
	}

	if (!took)
		return FALSE;			//no room, stays on the ground
	D1ItmSndPlay(it->itm);
	it->active = FALSE;
	d1_ditem[x + y * D1_MAXDUN] = 0;
	return TRUE;
}

Bool D1ItemAutoPickup(I64 x, I64 y)
{//walk-onto: gold / items gated by devilutionX-style options. click
 //pickup still goes through D1ItemPickup directly.
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	CD1ItmDef *d;

	if (!ii)
		return FALSE;
	it = &d1_items[ii - 1];
	if (!it->active)
		return FALSE;
	d = &d1_itmdefs[it->itm];
	if (d->cls == D1IC_GOLD)
	{
		if (!d1_opt_apgold)
			return FALSE;
	}
	else if (!d1_opt_apitem)
		return FALSE;
	return D1ItemPickup(x, y);
}

U0 D1BeltUse(I64 slot)
{
	I64 misc;

	if (slot < 0 || slot > 7)
		return;
	if (!d1_belt[slot] || d1_plr_dead)
		return;
	misc = d1_itmdefs[d1_belt[slot]].misc;
	if (d1_net_on)
	{//the misc code travels with the command; remote belts are unknown
		D1NetQueue(D1NC_BELT, slot, misc, 0);
		return;
	}
	D1ItmSndPlay(d1_belt[slot]);
	D1ItemUseMisc(misc);
	d1_belt[slot] = 0;
}

U0 D1ItemTickAll()
{//flip anims run to their resting frame
	I64 i;
	I64 nf;

	if (d1_currlevel > d1_deepest_lvl)
		d1_deepest_lvl = d1_currlevel;
	if (d1_pow_tick)
		(*d1_pow_tick)();
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active)
		{
			nf = d1_idrop_len[d1_itmdefs[d1_items[i].itm].drop];
			if (d1_items[i].frame < nf)
				d1_items[i].frame++;
		}
	}
}

U0 D1ItemDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{//under actors. drop cels are 96 wide, centered on the 64-wide tile.
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	U8	*buf;

	if (!ii)
		return;
	it = &d1_items[ii - 1];
	if (!it->active)
		return;

	buf = D1ItmDropCel(d1_itmdefs[it->itm].drop);
	if (buf)
	{
		if (ii - 1 == d1_hover_ii || Bt(kbd.down_bitmap, SC_ALT))
			D1CelDrawOutline(sx - 16, sy, buf, it->frame, 96,
				D1_OUTLINE_ITM);
		D1CelDraw(sx - 16, sy, buf, it->frame, 96);
	}
}

I64 D1ItemAtTile(I64 x, I64 y)
{//ground item index at tile, -1 none
	I64 ii;

	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return -1;
	ii = d1_ditem[x + y * D1_MAXDUN];
	if (!ii)
		return -1;
	if (!d1_items[ii - 1].active)
		return -1;
	return ii - 1;
}

I64 D1ItemAtCurs(I64 x, I64 y)
{//item under the cursor. same up-screen tile scan as CheckCursMove /
 //D1MonAtCurs - drop sprites bottom-anchor on their foot tile.
	I64 ii = D1ItemAtTile(x + 1, y);

	if (ii >= 0)
		return ii;
	ii = D1ItemAtTile(x, y + 1);
	if (ii >= 0)
		return ii;
	ii = D1ItemAtTile(x, y);
	if (ii >= 0)
		return ii;
	return D1ItemAtTile(x + 1, y + 1);
}
