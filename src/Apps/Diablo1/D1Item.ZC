// base items, ground drops, inventory storage, the belt
//
// base rows come from D1ItmT (itemdat.cpp AllItemsList, generated). a ground
// item is a base row index plus one instance value: gold amount for gold,
// rolled AC for armor (GetItemAttrs rolls iMinAC..iMaxAC once, at drop).
// drop cels are unclipped 96-wide flip anims under Items\, cached per cel;
// the resting frame is the last.
//
// the inventory grid is 10x4 cells (inv.cpp InvGrid): a placed entry writes
// idx+1 on its bottom-left anchor cell and -(idx+1) on the covered rest
// (AutoPlace convention). belt slots hold a base row index, 0 empty.

#define D1_MAXITEM		64
#define D1_MAXITMDEF	128
#define D1_MAXIDROP		24
#define D1_MAXINV		40

#define D1IT_GOLD		0
#define D1IT_HEAL		1
#define D1IT_MANA		2

//itemdat.cpp item_class values
#define D1IC_WEAPON		1
#define D1IC_ARMOR		2
#define D1IC_MISC		3
#define D1IC_GOLD		4

//itemdat.cpp item_equip_type values
#define D1IL_ONEHAND	1
#define D1IL_TWOHAND	2
#define D1IL_ARMOR		3
#define D1IL_HELM		4

#define D1IM_HEAL		1
#define D1IM_FULLHEAL	2
#define D1IM_MANA		3
#define D1IM_FULLMANA	4
#define D1IM_REJUV		5
#define D1IM_FULLREJUV	6
#define D1IM_BOOK		7

#define D1EQ_HEAD		0
#define D1EQ_BODY		1
#define D1EQ_LEFT		2
#define D1EQ_RIGHT		3
#define D1EQ_N			4

//quest / book rows beyond the AllItemsList dump (0..73)
#define D1IT_ANVIL		74
#define D1IT_BOOK0		75
#define D1_NBOOK		32

Bool d1_wep_gfx_dirty = FALSE;
class CD1ItmDef
{
	U8	 name[32];
	I64	 cls;
	I64	 loc;
	I64	 frame;			//Objcurs.CEL frame (iCurs + CURSOR_FIRSTITEM 12)
	I64	 gw;
	I64	 gh;
	I64	 dmin;
	I64	 dmax;
	I64	 acmin;
	I64	 acmax;
	I64	 dur;
	I64	 mlvl;
	I64	 minstr;
	I64	 value;
	I64	 misc;			//D1IM_*, 0 for equipment
	I64	 drop;
	I64	 rnd;
	I64	 stf;
	I64	 snd;
						//ItemInvSnds[ItemCAnimTbl[iCurs]] (inv.cpp:1158)
};

class CD1Item
{
	I64	 itm;
	I64	 x;
	I64	 y;
	I64	 val;
	I64	 frame;
	Bool active;
};

//durability sentinel, items.cpp DUR_INDESTRUCTIBLE
#define D1_DURINF		255

class CD1ItmSt
{
	I64	 pfx;
	I64	 sfx;
	I64	 pfxval;
	I64	 sfxval;
	I64	 pfxval2;
	I64	 sfxval2;
	I64	 unq;			//unique id + 1, 0 = not unique
	Bool ident;
	I64	 dur;
	I64	 maxdur;
	I64	 curs;			//IPL_INVCURS Objcurs frame, 0 = the base row frame
	Bool nominstr;
	Bool onehand;
	I64	 spl;			//_iSpell + 1, 0 = the item casts nothing
	I64	 chg;
	I64	 maxchg;
	I64	 unqval[6];
};

CD1ItmDef d1_itmdefs[D1_MAXITMDEF];
I64	 d1_n_itmdefs = 0;

//material sound wav table (effects.cpp sgSFX rows ItemInvSnds selects)
#define D1_MAXISND		16
U8	 d1_isnd_name[D1_MAXISND][32];
I64	 d1_n_isnd = 0;

U8	 d1_idrop_name[D1_MAXIDROP][32];
I64	 d1_idrop_len[D1_MAXIDROP];
U8	*d1_idrop_cel[D1_MAXIDROP];
I64	 d1_n_idrops = 0;

CD1Item d1_items[D1_MAXITEM];
U8	 d1_ditem[D1_MAXDUN * D1_MAXDUN];	//item idx+1
I64	 d1_plr_gold = 0;
I64	 d1_belt[8];						//0 empty, else base row
Bool d1_item_init = FALSE;

I64	 d1_inv_grid[D1_MAXINV];			//0 free, +e+1 anchor, -(e+1) covered
I64	 d1_inv_itm[D1_MAXINV];				//base row per entry, -1 free
I64	 d1_inv_val[D1_MAXINV];
I64	 d1_equip_itm[D1EQ_N];
I64	 d1_equip_val[D1EQ_N];

CD1ItmSt d1_st_ground[D1_MAXITEM];
CD1ItmSt d1_st_inv[D1_MAXINV];
CD1ItmSt d1_st_equip[D1EQ_N];

I64	 d1_inv_last = -1;					//entry D1InvPut claimed last, -1 none

//cursor-held item (player.cpp HoldItem / pcurs >= CURSOR_FIRSTITEM)
I64	 d1_hold_itm = -1;
I64	 d1_hold_val = 0;
CD1ItmSt d1_hold_st;

I64	 d1_deepest_lvl = 0;

U0	(*d1_pow_drop)(I64 gi, I64 itm, I64 lvl) = NULL;
U0	(*d1_pow_take)(I64 gi, I64 e)            = NULL;
U0	(*d1_pow_tick)()                         = NULL;	//20Hz upkeep

U8	*(*d1_spl_name)(I64 s)                       = NULL;
I64	 (*d1_spl_find)(U8 *name)                    = NULL;
I64	 (*d1_spl_cost)(I64 s)                       = NULL;
U0	 (*d1_spl_staff)(I64 lvl, I64 *sp, I64 *ch)  = NULL;
Bool (*d1_spl_book)(I64 s)                       = NULL;
Bool (*d1_spl_curs)(I64 inv_e, I64 eq_s)         = NULL;
U0	 (*d1_map_mark)(I64 x, I64 y)                = NULL;
U0	 (*d1_itm_extra)()                           = NULL;

U0	 (*d1_pow_equipped)(I64 slot)                = NULL;

U8	*d1_objcurs = NULL;

U0 D1StClear(CD1ItmSt *s)
{
	I64 k;

	s->pfx      = 0;
	s->sfx      = 0;
	s->pfxval   = 0;
	s->sfxval   = 0;
	s->pfxval2  = 0;
	s->sfxval2  = 0;
	s->unq      = 0;
	s->ident    = FALSE;
	s->dur      = 0;
	s->maxdur   = 0;
	s->curs     = 0;
	s->nominstr = FALSE;
	s->onehand  = FALSE;
	s->spl      = 0;
	s->chg      = 0;
	s->maxchg   = 0;
	for (k = 0; k < 6; k++)
		s->unqval[k] = 0;
}

U0 D1StCopy(CD1ItmSt *dst, CD1ItmSt *src)
{
	I64 k;

	dst->pfx      = src->pfx;
	dst->sfx      = src->sfx;
	dst->pfxval   = src->pfxval;
	dst->sfxval   = src->sfxval;
	dst->pfxval2  = src->pfxval2;
	dst->sfxval2  = src->sfxval2;
	dst->unq      = src->unq;
	dst->ident    = src->ident;
	dst->dur      = src->dur;
	dst->maxdur   = src->maxdur;
	dst->curs     = src->curs;
	dst->nominstr = src->nominstr;
	dst->onehand  = src->onehand;
	dst->spl      = src->spl;
	dst->chg      = src->chg;
	dst->maxchg   = src->maxchg;
	for (k = 0; k < 6; k++)
		dst->unqval[k] = src->unqval[k];
}

U0 D1ItmSet(I64 i, U8 *name, I64 cls, I64 loc, I64 frame, I64 gw, I64 gh,
	I64 dmin, I64 dmax, I64 acmin, I64 acmax, I64 dur, I64 mlvl, I64 minstr,
	I64 value, I64 misc, I64 drop, I64 rnd, I64 stf, I64 snd)
{
	CD1ItmDef *d = &d1_itmdefs[i];

	D1StrCopy(d->name, name, 32);
	d->cls    = cls;
	d->loc    = loc;
	d->frame  = frame;
	d->gw     = gw;
	d->gh     = gh;
	d->dmin   = dmin;
	d->dmax   = dmax;
	d->acmin  = acmin;
	d->acmax  = acmax;
	d->dur    = dur;
	d->mlvl   = mlvl;
	d->minstr = minstr;
	d->value  = value;
	d->misc   = misc;
	d->drop   = drop;
	d->rnd    = rnd;
	d->stf    = stf;
	d->snd    = snd;
	if (i + 1 > d1_n_itmdefs)
		d1_n_itmdefs = i + 1;
}

U0 D1ItmSndSet(I64 i, U8 *path)
{
	D1StrCopy(d1_isnd_name[i], path, 32);
	if (i + 1 > d1_n_isnd)
		d1_n_isnd = i + 1;
}

U0 D1ItmDropSet(I64 i, U8 *name, I64 len)
{
	D1StrCopy(d1_idrop_name[i], name, 32);
	d1_idrop_len[i] = len;
	d1_idrop_cel[i] = NULL;
	if (i + 1 > d1_n_idrops)
		d1_n_idrops = i + 1;
}

#include "D1ItmT"

U8 *D1ItmDropCel(I64 di)
{
	I64 size;

	if (di < 0 || di >= d1_n_idrops)
		return NULL;
	if (!d1_idrop_cel[di])
		d1_idrop_cel[di] = D1MpqRead(d1_idrop_name[di], &size);
	return d1_idrop_cel[di];
}

U0 D1ItmSndPlay(I64 itm)
{//material sound: PlaySFX(ItemInvSnds[ItemCAnimTbl[iCurs]]) (inv.cpp:1158).
	I64 s;

	if (itm < 0 || itm >= d1_n_itmdefs || !d1_opt_sfx)
		return;
	s = d1_itmdefs[itm].snd;
	if (s >= 0 && s < d1_n_isnd)
		D1SndPlay(d1_isnd_name[s]);
}

U0 D1ItmSndGrab()
{//IS_IGRAB, the lift sound (inv.cpp:1635 CheckInvCut)
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Invgrab.wav");
}

U0 D1ItemUseMisc(I64 misc)
{//items.cpp UseItem potion arms; the belt and right-click use share it
	if (misc == D1IM_HEAL || misc == D1IM_REJUV)
		d1_plr_hp += d1_plr_maxhp / 2 + D1Rnd(d1_plr_maxhp / 4 + 1);
	if (misc == D1IM_MANA || misc == D1IM_REJUV)
		d1_plr_mana += d1_plr_maxmana / 2 + D1Rnd(d1_plr_maxmana / 4 + 1);
	if (misc == D1IM_FULLHEAL || misc == D1IM_FULLREJUV)
		d1_plr_hp = d1_plr_maxhp;
	if (misc == D1IM_FULLMANA || misc == D1IM_FULLREJUV)
		d1_plr_mana = d1_plr_maxmana;

	if (d1_plr_hp > d1_plr_maxhp)
		d1_plr_hp = d1_plr_maxhp;
	if (d1_plr_mana > d1_plr_maxmana)
		d1_plr_mana = d1_plr_maxmana;
}

U0 D1ItemInit()
{
	I64 i;
	I64 size;

	if (!d1_item_init)
	{
		d1_n_itmdefs = 0;
		d1_n_idrops  = 0;
		d1_n_isnd    = 0;
		D1ItmTFill;
		D1ItmDropSet(18, "Items\\Fanvil.CEL", 13);
		D1ItmSet(D1IT_ANVIL, "Anvil of Fury", 3, 7, 152, 2, 2,
			0, 0, 0, 0, 0, 50, 0, 0, 0, 18, 0, 0, 2);
		d1_objcurs = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);
		for (i = 0; i < D1_MAXITEM; i++)
		{
			d1_items[i].active = FALSE;
			D1StClear(&d1_st_ground[i]);
		}
		for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
			d1_ditem[i] = 0;
		for (i = 0; i < 8; i++)
			d1_belt[i] = 0;
		for (i = 0; i < D1_MAXINV; i++)
		{
			d1_inv_grid[i] = 0;
			d1_inv_itm[i]  = -1;
			d1_inv_val[i]  = 0;
			D1StClear(&d1_st_inv[i]);
		}
		for (i = 0; i < D1EQ_N; i++)
		{
			d1_equip_itm[i] = -1;
			d1_equip_val[i] = 0;
			D1StClear(&d1_st_equip[i]);
		}
		d1_inv_last  = -1;
		d1_plr_gold  = 0;
		if (d1_itm_extra)
			(*d1_itm_extra)();
		d1_item_init = TRUE;
	}
}

U0 D1ItemClear()
{
	I64 i;

	D1ItemInit;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		d1_items[i].active = FALSE;
		D1StClear(&d1_st_ground[i]);
	}
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_ditem[i] = 0;
}


class CD1ItmLvl
{
	Bool valid;
	I64	 n;
	CD1Item items[D1_MAXITEM];
	CD1ItmSt st[D1_MAXITEM];
};

CD1ItmLvl d1_itm_lvl[17];

U0 D1ItemStashClear()
{
	I64 i;

	for (i = 0; i < 17; i++)
	{
		d1_itm_lvl[i].valid = FALSE;
		d1_itm_lvl[i].n = 0;
	}
}

Bool D1ItemAnyActive()
{
	I64 i;

	for (i = 0; i < D1_MAXITEM; i++)
		if (d1_items[i].active)
			return TRUE;
	return FALSE;
}

U0 D1ItemCopy(CD1Item *dst, CD1Item *src)
{
	dst->itm    = src->itm;
	dst->x      = src->x;
	dst->y      = src->y;
	dst->val    = src->val;
	dst->frame  = src->frame;
	dst->active = src->active;
}

U0 D1ItemStash(I64 level)
{//level 0 included
	I64 i;

	if (level < 0 || level > 16)
		return;
	d1_itm_lvl[level].valid = TRUE;
	d1_itm_lvl[level].n = D1_MAXITEM;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		D1ItemCopy(&d1_itm_lvl[level].items[i], &d1_items[i]);
		D1StCopy(&d1_itm_lvl[level].st[i], &d1_st_ground[i]);
	}
}

Bool D1ItemRestore(I64 level)
{
	I64 i;
	CD1Item *it;

	if (level < 0 || level > 16)
		return FALSE;
	if (!d1_itm_lvl[level].valid)
		return FALSE;

	D1ItemClear;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		D1ItemCopy(&d1_items[i], &d1_itm_lvl[level].items[i]);
		D1StCopy(&d1_st_ground[i], &d1_itm_lvl[level].st[i]);
		it = &d1_items[i];
		if (it->active && it->x >= 0 && it->x < D1_MAXDUN &&
			it->y >= 0 && it->y < D1_MAXDUN)
			d1_ditem[it->x + it->y * D1_MAXDUN] = i + 1;
	}
	return TRUE;
}

I64 D1ItemRndDur(I64 maxdur)
{//items.cpp ItemRndDur: random_(0, maxdur >> 1) + (maxdur >> 2) + 1
	if (maxdur <= 0)
		return 0;
	return D1Rnd(maxdur >> 1) + (maxdur >> 2) + 1;
}

Bool D1ItemPlaceOk(I64 x, I64 y)
{//items.cpp ItemPlace / CanPut: no item, actor, object, or solid tile
	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return FALSE;
	if (!D1Walkable(x, y))
		return FALSE;
	if (d1_ditem[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dmon[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dobj[x + y * D1_MAXDUN])
		return FALSE;
	if (d1_dtwn[x + y * D1_MAXDUN])
		return FALSE;
	return TRUE;
}

Bool D1ItemSpace(I64 x, I64 y, I64 *ox, I64 *oy)
{//items.cpp GetSuperItemSpace
	I64 k;
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;

	*ox = x;
	*oy = y;
	if (D1ItemPlaceOk(x, y))
		return TRUE;
	for (i = 0; i < 8; i++)
	{
		xx = x + d1_dir_dx[i];
		yy = y + d1_dir_dy[i];
		if (D1ItemPlaceOk(xx, yy))
		{
			*ox = xx;
			*oy = yy;
			return TRUE;
		}
	}
	for (k = 2; k < 50; k++)
	{
		for (j = -k; j <= k; j++)
		{
			yy = y + j;
			for (i = -k; i <= k; i++)
			{
				xx = x + i;
				if (D1ItemPlaceOk(xx, yy))
				{
					*ox = xx;
					*oy = yy;
					return TRUE;
				}
			}
		}
	}
	return FALSE;
}

I64 D1ItemSlotFree()
{//first inactive d1_items entry, -1 when full
	I64 i;
	I64 s = -1;

	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (s < 0 && !d1_items[i].active)
			s = i;
	}
	return s;
}

I64 D1ItemPlaceExact(I64 itm, I64 x, I64 y, I64 val, CD1ItmSt *st)
{//inv.cpp InvPutItem: item[ii] = HoldItem, a verbatim copy.
	CD1Item *it;
	I64	 s;
	I64	 px;
	I64	 py;

	D1ItemInit;
	if (itm < 0 || itm >= d1_n_itmdefs)
		return -1;
	if (!D1ItemSpace(x, y, &px, &py))
		return -1;
	s = D1ItemSlotFree();
	if (s < 0)
		return -1;

	it = &d1_items[s];
	it->itm    = itm;
	it->x      = px;
	it->y      = py;
	it->val    = val;
	it->frame  = 1;
	it->active = TRUE;
	d1_ditem[px + py * D1_MAXDUN] = s + 1;

	if (st)
		D1StCopy(&d1_st_ground[s], st);
	else
		D1StClear(&d1_st_ground[s]);
	return s;
}

U0 D1ItemDrop(I64 itm, I64 x, I64 y, I64 amount)
{
	CD1Item *it = NULL;
	CD1ItmDef *d;
	I64	 dd;
	I64	 px;
	I64	 py;

	D1ItemInit;
	if (itm < 0 || itm >= d1_n_itmdefs)
		return;

	if (!D1ItemSpace(x, y, &px, &py))
		return;
	dd = D1ItemSlotFree();
	if (dd < 0)
		return;
	it = &d1_items[dd];
	d  = &d1_itmdefs[itm];

	it->itm = itm;
	it->x   = px;
	it->y   = py;
	it->val = amount;
	if (d->acmax > 0)
		it->val = d->acmin + D1Rnd(d->acmax - d->acmin + 1);
	it->frame  = 1;
	it->active = TRUE;
	d1_ditem[px + py * D1_MAXDUN] = dd + 1;

	D1StClear(&d1_st_ground[dd]);
	d1_st_ground[dd].maxdur = d->dur;
	d1_st_ground[dd].dur    = D1ItemRndDur(d->dur);
	if (d1_pow_drop)
		(*d1_pow_drop)(dd, itm, d1_currlevel);
}

U0 D1AnvilDrop()
{//items.cpp InitItems: SpawnQuestItem(IDI_ANVIL, 2*setpc_x+27, 2*setpc_y+27)
	if (!d1_setpc_placed)
		return;
	D1ItemDrop(D1IT_ANVIL, 2 * d1_setpc_x + 27, 2 * d1_setpc_y + 27, 0);
}

I64 D1ItemRndBase(I64 mlvl)
{
	I64 pool[2 * D1_MAXITMDEF];
	I64 n = 0;
	I64 i;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (i != D1IT_ANVIL && mlvl >= d1_itmdefs[i].mlvl)
		{
			pool[n] = i;
			n++;
			if (d1_itmdefs[i].rnd == 2)
			{
				pool[n] = i;
				n++;
			}
		}
	}
	if (n == 0)
		return D1IT_GOLD;
	return pool[D1Rnd(n)];
}

I64 D1ItemGoldAmount()
{
	I64 lvl = d1_currlevel;

	if (lvl < 1)
		lvl = 1;
	return 5 * lvl + D1Rnd(10 * lvl);
}

U0 D1ItemMonsterDrop(I64 x, I64 y, I64 mlvl)
{
	I64 itm;

	if (D1Rnd(100) > 40)
		return;
	if (D1Rnd(100) > 25)
	{
		D1ItemDrop(D1IT_GOLD, x, y, D1ItemGoldAmount());
		return;
	}
	itm = D1ItemRndBase(mlvl);
	if (itm == D1IT_GOLD)
		D1ItemDrop(D1IT_GOLD, x, y, D1ItemGoldAmount());
	else
		D1ItemDrop(itm, x, y, 0);
}


Bool D1ItmIsBow(I64 itm)
{
	U8 *n;
	I64 l;

	if (itm < 0 || itm >= d1_n_itmdefs)
		return FALSE;
	if (d1_itmdefs[itm].drop == 16)
		return TRUE;
	n = d1_itmdefs[itm].name;
	l = 0;
	while (n[l])
		l++;
	if (l < 3)
		return FALSE;
	return n[l - 3] == 'B' && n[l - 2] == 'o' && n[l - 1] == 'w';
}

I64 D1InvPasteOrigin(I64 cell, I64 gw, I64 gh)
{
	I64 cx;
	I64 cy;

	if (gw < 1)
		gw = 1;
	if (gh < 1)
		gh = 1;
	if (gw > 10 || gh > 4)
		return -1;
	cx = cell % 10 - (gw - 1) / 2;
	cy = cell / 10 - (gh - 1) / 2;
	if (cx < 0)
		cx = 0;
	if (cy < 0)
		cy = 0;
	if (cx + gw > 10)
		cx = 10 - gw;
	if (cy + gh > 4)
		cy = 4 - gh;
	return cx + cy * 10;
}

Bool D1InvFitAt(I64 cell, I64 gw, I64 gh)
{
	I64 cx = cell % 10;
	I64 cy = cell / 10;
	I64 i;
	I64 j;

	if (cx + gw > 10 || cy + gh > 4)
		return FALSE;
	for (j = 0; j < gh; j++)
		for (i = 0; i < gw; i++)
		{
			if (d1_inv_grid[cx + i + (cy + j) * 10])
				return FALSE;
		}
	return TRUE;
}

I64 D1InvFindFit(I64 gw, I64 gh)
{
	I64 c;

	for (c = 0; c < D1_MAXINV; c++)
	{
		if (D1InvFitAt(c, gw, gh))
			return c;
	}
	return -1;
}

U0 D1InvPlaceAt(I64 cell, I64 entry)
{
	CD1ItmDef *d = &d1_itmdefs[d1_inv_itm[entry]];
	I64 cx = cell % 10;
	I64 cy = cell / 10;
	I64 i;
	I64 j;

	for (j = 0; j < d->gh; j++)
		for (i = 0; i < d->gw; i++)
		{
			if (i == 0 && j == d->gh - 1)
				d1_inv_grid[cx + i + (cy + j) * 10] = entry + 1;
			else
				d1_inv_grid[cx + i + (cy + j) * 10] = -(entry + 1);
		}
}

Bool D1InvPut(I64 itm, I64 val)
{
	I64 cell;
	I64 e;
	I64 i;

	d1_inv_last = -1;
	cell = D1InvFindFit(d1_itmdefs[itm].gw, d1_itmdefs[itm].gh);
	if (cell < 0)
		return FALSE;
	e = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	if (e < 0)
		return FALSE;
	d1_inv_itm[e] = itm;
	d1_inv_val[e] = val;
	D1StClear(&d1_st_inv[e]);
	d1_st_inv[e].maxdur = d1_itmdefs[itm].dur;
	d1_st_inv[e].dur    = d1_itmdefs[itm].dur;
	D1InvPlaceAt(cell, e);
	d1_inv_last = e;
	return TRUE;
}

U0 D1InvRemove(I64 entry)
{
	I64 i;

	for (i = 0; i < D1_MAXINV; i++)
	{
		if (d1_inv_grid[i] == entry + 1 || d1_inv_grid[i] == -(entry + 1))
			d1_inv_grid[i] = 0;
	}
	d1_inv_itm[entry] = -1;
	d1_inv_val[entry] = 0;
	D1StClear(&d1_st_inv[entry]);
}

Bool D1HoldHas()
{
	return d1_hold_itm >= 0;
}

U0 D1HoldClear()
{
	d1_hold_itm = -1;
	d1_hold_val = 0;
	D1StClear(&d1_hold_st);
}

U0 D1HoldTake(I64 itm, I64 val, CD1ItmSt *st)
{
	d1_hold_itm = itm;
	d1_hold_val = val;
	if (st)
		D1StCopy(&d1_hold_st, st);
	else
		D1StClear(&d1_hold_st);
	D1ItmSndGrab;
}

Bool D1HoldPlaceOrigin(I64 origin)
{
	CD1ItmDef *d;
	I64 e;
	I64 i;

	if (!D1HoldHas())
		return FALSE;
	d = &d1_itmdefs[d1_hold_itm];
	if (origin < 0 || !D1InvFitAt(origin, d->gw, d->gh))
		return FALSE;
	e = -1;
	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	if (e < 0)
		return FALSE;
	d1_inv_itm[e] = d1_hold_itm;
	d1_inv_val[e] = d1_hold_val;
	D1StCopy(&d1_st_inv[e], &d1_hold_st);
	D1InvPlaceAt(origin, e);
	D1HoldClear;
	D1ItmSndPlay(d1_inv_itm[e]);
	return TRUE;
}

Bool D1HoldPlaceAt(I64 cell)
{
	I64 origin;

	if (!D1HoldHas())
		return FALSE;
	origin = D1InvPasteOrigin(cell, d1_itmdefs[d1_hold_itm].gw,
		d1_itmdefs[d1_hold_itm].gh);
	return D1HoldPlaceOrigin(origin);
}

Bool D1HoldDropWorld(I64 x, I64 y)
{//inv.cpp InvPutItem.
	if (!D1HoldHas())
		return FALSE;
	if (D1ItemPlaceExact(d1_hold_itm, x, y, d1_hold_val, &d1_hold_st) < 0)
		return FALSE;
	D1ItmSndPlay(d1_hold_itm);
	D1HoldClear;
	return TRUE;
}

Bool D1HoldToBelt()
{
	I64 s;

	if (!D1HoldHas() || !d1_itmdefs[d1_hold_itm].misc)
		return FALSE;
	if (d1_itmdefs[d1_hold_itm].misc == D1IM_BOOK)
		return FALSE;
	for (s = 0; s < 8; s++)
	{
		if (!d1_belt[s])
		{
			d1_belt[s] = d1_hold_itm;
			D1ItmSndPlay(d1_hold_itm);
			D1HoldClear;
			return TRUE;
		}
	}
	return FALSE;
}


Bool D1ItmNameEq(U8 *a, U8 *b)
{
	I64 i = 0;

	while (a[i] && a[i] == b[i])
		i++;
	return a[i] == b[i];
}

I64 D1ItmFind(U8 *name)
{//base row by name, -1 when the table lacks it
	I64 i;
	I64 r = -1;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (r < 0 && D1ItmNameEq(d1_itmdefs[i].name, name))
			r = i;
	}
	return r;
}

U0 D1ItmCarryClear()
{
	I64 i;

	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = 0;
		d1_inv_itm[i]  = -1;
		d1_inv_val[i]  = 0;
		D1StClear(&d1_st_inv[i]);
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = -1;
		d1_equip_val[i] = 0;
		D1StClear(&d1_st_equip[i]);
	}
	for (i = 0; i < 8; i++)
		d1_belt[i] = 0;
	d1_inv_last = -1;
}

Bool D1ItmGive(I64 slot, U8 *name, I64 val, I64 dur)
{
	I64 itm = D1ItmFind(name);
	CD1ItmSt *st;

	if (itm < 0)
		return FALSE;
	if (slot >= 0)
	{
		d1_equip_itm[slot] = itm;
		d1_equip_val[slot] = val;
		st = &d1_st_equip[slot];
	}
	else
	{
		if (!D1InvPut(itm, val) || d1_inv_last < 0)
			return FALSE;
		st = &d1_st_inv[d1_inv_last];
	}
	D1StClear(st);
	st->ident  = TRUE;
	st->dur    = dur;
	st->maxdur = dur;
	if (slot == D1EQ_LEFT || slot == D1EQ_RIGHT)
		d1_wep_gfx_dirty = TRUE;
	return TRUE;
}

Bool D1ItmIsStaff(I64 itm)
{
	if (itm < 0 || itm >= d1_n_itmdefs)
		return FALSE;
	return ToBool(d1_itmdefs[itm].stf);
}

Bool D1ItmGiveStaff(I64 slot, U8 *name, U8 *spell, I64 chg, I64 dur)
{
	I64	 s;
	CD1ItmSt *st;

	if (!d1_spl_find)
		return FALSE;
	s = (*d1_spl_find)(spell);
	if (s < 0)
		return FALSE;
	if (!D1ItmGive(slot, name, 0, dur))
		return FALSE;

	if (slot >= 0)
		st = &d1_st_equip[slot];
	else
		st = &d1_st_inv[d1_inv_last];
	st->spl    = s + 1;
	st->chg    = chg;
	st->maxchg = chg;
	return TRUE;
}

Bool D1ItmGiveBelt(I64 slot, U8 *name)
{
	I64 itm = D1ItmFind(name);

	if (itm < 0 || slot < 0 || slot > 7)
		return FALSE;
	d1_belt[slot] = itm;
	return TRUE;
}


Bool D1ItemPickup(I64 x, I64 y)
{
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	CD1ItmDef *d;
	I64	 s;
	Bool took;

	if (!ii)
		return FALSE;
	it = &d1_items[ii - 1];
	if (!it->active)
		return FALSE;
	d = &d1_itmdefs[it->itm];

	took = FALSE;
	if (d->cls == D1IC_GOLD)
	{
		d1_plr_gold += it->val;
		took = TRUE;
	}
	else if (d->misc && d->misc != D1IM_BOOK)
	{
		for (s = 0; s < 8; s++)
		{
			if (!took && !d1_belt[s])
			{
				d1_belt[s] = it->itm;
				took = TRUE;
			}
		}
		if (!took)
			took = D1InvPut(it->itm, it->val);
	}
	else if (d->misc == D1IM_BOOK)
		took = D1InvPut(it->itm, it->val);
	else
	{
		took = D1InvPut(it->itm, it->val);
		if (took && d1_inv_last >= 0)
		{
			D1StCopy(&d1_st_inv[d1_inv_last], &d1_st_ground[ii - 1]);
			if (d1_pow_take)
				(*d1_pow_take)(ii - 1, d1_inv_last);
		}
	}

	if (!took)
		return FALSE;
	D1ItmSndPlay(it->itm);
	it->active = FALSE;
	d1_ditem[x + y * D1_MAXDUN] = 0;
	return TRUE;
}

Bool D1ItemAutoPickup(I64 x, I64 y)
{
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	CD1ItmDef *d;

	if (!ii)
		return FALSE;
	it = &d1_items[ii - 1];
	if (!it->active)
		return FALSE;
	d = &d1_itmdefs[it->itm];
	if (d->cls == D1IC_GOLD)
	{
		if (!d1_opt_apgold)
			return FALSE;
	}
	else if (!d1_opt_apitem)
		return FALSE;
	return D1ItemPickup(x, y);
}

U0 D1BeltUse(I64 slot)
{
	I64 misc;

	if (slot < 0 || slot > 7)
		return;
	if (!d1_belt[slot] || d1_plr_dead)
		return;
	misc = d1_itmdefs[d1_belt[slot]].misc;
	if (!misc || misc == D1IM_BOOK)
		return;
	if (d1_net_on)
	{
		D1NetQueue(D1NC_BELT, slot, misc, 0);
		return;
	}
	D1ItmSndPlay(d1_belt[slot]);
	D1ItemUseMisc(misc);
	d1_belt[slot] = 0;
}

U0 D1ItemTickAll()
{
	I64 i;
	I64 nf;

	if (d1_currlevel > d1_deepest_lvl)
		d1_deepest_lvl = d1_currlevel;
	if (d1_pow_tick)
		(*d1_pow_tick)();
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active)
		{
			nf = d1_idrop_len[d1_itmdefs[d1_items[i].itm].drop];
			if (d1_items[i].frame < nf)
				d1_items[i].frame++;
		}
	}
}

U0 D1ItemDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	U8	*buf;
	Bool lit = d1_dlight[x + y * D1_MAXDUN] < D1_LIGHT_MAX;

	if (!ii)
		return;
	it = &d1_items[ii - 1];
	if (!it->active)
		return;

	buf = D1ItmDropCel(d1_itmdefs[it->itm].drop);
	if (buf)
	{
		if (lit && (ii - 1 == d1_hover_ii || Bt(kbd.down_bitmap, SC_ALT)))
			D1CelDrawOutline(sx - 16, sy, buf, it->frame, 96,
				D1_OUTLINE_ITM);
		D1CelDraw(sx - 16, sy, buf, it->frame, 96);
	}
}

I64 D1ItemAtTile(I64 x, I64 y)
{//ground item index at tile, -1 none
	I64 ii;

	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return -1;
	ii = d1_ditem[x + y * D1_MAXDUN];
	if (!ii)
		return -1;
	if (!d1_items[ii - 1].active)
		return -1;
	return ii - 1;
}

I64 D1ItemAtCurs(I64 x, I64 y)
{
	I64 ii = D1ItemAtTile(x + 1, y);

	if (ii >= 0)
		return ii;
	ii = D1ItemAtTile(x, y + 1);
	if (ii >= 0)
		return ii;
	ii = D1ItemAtTile(x, y);
	if (ii >= 0)
		return ii;
	return D1ItemAtTile(x + 1, y + 1);
}
