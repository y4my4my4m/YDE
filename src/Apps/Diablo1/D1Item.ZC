// D1Item.ZC - ground items, gold, potions, the belt
//
// three item kinds: gold piles, healing and mana potions. drop cels are
// unclipped flip animations (GoldFlip 10 frames, FBttle/FBttleBL 16);
// the resting frame is the last. belt holds eight potions, keys 1-8 drink.

#define D1_MAXITEM		64
#define D1IT_GOLD		0
#define D1IT_HEAL		1
#define D1IT_MANA		2

class CD1Item
{
	I64	 type;
	I64	 x;
	I64	 y;
	I64	 amount;		//gold value
	I64	 frame;			//flip anim, counts up to rest
	Bool active;
};

CD1Item d1_items[D1_MAXITEM];
U8	 d1_ditem[D1_MAXDUN * D1_MAXDUN];	//item idx+1
I64	 d1_plr_gold = 0;
I64	 d1_belt[8];						//0 empty, else D1IT_*
Bool d1_item_init = FALSE;

U8	*d1_gfx_gold = NULL;
U8	*d1_gfx_heal = NULL;
U8	*d1_gfx_mana = NULL;

U0 D1ItemInit()
{
	I64 i;
	I64 size;

	if (!d1_item_init)
	{
		d1_gfx_gold = D1MpqRead("Items\\GoldFlip.CEL", &size);
		d1_gfx_heal = D1MpqRead("Items\\FBttle.CEL", &size);
		d1_gfx_mana = D1MpqRead("Items\\FBttleBL.CEL", &size);
		for (i = 0; i < 8; i++)
			d1_belt[i] = 0;
		d1_plr_gold = 0;
		d1_item_init = TRUE;
	}
}

U0 D1ItemClear()
{
	I64 i;

	D1ItemInit;
	for (i = 0; i < D1_MAXITEM; i++)
		d1_items[i].active = FALSE;
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_ditem[i] = 0;
}

U0 D1ItemDrop(I64 type, I64 x, I64 y, I64 amount)
{//nudges to a free neighbor when the tile is taken
	CD1Item *it = NULL;
	I64	 i;
	I64	 d;

	D1ItemInit;

	if (d1_ditem[x + y * D1_MAXDUN])
	{
		i = -1;
		for (d = 0; d < 8; d++)
		{
			if (i < 0 && D1Walkable(x + d1_dir_dx[d], y + d1_dir_dy[d]) &&
				!d1_ditem[x + d1_dir_dx[d] + (y + d1_dir_dy[d]) * D1_MAXDUN])
				i = d;
		}
		if (i < 0)
			return;
		x += d1_dir_dx[i];
		y += d1_dir_dy[i];
	}

	d = -1;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d < 0 && !d1_items[i].active)
			d = i;
	}
	if (d < 0)
		return;
	it = &d1_items[d];

	it->type   = type;
	it->x      = x;
	it->y      = y;
	it->amount = amount;
	it->frame  = 1;
	it->active = TRUE;
	d1_ditem[x + y * D1_MAXDUN] = d + 1;
}

U0 D1ItemMonsterDrop(I64 x, I64 y, I64 mlvl)
{//quarter of kills drop something
	I64 r = D1Rnd(8);

	if (r == 0)
		D1ItemDrop(D1IT_GOLD, x, y, 5 + D1Rnd(10 * mlvl + 10));
	else if (r == 1)
		D1ItemDrop(D1IT_HEAL, x, y, 0);
	else if (r == 2)
		D1ItemDrop(D1IT_MANA, x, y, 0);
}

Bool D1ItemPickup(I64 x, I64 y)
{//TRUE when something was taken
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	I64	 s;

	if (!ii)
		return FALSE;
	it = &d1_items[ii - 1];
	if (!it->active)
		return FALSE;

	if (it->type == D1IT_GOLD)
		d1_plr_gold += it->amount;
	else
	{//potion -> first free belt slot
		for (s = 0; s < 8; s++)
		{
			if (!d1_belt[s])
			{
				d1_belt[s] = it->type;
				it->active = FALSE;
				d1_ditem[x + y * D1_MAXDUN] = 0;
				return TRUE;
			}
		}
		return FALSE;			//belt full, stays on the ground
	}

	it->active = FALSE;
	d1_ditem[x + y * D1_MAXDUN] = 0;
	return TRUE;
}

U0 D1BeltUse(I64 slot)
{
	if (slot < 0 || slot > 7)
		return;
	if (!d1_belt[slot] || d1_plr_dead)
		return;

	if (d1_belt[slot] == D1IT_HEAL)
	{
		d1_plr_hp += d1_plr_maxhp / 2 + (D1Rnd(d1_plr_maxhp / 4 + 1));
		if (d1_plr_hp > d1_plr_maxhp)
			d1_plr_hp = d1_plr_maxhp;
	}
	else
	{
		d1_plr_mana += d1_plr_maxmana / 2 + (D1Rnd(d1_plr_maxmana / 4 + 1));
		if (d1_plr_mana > d1_plr_maxmana)
			d1_plr_mana = d1_plr_maxmana;
	}
	d1_belt[slot] = 0;
}

U0 D1ItemTickAll()
{//flip anims run to their resting frame
	I64 i;
	I64 nf;

	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active)
		{
			nf = 10;
			if (d1_items[i].type != D1IT_GOLD)
				nf = 16;
			if (d1_items[i].frame < nf)
				d1_items[i].frame++;
		}
	}
}

U0 D1ItemDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{//under actors
	I64	 ii = d1_ditem[x + y * D1_MAXDUN];
	CD1Item *it;
	U8	*buf;

	if (!ii)
		return;
	it = &d1_items[ii - 1];
	if (!it->active)
		return;

	buf = d1_gfx_gold;
	if (it->type == D1IT_HEAL)
		buf = d1_gfx_heal;
	if (it->type == D1IT_MANA)
		buf = d1_gfx_mana;
	if (buf)
		D1CelDraw(sx - 16, sy, buf, it->frame, 96);
}
