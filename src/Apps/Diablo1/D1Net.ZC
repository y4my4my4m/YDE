// D1Net.ZC - Zeal-to-Zeal LAN multiplayer: transport, session, lockstep turns
//
// transport is the Quake port's: the same ZealOS UDP socket calls
// (UDPSocket / UDPSocketBind / UDPPacketAllocate / UDPSocketReceiveFrom),
// the same INADDR_ANY bind, the same receive_timeout_ms = 0 non-blocking
// rule, the same ARPCacheFind gate before a unicast send. QNetUdp.ZC is not
// referenced; the technique is copied so the two ports stay independent.
// QNet.ZC:14 records that rtl8139 under QEMU drops multi-kB UDP blobs, so no
// datagram here exceeds 544 bytes and the character pack is fragmented.
//
// game model mirrors devilution's peer-to-peer lockstep (nthread.cpp,
// msg.cpp, multi.cpp): no server owns the world. Every peer runs the same
// simulation over the same command stream and the dungeon is regenerated
// from shared seeds rather than transmitted.
//
// turn model, and where each number comes from:
//   game tick     50 ms, 20 Hz          Diablo1.ZC loop, diablo.cpp
//                                       nthread_recv_turns' last_tick += 50
//   turn period   4 game ticks, 5 Hz    nthread_start sets
//                                       sgbNetUpdateRate = 20 / defaultturnssec
//                                       and the retail TCP/IPX providers report
//                                       defaultturnssec 5, so one turn per 4
//                                       of nthread's 50 ms passes
//   turn delay    2 turns, 400 ms       gdwTurnsInTransit, from
//                                       caps.defaultturnsintransit
//   redundancy    3 records per packet  the current turn and the two before it
// 4 divides the 20 Hz loop exactly, so a turn boundary is always a tick
// boundary and no command lands mid-tick.
//
// packet layout. every field little endian. header, 12 bytes:
//    0   4  magic "D1NP"
//    4   1  type, D1NP_*
//    5   1  sender peer id, 0xFF while unassigned
//    6   1  protocol version, 1
//    7   1  zero
//    8   4  turn number
// bodies, from offset 12:
//   QUERY   -                                              12 bytes
//   INFO    +0 1 peers used, +1 1 peers max, +2 32 name    46
//   JOIN    +0 32 character name                           44
//   ACCEPT  +0 1 assigned id, +1 1 peer count, +2 2 zero,
//           +4 4 game seed, +8 68 the 17 level seeds       88
//   REJECT  +0 4 reason                                    16
//   PACK    +0 4 total length, +4 4 fragment offset,
//           +8 2 fragment length, +10 2 zero, +12 N bytes  <= 536
//   PACKACK +0 4 bytes received                            16
//   TURN    +0 1 record count, +1 3 zero, then count
//           records of 20 bytes: turn, cmd, a, b, c        <= 76
//   LEAVE   -                                              12
//
// the character pack body is the D1Save version 4 file image byte for byte,
// header and all - the same 3688 bytes D1SaveWrite produces. One serialization
// for disk and wire; D1Save.ZC:17 documents the field offsets.
//
// RNG: every peer must consume D1Rnd in the same order. The lockstep
// simulation runs between D1NetSimEnter and D1NetSimLeave, which swap d1_seed
// for a separate shared stream, so local-only rolls (store stock, towner
// gossip, front end) cannot perturb it.

#define D1_MAXPEER		4
#define D1NET_PORT		26010		//Quake holds 26000 on the same wire
#define D1NET_VER		1
#define D1NET_HDR		12
#define D1NET_MTU		544			//largest datagram this port emits
#define D1NET_FRAG		512			//character pack fragment payload
#define D1NET_NSEED		17			//town plus 16 dungeon levels
#define D1NET_PACKMAX	4096		//D1Save version 4 image is 3688

//turn cadence
#define D1NET_TICKS		4			//game ticks per network turn
#define D1NET_DELAY		2			//gdwTurnsInTransit
#define D1NET_REDUN		3			//turn records repeated per packet
#define D1NET_RING		64			//turn slots buffered per peer
#define D1NET_STALLMAX	50			//turns waited before a peer is dropped

//packet types
#define D1NP_QUERY		1
#define D1NP_INFO		2
#define D1NP_JOIN		3
#define D1NP_ACCEPT		4
#define D1NP_REJECT		5
#define D1NP_PACK		6
#define D1NP_PACKACK	7
#define D1NP_TURN		8
#define D1NP_LEAVE		9

//reject reasons
#define D1NR_FULL		1
#define D1NR_VERSION	2

//per-turn commands. one per peer per turn, msg.cpp CMD_* reduced.
#define D1NC_NONE		0			//no input this turn
#define D1NC_WALK		1			//a,b = target tile   (CMD_WALKXY)
#define D1NC_ATTACK		2			//a = monster index   (CMD_ATTACKID)
#define D1NC_STAND		3			//a,b = tile to face  (SHIFT swing)
#define D1NC_PICKUP		4			//a,b = tile          (CMD_GETITEM)
#define D1NC_OPEN		5			//a,b = tile          (CMD_OPOBJXY)
#define D1NC_BELT		6			//a = slot, b = misc  (CMD_USEPLRITEM)
#define D1NC_WARP		7			//a = level, b = entry(CMD_NEWLVL)

//session states
#define D1NS_OFF		0
#define D1NS_HOSTING	1			//waiting for a join
#define D1NS_JOINING	2			//JOIN sent, waiting for ACCEPT
#define D1NS_PACKING	3			//character pack in flight
#define D1NS_PLAY		4
#define D1NS_ERROR		5

#define D1NET_PATHMAX	96

class CD1Peer
{//one player in the session. every field here is either shipped at join or
 //derived identically on every peer from the turn stream.
	Bool used;
	Bool local;					//this machine drives it
	Bool dead;
	U32	 ip;					//host order, first octet in the low byte
	U8	 name[32];
	I64	 cls;
	I64	 lvl;
	I64	 str;
	I64	 dex;
	I64	 ac;					//D1InvAC of the owner, shipped
	I64	 dmin;					//D1InvDmgMin/Max of the owner, shipped
	I64	 dmax;
	I64	 hp;					//64ths
	I64	 maxhp;
	I64	 mana;
	I64	 maxmana;
	I64	 dlvl;					//dungeon level the peer stands on
	I64	 x;
	I64	 y;
	I64	 dir;
	I64	 mode;					//D1PM_*
	I64	 frame;
	I64	 animcnt;
	I64	 step;
	I64	 xoff;
	I64	 yoff;
	I64	 target;				//monster index under attack, -1 none
	I64	 path[D1NET_PATHMAX];
	I64	 pathlen;
	I64	 pathpos;
	I64	 stall;					//turns waited on this peer's command
};

class CD1TurnRec
{
	Bool have;
	I64	 turn;
	I64	 cmd;
	I64	 a;
	I64	 b;
	I64	 c;
};

CD1Peer		d1_peers[D1_MAXPEER];
CD1TurnRec	d1_net_ring[D1_MAXPEER * D1NET_RING];

Bool	d1_net_on		= FALSE;	//lockstep simulation is live
Bool	d1_net_host		= FALSE;
I64		d1_net_state	= D1NS_OFF;
I64		d1_net_self		= 0;		//own peer id
I64		d1_net_npeers	= 1;
I64		d1_net_turn		= 0;		//turn about to execute
I64		d1_net_tick		= 0;		//game ticks since the last turn
U8		d1_net_status[96];
U8		d1_net_gname[32];

I64		d1_net_gameseed	= 0;
I64		d1_net_seeds[D1NET_NSEED];

//local input latched for the turn now being composed
I64		d1_net_cmd		= D1NC_NONE;
I64		d1_net_arg_a	= 0;
I64		d1_net_arg_b	= 0;
I64		d1_net_arg_c	= 0;

//lockstep RNG. d1_seed carries the shared stream only inside the sim window.
I64		d1_net_simseed	= 0;
I64		d1_net_locseed	= 0;
Bool	d1_net_insim	= FALSE;

//counters, reported by D1NetStat
I64		d1_net_sent		= 0;
I64		d1_net_recvd	= 0;
I64		d1_net_dups		= 0;		//turn record already held
I64		d1_net_late		= 0;		//turn record older than the executed turn
I64		d1_net_stalls	= 0;		//turn boundaries waited out
I64		d1_net_errors	= 0;
I64		d1_net_unres	= 0;		//sends skipped, peer mac unknown

//character pack, in the D1Save version 4 image layout
U8		d1_net_packbuf[D1NET_PACKMAX];
I64		d1_net_packlen	= 0;
I64		d1_net_packgot	= 0;		//bytes of the inbound pack received
I64		d1_net_packwant	= 0;
I64		d1_net_packfrom	= -1;		//peer the inbound pack belongs to

//Diablo1.ZC installs these; the character pack needs the inventory and stat
//globals, which compile after this file
I64	(*d1_net_pack_build)(U8 *dst, I64 max)   = NULL;
Bool(*d1_net_pack_apply)(I64 pi, U8 *src, I64 len) = NULL;

U8	d1_net_txbuf[D1NET_MTU];
U8	d1_net_rxbuf[D1NET_MTU];

//--- little endian field access -------------------------------------------

U0 D1NetWrU16(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
}

U0 D1NetWrU32(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
	p[off + 2] = (v >> 16) & 0xFF;
	p[off + 3] = (v >> 24) & 0xFF;
}

I64 D1NetRdU16(U8 *p, I64 off)
{
	return p[off] | (p[off + 1] << 8);
}

I64 D1NetRdI32(U8 *p, I64 off)
{
	return D1RdI32(p + off);
}

//--- peer table -----------------------------------------------------------

U0 D1PeerClear(I64 pi)
{//globals are not zeroed
	CD1Peer *p = &d1_peers[pi];
	I64 i;

	p->used    = FALSE;
	p->local   = FALSE;
	p->dead    = FALSE;
	p->ip      = 0;
	p->name[0] = 0;
	p->cls     = 0;
	p->lvl     = 1;
	p->str     = 30;
	p->dex     = 20;
	p->ac      = 0;
	p->dmin    = 1;
	p->dmax    = 6;
	p->hp      = 70 << 6;
	p->maxhp   = 70 << 6;
	p->mana    = 0;
	p->maxmana = 0;
	p->dlvl    = 0;
	p->x       = 75;
	p->y       = 68;
	p->dir     = 0;
	p->mode    = 0;
	p->frame   = 1;
	p->animcnt = 0;
	p->step    = 0;
	p->xoff    = 0;
	p->yoff    = 0;
	p->target  = -1;
	p->pathlen = 0;
	p->pathpos = 0;
	p->stall   = 0;
	for (i = 0; i < D1NET_PATHMAX; i++)
		p->path[i] = 0;
}

I64 D1PeerCount()
{
	I64 i;
	I64 n = 0;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
			n++;
	}
	return n;
}

I64 D1PeerByIP(U32 ip)
{//-1 when the address is not in the session
	I64 i;
	I64 r = -1;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (r < 0 && d1_peers[i].used && d1_peers[i].ip == ip)
			r = i;
	}
	return r;
}

I64 D1PeerFree()
{
	I64 i;
	I64 r = -1;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (r < 0 && !d1_peers[i].used)
			r = i;
	}
	return r;
}

//--- lockstep RNG window --------------------------------------------------

U0 D1NetSimEnter()
{//shared stream in, local stream parked. single player leaves d1_seed alone.
	if (!d1_net_on || d1_net_insim)
		return;
	d1_net_locseed = d1_seed;
	d1_seed        = d1_net_simseed;
	d1_net_insim   = TRUE;
}

U0 D1NetSimLeave()
{
	if (!d1_net_insim)
		return;
	d1_net_simseed = d1_seed;
	d1_seed        = d1_net_locseed;
	d1_net_insim   = FALSE;
}

//--- turn ring ------------------------------------------------------------

I64 D1NetRingSlot(I64 pi, I64 turn)
{
	return pi * D1NET_RING + turn % D1NET_RING;
}

U0 D1NetRingClear()
{
	I64 i;

	for (i = 0; i < D1_MAXPEER * D1NET_RING; i++)
	{
		d1_net_ring[i].have = FALSE;
		d1_net_ring[i].turn = -1;
		d1_net_ring[i].cmd  = D1NC_NONE;
		d1_net_ring[i].a    = 0;
		d1_net_ring[i].b    = 0;
		d1_net_ring[i].c    = 0;
	}
}

Bool D1NetPostCmd(I64 pi, I64 turn, I64 cmd, I64 a, I64 b, I64 c)
{//one command record into the ring. FALSE = duplicate or too late; both are
 //counted, neither is an error. redundancy makes duplicates the common case.
	CD1TurnRec *r;

	if (pi < 0 || pi >= D1_MAXPEER || turn < 0)
		return FALSE;
	if (turn < d1_net_turn)
	{
		d1_net_late++;
		return FALSE;
	}
	if (turn >= d1_net_turn + D1NET_RING)
		return FALSE;			//beyond the buffer; the sender is far ahead

	r = &d1_net_ring[D1NetRingSlot(pi, turn)];
	if (r->have && r->turn == turn)
	{
		d1_net_dups++;
		return FALSE;
	}

	r->have = TRUE;
	r->turn = turn;
	r->cmd  = cmd;
	r->a    = a;
	r->b    = b;
	r->c    = c;
	return TRUE;
}

Bool D1NetHaveTurn(I64 turn)
{//every live peer has posted a command for this turn
	I64 i;
	CD1TurnRec *r;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
		{
			r = &d1_net_ring[D1NetRingSlot(i, turn)];
			if (!r->have || r->turn != turn)
				return FALSE;
		}
	}
	return TRUE;
}

U0 D1NetTakeCmd(I64 pi, I64 turn, I64 *cmd, I64 *a, I64 *b, I64 *c)
{//the record for a turn, then release the slot
	CD1TurnRec *r = &d1_net_ring[D1NetRingSlot(pi, turn)];

	*cmd = D1NC_NONE;
	*a   = 0;
	*b   = 0;
	*c   = 0;
	if (!r->have || r->turn != turn)
		return;
	*cmd = r->cmd;
	*a   = r->a;
	*b   = r->b;
	*c   = r->c;
	r->have = FALSE;
}

U0 D1NetQueue(I64 cmd, I64 a, I64 b, I64 c)
{//latch this frame's input. one command per turn: the last click wins, as
 //msg.cpp's single pending command per player does.
	d1_net_cmd   = cmd;
	d1_net_arg_a = a;
	d1_net_arg_b = b;
	d1_net_arg_c = c;
}

//--- transport ------------------------------------------------------------

#ifdef UDP_MAX_PORT

CUDPSocket			*d1_net_sock = NULL;
CSocketAddressIPV4	*d1_net_bind = NULL;
Bool				 d1_net_ready = FALSE;
U32					 d1_net_fromip = 0;
I64					 d1_net_fromport = D1NET_PORT;

Bool D1NetOpen(I64 port)
{//both ends bind the same port, as the Quake port does
	if (d1_net_ready)
		return TRUE;

	//no dhcp: NetConfigure retries to exhaustion on a link with no server and
	//stalls the frame loop. the menu sets an address statically.
	if (!ipv4_globals.local_ip)
	{
		D1StrCopy(d1_net_status, "set an IP first", 96);
		return FALSE;
	}

	d1_net_sock = UDPSocket(AF_INET);
	if (!d1_net_sock)
	{
		D1StrCopy(d1_net_status, "UDPSocket failed", 96);
		return FALSE;
	}

	d1_net_bind = CAlloc(sizeof(CSocketAddressIPV4));

	//ports go on the wire big endian; the socket layer does not swap
	d1_net_bind->family = AF_INET;
	d1_net_bind->port   = EndianU16(port);

	//INADDR_ANY, not the local address: UDPHandler matches the bound address
	//against the packet SOURCE
	d1_net_bind->address.address = INADDR_ANY;

	if (UDPSocketBind(d1_net_sock, d1_net_bind) == -1)
	{
		D1StrCopy(d1_net_status, "UDPSocketBind failed", 96);
		Free(d1_net_bind);
		d1_net_bind = NULL;
		UDPSocketClose(d1_net_sock);
		d1_net_sock = NULL;
		return FALSE;
	}

	//must be non blocking: with a timeout set UDPSocketReceiveFrom sleeps and
	//the game loop stalls for as long as the peer stays quiet
	d1_net_sock->receive_timeout_ms = 0;
	d1_net_ready = TRUE;
	StrPrint(d1_net_status, "bound to port %d", port);
	return TRUE;
}

U0 D1NetClose()
{
	if (!d1_net_ready)
		return;
	if (d1_net_sock)
		UDPSocketClose(d1_net_sock);
	if (d1_net_bind)
		Free(d1_net_bind);
	d1_net_sock  = NULL;
	d1_net_bind  = NULL;
	d1_net_ready = FALSE;
}

Bool D1NetSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port)
{
	U8	*payload;
	I64	 de_index;
	I64	 dport = dest_port;

	if (!d1_net_ready || !dest_ip || !data || len < 1)
		return FALSE;
	if (len > D1NET_MTU)
		return FALSE;
	if (dport < 1 || dport > 65535)
		dport = D1NET_PORT;

	//cache only: IPV4AddressMACGet blocks two seconds on a miss, which the
	//game loop cannot pay. resolution happens once, at connect.
	if (!ARPCacheFind(dest_ip))
	{
		d1_net_unres++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, D1NET_PORT,
		dest_ip, dport, len);
	if (de_index < 0)
	{
		d1_net_errors++;
		return FALSE;
	}
	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);
	d1_net_sent++;
	return TRUE;
}

Bool D1NetSendRawBroadcast(U8 *data, I64 len, I64 dest_port)
{//255.255.255.255 is never in the arp cache and needs no lookup:
 //IPV4AddressMACGet short circuits it to the ethernet broadcast address
	U8	*payload;
	I64	 de_index;
	I64	 dport = dest_port;

	if (!d1_net_ready || !data || len < 1)
		return FALSE;
	if (len > D1NET_MTU)
		return FALSE;
	if (dport < 1 || dport > 65535)
		dport = D1NET_PORT;

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, D1NET_PORT,
		0xFFFFFFFF, dport, len);
	if (de_index < 0)
	{
		d1_net_errors++;
		return FALSE;
	}
	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);
	d1_net_sent++;
	return TRUE;
}

Bool D1NetRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{//one datagram if one is waiting, never blocks
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;
	if (!d1_net_ready || !buf || max < 1)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));
	got = UDPSocketReceiveFrom(d1_net_sock, buf, max, &from);
	if (got < 1)
		return FALSE;
	if (out_len)
		*out_len = got;

	if (from.family == AF_INET)
	{
		v4 = &from;
		//sockaddr ipv4 is network order; the arp cache and UDPPacketAllocate
		//both want host order, first octet in the low byte
		d1_net_fromip   = EndianU32(v4->address.address);
		d1_net_fromport = EndianU16(v4->port);
		if (d1_net_fromport < 1)
			d1_net_fromport = D1NET_PORT;
	}
	else
	{
		d1_net_fromip   = 0;
		d1_net_fromport = D1NET_PORT;
	}
	if (from_ip)
		*from_ip = d1_net_fromip;
	d1_net_recvd++;
	return TRUE;
}

Bool D1NetAvailable()
{
	return TRUE;
}

Bool D1NetSetLocalIP(U32 ip)
{//static address for a link with no dhcp server, which two qemu guests joined
 //by -netdev socket are. arp works there; only address and subnet are missing.
	U32 got;

	if (!ip)
		return FALSE;
	IPV4AddressSet(ip);
	//a /24 with no router: everything on-link, nothing forwarded
	IPV4SubnetSet(0, 0x00FFFFFF);
	got = ipv4_globals.local_ip;
	StrPrint(d1_net_status, "ip %d.%d.%d.%d",
		got & 255, (got >> 8) & 255, (got >> 16) & 255, (got >> 24) & 255);
	return ToBool(got == ip);
}

U32 D1NetLocalIP()
{//local_ip_be holds the byte order every address in this file uses: first
 //octet in the LOW byte, what IPV4AddressParse produces
	return ipv4_globals.local_ip_be;
}

Bool D1NetResolve(U32 ip)
{//block until the destination mac is known. menu path only; two seconds here
 //is fine and it is the honest reachability test.
	U8 *mac = NULL;

	if (!ip)
		return FALSE;
	if (ARPCacheFind(ip))
		return TRUE;
	IPV4AddressMACGet(ip, &mac);
	return ToBool(ARPCacheFind(ip) != NULL);
}

#else

//no net stack at compile time. the layer still exists - the menu and the shell
//reference it either way. it reports; it does not fake a connection.

Bool D1NetOpen(I64 port)
{
	D1StrCopy(d1_net_status, "no net stack - run ::/Home/Net/Start", 96);
	return FALSE;
}

U0 D1NetClose()
{
}

Bool D1NetSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port)
{
	return FALSE;
}

Bool D1NetSendRawBroadcast(U8 *data, I64 len, I64 dest_port)
{
	return FALSE;
}

Bool D1NetRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{
	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;
	return FALSE;
}

Bool D1NetAvailable()
{
	return FALSE;
}

Bool D1NetSetLocalIP(U32 ip)
{
	return FALSE;
}

U32 D1NetLocalIP()
{
	return 0;
}

Bool D1NetResolve(U32 ip)
{
	return FALSE;
}

#endif

//--- packet encode --------------------------------------------------------

I64 D1NetHdr(U8 *p, I64 type, I64 turn)
{//returns the body offset
	p[0] = 'D';
	p[1] = '1';
	p[2] = 'N';
	p[3] = 'P';
	p[4] = type;
	if (d1_net_state == D1NS_JOINING)
		p[5] = 0xFF;			//no id assigned yet
	else
		p[5] = d1_net_self;
	p[6] = D1NET_VER;
	p[7] = 0;
	D1NetWrU32(p, 8, turn);
	return D1NET_HDR;
}

Bool D1NetHdrOk(U8 *p, I64 len)
{
	if (len < D1NET_HDR)
		return FALSE;
	if (p[0] != 'D' || p[1] != '1' || p[2] != 'N' || p[3] != 'P')
		return FALSE;
	if (p[6] != D1NET_VER)
		return FALSE;
	return TRUE;
}

I64 D1NetEncQuery(U8 *p)
{
	return D1NetHdr(p, D1NP_QUERY, 0);
}

I64 D1NetEncInfo(U8 *p)
{
	I64 o = D1NetHdr(p, D1NP_INFO, d1_net_turn);

	p[o]     = D1PeerCount();
	p[o + 1] = D1_MAXPEER;
	D1StrCopy(p + o + 2, d1_net_gname, 32);
	return o + 34;
}

I64 D1NetEncJoin(U8 *p, U8 *name)
{
	I64 o = D1NetHdr(p, D1NP_JOIN, 0);

	D1StrCopy(p + o, name, 32);
	return o + 32;
}

I64 D1NetEncAccept(U8 *p, I64 id, I64 npeers)
{
	I64 o = D1NetHdr(p, D1NP_ACCEPT, d1_net_turn);
	I64 i;

	p[o]     = id;
	p[o + 1] = npeers;
	p[o + 2] = 0;
	p[o + 3] = 0;
	D1NetWrU32(p, o + 4, d1_net_gameseed);
	for (i = 0; i < D1NET_NSEED; i++)
		D1NetWrU32(p, o + 8 + i * 4, d1_net_seeds[i]);
	return o + 8 + D1NET_NSEED * 4;
}

I64 D1NetEncReject(U8 *p, I64 reason)
{
	I64 o = D1NetHdr(p, D1NP_REJECT, 0);

	D1NetWrU32(p, o, reason);
	return o + 4;
}

I64 D1NetEncPack(U8 *p, U8 *src, I64 total, I64 off, I64 flen)
{
	I64 o = D1NetHdr(p, D1NP_PACK, 0);

	D1NetWrU32(p, o, total);
	D1NetWrU32(p, o + 4, off);
	D1NetWrU16(p, o + 8, flen);
	D1NetWrU16(p, o + 10, 0);
	MemCopy(p + o + 12, src + off, flen);
	return o + 12 + flen;
}

I64 D1NetEncPackAck(U8 *p, I64 got)
{
	I64 o = D1NetHdr(p, D1NP_PACKACK, 0);

	D1NetWrU32(p, o, got);
	return o + 4;
}

I64 D1NetEncTurn(U8 *p, I64 turn, I64 cmd, I64 a, I64 b, I64 c)
{//the record for this turn plus the D1NET_REDUN-1 before it, taken from the
 //local ring. one lost datagram is recovered from the next.
	I64	 o = D1NetHdr(p, D1NP_TURN, turn);
	I64	 n = 0;
	I64	 k;
	I64	 t;
	I64	 ro = o + 4;
	CD1TurnRec *r;

	D1NetWrU32(p, ro, turn);
	D1NetWrU32(p, ro + 4, cmd);
	D1NetWrU32(p, ro + 8, a);
	D1NetWrU32(p, ro + 12, b);
	D1NetWrU32(p, ro + 16, c);
	n = 1;
	ro += 20;

	for (k = 1; k < D1NET_REDUN; k++)
	{
		t = turn - k;
		if (t >= 0)
		{
			r = &d1_net_ring[D1NetRingSlot(d1_net_self, t)];
			if (r->turn == t)
			{
				D1NetWrU32(p, ro, t);
				D1NetWrU32(p, ro + 4, r->cmd);
				D1NetWrU32(p, ro + 8, r->a);
				D1NetWrU32(p, ro + 12, r->b);
				D1NetWrU32(p, ro + 16, r->c);
				n++;
				ro += 20;
			}
		}
	}

	p[o]     = n;
	p[o + 1] = 0;
	p[o + 2] = 0;
	p[o + 3] = 0;
	return ro;
}

I64 D1NetEncLeave(U8 *p)
{
	return D1NetHdr(p, D1NP_LEAVE, d1_net_turn);
}

//--- packet decode --------------------------------------------------------
//
// every decoder validates the length before it reads, so a truncated or
// forged datagram cannot walk off the buffer.

I64 D1NetPktType(U8 *p, I64 len)
{
	if (!D1NetHdrOk(p, len))
		return 0;
	return p[4];
}

I64 D1NetPktPeer(U8 *p, I64 len)
{//0xFF, an unassigned sender, decodes to -1
	if (!D1NetHdrOk(p, len))
		return -1;
	if (p[5] == 0xFF)
		return -1;
	return p[5];
}

I64 D1NetPktTurn(U8 *p, I64 len)
{
	if (!D1NetHdrOk(p, len))
		return -1;
	return D1RdU32(p + 8);
}

Bool D1NetDecAccept(U8 *p, I64 len, I64 *id, I64 *npeers)
{
	I64 i;

	if (len < D1NET_HDR + 8 + D1NET_NSEED * 4)
		return FALSE;
	*id     = p[D1NET_HDR];
	*npeers = p[D1NET_HDR + 1];
	if (*id < 0 || *id >= D1_MAXPEER)
		return FALSE;
	d1_net_gameseed = D1NetRdI32(p, D1NET_HDR + 4);
	for (i = 0; i < D1NET_NSEED; i++)
		d1_net_seeds[i] = D1NetRdI32(p, D1NET_HDR + 8 + i * 4);
	return TRUE;
}

Bool D1NetDecPack(U8 *p, I64 len, I64 *total, I64 *off, I64 *flen)
{
	if (len < D1NET_HDR + 12)
		return FALSE;
	*total = D1RdU32(p + D1NET_HDR);
	*off   = D1RdU32(p + D1NET_HDR + 4);
	*flen  = D1NetRdU16(p, D1NET_HDR + 8);
	if (*total < 1 || *total > D1NET_PACKMAX)
		return FALSE;
	if (*flen < 1 || *flen > D1NET_FRAG)
		return FALSE;
	if (*off < 0 || *off + *flen > *total)
		return FALSE;
	if (len < D1NET_HDR + 12 + *flen)
		return FALSE;
	return TRUE;
}

I64 D1NetDecTurn(U8 *p, I64 len, I64 pi)
{//post every record the datagram carries. returns how many were new.
	I64 n;
	I64 k;
	I64 o;
	I64 got = 0;

	if (len < D1NET_HDR + 4)
		return 0;
	n = p[D1NET_HDR];
	if (n < 1 || n > D1NET_REDUN)
		return 0;
	if (len < D1NET_HDR + 4 + n * 20)
		return 0;

	for (k = 0; k < n; k++)
	{
		o = D1NET_HDR + 4 + k * 20;
		if (D1NetPostCmd(pi, D1NetRdI32(p, o), D1NetRdI32(p, o + 4),
			D1NetRdI32(p, o + 8), D1NetRdI32(p, o + 12),
			D1NetRdI32(p, o + 16)))
			got++;
	}
	return got;
}

//--- session --------------------------------------------------------------

U0 D1NetReset()
{//globals are not zeroed, and a second session must not inherit the first
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
		D1PeerClear(i);
	D1NetRingClear;
	for (i = 0; i < D1NET_NSEED; i++)
		d1_net_seeds[i] = 0;

	d1_net_on      = FALSE;
	d1_net_host    = FALSE;
	d1_net_state   = D1NS_OFF;
	d1_net_self    = 0;
	d1_net_npeers  = 1;
	d1_net_turn    = 0;
	d1_net_tick    = 0;
	d1_net_cmd     = D1NC_NONE;
	d1_net_arg_a   = 0;
	d1_net_arg_b   = 0;
	d1_net_arg_c   = 0;
	d1_net_simseed = 0;
	d1_net_locseed = 0;
	d1_net_insim   = FALSE;
	d1_net_gameseed = 0;
	d1_net_packlen = 0;
	d1_net_packgot = 0;
	d1_net_packwant = 0;
	d1_net_packfrom = -1;
	d1_net_sent    = 0;
	d1_net_recvd   = 0;
	d1_net_dups    = 0;
	d1_net_late    = 0;
	d1_net_stalls  = 0;
	d1_net_errors  = 0;
	d1_net_unres   = 0;
	d1_net_status[0] = 0;
	D1StrCopy(d1_net_gname, "ZEAL", 32);
}

U0 D1NetSeedRoll(I64 base)
{//the 17 level seeds and the game seed, rolled once by the host and shipped
 //whole. D1Play rolls the same way for a single player game.
	I64 i;

	D1SetRndSeed(base);
	d1_net_gameseed = D1GetRndSeed();
	for (i = 0; i < D1NET_NSEED; i++)
		d1_net_seeds[i] = D1GetRndSeed();
}

Bool D1NetHostStart(U8 *name, I64 seedbase)
{//peer 0 is always the host, so the turn execution order is stable from the
 //first turn without any negotiation
	D1NetReset;
	if (!D1NetOpen(D1NET_PORT))
	{
		d1_net_state = D1NS_ERROR;
		return FALSE;
	}
	D1NetSeedRoll(seedbase);

	d1_net_host  = TRUE;
	d1_net_self  = 0;
	d1_net_state = D1NS_HOSTING;

	D1PeerClear(0);
	d1_peers[0].used  = TRUE;
	d1_peers[0].local = TRUE;
	d1_peers[0].ip    = D1NetLocalIP();
	D1StrCopy(d1_peers[0].name, name, 32);
	d1_net_npeers = 1;

	D1StrCopy(d1_net_status, "hosting - waiting for a player", 96);
	return TRUE;
}

Bool D1NetJoinStart(U8 *name, U32 host_ip)
{//the joiner does not know its id until the host answers, so peer slots stay
 //empty here
	I64 n;

	D1NetReset;
	if (!D1NetOpen(D1NET_PORT))
	{
		d1_net_state = D1NS_ERROR;
		return FALSE;
	}
	if (!D1NetResolve(host_ip))
	{
		D1StrCopy(d1_net_status, "no answer from that address", 96);
		d1_net_state = D1NS_ERROR;
		return FALSE;
	}

	d1_net_host  = FALSE;
	d1_net_self  = 1;			//provisional; ACCEPT settles it
	d1_net_state = D1NS_JOINING;
	D1StrCopy(d1_peers[0].name, "host", 32);
	d1_peers[0].ip = host_ip;

	n = D1NetEncJoin(d1_net_txbuf, name);
	D1NetSendRawTo(d1_net_txbuf, n, host_ip, D1NET_PORT);
	D1StrCopy(d1_net_status, "joining...", 96);
	return TRUE;
}

U0 D1NetQuery()
{//limited broadcast: neither end knows the other exists, so there is nothing
 //to unicast to (Datagram_SearchForHosts)
	I64 n = D1NetEncQuery(d1_net_txbuf);

	D1NetSendRawBroadcast(d1_net_txbuf, n, D1NET_PORT);
}

U0 D1NetPackSendTo(U32 ip)
{//the local character, in D1Save version 4 image bytes, fragmented
	I64 off = 0;
	I64 flen;
	I64 n;

	if (!d1_net_pack_build)
		return;
	d1_net_packlen = (*d1_net_pack_build)(d1_net_packbuf, D1NET_PACKMAX);
	if (d1_net_packlen < 1)
		return;

	while (off < d1_net_packlen)
	{
		flen = d1_net_packlen - off;
		if (flen > D1NET_FRAG)
			flen = D1NET_FRAG;
		n = D1NetEncPack(d1_net_txbuf, d1_net_packbuf, d1_net_packlen, off,
			flen);
		D1NetSendRawTo(d1_net_txbuf, n, ip, D1NET_PORT);
		off += flen;
	}
}

U0 D1NetSendTurn(I64 turn)
{//one datagram to every remote peer. broadcast would reach both, but a
 //unicast per peer keeps a four-player session working through a switch that
 //filters broadcast.
	I64 i;
	I64 n;

	n = D1NetEncTurn(d1_net_txbuf, turn, d1_net_cmd, d1_net_arg_a,
		d1_net_arg_b, d1_net_arg_c);
	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].local && d1_peers[i].ip)
			D1NetSendRawTo(d1_net_txbuf, n, d1_peers[i].ip, D1NET_PORT);
	}
}

U0 D1NetLeave()
{
	I64 i;
	I64 n;

	if (d1_net_state == D1NS_OFF)
		return;
	n = D1NetEncLeave(d1_net_txbuf);
	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].local && d1_peers[i].ip)
			D1NetSendRawTo(d1_net_txbuf, n, d1_peers[i].ip, D1NET_PORT);
	}
	D1NetClose;
	D1NetReset;
}

U0 D1NetOnJoin(U8 *p, I64 len, U32 from)
{//host side. an address already in the session re-sends its accept: the
 //client's first ACCEPT may have been the datagram that was dropped.
	I64 id = D1PeerByIP(from);
	I64 n;

	if (!d1_net_host)
		return;

	if (id < 0)
	{
		id = D1PeerFree();
		if (id < 0)
		{
			n = D1NetEncReject(d1_net_txbuf, D1NR_FULL);
			D1NetSendRawTo(d1_net_txbuf, n, from, D1NET_PORT);
			return;
		}
		D1PeerClear(id);
		d1_peers[id].used  = TRUE;
		d1_peers[id].local = FALSE;
		d1_peers[id].ip    = from;
		if (len >= D1NET_HDR + 32)
			D1StrCopy(d1_peers[id].name, p + D1NET_HDR, 32);
		d1_net_npeers = D1PeerCount();
	}

	n = D1NetEncAccept(d1_net_txbuf, id, d1_net_npeers);
	D1NetSendRawTo(d1_net_txbuf, n, from, D1NET_PORT);
	D1NetPackSendTo(from);
	StrPrint(d1_net_status, "%s joined as peer %d", d1_peers[id].name, id);
}

U0 D1NetOnAccept(U8 *p, I64 len, U32 from)
{//client side. seeds arrive here; the shell regenerates every level from them.
	I64 id = 0;
	I64 np = 0;

	if (d1_net_state != D1NS_JOINING)
		return;
	if (!D1NetDecAccept(p, len, &id, &np))
		return;

	d1_net_self = id;
	D1PeerClear(id);
	d1_peers[id].used  = TRUE;
	d1_peers[id].local = TRUE;
	d1_peers[id].ip    = D1NetLocalIP();

	D1PeerClear(0);
	d1_peers[0].used = TRUE;
	d1_peers[0].ip   = from;
	D1StrCopy(d1_peers[0].name, "host", 32);

	d1_net_npeers = D1PeerCount();
	d1_net_state  = D1NS_PACKING;
	d1_net_packgot  = 0;
	d1_net_packwant = 0;
	d1_net_packfrom = 0;

	//the joiner ships its own character back so the host can draw it
	D1NetPackSendTo(from);
	StrPrint(d1_net_status, "joined as peer %d", id);
}

U0 D1NetOnPack(U8 *p, I64 len, U32 from)
{//fragments arrive in order on a quiet link and out of order on a busy one;
 //the offset in every fragment makes both work
	I64 total = 0;
	I64 off   = 0;
	I64 flen  = 0;
	I64 pi    = D1PeerByIP(from);
	I64 n;

	if (pi < 0)
		return;
	if (!D1NetDecPack(p, len, &total, &off, &flen))
		return;

	if (d1_net_packfrom != pi || d1_net_packwant != total)
	{
		d1_net_packfrom = pi;
		d1_net_packwant = total;
		d1_net_packgot  = 0;
	}
	MemCopy(d1_net_packbuf + off, p + D1NET_HDR + 12, flen);
	d1_net_packgot += flen;

	n = D1NetEncPackAck(d1_net_txbuf, d1_net_packgot);
	D1NetSendRawTo(d1_net_txbuf, n, from, D1NET_PORT);

	if (d1_net_packgot >= total)
	{
		if (d1_net_pack_apply)
		{
			if ((*d1_net_pack_apply)(pi, d1_net_packbuf, total))
				StrPrint(d1_net_status, "%s ready", d1_peers[pi].name);
		}
		d1_net_packgot  = 0;
		d1_net_packwant = 0;
	}
}

U0 D1NetOnLeave(U32 from)
{
	I64 pi = D1PeerByIP(from);

	if (pi < 0 || d1_peers[pi].local)
		return;
	StrPrint(d1_net_status, "%s left", d1_peers[pi].name);
	D1PeerClear(pi);
	d1_net_npeers = D1PeerCount();
}

U0 D1NetPump()
{//drain the socket. never blocks; safe to call from the frame loop.
	I64	 len = 0;
	U32	 from = 0;
	I64	 type;
	I64	 pi;
	I64	 guard = 0;

	if (d1_net_state == D1NS_OFF || d1_net_state == D1NS_ERROR)
		return;

	//bounded: a peer flooding the wire must not hold the frame loop
	while (guard < 64 && D1NetRecvRaw(d1_net_rxbuf, D1NET_MTU, &len, &from))
	{
		guard++;
		type = D1NetPktType(d1_net_rxbuf, len);
		if (type == D1NP_QUERY)
		{
			if (d1_net_host)
			{
				pi = D1NetEncInfo(d1_net_txbuf);
				D1NetSendRawTo(d1_net_txbuf, pi, from, D1NET_PORT);
			}
		}
		else if (type == D1NP_JOIN)
			D1NetOnJoin(d1_net_rxbuf, len, from);
		else if (type == D1NP_ACCEPT)
			D1NetOnAccept(d1_net_rxbuf, len, from);
		else if (type == D1NP_REJECT)
		{
			D1StrCopy(d1_net_status, "host refused the join", 96);
			d1_net_state = D1NS_ERROR;
		}
		else if (type == D1NP_PACK)
			D1NetOnPack(d1_net_rxbuf, len, from);
		else if (type == D1NP_TURN)
		{
			pi = D1PeerByIP(from);
			if (pi >= 0 && !d1_peers[pi].local)
				D1NetDecTurn(d1_net_rxbuf, len, pi);
		}
		else if (type == D1NP_LEAVE)
			D1NetOnLeave(from);
	}
}

U0 D1NetGoLive()
{//both peers have each other's character; start the lockstep clock
	d1_net_on      = TRUE;
	d1_net_state   = D1NS_PLAY;
	d1_net_turn    = 0;
	d1_net_tick    = 0;
	d1_net_simseed = d1_net_gameseed;
	d1_net_npeers  = D1PeerCount();
	D1NetRingClear;
	//D1NET_DELAY turns of silence at the head, so turn 0 executes without
	//waiting for input nobody has produced yet (nthread_send_and_recv_turn
	//primes the pipe the same way)
	D1NetPostCmd(d1_net_self, 0, D1NC_NONE, 0, 0, 0);
	D1NetPostCmd(d1_net_self, 1, D1NC_NONE, 0, 0, 0);
	D1StrCopy(d1_net_status, "in game", 96);
}

Bool D1NetTurnDue()
{//TRUE once every D1NET_TICKS game ticks
	d1_net_tick++;
	if (d1_net_tick < D1NET_TICKS)
		return FALSE;
	d1_net_tick = 0;
	return TRUE;
}

U0 D1NetPeerLost(I64 pi)
{
	StrPrint(d1_net_status, "%s timed out", d1_peers[pi].name);
	D1PeerClear(pi);
	d1_net_npeers = D1PeerCount();
}

Bool D1NetTurnReady()
{//TRUE when every peer's command for d1_net_turn is in hand. a peer that
 //never answers is dropped after D1NET_STALLMAX turns rather than freezing
 //the session forever.
	I64 i;

	if (D1NetHaveTurn(d1_net_turn))
		return TRUE;

	d1_net_stalls++;
	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].local)
		{
			d1_peers[i].stall++;
			if (d1_peers[i].stall > D1NET_STALLMAX)
				D1NetPeerLost(i);
		}
	}
	//resend: the peers still waiting most likely lost our datagram, not theirs
	D1NetSendTurn(d1_net_turn + D1NET_DELAY);
	return FALSE;
}

U0 D1NetTurnDone()
{//advance past the turn just executed and post the local command for the turn
 //D1NET_DELAY ahead, which is the one the peers are waiting on
	I64 i;

	for (i = 0; i < D1_MAXPEER; i++)
		d1_peers[i].stall = 0;

	d1_net_turn++;
	D1NetPostCmd(d1_net_self, d1_net_turn + D1NET_DELAY - 1, d1_net_cmd,
		d1_net_arg_a, d1_net_arg_b, d1_net_arg_c);
	D1NetSendTurn(d1_net_turn + D1NET_DELAY - 1);
	d1_net_cmd   = D1NC_NONE;
	d1_net_arg_a = 0;
	d1_net_arg_b = 0;
	d1_net_arg_c = 0;
}

U0 D1NetInit()
{
	D1NetReset;
	if (D1NetAvailable())
		D1StrCopy(d1_net_status, "udp available", 96);
	else
		D1StrCopy(d1_net_status, "udp not compiled in", 96);
}

D1NetInit;
