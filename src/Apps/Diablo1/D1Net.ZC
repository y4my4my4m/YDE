}

Bool D1NetAvailable()
{
	return FALSE;
}

Bool D1NetSetLocalIP(U32 ip)
{
	no_warn ip;
	return FALSE;
}

U32 D1NetLocalIP()
{
	return 0;
}

Bool D1NetResolve(U32 ip)
{
	no_warn ip;
	return FALSE;
}

