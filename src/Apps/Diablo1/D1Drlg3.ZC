// D1Drlg3.ZC - caves level generation (drlg_l3.cpp, retail path)
//
// organic growth: a seed room sprouts random blocks recursively, diagonal
// and single-cell gaps are filled, a connectivity flood (lockout) rejects
// split maps, 2x2 cells collapse through L3ConvTbl into megatiles, then a
// river is carved and lava pools flooded. wood fences, theme rooms and
// quest pieces are absent.
//
// dungeon values here start as 0/1 flags, become tile ids after MakeMegas.

#include "D1Drlg3T"

Bool d3_lavapool  = FALSE;
I64	 d3_lockcnt   = 0;
U8	 d3_lock[D1_DMAX * D1_DMAX];

U8 d3_spawn_edge_tbl[15] = {0x00, 0x0A, 0x43, 0x05, 0x2C, 0x06, 0x09, 0x00,
	0x00, 0x1C, 0x83, 0x06, 0x09, 0x0A, 0x05};
U8 d3_spawn_tbl[15] = {0x00, 0x0A, 0x03, 0x05, 0x0C, 0x06, 0x09, 0x00,
	0x00, 0x0C, 0x03, 0x06, 0x09, 0x0A, 0x05};
U8 d3_poolsub[15] = {0, 35, 26, 36, 25, 29, 34, 7, 33, 28, 27, 37, 32, 31, 30};

U0 D3InitDungeon()
{
	I64 i;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
	{
		d1_dun[i]     = 0;
		d1_dunflag[i] = 0;
	}
}

Bool D3FillRoom(I64 x1, I64 y1, I64 x2, I64 y2)
{
	I64 i;
	I64 j;
	I64 v;

	if (x1 <= 1 || x2 >= 34 || y1 <= 1 || y2 >= 38)
		return FALSE;

	v = 0;
	for (j = y1; j <= y2; j++)
		for (i = x1; i <= x2; i++)
			v += D1DunGet(i, j);

	if (v != 0)
		return FALSE;

	for (j = y1 + 1; j < y2; j++)
		for (i = x1 + 1; i < x2; i++)
			D1DunSet(i, j, 1);
	for (j = y1; j <= y2; j++)
	{
		if (D1Rnd(2) != 0)
			D1DunSet(x1, j, 1);
		if (D1Rnd(2) != 0)
			D1DunSet(x2, j, 1);
	}
	for (i = x1; i <= x2; i++)
	{
		if (D1Rnd(2) != 0)
			D1DunSet(i, y1, 1);
		if (D1Rnd(2) != 0)
			D1DunSet(i, y2, 1);
	}

	return TRUE;
}

U0 D3CreateBlock(I64 x, I64 y, I64 obs, I64 dir)
{
	I64 bx = D1Rnd(2) + 3;
	I64 by = D1Rnd(2) + 3;
	I64 x1 = 0;
	I64 y1 = 0;
	I64 x2 = 0;
	I64 y2 = 0;
	I64 contflag;

	if (dir == 0)
	{
		y2 = y - 1;
		y1 = y2 - by;
		if (bx < obs)
			x1 = D1Rnd(bx) + x;
		if (bx == obs)
			x1 = x;
		if (bx > obs)
			x1 = x - D1Rnd(bx);
		x2 = bx + x1;
	}
	if (dir == 3)
	{
		x2 = x - 1;
		x1 = x2 - bx;
		if (by < obs)
			y1 = D1Rnd(by) + y;
		if (by == obs)
			y1 = y;
		if (by > obs)
			y1 = y - D1Rnd(by);
		y2 = y1 + by;
	}
	if (dir == 2)
	{
		y1 = y + 1;
		y2 = y1 + by;
		if (bx < obs)
			x1 = D1Rnd(bx) + x;
		if (bx == obs)
			x1 = x;
		if (bx > obs)
			x1 = x - D1Rnd(bx);
		x2 = bx + x1;
	}
	if (dir == 1)
	{
		x1 = x + 1;
		x2 = x1 + bx;
		if (by < obs)
			y1 = D1Rnd(by) + y;
		if (by == obs)
			y1 = y;
		if (by > obs)
			y1 = y - D1Rnd(by);
		y2 = y1 + by;
	}

	if (D3FillRoom(x1, y1, x2, y2))
	{
		contflag = D1Rnd(4);
		if (contflag && dir != 2)
			D3CreateBlock(x1, y1, by, 0);
		if (contflag && dir != 3)
			D3CreateBlock(x2, y1, bx, 1);
		if (contflag && dir != 0)
			D3CreateBlock(x1, y2, by, 2);
		if (contflag && dir != 1)
			D3CreateBlock(x1, y1, bx, 3);
	}
}

U0 D3FillDiags()
{
	I64 i;
	I64 j;
	I64 v;

	for (j = 0; j < D1_DMAX - 1; j++)
		for (i = 0; i < D1_DMAX - 1; i++)
		{
			v = D1DunGet(i + 1, j + 1) + 2 * D1DunGet(i, j + 1) +
				4 * D1DunGet(i + 1, j) + 8 * D1DunGet(i, j);
			if (v == 6)
			{
				if (D1Rnd(2) == 0)
					D1DunSet(i, j, 1);
				else
					D1DunSet(i + 1, j + 1, 1);
			}
			if (v == 9)
			{
				if (D1Rnd(2) == 0)
					D1DunSet(i + 1, j, 1);
				else
					D1DunSet(i, j + 1, 1);
			}
		}
}

U0 D3FillSingles()
{
	I64 i;
	I64 j;

	for (j = 1; j < D1_DMAX - 1; j++)
		for (i = 1; i < D1_DMAX - 1; i++)
		{
			if (D1DunGet(i, j) == 0 &&
				D1DunGet(i, j - 1) + D1DunGet(i - 1, j - 1) + D1DunGet(i + 1, j - 1) == 3 &&
				D1DunGet(i + 1, j) + D1DunGet(i - 1, j) == 2 &&
				D1DunGet(i, j + 1) + D1DunGet(i - 1, j + 1) + D1DunGet(i + 1, j + 1) == 3)
				D1DunSet(i, j, 1);
		}
}

U0 D3FillStraights()
{
	I64 i;
	I64 j;
	I64 xc = 0;
	I64 xs;
	I64 yc = 0;
	I64 ys;
	I64 k;

	for (j = 0; j < D1_DMAX - 1; j++)
	{
		xs = 0;
		for (i = 0; i < 37; i++)
		{
			if (D1DunGet(i, j) == 0 && D1DunGet(i, j + 1) == 1)
			{
				if (xs == 0)
					xc = i;
				xs++;
			}
			else
			{
				if (xs > 3 && D1Rnd(2) != 0)
				{
					for (k = xc; k < i; k++)
						D1DunSet(k, j, D1Rnd(2));
				}
				xs = 0;
			}
		}
	}
	for (j = 0; j < D1_DMAX - 1; j++)
	{
		xs = 0;
		for (i = 0; i < 37; i++)
		{
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 0)
			{
				if (xs == 0)
					xc = i;
				xs++;
			}
			else
			{
				if (xs > 3 && D1Rnd(2) != 0)
				{
					for (k = xc; k < i; k++)
						D1DunSet(k, j + 1, D1Rnd(2));
				}
				xs = 0;
			}
		}
	}
	for (i = 0; i < D1_DMAX - 1; i++)
	{
		ys = 0;
		for (j = 0; j < 37; j++)
		{
			if (D1DunGet(i, j) == 0 && D1DunGet(i + 1, j) == 1)
			{
				if (ys == 0)
					yc = j;
				ys++;
			}
			else
			{
				if (ys > 3 && D1Rnd(2) != 0)
				{
					for (k = yc; k < j; k++)
						D1DunSet(i, k, D1Rnd(2));
				}
				ys = 0;
			}
		}
	}
	for (i = 0; i < D1_DMAX - 1; i++)
	{
		ys = 0;
		for (j = 0; j < 37; j++)
		{
			if (D1DunGet(i, j) == 1 && D1DunGet(i + 1, j) == 0)
			{
				if (ys == 0)
					yc = j;
				ys++;
			}
			else
			{
				if (ys > 3 && D1Rnd(2) != 0)
				{
					for (k = yc; k < j; k++)
						D1DunSet(i + 1, k, D1Rnd(2));
				}
				ys = 0;
			}
		}
	}
}

U0 D3Edges()
{
	I64 i;

	for (i = 0; i < D1_DMAX; i++)
	{
		D1DunSet(D1_DMAX - 1, i, 0);
		D1DunSet(i, D1_DMAX - 1, 0);
	}
}

I64 D3GetFloorArea()
{
	I64 i;
	I64 gfa = 0;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
		gfa += d1_dun[i];
	return gfa;
}

U0 D3LockRec(I64 x, I64 y)
{
	if (x < 0 || x >= D1_DMAX || y < 0 || y >= D1_DMAX)
		return;
	if (!d3_lock[x * D1_DMAX + y])
		return;

	d3_lock[x * D1_DMAX + y] = FALSE;
	d3_lockcnt++;
	D3LockRec(x, y - 1);
	D3LockRec(x, y + 1);
	D3LockRec(x - 1, y);
	D3LockRec(x + 1, y);
}

Bool D3Lockout()
{
	I64 i;
	I64 j;
	I64 t = 0;
	I64 fx = 0;
	I64 fy = 0;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) != 0)
			{
				d3_lock[i * D1_DMAX + j] = TRUE;
				fx = i;
				fy = j;
				t++;
			}
			else
				d3_lock[i * D1_DMAX + j] = FALSE;
		}

	d3_lockcnt = 0;
	D3LockRec(fx, fy);

	return t == d3_lockcnt;
}

U0 D3MakeMegas()
{
	I64 i;
	I64 j;
	I64 v;

	for (j = 0; j < D1_DMAX - 1; j++)
	{
		for (i = 0; i < D1_DMAX - 1; i++)
		{
			v = D1DunGet(i + 1, j + 1) + 2 * D1DunGet(i, j + 1) +
				4 * D1DunGet(i + 1, j) + 8 * D1DunGet(i, j);
			if (v == 6)
			{
				if (D1Rnd(2) == 0)
					v = 12;
				else
					v = 5;
			}
			if (v == 9)
			{
				if (D1Rnd(2) == 0)
					v = 13;
				else
					v = 14;
			}
			D1DunSet(i, j, d3t_l3convtbl[v]);
		}
		D1DunSet(D1_DMAX - 1, j, 8);
	}
	for (i = 0; i < D1_DMAX; i++)
		D1DunSet(i, D1_DMAX - 1, 8);
}

U0 D3River()
{
	I64	 rx;
	I64	 ry;
	I64	 px;
	I64	 py;
	I64	 dir = 0;
	I64	 pdir = -1;
	I64	 nodir = 0;
	I64	 nodir2;
	I64	 dircheck;
	I64	 riv_x[100];
	I64	 riv_y[100];
	I64	 riv_t[100];
	I64	 rivercnt = 0;
	I64	 riveramt;
	I64	 i;
	I64	 trys = 0;
	I64	 found;
	I64	 bridge;
	I64	 lpcnt;
	Bool bail;

	while (trys < 200 && rivercnt < 4)
	{
		bail = FALSE;
		while (!bail && trys < 200)
		{
			trys++;
			rx = 0;
			ry = 0;
			i  = 0;
			while ((D1DunGet(rx, ry) < 25 || D1DunGet(rx, ry) > 28) && i < 100)
			{
				rx = D1Rnd(D1_DMAX);
				ry = D1Rnd(D1_DMAX);
				i++;
				while ((D1DunGet(rx, ry) < 25 || D1DunGet(rx, ry) > 28) &&
					ry < D1_DMAX)
				{
					rx++;
					if (rx >= D1_DMAX)
					{
						rx = 0;
						ry++;
					}
				}
			}
			if (i >= 100)
				return;
			if (ry >= D1_DMAX)
				return;
			switch (D1DunGet(rx, ry))
			{
				case 25:
					dir      = 3;
					nodir    = 2;
					riv_t[0] = 40;
					break;
				case 26:
					dir      = 0;
					nodir    = 1;
					riv_t[0] = 38;
					break;
				case 27:
					dir      = 1;
					nodir    = 0;
					riv_t[0] = 41;
					break;
				case 28:
					dir      = 2;
					nodir    = 3;
					riv_t[0] = 39;
					break;
			}
			riv_x[0] = rx;
			riv_y[0] = ry;
			riveramt = 1;
			nodir2   = 4;
			dircheck = 0;
			while (dircheck < 4 && riveramt < 100)
			{
				px = rx;
				py = ry;
				if (dircheck == 0)
					dir = D1Rnd(4);
				else
					dir = (dir + 1) & 3;
				dircheck++;
				while (dir == nodir || dir == nodir2)
				{
					dir = (dir + 1) & 3;
					dircheck++;
				}
				if (dir == 0 && ry > 0)
					ry--;
				if (dir == 1 && ry < D1_DMAX)
					ry++;
				if (dir == 2 && rx < D1_DMAX)
					rx++;
				if (dir == 3 && rx > 0)
					rx--;
				if (D1DunGet(rx, ry) == 7)
				{
					dircheck = 0;
					if (dir < 2)
						riv_t[riveramt] = D1Rnd(2) + 17;
					else
						riv_t[riveramt] = D1Rnd(2) + 15;
					riv_x[riveramt] = rx;
					riv_y[riveramt] = ry;
					riveramt++;
					if ((dir == 0 && pdir == 2) || (dir == 3 && pdir == 1))
					{
						if (riveramt > 2)
							riv_t[riveramt - 2] = 22;
						if (dir == 0)
							nodir2 = 1;
						else
							nodir2 = 2;
					}
					if ((dir == 0 && pdir == 3) || (dir == 2 && pdir == 1))
					{
						if (riveramt > 2)
							riv_t[riveramt - 2] = 21;
						if (dir == 0)
							nodir2 = 1;
						else
							nodir2 = 3;
					}
					if ((dir == 1 && pdir == 2) || (dir == 3 && pdir == 0))
					{
						if (riveramt > 2)
							riv_t[riveramt - 2] = 20;
						if (dir == 1)
							nodir2 = 0;
						else
							nodir2 = 2;
					}
					if ((dir == 1 && pdir == 3) || (dir == 2 && pdir == 0))
					{
						if (riveramt > 2)
							riv_t[riveramt - 2] = 19;
						if (dir == 1)
							nodir2 = 0;
						else
							nodir2 = 3;
					}
					pdir = dir;
				}
				else
				{
					rx = px;
					ry = py;
				}
			}
			if (dir == 0 && ry >= 2 && D1DunGet(rx, ry - 1) == 10 &&
				D1DunGet(rx, ry - 2) == 8)
			{
				riv_x[riveramt] = rx;
				riv_y[riveramt] = ry - 1;
				riv_t[riveramt] = 24;
				if (pdir == 2)
					riv_t[riveramt - 1] = 22;
				if (pdir == 3)
					riv_t[riveramt - 1] = 21;
				bail = TRUE;
			}
			if (dir == 1 && ry + 2 < D1_DMAX && D1DunGet(rx, ry + 1) == 2 &&
				D1DunGet(rx, ry + 2) == 8)
			{
				riv_x[riveramt] = rx;
				riv_y[riveramt] = ry + 1;
				riv_t[riveramt] = 42;
				if (pdir == 2)
					riv_t[riveramt - 1] = 20;
				if (pdir == 3)
					riv_t[riveramt - 1] = 19;
				bail = TRUE;
			}
			if (dir == 2 && rx + 2 < D1_DMAX && D1DunGet(rx + 1, ry) == 4 &&
				D1DunGet(rx + 2, ry) == 8)
			{
				riv_x[riveramt] = rx + 1;
				riv_y[riveramt] = ry;
				riv_t[riveramt] = 43;
				if (pdir == 0)
					riv_t[riveramt - 1] = 19;
				if (pdir == 1)
					riv_t[riveramt - 1] = 21;
				bail = TRUE;
			}
			if (dir == 3 && rx >= 2 && D1DunGet(rx - 1, ry) == 9 &&
				D1DunGet(rx - 2, ry) == 8)
			{
				riv_x[riveramt] = rx - 1;
				riv_y[riveramt] = ry;
				riv_t[riveramt] = 23;
				if (pdir == 0)
					riv_t[riveramt - 1] = 20;
				if (pdir == 1)
					riv_t[riveramt - 1] = 22;
				bail = TRUE;
			}
		}
		if (bail && riveramt < 7)
			bail = FALSE;
		if (bail)
		{
			found = 0;
			lpcnt = 0;
			while (found == 0 && lpcnt < 30)
			{
				lpcnt++;
				bridge = D1Rnd(riveramt);
				if ((riv_t[bridge] == 15 || riv_t[bridge] == 16) &&
					D1DunGet(riv_x[bridge], riv_y[bridge] - 1) == 7 &&
					D1DunGet(riv_x[bridge], riv_y[bridge] + 1) == 7)
					found = 1;
				if ((riv_t[bridge] == 17 || riv_t[bridge] == 18) &&
					D1DunGet(riv_x[bridge] - 1, riv_y[bridge]) == 7 &&
					D1DunGet(riv_x[bridge] + 1, riv_y[bridge]) == 7)
					found = 2;
				for (i = 0; i < riveramt && found != 0; i++)
				{
					if (found == 1 &&
						(riv_y[bridge] - 1 == riv_y[i] ||
						 riv_y[bridge] + 1 == riv_y[i]) &&
						riv_x[bridge] == riv_x[i])
						found = 0;
					if (found == 2 &&
						(riv_x[bridge] - 1 == riv_x[i] ||
						 riv_x[bridge] + 1 == riv_x[i]) &&
						riv_y[bridge] == riv_y[i])
						found = 0;
				}
			}
			if (found != 0)
			{
				if (found == 1)
					riv_t[bridge] = 44;
				else
					riv_t[bridge] = 45;
				rivercnt++;
				for (bridge = 0; bridge <= riveramt; bridge++)
					D1DunSet(riv_x[bridge], riv_y[bridge], riv_t[bridge]);
			}
			else
				bail = FALSE;
		}
	}
}

//mutual recursion: Spawn is declared extern, never as a bare prototype -
//a bare `Bool F(...);` compiles as an empty stub in ZealC
extern Bool D3Spawn(I64 x, I64 y, I64 *totarea);

Bool D3SpawnEdge(I64 x, I64 y, I64 *totarea)
{
	I64 i;

	if (*totarea > 40)
		return TRUE;
	if (x < 0 || y < 0 || x >= D1_DMAX || y >= D1_DMAX)
		return TRUE;
	if (D1DunGet(x, y) & 0x80)
		return FALSE;
	if (D1DunGet(x, y) > 15)
		return TRUE;

	i = D1DunGet(x, y);
	D1DunSet(x, y, i | 0x80);
	*totarea = *totarea + 1;

	if (d3_spawn_edge_tbl[i] & 8)
	{
		if (D3SpawnEdge(x, y - 1, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 4)
	{
		if (D3SpawnEdge(x, y + 1, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 2)
	{
		if (D3SpawnEdge(x + 1, y, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 1)
	{
		if (D3SpawnEdge(x - 1, y, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 0x80)
	{
		if (D3Spawn(x, y - 1, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 0x40)
	{
		if (D3Spawn(x, y + 1, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 0x20)
	{
		if (D3Spawn(x + 1, y, totarea))
			return TRUE;
	}
	if (d3_spawn_edge_tbl[i] & 0x10)
	{
		if (D3Spawn(x - 1, y, totarea))
			return TRUE;
	}

	return FALSE;
}

Bool D3Spawn(I64 x, I64 y, I64 *totarea)
{
	I64 i;

	if (*totarea > 40)
		return TRUE;
	if (x < 0 || y < 0 || x >= D1_DMAX || y >= D1_DMAX)
		return TRUE;
	if (D1DunGet(x, y) & 0x80)
		return FALSE;
	if (D1DunGet(x, y) > 15)
		return TRUE;

	i = D1DunGet(x, y);
	D1DunSet(x, y, i | 0x80);
	*totarea = *totarea + 1;

	if (i != 8)
	{
		if (d3_spawn_tbl[i] & 8)
		{
			if (D3SpawnEdge(x, y - 1, totarea))
				return TRUE;
		}
		if (d3_spawn_tbl[i] & 4)
		{
			if (D3SpawnEdge(x, y + 1, totarea))
				return TRUE;
		}
		if (d3_spawn_tbl[i] & 2)
		{
			if (D3SpawnEdge(x + 1, y, totarea))
				return TRUE;
		}
		if (d3_spawn_tbl[i] & 1)
		{
			if (D3SpawnEdge(x - 1, y, totarea))
				return TRUE;
		}
	}
	else
	{
		if (D3Spawn(x + 1, y, totarea))
			return TRUE;
		if (D3Spawn(x - 1, y, totarea))
			return TRUE;
		if (D3Spawn(x, y + 1, totarea))
			return TRUE;
		if (D3Spawn(x, y - 1, totarea))
			return TRUE;
	}

	return FALSE;
}

U0 D3Pool()
{
	I64	 i;
	I64	 j;
	I64	 dunx;
	I64	 duny;
	I64	 totarea;
	I64	 poolchance;
	I64	 k;
	Bool found;

	for (duny = 0; duny < D1_DMAX; duny++)
		for (dunx = 0; dunx < D1_DMAX; dunx++)
		{
			if (D1DunGet(dunx, duny) == 8)
			{
				D1DunSet(dunx, duny, 8 | 0x80);
				totarea = 1;
				if (dunx + 1 < D1_DMAX)
					found = D3Spawn(dunx + 1, duny, &totarea);
				else
					found = TRUE;
				if (dunx - 1 > 0 && !found)
					found = D3Spawn(dunx - 1, duny, &totarea);
				else
					found = TRUE;
				if (duny + 1 < D1_DMAX && !found)
					found = D3Spawn(dunx, duny + 1, &totarea);
				else
					found = TRUE;
				if (duny - 1 > 0 && !found)
					found = D3Spawn(dunx, duny - 1, &totarea);
				else
					found = TRUE;
				poolchance = D1Rnd(100);
				for (j = duny - totarea; j < duny + totarea; j++)
					for (i = dunx - totarea; i < dunx + totarea; i++)
					{
						if (i >= 0 && i < D1_DMAX && j >= 0 && j < D1_DMAX &&
							D1DunGet(i, j) & 0x80)
						{
							D1DunSet(i, j, D1DunGet(i, j) & 0x7F);
							if (totarea > 4 && poolchance < 25 && !found)
							{
								k = d3_poolsub[D1DunGet(i, j)];
								if (k != 0 && k <= 37)
									D1DunSet(i, j, k);
								d3_lavapool = TRUE;
							}
						}
					}
			}
		}
}

U0 D3PoolFix()
{
	I64 dunx;
	I64 duny;

	for (duny = 1; duny < D1_DMAX - 1; duny++)
		for (dunx = 1; dunx < D1_DMAX - 1; dunx++)
		{
			if (D1DunGet(dunx, duny) == 8)
			{
				if (D1DunGet(dunx - 1, duny - 1) >= 25 && D1DunGet(dunx - 1, duny - 1) <= 41 &&
					D1DunGet(dunx - 1, duny) >= 25 && D1DunGet(dunx - 1, duny) <= 41 &&
					D1DunGet(dunx - 1, duny + 1) >= 25 && D1DunGet(dunx - 1, duny + 1) <= 41 &&
					D1DunGet(dunx, duny - 1) >= 25 && D1DunGet(dunx, duny - 1) <= 41 &&
					D1DunGet(dunx, duny + 1) >= 25 && D1DunGet(dunx, duny + 1) <= 41 &&
					D1DunGet(dunx + 1, duny - 1) >= 25 && D1DunGet(dunx + 1, duny - 1) <= 41 &&
					D1DunGet(dunx + 1, duny) >= 25 && D1DunGet(dunx + 1, duny) <= 41 &&
					D1DunGet(dunx + 1, duny + 1) >= 25 && D1DunGet(dunx + 1, duny + 1) <= 41)
					D1DunSet(dunx, duny, 33);
			}
		}
}

Bool D3PlaceMiniSet(U8 *miniset, I64 tmin, I64 tmax, I64 cx, I64 cy,
	Bool setview)
{//TRUE = FAILED to place, as upstream has it
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 i;
	I64	 ii;
	I64	 numt;
	I64	 trys;
	Bool found;

	if (tmax - tmin == 0)
		numt = 1;
	else
		numt = D1Rnd(tmax - tmin) + tmin;

	sx = 0;
	sy = 0;
	for (i = 0; i < numt; i++)
	{
		sx    = D1Rnd(D1_DMAX - sw);
		sy    = D1Rnd(D1_DMAX - sh);
		found = FALSE;
		trys  = 0;
		while (!found && trys < 200)
		{
			trys++;
			found = TRUE;
			if (cx != -1 && sx >= cx - sw && sx <= cx + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			if (cy != -1 && sy >= cy - sh && sy <= cy + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			ii = 2;
			for (yy = 0; yy < sh && found; yy++)
				for (xx = 0; xx < sw && found; xx++)
				{
					if (miniset[ii] != 0 &&
						D1DunGet(xx + sx, yy + sy) != miniset[ii])
						found = FALSE;
					if (D1DunFlag(xx + sx, yy + sy))
						found = FALSE;
					ii++;
				}
			if (!found)
			{
				sx++;
				if (sx == D1_DMAX - sw)
				{
					sx = 0;
					sy++;
					if (sy == D1_DMAX - sh)
						sy = 0;
				}
			}
		}
		if (trys >= 200)
			return TRUE;
		ii = sw * sh + 2;
		for (yy = 0; yy < sh; yy++)
			for (xx = 0; xx < sw; xx++)
			{
				if (miniset[ii] != 0)
					D1DunSet(xx + sx, yy + sy, miniset[ii]);
				ii++;
			}
	}

	if (setview)
	{
		d1_lvl_vx = 2 * sx + 17;
		d1_lvl_vy = 2 * sy + 19;
	}

	return FALSE;
}

U0 D3PlaceRndSet(U8 *miniset, I64 rndper)
{
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 ii;
	I64	 kk;
	Bool found;

	for (sy = 0; sy < D1_DMAX - sh; sy++)
		for (sx = 0; sx < D1_DMAX - sw; sx++)
		{
			found = TRUE;
			ii    = 2;
			for (yy = 0; yy < sh && found; yy++)
				for (xx = 0; xx < sw && found; xx++)
				{
					if (miniset[ii] != 0 &&
						D1DunGet(xx + sx, yy + sy) != miniset[ii])
						found = FALSE;
					if (D1DunFlag(xx + sx, yy + sy))
						found = FALSE;
					ii++;
				}
			kk = sw * sh + 2;
			if (miniset[kk] >= 84 && miniset[kk] <= 100 && found)
			{
				if (D1DunGet(sx - 1, sy) >= 84 && D1DunGet(sx - 1, sy) <= 100)
					found = FALSE;
				if (D1DunGet(sx + 1, sy) >= 84 && D1DunGet(sx - 1, sy) <= 100)
					found = FALSE;
				if (D1DunGet(sx, sy + 1) >= 84 && D1DunGet(sx - 1, sy) <= 100)
					found = FALSE;
				if (D1DunGet(sx, sy - 1) >= 84 && D1DunGet(sx - 1, sy) <= 100)
					found = FALSE;
			}
			if (found && D1Rnd(100) < rndper)
			{
				for (yy = 0; yy < sh; yy++)
					for (xx = 0; xx < sw; xx++)
					{
						if (miniset[kk] != 0)
							D1DunSet(xx + sx, yy + sy, miniset[kk]);
						kk++;
					}
			}
		}
}

U0 D3FixWarp()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 125 && D1DunGet(i + 1, j) == 125 &&
				D1DunGet(i, j + 1) == 125 && D1DunGet(i + 1, j + 1) == 125)
			{
				D1DunSet(i, j, 156);
				D1DunSet(i + 1, j, 155);
				D1DunSet(i, j + 1, 153);
				D1DunSet(i + 1, j + 1, 154);
				return;
			}
			if (D1DunGet(i, j) == 5 && D1DunGet(i + 1, j + 1) == 7)
				D1DunSet(i, j, 7);
		}
}

U0 D3FixHallOfHeroes()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 5 && D1DunGet(i + 1, j + 1) == 7)
				D1DunSet(i, j, 7);
		}
	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 5 && D1DunGet(i + 1, j + 1) == 12 &&
				D1DunGet(i + 1, j) == 7)
			{
				D1DunSet(i, j, 7);
				D1DunSet(i, j + 1, 7);
				D1DunSet(i + 1, j + 1, 7);
			}
			if (D1DunGet(i, j) == 5 && D1DunGet(i + 1, j + 1) == 12 &&
				D1DunGet(i, j + 1) == 7)
			{
				D1DunSet(i, j, 7);
				D1DunSet(i + 1, j, 7);
				D1DunSet(i + 1, j + 1, 7);
			}
		}
}

U0 D3DrlgL3(I64 entry)
{
	I64	 x1;
	I64	 y1;
	I64	 x2;
	I64	 y2;
	Bool found;
	Bool genok;

	d3_lavapool = FALSE;

	do
	{
		do
		{
			do
			{
				D3InitDungeon;
				x1 = D1Rnd(20) + 10;
				y1 = D1Rnd(20) + 10;
				x2 = x1 + 2;
				y2 = y1 + 2;
				D3FillRoom(x1, y1, x2, y2);
				D3CreateBlock(x1, y1, 2, 0);
				D3CreateBlock(x2, y1, 2, 1);
				D3CreateBlock(x1, y2, 2, 2);
				D3CreateBlock(x1, y1, 2, 3);
				D3FillDiags;
				D3FillSingles;
				D3FillStraights;
				D3FillDiags;
				D3Edges;
				if (D3GetFloorArea() >= 600)
					found = D3Lockout();
				else
					found = FALSE;
			}
			while (!found);
			D3MakeMegas;
			if (entry == 0)
			{
				genok = D3PlaceMiniSet(d3t_l3up, 1, 1, -1, -1, TRUE);
				if (!genok)
					genok = D3PlaceMiniSet(d3t_l3down, 1, 1, -1, -1, FALSE);
			}
			else
			{
				genok = D3PlaceMiniSet(d3t_l3up, 1, 1, -1, -1, FALSE);
				if (!genok)
				{
					genok = D3PlaceMiniSet(d3t_l3down, 1, 1, -1, -1, TRUE);
					d1_lvl_vx += 2;
					d1_lvl_vy -= 2;
				}
			}
		}
		while (genok);
		D3Pool;
	}
	while (!d3_lavapool);

	D3PoolFix;
	D3FixWarp;

	D3PlaceRndSet(d3t_l3isle1, 70);
	D3PlaceRndSet(d3t_l3isle2, 70);
	D3PlaceRndSet(d3t_l3isle3, 30);
	D3PlaceRndSet(d3t_l3isle4, 30);
	D3PlaceRndSet(d3t_l3isle1, 100);
	D3PlaceRndSet(d3t_l3isle2, 100);
	D3PlaceRndSet(d3t_l3isle5, 90);

	D3FixHallOfHeroes;
	D3River;

	D3PlaceRndSet(d3t_l3tite1, 10);
	D3PlaceRndSet(d3t_l3tite2, 10);
	D3PlaceRndSet(d3t_l3tite3, 10);
	D3PlaceRndSet(d3t_l3tite6, 20);
	D3PlaceRndSet(d3t_l3tite7, 20);
	D3PlaceRndSet(d3t_l3tite8, 20);
	D3PlaceRndSet(d3t_l3tite9, 20);
	D3PlaceRndSet(d3t_l3tite10, 20);
	D3PlaceRndSet(d3t_l3tite11, 30);
	D3PlaceRndSet(d3t_l3tite12, 20);
	D3PlaceRndSet(d3t_l3tite13, 20);
	D3PlaceRndSet(d3t_l3crev1, 30);
	D3PlaceRndSet(d3t_l3crev2, 30);
	D3PlaceRndSet(d3t_l3crev3, 30);
	D3PlaceRndSet(d3t_l3crev4, 30);
	D3PlaceRndSet(d3t_l3crev5, 30);
	D3PlaceRndSet(d3t_l3crev6, 30);
	D3PlaceRndSet(d3t_l3crev7, 30);
	D3PlaceRndSet(d3t_l3crev8, 30);
	D3PlaceRndSet(d3t_l3crev9, 30);
	D3PlaceRndSet(d3t_l3crev10, 30);
	D3PlaceRndSet(d3t_l3crev11, 30);
	D3PlaceRndSet(d3t_l3xtra1, 25);
	D3PlaceRndSet(d3t_l3xtra2, 25);
	D3PlaceRndSet(d3t_l3xtra3, 25);
	D3PlaceRndSet(d3t_l3xtra4, 25);
	D3PlaceRndSet(d3t_l3xtra5, 25);
}

U0 D3Pass3()
{//base tile 8
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 lv;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	lv = 8 - 1;
	v1 = D1RdU16(d1_til + lv * 8)     + 1;
	v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
	v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
	v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;

	for (j = 0; j < D1_MAXDUN; j += 2)
		for (i = 0; i < D1_MAXDUN; i += 2)
		{
			d1_dpiece[i     +  j      * D1_MAXDUN] = v1;
			d1_dpiece[i + 1 +  j      * D1_MAXDUN] = v2;
			d1_dpiece[i     + (j + 1) * D1_MAXDUN] = v3;
			d1_dpiece[i + 1 + (j + 1) * D1_MAXDUN] = v4;
		}

	yy = 16;
	for (j = 0; j < D1_DMAX; j++)
	{
		xx = 16;
		for (i = 0; i < D1_DMAX; i++)
		{
			lv = D1DunGet(i, j) - 1;
			if (lv >= 0)
			{
				v1 = D1RdU16(d1_til + lv * 8)     + 1;
				v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
				v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
				v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;
			}
			else
			{
				v1 = 0;
				v2 = 0;
				v3 = 0;
				v4 = 0;
			}
			d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
			d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
			d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
			d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			xx += 2;
		}
		yy += 2;
	}
}

Bool D1L3LevelLoad(I64 level, I64 seed, I64 entry)
{//caves level 9-12
	U8 pal[32];

	if (!D1LvlLoadGfx("Levels\\L3Data\\L3.CEL",
					  "Levels\\L3Data\\L3.MIN",
					  "Levels\\L3Data\\L3.SOL",
					  "Levels\\L3Data\\L3.TIL", 10))
		return FALSE;

	D1SetRndSeed(seed);
	D3DrlgL3(entry);
	D3Pass3;
	D1TrigScanPieces(171, 168);
	D1GridsClear;
	//caves reuse the cathedral special sheet; piece IDs differ so only
	//door frames (set on operate) paint until a caves fill exists
	if (!D1SpecialLoad("Levels\\L1Data\\L1S.CEL"))
		return FALSE;

	StrPrint(pal, "Levels\\L3Data\\L3_%d.pal", D1Rnd(4) + 1);
	if (!D1PalLoad(pal))
		return FALSE;

	d1_currlevel = level;
	d1_lvl_ready = TRUE;
	return TRUE;
}
