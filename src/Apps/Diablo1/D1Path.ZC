// A* pathfinding (path.cpp FindPath)
//
// 300 nodes (MAXPATHNODES), 24-step result cap (MAX_PATH_LENGTH 25).
// Step cost 2 straight / 3 diagonal (path_check_equal); h = 2 * (min + max)
// (path_get_h_cost, non-1.08 branch) overestimates on diagonals as upstream,
// so a returned path is not always step-minimal.
// The target cell is admitted even when occupied (FindPath's "!PosOk &&
// target" case). adjacent_ok stops within 1 of the target; upstream's goal is
// the exact target.

#define D1_PATH_NODES	300
#define D1_ASTAR_LEN	25

class CD1PNode
{
	I64 g;
	I64 h;
	I64 f;
	I64 x;
	I64 y;
	I64 parent;			//node index, -1 none
	I64 next;			//frontier/visited link, -1 end
	I64 child[8];
	I64 nchild;
};

CD1PNode d1_pn[D1_PATH_NODES];
I64 d1_pn_cnt   = 0;
I64 d1_pfront   = -1;
I64 d1_pvis     = -1;
I64 d1_pstack[D1_PATH_NODES];
I64 d1_pstack_n = 0;

//expansion order, upstream pathxdir/pathydir
I64 d1_astar_dx[8] = {-1, -1,  1,  1, -1,  0,  1,  0};
I64 d1_astar_dy[8] = {-1,  1, -1,  1,  0, -1,  0,  1};

//step delta -> d1_dir code, indexed [(dy+1)*3 + dx+1]; center unused
I64 d1_astar_dir[9] = {4, 5, 6, 3, 0, 7, 2, 1, 0};

I64 D1PathHCost(I64 sx, I64 sy, I64 dx, I64 dy)
{//path_get_h_cost
	I64 ax = sx - dx;
	I64 ay = sy - dy;

	if (ax < 0)
		ax = -ax;
	if (ay < 0)
		ay = -ay;
	return 2 * (ax + ay);
}

I64 D1PathCheckEqual(I64 px, I64 py, I64 nx, I64 ny)
{//path_check_equal
	if (px == nx || py == ny)
		return 2;
	return 3;
}

Bool D1PathCorner(I64 px, I64 py, I64 nx, I64 ny)
{//path_solid_pieces
	if (px != nx && py != ny)
	{
		if (!D1Walkable(nx, py))
			return FALSE;
		if (!D1Walkable(px, ny))
			return FALSE;
	}
	return TRUE;
}

I64 D1PathNewStep()
{//path_new_step
	I64 ni;
	I64 k;

	if (d1_pn_cnt == D1_PATH_NODES)
		return -1;
	ni = d1_pn_cnt;
	d1_pn_cnt++;
	d1_pn[ni].g = 0;
	d1_pn[ni].h = 0;
	d1_pn[ni].f = 0;
	d1_pn[ni].x = 0;
	d1_pn[ni].y = 0;
	d1_pn[ni].parent = -1;
	d1_pn[ni].next   = -1;
	d1_pn[ni].nchild = 0;
	for (k = 0; k < 8; k++)
		d1_pn[ni].child[k] = -1;
	return ni;
}

I64 D1PathGetNode1(I64 dx, I64 dy)
{//frontier lookup
	I64 ni = d1_pn[d1_pfront].next;

	while (ni >= 0)
	{
		if (d1_pn[ni].x == dx && d1_pn[ni].y == dy)
			return ni;
		ni = d1_pn[ni].next;
	}
	return -1;
}

I64 D1PathGetNode2(I64 dx, I64 dy)
{//visited lookup
	I64 ni = d1_pn[d1_pvis].next;

	while (ni >= 0)
	{
		if (d1_pn[ni].x == dx && d1_pn[ni].y == dy)
			return ni;
		ni = d1_pn[ni].next;
	}
	return -1;
}

U0 D1PathNextNode(I64 ni)
{//path_next_node
	I64 cur;
	I64 nx;
	I64 f;

	if (d1_pn[d1_pfront].next < 0)
		d1_pn[d1_pfront].next = ni;
	else
	{
		cur = d1_pfront;
		nx  = d1_pn[d1_pfront].next;
		f   = d1_pn[ni].f;
		while (nx >= 0 && d1_pn[nx].f < f)
		{
			cur = nx;
			nx  = d1_pn[nx].next;
		}
		d1_pn[ni].next  = nx;
		d1_pn[cur].next = ni;
	}
}

U0 D1PathPushStep(I64 ni)
{
	if (d1_pstack_n < D1_PATH_NODES)
	{
		d1_pstack[d1_pstack_n] = ni;
		d1_pstack_n++;
	}
}

I64 D1PathPopStep()
{
	d1_pstack_n--;
	return d1_pstack[d1_pstack_n];
}

U0 D1PathChildAdd(I64 pnix, I64 ci)
{
	if (d1_pn[pnix].nchild < 8)
	{
		d1_pn[pnix].child[d1_pn[pnix].nchild] = ci;
		d1_pn[pnix].nchild++;
	}
}

U0 D1PathSetCoords(I64 ni)
{//path_set_coords
	I64 oi;
	I64 ci;
	I64 k;
	I64 ng;

	D1PathPushStep(ni);
	while (d1_pstack_n > 0)
	{
		oi = D1PathPopStep();
		for (k = 0; k < d1_pn[oi].nchild; k++)
		{
			ci = d1_pn[oi].child[k];
			ng = d1_pn[oi].g +
				D1PathCheckEqual(d1_pn[oi].x, d1_pn[oi].y, d1_pn[ci].x, d1_pn[ci].y);
			if (ng < d1_pn[ci].g)
			{
				if (D1PathCorner(d1_pn[oi].x, d1_pn[oi].y, d1_pn[ci].x, d1_pn[ci].y))
				{
					d1_pn[ci].parent = oi;
					d1_pn[ci].g = ng;
					d1_pn[ci].f = ng + d1_pn[ci].h;
					D1PathPushStep(ci);
				}
			}
		}
	}
}

Bool D1PathParentPath(I64 pnix, I64 dx, I64 dy, I64 tx, I64 ty)
{//path_parent_path
	I64 ng;
	I64 ni;

	ng = d1_pn[pnix].g + D1PathCheckEqual(d1_pn[pnix].x, d1_pn[pnix].y, dx, dy);

	ni = D1PathGetNode1(dx, dy);
	if (ni >= 0)
	{
		D1PathChildAdd(pnix, ni);
		if (ng < d1_pn[ni].g)
		{
			if (D1PathCorner(d1_pn[pnix].x, d1_pn[pnix].y, dx, dy))
			{
				d1_pn[ni].parent = pnix;
				d1_pn[ni].g = ng;
				d1_pn[ni].f = ng + d1_pn[ni].h;
			}
		}
		return TRUE;
	}

	ni = D1PathGetNode2(dx, dy);
	if (ni >= 0)
	{
		D1PathChildAdd(pnix, ni);
		if (ng < d1_pn[ni].g &&
			D1PathCorner(d1_pn[pnix].x, d1_pn[pnix].y, dx, dy))
		{
			d1_pn[ni].parent = pnix;
			d1_pn[ni].g = ng;
			d1_pn[ni].f = ng + d1_pn[ni].h;
			D1PathSetCoords(ni);
		}
		return TRUE;
	}

	ni = D1PathNewStep();
	if (ni < 0)
		return FALSE;
	d1_pn[ni].parent = pnix;
	d1_pn[ni].g = ng;
	d1_pn[ni].h = D1PathHCost(dx, dy, tx, ty);
	d1_pn[ni].f = ng + d1_pn[ni].h;
	d1_pn[ni].x = dx;
	d1_pn[ni].y = dy;
	D1PathNextNode(ni);
	D1PathChildAdd(pnix, ni);
	return TRUE;
}

Bool D1PathGetPath(I64 pnix, I64 tx, I64 ty)
{//path_get_path
	I64	 k;
	I64	 dx;
	I64	 dy;
	Bool ok;

	for (k = 0; k < 8; k++)
	{
		dx = d1_pn[pnix].x + d1_astar_dx[k];
		dy = d1_pn[pnix].y + d1_astar_dy[k];
		ok = D1WalkableM(dx, dy) && !D1ObjBlocks(dx, dy);
		if ((ok && D1PathCorner(d1_pn[pnix].x, d1_pn[pnix].y, dx, dy)) ||
			(!ok && dx == tx && dy == ty))
		{
			if (!D1PathParentPath(pnix, dx, dy, tx, ty))
				return FALSE;
		}
	}
	return TRUE;
}

I64 D1PathGetNext()
{//GetNextPath
	I64 r = d1_pn[d1_pfront].next;

	if (r < 0)
		return -1;
	d1_pn[d1_pfront].next = d1_pn[r].next;
	d1_pn[r].next = d1_pn[d1_pvis].next;
	d1_pn[d1_pvis].next = r;
	return r;
}

I64 D1AStar(I64 sx, I64 sy, I64 tx, I64 ty, Bool adjacent_ok, I64 *out_dirs,
	I64 max_steps)
{//FindPath
	I64 steps[D1_ASTAR_LEN];
	I64 cur;
	I64 cx;
	I64 cy;
	I64 dx;
	I64 dy;
	I64 n;
	I64 p;
	I64 len;
	I64 i;
	I64 cap;
	Bool hit;

	cap = max_steps;
	if (cap > D1_ASTAR_LEN - 1)
		cap = D1_ASTAR_LEN - 1;

	if (tx == sx && ty == sy)
		return 0;
	if (!adjacent_ok && !D1Walkable(tx, ty))
		return 0;

	d1_pn_cnt   = 0;
	d1_pstack_n = 0;
	d1_pfront   = D1PathNewStep();
	d1_pvis     = D1PathNewStep();
	cur         = D1PathNewStep();
	d1_pn[cur].x = sx;
	d1_pn[cur].y = sy;
	d1_pn[cur].g = 0;
	d1_pn[cur].h = D1PathHCost(sx, sy, tx, ty);
	d1_pn[cur].f = d1_pn[cur].h;
	d1_pn[d1_pfront].next = cur;

	cur = D1PathGetNext();
	while (cur >= 0)
	{
		cx = d1_pn[cur].x;
		cy = d1_pn[cur].y;

		hit = FALSE;
		if (cx == tx && cy == ty)
			hit = TRUE;
		if (!hit && adjacent_ok)
		{
			dx = tx - cx;
			dy = ty - cy;
			if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
				hit = TRUE;
		}

		if (hit)
		{
			n   = cur;
			len = 0;
			while (d1_pn[n].parent >= 0 && len < D1_ASTAR_LEN)
			{
				p = d1_pn[n].parent;
				steps[len] = d1_astar_dir[(d1_pn[n].y - d1_pn[p].y + 1) * 3 +
					d1_pn[n].x - d1_pn[p].x + 1];
				len++;
				n = p;
			}
			if (d1_pn[n].parent >= 0)
				return 0;
			if (len > cap)
				return 0;
			for (i = 0; i < len; i++)
				out_dirs[i] = steps[len - 1 - i];
			return len;
		}

		if (!D1PathGetPath(cur, tx, ty))
			return 0;
		cur = D1PathGetNext();
	}
	return 0;
}
