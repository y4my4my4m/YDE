// D1Panel.ZC - bottom control panel and the life/mana orbs
//
// CtrlPan\Panel8.CEL: one unclipped 640x128 frame at y 352-479.
// CtrlPan\P8Bulbs.CEL: two 88-wide bulb frames, red then blue.
// orb fill draws the bulb's bottom rows only: rows are stored bottom-up,
// so cutting the decode at fill*height rows leaves the top empty
// (control.cpp DrawFlask, reduced).
//
// belt and spell button are panel art only; no function behind them yet.
//
// every coordinate here is panel-local. the panel is drawn at D1UiOrgX()
// and D1PanelClick subtracts the same origin before its rect tests.

#define D1_PANEL_Y		352
#define D1_BULB_W		88

U8	*d1_panel_cel = NULL;
U8	*d1_bulbs_cel = NULL;
U8	 d1_panel_txt[48];

//pre-decoded 88x88 bulbs, top-down, with opacity masks
U8	 d1_bulb_px[2][88 * 88];
U8	 d1_bulb_mk[2][88 * 88];
Bool d1_bulbs_dec = FALSE;

Bool D1PanelInit()
{
	I64 size = 0;

	if (!d1_panel_cel)
		d1_panel_cel = D1MpqRead("CtrlPan\\Panel8.CEL", &size);
	if (!d1_bulbs_cel)
		d1_bulbs_cel = D1MpqRead("CtrlPan\\P8Bulbs.CEL", &size);
	if (d1_bulbs_cel && !d1_bulbs_dec)
	{
		D1CelDecodeFrame(d1_bulbs_cel, 1, 88, 88, d1_bulb_px[0], d1_bulb_mk[0]);
		D1CelDecodeFrame(d1_bulbs_cel, 2, 88, 88, d1_bulb_px[1], d1_bulb_mk[1]);
		d1_bulbs_dec = TRUE;
	}

	return d1_panel_cel != NULL;
}

U0 D1OrbDraw(I64 which, I64 sx, I64 cur, I64 max)
{//panel8 carries the FULL liquid orbs; P8Bulbs frames are the EMPTY
 //crystal overlays. draining paints the overlay's top rows over the
 //liquid, top-down to the fill line (control.cpp flask compositing).
 //bulb top row lands at PANEL_TOP - 13.
	I64 cutoff;
	I64 x;
	I64 y;
	I64 top = D1_PANEL_Y - 13;

	if (max <= 0 || !d1_bulbs_dec)
		return;
	cutoff = 88 - (88 * cur) / max;
	if (cutoff < 0)
		cutoff = 0;
	if (cutoff > 88)
		cutoff = 88;

	for (y = 0; y < cutoff; y++)
		for (x = 0; x < 88; x++)
		{
			if (d1_bulb_mk[which][y * 88 + x])
				D1Pix(sx + x, top + y, d1_bulb_px[which][y * 88 + x]);
		}
}

U0 D1CelDrawBottomRows(I64 sx, I64 sy, U8 *buf, I64 frame, I64 w, I64 rows)
{//unclipped frame, only the lowest `rows` scanlines plot
	I64	 dsize = 0;
	U8	*data  = D1CelFrame(buf, frame, &dsize);
	I64	 i = 0;
	I64	 x = 0;
	I64	 r = 0;
	I64	 b;
	I64	 n;

	while (i < dsize && r < rows)
	{
		b = data[i];
		i++;
		if (b < 0x80)
		{
			for (n = 0; n < b; n++)
			{
				D1Pix(sx + x, sy - r, data[i]);
				i++;
				x++;
			}
		}
		else
			x += 0x100 - b;

		if (x >= w)
		{
			x = 0;
			r++;
		}
	}
}

I64 D1PanelClick(I64 cx, I64 cy)
{//control.cpp PanBtnPos rects. returns: 0 none, 1 menu, 2 inv, 3 spells,
 //4 char, 5 quests, 6 map, 10+n belt slot n
	I64 i;

	if (cy < D1_PANEL_Y)
		return 0;

	//panel-local x; the art sits in the centered 640 band
	cx -= D1UiOrgX();

	if (cx >= 9 && cx < 80)
	{
		if (cy >= 361 && cy < 380)
			return 4;
		if (cy >= 387 && cy < 406)
			return 5;
		if (cy >= 427 && cy < 446)
			return 6;
		if (cy >= 453 && cy < 472)
			return 1;
	}
	if (cx >= 560 && cx < 631)
	{
		if (cy >= 361 && cy < 380)
			return 2;
		if (cy >= 387 && cy < 406)
			return 3;
	}
	if (cy >= 357 && cy < 388)
	{
		for (i = 0; i < 8; i++)
		{
			if (cx >= 205 + i * 29 && cx < 233 + i * 29)
				return 10 + i;
		}
	}
	return 0;
}

U0 D1PanelDraw()
{
	I64 fill;
	I64 i;
	I64 ox = D1UiOrgX();

	if (!d1_panel_cel)
		return;

	D1CelDraw(ox, D1_H - 1, d1_panel_cel, 1, D1_UI_W);

	D1OrbDraw(0, ox + 96, d1_plr_hp, d1_plr_maxhp);
	D1OrbDraw(1, ox + 464, d1_plr_mana, d1_plr_maxmana);

	//belt: color chips keyed off the potion kind
	for (fill = 0; fill < 8; fill++)
	{
		if (d1_belt[fill])
		{
			i = d1_itmdefs[d1_belt[fill]].misc;
			if (i == D1IM_HEAL || i == D1IM_FULLHEAL)
				D1FillRect(ox + 207 + fill * 29, 388, 12, 12, 229);
			if (i == D1IM_MANA || i == D1IM_FULLMANA)
				D1FillRect(ox + 207 + fill * 29, 388, 12, 12, 170);
			if (i == D1IM_REJUV || i == D1IM_FULLREJUV)
				D1FillRect(ox + 207 + fill * 29, 388, 12, 12, 200);
		}
	}

	//gold and character standing, in the info line
	StrPrint(d1_panel_txt, "Gold %d   Level %d", d1_plr_gold, d1_plr_lvl);
	D1TextDrawSolid(ox + D1_UI_W / 2 - D1TextWidth(d1_panel_txt) / 2, 440,
		d1_panel_txt, D1PalBrightest());
}
