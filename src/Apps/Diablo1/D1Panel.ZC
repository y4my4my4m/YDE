// D1Panel.ZC - bottom control panel and the life/mana orbs
//
// CtrlPan\Panel8.CEL: one unclipped 640x128 frame at y 352-479.
 //Panel8 life/mana sockets already hold the FULL liquid orbs.
// CtrlPan\P8Bulbs.CEL: two 88-wide EMPTY crystal overlays (red then blue).
 //drain: paint the overlay's top rows over the liquid down to the fill
 //line (control.cpp DrawLifeFlask / DrawManaFlask, reduced). bulb top
 //row lands at PANEL_TOP - 13.
//
// CtrlPan\SpelIcon.CEL: 56x56 spell icons, frame index per spell from
// control.cpp SpellITbl. DrawSpell puts the selected one at PANEL_X + 565,
// PANEL_Y + 119, bottom-left anchored.
//
// belt slots draw the item Objcurs frame at the inv.cpp InvRect spots.
//
// every coordinate here is panel-local, x from D1UiOrgX() and y from
// D1PanelTop() (control_panel.cpp CalculatePanelAreas: bottom-anchored, not
// centered). D1PanelClick subtracts both origins before its rect tests, so
// draw and hit test move together.

#define D1_BULB_W		88

//DrawSpell icon placement, panel-local. y is the bottom row.
#define D1_SPLICON_X	565
#define D1_SPLICON_Y	119			//DrawSpell PANEL_Y + 119, panel-local
#define D1_SPLICON_W	56			//SPLICONLENGTH
#define D1_SPLICON_NUL	27			//blank icon, drawn for SPL_INVALID

//PAL8/PAL16 ramp bases live in D1Inv.ZC (before this file).

//SetSpellTrans arms this port draws: RSPLTYPE_INVALID keeps the art as it is,
//RSPLTYPE_SPELL folds it blue, RSPLTYPE_CHARGES orange
#define D1_SPT_NONE		0
#define D1_SPT_SPELL	1
#define D1_SPT_CHARGES	2

U8	*d1_panel_cel = NULL;
U8	*d1_bulbs_cel = NULL;
U8	*d1_splicon_cel = NULL;
U8	 d1_panel_txt[48];

//SplTransTbl, rebuilt per frame from the selected spell's castability
U8	 d1_spl_trans[256];

//D1Spell compiles after this file and installs both. NULL leaves the icon
//slot blank.
I64	 (*d1_panel_spicon)()  = NULL;	//SpellITbl frame of the selected spell
I64	 (*d1_panel_sptrans)() = NULL;	//D1_SPT_* ramp the icon is drawn through
U0	 (*d1_panel_splring_draw)() = NULL;
Bool (*d1_panel_splring_click)(I64 mx, I64 my) = NULL;
U0	 (*d1_panel_splring_toggle)() = NULL;

//pre-decoded 88x88 empty-crystal overlays from P8Bulbs
U8	 d1_bulb_px[2][88 * 88];
U8	 d1_bulb_mk[2][88 * 88];
Bool d1_bulbs_dec = FALSE;

Bool D1PanelInit()
{
	I64 size = 0;

	if (!d1_panel_cel)
		d1_panel_cel = D1MpqRead("CtrlPan\\Panel8.CEL", &size);
	if (!d1_bulbs_cel)
		d1_bulbs_cel = D1MpqRead("CtrlPan\\P8Bulbs.CEL", &size);
	if (!d1_splicon_cel)
		d1_splicon_cel = D1MpqRead("CtrlPan\\SpelIcon.CEL", &size);
	if (d1_bulbs_cel && !d1_bulbs_dec)
	{
		D1CelDecodeFrame(d1_bulbs_cel, 1, 88, 88, d1_bulb_px[0], d1_bulb_mk[0]);
		D1CelDecodeFrame(d1_bulbs_cel, 2, 88, 88, d1_bulb_px[1], d1_bulb_mk[1]);
		d1_bulbs_dec = TRUE;
	}

	return d1_panel_cel != NULL;
}

U0 D1OrbDraw(I64 which, I64 sx, I64 cur, I64 max)
{//Panel8 already drew the full liquid. paint empty crystal on the top
 //empty rows so the fill line drains downward. top = PANEL_TOP - 13.
	I64 cutoff;
	I64 x;
	I64 y;
	I64 top = D1PanelTop() - 13;

	if (max <= 0 || !d1_bulbs_dec)
		return;
	if (cur < 0)
		cur = 0;
	if (cur > max)
		cur = max;
	cutoff = 88 - (88 * cur) / max;
	if (cutoff < 0)
		cutoff = 0;
	if (cutoff > 88)
		cutoff = 88;

	for (y = 0; y < cutoff; y++)
	{
		for (x = 0; x < 88; x++)
		{
			if (d1_bulb_mk[which][y * 88 + x])
				D1Pix(sx + x, top + y, d1_bulb_px[which][y * 88 + x]);
		}
	}
}

U0 D1CelDrawBottomRows(I64 sx, I64 sy, U8 *buf, I64 frame, I64 w, I64 rows)
{//unclipped frame, only the lowest `rows` scanlines plot
	I64	 dsize = 0;
	U8	*data  = D1CelFrame(buf, frame, &dsize);
	I64	 i = 0;
	I64	 x = 0;
	I64	 r = 0;
	I64	 b;
	I64	 n;

	while (i < dsize && r < rows)
	{
		b = data[i];
		i++;
		if (b < 0x80)
		{
			for (n = 0; n < b; n++)
			{
				D1Pix(sx + x, sy - r, data[i]);
				i++;
				x++;
			}
		}
		else
			x += 0x100 - b;

		if (x >= w)
		{
			x = 0;
			r++;
		}
	}
}

U0 D1SpellTransSet(I64 mode)
{//control.cpp SetSpellTrans. the icon art is drawn in the beige, yellow and
 //orange 16-step ramps; RSPLTYPE_SPELL folds all three, plus the PAL8_YELLOW
 //triple, onto the blue ramp, RSPLTYPE_CHARGES folds beige and yellow onto
 //orange and leaves orange alone. RSPLTYPE_INVALID keeps the identity table.
	I64 i;

	for (i = 0; i < 256; i++)
		d1_spl_trans[i] = i;
	d1_spl_trans[255] = 0;

	if (mode == D1_SPT_SPELL)
	{
		d1_spl_trans[D1_PAL8_YELLOW]     = D1_PAL16_BLUE + 1;
		d1_spl_trans[D1_PAL8_YELLOW + 1] = D1_PAL16_BLUE + 3;
		d1_spl_trans[D1_PAL8_YELLOW + 2] = D1_PAL16_BLUE + 5;
		for (i = 0; i < 16; i++)
		{
			d1_spl_trans[D1_PAL16_BEIGE  + i] = D1_PAL16_BLUE + i;
			d1_spl_trans[D1_PAL16_YELLOW + i] = D1_PAL16_BLUE + i;
			d1_spl_trans[D1_PAL16_ORANGE + i] = D1_PAL16_BLUE + i;
		}
	}
	else if (mode == D1_SPT_CHARGES)
	{
		d1_spl_trans[D1_PAL8_YELLOW]     = D1_PAL16_ORANGE + 1;
		d1_spl_trans[D1_PAL8_YELLOW + 1] = D1_PAL16_ORANGE + 3;
		d1_spl_trans[D1_PAL8_YELLOW + 2] = D1_PAL16_ORANGE + 5;
		for (i = 0; i < 16; i++)
		{
			d1_spl_trans[D1_PAL16_BEIGE  + i] = D1_PAL16_ORANGE + i;
			d1_spl_trans[D1_PAL16_YELLOW + i] = D1_PAL16_ORANGE + i;
		}
	}
}

U0 D1CelDrawTrans(I64 sx, I64 sy, U8 *buf, I64 frame, I64 w, U8 *tbl)
{//unclipped frame, every plotted index mapped through tbl (DrawSpellCel)
	I64	 dsize = 0;
	U8	*data  = D1CelFrame(buf, frame, &dsize);
	I64	 i = 0;
	I64	 x = 0;
	I64	 y = sy;
	I64	 b;
	I64	 n;

	while (i < dsize)
	{
		b = data[i];
		i++;
		if (b < 0x80)
		{
			for (n = 0; n < b; n++)
			{
				D1Pix(sx + x, y, tbl[data[i]]);
				i++;
				x++;
			}
		}
		else
			x += 0x100 - b;

		if (x >= w)
		{
			x = 0;
			y--;
		}
	}
}

//--- info box text ---------------------------------------------------------
//
// SmalText glyphs live in the PAL16_GRAY silver ramp; control.cpp PrintChar
// shifts them onto the blue, red or yellow ramp per text_color. the same
// shifts, as translation tables for D1CelDrawTrans.

U8	 d1_txt_trans[4][256];
Bool d1_txt_built = FALSE;

//info box line baselines, panel-local (control.cpp lineOffsets minus
//PANEL_Y 352). row = total lines - 1, five slots per row.
I64	 d1_info_yofs[25] = {
	82,  0,  0,  0,  0,
	70, 94,  0,  0,  0,
	64, 82, 100, 0,  0,
	60, 75, 89, 104, 0,
	58, 70, 82, 94, 105};

U0 D1TextTransBuild()
{//control.cpp PrintChar COL_WHITE/BLUE/RED/GOLD arms
	I64 i;
	I64 c;

	for (c = 0; c < 4; c++)
		for (i = 0; i < 256; i++)
			d1_txt_trans[c][i] = i;
	for (i = D1_PAL16_GRAY; i < 256; i++)
	{
		if (i > D1_PAL16_GRAY + 13)
			d1_txt_trans[D1COL_BLUE][i] = D1_PAL16_BLUE + 15;
		else
			d1_txt_trans[D1COL_BLUE][i] = i - (D1_PAL16_GRAY -
				(D1_PAL16_BLUE + 2));
		d1_txt_trans[D1COL_RED][i] = i - (D1_PAL16_GRAY - D1_PAL16_RED);
		if (i >= D1_PAL16_GRAY + 14)
			d1_txt_trans[D1COL_GOLD][i] = D1_PAL16_YELLOW + 15;
		else
			d1_txt_trans[D1COL_GOLD][i] = i - (D1_PAL16_GRAY -
				(D1_PAL16_YELLOW + 2));
	}
	d1_txt_built = TRUE;
}

U0 D1TextDrawClr(I64 x, I64 y, U8 *str, I64 col)
{//smaltext glyphs through the PrintChar ramp shift. y is the baseline.
	I64 i = 0;
	I64 f;

	if (!d1_smaltext)
		return;
	if (!d1_txt_built)
		D1TextTransBuild;
	if (col < 0 || col > 3)
		col = D1COL_WHITE;

	while (str[i])
	{
		f = d1_fontframe[str[i] & 0x7F];
		if (f)
			D1CelDrawTrans(x, y, d1_smaltext, f, 13, d1_txt_trans[col]);
		x += d1_fontkern[f] + 1;
		i++;
	}
}

U0 D1PanelInfoDraw(I64 mx, I64 my)
{//control.cpp DrawInfoBox: a hovered item's lines fill the info box; the
 //gold/level readout holds it otherwise. box x 177, width 288, panel-local.
 //inventory hover first, then the store rows (D1Store compiles earlier).
	I64 i;
	I64 w;
	I64 x;
	I64 ox = D1UiOrgX();
	I64 py = D1PanelTop();
	Bool hit;

	hit = D1InvInfoFill(mx, my);
	if (!hit)
		hit = D1StoreInfoFill(mx, my);
	if (!hit && D1HoldHas())
	{//HoldItem fills the description box while carried
		d1_info_n = 0;
		D1InfoItem(d1_hold_itm, &d1_hold_st, d1_hold_val);
		hit = ToBool(d1_info_n > 0);
	}
	if (!hit && d1_hover_ii >= 0)
	{//GetItemStr into the description box (retail), not a floating name
		d1_info_n = 0;
		D1InfoItem(d1_items[d1_hover_ii].itm, &d1_st_ground[d1_hover_ii],
			d1_items[d1_hover_ii].val);
		hit = ToBool(d1_info_n > 0);
	}
	if (!hit && d1_hover_oi >= 0)
	{//GetObjectStr into the description box (Door / Chest / Barrel)
		d1_info_n = 0;
		D1InfoAdd(D1ObjHoverName(d1_hover_oi), D1COL_WHITE);
		hit = ToBool(d1_info_n > 0);
	}
	if (!hit && d1_hover_twn >= 0)
	{
		d1_info_n = 0;
		D1InfoAdd(d1_twn[d1_hover_twn].name, D1COL_WHITE);
		hit = ToBool(d1_info_n > 0);
	}
	if (!hit && d1_hover_mi >= 0)
	{
		d1_info_n = 0;
		D1InfoAdd(d1_montypes[d1_mons[d1_hover_mi].type].name, D1COL_WHITE);
		hit = ToBool(d1_info_n > 0);
	}
	if (hit && d1_info_n > 0)
	{
		for (i = 0; i < d1_info_n; i++)
		{
			w = D1TextWidth(d1_info_txt[i]);
			x = ox + 177;
			if (w < 288)
				x += (288 - w) / 2;
			D1TextDrawClr(x, py + d1_info_yofs[(d1_info_n - 1) * 5 + i],
				d1_info_txt[i], d1_info_clr[i]);
		}
		return;
	}
	StrPrint(d1_panel_txt, "Gold %d   Level %d", d1_plr_gold, d1_plr_lvl);
	D1TextDrawSolid(ox + D1_UI_W / 2 - D1TextWidth(d1_panel_txt) / 2, py + 88,
		d1_panel_txt, D1PalBrightest());
}

U0 D1PanelSpellDraw()
{//control.cpp DrawSpell
	I64 icon = D1_SPLICON_NUL;
	I64 mode = D1_SPT_NONE;

	if (!d1_splicon_cel)
		return;
	if (d1_panel_spicon)
		icon = (*d1_panel_spicon)();
	if (d1_panel_sptrans)
		mode = (*d1_panel_sptrans)();
	if (icon < 1 || icon > D1CelNFrames(d1_splicon_cel))
		icon = D1_SPLICON_NUL;

	D1SpellTransSet(mode);
	D1CelDrawTrans(D1UiOrgX() + D1_SPLICON_X, D1PanelTop() + D1_SPLICON_Y,
		d1_splicon_cel, icon, D1_SPLICON_W, d1_spl_trans);
}

I64 D1PanelClick(I64 cx, I64 cy)
{//control.cpp PanBtnPos rects, panel-local (PanBtnPos y minus PANEL_Y 352).
 //returns: 0 none, 1 menu, 2 inv, 3 spells, 4 char, 5 quests, 6 map,
 //10+n belt slot n
	I64 i;

	if (cy < D1PanelTop())
		return 0;

	//panel-local; the art sits in the centered 640 band on the bottom edge
	cx -= D1UiOrgX();
	cy -= D1PanelTop();

	if (cx >= 9 && cx < 80)
	{
		if (cy >= 9 && cy < 28)
			return 4;
		if (cy >= 35 && cy < 54)
			return 5;
		if (cy >= 75 && cy < 94)
			return 6;
		if (cy >= 101 && cy < 120)
			return 1;
	}
	if (cx >= 560 && cx < 631)
	{
		if (cy >= 9 && cy < 28)
			return 2;
		if (cy >= 35 && cy < 54)
			return 3;
	}
	//SpelIcon: DoSpeedBook (control.cpp) — ring of known spells
	if (cx >= D1_SPLICON_X && cx < D1_SPLICON_X + D1_SPLICON_W &&
		cy >= D1_SPLICON_Y - D1_SPLICON_W + 1 && cy <= D1_SPLICON_Y)
		return 7;
	if (cy >= 5 && cy < 36)
	{
		for (i = 0; i < 8; i++)
		{
			if (cx >= 205 + i * 29 && cx < 233 + i * 29)
				return 10 + i;
		}
	}
	return 0;
}

U0 D1PanelDraw()
{
	I64 fill;
	I64 ox = D1UiOrgX();
	I64 py = D1PanelTop();
	I64 bx;
	I64 by;
	Bool hov;
	CD1ItmSt bst;

	if (!d1_panel_cel)
		return;

	D1CelDraw(ox, py + D1_PANEL_H - 1, d1_panel_cel, 1, D1_UI_W);

	D1OrbDraw(0, ox + 96, d1_plr_hp, d1_plr_maxhp);
	D1OrbDraw(1, ox + 464, d1_plr_mana, d1_plr_maxmana);

	//belt: the item's Objcurs frame in its socket. inv.cpp InvRect belt rows:
	//panel-local x 205 + 29 per slot, icon bottom at panel-local 32.
	for (fill = 0; fill < 8; fill++)
	{
		if (d1_belt[fill])
		{
			bx = ox + 205 + fill * 29;
			by = py + 32;
			D1InvSlotBack(bx, by, 28, 28, D1_IQ_NORMAL);
			D1StClear(&bst);
			hov = FALSE;
			if (D1MouseY() - py >= 5 && D1MouseY() - py < 36 &&
				D1MouseX() - ox >= 205 + fill * 29 &&
				D1MouseX() - ox < 233 + fill * 29)
				hov = TRUE;
			D1InvDrawIcon(bx, by, d1_belt[fill], &bst, hov);
		}
	}

	D1PanelSpellDraw;
	if (d1_panel_splring_draw)
		(*d1_panel_splring_draw)();
}
