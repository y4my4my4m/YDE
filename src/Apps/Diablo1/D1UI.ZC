// D1UI.ZC - screen-panel registry
//
// every full-screen-half panel (character, inventory, spellbook, quest
// log, automap, store) exposes the same shape: an open flag, a toggle, a
// draw, and a click handler returning TRUE when it consumed the click.
// modules register at startup; the shell drives them through this table
// instead of naming each one, so adding a panel touches one register call.
//
// exclusivity follows the original: the character sheet and quest log own
// the LEFT half, the inventory and spellbook the RIGHT half, and opening
// one closes the other on that side. FULL panels (store, automap overlay)
// close everything else.

#define D1UI_MAXPANEL	10

#define D1UIS_LEFT		0
#define D1UIS_RIGHT		1
#define D1UIS_FULL		2
#define D1UIS_OVERLAY	3		//coexists with everything (automap)

class CD1UIPanel
{
	Bool  *open;			//module's own open flag
	U0	 (*toggle)();
	U0	 (*draw)();
	Bool (*click)(I64 cx, I64 cy);
	I64	   side;
};

CD1UIPanel d1_ui_panels[D1UI_MAXPANEL];
I64		   d1_ui_count = 0;

U0 D1UIInit()
{
	d1_ui_count = 0;
}

I64 D1UIRegister(Bool *open, U0 (*toggle)(), U0 (*draw)(),
	Bool (*click)(I64 cx, I64 cy), I64 side)
{//returns the panel index, -1 when the table is full
	CD1UIPanel *p;

	if (d1_ui_count >= D1UI_MAXPANEL)
		return -1;

	p = &d1_ui_panels[d1_ui_count];
	p->open   = open;
	p->toggle = toggle;
	p->draw   = draw;
	p->click  = click;
	p->side   = side;
	d1_ui_count++;
	return d1_ui_count - 1;
}

Bool D1UIIsOpen(I64 idx)
{
	if (idx < 0 || idx >= d1_ui_count)
		return FALSE;
	if (!d1_ui_panels[idx].open)
		return FALSE;
	return *d1_ui_panels[idx].open;
}

U0 D1UIClose(I64 idx)
{
	if (idx < 0 || idx >= d1_ui_count)
		return;
	if (D1UIIsOpen(idx) && d1_ui_panels[idx].toggle)
		(*d1_ui_panels[idx].toggle)();
}

U0 D1UICloseAll()
{
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
		D1UIClose(i);
}

Bool D1UIAnyOpen()
{
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i))
			return TRUE;
	}
	return FALSE;
}

U0 D1UIToggle(I64 idx)
{//opening evicts whatever shares the side; FULL panels evict everything
	I64	 i;
	Bool was_open;

	if (idx < 0 || idx >= d1_ui_count)
		return;

	was_open = D1UIIsOpen(idx);
	if (!was_open)
	{
		for (i = 0; i < d1_ui_count; i++)
		{
			if (i != idx && D1UIIsOpen(i))
			{
				if (d1_ui_panels[idx].side == D1UIS_FULL ||
					d1_ui_panels[i].side == D1UIS_FULL ||
					d1_ui_panels[i].side == d1_ui_panels[idx].side)
					D1UIClose(i);
			}
		}
	}

	if (d1_ui_panels[idx].toggle)
		(*d1_ui_panels[idx].toggle)();
}

U0 D1UIDrawAll()
{//registration order is draw order
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i) && d1_ui_panels[i].draw)
			(*d1_ui_panels[i].draw)();
	}
}

Bool D1UIClickAny(I64 cx, I64 cy)
{//TRUE when an open panel consumed the click; last drawn gets first refusal
	I64 i;

	for (i = d1_ui_count - 1; i >= 0; i--)
	{
		if (D1UIIsOpen(i) && d1_ui_panels[i].click)
		{
			if ((*d1_ui_panels[i].click)(cx, cy))
				return TRUE;
		}
	}
	return FALSE;
}
