// D1Obj.ZC - dungeon objects: barrels and chests
//
// unclipped CELs, one facing: Barrel 9 frames (1 whole, 2-8 shatter,
// rest empty), Chest1-3 6 frames (1 closed, opening). objects block their
// tile until broken or opened, then free it and may drop loot.

#define D1_MAXOBJ		64
#define D1OB_BARREL		0
#define D1OB_CHEST		1

class CD1Obj
{
	I64	 type;
	I64	 gfx;			//chest variant 0-2
	I64	 x;
	I64	 y;
	I64	 frame;
	Bool opened;
	Bool active;
};

CD1Obj d1_objs[D1_MAXOBJ];
U8	 d1_dobj[D1_MAXDUN * D1_MAXDUN];	//obj idx+1
I64	 d1_nobjs = 0;
Bool d1_obj_init = FALSE;

U8	*d1_gfx_barrel = NULL;
U8	*d1_gfx_chest[3];

U0 D1ObjInit()
{
	I64 size;

	if (!d1_obj_init)
	{
		d1_gfx_barrel   = D1MpqRead("Objects\\Barrel.CEL", &size);
		d1_gfx_chest[0] = D1MpqRead("Objects\\Chest1.CEL", &size);
		d1_gfx_chest[1] = D1MpqRead("Objects\\Chest2.CEL", &size);
		d1_gfx_chest[2] = D1MpqRead("Objects\\Chest3.CEL", &size);
		d1_obj_init = TRUE;
	}
}

U0 D1ObjClear()
{
	I64 i;

	D1ObjInit;
	d1_nobjs = 0;
	for (i = 0; i < D1_MAXOBJ; i++)
		d1_objs[i].active = FALSE;
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dobj[i] = 0;
}

U0 D1ObjSpawnLevel(I64 level)
{//scatter barrels and chests over open floor
	I64 want = 12 + D1Rnd(8);
	I64 tries = 0;
	I64 x;
	I64 y;
	CD1Obj *o;

	no_warn level;

	D1ObjClear;

	while (want > 0 && tries < 2000 && d1_nobjs < D1_MAXOBJ)
	{
		tries++;
		x = D1Rnd(D1_MAXDUN);
		y = D1Rnd(D1_MAXDUN);
		if (D1WalkableM(x, y) && !d1_dobj[x + y * D1_MAXDUN] &&
			!d1_ditem[x + y * D1_MAXDUN])
		{
			o = &d1_objs[d1_nobjs];
			o->x      = x;
			o->y      = y;
			o->frame  = 1;
			o->opened = FALSE;
			o->active = TRUE;
			if (D1Rnd(3) == 0)
			{
				o->type = D1OB_CHEST;
				o->gfx  = D1Rnd(3);
			}
			else
			{
				o->type = D1OB_BARREL;
				o->gfx  = 0;
			}
			d1_dobj[x + y * D1_MAXDUN] = d1_nobjs + 1;
			d1_nobjs++;
			want--;
		}
	}
}

Bool D1ObjBlocks(I64 x, I64 y)
{
	I64 oi = d1_dobj[x + y * D1_MAXDUN];

	if (!oi)
		return FALSE;
	return !d1_objs[oi - 1].opened;
}

Bool D1ObjOperate(I64 x, I64 y, I64 level)
{//break a barrel / open a chest next to the player. TRUE = did something.
	I64	 oi = d1_dobj[x + y * D1_MAXDUN];
	CD1Obj *o;
	I64	 r;

	if (!oi)
		return FALSE;
	o = &d1_objs[oi - 1];
	if (!o->active || o->opened)
		return FALSE;

	o->opened = TRUE;
	o->frame  = 2;

	//loot roll
	r = D1Rnd(4);
	if (o->type == D1OB_CHEST || r == 0)
	{
		r = D1Rnd(3);
		if (r == 0)
			D1ItemDrop(D1IT_GOLD, x, y, 10 + D1Rnd(20 * level + 20));
		else if (r == 1)
			D1ItemDrop(D1IT_HEAL, x, y, 0);
		else
			D1ItemDrop(D1IT_MANA, x, y, 0);
	}

	return TRUE;
}

U0 D1ObjTickAll()
{//run open/shatter anims to their last frame
	I64 i;
	I64 nf;
	CD1Obj *o;

	for (i = 0; i < d1_nobjs; i++)
	{
		o = &d1_objs[i];
		if (o->active && o->opened)
		{
			nf = 9;
			if (o->type == D1OB_CHEST)
				nf = 6;
			if (o->frame < nf)
				o->frame++;
		}
	}
}

U0 D1ObjDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{//under actors, over the floor
	I64	 oi = d1_dobj[x + y * D1_MAXDUN];
	CD1Obj *o;
	U8	*buf;

	if (!oi)
		return;
	o = &d1_objs[oi - 1];
	if (!o->active)
		return;

	if (o->type == D1OB_BARREL)
		buf = d1_gfx_barrel;
	else
		buf = d1_gfx_chest[o->gfx];
	if (buf)
		D1CelDraw(sx - 16, sy, buf, o->frame, 96);
}
