// little-endian readers for on-disk Diablo structures
//
// ZealC postfix casts are no-ops; never overlay a class on raw file bytes.

U16 D1RdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

I64 D1RdI16(U8 *p)
{
	I64 v = p[0] | (p[1] << 8);

	if (v & 0x8000)
		v -= 0x10000;

	return v;
}

U32 D1RdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 D1RdI32(U8 *p)
{
	I64 v = D1RdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;

	return v;
}

U0 D1StrCopy(U8 *dst, U8 *src, I64 max)
{
	I64 i = 0;

	while (src[i] && i < max - 1)
	{
		dst[i] = src[i];
		i++;
	}
	dst[i] = 0;
}
