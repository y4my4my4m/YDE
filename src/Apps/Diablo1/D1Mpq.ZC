//generated decode tables
U8	 d1_length_codes[0x100];
U8	 d1_dist_pos_codes[0x100];
U8	 d1_asc_bits[0x100];		//mutated copy of d1_ch_bits_asc
U8	 d1_offs_2C34[0x100];
U8	 d1_offs_2D34[0x100];
U8	 d1_offs_2E34[0x80];
U8	 d1_offs_2EB4[0x100];
Bool d1_explode_ready = FALSE;

U0 D1GenDecodeTab(U8 *positions, U8 *starts, U8 *bits, I64 elements)
{//GenDecodeTabs: mark which symbol owns each low-byte pattern
	I64 i;
	I64 idx;
	I64 step;

	for (i = 0; i < elements; i++)
	{
		step = 1 << bits[i];
		idx  = starts[i];
		while (idx < 0x100)
		{
			positions[idx] = i;
			idx += step;
		}
	}
}

U0 D1ExplodeInit()
{//GenAscTabs + the two fixed decode tables
	I64 count;
	I64 code;
	I64 bits;
	I64 add;
	I64 acc;

	D1GenDecodeTab(d1_length_codes, d1_len_code, d1_len_bits, 16);
	D1GenDecodeTab(d1_dist_pos_codes, d1_dist_code, d1_dist_bits, 64);

	MemCopy(d1_asc_bits, d1_ch_bits_asc, 0x100);
	MemSet(d1_offs_2C34, 0, 0x100);
	MemSet(d1_offs_2D34, 0, 0x100);
	MemSet(d1_offs_2E34, 0, 0x80);
	MemSet(d1_offs_2EB4, 0, 0x100);

	for (count = 0xFF; count >= 0; count--)
	{
		code = d1_ch_code_asc[count];
		bits = d1_asc_bits[count];

		if (bits <= 8)
		{
			add = 1 << bits;
			acc = code;
			while (acc < 0x100)
			{
				d1_offs_2C34[acc] = count;
				acc += add;
			}
		}
		else
		{
			acc = code & 0xFF;
			if (acc)
			{
				d1_offs_2C34[acc] = 0xFF;
				if (code & 0x3F)
				{
					bits -= 4;
					d1_asc_bits[count] = bits;
					add = 1 << bits;
					acc = code >> 4;
					while (acc < 0x100)
					{
						d1_offs_2D34[acc] = count;
						acc += add;
					}
				}
				else
				{
					bits -= 6;
					d1_asc_bits[count] = bits;
					add = 1 << bits;
					acc = code >> 6;
					while (acc < 0x80)
					{
						d1_offs_2E34[acc] = count;
						acc += add;
					}
				}
			}
			else
			{
				bits -= 8;
				d1_asc_bits[count] = bits;
				add = 1 << bits;
				acc = code >> 8;
				while (acc < 0x100)
				{
					d1_offs_2EB4[acc] = count;
					acc += add;
				}
			}
		}
	}
	d1_explode_ready = TRUE;
}

class CD1Bits
{//LSB-first bit stream over one sector
	U8	*data;
	I64	 len;
	I64	 pos;
	I64	 buf;
	I64	 n;
};

U0 D1BitsFill(CD1Bits *b)
{
	while (b->n <= 24 && b->pos < b->len)
	{
		b->buf |= b->data[b->pos] << b->n;
		b->pos++;
		b->n += 8;
	}
}

I64 D1BitsPeek8(CD1Bits *b)
{
	D1BitsFill(b);
	return b->buf & 0xFF;
}

Bool D1BitsWaste(CD1Bits *b, I64 nbits)
{//FALSE = out of input, WasteBits' STREAM_END
	D1BitsFill(b);
	if (nbits > b->n)
		return FALSE;
	b->buf >>= nbits;
	b->n   -= nbits;
	return TRUE;
}

I64 D1DecodeLit(CD1Bits *b, I64 ctype)
{//< 0x100 literal byte; >= 0x100 repetition of (v - 0xFE) bytes;
 //0x305 end of stream; 0x306 corrupt
	I64 lc;
	I64 exb;
	I64 extra;
	I64 v;

	if (D1BitsPeek8(b) & 1)
	{
		if (!D1BitsWaste(b, 1))
			return 0x306;

		lc = d1_length_codes[D1BitsPeek8(b)];
		if (!D1BitsWaste(b, d1_len_bits[lc]))
			return 0x306;

		exb = d1_ex_len_bits[lc];
		if (exb)
		{
			extra = b->buf & ((1 << exb) - 1);
			if (!D1BitsWaste(b, exb))
			{
				if (lc + extra != 0x10E)
					return 0x306;
			}
			lc = d1_len_base[lc] + extra;
		}
		return lc + 0x100;
	}

	if (!D1BitsWaste(b, 1))
		return 0x306;

	if (ctype == 0)
	{//binary: 8 raw bits
		v = D1BitsPeek8(b);
		if (!D1BitsWaste(b, 8))
			return 0x306;
		return v;
	}

	//ascii: huffman coded literal
	if (D1BitsPeek8(b))
	{
		v = d1_offs_2C34[D1BitsPeek8(b)];
		if (v == 0xFF)
		{
			if (D1BitsPeek8(b) & 0x3F)
			{
				if (!D1BitsWaste(b, 4))
					return 0x306;
				v = d1_offs_2D34[D1BitsPeek8(b)];
			}
			else
			{
				if (!D1BitsWaste(b, 6))
					return 0x306;
				v = d1_offs_2E34[D1BitsPeek8(b) & 0x7F];
			}
		}
	}
	else
	{
		if (!D1BitsWaste(b, 8))
			return 0x306;
		v = d1_offs_2EB4[D1BitsPeek8(b)];
	}

	if (!D1BitsWaste(b, d1_asc_bits[v]))
		return 0x306;

	return v;
}

I64 D1DecodeDist(CD1Bits *b, I64 rep_length, I64 dsize_bits, I64 dsize_mask)
{//0 = corrupt
	I64 dp = d1_dist_pos_codes[D1BitsPeek8(b)];
	I64 dist;

	if (!D1BitsWaste(b, d1_dist_bits[dp]))
		return 0;

	if (rep_length == 2)
	{
		dist = (dp << 2) | (b->buf & 0x03);
		if (!D1BitsWaste(b, 2))
			return 0;
	}
	else
	{
		dist = (dp << dsize_bits) | (b->buf & dsize_mask);
		if (!D1BitsWaste(b, dsize_bits))
			return 0;
	}

	return dist + 1;
}

I64 D1Explode(U8 *src, I64 src_len, U8 *dst, I64 dst_max)
{//one DCL stream -> dst. returns bytes produced, -1 on corrupt data
	CD1Bits	bits;
	I64		ctype;
	I64		dsize_bits;
	I64		dsize_mask;
	I64		out = 0;
	I64		lit;
	I64		rep;
	I64		dist;

	if (!d1_explode_ready)
		D1ExplodeInit;

	if (src_len < 4)
		return -1;

	ctype      = src[0];
	dsize_bits = src[1];
	if (dsize_bits < 4 || dsize_bits > 6)
		return -1;
	if (ctype != 0 && ctype != 1)
		return -1;
	dsize_mask = (1 << dsize_bits) - 1;

	bits.data = src;
	bits.len  = src_len;
	bits.pos  = 2;
	bits.buf  = 0;
	bits.n    = 0;

	while (TRUE)
	{
		lit = D1DecodeLit(&bits, ctype);
		if (lit >= 0x305)
		{
			if (lit == 0x306)
				return -1;
			break;
		}
		if (lit >= 0x100)
		{
			rep  = lit - 0xFE;
			dist = D1DecodeDist(&bits, rep, dsize_bits, dsize_mask);
			if (dist == 0 || dist > out)
				return -1;
			if (out + rep > dst_max)
				return -1;
			while (rep > 0)
			{
				dst[out] = dst[out - dist];
				out++;
				rep--;
			}
		}
		else
		{
			if (out >= dst_max)
				return -1;
			dst[out] = lit;
			out++;
		}
	}

	return out;
}

//--- archive ---------------------------------------------------------------

class CD1Mpq
{
	U8	*data;			//whole file, resident
	I64	 size;
	I64	 sector_size;
	I64	 hash_off;
	I64	 block_off;
	I64	 hash_count;
	I64	 block_count;
	U32	*hash;			//decrypted copy, 4 U32 per entry
	U32	*block;			//decrypted copy, 4 U32 per entry
};

CD1Mpq	d1_mpq;
Bool	d1_mpq_ready = FALSE;

Bool D1MpqMount(U8 *filename)
{
	U8	*d;
	I64	 size = 0;
	I64	 n;

	if (!d1_crypt_ready)
		D1CryptInit;
	if (!d1_explode_ready)
		D1ExplodeInit;

	d1_mpq_ready  = FALSE;
	d1_mpq.data   = NULL;
	d1_mpq.hash   = NULL;
	d1_mpq.block  = NULL;

	d = FileRead(filename, &size);
	if (!d)
	{
		"D1Mpq: cannot read %s\n", filename;
		return FALSE;
	}
	if (size < 32 || d[0] != 'M' || d[1] != 'P' || d[2] != 'Q' || d[3] != 0x1A)
	{
		"D1Mpq: %s is not an MPQ\n", filename;
		Free(d);
		return FALSE;
	}

	d1_mpq.data        = d;
	d1_mpq.size        = size;
	d1_mpq.sector_size = 512 << D1RdU16(d + 14);
	d1_mpq.hash_off    = D1RdU32(d + 16);
	d1_mpq.block_off   = D1RdU32(d + 20);
	d1_mpq.hash_count  = D1RdU32(d + 24);
	d1_mpq.block_count = D1RdU32(d + 28);

	if (d1_mpq.hash_off + d1_mpq.hash_count * 16 > size ||
		d1_mpq.block_off + d1_mpq.block_count * 16 > size)
	{
		"D1Mpq: table offsets out of range\n";
		Free(d);
		d1_mpq.data = NULL;
		return FALSE;
	}

	n = d1_mpq.hash_count * 4;
	d1_mpq.hash = CAlloc(n * 4);
	MemCopy(d1_mpq.hash, d + d1_mpq.hash_off, n * 4);
	D1Decrypt(d1_mpq.hash, n, D1HashStr("(hash table)", 3));

	n = d1_mpq.block_count * 4;
	d1_mpq.block = CAlloc(n * 4);
	MemCopy(d1_mpq.block, d + d1_mpq.block_off, n * 4);
	D1Decrypt(d1_mpq.block, n, D1HashStr("(block table)", 3));

	d1_mpq_ready = TRUE;
	return TRUE;
}

I64 D1MpqFind(U8 *name)
{//block table index, -1 if absent
	I64 mask;
	I64 start;
	I64 na;
	I64 nb;
	I64 i;
	I64 bidx;

	if (!d1_mpq_ready)
		return -1;

	mask  = d1_mpq.hash_count - 1;
	start = D1HashStr(name, 0) & mask;
	na    = D1HashStr(name, 1);
	nb    = D1HashStr(name, 2);
	i     = start;

	while (TRUE)
	{
		bidx = d1_mpq.hash[i * 4 + 3];
		if (bidx == 0xFFFFFFFF)
			return -1;
		if (bidx != 0xFFFFFFFE &&
			d1_mpq.hash[i * 4] == na && d1_mpq.hash[i * 4 + 1] == nb)
			return bidx;
		i = (i + 1) & mask;
		if (i == start)
			return -1;
	}
}

Bool D1MpqExists(U8 *name)
{
	return D1MpqFind(name) >= 0;
}

U8 *D1MpqRead(U8 *name, I64 *size_out)
{//whole file -> fresh CAlloc buffer. NULL on missing or corrupt.
	I64	 bidx;
	I64	 offset;
	I64	 packed;
	I64	 unpacked;
	I64	 flags;
	I64	 key = 0;
	I64	 nsect;
	I64	 s;
	I64	 so;
	I64	 se;
	I64	 expect;
	I64	 got;
	I64	 n;
	U8	*base;
	U8	*raw;
	U8	*out;
	U32	*offs;
	U8	*sec;
	I64	 i;

	if (size_out)
		*size_out = 0;

	bidx = D1MpqFind(name);
	if (bidx < 0 || bidx >= d1_mpq.block_count)
		return NULL;

	offset   = d1_mpq.block[bidx * 4];
	packed   = d1_mpq.block[bidx * 4 + 1];
	unpacked = d1_mpq.block[bidx * 4 + 2];
	flags    = d1_mpq.block[bidx * 4 + 3];

	if (!(flags & D1MPQ_EXISTS))
		return NULL;
	if (offset + packed > d1_mpq.size)
		return NULL;

	if (flags & D1MPQ_ENCRYPTED)
	{//key from uppercased basename
		base = name;
		i    = 0;
		while (name[i])
		{
			if (name[i] == '\\' || name[i] == '/')
				base = name + i + 1;
			i++;
		}
		key = D1HashStr(base, 3);
		if (flags & D1MPQ_FIX_KEY)
			key = ((key + offset) ^ unpacked) & 0xFFFFFFFF;
	}

	raw = d1_mpq.data + offset;
	out = CAlloc(unpacked + 8);

	if (!(flags & (D1MPQ_IMPLODE | D1MPQ_COMPRESS)))
	{//stored flat. encryption stays per sector: each sector_size chunk is an
	 //independent cipher stream keyed key + sector index. one pass with the
	 //base key decodes sector 0 only; the Storm seed2 state and the key are
	 //both wrong from sector 1 on.
		MemCopy(out, raw, unpacked);
		if (flags & D1MPQ_ENCRYPTED)
		{
			nsect = (unpacked + d1_mpq.sector_size - 1) / d1_mpq.sector_size;
			for (s = 0; s < nsect; s++)
			{
				expect = unpacked - s * d1_mpq.sector_size;
				if (expect > d1_mpq.sector_size)
					expect = d1_mpq.sector_size;
				D1Decrypt(out + s * d1_mpq.sector_size, expect / 4,
					(key + s) & 0xFFFFFFFF);
			}
		}
		if (size_out)
			*size_out = unpacked;
		return out;
	}

	//sector based: (nsect + 1) U32 offsets relative to the block start
	nsect = (unpacked + d1_mpq.sector_size - 1) / d1_mpq.sector_size;
	n     = (nsect + 1) * 4;
	offs  = CAlloc(n);
	MemCopy(offs, raw, n);
	if (flags & D1MPQ_ENCRYPTED)
		D1Decrypt(offs, nsect + 1, (key - 1) & 0xFFFFFFFF);

	//decrypt each sector into a bounce buffer, explode when smaller than raw
	sec = CAlloc(d1_mpq.sector_size + 16);
	for (s = 0; s < nsect; s++)
	{
		so = offs[s];
		se = offs[s + 1];
		if (se < so || se > packed)
		{
			"D1Mpq: %s sector %d bad offsets\n", name, s;
			Free(sec);
			Free(offs);
			Free(out);
			return NULL;
		}

		expect = unpacked - s * d1_mpq.sector_size;
		if (expect > d1_mpq.sector_size)
			expect = d1_mpq.sector_size;

		MemCopy(sec, raw + so, se - so);
		if (flags & D1MPQ_ENCRYPTED)
			D1Decrypt(sec, (se - so) / 4, (key + s) & 0xFFFFFFFF);

		if (se - so < expect)
		{
			got = D1Explode(sec, se - so, out + s * d1_mpq.sector_size, expect);
			if (got != expect)
			{
				"D1Mpq: %s sector %d explode %d want %d\n", name, s, got, expect;
				Free(sec);
				Free(offs);
				Free(out);
				return NULL;
			}
		}
		else
			MemCopy(out + s * d1_mpq.sector_size, sec, expect);
	}
	Free(sec);
	Free(offs);

	if (size_out)
		*size_out = unpacked;

	return out;
}

U8 *D1MpqReadOrDie(U8 *name, I64 *size_out)
{//missing data files are a setup error worth stopping on
	U8 *p = D1MpqRead(name, size_out);

	if (!p)
	{
		"D1Mpq: MISSING %s\n", name;
		throw('D1MPQ');
	}
	return p;
}
