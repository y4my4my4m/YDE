// D1Mpq.ZC - MPQ v1 archive reader
//
// header: 'MPQ' 0x1A, U32 header_size, U32 archive_size, U16 version,
// U16 block_size_shift, U32 hash_off, U32 block_off, U32 hash_count,
// U32 block_count. sector = 512 << block_size_shift (DIABDAT: 4096).
//
// hash and block tables are encrypted with the Storm cipher, keys
// "(hash table)" / "(block table)" hashed as type 3. hash entry: name_a,
// name_b, locale+platform, block_index. block entry: offset, packed size,
// unpacked size, flags. every DIABDAT file is encrypted (key = uppercased
// basename, type 3), 1752 of 2910 also PKWARE-imploded per sector.
//
// explode transcribed from PKWARE DCL (devilution 3rdParty/PKWare
// explode.cpp). each sector is an independent stream, dictionary <= 4KB.
//
// whole archive stays resident - ZealOS FileRead has no seek. reads hand
// back fresh CAlloc buffers; the resident copy is never written.
//
// differential reference: utils/mpqtool.py extracts the same files on the
// host; sizes and contents must match byte for byte.

#define D1MPQ_IMPLODE		0x00000100
#define D1MPQ_COMPRESS		0x00000200
#define D1MPQ_ENCRYPTED		0x00010000
#define D1MPQ_FIX_KEY		0x00020000
#define D1MPQ_EXISTS		0x80000000

//--- Storm cipher ----------------------------------------------------------

U32	 d1_crypt[0x500];
Bool d1_crypt_ready = FALSE;

U0 D1CryptInit()
{
	I64 seed = 0x00100001;
	I64 i;
	I64 j;
	I64 idx;
	I64 t1;

	for (i = 0; i < 0x100; i++)
	{
		idx = i;
		for (j = 0; j < 5; j++)
		{
			seed = (seed * 125 + 3) % 0x2AAAAB;
			t1   = (seed & 0xFFFF) << 16;
			seed = (seed * 125 + 3) % 0x2AAAAB;
			d1_crypt[idx] = t1 | (seed & 0xFFFF);
			idx += 0x100;
		}
	}
	d1_crypt_ready = TRUE;
}

//hash types: 0 = table slot, 1 = name check A, 2 = name check B, 3 = file key
U32 D1HashStr(U8 *s, I64 htype)
{
	I64 seed1 = 0x7FED7FED;
	I64 seed2 = 0xEEEEEEEE;
	I64 ch;
	I64 i = 0;

	if (!d1_crypt_ready)
		D1CryptInit;

	while (s[i])
	{
		ch = s[i];
		if (ch == '/')
			ch = '\\';
		if (ch >= 'a' && ch <= 'z')
			ch -= 0x20;

		seed1 = (d1_crypt[(htype << 8) + ch] ^ (seed1 + seed2)) & 0xFFFFFFFF;
		seed2 = (ch + seed1 + seed2 + (seed2 << 5) + 3) & 0xFFFFFFFF;
		i++;
	}

	return seed1;
}

U0 D1Decrypt(U32 *v, I64 count, I64 key)
{//in place, U32 stream
	I64 seed = 0xEEEEEEEE;
	I64 i;
	I64 w;
	I64 nk;

	for (i = 0; i < count; i++)
	{
		seed = (seed + d1_crypt[0x400 + (key & 0xFF)]) & 0xFFFFFFFF;
		w    = (v[i] ^ (key + seed)) & 0xFFFFFFFF;
		v[i] = w;

		nk   = ((((~key) & 0xFFFFFFFF) << 0x15) + 0x11111111) & 0xFFFFFFFF;
		key  = (nk | (key >> 0x0B)) & 0xFFFFFFFF;
		seed = (w + seed + (seed << 5) + 3) & 0xFFFFFFFF;
	}
}

//--- PKWARE DCL explode ----------------------------------------------------

