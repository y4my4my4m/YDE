// D1Test.ZC - data-layer self check
//
// expected values come from utils/mpqtool.py against retail DIABDAT.MPQ
// (Diablo + Hellfire CD). byte sums prove decrypt + explode end to end.

I64 d1t_pass = 0;
I64 d1t_fail = 0;

U0 D1TCheck(Bool ok, U8 *what)
{
	if (ok)
	{
		d1t_pass++;
		"  ok   %s\n", what;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s\n", what;
	}
}

U0 D1TFile(U8 *name, I64 want_size, I64 want_sum, U8 *what)
{//want_sum < 0 skips the byte sum
	I64	 size = 0;
	I64	 sum  = 0;
	I64	 i;
	U8	*p    = D1MpqRead(name, &size);

	if (!p)
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: missing\n", what;
		return;
	}
	if (want_sum >= 0)
	{
		for (i = 0; i < size; i++)
			sum += p[i];
		sum &= 0xFFFFFFFF;
	}
	else
		sum = want_sum;

	if (size == want_size && sum == want_sum)
	{
		d1t_pass++;
		"  ok   %s (%d bytes)\n", what, size;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: size %d want %d sum %08X want %08X\n",
			what, size, want_size, sum, want_sum;
	}
	Free(p);
}

I64 D1TSum32(U32 *p, I64 n)
{
	I64 i;
	I64 s = 0;

	for (i = 0; i < n; i++)
		s += p[i];
	return s & 0xFFFFFFFF;
}

I64 D1TS16(U32 v)
{//low channel as a signed 16-bit sample
	I64 x = v & 0xFFFF;

	if (x >= 0x8000)
		x -= 0x10000;
	return x;
}

U0 D1TPcmStats(U32 *p, I64 n, U8 *what)
{//energy and first-difference energy over the left channel. music sits near
 //hf 0.5; white noise near 2.0, because adjacent samples are uncorrelated.
 //this reads the buffer the mixer reads, so it separates a bad decode from
 //a bad hardware path: a clean buffer here means the corruption is downstream.
	I64 i;
	I64 x;
	I64 prev = 0;
	I64 step = 1;
	I64 used = 0;
	F64 e    = 0;
	F64 de   = 0;
	F64 peak = 0;

	if (!p || n < 2)
	{
		"  %s: no pcm\n", what;
		return;
	}
	//sample CONTIGUOUS runs, never a stride: a strided walk decorrelates
	//adjacent reads and reports hf 2.0 for any signal at all.
	I64 blk;
	I64 nblk = 400;
	I64 runl = 512;
	I64 b;
	I64 k;

	if (n < nblk * runl)
	{
		nblk = 1;
		runl = n;
	}
	step = n / nblk;
	for (b = 0; b < nblk; b++)
	{
		i = b * step;
		if (i + runl > n)
			runl = n - i;
		for (k = 0; k < runl; k++)
		{
			x = D1TS16(p[i + k]);
			e += ToF64(x) * x;
			if (k)
				de += ToF64(x - prev) * (x - prev);
			if (x > peak)
				peak = x;
			prev = x;
			used++;
		}
	}
	no_warn blk;
	if (e < 1)
		e = 1;
	"  %s: n=%d rms=%d peak=%d hf=%5.3f\n",
		what, n, ToI64(Sqrt(e / used)), ToI64(peak), de / e;
}

U0 D1TestAudio()
{//playback path, not decode. decode sums are checked in D1Test.
 //
 //the failure this catches: a voice keeps reading PCM after the buffer
 //is freed, so the next decode reuses the memory and the mixer emits
 //whatever landed there. summing a live buffer twice across a sleep
 //detects the scribble without capturing the DMA stream.
	I64 s1;
	I64 s2;
	I64 h;
	I64 i;
	I64 lvls[4];

	d1t_pass = 0;
	d1t_fail = 0;

	"D1Test: audio\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	if (!d1_mpq_ready)
	{
		"$$LTRED$$  FAIL$$FG$$ mount DIABDAT.MPQ\n";
		return;
	}

	D1SndInit;
	D1TCheck(d1snd_on, "AC97 present");
	if (!d1snd_on)
	{
		"  no device; audio checks skipped\n";
		return;
	}

	//generated tones, no decode and no game data: a noisy tone here indicts
	//the mixer or driver with no Diablo code on the path. three arms:
	//stream (ZealAmp's transport), voice at the mixer rate (1:1 step), and
	//voice at 22050 (the fractional step music now uses).
	"  listen: stream tone...\n";
	AC97ToneTest(1200, 440);
	Sleep(1600);
	{
		I64	 tf;
		I64	 tn  = 22050 * 2;
		I64	 sv;
		U32 *tb  = CAlloc(tn * 4, sys_task);
		U32 *tb2 = CAlloc(48000 * 4, sys_task);

		for (tf = 0; tf < tn; tf++)
		{
			sv = ToI64(Sin(2.0 * pi * 440.0 * tf / 22050.0) * 8000.0);
			tb[tf] = (sv & 0xFFFF) | ((sv & 0xFFFF) << 16);
		}
		for (tf = 0; tf < 48000; tf++)
		{
			sv = ToI64(Sin(2.0 * pi * 440.0 * tf / 48000.0) * 8000.0);
			tb2[tf] = (sv & 0xFFFF) | ((sv & 0xFFFF) << 16);
		}
		"  listen: voice tone at 48000...\n";
		tf = D1SndHwPlay(tb2, 48000, 48000, D1SND_SFX_VOL, FALSE);
		Sleep(1400);
		"  listen: voice tone at 22050...\n";
		tf = D1SndHwPlay(tb, tn, 22050, D1SND_SFX_VOL, FALSE);
		Sleep(2400);
		D1SndHwIdle(tf);
		Free(tb);
		Free(tb2);
	}
	"  all three clean = mixer fine, fault is in the data path.\n";
	"  stream clean, voices noisy = the mixer's voice arm.\n";
	"  all noisy = the AC97 driver; retest ZealAmp to confirm.\n";

	//one sfx end to end. a stolen or never-started voice reports idle at once.
	D1SndPlay("Sfx\\Items\\Gold.wav");
	D1TCheck(d1snd_voice[0].handle >= 0, "sfx voice allocated");
	Sleep(1500);

	//pool exhaustion: more concurrent plays than D1SND_VOICES, oldest stolen
	for (i = 0; i < D1SND_VOICES + 4; i++)
		D1SndPlay("Sfx\\Items\\Flippot.wav");
	D1TCheck(TRUE, "sfx pool oversubscribed without fault");
	Sleep(2000);

	//track switching. every level band, then back to town: each switch
	//frees the previous PCM while its voice is still attached.
	lvls[0] = 0;
	lvls[1] = 1;
	lvls[2] = 5;
	lvls[3] = 0;
	for (i = 0; i < 4; i++)
	{
		D1SndMusicForLevel(lvls[i]);
		if (!d1snd_mus_frames)
		{
			d1t_fail++;
			"$$LTRED$$  FAIL$$FG$$ music %d: no PCM\n", lvls[i];
		}
		else
		{
			//hf on the buffer the mixer reads. music ~0.5, white noise ~2.0.
			//a clean reading here puts the fault downstream of the decode.
			D1TPcmStats(d1snd_mus_frames, d1snd_mus_count, "music pcm");
			s1 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
			Sleep(3000);
			s2 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
			if (s1 != s2)
				"    sum %08X -> %08X after 3s\n", s1, s2;
			D1TCheck(s1 == s2, "music buffer stable while playing");
		}
	}

	//sfx over music: the sfx decode must not land on the music PCM
	s1 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
	for (i = 0; i < 6; i++)
	{
		D1SndPlay("Sfx\\Misc\\Walk1.wav");
		Sleep(300);
	}
	s2 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
	D1TCheck(s1 == s2, "music survives sfx allocation");

	//the sfx the game plays most, measured the same way
	i = D1SndCacheLoad("Sfx\\Misc\\Walk1.wav");
	if (i >= 0)
		D1TPcmStats(d1snd_cache[i].frames, d1snd_cache[i].count, "sfx pcm  ");

	//stop while playing: the feeder must leave the buffer before the free
	h = d1snd_mus_handle;
	D1SndMusicStop;
	D1TCheck(d1snd_mus_frames == NULL, "music stop releases PCM");
	D1TCheck(!D1SndHwPlaying(h), "music voice retired before free");

	D1SndStopAll;
	"D1Test audio: %d pass, %d fail\n", d1t_pass, d1t_fail;
	"listen: 4 tracks, ~3s each, then footsteps over the last one.\n";
}

U0 D1Test()
{
	U8	*p;
	I64	 size = 0;
	I64	 sum;
	I64	 i;
	I64	 rate2  = 0;
	I64	 count2 = 0;
	I64	 rcount = 0;
	U32	*fr = NULL;
	U32	*rs;

	d1t_pass = 0;
	d1t_fail = 0;

	"D1Test: data layer\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	D1TCheck(d1_mpq_ready, "mount DIABDAT.MPQ");
	if (!d1_mpq_ready)
		return;

	D1TCheck(d1_mpq.hash_count == 4096 && d1_mpq.block_count == 2911,
		"table sizes");

	//byte sums prove the whole decrypt + explode path
	D1TFile("Levels\\TownData\\Town.CEL", 2176004, 0x0B645232, "Town.CEL");
	D1TFile("CtrlPan\\SmalText.CEL", 4419, 0x000D51F8, "SmalText.CEL");
	D1TFile("Levels\\TownData\\Town.MIN", 40256, -1, "Town.MIN");
	D1TFile("Levels\\TownData\\Town.SOL", 1258, -1, "Town.SOL");
	D1TFile("Levels\\TownData\\Town.TIL", 2736, -1, "Town.TIL");
	D1TFile("Levels\\TownData\\Town.pal", 768, -1, "Town.pal");
	D1TFile("Gendata\\Cuttt.CEL", 310092, -1, "Cuttt.CEL");
	//flat-stored (no implode) multi-sector file: per-sector decrypt proof.
	//one-stream decrypt gets sector 0 right and noise after, which this
	//byte sum catches and a header check does not.
	D1TFile("Music\\DTowne.wav", 25457728, 0xBB303A6D, "DTowne per-sector decrypt");

	p = D1MpqRead("Levels\\TownData\\Town.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 3547, "Town.CEL frame count 3547");
		Free(p);
	}
	p = D1MpqRead("Data\\PentSpin.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 8, "PentSpin 8 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlsst.cl2", &size);
	if (p)
	{
		D1TCheck(size == 179011, "wlsst.cl2 size");
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 20, "town stand 20 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlswl.cl2", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 8, "town walk 8 frames");
		Free(p);
	}

	D1TCheck(D1TownLoad(), "town assembly");
	if (d1_lvl_ready)
	{
		D1TCheck(d1_npieces == 1258, "1258 town pieces");
		D1TCheck(D1Piece(75, 68) != 0, "spawn tile has a piece");
		D1TCheck(D1Walkable(75, 68), "spawn tile walkable");
	}

	//light table is pure index math; sum from the host harness
	D1MakeLightTable;
	sum = 0;
	for (i = 0; i < 16 * 256; i++)
		sum += d1_light_tbl[i];
	D1TCheck(sum == 0x43FB8, "light table checksum");

	//dungeon generation determinism
	D1TCheck(D1L1LevelLoad(1, 1234567, 0), "cathedral L1 gen");
	if (d1_lvl_ready)
	{
		sum = 0;
		for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
			sum = (sum * 31 + d1_dpiece[i]) & 0xFFFFFFFF;
		D1TCheck(sum == 0x5D4480D2, "L1 seed 1234567 layout matches host");
		D1TCheck(d1_trig_up_x >= 0 && d1_trig_down_x >= 0, "both stairs present");
		D1TCheck(D1Walkable(d1_lvl_vx, d1_lvl_vy), "entry view walkable");
	}

	D1MonTypesInit;
	D1TCheck(D1MonTypeLoad(0), "zombie gfx");
	D1TCheck(D1MonTypeLoad(1), "fallen gfx + TRN");

	//audio decode vs host reference sums; a mismatch means the WAV/PCM
	//path corrupts in-guest and the mixer is innocent
	p = D1MpqRead("Music\\Dintro.wav", &size);
	if (p)
	{
		count2 = D1SndDecodeNative(p, size, &fr, &rate2);
		Free(p);
		D1TCheck(count2 == 2037085 && rate2 == 22050, "Dintro decode dims");
		if (fr)
		{
			sum = 0;
			for (i = 0; i < count2; i++)
				sum += fr[i];
			D1TCheck((sum & 0xFFFFFFFF) == 0x81628961, "Dintro PCM sum");
			rs = D1SndResample48(fr, count2, rate2, &rcount);
			if (rs)
			{
				sum = 0;
				for (i = 0; i < rcount; i++)
					sum += rs[i];
				D1TCheck(rcount == 4434470 &&
					(sum & 0xFFFFFFFF) == 0x684C0C4A, "Dintro 48k sum");
				Free(rs);
			}
			Free(fr);
		}
	}

	"D1Test: %d pass, %d fail\n", d1t_pass, d1t_fail;
	"NOTE: D1Test leaves cathedral L1 loaded; run Diablo1; for the game.\n";
	"Type $$LTBLUE$$D1TestLockstep;$$FG$$ for the two-peer determinism harness.\n";
}

#define D1LS_TURNS	40

Bool D1TestLockstepSetup(I64 seed, I64 *x0, I64 *y0, I64 *x1, I64 *y1)
{//identical call sequence both passes: same dungeon, same monsters, same
 //sim seed at the first command.
	D1CharCreate(D1CL_WARRIOR, "Peer0");
	D1MonClearAll;
	D1MisClear;
	D1ItemClear;
	D1ObjClear;

	if (!D1L1LevelLoad(1, seed, 0))
		return FALSE;

	*x0 = d1_lvl_vx;
	*y0 = d1_lvl_vy;
	*x1 = *x0 + 3;
	*y1 = *y0;
	if (!D1Walkable(*x1, *y1))
	{
		*x1 = *x0;
		*y1 = *y0 + 3;
	}
	if (!D1Walkable(*x1, *y1))
	{
		*x1 = *x0 + 1;
		*y1 = *y0 + 1;
	}

	D1PlacePlayer(*x0, *y0);
	D1MonSpawnLevel(1, *x0, *y0);
	D1ObjSpawnLevel(1);

	D1NetReset;
	d1_net_on      = TRUE;
	d1_net_state   = D1NS_PLAY;
	d1_net_self    = 0;
	d1_net_npeers  = 2;
	d1_net_turn    = 0;
	d1_net_tick    = 0;
	d1_net_gameseed = seed;
	d1_net_simseed  = d1_seed;		//whatever Mon/Obj spawn left
	d1_net_insim    = FALSE;

	D1PeerFill(0, TRUE,  "Peer0", *x0, *y0);
	D1PeerFill(1, FALSE, "Peer1", *x1, *y1);
	d1_plr_hp    = d1_peers[0].hp;
	d1_plr_maxhp = d1_peers[0].maxhp;
	d1_plr_mana  = d1_peers[0].mana;
	d1_plr_dead  = FALSE;
	return TRUE;
}

U0 D1TestLockstep()
{//two full passes over the same absolute command stream. any divergence in
 //peer position, monster HP, drops or the RNG counter fails with the turn.
	I64 h1[D1LS_TURNS];
	I64 h2[D1LS_TURNS];
	I64 x0;
	I64 y0;
	I64 x1;
	I64 y1;
	I64 i;
	I64 bad;

	d1t_pass = 0;
	d1t_fail = 0;

	"D1TestLockstep: two-peer determinism\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	D1TCheck(d1_mpq_ready, "mount DIABDAT.MPQ");
	if (!d1_mpq_ready)
		return;

	//sfx off: D1SndRnd2 is a separate stream, but playing during a
	//headless harness is just noise
	d1_opt_sfx = FALSE;

	D1TCheck(D1TestLockstepSetup(1234567, &x0, &y0, &x1, &y1), "setup pass A");
	if (d1t_fail)
		return;
	D1PeerSimRun(h1, D1LS_TURNS, x0, y0, x1, y1);

	D1TCheck(D1TestLockstepSetup(1234567, &x0, &y0, &x1, &y1), "setup pass B");
	if (d1t_fail)
		return;
	D1PeerSimRun(h2, D1LS_TURNS, x0, y0, x1, y1);

	bad = -1;
	for (i = 0; i < D1LS_TURNS; i++)
	{
		if (h1[i] != h2[i])
		{
			bad = i;
			break;
		}
	}
	if (bad >= 0)
	{
		"D1TestLockstep DIVERGED at turn %d (0x%X vs 0x%X)\n",
			bad, h1[bad], h2[bad];
		D1TCheck(FALSE, "lockstep hashes match");
	}
	else
		D1TCheck(TRUE, "lockstep hashes match over 40 turns");

	d1_net_on = FALSE;
	D1NetReset;

	"D1TestLockstep: %d pass, %d fail\n", d1t_pass, d1t_fail;
}
