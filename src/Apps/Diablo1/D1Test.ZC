// D1Test.ZC - data-layer self check
//
// expected values come from utils/mpqtool.py against retail DIABDAT.MPQ
// (Diablo + Hellfire CD). byte sums prove decrypt + explode end to end.

I64 d1t_pass = 0;
I64 d1t_fail = 0;

U0 D1TCheck(Bool ok, U8 *what)
{
	if (ok)
	{
		d1t_pass++;
		"  ok   %s\n", what;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s\n", what;
	}
}

U0 D1TFile(U8 *name, I64 want_size, I64 want_sum, U8 *what)
{//want_sum < 0 skips the byte sum
	I64	 size = 0;
	I64	 sum  = 0;
	I64	 i;
	U8	*p    = D1MpqRead(name, &size);

	if (!p)
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: missing\n", what;
		return;
	}
	if (want_sum >= 0)
	{
		for (i = 0; i < size; i++)
			sum += p[i];
		sum &= 0xFFFFFFFF;
	}
	else
		sum = want_sum;

	if (size == want_size && sum == want_sum)
	{
		d1t_pass++;
		"  ok   %s (%d bytes)\n", what, size;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: size %d want %d sum %08X want %08X\n",
			what, size, want_size, sum, want_sum;
	}
	Free(p);
}

I64 D1TSum32(U32 *p, I64 n)
{
	I64 i;
	I64 s = 0;

	for (i = 0; i < n; i++)
		s += p[i];
	return s & 0xFFFFFFFF;
}

U0 D1TestAudio()
{//playback path, not decode. decode sums are checked in D1Test.
 //
 //the failure this catches: a voice keeps reading PCM after the buffer
 //is freed, so the next decode reuses the memory and the mixer emits
 //whatever landed there. summing a live buffer twice across a sleep
 //detects the scribble without capturing the DMA stream.
	I64 s1;
	I64 s2;
	I64 h;
	I64 i;
	I64 lvls[4];

	d1t_pass = 0;
	d1t_fail = 0;

	"D1Test: audio\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	if (!d1_mpq_ready)
	{
		"$$LTRED$$  FAIL$$FG$$ mount DIABDAT.MPQ\n";
		return;
	}

	D1SndInit;
	D1TCheck(d1snd_on, "AC97 present");
	if (!d1snd_on)
	{
		"  no device; audio checks skipped\n";
		return;
	}

	//one sfx end to end. a stolen or never-started voice reports idle at once.
	D1SndPlay("Sfx\\Items\\Gold.wav");
	D1TCheck(d1snd_voice[0].handle >= 0, "sfx voice allocated");
	Sleep(1500);

	//pool exhaustion: more concurrent plays than D1SND_VOICES, oldest stolen
	for (i = 0; i < D1SND_VOICES + 4; i++)
		D1SndPlay("Sfx\\Items\\Flippot.wav");
	D1TCheck(TRUE, "sfx pool oversubscribed without fault");
	Sleep(2000);

	//track switching. every level band, then back to town: each switch
	//frees the previous PCM while its voice is still attached.
	lvls[0] = 0;
	lvls[1] = 1;
	lvls[2] = 5;
	lvls[3] = 0;
	for (i = 0; i < 4; i++)
	{
		D1SndMusicForLevel(lvls[i]);
		if (!d1snd_mus_frames)
		{
			d1t_fail++;
			"$$LTRED$$  FAIL$$FG$$ music %d: no PCM\n", lvls[i];
		}
		else
		{
			s1 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
			Sleep(3000);
			s2 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
			D1TCheck(s1 == s2 && d1snd_mus_handle >= 0,
				"music buffer stable while playing");
		}
	}

	//sfx over music: the sfx decode must not land on the music PCM
	s1 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
	for (i = 0; i < 6; i++)
	{
		D1SndPlay("Sfx\\Misc\\Walk1.wav");
		Sleep(300);
	}
	s2 = D1TSum32(d1snd_mus_frames, d1snd_mus_count);
	D1TCheck(s1 == s2, "music survives sfx allocation");

	//stop while playing: D1SndHwIdle must retire the voice before the free
	h = d1snd_mus_handle;
	D1SndMusicStop;
	D1TCheck(d1snd_mus_frames == NULL && d1snd_mus_handle < 0,
		"music stop releases PCM");
	D1TCheck(!D1SndHwPlaying(h), "music voice retired before free");

	D1SndStopAll;
	"D1Test audio: %d pass, %d fail\n", d1t_pass, d1t_fail;
	"listen: 4 tracks, ~3s each, then footsteps over the last one.\n";
}

U0 D1Test()
{
	U8	*p;
	I64	 size = 0;
	I64	 sum;
	I64	 i;
	I64	 rate2  = 0;
	I64	 count2 = 0;
	I64	 rcount = 0;
	U32	*fr = NULL;
	U32	*rs;

	d1t_pass = 0;
	d1t_fail = 0;

	"D1Test: data layer\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	D1TCheck(d1_mpq_ready, "mount DIABDAT.MPQ");
	if (!d1_mpq_ready)
		return;

	D1TCheck(d1_mpq.hash_count == 4096 && d1_mpq.block_count == 2911,
		"table sizes");

	//byte sums prove the whole decrypt + explode path
	D1TFile("Levels\\TownData\\Town.CEL", 2176004, 0x0B645232, "Town.CEL");
	D1TFile("CtrlPan\\SmalText.CEL", 4419, 0x000D51F8, "SmalText.CEL");
	D1TFile("Levels\\TownData\\Town.MIN", 40256, -1, "Town.MIN");
	D1TFile("Levels\\TownData\\Town.SOL", 1258, -1, "Town.SOL");
	D1TFile("Levels\\TownData\\Town.TIL", 2736, -1, "Town.TIL");
	D1TFile("Levels\\TownData\\Town.pal", 768, -1, "Town.pal");
	D1TFile("Gendata\\Cuttt.CEL", 310092, -1, "Cuttt.CEL");

	p = D1MpqRead("Levels\\TownData\\Town.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 3547, "Town.CEL frame count 3547");
		Free(p);
	}
	p = D1MpqRead("Data\\PentSpin.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 8, "PentSpin 8 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlsst.cl2", &size);
	if (p)
	{
		D1TCheck(size == 179011, "wlsst.cl2 size");
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 20, "town stand 20 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlswl.cl2", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 8, "town walk 8 frames");
		Free(p);
	}

	D1TCheck(D1TownLoad(), "town assembly");
	if (d1_lvl_ready)
	{
		D1TCheck(d1_npieces == 1258, "1258 town pieces");
		D1TCheck(D1Piece(75, 68) != 0, "spawn tile has a piece");
		D1TCheck(D1Walkable(75, 68), "spawn tile walkable");
	}

	//light table is pure index math; sum from the host harness
	D1MakeLightTable;
	sum = 0;
	for (i = 0; i < 16 * 256; i++)
		sum += d1_light_tbl[i];
	D1TCheck(sum == 0x43FB8, "light table checksum");

	//dungeon generation determinism
	D1TCheck(D1L1LevelLoad(1, 1234567, 0), "cathedral L1 gen");
	if (d1_lvl_ready)
	{
		sum = 0;
		for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
			sum = (sum * 31 + d1_dpiece[i]) & 0xFFFFFFFF;
		D1TCheck(sum == 0x5D4480D2, "L1 seed 1234567 layout matches host");
		D1TCheck(d1_trig_up_x >= 0 && d1_trig_down_x >= 0, "both stairs present");
		D1TCheck(D1Walkable(d1_lvl_vx, d1_lvl_vy), "entry view walkable");
	}

	D1MonTypesInit;
	D1TCheck(D1MonTypeLoad(0), "zombie gfx");
	D1TCheck(D1MonTypeLoad(1), "fallen gfx + TRN");

	//audio decode vs host reference sums; a mismatch means the WAV/PCM
	//path corrupts in-guest and the mixer is innocent
	p = D1MpqRead("Music\\Dintro.wav", &size);
	if (p)
	{
		count2 = D1SndDecodeNative(p, size, &fr, &rate2);
		Free(p);
		D1TCheck(count2 == 2037085 && rate2 == 22050, "Dintro decode dims");
		if (fr)
		{
			sum = 0;
			for (i = 0; i < count2; i++)
				sum += fr[i];
			D1TCheck((sum & 0xFFFFFFFF) == 0xA55ED17F, "Dintro PCM sum");
			rs = D1SndResample48(fr, count2, rate2, &rcount);
			if (rs)
			{
				sum = 0;
				for (i = 0; i < rcount; i++)
					sum += rs[i];
				D1TCheck(rcount == 4434470 &&
					(sum & 0xFFFFFFFF) == 0x4169FC32, "Dintro 48k sum");
				Free(rs);
			}
			Free(fr);
		}
	}

	"D1Test: %d pass, %d fail\n", d1t_pass, d1t_fail;
	"NOTE: D1Test leaves cathedral L1 loaded; run Diablo1; for the game.\n";
}
