// D1Test.ZC - data-layer self check
//
// expected values come from utils/mpqtool.py against retail DIABDAT.MPQ
// (Diablo + Hellfire CD). byte sums prove decrypt + explode end to end.

I64 d1t_pass = 0;
I64 d1t_fail = 0;

U0 D1TCheck(Bool ok, U8 *what)
{
	if (ok)
	{
		d1t_pass++;
		"  ok   %s\n", what;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s\n", what;
	}
}

U0 D1TFile(U8 *name, I64 want_size, I64 want_sum, U8 *what)
{//want_sum < 0 skips the byte sum
	I64	 size = 0;
	I64	 sum  = 0;
	I64	 i;
	U8	*p    = D1MpqRead(name, &size);

	if (!p)
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: missing\n", what;
		return;
	}
	if (want_sum >= 0)
	{
		for (i = 0; i < size; i++)
			sum += p[i];
		sum &= 0xFFFFFFFF;
	}
	else
		sum = want_sum;

	if (size == want_size && sum == want_sum)
	{
		d1t_pass++;
		"  ok   %s (%d bytes)\n", what, size;
	}
	else
	{
		d1t_fail++;
		"$$LTRED$$  FAIL$$FG$$ %s: size %d want %d sum %08X want %08X\n",
			what, size, want_size, sum, want_sum;
	}
	Free(p);
}

U0 D1Test()
{
	U8	*p;
	I64	 size = 0;
	I64	 sum;
	I64	 i;

	d1t_pass = 0;
	d1t_fail = 0;

	"D1Test: data layer\n";

	if (!d1_mpq_ready)
		D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ");
	D1TCheck(d1_mpq_ready, "mount DIABDAT.MPQ");
	if (!d1_mpq_ready)
		return;

	D1TCheck(d1_mpq.hash_count == 4096 && d1_mpq.block_count == 2911,
		"table sizes");

	//byte sums prove the whole decrypt + explode path
	D1TFile("Levels\\TownData\\Town.CEL", 2176004, 0x0B645232, "Town.CEL");
	D1TFile("CtrlPan\\SmalText.CEL", 4419, 0x000D51F8, "SmalText.CEL");
	D1TFile("Levels\\TownData\\Town.MIN", 40256, -1, "Town.MIN");
	D1TFile("Levels\\TownData\\Town.SOL", 1258, -1, "Town.SOL");
	D1TFile("Levels\\TownData\\Town.TIL", 2736, -1, "Town.TIL");
	D1TFile("Levels\\TownData\\Town.pal", 768, -1, "Town.pal");
	D1TFile("Gendata\\Cuttt.CEL", 310092, -1, "Cuttt.CEL");

	p = D1MpqRead("Levels\\TownData\\Town.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 3547, "Town.CEL frame count 3547");
		Free(p);
	}
	p = D1MpqRead("Data\\PentSpin.CEL", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(p) == 8, "PentSpin 8 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlsst.cl2", &size);
	if (p)
	{
		D1TCheck(size == 179011, "wlsst.cl2 size");
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 20, "town stand 20 frames");
		Free(p);
	}
	p = D1MpqRead("PlrGFX\\Warrior\\wls\\wlswl.cl2", &size);
	if (p)
	{
		D1TCheck(D1CelNFrames(D1Cl2Dir(p, 0)) == 8, "town walk 8 frames");
		Free(p);
	}

	D1TCheck(D1TownLoad(), "town assembly");
	if (d1_lvl_ready)
	{
		D1TCheck(d1_npieces == 1258, "1258 town pieces");
		D1TCheck(D1Piece(75, 68) != 0, "spawn tile has a piece");
		D1TCheck(D1Walkable(75, 68), "spawn tile walkable");
	}

	//light table is pure index math; sum from the host harness
	D1MakeLightTable;
	sum = 0;
	for (i = 0; i < 16 * 256; i++)
		sum += d1_light_tbl[i];
	D1TCheck(sum == 0x43FB8, "light table checksum");

	//dungeon generation determinism
	D1TCheck(D1L1LevelLoad(1, 1234567, 0), "cathedral L1 gen");
	if (d1_lvl_ready)
	{
		sum = 0;
		for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
			sum = (sum * 31 + d1_dpiece[i]) & 0xFFFFFFFF;
		D1TCheck(sum == 0x5D4480D2, "L1 seed 1234567 layout matches host");
		D1TCheck(d1_trig_up_x >= 0 && d1_trig_down_x >= 0, "both stairs present");
		D1TCheck(D1Walkable(d1_lvl_vx, d1_lvl_vy), "entry view walkable");
	}

	D1MonTypesInit;
	D1TCheck(D1MonTypeLoad(0), "zombie gfx");
	D1TCheck(D1MonTypeLoad(1), "fallen gfx + TRN");

	"D1Test: %d pass, %d fail\n", d1t_pass, d1t_fail;
	"NOTE: D1Test leaves cathedral L1 loaded; run Diablo1; for the game.\n";
}
