// D1Save.ZC - character save slots
//
// no on-disk compatibility with the original .SV files; this is the port's
// own format. three slots, ::/Apps/Diablo1/SAVE0.DAT .. SAVE2.DAT. ZealOS
// FileRead rejects names holding spaces, & or ~, so slot names stay in
// [A-Z0-9_.].
//
// every field is written byte by byte, little endian. ZealC postfix casts
// are no-ops, so no struct is ever overlaid on the buffer.
//
// header, 64 bytes, self-sufficient for the slot list:
//    0   4  magic "D1SV"
//    4   2  version, 1
//    6   2  header length, 64
//    8  32  character name, NUL padded
//   40   4  class
//   44   4  character level
//   48   4  dungeon level
//   52   4  body length, 668
//   56   4  body checksum, sum of body bytes mod 2^32
//   60   4  zero
//
// body, 668 bytes, from offset 64. every entry is 4 bytes, two's complement:
//   +0    exp
//   +4    str
//   +8    mag
//   +12   dex
//   +16   vit
//   +20   unspent attribute points
//   +24   hp        (64ths)
//   +28   maxhp     (64ths)
//   +32   mana      (64ths)
//   +36   maxmana   (64ths)
//   +40   gold
//   +44   player tile x
//   +48   player tile y
//   +52   diablo slain flag
//   +56   17 dungeon seeds, level 0 first
//   +124  40 inventory grid cells   (0 free, +e+1 anchor, -(e+1) covered)
//   +284  40 inventory entry base rows (-1 free)
//   +444  40 inventory entry values
//   +604  4 equipped base rows (-1 empty)
//   +620  4 equipped values
//   +636  8 belt base rows (0 empty)
//
// hp/mana are stored in the 64ths the rest of the port uses. the seeds carry
// the whole dungeon: a restored game regenerates identical levels.

#define D1_SAVE_SLOTS	3
#define D1_SAVE_VER		1
#define D1_SAVE_HDR		64
#define D1_SAVE_BODY	668
#define D1_SAVE_LEN		732

U8 d1_save_path[64];

U8 *D1SavePath(I64 slot)
{//shared buffer; one call live at a time
	StrPrint(d1_save_path, "::/Apps/Diablo1/SAVE%d.DAT", slot);
	return d1_save_path;
}

U0 D1SaveWrU16(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
}

U0 D1SaveWrU32(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
	p[off + 2] = (v >> 16) & 0xFF;
	p[off + 3] = (v >> 24) & 0xFF;
}

I64 D1SaveSum(U8 *p, I64 off, I64 len)
{//body checksum, mod 2^32
	I64 i;
	I64 s = 0;

	for (i = 0; i < len; i++)
		s = (s + p[off + i]) & 0xFFFFFFFF;
	return s;
}

Bool D1SaveHdrOk(U8 *p, I64 size)
{
	if (size < D1_SAVE_LEN)
		return FALSE;
	if (p[0] != 'D' || p[1] != '1' || p[2] != 'S' || p[3] != 'V')
		return FALSE;
	if (D1RdU16(p + 4) != D1_SAVE_VER)
		return FALSE;
	if (D1RdU16(p + 6) != D1_SAVE_HDR)
		return FALSE;
	if (D1RdI32(p + 52) != D1_SAVE_BODY)
		return FALSE;
	if (D1RdU32(p + 56) != D1SaveSum(p, D1_SAVE_HDR, D1_SAVE_BODY))
		return FALSE;
	return TRUE;
}

Bool D1SaveWrite(I64 slot)
{
	U8	*buf;
	I64	 o;
	I64	 i;
	I64	 res;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	buf = CAlloc(D1_SAVE_LEN);
	if (!buf)
		return FALSE;

	buf[0] = 'D';
	buf[1] = '1';
	buf[2] = 'S';
	buf[3] = 'V';
	D1SaveWrU16(buf, 4, D1_SAVE_VER);
	D1SaveWrU16(buf, 6, D1_SAVE_HDR);
	D1StrCopy(buf + 8, d1_plr_name, 32);
	D1SaveWrU32(buf, 40, d1_plr_class);
	D1SaveWrU32(buf, 44, d1_plr_lvl);
	D1SaveWrU32(buf, 48, d1_currlevel);
	D1SaveWrU32(buf, 52, D1_SAVE_BODY);

	o = D1_SAVE_HDR;
	D1SaveWrU32(buf, o, d1_plr_exp);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_str);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_mag);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_dex);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_vit);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_pts);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_hp);			o += 4;
	D1SaveWrU32(buf, o, d1_plr_maxhp);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_mana);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_maxmana);	o += 4;
	D1SaveWrU32(buf, o, d1_plr_gold);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_x);			o += 4;
	D1SaveWrU32(buf, o, d1_plr_y);			o += 4;
	D1SaveWrU32(buf, o, d1_diablo_slain);	o += 4;

	for (i = 0; i < 17; i++)
	{
		D1SaveWrU32(buf, o, d1_lvl_seeds[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_grid[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_itm[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_val[i]);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrU32(buf, o, d1_equip_itm[i]);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrU32(buf, o, d1_equip_val[i]);
		o += 4;
	}
	for (i = 0; i < 8; i++)
	{
		D1SaveWrU32(buf, o, d1_belt[i]);
		o += 4;
	}

	D1SaveWrU32(buf, 56, D1SaveSum(buf, D1_SAVE_HDR, D1_SAVE_BODY));

	res = FileWrite(D1SavePath(slot), buf, D1_SAVE_LEN);
	Free(buf);
	return res != 0;
}

Bool D1SaveRead(I64 slot)
{//restores the globals; the caller still has to load the dungeon
	U8	*buf;
	I64	 size = 0;
	I64	 o;
	I64	 i;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (!FileFind(D1SavePath(slot)))
		return FALSE;
	buf = FileRead(D1SavePath(slot), &size);
	if (!buf)
		return FALSE;
	if (!D1SaveHdrOk(buf, size))
	{
		Free(buf);
		return FALSE;
	}

	//item tables must exist before the inventory arrays are overwritten;
	//a later D1ItemInit would otherwise wipe them
	D1ItemInit;

	D1StrCopy(d1_plr_name, buf + 8, 32);
	d1_plr_class = D1RdI32(buf + 40);
	d1_plr_lvl   = D1RdI32(buf + 44);
	d1_currlevel = D1RdI32(buf + 48);

	o = D1_SAVE_HDR;
	d1_plr_exp     = D1RdI32(buf + o);	o += 4;
	d1_plr_str     = D1RdI32(buf + o);	o += 4;
	d1_plr_mag     = D1RdI32(buf + o);	o += 4;
	d1_plr_dex     = D1RdI32(buf + o);	o += 4;
	d1_plr_vit     = D1RdI32(buf + o);	o += 4;
	d1_plr_pts     = D1RdI32(buf + o);	o += 4;
	d1_plr_hp      = D1RdI32(buf + o);	o += 4;
	d1_plr_maxhp   = D1RdI32(buf + o);	o += 4;
	d1_plr_mana    = D1RdI32(buf + o);	o += 4;
	d1_plr_maxmana = D1RdI32(buf + o);	o += 4;
	d1_plr_gold    = D1RdI32(buf + o);	o += 4;
	d1_plr_x       = D1RdI32(buf + o);	o += 4;
	d1_plr_y       = D1RdI32(buf + o);	o += 4;
	d1_diablo_slain = D1RdI32(buf + o) != 0;
	o += 4;

	d1_plr_tile_x = d1_plr_x;
	d1_plr_tile_y = d1_plr_y;

	for (i = 0; i < 17; i++)
	{
		d1_lvl_seeds[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_itm[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_val[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_val[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < 8; i++)
	{
		d1_belt[i] = D1RdI32(buf + o);
		o += 4;
	}

	//the restored seeds are the dungeon; D1PlayInit must not reroll them
	d1_seeds_init = TRUE;
	d1_plr_dead   = FALSE;
	d1_plr_hitflash = 0;

	Free(buf);
	return TRUE;
}

Bool D1SaveProbe(I64 slot, U8 *name_out, I64 *cls_out, I64 *lvl_out)
{//header only; the slot list never pays for a full load
	U8	*buf;
	I64	 size = 0;
	Bool ok;

	if (name_out)
		name_out[0] = 0;
	if (cls_out)
		*cls_out = 0;
	if (lvl_out)
		*lvl_out = 0;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (!FileFind(D1SavePath(slot)))
		return FALSE;
	buf = FileRead(D1SavePath(slot), &size);
	if (!buf)
		return FALSE;

	ok = D1SaveHdrOk(buf, size);
	if (ok)
	{
		if (name_out)
			D1StrCopy(name_out, buf + 8, 32);
		if (cls_out)
			*cls_out = D1RdI32(buf + 40);
		if (lvl_out)
			*lvl_out = D1RdI32(buf + 44);
	}
	Free(buf);
	return ok;
}

U0 D1SaveDelete(I64 slot)
{
	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return;
	if (FileFind(D1SavePath(slot)))
		Del(D1SavePath(slot), FALSE, FALSE, FALSE);
}

U0 D1SaveResetState()
{//fresh-character world state: empty pack, unrolled seeds, town
	I64 i;

	D1ItemInit;
	D1ItemClear;
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = 0;
		d1_inv_itm[i]  = -1;
		d1_inv_val[i]  = 0;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = -1;
		d1_equip_val[i] = 0;
	}
	for (i = 0; i < 8; i++)
		d1_belt[i] = 0;

	d1_currlevel    = 0;
	d1_diablo_slain = FALSE;
	d1_plr_dead     = FALSE;
	d1_plr_hitflash = 0;
	d1_seeds_init   = FALSE;		//D1PlayInit rolls a new dungeon
}
