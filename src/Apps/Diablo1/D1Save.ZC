// character save slots
//
// no on-disk compatibility with the original .SV files; this is the port's
// own format. three slots, ::/Apps/Diablo1/SAVE0.DAT .. SAVE2.DAT. ZealOS
// FileRead rejects names holding spaces, & or ~, so slot names stay in
// [A-Z0-9_.].
//
// every field is written byte by byte, little endian. ZealC postfix casts
// are no-ops, so no struct is ever overlaid on the buffer.
//
// six versions read, version 6 written. version 1 bodies are 668 bytes and
// carry no per-item state, no unique bitmap, no quest, spell or depth state;
// version 5 adds spell levels 19+ after the affix tail; version 6 adds the
// cursor item (loadsave.cpp SavePlayer writes _pHoldItem).
// version 2 bodies are 2392 and carry no staff charges; version 3 bodies are
// 2920 and carry no affix rolls. D1SaveRead fills what is missing with the
// defaults listed below.
//
// header, 64 bytes, self-sufficient for the slot list:
//    0   4  magic "D1SV"
//    4   2  version, 1 to 6
//    6   2  header length, 64
//    8  32  character name, NUL padded
//   40   4  class
//   44   4  character level
//   48   4  dungeon level
//   52   4  body length, 668 / 2392 / 2920 / 3624 / 3676 / 3748 by version
//   56   4  body checksum, sum of body bytes mod 2^32
//   60   4  zero
//
// body, from offset 64. every entry is 4 bytes, two's complement.
// version 1 stops after the belt at +668; version 2 continues to +2392;
// version 3 keeps every version 2 offset and adds a charge tail to +2920;
// version 4 keeps every version 3 offset and adds an affix-roll tail:
//   +0    exp
//   +4    str
//   +8    mag
//   +12   dex
//   +16   vit
//   +20   unspent attribute points
//   +24   hp        (64ths)
//   +28   maxhp     (64ths)
//   +32   mana      (64ths)
//   +36   maxmana   (64ths)
//   +40   gold
//   +44   player tile x
//   +48   player tile y
//   +52   diablo slain flag
//   +56   17 dungeon seeds, level 0 first
//   +124  40 inventory grid cells   (0 free, +e+1 anchor, -(e+1) covered)
//   +284  40 inventory entry base rows (-1 free)
//   +444  40 inventory entry values
//   +604  4 equipped base rows (-1 empty)
//   +620  4 equipped values
//   +636  8 belt base rows (0 empty)
//   +668  40 inventory item states, 36 bytes each
//   +2108 4 equipped item states, 36 bytes each
//   +2252 unique-taken bitmap, bit u = unique u already dropped
//   +2256 13 quest states (D1QS_*)
//   +2308 19 spell levels
//   +2384 selected spell
//   +2388 deepest dungeon level entered
//   +2392 44 charge records, 12 bytes each: 40 inventory then 4 equipped
//   +2920 44 affix-roll records, 16 bytes each: 40 inventory then 4 equipped
//   +3624 13 spell levels, D1_NSPL_CORE .. D1_NSPELL-1
//   +3676 cursor item base row (-1 empty)
//   +3680 cursor item value
//   +3684 cursor item state, 36 bytes
//   +3720 cursor charge record, 12 bytes
//   +3732 cursor affix-roll record, 16 bytes
//   +3748 end
//
// one item state is 36 bytes, the whole of CD1ItmSt bar the charge and roll
// fields:
//   +0  prefix id + 1      +4  suffix id + 1     +8  unique id + 1
//   +12 identified flag    +16 durability        +20 max durability
//   +24 IPL_INVCURS frame  +28 IPL_NOMINSTR      +32 IPL_ONEHAND
//
// one charge record is 12 bytes:
//   +0  spell id + 1       +4  charges           +8  max charges
//
// one affix-roll record is 16 bytes, the SaveItemPower roll per affix side:
//   +0  prefix roll        +4  suffix roll
//   +8  prefix to-hit roll +12 suffix to-hit roll   (IPL_TOHIT_DAMP band)
//
//
// ground item state (d1_st_ground) is not saved.
//
// version 1 defaults: every item plain, unidentified, durability and max
// durability from its base row; no unique taken; every quest D1QS_AVAIL; every
// spell level 1 with Firebolt selected; deepest level = the saved dungeon
// level. versions 1 and 2: no item carries a spell or charges. versions 2 and
// 3: affix rolls read as the range midpoint (D1AffixValMid), saved durability
// kept as written. versions 1 to 5: empty cursor.
//
// hp/mana are stored in the 64ths the rest of the port uses. the seeds carry
// the whole dungeon; SAVE*.LV keeps per-level object/item state.

#define D1_SAVE_SLOTS	3
#define D1_SAVE_VER		6
#define D1_SAVE_HDR		64
#define D1_SAVE_BODY1	668
#define D1_SAVE_BODY2	2392
#define D1_SAVE_BODY3	2920
#define D1_SAVE_BODY4	3624
#define D1_SAVE_BODY5	3676
#define D1_SAVE_BODY6	3748
#define D1_SAVE_LEN		3812
#define D1_NSPL_CORE	19
#define D1_SO_SPLEXT	3624

//body offsets of the version 2 tail
#define D1_SAVE_STLEN	36
#define D1_SO_STINV		668
#define D1_SO_STEQ		2108
#define D1_SO_UNQ		2252
#define D1_SO_QUEST		2256
#define D1_SO_SPLVL		2308
#define D1_SO_SPSEL		2384
#define D1_SO_DEEP		2388

//version 3 charge tail
#define D1_SAVE_CHLEN	12
#define D1_SO_CHINV		2392
#define D1_SO_CHEQ		2872

//version 4 affix-roll tail
#define D1_SAVE_AVLEN	16
#define D1_SO_AVINV		2920
#define D1_SO_AVEQ		3560

//version 6 cursor tail: loadsave.cpp SavePlayer _pHoldItem
#define D1_SO_HOLDITM	3676
#define D1_SO_HOLDVAL	3680
#define D1_SO_HOLDST	3684
#define D1_SO_HOLDCH	3720
#define D1_SO_HOLDAV	3732

U8 d1_save_path[64];
U8 d1_lvlst_path[64];

U8 *D1SavePath(I64 slot)
{
	StrPrint(d1_save_path, "::/Apps/Diablo1/SAVE%d.DAT", slot);
	return d1_save_path;
}

U8 *D1LvlStPath(I64 slot)
{
	StrPrint(d1_lvlst_path, "::/Apps/Diablo1/SAVE%d.LV", slot);
	return d1_lvlst_path;
}

U0 D1SaveWrU16(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
}

U0 D1SaveWrU32(U8 *p, I64 off, I64 v)
{
	p[off]     = v & 0xFF;
	p[off + 1] = (v >> 8) & 0xFF;
	p[off + 2] = (v >> 16) & 0xFF;
	p[off + 3] = (v >> 24) & 0xFF;
}

I64 D1SaveSum(U8 *p, I64 off, I64 len)
{//body checksum, mod 2^32
	I64 i;
	I64 s = 0;

	for (i = 0; i < len; i++)
		s = (s + p[off + i]) & 0xFFFFFFFF;
	return s;
}

I64 D1SaveBodyLen(I64 ver)
{//0 for a version this build does not read
	if (ver == 1)
		return D1_SAVE_BODY1;
	if (ver == 2)
		return D1_SAVE_BODY2;
	if (ver == 3)
		return D1_SAVE_BODY3;
	if (ver == 4)
		return D1_SAVE_BODY4;
	if (ver == 5)
		return D1_SAVE_BODY5;
	if (ver == 6)
		return D1_SAVE_BODY6;
	return 0;
}

U0 D1SaveWrSt(U8 *p, I64 off, CD1ItmSt *s)
{//36 bytes, CD1ItmSt field order
	D1SaveWrU32(p, off,      s->pfx);
	D1SaveWrU32(p, off + 4,  s->sfx);
	D1SaveWrU32(p, off + 8,  s->unq);
	D1SaveWrU32(p, off + 12, s->ident);
	D1SaveWrU32(p, off + 16, s->dur);
	D1SaveWrU32(p, off + 20, s->maxdur);
	D1SaveWrU32(p, off + 24, s->curs);
	D1SaveWrU32(p, off + 28, s->nominstr);
	D1SaveWrU32(p, off + 32, s->onehand);
}

U0 D1SaveWrChg(U8 *p, I64 off, CD1ItmSt *s)
{//12 bytes: spell id + 1, charges, max charges
	D1SaveWrU32(p, off,     s->spl);
	D1SaveWrU32(p, off + 4, s->chg);
	D1SaveWrU32(p, off + 8, s->maxchg);
}

U0 D1SaveRdChg(U8 *p, I64 off, CD1ItmSt *s)
{
	s->spl    = D1RdI32(p + off);
	s->chg    = D1RdI32(p + off + 4);
	s->maxchg = D1RdI32(p + off + 8);
}

U0 D1SaveWrAff(U8 *p, I64 off, CD1ItmSt *s)
{
	D1SaveWrU32(p, off,      s->pfxval);
	D1SaveWrU32(p, off + 4,  s->sfxval);
	D1SaveWrU32(p, off + 8,  s->pfxval2);
	D1SaveWrU32(p, off + 12, s->sfxval2);
}

U0 D1SaveRdAff(U8 *p, I64 off, CD1ItmSt *s)
{
	s->pfxval  = D1RdI32(p + off);
	s->sfxval  = D1RdI32(p + off + 4);
	s->pfxval2 = D1RdI32(p + off + 8);
	s->sfxval2 = D1RdI32(p + off + 12);
}

U0 D1SaveAffMid(CD1ItmSt *s)
{
	D1AffixValMid(D1AffixPfxPtr(s->pfx), &s->pfxval, &s->pfxval2);
	D1AffixValMid(D1AffixSfxPtr(s->sfx), &s->sfxval, &s->sfxval2);
}

U0 D1SaveRdSt(U8 *p, I64 off, CD1ItmSt *s)
{
	s->pfx      = D1RdI32(p + off);
	s->sfx      = D1RdI32(p + off + 4);
	s->unq      = D1RdI32(p + off + 8);
	s->ident    = D1RdI32(p + off + 12) != 0;
	s->dur      = D1RdI32(p + off + 16);
	s->maxdur   = D1RdI32(p + off + 20);
	s->curs     = D1RdI32(p + off + 24);
	s->nominstr = D1RdI32(p + off + 28) != 0;
	s->onehand  = D1RdI32(p + off + 32) != 0;
	s->spl      = 0;			//charge tail, version 3, read separately
	s->chg      = 0;
	s->maxchg   = 0;
	s->pfxval   = 0;			//affix-roll tail, version 4
	s->sfxval   = 0;
	s->pfxval2  = 0;
	s->sfxval2  = 0;
	if (s->unq)
		D1UnqFillMid(s);
}

U0 D1SaveStV1(CD1ItmSt *s, I64 row)
{
	D1StClear(s);
	if (row >= 0 && row < d1_n_itmdefs)
	{
		s->maxdur = d1_itmdefs[row].dur;
		s->dur    = d1_itmdefs[row].dur;
	}
}

Bool D1SaveHdrOk(U8 *p, I64 size)
{
	I64 ver;
	I64 blen;

	if (size < D1_SAVE_HDR)
		return FALSE;
	if (p[0] != 'D' || p[1] != '1' || p[2] != 'S' || p[3] != 'V')
		return FALSE;
	ver  = D1RdU16(p + 4);
	blen = D1SaveBodyLen(ver);
	if (blen == 0)
		return FALSE;
	if (D1RdU16(p + 6) != D1_SAVE_HDR)
		return FALSE;
	if (D1RdI32(p + 52) != blen)
		return FALSE;
	if (size < D1_SAVE_HDR + blen)
		return FALSE;
	if (D1RdU32(p + 56) != D1SaveSum(p, D1_SAVE_HDR, blen))
		return FALSE;
	return TRUE;
}

Bool D1LvlStWrite(I64 slot)
{
	U8	*buf;
	I64	 olen;
	I64	 ilen;
	I64	 mlen;
	I64	 alen;
	I64	 len;
	I64	 res;
	I64	 o;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (d1_currlevel > 0 && d1_currlevel <= 16)
	{
		if (d1_nobjs > 0)
			D1ObjStash(d1_currlevel);
		D1MonStash(d1_currlevel);
	}
	if (d1_currlevel >= 0 && d1_currlevel <= 16)
	{
		D1ItemStash(d1_currlevel);
		D1AutoStash(d1_currlevel);
	}
	olen = sizeof(CD1ObjLvl) * 17;
	ilen = sizeof(CD1ItmLvl) * 17;
	mlen = sizeof(CD1MonLvl) * 17;
	alen = sizeof(CD1AmapLvl) * 17;
	len  = 8 + olen + ilen + mlen + alen;
	buf  = CAlloc(len);
	if (!buf)
		return FALSE;
	buf[0] = 'D';
	buf[1] = '1';
	buf[2] = 'L';
	buf[3] = 'V';
	D1SaveWrU16(buf, 4, 2);
	D1SaveWrU16(buf, 6, 8);
	o = 8;
	MemCopy(buf + o, &d1_obj_lvl, olen);	o += olen;
	MemCopy(buf + o, &d1_itm_lvl, ilen);	o += ilen;
	MemCopy(buf + o, &d1_mon_lvl, mlen);	o += mlen;
	MemCopy(buf + o, &d1_amap_lvl, alen);
	res = FileWrite(D1LvlStPath(slot), buf, len);
	Free(buf);
	return res != 0;
}

Bool D1LvlStRead(I64 slot)
{
	U8	*buf;
	I64	 size = 0;
	I64	 olen;
	I64	 ilen;
	I64	 mlen;
	I64	 alen;
	I64	 ver;
	I64	 o;

	D1ObjStashClear;
	D1ItemStashClear;
	D1MonStashClear;
	D1AutoStashClear;
	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (!FileFind(D1LvlStPath(slot)))
		return FALSE;
	buf = FileRead(D1LvlStPath(slot), &size);
	if (!buf)
		return FALSE;
	olen = sizeof(CD1ObjLvl) * 17;
	ilen = sizeof(CD1ItmLvl) * 17;
	mlen = sizeof(CD1MonLvl) * 17;
	alen = sizeof(CD1AmapLvl) * 17;
	if (size < 8 + olen + ilen ||
		buf[0] != 'D' || buf[1] != '1' || buf[2] != 'L' || buf[3] != 'V')
	{
		Free(buf);
		return FALSE;
	}
	ver = D1RdU16(buf + 4);
	o = 8;
	MemCopy(&d1_obj_lvl, buf + o, olen);	o += olen;
	MemCopy(&d1_itm_lvl, buf + o, ilen);	o += ilen;
	if (ver >= 2 && size >= 8 + olen + ilen + mlen + alen)
	{
		MemCopy(&d1_mon_lvl, buf + o, mlen);	o += mlen;
		MemCopy(&d1_amap_lvl, buf + o, alen);
	}
	Free(buf);
	return TRUE;
}

U0 D1SaveBuild(U8 *buf)
{
	I64	 o;
	I64	 i;
	I64	 mask;

	buf[0] = 'D';
	buf[1] = '1';
	buf[2] = 'S';
	buf[3] = 'V';
	D1SaveWrU16(buf, 4, D1_SAVE_VER);
	D1SaveWrU16(buf, 6, D1_SAVE_HDR);
	D1StrCopy(buf + 8, d1_plr_name, 32);
	D1SaveWrU32(buf, 40, d1_plr_class);
	D1SaveWrU32(buf, 44, d1_plr_lvl);
	D1SaveWrU32(buf, 48, d1_currlevel);
	D1SaveWrU32(buf, 52, D1_SAVE_BODY6);

	o = D1_SAVE_HDR;
	D1SaveWrU32(buf, o, d1_plr_exp);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_str);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_mag);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_dex);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_vit);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_pts);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_hp);			o += 4;
	D1SaveWrU32(buf, o, d1_plr_maxhp);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_mana);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_maxmana);	o += 4;
	D1SaveWrU32(buf, o, d1_plr_gold);		o += 4;
	D1SaveWrU32(buf, o, d1_plr_x);			o += 4;
	D1SaveWrU32(buf, o, d1_plr_y);			o += 4;
	D1SaveWrU32(buf, o, d1_diablo_slain);	o += 4;

	for (i = 0; i < 17; i++)
	{
		D1SaveWrU32(buf, o, d1_lvl_seeds[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_grid[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_itm[i]);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrU32(buf, o, d1_inv_val[i]);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrU32(buf, o, d1_equip_itm[i]);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrU32(buf, o, d1_equip_val[i]);
		o += 4;
	}
	for (i = 0; i < 8; i++)
	{
		D1SaveWrU32(buf, o, d1_belt[i]);
		o += 4;
	}

	//version 2 tail
	o = D1_SAVE_HDR + D1_SO_STINV;
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrSt(buf, o, &d1_st_inv[i]);
		o += D1_SAVE_STLEN;
	}
	o = D1_SAVE_HDR + D1_SO_STEQ;
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrSt(buf, o, &d1_st_equip[i]);
		o += D1_SAVE_STLEN;
	}

	mask = 0;
	for (i = 0; i < D1_MAXUNQ; i++)
	{
		if (d1_unq_taken[i])
			mask = mask | (1 << i);
	}
	D1SaveWrU32(buf, D1_SAVE_HDR + D1_SO_UNQ, mask);

	o = D1_SAVE_HDR + D1_SO_QUEST;
	for (i = 0; i < D1_NQUESTS; i++)
	{
		D1SaveWrU32(buf, o, d1_quests[i].state);
		o += 4;
	}
	o = D1_SAVE_HDR + D1_SO_SPLVL;
	for (i = 0; i < D1_NSPL_CORE; i++)
	{
		D1SaveWrU32(buf, o, d1_sp_lvl[i]);
		o += 4;
	}
	D1SaveWrU32(buf, D1_SAVE_HDR + D1_SO_SPSEL, d1_spell_active);
	D1SaveWrU32(buf, D1_SAVE_HDR + D1_SO_DEEP,  d1_deepest_lvl);

	//version 3 charge tail
	o = D1_SAVE_HDR + D1_SO_CHINV;
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrChg(buf, o, &d1_st_inv[i]);
		o += D1_SAVE_CHLEN;
	}
	o = D1_SAVE_HDR + D1_SO_CHEQ;
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrChg(buf, o, &d1_st_equip[i]);
		o += D1_SAVE_CHLEN;
	}

	//version 4 affix-roll tail
	o = D1_SAVE_HDR + D1_SO_AVINV;
	for (i = 0; i < D1_MAXINV; i++)
	{
		D1SaveWrAff(buf, o, &d1_st_inv[i]);
		o += D1_SAVE_AVLEN;
	}
	o = D1_SAVE_HDR + D1_SO_AVEQ;
	for (i = 0; i < D1EQ_N; i++)
	{
		D1SaveWrAff(buf, o, &d1_st_equip[i]);
		o += D1_SAVE_AVLEN;
	}

	//version 5: spells beyond the original 19-slot SPLVL block
	o = D1_SAVE_HDR + D1_SO_SPLEXT;
	for (i = D1_NSPL_CORE; i < D1_NSPELL; i++)
	{
		D1SaveWrU32(buf, o, d1_sp_lvl[i]);
		o += 4;
	}

	//version 6: the cursor item, held over the panels at write time
	D1SaveWrU32(buf, D1_SAVE_HDR + D1_SO_HOLDITM, d1_hold_itm);
	D1SaveWrU32(buf, D1_SAVE_HDR + D1_SO_HOLDVAL, d1_hold_val);
	D1SaveWrSt(buf,  D1_SAVE_HDR + D1_SO_HOLDST,  &d1_hold_st);
	D1SaveWrChg(buf, D1_SAVE_HDR + D1_SO_HOLDCH,  &d1_hold_st);
	D1SaveWrAff(buf, D1_SAVE_HDR + D1_SO_HOLDAV,  &d1_hold_st);

	D1SaveWrU32(buf, 56, D1SaveSum(buf, D1_SAVE_HDR, D1_SAVE_BODY6));
}

Bool D1SaveWrite(I64 slot)
{
	U8	*buf;
	I64	 res;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	buf = CAlloc(D1_SAVE_LEN);
	if (!buf)
		return FALSE;

	D1SaveBuild(buf);

	res = FileWrite(D1SavePath(slot), buf, D1_SAVE_LEN);
	Free(buf);
	if (!res)
		return FALSE;
	D1LvlStWrite(slot);
	return TRUE;
}

Bool D1SaveRead(I64 slot)
{
	U8	*buf;
	I64	 size = 0;
	I64	 ver;
	I64	 o;
	I64	 i;
	I64	 mask;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (!FileFind(D1SavePath(slot)))
		return FALSE;
	buf = FileRead(D1SavePath(slot), &size);
	if (!buf)
		return FALSE;
	if (!D1SaveHdrOk(buf, size))
	{
		Free(buf);
		return FALSE;
	}
	ver = D1RdU16(buf + 4);

	D1ItemInit;
	D1AffixInit;
	if (!d1_quest_inited)
		D1QuestInit;

	D1StrCopy(d1_plr_name, buf + 8, 32);
	d1_plr_class = D1RdI32(buf + 40);
	d1_plr_lvl   = D1RdI32(buf + 44);
	d1_currlevel = D1RdI32(buf + 48);

	o = D1_SAVE_HDR;
	d1_plr_exp     = D1RdI32(buf + o);	o += 4;
	d1_plr_str     = D1RdI32(buf + o);	o += 4;
	d1_plr_mag     = D1RdI32(buf + o);	o += 4;
	d1_plr_dex     = D1RdI32(buf + o);	o += 4;
	d1_plr_vit     = D1RdI32(buf + o);	o += 4;
	d1_plr_pts     = D1RdI32(buf + o);	o += 4;
	d1_plr_hp      = D1RdI32(buf + o);	o += 4;
	d1_plr_maxhp   = D1RdI32(buf + o);	o += 4;
	d1_plr_mana    = D1RdI32(buf + o);	o += 4;
	d1_plr_maxmana = D1RdI32(buf + o);	o += 4;
	d1_plr_gold    = D1RdI32(buf + o);	o += 4;
	d1_plr_x       = D1RdI32(buf + o);	o += 4;
	d1_plr_y       = D1RdI32(buf + o);	o += 4;
	d1_diablo_slain = D1RdI32(buf + o) != 0;
	o += 4;

	d1_plr_tile_x = d1_plr_x;
	d1_plr_tile_y = d1_plr_y;
	d1_plr_futx   = d1_plr_x;
	d1_plr_futy   = d1_plr_y;

	for (i = 0; i < 17; i++)
	{
		d1_lvl_seeds[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_itm[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_val[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_val[i] = D1RdI32(buf + o);
		o += 4;
	}
	for (i = 0; i < 8; i++)
	{
		d1_belt[i] = D1RdI32(buf + o);
		o += 4;
	}

	if (ver >= 2)
	{
		o = D1_SAVE_HDR + D1_SO_STINV;
		for (i = 0; i < D1_MAXINV; i++)
		{
			D1SaveRdSt(buf, o, &d1_st_inv[i]);
			o += D1_SAVE_STLEN;
		}
		o = D1_SAVE_HDR + D1_SO_STEQ;
		for (i = 0; i < D1EQ_N; i++)
		{
			D1SaveRdSt(buf, o, &d1_st_equip[i]);
			o += D1_SAVE_STLEN;
		}

		mask = D1RdU32(buf + D1_SAVE_HDR + D1_SO_UNQ);
		for (i = 0; i < D1_MAXUNQ; i++)
			d1_unq_taken[i] = ToBool(mask & (1 << i));

		o = D1_SAVE_HDR + D1_SO_QUEST;
		for (i = 0; i < D1_NQUESTS; i++)
		{
			d1_quests[i].state = D1RdI32(buf + o);
			o += 4;
		}
		o = D1_SAVE_HDR + D1_SO_SPLVL;
		for (i = 0; i < D1_NSPL_CORE; i++)
		{
			d1_sp_lvl[i] = D1RdI32(buf + o);
			o += 4;
		}
		for (i = D1_NSPL_CORE; i < D1_NSPELL; i++)
			d1_sp_lvl[i] = 0;
		d1_spell_active = D1RdI32(buf + D1_SAVE_HDR + D1_SO_SPSEL);
		d1_deepest_lvl  = D1RdI32(buf + D1_SAVE_HDR + D1_SO_DEEP);
	}
	if (ver >= 3)
	{
		o = D1_SAVE_HDR + D1_SO_CHINV;
		for (i = 0; i < D1_MAXINV; i++)
		{
			D1SaveRdChg(buf, o, &d1_st_inv[i]);
			o += D1_SAVE_CHLEN;
		}
		o = D1_SAVE_HDR + D1_SO_CHEQ;
		for (i = 0; i < D1EQ_N; i++)
		{
			D1SaveRdChg(buf, o, &d1_st_equip[i]);
			o += D1_SAVE_CHLEN;
		}
	}
	if (ver >= 4)
	{
		o = D1_SAVE_HDR + D1_SO_AVINV;
		for (i = 0; i < D1_MAXINV; i++)
		{
			D1SaveRdAff(buf, o, &d1_st_inv[i]);
			o += D1_SAVE_AVLEN;
		}
		o = D1_SAVE_HDR + D1_SO_AVEQ;
		for (i = 0; i < D1EQ_N; i++)
		{
			D1SaveRdAff(buf, o, &d1_st_equip[i]);
			o += D1_SAVE_AVLEN;
		}
	}
	else if (ver >= 2)
	{//midpoint rolls for a pre-version-4 magic item
		for (i = 0; i < D1_MAXINV; i++)
			D1SaveAffMid(&d1_st_inv[i]);
		for (i = 0; i < D1EQ_N; i++)
			D1SaveAffMid(&d1_st_equip[i]);
	}
	if (ver >= 5)
	{
		o = D1_SAVE_HDR + D1_SO_SPLEXT;
		for (i = D1_NSPL_CORE; i < D1_NSPELL; i++)
		{
			d1_sp_lvl[i] = D1RdI32(buf + o);
			o += 4;
		}
	}
	if (ver < 2)
	{
		for (i = 0; i < D1_MAXINV; i++)
			D1SaveStV1(&d1_st_inv[i], d1_inv_itm[i]);
		for (i = 0; i < D1EQ_N; i++)
			D1SaveStV1(&d1_st_equip[i], d1_equip_itm[i]);
		for (i = 0; i < D1_MAXUNQ; i++)
			d1_unq_taken[i] = FALSE;
		for (i = 0; i < D1_NQUESTS; i++)
			d1_quests[i].state = D1QS_AVAIL;
		for (i = 0; i < D1_NSPELL; i++)
			d1_sp_lvl[i] = 0;
		d1_spell_active = -1;
		d1_deepest_lvl  = d1_currlevel;
	}

	d1_spell_type = D1RSP_SPELL;
	if (d1_spell_active >= 0 && D1StaffSpell() == d1_spell_active)
		d1_spell_type = D1RSP_CHARGES;

	d1_seeds_init = TRUE;
	d1_plr_dead   = FALSE;
	d1_plr_hitflash = 0;
	D1HoldClear;				//versions 1..5 default: empty cursor
	if (ver >= 6)
	{
		i = D1RdI32(buf + D1_SAVE_HDR + D1_SO_HOLDITM);
		if (i >= 0 && i < d1_n_itmdefs)
		{
			d1_hold_itm = i;
			d1_hold_val = D1RdI32(buf + D1_SAVE_HDR + D1_SO_HOLDVAL);
			D1SaveRdSt(buf,  D1_SAVE_HDR + D1_SO_HOLDST, &d1_hold_st);
			D1SaveRdChg(buf, D1_SAVE_HDR + D1_SO_HOLDCH, &d1_hold_st);
			D1SaveRdAff(buf, D1_SAVE_HDR + D1_SO_HOLDAV, &d1_hold_st);
		}
	}
	D1LvlStRead(slot);

	Free(buf);
	return TRUE;
}

Bool D1SaveProbe(I64 slot, U8 *name_out, I64 *cls_out, I64 *lvl_out)
{
	U8	*buf;
	I64	 size = 0;
	Bool ok;

	if (name_out)
		name_out[0] = 0;
	if (cls_out)
		*cls_out = 0;
	if (lvl_out)
		*lvl_out = 0;

	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return FALSE;
	if (!FileFind(D1SavePath(slot)))
		return FALSE;
	buf = FileRead(D1SavePath(slot), &size);
	if (!buf)
		return FALSE;

	ok = D1SaveHdrOk(buf, size);
	if (ok)
	{
		if (name_out)
			D1StrCopy(name_out, buf + 8, 32);
		if (cls_out)
			*cls_out = D1RdI32(buf + 40);
		if (lvl_out)
			*lvl_out = D1RdI32(buf + 44);
	}
	Free(buf);
	return ok;
}

U0 D1SaveDelete(I64 slot)
{
	if (slot < 0 || slot >= D1_SAVE_SLOTS)
		return;
	if (FileFind(D1SavePath(slot)))
		Del(D1SavePath(slot), FALSE, FALSE, FALSE);
	if (FileFind(D1LvlStPath(slot)))
		Del(D1LvlStPath(slot), FALSE, FALSE, FALSE);
}

U0 D1SaveResetState()
{
	I64 i;

	D1ItemInit;
	D1ItemClear;
	D1AffixInit;
	if (!d1_quest_inited)
		D1QuestInit;

	for (i = 0; i < D1_MAXINV; i++)
	{
		d1_inv_grid[i] = 0;
		d1_inv_itm[i]  = -1;
		d1_inv_val[i]  = 0;
		D1StClear(&d1_st_inv[i]);
	}
	for (i = 0; i < D1EQ_N; i++)
	{
		d1_equip_itm[i] = -1;
		d1_equip_val[i] = 0;
		D1StClear(&d1_st_equip[i]);
	}
	for (i = 0; i < 8; i++)
		d1_belt[i] = 0;
	for (i = 0; i < D1_MAXUNQ; i++)
		d1_unq_taken[i] = FALSE;
	for (i = 0; i < D1_NQUESTS; i++)
		d1_quests[i].state = D1QS_AVAIL;
	for (i = 0; i < D1_NSPELL; i++)
		d1_sp_lvl[i] = 0;

	d1_spell_active = -1;
	d1_spell_type   = D1RSP_SPELL;
	d1_deepest_lvl  = 0;
	d1_currlevel    = 0;
	d1_diablo_slain = FALSE;
	d1_plr_dead     = FALSE;
	d1_plr_hitflash = 0;
	d1_seeds_init   = FALSE;
	D1ObjStashClear;
	D1ItemStashClear;
	D1MonStashClear;
	D1AutoStashClear;
}


#define D1_PACK_TRAIL	16
#define D1_PACK_LEN		(D1_SAVE_LEN + D1_PACK_TRAIL)

I64 D1SavePackBuild(U8 *dst, I64 max)
{
	if (max < D1_PACK_LEN)
		return 0;
	MemSet(dst, 0, D1_PACK_LEN);
	D1SaveBuild(dst);
	D1SaveWrU32(dst, D1_SAVE_LEN,      D1InvAC());
	D1SaveWrU32(dst, D1_SAVE_LEN + 4,  D1InvDmgMin());
	D1SaveWrU32(dst, D1_SAVE_LEN + 8,  D1InvDmgMax());
	D1SaveWrU32(dst, D1_SAVE_LEN + 12, d1_currlevel);
	return D1_PACK_LEN;
}

Bool D1SavePackApply(I64 pidx, U8 *src, I64 len)
{
	CD1Peer *p;
	I64	 b = D1_SAVE_HDR;

	if (pidx < 0 || pidx >= D1_MAXPEER || len < D1_PACK_LEN)
		return FALSE;
	if (!D1SaveHdrOk(src, D1_SAVE_LEN))
		return FALSE;

	p = &d1_peers[pidx];
	p->used  = TRUE;
	p->local = FALSE;
	D1StrCopy(p->name, src + 8, 32);
	p->cls     = D1RdI32(src + 40);
	p->lvl     = D1RdI32(src + 44);
	p->str     = D1RdI32(src + b + 4);
	p->dex     = D1RdI32(src + b + 12);
	p->hp      = D1RdI32(src + b + 24);
	p->maxhp   = D1RdI32(src + b + 28);
	p->mana    = D1RdI32(src + b + 32);
	p->maxmana = D1RdI32(src + b + 36);
	p->x       = D1RdI32(src + b + 44);
	p->y       = D1RdI32(src + b + 48);
	p->ac      = D1RdI32(src + D1_SAVE_LEN);
	p->dmin    = D1RdI32(src + D1_SAVE_LEN + 4);
	p->dmax    = D1RdI32(src + D1_SAVE_LEN + 8);
	p->dlvl    = d1_currlevel;
	if (p->hp < 1)
		p->hp = p->maxhp;
	if (p->dmax < p->dmin)
		p->dmax = p->dmin;
	p->mode  = D1PM_STAND;
	p->frame = 1;
	p->dir   = 0;
	p->dead  = FALSE;
	p->target  = -1;
	p->pathlen = 0;
	p->pathpos = 0;
	return TRUE;
}

U0 D1SaveNetInit()
{
	d1_net_pack_build = &D1SavePackBuild;
	d1_net_pack_apply = &D1SavePackApply;
}

D1SaveNetInit;
