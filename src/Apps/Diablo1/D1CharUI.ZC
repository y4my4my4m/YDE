// D1CharUI.ZC - character screen (CHAR button), control.cpp DrawChr
//
// Data\Char.CEL: one unclipped 320x352 frame over the LEFT half of the
// screen, bottom anchor at y 351 - the mirror of Inv.CEL on the right.
// Data\CharBut.CEL: 41x22 unclipped frames. 1 is the Level Up button;
// 2/3 str, 4/5 mag, 6/7 dex, 8/9 vit, odd frames pressed.
//
// every field coordinate below is the DrawChr coordinate verbatim. DrawChr
// draws the panel at SCREEN_X and addresses text in absolute screen space,
// so with the panel origin at panel-local 0,0 the coordinates transfer 1:1.
// y is the text BASELINE. every x here is panel-local: the panel draws at
// D1UiOrgX(), which D1ChrStr and D1CharUIDrawButtons add and D1CharUIClick
// subtracts.
//
// ADD_PlrStringXY centers a string inside [x, width]; D1ChrStr mirrors it.
//
// text colors are palette indices, not the original's PrintChar translation
// tables. Diablo varies only palette entries 0-127 per level, so the 128-255
// UI ramps are stable: 240 white, 192 gold, 176 blue, 229 red.
//
// resistances read 0% - no resistance sources exist in this port. base and
// current attributes are the same number for the same reason: no item grants
// attribute bonuses yet.

#define D1_CHR_WHITE	240
#define D1_CHR_GOLD		192
#define D1_CHR_BLUE		176
#define D1_CHR_RED		229

Bool d1_char_open = FALSE;
U8	*d1_chr_cel    = NULL;
U8	*d1_chr_but    = NULL;
U8	 d1_chr_txt[64];

//ChrBtnsRect: x, y, w, h per attribute, control.cpp ChrBtnsRect
I64 d1_chrbtn_x[4] = {137, 137, 137, 137};
I64 d1_chrbtn_y[4] = {138, 166, 195, 223};

//CelDraw bottom anchors for the same four buttons, DrawChr
I64 d1_chrbtn_by[4] = {159, 187, 216, 244};

U0 D1CharUIToggle()
{
	I64 size = 0;

	if (!d1_chr_cel)
		d1_chr_cel = D1MpqRead("Data\\Char.CEL", &size);
	if (!d1_chr_but)
		d1_chr_but = D1MpqRead("Data\\CharBut.CEL", &size);
	d1_char_open = !d1_char_open;
}

U0 D1ChrStr(I64 x, I64 y, I64 right, U8 *s, I64 col)
{//ADD_PlrStringXY: center inside [x, right], baseline y. x is panel-local.
	I64 w    = D1TextWidth(s);
	I64 span = right - x + 1;
	I64 ox   = 0;

	if (w < span)
		ox = (span - w) >> 1;
	D1TextDrawSolid(D1UiOrgX() + x + ox, y, s, col);
}

I64 D1ChrAttr(I64 attr)
{
	if (attr == D1AT_STR)
		return d1_plr_str;
	if (attr == D1AT_MAG)
		return d1_plr_mag;
	if (attr == D1AT_DEX)
		return d1_plr_dex;
	return d1_plr_vit;
}

I64 D1ChrAC()
{//DrawChr: item AC + dex / 5
	return D1InvAC() + d1_plr_dex / 5;
}

I64 D1ChrToHit()
{//DrawChr: (dex >> 1) + 50
	return (d1_plr_dex >> 1) + 50;
}

I64 D1ChrDamMod()
{//D1PlayerAttackRoll's str/level scaling, the port's _pDamageMod
	return (d1_plr_str * d1_plr_lvl) / 100;
}

U0 D1CharUIDrawStats()
{//base column at x 95, current column at x 143, rows 155/183/211/239
	I64 attr;
	I64 y;
	I64 v;
	I64 col;

	for (attr = 0; attr < 4; attr++)
	{
		y   = 155 + attr * 28;
		v   = D1ChrAttr(attr);
		col = D1_CHR_WHITE;
		if (v >= D1ClsMax(d1_plr_class, attr))
			col = D1_CHR_GOLD;
		StrPrint(d1_chr_txt, "%d", v);
		D1ChrStr(95, y, 126, d1_chr_txt, col);
		D1ChrStr(143, y, 173, d1_chr_txt, D1_CHR_WHITE);
	}
}

U0 D1CharUIDrawButtons()
{//DrawChr draws a + button only while points remain and the cap is clear
	I64 attr;
	I64 frame;

	if (d1_plr_pts <= 0 || !d1_chr_but)
		return;

	StrPrint(d1_chr_txt, "%d", d1_plr_pts);
	D1ChrStr(95, 266, 126, d1_chr_txt, D1_CHR_RED);

	for (attr = 0; attr < 4; attr++)
	{
		if (D1ChrAttr(attr) < D1ClsMax(d1_plr_class, attr))
		{
			frame = 2 + attr * 2;
			D1CelDraw(D1UiOrgX() + d1_chrbtn_x[attr], d1_chrbtn_by[attr],
				d1_chr_but, frame, 41);
		}
	}
}

U0 D1CharUIDraw()
{
	I64 mn;
	I64 mx;

	if (!d1_char_open || !d1_chr_cel)
		return;

	D1CelDraw(D1UiOrgX(), 351, d1_chr_cel, 1, 320);

	D1ChrStr(20, 32, 151, d1_plr_name, D1_CHR_WHITE);
	D1ChrStr(168, 32, 299, d1_cls_name[d1_plr_class], D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "%d", d1_plr_lvl);
	D1ChrStr(66, 69, 109, d1_chr_txt, D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "%d", d1_plr_exp);
	D1ChrStr(216, 69, 300, d1_chr_txt, D1_CHR_WHITE);

	//d1_exp_tbl holds 10 thresholds; past the last one there is no next level
	if (d1_plr_lvl >= 10)
	{
		StrPrint(d1_chr_txt, "None");
		D1ChrStr(216, 97, 300, d1_chr_txt, D1_CHR_GOLD);
	}
	else
	{
		StrPrint(d1_chr_txt, "%d", d1_exp_tbl[d1_plr_lvl]);
		D1ChrStr(216, 97, 300, d1_chr_txt, D1_CHR_WHITE);
	}

	StrPrint(d1_chr_txt, "%d", d1_plr_gold);
	D1ChrStr(216, 146, 300, d1_chr_txt, D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "%d", D1ChrAC());
	D1ChrStr(258, 183, 301, d1_chr_txt, D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "%d%%", D1ChrToHit());
	D1ChrStr(258, 211, 301, d1_chr_txt, D1_CHR_WHITE);

	mn = D1InvDmgMin() + D1ChrDamMod();
	mx = D1InvDmgMax() + D1ChrDamMod();
	StrPrint(d1_chr_txt, "%d-%d", mn, mx);
	D1ChrStr(258, 239, 301, d1_chr_txt, D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "0%%");
	D1ChrStr(257, 276, 300, d1_chr_txt, D1_CHR_WHITE);
	D1ChrStr(257, 304, 300, d1_chr_txt, D1_CHR_WHITE);
	D1ChrStr(257, 332, 300, d1_chr_txt, D1_CHR_WHITE);

	D1CharUIDrawStats;
	D1CharUIDrawButtons;

	//life and mana are tracked in 64ths
	StrPrint(d1_chr_txt, "%d", d1_plr_maxhp >> 6);
	D1ChrStr(95, 304, 126, d1_chr_txt, D1_CHR_WHITE);
	StrPrint(d1_chr_txt, "%d", d1_plr_hp >> 6);
	if (d1_plr_hp < d1_plr_maxhp)
		D1ChrStr(143, 304, 174, d1_chr_txt, D1_CHR_RED);
	else
		D1ChrStr(143, 304, 174, d1_chr_txt, D1_CHR_WHITE);

	StrPrint(d1_chr_txt, "%d", d1_plr_maxmana >> 6);
	D1ChrStr(95, 332, 126, d1_chr_txt, D1_CHR_WHITE);
	StrPrint(d1_chr_txt, "%d", d1_plr_mana >> 6);
	if (d1_plr_mana < d1_plr_maxmana)
		D1ChrStr(143, 332, 174, d1_chr_txt, D1_CHR_RED);
	else
		D1ChrStr(143, 332, 174, d1_chr_txt, D1_CHR_WHITE);
}

Bool D1CharUIClick(I64 cx, I64 cy)
{//canvas coords. TRUE = consumed (any click on the open panel half).
	I64 attr;
	I64 hit = -1;

	if (!d1_char_open)
		return FALSE;
	cx -= D1UiOrgX();
	if (cx < 0 || cx >= 320 || cy < 0 || cy > 351)
		return FALSE;

	if (d1_plr_pts > 0)
	{
		for (attr = 0; attr < 4; attr++)
		{
			if (cx >= d1_chrbtn_x[attr] && cx < d1_chrbtn_x[attr] + 41 &&
				cy >= d1_chrbtn_y[attr] && cy < d1_chrbtn_y[attr] + 22)
				hit = attr;
		}
		if (hit >= 0)
			D1CharSpend(hit);
	}
	return TRUE;
}
