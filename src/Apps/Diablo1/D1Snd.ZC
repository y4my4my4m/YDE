// WAV decode, SFX cache + voice pool, looped music
//
// devilution counterparts: effects.cpp sound_file_load/PlaySFX,
// sound.cpp snd_play_snd/music_start, monster.cpp PlayEffect.
//
// AudioSFXPlayRef (System/Audio/Driver/AC97.ZC) takes a BORROWED U32 frame
// buffer (L16 | R16 << 16) at a caller-chosen rate and nearest-sample steps it
// to the 48kHz output. sfx are decoded once, resampled to 48kHz stereo, cached
// and played by reference; music stays at its native rate.
//
// DIABDAT.MPQ: sfx are PCM mono 22050Hz 8-bit (Sfx\Misc\Walk1.wav is 16-bit);
// music is PCM 22050Hz 16-bit, DTowne/Dintro stereo, DLvlA-D mono.

#define D1SND_RATE		48000
#define D1SND_CACHE		16
#define D1SND_VOICES	8
#define D1SND_PATH		80
#define D1SND_SFX_VOL	256
#define D1SND_MUS_VOL	100

I64	 d1_snd_sfx_vol = D1SND_SFX_VOL;
I64	 d1_snd_mus_vol = D1SND_MUS_VOL;

I64 D1SndLinToHw(I64 lin)
{
	I64 v;

	if (lin <= 0)
		return 0;
	if (lin >= 256)
		return 256;
	v = (lin * lin) / 256;
	return (v * 3 + lin) / 4;
}

class CD1SndCache
{
	U8	 path[D1SND_PATH];
	U32	*frames;
	I64	 count;
	I64	 rate;
	I64	 stamp;
	Bool missing;
};

class CD1SndVoice
{
	I64	handle;				//AC97 voice handle, -1 free
	I64	cache_idx;
	I64	stamp;
};

CD1SndCache	 d1snd_cache[D1SND_CACHE];
CD1SndVoice	 d1snd_voice[D1SND_VOICES];
Bool d1snd_ready = FALSE;
Bool d1snd_on	 = FALSE;
I64	 d1snd_stamp = 0;

U32	*d1snd_mus_frames = NULL;	//48kHz stereo, owned here
I64	 d1snd_mus_count  = 0;
I64	 d1snd_mus_rate   = 0;
I64	 d1snd_mus_handle = -1;
U8	 d1snd_mus_path[D1SND_PATH];

U0 (*d1snd_vox_stop)() = NULL;

I64	 d1snd_rng = 0x1234ABCD;

Bool D1SndTag(U8 *p, U8 *tag)
{//4-byte chunk id compare
	return p[0] == tag[0] && p[1] == tag[1] && p[2] == tag[2] &&
		p[3] == tag[3];
}

I64 D1SndS16(I64 v)
{//low 16 bits as signed
	v &= 0xFFFF;
	if (v & 0x8000)
		v -= 0x10000;
	return v;
}

I64 D1SndRnd2()
{//0 or 1
	d1snd_rng = (d1snd_rng * 0x015A4E35 + 1) & 0xFFFFFFFF;
	return (d1snd_rng >> 16) & 1;
}

I64 D1SndDecodeNative(U8 *raw, I64 size, U32 **_frames, I64 *_rate)
{
	U8	*p;
	U8	*end;
	U8	*data = NULL;
	U8	*s;
	I64	 chunk;
	I64	 tag      = 1;
	I64	 channels = 1;
	I64	 rate     = 22050;
	I64	 bits     = 8;
	I64	 dsize    = 0;
	I64	 in_count;
	I64	 i;
	I64	 l;
	I64	 r;
	U32	*out;

	*_frames = NULL;
	if (_rate)
		*_rate = 0;

	if (!raw || size < 44)
		return 0;
	if (!D1SndTag(raw, "RIFF") || !D1SndTag(raw + 8, "WAVE"))
		return 0;

	p   = raw + 12;
	end = raw + size;
	while (p + 8 <= end)
	{
		chunk = D1RdU32(p + 4);
		if (p + 8 + chunk > end)
			chunk = end - (p + 8);
		if (D1SndTag(p, "fmt ") && chunk >= 16)
		{
			tag      = D1RdU16(p + 8);
			channels = D1RdU16(p + 10);
			rate     = D1RdU32(p + 12);
			bits     = D1RdU16(p + 22);
		}
		else if (D1SndTag(p, "data"))
		{
			data  = p + 8;
			dsize = chunk;
		}
		p += 8 + chunk + (chunk & 1);
	}

	if (tag != 1 || !data || dsize < 1 || rate < 1)
		return 0;
	if (channels < 1 || channels > 2)
		return 0;
	if (bits != 8 && bits != 16)
		return 0;

	in_count = dsize / (channels * (bits / 8));
	if (in_count < 1)
		return 0;

	out = CAlloc(in_count * 4, sys_task);
	for (i = 0; i < in_count; i++)
	{
		if (bits == 8)
		{
			s = data + i * channels;
			l = (s[0] - 128) << 8;
			r = l;
			if (channels > 1)
				r = (s[1] - 128) << 8;
		}
		else
		{
			s = data + i * channels * 2;
			l = D1RdI16(s);
			r = l;
			if (channels > 1)
				r = D1RdI16(s + 2);
		}
		out[i] = (l & 0xFFFF) | ((r & 0xFFFF) << 16);
	}

	*_frames = out;
	if (_rate)
		*_rate = rate;
	return in_count;
}

U32 *D1SndResample48(U32 *src, I64 in_count, I64 src_rate, I64 *_out_count)
{
 //16.16 position; the last sample holds for the tail
	I64	 step_fp;
	I64	 out_count;
	I64	 pos_fp;
	I64	 idx;
	I64	 frac;
	I64	 i;
	I64	 l0;
	I64	 r0;
	I64	 l1;
	I64	 r1;
	I64	 l;
	I64	 r;
	U32	*out;

	*_out_count = 0;
	if (!src || in_count < 1 || src_rate < 1)
		return NULL;

	step_fp   = (src_rate << 16) / D1SND_RATE;
	out_count = (in_count * D1SND_RATE) / src_rate;
	if (out_count < 1)
		out_count = 1;

	out = CAlloc(out_count * 4, sys_task);
	for (i = 0; i < out_count; i++)
	{
		pos_fp = i * step_fp;
		idx    = pos_fp >> 16;
		frac   = pos_fp & 0xFFFF;
		if (idx > in_count - 1)
			idx = in_count - 1;
		l0 = D1SndS16(src[idx]);
		r0 = D1SndS16(src[idx] >> 16);
		if (idx < in_count - 1)
		{
			l1 = D1SndS16(src[idx + 1]);
			r1 = D1SndS16(src[idx + 1] >> 16);
		}
		else
		{
			l1 = l0;
			r1 = r0;
		}
		l = l0 + (((l1 - l0) * frac) >> 16);
		r = r0 + (((r1 - r0) * frac) >> 16);
		out[i] = (l & 0xFFFF) | ((r & 0xFFFF) << 16);
	}

	*_out_count = out_count;
	return out;
}


I64 D1SndHwPlay(U32 *frames, I64 count, I64 rate, I64 vol, Bool loop)
{//voice handle or -1. the buffer must outlive playback
	if (!d1snd_on)
		return -1;
	return AudioSFXPlayRef(frames, count, rate, vol, vol, loop);
}

Bool D1SndHwPlaying(I64 handle)
{
	if (!d1snd_on || handle < 0)
		return FALSE;
	return AudioSFXPlaying(handle);
}

U0 D1SndHwStop(I64 handle)
{
	if (d1snd_on && handle >= 0)
		AudioSFXStop(handle);
}

U0 D1SndHwStopAllVoices()
{
	if (d1snd_on)
		AudioSFXStopAll;
}

U0 D1SndHwVol(I64 handle, I64 l, I64 r)
{//volume of a running voice, 0..256 per channel
	if (d1snd_on && handle >= 0)
		AudioSFXVoiceVolSet(handle, l, r);
}

U0 D1SndHwDrain()
{
	if (d1snd_on)
		Sleep(4);
}

Bool D1SndHwIdle(I64 handle)
{
	I64 i;

	if (!d1snd_on || handle < 0)
		return TRUE;
	for (i = 0; i < 64; i++)
	{
		if (!AudioSFXPlaying(handle))
			return TRUE;
		AudioSFXStop(handle);
		Sleep(2);
	}
	return FALSE;
}


U0 D1SndInitState()
{
	I64 i;

	for (i = 0; i < D1SND_CACHE; i++)
	{
		d1snd_cache[i].path[0] = 0;
		d1snd_cache[i].frames  = NULL;
		d1snd_cache[i].count   = 0;
		d1snd_cache[i].rate    = 0;
		d1snd_cache[i].stamp   = 0;
		d1snd_cache[i].missing = FALSE;
	}
	for (i = 0; i < D1SND_VOICES; i++)
	{
		d1snd_voice[i].handle    = -1;
		d1snd_voice[i].cache_idx = -1;
		d1snd_voice[i].stamp     = 0;
	}
	d1snd_stamp       = 0;
	d1snd_mus_frames  = NULL;
	d1snd_mus_count   = 0;
	d1snd_mus_rate    = 0;
	d1snd_mus_handle  = -1;
	d1snd_mus_path[0] = 0;
	d1snd_ready       = TRUE;
}

U0 D1SndInit()
{
	D1SndInitState;
	d1snd_on = audio_present;
	if (!d1snd_on)
		"D1Snd: no AC97 device, audio off\n";
}


I64 D1SndCacheFind(U8 *path)
{
	I64 i;

	for (i = 0; i < D1SND_CACHE; i++)
	{
		if (d1snd_cache[i].path[0] && !StrCompare(d1snd_cache[i].path, path))
			return i;
	}
	return -1;
}

U0 D1SndCacheEvict(I64 idx)
{
	I64	 i;
	Bool stopped = FALSE;

	for (i = 0; i < D1SND_VOICES; i++)
	{
		if (d1snd_voice[i].cache_idx == idx && d1snd_voice[i].handle >= 0)
		{
			D1SndHwStop(d1snd_voice[i].handle);
			D1SndHwIdle(d1snd_voice[i].handle);
			d1snd_voice[i].handle    = -1;
			d1snd_voice[i].cache_idx = -1;
			stopped = TRUE;
		}
	}
	if (stopped)
		D1SndHwDrain;

	if (d1snd_cache[idx].frames)
		Free(d1snd_cache[idx].frames);
	d1snd_cache[idx].frames  = NULL;
	d1snd_cache[idx].count   = 0;
	d1snd_cache[idx].path[0] = 0;
	d1snd_cache[idx].missing = FALSE;
}

I64 D1SndCacheSlot()
{
	I64 i;
	I64 best = 0;

	for (i = 0; i < D1SND_CACHE; i++)
	{
		if (!d1snd_cache[i].path[0])
			return i;
		if (d1snd_cache[i].stamp < d1snd_cache[best].stamp)
			best = i;
	}
	D1SndCacheEvict(best);
	return best;
}

I64 D1SndCacheLoad(U8 *path)
{
	I64	 idx;
	I64	 size   = 0;
	I64	 rate   = 0;
	I64	 ncount;
	I64	 count  = 0;
	U8	*raw;
	U32	*native = NULL;
	U32	*frames;

	idx = D1SndCacheFind(path);
	if (idx >= 0)
	{
		d1snd_stamp++;
		d1snd_cache[idx].stamp = d1snd_stamp;
		if (d1snd_cache[idx].missing)
			return -1;
		return idx;
	}

	idx = D1SndCacheSlot();
	D1StrCopy(d1snd_cache[idx].path, path, D1SND_PATH);
	d1snd_stamp++;
	d1snd_cache[idx].stamp   = d1snd_stamp;
	d1snd_cache[idx].missing = TRUE;

	raw = D1MpqRead(path, &size);
	if (!raw)
		return -1;
	ncount = D1SndDecodeNative(raw, size, &native, &rate);
	Free(raw);
	if (!ncount)
		return -1;

	d1snd_cache[idx].frames  = native;
	d1snd_cache[idx].count   = ncount;
	d1snd_cache[idx].rate    = rate;
	d1snd_cache[idx].missing = FALSE;
	no_warn frames;
	no_warn count;
	return idx;
}


I64 D1SndVoiceSlot()
{
	I64 i;
	I64 best = 0;

	for (i = 0; i < D1SND_VOICES; i++)
	{
		if (d1snd_voice[i].handle < 0)
			return i;
		if (!D1SndHwPlaying(d1snd_voice[i].handle))
		{
			d1snd_voice[i].handle = -1;
			return i;
		}
		if (d1snd_voice[i].stamp < d1snd_voice[best].stamp)
			best = i;
	}
	D1SndHwStop(d1snd_voice[best].handle);
	d1snd_voice[best].handle = -1;
	return best;
}

U0 D1SndPlay(U8 *path)
{
	I64 idx;
	I64 v;
	I64 handle;

	if (!d1snd_ready || !d1snd_on)
		return;
	idx = D1SndCacheLoad(path);
	if (idx < 0)
		return;
	v = D1SndVoiceSlot();
	handle = D1SndHwPlay(d1snd_cache[idx].frames, d1snd_cache[idx].count,
		d1snd_cache[idx].rate, D1SndLinToHw(d1_snd_sfx_vol), FALSE);
	if (handle < 0)
		return;
	d1snd_stamp++;
	d1snd_voice[v].handle    = handle;
	d1snd_voice[v].cache_idx = idx;
	d1snd_voice[v].stamp     = d1snd_stamp;
}

U0 D1SndMonPath(U8 *dst, U8 *gfx_fmt, U8 letter, I64 variant)
{
	I64 i = 0;
	I64 o = 0;

	while (gfx_fmt[i] && gfx_fmt[i] != '%' && o < D1SND_PATH - 8)
	{
		dst[o] = gfx_fmt[i];
		o++;
		i++;
	}
	dst[o] = letter;
	o++;
	dst[o] = '0' + variant;
	o++;
	D1StrCopy(dst + o, ".WAV", 5);
}

U0 D1SndPlayMon(U8 *gfx_fmt, U8 letter)
{//monster voice; variant 1 or 2 at random (monster.cpp PlayEffect)
	U8 path[D1SND_PATH];

	if (!d1snd_ready || !d1snd_on)
		return;
	D1SndMonPath(path, gfx_fmt, letter, 1 + D1SndRnd2());
	D1SndPlay(path);
}


U0 D1SndMusicStop()
{
	if (d1snd_mus_handle >= 0)
	{
		D1SndHwStop(d1snd_mus_handle);
		D1SndHwIdle(d1snd_mus_handle);
		d1snd_mus_handle = -1;
		D1SndHwDrain;
	}
	if (d1snd_mus_frames)
	{
		Free(d1snd_mus_frames);
		d1snd_mus_frames = NULL;
	}
	d1snd_mus_count   = 0;
	d1snd_mus_rate    = 0;
	d1snd_mus_path[0] = 0;
}

U0 D1SndMusic(U8 *path)
{
	U8	*raw;
	I64	 size = 0;

	if (!d1snd_ready || !d1snd_on)
		return;
	if (path && d1snd_mus_frames && !StrCompare(d1snd_mus_path, path))
		return;

	D1SndMusicStop;
	if (!path)
		return;

	raw = D1MpqRead(path, &size);
	if (!raw)
		return;
	{
		U32	*nat = NULL;
		I64	 ncount;
		I64	 nrate = 0;

		ncount = D1SndDecodeNative(raw, size, &nat, &nrate);
		Free(raw);
		if (!ncount)
			return;
		d1snd_mus_frames = nat;
		d1snd_mus_count  = ncount;
		d1snd_mus_rate   = nrate;
	}
	D1StrCopy(d1snd_mus_path, path, D1SND_PATH);

	d1snd_mus_handle = D1SndHwPlay(d1snd_mus_frames, d1snd_mus_count,
		d1snd_mus_rate, D1SndLinToHw(d1_snd_mus_vol), TRUE);
}

U0 D1SndMusVolApply()
{//already-playing music voice follows the slider (sound.cpp snd_update)
	I64 v = D1SndLinToHw(d1_snd_mus_vol);

	D1SndHwVol(d1snd_mus_handle, v, v);
}

U0 D1SndMusicForLevel(I64 level)
{//sound.cpp sgszMusicTracks bands: town, L1-4, L5-8, L9-12, L13-16
	if (level == 0)
		D1SndMusic("Music\\DTowne.wav");
	else if (level <= 4)
		D1SndMusic("Music\\DLvlA.wav");
	else if (level <= 8)
		D1SndMusic("Music\\DLvlB.wav");
	else if (level <= 12)
		D1SndMusic("Music\\DLvlC.wav");
	else
		D1SndMusic("Music\\DLvlD.wav");
}


U0 D1SndStopAll()
{
	I64 i;

	if (!d1snd_ready)
		return;
	D1SndHwStopAllVoices;
	for (i = 0; i < D1SND_VOICES; i++)
	{
		d1snd_voice[i].handle    = -1;
		d1snd_voice[i].cache_idx = -1;
	}
	D1SndMusicStop;
	if (d1snd_vox_stop)
		(*d1snd_vox_stop)();
}

U0 D1SndFree()
{
	I64 i;

	if (!d1snd_ready)
		return;
	D1SndStopAll;
	for (i = 0; i < D1SND_CACHE; i++)
	{
		if (d1snd_cache[i].frames)
			Free(d1snd_cache[i].frames);
		d1snd_cache[i].frames  = NULL;
		d1snd_cache[i].count   = 0;
		d1snd_cache[i].path[0] = 0;
		d1snd_cache[i].missing = FALSE;
	}
	d1snd_ready = FALSE;
}
