// options persistence
//
// ::/Apps/Diablo1/OPTIONS.INI: KEY=VALUE text, one pair per line, integer
// values. devilutionX options.cpp diablo.ini equivalent.

#define D1_OPT_PATH		"::/Apps/Diablo1/OPTIONS.INI"
#define D1_OPT_MAXLEN	768

I64 D1OptParseInt(U8 *s, I64 *_i)
{
	I64 v   = 0;
	I64 neg = FALSE;
	I64 i   = *_i;

	if (s[i] == '-')
	{
		neg = TRUE;
		i++;
	}
	while (s[i] >= '0' && s[i] <= '9')
	{
		v = v * 10 + s[i] - '0';
		i++;
	}
	*_i = i;
	if (neg)
		return -v;
	return v;
}

Bool D1OptKeyIs(U8 *s, I64 i, U8 *key)
{
	I64 k = 0;

	while (key[k])
	{
		if (s[i + k] != key[k])
			return FALSE;
		k++;
	}
	return s[i + k] == '=';
}

U0 D1OptApply(U8 *s, I64 i)
{
	I64 v;
	I64 j = i;

	while (s[j] && s[j] != '=' && s[j] != '\n')
		j++;
	if (s[j] != '=')
		return;
	j++;
	v = D1OptParseInt(s, &j);

	if (D1OptKeyIs(s, i, "WIDTH"))
		D1SetWidth(v);
	else if (D1OptKeyIs(s, i, "HEIGHT"))
		D1SetHeight(v);
	else if (D1OptKeyIs(s, i, "ZOOM"))
	{
		if (v < 0)
			v = 0;
		if (v >= D1_ZOOM_N)
			v = D1_ZOOM_N - 1;
		d1_zoom_idx = v;
		D1ZoomRecalc;
	}
	else if (D1OptKeyIs(s, i, "FULLSCREEN"))
		d1_opt_full = ToBool(v);
	else if (D1OptKeyIs(s, i, "FIT"))
		d1_opt_fit = ToBool(v);
	else if (D1OptKeyIs(s, i, "INTSCALE"))
		d1_opt_int = ToBool(v);
	else if (D1OptKeyIs(s, i, "JOG"))
		d1_opt_jog = ToBool(v);
	else if (D1OptKeyIs(s, i, "SFX"))
		d1_opt_sfx = ToBool(v);
	else if (D1OptKeyIs(s, i, "MUSIC"))
		d1_opt_music = ToBool(v);
	else if (D1OptKeyIs(s, i, "APGOLD"))
		d1_opt_apgold = ToBool(v);
	else if (D1OptKeyIs(s, i, "APITEM"))
		d1_opt_apitem = ToBool(v);
	else if (D1OptKeyIs(s, i, "ENEMYHP"))
		d1_opt_enemyhp = ToBool(v);
	else if (D1OptKeyIs(s, i, "FLOATDMG"))
		d1_opt_floatdmg = ToBool(v);
	else if (D1OptKeyIs(s, i, "MONTYPE"))
		d1_opt_montype = ToBool(v);
	else if (D1OptKeyIs(s, i, "SFXVOL"))
	{
		if (v < 0)
			v = 0;
		if (v > 256)
			v = 256;
		d1_snd_sfx_vol = v;
	}
	else if (D1OptKeyIs(s, i, "MUSVOL"))
	{
		if (v < 0)
			v = 0;
		if (v > 256)
			v = 256;
		d1_snd_mus_vol = v;
		D1SndMusVolApply;
	}
	else if (D1OptKeyIs(s, i, "GAMMA"))
		D1PalGammaSet(v);
}

U0 D1OptLoad()
{
	I64	 size = 0;
	I64	 i    = 0;
	U8	*buf  = FileRead(D1_OPT_PATH, &size);

	if (!buf)
		return;
	while (i < size)
	{
		D1OptApply(buf, i);
		while (i < size && buf[i] != '\n')
			i++;
		i++;
	}
	Free(buf);
}

U0 D1OptSave()
{
	U8	buf[D1_OPT_MAXLEN];

	StrPrint(buf,
		"WIDTH=%d\nHEIGHT=%d\nZOOM=%d\nFULLSCREEN=%d\nFIT=%d\n"
		"INTSCALE=%d\nJOG=%d\nSFX=%d\nMUSIC=%d\n"
		"SFXVOL=%d\nMUSVOL=%d\nGAMMA=%d\n"
		"APGOLD=%d\nAPITEM=%d\nENEMYHP=%d\nFLOATDMG=%d\nMONTYPE=%d\n",
		d1_w, d1_h, d1_zoom_idx, d1_opt_full, d1_opt_fit,
		d1_opt_int, d1_opt_jog, d1_opt_sfx, d1_opt_music,
		d1_snd_sfx_vol, d1_snd_mus_vol, d1_gamma,
		d1_opt_apgold, d1_opt_apitem, d1_opt_enemyhp, d1_opt_floatdmg,
		d1_opt_montype);
	FileWrite(D1_OPT_PATH, buf, StrLen(buf));
}

D1OptLoad;
