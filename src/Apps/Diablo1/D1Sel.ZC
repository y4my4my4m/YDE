// D1Sel.ZC - single player front end: slot list, class pick, name entry
//
// mirrors DiabloUI selhero.cpp reduced to what the port carries. art:
//   ui_art\selhero.pcx  640x480 frame, own palette in the file tail
//   ui_art\heros.pcx    180x304, four stacked 180x76 portraits, class order
//                       warrior/rogue/sorcerer then a blended "no hero"
//                       (SelHero_SetStaticBMP offsets by heroclass, 3 = none)
// the frame's boxes, measured off the pcx: portrait 30,211 180x76; stat box
// 30,301 to 209,461; list panel 240,211 to 608,420 with a rule at y 243.
//
// state machine, polled by the shell. keyboard edges are tracked here; the
// shell forwards MESSAGE_KEY_DOWN to D1SelKey while name entry is up.
//
// every coordinate here is band-local to the 640x480 frame: draws add
// D1UiOrgX()/D1UiOrgY(); D1SelRowY carries the y origin, so D1SelHit
// compares canvas y directly.

#define D1SEL_OFF		0
#define D1SEL_HERO		1
#define D1SEL_CLASS		2
#define D1SEL_NAME		3
#define D1SEL_DEL		4

#define D1SEL_NONE		0
#define D1SEL_LOADED	1
#define D1SEL_NEW		2
#define D1SEL_BACK		3

#define D1SEL_NAMEMAX	15

//artfont cells pad with index 32, not the 250 the rest of ui_art keys on.
//32 is near black in the main menu palette and brown in this one, so the
//glyph blitter here drops both.
#define D1SEL_FKEY		32

//list panel geometry
#define D1SEL_PX		240
#define D1SEL_PX2		608
#define D1SEL_PCX		424
#define D1SEL_ROW0		258
#define D1SEL_ROWH		30
#define D1SEL_TEXTH		22
#define D1SEL_INFO0		364			//two info lines above the panel rule
#define D1SEL_INFO1		392

I64	 d1_sel_state   = D1SEL_OFF;
I64	 d1_sel_row     = 0;
I64	 d1_sel_outcome = D1SEL_NONE;
I64	 d1_sel_cls     = 0;			//class chosen on the class screen
I64	 d1_sel_target  = 0;			//slot a new character is written to
I64	 d1_sel_delslot = 0;
I64	 d1_sel_anim    = 0;
I64	 d1_sel_namelen = 0;
U8	 d1_sel_name[32];

Bool d1_sel_ok[D1_SAVE_SLOTS];
U8	 d1_sel_sname[D1_SAVE_SLOTS][32];
I64	 d1_sel_scls[D1_SAVE_SLOTS];
I64	 d1_sel_slvl[D1_SAVE_SLOTS];

U8	*d1_sel_bg    = NULL;
U8	*d1_sel_heros = NULL;
U8	 d1_sel_pal[768];

Bool d1_sel_h_up    = FALSE;
Bool d1_sel_h_down  = FALSE;
Bool d1_sel_h_enter = FALSE;
Bool d1_sel_h_esc   = FALSE;
Bool d1_sel_h_del   = FALSE;

//two lines each, sized to the list panel
U8 *d1_sel_blurb0[D1_NCLASS] = {
	"Master of sword and shield,",
	"Deadly with the bow,",
	"Wields fire, lightning, ice,"};
U8 *d1_sel_blurb1[D1_NCLASS] = {
	"strongest of the three.",
	"quick and well balanced.",
	"frail of body, deep in mana."};

U0 D1SelGlyph(I64 sx, I64 sy, I64 c, I64 w)
{//D1UiGlyphDraw with the artfont's own key as well
	I64 x;
	I64 y;
	I64 v;

	for (y = 0; y < d1_font24_h; y++)
		for (x = 0; x < w; x++)
		{
			v = d1_font24_px[(c * d1_font24_h + y) * d1_font24_w + x];
			if (v != D1UI_TRANS && v != D1SEL_FKEY)
				D1Pix(sx + x, sy + y, v);
		}
}

U0 D1SelText(I64 cx, I64 sy, U8 *str)
{//font24, centered on band-local cx, top anchored. sy is CANVAS y: rows
 //come from D1SelRowY, fixed boxes add D1UiOrgY() at the call site.
	I64 i = 0;
	I64 g;
	I64 sx;

	if (!d1_font24_px)
		return;
	sx = D1UiOrgX() + cx -
		D1UiTextWidth(d1_font24_wd, d1_font24_sp, str) / 2;
	while (str[i])
	{
		g = d1_font24_wd[str[i]];
		if (g)
			D1SelGlyph(sx, sy, str[i], g);
		else
			g = d1_font24_sp;
		sx += g;
		i++;
	}
}

Bool D1SelEdge(I64 sc, Bool *held)
{//one TRUE per press; local copy, the shell's edge state stays untouched
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

U0 D1SelScan()
{//slot headers only
	I64 i;

	for (i = 0; i < D1_SAVE_SLOTS; i++)
		d1_sel_ok[i] = D1SaveProbe(i, d1_sel_sname[i], &d1_sel_scls[i],
			&d1_sel_slvl[i]);
}

I64 D1SelFreeSlot()
{//first empty slot, -1 when all three are taken
	I64 i;
	I64 r = -1;

	for (i = D1_SAVE_SLOTS - 1; i >= 0; i--)
	{
		if (!d1_sel_ok[i])
			r = i;
	}
	return r;
}

I64 D1SelRows()
{
	if (d1_sel_state == D1SEL_HERO)
		return D1_SAVE_SLOTS + 1;		//slots plus New Character
	if (d1_sel_state == D1SEL_CLASS)
		return D1_NCLASS;
	if (d1_sel_state == D1SEL_DEL)
		return 2;
	return 0;
}

I64 D1SelRowY(I64 i)
{//canvas y: band-local row plus the band's top edge
	return D1UiOrgY() + D1SEL_ROW0 + i * D1SEL_ROWH;
}

U8 *D1SelRowText(U8 *dst, I64 i)
{//dst holds at least 64 bytes
	dst[0] = 0;
	if (d1_sel_state == D1SEL_HERO)
	{
		if (i >= D1_SAVE_SLOTS)
			StrPrint(dst, "New Character");
		else if (d1_sel_ok[i])
			StrPrint(dst, "%s  Level %d", d1_sel_sname[i], d1_sel_slvl[i]);
		else
			StrPrint(dst, "Empty Slot %d", i + 1);
	}
	else if (d1_sel_state == D1SEL_CLASS)
		StrPrint(dst, "%s", d1_cls_name[i]);
	else if (d1_sel_state == D1SEL_DEL)
	{
		if (i == 0)
			StrPrint(dst, "Yes");
		else
			StrPrint(dst, "No");
	}
	return dst;
}

I64 D1SelPortrait()
{//heros.pcx frame; 3 is the no-hero blend
	I64 cls;

	if (d1_sel_state == D1SEL_CLASS)
		cls = d1_sel_row;
	else if (d1_sel_state == D1SEL_NAME)
		cls = d1_sel_cls;
	else if (d1_sel_state == D1SEL_DEL)
		cls = d1_sel_scls[d1_sel_delslot];
	else if (d1_sel_row < D1_SAVE_SLOTS && d1_sel_ok[d1_sel_row])
		cls = d1_sel_scls[d1_sel_row];
	else
		return 3;

	if (cls < 0 || cls >= D1_NCLASS)
		return 3;
	return cls;
}

U0 D1SelEnter()
{
	I64 w;
	I64 h;

	//fonts, flame logo, pentagram spinner, ui cursor
	D1MMenuLoad;
	if (!d1_sel_bg)
		d1_sel_bg = D1PcxRead("ui_art\\selhero.pcx", &w, &h, d1_sel_pal);
	if (!d1_sel_heros)
		d1_sel_heros = D1PcxRead("ui_art\\heros.pcx", &w, &h, NULL);
	if (d1_sel_bg)
		D1PalSetRaw(d1_sel_pal);

	D1SelScan;
	d1_sel_state   = D1SEL_HERO;
	d1_sel_row     = 0;
	d1_sel_outcome = D1SEL_NONE;
	d1_sel_namelen = 0;
	d1_sel_name[0] = 0;
}

I64 D1SelState()
{
	return d1_sel_state;
}

I64 D1SelOutcome()
{
	return d1_sel_outcome;
}

U0 D1SelOutcomeClear()
{
	d1_sel_outcome = D1SEL_NONE;
}

U0 D1SelBack()
{
	if (d1_sel_state == D1SEL_CLASS)
	{
		d1_sel_state = D1SEL_HERO;
		d1_sel_row   = d1_sel_target;
	}
	else if (d1_sel_state == D1SEL_NAME)
	{
		d1_sel_state = D1SEL_CLASS;
		d1_sel_row   = d1_sel_cls;
	}
	else if (d1_sel_state == D1SEL_DEL)
	{
		d1_sel_state = D1SEL_HERO;
		d1_sel_row   = d1_sel_delslot;
	}
	else
	{
		d1_sel_state   = D1SEL_OFF;
		d1_sel_outcome = D1SEL_BACK;
	}
}

U0 D1SelAccept()
{
	I64 free_slot;

	if (d1_sel_state == D1SEL_HERO)
	{
		if (d1_sel_row < D1_SAVE_SLOTS && d1_sel_ok[d1_sel_row])
		{
			if (D1SaveRead(d1_sel_row))
			{
				//autosave / Save Game write d1_save_slot from d1_sel_target;
				//without this, load left target at the last NEW slot and
				//loot vanished into the wrong SAVE*.DAT
				d1_sel_target  = d1_sel_row;
				d1_sel_state   = D1SEL_OFF;
				d1_sel_outcome = D1SEL_LOADED;
			}
			return;
		}
		if (d1_sel_row < D1_SAVE_SLOTS)
			free_slot = d1_sel_row;
		else
			free_slot = D1SelFreeSlot();
		if (free_slot < 0)
			return;					//three characters is the cap
		d1_sel_target = free_slot;
		d1_sel_state  = D1SEL_CLASS;
		d1_sel_row    = 0;
		return;
	}

	if (d1_sel_state == D1SEL_CLASS)
	{
		d1_sel_cls     = d1_sel_row;
		d1_sel_state   = D1SEL_NAME;
		d1_sel_namelen = 0;
		d1_sel_name[0] = 0;
		return;
	}

	if (d1_sel_state == D1SEL_NAME)
	{
		D1SaveResetState;
		if (d1_sel_namelen > 0)
			D1CharCreate(d1_sel_cls, d1_sel_name);
		else
			D1CharCreate(d1_sel_cls, NULL);
		D1SaveWrite(d1_sel_target);
		d1_sel_state   = D1SEL_OFF;
		d1_sel_outcome = D1SEL_NEW;
		return;
	}

	if (d1_sel_state == D1SEL_DEL)
	{
		if (d1_sel_row == 0)
			D1SaveDelete(d1_sel_delslot);
		D1SelScan;
		d1_sel_state = D1SEL_HERO;
		d1_sel_row   = d1_sel_delslot;
	}
}

U0 D1SelKeys()
{//edges are read every frame so a key held across a screen change re-arms
	Bool e_up    = D1SelEdge(SC_CURSOR_UP,   &d1_sel_h_up);
	Bool e_down  = D1SelEdge(SC_CURSOR_DOWN, &d1_sel_h_down);
	Bool e_enter = D1SelEdge(SC_ENTER,       &d1_sel_h_enter);
	Bool e_esc   = D1SelEdge(SC_ESC,         &d1_sel_h_esc);
	Bool e_del   = D1SelEdge(SC_DELETE,      &d1_sel_h_del);
	I64	 n       = D1SelRows();

	if (d1_sel_state == D1SEL_OFF || d1_sel_state == D1SEL_NAME)
		return;						//name entry runs off D1SelKey

	if (e_up && n > 0)
	{
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Items\\Titlemov.wav");
		d1_sel_row--;
		if (d1_sel_row < 0)
			d1_sel_row = n - 1;
	}
	if (e_down && n > 0)
	{
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Items\\Titlemov.wav");
		d1_sel_row++;
		if (d1_sel_row >= n)
			d1_sel_row = 0;
	}
	if (e_del && d1_sel_state == D1SEL_HERO && d1_sel_row < D1_SAVE_SLOTS &&
		d1_sel_ok[d1_sel_row])
	{
		d1_sel_delslot = d1_sel_row;
		d1_sel_state   = D1SEL_DEL;
		d1_sel_row     = 1;			//default to No
	}
	if (e_enter)
	{
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Items\\Titlslct.wav");
		D1SelAccept;
	}
	if (e_esc)
		D1SelBack;
}

U0 D1SelKey(I64 scancode, U8 ch)
{//name entry only; scancode carries modifier flags above the low byte
	I64 sc = scancode & 0xFF;

	if (d1_sel_state != D1SEL_NAME)
		return;

	if (sc == SC_ENTER)
	{
		D1SelAccept;
		return;
	}
	if (sc == SC_ESC)
	{
		D1SelBack;
		return;
	}
	if (sc == SC_BACKSPACE)
	{
		if (d1_sel_namelen > 0)
		{
			d1_sel_namelen--;
			d1_sel_name[d1_sel_namelen] = 0;
		}
		return;
	}
	if (ch >= ' ' && ch < 0x7F && d1_sel_namelen < D1SEL_NAMEMAX)
	{
		d1_sel_name[d1_sel_namelen] = ch;
		d1_sel_namelen++;
		d1_sel_name[d1_sel_namelen] = 0;
	}
}

I64 D1SelHit(I64 cx, I64 cy)
{//row index under a canvas point, -1 none
	I64 i;
	I64 y;
	I64 n = D1SelRows();

	cx -= D1UiOrgX();
	if (cx < D1SEL_PX || cx > D1SEL_PX2)
		return -1;
	for (i = 0; i < n; i++)
	{
		y = D1SelRowY(i);
		if (cy >= y && cy < y + D1SEL_TEXTH)
			return i;
	}
	return -1;
}

Bool D1SelClick(I64 cx, I64 cy)
{
	I64 i;

	if (d1_sel_state == D1SEL_OFF)
		return FALSE;
	i = D1SelHit(cx, cy);
	if (i < 0)
		return FALSE;
	d1_sel_row = i;
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Titlslct.wav");
	D1SelAccept;
	return TRUE;
}

U0 D1SelStatBox()
{//left lower box: attributes on the class screens, the slot line otherwise
	U8	 line[64];
	I64	 cls  = -1;
	I64	 slot = -1;
	I64	 y    = D1UiOrgY() + 312;

	if (d1_sel_state == D1SEL_CLASS)
		cls = d1_sel_row;
	else if (d1_sel_state == D1SEL_NAME)
		cls = d1_sel_cls;
	else if (d1_sel_state == D1SEL_DEL)
		slot = d1_sel_delslot;
	else if (d1_sel_row < D1_SAVE_SLOTS)
		slot = d1_sel_row;

	if (cls >= 0 && cls < D1_NCLASS)
	{
		StrPrint(line, "Strength %d", d1_cls_str[cls]);
		D1SelText(120, y, line);
		StrPrint(line, "Magic %d", d1_cls_mag[cls]);
		D1SelText(120, y + 30, line);
		StrPrint(line, "Dexterity %d", d1_cls_dex[cls]);
		D1SelText(120, y + 60, line);
		StrPrint(line, "Vitality %d", d1_cls_vit[cls]);
		D1SelText(120, y + 90, line);
		return;
	}

	if (slot >= 0 && d1_sel_ok[slot])
	{
		cls = d1_sel_scls[slot];
		if (cls < 0 || cls >= D1_NCLASS)
			cls = 0;
		D1SelText(120, y, d1_sel_sname[slot]);
		D1SelText(120, y + 30, d1_cls_name[cls]);
		StrPrint(line, "Level %d", d1_sel_slvl[slot]);
		D1SelText(120, y + 60, line);
	}
}

U0 D1SelDraw()
{
	I64	 i;
	I64	 y;
	I64	 n;
	I64	 f;
	I64	 hov;
	I64	 ox = D1UiOrgX();
	I64	 oy = D1UiOrgY();
	U8	 line[64];
	U8	*head;

	if (d1_sel_state == D1SEL_OFF)
		return;

	d1_sel_anim++;
	hov = D1SelHit(D1MouseX(), D1MouseY());
	if (hov >= 0)
		d1_sel_row = hov;

	D1Clear(0);
	if (d1_sel_bg)
		D1Blit8(ox, oy, d1_sel_bg, 640, 480);

	if (d1_smlogo)
		D1Blit8Key(ox + D1_UI_W / 2 - 195, oy,
			d1_smlogo + ((d1_sel_anim / 3) % 15) * 390 * 154, 390, 154,
			D1UI_TRANS);

	if (d1_sel_heros)
		D1Blit8(ox + 30, oy + 211, d1_sel_heros + D1SelPortrait() * 180 * 76,
			180, 76);

	D1SelStatBox;

	head = "Single Player Characters";
	if (d1_sel_state == D1SEL_CLASS)
		head = "Choose Class";
	else if (d1_sel_state == D1SEL_NAME)
		head = "Enter Name";
	else if (d1_sel_state == D1SEL_DEL)
		head = "Delete Character?";
	D1SelText(D1SEL_PCX, oy + 216, head);

	if (d1_sel_state == D1SEL_NAME)
	{
		//~1 Hz caret; d1_sel_anim & 8 was frame-locked and raced the
		//unlocked menu loop
		if (ToI64(tS * 2.0) & 1)
			StrPrint(line, "%s_", d1_sel_name);
		else
			StrPrint(line, "%s", d1_sel_name);
		D1SelText(D1SEL_PCX, D1SelRowY(0), line);
		D1SelText(D1SEL_PCX, D1SelRowY(2), d1_cls_name[d1_sel_cls]);
		D1SelText(D1SEL_PCX, oy + D1SEL_INFO0, d1_sel_blurb0[d1_sel_cls]);
		D1SelText(D1SEL_PCX, oy + D1SEL_INFO1, d1_sel_blurb1[d1_sel_cls]);
		return;
	}

	n = D1SelRows();
	for (i = 0; i < n; i++)
	{
		y = D1SelRowY(i);
		D1SelRowText(line, i);
		D1SelText(D1SEL_PCX, y, line);

		if (i == d1_sel_row && d1_focus42)
		{//pentagram spinners at the panel edges, centered on the row. row
		 //pitch is 30 and the spinner 42, so text-hugging placement would
		 //cover the neighbours
			f = (d1_sel_anim / 3) % 8;
			D1Blit8Key(ox + D1SEL_PX + 6, y - 9,
				d1_focus42 + f * 42 * 42, 42, 42, D1UI_TRANS);
			D1Blit8Key(ox + D1SEL_PX2 - 48, y - 9,
				d1_focus42 + f * 42 * 42, 42, 42, D1UI_TRANS);
		}
	}

	if (d1_sel_state == D1SEL_CLASS)
	{
		D1SelText(D1SEL_PCX, oy + D1SEL_INFO0, d1_sel_blurb0[d1_sel_row]);
		D1SelText(D1SEL_PCX, oy + D1SEL_INFO1, d1_sel_blurb1[d1_sel_row]);
	}
	else if (d1_sel_state == D1SEL_HERO)
		D1SelText(D1SEL_PCX, oy + D1SEL_INFO1, "DEL erases a character");
}
