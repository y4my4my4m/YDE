// variable-size 8bpp back buffer and the window blit
//
// game code writes palette indices into d1_screen; the compositor expands them
// through d1_argb (QDrawBlitFit pattern).
//
// the buffer is allocated once at D1_W_MAX x D1_H_MAX. the row stride is the
// constant D1_W_MAX, never d1_w; d1_w and d1_h are the active canvas size and
// only clip. every plot, blit and readback indexes rows by D1_W_MAX.
//
// UI art is 640x480 at every canvas size, drawn in the centered band at
// D1UiOrgX()/D1UiOrgY() (devilutionX display.cpp CalculateUIRectangle). the
// control panel anchors to the bottom edge at D1PanelTop() (control_panel.cpp
// CalculatePanelAreas). the world renderer centers on (d1_w / 2, d1_vp_h / 2).

#define D1_W_MAX	1280
#define D1_H_MAX	960
#define D1_UI_W		640
#define D1_UI_H		480
#define D1_PANEL_H	128
#define D1_ZOOM_ONE		65536			//16.16 magnification, 1.00x
#define D1_ZOOM_RECIP	0x100000000		//2^32, the reciprocal numerator
#define D1_ZOOM_N		19
#define D1_ZOOM_1X		4
#define D1_ZOOM_2X		12

U8	*d1_screen  = NULL;
I64	 d1_w       = D1_UI_W;
I64	 d1_h       = D1_UI_H;
Bool d1_ready   = FALSE;
I64	 d1_vp_h    = D1_UI_H;

Bool d1_zoom       = FALSE;
I64	 d1_zoom_idx   = D1_ZOOM_1X;
I64	 d1_zoom_scale = 65536;		//16.16, always d1_zoom_tbl[d1_zoom_idx]
Bool d1_opt_jog    = TRUE;
Bool d1_opt_sfx    = TRUE;
Bool d1_opt_music  = TRUE;
Bool d1_opt_full   = TRUE;
Bool d1_opt_fit    = FALSE;
Bool d1_opt_int    = FALSE;
Bool d1_opt_apgold = TRUE;
Bool d1_opt_montype = FALSE;
Bool d1_opt_apitem = FALSE;
Bool d1_opt_enemyhp = TRUE;
Bool d1_opt_floatdmg = FALSE;
U8	*d1_zoom_buf   = NULL;

#define D1_MAXFLOAT		32
#define D1_FLOAT_LIFE	40		//ticks at 20Hz (~2s)

class CD1Float
{
	I64	 x;
	I64	 y;
	I64	 oy;
	I64	 val;
	I64	 life;
	I64	 col;		//D1COL_* for Clr, or -1 = solid brightest
	Bool exp;
	Bool active;
};

CD1Float d1_floats[D1_MAXFLOAT];

U0 D1FloatSpawn(I64 x, I64 y, I64 val, I64 col, Bool exp)
{//val is the shown figure (already >>6 for hp damage)
	I64 i;

	if (!d1_opt_floatdmg || val == 0)
		return;
	if (val < 0)
		val = -val;
	for (i = 0; i < D1_MAXFLOAT; i++)
	{
		if (!d1_floats[i].active)
		{
			d1_floats[i].x      = x;
			d1_floats[i].y      = y;
			d1_floats[i].oy     = 0;
			d1_floats[i].val    = val;
			d1_floats[i].life   = D1_FLOAT_LIFE;
			d1_floats[i].col    = col;
			d1_floats[i].exp    = exp;
			d1_floats[i].active = TRUE;
			return;
		}
	}
}

U0 D1FloatTick()
{
	I64 i;

	for (i = 0; i < D1_MAXFLOAT; i++)
	{
		if (d1_floats[i].active)
		{
			d1_floats[i].oy += 1;
			d1_floats[i].life--;
			if (d1_floats[i].life <= 0)
				d1_floats[i].active = FALSE;
		}
	}
}


I64 d1_zoom_tbl[19] = {32768, 40960, 49152, 57344,
	65536, 73728, 81920, 90112, 98304, 106496, 114688,
	122880, 131072, 147456, 163840, 180224, 196608, 229376, 262144};

I64	 d1_blit_x = 0;
I64	 d1_blit_y = 0;
I64	 d1_blit_w = D1_UI_W;
I64	 d1_blit_h = D1_UI_H;

I64 D1UiOrgX()
{//left edge of the centered 640-wide UI band
	return (d1_w - D1_UI_W) / 2;
}

I64 D1UiOrgY()
{
	return (d1_h - D1_UI_H) / 2;
}

I64 D1PanelTop()
{
	return d1_h - D1_PANEL_H;
}

U0 D1ScreenInit()
{
	if (!d1_screen)
		d1_screen = CAlloc(D1_W_MAX * D1_H_MAX);
	MemSet(d1_screen, 0, D1_W_MAX * D1_H_MAX);
}

U0 D1Clear(I64 color)
{
	MemSet(d1_screen, color, D1_W_MAX * D1_H_MAX);
}

U0 D1SetWidth(I64 w)
{
	if (w < D1_UI_W)
		w = D1_UI_W;
	if (w > D1_W_MAX)
		w = D1_W_MAX;
	w -= w % 4;
	d1_w = w;
	if (d1_screen)
		D1Clear(0);
}

U0 D1SetHeight(I64 h)
{
	if (h < D1_UI_H)
		h = D1_UI_H;
	if (h > D1_H_MAX)
		h = D1_H_MAX;
	h -= h % 4;
	d1_h = h;
	if (d1_screen)
		D1Clear(0);
}

U0 D1Pix(I64 x, I64 y, I64 color)
{
	if (x >= 0 && x < d1_w && y >= 0 && y < d1_h)
		d1_screen[y * D1_W_MAX + x] = color;
}

U0 D1FillRect(I64 x, I64 y, I64 w, I64 h, I64 color)
{
	I64 i;
	I64 j;

	for (j = 0; j < h; j++)
		for (i = 0; i < w; i++)
			D1Pix(x + i, y + j, color);
}


U0 D1ZoomSync()
{
	if (d1_zoom && d1_zoom_scale == D1_ZOOM_ONE)
	{
		d1_zoom_idx   = D1_ZOOM_2X;
		d1_zoom_scale = d1_zoom_tbl[D1_ZOOM_2X];
	}
	if (!d1_zoom && d1_zoom_scale != D1_ZOOM_ONE)
	{
		d1_zoom_idx   = D1_ZOOM_1X;
		d1_zoom_scale = D1_ZOOM_ONE;
	}
}

I64 D1ZoomInv()
{
	D1ZoomSync;
	if (d1_zoom_scale == D1_ZOOM_ONE)
		return D1_ZOOM_ONE;
	return (D1_ZOOM_RECIP + d1_zoom_scale / 2) / d1_zoom_scale;
}

I64 D1ZoomMinScale()
{
	I64 mw = (d1_w << 16) / D1_W_MAX;
	I64 mh = (d1_h << 16) / D1_H_MAX;

	if (mh > mw)
		mw = mh;
	if (mw > D1_ZOOM_ONE)
		mw = D1_ZOOM_ONE;
	return mw;
}

I64 D1ZoomOrgX()
{
	I64 c = d1_w / 2;

	D1ZoomSync;
	if (!d1_zoom)
		return 0;
	return c - ((c * D1ZoomInv() + 32768) >> 16);
}

I64 D1ZoomOrgY()
{
	I64 c = d1_vp_h / 2;

	D1ZoomSync;
	if (!d1_zoom)
		return 0;
	return c - ((c * D1ZoomInv() + 32768) >> 16);
}

I64 D1ZoomToWorldX(I64 sx)
{
	if (!d1_zoom)
		return sx;
	return D1ZoomOrgX() + ((sx * D1ZoomInv()) >> 16);
}

I64 D1ZoomToWorldY(I64 sy)
{
	if (!d1_zoom)
		return sy;
	return D1ZoomOrgY() + ((sy * D1ZoomInv()) >> 16);
}

I64 D1ZoomToScreenX(I64 wx)
{
	if (!d1_zoom)
		return wx;
	return ((wx - D1ZoomOrgX()) * d1_zoom_scale) >> 16;
}

I64 D1ZoomToScreenY(I64 wy)
{
	if (!d1_zoom)
		return wy;
	return ((wy - D1ZoomOrgY()) * d1_zoom_scale) >> 16;
}

I64 D1ZoomLen(I64 n)
{
	if (!d1_zoom)
		return n;
	return (n * d1_zoom_scale) >> 16;
}

U0 D1ZoomRecalc()
{
	I64 min = D1ZoomMinScale();

	if (d1_zoom_idx < 0)
		d1_zoom_idx = 0;
	if (d1_zoom_idx >= D1_ZOOM_N)
		d1_zoom_idx = D1_ZOOM_N - 1;
	while (d1_zoom_idx < D1_ZOOM_1X && d1_zoom_tbl[d1_zoom_idx] < min)
		d1_zoom_idx++;
	d1_zoom_scale = d1_zoom_tbl[d1_zoom_idx];
	if (d1_zoom_scale != D1_ZOOM_ONE)
		d1_zoom = TRUE;
	else
		d1_zoom = FALSE;
}

U0 D1ZoomStep(I64 dir)
{
	D1ZoomSync;
	d1_zoom_idx += dir;
	D1ZoomRecalc;
}

U0 D1ZoomToggle()
{
	D1ZoomSync;
	if (d1_zoom_scale != D1_ZOOM_ONE)
		d1_zoom_idx = D1_ZOOM_1X;
	else
		d1_zoom_idx = D1_ZOOM_2X;
	D1ZoomRecalc;
}

U0 D1ZoomApply()
{
	I64	 inv;
	I64	 ox;
	I64	 oy;
	I64	 sw;
	I64	 sh;
	I64	 x;
	I64	 y;
	I64	 sx;
	I64	 sy;
	I64	 sxf;
	I64	 syf;
	I64	 prev;
	U8	*src;
	U8	*dst;

	D1ZoomSync;
	if (d1_zoom_scale <= D1_ZOOM_ONE)
		return;					//scale < 1 minifies through D1ZoomOutApply

	inv = D1ZoomInv();
	ox  = D1ZoomOrgX();
	oy  = D1ZoomOrgY();
	sw  = (d1_w * inv) >> 16;
	sh  = (d1_h * inv) >> 16;

	if (ox < 0)
		ox = 0;
	if (oy < 0)
		oy = 0;
	if (sw > d1_w - ox)
		sw = d1_w - ox;
	if (sh > d1_h - oy)
		sh = d1_h - oy;
	if (sw < 1)
		sw = 1;
	if (sh < 1)
		sh = 1;

	if (!d1_zoom_buf)
		d1_zoom_buf = CAlloc(D1_W_MAX * D1_H_MAX);

	for (y = 0; y < sh; y++)
	{
		src = d1_screen + (y + oy) * D1_W_MAX + ox;
		dst = d1_zoom_buf + y * D1_W_MAX;
		MemCopy(dst, src, sw);
	}

	syf  = 0;
	prev = -1;
	for (y = 0; y < d1_h; y++)
	{
		sy = syf >> 16;
		if (sy >= sh)
			sy = sh - 1;
		dst = d1_screen + y * D1_W_MAX;
		if (sy == prev)
			MemCopy(dst, dst - D1_W_MAX, d1_w);
		else
		{
			src = d1_zoom_buf + sy * D1_W_MAX;
			sxf = 0;
			for (x = 0; x < d1_w; x++)
			{
				sx = sxf >> 16;
				if (sx >= sw)
					sx = sw - 1;
				dst[x] = src[sx];
				sxf += inv;
			}
			prev = sy;
		}
		syf += inv;
	}
}

I64 D1ZoomOutW()
{
	I64 w = (d1_w * D1ZoomInv()) >> 16;

	if (w > D1_W_MAX)
		w = D1_W_MAX;
	if (w < d1_w)
		w = d1_w;
	return w;
}

I64 D1ZoomOutH()
{
	I64 h = (d1_h * D1ZoomInv()) >> 16;

	if (h > D1_H_MAX)
		h = D1_H_MAX;
	if (h < d1_h)
		h = d1_h;
	return h;
}

U0 D1ZoomOutApply()
{
	I64	 inv = D1ZoomInv();
	I64	 rw  = D1ZoomOutW();
	I64	 rh  = D1ZoomOutH();
	I64	 x;
	I64	 y;
	I64	 sx;
	I64	 sy;
	I64	 sxf;
	I64	 syf;
	U8	*src;
	U8	*dst;

	D1ZoomSync;
	if (d1_zoom_scale >= D1_ZOOM_ONE)
		return;

	if (!d1_zoom_buf)
		d1_zoom_buf = CAlloc(D1_W_MAX * D1_H_MAX);

	for (y = 0; y < rh; y++)
		MemCopy(d1_zoom_buf + y * D1_W_MAX, d1_screen + y * D1_W_MAX, rw);

	syf = 0;
	for (y = 0; y < d1_h; y++)
	{
		sy = syf >> 16;
		if (sy >= rh)
			sy = rh - 1;
		src = d1_zoom_buf + sy * D1_W_MAX;
		dst = d1_screen + y * D1_W_MAX;
		sxf = 0;
		for (x = 0; x < d1_w; x++)
		{
			sx = sxf >> 16;
			if (sx >= rw)
				sx = rw - 1;
			dst[x] = src[sx];
			sxf += inv;
		}
		syf += inv;
	}
}


U0 D1WindowApply()
{
	if (d1_opt_full)
		WinMax;
	else
	{
		WinHorz(2, 2 + (d1_w / FONT_WIDTH));
		WinVert(2, 2 + (d1_h / FONT_HEIGHT));
	}
}

U0 D1BlitFit(CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w, I64 dst_h)
{
	U8	*src;
	U32	*dst;
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 pitch = dc->width_internal;

	if (dst_w < 1 || dst_h < 1)
		return;

	sx_step = (d1_w << 16) / dst_w;
	sy_step = (d1_h << 16) / dst_h;

	for (y = 0; y < dst_h; y++)
	{
		py = dst_y + y;
		if (py >= 0 && py < dc->height)
		{
			sy = (y * sy_step) >> 16;
			if (sy >= d1_h)
				sy = d1_h - 1;

			src = d1_screen + sy * D1_W_MAX;
			dst = dc->body + py * pitch;
			sxf = 0;

			for (x = 0; x < dst_w; x++)
			{
				if (dst_x + x >= 0 && dst_x + x < dc->width)
					dst[dst_x + x] = d1_argb[src[sxf >> 16]];
				sxf += sx_step;
			}
		}
	}
}

U0 D1DrawIt(CTask *task, CDC *dc)
{
	I64 w;
	I64 h;
	I64 bw;
	I64 bh;
	I64 k;
	I64 kx;
	I64 ky;

	no_warn task;

	if (!d1_ready || !d1_screen || !d1_pal_loaded)
		return;

	w = dc->width;
	h = dc->height;

	if (d1_opt_fit)
	{
		bw = w;
		bh = h;
	}
	else
	{
		bw = w;
		bh = (w * d1_h) / d1_w;
		if (bh > h)
		{
			bh = h;
			bw = (h * d1_w) / d1_h;
		}

		if (d1_opt_int)
		{
			kx = w / d1_w;
			ky = h / d1_h;
			k  = kx;
			if (ky < k)
				k = ky;
			if (k >= 1)
			{
				bw = d1_w * k;
				bh = d1_h * k;
			}
		}
	}

	d1_blit_x = (w - bw) / 2;
	d1_blit_y = (h - bh) / 2;
	d1_blit_w = bw;
	d1_blit_h = bh;

	D1BlitFit(dc, d1_blit_x, d1_blit_y, bw, bh);
}

I64 D1MouseX()
{
	I64 mx = mouse.pos.x - Fs->pix_left - Fs->scroll_x;
	I64 v;

	if (d1_blit_w < 1)
		return 0;
	v = ((mx - d1_blit_x) * d1_w) / d1_blit_w;
	if (v < 0)
		v = 0;
	if (v >= d1_w)
		v = d1_w - 1;
	return v;
}

I64 D1MouseY()
{
	I64 my = mouse.pos.y - Fs->pix_top - Fs->scroll_y;
	I64 v;

	if (d1_blit_h < 1)
		return 0;
	v = ((my - d1_blit_y) * d1_h) / d1_blit_h;
	if (v < 0)
		v = 0;
	if (v >= d1_h)
		v = d1_h - 1;
	return v;
}
