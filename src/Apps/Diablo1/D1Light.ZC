// D1Light.ZC - light shading tables and the tile light grid
//
// Diablo palettes are 16-color ramps ordered light to dark; a shade level
// shifts an index deeper into its ramp (lighting.cpp MakeLightTable, the
// non-light4 path). 16 levels of 256: level 0 identity, 14 darkening
// steps, level 15 black. index ranges 128-159 are four 8-wide ramps and
// shift by half.
//
// the grid holds a level per dPiece cell, rebuilt around the player from
// plain radial distance - the original's crawl tables produce close to
// linear falloff over the radius.

#define D1_LIGHT_LEVELS	16
#define D1_LIGHT_RADIUS	10

U8	 d1_light_tbl[D1_LIGHT_LEVELS * 256];
U8	 d1_dlight[D1_MAXDUN * D1_MAXDUN];
Bool d1_light_ready = FALSE;
U8	*d1_shade = NULL;			//active translation for tile/actor plots
//scrollrt cel_transparency_active: checkerboard skip so sprites behind show
Bool d1_cel_trans = FALSE;

U0 D1MakeLightTable()
{
	I64 t = 0;
	I64 i;
	I64 j;
	I64 k;
	I64 shade = 0;
	I64 col;
	I64 max;

	for (i = 0; i < 15; i++)
	{
		d1_light_tbl[t] = 0;
		t++;
		for (j = 0; j < 8; j++)
		{
			col = 16 * j + shade;
			max = 16 * j + 15;
			for (k = 0; k < 16; k++)
			{
				if (k != 0 || j != 0)
				{
					d1_light_tbl[t] = col;
					t++;
				}
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
			}
		}
		for (j = 16; j < 20; j++)
		{
			col = 8 * j + (shade >> 1);
			max = 8 * j + 7;
			for (k = 0; k < 8; k++)
			{
				d1_light_tbl[t] = col;
				t++;
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
			}
		}
		for (j = 10; j < 16; j++)
		{
			col = 16 * j + shade;
			max = 16 * j + 15;
			for (k = 0; k < 16; k++)
			{
				d1_light_tbl[t] = col;
				t++;
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
				if (col == 255)
				{
					max = 0;
					col = 0;
				}
			}
		}
		shade++;
	}

	for (i = 0; i < 256; i++)
	{
		d1_light_tbl[t] = 0;
		t++;
	}

	d1_light_ready = TRUE;
}

U0 D1LightClear(I64 level)
{//town is fullbright, dungeons start dark
	I64 i;
	I64 v;

	if (level == 0)
		v = 0;
	else
		v = 15;
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dlight[i] = v;
}

U0 D1LightUpdate(I64 px, I64 py)
{//radial falloff around the player
	I64 x;
	I64 y;
	I64 dx;
	I64 dy;
	I64 d2;
	I64 lvl;
	I64 dist;

	if (d1_currlevel == 0)
		return;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			dx = x - px;
			dy = y - py;
			d2 = dx * dx + dy * dy;

			//integer sqrt by search; radius is small
			dist = 0;
			while ((dist + 1) * (dist + 1) <= d2)
				dist++;

			lvl = (dist * 15) / D1_LIGHT_RADIUS;
			if (lvl > 15)
				lvl = 15;
			d1_dlight[x + y * D1_MAXDUN] = lvl;
		}
}

U0 D1ShadeForCell(I64 x, I64 y)
{//set the active translation for this cell's plots; NULL = identity
	I64 lvl = d1_dlight[x + y * D1_MAXDUN];

	if (lvl <= 0 || !d1_light_ready)
		d1_shade = NULL;
	else
		d1_shade = d1_light_tbl + lvl * 256;
}

U0 D1PixL(I64 x, I64 y, I64 color)
{//shaded plot: world tiles and actors route through the active light level.
 //cel_transparency_active: retail skips the odd checkerboard so prior pixels
 //(the player) remain visible through wall micros in front.
	if (d1_cel_trans && ((x ^ y) & 1))
		return;
	if (d1_shade)
		color = d1_shade[color];
	D1Pix(x, y, color);
}

//--- half transparency ------------------------------------------------------
//
// stores.cpp / minitext.cpp draw panel interiors through asm_trans_rect.inc,
// a 50% checkerboard black. This maps every pixel through shade level 8 of
// the MakeLightTable ramp instead - half depth of the 16-step ramps - which
// darkens uniformly at the same average. Level 8 has no identity entry
// except index 0 (black): ramp entries 8..15 clamp to black, 0..7 shift 8.

//50% blend toward black, nearest palette entry to (r/2, g/2, b/2).
//shade-8 of the light ramps reads near-black on the night palettes; retail's
//trans_rect halves brightness, which this table reproduces per palette.
U8	 d1_trans_tbl[256];
Bool d1_trans_ready  = FALSE;
I64	 d1_trans_serial = -1;		//palette serial the table was built for

U0 D1TransBuild()
{//once per palette load; 256x256 nearest-color search
	I64 i;
	I64 k;
	I64 tr;
	I64 tg;
	I64 tb;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;
	I64 best;
	I64 bestd;

	for (i = 0; i < 256; i++)
	{
		tr = d1_pal[i * 3]     / 2;
		tg = d1_pal[i * 3 + 1] / 2;
		tb = d1_pal[i * 3 + 2] / 2;
		best  = 0;
		bestd = 0x7FFFFFFF;
		for (k = 0; k < 256; k++)
		{
			dr = d1_pal[k * 3]     - tr;
			dg = d1_pal[k * 3 + 1] - tg;
			db = d1_pal[k * 3 + 2] - tb;
			d  = dr * dr + dg * dg + db * db;
			if (d < bestd)
			{
				bestd = d;
				best  = k;
			}
		}
		d1_trans_tbl[i] = best;
	}
	d1_trans_ready  = TRUE;
	d1_trans_serial = d1_pal_serial;
}

U0 D1FillRectTrans(I64 x, I64 y, I64 w, I64 h)
{//darken the rect in place; the world behind shows through
	U8	*tbl = d1_trans_tbl;
	I64	 i;
	I64	 j;
	I64	 px;
	I64	 py;

	if (!d1_trans_ready || d1_trans_serial != d1_pal_serial)
		D1TransBuild;
	if (!d1_trans_ready)
	{
		D1FillRect(x, y, w, h, 0);
		return;
	}
	for (j = 0; j < h; j++)
	{
		py = y + j;
		if (py >= 0 && py < d1_h)
		{
			for (i = 0; i < w; i++)
			{
				px = x + i;
				if (px >= 0 && px < d1_w)
					d1_screen[py * D1_W_MAX + px] =
						tbl[d1_screen[py * D1_W_MAX + px]];
			}
		}
	}
}

//devilutionX qol/itemlabels: MarginX=2, LabelHeight=13 (11 glyph + margins).
//retail routes names to the panel info box; the port's world float plates
//keep that padding.
#define D1_LBL_MX	2
#define D1_LBL_H	13
#define D1_LBL_TOP	10		//= D1_NAME_ASC: plate top above baseline

U0 D1NamePlate(I64 nx, I64 ny, I64 tw)
{//half-dark plate behind a SmalText string at baseline (nx, ny)
	D1FillRectTrans(nx - D1_LBL_MX, ny - D1_LBL_TOP,
		tw + D1_LBL_MX * 2, D1_LBL_H);
}
