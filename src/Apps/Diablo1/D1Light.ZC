// light shading tables and the tile light grid
//
// Diablo palettes are 16-color ramps ordered light to dark; a shade level
// shifts an index deeper into its ramp (lighting.cpp MakeLightTable, the
// non-light4 path). 16 levels of 256: level 0 identity, 14 darkening steps,
// level 15 black. index ranges 128-159 are four 8-wide ramps, shifting by half.
//
// two grids, as lighting.cpp keeps them:
//   d1_dlight  = dLight[][], shade level per cell, written by DoLighting from
//                lightradius/lightblock as a radial falloff with no occlusion.
//                ambient is lightmax (15).
//   d1_dflags  = dFlags[][] BFLAG_LIT / BFLAG_VISIBLE / BFLAG_EXPLORED, written
//                by DoVision along the d1_vcrawl rays, each ray stopping at the
//                first light-blocking piece.

#define D1_LIGHT_LEVELS	16
#define D1_LIGHT_RADIUS	10
#define D1_LIGHT_MAX	15		//lighting.cpp lightmax, non-light4 path

U8	 d1_light_tbl[D1_LIGHT_LEVELS * 256];
U8	 d1_dlight[D1_MAXDUN * D1_MAXDUN];
Bool d1_light_ready = FALSE;
U8	*d1_shade = NULL;

#include "D1LightT"

U8 d1_lightradius[16 * 128];

U8 d1_lightblock[16 * 16];

Bool d1_cel_trans = FALSE;

U0 D1MakeLightTable()
{
	I64 t = 0;
	I64 i;
	I64 j;
	I64 k;
	I64 shade = 0;
	I64 col;
	I64 max;

	for (i = 0; i < 15; i++)
	{
		d1_light_tbl[t] = 0;
		t++;
		for (j = 0; j < 8; j++)
		{
			col = 16 * j + shade;
			max = 16 * j + 15;
			for (k = 0; k < 16; k++)
			{
				if (k != 0 || j != 0)
				{
					d1_light_tbl[t] = col;
					t++;
				}
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
			}
		}
		for (j = 16; j < 20; j++)
		{
			col = 8 * j + (shade >> 1);
			max = 8 * j + 7;
			for (k = 0; k < 8; k++)
			{
				d1_light_tbl[t] = col;
				t++;
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
			}
		}
		for (j = 10; j < 16; j++)
		{
			col = 16 * j + shade;
			max = 16 * j + 15;
			for (k = 0; k < 16; k++)
			{
				d1_light_tbl[t] = col;
				t++;
				if (col < max)
					col++;
				else
				{
					max = 0;
					col = 0;
				}
				if (col == 255)
				{
					max = 0;
					col = 0;
				}
			}
		}
		shade++;
	}

	for (i = 0; i < 256; i++)
	{
		d1_light_tbl[t] = 0;
		t++;
	}

	for (j = 0; j < 16; j++)
		for (i = 0; i < 128; i++)
		{
			if (i > (j + 1) * 8)
				d1_lightradius[j * 128 + i] = D1_LIGHT_MAX;
			else
				d1_lightradius[j * 128 + i] =
					ToI64(15.0 * i / (8.0 * (j + 1)) + 0.5);
		}

	for (k = 0; k < 16; k++)
		for (j = 0; j < 16; j++)
			d1_lightblock[k * 16 + j] =
				ToI64(Sqrt(ToF64(64 * j * j + 64 * k * k)));

	d1_light_ready = TRUE;
}

U0 D1LightClear(I64 level)
{
	I64 i;
	I64 v;
	I64 f;

	if (level == 0)
	{
		v = 0;
		f = D1_BFLAG_VISIBLE | D1_BFLAG_LIT | D1_BFLAG_EXPLORED;
	}
	else
	{
		v = D1_LIGHT_MAX;
		f = 0;
	}
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
	{
		d1_dlight[i] = v;
		d1_dflags[i] = f;
	}
}

I64 D1LightRadius()
{
	I64 rad;
	I64 rw;
	I64 rh;
	I64 vph = D1_UI_H - D1_PANEL_H;

	rw = (d1_w * D1_LIGHT_RADIUS + D1_UI_W / 2) / D1_UI_W;
	if (d1_vp_h > 0)
		rh = (d1_vp_h * D1_LIGHT_RADIUS + vph / 2) / vph;
	else
		rh = D1_LIGHT_RADIUS;
	rad = rw;
	if (rh > rad)
		rad = rh;
	if (rad < D1_LIGHT_RADIUS)
		rad = D1_LIGHT_RADIUS;
	if (rad > 15)
		rad = 15;
	return rad;
}

U0 D1LightQuad(I64 px, I64 py, I64 rad, I64 xs, I64 ys, I64 swap,
	I64 nx, I64 ny)
{
	I64 x;
	I64 y;
	I64 rb;
	I64 v;
	I64 tx;
	I64 ty;

	for (y = 0; y < ny; y++)
		for (x = 1; x < nx; x++)
		{
			if (swap)
			{
				tx = px + y * xs;
				ty = py + x * ys;
			}
			else
			{
				tx = px + x * xs;
				ty = py + y * ys;
			}
			if (tx >= 0 && tx < D1_MAXDUN && ty >= 0 && ty < D1_MAXDUN)
			{
				rb = d1_lightblock[y * 16 + x];
				if (rb < 128)
				{
					v = d1_lightradius[rad * 128 + rb];
					if (v < d1_dlight[tx + ty * D1_MAXDUN])
						d1_dlight[tx + ty * D1_MAXDUN] = v;
				}
			}
		}
}

U0 D1DoLighting(I64 px, I64 py, I64 rad)
{//lighting.cpp DoLighting with Lnum = -1: radial falloff, no occlusion.
 //Occlusion is D1DoVision's job. rad indexes lightradius, 0-15.
	I64 minx;
	I64 maxx;
	I64 miny;
	I64 maxy;

	if (rad < 0)
		rad = 0;
	if (rad > 15)
		rad = 15;

	if (px - 15 < 0)
		minx = px + 1;
	else
		minx = 15;
	if (px + 15 > D1_MAXDUN)
		maxx = D1_MAXDUN - px;
	else
		maxx = 15;
	if (py - 15 < 0)
		miny = py + 1;
	else
		miny = 15;
	if (py + 15 > D1_MAXDUN)
		maxy = D1_MAXDUN - py;
	else
		maxy = 15;

	if (px >= 0 && px < D1_MAXDUN && py >= 0 && py < D1_MAXDUN)
		d1_dlight[px + py * D1_MAXDUN] = 0;

	D1LightQuad(px, py, rad,  1,  1, FALSE, maxx, miny);
	D1LightQuad(px, py, rad,  1, -1, TRUE,  maxx, maxy);
	D1LightQuad(px, py, rad, -1, -1, FALSE, minx, maxy);
	D1LightQuad(px, py, rad, -1,  1, TRUE,  minx, miny);
}

U0 D1DoVision(I64 px, I64 py, I64 rad, Bool visible)
{//lighting.cpp DoVision. Four quadrants of the 23 d1_vcrawl rays;
	I64	 quad;
	I64	 j;
	I64	 k;
	I64	 cx;
	I64	 cy;
	I64	 lin;
	I64	 x1a;
	I64	 x2a;
	I64	 y1a;
	I64	 y2a;
	I64	 tv;
	Bool blocker;
	Bool diag;

	if (px >= 0 && px < D1_MAXDUN && py >= 0 && py < D1_MAXDUN)
	{
		d1_dflags[px + py * D1_MAXDUN] |= D1_BFLAG_EXPLORED;
		if (visible)
			d1_dflags[px + py * D1_MAXDUN] |= D1_BFLAG_LIT;
		d1_dflags[px + py * D1_MAXDUN] |= D1_BFLAG_VISIBLE;
	}

	for (quad = 0; quad < 4; quad++)
		for (j = 0; j < 23; j++)
		{
			blocker = FALSE;
			lin = 2 * (rad - d1_radiusadj[j]);
			for (k = 0; k < lin && !blocker; k += 2)
			{
				x1a = 0;
				x2a = 0;
				y1a = 0;
				y2a = 0;
				diag = (d1_vcrawl[j][k] > 0) && (d1_vcrawl[j][k + 1] > 0);
				if (quad == 0)
				{
					cx = px + d1_vcrawl[j][k];
					cy = py + d1_vcrawl[j][k + 1];
					if (diag)
					{
						x1a = -1;
						y2a = -1;
					}
				}
				else if (quad == 1)
				{
					cx = px - d1_vcrawl[j][k];
					cy = py - d1_vcrawl[j][k + 1];
					if (diag)
					{
						y1a = 1;
						x2a = 1;
					}
				}
				else if (quad == 2)
				{
					cx = px + d1_vcrawl[j][k];
					cy = py - d1_vcrawl[j][k + 1];
					if (diag)
					{
						x1a = -1;
						y2a = 1;
					}
				}
				else
				{
					cx = px - d1_vcrawl[j][k];
					cy = py + d1_vcrawl[j][k + 1];
					if (diag)
					{
						y1a = -1;
						x2a = 1;
					}
				}

				if (cx >= 0 && cx < D1_MAXDUN && cy >= 0 && cy < D1_MAXDUN)
				{
					blocker = D1BlocksLight(cx, cy);
					if (!D1BlocksLight(cx + x1a, cy + y1a) ||
						!D1BlocksLight(cx + x2a, cy + y2a))
					{
						d1_dflags[cx + cy * D1_MAXDUN] |= D1_BFLAG_EXPLORED;
						if (visible)
							d1_dflags[cx + cy * D1_MAXDUN] |= D1_BFLAG_LIT;
						d1_dflags[cx + cy * D1_MAXDUN] |= D1_BFLAG_VISIBLE;
						if (!blocker)
						{
							tv = d1_dtrans[cx + cy * D1_MAXDUN];
							if (tv)
								d1_translist[tv] = TRUE;
						}
					}
				}
			}
		}
}

U0 D1LightUpdate(I64 px, I64 py)
{
	I64 i;
	I64 rad = D1LightRadius();

	if (d1_currlevel == 0)
		return;

	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
	{
		d1_dlight[i] = D1_LIGHT_MAX;
		d1_dflags[i] &= ~(D1_BFLAG_VISIBLE | D1_BFLAG_LIT);
	}

	D1DoLighting(px, py, rad);
	D1DoVision(px, py, rad, TRUE);
}

U0 D1ShadeForCell(I64 x, I64 y)
{//scrollrt.cpp light_table_index = dLight[x][y].
	I64 lvl = d1_dlight[x + y * D1_MAXDUN];

	if (lvl <= 0 || !d1_light_ready)
		d1_shade = NULL;
	else
		d1_shade = d1_light_tbl + lvl * 256;
}

U0 D1PixL(I64 x, I64 y, I64 color)
{
	if (d1_cel_trans && ((x ^ y) & 1))
		return;
	if (d1_shade)
		color = d1_shade[color];
	D1Pix(x, y, color);
}


U8	 d1_trans_tbl[256];
Bool d1_trans_ready  = FALSE;
I64	 d1_trans_serial = -1;

U0 D1TransBuild()
{//once per palette load; 256x256 nearest-color search
	I64 i;
	I64 k;
	I64 tr;
	I64 tg;
	I64 tb;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;
	I64 best;
	I64 bestd;

	for (i = 0; i < 256; i++)
	{
		tr = d1_pal[i * 3]     / 2;
		tg = d1_pal[i * 3 + 1] / 2;
		tb = d1_pal[i * 3 + 2] / 2;
		best  = 0;
		bestd = 0x7FFFFFFF;
		for (k = 0; k < 256; k++)
		{
			dr = d1_pal[k * 3]     - tr;
			dg = d1_pal[k * 3 + 1] - tg;
			db = d1_pal[k * 3 + 2] - tb;
			d  = dr * dr + dg * dg + db * db;
			if (d < bestd)
			{
				bestd = d;
				best  = k;
			}
		}
		d1_trans_tbl[i] = best;
	}
	d1_trans_ready  = TRUE;
	d1_trans_serial = d1_pal_serial;
}

U0 D1FillRectTrans(I64 x, I64 y, I64 w, I64 h)
{
	U8	*tbl = d1_trans_tbl;
	I64	 i;
	I64	 j;
	I64	 px;
	I64	 py;

	if (!d1_trans_ready || d1_trans_serial != d1_pal_serial)
		D1TransBuild;
	if (!d1_trans_ready)
	{
		D1FillRect(x, y, w, h, 0);
		return;
	}
	for (j = 0; j < h; j++)
	{
		py = y + j;
		if (py >= 0 && py < d1_h)
		{
			for (i = 0; i < w; i++)
			{
				px = x + i;
				if (px >= 0 && px < d1_w)
					d1_screen[py * D1_W_MAX + px] =
						tbl[d1_screen[py * D1_W_MAX + px]];
			}
		}
	}
}

U0 D1FillRectTransDither(I64 x, I64 y, I64 w, I64 h)
{
	I64 i;
	I64 j;
	I64 px;
	I64 py;

	for (j = 0; j < h; j++)
	{
		py = y + j;
		if (py >= 0 && py < d1_h)
		{
			for (i = 0; i < w; i++)
			{
				px = x + i;
				if (px >= 0 && px < d1_w && ((px ^ py) & 1))
					d1_screen[py * D1_W_MAX + px] = 0;
			}
		}
	}
}

#define D1_LBL_MX	2
#define D1_LBL_H	13
#define D1_LBL_TOP	10

U0 D1NamePlate(I64 nx, I64 ny, I64 tw)
{
	D1FillRectTrans(nx - D1_LBL_MX, ny - D1_LBL_TOP,
		tw + D1_LBL_MX * 2, D1_LBL_H);
}
