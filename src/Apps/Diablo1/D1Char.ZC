// D1Char.ZC - player classes, derived stats, character record
//
// classes and their starting attributes (player.cpp StrengthTbl,
// MagicTbl, DexterityTbl, VitalityTbl, MaxStats):
//   warrior   str 30 mag 10 dex 20 vit 25, caps 250/50/60/100
//   rogue     str 20 mag 15 dex 30 vit 20, caps  55/70/250/80
//   sorcerer  str 15 mag 35 dex 15 vit 20, caps  45/250/85/80
//
// CreatePlayer derivations, kept exactly:
//   hp   = (vit + 10) << 6, doubled for warrior, +50% for rogue
//   mana = mag << 6, doubled for sorcerer, +50% for rogue
// level ups add vit/mag per class (IncreasePlrStr and friends reduced to
// the per-level hp/mana grants in NextPlrLevel).
//
// gfx path letters per class: w warrior, r rogue, s sorcerer; the armor
// and weapon codes follow in PlrGFX\<class>\<ccc>\<ccc><anim>.CL2.
//
// creation also runs items.cpp CreatePlrItems: weapon in the left hand,
// shield in the right, two potions in the belt, 100 gold.

#define D1_NCLASS		3
#define D1CL_WARRIOR	0
#define D1CL_ROGUE		1
#define D1CL_SORCERER	2

#define D1AT_STR		0
#define D1AT_MAG		1
#define D1AT_DEX		2
#define D1AT_VIT		3

I64 d1_cls_str[D1_NCLASS] = {30, 20, 15};
I64 d1_cls_mag[D1_NCLASS] = {10, 15, 35};
I64 d1_cls_dex[D1_NCLASS] = {20, 30, 15};
I64 d1_cls_vit[D1_NCLASS] = {25, 20, 20};

//MaxStats[class][str,mag,dex,vit]
I64 d1_cls_max[D1_NCLASS * 4] = {
	250,  50,  60, 100,
	 55,  70, 250,  80,
	 45, 250,  85,  80};

U8 *d1_cls_name[D1_NCLASS] = {"Warrior", "Rogue", "Sorcerer"};

//gfx directory + file prefix letter per class (PlrGFX\Warrior\wls\wls*)
U8 *d1_cls_dir[D1_NCLASS] = {"Warrior", "Rogue", "Sorceror"};
U8 *d1_cls_code[D1_NCLASS] = {"w", "r", "s"};

I64	 d1_plr_class = D1CL_WARRIOR;
I64	 d1_plr_mag   = 10;
I64	 d1_plr_vit   = 25;
I64	 d1_plr_pts   = 0;			//unspent attribute points
U8	 d1_plr_name[32];

I64 D1ClsMax(I64 cls, I64 attr)
{
	if (cls < 0 || cls >= D1_NCLASS || attr < 0 || attr > 3)
		return 0;
	return d1_cls_max[cls * 4 + attr];
}

I64 D1CharBaseHP(I64 cls, I64 vit)
{//CreatePlayer: (vit + 10) << 6, class scaled
	I64 hp = (vit + 10) << 6;

	if (cls == D1CL_WARRIOR)
		hp <<= 1;
	else if (cls == D1CL_ROGUE)
		hp += hp >> 1;
	return hp;
}

I64 D1CharBaseMana(I64 cls, I64 mag)
{//CreatePlayer: mag << 6, class scaled
	I64 mana = mag << 6;

	if (cls == D1CL_SORCERER)
		mana <<= 1;
	else if (cls == D1CL_ROGUE)
		mana += mana >> 1;
	return mana;
}

U0 D1CharRecalc()
{//derived maxima from the current attributes, preserving the fill ratio
	I64 old_hp   = d1_plr_maxhp;
	I64 old_mana = d1_plr_maxmana;
	I64 hp_frac  = 0;
	I64 mn_frac  = 0;

	if (old_hp > 0)
		hp_frac = (d1_plr_hp * 1024) / old_hp;
	if (old_mana > 0)
		mn_frac = (d1_plr_mana * 1024) / old_mana;

	//per level: the class grants stack onto the base derivation
	d1_plr_maxhp = D1CharBaseHP(d1_plr_class, d1_plr_vit) +
		(d1_plr_lvl - 1) * (2 << 6);
	d1_plr_maxmana = D1CharBaseMana(d1_plr_class, d1_plr_mag) +
		(d1_plr_lvl - 1) * (1 << 6);

	if (old_hp <= 0)
	{
		d1_plr_hp   = d1_plr_maxhp;
		d1_plr_mana = d1_plr_maxmana;
	}
	else
	{
		d1_plr_hp   = (d1_plr_maxhp * hp_frac) / 1024;
		d1_plr_mana = (d1_plr_maxmana * mn_frac) / 1024;
	}
	if (d1_plr_hp > d1_plr_maxhp)
		d1_plr_hp = d1_plr_maxhp;
	if (d1_plr_mana > d1_plr_maxmana)
		d1_plr_mana = d1_plr_maxmana;
}

U0 D1CreatePlrItems(I64 cls)
{//items.cpp CreatePlrItems: clear every carrier, then hand out the class kit.
 //
 //durability and AC come from the IDI_ rows of AllItemsList, not from the
 //droppable rows that share their name: IDI_WARRIOR has 20 durability against
 //the drop row's 24, IDI_WARRSHLD 3 AC and 10 durability against 1-5 and 16.
 //
 //IDI_SORCEROR is a Short Staff of Charged Bolt: two-handed, 2-4 damage,
 //25 durability, 40 charges.
 //
 //deviation: gold is a purse counter here, so the 100 lands in d1_plr_gold
 //instead of as an item in InvGrid[30].
	D1ItemInit;
	D1ItmCarryClear;

	if (cls == D1CL_ROGUE)
	{
		D1ItmGive(D1EQ_LEFT, "Short Bow", 0, 30);
		D1ItmGiveBelt(0, "Potion of Healing");
		D1ItmGiveBelt(1, "Potion of Healing");
	}
	else if (cls == D1CL_SORCERER)
	{
		D1ItmGiveStaff(D1EQ_LEFT, "Short Staff", "Charged Bolt", 40, 25);
		D1ItmGiveBelt(0, "Potion of Mana");
		D1ItmGiveBelt(1, "Potion of Mana");
	}
	else
	{
		D1ItmGive(D1EQ_LEFT,  "Short Sword", 0, 20);
		D1ItmGive(D1EQ_RIGHT, "Buckler",     3, 10);
		D1ItmGive(-1,         "Club",        0, 20);	//AutoPlace at InvGrid 0
		D1ItmGiveBelt(0, "Potion of Healing");
		D1ItmGiveBelt(1, "Potion of Healing");
	}

	d1_plr_gold = 100;
	if (d1_pow_equipped)
		(*d1_pow_equipped)(D1EQ_LEFT);	//the sorcerer's staff spell
}

U0 D1CharCreate(I64 cls, U8 *name)
{//CreatePlayer for a fresh character
	if (cls < 0 || cls >= D1_NCLASS)
		cls = D1CL_WARRIOR;

	d1_plr_class = cls;
	d1_plr_str   = d1_cls_str[cls];
	d1_plr_mag   = d1_cls_mag[cls];
	d1_plr_dex   = d1_cls_dex[cls];
	d1_plr_vit   = d1_cls_vit[cls];
	d1_plr_lvl   = 1;
	d1_plr_exp   = 0;
	d1_plr_pts   = 0;
	d1_plr_dead  = FALSE;
	D1CreatePlrItems(cls);		//gear, belt potions and the 100 gold purse

	d1_plr_maxhp   = 0;			//force a full refill in the recalc
	d1_plr_maxmana = 0;
	D1CharRecalc;
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_mana = d1_plr_maxmana;

	if (name && name[0])
		D1StrCopy(d1_plr_name, name, 32);
	else
		D1StrCopy(d1_plr_name, d1_cls_name[cls], 32);
}

Bool D1CharSpend(I64 attr)
{//spend one attribute point, respecting the class cap
	I64 cur;

	if (d1_plr_pts < 1)
		return FALSE;

	if (attr == D1AT_STR)
		cur = d1_plr_str;
	else if (attr == D1AT_MAG)
		cur = d1_plr_mag;
	else if (attr == D1AT_DEX)
		cur = d1_plr_dex;
	else if (attr == D1AT_VIT)
		cur = d1_plr_vit;
	else
		return FALSE;

	if (cur >= D1ClsMax(d1_plr_class, attr))
		return FALSE;

	if (attr == D1AT_STR)
		d1_plr_str++;
	else if (attr == D1AT_MAG)
		d1_plr_mag++;
	else if (attr == D1AT_DEX)
		d1_plr_dex++;
	else
		d1_plr_vit++;

	d1_plr_pts--;
	D1CharRecalc;
	return TRUE;
}

I64 D1PlrDamageMod()
{//items.cpp CalcPlrItemVals _pDamageMod. this port carries the bow/staff row
 //(level * strength / 100) for every weapon class; the per-class melee rows
 //are absent.
	return d1_plr_lvl * d1_plr_str / 100;
}
