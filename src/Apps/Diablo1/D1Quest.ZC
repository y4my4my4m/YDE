// D1Quest.ZC - quest log (quests.cpp, control.cpp)
//
// Data\Quest.CEL: one unclipped 320x352 frame. the original draws it at
// buffer 64,511 with SCREEN_X 64 / SCREEN_Y 160 (quests.cpp:864), i.e.
// screen x 0..319, bottom row y 351 - the left half, opposite the
// inventory. text rows are 12px tall: row r spans screen y
// 32 + 12r .. +11, baseline 12r + 44 (SStringY, stores.cpp:43, plus the
// PrintQLString +44 bias). the centered text column is x 32..288, 257 wide.
//
// quest set: most become ACTIVE on first entry to their dungeon level
// (single-player _qdlvl). The Butcher (id 0) activates only when the
// player talks to the Wounded Townsman (Deadguy) outside the cathedral.
//
// three quests have a boss: The Butcher (2), the Skeleton King (3) and the
// Warlord of Blood (13). they spawn inside their level's set piece and
// complete their quest when killed. Diablo completes on d1_diablo_slain.
// the rest stay informational - no dialogue, no quest items.
//
// boss stats are monstdat.cpp UniqMonst rows over their base MonsterData
// row, with PlaceUniqueMonst's single-player derivations: level = 2*mlevel
// when mlevel is set, else base + 5; hp = mmaxhp >> 1; exp = 2 * base exp.
// AC, to-hit and the action frame stay from the base row.
//
// deviations: the original opens a full-screen scrolling text box on
// selection (InitQTextMsg); here the selected entry's one-line log text
// wraps into the lower third of the same panel. no pentagram selector
// cels; the selected row is drawn bright instead.

#define D1_NQUESTS			13
#define D1Q_DIABLO			12

#define D1QS_UNAVAIL		0
#define D1QS_AVAIL			1
#define D1QS_ACTIVE			2
#define D1QS_DONE			3

//coordinates are band-local: the log draws at D1UiOrgX() + D1_QL_X, rows
//at D1UiOrgY(), and
//D1QuestClick subtracts the same origin
#define D1_QL_X				0		//panel left edge
#define D1_QL_BOT			351		//panel bottom row
#define D1_QL_TX			32		//text column left
#define D1_QL_TW			257		//text column width

class CD1Quest
{
	I64	 dlvl;
	U8	*name;
	U8	*log;
	I64	 state;
};

Bool d1_quest_open = FALSE;
U8	*d1_quest_cel  = NULL;
CD1Quest d1_quests[D1_NQUESTS];
I64	 d1_quest_sel  = -1;			//selected quest id, -1 = none
I64	 d1_quest_top  = 8;				//first list row (qtopline)
I64	 d1_quest_step = 2;				//rows between entries
I64	 d1_quest_list[D1_NQUESTS];		//visible ids, rebuilt on open
I64	 d1_quest_nlines = 0;
Bool d1_quest_inited = FALSE;

U0 D1QuestSet(I64 i, I64 dlvl, U8 *name, U8 *log)
{
	CD1Quest *q = &d1_quests[i];

	q->dlvl  = dlvl;
	q->name  = name;
	q->log   = log;
	q->state = D1QS_AVAIL;
}

U0 D1QuestInit()
{//questlist order, single-player _qdlvl
	I64 size = 0;

	D1QuestSet(0,  2, "The Butcher",
		"A butcher of men holds the second level. Avenge the wounded townsman.");
	D1QuestSet(1,  3, "The Curse of King Leoric",
		"The mad king walks his tomb below the cathedral.");
	D1QuestSet(2,  4, "Ogden's Sign",
		"Demons stole the sign of the Rising Sun. Ogden wants it back.");
	D1QuestSet(3,  5, "The Magic Rock",
		"A falling star carried a stone. Griswold wants what fell.");
	D1QuestSet(4,  6, "The Chamber of Bone",
		"A sealed vault of bone guards a book of power.");
	D1QuestSet(5,  7, "Halls of the Blind",
		"The sightless dead wander here. Their treasure does not.");
	D1QuestSet(6,  8, "Zhar the Mad",
		"A mage hides among his books. He does not welcome visitors.");
	D1QuestSet(7,  9, "Black Mushroom",
		"Adria needs a black mushroom from the caves.");
	D1QuestSet(8, 10, "Anvil of Fury",
		"Griswold speaks of an anvil forged in the fires below.");
	D1QuestSet(9, 13, "Warlord of Blood",
		"A warlord of blood commands the legions of hell.");
	D1QuestSet(10, 14, "Lachdanan",
		"A cursed knight of Leoric begs for release.");
	D1QuestSet(11, 15, "Archbishop Lazarus",
		"Lazarus led the townsfolk to slaughter. He waits below.");
	D1QuestSet(12, 16, "Diablo",
		"The Lord of Terror himself. Kill him and it ends.");

	if (!d1_quest_cel)
		d1_quest_cel = D1MpqRead("Data\\Quest.CEL", &size);

	d1_quest_sel   = -1;
	d1_quest_open  = FALSE;
	d1_quest_inited = TRUE;
}

U0 D1QuestComplete(I64 id)
{
	if (id >= 0 && id < D1_NQUESTS)
		d1_quests[id].state = D1QS_DONE;
}

//quest bosses. d1_montypes is sized by D1_MONTYPES in D1Mon.ZC and its
//entries 0..D1_MT_DIABLO are the spawn roster; the bosses take the slots
//above it. with no room above D1_MT_DIABLO no boss registers and the
//levels play as before.
#define D1_NBOSS		3
#define D1_BOSS_FIRST	(D1_MT_DIABLO + 1)

#define D1B_BUTCHER		0
#define D1B_SKELKING	1
#define D1B_WARLORD		2

I64	 d1_boss_ti[D1_NBOSS];			//monster type index, -1 = unregistered
I64	 d1_boss_mi[D1_NBOSS];			//live monster index, -1 = not on level
I64	 d1_boss_quest[D1_NBOSS];		//quest id completed by the kill
I64	 d1_boss_level[D1_NBOSS];
Bool d1_boss_inited = FALSE;

U0 D1QuestBossInit()
{//UniqMonst rows for The Butcher, Skeleton King, Warlord of Blood over
 //their MT_CLEAVER / MT_SKING / MT_BTBLACK base rows
	I64 i;

	if (d1_boss_inited)
		return;
	d1_boss_inited = TRUE;

	for (i = 0; i < D1_NBOSS; i++)
	{
		d1_boss_ti[i] = -1;
		d1_boss_mi[i] = -1;
	}
	d1_boss_quest[D1B_BUTCHER]  = 0;
	d1_boss_quest[D1B_SKELKING] = 1;
	d1_boss_quest[D1B_WARLORD]  = 9;
	d1_boss_level[D1B_BUTCHER]  = 2;
	d1_boss_level[D1B_SKELKING] = 3;
	d1_boss_level[D1B_WARLORD]  = 13;

	if (D1_BOSS_FIRST + D1_NBOSS > D1_MONTYPES)
		return;					//no slots; bosses stay absent

	D1MonTypesInit;

	//dlvl range 50..50 keeps a boss out of the random spawn pools.
	//AI_CLEAVER / AI_SKELKING / AI_WARLORD are unimplemented; all three
	//reduce to D1AI_SKELSD melee here.
	d1_boss_ti[D1B_BUTCHER] = D1_BOSS_FIRST;
	D1MonTypeSet(D1_BOSS_FIRST, "Monsters\\FatC\\FatC%c.CL2",
		"Monsters\\Monsters\\GENRL.TRN", "The Butcher",
		128, 10, 8, 12, 6, 16, 1, 0, 0, 0, 0,
		50, 50, 6, 110, 110, 3, 50, 8, 6, 12, 50, 1420, 14,
		D1AI_SKELSD, D1MC_DEMON, 0x86, -1);

	d1_boss_ti[D1B_SKELKING] = D1_BOSS_FIRST + 1;
	D1MonTypeSet(D1_BOSS_FIRST + 1, "Monsters\\SKing\\SKing%c.CL2",
		"Monsters\\Monsters\\GENRL.TRN", "Skeleton King",
		160, 8, 6, 16, 6, 16, 2, 0, 0, 0, 0,
		50, 50, 14, 120, 120, 3, 60, 8, 6, 16, 70, 1140, 14,
		D1AI_SKELSD, D1MC_UNDEAD, 0x8E, -1);

	d1_boss_ti[D1B_WARLORD] = D1_BOSS_FIRST + 2;
	D1MonTypeSet(D1_BOSS_FIRST + 2, "Monsters\\Black\\Black%c.CL2",
		"Monsters\\Monsters\\GENERAL.TRN", "Warlord of Blood",
		160, 8, 8, 16, 4, 24, 2, 0, 0, 0, 0,
		50, 50, 26, 425, 425, 3, 130, 8, 35, 50, 85, 10260, 14,
		D1AI_SKELSD, D1MC_DEMON, 0xB8, -1);
}

I64 D1QuestBossPlace(I64 b, I64 px, I64 py)
{//place on or near a dPiece tile, widening rings out to the whole piece
	I64 ti = d1_boss_ti[b];
	I64 r;
	I64 dx;
	I64 dy;
	I64 mi;

	if (ti < 0)
		return -1;
	if (!D1MonTypeLoad(ti))
		return -1;

	for (r = 0; r < 12; r++)
		for (dy = -r; dy <= r; dy++)
			for (dx = -r; dx <= r; dx++)
			{
				if (dx > -r && dx < r && dy > -r && dy < r)
					dx = r;		//ring only; the interior was already tried
				mi = D1MonPlace(ti, px + dx, py + dy);
				if (mi >= 0)
					return mi;
			}
	return -1;
}

U0 D1QuestBossSpawn(I64 level)
{//dungeon coords -> dPiece: Pass3 lays tile (i,j) at (2i+16, 2j+16)
	I64 px;
	I64 py;

	D1QuestBossInit;
	if (!d1_setpc_placed)
		return;

	if (level == 2)
	{//The Butcher waits in the rnd6 room; only after Deadguy talk
		if (d1_quests[D1B_BUTCHER].state == D1QS_ACTIVE)
		{
			px = 2 * (d1_setpc_x + d1_setpc_w / 2) + 16;
			py = 2 * (d1_setpc_y + d1_setpc_h / 2) + 16;
			d1_boss_mi[D1B_BUTCHER] = D1QuestBossPlace(D1B_BUTCHER, px, py);
		}
	}
	if (level == 3)
	{//deviation: retail puts the king on set level 1 behind the SKngDO
	 //door. this port has no set levels, so he stands in the doorway room.
		px = 2 * (d1_setpc_x + d1_setpc_w / 2) + 16;
		py = 2 * (d1_setpc_y + d1_setpc_h / 2) + 16;
		d1_boss_mi[D1B_SKELKING] = D1QuestBossPlace(D1B_SKELKING, px, py);
	}
	if (level == 13)
	{//PlaceUniqueMonst UMT_WARLORD
		px = 2 * d1_setpc_x + 22;
		py = 2 * d1_setpc_y + 23;
		d1_boss_mi[D1B_WARLORD] = D1QuestBossPlace(D1B_WARLORD, px, py);
	}
}

U0 D1QuestDiabloToChamber()
{//the shell spawns Diablo at the farthest walkable tile before this runs.
 //move him onto the diab4 pentagram, where the quad room puts him.
	I64 tx = 2 * d4_chamber_x + 16;
	I64 ty = 2 * d4_chamber_y + 16;
	I64 i;
	I64 r;
	I64 dx;
	I64 dy;
	I64 nx = -1;
	I64 ny = -1;

	for (r = 0; r < 6 && nx < 0; r++)
		for (dy = -r; dy <= r && nx < 0; dy++)
			for (dx = -r; dx <= r && nx < 0; dx++)
			{
				if (dx > -r && dx < r && dy > -r && dy < r)
					dx = r;
				if (D1WalkableM(tx + dx, ty + dy))
				{
					nx = tx + dx;
					ny = ty + dy;
				}
			}
	if (nx < 0)
		return;

	for (i = 0; i < d1_nmons; i++)
	{
		if (d1_mons[i].active && d1_mons[i].type == D1_MT_DIABLO)
		{
			if (d1_dmon[d1_mons[i].x + d1_mons[i].y * D1_MAXDUN] == i + 1)
				d1_dmon[d1_mons[i].x + d1_mons[i].y * D1_MAXDUN] = 0;
			d1_mons[i].x = nx;
			d1_mons[i].y = ny;
			d1_dmon[nx + ny * D1_MAXDUN] = i + 1;
			return;
		}
	}
}

U0 D1QuestBossCheck()
{//a dead boss completes its quest. polled, since D1MonHurt has no hook.
	I64 i;
	I64 mi;

	if (!d1_boss_inited)
		return;

	for (i = 0; i < D1_NBOSS; i++)
	{
		mi = d1_boss_mi[i];
		if (mi >= 0 && mi < d1_nmons)
		{
			if (d1_mons[mi].mode == D1MM_DEATH ||
				d1_mons[mi].mode == D1MM_DEAD)
			{
				D1QuestComplete(d1_boss_quest[i]);
				d1_boss_mi[i] = -1;
			}
		}
	}
}

U0 D1QuestLevelEnter(I64 level)
{//available quests on this level become active; the level's boss spawns
	I64 i;

	if (!d1_quest_inited)
		D1QuestInit;

	for (i = 0; i < D1_NBOSS; i++)
		d1_boss_mi[i] = -1;

	for (i = 0; i < D1_NQUESTS; i++)
	{
		//Butcher (0): TalkToDeadguy only — not level enter
		if (i != 0 && d1_quests[i].dlvl == level &&
			d1_quests[i].state == D1QS_AVAIL)
			d1_quests[i].state = D1QS_ACTIVE;
	}

	D1QuestBossSpawn(level);
	if (level == 16)
		D1QuestDiabloToChamber;
}

U0 D1QuestRebuild()
{//StartQuestlog: collect the listed quests, place the first row
	I64 i;

	d1_quest_nlines = 0;
	for (i = 0; i < D1_NQUESTS; i++)
	{
		if (d1_quests[i].state == D1QS_ACTIVE ||
			d1_quests[i].state == D1QS_DONE)
		{
			d1_quest_list[d1_quest_nlines] = i;
			d1_quest_nlines++;
		}
	}
	//qtopline centers the list; rows 4..20 are the usable band, so the
	//spacing halves once the full quest set is listed
	d1_quest_step = 2;
	if (d1_quest_nlines > 9)
		d1_quest_step = 1;
	d1_quest_top = 10 - (d1_quest_nlines * d1_quest_step) / 2;
	if (d1_quest_top < 4)
		d1_quest_top = 4;
}

U0 D1QuestToggle()
{
	if (!d1_quest_inited)
		D1QuestInit;
	if (d1_diablo_slain)
		D1QuestComplete(D1Q_DIABLO);
	D1QuestBossCheck;
	D1QuestRebuild;
	d1_quest_sel  = -1;
	d1_quest_open = !d1_quest_open;
}

I64 D1QuestRowBase(I64 row)
{//SStringY[row] + 44: the small font baseline for a 12px log row
	return D1UiOrgY() + row * 12 + 44;
}

U0 D1QuestStr(I64 row, U8 *str, I64 color)
{//PrintQLString with cjustflag: centered in the 257px column
	I64 w = D1TextWidth(str);
	I64 k = 0;

	if (w < D1_QL_TW)
		k = (D1_QL_TW - w) >> 1;
	D1TextDrawSolid(D1UiOrgX() + D1_QL_X + D1_QL_TX + k, D1QuestRowBase(row),
		str, color);
}

U0 D1QuestWrap(I64 row, U8 *str, I64 color)
{//break the log line on spaces to fit the text column
	U8	 line[80];
	I64	 i    = 0;
	I64	 n    = 0;
	I64	 last = 0;		//length of the last fitting prefix, 0 = none
	I64	 r    = row;
	I64	 c;

	while (str[i] && r < 22)
	{
		c = str[i];
		if (n < 78)
		{
			line[n] = c;
			n++;
			line[n] = 0;
		}
		i++;
		if (c == ' ')
			last = n;
		if (D1TextWidth(line) > D1_QL_TW - 8)
		{
			if (last > 0)
			{//rewind to the last space, replay the remainder
				i -= n - last;
				n  = last;
			}
			line[n] = 0;
			D1TextDrawSolid(D1UiOrgX() + D1_QL_X + D1_QL_TX,
				D1QuestRowBase(r), line, color);
			r++;
			n    = 0;
			last = 0;
			line[0] = 0;
		}
	}
	if (n > 0 && r < 22)
	{
		line[n] = 0;
		D1TextDrawSolid(D1UiOrgX() + D1_QL_X + D1_QL_TX, D1QuestRowBase(r),
			line, color);
	}
}

U0 D1QuestDraw()
{//DrawQuestLog
	I64 i;
	I64 row;
	I64 bright;
	I64 dim;

	if (!d1_quest_open)
		return;
	if (d1_diablo_slain)
		D1QuestComplete(D1Q_DIABLO);
	D1QuestBossCheck;

	bright = D1PalBrightest();
	dim    = 200;				//PAL16_YELLOW+8, the log's body color

	if (d1_quest_cel)
		D1CelDraw(D1UiOrgX() + D1_QL_X, D1UiOrgY() + D1_QL_BOT,
			d1_quest_cel, 1, 320);
	else
		D1FillRect(D1UiOrgX() + D1_QL_X, D1UiOrgY(), 320, 352, 0);

	D1QuestStr(2, "Quest Log", bright);

	row = d1_quest_top;
	for (i = 0; i < d1_quest_nlines; i++)
	{
		if (d1_quest_list[i] == d1_quest_sel)
			D1QuestStr(row, d1_quests[d1_quest_list[i]].name, bright);
		else if (d1_quests[d1_quest_list[i]].state == D1QS_DONE)
			D1QuestStr(row, d1_quests[d1_quest_list[i]].name, 205);
		else
			D1QuestStr(row, d1_quests[d1_quest_list[i]].name, dim);
		row += d1_quest_step;
	}

	if (d1_quest_nlines == 0)
		D1QuestStr(d1_quest_top, "No quests yet.", dim);

	if (d1_quest_sel >= 0)
		D1QuestWrap(row + 1, d1_quests[d1_quest_sel].log, bright);

	D1QuestStr(22, "Close Quest Log", dim);
}

Bool D1QuestClick(I64 cx, I64 cy)
{//QuestlogESC: rows are 12px from screen y 32. TRUE once the click is
 //inside the panel, so the world does not also receive it.
	I64 row;
	I64 i;

	if (!d1_quest_open)
		return FALSE;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx < D1_QL_X || cx >= D1_QL_X + 320 || cy < 0 || cy > D1_QL_BOT)
		return FALSE;

	row = (cy - 32) / 12;
	if (row == 22)
	{
		d1_quest_open = FALSE;
		return TRUE;
	}
	for (i = 0; i < d1_quest_nlines; i++)
	{
		if (row == d1_quest_top + d1_quest_step * i)
			d1_quest_sel = d1_quest_list[i];
	}
	return TRUE;
}

U8 *d1_deadguy_txt =
	"Please help....! I barely escaped from....... The Butcher...! He killed.... My wife... My children! I beg of you...... In the name of God......... Avenge them.........";

U0 D1PlrAvengeVO()
{//HeroSpeech::YourDeathWillBeAvenged — class line 14 (+ warrior variants)
	I64 r;

	if (!d1_opt_sfx)
		return;
	if (d1_plr_class == D1CL_ROGUE)
		D1SndPlay("Sfx\\Rogue\\Rogue14.wav");
	else if (d1_plr_class == D1CL_SORCERER)
		D1SndPlay("Sfx\\Sorceror\\Mage14.wav");
	else
	{
		r = D1Rnd(3);
		if (r == 1)
			D1SndPlay("Sfx\\Warrior\\Wario14b.wav");
		else if (r == 2)
			D1SndPlay("Sfx\\Warrior\\Wario14c.wav");
		else
			D1SndPlay("Sfx\\Warrior\\Warior14.wav");
	}
}

U0 D1DeadguyTalk(I64 ti)
{//towners.cpp TalkToDeadguy
	I64 size = 0;

	if (ti < 0 || ti >= d1_ntwn || d1_twn[ti].kind != D1TK_DEADGUY)
		return;
	if (!d1_quest_inited)
		D1QuestInit;
	if (d1_quests[0].state == D1QS_DONE)
		return;

	if (d1_twn[ti].frozen || d1_quests[0].state == D1QS_ACTIVE)
	{//second click: player avenge line
		D1PlrAvengeVO;
		d1_talk_txt   = "Your death will be avenged!";
		d1_talk_timer = 60;
		return;
	}

	d1_quests[0].state = D1QS_ACTIVE;
	D1StrCopy(d1_twn[ti].name, "Slain Townsman", 24);
	d1_twn[ti].frozen = TRUE;

	if (!d1_dlg_cel)
		d1_dlg_cel = D1MpqRead("Data\\TextBox.CEL", &size);
	if (!d1_medtext)
		d1_medtext = D1MpqRead("Data\\MedTextS.CEL", &size);

	d1_store_open = TRUE;
	d1_store_twn  = ti;
	d1_store_type = D1SR_NONE;
	d1_store_mode = D1SM_LINE;
	d1_dlg_topic[0] = d1_deadguy_txt;
	d1_dlg_ntopic   = 1;
	d1_dlg_twn      = ti;
	d1_dlg_open     = TRUE;
	D1DlgTopic(0);
	D1VoxPlay("Sfx\\Towners\\Deadguy2.wav");
}

U0 D1DeadguySync()
{//after D1TownersInit / load: slain or gone from quest state
	I64 i;

	if (!d1_quest_inited)
		return;
	for (i = 0; i < d1_ntwn; i++)
	{
		if (d1_twn[i].kind == D1TK_DEADGUY)
		{
			if (d1_quests[0].state == D1QS_DONE)
			{
				d1_twn[i].active = FALSE;
				d1_dtwn[d1_twn[i].x + d1_twn[i].y * D1_MAXDUN] = 0;
			}
			else if (d1_quests[0].state == D1QS_ACTIVE)
			{
				D1StrCopy(d1_twn[i].name, "Slain Townsman", 24);
				d1_twn[i].frozen = TRUE;
			}
		}
	}
}

U0 D1DeadguyInstall()
{
	d1_deadguy_talk_cb = &D1DeadguyTalk;
}

D1DeadguyInstall;
