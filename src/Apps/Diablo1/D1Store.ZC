// D1Store.ZC - town stores (stores.cpp reduced)
//
// Griswold: Talk / Buy basic / Buy premium / Sell / Repair / Leave.
// Adria: Talk / Buy / Sell / Leave. Wirt: Talk / peek-buy / goodbye.
// Pepin heals on click; Cain identifies. Ogden/Gillian/Farnham: Talk/leave.
// Menus use TextBox2 (DrawSTextBack); buy/sell/ident lists use TextBox.
// Greeting = voice only over the open menu (no footer quote).
//
// towners.cpp TalkToTowner: clicking a towner opens the store menu at once
// and plays the greeting voice over it - alltext greeting rows carry no
// scrlltxt, so InitQTextMsg is voice only. the "Talk to <name>" row opens
// the S_StartTalk topic menu: Gossip plus one row per reached quest topic.
// a row plays that one line in the D1Towner scroll box; the box dismisses
// on any click or when the scroll runs out (minitext.cpp qtextflag), back
// to the topic menu. gossip picks at random from the towner's range, as
// S_TalkEnter rolls gossipstart..gossipend.
//
// the shell registers D1StoreDraw/Click/Keys with D1UI; the D1Towner box is
// drawn and dismissed from here, so no new call site.
//
// stock is rolled once per town visit (SetupTownStores): smith / witch /
// boy pools persist across TalkToTowner and only rebuild when leaving town.
// smith shelf splits basic[0..5] / premium[6..9]. sold slots mark itm < 0.
// price is D1AffixValue (base value through CalcItemValue); the sell price
// is a quarter of it.

#define D1SR_NONE		0
#define D1SR_SMITH		1
#define D1SR_WITCH		2
#define D1SR_BOY		3
#define D1SR_HEALER		4
#define D1SR_STORY		5
#define D1SR_TALK		6		//no stock: Ogden, Gillian, Farnham

#define D1SM_MENU		0
#define D1SM_BUY		1
#define D1SM_SELL		2
#define D1SM_TALK		3		//S_StartTalk topic menu
#define D1SM_REPAIR		4
#define D1SM_IDENT		5
#define D1SM_LINE		6		//one spoken line in the scroll box

//keys, translated by D1StoreKeys so the panel logic stays hardware free
#define D1SK_UP			1
#define D1SK_DOWN		2
#define D1SK_ENTER		3
#define D1SK_ESC		4
#define D1SK_SPACE		5

#define D1_MAXSTOCK		20
//full TextBox.CEL band (buy/sell/ident lists) — DrawQTextBack geometry
#define D1_STX			48
#define D1_STY			16
#define D1_STW			544
#define D1_STH			328
#define D1_STROW		18		//row pitch, baselines
#define D1_STROW0		76		//first row baseline, canvas y
#define D1_STVIS		13		//visible rows

//small TextBox2.CEL (menus / talk topics) — DrawSTextBack
#define D1_ST2_X		344
#define D1_ST2_BOT		327
#define D1_ST2_W		271
#define D1_ST2_FX		347
#define D1_ST2_FY		28
#define D1_ST2_FW		265
#define D1_ST2_FH		297
#define D1_ST2_TX		352		//PrintSString xx when !stextsize
#define D1_ST2_TW		257

#define D1_STPEEK		50		//Wirt's look fee

I64 D1Ssy(I64 line)
{//SStringY[line] + 44 — stores.cpp PrintSString baseline
	return line * 12 + 44;
}

class CD1Stock
{//st carries the full instance state - affix ids, rolled magnitudes, spell,
 //charges, durability - rolled once at stock time; a purchase copies it
 //wholesale, so the shelf item and the bought item are the same roll
	I64	 itm;
	I64	 val;			//rolled AC, as CD1Item.val
	I64	 price;
	CD1ItmSt st;
};

Bool d1_store_open = FALSE;
I64	 d1_store_type = D1SR_NONE;
I64	 d1_store_mode = D1SM_MENU;
I64	 d1_store_sel  = 0;
I64	 d1_store_top  = 0;
I64	 d1_store_twn  = -1;
Bool d1_store_peek = FALSE;			//Wirt's fee paid this visit

CD1Stock d1_stock[D1_MAXSTOCK];
I64	 d1_n_stock = 0;

//per-vendor shelf for this town stay; indices 0=smith 1=witch 2=boy
CD1Stock d1_town_pool[3][D1_MAXSTOCK];
I64	 d1_town_n[3];
Bool d1_town_stores_ok = FALSE;
I64	 d1_store_vendor = -1;			//active pool while a buy shelf is open

I64	 d1_sell_e[D1_MAXINV];			//inventory entries offered for sale
I64	 d1_n_sell = 0;

//repair / identify lists, storehidx encoding: >= 0 an inventory entry,
//< 0 the equip slot -(i + 1)
I64	 d1_svc_idx[D1_MAXINV + D1EQ_N];
I64	 d1_n_svc = 0;

U8	 d1_store_title[48];
U8	 d1_store_msg[64];
U8	 d1_store_row[D1_AFFNAME + 40];
U8	 d1_store_num[24];

//retail S_Start* menu rows (Talk first). smith splits buy basic / premium.
U8 *d1_smenu_smith[6] = {
	"Talk to Griswold", "Buy basic items", "Buy premium items",
	"Sell items", "Repair items", "Leave the shop"};
U8 *d1_smenu_witch[4] = {
	"Talk to Adria", "Buy items", "Sell items", "Leave the shack"};
U8 *d1_smenu_boy[3] = {
	"Talk to Wirt", "What have you got?", "Say goodbye"};
U8 *d1_smenu_healer[3] = {
	"Talk to Pepin", "Receive healing", "Leave Healer's home"};
U8 *d1_smenu_story[3] = {
	"Talk to Cain", "Identify an item", "Say goodbye"};

//smith buy slice: pool[0..5] basic, pool[6..9] premium (SpawnSmith+SpawnPremium)
Bool d1_store_prem = FALSE;
I64	 d1_stock_src[D1_MAXSTOCK];		//pool index for each d1_stock row

#define D1_SMITH_BASIC_N	6
#define D1_SMITH_PREM_N		4
#define D1_SMITH_STOCK_N	10

//stock-less towners: "Talk to <name>" / a leave row (S_StartTavern et al.)
U8	 d1_store_talkrow[40];
U8	*d1_store_leave = "Say goodbye";

//S_StartTalk topic rows for the current towner: the quest lines whose level
//has been reached. labels are D1Quest questlist names, duplicated because
//D1Quest compiles after this file (the D1_TWNQ precedent).
U8	*d1_talk_qname[D1_TWNQ] = {
	"The Butcher", "The Curse of King Leoric", "Ogden's Sign",
	"The Magic Rock", "The Chamber of Bone", "Halls of the Blind",
	"Zhar the Mad", "Black Mushroom", "Anvil of Fury", "Warlord of Blood",
	"Lachdanan", "Archbishop Lazarus", "Diablo"};
U8	*d1_talk_line[D1_TWNQ];			//quest topic text per row
I64	 d1_talk_qrow[D1_TWNQ];			//quest index per row, for the label
I64	 d1_n_talk = 0;

U0 D1StoreNum(U8 *dst, I64 v)
{//decimal, no kernel formatter: StrPrint's %d width is not I64 portable here
	U8	 tmp[24];
	I64	 n = 0;
	I64	 i = 0;
	Bool neg = FALSE;

	if (v < 0)
	{
		neg = TRUE;
		v = -v;
	}
	if (v == 0)
	{
		tmp[n] = '0';
		n++;
	}
	while (v > 0 && n < 20)
	{
		tmp[n] = '0' + v % 10;
		n++;
		v /= 10;
	}
	if (neg)
	{
		dst[i] = '-';
		i++;
	}
	while (n > 0)
	{
		n--;
		dst[i] = tmp[n];
		i++;
	}
	dst[i] = 0;
}

U0 D1StoreMsg(U8 *s)
{
	D1StrCopy(d1_store_msg, s, 64);
}

//--- towner voice ----------------------------------------------------------
//
// minitext.cpp InitQTextMsg plays alltext[m].sfxnr for the line it puts up.
// Every towner line is an effects.cpp sfx_STREAM row, and stream_play() opens
// with stream_stop(), so one line at a time and a new one cuts the previous.
// Retail's scroll runs on its own timer, never on the audio; dismissing the
// box in town calls stream_stop (diablo.cpp PressEscKey, stores.cpp
// STextESC). Paging within a line is silent - one alltext row, one sound.
//
// The D1Snd LRU is bypassed. The 171 lines are 22050Hz 8-bit mono up to 44.4s
// (Sfx\Towners\Storyt18.wav, 979688 bytes), 8.5MB each at 48kHz stereo and
// 504MB for the set, against 16 D1SND_CACHE slots holding the game's hot sfx.
// Each plays once per visit, so caching them would evict that working set for
// no reuse. One buffer lives at a time, released when the next line starts -
// the single sghStream retail keeps, decoded up front instead of streamed.

U32	*d1_vox_frames = NULL;		//48kHz stereo, owned here; the mixer borrows it
I64	 d1_vox_count  = 0;
I64	 d1_vox_handle = -1;
U8	*d1_vox_cur    = NULL;		//path on the channel, NULL when silent

U0 D1VoxStop()
{//effects.cpp stream_stop. the mixer holds the buffer across its mix pass,
 //so stop, outwait it, then release.
	if (d1_vox_handle >= 0)
	{
		D1SndHwStop(d1_vox_handle);
		D1SndHwIdle(d1_vox_handle);
		d1_vox_handle = -1;
		D1SndHwDrain;
	}
	if (d1_vox_frames)
		Free(d1_vox_frames);
	d1_vox_frames = NULL;
	d1_vox_count  = 0;
	d1_vox_cur    = NULL;
}

U0 D1VoxInstall()
{//teardown reaches the channel through D1Snd; app exit never opens the panel
	d1snd_vox_stop = &D1VoxStop;
}

D1VoxInstall;

U0 D1VoxPlay(U8 *path)
{//one spoken line on a voice of its own, outside the sfx cache
	U8	*raw;
	U32	*native = NULL;
	I64	 size   = 0;
	I64	 rate   = 0;
	I64	 ncount;

	D1VoxStop;
	if (!path || !path[0])
		return;
	if (!d1_opt_sfx || !d1snd_ready || !d1snd_on)
		return;

	raw = D1MpqRead(path, &size);
	if (!raw)
		return;
	ncount = D1SndDecodeNative(raw, size, &native, &rate);
	Free(raw);
	if (!ncount)
		return;
	//48kHz so the mixer steps 1:1; AudioSFXPlayRef nearest-samples anything
	//else, and speech at 0.459 of the output rate stair-steps audibly
	d1_vox_frames = D1SndResample48(native, ncount, rate, &d1_vox_count);
	Free(native);
	if (!d1_vox_frames)
		return;

	d1_vox_handle = D1SndHwPlay(d1_vox_frames, d1_vox_count, D1SND_RATE,
		d1_snd_sfx_vol, FALSE);
	if (d1_vox_handle < 0)
	{
		Free(d1_vox_frames);
		d1_vox_frames = NULL;
		d1_vox_count  = 0;
		return;
	}
	d1_vox_cur = path;
}

U0 D1StoreLineOpen(U8 *s)
{//minitext.cpp InitQTextMsg for one alltext row: the scroll box holds this
 //line alone and the line speaks
	I64 size = 0;

	if (!s)
		return;
	if (!d1_dlg_cel)
		d1_dlg_cel = D1MpqRead("Data\\TextBox.CEL", &size);
	if (!d1_medtext)
		d1_medtext = D1MpqRead("Data\\MedTextS.CEL", &size);
	d1_dlg_topic[0] = s;
	d1_dlg_ntopic   = 1;
	d1_dlg_twn      = d1_store_twn;
	d1_dlg_open     = TRUE;
	D1DlgTopic(0);
	d1_store_mode = D1SM_LINE;
	D1VoxPlay(D1TwnVox(s));
}

I64 D1StoreLvl()
{//stock depth follows the character, as SpawnSmith uses _pLevel
	I64 l = d1_plr_lvl;

	if (l < 1)
		l = 1;
	if (l > 16)
		l = 16;
	return l;
}

//--- stock -----------------------------------------------------------------

Bool D1StoreWants(I64 itm, I64 type)
{//class filter per store
	CD1ItmDef *d = &d1_itmdefs[itm];

	if (d->cls == D1IC_GOLD)
		return FALSE;
	//stores.cpp: WitchItems carries staves, SmithItems does not
	if (type == D1SR_WITCH)
		return d->misc != 0 || d->stf;
	if (type == D1SR_SMITH)
		return d->misc == 0 && !d->stf &&
			(d->cls == D1IC_WEAPON || d->cls == D1IC_ARMOR);
	if (type == D1SR_BOY)
		return d->misc == 0 && !d->stf &&
			(d->cls == D1IC_WEAPON || d->cls == D1IC_ARMOR);
	return FALSE;
}

I64 D1StorePickBase(I64 type, I64 lvl)
{//level-fit pool for this store; -1 when nothing qualifies
	I64 pool[D1_MAXITMDEF];
	I64 n = 0;
	I64 i;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (D1StoreWants(i, type) && d1_itmdefs[i].mlvl <= lvl)
		{
			pool[n] = i;
			n++;
		}
	}
	if (n == 0)
		return -1;
	return pool[D1Rnd(n)];
}

U0 D1StoreAdd(I64 itm, I64 lvl, I64 mult_num, I64 mult_den, Bool force_magic)
{//one stock row; price is scaled by mult_num/mult_den (Wirt's markup)
	CD1ItmDef *d;
	CD1Stock  *s;
	I64	 val = 0;
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 r1;
	I64	 r2;

	if (itm < 0 || itm >= d1_n_itmdefs || d1_n_stock >= D1_MAXSTOCK)
		return;
	d = &d1_itmdefs[itm];
	if (d->acmax > 0)
		val = d->acmin + D1Rnd(d->acmax - d->acmin + 1);

	//SetupAllItems: magic when the 10% roll or the level roll passes.
	//usables (potions, books) stay plain.
	r1 = D1Rnd(100);
	r2 = D1Rnd(100);
	if (!d->misc && (force_magic || r1 <= 10 || r2 <= lvl))
		D1AffixRoll(itm, lvl, &pfx, &sfx);

	s = &d1_stock[d1_n_stock];
	s->itm = itm;
	s->val = val;
	D1StClear(&s->st);
	s->st.ident  = TRUE;			//shop stock is on display
	s->st.maxdur = d->dur;
	s->st.dur    = d->dur;
	s->st.pfx    = pfx;
	s->st.sfx    = sfx;
	if (d->stf && d1_spl_staff)
	{//GetStaffSpell at stock time, as D1PowDropRoll rolls floor staves
		I64 sp = 0;
		I64 ch = 0;

		(*d1_spl_staff)(lvl, &sp, &ch);
		if (sp)
		{
			s->st.spl    = sp;
			s->st.chg    = ch;
			s->st.maxchg = ch;
		}
	}
	D1PowStAffRoll(&s->st);
	s->price = (D1AffixValue(itm, pfx, sfx, s->st.pfxval, s->st.sfxval) *
		mult_num) / mult_den;
	if (s->st.spl && d1_spl_cost)
		s->price += ((*d1_spl_cost)(s->st.spl - 1) * s->st.chg) / 5;
	if (s->price < 1)
		s->price = 1;
	d1_n_stock++;
}

U0 D1StoreGenSmith(I64 lvl)
{//six plain rows then four premium (always magic), SpawnSmith + SpawnPremium
	I64 i;
	I64 itm;

	for (i = 0; i < 10; i++)
	{
		itm = D1StorePickBase(D1SR_SMITH, lvl);
		if (itm >= 0)
			D1StoreAdd(itm, lvl, 1, 1, i >= 6);
	}
}

U0 D1StoreGenWitch(I64 lvl)
{//potions, staves, spell books (SpawnWitch)
	I64 i;
	I64 itm;

	for (i = 0; i < 8; i++)
	{
		itm = D1StorePickBase(D1SR_WITCH, lvl);
		if (itm >= 0)
			D1StoreAdd(itm, lvl, 1, 1, FALSE);
	}
}

U0 D1StoreGenBoy(I64 lvl)
{//one magic item at 1.5x, S_StartBoy's _iIvalue + (_iIvalue >> 1)
	I64 itm = D1StorePickBase(D1SR_BOY, lvl);

	if (itm >= 0)
		D1StoreAdd(itm, lvl, 3, 2, TRUE);
}

I64 D1StoreVendorSlot(I64 type)
{
	if (type == D1SR_SMITH)
		return 0;
	if (type == D1SR_WITCH)
		return 1;
	if (type == D1SR_BOY)
		return 2;
	return -1;
}

U0 D1StoreCopyStockToPool(I64 v)
{
	I64 i;

	if (v < 0 || v >= 3)
		return;
	for (i = 0; i < d1_n_stock; i++)
	{
		d1_town_pool[v][i].itm   = d1_stock[i].itm;
		d1_town_pool[v][i].val   = d1_stock[i].val;
		d1_town_pool[v][i].price = d1_stock[i].price;
		D1StCopy(&d1_town_pool[v][i].st, &d1_stock[i].st);
	}
	d1_town_n[v] = d1_n_stock;
}

U0 D1StoreCopyPoolToStock(I64 v)
{
	I64 i;

	d1_n_stock = 0;
	if (v < 0 || v >= 3)
		return;
	for (i = 0; i < d1_town_n[v]; i++)
	{
		if (d1_town_pool[v][i].itm >= 0)
		{
			d1_stock[d1_n_stock].itm   = d1_town_pool[v][i].itm;
			d1_stock[d1_n_stock].val   = d1_town_pool[v][i].val;
			d1_stock[d1_n_stock].price = d1_town_pool[v][i].price;
			D1StCopy(&d1_stock[d1_n_stock].st, &d1_town_pool[v][i].st);
			d1_stock_src[d1_n_stock] = i;
			d1_n_stock++;
		}
	}
}

U0 D1StoreLoadSmithSlice(Bool prem)
{//basic = pool[0..5], premium = pool[6..9]; sold slots keep itm < 0
	I64 i;
	I64 lo;
	I64 hi;
	I64 v = 0;

	d1_store_prem = prem;
	lo = 0;
	hi = D1_SMITH_BASIC_N;
	if (prem)
	{
		lo = D1_SMITH_BASIC_N;
		hi = D1_SMITH_STOCK_N;
	}
	d1_n_stock = 0;
	for (i = lo; i < hi && i < d1_town_n[v]; i++)
	{
		if (d1_town_pool[v][i].itm >= 0)
		{
			d1_stock[d1_n_stock].itm   = d1_town_pool[v][i].itm;
			d1_stock[d1_n_stock].val   = d1_town_pool[v][i].val;
			d1_stock[d1_n_stock].price = d1_town_pool[v][i].price;
			D1StCopy(&d1_stock[d1_n_stock].st, &d1_town_pool[v][i].st);
			d1_stock_src[d1_n_stock] = i;
			d1_n_stock++;
		}
	}
}

U0 D1StoreInvalidateTown()
{//leave town / new game: next SetupTownStores rolls fresh shelves
	d1_town_stores_ok = FALSE;
	d1_store_vendor   = -1;
	d1_town_n[0] = 0;
	d1_town_n[1] = 0;
	d1_town_n[2] = 0;
}

U0 D1StoreSetupTown(I64 seed)
{//retail SetupTownStores: once per town stay. seed 0 = keep current RNG
	I64 lvl;

	if (d1_town_stores_ok)
		return;
	D1AffixInit;
	if (seed)
		D1SetRndSeed(seed);
	lvl = D1StoreLvl();
	d1_n_stock = 0;
	D1StoreGenSmith(lvl);
	D1StoreCopyStockToPool(0);
	d1_n_stock = 0;
	D1StoreGenWitch(lvl);
	D1StoreCopyStockToPool(1);
	d1_n_stock = 0;
	D1StoreGenBoy(lvl);
	D1StoreCopyStockToPool(2);
	d1_n_stock = 0;
	d1_town_stores_ok = TRUE;
}

U0 D1StoreBuildSell()
{//inventory entries the current store will take; potions to Adria, gear
 //to Griswold
	I64 e;
	I64 itm;

	d1_n_sell = 0;
	for (e = 0; e < D1_MAXINV; e++)
	{
		itm = d1_inv_itm[e];
		if (itm >= 0 && D1StoreWants(itm, d1_store_type))
		{
			d1_sell_e[d1_n_sell] = e;
			d1_n_sell++;
		}
	}
}

//--- repair and identify lists ---------------------------------------------
//
// stores.cpp S_StartSRepair and S_StartSIdentify walk the equipped slots
// first, then the inventory, and hold the item's index in storehidx.

U0 D1StoreBuildRepair()
{
	I64 s;
	I64 e;

	d1_n_svc = 0;
	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1DurPriceEquip(s) > 0)
		{
			d1_svc_idx[d1_n_svc] = -(s + 1);
			d1_n_svc++;
		}
	}
	for (e = 0; e < D1_MAXINV; e++)
	{
		if (D1DurPriceInv(e) > 0)
		{
			d1_svc_idx[d1_n_svc] = e;
			d1_n_svc++;
		}
	}
}

U0 D1StoreBuildIdent()
{
	I64 s;
	I64 e;

	d1_n_svc = 0;
	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1IdOkEquip(s))
		{
			d1_svc_idx[d1_n_svc] = -(s + 1);
			d1_n_svc++;
		}
	}
	for (e = 0; e < D1_MAXINV; e++)
	{
		if (D1IdOkInv(e))
		{
			d1_svc_idx[d1_n_svc] = e;
			d1_n_svc++;
		}
	}
}

U0 D1StoreSvcName(I64 i, U8 *dst)
{
	dst[0] = 0;
	if (i < 0 || i >= d1_n_svc)
		return;
	if (d1_svc_idx[i] < 0)
		D1PowNameEquip(dst, -d1_svc_idx[i] - 1);
	else
		D1PowNameInv(dst, d1_svc_idx[i]);
}

I64 D1StoreSvcPrice(I64 i)
{
	if (i < 0 || i >= d1_n_svc)
		return 0;
	if (d1_store_mode == D1SM_IDENT)
		return D1_IDPRICE;
	if (d1_svc_idx[i] < 0)
		return D1DurPriceEquip(-d1_svc_idx[i] - 1);
	return D1DurPriceInv(d1_svc_idx[i]);
}

//--- rows ------------------------------------------------------------------

I64 D1StoreMenuN()
{
	if (d1_store_type == D1SR_SMITH)
		return 6;
	if (d1_store_type == D1SR_WITCH)
		return 4;
	if (d1_store_type == D1SR_BOY)
		return 3;
	if (d1_store_type == D1SR_HEALER)
		return 3;
	if (d1_store_type == D1SR_STORY)
		return 3;
	if (d1_store_type == D1SR_TALK)
		return 2;
	return 0;
}

U8 *D1StoreMenuLabel(I64 i)
{
	if (i < 0 || i >= D1StoreMenuN())
		return "";
	if (d1_store_type == D1SR_SMITH)
		return d1_smenu_smith[i];
	if (d1_store_type == D1SR_WITCH)
		return d1_smenu_witch[i];
	if (d1_store_type == D1SR_BOY)
		return d1_smenu_boy[i];
	if (d1_store_type == D1SR_HEALER)
		return d1_smenu_healer[i];
	if (d1_store_type == D1SR_TALK)
	{
		if (i == 0)
			return d1_store_talkrow;
		return d1_store_leave;
	}
	return d1_smenu_story[i];
}

I64 D1StoreRowN()
{//buy, sell and service lists end with a Back row
	if (d1_store_mode == D1SM_LINE)
		return 0;
	if (d1_store_mode == D1SM_TALK)
		return d1_n_talk + 2;		//Gossip, the quest topics, Back
	if (d1_store_mode == D1SM_BUY)
		return d1_n_stock + 1;
	if (d1_store_mode == D1SM_SELL)
		return d1_n_sell + 1;
	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
		return d1_n_svc + 1;
	return D1StoreMenuN();
}

I64 D1StoreRowText(I64 i, U8 *dst)
{//fills dst with the row label; returns the row price, 0 when it has none
	I64 e;

	dst[0] = 0;
	if (d1_store_mode == D1SM_BUY)
	{
		if (i >= d1_n_stock)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		if (d1_store_type == D1SR_BOY && !d1_store_peek)
		{
			D1StrCopy(dst, "Pay 50 gold for a look", D1_AFFNAME + 40);
			return D1_STPEEK;
		}
		D1PowName(dst, d1_stock[i].itm, &d1_stock[i].st,
			d1_stock[i].st.pfx, d1_stock[i].st.sfx);
		return d1_stock[i].price;
	}
	if (d1_store_mode == D1SM_SELL)
	{
		if (i >= d1_n_sell)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		e = d1_sell_e[i];
		D1PowNameInv(dst, e);
		return D1PowValueInv(e) / 4;
	}
	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
	{
		if (i >= d1_n_svc)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		D1StoreSvcName(i, dst);
		return D1StoreSvcPrice(i);
	}
	if (d1_store_mode == D1SM_TALK)
	{//S_StartTalk rows: Gossip, then the reached quest topics by name
		if (i == 0)
			D1StrCopy(dst, "Gossip", D1_AFFNAME + 40);
		else if (i <= d1_n_talk)
			D1StrCopy(dst, d1_talk_qname[d1_talk_qrow[i - 1]],
				D1_AFFNAME + 40);
		else
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
		return 0;
	}
	D1StrCopy(dst, D1StoreMenuLabel(i), D1_AFFNAME + 40);
	return 0;
}

//--- transactions ----------------------------------------------------------

U0 D1StoreRemoveStock(I64 idx)
{
	I64 i;
	I64 src;
	I64 v;

	if (idx < 0 || idx >= d1_n_stock)
		return;
	v = d1_store_vendor;
	if (v >= 0 && v < 3)
	{//mark the town-pool slot sold; rebuild the active shelf from the pool
		src = d1_stock_src[idx];
		if (src >= 0 && src < d1_town_n[v])
			d1_town_pool[v][src].itm = -1;
		if (v == 0 && d1_store_type == D1SR_SMITH)
			D1StoreLoadSmithSlice(d1_store_prem);
		else
			D1StoreCopyPoolToStock(v);
		return;
	}
	for (i = idx; i < d1_n_stock - 1; i++)
	{
		d1_stock[i].itm   = d1_stock[i + 1].itm;
		d1_stock[i].val   = d1_stock[i + 1].val;
		d1_stock[i].price = d1_stock[i + 1].price;
		D1StCopy(&d1_stock[i].st, &d1_stock[i + 1].st);
		d1_stock_src[i] = d1_stock_src[i + 1];
	}
	d1_n_stock--;
}

Bool D1StoreBuy(I64 idx)
{
	CD1Stock *s;
	I64	 itm;
	I64	 slot;
	Bool ok;

	if (idx < 0 || idx >= d1_n_stock)
		return FALSE;
	s   = &d1_stock[idx];
	itm = s->itm;

	if (d1_plr_gold < s->price)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}

	ok = FALSE;
	if (d1_itmdefs[itm].misc && d1_itmdefs[itm].misc != D1IM_BOOK)
	{//potions go to the belt when one is free, as pickup does
		slot = -1;
		for (slot = 0; slot < 8; slot++)
		{
			if (!ok && !d1_belt[slot])
			{
				d1_belt[slot] = itm;
				ok = TRUE;
			}
		}
	}
	if (!ok)
	{
		ok = D1AffInvPut(itm, s->val, s->st.pfx, s->st.sfx);
		if (ok && d1_inv_last >= 0)
			D1StCopy(&d1_st_inv[d1_inv_last], &s->st);
	}
	if (!ok)
	{
		D1StoreMsg("You do not have enough room.");
		return FALSE;
	}

	d1_plr_gold -= s->price;
	D1StoreRemoveStock(idx);
	D1StoreMsg("Thank you for your business.");
	D1ItmSndPlay(itm);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

Bool D1StoreSell(I64 idx)
{
	I64 e;
	I64 itm;
	I64 price;

	if (idx < 0 || idx >= d1_n_sell)
		return FALSE;
	e = d1_sell_e[idx];
	itm = d1_inv_itm[e];
	if (itm < 0)
		return FALSE;

	price = D1PowValueInv(e) / 4;
	if (price < 1)
		price = 1;

	d1_plr_gold += price;
	D1AffSetInv(e, 0, 0);
	D1InvRemove(e);
	D1StoreBuildSell();
	D1StoreMsg("Pleasure doing business.");
	D1ItmSndPlay(itm);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

//--- open / close ----------------------------------------------------------

U0 D1StoreClose()
{
	D1VoxStop;
	D1TownerDlgClose;
	d1_store_open = FALSE;
	d1_store_type = D1SR_NONE;
	d1_store_twn  = -1;
	d1_store_mode = D1SM_MENU;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_n_stock    = 0;
	d1_n_sell     = 0;
	d1_n_svc      = 0;
}

U0 D1StoreLineDismiss()
{//diablo.cpp qtextflag click: drop the box, stop the stream, back to the
 //topic menu. Deadguy speech has no topic menu - close the store.
	Bool dead;

	dead = ToBool(d1_store_twn >= 0 && d1_store_twn < d1_ntwn &&
		d1_twn[d1_store_twn].kind == D1TK_DEADGUY);
	D1VoxStop;
	D1TownerDlgClose;
	if (dead)
		D1StoreClose;
	else
		d1_store_mode = D1SM_TALK;
}

U0 D1StoreToggle()
{//D1UI registry shape. a store only opens through D1StoreEnter, so the
 //toggle is close-only.
	if (d1_store_open)
		D1StoreClose;
}

I64 D1StoreTypeFor(I64 ti)
{
	U8 *n;

	if (ti < 0 || ti >= d1_ntwn)
		return D1SR_NONE;
	if (d1_twn[ti].kind == D1TK_DEADGUY || d1_twn[ti].kind == D1TK_COW)
		return D1SR_NONE;
	n = d1_twn[ti].name;
	if (!StrCompare(n, "Griswold"))
		return D1SR_SMITH;
	if (!StrCompare(n, "Adria"))
		return D1SR_WITCH;
	if (!StrCompare(n, "Wirt"))
		return D1SR_BOY;
	if (!StrCompare(n, "Pepin"))
		return D1SR_HEALER;
	if (!StrCompare(n, "Cain"))
		return D1SR_STORY;
	return D1SR_TALK;
}

U0 D1StoreBuildTalk()
{//the quest topics this towner carries for the depth reached; the gate
 //D1TownerTalk used, one row per line instead of a chain
	I64 q;

	D1TownerTextInit;
	d1_n_talk = 0;
	for (q = 0; q < D1_TWNQ; q++)
	{
		if (d1_twn_quest[d1_store_twn * D1_TWNQ + q] &&
			d1_deepest_lvl >= d1_twn_qlvl[q])
		{
			d1_talk_line[d1_n_talk] = d1_twn_quest[d1_store_twn * D1_TWNQ + q];
			d1_talk_qrow[d1_n_talk] = q;
			d1_n_talk++;
		}
	}
}

U0 D1StoreEnterTalk()
{//stores.cpp S_StartTalk: a topic menu, not a chained conversation
	D1StoreBuildTalk();
	d1_store_mode = D1SM_TALK;
	d1_store_sel  = 0;
	d1_store_top  = 0;
}

I64 D1StoreEnter(I64 ti)
{//0 only when the tile holds no towner at all
	I64 type = D1StoreTypeFor(ti);
	I64 vendor;

	if (ti < 0 || ti >= d1_ntwn || type == D1SR_NONE)
		return 0;

	D1AffixInit;
	d1_store_type  = type;
	d1_store_twn   = ti;
	d1_store_mode  = D1SM_MENU;
	d1_store_sel   = 0;
	d1_store_top   = 0;
	d1_store_peek  = FALSE;
	d1_n_sell      = 0;
	d1_n_svc       = 0;
	d1_store_vendor = -1;
	d1_store_open  = TRUE;
	d1_store_prem  = FALSE;
	D1StrCopy(d1_store_title, d1_twn[ti].name, 48);
	if (type == D1SR_STORY)
		D1StrCopy(d1_store_title, "The Town Elder", 48);
	else if (type == D1SR_SMITH)
		D1StrCopy(d1_store_title, "Blacksmith's shop", 48);
	else if (type == D1SR_WITCH)
		D1StrCopy(d1_store_title, "Witch's shack", 48);
	else if (type == D1SR_HEALER)
		D1StrCopy(d1_store_title, "Healer's home", 48);
	else if (type == D1SR_BOY)
		D1StrCopy(d1_store_title, "Wirt the Peg-legged boy", 48);
	d1_store_msg[0] = 0;

	//TalkToTowner: the greeting is voice over the open menu; alltext greet
	//rows carry no scrlltxt, so retail's InitQTextMsg plays sound only.
	//do not park the quote in store_msg - that slot is for transaction
	//lines ("Thank you...", "not enough gold") drawn at the box foot.
	D1TownerTextInit;
	D1VoxPlay(D1TwnVox(d1_twn_greet[ti]));

	if (type == D1SR_TALK)
	{//S_StartTavern / S_StartBarMaid / S_StartDrunk: Talk row + leave row
		StrPrint(d1_store_talkrow, "Talk to %s", d1_twn[ti].name);
		if (!StrCompare(d1_twn[ti].name, "Ogden"))
		{
			D1StrCopy(d1_store_title, "Rising Sun", 48);
			d1_store_leave = "Leave the tavern";
		}
		else if (!StrCompare(d1_twn[ti].name, "Gillian"))
		{
			D1StrCopy(d1_store_title, "Gillian", 48);
			d1_store_leave = "Say goodbye";
		}
		else
		{
			D1StrCopy(d1_store_title, "Farnham the Drunk", 48);
			d1_store_leave = "Say goodbye";
		}
		return 1;
	}

	if (!d1_town_stores_ok)
		D1StoreSetupTown(0);
	vendor = D1StoreVendorSlot(type);
	d1_store_vendor = vendor;
	if (vendor >= 0 && type != D1SR_SMITH)
		D1StoreCopyPoolToStock(vendor);
	else
		d1_n_stock = 0;
	//vanilla Pepin: heal only on "Receive healing" click (S_HealerEnter),
	//not on S_StartHealer open. Hellfire auto-heals; this port is vanilla.
	D1StoreBuildSell();
	return 1;
}

Bool D1TownerUse(I64 ti)
{//click/arrive: cow moo, Deadguy quest speech, else shop/talk store.
 //TRUE = handled (no fallback quote).
	if (ti < 0 || ti >= d1_ntwn || !d1_twn[ti].active)
		return FALSE;
	if (d1_twn[ti].kind == D1TK_COW)
	{
		D1CowTalk(ti);
		return TRUE;
	}
	if (d1_twn[ti].kind == D1TK_DEADGUY)
	{
		if (d1_deadguy_talk_cb)
			(*d1_deadguy_talk_cb)(ti);
		return TRUE;
	}
	return ToBool(D1StoreEnter(ti));
}

//--- activation ------------------------------------------------------------

U0 D1StoreBackToMenu()
{
	D1VoxStop;
	D1TownerDlgClose;
	d1_store_mode = D1SM_MENU;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_prem = FALSE;
	d1_store_msg[0] = 0;
	if (d1_store_type == D1SR_STORY)
		D1StrCopy(d1_store_title, "The Town Elder", 48);
	else if (d1_store_type == D1SR_SMITH)
		D1StrCopy(d1_store_title, "Blacksmith's shop", 48);
	else if (d1_store_type == D1SR_WITCH)
		D1StrCopy(d1_store_title, "Witch's shack", 48);
	else if (d1_store_type == D1SR_HEALER)
		D1StrCopy(d1_store_title, "Healer's home", 48);
	else if (d1_store_type == D1SR_BOY)
		D1StrCopy(d1_store_title, "Wirt the Peg-legged boy", 48);
	else if (d1_store_type == D1SR_TALK && d1_store_twn >= 0)
	{
		if (!StrCompare(d1_twn[d1_store_twn].name, "Ogden"))
			D1StrCopy(d1_store_title, "Rising Sun", 48);
		else if (!StrCompare(d1_twn[d1_store_twn].name, "Gillian"))
			D1StrCopy(d1_store_title, "Gillian", 48);
		else
			D1StrCopy(d1_store_title, "Farnham the Drunk", 48);
	}
}

U0 D1StoreEnterBuy()
{
	d1_store_mode = D1SM_BUY;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_prem = FALSE;
	d1_store_msg[0] = 0;
	if (d1_store_type == D1SR_SMITH)
	{
		D1StoreLoadSmithSlice(FALSE);
		D1StrCopy(d1_store_title, "I have these items for sale:", 48);
	}
	else
	{
		if (d1_store_vendor >= 0)
			D1StoreCopyPoolToStock(d1_store_vendor);
		D1StrCopy(d1_store_title, "I have these items for sale:", 48);
	}
}

U0 D1StoreEnterBuyPrem()
{//S_StartSPBuy — Griswold premium shelf only
	d1_store_mode = D1SM_BUY;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_msg[0] = 0;
	D1StoreLoadSmithSlice(TRUE);
	D1StrCopy(d1_store_title, "I have these premium items for sale:", 48);
	if (d1_n_stock == 0)
	{
		D1StoreMsg("I have no premium items for sale.");
		D1StoreBackToMenu;
	}
}

U0 D1StoreEnterSell()
{
	D1StoreBuildSell();
	d1_store_mode = D1SM_SELL;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_msg[0] = 0;
	if (d1_n_sell == 0)
		D1StrCopy(d1_store_title, "You have nothing I want.", 48);
	else
		D1StrCopy(d1_store_title, "Which item is for sale?", 48);
}

U0 D1StoreEnterRepair()
{
	D1StoreBuildRepair();
	d1_store_mode = D1SM_REPAIR;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_msg[0] = 0;
	if (d1_n_svc == 0)
		D1StrCopy(d1_store_title, "You have nothing to repair.", 48);
	else
		D1StrCopy(d1_store_title, "Repair which item?", 48);
}

U0 D1StoreEnterIdent()
{
	D1StoreBuildIdent();
	d1_store_mode = D1SM_IDENT;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_store_msg[0] = 0;
	//retail: empty shelf uses the nothing-string as stext line 1 (title)
	if (d1_n_svc == 0)
		D1StrCopy(d1_store_title, "You have nothing to identify.", 48);
	else
		D1StrCopy(d1_store_title, "Identify which item?", 48);
}

Bool D1StoreRepair(I64 i)
{//stores.cpp SmithRepairItem: pay, then restore durability to the maximum
	I64 price = D1StoreSvcPrice(i);
	I64 idx;

	if (i < 0 || i >= d1_n_svc || price <= 0)
		return FALSE;
	if (d1_plr_gold < price)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}
	idx = d1_svc_idx[i];
	d1_plr_gold -= price;
	if (idx < 0)
		D1DurRepairEquip(-idx - 1);
	else
		D1DurRepairInv(idx);
	D1StoreBuildRepair();
	D1StoreMsg("Good as new.");
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

Bool D1StoreIdentify(I64 i)
{//stores.cpp StoryIdItem: the flat D1_IDPRICE, then the item reads true
	I64 idx;

	if (i < 0 || i >= d1_n_svc)
		return FALSE;
	if (d1_plr_gold < D1_IDPRICE)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}
	idx = d1_svc_idx[i];
	d1_plr_gold -= D1_IDPRICE;
	if (idx < 0)
		D1IdEquip(-idx - 1);
	else
		D1IdInv(idx);
	if (idx < 0)
		D1PowNameEquip(d1_store_row, -idx - 1);
	else
		D1PowNameInv(d1_store_row, idx);
	D1StrCopy(d1_store_msg, d1_store_row, 64);
	D1StoreBuildIdent();
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

U0 D1StoreMenuActivate(I64 i)
{
	if (d1_store_type == D1SR_SMITH)
	{//Talk / Buy basic / Buy premium / Sell / Repair / Leave
		if (i == 0)
			D1StoreEnterTalk;
		else if (i == 1)
			D1StoreEnterBuy;
		else if (i == 2)
			D1StoreEnterBuyPrem;
		else if (i == 3)
			D1StoreEnterSell;
		else if (i == 4)
			D1StoreEnterRepair;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_WITCH)
	{//Talk / Buy / Sell / Leave
		if (i == 0)
			D1StoreEnterTalk;
		else if (i == 1)
			D1StoreEnterBuy;
		else if (i == 2)
			D1StoreEnterSell;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_BOY)
	{//Talk / What have you got / Say goodbye
		if (i == 0)
			D1StoreEnterTalk;
		else if (i == 1)
			D1StoreEnterBuy;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_HEALER)
	{
		if (i == 0)
			D1StoreEnterTalk;
		else if (i == 1)
		{//S_HealerEnter case 14: free full heal
			if (d1_plr_hp != d1_plr_maxhp && d1_opt_sfx)
				D1SndPlay("Sfx\\Misc\\Cast8.wav");
			d1_plr_hp = d1_plr_maxhp;
			D1StoreMsg("Your wounds are healed.");
		}
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_STORY)
	{
		if (i == 0)
			D1StoreEnterTalk;
		else if (i == 1)
			D1StoreEnterIdent;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_TALK)
	{
		if (i == 0)
			D1StoreEnterTalk;
		else
			D1StoreClose;
	}
}

U0 D1StoreDlgSync()
{//D1TownerDlgTick hook: the scroll ran the line out and dropped the box
 //(minitext.cpp clears qtextflag past the last row). back to the topic
 //menu; the voice plays to its own end. Deadguy one-shot closes store.
	if (!d1_store_open || d1_store_mode != D1SM_LINE)
		return;
	if (!d1_dlg_open)
	{
		if (d1_store_twn >= 0 && d1_store_twn < d1_ntwn &&
			d1_twn[d1_store_twn].kind == D1TK_DEADGUY)
			D1StoreClose;
		else
			d1_store_mode = D1SM_TALK;
	}
}

U0 D1StoreDlgInstall()
{//the tick hook lives in D1Towner, compiled earlier
	d1_dlg_topic_cb = &D1StoreDlgSync;
}

D1StoreDlgInstall;

U0 D1StoreActivate(I64 i)
{
	I64 g;

	if (!d1_store_open)
		return;
	if (d1_store_mode == D1SM_LINE)
	{
		D1StoreLineDismiss;
		return;
	}
	if (i < 0 || i >= D1StoreRowN())
		return;

	if (d1_store_mode == D1SM_TALK)
	{//S_TalkEnter: Gossip rolls one line from the towner's range; a quest
	 //row plays its line
		if (i == 0)
		{
			g = d1_twn_ngossip[d1_store_twn];
			if (g > 0)
				D1StoreLineOpen(
					d1_twn_gossip[d1_store_twn * D1_MAXGOSSIP + D1Rnd(g)]);
		}
		else if (i <= d1_n_talk)
			D1StoreLineOpen(d1_talk_line[i - 1]);
		else
			D1StoreBackToMenu;
		return;
	}

	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
	{
		if (i >= d1_n_svc)
		{
			D1StoreBackToMenu;
			return;
		}
		if (d1_store_mode == D1SM_REPAIR)
			D1StoreRepair(i);
		else
			D1StoreIdentify(i);
		return;
	}

	if (d1_store_mode == D1SM_BUY)
	{
		if (i >= d1_n_stock)
		{
			D1StoreBackToMenu;
			return;
		}
		if (d1_store_type == D1SR_BOY && !d1_store_peek)
		{//Wirt shows nothing until the look fee is paid
			if (d1_plr_gold < D1_STPEEK)
			{
				D1StoreMsg("You do not have enough gold.");
				return;
			}
			d1_plr_gold -= D1_STPEEK;
			d1_store_peek = TRUE;
			D1StoreMsg("Take a look at this.");
			return;
		}
		D1StoreBuy(i);
		return;
	}
	if (d1_store_mode == D1SM_SELL)
	{
		if (i >= d1_n_sell)
		{
			D1StoreBackToMenu;
			return;
		}
		D1StoreSell(i);
		return;
	}
	D1StoreMenuActivate(i);
}

//--- input -----------------------------------------------------------------

U0 D1StoreScrollFix()
{
	I64 n = D1StoreRowN();

	if (d1_store_sel < 0)
		d1_store_sel = 0;
	if (d1_store_sel >= n)
		d1_store_sel = n - 1;
	if (d1_store_sel < d1_store_top)
		d1_store_top = d1_store_sel;
	if (d1_store_sel >= d1_store_top + D1_STVIS)
		d1_store_top = d1_store_sel - D1_STVIS + 1;
	if (d1_store_top < 0)
		d1_store_top = 0;
}

U0 D1StoreKey(I64 k)
{//hardware free; D1StoreKeys does the edge detection
	I64 n;

	if (!d1_store_open)
		return;

	if (d1_store_mode == D1SM_LINE)
	{//any of the dismiss keys drops the line box
		if (k == D1SK_SPACE || k == D1SK_ENTER || k == D1SK_ESC)
			D1StoreLineDismiss;
		return;
	}

	n = D1StoreRowN();
	if (n < 1)
		return;

	if (k == D1SK_UP)
	{
		d1_store_sel--;
		if (d1_store_sel < 0)
			d1_store_sel = n - 1;
	}
	else if (k == D1SK_DOWN)
	{
		d1_store_sel++;
		if (d1_store_sel >= n)
			d1_store_sel = 0;
	}
	else if (k == D1SK_ENTER)
		D1StoreActivate(d1_store_sel);
	else if (k == D1SK_ESC)
	{
		if (d1_store_mode == D1SM_MENU)
			D1StoreClose;
		else
			D1StoreBackToMenu;
	}
	D1StoreScrollFix;
}

Bool d1_sk_up    = FALSE;
Bool d1_sk_down  = FALSE;
Bool d1_sk_enter = FALSE;
Bool d1_sk_esc   = FALSE;
Bool d1_sk_space = FALSE;

Bool D1StoreEdge(I64 sc, Bool *held)
{
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

U0 D1StoreKeys()
{//arrows move, ENTER activates, ESC backs out
	if (!d1_store_open)
		return;
	if (D1StoreEdge(SC_CURSOR_UP, &d1_sk_up))
		D1StoreKey(D1SK_UP);
	if (D1StoreEdge(SC_CURSOR_DOWN, &d1_sk_down))
		D1StoreKey(D1SK_DOWN);
	if (D1StoreEdge(SC_ENTER, &d1_sk_enter))
		D1StoreKey(D1SK_ENTER);
	if (D1StoreEdge(SC_ESC, &d1_sk_esc))
		D1StoreKey(D1SK_ESC);
	if (D1StoreEdge(Char2ScanCode(' '), &d1_sk_space))
		D1StoreKey(D1SK_SPACE);
}

Bool D1StoreIsSmall()
{//stextsize == FALSE: menus and talk-topic lists use TextBox2
	return d1_store_mode == D1SM_MENU || d1_store_mode == D1SM_TALK;
}

I64 D1StorePanelX()
{
	if (D1StoreIsSmall)
		return D1_ST2_TX;
	return D1_STX;
}

I64 D1StorePanelW()
{
	if (D1StoreIsSmall)
		return D1_ST2_TW;
	return D1_STW;
}

I64 D1StoreMenuLine(I64 i)
{//stext[] line index for selectable menu/talk row i (S_Start* layout)
	I64 n;

	if (d1_store_mode == D1SM_TALK)
	{//Gossip at 12, topics +2, Back near foot
		if (i <= 0)
			return 12;
		n = D1StoreRowN();
		if (i >= n - 1)
			return 22;
		return 12 + i * 2;
	}
	if (d1_store_type == D1SR_STORY)
	{//S_StartStory: 12 / 14 / 18
		if (i == 0)
			return 12;
		if (i == 1)
			return 14;
		return 18;
	}
	if (d1_store_type == D1SR_TALK)
	{
		if (i == 0)
			return 12;
		return 18;
	}
	if (d1_store_type == D1SR_BOY)
	{//Talk / look / goodbye
		if (i == 0)
			return 12;
		if (i == 1)
			return 18;
		return 20;
	}
	if (d1_store_type == D1SR_HEALER)
	{//Talk / heal / leave
		if (i == 0)
			return 12;
		if (i == 1)
			return 14;
		return 18;
	}
	if (d1_store_type == D1SR_WITCH)
	{//Talk / Buy / Sell / Leave — 12 / 14 / 16 / 20
		if (i == 0)
			return 12;
		if (i == 1)
			return 14;
		if (i == 2)
			return 16;
		return 20;
	}
	//smith: Talk / basic / premium / Sell / Repair / Leave
	if (i == 0)
		return 10;
	if (i == 1)
		return 12;
	if (i == 2)
		return 14;
	if (i == 3)
		return 16;
	if (i == 4)
		return 18;
	return 20;
}

I64 D1StoreOptY(I64 i)
{//canvas baseline for selectable row i
	if (D1StoreIsSmall)
		return D1Ssy(D1StoreMenuLine(i));
	return D1_STROW0 + (i - d1_store_top) * D1_STROW;
}

I64 D1StoreRowAt(I64 cy)
{//row index under a band-local y (caller subtracts D1UiOrgY), or -1
	I64 i;
	I64 by;
	I64 n = D1StoreRowN();
	I64 best;
	I64 d;
	I64 bd;

	if (n <= 0)
		return -1;
	if (D1StoreIsSmall)
	{//menus: pick nearest option. text sits above the PrintSString
	 //baseline, so a tight [by-13,by+4) band misses most of the glyph.
		best = -1;
		bd   = 99;
		for (i = 0; i < n; i++)
		{
			by = D1StoreOptY(i);
			d  = cy - by;
			if (d < 0)
				d = -d;
			if (d < bd && d <= 14)
			{
				bd   = d;
				best = i;
			}
		}
		return best;
	}
	for (i = 0; i < D1_STVIS; i++)
	{
		by = D1_STROW0 + i * D1_STROW;
		if (cy >= by - 13 && cy < by + 5 && d1_store_top + i < n)
			return d1_store_top + i;
	}
	return -1;
}

//--- info box hover ---------------------------------------------------------

Bool D1StoreHitItem(I64 cx, I64 cy, I64 *itm, CD1ItmSt **st, I64 *val)
{//item under a canvas-coordinate hover on a buy, sell, repair or identify
 //row. buy rows carry the stock's own state record - identified, full
 //durability, the rolled affixes and staff charges; sell and service rows
 //hand back the inventory or equip record they reference. FALSE on Back,
 //the Wirt fee row, menus and misses.
	I64 row;
	I64 e;

	*itm = -1;
	*st  = NULL;
	*val = 0;
	if (!d1_store_open)
		return FALSE;
	if (d1_store_mode != D1SM_BUY && d1_store_mode != D1SM_SELL &&
		d1_store_mode != D1SM_REPAIR && d1_store_mode != D1SM_IDENT)
		return FALSE;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx < D1_STX || cx >= D1_STX + D1_STW ||
		cy < D1_STY || cy >= D1_STY + D1_STH)
		return FALSE;
	row = D1StoreRowAt(cy);
	if (row < 0)
		return FALSE;

	if (d1_store_mode == D1SM_BUY)
	{
		if (row >= d1_n_stock)
			return FALSE;
		if (d1_store_type == D1SR_BOY && !d1_store_peek)
			return FALSE;
		*itm = d1_stock[row].itm;
		*st  = &d1_stock[row].st;
		*val = d1_stock[row].val;
		return TRUE;
	}
	if (d1_store_mode == D1SM_SELL)
	{
		if (row >= d1_n_sell)
			return FALSE;
		e = d1_sell_e[row];
		if (d1_inv_itm[e] < 0)
			return FALSE;
		*itm = d1_inv_itm[e];
		*st  = &d1_st_inv[e];
		*val = d1_inv_val[e];
		return TRUE;
	}
	if (row >= d1_n_svc)
		return FALSE;
	e = d1_svc_idx[row];
	if (e < 0)
	{
		*itm = d1_equip_itm[-e - 1];
		*st  = &d1_st_equip[-e - 1];
		*val = d1_equip_val[-e - 1];
	}
	else
	{
		*itm = d1_inv_itm[e];
		*st  = &d1_st_inv[e];
		*val = d1_inv_val[e];
	}
	return *itm >= 0;
}

Bool D1StoreInfoFill(I64 cx, I64 cy)
{//fill the panel info box for the hovered store row; D1Panel calls this
 //when the inventory hover found nothing
	I64	 itm;
	I64	 val;
	CD1ItmSt *st;

	if (!D1StoreHitItem(cx, cy, &itm, &st, &val))
		return FALSE;
	D1InfoItem(itm, st, val);
	return TRUE;
}

Bool D1StoreClick(I64 cx, I64 cy)
{//canvas coords. TRUE = consumed; any click while store open is.
	I64 row;
	I64 px;
	I64 pw;
	I64 py;
	I64 ph;

	if (!d1_store_open)
		return FALSE;
	if (d1_store_mode == D1SM_LINE)
	{//any click dismisses the line box
		D1StoreLineDismiss;
		return TRUE;
	}
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (D1StoreIsSmall)
	{//TextBox2 frame (CheckStoreBtn windowRect)
		px = D1_ST2_X;
		pw = D1_ST2_W;
		py = D1_ST2_FY - 12;
		ph = D1_ST2_FH + 24;
	}
	else
	{
		px = D1_STX;
		pw = D1_STW;
		py = D1_STY;
		ph = D1_STH;
	}
	if (cx < px || cx >= px + pw || cy < py || cy >= py + ph)
		return TRUE;			//outside: eat click, leave store open

	row = D1StoreRowAt(cy);
	if (row >= 0)
	{
		d1_store_sel = row;
		D1StoreActivate(row);
		D1StoreScrollFix;
	}
	return TRUE;
}

U0 D1StoreHover(I64 cx, I64 cy)
{//mouse-move selection (pent highlight), no activate
	I64 row;
	I64 px;
	I64 pw;

	if (!d1_store_open || d1_store_mode == D1SM_LINE)
		return;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (D1StoreIsSmall)
	{
		px = D1_ST2_X;
		pw = D1_ST2_W;
	}
	else
	{
		px = D1_STX;
		pw = D1_STW;
	}
	if (cx < px || cx >= px + pw)
		return;
	row = D1StoreRowAt(cy);
	if (row >= 0 && row != d1_store_sel)
	{
		d1_store_sel = row;
		D1StoreScrollFix;
	}
}

//--- draw ------------------------------------------------------------------

U8	*d1_pentspn2   = NULL;		//Data\PentSpn2.CEL: 8 12x12 pentagram frames
U8	*d1_textslid   = NULL;		//Data\TextSlid.CEL: arrows + thumb + track
U8	*d1_stextbox2  = NULL;		//Data\TextBox2.CEL — small store menus
I64	 d1_store_anim = 0;

U0 D1StoreFrame()
{//DrawSTextBack (TextBox2) for menus; DrawQTextBack (TextBox) for lists.
 //retail: CelDraw the filigree first, then asm_trans_rect dither on the
 //inset - so the gold frame stays fullbright and the town dither-shows.
	I64 ox = D1UiOrgX();
	I64 ty = D1UiOrgY();
	I64 size = 0;

	d1_shade = NULL;
	d1_cel_trans = FALSE;
	if (D1StoreIsSmall)
	{
		if (!d1_stextbox2)
			d1_stextbox2 = D1MpqRead("Data\\TextBox2.CEL", &size);
		if (d1_stextbox2)
			D1CelDraw(ox + D1_ST2_X, ty + D1_ST2_BOT, d1_stextbox2, 1, D1_ST2_W);
		D1FillRectTransDither(ox + D1_ST2_FX, ty + D1_ST2_FY, D1_ST2_FW,
			D1_ST2_FH);
		return;
	}
	if (!d1_dlg_cel)
		d1_dlg_cel = D1MpqRead("Data\\TextBox.CEL", &size);
	if (d1_dlg_cel)
		D1CelDraw(ox + D1_DLG_X, ty + D1_DLG_BOT, d1_dlg_cel, 1, D1_DLG_W);
	D1FillRectTransDither(ox + D1_DLG_FX, ty + D1_DLG_FY, D1_DLG_FW, D1_DLG_FH);
}

U0 D1StoreSlider(I64 n)
{//DrawSSlider: TextSlid.CEL on the right of the full TextBox when list scrolls
	I64 ox = D1UiOrgX();
	I64 ty = D1UiOrgY();
	I64 y1;
	I64 y2;
	I64 y;
	I64 thumb;
	I64 size = 0;
	I64 track;

	if (D1StoreIsSmall || n <= D1_STVIS)
		return;
	if (!d1_textslid)
		d1_textslid = D1MpqRead("Data\\TextSlid.CEL", &size);
	if (!d1_textslid)
		return;

	y1 = ty + D1_STROW0;
	y2 = ty + D1_STROW0 + (D1_STVIS - 1) * D1_STROW;
	D1CelDraw(ox + 601, y1, d1_textslid, 9, 12);	//up
	D1CelDraw(ox + 601, y2, d1_textslid, 8, 12);	//down
	for (y = y1 + D1_STROW; y < y2; y += D1_STROW)
		D1CelDraw(ox + 601, y, d1_textslid, 13, 12);	//track
	track = y2 - y1 - D1_STROW;
	if (track < 1)
		track = 1;
	thumb = (d1_store_top * track) / (n - D1_STVIS);
	D1CelDraw(ox + 601, y1 + D1_STROW + thumb, d1_textslid, 12, 12);
}

Bool D1StoreStatOk(I64 itm, CD1ItmSt *st)
{//items.cpp StoreStatOk — only minstr in this port's item table
	CD1ItmDef *d;

	if (itm < 0 || itm >= d1_n_itmdefs)
		return TRUE;
	d = &d1_itmdefs[itm];
	if (st->ident && st->nominstr)
		return TRUE;
	if (d->minstr && D1InvStr() < d->minstr)
		return FALSE;
	return TRUE;
}

I64 D1StoreItemColor(I64 itm, CD1ItmSt *st)
{//stores.cpp buy/sell iclr: white → blue if _iMagical → red if !StatOk.
 //cursed gear is still MAGIC → blue; red is unmet str only.
	I64 iclr = D1COL_WHITE;

	if (D1PowIsMagic(st, st->pfx, st->sfx))
		iclr = D1COL_BLUE;
	if (!D1StoreStatOk(itm, st))
		iclr = D1COL_RED;
	return iclr;
}

I64 D1StoreRowColor(I64 row, I64 price)
{
	I64 e;

	no_warn price;
	if (d1_store_mode == D1SM_BUY && row >= 0 && row < d1_n_stock)
		return D1StoreItemColor(d1_stock[row].itm, &d1_stock[row].st);
	if (d1_store_mode == D1SM_SELL && row >= 0 && row < d1_n_sell)
	{
		e = d1_sell_e[row];
		if (e >= 0 && e < D1_MAXINV && d1_inv_itm[e] >= 0)
			return D1StoreItemColor(d1_inv_itm[e], &d1_st_inv[e]);
	}
	if (row == d1_store_sel)
		return D1COL_GOLD;
	return D1COL_WHITE;
}

U0 D1StoreDrawRow(I64 slot, I64 row)
{
	I64 by;
	I64 ox = D1UiOrgX() + D1StorePanelX;
	I64 pw = D1StorePanelW;
	I64 price;
	I64 tc;
	I64 f;
	I64 tw;
	Bool center;

	if (D1StoreIsSmall)
		by = D1UiOrgY() + D1StoreOptY(row);
	else
		by = D1UiOrgY() + D1_STROW0 + slot * D1_STROW;

	price = D1StoreRowText(row, d1_store_row);
	tc    = D1StoreRowColor(row, price);
	center = D1StoreIsSmall;
	if (!center && price <= 0 &&
		(d1_store_mode == D1SM_BUY || d1_store_mode == D1SM_SELL ||
			d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT) &&
		(row == d1_n_stock || row == d1_n_sell || row == d1_n_svc))
		center = TRUE;
	if (row == d1_store_sel && d1_pentspn2)
	{//PentSpn2 pentagrams flank the selected row (DrawSText's _ssel draw)
		f = (d1_store_anim / 2) % 8 + 1;
		if (center)
		{
			tw = D1TextWidth(d1_store_row);
			D1CelDraw(ox + pw / 2 - tw / 2 - 20, by + 2, d1_pentspn2, f, 12);
			D1CelDraw(ox + pw / 2 + tw / 2 + 8, by + 2, d1_pentspn2, f, 12);
		}
		else
		{
			D1CelDraw(ox - 16, by + 2, d1_pentspn2, f, 12);
			D1CelDraw(ox + pw - 8, by + 2, d1_pentspn2, f, 12);
		}
	}
	if (center)
		D1TextDrawCol(ox + pw / 2 - D1TextWidth(d1_store_row) / 2, by,
			d1_store_row, tc);
	else
		D1TextDrawCol(ox + 4, by, d1_store_row, tc);
	if (price > 0 && !D1StoreIsSmall)
	{
		D1StoreNum(d1_store_num, price);
		D1TextDrawCol(ox + pw - 8 - D1TextWidth(d1_store_num), by,
			d1_store_num, tc);
	}
}

U0 D1StoreHdrLine(I64 line, U8 *s)
{
	I64 ox = D1UiOrgX() + D1StorePanelX;
	I64 pw = D1StorePanelW;
	I64 y = D1UiOrgY() + D1Ssy(line);

	D1TextDrawCol(ox + pw / 2 - D1TextWidth(s) / 2, y, s, D1COL_GOLD);
}

U0 D1StoreDrawHeaders()
{//non-selectable labels + divider for TextBox2 menus (S_Start*)
	I64 ox = D1UiOrgX() + D1StorePanelX;
	I64 pw = D1StorePanelW;
	I64 ty = D1UiOrgY();
	I64 y;
	U8 *prompt = "Would you like to:";

	if (!D1StoreIsSmall)
		return;

	if (d1_store_mode == D1SM_TALK)
	{
		D1StoreHdrLine(2, d1_store_title);
		y = ty + D1Ssy(5) + 3;
		D1FillRect(ox + 8, y, pw - 16, 1, 198);
		D1FillRect(ox + 8, y + 1, pw - 16, 1, 196);
		D1StoreHdrLine(9, "Talk to:");
		return;
	}

	//S_Start* title blocks
	if (d1_store_type == D1SR_SMITH || d1_store_type == D1SR_HEALER ||
		(d1_store_type == D1SR_TALK &&
			d1_store_twn >= 0 &&
			!StrCompare(d1_twn[d1_store_twn].name, "Ogden")))
	{
		D1StoreHdrLine(1, "Welcome to the");
		D1StoreHdrLine(3, d1_store_title);
		y = ty + D1Ssy(5) + 3;
		D1FillRect(ox + 8, y, pw - 16, 1, 198);
		D1FillRect(ox + 8, y + 1, pw - 16, 1, 196);
		if (d1_store_type == D1SR_SMITH)
			D1StoreHdrLine(7, prompt);
		else
			D1StoreHdrLine(9, prompt);
		return;
	}

	D1StoreHdrLine(2, d1_store_title);
	y = ty + D1Ssy(5) + 3;
	D1FillRect(ox + 8, y, pw - 16, 1, 198);
	D1FillRect(ox + 8, y + 1, pw - 16, 1, 196);
	if (d1_store_type != D1SR_BOY)
		D1StoreHdrLine(9, prompt);
}

U0 D1StoreDraw()
{
	I64 n;
	I64 i;
	I64 row;
	I64 size = 0;
	I64 ox = D1UiOrgX() + D1StorePanelX;
	I64 pw = D1StorePanelW;
	I64 tx;

	if (!d1_store_open)
		return;
	if (d1_store_mode == D1SM_LINE)
	{
		D1TownerDlgDraw;
		return;
	}
	if (!d1_pentspn2)
		d1_pentspn2 = D1MpqRead("Data\\PentSpn2.CEL", &size);
	d1_store_anim++;
	D1StoreFrame;

	if (D1StoreIsSmall)
		D1StoreDrawHeaders;
	else
	{
		tx = ox + pw / 2 - D1TextWidth(d1_store_title) / 2;
		D1TextDrawCol(tx, D1UiOrgY() + 52, d1_store_title, D1COL_GOLD);

		D1StrCopy(d1_store_row, "Gold: ", D1_AFFNAME + 40);
		D1StoreNum(d1_store_num, d1_plr_gold);
		D1AffixCat(d1_store_row, 6, d1_store_num, D1_AFFNAME + 40);
		D1TextDrawCol(ox + 16, D1UiOrgY() + 52, d1_store_row, D1COL_GOLD);
	}

	n = D1StoreRowN();
	if (D1StoreIsSmall)
	{
		for (i = 0; i < n; i++)
			D1StoreDrawRow(0, i);
	}
	else
	{
		for (i = 0; i < D1_STVIS; i++)
		{
			row = d1_store_top + i;
			if (row < n)
				D1StoreDrawRow(i, row);
		}
		D1StoreSlider(n);
	}

	if (d1_store_msg[0])
		D1TextDrawCol(ox + pw / 2 - D1TextWidth(d1_store_msg) / 2,
			D1UiOrgY() + D1_STY + D1_STH - 12, d1_store_msg, D1COL_GOLD);
}
