// D1Store.ZC - town stores (stores.cpp reduced)
//
// Griswold buys, sells and repairs, Adria deals in potions, Wirt offers one
// item at a markup behind a 50 gold peek fee, Pepin heals, Cain identifies.
// Ogden, Gillian and Farnham keep no stock and open straight into dialog.
//
// every towner opens this panel, so the D1Towner dialog box is drawn and
// paged from here: the shell already registers D1StoreDraw/Click/Keys with
// D1UI, and routing dialog through them needs no new call site.
//
// stock is regenerated on every visit from the base item table filtered by
// class and by the character level, the same way SpawnSmith / SpawnPremium
// draw theirs. price is D1AffixValue (base value through CalcItemValue);
// the sell price is a quarter of it.
//
// the panel is drawn with the small font instead of the original's
// ui_art text; rows are band-local and draw at D1UiOrgY(), so the
// control panel area below the band stays clear.

#define D1SR_NONE		0
#define D1SR_SMITH		1
#define D1SR_WITCH		2
#define D1SR_BOY		3
#define D1SR_HEALER		4
#define D1SR_STORY		5
#define D1SR_TALK		6		//no stock: Ogden, Gillian, Farnham

#define D1SM_MENU		0
#define D1SM_BUY		1
#define D1SM_SELL		2
#define D1SM_TALK		3
#define D1SM_REPAIR		4
#define D1SM_IDENT		5

//keys, translated by D1StoreKeys so the panel logic stays hardware free
#define D1SK_UP			1
#define D1SK_DOWN		2
#define D1SK_ENTER		3
#define D1SK_ESC		4
#define D1SK_SPACE		5

#define D1_MAXSTOCK		20
//band-local left edge; the store draws at D1UiOrgX() + D1_STX, rows at
//D1UiOrgY(), and D1StoreClick subtracts the same origins
#define D1_STX			48
#define D1_STY			16
#define D1_STW			544
#define D1_STH			328
#define D1_STROW		18		//row pitch, baselines
#define D1_STROW0		76		//first row baseline, canvas y
#define D1_STVIS		13		//visible rows

#define D1_STPEEK		50		//Wirt's look fee

class CD1Stock
{
	I64	 itm;
	I64	 val;			//rolled AC, as CD1Item.val
	I64	 pfx;
	I64	 sfx;
	I64	 spl;			//staff spell id + 1, 0 none
	I64	 chg;
	I64	 maxchg;
	I64	 price;
};

Bool d1_store_open = FALSE;
I64	 d1_store_type = D1SR_NONE;
I64	 d1_store_mode = D1SM_MENU;
I64	 d1_store_sel  = 0;
I64	 d1_store_top  = 0;
I64	 d1_store_twn  = -1;
Bool d1_store_peek = FALSE;			//Wirt's fee paid this visit

CD1Stock d1_stock[D1_MAXSTOCK];
I64	 d1_n_stock = 0;

I64	 d1_sell_e[D1_MAXINV];			//inventory entries offered for sale
I64	 d1_n_sell = 0;

//repair / identify lists, storehidx encoding: >= 0 an inventory entry,
//< 0 the equip slot -(i + 1)
I64	 d1_svc_idx[D1_MAXINV + D1EQ_N];
I64	 d1_n_svc = 0;

U8	 d1_store_title[32];
U8	 d1_store_msg[64];
U8	 d1_store_row[D1_AFFNAME + 40];
U8	 d1_store_num[24];

U8 *d1_smenu_smith[5] = {"Buy items", "Sell items", "Repair items", "Talk to Griswold", "Leave the shop"};
U8 *d1_smenu_witch[4] = {"Buy items", "Sell items", "Talk to Adria", "Leave the shop"};
U8 *d1_smenu_boy[2] = {"What have you got?", "Say goodbye"};
U8 *d1_smenu_healer[3] = {"Receive healing", "Talk to Pepin", "Goodbye"};
U8 *d1_smenu_story[3] = {"Identify an item", "Talk to Cain", "Goodbye"};

U0 D1StoreNum(U8 *dst, I64 v)
{//decimal, no kernel formatter: StrPrint's %d width is not I64 portable here
	U8	 tmp[24];
	I64	 n = 0;
	I64	 i = 0;
	Bool neg = FALSE;

	if (v < 0)
	{
		neg = TRUE;
		v = -v;
	}
	if (v == 0)
	{
		tmp[n] = '0';
		n++;
	}
	while (v > 0 && n < 20)
	{
		tmp[n] = '0' + v % 10;
		n++;
		v /= 10;
	}
	if (neg)
	{
		dst[i] = '-';
		i++;
	}
	while (n > 0)
	{
		n--;
		dst[i] = tmp[n];
		i++;
	}
	dst[i] = 0;
}

U0 D1StoreMsg(U8 *s)
{
	D1StrCopy(d1_store_msg, s, 64);
}

//--- towner voice ----------------------------------------------------------
//
// minitext.cpp InitQTextMsg plays alltext[m].sfxnr for the line it puts up.
// Every towner line is an effects.cpp sfx_STREAM row, and stream_play() opens
// with stream_stop(), so one line at a time and a new one cuts the previous.
// Retail's scroll runs on its own timer, never on the audio; dismissing the
// box in town calls stream_stop (diablo.cpp PressEscKey, stores.cpp
// STextESC). Paging within a line is silent - one alltext row, one sound.
//
// The D1Snd LRU is bypassed. The 171 lines are 22050Hz 8-bit mono up to 44.4s
// (Sfx\Towners\Storyt18.wav, 979688 bytes), 8.5MB each at 48kHz stereo and
// 504MB for the set, against 16 D1SND_CACHE slots holding the game's hot sfx.
// Each plays once per visit, so caching them would evict that working set for
// no reuse. One buffer lives at a time, released when the next line starts -
// the single sghStream retail keeps, decoded up front instead of streamed.

U32	*d1_vox_frames = NULL;		//48kHz stereo, owned here; the mixer borrows it
I64	 d1_vox_count  = 0;
I64	 d1_vox_handle = -1;
U8	*d1_vox_cur    = NULL;		//path on the channel, NULL when silent

U0 D1VoxStop()
{//effects.cpp stream_stop. the mixer holds the buffer across its mix pass,
 //so stop, outwait it, then release.
	if (d1_vox_handle >= 0)
	{
		D1SndHwStop(d1_vox_handle);
		D1SndHwIdle(d1_vox_handle);
		d1_vox_handle = -1;
		D1SndHwDrain;
	}
	if (d1_vox_frames)
		Free(d1_vox_frames);
	d1_vox_frames = NULL;
	d1_vox_count  = 0;
	d1_vox_cur    = NULL;
}

U0 D1VoxInstall()
{//teardown reaches the channel through D1Snd; app exit never opens the panel
	d1snd_vox_stop = &D1VoxStop;
}

D1VoxInstall;

U0 D1VoxPlay(U8 *path)
{//one spoken line on a voice of its own, outside the sfx cache
	U8	*raw;
	U32	*native = NULL;
	I64	 size   = 0;
	I64	 rate   = 0;
	I64	 ncount;

	D1VoxStop;
	if (!path || !path[0])
		return;
	if (!d1_opt_sfx || !d1snd_ready || !d1snd_on)
		return;

	raw = D1MpqRead(path, &size);
	if (!raw)
		return;
	ncount = D1SndDecodeNative(raw, size, &native, &rate);
	Free(raw);
	if (!ncount)
		return;
	//48kHz so the mixer steps 1:1; AudioSFXPlayRef nearest-samples anything
	//else, and speech at 0.459 of the output rate stair-steps audibly
	d1_vox_frames = D1SndResample48(native, ncount, rate, &d1_vox_count);
	Free(native);
	if (!d1_vox_frames)
		return;

	d1_vox_handle = D1SndHwPlay(d1_vox_frames, d1_vox_count, D1SND_RATE,
		D1SND_SFX_VOL, FALSE);
	if (d1_vox_handle < 0)
	{
		Free(d1_vox_frames);
		d1_vox_frames = NULL;
		d1_vox_count  = 0;
		return;
	}
	d1_vox_cur = path;
}

U0 D1StoreTalkVoice()
{//the line for the topic on screen; silence when the box is down
	if (d1_dlg_open && d1_dlg_ti >= 0 && d1_dlg_ti < d1_dlg_ntopic)
		D1VoxPlay(D1TwnVox(d1_dlg_topic[d1_dlg_ti]));
	else
		D1VoxStop;
}

I64 D1StoreLvl()
{//stock depth follows the character, as SpawnSmith uses _pLevel
	I64 l = d1_plr_lvl;

	if (l < 1)
		l = 1;
	if (l > 16)
		l = 16;
	return l;
}

//--- stock -----------------------------------------------------------------

Bool D1StoreWants(I64 itm, I64 type)
{//class filter per store
	CD1ItmDef *d = &d1_itmdefs[itm];

	if (d->cls == D1IC_GOLD)
		return FALSE;
	//stores.cpp: WitchItems carries staves, SmithItems does not
	if (type == D1SR_WITCH)
		return d->misc != 0 || d->stf;
	if (type == D1SR_SMITH)
		return d->misc == 0 && !d->stf &&
			(d->cls == D1IC_WEAPON || d->cls == D1IC_ARMOR);
	if (type == D1SR_BOY)
		return d->misc == 0 && !d->stf &&
			(d->cls == D1IC_WEAPON || d->cls == D1IC_ARMOR);
	return FALSE;
}

I64 D1StorePickBase(I64 type, I64 lvl)
{//level-fit pool for this store; -1 when nothing qualifies
	I64 pool[D1_MAXITMDEF];
	I64 n = 0;
	I64 i;

	for (i = 0; i < d1_n_itmdefs; i++)
	{
		if (D1StoreWants(i, type) && d1_itmdefs[i].mlvl <= lvl)
		{
			pool[n] = i;
			n++;
		}
	}
	if (n == 0)
		return -1;
	return pool[D1Rnd(n)];
}

U0 D1StoreAdd(I64 itm, I64 lvl, I64 mult_num, I64 mult_den, Bool force_magic)
{//one stock row; price is scaled by mult_num/mult_den (Wirt's markup)
	CD1ItmDef *d;
	CD1Stock  *s;
	I64	 val = 0;
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 r1;
	I64	 r2;

	if (itm < 0 || itm >= d1_n_itmdefs || d1_n_stock >= D1_MAXSTOCK)
		return;
	d = &d1_itmdefs[itm];
	if (d->acmax > 0)
		val = d->acmin + D1Rnd(d->acmax - d->acmin + 1);

	//SetupAllItems: magic when the 10% roll or the level roll passes
	r1 = D1Rnd(100);
	r2 = D1Rnd(100);
	if (force_magic || r1 <= 10 || r2 <= lvl)
		D1AffixRoll(itm, lvl, &pfx, &sfx);

	s = &d1_stock[d1_n_stock];
	s->itm    = itm;
	s->val    = val;
	s->pfx    = pfx;
	s->sfx    = sfx;
	s->spl    = 0;
	s->chg    = 0;
	s->maxchg = 0;
	if (d->stf && d1_spl_staff)
	{//GetStaffSpell at stock time, as D1PowDropRoll rolls floor staves
		I64 sp = 0;
		I64 ch = 0;

		(*d1_spl_staff)(lvl, &sp, &ch);
		if (sp)
		{
			s->spl    = sp;
			s->chg    = ch;
			s->maxchg = ch;
		}
	}
	s->price = (D1AffixValue(itm, pfx, sfx) * mult_num) / mult_den;
	if (s->spl && d1_spl_cost)
		s->price += ((*d1_spl_cost)(s->spl - 1) * s->chg) / 5;
	if (s->price < 1)
		s->price = 1;
	d1_n_stock++;
}

U0 D1StoreGenSmith(I64 lvl)
{//six plain rows then four premium (always magic), SpawnSmith + SpawnPremium
	I64 i;
	I64 itm;

	for (i = 0; i < 10; i++)
	{
		itm = D1StorePickBase(D1SR_SMITH, lvl);
		if (itm >= 0)
			D1StoreAdd(itm, lvl, 1, 1, i >= 6);
	}
}

U0 D1StoreGenWitch(I64 lvl)
{//potions and staves; the base table carries no books
	I64 i;
	I64 itm;

	for (i = 0; i < 8; i++)
	{
		itm = D1StorePickBase(D1SR_WITCH, lvl);
		if (itm >= 0)
			D1StoreAdd(itm, lvl, 1, 1, FALSE);
	}
}

U0 D1StoreGenBoy(I64 lvl)
{//one magic item at 1.5x, S_StartBoy's _iIvalue + (_iIvalue >> 1)
	I64 itm = D1StorePickBase(D1SR_BOY, lvl);

	if (itm >= 0)
		D1StoreAdd(itm, lvl, 3, 2, TRUE);
}

U0 D1StoreBuildSell()
{//inventory entries the current store will take; potions to Adria, gear
 //to Griswold
	I64 e;
	I64 itm;

	d1_n_sell = 0;
	for (e = 0; e < D1_MAXINV; e++)
	{
		itm = d1_inv_itm[e];
		if (itm >= 0 && D1StoreWants(itm, d1_store_type))
		{
			d1_sell_e[d1_n_sell] = e;
			d1_n_sell++;
		}
	}
}

//--- repair and identify lists ---------------------------------------------
//
// stores.cpp S_StartSRepair and S_StartSIdentify walk the equipped slots
// first, then the inventory, and hold the item's index in storehidx.

U0 D1StoreBuildRepair()
{
	I64 s;
	I64 e;

	d1_n_svc = 0;
	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1DurPriceEquip(s) > 0)
		{
			d1_svc_idx[d1_n_svc] = -(s + 1);
			d1_n_svc++;
		}
	}
	for (e = 0; e < D1_MAXINV; e++)
	{
		if (D1DurPriceInv(e) > 0)
		{
			d1_svc_idx[d1_n_svc] = e;
			d1_n_svc++;
		}
	}
}

U0 D1StoreBuildIdent()
{
	I64 s;
	I64 e;

	d1_n_svc = 0;
	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1IdOkEquip(s))
		{
			d1_svc_idx[d1_n_svc] = -(s + 1);
			d1_n_svc++;
		}
	}
	for (e = 0; e < D1_MAXINV; e++)
	{
		if (D1IdOkInv(e))
		{
			d1_svc_idx[d1_n_svc] = e;
			d1_n_svc++;
		}
	}
}

U0 D1StoreSvcName(I64 i, U8 *dst)
{
	dst[0] = 0;
	if (i < 0 || i >= d1_n_svc)
		return;
	if (d1_svc_idx[i] < 0)
		D1PowNameEquip(dst, -d1_svc_idx[i] - 1);
	else
		D1PowNameInv(dst, d1_svc_idx[i]);
}

I64 D1StoreSvcPrice(I64 i)
{
	if (i < 0 || i >= d1_n_svc)
		return 0;
	if (d1_store_mode == D1SM_IDENT)
		return D1_IDPRICE;
	if (d1_svc_idx[i] < 0)
		return D1DurPriceEquip(-d1_svc_idx[i] - 1);
	return D1DurPriceInv(d1_svc_idx[i]);
}

//--- rows ------------------------------------------------------------------

I64 D1StoreMenuN()
{
	if (d1_store_type == D1SR_SMITH)
		return 5;
	if (d1_store_type == D1SR_WITCH)
		return 4;
	if (d1_store_type == D1SR_BOY)
		return 2;
	if (d1_store_type == D1SR_HEALER)
		return 3;
	if (d1_store_type == D1SR_STORY)
		return 3;
	return 0;
}

U8 *D1StoreMenuLabel(I64 i)
{
	if (i < 0 || i >= D1StoreMenuN())
		return "";
	if (d1_store_type == D1SR_SMITH)
		return d1_smenu_smith[i];
	if (d1_store_type == D1SR_WITCH)
		return d1_smenu_witch[i];
	if (d1_store_type == D1SR_BOY)
		return d1_smenu_boy[i];
	if (d1_store_type == D1SR_HEALER)
		return d1_smenu_healer[i];
	return d1_smenu_story[i];
}

I64 D1StoreRowN()
{//buy, sell and service lists end with a Back row
	if (d1_store_mode == D1SM_TALK)
		return 0;
	if (d1_store_mode == D1SM_BUY)
		return d1_n_stock + 1;
	if (d1_store_mode == D1SM_SELL)
		return d1_n_sell + 1;
	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
		return d1_n_svc + 1;
	return D1StoreMenuN();
}

I64 D1StoreRowText(I64 i, U8 *dst)
{//fills dst with the row label; returns the row price, 0 when it has none
	I64 e;

	dst[0] = 0;
	if (d1_store_mode == D1SM_BUY)
	{
		if (i >= d1_n_stock)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		if (d1_store_type == D1SR_BOY && !d1_store_peek)
		{
			D1StrCopy(dst, "Pay 50 gold for a look", D1_AFFNAME + 40);
			return D1_STPEEK;
		}
		D1AffixName(dst, d1_stock[i].itm, d1_stock[i].pfx, d1_stock[i].sfx);
		if (d1_stock[i].spl && d1_spl_name)
		{//"Short Staff of Charged Bolt", GetStaffSpell naming
			e = 0;
			while (dst[e])
				e++;
			D1StrCopy(dst + e, " of ", D1_AFFNAME + 40 - e);
			e += 4;
			D1StrCopy(dst + e, (*d1_spl_name)(d1_stock[i].spl - 1),
				D1_AFFNAME + 40 - e);
		}
		return d1_stock[i].price;
	}
	if (d1_store_mode == D1SM_SELL)
	{
		if (i >= d1_n_sell)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		e = d1_sell_e[i];
		D1PowNameInv(dst, e);
		return D1PowValueInv(e) / 4;
	}
	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
	{
		if (i >= d1_n_svc)
		{
			D1StrCopy(dst, "Back", D1_AFFNAME + 40);
			return 0;
		}
		D1StoreSvcName(i, dst);
		return D1StoreSvcPrice(i);
	}
	D1StrCopy(dst, D1StoreMenuLabel(i), D1_AFFNAME + 40);
	return 0;
}

//--- transactions ----------------------------------------------------------

U0 D1StoreRemoveStock(I64 idx)
{
	I64 i;

	if (idx < 0 || idx >= d1_n_stock)
		return;
	for (i = idx; i < d1_n_stock - 1; i++)
	{
		d1_stock[i].itm    = d1_stock[i + 1].itm;
		d1_stock[i].val    = d1_stock[i + 1].val;
		d1_stock[i].pfx    = d1_stock[i + 1].pfx;
		d1_stock[i].sfx    = d1_stock[i + 1].sfx;
		d1_stock[i].spl    = d1_stock[i + 1].spl;
		d1_stock[i].chg    = d1_stock[i + 1].chg;
		d1_stock[i].maxchg = d1_stock[i + 1].maxchg;
		d1_stock[i].price  = d1_stock[i + 1].price;
	}
	d1_n_stock--;
}

Bool D1StoreBuy(I64 idx)
{
	CD1Stock *s;
	I64	 itm;
	I64	 slot;
	Bool ok;

	if (idx < 0 || idx >= d1_n_stock)
		return FALSE;
	s   = &d1_stock[idx];
	itm = s->itm;

	if (d1_plr_gold < s->price)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}

	ok = FALSE;
	if (d1_itmdefs[itm].misc)
	{//potions go to the belt when one is free, as pickup does
		slot = -1;
		for (slot = 0; slot < 8; slot++)
		{
			if (!ok && !d1_belt[slot])
			{
				d1_belt[slot] = itm;
				ok = TRUE;
			}
		}
	}
	if (!ok)
	{
		ok = D1AffInvPut(itm, s->val, s->pfx, s->sfx);
		if (ok && d1_inv_last >= 0)
		{
			d1_st_inv[d1_inv_last].ident = TRUE;	//shop stock is on display
			d1_st_inv[d1_inv_last].spl    = s->spl;
			d1_st_inv[d1_inv_last].chg    = s->chg;
			d1_st_inv[d1_inv_last].maxchg = s->maxchg;
		}
	}
	if (!ok)
	{
		D1StoreMsg("You do not have enough room.");
		return FALSE;
	}

	d1_plr_gold -= s->price;
	D1StoreRemoveStock(idx);
	D1StoreMsg("Thank you for your business.");
	D1ItmSndPlay(itm);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

Bool D1StoreSell(I64 idx)
{
	I64 e;
	I64 itm;
	I64 price;

	if (idx < 0 || idx >= d1_n_sell)
		return FALSE;
	e = d1_sell_e[idx];
	itm = d1_inv_itm[e];
	if (itm < 0)
		return FALSE;

	price = D1PowValueInv(e) / 4;
	if (price < 1)
		price = 1;

	d1_plr_gold += price;
	D1AffSetInv(e, 0, 0);
	D1InvRemove(e);
	D1StoreBuildSell();
	D1StoreMsg("Pleasure doing business.");
	D1ItmSndPlay(itm);
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

//--- open / close ----------------------------------------------------------

U0 D1StoreClose()
{
	D1VoxStop;
	D1TownerDlgClose;
	d1_store_open = FALSE;
	d1_store_type = D1SR_NONE;
	d1_store_twn  = -1;
	d1_store_mode = D1SM_MENU;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	d1_n_stock    = 0;
	d1_n_sell     = 0;
	d1_n_svc      = 0;
}

U0 D1StoreToggle()
{//D1UI registry shape. a store only opens through D1StoreEnter, so the
 //toggle is close-only.
	if (d1_store_open)
		D1StoreClose;
}

I64 D1StoreTypeFor(I64 ti)
{
	U8 *n;

	if (ti < 0 || ti >= d1_ntwn)
		return D1SR_NONE;
	n = d1_twn[ti].name;
	if (!StrCompare(n, "Griswold"))
		return D1SR_SMITH;
	if (!StrCompare(n, "Adria"))
		return D1SR_WITCH;
	if (!StrCompare(n, "Wirt"))
		return D1SR_BOY;
	if (!StrCompare(n, "Pepin"))
		return D1SR_HEALER;
	if (!StrCompare(n, "Cain"))
		return D1SR_STORY;
	return D1SR_TALK;
}

U0 D1StoreEnterTalk()
{//hand the panel to the D1Towner dialog box
	D1TownerTalk(d1_store_twn);
	if (!d1_dlg_open)
		return;
	d1_store_mode = D1SM_TALK;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	D1StoreTalkVoice;
}

I64 D1StoreEnter(I64 ti)
{//0 only when the tile holds no towner at all
	I64 type = D1StoreTypeFor(ti);
	I64 lvl;

	if (ti < 0 || ti >= d1_ntwn || type == D1SR_NONE)
		return 0;

	D1AffixInit;
	d1_store_type  = type;
	d1_store_twn   = ti;
	d1_store_mode  = D1SM_MENU;
	d1_store_sel   = 0;
	d1_store_top   = 0;
	d1_store_peek  = FALSE;
	d1_n_stock     = 0;
	d1_n_sell      = 0;
	d1_n_svc       = 0;
	d1_store_open  = TRUE;
	D1StrCopy(d1_store_title, d1_twn[ti].name, 32);
	D1StoreMsg(D1TownerQuote(ti));

	if (type == D1SR_TALK)
	{//no stock, no menu: straight into the conversation
		D1StoreEnterTalk;
		if (!d1_dlg_open)
			D1StoreClose;
		return 1;
	}

	lvl = D1StoreLvl();
	if (type == D1SR_SMITH)
		D1StoreGenSmith(lvl);
	else if (type == D1SR_WITCH)
		D1StoreGenWitch(lvl);
	else if (type == D1SR_BOY)
		D1StoreGenBoy(lvl);
	else if (type == D1SR_HEALER)
	{//Pepin heals in full, free
		d1_plr_hp = d1_plr_maxhp;
		D1StoreMsg("Your wounds are healed.");
	}
	D1StoreBuildSell();
	return 1;
}

//--- activation ------------------------------------------------------------

U0 D1StoreEnterBuy()
{
	d1_store_mode = D1SM_BUY;
	d1_store_sel  = 0;
	d1_store_top  = 0;
}

U0 D1StoreEnterSell()
{
	D1StoreBuildSell();
	d1_store_mode = D1SM_SELL;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	if (d1_n_sell == 0)
		D1StoreMsg("You have nothing I want.");
}

U0 D1StoreBackToMenu()
{
	D1VoxStop;
	D1TownerDlgClose;
	d1_store_mode = D1SM_MENU;
	d1_store_sel  = 0;
	d1_store_top  = 0;
}

U0 D1StoreEnterRepair()
{
	D1StoreBuildRepair();
	d1_store_mode = D1SM_REPAIR;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	if (d1_n_svc == 0)
		D1StoreMsg("Your equipment is in fine repair.");
	else
		D1StoreMsg("Repair which item?");
}

U0 D1StoreEnterIdent()
{
	D1StoreBuildIdent();
	d1_store_mode = D1SM_IDENT;
	d1_store_sel  = 0;
	d1_store_top  = 0;
	if (d1_n_svc == 0)
		D1StoreMsg("You have nothing to identify.");
	else
		D1StoreMsg("Identify which item?");
}

Bool D1StoreRepair(I64 i)
{//stores.cpp SmithRepairItem: pay, then restore durability to the maximum
	I64 price = D1StoreSvcPrice(i);
	I64 idx;

	if (i < 0 || i >= d1_n_svc || price <= 0)
		return FALSE;
	if (d1_plr_gold < price)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}
	idx = d1_svc_idx[i];
	d1_plr_gold -= price;
	if (idx < 0)
		D1DurRepairEquip(-idx - 1);
	else
		D1DurRepairInv(idx);
	D1StoreBuildRepair();
	D1StoreMsg("Good as new.");
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

Bool D1StoreIdentify(I64 i)
{//stores.cpp StoryIdItem: the flat D1_IDPRICE, then the item reads true
	I64 idx;

	if (i < 0 || i >= d1_n_svc)
		return FALSE;
	if (d1_plr_gold < D1_IDPRICE)
	{
		D1StoreMsg("You do not have enough gold.");
		return FALSE;
	}
	idx = d1_svc_idx[i];
	d1_plr_gold -= D1_IDPRICE;
	if (idx < 0)
		D1IdEquip(-idx - 1);
	else
		D1IdInv(idx);
	if (idx < 0)
		D1PowNameEquip(d1_store_row, -idx - 1);
	else
		D1PowNameInv(d1_store_row, idx);
	D1StrCopy(d1_store_msg, d1_store_row, 64);
	D1StoreBuildIdent();
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\Gold.wav");
	return TRUE;
}

U0 D1StoreMenuActivate(I64 i)
{
	if (d1_store_type == D1SR_SMITH)
	{
		if (i == 0)
			D1StoreEnterBuy;
		else if (i == 1)
			D1StoreEnterSell;
		else if (i == 2)
			D1StoreEnterRepair;
		else if (i == 3)
			D1StoreEnterTalk;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_WITCH)
	{
		if (i == 0)
			D1StoreEnterBuy;
		else if (i == 1)
			D1StoreEnterSell;
		else if (i == 2)
			D1StoreEnterTalk;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_BOY)
	{
		if (i == 0)
			D1StoreEnterBuy;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_HEALER)
	{
		if (i == 0)
		{
			d1_plr_hp = d1_plr_maxhp;
			D1StoreMsg("Your wounds are healed.");
		}
		else if (i == 1)
			D1StoreEnterTalk;
		else
			D1StoreClose;
		return;
	}
	if (d1_store_type == D1SR_STORY)
	{
		if (i == 0)
			D1StoreEnterIdent;
		else if (i == 1)
			D1StoreEnterTalk;
		else
			D1StoreClose;
	}
}

U0 D1StoreAdvanceTalk()
{//skipping the scroll; the conversation ending returns to the menu, or
 //shuts the panel for a towner that keeps no store. a new topic is a new
 //alltext row, so it speaks.
	I64 was = d1_dlg_ti;

	if (D1TownerDlgAdvance())
	{
		if (d1_dlg_ti != was)
			D1StoreTalkVoice;
		return;
	}
	if (d1_store_type == D1SR_TALK)
		D1StoreClose;
	else
		D1StoreBackToMenu;
}

U0 D1StoreDlgSync()
{//D1TownerDlgTick hook: the scroll ran a topic out on its own. a new topic
 //speaks; a spent conversation leaves the panel the way the click path does.
	if (!d1_store_open || d1_store_mode != D1SM_TALK)
		return;
	if (d1_dlg_open)
	{
		D1StoreTalkVoice;
		return;
	}
	if (d1_store_type == D1SR_TALK)
		D1StoreClose;
	else
		D1StoreBackToMenu;
}

U0 D1StoreDlgInstall()
{//the tick hook lives in D1Towner, compiled earlier
	d1_dlg_topic_cb = &D1StoreDlgSync;
}

D1StoreDlgInstall;

U0 D1StoreActivate(I64 i)
{
	if (!d1_store_open)
		return;
	if (d1_store_mode == D1SM_TALK)
	{
		D1StoreAdvanceTalk;
		return;
	}
	if (i < 0 || i >= D1StoreRowN())
		return;

	if (d1_store_mode == D1SM_REPAIR || d1_store_mode == D1SM_IDENT)
	{
		if (i >= d1_n_svc)
		{
			D1StoreBackToMenu;
			return;
		}
		if (d1_store_mode == D1SM_REPAIR)
			D1StoreRepair(i);
		else
			D1StoreIdentify(i);
		return;
	}

	if (d1_store_mode == D1SM_BUY)
	{
		if (i >= d1_n_stock)
		{
			D1StoreBackToMenu;
			return;
		}
		if (d1_store_type == D1SR_BOY && !d1_store_peek)
		{//Wirt shows nothing until the look fee is paid
			if (d1_plr_gold < D1_STPEEK)
			{
				D1StoreMsg("You do not have enough gold.");
				return;
			}
			d1_plr_gold -= D1_STPEEK;
			d1_store_peek = TRUE;
			D1StoreMsg("Take a look at this.");
			return;
		}
		D1StoreBuy(i);
		return;
	}
	if (d1_store_mode == D1SM_SELL)
	{
		if (i >= d1_n_sell)
		{
			D1StoreBackToMenu;
			return;
		}
		D1StoreSell(i);
		return;
	}
	D1StoreMenuActivate(i);
}

//--- input -----------------------------------------------------------------

U0 D1StoreScrollFix()
{
	I64 n = D1StoreRowN();

	if (d1_store_sel < 0)
		d1_store_sel = 0;
	if (d1_store_sel >= n)
		d1_store_sel = n - 1;
	if (d1_store_sel < d1_store_top)
		d1_store_top = d1_store_sel;
	if (d1_store_sel >= d1_store_top + D1_STVIS)
		d1_store_top = d1_store_sel - D1_STVIS + 1;
	if (d1_store_top < 0)
		d1_store_top = 0;
}

U0 D1StoreKey(I64 k)
{//hardware free; D1StoreKeys does the edge detection
	I64 n;

	if (!d1_store_open)
		return;

	if (d1_store_mode == D1SM_TALK)
	{//the dialog box takes SPACE and ENTER to page, ESC to leave
		if (k == D1SK_SPACE || k == D1SK_ENTER)
			D1StoreAdvanceTalk;
		else if (k == D1SK_ESC)
		{
			if (d1_store_type == D1SR_TALK)
				D1StoreClose;
			else
				D1StoreBackToMenu;
		}
		return;
	}

	n = D1StoreRowN();
	if (n < 1)
		return;

	if (k == D1SK_UP)
	{
		d1_store_sel--;
		if (d1_store_sel < 0)
			d1_store_sel = n - 1;
	}
	else if (k == D1SK_DOWN)
	{
		d1_store_sel++;
		if (d1_store_sel >= n)
			d1_store_sel = 0;
	}
	else if (k == D1SK_ENTER)
		D1StoreActivate(d1_store_sel);
	else if (k == D1SK_ESC)
	{
		if (d1_store_mode == D1SM_MENU)
			D1StoreClose;
		else
			D1StoreBackToMenu;
	}
	D1StoreScrollFix;
}

Bool d1_sk_up    = FALSE;
Bool d1_sk_down  = FALSE;
Bool d1_sk_enter = FALSE;
Bool d1_sk_esc   = FALSE;
Bool d1_sk_space = FALSE;

Bool D1StoreEdge(I64 sc, Bool *held)
{
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

U0 D1StoreKeys()
{//arrows move, ENTER activates, ESC backs out
	if (!d1_store_open)
		return;
	if (D1StoreEdge(SC_CURSOR_UP, &d1_sk_up))
		D1StoreKey(D1SK_UP);
	if (D1StoreEdge(SC_CURSOR_DOWN, &d1_sk_down))
		D1StoreKey(D1SK_DOWN);
	if (D1StoreEdge(SC_ENTER, &d1_sk_enter))
		D1StoreKey(D1SK_ENTER);
	if (D1StoreEdge(SC_ESC, &d1_sk_esc))
		D1StoreKey(D1SK_ESC);
	if (D1StoreEdge(Char2ScanCode(' '), &d1_sk_space))
		D1StoreKey(D1SK_SPACE);
}

I64 D1StoreRowAt(I64 cy)
{//row index under a band-local y (caller subtracts D1UiOrgY), or -1
	I64 i;
	I64 by;
	I64 n = D1StoreRowN();

	for (i = 0; i < D1_STVIS; i++)
	{
		by = D1_STROW0 + i * D1_STROW;
		if (cy >= by - 13 && cy < by + 4 && d1_store_top + i < n)
			return d1_store_top + i;
	}
	return -1;
}

Bool D1StoreClick(I64 cx, I64 cy)
{//canvas coords. TRUE = consumed; any click inside the panel is.
	I64 row;

	if (!d1_store_open)
		return FALSE;
	if (d1_store_mode == D1SM_TALK)
	{//any click pages the dialog
		D1StoreAdvanceTalk;
		return TRUE;
	}
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx < D1_STX || cx >= D1_STX + D1_STW ||
		cy < D1_STY || cy >= D1_STY + D1_STH)
		return TRUE;			//clicks outside the panel never reach the world

	row = D1StoreRowAt(cy);
	if (row >= 0)
	{
		d1_store_sel = row;
		D1StoreActivate(row);
		D1StoreScrollFix;
	}
	return TRUE;
}

//--- draw ------------------------------------------------------------------

U8	*d1_pentspn2   = NULL;		//Data\PentSpn2.CEL: 8 12x12 pentagram frames
I64	 d1_store_anim = 0;

U0 D1StoreFrame(I64 col)
{//stores.cpp draws the panel through trans_rect, so the town shows through
	I64 ox = D1UiOrgX() + D1_STX;
	I64 ty = D1UiOrgY() + D1_STY;

	D1FillRectTrans(ox, ty, D1_STW, D1_STH);
	D1FillRect(ox, ty, D1_STW, 2, col);
	D1FillRect(ox, ty + D1_STH - 2, D1_STW, 2, col);
	D1FillRect(ox, ty, 2, D1_STH, col);
	D1FillRect(ox + D1_STW - 2, ty, 2, D1_STH, col);
	D1FillRect(ox + 8, ty + 40, D1_STW - 16, 1, col);
	D1FillRect(ox + 8, ty + D1_STH - 34, D1_STW - 16, 1, col);
}

I64 D1StoreRowColor(I64 row, I64 price)
{//STextDraw states: gold for the selection, blue when the price is out of
 //reach (stores.cpp iclr = COL_BLUE), silver-white otherwise
	if (price > 0 && price > d1_plr_gold &&
		(d1_store_mode == D1SM_BUY || d1_store_mode == D1SM_REPAIR ||
		 d1_store_mode == D1SM_IDENT))
		return D1COL_BLUE;
	if (row == d1_store_sel)
		return D1COL_GOLD;
	return D1COL_WHITE;
}

U0 D1StoreDrawRow(I64 slot, I64 row)
{
	I64 by = D1UiOrgY() + D1_STROW0 + slot * D1_STROW;
	I64 ox = D1UiOrgX() + D1_STX;
	I64 price;
	I64 tc;
	I64 f;

	price = D1StoreRowText(row, d1_store_row);
	tc    = D1StoreRowColor(row, price);
	if (row == d1_store_sel && d1_pentspn2)
	{//PentSpn2 pentagrams flank the selected row (DrawSText's _ssel draw)
		f = (d1_store_anim / 2) % 8 + 1;
		D1CelDraw(ox + 2, by + 2, d1_pentspn2, f, 12);
		D1CelDraw(ox + D1_STW - 14, by + 2, d1_pentspn2, f, 12);
	}
	D1TextDrawCol(ox + 16, by, d1_store_row, tc);
	if (price > 0)
	{
		D1StoreNum(d1_store_num, price);
		D1TextDrawCol(ox + D1_STW - 24 - D1TextWidth(d1_store_num), by,
			d1_store_num, tc);
	}
}

U0 D1StoreDraw()
{
	I64 col;
	I64 n;
	I64 i;
	I64 row;
	I64 size = 0;
	I64 ox = D1UiOrgX() + D1_STX;

	if (!d1_store_open)
		return;
	if (d1_store_mode == D1SM_TALK)
	{
		D1TownerDlgDraw;
		return;
	}
	if (!d1_pentspn2)
		d1_pentspn2 = D1MpqRead("Data\\PentSpn2.CEL", &size);
	d1_store_anim++;
	col = D1PalBrightest();
	D1StoreFrame(col);

	D1TextDrawCol(D1UiOrgX() + D1_UI_W / 2 -
		D1TextWidth(d1_store_title) / 2, D1UiOrgY() + D1_STY + 28,
		d1_store_title, D1COL_GOLD);

	D1StrCopy(d1_store_row, "Gold: ", D1_AFFNAME + 40);
	D1StoreNum(d1_store_num, d1_plr_gold);
	D1AffixCat(d1_store_row, 6, d1_store_num, D1_AFFNAME + 40);
	D1TextDrawCol(ox + 16, D1UiOrgY() + D1_STY + 28, d1_store_row,
		D1COL_GOLD);

	n = D1StoreRowN();
	for (i = 0; i < D1_STVIS; i++)
	{
		row = d1_store_top + i;
		if (row < n)
			D1StoreDrawRow(i, row);
	}

	if (n > D1_STVIS)
	{//scroll marks when the list runs past the window
		if (d1_store_top > 0)
			D1TextDrawCol(ox + D1_STW - 30, D1UiOrgY() + D1_STROW0,
				"^", D1COL_WHITE);
		if (d1_store_top + D1_STVIS < n)
			D1TextDrawCol(ox + D1_STW - 30,
				D1UiOrgY() + D1_STROW0 + (D1_STVIS - 1) * D1_STROW,
				"v", D1COL_WHITE);
	}

	D1TextDrawCol(D1UiOrgX() + D1_UI_W / 2 - D1TextWidth(d1_store_msg) / 2,
		D1UiOrgY() + D1_STY + D1_STH - 12, d1_store_msg, D1COL_GOLD);
}
