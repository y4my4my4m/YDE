		}
	}
	for (j = 0; j < D1_DMAX; j++) {
		for (i = 0; i < D1_DMAX; i++) {
			if (D1DunGet(i, j) == 15 && D1DunGet(i + 1, j) == 28 && D1DunGet(i + 2, j) == 16)
				D1DunSet(i + 1, j, 23);
			if (D1DunGet(i, j) == 21 && D1DunGet(i + 1, j - 1) == 21 && D1DunGet(i + 1, j + 1) == 13 && D1DunGet(i + 2, j) == 2)
				D1DunSet(i + 1, j, 17);
			if (D1DunGet(i, j) == 19 && D1DunGet(i + 1, j) == 15 && D1DunGet(i + 1, j + 1) == 12)
				D1DunSet(i + 1, j, 17);
		}
	}
}

U0 D4Corners()
{
	I64 i;
	I64 j;

	for (j = 1; j < D1_DMAX - 1; j++) {
		for (i = 1; i < D1_DMAX - 1; i++) {
			if (D1DunGet(i, j) >= 18 && D1DunGet(i, j) <= 30) {
				if (D1DunGet(i + 1, j) < 18) {
					D1DunSet(i, j, D1DunGet(i, j) + 98);
				} else if (D1DunGet(i, j + 1) < 18) {
					D1DunSet(i, j, D1DunGet(i, j) + 98);
				}
			}
		}
	}
}

U0 D4GeneralFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX - 1; j++) {
		for (i = 0; i < D1_DMAX - 1; i++) {
			if ((D1DunGet(i, j) == 24 || D1DunGet(i, j) == 122) && D1DunGet(i + 1, j) == 2 && D1DunGet(i, j + 1) == 5) {
				D1DunSet(i, j, 17);
			}
		}
	}
}


U0 D4Shadows()
{
	I64	 x;
	I64	 y;
	Bool okflag;

	for (y = 1; y < D1_DMAX; y++)
		for (x = 1; x < D1_DMAX; x++)
		{
			okflag = FALSE;
			if (D1DunGet(x, y) == 3)
				okflag = TRUE;
			if (D1DunGet(x, y) == 4)
				okflag = TRUE;
			if (D1DunGet(x, y) == 8)
				okflag = TRUE;
			if (D1DunGet(x, y) == 15)
				okflag = TRUE;
			if (okflag)
			{
				if (D1DunGet(x - 1, y) == 6)
					D1DunSet(x - 1, y, 47);
				if (D1DunGet(x - 1, y - 1) == 6)
					D1DunSet(x - 1, y - 1, 48);
			}
		}
}

U0 D4Subs()
{
	I64 x;
	I64 y;
	I64 i;
	I64 rv;
	I64 c;

	for (y = 0; y < D1_DMAX; y++)
		for (x = 0; x < D1_DMAX; x++)
		{
			rv = D1Rnd(3);
			if (rv == 0)
			{
				c = d4t_l4btypes[D1DunGet(x, y)];
				if (c != 0 && D1DunFlag(x, y) == 0)
				{
					rv = D1Rnd(16);
					i  = -1;
					while (rv >= 0)
					{
						i++;
						if (i == 140)
							i = 0;
						if (c == d4t_l4btypes[i])
							rv--;
					}
					D1DunSet(x, y, i);
				}
			}
		}
	for (y = 0; y < D1_DMAX; y++)
		for (x = 0; x < D1_DMAX; x++)
		{
			rv = D1Rnd(10);
			if (rv == 0)
			{
				c = D1DunGet(x, y);
				if (d4t_l4btypes[c] == 6 && D1DunFlag(x, y) == 0)
					D1DunSet(x, y, D1Rnd(3) + 95);
			}
		}
}

I64 d4_last_sx = 0;
I64 d4_last_sy = 0;

Bool D4PlaceMiniSet(U8 *miniset, I64 tmin, I64 tmax, I64 cx, I64 cy,
	Bool setview)
{//TRUE = placed OK (L2-style bail counter)
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 i;
	I64	 ii;
	I64	 numt;
	I64	 bailcnt;
	Bool found;

	if (tmax - tmin == 0)
		numt = 1;
	else
		numt = D1Rnd(tmax - tmin) + tmin;

	sx = 0;
	sy = 0;
	for (i = 0; i < numt; i++)
	{
		sx    = D1Rnd(D1_DMAX - sw);
		sy    = D1Rnd(D1_DMAX - sh);
		found = FALSE;
		for (bailcnt = 0; !found && bailcnt < 200; bailcnt++)
		{
			found = TRUE;
			if (cx != -1 && sx >= cx - sw && sx <= cx + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			if (cy != -1 && sy >= cy - sh && sy <= cy + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			ii = 2;
			for (yy = 0; yy < sh && found; yy++)
				for (xx = 0; xx < sw && found; xx++)
				{
					if (miniset[ii] != 0 &&
						D1DunGet(xx + sx, yy + sy) != miniset[ii])
						found = FALSE;
					if (D1DunFlag(xx + sx, yy + sy) != 0)
						found = FALSE;
					ii++;
				}
			if (!found)
			{
				sx++;
				if (sx == D1_DMAX - sw)
				{
					sx = 0;
					sy++;
					if (sy == D1_DMAX - sh)
						sy = 0;
				}
			}
		}
		if (bailcnt >= 200)
			return FALSE;
		ii = sw * sh + 2;
		for (yy = 0; yy < sh; yy++)
			for (xx = 0; xx < sw; xx++)
			{
				if (miniset[ii] != 0)
				{
					D1DunSet(xx + sx, yy + sy, miniset[ii]);
					d1_dunflag[(xx + sx) * D1_DMAX + yy + sy] |= 8;
				}
				ii++;
			}
	}

	d4_last_sx = sx;
	d4_last_sy = sy;
	if (setview)
	{
		d1_lvl_vx = 2 * sx + 21;
		d1_lvl_vy = 2 * sy + 22;
	}

	return TRUE;
}

U0 D4SetRoomBuf(U8 *buf, I64 rx1, I64 ry1)
{//DRLG_L4SetRoom: stamp one quadrant DUN, 0 tiles become hell floor 6
	I64 rw;
	I64 rh;
	I64 i;
	I64 j;
	I64 sp;
	I64 t;

	if (!buf)
		return;

	rw = D1RdU16(buf);
	rh = D1RdU16(buf + 2);
	sp = 4;

	for (j = 0; j < rh; j++)
		for (i = 0; i < rw; i++)
		{
			t = D1RdU16(buf + sp);
			if (t)
			{
				D1DunSet(i + rx1, j + ry1, t);
				if (i + rx1 >= 0 && i + rx1 < D1_DMAX &&
					j + ry1 >= 0 && j + ry1 < D1_DMAX)
					d1_dunflag[(i + rx1) * D1_DMAX + j + ry1] |= DLRG_PROTECTED;
			}
			else
				D1DunSet(i + rx1, j + ry1, 6);
			sp += 2;
		}
}

U0 D4SaveQuads()
{//L4SaveQuads: lock the four mirrored 14x14 blocks against decoration
	I64 i;
	I64 j;
	I64 x = d4_holdx;
	I64 y = d4_holdy;

	for (j = 0; j < 14; j++)
		for (i = 0; i < 14; i++)
		{
			d1_dunflag[(i + x) * D1_DMAX + j + y] = 1;
			d1_dunflag[(D1_DMAX - 1 - i - x) * D1_DMAX + j + y] = 1;
			d1_dunflag[(i + x) * D1_DMAX + D1_DMAX - 1 - j - y] = 1;
			d1_dunflag[(D1_DMAX - 1 - i - x) * D1_DMAX +
				D1_DMAX - 1 - j - y] = 1;
		}
}

//diab1 quadrant origin and the centre of the diab4 quadrant, which holds
//the pentagram Diablo stands on. dungeon coords.
I64 d4_quad1_x   = 0;
I64 d4_quad1_y   = 0;
I64 d4_chamber_x = 0;
I64 d4_chamber_y = 0;

U0 D4LoadDiabQuads(Bool preflag)
{//DRLG_LoadDiabQuads: four quadrant DUNs around the chamber on level 16.
 //preflag picks the 'b' variants, otherwise the 'a' variants. diab1 has
 //no variants.
	U8	*buf;
	I64	 size = 0;
	I64	 q1x  = 4 + d4_holdx;
	I64	 q1y  = 4 + d4_holdy;

	buf = D1MpqRead("Levels\\L4Data\\diab1.DUN", &size);
	D4SetRoomBuf(buf, q1x, q1y);
	if (buf)
		Free(buf);
	d4_quad1_x = q1x;
	d4_quad1_y = q1y;
	//diab4 is 9x9; its centre is the pentagram
	d4_chamber_x = 28 - d4_holdx + 4;
	d4_chamber_y = 28 - d4_holdy + 4;

	if (preflag)
		buf = D1MpqRead("Levels\\L4Data\\diab2b.DUN", &size);
	else
		buf = D1MpqRead("Levels\\L4Data\\diab2a.DUN", &size);
	D4SetRoomBuf(buf, 27 - d4_holdx, 1 + d4_holdy);
	if (buf)
		Free(buf);

	if (preflag)
		buf = D1MpqRead("Levels\\L4Data\\diab3b.DUN", &size);
	else
		buf = D1MpqRead("Levels\\L4Data\\diab3a.DUN", &size);
	D4SetRoomBuf(buf, 1 + d4_holdx, 27 - d4_holdy);
	if (buf)
		Free(buf);

	if (preflag)
		buf = D1MpqRead("Levels\\L4Data\\diab4b.DUN", &size);
	else
		buf = D1MpqRead("Levels\\L4Data\\diab4a.DUN", &size);
	D4SetRoomBuf(buf, 28 - d4_holdx, 28 - d4_holdy);
	if (buf)
		Free(buf);
}

//stair miniset anchors, in dungeon coords
I64 d4_up_sx = 0;
I64 d4_up_sy = 0;
I64 d4_dn_sx = -1;
I64 d4_dn_sy = -1;

U0 D4DrlgL4(I64 level, I64 entry)
{
	I64	 ar;
	I64	 spi;
	I64	 spj;
	Bool doneflag;

	D1SetPcLoadLevel(level);

	do
	{
		do
		{
			D4InitDungeon;
			D4FirstRoom(level);
			D4FixRim;
			ar = D4GetArea();
			if (ar >= 173)
				D4UShape;
		}
		while (ar < 173);
		D4MakeDungeon;
		D4MakeDmt;
		D4TileFix;
		if (level == 16)
			D4SaveQuads;
		if (level == 13)
		{
			for (spi = d4_sp4x1; spi < d4_sp4x2; spi++)
				for (spj = d4_sp4y1; spj < d4_sp4y2; spj++)
					d1_dunflag[spi * D1_DMAX + spj] = 1;
		}
		D4AddWall;
		D1SetPcRoom(d4_sp4x1, d4_sp4y1, 6);
		if (level == 16)
			D4LoadDiabQuads(TRUE);

		if (level != 15)
		{
			if (entry == 0)
			{
				doneflag = D4PlaceMiniSet(d4t_l4ustairs, 1, 1, -1, -1, TRUE);
				d4_up_sx = d4_last_sx;
				d4_up_sy = d4_last_sy;
				d4_dn_sx = -1;
				if (doneflag && level != 16)
				{
					doneflag = D4PlaceMiniSet(d4t_l4dstairs, 1, 1, -1, -1, FALSE);
					d4_dn_sx = d4_last_sx;
					d4_dn_sy = d4_last_sy;
				}
				d1_lvl_vx++;
			}
			else
			{
				doneflag = D4PlaceMiniSet(d4t_l4ustairs, 1, 1, -1, -1, FALSE);
				d4_up_sx = d4_last_sx;
				d4_up_sy = d4_last_sy;
				d4_dn_sx = -1;
				if (doneflag && level != 16)
				{
					doneflag = D4PlaceMiniSet(d4t_l4dstairs, 1, 1, -1, -1, TRUE);
					d4_dn_sx = d4_last_sx;
					d4_dn_sy = d4_last_sy;
				}
				d1_lvl_vy++;
			}
		}
		else
		{
			if (entry == 0)
			{
				doneflag = D4PlaceMiniSet(d4t_l4ustairs, 1, 1, -1, -1, TRUE);
				d4_up_sx = d4_last_sx;
				d4_up_sy = d4_last_sy;
				if (doneflag)
				{
					doneflag = D4PlaceMiniSet(d4t_l4penta, 1, 1, -1, -1, FALSE);
					d4_dn_sx = d4_last_sx;
					d4_dn_sy = d4_last_sy;
				}
				d1_lvl_vx++;
			}
			else
			{
				doneflag = D4PlaceMiniSet(d4t_l4ustairs, 1, 1, -1, -1, FALSE);
				d4_up_sx = d4_last_sx;
				d4_up_sy = d4_last_sy;
				if (doneflag)
				{
					doneflag = D4PlaceMiniSet(d4t_l4penta, 1, 1, -1, -1, TRUE);
					d4_dn_sx = d4_last_sx;
					d4_dn_sy = d4_last_sy;
				}
				d1_lvl_vy++;
			}
		}
	}
	while (!doneflag);

	D4GeneralFix;
	D4Shadows;
	D4Corners;
	D4Subs;
	if (level == 16)
		D4LoadDiabQuads(FALSE);
	D1SetPcFree;
}

U0 D4Pass3()
{//base tile 30
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 lv;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	lv = 30 - 1;
	v1 = D1RdU16(d1_til + lv * 8)     + 1;
	v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
	v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
	v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;

	for (j = 0; j < D1_MAXDUN; j += 2)
		for (i = 0; i < D1_MAXDUN; i += 2)
		{
			d1_dpiece[i     +  j      * D1_MAXDUN] = v1;
			d1_dpiece[i + 1 +  j      * D1_MAXDUN] = v2;
			d1_dpiece[i     + (j + 1) * D1_MAXDUN] = v3;
			d1_dpiece[i + 1 + (j + 1) * D1_MAXDUN] = v4;
		}

	yy = 16;
	for (j = 0; j < D1_DMAX; j++)
	{
		xx = 16;
		for (i = 0; i < D1_DMAX; i++)
		{
			lv = D1DunGet(i, j) - 1;
			if (lv >= 0)
			{
				v1 = D1RdU16(d1_til + lv * 8)     + 1;
				v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
				v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
				v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;
			}
			else
			{
				v1 = 0;
				v2 = 0;
				v3 = 0;
				v4 = 0;
			}
			d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
			d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
			d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
			d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			xx += 2;
		}
		yy += 2;
	}
}

Bool D1L4LevelLoad(I64 level, I64 seed, I64 entry)
{//hell level 13-16
	U8 pal[32];

	if (!D1LvlLoadGfx("Levels\\L4Data\\L4.CEL",
					  "Levels\\L4Data\\L4.MIN",
					  "Levels\\L4Data\\L4.SOL",
					  "Levels\\L4Data\\L4.TIL", 16))
		return FALSE;

	D1SetRndSeed(seed);
	D4DrlgL4(level, entry);
	D4Pass3;
	//hell piece ids repeat across the tileset, so triggers anchor to the
	//placed miniset rects instead of a whole-map piece scan
	d1_trig_up_x   = 2 * d4_up_sx + 21;
	d1_trig_up_y   = 2 * d4_up_sy + 22;
	if (d4_dn_sx >= 0)
	{
		d1_trig_down_x = 2 * d4_dn_sx + 21;
		d1_trig_down_y = 2 * d4_dn_sy + 22;
	}
	else
	{
		d1_trig_down_x = -1;
		d1_trig_down_y = -1;
	}
	D1GridsClear;
	//hell reuses the catacombs special sheet
	if (!D1SpecialLoad("Levels\\L2Data\\L2S.CEL"))
		return FALSE;

	StrPrint(pal, "Levels\\L4Data\\L4_%d.pal", D1Rnd(3) + 1);
	if (!D1PalLoad(pal))
		return FALSE;

	d1_currlevel = level;
	d1_lvl_ready = TRUE;
	return TRUE;
}
