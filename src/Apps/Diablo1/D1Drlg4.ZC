// D1Drlg4.ZC - hell level generation (drlg_l4.cpp, retail path)
//
// one 20x20 quadrant is grown (rooms like L1), rim-fixed, then mirrored
// four ways into 80x80, collapsed through L4ConvTbl, wall-decorated and
// substituted. theme rooms are absent; level 16 places only the entry
// stairs, 15 places the pentagram as its way down.
//
// level 13 forces an 11x11 first room and stamps Warlord.DUN in it.
// level 16 stamps the four Diablo quadrant DUNs around the chamber. as
// DRLG_LoadDiabQuads does, the 'b' variants go down before the stairs pass
// and the 'a' variants overwrite them after decoration; upstream keeps 'b'
// in pdungeon as the opened room, the port has no pdungeon so only 'a',
// the sealed room, survives.
//
// deviation: DRLG_L4's Q_WARLORD branch omits L4DSTAIRS, so retail level 13
// has no down stairs of its own. the port keeps them; 13 -> 14 must work.
//
// D4TileFix / D4Corners / D4GeneralFix are machine-translated from the
// original's if-chains; the rest is hand transcription.

#include "D1Drlg4T"

U8	 d4_dung[20 * 20];			//[i * 20 + j]
U8	 d4_l4dun[80 * 80];			//[i * 80 + j]
Bool d4_hallok[20];

U8 D4DungGet(I64 i, I64 j)
{
	if (i < 0 || i >= 20 || j < 0 || j >= 20)
		return 0;
	return d4_dung[i * 20 + j];
}

U0 D4DungSet(I64 i, I64 j, I64 v)
{
	if (i >= 0 && i < 20 && j >= 0 && j < 20)
		d4_dung[i * 20 + j] = v;
}

U0 D4InitDungeon()
{
	I64 i;

	for (i = 0; i < 400; i++)
		d4_dung[i] = 0;
	for (i = 0; i < 6400; i++)
		d4_l4dun[i] = 0;
	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
	{
		d1_dun[i]     = 30;
		d1_dunflag[i] = 0;
	}
}

U0 D4FixRim()
{
	I64 i;

	for (i = 0; i < 20; i++)
	{
		d4_dung[i * 20] = 0;
		d4_dung[i]      = 0;
	}
}

U0 D4DrawRoom(I64 x, I64 y, I64 width, I64 height)
{
	I64 i;
	I64 j;

	for (j = 0; j < height; j++)
		for (i = 0; i < width; i++)
			D4DungSet(i + x, j + y, 1);
}

Bool D4CheckRoom(I64 x, I64 y, I64 width, I64 height)
{
	I64 i;
	I64 j;

	if (x <= 0 || y <= 0)
		return FALSE;

	for (j = 0; j < height; j++)
		for (i = 0; i < width; i++)
		{
			if (i + x < 0 || i + x >= 20 || j + y < 0 || j + y >= 20)
				return FALSE;
			if (d4_dung[(i + x) * 20 + j + y] != 0)
				return FALSE;
		}

	return TRUE;
}

U0 D4RoomGen(I64 x, I64 y, I64 w, I64 h, I64 dir)
{
	I64	 num;
	I64	 dirProb;
	Bool ran;
	Bool ran2;
	Bool vert;
	I64	 width;
	I64	 height;
	I64	 rx;
	I64	 ry;
	I64	 ry2;
	I64	 cw;
	I64	 ch;
	I64	 cx1;
	I64	 cy1;
	I64	 cx2;

	dirProb = D1Rnd(4);

	if (dir == 1)
		vert = ToBool(dirProb != 0);
	else
		vert = ToBool(dirProb == 0);

	if (!vert)
	{
		num = 0;
		ran = FALSE;
		do
		{
			cw  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			ch  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			cy1 = h / 2 + y - ch / 2;
			cx1 = x - cw;
			ran = D4CheckRoom(cx1 - 1, cy1 - 1, ch + 2, cw + 1);
			num++;
		}
		while (!ran && num < 20);

		if (ran)
			D4DrawRoom(cx1, cy1, cw, ch);
		cx2  = x + w;
		ran2 = D4CheckRoom(cx2, cy1 - 1, cw + 1, ch + 2);
		if (ran2)
			D4DrawRoom(cx2, cy1, cw, ch);
		if (ran)
			D4RoomGen(cx1, cy1, cw, ch, 1);
		if (ran2)
			D4RoomGen(cx2, cy1, cw, ch, 1);
	}
	else
	{
		num = 0;
		ran = FALSE;
		do
		{
			width  = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			height = (D1Rnd(5) + 2) & 0xFFFFFFFE;
			rx     = w / 2 + x - width / 2;
			ry     = y - height;
			ran    = D4CheckRoom(rx - 1, ry - 1, width + 2, height + 1);
			num++;
		}
		while (!ran && num < 20);

		if (ran)
			D4DrawRoom(rx, ry, width, height);
		ry2  = y + h;
		ran2 = D4CheckRoom(rx - 1, ry2, width + 2, height + 1);
		if (ran2)
			D4DrawRoom(rx, ry2, width, height);
		if (ran)
			D4RoomGen(rx, ry, width, height, 0);
		if (ran2)
			D4RoomGen(rx, ry2, width, height, 0);
	}
}

//first-room anchor for the level-16 quads (l4holdx/l4holdy) and the quest
//set piece rect (SP4x1..SP4y2)
I64 d4_holdx = 0;
I64 d4_holdy = 0;
I64 d4_sp4x1 = 0;
I64 d4_sp4y1 = 0;
I64 d4_sp4x2 = 0;
I64 d4_sp4y2 = 0;

U0 D4FirstRoom(I64 level)
{
	I64 x;
	I64 y;
	I64 w;
	I64 h;
	I64 rndx;
	I64 rndy;
	I64 xmin;
	I64 xmax;
	I64 ymin;
	I64 ymax;
	I64 tx;
	I64 ty;

	if (level == 16)
	{
		w = 14;
		h = 14;
	}
	else if (level == 13)
	{//Warlord of Blood: fixed 11x11 room, size roll skipped (L4firstRoom)
		w = 11;
		h = 11;
	}
	else
	{
		w = D1Rnd(5) + 2;
		h = D1Rnd(5) + 2;
	}

	xmin = (20 - w) >> 1;
	xmax = 19 - w;
	rndx = D1Rnd(xmax - xmin + 1) + xmin;
	if (rndx + w > 19)
	{
		tx = w + rndx - 19;
		x  = rndx - tx + 1;
	}
	else
		x = rndx;
	ymin = (20 - h) >> 1;
	ymax = 19 - h;
	rndy = D1Rnd(ymax - ymin + 1) + ymin;
	if (rndy + h > 19)
	{
		ty = h + rndy - 19;
		y  = rndy - ty + 1;
	}
	else
		y = rndy;

	if (level == 16)
	{
		d4_holdx = x;
		d4_holdy = y;
	}
	if (level == 13)
	{
		d4_sp4x1 = x + 1;
		d4_sp4y1 = y + 1;
		d4_sp4x2 = d4_sp4x1 + w;
		d4_sp4y2 = d4_sp4y1 + h;
	}
	else
	{
		d4_sp4x1 = 0;
		d4_sp4y1 = 0;
		d4_sp4x2 = 0;
		d4_sp4y2 = 0;
	}

	D4DrawRoom(x, y, w, h);
	D4RoomGen(x, y, w, h, D1Rnd(2));
}

I64 D4GetArea()
{
	I64 i;
	I64 rv = 0;

	for (i = 0; i < 400; i++)
		if (d4_dung[i] == 1)
			rv++;
	return rv;
}

U0 D4UShape()
{
	I64 j;
	I64 i;
	I64 rv;

	for (j = 19; j >= 0; j--)
	{
		for (i = 19; i >= 0; i--)
		{
			if (D4DungGet(i, j) != 1)
				d4_hallok[j] = FALSE;
			if (D4DungGet(i, j) == 1)
			{
				if (D4DungGet(i, j + 1) == 1 && D4DungGet(i + 1, j + 1) == 0)
					d4_hallok[j] = TRUE;
				else
					d4_hallok[j] = FALSE;
				i = 0;
			}
		}
	}

	rv = D1Rnd(19) + 1;
	do
	{
		if (d4_hallok[rv])
		{
			for (i = 19; i >= 0; i--)
			{
				if (D4DungGet(i, rv) == 1)
				{
					i  = -1;
					rv = 0;
				}
				else
				{
					D4DungSet(i, rv, 1);
					D4DungSet(i, rv + 1, 1);
				}
			}
		}
		else
		{
			rv++;
			if (rv == 20)
				rv = 1;
		}
	}
	while (rv != 0);

	for (i = 19; i >= 0; i--)
	{
		for (j = 19; j >= 0; j--)
		{
			if (D4DungGet(i, j) != 1)
				d4_hallok[i] = FALSE;
			if (D4DungGet(i, j) == 1)
			{
				if (D4DungGet(i + 1, j) == 1 && D4DungGet(i + 1, j + 1) == 0)
					d4_hallok[i] = TRUE;
				else
					d4_hallok[i] = FALSE;
				j = 0;
			}
		}
	}

	rv = D1Rnd(19) + 1;
	do
	{
		if (d4_hallok[rv])
		{
			for (j = 19; j >= 0; j--)
			{
				if (D4DungGet(rv, j) == 1)
				{
					j  = -1;
					rv = 0;
				}
				else
				{
					D4DungSet(rv, j, 1);
					D4DungSet(rv + 1, j, 1);
				}
			}
		}
		else
		{
			rv++;
			if (rv == 20)
				rv = 1;
		}
	}
	while (rv != 0);
}

U0 D4MakeDungeon()
{//quadrant mirrored four ways
	I64 i;
	I64 j;
	I64 k;
	I64 l;
	I64 v;

	for (j = 0; j < 20; j++)
		for (i = 0; i < 20; i++)
		{
			k = i * 2;
			l = j * 2;
			v = d4_dung[i * 20 + j];
			d4_l4dun[k * 80 + l]           = v;
			d4_l4dun[k * 80 + l + 1]       = v;
			d4_l4dun[(k + 1) * 80 + l]     = v;
			d4_l4dun[(k + 1) * 80 + l + 1] = v;

			v = d4_dung[i * 20 + 19 - j];
			d4_l4dun[k * 80 + l + 40]       = v;
			d4_l4dun[k * 80 + l + 41]       = v;
			d4_l4dun[(k + 1) * 80 + l + 40] = v;
			d4_l4dun[(k + 1) * 80 + l + 41] = v;

			v = d4_dung[(19 - i) * 20 + j];
			d4_l4dun[(k + 40) * 80 + l]     = v;
			d4_l4dun[(k + 40) * 80 + l + 1] = v;
			d4_l4dun[(k + 41) * 80 + l]     = v;
			d4_l4dun[(k + 41) * 80 + l + 1] = v;

			v = d4_dung[(19 - i) * 20 + 19 - j];
			d4_l4dun[(k + 40) * 80 + l + 40] = v;
			d4_l4dun[(k + 40) * 80 + l + 41] = v;
			d4_l4dun[(k + 41) * 80 + l + 40] = v;
			d4_l4dun[(k + 41) * 80 + l + 41] = v;
		}
}

U0 D4MakeDmt()
{
	I64 i;
	I64 j;
	I64 val;
	I64 dmtx;
	I64 dmty;

	dmty = 1;
	for (j = 0; dmty <= 77; j++)
	{
		dmtx = 1;
		for (i = 0; dmtx <= 77; i++)
		{
			val = 8 * d4_l4dun[(dmtx + 1) * 80 + dmty + 1]
				+ 4 * d4_l4dun[dmtx * 80 + dmty + 1]
				+ 2 * d4_l4dun[(dmtx + 1) * 80 + dmty]
				+ d4_l4dun[dmtx * 80 + dmty];
			D1DunSet(i, j, d4t_l4convtbl[val]);
			dmtx += 2;
		}
		dmty += 2;
	}
}

I64 D4HWallOk(I64 i, I64 j)
{
	I64	 x;
	Bool wallok;

	x = 1;
	while (D1DunGet(i + x, j) == 6)
	{
		if (D1DunFlag(i + x, j) != 0)
			break;
		if (D1DunGet(i + x, j - 1) != 6)
			break;
		if (D1DunGet(i + x, j + 1) != 6)
			break;
		x++;
	}

	wallok = FALSE;
	if (D1DunGet(i + x, j) == 10)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 12)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 13)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 15)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 16)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 21)
		wallok = TRUE;
	if (D1DunGet(i + x, j) == 22)
		wallok = TRUE;
	if (x <= 3)
		wallok = FALSE;

	if (wallok)
		return x;
	return -1;
}

I64 D4VWallOk(I64 i, I64 j)
{
	I64	 y;
	Bool wallok;

	y = 1;
	while (D1DunGet(i, j + y) == 6)
	{
		if (D1DunFlag(i, j + y) != 0)
			break;
		if (D1DunGet(i - 1, j + y) != 6)
			break;
		if (D1DunGet(i + 1, j + y) != 6)
			break;
		y++;
	}

	wallok = FALSE;
	if (D1DunGet(i, j + y) == 8)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 9)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 11)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 14)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 15)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 16)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 21)
		wallok = TRUE;
	if (D1DunGet(i, j + y) == 23)
		wallok = TRUE;
	if (y <= 3)
		wallok = FALSE;

	if (wallok)
		return y;
	return -1;
}

U0 D4HorizWall(I64 i, I64 j, I64 dx)
{
	I64 xx;

	if (D1DunGet(i, j) == 13)
		D1DunSet(i, j, 17);
	if (D1DunGet(i, j) == 16)
		D1DunSet(i, j, 11);
	if (D1DunGet(i, j) == 12)
		D1DunSet(i, j, 14);

	for (xx = 1; xx < dx; xx++)
		D1DunSet(i + xx, j, 2);

	if (D1DunGet(i + dx, j) == 15)
		D1DunSet(i + dx, j, 14);
	if (D1DunGet(i + dx, j) == 10)
		D1DunSet(i + dx, j, 17);
	if (D1DunGet(i + dx, j) == 21)
		D1DunSet(i + dx, j, 23);
	if (D1DunGet(i + dx, j) == 22)
		D1DunSet(i + dx, j, 29);

	xx = D1Rnd(dx - 3) + 1;
	D1DunSet(i + xx, j, 57);
	D1DunSet(i + xx + 2, j, 56);
	D1DunSet(i + xx + 1, j, 60);

	if (D1DunGet(i + xx, j - 1) == 6)
		D1DunSet(i + xx, j - 1, 58);
	if (D1DunGet(i + xx + 1, j - 1) == 6)
		D1DunSet(i + xx + 1, j - 1, 59);
}

U0 D4VertWall(I64 i, I64 j, I64 dy)
{
	I64 yy;

	if (D1DunGet(i, j) == 14)
		D1DunSet(i, j, 17);
	if (D1DunGet(i, j) == 8)
		D1DunSet(i, j, 9);
	if (D1DunGet(i, j) == 15)
		D1DunSet(i, j, 10);

	for (yy = 1; yy < dy; yy++)
		D1DunSet(i, j + yy, 1);

	if (D1DunGet(i, j + dy) == 11)
		D1DunSet(i, j + dy, 17);
	if (D1DunGet(i, j + dy) == 9)
		D1DunSet(i, j + dy, 10);
	if (D1DunGet(i, j + dy) == 16)
		D1DunSet(i, j + dy, 13);
	if (D1DunGet(i, j + dy) == 21)
		D1DunSet(i, j + dy, 22);
	if (D1DunGet(i, j + dy) == 23)
		D1DunSet(i, j + dy, 29);

	yy = D1Rnd(dy - 3) + 1;
	D1DunSet(i, j + yy, 53);
	D1DunSet(i, j + yy + 2, 52);
	D1DunSet(i, j + yy + 1, 6);

	if (D1DunGet(i - 1, j + yy) == 6)
		D1DunSet(i - 1, j + yy, 54);
	if (D1DunGet(i - 1, j + yy - 1) == 6)
		D1DunSet(i - 1, j + yy - 1, 55);
}

U0 D4AddWall()
{
	I64 i;
	I64 j;
	I64 x;
	I64 y;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunFlag(i, j) == 0)
			{
				if (D1DunGet(i, j) == 10 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 12 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 13 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 15 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 16 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 21 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 22 && D1Rnd(100) < 100)
				{
					x = D4HWallOk(i, j);
					if (x != -1)
						D4HorizWall(i, j, x);
				}
				if (D1DunGet(i, j) == 8 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 9 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 11 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 14 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 15 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 16 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 21 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
				if (D1DunGet(i, j) == 23 && D1Rnd(100) < 100)
				{
					y = D4VWallOk(i, j);
					if (y != -1)
						D4VertWall(i, j, y);
				}
			}
		}
}

U0 D4TileFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++) {
		for (i = 0; i < D1_DMAX; i++) {
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 6)
				D1DunSet(i + 1, j, 5);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 13);
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 2)
				D1DunSet(i, j + 1, 14);
		}
	}
	for (j = 0; j < D1_DMAX; j++) {
		for (i = 0; i < D1_DMAX; i++) {
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 6)
				D1DunSet(i + 1, j, 2);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 9)
				D1DunSet(i + 1, j, 11);
			if (D1DunGet(i, j) == 9 && D1DunGet(i + 1, j) == 6)
				D1DunSet(i + 1, j, 12);
			if (D1DunGet(i, j) == 14 && D1DunGet(i + 1, j) == 1)
				D1DunSet(i + 1, j, 13);
			if (D1DunGet(i, j) == 6 && D1DunGet(i + 1, j) == 14)
