// D1Spell.ZC - spells and the spellbook (SPELLS button)
//
// Data\SpellBk.CEL: one unclipped 320x352 frame over the RIGHT half, bottom
// anchor y 351. Data\SpellBkB.CEL: five 76x29 page tabs, drawn at
// RIGHT_PANEL_X + 76 * tab + 7, bottom anchor y 348. Data\SpellI2.CEL: 43
// unclipped 37x38 spell icons; frame index per spell is SpellITbl
// (control.cpp:162). CtrlPan\SpelIcon.CEL holds the 56-wide variants used by
// the quick-cast ring, which this port does not draw.
//
// six spells of the original's 36: Firebolt, Healing, Lightning, Flash,
// Fire Wall, Chain Lightning. Spell book pages keep their SpellPages slots
// (control.cpp:257) so the implemented spells sit where they always sat;
// unimplemented slots stay empty.
//
// mana costs follow GetManaAmount (spells.cpp:8) and damage GetDamageAmt
// (missiles.cpp:25), both reduced: no item mana adjust, no staff charges,
// no resistances. spell level is fixed at 1 - spell books are not in the
// item table - and a spell is known once the player level reaches the
// spelldat sBookLvl, which stands in for having read the book.
//
// Firebolt goes through D1MisSpawn. Lightning, Flash, Fire Wall and Chain
// have no missile type in D1Mis, so they resolve instantly against
// d1_mons[] and register a short-lived visual in d1_fx[], drawn by
// D1SpellFxDraw in the same camera transform D1MisDrawAll uses.

#define D1_NSPELL		6

#define D1SP_FIREBOLT	0
#define D1SP_HEAL		1
#define D1SP_LIGHTNING	2
#define D1SP_FLASH		3
#define D1SP_FIREWALL	4
#define D1SP_CHAIN		5

#define D1_SBK_X		320
#define D1_FXMAX		64

//kind of visual in d1_fx
#define D1FX_BOLT		0		//line between two tiles
#define D1FX_BURST		1		//expanding ring around one tile
#define D1FX_FLAME		2		//burning tile, damages what stands on it

U8 *d1_sp_name[D1_NSPELL] = {
	"Firebolt", "Healing", "Lightning", "Flash", "Fire Wall",
	"Chain Lightning"};

//spelldat sManaCost, sBookLvl, sManaAdj, sMinMana (spelldat.cpp:13)
I64 d1_sp_mana[D1_NSPELL]    = {6, 5, 10, 30, 28, 30};
I64 d1_sp_booklvl[D1_NSPELL] = {1, 1,  4,  5,  3,  8};
I64 d1_sp_adj[D1_NSPELL]     = {1, 3,  1,  2,  2,  1};
I64 d1_sp_minmana[D1_NSPELL] = {3, 1,  6, 16, 16, 18};

//SpellITbl frame into SpellI2.CEL, per spell (control.cpp:162)
I64 d1_sp_icon[D1_NSPELL] = {1, 2, 3, 4, 6, 16};

//16-point unit circle, scaled by 1024, for the burst ring
I64 d1_fx_cos[16] = {1024, 946, 724, 392, 0, -392, -724, -946,
	-1024, -946, -724, -392, 0, 392, 724, 946};
I64 d1_fx_sin[16] = {0, 392, 724, 946, 1024, 946, 724, 392,
	0, -392, -724, -946, -1024, -946, -724, -392};

//SpellPages rows, 4 pages of 7 (control.cpp:257). -1 = empty slot.
I64 d1_sp_pages[4 * 7] = {
	-1, D1SP_FIREBOLT,  -1, -1,             D1SP_HEAL, -1,          -1,
	-1, D1SP_FIREWALL,  -1, D1SP_LIGHTNING, -1,        D1SP_FLASH,  -1,
	-1, -1,             -1, -1,             -1,        D1SP_CHAIN,  -1,
	-1, -1,             -1, -1,             -1,        -1,          -1};

I64	 d1_sp_lvl[D1_NSPELL] = {1, 1, 1, 1, 1, 1};

Bool d1_spell_open   = FALSE;
I64	 d1_spell_active = D1SP_FIREBOLT;
I64	 d1_spell_page   = 0;

U8	*d1_sbk_cel  = NULL;
U8	*d1_sbk_btn  = NULL;
U8	*d1_sbk_icon = NULL;
U8	 d1_sbk_txt[64];

class CD1Fx
{
	I64	 kind;
	I64	 x0;			//tile
	I64	 y0;
	I64	 x1;
	I64	 y1;
	I64	 timer;			//ticks left
	I64	 age;
	I64	 dmg;			//64ths, D1FX_FLAME only
	I64	 color;
	Bool active;
};

CD1Fx d1_fx[D1_FXMAX];
Bool  d1_fx_init = FALSE;

U0 D1SpellFxClear()
{
	I64 i;

	for (i = 0; i < D1_FXMAX; i++)
		d1_fx[i].active = FALSE;
	d1_fx_init = TRUE;
}

U0 D1FxAdd(I64 kind, I64 x0, I64 y0, I64 x1, I64 y1, I64 ticks, I64 dmg,
	I64 color)
{
	I64	 i;
	CD1Fx *f = NULL;

	if (!d1_fx_init)
		D1SpellFxClear;

	for (i = 0; i < D1_FXMAX; i++)
	{
		if (!f && !d1_fx[i].active)
			f = &d1_fx[i];
	}
	if (!f)
		return;

	f->kind   = kind;
	f->x0     = x0;
	f->y0     = y0;
	f->x1     = x1;
	f->y1     = y1;
	f->timer  = ticks;
	f->age    = 0;
	f->dmg    = dmg;
	f->color  = color;
	f->active = TRUE;
}

//--- spell numbers ---------------------------------------------------------

Bool D1SpellKnown(I64 s)
{//spell books are absent; player level stands in for having read one
	if (s < 0 || s >= D1_NSPELL)
		return FALSE;
	return d1_plr_lvl >= d1_sp_booklvl[s];
}

I64 D1SpellMana(I64 s)
{//GetManaAmount, reduced: no item cost modifier, no 255-cost spells
	I64 sl  = d1_sp_lvl[s] - 1;
	I64 adj = 0;
	I64 ma;

	if (sl < 0)
		sl = 0;
	adj = sl * d1_sp_adj[s];
	if (s == D1SP_FIREBOLT)
		adj >>= 1;

	if (s == D1SP_HEAL)
		ma = (d1_sp_mana[s] + 2 * d1_plr_lvl - adj) << 6;
	else
		ma = (d1_sp_mana[s] - adj) << 6;

	if (d1_plr_class == D1CL_ROGUE)
		ma -= ma >> 2;
	if (d1_sp_minmana[s] > (ma >> 6))
		ma = d1_sp_minmana[s] << 6;
	return ma;
}

U0 D1SpellDamRange(I64 s, I64 *mind, I64 *maxd)
{//GetDamageAmt (missiles.cpp:25). -1,-1 = the spell deals no direct damage.
	I64 sl = d1_sp_lvl[s];
	I64 k;
	I64 v;

	*mind = -1;
	*maxd = -1;

	if (s == D1SP_FIREBOLT)
	{
		*mind = (d1_plr_mag >> 3) + sl + 1;
		*maxd = (d1_plr_mag >> 3) + sl + 10;
	}
	else if (s == D1SP_LIGHTNING)
	{
		*mind = 2;
		*maxd = d1_plr_lvl + 2;
	}
	else if (s == D1SP_FLASH)
	{
		v = d1_plr_lvl;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		v += v >> 1;
		*mind = v;
		*maxd = v * 2;
	}
	else if (s == D1SP_FIREWALL)
	{
		*mind = (4 * d1_plr_lvl + 8) >> 1;
		*maxd = (4 * d1_plr_lvl + 80) >> 1;
	}
	else if (s == D1SP_CHAIN)
	{
		*mind = 4;
		*maxd = 2 * d1_plr_lvl + 4;
	}
}

I64 D1SpellRollDam(I64 s)
{//64ths
	I64 mind = 0;
	I64 maxd = 0;

	D1SpellDamRange(s, &mind, &maxd);
	if (mind < 0)
		return 0;
	if (maxd < mind)
		maxd = mind;
	return (mind + D1Rnd(maxd - mind + 1)) << 6;
}

//--- effects ---------------------------------------------------------------

U0 D1SpellHealSelf()
{//AddHeal (missiles.cpp:3131)
	I64 amt = (D1Rnd(10) + 1) << 6;
	I64 i;

	for (i = 0; i < d1_plr_lvl; i++)
		amt += (D1Rnd(4) + 1) << 6;
	for (i = 0; i < d1_sp_lvl[D1SP_HEAL]; i++)
		amt += (D1Rnd(6) + 1) << 6;

	if (d1_plr_class == D1CL_WARRIOR)
		amt <<= 1;
	else if (d1_plr_class == D1CL_ROGUE)
		amt += amt >> 1;

	d1_plr_hp += amt;
	if (d1_plr_hp > d1_plr_maxhp)
		d1_plr_hp = d1_plr_maxhp;
}

U0 D1SpellBoltLine(I64 tx, I64 ty)
{//walk the ray from the player to the target, damaging the first monsters
 //it meets, stopping at the first wall. MI_Lightctrl's tile walk, reduced.
	I64	 dx = tx - d1_plr_x;
	I64	 dy = ty - d1_plr_y;
	I64	 steps;
	I64	 i;
	I64	 x;
	I64	 y;
	I64	 mi;
	I64	 ex = d1_plr_x;
	I64	 ey = d1_plr_y;
	Bool stop = FALSE;

	steps = dx;
	if (steps < 0)
		steps = -steps;
	i = dy;
	if (i < 0)
		i = -i;
	if (i > steps)
		steps = i;
	if (steps < 1)
		steps = 1;

	for (i = 1; i <= steps; i++)
	{
		if (!stop)
		{
			x = d1_plr_x + (dx * i) / steps;
			y = d1_plr_y + (dy * i) / steps;
			if (!D1Walkable(x, y))
				stop = TRUE;
			else
			{
				ex = x;
				ey = y;
				mi = D1MonAtTile(x, y);
				if (mi >= 0)
					D1MonHurt(mi, D1SpellRollDam(D1SP_LIGHTNING));
			}
		}
	}
	D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, ex, ey, 6, 0, 176);
}

U0 D1SpellFlash()
{//MI_Flash: the eight tiles around the caster plus the caster's own
	I64 i;
	I64 mi;
	I64 x;
	I64 y;

	for (i = 0; i < 8; i++)
	{
		x  = d1_plr_x + d1_dir_dx[i];
		y  = d1_plr_y + d1_dir_dy[i];
		mi = D1MonAtTile(x, y);
		if (mi >= 0)
			D1MonHurt(mi, D1SpellRollDam(D1SP_FLASH));
	}
	D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 176);
}

U0 D1SpellChain(I64 tx, I64 ty)
{//MI_Chain: hit the target, then jump to the nearest untouched monster.
 //jump count is (spell level >> 1) + 3, as CastSpell gives MIS_CBOLT.
	I64	 jumps = (d1_sp_lvl[D1SP_CHAIN] >> 1) + 3;
	I64	 hit[8];
	I64	 nhit = 0;
	I64	 cx = d1_plr_x;
	I64	 cy = d1_plr_y;
	I64	 mi;
	I64	 i;
	I64	 j;
	I64	 best;
	I64	 best_d;
	I64	 d;
	I64	 dx;
	I64	 dy;
	Bool seen;

	if (jumps > 8)
		jumps = 8;

	mi = D1MonAtTile(tx, ty);
	for (i = 0; i < jumps; i++)
	{
		if (mi >= 0)
		{
			D1FxAdd(D1FX_BOLT, cx, cy, d1_mons[mi].x, d1_mons[mi].y, 6, 0,
				176);
			cx = d1_mons[mi].x;
			cy = d1_mons[mi].y;
			hit[nhit] = mi;
			nhit++;
			D1MonHurt(mi, D1SpellRollDam(D1SP_CHAIN));

			//nearest live monster within 8 tiles that has not been hit
			best   = -1;
			best_d = 0;
			for (j = 0; j < d1_nmons; j++)
			{
				seen = FALSE;
				for (d = 0; d < nhit; d++)
				{
					if (hit[d] == j)
						seen = TRUE;
				}
				if (!seen && D1MonAtTile(d1_mons[j].x, d1_mons[j].y) == j)
				{
					dx = d1_mons[j].x - cx;
					dy = d1_mons[j].y - cy;
					d  = dx * dx + dy * dy;
					if (d <= 64 && (best < 0 || d < best_d))
					{
						best   = j;
						best_d = d;
					}
				}
			}
			mi = best;
		}
	}
	if (nhit == 0)
		D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, tx, ty, 6, 0, 176);
}

U0 D1SpellFireWall(I64 tx, I64 ty)
{//AddFirewall lays the wall across the cast direction; five tiles here.
 //each tile burns for 40 ticks and damages what stands on it every fourth.
	I64 dx = tx - d1_plr_x;
	I64 dy = ty - d1_plr_y;
	I64 px;
	I64 py;
	I64 i;
	I64 x;
	I64 y;

	//perpendicular of the cast direction, snapped to one tile
	px = -dy;
	py = dx;
	if (px > 0)
		px = 1;
	if (px < 0)
		px = -1;
	if (py > 0)
		py = 1;
	if (py < 0)
		py = -1;
	if (px == 0 && py == 0)
		px = 1;

	for (i = -2; i <= 2; i++)
	{
		x = tx + px * i;
		y = ty + py * i;
		if (D1Walkable(x, y))
			D1FxAdd(D1FX_FLAME, x, y, 0, 0, 40,
				D1SpellRollDam(D1SP_FIREWALL), 214);
	}
}

U0 D1SpellSelect(I64 idx)
{//hotkey helper; silently ignores spells the player cannot cast
	if (idx >= 0 && idx < D1_NSPELL && D1SpellKnown(idx))
		d1_spell_active = idx;
}

U0 D1SpellCast(I64 tx, I64 ty)
{//cast the active spell at a tile
	I64 s    = d1_spell_active;
	I64 cost;
	I64 dmg;

	if (!d1_play_ready || d1_plr_dead)
		return;
	if (!D1SpellKnown(s))
		return;

	cost = D1SpellMana(s);
	if (d1_plr_mana < cost)
		return;
	d1_plr_mana -= cost;

	d1_plr_dir = D1GetDir(tx - d1_plr_x, ty - d1_plr_y);

	if (s == D1SP_FIREBOLT)
	{
		dmg = D1SpellRollDam(D1SP_FIREBOLT);
		D1MisSpawn(D1MIS_FIREBOLT, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast2.wav");
	}
	else if (s == D1SP_HEAL)
	{
		D1SpellHealSelf;
		D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 192);
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast8.wav");
	}
	else if (s == D1SP_LIGHTNING)
	{
		D1SpellBoltLine(tx, ty);
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast4.wav");
	}
	else if (s == D1SP_FLASH)
	{
		D1SpellFlash;
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast4.wav");
	}
	else if (s == D1SP_FIREWALL)
	{
		D1SpellFireWall(tx, ty);
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast2.wav");
	}
	else if (s == D1SP_CHAIN)
	{
		D1SpellChain(tx, ty);
		if (d1_opt_sfx)
			D1SndPlay("Sfx\\Misc\\Cast2.wav");
	}
}

U0 D1SpellTick()
{//20Hz, alongside D1MisTick
	CD1Fx *f;
	I64	 i;
	I64	 mi;

	if (!d1_fx_init)
		D1SpellFxClear;

	for (i = 0; i < D1_FXMAX; i++)
	{
		f = &d1_fx[i];
		if (f->active)
		{
			f->age++;
			f->timer--;
			if (f->kind == D1FX_FLAME && !(f->age & 3))
			{
				mi = D1MonAtTile(f->x0, f->y0);
				if (mi >= 0)
					D1MonHurt(mi, f->dmg);
				if (f->x0 == d1_plr_tile_x && f->y0 == d1_plr_tile_y)
				{
					d1_plr_hp -= f->dmg >> 1;
					d1_plr_hitflash = 4;
					if (d1_plr_hp <= 0)
					{
						d1_plr_hp   = 0;
						d1_plr_dead = TRUE;
					}
				}
			}
			if (f->timer <= 0)
				f->active = FALSE;
		}
	}
}

//--- effect visuals --------------------------------------------------------

U0 D1SpellTileScreen(I64 tx, I64 ty, I64 *sx, I64 *sy)
{//same transform D1MisDrawAll uses, tile center in 64ths
	I64 rx = tx * 64 + 32 - d1_view_x * 64 - 32;
	I64 ry = ty * 64 + 32 - d1_view_y * 64 - 32;

	*sx = D1_W / 2 + ((rx - ry) * 32) / 64 - d1_view_xoff;
	*sy = d1_vp_h / 2 + ((rx + ry) * 16) / 64 - d1_view_yoff + 16;
}

U0 D1SpellPix(I64 x, I64 y, I64 color)
{//viewport only; the panel and the open side panels stay untouched
	if (y >= 0 && y < d1_vp_h)
		D1Pix(x, y, color);
}

U0 D1SpellLine(I64 x0, I64 y0, I64 x1, I64 y1, I64 color)
{//Bresenham
	I64 dx = x1 - x0;
	I64 dy = y1 - y0;
	I64 sx = 1;
	I64 sy = 1;
	I64 err;
	I64 e2;
	I64 guard = 0;

	if (dx < 0)
	{
		dx = -dx;
		sx = -1;
	}
	if (dy < 0)
	{
		dy = -dy;
		sy = -1;
	}
	err = dx - dy;

	while (guard < 4096)
	{
		D1SpellPix(x0, y0, color);
		D1SpellPix(x0, y0 - 1, color);
		if (x0 == x1 && y0 == y1)
			guard = 4096;
		else
		{
			e2 = err * 2;
			if (e2 > -dy)
			{
				err -= dy;
				x0  += sx;
			}
			if (e2 < dx)
			{
				err += dx;
				y0  += sy;
			}
			guard++;
		}
	}
}

U0 D1SpellFxDraw()
{//call after D1MisDrawAll, before the zoom pass
	CD1Fx *f;
	I64	 i;
	I64	 a;
	I64	 x0;
	I64	 y0;
	I64	 x1;
	I64	 y1;
	I64	 r;
	I64	 t;
	I64	 px;
	I64	 py;

	if (!d1_fx_init)
		return;

	for (i = 0; i < D1_FXMAX; i++)
	{
		f = &d1_fx[i];
		if (f->active)
		{
			D1SpellTileScreen(f->x0, f->y0, &x0, &y0);
			if (f->kind == D1FX_BOLT)
			{
				D1SpellTileScreen(f->x1, f->y1, &x1, &y1);
				D1SpellLine(x0, y0, x1, y1, f->color);
				D1SpellLine(x0, y0 - 2, x1, y1 - 2, 255);
			}
			else if (f->kind == D1FX_BURST)
			{
				r = f->age * 6;
				for (a = 0; a < 16; a++)
				{//ring on the tile grid: 2:1 screen aspect
					px = x0 + (r * d1_fx_cos[a]) / 1024;
					py = y0 + (r * d1_fx_sin[a]) / 2048;
					D1SpellPix(px, py, f->color);
					D1SpellPix(px, py - 1, 255);
					D1SpellPix(px + 1, py, f->color);
				}
			}
			else
			{//flame: a flickering diamond over the burning tile
				r = 12 + (f->age & 3) * 2;
				for (a = -r; a <= r; a++)
				{//tile diamond: half height is (r - |a|) / 2
					t = a;
					if (t < 0)
						t = -t;
					t = (r - t) / 2;
					for (py = y0 - t; py <= y0 + t; py++)
						D1SpellPix(x0 + a, py, f->color - (py & 1) * 6);
				}
			}
		}
	}
}

//--- spellbook -------------------------------------------------------------

U0 D1SpellToggle()
{
	I64 size = 0;

	if (!d1_sbk_cel)
		d1_sbk_cel = D1MpqRead("Data\\SpellBk.CEL", &size);
	if (!d1_sbk_btn)
		d1_sbk_btn = D1MpqRead("Data\\SpellBkB.CEL", &size);
	if (!d1_sbk_icon)
		d1_sbk_icon = D1MpqRead("Data\\SpellI2.CEL", &size);
	d1_spell_open = !d1_spell_open;
}

U0 D1SpellDraw()
{//DrawSpellBook (control.cpp:2490): rows every 43px from baseline 55,
 //icon at RIGHT_PANEL_X + 11 width 37, text at RIGHT_PANEL_X + 66
	I64 i;
	I64 sn;
	I64 yp;
	I64 tx;
	I64 mind;
	I64 maxd;

	if (!d1_spell_open || !d1_sbk_cel)
		return;

	D1CelDraw(D1_SBK_X, 351, d1_sbk_cel, 1, 320);
	if (d1_sbk_btn)
		D1CelDraw(D1_SBK_X + 76 * d1_spell_page + 7, 348, d1_sbk_btn,
			d1_spell_page + 1, 76);

	tx = D1_SBK_X + 66;
	yp = 55;
	for (i = 0; i < 7; i++)
	{
		sn = d1_sp_pages[d1_spell_page * 7 + i];
		if (sn >= 0 && D1SpellKnown(sn))
		{
			if (d1_sbk_icon)
				D1CelDraw(D1_SBK_X + 11, yp, d1_sbk_icon, d1_sp_icon[sn], 37);
			//SPLICONLAST, the last SpellI2 frame, is the selection border
			if (sn == d1_spell_active && d1_sbk_icon)
				D1CelDraw(D1_SBK_X + 11, yp, d1_sbk_icon, 43, 37);

			D1TextDrawSolid(tx, yp - 23, d1_sp_name[sn], 240);

			D1SpellDamRange(sn, &mind, &maxd);
			if (mind < 0)
				StrPrint(d1_sbk_txt, "Mana: %d   Dam: n/a",
					D1SpellMana(sn) >> 6);
			else
				StrPrint(d1_sbk_txt, "Mana: %d  Dam: %d - %d",
					D1SpellMana(sn) >> 6, mind, maxd);
			D1TextDrawSolid(tx, yp - 12, d1_sbk_txt, 240);

			StrPrint(d1_sbk_txt, "Spell Level %d", d1_sp_lvl[sn]);
			D1TextDrawSolid(tx, yp - 1, d1_sbk_txt, 240);
		}
		yp += 43;
	}
}

Bool D1SpellClick(I64 cx, I64 cy)
{//CheckSBook (control.cpp:2562). TRUE = consumed.
	I64 row;
	I64 sn;

	if (!d1_spell_open)
		return FALSE;
	if (cx < D1_SBK_X || cy < 0 || cy > 351)
		return FALSE;

	if (cx >= D1_SBK_X + 11 && cx < D1_SBK_X + 48 && cy >= 18 && cy < 314)
	{
		row = (cy - 18) / 43;
		sn  = d1_sp_pages[d1_spell_page * 7 + row];
		if (sn >= 0 && D1SpellKnown(sn))
			d1_spell_active = sn;
	}
	if (cx >= D1_SBK_X + 7 && cx < D1_SBK_X + 311 && cy >= 320 && cy < 349)
	{
		row = (cx - (D1_SBK_X + 7)) / 76;
		if (row >= 0 && row < 4)
			d1_spell_page = row;
	}
	return TRUE;
}
