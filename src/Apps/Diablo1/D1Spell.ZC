class CD1Fx
{
	I64	 kind;
	I64	 x0;
	I64	 y0;
	I64	 x1;
	I64	 y1;
	I64	 timer;
	I64	 age;
	I64	 dmg;			//64ths, D1FX_FLAME only
	I64	 color;
	Bool active;
};

CD1Fx d1_fx[D1_FXMAX];
Bool  d1_fx_init = FALSE;

U0 D1SpellFxClear()
{
	I64 i;

	for (i = 0; i < D1_FXMAX; i++)
		d1_fx[i].active = FALSE;
	d1_fx_init = TRUE;
}

U0 D1FxAdd(I64 kind, I64 x0, I64 y0, I64 x1, I64 y1, I64 ticks, I64 dmg,
	I64 color)
{
	I64	 i;
	CD1Fx *f = NULL;

	if (!d1_fx_init)
		D1SpellFxClear;

	for (i = 0; i < D1_FXMAX; i++)
	{
		if (!f && !d1_fx[i].active)
			f = &d1_fx[i];
	}
	if (!f)
		return;

	f->kind   = kind;
	f->x0     = x0;
	f->y0     = y0;
	f->x1     = x1;
	f->y1     = y1;
	f->timer  = ticks;
	f->age    = 0;
	f->dmg    = dmg;
	f->color  = color;
	f->active = TRUE;
}


Bool D1SpellKnown(I64 s)
{
	if (s < 0 || s >= D1_NSPELL)
		return FALSE;
	return ToBool(d1_sp_lvl[s] > 0);
}

Bool D1SpellLearn(I64 s)
{//items.cpp UseInvItem IMISC_BOOK: learn or raise. FALSE = already maxed.
	if (s < 0 || s >= D1_NSPELL)
		return FALSE;
	if (d1_sp_lvl[s] >= 15)
		return FALSE;
	d1_sp_lvl[s]++;
	if (d1_spell_active < 0)
	{
		d1_spell_active = s;
		d1_spell_type   = D1RSP_SPELL;
	}
	if (d1_opt_sfx)
		D1SndPlay("Sfx\\Items\\InvBook.wav");
	return TRUE;
}

#define D1_BOOK_NEVER	999

U0 D1SpellBooksInit()
{
 //Objcurs book curs ≈ 172; ground flip Items\Book1.CEL.
	I64 s;
	I64 itm;
	U8	 name[32];
	I64	 bl;
	I64	 val;

	D1ItmDropSet(19, "Items\\Book1.CEL", 13);
	for (s = 0; s < D1_NSPELL && s < D1_NBOOK; s++)
	{
		bl = d1_sp_booklvl[s];
		if (bl < 1)
			bl = D1_BOOK_NEVER;
		itm = D1IT_BOOK0 + s;
		if (itm >= D1_MAXITMDEF)
			return;
		name[0] = 0;
		D1StrCopy(name, "Book of ", 32);
		D1AffixCat(name, 8, d1_sp_name[s], 32);
		val = 1000 * bl;
		if (val < 500)
			val = 500;
		if (bl == D1_BOOK_NEVER)
			val = 0;
		//cls misc, loc none(7), frame 172, 1x1, mlvl=booklvl
		D1ItmSet(itm, name, 3, 7, 172, 1, 1,
			0, 0, 0, 0, 0, bl, 0, val, D1IM_BOOK, 19, 1, 0, 1);
	}
}

I64 D1SpellMana(I64 s)
{
	I64 sl;
	I64 adj = 0;
	I64 ma;

	if (s < 0 || s >= D1_NSPELL)
		return 0;
	if (d1_sp_mana[s] == 0 && d1_sp_minmana[s] == 0)
		return 0;
	sl = d1_sp_lvl[s] - 1;
	if (sl < 0)
		sl = 0;
	adj = sl * d1_sp_adj[s];
	if (s == D1SP_FIREBOLT)
		adj >>= 1;					//spells.cpp:26 gates on Firebolt alone

	if (s == D1SP_HEAL)
		ma = (d1_sp_mana[s] + 2 * d1_plr_lvl - adj) << 6;
	else
		ma = (d1_sp_mana[s] - adj) << 6;

	if (d1_plr_class == D1CL_ROGUE)
		ma -= ma >> 2;
	if (d1_sp_minmana[s] > (ma >> 6))
		ma = d1_sp_minmana[s] << 6;
	return ma;
}

U0 D1SpellDamRange(I64 s, I64 *mind, I64 *maxd)
{//GetDamageAmt (missiles.cpp:25). -1,-1 = the spell deals no direct damage.
	I64 sl = d1_sp_lvl[s];
	I64 k;
	I64 v;

	*mind = -1;
	*maxd = -1;

	if (s == D1SP_FIREBOLT)
	{
		*mind = (d1_plr_mag >> 3) + sl + 1;
		*maxd = (d1_plr_mag >> 3) + sl + 10;
	}
	else if (s == D1SP_LIGHTNING)
	{
		*mind = 2;
		*maxd = d1_plr_lvl + 2;
	}
	else if (s == D1SP_FLASH)
	{
		v = d1_plr_lvl;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		v += v >> 1;
		*mind = v;
		*maxd = v * 2;
	}
	else if (s == D1SP_FIREWALL)
	{
		*mind = (4 * d1_plr_lvl + 8) >> 1;
		*maxd = (4 * d1_plr_lvl + 80) >> 1;
	}
	else if (s == D1SP_CHAIN)
	{
		*mind = 4;
		*maxd = 2 * d1_plr_lvl + 4;
	}
	else if (s == D1SP_CBOLT)
	{
		*mind = 1;
		*maxd = (d1_plr_mag >> 2) + 1;
	}
	else if (s == D1SP_HBOLT)
	{
		*mind = d1_plr_lvl + 9;
		*maxd = d1_plr_lvl + 18;
	}
	else if (s == D1SP_INFERNO)
	{
		*mind = 3;
		*maxd = d1_plr_lvl + 4;
		*maxd += *maxd >> 1;
	}
	else if (s == D1SP_FIREBALL || s == D1SP_ELEMENT)
	{
		v = 2 * d1_plr_lvl + 4;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		*mind = v;
		v = 2 * d1_plr_lvl + 40;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		*maxd = v;
	}
	else if (s == D1SP_NOVA)
	{
		v = (d1_plr_lvl + 5) >> 1;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		*mind = v * 5;
		v = (d1_plr_lvl + 30) >> 1;
		for (k = 0; k < sl; k++)
			v += v >> 3;
		*maxd = v * 5;
	}
	else if (s == D1SP_BLOODSTAR)
	{
		v = (d1_plr_mag >> 1) + 3 * sl - (d1_plr_mag >> 3);
		if (v < 1)
			v = 1;
		*mind = v;
		*maxd = v;
	}
	else if (s == D1SP_WAVE || s == D1SP_GUARDIAN)
	{
		*mind = (4 * d1_plr_lvl + 8) >> 1;
		*maxd = (4 * d1_plr_lvl + 80) >> 1;
	}
	else if (s == D1SP_GOLEM)
	{
		*mind = d1_plr_lvl + 2;
		*maxd = (d1_plr_lvl << 1) + 8;
	}
	else if (s == D1SP_APOCALYPSE)
	{
		*mind = d1_plr_lvl;
		*maxd = d1_plr_lvl * 3;
	}
}

I64 D1SpellRollDam(I64 s)
{//64ths
	I64 mind = 0;
	I64 maxd = 0;

	D1SpellDamRange(s, &mind, &maxd);
	if (mind < 0)
		return 0;
	if (maxd < mind)
		maxd = mind;
	return (mind + D1Rnd(maxd - mind + 1)) << 6;
}


U0 D1SpellHealSelf()
{//AddHeal (missiles.cpp:3131)
	I64 amt = (D1Rnd(10) + 1) << 6;
	I64 i;

	for (i = 0; i < d1_plr_lvl; i++)
		amt += (D1Rnd(4) + 1) << 6;
	for (i = 0; i < d1_sp_lvl[D1SP_HEAL]; i++)
		amt += (D1Rnd(6) + 1) << 6;

	if (d1_plr_class == D1CL_WARRIOR)
		amt <<= 1;
	else if (d1_plr_class == D1CL_ROGUE)
		amt += amt >> 1;

	d1_plr_hp += amt;
	if (d1_plr_hp > d1_plr_maxhp)
		d1_plr_hp = d1_plr_maxhp;
}

U0 D1SpellBoltLine(I64 tx, I64 ty)
{
	I64	 dx = tx - d1_plr_x;
	I64	 dy = ty - d1_plr_y;
	I64	 reach = (d1_sp_lvl[D1SP_LIGHTNING] >> 1) + 6;
	I64	 steps;
	I64	 i;
	I64	 x;
	I64	 y;
	I64	 mi;
	I64	 ex = d1_plr_x;
	I64	 ey = d1_plr_y;
	Bool stop = FALSE;

	steps = dx;
	if (steps < 0)
		steps = -steps;
	i = dy;
	if (i < 0)
		i = -i;
	if (i > steps)
		steps = i;
	if (steps < 1)
		steps = 1;
	if (steps > reach)
		steps = reach;

	for (i = 1; i <= steps; i++)
	{
		if (!stop)
		{
			x = d1_plr_x + (dx * i) / steps;
			y = d1_plr_y + (dy * i) / steps;
			if (!D1Walkable(x, y))
				stop = TRUE;
			else
			{
				ex = x;
				ey = y;
				mi = D1MonAtTile(x, y);
				if (mi >= 0 && D1MisSpellHit(mi, i))
					D1MonHurtType(mi, D1SpellRollDam(D1SP_LIGHTNING),
						D1RES_LIGHTNING);
			}
		}
	}
	D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, ex, ey, 6, 0, 176);
}

U0 D1SpellFlash()
{//AddFlash (missiles.cpp:2692) rolls (_pLevel + 1) d20
	I64 dam = 0;
	I64 i;

	for (i = 0; i <= d1_plr_lvl; i++)
		dam += D1Rnd(20) + 1;
	for (i = d1_sp_lvl[D1SP_FLASH]; i > 0; i--)
		dam += dam >> 3;
	dam += dam >> 1;

	D1FxAdd(D1FX_FLASH, d1_plr_x, d1_plr_y, 0, 0, 19, dam << 6, 176);
	D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 176);
}

U0 D1SpellNova()
{//AddNova (missiles.cpp:3287)
	I64 dmg = D1Rnd(6) + D1Rnd(6) + D1Rnd(6) + D1Rnd(6) + D1Rnd(6);
	I64 j;
	I64 k;
	I64 dx;
	I64 dy;

	dmg += d1_plr_lvl + 5;
	dmg >>= 1;
	for (k = d1_sp_lvl[D1SP_NOVA]; k > 0; k--)
		dmg += dmg >> 3;
	if (dmg < 1)
		dmg = 1;

	for (j = 0; j < d1_nmons; j++)
	{
		if (D1MonAtTile(d1_mons[j].x, d1_mons[j].y) == j)
		{
			dx = d1_mons[j].x - d1_plr_x;
			dy = d1_mons[j].y - d1_plr_y;
			if (dx * dx + dy * dy <= 25 && D1MisSpellHit(j, 0))
				D1MonHurtType(j, dmg << 6, D1RES_LIGHTNING);
		}
	}
	D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 14, 0, 176);
}

U0 D1SpellChain(I64 tx, I64 ty)
{//MI_Chain (missiles.cpp:5093)
	I64	 rad = d1_sp_lvl[D1SP_CHAIN] + 3;
	I64	 aimed;
	I64	 j;
	I64	 dx;
	I64	 dy;

	if (rad > 19)
		rad = 19;

	aimed = D1MonAtTile(tx, ty);
	D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, tx, ty, 6, 0, 176);
	if (aimed >= 0 && D1MisSpellHit(aimed, 0))
		D1MonHurtType(aimed, D1SpellRollDam(D1SP_CHAIN), D1RES_LIGHTNING);

	for (j = 0; j < d1_nmons; j++)
	{
		if (j != aimed && D1MonAtTile(d1_mons[j].x, d1_mons[j].y) == j)
		{
			dx = d1_mons[j].x - d1_plr_x;
			dy = d1_mons[j].y - d1_plr_y;
			//the rings reach radius rad - 1 from the caster
			if (dx * dx + dy * dy <= (rad - 1) * (rad - 1))
			{
				D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, d1_mons[j].x,
					d1_mons[j].y, 6, 0, 176);
				if (D1MisSpellHit(j, 0))
					D1MonHurtType(j, D1SpellRollDam(D1SP_CHAIN),
						D1RES_LIGHTNING);
			}
		}
	}
}

Bool D1SpellLineClear(I64 x0, I64 y0, I64 x1, I64 y1)
{//engine.cpp LineClear: no solid tile between the two, endpoints excluded
	I64 dx = x1 - x0;
	I64 dy = y1 - y0;
	I64 steps;
	I64 i;
	I64 x;
	I64 y;

	steps = dx;
	if (steps < 0)
		steps = -steps;
	i = dy;
	if (i < 0)
		i = -i;
	if (i > steps)
		steps = i;
	if (steps < 1)
		return TRUE;
	for (i = 1; i < steps; i++)
	{
		x = x0 + (dx * i) / steps;
		y = y0 + (dy * i) / steps;
		if (!D1Walkable(x, y))
			return FALSE;
	}
	return TRUE;
}

U0 D1SpellFireWall(I64 tx, I64 ty)
{//AddFirewallC (missiles.cpp:3217) refuses a target it has no clear line to;
	I64 dx = tx - d1_plr_x;
	I64 dy = ty - d1_plr_y;
	I64 ticks = 10 * (d1_sp_lvl[D1SP_FIREWALL] + 1);
	I64 px;
	I64 py;
	I64 i;
	I64 x;
	I64 y;

	if (!D1Walkable(tx, ty) || (tx == d1_plr_x && ty == d1_plr_y))
		return;
	if (!D1SpellLineClear(d1_plr_x, d1_plr_y, tx, ty))
		return;

	px = -dy;
	py = dx;
	if (px > 0)
		px = 1;
	if (px < 0)
		px = -1;
	if (py > 0)
		py = 1;
	if (py < 0)
		py = -1;
	if (px == 0 && py == 0)
		px = 1;

	for (i = -2; i <= 2; i++)
	{
		x = tx + px * i;
		y = ty + py * i;
		if (D1Walkable(x, y))
			D1FxAdd(D1FX_FIREWALL, x, y, 0, 0, ticks,
				D1SpellRollDam(D1SP_FIREWALL), 214);
	}
}

U0 D1SpellInferno(I64 tx, I64 ty)
{
	I64 dx = tx - d1_plr_x;
	I64 dy = ty - d1_plr_y;
	I64 dir = D1GetDir(dx, dy);
	I64 i;
	I64 x;
	I64 y;
	Bool stop = FALSE;

	for (i = 1; i <= 3; i++)
	{
		if (!stop)
		{
			x = d1_plr_x + d1_dir_dx[dir] * i;
			y = d1_plr_y + d1_dir_dy[dir] * i;
			if (!D1Walkable(x, y))
				stop = TRUE;
			else
				D1FxAdd(D1FX_FLAME, x, y, 0, 0, 20,
					D1SpellRollDam(D1SP_INFERNO), 214);
		}
	}
}

Bool D1SpellStone(I64 tx, I64 ty)
{//AddStone (missiles.cpp:3001)
	I64 mi = D1MonAtTile(tx, ty);
	I64 ticks = d1_sp_lvl[D1SP_STONE] + 6;

	if (mi < 0)
		return FALSE;
	if (ticks > 15)
		ticks = 15;
	ticks <<= 4;
	D1MonStone(mi, ticks);
	D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 8, 0, 128);
	return TRUE;
}

Bool D1SpellSpotFree(I64 x, I64 y)
{
	if (!D1Walkable(x, y))
		return FALSE;
	if (D1MonAtTile(x, y) >= 0)
		return FALSE;
	if (x == d1_plr_x && y == d1_plr_y)
		return FALSE;
	return ToBool(!D1ObjBlocks(x, y));
}

Bool D1SpellCrawlFree(I64 cx, I64 cy, I64 rings, I64 *ox, I64 *oy)
{
	I64 r;
	I64 dx;
	I64 dy;

	for (r = 0; r < rings; r++)
	{
		for (dy = -r; dy <= r; dy++)
		{
			for (dx = -r; dx <= r; dx++)
			{
				if ((dx == r || dx == -r || dy == r || dy == -r) &&
					D1SpellSpotFree(cx + dx, cy + dy))
				{
					*ox = cx + dx;
					*oy = cy + dy;
					return TRUE;
				}
			}
		}
	}
	return FALSE;
}

U0 D1SpellWarpTo(I64 x, I64 y)
{
	D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 192);
	D1PlacePlayer(x, y);
	D1LightUpdate(d1_plr_x, d1_plr_y);
	D1FxAdd(D1FX_BURST, x, y, 0, 0, 8, 0, 192);
}

Bool D1SpellTeleport(I64 tx, I64 ty)
{//AddTeleport (missiles.cpp:2406): six CrawlTable rings around the target;
	I64 x = 0;
	I64 y = 0;

	if (D1SpellSpotFree(tx, ty))
	{
		D1SpellWarpTo(tx, ty);
		return TRUE;
	}
	if (!D1SpellCrawlFree(tx, ty, 6, &x, &y))
		return FALSE;
	D1SpellWarpTo(x, y);
	return TRUE;
}

Bool D1SpellPhase()
{//AddRndTeleport (missiles.cpp:2289)
	I64 i;
	I64 x;
	I64 y;

	for (i = 0; i < 200; i++)
	{
		x = D1Rnd(3) + 4;
		y = D1Rnd(3) + 4;
		if (D1Rnd(2) == 1)
			x = -x;
		if (D1Rnd(2) == 1)
			y = -y;
		x += d1_plr_x;
		y += d1_plr_y;
		if (D1SpellSpotFree(x, y))
		{
			D1SpellWarpTo(x, y);
			return TRUE;
		}
	}
	return FALSE;
}

U0 D1SpellChargedBolt(I64 tx, I64 ty)
{//CastSpell fires (spell level >> 1) + 4 MIS_CBOLTs (spells.cpp CastSpell).
	I64 n = (d1_sp_lvl[D1SP_CBOLT] >> 1) + 4;
	I64 dmg;
	I64 i;
	I64 off;

	for (i = 0; i < n; i++)
	{
		off = (i + 1) >> 1;
		if (i & 1)
			off = -off;
		dmg = D1SpellRollDam(D1SP_CBOLT);
		D1MisSpawn(D1MIS_CBOLT, -1, d1_plr_x, d1_plr_y, tx + off, ty - off,
			dmg);
	}
}

Bool D1SpellPortalSpotOk(I64 x, I64 y)
{
	if (!D1Walkable(x, y))
		return FALSE;
	if (D1ObjBlocks(x, y))
		return FALSE;
	if (x == d1_plr_x && y == d1_plr_y)
		return FALSE;
	if (D1MonAtTile(x, y) >= 0)
		return FALSE;
	if (x == d1_trig_up_x && y == d1_trig_up_y)
		return FALSE;
	if (x == d1_trig_down_x && y == d1_trig_down_y)
		return FALSE;
	return TRUE;
}

Bool D1SpellTownPortal(I64 tx, I64 ty)
{//AddTown (missiles.cpp:2630)
	I64 d;
	I64 r;
	I64 dx;
	I64 dy;
	I64 x = -1;
	I64 y = -1;

	if (d1_currlevel == 0)
		return FALSE;

	for (r = 0; r < 6 && x < 0; r++)
	{
		for (dy = -r; dy <= r && x < 0; dy++)
		{
			for (dx = -r; dx <= r && x < 0; dx++)
			{
				if ((dx == r || dx == -r || dy == r || dy == -r) &&
					D1SpellPortalSpotOk(tx + dx, ty + dy))
				{
					x = tx + dx;
					y = ty + dy;
				}
			}
		}
	}
	if (x < 0)
		return FALSE;

	d1_portal_up    = TRUE;
	d1_portal_lvl   = d1_currlevel;
	d1_portal_x     = x;
	d1_portal_y     = y;
	d1_portal_grace = 20;
	if (!d1_portal_cel)
	{
		d = 0;
		d1_portal_cel = D1MpqRead("Missiles\\Portal1.CL2", &d);
	}
	return TRUE;
}

U0 D1SpellRingBuild()
{
	I64 s;

	d1_splring_n = 0;
	for (s = 0; s < D1_NSPELL; s++)
	{
		if (D1SpellKnown(s) && d1_splring_n < D1_NSPELL)
		{
			d1_splring_id[d1_splring_n] = s;
			d1_splring_n++;
		}
	}
}

U0 D1SpellRingToggle()
{
	if (d1_splring)
		d1_splring = FALSE;
	else
	{
		D1SpellRingBuild;
		if (d1_splring_n > 0)
			d1_splring = TRUE;
	}
}

U0 D1SpellRingClose()
{
	d1_splring = FALSE;
}

U0 D1SpellRingDraw()
{
	I64 i;
	I64 n;
	I64 ang;
	I64 ox;
	I64 oy;
	I64 ix;
	I64 iy;
	I64 icon;
	I64 s;
	I64 cx;
	I64 cy;

	if (!d1_splring || !d1_splicon_cel || d1_splring_n <= 0)
		return;
	n  = d1_splring_n;
	cx = D1UiOrgX() + D1_SPLICON_X + D1_SPLICON_W / 2;
	cy = D1PanelTop() + D1_SPLICON_Y - D1_SPLICON_W / 2;
	for (i = 0; i < n; i++)
	{
		s = d1_splring_id[i];
		icon = d1_sp_icon[s];
		if (icon < 1)
			icon = D1_SPLICON_NUL;
		ang = (i * 16) / n;
		ox = (d1_fx_cos[ang & 15] * 80) / 1024;
		oy = (d1_fx_sin[ang & 15] * 80) / 1024;
		ix = cx + ox - D1_SPLICON_W / 2;
		iy = cy + oy - D1_SPLICON_W / 2;
		D1SpellTransSet(D1_SPT_SPELL);
		D1CelDrawTrans(ix, iy, d1_splicon_cel, icon, D1_SPLICON_W,
			d1_spl_trans);
	}
}

Bool D1SpellRingClick(I64 mx, I64 my)
{
	I64 i;
	I64 n;
	I64 ang;
	I64 ox;
	I64 oy;
	I64 ix;
	I64 iy;
	I64 cx;
	I64 cy;
	I64 s;

	if (!d1_splring || d1_splring_n <= 0)
		return FALSE;
	n  = d1_splring_n;
	cx = D1UiOrgX() + D1_SPLICON_X + D1_SPLICON_W / 2;
	cy = D1PanelTop() + D1_SPLICON_Y - D1_SPLICON_W / 2;
	for (i = 0; i < n; i++)
	{
		ang = (i * 16) / n;
		ox = (d1_fx_cos[ang & 15] * 80) / 1024;
		oy = (d1_fx_sin[ang & 15] * 80) / 1024;
		ix = cx + ox - D1_SPLICON_W / 2;
		iy = cy + oy - D1_SPLICON_W / 2;
		if (mx >= ix && mx < ix + D1_SPLICON_W &&
			my >= iy && my < iy + D1_SPLICON_W)
		{
			s = d1_splring_id[i];
			d1_spell_active = s;
			d1_spell_type   = D1RSP_SPELL;
			d1_splring = FALSE;
			return TRUE;
		}
	}
	d1_splring = FALSE;
	return TRUE;
}

U0 D1SpellSelect(I64 idx)
{
	if (idx >= 0 && idx < D1_NSPELL && D1SpellKnown(idx))
	{
		d1_spell_active = idx;
		d1_spell_type   = D1RSP_SPELL;
	}
}


I64 D1StaffSpell()
{//items.cpp CalcPlrStaff: the left-hand staff's spell, exposed only while it
 //still holds charges. -1 = the hand carries no castable staff.
	I64 itm = d1_equip_itm[D1EQ_LEFT];
	CD1ItmSt *st = &d1_st_equip[D1EQ_LEFT];

	if (!D1ItmIsStaff(itm))
		return -1;
	if (!D1PowSlotOk(D1EQ_LEFT))
		return -1;
	if (st->spl <= 0 || st->chg <= 0)
		return -1;
	if (st->spl - 1 >= D1_NSPELL)
		return -1;
	return st->spl - 1;
}

Bool D1StaffUse()
{//inv.cpp UseStaff: the selection is castable while the staff still offers it
	if (d1_spell_type != D1RSP_CHARGES)
		return FALSE;
	return ToBool(D1StaffSpell() == d1_spell_active && d1_spell_active >= 0);
}

U0 D1StaffCharge()
{//inv.cpp UseStaffCharge, then CalcPlrStaff through D1SpellReconcile
	if (!D1StaffUse())
		return;
	d1_st_equip[D1EQ_LEFT].chg--;
}

U0 D1StaffRoll(I64 lvl, I64 *sp, I64 *ch)
{//items.cpp GetStaffSpell.
	I64 l = lvl >> 1;
	I64 rv;
	I64 s  = 0;
	I64 bs = -1;
	I64 minc;
	I64 maxc;
	I64 guard = 0;

	*sp = -1;
	*ch = 0;
	if (l < 1)
		l = 1;
	rv = D1Rnd(D1_NSPELL) + 1;

	while (rv > 0 && guard < 4 * D1_NSPELL)
	{
		if (d1_sp_stafflvl[s] != -1 && l >= d1_sp_stafflvl[s])
		{
			rv--;
			bs = s;
		}
		s++;
		if (s == D1_NSPELL)
			s = 0;
		guard++;
	}
	if (bs < 0)
		return;

	minc = d1_sp_staffmin[bs];
	maxc = d1_sp_staffmax[bs] - minc + 1;
	*sp  = bs;
	*ch  = minc + D1Rnd(maxc);
}

U0 D1SpellReconcile()
{//items.cpp CalcPlrItemVals
	if (d1_spell_type != D1RSP_CHARGES)
		return;
	if (D1StaffSpell() != d1_spell_active)
	{
		d1_spell_active = -1;
		d1_spell_type   = D1RSP_SPELL;
	}
}

U0 D1SpellEquipped(I64 slot)
{//inv.cpp CheckInvPaste
	I64 s;

	if (slot != D1EQ_LEFT)
		return;
	s = D1StaffSpell();
	if (s >= 0)
	{
		d1_spell_active = s;
		d1_spell_type   = D1RSP_CHARGES;
	}
	D1SpellReconcile;
}

U8 *D1SpellNameOf(I64 s)
{
	if (s < 0 || s >= D1_NSPELL)
		return "";
	return d1_sp_name[s];
}

I64 D1SpellFind(U8 *name)
{
	I64 i;
	I64 r = -1;

	for (i = 0; i < D1_NSPELL; i++)
	{
		if (r < 0 && D1ItmNameEq(d1_sp_name[i], name))
			r = i;
	}
	return r;
}

I64 D1SpellStaffCost(I64 s)
{
	if (s < 0 || s >= D1_NSPELL)
		return 0;
	return d1_sp_staffcost[s];
}


U0 D1SpellFxClearKind(I64 kind)
{
	I64 i;

	for (i = 0; i < D1_FXMAX; i++)
	{
		if (d1_fx[i].active && d1_fx[i].kind == kind)
			d1_fx[i].active = FALSE;
	}
}

U0 D1SpellWave(I64 tx, I64 ty)
{
	I64 dx = tx - d1_plr_x;
	I64 dy = ty - d1_plr_y;
	I64 dir = D1GetDir(dx, dy);
	I64 px;
	I64 py;
	I64 i;
	I64 j;
	I64 x;
	I64 y;

	px = -d1_dir_dy[dir];
	py = d1_dir_dx[dir];
	for (i = 1; i <= 8; i++)
	{
		for (j = -1; j <= 1; j++)
		{
			x = d1_plr_x + d1_dir_dx[dir] * i + px * j;
			y = d1_plr_y + d1_dir_dy[dir] * i + py * j;
			if (D1Walkable(x, y))
				D1FxAdd(D1FX_FLAME, x, y, 0, 0, 24,
					D1SpellRollDam(D1SP_WAVE), 214);
		}
	}
}

U0 D1SpellApocalypse()
{
	I64 i;
	I64 dx;
	I64 dy;
	I64 rad = 6 + (d1_sp_lvl[D1SP_APOCALYPSE] >> 1);
	I64 dmg;

	dmg = D1SpellRollDam(D1SP_APOCALYPSE);
	for (i = 0; i < d1_nmons; i++)
	{
		if (d1_mons[i].active && d1_mons[i].mode != D1MM_DEAD)
		{
			dx = d1_mons[i].x - d1_plr_x;
			dy = d1_mons[i].y - d1_plr_y;
			if (dx < 0)
				dx = -dx;
			if (dy < 0)
				dy = -dy;
			if (dx <= rad && dy <= rad)
			{
				D1MonHurtType(i, dmg, D1RES_MAGIC);
				D1FxAdd(D1FX_BURST, d1_mons[i].x, d1_mons[i].y, 0, 0, 8, 0,
					160);
			}
		}
	}
}

U0 D1SpellGuardian(I64 tx, I64 ty)
{
	D1SpellFxClearKind(D1FX_GUARDIAN);
	if (!D1Walkable(tx, ty))
	{
		tx = d1_plr_x;
		ty = d1_plr_y;
	}
	D1FxAdd(D1FX_GUARDIAN, tx, ty, 0, 0, 200 + d1_sp_lvl[D1SP_GUARDIAN] * 40,
		D1SpellRollDam(D1SP_GUARDIAN), 192);
}

U0 D1SpellGolem(I64 tx, I64 ty)
{
	D1SpellFxClearKind(D1FX_GOLEM);
	if (!D1Walkable(tx, ty))
	{
		tx = d1_plr_x + 1;
		ty = d1_plr_y;
	}
	D1FxAdd(D1FX_GOLEM, tx, ty, 0, 0, 300 + d1_sp_lvl[D1SP_GOLEM] * 40,
		D1SpellRollDam(D1SP_GOLEM), 148);
}

U0 D1SpellHealOther(I64 tx, I64 ty)
{
	I64 i;
	I64 amt;
	I64 k;
	CD1Peer *p;

	amt = (D1Rnd(10) + 1) << 6;
	for (k = 0; k < d1_plr_lvl; k++)
		amt += (D1Rnd(4) + 1) << 6;
	for (k = 0; k < d1_sp_lvl[D1SP_HEALOTHER]; k++)
		amt += (D1Rnd(6) + 1) << 6;
	for (i = 0; i < D1_MAXPEER; i++)
	{
		p = &d1_peers[i];
		if (p->used && !p->local && !p->dead && p->x == tx && p->y == ty)
		{
			p->hp += amt;
			if (p->hp > p->maxhp)
				p->hp = p->maxhp;
			D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 8, 0, 192);
			return;
		}
	}
	D1SpellHealSelf;
	D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 192);
}

U0 D1SpellResurrect(I64 tx, I64 ty)
{
	I64 i;
	CD1Peer *p;

	for (i = 0; i < D1_MAXPEER; i++)
	{
		p = &d1_peers[i];
		if (p->used && !p->local && p->dead && p->x == tx && p->y == ty)
		{
			p->dead = FALSE;
			p->hp = p->maxhp >> 1;
			if (p->hp < 1)
				p->hp = 1;
			D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 10, 0, 224);
			return;
		}
	}
	D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 6, 0, 128);
}

U0 D1SpellTelekinesis(I64 tx, I64 ty)
{
	if (D1ItemPickup(tx, ty))
	{
		D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, tx, ty, 6, 0, 176);
		return;
	}
	if (D1ObjOperate(tx, ty, d1_currlevel))
	{
		D1FxAdd(D1FX_BOLT, d1_plr_x, d1_plr_y, tx, ty, 6, 0, 176);
		return;
	}
	D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 6, 0, 128);
}

U0 D1SpellDisarm(I64 tx, I64 ty)
{
	I64 oi = d1_dobj[tx + ty * D1_MAXDUN];
	CD1Obj *o;

	if (!oi)
		return;
	o = &d1_objs[oi - 1];
	if (!o->active || o->opened)
		return;
	if (o->trapped)
	{
		o->trapped = FALSE;
		D1FxAdd(D1FX_BURST, tx, ty, 0, 0, 8, 0, 176);
	}
}

Bool D1SpellCursApply(I64 inv_e, I64 eq_s)
{
	CD1ItmSt *st;
	I64 itm;

	if (d1_spell_curs == D1SC_NONE)
		return FALSE;
	if (inv_e < 0 && eq_s < 0)
		return TRUE;
	if (inv_e >= 0)
	{
		if (inv_e >= D1_MAXINV || d1_inv_itm[inv_e] < 0)
			return TRUE;
		st = &d1_st_inv[inv_e];
		itm = d1_inv_itm[inv_e];
	}
	else
	{
		if (eq_s < 0 || eq_s >= D1EQ_N || d1_equip_itm[eq_s] < 0)
			return TRUE;
		st = &d1_st_equip[eq_s];
		itm = d1_equip_itm[eq_s];
	}
	if (d1_spell_curs == D1SC_IDENTIFY)
	{
		st->ident = TRUE;
		d1_spell_curs = D1SC_NONE;
	}
	else if (d1_spell_curs == D1SC_REPAIR)
	{
		if (st->maxdur > 0)
		{
			st->dur = st->maxdur;
			d1_spell_curs = D1SC_NONE;
		}
	}
	else if (d1_spell_curs == D1SC_RECHARGE)
	{
		if (D1ItmIsStaff(itm) && st->maxchg > 0)
		{
			st->chg = st->maxchg;
			d1_spell_curs = D1SC_NONE;
		}
	}
	return TRUE;
}

Bool D1SpellTownOk(I64 s)
{
	if (d1_currlevel != 0)
		return TRUE;
	return s == D1SP_HEAL || s == D1SP_IDENTIFY ||
		s == D1SP_REPAIR || s == D1SP_RECHARGE ||
		s == D1SP_HEALOTHER;
}

U0 D1SpellCast(I64 tx, I64 ty)
{
	I64 s    = d1_spell_active;
	I64 cost = 0;
	I64 dmg;
	I64 mi;
	I64 hploss;
	I64 take;
	Bool acted;
	U8	sfx[32];

	if (!d1_play_ready || d1_plr_dead)
		return;
	if (s < 0 || s >= D1_NSPELL)
		return;
	if (s == D1SP_TOWN && d1_currlevel == 0)
		return;
	if (!D1SpellTownOk(s))
	{//CheckPlrSpell's town refusal (player.cpp:4326)
		if (d1_opt_sfx)
		{
			if (d1_plr_class == 1)
				D1SndPlay("Sfx\\Rogue\\Rogue27.wav");
			else if (d1_plr_class == 2)
				D1SndPlay("Sfx\\Sorceror\\Mage27.wav");
			else
				D1SndPlay("Sfx\\Warrior\\Warior27.wav");
		}
		return;
	}

	if (!Bt(kbd.down_bitmap, SC_SHIFT))
	{
		mi = D1MonAtCurs(tx, ty);
		if (mi >= 0)
		{
			tx = d1_mons[mi].x;
			ty = d1_mons[mi].y;
		}
	}

	if (d1_spell_type == D1RSP_CHARGES)
	{
		if (!D1StaffUse())
			return;
	}
	else
	{
		if (!D1SpellKnown(s))
			return;
		cost = D1SpellMana(s);
		if (d1_plr_mana < cost)
			return;
	}

	d1_plr_dir = D1GetDir(tx - d1_plr_x, ty - d1_plr_y);
	acted = TRUE;

	if (s == D1SP_FIREBOLT)
	{
		dmg = D1SpellRollDam(D1SP_FIREBOLT);
		D1MisSpawn(D1MIS_FIREBOLT, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	}
	else if (s == D1SP_HEAL)
	{
		D1SpellHealSelf;
		D1FxAdd(D1FX_BURST, d1_plr_x, d1_plr_y, 0, 0, 8, 0, 192);
	}
	else if (s == D1SP_LIGHTNING)
		D1SpellBoltLine(tx, ty);
	else if (s == D1SP_FLASH)
		D1SpellFlash;
	else if (s == D1SP_FIREWALL)
		D1SpellFireWall(tx, ty);
	else if (s == D1SP_CHAIN)
		D1SpellChain(tx, ty);
	else if (s == D1SP_CBOLT)
		D1SpellChargedBolt(tx, ty);
	else if (s == D1SP_HBOLT)
	{
		dmg = D1SpellRollDam(D1SP_HBOLT);
		D1MisSpawn(D1MIS_HOLY, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	}
	else if (s == D1SP_INFERNO)
		D1SpellInferno(tx, ty);
	else if (s == D1SP_TOWN)
		acted = D1SpellTownPortal(tx, ty);
	else if (s == D1SP_STONE)
		acted = D1SpellStone(tx, ty);
	else if (s == D1SP_PHASING)
		acted = D1SpellPhase();
	else if (s == D1SP_MANASHIELD)
	{
		if (d1_manashield)
		{
			d1_manashield = FALSE;
			acted = FALSE;
		}
		else
		{
			d1_manashield = TRUE;
			//D1Mon compiles first and reads this for the 2/3 drain rule
			d1_mshield_lvl = d1_sp_lvl[D1SP_MANASHIELD] - 1;
		}
	}
	else if (s == D1SP_ELEMENT)
	{
		dmg = D1SpellRollDam(D1SP_ELEMENT);
		D1MisSpawn(D1MIS_ELEMENT, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	}
	else if (s == D1SP_FIREBALL)
	{
		dmg = D1SpellRollDam(D1SP_FIREBALL);
		D1MisSpawn(D1MIS_FIREBALL, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
	}
	else if (s == D1SP_NOVA)
		D1SpellNova;
	else if (s == D1SP_TELEPORT)
		acted = D1SpellTeleport(tx, ty);
	else if (s == D1SP_BONESPIRIT)
	{
		D1MisSpawn(D1MIS_BONESPIRIT, -1, d1_plr_x, d1_plr_y, tx, ty, 0);
	}
	else if (s == D1SP_BLOODSTAR)
	{
		dmg = D1SpellRollDam(D1SP_BLOODSTAR);
		D1MisSpawn(D1MIS_FLARE, -1, d1_plr_x, d1_plr_y, tx, ty, dmg);
		hploss = 320;
		if (d1_manashield)
		{
			take = hploss;
			if (take > d1_plr_mana)
				take = d1_plr_mana;
			d1_plr_mana -= take;
			hploss -= take;
			if (d1_plr_mana <= 0)
			{
				d1_plr_mana   = 0;
				d1_manashield = FALSE;
			}
		}
		d1_plr_hp -= hploss;
		d1_plr_hitflash = 4;
		if (d1_plr_hp <= 0)
		{
			d1_plr_hp   = 0;
			d1_plr_dead = TRUE;
		}
	}
	else if (s == D1SP_IDENTIFY)
		d1_spell_curs = D1SC_IDENTIFY;
	else if (s == D1SP_REPAIR)
		d1_spell_curs = D1SC_REPAIR;
	else if (s == D1SP_RECHARGE)
		d1_spell_curs = D1SC_RECHARGE;
	else if (s == D1SP_DISARM)
		D1SpellDisarm(tx, ty);
	else if (s == D1SP_INFRA)
		d1_infra_ticks = 200 + d1_sp_lvl[D1SP_INFRA] * 40;
	else if (s == D1SP_WAVE)
		D1SpellWave(tx, ty);
	else if (s == D1SP_GUARDIAN)
		D1SpellGuardian(tx, ty);
	else if (s == D1SP_GOLEM)
		D1SpellGolem(tx, ty);
	else if (s == D1SP_APOCALYPSE)
		D1SpellApocalypse;
	else if (s == D1SP_ETHEREALIZE)
		d1_ethereal_ticks = 40 + d1_sp_lvl[D1SP_ETHEREALIZE] * 20;
	else if (s == D1SP_RESURRECT)
		D1SpellResurrect(tx, ty);
	else if (s == D1SP_HEALOTHER)
		D1SpellHealOther(tx, ty);
	else if (s == D1SP_TELEKINESIS)
		D1SpellTelekinesis(tx, ty);

	if (!acted)
		return;

	if (d1_spell_type == D1RSP_CHARGES)
		D1StaffCharge;
	else
		d1_plr_mana -= cost;

	if (d1_opt_sfx)
	{
		StrPrint(sfx, "Sfx\\Misc\\Cast%d.wav", d1_sp_sfx[s]);
		D1SndPlay(sfx);
	}
}

U0 D1SpellPortalTick()
{
	if (!d1_portal_up)
		return;

	d1_portal_frame++;
	if (d1_portal_grace > 0)
	{
		d1_portal_grace--;
		return;
	}

	if (d1_currlevel == 0)
	{
		if (d1_plr_tile_x == d1_portal_tx && d1_plr_tile_y == d1_portal_ty)
		{
			d1_warp_to      = d1_portal_lvl;
			d1_warp_entry   = 0;
			d1_portal_grace = 40;
		}
	}
	else if (d1_currlevel == d1_portal_lvl)
	{
		if (d1_plr_tile_x == d1_portal_x && d1_plr_tile_y == d1_portal_y)
		{
			d1_warp_to      = 0;
			d1_warp_entry   = 0;
			d1_portal_grace = 40;
		}
	}
}

U0 D1SpellTick()
{//20Hz, alongside D1MisTick
	CD1Fx *f;
	I64	 i;
	I64	 mi;
	I64	 j;
	I64	 best;
	I64	 bdist;
	I64	 dx;
	I64	 dy;
	I64	 dist;
	I64	 nx;
	I64	 ny;
	I64	 dir;

	if (!d1_fx_init)
		D1SpellFxClear;

	D1SpellReconcile;
	D1SpellPortalTick;

	if (d1_infra_ticks > 0)
	{
		d1_infra_ticks--;
		if (d1_map_mark)
		{
			(*d1_map_mark)(d1_plr_x, d1_plr_y);
			(*d1_map_mark)(d1_plr_x + 8, d1_plr_y);
			(*d1_map_mark)(d1_plr_x - 8, d1_plr_y);
			(*d1_map_mark)(d1_plr_x, d1_plr_y + 8);
			(*d1_map_mark)(d1_plr_x, d1_plr_y - 8);
		}
	}
	if (d1_ethereal_ticks > 0)
		d1_ethereal_ticks--;

	for (i = 0; i < D1_FXMAX; i++)
	{
		f = &d1_fx[i];
		if (f->active)
		{
			f->age++;
			f->timer--;
			if ((f->kind == D1FX_FLAME || f->kind == D1FX_FIREWALL) &&
				!(f->age & 3))
			{
				mi = D1MonAtTile(f->x0, f->y0);
				if (mi >= 0 && D1MisSpellHit(mi, 0))
					D1MonHurtType(mi, f->dmg, D1RES_FIRE);
				if (f->kind == D1FX_FIREWALL &&
					f->x0 == d1_plr_tile_x && f->y0 == d1_plr_tile_y)
					D1PlrHurt(f->dmg);
			}
			if (f->kind == D1FX_FLASH)
			{
				for (j = 0; j < 6; j++)
				{
					mi = D1MonAtTile(f->x0 + d1_flash_dx[j],
						f->y0 + d1_flash_dy[j]);
					if (mi >= 0 && D1MisSpellHit(mi, 0))
						D1MonHurtType(mi, f->dmg, D1RES_LIGHTNING);
				}
			}
			if (f->kind == D1FX_GUARDIAN && !(f->age & 7))
			{
				best = -1;
				bdist = 99;
				for (j = 0; j < d1_nmons; j++)
				{
					if (d1_mons[j].active && d1_mons[j].mode != D1MM_DEAD)
					{
						dx = d1_mons[j].x - f->x0;
						dy = d1_mons[j].y - f->y0;
						if (dx < 0)
							dx = -dx;
						if (dy < 0)
							dy = -dy;
						dist = dx + dy;
						if (dist < bdist && dist <= 6)
						{
							bdist = dist;
							best = j;
						}
					}
				}
					if (best >= 0)
						D1MisSpawn(D1MIS_FIREBOLT, -1, f->x0, f->y0,
							d1_mons[best].x, d1_mons[best].y, f->dmg);
			}
			if (f->kind == D1FX_GOLEM && !(f->age & 3))
			{
				best = -1;
				bdist = 99;
				for (j = 0; j < d1_nmons; j++)
				{
					if (d1_mons[j].active && d1_mons[j].mode != D1MM_DEAD)
					{
						dx = d1_mons[j].x - f->x0;
						dy = d1_mons[j].y - f->y0;
						if (dx < 0)
							dx = -dx;
						if (dy < 0)
							dy = -dy;
						dist = dx + dy;
						if (dist < bdist)
						{
							bdist = dist;
							best = j;
						}
					}
				}
				if (best >= 0)
				{
					if (bdist <= 1)
						D1MonHurtType(best, f->dmg, D1RES_NONE);
					else
					{
						dir = D1GetDir(d1_mons[best].x - f->x0,
							d1_mons[best].y - f->y0);
						nx = f->x0 + d1_dir_dx[dir];
						ny = f->y0 + d1_dir_dy[dir];
						if (D1Walkable(nx, ny) && D1MonAtTile(nx, ny) < 0)
						{
							f->x0 = nx;
							f->y0 = ny;
						}
					}
				}
			}
			if (f->timer <= 0)
				f->active = FALSE;
		}
	}
}


U0 D1SpellTileScreen(I64 tx, I64 ty, I64 *sx, I64 *sy)
{//same transform D1MisDrawAll uses, tile center in 64ths
	I64 rx = tx * 64 + 32 - d1_view_x * 64 - 32;
	I64 ry = ty * 64 + 32 - d1_view_y * 64 - 32;

	*sx = d1_w / 2 + ((rx - ry) * 32) / 64 - d1_view_xoff;
	*sy = d1_vp_h / 2 + ((rx + ry) * 16) / 64 - d1_view_yoff + 16;
}

U0 D1SpellPix(I64 x, I64 y, I64 color)
{
	if (y >= 0 && y < d1_vp_h)
		D1Pix(x, y, color);
}

U0 D1SpellLine(I64 x0, I64 y0, I64 x1, I64 y1, I64 color)
{
	I64 dx = x1 - x0;
	I64 dy = y1 - y0;
	I64 sx = 1;
	I64 sy = 1;
	I64 err;
	I64 e2;
	I64 guard = 0;

	if (dx < 0)
	{
		dx = -dx;
		sx = -1;
	}
	if (dy < 0)
	{
		dy = -dy;
		sy = -1;
	}
	err = dx - dy;

	while (guard < 4096)
	{
		D1SpellPix(x0, y0, color);
		D1SpellPix(x0, y0 - 1, color);
		if (x0 == x1 && y0 == y1)
			guard = 4096;
		else
		{
			e2 = err * 2;
			if (e2 > -dy)
			{
				err -= dy;
				x0  += sx;
			}
			if (e2 < dx)
			{
				err += dx;
				y0  += sy;
			}
			guard++;
		}
	}
}

U0 D1SpellPortalDraw()
{
	I64 px = -1;
	I64 py = 0;
	I64 sx;
	I64 sy;
	I64 f;

	if (!d1_portal_up || !d1_portal_cel)
		return;

	if (d1_currlevel == 0)
	{
		px = d1_portal_tx;
		py = d1_portal_ty;
	}
	else if (d1_currlevel == d1_portal_lvl)
	{
		px = d1_portal_x;
		py = d1_portal_y;
	}
	if (px < 0)
		return;

	D1SpellTileScreen(px, py, &sx, &sy);
	f = d1_portal_frame % D1CelNFrames(d1_portal_cel) + 1;
	D1Cl2Draw(sx - 48, sy, d1_portal_cel, f, 96);
}

U0 D1SpellFxDraw()
{
	CD1Fx *f;
	I64	 i;
	I64	 a;
	I64	 x0;
	I64	 y0;
	I64	 x1;
	I64	 y1;
	I64	 r;
	I64	 t;
	I64	 px;
	I64	 py;

	D1SpellPortalDraw;

	if (!d1_fx_init)
		return;

	for (i = 0; i < D1_FXMAX; i++)
	{
		f = &d1_fx[i];
		if (f->active)
		{
			D1SpellTileScreen(f->x0, f->y0, &x0, &y0);
			if (f->kind == D1FX_BOLT)
			{
				D1SpellTileScreen(f->x1, f->y1, &x1, &y1);
				D1SpellLine(x0, y0, x1, y1, f->color);
				D1SpellLine(x0, y0 - 2, x1, y1 - 2, 255);
			}
			else if (f->kind == D1FX_BURST)
			{
				r = f->age * 6;
				for (a = 0; a < 16; a++)
				{//ring on the tile grid: 2:1 screen aspect
					px = x0 + (r * d1_fx_cos[a]) / 1024;
					py = y0 + (r * d1_fx_sin[a]) / 2048;
					D1SpellPix(px, py, f->color);
					D1SpellPix(px, py - 1, 255);
					D1SpellPix(px + 1, py, f->color);
				}
			}
			else
			{
				r = 12 + (f->age & 3) * 2;
				if (f->kind == D1FX_GOLEM)
					r = 16;
				if (f->kind == D1FX_GUARDIAN)
					r = 10 + (f->age & 1) * 2;
				for (a = -r; a <= r; a++)
				{
					t = a;
					if (t < 0)
						t = -t;
					t = (r - t) / 2;
					for (py = y0 - t; py <= y0 + t; py++)
						D1SpellPix(x0 + a, py, f->color - (py & 1) * 6);
				}
			}
		}
	}
}


U0 D1SpellToggle()
{
	I64 size = 0;

	if (!d1_sbk_cel)
		d1_sbk_cel = D1MpqRead("Data\\SpellBk.CEL", &size);
	if (!d1_sbk_btn)
		d1_sbk_btn = D1MpqRead("Data\\SpellBkB.CEL", &size);
	if (!d1_sbk_icon)
		d1_sbk_icon = D1MpqRead("Data\\SpellI2.CEL", &size);
	d1_spell_open = !d1_spell_open;
}

U0 D1SpellDraw()
{//DrawSpellBook (control.cpp:2490): rows every 43px from baseline 55,
 //icon at RIGHT_PANEL_X + 11 width 37, text at RIGHT_PANEL_X + 66
	I64 i;
	I64 sn;
	I64 yp;
	I64 tx;
	I64 mind;
	I64 maxd;
	I64 ox = D1UiOrgX() + D1_SBK_X;
	I64 uy = D1UiOrgY();

	if (!d1_spell_open || !d1_sbk_cel)
		return;

	D1CelDraw(ox, uy + 351, d1_sbk_cel, 1, 320);
	if (d1_sbk_btn)
		D1CelDraw(ox + 76 * d1_spell_page + 7, uy + 348, d1_sbk_btn,
			d1_spell_page + 1, 76);

	tx = ox + 66;
	yp = uy + 55;
	for (i = 0; i < 7; i++)
	{
		sn = d1_sp_pages[d1_spell_page * 7 + i];
		if (sn >= 0 && D1SpellKnown(sn))
		{
			if (d1_sbk_icon)
				D1CelDraw(ox + 11, yp, d1_sbk_icon, d1_sp_icon[sn], 37);
			if (sn == d1_spell_active && d1_sbk_icon)
				D1CelDraw(ox + 11, yp, d1_sbk_icon, 43, 37);

			D1TextDrawClr(tx, yp - 23, d1_sp_name[sn], D1COL_WHITE);

			D1SpellDamRange(sn, &mind, &maxd);
			if (mind < 0)
				StrPrint(d1_sbk_txt, "Mana: %d   Dam: n/a",
					D1SpellMana(sn) >> 6);
			else
				StrPrint(d1_sbk_txt, "Mana: %d  Dam: %d - %d",
					D1SpellMana(sn) >> 6, mind, maxd);
			D1TextDrawClr(tx, yp - 12, d1_sbk_txt, D1COL_WHITE);

			StrPrint(d1_sbk_txt, "Spell Level %d", d1_sp_lvl[sn]);
			D1TextDrawClr(tx, yp - 1, d1_sbk_txt, D1COL_WHITE);
		}
		yp += 43;
	}
}

Bool D1SpellClick(I64 cx, I64 cy)
{//CheckSBook (control.cpp:2562). TRUE = consumed.
	I64 row;
	I64 sn;

	if (!d1_spell_open)
		return FALSE;
	cx -= D1UiOrgX();
	cy -= D1UiOrgY();
	if (cx < D1_SBK_X || cy < 0 || cy > 351)
		return FALSE;

	if (cx >= D1_SBK_X + 11 && cx < D1_SBK_X + 48 && cy >= 18 && cy < 314)
	{
		row = (cy - 18) / 43;
		sn  = d1_sp_pages[d1_spell_page * 7 + row];
		if (sn >= 0 && D1SpellKnown(sn))
		{
			d1_spell_active = sn;
			d1_spell_type   = D1RSP_SPELL;
		}
	}
	if (cx >= D1_SBK_X + 7 && cx < D1_SBK_X + 311 && cy >= 320 && cy < 349)
	{
		row = (cx - (D1_SBK_X + 7)) / 76;
		if (row >= 0 && row < 5)
			d1_spell_page = row;
	}
	return TRUE;
}


I64 D1SpellPanelIcon()
{
	if (d1_spell_active < 0 || d1_spell_active >= D1_NSPELL)
		return D1_SPLICON_NUL;
	return d1_sp_icon[d1_spell_active];
}

I64 D1SpellPanelTrans()
{//control.cpp DrawSpell: the SetSpellTrans ramp the icon is drawn through.
	I64 s = d1_spell_active;

	if (s < 0 || s >= D1_NSPELL)
		return D1_SPT_NONE;
	if (s == D1SP_TOWN && d1_currlevel == 0)
		return D1_SPT_NONE;
	if (!D1SpellTownOk(s))
		return D1_SPT_NONE;
	if (d1_spell_type == D1RSP_CHARGES)
	{
		if (!D1StaffUse())
			return D1_SPT_NONE;
		return D1_SPT_CHARGES;
	}
	if (!D1SpellKnown(s))
		return D1_SPT_NONE;
	if (d1_plr_mana < D1SpellMana(s))
		return D1_SPT_NONE;
	return D1_SPT_SPELL;
}

U0 D1WorldOverlayDraw()
{
	D1SpellFxDraw;
}

U0 D1SpellPanelInstall()
{
	I64 i;

	for (i = 0; i < D1_NSPELL; i++)
		d1_sp_lvl[i] = 0;
	d1_spell_active = -1;
	d1_spell_curs = D1SC_NONE;
	d1_infra_ticks = 0;
	d1_ethereal_ticks = 0;
	d1_panel_spicon  = &D1SpellPanelIcon;
	d1_panel_sptrans = &D1SpellPanelTrans;
	d1_panel_splring_draw   = &D1SpellRingDraw;
	d1_panel_splring_click  = &D1SpellRingClick;
	d1_panel_splring_toggle = &D1SpellRingToggle;
	d1_spl_name      = &D1SpellNameOf;
	d1_spl_find      = &D1SpellFind;
	d1_spl_cost      = &D1SpellStaffCost;
	d1_spl_staff     = &D1StaffRoll;
	d1_spl_book      = &D1SpellLearn;
	d1_spl_curs      = &D1SpellCursApply;
	d1_itm_extra     = &D1SpellBooksInit;
	d1_pow_equipped  = &D1SpellEquipped;
	d1_world_overlay_cb = &D1WorldOverlayDraw;
}

D1SpellPanelInstall;
