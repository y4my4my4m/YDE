// D1Menu.ZC - title screen, DiabloUI main menu, options, cut screens
//
// DiabloUI art is PCX with the palette in the file tail; index 250 is the
// transparent key. artfonts: fontNN.bin = 2 header bytes (pad, glyph
// height) + 256 glyph widths; fontNNg.pcx = a 256-cell vertical strip,
// cell = strip_width x glyph height. smlogo.pcx = 15 stacked 390x154
// flame-logo frames. focus42.pcx = 8 stacked 42x42 pentagram frames.
//
// menu items use font42 gold; option values font24. the shell drives
// keys/clicks through D1MenuCount/D1MenuActivate/D1MenuClick.
//
// every art file here is 640x480 or narrower and every coordinate is
// panel-local: draws add D1UiOrgX(), D1MenuHitTest subtracts it.
//
// options do not persist across runs; the port has no settings file.

#define D1UI_TRANS	250

U8	*d1_title_img = NULL;
I64	 d1_title_w   = 0;
I64	 d1_title_h   = 0;
U8	 d1_title_pal[768];

U8	*d1_mmenu_img = NULL;
I64	 d1_mmenu_w   = 0;
I64	 d1_mmenu_h   = 0;
U8	 d1_mmenu_pal[768];

U8	*d1_pentspin  = NULL;		//Data\PentSpin.CEL, in-game spinner
U8	*d1_smlogo    = NULL;		//15 frames, 390x154
U8	*d1_focus42   = NULL;		//8 frames, 42x42
U8	*d1_ui_cursor = NULL;		//ui_art cursor, 36x30, key 0

//artfonts
U8	*d1_font42_px = NULL;		//glyph strip pixels
I64	 d1_font42_w  = 0;
I64	 d1_font42_h  = 0;			//glyph height
U8	 d1_font42_wd[256];
I64	 d1_font42_sp = 24;
U8	*d1_font24_px = NULL;
I64	 d1_font24_w  = 0;
I64	 d1_font24_h  = 0;
U8	 d1_font24_wd[256];
I64	 d1_font24_sp = 13;

I64	 d1_menu_screen = 0;		//0 = main, 1 = options

Bool D1UiFontLoad(U8 *bin_name, U8 *pcx_name, U8 **px, I64 *strip_w,
	I64 *glyph_h, U8 *widths, I64 *space_w)
{//bin: default width, glyph height, then 256 widths (0 = use default)
	I64	 size = 0;
	U8	*bin  = D1MpqRead(bin_name, &size);
	I64	 w;
	I64	 h;

	if (!bin || size < 258)
	{
		if (bin)
			Free(bin);
		return FALSE;
	}
	*space_w = bin[0];
	*glyph_h = bin[1];
	MemCopy(widths, bin + 2, 256);
	Free(bin);

	*px = D1PcxRead(pcx_name, &w, &h, NULL);
	if (!*px)
		return FALSE;
	*strip_w = w;
	return TRUE;
}

U0 D1UiGlyphDraw(I64 sx, I64 sy, U8 *px, I64 strip_w, I64 glyph_h, I64 c,
	I64 w)
{//top-left anchor, key 250 transparent
	I64 x;
	I64 y;
	I64 v;

	for (y = 0; y < glyph_h; y++)
		for (x = 0; x < w; x++)
		{
			v = px[(c * glyph_h + y) * strip_w + x];
			//cells pad with 250 AND 32; 32 is near-black in the main menu
			//palette but brown elsewhere, so both are transparent
			if (v != D1UI_TRANS && v != 32)
				D1Pix(sx + x, sy + y, v);
		}
}

I64 D1UiTextWidth(U8 *widths, I64 space_w, U8 *str)
{
	I64 i = 0;
	I64 w = 0;
	I64 g;

	while (str[i])
	{
		g = widths[str[i]];
		if (!g)
			g = space_w;
		w += g;
		i++;
	}
	return w;
}

U0 D1UiTextDraw(I64 sx, I64 sy, U8 *px, I64 strip_w, I64 glyph_h,
	U8 *widths, I64 space_w, U8 *str)
{
	I64 i = 0;
	I64 g;

	if (!px)
		return;
	while (str[i])
	{
		g = widths[str[i]];
		if (g)
			D1UiGlyphDraw(sx, sy, px, strip_w, glyph_h, str[i], g);
		else
			g = space_w;
		sx += g;
		i++;
	}
}

U0 D1UiText42(I64 cx, I64 sy, U8 *str)
{//centered on cx
	D1UiTextDraw(cx - D1UiTextWidth(d1_font42_wd, d1_font42_sp, str) / 2, sy,
		d1_font42_px, d1_font42_w, d1_font42_h, d1_font42_wd, d1_font42_sp,
		str);
}

U0 D1UiText24(I64 cx, I64 sy, U8 *str)
{
	D1UiTextDraw(cx - D1UiTextWidth(d1_font24_wd, d1_font24_sp, str) / 2, sy,
		d1_font24_px, d1_font24_w, d1_font24_h, d1_font24_wd, d1_font24_sp,
		str);
}

Bool D1TitleLoad()
{
	if (!d1_title_img)
		d1_title_img = D1PcxRead("ui_art\\title.pcx", &d1_title_w,
			&d1_title_h, d1_title_pal);
	return d1_title_img != NULL;
}

Bool D1MMenuLoad()
{
	I64 w;
	I64 h;

	if (!d1_mmenu_img)
		d1_mmenu_img = D1PcxRead("ui_art\\mainmenu.pcx", &d1_mmenu_w,
			&d1_mmenu_h, d1_mmenu_pal);
	if (!d1_smlogo)
		d1_smlogo = D1PcxRead("ui_art\\smlogo.pcx", &w, &h, NULL);
	if (!d1_focus42)
		d1_focus42 = D1PcxRead("ui_art\\focus42.pcx", &w, &h, NULL);
	if (!d1_ui_cursor)
		d1_ui_cursor = D1PcxRead("ui_art\\cursor.pcx", &w, &h, NULL);
	if (!d1_font42_px)
		D1UiFontLoad("ui_art\\font42.bin", "ui_art\\font42g.pcx",
			&d1_font42_px, &d1_font42_w, &d1_font42_h, d1_font42_wd,
			&d1_font42_sp);
	if (!d1_font24_px)
		D1UiFontLoad("ui_art\\font24.bin", "ui_art\\font24g.pcx",
			&d1_font24_px, &d1_font24_w, &d1_font24_h, d1_font24_wd,
			&d1_font24_sp);
	return d1_mmenu_img != NULL;
}

U0 D1TitleDraw(I64 anim)
{
	I64 ox = D1UiOrgX();

	if (!d1_title_img)
		return;
	D1Clear(0);
	D1Blit8(ox, 0, d1_title_img, d1_title_w, d1_title_h);
	if (anim & 0x10)
		D1TextDrawSolid(ox + D1_UI_W / 2 -
			D1TextWidth("Press any key") / 2, 420,
			"Press any key", D1PalBrightest());
}

//menu item labels per screen
U8 *d1_mm_items[3]  = {"Single Player", "Options", "Quit Diablo"};
U8 *d1_opt_items[6] = {"Width", "Zoom", "Town Jog", "Sound Effects", "Music",
	"Previous Menu"};
#define D1_MENU_COUNT	3

//canvas widths the Width option cycles through
I64 d1_width_steps[4] = {640, 800, 1024, 1280};
U8	d1_opt_wtxt[16];

I64 D1MenuCount()
{
	if (d1_menu_screen == 0)
		return 3;
	return 6;
}

I64 D1MenuItemY(I64 i)
{//six option rows at a 52 pitch need a higher start than the three main ones
	if (d1_menu_screen == 1)
		return 150 + i * 52;
	return 192 + i * 52;
}

U0 D1WidthCycle()
{//next entry of d1_width_steps, wrapping
	I64 i;
	I64 next = d1_width_steps[0];

	for (i = 0; i < 4; i++)
	{
		if (d1_width_steps[i] > d1_w && next <= d1_w)
			next = d1_width_steps[i];
	}
	D1SetWidth(next);
}

U8 *D1OptValue(I64 i)
{
	Bool v = FALSE;

	if (i == 0)
	{
		StrPrint(d1_opt_wtxt, "%d", d1_w);
		return d1_opt_wtxt;
	}
	if (i == 1)
		v = d1_zoom;
	if (i == 2)
		v = d1_opt_jog;
	if (i == 3)
		v = d1_opt_sfx;
	if (i == 4)
		v = d1_opt_music;
	if (v)
		return "ON";
	return "OFF";
}

U0 D1MenuDraw(I64 sel, I64 anim)
{
	I64	 i;
	I64	 y;
	I64	 n = D1MenuCount();
	I64	 f;
	I64	 w;
	I64	 ox = D1UiOrgX();
	U8	*label;
	U8	 line[64];

	D1Clear(0);
	if (d1_mmenu_img)
		D1Blit8(ox, 0, d1_mmenu_img, d1_mmenu_w, d1_mmenu_h);

	//flame logo, 15 frames of 390x154, top center
	if (d1_smlogo)
		D1Blit8Key(ox + D1_UI_W / 2 - 195, 10,
			d1_smlogo + (anim % 15) * 390 * 154, 390, 154, D1UI_TRANS);

	for (i = 0; i < n; i++)
	{
		y = D1MenuItemY(i);
		label = d1_mm_items[i];
		if (d1_menu_screen == 1)
		{
			label = d1_opt_items[i];
			if (i < 5)
			{
				StrPrint(line, "%s: %s", label, D1OptValue(i));
				label = line;
			}
		}
		D1UiText42(ox + D1_UI_W / 2, y, label);

		if (i == sel && d1_focus42)
		{//pentagram spinners flank the selected line
			f = anim % 8;
			w = D1UiTextWidth(d1_font42_wd, d1_font42_sp, label);
			D1Blit8Key(ox + D1_UI_W / 2 - w / 2 - 58, y,
				d1_focus42 + f * 42 * 42, 42, 42, D1UI_TRANS);
			D1Blit8Key(ox + D1_UI_W / 2 + w / 2 + 16, y,
				d1_focus42 + f * 42 * 42, 42, 42, D1UI_TRANS);
		}
	}

	if (d1_menu_screen == 0)
		D1TextDrawSolid(ox + D1_UI_W / 2 -
			D1TextWidth("YDE port of Devilution - non-commercial") / 2, 466,
			"YDE port of Devilution - non-commercial", D1PalBrightest());
}

I64 D1MenuActivate(I64 sel)
{//0 handled, 1 = start game, 2 = quit app, 3 = back to title
	if (d1_menu_screen == 0)
	{
		if (sel == 0)
			return 1;
		if (sel == 1)
		{
			d1_menu_screen = 1;
			return 0;
		}
		return 2;
	}

	if (sel == 0)
		D1WidthCycle;
	if (sel == 1)
		d1_zoom = !d1_zoom;
	if (sel == 2)
		d1_opt_jog = !d1_opt_jog;
	if (sel == 3)
		d1_opt_sfx = !d1_opt_sfx;
	if (sel == 4)
	{
		d1_opt_music = !d1_opt_music;
		if (d1_opt_music)
			D1SndMusic("Music\\Dintro.wav");
		else
			D1SndMusic(NULL);
	}
	if (sel == 5)
		d1_menu_screen = 0;
	return 0;
}

I64 D1MenuHitTest(I64 cx, I64 cy)
{//item index under the cursor, -1 none
	I64 i;
	I64 y;
	I64 n = D1MenuCount();

	cx -= D1UiOrgX();
	if (cx < 100 || cx > 540)
		return -1;
	for (i = 0; i < n; i++)
	{
		y = D1MenuItemY(i);
		if (cy >= y && cy < y + 42)
			return i;
	}
	return -1;
}

U0 D1CutShow(U8 *cel_name, U8 *pal_name)
{//loading screen: swap palette and paint immediately
	I64	 size = 0;
	U8	*cel;

	if (pal_name)
		D1PalLoad(pal_name);

	cel = D1MpqRead(cel_name, &size);
	if (cel)
	{
		D1Clear(0);
		D1CelDraw(D1UiOrgX(), D1_H - 1, cel, 1, D1_UI_W);
		Free(cel);
	}
}
