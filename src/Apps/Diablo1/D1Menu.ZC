// D1Menu.ZC - title screen, main menu, cut screens
//
// DiabloUI art is PCX with its palette in the file tail. menu text uses the
// in-game small font instead of DiabloUI's artfonts - readable, but colored
// through whichever palette is live. cut screens are single-frame 640x480
// unclipped CELs with a sibling .pal.

U8	*d1_title_img = NULL;
I64	 d1_title_w   = 0;
I64	 d1_title_h   = 0;
U8	 d1_title_pal[768];

U8	*d1_mmenu_img = NULL;
I64	 d1_mmenu_w   = 0;
I64	 d1_mmenu_h   = 0;
U8	 d1_mmenu_pal[768];

U8	*d1_pentspin  = NULL;		//Data\PentSpin.CEL, 48x48 spinner

Bool D1TitleLoad()
{
	if (!d1_title_img)
		d1_title_img = D1PcxRead("ui_art\\title.pcx", &d1_title_w,
			&d1_title_h, d1_title_pal);
	return d1_title_img != NULL;
}

Bool D1MMenuLoad()
{
	if (!d1_mmenu_img)
		d1_mmenu_img = D1PcxRead("ui_art\\mainmenu.pcx", &d1_mmenu_w,
			&d1_mmenu_h, d1_mmenu_pal);
	return d1_mmenu_img != NULL;
}

U0 D1TitleDraw(I64 anim)
{
	if (!d1_title_img)
		return;
	D1Blit8(0, 0, d1_title_img, d1_title_w, d1_title_h);
	if (anim & 0x10)
		D1TextDrawSolid(D1_W / 2 - D1TextWidth("Press any key") / 2, 420,
			"Press any key", D1PalBrightest());
}

U8 *d1_menu_items[3] = {"New Game", "About", "Quit"};
#define D1_MENU_COUNT	3

U0 D1MenuDraw(I64 sel, I64 anim)
{
	I64 i;
	I64 y;
	I64 x;
	I64 bright = D1PalBrightest();

	no_warn anim;

	if (d1_mmenu_img)
		D1Blit8(0, 0, d1_mmenu_img, d1_mmenu_w, d1_mmenu_h);
	else
		D1Clear(0);

	for (i = 0; i < D1_MENU_COUNT; i++)
	{
		y = 300 + i * 30;
		x = D1_W / 2 - D1TextWidth(d1_menu_items[i]) / 2;
		D1TextDrawSolid(x, y, d1_menu_items[i], bright);

		if (i == sel)
		{
			D1TextDrawSolid(x - 24, y, "-", bright);
			D1TextDrawSolid(x + D1TextWidth(d1_menu_items[i]) + 12, y, "-",
				bright);
		}
	}
}

U0 D1CutShow(U8 *cel_name, U8 *pal_name)
{//loading screen: swap palette and paint immediately
	I64	 size = 0;
	U8	*cel;

	if (pal_name)
		D1PalLoad(pal_name);

	cel = D1MpqRead(cel_name, &size);
	if (cel)
	{
		D1Clear(0);
		D1CelDraw(0, D1_H - 1, cel, 1, D1_W);
		Free(cel);
	}
}
