// Diablo1.ZC - app shell: window, input, game loop
//
// rendering runs on this task; the blit runs in the draw_it callback on the
// window manager task and reads d1_screen through d1_argb (D1Draw).
//
// game logic ticks at 20Hz (the original's rate). level changes are
// requested by D1Play through d1_warp_to and performed here between
// frames, behind a cut screen.

#define D1ST_TITLE		0
#define D1ST_MENU		1
#define D1ST_GAME		2
#define D1ST_SEL		3		//character select / create

I64	 d1_state    = D1ST_TITLE;
I64	 d1_anim     = 0;
Bool d1_quit     = FALSE;
U8	*d1_cursor   = NULL;			//Data\Inv\Objcurs.CEL
F64	 d1_tick_t   = 0.0;
I64	 d1_fade     = 0;				//0..256 palette fade-in
Bool d1_k_belt[8];
Bool d1_k_zoom = FALSE;
Bool d1_k_inv  = FALSE;
Bool d1_k_map  = FALSE;
Bool d1_k_char = FALSE;
Bool d1_k_spellbk = FALSE;
Bool d1_k_quest = FALSE;
Bool d1_k_zin  = FALSE;
Bool d1_k_zout = FALSE;
Bool d1_k_width = FALSE;
I64	 d1_wheel_prev = 0;
I64	 d1_hov_mx = -1;			//last mouse used for menu hover
I64	 d1_hov_my = -1;
U8	*d1_hpbox_clx  = NULL;		//Gfx/healthbox.clx — devilutionX mon HP frame
U8	*d1_hpfill_clx = NULL;		//Gfx/health.clx — fill strip

Bool d1_k_up    = FALSE;
Bool d1_k_down  = FALSE;
Bool d1_k_left  = FALSE;
Bool d1_k_right = FALSE;
Bool d1_k_enter = FALSE;
Bool d1_k_esc   = FALSE;

I64 D1WheelDz()
{//USB mouse writes mouse_hard.pos.z; mouse.pos.z only updates after
 //WinMouseUpdate and can miss notches. poll the hard source, like HL1/Quake
 //do with raw_data.z (this port stays non-raw for the absolute cursor).
	I64 z  = mouse_hard.pos.z;
	I64 dz = z - d1_wheel_prev;

	if (dz)
		d1_wheel_prev = z;
	return dz;
}

Bool D1KeyEdge(I64 sc, Bool *held)
{//one TRUE per press
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

I64 D1WinToCanvasX(I64 wx)
{//window-relative pixels (MessageScan args) -> canvas coords
	if (d1_blit_w < 1)
		return 0;
	return ((wx - d1_blit_x) * d1_w) / d1_blit_w;
}

I64 D1WinToCanvasY(I64 wy)
{
	if (d1_blit_h < 1)
		return 0;
	return ((wy - d1_blit_y) * d1_h) / d1_blit_h;
}

Bool D1AssetsLoad()
{
	I64 size = 0;

	d1_smaltext = D1MpqRead("CtrlPan\\SmalText.CEL", &size);
	d1_pentspin = D1MpqRead("Data\\PentSpin.CEL", &size);
	d1_cursor   = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);

	if (!d1_smaltext)
	{
		"Diablo1: SmalText.CEL missing\n";
		return FALSE;
	}
	D1MakeLightTable;
	D1PanelInit;
	D1QuestInit;
	return TRUE;
}

U0 D1FadeReset()
{
	d1_fade = 0;
	D1PalFadeLevel(0);
}

U0 D1FadeStep()
{
	if (d1_fade < 256)
	{
		d1_fade += 16;
		D1PalFadeLevel(d1_fade);
	}
}

U0 D1EnterTitle()
{
	if (d1_opt_music)
		D1SndMusic("Music\\Dintro.wav");
	D1TitleLoad;
	D1PalSetRaw(d1_title_pal);
	D1FadeReset;
	d1_vp_h  = d1_h;
	d1_state = D1ST_TITLE;
}

U0 D1EnterMenu()
{
	D1MMenuLoad;
	if (d1_mmenu_img)
		D1PalSetRaw(d1_mmenu_pal);
	D1FadeReset;
	d1_play_ready = FALSE;
	d1_vp_h     = d1_h;
	d1_menu_sel = 0;
	d1_menu_screen = 0;
	d1_state    = D1ST_MENU;
}

U0 D1LoadLevel(I64 level, I64 entry)
{//behind a cut screen. places the player and clears any pending warp.
	I64 prev = d1_currlevel;
	Bool obr;
	Bool ibr;
	Bool lok;

	if (level == 0)
		D1CutShow("Gendata\\Cuttt.CEL", "Gendata\\Cuttt.pal");
	else if (level <= 4)
		D1CutShow("Gendata\\Cutl1d.CEL", "Gendata\\Cutl1d.pal");
	else if (level <= 8)
		D1CutShow("Gendata\\Cut2.CEL", "Gendata\\Cut2.pal");
	else if (level <= 12)
		D1CutShow("Gendata\\Cut3.CEL", "Gendata\\Cut3.pal");
	else
		D1CutShow("Gendata\\Cut4.CEL", "Gendata\\Cut4.pal");
	D1PalFadeLevel(256);
	Sleep(60);			//let the compositor show the cut screen
	if (d1_opt_music)
		D1SndMusicForLevel(level);
	D1SndMusVolApply;			//OPTIONS.INI MUSVOL after the voice exists

	//SaveLevel: keep barrels/chests/doors/ground loot/mons/fog across leave
	if (prev > 0 && prev <= 16 && prev != level)
	{
		if (d1_nobjs > 0)
			D1ObjStash(prev);
		D1ItemStash(prev);
		D1MonStash(prev);
		D1AutoStash(prev);
	}
	else if (prev == 0 && level != 0)
		D1AutoStash(0);

	D1MonClearAll;

	D1MisClear;
	D1SpellFxClear;
	D1ItemClear;
	D1ObjClear;

	if (level == 0)
	{
		if (!D1TownLoad())
		{
			"Diablo1: town load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1TownersInit;
		D1StoreSetupTown(d1_lvl_seeds[0]);
		D1DeadguySync;
		D1LightClear(0);
		if (entry == 1)
			D1PlacePlayer(25, 31);		//south of the cathedral entrance
		else
			D1PlacePlayer(75, 68);		//new game spawn
	}
	else
	{
		if (prev == 0)
			D1StoreInvalidateTown;
		if (level <= 4)
			lok = D1L1LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 8)
			lok = D1L2LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 12)
			lok = D1L3LevelLoad(level, d1_lvl_seeds[level], entry);
		else
			lok = D1L4LevelLoad(level, d1_lvl_seeds[level], entry);

		if (!lok)
		{
			"Diablo1: dungeon load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1LightClear(level);
		D1PlacePlayer(d1_lvl_vx, d1_lvl_vy);
		D1LightUpdate(d1_plr_x, d1_plr_y);
		obr = D1ObjRestore(level);
		ibr = D1ItemRestore(level);
		if (!obr)
			D1ObjSpawnLevel(level);
		if (!ibr && level == 10)
			D1AnvilDrop;
		//doors rewrite dPiece; re-seed arches after the swap (InitDungeonPieces)
		if (level <= 4)
			D1SpecialL1Fill;
		else if (level <= 8)
			D1SpecialL2Fill;
		if (obr)
			D1ObjDoorResync;
		if (!D1MonRestore(level))
		{
			D1MonSpawnLevel(level, d1_plr_x, d1_plr_y);
			if (level == 16)
				D1MonSpawnDiablo(d1_plr_x, d1_plr_y);
		}
	}

	if (!D1AutoRestore(level))
		D1AutoClear;
	D1AutoMark(d1_plr_x, d1_plr_y);
	D1QuestLevelEnter(level);

	d1_warp_to = -1;
	D1FadeReset;
	d1_tick_t = tS;
	d1_vp_h   = D1PanelTop();
	d1_state  = D1ST_GAME;
}

U0 D1EnterGame()
{//fresh character unless one was created by the front end
	if (!d1_plr_name[0])
		D1CharCreate(D1CL_WARRIOR, "Aidan");

	//unconditional: this is what reloads the gfx set after a class change
	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_dead = FALSE;
	D1StoreInvalidateTown;
	D1LoadLevel(0, 0);
}

U0 D1ResumeGame()
{//loaded character: keep its hp/mana and drop it on its saved level+tile
 //(vanilla save restores plr[_pX]/_pY], not the level entry)
	I64 lvl = d1_currlevel;
	I64 sx  = d1_plr_x;
	I64 sy  = d1_plr_y;

	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_dead = FALSE;
	D1StoreInvalidateTown;
	D1LoadLevel(lvl, 0);
	if (sx > 0 && sy > 0 && sx < D1_MAXDUN && sy < D1_MAXDUN)
	{
		D1PlacePlayer(sx, sy);
		D1LightUpdate(d1_plr_x, d1_plr_y);
		D1AutoMark(d1_plr_x, d1_plr_y);
	}
}

//OS mouse sprite. the game draws its own Objcurs hand, so the window
//manager's pointer is suppressed while this task holds focus and put back
//when it does not. Demo/Graphics/Grid.ZC saves and restores the same hook.
//mouse.show is not usable: the PS/2 handler (Kernel/SerialDev/Mouse.ZC:437)
//sets it TRUE on every packet outside raw mode, and raw mode stops
//mouse.pos tracking, which this port's absolute pointer needs. the focus
//test is sys_focus_task == Fs, the same exact-task match Mouse.ZC:374 uses
//to scope raw mode for the HL1 port.
U0 (*d1_old_draw_mouse)(CDC *dc, I64 x, I64 y) = NULL;
Bool d1_mouse_hidden = FALSE;

U0 D1MouseHide()
{
	if (d1_mouse_hidden)
		return;
	d1_old_draw_mouse = gr.fp_draw_mouse;
	gr.fp_draw_mouse  = NULL;		//Win.ZC DrawMouse skips a NULL hook
	d1_mouse_hidden   = TRUE;
}

U0 D1MouseShow()
{
	if (!d1_mouse_hidden)
		return;
	gr.fp_draw_mouse = d1_old_draw_mouse;
	d1_mouse_hidden  = FALSE;
}

U0 D1TaskEndCB()
{//kill path: window close, <CTRL-ALT-x>, Kill() from the shell. TaskEnd
 //(Kernel/KTask.ZC:508) redirects rip here instead of ending the task, so
 //the loop's teardown never runs. the compositor reads d1_screen through
 //draw_it and the mixer holds voice buffers in this task's heap.
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	D1SndFree;
	Exit;
}

U0 D1CursorDraw()
{//game states use the Objcurs hand (game palette); title/menu use the
 //DiabloUI arrow - the hand's colors are garbage through menu palettes.
 //HoldItem: draw the item icon under the cursor (CelDrawCursor).
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	if (d1_state != D1ST_GAME && d1_ui_cursor)
	{
		D1Blit8Key(mx, my, d1_ui_cursor, 36, 30, 0);
		return;
	}
	if (d1_state == D1ST_GAME && D1HoldHas() && d1_objcurs)
	{
		//CelDrawCursor: bottom of icon at mouse + cursH - 1 (not gw!)
		D1InvDrawIcon(mx, my + d1_itmdefs[d1_hold_itm].gh * 28 - 1,
			d1_hold_itm, &d1_hold_st, TRUE);
		return;
	}
	if (d1_cursor)
		D1CelDrawClipped(mx, my + 28, d1_cursor, 1, 33);
	else
	{
		D1Pix(mx, my, 255);
		D1Pix(mx + 1, my, 255);
		D1Pix(mx, my + 1, 255);
	}
}

Bool D1UICovers(I64 cx)
{//an open side panel owns its half of the UI band, a FULL panel all of it.
 //cursor.cpp CheckCursMove drops the hover under an open panel.
	I64 i;
	I64 ox  = D1UiOrgX();
	I64 mid = ox + D1_UI_W / 2;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i))
		{
			if (d1_ui_panels[i].side == D1UIS_FULL)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_LEFT && cx >= ox && cx < mid)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_RIGHT && cx >= mid &&
				cx < ox + D1_UI_W)
				return TRUE;
		}
	}
	return FALSE;
}

U0 D1HoverUpdate()
{//cursor target for this frame, into the D1Render globals the world pass
 //outlines. CheckCursMove reduced: actor first, then ground item, then
 //object. AtCurs tests take the tile above an actor's foot tile too.
	I64 tx = 0;
	I64 ty = 0;
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	d1_hover_mi  = -1;
	d1_hover_twn = -1;
	d1_hover_ii  = -1;
	d1_hover_oi  = -1;
	if (my >= d1_vp_h || D1UICovers(mx) || d1_gmenu_open)
		return;

	if (d1_zoom)
	{//inverse of the scale transform, any scale
		mx = D1ZoomToWorldX(mx);
		my = D1ZoomToWorldY(my);
	}
	D1ScreenToTile(mx, my, &tx, &ty);

	if (d1_currlevel == 0)
		d1_hover_twn = D1TownerAtCurs(tx, ty);
	else
		d1_hover_mi = D1MonAtCurs(tx, ty);

	if (d1_hover_mi < 0 && d1_hover_twn < 0)
		d1_hover_ii = D1ItemAtCurs(tx, ty);
	if (d1_hover_mi < 0 && d1_hover_twn < 0 && d1_hover_ii < 0)
		d1_hover_oi = D1ObjAtCurs(tx, ty);
}

U0 D1TextOutlineClr(I64 x, I64 y, U8 *str, I64 col)
{//4-dir black outline then colored fill (float-dmg / Alt item labels)
	D1TextDrawSolid(x - 1, y, str, 0);
	D1TextDrawSolid(x + 1, y, str, 0);
	D1TextDrawSolid(x, y - 1, str, 0);
	D1TextDrawSolid(x, y + 1, str, 0);
	D1TextDrawClr(x, y, str, col);
}

U0 D1HoverDraw()
{//retail: hover names go to the Description Box (D1PanelInfoDraw).
 //warp labels still float. optional enemy HP bar = monhealthbar QOL.
	I64	 mi = d1_hover_mi;
	I64	 full;
	I64	 bar;
	I64	 bw;
	I64	 bh;
	I64	 bx;
	I64	 by;
	I64	 wx;
	I64	 wy;
	I64	 ttx;
	I64	 tty;
	I64	 tw = 0;
	I64	 nx = 0;
	I64	 ny = 0;
	I64	 border = 3;
	I64	 fillw;
	I64	 size = 0;
	U8	*name = NULL;

	wx  = D1MouseX();
	wy  = D1MouseY();
	ttx = 0;
	tty = 0;

	if (d1_zoom)
	{
		wx = D1ZoomToWorldX(wx);
		wy = D1ZoomToWorldY(wy);
	}
	if (wy < d1_vp_h && !D1UICovers(wx) &&
		d1_hover_mi < 0 && d1_hover_twn < 0 &&
		d1_hover_ii < 0 && d1_hover_oi < 0)
	{
		D1ScreenToTile(wx, wy, &ttx, &tty);
		name = D1TrigLabelAt(ttx, tty);
		if (name)
		{
			D1HoverNamePos(ttx, tty, 32, D1TextWidth(name), &nx, &ny);
			D1NamePlate(nx, ny, D1TextWidth(name));
			D1TextDrawClr(nx, ny, name, D1COL_WHITE);
		}
	}

	if (d1_opt_enemyhp && mi >= 0 && d1_currlevel != 0)
	{//devilutionX DrawMonsterHealthBar — healthbox.clx + health.clx fill
		if (!d1_hpbox_clx)
			d1_hpbox_clx = FileRead("::/Apps/Diablo1/Gfx/healthbox.clx", &size);
		if (!d1_hpfill_clx)
			d1_hpfill_clx = FileRead("::/Apps/Diablo1/Gfx/health.clx", &size);
		full = d1_mons[mi].maxhp;
		if (full < 1)
			full = 1;
		if (d1_hpbox_clx)
		{
			bw = D1ClxWidth(d1_hpbox_clx);
			bh = D1ClxHeight(d1_hpbox_clx);
			bx = d1_w / 2 - bw / 2;
			by = 18;
			if (d1_inv_open)
				bx -= 160;			//SPANEL_WIDTH/2
			D1ClxDraw(bx, by, d1_hpbox_clx);
			D1FillRectTrans(bx + border, by + border,
				bw - border * 2, bh - border * 2);
			fillw = D1ClxWidth(d1_hpfill_clx);
			if (fillw < 1)
				fillw = bw - border * 2 - 2;
			bar = (fillw * d1_mons[mi].hp) / full;
			if (bar < 0)
				bar = 0;
			if (bar > fillw)
				bar = fillw;
			if (bar > 0 && d1_hpfill_clx)
				D1ClxDrawClipW(bx + border + 1, by + border + 1,
					d1_hpfill_clx, bar);
			name = d1_montypes[d1_mons[mi].type].name;
			nx = bx + (bw - D1TextWidth(name)) / 2;
			ny = by + bh / 2 + 4;
			D1TextOutlineClr(nx, ny, name, D1COL_WHITE);
		}
		else
		{//fallback if Gfx/ missing from the disk image
			bw = 280;
			bh = 28;
			bx = d1_w / 2 - bw / 2;
			by = 10;
			D1FillRect(bx, by, bw, bh, 150);
			D1FillRect(bx + 1, by + 1, bw - 2, bh - 2, 146);
			D1FillRect(bx + 3, by + 3, bw - 6, bh - 6, 0);
			bar = ((bw - 8) * d1_mons[mi].hp) / full;
			if (bar < 0)
				bar = 0;
			if (bar > bw - 8)
				bar = bw - 8;
			if (bar > 0)
				D1FillRect(bx + 4, by + 4, bar, bh - 8, 229);
			name = d1_montypes[d1_mons[mi].type].name;
			nx = bx + (bw - D1TextWidth(name)) / 2;
			ny = by + bh / 2 + 4;
			D1TextOutlineClr(nx, ny, name, D1COL_WHITE);
		}
	}
}

U0 D1HitFlashDraw()
{//red frame around the viewport while fresh damage stings
	I64 x;
	I64 y;

	if (d1_plr_hitflash <= 0)
		return;
	for (x = 0; x < d1_w; x++)
	{
		D1Pix(x, 0, 229);
		D1Pix(x, 1, 229);
		D1Pix(x, d1_vp_h - 2, 229);
		D1Pix(x, d1_vp_h - 1, 229);
	}
	for (y = 0; y < d1_vp_h; y++)
	{
		D1Pix(0, y, 229);
		D1Pix(1, y, 229);
		D1Pix(d1_w - 2, y, 229);
		D1Pix(d1_w - 1, y, 229);
	}
}

I64 d1_victory_timer = 0;

//panel registry indices, filled by D1UISetup
I64 d1_ui_inv   = -1;
I64 d1_ui_char  = -1;
I64 d1_ui_spell = -1;
I64 d1_ui_quest = -1;
I64 d1_ui_auto  = -1;
I64 d1_ui_store = -1;
I64 d1_save_slot = 0;			//slot the front end picked, used by autosave

U0 D1FloatDraw()
{//devilutionX DrawFloatingNumbers. world draws then ZoomApply, so this
 //runs in final screen space: TileToScreen is the 1:1 world point, then
 //ZoomToScreen (dX worldOffset *= 2 under binary zoom). text itself stays
 //1:1 SmalText - only the anchor tracks the magnifier.
	I64 i;
	I64 sx;
	I64 sy;
	I64 tw;
	U8	buf[24];

	if (!d1_opt_floatdmg)
		return;
	for (i = 0; i < D1_MAXFLOAT; i++)
	{
		if (d1_floats[i].active)
		{
			D1TileToScreen(d1_floats[i].x, d1_floats[i].y, &sx, &sy);
			//dX: Displacement{TILE_WIDTH/2, -TILE_HEIGHT/2} + rise
			sx += D1_TILE_W / 2;
			sy -= D1_TILE_H / 2 + d1_floats[i].oy;
			if (d1_zoom)
			{
				sx = D1ZoomToScreenX(sx);
				sy = D1ZoomToScreenY(sy);
			}
			if (d1_floats[i].exp)
				StrPrint(buf, "+ %d EXP", d1_floats[i].val);
			else
				StrPrint(buf, "%d", d1_floats[i].val);
			tw = D1TextWidth(buf);
			sx -= tw / 2;
			D1TextDrawSolid(sx - 1, sy, buf, 0);
			D1TextDrawSolid(sx + 1, sy, buf, 0);
			D1TextDrawSolid(sx, sy - 1, buf, 0);
			D1TextDrawSolid(sx, sy + 1, buf, 0);
			if (d1_floats[i].col >= 0)
				D1TextDrawClr(sx, sy, buf, d1_floats[i].col);
			else
				D1TextDrawSolid(sx, sy, buf, D1PalBrightest());
		}
	}
}

U0 D1ItemLabelsDraw()
{//devilutionX ShowItemLabels: hold Alt to name every ground drop.
 //screenshot: outlined colored text, no plate. white / blue magic / gold unique;
 //gold piles show the amount in gold.
	I64 i;
	I64 sx;
	I64 sy;
	I64 nx;
	I64 ny;
	I64 tw;
	I64 col;
	U8	 buf[D1_AFFNAME];
	CD1Item *it;

	if (!Bt(kbd.down_bitmap, SC_ALT))
		return;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		it = &d1_items[i];
		if (it->active)
		{
			D1TileToScreen(it->x, it->y, &sx, &sy);
			if (sx >= -64 && sx <= d1_w + 64 && sy >= -32 && sy <= d1_vp_h + 64)
			{
				D1ItemLabelStr(i, buf, &col);
				if (buf[0])
				{
					tw = D1TextWidth(buf);
					nx = sx + 32 - tw / 2;
					ny = sy - 40;
					D1TextOutlineClr(nx, ny, buf, col);
				}
			}
		}
	}
}

U0 D1GameDraw()
{
	D1Clear(0);
	D1HoverUpdate;
	D1WorldFrame;
	D1AutoDraw;
	D1PanelDraw;
	D1DurIconDraw;
	D1UIDrawAll;
	//info box after the side panels so Inv.CEL cannot cover the lines
	D1PanelInfoDraw(D1MouseX(), D1MouseY());
	D1UnqInfoDraw;
	D1HoverDraw;
	D1ItemLabelsDraw;
	D1FloatDraw;
	if (d1_talk_timer > 0 && d1_talk_txt)
	{//InitDiabloMsg: mid-viewport, not over the bottom panel HUD
		D1TextDrawSolid(d1_w / 2 - D1TextWidth(d1_talk_txt) / 2,
			d1_vp_h / 2, d1_talk_txt, D1PalBrightest());
	}
	if (d1_victory_timer > 0)
		D1TextDrawSolid(d1_w / 2 - D1TextWidth("DIABLO HAS FALLEN") / 2,
			160, "DIABLO HAS FALLEN", D1PalBrightest());
	D1CursorDraw;
}

U0 D1EnterSel()
{
	D1SelEnter;
	d1_vp_h  = d1_h;
	d1_state = D1ST_SEL;
}

U0 D1MenuAction(I64 act)
{
	if (act == 1)
		D1EnterSel;
	else if (act == 2)
		d1_quit = TRUE;
}

U0 D1StoreOpened()
{//D1Play opens stores directly; clear the other panels so the full-screen
 //store is not drawn under them
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (i != d1_ui_store && D1UIIsOpen(i))
			D1UIClose(i);
	}
}

U0 D1PanelUnavail()
{
	d1_talk_txt   = "Not implemented";
	d1_talk_timer = 60;
}

U0 D1PanelAction(I64 act)
{//D1PanelClick codes: 1 menu, 2 inv, 3 spells, 4 char, 5 quests, 6 map,
 //10+n belt slot n
	I64 old;
	I64 slot;

	if (act == 1)
		D1GMenuOpen;			//in-game ESC menu, not the title front end
	else if (act == 2)
		D1UIToggle(d1_ui_inv);
	else if (act == 3)
	{
		if (d1_ui_spell >= 0)
			D1UIToggle(d1_ui_spell);
		else
			D1PanelUnavail;
	}
	else if (act == 4)
	{
		if (d1_ui_char >= 0)
			D1UIToggle(d1_ui_char);
		else
			D1PanelUnavail;
	}
	else if (act == 5)
	{
		if (d1_ui_quest >= 0)
			D1UIToggle(d1_ui_quest);
		else
			D1PanelUnavail;
	}
	else if (act == 6)
	{
		if (d1_ui_auto >= 0)
			D1UIToggle(d1_ui_auto);
		else
			D1PanelUnavail;
	}
	else if (act == 7)
	{//DoSpeedBook via SpelIcon
		if (d1_panel_splring_toggle)
			(*d1_panel_splring_toggle)();
	}
	else if (act >= 10)
	{
		slot = act - 10;
		if (D1HoldHas())
		{//paste potion onto this belt chip, or swap
			if (d1_itmdefs[d1_hold_itm].misc)
			{
				old = d1_belt[slot];
				d1_belt[slot] = d1_hold_itm;
				D1ItmSndPlay(d1_belt[slot]);
				D1HoldClear;
				if (old)
					D1HoldTake(old, 0, NULL);
			}
			else
				D1HoldToBelt;
		}
		else
			D1BeltUse(slot);
	}
}

U0 D1GMenuAction(I64 act)
{//gamemenu.cpp dispatch on the shell's existing paths. Quit Diablo leaves
 //for the main menu through the autosave the old ESC exit used; retail
 //quits the program outright.
	if (act == 1)
	{//gamemenu_save_game
		if (!d1_plr_dead)
		{
			D1SaveWrite(d1_save_slot);
			d1_talk_txt   = "Game saved";
			d1_talk_timer = 60;
		}
	}
	else if (act == 2)
	{//gamemenu_new_game: back through the front end to character select
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
		D1EnterSel;
	}
	else if (act == 3)
	{//gamemenu_load_game: reload the slot and re-enter its level
		if (D1SaveRead(d1_save_slot))
			D1ResumeGame;
	}
	else if (act == 4)
	{//gamemenu_quit_game
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
	}
}

U0 D1Input()
{//queued messages: clicks and the title's any-key
	I64 m;
	I64 a1 = 0;
	I64 a2 = 0;
	I64 tx;
	I64 ty;

	while (m = MessageScan(&a1, &a2))
	{
		switch (m)
		{
			case MESSAGE_KEY_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelKey(a2, a1);		//name entry takes typed chars
				break;
			case MESSAGE_MS_L_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelClick(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
				else if (d1_state == D1ST_MENU)
				{
					tx = D1MenuHitTest(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
					if (tx >= 0)
					{
						d1_menu_sel = tx;
						D1MenuAction(D1MenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2)));
						if (d1_menu_screen == 1)
							d1_menu_sel = D1OptRowNorm(d1_menu_sel);
					}
				}
				else if (d1_state == D1ST_GAME && d1_gmenu_open)
				{
					tx = D1GMenuHitTest(D1WinToCanvasX(a1),
						D1WinToCanvasY(a2) - D1UiOrgY());
					if (tx >= 0)
					{
						d1_gmenu_sel = tx;
						D1GMenuAction(D1GMenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2) - D1UiOrgY()));
					}
				}
				else if (d1_state == D1ST_GAME)
				{
					//use live cursor, not MessageScan args: blit / scroll
					//skew on a1,a2 misses the sparse TextBox2 menu rows
					tx = D1MouseX();
					ty = D1MouseY();
					if (d1_panel_splring_click &&
						(*d1_panel_splring_click)(tx, ty))
					{//speedbook ring ate the click
					}
					else if (!D1UIClickAny(tx, ty))
					{
						if (ty >= D1PanelTop())
							D1PanelAction(D1PanelClick(tx, ty));
						else if (D1HoldHas())
						{//InvPutItem: drop held gear onto the playfield
							if (d1_zoom)
							{
								tx = D1ZoomToWorldX(tx);
								ty = D1ZoomToWorldY(ty);
							}
							D1ScreenToTile(tx, ty, &tx, &ty);
							D1HoldDropWorld(tx, ty);
						}
						else
						{
							if (d1_zoom)
							{//inverse of the magnifier, any scale
								tx = D1ZoomToWorldX(tx);
								ty = D1ZoomToWorldY(ty);
							}
							D1ScreenToTile(tx, ty, &tx, &ty);
							D1PlayClickTo(tx, ty);
						}
					}
				}
				break;
			case MESSAGE_MS_R_DOWN:
				if (d1_state == D1ST_GAME && !d1_gmenu_open)
				{
					tx = D1WinToCanvasX(a1);
					ty = D1WinToCanvasY(a2);
					//UseInvItem first: a grid potion drinks, and any click
					//on the open inventory half is consumed
					if (!D1InvRClick(tx, ty) && ty < D1PanelTop() &&
						!(D1UIAnyOpen() && tx >= D1UiOrgX() + D1_UI_W / 2))
					{
						if (d1_zoom)
						{//inverse of the magnifier, any scale
							tx = D1ZoomToWorldX(tx);
							ty = D1ZoomToWorldY(ty);
						}
						D1ScreenToTile(tx, ty, &tx, &ty);
						if (!d1_net_on)
							D1SpellCast(tx, ty);
					}
				}
				break;
		}
	}
}

U0 D1MenuKeys()
{//activation sounds live in D1MenuActivate; only the moves play here
	I64 n = D1MenuCount();

	if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
		{
			d1_menu_sel = D1OptRowNext(d1_menu_sel, -1);
			D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
		}
		else
		{
			d1_menu_sel--;
			if (d1_menu_sel < 0)
				d1_menu_sel = n - 1;
		}
	}
	if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
		{
			d1_menu_sel = D1OptRowNext(d1_menu_sel, 1);
			D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
		}
		else
		{
			d1_menu_sel++;
			if (d1_menu_sel >= n)
				d1_menu_sel = 0;
		}
	}
	if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, -1);
	}
	if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, 1);
	}
	if (D1KeyEdge(SC_ENTER, &d1_k_enter))
	{
		D1MenuAction(D1MenuActivate(d1_menu_sel));
		if (d1_menu_screen == 1)
			d1_menu_sel = D1OptRowNorm(d1_menu_sel);
	}
	if (D1KeyEdge(SC_ESC, &d1_k_esc))
	{
		if (d1_menu_screen == 1)
		{
			d1_menu_screen = 0;
			d1_menu_sel    = 0;
			D1OptSave;
		}
		else if (d1_menu_screen == 2)
		{
			d1_menu_screen = 0;
			d1_menu_sel    = 1;
		}
		else
			D1EnterTitle;
	}
}

U0 Diablo1()
{
	F64 now;
	I64 i;
	I64 hx;
	I64 hy;
	I64 dz;

	DocClear;
	"$$LTRED$$Diablo$$FG$$ for ZealOS - loading DIABDAT.MPQ...\n";

	D1ScreenInit;

	if (!d1_mpq_ready)
	{
		if (!D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ"))
		{
			"Put DIABDAT.MPQ (retail or shareware) at ::/Apps/Diablo1/\n";
			return;
		}
	}
	if (!D1AssetsLoad())
		return;
	D1SndInit;
	//include-time D1OptLoad can run before ::/Apps is mounted; reload here
	//so WIDTH/SFXVOL/MUSVOL/... stick across launches
	D1OptLoad;
	D1SndMusVolApply;

	//keep DolDoc out of the way: no self focus grab, no scroll grab, no
	//task menu, no border, no doc cursor (the Quake port's recipe)
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
					  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
	WinBorder;
	WinMax;
	D1WindowApply;				//honor the windowed option from the first frame
	WinToTop;
	DocCursor;
	DocClear;

	//armed before the canvas is handed to the compositor; a kill between here
	//and the teardown lands in D1TaskEndCB
	Fs->task_end_cb = &D1TaskEndCB;

	for (i = 0; i < 8; i++)
		d1_k_belt[i] = FALSE;
	d1_plr_name[0] = 0;

	d1_wheel_prev = mouse_hard.pos.z;

	D1UIInit;
	d1_ui_inv = D1UIRegister(&d1_inv_open, &D1InvToggle, &D1InvDraw,
		&D1InvClick, D1UIS_RIGHT);
	d1_ui_char = D1UIRegister(&d1_char_open, &D1CharUIToggle, &D1CharUIDraw,
		&D1CharUIClick, D1UIS_LEFT);
	d1_ui_spell = D1UIRegister(&d1_spell_open, &D1SpellToggle, &D1SpellDraw,
		&D1SpellClick, D1UIS_RIGHT);
	d1_ui_quest = D1UIRegister(&d1_quest_open, &D1QuestToggle, &D1QuestDraw,
		&D1QuestClick, D1UIS_LEFT);
	d1_ui_store = D1UIRegister(&d1_store_open, &D1StoreToggle, &D1StoreDraw,
		&D1StoreClick, D1UIS_FULL);
	//automap draws under the control panel, so the registry does not draw it
	d1_ui_auto = D1UIRegister(&d1_auto_open, &D1AutoToggle, NULL, NULL,
		D1UIS_OVERLAY);

	D1EnterTitle;
	d1_quit  = FALSE;
	d1_ready = TRUE;
	Fs->draw_it = &D1DrawIt;

	while (!d1_quit)
	{
		D1Input;
		D1FadeStep;
		d1_anim++;

		if (sys_focus_task == Fs)
			D1MouseHide;
		else
			D1MouseShow;

		switch (d1_state)
		{
			case D1ST_TITLE:
				D1TitleDraw(d1_anim);
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
					d1_quit = TRUE;
				if (D1KeyEdge(SC_ENTER, &d1_k_enter))
					D1EnterMenu;
				break;

			case D1ST_SEL:
				i = D1SelOutcome();
				if (i)
				{
					D1SelOutcomeClear;
					d1_save_slot = d1_sel_target;
					if (i == 1)
						D1ResumeGame;
					else if (i == 2)
						D1EnterGame;
					else
						D1EnterMenu;
					break;
				}
				D1SelKeys;
				D1SelDraw;
				D1CursorDraw;
				break;

			case D1ST_MENU:
				hx = D1MouseX();
				hy = D1MouseY();
				//hover only on mouse move so keyboard up/down is not
				//clobbered every frame by the cursor sitting on a row
				if (hx != d1_hov_mx || hy != d1_hov_my)
				{
					d1_hov_mx = hx;
					d1_hov_my = hy;
					i = D1MenuHitTest(hx, hy);
					if (i >= 0 && i != d1_menu_sel)
					{
						D1MenuMoveSnd;
						d1_menu_sel = i;
						if (d1_menu_screen == 1)
							D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
					}
				}
				dz = D1WheelDz;
				if (dz)
				{
					if (d1_menu_screen == 1)
					{
						D1MenuMoveSnd;
						d1_menu_sel = D1OptWheel(d1_menu_sel, dz, D1OPT_UI_VIS);
					}
					else
					{
						D1MenuMoveSnd;
						if (dz < 0)
						{
							d1_menu_sel++;
							if (d1_menu_sel >= D1MenuCount())
								d1_menu_sel = 0;
						}
						else
						{
							d1_menu_sel--;
							if (d1_menu_sel < 0)
								d1_menu_sel = D1MenuCount() - 1;
						}
					}
				}
				if (mouse.lb)
					D1MenuDrag(D1MouseX(), D1MouseY());
				else
					d1_optl_drag = -1;
				D1MenuDraw(d1_menu_sel, d1_anim / 3);
				D1CursorDraw;
				D1MenuKeys;
				break;

			case D1ST_GAME:
				if (d1_gmenu_open)
				{//gmenu.cpp: the game freezes behind the menu. the tick
				 //clock rides along so closing resumes without a backlog.
					d1_tick_t = tS;
					D1GameDraw;
					D1GMenuDraw(d1_gmenu_sel, d1_anim / 3);
					D1CursorDraw;
					hx = D1MouseX();
					hy = D1MouseY();
					if (hx != d1_hov_mx || hy != d1_hov_my)
					{
						d1_hov_mx = hx;
						d1_hov_my = hy;
						i = D1GMenuHitTest(hx, hy - D1UiOrgY());
						if (i >= 0 && i != d1_gmenu_sel)
						{
							D1MenuMoveSnd;
							d1_gmenu_sel = i;
							if (d1_gmenu_screen == 1)
								D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
					}
					dz = D1WheelDz;
					if (dz)
					{
						if (d1_gmenu_screen == 1)
						{
							D1MenuMoveSnd;
							d1_gmenu_sel = D1OptWheel(d1_gmenu_sel, dz,
								D1OPT_GM_VIS);
						}
						else
						{
							D1MenuMoveSnd;
							if (dz < 0)
							{
								d1_gmenu_sel++;
								if (d1_gmenu_sel >= D1GMenuCount())
									d1_gmenu_sel = 0;
							}
							else
							{
								d1_gmenu_sel--;
								if (d1_gmenu_sel < 0)
									d1_gmenu_sel = D1GMenuCount() - 1;
							}
						}
					}
					if (mouse.lb)
						D1GMenuDrag(D1MouseX());
					else
						d1_optl_drag = -1;
					if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, -1);
							D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
						else
						{
							d1_gmenu_sel--;
							if (d1_gmenu_sel < 0)
								d1_gmenu_sel = D1GMenuCount() - 1;
						}
					}
					if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, 1);
							D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
						else
						{
							d1_gmenu_sel++;
							if (d1_gmenu_sel >= D1GMenuCount())
								d1_gmenu_sel = 0;
						}
					}
					if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, -1);
					}
					if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, 1);
					}
					if (D1KeyEdge(SC_ENTER, &d1_k_enter))
						D1GMenuAction(D1GMenuActivate(d1_gmenu_sel));
					if (D1KeyEdge(SC_ESC, &d1_k_esc))
					{//second ESC resumes; from the option rows it backs out
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_screen = 0;
							d1_gmenu_sel    = 1;
							D1OptSave;
						}
						else
							D1GMenuClose;
					}
					break;
				}
				now = tS;
				while (now - d1_tick_t >= 0.05)
				{
					if (d1_net_on)
					{
						if (!D1PeerNetFrame())
							break;		//stalled: wait for the peer
						D1AutoMark(d1_plr_x, d1_plr_y);
					}
					else
					{
						D1PlayTick;
						D1AutoMark(d1_plr_x, d1_plr_y);
						D1MonTickAll;
						D1MisTick;
						D1SpellTick;
						D1ItemTickAll;
						D1ObjTickAll;
						if (d1_currlevel == 0)
						{
							D1TownersTick;
							D1TownerDlgTick;
						}
					}
					d1_tick_t += 0.05;
				}
				for (i = 0; i < 8; i++)
				{
					if (D1KeyEdge(Char2ScanCode('1' + i), &d1_k_belt[i]))
						D1BeltUse(i);
				}
				if (d1_diablo_slain)
				{
					D1QuestComplete(D1Q_DIABLO);
					d1_diablo_slain  = FALSE;
					d1_victory_timer = 200;
				}
				if (d1_victory_timer > 0)
				{
					d1_victory_timer--;
					if (d1_victory_timer == 0)
					{
						D1EnterMenu;
						break;
					}
				}
				if (d1_warp_to >= 0)
				{
					D1LoadLevel(d1_warp_to, d1_warp_entry);
					if (!d1_plr_dead)
						D1SaveWrite(d1_save_slot);
				}
				D1GameDraw;
				if (D1KeyEdge(Char2ScanCode('z'), &d1_k_zoom))
					D1ZoomToggle;
				if (D1KeyEdge(Char2ScanCode('w'), &d1_k_width))
				{//D1WidthCycle sets d1_vp_h for the menu states; the game
				 //keeps the panel up
					D1WidthCycle;
					d1_vp_h = D1PanelTop();
				}
				//wheel: one notch, one step on the 15-level ladder
				dz = D1WheelDz;
				if (dz)
				{
					if (dz < 0)
						D1ZoomStep(1);
					else
						D1ZoomStep(-1);
				}
				if (D1KeyEdge(Char2ScanCode('i'), &d1_k_inv))
					D1UIToggle(d1_ui_inv);
				if (d1_store_open)
				{
					D1StoreOpened;
					D1StoreKeys;
					hx = D1MouseX();
					hy = D1MouseY();
					if (hx != d1_hov_mx || hy != d1_hov_my)
					{
						d1_hov_mx = hx;
						d1_hov_my = hy;
						D1StoreHover(hx, hy);
					}
				}
				if (D1KeyEdge(Char2ScanCode('c'), &d1_k_char))
					D1UIToggle(d1_ui_char);
				if (D1KeyEdge(Char2ScanCode('s'), &d1_k_spellbk))
					D1UIToggle(d1_ui_spell);
				if (D1KeyEdge(SC_TAB, &d1_k_map))
					D1UIToggle(d1_ui_auto);
				if (D1KeyEdge(Char2ScanCode('q'), &d1_k_quest))
					D1UIToggle(d1_ui_quest);
				if (D1KeyEdge(Char2ScanCode('='), &d1_k_zin))
					D1AutoZoom(1);
				if (D1KeyEdge(Char2ScanCode('-'), &d1_k_zout))
					D1AutoZoom(-1);
				if (mouse.lb && d1_state == D1ST_GAME)
				{//held left button: renew the walk toward the cursor
				 //(diablo.cpp sgbMouseDown), state - not message edge
					hx = D1MouseX();
					hy = D1MouseY();
					if (hy < d1_vp_h && !D1UICovers(hx))
					{
						if (d1_zoom)
						{
							hx = D1ZoomToWorldX(hx);
							hy = D1ZoomToWorldY(hy);
						}
						D1ScreenToTile(hx, hy, &hx, &hy);
						D1PlayHeldWalk(hx, hy);
					}
				}
				if (D1KeyEdge(SC_ESC, &d1_k_esc) && !d1_store_open)
				{//gmenu over the paused game (devilutionX PressEscKey);
				 //the old autosave-and-exit lives on its Quit Diablo row
					D1GMenuOpen;
				}
				break;
		}

		Sleep(15);
	}

	//teardown: stop the compositor reading the canvas before anything dies
	Fs->task_end_cb = NULL;
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	WinBorder;
	DocCursor;
	//park the doc cursor at the head; a click-parked cursor makes the shell
	//insert the next typed line INTO old text (the Quake port's exit fault)
	if (Fs->put_doc)
	{
		Fs->put_doc->cur_entry = &Fs->put_doc->head;
		Fs->put_doc->cur_col   = 0;
	}
	Fs->title_src = TTS_LOCKED_CONST;
	D1OptSave;
	D1SndFree;
	DocClear;
	"Diablo1: bye.\n";
}
