//draw_it blits on the window manager task, reading d1_screen through d1_argb (D1Draw).
//game logic ticks at 20Hz.

#define D1ST_TITLE		0
#define D1ST_MENU		1
#define D1ST_GAME		2
#define D1ST_SEL		3
#define D1ST_LOBBY		4

#define D1NI_NONE		0
#define D1NI_HOST		1
#define D1NI_JOIN		2

I64	 d1_net_intent = D1NI_NONE;

I64	 d1_state    = D1ST_TITLE;
I64	 d1_anim     = 0;
Bool d1_quit     = FALSE;
U8	*d1_cursor   = NULL;			//Data\Inv\Objcurs.CEL
F64	 d1_tick_t   = 0.0;
I64	 d1_fade     = 0;				//0..256 palette fade-in
Bool d1_k_belt[8];
Bool d1_k_zoom = FALSE;
Bool d1_k_inv  = FALSE;
Bool d1_k_map  = FALSE;
Bool d1_k_char = FALSE;
Bool d1_k_spellbk = FALSE;
Bool d1_k_quest = FALSE;
Bool d1_k_zin  = FALSE;
Bool d1_k_zout = FALSE;
Bool d1_k_width = FALSE;
I64	 d1_wheel_prev = 0;
I64	 d1_hov_mx = -1;
I64	 d1_hov_my = -1;

Bool d1_k_up    = FALSE;
Bool d1_k_down  = FALSE;
Bool d1_k_left  = FALSE;
Bool d1_k_right = FALSE;
Bool d1_k_enter = FALSE;
Bool d1_k_esc   = FALSE;

I64 D1WheelDz()
{//mouse.pos.z updates only after WinMouseUpdate and misses notches.
	I64 z  = mouse_hard.pos.z;
	I64 dz = z - d1_wheel_prev;

	if (dz)
		d1_wheel_prev = z;
	return dz;
}

Bool D1KeyEdge(I64 sc, Bool *held)
{
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

I64 D1WinToCanvasX(I64 wx)
{//window-relative pixels (MessageScan args) -> canvas coords
	if (d1_blit_w < 1)
		return 0;
	return ((wx - d1_blit_x) * d1_w) / d1_blit_w;
}

I64 D1WinToCanvasY(I64 wy)
{
	if (d1_blit_h < 1)
		return 0;
	return ((wy - d1_blit_y) * d1_h) / d1_blit_h;
}

Bool D1AssetsLoad()
{
	I64 size = 0;

	d1_smaltext = D1MpqRead("CtrlPan\\SmalText.CEL", &size);
	d1_pentspin = D1MpqRead("Data\\PentSpin.CEL", &size);
	d1_cursor   = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);

	if (!d1_smaltext)
	{
		"Diablo1: SmalText.CEL missing\n";
		return FALSE;
	}
	D1MakeLightTable;
	D1PanelInit;
	D1QuestInit;
	return TRUE;
}

U0 D1FadeReset()
{
	d1_fade = 0;
	D1PalFadeLevel(0);
}

U0 D1FadeStep()
{
	if (d1_fade < 256)
	{
		d1_fade += 16;
		D1PalFadeLevel(d1_fade);
	}
}

U0 D1EnterTitle()
{
	if (d1_opt_music)
		D1SndMusic("Music\\Dintro.wav");
	D1TitleLoad;
	D1PalSetRaw(d1_title_pal);
	D1FadeReset;
	d1_vp_h  = d1_h;
	d1_state = D1ST_TITLE;
}

U0 D1EnterMenu()
{
	D1MMenuLoad;
	if (d1_mmenu_img)
		D1PalSetRaw(d1_mmenu_pal);
	D1FadeReset;
	d1_play_ready = FALSE;
	d1_vp_h     = d1_h;
	d1_menu_sel = 0;
	d1_menu_screen = 0;
	D1MpEditCancel;
	d1_state    = D1ST_MENU;
}

U0 D1LoadLevel(I64 level, I64 entry)
{
	I64 prev = d1_currlevel;
	Bool obr;
	Bool ibr;
	Bool lok;
	Bool mon_first;

	mon_first = TRUE;
	if (level == 0)
		D1CutShow("Gendata\\Cuttt.CEL", "Gendata\\Cuttt.pal");
	else if (level <= 4)
		D1CutShow("Gendata\\Cutl1d.CEL", "Gendata\\Cutl1d.pal");
	else if (level <= 8)
		D1CutShow("Gendata\\Cut2.CEL", "Gendata\\Cut2.pal");
	else if (level <= 12)
		D1CutShow("Gendata\\Cut3.CEL", "Gendata\\Cut3.pal");
	else
		D1CutShow("Gendata\\Cut4.CEL", "Gendata\\Cut4.pal");
	D1PalFadeLevel(256);
	Sleep(60);
	if (d1_opt_music)
		D1SndMusicForLevel(level);
	D1SndMusVolApply;

	//loadsave.cpp:541 wraps the dungeon, monster and object blocks in
	//leveltype != DTYPE_TOWN; the item blocks are unconditional.
	if (prev >= 0 && prev <= 16 && prev != level)
	{
		if (prev > 0)
		{
			if (d1_nobjs > 0)
				D1ObjStash(prev);
			D1MonStash(prev);
		}
		D1ItemStash(prev);
		D1AutoStash(prev);
	}

	D1MonClearAll;

	D1MisClear;
	D1SpellFxClear;
	D1ItemClear;
	D1ObjClear;

	if (level == 0)
	{
		if (!D1TownLoad())
		{
			"Diablo1: town load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1TownersInit;
		D1StoreSetupTown(d1_lvl_seeds[0]);
		D1DeadguySync;
		D1ItemRestore(0);
		D1LightClear(0);
		if (entry == 1)
			D1PlacePlayer(25, 31);		//south of the cathedral entrance
		else
			D1PlacePlayer(75, 68);		//new game spawn
	}
	else
	{
		if (prev == 0)
			D1StoreInvalidateTown;
		if (level <= 4)
			lok = D1L1LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 8)
			lok = D1L2LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 12)
			lok = D1L3LevelLoad(level, d1_lvl_seeds[level], entry);
		else
			lok = D1L4LevelLoad(level, d1_lvl_seeds[level], entry);

		if (!lok)
		{
			"Diablo1: dungeon load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1LightClear(level);
		D1PlacePlayer(d1_lvl_vx, d1_lvl_vy);
		D1LightUpdate(d1_plr_x, d1_plr_y);
		obr = D1ObjRestore(level);
		ibr = D1ItemRestore(level);
		if (!obr)
			D1ObjSpawnLevel(level);
		if (!ibr && level == 10)
			D1AnvilDrop;
		//doors rewrite dPiece; re-seed arches after the swap (InitDungeonPieces)
		if (level <= 4)
			D1SpecialL1Fill;
		else if (level <= 8)
			D1SpecialL2Fill;
		if (obr)
			D1ObjDoorResync;
		mon_first = !D1MonRestore(level);
		if (mon_first)
		{
			D1MonSpawnLevel(level, d1_plr_x, d1_plr_y);
			if (level == 16)
				D1MonSpawnDiablo(d1_plr_x, d1_plr_y);
		}
	}

	if (!D1AutoRestore(level))
		D1AutoClear;
	D1AutoMark(d1_plr_x, d1_plr_y);
	D1QuestLevelEnter(level, mon_first);

	d1_warp_to = -1;
	D1FadeReset;
	d1_tick_t = tS;
	d1_vp_h   = D1PanelTop();
	d1_state  = D1ST_GAME;
}

U0 D1EnterGame()
{
	if (!d1_plr_name[0])
		D1CharCreate(D1CL_WARRIOR, "Aidan");

	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_dead = FALSE;
	D1StoreInvalidateTown;
	D1LoadLevel(0, 0);
}

//the host rolls the 17 level seeds and ships them in its ACCEPT; the joiner
//takes them before generating. No start packet: each peer goes live once it
//holds the other's character pack.

U0 D1NetSeedsTake()
{
	I64 i;

	for (i = 0; i < D1NET_NSEED; i++)
		d1_lvl_seeds[i] = d1_net_seeds[i];
	d1_seeds_init = TRUE;
}

U0 D1EnterLobby()
{
	U32 hip;

	if (d1_net_intent == D1NI_HOST)
	{
		if (!D1NetHostStart(d1_plr_name, ToI64(tS * 1000) & 0x7FFFFFFF))
		{
			D1EnterMenu;
			return;
		}
		D1NetSeedsTake;
	}
	else
	{
		hip = D1MpIPParse(d1_mp_hostip);
		if (!hip || !D1NetJoinStart(d1_plr_name, hip))
		{
			D1EnterMenu;
			return;
		}
	}
	d1_vp_h  = d1_h;
	d1_state = D1ST_LOBBY;
}

U0 D1LobbyDraw()
{
	I64 ox = D1UiOrgX();
	I64 oy = D1UiOrgY();
	I64 i;
	I64 y  = oy + 200;
	U8	line[96];

	D1Clear(0);
	if (d1_mmenu_img)
		D1Blit8(ox, oy, d1_mmenu_img, d1_mmenu_w, d1_mmenu_h);

	if (d1_net_host)
		D1UiText42(ox + D1_UI_W / 2, oy + 120, "Hosting");
	else
		D1UiText42(ox + D1_UI_W / 2, oy + 120, "Joining");

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used)
		{
			StrPrint(line, "peer %d  %s", i, d1_peers[i].name);
			D1TextDrawSolid(ox + D1_UI_W / 2 - D1TextWidth(line) / 2, y,
				line, D1PalBrightest());
			y += 24;
		}
	}
	if (d1_net_status[0])
		D1TextDrawSolid(ox + D1_UI_W / 2 - D1TextWidth(d1_net_status) / 2,
			oy + 400, d1_net_status, D1PalBrightest());
	D1TextDrawSolid(ox + D1_UI_W / 2 -
		D1TextWidth("ESC leaves the session") / 2, oy + 430,
		"ESC leaves the session", D1PalBrightest());
}

U0 D1LobbyGo()
{
	I64 i;

	D1NetSeedsTake;
	if (!D1PlayInit())
	{
		D1NetLeave;
		D1EnterMenu;
		return;
	}
	d1_plr_dead = FALSE;
	D1StoreInvalidateTown;
	D1LoadLevel(0, 0);

	for (i = 0; i < D1_MAXPEER; i++)
	{
		if (d1_peers[i].used && !d1_peers[i].local)
			D1PeerGfxLoad(d1_peers[i].cls);
	}
	D1PeerFromLocal;
	D1PeerPlaceLocal;
	D1NetGoLive;
}

U0 D1CursorDraw()
{
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	if (d1_state != D1ST_GAME && d1_ui_cursor)
	{
		D1Blit8Key(mx, my, d1_ui_cursor, 36, 30, 0);
		return;
	}
	if (d1_state == D1ST_GAME && D1HoldHas() && d1_objcurs)
	{
		//CelDrawCursor: bottom of icon at mouse + cursH - 1, not gw
		D1InvDrawIcon(mx, my + d1_itmdefs[d1_hold_itm].gh * 28 - 1,
			d1_hold_itm, &d1_hold_st, TRUE);
		return;
	}
	if (d1_cursor)
		D1CelDrawClipped(mx, my + 28, d1_cursor, 1, 33);
	else
	{
		D1Pix(mx, my, 255);
		D1Pix(mx + 1, my, 255);
		D1Pix(mx, my + 1, 255);
	}
}

U0 D1LobbyFrame()
{
	D1NetPump;
	D1LobbyDraw;
	D1CursorDraw;
	if (d1_net_state == D1NS_ERROR)
		return;
	if (D1PeerCount() >= 2 && d1_net_packs >= 1)
		D1LobbyGo;
}

U0 D1ResumeGame()
{//vanilla save restores plr[]._pX/._pY, not the level entry
	I64 lvl = d1_currlevel;
	I64 sx  = d1_plr_x;
	I64 sy  = d1_plr_y;

	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_dead = FALSE;
	D1StoreInvalidateTown;
	D1LoadLevel(lvl, 0);
	if (sx > 0 && sy > 0 && sx < D1_MAXDUN && sy < D1_MAXDUN)
	{
		D1PlacePlayer(sx, sy);
		D1LightUpdate(d1_plr_x, d1_plr_y);
		D1AutoMark(d1_plr_x, d1_plr_y);
	}
}

//mouse.show is unusable: the PS/2 handler (Kernel/SerialDev/Mouse.ZC:437) sets
//it TRUE on every packet outside raw mode, and raw mode stops mouse.pos
//tracking. focus test is sys_focus_task == Fs (Mouse.ZC:374).
U0 (*d1_old_draw_mouse)(CDC *dc, I64 x, I64 y) = NULL;
Bool d1_mouse_hidden = FALSE;

U0 D1MouseHide()
{
	if (d1_mouse_hidden)
		return;
	d1_old_draw_mouse = gr.fp_draw_mouse;
	gr.fp_draw_mouse  = NULL;		//Win.ZC DrawMouse skips a NULL hook
	d1_mouse_hidden   = TRUE;
}

U0 D1MouseShow()
{
	if (!d1_mouse_hidden)
		return;
	gr.fp_draw_mouse = d1_old_draw_mouse;
	d1_mouse_hidden  = FALSE;
}

U0 D1TaskEndCB()
{//TaskEnd (Kernel/KTask.ZC:508) redirects rip here instead of ending the task.
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	D1SndFree;
	Exit;
}


Bool D1UICovers(I64 cx)
{//cursor.cpp CheckCursMove drops the hover under an open panel.
	I64 i;
	I64 ox  = D1UiOrgX();
	I64 mid = ox + D1_UI_W / 2;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i))
		{
			if (d1_ui_panels[i].side == D1UIS_FULL)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_LEFT && cx >= ox && cx < mid)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_RIGHT && cx >= mid &&
				cx < ox + D1_UI_W)
				return TRUE;
		}
	}
	return FALSE;
}

U0 D1HoverUpdate()
{//CheckCursMove reduced: actor, ground item, object; AtCurs also tests
 //the tile above a foot tile.
	I64 tx = 0;
	I64 ty = 0;
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	d1_hover_mi  = -1;
	d1_hover_twn = -1;
	d1_hover_ii  = -1;
	d1_hover_oi  = -1;
	if (my >= d1_vp_h || D1UICovers(mx) || d1_gmenu_open)
		return;

	if (d1_zoom)
	{
		mx = D1ZoomToWorldX(mx);
		my = D1ZoomToWorldY(my);
	}
	D1ScreenToTile(mx, my, &tx, &ty);

	if (d1_currlevel == 0)
		d1_hover_twn = D1TownerAtCurs(tx, ty);
	else
		d1_hover_mi = D1MonAtCurs(tx, ty);

	if (d1_hover_mi < 0 && d1_hover_twn < 0)
		d1_hover_ii = D1ItemAtCurs(tx, ty);
	if (d1_hover_mi < 0 && d1_hover_twn < 0 && d1_hover_ii < 0)
		d1_hover_oi = D1ObjAtCurs(tx, ty);
}

U0 D1TextOutlineClr(I64 x, I64 y, U8 *str, I64 col)
{
	D1TextDrawSolid(x - 1, y, str, 0);
	D1TextDrawSolid(x + 1, y, str, 0);
	D1TextDrawSolid(x, y - 1, str, 0);
	D1TextDrawSolid(x, y + 1, str, 0);
	D1TextDrawClr(x, y, str, col);
}

Bool D1MonIsUnique(I64 mi)
{//Monster::isUnique(). pack minions (Monster::leader) are not modelled.
	I64 ti;

	if (mi < 0 || mi >= D1_MAXMON)
		return FALSE;
	ti = d1_mons[mi].type;
	if (ti == D1_MT_DIABLO)
		return TRUE;
	return ToBool(ti >= D1_BOSS_FIRST && ti < D1_BOSS_FIRST + D1_NBOSS);
}

I64 D1MonClassBorder(I64 mclass)
{//DrawMonsterHealthBar GetBorderColor
	if (mclass == D1MC_UNDEAD)
		return 248;
	if (mclass == D1MC_DEMON)
		return 232;
	return 150;					//D1MC_ANIMAL
}

Bool D1PanelsCoverView()
{//control.hpp CanPanelsCoverView
	return ToBool(d1_w <= D1_UI_W && d1_h <= D1_UI_H);
}

Bool D1SideOpen(I64 side)
{//control_panel.cpp IsLeftPanelOpen / IsRightPanelOpen over the D1UI table
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i) && d1_ui_panels[i].side == side)
			return TRUE;
	}
	return FALSE;
}

#define D1_MSG_TOP		158
#define D1_MSG_LX		101
#define D1_MSG_RX		527
#define D1_MSG_TILE		12
#define D1_MSG_EDGEN	35		//top/bottom edge tiles between the corners
#define D1_MSG_SIDEN	3		//left/right edge tiles between the corners
#define D1_MSG_FIELD	442		//text is centered in this width from D1_MSG_LX

//monhealthbar.cpp geometry. 272 = 22 tiles of 12 wide with two corners.
#define D1_HPB_W		264
#define D1_HPB_H		24
#define D1_HPB_EDGEN	20
#define D1_HPB_FILL		229

U0 D1MonHealthBarDraw(I64 mi)
{//devilutionX qol/monhealthbar.cpp DrawMonsterHealthBar, frame from
 //Data\TextSlid.CEL. 272x21 box, 3px border.
	I64	 full;
	I64	 bar;
	I64	 bw = D1_HPB_W;
	I64	 bh = D1_HPB_H;
	I64	 bx;
	I64	 by = 18;
	I64	 nx;
	I64	 ny;
	I64	 iw;
	I64	 ih;
	I64	 col;
	I64	 bc;
	I64	 border = 3;
	I64	 i;
	I64	 sx;
	U8	*name;

	full = d1_mons[mi].maxhp;
	if (full < 1)
		full = 1;
	name = d1_montypes[d1_mons[mi].type].name;

	bx = (d1_w - bw) / 2;
	if (D1PanelsCoverView())
	{//SidePanelSize.width / 2
		if (D1SideOpen(D1UIS_RIGHT))
			bx -= 160;
		if (D1SideOpen(D1UIS_LEFT))
			bx += 160;
	}

	iw = bw - border * 2 - 2;
	ih = bh - border * 2 - 2;

	D1TextSlidLoad;
	if (d1_textslid)
	{
		D1CelDraw(bx, by, d1_textslid, 1, D1_MSG_TILE);
		D1CelDraw(bx + bw - D1_MSG_TILE, by, d1_textslid, 4, D1_MSG_TILE);
		D1CelDraw(bx, by + bh - D1_MSG_TILE, d1_textslid, 2, D1_MSG_TILE);
		D1CelDraw(bx + bw - D1_MSG_TILE, by + bh - D1_MSG_TILE,
			d1_textslid, 3, D1_MSG_TILE);
		sx = bx + D1_MSG_TILE;
		for (i = 0; i < D1_HPB_EDGEN; i++)
		{
			D1CelDraw(sx, by, d1_textslid, 5, D1_MSG_TILE);
			D1CelDraw(sx, by + bh - D1_MSG_TILE, d1_textslid, 7, D1_MSG_TILE);
			sx += D1_MSG_TILE;
		}
	}
	else
	{
		D1FillRect(bx, by, bw, bh, 150);
		D1FillRect(bx + 1, by + 1, bw - 2, bh - 2, 146);
	}
	D1FillRectTrans(bx + border, by + border,
		bw - border * 2, bh - border * 2);

	bar = (iw * d1_mons[mi].hp) / full;
	//upstream wraps to healthBlue above maxhp; this clamps.
	if (bar < 0)
		bar = 0;
	if (bar > iw)
		bar = iw;
	if (bar > 0)
		D1FillRect(bx + border + 1, by + border + 1, bar, ih, D1_HPB_FILL);

	if (d1_opt_montype)
	{//showMonsterType: mMonstClass border, undead 248 / demon 232 / animal 150
		bc = D1MonClassBorder(d1_montypes[d1_mons[mi].type].mclass);
		D1FillRect(bx + border, by + border, bw - border * 2, 1, bc);
		D1FillRect(bx + border, by + bh - border - 1, bw - border * 2, 1, bc);
		D1FillRect(bx + border, by + border + 1, 1, ih, bc);
		D1FillRect(bx + bw - border - 1, by + border + 1, 1, ih, bc);
	}

	col = D1COL_WHITE;
	if (D1MonIsUnique(mi))
		col = D1COL_GOLD;
	nx = bx + (bw - D1TextWidth(name)) / 2;
	ny = by + (bh - D1_SMAL_H) / 2 + D1_SMAL_H - 1;
	D1TextDrawSolid(nx - 1, ny + 1, name, 0);
	D1TextDrawClr(nx, ny, name, col);
}

U0 D1HoverDraw()
{//retail: hover names go to the Description Box (D1PanelInfoDraw).
	I64	 mi = d1_hover_mi;
	I64	 wx;
	I64	 wy;
	I64	 ttx;
	I64	 tty;
	I64	 nx = 0;
	I64	 ny = 0;
	U8	*name = NULL;

	wx  = D1MouseX();
	wy  = D1MouseY();
	ttx = 0;
	tty = 0;

	if (d1_zoom)
	{
		wx = D1ZoomToWorldX(wx);
		wy = D1ZoomToWorldY(wy);
	}
	if (wy < d1_vp_h && !D1UICovers(wx) &&
		d1_hover_mi < 0 && d1_hover_twn < 0 &&
		d1_hover_ii < 0 && d1_hover_oi < 0)
	{
		D1ScreenToTile(wx, wy, &ttx, &tty);
		name = D1TrigLabelAt(ttx, tty);
		if (name)
		{
			D1HoverNamePos(ttx, tty, 32, D1TextWidth(name), &nx, &ny);
			D1NamePlate(nx, ny, D1TextWidth(name));
			D1TextDrawClr(nx, ny, name, D1COL_WHITE);
		}
	}

	if (d1_opt_enemyhp && mi >= 0 && d1_currlevel != 0)
		D1MonHealthBarDraw(mi);
}

U0 D1HitFlashDraw()
{
	I64 x;
	I64 y;

	if (d1_plr_hitflash <= 0)
		return;
	for (x = 0; x < d1_w; x++)
	{
		D1Pix(x, 0, 229);
		D1Pix(x, 1, 229);
		D1Pix(x, d1_vp_h - 2, 229);
		D1Pix(x, d1_vp_h - 1, 229);
	}
	for (y = 0; y < d1_vp_h; y++)
	{
		D1Pix(0, y, 229);
		D1Pix(1, y, 229);
		D1Pix(d1_w - 2, y, 229);
		D1Pix(d1_w - 1, y, 229);
	}
}

I64 d1_victory_timer = 0;

I64 d1_ui_inv   = -1;
I64 d1_ui_char  = -1;
I64 d1_ui_spell = -1;
I64 d1_ui_quest = -1;
I64 d1_ui_auto  = -1;
I64 d1_ui_store = -1;
I64 d1_save_slot = 0;

U0 D1FloatDraw()
{//devilutionX DrawFloatingNumbers. the anchor runs through ZoomToScreen;
 //text stays 1:1 SmalText.
	I64 i;
	I64 sx;
	I64 sy;
	I64 tw;
	U8	buf[24];

	if (!d1_opt_floatdmg)
		return;
	for (i = 0; i < D1_MAXFLOAT; i++)
	{
		if (d1_floats[i].active)
		{
			D1TileToScreen(d1_floats[i].x, d1_floats[i].y, &sx, &sy);
			//dX: Displacement{TILE_WIDTH/2, -TILE_HEIGHT/2} + rise
			sx += D1_TILE_W / 2;
			sy -= D1_TILE_H / 2 + d1_floats[i].oy;
			if (d1_zoom)
			{
				sx = D1ZoomToScreenX(sx);
				sy = D1ZoomToScreenY(sy);
			}
			if (d1_floats[i].exp)
				StrPrint(buf, "+ %d EXP", d1_floats[i].val);
			else
				StrPrint(buf, "%d", d1_floats[i].val);
			tw = D1TextWidth(buf);
			sx -= tw / 2;
			D1TextDrawSolid(sx - 1, sy, buf, 0);
			D1TextDrawSolid(sx + 1, sy, buf, 0);
			D1TextDrawSolid(sx, sy - 1, buf, 0);
			D1TextDrawSolid(sx, sy + 1, buf, 0);
			if (d1_floats[i].col >= 0)
				D1TextDrawClr(sx, sy, buf, d1_floats[i].col);
			else
				D1TextDrawSolid(sx, sy, buf, D1PalBrightest());
		}
	}
}

U0 D1ItemLabelsDraw()
{//devilutionX ShowItemLabels. white / blue magic / gold unique.
	I64 i;
	I64 sx;
	I64 sy;
	I64 nx;
	I64 ny;
	I64 tw;
	I64 col;
	U8	 buf[D1_AFFNAME];
	CD1Item *it;

	if (!Bt(kbd.down_bitmap, SC_ALT))
		return;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		it = &d1_items[i];
		if (it->active)
		{
			D1TileToScreen(it->x, it->y, &sx, &sy);
			if (sx >= -64 && sx <= d1_w + 64 && sy >= -32 && sy <= d1_vp_h + 64)
			{
				D1ItemLabelStr(i, buf, &col);
				if (buf[0])
				{
					tw = D1TextWidth(buf);
					nx = sx + 32 - tw / 2;
					ny = sy - 40;
					D1TextOutlineClr(nx, ny, buf, col);
				}
			}
		}
	}
}

//error.cpp DrawDiabloMsg geometry. DIALOG_TOP = (480 - 128) / 2 - 18 = 158;
//TextSlid.CEL corners at x 101 and 527, 12px tiles; TRANS_RECT 432x54 at
//(104, DIALOG_TOP - 8). CEL y is a bottom anchor.

U0 D1MsgBoxDraw(U8 *txt)
{
	I64 ox = D1UiOrgX();
	I64 oy = D1UiOrgY();
	I64 y  = oy + D1_MSG_TOP;
	I64 i;
	I64 sx;
	I64 sy;
	I64 tw;

	D1TextSlidLoad;
	if (d1_textslid)
	{
		D1CelDraw(ox + D1_MSG_LX, y,      d1_textslid, 1, D1_MSG_TILE);
		D1CelDraw(ox + D1_MSG_RX, y,      d1_textslid, 4, D1_MSG_TILE);
		D1CelDraw(ox + D1_MSG_LX, y + 48, d1_textslid, 2, D1_MSG_TILE);
		D1CelDraw(ox + D1_MSG_RX, y + 48, d1_textslid, 3, D1_MSG_TILE);
		sx = ox + D1_MSG_LX + 8;
		for (i = 0; i < D1_MSG_EDGEN; i++)
		{
			D1CelDraw(sx, y,      d1_textslid, 5, D1_MSG_TILE);
			D1CelDraw(sx, y + 48, d1_textslid, 7, D1_MSG_TILE);
			sx += D1_MSG_TILE;
		}
		sy = y + D1_MSG_TILE;
		for (i = 0; i < D1_MSG_SIDEN; i++)
		{
			D1CelDraw(ox + D1_MSG_LX, sy, d1_textslid, 6, D1_MSG_TILE);
			D1CelDraw(ox + D1_MSG_RX, sy, d1_textslid, 8, D1_MSG_TILE);
			sy += D1_MSG_TILE;
		}
	}
	D1FillRectTrans(ox + 104, y - 8, 432, 54);

	tw = D1TextWidth(txt);
	sx = ox + D1_MSG_LX;
	if (tw < D1_MSG_FIELD)
		sx += (D1_MSG_FIELD - tw) >> 1;
	D1TextDrawClr(sx, y + 24, txt, D1COL_GOLD);
}

U0 D1ToastDraw()
{
	if (d1_talk_timer > 0 && d1_talk_txt)
		D1MsgBoxDraw(d1_talk_txt);
	else if (d1_victory_timer > 0)
		D1MsgBoxDraw("DIABLO HAS FALLEN");
}

U0 D1GameDraw()
{
	D1Clear(0);
	D1HoverUpdate;
	D1WorldFrame;
	D1AutoDraw;
	D1PanelDraw;
	D1DurIconDraw;
	D1UIDrawAll;
	D1PanelInfoDraw(D1MouseX(), D1MouseY());
	D1UnqInfoDraw;
	D1HoverDraw;
	D1ItemLabelsDraw;
	D1FloatDraw;
	D1ToastDraw;
	D1CursorDraw;
}

U0 D1EnterSel()
{
	D1SelEnter;
	d1_vp_h  = d1_h;
	d1_state = D1ST_SEL;
}

U0 D1MenuAction(I64 act)
{
	if (act == 1)
	{
		d1_net_intent = D1NI_NONE;
		D1EnterSel;
	}
	else if (act == 2)
		d1_quit = TRUE;
	else if (act == D1_ACT_HOST)
	{
		d1_net_intent = D1NI_HOST;
		D1EnterSel;
	}
	else if (act == D1_ACT_JOIN)
	{
		d1_net_intent = D1NI_JOIN;
		D1EnterSel;
	}
}

U0 D1StoreOpened()
{
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (i != d1_ui_store && D1UIIsOpen(i))
			D1UIClose(i);
	}
}

U0 D1PanelUnavail()
{
	d1_talk_txt   = "Not implemented";
	d1_talk_timer = 60;
}

U0 D1PanelAction(I64 act)
{//D1PanelClick codes: 1 menu, 2 inv, 3 spells, 4 char, 5 quests, 6 map,
 //10+n belt slot n
	I64 old;
	I64 slot;

	if (act == 1)
		D1GMenuOpen;
	else if (act == 2)
		D1UIToggle(d1_ui_inv);
	else if (act == 3)
	{
		if (d1_ui_spell >= 0)
			D1UIToggle(d1_ui_spell);
		else
			D1PanelUnavail;
	}
	else if (act == 4)
	{
		if (d1_ui_char >= 0)
			D1UIToggle(d1_ui_char);
		else
			D1PanelUnavail;
	}
	else if (act == 5)
	{
		if (d1_ui_quest >= 0)
			D1UIToggle(d1_ui_quest);
		else
			D1PanelUnavail;
	}
	else if (act == 6)
	{
		if (d1_ui_auto >= 0)
			D1UIToggle(d1_ui_auto);
		else
			D1PanelUnavail;
	}
	else if (act == 7)
	{//DoSpeedBook via SpelIcon
		if (d1_panel_splring_toggle)
			(*d1_panel_splring_toggle)();
	}
	else if (act >= 10)
	{
		slot = act - 10;
		if (D1HoldHas())
		{
			//inv.cpp:1068 belt gate: usable and 1x1; IMISC_BOOK excluded.
			if (d1_itmdefs[d1_hold_itm].misc &&
				d1_itmdefs[d1_hold_itm].misc != D1IM_BOOK)
			{
				old = d1_belt[slot];
				d1_belt[slot] = d1_hold_itm;
				D1ItmSndPlay(d1_belt[slot]);
				D1HoldClear;
				if (old)
					D1HoldTake(old, 0, NULL);
			}
			else
				D1HoldToBelt;
		}
		else
			D1BeltUse(slot);
	}
}

U0 D1GMenuAction(I64 act)
{//gamemenu.cpp. Quit Diablo returns to the main menu; retail exits the program.
	if (act == 1)
	{//gamemenu_save_game
		if (!d1_plr_dead)
		{
			D1SaveWrite(d1_save_slot);
			d1_talk_txt   = "Game saved";
			d1_talk_timer = 60;
		}
	}
	else if (act == 2)
	{//gamemenu_new_game
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
		D1EnterSel;
	}
	else if (act == 3)
	{//gamemenu_load_game
		if (D1SaveRead(d1_save_slot))
			D1ResumeGame;
	}
	else if (act == 4)
	{//gamemenu_quit_game
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
	}
}

U0 D1Input()
{
	I64 m;
	I64 a1 = 0;
	I64 a2 = 0;
	I64 tx;
	I64 ty;

	while (m = MessageScan(&a1, &a2))
	{
		switch (m)
		{
			case MESSAGE_KEY_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelKey(a2, a1);
				else if (d1_state == D1ST_MENU)
					D1MpEditKey(a2, a1);
				break;
			case MESSAGE_MS_L_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelClick(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
				else if (d1_state == D1ST_MENU)
				{
					tx = D1MenuHitTest(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
					if (tx >= 0)
					{
						d1_menu_sel = tx;
						D1MenuAction(D1MenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2)));
						if (d1_menu_screen == 1)
							d1_menu_sel = D1OptRowNorm(d1_menu_sel);
					}
				}
				else if (d1_state == D1ST_GAME && d1_gmenu_open)
				{
					tx = D1GMenuHitTest(D1WinToCanvasX(a1),
						D1WinToCanvasY(a2) - D1UiOrgY());
					if (tx >= 0)
					{
						d1_gmenu_sel = tx;
						D1GMenuAction(D1GMenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2) - D1UiOrgY()));
					}
				}
				else if (d1_state == D1ST_GAME)
				{
					//live cursor, not MessageScan args: a1,a2 carry blit / scroll skew.
					tx = D1MouseX();
					ty = D1MouseY();
					if (d1_panel_splring_click &&
						(*d1_panel_splring_click)(tx, ty))
					{//speedbook ring ate the click
					}
					else if (!D1UIClickAny(tx, ty))
					{
						if (ty >= D1PanelTop())
							D1PanelAction(D1PanelClick(tx, ty));
						else if (D1HoldHas())
						{//InvPutItem
							if (d1_zoom)
							{
								tx = D1ZoomToWorldX(tx);
								ty = D1ZoomToWorldY(ty);
							}
							D1ScreenToTile(tx, ty, &tx, &ty);
							D1HoldDropWorld(tx, ty);
						}
						else
						{
							if (d1_zoom)
							{
								tx = D1ZoomToWorldX(tx);
								ty = D1ZoomToWorldY(ty);
							}
							D1ScreenToTile(tx, ty, &tx, &ty);
							D1PlayClickTo(tx, ty);
						}
					}
				}
				break;
			case MESSAGE_MS_R_DOWN:
				if (d1_state == D1ST_GAME && !d1_gmenu_open)
				{
					tx = D1WinToCanvasX(a1);
					ty = D1WinToCanvasY(a2);
					if (!D1InvRClick(tx, ty) && ty < D1PanelTop() &&
						!(D1UIAnyOpen() && tx >= D1UiOrgX() + D1_UI_W / 2))
					{
						if (d1_zoom)
						{
							tx = D1ZoomToWorldX(tx);
							ty = D1ZoomToWorldY(ty);
						}
						D1ScreenToTile(tx, ty, &tx, &ty);
						if (!d1_net_on)
							D1SpellCast(tx, ty);
					}
				}
				break;
		}
	}
}

U0 D1MenuKeys()
{
	I64 n = D1MenuCount();

	//D1MpEditKey takes ENTER, ESC and BACKSPACE off the message queue.
	if (d1_mp_edit >= 0)
	{
		D1KeyEdge(SC_ENTER, &d1_k_enter);
		D1KeyEdge(SC_ESC, &d1_k_esc);
		return;
	}

	if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
		{
			d1_menu_sel = D1OptRowNext(d1_menu_sel, -1);
			D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
		}
		else
		{
			d1_menu_sel--;
			if (d1_menu_sel < 0)
				d1_menu_sel = n - 1;
		}
	}
	if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
		{
			d1_menu_sel = D1OptRowNext(d1_menu_sel, 1);
			D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
		}
		else
		{
			d1_menu_sel++;
			if (d1_menu_sel >= n)
				d1_menu_sel = 0;
		}
	}
	if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, -1);
	}
	if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, 1);
	}
	if (D1KeyEdge(SC_ENTER, &d1_k_enter))
	{
		D1MenuAction(D1MenuActivate(d1_menu_sel));
		if (d1_menu_screen == 1)
			d1_menu_sel = D1OptRowNorm(d1_menu_sel);
	}
	if (D1KeyEdge(SC_ESC, &d1_k_esc))
	{
		if (d1_menu_screen == 1)
		{
			d1_menu_screen = 0;
			d1_menu_sel    = 0;
			D1OptSave;
		}
		else if (d1_menu_screen == 2)
		{
			d1_menu_screen = 0;
			d1_menu_sel    = 1;
		}
		else
			D1EnterTitle;
	}
}

U0 Diablo1()
{
	F64 now;
	I64 i;
	I64 hx;
	I64 hy;
	I64 dz;

	//a Spawn()ed task owns no put/display doc. (QuakePlus Quake.ZC)
	if (!DocPut)
		DocTermNew;

	DocClear;
	"$$LTRED$$Diablo$$FG$$ for ZealOS - loading DIABDAT.MPQ...\n";

	D1ScreenInit;

	if (!d1_mpq_ready)
	{
		if (!D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ"))
		{
			"Put DIABDAT.MPQ (retail or shareware) at ::/Apps/Diablo1/\n";
			return;
		}
	}
	if (!D1AssetsLoad())
		return;
	D1SndInit;
	//include-time D1OptLoad can run before ::/Apps is mounted.
	D1OptLoad;
	D1SndMusVolApply;

	//WIG_USER_TASK_DEFAULT is the base a terminal runs with; inhibits are added,
	//not subtracted. (QuakePlus Quake.ZC)
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT | WIF_SELF_GRAB_SCROLL |
					  WIF_FOCUS_TASK_MENU;
	AutoComplete;
	WinBorder;
	WinMax;
	D1WindowApply;
	WinToTop;
	DocCursor;
	DocClear;

	Fs->task_end_cb = &D1TaskEndCB;

	for (i = 0; i < 8; i++)
		d1_k_belt[i] = FALSE;
	d1_plr_name[0] = 0;

	d1_wheel_prev = mouse_hard.pos.z;

	D1UIInit;
	d1_ui_inv = D1UIRegister(&d1_inv_open, &D1InvToggle, &D1InvDraw,
		&D1InvClick, D1UIS_RIGHT);
	d1_ui_char = D1UIRegister(&d1_char_open, &D1CharUIToggle, &D1CharUIDraw,
		&D1CharUIClick, D1UIS_LEFT);
	d1_ui_spell = D1UIRegister(&d1_spell_open, &D1SpellToggle, &D1SpellDraw,
		&D1SpellClick, D1UIS_RIGHT);
	d1_ui_quest = D1UIRegister(&d1_quest_open, &D1QuestToggle, &D1QuestDraw,
		&D1QuestClick, D1UIS_LEFT);
	d1_ui_store = D1UIRegister(&d1_store_open, &D1StoreToggle, &D1StoreDraw,
		&D1StoreClick, D1UIS_FULL);
	d1_ui_auto = D1UIRegister(&d1_auto_open, &D1AutoToggle, NULL, NULL,
		D1UIS_OVERLAY);

	D1EnterTitle;
	d1_quit  = FALSE;
	d1_ready = TRUE;
	Fs->draw_it = &D1DrawIt;

	//DE.ZC DEBarRebuild lists only tasks carrying DISPLAYf_SHOW; set after draw_it.
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinFocus;

	while (!d1_quit)
	{
		D1Input;
		D1FadeStep;
		d1_anim++;

		if (sys_focus_task == Fs)
			D1MouseHide;
		else
			D1MouseShow;

		switch (d1_state)
		{
			case D1ST_TITLE:
				D1TitleDraw(d1_anim);
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
					d1_quit = TRUE;
				if (D1KeyEdge(SC_ENTER, &d1_k_enter))
					D1EnterMenu;
				break;

			case D1ST_SEL:
				i = D1SelOutcome();
				if (i)
				{
					D1SelOutcomeClear;
					d1_save_slot = d1_sel_target;
					if (i == 3)
					{
						d1_net_intent = D1NI_NONE;
						D1EnterMenu;
					}
					else if (d1_net_intent != D1NI_NONE)
					{
						D1EnterLobby;
					}
					else if (i == 1)
						D1ResumeGame;
					else
						D1EnterGame;
					break;
				}
				D1SelKeys;
				D1SelDraw;
				D1CursorDraw;
				break;

			case D1ST_LOBBY:
				D1LobbyFrame;
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
				{
					D1NetLeave;
					d1_net_intent = D1NI_NONE;
					D1EnterMenu;
				}
				break;

			case D1ST_MENU:
				hx = D1MouseX();
				hy = D1MouseY();
				if (hx != d1_hov_mx || hy != d1_hov_my)
				{
					d1_hov_mx = hx;
					d1_hov_my = hy;
					i = D1MenuHitTest(hx, hy);
					if (i >= 0 && i != d1_menu_sel)
					{
						D1MenuMoveSnd;
						d1_menu_sel = i;
						if (d1_menu_screen == 1)
							D1OptScrollClamp(d1_menu_sel, D1OPT_UI_VIS);
					}
				}
				dz = D1WheelDz;
				if (dz)
				{
					if (d1_menu_screen == 1)
					{
						D1MenuMoveSnd;
						d1_menu_sel = D1OptWheel(d1_menu_sel, dz, D1OPT_UI_VIS);
					}
					else
					{
						D1MenuMoveSnd;
						if (dz < 0)
						{
							d1_menu_sel++;
							if (d1_menu_sel >= D1MenuCount())
								d1_menu_sel = 0;
						}
						else
						{
							d1_menu_sel--;
							if (d1_menu_sel < 0)
								d1_menu_sel = D1MenuCount() - 1;
						}
					}
				}
				if (mouse.lb)
					D1MenuDrag(D1MouseX(), D1MouseY());
				else
					d1_optl_drag = -1;
				D1MenuDraw(d1_menu_sel, d1_anim / 3);
				D1CursorDraw;
				D1MenuKeys;
				break;

			case D1ST_GAME:
				if (d1_gmenu_open)
				{
					d1_tick_t = tS;
					D1GameDraw;
					D1GMenuDraw(d1_gmenu_sel, d1_anim / 3);
					D1CursorDraw;
					hx = D1MouseX();
					hy = D1MouseY();
					if (hx != d1_hov_mx || hy != d1_hov_my)
					{
						d1_hov_mx = hx;
						d1_hov_my = hy;
						i = D1GMenuHitTest(hx, hy - D1UiOrgY());
						if (i >= 0 && i != d1_gmenu_sel)
						{
							D1MenuMoveSnd;
							d1_gmenu_sel = i;
							if (d1_gmenu_screen == 1)
								D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
					}
					dz = D1WheelDz;
					if (dz)
					{
						if (d1_gmenu_screen == 1)
						{
							D1MenuMoveSnd;
							d1_gmenu_sel = D1OptWheel(d1_gmenu_sel, dz,
								D1OPT_GM_VIS);
						}
						else
						{
							D1MenuMoveSnd;
							if (dz < 0)
							{
								d1_gmenu_sel++;
								if (d1_gmenu_sel >= D1GMenuCount())
									d1_gmenu_sel = 0;
							}
							else
							{
								d1_gmenu_sel--;
								if (d1_gmenu_sel < 0)
									d1_gmenu_sel = D1GMenuCount() - 1;
							}
						}
					}
					if (mouse.lb)
						D1GMenuDrag(D1MouseX());
					else
						d1_optl_drag = -1;
					if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, -1);
							D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
						else
						{
							d1_gmenu_sel--;
							if (d1_gmenu_sel < 0)
								d1_gmenu_sel = D1GMenuCount() - 1;
						}
					}
					if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, 1);
							D1OptScrollClamp(d1_gmenu_sel, D1OPT_GM_VIS);
						}
						else
						{
							d1_gmenu_sel++;
							if (d1_gmenu_sel >= D1GMenuCount())
								d1_gmenu_sel = 0;
						}
					}
					if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, -1);
					}
					if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, 1);
					}
					if (D1KeyEdge(SC_ENTER, &d1_k_enter))
						D1GMenuAction(D1GMenuActivate(d1_gmenu_sel));
					if (D1KeyEdge(SC_ESC, &d1_k_esc))
					{
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_screen = 0;
							d1_gmenu_sel    = 1;
							D1OptSave;
						}
						else
							D1GMenuClose;
					}
					break;
				}
				now = tS;
				while (now - d1_tick_t >= 0.05)
				{
					if (d1_net_on)
					{
						if (!D1PeerNetFrame())
							break;
						D1AutoMark(d1_plr_x, d1_plr_y);
					}
					else
					{
						D1PlayTick;
						D1AutoMark(d1_plr_x, d1_plr_y);
						D1MonTickAll;
						D1MisTick;
						D1SpellTick;
						D1ItemTickAll;
						D1ObjTickAll;
						if (d1_currlevel == 0)
						{
							D1TownersTick;
							D1TownerDlgTick;
						}
					}
					d1_tick_t += 0.05;
				}
				for (i = 0; i < 8; i++)
				{
					if (D1KeyEdge(Char2ScanCode('1' + i), &d1_k_belt[i]))
						D1BeltUse(i);
				}
				if (d1_diablo_slain)
				{
					D1QuestComplete(D1Q_DIABLO);
					d1_diablo_slain  = FALSE;
					d1_victory_timer = 200;
				}
				if (d1_victory_timer > 0)
				{
					d1_victory_timer--;
					if (d1_victory_timer == 0)
					{
						D1EnterMenu;
						break;
					}
				}
				if (d1_warp_to >= 0)
				{
					D1LoadLevel(d1_warp_to, d1_warp_entry);
					if (!d1_plr_dead)
						D1SaveWrite(d1_save_slot);
				}
				D1GameDraw;
				if (D1KeyEdge(Char2ScanCode('z'), &d1_k_zoom))
					D1ZoomToggle;
				if (D1KeyEdge(Char2ScanCode('w'), &d1_k_width))
				{
					D1WidthCycle;
					d1_vp_h = D1PanelTop();
				}
				dz = D1WheelDz;
				if (dz)
				{
					if (dz < 0)
						D1ZoomStep(1);
					else
						D1ZoomStep(-1);
				}
				if (D1KeyEdge(Char2ScanCode('i'), &d1_k_inv))
					D1UIToggle(d1_ui_inv);
				if (d1_store_open)
				{
					D1StoreOpened;
					D1StoreKeys;
					hx = D1MouseX();
					hy = D1MouseY();
					if (hx != d1_hov_mx || hy != d1_hov_my)
					{
						d1_hov_mx = hx;
						d1_hov_my = hy;
						D1StoreHover(hx, hy);
					}
				}
				if (D1KeyEdge(Char2ScanCode('c'), &d1_k_char))
					D1UIToggle(d1_ui_char);
				if (D1KeyEdge(Char2ScanCode('s'), &d1_k_spellbk))
					D1UIToggle(d1_ui_spell);
				if (D1KeyEdge(SC_TAB, &d1_k_map))
					D1UIToggle(d1_ui_auto);
				if (D1KeyEdge(Char2ScanCode('q'), &d1_k_quest))
					D1UIToggle(d1_ui_quest);
				if (D1KeyEdge(Char2ScanCode('='), &d1_k_zin))
					D1AutoZoom(1);
				if (D1KeyEdge(Char2ScanCode('-'), &d1_k_zout))
					D1AutoZoom(-1);
				if (mouse.lb && d1_state == D1ST_GAME)
				{//diablo.cpp sgbMouseDown: button state, not message edge
					hx = D1MouseX();
					hy = D1MouseY();
					if (hy < d1_vp_h && !D1UICovers(hx))
					{
						if (d1_zoom)
						{
							hx = D1ZoomToWorldX(hx);
							hy = D1ZoomToWorldY(hy);
						}
						D1ScreenToTile(hx, hy, &hx, &hy);
						D1PlayHeldWalk(hx, hy);
					}
				}
				if (D1KeyEdge(SC_ESC, &d1_k_esc) && !d1_store_open)
				{//devilutionX PressEscKey
					D1GMenuOpen;
				}
				break;
		}

		Sleep(15);
	}

	Fs->task_end_cb = NULL;
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	WinBorder;
	DocCursor;
	//a click-parked doc cursor makes the shell insert typed lines into old text.
	if (Fs->put_doc)
	{
		Fs->put_doc->cur_entry = &Fs->put_doc->head;
		Fs->put_doc->cur_col   = 0;
	}
	Fs->title_src = TTS_LOCKED_CONST;
	D1OptSave;
	D1SndFree;
	DocClear;
	"Diablo1: bye.\n";
}
