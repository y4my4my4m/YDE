// Diablo1.ZC - app shell: window, input, game loop
//
// rendering runs on this task; the blit runs in the draw_it callback on the
// window manager task and reads d1_screen through d1_argb (D1Draw).
//
// game logic ticks at 20Hz (the original's rate); rendering runs as fast
// as the loop spins, which on this renderer is plenty.

#define D1ST_TITLE		0
#define D1ST_MENU		1
#define D1ST_GAME		2

I64	 d1_state    = D1ST_TITLE;
I64	 d1_menu_sel = 0;
I64	 d1_anim     = 0;
Bool d1_quit     = FALSE;
U8	*d1_cursor   = NULL;			//Data\Inv\Objcurs.CEL
F64	 d1_tick_t   = 0.0;
I64	 d1_fade     = 0;				//0..256 palette fade-in

Bool d1_k_up    = FALSE;
Bool d1_k_down  = FALSE;
Bool d1_k_enter = FALSE;
Bool d1_k_esc   = FALSE;

Bool D1KeyEdge(I64 sc, Bool *held)
{//one TRUE per press
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

I64 D1WinToCanvasX(I64 wx)
{//window-relative pixels (MessageScan args) -> canvas coords
	if (d1_blit_w < 1)
		return 0;
	return ((wx - d1_blit_x) * D1_W) / d1_blit_w;
}

I64 D1WinToCanvasY(I64 wy)
{
	if (d1_blit_h < 1)
		return 0;
	return ((wy - d1_blit_y) * D1_H) / d1_blit_h;
}

Bool D1AssetsLoad()
{
	I64 size = 0;

	d1_smaltext = D1MpqRead("CtrlPan\\SmalText.CEL", &size);
	d1_pentspin = D1MpqRead("Data\\PentSpin.CEL", &size);
	d1_cursor   = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);

	if (!d1_smaltext)
	{
		"Diablo1: SmalText.CEL missing\n";
		return FALSE;
	}
	return TRUE;
}

U0 D1FadeReset()
{
	d1_fade = 0;
	D1PalFadeLevel(0);
}

U0 D1FadeStep()
{
	if (d1_fade < 256)
	{
		d1_fade += 16;
		D1PalFadeLevel(d1_fade);
	}
}

U0 D1EnterTitle()
{
	D1TitleLoad;
	D1PalSetRaw(d1_title_pal);
	D1FadeReset;
	d1_state = D1ST_TITLE;
}

U0 D1EnterMenu()
{
	D1MMenuLoad;
	if (d1_mmenu_img)
		D1PalSetRaw(d1_mmenu_pal);
	D1FadeReset;
	d1_menu_sel = 0;
	d1_state    = D1ST_MENU;
}

U0 D1EnterGame()
{
	D1CutShow("Gendata\\Cuttt.CEL", "Gendata\\Cuttt.pal");
	D1PalFadeLevel(256);
	Sleep(60);			//let the compositor show the cut screen

	if (!d1_lvl_ready)
	{
		if (!D1TownLoad())
		{
			"Diablo1: town load failed\n";
			D1EnterMenu;
			return;
		}
	}
	else
		D1PalLoad("Levels\\TownData\\Town.pal");

	if (!d1_play_ready)
		D1PlayInit;

	D1FadeReset;
	d1_tick_t = tS;
	d1_state  = D1ST_GAME;
}

U0 D1CursorDraw()
{//hand cursor, frame 1, 33x29, tip at the mouse point
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	if (d1_cursor)
		D1CelDrawClipped(mx, my + 28, d1_cursor, 1, 33);
	else
	{
		D1Pix(mx, my, 255);
		D1Pix(mx + 1, my, 255);
		D1Pix(mx, my + 1, 255);
	}
}

U0 D1GameDraw()
{
	D1Clear(0);
	D1WorldDraw;
	D1CursorDraw;
}

U0 D1Input()
{//queued messages: clicks and the title's any-key
	I64 m;
	I64 a1 = 0;
	I64 a2 = 0;
	I64 tx;
	I64 ty;

	while (m = MessageScan(&a1, &a2))
	{
		switch (m)
		{
			case MESSAGE_KEY_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				break;
			case MESSAGE_MS_L_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_GAME)
				{
					D1ScreenToTile(D1WinToCanvasX(a1), D1WinToCanvasY(a2),
						&tx, &ty);
					D1PlayClickTo(tx, ty);
				}
				break;
		}
	}
}

U0 D1MenuKeys()
{
	if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
	{
		d1_menu_sel--;
		if (d1_menu_sel < 0)
			d1_menu_sel = D1_MENU_COUNT - 1;
	}
	if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
	{
		d1_menu_sel++;
		if (d1_menu_sel >= D1_MENU_COUNT)
			d1_menu_sel = 0;
	}
	if (D1KeyEdge(SC_ENTER, &d1_k_enter))
	{
		if (d1_menu_sel == 0)
			D1EnterGame;
		else if (d1_menu_sel == 1)
			;					//about: drawn inline below
		else
			d1_quit = TRUE;
	}
	if (D1KeyEdge(SC_ESC, &d1_k_esc))
		D1EnterTitle;
}

U0 Diablo1()
{
	F64 now;

	DocClear;
	"$$LTRED$$Diablo$$FG$$ for ZealOS - loading DIABDAT.MPQ...\n";

	D1ScreenInit;

	if (!d1_mpq_ready)
	{
		if (!D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ"))
		{
			"Put DIABDAT.MPQ (retail or shareware) at ::/Apps/Diablo1/\n";
			return;
		}
	}
	if (!D1AssetsLoad())
		return;

	WinMax;
	WinToTop;
	DocClear;

	D1EnterTitle;
	d1_quit  = FALSE;
	d1_ready = TRUE;
	Fs->draw_it = &D1DrawIt;

	while (!d1_quit)
	{
		D1Input;
		D1FadeStep;
		d1_anim++;

		switch (d1_state)
		{
			case D1ST_TITLE:
				D1TitleDraw(d1_anim);
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
					d1_quit = TRUE;
				if (D1KeyEdge(SC_ENTER, &d1_k_enter))
					D1EnterMenu;
				break;

			case D1ST_MENU:
				D1MenuDraw(d1_menu_sel, d1_anim / 4);
				if (d1_menu_sel == 1)
					D1TextDraw(D1_W / 2 - D1TextWidth("YDE port of Devilution - non-commercial") / 2,
						420, "YDE port of Devilution - non-commercial");
				D1MenuKeys;
				break;

			case D1ST_GAME:
				now = tS;
				while (now - d1_tick_t >= 0.05)
				{
					D1PlayTick;
					d1_tick_t += 0.05;
				}
				D1GameDraw;
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
					D1EnterMenu;
				break;
		}

		Sleep(15);
	}

	//teardown: stop the compositor reading the canvas before anything dies
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	DocClear;
	"Diablo1: bye.\n";
}
