// Diablo1.ZC - app shell: window, input, game loop
//
// rendering runs on this task; the blit runs in the draw_it callback on the
// window manager task and reads d1_screen through d1_argb (D1Draw).
//
// game logic ticks at 20Hz (the original's rate). level changes are
// requested by D1Play through d1_warp_to and performed here between
// frames, behind a cut screen.

#define D1ST_TITLE		0
#define D1ST_MENU		1
#define D1ST_GAME		2
#define D1ST_SEL		3		//character select / create

I64	 d1_state    = D1ST_TITLE;
I64	 d1_menu_sel = 0;
I64	 d1_anim     = 0;
Bool d1_quit     = FALSE;
U8	*d1_cursor   = NULL;			//Data\Inv\Objcurs.CEL
F64	 d1_tick_t   = 0.0;
I64	 d1_fade     = 0;				//0..256 palette fade-in
Bool d1_k_belt[8];
Bool d1_k_zoom = FALSE;
Bool d1_k_inv  = FALSE;
Bool d1_k_map  = FALSE;
Bool d1_k_char = FALSE;
Bool d1_k_spellbk = FALSE;
Bool d1_k_quest = FALSE;
Bool d1_k_zin  = FALSE;
Bool d1_k_zout = FALSE;
Bool d1_k_width = FALSE;
I64	 d1_wheel_prev = 0;

Bool d1_k_up    = FALSE;
Bool d1_k_down  = FALSE;
Bool d1_k_left  = FALSE;
Bool d1_k_right = FALSE;
Bool d1_k_enter = FALSE;
Bool d1_k_esc   = FALSE;

Bool D1KeyEdge(I64 sc, Bool *held)
{//one TRUE per press
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
		*held = FALSE;
	return FALSE;
}

I64 D1WinToCanvasX(I64 wx)
{//window-relative pixels (MessageScan args) -> canvas coords
	if (d1_blit_w < 1)
		return 0;
	return ((wx - d1_blit_x) * d1_w) / d1_blit_w;
}

I64 D1WinToCanvasY(I64 wy)
{
	if (d1_blit_h < 1)
		return 0;
	return ((wy - d1_blit_y) * d1_h) / d1_blit_h;
}

Bool D1AssetsLoad()
{
	I64 size = 0;

	d1_smaltext = D1MpqRead("CtrlPan\\SmalText.CEL", &size);
	d1_pentspin = D1MpqRead("Data\\PentSpin.CEL", &size);
	d1_cursor   = D1MpqRead("Data\\Inv\\Objcurs.CEL", &size);

	if (!d1_smaltext)
	{
		"Diablo1: SmalText.CEL missing\n";
		return FALSE;
	}
	D1MakeLightTable;
	D1PanelInit;
	D1QuestInit;
	return TRUE;
}

U0 D1FadeReset()
{
	d1_fade = 0;
	D1PalFadeLevel(0);
}

U0 D1FadeStep()
{
	if (d1_fade < 256)
	{
		d1_fade += 16;
		D1PalFadeLevel(d1_fade);
	}
}

U0 D1EnterTitle()
{
	if (d1_opt_music)
		D1SndMusic("Music\\Dintro.wav");
	D1TitleLoad;
	D1PalSetRaw(d1_title_pal);
	D1FadeReset;
	d1_vp_h  = d1_h;
	d1_state = D1ST_TITLE;
}

U0 D1EnterMenu()
{
	D1MMenuLoad;
	if (d1_mmenu_img)
		D1PalSetRaw(d1_mmenu_pal);
	D1FadeReset;
	d1_vp_h     = d1_h;
	d1_menu_sel = 0;
	d1_menu_screen = 0;
	d1_state    = D1ST_MENU;
}

U0 D1LoadLevel(I64 level, I64 entry)
{//behind a cut screen. places the player and clears any pending warp.
	if (level == 0)
		D1CutShow("Gendata\\Cuttt.CEL", "Gendata\\Cuttt.pal");
	else if (level <= 4)
		D1CutShow("Gendata\\Cutl1d.CEL", "Gendata\\Cutl1d.pal");
	else if (level <= 8)
		D1CutShow("Gendata\\Cut2.CEL", "Gendata\\Cut2.pal");
	else if (level <= 12)
		D1CutShow("Gendata\\Cut3.CEL", "Gendata\\Cut3.pal");
	else
		D1CutShow("Gendata\\Cut4.CEL", "Gendata\\Cut4.pal");
	D1PalFadeLevel(256);
	Sleep(60);			//let the compositor show the cut screen
	if (d1_opt_music)
		D1SndMusicForLevel(level);

	D1MonClearAll;

	D1MisClear;
	D1SpellFxClear;
	D1ItemClear;
	D1ObjClear;

	if (level == 0)
	{
		if (!D1TownLoad())
		{
			"Diablo1: town load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1TownersInit;
		D1LightClear(0);
		if (entry == 1)
			D1PlacePlayer(25, 31);		//south of the cathedral entrance
		else
			D1PlacePlayer(75, 68);		//new game spawn
	}
	else
	{
		Bool lok;

		if (level <= 4)
			lok = D1L1LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 8)
			lok = D1L2LevelLoad(level, d1_lvl_seeds[level], entry);
		else if (level <= 12)
			lok = D1L3LevelLoad(level, d1_lvl_seeds[level], entry);
		else
			lok = D1L4LevelLoad(level, d1_lvl_seeds[level], entry);

		if (!lok)
		{
			"Diablo1: dungeon load failed\n";
			d1_warp_to = -1;
			D1EnterMenu;
			return;
		}
		D1LightClear(level);
		D1PlacePlayer(d1_lvl_vx, d1_lvl_vy);
		D1LightUpdate(d1_plr_x, d1_plr_y);
		D1MonSpawnLevel(level, d1_plr_x, d1_plr_y);
		D1ObjSpawnLevel(level);
		if (level == 16)
			D1MonSpawnDiablo(d1_plr_x, d1_plr_y);
	}

	D1AutoClear;
	D1AutoMark(d1_plr_x, d1_plr_y);
	D1QuestLevelEnter(level);

	d1_warp_to = -1;
	D1FadeReset;
	d1_tick_t = tS;
	d1_vp_h   = D1PanelTop();
	d1_state  = D1ST_GAME;
}

U0 D1EnterGame()
{//fresh character unless one was created by the front end
	if (!d1_plr_name[0])
		D1CharCreate(D1CL_WARRIOR, "Aidan");

	//unconditional: this is what reloads the gfx set after a class change
	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_hp   = d1_plr_maxhp;
	d1_plr_dead = FALSE;
	D1LoadLevel(0, 0);
}

U0 D1ResumeGame()
{//loaded character: keep its hp/mana and drop it on its saved level
	I64 lvl = d1_currlevel;

	if (!D1PlayInit())
	{
		D1EnterMenu;
		return;
	}
	d1_plr_dead = FALSE;
	D1LoadLevel(lvl, 0);
}

//OS mouse sprite. the game draws its own Objcurs hand, so the window
//manager's pointer is suppressed while this task holds focus and put back
//when it does not. Demo/Graphics/Grid.ZC saves and restores the same hook.
//mouse.show is not usable: the PS/2 handler (Kernel/SerialDev/Mouse.ZC:437)
//sets it TRUE on every packet outside raw mode, and raw mode stops
//mouse.pos tracking, which this port's absolute pointer needs. the focus
//test is sys_focus_task == Fs, the same exact-task match Mouse.ZC:374 uses
//to scope raw mode for the HL1 port.
U0 (*d1_old_draw_mouse)(CDC *dc, I64 x, I64 y) = NULL;
Bool d1_mouse_hidden = FALSE;

U0 D1MouseHide()
{
	if (d1_mouse_hidden)
		return;
	d1_old_draw_mouse = gr.fp_draw_mouse;
	gr.fp_draw_mouse  = NULL;		//Win.ZC DrawMouse skips a NULL hook
	d1_mouse_hidden   = TRUE;
}

U0 D1MouseShow()
{
	if (!d1_mouse_hidden)
		return;
	gr.fp_draw_mouse = d1_old_draw_mouse;
	d1_mouse_hidden  = FALSE;
}

U0 D1TaskEndCB()
{//kill path: window close, <CTRL-ALT-x>, Kill() from the shell. TaskEnd
 //(Kernel/KTask.ZC:508) redirects rip here instead of ending the task, so
 //the loop's teardown never runs. the compositor reads d1_screen through
 //draw_it and the mixer holds voice buffers in this task's heap.
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	D1SndFree;
	Exit;
}

U0 D1CursorDraw()
{//game states use the Objcurs hand (game palette); title/menu use the
 //DiabloUI arrow - the hand's colors are garbage through menu palettes
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	if (d1_state != D1ST_GAME && d1_ui_cursor)
	{
		D1Blit8Key(mx, my, d1_ui_cursor, 36, 30, 0);
		return;
	}
	if (d1_cursor)
		D1CelDrawClipped(mx, my + 28, d1_cursor, 1, 33);
	else
	{
		D1Pix(mx, my, 255);
		D1Pix(mx + 1, my, 255);
		D1Pix(mx, my + 1, 255);
	}
}

Bool D1UICovers(I64 cx)
{//an open side panel owns its half of the UI band, a FULL panel all of it.
 //cursor.cpp CheckCursMove drops the hover under an open panel.
	I64 i;
	I64 ox  = D1UiOrgX();
	I64 mid = ox + D1_UI_W / 2;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (D1UIIsOpen(i))
		{
			if (d1_ui_panels[i].side == D1UIS_FULL)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_LEFT && cx >= ox && cx < mid)
				return TRUE;
			if (d1_ui_panels[i].side == D1UIS_RIGHT && cx >= mid &&
				cx < ox + D1_UI_W)
				return TRUE;
		}
	}
	return FALSE;
}

U0 D1HoverUpdate()
{//cursor actor for this frame, into the D1Render globals the world pass
 //outlines. CheckCursMove reduced: the AtCurs tests take the tile above an
 //actor's foot tile too.
	I64 tx = 0;
	I64 ty = 0;
	I64 mx = D1MouseX();
	I64 my = D1MouseY();

	d1_hover_mi  = -1;
	d1_hover_twn = -1;
	if (my >= d1_vp_h || D1UICovers(mx) || d1_gmenu_open)
		return;

	if (d1_zoom)
	{//inverse of the scale transform, any scale
		mx = D1ZoomToWorldX(mx);
		my = D1ZoomToWorldY(my);
	}
	D1ScreenToTile(mx, my, &tx, &ty);

	if (d1_currlevel == 0)
		d1_hover_twn = D1TownerAtCurs(tx, ty);
	else
		d1_hover_mi = D1MonAtCurs(tx, ty);
}

U0 D1HoverDraw()
{//hovered towner / monster name over the actor, and the hover health bar.
 //the name is world space, not the UI band.
	I64	 mi = d1_hover_mi;
	I64	 ti = d1_hover_twn;
	I64	 tx = 0;
	I64	 ty = 0;
	I64	 nx = 0;
	I64	 ny = 0;
	I64	 sprite_h = 0;
	I64	 full;
	I64	 bar;
	U8	*name = NULL;

	if (ti >= 0)
	{
		name     = d1_twn[ti].name;
		sprite_h = d1_twn[ti].h;
		tx       = d1_twn[ti].x;
		ty       = d1_twn[ti].y;
	}
	else if (mi >= 0)
	{
		name     = d1_montypes[d1_mons[mi].type].name;
		sprite_h = d1_montypes[d1_mons[mi].type].height;
		tx       = d1_mons[mi].x;
		ty       = d1_mons[mi].y;
	}

	if (!name && d1_currlevel >= 0)
	{//no actor under the cursor: a warp trigger labels its tile
		I64 wx = D1MouseX();
		I64 wy = D1MouseY();
		I64 ttx = 0;
		I64 tty = 0;

		if (d1_zoom)
		{
			wx = D1ZoomToWorldX(wx);
			wy = D1ZoomToWorldY(wy);
		}
		if (wy < d1_vp_h && !D1UICovers(wx))
		{
			D1ScreenToTile(wx, wy, &ttx, &tty);
			name = D1TrigLabelAt(ttx, tty);
			if (name)
			{
				tx       = ttx;
				ty       = tty;
				sprite_h = 32;
			}
		}
	}

	if (name)
	{
		D1HoverNamePos(tx, ty, sprite_h, D1TextWidth(name), &nx, &ny);
		D1TextDrawSolid(nx, ny, name, D1PalBrightest());
	}

	if (mi >= 0)
	{//health bar over the viewport top (devilutionX QOL)
		full = d1_montypes[d1_mons[mi].type].hp_max << 6;
		if (full > 0)
		{
			bar = (200 * d1_mons[mi].hp) / full;
			if (bar < 0)
				bar = 0;
			if (bar > 200)
				bar = 200;
			D1FillRect(d1_w / 2 - 102, 6, 204, 10, 0);
			D1FillRect(d1_w / 2 - 100, 8, bar, 6, 229);
		}
	}
}

U0 D1HitFlashDraw()
{//red frame around the viewport while fresh damage stings
	I64 x;
	I64 y;

	if (d1_plr_hitflash <= 0)
		return;
	for (x = 0; x < d1_w; x++)
	{
		D1Pix(x, 0, 229);
		D1Pix(x, 1, 229);
		D1Pix(x, d1_vp_h - 2, 229);
		D1Pix(x, d1_vp_h - 1, 229);
	}
	for (y = 0; y < d1_vp_h; y++)
	{
		D1Pix(0, y, 229);
		D1Pix(1, y, 229);
		D1Pix(d1_w - 2, y, 229);
		D1Pix(d1_w - 1, y, 229);
	}
}

I64 d1_victory_timer = 0;

//panel registry indices, filled by D1UISetup
I64 d1_ui_inv   = -1;
I64 d1_ui_char  = -1;
I64 d1_ui_spell = -1;
I64 d1_ui_quest = -1;
I64 d1_ui_auto  = -1;
I64 d1_ui_store = -1;
I64 d1_save_slot = 0;			//slot the front end picked, used by autosave

U0 D1GameDraw()
{
	D1Clear(0);
	D1HoverUpdate;
	D1WorldFrame;
	D1AutoDraw;
	D1PanelDraw;
	D1UIDrawAll;
	D1HoverDraw;
	if (d1_talk_timer > 0 && d1_talk_txt)
		D1TextDrawSolid(D1UiOrgX() + D1_UI_W / 2 -
			D1TextWidth(d1_talk_txt) / 2, D1PanelTop() + 116, d1_talk_txt,
			D1PalBrightest());
	if (d1_victory_timer > 0)
		D1TextDrawSolid(d1_w / 2 - D1TextWidth("DIABLO HAS FALLEN") / 2,
			160, "DIABLO HAS FALLEN", D1PalBrightest());
	D1HitFlashDraw;
	D1CursorDraw;
}

U0 D1EnterSel()
{
	D1SelEnter;
	d1_vp_h  = d1_h;
	d1_state = D1ST_SEL;
}

U0 D1MenuAction(I64 act)
{
	if (act == 1)
		D1EnterSel;
	else if (act == 2)
		d1_quit = TRUE;
}

U0 D1StoreOpened()
{//D1Play opens stores directly; clear the other panels so the full-screen
 //store is not drawn under them
	I64 i;

	for (i = 0; i < d1_ui_count; i++)
	{
		if (i != d1_ui_store && D1UIIsOpen(i))
			D1UIClose(i);
	}
}

U0 D1PanelUnavail()
{
	d1_talk_txt   = "Not implemented";
	d1_talk_timer = 60;
}

U0 D1PanelAction(I64 act)
{//D1PanelClick codes: 1 menu, 2 inv, 3 spells, 4 char, 5 quests, 6 map,
 //10+n belt slot n
	if (act == 1)
		D1EnterMenu;
	else if (act == 2)
		D1UIToggle(d1_ui_inv);
	else if (act == 3)
	{
		if (d1_ui_spell >= 0)
			D1UIToggle(d1_ui_spell);
		else
			D1PanelUnavail;
	}
	else if (act == 4)
	{
		if (d1_ui_char >= 0)
			D1UIToggle(d1_ui_char);
		else
			D1PanelUnavail;
	}
	else if (act == 5)
	{
		if (d1_ui_quest >= 0)
			D1UIToggle(d1_ui_quest);
		else
			D1PanelUnavail;
	}
	else if (act == 6)
	{
		if (d1_ui_auto >= 0)
			D1UIToggle(d1_ui_auto);
		else
			D1PanelUnavail;
	}
	else if (act >= 10)
		D1BeltUse(act - 10);
}

U0 D1GMenuAction(I64 act)
{//gamemenu.cpp dispatch on the shell's existing paths. Quit Diablo leaves
 //for the main menu through the autosave the old ESC exit used; retail
 //quits the program outright.
	if (act == 1)
	{//gamemenu_save_game
		if (!d1_plr_dead)
		{
			D1SaveWrite(d1_save_slot);
			d1_talk_txt   = "Game saved";
			d1_talk_timer = 60;
		}
	}
	else if (act == 2)
	{//gamemenu_new_game: back through the front end to character select
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
		D1EnterSel;
	}
	else if (act == 3)
	{//gamemenu_load_game: reload the slot and re-enter its level
		if (D1SaveRead(d1_save_slot))
			D1ResumeGame;
	}
	else if (act == 4)
	{//gamemenu_quit_game
		if (!d1_plr_dead)
			D1SaveWrite(d1_save_slot);
		D1EnterMenu;
	}
}

U0 D1Input()
{//queued messages: clicks and the title's any-key
	I64 m;
	I64 a1 = 0;
	I64 a2 = 0;
	I64 tx;
	I64 ty;

	while (m = MessageScan(&a1, &a2))
	{
		switch (m)
		{
			case MESSAGE_KEY_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelKey(a2, a1);		//name entry takes typed chars
				break;
			case MESSAGE_MS_L_DOWN:
				if (d1_state == D1ST_TITLE)
					D1EnterMenu;
				else if (d1_state == D1ST_SEL)
					D1SelClick(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
				else if (d1_state == D1ST_MENU)
				{
					tx = D1MenuHitTest(D1WinToCanvasX(a1), D1WinToCanvasY(a2));
					if (tx >= 0)
					{
						d1_menu_sel = tx;
						D1MenuAction(D1MenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2)));
						if (d1_menu_screen == 1)
							d1_menu_sel = D1OptRowNorm(d1_menu_sel);
					}
				}
				else if (d1_state == D1ST_GAME && d1_gmenu_open)
				{
					tx = D1GMenuHitTest(D1WinToCanvasX(a1),
						D1WinToCanvasY(a2) - D1UiOrgY());
					if (tx >= 0)
					{
						d1_gmenu_sel = tx;
						D1GMenuAction(D1GMenuClick(tx, D1WinToCanvasX(a1),
							D1WinToCanvasY(a2) - D1UiOrgY()));
					}
				}
				else if (d1_state == D1ST_GAME)
				{
					tx = D1WinToCanvasX(a1);
					ty = D1WinToCanvasY(a2);
					if (!D1UIClickAny(tx, ty))
					{
						if (ty >= D1PanelTop())
							D1PanelAction(D1PanelClick(tx, ty));
						else
						{
							if (d1_zoom)
							{//inverse of the magnifier, any scale
								tx = D1ZoomToWorldX(tx);
								ty = D1ZoomToWorldY(ty);
							}
							D1ScreenToTile(tx, ty, &tx, &ty);
							D1PlayClickTo(tx, ty);
						}
					}
				}
				break;
			case MESSAGE_MS_R_DOWN:
				if (d1_state == D1ST_GAME && !d1_gmenu_open)
				{
					tx = D1WinToCanvasX(a1);
					ty = D1WinToCanvasY(a2);
					//UseInvItem first: a grid potion drinks, and any click
					//on the open inventory half is consumed
					if (!D1InvRClick(tx, ty) && ty < D1PanelTop() &&
						!(D1UIAnyOpen() && tx >= D1UiOrgX() + D1_UI_W / 2))
					{
						if (d1_zoom)
						{//inverse of the magnifier, any scale
							tx = D1ZoomToWorldX(tx);
							ty = D1ZoomToWorldY(ty);
						}
						D1ScreenToTile(tx, ty, &tx, &ty);
						D1SpellCast(tx, ty);
					}
				}
				break;
		}
	}
}

U0 D1MenuKeys()
{//activation sounds live in D1MenuActivate; only the moves play here
	I64 n = D1MenuCount();

	if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
			d1_menu_sel = D1OptRowNext(d1_menu_sel, -1);
		else
		{
			d1_menu_sel--;
			if (d1_menu_sel < 0)
				d1_menu_sel = n - 1;
		}
	}
	if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
	{
		D1MenuMoveSnd;
		if (d1_menu_screen == 1)
			d1_menu_sel = D1OptRowNext(d1_menu_sel, 1);
		else
		{
			d1_menu_sel++;
			if (d1_menu_sel >= n)
				d1_menu_sel = 0;
		}
	}
	if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, -1);
	}
	if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
	{
		if (d1_menu_screen == 1)
			D1OptRowAdjust(d1_menu_sel, 1);
	}
	if (D1KeyEdge(SC_ENTER, &d1_k_enter))
	{
		D1MenuAction(D1MenuActivate(d1_menu_sel));
		if (d1_menu_screen == 1)
			d1_menu_sel = D1OptRowNorm(d1_menu_sel);
	}
	if (D1KeyEdge(SC_ESC, &d1_k_esc))
	{
		if (d1_menu_screen == 1)
		{
			d1_menu_screen = 0;
			d1_menu_sel    = 0;
			D1OptSave;
		}
		else
			D1EnterTitle;
	}
}

U0 Diablo1()
{
	F64 now;
	I64 i;
	I64 hx;
	I64 hy;

	DocClear;
	"$$LTRED$$Diablo$$FG$$ for ZealOS - loading DIABDAT.MPQ...\n";

	D1ScreenInit;

	if (!d1_mpq_ready)
	{
		if (!D1MpqMount("::/Apps/Diablo1/DIABDAT.MPQ"))
		{
			"Put DIABDAT.MPQ (retail or shareware) at ::/Apps/Diablo1/\n";
			return;
		}
	}
	if (!D1AssetsLoad())
		return;
	D1SndInit;

	//keep DolDoc out of the way: no self focus grab, no scroll grab, no
	//task menu, no border, no doc cursor (the Quake port's recipe)
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
					  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
	WinBorder;
	WinMax;
	D1WindowApply;				//honor the windowed option from the first frame
	WinToTop;
	DocCursor;
	DocClear;

	//armed before the canvas is handed to the compositor; a kill between here
	//and the teardown lands in D1TaskEndCB
	Fs->task_end_cb = &D1TaskEndCB;

	for (i = 0; i < 8; i++)
		d1_k_belt[i] = FALSE;
	d1_plr_name[0] = 0;

	d1_wheel_prev = mouse.pos.z;

	D1UIInit;
	d1_ui_inv = D1UIRegister(&d1_inv_open, &D1InvToggle, &D1InvDraw,
		&D1InvClick, D1UIS_RIGHT);
	d1_ui_char = D1UIRegister(&d1_char_open, &D1CharUIToggle, &D1CharUIDraw,
		&D1CharUIClick, D1UIS_LEFT);
	d1_ui_spell = D1UIRegister(&d1_spell_open, &D1SpellToggle, &D1SpellDraw,
		&D1SpellClick, D1UIS_RIGHT);
	d1_ui_quest = D1UIRegister(&d1_quest_open, &D1QuestToggle, &D1QuestDraw,
		&D1QuestClick, D1UIS_LEFT);
	d1_ui_store = D1UIRegister(&d1_store_open, &D1StoreToggle, &D1StoreDraw,
		&D1StoreClick, D1UIS_FULL);
	//automap draws under the control panel, so the registry does not draw it
	d1_ui_auto = D1UIRegister(&d1_auto_open, &D1AutoToggle, NULL, NULL,
		D1UIS_OVERLAY);

	D1EnterTitle;
	d1_quit  = FALSE;
	d1_ready = TRUE;
	Fs->draw_it = &D1DrawIt;

	while (!d1_quit)
	{
		D1Input;
		D1FadeStep;
		d1_anim++;

		if (sys_focus_task == Fs)
			D1MouseHide;
		else
			D1MouseShow;

		switch (d1_state)
		{
			case D1ST_TITLE:
				D1TitleDraw(d1_anim);
				if (D1KeyEdge(SC_ESC, &d1_k_esc))
					d1_quit = TRUE;
				if (D1KeyEdge(SC_ENTER, &d1_k_enter))
					D1EnterMenu;
				break;

			case D1ST_SEL:
				i = D1SelOutcome();
				if (i)
				{
					D1SelOutcomeClear;
					d1_save_slot = d1_sel_target;
					if (i == 1)
						D1ResumeGame;
					else if (i == 2)
						D1EnterGame;
					else
						D1EnterMenu;
					break;
				}
				D1SelKeys;
				D1SelDraw;
				D1CursorDraw;
				break;

			case D1ST_MENU:
				i = D1MenuHitTest(D1MouseX(), D1MouseY());
				if (i >= 0 && i != d1_menu_sel)
				{
					D1MenuMoveSnd;
					d1_menu_sel = i;
				}
				if (mouse.lb)
					D1MenuDrag(D1MouseX(), D1MouseY());
				else
					d1_optl_drag = -1;
				D1MenuDraw(d1_menu_sel, d1_anim / 3);
				D1CursorDraw;
				D1MenuKeys;
				break;

			case D1ST_GAME:
				if (d1_gmenu_open)
				{//gmenu.cpp: the game freezes behind the menu. the tick
				 //clock rides along so closing resumes without a backlog.
					d1_tick_t = tS;
					D1GameDraw;
					D1GMenuDraw(d1_gmenu_sel, d1_anim / 3);
					D1CursorDraw;
					i = D1GMenuHitTest(D1MouseX(), D1MouseY() - D1UiOrgY());
					if (i >= 0 && i != d1_gmenu_sel)
					{
						D1MenuMoveSnd;
						d1_gmenu_sel = i;
					}
					if (mouse.lb)
						D1GMenuDrag(D1MouseX());
					else
						d1_optl_drag = -1;
					if (D1KeyEdge(SC_CURSOR_UP, &d1_k_up))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, -1);
						else
						{
							d1_gmenu_sel--;
							if (d1_gmenu_sel < 0)
								d1_gmenu_sel = D1GMenuCount() - 1;
						}
					}
					if (D1KeyEdge(SC_CURSOR_DOWN, &d1_k_down))
					{
						D1MenuMoveSnd;
						if (d1_gmenu_screen == 1)
							d1_gmenu_sel = D1OptRowNext(d1_gmenu_sel, 1);
						else
						{
							d1_gmenu_sel++;
							if (d1_gmenu_sel >= D1GMenuCount())
								d1_gmenu_sel = 0;
						}
					}
					if (D1KeyEdge(SC_CURSOR_LEFT, &d1_k_left))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, -1);
					}
					if (D1KeyEdge(SC_CURSOR_RIGHT, &d1_k_right))
					{
						if (d1_gmenu_screen == 1)
							D1OptRowAdjust(d1_gmenu_sel, 1);
					}
					if (D1KeyEdge(SC_ENTER, &d1_k_enter))
						D1GMenuAction(D1GMenuActivate(d1_gmenu_sel));
					if (D1KeyEdge(SC_ESC, &d1_k_esc))
					{//second ESC resumes; from the option rows it backs out
						if (d1_gmenu_screen == 1)
						{
							d1_gmenu_screen = 0;
							d1_gmenu_sel    = 1;
							D1OptSave;
						}
						else
							D1GMenuClose;
					}
					break;
				}
				now = tS;
				while (now - d1_tick_t >= 0.05)
				{
					D1PlayTick;
					D1AutoMark(d1_plr_x, d1_plr_y);
					D1MonTickAll;
					D1MisTick;
					D1SpellTick;
					D1ItemTickAll;
					D1ObjTickAll;
					if (d1_currlevel == 0)
					{
						D1TownersTick;
						D1TownerDlgTick;
					}
					d1_tick_t += 0.05;
				}
				for (i = 0; i < 8; i++)
				{
					if (D1KeyEdge(Char2ScanCode('1' + i), &d1_k_belt[i]))
						D1BeltUse(i);
				}
				if (d1_diablo_slain)
				{
					D1QuestComplete(D1Q_DIABLO);
					d1_diablo_slain  = FALSE;
					d1_victory_timer = 200;
				}
				if (d1_victory_timer > 0)
				{
					d1_victory_timer--;
					if (d1_victory_timer == 0)
					{
						D1EnterMenu;
						break;
					}
				}
				if (d1_warp_to >= 0)
				{
					D1LoadLevel(d1_warp_to, d1_warp_entry);
					if (!d1_plr_dead)
						D1SaveWrite(d1_save_slot);
				}
				D1GameDraw;
				if (D1KeyEdge(Char2ScanCode('z'), &d1_k_zoom))
					D1ZoomToggle;
				if (D1KeyEdge(Char2ScanCode('w'), &d1_k_width))
				{//D1WidthCycle sets d1_vp_h for the menu states; the game
				 //keeps the panel up
					D1WidthCycle;
					d1_vp_h = D1PanelTop();
				}
				//wheel: one notch, one step on the 15-level ladder
				if (mouse.pos.z != d1_wheel_prev)
				{
					if (mouse.pos.z < d1_wheel_prev)
						D1ZoomStep(1);
					else
						D1ZoomStep(-1);
					d1_wheel_prev = mouse.pos.z;
				}
				if (D1KeyEdge(Char2ScanCode('i'), &d1_k_inv))
					D1UIToggle(d1_ui_inv);
				if (d1_store_open)
				{
					D1StoreOpened;
					D1StoreKeys;
				}
				if (D1KeyEdge(Char2ScanCode('c'), &d1_k_char))
					D1UIToggle(d1_ui_char);
				if (D1KeyEdge(Char2ScanCode('s'), &d1_k_spellbk))
					D1UIToggle(d1_ui_spell);
				if (D1KeyEdge(SC_TAB, &d1_k_map))
					D1UIToggle(d1_ui_auto);
				if (D1KeyEdge(Char2ScanCode('q'), &d1_k_quest))
					D1UIToggle(d1_ui_quest);
				if (D1KeyEdge(Char2ScanCode('='), &d1_k_zin))
					D1AutoZoom(1);
				if (D1KeyEdge(Char2ScanCode('-'), &d1_k_zout))
					D1AutoZoom(-1);
				if (mouse.lb && d1_state == D1ST_GAME)
				{//held left button: renew the walk toward the cursor
				 //(diablo.cpp sgbMouseDown), state - not message edge
					hx = D1MouseX();
					hy = D1MouseY();
					if (hy < d1_vp_h && !D1UICovers(hx))
					{
						if (d1_zoom)
						{
							hx = D1ZoomToWorldX(hx);
							hy = D1ZoomToWorldY(hy);
						}
						D1ScreenToTile(hx, hy, &hx, &hy);
						D1PlayHeldWalk(hx, hy);
					}
				}
				if (D1KeyEdge(SC_ESC, &d1_k_esc) && !d1_store_open)
				{//gmenu over the paused game (devilutionX PressEscKey);
				 //the old autosave-and-exit lives on its Quit Diablo row
					D1GMenuOpen;
				}
				break;
		}

		Sleep(15);
	}

	//teardown: stop the compositor reading the canvas before anything dies
	Fs->task_end_cb = NULL;
	d1_ready    = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);
	D1MouseShow;
	WinBorder;
	DocCursor;
	//park the doc cursor at the head; a click-parked cursor makes the shell
	//insert the next typed line INTO old text (the Quake port's exit fault)
	if (Fs->put_doc)
	{
		Fs->put_doc->cur_entry = &Fs->put_doc->head;
		Fs->put_doc->cur_col   = 0;
	}
	Fs->title_src = TTS_LOCKED_CONST;
	D1OptSave;
	D1SndFree;
	DocClear;
	"Diablo1: bye.\n";
}
