// D1Drlg2.ZC - catacombs level generation (drlg_l2.cpp, retail path)
//
// rooms are laid out by recursive subdivision (CreateRoom) into a char
// working map, halls carved by a wandering connector, then a 3x3 pattern
// table converts chars to tile ids. theme rooms are absent; they consumed
// RNG upstream, so layouts diverge from retail seeds but stay a pure
// function of ours.
//
// levels 5/6/7 force the first room to the quest size (14x20, 10x10,
// 15x15) and stamp Blood1 / Bonestr2 / Blind2 at its inset corner.
//
// working map chars: 32 space, 35 wall, 44 hall ext, 46 floor,
// 65-69 room corner markers, 68 door.
//
// shares d1_dun/d1_dunflag and their guarded accessors with D1Drlg1.

#include "D1Drlg2T"

U8	d2_pre[D1_DMAX * D1_DMAX];		//predungeon, [i * 40 + j]

//RoomList
I64 d2_room_x1[81];
I64 d2_room_y1[81];
I64 d2_room_x2[81];
I64 d2_room_y2[81];
I64 d2_room_dest[81];
I64 d2_nrooms = 0;

//hall FIFO
#define D2_MAXHALL	128
I64 d2_hall_x1[D2_MAXHALL];
I64 d2_hall_y1[D2_MAXHALL];
I64 d2_hall_x2[D2_MAXHALL];
I64 d2_hall_y2[D2_MAXHALL];
I64 d2_hall_dir[D2_MAXHALL];
I64 d2_hall_head = 0;
I64 d2_hall_tail = 0;

//set-piece exclusion box; no set pieces, so parked outside the map
I64 d2_sx1 = -100;
I64 d2_sy1 = -100;
I64 d2_sx2 = -100;
I64 d2_sy2 = -100;

//SPATSL2
U8 d2_spats[14] = {6, 3, 0, 3, 48, 0, 50, 9, 3, 0, 3, 48, 0, 50};

U8 D2PreGet(I64 i, I64 j)
{
	if (i < 0 || i >= D1_DMAX || j < 0 || j >= D1_DMAX)
		return 32;
	return d2_pre[i * D1_DMAX + j];
}

U0 D2PreSet(I64 i, I64 j, I64 v)
{
	if (i >= 0 && i < D1_DMAX && j >= 0 && j < D1_DMAX)
		d2_pre[i * D1_DMAX + j] = v;
}

U0 D2PlaceRndSet(U8 *miniset, I64 rndper)
{
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 ii;
	I64	 kk;
	Bool found;

	for (sy = 0; sy < D1_DMAX - sh; sy++)
		for (sx = 0; sx < D1_DMAX - sw; sx++)
		{
			found = TRUE;
			ii    = 2;
			if (sx >= d2_sx1 && sx <= d2_sx2 && sy >= d2_sy1 && sy <= d2_sy2)
				found = FALSE;
			for (yy = 0; yy < sh && found; yy++)
				for (xx = 0; xx < sw && found; xx++)
				{
					if (miniset[ii] != 0 && D1DunGet(xx + sx, yy + sy) != miniset[ii])
						found = FALSE;
					if (D1DunFlag(xx + sx, yy + sy))
						found = FALSE;
					ii++;
				}
			kk = sw * sh + 2;
			if (found)
			{//no duplicate of the replacement anchor nearby (guarded reads)
				for (yy = sy - sh; yy < sy + 2 * sh && found; yy++)
					for (xx = sx - sw; xx < sx + 2 * sw; xx++)
					{
						if (D1DunGet(xx, yy) == miniset[kk])
							found = FALSE;
					}
			}
			if (found && D1Rnd(100) < rndper)
			{
				for (yy = 0; yy < sh; yy++)
					for (xx = 0; xx < sw; xx++)
					{
						if (miniset[kk] != 0)
							D1DunSet(xx + sx, yy + sy, miniset[kk]);
						kk++;
					}
			}
		}
}

U0 D2Subs()
{
	I64 x;
	I64 y;
	I64 i;
	I64 j;
	I64 k;
	I64 rv;
	I64 c;

	for (y = 0; y < D1_DMAX; y++)
		for (x = 0; x < D1_DMAX; x++)
		{
			if ((x < d2_sx1 || x > d2_sx2) && (y < d2_sy1 || y > d2_sy2) &&
				D1Rnd(4) == 0)
			{
				c = d2t_btypesl2[D1DunGet(x, y)];
				if (c != 0)
				{
					rv = D1Rnd(16);
					k  = -1;
					while (rv >= 0)
					{
						k++;
						if (k == 161)
							k = 0;
						if (c == d2t_btypesl2[k])
							rv--;
					}
					//reject if the same tile sits within 2
					for (j = y - 2; j < y + 2; j++)
						for (i = x - 2; i < x + 2; i++)
						{
							if (D1DunGet(i, j) == k)
							{
								j = y + 3;
								i = x + 2;
							}
						}
					if (j < y + 3)
						D1DunSet(x, y, k);
				}
			}
		}
}

U0 D2Shadows()
{
	I64	 x;
	I64	 y;
	I64	 i;
	I64	 s00;
	I64	 s10;
	I64	 s01;
	I64	 s11;
	Bool patflag;
	U8	*sp;

	for (y = 1; y < D1_DMAX; y++)
		for (x = 1; x < D1_DMAX; x++)
		{
			s00 = d2t_bstypesl2[D1DunGet(x, y)];
			s10 = d2t_bstypesl2[D1DunGet(x - 1, y)];
			s01 = d2t_bstypesl2[D1DunGet(x, y - 1)];
			s11 = d2t_bstypesl2[D1DunGet(x - 1, y - 1)];
			for (i = 0; i < 2; i++)
			{
				sp = d2_spats + i * 7;
				if (sp[0] == s00)
				{
					patflag = TRUE;
					if (sp[1] != 0 && sp[1] != s11)
						patflag = FALSE;
					if (sp[2] != 0 && sp[2] != s01)
						patflag = FALSE;
					if (sp[3] != 0 && sp[3] != s10)
						patflag = FALSE;
					if (patflag)
					{
						if (sp[4] != 0)
							D1DunSet(x - 1, y - 1, sp[4]);
						if (sp[5] != 0)
							D1DunSet(x, y - 1, sp[5]);
						if (sp[6] != 0)
							D1DunSet(x - 1, y, sp[6]);
					}
				}
			}
		}
}

U0 D2InitDungeon()
{
	I64 i;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
	{
		d2_pre[i]     = 32;
		d1_dunflag[i] = 0;
	}
}

U0 D2DefineRoom(I64 nX1, I64 nY1, I64 nX2, I64 nY2, Bool force_hw)
{
	I64 i;
	I64 j;

	D2PreSet(nX1, nY1, 67);
	D2PreSet(nX1, nY2, 69);
	D2PreSet(nX2, nY1, 66);
	D2PreSet(nX2, nY2, 65);

	d2_nrooms++;
	d2_room_x1[d2_nrooms] = nX1;
	d2_room_x2[d2_nrooms] = nX2;
	d2_room_y1[d2_nrooms] = nY1;
	d2_room_y2[d2_nrooms] = nY2;

	if (force_hw)
	{//upstream's buggy protect loop, kept
		i = nX1;
		while (i < nX2)
		{
			while (i < nY2)
			{
				d1_dunflag[i * D1_DMAX + nY1] |= DLRG_PROTECTED;
				i++;
			}
			i++;
		}
	}
	for (i = nX1 + 1; i <= nX2 - 1; i++)
	{
		D2PreSet(i, nY1, 35);
		D2PreSet(i, nY2, 35);
	}
	nY2--;
	for (j = nY1 + 1; j <= nY2; j++)
	{
		D2PreSet(nX1, j, 35);
		D2PreSet(nX2, j, 35);
		for (i = nX1 + 1; i < nX2; i++)
			D2PreSet(i, j, 46);
	}
}

U0 D2CreateDoorType(I64 nX, I64 nY)
{
	Bool done = FALSE;

	if (D2PreGet(nX - 1, nY) == 68)
		done = TRUE;
	if (D2PreGet(nX + 1, nY) == 68)
		done = TRUE;
	if (D2PreGet(nX, nY - 1) == 68)
		done = TRUE;
	if (D2PreGet(nX, nY + 1) == 68)
		done = TRUE;
	if (D2PreGet(nX, nY) == 66 || D2PreGet(nX, nY) == 67 ||
		D2PreGet(nX, nY) == 65 || D2PreGet(nX, nY) == 69)
		done = TRUE;

	if (!done)
		D2PreSet(nX, nY, 68);
}

U0 D2PlaceHallExt(I64 nX, I64 nY)
{
	if (D2PreGet(nX, nY) == 32)
		D2PreSet(nX, nY, 44);
}

U0 D2AddHall(I64 nX1, I64 nY1, I64 nX2, I64 nY2, I64 nHd)
{
	if (d2_hall_tail >= D2_MAXHALL)
		return;
	d2_hall_x1[d2_hall_tail]  = nX1;
	d2_hall_y1[d2_hall_tail]  = nY1;
	d2_hall_x2[d2_hall_tail]  = nX2;
	d2_hall_y2[d2_hall_tail]  = nY2;
	d2_hall_dir[d2_hall_tail] = nHd;
	d2_hall_tail++;
}

U0 D2CreateRoom(I64 nX1, I64 nY1, I64 nX2, I64 nY2, I64 nRDest, I64 nHDir,
	Bool force_hw, I64 nH, I64 nW)
{
	I64 nAw;
	I64 nAh;
	I64 nRw;
	I64 nRh;
	I64 nRx1;
	I64 nRy1;
	I64 nRx2;
	I64 nRy2;
	I64 nHw;
	I64 nHh;
	I64 nHx1 = 0;
	I64 nHy1 = 0;
	I64 nHx2 = 0;
	I64 nHy2 = 0;
	I64 nRid;

	if (d2_nrooms >= 80)
		return;

	nAw = nX2 - nX1;
	nAh = nY2 - nY1;
	if (nAw < 2 || nAh < 2)
		return;

	if (nAw > 10)
		nRw = D1Rnd(10 - 4) + 4;
	else if (nAw > 4)
		nRw = D1Rnd(nAw - 4) + 4;
	else
		nRw = nAw;
	if (nAh > 10)
		nRh = D1Rnd(10 - 4) + 4;
	else if (nAh > 4)
		nRh = D1Rnd(nAh - 4) + 4;
	else
		nRh = nAh;

	if (force_hw)
	{
		nRw = nW;
		nRh = nH;
	}

	nRx1 = D1Rnd(nX2 - nX1) + nX1;
	nRy1 = D1Rnd(nY2 - nY1) + nY1;
	nRx2 = nRw + nRx1;
	nRy2 = nRh + nRy1;
	if (nRx2 > nX2)
	{
		nRx2 = nX2;
		nRx1 = nX2 - nRw;
	}
	if (nRy2 > nY2)
	{
		nRy2 = nY2;
		nRy1 = nY2 - nRh;
	}

	if (nRx1 >= 38)
		nRx1 = 38;
	if (nRy1 >= 38)
		nRy1 = 38;
	if (nRx1 <= 1)
		nRx1 = 1;
	if (nRy1 <= 1)
		nRy1 = 1;
	if (nRx2 >= 38)
		nRx2 = 38;
	if (nRy2 >= 38)
		nRy2 = 38;
	if (nRx2 <= 1)
		nRx2 = 1;
	if (nRy2 <= 1)
		nRy2 = 1;
	D2DefineRoom(nRx1, nRy1, nRx2, nRy2, force_hw);

	if (force_hw)
	{
		d2_sx1 = nRx1 + 2;
		d2_sy1 = nRy1 + 2;
		d2_sx2 = nRx2;
		d2_sy2 = nRy2;
	}

	nRid = d2_nrooms;
	d2_room_dest[nRid] = nRDest;

	if (nRDest != 0)
	{
		if (nHDir == 1)
		{
			nHx1 = D1Rnd(nRx2 - nRx1 - 2) + nRx1 + 1;
			nHy1 = nRy1;
			nHw  = d2_room_x2[nRDest] - d2_room_x1[nRDest] - 2;
			nHx2 = D1Rnd(nHw) + d2_room_x1[nRDest] + 1;
			nHy2 = d2_room_y2[nRDest];
		}
		if (nHDir == 3)
		{
			nHx1 = D1Rnd(nRx2 - nRx1 - 2) + nRx1 + 1;
			nHy1 = nRy2;
			nHw  = d2_room_x2[nRDest] - d2_room_x1[nRDest] - 2;
			nHx2 = D1Rnd(nHw) + d2_room_x1[nRDest] + 1;
			nHy2 = d2_room_y1[nRDest];
		}
		if (nHDir == 2)
		{
			nHx1 = nRx2;
			nHy1 = D1Rnd(nRy2 - nRy1 - 2) + nRy1 + 1;
			nHx2 = d2_room_x1[nRDest];
			nHh  = d2_room_y2[nRDest] - d2_room_y1[nRDest] - 2;
			nHy2 = D1Rnd(nHh) + d2_room_y1[nRDest] + 1;
		}
		if (nHDir == 4)
		{
			nHx1 = nRx1;
			nHy1 = D1Rnd(nRy2 - nRy1 - 2) + nRy1 + 1;
			nHx2 = d2_room_x2[nRDest];
			nHh  = d2_room_y2[nRDest] - d2_room_y1[nRDest] - 2;
			nHy2 = D1Rnd(nHh) + d2_room_y1[nRDest] + 1;
		}
		D2AddHall(nHx1, nHy1, nHx2, nHy2, nHDir);
	}

	if (nRh > nRw)
	{
		D2CreateRoom(nX1 + 2, nY1 + 2, nRx1 - 2, nRy2 - 2, nRid, 2, 0, 0, 0);
		D2CreateRoom(nRx2 + 2, nRy1 + 2, nX2 - 2, nY2 - 2, nRid, 4, 0, 0, 0);
		D2CreateRoom(nX1 + 2, nRy2 + 2, nRx2 - 2, nY2 - 2, nRid, 1, 0, 0, 0);
		D2CreateRoom(nRx1 + 2, nY1 + 2, nX2 - 2, nRy1 - 2, nRid, 3, 0, 0, 0);
	}
	else
	{
		D2CreateRoom(nX1 + 2, nY1 + 2, nRx2 - 2, nRy1 - 2, nRid, 3, 0, 0, 0);
		D2CreateRoom(nRx1 + 2, nRy2 + 2, nX2 - 2, nY2 - 2, nRid, 1, 0, 0, 0);
		D2CreateRoom(nX1 + 2, nRy1 + 2, nRx1 - 2, nY2 - 2, nRid, 2, 0, 0, 0);
		D2CreateRoom(nRx2 + 2, nY1 + 2, nX2 - 2, nRy2 - 2, nRid, 4, 0, 0, 0);
	}
}

U0 D2ConnectHall(I64 nX1, I64 nY1, I64 nX2, I64 nY2, I64 nHd)
{
	I64	 nCurrd;
	I64	 nDx;
	I64	 nDy;
	I64	 nRp;
	I64	 nOrigX1;
	I64	 nOrigY1;
	I64	 fMinusFlag;
	I64	 fPlusFlag;
	Bool fDoneflag = FALSE;
	Bool fInroom   = FALSE;

	fMinusFlag = D1Rnd(100);
	fPlusFlag  = D1Rnd(100);
	nOrigX1    = nX1;
	nOrigY1    = nY1;
	D2CreateDoorType(nX1, nY1);
	D2CreateDoorType(nX2, nY2);
	nCurrd = nHd;
	nX2   -= d2t_dir_xadd[nCurrd];
	nY2   -= d2t_dir_yadd[nCurrd];
	D2PreSet(nX2, nY2, 44);

	while (!fDoneflag)
	{
		if (nX1 >= 38 && nCurrd == 2)
			nCurrd = 4;
		if (nY1 >= 38 && nCurrd == 3)
			nCurrd = 1;
		if (nX1 <= 1 && nCurrd == 4)
			nCurrd = 2;
		if (nY1 <= 1 && nCurrd == 1)
			nCurrd = 3;
		if (D2PreGet(nX1, nY1) == 67 && (nCurrd == 1 || nCurrd == 4))
			nCurrd = 2;
		if (D2PreGet(nX1, nY1) == 66 && (nCurrd == 1 || nCurrd == 2))
			nCurrd = 3;
		if (D2PreGet(nX1, nY1) == 69 && (nCurrd == 4 || nCurrd == 3))
			nCurrd = 1;
		if (D2PreGet(nX1, nY1) == 65 && (nCurrd == 2 || nCurrd == 3))
			nCurrd = 4;
		nX1 += d2t_dir_xadd[nCurrd];
		nY1 += d2t_dir_yadd[nCurrd];
		if (D2PreGet(nX1, nY1) == 32)
		{
			if (fInroom)
				D2CreateDoorType(nX1 - d2t_dir_xadd[nCurrd],
					nY1 - d2t_dir_yadd[nCurrd]);
			else
			{
				if (fMinusFlag < 50)
				{
					if (nCurrd != 1 && nCurrd != 3)
						D2PlaceHallExt(nX1, nY1 - 1);
					else
						D2PlaceHallExt(nX1 - 1, nY1);
				}
				if (fPlusFlag < 50)
				{
					if (nCurrd != 1 && nCurrd != 3)
						D2PlaceHallExt(nX1, nY1 + 1);
					else
						D2PlaceHallExt(nX1 + 1, nY1);
				}
			}
			D2PreSet(nX1, nY1, 44);
			fInroom = FALSE;
		}
		else
		{
			if (!fInroom && D2PreGet(nX1, nY1) == 35)
				D2CreateDoorType(nX1, nY1);
			if (D2PreGet(nX1, nY1) != 44)
				fInroom = TRUE;
		}

		nDx = nX2 - nX1;
		if (nDx < 0)
			nDx = -nDx;
		nDy = nY2 - nY1;
		if (nDy < 0)
			nDy = -nDy;

		if (nDx > nDy)
		{
			nRp = 2 * nDx;
			if (nRp > 30)
				nRp = 30;
			if (D1Rnd(100) < nRp)
			{
				if (nX2 <= nX1 || nX1 >= D1_DMAX)
					nCurrd = 4;
				else
					nCurrd = 2;
			}
		}
		else
		{
			nRp = 5 * nDy;
			if (nRp > 80)
				nRp = 80;
			if (D1Rnd(100) < nRp)
			{
				if (nY2 <= nY1 || nY1 >= D1_DMAX)
					nCurrd = 1;
				else
					nCurrd = 3;
			}
		}
		if (nDy < 10 && nX1 == nX2 && (nCurrd == 2 || nCurrd == 4))
		{
			if (nY2 <= nY1 || nY1 >= D1_DMAX)
				nCurrd = 1;
			else
				nCurrd = 3;
		}
		if (nDx < 10 && nY1 == nY2 && (nCurrd == 1 || nCurrd == 3))
		{
			if (nX2 <= nX1 || nX1 >= D1_DMAX)
				nCurrd = 4;
			else
				nCurrd = 2;
		}
		if (nDy == 1 && nDx > 1 && (nCurrd == 1 || nCurrd == 3))
		{
			if (nX2 <= nX1 || nX1 >= D1_DMAX)
				nCurrd = 4;
			else
				nCurrd = 2;
		}
		if (nDx == 1 && nDy > 1 && (nCurrd == 2 || nCurrd == 4))
		{
			if (nY2 <= nY1 || nX1 >= D1_DMAX)
				nCurrd = 1;
			else
				nCurrd = 3;
		}
		if (nDx == 0 && D2PreGet(nX1, nY1) != 32 && (nCurrd == 2 || nCurrd == 4))
		{
			if (nX2 <= nOrigX1 || nX1 >= D1_DMAX)
				nCurrd = 1;
			else
				nCurrd = 3;
		}
		if (nDy == 0 && D2PreGet(nX1, nY1) != 32 && (nCurrd == 1 || nCurrd == 3))
		{
			if (nY2 <= nOrigY1 || nY1 >= D1_DMAX)
				nCurrd = 4;
			else
				nCurrd = 2;
		}
		if (nX1 == nX2 && nY1 == nY2)
			fDoneflag = TRUE;
	}
}

U0 D2DoPatternCheck(I64 i, I64 j)
{
	I64 k;
	I64 l;
	I64 x;
	I64 y;
	I64 nOk;
	I64 p;

	for (k = 0; d2t_patterns[k * 10 + 4] != 255; k++)
	{
		x   = i - 1;
		y   = j - 1;
		nOk = 254;
		for (l = 0; l < 9 && nOk == 254; l++)
		{
			nOk = 255;
			if (l == 3 || l == 6)
			{
				y++;
				x = i - 1;
			}
			if (x >= 0 && x < D1_DMAX && y >= 0 && y < D1_DMAX)
			{
				p = D2PreGet(x, y);
				switch (d2t_patterns[k * 10 + l])
				{
					case 0:
						nOk = 254;
						break;
					case 1:
						if (p == 35)
							nOk = 254;
						break;
					case 2:
						if (p == 46)
							nOk = 254;
						break;
					case 4:
						if (p == 32)
							nOk = 254;
						break;
					case 3:
						if (p == 68)
							nOk = 254;
						break;
					case 5:
						if (p == 68 || p == 46)
							nOk = 254;
						break;
					case 6:
						if (p == 68 || p == 35)
							nOk = 254;
						break;
					case 7:
						if (p == 32 || p == 46)
							nOk = 254;
						break;
					case 8:
						if (p == 68 || p == 35 || p == 46)
							nOk = 254;
						break;
				}
			}
			else
				nOk = 254;
			x++;
		}
		if (nOk == 254)
			D1DunSet(i, j, d2t_patterns[k * 10 + 9]);
	}
}

U0 D2TileFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 1 && D1DunGet(i, j + 1) == 3)
				D1DunSet(i, j + 1, 1);
			if (D1DunGet(i, j) == 3 && D1DunGet(i, j + 1) == 1)
				D1DunSet(i, j + 1, 3);
			if (D1DunGet(i, j) == 3 && D1DunGet(i + 1, j) == 7)
				D1DunSet(i + 1, j, 3);
			if (D1DunGet(i, j) == 2 && D1DunGet(i + 1, j) == 3)
				D1DunSet(i + 1, j, 2);
			if (D1DunGet(i, j) == 11 && D1DunGet(i + 1, j) == 14)
				D1DunSet(i + 1, j, 16);
		}
}

Bool D2Cont(Bool x1f, Bool y1f, Bool x2f, Bool y2f)
{
	if (x1f && x2f && y1f && y2f)
		return FALSE;
	if (x1f && x2f && (y1f || y2f))
		return TRUE;
	if (y1f && y2f && (x1f || x2f))
		return TRUE;
	return FALSE;
}

I64 D2NumNoChar()
{
	I64 i;
	I64 t = 0;

	for (i = 0; i < D1_DMAX * D1_DMAX; i++)
		if (d2_pre[i] == 32)
			t++;
	return t;
}

U0 D2DrawRoom(I64 x1, I64 y1, I64 x2, I64 y2)
{
	I64 ii;
	I64 jj;

	for (jj = y1; jj <= y2; jj++)
		for (ii = x1; ii <= x2; ii++)
			D2PreSet(ii, jj, 46);
	for (jj = y1; jj <= y2; jj++)
	{
		D2PreSet(x1, jj, 35);
		D2PreSet(x2, jj, 35);
	}
	for (ii = x1; ii <= x2; ii++)
	{
		D2PreSet(ii, y1, 35);
		D2PreSet(ii, y2, 35);
	}
}

U0 D2KnockWalls(I64 x1, I64 y1, I64 x2, I64 y2)
{
	I64 ii;
	I64 jj;

	for (ii = x1 + 1; ii < x2; ii++)
	{
		if (D2PreGet(ii, y1 - 1) == 46 && D2PreGet(ii, y1 + 1) == 46)
			D2PreSet(ii, y1, 46);
		if (D2PreGet(ii, y2 - 1) == 46 && D2PreGet(ii, y2 + 1) == 46)
			D2PreSet(ii, y2, 46);
		if (D2PreGet(ii, y1 - 1) == 68)
			D2PreSet(ii, y1 - 1, 46);
		if (D2PreGet(ii, y2 + 1) == 68)
			D2PreSet(ii, y2 + 1, 46);
	}
	for (jj = y1 + 1; jj < y2; jj++)
	{
		if (D2PreGet(x1 - 1, jj) == 46 && D2PreGet(x1 + 1, jj) == 46)
			D2PreSet(x1, jj, 46);
		if (D2PreGet(x2 - 1, jj) == 46 && D2PreGet(x2 + 1, jj) == 46)
			D2PreSet(x2, jj, 46);
		if (D2PreGet(x1 - 1, jj) == 68)
			D2PreSet(x1 - 1, jj, 46);
		if (D2PreGet(x2 + 1, jj) == 68)
			D2PreSet(x2 + 1, jj, 46);
	}
}

Bool D2FillVoids()
{
	I64	 ii;
	I64	 jj;
	I64	 xx;
	I64	 yy;
	I64	 x1;
	I64	 x2;
	I64	 y1;
	I64	 y2;
	Bool xf1;
	Bool xf2;
	Bool yf1;
	Bool yf2;
	I64	 to = 0;

	while (D2NumNoChar() > 700 && to < 100)
	{
		xx = D1Rnd(38) + 1;
		yy = D1Rnd(38) + 1;
		if (D2PreGet(xx, yy) == 35)
		{
			xf1 = FALSE;
			xf2 = FALSE;
			yf1 = FALSE;
			yf2 = FALSE;
			if (D2PreGet(xx - 1, yy) == 32 && D2PreGet(xx + 1, yy) == 46)
			{
				if (D2PreGet(xx + 1, yy - 1) == 46 &&
					D2PreGet(xx + 1, yy + 1) == 46 &&
					D2PreGet(xx - 1, yy - 1) == 32 &&
					D2PreGet(xx - 1, yy + 1) == 32)
				{
					xf1 = TRUE;
					yf1 = TRUE;
					yf2 = TRUE;
				}
			}
			else if (D2PreGet(xx + 1, yy) == 32 && D2PreGet(xx - 1, yy) == 46)
			{
				if (D2PreGet(xx - 1, yy - 1) == 46 &&
					D2PreGet(xx - 1, yy + 1) == 46 &&
					D2PreGet(xx + 1, yy - 1) == 32 &&
					D2PreGet(xx + 1, yy + 1) == 32)
				{
					xf2 = TRUE;
					yf1 = TRUE;
					yf2 = TRUE;
				}
			}
			else if (D2PreGet(xx, yy - 1) == 32 && D2PreGet(xx, yy + 1) == 46)
			{
				if (D2PreGet(xx - 1, yy + 1) == 46 &&
					D2PreGet(xx + 1, yy + 1) == 46 &&
					D2PreGet(xx - 1, yy - 1) == 32 &&
					D2PreGet(xx + 1, yy - 1) == 32)
				{
					yf1 = TRUE;
					xf1 = TRUE;
					xf2 = TRUE;
				}
			}
			else if (D2PreGet(xx, yy + 1) == 32 && D2PreGet(xx, yy - 1) == 46)
			{
				if (D2PreGet(xx - 1, yy - 1) == 46 &&
					D2PreGet(xx + 1, yy - 1) == 46 &&
					D2PreGet(xx - 1, yy + 1) == 32 &&
					D2PreGet(xx + 1, yy + 1) == 32)
				{
					yf2 = TRUE;
					xf1 = TRUE;
					xf2 = TRUE;
				}
			}
			if (D2Cont(xf1, yf1, xf2, yf2))
			{
				if (xf1)
					x1 = xx - 1;
				else
					x1 = xx;
				if (xf2)
					x2 = xx + 1;
				else
					x2 = xx;
				if (yf1)
					y1 = yy - 1;
				else
					y1 = yy;
				if (yf2)
					y2 = yy + 1;
				else
					y2 = yy;
				if (!xf1)
				{
					while (yf1 || yf2)
					{
						if (y1 == 0)
							yf1 = FALSE;
						if (y2 == D1_DMAX - 1)
							yf2 = FALSE;
						if (y2 - y1 >= 14)
						{
							yf1 = FALSE;
							yf2 = FALSE;
						}
						if (yf1)
							y1--;
						if (yf2)
							y2++;
						if (D2PreGet(x2, y1) != 32)
							yf1 = FALSE;
						if (D2PreGet(x2, y2) != 32)
							yf2 = FALSE;
					}
					y1 += 2;
					y2 -= 2;
					if (y2 - y1 > 5)
					{
						while (xf2)
						{
							if (x2 == 39)
								xf2 = FALSE;
							if (x2 - x1 >= 12)
								xf2 = FALSE;
							for (jj = y1; jj <= y2; jj++)
							{
								if (D2PreGet(x2, jj) != 32)
									xf2 = FALSE;
							}
							if (xf2)
								x2++;
						}
						x2 -= 2;
						if (x2 - x1 > 5)
						{
							D2DrawRoom(x1, y1, x2, y2);
							D2KnockWalls(x1, y1, x2, y2);
						}
					}
				}
				else if (!xf2)
				{
					while (yf1 || yf2)
					{
						if (y1 == 0)
							yf1 = FALSE;
						if (y2 == D1_DMAX - 1)
							yf2 = FALSE;
						if (y2 - y1 >= 14)
						{
							yf1 = FALSE;
							yf2 = FALSE;
						}
						if (yf1)
							y1--;
						if (yf2)
							y2++;
						if (D2PreGet(x1, y1) != 32)
							yf1 = FALSE;
						if (D2PreGet(x1, y2) != 32)
							yf2 = FALSE;
					}
					y1 += 2;
					y2 -= 2;
					if (y2 - y1 > 5)
					{
						while (xf1)
						{
							if (x1 == 0)
								xf1 = FALSE;
							if (x2 - x1 >= 12)
								xf1 = FALSE;
							for (jj = y1; jj <= y2; jj++)
							{
								if (D2PreGet(x1, jj) != 32)
									xf1 = FALSE;
							}
							if (xf1)
								x1--;
						}
						x1 += 2;
						if (x2 - x1 > 5)
						{
							D2DrawRoom(x1, y1, x2, y2);
							D2KnockWalls(x1, y1, x2, y2);
						}
					}
				}
				else if (!yf1)
				{
					while (xf1 || xf2)
					{
						if (x1 == 0)
							xf1 = FALSE;
						if (x2 == D1_DMAX - 1)
							xf2 = FALSE;
						if (x2 - x1 >= 14)
						{
							xf1 = FALSE;
							xf2 = FALSE;
						}
						if (xf1)
							x1--;
						if (xf2)
							x2++;
						if (D2PreGet(x1, y2) != 32)
							xf1 = FALSE;
						if (D2PreGet(x2, y2) != 32)
							xf2 = FALSE;
					}
					x1 += 2;
					x2 -= 2;
					if (x2 - x1 > 5)
					{
						while (yf2)
						{
							if (y2 == D1_DMAX - 1)
								yf2 = FALSE;
							if (y2 - y1 >= 12)
								yf2 = FALSE;
							for (ii = x1; ii <= x2; ii++)
							{
								if (D2PreGet(ii, y2) != 32)
									yf2 = FALSE;
							}
							if (yf2)
								y2++;
						}
						y2 -= 2;
						if (y2 - y1 > 5)
						{
							D2DrawRoom(x1, y1, x2, y2);
							D2KnockWalls(x1, y1, x2, y2);
						}
					}
				}
				else if (!yf2)
				{
					while (xf1 || xf2)
					{
						if (x1 == 0)
							xf1 = FALSE;
						if (x2 == D1_DMAX - 1)
							xf2 = FALSE;
						if (x2 - x1 >= 14)
						{
							xf1 = FALSE;
							xf2 = FALSE;
						}
						if (xf1)
							x1--;
						if (xf2)
							x2++;
						if (D2PreGet(x1, y1) != 32)
							xf1 = FALSE;
						if (D2PreGet(x2, y1) != 32)
							xf2 = FALSE;
					}
					x1 += 2;
					x2 -= 2;
					if (x2 - x1 > 5)
					{
						while (yf1)
						{
							if (y1 == 0)
								yf1 = FALSE;
							if (y2 - y1 >= 12)
								yf1 = FALSE;
							for (ii = x1; ii <= x2; ii++)
							{
								if (D2PreGet(ii, y1) != 32)
									yf1 = FALSE;
							}
							if (yf1)
								y1--;
						}
						y1 += 2;
						if (y2 - y1 > 5)
						{
							D2DrawRoom(x1, y1, x2, y2);
							D2KnockWalls(x1, y1, x2, y2);
						}
					}
				}
			}
		}
		to++;
	}

	return D2NumNoChar() <= 700;
}

Bool D2CreateDungeon(I64 level)
{
	I64	 i;
	I64	 j;
	I64	 hx1;
	I64	 hy1;
	I64	 hx2;
	I64	 hy2;
	I64	 hd;
	I64	 force_w  = 0;
	I64	 force_h  = 0;
	Bool force_hw = FALSE;

	//quest levels force the first room's size so the set piece fits
	//(CreateDungeon: Valor 14x20, Chamber of Bone 10x10, Blind 15x15)
	if (level == 5)
	{
		force_hw = TRUE;
		force_h  = 20;
		force_w  = 14;
	}
	if (level == 6)
	{
		force_hw = TRUE;
		force_w  = 10;
		force_h  = 10;
	}
	if (level == 7)
	{
		force_hw = TRUE;
		force_w  = 15;
		force_h  = 15;
	}

	D2CreateRoom(2, 2, D1_DMAX - 1, D1_DMAX - 1, 0, 0, force_hw, force_h,
		force_w);

	while (d2_hall_head < d2_hall_tail)
	{
		hx1 = d2_hall_x1[d2_hall_head];
		hy1 = d2_hall_y1[d2_hall_head];
		hx2 = d2_hall_x2[d2_hall_head];
		hy2 = d2_hall_y2[d2_hall_head];
		hd  = d2_hall_dir[d2_hall_head];
		d2_hall_head++;
		D2ConnectHall(hx1, hy1, hx2, hy2, hd);
	}

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D2PreGet(i, j) == 67)
				D2PreSet(i, j, 35);
			if (D2PreGet(i, j) == 66)
				D2PreSet(i, j, 35);
			if (D2PreGet(i, j) == 69)
				D2PreSet(i, j, 35);
			if (D2PreGet(i, j) == 65)
				D2PreSet(i, j, 35);
			if (D2PreGet(i, j) == 44)
			{
				D2PreSet(i, j, 46);
				if (D2PreGet(i - 1, j - 1) == 32)
					D2PreSet(i - 1, j - 1, 35);
				if (D2PreGet(i - 1, j) == 32)
					D2PreSet(i - 1, j, 35);
				if (D2PreGet(i - 1, 1 + j) == 32)
					D2PreSet(i - 1, 1 + j, 35);
				if (D2PreGet(i + 1, j - 1) == 32)
					D2PreSet(i + 1, j - 1, 35);
				if (D2PreGet(i + 1, j) == 32)
					D2PreSet(i + 1, j, 35);
				if (D2PreGet(i + 1, 1 + j) == 32)
					D2PreSet(i + 1, 1 + j, 35);
				if (D2PreGet(i, j - 1) == 32)
					D2PreSet(i, j - 1, 35);
				if (D2PreGet(i, j + 1) == 32)
					D2PreSet(i, j + 1, 35);
			}
		}

	if (!D2FillVoids())
		return FALSE;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
			D2DoPatternCheck(i, j);

	return TRUE;
}

U0 D2Pass3()
{//base tile 12
	I64 i;
	I64 j;
	I64 xx;
	I64 yy;
	I64 lv;
	I64 v1;
	I64 v2;
	I64 v3;
	I64 v4;

	lv = 12 - 1;
	v1 = D1RdU16(d1_til + lv * 8)     + 1;
	v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
	v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
	v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;

	for (j = 0; j < D1_MAXDUN; j += 2)
		for (i = 0; i < D1_MAXDUN; i += 2)
		{
			d1_dpiece[i     +  j      * D1_MAXDUN] = v1;
			d1_dpiece[i + 1 +  j      * D1_MAXDUN] = v2;
			d1_dpiece[i     + (j + 1) * D1_MAXDUN] = v3;
			d1_dpiece[i + 1 + (j + 1) * D1_MAXDUN] = v4;
		}

	yy = 16;
	for (j = 0; j < D1_DMAX; j++)
	{
		xx = 16;
		for (i = 0; i < D1_DMAX; i++)
		{
			lv = D1DunGet(i, j) - 1;
			if (lv >= 0)
			{
				v1 = D1RdU16(d1_til + lv * 8)     + 1;
				v2 = D1RdU16(d1_til + lv * 8 + 2) + 1;
				v3 = D1RdU16(d1_til + lv * 8 + 4) + 1;
				v4 = D1RdU16(d1_til + lv * 8 + 6) + 1;
			}
			else
			{
				v1 = 0;
				v2 = 0;
				v3 = 0;
				v4 = 0;
			}
			d1_dpiece[xx     +  yy      * D1_MAXDUN] = v1;
			d1_dpiece[xx + 1 +  yy      * D1_MAXDUN] = v2;
			d1_dpiece[xx     + (yy + 1) * D1_MAXDUN] = v3;
			d1_dpiece[xx + 1 + (yy + 1) * D1_MAXDUN] = v4;
			xx += 2;
		}
		yy += 2;
	}
}

U0 D2DirtFix()
{
	I64 i;
	I64 j;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 13 && D1DunGet(i + 1, j) != 11)
				D1DunSet(i, j, 146);
			if (D1DunGet(i, j) == 11 && D1DunGet(i + 1, j) != 11)
				D1DunSet(i, j, 144);
			if (D1DunGet(i, j) == 15 && D1DunGet(i + 1, j) != 11)
				D1DunSet(i, j, 148);
			if (D1DunGet(i, j) == 10 && D1DunGet(i, j + 1) != 10)
				D1DunSet(i, j, 143);
			if (D1DunGet(i, j) == 13 && D1DunGet(i, j + 1) != 10)
				D1DunSet(i, j, 146);
			if (D1DunGet(i, j) == 14 && D1DunGet(i, j + 1) != 15)
				D1DunSet(i, j, 147);
		}
}

U0 D2LockoutFix()
{
	I64	 i;
	I64	 j;
	Bool doorok;

	for (j = 0; j < D1_DMAX; j++)
		for (i = 0; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 4 && D1DunGet(i - 1, j) != 3)
				D1DunSet(i, j, 1);
			if (D1DunGet(i, j) == 5 && D1DunGet(i, j - 1) != 3)
				D1DunSet(i, j, 2);
		}
	for (j = 1; j < D1_DMAX - 1; j++)
		for (i = 1; i < D1_DMAX - 1; i++)
		{
			if (!(D1DunFlag(i, j) & DLRG_PROTECTED))
			{
				if ((D1DunGet(i, j) == 2 || D1DunGet(i, j) == 5) &&
					D1DunGet(i, j - 1) == 3 && D1DunGet(i, j + 1) == 3)
				{
					doorok = FALSE;
					while (TRUE)
					{
						if (D1DunGet(i, j) != 2 && D1DunGet(i, j) != 5)
							break;
						if (D1DunGet(i, j - 1) != 3 || D1DunGet(i, j + 1) != 3)
							break;
						if (D1DunGet(i, j) == 5)
							doorok = TRUE;
						i++;
					}
					if (!doorok && !(D1DunFlag(i - 1, j) & DLRG_PROTECTED))
						D1DunSet(i - 1, j, 5);
				}
			}
		}
	for (j = 1; j < D1_DMAX - 1; j++)
		for (i = 1; i < D1_DMAX - 1; i++)
		{
			if (!(D1DunFlag(j, i) & DLRG_PROTECTED))
			{
				if ((D1DunGet(j, i) == 1 || D1DunGet(j, i) == 4) &&
					D1DunGet(j - 1, i) == 3 && D1DunGet(j + 1, i) == 3)
				{
					doorok = FALSE;
					while (TRUE)
					{
						if (D1DunGet(j, i) != 1 && D1DunGet(j, i) != 4)
							break;
						if (D1DunGet(j - 1, i) != 3 || D1DunGet(j + 1, i) != 3)
							break;
						if (D1DunGet(j, i) == 4)
							doorok = TRUE;
						i++;
					}
					if (!doorok && !(D1DunFlag(j, i - 1) & DLRG_PROTECTED))
						D1DunSet(j, i - 1, 4);
				}
			}
		}
}

U0 D2DoorFix()
{
	I64 i;
	I64 j;

	for (j = 1; j < D1_DMAX; j++)
		for (i = 1; i < D1_DMAX; i++)
		{
			if (D1DunGet(i, j) == 4 && D1DunGet(i, j - 1) == 3)
				D1DunSet(i, j, 7);
			if (D1DunGet(i, j) == 5 && D1DunGet(i - 1, j) == 3)
				D1DunSet(i, j, 9);
		}
}

Bool D2PlaceMiniSet(U8 *miniset, I64 tmin, I64 tmax, I64 cx, I64 cy,
	Bool setview)
{
	I64	 sx;
	I64	 sy;
	I64	 sw = miniset[0];
	I64	 sh = miniset[1];
	I64	 xx;
	I64	 yy;
	I64	 i;
	I64	 ii;
	I64	 numt;
	I64	 bailcnt;
	Bool found;

	if (tmax - tmin == 0)
		numt = 1;
	else
		numt = D1Rnd(tmax - tmin) + tmin;

	sx = 0;
	sy = 0;
	for (i = 0; i < numt; i++)
	{
		sx    = D1Rnd(D1_DMAX - sw);
		sy    = D1Rnd(D1_DMAX - sh);
		found = FALSE;
		for (bailcnt = 0; !found && bailcnt < 200; bailcnt++)
		{
			found = TRUE;
			if (sx >= d2_sx1 && sx <= d2_sx2 && sy >= d2_sy1 && sy <= d2_sy2)
				found = FALSE;
			if (cx != -1 && sx >= cx - sw && sx <= cx + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			if (cy != -1 && sy >= cy - sh && sy <= cy + 12)
			{
				sx    = D1Rnd(D1_DMAX - sw);
				sy    = D1Rnd(D1_DMAX - sh);
				found = FALSE;
			}
			ii = 2;
			for (yy = 0; yy < sh && found; yy++)
				for (xx = 0; xx < sw && found; xx++)
				{
					if (miniset[ii] != 0 &&
						D1DunGet(xx + sx, yy + sy) != miniset[ii])
						found = FALSE;
					if (D1DunFlag(xx + sx, yy + sy))
						found = FALSE;
					ii++;
				}
			if (!found)
			{
				sx++;
				if (sx == D1_DMAX - sw)
				{
					sx = 0;
					sy++;
					if (sy == D1_DMAX - sh)
						sy = 0;
				}
			}
		}
		if (bailcnt >= 200)
			return FALSE;
		ii = sw * sh + 2;
		for (yy = 0; yy < sh; yy++)
			for (xx = 0; xx < sw; xx++)
			{
				if (miniset[ii] != 0)
					D1DunSet(xx + sx, yy + sy, miniset[ii]);
				ii++;
			}
	}

	if (setview)
	{
		d1_lvl_vx = 2 * sx + 21;
		d1_lvl_vy = 2 * sy + 22;
	}

	return TRUE;
}

U0 D2DrlgL2(I64 level, I64 entry)
{
	I64	 i;
	Bool doneflag = FALSE;

	D1SetPcLoadLevel(level);

	while (!doneflag)
	{
		d2_nrooms    = 0;
		d2_hall_head = 0;
		d2_hall_tail = 0;
		D2InitDungeon;
		for (i = 0; i < D1_DMAX * D1_DMAX; i++)
			d1_dun[i] = 0;

		if (D2CreateDungeon(level))
		{
			D2TileFix;
			//DRLG_L2SetRoom at the forced room's inset corner; 0 tiles
			//become catacombs floor 3
			D1SetPcRoom(d2_sx1, d2_sy1, 3);
			if (entry == 0)
			{
				doneflag = D2PlaceMiniSet(d2t_ustairs, 1, 1, -1, -1, TRUE);
				if (doneflag)
					doneflag = D2PlaceMiniSet(d2t_dstairs, 1, 1, -1, -1, FALSE);
				d1_lvl_vy -= 2;
			}
			else
			{
				doneflag = D2PlaceMiniSet(d2t_ustairs, 1, 1, -1, -1, FALSE);
				if (doneflag)
					doneflag = D2PlaceMiniSet(d2t_dstairs, 1, 1, -1, -1, TRUE);
				d1_lvl_vx--;
			}
		}
	}

	D2LockoutFix;
	D2DoorFix;
	D2DirtFix;

	D2PlaceRndSet(d2t_ctrdoor1, 100);
	D2PlaceRndSet(d2t_ctrdoor2, 100);
	D2PlaceRndSet(d2t_ctrdoor3, 100);
	D2PlaceRndSet(d2t_ctrdoor4, 100);
