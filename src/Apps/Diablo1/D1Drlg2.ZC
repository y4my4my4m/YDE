U0 D1TrigScanPieces(I64 up_piece, I64 down_piece)
{//stair trigger tiles by piece id
	I64 i;

	d1_trig_up_x   = -1;
	d1_trig_up_y   = -1;
	d1_trig_down_x = -1;
	d1_trig_down_y = -1;
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
	{
		if (d1_dpiece[i] == up_piece)
		{
			d1_trig_up_x = i % D1_MAXDUN;
			d1_trig_up_y = i / D1_MAXDUN;
		}
		if (d1_dpiece[i] == down_piece)
		{
			d1_trig_down_x = i % D1_MAXDUN;
			d1_trig_down_y = i / D1_MAXDUN;
		}
	}
}

Bool D1L2LevelLoad(I64 level, I64 seed, I64 entry)
{//catacombs level 5-8
	U8 pal[32];

	if (!D1LvlLoadGfx("Levels\\L2Data\\L2.CEL",
					  "Levels\\L2Data\\L2.MIN",
					  "Levels\\L2Data\\L2.SOL",
					  "Levels\\L2Data\\L2.TIL", 10))
		return FALSE;

	D1SetRndSeed(seed);
	D2DrlgL2(level, entry);
	D2Pass3;
	D1TrigScanPieces(267, 271);
	D1GridsClear;
	if (!D1SpecialLoad("Levels\\L2Data\\L2S.CEL"))
		return FALSE;
	D1SpecialL2Fill;

	StrPrint(pal, "Levels\\L2Data\\L2_%d.pal", D1Rnd(4) + 1);
	if (!D1PalLoad(pal))
		return FALSE;

	d1_currlevel = level;
	d1_lvl_ready = TRUE;
	return TRUE;
}
