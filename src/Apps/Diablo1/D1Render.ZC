// dungeon world renderer
//
// level CEL frames are not sprite RLE; the MIN type bits pick one of six
// fixed encodings (devilutionx dun_render, on-disk layout; the 2-byte
// alignment pads are present, devilutionx strips them at load):
//
//   0 Square             32 rows of 32 raw bytes, bottom row first
//   1 TransparentSquare  per row: I8 control, >0 copy n, <0 skip -n,
//                        runs stay inside their row
//   2 LeftTriangle       31 rows, widths 2,4..32,30..2, right-aligned,
//                        2 pad bytes BEFORE each even row
//   3 RightTriangle      as 2 but left-aligned, pads AFTER each even row
//   4 LeftTrapezoid      16 triangle rows (as 2) then 16 raw rows of 32
//   5 RightTrapezoid     16 triangle rows (as 3) then 16 raw rows of 32
//
// all anchors are the BOTTOM row; rows stack upward.
//

#define D1_TILE_W	64
#define D1_TILE_H	32
#define D1_MICRO_W	32

//camera, in tiles + pixel fine offset
I64 d1_view_x    = 75;
I64 d1_view_y    = 68;
I64 d1_view_xoff = 0;
I64 d1_view_yoff = 0;

//set by D1Play (single-pass include order)
U0 (*d1_cell_sprite_cb)(I64 x, I64 y, I64 sx, I64 sy) = NULL;

//set by D1Spell (single-pass include order)
U0 (*d1_world_overlay_cb)() = NULL;

//outline colors (scrollrt.cpp pcurs*, Cl2DrawOutlineSafe): 233 = PAL16_RED+9,
//165 = PAL16_BEIGE+5 for friendlies.
#define D1_OUTLINE_MON	233
#define D1_OUTLINE_TWN	165
#define D1_OUTLINE_ITM	148
#define D1_OUTLINE_OBJ	148

I64 d1_hover_mi  = -1;
I64 d1_hover_twn = -1;
I64 d1_hover_ii  = -1;
I64 d1_hover_oi  = -1;

U0 D1TileSquare(I64 sx, I64 sy, U8 *d, I64 dsize)
{
	I64 r;
	I64 x;
	I64 i = 0;

	if (dsize < 1024)
		return;
	for (r = 0; r < 32; r++)
		for (x = 0; x < 32; x++)
		{
			D1PixL(sx + x, sy - r, d[i]);
			i++;
		}
}

U0 D1TileTransparent(I64 sx, I64 sy, U8 *d, I64 dsize)
{
	I64 i = 0;
	I64 r = 0;
	I64 x = 0;
	I64 b;
	I64 n;

	while (i < dsize && r < 32)
	{
		b = d[i];
		i++;
		if (b & 0x80)
			x += 0x100 - b;
		else
		{
			for (n = 0; n < b; n++)
			{
				D1PixL(sx + x, sy - r, d[i]);
				i++;
				x++;
			}
		}
		if (x >= 32)
		{
			x = 0;
			r++;
		}
	}
}

U0 D1TileTriRows(I64 sx, I64 sy, U8 *d, I64 dsize, Bool left, I64 rows,
	Bool full_top)
{
	I64 i = 0;
	I64 r;
	I64 w;
	I64 x0;
	I64 x;

	for (r = 0; r < rows; r++)
	{
		if (r < 16)
			w = 2 * (r + 1);
		else
			w = 2 * (31 - r);

		if (left)
		{
			if (!(r & 1))
				i += 2;
			x0 = D1_MICRO_W - w;
		}
		else
			x0 = 0;

		for (x = 0; x < w; x++)
		{
			if (i < dsize)
				D1PixL(sx + x0 + x, sy - r, d[i]);
			i++;
		}

		if (!left)
		{
			if (!(r & 1))
				i += 2;
		}
	}

	if (full_top)
	{
		for (r = 16; r < 32; r++)
			for (x = 0; x < 32; x++)
			{
				if (i < dsize)
					D1PixL(sx + x, sy - r, d[i]);
				i++;
			}
	}
}

U0 D1TileDraw(I64 type, I64 frame, I64 sx, I64 sy)
{
	I64	 dsize = 0;
	U8	*d;

	if (!d1_lvl_cel || frame < 1 || frame > D1CelNFrames(d1_lvl_cel))
		return;
	d = D1CelFrame(d1_lvl_cel, frame, &dsize);

	switch (type)
	{
		case 0:
			D1TileSquare(sx, sy, d, dsize);
			break;
		case 1:
			D1TileTransparent(sx, sy, d, dsize);
			break;
		case 2:
			D1TileTriRows(sx, sy, d, dsize, TRUE, 31, FALSE);
			break;
		case 3:
			D1TileTriRows(sx, sy, d, dsize, FALSE, 31, FALSE);
			break;
		case 4:
			D1TileTriRows(sx, sy, d, dsize, TRUE, 16, TRUE);
			break;
		case 5:
			D1TileTriRows(sx, sy, d, dsize, FALSE, 16, TRUE);
			break;
		default:
			D1TileTransparent(sx, sy, d, dsize);
	}
}

U0 D1CellDraw(I64 x, I64 y, I64 sx, I64 sy)
{//retail gates wall dither with nTransTable & TransList[dTransVal]; town
 //has no transparency map.
	I64	 p = D1Piece(x, y);
	U16	*mt;
	I64	 k;
	I64	 e;
	Bool trans = FALSE;

	if (d1_currlevel > 0)
		trans = D1WallTransAt(x, y);

	D1ShadeForCell(x, y);

	if (p && p <= d1_npieces)
	{
		mt = d1_piece_mt + (p - 1) * D1_MT_MAX;
		//retail: mt[0]/mt[1] = floor (arch_draw 1/2), upper rows = walls.
		for (k = 0; k < d1_blocks / 2; k++)
		{
			d1_cel_trans = (trans && k > 0);
			e = mt[k * 2];
			if (e & 0xFFF)
				D1TileDraw((e >> 12) & 7, e & 0xFFF, sx, sy - k * D1_MICRO_W);
			e = mt[k * 2 + 1];
			if (e & 0xFFF)
				D1TileDraw((e >> 12) & 7, e & 0xFFF, sx + D1_MICRO_W,
					sy - k * D1_MICRO_W);
		}
		d1_cel_trans = FALSE;
	}

	if (d1_cell_sprite_cb)
		(*d1_cell_sprite_cb)(x, y, sx, sy);
}

U0 D1WorldDraw()
{//painter order is increasing (x+y) diagonal, not row-major
	I64 cx = d1_w / 2 - D1_TILE_W / 2 - d1_view_xoff;
	I64 cy = d1_vp_h / 2 + D1_TILE_H / 2 - d1_view_yoff;
	I64 sum;
	I64 x;
	I64 y;
	I64 sx;
	I64 sy;
	I64 smax = D1_MAXDUN * 2 - 2;
	I64 xpad = 2 * D1_TILE_W + (d1_w - D1_UI_W) / 4;
	I64 ypad = 8 * D1_MICRO_W + (d1_vp_h - (D1_UI_H - D1_PANEL_H)) / 2;

	if (xpad < 2 * D1_TILE_W)
		xpad = 2 * D1_TILE_W;
	if (ypad < 8 * D1_MICRO_W)
		ypad = 8 * D1_MICRO_W;

	for (sum = 0; sum <= smax; sum++)
	{
		for (x = 0; x < D1_MAXDUN; x++)
		{
			y = sum - x;
			if (y >= 0 && y < D1_MAXDUN)
			{
				sx = cx + (x - d1_view_x) * 32 - (y - d1_view_y) * 32;
				if (sx > -xpad && sx < d1_w + xpad)
				{
					sy = cy + (x - d1_view_x) * 16 + (y - d1_view_y) * 16;
					if (sy > -ypad && sy < d1_vp_h + ypad)
						D1CellDraw(x, y, sx, sy);
				}
			}
		}
	}

	d1_shade = NULL;
}

U0 D1WorldFrame()
{//scrollrt.cpp Zoom generalized. above 1.00x: render 1:1, magnify. below:
 //render the d1_w/scale x d1_h/scale extent, then minify. UI draws at 1:1.
	I64 cw;
	I64 ch;
	I64 cvp;
	I64 inv;

	D1ZoomSync;
	if (d1_zoom_scale < D1_ZOOM_ONE)
	{
		inv = D1ZoomInv();
		cw  = d1_w;
		ch  = d1_h;
		cvp = d1_vp_h;
		d1_w    = D1ZoomOutW();
		d1_h    = D1ZoomOutH();
		d1_vp_h = (cvp * inv) >> 16;
		if (d1_vp_h > d1_h)
			d1_vp_h = d1_h;
		D1WorldDraw;
		if (d1_world_overlay_cb)
			(*d1_world_overlay_cb)();
		d1_w    = cw;
		d1_h    = ch;
		d1_vp_h = cvp;
		D1ZoomOutApply;
		return;
	}

	D1WorldDraw;
	if (d1_world_overlay_cb)
		(*d1_world_overlay_cb)();
	if (d1_zoom)
		D1ZoomApply;
}

U0 D1ScreenToTile(I64 mx, I64 my, I64 *tx, I64 *ty)
{
	I64 cx = d1_w / 2 - d1_view_xoff;
	I64 cy = d1_vp_h / 2 + D1_TILE_H / 2 - d1_view_yoff;
	I64 dx = mx - cx;
	I64 dy = my - cy + 16;		//+16 aims at the diamond center

	//x - vx = dy/16 + dx/32 halved; y - vy = dy/16 - dx/32 halved
	*tx = d1_view_x + Floor(ToF64(dx * 16 + dy * 32) / 1024.0);
	*ty = d1_view_y + Floor(ToF64(dy * 32 - dx * 16) / 1024.0);
}

U0 D1TileToScreen(I64 tx, I64 ty, I64 *sx, I64 *sy)
{//sx = left edge of the 64-wide tile, sy = its base row; world space
	I64 cx = d1_w / 2 - D1_TILE_W / 2 - d1_view_xoff;
	I64 cy = d1_vp_h / 2 + D1_TILE_H / 2 - d1_view_yoff;

	*sx = cx + (tx - d1_view_x) * 32 - (ty - d1_view_y) * 32;
	*sy = cy + (tx - d1_view_x) * 16 + (ty - d1_view_y) * 16;
}

// deviation: control.cpp DrawInfoBox (:1856 monster, :1865 towner) routes the
// hovered name to the panel info box at panel-relative 177,434, centered in
// 288 (lineOffsets[0][0]). here the name floats over the actor.

#define D1_NAME_ASC	10		//SmalText glyph box 13x11, anchored on its bottom row
#define D1_NAME_GAP	4		//sprite top to name baseline

I64 D1CelFrameH(U8 *buf, I64 frame, I64 w)
{//bottom anchor to topmost opaque row. declared frames are taller than the
 //drawing: Griswold's 96x95 frame carries 75 rows, Farnham's 48.
	I64	 dsize = 0;
	U8	*d;
	I64	 i = 0;
	I64	 x = 0;
	I64	 row = 0;
	I64	 top = 0;
	I64	 b;

	if (!buf)
		return 0;
	d = D1CelFrame(buf, frame, &dsize);
	while (i < dsize)
	{
		b = d[i];
		i++;
		if (b < 0x80)
		{
			x += b;
			i += b;
			if (b > 0)
				top = row + 1;
		}
		else
			x += 0x100 - b;
		if (x >= w)
		{
			x = 0;
			row++;
		}
	}
	return top;
}

I64 D1Cl2FrameH(U8 *buf, I64 frame, I64 w)
{//CL2 frame: stream starts past the 10-byte row-block header
	I64	 dsize = 0;
	U8	*d;
	I64	 i;
	I64	 x = 0;
	I64	 row = 0;
	I64	 top = 0;
	I64	 b;
	I64	 m;
	I64	 n;

	if (!buf)
		return 0;
	d = D1CelFrame(buf, frame, &dsize);
	i = D1RdU16(d);
	while (i < dsize)
	{
		b = d[i];
		i++;
		if (b < 0x80)
		{//transparent skip, spans rows
			x += b;
			while (x >= w)
			{
				x -= w;
				row++;
			}
		}
		else
		{
			m = 0x100 - b;
			if (m > 0x41)
			{
				m -= 0x41;
				i++;
			}
			else
				i += m;
			for (n = 0; n < m; n++)
			{
				top = row + 1;
				x++;
				if (x >= w)
				{
					x = 0;
					row++;
				}
			}
		}
	}
	return top;
}

U0 D1HoverNamePos(I64 tx, I64 ty, I64 sprite_h, I64 text_w, I64 *nx, I64 *ny)
{//sprites are bottom-anchored on the cell base
	I64 sx = 0;
	I64 sy = 0;

	D1TileToScreen(tx, ty, &sx, &sy);
	if (d1_zoom)
	{
		sx = D1ZoomToScreenX(sx);
		sy = D1ZoomToScreenY(sy);
		sprite_h = D1ZoomLen(sprite_h);
	}

	*nx = sx + D1_TILE_W / 2 - text_w / 2;
	*ny = sy - sprite_h - D1_NAME_GAP;

	if (*nx > d1_w - text_w)
		*nx = d1_w - text_w;
	if (*nx < 0)
		*nx = 0;
	if (*ny > d1_vp_h - 1)
		*ny = d1_vp_h - 1;
	if (*ny < D1_NAME_ASC)
		*ny = D1_NAME_ASC;
}
