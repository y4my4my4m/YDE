// D1Render.ZC - dungeon world renderer
//
// level CEL frames are not sprite RLE; the MIN type bits pick one of six
// fixed encodings (devilutionx dun_render, on-disk layout - the 2-byte
// alignment pads are present, devilutionx strips them at load, this
// renderer walks them):
//
//   0 Square             32 rows of 32 raw bytes, bottom row first
//   1 TransparentSquare  per row: I8 control, >0 copy n, <0 skip -n,
//                        runs stay inside their row
//   2 LeftTriangle       31 rows, widths 2,4..32,30..2, right-aligned,
//                        2 pad bytes BEFORE each even row
//   3 RightTriangle      as 2 but left-aligned, pads AFTER each even row
//   4 LeftTrapezoid      16 triangle rows (as 2) then 16 raw rows of 32
//   5 RightTrapezoid     16 triangle rows (as 3) then 16 raw rows of 32
//
// all anchors are the BOTTOM row; rows stack upward.
//
// world walk: y outer, x inner is a valid painter order - two cell columns
// overlap only when their (x - y) differ by at most 1, and every such
// nearer cell has a larger y. sprites hook in per cell through
// d1_cell_sprite_cb right after the cell's column, so walls in front
// naturally overdraw them.

#define D1_TILE_W	64
#define D1_TILE_H	32
#define D1_MICRO_W	32

//camera, in tiles + pixel fine offset
I64 d1_view_x    = 75;
I64 d1_view_y    = 68;
I64 d1_view_xoff = 0;
I64 d1_view_yoff = 0;

//per-cell sprite hook, set by D1Play - dodges the single-pass include order
U0 (*d1_cell_sprite_cb)(I64 x, I64 y, I64 sx, I64 sy) = NULL;

U0 D1TileSquare(I64 sx, I64 sy, U8 *d, I64 dsize)
{
	I64 r;
	I64 x;
	I64 i = 0;

	if (dsize < 1024)
		return;
	for (r = 0; r < 32; r++)
		for (x = 0; x < 32; x++)
		{
			D1PixL(sx + x, sy - r, d[i]);
			i++;
		}
}

U0 D1TileTransparent(I64 sx, I64 sy, U8 *d, I64 dsize)
{
	I64 i = 0;
	I64 r = 0;
	I64 x = 0;
	I64 b;
	I64 n;

	while (i < dsize && r < 32)
	{
		b = d[i];
		i++;
		if (b & 0x80)
			x += 0x100 - b;
		else
		{
			for (n = 0; n < b; n++)
			{
				D1PixL(sx + x, sy - r, d[i]);
				i++;
				x++;
			}
		}
		if (x >= 32)
		{
			x = 0;
			r++;
		}
	}
}

U0 D1TileTriRows(I64 sx, I64 sy, U8 *d, I64 dsize, Bool left, I64 rows,
	Bool full_top)
{//triangle body: rows 0..rows-1 bottom-up. full_top draws the trapezoid's
 //raw 32-wide upper half afterwards.
	I64 i = 0;
	I64 r;
	I64 w;
	I64 x0;
	I64 x;

	for (r = 0; r < rows; r++)
	{
		if (r < 16)
			w = 2 * (r + 1);
		else
			w = 2 * (31 - r);

		if (left)
		{//pad before even rows, pixels right-aligned
			if (!(r & 1))
				i += 2;
			x0 = D1_MICRO_W - w;
		}
		else
			x0 = 0;

		for (x = 0; x < w; x++)
		{
			if (i < dsize)
				D1PixL(sx + x0 + x, sy - r, d[i]);
			i++;
		}

		if (!left)
		{//pad after even rows
			if (!(r & 1))
				i += 2;
		}
	}

	if (full_top)
	{
		for (r = 16; r < 32; r++)
			for (x = 0; x < 32; x++)
			{
				if (i < dsize)
					D1PixL(sx + x, sy - r, d[i]);
				i++;
			}
	}
}

U0 D1TileDraw(I64 type, I64 frame, I64 sx, I64 sy)
{//one 32px micro from the level CEL
	I64	 dsize = 0;
	U8	*d;

	if (!d1_lvl_cel || frame < 1 || frame > D1CelNFrames(d1_lvl_cel))
		return;
	d = D1CelFrame(d1_lvl_cel, frame, &dsize);

	switch (type)
	{
		case 0:
			D1TileSquare(sx, sy, d, dsize);
			break;
		case 1:
			D1TileTransparent(sx, sy, d, dsize);
			break;
		case 2:
			D1TileTriRows(sx, sy, d, dsize, TRUE, 31, FALSE);
			break;
		case 3:
			D1TileTriRows(sx, sy, d, dsize, FALSE, 31, FALSE);
			break;
		case 4:
			D1TileTriRows(sx, sy, d, dsize, TRUE, 16, TRUE);
			break;
		case 5:
			D1TileTriRows(sx, sy, d, dsize, FALSE, 16, TRUE);
			break;
		default:
			//unknown encodings render as transparent squares in practice
			D1TileTransparent(sx, sy, d, dsize);
	}
}

U0 D1CellDraw(I64 x, I64 y, I64 sx, I64 sy)
{//full piece column, bottom pair first
	I64	 p = D1Piece(x, y);
	U16	*mt;
	I64	 k;
	I64	 e;

	D1ShadeForCell(x, y);

	if (p && p <= d1_npieces)
	{
		mt = d1_piece_mt + (p - 1) * D1_MT_MAX;
		for (k = 0; k < d1_blocks / 2; k++)
		{
			e = mt[k * 2];
			if (e & 0xFFF)
				D1TileDraw((e >> 12) & 7, e & 0xFFF, sx, sy - k * D1_MICRO_W);
			e = mt[k * 2 + 1];
			if (e & 0xFFF)
				D1TileDraw((e >> 12) & 7, e & 0xFFF, sx + D1_MICRO_W,
					sy - k * D1_MICRO_W);
		}
	}

	if (d1_cell_sprite_cb)
		(*d1_cell_sprite_cb)(x, y, sx, sy);
}

U0 D1WorldDraw()
{//camera-centered painter walk over the whole grid with screen rejects.
 //the walk spans every dPiece cell, so the column range follows d1_w
 //through the sx reject alone; a wider canvas admits more columns.
	I64 cx = d1_w / 2 - D1_TILE_W / 2 - d1_view_xoff;
	I64 cy = d1_vp_h / 2 + D1_TILE_H / 2 - d1_view_yoff;
	I64 x;
	I64 y;
	I64 sx;
	I64 sy;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			sx = cx + (x - d1_view_x) * 32 - (y - d1_view_y) * 32;
			if (sx > -D1_TILE_W && sx < d1_w)
			{
				sy = cy + (x - d1_view_x) * 16 + (y - d1_view_y) * 16;
				if (sy > -D1_TILE_H && sy < D1_H + 8 * D1_MICRO_W)
					D1CellDraw(x, y, sx, sy);
			}
		}

	d1_shade = NULL;
}

U0 D1ScreenToTile(I64 mx, I64 my, I64 *tx, I64 *ty)
{//inverse of the cell transform, for click-to-walk
	I64 cx = d1_w / 2 - d1_view_xoff;
	I64 cy = d1_vp_h / 2 + D1_TILE_H / 2 - d1_view_yoff;
	I64 dx = mx - cx;
	I64 dy = my - cy + 16;		//aim at the diamond center, not its base

	//x - vx = dy/16 + dx/32 halved; y - vy = dy/16 - dx/32 halved
	*tx = d1_view_x + Floor(ToF64(dx * 16 + dy * 32) / 1024.0);
	*ty = d1_view_y + Floor(ToF64(dy * 32 - dx * 16) / 1024.0);
}
