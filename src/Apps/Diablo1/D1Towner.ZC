// town NPCs: stand animations and dialog
//
// towner gfx are unclipped CELs, one facing, 96 wide; frame count read from
// the file. anim rate is towners.cpp NewTownerAnim's Delay in 20Hz ticks.
// _tAnimOrder frame-sequence tables are absent; frames cycle in file order.
// dialog text comes from D1TwnT (textdat.cpp alltext); the box mirrors
// minitext.cpp DrawQTextBack/DrawQText.

#define D1_MAXTWN	12
#define D1_MAXGOSSIP	12
#define D1_TWNQ			13		//D1Quest quest count; D1Quest compiles later

#define D1TK_SHOP		0
#define D1TK_DEADGUY	1
#define D1TK_COW		2

//Data\TextBox.CEL: one unclipped 591-wide frame, bottom row at y 327
//(minitext.cpp DrawQTextBack draws it at PANEL_X + 24, SCREEN_Y + 327)
#define D1_DLG_X		24
#define D1_DLG_BOT		327
#define D1_DLG_W		591
#define D1_DLG_TX		48		//text column, DrawQText's tx
#define D1_DLG_TW		543		//DrawQText's line width limit
//DrawQTextBack trans_rect
#define D1_DLG_FX		27
#define D1_DLG_FY		28
#define D1_DLG_FW		585
#define D1_DLG_FH		297
//PrintQTextChr pStart/pEnd rows (buffer 209..469 less SCREEN_Y),
//InitQTextMsg start row
#define D1_DLG_CLIPTOP	49
#define D1_DLG_CLIPBOT	309
#define D1_DLG_TY0		340
#define D1_DLG_MAXLINE	64

class CD1Towner
{
	U8	*cel;
	U8	 name[24];
	I64	 x;
	I64	 y;
	I64	 frames;
	I64	 frame;
	I64	 cnt;
	I64	 delay;					//NewTownerAnim Delay, in game ticks
	I64	 h;
	I64	 w;						//draw width (96 shop, 128 cow)
	I64	 kind;					//D1TK_*
	Bool active;
	Bool frozen;
};

CD1Towner d1_twn[D1_MAXTWN];
I64		  d1_ntwn = 0;
U8		 *d1_cow_cel = NULL;
I64		  d1_cow_clicks = 0;

U0	(*d1_deadguy_talk_cb)(I64 ti) = NULL;
U0	(*d1_smith_talk_cb)(I64 ti) = NULL;

U8	*d1_twn_greet[D1_MAXTWN];
U8	*d1_twn_gossip[D1_MAXTWN * D1_MAXGOSSIP];
I64	 d1_twn_ngossip[D1_MAXTWN];
I64	 d1_twn_gnext[D1_MAXTWN];
U8	*d1_twn_quest[D1_MAXTWN * D1_TWNQ];
Bool d1_twn_txt_init = FALSE;

//quest dungeon levels, D1Quest.ZC questlist order and _qdlvl column
I64	 d1_twn_qlvl[D1_TWNQ] = {2, 3, 4, 5, 6, 7, 8, 9, 10, 13, 14, 15, 16};

U0 D1TwnGreet(I64 t, U8 *s)
{
	if (t >= 0 && t < D1_MAXTWN)
		d1_twn_greet[t] = s;
}

U0 D1TwnGossip(I64 t, I64 i, U8 *s)
{
	if (t < 0 || t >= D1_MAXTWN || i < 0 || i >= D1_MAXGOSSIP)
		return;
	d1_twn_gossip[t * D1_MAXGOSSIP + i] = s;
	if (i + 1 > d1_twn_ngossip[t])
		d1_twn_ngossip[t] = i + 1;
}

U0 D1TwnQuest(I64 t, I64 q, U8 *s)
{
	if (t < 0 || t >= D1_MAXTWN || q < 0 || q >= D1_TWNQ)
		return;
	d1_twn_quest[t * D1_TWNQ + q] = s;
}

#include "D1TwnT"

U0 D1TownerTextInit()
{
	I64 i;

	if (d1_twn_txt_init)
		return;
	for (i = 0; i < D1_MAXTWN; i++)
	{
		d1_twn_greet[i]   = NULL;
		d1_twn_ngossip[i] = 0;
		d1_twn_gnext[i]   = 0;
	}
	for (i = 0; i < D1_MAXTWN * D1_MAXGOSSIP; i++)
		d1_twn_gossip[i] = NULL;
	for (i = 0; i < D1_MAXTWN * D1_TWNQ; i++)
		d1_twn_quest[i] = NULL;
	D1TwnTFill;
	d1_twn_txt_init = TRUE;
}

U0 D1TownerAdd(U8 *cel_name, U8 *name, I64 x, I64 y, I64 delay)
{
	CD1Towner *t;
	I64	 size = 0;
	U8	*cel;

	if (d1_ntwn >= D1_MAXTWN)
		return;

	cel = D1MpqRead(cel_name, &size);
	if (!cel)
	{
		"D1Towner: no %s\n", cel_name;
		return;
	}

	t = &d1_twn[d1_ntwn];
	t->cel    = cel;
	t->x      = x;
	t->y      = y;
	t->frames = D1CelNFrames(cel);
	t->frame  = 1;
	t->cnt    = 0;
	t->delay  = delay;
	t->w      = 96;
	t->kind   = D1TK_SHOP;
	t->h      = D1CelFrameH(cel, 1, 96);
	t->active = TRUE;
	t->frozen = FALSE;
	D1StrCopy(t->name, name, 24);

	d1_dtwn[x + y * D1_MAXDUN] = d1_ntwn + 1;
	d1_ntwn++;
}

U0 D1TownerAddCow(I64 x, I64 y, I64 dir)
{//InitCows
	CD1Towner *t;
	I64 size = 0;
	U8 *grp;
	Bool was;

	if (d1_ntwn >= D1_MAXTWN)
		return;
	if (!d1_cow_cel)
	{
		d1_cow_cel = D1MpqRead("Towners\\Animals\\Cow.CEL", &size);
		if (!d1_cow_cel)
		{
			"D1Towner: no Cow.CEL\n";
			return;
		}
	}
	grp = D1Cl2Dir(d1_cow_cel, dir);
	t = &d1_twn[d1_ntwn];
	t->cel    = grp;
	t->x      = x;
	t->y      = y;
	t->frames = D1CelNFrames(grp);
	was = D1NetLocalIn();
	t->frame = 1 + D1Rnd(t->frames);
	D1NetLocalOut(was);
	if (t->frame > t->frames)
		t->frame = 1;
	t->cnt    = 0;
	t->delay  = 3;
	t->w      = 128;
	t->kind   = D1TK_COW;
	t->h      = D1CelFrameH(grp, 1, 128);
	t->active = TRUE;
	t->frozen = FALSE;
	D1StrCopy(t->name, "Cow", 24);
	d1_dtwn[x + y * D1_MAXDUN] = d1_ntwn + 1;
	d1_ntwn++;
}

U0 D1TownerAddDeadguy()
{//InitTownDead
	CD1Towner *t;
	I64 size = 0;
	U8 *cel;

	if (d1_ntwn >= D1_MAXTWN)
		return;
	cel = D1MpqRead("Towners\\Butch\\Deadguy.CEL", &size);
	if (!cel)
	{
		"D1Towner: no Deadguy.CEL\n";
		return;
	}
	t = &d1_twn[d1_ntwn];
	t->cel    = cel;
	t->x      = 24;
	t->y      = 32;
	t->frames = D1CelNFrames(cel);
	t->frame  = 1;
	t->cnt    = 0;
	t->delay  = 6;
	t->w      = 96;
	t->kind   = D1TK_DEADGUY;
	t->h      = D1CelFrameH(cel, 1, 96);
	t->active = TRUE;
	t->frozen = FALSE;
	D1StrCopy(t->name, "Wounded Townsman", 24);
	d1_dtwn[24 + 32 * D1_MAXDUN] = d1_ntwn + 1;
	d1_ntwn++;
}

U0 D1TownersInit()
{//towners.cpp InitTowners
	I64 i;

	for (i = 0; i < D1_MAXTWN; i++)
		d1_twn[i].active = FALSE;
	d1_ntwn = 0;
	d1_cow_clicks = 0;

	D1TownerAdd("Towners\\Smith\\SmithN.CEL", "Griswold", 62, 63, 3);
	D1TownerAdd("Towners\\TwnF\\TwnFN.CEL", "Ogden", 55, 62, 3);
	D1TownerAdd("Towners\\TownWmn1\\Witch.CEL", "Adria", 80, 20, 6);
	D1TownerAdd("Towners\\TownWmn1\\WmnN.CEL", "Gillian", 43, 66, 6);
	D1TownerAdd("Towners\\TownBoy\\PegKid1.CEL", "Wirt", 11, 53, 6);
	D1TownerAdd("Towners\\Healer\\Healer.CEL", "Pepin", 55, 79, 6);
	D1TownerAdd("Towners\\Strytell\\Strytell.CEL", "Cain", 62, 71, 3);
	D1TownerAdd("Towners\\Drunk\\TwnDrunk.CEL", "Farnham", 71, 84, 3);
	D1TownerAddDeadguy;
	//towners.tsv: SW=1 NW=3 N=4
	D1TownerAddCow(58, 16, 1);
	D1TownerAddCow(56, 14, 3);
	D1TownerAddCow(59, 20, 4);
}

U0 D1TownersTick()
{//towners.cpp ProcessTowners, 20Hz
	CD1Towner *t;
	I64 i;

	for (i = 0; i < d1_ntwn; i++)
	{
		t = &d1_twn[i];
		if (t->active && !t->frozen)
		{
			t->cnt++;
			if (t->cnt >= t->delay)
			{
				t->cnt = 0;
				t->frame++;
				if (t->frame > t->frames)
					t->frame = 1;
			}
		}
	}
}

U0 D1TownerDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{
	CD1Towner *t;
	I64 ti = d1_dtwn[x + y * D1_MAXDUN];
	I64 ox;

	if (!ti)
		return;
	t = &d1_twn[ti - 1];
	if (t->active && t->cel && t->x == x && t->y == y)
	{
		ox = sx - (t->w - 64) / 2;
		if (ti - 1 == d1_hover_twn)
			D1CelDrawOutline(ox, sy, t->cel, t->frame, t->w,
				D1_OUTLINE_TWN);
		D1CelDraw(ox, sy, t->cel, t->frame, t->w);
	}
}

U0 D1CowTalk(I64 ti)
{//TalkToCow
	U8 *path;

	if (ti < 0 || ti >= d1_ntwn || d1_twn[ti].kind != D1TK_COW)
		return;
	d1_cow_clicks++;
	if (d1_cow_clicks == 4)
	{
		path = "Sfx\\Towners\\Cow2.wav";
		d1_cow_clicks = 0;
	}
	else
		path = "Sfx\\Towners\\Cow1.wav";
	if (d1_opt_sfx)
		D1SndPlay(path);
}

U8 *D1TownerQuote(I64 ti)
{//the retail dialog trees are absent
	CD1Towner *t = &d1_twn[ti];

	if (!StrCompare(t->name, "Griswold"))
		return "Well, what can I do for ya?";
	if (!StrCompare(t->name, "Ogden"))
		return "Greetings, good master. Welcome to the Tavern of the Rising Sun!";
	if (!StrCompare(t->name, "Adria"))
		return "I sense a soul in search of answers.";
	if (!StrCompare(t->name, "Gillian"))
		return "Good day! How may I serve you?";
	if (!StrCompare(t->name, "Wirt"))
		return "Psst... over here.";
	if (!StrCompare(t->name, "Pepin"))
		return "What ails you, my friend?";
	if (!StrCompare(t->name, "Cain"))
		return "Hello, my friend. Stay awhile and listen.";
	if (!StrCompare(t->name, "Farnham"))
		return "Wanna talk about... whatsis... you know... stuff?";
	return "...";
}

#define D1_MAXTOPIC		16

Bool d1_dlg_open  = FALSE;
I64	 d1_dlg_twn   = -1;
U8	*d1_dlg_topic[D1_MAXTOPIC];
I64	 d1_dlg_ntopic = 0;
I64	 d1_dlg_ti     = 0;
I64	 d1_dlg_start[D1_DLG_MAXLINE];		//byte offset into the topic
I64	 d1_dlg_len[D1_DLG_MAXLINE];
I64	 d1_dlg_nline  = 0;
I64	 d1_dlg_first  = 0;
I64	 d1_dlg_ty     = 0;			//band-local baseline
I64	 d1_dlg_spd    = 2;			//qscroll_spd_tbl value
I64	 d1_dlg_delay  = 2;			//qtextDelay
U8	 d1_dlg_line[160];
U8	*d1_dlg_cel    = NULL;
U0	(*d1_dlg_topic_cb)() = NULL;

//minitext.cpp qscroll_spd_tbl, indexed by alltext txtspd - 1. positive n
//pauses 1 of n ticks, negative n scrolls 1 + (-n) px per tick.
I64 d1_qscroll_tbl[9] = {2, 4, 6, 8, 0, -1, -2, -3, -4};

U0 D1DlgWrap(U8 *s)
{//greedy break at D1_DLG_TW, the DrawQText line limit
	I64 i     = 0;
	I64 n     = 0;
	I64 last  = -1;
	I64 begin = 0;
	I64 c;

	d1_dlg_nline = 0;
	if (!s)
		return;

	while (s[i] && d1_dlg_nline < D1_DLG_MAXLINE)
	{
		c = s[i];
		if (n < 158)
		{
			d1_dlg_line[n] = c;
			n++;
			d1_dlg_line[n] = 0;
		}
		if (c == ' ')
			last = i;
		i++;
		if (D1MedTextWidth(d1_dlg_line) > D1_DLG_TW)
		{
			d1_dlg_start[d1_dlg_nline] = begin;
			if (last > begin)
			{
				d1_dlg_len[d1_dlg_nline] = last - begin;
				i = last + 1;
			}
			else
			{
				i--;
				if (i <= begin)
					i = begin + 1;
				d1_dlg_len[d1_dlg_nline] = i - begin;
			}
			d1_dlg_nline++;
			begin = i;
			last  = -1;
			n     = 0;
			d1_dlg_line[0] = 0;
		}
	}
	if (i > begin && d1_dlg_nline < D1_DLG_MAXLINE)
	{
		d1_dlg_start[d1_dlg_nline] = begin;
		d1_dlg_len[d1_dlg_nline]   = i - begin;
		d1_dlg_nline++;
	}
}

U0 D1DlgTopic(I64 k)
{//InitQTextMsg
	I64 spd;

	d1_dlg_ti = k;
	if (k >= 0 && k < d1_dlg_ntopic)
	{
		D1DlgWrap(d1_dlg_topic[k]);
		d1_dlg_first = 0;
		d1_dlg_ty    = D1_DLG_TY0;
		spd = D1TwnSpd(d1_dlg_topic[k]);
		if (spd < 1)
			spd = 1;
		if (spd > 9)
			spd = 9;
		d1_dlg_spd   = d1_qscroll_tbl[spd - 1];
		d1_dlg_delay = d1_dlg_spd;
	}
}

U0 D1TownerTalk(I64 ti)
{//towners.cpp TalkToTowner
	I64 size = 0;
	I64 q;
	I64 g;

	if (ti < 0 || ti >= d1_ntwn)
		return;
	D1TownerTextInit;
	if (!d1_dlg_cel)
		d1_dlg_cel = D1MpqRead("Data\\TextBox.CEL", &size);
	if (!d1_medtext)
		d1_medtext = D1MpqRead("Data\\MedTextS.CEL", &size);

	d1_dlg_ntopic = 0;
	if (d1_twn_greet[ti])
	{
		d1_dlg_topic[d1_dlg_ntopic] = d1_twn_greet[ti];
		d1_dlg_ntopic++;
	}
	for (q = 0; q < D1_TWNQ; q++)
	{
		if (d1_dlg_ntopic < D1_MAXTOPIC - 1 &&
			d1_twn_quest[ti * D1_TWNQ + q] &&
			d1_deepest_lvl >= d1_twn_qlvl[q])
		{
			d1_dlg_topic[d1_dlg_ntopic] = d1_twn_quest[ti * D1_TWNQ + q];
			d1_dlg_ntopic++;
		}
	}
	if (d1_twn_ngossip[ti] > 0 && d1_dlg_ntopic < D1_MAXTOPIC)
	{
		g = d1_twn_gnext[ti] % d1_twn_ngossip[ti];
		d1_dlg_topic[d1_dlg_ntopic] = d1_twn_gossip[ti * D1_MAXGOSSIP + g];
		d1_dlg_ntopic++;
		d1_twn_gnext[ti] = g + 1;
	}
	if (d1_dlg_ntopic == 0)
		return;

	d1_dlg_twn  = ti;
	d1_dlg_open = TRUE;
	D1DlgTopic(0);
}

U0 D1TownerDlgClose()
{
	d1_dlg_open   = FALSE;
	d1_dlg_twn    = -1;
	d1_dlg_ntopic = 0;
	d1_dlg_nline  = 0;
}

Bool D1TownerDlgAdvance()
{//retail closes the box outright (PressEscKey)
	if (!d1_dlg_open)
		return FALSE;
	if (d1_dlg_ti + 1 < d1_dlg_ntopic)
	{
		D1DlgTopic(d1_dlg_ti + 1);
		return TRUE;
	}
	D1TownerDlgClose;
	return FALSE;
}

U0 D1TownerDlgTick()
{//DrawQText scroll step, at the 20Hz game tick
	if (!d1_dlg_open)
		return;

	if (d1_dlg_spd <= 0)
		d1_dlg_ty -= 1 - d1_dlg_spd;
	else
	{
		d1_dlg_delay--;
		if (d1_dlg_delay != 0)
			d1_dlg_ty--;
		if (d1_dlg_delay <= 0)
			d1_dlg_delay = d1_dlg_spd;
	}

	if (d1_dlg_ty <= D1_DLG_CLIPTOP)
	{
		d1_dlg_ty += D1_MED_PITCH;
		d1_dlg_first++;
		if (d1_dlg_first >= d1_dlg_nline)
		{
			D1TownerDlgAdvance;
			if (d1_dlg_topic_cb)
				(*d1_dlg_topic_cb)();
		}
	}
}

U0 D1TownerDlgDraw()
{//DrawQTextBack + DrawQText. D1_DLG_* are coordinates inside the centered
 //640x480 UI band
	I64 ln;
	I64 i;
	I64 n;
	I64 y;
	I64 ox;
	I64 ty;
	U8 *s;

	if (!d1_dlg_open || d1_dlg_twn < 0)
		return;
	ox = D1UiOrgX();
	ty = D1UiOrgY();

	d1_shade = NULL;
	d1_cel_trans = FALSE;
	if (d1_dlg_cel)
		D1CelDraw(ox + D1_DLG_X, ty + D1_DLG_BOT, d1_dlg_cel, 1, D1_DLG_W);
	D1FillRectTransDither(ox + D1_DLG_FX, ty + D1_DLG_FY, D1_DLG_FW, D1_DLG_FH);

	s = d1_dlg_topic[d1_dlg_ti];
	for (ln = d1_dlg_first; ln < d1_dlg_nline; ln++)
	{
		y = d1_dlg_ty + (ln - d1_dlg_first) * D1_MED_PITCH;
		if (y > D1_DLG_CLIPBOT + D1_MED_PITCH)
			break;
		n = d1_dlg_len[ln];
		if (n > 158)
			n = 158;
		for (i = 0; i < n; i++)
			d1_dlg_line[i] = s[d1_dlg_start[ln] + i];
		d1_dlg_line[n] = 0;
		D1MedTextDraw(ox + D1_DLG_TX, ty + y, d1_dlg_line,
			ty + D1_DLG_CLIPTOP, ty + D1_DLG_CLIPBOT);
	}
}

I64 D1TownerAt(I64 x, I64 y)
{
	I64 ti;

	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return -1;
	ti = d1_dtwn[x + y * D1_MAXDUN];
	if (!ti)
		return -1;
	return ti - 1;
}

I64 D1TownerAtCurs(I64 x, I64 y)
{//CheckCursMove town scan: (mx+1,my), (mx,my+1), (mx,my), (mx+1,my+1)
	I64 ti = D1TownerAt(x + 1, y);

	if (ti >= 0)
		return ti;
	ti = D1TownerAt(x, y + 1);
	if (ti >= 0)
		return ti;
	ti = D1TownerAt(x, y);
	if (ti >= 0)
		return ti;
	return D1TownerAt(x + 1, y + 1);
}

U8 *D1TownerNameAt(I64 x, I64 y)
{
	I64 ti;

	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return NULL;
	ti = d1_dtwn[x + y * D1_MAXDUN];
	if (!ti)
		return NULL;
	return d1_twn[ti - 1].name;
}
