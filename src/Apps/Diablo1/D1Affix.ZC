// D1Affix.ZC - magic item prefixes and suffixes
//
// table rows come from D1AffT (itemdat.cpp PL_Prefix / PL_Suffix, generated).
// an affix reference is 1-based: 0 means "none", so an all-zero side table
// reads as a plain non-magic item and the hooks below are optional.
//
// affix ids are held outside CD1Item / the inventory arrays, in the D1Item
// side tables d1_st_ground / d1_st_inv / d1_st_equip - one CD1ItmSt per
// ground index, inventory entry and equip slot. Keeping them in that record
// means D1Inv's equip and unequip moves carry them without a second copy.
//
// deviation from items.cpp SaveItemPower: the per-instance roll r is not
// stored, so every magnitude is the midpoint of param1..param2. rolls stay
// inside the table's own min/max, and item value is CalcItemValue driven by
// that same midpoint through PLVal.

#define D1_MAXAFF		112
//prefix 13 + base 31 + " of " + spell 15 + " of " + suffix 13
#define D1_AFFNAME		96

//affix_item_type
#define D1PLT_MISC		0x1
#define D1PLT_BOW		0x10
#define D1PLT_STAFF		0x100
#define D1PLT_WEAP		0x1000
#define D1PLT_SHLD		0x10000
#define D1PLT_ARMO		0x100000

//good/evil tag; a good prefix and an evil suffix never share an item
#define D1GOE_ANY		0x00
#define D1GOE_EVIL		0x01
#define D1GOE_GOOD		0x10

//item_effect_type values this port applies
#define D1IPL_TOHIT			0x00
#define D1IPL_TOHIT_CURSE	0x01
#define D1IPL_DAMP			0x02
#define D1IPL_DAMP_CURSE	0x03
#define D1IPL_TOHIT_DAMP	0x04
#define D1IPL_TOHIT_DAMP_C	0x05
#define D1IPL_ACP			0x06
#define D1IPL_ACP_CURSE		0x07
#define D1IPL_STR			0x13
#define D1IPL_STR_CURSE		0x14
#define D1IPL_MAG			0x15
#define D1IPL_MAG_CURSE		0x16
#define D1IPL_DEX			0x17
#define D1IPL_DEX_CURSE		0x18
#define D1IPL_VIT			0x19
#define D1IPL_VIT_CURSE		0x1A
#define D1IPL_ATTRIBS		0x1B
#define D1IPL_ATTRIBS_CURSE	0x1C
#define D1IPL_LIFE			0x1F
#define D1IPL_LIFE_CURSE	0x20
#define D1IPL_MANA			0x21
#define D1IPL_MANA_CURSE	0x22
#define D1IPL_DUR			0x23
#define D1IPL_DUR_CURSE		0x24
#define D1IPL_INDESTRUCT	0x25
#define D1IPL_INVCURS		0x2C
#define D1IPL_CHARGES		0x0F
#define D1IPL_DAMMOD		0x3D
#define D1IPL_SETDAM		0x3F
#define D1IPL_SETDUR		0x40
#define D1IPL_NOMINSTR		0x41
#define D1IPL_SPELL			0x42
#define D1IPL_ONEHAND		0x44
#define D1IPL_SETAC			0x4B
#define D1IPL_AC_CURSE		0x4F

class CD1Affix
{
	U8	 name[16];
	I64	 power;
	I64	 p1;
	I64	 p2;
	I64	 minlvl;
	I64	 itype;			//D1PLT_* mask
	I64	 goe;
	I64	 dbl;			//counted twice in the prefix pool
	I64	 ok;			//eligible when the roll is onlygood
	I64	 minval;
	I64	 maxval;
	I64	 multval;
};

CD1Affix d1_pfx[D1_MAXAFF];
CD1Affix d1_sfx[D1_MAXAFF];
I64	 d1_n_pfx = 0;
I64	 d1_n_sfx = 0;
Bool d1_aff_init = FALSE;

U0 D1PfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_pfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_pfx)
		d1_n_pfx = i + 1;
}

U0 D1SfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_sfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_sfx)
		d1_n_sfx = i + 1;
}

#include "D1AffT"

//--- unique items ----------------------------------------------------------
//
// itemdat.cpp UniqueItemList through D1UnqT (generated). a unique upgrades
// one base row, carries up to six item_effect_type powers and drops at most
// once per game; d1_unq_taken mirrors items.cpp UniqueItemFlag.

#define D1_MAXUNQ	32
#define D1_UPOW		6
#define D1_UNAME	24

class CD1Unique
{
	U8	 name[D1_UNAME];
	I64	 row;			//D1ItmT base row the unique upgrades
	I64	 minlvl;
	I64	 value;
	I64	 npow;
	I64	 pw[D1_UPOW];	//item_effect_type
	I64	 pa[D1_UPOW];	//param1
	I64	 pb[D1_UPOW];	//param2
};

CD1Unique d1_unq[D1_MAXUNQ];
I64	 d1_n_unq = 0;
Bool d1_unq_taken[D1_MAXUNQ];

U0 D1UnqSet(I64 i, U8 *name, I64 row, I64 minlvl, I64 value, I64 npow)
{
	CD1Unique *u = &d1_unq[i];
	I64	 k;

	D1StrCopy(u->name, name, D1_UNAME);
	u->row    = row;
	u->minlvl = minlvl;
	u->value  = value;
	u->npow   = npow;
	for (k = 0; k < D1_UPOW; k++)
	{
		u->pw[k] = 0;
		u->pa[k] = 0;
		u->pb[k] = 0;
	}
	if (i + 1 > d1_n_unq)
		d1_n_unq = i + 1;
}

U0 D1UnqPow(I64 i, I64 k, I64 pw, I64 pa, I64 pb)
{
	CD1Unique *u = &d1_unq[i];

	if (k < 0 || k >= D1_UPOW)
		return;
	u->pw[k] = pw;
	u->pa[k] = pa;
	u->pb[k] = pb;
}

#include "D1UnqT"

//--- side table access -----------------------------------------------------

U0 D1AffixInit()
{
	I64 i;

	if (d1_aff_init)
		return;
	d1_n_pfx = 0;
	d1_n_sfx = 0;
	d1_n_unq = 0;
	D1AffTFill;
	D1UnqTFill;
	for (i = 0; i < D1_MAXUNQ; i++)
		d1_unq_taken[i] = FALSE;
	d1_aff_init = TRUE;
}

U0 D1AffSetGround(I64 i, I64 pfx, I64 sfx)
{
	if (i < 0 || i >= D1_MAXITEM)
		return;
	d1_st_ground[i].pfx = pfx;
	d1_st_ground[i].sfx = sfx;
}

U0 D1AffGetGround(I64 i, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (i < 0 || i >= D1_MAXITEM)
		return;
	*pfx = d1_st_ground[i].pfx;
	*sfx = d1_st_ground[i].sfx;
}

U0 D1AffSetInv(I64 e, I64 pfx, I64 sfx)
{
	if (e < 0 || e >= D1_MAXINV)
		return;
	d1_st_inv[e].pfx = pfx;
	d1_st_inv[e].sfx = sfx;
}

U0 D1AffGetInv(I64 e, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (e < 0 || e >= D1_MAXINV)
		return;
	*pfx = d1_st_inv[e].pfx;
	*sfx = d1_st_inv[e].sfx;
}

U0 D1AffSetEquip(I64 s, I64 pfx, I64 sfx)
{
	if (s < 0 || s >= D1EQ_N)
		return;
	d1_st_equip[s].pfx = pfx;
	d1_st_equip[s].sfx = sfx;
}

U0 D1AffGetEquip(I64 s, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (s < 0 || s >= D1EQ_N)
		return;
	*pfx = d1_st_equip[s].pfx;
	*sfx = d1_st_equip[s].sfx;
}

I64 D1AffFreeInvEntry()
{//the entry D1InvPut will claim next; same first-free rule
	I64 i;
	I64 e = -1;

	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	return e;
}

Bool D1AffInvPut(I64 itm, I64 val, I64 pfx, I64 sfx)
{//D1InvPut plus the matching side entry
	I64	 e = D1AffFreeInvEntry();
	Bool ok;

	ok = D1InvPut(itm, val);
	if (ok && e >= 0)
		D1AffSetInv(e, pfx, sfx);
	return ok;
}

//--- table lookup ----------------------------------------------------------

I64 D1AffixStrLen(U8 *s)
{
	I64 i = 0;

	while (s[i])
		i++;
	return i;
}

Bool D1AffixIsBow(I64 itm_row)
{//bows take the PLT_BOW pool; the base table has no weapon subtype field
	U8	*n;
	I64	 l;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return FALSE;
	n = d1_itmdefs[itm_row].name;
	l = D1AffixStrLen(n);
	if (l < 3)
		return FALSE;
	return n[l - 3] == 'B' && n[l - 2] == 'o' && n[l - 1] == 'w';
}

I64 D1AffixFlags(I64 itm_row)
{//GetItemBonus dispatch, reduced to the four base classes this port carries.
 //0 = the item takes no affixes (gold, potions).
	CD1ItmDef *d;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	d = &d1_itmdefs[itm_row];
	if (d->misc)
		return 0;
	if (d->cls == D1IC_WEAPON)
	{
		if (d->stf)
			return D1PLT_STAFF;
		if (D1AffixIsBow(itm_row))
			return D1PLT_BOW;
		return D1PLT_WEAP;
	}
	if (d->cls == D1IC_ARMOR)
	{
		if (d->loc == D1IL_ONEHAND)
			return D1PLT_SHLD;
		return D1PLT_ARMO;
	}
	return 0;
}

CD1Affix *D1AffixPfxPtr(I64 id)
{//id is 1-based; 0 = none
	if (id <= 0 || id > d1_n_pfx)
		return NULL;
	return &d1_pfx[id - 1];
}

CD1Affix *D1AffixSfxPtr(I64 id)
{
	if (id <= 0 || id > d1_n_sfx)
		return NULL;
	return &d1_sfx[id - 1];
}

I64 D1AffixMag(CD1Affix *a)
{//midpoint of param1..param2 stands in for the unstored roll
	if (!a)
		return 0;
	return (a->p1 + a->p2) / 2;
}

//--- rolling ---------------------------------------------------------------

I64 D1AffixRoll(I64 itm_row, I64 ilvl, I64 *pfx_out, I64 *sfx_out)
{//items.cpp GetItemPower over GetItemBonus's minlvl = ilvl >> 1 window.
 //returns 1 when at least one affix landed. ids are 1-based, 0 = none.
	I64	 pool[2 * D1_MAXAFF];
	I64	 flgs;
	I64	 minlvl;
	I64	 maxlvl;
	I64	 pre;
	I64	 post;
	I64	 n;
	I64	 j;
	I64	 goe;
	I64	 pick;
	CD1Affix *a;
	Bool onlygood;

	*pfx_out = 0;
	*sfx_out = 0;
	D1AffixInit;

	flgs = D1AffixFlags(itm_row);
	if (!flgs)
		return 0;

	minlvl = ilvl >> 1;
	maxlvl = ilvl;
	if (minlvl > 25)
		minlvl = 25;

	pre  = D1Rnd(4);
	post = D1Rnd(3);
	if (pre != 0 && post == 0)
	{
		if (D1Rnd(2) != 0)
			post = 1;
		else
			pre = 0;
	}

	onlygood = FALSE;
	if (D1Rnd(3) != 0)
		onlygood = TRUE;
	goe = D1GOE_ANY;

	if (pre == 0)
	{
		n = 0;
		for (j = 0; j < d1_n_pfx; j++)
		{
			a = &d1_pfx[j];
			if ((flgs & a->itype) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl && (!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
				if (a->dbl)
				{
					pool[n] = j;
					n++;
				}
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*pfx_out = pick + 1;
			goe      = d1_pfx[pick].goe;
		}
	}

	if (post != 0)
	{
		n = 0;
		for (j = 0; j < d1_n_sfx; j++)
		{
			a = &d1_sfx[j];
			if ((a->itype & flgs) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl &&
				(goe | a->goe) != (D1GOE_GOOD | D1GOE_EVIL) &&
				(!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*sfx_out = pick + 1;
		}
	}

	if (*pfx_out || *sfx_out)
		return 1;
	return 0;
}

I64 D1AffixStaffPfx(I64 lvl)
{//items.cpp GetStaffPower: a staff takes a prefix one roll in ten, out of the
 //PLT_STAFF pool, and never a suffix. onlygood is FALSE on a floor drop, so
 //its always-prefix arm is absent. returns a 1-based prefix id, 0 = none.
	I64	 pool[2 * D1_MAXAFF];
	I64	 n = 0;
	I64	 j;
	CD1Affix *a;

	if (D1Rnd(10) != 0)
		return 0;
	for (j = 0; j < d1_n_pfx; j++)
	{
		a = &d1_pfx[j];
		if ((a->itype & D1PLT_STAFF) && a->minlvl <= lvl)
		{
			pool[n] = j;
			n++;
			if (a->dbl)
			{
				pool[n] = j;
				n++;
			}
		}
	}
	if (n == 0)
		return 0;
	return pool[D1Rnd(n)] + 1;
}

//--- unique rolling --------------------------------------------------------

CD1Unique *D1UnqPtr(I64 uid1)
{//uid is 1-based; 0 = not unique
	if (uid1 <= 0 || uid1 > d1_n_unq)
		return NULL;
	return &d1_unq[uid1 - 1];
}

I64 D1UnqMag(CD1Unique *u, I64 k)
{//midpoint of param1..param2, matching the affix deviation above
	return (u->pa[k] + u->pb[k]) / 2;
}

Bool D1UnqHas(CD1ItmSt *st, I64 pw)
{//powers read as absent until the item is identified
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;

	if (!u || !st->ident)
		return FALSE;
	for (k = 0; k < u->npow; k++)
	{
		if (u->pw[k] == pw)
			return TRUE;
	}
	return FALSE;
}

I64 D1UnqSum(CD1ItmSt *st, I64 pw)
{//summed magnitude of every power of this type, 0 while unidentified
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;
	I64	 v = 0;

	if (!u || !st->ident)
		return 0;
	for (k = 0; k < u->npow; k++)
	{
		if (u->pw[k] == pw)
			v += D1UnqMag(u, k);
	}
	return v;
}

I64 D1UnqP1(CD1ItmSt *st, I64 pw)
{//param1 of the first matching power; SETDAM/SETAC/INVCURS take it raw
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;
	I64	 v = 0;
	Bool got = FALSE;

	if (!u || !st->ident)
		return 0;
	for (k = 0; k < u->npow; k++)
	{
		if (!got && u->pw[k] == pw)
		{
			v   = u->pa[k];
			got = TRUE;
		}
	}
	return v;
}

I64 D1UnqCheck(I64 itm_row, I64 lvl, I64 uper)
{//items.cpp CheckUnique. returns a 1-based unique id, 0 for none.
 //the original burns random_(29, 10) and then walks uok[] to its last set
 //entry, so the last eligible unique always wins; kept as-is.
	I64	 j;
	I64	 numu = 0;
	I64	 last = -1;

	if (D1Rnd(100) > uper)
		return 0;
	for (j = 0; j < d1_n_unq; j++)
	{
		if (d1_unq[j].row == itm_row && lvl >= d1_unq[j].minlvl &&
			!d1_unq_taken[j])
		{
			numu++;
			last = j;
		}
	}
	if (numu == 0)
		return 0;
	D1Rnd(10);
	return last + 1;
}

U0 D1UnqAssign(CD1ItmSt *st, I64 uid1)
{//items.cpp GetUniqueItem: flag the unique and fold the powers that reshape
 //the item itself. durability is set at creation, so it applies whether or
 //not the item has been identified; every other power is read through
 //D1UnqHas/D1UnqSum, which gate on the identified flag.
	CD1Unique *u = D1UnqPtr(uid1);
	I64	 k;
	I64	 p;
	I64	 r;
	I64	 d2;

	if (!u)
		return;
	d1_unq_taken[uid1 - 1] = TRUE;
	st->unq   = uid1;
	st->ident = FALSE;

	for (k = 0; k < u->npow; k++)
	{
		p = u->pw[k];
		r = D1UnqMag(u, k);
		if (p == D1IPL_INVCURS)
			st->curs = u->pa[k] + 12;	//param is a raw iCurs; D1ItmT frames
										//carry the CURSOR_FIRSTITEM 12 bias
		if (p == D1IPL_NOMINSTR)
			st->nominstr = TRUE;
		if (p == D1IPL_ONEHAND)
			st->onehand = TRUE;
		if (p == D1IPL_SPELL)
		{//param1 is the D1Spell id the generator remapped, param2 the charge
		 //count. Diablo 1.09b sets _iCharges from param1 where 1.04 used
		 //param2; the bug is kept, so a Gleamsong holds 10 of its 76.
			st->spl    = u->pa[k] + 1;
			st->chg    = u->pa[k];
			st->maxchg = u->pb[k];
		}
		if (p == D1IPL_CHARGES)
		{
			st->chg    *= u->pa[k];
			st->maxchg  = st->chg;
		}
		if (p == D1IPL_INDESTRUCT)
		{
			st->maxdur = D1_DURINF;
			st->dur    = D1_DURINF;
		}
		if (p == D1IPL_SETDUR)
		{
			st->maxdur = u->pa[k];
			st->dur    = u->pa[k];
		}
		if (p == D1IPL_DUR && st->maxdur != D1_DURINF)
		{
			d2 = (r * st->maxdur) / 100;
			st->maxdur += d2;
			st->dur    += d2;
		}
		if (p == D1IPL_DUR_CURSE && st->maxdur != D1_DURINF)
		{
			st->maxdur -= (r * st->maxdur) / 100;
			if (st->maxdur < 1)
				st->maxdur = 1;
			st->dur = st->maxdur;
		}
	}
}

U0 D1PowDropRoll(I64 gi, I64 itm, I64 lvl)
{//items.cpp SetupAllItems for a floor drop (uper 1): the flat 10% roll or
 //the level roll opens the magic window; an eligible unique takes it, else
 //affixes do. everything drops unidentified. town drops stay plain.
 //
 //SetupAllItems forces the window open for IMISC_STAFF, and GetItemBonus
 //sends staves to GetStaffSpell instead of GetItemPower: every dropped staff
 //carries a spell and its charges.
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 uid1;
	I64	 r1;
	I64	 r2;
	I64	 sp = -1;
	I64	 ch = 0;
	Bool staff;

	D1AffixInit;
	D1AffSetGround(gi, 0, 0);
	d1_st_ground[gi].ident = FALSE;
	if (gi < 0 || gi >= D1_MAXITEM || lvl < 1)
		return;
	staff = D1ItmIsStaff(itm);
	if (!staff)
	{
		r1 = D1Rnd(100);
		r2 = D1Rnd(100);
		if (r1 > 10 && r2 > lvl)
			return;
	}

	uid1 = D1UnqCheck(itm, lvl, 1);
	if (uid1)
	{
		D1UnqAssign(&d1_st_ground[gi], uid1);
		return;
	}
	if (staff)
	{
		if (d1_spl_staff)
			(*d1_spl_staff)(lvl, &sp, &ch);
		if (sp >= 0)
		{
			d1_st_ground[gi].spl    = sp + 1;
			d1_st_ground[gi].chg    = ch;
			d1_st_ground[gi].maxchg = ch;
		}
		D1AffSetGround(gi, D1AffixStaffPfx(lvl), 0);
		return;
	}
	D1AffixRoll(itm, lvl, &pfx, &sfx);
	D1AffSetGround(gi, pfx, sfx);
}

U0 D1PowTake(I64 gi, I64 e)
{//D1ItemPickup already copied the state record into entry e; release the
 //ground slot so a later drop starts clean
	if (e < 0)
		return;
	D1StClear(&d1_st_ground[gi]);
}

//--- value application -----------------------------------------------------

I64 D1AffixDmgPctOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_DAMP || a->power == D1IPL_TOHIT_DAMP)
		return r;
	if (a->power == D1IPL_DAMP_CURSE || a->power == D1IPL_TOHIT_DAMP_C)
		return -r;
	return 0;
}

I64 D1AffixDmgFlatOne(CD1Affix *a)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_DAMMOD)
		return D1AffixMag(a);
	return 0;
}


I64 D1AffixAcPctOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_ACP)
		return r;
	if (a->power == D1IPL_ACP_CURSE)
		return -r;
	return 0;
}


I64 D1AffixToHitOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_TOHIT || a->power == D1IPL_TOHIT_DAMP)
		return r;
	if (a->power == D1IPL_TOHIT_CURSE || a->power == D1IPL_TOHIT_DAMP_C)
		return -r;
	return 0;
}

I64 D1AffixApplyToHit(I64 tohit, I64 pfx, I64 sfx)
{
	return tohit + D1AffixToHitOne(D1AffixPfxPtr(pfx)) +
		   D1AffixToHitOne(D1AffixSfxPtr(sfx));
}

I64 D1AffixStatOne(CD1Affix *a, I64 attr)
{//attr is a D1AT_* code
	I64 r = D1AffixMag(a);
	I64 p;

	if (!a)
		return 0;
	p = a->power;
	if (p == D1IPL_ATTRIBS)
		return r;
	if (p == D1IPL_ATTRIBS_CURSE)
		return -r;
	if (attr == D1AT_STR)
	{
		if (p == D1IPL_STR)
			return r;
		if (p == D1IPL_STR_CURSE)
			return -r;
	}
	if (attr == D1AT_MAG)
	{
		if (p == D1IPL_MAG)
			return r;
		if (p == D1IPL_MAG_CURSE)
			return -r;
	}
	if (attr == D1AT_DEX)
	{
		if (p == D1IPL_DEX)
			return r;
		if (p == D1IPL_DEX_CURSE)
			return -r;
	}
	if (attr == D1AT_VIT)
	{
		if (p == D1IPL_VIT)
			return r;
		if (p == D1IPL_VIT_CURSE)
			return -r;
	}
	return 0;
}

I64 D1AffixApplyStat(I64 attr, I64 pfx, I64 sfx)
{//bonus only; the caller adds it to the base attribute
	return D1AffixStatOne(D1AffixPfxPtr(pfx), attr) +
		   D1AffixStatOne(D1AffixSfxPtr(sfx), attr);
}

//--- equipped totals, for the stat getters ---------------------------------
//
// affix ids read as 0 and unique powers as absent until the slot's state is
// marked identified, so an unidentified item contributes exactly its base
// row's numbers.

U0 D1PowEquipAff(I64 s, I64 *pfx, I64 *sfx)
{
	D1AffGetEquip(s, pfx, sfx);
	if (!d1_st_equip[s].ident)
	{
		*pfx = 0;
		*sfx = 0;
	}
}

I64 D1PowDmg(I64 dmg, CD1ItmSt *st, I64 pfx, I64 sfx)
{//percent scaling first, then the flat IPL_DAMMOD adds
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 pct;
	I64	 out;

	pct = D1AffixDmgPctOne(ap) + D1AffixDmgPctOne(as) +
		  D1UnqSum(st, D1IPL_DAMP) - D1UnqSum(st, D1IPL_DAMP_CURSE);
	out = (dmg * (100 + pct)) / 100;
	out += D1AffixDmgFlatOne(ap) + D1AffixDmgFlatOne(as) +
		   D1UnqSum(st, D1IPL_DAMMOD);
	if (out < 0)
		out = 0;
	return out;
}

I64 D1PowDmgMin()
{
	CD1ItmSt *st = &d1_st_equip[D1EQ_LEFT];
	I64	 pfx;
	I64	 sfx;
	I64	 base = D1InvDmgMinBase();

	D1PowEquipAff(D1EQ_LEFT, &pfx, &sfx);
	if (D1UnqHas(st, D1IPL_SETDAM))
		base = D1UnqP1(st, D1IPL_SETDAM);
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1PowDmgMax()
{
	CD1ItmSt *st = &d1_st_equip[D1EQ_LEFT];
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 pfx;
	I64	 sfx;
	I64	 base = D1InvDmgMaxBase();
	I64	 k;

	D1PowEquipAff(D1EQ_LEFT, &pfx, &sfx);
	if (u && D1UnqHas(st, D1IPL_SETDAM))
	{//SaveItemPower takes param2 as the maximum
		for (k = 0; k < u->npow; k++)
		{
			if (u->pw[k] == D1IPL_SETDAM)
				base = u->pb[k];
		}
	}
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1PowSlotAC(I64 s)
{//the slot's rolled AC, replaced by IPL_SETAC, then percent scaled
	CD1ItmSt *st = &d1_st_equip[s];
	I64	 pfx;
	I64	 sfx;
	I64	 ac;
	I64	 pct;

	D1PowEquipAff(s, &pfx, &sfx);
	ac = d1_equip_val[s];
	if (D1UnqHas(st, D1IPL_SETAC))
		ac = D1UnqP1(st, D1IPL_SETAC);
	ac -= D1UnqSum(st, D1IPL_AC_CURSE);
	pct = D1AffixAcPctOne(D1AffixPfxPtr(pfx)) +
		  D1AffixAcPctOne(D1AffixSfxPtr(sfx)) +
		  D1UnqSum(st, D1IPL_ACP) - D1UnqSum(st, D1IPL_ACP_CURSE);
	ac = (ac * (100 + pct)) / 100;
	if (ac < 0)
		ac = 0;
	return ac;
}

I64 D1PowAC()
{
	I64 s;
	I64 ac = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
			ac += D1PowSlotAC(s);
	}
	return ac;
}

I64 D1PowUnqStat(CD1ItmSt *st, I64 attr)
{
	I64 v = D1UnqSum(st, D1IPL_ATTRIBS) - D1UnqSum(st, D1IPL_ATTRIBS_CURSE);

	if (attr == D1AT_STR)
		v += D1UnqSum(st, D1IPL_STR) - D1UnqSum(st, D1IPL_STR_CURSE);
	if (attr == D1AT_MAG)
		v += D1UnqSum(st, D1IPL_MAG) - D1UnqSum(st, D1IPL_MAG_CURSE);
	if (attr == D1AT_DEX)
		v += D1UnqSum(st, D1IPL_DEX) - D1UnqSum(st, D1IPL_DEX_CURSE);
	if (attr == D1AT_VIT)
		v += D1UnqSum(st, D1IPL_VIT) - D1UnqSum(st, D1IPL_VIT_CURSE);
	return v;
}

I64 D1PowStat(I64 attr)
{//sum over every equipped slot
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
		{
			D1PowEquipAff(s, &pfx, &sfx);
			v += D1AffixApplyStat(attr, pfx, sfx) +
				 D1PowUnqStat(&d1_st_equip[s], attr);
		}
	}
	return v;
}

I64 D1PowStrBonus()
{
	return D1PowStat(D1AT_STR);
}

I64 D1PowToHit()
{//to-hit is a whole-character number; sum the weapon and the armour slots
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
		{
			D1PowEquipAff(s, &pfx, &sfx);
			v += D1AffixApplyToHit(0, pfx, sfx) +
				 D1UnqSum(&d1_st_equip[s], D1IPL_TOHIT) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_TOHIT_CURSE);
		}
	}
	return v;
}

I64 D1PowLife()
{//IPL_LIFE param is whole hit points
	I64 s;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
			v += D1UnqSum(&d1_st_equip[s], D1IPL_LIFE) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_LIFE_CURSE);
	}
	return v;
}

I64 D1PowMana()
{
	I64 s;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
			v += D1UnqSum(&d1_st_equip[s], D1IPL_MANA) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_MANA_CURSE);
	}
	return v;
}

U0 D1PowTick()
{//equipment IPL_LIFE/IPL_MANA over the D1CharRecalc derivation, mirroring
 //its formula. recomputed whole every tick, so a level-up recalc cannot
 //strand the bonus. deviation: D1CharRecalc's fill-ratio step runs against
 //the bonused maximum, so a level-up shifts current hp by the bonus ratio.
	I64 hp = D1CharBaseHP(d1_plr_class, d1_plr_vit) +
			 (d1_plr_lvl - 1) * (2 << 6);
	I64 mn = D1CharBaseMana(d1_plr_class, d1_plr_mag) +
			 (d1_plr_lvl - 1) * (1 << 6);

	hp += D1PowLife() << 6;
	mn += D1PowMana() << 6;
	if (hp < 1 << 6)
		hp = 1 << 6;
	if (mn < 0)
		mn = 0;
	d1_plr_maxhp   = hp;
	d1_plr_maxmana = mn;
	if (d1_plr_hp > hp)
		d1_plr_hp = hp;
	if (d1_plr_mana > mn)
		d1_plr_mana = mn;
}





//--- names -----------------------------------------------------------------

I64 D1AffixCat(U8 *dst, I64 at, U8 *s, I64 max)
{//append, bounded; returns the new length
	I64 i = 0;

	while (s[i] && at < max - 1)
	{
		dst[at] = s[i];
		at++;
		i++;
	}
	dst[at] = 0;
	return at;
}

U0 D1AffixNameSpl(U8 *dst, I64 itm_row, I64 pfx, I64 sfx, I64 spl1)
{//"Sharp Long Sword of the Bear"; dst holds D1_AFFNAME bytes.
 //spl1 is a spell id + 1: GetStaffSpell appends " of <sNameText>" to the base
 //name and GetStaffPower prepends the prefix around it.
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 at = 0;

	dst[0] = 0;
	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return;
	if (ap)
	{
		at = D1AffixCat(dst, at, ap->name, D1_AFFNAME);
		at = D1AffixCat(dst, at, " ", D1_AFFNAME);
	}
	at = D1AffixCat(dst, at, d1_itmdefs[itm_row].name, D1_AFFNAME);
	if (spl1 > 0 && d1_spl_name)
	{
		at = D1AffixCat(dst, at, " of ", D1_AFFNAME);
		at = D1AffixCat(dst, at, (*d1_spl_name)(spl1 - 1), D1_AFFNAME);
	}
	if (as)
	{
		at = D1AffixCat(dst, at, " of ", D1_AFFNAME);
		at = D1AffixCat(dst, at, as->name, D1_AFFNAME);
	}
}

U0 D1AffixName(U8 *dst, I64 itm_row, I64 pfx, I64 sfx)
{
	D1AffixNameSpl(dst, itm_row, pfx, sfx, 0);
}



//--- price -----------------------------------------------------------------

I64 D1AffixPLVal(I64 pv, I64 p1, I64 p2, I64 minv, I64 maxv)
{//items.cpp PLVal
	if (p1 == p2)
		return minv;
	if (minv == maxv)
		return minv;
	return minv + ((maxv - minv) * ((100 * (pv - p1)) / (p2 - p1))) / 100;
}

I64 D1AffixAddOne(CD1Affix *a)
{
	if (!a)
		return 0;
	return D1AffixPLVal(D1AffixMag(a), a->p1, a->p2, a->minval, a->maxval);
}

I64 D1AffixMultOne(CD1Affix *a)
{
	if (!a)
		return 0;
	return a->multval;
}

I64 D1AffixValue(I64 itm_row, I64 pfx, I64 sfx)
{//items.cpp CalcItemValue; a plain item keeps its base table value
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 base;
	I64	 v;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	base = d1_itmdefs[itm_row].value;
	if (!ap && !as)
		return base;

	v = D1AffixMultOne(ap) + D1AffixMultOne(as);
	if (v > 0)
		v *= base;
	else if (v < 0)
		v = base / v;
	v += D1AffixAddOne(ap) + D1AffixAddOne(as);
	if (v <= 0)
		v = 1;
	return v;
}

//--- identification --------------------------------------------------------
//
// items drop unidentified: the plain base name shows and no power applies.
// Cain identifies one item for D1_IDPRICE gold, the flat 100 stores.cpp
// AddStoreHoldId writes into _iIvalue and StoryIdItem then takes.

#define D1_IDPRICE		100

Bool D1PowIsMagic(CD1ItmSt *st, I64 pfx, I64 sfx)
{
	if (st->unq)
		return TRUE;
	return pfx != 0 || sfx != 0;
}

Bool D1PowNeedsId(CD1ItmSt *st, I64 pfx, I64 sfx)
{
	if (st->ident)
		return FALSE;
	return D1PowIsMagic(st, pfx, sfx);
}

Bool D1IdOkInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return FALSE;
	D1AffGetInv(e, &pfx, &sfx);
	return D1PowNeedsId(&d1_st_inv[e], pfx, sfx);
}

Bool D1IdOkEquip(I64 s)
{
	I64 pfx;
	I64 sfx;

	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return FALSE;
	D1AffGetEquip(s, &pfx, &sfx);
	return D1PowNeedsId(&d1_st_equip[s], pfx, sfx);
}

U0 D1IdInv(I64 e)
{
	if (e >= 0 && e < D1_MAXINV)
		d1_st_inv[e].ident = TRUE;
}

U0 D1IdEquip(I64 s)
{
	if (s >= 0 && s < D1EQ_N)
		d1_st_equip[s].ident = TRUE;
}

//--- naming and price with identification ----------------------------------

U0 D1PowName(U8 *dst, I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{//unidentified reads as the plain base row; a unique carries its own name.
 //GetStaffSpell writes the spell into _iName as well as _iIName, so a staff
 //names its spell before it is identified.
	CD1Unique *u;

	dst[0] = 0;
	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return;
	if (!st->ident)
	{//GetUniqueItem leaves _iName the plain base row, so a unique staff hides
	 //its spell until identified
		if (st->unq)
			D1AffixCat(dst, 0, d1_itmdefs[itm_row].name, D1_AFFNAME);
		else
			D1AffixNameSpl(dst, itm_row, 0, 0, st->spl);
		return;
	}
	u = D1UnqPtr(st->unq);
	if (u)
	{
		D1AffixCat(dst, 0, u->name, D1_AFFNAME);
		return;
	}
	D1AffixNameSpl(dst, itm_row, pfx, sfx, st->spl);
}

I64 D1PowStaffVal(CD1ItmSt *st)
{//GetStaffSpell bills the spell into both _ivalue and _iIvalue:
 //_iCharges * sStaffCost / 5, taken at the roll, where charges are still full.
 //GetUniqueItem never runs GetStaffSpell, so a unique staff is priced by
 //UIValue alone.
	if (st->spl <= 0 || st->unq || !d1_spl_cost)
		return 0;
	return (st->maxchg * (*d1_spl_cost)(st->spl - 1)) / 5;
}

I64 D1PowValue(I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{//GetUniqueItem writes UIValue over the rolled value; unidentified gear
 //trades at its base row value
	CD1Unique *u;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	if (!st->ident)
		return d1_itmdefs[itm_row].value + D1PowStaffVal(st);
	u = D1UnqPtr(st->unq);
	if (u)
		return u->value;
	return D1AffixValue(itm_row, pfx, sfx) + D1PowStaffVal(st);
}

U0 D1PowNameInv(U8 *dst, I64 e)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return;
	D1AffGetInv(e, &pfx, &sfx);
	D1PowName(dst, d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}

U0 D1PowNameEquip(U8 *dst, I64 s)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return;
	D1AffGetEquip(s, &pfx, &sfx);
	D1PowName(dst, d1_equip_itm[s], &d1_st_equip[s], pfx, sfx);
}

U0 D1PowNameGround(U8 *dst, I64 gi)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (gi < 0 || gi >= D1_MAXITEM || !d1_items[gi].active)
		return;
	D1AffGetGround(gi, &pfx, &sfx);
	D1PowName(dst, d1_items[gi].itm, &d1_st_ground[gi], pfx, sfx);
}

I64 D1PowValueInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return 0;
	D1AffGetInv(e, &pfx, &sfx);
	return D1PowValue(d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}

//--- durability ------------------------------------------------------------
//
// player.cpp WeaponDur runs on a landed melee swing and ArmorDur on taking a
// hit; both decrement one point and destroy the item at zero. neither has a
// call site in this port's shell yet - see INTEGRATION-ITEMS2.md.

Bool D1DurWear(I64 slot)
{//TRUE when the item broke
	CD1ItmSt *st = &d1_st_equip[slot];

	if (d1_equip_itm[slot] < 0)
		return FALSE;
	if (st->dur == D1_DURINF || st->maxdur == D1_DURINF || st->maxdur == 0)
		return FALSE;
	st->dur--;
	if (st->dur > 0)
		return FALSE;
	D1InvBreak(slot);
	return TRUE;
}

Bool D1DurWeaponHit()
{//WeaponDur: the weapon hand, else the shield standing in for it
	if (d1_equip_itm[D1EQ_LEFT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].cls == D1IC_WEAPON)
		return D1DurWear(D1EQ_LEFT);
	if (d1_equip_itm[D1EQ_RIGHT] >= 0)
		return D1DurWear(D1EQ_RIGHT);
	return FALSE;
}

Bool D1DurArmorHit()
{//ArmorDur: body armour when worn, else the helm
	if (d1_equip_itm[D1EQ_BODY] >= 0)
		return D1DurWear(D1EQ_BODY);
	if (d1_equip_itm[D1EQ_HEAD] >= 0)
		return D1DurWear(D1EQ_HEAD);
	return FALSE;
}

I64 D1DurPrice(I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{//stores.cpp AddStoreHoldRepair. identified magic gear repairs against 30%
 //of its value; 0 means nothing to repair (or a magic item too cheap to).
	I64	 iv;
	I64	 v;
	Bool magic = st->ident && D1PowIsMagic(st, pfx, sfx);

	if (itm_row < 0 || st->maxdur <= 0 || st->maxdur == D1_DURINF)
		return 0;
	if (st->dur >= st->maxdur)
		return 0;

	iv = D1PowValue(itm_row, st, pfx, sfx);
	if (magic)
		iv = (30 * iv) / 100;
	v = (iv * ((100 * (st->maxdur - st->dur)) / st->maxdur)) / 100;
	if (v == 0)
	{
		if (magic)
			return 0;
		v = 1;
	}
	if (v > 1)
		v >>= 1;
	return v;
}

I64 D1DurPriceInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return 0;
	D1AffGetInv(e, &pfx, &sfx);
	return D1DurPrice(d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}

I64 D1DurPriceEquip(I64 s)
{
	I64 pfx;
	I64 sfx;

	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return 0;
	D1AffGetEquip(s, &pfx, &sfx);
	return D1DurPrice(d1_equip_itm[s], &d1_st_equip[s], pfx, sfx);
}

U0 D1DurRepairInv(I64 e)
{
	if (e >= 0 && e < D1_MAXINV)
		d1_st_inv[e].dur = d1_st_inv[e].maxdur;
}

U0 D1DurRepairEquip(I64 s)
{
	if (s >= 0 && s < D1EQ_N)
		d1_st_equip[s].dur = d1_st_equip[s].maxdur;
}

//--- panel info box --------------------------------------------------------
//
// control.cpp CheckInvHLight fills infostr/infoclr/panelstr for the hovered
// inventory, equipment or belt item; DrawInfoBox prints them in the panel.
// this port fills d1_info_txt/d1_info_clr; D1Panel draws them. reductions:
// no PrintItemPower affix lines, and an unidentified item shows its base
// numbers (this port applies powers only once identified).
// deviation: the Required line goes red when the requirement is unmet;
// retail paints the whole box in one infoclr.

//control.cpp text_color values, mapped to palette ramps by D1Panel
#define D1COL_WHITE		0
#define D1COL_BLUE		1
#define D1COL_RED		2
#define D1COL_GOLD		3

#define D1_INFOLINES	5

U8	 d1_info_txt[D1_INFOLINES][D1_AFFNAME];
I64	 d1_info_clr[D1_INFOLINES];
I64	 d1_info_n = 0;

U0 D1InfoAdd(U8 *s, I64 col)
{//AddPanelString, with a per-line color
	if (d1_info_n >= D1_INFOLINES)
		return;
	D1AffixCat(d1_info_txt[d1_info_n], 0, s, D1_AFFNAME);
	d1_info_clr[d1_info_n] = col;
	d1_info_n++;
}

I64 D1InfoDmgMax(I64 itm, CD1ItmSt *st, I64 pfx, I64 sfx)
{//SaveItemPower takes SETDAM's param2 as the maximum (D1PowDmgMax)
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 base = d1_itmdefs[itm].dmax;
	I64	 k;

	if (u && D1UnqHas(st, D1IPL_SETDAM))
	{
		for (k = 0; k < u->npow; k++)
		{
			if (u->pw[k] == D1IPL_SETDAM)
				base = u->pb[k];
		}
	}
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1InfoAC(I64 val, CD1ItmSt *st, I64 pfx, I64 sfx)
{//D1PowSlotAC over an explicit rolled-AC value
	I64 ac = val;
	I64 pct;

	if (D1UnqHas(st, D1IPL_SETAC))
		ac = D1UnqP1(st, D1IPL_SETAC);
	ac -= D1UnqSum(st, D1IPL_AC_CURSE);
	pct = D1AffixAcPctOne(D1AffixPfxPtr(pfx)) +
		  D1AffixAcPctOne(D1AffixSfxPtr(sfx)) +
		  D1UnqSum(st, D1IPL_ACP) - D1UnqSum(st, D1IPL_ACP_CURSE);
	ac = (ac * (100 + pct)) / 100;
	if (ac < 0)
		ac = 0;
	return ac;
}

U0 D1InfoItem(I64 itm, CD1ItmSt *st, I64 val)
{//name + detail lines. identified: PrintItemDetails (items.cpp:4460);
 //unidentified: PrintItemDur (items.cpp:4529). val is the rolled AC.
	U8	 buf[D1_AFFNAME];
	CD1ItmDef *d = &d1_itmdefs[itm];
	I64	 col = D1COL_WHITE;
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 dmin;
	I64	 dmax;
	Bool magic;

	d1_info_n = 0;
	magic = D1PowIsMagic(st, st->pfx, st->sfx);
	if (st->unq)
		col = D1COL_GOLD;
	else if (magic)
		col = D1COL_BLUE;

	D1PowName(buf, itm, st, st->pfx, st->sfx);
	D1InfoAdd(buf, col);

	if (st->ident)
	{
		pfx = st->pfx;
		sfx = st->sfx;
	}
	if (d->cls == D1IC_WEAPON)
	{
		dmin = d1_itmdefs[itm].dmin;
		if (D1UnqHas(st, D1IPL_SETDAM))
			dmin = D1UnqP1(st, D1IPL_SETDAM);
		dmin = D1PowDmg(dmin, st, pfx, sfx);
		dmax = D1InfoDmgMax(itm, st, pfx, sfx);
		if (st->maxdur == D1_DURINF)
			StrPrint(buf, "damage: %d-%d  Indestructible", dmin, dmax);
		else
			StrPrint(buf, "damage: %d-%d  Dur: %d/%d", dmin, dmax,
				st->dur, st->maxdur);
		D1InfoAdd(buf, col);
	}
	if (d->cls == D1IC_ARMOR)
	{
		if (st->maxdur == D1_DURINF)
			StrPrint(buf, "armor: %d  Indestructible",
				D1InfoAC(val, st, pfx, sfx));
		else
			StrPrint(buf, "armor: %d  Dur: %d/%d",
				D1InfoAC(val, st, pfx, sfx), st->dur, st->maxdur);
		D1InfoAdd(buf, col);
	}
	if (d->stf && st->maxchg)
	{
		StrPrint(buf, "Charges: %d/%d", st->chg, st->maxchg);
		D1InfoAdd(buf, col);
	}
	if (st->ident)
	{
		if (st->unq)
			D1InfoAdd("unique item", col);
	}
	else if (magic)
		D1InfoAdd("Not Identified", col);
	if (d->minstr && !(st->ident && st->nominstr))
	{
		StrPrint(buf, "Required: %d Str", d->minstr);
		if (D1InvStr() < d->minstr)
			D1InfoAdd(buf, D1COL_RED);
		else
			D1InfoAdd(buf, col);
	}
}

Bool D1InvInfoFill(I64 cx, I64 cy)
{//CheckInvHLight over the port's slots: equipment, grid, belt.
 //TRUE = an item is hovered and the lines are filled.
	I64 s;
	I64 e;
	I64 bx;
	I64 by;

	d1_info_n = 0;

	s = D1InvHitSlot(cx, cy);
	if (s >= 0)
	{
		if (d1_equip_itm[s] < 0)
			return FALSE;
		D1InfoItem(d1_equip_itm[s], &d1_st_equip[s], d1_equip_val[s]);
		return TRUE;
	}
	e = D1InvHitEntry(cx, cy);
	if (e >= 0)
	{
		D1InfoItem(d1_inv_itm[e], &d1_st_inv[e], d1_inv_val[e]);
		return TRUE;
	}

	//belt chips, panel-local (D1PanelClick rows); plain potions, name only
	bx = cx - D1UiOrgX();
	by = cy - D1PanelTop();
	if (by >= 5 && by < 36)
	{
		for (s = 0; s < 8; s++)
		{
			if (bx >= 205 + s * 29 && bx < 233 + s * 29 && d1_belt[s])
			{
				D1InfoAdd(d1_itmdefs[d1_belt[s]].name, D1COL_WHITE);
				return TRUE;
			}
		}
	}
	return FALSE;
}

//--- hook installation -----------------------------------------------------

U0 D1PowInstall()
{//D1Item and D1Inv are compiled before this file, so they reach the power
 //layer through these pointers instead of by name
	D1AffixInit;
	d1_pow_drop   = &D1PowDropRoll;
	d1_pow_take   = &D1PowTake;
	d1_pow_tick   = &D1PowTick;
	d1_pow_dmgmin = &D1PowDmgMin;
	d1_pow_dmgmax = &D1PowDmgMax;
	d1_pow_ac     = &D1PowAC;
	d1_pow_str    = &D1PowStrBonus;
}

D1PowInstall;
