// D1Affix.ZC - magic item prefixes and suffixes
//
// table rows come from D1AffT (itemdat.cpp PL_Prefix / PL_Suffix, generated).
// an affix reference is 1-based: 0 means "none", so an all-zero side table
// reads as a plain non-magic item and the hooks below are optional.
//
// affix ids are held outside CD1Item / the inventory arrays, in the side
// tables d1_aff_ground / d1_aff_inv / d1_aff_equip, two I64 per slot
// (prefix id, suffix id) at index*2 and index*2+1.
//
// deviation from items.cpp SaveItemPower: the per-instance roll r is not
// stored, so every magnitude is the midpoint of param1..param2. rolls stay
// inside the table's own min/max, and item value is CalcItemValue driven by
// that same midpoint through PLVal.

#define D1_MAXAFF		112
#define D1_AFFNAME		80		//prefix 13 + base 31 + " of " + suffix 13

//affix_item_type
#define D1PLT_MISC		0x1
#define D1PLT_BOW		0x10
#define D1PLT_STAFF		0x100
#define D1PLT_WEAP		0x1000
#define D1PLT_SHLD		0x10000
#define D1PLT_ARMO		0x100000

//good/evil tag; a good prefix and an evil suffix never share an item
#define D1GOE_ANY		0x00
#define D1GOE_EVIL		0x01
#define D1GOE_GOOD		0x10

//item_effect_type values this port applies
#define D1IPL_TOHIT			0x00
#define D1IPL_TOHIT_CURSE	0x01
#define D1IPL_DAMP			0x02
#define D1IPL_DAMP_CURSE	0x03
#define D1IPL_TOHIT_DAMP	0x04
#define D1IPL_TOHIT_DAMP_C	0x05
#define D1IPL_ACP			0x06
#define D1IPL_ACP_CURSE		0x07
#define D1IPL_STR			0x13
#define D1IPL_STR_CURSE		0x14
#define D1IPL_MAG			0x15
#define D1IPL_MAG_CURSE		0x16
#define D1IPL_DEX			0x17
#define D1IPL_DEX_CURSE		0x18
#define D1IPL_VIT			0x19
#define D1IPL_VIT_CURSE		0x1A
#define D1IPL_ATTRIBS		0x1B
#define D1IPL_ATTRIBS_CURSE	0x1C
#define D1IPL_DAMMOD		0x3D

class CD1Affix
{
	U8	 name[16];
	I64	 power;
	I64	 p1;
	I64	 p2;
	I64	 minlvl;
	I64	 itype;			//D1PLT_* mask
	I64	 goe;
	I64	 dbl;			//counted twice in the prefix pool
	I64	 ok;			//eligible when the roll is onlygood
	I64	 minval;
	I64	 maxval;
	I64	 multval;
};

CD1Affix d1_pfx[D1_MAXAFF];
CD1Affix d1_sfx[D1_MAXAFF];
I64	 d1_n_pfx = 0;
I64	 d1_n_sfx = 0;
Bool d1_aff_init = FALSE;

//side tables, index*2 = prefix id, index*2+1 = suffix id, 0 = none
I64	 d1_aff_ground[D1_MAXITEM * 2];
I64	 d1_aff_inv[D1_MAXINV * 2];
I64	 d1_aff_equip[D1EQ_N * 2];

U0 D1PfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_pfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_pfx)
		d1_n_pfx = i + 1;
}

U0 D1SfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_sfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_sfx)
		d1_n_sfx = i + 1;
}

#include "D1AffT"

//--- side table access -----------------------------------------------------

U0 D1AffixInit()
{
	I64 i;

	if (d1_aff_init)
		return;
	d1_n_pfx = 0;
	d1_n_sfx = 0;
	D1AffTFill;
	for (i = 0; i < D1_MAXITEM * 2; i++)
		d1_aff_ground[i] = 0;
	for (i = 0; i < D1_MAXINV * 2; i++)
		d1_aff_inv[i] = 0;
	for (i = 0; i < D1EQ_N * 2; i++)
		d1_aff_equip[i] = 0;
	d1_aff_init = TRUE;
}

U0 D1AffSetGround(I64 i, I64 pfx, I64 sfx)
{
	if (i < 0 || i >= D1_MAXITEM)
		return;
	d1_aff_ground[i * 2]     = pfx;
	d1_aff_ground[i * 2 + 1] = sfx;
}

U0 D1AffGetGround(I64 i, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (i < 0 || i >= D1_MAXITEM)
		return;
	*pfx = d1_aff_ground[i * 2];
	*sfx = d1_aff_ground[i * 2 + 1];
}

U0 D1AffSetInv(I64 e, I64 pfx, I64 sfx)
{
	if (e < 0 || e >= D1_MAXINV)
		return;
	d1_aff_inv[e * 2]     = pfx;
	d1_aff_inv[e * 2 + 1] = sfx;
}

U0 D1AffGetInv(I64 e, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (e < 0 || e >= D1_MAXINV)
		return;
	*pfx = d1_aff_inv[e * 2];
	*sfx = d1_aff_inv[e * 2 + 1];
}

U0 D1AffSetEquip(I64 s, I64 pfx, I64 sfx)
{
	if (s < 0 || s >= D1EQ_N)
		return;
	d1_aff_equip[s * 2]     = pfx;
	d1_aff_equip[s * 2 + 1] = sfx;
}

U0 D1AffGetEquip(I64 s, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (s < 0 || s >= D1EQ_N)
		return;
	*pfx = d1_aff_equip[s * 2];
	*sfx = d1_aff_equip[s * 2 + 1];
}

I64 D1AffFreeInvEntry()
{//the entry D1InvPut will claim next; same first-free rule
	I64 i;
	I64 e = -1;

	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	return e;
}

Bool D1AffInvPut(I64 itm, I64 val, I64 pfx, I64 sfx)
{//D1InvPut plus the matching side entry
	I64	 e = D1AffFreeInvEntry();
	Bool ok;

	ok = D1InvPut(itm, val);
	if (ok && e >= 0)
		D1AffSetInv(e, pfx, sfx);
	return ok;
}

//--- table lookup ----------------------------------------------------------

I64 D1AffixStrLen(U8 *s)
{
	I64 i = 0;

	while (s[i])
		i++;
	return i;
}

Bool D1AffixIsBow(I64 itm_row)
{//bows take the PLT_BOW pool; the base table has no weapon subtype field
	U8	*n;
	I64	 l;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return FALSE;
	n = d1_itmdefs[itm_row].name;
	l = D1AffixStrLen(n);
	if (l < 3)
		return FALSE;
	return n[l - 3] == 'B' && n[l - 2] == 'o' && n[l - 1] == 'w';
}

I64 D1AffixFlags(I64 itm_row)
{//GetItemBonus dispatch, reduced to the four base classes this port carries.
 //0 = the item takes no affixes (gold, potions).
	CD1ItmDef *d;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	d = &d1_itmdefs[itm_row];
	if (d->misc)
		return 0;
	if (d->cls == D1IC_WEAPON)
	{
		if (D1AffixIsBow(itm_row))
			return D1PLT_BOW;
		return D1PLT_WEAP;
	}
	if (d->cls == D1IC_ARMOR)
	{
		if (d->loc == D1IL_ONEHAND)
			return D1PLT_SHLD;
		return D1PLT_ARMO;
	}
	return 0;
}

CD1Affix *D1AffixPfxPtr(I64 id)
{//id is 1-based; 0 = none
	if (id <= 0 || id > d1_n_pfx)
		return NULL;
	return &d1_pfx[id - 1];
}

CD1Affix *D1AffixSfxPtr(I64 id)
{
	if (id <= 0 || id > d1_n_sfx)
		return NULL;
	return &d1_sfx[id - 1];
}

I64 D1AffixMag(CD1Affix *a)
{//midpoint of param1..param2 stands in for the unstored roll
	if (!a)
		return 0;
	return (a->p1 + a->p2) / 2;
}

//--- rolling ---------------------------------------------------------------

I64 D1AffixRoll(I64 itm_row, I64 ilvl, I64 *pfx_out, I64 *sfx_out)
{//items.cpp GetItemPower over GetItemBonus's minlvl = ilvl >> 1 window.
 //returns 1 when at least one affix landed. ids are 1-based, 0 = none.
	I64	 pool[2 * D1_MAXAFF];
	I64	 flgs;
	I64	 minlvl;
	I64	 maxlvl;
	I64	 pre;
	I64	 post;
	I64	 n;
	I64	 j;
	I64	 goe;
	I64	 pick;
	CD1Affix *a;
	Bool onlygood;

	*pfx_out = 0;
	*sfx_out = 0;
	D1AffixInit;

	flgs = D1AffixFlags(itm_row);
	if (!flgs)
		return 0;

	minlvl = ilvl >> 1;
	maxlvl = ilvl;
	if (minlvl > 25)
		minlvl = 25;

	pre  = D1Rnd(4);
	post = D1Rnd(3);
	if (pre != 0 && post == 0)
	{
		if (D1Rnd(2) != 0)
			post = 1;
		else
			pre = 0;
	}

	onlygood = FALSE;
	if (D1Rnd(3) != 0)
		onlygood = TRUE;
	goe = D1GOE_ANY;

	if (pre == 0)
	{
		n = 0;
		for (j = 0; j < d1_n_pfx; j++)
		{
			a = &d1_pfx[j];
			if ((flgs & a->itype) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl && (!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
				if (a->dbl)
				{
					pool[n] = j;
					n++;
				}
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*pfx_out = pick + 1;
			goe      = d1_pfx[pick].goe;
		}
	}

	if (post != 0)
	{
		n = 0;
		for (j = 0; j < d1_n_sfx; j++)
		{
			a = &d1_sfx[j];
			if ((a->itype & flgs) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl &&
				(goe | a->goe) != (D1GOE_GOOD | D1GOE_EVIL) &&
				(!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*sfx_out = pick + 1;
		}
	}

	if (*pfx_out || *sfx_out)
		return 1;
	return 0;
}

U0 D1AffixDropRoll(I64 gi, I64 itm, I64 lvl)
{//ground item gi takes level-fit affixes. SetupAllItems' magic gate: the
 //flat 10% roll or the level roll. town drops stay plain.
	I64 pfx = 0;
	I64 sfx = 0;
	I64 r1;
	I64 r2;

	D1AffixInit;
	D1AffSetGround(gi, 0, 0);
	if (lvl < 1)
		return;
	r1 = D1Rnd(100);
	r2 = D1Rnd(100);
	if (r1 <= 10 || r2 <= lvl)
		D1AffixRoll(itm, lvl, &pfx, &sfx);
	D1AffSetGround(gi, pfx, sfx);
}

//--- value application -----------------------------------------------------

I64 D1AffixDmgPctOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_DAMP || a->power == D1IPL_TOHIT_DAMP)
		return r;
	if (a->power == D1IPL_DAMP_CURSE || a->power == D1IPL_TOHIT_DAMP_C)
		return -r;
	return 0;
}

I64 D1AffixDmgFlatOne(CD1Affix *a)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_DAMMOD)
		return D1AffixMag(a);
	return 0;
}

I64 D1AffixApplyDmg(I64 dmg, I64 pfx, I64 sfx)
{//percent scaling first, then the flat IPL_DAMMOD add
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 pct = D1AffixDmgPctOne(ap) + D1AffixDmgPctOne(as);
	I64	 out;

	out = (dmg * (100 + pct)) / 100;
	out += D1AffixDmgFlatOne(ap) + D1AffixDmgFlatOne(as);
	if (out < 0)
		out = 0;
	return out;
}

I64 D1AffixAcPctOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_ACP)
		return r;
	if (a->power == D1IPL_ACP_CURSE)
		return -r;
	return 0;
}

I64 D1AffixApplyAC(I64 ac, I64 pfx, I64 sfx)
{
	I64 pct = D1AffixAcPctOne(D1AffixPfxPtr(pfx)) +
			  D1AffixAcPctOne(D1AffixSfxPtr(sfx));
	I64 out = (ac * (100 + pct)) / 100;

	if (out < 0)
		out = 0;
	return out;
}

I64 D1AffixToHitOne(CD1Affix *a)
{
	I64 r = D1AffixMag(a);

	if (!a)
		return 0;
	if (a->power == D1IPL_TOHIT || a->power == D1IPL_TOHIT_DAMP)
		return r;
	if (a->power == D1IPL_TOHIT_CURSE || a->power == D1IPL_TOHIT_DAMP_C)
		return -r;
	return 0;
}

I64 D1AffixApplyToHit(I64 tohit, I64 pfx, I64 sfx)
{
	return tohit + D1AffixToHitOne(D1AffixPfxPtr(pfx)) +
		   D1AffixToHitOne(D1AffixSfxPtr(sfx));
}

I64 D1AffixStatOne(CD1Affix *a, I64 attr)
{//attr is a D1AT_* code
	I64 r = D1AffixMag(a);
	I64 p;

	if (!a)
		return 0;
	p = a->power;
	if (p == D1IPL_ATTRIBS)
		return r;
	if (p == D1IPL_ATTRIBS_CURSE)
		return -r;
	if (attr == D1AT_STR)
	{
		if (p == D1IPL_STR)
			return r;
		if (p == D1IPL_STR_CURSE)
			return -r;
	}
	if (attr == D1AT_MAG)
	{
		if (p == D1IPL_MAG)
			return r;
		if (p == D1IPL_MAG_CURSE)
			return -r;
	}
	if (attr == D1AT_DEX)
	{
		if (p == D1IPL_DEX)
			return r;
		if (p == D1IPL_DEX_CURSE)
			return -r;
	}
	if (attr == D1AT_VIT)
	{
		if (p == D1IPL_VIT)
			return r;
		if (p == D1IPL_VIT_CURSE)
			return -r;
	}
	return 0;
}

I64 D1AffixApplyStat(I64 attr, I64 pfx, I64 sfx)
{//bonus only; the caller adds it to the base attribute
	return D1AffixStatOne(D1AffixPfxPtr(pfx), attr) +
		   D1AffixStatOne(D1AffixSfxPtr(sfx), attr);
}

//--- equipped totals, for the stat getters ---------------------------------

I64 D1AffixDmgMin()
{
	I64 pfx;
	I64 sfx;

	D1AffGetEquip(D1EQ_LEFT, &pfx, &sfx);
	return D1AffixApplyDmg(D1InvDmgMin(), pfx, sfx);
}

I64 D1AffixDmgMax()
{
	I64 pfx;
	I64 sfx;

	D1AffGetEquip(D1EQ_LEFT, &pfx, &sfx);
	return D1AffixApplyDmg(D1InvDmgMax(), pfx, sfx);
}

I64 D1AffixAC()
{//per-slot AC roll scaled by that slot's own affixes
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 ac = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
		{
			D1AffGetEquip(s, &pfx, &sfx);
			ac += D1AffixApplyAC(d1_equip_val[s], pfx, sfx);
		}
	}
	return ac;
}

I64 D1AffixStatBonus(I64 attr)
{//sum over every equipped slot
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (d1_equip_itm[s] >= 0)
		{
			D1AffGetEquip(s, &pfx, &sfx);
			v += D1AffixApplyStat(attr, pfx, sfx);
		}
	}
	return v;
}

//--- names -----------------------------------------------------------------

I64 D1AffixCat(U8 *dst, I64 at, U8 *s, I64 max)
{//append, bounded; returns the new length
	I64 i = 0;

	while (s[i] && at < max - 1)
	{
		dst[at] = s[i];
		at++;
		i++;
	}
	dst[at] = 0;
	return at;
}

U0 D1AffixName(U8 *dst, I64 itm_row, I64 pfx, I64 sfx)
{//"Sharp Long Sword of the Bear"; dst holds D1_AFFNAME bytes
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 at = 0;

	dst[0] = 0;
	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return;
	if (ap)
	{
		at = D1AffixCat(dst, at, ap->name, D1_AFFNAME);
		at = D1AffixCat(dst, at, " ", D1_AFFNAME);
	}
	at = D1AffixCat(dst, at, d1_itmdefs[itm_row].name, D1_AFFNAME);
	if (as)
	{
		at = D1AffixCat(dst, at, " of ", D1_AFFNAME);
		at = D1AffixCat(dst, at, as->name, D1_AFFNAME);
	}
}

U0 D1AffixNameGround(U8 *dst, I64 gi)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (gi < 0 || gi >= D1_MAXITEM)
		return;
	D1AffGetGround(gi, &pfx, &sfx);
	D1AffixName(dst, d1_items[gi].itm, pfx, sfx);
}

U0 D1AffixNameInv(U8 *dst, I64 e)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return;
	D1AffGetInv(e, &pfx, &sfx);
	D1AffixName(dst, d1_inv_itm[e], pfx, sfx);
}

//--- price -----------------------------------------------------------------

I64 D1AffixPLVal(I64 pv, I64 p1, I64 p2, I64 minv, I64 maxv)
{//items.cpp PLVal
	if (p1 == p2)
		return minv;
	if (minv == maxv)
		return minv;
	return minv + ((maxv - minv) * ((100 * (pv - p1)) / (p2 - p1))) / 100;
}

I64 D1AffixAddOne(CD1Affix *a)
{
	if (!a)
		return 0;
	return D1AffixPLVal(D1AffixMag(a), a->p1, a->p2, a->minval, a->maxval);
}

I64 D1AffixMultOne(CD1Affix *a)
{
	if (!a)
		return 0;
	return a->multval;
}

I64 D1AffixValue(I64 itm_row, I64 pfx, I64 sfx)
{//items.cpp CalcItemValue; a plain item keeps its base table value
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 base;
	I64	 v;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	base = d1_itmdefs[itm_row].value;
	if (!ap && !as)
		return base;

	v = D1AffixMultOne(ap) + D1AffixMultOne(as);
	if (v > 0)
		v *= base;
	else if (v < 0)
		v = base / v;
	v += D1AffixAddOne(ap) + D1AffixAddOne(as);
	if (v <= 0)
		v = 1;
	return v;
}
