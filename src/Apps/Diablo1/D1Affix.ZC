// magic item prefixes and suffixes
//
// rows from D1AffT (itemdat.cpp PL_Prefix / PL_Suffix). affix ids are 1-based,
// 0 = none, and live in the D1Item side tables (CD1ItmSt), not CD1Item.
// magnitudes: items.cpp SaveItemPower, r = RndPL(param1, param2) rolled once at
// creation into pfxval/sfxval; pfxval2/sfxval2 hold the IPL_TOHIT_DAMP band.

#define D1_MAXAFF		112
//prefix 13 + base 31 + " of " + spell 15 + " of " + suffix 13
#define D1_AFFNAME		96

#define D1PLT_MISC		0x1
#define D1PLT_BOW		0x10
#define D1PLT_STAFF		0x100
#define D1PLT_WEAP		0x1000
#define D1PLT_SHLD		0x10000
#define D1PLT_ARMO		0x100000

#define D1GOE_ANY		0x00
#define D1GOE_EVIL		0x01
#define D1GOE_GOOD		0x10

#define D1IPL_TOHIT			0x00
#define D1IPL_TOHIT_CURSE	0x01
#define D1IPL_DAMP			0x02
#define D1IPL_DAMP_CURSE	0x03
#define D1IPL_TOHIT_DAMP	0x04
#define D1IPL_TOHIT_DAMP_C	0x05
#define D1IPL_ACP			0x06
#define D1IPL_ACP_CURSE		0x07
#define D1IPL_FIRERES		0x08
#define D1IPL_LIGHTRES		0x09
#define D1IPL_MAGICRES		0x0A
#define D1IPL_ALLRES		0x0B
#define D1IPL_SPLLVLADD		0x0E
#define D1IPL_FIREDAM		0x10
#define D1IPL_LIGHTDAM		0x11
#define D1IPL_STR			0x13
#define D1IPL_STR_CURSE		0x14
#define D1IPL_MAG			0x15
#define D1IPL_MAG_CURSE		0x16
#define D1IPL_DEX			0x17
#define D1IPL_DEX_CURSE		0x18
#define D1IPL_VIT			0x19
#define D1IPL_VIT_CURSE		0x1A
#define D1IPL_ATTRIBS		0x1B
#define D1IPL_ATTRIBS_CURSE	0x1C
#define D1IPL_GETHIT_CURSE	0x1D
#define D1IPL_GETHIT		0x1E
#define D1IPL_LIFE			0x1F
#define D1IPL_LIFE_CURSE	0x20
#define D1IPL_MANA			0x21
#define D1IPL_MANA_CURSE	0x22
#define D1IPL_DUR			0x23
#define D1IPL_DUR_CURSE		0x24
#define D1IPL_INDESTRUCT	0x25
#define D1IPL_LIGHT			0x26
#define D1IPL_LIGHT_CURSE	0x27
#define D1IPL_FIRE_ARROWS	0x2A
#define D1IPL_LIGHT_ARROWS	0x2B
#define D1IPL_INVCURS		0x2C
#define D1IPL_THORNS		0x2D
#define D1IPL_NOMANA		0x2E
#define D1IPL_ABSHALFTRAP	0x34
#define D1IPL_KNOCKBACK		0x35
#define D1IPL_STEALMANA		0x37
#define D1IPL_STEALLIFE		0x38
#define D1IPL_TARGAC		0x39
#define D1IPL_FASTATTACK	0x3A
#define D1IPL_FASTRECOVER	0x3B
#define D1IPL_FASTBLOCK		0x3C
#define D1IPL_CHARGES		0x0F
#define D1IPL_DAMMOD		0x3D
#define D1IPL_SETDAM		0x3F
#define D1IPL_SETDUR		0x40
#define D1IPL_NOMINSTR		0x41
#define D1IPL_SPELL			0x42
#define D1IPL_ONEHAND		0x44
#define D1IPL_SETAC			0x4B
#define D1IPL_AC_CURSE		0x4F

class CD1Affix
{
	U8	 name[16];
	I64	 power;
	I64	 p1;
	I64	 p2;
	I64	 minlvl;
	I64	 itype;
	I64	 goe;
	I64	 dbl;
	I64	 ok;
	I64	 minval;
	I64	 maxval;
	I64	 multval;
};

CD1Affix d1_pfx[D1_MAXAFF];
CD1Affix d1_sfx[D1_MAXAFF];
I64	 d1_n_pfx = 0;
I64	 d1_n_sfx = 0;
Bool d1_aff_init = FALSE;

U0 D1PfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_pfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_pfx)
		d1_n_pfx = i + 1;
}

U0 D1SfxSet(I64 i, U8 *name, I64 power, I64 p1, I64 p2, I64 minlvl,
	I64 itype, I64 goe, I64 dbl, I64 ok, I64 minval, I64 maxval, I64 multval)
{
	CD1Affix *a = &d1_sfx[i];

	D1StrCopy(a->name, name, 16);
	a->power   = power;
	a->p1      = p1;
	a->p2      = p2;
	a->minlvl  = minlvl;
	a->itype   = itype;
	a->goe     = goe;
	a->dbl     = dbl;
	a->ok      = ok;
	a->minval  = minval;
	a->maxval  = maxval;
	a->multval = multval;
	if (i + 1 > d1_n_sfx)
		d1_n_sfx = i + 1;
}

#include "D1AffT"


#define D1_MAXUNQ	32
#define D1_UPOW		6
#define D1_UNAME	24
#define D1UQ_GRISWOLD	17		//1-based: Griswold's Edge (Anvil reward)

class CD1Unique
{
	U8	 name[D1_UNAME];
	I64	 row;
	I64	 minlvl;
	I64	 value;
	I64	 npow;
	I64	 pw[D1_UPOW];
	I64	 pa[D1_UPOW];
	I64	 pb[D1_UPOW];
};

CD1Unique d1_unq[D1_MAXUNQ];
I64	 d1_n_unq = 0;
Bool d1_unq_taken[D1_MAXUNQ];

U0 D1UnqSet(I64 i, U8 *name, I64 row, I64 minlvl, I64 value, I64 npow)
{
	CD1Unique *u = &d1_unq[i];
	I64	 k;

	D1StrCopy(u->name, name, D1_UNAME);
	u->row    = row;
	u->minlvl = minlvl;
	u->value  = value;
	u->npow   = npow;
	for (k = 0; k < D1_UPOW; k++)
	{
		u->pw[k] = 0;
		u->pa[k] = 0;
		u->pb[k] = 0;
	}
	if (i + 1 > d1_n_unq)
		d1_n_unq = i + 1;
}

U0 D1UnqPow(I64 i, I64 k, I64 pw, I64 pa, I64 pb)
{
	CD1Unique *u = &d1_unq[i];

	if (k < 0 || k >= D1_UPOW)
		return;
	u->pw[k] = pw;
	u->pa[k] = pa;
	u->pb[k] = pb;
}

#include "D1UnqT"


U0 D1AffixInit()
{
	I64 i;

	if (d1_aff_init)
		return;
	d1_n_pfx = 0;
	d1_n_sfx = 0;
	d1_n_unq = 0;
	D1AffTFill;
	D1UnqTFill;
	for (i = 0; i < D1_MAXUNQ; i++)
		d1_unq_taken[i] = FALSE;
	d1_aff_init = TRUE;
}

U0 D1AffSetGround(I64 i, I64 pfx, I64 sfx)
{
	if (i < 0 || i >= D1_MAXITEM)
		return;
	d1_st_ground[i].pfx = pfx;
	d1_st_ground[i].sfx = sfx;
}

U0 D1AffGetGround(I64 i, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (i < 0 || i >= D1_MAXITEM)
		return;
	*pfx = d1_st_ground[i].pfx;
	*sfx = d1_st_ground[i].sfx;
}

U0 D1AffSetInv(I64 e, I64 pfx, I64 sfx)
{
	if (e < 0 || e >= D1_MAXINV)
		return;
	d1_st_inv[e].pfx = pfx;
	d1_st_inv[e].sfx = sfx;
}

U0 D1AffGetInv(I64 e, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (e < 0 || e >= D1_MAXINV)
		return;
	*pfx = d1_st_inv[e].pfx;
	*sfx = d1_st_inv[e].sfx;
}

U0 D1AffSetEquip(I64 s, I64 pfx, I64 sfx)
{
	if (s < 0 || s >= D1EQ_N)
		return;
	d1_st_equip[s].pfx = pfx;
	d1_st_equip[s].sfx = sfx;
}

U0 D1AffGetEquip(I64 s, I64 *pfx, I64 *sfx)
{
	*pfx = 0;
	*sfx = 0;
	if (s < 0 || s >= D1EQ_N)
		return;
	*pfx = d1_st_equip[s].pfx;
	*sfx = d1_st_equip[s].sfx;
}

I64 D1AffFreeInvEntry()
{
	I64 i;
	I64 e = -1;

	for (i = 0; i < D1_MAXINV; i++)
	{
		if (e < 0 && d1_inv_itm[i] < 0)
			e = i;
	}
	return e;
}

Bool D1AffInvPut(I64 itm, I64 val, I64 pfx, I64 sfx)
{
	I64	 e = D1AffFreeInvEntry();
	Bool ok;

	ok = D1InvPut(itm, val);
	if (ok && e >= 0)
		D1AffSetInv(e, pfx, sfx);
	return ok;
}


I64 D1AffixStrLen(U8 *s)
{
	I64 i = 0;

	while (s[i])
		i++;
	return i;
}

Bool D1AffixIsBow(I64 itm_row)
{
	return D1ItmIsBow(itm_row);
}

I64 D1AffixFlags(I64 itm_row)
{
 //0 = the item takes no affixes (gold, potions).
	CD1ItmDef *d;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	d = &d1_itmdefs[itm_row];
	if (d->misc)
		return 0;
	if (d->cls == D1IC_WEAPON)
	{
		if (d->stf)
			return D1PLT_STAFF;
		if (D1AffixIsBow(itm_row))
			return D1PLT_BOW;
		return D1PLT_WEAP;
	}
	if (d->cls == D1IC_ARMOR)
	{
		if (d->loc == D1IL_ONEHAND)
			return D1PLT_SHLD;
		return D1PLT_ARMO;
	}
	return 0;
}

CD1Affix *D1AffixPfxPtr(I64 id)
{//id is 1-based; 0 = none
	if (id <= 0 || id > d1_n_pfx)
		return NULL;
	return &d1_pfx[id - 1];
}

CD1Affix *D1AffixSfxPtr(I64 id)
{
	if (id <= 0 || id > d1_n_sfx)
		return NULL;
	return &d1_sfx[id - 1];
}


U0 D1AffixBand(I64 power, I64 p1, I64 *lo, I64 *hi)
{
	*lo = 0;
	*hi = 0;
	if (power == D1IPL_TOHIT_DAMP)
	{
		if (p1 == 20)  { *lo = 1;  *hi = 5;   }
		if (p1 == 36)  { *lo = 6;  *hi = 10;  }
		if (p1 == 51)  { *lo = 11; *hi = 15;  }
		if (p1 == 66)  { *lo = 16; *hi = 20;  }
		if (p1 == 81)  { *lo = 21; *hi = 30;  }
		if (p1 == 96)  { *lo = 31; *hi = 40;  }
		if (p1 == 111) { *lo = 41; *hi = 50;  }
		if (p1 == 126) { *lo = 51; *hi = 75;  }
		if (p1 == 151) { *lo = 76; *hi = 100; }
	}
	if (power == D1IPL_TOHIT_DAMP_C)
	{
		if (p1 == 25) { *lo = 1; *hi = 5;  }
		if (p1 == 50) { *lo = 6; *hi = 10; }
	}
}

I64 D1AffixRndPL(I64 p1, I64 p2)
{//items.cpp RndPL
	return p1 + D1Rnd(p2 - p1 + 1);
}

U0 D1AffixValRoll(CD1Affix *a, I64 *v, I64 *v2)
{
	I64 lo;
	I64 hi;

	*v  = 0;
	*v2 = 0;
	if (!a)
		return;
	*v = D1AffixRndPL(a->p1, a->p2);
	D1AffixBand(a->power, a->p1, &lo, &hi);
	if (a->power == D1IPL_TOHIT_DAMP)
	{
		*v  = D1AffixRndPL(a->p1, a->p2);
		*v2 = D1AffixRndPL(lo, hi);
	}
	if (a->power == D1IPL_TOHIT_DAMP_C)
		*v2 = D1AffixRndPL(lo, hi);
}

U0 D1AffixValMid(CD1Affix *a, I64 *v, I64 *v2)
{
	I64 lo;
	I64 hi;

	*v  = 0;
	*v2 = 0;
	if (!a)
		return;
	*v = (a->p1 + a->p2) / 2;
	if (a->power == D1IPL_TOHIT_DAMP || a->power == D1IPL_TOHIT_DAMP_C)
	{
		D1AffixBand(a->power, a->p1, &lo, &hi);
		*v2 = (lo + hi) / 2;
	}
}


I64 D1AffixRoll(I64 itm_row, I64 ilvl, I64 *pfx_out, I64 *sfx_out)
{//items.cpp GetItemPower over GetItemBonus's minlvl = ilvl >> 1 window.
 //returns 1 when at least one affix landed. ids are 1-based, 0 = none.
	I64	 pool[2 * D1_MAXAFF];
	I64	 flgs;
	I64	 minlvl;
	I64	 maxlvl;
	I64	 pre;
	I64	 post;
	I64	 n;
	I64	 j;
	I64	 goe;
	I64	 pick;
	CD1Affix *a;
	Bool onlygood;

	*pfx_out = 0;
	*sfx_out = 0;
	D1AffixInit;

	flgs = D1AffixFlags(itm_row);
	if (!flgs)
		return 0;

	minlvl = ilvl >> 1;
	maxlvl = ilvl;
	if (minlvl > 25)
		minlvl = 25;

	pre  = D1Rnd(4);
	post = D1Rnd(3);
	if (pre != 0 && post == 0)
	{
		if (D1Rnd(2) != 0)
			post = 1;
		else
			pre = 0;
	}

	onlygood = FALSE;
	if (D1Rnd(3) != 0)
		onlygood = TRUE;
	goe = D1GOE_ANY;

	if (pre == 0)
	{
		n = 0;
		for (j = 0; j < d1_n_pfx; j++)
		{
			a = &d1_pfx[j];
			if ((flgs & a->itype) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl && (!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
				if (a->dbl)
				{
					pool[n] = j;
					n++;
				}
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*pfx_out = pick + 1;
			goe      = d1_pfx[pick].goe;
		}
	}

	if (post != 0)
	{
		n = 0;
		for (j = 0; j < d1_n_sfx; j++)
		{
			a = &d1_sfx[j];
			if ((a->itype & flgs) && a->minlvl >= minlvl &&
				a->minlvl <= maxlvl &&
				(goe | a->goe) != (D1GOE_GOOD | D1GOE_EVIL) &&
				(!onlygood || a->ok))
			{
				pool[n] = j;
				n++;
			}
		}
		if (n != 0)
		{
			pick     = pool[D1Rnd(n)];
			*sfx_out = pick + 1;
		}
	}

	if (*pfx_out || *sfx_out)
		return 1;
	return 0;
}

I64 D1AffixStaffPfx(I64 lvl)
{//items.cpp GetStaffPower
	I64	 pool[2 * D1_MAXAFF];
	I64	 n = 0;
	I64	 j;
	CD1Affix *a;

	if (D1Rnd(10) != 0)
		return 0;
	for (j = 0; j < d1_n_pfx; j++)
	{
		a = &d1_pfx[j];
		if ((a->itype & D1PLT_STAFF) && a->minlvl <= lvl)
		{
			pool[n] = j;
			n++;
			if (a->dbl)
			{
				pool[n] = j;
				n++;
			}
		}
	}
	if (n == 0)
		return 0;
	return pool[D1Rnd(n)] + 1;
}


CD1Unique *D1UnqPtr(I64 uid1)
{//uid is 1-based; 0 = not unique
	if (uid1 <= 0 || uid1 > d1_n_unq)
		return NULL;
	return &d1_unq[uid1 - 1];
}

I64 D1UnqMag(CD1Unique *u, I64 k)
{//GetUniqueItem random_(0, pb-pa+1)+pa; pa==pb → fixed
	I64 a;
	I64 b;

	a = u->pa[k];
	b = u->pb[k];
	if (b < a)
		return a;
	if (a == b)
		return a;
	return a + D1Rnd(b - a + 1);
}

U0 D1UnqFillMid(CD1ItmSt *st)
{
	CD1Unique *u = D1UnqPtr(st->unq);
	I64 k;

	if (!u)
		return;
	for (k = 0; k < D1_UPOW; k++)
		st->unqval[k] = 0;
	for (k = 0; k < u->npow; k++)
		st->unqval[k] = (u->pa[k] + u->pb[k]) / 2;
}

U0 D1UnqAssign(CD1ItmSt *st, I64 uid1)
{//items.cpp GetUniqueItem
	CD1Unique *u = D1UnqPtr(uid1);
	I64	 k;
	I64	 p;
	I64	 r;
	I64	 d2;

	if (!u)
		return;
	d1_unq_taken[uid1 - 1] = TRUE;
	st->unq   = uid1;
	st->ident = FALSE;

	for (k = 0; k < u->npow; k++)
	{
		p = u->pw[k];
		r = D1UnqMag(u, k);
		st->unqval[k] = r;
		if (p == D1IPL_INVCURS)
			st->curs = u->pa[k] + 12;
		if (p == D1IPL_NOMINSTR)
			st->nominstr = TRUE;
		if (p == D1IPL_ONEHAND)
			st->onehand = TRUE;
		if (p == D1IPL_SPELL)
		{
			st->spl    = u->pa[k] + 1;
			st->chg    = u->pa[k];
			st->maxchg = u->pb[k];
		}
		if (p == D1IPL_CHARGES)
		{
			st->chg    *= u->pa[k];
			st->maxchg  = st->chg;
		}
		if (p == D1IPL_INDESTRUCT)
		{
			st->maxdur = D1_DURINF;
			st->dur    = D1_DURINF;
		}
		if (p == D1IPL_SETDUR)
		{
			st->maxdur = u->pa[k];
			st->dur    = u->pa[k];
		}
		if (p == D1IPL_DUR && st->maxdur != D1_DURINF)
		{
			d2 = (r * st->maxdur) / 100;
			st->maxdur += d2;
			st->dur    += d2;
		}
		if (p == D1IPL_DUR_CURSE && st->maxdur != D1_DURINF)
		{
			st->maxdur -= (r * st->maxdur) / 100;
			if (st->maxdur < 1)
				st->maxdur = 1;
			st->dur = st->maxdur;
		}
	}
}

Bool D1InvRemoveById(I64 itm_row)
{
	I64 e;

	for (e = 0; e < D1_MAXINV; e++)
	{
		if (d1_inv_itm[e] == itm_row)
		{
			D1InvRemove(e);
			return TRUE;
		}
	}
	return FALSE;
}

U0 D1ItemDropUnique(I64 uid1, I64 x, I64 y)
{
	CD1Unique *u = D1UnqPtr(uid1);
	I64 dd;
	I64 i;

	if (!u)
		return;
	D1ItemDrop(u->row, x, y, 0);
	dd = -1;
	for (i = 0; i < D1_MAXITEM; i++)
	{
		if (d1_items[i].active && d1_items[i].x == x && d1_items[i].y == y &&
			d1_items[i].itm == u->row)
			dd = i;
	}
	if (dd < 0)
		return;
	D1UnqAssign(&d1_st_ground[dd], uid1);
	d1_st_ground[dd].ident = TRUE;
}

Bool D1UnqHas(CD1ItmSt *st, I64 pw)
{
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;

	if (!u || !st->ident)
		return FALSE;
	for (k = 0; k < u->npow; k++)
	{
		if (u->pw[k] == pw)
			return TRUE;
	}
	return FALSE;
}

I64 D1UnqSum(CD1ItmSt *st, I64 pw)
{
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;
	I64	 v = 0;

	if (!u || !st->ident)
		return 0;
	for (k = 0; k < u->npow; k++)
	{
		if (u->pw[k] == pw)
			v += st->unqval[k];
	}
	return v;
}

I64 D1UnqP1(CD1ItmSt *st, I64 pw)
{
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 k;
	I64	 v = 0;
	Bool got = FALSE;

	if (!u || !st->ident)
		return 0;
	for (k = 0; k < u->npow; k++)
	{
		if (!got && u->pw[k] == pw)
		{
			v   = u->pa[k];
			got = TRUE;
		}
	}
	return v;
}

I64 D1UnqCheck(I64 itm_row, I64 lvl, I64 uper)
{//items.cpp CheckUnique. returns a 1-based unique id, 0 for none.
	I64	 j;
	I64	 numu = 0;
	I64	 last = -1;

	if (D1Rnd(100) > uper)
		return 0;
	for (j = 0; j < d1_n_unq; j++)
	{
		if (d1_unq[j].row == itm_row && lvl >= d1_unq[j].minlvl &&
			!d1_unq_taken[j])
		{
			numu++;
			last = j;
		}
	}
	if (numu == 0)
		return 0;
	D1Rnd(10);
	return last + 1;
}

U0 D1PowStAffOne(CD1ItmSt *st, CD1Affix *a, I64 v)
{
	I64 d2;

	if (!a)
		return;
	if (a->power == D1IPL_CHARGES)
	{
		st->chg    *= a->p1;
		st->maxchg  = st->chg;
	}
	if (a->power == D1IPL_INDESTRUCT)
	{
		st->maxdur = D1_DURINF;
		st->dur    = D1_DURINF;
	}
	if (a->power == D1IPL_DUR && st->maxdur != D1_DURINF)
	{
		d2 = (v * st->maxdur) / 100;
		st->maxdur += d2;
		st->dur    += d2;
	}
	if (a->power == D1IPL_DUR_CURSE && st->maxdur != D1_DURINF)
	{
		st->maxdur -= (v * st->maxdur) / 100;
		if (st->maxdur < 1)
			st->maxdur = 1;
		st->dur = st->maxdur;
	}
}

U0 D1PowStAffRoll(CD1ItmSt *st)
{
	CD1Affix *ap = D1AffixPfxPtr(st->pfx);
	CD1Affix *as = D1AffixSfxPtr(st->sfx);

	D1AffixValRoll(ap, &st->pfxval, &st->pfxval2);
	D1PowStAffOne(st, ap, st->pfxval);
	D1AffixValRoll(as, &st->sfxval, &st->sfxval2);
	D1PowStAffOne(st, as, st->sfxval);
}

Bool D1PowMagicWindow(I64 lvl)
{//items.cpp:2921 `random_(32,100) <= 10 || random_(33,100) <= lvl`.
	if (D1Rnd(100) <= 10)
		return TRUE;
	return ToBool(D1Rnd(100) <= lvl);
}

U0 D1PowDropRoll(I64 gi, I64 itm, I64 lvl)
{//items.cpp SetupAllItems for a floor drop (uper 1)
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 uid1;
	I64	 sp = -1;
	I64	 ch = 0;
	Bool staff;
	Bool magic;

	D1AffixInit;
	D1AffSetGround(gi, 0, 0);
	d1_st_ground[gi].ident = FALSE;
	if (gi < 0 || gi >= D1_MAXITEM || lvl < 1)
		return;
	staff = D1ItmIsStaff(itm);
	magic = D1PowMagicWindow(lvl);
	if (staff)
		magic = TRUE;
	if (!magic)
		return;

	uid1 = D1UnqCheck(itm, lvl, 1);
	if (uid1)
	{
		D1UnqAssign(&d1_st_ground[gi], uid1);
		return;
	}
	if (staff)
	{
		if (d1_spl_staff)
			(*d1_spl_staff)(lvl, &sp, &ch);
		if (sp >= 0)
		{
			d1_st_ground[gi].spl    = sp + 1;
			d1_st_ground[gi].chg    = ch;
			d1_st_ground[gi].maxchg = ch;
		}
		D1AffSetGround(gi, D1AffixStaffPfx(lvl), 0);
		D1PowStAffRoll(&d1_st_ground[gi]);
		return;
	}
	D1AffixRoll(itm, lvl, &pfx, &sfx);
	D1AffSetGround(gi, pfx, sfx);
	D1PowStAffRoll(&d1_st_ground[gi]);
}

U0 D1PowTake(I64 gi, I64 e)
{
	if (e < 0)
		return;
	D1StClear(&d1_st_ground[gi]);
}


I64 D1AffixDmgPctOne(CD1Affix *a, I64 v)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_DAMP || a->power == D1IPL_TOHIT_DAMP)
		return v;
	if (a->power == D1IPL_DAMP_CURSE || a->power == D1IPL_TOHIT_DAMP_C)
		return -v;
	return 0;
}

I64 D1AffixDmgFlatOne(CD1Affix *a, I64 v)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_DAMMOD)
		return v;
	return 0;
}

I64 D1AffixAcPctOne(CD1Affix *a, I64 v)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_ACP)
		return v;
	if (a->power == D1IPL_ACP_CURSE)
		return -v;
	return 0;
}

I64 D1AffixToHitOne(CD1Affix *a, I64 v, I64 v2)
{
	if (!a)
		return 0;
	if (a->power == D1IPL_TOHIT)
		return v;
	if (a->power == D1IPL_TOHIT_CURSE)
		return -v;
	if (a->power == D1IPL_TOHIT_DAMP)
		return v2;
	if (a->power == D1IPL_TOHIT_DAMP_C)
		return -v2;
	return 0;
}

I64 D1AffixApplyToHit(I64 tohit, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	return tohit +
		D1AffixToHitOne(D1AffixPfxPtr(pfx), st->pfxval, st->pfxval2) +
		D1AffixToHitOne(D1AffixSfxPtr(sfx), st->sfxval, st->sfxval2);
}

I64 D1AffixStatOne(CD1Affix *a, I64 attr, I64 r)
{
	I64 p;

	if (!a)
		return 0;
	p = a->power;
	if (p == D1IPL_ATTRIBS)
		return r;
	if (p == D1IPL_ATTRIBS_CURSE)
		return -r;
	if (attr == D1AT_STR)
	{
		if (p == D1IPL_STR)
			return r;
		if (p == D1IPL_STR_CURSE)
			return -r;
	}
	if (attr == D1AT_MAG)
	{
		if (p == D1IPL_MAG)
			return r;
		if (p == D1IPL_MAG_CURSE)
			return -r;
	}
	if (attr == D1AT_DEX)
	{
		if (p == D1IPL_DEX)
			return r;
		if (p == D1IPL_DEX_CURSE)
			return -r;
	}
	if (attr == D1AT_VIT)
	{
		if (p == D1IPL_VIT)
			return r;
		if (p == D1IPL_VIT_CURSE)
			return -r;
	}
	return 0;
}

I64 D1AffixApplyStat(I64 attr, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	return D1AffixStatOne(D1AffixPfxPtr(pfx), attr, st->pfxval) +
		   D1AffixStatOne(D1AffixSfxPtr(sfx), attr, st->sfxval);
}


U0 D1PowEquipAff(I64 s, I64 *pfx, I64 *sfx)
{
	D1AffGetEquip(s, pfx, sfx);
	if (!d1_st_equip[s].ident)
	{
		*pfx = 0;
		*sfx = 0;
	}
}

I64 D1PowSlotStr(I64 s)
{
	CD1ItmSt *st = &d1_st_equip[s];
	I64 pfx;
	I64 sfx;

	if (d1_equip_itm[s] < 0 || !st->ident)
		return 0;
	D1PowEquipAff(s, &pfx, &sfx);
	return D1AffixApplyStat(D1AT_STR, st, pfx, sfx) +
		D1UnqSum(st, D1IPL_ATTRIBS) - D1UnqSum(st, D1IPL_ATTRIBS_CURSE) +
		D1UnqSum(st, D1IPL_STR) - D1UnqSum(st, D1IPL_STR_CURSE);
}

Bool d1_pow_statok[D1EQ_N];

U0 D1PowCalcStatFlags()
{//items.cpp CalcSelfItems.
	I64	 s;
	I64	 sa = 0;
	Bool changed = TRUE;

	for (s = 0; s < D1EQ_N; s++)
	{
		d1_pow_statok[s] = ToBool(d1_equip_itm[s] >= 0);
		if (d1_pow_statok[s])
			sa += D1PowSlotStr(s);
	}
	while (changed)
	{
		changed = FALSE;
		for (s = 0; s < D1EQ_N; s++)
		{
			if (d1_pow_statok[s] &&
				!(d1_st_equip[s].ident && d1_st_equip[s].nominstr) &&
				d1_plr_str + sa < d1_itmdefs[d1_equip_itm[s]].minstr)
			{
				sa -= D1PowSlotStr(s);
				d1_pow_statok[s] = FALSE;
				changed = TRUE;
			}
		}
	}
}

Bool D1PowSlotOk(I64 s)
{
	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return FALSE;
	D1PowCalcStatFlags;
	return d1_pow_statok[s];
}

I64 D1PowDmg(I64 dmg, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 pct;
	I64	 out;

	pct = D1AffixDmgPctOne(ap, st->pfxval) + D1AffixDmgPctOne(as, st->sfxval) +
		  D1UnqSum(st, D1IPL_DAMP) - D1UnqSum(st, D1IPL_DAMP_CURSE);
	out = (dmg * (100 + pct)) / 100;
	out += D1AffixDmgFlatOne(ap, st->pfxval) +
		   D1AffixDmgFlatOne(as, st->sfxval) +
		   D1UnqSum(st, D1IPL_DAMMOD);
	if (out < 0)
		out = 0;
	return out;
}

I64 D1PowDmgMin()
{
	CD1ItmSt *st = &d1_st_equip[D1EQ_LEFT];
	I64	 pfx;
	I64	 sfx;
	I64	 base = D1InvDmgMinBase();

	if (d1_equip_itm[D1EQ_LEFT] >= 0 && !D1PowSlotOk(D1EQ_LEFT))
		return 2;
	D1PowEquipAff(D1EQ_LEFT, &pfx, &sfx);
	if (D1UnqHas(st, D1IPL_SETDAM))
		base = D1UnqP1(st, D1IPL_SETDAM);
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1PowDmgMax()
{
	CD1ItmSt *st = &d1_st_equip[D1EQ_LEFT];
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 pfx;
	I64	 sfx;
	I64	 base = D1InvDmgMaxBase();
	I64	 k;

	if (d1_equip_itm[D1EQ_LEFT] >= 0 && !D1PowSlotOk(D1EQ_LEFT))
		return 6;
	D1PowEquipAff(D1EQ_LEFT, &pfx, &sfx);
	if (u && D1UnqHas(st, D1IPL_SETDAM))
	{
		for (k = 0; k < u->npow; k++)
		{
			if (u->pw[k] == D1IPL_SETDAM)
				base = u->pb[k];
		}
	}
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1PowSlotAC(I64 s)
{
	CD1ItmSt *st = &d1_st_equip[s];
	I64	 pfx;
	I64	 sfx;
	I64	 ac;
	I64	 pct;

	D1PowEquipAff(s, &pfx, &sfx);
	ac = d1_equip_val[s];
	if (D1UnqHas(st, D1IPL_SETAC))
		ac = D1UnqP1(st, D1IPL_SETAC);
	ac -= D1UnqSum(st, D1IPL_AC_CURSE);
	pct = D1AffixAcPctOne(D1AffixPfxPtr(pfx), st->pfxval) +
		  D1AffixAcPctOne(D1AffixSfxPtr(sfx), st->sfxval) +
		  D1UnqSum(st, D1IPL_ACP) - D1UnqSum(st, D1IPL_ACP_CURSE);
	ac = (ac * (100 + pct)) / 100;
	if (ac < 0)
		ac = 0;
	return ac;
}

I64 D1PowAC()
{
	I64 s;
	I64 ac = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1PowSlotOk(s))
			ac += D1PowSlotAC(s);
	}
	return ac;
}

I64 D1PowUnqStat(CD1ItmSt *st, I64 attr)
{
	I64 v = D1UnqSum(st, D1IPL_ATTRIBS) - D1UnqSum(st, D1IPL_ATTRIBS_CURSE);

	if (attr == D1AT_STR)
		v += D1UnqSum(st, D1IPL_STR) - D1UnqSum(st, D1IPL_STR_CURSE);
	if (attr == D1AT_MAG)
		v += D1UnqSum(st, D1IPL_MAG) - D1UnqSum(st, D1IPL_MAG_CURSE);
	if (attr == D1AT_DEX)
		v += D1UnqSum(st, D1IPL_DEX) - D1UnqSum(st, D1IPL_DEX_CURSE);
	if (attr == D1AT_VIT)
		v += D1UnqSum(st, D1IPL_VIT) - D1UnqSum(st, D1IPL_VIT_CURSE);
	return v;
}

I64 D1PowStat(I64 attr)
{
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1PowSlotOk(s))
		{
			D1PowEquipAff(s, &pfx, &sfx);
			v += D1AffixApplyStat(attr, &d1_st_equip[s], pfx, sfx) +
				 D1PowUnqStat(&d1_st_equip[s], attr);
		}
	}
	return v;
}

I64 D1PowStrBonus()
{
	return D1PowStat(D1AT_STR);
}

I64 D1PowToHit()
{
	I64 s;
	I64 pfx;
	I64 sfx;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1PowSlotOk(s))
		{
			D1PowEquipAff(s, &pfx, &sfx);
			v += D1AffixApplyToHit(0, &d1_st_equip[s], pfx, sfx) +
				 D1UnqSum(&d1_st_equip[s], D1IPL_TOHIT) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_TOHIT_CURSE);
		}
	}
	return v;
}

I64 D1PowLife()
{
	I64 s;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1PowSlotOk(s))
			v += D1UnqSum(&d1_st_equip[s], D1IPL_LIFE) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_LIFE_CURSE);
	}
	return v;
}

I64 D1PowMana()
{
	I64 s;
	I64 v = 0;

	for (s = 0; s < D1EQ_N; s++)
	{
		if (D1PowSlotOk(s))
			v += D1UnqSum(&d1_st_equip[s], D1IPL_MANA) -
				 D1UnqSum(&d1_st_equip[s], D1IPL_MANA_CURSE);
	}
	return v;
}

U0 D1PowTick()
{
	I64 hp = D1CharBaseHP(d1_plr_class, d1_plr_vit) +
			 (d1_plr_lvl - 1) * (2 << 6);
	I64 mn = D1CharBaseMana(d1_plr_class, d1_plr_mag) +
			 (d1_plr_lvl - 1) * (1 << 6);

	hp += D1PowLife() << 6;
	mn += D1PowMana() << 6;
	if (hp < 1 << 6)
		hp = 1 << 6;
	if (mn < 0)
		mn = 0;
	d1_plr_maxhp   = hp;
	d1_plr_maxmana = mn;
	if (d1_plr_hp > hp)
		d1_plr_hp = hp;
	if (d1_plr_mana > mn)
		d1_plr_mana = mn;
}






I64 D1AffixCat(U8 *dst, I64 at, U8 *s, I64 max)
{
	I64 i = 0;

	while (s[i] && at < max - 1)
	{
		dst[at] = s[i];
		at++;
		i++;
	}
	dst[at] = 0;
	return at;
}

U0 D1AffixNameSpl(U8 *dst, I64 itm_row, I64 pfx, I64 sfx, I64 spl1)
{
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 at = 0;

	dst[0] = 0;
	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return;
	if (ap)
	{
		at = D1AffixCat(dst, at, ap->name, D1_AFFNAME);
		at = D1AffixCat(dst, at, " ", D1_AFFNAME);
	}
	at = D1AffixCat(dst, at, d1_itmdefs[itm_row].name, D1_AFFNAME);
	if (spl1 > 0 && d1_spl_name)
	{
		at = D1AffixCat(dst, at, " of ", D1_AFFNAME);
		at = D1AffixCat(dst, at, (*d1_spl_name)(spl1 - 1), D1_AFFNAME);
	}
	if (as)
	{
		at = D1AffixCat(dst, at, " of ", D1_AFFNAME);
		at = D1AffixCat(dst, at, as->name, D1_AFFNAME);
	}
}

U0 D1AffixName(U8 *dst, I64 itm_row, I64 pfx, I64 sfx)
{
	D1AffixNameSpl(dst, itm_row, pfx, sfx, 0);
}




I64 D1AffixPLVal(I64 pv, I64 p1, I64 p2, I64 minv, I64 maxv)
{//items.cpp PLVal
	if (p1 == p2)
		return minv;
	if (minv == maxv)
		return minv;
	return minv + ((maxv - minv) * ((100 * (pv - p1)) / (p2 - p1))) / 100;
}

I64 D1AffixAddOne(CD1Affix *a, I64 v)
{
	if (!a)
		return 0;
	return D1AffixPLVal(v, a->p1, a->p2, a->minval, a->maxval);
}

I64 D1AffixMultOne(CD1Affix *a)
{
	if (!a)
		return 0;
	return a->multval;
}

I64 D1AffixValue(I64 itm_row, I64 pfx, I64 sfx, I64 pv, I64 sv)
{//items.cpp CalcItemValue over the stored rolls pv/sv
	CD1Affix *ap = D1AffixPfxPtr(pfx);
	CD1Affix *as = D1AffixSfxPtr(sfx);
	I64	 base;
	I64	 v;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	base = d1_itmdefs[itm_row].value;
	if (!ap && !as)
		return base;

	v = D1AffixMultOne(ap) + D1AffixMultOne(as);
	if (v > 0)
		v *= base;
	else if (v < 0)
		v = base / v;
	v += D1AffixAddOne(ap, pv) + D1AffixAddOne(as, sv);
	if (v <= 0)
		v = 1;
	return v;
}


#define D1_IDPRICE		100

Bool D1PowIsMagic(CD1ItmSt *st, I64 pfx, I64 sfx)
{
	if (st->unq)
		return TRUE;
	return pfx != 0 || sfx != 0;
}

Bool D1PowNeedsId(CD1ItmSt *st, I64 pfx, I64 sfx)
{
	if (st->ident)
		return FALSE;
	return D1PowIsMagic(st, pfx, sfx);
}

Bool D1IdOkInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return FALSE;
	D1AffGetInv(e, &pfx, &sfx);
	return D1PowNeedsId(&d1_st_inv[e], pfx, sfx);
}

Bool D1IdOkEquip(I64 s)
{
	I64 pfx;
	I64 sfx;

	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return FALSE;
	D1AffGetEquip(s, &pfx, &sfx);
	return D1PowNeedsId(&d1_st_equip[s], pfx, sfx);
}

U0 D1IdInv(I64 e)
{
	if (e >= 0 && e < D1_MAXINV)
		d1_st_inv[e].ident = TRUE;
}

U0 D1IdEquip(I64 s)
{
	if (s >= 0 && s < D1EQ_N)
		d1_st_equip[s].ident = TRUE;
}


U0 D1PowName(U8 *dst, I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	CD1Unique *u;

	dst[0] = 0;
	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return;
	if (!st->ident)
	{
		if (st->unq)
			D1AffixCat(dst, 0, d1_itmdefs[itm_row].name, D1_AFFNAME);
		else
			D1AffixNameSpl(dst, itm_row, 0, 0, st->spl);
		return;
	}
	u = D1UnqPtr(st->unq);
	if (u)
	{
		D1AffixCat(dst, 0, u->name, D1_AFFNAME);
		return;
	}
	D1AffixNameSpl(dst, itm_row, pfx, sfx, st->spl);
}

I64 D1PowStaffVal(CD1ItmSt *st)
{
	if (st->spl <= 0 || st->unq || !d1_spl_cost)
		return 0;
	return (st->maxchg * (*d1_spl_cost)(st->spl - 1)) / 5;
}

I64 D1PowValue(I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	CD1Unique *u;

	if (itm_row < 0 || itm_row >= d1_n_itmdefs)
		return 0;
	if (!st->ident)
		return d1_itmdefs[itm_row].value + D1PowStaffVal(st);
	u = D1UnqPtr(st->unq);
	if (u)
		return u->value;
	return D1AffixValue(itm_row, pfx, sfx, st->pfxval, st->sfxval) +
		   D1PowStaffVal(st);
}

U0 D1PowNameInv(U8 *dst, I64 e)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return;
	D1AffGetInv(e, &pfx, &sfx);
	D1PowName(dst, d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}

U0 D1PowNameEquip(U8 *dst, I64 s)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return;
	D1AffGetEquip(s, &pfx, &sfx);
	D1PowName(dst, d1_equip_itm[s], &d1_st_equip[s], pfx, sfx);
}

U0 D1PowNameGround(U8 *dst, I64 gi)
{
	I64 pfx;
	I64 sfx;

	dst[0] = 0;
	if (gi < 0 || gi >= D1_MAXITEM || !d1_items[gi].active)
		return;
	D1AffGetGround(gi, &pfx, &sfx);
	D1PowName(dst, d1_items[gi].itm, &d1_st_ground[gi], pfx, sfx);
}

I64 D1ItemTextColor(CD1ItmSt *st)
{//items.cpp GetItemStr / Item::getTextColor: unique gold, magic blue
	if (st->unq)
		return D1COL_GOLD;
	if (D1PowIsMagic(st, st->pfx, st->sfx))
		return D1COL_BLUE;
	return D1COL_WHITE;
}

U0 D1ItemLabelStr(I64 gi, U8 *dst, I64 *col)
{
	CD1Item *it;

	dst[0] = 0;
	*col = D1COL_WHITE;
	if (gi < 0 || gi >= D1_MAXITEM || !d1_items[gi].active)
		return;
	it = &d1_items[gi];
	if (d1_itmdefs[it->itm].cls == D1IC_GOLD)
	{
		StrPrint(dst, "%d", it->val);
		*col = D1COL_GOLD;
		return;
	}
	D1PowNameGround(dst, gi);
	*col = D1ItemTextColor(&d1_st_ground[gi]);
}

I64 D1PowValueInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return 0;
	D1AffGetInv(e, &pfx, &sfx);
	return D1PowValue(d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}


Bool D1DurWear(I64 slot)
{
	CD1ItmSt *st = &d1_st_equip[slot];

	if (d1_equip_itm[slot] < 0)
		return FALSE;
	if (st->dur == D1_DURINF || st->maxdur == D1_DURINF || st->maxdur == 0)
		return FALSE;
	st->dur--;
	if (st->dur > 0)
		return FALSE;
	D1InvBreak(slot);
	return TRUE;
}

Bool D1DurWeaponHitFreq(I64 freq)
{
	Bool broke;

	if (D1Rnd(freq) != 0)
		return FALSE;
	broke = FALSE;
	if (d1_equip_itm[D1EQ_LEFT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].cls == D1IC_WEAPON)
	{
		if (D1DurWear(D1EQ_LEFT))
			broke = TRUE;
	}
	if (d1_equip_itm[D1EQ_RIGHT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_RIGHT]].cls == D1IC_WEAPON)
	{
		if (D1DurWear(D1EQ_RIGHT))
			broke = TRUE;
	}
	if (broke)
		return TRUE;
	if (d1_equip_itm[D1EQ_LEFT] < 0 && d1_equip_itm[D1EQ_RIGHT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_RIGHT]].cls == D1IC_ARMOR)
		return D1DurWear(D1EQ_RIGHT);
	if (d1_equip_itm[D1EQ_RIGHT] < 0 && d1_equip_itm[D1EQ_LEFT] >= 0 &&
		d1_itmdefs[d1_equip_itm[D1EQ_LEFT]].cls == D1IC_ARMOR)
		return D1DurWear(D1EQ_LEFT);
	return FALSE;
}

Bool D1DurWeaponHit()
{
	return D1DurWeaponHitFreq(30);
}

Bool D1DurBowHit()
{//PM_DoRangeAttack: DamageWeapon(..., 40)
	return D1DurWeaponHitFreq(40);
}

Bool D1DurArmorHit()
{
	Bool head;

	if (D1Rnd(4) == 0)
		return FALSE;
	if (d1_equip_itm[D1EQ_BODY] < 0 && d1_equip_itm[D1EQ_HEAD] < 0)
		return FALSE;
	head = (D1Rnd(3) == 0);
	if (d1_equip_itm[D1EQ_BODY] >= 0 && d1_equip_itm[D1EQ_HEAD] < 0)
		head = FALSE;
	if (d1_equip_itm[D1EQ_BODY] < 0 && d1_equip_itm[D1EQ_HEAD] >= 0)
		head = TRUE;
	if (head)
		return D1DurWear(D1EQ_HEAD);
	return D1DurWear(D1EQ_BODY);
}

I64 D1DurPrice(I64 itm_row, CD1ItmSt *st, I64 pfx, I64 sfx)
{//stores.cpp AddStoreHoldRepair.
	I64	 iv;
	I64	 v;
	Bool magic = st->ident && D1PowIsMagic(st, pfx, sfx);

	if (itm_row < 0 || st->maxdur <= 0 || st->maxdur == D1_DURINF)
		return 0;
	if (st->dur >= st->maxdur)
		return 0;

	iv = D1PowValue(itm_row, st, pfx, sfx);
	if (magic)
		iv = (30 * iv) / 100;
	v = (iv * ((100 * (st->maxdur - st->dur)) / st->maxdur)) / 100;
	if (v == 0)
	{
		if (magic)
			return 0;
		v = 1;
	}
	if (v > 1)
		v >>= 1;
	return v;
}

I64 D1DurPriceInv(I64 e)
{
	I64 pfx;
	I64 sfx;

	if (e < 0 || e >= D1_MAXINV || d1_inv_itm[e] < 0)
		return 0;
	D1AffGetInv(e, &pfx, &sfx);
	return D1DurPrice(d1_inv_itm[e], &d1_st_inv[e], pfx, sfx);
}

I64 D1DurPriceEquip(I64 s)
{
	I64 pfx;
	I64 sfx;

	if (s < 0 || s >= D1EQ_N || d1_equip_itm[s] < 0)
		return 0;
	D1AffGetEquip(s, &pfx, &sfx);
	return D1DurPrice(d1_equip_itm[s], &d1_st_equip[s], pfx, sfx);
}

U0 D1DurRepairInv(I64 e)
{
	if (e >= 0 && e < D1_MAXINV)
		d1_st_inv[e].dur = d1_st_inv[e].maxdur;
}

U0 D1DurRepairEquip(I64 s)
{
	if (s >= 0 && s < D1EQ_N)
		d1_st_equip[s].dur = d1_st_equip[s].maxdur;
}


//control.cpp text_color values live in D1Cel, compiled earlier.

#define D1_INFOLINES	5
#define D1_UNQLINES		6

U8	 d1_info_txt[D1_INFOLINES][D1_AFFNAME];
I64	 d1_info_clr[D1_INFOLINES];
I64	 d1_info_n = 0;

Bool d1_unqinfo_on = FALSE;
U8	 d1_unqinfo_name[D1_AFFNAME];
U8	 d1_unqinfo_txt[D1_UNQLINES][D1_AFFNAME];
I64	 d1_unqinfo_n = 0;

U0 D1UnqInfoClear()
{
	d1_unqinfo_on = FALSE;
	d1_unqinfo_n  = 0;
}

U0 D1InfoAdd(U8 *s, I64 col)
{
	if (d1_info_n >= D1_INFOLINES)
		return;
	D1AffixCat(d1_info_txt[d1_info_n], 0, s, D1_AFFNAME);
	d1_info_clr[d1_info_n] = col;
	d1_info_n++;
}

U0 D1InfoPowLine(U8 *dst, I64 pw, I64 p1, I64 p2, I64 v, I64 v2, CD1ItmSt *st)
{//items.cpp PrintItemPower, the powers the affix and unique tables carry.
	U8 *sg = "+";
	U8 *sg2 = "+";

	D1AffixCat(dst, 0, "Another ability (NW)", D1_AFFNAME);
	if (pw == D1IPL_TOHIT_CURSE || pw == D1IPL_DAMP_CURSE ||
		pw == D1IPL_ACP_CURSE || pw == D1IPL_STR_CURSE ||
		pw == D1IPL_MAG_CURSE || pw == D1IPL_DEX_CURSE ||
		pw == D1IPL_VIT_CURSE || pw == D1IPL_ATTRIBS_CURSE ||
		pw == D1IPL_LIFE_CURSE || pw == D1IPL_MANA_CURSE ||
		pw == D1IPL_GETHIT)
	{
		v = -v;
		sg = "";
	}
	if (pw == D1IPL_TOHIT_DAMP_C)
	{
		v = -v;
		v2 = -v2;
		sg = "";
		sg2 = "";
	}

	if (pw == D1IPL_TOHIT || pw == D1IPL_TOHIT_CURSE)
		StrPrint(dst, "chance to hit : %s%d%%", sg, v);
	if (pw == D1IPL_DAMP || pw == D1IPL_DAMP_CURSE)
		StrPrint(dst, "%s%d%% damage", sg, v);
	if (pw == D1IPL_TOHIT_DAMP || pw == D1IPL_TOHIT_DAMP_C)
		StrPrint(dst, "to hit: %s%d%%, %s%d%% damage", sg2, v2, sg, v);
	if (pw == D1IPL_ACP || pw == D1IPL_ACP_CURSE)
		StrPrint(dst, "%s%d%% armor", sg, v);
	if (pw == D1IPL_SETAC || pw == D1IPL_AC_CURSE)
		StrPrint(dst, "armor class: %d", v);
	if (pw == D1IPL_FIRERES)
		StrPrint(dst, "Resist Fire : %s%d%%", sg, v);
	if (pw == D1IPL_LIGHTRES)
		StrPrint(dst, "Resist Lightning : %s%d%%", sg, v);
	if (pw == D1IPL_MAGICRES)
		StrPrint(dst, "Resist Magic : %s%d%%", sg, v);
	if (pw == D1IPL_ALLRES)
		StrPrint(dst, "Resist All : %s%d%%", sg, v);
	if (pw == D1IPL_SPLLVLADD)
	{
		if (v == 1)
			StrPrint(dst, "spells are increased 1 level");
		if (v == 2)
			StrPrint(dst, "spells are increased 2 levels");
	}
	if (pw == D1IPL_CHARGES)
		StrPrint(dst, "Extra charges");
	if (pw == D1IPL_SPELL && d1_spl_name && st->spl > 0)
		StrPrint(dst, "%d %s charges", st->maxchg,
			(*d1_spl_name)(st->spl - 1));
	if (pw == D1IPL_FIREDAM)
		StrPrint(dst, "Fire hit damage: %d-%d", p1, p2);
	if (pw == D1IPL_LIGHTDAM)
		StrPrint(dst, "Lightning hit damage: %d-%d", p1, p2);
	if (pw == D1IPL_STR || pw == D1IPL_STR_CURSE)
		StrPrint(dst, "%s%d to strength", sg, v);
	if (pw == D1IPL_MAG || pw == D1IPL_MAG_CURSE)
		StrPrint(dst, "%s%d to magic", sg, v);
	if (pw == D1IPL_DEX || pw == D1IPL_DEX_CURSE)
		StrPrint(dst, "%s%d to dexterity", sg, v);
	if (pw == D1IPL_VIT || pw == D1IPL_VIT_CURSE)
		StrPrint(dst, "%s%d to vitality", sg, v);
	if (pw == D1IPL_ATTRIBS || pw == D1IPL_ATTRIBS_CURSE)
		StrPrint(dst, "%s%d to all attributes", sg, v);
	if (pw == D1IPL_GETHIT || pw == D1IPL_GETHIT_CURSE)
		StrPrint(dst, "%s%d damage from enemies", sg, v);
	if (pw == D1IPL_LIFE || pw == D1IPL_LIFE_CURSE)
		StrPrint(dst, "Hit Points : %s%d", sg, v);
	if (pw == D1IPL_MANA || pw == D1IPL_MANA_CURSE)
		StrPrint(dst, "Mana : %s%d", sg, v);
	if (pw == D1IPL_DUR)
		StrPrint(dst, "high durability");
	if (pw == D1IPL_DUR_CURSE)
		StrPrint(dst, "decreased durability");
	if (pw == D1IPL_INDESTRUCT)
		StrPrint(dst, "indestructible");
	if (pw == D1IPL_LIGHT)
		StrPrint(dst, "+%d%% light radius", 10 * p1);
	if (pw == D1IPL_LIGHT_CURSE)
		StrPrint(dst, "-%d%% light radius", 10 * p1);
	if (pw == D1IPL_FIRE_ARROWS)
		StrPrint(dst, "fire arrows damage: %d-%d", p1, p2);
	if (pw == D1IPL_LIGHT_ARROWS)
		StrPrint(dst, "lightning arrows damage %d-%d", p1, p2);
	if (pw == D1IPL_THORNS)
		StrPrint(dst, "attacker takes 1-3 damage");
	if (pw == D1IPL_NOMANA)
		StrPrint(dst, "user loses all mana");
	if (pw == D1IPL_ABSHALFTRAP)
		StrPrint(dst, "absorbs half of trap damage");
	if (pw == D1IPL_KNOCKBACK)
		StrPrint(dst, "knocks target back");
	if (pw == D1IPL_STEALMANA)
		StrPrint(dst, "hit steals %d%% mana", p1);
	if (pw == D1IPL_STEALLIFE)
		StrPrint(dst, "hit steals %d%% life", p1);
	if (pw == D1IPL_TARGAC)
		StrPrint(dst, "damages target's armor");
	if (pw == D1IPL_FASTATTACK)
	{
		if (p1 == 1)
			StrPrint(dst, "quick attack");
		if (p1 == 2)
			StrPrint(dst, "fast attack");
		if (p1 == 3)
			StrPrint(dst, "faster attack");
		if (p1 == 4)
			StrPrint(dst, "fastest attack");
	}
	if (pw == D1IPL_FASTRECOVER)
	{
		if (p1 == 1)
			StrPrint(dst, "fast hit recovery");
		if (p1 == 2)
			StrPrint(dst, "faster hit recovery");
		if (p1 == 3)
			StrPrint(dst, "fastest hit recovery");
	}
	if (pw == D1IPL_FASTBLOCK)
		StrPrint(dst, "fast block");
	if (pw == D1IPL_DAMMOD)
		StrPrint(dst, "adds %d points to damage", v);
	if (pw == D1IPL_SETDAM)
		StrPrint(dst, "unusual item damage");
	if (pw == D1IPL_SETDUR)
		StrPrint(dst, "altered durability");
	if (pw == D1IPL_NOMINSTR)
		StrPrint(dst, "no strength requirement");
	if (pw == D1IPL_ONEHAND)
		StrPrint(dst, "one handed sword");
}

U0 D1InfoAffixLine(U8 *dst, CD1Affix *a, I64 v, I64 v2, CD1ItmSt *st)
{
	dst[0] = 0;
	if (!a)
		return;
	D1InfoPowLine(dst, a->power, a->p1, a->p2, v, v2, st);
}

I64 D1InfoDmgMax(I64 itm, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	CD1Unique *u = D1UnqPtr(st->unq);
	I64	 base = d1_itmdefs[itm].dmax;
	I64	 k;

	if (u && D1UnqHas(st, D1IPL_SETDAM))
	{
		for (k = 0; k < u->npow; k++)
		{
			if (u->pw[k] == D1IPL_SETDAM)
				base = u->pb[k];
		}
	}
	return D1PowDmg(base, st, pfx, sfx);
}

I64 D1InfoAC(I64 val, CD1ItmSt *st, I64 pfx, I64 sfx)
{
	I64 ac = val;
	I64 pct;

	if (D1UnqHas(st, D1IPL_SETAC))
		ac = D1UnqP1(st, D1IPL_SETAC);
	ac -= D1UnqSum(st, D1IPL_AC_CURSE);
	pct = D1AffixAcPctOne(D1AffixPfxPtr(pfx), st->pfxval) +
		  D1AffixAcPctOne(D1AffixSfxPtr(sfx), st->sfxval) +
		  D1UnqSum(st, D1IPL_ACP) - D1UnqSum(st, D1IPL_ACP_CURSE);
	ac = (ac * (100 + pct)) / 100;
	if (ac < 0)
		ac = 0;
	return ac;
}

U0 D1UnqInfoFill(CD1ItmSt *st)
{
	CD1Unique *uq;
	I64	 k;
	U8	 buf[D1_AFFNAME];

	D1UnqInfoClear;
	if (!st || !st->unq || !st->ident)
		return;
	uq = D1UnqPtr(st->unq);
	if (!uq)
		return;
	D1AffixCat(d1_unqinfo_name, 0, uq->name, D1_AFFNAME);
	d1_unqinfo_n = 0;
	for (k = 0; k < uq->npow && d1_unqinfo_n < D1_UNQLINES; k++)
	{
		if (uq->pw[k] != D1IPL_INVCURS)
		{
			D1InfoPowLine(buf, uq->pw[k], uq->pa[k], uq->pb[k],
				st->unqval[k], 0, st);
			D1AffixCat(d1_unqinfo_txt[d1_unqinfo_n], 0, buf, D1_AFFNAME);
			d1_unqinfo_n++;
		}
	}
	d1_unqinfo_on = TRUE;
}

U0 D1UnqInfoDraw()
{
	I64 ox;
	I64 uy;
	I64 i;
	I64 y;
	I64 w;
	I64 x;

	if (!d1_unqinfo_on || !d1_inv_open)
		return;
	ox = D1UiOrgX();
	uy = D1UiOrgY();
	D1FillRectTransDither(ox + 27, uy + 28, 265, 297);
	w = D1TextWidth(d1_unqinfo_name);
	x = ox + 32;
	if (w < 257)
		x += (257 - w) / 2;
	D1TextDrawCol(x, uy + 56, d1_unqinfo_name, D1COL_GOLD);
	y = uy + 56 + (12 - d1_unqinfo_n) * 12;
	for (i = 0; i < d1_unqinfo_n; i++)
	{
		w = D1TextWidth(d1_unqinfo_txt[i]);
		x = ox + 32;
		if (w < 257)
			x += (257 - w) / 2;
		D1TextDrawCol(x, y + i * 24, d1_unqinfo_txt[i], D1COL_WHITE);
	}
}

U0 D1InfoItem(I64 itm, CD1ItmSt *st, I64 val)
{//name + detail lines. identified: PrintItemDetails (items.cpp:4460);
 //unidentified: PrintItemDur (items.cpp:4529). val is the rolled AC.
	U8	 buf[D1_AFFNAME];
	CD1ItmDef *d = &d1_itmdefs[itm];
	I64	 col = D1COL_WHITE;
	I64	 pfx = 0;
	I64	 sfx = 0;
	I64	 dmin;
	I64	 dmax;
	Bool magic;

	d1_info_n = 0;
	magic = D1PowIsMagic(st, st->pfx, st->sfx);
	if (st->unq)
		col = D1COL_GOLD;
	else if (magic)
		col = D1COL_BLUE;

	D1PowName(buf, itm, st, st->pfx, st->sfx);
	D1InfoAdd(buf, col);

	if (st->ident)
	{
		pfx = st->pfx;
		sfx = st->sfx;
	}
	if (d->cls == D1IC_WEAPON)
	{
		dmin = d1_itmdefs[itm].dmin;
		if (D1UnqHas(st, D1IPL_SETDAM))
			dmin = D1UnqP1(st, D1IPL_SETDAM);
		dmin = D1PowDmg(dmin, st, pfx, sfx);
		dmax = D1InfoDmgMax(itm, st, pfx, sfx);
		if (st->maxdur == D1_DURINF)
			StrPrint(buf, "damage: %d-%d  Indestructible", dmin, dmax);
		else
			StrPrint(buf, "damage: %d-%d  Dur: %d/%d", dmin, dmax,
				st->dur, st->maxdur);
		D1InfoAdd(buf, col);
	}
	if (d->cls == D1IC_ARMOR)
	{
		if (st->maxdur == D1_DURINF)
			StrPrint(buf, "armor: %d  Indestructible",
				D1InfoAC(val, st, pfx, sfx));
		else
			StrPrint(buf, "armor: %d  Dur: %d/%d",
				D1InfoAC(val, st, pfx, sfx), st->dur, st->maxdur);
		D1InfoAdd(buf, col);
	}
	if (d->stf && st->maxchg)
	{
		StrPrint(buf, "Charges: %d/%d", st->chg, st->maxchg);
		D1InfoAdd(buf, col);
	}
	if (st->ident)
	{
		if (st->unq)
		{
			D1UnqInfoFill(st);
			D1InfoAdd("unique item", col);
		}
		else
		{
			if (pfx)
			{
				D1InfoAffixLine(buf, D1AffixPfxPtr(pfx), st->pfxval,
					st->pfxval2, st);
				D1InfoAdd(buf, col);
			}
			if (sfx)
			{
				D1InfoAffixLine(buf, D1AffixSfxPtr(sfx), st->sfxval,
					st->sfxval2, st);
				D1InfoAdd(buf, col);
			}
		}
	}
	else if (magic)
		D1InfoAdd("Not Identified", col);
	if (d->minstr && !(st->ident && st->nominstr))
	{
		StrPrint(buf, "Required: %d Str", d->minstr);
		if (D1InvStr() < d->minstr)
			D1InfoAdd(buf, D1COL_RED);
		else
			D1InfoAdd(buf, col);
	}

	if (d->misc == D1IM_HEAL)
		D1InfoAdd("recover partial life", col);
	if (d->misc == D1IM_FULLHEAL)
		D1InfoAdd("fully recover life", col);
	if (d->misc == D1IM_MANA)
		D1InfoAdd("recover mana", col);
	if (d->misc == D1IM_FULLMANA)
		D1InfoAdd("fully recover mana", col);
	if (d->misc == D1IM_REJUV)
		D1InfoAdd("recover life and mana", col);
	if (d->misc == D1IM_FULLREJUV)
		D1InfoAdd("fully recover life and mana", col);
	if (d->misc == D1IM_BOOK)
		D1InfoAdd("right-click to read", col);
	if (d->misc)
		D1InfoAdd("Right-click to use", col);
}

Bool D1InvInfoFill(I64 cx, I64 cy)
{
	I64 s;
	I64 e;
	I64 bx;
	I64 by;
	CD1ItmSt belt_st;

	d1_info_n = 0;
	D1UnqInfoClear;

	s = D1InvHitSlot(cx, cy);
	if (s >= 0)
	{
		if (d1_equip_itm[s] < 0)
			return FALSE;
		D1InfoItem(d1_equip_itm[s], &d1_st_equip[s], d1_equip_val[s]);
		return TRUE;
	}
	e = D1InvHitEntry(cx, cy);
	if (e >= 0)
	{
		D1InfoItem(d1_inv_itm[e], &d1_st_inv[e], d1_inv_val[e]);
		return TRUE;
	}

	bx = cx - D1UiOrgX();
	by = cy - D1PanelTop();
	if (by >= 5 && by < 36)
	{
		for (s = 0; s < 8; s++)
		{
			if (bx >= 205 + s * 29 && bx < 233 + s * 29 && d1_belt[s])
			{
				D1StClear(&belt_st);
				D1InfoItem(d1_belt[s], &belt_st, 0);
				return TRUE;
			}
		}
	}
	return FALSE;
}


U0 D1PowInstall()
{
	D1AffixInit;
	d1_pow_drop   = &D1PowDropRoll;
	d1_pow_take   = &D1PowTake;
	d1_pow_tick   = &D1PowTick;
	d1_pow_dmgmin = &D1PowDmgMin;
	d1_pow_dmgmax = &D1PowDmgMax;
	d1_pow_ac     = &D1PowAC;
	d1_pow_str    = &D1PowStrBonus;
}

D1PowInstall;
