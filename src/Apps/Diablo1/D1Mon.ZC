// D1Mon.ZC - monsters: cathedral melee set, chase AI, combat
//
// stats are the monstdat.cpp rows for Zombie, Fallen One (sword),
// Skeleton (axe) and Scavenger. anim letters n/w/a/h/d (monster.cpp
// animletter), one CL2 group of 8 directions per anim. FalSword and
// SkelAxe recolor through their TRN before use (Cl2ApplyTrans).
//
// AI is chase + melee: the original's per-type behaviors (fallen flight,
// scavenger corpse eating, zombie wander weighting) reduce to pursuit
// distance and stand-anim rate here.
//
// player combat state lives here so monster attacks can reach it; D1Play
// (included later) owns the rest of the player.

#define D1_MAXMON		100
#define D1_MONTYPES		33
#define D1_MT_DIABLO	32

//monster modes
#define D1MM_STAND		0
#define D1MM_WALK		1
#define D1MM_ATTACK		2
#define D1MM_HIT		3
#define D1MM_DEATH		4
#define D1MM_DEAD		5

//anim slots
#define D1MA_STAND		0
#define D1MA_WALK		1
#define D1MA_ATTACK		2
#define D1MA_HIT		3
#define D1MA_DEATH		4

//set by D1Mis; lets ranged monsters loose an arrow without a forward ref
U0	(*d1_mon_shoot_cb)(I64 mi) = NULL;

Bool d1_diablo_slain = FALSE;

class CD1MonType
{
	U8	 gfx_fmt[48];				//printf pattern, %c = anim letter
	U8	 trn[40];					//translation file, empty = none
	U8	 name[24];
	U8	*anim[5];					//CL2 groups
	I64	 frames[5];
	I64	 rate[5];
	I64	 width;
	I64	 hp_min;
	I64	 hp_max;
	I64	 mlvl;
	I64	 mint;
	I64	 hit;
	I64	 afnum;
	I64	 dmin;
	I64	 dmax;
	I64	 ac;
	I64	 exp;
	I64	 sight;						//pursuit distance
	I64	 mind;						//dungeon level range
	I64	 maxd;
	Bool ranged;					//keeps distance, shoots arrows
	Bool loaded;
};

CD1MonType d1_montypes[D1_MONTYPES];
Bool d1_montypes_init = FALSE;

class CD1Mon
{
	I64	 type;
	I64	 x;
	I64	 y;
	I64	 dir;
	I64	 mode;
	I64	 anim;
	I64	 frame;
	I64	 animcnt;
	I64	 hp;
	I64	 step;
	I64	 xoff;
	I64	 yoff;
	I64	 delay;
	Bool active;
};

CD1Mon d1_mons[D1_MAXMON];
I64	   d1_nmons = 0;
U8	   d1_dcorpse[D1_MAXDUN * D1_MAXDUN];	//monster idx+1, drawn under actors

U0 D1MonTypeSet(I64 i, U8 *fmt, U8 *trn, U8 *name, I64 w, I64 f0, I64 f1,
	I64 f2, I64 f3, I64 f4, I64 r0, I64 r1, I64 r2, I64 r3, I64 r4,
	I64 mind, I64 maxd, I64 mlvl, I64 hp_min, I64 hp_max, I64 mint,
	I64 hit, I64 afnum, I64 dmin, I64 dmax, I64 ac, I64 exp, I64 sight,
	I64 ranged)
{
	CD1MonType *t = &d1_montypes[i];

	D1StrCopy(t->gfx_fmt, fmt, 48);
	D1StrCopy(t->trn, trn, 40);
	D1StrCopy(t->name, name, 24);
	t->width     = w;
	t->frames[0] = f0;
	t->frames[1] = f1;
	t->frames[2] = f2;
	t->frames[3] = f3;
	t->frames[4] = f4;
	t->rate[0]   = r0;
	t->rate[1]   = r1;
	t->rate[2]   = r2;
	t->rate[3]   = r3;
	t->rate[4]   = r4;
	t->mind      = mind;
	t->maxd      = maxd;
	t->hp_min    = hp_min;
	t->hp_max    = hp_max;
	t->mlvl      = mlvl;
	t->mint      = mint;
	t->hit       = hit;
	t->afnum     = afnum;
	t->dmin      = dmin;
	t->dmax      = dmax;
	t->ac        = ac;
	t->exp       = exp;
	t->sight     = sight;
	t->ranged    = ToBool(ranged);
	t->loaded    = FALSE;
	t->anim[0]   = NULL;
	t->anim[1]   = NULL;
	t->anim[2]   = NULL;
	t->anim[3]   = NULL;
	t->anim[4]   = NULL;
}

#include "D1MonT"

U0 D1MonTypesInit()
{
	if (d1_montypes_init)
		return;
	D1MonTypesFill;
	//The Dark Lord, single-player row; dlvl 50 keeps him out of spawn pools
	D1MonTypeSet(D1_MT_DIABLO, "Monsters\\Diablo\\Diablo%c.CL2", "",
		"The Dark Lord", 160, 16, 6, 16, 6, 16, 0, 0, 0, 0, 0,
		50, 50, 30, 1666, 1666, 3, 220, 4, 30, 60, 90, 31666, 20, 0);
	d1_montypes_init = TRUE;
}

U0 D1Cl2FrameRemap(U8 *data, I64 dsize, U8 *trn)
{//recolor one frame's RLE stream in place (engine.cpp Cl2ApplyTrans)
	I64 i = D1RdU16(data);		//skip the row-block header
	I64 b;
	I64 m;

	while (i < dsize)
	{
		b = data[i];
		i++;
		if (b >= 0x80)
		{
			m = 0x100 - b;
			if (m > 0x41)
			{//one fill byte
				data[i] = trn[data[i]];
				i++;
			}
			else
			{//m literal bytes
				while (m > 0)
				{
					data[i] = trn[data[i]];
					i++;
					m--;
				}
			}
		}
	}
}

U0 D1Cl2GroupRemap(U8 *buf, U8 *trn)
{//all 8 directions, all frames
	U8	*grp;
	I64	 d;
	I64	 f;
	I64	 nf;
	I64	 dsize;
	U8	*data;

	for (d = 0; d < 8; d++)
	{
		grp = D1Cl2Dir(buf, d);
		nf  = D1CelNFrames(grp);
		for (f = 1; f <= nf; f++)
		{
			dsize = 0;
			data  = D1CelFrame(grp, f, &dsize);
			D1Cl2FrameRemap(data, dsize, trn);
		}
	}
}

U8 d1_mon_animletter[6] = "nwahd";

Bool D1MonTypeLoad(I64 ti)
{
	CD1MonType *t = &d1_montypes[ti];
	U8	 path[64];
	U8	*trn = NULL;
	I64	 size;
	I64	 a;

	if (t->loaded)
		return TRUE;

	if (t->trn[0])
		trn = D1MpqRead(t->trn, &size);

	for (a = 0; a < 5; a++)
	{
		StrPrint(path, t->gfx_fmt, d1_mon_animletter[a]);
		t->anim[a] = D1MpqRead(path, &size);
		if (!t->anim[a])
		{
			"D1Mon: no %s\n", path;
			if (trn)
				Free(trn);
			return FALSE;
		}
		if (trn)
			D1Cl2GroupRemap(t->anim[a], trn);
	}
	if (trn)
		Free(trn);

	t->loaded = TRUE;
	return TRUE;
}

U0 D1MonAnimSet(CD1Mon *m, I64 anim)
{
	m->anim    = anim;
	m->frame   = 1;
	m->animcnt = 0;
}

U0 D1MonClearAll()
{
	I64 i;

	d1_nmons = 0;
	for (i = 0; i < D1_MAXMON; i++)
		d1_mons[i].active = FALSE;
	for (i = 0; i < D1_MAXDUN * D1_MAXDUN; i++)
		d1_dcorpse[i] = 0;
}

I64 D1MonPlace(I64 ti, I64 x, I64 y)
{//-1 = table full or tile taken
	CD1Mon *m;

	if (d1_nmons >= D1_MAXMON)
		return -1;
	if (!D1WalkableM(x, y))
		return -1;

	m = &d1_mons[d1_nmons];
	m->type   = ti;
	m->x      = x;
	m->y      = y;
	m->dir    = D1Rnd(8);
	m->mode   = D1MM_STAND;
	m->hp     = (d1_montypes[ti].hp_min +
		D1Rnd(d1_montypes[ti].hp_max - d1_montypes[ti].hp_min + 1)) << 6;
	m->step   = 0;
	m->xoff   = 0;
	m->yoff   = 0;
	m->delay  = 0;
	m->active = TRUE;
	D1MonAnimSet(m, D1MA_STAND);

	d1_dmon[x + y * D1_MAXDUN] = d1_nmons + 1;
	d1_nmons++;
	return d1_nmons - 1;
}

U0 D1MonSpawnLevel(I64 level, I64 avoid_x, I64 avoid_y)
{//groups of allowed types away from the entry stairs
	I64 want = 14 + level * 4;
	I64 tries = 0;
	I64 ntypes;
	I64 ti;
	I64 x;
	I64 y;
	I64 g;
	I64 gx;
	I64 gy;
	I64 dx;
	I64 dy;
	I64 pool[D1_MONTYPES];

	D1MonTypesInit;

	//monstdat level ranges pick the roster
	ntypes = 0;
	for (ti = 0; ti < D1_MONTYPES; ti++)
	{
		if (level >= d1_montypes[ti].mind && level <= d1_montypes[ti].maxd)
		{
			pool[ntypes] = ti;
			ntypes++;
		}
	}
	if (ntypes == 0)
		return;

	while (want > 0 && tries < 4000)
	{
		tries++;
		x = D1Rnd(D1_MAXDUN);
		y = D1Rnd(D1_MAXDUN);
		dx = x - avoid_x;
		dy = y - avoid_y;
		if (dx * dx + dy * dy >= 400 && D1WalkableM(x, y))
		{
			ti = pool[D1Rnd(ntypes)];
			if (D1MonTypeLoad(ti))
			{
				g = 1 + D1Rnd(3);
				while (g > 0 && want > 0)
				{
					gx = x + D1Rnd(3) - 1;
					gy = y + D1Rnd(3) - 1;
					if (D1MonPlace(ti, gx, gy) >= 0)
						want--;
					g--;
				}
			}
			else
				return;
		}
	}
}

U0 D1MonHurt(I64 mi, I64 dmg)
{//dmg in 64ths
	CD1Mon *m = &d1_mons[mi];

	if (!m->active || m->mode == D1MM_DEATH || m->mode == D1MM_DEAD)
		return;

	m->hp -= dmg;
	if (m->hp <= 0)
	{//corpse frees the tile at once, as upstream
		d1_plr_exp += d1_montypes[m->type].exp;
		D1ItemMonsterDrop(m->x, m->y, d1_montypes[m->type].mlvl);
		if (m->type == D1_MT_DIABLO)
			d1_diablo_slain = TRUE;
		m->mode = D1MM_DEATH;
		D1MonAnimSet(m, D1MA_DEATH);
		if (d1_dmon[m->x + m->y * D1_MAXDUN] == mi + 1)
			d1_dmon[m->x + m->y * D1_MAXDUN] = 0;
	}
	else
	{
		m->mode = D1MM_HIT;
		D1MonAnimSet(m, D1MA_HIT);
	}
}

U0 D1MonAttackPlayer(CD1Mon *m)
{//melee roll (monster.cpp MonTryH2HHit reduced)
	CD1MonType *t = &d1_montypes[m->type];
	I64 chance = 30 + t->hit + 2 * t->mlvl - 2 * d1_plr_lvl - d1_plr_dex / 2;
	I64 dmg;

	if (chance < 15)
		chance = 15;
	if (d1_plr_dead)
		return;

	if (D1Rnd(100) < chance)
	{
		dmg = (t->dmin + D1Rnd(t->dmax - t->dmin + 1)) << 6;
		d1_plr_hp -= dmg;
		d1_plr_hitflash = 4;
		if (d1_plr_hp <= 0)
		{
			d1_plr_hp   = 0;
			d1_plr_dead = TRUE;
		}
	}
}

I64 D1MonDirTo(CD1Mon *m, I64 tx, I64 ty)
{
	I64 dx = tx - m->x;
	I64 dy = ty - m->y;

	if (dx > 0) dx = 1;
	if (dx < 0) dx = -1;
	if (dy > 0) dy = 1;
	if (dy < 0) dy = -1;

	if (dx > 0)
	{
		if (dy > 0)  return 0;
		if (dy < 0)  return 6;
		return 7;
	}
	if (dx < 0)
	{
		if (dy > 0)  return 2;
		if (dy < 0)  return 4;
		return 3;
	}
	if (dy > 0)  return 1;
	if (dy < 0)  return 5;
	return m->dir;
}

Bool D1MonWalkStart(CD1Mon *m, I64 mi, I64 dir)
{//occupies both cells for the duration of the step
	I64 nx = m->x + d1_dir_dx[dir];
	I64 ny = m->y + d1_dir_dy[dir];

	if (!D1WalkableM(nx, ny))
		return FALSE;
	if (D1ObjBlocks(nx, ny))
		return FALSE;
	if (nx == d1_plr_tile_x && ny == d1_plr_tile_y)
		return FALSE;

	m->dir  = dir;
	m->mode = D1MM_WALK;
	m->step = 0;
	m->xoff = 0;
	m->yoff = 0;
	D1MonAnimSet(m, D1MA_WALK);
	d1_dmon[nx + ny * D1_MAXDUN] = mi + 1;
	return TRUE;
}

U0 D1MonTick(I64 mi)
{
	CD1Mon	   *m = &d1_mons[mi];
	CD1MonType *t = &d1_montypes[m->type];
	I64	 dist2;
	I64	 dx;
	I64	 dy;
	I64	 nf;
	I64	 dir;
	I64	 ticks;

	if (!m->active || m->mode == D1MM_DEAD)
		return;

	//anim advance, stand honors its rate
	m->animcnt++;
	if (m->animcnt > t->rate[m->anim])
	{
		m->animcnt = 0;
		m->frame++;
		nf = t->frames[m->anim];
		if (m->frame > nf)
		{
			if (m->mode == D1MM_DEATH)
			{//freeze on the last frame as the corpse
				m->frame = nf;
				m->mode  = D1MM_DEAD;
				d1_dcorpse[m->x + m->y * D1_MAXDUN] = mi + 1;
				return;
			}
			if (m->mode == D1MM_HIT || m->mode == D1MM_ATTACK)
			{
				m->mode = D1MM_STAND;
				D1MonAnimSet(m, D1MA_STAND);
			}
			else
				m->frame = 1;
		}
		if (m->mode == D1MM_ATTACK && m->frame == t->afnum)
		{
			if (t->ranged)
			{
				if (d1_mon_shoot_cb)
					(*d1_mon_shoot_cb)(mi);
			}
			else
			{
				dx = d1_plr_tile_x - m->x;
				dy = d1_plr_tile_y - m->y;
				if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
					D1MonAttackPlayer(m);
			}
		}
	}

	if (m->mode == D1MM_WALK)
	{//one tile over the walk anim's span
		ticks = t->frames[D1MA_WALK];
		if (ticks < 2)
			ticks = 2;
		m->step++;
		m->xoff = (32 * (d1_dir_dx[m->dir] - d1_dir_dy[m->dir]) * m->step) / ticks;
		m->yoff = (16 * (d1_dir_dx[m->dir] + d1_dir_dy[m->dir]) * m->step) / ticks;
		if (m->step >= ticks)
		{
			d1_dmon[m->x + m->y * D1_MAXDUN] = 0;
			m->x += d1_dir_dx[m->dir];
			m->y += d1_dir_dy[m->dir];
			d1_dmon[m->x + m->y * D1_MAXDUN] = mi + 1;
			m->xoff = 0;
			m->yoff = 0;
			m->mode = D1MM_STAND;
			D1MonAnimSet(m, D1MA_STAND);
			m->delay = t->mint;
		}
		return;
	}

	if (m->mode != D1MM_STAND)
		return;

	if (m->delay > 0)
	{
		m->delay--;
		return;
	}
	if (d1_plr_dead)
		return;

	dx = d1_plr_tile_x - m->x;
	dy = d1_plr_tile_y - m->y;
	dist2 = dx * dx + dy * dy;

	if (t->ranged)
	{//keep range and shoot
		if (dist2 <= t->sight * t->sight)
		{
			if (dist2 <= 9)
			{//too close: back off
				dir = (D1MonDirTo(m, d1_plr_tile_x, d1_plr_tile_y) + 4) & 7;
				if (!D1MonWalkStart(m, mi, dir))
				{
					if (!D1MonWalkStart(m, mi, (dir + 1) & 7))
						D1MonWalkStart(m, mi, (dir + 7) & 7);
				}
			}
			else
			{
				m->dir  = D1MonDirTo(m, d1_plr_tile_x, d1_plr_tile_y);
				m->mode = D1MM_ATTACK;
				D1MonAnimSet(m, D1MA_ATTACK);
				m->delay = 4 + t->mint * 2;
			}
		}
		return;
	}

	if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)
	{//adjacent: face and swing
		m->dir  = D1MonDirTo(m, d1_plr_tile_x, d1_plr_tile_y);
		m->mode = D1MM_ATTACK;
		D1MonAnimSet(m, D1MA_ATTACK);
		return;
	}

	if (dist2 <= t->sight * t->sight)
	{//pursue; try the direct heading then its neighbors
		dir = D1MonDirTo(m, d1_plr_tile_x, d1_plr_tile_y);
		if (!D1MonWalkStart(m, mi, dir))
		{
			if (!D1MonWalkStart(m, mi, (dir + 1) & 7))
			{
				if (!D1MonWalkStart(m, mi, (dir + 7) & 7))
					m->delay = 2;
			}
		}
	}
	else if (D1Rnd(8) == 0)
		D1MonWalkStart(m, mi, D1Rnd(8));
}

U0 D1MonTickAll()
{
	I64 i;

	for (i = 0; i < d1_nmons; i++)
		D1MonTick(i);
}

U0 D1MonDrawCell(I64 x, I64 y, I64 sx, I64 sy)
{//corpse first, then any live monster anchored at this cell
	CD1Mon	   *m;
	CD1MonType *t;
	I64	 mi;
	U8	*grp;
	I64	 f;

	mi = d1_dcorpse[x + y * D1_MAXDUN];
	if (mi)
	{
		m = &d1_mons[mi - 1];
		t = &d1_montypes[m->type];
		if (m->mode == D1MM_DEAD && t->anim[D1MA_DEATH])
			D1Cl2Draw(sx + 32 - t->width / 2, sy, D1Cl2Dir(t->anim[D1MA_DEATH],
				m->dir), t->frames[D1MA_DEATH], t->width);
	}

	mi = d1_dmon[x + y * D1_MAXDUN];
	if (!mi)
		return;
	m = &d1_mons[mi - 1];
	if (!m->active || m->mode == D1MM_DEAD)
		return;
	if (m->x != x || m->y != y)
		return;					//walk target cell; the source cell draws it

	t   = &d1_montypes[m->type];
	grp = t->anim[m->anim];
	if (!grp)
		return;
	f = m->frame;
	if (f > D1CelNFrames(D1Cl2Dir(grp, m->dir)))
		f = 1;

	D1Cl2Draw(sx + 32 - t->width / 2 + m->xoff, sy + m->yoff,
		D1Cl2Dir(grp, m->dir), f, t->width);
}

U0 D1MonSpawnDiablo(I64 avoid_x, I64 avoid_y)
{//farthest walkable spot from the entry
	I64 x;
	I64 y;
	I64 best_x = -1;
	I64 best_y = -1;
	I64 best_d = -1;
	I64 d;

	D1MonTypesInit;
	if (!D1MonTypeLoad(D1_MT_DIABLO))
		return;

	for (y = 0; y < D1_MAXDUN; y++)
		for (x = 0; x < D1_MAXDUN; x++)
		{
			if (D1WalkableM(x, y))
			{
				d = (x - avoid_x) * (x - avoid_x) +
					(y - avoid_y) * (y - avoid_y);
				if (d > best_d)
				{
					best_d = d;
					best_x = x;
					best_y = y;
				}
			}
		}
	if (best_x >= 0)
		D1MonPlace(D1_MT_DIABLO, best_x, best_y);
}

I64 D1MonAtTile(I64 x, I64 y)
{//live monster index at tile, -1 if none
	I64 mi;

	if (x < 0 || x >= D1_MAXDUN || y < 0 || y >= D1_MAXDUN)
		return -1;
	mi = d1_dmon[x + y * D1_MAXDUN];
	if (!mi)
		return -1;
	if (!d1_mons[mi - 1].active || d1_mons[mi - 1].mode == D1MM_DEAD ||
		d1_mons[mi - 1].mode == D1MM_DEATH)
		return -1;
	return mi - 1;
}
