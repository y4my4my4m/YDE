// D1Pal.ZC - 256-color palette, fades
//
// .pal file: 768 bytes, 256 RGB triples. this tree's CDC is truecolor, so
// the palette is kept expanded to 0x00RRGGBB for the blit; fades rebuild
// the expanded table, costing nothing per frame (palette.cpp keeps the
// same split as logical/system palette).

#define D1PAL_COLORS	256

U8	 d1_pal[D1PAL_COLORS * 3];		//current logical palette
U32	 d1_argb[D1PAL_COLORS];			//expanded, post fade
I64	 d1_fade_level = 256;			//0 = black, 256 = full
Bool d1_pal_loaded = FALSE;

U0 D1PalExpand()
{//logical palette + fade level -> argb
	I64 i;
	I64 r;
	I64 g;
	I64 b;

	for (i = 0; i < D1PAL_COLORS; i++)
	{
		r = (d1_pal[i * 3]     * d1_fade_level) >> 8;
		g = (d1_pal[i * 3 + 1] * d1_fade_level) >> 8;
		b = (d1_pal[i * 3 + 2] * d1_fade_level) >> 8;
		if (r > 255) r = 255;
		if (g > 255) g = 255;
		if (b > 255) b = 255;
		d1_argb[i] = (r << 16) | (g << 8) | b;
	}
}

U0 D1PalSetRaw(U8 *rgb768)
{
	MemCopy(d1_pal, rgb768, D1PAL_COLORS * 3);
	d1_pal_loaded = TRUE;
	D1PalExpand;
}

Bool D1PalLoad(U8 *name)
{//from the mounted MPQ
	I64	 size = 0;
	U8	*p    = D1MpqRead(name, &size);

	if (!p || size < D1PAL_COLORS * 3)
	{
		"D1Pal: %s missing or short\n", name;
		if (p)
			Free(p);
		return FALSE;
	}
	D1PalSetRaw(p);
	Free(p);
	return TRUE;
}

U0 D1PalFadeLevel(I64 level)
{//0 = black, 256 = full brightness
	if (level < 0)
		level = 0;
	if (level > 256)
		level = 256;
	d1_fade_level = level;
	D1PalExpand;
}

U32 D1PalColor(I64 index)
{
	return d1_argb[index & 255];
}

I64 D1PalBrightest()
{//index of the lightest color; UI text through foreign palettes
	I64 best   = 0;
	I64 best_v = -1;
	I64 i;
	I64 v;

	for (i = 0; i < D1PAL_COLORS; i++)
	{
		v = d1_pal[i * 3] + d1_pal[i * 3 + 1] + d1_pal[i * 3 + 2];
		if (v > best_v)
		{
			best_v = v;
			best   = i;
		}
	}
	return best;
}
