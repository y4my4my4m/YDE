// RunNet.ZC - Diablo1 WITH networking. run this instead of Run.ZC for LAN play.
//
// separate entry point because the binding is COMPILE-TIME: single-pass
// compiler, so UDPSocket must resolve when D1Net.ZC is read. picking
// Multiplayer from the menu is far too late.
//
// not free - the driver probe THROWS 'NODRIVER' with no supported NIC, and
// pulls in TCP, TLS, crypto and HTTP. hence single player skips it.
// Quake's RunNet.ZC is the same pattern.

Cd(__DIR__);;

#ifndef UDP_MAX_PORT
#include "::/Home/Net/Load"
Cd(__DIR__);;
#endif

#include "Run"
