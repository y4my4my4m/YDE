// span rasterizer
//
// canvas is 0x00RRGGBB truecolor. every miptex carries its own 256 colour
// palette, so there is no shared colormap to shade through: lighting is a
// per-channel multiply, folded in once per surface texel by the surface cache.
//
// per face: world verts -> camera space -> near clip -> project -> scanline
// fill with perspective-correct texture and lightmap.
//
// studio/alias paths carry CHLScreenVert.light (0..255) and interpolate it
// screen-space across each span (affine Gouraud); a lightmap ignores it.
//
// hl_r_spanfast FALSE forces the branched general span loop.
Bool hl_r_spanfast = TRUE;
hl_r_spanfast = TRUE;

I64 hl_draw_frame = 0;
hl_draw_frame = 0;
Bool hl_r_decals      = TRUE;
Bool hl_r_dynamic     = TRUE;
Bool hl_r_drawentities = TRUE;
Bool hl_r_drawsprites = TRUE;
Bool hl_r_lightpoint  = TRUE;
Bool hl_r_beams       = TRUE;
Bool hl_r_drawsky     = TRUE;

hl_r_decals       = TRUE;
hl_r_dynamic      = TRUE;
hl_r_drawentities = TRUE;
hl_r_drawsprites  = TRUE;
hl_r_lightpoint   = TRUE;
hl_r_beams        = TRUE;
hl_r_drawsky      = TRUE;

#define HLSCR_W			320
#define HLSCR_H			240
#define HLMAX_POLY_VERTS	64
#define HLNEAR_CLIP		4.0		//world units in front of the eye

#define HLSPAN_SUB		16

class CHLPolyVert
{
	F64	cam[3];
	F64	s;
	F64	t;
	F64	light;		//0..255 studio/alias shade; unused under a lightmap
};

class CHLScreenVert
{
	F64	x;
	F64	y;
	F64	inv_z;
	F64	s_over_z;
	F64	t_over_z;
	F64	light;
};

class CHLCanvas
{
	U32	*pixels;
	F64	*depth;			//1/z, larger is nearer
	I64	 width;
	I64	 height;

	F64	 origin[3];
	F64	 forward[3];
	F64	 right[3];
	F64	 up[3];
	F64	 x_scale;
	F64	 y_scale;
	F64	 center_x;
	F64	 center_y;

	I64	 vx;
	I64	 vy;
	I64	 vw;
	I64	 vh;

	I64	 faces_drawn;
	I64	 spans_drawn;
};


I64	hl_rs_faces		= 0;
I64	hl_rs_spans		= 0;
I64	hl_rs_span_px	= 0;
I64	hl_rs_sky_px		= 0;
I64	hl_rs_surf_hit	= 0;
I64	hl_rs_surf_build	= 0;
I64	hl_rs_surf_texels = 0;
I64	hl_rs_surf_evict	= 0;
I64	hl_rs_surf_dlit	= 0;
I64	hl_rs_decals		= 0;
I64	hl_rs_decal_px	= 0;
I64	hl_rs_decal_hit	= 0;
I64	hl_rs_tris		= 0;
I64	hl_rs_model_px	= 0;
I64	hl_rs_sprites	= 0;
I64	hl_rs_sprite_px	= 0;
I64	hl_rs_part_px	= 0;
I64	hl_rs_beams		= 0;
I64	hl_rs_beam_px	= 0;
I64	hl_rs_lightpoint	= 0;

I64	hl_tsc_clear	= 0;
I64	hl_tsc_world	= 0;
I64	hl_tsc_blit		= 0;

Bool hl_rs_enable = FALSE;

U0 HLRSpeedsReset()
{
	hl_rs_faces		= 0;
	hl_rs_spans		= 0;
	hl_rs_span_px		= 0;
	hl_rs_sky_px		= 0;
	hl_rs_surf_hit	= 0;
	hl_rs_surf_build	= 0;
	hl_rs_surf_texels	= 0;
	hl_rs_surf_evict	= 0;
	hl_rs_surf_dlit	= 0;
	hl_rs_decals		= 0;
	hl_rs_decal_px	= 0;
	hl_rs_decal_hit	= 0;
	hl_rs_tris		= 0;
	hl_rs_model_px	= 0;
	hl_rs_sprites		= 0;
	hl_rs_sprite_px	= 0;
	hl_rs_part_px		= 0;
	hl_rs_beams		= 0;
	hl_rs_beam_px		= 0;
	hl_rs_lightpoint	= 0;
	hl_tsc_clear		= 0;
	hl_tsc_world		= 0;
	hl_tsc_blit			= 0;
}

U0 HLRSpeedsPrint()
{
	"wsurf %d spans %d px %d sky %d\n",
		hl_rs_faces, hl_rs_spans, hl_rs_span_px, hl_rs_sky_px;
	"surf  hit %d build %d texels %d bytes %d evict %d dlit %d\n",
		hl_rs_surf_hit, hl_rs_surf_build, hl_rs_surf_texels,
		hl_rs_surf_texels * 4, hl_rs_surf_evict, hl_rs_surf_dlit;
	"decal %d px %d blend %d\n",
		hl_rs_decals, hl_rs_decal_px, hl_rs_decal_hit;
	"model tris %d px %d\n", hl_rs_tris, hl_rs_model_px;
	"efx   spr %d px %d part %d lightpt %d\n",
		hl_rs_sprites, hl_rs_sprite_px, hl_rs_part_px, hl_rs_lightpoint;
	"beam  %d px %d\n", hl_rs_beams, hl_rs_beam_px;
	"kcyc  clear %d world %d blit %d\n",
		hl_tsc_clear / 1000, hl_tsc_world / 1000, hl_tsc_blit / 1000;
}

U0 HLRSpeeds(Bool on = TRUE)
{
	hl_rs_enable = on;
}

#define HLTURB_CYCLE		128
#define HLTURB_AMP		8.0
#define HLTURB_SPEED		20.0

F64 hl_turb_table[HLTURB_CYCLE];
I64 hl_turb_phase = 0;

U0 HLTurbInit()
{
	I64 i;

	for (i = 0; i < HLTURB_CYCLE; i++)
		hl_turb_table[i] = HLTURB_AMP +
			Sin(ToF64(i) * 2.0 * pi / ToF64(HLTURB_CYCLE)) * HLTURB_AMP;
}

U0 HLTurbFrame(F64 time)
{
	hl_turb_phase = ToI64(time * HLTURB_SPEED) & (HLTURB_CYCLE - 1);
}


#define HLMAX_DLIGHTS		32
#define HLDLIGHT_MINLIGHT	4.0

class CHLDlight
{
	F64	origin[3];
	F64	radius;
	F64	die;
	F64	decay;
	F64	min_light;

	I64	key;

	I64	color[3];
};

CHLDlight	hl_dlight[HLMAX_DLIGHTS];
I64			hl_dlight_count = 0;

U0 HLDlightClear()
{
	hl_dlight_count = 0;
}

U0 HLDlightAdd(F64 *origin, F64 radius, F64 life, F64 decay, F64 time,
	I64 cr = 255, I64 cg = 255, I64 cb = 255, I64 key = 0)
{
	CHLDlight	*d;
	I64			 slot = -1;
	I64			 i;

	if (key)
	{
		for (i = 0; i < hl_dlight_count; i++)
		{
			if (hl_dlight[i].key == key)
			{
				slot = i;
				break;
			}
		}
	}

	if (slot < 0)
	{
		for (i = 0; i < hl_dlight_count; i++)
		{
			if (hl_dlight[i].die <= time)
			{
				slot = i;
				break;
			}
		}
	}

	if (slot < 0)
	{
		if (hl_dlight_count < HLMAX_DLIGHTS)
		{
			slot = hl_dlight_count;
			hl_dlight_count++;
		}
		else
			slot = 0;
	}

	d = &hl_dlight[slot];
	HLVecCopy(origin, d->origin);
	d->radius    = radius;
	d->die       = time + life;
	d->decay     = decay;
	d->key       = key;
	d->min_light = HLDLIGHT_MINLIGHT;
	d->color[0]  = ClampI64(cr, 0, 255);
	d->color[1]  = ClampI64(cg, 0, 255);
	d->color[2]  = ClampI64(cb, 0, 255);
}

U0 HLDlightKill(I64 key)
{
	I64 i;

	if (!key)
		return;

	for (i = 0; i < hl_dlight_count; i++)
	{
		if (hl_dlight[i].key == key)
		{
			hl_dlight[i].die = 0.0;
			hl_dlight[i].key = 0;
		}
	}
}

U0 HLDlightUpdate(F64 dt, F64 time)
{
	I64 i;

	for (i = 0; i < hl_dlight_count; i++)
	{
		if (hl_dlight[i].die <= time)
			goto qdl_next;

		hl_dlight[i].radius -= dt * hl_dlight[i].decay;
		if (hl_dlight[i].radius < 0.0)
			hl_dlight[i].die = 0.0;

qdl_next:
	}
}

Bool HLDlightsActive(F64 time)
{
	I64 i;

	for (i = 0; i < hl_dlight_count; i++)
	{
		if (hl_dlight[i].die > time && hl_dlight[i].radius > 0.0)
			return TRUE;
	}

	return FALSE;
}

Bool HLDlightNear(F64 *point, F64 time)
{
	F64 dl[3];
	I64 i;

	if (!point)
		return FALSE;

	for (i = 0; i < hl_dlight_count; i++)
	{
		if (hl_dlight[i].die <= time || hl_dlight[i].radius <= 0.0)
			goto qdn_next;

		HLVecSub(point, hl_dlight[i].origin, dl);

		if (HLVecLength(dl) < hl_dlight[i].radius)
			return TRUE;

qdn_next:
	}

	return FALSE;
}


#define HLMAX_LIGHTSTYLES	64
#define HLLIGHTSTYLE_LEN		64
#define HLLIGHTSTYLE_NORMAL	256

//what a steady style resolves to.
#define HLLIGHT_UNITY		264
#define HLLIGHT_SCRATCH		4096

#define HLLIGHT_SCRATCH_B	(HLLIGHT_SCRATCH * HLLIGHT_STRIDE)

#define HLLIGHT_FALLBACK		170

#define HLLIGHT_PT_GRID		32
#define HLLIGHT_PT_SLOTS	16

class CHLLightPtSlot
{
	I64	qx;
	I64	qy;
	I64	qz;
	I64	frame;		//hl_dlight_frame when filled; -1 empty
	I64	val;
	I64	key;
	I64	style;
};

U8	hl_lightstyle[HLMAX_LIGHTSTYLES * HLLIGHTSTYLE_LEN];
I64	hl_lightstyle_value[HLMAX_LIGHTSTYLES];
U8	hl_light_scratch[HLLIGHT_SCRATCH_B];
U8	hl_light_black[HLLIGHT_SCRATCH_B];

I64	hl_light_acc[HLLIGHT_SCRATCH_B];
Bool hl_dlight_any	= FALSE;
I64	hl_light_fast	= 0;
I64	hl_light_slow	= 0;
I64	hl_light_clamped	= 0;

I64 hl_dlight_frame	= 0;
I64 hl_ambient_light	= 0;

F64	hl_dlight_mspace[HLMAX_DLIGHTS * 3];
Bool	hl_dlight_mspace_on	= FALSE;

F64 *HLDlightOrigin(I64 i)
{
	if (hl_dlight_mspace_on)
		return &hl_dlight_mspace[i * 3];

	return hl_dlight[i].origin;
}

I64 hl_light_pt_style = -1;

I64 hl_light_pt_key = -1;

CHLLightPtSlot hl_light_pt_cache[HLLIGHT_PT_SLOTS];

F64 hl_light_time = 0.0;
F64 hl_light_last = 0.0;

F64 HLWaterWaveZ(F64 x, F64 y, F64 z, F64 amp)
{
	F64 nv;
	I64 i1;
	I64 i2;

	if (amp <= 0.0)
		return z;

	i1 = ToI64(hl_light_time * 160.0 + y + x) & (HLTURB_CYCLE - 1);
	i2 = ToI64(x * 5.0 + hl_light_time * 171.0 - y) & (HLTURB_CYCLE - 1);
	nv = hl_turb_table[i1];
	nv = hl_turb_table[i2] * 0.8 + nv;
	return z + nv * amp;
}

U0 HLLightInit()
{
	I64 i;

	MemSet(hl_light_black, 0, HLLIGHT_SCRATCH_B);

	hl_rs_enable = FALSE;
	HLRSpeedsReset;

	hl_dlight_any  = FALSE;
	hl_dlight_count = 0;
	hl_dlight_frame = 0;
	hl_dlight_mspace_on = FALSE;
	hl_ambient_light = 0;
	hl_light_last  = 0.0;
	hl_light_time  = 0.0;
	hl_light_pt_style = -1;

	for (i = 0; i < HLLIGHT_PT_SLOTS; i++)
		hl_light_pt_cache[i].frame = -1;

	for (i = 0; i < HLMAX_LIGHTSTYLES; i++)
	{
		hl_lightstyle[i * HLLIGHTSTYLE_LEN] = 0;
		hl_lightstyle_value[i]             = HLLIGHTSTYLE_NORMAL;
	}
}

U0 HLLightStyleSet(I64 style, U8 *str)
{
	if (style < 0 || style >= HLMAX_LIGHTSTYLES || !str)
		return;

	HLStrCopy(&hl_lightstyle[style * HLLIGHTSTYLE_LEN], str, HLLIGHTSTYLE_LEN);
}

U0 HLLightFrame(F64 time)
{
	F64 dt = time - hl_light_last;

	hl_light_last = time;

	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	hl_light_time = time;
	HLDlightUpdate(dt, time);
	hl_dlight_any = HLDlightsActive(time);
}

U0 HLLightAnimate(F64 time)
{
	U8	*str;
	I64	 frame = ToI64(time * 10.0);
	I64	 len;
	I64	 i;
	I64	 k;

	for (i = 0; i < HLMAX_LIGHTSTYLES; i++)
	{
		str = &hl_lightstyle[i * HLLIGHTSTYLE_LEN];
		len = StrLen(str);

		if (!len)
		{
			hl_lightstyle_value[i] = HLLIGHTSTYLE_NORMAL;
			goto ql_next;
		}

		k = frame % len;
		if (k < 0)
			k = 0;

		//'a'..'z' -> 0..550 in steps of 22
		hl_lightstyle_value[i] = (str[k] - 'a') * 22;

ql_next:
	}
}

Bool HLLightTouchesFace(CHLMap *map, CHLDlight *light, CHLFace *f)
{
	CHLPlane	*plane;
	CHLTexInfo	*ti;
	CHLTexture	*tex;
	F64			 impact[3];
	F64			 dist;
	F64			 rad;
	F64			 local_s;
	F64			 local_t;
	F64			 sd;
	F64			 td;
	F64			 adist;
	I64			 j;

	if (f->plane_num < 0 || f->plane_num >= map->num_planes)
		return FALSE;
	if (f->tex_info < 0 || f->tex_info >= map->num_texinfo)
		return FALSE;

	ti = &map->texinfo[f->tex_info];

	if (ti->miptex >= 0 && ti->miptex < map->num_textures)
	{
		tex = &map->textures[ti->miptex];
		if (tex->is_sky || tex->is_turb)
			return FALSE;
	}

	plane = &map->planes[f->plane_num];

	dist = HLVecDot(light->origin, plane->normal) - plane->dist;

	if (dist < 0.0)
		rad = light->radius + dist;
	else
		rad = light->radius - dist;

	if (rad < light->min_light)
		return FALSE;

	rad -= light->min_light;

	for (j = 0; j < 3; j++)
		impact[j] = light->origin[j] - plane->normal[j] * dist;

	local_s = HLVecDot(impact, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
	local_t = HLVecDot(impact, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

	sd = 0.0;
	if (local_s < 0.0)
		sd = -local_s;
	else if (local_s > ToF64(f->extent_s))
		sd = local_s - ToF64(f->extent_s);

	td = 0.0;
	if (local_t < 0.0)
		td = -local_t;
	else if (local_t > ToF64(f->extent_t))
		td = local_t - ToF64(f->extent_t);

	if (sd > td)
		adist = sd + td * 0.5;
	else
		adist = td + sd * 0.5;

	if (adist < rad)
		return TRUE;

	return FALSE;
}

U0 HLMarkLights(CHLMap *map, CHLDlight *light, I64 bit, I64 node_index)
{
	CHLNode	*node;
	CHLPlane	*plane;
	CHLFace	*f;
	F64		 dist;
	I64		 i;

	if (node_index < 0 || node_index >= map->num_nodes)
		return;

	node = &map->nodes[node_index];

	if (node->plane_num < 0 || node->plane_num >= map->num_planes)
		return;

	plane = &map->planes[node->plane_num];
	dist  = HLVecDot(light->origin, plane->normal) - plane->dist;

	if (dist > light->radius)
	{
		HLMarkLights(map, light, bit, node->children[0]);
		return;
	}
	if (dist < -light->radius)
	{
		HLMarkLights(map, light, bit, node->children[1]);
		return;
	}

	for (i = 0; i < node->num_faces; i++)
	{
		if (node->first_face + i < 0 ||
			node->first_face + i >= map->num_faces)
			goto qml_next;

		f = &map->faces[node->first_face + i];

		if (!HLLightTouchesFace(map, light, f))
			goto qml_next;

		if (f->dlight_frame != hl_dlight_frame)
		{
			f->dlight_bits  = 0;
			f->dlight_frame = hl_dlight_frame;
			hl_rs_surf_dlit++;
		}

		f->dlight_bits |= bit;

qml_next:
	}

	HLMarkLights(map, light, bit, node->children[0]);
	HLMarkLights(map, light, bit, node->children[1]);
}

U0 HLPushDlights(CHLMap *map, F64 time)
{
	I64 i;

	hl_dlight_frame++;

	if (!hl_r_dynamic)
	{
		hl_dlight_any = FALSE;
		return;
	}

	if (!map || !map->nodes || map->num_nodes < 1)
		return;

	for (i = 0; i < hl_dlight_count && i < HLMAX_DLIGHTS; i++)
	{
		if (hl_dlight[i].die <= time || hl_dlight[i].radius <= 0.0)
			goto qpd_next;

		HLMarkLights(map, &hl_dlight[i], 1 << i, 0);

qpd_next:
	}
}

CHLDlight hl_dlight_scratch;

U0 HLMarkLightsModel(CHLMap *map, CHLModel *bm, F64 *origin, F64 *xform)
{//R_DrawBrushModel's dlight pass, gl_rsurf.c.
	F64	 lmins[3];
	F64	 lmaxs[3];
	F64	 d;
	F64	 near_d;
	I64	 i;
	I64	 j;
	Bool descend;

	if (!hl_r_dynamic || !map || !bm)
		return;

	descend = ToBool(bm != &map->models[0] &&
		bm->head_node[0] >= 0 && bm->head_node[0] < map->num_nodes);

	HLVecCopy(bm->mins, lmins);
	HLVecCopy(bm->maxs, lmaxs);

	for (i = 0; i < hl_dlight_count && i < HLMAX_DLIGHTS; i++)
	{
		if (xform)
			HLMatTransformInv(hl_dlight[i].origin, xform,
				&hl_dlight_mspace[i * 3]);
		else if (origin)
			HLVecSub(hl_dlight[i].origin, origin, &hl_dlight_mspace[i * 3]);
		else
			HLVecCopy(hl_dlight[i].origin, &hl_dlight_mspace[i * 3]);

		if (!descend)
			goto qmlm_next;

		if (hl_dlight[i].die <= hl_light_time || hl_dlight[i].radius <= 0.0)
			goto qmlm_next;

		near_d = 0.0;

		for (j = 0; j < 3; j++)
		{
			d = 0.0;

			if (hl_dlight_mspace[i * 3 + j] < lmins[j])
				d = lmins[j] - hl_dlight_mspace[i * 3 + j];
			else if (hl_dlight_mspace[i * 3 + j] > lmaxs[j])
				d = hl_dlight_mspace[i * 3 + j] - lmaxs[j];

			near_d += d * d;
		}

		if (near_d >= hl_dlight[i].radius * hl_dlight[i].radius)
			goto qmlm_next;

		MemCopy(&hl_dlight_scratch, &hl_dlight[i], sizeof(CHLDlight));
		HLVecCopy(&hl_dlight_mspace[i * 3], hl_dlight_scratch.origin);

		HLMarkLights(map, &hl_dlight_scratch, 1 << i, bm->head_node[0]);

qmlm_next:
	}
}

U0 HLLightAddDynamic(CHLMap *map, CHLFace *f, I64 lm_w, I64 lm_h, F64 time)
{
	CHLDlight	*d;
	CHLPlane		*plane;
	CHLTexInfo	*ti;
	F64			*dorg;
	F64			 impact[3];
	F64			 local_s;
	F64			 local_t;
	F64			 dist;
	F64			 rad;
	F64			 minlight;
	F64			 sd;
	F64			 td;
	F64			 adist;
	I64			 lnum;
	I64			 sx;
	I64			 ty;
	I64			 j;
	I64			 add;
	I64			 lx;

	if (f->plane_num < 0 || f->plane_num >= map->num_planes)
		return;
	if (f->tex_info < 0 || f->tex_info >= map->num_texinfo)
		return;

	plane = &map->planes[f->plane_num];
	ti    = &map->texinfo[f->tex_info];

	for (lnum = 0; lnum < hl_dlight_count; lnum++)
	{
		if (!(f->dlight_bits & (1 << lnum)))
			goto qad_next;

		d = &hl_dlight[lnum];

		if (d->die <= time || d->radius <= 0.0)
			goto qad_next;

		dorg = HLDlightOrigin(lnum);

		dist = HLVecDot(dorg, plane->normal) - plane->dist;
		if (f->side)
			dist = -dist;

		rad = d->radius;
		if (dist < 0.0)
			rad -= -dist;
		else
			rad -= dist;

		minlight = d->min_light;
		if (rad < minlight)
			goto qad_next;

		minlight = rad - minlight;

		for (j = 0; j < 3; j++)
		{
			if (f->side)
				impact[j] = dorg[j] + plane->normal[j] * dist;
			else
				impact[j] = dorg[j] - plane->normal[j] * dist;
		}

		local_s = HLVecDot(impact, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		local_t = HLVecDot(impact, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		for (ty = 0; ty < lm_h; ty++)
		{
			td = local_t - ToF64(ty * 16);
			if (td < 0.0)
				td = -td;

			for (sx = 0; sx < lm_w; sx++)
			{
				sd = local_s - ToF64(sx * 16);
				if (sd < 0.0)
					sd = -sd;

				if (sd > td)
					adist = sd + td * 0.5;
				else
					adist = td + sd * 0.5;

				if (adist < minlight)
				{
					add = ToI64((rad - adist) * 256.0);
					lx  = (ty * lm_w + sx) * HLLIGHT_STRIDE;

					hl_light_acc[lx]     += (add * d->color[0]) / 255;
					hl_light_acc[lx + 1] += (add * d->color[1]) / 255;
					hl_light_acc[lx + 2] += (add * d->color[2]) / 255;
				}
			}
		}

qad_next:
	}
}

U8 *HLLightFaceMap(CHLMap *map, CHLFace *f, I64 lm_w, I64 lm_h, F64 time)
{
	U8	*base;
	I64	 size  = lm_w * lm_h;
	I64	 bytes = size * HLLIGHT_STRIDE;
	I64	 count;
	I64	 acc;
	I64	 scale;
	I64	 i;
	I64	 j;
	Bool dyn;

	if (!map->lightdata)
		return NULL;
	if (f->light_offset < 0)
	{
		if (hl_dlight_any && f->dlight_frame == hl_dlight_frame &&
			f->dlight_bits != 0 && size > 0 && bytes <= HLLIGHT_SCRATCH_B)
		{
			for (i = 0; i < bytes; i++)
				hl_light_acc[i] = 0;

			HLLightAddDynamic(map, f, lm_w, lm_h, time);

			for (i = 0; i < bytes; i++)
			{
				acc = hl_light_acc[i] / HLLIGHT_UNITY;
				if (acc > 255)
					acc = 255;
				if (acc < 0)
					acc = 0;
				hl_light_scratch[i] = acc;
			}

			return hl_light_scratch;
		}

		if (bytes > HLLIGHT_SCRATCH_B)
			return NULL;

		return hl_light_black;
	}

	if (hl_ambient_light < 0)
		hl_ambient_light = 0;
	if (hl_ambient_light > 255)
		hl_ambient_light = 255;

	base = map->lightdata + f->light_offset;

	//styles in use. 255 terminates, and so does any out of range index
	count = 0;
	while (count < 4 && f->styles[count] != 255 &&
		f->styles[count] < HLMAX_LIGHTSTYLES)
		count++;

	if (!count)
		return base;

	if (size <= 0 || bytes > HLLIGHT_SCRATCH_B)
		return base;

	dyn = ToBool(hl_dlight_any && f->dlight_frame == hl_dlight_frame &&
			f->dlight_bits != 0);

	if (!dyn && !hl_ambient_light && count == 1 &&
		hl_lightstyle_value[f->styles[0]] == HLLIGHT_UNITY)
	{
		hl_light_fast++;
		return base;
	}

	if (f->light_offset + count * bytes > map->lightdata_size)
		return base;

	hl_light_slow++;

	for (i = 0; i < bytes; i++)
	{
		//R_BuildLightMap clears to ambient first, in accumulator units
		acc = hl_ambient_light * HLLIGHT_UNITY;

		for (j = 0; j < count; j++)
		{
			scale = hl_lightstyle_value[f->styles[j]];
			acc  += base[j * bytes + i] * scale;
		}

		hl_light_acc[i] = acc;
	}

	if (dyn)
		HLLightAddDynamic(map, f, lm_w, lm_h, time);

	for (i = 0; i < bytes; i++)
	{
		acc = hl_light_acc[i] / HLLIGHT_UNITY;

		if (acc > 255)
		{
			acc = 255;
			hl_light_clamped++;
		}
		if (acc < 0)
			acc = 0;

		hl_light_scratch[i] = acc;
	}

	return hl_light_scratch;
}

I64 HLLightPoint(CHLMap *map, F64 *point)
{
	if (!hl_r_lightpoint)
		return HLLIGHT_FALLBACK;

	F64		  end[3];
	F64		  dl[3];
	F64		  add;
	CHLTrace	  tr;
	CHLFace	 *f;
	CHLTexInfo *ti;
	CHLLeaf	 *leaf;
	CHLLightPtSlot *cs;
	F64		  s_coord;
	F64		 t_coord;
	I64		 ds;
	I64		 dt;
	I64		 lofs;
	I64		 lm_w;
	I64		 lm_h;
	I64		 lm_sz;
	I64		 acc[3];
	I64		 count;
	I64		 taken;
	I64		 scale;
	I64		 key;
	I64		 ch;
	I64		 j;
	I64		 i;
	I64		 node;
	I64		 best = -1;
	I64		 qx;
	I64		 qy;
	I64		 qz;
	I64		 slot;
	Bool		 cache_ok;

	hl_light_pt_style = -1;
	hl_light_pt_key   = -1;

	if (!map || !map->lightdata)
		return HLLIGHT_FALLBACK;

	cache_ok = FALSE;
	if (!hl_dlight_any && point)
	{
		qx = ToI64(Floor(point[0] / ToF64(HLLIGHT_PT_GRID)));
		qy = ToI64(Floor(point[1] / ToF64(HLLIGHT_PT_GRID)));
		qz = ToI64(Floor(point[2] / ToF64(HLLIGHT_PT_GRID)));
		slot = (qx * 73856093 + qy * 19349663 + qz * 83492791) &
			(HLLIGHT_PT_SLOTS - 1);
		cs = &hl_light_pt_cache[slot];
		cache_ok = TRUE;

		if (cs->frame == hl_dlight_frame &&
			cs->qx == qx && cs->qy == qy && cs->qz == qz)
		{
			hl_light_pt_key   = cs->key;
			hl_light_pt_style = cs->style;
			best = cs->val;
			goto qlp_cached;
		}
	}

	hl_rs_lightpoint++;

	HLVecCopy(point, end);
	end[2] -= 2048.0;

	HLTracePoint(map, point, end, &tr);

	if (!tr.hit || tr.fraction == 1.0)
	{
		best = HLLIGHT_FALLBACK;
		goto qlp_store;
	}

	node = HLVisLeafForPoint(map, tr.end_pos);
	if (node <= 0 || node >= map->num_leafs)
	{
		best = HLLIGHT_FALLBACK;
		goto qlp_store;
	}

	leaf = &map->leafs[node];

	for (i = 0; i < leaf->num_marksurfaces; i++)
	{
		f = &map->faces[map->marksurfaces[leaf->first_marksurface + i]];

		if (f->light_offset < 0)
			goto qlp_next;

		ti      = &map->texinfo[f->tex_info];
		s_coord = HLVecDot(tr.end_pos, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		t_coord = HLVecDot(tr.end_pos, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		if (s_coord < 0.0 || t_coord < 0.0)
			goto qlp_next;
		if (s_coord > ToF64(f->extent_s) || t_coord > ToF64(f->extent_t))
			goto qlp_next;

		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;
		ds   = ToI64(s_coord) / 16;
		dt   = ToI64(t_coord) / 16;

		if (ds < 0)   ds = 0;
		if (dt < 0)   dt = 0;
		if (ds >= lm_w) ds = lm_w - 1;
		if (dt >= lm_h) dt = lm_h - 1;

		lm_sz = lm_w * lm_h;

		count = 0;
		while (count < 4 && f->styles[count] != 255 &&
			f->styles[count] < HLMAX_LIGHTSTYLES)
			count++;

		for (ch = 0; ch < HLLIGHT_STRIDE; ch++)
			acc[ch] = hl_ambient_light * HLLIGHT_UNITY;

		key   = 0;
		taken = 0;

		for (j = 0; j < count; j++)
		{
			lofs = f->light_offset +
				(j * lm_sz + dt * lm_w + ds) * HLLIGHT_STRIDE;

			if (lofs + HLLIGHT_STRIDE > map->lightdata_size)
				break;

			scale = hl_lightstyle_value[f->styles[j]];
			key   = key * 31 + scale;

			for (ch = 0; ch < HLLIGHT_STRIDE; ch++)
				acc[ch] += map->lightdata[lofs + ch] * scale;

			taken++;
		}

		if (count < 1)
		{
			lofs = f->light_offset + (dt * lm_w + ds) * HLLIGHT_STRIDE;

			if (lofs + HLLIGHT_STRIDE > map->lightdata_size)
				goto qlp_next;

			for (ch = 0; ch < HLLIGHT_STRIDE; ch++)
				acc[ch] = map->lightdata[lofs + ch] * HLLIGHT_UNITY;

			taken = 1;
		}

		if (taken < 1)
			goto qlp_next;

		for (ch = 0; ch < HLLIGHT_STRIDE; ch++)
		{
			//divide by what a steady style resolves to, not 256
			acc[ch] = acc[ch] / HLLIGHT_UNITY;

			if (acc[ch] > 255)
				acc[ch] = 255;
			if (acc[ch] < 0)
				acc[ch] = 0;
		}

		best = (acc[0] * 77 + acc[1] * 151 + acc[2] * 28) >> 8;

		hl_light_pt_key = key;

		if (f->styles[0] < HLMAX_LIGHTSTYLES)
			hl_light_pt_style = f->styles[0];

		break;

qlp_next:
	}

	if (best < 0)
		best = HLLIGHT_FALLBACK;

	if (!hl_r_dynamic)
		goto qlp_no_dlights;

	for (i = 0; i < hl_dlight_count; i++)
	{
		if (hl_dlight[i].die <= hl_light_time || hl_dlight[i].radius <= 0.0)
			goto qlp_dl_next;

		HLVecSub(point, hl_dlight[i].origin, dl);
		add = hl_dlight[i].radius - HLVecLength(dl);

		if (add > 0.0)
			best += ToI64(add);

qlp_dl_next:
	}

qlp_no_dlights:

	if (best > 128)
		best = 128;

	if (best < 24)
		best = 24;

qlp_store:
	if (cache_ok)
	{
		cs->qx    = qx;
		cs->qy    = qy;
		cs->qz    = qz;
		cs->frame = hl_dlight_frame;
		cs->val   = best;
		cs->key   = hl_light_pt_key;
		cs->style = hl_light_pt_style;
	}

qlp_cached:
	return best;
}

CHLCanvas *HLDrawNew(I64 w, I64 h)
{
	CHLCanvas *c = CAlloc(sizeof(CHLCanvas));

	if (w < 64)		w = 64;
	if (h < 64)		h = 64;
	if (w > 1920)	w = 1920;
	if (h > 1200)	h = 1200;

	c->width  = w;
	c->height = h;

	c->vx = 0;
	c->vy = 0;
	c->vw = w;
	c->vh = h;
	c->pixels = CAlloc(w * h * sizeof(U32));
	c->depth  = CAlloc(w * h * sizeof(F64));

	if (!c->pixels || !c->depth)
	{
		if (c->pixels)	Free(c->pixels);
		if (c->depth)	Free(c->depth);
		Free(c);
		return NULL;
	}

	return c;
}

U0 HLDrawFree(CHLCanvas *c)
{
	if (!c)
		return;

	if (c->pixels)	Free(c->pixels);
	if (c->depth)	Free(c->depth);

	Free(c);
}

U0 HLDrawClear(CHLCanvas *c, I64 color_index)
{
	U32	 fill = HLPalColor(color_index);
	U32	*row;
	F64	*zrow;
	I64	 n;
	I64	 i;
	I64	 x;
	I64	 y;
	I64	 x0;
	I64	 y0;
	I64	 x1;
	I64	 y1;
	I64	 t_clear;

	t_clear = TSCGet;

	x0 = c->vx;
	y0 = c->vy;
	x1 = c->vx + c->vw;
	y1 = c->vy + c->vh;

	if (x0 < 0)			x0 = 0;
	if (y0 < 0)			y0 = 0;
	if (x1 > c->width)	x1 = c->width;
	if (y1 > c->height)	y1 = c->height;

	if (x0 <= 0 && y0 <= 0 && x1 >= c->width && y1 >= c->height)
	{
		n = c->width * c->height;

		//palette index 0 is black (0x000000) - byte MemSet beats a U32 loop
		if (!fill)
			MemSet(c->pixels, 0, n * sizeof(U32));
		else
		{
			for (i = 0; i < n; i++)
				c->pixels[i] = fill;
		}

		MemSet(c->depth, 0, n * sizeof(F64));
	}
	else
	{
		for (y = y0; y < y1; y++)
		{
			row  = c->pixels + y * c->width;
			zrow = c->depth  + y * c->width;

			for (x = x0; x < x1; x++)
			{
				row[x]  = fill;
				zrow[x] = 0.0;
			}
		}
	}

	c->faces_drawn = 0;
	c->spans_drawn = 0;

	if (hl_rs_enable)
	{
		"--- r_speeds %d x %d ---\n", c->width, c->height;
		HLRSpeedsPrint;
	}

	HLRSpeedsReset;

	hl_tsc_clear += TSCGet - t_clear;

	hl_draw_frame++;
}

U0 HLDrawSetViewRect(CHLCanvas *c, F64 viewsize, I64 sbar_h)
{
	F64 size;
	I64 avail;

	if (viewsize < 30.0)	viewsize = 30.0;
	if (viewsize > 120.0)	viewsize = 120.0;

	size = viewsize;
	if (size > 100.0)
		size = 100.0;
	size = size / 100.0;

	avail = c->height - sbar_h;

	c->vw = ToI64(ToF64(c->width) * size);
	c->vh = ToI64(ToF64(c->height) * size);

	if (c->vw < 96)
		c->vw = 96;
	if (c->vh > avail)
		c->vh = avail;
	if (c->vh < 64)
		c->vh = 64;

	c->vx = (c->width - c->vw) / 2;
	c->vy = (avail - c->vh) / 2;

	if (c->vx < 0)	c->vx = 0;
	if (c->vy < 0)	c->vy = 0;
}

F64  hl_view_org[3];
F64  hl_view_fwd[3];
Bool hl_view_basis = FALSE;

hl_view_basis = FALSE;

U0 HLDrawSetView(CHLCanvas *c, F64 *origin, F64 *angles, F64 fov_x,
	Bool record = TRUE)
{
	F64 half = fov_x * 0.5 * HLDEG2RAD;

	HLVecCopy(origin, c->origin);
	HLAngleVectors(angles, c->forward, c->right, c->up);

	if (record)
	{
		HLVecCopy(c->origin, hl_view_org);
		HLVecCopy(c->forward, hl_view_fwd);
		hl_view_basis = TRUE;
	}

	c->center_x = ToF64(c->vx) + ToF64(c->vw) * 0.5;
	c->center_y = ToF64(c->vy) + ToF64(c->vh) * 0.5;
	c->x_scale  = ToF64(c->vw) * 0.5 / Tan(half);
	c->y_scale  = c->x_scale;
}

F64 HLDrawFovY(F64 fov_x, I64 width, I64 height)
{//matching vertical fov for square pixels, in degrees
	F64 half = fov_x * 0.5 * HLDEG2RAD;
	F64 t    = Tan(half) * ToF64(height) / ToF64(width);

	return ATan(t) * 2.0 / HLDEG2RAD;
}

I64 HLDrawClipNear(CHLPolyVert *in, I64 count, CHLPolyVert *out)
{
	I64 i;
	I64 j;
	I64 n = 0;
	F64 d1;
	F64 d2;
	F64 frac;

	for (i = 0; i < count; i++)
	{
		j  = (i + 1) % count;
		d1 = in[i].cam[2] - HLNEAR_CLIP;
		d2 = in[j].cam[2] - HLNEAR_CLIP;

		if (d1 >= 0.0)
		{
			if (n < HLMAX_POLY_VERTS)
			{
				MemCopy(&out[n], &in[i], sizeof(CHLPolyVert));
				n++;
			}
		}

		if ((d1 >= 0.0) != (d2 >= 0.0))
		{
			if (n < HLMAX_POLY_VERTS && (d1 - d2) != 0.0)
			{
				frac = d1 / (d1 - d2);
				out[n].cam[0] = in[i].cam[0] + frac * (in[j].cam[0] - in[i].cam[0]);
				out[n].cam[1] = in[i].cam[1] + frac * (in[j].cam[1] - in[i].cam[1]);
				out[n].cam[2] = in[i].cam[2] + frac * (in[j].cam[2] - in[i].cam[2]);
				out[n].s      = in[i].s + frac * (in[j].s - in[i].s);
				out[n].t      = in[i].t + frac * (in[j].t - in[i].t);
				out[n].light  = in[i].light + frac * (in[j].light - in[i].light);
				n++;
			}
		}
	}

	return n;
}

U0 HLLightBilinear(U8 *lightmap, I64 lm_w, I64 lm_h, F64 ls, F64 lt, I64 *out)
{
	I64 lx0, ly0, lx1, ly1;
	I64 ch;
	F64 fs, ft;
	F64 top, bot;

	if (ls < 0.0)	ls = 0.0;
	if (lt < 0.0)	lt = 0.0;

	lx0 = ToI64(Floor(ls));
	ly0 = ToI64(Floor(lt));
	fs  = ls - ToF64(lx0);
	ft  = lt - ToF64(ly0);

	lx1 = lx0 + 1;
	ly1 = ly0 + 1;

	lx0 = ClampI64(lx0, 0, lm_w - 1);
	lx1 = ClampI64(lx1, 0, lm_w - 1);
	ly0 = ClampI64(ly0, 0, lm_h - 1);
	ly1 = ClampI64(ly1, 0, lm_h - 1);

	for (ch = 0; ch < HLLIGHT_STRIDE; ch++)
	{
		top = ToF64(lightmap[(ly0 * lm_w + lx0) * HLLIGHT_STRIDE + ch]) * (1.0 - fs) +
			  ToF64(lightmap[(ly0 * lm_w + lx1) * HLLIGHT_STRIDE + ch]) * fs;
		bot = ToF64(lightmap[(ly1 * lm_w + lx0) * HLLIGHT_STRIDE + ch]) * (1.0 - fs) +
			  ToF64(lightmap[(ly1 * lm_w + lx1) * HLLIGHT_STRIDE + ch]) * fs;

		out[ch] = ClampI64(ToI64(top * (1.0 - ft) + bot * ft), 0, 255);
	}
}

I64 HLTextureAnimation(CHLMap *map, I64 miptex, I64 frame, F64 time)
{
	CHLTexture	*base;
	I64			 idx;
	I64			 rel;
	I64			 count;

	if (miptex < 0 || miptex >= map->num_textures)
		return -1;

	idx  = miptex;
	base = &map->textures[idx];

	if (frame && base->alt_anims >= 0 &&
		base->alt_anims < map->num_textures)
	{
		idx  = base->alt_anims;
		base = &map->textures[idx];
	}

	if (!base->anim_total)
		return idx;

	rel = ToI64(time * 10.0) % base->anim_total;
	if (rel < 0)
		rel += base->anim_total;

	count = 0;
	while (base->anim_min > rel || base->anim_max <= rel)
	{
		idx = base->anim_next;
		if (idx < 0 || idx >= map->num_textures)
			break;

		base = &map->textures[idx];

		count++;
		if (count > 100)
			break;
	}

	return idx;
}


#define HLSKY_FACES		6
#define HLSKY_RT			0
#define HLSKY_LF			1
#define HLSKY_BK			2
#define HLSKY_FT			3
#define HLSKY_UP			4
#define HLSKY_DN			5

#define HLSKY_DEFAULT	"desert"

U32	*hl_sky_pix[HLSKY_FACES];	//0x00RRGGBB, one owned block per face
I64	 hl_sky_w[HLSKY_FACES];
I64	 hl_sky_h[HLSKY_FACES];
U8	 hl_sky_name[64];
U32	 hl_sky_solid	= 0;
Bool hl_sky_ready	= FALSE;
I64	 hl_sky_loaded	= 0;			//faces of the set that decoded, 0..6

//movevars_t sky fields, pm_movevars.h:37-42.
F64	 hl_sky_vec[3];
Bool hl_sky_color_set	= FALSE;
Bool hl_sky_vec_set		= FALSE;

CHLMap	*hl_sky_map = NULL;
U8		 hl_sky_map_name[96];

F64 hl_warp_amount = 0.0;
F64 hl_warp_time   = 0.0;

U8 *HLSkySuffix(I64 face)
{
	if (face == HLSKY_RT)	return "rt";
	if (face == HLSKY_LF)	return "lf";
	if (face == HLSKY_BK)	return "bk";
	if (face == HLSKY_FT)	return "ft";
	if (face == HLSKY_UP)	return "up";

	return "dn";
}

U0 HLSkyFree()
{
	I64 i;

	for (i = 0; i < HLSKY_FACES; i++)
	{
		if (hl_sky_pix[i])
			Free(hl_sky_pix[i]);

		hl_sky_pix[i] = NULL;
		hl_sky_w[i]   = 0;
		hl_sky_h[i]   = 0;
	}

	hl_sky_ready   = FALSE;
	hl_sky_loaded  = 0;
	hl_sky_name[0] = 0;
}

U0 HLSkyInit()
{
	I64 i;

	for (i = 0; i < HLSKY_FACES; i++)
	{
		hl_sky_pix[i] = NULL;
		hl_sky_w[i]   = 0;
		hl_sky_h[i]   = 0;
	}

	hl_sky_ready       = FALSE;
	hl_sky_loaded      = 0;
	hl_sky_name[0]     = 0;
	hl_sky_solid       = 0;
	hl_sky_map         = NULL;
	hl_sky_map_name[0] = 0;

	hl_sky_color_set = FALSE;
	hl_sky_vec_set   = FALSE;
	hl_sky_vec[0]    = 0.0;
	hl_sky_vec[1]    = 0.0;
	hl_sky_vec[2]    = -1.0;
}


#define HLSURF_SLOTS			32768
#define HLSURF_BUDGET		335544320	//320MB of lit surfaces
//4x the quake budget: surfaces are 32bpp now, and HL maps are bigger

#define HLSURF_TRANSPARENT	0xFF000000

class CHLSurfCache
{
	U32	*pixels;		//0x00RRGGBB, lighting already folded in
	I64	 bytes;
	I64	 w;
	I64	 h;
	I64	 mip;
	I64	 face;			//owning face index, -1 when free
	I64	 frame;
	I64	 light_key;
	I64	 texture;
};

CHLSurfCache	 hl_surf[HLSURF_SLOTS];
I64			*hl_face_surf	= NULL;		//face index -> slot, -1 for none
I64			 hl_face_surf_n	= 0;
CHLMap		*hl_surf_map		= NULL;

U8			 hl_surf_map_name[96];
U8			*hl_surf_map_raw		= NULL;
I64			 hl_surf_map_raw_size	= 0;
CHLFace		*hl_surf_map_faces	= NULL;
I64			 hl_surf_map_nfaces	= 0;
U8			*hl_surf_map_light	= NULL;
I64			 hl_surf_bytes	= 0;
I64			 hl_surf_frame	= 0;
I64			 hl_surf_builds	= 0;
I64			 hl_surf_hits	= 0;

U0 HLSurfCacheInit()
{
	I64 i;

	HLSkyInit;

	for (i = 0; i < HLSURF_SLOTS; i++)
	{
		hl_surf[i].pixels    = NULL;
		hl_surf[i].bytes     = 0;
		hl_surf[i].w         = 0;
		hl_surf[i].h         = 0;
		hl_surf[i].face      = -1;
		hl_surf[i].frame     = -1;
		hl_surf[i].mip       = -1;
		hl_surf[i].light_key = -1;
		hl_surf[i].texture   = -1;
	}

	hl_face_surf   = NULL;
	hl_face_surf_n = 0;
	hl_surf_map    = NULL;
	hl_surf_bytes  = 0;

	hl_surf_map_name[0]   = 0;
	hl_surf_map_raw       = NULL;
	hl_surf_map_raw_size  = 0;
	hl_surf_map_faces     = NULL;
	hl_surf_map_nfaces    = 0;
	hl_surf_map_light     = NULL;
	hl_surf_frame  = 0;
	hl_surf_builds = 0;
	hl_surf_hits   = 0;
}

U0 HLSurfCacheFlush()
{
	I64 i;

	for (i = 0; i < HLSURF_SLOTS; i++)
	{
		if (hl_surf[i].pixels)
			Free(hl_surf[i].pixels);

		hl_surf[i].pixels    = NULL;
		hl_surf[i].bytes     = 0;
		hl_surf[i].face      = -1;
		hl_surf[i].frame     = -1;
		hl_surf[i].mip       = -1;
		hl_surf[i].light_key = -1;
		hl_surf[i].texture   = -1;
	}

	if (hl_face_surf)
	{
		for (i = 0; i < hl_face_surf_n; i++)
			hl_face_surf[i] = -1;
	}

	hl_surf_bytes = 0;
}

U0 HLSurfCacheSetMap(CHLMap *map)
{
	Bool same;

	same = FALSE;

	if (map && map == hl_surf_map && map->raw == hl_surf_map_raw &&
		map->raw_size == hl_surf_map_raw_size &&
		map->faces == hl_surf_map_faces &&
		map->num_faces == hl_surf_map_nfaces &&
		map->lightdata == hl_surf_map_light &&
		hl_face_surf && hl_face_surf_n == map->num_faces &&
		!StrCompare(hl_surf_map_name, hl_map_name))
		same = TRUE;

	if (same)
		return;

	HLSurfCacheFlush;

	if (hl_face_surf)
	{
		Free(hl_face_surf);
		hl_face_surf   = NULL;
		hl_face_surf_n = 0;
	}

	hl_surf_map = map;

	if (map && map->num_faces > 0)
	{
		hl_face_surf_n = map->num_faces;
		hl_face_surf   = MAlloc(hl_face_surf_n * sizeof(I64));
		MemSet(hl_face_surf, 0xFF, hl_face_surf_n * sizeof(I64));
	}

	if (map)
	{
		hl_surf_map_raw      = map->raw;
		hl_surf_map_raw_size = map->raw_size;
		hl_surf_map_faces    = map->faces;
		hl_surf_map_nfaces   = map->num_faces;
		hl_surf_map_light    = map->lightdata;
		HLStrCopy(hl_surf_map_name, hl_map_name, 96);
	}
	else
	{
		hl_surf_map_raw      = NULL;
		hl_surf_map_raw_size = 0;
		hl_surf_map_faces    = NULL;
		hl_surf_map_nfaces   = 0;
		hl_surf_map_light    = NULL;
		hl_surf_map_name[0]  = 0;
	}
}

Bool HLSurfCacheRelease()
{
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < HLSURF_SLOTS; i++)
	{
		if (!hl_surf[i].pixels)
			goto qsr_next;

		if (hl_surf[i].frame == hl_surf_frame)
			goto qsr_next;

		if (hl_surf[i].frame < best_frame)
		{
			best_frame = hl_surf[i].frame;
			best       = i;
		}

qsr_next:
	}

	if (best < 0)
		return FALSE;

	if (hl_face_surf && hl_surf[best].face >= 0 &&
		hl_surf[best].face < hl_face_surf_n)
		hl_face_surf[hl_surf[best].face] = -1;

	hl_surf_bytes -= hl_surf[best].bytes;
	hl_rs_surf_evict++;
	Free(hl_surf[best].pixels);

	hl_surf[best].pixels    = NULL;
	hl_surf[best].bytes     = 0;
	hl_surf[best].face      = -1;
	hl_surf[best].frame     = -1;
	hl_surf[best].mip       = -1;
	hl_surf[best].light_key = -1;

	return TRUE;
}

I64 HLSurfCacheEvict()
{
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < HLSURF_SLOTS; i++)
	{
		if (hl_surf[i].face < 0)
			return i;

		if (hl_surf[i].frame < best_frame)
		{
			best_frame = hl_surf[i].frame;
			best       = i;
		}
	}

	if (best < 0)
		return -1;

	if (hl_surf[best].frame == hl_surf_frame)
		return -1;

	if (hl_face_surf && hl_surf[best].face >= 0 &&
		hl_surf[best].face < hl_face_surf_n)
		hl_face_surf[hl_surf[best].face] = -1;

	hl_surf[best].face = -1;

	hl_rs_surf_evict++;

	return best;
}

I64 HLTexWrap(I64 v, I64 n)
{
	if (n < 1)
		return 0;

	if (!(n & (n - 1)))
		return v & (n - 1);

	v = v % n;
	if (v < 0)
		v += n;

	return v;
}

#define HLDLIGHT_KEY_QUANT	2.0

I64 HLSurfLightKey(CHLFace *f)
{
	CHLDlight	*d;
	F64			*o;
	I64			 key = 0;
	I64			 j;

	for (j = 0; j < 4; j++)
	{
		if (f->styles[j] == 255)
			break;
		if (f->styles[j] < HLMAX_LIGHTSTYLES)
			key = key * 31 + hl_lightstyle_value[f->styles[j]];
	}

	key = key * 31 + hl_ambient_light;

	if (f->dlight_frame == hl_dlight_frame && f->dlight_bits)
	{
		key = key * 31 + f->dlight_bits;

		for (j = 0; j < hl_dlight_count && j < HLMAX_DLIGHTS; j++)
		{
			if (!(f->dlight_bits & (1 << j)))
				goto qslk_next;

			d = &hl_dlight[j];

			o = HLDlightOrigin(j);

			key = key * 31 +
				ToI64(o[0] / HLDLIGHT_KEY_QUANT);
			key = key * 31 +
				ToI64(o[1] / HLDLIGHT_KEY_QUANT);
			key = key * 31 +
				ToI64(o[2] / HLDLIGHT_KEY_QUANT);
			key = key * 31 +
				ToI64(d->radius / HLDLIGHT_KEY_QUANT);
			key = key * 31 + d->color[0];
			key = key * 31 + d->color[1];
			key = key * 31 + d->color[2];

qslk_next:
		}
	}

	return key;
}

I64 HLSurfCacheMipFor(CHLMap *map, I64 face_index)
{
	I64 slot;

	if (map != hl_surf_map || !hl_face_surf)
		return -1;
	if (face_index < 0 || face_index >= hl_face_surf_n)
		return -1;

	slot = hl_face_surf[face_index];
	if (slot < 0 || slot >= HLSURF_SLOTS)
		return -1;

	if (hl_surf[slot].face != face_index)
		return -1;

	return hl_surf[slot].mip;
}

I64 HLMipForRatio(F64 ratio, I64 prev)
{
	I64 mip;

	if (ratio < 1.0)
		mip = 0;
	else if (ratio < 2.5)
		mip = 1;
	else if (ratio < 5.0)
		mip = 2;
	else
		mip = 3;

	if (prev < 0 || prev == mip)
		return mip;

	if (prev == 0 && mip == 1 && ratio < 1.15)	return 0;
	if (prev == 1 && mip == 2 && ratio < 2.875)	return 1;
	if (prev == 2 && mip == 3 && ratio < 5.75)	return 2;

	if (prev == 1 && mip == 0 && ratio > 0.85)	return 1;
	if (prev == 2 && mip == 1 && ratio > 2.125)	return 2;
	if (prev == 3 && mip == 2 && ratio > 4.25)	return 3;

	return mip;
}

U32 *HLSurfCacheGet(CHLMap *map, CHLFace *f, I64 face_index, CHLTexture *tex,
	I64 mip, U8 *lightmap, I64 lm_w, I64 lm_h, I64 *_cw, I64 *_ch,
	I64 tex_key = 0)
{
	CHLSurfCache	*sc;
	U8			*texels;
	U8			*pal;
	U32			*out;
	I64			 slot;
	I64			 cw, ch;
	I64			 tw, th;
	I64			 need;
	I64			 key;
	I64			 u, v;
	I64			 tx, ty;
	I64			 s0, t0;
	I64			 mins_s_i, mins_t_i;
	I64			 texel;
	I64			 lrgb[3];
	I64			 r, g, b;

	if (map != hl_surf_map)
		return NULL;

	if (!hl_face_surf || face_index < 0 || face_index >= hl_face_surf_n)
		return NULL;

	texels = tex->texels[mip];
	pal    = tex->palette;
	tw     = tex->width >> mip;
	th     = tex->height >> mip;

	if (!texels || !pal || tw <= 0 || th <= 0)
		return NULL;

	cw = (f->extent_s >> mip) + 1;
	ch = (f->extent_t >> mip) + 1;

	if (cw <= 0 || ch <= 0)
		return NULL;

	need = cw * ch * sizeof(U32);
	if (need > HLSURF_BUDGET / 4)
		return NULL;

	key  = HLSurfLightKey(f);
	slot = hl_face_surf[face_index];

	if (slot >= 0 && slot < HLSURF_SLOTS)
	{
		sc = &hl_surf[slot];

		if (sc->face == face_index && sc->mip == mip &&
			sc->light_key == key && sc->texture == tex_key && sc->pixels)
		{
			sc->frame = hl_surf_frame;
			*_cw = sc->w;
			*_ch = sc->h;
			hl_surf_hits++;
			hl_rs_surf_hit++;
			return sc->pixels;
		}
	}
	else
	{
		slot = HLSurfCacheEvict;
		if (slot < 0)
			return NULL;
	}

	sc = &hl_surf[slot];

	if (sc->bytes < need)
	{
		while (hl_surf_bytes + need - sc->bytes > HLSURF_BUDGET)
		{
			if (!HLSurfCacheRelease)
				break;
		}

		if (hl_surf_bytes + need - sc->bytes > HLSURF_BUDGET)
			return NULL;

		if (sc->pixels)
		{
			hl_surf_bytes -= sc->bytes;
			Free(sc->pixels);
			sc->pixels = NULL;
			sc->bytes  = 0;
		}

		sc->pixels = MAlloc(need);
		if (!sc->pixels)
		{
			sc->bytes = 0;
			return NULL;
		}

		sc->bytes = need;
		hl_surf_bytes += need;
	}

	out      = sc->pixels;
	mins_s_i = ToI64(f->mins_s);
	mins_t_i = ToI64(f->mins_t);

	for (v = 0; v < ch; v++)
	{
		t0 = v << mip;
		ty = HLTexWrap((mins_t_i + t0) >> mip, th);

		for (u = 0; u < cw; u++)
		{
			s0 = u << mip;
			tx = HLTexWrap((mins_s_i + s0) >> mip, tw);

			texel = texels[ty * tw + tx];

			if (tex->is_masked && texel == 255)
			{
				out[v * cw + u] = HLSURF_TRANSPARENT;
				goto qsc_next_texel;
			}

			if (tex->is_light || !lightmap || lm_w <= 0 || lm_h <= 0)
			{
				lrgb[0] = 255;
				lrgb[1] = 255;
				lrgb[2] = 255;
			}
			else
				HLLightBilinear(lightmap, lm_w, lm_h,
					ToF64(s0) / 16.0, ToF64(t0) / 16.0, lrgb);

			r = (pal[texel * 3]     * lrgb[0]) / 255;
			g = (pal[texel * 3 + 1] * lrgb[1]) / 255;
			b = (pal[texel * 3 + 2] * lrgb[2]) / 255;

			out[v * cw + u] = (r << 16) | (g << 8) | b;

qsc_next_texel:
		}
	}

	sc->w         = cw;
	sc->h         = ch;
	sc->mip       = mip;
	sc->face      = face_index;
	sc->frame     = hl_surf_frame;
	sc->light_key = key;
	sc->texture   = tex_key;

	hl_face_surf[face_index] = slot;
	hl_surf_builds++;

	hl_rs_surf_build++;
	hl_rs_surf_texels += cw * ch;

	*_cw = cw;
	*_ch = ch;

	return out;
}

#define HLRENDER_NORMAL			0
#define HLRENDER_TRANSCOLOR		1
#define HLRENDER_TRANSTEXTURE	2
#define HLRENDER_GLOW			3
#define HLRENDER_TRANSALPHA		4
#define HLRENDER_TRANSADD		5

Bool HLRenderTranslucent(I64 mode)
{
	return ToBool(mode == HLRENDER_TRANSTEXTURE || mode == HLRENDER_TRANSADD);
}

U0 HLDrawSpan(CHLCanvas *c, I64 y, I64 x1, I64 x2,
	F64 iz1, F64 soz1, F64 toz1, F64 iz2, F64 soz2, F64 toz2,
	F64 light1, F64 light2,
	CHLTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U32 *surf = NULL, I64 sw = 0, I64 sh = 0,
	I64 blend = 0, I64 amt = 255)
{
	U32	*row;
	U32	*surf32 = surf;
	U8	*texels;
	U8	*pal;
	F64	*zrow;
	F64	 span;
	F64	 d_iz;
	F64	 d_soz;
	F64	 d_toz;
	F64	 d_lit;
	F64	 iz;
	F64	 soz;
	F64	 toz;
	F64	 lit;
	F64	 z;
	F64	 s;
	F64	 t;
	F64	 ws;
	F64	 wt;
	Bool	 turb;
	I64	 x;
	I64	 tw;
	I64	 th;
	I64	 tx;
	I64	 ty;
	F64	 lightv[3];
	F64	 dlight[3];
	I64	 lstart[3];
	I64	 lend[3];
	I64	 ch;
	I64	 texel;
	U32	 surf_texel;
	U32	 dst;
	I64	 r;
	I64	 g;
	I64	 b;
	I64	 xe;
	I64	 n;
	I64	 mins_s_i;
	I64	 mins_t_i;
	F64	 iz_e;
	F64	 soz_e;
	F64	 toz_e;
	F64	 lit_e;
	F64	 s_e;
	F64	 t_e;
	F64	 ds;
	F64	 dt;
	Bool clamp_tex;

	if (y < c->vy || y >= c->vy + c->vh)
		return;

	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz  = (iz2 - iz1) / span;
	d_soz = (soz2 - soz1) / span;
	d_toz = (toz2 - toz1) / span;
	d_lit = (light2 - light1) / span;

	if (x1 < c->vx)
	{
		iz1    += d_iz * ToF64(c->vx - x1);
		soz1   += d_soz * ToF64(c->vx - x1);
		toz1   += d_toz * ToF64(c->vx - x1);
		light1 += d_lit * ToF64(c->vx - x1);
		x1 = c->vx;
	}

	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;

	if (x1 >= x2)
		return;

	hl_rs_spans++;
	hl_rs_span_px += x2 - x1;

	if (mip < 0)
		mip = 0;
	if (mip > 3)
		mip = 3;

	while (mip > 0 && !tex->texels[mip])
		mip--;

	if (surf && sw > 0 && sh > 0)
	{
		texels = NULL;			//the 32bpp surface is read through surf32
		pal    = NULL;
		tw     = sw;
		th     = sh;
	}
	else
	{
		surf32 = NULL;
		texels = tex->texels[mip];
		pal    = tex->palette;
		tw     = tex->width >> mip;
		th     = tex->height >> mip;

		if (!pal)
			return;
	}

	if (tw <= 0 || th <= 0 || (!texels && !surf32))
		return;

	mins_s_i = ToI64(mins_s);
	mins_t_i = ToI64(mins_t);

	clamp_tex = tex->clamp;

	//turb never mips - the warp is defined in level 0 texels
	turb = tex->is_turb;
	if (turb)
		mip = 0;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;

	iz  = iz1;
	soz = soz1;
	toz = toz1;
	lit = light1;

	if (iz != 0.0)
	{
		z = 1.0 / iz;
		s = soz * z;
		t = toz * z;
	}
	else
	{
		s = 0.0;
		t = 0.0;
	}

	x = x1;

	while (x < x2)
	{
		xe = x + HLSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		iz_e  = iz + d_iz * ToF64(n);
		soz_e = soz + d_soz * ToF64(n);
		toz_e = toz + d_toz * ToF64(n);
		lit_e = lit + d_lit * ToF64(n);

		if (iz_e != 0.0)
		{
			z   = 1.0 / iz_e;
			s_e = soz_e * z;
			t_e = toz_e * z;
		}
		else
		{
			s_e = s;
			t_e = t;
		}

		ds = (s_e - s) / ToF64(n);
		dt = (t_e - t) / ToF64(n);

		if (lightmap && lm_w > 0 && lm_h > 0)
		{
			HLLightBilinear(lightmap, lm_w, lm_h,
				(s - mins_s) / 16.0, (t - mins_t) / 16.0, lstart);
			HLLightBilinear(lightmap, lm_w, lm_h,
				(s_e - mins_s) / 16.0, (t_e - mins_t) / 16.0, lend);

			for (ch = 0; ch < 3; ch++)
			{
				lightv[ch]  = ToF64(lstart[ch]);
				dlight[ch]  = ToF64(lend[ch] - lstart[ch]) / ToF64(n);
			}
		}
		else
		{
			if (lit == 0.0 && lit_e == 0.0)
			{
				for (ch = 0; ch < 3; ch++)
				{
					lightv[ch] = ToF64(flat_light);
					dlight[ch] = 0.0;
				}
			}
			else
			{
				for (ch = 0; ch < 3; ch++)
				{
					lightv[ch] = lit;
					dlight[ch] = (lit_e - lit) / ToF64(n);
				}
			}
		}

		if (hl_r_spanfast && surf32 && !blend)
		{
			while (x < xe)
			{
				if (iz > zrow[x])
				{
					tx = ClampI64((ToI64(Floor(s)) - mins_s_i) >> mip,
						0, tw - 1);
					ty = ClampI64((ToI64(Floor(t)) - mins_t_i) >> mip,
						0, th - 1);
					surf_texel = surf32[ty * tw + tx];

					if (surf_texel != HLSURF_TRANSPARENT)
					{
						row[x]  = surf_texel;
						zrow[x] = iz;
					}
				}

				s  += ds;
				t  += dt;
				iz += d_iz;
				x++;
			}
		}
		else while (x < xe)
		{
			if (iz > zrow[x])
			{
			if (surf32)
			{
				tx = ClampI64((ToI64(Floor(s)) - mins_s_i) >> mip, 0, tw - 1);
				ty = ClampI64((ToI64(Floor(t)) - mins_t_i) >> mip, 0, th - 1);
			}
			else if (turb)
			{
				ws = s + hl_turb_table[(ToI64(Floor(t)) + hl_turb_phase) &
						(HLTURB_CYCLE - 1)];
				wt = t + hl_turb_table[(ToI64(Floor(s)) + hl_turb_phase) &
						(HLTURB_CYCLE - 1)];

				tx = ToI64(Floor(ws)) >> mip;
				ty = ToI64(Floor(wt)) >> mip;
			}
			else
			{
				tx = ToI64(Floor(s)) >> mip;
				ty = ToI64(Floor(t)) >> mip;
			}

			if (surf32)
			{
			}
			else if (clamp_tex)
			{
				tx = ClampI64(tx, 0, tw - 1);
				ty = ClampI64(ty, 0, th - 1);
			}
			else
			{
				tx = HLTexWrap(tx, tw);
				ty = HLTexWrap(ty, th);
			}

			if (surf32)
			{
				surf_texel = surf32[ty * tw + tx];

				if (surf_texel == HLSURF_TRANSPARENT)
					goto qds_skip_texel;

				if (blend)
				{
					r = (surf_texel >> 16) & 255;
					g = (surf_texel >> 8) & 255;
					b = surf_texel & 255;
					goto qds_blend;
				}

				row[x] = surf_texel;
			}
			else
			{
				texel = texels[ty * tw + tx];

				if (tex->is_masked && texel == 255)
					goto qds_skip_texel;

				if (tex->is_light)
				{
					r = pal[texel * 3];
					g = pal[texel * 3 + 1];
					b = pal[texel * 3 + 2];
				}
				else
				{
					r = (pal[texel * 3] *
							ClampI64(ToI64(lightv[0]), 0, 255)) / 255;
					g = (pal[texel * 3 + 1] *
							ClampI64(ToI64(lightv[1]), 0, 255)) / 255;
					b = (pal[texel * 3 + 2] *
							ClampI64(ToI64(lightv[2]), 0, 255)) / 255;
				}

				if (blend)
					goto qds_blend;

				row[x] = (r << 16) | (g << 8) | b;
			}

			zrow[x] = iz;
			goto qds_skip_texel;

qds_blend:
			dst = row[x];

			if (blend == HLRENDER_TRANSADD)
			{
				r = ((dst >> 16) & 255) + (r * amt) / 255;
				g = ((dst >> 8) & 255) + (g * amt) / 255;
				b = (dst & 255) + (b * amt) / 255;

				if (r > 255)	r = 255;
				if (g > 255)	g = 255;
				if (b > 255)	b = 255;
			}
			else
			{
				r = (r * amt + ((dst >> 16) & 255) * (255 - amt)) / 255;
				g = (g * amt + ((dst >> 8) & 255) * (255 - amt)) / 255;
				b = (b * amt + (dst & 255) * (255 - amt)) / 255;
			}

			row[x] = (r << 16) | (g << 8) | b;

qds_skip_texel:
			}

			s          += ds;
			t          += dt;
			lightv[0]  += dlight[0];
			lightv[1]  += dlight[1];
			lightv[2]  += dlight[2];
			iz         += d_iz;
			x++;
		}

		iz  = iz_e;
		soz = soz_e;
		toz = toz_e;
		lit = lit_e;
		s   = s_e;
		t   = t_e;
	}

	c->spans_drawn++;
}

U0 HLDrawPolygon(CHLCanvas *c, CHLScreenVert *v, I64 count,
	CHLTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U32 *surf = NULL, I64 sw = 0, I64 sh = 0,
	I64 blend = 0, I64 amt = 255)
{
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 sozl;
	F64	 sozr;
	F64	 tozl;
	F64	 tozr;
	F64	 litl;
	F64	 litr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 sozi;
	F64	 tozi;
	F64	 liti;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;
		sozl  = 0.0;
		sozr  = 0.0;
		tozl  = 0.0;
		tozr  = 0.0;
		litl  = 0.0;
		litr  = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);
				sozi = v[i].s_over_z + frac * (v[j].s_over_z - v[i].s_over_z);
				tozi = v[i].t_over_z + frac * (v[j].t_over_z - v[i].t_over_z);
				liti = v[i].light + frac * (v[j].light - v[i].light);

				if (!found)
				{
					xl = xi; izl = izi; sozl = sozi; tozl = tozi; litl = liti;
					xr = xi; izr = izi; sozr = sozi; tozr = tozi; litr = liti;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi; sozl = sozi; tozl = tozi;
						litl = liti;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi; sozr = sozi; tozr = tozi;
						litr = liti;
					}
				}
			}
		}

		if (found && xr > xl)
		{
			HLDrawSpan(c, y, ToI64(Floor(xl)), ToI64(Ceil(xr)),
				izl, sozl, tozl, izr, sozr, tozr, litl, litr,
				tex, lightmap, lm_w, lm_h, mins_s, mins_t, flat_light, mip,
				surf, sw, sh, blend, amt);
		}
	}
}


Bool HLSkyLoadFace(U8 *name, I64 face)
{
	U8	*data;
	U8	*sfx;
	CDC	*dc;
	U32	*out;
	U8	 path[96];
	I64	 size = 0;
	I64	 w;
	I64	 h;
	I64	 x;
	I64	 y;

	sfx = HLSkySuffix(face);
	StrPrint(path, "gfx/env/%s%s.tga", name, sfx);

	data = HLFileLoad(path, &size);
	if (!data)
		return FALSE;

	dc = TGAReadBuf(data, size);
	Free(data);

	if (!dc)
		return FALSE;

	w = dc->width;
	h = dc->height;

	if (w < 1 || h < 1)
	{
		DCDel(dc);
		return FALSE;
	}

	out = MAlloc(w * h * sizeof(U32));

	if (!out)
	{
		DCDel(dc);
		return FALSE;
	}

	for (y = 0; y < h; y++)
	{
		for (x = 0; x < w; x++)
			out[y * w + x] = dc->body[y * dc->width_internal + x] & 0x00FFFFFF;
	}

	DCDel(dc);

	hl_sky_pix[face] = out;
	hl_sky_w[face]   = w;
	hl_sky_h[face]   = h;

	return TRUE;
}

U0 HLSkyLoad(U8 *name)
{
	I64 ok = 0;
	I64 i;

	HLSkyFree;

	if (!name || !name[0])
		return;

	HLStrCopy(hl_sky_name, name, 64);

	for (i = 0; i < HLSKY_FACES; i++)
	{
		if (HLSkyLoadFace(name, i))
			ok++;
	}

	hl_sky_loaded = ok;

	if (ok > 0)
		hl_sky_ready = TRUE;
	else
		hl_sky_name[0] = 0;

	if (ok == HLSKY_FACES)
	{
		"HLSky: %s, six faces\n", name;
	}
	else if (ok > 0)
	{
		"HLSky: %s, %d of 6 faces, rest solid\n", name, ok;
	}
	else
	{
		"HLSky: gfx/env/%s* not found, solid sky\n", name;
	}
}

U0 HLSkySetColor(I64 r, I64 g, I64 b)
{//sv_skycolor_r/g/b, set from light_environment - dlls/lights.cpp:173
	hl_sky_solid = (ClampI64(r, 0, 255) << 16) |
				   (ClampI64(g, 0, 255) << 8) |
					ClampI64(b, 0, 255);

	hl_sky_color_set = TRUE;
}

U0 HLSkyMeanColor()
{
	I64 r = 0;
	I64 g = 0;
	I64 b = 0;
	I64 n = 0;
	I64 face;
	I64 i;
	I64 total;
	U32 *p;
	U32 c;

	for (face = 0; face < HLSKY_FACES; face++)
	{
		p = hl_sky_pix[face];
		if (!p)
			goto qsmc_next;

		total = hl_sky_w[face] * hl_sky_h[face];

		for (i = 0; i < total; i += 32)
		{
			c  = p[i];
			r += (c >> 16) & 0xFF;
			g += (c >> 8) & 0xFF;
			b += c & 0xFF;
			n++;
		}

qsmc_next:
	}

	if (n < 1)
		return;

	hl_sky_solid = ((r / n) << 16) | ((g / n) << 8) | (b / n);
}

I64 HLSkyTokens(U8 *s, F64 *out, I64 max)
{
	U8	tok[64];
	I64	i = 0;
	I64	n = 0;
	I64	k;

	while (s[i] && n < max)
	{
		while (s[i] == ' ' || s[i] == '\t')
			i++;

		k = 0;
		while (s[i] && s[i] != ' ' && s[i] != '\t' && k < 63)
		{
			tok[k] = s[i];
			k++;
			i++;
		}
		tok[k] = 0;

		if (k < 1)
			break;

		out[n] = HLAtoF(tok);
		n++;
	}

	return n;
}

U0 HLSkyLightColor(U8 *val)
{//CEnvLight::KeyValue "_light", dlls/lights.cpp:150-177.
	F64	v[4];
	F64	r;
	F64	g;
	F64	b;
	F64	s;
	I64	n;

	n = HLSkyTokens(val, v, 4);

	if (n < 1)
		return;

	r = v[0];
	g = r;
	b = r;

	if (n >= 3)
	{
		g = v[1];
		b = v[2];
	}

	if (n >= 4)
	{
		s  = v[3] / 255.0;
		r *= s;
		g *= s;
		b *= s;
	}

	if (r <= 0.0)	r = 0.0;
	if (g <= 0.0)	g = 0.0;
	if (b <= 0.0)	b = 0.0;

	r = Pow(r / 114.0, 0.6) * 264.0;
	g = Pow(g / 114.0, 0.6) * 264.0;
	b = Pow(b / 114.0, 0.6) * 264.0;

	HLSkySetColor(ToI64(r), ToI64(g), ToI64(b));
}

U0 HLSkySetVec(F64 pitch, F64 yaw, F64 roll)
{//CEnvLight::Spawn, dlls/lights.cpp:186-197. UTIL_MakeAimVectors negates pitch
 //before AngleVectors (dlls/util.cpp:602-608)
	F64 ang[3];

	ang[0] = -pitch;
	ang[1] = yaw;
	ang[2] = roll;

	HLAngleVectors(ang, hl_sky_vec, NULL, NULL);

	hl_sky_vec_set = TRUE;
}

U0 HLSkyMoveVars(CHLMap *map, U8 *out_name, I64 max)
{
	U8	*e;
	U8	 key[64];
	U8	 val[160];
	U8	 cls[64];
	U8	 light[160];
	F64	 ang[3];
	F64	 tmp[3];
	I64	 n;
	I64	 i;
	I64	 k;
	Bool have_light;
	Bool have_pitch;

	out_name[0] = 0;

	hl_sky_color_set = FALSE;
	hl_sky_vec_set   = FALSE;

	if (!map || !map->entities || map->entities_size < 12)
		return;

	e = map->entities;
	n = map->entities_size;
	i = 0;

	while (i < n && e[i])
	{
		if (e[i] != '{')
		{
			i++;
			goto qsm_next_block;
		}

		i++;

		cls[0]     = 0;
		light[0]   = 0;
		have_light = FALSE;
		have_pitch = FALSE;
		ang[0]     = 0.0;
		ang[1]     = 0.0;
		ang[2]     = 0.0;

		while (i < n && e[i] && e[i] != '}')
		{
			if (e[i] != '"')
			{
				i++;
				goto qsm_next_key;
			}

			i++;
			k = 0;
			while (i < n && e[i] && e[i] != '"')
			{
				if (k < 63)
				{
					key[k] = e[i];
					k++;
				}
				i++;
			}
			key[k] = 0;
			i++;

			while (i < n && e[i] && e[i] != '"')
				i++;
			i++;

			k = 0;
			while (i < n && e[i] && e[i] != '"')
			{
				if (k < 159)
				{
					val[k] = e[i];
					k++;
				}
				i++;
			}
			val[k] = 0;
			i++;

			if (!StrCompare(key, "classname"))
				HLStrCopy(cls, val, 64);
			else if (!StrCompare(key, "skyname"))
				HLStrCopy(out_name, val, max);
			else if (!StrCompare(key, "_light"))
			{
				HLStrCopy(light, val, 160);
				have_light = TRUE;
			}
			else if (!StrCompare(key, "pitch"))
			{
				//CLight::KeyValue, dlls/lights.cpp:66. overrides angles[0]
				ang[0]     = HLAtoF(val);
				have_pitch = TRUE;
			}
			else if (!StrCompare(key, "angle"))
			{
				ang[1] = HLAtoF(val);
			}
			else if (!StrCompare(key, "angles"))
			{
				HLParseVec(val, tmp);

				if (!have_pitch)
					ang[0] = tmp[0];

				ang[1] = tmp[1];
				ang[2] = tmp[2];
			}

qsm_next_key:
		}

		if (i < n && e[i] == '}')
			i++;

		if (!StrCompare(cls, "light_environment"))
		{
			if (have_light)
				HLSkyLightColor(light);

			HLSkySetVec(ang[0], ang[1], ang[2]);
		}

qsm_next_block:
	}

	//straight down, the pitch -75 to -90 the shipped maps cluster around
	if (!hl_sky_vec_set)
	{
		hl_sky_vec[0] = 0.0;
		hl_sky_vec[1] = 0.0;
		hl_sky_vec[2] = -1.0;
	}
}

U0 HLSkySetName(U8 *name)
{
	if (!name || !name[0])
		return;

	if (hl_sky_ready && !StrICompare(hl_sky_name, name))
		return;

	HLSkyLoad(name);

	hl_sky_map = hl_surf_map;
	HLStrCopy(hl_sky_map_name, hl_map_name, 96);
}

U0 HLSkyCheckMap(CHLMap *map)
{
	U8 name[64];

	if (map == hl_sky_map && !StrCompare(hl_sky_map_name, hl_map_name))
		return;

	hl_sky_map = map;
	HLStrCopy(hl_sky_map_name, hl_map_name, 96);

	HLSkyMoveVars(map, name, 64);

	if (!name[0])
		HLStrCopy(name, HLSKY_DEFAULT, 64);

	HLSkyLoad(name);

	if (hl_sky_color_set)
		return;

	if (hl_sky_loaded > 0)
		HLSkyMeanColor;
	else
		hl_sky_solid = 0;
}

U0 HLSkyRay(F64 *d, I64 *_face, F64 *_u, F64 *_v)
{
	F64 ax;
	F64 ay;
	F64 az;
	F64 den;
	F64 s;
	F64 t;
	I64 face;

	ax = d[0];
	if (ax < 0.0)
		ax = -ax;
	ay = d[1];
	if (ay < 0.0)
		ay = -ay;
	az = d[2];
	if (az < 0.0)
		az = -az;

	if (ax >= ay && ax >= az)
	{
		if (d[0] > 0.0)
		{
			face = HLSKY_RT;	den =  d[0];	s = -d[1];	t =  d[2];
		}
		else
		{
			face = HLSKY_LF;	den = -d[0];	s =  d[1];	t =  d[2];
		}
	}
	else if (ay >= az)
	{
		if (d[1] > 0.0)
		{
			face = HLSKY_BK;	den =  d[1];	s =  d[0];	t =  d[2];
		}
		else
		{
			face = HLSKY_FT;	den = -d[1];	s = -d[0];	t =  d[2];
		}
	}
	else
	{
		if (d[2] > 0.0)
		{
			face = HLSKY_UP;	den =  d[2];	s = -d[1];	t = -d[0];
		}
		else
		{
			face = HLSKY_DN;	den = -d[2];	s = -d[1];	t =  d[0];
		}
	}

	if (den < 0.000001)
		den = 0.000001;

	s /= den;
	t /= den;

	*_face = face;
	*_u    = (s + 1.0) * 0.5 * ToF64(hl_sky_w[face]);
	*_v    = (1.0 - t) * 0.5 * ToF64(hl_sky_h[face]);
}

U32 HLSkyTexel(I64 face, F64 u, F64 v)
{
	U32	*p;
	I64	 w;
	I64	 h;
	I64	 iu;
	I64	 iv;

	if (!hl_sky_ready || face < 0 || face >= HLSKY_FACES)
		return hl_sky_solid;

	p = hl_sky_pix[face];
	if (!p)
		return hl_sky_solid;

	w  = hl_sky_w[face];
	h  = hl_sky_h[face];
	iu = ToI64(u);
	iv = ToI64(v);

	if (iu < 0)
		iu = 0;
	if (iu >= w)
		iu = w - 1;
	if (iv < 0)
		iv = 0;
	if (iv >= h)
		iv = h - 1;

	return p[iv * w + iu];
}

U0 HLDrawSkySpan(CHLCanvas *c, I64 y, I64 x1, I64 x2, F64 iz1, F64 iz2)
{
	U32	*row;
	F64	*zrow;
	F64	 dir[3];
	F64	 step[3];
	F64	 cur[3];
	F64	 sxf;
	F64	 syf;
	F64	 span;
	F64	 d_iz;
	F64	 iz;
	F64	 u0, v0;
	F64	 u1, v1;
	F64	 du, dv;
	F64	 u, v;
	I64	 f0;
	I64	 f1;
	I64	 fc;
	I64	 x;
	I64	 xe;
	I64	 n;
	I64	 i;

	if (y < c->vy || y >= c->vy + c->vh)
		return;

	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz = (iz2 - iz1) / span;

	if (x1 < c->vx)
	{
		iz1 += d_iz * ToF64(c->vx - x1);
		x1   = c->vx;
	}
	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;
	if (x1 >= x2)
		return;

	hl_rs_sky_px += x2 - x1;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;
	iz   = iz1;

	if (!hl_sky_ready || !hl_r_drawsky)
	{
		for (x = x1; x < x2; x++)
		{
			if (iz > zrow[x])
			{
				row[x]  = hl_sky_solid;
				zrow[x] = 0.0;
			}

			iz += d_iz;
		}

		c->spans_drawn++;
		return;
	}

	sxf = (ToF64(x1) - c->center_x) / c->x_scale;
	syf = (c->center_y - ToF64(y)) / c->y_scale;

	for (i = 0; i < 3; i++)
	{
		dir[i]  = c->forward[i] + c->right[i] * sxf + c->up[i] * syf;
		step[i] = c->right[i] / c->x_scale;
	}

	x = x1;

	HLSkyRay(dir, &f0, &u0, &v0);

	while (x < x2)
	{
		xe = x + HLSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		for (i = 0; i < 3; i++)
			cur[i] = dir[i] + step[i] * ToF64(n);

		HLSkyRay(cur, &f1, &u1, &v1);

		if (f1 == f0)
		{
			du = (u1 - u0) / ToF64(n);
			dv = (v1 - v0) / ToF64(n);
			u  = u0;
			v  = v0;
			fc = f0;

			while (x < xe)
			{
				if (iz > zrow[x])
				{
					row[x]  = HLSkyTexel(fc, u, v);
					zrow[x] = 0.0;
				}

				u  += du;
				v  += dv;
				iz += d_iz;
				x++;
			}
		}
		else
		{
			for (i = 0; i < 3; i++)
				cur[i] = dir[i];

			while (x < xe)
			{
				if (iz > zrow[x])
				{
					HLSkyRay(cur, &fc, &u, &v);
					row[x]  = HLSkyTexel(fc, u, v);
					zrow[x] = 0.0;
				}

				cur[0] += step[0];
				cur[1] += step[1];
				cur[2] += step[2];
				iz     += d_iz;
				x++;
			}
		}

		for (i = 0; i < 3; i++)
			dir[i] += step[i] * ToF64(n);

		f0 = f1;
		u0 = u1;
		v0 = v1;
	}

	c->spans_drawn++;
}

U0 HLDrawSkyPolygon(CHLCanvas *c, CHLScreenVert *v, I64 count)
{
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);

				if (!found)
				{
					xl = xi; izl = izi;
					xr = xi; izr = izi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi;
					}
				}
			}
		}

		if (found && xr > xl)
			HLDrawSkySpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)), izl, izr);
	}
}

U0 HLDrawFace(CHLCanvas *c, CHLMap *map, I64 face_index, F64 *offset = NULL,
	I64 ent_frame = 0, F64 *xform = NULL, I64 blend = 0, I64 amt = 255,
	F64 wave_amp = 0.0, F64 scroll_speed = 0.0)
{
	CHLFace		*f  = &map->faces[face_index];
	CHLTexInfo	*ti;
	CHLTexture	*tex;
	CHLPolyVert	 poly[HLMAX_POLY_VERTS];
	CHLPolyVert	 clipped[HLMAX_POLY_VERTS];
	CHLScreenVert scr[HLMAX_POLY_VERTS];
	CHLVertex	*wv;
	U8			*lightmap = NULL;
	U32			*surf = NULL;
	I64			 sw = 0;
	I64			 sh = 0;
	F64			 rel[3];
	F64			 inv_z;
	I64			 n = 0;
	I64			 count;
	I64			 lm_w = 0;
	I64			 lm_h = 0;
	I64			 i;
	I64			 e;
	I64			 anim_tex;
	I64			 mip;
	F64			 near_z;
	F64			 vd;
	F64			 ratio;
	F64			 tex_s;
	F64			 tex_t;
	F64			 tex_len;
	F64		   shifted[3];
	F64			 world_pt[3];
	F64			 scroll_s;

	if (f->num_edges < 3 || f->num_edges > HLMAX_POLY_VERTS)
		return;

	if (!HLRenderTranslucent(blend))
		blend = 0;
	else
	{
		amt = ClampI64(amt, 0, 255);

		if (amt <= 0)
			return;
	}

	ti = &map->texinfo[f->tex_info];
	if (ti->miptex < 0 || ti->miptex >= map->num_textures)
		return;

	anim_tex = HLTextureAnimation(map, ti->miptex, ent_frame, hl_light_time);
	if (anim_tex < 0)
		return;

	tex = &map->textures[anim_tex];
	if (!tex->texels[0] || tex->width <= 0 || tex->height <= 0)
		return;

	scroll_s = 0.0;
	if (tex->is_scroll && scroll_speed != 0.0)
		scroll_s = hl_light_time * scroll_speed;

	for (i = 0; i < f->num_edges; i++)
	{
		e = map->surfedges[f->first_edge + i];
		if (e >= 0)
			wv = &map->vertices[map->edges[e].v[0]];
		else
			wv = &map->vertices[map->edges[-e].v[1]];

		poly[n].s = HLVecDot(wv->pt, &ti->vecs[0]) + ti->vecs[3] + scroll_s;
		poly[n].t = HLVecDot(wv->pt, &ti->vecs[4]) + ti->vecs[7];

		if (xform)
		{
			HLMatTransform(wv->pt, xform, shifted);
			HLVecCopy(shifted, world_pt);
		}
		else if (offset)
		{
			HLVecAdd(wv->pt, offset, shifted);
			HLVecCopy(shifted, world_pt);
		}
		else
			HLVecCopy(wv->pt, world_pt);

		if (tex->is_turb && wave_amp > 0.0)
			world_pt[2] = HLWaterWaveZ(world_pt[0], world_pt[1],
				world_pt[2], wave_amp);

		HLVecSub(world_pt, c->origin, rel);
		poly[n].cam[0] = HLVecDot(rel, c->right);
		poly[n].cam[1] = HLVecDot(rel, c->up);
		poly[n].cam[2] = HLVecDot(rel, c->forward);
		poly[n].light  = 0.0;
		n++;
	}

	count = HLDrawClipNear(poly, n, clipped);
	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		inv_z = 1.0 / clipped[i].cam[2];

		scr[i].x = c->center_x + clipped[i].cam[0] * c->x_scale * inv_z;
		scr[i].y = c->center_y - clipped[i].cam[1] * c->y_scale * inv_z;

		scr[i].inv_z    = inv_z;
		scr[i].s_over_z = clipped[i].s * inv_z;
		scr[i].t_over_z = clipped[i].t * inv_z;
		scr[i].light    = 0.0;
	}

	if (map->lightdata && !tex->is_turb && !tex->is_sky)
	{
		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;

		if (f->light_offset >= 0 &&
			(f->light_offset >= map->lightdata_size ||
			 f->light_offset + lm_w * lm_h * HLLIGHT_STRIDE >
				map->lightdata_size))
		{
			lm_w = 0;
			lm_h = 0;
		}
		else
			lightmap = HLLightFaceMap(map, f, lm_w, lm_h, hl_light_time);
	}

	if (tex->is_sky)
	{
		HLSkyCheckMap(map);
		HLDrawSkyPolygon(c, scr, count);
	}
	else
	{
		near_z = 1.0e30;
		for (i = 0; i < count; i++)
		{
			vd = Sqrt(clipped[i].cam[0] * clipped[i].cam[0] +
					  clipped[i].cam[1] * clipped[i].cam[1] +
					  clipped[i].cam[2] * clipped[i].cam[2]);
			if (vd < near_z)
				near_z = vd;
		}

		tex_s = Sqrt(ti->vecs[0] * ti->vecs[0] +
					 ti->vecs[1] * ti->vecs[1] +
					 ti->vecs[2] * ti->vecs[2]);
		tex_t = Sqrt(ti->vecs[4] * ti->vecs[4] +
					 ti->vecs[5] * ti->vecs[5] +
					 ti->vecs[6] * ti->vecs[6]);

		tex_len = (tex_s + tex_t) * 0.5;
		if (tex_len < 0.001)
			tex_len = 1.0;

		ratio = tex_len * near_z / (ToF64(c->vw) * 0.5);

		mip = HLMipForRatio(ratio, HLSurfCacheMipFor(map, face_index));

		if (!tex->is_turb && !tex->is_scroll && !tex->clamp)
			surf = HLSurfCacheGet(map, f, face_index, tex, mip,
					lightmap, lm_w, lm_h, &sw, &sh, anim_tex);

		HLDrawPolygon(c, scr, count, tex, lightmap, lm_w, lm_h,
			f->mins_s, f->mins_t, 255, mip, surf, sw, sh, blend, amt);
	}

	c->faces_drawn++;
	hl_rs_faces++;
}

U0 HLDrawWorld(CHLCanvas *c, CHLMap *map, CHLVisState *vs)
{
	I64 i, t0 = TSCGet;

	for (i = 0; i < vs->face_count; i++)
		HLDrawFace(c, map, vs->face_list[i], NULL, 0, NULL, 0, 255,
			0.0, 35.0);

	hl_tsc_world += TSCGet - t0;
}

U0 HLDrawBrushModel(CHLCanvas *c, CHLMap *map, I64 model_index,
	F64 *origin = NULL, I64 ent_frame = 0, F64 *angles = NULL,
	I64 blend = 0, I64 amt = 255, CHLVisState *vs = NULL,
	F64 wave_amp = 0.0, F64 scroll_speed = 0.0)
{
	CHLModel *m;
	CHLFace	 *f;
	CHLPlane	 *plane;
	F64		  xf[12];
	F64		  org[3];
	F64		  wmins[3];
	F64		  wmaxs[3];
	F64		  corner[3];
	F64		  world[3];
	F64		 *xform = NULL;
	F64		 *ofs;
	F64		  ndot;
	I64		  i;
	I64		  cx;
	I64		  cy;
	I64		  cz;
	Bool		  unrot = TRUE;
	Bool		  first;

	if (model_index < 0 || model_index >= map->num_models)
		return;

	ofs = origin;

	if (angles)
	{
		if (HLMatAnglesActive(angles))
		{
			if (origin)
				HLVecCopy(origin, org);
			else
				HLVecSet(org, 0.0, 0.0, 0.0);

			HLMatFromAngles(angles, org, xf);
			xform = xf;
			unrot = FALSE;

			ofs = NULL;
		}
	}

	m = &map->models[model_index];

	if (vs)
	{
		if (unrot)
		{
			for (i = 0; i < 3; i++)
			{
				wmins[i] = m->mins[i];
				wmaxs[i] = m->maxs[i];

				if (ofs)
				{
					wmins[i] += ofs[i];
					wmaxs[i] += ofs[i];
				}
			}
		}
		else
		{
			first = TRUE;

			for (cx = 0; cx < 2; cx++)
			{
				corner[0] = m->mins[0];
				if (cx)
					corner[0] = m->maxs[0];

				for (cy = 0; cy < 2; cy++)
				{
					corner[1] = m->mins[1];
					if (cy)
						corner[1] = m->maxs[1];

					for (cz = 0; cz < 2; cz++)
					{
						corner[2] = m->mins[2];
						if (cz)
							corner[2] = m->maxs[2];

						HLMatTransform(corner, xform, world);

						if (first)
						{
							HLVecCopy(world, wmins);
							HLVecCopy(world, wmaxs);
							first = FALSE;
						}
						else
						{
							for (i = 0; i < 3; i++)
							{
								if (world[i] < wmins[i])
									wmins[i] = world[i];
								if (world[i] > wmaxs[i])
									wmaxs[i] = world[i];
							}
						}
					}
				}
			}
		}

		if (!HLVisBoxInFrustum(vs, wmins, wmaxs))
			return;
	}

	HLMarkLightsModel(map, m, origin, xform);
	hl_dlight_mspace_on = hl_r_dynamic;

	for (i = 0; i < m->num_faces; i++)
	{
		if (m->first_face + i >= map->num_faces)
			goto qbm_next;

		if (unrot)
		{
			f = &map->faces[m->first_face + i];
			if (f->plane_num >= 0 && f->plane_num < map->num_planes)
			{
				plane = &map->planes[f->plane_num];
				ndot  = HLVecDot(plane->normal, c->origin) - plane->dist;
				if (ofs)
					ndot -= HLVecDot(plane->normal, ofs);
				if ((ndot < 0.0) != ToBool(f->side))
					goto qbm_next;
			}
		}

		HLDrawFace(c, map, m->first_face + i, ofs, ent_frame, xform,
			blend, amt, wave_amp, scroll_speed);

qbm_next:
	}

	hl_dlight_mspace_on = FALSE;
}

U0 HLDrawFadeScreen(CHLCanvas *c)
{
	U32	*row;
	I64	 x;
	I64	 y;
	I64	 t;
	I64	 step;

	step = c->width / 320;
	if (step < 1)
		step = 1;

	for (y = 0; y < c->height; y++)
	{
		row = c->pixels + y * c->width;

		//alternates the kept column between 0 and 2
		t = ((y / step) & 1) << 1;

		for (x = 0; x < c->width; x++)
		{
			if (((x / step) & 3) != t)
				row[x] = 0;
		}
	}
}

U32 HLDispCorrect(U32 rgb)
{
	if (hl_disp_identity)
		return rgb;

	return (hl_disp_r[(rgb >> 16) & 255] << 16) |
		   (hl_disp_g[(rgb >> 8) & 255] << 8) |
			hl_disp_b[rgb & 255];
}

#define HLROW_BANDS		16
#define HLROW_MIN_ROWS	64

class CHLRowJob
{
	CHLCanvas	*c;
	CDC			*dc;
	I64			 y0, y1;
	I64			 dst_x, dst_y, dst_w, dst_h;
};

CHLRowJob	 hl_blit_job[HLROW_BANDS];
CJob		*hl_blit_cmd[HLROW_BANDS];
I64			 hl_mt_cores = 0;
Bool		 hl_mt_init	 = FALSE;
Bool		 hl_r_mtblit = TRUE;
hl_r_mtblit = TRUE;

U0 HLBlitFitBand(CHLCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w,
	I64 dst_h, I64 y0, I64 y1)
{
	U32	*src;
	U32	*dst;
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 warp;
	I64	 sx;
	I64	 pitch = dc->width_internal;

	if (dst_w < 1 || dst_h < 1)
		return;

	if (dst_w == c->width && dst_h == c->height && hl_warp_amount <= 0.0)
	{
		for (y = y0; y < y1; y++)
		{
			py = dst_y + y;

			if (py < 0 || py >= dc->height)
				goto qbf_1to1_next;

			src = c->pixels + y * c->width;
			dst = dc->body + py * pitch;

			if (hl_disp_identity && dst_x == 0 && dst_w <= dc->width)
				MemCopy(dst, src, dst_w * sizeof(U32));
			else
			{
				for (x = 0; x < dst_w; x++)
				{
					if (dst_x + x >= 0 && dst_x + x < dc->width)
						dst[dst_x + x] = HLDispCorrect(src[x]);
				}
			}

qbf_1to1_next:
		}

		return;
	}

	sx_step = (c->width << 16) / dst_w;
	sy_step = (c->height << 16) / dst_h;

	for (y = y0; y < y1; y++)
	{
		py = dst_y + y;
		if (py < 0 || py >= dc->height)
			goto qbf_next_row;

		sy = (y * sy_step) >> 16;
		if (sy >= c->height)
			sy = c->height - 1;

		src = c->pixels + sy * c->width;
		dst = dc->body + py * pitch;

		if (hl_warp_amount > 0.0)
		{
			warp = ToI64(Sin(ToF64(sy) * 0.06 + hl_warp_time * 3.0) *
				hl_warp_amount);
			sxf = warp << 16;
		}
		else
			sxf = 0;

		for (x = 0; x < dst_w; x++)
		{
			sx = sxf >> 16;
			if (sx < 0)
				sx = 0;
			if (sx >= c->width)
				sx = c->width - 1;

			if (dst_x + x >= 0 && dst_x + x < dc->width)
				dst[dst_x + x] = HLDispCorrect(src[sx]);

			sxf += sx_step;
		}

qbf_next_row:
	}
}

I64 HLBlitFitJob(U8 *data)
{
	CHLRowJob *j = data;

	HLBlitFitBand(j->c, j->dc, j->dst_x, j->dst_y, j->dst_w, j->dst_h,
		j->y0, j->y1);

	return 0;
}

U0 HLDrawBlitFit(CHLCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w,
	I64 dst_h)
{
	I64 bands, i, t0;

	if (dst_w < 1 || dst_h < 1)
		return;

	t0 = TSCGet;

	if (!hl_mt_init)
	{
		hl_mt_init	= TRUE;
		hl_mt_cores	= mp_count - 1;
		if (hl_mt_cores < 0)
			hl_mt_cores = 0;
	}

	if (dst_w == c->width && dst_h == c->height && hl_warp_amount <= 0.0 &&
		hl_disp_identity)
	{
		HLBlitFitBand(c, dc, dst_x, dst_y, dst_w, dst_h, 0, dst_h);
		hl_tsc_blit += TSCGet - t0;
		return;
	}

	bands = 1;
	if (hl_r_mtblit && hl_mt_cores > 0 && dst_h >= HLROW_MIN_ROWS)
	{
		bands = hl_mt_cores + 1;
		if (bands > HLROW_BANDS)
			bands = HLROW_BANDS;
	}

	if (bands > 1)
	{
		for (i = 1; i < bands; i++)
		{
			hl_blit_job[i].c	 = c;
			hl_blit_job[i].dc	 = dc;
			hl_blit_job[i].dst_x = dst_x;
			hl_blit_job[i].dst_y = dst_y;
			hl_blit_job[i].dst_w = dst_w;
			hl_blit_job[i].dst_h = dst_h;
			hl_blit_job[i].y0	 = dst_h * i / bands;
			hl_blit_job[i].y1	 = dst_h * (i + 1) / bands;

			hl_blit_cmd[i] = JobQueue(&HLBlitFitJob, &hl_blit_job[i], i, 0);
		}

		HLBlitFitBand(c, dc, dst_x, dst_y, dst_w, dst_h, 0, dst_h / bands);

		for (i = 1; i < bands; i++)
			JobResGet(hl_blit_cmd[i]);
	}
	else
		HLBlitFitBand(c, dc, dst_x, dst_y, dst_w, dst_h, 0, dst_h);

	hl_tsc_blit += TSCGet - t0;
}


//Ring, oldest overwritten. r_decals defaults to 300 in GoldSrc;
#define HLDECAL_MAX			300
#define HLDECAL_TEX_MAX		42
#define HLDECAL_NAME_MAX	24

#define HLDECAL_DEPTH_SLACK	2.0

#define HLDECAL_PX_SHARE	2

#define HLDECAL_GUNSHOT1		0
#define HLDECAL_SCORCH1			11
#define HLDECAL_SCORCH2			12
#define HLDECAL_BLOOD1			13
#define HLDECAL_YBLOOD1			19
#define HLDECAL_BIGSHOT1		28
#define HLDECAL_SMALLSCORCH1	36

class CHLDecal
{
	F64	 origin[3];
	F64	 normal[3];
	F64	 sdir[3];
	F64	 tdir[3];
	F64	 half_s;
	F64	 half_t;
	I64	 tex;
	Bool active;
};

CHLDecal	hl_decals[HLDECAL_MAX];
CHLTexture	hl_decal_tex[HLDECAL_TEX_MAX];
Bool		hl_decal_tex_ok[HLDECAL_TEX_MAX];
Bool		hl_decal_tex_tried[HLDECAL_TEX_MAX];
I64			hl_decal_next	= 0;
I64			hl_decal_drawn	= 0;
Bool		hl_decal_wad_tried = FALSE;

I64			hl_r_decal_max	= HLDECAL_MAX;

U0 HLDecalSetMax(I64 n)
{
	I64 i;

	if (n < 1)
		n = 1;
	if (n > HLDECAL_MAX)
		n = HLDECAL_MAX;

	hl_r_decal_max = n;

	for (i = n; i < HLDECAL_MAX; i++)
		hl_decals[i].active = FALSE;

	if (hl_decal_next >= n)
		hl_decal_next = 0;
}

U8 *HLDecalName(I64 n)
{//gDecals
	if (n == 0)		return "shot1";
	if (n == 1)		return "shot2";
	if (n == 2)		return "shot3";
	if (n == 3)		return "shot4";
	if (n == 4)		return "shot5";
	if (n == 5)		return "lambda01";
	if (n == 6)		return "lambda02";
	if (n == 7)		return "lambda03";
	if (n == 8)		return "lambda04";
	if (n == 9)		return "lambda05";
	if (n == 10)	return "lambda06";
	if (n == 11)	return "scorch1";
	if (n == 12)	return "scorch2";
	if (n == 13)	return "blood1";
	if (n == 14)	return "blood2";
	if (n == 15)	return "blood3";
	if (n == 16)	return "blood4";
	if (n == 17)	return "blood5";
	if (n == 18)	return "blood6";
	if (n == 19)	return "yblood1";
	if (n == 20)	return "yblood2";
	if (n == 21)	return "yblood3";
	if (n == 22)	return "yblood4";
	if (n == 23)	return "yblood5";
	if (n == 24)	return "yblood6";
	if (n == 25)	return "break1";
	if (n == 26)	return "break2";
	if (n == 27)	return "break3";
	if (n == 28)	return "bigshot1";
	if (n == 29)	return "bigshot2";
	if (n == 30)	return "bigshot3";
	if (n == 31)	return "bigshot4";
	if (n == 32)	return "bigshot5";
	if (n == 33)	return "spit1";
	if (n == 34)	return "spit2";
	if (n == 35)	return "bproof1";
	if (n == 36)	return "gargstomp";
	if (n == 37)	return "smscorch1";
	if (n == 38)	return "smscorch2";
	if (n == 39)	return "smscorch3";
	if (n == 40)	return "mommablob";
	if (n == 41)	return "mommablob";

	return NULL;
}

U0 HLDecalClear()
{//a map change unmounts decals.wad
	I64 i;

	for (i = 0; i < HLDECAL_MAX; i++)
		hl_decals[i].active = FALSE;

	for (i = 0; i < HLDECAL_TEX_MAX; i++)
	{
		hl_decal_tex_ok[i]    = FALSE;
		hl_decal_tex_tried[i] = FALSE;
		MemSet(&hl_decal_tex[i], 0, sizeof(CHLTexture));
	}

	hl_decal_next      = 0;
	hl_decal_drawn     = 0;
	hl_decal_wad_tried = FALSE;

	if (hl_r_decal_max < 1 || hl_r_decal_max > HLDECAL_MAX)
		hl_r_decal_max = HLDECAL_MAX;
}

U0 HLDecalInit()
{
	HLDecalClear;
}

Bool HLDecalTexGet(I64 n)
{
	U8	*base;
	U8	*mip;
	U8	 name[HLDECAL_NAME_MAX];
	I64	 size = 0;

	if (n < 0 || n >= HLDECAL_TEX_MAX)
		return FALSE;

	if (hl_decal_tex_tried[n])
		return hl_decal_tex_ok[n];

	hl_decal_tex_tried[n] = TRUE;
	hl_decal_tex_ok[n]    = FALSE;

	base = HLDecalName(n);
	if (!base)
		return FALSE;

	if (!hl_decal_wad_tried)
	{
		hl_decal_wad_tried = TRUE;
		HLWad3MountByName("decals");
	}

	name[0] = 0x7B;
	StrCopy(name + 1, base);

	mip = HLWad3FindMip(name, &size);
	if (!mip)
		return FALSE;

	if (!HLBSPDecodeMiptex(&hl_decal_tex[n], mip, size))
		return FALSE;

	if (!hl_decal_tex[n].palette || !hl_decal_tex[n].texels[0])
		return FALSE;

	if (hl_decal_tex[n].width <= 0 || hl_decal_tex[n].height <= 0)
		return FALSE;

	hl_decal_tex_ok[n] = TRUE;
	return TRUE;
}

U0 HLDecalAdd(F64 *origin, F64 *normal, I64 decal)
{
	CHLDecal	*d;
	CHLTexture	*t;
	F64			 axis[3];

	if (!HLDecalTexGet(decal))
		return;

	if (hl_r_decal_max < 1 || hl_r_decal_max > HLDECAL_MAX)
		hl_r_decal_max = HLDECAL_MAX;
	if (hl_decal_next < 0 || hl_decal_next >= hl_r_decal_max)
		hl_decal_next = 0;

	t = &hl_decal_tex[decal];
	d = &hl_decals[hl_decal_next];

	hl_decal_next++;
	if (hl_decal_next >= hl_r_decal_max)
		hl_decal_next = 0;

	d->active = FALSE;

	HLVecCopy(origin, d->origin);
	HLVecCopy(normal, d->normal);

	if (HLVecNormalize(d->normal) < 0.001)
		return;

	HLVecSet(axis, 0.0, 0.0, 1.0);
	if (d->normal[2] > 0.7 || d->normal[2] < -0.7)
		HLVecSet(axis, 1.0, 0.0, 0.0);

	HLVecCross(axis, d->normal, d->sdir);
	if (HLVecNormalize(d->sdir) < 0.001)
		return;

	HLVecCross(d->normal, d->sdir, d->tdir);
	if (HLVecNormalize(d->tdir) < 0.001)
		return;

	d->half_s = ToF64(t->width) * 0.5;
	d->half_t = ToF64(t->height) * 0.5;
	d->tex    = decal;
	d->active = TRUE;
}

Bool HLDecalBounds(CHLCanvas *c, CHLDecal *d, I64 *_x0, I64 *_y0,
	I64 *_x1, I64 *_y1)
{
	CHLPolyVert	quad[4];
	CHLPolyVert	clipped[HLMAX_POLY_VERTS];
	F64			corner[3];
	F64			rel[3];
	F64			min_x = 1.0e30;
	F64			min_y = 1.0e30;
	F64			max_x = -1.0e30;
	F64			max_y = -1.0e30;
	F64			inv_z;
	F64			sx;
	F64			sy;
	I64			cx0;
	I64			cy0;
	I64			cx1;
	I64			cy1;
	I64			count;
	I64			k;

	HLVecSub(d->origin, c->origin, rel);
	if (HLVecDot(rel, d->normal) > 0.0)
		return FALSE;

	cx0 = c->vx;
	cy0 = c->vy;
	cx1 = c->vx + c->vw - 1;
	cy1 = c->vy + c->vh - 1;

	if (c->vw < 1 || c->vh < 1)
	{
		cx0 = 0;
		cy0 = 0;
		cx1 = c->width - 1;
		cy1 = c->height - 1;
	}

	if (cx0 < 0)				cx0 = 0;
	if (cy0 < 0)				cy0 = 0;
	if (cx1 > c->width - 1)		cx1 = c->width - 1;
	if (cy1 > c->height - 1)	cy1 = c->height - 1;

	for (k = 0; k < 4; k++)
	{
		HLVecCopy(d->origin, corner);

		if (k == 0 || k == 3)
			HLVecMA(corner, -d->half_s, d->sdir, corner);
		else
			HLVecMA(corner, d->half_s, d->sdir, corner);

		if (k < 2)
			HLVecMA(corner, -d->half_t, d->tdir, corner);
		else
			HLVecMA(corner, d->half_t, d->tdir, corner);

		HLVecSub(corner, c->origin, rel);

		quad[k].cam[0] = HLVecDot(rel, c->right);
		quad[k].cam[1] = HLVecDot(rel, c->up);
		quad[k].cam[2] = HLVecDot(rel, c->forward);

		quad[k].s = 0.0;
		quad[k].t = 0.0;
		quad[k].light = 0.0;
	}

	count = HLDrawClipNear(quad, 4, clipped);
	if (count < 3)
		return FALSE;

	for (k = 0; k < count; k++)
	{
		inv_z = 1.0 / clipped[k].cam[2];
		sx    = c->center_x + clipped[k].cam[0] * c->x_scale * inv_z;
		sy    = c->center_y - clipped[k].cam[1] * c->y_scale * inv_z;

		if (sx < min_x)	min_x = sx;
		if (sx > max_x)	max_x = sx;
		if (sy < min_y)	min_y = sy;
		if (sy > max_y)	max_y = sy;
	}

	*_x0 = ToI64(Floor(min_x));
	*_y0 = ToI64(Floor(min_y));
	*_x1 = ToI64(Ceil(max_x));
	*_y1 = ToI64(Ceil(max_y));

	if (*_x0 < cx0)	*_x0 = cx0;
	if (*_y0 < cy0)	*_y0 = cy0;
	if (*_x1 > cx1)	*_x1 = cx1;
	if (*_y1 > cy1)	*_y1 = cy1;

	if (*_x0 > *_x1 || *_y0 > *_y1)
		return FALSE;

	return TRUE;
}

U0 HLDrawDecals(CHLCanvas *c)
{
	if (!hl_r_decals)
		return;

	CHLDecal	*d;
	CHLTexture	*t;
	U8			*pal;
	U8			*texels;
	U32			*row;
	Bool		 keep[HLDECAL_MAX];
	F64			 rel[3];
	F64			 dir[3];
	F64			 denom;
	F64			 d_denom;
	F64			 ns;
	F64			 d_ns;
	F64			 nt;
	F64			 d_nt;
	F64			 ray;
	F64			 plane_k;
	F64			 base_s;
	F64			 base_t;
	F64			 su;
	F64			 tv;
	F64			 a0;
	F64			 b;
	F64			 fs;
	F64			 ft;
	I64			 i;
	I64			 slot;
	I64			 x;
	I64			 y;
	I64			 x0;
	I64			 x1;
	I64			 y0;
	I64			 y1;
	I64			 tw;
	I64			 th;
	I64			 tx;
	I64			 ty;
	I64			 texel;
	I64			 cr;
	I64			 cg;
	I64			 cb;
	I64			 alpha;
	I64			 dr;
	I64			 dg;
	I64			 db;
	I64			 idx;
	I64			 budget;
	I64			 spent;
	Bool		 masked;
	U32			 c32;

	hl_decal_drawn = 0;

	if (!c || !c->pixels || !c->depth)
		return;

	if (hl_r_decal_max < 1 || hl_r_decal_max > HLDECAL_MAX)
		hl_r_decal_max = HLDECAL_MAX;
	if (hl_decal_next < 0 || hl_decal_next >= hl_r_decal_max)
		hl_decal_next = 0;

	budget = c->vw * c->vh;
	if (budget < 1)
		budget = c->width * c->height;
	budget = budget / HLDECAL_PX_SHARE;

	spent = 0;

	for (i = 0; i < hl_r_decal_max; i++)
	{
		slot = hl_decal_next - 1 - i;
		while (slot < 0)
			slot += hl_r_decal_max;

		keep[slot] = FALSE;

		if (spent >= budget)
			goto qdb_next;

		d = &hl_decals[slot];

		if (!d->active)
			goto qdb_next;

		if (d->tex < 0 || d->tex >= HLDECAL_TEX_MAX)
			goto qdb_next;

		if (!hl_decal_tex_ok[d->tex])
			goto qdb_next;

		if (!HLDecalBounds(c, d, &x0, &y0, &x1, &y1))
			goto qdb_next;

		keep[slot] = TRUE;
		spent += (x1 - x0 + 1) * (y1 - y0 + 1);

qdb_next:
	}

	for (i = 0; i < hl_r_decal_max; i++)
	{
		slot = hl_decal_next + i;
		while (slot >= hl_r_decal_max)
			slot -= hl_r_decal_max;

		if (!keep[slot])
			goto qdc_next;

		d = &hl_decals[slot];

		t      = &hl_decal_tex[d->tex];
		pal    = t->palette;
		texels = t->texels[0];
		tw     = t->width;
		th     = t->height;

		if (!pal || !texels || tw <= 0 || th <= 0)
			goto qdc_next;

		if (!HLDecalBounds(c, d, &x0, &y0, &x1, &y1))
			goto qdc_next;

		masked = ToBool(pal[765] == 0 && pal[766] == 0 && pal[767] == 255);

		cr = pal[765];
		cg = pal[766];
		cb = pal[767];

		plane_k = HLVecDot(d->normal, d->origin) - HLVecDot(d->normal, c->origin);

		HLVecSub(c->origin, d->origin, rel);
		base_s = HLVecDot(rel, d->sdir);
		base_t = HLVecDot(rel, d->tdir);

		d_denom = HLVecDot(d->normal, c->right) / c->x_scale;
		d_ns    = HLVecDot(d->sdir, c->right) / c->x_scale;
		d_nt    = HLVecDot(d->tdir, c->right) / c->x_scale;

		su = ToF64(tw) / (d->half_s * 2.0);
		tv = ToF64(th) / (d->half_t * 2.0);

		a0 = (ToF64(x0) + 0.5 - c->center_x) / c->x_scale;

		hl_rs_decals++;

		for (y = y0; y <= y1; y++)
		{
			row = c->pixels + y * c->width;
			b   = -(ToF64(y) + 0.5 - c->center_y) / c->y_scale;

			dir[0] = c->forward[0] + c->right[0] * a0 + c->up[0] * b;
			dir[1] = c->forward[1] + c->right[1] * a0 + c->up[1] * b;
			dir[2] = c->forward[2] + c->right[2] * a0 + c->up[2] * b;

			denom = HLVecDot(d->normal, dir);
			ns    = HLVecDot(d->sdir, dir);
			nt    = HLVecDot(d->tdir, dir);

			hl_rs_decal_px += x1 - x0 + 1;

			for (x = x0; x <= x1; x++)
			{
				if (denom > -0.0001)
					goto qdc_next_pixel;

				ray = plane_k / denom;
				if (ray < HLNEAR_CLIP)
					goto qdc_next_pixel;

				idx = y * c->width + x;

				if (c->depth[idx] <= 0.0)
					goto qdc_next_pixel;

				if ((ray - HLDECAL_DEPTH_SLACK) * c->depth[idx] > 1.0)
					goto qdc_next_pixel;

				if ((ray + HLDECAL_DEPTH_SLACK) * c->depth[idx] < 1.0)
					goto qdc_next_pixel;

				fs = base_s + ray * ns;
				ft = base_t + ray * nt;

				if (fs < -d->half_s || fs >= d->half_s)
					goto qdc_next_pixel;
				if (ft < -d->half_t || ft >= d->half_t)
					goto qdc_next_pixel;

				tx = ToI64((fs + d->half_s) * su);
				ty = ToI64((ft + d->half_t) * tv);

				if (tx < 0)			tx = 0;
				if (ty < 0)			ty = 0;
				if (tx > tw - 1)	tx = tw - 1;
				if (ty > th - 1)	ty = th - 1;

				texel = texels[ty * tw + tx];

				if (masked)
				{
					if (texel == 255)
						goto qdc_next_pixel;

					alpha = 255;
					cr    = pal[texel * 3];
					cg    = pal[texel * 3 + 1];
					cb    = pal[texel * 3 + 2];
				}
				else
				{
					if (!texel)
						goto qdc_next_pixel;

					alpha = texel;
				}

				c32 = row[x];
				dr  = (c32 >> 16) & 255;
				dg  = (c32 >> 8) & 255;
				db  = c32 & 255;

				dr = (dr * (255 - alpha) + cr * alpha) / 255;
				dg = (dg * (255 - alpha) + cg * alpha) / 255;
				db = (db * (255 - alpha) + cb * alpha) / 255;

				row[x] = (dr << 16) | (dg << 8) | db;
				hl_decal_drawn++;
				hl_rs_decal_hit++;

qdc_next_pixel:
				denom += d_denom;
				ns    += d_ns;
				nt    += d_nt;
			}
		}

qdc_next:
	}
}


#define HLBEAM_SEG_MAX		64
#define HLBEAM_PTS			65		//HLBEAM_SEG_MAX + 1 segment boundaries
#define HLBEAM_SEG_LEN		24.0	//world units per segment
#define HLBEAM_TEX_REPEAT	100.0	//world units per texture repeat along t
#define HLBEAM_MIN_PX		0.75
#define HLBEAM_NOISE_CYCLES	3.0
#define HLBEAM_NOISE_RATE	12.0

U0 HLDrawBeamSpan(CHLCanvas *c, I64 y, I64 x1, I64 x2,
	F64 iz1, F64 soz1, F64 toz1, F64 iz2, F64 soz2, F64 toz2,
	U8 *texels, U8 *pal, I64 tw, I64 th, I64 mod_r, I64 mod_g, I64 mod_b)
{
	U32	*row;
	F64	*zrow;
	F64	 span;
	F64	 d_iz;
	F64	 d_soz;
	F64	 d_toz;
	F64	 iz;
	F64	 soz;
	F64	 toz;
	F64	 z;
	I64	 x;
	I64	 tx;
	I64	 ty;
	I64	 texel;
	I64	 sr;
	I64	 sg;
	I64	 sb;
	I64	 dr;
	I64	 dg;
	I64	 db;
	U32	 c32;

	if (y < c->vy || y >= c->vy + c->vh)
		return;

	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz  = (iz2 - iz1) / span;
	d_soz = (soz2 - soz1) / span;
	d_toz = (toz2 - toz1) / span;

	if (x1 < c->vx)
	{
		iz1  += d_iz * ToF64(c->vx - x1);
		soz1 += d_soz * ToF64(c->vx - x1);
		toz1 += d_toz * ToF64(c->vx - x1);
		x1 = c->vx;
	}

	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;

	if (x1 >= x2)
		return;

	hl_rs_beam_px += x2 - x1;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;

	iz  = iz1;
	soz = soz1;
	toz = toz1;

	for (x = x1; x < x2; x++)
	{
		if (iz <= zrow[x])
			goto qbs_next;

		z = 1.0 / iz;

		tx = ToI64(soz * z);
		if (tx < 0)			tx = 0;
		if (tx > tw - 1)	tx = tw - 1;

		ty = HLTexWrap(ToI64(toz * z), th);

		texel = texels[ty * tw + tx];

		sr = pal[texel * 3];
		sg = pal[texel * 3 + 1];
		sb = pal[texel * 3 + 2];

		if (!(sr | sg | sb))
			goto qbs_next;

		c32 = row[x];

		dr = ((c32 >> 16) & 255) + (sr * mod_r) / 255;
		dg = ((c32 >> 8) & 255) + (sg * mod_g) / 255;
		db = (c32 & 255) + (sb * mod_b) / 255;

		if (dr > 255)	dr = 255;
		if (dg > 255)	dg = 255;
		if (db > 255)	db = 255;

		row[x] = (dr << 16) | (dg << 8) | db;

qbs_next:
		iz  += d_iz;
		soz += d_soz;
		toz += d_toz;
	}
}

U0 HLDrawBeamQuad(CHLCanvas *c, CHLScreenVert *v, I64 count,
	U8 *texels, U8 *pal, I64 tw, I64 th, I64 mod_r, I64 mod_g, I64 mod_b)
{
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 sozl;
	F64	 sozr;
	F64	 tozl;
	F64	 tozr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 sozi;
	F64	 tozi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;
		sozl  = 0.0;
		sozr  = 0.0;
		tozl  = 0.0;
		tozr  = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);
				sozi = v[i].s_over_z + frac * (v[j].s_over_z - v[i].s_over_z);
				tozi = v[i].t_over_z + frac * (v[j].t_over_z - v[i].t_over_z);

				if (!found)
				{
					xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					}
				}
			}
		}

		if (found && xr > xl)
		{
			HLDrawBeamSpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)),
				izl, sozl, tozl, izr, sozr, tozr,
				texels, pal, tw, th, mod_r, mod_g, mod_b);
		}
	}
}

U0 HLDrawBeam(CHLCanvas *c, F64 *start, F64 *end,
	U8 *texels, U8 *pal, I64 tw, I64 th,
	F64 width, F64 amplitude, F64 scroll, F64 time,
	I64 r = 255, I64 g = 255, I64 b = 255, I64 brightness = 255)
{//one beam from start to end
	CHLPolyVert		quad[4];
	CHLPolyVert		clipped[HLMAX_POLY_VERTS];
	CHLScreenVert	scr[HLMAX_POLY_VERTS];
	F64	edge_a[HLBEAM_PTS * 3];
	F64	edge_b[HLBEAM_PTS * 3];
	F64	tex_t[HLBEAM_PTS];
	F64	dir[3];
	F64	nrm[3];
	F64	ptv[3];
	F64	pt[3];
	F64	rel[3];
	F64	len;
	F64	half;
	F64	hw;
	F64	frac;
	F64	phase;
	F64	wave;
	F64	ang;
	F64	disp;
	F64	cz;
	F64	px_w;
	F64	inv_z;
	I64	mod_r;
	I64	mod_g;
	I64	mod_b;
	I64	segs;
	I64	count;
	I64	i;
	I64	k;

	if (!hl_r_beams)
		return;

	if (!c || !c->pixels || !c->depth || !texels || !pal)
		return;

	if (tw < 1 || th < 1)
		return;

	HLVecSub(end, start, dir);
	len = HLVecNormalize(dir);

	if (len < 1.0)
		return;

	if (width < 0.1)
		width = 0.1;
	half = width * 0.5;

	mod_r = ClampI64(r, 0, 255) * ClampI64(brightness, 0, 255) / 255;
	mod_g = ClampI64(g, 0, 255) * ClampI64(brightness, 0, 255) / 255;
	mod_b = ClampI64(b, 0, 255) * ClampI64(brightness, 0, 255) / 255;

	if (!(mod_r | mod_g | mod_b))
		return;

	segs = 1;
	if (amplitude > 0.0)
	{
		segs = ToI64(len / HLBEAM_SEG_LEN);
		if (segs < 2)
			segs = 2;
		if (segs > HLBEAM_SEG_MAX)
			segs = HLBEAM_SEG_MAX;
	}

	phase = time * scroll / HLBEAM_TEX_REPEAT;
	phase -= Floor(phase);

	wave = time * HLBEAM_NOISE_RATE;

	for (i = 0; i <= segs; i++)
	{
		frac = ToF64(i) / ToF64(segs);
		HLVecMA(start, len * frac, dir, pt);

		HLVecSub(pt, c->origin, ptv);

		HLVecCross(dir, ptv, nrm);

		if (HLVecNormalize(nrm) < 0.001)
			HLVecCopy(c->up, nrm);

		if (amplitude > 0.0)
		{
			ang  = frac * HLBEAM_NOISE_CYCLES * 2.0 * pi;
			disp = Sin(ang + wave) * 0.6 + Sin(ang * 2.7 - wave * 1.3) * 0.4;
			disp *= Sin(frac * pi) * amplitude;

			HLVecMA(pt, disp, nrm, pt);
			HLVecSub(pt, c->origin, ptv);
		}

		cz = HLVecDot(ptv, c->forward);

		hw = half;
		if (cz > HLNEAR_CLIP)
		{
			px_w = hw * c->x_scale / cz;
			if (px_w < HLBEAM_MIN_PX)
				hw = HLBEAM_MIN_PX * cz / c->x_scale;
		}

		HLVecMA(ptv, -hw, nrm, rel);
		edge_a[i * 3]     = HLVecDot(rel, c->right);
		edge_a[i * 3 + 1] = HLVecDot(rel, c->up);
		edge_a[i * 3 + 2] = HLVecDot(rel, c->forward);

		HLVecMA(ptv, hw, nrm, rel);
		edge_b[i * 3]     = HLVecDot(rel, c->right);
		edge_b[i * 3 + 1] = HLVecDot(rel, c->up);
		edge_b[i * 3 + 2] = HLVecDot(rel, c->forward);

		tex_t[i] = (phase + frac * len / HLBEAM_TEX_REPEAT) * ToF64(th);
	}

	for (i = 0; i < segs; i++)
	{
		quad[0].cam[0] = edge_a[i * 3];
		quad[0].cam[1] = edge_a[i * 3 + 1];
		quad[0].cam[2] = edge_a[i * 3 + 2];
		quad[0].s      = 0.0;
		quad[0].t      = tex_t[i];
		quad[0].light  = 0.0;

		quad[1].cam[0] = edge_b[i * 3];
		quad[1].cam[1] = edge_b[i * 3 + 1];
		quad[1].cam[2] = edge_b[i * 3 + 2];
		quad[1].s      = ToF64(tw);
		quad[1].t      = tex_t[i];
		quad[1].light  = 0.0;

		quad[2].cam[0] = edge_b[(i + 1) * 3];
		quad[2].cam[1] = edge_b[(i + 1) * 3 + 1];
		quad[2].cam[2] = edge_b[(i + 1) * 3 + 2];
		quad[2].s      = ToF64(tw);
		quad[2].t      = tex_t[i + 1];
		quad[2].light  = 0.0;

		quad[3].cam[0] = edge_a[(i + 1) * 3];
		quad[3].cam[1] = edge_a[(i + 1) * 3 + 1];
		quad[3].cam[2] = edge_a[(i + 1) * 3 + 2];
		quad[3].s      = 0.0;
		quad[3].t      = tex_t[i + 1];
		quad[3].light  = 0.0;

		count = HLDrawClipNear(quad, 4, clipped);
		if (count < 3)
			goto qbm_next;

		for (k = 0; k < count; k++)
		{
			inv_z = 1.0 / clipped[k].cam[2];

			scr[k].x = c->center_x + clipped[k].cam[0] * c->x_scale * inv_z;
			scr[k].y = c->center_y - clipped[k].cam[1] * c->y_scale * inv_z;

			scr[k].inv_z    = inv_z;
			scr[k].s_over_z = clipped[k].s * inv_z;
			scr[k].t_over_z = clipped[k].t * inv_z;
			scr[k].light    = 0.0;
		}

		HLDrawBeamQuad(c, scr, count, texels, pal, tw, th,
			mod_r, mod_g, mod_b);

qbm_next:
	}

	hl_rs_beams++;
}
