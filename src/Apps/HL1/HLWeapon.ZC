		"idle1", "fire1", "reload", "draw1", "weapons/xbow_fire1.wav");

	//shotgun: six pellets at VECTOR_CONE_10DEGREES out to 2048, twelve on the
	//double barrel. the SDK reloads this one shell at a time; here it is a
	//single bulk reload, with the same foley and the same pump timings
	HLWeaponSetInfo(HLWPN_SHOTGUN, "weapon_shotgun", "shotgun",
		"models/v_shotgun.mdl", 2, 1,
		HLAMMO_BUCKSHOT, 8, 12,
