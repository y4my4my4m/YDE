//top-level, so the state is sane before any frame
HLWeaponInit;

//--- inventory queries ------------------------------------------------------

I64 HLWeaponPool(I64 id)
{//rounds in the pool the weapon draws from, 0 for the crowbar
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return 0;

	w = &hl_wpn_info[id];

	if (w->ammo == HLAMMO_NONE)
		return 0;

	return hl_wpn_ammo[w->ammo];
}

Bool HLWeaponCanFire(I64 id)
{//can the trigger do anything, ignoring the refire timer
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT || !hl_wpn_have[id])
		return FALSE;

	w = &hl_wpn_info[id];

	//melee never runs dry
	if (w->ammo == HLAMMO_NONE)
		return TRUE;

	if (w->max_clip == HLWPN_NOCLIP)
		return ToBool(hl_wpn_ammo[w->ammo] > 0);

	return ToBool(hl_wpn_clip[id] > 0);
}

I64 HLWeaponFindByClass(U8 *classname)
{//weapon_* classname to id, -1 when not in the table
	I64 i;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		if (!StrICompare(hl_wpn_info[i].classname, classname))
			return i;
	}

	return -1;
}

//--- view model -------------------------------------------------------------

I64 HLWeaponSeqFind(CHLStudio *m, U8 *label)
{//sequence index by label, -1 when the model has no such sequence
	I64 i;

	if (!m || !label || !label[0])
		return -1;

	for (i = 0; i < m->num_seqs; i++)
	{
		if (!StrICompare(m->seqs[i].label, label))
			return i;
	}

	return -1;
}

U0 HLWeaponVmAnim(U8 *label, Bool loop)
{//SendWeaponAnim. an unknown label falls back to sequence 0 rather than
 //holding the current animation - a missing label is a data problem and a
 //frozen gun hides it
	I64 seq;

	if (!hl_wpn_vm)
		return;

	seq = HLWeaponSeqFind(hl_wpn_vm, label);

	if (seq < 0)
		seq = 0;

	hl_wpn_vm_seq      = seq;
	hl_wpn_vm_cycle    = 0.0;
	hl_wpn_vm_loop     = loop;
	hl_wpn_vm_done     = FALSE;
	hl_wpn_vm_ev_frame = -1;
}

U0 HLWeaponVmEvents()
{//Client-side animation events on the view model.
 //
 //A weapon's reload foley lives here and nowhere else: the SDK plays no sound
 //from CBasePlayerWeapon::Reload, it sends the animation and the client fires
 //the model's 5004 events. Without this a reload is silent.
 //
 //Fired for the frame range the tick stepped over, not the frame it landed on:
 //at 72Hz over a 30fps sequence a single-frame test drops most events.
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 cycle;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!hl_wpn_vm || !hl_wpn_vm->events)
		return;

	if (hl_wpn_vm_seq < 0 || hl_wpn_vm_seq >= hl_wpn_vm->num_seqs)
		return;

	sq = &hl_wpn_vm->seqs[hl_wpn_vm_seq];

	if (sq->num_events < 1)
		return;

	cycle = hl_wpn_vm_cycle;

	if (cycle < 0.0)	cycle = 0.0;
	if (cycle > 1.0)	cycle = 1.0;

	frame = ToI64(cycle * ToF64(sq->num_frames - 1));

	if (frame < 0)						frame = 0;
	if (frame > sq->num_frames - 1)		frame = sq->num_frames - 1;

	last = hl_wpn_vm_ev_frame;

	//A wrapped loop or a fresh sequence replays the list from the start.
	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &hl_wpn_vm->events[sq->first_event + i];

		if (ev->frame <= last || ev->frame > frame)
			goto qwve_next;

		//The player's own weapon: 2D, attenuation 0, so it does not fade with
		//the listener's own position.
		if (ev->code == HLST_EV_CL_SOUND && ev->options[0])
			HLSndPlayAt(ev->options, hl_snd_listener, 1.0, 0.0, 0,
				HLENT_CHAN_USE);

		//5001 is the muzzle flash. It needs attachment 0, which the studio
		//layer does not decode.

qwve_next:
	}

	hl_wpn_vm_ev_frame = frame;
}

U0 HLWeaponSetActive(I64 id)
{//CBasePlayer::SelectItem - holster the old, deploy the new
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT || !hl_wpn_have[id])
		return;

	//CBasePlayerWeapon::Holster - whatever the old weapon was in the middle of
	//is cancelled, and none of it survives the switch. A primed grenade is the
	//exception in the SDK: CHandGrenade::CanHolster refuses while the pin is
	//out, so the switch is simply not allowed
	if (hl_wpn_active == HLWPN_HANDGRENADE && hl_wpn_gren_start != 0.0)
		return;

	hl_wpn_egon_on       = FALSE;
	hl_wpn_gauss_state   = 0;
	hl_wpn_gauss_primary = FALSE;
	hl_wpn_zoom_fov      = 0;
	hl_wpn_gren_start    = 0.0;

	hl_wpn_active    = id;
	hl_wpn_reloading = HLWPN_NONE;

	w = &hl_wpn_info[id];

	//the studio cache owns the model, so re-selecting a weapon costs a lookup,
	//not a load
	if (hl_wpn_vm_for != id)
	{
		hl_wpn_vm     = HLStudioCacheGet(w->view_model);
		hl_wpn_vm_for = id;
	}

	HLWeaponVmAnim(w->seq_draw, FALSE);

	//DefaultDeploy sets m_pPlayer->m_flNextAttack, which is on the player and
	//not on the weapon, so it holds BOTH triggers for half a second. Gating only
	//the primary let a freshly drawn weapon fire its secondary instantly
	hl_wpn_next[id]  = hl_ent_time + 0.5;
	hl_wpn_next2[id] = hl_ent_time + 0.5;
}

//--- giving -----------------------------------------------------------------

Bool HLWeaponGiveAmmo(I64 type, I64 count)
{//CBasePlayer::GiveAmmo. FALSE when the pool is full, which leaves an ammo box
 //in the world instead of consuming it
	I64 room;

	if (type < 0 || type >= HLAMMO_COUNT || count <= 0)
		return FALSE;

	room = hl_wpn_ammo_max[type] - hl_wpn_ammo[type];

	if (room <= 0)
		return FALSE;

	if (count > room)
		count = room;

	hl_wpn_ammo[type] += count;

	return TRUE;
}

Bool HLWeaponGive(I64 id)
{//CBasePlayer::AddPlayerItem. a duplicate weapon is not a failed pickup - the
 //SDK keeps the ammo and drops the duplicate - so TRUE means anything at all
 //was taken
	CHLWeaponInfo	*w;
	Bool			 took = FALSE;

	if (id < 0 || id >= HLWPN_COUNT)
		return FALSE;

	w = &hl_wpn_info[id];

	if (!hl_wpn_have[id])
	{
		hl_wpn_have[id] = TRUE;
		hl_wpn_next[id] = 0.0;

		//a fresh weapon arrives with a full clip out of m_iDefaultAmmo, and
		//the rest of the default goes to the pool
		if (w->max_clip == HLWPN_NOCLIP)
			hl_wpn_clip[id] = 0;
		else
		{
			hl_wpn_clip[id] = w->give;

			if (hl_wpn_clip[id] > w->max_clip)
				hl_wpn_clip[id] = w->max_clip;
		}

		took = TRUE;

		if (w->give > hl_wpn_clip[id] && w->ammo != HLAMMO_NONE)
			HLWeaponGiveAmmo(w->ammo, w->give - hl_wpn_clip[id]);

		//empty handed until now: HL deploys the first weapon picked up
		if (hl_wpn_active == HLWPN_NONE)
			HLWeaponSetActive(id);
	}
	else if (w->ammo != HLAMMO_NONE && w->give > 0)
	{
		//already owned: the duplicate is worth its default ammo
		took = HLWeaponGiveAmmo(w->ammo, w->give);
	}

	return took;
}

U0 HLWeaponGiveAll()
{//CBasePlayer::CheatImpulseCommands case 101, the gEvilImpulse101 list.
 //
 //The SDK order is item_suit, item_battery, then every weapon with its ammo.
 //gEvilImpulse101 suppresses the pickup sound and the "you got" message for the
 //whole block, which is why this does not go through HLWeaponPickups.
 //
 //Fifteen of the twenty-four items in that list need the projectile path or a
 //charged/beam weapon and do not exist here. Reported rather than skipped
 //silently: an empty slot after a give-all otherwise reads as a bug.
	U8	line[96];
	I64	i;

	hl_ent_player_suit  = TRUE;
	hl_ent_player_armor = HLENT_MAX_ARMOR;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		HLWeaponGive(i);

		//The list gives the weapon and then its ammo box, so the pool fills
		//past the clip the weapon arrived with.
		if (hl_wpn_info[i].ammo != HLAMMO_NONE)
			HLWeaponGiveAmmo(hl_wpn_info[i].ammo,
				hl_wpn_ammo_max[hl_wpn_info[i].ammo]);
	}

	for (i = 0; i < HLAMMO_COUNT; i++)
		hl_wpn_ammo[i] = hl_wpn_ammo_max[i];

	StrPrint(line, "impulse 101: %d weapons, suit and full ammo\n", HLWPN_COUNT);
	HLLog(line);

	"%s", line;
	"impulse 101: the full gEvilImpulse101 list. The egon and gauss beams and\n"
	"             the grenade bodies have no visual - see the header.\n";
}

//--- gamerules --------------------------------------------------------------
//
// CHalfLifeRules, the single player set: no respawning items, no team play, no
// weapon stay, no ammo scaling.
//
// CHalfLifeRules::PlayerSpawn hands out no weapon - the crowbar and glock on
// spawn are the multiplayer rule. Single player starts empty handed.

U0 HLWeaponPlayerSpawn()
{//health 100, armour 0, nothing in hand
	I64 i;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		hl_wpn_have[i] = FALSE;
		hl_wpn_clip[i] = 0;
		hl_wpn_next[i] = 0.0;
	}

	for (i = 0; i < HLAMMO_COUNT; i++)
		hl_wpn_ammo[i] = 0;

	hl_wpn_active      = HLWPN_NONE;
	hl_wpn_reloading   = HLWPN_NONE;
	hl_wpn_reload_done = 0.0;
	hl_wpn_sel_slot    = -1;
	hl_wpn_sel_pos     = -1;
	hl_wpn_picked      = 0;

	for (i = 0; i < HLWPN_COUNT; i++)
		hl_wpn_next2[i] = 0.0;

	//nothing the player put in the air survives a respawn
	for (i = 0; i < HLPROJ_MAX; i++)
		hl_proj[i].kind = HLPRJ_FREE;

	hl_proj_live = 0;

	hl_wpn_pump_time     = 0.0;
	hl_wpn_gren_start    = 0.0;
	hl_wpn_satchel_ready = 0;
	hl_wpn_gauss_state   = 0;
	hl_wpn_gauss_primary = FALSE;
	hl_wpn_egon_on       = FALSE;
	hl_wpn_hornet_phase  = 0;
	hl_wpn_hornet_charge = 0.0;
	hl_wpn_spot_on       = FALSE;
	hl_wpn_spot_valid    = FALSE;
	hl_wpn_zoom_fov      = 0;

	hl_wpn_vm     = NULL;
	hl_wpn_vm_for = HLWPN_NONE;

	//health and armour belong to HLEntity.ZC, whose reset sets the numbers
	//CHalfLifeRules wants - 100 and 0. calling it keeps one owner for those
	//two fields
	HLEntPlayerReset;

	//inventory does not survive a changelevel. HL carries it across in the
	//transition save; there is no level transition state here.
}

//--- pickups ----------------------------------------------------------------

I64 HLWeaponAmmoForClass(U8 *classname, I64 *_count)
{//ammo_* classname to (pool, rounds). AMMO_*_GIVE from weapons.h
 //
 //a chain rather than a table, for the reason given at HLEntModelForClass
	*_count = 0;

	//AMMO_GLOCKCLIP_GIVE is GLOCK_MAX_CLIP
	if (!StrICompare(classname, "ammo_9mmclip"))
	{
		*_count = 17;
		return HLAMMO_9MM;
	}

	if (!StrICompare(classname, "ammo_glockclip"))
	{
		*_count = 17;
		return HLAMMO_9MM;
	}

	//AMMO_CHAINBOX_GIVE - the big box, and ammo_mp5clip is an alias of the
	//9mm clip in the SDK's LINK_ENTITY_TO_CLASS list
	if (!StrICompare(classname, "ammo_9mmbox"))
	{
		*_count = 200;
		return HLAMMO_9MM;
	}

	if (!StrICompare(classname, "ammo_9mmAR") ||
		!StrICompare(classname, "ammo_mp5clip"))
	{
		*_count = 50;
		return HLAMMO_9MM;
	}

	//AMMO_BUCKSHOTBOX_GIVE
	if (!StrICompare(classname, "ammo_buckshot"))
	{
		*_count = 12;
		return HLAMMO_BUCKSHOT;
	}

	//AMMO_357BOX_GIVE is PYTHON_MAX_CLIP
	if (!StrICompare(classname, "ammo_357"))
	{
		*_count = 6;
		return HLAMMO_357;
	}

	//AMMO_M203BOX_GIVE
	if (!StrICompare(classname, "ammo_ARgrenades") ||
		!StrICompare(classname, "ammo_mp5grenades"))
	{
		*_count = 2;
		return HLAMMO_ARGRENADE;
	}

	//AMMO_CROSSBOWCLIP_GIVE is CROSSBOW_MAX_CLIP
	if (!StrICompare(classname, "ammo_crossbow"))
	{
		*_count = 5;
		return HLAMMO_BOLT;
	}

	//AMMO_RPGCLIP_GIVE is RPG_MAX_CLIP
	if (!StrICompare(classname, "ammo_rpgclip"))
	{
		*_count = 1;
		return HLAMMO_ROCKET;
	}

	//AMMO_URANIUMBOX_GIVE, shared by the gauss and the egon
	if (!StrICompare(classname, "ammo_gaussclip") ||
		!StrICompare(classname, "ammo_egonclip"))
	{
		*_count = 20;
		return HLAMMO_URANIUM;
	}

	//the throwables have no ammo_* entity of their own: the weapon_* pickup is
	//ITEM_FLAG_EXHAUSTIBLE and carries its own count, which HLWeaponGive
	//already handles

	return HLAMMO_NONE;
}

U0 HLWeaponPickups(CHLMap *map, F64 *player_org)
{//CBasePlayerItem::Touch, driven from the player box rather than from the
 //engine's touch list: weapon_* and ammo_* are not classes HLEntSpawnOne
 //knows, so they are never linked as solid and HLEntTouchPlayer skips them
	CHLEntity	*e;
	F64			 pmins[3];
	F64			 pmaxs[3];
	F64			 imins[3];
	F64			 imaxs[3];
	I64			 i;
	I64			 id;
	I64			 type;
	I64			 count = 0;
	Bool		 took;

	if (!hl_entities || !map || !player_org)
		return;

	for (i = 0; i < 3; i++)
	{
		pmins[i] = player_org[i] + hl_player_mins[i];
		pmaxs[i] = player_org[i] + hl_player_maxs[i];
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->brush_model >= 0)
			goto qwp_next;

		//"weapon_" / "ammo_" prefix first, so the two StrICompare chains below
		//are only walked for entities that could match at all
		id   = -1;
		type = HLAMMO_NONE;

		if (!StrNICompare(e->classname, "weapon_", 7))
			id = HLWeaponFindByClass(e->classname);
		else if (!StrNICompare(e->classname, "ammo_", 5))
			type = HLWeaponAmmoForClass(e->classname, &count);

		if (id < 0 && type == HLAMMO_NONE)
			goto qwp_next;

		//UTIL_SetSize(-16,-16,0)..(16,16,16), rebuilt from the origin
		imins[0] = e->origin[0] - HLWPN_ITEM_HALF;
		imins[1] = e->origin[1] - HLWPN_ITEM_HALF;
		imins[2] = e->origin[2];
		imaxs[0] = e->origin[0] + HLWPN_ITEM_HALF;
		imaxs[1] = e->origin[1] + HLWPN_ITEM_HALF;
		imaxs[2] = e->origin[2] + HLWPN_ITEM_TOP;

		if (pmaxs[0] < imins[0] || pmins[0] > imaxs[0])
			goto qwp_next;
		if (pmaxs[1] < imins[1] || pmins[1] > imaxs[1])
			goto qwp_next;
		if (pmaxs[2] < imins[2] || pmins[2] > imaxs[2])
			goto qwp_next;

		took = FALSE;

		if (id >= 0)
		{
			took = HLWeaponGive(id);

			if (took)
				HLSndPlayAt("items/gunpickup2.wav", e->origin, 1.0,
					HLENT_SND_ATTEN);
		}
		else
		{
			took = HLWeaponGiveAmmo(type, count);

			if (took)
				HLSndPlayAt("items/9mmclip1.wav", e->origin, 1.0,
					HLENT_SND_ATTEN);
		}

		//a full pool leaves the box in the world, as the SDK does
		if (!took)
			goto qwp_next;

		hl_wpn_picked++;

		//CHalfLifeRules::FlItemRespawnTime returns -1 in single player, so a
		//taken item is gone for good. HLM_REMOVE is queued rather than done
		//here because the entity list is being walked
		HLEntQueueCall(i, HLM_REMOVE, hl_ent_player, HLUSE_TOGGLE, 0.0);

		//the item's own target fires on pickup, as a scripted pickup trigger
		//expects
		if (e->target[0])
			HLEntUseTargets(i, hl_ent_player, HLUSE_TOGGLE, 0.0);

qwp_next:
	}

	HLEntDrainCalls();
}

//--- projectiles ------------------------------------------------------------
//
// The pool declared at the top of the file. One step per weapon tick: gravity,
// one world trace over the step, then the kind's touch behaviour.
//
// Movement mirrors SV_Physics_Toss. A bouncing kind reflects with backoff
// 2.0 - friction, which is the GoldSrc figure, and comes to rest on a floor
// plane once it is slow enough - the vecTestVelocity test in
// CGrenade::BounceTouch. A flying kind detonates or sticks on first contact.

I64 HLProjAlloc()
{//first free slot. -1 when saturated, which drops the shot rather than
 //growing the pool - hl_entities cannot allocate at runtime, see the header
	I64 i;

	for (i = 0; i < HLPROJ_MAX; i++)
	{
		if (hl_proj[i].kind == HLPRJ_FREE)
			return i;
	}

	hl_proj_dropped++;

	return -1;
}

U0 HLProjFree(I64 i)
{//UTIL_Remove
	if (i < 0 || i >= HLPROJ_MAX)
		return;

	hl_proj[i].kind = HLPRJ_FREE;
}

I64 HLProjSpawn(I64 kind, F64 *org, F64 *vel, F64 damage, F64 life,
	F64 gravity, F64 friction, Bool bounce, I64 owner)
{//the common half of CGrenade::Shoot* - place it, aim it, start its clock
	CHLProj	*p;
	I64		 i;

	i = HLProjAlloc;

	if (i < 0)
		return -1;

	p = &hl_proj[i];

	p->kind = kind;

	HLVecCopy(org, p->org);
	HLVecCopy(vel, p->vel);
	HLVecCopy(vel, p->dir);
	HLVecNormalize(p->dir);

	p->gravity   = gravity;
	p->friction  = friction;
	p->damage    = damage;
	p->bounce    = bounce;
	p->on_ground = FALSE;
	p->armed     = FALSE;
	p->owner     = owner;
	p->beam_len  = 0.0;
	p->arm       = 0.0;
	p->next_hurt = 0.0;
	p->next_hop  = 0.0;

	if (life > 0.0)
		p->die = hl_ent_time + life;
	else
		p->die = 0.0;

	return i;
}

U0 HLWeaponRadiusDamage(CHLMap *map, F64 *src, F64 damage, F64 radius,
	I64 attacker)
{//::RadiusDamage, dlls/combat.cpp. linear falloff over the radius, and the
 //blast has to be able to see the target - a wall between the two stops it
	CHLEntity	*e;
	CHLTrace	 tr;
	F64			 spot[3];
	F64			 from[3];
	F64			 zero[3];
	F64			 delta[3];
	F64			 falloff;
	F64			 dist;
	F64			 hurt;
	I64			 i;

	if (!hl_entities || !map || radius <= 0.0)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	falloff = damage / radius;

	//"in case grenade is lying on the ground"
	HLVecCopy(src, from);
	from[2] += 1.0;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->takedamage == HLDMG_TAKE_NO)
			goto qwrd_next;

		//BodyTarget is the middle of the box. absmin/absmax are only rebuilt
		//for entities the spawn pass linked, so fall back to the origin
		if (e->absmax[0] > e->absmin[0] || e->absmax[2] > e->absmin[2])
		{
			spot[0] = (e->absmin[0] + e->absmax[0]) * 0.5;
			spot[1] = (e->absmin[1] + e->absmax[1]) * 0.5;
			spot[2] = (e->absmin[2] + e->absmax[2]) * 0.5;
		}
		else
			HLVecCopy(e->origin, spot);

		HLVecSub(spot, from, delta);
		dist = HLVecLength(delta);

		if (dist > radius)
			goto qwrd_next;

		//can the explosion see it
		HLTraceEntity(map, from, spot, zero, zero, hl_move_pass, FALSE, &tr);

		if (tr.fraction < 1.0 && tr.ent != i)
			goto qwrd_next;

		hurt = damage - dist * falloff;

		if (hurt <= 0.0)
			goto qwrd_next;

		HLEntTakeDamage(i, attacker, hurt);

qwrd_next:
	}

	HLEntDrainCalls();
}

U0 HLProjExplode(CHLMap *map, I64 i)
{//CGrenade::Explode - the fireball, the blast, the debris, then gone
	CHLProj	*p;
	F64		 dmg;
	I64		 pick;

	if (i < 0 || i >= HLPROJ_MAX)
		return;

	p   = &hl_proj[i];
	dmg = p->damage;

	//the sprite scale the SDK writes is (dmg - 50) * 0.6; HLFxExplosionCreate
	//takes the magnitude and does that arithmetic itself
	HLFxExplosionCreate(map, p->org, ToI64(dmg), tS);

	//CBaseMonster::RadiusDamage - the blast reaches dmg * 2.5
	HLWeaponRadiusDamage(map, p->org, dmg, dmg * 2.5, p->owner);

	pick = HLPartRandI(3);

	if (pick == 0)
		HLSndPlayAt("weapons/debris1.wav", p->org, 0.55, HLENT_SND_ATTEN);
	else if (pick == 1)
		HLSndPlayAt("weapons/debris2.wav", p->org, 0.55, HLENT_SND_ATTEN);
	else
		HLSndPlayAt("weapons/debris3.wav", p->org, 0.55, HLENT_SND_ATTEN);

	HLProjFree(i);
}

U0 HLProjBounceSound(F64 *org)
{//CGrenade::BounceSound
	I64 pick = HLPartRandI(3);

	if (pick == 0)
		HLSndPlayAt("weapons/grenade_hit1.wav", org, 0.25, HLENT_SND_ATTEN);
	else if (pick == 1)
		HLSndPlayAt("weapons/grenade_hit2.wav", org, 0.25, HLENT_SND_ATTEN);
	else
		HLSndPlayAt("weapons/grenade_hit3.wav", org, 0.25, HLENT_SND_ATTEN);
}

U0 HLProjBoltTouch(CHLMap *map, I64 i, CHLTrace *tr)
{//CCrossbowBolt::BoltTouch. into flesh it stops and does its damage; into
 //architecture it backs out twelve units and stands there for ten seconds
	CHLProj	*p = &hl_proj[i];
	I64		 hit;

	hit = hl_trace_native_ent;

	if (hit >= 0)
	{
		//plrDmgCrossbowMonster. plrDmgCrossbowClient (10) is the player-on-
		//player figure and no native entity is a player
		HLEntTakeDamage(hit, p->owner, p->damage);
		HLEntDrainCalls();

		if (HLPartRandI(2) == 0)
			HLSndPlayAt("weapons/xbow_hitbod1.wav", tr->end_pos, 1.0,
				HLENT_SND_ATTEN);
		else
			HLSndPlayAt("weapons/xbow_hitbod2.wav", tr->end_pos, 1.0,
				HLENT_SND_ATTEN);

		HLProjFree(i);
		return;
	}

	HLSndPlayAt("weapons/xbow_hit1.wav", tr->end_pos, 1.0, HLENT_SND_ATTEN);
	HLFxSparks(tr->end_pos, tS);

	//stands in the wall, twelve units back along its flight
	HLVecMA(tr->end_pos, -12.0, p->dir, p->org);
	HLVecSet(p->vel, 0.0, 0.0, 0.0);

	p->kind = HLPRJ_STUCK;
	p->die  = hl_ent_time + HLPRJ_BOLT_STICK;
}

U0 HLProjTouch(CHLMap *map, I64 i, CHLTrace *tr)
{//the SetTouch handler for whichever kind this slot is
	CHLProj	*p = &hl_proj[i];
	F64		 back;
	F64		 dot;
	F64		 speed;
	I64		 hit;

	if (p->kind == HLPRJ_BOLT)
	{
		HLProjBoltTouch(map, i, tr);
		return;
	}

	//CGrenade::ExplodeTouch and CRpgRocket::RocketTouch
	if (p->kind == HLPRJ_CONTACT || p->kind == HLPRJ_ROCKET)
	{
		HLVecCopy(tr->end_pos, p->org);
		HLProjExplode(map, i);
		return;
	}

	//CHornet: one hit, one lot of damage, gone
	if (p->kind == HLPRJ_HORNET)
	{
		hit = hl_trace_native_ent;

		if (hit >= 0)
		{
			HLEntTakeDamage(hit, p->owner, p->damage);
			HLEntDrainCalls();
		}

		HLPartEffect(tr->end_pos, tr->plane_normal, 0, 8, tS);
		HLProjFree(i);
		return;
	}

	//everything left bounces: CGrenade::BounceTouch and
	//CSatchelCharge::SatchelSlide
	HLVecCopy(tr->end_pos, p->org);

	//a bouncing grenade clubs what it lands on for 1, debounced a second
	hit = hl_trace_native_ent;
	speed = HLVecLength(p->vel);

	if (hit >= 0 && speed > 100.0 && hl_ent_time > p->next_hurt)
	{
		HLEntTakeDamage(hit, p->owner, 1.0);
		HLEntDrainCalls();
		p->next_hurt = hl_ent_time + 1.0;
	}

	//SV_Physics_Toss: backoff 2.0 - friction for MOVETYPE_BOUNCE
	back = 2.0 - p->friction;

	dot = HLVecDot(p->vel, tr->plane_normal);
	HLVecMA(p->vel, -back * dot, tr->plane_normal, p->vel);

	//come to rest on a floor once slow enough. the SDK trims z by 0.55 before
	//the test because a grenade dropped straight down decelerates too fast to
	//catch on speed alone
	if (tr->plane_normal[2] > 0.7)
	{
		speed = Sqrt(p->vel[0] * p->vel[0] + p->vel[1] * p->vel[1] +
			p->vel[2] * 0.45 * p->vel[2] * 0.45);

		if (speed <= HLPRJ_REST_SPEED)
		{
			HLVecSet(p->vel, 0.0, 0.0, 0.0);
			p->on_ground = TRUE;
			return;
		}

		//static friction while it is still rolling
		HLVecScale(p->vel, 0.8, p->vel);
		return;
	}

	//a satchel slides rather than rattling
	if (p->kind == HLPRJ_SATCHEL)
		HLVecScale(p->vel, 0.95, p->vel);
	else
		HLProjBounceSound(p->org);
}

U0 HLProjMineThink(CHLMap *map, I64 i)
{//CTripmineGrenade::PowerupThink and BeamBreakThink. the beam is a trace down
 //the surface normal; once armed, anything that shortens it sets the mine off
	CHLProj		*p = &hl_proj[i];
	CHLTrace	 tr;
	F64			 end[3];
	F64			 zero[3];
	F64			 len;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecMA(p->org, HLPRJ_MINE_BEAM, p->dir, end);

	HLTraceEntity(map, p->org, end, zero, zero, hl_move_pass, FALSE, &tr);

	len = HLPRJ_MINE_BEAM * tr.fraction;

	if (!p->armed)
	{
		if (hl_ent_time < p->arm)
			return;

		//the length at the moment it goes live is the reference
		p->armed    = TRUE;
		p->beam_len = len;

		HLSndPlayAt("weapons/mine_activate.wav", p->org, 0.5, HLENT_SND_ATTEN);
		return;
	}

	//BeamBreakThink allows a little slack before it calls the beam broken
	if (len < p->beam_len - 8.0)
		HLProjExplode(map, i);
}

U0 HLProjSnarkThink(I64 i)
{//CSqueakGrenade::HuntThink, minus the hunt.
 //
 //The SDK's snark picks a monster out of the world and steers at it. There is
 //no monster list here, so all that is left is the ground hop: on a surface it
 //keeps 90% of its speed and gains 8 units of lift, which is what makes it
 //skitter. It still bursts on its own timer.
	CHLProj *p = &hl_proj[i];

	if (hl_ent_time < p->next_hop)
		return;

	p->next_hop = hl_ent_time + 0.1;

	if (!p->on_ground)
		return;

	HLVecScale(p->vel, 0.9, p->vel);
	p->vel[2] += 8.0;

	p->on_ground = FALSE;
}

U0 HLProjRocketThink(CHLMap *map, I64 i)
{//CRpgRocket::IgniteThink and FollowThink.
 //
 //The designator is not an entity here - see the header - so the target is
 //hl_wpn_spot_pos, traced live off the eye while the secondary is toggled on.
 //The steering is the SDK's, including the comment that its acceleration
 //arithmetic is wrong but responds well, so it is left alone.
	CHLProj		*p = &hl_proj[i];
	CHLTrace	 tr;
	F64			 target[3];
	F64			 delta[3];
	F64			 zero[3];
	F64			 speed;

	//still coasting on the launch charge
	if (hl_ent_time < p->arm)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	//default heading is straight on
	HLVecCopy(p->dir, target);

	if (hl_wpn_spot_on && hl_wpn_spot_valid)
	{
		HLTraceEntity(map, p->org, hl_wpn_spot_pos, zero, zero, hl_move_pass,
			FALSE, &tr);

		//only steer at a spot it can actually see
		if (tr.fraction >= 0.90)
		{
			HLVecSub(hl_wpn_spot_pos, p->org, delta);

			if (HLVecNormalize(delta) > 0.0)
			{
				if (HLVecDot(p->dir, delta) > 0.0)
					HLVecCopy(delta, target);
			}
		}
	}

	speed = HLVecLength(p->vel);

	//within a second of ignition it is still accelerating
	if (hl_ent_time - p->arm < 1.0)
	{
		HLVecScale(p->vel, 0.2, p->vel);
		HLVecMA(p->vel, speed * 0.8 + 400.0, target, p->vel);

		if (HLVecLength(p->vel) > 2000.0)
		{
			HLVecNormalize(p->vel);
			HLVecScale(p->vel, 2000.0, p->vel);
		}
	}
	else
	{
		HLVecScale(p->vel, 0.2, p->vel);
		HLVecMA(p->vel, speed * 0.798, target, p->vel);

		//a rocket that has bled off its speed detonates where it is
		if (HLVecLength(p->vel) < 1500.0)
		{
			HLProjExplode(map, i);
			return;
		}
	}

	HLVecCopy(p->vel, p->dir);
	HLVecNormalize(p->dir);
}

U0 HLProjFrame(CHLMap *map, F64 dt)
{//one step of every live projectile
	CHLProj		*p;
	CHLTrace	 tr;
	F64			 start[3];
	F64			 end[3];
	F64			 zero[3];
	I64			 i;

	if (!map || dt <= 0.0)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	hl_proj_live = 0;

	for (i = 0; i < HLPROJ_MAX; i++)
	{
		p = &hl_proj[i];

		if (p->kind == HLPRJ_FREE)
			goto qwpf_next;

		hl_proj_live++;

		//--- timers first: a kind can retire without ever moving ---

		if (p->kind == HLPRJ_STUCK)
		{
			if (p->die > 0.0 && hl_ent_time >= p->die)
				HLProjFree(i);

			goto qwpf_next;
		}

		if (p->kind == HLPRJ_TRIPMINE)
		{
			HLProjMineThink(map, i);
			goto qwpf_next;
		}

		//a satchel has no timer at all - it waits for the radio
		if (p->die > 0.0 && hl_ent_time >= p->die)
		{
			//CGrenade::Detonate, CSqueakGrenade::Killed. a hornet just expires
			if (p->kind == HLPRJ_HORNET)
				HLProjFree(i);
			else
			{
				if (p->kind == HLPRJ_SNARK)
					HLSndPlayAt("squeek/sqk_blast1.wav", p->org, 1.0,
						HLENT_SND_ATTEN);

				HLProjExplode(map, i);
			}

			goto qwpf_next;
		}

		if (p->kind == HLPRJ_ROCKET)
			HLProjRocketThink(map, i);

		//HLProjRocketThink can detonate it
		if (p->kind == HLPRJ_FREE)
			goto qwpf_next;

		if (p->kind == HLPRJ_SNARK)
			HLProjSnarkThink(i);

		//--- gravity, then one trace over the step ---

		if (p->gravity > 0.0 && !p->on_ground)
			p->vel[2] -= HLPHYS_GRAVITY * p->gravity * dt;

		HLVecCopy(p->org, start);
		HLVecMA(start, dt, p->vel, end);

		HLTraceEntity(map, start, end, zero, zero, hl_move_pass, FALSE, &tr);

		//a rocket and a bolt leave the only marker the particle layer can
		//supply. there is no mover renderer, so the trail IS the projectile
		if (p->kind == HLPRJ_ROCKET)
			HLPartTrail(start, tr.end_pos, HLTRAIL_ROCKET, tS);
		else if (p->kind == HLPRJ_BOLT)
			HLPartTrail(start, tr.end_pos, HLTRAIL_TRACER, tS);

		HLVecCopy(tr.end_pos, p->org);

		//left the world entirely - IsInWorld in the SDK's think functions
		if (tr.all_solid)
		{
			HLProjFree(i);
			goto qwpf_next;
		}

		if (tr.fraction < 1.0)
		{
			p->on_ground = FALSE;
			HLProjTouch(map, i, &tr);
		}
		else if (p->vel[2] != 0.0 || !p->bounce)
			p->on_ground = FALSE;

qwpf_next:
	}
}

U0 HLProjDetonateSatchels(CHLMap *map)
{//CGrenade::UseSatchelCharges with SATCHEL_DETONATE - every live satchel the
 //player put out goes off at once
	I64 i;

	for (i = 0; i < HLPROJ_MAX; i++)
	{
		if (hl_proj[i].kind == HLPRJ_SATCHEL)
			HLProjExplode(map, i);
	}
}

I64 HLProjCountSatchels()
{//how many are out, which is what m_chargeReady tracks
	I64 i;
	I64 n = 0;

	for (i = 0; i < HLPROJ_MAX; i++)
	{
		if (hl_proj[i].kind == HLPRJ_SATCHEL)
			n++;
	}

	return n;
}

//--- firing -----------------------------------------------------------------

U0 HLWeaponBulletImpact(CHLTrace *tr)
{//the visible half of a bullet hit. no decals: HLDraw has no decal layer, so
 //the hit reads as a puff plus a ricochet
	U8	*snd;
	I64	 pick;

	//the puff comes off the surface, so the plane normal is the direction
	HLPartEffect(tr->end_pos, tr->plane_normal, 0, 8, tS);

	//TE_GUNSHOTDECAL's ricochet, one of five
	pick = HLPartRandI(5);

	if (pick == 0)
		snd = "weapons/ric1.wav";
	else if (pick == 1)
		snd = "weapons/ric2.wav";
	else if (pick == 2)
		snd = "weapons/ric3.wav";
	else if (pick == 3)
		snd = "weapons/ric4.wav";
	else
		snd = "weapons/ric5.wav";

	HLSndPlayAt(snd, tr->end_pos, 0.8, HLENT_SND_ATTEN);
}

U0 HLWeaponFireBullets(CHLMap *map, F64 *src, F64 *forward, F64 *right,
	F64 *up, I64 count, F64 spread, F64 damage, F64 range)
{//FireBulletsPlayer. every shot is a hull trace with a zero-size box, and the
 //spread is applied in the view plane - the cone is around the aim vector, not
 //around a world axis
	CHLTrace	tr;
	F64			 dir[3];
	F64			 end[3];
	F64			 zero[3];
	F64			 x;
	F64			 y;
	I64			 i;
	I64			 hit;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	for (i = 0; i < count; i++)
	{
		//UTIL_SharedRandomFloat pairs, then dir = forward + x*spread*right +
		//y*spread*up
		x = 0.0;
		y = 0.0;

		if (spread > 0.0)
		{
			x = HLPartRand(1.0) * spread;
			y = HLPartRand(1.0) * spread;
		}

		HLVecCopy(forward, dir);
		HLVecMA(dir, x, right, dir);
		HLVecMA(dir, y, up, dir);
		HLVecNormalize(dir);

		HLVecMA(src, range, dir, end);

		HLTraceEntity(map, src, end, zero, zero, hl_move_pass, FALSE, &tr);

		if (tr.fraction >= 1.0 || tr.all_solid)
			goto qwfb_next;

		//hl_trace_native_ent is the native entity the trace settled on, set by
		//HLClipToNativeBrushes inside HLTraceEntity. -1 is the world
		hit = hl_trace_native_ent;

		if (hit >= 0)
			HLEntTakeDamage(hit, hl_ent_player, damage);

		HLWeaponBulletImpact(&tr);

qwfb_next:
	}
}

Bool HLWeaponMelee(CHLMap *map, F64 *src, F64 *forward, F64 damage, F64 range)
{//CCrowbar::Swing. one TraceLine, and the sound says whether it connected.
 //
 //TRUE when it connected: the two branches of Swing set different refire
 //delays - GetNextAttackDelay(0.5) on a miss, GetNextAttackDelay(0.25) on a
 //hit - so the caller needs the outcome
	CHLTrace	tr;
	F64			 end[3];
	F64			 zero[3];
	I64			 hit;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecMA(src, range, forward, end);

	HLTraceEntity(map, src, end, zero, zero, hl_move_pass, FALSE, &tr);

	if (tr.fraction >= 1.0 || tr.all_solid)
	{
		HLSndPlayAt("weapons/cbar_miss1.wav", src, 1.0, HLENT_SND_ATTEN);
		return FALSE;
	}

	hit = hl_trace_native_ent;

	if (hit >= 0)
		HLEntTakeDamage(hit, hl_ent_player, damage);

	//cbar_hitbod* is the flesh variant. monsters have no damage path, so every
	//hit is the world hit
	if (HLPartRandI(2) == 0)
		HLSndPlayAt("weapons/cbar_hit1.wav", tr.end_pos, 1.0, HLENT_SND_ATTEN);
	else
		HLSndPlayAt("weapons/cbar_hit2.wav", tr.end_pos, 1.0, HLENT_SND_ATTEN);

	return TRUE;
}

U0 HLWeaponFireGauss(CHLMap *map, F64 *src, F64 *aim, F64 damage, Bool primary)
{//CGauss::Fire.
 //
 //NO BEAM IS DRAWN. HLDraw has no line primitive, so the visible half of this
 //weapon - the bolt, the reflections, the exit flare - is absent. Everything
 //that decides the outcome is here: the reflect-or-punch test off each
 //surface, the energy the beam loses to each, and the blast a punch-through
 //leaves at its exit. Nothing is faked with a stand-in sprite.
	CHLTrace	tr;
	CHLTrace	beam;
	F64			dir[3];
	F64			from[3];
	F64			dest[3];
	F64			end[3];
	F64			refl[3];
	F64			zero[3];
	F64			n;
	F64			thick;
	F64			radius;
	I64			hits = 10;
	I64			hit;
	Bool		punched = FALSE;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecCopy(aim, dir);
	HLVecCopy(src, from);

	while (damage > 10.0 && hits > 0)
	{
		hits--;

		HLVecMA(from, 8192.0, dir, dest);
		HLTraceEntity(map, from, dest, zero, zero, hl_move_pass, FALSE, &tr);

		if (tr.all_solid)
			return;

		HLVecCopy(tr.end_pos, end);

		hit = hl_trace_native_ent;

		if (hit >= 0)
		{
			HLEntTakeDamage(hit, hl_ent_player, damage);
			HLEntDrainCalls();
		}

		if (tr.fraction >= 1.0)
			return;

		HLPartEffect(end, tr.plane_normal, 0, 8, tS);

		//n is how square-on the hit is. under 0.5 - past sixty degrees - the
		//beam glances off instead of biting in
		n = -HLVecDot(tr.plane_normal, dir);

		if (n < 0.5)
		{
			//r = 2 * normal * n + dir
			HLVecCopy(dir, refl);
			HLVecMA(refl, 2.0 * n, tr.plane_normal, refl);
			HLVecCopy(refl, dir);
			HLVecNormalize(dir);

			HLVecMA(end, 8.0, dir, from);

			//"explode a bit" where it glanced
			HLWeaponRadiusDamage(map, end, damage * n, damage * n * 2.5,
				hl_ent_player);

			if (n == 0.0)
				n = 0.1;

			damage = damage * (1.0 - n);
			goto qwfg_again;
		}

		//one hole punch per shot
		if (punched)
			return;

		punched = TRUE;

		//the primary is incapable of breaking through
		if (primary)
			return;

		HLVecMA(end, 8.0, dir, from);
		HLTraceEntity(map, from, dest, zero, zero, hl_move_pass, FALSE, &beam);

		if (beam.all_solid)
			return;

		//trace back to find where it comes out
		HLVecCopy(beam.end_pos, dest);
		HLTraceEntity(map, dest, end, zero, zero, hl_move_pass, FALSE, &beam);

		HLVecSub(beam.end_pos, end, refl);
		thick = HLVecLength(refl);

		//too thick to punch through and the beam stops
		if (thick >= damage)
			return;

		if (thick == 0.0)
			thick = 1.0;

		damage -= thick;

		//exit blast. single player uses damage * 2.5 for the radius
		radius = damage * 2.5;

		HLVecMA(beam.end_pos, 8.0, dir, from);
		HLWeaponRadiusDamage(map, from, damage, radius, hl_ent_player);

		HLVecMA(beam.end_pos, 1.0, dir, from);

qwfg_again:
	}
}

U0 HLWeaponFireEgon(CHLMap *map, F64 *src, F64 *aim, F64 damage, Bool wide)
{//CEgon::Fire.
 //
 //NO BEAM IS DRAWN, for the same reason as the gauss. The pulse timing, the
 //damage per pulse and the ammo drain are the SDK's; the beam sprite and the
 //impact flare are not available.
	CHLTrace	tr;
	F64			dest[3];
	F64			zero[3];
	I64			hit;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecMA(src, 2048.0, aim, dest);

	HLTraceEntity(map, src, dest, zero, zero, hl_move_pass, FALSE, &tr);

	if (tr.all_solid)
		return;

	//pev->dmgtime: the beam only bites at the pulse interval, not every frame
	if (hl_ent_time < hl_wpn_egon_pulse)
		return;

	hit = hl_trace_native_ent;

	if (hit >= 0)
	{
		HLEntTakeDamage(hit, hl_ent_player, damage);
		HLEntDrainCalls();
	}

	if (tr.fraction < 1.0)
		HLPartEffect(tr.end_pos, tr.plane_normal, 0, 4, tS);

	//EGON_PULSE_INTERVAL and EGON_DISCHARGE_INTERVAL are both 0.1
	hl_wpn_egon_pulse = hl_ent_time + 0.1;

	//single player: wide burns 10 charges a second, narrow 3
	if (hl_ent_time >= hl_wpn_egon_ammo)
	{
		if (hl_wpn_ammo[HLAMMO_URANIUM] > 0)
			hl_wpn_ammo[HLAMMO_URANIUM]--;

		if (wide)
			hl_wpn_egon_ammo = hl_ent_time + 0.1;
		else
			hl_wpn_egon_ammo = hl_ent_time + 0.166;
	}
}

U0 HLWeaponEgonStop()
{//CEgon::EndAttack
	if (!hl_wpn_egon_on)
		return;

	hl_wpn_egon_on = FALSE;

	if (hl_wpn_active >= 0)
	{
		hl_wpn_next[hl_wpn_active]  = hl_ent_time + 0.5;
		hl_wpn_next2[hl_wpn_active] = hl_ent_time + 0.5;

		HLWeaponVmAnim(hl_wpn_info[hl_wpn_active].seq_idle, TRUE);
	}
}

U0 HLWeaponReleaseGauss(CHLMap *map, F64 *eye, F64 *forward)
{//CGauss::StartFire for the charged shot. damage ramps to 200 over the full
 //charge time and the shot goes off when the trigger comes up
 //
 //The recoil is absent: StartFire pushes the player back by damage * 5 along
 //the aim vector, and the player's velocity belongs to HLClip.ZC's move code,
 //not to this file. Single player restores the z component anyway, so what is
 //missing is the horizontal shove only.
	CHLWeaponInfo	*w;
	F64				 charge;
	F64				 damage;
	I64				 id = hl_wpn_active;

	if (id < 0 || hl_wpn_gauss_state == 0)
		return;

	w = &hl_wpn_info[id];

	charge = hl_ent_time - hl_wpn_gauss_start;

	//GetFullChargeTime is 4 in single player
	if (charge > 4.0)
		damage = 200.0;
	else
		damage = 200.0 * (charge / 4.0);

	hl_wpn_gauss_state   = 0;
	hl_wpn_gauss_primary = FALSE;

	HLWeaponVmAnim(w->seq_fire2, FALSE);
	HLSndPlayAt(w->sec_snd, eye, 1.0, 0.0);

	//the charged shot punches through walls; the primary cannot
	HLWeaponFireGauss(map, eye, forward, damage, FALSE);

	hl_wpn_next[id]  = hl_ent_time + 0.2;
	hl_wpn_next2[id] = hl_ent_time + 0.2;
}

Bool HLWeaponTakeRound(I64 id)
{//one round out of the clip, or out of the pool for a clipless weapon
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return FALSE;

	w = &hl_wpn_info[id];

	if (w->ammo == HLAMMO_NONE)
		return TRUE;

	if (w->max_clip == HLWPN_NOCLIP)
	{
		if (hl_wpn_ammo[w->ammo] <= 0)
			return FALSE;

		hl_wpn_ammo[w->ammo]--;
		return TRUE;
	}

	if (hl_wpn_clip[id] <= 0)
		return FALSE;

	hl_wpn_clip[id]--;

	return TRUE;
}

U0 HLWeaponHornetRecharge()
{//CHgun::Reload. The hivehand has no reload in the ordinary sense: the hive
 //grows hornets back one at a time, and PrimaryAttack, SecondaryAttack and
 //WeaponIdle all call this before doing anything else.
 //
 //A while loop rather than one round a tick, because the clock can be several
 //recharge periods behind after a stall.
	if (hl_wpn_ammo[HLAMMO_HORNET] >= hl_wpn_ammo_max[HLAMMO_HORNET])
		return;

	while (hl_wpn_ammo[HLAMMO_HORNET] < hl_wpn_ammo_max[HLAMMO_HORNET] &&
		hl_wpn_hornet_charge < hl_ent_time)
	{
		hl_wpn_ammo[HLAMMO_HORNET]++;
		hl_wpn_hornet_charge += HLWPN_HORNET_RECHARGE;
	}
}

U0 HLWeaponThrowGrenade(F64 *eye, F64 *forward)
{//CHandGrenade::WeaponIdle's throw branch. the pitch is bent by ten degrees
 //and the speed comes off it, so a grenade lobbed upward goes further
	F64	dir[3];
	F64	vel[3];
	F64	src[3];
	F64	flat;
	F64	pitch;
	F64	speed;
	F64	fuse;

	if (hl_wpn_gren_start == 0.0)
		return;

	//pitch out of the view vector: forward[2] is -sin(pitch), and HL counts
	//pitch positive downward
	pitch = -ASin(forward[2]) * 180.0 / 3.14159265358979;

	if (pitch < 0.0)
		pitch = -10.0 + pitch * (80.0 / 90.0);
	else
		pitch = -10.0 + pitch * (100.0 / 90.0);

	speed = (90.0 - pitch) * 6.5;

	if (speed > 1000.0)
		speed = 1000.0;

	//rebuild the throw vector at the bent pitch, keeping the yaw
	flat = Sqrt(forward[0] * forward[0] + forward[1] * forward[1]);

	if (flat < 0.0001)
	{
		dir[0] = 0.0;
		dir[1] = 0.0;
	}
	else
	{
		dir[0] = forward[0] / flat * Cos(pitch * 3.14159265358979 / 180.0);
		dir[1] = forward[1] / flat * Cos(pitch * 3.14159265358979 / 180.0);
	}

	dir[2] = -Sin(pitch * 3.14159265358979 / 180.0);
	HLVecNormalize(dir);

	HLVecMA(eye, 16.0, dir, src);
	HLVecScale(dir, speed, vel);

	//always three seconds from the pin, however long it was held
	fuse = hl_wpn_gren_start - hl_ent_time + 3.0;

	if (fuse < 0.0)
		fuse = 0.0;

	//CGrenade::ShootTimed: gravity 0.5, friction 0.8, bounces
	HLProjSpawn(HLPRJ_TIMED, src, vel, hl_wpn_info[HLWPN_HANDGRENADE].damage,
		fuse, 0.5, 0.8, TRUE, hl_ent_player);

	hl_wpn_ammo[HLAMMO_HANDGRENADE]--;
	hl_wpn_gren_start = 0.0;

	HLWeaponVmAnim(hl_wpn_info[HLWPN_HANDGRENADE].seq_fire2, FALSE);

	hl_wpn_next[HLWPN_HANDGRENADE] = hl_ent_time + 0.5;
}

U0 HLWeaponPrimary(CHLMap *map, F64 *eye, F64 *forward, F64 *right, F64 *up,
	Bool edge)
{//CBasePlayerWeapon::ItemPostFrame's +attack branch, dispatched on fire_mode.
 //edge is TRUE only on the frame the trigger went down, which is what the
 //empty click and the grenade pin need
	CHLWeaponInfo	*w;
	CHLTrace		 tr;
	F64				 src[3];
	F64				 vel[3];
	F64				 zero[3];
	F64				 end[3];
	I64				 id = hl_wpn_active;
	I64				 mode;
	I64				 slot;		//pool index of a projectile just spawned

	if (id < 0 || !map)
		return;

	//a reload in progress swallows the trigger
	if (hl_wpn_reloading == id)
		return;

	w    = &hl_wpn_info[id];
	mode = w->fire_mode;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	//the egon holds its own cadence rather than a refire timer
	if (mode == HLFIRE_EGON_WIDE)
	{
		if (hl_wpn_ammo[HLAMMO_URANIUM] <= 0)
		{
			HLWeaponEgonStop;

			if (edge)
				HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);

			return;
		}

		if (!hl_wpn_egon_on)
		{
			hl_wpn_egon_on    = TRUE;
			hl_wpn_egon_mode  = HLFIRE_EGON_WIDE;
			hl_wpn_egon_pulse = hl_ent_time;
			hl_wpn_egon_ammo  = hl_ent_time;

			HLWeaponVmAnim(w->seq_fire, TRUE);
			HLSndPlayAt("weapons/egon_windup2.wav", eye, 0.9, 0.0);
		}

		HLWeaponFireEgon(map, eye, forward, w->damage, TRUE);
		return;
	}

	if (hl_ent_time < hl_wpn_next[id])
		return;

	//the pin comes out on the press and the throw waits for the release, so
	//the grenade never consults the ammo test below
	if (mode == HLFIRE_GRENADE)
	{
		if (edge && hl_wpn_gren_start == 0.0 &&
			hl_wpn_ammo[HLAMMO_HANDGRENADE] > 0)
		{
			hl_wpn_gren_start = hl_ent_time;
			HLWeaponVmAnim(w->seq_fire, FALSE);
		}

		return;
	}

	if (!HLWeaponCanFire(id))
	{
		//PlayEmptySound, on the trigger edge only - the SDK gates it on
		//m_fFireOnEmpty; a held trigger would otherwise repeat the click at the
		//refire rate
		if (edge)
			HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);

		hl_wpn_next[id] = hl_ent_time + 0.2;
		return;
	}

	//the gauss needs two charges, not one
	if (mode == HLFIRE_GAUSS && hl_wpn_ammo[HLAMMO_URANIUM] < 2)
	{
		if (edge)
			HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);

		hl_wpn_next[id] = hl_ent_time + 0.5;
		return;
	}

	hl_wpn_next[id] = hl_ent_time + w->rate;

	HLWeaponVmAnim(w->seq_fire, FALSE);

	if (mode == HLFIRE_MELEE)
	{
		//CCrowbar::Swing: a connected swing comes back twice as fast, which is
		//what makes the crowbar feel different against a wall and against a
		//crate. w->rate is the miss figure the timer was already set to
		if (HLWeaponMelee(map, eye, forward, w->damage, w->range))
			hl_wpn_next[id] = hl_ent_time + 0.25;

		return;
	}

	if (mode == HLFIRE_BULLET)
	{
		HLWeaponTakeRound(id);
		HLSndPlayAt(w->fire_snd, eye, 1.0, 0.0);
		HLWeaponFireBullets(map, eye, forward, right, up, w->bullets,
			w->spread, w->damage, w->range);

		//CShotgun::ItemPostFrame's m_flPumpTime
		if (w->pump > 0.0)
			hl_wpn_pump_time = hl_ent_time + w->pump;

		return;
	}

	if (mode == HLFIRE_BOLT)
	{
		HLWeaponTakeRound(id);
		HLSndPlayAt(w->fire_snd, eye, 1.0, 0.0);

		//GetGunPosition() - v_up * 2
		HLVecMA(eye, -2.0, up, src);
		HLVecScale(forward, HLPRJ_BOLT_SPEED, vel);

		//MOVETYPE_FLY with gravity 0.5
		HLProjSpawn(HLPRJ_BOLT, src, vel, w->damage, 0.0, 0.5, 0.0, FALSE,
			hl_ent_player);
		return;
	}

	if (mode == HLFIRE_ROCKET)
	{
		HLWeaponTakeRound(id);
		HLSndPlayAt(w->fire_snd, eye, 1.0, 0.0);

		//GetGunPosition() + forward*16 + right*8 + up*-8
		HLVecMA(eye, 16.0, forward, src);
		HLVecMA(src, 8.0, right, src);
		HLVecMA(src, -8.0, up, src);

		//CRpgRocket::Spawn launches at 250 and lights the motor 0.4s later
		HLVecScale(forward, 250.0, vel);

		slot = HLProjSpawn(HLPRJ_ROCKET, src, vel, w->damage, 0.0, 0.5, 0.0,
			FALSE, hl_ent_player);

		if (slot >= 0)
			hl_proj[slot].arm = hl_ent_time + 0.4;

		return;
	}

	if (mode == HLFIRE_GAUSS)
	{
		hl_wpn_ammo[HLAMMO_URANIUM] -= 2;
		hl_wpn_gauss_primary = TRUE;
		hl_wpn_gauss_state   = 0;

		HLSndPlayAt(w->fire_snd, eye, 1.0, 0.0);
		HLWeaponFireGauss(map, eye, forward, w->damage, TRUE);
		return;
	}

	if (mode == HLFIRE_HORNET)
	{
		HLWeaponTakeRound(id);

		//m_flRechargeTime restarts from the shot
		hl_wpn_hornet_charge = hl_ent_time + HLWPN_HORNET_RECHARGE;

		//the last hornet costs an extra recharge period before the next shot
		if (hl_wpn_ammo[HLAMMO_HORNET] == 0)
			hl_wpn_next[id] += HLWPN_HORNET_RECHARGE;

		//GetGunPosition() + forward*16 + right*8 + up*-12, at 300
		HLVecMA(eye, 16.0, forward, src);
		HLVecMA(src, 8.0, right, src);
		HLVecMA(src, -12.0, up, src);
		HLVecScale(forward, 300.0, vel);

		HLProjSpawn(HLPRJ_HORNET, src, vel, w->damage, HLPRJ_HORNET_LIFE,
			0.0, 0.0, FALSE, hl_ent_player);
		return;
	}

	if (mode == HLFIRE_TRIPMINE)
	{
		//placed against whatever is within 128 units
		HLVecMA(eye, w->range, forward, end);
		HLTraceEntity(map, eye, end, zero, zero, hl_move_pass, FALSE, &tr);

		if (tr.fraction >= 1.0)
			return;

		HLWeaponTakeRound(id);

		HLVecMA(tr.end_pos, 8.0, tr.plane_normal, src);
		HLVecSet(vel, 0.0, 0.0, 0.0);

		slot = HLProjSpawn(HLPRJ_TRIPMINE, src, vel, w->damage, 0.0, 0.0, 0.0,
			FALSE, hl_ent_player);

		if (slot >= 0)
		{
			//the beam runs back down the surface normal
			HLVecCopy(tr.plane_normal, hl_proj[slot].dir);
			hl_proj[slot].arm = hl_ent_time + HLPRJ_MINE_ARM;
		}

		HLSndPlayAt(w->fire_snd, tr.end_pos, 1.0, HLENT_SND_ATTEN);
		HLSndPlayAt("weapons/mine_charge.wav", tr.end_pos, 0.2,
			HLENT_SND_ATTEN);
		return;
	}

	if (mode == HLFIRE_SATCHEL)
	{
		//"we're reloading, don't allow fire" - m_chargeReady 2 is the beat
		//after the radio went off
		if (hl_wpn_satchel_ready == 2)
			return;

		HLWeaponTakeRound(id);

		//thrown at 274 from the feet, not the eye
		HLVecCopy(eye, src);
		src[2] -= hl_view_ofs_z;
		HLVecScale(forward, 274.0, vel);

		HLProjSpawn(HLPRJ_SATCHEL, src, vel, w->damage, 0.0, 0.5, 0.8, TRUE,
			hl_ent_player);

		hl_wpn_satchel_ready = 1;
		return;
	}

	if (mode == HLFIRE_SNARK)
	{
		//find somewhere clear in front to put it down
		HLVecMA(eye, 24.0, forward, src);
		HLVecMA(eye, 60.0, forward, end);
		HLTraceEntity(map, src, end, zero, zero, hl_move_pass, FALSE, &tr);

		if (tr.all_solid || tr.start_solid || tr.fraction <= 0.0)
			return;

		HLWeaponTakeRound(id);

		HLVecScale(forward, 200.0, vel);

		HLProjSpawn(HLPRJ_SNARK, tr.end_pos, vel, w->damage, HLPRJ_SNARK_LIFE,
			0.5, 0.8, TRUE, hl_ent_player);

		HLSndPlayAt(w->fire_snd, eye, 1.0, 0.0);
		return;
	}
}

U0 HLWeaponSecondary(CHLMap *map, F64 *eye, F64 *forward, F64 *right, F64 *up,
	Bool edge)
{//CBasePlayerWeapon::ItemPostFrame's +attack2 branch
	CHLWeaponInfo	*w;
	F64				 src[3];
	F64				 vel[3];
	I64				 id = hl_wpn_active;
	I64				 mode;
	I64				 slot;

	if (id < 0 || !map)
		return;

	if (hl_wpn_reloading == id)
		return;

	w    = &hl_wpn_info[id];
	mode = w->sec_mode;

	if (mode == HLFIRE_NONE)
		return;

	//--- the two held triggers, which run every frame rather than on a timer ---

	if (mode == HLFIRE_EGON_NARROW)
	{
		if (hl_wpn_ammo[HLAMMO_URANIUM] <= 0)
		{
			HLWeaponEgonStop;
			return;
		}

		if (!hl_wpn_egon_on)
		{
			hl_wpn_egon_on    = TRUE;
			hl_wpn_egon_mode  = HLFIRE_EGON_NARROW;
			hl_wpn_egon_pulse = hl_ent_time;
			hl_wpn_egon_ammo  = hl_ent_time;

			HLWeaponVmAnim(w->seq_fire2, TRUE);
			HLSndPlayAt("weapons/egon_windup2.wav", eye, 0.9, 0.0);
		}

		HLWeaponFireEgon(map, eye, forward, w->sec_damage, FALSE);
		return;
	}

	if (mode == HLFIRE_GAUSS_CHARGE)
	{
		//CGauss::SecondaryAttack, m_fInAttack 0 -> 1 -> 2
		if (hl_wpn_gauss_state == 0)
		{
			if (hl_wpn_ammo[HLAMMO_URANIUM] <= 0)
			{
				if (edge)
					HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);

				hl_wpn_next[id] = hl_ent_time + 0.5;
				return;
			}

			hl_wpn_gauss_primary = FALSE;

			//one charge just to start the spin
			hl_wpn_ammo[HLAMMO_URANIUM]--;

			hl_wpn_gauss_state = 1;
			hl_wpn_gauss_start = hl_ent_time;
			hl_wpn_gauss_burn  = hl_ent_time;

			//GetFullChargeTime is 4 seconds in single player
			hl_wpn_gauss_full = hl_ent_time + 4.0;

			HLWeaponVmAnim("spinup", FALSE);
			HLSndPlayAt("ambience/pulsemachine.wav", eye, 0.8, 0.0);
			return;
		}

		if (hl_wpn_gauss_state == 1)
		{
			hl_wpn_gauss_state = 2;
			HLWeaponVmAnim("spin", TRUE);
			return;
		}

		//spinning: eat a charge every 0.3s until fully charged
		if (hl_ent_time >= hl_wpn_gauss_burn &&
			hl_ent_time < hl_wpn_gauss_full)
		{
			if (hl_wpn_ammo[HLAMMO_URANIUM] > 0)
				hl_wpn_ammo[HLAMMO_URANIUM]--;

			hl_wpn_gauss_burn = hl_ent_time + 0.3;
		}

		//out of ammo forces the shot
		if (hl_wpn_ammo[HLAMMO_URANIUM] <= 0)
		{
			HLWeaponReleaseGauss(map, eye, forward);
			return;
		}

		//held past ten seconds and it discharges into the player
		if (hl_wpn_gauss_start < hl_ent_time - 10.0)
		{
			HLSndPlayAt("weapons/electro4.wav", eye, 1.0, 0.0);
			HLSndPlayAt("weapons/electro6.wav", eye, 1.0, 0.0);

			hl_ent_player_health -= 50.0;

			hl_wpn_gauss_state = 0;
			hl_wpn_next[id]    = hl_ent_time + 1.0;

			HLWeaponVmAnim(w->seq_idle, TRUE);
		}

		return;
	}

	//--- the rest share the secondary refire timer ---
	//
	//ItemPostFrame tests IN_ATTACK2 against m_flNextSecondaryAttack on every
	//frame, so a held second trigger repeats at its own rate the way the first
	//one does. Gating all of these on the press edge made the shotgun's double
	//barrel, the M203 and the hivehand's rosette fire once per click.
	//
	//The three toggles are the exception: the designator, the zoom and the
	//satchel radio flip state, so a held button would flip them at the refire
	//rate.

	if (hl_ent_time < hl_wpn_next2[id])
		return;

	if (!edge && (mode == HLFIRE_SPOT || mode == HLFIRE_ZOOM ||
		mode == HLFIRE_SATCHEL_FIRE))
		return;

	hl_wpn_next2[id] = hl_ent_time + w->sec_rate;

	if (mode == HLFIRE_SHOTGUN2)
	{
		//CShotgun::SecondaryAttack wants two shells in the tube
		if (hl_wpn_clip[id] <= 1)
			return;

		hl_wpn_clip[id] -= 2;

		HLWeaponVmAnim(w->seq_fire2, FALSE);
		HLSndPlayAt(w->sec_snd, eye, 1.0, 0.0);

		HLWeaponFireBullets(map, eye, forward, right, up, w->sec_bullets,
			w->sec_spread, w->sec_damage, w->range);

		hl_wpn_next[id] = hl_ent_time + w->sec_rate;

		if (w->sec_pump > 0.0)
			hl_wpn_pump_time = hl_ent_time + w->sec_pump;

		return;
	}

	if (mode == HLFIRE_M203)
	{
		if (hl_wpn_ammo[HLAMMO_ARGRENADE] <= 0)
		{
			HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);
			return;
		}

		hl_wpn_ammo[HLAMMO_ARGRENADE]--;

		HLWeaponVmAnim(w->seq_fire2, FALSE);
		HLSndPlayAt(w->sec_snd, eye, 1.0, 0.0);

		//view_ofs + forward*16, straight out at 800. no player velocity is
		//added - the SDK dropped that
		HLVecMA(eye, 16.0, forward, src);
		HLVecScale(forward, 800.0, vel);

		HLProjSpawn(HLPRJ_CONTACT, src, vel, w->sec_damage, 0.0, 0.5, 0.0,
			FALSE, hl_ent_player);

		hl_wpn_next[id] = hl_ent_time + 1.0;
		return;
	}

	if (mode == HLFIRE_HORNET_FAST)
	{
		if (hl_wpn_ammo[HLAMMO_HORNET] <= 0)
			return;

		hl_wpn_ammo[HLAMMO_HORNET]--;

		//m_flRechargeTime restarts from the shot, and firing the hive dry costs
		//an extra half second on both triggers
		hl_wpn_hornet_charge = hl_ent_time + HLWPN_HORNET_RECHARGE;

		if (hl_wpn_ammo[HLAMMO_HORNET] == 0)
		{
			hl_wpn_next[id]  += HLWPN_HORNET_RECHARGE;
			hl_wpn_next2[id] += HLWPN_HORNET_RECHARGE;
		}

		//the eight point rosette CHgun::m_iFirePhase walks around
		HLVecMA(eye, 16.0, forward, src);
		HLVecMA(src, 8.0, right, src);
		HLVecMA(src, -12.0, up, src);

		hl_wpn_hornet_phase++;

		if (hl_wpn_hornet_phase > 8)
			hl_wpn_hornet_phase = 1;

		slot = hl_wpn_hornet_phase;

		if (slot == 1 || slot == 2 || slot == 8)
			HLVecMA(src, 8.0, up, src);

		if (slot == 4 || slot == 5 || slot == 6)
			HLVecMA(src, -8.0, up, src);

		if (slot == 2 || slot == 3 || slot == 4)
			HLVecMA(src, 8.0, right, src);

		if (slot == 6 || slot == 7 || slot == 8)
			HLVecMA(src, -8.0, right, src);

		//the fast mode fires at 1200, four times the tracking speed
		HLVecScale(forward, 1200.0, vel);

		HLProjSpawn(HLPRJ_HORNET, src, vel, w->sec_damage, HLPRJ_HORNET_LIFE,
			0.0, 0.0, FALSE, hl_ent_player);

		HLWeaponVmAnim(w->seq_fire2, FALSE);
		return;
	}

	if (mode == HLFIRE_SATCHEL_FIRE)
	{
		//the radio only works with charges out
		if (hl_wpn_satchel_ready != 1)
			return;

		HLWeaponVmAnim(w->seq_fire2, FALSE);
		HLProjDetonateSatchels(map);

		hl_wpn_satchel_ready = 2;
		hl_wpn_next[id]      = hl_ent_time + 0.5;
		return;
	}

	if (mode == HLFIRE_SPOT)
	{
		//CRpg::SecondaryAttack - a toggle, nothing more
		hl_wpn_spot_on = ToBool(!hl_wpn_spot_on);
		return;
	}

	if (mode == HLFIRE_ZOOM)
	{
		//CCrossbow::SecondaryAttack. nothing applies the fov - see the header
		if (hl_wpn_zoom_fov)
			hl_wpn_zoom_fov = 0;
		else
			hl_wpn_zoom_fov = 20;

		return;
	}

	if (mode == HLFIRE_BULLET)
	{
		//a secondary that is just another burst of the same bullets
		if (!HLWeaponCanFire(id))
		{
			//GlockFire's empty branch: the click, and a short primary hold
			if (edge)
				HLSndPlayAt("weapons/357_cock1.wav", eye, 0.8, 0.0);

			hl_wpn_next[id] = hl_ent_time + 0.2;
			return;
		}

		HLWeaponTakeRound(id);
		HLWeaponVmAnim(w->seq_fire2, FALSE);
		HLSndPlayAt(w->sec_snd, eye, 1.0, 0.0);

		HLWeaponFireBullets(map, eye, forward, right, up, w->sec_bullets,
			w->sec_spread, w->sec_damage, w->range);

		//GlockFire assigns m_flNextPrimaryAttack = m_flNextSecondaryAttack, so
		//the second trigger holds the first as well. Without this the two could
		//be alternated to double the glock's real rate of fire
		hl_wpn_next[id] = hl_ent_time + w->sec_rate;
	}
}

U0 HLWeaponStartReload()
{//DefaultReload. bulk, not shell by shell - the shotgun's incremental reload
 //needs animation events, which the studio layer does not decode
	CHLWeaponInfo	*w;
	I64				 id = hl_wpn_active;
	I64				 room;
	I64				 have;

	if (id < 0 || hl_wpn_reloading == id)
		return;

	w = &hl_wpn_info[id];

	if (w->ammo == HLAMMO_NONE || w->max_clip == HLWPN_NOCLIP)
		return;

	room = w->max_clip - hl_wpn_clip[id];
	have = hl_wpn_ammo[w->ammo];

	if (room <= 0 || have <= 0)
		return;

	hl_wpn_reloading   = id;
	hl_wpn_reload_done = hl_ent_time + w->reload_time;

	//the clip is not filled until the animation finishes, so a reload
	//interrupted by a weapon switch loses nothing
	HLWeaponVmAnim(w->seq_reload, FALSE);

	//Foley for a model with no 5004 event - see the WEAPON FOLEY note in the
	//header. The glock, mp5 and python leave this empty because their view
	//models carry the sound themselves and playing it here would double it.
	if (w->reload_snd[0])
		HLSndPlayAt(w->reload_snd, hl_snd_listener, 1.0, 0.0);

	hl_wpn_next[id] = hl_wpn_reload_done;
}

U0 HLWeaponFinishReload()
{
	CHLWeaponInfo	*w;
	I64				 id = hl_wpn_reloading;
	I64				 room;

	hl_wpn_reloading = HLWPN_NONE;

	if (id < 0)
		return;

	w = &hl_wpn_info[id];

	room = w->max_clip - hl_wpn_clip[id];

	if (room > hl_wpn_ammo[w->ammo])
		room = hl_wpn_ammo[w->ammo];

	if (room <= 0)
		return;

	hl_wpn_clip[id]      += room;
	hl_wpn_ammo[w->ammo] -= room;

	//CShotgun::WeaponIdle cocks the gun once the shells are in. Same sound and
	//same timer as the post-shot pump, so it rides the same field
	if (w->pump > 0.0)
		hl_wpn_pump_time = hl_ent_time + w->pump;
}

//--- switching --------------------------------------------------------------

I64 HLWeaponInSlot(I64 slot, I64 pos)
{//the weapon at a bucket position, -1 if nothing is defined there
	I64 i;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		if (hl_wpn_info[i].slot == slot && hl_wpn_info[i].pos == pos)
			return i;
	}

	return -1;
}

I64 HLWeaponNextInSlot(I64 slot, I64 after)
{//the next owned weapon in a bucket at a position past `after`, wrapping.
 //-1 when the bucket holds nothing owned
	I64 pos;
	I64 id;
	I64 n;

	//HLWPN_COUNT is the modulus: no bucket holds more entries than there are
	//weapons, so it is an upper bound on iPosition, not a slot count
	for (n = 1; n <= HLWPN_COUNT; n++)
	{
		pos = (after + n) % HLWPN_COUNT;
		id  = HLWeaponInSlot(slot, pos);

		if (id >= 0 && hl_wpn_have[id])
			return id;
	}

	return -1;
}

U0 HLWeaponSelectSlot(I64 slot)
{//SlotInput, cl_dll/hud_ammo.cpp.
 //
 //hud_fastswitch 1 switches straight to the next owned weapon in the bucket
 //and cycles on a repeat press. hud_fastswitch 0 - HL's default, and the
 //default here - opens the bucket and highlights an entry instead, walking to
 //the next entry on a repeat press; the weapon is not deployed until +attack
 //confirms it in HLWeaponConfirmSelection.
	I64 start = -1;
	I64 id;

	if (slot < 0 || slot >= HLWPN_SLOTS)
		return;

	//a press in a different bucket restarts the walk
	if (hl_wpn_sel_slot != slot)
		hl_wpn_sel_pos = -1;

	//show the bucket even when the press changes nothing, so an empty slot is
	//visibly empty
	hl_wpn_sel_slot  = slot;
	hl_wpn_sel_until = hl_ent_time + HLWPN_SEL_TIME;

	if (hl_wpn_fastswitch)
	{
		if (hl_wpn_active >= 0 && hl_wpn_info[hl_wpn_active].slot == slot)
			start = hl_wpn_info[hl_wpn_active].pos;

		id = HLWeaponNextInSlot(slot, start);

		if (id >= 0 && id != hl_wpn_active)
			HLWeaponSetActive(id);

		hl_wpn_sel_pos = -1;
		return;
	}

	//two step: walk the highlight, deploy nothing yet
	id = HLWeaponNextInSlot(slot, hl_wpn_sel_pos);

	if (id < 0)
	{
		hl_wpn_sel_pos = -1;
		return;
	}

	hl_wpn_sel_pos = hl_wpn_info[id].pos;
}

Bool HLWeaponConfirmSelection()
{//the +attack that closes the two-step menu. TRUE when the trigger was
 //swallowed by the menu and must not also fire the weapon, which is what
 //CBasePlayer::SelectItem being reached from the HUD means
	I64 id;

	if (hl_wpn_fastswitch || hl_wpn_sel_slot < 0 || hl_wpn_sel_pos < 0)
		return FALSE;

	id = HLWeaponInSlot(hl_wpn_sel_slot, hl_wpn_sel_pos);

	hl_wpn_sel_slot = -1;
	hl_wpn_sel_pos  = -1;

	if (id < 0 || !hl_wpn_have[id])
		return TRUE;

	if (id != hl_wpn_active)
		HLWeaponSetActive(id);

	return TRUE;
}

U0 HLWeaponCancelSelection()
{//any other input drops the menu without deploying anything
	hl_wpn_sel_slot = -1;
	hl_wpn_sel_pos  = -1;
}

U0 HLWeaponCycle(I64 step)
{//impulse 10 / 12 - next and previous, over the flat id order, skipping what
 //is not owned
	I64 n;
	I64 id;

	if (hl_wpn_active < 0)
		id = 0;
	else
		id = hl_wpn_active;

	for (n = 1; n <= HLWPN_COUNT; n++)
	{
		id = id + step;

		//ZealC's % on a negative left operand does not wrap
		while (id < 0)
			id += HLWPN_COUNT;

		id = id % HLWPN_COUNT;

		if (hl_wpn_have[id] && id != hl_wpn_active)
		{
			HLWeaponSetActive(id);

			hl_wpn_sel_slot  = hl_wpn_info[id].slot;
			hl_wpn_sel_until = hl_ent_time + HLWPN_SEL_TIME;
			return;
		}
	}
}

//--- input ------------------------------------------------------------------

U0 HLWeaponInput(CHLMap *map, F64 *eye, F64 *forward, F64 *right, F64 *up)
{//keys and the mouse, all edge triggered except the trigger itself
 //
 //the number keys are read straight off the keyboard rather than through
 //hl_bind_key: that table lives in HLMenu.ZC, which compiles after this file.
 //HL1.ZC owns the wheel and clears mouse_hard.raw_data every frame before this
 //runs, so next/prev are on q and z
	CHLTrace spot_tr;
	F64		 spot_end[3];
	F64		 spot_zero[3];
	I64		 i;
	Bool	 now;
	Bool	 atk;
	Bool	 atk2;

	for (i = 0; i < HLWPN_SLOTS; i++)
	{
		now = ToBool(Bt(kbd.down_bitmap, Char2ScanCode('1' + i)));

		if (now && !hl_wpn_slot_held[i])
			HLWeaponSelectSlot(i);

		hl_wpn_slot_held[i] = now;
	}

	//a direct switch or a reload abandons an open two-step menu rather than
	//leaving a stale highlight for +attack to confirm
	now = ToBool(Bt(kbd.down_bitmap, Char2ScanCode('q')));
	if (now && !hl_wpn_next_held)
	{
		HLWeaponCancelSelection;
		HLWeaponCycle(1);
	}
	hl_wpn_next_held = now;

	now = ToBool(Bt(kbd.down_bitmap, Char2ScanCode('z')));
	if (now && !hl_wpn_prev_held)
	{
		HLWeaponCancelSelection;
		HLWeaponCycle(-1);
	}
	hl_wpn_prev_held = now;

	now = ToBool(Bt(kbd.down_bitmap, Char2ScanCode('r')));
	if (now && !hl_wpn_reload_held)
	{
		HLWeaponCancelSelection;
		HLWeaponStartReload;
	}
	hl_wpn_reload_held = now;

	//raw_bttns or bttns, the pair HL1.ZC uses: a PS/2 mouse sends nothing while
	//a button is held still, so raw_bttns alone drops a held trigger
	atk  = ToBool(mouse_hard.raw_bttns[0] || mouse_hard.bttns[0]);
	atk2 = ToBool(mouse_hard.raw_bttns[1] || mouse_hard.bttns[1]);

	//ItemPostFrame is one if/else-if chain, +attack2 tested first, and it clears
	//IN_ATTACK2 after dispatching. So on a frame with both buttons down the
	//second trigger wins outright and the first does nothing. Running the two
	//independently let the shotgun put both barrels and a single shell into the
	//same frame, and let the glock's two triggers alternate past its rate of
	//fire.
	//
	//held is fire for every automatic weapon in HL; the refire timer is what
	//makes the semi-automatics semi-automatic
	if (atk2)
		HLWeaponSecondary(map, eye, forward, right, up,
			ToBool(!hl_wpn_attack2_held));
	else if (atk)
	{
		//with the two-step menu up the trigger means confirm, not fire, and
		//is swallowed for this press
		if (hl_wpn_attack_held || !HLWeaponConfirmSelection)
			HLWeaponPrimary(map, eye, forward, right, up,
				ToBool(!hl_wpn_attack_held));
	}
	else
	{
		//ItemPostFrame's "no fire buttons down" arm: an empty clip reloads
		//itself once the refire delay from the last shot has run out, without
		//waiting for +reload. Its absence is why a weapon fired dry here stayed
		//dry until the player pressed r.
		if (hl_wpn_active >= 0 && hl_wpn_reloading != hl_wpn_active &&
			hl_wpn_clip[hl_wpn_active] == 0 &&
			hl_ent_time >= hl_wpn_next[hl_wpn_active])
			HLWeaponStartReload;
	}

	//the release edges. a primed grenade leaves the hand, a charged gauss goes
	//off, and a running egon shuts down - none of which is an ItemPostFrame
	//branch, they are the weapons' own button-state tests
	if (!atk && hl_wpn_attack_held)
	{
		if (hl_wpn_active == HLWPN_HANDGRENADE)
			HLWeaponThrowGrenade(eye, forward);

		if (hl_wpn_gauss_state != 0 && hl_wpn_active == HLWPN_GAUSS)
			HLWeaponReleaseGauss(map, eye, forward);

		if (hl_wpn_egon_on && hl_wpn_egon_mode == HLFIRE_EGON_WIDE)
			HLWeaponEgonStop;
	}

	if (!atk2 && hl_wpn_attack2_held)
	{
		if (hl_wpn_gauss_state != 0 && hl_wpn_active == HLWPN_GAUSS)
			HLWeaponReleaseGauss(map, eye, forward);

		if (hl_wpn_egon_on && hl_wpn_egon_mode == HLFIRE_EGON_NARROW)
			HLWeaponEgonStop;
	}

	hl_wpn_attack_held  = atk;
	hl_wpn_attack2_held = atk2;

	//the satchel's "just detonated" beat clears once the radio is let go, so
	//the next press throws again - CSatchel::m_chargeReady 2 -> 0
	if (hl_wpn_satchel_ready == 2 && !hl_wpn_attack2_held &&
		HLProjCountSatchels() < 1)
		hl_wpn_satchel_ready = 0;

	//the designator only exists while the RPG is out and toggled on
	hl_wpn_spot_valid = FALSE;

	if (hl_wpn_spot_on && hl_wpn_active == HLWPN_RPG)
	{
		HLVecMA(eye, 8192.0, forward, spot_end);
		HLVecSet(spot_zero, 0.0, 0.0, 0.0);

		HLTraceEntity(map, eye, spot_end, spot_zero, spot_zero, hl_move_pass,
			FALSE, &spot_tr);

		if (spot_tr.fraction < 1.0)
		{
			HLVecCopy(spot_tr.end_pos, hl_wpn_spot_pos);
			hl_wpn_spot_valid = TRUE;
		}
	}
}

//--- the frame --------------------------------------------------------------

U0 HLWeaponFrame(F64 dt, CHLMap *map = NULL, F64 *eye = NULL,
	F64 *forward = NULL, F64 *right = NULL, F64 *up = NULL)
{//one tick of weapon state: pickups, input, refire timers, reload, view model
 //
 //eye is the camera, not the feet - the pickup box is rebuilt from it using
 //hl_view_ofs_z, the same offset the duck code moves the view by.
 //
 //the aim basis is passed in rather than derived from angles. HLVecToAngles is
 //not the inverse of HLAngleVectors here - it returns pitch unnegated so the
 //studio transform's own inversion comes out right - and round-tripping the
 //view through it mirrors the aim vertically. the canvas already carries the
 //basis HLDrawSetView built with HLAngleVectors.
	CHLStSeq	*sq;
	F64			 feet[3];
	F64			 span;

	if (dt < 0.0)
		dt = 0.0;

	if (dt > HLWPN_MAX_DT)
		dt = HLWPN_MAX_DT;

	if (hl_wpn_reloading >= 0 && hl_ent_time >= hl_wpn_reload_done)
		HLWeaponFinishReload;

	if (hl_wpn_sel_slot >= 0 && hl_ent_time >= hl_wpn_sel_until)
	{
		hl_wpn_sel_slot = -1;
		hl_wpn_sel_pos  = -1;
	}

	//CShotgun::ItemPostFrame. The pump is not on the view model - no v_*.mdl
	//outside the glock, mp5 and python carries a 5004 event at all - so it is
	//emitted here off m_flPumpTime, exactly as the SDK does
	if (hl_wpn_pump_time > 0.0 && hl_ent_time >= hl_wpn_pump_time)
	{
		HLSndPlayAt("weapons/scock1.wav", hl_snd_listener, 1.0, 0.0);
		hl_wpn_pump_time = 0.0;
	}

	//CHgun::WeaponIdle opens with Reload(), so the hive tops itself back up
	//whenever the weapon is in hand and not doing anything else
	if (hl_wpn_active == HLWPN_HORNETGUN)
		HLWeaponHornetRecharge;

	if (map && eye && forward && right && up)
	{
		HLVecCopy(eye, feet);
		feet[2] -= hl_view_ofs_z;

		HLWeaponPickups(map, feet);
		HLWeaponInput(map, eye, forward, right, up);
	}

	//the pool moves on the server clock, like everything else with a timer
	if (map)
		HLProjFrame(map, dt);

	//--- view model animation ---
	//
	//StudioFrameAdvance: cycle is 0..1 over the sequence, so the step is
	//dt*fps/numframes. a one-shot holds on its last frame and then falls back
	//to the idle, which is what m_flTimeWeaponIdle does in the SDK
	if (!hl_wpn_vm || hl_wpn_vm_seq < 0 || hl_wpn_vm_seq >= hl_wpn_vm->num_seqs)
		return;

	sq = &hl_wpn_vm->seqs[hl_wpn_vm_seq];

	span = ToF64(sq->num_frames);

	if (span < 2.0)
		span = 2.0;

	hl_wpn_vm_cycle += dt * sq->fps / (span - 1.0);

	//Before the wrap: wrapping first would reset the frame index and swallow
	//every event in the tail of the sequence.
	HLWeaponVmEvents;

	if (hl_wpn_vm_cycle < 1.0)
		return;

	if (hl_wpn_vm_loop)
	{
		//subtract rather than ToI64 - the wrap needs no conversion
		while (hl_wpn_vm_cycle >= 1.0)
			hl_wpn_vm_cycle -= 1.0;

		hl_wpn_vm_ev_frame = -1;
		return;
	}

	hl_wpn_vm_cycle = 1.0;

	if (hl_wpn_vm_done)
		return;

	hl_wpn_vm_done = TRUE;

	if (hl_wpn_active >= 0)
		HLWeaponVmAnim(hl_wpn_info[hl_wpn_active].seq_idle, TRUE);
}

I64 HLWeaponAmmo()
{//rounds in the active weapon's clip, -1 when no weapon is held. the HUD reads
 //this rather than the inventory arrays
	CHLWeaponInfo *w;

	if (hl_wpn_active < 0)
		return -1;

	w = &hl_wpn_info[hl_wpn_active];

	//a melee weapon has no readout - CHudAmmo hides the number rather than
	//showing a zero
	if (w->ammo == HLAMMO_NONE)
		return -1;

	if (w->max_clip == HLWPN_NOCLIP)
		return hl_wpn_ammo[w->ammo];

	return hl_wpn_clip[hl_wpn_active];
}

I64 HLWeaponReserve()
{//what is left in the pool behind the clip, -1 when there is no pool
	CHLWeaponInfo *w;

	if (hl_wpn_active < 0)
		return -1;

	w = &hl_wpn_info[hl_wpn_active];

	if (w->ammo == HLAMMO_NONE || w->max_clip == HLWPN_NOCLIP)
		return -1;

	return hl_wpn_ammo[w->ammo];
}

//--- drawing ----------------------------------------------------------------

U0 HLWeaponDrawViewModel(CHLCanvas *c)
{//the first-person weapon
 //
 //GoldSrc draws the view model as an ordinary studio entity at the refdef view
 //origin with the view angles - v_*.mdl geometry is authored already offset
 //from that origin - so this is the normal transform, not a screen-locked
 //special case like HLMdlDrawView.
 //
 //Consequence: the gun is depth tested against the world and pokes through a
 //near wall. GoldSrc uses a separate depth range for the view model; there is
 //one 1/z buffer here.
	F64 ang[3];

	if (!c || !hl_wpn_vm || hl_wpn_active < 0)
		return;

	//HLVecToAngles then the studio transform is the pair used to point a model
	//along a direction vector: vectoangles leaves pitch unnegated and
	//HLStudioDraw inverts it, so the two compose. negating here as well is the
	//bug the note in HLVecToAngles warns about.
	HLVecToAngles(c->forward, ang);

	HLStudioDraw(c, hl_wpn_vm, c->origin, ang, hl_wpn_vm_seq, hl_wpn_vm_cycle,
		0.0, 0, 0, HLWPN_VM_LIGHT);
}

I64 HLWeaponXhairUnit()
{//the crosshairs sheet is a grid of square cells, one resolution per sheet
	if (hl_hud_res >= 2560)
		return 72;

	if (hl_hud_res >= 1280)
		return 48;

	//320 and 640 share sprites/crosshairs.spr at 24, per any weapon_*.txt
	return 24;
}

U0 HLWeaponDrawCrosshair(CHLCanvas *c)
{//the aiming reticle
 //
 //hud.txt has no crosshair: `cross` is the health cross beside the number.
 //every weapon names its own reticle in sprites/weapon_<name>.txt as a cell of
 //the shared crosshairs sheet; those cells are what the table above stores.
 //the crowbar has no crosshair row and draws nothing.
	CHLWeaponInfo	*w;
	U8				*sheet;
	I64				 unit;
	I64				 x;
	I64				 y;

	if (!c || hl_wpn_active < 0)
		return;

	w = &hl_wpn_info[hl_wpn_active];

	if (w->xhair_col < 0 || w->xhair_row < 0)
		return;

	//loaded once, and again after a resolution change swaps the row set
	if (hl_wpn_xhair_sheet < 0 || hl_wpn_xhair_res != hl_hud_res)
	{
		if (hl_hud_res >= 2560)
			sheet = "2560crosshairs";
		else if (hl_hud_res >= 1280)
			sheet = "1280crosshairs";
		else
			sheet = "crosshairs";

		hl_wpn_xhair_sheet = HLHudSheet(sheet);
		hl_wpn_xhair_res   = hl_hud_res;
	}

	if (hl_wpn_xhair_sheet < 0)
		return;

	unit = HLWeaponXhairUnit;

	//centred on the view centre, not the canvas centre: the status bar shifts
	//the view rect up and the crosshair follows it
	x = ToI64(c->center_x) - unit / 2;
	y = ToI64(c->center_y) - unit / 2;

	HLSprDrawRect(c, hl_hud_sheet[hl_wpn_xhair_sheet], 0, x, y,
		w->xhair_col * unit, w->xhair_row * unit, unit, unit,
		HLHUD_R, HLHUD_G, HLHUD_B);
}

U0 HLWeaponDrawSelection(CHLCanvas *c)
{//CHudAmmo's weapon menu: the bucket row, and the open bucket's contents
 //
 //hud.txt ships bucket0..bucket5 but the SDK has MAX_WEAPON_SLOTS (5) buckets,
 //so bucket5 is unused.
 //
 //the weapon glyph is hud.txt's "d_<name>" death-notice icon rather than the
 //"weapon"/"weapon_s" art in sprites/weapon_<name>.txt. at 2560 those are one
 //.spr file per weapon per state and the sheet table will not hold them; the
 //d_ icons are the same shape and already loaded.
	U8	name[HLHUD_NAME_MAX];
	I64	bucket[HLWPN_SLOTS];
	I64	sel;
	I64	idx;
	I64	x0;
	I64	y0;
	I64	bw = 20;
	I64	bh = 20;
	I64	sel_w = 0;
	I64	sel_h = 0;
	I64	step;
	I64	gap;
	I64	slot;
	I64	pos;
	I64	id;
	I64	x;
	I64	y;
	I64	row;
	I64	r, g, b;

	if (!c || hl_wpn_sel_slot < 0)
		return;

	//m_HUD_bucket0 is GetSpriteIndex("bucket1") and the row walks bucket0 + i,
	//so slot 0 is the sprite NAMED bucket1. hud.txt lists bucket1..bucket5 and
	//then bucket0, which is the sixth glyph and belongs to no slot at all -
	//reading bucket0..bucket4 put the wrong number in every box
	for (slot = 0; slot < HLWPN_SLOTS; slot++)
	{
		StrPrint(name, "bucket%d", slot + 1);
		bucket[slot] = HLHudFind(name);
	}

	if (bucket[0] >= 0)
	{
		bw = hl_hud_entry[bucket[0]].w;	//giBucketWidth
		bh = hl_hud_entry[bucket[0]].h;	//giBucketHeight
	}

	//the `selection` panel is the size of a weapon's rcActive - 170x45 against a
	//20x20 bucket at 640 - so it stands for rcActive in the widths below
	sel = HLHudFind("selection");

	if (sel >= 0)
	{
		sel_w = hl_hud_entry[sel].w;
		sel_h = hl_hud_entry[sel].h;
	}

	if (sel_w < bw)
		sel_w = bw;
	if (sel_h < bh)
		sel_h = bh;

	//DrawWList's literals: x = 10, y = 10, and 5 between every cell on both
	//axes. They are not scaled with the resolution in the SDK either - the
	//sprite set is chosen to match the canvas, so the margin lands the same way
	gap = 5;
	x0  = 10;
	y0  = 10;

	step = sel_h + gap;

	//--- the bucket row ---
	//
	//"make active slot wide enough to accomodate gun pictures": the open bucket
	//advances by the weapon panel width, not by the bucket width, so the buckets
	//to its right clear the column of panels underneath. Advancing every slot by
	//the bucket width is what buried buckets 3, 4 and 5 under the open one
	x = x0;

	for (slot = 0; slot < HLWPN_SLOTS; slot++)
	{
		//the open bucket is lit, the rest dimmed - the SDK uses two alpha levels
		//on the same sprite
		if (slot == hl_wpn_sel_slot)
		{
			r = HLHUD_R;
			g = HLHUD_G;
			b = HLHUD_B;
		}
		else
		{
			r = 96;
			g = 64;
			b = 0;
		}

		if (bucket[slot] >= 0)
			HLHudDrawElement(c, bucket[slot], x, y0, r, g, b);

		if (slot == hl_wpn_sel_slot)
			x += sel_w + gap;
		else
			x += bw + gap;
	}

	//--- the closed buckets ---
	//
	//DrawWList fills a plain giBucketWidth x giBucketHeight box per owned weapon
	//under every slot that is not open. There is no rect primitive here, so the
	//bucket glyph itself is redrawn dim - same cell, same pitch
	x = x0;

	for (slot = 0; slot < HLWPN_SLOTS; slot++)
	{
		if (slot == hl_wpn_sel_slot)
		{
			x += sel_w + gap;
			goto qwds_slot;
		}

		y = bh + y0;

		for (pos = 0; pos < HLWPN_COUNT; pos++)
		{
			id = HLWeaponInSlot(slot, pos);

			if (id < 0 || !hl_wpn_have[id])
				goto qwds_box;

			//yellowish with ammo, redish without - the SDK's two colours for
			//this row
			if (HLWeaponCanFire(id) || HLWeaponPool(id) > 0)
			{
				r = 128;
				g = 80;
				b = 0;
			}
			else
			{
				r = 128;
				g = 8;
				b = 8;
			}

			if (bucket[slot] >= 0)
				HLHudDrawElement(c, bucket[slot], x, y, r, g, b);

			y += bh + gap;

qwds_box:
		}

		x += bw + gap;

qwds_slot:
	}

	//--- the open bucket ---
	//
	//x is the left edge of the open column, which is every closed slot to its
	//left advanced by the bucket width
	x   = x0 + hl_wpn_sel_slot * (bw + gap);
	row = 0;

	for (pos = 0; pos < HLWPN_COUNT; pos++)
	{
		id = HLWeaponInSlot(hl_wpn_sel_slot, pos);

		if (id < 0 || !hl_wpn_have[id])
			goto qwds_next;

		//"y = giBucketHeight + 10", then one panel plus 5 per entry
		y = bh + y0 + row * step;

		//held weapon bright, owned-but-dry dimmed. HL greys a weapon with no
		//ammo. With the two-step menu up the highlight follows the walk
		//instead of the held weapon, so the player can see what +attack will
		//confirm
		if (hl_wpn_sel_pos >= 0 && pos == hl_wpn_sel_pos)
		{
			r = HLHUD_R;
			g = HLHUD_G;
			b = HLHUD_B;
		}
		else if (id == hl_wpn_active && hl_wpn_sel_pos < 0)
		{
			r = HLHUD_R;
			g = HLHUD_G;
			b = HLHUD_B;
		}
		else if (HLWeaponCanFire(id) || HLWeaponPool(id) > 0)
		{
			r = 160;
			g = 100;
			b = 0;
		}
		else
		{
			r = 80;
			g = 80;
			b = 80;
		}

		if (sel >= 0)
			HLHudDrawElement(c, sel, x, y, r / 3, g / 3, b / 3);

		StrPrint(name, "d_%s", hl_wpn_info[id].hud_name);
		idx = HLHudFind(name);

		if (idx >= 0)
		{
			//centred in the panel when there is one, otherwise inset
			if (sel_w > hl_hud_entry[idx].w)
				HLHudDrawElement(c, idx,
					x + (sel_w - hl_hud_entry[idx].w) / 2,
					y + (sel_h - hl_hud_entry[idx].h) / 2, r, g, b);
			else
				HLHudDrawElement(c, idx, x + gap, y + gap, r, g, b);
		}

		row++;

qwds_next:
	}
}

U0 HLWeaponHudHook(CHLCanvas *c)
{//installed into hl_hud_weapon_hook, so HLHudDraw calls this once per frame -
 //see the header. tick first, then draw, so the numbers the HUD prints are
 //this frame's
	F64 dt;

	if (!c)
		return;

	//no world, no weapons. HL1.ZC draws the HUD on the no-world path too, and a
	//trace into a half-loaded map faults, so a spawned entity list is required
	//as well as a map. the NULL test comes first because HLMapValid logs, and
	//spending its eight-report budget every frame at the menu would hide the
	//corruption it exists to catch
	if (!hl_map || !hl_entities || hl_num_entities <= 0)
		return;

	if (!HLMapValid(hl_map, "HLWeaponHudHook"))
		return;

	//HLEntSpawnAll zeroes the entity clock on every map load, so a clock that
	//moved backwards means a new level and the inventory is reset
	if (!hl_wpn_spawned || hl_ent_time < hl_wpn_last_time)
	{
		HLWeaponPlayerSpawn;
		hl_wpn_spawned   = TRUE;
		hl_wpn_last_time = hl_ent_time;
		return;
	}

	dt = hl_ent_time - hl_wpn_last_time;
	hl_wpn_last_time = hl_ent_time;

	//the canvas basis is the aim basis - HLDrawSetView built it with
	//HLAngleVectors off the same view angles the player holds
	HLWeaponFrame(dt, hl_map, c->origin, c->forward, c->right, c->up);

	//the gun under the reticle, both under whatever HLHudDraw prints next
	HLWeaponDrawViewModel(c);
	HLWeaponDrawCrosshair(c);
	HLWeaponDrawSelection(c);

	//the HUD's own mirror of the ammo counts. HLHud.ZC compiles first and
	//cannot call anything here, so the numbers are pushed to it
	hl_hud_ammo    = HLWeaponAmmo;
	hl_hud_reserve = HLWeaponReserve;
}

//top-level: the hook is what makes any of the above run, and HLHudInit (which
//clears it) has already run by the time this file compiles
hl_hud_weapon_hook = &HLWeaponHudHook;

U0 HLWeaponReport()
{//what is in the inventory, for the console and HLTest
	I64 i;

	"HLWeapon: active %d, %d pickups this level\n", hl_wpn_active,
		hl_wpn_picked;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		if (!hl_wpn_have[i])
			goto qwr_next;

		"  %s clip %d\n", hl_wpn_info[i].classname, hl_wpn_clip[i];

qwr_next:
	}

	"  9mm %d  357 %d  buckshot %d  ARgrenade %d\n",
		hl_wpn_ammo[HLAMMO_9MM], hl_wpn_ammo[HLAMMO_357],
		hl_wpn_ammo[HLAMMO_BUCKSHOT], hl_wpn_ammo[HLAMMO_ARGRENADE];

	"  bolts %d  rockets %d  uranium %d  hornets %d\n",
		hl_wpn_ammo[HLAMMO_BOLT], hl_wpn_ammo[HLAMMO_ROCKET],
		hl_wpn_ammo[HLAMMO_URANIUM], hl_wpn_ammo[HLAMMO_HORNET];

	"  grenades %d  satchels %d  tripmines %d  snarks %d\n",
		hl_wpn_ammo[HLAMMO_HANDGRENADE], hl_wpn_ammo[HLAMMO_SATCHEL],
		hl_wpn_ammo[HLAMMO_TRIPMINE], hl_wpn_ammo[HLAMMO_SNARK];

	"  projectiles live %d of %d, %d dropped to a full pool\n",
		hl_proj_live, HLPROJ_MAX, hl_proj_dropped;
}
