class CHLProj
{
	I64	 kind;
	F64	 org[3];
	F64	 vel[3];

	F64	 dir[3];

	F64	 gravity;
	F64	 friction;
	F64	 damage;

	F64	 die;			//absolute detonate/remove time, 0 = never
	F64	 arm;
	F64	 next_hurt;
	F64	 next_hop;
	F64	 next_puff;
	F64	 beam_len;

	F64	 next_hunt;
	F64	 prev_org[3];
	F64	 aim[3];
	I64	 enemy;			//m_hEnemy as an entity index, -1 for none

	F64	 beam_end[3];

	I64	 seq;
	F64	 frame;			//animation phase, 0..1
	F64	 anim_rate;

	Bool bounce;
	Bool on_ground;
	Bool armed;

	I64	 owner;			//entity index that fired it, -1 for none
};

