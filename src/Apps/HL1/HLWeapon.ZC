	hl_wpn_egon_ammo  = 0.0;

	hl_wpn_hornet_phase  = 0;
	hl_wpn_hornet_charge = 0.0;

	hl_wpn_spot_on    = FALSE;
	hl_wpn_spot_valid = FALSE;
	HLVecSet(hl_wpn_spot_pos, 0.0, 0.0, 0.0);

	hl_wpn_zoom_fov = 0;

	hl_wpn_vm       = NULL;
	hl_wpn_vm_for   = HLWPN_NONE;
	hl_wpn_vm_seq   = 0;
	hl_wpn_vm_cycle = 0.0;
	hl_wpn_vm_loop  = TRUE;
	hl_wpn_vm_done  = FALSE;

	hl_wpn_next_held    = FALSE;
	hl_wpn_prev_held    = FALSE;
	hl_wpn_reload_held  = FALSE;
	hl_wpn_attack_held  = FALSE;
	hl_wpn_attack2_held = FALSE;

	hl_wpn_sel_slot   = -1;
	hl_wpn_sel_until  = 0.0;
	hl_wpn_sel_pos    = -1;
	hl_wpn_fastswitch = FALSE;

	hl_wpn_last_time   = 0.0;
	hl_wpn_spawned     = FALSE;
	hl_wpn_xhair_sheet = -1;
	hl_wpn_xhair_res   = 0;
	hl_wpn_picked      = 0;

	//crowbar: swings, never fires. attack1miss is the swing that hits nothing,
	//attack1 the one with the impact; the crowbar model is the only one that
	//ships both
	HLWeaponSetInfo(HLWPN_CROWBAR, "weapon_crowbar", "crowbar",
		"models/v_crowbar.mdl", 0, 0,
		HLAMMO_NONE, HLWPN_NOCLIP, 0,
		10.0, 1, 0.0, 0.5, 32.0, 0.0,
		-1, -1,
		"idle1", "attack1miss", "", "draw", "");

	//glock: GlockFire(0.01, 0.3, TRUE) for the primary
	HLWeaponSetInfo(HLWPN_GLOCK, "weapon_9mmhandgun", "9mmhandgun",
		"models/v_9mmhandgun.mdl", 1, 0,
		HLAMMO_9MM, 17, 17,
		8.0, 1, 0.01, 0.3, 8192.0, 1.5,
		1, 0,
		"idle1", "shoot", "reload", "draw", "weapons/pl_gun3.wav");

	//python: no cone in single player - only the deathmatch branch spreads it
	HLWeaponSetInfo(HLWPN_PYTHON, "weapon_357", "357",
		"models/v_357.mdl", 1, 1,
		HLAMMO_357, 6, 6,
		40.0, 1, 0.0, 0.75, 8192.0, 2.0,
		2, 0,
		"idle1", "fire1", "reload", "draw", "weapons/357_shot1.wav");

	//mp5: VECTOR_CONE_6DEGREES, 0.1 refire. sk_plr_9mmAR_bullet1 is 5, not the
	//glock's 8 - BULLET_PLAYER_MP5 reads plrDmgMP5. the M203 secondary lobs a
	//contact grenade, sk_plr_9mmAR_grenade1 100, at 800 units/sec
	HLWeaponSetInfo(HLWPN_MP5, "weapon_9mmAR", "9mmAR",
		"models/v_9mmar.mdl", 2, 0,
		HLAMMO_9MM, 50, 25,
		5.0, 1, 0.05234, 0.1, 8192.0, 1.5,
		0, 2,
		"idle1", "shoot", "reload", "deploy", "weapons/hks1.wav");

	//crossbow: BOLT_MAX_CARRY 50, CROSSBOW_MAX_CLIP 5, DefaultReload(5,...,4.5).
	//the bolt does plrDmgCrossbowMonster 50 to anything that is not a player.
	//v_crossbow carries no 5004, so the reload foley is emitted from here
	HLWeaponSetInfo(HLWPN_CROSSBOW, "weapon_crossbow", "crossbow",
		"models/v_crossbow.mdl", 2, 2,
		HLAMMO_BOLT, 5, 5,
