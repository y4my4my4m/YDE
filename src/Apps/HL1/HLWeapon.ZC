// HLWeapon.ZC - player inventory, weapons, firing and single-player gamerules
//
// Ported from the SDK's dlls/ - weapons.cpp (CBasePlayerWeapon, FireBullets),
// crowbar.cpp, glock.cpp, python.cpp, mp5.cpp, shotgun.cpp, items.cpp
// (CBasePlayerItem::Touch, CBasePlayerAmmo) and singleplay_gamerules.cpp -
// plus cl_dll/ammo.cpp for the bucket/selection UI.
//
// The SDK gives every weapon its own C++ class with a virtual PrimaryAttack.
// Here it is one table plus a fire-mode id per attack: hitscan weapons differ
// only in numbers, and the rest select a branch of HLWeaponPrimary /
// HLWeaponSecondary. The table carries both attacks, so SecondaryAttack is
// data on the same row rather than a second class.
//
// PROJECTILES
//
// Everything that is not hitscan needs a moving damage carrier, which the
// entity system cannot supply: hl_entities is sized to the parsed map and
// cannot allocate at runtime. So this file owns its own fixed pool,
// hl_proj[HLPROJ_MAX] - see the CHLProj block. It mirrors CGrenade
// (dlls/ggrenade.cpp) for bounce/timer/contact grenades, CCrossbowBolt,
// CRpgRocket, CTripmineGrenade, CSatchelCharge, CSqueakGrenade and CHornet.
// A saturated pool drops the shot rather than growing.
//
// PER-FRAME CALL
//
// HL1.ZC owns the frame loop and is not editable from here, so the tick is
// driven off hl_hud_weapon_hook - the hook HLHud.ZC owns and HL1.ZC calls once
// per rendered frame, through HLHudDraw. Same backward-call idiom as
// HLProgs.ZC's hl_pr_builtin_call: a single-pass compiler cannot let HLHud.ZC
// name anything in this file, so this file installs itself into a pointer
// HLHud.ZC declared.
//
// That also fixes where the player state comes from. hl_origin and hl_angles
// live in HL1.ZC, which compiles later, so the view comes out of CHLCanvas -
// it carries the eye and the view basis for the frame being drawn.
//
// The clock is hl_ent_time, the server clock HLEntFrame advances, not the
// render clock: refire delays are game time in the SDK and must survive a
// framerate change. With the QuakeC VM live HLGameFrame owns the clock and
// hl_ent_time stands still, so weapons are frozen on that path. The VM path is
// Quake's and has its own weapons.
//
// To drive this from HL1.ZC instead, call HLWeaponFrame(dt, map, eye, forward,
// right, up) next to HLEntFrame and delete the hook install at the bottom of
// this file.
//
// WEAPON FOLEY
//
// HL plays a weapon's reload foley from the VIEW MODEL's animation events, not
// from the weapon class - HLWeaponVmEvents below fires code 5004. Dumping the
// retail v_*.mdl set shows only three models carry 5004 at all:
//
//   v_9mmhandgun  reload f4 items/9mmclip2.wav, f23 items/9mmclip1.wav
//   v_9mmar       reload f5 items/cliprelease1.wav, f24 items/clipinsert1.wav
//   v_357         reload f70 weapons/357_reload1.wav
//
// Every other view model carries only 5001 muzzle flashes. So the event path
// covers the glock, mp5 and python and nothing else, and the remaining foley
// has to be emitted from this file the way the SDK's weapon classes do. That
// is what CHLWeaponInfo.reload_snd and .pump are for: the shotgun's cocking
// sound is CShotgun::ItemPostFrame's m_flPumpTime timer (weapons/scock1.wav),
// and the crossbow's is CCrossbow::Reload (weapons/xbow_reload1.wav).
//
// NOT IMPLEMENTED
//
//   - shell-by-shell shotgun reload. the reload is bulk; the pump sound and
//     the reload foley are emitted on the SDK's timings anyway.
//   - damage to monsters. there is no monster damage path to call.
//   - decals. HLDraw has no decal layer, so a bullet leaves a puff and a
//     ricochet and no mark.
//   - autoaim. the sprites are in hud.txt; the SDK's is a full sight cone over
//     the monster list, which does not exist.
//   - item_healthkit / item_battery / item_suit. those belong to the item
//     classes in HLEntity.ZC, not to the inventory.
//   - inventory across a changelevel. HL carries it in the transition save.
//   - beam and projectile VISUALS. HLDraw has no line primitive and no
//     non-brush mover, so the egon and gauss beams and the grenade/satchel
//     bodies are invisible. Their damage, ammo drain and timing are real. A
//     rocket and a bolt get a particle trail, which is the only marker the
//     particle layer can supply; nothing is faked with a stand-in sprite.
//   - the zoom on the crossbow and python secondaries changes hl_wpn_zoom_fov
//     but nothing applies it: the view fov lives in HL1.ZC, which compiles
//     later and cannot be reached from here.
//   - the RPG's laser_spot entity. the designator is traced live off the eye
//     each frame instead - see hl_wpn_spot_on.

//--- weapon ids -------------------------------------------------------------
//
// Order is the SDK's WEAPON_* order for the ones implemented. -1 is empty
// handed, which is how HL single player starts.

#define HLWPN_NONE			-1

#define HLWPN_CROWBAR		0
#define HLWPN_GLOCK			1
#define HLWPN_PYTHON			2
#define HLWPN_MP5			3
#define HLWPN_CROSSBOW		4
#define HLWPN_SHOTGUN		5
#define HLWPN_RPG			6
#define HLWPN_GAUSS			7
#define HLWPN_EGON			8
#define HLWPN_HORNETGUN		9
#define HLWPN_HANDGRENADE	10
#define HLWPN_TRIPMINE		11
#define HLWPN_SATCHEL		12
#define HLWPN_SNARK			13

#define HLWPN_COUNT			14

//--- ammo pools -------------------------------------------------------------
//
// m_rgAmmo in the SDK, indexed by an id the game registers by name. The full
// set, in the order CBasePlayerItem::AmmoInfoArray ends up holding them.

#define HLAMMO_NONE			-1

#define HLAMMO_9MM			0
#define HLAMMO_357			1
#define HLAMMO_BUCKSHOT		2
#define HLAMMO_ARGRENADE		3
#define HLAMMO_BOLT			4
#define HLAMMO_ROCKET		5
#define HLAMMO_URANIUM		6
#define HLAMMO_HANDGRENADE	7
#define HLAMMO_SATCHEL		8
#define HLAMMO_TRIPMINE		9
#define HLAMMO_SNARK			10
#define HLAMMO_HORNET		11

#define HLAMMO_COUNT			12

//weapon slots. MAX_WEAPON_SLOTS in the SDK, one per number key
#define HLWPN_SLOTS			5

//no clip: the weapon fires straight out of the pool (gauss, egon)
#define HLWPN_NOCLIP			-1

//--- fire modes -------------------------------------------------------------
//
// One id per PrimaryAttack/SecondaryAttack body in the SDK. The table stores
// one for each trigger and HLWeaponPrimary/HLWeaponSecondary branch on it.

#define HLFIRE_NONE			0
#define HLFIRE_MELEE			1	//CCrowbar::Swing
#define HLFIRE_BULLET		2	//FireBulletsPlayer
#define HLFIRE_SHOTGUN2		3	//CShotgun::SecondaryAttack, both barrels
#define HLFIRE_BOLT			4	//CCrossbow::FireBolt
#define HLFIRE_ROCKET		5	//CRpg::PrimaryAttack
#define HLFIRE_M203			6	//CMP5::SecondaryAttack
#define HLFIRE_GRENADE		7	//CHandGrenade, prime on press throw on release
#define HLFIRE_SATCHEL		8	//CSatchel::Throw
#define HLFIRE_SATCHEL_FIRE	9	//CSatchel::SecondaryAttack, the radio
#define HLFIRE_TRIPMINE		10	//CTripmine::PrimaryAttack
#define HLFIRE_SNARK			11	//CSqueak::PrimaryAttack
#define HLFIRE_HORNET		12	//CHgun::PrimaryAttack, FIREMODE_TRACK
#define HLFIRE_HORNET_FAST	13	//CHgun::SecondaryAttack, FIREMODE_FAST
#define HLFIRE_GAUSS			14	//CGauss::PrimaryAttack
#define HLFIRE_GAUSS_CHARGE	15	//CGauss::SecondaryAttack, held
#define HLFIRE_EGON_WIDE		16	//CEgon::PrimaryAttack, FIRE_WIDE
#define HLFIRE_EGON_NARROW	17	//CEgon::SecondaryAttack, FIRE_NARROW
#define HLFIRE_ZOOM			18	//CCrossbow / CPython SecondaryAttack
#define HLFIRE_SPOT			19	//CRpg::SecondaryAttack, the designator

//--- projectiles ------------------------------------------------------------
//
// The pool the header describes. Sized for the worst case a player can put in
// the air at once: five satchels plus five tripmines plus a bag of snarks and
// grenades still fits, and a saturated pool drops the newest shot.

#define HLPROJ_MAX			64

#define HLPRJ_FREE			0
#define HLPRJ_BOLT			1	//CCrossbowBolt
#define HLPRJ_STUCK			2	//a spent bolt standing in a wall
#define HLPRJ_ROCKET			3	//CRpgRocket
#define HLPRJ_CONTACT		4	//CGrenade::ShootContact
#define HLPRJ_TIMED			5	//CGrenade::ShootTimed
#define HLPRJ_SATCHEL		6	//CSatchelCharge
#define HLPRJ_TRIPMINE		7	//CTripmineGrenade
#define HLPRJ_SNARK			8	//CSqueakGrenade
#define HLPRJ_HORNET			9	//CHornet

//BOLT_AIR_VELOCITY, dlls/crossbow.cpp
#define HLPRJ_BOLT_SPEED		2000.0

//CCrossbowBolt::BoltTouch leaves a bolt in architecture for ten seconds
#define HLPRJ_BOLT_STICK		10.0

//SQUEEK_DETONATE_DELAY, dlls/squeakgrenade.cpp
#define HLPRJ_SNARK_LIFE		15.0

//CHornet dies on its own five seconds out
#define HLPRJ_HORNET_LIFE	5.0

//CTripmineGrenade::Spawn: 2.5s to power up when placed by a player, and a
//128 unit beam
#define HLPRJ_MINE_ARM		2.5
#define HLPRJ_MINE_BEAM		128.0

//velocity below which a bounced grenade is considered at rest, from the
//vecTestVelocity test in CGrenade::BounceTouch
#define HLPRJ_REST_SPEED		60.0

class CHLProj
{
	I64	 kind;			//HLPRJ_*, HLPRJ_FREE for an empty slot
	F64	 org[3];
	F64	 vel[3];

	//bolt flight direction, or the surface normal a tripmine is stuck to
	F64	 dir[3];

	F64	 gravity;		//pev->gravity, a multiplier on sv_gravity
	F64	 friction;		//pev->friction, the bounce backoff
	F64	 damage;		//pev->dmg

	F64	 die;			//absolute detonate/remove time, 0 = never
	F64	 arm;			//rocket ignite time, tripmine powerup time
	F64	 next_hurt;		//m_flNextAttack, BounceTouch's contact debounce
	F64	 next_hop;		//CSqueakGrenade::HuntThink cadence
	F64	 beam_len;		//tripmine beam length at the moment it armed

	Bool bounce;		//MOVETYPE_BOUNCE rather than MOVETYPE_FLY
	Bool on_ground;
	Bool armed;

	I64	 owner;			//entity index that fired it, -1 for none
};

CHLProj	hl_proj[HLPROJ_MAX];
I64		hl_proj_live	= 0;	//slots in use, for HLWeaponReport
I64		hl_proj_dropped	= 0;	//shots the pool could not hold

//CBasePlayerItem::Touch's pickup box - UTIL_SetSize(-16,-16,0)..(16,16,16).
//items are not linked into the world by the spawn pass (weapon_* and ammo_*
//are not classes HLEntSpawnOne knows), so absmin/absmax are zero and the box
//has to be rebuilt here from the origin
#define HLWPN_ITEM_HALF		16.0
#define HLWPN_ITEM_TOP		16.0

//how long the bucket UI stays up after the last selection key. the SDK fades
//it out on a longer timer
#define HLWPN_SEL_TIME		1.5

//flat lighting for the view model, matching HL1.ZC's HLVM_LIGHT for the alias
//viewgun - a view model is not lit by the world in the software renderer, it
//would go black indoors
#define HLWPN_VM_LIGHT		176

//a stall must not fast-forward every refire timer at once
#define HLWPN_MAX_DT			0.25

class CHLWeaponInfo
{
	U8	classname[32];		//weapon_* entity classname, and the pickup key
	U8	hud_name[32];		//hud.txt has "d_<hud_name>" for every weapon
	U8	view_model[64];		//models/v_*.mdl

	I64	slot;				//iSlot from GetItemInfo, 0..4
	I64	pos;				//iPosition inside the bucket

	I64	ammo;				//HLAMMO_*, HLAMMO_NONE for the crowbar
	I64	max_clip;			//HLWPN_NOCLIP to fire from the pool
	I64	give;				//m_iDefaultAmmo, granted with the weapon itself

	F64	damage;				//gSkillData.plrDmg*, per bullet
	I64	bullets;			//pellets per shot
	F64	spread;				//VECTOR_CONE_* , a tangent not an angle
	F64	rate;				//m_flNextPrimaryAttack step
	F64	range;				//hitscan length
	F64	reload_time;		//0 for a weapon with no clip to fill

	//the crosshairs sheet is a grid of cells; every weapon_*.txt names one
	//cell for "crosshair". -1 means the weapon has none (melee)
	I64	xhair_col;
	I64	xhair_row;

	//sequence labels, not indices: v_crowbar has attack1miss where v_357 has
	//fire1 and v_9mmar has deploy where the rest have draw. every label here
	//was read out of the retail v_*.mdl seqdesc table, not guessed
	U8	seq_idle[24];
	U8	seq_fire[24];
	U8	seq_reload[24];
	U8	seq_draw[24];

	//empty for melee: HLWeaponMelee picks its sound from the outcome, hit or
	//miss, the way CCrowbar::Swing does
	U8	fire_snd[64];

	//--- the second trigger, and the foley the view model does not carry ---

	I64	fire_mode;		//HLFIRE_*, which PrimaryAttack body this is
	I64	sec_mode;		//HLFIRE_*, HLFIRE_NONE for a weapon with one trigger
	I64	sec_ammo;		//pool the secondary drains, HLAMMO_NONE to reuse ammo
	F64	sec_damage;
	I64	sec_bullets;
	F64	sec_spread;
	F64	sec_rate;		//m_flNextSecondaryAttack step

	//seconds after a shot before weapons/scock1.wav plays, 0 for a weapon
	//that does not pump. CShotgun::ItemPostFrame's m_flPumpTime
	F64	pump;
	F64	sec_pump;

	//played at the start of a reload for a model with no 5004 event - see the
	//WEAPON FOLEY note in the header. empty when the model covers it
	U8	reload_snd[64];

	U8	seq_fire2[24];	//the secondary's animation
	U8	sec_snd[64];
};

CHLWeaponInfo	hl_wpn_info[HLWPN_COUNT];

//--- inventory --------------------------------------------------------------

Bool	hl_wpn_have[HLWPN_COUNT];
I64		hl_wpn_clip[HLWPN_COUNT];
F64		hl_wpn_next[HLWPN_COUNT];		//m_flNextPrimaryAttack, absolute
I64		hl_wpn_ammo[HLAMMO_COUNT];
I64		hl_wpn_ammo_max[HLAMMO_COUNT];

F64		hl_wpn_next2[HLWPN_COUNT];		//m_flNextSecondaryAttack, absolute

I64		hl_wpn_active		= HLWPN_NONE;
F64		hl_wpn_reload_done	= 0.0;		//0 = not reloading
I64		hl_wpn_reloading	= HLWPN_NONE;

//--- per weapon attack state ------------------------------------------------
//
// The members the SDK keeps on the weapon object. One copy each: only the
// active weapon can be mid-attack, and switching away cancels it, which is
// what CBasePlayerWeapon::Holster does.

//CShotgun::m_flPumpTime - absolute time weapons/scock1.wav is due, 0 = idle
F64		hl_wpn_pump_time	= 0.0;

//CHandGrenade::m_flStartThrow - when the pin was pulled, 0 = not primed
F64		hl_wpn_gren_start	= 0.0;

//CSatchel::m_chargeReady - 0 none out, 1 radio live, 2 just detonated
I64		hl_wpn_satchel_ready = 0;

//CGauss: m_fInAttack 0 off / 1 spinup / 2 spinning, and the charge clocks
I64		hl_wpn_gauss_state	= 0;
F64		hl_wpn_gauss_start	= 0.0;	//m_flStartCharge
F64		hl_wpn_gauss_burn	= 0.0;	//m_flNextAmmoBurn
F64		hl_wpn_gauss_full	= 0.0;	//m_flAmmoStartCharge
Bool	hl_wpn_gauss_primary = FALSE;	//m_fPrimaryFire

//CEgon: m_fireState, m_fireMode and the two clocks
Bool	hl_wpn_egon_on		= FALSE;
I64		hl_wpn_egon_mode	= HLFIRE_EGON_WIDE;
F64		hl_wpn_egon_pulse	= 0.0;	//pev->dmgtime
F64		hl_wpn_egon_ammo	= 0.0;	//m_flAmmoUseTime

//CHgun::m_iFirePhase, the eight point rosette the fast mode fires around
I64		hl_wpn_hornet_phase	= 0;

//CHgun::m_flRechargeTime - the hive grows its own ammo back, so the hornet pool
//refills on its own whether or not the weapon is in hand
F64		hl_wpn_hornet_charge = 0.0;

//GetRechargeTime, hornetgun.cpp: 0.5 in single player, 0.3 in multiplayer
#define HLWPN_HORNET_RECHARGE	0.5

//CRpg::m_fSpotActive and the point the designator is resting on
Bool	hl_wpn_spot_on		= FALSE;
F64		hl_wpn_spot_pos[3];
Bool	hl_wpn_spot_valid	= FALSE;

//CCrossbow::m_fInZoom / CPython::m_fInZoom. nothing applies this - see the
//header - but the state is real so a weapon switch can clear it
I64		hl_wpn_zoom_fov		= 0;

//--- view model -------------------------------------------------------------

CHLStudio	*hl_wpn_vm			= NULL;
I64			 hl_wpn_vm_for		= HLWPN_NONE;	//which weapon hl_wpn_vm is
I64			 hl_wpn_vm_seq		= 0;
F64			 hl_wpn_vm_cycle	= 0.0;
Bool		 hl_wpn_vm_loop		= TRUE;
Bool		 hl_wpn_vm_done		= FALSE;

//Highest frame of the view model sequence whose events have already fired.
I64			 hl_wpn_vm_ev_frame	= -1;

//--- input edges ------------------------------------------------------------
//
// The number keys are read here rather than through HL1.ZC's impulse system:
// hl_bind_key lives in HLMenu.ZC and the impulses are consumed by the QuakeC
// path, which this replaces.

Bool	hl_wpn_slot_held[HLWPN_SLOTS];
Bool	hl_wpn_next_held	= FALSE;
Bool	hl_wpn_prev_held	= FALSE;
Bool	hl_wpn_reload_held	= FALSE;
Bool	hl_wpn_attack_held	= FALSE;
Bool	hl_wpn_attack2_held	= FALSE;

//--- selection UI -----------------------------------------------------------

I64		hl_wpn_sel_slot		= -1;		//bucket open in the UI, -1 closed
F64		hl_wpn_sel_until	= 0.0;

//The two-step menu, cl_dll/hud_ammo.cpp's SlotInput/UserCmd_Slot*. With
//hud_fastswitch 0 - HL's default - a slot key opens the bucket and highlights
//an entry, pressing the same key again walks to the next entry, and +attack
//confirms. The selection state is here rather than in the HUD because the
//trigger has to mean "confirm" while the menu is up, which is a weapon layer
//decision: CBasePlayer::SelectItem is what the confirm ends up calling.
I64		hl_wpn_sel_pos		= -1;		//highlighted entry, -1 = none
Bool	hl_wpn_fastswitch	= FALSE;	//hud_fastswitch

//--- bookkeeping ------------------------------------------------------------

F64		hl_wpn_last_time	= 0.0;		//hl_ent_time at the previous tick
Bool	hl_wpn_spawned		= FALSE;
I64		hl_wpn_xhair_sheet	= -1;
I64		hl_wpn_xhair_res	= 0;		//which hl_hud_res that sheet is for
I64		hl_wpn_picked		= 0;		//pickups this level, for HLTest

U0 HLWeaponSetInfo(I64 id, U8 *classname, U8 *hud_name, U8 *view_model,
	I64 slot, I64 pos, I64 ammo, I64 max_clip, I64 give,
	F64 damage, I64 bullets, F64 spread, F64 rate, F64 range, F64 reload_time,
	I64 xcol, I64 xrow,
	U8 *idle, U8 *fire, U8 *reload, U8 *draw, U8 *fire_snd)
{//one row of the table. a setter rather than a brace initialiser - a global's
 //initialiser is not reliable on this compiler
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return;

	w = &hl_wpn_info[id];

	HLStrCopy(w->classname, classname, 32);
	HLStrCopy(w->hud_name, hud_name, 32);
	HLStrCopy(w->view_model, view_model, 64);

	w->slot        = slot;
	w->pos         = pos;
	w->ammo        = ammo;
	w->max_clip    = max_clip;
	w->give        = give;
	w->damage      = damage;
	w->bullets     = bullets;
	w->spread      = spread;
	w->rate        = rate;
	w->range       = range;
	w->reload_time = reload_time;
	w->xhair_col   = xcol;
	w->xhair_row   = xrow;

	HLStrCopy(w->seq_idle, idle, 24);
	HLStrCopy(w->seq_fire, fire, 24);
	HLStrCopy(w->seq_reload, reload, 24);
	HLStrCopy(w->seq_draw, draw, 24);
	HLStrCopy(w->fire_snd, fire_snd, 64);

	//a row is hitscan with no second trigger until HLWeaponSetMode says
	//otherwise, which keeps the five original rows reading as they did
	w->fire_mode   = HLFIRE_BULLET;
	w->sec_mode    = HLFIRE_NONE;
	w->sec_ammo    = HLAMMO_NONE;
	w->sec_damage  = 0.0;
	w->sec_bullets = 0;
	w->sec_spread  = 0.0;
	w->sec_rate    = 0.5;
	w->pump        = 0.0;
	w->sec_pump    = 0.0;

	w->reload_snd[0] = 0;
	w->seq_fire2[0]  = 0;
	w->sec_snd[0]    = 0;
}

U0 HLWeaponSetMode(I64 id, I64 fire_mode, I64 sec_mode, I64 sec_ammo,
	F64 sec_damage, I64 sec_bullets, F64 sec_spread, F64 sec_rate,
	F64 pump, F64 sec_pump, U8 *reload_snd, U8 *fire2, U8 *sec_snd)
{//the second half of a table row - the trigger bodies and the foley the view
 //model does not carry. split off HLWeaponSetInfo because one setter with
 //thirty arguments is unreadable, not because the two differ in kind
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return;

	w = &hl_wpn_info[id];

	w->fire_mode   = fire_mode;
	w->sec_mode    = sec_mode;
	w->sec_ammo    = sec_ammo;
	w->sec_damage  = sec_damage;
	w->sec_bullets = sec_bullets;
	w->sec_spread  = sec_spread;
	w->sec_rate    = sec_rate;
	w->pump        = pump;
	w->sec_pump    = sec_pump;

	HLStrCopy(w->reload_snd, reload_snd, 64);
	HLStrCopy(w->seq_fire2, fire2, 24);
	HLStrCopy(w->sec_snd, sec_snd, 64);
}

U0 HLWeaponInit()
{//globals aren't zeroed - see the note in HLPak.ZC
 //
 //damage figures are gSkillData at skill 1 (skill.cfg sk_plr_*1): crowbar 10,
 //9mm 8, 357 40, buckshot 5. spreads are the VECTOR_CONE_* constants the
 //attack functions pass to FireBulletsPlayer, which are tangents:
 //
 //    VECTOR_CONE_3DEGREES  0.05234    VECTOR_CONE_10DEGREES 0.08716
 //
 //ranges are the last argument of FireBulletsPlayer - 2048 for the shotgun,
 //8192 for everything else, and 32 units of TraceLine for the crowbar
	I64 i;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		hl_wpn_have[i]  = FALSE;
		hl_wpn_clip[i]  = 0;
		hl_wpn_next[i]  = 0.0;
		hl_wpn_next2[i] = 0.0;
	}

	for (i = 0; i < HLAMMO_COUNT; i++)
		hl_wpn_ammo[i] = 0;

	for (i = 0; i < HLPROJ_MAX; i++)
		hl_proj[i].kind = HLPRJ_FREE;

	hl_proj_live    = 0;
	hl_proj_dropped = 0;

	//*_MAX_CARRY from weapons.h
	hl_wpn_ammo_max[HLAMMO_9MM]        = 250;	//_9MM_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_357]        = 36;	//_357_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_BUCKSHOT]   = 125;	//BUCKSHOT_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_ARGRENADE]  = 10;	//M203_GRENADE_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_BOLT]       = 50;	//BOLT_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_ROCKET]     = 5;		//ROCKET_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_URANIUM]    = 100;	//URANIUM_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_HANDGRENADE] = 10;	//HANDGRENADE_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_SATCHEL]    = 5;		//SATCHEL_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_TRIPMINE]   = 5;		//TRIPMINE_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_SNARK]      = 15;	//SNARK_MAX_CARRY
	hl_wpn_ammo_max[HLAMMO_HORNET]     = 8;		//HORNET_MAX_CARRY

	for (i = 0; i < HLWPN_SLOTS; i++)
		hl_wpn_slot_held[i] = FALSE;

	hl_wpn_active      = HLWPN_NONE;
	hl_wpn_reload_done = 0.0;
	hl_wpn_reloading   = HLWPN_NONE;

	hl_wpn_pump_time     = 0.0;
	hl_wpn_gren_start    = 0.0;
