		2, 1,
		"sm_idle", "shoot", "reload", "draw", "weapons/sbarrel1.wav");

	//rpg: one rocket in the tube, ROCKET_MAX_CARRY 5, sk_plr_rpg1 100. the
	//secondary toggles the laser designator the rocket steers toward
	//hud_name is the "d_<name>" key into hud.txt, and the RPG's row there is
	//d_rpg_rocket - there is no d_rpg, so the selection strip drew no icon
	HLWeaponSetInfo(HLWPN_RPG, "weapon_rpg", "rpg_rocket",
		"models/v_rpg.mdl", 3, 0,
		HLAMMO_ROCKET, 1, 1,
