U0 HLWeaponSetInfo(I64 id, U8 *classname, U8 *hud_name, U8 *view_model,
	I64 slot, I64 pos, I64 ammo, I64 max_clip, I64 give,
	F64 damage, I64 bullets, F64 spread, F64 rate, F64 range, F64 reload_time,
	I64 xcol, I64 xrow,
	U8 *idle, U8 *fire, U8 *reload, U8 *draw, U8 *fire_snd)
{
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return;

	w = &hl_wpn_info[id];

	HLStrCopy(w->classname, classname, 32);
	HLStrCopy(w->hud_name, hud_name, 32);
	HLStrCopy(w->view_model, view_model, 64);

	w->slot        = slot;
	w->pos         = pos;
	w->ammo        = ammo;
	w->max_clip    = max_clip;
	w->give        = give;
	w->damage      = damage;
	w->bullets     = bullets;
	w->spread      = spread;
	w->rate        = rate;
	w->range       = range;
	w->reload_time = reload_time;
	w->xhair_col   = xcol;
	w->xhair_row   = xrow;

	HLStrCopy(w->seq_idle, idle, 24);
	HLStrCopy(w->seq_fire, fire, 24);
	HLStrCopy(w->seq_reload, reload, 24);
	HLStrCopy(w->seq_draw, draw, 24);
	HLStrCopy(w->fire_snd, fire_snd, 64);

	w->fire_mode   = HLFIRE_BULLET;
	w->sec_mode    = HLFIRE_NONE;
	w->sec_ammo    = HLAMMO_NONE;
	w->sec_damage  = 0.0;
	w->sec_bullets = 0;
	w->sec_spread  = 0.0;
	w->sec_rate    = 0.5;
	w->pump        = 0.0;
	w->sec_pump    = 0.0;

	w->reload_snd[0] = 0;
	w->seq_fire2[0]  = 0;
	w->sec_snd[0]    = 0;
}

U0 HLWeaponSetMode(I64 id, I64 fire_mode, I64 sec_mode, I64 sec_ammo,
	F64 sec_damage, I64 sec_bullets, F64 sec_spread, F64 sec_rate,
	F64 pump, F64 sec_pump, U8 *reload_snd, U8 *fire2, U8 *sec_snd)
{
	CHLWeaponInfo *w;

	if (id < 0 || id >= HLWPN_COUNT)
		return;

	w = &hl_wpn_info[id];

	w->fire_mode   = fire_mode;
	w->sec_mode    = sec_mode;
	w->sec_ammo    = sec_ammo;
	w->sec_damage  = sec_damage;
	w->sec_bullets = sec_bullets;
	w->sec_spread  = sec_spread;
	w->sec_rate    = sec_rate;
	w->pump        = pump;
	w->sec_pump    = sec_pump;

	HLStrCopy(w->reload_snd, reload_snd, 64);
	HLStrCopy(w->seq_fire2, fire2, 24);
	HLStrCopy(w->sec_snd, sec_snd, 64);
}

U0 HLWeaponInit()
{
	I64 i;

	for (i = 0; i < HLWPN_COUNT; i++)
	{
		hl_wpn_have[i]  = FALSE;
		hl_wpn_clip[i]  = 0;
		hl_wpn_next[i]  = 0.0;
		hl_wpn_next2[i] = 0.0;
	}

	for (i = 0; i < HLAMMO_COUNT; i++)
		hl_wpn_ammo[i] = 0;

	for (i = 0; i < HLPROJ_MAX; i++)
		hl_proj[i].kind = HLPRJ_FREE;

	hl_proj_live    = 0;
	hl_proj_dropped = 0;

	for (i = 0; i < HLPRJ_KINDS; i++)
	{
		hl_proj_mdl[i]   = NULL;
		hl_proj_tried[i] = FALSE;
	}

	for (i = 0; i < HLPRJ_KINDS * HLST_MAX_CONTROLLERS; i++)
		hl_proj_ctl[i] = 0.0;

	//*_MAX_CARRY from weapons.h
	hl_wpn_ammo_max[HLAMMO_9MM]        = 250;
	hl_wpn_ammo_max[HLAMMO_357]        = 36;
	hl_wpn_ammo_max[HLAMMO_BUCKSHOT]   = 125;
	hl_wpn_ammo_max[HLAMMO_ARGRENADE]  = 10;
	hl_wpn_ammo_max[HLAMMO_BOLT]       = 50;
	hl_wpn_ammo_max[HLAMMO_ROCKET]     = 5;
	hl_wpn_ammo_max[HLAMMO_URANIUM]    = 100;
	hl_wpn_ammo_max[HLAMMO_HANDGRENADE] = 10;
	hl_wpn_ammo_max[HLAMMO_SATCHEL]    = 5;
	hl_wpn_ammo_max[HLAMMO_TRIPMINE]   = 5;
	hl_wpn_ammo_max[HLAMMO_SNARK]      = 15;
	hl_wpn_ammo_max[HLAMMO_HORNET]     = 8;

	for (i = 0; i < HLWPN_SLOTS; i++)
		hl_wpn_slot_held[i] = FALSE;

	hl_wpn_active      = HLWPN_NONE;
	hl_wpn_reload_done = 0.0;
	hl_wpn_reloading   = HLWPN_NONE;

	hl_wpn_pump_time     = 0.0;
	hl_wpn_gren_start    = 0.0;
	hl_wpn_satchel_ready = 0;

	hl_wpn_gauss_state   = 0;
	hl_wpn_gauss_start   = 0.0;
	hl_wpn_gauss_burn    = 0.0;
	hl_wpn_gauss_full    = 0.0;
	hl_wpn_gauss_primary = FALSE;

	hl_wpn_egon_on    = FALSE;
	hl_wpn_egon_mode  = HLFIRE_EGON_WIDE;
	hl_wpn_egon_pulse = 0.0;
	hl_wpn_egon_ammo  = 0.0;

	hl_wpn_egon_beam = FALSE;
	HLVecSet(hl_wpn_egon_src, 0.0, 0.0, 0.0);
	HLVecSet(hl_wpn_egon_hit, 0.0, 0.0, 0.0);

	HLVecSet(hl_wpn_punch, 0.0, 0.0, 0.0);
	HLVecSet(hl_wpn_push, 0.0, 0.0, 0.0);

	HLVecSet(hl_wpn_vm_ang, 0.0, 0.0, 0.0);
	hl_wpn_vm_bob = 0.0;
	hl_wpn_vm_fed = FALSE;

	hl_wpn_tracer_count = 0;

	hl_wpn_shell_reload = 0;
	hl_wpn_shell_next   = 0.0;
	hl_wpn_sv_aim       = TRUE;

	for (i = 0; i < HLWPN_BEAM_MAX; i++)
		hl_wpn_beam[i].die = 0.0;

	hl_wpn_beam_next = 0;

	hl_wpn_spr_laser = NULL;
	hl_wpn_spr_gauss = NULL;
	hl_wpn_spr_egon  = NULL;
	hl_wpn_spr_flare = NULL;
	hl_wpn_spr_tried = FALSE;

	hl_wpn_hornet_phase  = 0;
	hl_wpn_hornet_charge = 0.0;

	hl_wpn_spot_on    = FALSE;
	hl_wpn_spot_valid = FALSE;
	HLVecSet(hl_wpn_spot_pos, 0.0, 0.0, 0.0);

	hl_wpn_on_target = FALSE;
	hl_wpn_zoom_fov  = 0;

	hl_wpn_vm       = NULL;
	hl_wpn_vm_for   = HLWPN_NONE;
	hl_wpn_swing_miss = 0;
	hl_wpn_swing_hit  = 0;

	hl_wpn_vm_seq      = 0;
	hl_wpn_vm_cycle    = 0.0;
	hl_wpn_vm_loop     = TRUE;
	hl_wpn_vm_done     = FALSE;
	hl_wpn_vm_is_idle  = FALSE;
	hl_wpn_idle_until  = 0.0;

	hl_wpn_next_held    = FALSE;
	hl_wpn_prev_held    = FALSE;
	hl_wpn_reload_held  = FALSE;
	hl_wpn_cycle_want   = 0;
	hl_wpn_attack_held  = FALSE;
	hl_wpn_attack2_held = FALSE;

	hl_wpn_sel_slot   = -1;
	hl_wpn_sel_until  = 0.0;
	hl_wpn_sel_pos    = -1;
	hl_wpn_fastswitch = FALSE;

	hl_wpn_last_time   = 0.0;
	hl_wpn_spawned     = FALSE;
	hl_wpn_xhair_sheet = -1;
	hl_wpn_xhair_gen   = -1;
	hl_wpn_picked      = 0;
