		1, 2,
		"idle", "fire", "reload", "draw1", "weapons/rocketfire1.wav");

	//gauss: fires straight out of the uranium pool, two per primary shot.
	//sk_plr_gauss1 20 fixed on the primary; the secondary charges to 200
	HLWeaponSetInfo(HLWPN_GAUSS, "weapon_gauss", "gauss",
		"models/v_gauss.mdl", 3, 1,
		HLAMMO_URANIUM, HLWPN_NOCLIP, 20,
		20.0, 1, 0.0, 0.2, 8192.0, 0.0,
		2, 2,
		"idle", "fire", "", "draw", "weapons/gauss2.wav");

	//egon: sk_plr_egon_wide1 14 per pulse on the primary, narrow 6 on the
	//secondary. held trigger, 2048 unit reach
	HLWeaponSetInfo(HLWPN_EGON, "weapon_egon", "egon",
		"models/v_egon.mdl", 3, 2,
		HLAMMO_URANIUM, HLWPN_NOCLIP, 20,
