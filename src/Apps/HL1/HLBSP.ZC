// HLBSP.ZC - version 30 bsp loader
//
// 4 byte version, then 15 (offset, length) lump pointers. records are decoded
// field by field into F64 structs, not overlaid: on-disk vectors are binary32
// and ZealC arithmetic is F64 only, so an overlay reads garbage.
//
// Widening near doubles the geometry: e1m1 is ~2MB of structs off a 1.3MB file.
//
// BSP30 geometry lumps are byte-identical to BSP29 in layout and record size.
// The differences:
//
//   - textures may live in an external WAD3 instead of the miptex lump, and
//     each carries its own 256 colour palette rather than sharing gfx/palette
//   - the lighting lump is RGB, three bytes per luxel, not one
//   - four clip hulls instead of three (hull 3 is the crouched box)
//   - extra contents codes: origin, clip, currents, translucent, ladder

#define HLLUMP_ENTITIES		0
#define HLLUMP_PLANES		1
#define HLLUMP_MIPTEX		2
#define HLLUMP_VERTICES		3
#define HLLUMP_VISIBILITY	4
#define HLLUMP_NODES			5
#define HLLUMP_TEXINFO		6
#define HLLUMP_FACES			7
#define HLLUMP_LIGHTING		8
#define HLLUMP_CLIPNODES		9
#define HLLUMP_LEAFS			10
#define HLLUMP_MARKSURFACES	11
#define HLLUMP_EDGES			12
#define HLLUMP_SURFEDGES		13
#define HLLUMP_MODELS		14
#define HLLUMP_COUNT			15

#define HLBSP_VERSION		30

//lighting lump is RGB in BSP30. Every index into it scales by this
#define HLLIGHT_STRIDE		3

//leaf contents. Everything but EMPTY is solid or a fluid volume
#define HLCONTENTS_EMPTY		-1
#define HLCONTENTS_SOLID		-2
#define HLCONTENTS_WATER		-3
#define HLCONTENTS_SLIME		-4
#define HLCONTENTS_LAVA		-5
#define HLCONTENTS_SKY		-6

//HL additions. ORIGIN and CLIP are compiler-only and never reach a render
//leaf; the rest do
#define HLCONTENTS_ORIGIN		-7		//stripped by the compiler
#define HLCONTENTS_CLIP		-8		//solid to players, invisible
#define HLCONTENTS_CURRENT_0	-9
#define HLCONTENTS_CURRENT_90	-10
#define HLCONTENTS_CURRENT_180	-11
#define HLCONTENTS_CURRENT_270	-12
#define HLCONTENTS_CURRENT_UP	-13
#define HLCONTENTS_CURRENT_DOWN	-14
#define HLCONTENTS_TRANSLUCENT	-15
#define HLCONTENTS_LADDER		-16

//texinfo flags. TEX_SPECIAL means sky or a nodraw surface: no lightmap, no
//surface cache entry
#define HLTEX_SPECIAL		1

class CHLPlane
{
	F64	normal[3];
	F64	dist;
	I64	type;		//0-2 axial on x/y/z, 3+ general case
};

class CHLVertex
{
	F64	pt[3];
};

class CHLEdge
{
	I64	v[2];
};

class CHLNode
{
	I64	plane_num;
	I64	children[2];	//>= 0 node index, < 0 is ~(leaf index)
	F64	mins[3];
	F64	maxs[3];
	I64	first_face;
	I64	num_faces;
};

class CHLLeaf
{
	I64	contents;
	I64	vis_offset;		//byte offset into the compressed pvs, -1 if none
	F64	mins[3];
	F64	maxs[3];
	I64	first_marksurface;
	I64	num_marksurfaces;
	U8	ambient[4];
};

class CHLClipNode
{//collision tree, pre-expanded by the compiler per bbox size. A trace is a
 //point trace through the matching hull, not a box sweep
	I64	plane_num;
	I64	children[2];	//>= 0 clipnode index, < 0 is a contents value
};

class CHLTexInfo
{
	F64	vecs[8];		//two rows of (x y z offset)
	I64	miptex;
	I64	flags;
};

class CHLFace
{
	I64	plane_num;
	I64	side;			//0 front of plane, 1 back
	I64	first_edge;		//index into the surfedge list
	I64	num_edges;
	I64	tex_info;
	U8	styles[4];
	I64	light_offset;	//byte offset into the lighting lump, -1 if unlit

	//R_MarkLights: which dlights reached this face, and on what frame
	I64	dlight_frame;
	I64	dlight_bits;

	//derived by HLBSPCalcSurfaceExtents
	F64	mins_s;
	F64	mins_t;
	I64	extent_s;
	I64	extent_t;
};

class CHLModel
{
	F64	mins[3];
	F64	maxs[3];
	F64	origin[3];
	I64	head_node[4];
	//root of the synthesised hull 0 from HLBSPMakeHull0. head_node[0] remains a
	//render node index; the vis walk and point contents both use it as one
	I64	hull0_head;
	I64	vis_leafs;
	I64	first_face;
	I64	num_faces;
};

class CHLTexture
{
	U8	 name[16];
	I64	 width;
	I64	 height;
	U8	*texels[4];		//four mip levels, borrowed from the map buffer

	//768 bytes of RGB, borrowed from wherever the miptex body lives. Every HL
	//texture has its own palette, so there is no single colormap the world can
	//be shaded through. This forces 32bpp surfaces
	U8	*palette;

	//world textures are power of two and wrap by AND. Model skins are arbitrary
	//(296x194 and such) and must clamp; masking scrambles them
	Bool clamp;

	//256x128 holding two stacked 128x128 layers, drawn by eye direction
	Bool is_sky;
	Bool is_turb;	//'*' quake water, '!' HL water - both wave the surface

	//HL name conventions. Render intent is encoded in the first character;
	//texinfo has no field for it
	Bool is_masked;	//'{': palette index 255 is the transparent key
	Bool is_scroll;	//"scroll" prefix: conveyor, texture slides along s
	Bool is_light;	//'~': emits light, qrad-only but keeps fullbright here

	//Mod_LoadTextures anim chains. "+0button" is frame 0, "+abutton".."+jbutton"
	//are the alternate chain an entity picks with .frame
	I64	 anim_total;	//frames * ANIM_CYCLE, 0 when not animated
	I64	 anim_min;
	I64	 anim_max;
	I64	 anim_next;		//texture index of the next frame
	I64	 alt_anims;		//texture index of the alternate chain, -1 if none
};

class CHLMap
{
	U8			*raw;			//owned copy of the whole file
	I64			 raw_size;

	CHLPlane		*planes;
	I64			 num_planes;
	CHLVertex	*vertices;
	I64			 num_vertices;
	CHLEdge		*edges;
	I64			 num_edges;
	I64			*surfedges;		//signed, negative walks the edge backwards
	I64			 num_surfedges;
	CHLNode		*nodes;
	I64			 num_nodes;
	CHLClipNode	*clipnodes;
	I64			 num_clipnodes;
	CHLLeaf		*leafs;
	I64			 num_leafs;
	CHLTexInfo	*texinfo;
	I64			 num_texinfo;
	CHLFace		*faces;
	I64			 num_faces;
	I64			*marksurfaces;
	I64			 num_marksurfaces;
	CHLModel		*models;
	I64			 num_models;
	CHLTexture	*textures;
	I64			 num_textures;

	U8			*visdata;		//rle compressed pvs
	I64			 visdata_size;
	U8			*lightdata;
	I64			 lightdata_size;
	U8			*entities;		//nul terminated key/value text
	I64			 entities_size;
};

//path of the current map. Declared here, not in the shell: the console and the
//savegame both need it and both compile first
U8 hl_map_name[96];

//must be declared before HLNetSv, remote HLPlayerMove needs it
CHLMap *hl_map = NULL;

I64 hl_map_bad_reports = 0;

Bool HLMapValid(CHLMap *map, U8 *who)
{//reject an impossible map pointer and name the caller
 //
 //a corrupted CHLMap* is non-canonical, so the cpu raises a GP fault rather
 //than a page fault, landing in the debugger with no log and no caller
	I64 addr = map;

	//canonical user addresses only. Corruption shows as high bits set,
	//e.g. F000FF53F000FF53
	if (map && addr >= 0x1000 && addr < 0x0000800000000000)
		return TRUE;

	if (hl_map_bad_reports < 8)
	{
		hl_map_bad_reports++;
		"HLBSP: bad map pointer 0x%X from %s\n", addr, who;
	}

	return FALSE;
}

U0 HLBSPFree(CHLMap *map)
{
	if (!map)
		return;

	if (map->planes)		Free(map->planes);
	if (map->vertices)		Free(map->vertices);
	if (map->edges)			Free(map->edges);
	if (map->surfedges)		Free(map->surfedges);
	if (map->nodes)			Free(map->nodes);
	if (map->clipnodes)		Free(map->clipnodes);
	if (map->leafs)			Free(map->leafs);
	if (map->texinfo)		Free(map->texinfo);
	if (map->faces)			Free(map->faces);
	if (map->marksurfaces)	Free(map->marksurfaces);
	if (map->models)		Free(map->models);
	if (map->textures)		Free(map->textures);
	if (map->raw)			Free(map->raw);

	Free(map);
}

U0 HLBSPCalcSurfaceExtents(CHLMap *map, CHLFace *f)
{//project the verts through the texture axes to size the lightmap grid.
 //One luxel per 16 texels, extents snap outward
	CHLTexInfo	*ti = &map->texinfo[f->tex_info];
	CHLVertex	*v;
	F64			 mins[2];
	F64			 maxs[2];
	F64			 val;
	I64			 i;
	I64			 j;
	I64			 e;
	I64			 bmins;
	I64			 bmaxs;

	mins[0] = 999999.0;
	mins[1] = 999999.0;
	maxs[0] = -999999.0;
	maxs[1] = -999999.0;

	for (i = 0; i < f->num_edges; i++)
	{
		e = map->surfedges[f->first_edge + i];
		if (e >= 0)
			v = &map->vertices[map->edges[e].v[0]];
		else
			v = &map->vertices[map->edges[-e].v[1]];

		for (j = 0; j < 2; j++)
		{
			val = v->pt[0] * ti->vecs[j * 4] +
				  v->pt[1] * ti->vecs[j * 4 + 1] +
				  v->pt[2] * ti->vecs[j * 4 + 2] +
				  ti->vecs[j * 4 + 3];

			if (val < mins[j])
				mins[j] = val;
			if (val > maxs[j])
				maxs[j] = val;
		}
	}

	//snap to the 16 texel lightmap grid
	bmins = ToI64(Floor(mins[0] / 16.0));
	bmaxs = ToI64(Ceil(maxs[0] / 16.0));
	f->mins_s   = bmins * 16.0;
	f->extent_s = (bmaxs - bmins) * 16;

	bmins = ToI64(Floor(mins[1] / 16.0));
	bmaxs = ToI64(Ceil(maxs[1] / 16.0));
	f->mins_t   = bmins * 16.0;
	f->extent_t = (bmaxs - bmins) * 16;
}

//ANIM_CYCLE: two ticks of the 10hz anim clock per frame
#define HLANIM_CYCLE		2

U0 HLBSPSequenceTextures(CHLMap *map)
{//Mod_LoadTextures second pass, link "+Nname" into a cycle and
 //"+ANAME".."+JNAME" into the alternate cycle
	CHLTexture	*t;
	I64			 anims[10];
	I64			 alts[10];
	I64			 i;
	I64			 j;
	I64			 c;
	I64			 num;
	I64			 max;
	I64			 altmax;

	for (i = 0; i < map->num_textures; i++)
	{
		t = &map->textures[i];

		if (t->name[0] != '+' || t->anim_total)
			goto qst_next;

		for (j = 0; j < 10; j++)
		{
			anims[j] = -1;
			alts[j]  = -1;
		}

		max    = 0;
		altmax = 0;

		//same name from the third char on is the same sequence
		for (j = i; j < map->num_textures; j++)
		{
			if (map->textures[j].name[0] != '+')
				goto qst_scan;
			if (StrCompare(map->textures[j].name + 2, t->name + 2))
				goto qst_scan;

			c = map->textures[j].name[1];
			if ('a' <= c <= 'z')
				c -= 'a' - 'A';

			if ('0' <= c <= '9')
			{
				num = c - '0';
				anims[num] = j;
				if (num + 1 > max)
					max = num + 1;
			}
			else if ('A' <= c <= 'J')
			{
				num = c - 'A';
				alts[num] = j;
				if (num + 1 > altmax)
					altmax = num + 1;
			}

qst_scan:
		}

		//a hole would leave the ring pointing at nothing; leave it unanimated
		for (j = 0; j < max; j++)
		{
			if (anims[j] < 0)
			{
				max = 0;
				break;
			}
		}

		for (j = 0; j < altmax; j++)
		{
			if (alts[j] < 0)
			{
				altmax = 0;
				break;
			}
		}

		for (j = 0; j < max; j++)
		{
			map->textures[anims[j]].anim_total = max * HLANIM_CYCLE;
			map->textures[anims[j]].anim_min   = j * HLANIM_CYCLE;
			map->textures[anims[j]].anim_max   = (j + 1) * HLANIM_CYCLE;
			map->textures[anims[j]].anim_next  = anims[(j + 1) % max];
			if (altmax)
				map->textures[anims[j]].alt_anims = alts[0];
		}

		for (j = 0; j < altmax; j++)
		{
			map->textures[alts[j]].anim_total = altmax * HLANIM_CYCLE;
			map->textures[alts[j]].anim_min   = j * HLANIM_CYCLE;
			map->textures[alts[j]].anim_max   = (j + 1) * HLANIM_CYCLE;
			map->textures[alts[j]].anim_next  = alts[(j + 1) % altmax];
			if (max)
				map->textures[alts[j]].alt_anims = anims[0];
		}

qst_next:
	}
}

U0 HLBSPTextureFlags(CHLTexture *t)
{//surface render intent lives entirely in the texture name. There is no
 //per-texture flags field in HL
	t->is_sky = !StrNICompare(t->name, "sky", 3);

	//'*' is quake's turb mark, '!' is HL's. Both wave; R_DrawSurface treats
	//them identically
	t->is_turb = ToBool(t->name[0] == '*' || t->name[0] == '!');

	t->is_masked = ToBool(t->name[0] == '{');
	t->is_light  = ToBool(t->name[0] == '~');
	t->is_scroll = !StrNICompare(t->name, "scroll", 6);
}

Bool HLBSPDecodeMiptex(CHLTexture *t, U8 *p, I64 avail)
{//one miptex body: 16 byte name, w, h, four mip offsets relative to p, then
 //the mip levels, then u16 colour count and 3*count palette bytes
 //
 //returns FALSE when the body is external: HL writes the header with all four
 //offsets zero and leaves the texels in a wad
	I64 mip_ofs[4];
	I64 pal_ofs;
	I64 colors;
	I64 j;

	t->palette = NULL;

	if (avail < 40)
		return FALSE;

	HLRdName(p, t->name, 16);
	t->width  = HLRdU32(p + 16);
	t->height = HLRdU32(p + 20);

	HLBSPTextureFlags(t);

	for (j = 0; j < 4; j++)
	{
		mip_ofs[j]   = HLRdU32(p + 24 + j * 4);
		t->texels[j] = NULL;
	}

	if (t->width <= 0 || t->height <= 0)
		return FALSE;

	//offsets[0] == 0 marks an external texture. An embedded one starts its
	//first mip at 40, immediately after the header
	if (!mip_ofs[0])
		return FALSE;

	for (j = 0; j < 4; j++)
	{
		I64 level_bytes = (t->width >> j) * (t->height >> j);

		if (mip_ofs[j] > 0 && mip_ofs[j] + level_bytes <= avail)
			t->texels[j] = p + mip_ofs[j];
	}

	//palette sits past the smallest mip. Derived from offsets[3] rather than by
	//summing the levels: a hand-built wad can pad between them
	pal_ofs = mip_ofs[3] + (t->width >> 3) * (t->height >> 3);

	if (pal_ofs + 2 <= avail)
	{
		colors = HLRdU16(p + pal_ofs);

		//always 256; any other count means the offset is wrong
		if (colors == 256 && pal_ofs + 2 + 768 <= avail)
			t->palette = p + pal_ofs + 2;
	}

	return ToBool(t->texels[0] != NULL);
}

//a wad that failed to mount misses every name in it, so the log is capped. The
//count resets per map in HLBSPLoadTextures; globals are not zeroed
#define HLBSP_MISS_LOG_MAX	8

I64 hl_tex_miss_reports = 0;

U0 HLBSPReportMissing(U8 *name)
{//name the texture on the console. One line each, then a single line saying
 //the rest are suppressed
	if (hl_tex_miss_reports >= HLBSP_MISS_LOG_MAX)
		return;

	hl_tex_miss_reports++;

	if (hl_tex_miss_reports == HLBSP_MISS_LOG_MAX)
		"HLBSP: further missing textures not listed\n";
	else
		"HLBSP: texture %s is in no mounted wad\n", name;
}

U0 HLBSPMissingTexture(CHLTexture *t)
{//point an unresolved slot at the shared checker
 //
 //leaving the slot empty makes the surface vanish and reusing another loaded
 //texture makes it look mapped wrong. The checker reads as neither
	U8	*b;
	I64	 ofs = 0;
	I64	 dim = HLWAD3_MISS_DIM;
	I64	 j;

	b = HLWad3MissingTex();
	if (!b)
		return;

	t->width  = HLWAD3_MISS_DIM;
	t->height = HLWAD3_MISS_DIM;

	for (j = 0; j < 4; j++)
	{
		t->texels[j] = b + ofs;
		ofs += dim * dim;
		dim >>= 1;
	}

	t->palette = b + HLWAD3_MISS_PIX;
	t->clamp   = FALSE;

	//the checker is a 64x64 wall patch. is_sky would send it to the gfx/env
	//projection, which reads no miptex at all, and is_turb would warp it
	t->is_sky  = FALSE;
	t->is_turb = FALSE;
}

U0 HLBSPLoadTextures(CHLMap *map, U8 *lump, I64 lump_len)
{//miptex lump: count, offset table (-1 missing), then 40 byte headers. In HL
 //most headers carry no texels and name a wad entry instead
	CHLTexture	*t;
	U8			*p;
	U8			*ext;
	I64			 ext_size;
	I64			 count;
	I64			 ofs;
	I64			 missing = 0;
	I64			 external = 0;
	I64			 i;
	I64			 j;

	map->textures     = NULL;
	map->num_textures = 0;

	hl_tex_miss_reports = 0;

	if (lump_len < 4)
		return;

	count = HLRdI32(lump);
	if (count <= 0 || 4 + count * 4 > lump_len)
		return;

	map->textures     = CAlloc(count * sizeof(CHLTexture));
	map->num_textures = count;

	for (i = 0; i < count; i++)
	{
		t   = &map->textures[i];
		ofs = HLRdI32(lump + 4 + i * 4);

		t->clamp   = FALSE;		//world textures tile
		t->palette = NULL;

		t->anim_total = 0;
		t->anim_min   = 0;
		t->anim_max   = 0;
		t->anim_next  = i;
		t->alt_anims  = -1;

		for (j = 0; j < 4; j++)
			t->texels[j] = NULL;

		//-1: the map names no texture in this slot
		if (ofs < 0 || ofs + 40 > lump_len)
		{
			t->name[0] = 0;
			t->width   = 0;
			t->height  = 0;
			goto qlt_next;
		}

		p = lump + ofs;

		if (HLBSPDecodeMiptex(t, p, lump_len - ofs))
			goto qlt_next;

		//no embedded body. The header still holds name and size, so resolve
		//against the mounted wads
		if (!t->name[0])
		{
			//a header with neither texels nor a name: nothing to report
			missing++;
			HLBSPMissingTexture(t);
			goto qlt_next;
		}

		ext = HLWad3FindMip(t->name, &ext_size);

		if (ext && HLBSPDecodeMiptex(t, ext, ext_size))
			external++;
		else
		{
			//a partial decode may have left stale texels, so the checker is
			//applied after the attempt, not before
			missing++;
			HLBSPReportMissing(t->name);
			HLBSPMissingTexture(t);
		}

qlt_next:
	}

	if (external)
		"HLBSP: %d textures from wads\n", external;

	if (missing)
		"HLBSP: %d textures could not be resolved\n", missing;

	HLBSPSequenceTextures(map);
}

U0 HLBSPMakeHull0(CHLMap *map)
{//Mod_MakeHull0 - point sized clipping hull off the render tree
 //
 //hulls 1 and 2 are in the file, expanded for man and monster boxes. Hull 0 is
 //not: point traces (rockets, gibs, spikes) use the render tree converted to
 //clipnode form, so one walker handles every hull
 //
 //one clipnode per render node, same plane, except a child pointing at a leaf
 //becomes that leaf's contents. The clipnode walker signals solidity through
 //negative children, not by following a leaf index
 //
 //appended to the clipnode array, so only child indices need rebasing
	CHLClipNode	*grown;
	CHLClipNode	*cn;
	I64			 base = map->num_clipnodes;
	I64			 total;
	I64			 child;
	I64			 leaf;
	I64			 i;
	I64			 j;

	if (map->num_nodes < 1)
		return;

	total = base + map->num_nodes;
	grown = CAlloc(total * sizeof(CHLClipNode));

	if (base > 0)
		MemCopy(grown, map->clipnodes, base * sizeof(CHLClipNode));

	for (i = 0; i < map->num_nodes; i++)
	{
		cn            = &grown[base + i];
		cn->plane_num = map->nodes[i].plane_num;

		for (j = 0; j < 2; j++)
		{
			child = map->nodes[i].children[j];

			if (child < 0)
			{
				//~(leaf index) in the render tree, emit the contents
				leaf = -1 - child;

				if (leaf >= 0 && leaf < map->num_leafs)
					cn->children[j] = map->leafs[leaf].contents;
				else
					cn->children[j] = HLCONTENTS_SOLID;
			}
			else
				cn->children[j] = base + child;
		}
	}

	if (map->clipnodes)
		Free(map->clipnodes);

	map->clipnodes     = grown;
	map->num_clipnodes = total;

	//rebase each model's hull 0 root into the appended range
	for (i = 0; i < map->num_models; i++)
	{
		if (map->models[i].head_node[0] >= 0)
			map->models[i].hull0_head = base + map->models[i].head_node[0];
		else
			map->models[i].hull0_head = -1;
	}
}

CHLMap *HLBSPLoad(U8 *name)
{//pull a map out of the mounted paks and decode every lump
	CHLMap		*map;
	CHLFace		*f;
	CHLLeaf		*l;
	CHLNode		*n;
	CHLTexInfo	*ti;
	CHLModel		*m;
	U8			*d;
	U8			*rec;
	I64			 size = 0;
	I64			 lump_offset[HLLUMP_COUNT];
	I64			 lump_length[HLLUMP_COUNT];
	I64			 i;
	I64			 j;
	I64			 c;

	d = HLFileLoad(name, &size);
	if (!d)
	{
		"HLBSP: %s not found\n", name;
		return NULL;
	}

	if (size < 4 + HLLUMP_COUNT * 8)
	{
		"HLBSP: %s is too small to be a map\n", name;
		Free(d);
		return NULL;
	}

	if (HLRdI32(d) != HLBSP_VERSION)
	{
		"HLBSP: %s is version %d, expected %d\n", name, HLRdI32(d), HLBSP_VERSION;
		Free(d);
		return NULL;
	}

	for (i = 0; i < HLLUMP_COUNT; i++)
	{
		lump_offset[i] = HLRdI32(d + 4 + i * 8);
		lump_length[i] = HLRdI32(d + 8 + i * 8);

		if (lump_offset[i] < 0 || lump_length[i] < 0 ||
			lump_offset[i] + lump_length[i] > size)
		{
			"HLBSP: %s lump %d is out of range\n", name, i;
			Free(d);
			return NULL;
		}
	}

	map           = CAlloc(sizeof(CHLMap));
	map->raw      = d;
	map->raw_size = size;

	//--- planes: normal[3], dist, type ---
	c = lump_length[HLLUMP_PLANES] / 20;
	map->num_planes = c;
	map->planes     = CAlloc(c * sizeof(CHLPlane));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_PLANES] + i * 20;
		HLRdVec(rec, map->planes[i].normal);
		map->planes[i].dist = HLRdF32(rec + 12);
		map->planes[i].type = HLRdI32(rec + 16);
	}

	//--- vertices ---
	c = lump_length[HLLUMP_VERTICES] / 12;
	map->num_vertices = c;
	map->vertices     = CAlloc(c * sizeof(CHLVertex));
	for (i = 0; i < c; i++)
		HLRdVec(d + lump_offset[HLLUMP_VERTICES] + i * 12, map->vertices[i].pt);

	//--- edges: pair of unsigned vertex indices ---
	c = lump_length[HLLUMP_EDGES] / 4;
	map->num_edges = c;
	map->edges     = CAlloc(c * sizeof(CHLEdge));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_EDGES] + i * 4;
		map->edges[i].v[0] = HLRdU16(rec);
		map->edges[i].v[1] = HLRdU16(rec + 2);
	}

	//--- surfedges: signed edge references ---
	c = lump_length[HLLUMP_SURFEDGES] / 4;
	map->num_surfedges = c;
	map->surfedges     = CAlloc(c * sizeof(I64));
	for (i = 0; i < c; i++)
		map->surfedges[i] = HLRdI32(d + lump_offset[HLLUMP_SURFEDGES] + i * 4);

	//--- texinfo: two 4 component axes, then miptex + flags ---
	c = lump_length[HLLUMP_TEXINFO] / 40;
	map->num_texinfo = c;
	map->texinfo     = CAlloc(c * sizeof(CHLTexInfo));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_TEXINFO] + i * 40;
		ti  = &map->texinfo[i];
		for (j = 0; j < 8; j++)
			ti->vecs[j] = HLRdF32(rec + j * 4);
		ti->miptex = HLRdI32(rec + 32);
		ti->flags  = HLRdI32(rec + 36);
	}

	//--- nodes: negative children are ~(leaf index) ---
	c = lump_length[HLLUMP_NODES] / 24;
	map->num_nodes = c;
	map->nodes     = CAlloc(c * sizeof(CHLNode));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_NODES] + i * 24;
		n   = &map->nodes[i];
		n->plane_num   = HLRdI32(rec);
		n->children[0] = HLRdI16(rec + 4);
		n->children[1] = HLRdI16(rec + 6);
		for (j = 0; j < 3; j++)
		{
			n->mins[j] = ToF64(HLRdI16(rec + 8 + j * 2));
			n->maxs[j] = ToF64(HLRdI16(rec + 14 + j * 2));
		}
		n->first_face = HLRdU16(rec + 20);
		n->num_faces  = HLRdU16(rec + 22);
	}

	//--- clipnodes: plane index plus two shorts ---
	c = lump_length[HLLUMP_CLIPNODES] / 8;
	map->num_clipnodes = c;
	map->clipnodes     = CAlloc(c * sizeof(CHLClipNode));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_CLIPNODES] + i * 8;
		map->clipnodes[i].plane_num   = HLRdI32(rec);
		map->clipnodes[i].children[0] = HLRdI16(rec + 4);
		map->clipnodes[i].children[1] = HLRdI16(rec + 6);
	}

	//--- leafs ---
	c = lump_length[HLLUMP_LEAFS] / 28;
	map->num_leafs = c;
	map->leafs     = CAlloc(c * sizeof(CHLLeaf));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_LEAFS] + i * 28;
		l   = &map->leafs[i];
		l->contents   = HLRdI32(rec);
		l->vis_offset = HLRdI32(rec + 4);
		for (j = 0; j < 3; j++)
		{
			l->mins[j] = ToF64(HLRdI16(rec + 8 + j * 2));
			l->maxs[j] = ToF64(HLRdI16(rec + 14 + j * 2));
		}
		l->first_marksurface = HLRdU16(rec + 20);
		l->num_marksurfaces  = HLRdU16(rec + 22);
		for (j = 0; j < 4; j++)
			l->ambient[j] = rec[24 + j];
	}

	//--- marksurfaces: leaf to face indirection ---
	c = lump_length[HLLUMP_MARKSURFACES] / 2;
	map->num_marksurfaces = c;
	map->marksurfaces     = CAlloc(c * sizeof(I64));
	for (i = 0; i < c; i++)
		map->marksurfaces[i] = HLRdU16(d + lump_offset[HLLUMP_MARKSURFACES] + i * 2);

	//--- faces ---
	c = lump_length[HLLUMP_FACES] / 20;
	map->num_faces = c;
	map->faces     = CAlloc(c * sizeof(CHLFace));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_FACES] + i * 20;
		f   = &map->faces[i];
		f->plane_num  = HLRdU16(rec);
		f->side       = HLRdU16(rec + 2);
		f->first_edge = HLRdI32(rec + 4);
		f->num_edges  = HLRdU16(rec + 8);
		f->tex_info   = HLRdU16(rec + 10);
		for (j = 0; j < 4; j++)
			f->styles[j] = rec[12 + j];
		f->light_offset = HLRdI32(rec + 16);

		//frame 0 is a valid frame number, so start below it
		f->dlight_frame = -1;
		f->dlight_bits  = 0;
	}

	//--- models: 0 is worldspawn, the rest brush entities ---
	c = lump_length[HLLUMP_MODELS] / 64;
	map->num_models = c;
	map->models     = CAlloc(c * sizeof(CHLModel));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[HLLUMP_MODELS] + i * 64;
		m   = &map->models[i];
		HLRdVec(rec, m->mins);
		HLRdVec(rec + 12, m->maxs);
		HLRdVec(rec + 24, m->origin);
		for (j = 0; j < 4; j++)
			m->head_node[j] = HLRdI32(rec + 36 + j * 4);
		m->vis_leafs  = HLRdI32(rec + 52);
		m->first_face = HLRdI32(rec + 56);
		m->num_faces  = HLRdI32(rec + 60);
	}

	//--- borrowed byte lumps ---
	map->visdata       = d + lump_offset[HLLUMP_VISIBILITY];
	map->visdata_size  = lump_length[HLLUMP_VISIBILITY];
	map->lightdata     = d + lump_offset[HLLUMP_LIGHTING];
	map->lightdata_size = lump_length[HLLUMP_LIGHTING];
	map->entities      = d + lump_offset[HLLUMP_ENTITIES];
	map->entities_size = lump_length[HLLUMP_ENTITIES];

	//worldspawn's "wad" key names the archives holding this map's textures.
	//Must run before the miptex lump is walked; most of its headers are names
	//waiting to be resolved
	HLWad3MountForMap(map->entities, map->entities_size);

	HLBSPLoadTextures(map, d + lump_offset[HLLUMP_MIPTEX], lump_length[HLLUMP_MIPTEX]);

	//needs vertices, edges, surfedges and texinfo in place
	for (i = 0; i < map->num_faces; i++)
		HLBSPCalcSurfaceExtents(map, &map->faces[i]);

	//reallocates the clipnode array; no clipnode pointer survives this call
	HLBSPMakeHull0(map);

	return map;
}

U0 HLBSPReport(CHLMap *map)
{//lump census
	if (!map)
	{
		"HLBSP: no map\n";
		return;
	}

	"  planes       %6d\n", map->num_planes;
	"  vertices     %6d\n", map->num_vertices;
	"  edges        %6d\n", map->num_edges;
	"  surfedges    %6d\n", map->num_surfedges;
	"  nodes        %6d\n", map->num_nodes;
	"  leafs        %6d\n", map->num_leafs;
	"  texinfo      %6d\n", map->num_texinfo;
	"  faces        %6d\n", map->num_faces;
	"  marksurfaces %6d\n", map->num_marksurfaces;
	"  models       %6d\n", map->num_models;
	"  textures     %6d\n", map->num_textures;
	"  visdata      %6d bytes\n", map->visdata_size;
	"  lightdata    %6d bytes\n", map->lightdata_size;
	"  entities     %6d bytes\n", map->entities_size;
}
