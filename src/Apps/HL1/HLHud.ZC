// HLHud.ZC - the HUD, driven by sprites/hud.txt
//
// HL does not hardcode its HUD art. sprites/hud.txt is a table of
//
//     name  resolution  spritefile  x  y  w  h
//
// where spritefile carries neither the "sprites/" prefix nor the ".spr"
// extension, and the rect is a sub-rectangle of that sheet. One row per
// element per supported resolution, so the same name appears three or four
// times and only the row matching the canvas is wanted.
//
// The sheets are SPR v2 with texFormat ADDITIVE, which is why they are
// authored light-on-black: drawn opaque every number gets a black box around
// it. HLSprDrawRect does the blend.
//
// Nothing here reads player state directly - health and battery are passed in,
// and the ammo counts arrive through the mirror globals below because
// HLWeapon.ZC compiles after this file. See hl_hud_weapon_hook.
//
// hud.txt has no crosshair element: `cross` is the health cross beside the
// number, and the aiming reticle is per weapon in sprites/weapon_<name>.txt as
// a cell of a shared crosshairs sheet. HLWeapon.ZC draws it, being the only
// thing that knows which weapon is up.

#define HLHUD_MAX_ENTRIES	160

//sheet budget. the 640 row set shares nine sheets (640hud1..640hud9) plus the
//pain and train sheets; the weapon layer adds the crosshairs sheet. the
//1280/2560 sets are one .spr per element and want closer to ninety, so 32
//covers 640 plus the weapon art and truncates 2560.
#define HLHUD_MAX_SHEETS	32
#define HLHUD_NAME_MAX		32
#define HLHUD_SHEET_MAX		32

//HL's own HUD colours, from cl_dll. yellowish normally, red when whatever it
//shows is dangerously low
#define HLHUD_R				255
#define HLHUD_G				160
#define HLHUD_B				0

#define HLHUD_LOW_R			255
#define HLHUD_LOW_G			16
#define HLHUD_LOW_B			16

class CHLHudEntry
{
	U8	name[HLHUD_NAME_MAX];
	I64	sheet;				//index into hl_hud_sheet
	I64	x;
	I64	y;
	I64	w;
	I64	h;
};

CHLHudEntry	hl_hud_entry[HLHUD_MAX_ENTRIES];
I64			hl_hud_count = 0;

U8			hl_hud_sheet_name[HLHUD_MAX_SHEETS * HLHUD_SHEET_MAX];
CHLSpr		*hl_hud_sheet[HLHUD_MAX_SHEETS];
I64			hl_hud_sheet_count = 0;

Bool		hl_hud_ready = FALSE;

//which of hud.txt's four row sets is loaded. the weapon layer needs it: the
//crosshairs sheet is named per resolution and its cells are sized to match
I64			hl_hud_res = 640;

//--- what the weapon layer pushes here --------------------------------------
//
// HLWeapon.ZC compiles after this file, so nothing here can call into it. The
// counts are mirrored instead, refreshed once a frame by the hook below - the
// same shape as cl_dll, where CHudAmmo keeps its own copy of what the server
// last told it rather than reading the weapon.
//
// -1 means no readout, for a melee weapon and an empty hand alike: CHudAmmo
// hides the number rather than printing a zero.

I64			hl_hud_ammo    = -1;	//rounds in the active clip
I64			hl_hud_reserve = -1;	//rounds left in the pool behind it

//Per-frame hook, installed by HLWeapon.ZC. HL1.ZC owns the frame loop and the
//weapon layer cannot reach it, so this is where the weapon tick, the view
//model, the crosshair and the selection UI are driven from. Same backward-call
//idiom as hl_pr_builtin_call in HLProgs.ZC.
U0 (*hl_hud_weapon_hook)(CHLCanvas *c) = NULL;

U0 HLHudInit()
{//globals aren't zeroed. HLHudFree below walks this table calling HLSprFree on
 //every non-NULL slot, and on the first call every slot is garbage - a GP fault
 //inside HLSprFree before a frame is drawn
	I64 i;

	for (i = 0; i < HLHUD_MAX_SHEETS; i++)
	{
		hl_hud_sheet[i] = NULL;
		hl_hud_sheet_name[i * HLHUD_SHEET_MAX] = 0;
	}

	hl_hud_sheet_count = 0;
	hl_hud_count       = 0;
	hl_hud_ready       = FALSE;
	hl_hud_res         = 640;

	hl_hud_ammo    = -1;
	hl_hud_reserve = -1;

	//a declaration initialiser on a global is not reliable here and a garbage
	//function pointer is a call into nothing, so it is cleared explicitly.
	//
	//consequence: HLHudInit must be called once only. HLWeapon.ZC installs
	//itself into this pointer with a top-level statement after this one has
	//run, and a later HLHudInit would silently unhook every weapon.
	hl_hud_weapon_hook = NULL;
}

//Top-level statement: runs when this file is compiled, so the table is safe
//before anything can reach HLHudFree. Not deferred to an init function as
//HLPakInit is - HLHudLoad calls HLHudFree first thing, and the first HLHudLoad
//can precede any controlled init pass.
HLHudInit;

U0 HLHudFree()
{
	I64 i;

	for (i = 0; i < HLHUD_MAX_SHEETS; i++)
	{
		if (hl_hud_sheet[i])
			HLSprFree(hl_hud_sheet[i]);

		hl_hud_sheet[i] = NULL;
		hl_hud_sheet_name[i * HLHUD_SHEET_MAX] = 0;
	}

	hl_hud_sheet_count = 0;
	hl_hud_count       = 0;
	hl_hud_ready       = FALSE;
}

I64 HLHudSheet(U8 *name)
{//load a sheet once and hand back its slot, -1 if it will not load
	U8	path[96];
	I64	i;

	for (i = 0; i < hl_hud_sheet_count; i++)
	{
		if (!StrICompare(&hl_hud_sheet_name[i * HLHUD_SHEET_MAX], name))
			return i;
	}

	if (hl_hud_sheet_count >= HLHUD_MAX_SHEETS)
		return -1;

	//the table stores neither the directory nor the extension
	StrPrint(path, "sprites/%s.spr", name);

	hl_hud_sheet[hl_hud_sheet_count] = HLSprLoad(path);

	if (!hl_hud_sheet[hl_hud_sheet_count])
		return -1;

	HLRdName(name, &hl_hud_sheet_name[hl_hud_sheet_count * HLHUD_SHEET_MAX],
		HLHUD_SHEET_MAX);

	hl_hud_sheet_count++;

	return hl_hud_sheet_count - 1;
}

I64 HLHudFind(U8 *name)
{
	I64 i;

	for (i = 0; i < hl_hud_count; i++)
	{
		if (!StrICompare(hl_hud_entry[i].name, name))
			return i;
	}

	return -1;
}

Bool HLHudIsSpace(I64 c)
{
	return ToBool(c == ' ' || c == '\t' || c == '\r');
}

#define HLHUD_TOKENS		7

I64 HLHudSplit(U8 *line, U8 *tok)
{//split one line into at most HLHUD_TOKENS fields of HLHUD_SHEET_MAX bytes.
 //tabs and spaces both separate, and hud.txt uses them interchangeably
	I64 i = 0;
	I64 n = 0;
	I64 k;

	while (line[i] && n < HLHUD_TOKENS)
	{
		while (line[i] && HLHudIsSpace(line[i]))
			i++;

		if (!line[i])
			break;

		k = 0;
		while (line[i] && !HLHudIsSpace(line[i]) &&
			k < HLHUD_SHEET_MAX - 1)
		{
			tok[n * HLHUD_SHEET_MAX + k] = line[i];
			k++;
			i++;
		}

		tok[n * HLHUD_SHEET_MAX + k] = 0;
		n++;

		//an over-long field would otherwise split into two
		while (line[i] && !HLHudIsSpace(line[i]))
			i++;
	}

	return n;
}

Bool HLHudLoad(I64 canvas_width)
{//parse sprites/hud.txt, keeping only the rows for the best resolution
 //
 //hud.txt lists 320, 640, 1280 and 2560 sets. the largest that fits the canvas
 //wins, so the art is never upscaled
	U8	*d;
	U8	 line[192];
	U8	 tok[HLHUD_TOKENS * HLHUD_SHEET_MAX];
	U8	 want[8];
	I64	 size = 0;
	I64	 pos  = 0;
	I64	 len;
	I64	 res;
	I64	 sheet;
	I64	 slot;

	HLHudFree;

	if (canvas_width >= 2560)
		res = 2560;
	else if (canvas_width >= 1280)
		res = 1280;
	else if (canvas_width >= 640)
		res = 640;
	else
		res = 320;

	StrPrint(want, "%d", res);

	//published, so the weapon layer can pick the matching crosshairs sheet
	hl_hud_res = res;

	d = HLFileData("sprites/hud.txt", &size);
	if (!d || size < 8)
	{
		"HLHud: sprites/hud.txt missing\n";
		return FALSE;
	}

	while (pos < size && hl_hud_count < HLHUD_MAX_ENTRIES)
	{
		//one line, NUL terminated, newline consumed
		len = 0;
		while (pos < size && d[pos] != '\n' && len < 191)
		{
			line[len] = d[pos];
			len++;
			pos++;
		}
		line[len] = 0;

		while (pos < size && d[pos] != '\n')
			pos++;
		pos++;

		//the file opens with a bare count, and is full of // banners
		if (!len || line[0] == '/')
			goto qhl_next;

		//name res sheet x y w h. anything shorter is not a row
		if (HLHudSplit(line, tok) != HLHUD_TOKENS)
			goto qhl_next;

		if (StrCompare(&tok[1 * HLHUD_SHEET_MAX], want))
			goto qhl_next;

		sheet = HLHudSheet(&tok[2 * HLHUD_SHEET_MAX]);
		if (sheet < 0)
			goto qhl_next;

		slot = hl_hud_count;

		HLRdName(&tok[0], hl_hud_entry[slot].name, HLHUD_NAME_MAX);

		hl_hud_entry[slot].sheet = sheet;
		hl_hud_entry[slot].x = ToI64(HLAtoF(&tok[3 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].y = ToI64(HLAtoF(&tok[4 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].w = ToI64(HLAtoF(&tok[5 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].h = ToI64(HLAtoF(&tok[6 * HLHUD_SHEET_MAX]));

		hl_hud_count++;

qhl_next:
	}

	Free(d);

	"HLHud: %d elements at %d, %d sheets\n", hl_hud_count, res,
		hl_hud_sheet_count;

	hl_hud_ready = ToBool(hl_hud_count > 0);

	return hl_hud_ready;
}

U0 HLHudDrawElement(CHLCanvas *c, I64 idx, I64 x, I64 y,
	I64 r, I64 g, I64 b)
{
	CHLHudEntry *e;

	if (idx < 0 || idx >= hl_hud_count)
		return;

	e = &hl_hud_entry[idx];

	if (e->sheet < 0 || e->sheet >= hl_hud_sheet_count)
		return;

	HLSprDrawRect(c, hl_hud_sheet[e->sheet], 0, x, y,
		e->x, e->y, e->w, e->h, r, g, b);
}

I64 HLHudDrawNumber(CHLCanvas *c, I64 x, I64 y, I64 value, I64 min_digits,
	I64 r, I64 g, I64 b)
{//CHud::DrawHudNumber, hud_redraw.cpp. left to right, returns the width drawn
 //
 //DHN_3DIGITS pads the field to min_digits by ADVANCING x over the missing
 //leading places without emitting a glyph - the commented-out SPR_DrawAdditive
 //calls in the SDK are the leading blanks. Drawing a zero there instead prints
 //"007" where HL prints "  7".
 //
 //DHN_DRAWZERO is always set on the four readouts this file draws, so a value
 //of zero still emits one "0" in the last place.
	U8	 name[HLHUD_NAME_MAX];
	I64	 place = 1;			//divisor of the most significant place emitted
	I64	 digits = 1;
	I64	 blanks;
	I64	 d;
	I64	 idx;
	I64	 unit = 0;			//AmmoWidth, the width of one digit cell
	I64	 w = 0;
	I64	 v = value;

	if (v < 0)
		v = 0;

	while (v / place >= 10)
	{
		place *= 10;
		digits++;
	}

	idx = HLHudFind("number_0");

	if (idx >= 0)
		unit = hl_hud_entry[idx].w;

	//the leading places the number does not reach
	blanks = min_digits - digits;

	if (blanks > 0)
		w = blanks * unit;

	while (place > 0)
	{
		d = (v / place) % 10;

		StrPrint(name, "number_%d", d);
		idx = HLHudFind(name);

		if (idx >= 0)
		{
			HLHudDrawElement(c, idx, x + w, y, r, g, b);
			w += hl_hud_entry[idx].w;
		}

		place /= 10;
	}

	return w;
}

U0 HLHudDraw(CHLCanvas *c, I64 health, I64 battery, I64 ammo,
	Bool has_suit)
{//the bottom row: health at the left, the suit charge beside it, ammo on the
 //right. Three separate CHudBase elements in the SDK, each anchored on its own
 //terms - they do NOT flow out of one another:
 //
 //  CHudHealth::Draw   cross at x = CrossWidth/2, number at CrossWidth + w/2
 //  CHudBattery::Draw  suit at x = 3 * suit_width, number at that + suit_width
 //  CHudAmmo::Draw     clip at x = ScreenWidth - 8*AmmoWidth - iIconWidth
 //
 //and all three share the vertical anchor
 //
 //  y  = ScreenHeight - m_iFontHeight - m_iFontHeight/2
 //  y += m_iFontHeight * 0.2      (the numbers only; the icons sit on y)
 //
 //m_iFontHeight is CHud::Init's number_0 height, not a font metric - see
 //hud.cpp. The sub-rect out of hud.txt is already in the chosen sheet's own
 //pixels and the sheet is picked to match the canvas, so nothing scales it.
	CHLHudEntry *e;
	I64 idx;
	I64 x;
	I64 fh      = 24;		//gHUD.m_iFontHeight
	I64 num_w   = 20;		//AmmoWidth / HealthWidth
	I64 base_y;				//the icon row
	I64 num_y;				//the digit row, nudged down by a fifth of a digit
	I64 cross_w = 0;
	I64 suit_w  = 0;
	I64 suit_h  = 0;
	I64 top;
	I64 reserve;
	I64 r, g, b;

	if (!c)
		return;

	//before the hl_hud_ready gate and before anything is drawn: the weapon
	//layer's tick must run even with no hud.txt on disk, and the counts it
	//pushes into hl_hud_ammo are read further down this same call
	if (hl_hud_weapon_hook)
		hl_hud_weapon_hook(c);

	if (!hl_hud_ready)
		return;

	idx = HLHudFind("number_0");
	if (idx >= 0)
	{
		fh    = hl_hud_entry[idx].h;
		num_w = hl_hud_entry[idx].w;
	}

	base_y = c->height - fh - fh / 2;
	num_y  = base_y + ToI64(ToF64(fh) * 0.2);

	//--- health, CHudHealth::Draw ---
	//
	//GetPainColor: yellowish above a quarter health, flat red at or below it
	r = HLHUD_R;
	g = HLHUD_G;
	b = HLHUD_B;

	if (health <= 25)
	{
		r = HLHUD_LOW_R;
		g = HLHUD_LOW_G;
		b = HLHUD_LOW_B;
	}

	idx = HLHudFind("cross");
	if (idx >= 0)
	{
		cross_w = hl_hud_entry[idx].w;

		//the cross sits on base_y, half its own width in from the edge
		HLHudDrawElement(c, idx, cross_w / 2, base_y, r, g, b);
	}

	x  = cross_w + num_w / 2;
	x += HLHudDrawNumber(c, x, num_y, health, 3, r, g, b);

	//FillRGBA(x, y, HealthWidth/10, m_iFontHeight). the divider element is
	//exactly HealthWidth/10 wide in all four row sets, so it stands in for the
	//fill; it is taller than a digit, so it is centred on the digit row
	x += num_w / 2;

	idx = HLHudFind("divider");
	if (idx >= 0)
		HLHudDrawElement(c, idx, x,
			num_y + (fh - hl_hud_entry[idx].h) / 2,
			HLHUD_R, HLHUD_G, HLHUD_B);

	//--- suit charge, CHudBattery::Draw ---
	//no suit, no battery readout, as HL hides it until the suit is picked up
	if (has_suit)
	{
		r = HLHUD_R;
		g = HLHUD_G;
		b = HLHUD_B;

		idx = HLHudFind("suit_empty");

		if (idx >= 0)
		{
			suit_w = hl_hud_entry[idx].w;
			suit_h = hl_hud_entry[idx].h;
		}

		//"this used to just be ScreenWidth/5 but that caused real issues at
		//higher resolutions. Instead, base it on the width of this sprite."
		x = 3 * suit_w;

		if (idx >= 0)
			HLHudDrawElement(c, idx, x, base_y - suit_h / 6, r, g, b);

		//suit_full is drawn over the empty one, cropped from the top by the
		//charge missing - the sub-rect walks down as the battery drains
		idx = HLHudFind("suit_full");

		if (idx >= 0 && battery > 0)
		{
			e = &hl_hud_entry[idx];

			top = ToI64(ToF64(e->h) * ToF64(100 - battery) * 0.01);

			if (top < 0)
				top = 0;
			if (top > e->h)
				top = e->h;

			if (e->sheet >= 0 && e->sheet < hl_hud_sheet_count)
				HLSprDrawRect(c, hl_hud_sheet[e->sheet], 0,
					x, base_y - suit_h / 6 + top,
					e->x, e->y + top, e->w, e->h - top, r, g, b);
		}

		x += suit_w;

		HLHudDrawNumber(c, x, num_y, battery, 3, r, g, b);
	}

	//--- ammo, right aligned ---
	//
	//HL1.ZC has no weapon state to hand over - HLHudDrawFrame passes -1 - so the
	//count comes from the mirror the weapon layer refreshed at the top of this
	//function. an explicit argument still wins, for the demo and thin client
	//paths that do know what the host is holding.
	if (ammo < 0)
		ammo = hl_hud_ammo;

	reserve = hl_hud_reserve;

	if (ammo >= 0)
	{
		//CHudAmmo::Draw is RGB_YELLOWISH unconditionally - it dims on m_fFade
		//after a pickup and never reddens, so a dry weapon is not coloured here
		r = HLHUD_R;
		g = HLHUD_G;
		b = HLHUD_B;

		if (reserve >= 0)
		{
			//"room for the number and the '|' and the current ammo":
			//x = ScreenWidth - (8 * AmmoWidth) - iIconWidth. iIconWidth is the
			//weapon's own ammo icon out of weapon_<name>.txt, which is not drawn
			//here, so it contributes nothing to the offset
			x  = c->width - 8 * num_w;
			x += HLHudDrawNumber(c, x, num_y, ammo, 3, r, g, b);

			//FillRGBA(x, y, AmmoWidth/10, m_iFontHeight) between the two, at
			//x += AmmoWidth/2 and then x += iBarWidth + AmmoWidth/2
			x += num_w / 2;

			idx = HLHudFind("divider");
			if (idx >= 0)
			{
				HLHudDrawElement(c, idx, x,
					num_y + (fh - hl_hud_entry[idx].h) / 2, r, g, b);

				x += hl_hud_entry[idx].w;
			}
			else
				x += num_w / 10;

			x += num_w / 2;

			HLHudDrawNumber(c, x, num_y, reserve, 3, r, g, b);
		}
		else
		{
			//"SPR_Draw a bullets only line" - the clipless weapons, whose whole
			//readout is the pool
			x = c->width - 4 * num_w;

			HLHudDrawNumber(c, x, num_y, ammo, 3, r, g, b);
		}
	}
}

//--- CHudMessage ------------------------------------------------------------
//
// game_text and env_message. The centreprint path in HLSbar.ZC drops position,
// colour and timing; this is the real thing, from cl_dll/message.cpp.
//
// One message at a time. HL keeps MAX_TEXTMESSAGES 16 concurrent slots, but no
// shipped single player map stacks them, and the credit sequences that look
// stacked are a multi_manager firing one env_message after another.

#define HLMSG_MAX_TEXT		512

//pMessage->effect. 0 fades the whole string in and out, 1 adds a flickering
//second colour, 2 scans the string in one character at a time.
#define HLMSG_FX_FADE		0
#define HLMSG_FX_FLICKER		1
#define HLMSG_FX_WRITEOUT	2

U8	 hl_msg_text[HLMSG_MAX_TEXT];
Bool hl_msg_active		= FALSE;
F64	 hl_msg_start		= 0.0;		//wall clock, as the draw side has no game clock
I64	 hl_msg_effect		= HLMSG_FX_FADE;
F64	 hl_msg_x			= -1.0;		//-1 centres on that axis
F64	 hl_msg_y			= -1.0;
F64	 hl_msg_fadein		= 0.0;
F64	 hl_msg_fadeout		= 0.0;
F64	 hl_msg_hold			= 0.0;
F64	 hl_msg_fxtime		= 0.0;
I64	 hl_msg_r1			= 255;
I64	 hl_msg_g1			= 255;
I64	 hl_msg_b1			= 255;
I64	 hl_msg_r2			= 255;
I64	 hl_msg_g2			= 255;
I64	 hl_msg_b2			= 255;

U0 HLHudMsgInit()
{//Globals are not zeroed and declaration initialisers do not run.
	hl_msg_text[0]  = 0;
	hl_msg_active   = FALSE;
	hl_msg_start    = 0.0;
	hl_msg_effect   = HLMSG_FX_FADE;
	hl_msg_x        = -1.0;
	hl_msg_y        = -1.0;
	hl_msg_fadein   = 0.0;
	hl_msg_fadeout  = 0.0;
	hl_msg_hold     = 0.0;
	hl_msg_fxtime   = 0.0;
	hl_msg_r1       = 255;
	hl_msg_g1       = 255;
	hl_msg_b1       = 255;
	hl_msg_r2       = 255;
	hl_msg_g2       = 255;
	hl_msg_b2       = 255;
}

HLHudMsgInit;

U0 HLHudMsgClear()
{
	hl_msg_active  = FALSE;
	hl_msg_text[0] = 0;
}

U0 HLHudMsgShow(U8 *text, I64 effect, F64 x, F64 y,
	I64 r1, I64 g1, I64 b1, I64 r2, I64 g2, I64 b2,
	F64 fadein, F64 fadeout, F64 hold, F64 fxtime)
{//CHudMessage::MessageAdd. The entity layer calls this; it owns no timing.
	I64 i = 0;

	if (!text || !text[0])
		return;

	while (text[i] && i < HLMSG_MAX_TEXT - 1)
	{
		hl_msg_text[i] = text[i];
		i++;
	}

	hl_msg_text[i] = 0;

	hl_msg_effect  = effect;
	hl_msg_x       = x;
	hl_msg_y       = y;
	hl_msg_r1      = r1;
	hl_msg_g1      = g1;
	hl_msg_b1      = b1;
	hl_msg_r2      = r2;
	hl_msg_g2      = g2;
	hl_msg_b2      = b2;
	hl_msg_fadein  = fadein;
	hl_msg_fadeout = fadeout;
	hl_msg_hold    = hold;
	hl_msg_fxtime  = fxtime;

	if (hl_msg_hold <= 0.0)
		hl_msg_hold = 2.0;

	hl_msg_start  = tS;
	hl_msg_active = TRUE;
}

I64 HLHudMsgAxis(F64 v, I64 extent, I64 screen)
{//CHudMessage::XPosition / YPosition, which are the same rule on both axes.
 //
 //   -1        centred
 //   below 0   measured from the far edge
 //   0 to 1    a fraction of the screen from the near edge
	I64 p;

	if (v == -1.0)
		p = (screen - extent) / 2;
	else if (v < 0.0)
		p = ToI64((1.0 + v) * ToF64(screen)) - extent;
	else
		p = ToI64(v * ToF64(screen));

	if (p + extent > screen)
		p = screen - extent;
	if (p < 0)
		p = 0;

	return p;
}

//The measuring and drawing halves live in HL1.ZC: the font is in HLWad.ZC,
//which compiles after this file, so nothing here can size or draw a glyph.
