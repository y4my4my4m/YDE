// the HUD, driven by sprites/hud.txt
//
// sprites/hud.txt row: name resolution spritefile x y w h, where spritefile
// carries neither the "sprites/" prefix nor the ".spr" extension and the rect
// is a sub-rectangle of that sheet. one row per element per supported
// resolution.
//
// the sheets are SPR v2 with texFormat ADDITIVE, authored light-on-black;
// HLSprDrawRect does the blend.
//
// ammo counts arrive through the mirror globals below because HLWeapon.ZC
// compiles after this file - see hl_hud_weapon_hook.
//
// hud.txt has no crosshair element: `cross` is the health cross beside the
// number; the aiming reticle is per weapon in sprites/weapon_<name>.txt, a cell
// of a shared crosshairs sheet, and HLWeapon.ZC draws it.

#define HLHUD_MAX_ENTRIES	160

#define HLHUD_MAX_SHEETS	96
#define HLHUD_NAME_MAX		32
#define HLHUD_SHEET_MAX		32

#define HLHUD_R				255
#define HLHUD_G				160
#define HLHUD_B				0

#define HLHUD_LOW_R			255
#define HLHUD_LOW_G			16
#define HLHUD_LOW_B			16

class CHLHudEntry
{
	U8	name[HLHUD_NAME_MAX];
	I64	sheet;
	I64	x;
	I64	y;
	I64	w;
	I64	h;
};

CHLHudEntry	hl_hud_entry[HLHUD_MAX_ENTRIES];
I64			hl_hud_count = 0;

U8			hl_hud_sheet_name[HLHUD_MAX_SHEETS * HLHUD_SHEET_MAX];
CHLSpr		*hl_hud_sheet[HLHUD_MAX_SHEETS];
I64			hl_hud_sheet_count = 0;

Bool		hl_hud_ready = FALSE;

I64			hl_hud_res = 640;

I64			hl_hud_size = 0;
Bool		hl_hud_dirty = FALSE;

I64			hl_hud_gen = 0;


I64			hl_hud_ammo    = -1;
I64			hl_hud_reserve = -1;

I64			hl_hud_icon_sheet = -1;
I64			hl_hud_icon_x     = 0;
I64			hl_hud_icon_y     = 0;
I64			hl_hud_icon_w     = 0;
I64			hl_hud_icon_h     = 0;

Bool		hl_hud_ammo_low = FALSE;


Bool		hl_hud_flash_on  = FALSE;
F64			hl_hud_flash_bat = 1.0;		//m_flBat, 0..1


F64		hl_hud_geiger_range = 1000.0;
U0 (*hl_hud_geiger_hook)(F64 range, F64 dt) = NULL;


#define HLHUD_PAIN_UP		0
#define HLHUD_PAIN_RIGHT		1
#define HLHUD_PAIN_DOWN		2
#define HLHUD_PAIN_LEFT		3

CHLSpr		*hl_hud_pain      = NULL;
Bool		 hl_hud_pain_tried = FALSE;
F64			 hl_hud_pain_amt[4];

F64			 hl_hud_pain_src[3];
Bool		 hl_hud_pain_have = FALSE;

F64			 hl_hud_last_t = 0.0;

U0 (*hl_hud_weapon_hook)(CHLCanvas *c) = NULL;

U0 HLHudInit()
{
	I64 i;

	for (i = 0; i < HLHUD_MAX_SHEETS; i++)
	{
		hl_hud_sheet[i] = NULL;
		hl_hud_sheet_name[i * HLHUD_SHEET_MAX] = 0;
	}

	hl_hud_sheet_count = 0;
	hl_hud_count       = 0;
	hl_hud_ready       = FALSE;
	hl_hud_res         = 640;
	hl_hud_gen         = 0;

	hl_hud_ammo    = -1;
	hl_hud_reserve = -1;

	hl_hud_icon_sheet = -1;
	hl_hud_icon_x     = 0;
	hl_hud_icon_y     = 0;
	hl_hud_icon_w     = 0;
	hl_hud_icon_h     = 0;
	hl_hud_ammo_low   = FALSE;

	hl_hud_flash_on  = FALSE;
	hl_hud_flash_bat = 1.0;

	//1000 is out of range, dlls/player.cpp:3115
	hl_hud_geiger_range = 1000.0;

	hl_hud_pain       = NULL;
	hl_hud_pain_tried = FALSE;

	for (i = 0; i < 4; i++)
		hl_hud_pain_amt[i] = 0.0;

	HLVecSet(hl_hud_pain_src, 0.0, 0.0, 0.0);
	hl_hud_pain_have = FALSE;

	hl_hud_last_t = 0.0;

	hl_hud_weapon_hook = NULL;
	hl_hud_geiger_hook = NULL;
}

HLHudInit;

U0 HLHudFree()
{
	I64 i;

	for (i = 0; i < HLHUD_MAX_SHEETS; i++)
	{
		if (hl_hud_sheet[i])
			HLSprFree(hl_hud_sheet[i]);

		hl_hud_sheet[i] = NULL;
		hl_hud_sheet_name[i * HLHUD_SHEET_MAX] = 0;
	}

	hl_hud_sheet_count = 0;
	hl_hud_count       = 0;
	hl_hud_ready       = FALSE;
}

I64 HLHudSheet(U8 *name)
{
	U8	path[96];
	I64	i;

	for (i = 0; i < hl_hud_sheet_count; i++)
	{
		if (!StrICompare(&hl_hud_sheet_name[i * HLHUD_SHEET_MAX], name))
			return i;
	}

	if (hl_hud_sheet_count >= HLHUD_MAX_SHEETS)
		return -1;

	StrPrint(path, "sprites/%s.spr", name);

	hl_hud_sheet[hl_hud_sheet_count] = HLSprLoad(path);

	if (!hl_hud_sheet[hl_hud_sheet_count])
		return -1;

	HLRdName(name, &hl_hud_sheet_name[hl_hud_sheet_count * HLHUD_SHEET_MAX],
		HLHUD_SHEET_MAX);

	hl_hud_sheet_count++;

	return hl_hud_sheet_count - 1;
}

I64 HLHudFind(U8 *name)
{
	I64 i;

	for (i = 0; i < hl_hud_count; i++)
	{
		if (!StrICompare(hl_hud_entry[i].name, name))
			return i;
	}

	return -1;
}

Bool HLHudIsSpace(I64 c)
{
	return ToBool(c == ' ' || c == '\t' || c == '\r');
}

#define HLHUD_TOKENS		7

I64 HLHudSplit(U8 *line, U8 *tok)
{
	I64 i = 0;
	I64 n = 0;
	I64 k;

	while (line[i] && n < HLHUD_TOKENS)
	{
		while (line[i] && HLHudIsSpace(line[i]))
			i++;

		if (!line[i])
			break;

		k = 0;
		while (line[i] && !HLHudIsSpace(line[i]) &&
			k < HLHUD_SHEET_MAX - 1)
		{
			tok[n * HLHUD_SHEET_MAX + k] = line[i];
			k++;
			i++;
		}

		tok[n * HLHUD_SHEET_MAX + k] = 0;
		n++;

		while (line[i] && !HLHudIsSpace(line[i]))
			i++;
	}

	return n;
}

Bool HLHudLoad(I64 canvas_width)
{
	U8	*d;
	U8	 line[192];
	U8	 tok[HLHUD_TOKENS * HLHUD_SHEET_MAX];
	U8	 want[8];
	I64	 size = 0;
	I64	 pos  = 0;
	I64	 len;
	I64	 res;
	I64	 sheet;
	I64	 slot;

	HLHudFree;

	hl_hud_gen++;

	if (hl_hud_size)
		res = hl_hud_size;
	else if (canvas_width >= 2560)
		res = 2560;
	else if (canvas_width >= 1280)
		res = 1280;
	else if (canvas_width >= 640)
		res = 640;
	else
		res = 320;

	StrPrint(want, "%d", res);

	hl_hud_res = res;

	d = HLFileData("sprites/hud.txt", &size);
	if (!d || size < 8)
	{
		"HLHud: sprites/hud.txt missing\n";
		return FALSE;
	}

	while (pos < size && hl_hud_count < HLHUD_MAX_ENTRIES)
	{
		len = 0;
		while (pos < size && d[pos] != '\n' && len < 191)
		{
			line[len] = d[pos];
			len++;
			pos++;
		}
		line[len] = 0;

		while (pos < size && d[pos] != '\n')
			pos++;
		pos++;

		if (!len || line[0] == '/')
			goto qhl_next;

		if (HLHudSplit(line, tok) != HLHUD_TOKENS)
			goto qhl_next;

		if (StrCompare(&tok[1 * HLHUD_SHEET_MAX], want))
			goto qhl_next;

		sheet = HLHudSheet(&tok[2 * HLHUD_SHEET_MAX]);
		if (sheet < 0)
			goto qhl_next;

		slot = hl_hud_count;

		HLRdName(&tok[0], hl_hud_entry[slot].name, HLHUD_NAME_MAX);

		hl_hud_entry[slot].sheet = sheet;
		hl_hud_entry[slot].x = ToI64(HLAtoF(&tok[3 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].y = ToI64(HLAtoF(&tok[4 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].w = ToI64(HLAtoF(&tok[5 * HLHUD_SHEET_MAX]));
		hl_hud_entry[slot].h = ToI64(HLAtoF(&tok[6 * HLHUD_SHEET_MAX]));

		hl_hud_count++;

qhl_next:
	}

	"HLHud: %d elements at %d, %d sheets\n", hl_hud_count, res,
		hl_hud_sheet_count;

	hl_hud_ready = ToBool(hl_hud_count > 0);

	return hl_hud_ready;
}

U0 HLHudDrawElement(CHLCanvas *c, I64 idx, I64 x, I64 y,
	I64 r, I64 g, I64 b)
{
	CHLHudEntry *e;

	if (idx < 0 || idx >= hl_hud_count)
		return;

	e = &hl_hud_entry[idx];

	if (e->sheet < 0 || e->sheet >= hl_hud_sheet_count)
		return;

	HLSprDrawRect(c, hl_hud_sheet[e->sheet], 0, x, y,
		e->x, e->y, e->w, e->h, r, g, b);
}

I64 HLHudDrawNumber(CHLCanvas *c, I64 x, I64 y, I64 value, I64 min_digits,
	I64 r, I64 g, I64 b)
{//CHud::DrawHudNumber, hud_redraw.cpp.
	U8	 name[HLHUD_NAME_MAX];
	I64	 place = 1;
	I64	 digits = 1;
	I64	 blanks;
	I64	 d;
	I64	 idx;
	I64	 unit = 0;
	I64	 w = 0;
	I64	 v = value;

	if (v < 0)
		v = 0;

	while (v / place >= 10)
	{
		place *= 10;
		digits++;
	}

	idx = HLHudFind("number_0");

	if (idx >= 0)
		unit = hl_hud_entry[idx].w;

	blanks = min_digits - digits;

	if (blanks > 0)
		w = blanks * unit;

	while (place > 0)
	{
		d = (v / place) % 10;

		StrPrint(name, "number_%d", d);
		idx = HLHudFind(name);

		if (idx >= 0)
		{
			HLHudDrawElement(c, idx, x + w, y, r, g, b);
			w += hl_hud_entry[idx].w;
		}

		place /= 10;
	}

	return w;
}


U0 HLHudPainLoad()
{
	U8 path[64];

	if (hl_hud_pain_tried)
		return;

	hl_hud_pain_tried = TRUE;

	//320, 640, 1280 and 2560 all ship a set
	StrPrint(path, "sprites/%d_pain.spr", hl_hud_res);

	hl_hud_pain = HLSprLoad(path);
}

U0 HLHudDamageFrom(F64 *from, F64 *origin, F64 *forward, F64 *right)
{
	F64 delta[3];
	F64 dist;
	F64 along;
	F64 across;
	F64 mag;
	I64 i;

	if (!from || !origin || !forward || !right)
		return;

	if (from[0] == 0.0 && from[1] == 0.0 && from[2] == 0.0)
	{
		for (i = 0; i < 4; i++)
			hl_hud_pain_amt[i] = 0.0;

		return;
	}

	HLVecSub(from, origin, delta);
	dist = HLVecLength(delta);

	if (HLVecNormalize(delta) <= 0.0)
		return;

	along  = HLVecDot(delta, forward);
	across = HLVecDot(delta, right);

	//"inside 50 units it came from everywhere" - all four light at once
	if (dist <= 50.0)
	{
		for (i = 0; i < 4; i++)
			hl_hud_pain_amt[i] = 1.0;

		return;
	}

	mag = along;

	if (mag < 0.0)
		mag = -mag;

	if (mag > 0.3)
	{
		if (along > 0.0)
		{
			if (mag > hl_hud_pain_amt[HLHUD_PAIN_UP])
				hl_hud_pain_amt[HLHUD_PAIN_UP] = mag;
		}
		else if (mag > hl_hud_pain_amt[HLHUD_PAIN_DOWN])
			hl_hud_pain_amt[HLHUD_PAIN_DOWN] = mag;
	}

	mag = across;

	if (mag < 0.0)
		mag = -mag;

	if (mag > 0.3)
	{
		if (across > 0.0)
		{
			if (mag > hl_hud_pain_amt[HLHUD_PAIN_RIGHT])
				hl_hud_pain_amt[HLHUD_PAIN_RIGHT] = mag;
		}
		else if (mag > hl_hud_pain_amt[HLHUD_PAIN_LEFT])
			hl_hud_pain_amt[HLHUD_PAIN_LEFT] = mag;
	}
}

U0 HLHudDamageSource(F64 *from)
{
	if (!from)
		return;

	HLVecCopy(from, hl_hud_pain_src);
	hl_hud_pain_have = TRUE;
}

U0 HLHudDrawPain(CHLCanvas *c, F64 dt, I64 r, I64 g, I64 b)
{
	F64	frac;
	I64	sw;
	I64	sh;
	I64	cx;
	I64	cy;
	I64	shade;
	I64	dr, dg, db;
	I64	i;

	if (!c)
		return;

	if (hl_hud_pain_have)
	{
		hl_hud_pain_have = FALSE;
		HLHudDamageFrom(hl_hud_pain_src, c->origin, c->forward, c->right);
	}

	if (hl_hud_pain_amt[0] <= 0.0 && hl_hud_pain_amt[1] <= 0.0 &&
		hl_hud_pain_amt[2] <= 0.0 && hl_hud_pain_amt[3] <= 0.0)
		return;

	HLHudPainLoad;

	cx = ToI64(c->center_x);
	cy = ToI64(c->center_y);

	for (i = 0; i < 4; i++)
	{
		frac = hl_hud_pain_amt[i];

		if (frac > 0.4 && hl_hud_pain && i < hl_hud_pain->num_frames)
		{
			sw = hl_hud_pain->frames[i].width;
			sh = hl_hud_pain->frames[i].height;

			shade = ToI64(255.0 * frac);

			if (shade < 128)
				shade = 128;
			if (shade > 255)
				shade = 255;

			dr = r * shade / 255;
			dg = g * shade / 255;
			db = b * shade / 255;

			if (i == HLHUD_PAIN_UP)
				HLSprDrawRect(c, hl_hud_pain, i, cx - sw / 2, cy - sh * 3,
					0, 0, sw, sh, dr, dg, db);
			else if (i == HLHUD_PAIN_RIGHT)
				HLSprDrawRect(c, hl_hud_pain, i, cx + sw * 2, cy - sh / 2,
					0, 0, sw, sh, dr, dg, db);
			else if (i == HLHUD_PAIN_DOWN)
				HLSprDrawRect(c, hl_hud_pain, i, cx - sw / 2, cy + sh * 2,
					0, 0, sw, sh, dr, dg, db);
			else
				HLSprDrawRect(c, hl_hud_pain, i, cx - sw * 3, cy - sh / 2,
					0, 0, sw, sh, dr, dg, db);
		}

		hl_hud_pain_amt[i] -= dt * 2.0;

		if (hl_hud_pain_amt[i] < 0.0)
			hl_hud_pain_amt[i] = 0.0;
	}
}


U0 HLHudDrawFlashlight(CHLCanvas *c)
{//CHudFlashlight::Draw, cl_dll/flashlight.cpp.
	CHLHudEntry	*e;
	I64			 casing;
	I64			 full;
	I64			 beam;
	I64			 iw;
	I64			 x;
	I64			 y;
	I64			 off;
	I64			 a;
	I64			 r, g, b;

	if (!c)
		return;

	casing = HLHudFind("flash_empty");
	full   = HLHudFind("flash_full");

	if (casing < 0 || full < 0)
		return;

	iw = hl_hud_entry[full].w;

	if (iw < 1)
		return;

	y = (hl_hud_entry[casing].y + hl_hud_entry[casing].h -
		hl_hud_entry[full].y) / 2;

	//a = 225 lit, MIN_ALPHA 100 dark. ScaleColors folds it into the colour
	a = 100;

	if (hl_hud_flash_on)
		a = 225;

	if (hl_hud_flash_bat < 0.20)
	{
		r = HLHUD_LOW_R;
		g = HLHUD_LOW_G;
		b = HLHUD_LOW_B;
	}
	else
	{
		r = HLHUD_R;
		g = HLHUD_G;
		b = HLHUD_B;
	}

	r = r * a / 255;
	g = g * a / 255;
	b = b * a / 255;

	x = c->width - iw - iw / 2;

	HLHudDrawElement(c, casing, x, y, r, g, b);

	if (hl_hud_flash_on)
	{
		beam = HLHudFind("flash_beam");

		if (beam >= 0)
			HLHudDrawElement(c, beam, c->width - iw / 2, y, r, g, b);
	}

	off = ToI64(ToF64(iw) * (1.0 - hl_hud_flash_bat));

	if (off < 0)
		off = 0;

	if (off < iw)
	{
		e = &hl_hud_entry[full];

		if (e->sheet >= 0 && e->sheet < hl_hud_sheet_count)
			HLSprDrawRect(c, hl_hud_sheet[e->sheet], 0, x + off, y,
				e->x + off, e->y, e->w - off, e->h, r, g, b);
	}
}

I64 HLHudMsgAxis(F64 v, I64 extent, I64 screen)
{
	I64 p;

	if (v == -1.0)
		p = (screen - extent) / 2;
	else if (v < 0.0)
		p = ToI64((1.0 + v) * ToF64(screen)) - extent;
	else
		p = ToI64(v * ToF64(screen));

	if (p + extent > screen)
		p = screen - extent;
	if (p < 0)
		p = 0;

	return p;
}


F64	 hl_hud_time		= 0.0;

#define HLFADE_NONE	0
#define HLFADE_IN	1
#define HLFADE_OUT	2

I64	 hl_fade_r			= 0;
I64	 hl_fade_g			= 0;
I64	 hl_fade_b			= 0;
I64	 hl_fade_a			= 0;		//0..255, the alpha at full strength
F64	 hl_fade_start		= 0.0;
F64	 hl_fade_duration	= 0.0;
F64	 hl_fade_hold		= 0.0;
I64	 hl_fade_mode		= HLFADE_NONE;

U0 HLHudFadeInit()
{
	hl_hud_time      = 0.0;
	hl_fade_r        = 0;
	hl_fade_g        = 0;
	hl_fade_b        = 0;
	hl_fade_a        = 0;
	hl_fade_start    = 0.0;
	hl_fade_duration = 0.0;
	hl_fade_hold     = 0.0;
	hl_fade_mode     = HLFADE_NONE;
}

HLHudFadeInit;

U0 HLHudFadeSet(I64 r, I64 g, I64 b, I64 a, F64 duration, F64 hold,
	Bool fade_in)
{//CFade::Use, dlls/effects.cpp:1962.
	hl_fade_r        = ClampI64(r, 0, 255);
	hl_fade_g        = ClampI64(g, 0, 255);
	hl_fade_b        = ClampI64(b, 0, 255);
	hl_fade_a        = ClampI64(a, 0, 255);
	hl_fade_duration = duration;
	hl_fade_hold     = hold;
	hl_fade_start    = hl_hud_time;

	if (fade_in)
		hl_fade_mode = HLFADE_IN;
	else
		hl_fade_mode = HLFADE_OUT;
}

I64 HLHudFadeAlpha()
{
	F64 t;

	if (hl_fade_mode == HLFADE_NONE || hl_fade_a <= 0)
		return 0;

	t = hl_hud_time - hl_fade_start;

	if (t < 0.0)
		t = 0.0;

	if (hl_fade_mode == HLFADE_IN)
	{
		if (hl_fade_duration <= 0.0 || t >= hl_fade_duration)
		{
			hl_fade_mode = HLFADE_NONE;
			return 0;
		}

		return ToI64(ToF64(hl_fade_a) *
			(1.0 - t / hl_fade_duration));
	}

	if (hl_fade_duration > 0.0 && t < hl_fade_duration)
		return ToI64(ToF64(hl_fade_a) * (t / hl_fade_duration));

	if (t < hl_fade_duration + hl_fade_hold)
		return hl_fade_a;

	hl_fade_mode = HLFADE_NONE;

	return 0;
}

U0 HLHudFadeDraw(CHLCanvas *c)
{
	U32	*dst;
	I64	 a;
	I64	 inv;
	I64	 x;
	I64	 y;
	I64	 px;

	if (!c || !c->pixels)
		return;

	a = HLHudFadeAlpha;

	if (a <= 0)
		return;

	inv = 255 - a;

	for (y = 0; y < c->height; y++)
	{
		dst = c->pixels + y * c->width;

		for (x = 0; x < c->width; x++)
		{
			px = dst[x];

			dst[x] =
				(((((px >> 16) & 255) * inv + hl_fade_r * a) >> 8) << 16) |
				(((((px >> 8)  & 255) * inv + hl_fade_g * a) >> 8) << 8)  |
				 ((((px        & 255) * inv + hl_fade_b * a) >> 8));
		}
	}
}


Bool hl_title_on		= FALSE;
F64	 hl_title_start		= 0.0;
F64	 hl_title_fadein	= 1.0;
F64	 hl_title_hold		= 3.0;
F64	 hl_title_fadeout	= 1.5;
I64	 hl_title_r			= 180;
I64	 hl_title_g			= 180;
I64	 hl_title_b			= 180;
F64	 hl_title_x			= -1.0;
F64	 hl_title_y			= -1.0;

U0 HLHudTitleInit()
{
	hl_title_on      = FALSE;
	hl_title_start   = 0.0;
	hl_title_fadein  = 1.0;
	hl_title_hold    = 3.0;
	hl_title_fadeout = 1.5;
	hl_title_r       = 180;
	hl_title_g       = 180;
	hl_title_b       = 180;
	hl_title_x       = -1.0;
	hl_title_y       = -1.0;
}

HLHudTitleInit;

U0 HLHudTitleShow(I64 r, I64 g, I64 b, F64 x, F64 y,
	F64 fadein, F64 hold, F64 fadeout)
{//MsgFunc_GameTitle, cl_dll/message.cpp:329.
	hl_title_r       = ClampI64(r, 0, 255);
	hl_title_g       = ClampI64(g, 0, 255);
	hl_title_b       = ClampI64(b, 0, 255);
	hl_title_x       = x;
	hl_title_y       = y;
	hl_title_fadein  = fadein;
	hl_title_hold    = hold;
	hl_title_fadeout = fadeout;
	hl_title_start   = hl_hud_time;
	hl_title_on      = TRUE;
}

F64 HLHudFadeBlend(F64 fadein, F64 fadeout, F64 hold, F64 t)
{//CHudMessage::FadeBlend, cl_dll/message.cpp:68. Returns 0..1.
	F64 fade_time = fadein + hold;

	if (t < 0.0)
		return 0.0;

	if (t < fadein)
	{
		if (fadein <= 0.0)
			return 1.0;

		return 1.0 - (fadein - t) / fadein;
	}

	if (t > fade_time)
	{
		if (fadeout <= 0.0)
			return 0.0;

		return 1.0 - (t - fade_time) / fadeout;
	}

	return 1.0;
}

U0 HLHudTitleDraw(CHLCanvas *c)
{
	F64	 t;
	F64	 bright;
	I64	 half;
	I64	 life;
	I64	 half_w;
	I64	 full_w;
	I64	 full_h;
	I64	 x;
	I64	 y;

	if (!hl_title_on || !c || !hl_hud_ready)
		return;

	t = hl_hud_time - hl_title_start;

	if (t > hl_title_fadein + hl_title_hold + hl_title_fadeout)
	{
		hl_title_on = FALSE;
		return;
	}

	half = HLHudFind("title_half");
	life = HLHudFind("title_life");

	if (half < 0 || life < 0)
	{
		hl_title_on = FALSE;
		return;
	}

	bright = HLHudFadeBlend(hl_title_fadein, hl_title_fadeout,
		hl_title_hold, t);

	half_w = hl_hud_entry[half].w;
	full_w = half_w + hl_hud_entry[life].w;
	full_h = hl_hud_entry[half].h;

	x = HLHudMsgAxis(hl_title_x, full_w, c->width);
	y = HLHudMsgAxis(hl_title_y, full_h, c->height);

	HLHudDrawElement(c, half, x, y,
		ToI64(bright * ToF64(hl_title_r)),
		ToI64(bright * ToF64(hl_title_g)),
		ToI64(bright * ToF64(hl_title_b)));

	HLHudDrawElement(c, life, x + half_w, y,
		ToI64(bright * ToF64(hl_title_r)),
		ToI64(bright * ToF64(hl_title_g)),
		ToI64(bright * ToF64(hl_title_b)));
}

U0 HLHudOverlayDraw(CHLCanvas *c)
{
	HLHudFadeDraw(c);
	HLHudTitleDraw(c);
}

U0 HLHudDraw(CHLCanvas *c, I64 health, I64 battery, I64 ammo,
	Bool has_suit)
{
	CHLHudEntry *e;
	I64 idx;
	I64 x;
	I64 fh      = 24;
	I64 num_w   = 20;
	I64 base_y;
	I64 num_y;
	I64 cross_w = 0;
	I64 suit_w  = 0;
	I64 suit_h  = 0;
	I64 top;
	I64 reserve;
	I64 icon_w = 0;			//iIconWidth, 0 when the weapon names no ammo icon
	I64 r, g, b;
	F64 dt;

	if (!c)
		return;

	dt = tS - hl_hud_last_t;

	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	hl_hud_last_t = tS;

	if (hl_hud_weapon_hook)
		hl_hud_weapon_hook(c);

	if (hl_hud_geiger_hook)
		hl_hud_geiger_hook(hl_hud_geiger_range, dt);

	if (!hl_hud_ready)
		return;

	idx = HLHudFind("number_0");
	if (idx >= 0)
	{
		fh    = hl_hud_entry[idx].h;
		num_w = hl_hud_entry[idx].w;
	}

	base_y = c->height - fh - fh / 2;
	num_y  = base_y + ToI64(ToF64(fh) * 0.2);

	r = HLHUD_R;
	g = HLHUD_G;
	b = HLHUD_B;

	if (health <= 25)
	{
		r = HLHUD_LOW_R;
		g = HLHUD_LOW_G;
		b = HLHUD_LOW_B;

		if (ToI64(tS * 4.0) & 1)
		{
			r /= 3;
			g /= 3;
			b /= 3;
		}
	}

	HLHudDrawPain(c, dt, r, g, b);

	idx = HLHudFind("cross");
	if (idx >= 0)
	{
		cross_w = hl_hud_entry[idx].w;

		HLHudDrawElement(c, idx, cross_w / 2, base_y, r, g, b);
	}

	x  = cross_w + num_w / 2;
	x += HLHudDrawNumber(c, x, num_y, health, 3, r, g, b);

	x += num_w / 2;

	idx = HLHudFind("divider");
	if (idx >= 0)
		HLHudDrawElement(c, idx, x,
			num_y + (fh - hl_hud_entry[idx].h) / 2,
			HLHUD_R, HLHUD_G, HLHUD_B);

	if (has_suit)
	{
		r = HLHUD_R;
		g = HLHUD_G;
		b = HLHUD_B;

		idx = HLHudFind("suit_empty");

		if (idx >= 0)
		{
			suit_w = hl_hud_entry[idx].w;
			suit_h = hl_hud_entry[idx].h;
		}

		x = 3 * suit_w;

		if (idx >= 0)
			HLHudDrawElement(c, idx, x, base_y - suit_h / 6, r, g, b);

		idx = HLHudFind("suit_full");

		if (idx >= 0 && battery > 0)
		{
			e = &hl_hud_entry[idx];

			top = ToI64(ToF64(e->h) * ToF64(100 - battery) * 0.01);

			if (top < 0)
				top = 0;
			if (top > e->h)
				top = e->h;

			if (e->sheet >= 0 && e->sheet < hl_hud_sheet_count)
				HLSprDrawRect(c, hl_hud_sheet[e->sheet], 0,
					x, base_y - suit_h / 6 + top,
					e->x, e->y + top, e->w, e->h - top, r, g, b);
		}

		x += suit_w;

		HLHudDrawNumber(c, x, num_y, battery, 3, r, g, b);
	}

	if (has_suit)
		HLHudDrawFlashlight(c);

	if (ammo < 0)
		ammo = hl_hud_ammo;

	reserve = hl_hud_reserve;

	if (ammo >= 0)
	{
		r = HLHUD_R;
		g = HLHUD_G;
		b = HLHUD_B;

		if (hl_hud_ammo_low)
		{
			r = HLHUD_LOW_R;
			g = HLHUD_LOW_G;
			b = HLHUD_LOW_B;

			if (ToI64(tS * 4.0) & 1)
			{
				r /= 3;
				g /= 3;
				b /= 3;
			}
		}

		icon_w = 0;

		if (hl_hud_icon_sheet >= 0 && hl_hud_icon_sheet < hl_hud_sheet_count)
		{
			icon_w = hl_hud_icon_w;

			HLSprDrawRect(c, hl_hud_sheet[hl_hud_icon_sheet], 0,
				c->width - icon_w, base_y,
				hl_hud_icon_x, hl_hud_icon_y, hl_hud_icon_w, hl_hud_icon_h,
				r, g, b);
		}

		if (reserve >= 0)
		{
			x  = c->width - 8 * num_w - icon_w;
			x += HLHudDrawNumber(c, x, num_y, ammo, 3, r, g, b);

			x += num_w / 2;

			idx = HLHudFind("divider");
			if (idx >= 0)
			{
				HLHudDrawElement(c, idx, x,
					num_y + (fh - hl_hud_entry[idx].h) / 2, r, g, b);

				x += hl_hud_entry[idx].w;
			}
			else
				x += num_w / 10;

			x += num_w / 2;

			HLHudDrawNumber(c, x, num_y, reserve, 3, r, g, b);
		}
		else
		{
			x = c->width - 4 * num_w - icon_w;

			HLHudDrawNumber(c, x, num_y, ammo, 3, r, g, b);
		}
	}

}


#define HLMSG_MAX_TEXT		512

//pMessage->effect.
#define HLMSG_FX_FADE		0
#define HLMSG_FX_FLICKER		1
#define HLMSG_FX_WRITEOUT	2

U8	 hl_msg_text[HLMSG_MAX_TEXT];
Bool hl_msg_active		= FALSE;
F64	 hl_msg_start		= 0.0;
I64	 hl_msg_effect		= HLMSG_FX_FADE;
F64	 hl_msg_x			= -1.0;		//-1 centres on that axis
F64	 hl_msg_y			= -1.0;
F64	 hl_msg_fadein		= 0.0;
F64	 hl_msg_fadeout		= 0.0;
F64	 hl_msg_hold			= 0.0;
F64	 hl_msg_fxtime		= 0.0;
I64	 hl_msg_r1			= 255;
I64	 hl_msg_g1			= 255;
I64	 hl_msg_b1			= 255;
I64	 hl_msg_r2			= 255;
I64	 hl_msg_g2			= 255;
I64	 hl_msg_b2			= 255;

U0 HLHudMsgInit()
{
	hl_msg_text[0]  = 0;
	hl_msg_active   = FALSE;
	hl_msg_start    = 0.0;
	hl_msg_effect   = HLMSG_FX_FADE;
	hl_msg_x        = -1.0;
	hl_msg_y        = -1.0;
	hl_msg_fadein   = 0.0;
	hl_msg_fadeout  = 0.0;
	hl_msg_hold     = 0.0;
	hl_msg_fxtime   = 0.0;
	hl_msg_r1       = 255;
	hl_msg_g1       = 255;
	hl_msg_b1       = 255;
	hl_msg_r2       = 255;
	hl_msg_g2       = 255;
	hl_msg_b2       = 255;
}

HLHudMsgInit;

U0 HLHudMsgClear()
{
	hl_msg_active  = FALSE;
	hl_msg_text[0] = 0;
}

U0 HLHudMsgShow(U8 *text, I64 effect, F64 x, F64 y,
	I64 r1, I64 g1, I64 b1, I64 r2, I64 g2, I64 b2,
	F64 fadein, F64 fadeout, F64 hold, F64 fxtime)
{
	I64 i = 0;

	if (!text || !text[0])
		return;

	while (text[i] && i < HLMSG_MAX_TEXT - 1)
	{
		hl_msg_text[i] = text[i];
		i++;
	}

	hl_msg_text[i] = 0;

	hl_msg_effect  = effect;
	hl_msg_x       = x;
	hl_msg_y       = y;
	hl_msg_r1      = r1;
	hl_msg_g1      = g1;
	hl_msg_b1      = b1;
	hl_msg_r2      = r2;
	hl_msg_g2      = g2;
	hl_msg_b2      = b2;
	hl_msg_fadein  = fadein;
	hl_msg_fadeout = fadeout;
	hl_msg_hold    = hold;
	hl_msg_fxtime  = fxtime;

	if (hl_msg_hold <= 0.0)
		hl_msg_hold = 2.0;

	hl_msg_start  = hl_hud_time;
	hl_msg_active = TRUE;
}



