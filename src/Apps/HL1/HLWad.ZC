// HLWad.ZC - Draw_PicFromWad, 2d art from gfx.wad lumps and .lmp files
//
//   gfx.wad    163 lumps - SBAR/IBAR, the big HUD digits, icons, faces, and
//              CONCHARS, a 128x128 atlas of 8x8 glyphs used for all text
//   gfx/*.lmp  standalone pictures - menu art, console backdrop, banners
//
// Both are 8bpp palette indices in a (width, height, pixels) layout, index 255
// transparent.
//
// Everything draws into the 320x240 indexed canvas, not the host window: the
// interface goes through the same palette as the world.

#define HLWAD_MAX_LUMPS	256
#define HLPIC_TRANSPARENT 255
#define HLCHAR_W			8
#define HLCHAR_H			8

class CHLPic
{
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from the archive; never freed here

	//HL 2D lumps carry a 256 colour palette after the pixels, as a miptex does.
	//Quake lumps do not and index the global palette. NULL means global, so
	//quake-format art works unchanged
	U8	*palette;
};

U0 HLPicReadPalette(CHLPic *out, U8 *base, I64 size)
{//pixels are followed by u16 colour count then count*3 RGB, when present
	I64 ofs = 8 + out->width * out->height;
	I64 colors;

	out->palette = NULL;

	if (ofs + 2 > size)
		return;

	colors = HLRdU16(base + ofs);

	//always 256 in HL art. Any other count means a quake lump, and these bytes
	//are not a colour count at all
	if (colors == 256 && ofs + 2 + 768 <= size)
		out->palette = base + ofs + 2;
}

U32 HLPicColor(CHLPic *pic, I64 texel)
{
	texel &= 255;

	if (!pic->palette)
		return HLPalColor(texel);

	return (pic->palette[texel * 3] << 16) |
		   (pic->palette[texel * 3 + 1] << 8) |
			pic->palette[texel * 3 + 2];
}

class CHLWadLump
{
	U8	 name[20];
	U8	*data;
	I64	 size;
	I64	 type;			//0x42 qpic, 0x43 miptex, 0x46 font
};

//--- the HL console font ----------------------------------------------------
//
// gfx.wad stores CONCHARS as a qfont_t, WAD3 lump type 0x46, not as quake's raw
// 128x128 atlas of fixed 8x8 cells. Layout:
//
//     int width, height, rowcount, rowheight;
//     charinfo { short startoffset; short charwidth; } [256];
//     byte pixels[256 * height];
//     u16 palette_count; byte palette[count*3];
//
// The header "width" is not the texture width; the image is 256 wide by format.
// startoffset is a linear offset into that image. From the shipped gfx.wad: 'A'
// at 196 -> (196, 0), 'a' at 3218 -> (146, 12), landing on rowheight, and the
// adjacent pair 'A'(196, w7) -> 'B'(203) fixes the packing.
//
// Glyphs are variable width, so text cannot advance by a constant.

#define HLFONT_WIDTH		256		//fixed by the format, not by the header
#define HLFONT_GLYPHS		256
#define HLWAD_TYP_FONT		0x46

class CHLFont
{
	Bool	 ready;
	U8		*pixels;		//borrowed from the wad
	U8		*palette;		//NULL falls back to the global one
	I64		 height;
	I64		 row_height;
	I64		 start[HLFONT_GLYPHS];
	I64		 cwidth[HLFONT_GLYPHS];
};

CHLFont	hl_font;

U0 HLFontClear()
{//globals are not zeroed, and this flag selects the draw path
	hl_font.ready      = FALSE;
	hl_font.pixels     = NULL;
	hl_font.palette    = NULL;
	hl_font.height     = 0;
	hl_font.row_height = 0;
}

//top-level call: the flag is false before any text can be drawn
HLFontClear;

Bool HLFontParse(U8 *d, I64 size)
{//one WAD3 font lump
	I64 image;
	I64 colors;
	I64 i;

	HLFontClear;

	if (size < 16 + HLFONT_GLYPHS * 4)
		return FALSE;

	hl_font.height     = HLRdI32(d + 4);
	hl_font.row_height = HLRdI32(d + 12);

	if (hl_font.height < 1 || hl_font.row_height < 1)
		return FALSE;

	image = 16 + HLFONT_GLYPHS * 4;

	if (image + HLFONT_WIDTH * hl_font.height > size)
		return FALSE;

	for (i = 0; i < HLFONT_GLYPHS; i++)
	{
		hl_font.start[i]  = HLRdU16(d + 16 + i * 4);
		hl_font.cwidth[i] = HLRdU16(d + 16 + i * 4 + 2);
	}

	hl_font.pixels = d + image;

	//palette after the image, same shape as a qpic's
	i = image + HLFONT_WIDTH * hl_font.height;

	if (i + 2 <= size)
	{
		colors = HLRdU16(d + i);

		if (colors == 256 && i + 2 + 768 <= size)
			hl_font.palette = d + i + 2;
	}

	hl_font.ready = TRUE;

	return TRUE;
}

I64 HLFontCharWidth(I64 ch)
{//advance for one character. Quake's charset was a fixed 8
	ch &= 255;

	if (!hl_font.ready)
		return HLCHAR_W;

	if (hl_font.cwidth[ch] < 1)
		return HLCHAR_W;

	return hl_font.cwidth[ch];
}

I64 HLFontHeight()
{
	if (!hl_font.ready)
		return HLCHAR_H;

	return hl_font.row_height;
}

I64 HLFontStrWidth(U8 *s)
{//variable-width text cannot be centred by counting characters
	I64 w = 0;
	I64 i = 0;

	if (!s)
		return 0;

	while (s[i])
	{
		w += HLFontCharWidth(s[i]);
		i++;
	}

	return w;
}

CHLWadLump	hl_wad_lumps[HLWAD_MAX_LUMPS];
I64			hl_wad_count		= 0;
U8			*hl_conchars		= NULL;		//128x128 glyph atlas
Bool		 hl_wad_ready	= FALSE;

//fallback atlas, built from the kernel font. A mod may ship no gfx.wad, and
//HL's CONCHARS is a font lump rather than quake's raw 128x128. An atlas is
//always present, otherwise there is no console to report the failure in
U8			hl_conchars_synth[128 * 128];

U0 HLWadSynthConchars()
{//the kernel font is 256 glyphs of 8x8, one bit per pixel packed into a U64,
 //row 0 in the low byte. Laid out on quake's 16x16 grid so HLCharDraw indexes
 //them unchanged
 //
 //read through text.font, not sys_font_std: that array is defined in FontStd.ZC
 //and declared in no header, so the symbol exists but cannot be subscripted.
 //text.font is a typed U64*
	U64 *font = text.font;
	I64 ch;
	I64 row;
	I64 col;
	I64 y;
	I64 x;
	I64 ink;

	//HLCharDraw treats index 0 as transparent, so the ink must be non-zero
	ink = HLPalNearest(255, 255, 255);
	if (!ink)
		ink = 15;

	MemSet(hl_conchars_synth, 0, 128 * 128);

	if (!font)
		return;

	for (ch = 0; ch < 256; ch++)
	{
		row = (ch >> 4) * HLCHAR_H;
		col = (ch & 15) * HLCHAR_W;

		for (y = 0; y < FONT_HEIGHT; y++)
		{
			for (x = 0; x < FONT_WIDTH; x++)
			{
				//quake's high 128 are the same glyphs in the bright colour;
				//the kernel font has no such split
				if ((font[ch & 127] >> (y * 8)) & (1 << x))
					hl_conchars_synth[(row + y) * 128 + col + x] = ink;
			}
		}
	}
}

U0 HLWadInit()
{//globals are not zeroed; clear first
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 count;
	I64	 table;
	I64	 pos;
	I64	 dsize;
	I64	 i;

	for (i = 0; i < HLWAD_MAX_LUMPS; i++)
	{
		hl_wad_lumps[i].name[0] = 0;
		hl_wad_lumps[i].data    = NULL;
		hl_wad_lumps[i].size    = 0;
	}

	hl_wad_count  = 0;
	hl_conchars   = NULL;
	hl_wad_ready  = FALSE;

	//a font exists regardless of what the archive holds
	HLWadSynthConchars;
	hl_conchars = hl_conchars_synth;

	//HL's gfx.wad is WAD3. The directory layout matches WAD2 and only the lump
	//bodies differ, so one indexer serves both; HLWadPic's header checks reject
	//bodies it cannot read
	d = HLFileData("gfx.wad", &size);
	if (!d || size < 12 ||
		(MemCompare(d, "WAD2", 4) && MemCompare(d, "WAD3", 4)))
	{
		"HLWad: no gfx.wad, using the kernel font for text\n";
		return;
	}

	count = HLRdI32(d + 4);
	table = HLRdI32(d + 8);

	if (count < 1 || table < 0 || table + count * 32 > size)
	{
		"HLWad: gfx.wad directory is out of range\n";
		return;
	}

	for (i = 0; i < count && hl_wad_count < HLWAD_MAX_LUMPS; i++)
	{
		rec   = d + table + i * 32;
		pos   = HLRdI32(rec);
		dsize = HLRdI32(rec + 4);

		if (pos < 0 || pos + dsize > size)
			goto qw_next;

		HLRdName(rec + 16, hl_wad_lumps[hl_wad_count].name, 17);
		hl_wad_lumps[hl_wad_count].data = d + pos;
		hl_wad_lumps[hl_wad_count].size = dsize;
		hl_wad_lumps[hl_wad_count].type = rec[12];

		if (!StrICompare(hl_wad_lumps[hl_wad_count].name, "CONCHARS"))
		{
			//the name covers two formats. HL's is a font lump with variable
			//width glyphs; quake's is a headerless raw 128x128 atlas of fixed
			//8x8 cells
			if (hl_wad_lumps[hl_wad_count].type == HLWAD_TYP_FONT)
				HLFontParse(d + pos, dsize);
			else if (dsize >= 128 * 128)
				hl_conchars = d + pos;
		}

		hl_wad_count++;

qw_next:
	}

	hl_wad_ready = TRUE;
}

Bool HLWadPic(U8 *name, CHLPic *out)
{//Draw_PicFromWad
	I64 i;

	out->width   = 0;
	out->height  = 0;
	out->pixels  = NULL;
	out->palette = NULL;

	for (i = 0; i < hl_wad_count; i++)
	{
		if (!StrICompare(hl_wad_lumps[i].name, name))
		{
			if (hl_wad_lumps[i].size < 8)
				return FALSE;

			out->width  = HLRdI32(hl_wad_lumps[i].data);
			out->height = HLRdI32(hl_wad_lumps[i].data + 4);
			out->pixels = hl_wad_lumps[i].data + 8;

			if (out->width < 1 || out->height < 1 ||
				out->width * out->height + 8 > hl_wad_lumps[i].size)
			{
				out->pixels  = NULL;
				out->palette = NULL;
				return FALSE;
			}

			HLPicReadPalette(out, hl_wad_lumps[i].data,
				hl_wad_lumps[i].size);

			return TRUE;
		}
	}

	return FALSE;
}

Bool HLPicLoad(U8 *path, CHLPic *out)
{//Draw_CachePic - standalone gfx/*.lmp
	U8	*d;
	I64	 size = 0;

	out->width   = 0;
	out->height  = 0;
	out->pixels  = NULL;
	out->palette = NULL;

	d = HLFileData(path, &size);
	if (!d || size < 8)
		return FALSE;

	out->width  = HLRdI32(d);
	out->height = HLRdI32(d + 4);
	out->pixels = d + 8;

	if (out->width < 1 || out->height < 1 ||
		out->width * out->height + 8 > size)
	{
		out->pixels  = NULL;
		out->palette = NULL;
		return FALSE;
	}

	HLPicReadPalette(out, d, size);

	return TRUE;
}

U0 HLPicDrawFillPart(CHLCanvas *c, CHLPic *pic, I64 height)
{//stretch to canvas width over height rows, sampling from the bottom of the
 //source so the lower edges align. Used by the dropping console
	U8	*src;
	U32	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (height > c->height)
		height = c->height;
	if (height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / height;

	sy_fp = 0;
	for (py = 0; py < height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = HLPicColor(pic, src[sx_fp >> 16]);
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 HLPicDrawFill(CHLCanvas *c, CHLPic *pic)
{//stretch over the whole canvas
 //
 //menu art is 320x200 and the target is any size; drawn native it leaves the
 //rest of the screen black
 //
 //16.16 fixed point stepping, nearest sample, no filtering
	U8	*src;
	U32	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / c->height;

	sy_fp = 0;
	for (py = 0; py < c->height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = HLPicColor(pic, src[sx_fp >> 16]);
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 HLPicTile(CHLCanvas *c, CHLPic *pic, I64 x, I64 y, I64 w, I64 h)
{//Draw_TileClear - phase is taken from screen coordinates, not the rect, so
 //adjacent calls tile seamlessly
	U32	*row;
	U8	*src;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (x < 0)			{ w += x; x = 0; }
	if (y < 0)			{ h += y; y = 0; }
	if (x + w > c->width)	w = c->width - x;
	if (y + h > c->height)	h = c->height - y;

	if (w < 1 || h < 1)
		return;

	for (py = y; py < y + h; py++)
	{
		row = c->pixels + py * c->width;
		sy  = py % pic->height;
		src = pic->pixels + sy * pic->width;

		for (px = x; px < x + w; px++)
		{
			sx = px % pic->width;
			row[px] = HLPicColor(pic, src[sx]);
		}
	}
}

U0 HLPicDraw(CHLCanvas *c, CHLPic *pic, I64 x, I64 y)
{//Draw_Pic - index 255 transparent, no depth test, always on top
	U8	*src;
	U32	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qp_next_row;

		src = pic->pixels + sy * pic->width;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < pic->width; sx++)
		{
			px = x + sx;
			if (px < 0 || px >= c->width)
				goto qp_next_col;

			texel = src[sx];
			if (texel != HLPIC_TRANSPARENT)
				dst[px] = HLPicColor(pic, texel);

qp_next_col:
		}

qp_next_row:
	}
}

U0 HLPicDrawPart(CHLCanvas *c, CHLPic *pic, I64 x, I64 y, I64 sub_x, I64 sub_w)
{//Draw_TransPicTranslate - status bar pieces are cut out of the 320-wide SBAR
 //and IBAR strips, so the source stride remains the full picture width
	U8	*src;
	U32	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels || sub_w < 1)
		return;

	if (sub_x < 0)
		sub_x = 0;
	if (sub_x + sub_w > pic->width)
		sub_w = pic->width - sub_x;
	if (sub_w < 1)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qpp_next_row;

		src = pic->pixels + sy * pic->width + sub_x;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < sub_w; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel != HLPIC_TRANSPARENT)
					dst[px] = HLPicColor(pic, texel);
			}
		}

qpp_next_row:
	}
}

U0 HLFontCharDraw(CHLCanvas *c, I64 x, I64 y, I64 ch)
{//one glyph out of the HL font lump
 //
 //glyph position is a linear offset into a 256-wide image and must be unpacked,
 //not derived from the character code as with quake's fixed grid
	U8	*src;
	U32	*dst;
	I64	 ofs;
	I64	 gx;
	I64	 gy;
	I64	 gw;
	I64	 gh;
	I64	 sx;
	I64	 sy;
	I64	 py;
	I64	 px;
	U8	 texel;

	ch &= 255;

	ofs = hl_font.start[ch];
	gw  = hl_font.cwidth[ch];
	gh  = hl_font.row_height;

	if (gw < 1)
		return;

	gx = ofs % HLFONT_WIDTH;
	gy = ofs / HLFONT_WIDTH;

	for (sy = 0; sy < gh; sy++)
	{
		py = y + sy;

		if (py < 0 || py >= c->height)
			goto qfc_next_row;
		if (gy + sy >= hl_font.height)
			goto qfc_next_row;

		src = hl_font.pixels + (gy + sy) * HLFONT_WIDTH + gx;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < gw; sx++)
		{
			px = x + sx;

			if (px < 0 || px >= c->width)
				goto qfc_next_col;
			if (gx + sx >= HLFONT_WIDTH)
				goto qfc_next_col;

			texel = src[sx];

			//255 is the cutout, not 0, the same convention as a masked
			//miptex. Measured from the shipped gfx.wad: 255 covers 24793
			//of 32768 pixels at palette entry (44,72,59). Index 0 is the
			//glyph outline (46,40,22) and 30..91 the body, so cutting on
			//0 keys out the outline and paints the background
			if (texel == HLSPR_TRANSPARENT)
				goto qfc_next_col;

			if (hl_font.palette)
				dst[px] = (hl_font.palette[texel * 3] << 16) |
						  (hl_font.palette[texel * 3 + 1] << 8) |
						   hl_font.palette[texel * 3 + 2];
			else
				dst[px] = HLPalColor(texel);

qfc_next_col:
		}

qfc_next_row:
	}
}

U0 HLCharDraw(CHLCanvas *c, I64 x, I64 y, I64 ch)
{//Draw_Character. Two glyph sources depending on what gfx.wad holds; see the
 //CHLFont notes above
	U8	*src;
	U32	*dst;
	I64	 row;
	I64	 col;
	I64	 sx;
	I64	 sy;
	I64	 py;
	I64	 px;
	U8	 texel;

	if (ch < 0)
		return;

	if (hl_font.ready)
	{
		//space carries no glyph in the HL font but still advances; callers
		//take the advance from HLFontCharWidth
		if ((ch & 255) != 32)
			HLFontCharDraw(c, x, y, ch);

		return;
	}

	//only 32 is skipped. CONCHARS holds real glyphs below it: the small gold
	//digits at 18..27 used by inventory bar ammo counts, plus menu arrows
	if (!hl_conchars || ch == 32)
		return;

	ch &= 255;
	row = (ch >> 4) * HLCHAR_H;
	col = (ch & 15) * HLCHAR_W;

	for (sy = 0; sy < HLCHAR_H; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qc_next_row;

		src = hl_conchars + (row + sy) * 128 + col;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < HLCHAR_W; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel)
					dst[px] = HLPalColor(texel);
			}
		}

qc_next_row:
	}
}

U0 HLStrDraw(CHLCanvas *c, I64 x, I64 y, U8 *s)
{//advances per glyph. The HL font is variable width; a constant step overlaps
	//narrow characters and gaps wide ones
	I64 i = 0;
	I64 cx = x;

	while (s[i])
	{
		HLCharDraw(c, cx, y, s[i]);
		cx += HLFontCharWidth(s[i]);
		i++;
	}
}

U0 HLStrDrawAlt(CHLCanvas *c, I64 x, I64 y, U8 *s)
{//M_Print - every character with 128 added
 //
 //CONCHARS holds two 128-glyph sets: plain for the console, gold in the upper
 //half. M_PrintWhite is the exception
	I64 i = 0;
	I64 cx = x;

	while (s[i])
	{
		//the HL font has no second 128-glyph set, so the bright variant
		//draws the same glyph rather than reading past the table
		if (hl_font.ready)
			HLCharDraw(c, cx, y, s[i]);
		else
			HLCharDraw(c, cx, y, s[i] + 128);

		cx += HLFontCharWidth(s[i]);
		i++;
	}
}

U0 HLStrDrawCenter(CHLCanvas *c, I64 y, U8 *s)
{//width is measured, not counted; see HLFontStrWidth
	HLStrDraw(c, (c->width - HLFontStrWidth(s)) / 2, y, s);
}

U0 HLStrDrawCenterAlt(CHLCanvas *c, I64 y, U8 *s)
{
	HLStrDrawAlt(c, (c->width - HLFontStrWidth(s)) / 2, y, s);
}
