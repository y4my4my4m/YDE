// HLWad.ZC - Draw_PicFromWad, 2d art from gfx.wad lumps and .lmp files
//
//   gfx.wad    163 lumps - SBAR/IBAR, the big HUD digits, icons, faces, and
//              CONCHARS, a 128x128 atlas of 8x8 glyphs used for all text
//   gfx/*.lmp  standalone pictures - menu art, console backdrop, banners
//
// both are 8bpp palette indices in a (width, height, pixels) layout,
// index 255 transparent
//
// everything draws into the 320x240 indexed canvas, not the host window - the
// interface has to go through the same palette as the world

#define HLWAD_MAX_LUMPS	256
#define HLPIC_TRANSPARENT 255
#define HLCHAR_W			8
#define HLCHAR_H			8

class CHLPic
{
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from the archive; never freed here

	//HL 2D lumps carry their OWN 256 colour palette after the pixels, exactly
	//like a miptex - a quake lump does not, and indexes the global one. NULL
	//means "global", so quake-format art keeps working unchanged
	U8	*palette;
};

U0 HLPicReadPalette(CHLPic *out, U8 *base, I64 size)
{//pixels are followed by u16 colour count then count*3 RGB, when present
	I64 ofs = 8 + out->width * out->height;
	I64 colors;

	out->palette = NULL;

	if (ofs + 2 > size)
		return;

	colors = HLRdU16(base + ofs);

	//always 256 in shipped art; anything else means this is a quake lump and
	//the bytes we just read are something entirely different
	if (colors == 256 && ofs + 2 + 768 <= size)
		out->palette = base + ofs + 2;
}

U32 HLPicColor(CHLPic *pic, I64 texel)
{
	texel &= 255;

	if (!pic->palette)
		return HLPalColor(texel);

	return (pic->palette[texel * 3] << 16) |
		   (pic->palette[texel * 3 + 1] << 8) |
			pic->palette[texel * 3 + 2];
}

class CHLWadLump
{
	U8	 name[20];
	U8	*data;
	I64	 size;
};

CHLWadLump	hl_wad_lumps[HLWAD_MAX_LUMPS];
I64			hl_wad_count		= 0;
U8			*hl_conchars		= NULL;		//128x128 glyph atlas
Bool		 hl_wad_ready	= FALSE;

//fallback atlas, built from the kernel font. HL's gfx.wad stores CONCHARS as
//a WAD3 font lump - a completely different structure to quake's raw 128x128 -
//and a mod may ship no gfx.wad at all. without SOME atlas there is no console
//and no way to see what went wrong, so one is always available
U8			hl_conchars_synth[128 * 128];

U0 HLWadSynthConchars()
{//the kernel font is 256 glyphs of 8x8, one bit per pixel packed into a U64,
 //row 0 in the low byte. lay them out on quake's 16x16 grid so HLCharDraw
 //indexes them unchanged
 //
 //read through text.font, NOT sys_font_std: the array is defined in
 //FontStd.ZC but declared in no header, so the compiler knows the symbol
 //without knowing it can be subscripted. text.font is a typed U64* and is
 //what the kernel's own graphics demos use
	U64 *font = text.font;
	I64 ch;
	I64 row;
	I64 col;
	I64 y;
	I64 x;
	I64 ink;

	//index 0 is HLCharDraw's transparent test, so the ink must not be 0
	ink = HLPalNearest(255, 255, 255);
	if (!ink)
		ink = 15;

	MemSet(hl_conchars_synth, 0, 128 * 128);

	if (!font)
		return;

	for (ch = 0; ch < 256; ch++)
	{
		row = (ch >> 4) * HLCHAR_H;
		col = (ch & 15) * HLCHAR_W;

		for (y = 0; y < FONT_HEIGHT; y++)
		{
			for (x = 0; x < FONT_WIDTH; x++)
			{
				//the high half of quake's charset is the same glyphs in the
				//bright colour, and the kernel font has no such split
				if ((font[ch & 127] >> (y * 8)) & (1 << x))
					hl_conchars_synth[(row + y) * 128 + col + x] = ink;
			}
		}
	}
}

U0 HLWadInit()
{//globals aren't zeroed, clear first
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 count;
	I64	 table;
	I64	 pos;
	I64	 dsize;
	I64	 i;

	for (i = 0; i < HLWAD_MAX_LUMPS; i++)
	{
		hl_wad_lumps[i].name[0] = 0;
		hl_wad_lumps[i].data    = NULL;
		hl_wad_lumps[i].size    = 0;
	}

	hl_wad_count  = 0;
	hl_conchars   = NULL;
	hl_wad_ready  = FALSE;

	//always have a font, whatever the archive turns out to hold
	HLWadSynthConchars;
	hl_conchars = hl_conchars_synth;

	//HL's gfx.wad is WAD3. the directory layout is identical, only the lump
	//bodies differ, so indexing it costs nothing and HLWadPic's own header
	//checks reject anything it cannot read
	d = HLFileData("gfx.wad", &size);
	if (!d || size < 12 ||
		(MemCompare(d, "WAD2", 4) && MemCompare(d, "WAD3", 4)))
	{
		"HLWad: no gfx.wad, using the kernel font for text\n";
		return;
	}

	count = HLRdI32(d + 4);
	table = HLRdI32(d + 8);

	if (count < 1 || table < 0 || table + count * 32 > size)
	{
		"HLWad: gfx.wad directory is out of range\n";
		return;
	}

	for (i = 0; i < count && hl_wad_count < HLWAD_MAX_LUMPS; i++)
	{
		rec   = d + table + i * 32;
		pos   = HLRdI32(rec);
		dsize = HLRdI32(rec + 4);

		if (pos < 0 || pos + dsize > size)
			goto qw_next;

		HLRdName(rec + 16, hl_wad_lumps[hl_wad_count].name, 17);
		hl_wad_lumps[hl_wad_count].data = d + pos;
		hl_wad_lumps[hl_wad_count].size = dsize;

		//quake's CONCHARS is raw 128x128 with no header, so its size is the
		//test. HL's is a WAD3 font lump and will not match - the synthesised
		//atlas stays in place for it
		if (!StrICompare(hl_wad_lumps[hl_wad_count].name, "CONCHARS") &&
			dsize >= 128 * 128)
			hl_conchars = d + pos;

		hl_wad_count++;

qw_next:
	}

	hl_wad_ready = TRUE;
}

Bool HLWadPic(U8 *name, CHLPic *out)
{//Draw_PicFromWad
	I64 i;

	out->width   = 0;
	out->height  = 0;
	out->pixels  = NULL;
	out->palette = NULL;

	for (i = 0; i < hl_wad_count; i++)
	{
		if (!StrICompare(hl_wad_lumps[i].name, name))
		{
			if (hl_wad_lumps[i].size < 8)
				return FALSE;

			out->width  = HLRdI32(hl_wad_lumps[i].data);
			out->height = HLRdI32(hl_wad_lumps[i].data + 4);
			out->pixels = hl_wad_lumps[i].data + 8;

			if (out->width < 1 || out->height < 1 ||
				out->width * out->height + 8 > hl_wad_lumps[i].size)
			{
				out->pixels  = NULL;
				out->palette = NULL;
				return FALSE;
			}

			HLPicReadPalette(out, hl_wad_lumps[i].data,
				hl_wad_lumps[i].size);

			return TRUE;
		}
	}

	return FALSE;
}

Bool HLPicLoad(U8 *path, CHLPic *out)
{//Draw_CachePic - standalone gfx/*.lmp
	U8	*d;
	I64	 size = 0;

	out->width   = 0;
	out->height  = 0;
	out->pixels  = NULL;
	out->palette = NULL;

	d = HLFileData(path, &size);
	if (!d || size < 8)
		return FALSE;

	out->width  = HLRdI32(d);
	out->height = HLRdI32(d + 4);
	out->pixels = d + 8;

	if (out->width < 1 || out->height < 1 ||
		out->width * out->height + 8 > size)
	{
		out->pixels  = NULL;
		out->palette = NULL;
		return FALSE;
	}

	HLPicReadPalette(out, d, size);

	return TRUE;
}

U0 HLPicDrawFillPart(CHLCanvas *c, CHLPic *pic, I64 height)
{//stretch to canvas width but only height rows, sampling the bottom of the
 //source so the lower edges line up - the console dropping down
	U8	*src;
	U32	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (height > c->height)
		height = c->height;
	if (height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / height;

	sy_fp = 0;
	for (py = 0; py < height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = HLPicColor(pic, src[sx_fp >> 16]);
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 HLPicDrawFill(CHLCanvas *c, CHLPic *pic)
{//stretch over the whole canvas
 //
 //menu art is 320x200 and the target can be any size, drawing it native left
 //the rest of the screen black
 //
 //16.16 fixed point, nearest sample - no filtering, keeps the look
 //16.16 fixed point stepping, nearest sample - no filtering, to keep the look.
	U8	*src;
	U32	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / c->height;

	sy_fp = 0;
	for (py = 0; py < c->height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = HLPicColor(pic, src[sx_fp >> 16]);
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 HLPicTile(CHLCanvas *c, CHLPic *pic, I64 x, I64 y, I64 w, I64 h)
{//Draw_TileClear - aligned to the screen, not the rect, so adjacent calls
 //line up seamlessly
	U32	*row;
	U8	*src;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (x < 0)			{ w += x; x = 0; }
	if (y < 0)			{ h += y; y = 0; }
	if (x + w > c->width)	w = c->width - x;
	if (y + h > c->height)	h = c->height - y;

	if (w < 1 || h < 1)
		return;

	for (py = y; py < y + h; py++)
	{
		row = c->pixels + py * c->width;
		sy  = py % pic->height;
		src = pic->pixels + sy * pic->width;

		for (px = x; px < x + w; px++)
		{
			sx = px % pic->width;
			row[px] = HLPicColor(pic, src[sx]);
		}
	}
}

U0 HLPicDraw(CHLCanvas *c, CHLPic *pic, I64 x, I64 y)
{//Draw_Pic - index 255 transparent, no depth test, always on top
	U8	*src;
	U32	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qp_next_row;

		src = pic->pixels + sy * pic->width;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < pic->width; sx++)
		{
			px = x + sx;
			if (px < 0 || px >= c->width)
				goto qp_next_col;

			texel = src[sx];
			if (texel != HLPIC_TRANSPARENT)
				dst[px] = HLPicColor(pic, texel);

qp_next_col:
		}

qp_next_row:
	}
}

U0 HLPicDrawPart(CHLCanvas *c, CHLPic *pic, I64 x, I64 y, I64 sub_x, I64 sub_w)
{//Draw_TransPicTranslate - the status bar is cut out of the 320-wide SBAR
 //and IBAR strips, so the source stride stays the full picture width
	U8	*src;
	U32	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels || sub_w < 1)
		return;

	if (sub_x < 0)
		sub_x = 0;
	if (sub_x + sub_w > pic->width)
		sub_w = pic->width - sub_x;
	if (sub_w < 1)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qpp_next_row;

		src = pic->pixels + sy * pic->width + sub_x;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < sub_w; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel != HLPIC_TRANSPARENT)
					dst[px] = HLPicColor(pic, texel);
			}
		}

qpp_next_row:
	}
}

U0 HLCharDraw(CHLCanvas *c, I64 x, I64 y, I64 ch)
{//Draw_Character - 16x16 grid, index 0 transparent so text sits over the
 //world without a box behind it
	U8	*src;
	U32	*dst;
	I64	 row;
	I64	 col;
	I64	 sx;
	I64	 sy;
	I64	 py;
	I64	 px;
	U8	 texel;

	//only 32 is skipped - CONCHARS carries real glyphs below it, the small gold
	//digits at 18..27 that the inventory bar ammo counts use, plus menu arrows
	if (!hl_conchars || ch == 32 || ch < 0)
		return;

	ch &= 255;
	row = (ch >> 4) * HLCHAR_H;
	col = (ch & 15) * HLCHAR_W;

	for (sy = 0; sy < HLCHAR_H; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qc_next_row;

		src = hl_conchars + (row + sy) * 128 + col;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < HLCHAR_W; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel)
					dst[px] = HLPalColor(texel);
			}
		}

qc_next_row:
	}
}

U0 HLStrDraw(CHLCanvas *c, I64 x, I64 y, U8 *s)
{
	I64 i = 0;

	while (s[i])
	{
		HLCharDraw(c, x + i * HLCHAR_W, y, s[i]);
		i++;
	}
}

U0 HLStrDrawAlt(CHLCanvas *c, I64 x, I64 y, U8 *s)
{//M_Print - every character with 128 added
 //
 //CONCHARS holds two 128-glyph sets, plain for the console and gold in the
 //upper half, M_PrintWhite is the exception
	I64 i = 0;

	while (s[i])
	{
		HLCharDraw(c, x + i * HLCHAR_W, y, s[i] + 128);
		i++;
	}
}

U0 HLStrDrawCenter(CHLCanvas *c, I64 y, U8 *s)
{
	HLStrDraw(c, (c->width - StrLen(s) * HLCHAR_W) / 2, y, s);
}

U0 HLStrDrawCenterAlt(CHLCanvas *c, I64 y, U8 *s)
{
	HLStrDrawAlt(c, (c->width - StrLen(s) * HLCHAR_W) / 2, y, s);
}
