// alias model (.mdl) loading and drawing
//
// layout, all little-endian:
//   header       84 bytes - "IDPO", version 6, scale/translate, skin size,
//                vertex/triangle/frame counts
//   skins        one raw skin_w*skin_h image, or a group of them
//   texcoords    per vertex - onseam, s, t in skin pixels
//   triangles    per triangle - faces-front flag, three vertex indices
//   frames       per frame - bounds, 16-char name, one packed vertex each
//
// vertices are 3 bytes plus a normal index, unpacked as scale*v + translate

#define HLMDL_MAGIC		0x4F504449	//"IDPO" little-endian
#define HLMDL_VERSION	6
#define HLMDL_MAX_TRIS	4096

class CHLMdlTexCoord
{
	I64	on_seam;
	I64	s;
	I64	t;
};

class CHLMdlTri
{
	I64	faces_front;
	I64	vert[3];
};

#define HLMDL_MAX_POSES	16

class CHLMdlFrame
{
	U8	 name[16];
	U8	*verts;					//pose 0, borrowed from the file buffer
	U8	*poses[HLMDL_MAX_POSES];
	I64	 num_poses;
	F64	 interval;				//seconds per pose
};

//the .mdl header flags word at offset 76. Distinct from the HLEF_ entity
//effects in HLGame.ZC: id names both sets EF_ (modelgen.h and quakedef.h) and
//the values collide; EF_ROTATE and EF_DIMLIGHT are both 8
#define HLMDLF_ROCKET		1
#define HLMDLF_GRENADE		2
#define HLMDLF_GIB			4
#define HLMDLF_ROTATE		8
#define HLMDLF_TRACER		16
#define HLMDLF_ZOMGIB		32
#define HLMDLF_TRACER2		64
#define HLMDLF_TRACER3		128

class CHLMdl
{
	U8				*raw;
	I64				 raw_size;

	F64				 scale[3];
	F64				 translate[3];

	I64				 skin_width;
	I64				 skin_height;
	I64				 num_skins;
	I64				 num_verts;
	I64				 num_tris;
	I64				 num_frames;
	I64				 flags;		//EF_ bits at offset 76, the trail type

	CHLMdlTexCoord	*tc;
	CHLMdlTri		*tris;
	CHLMdlFrame		*frames;

	CHLTexture		 skin;
};

U0 HLMdlFree(CHLMdl *m)
{
	if (!m)
		return;

	if (m->tc)		Free(m->tc);
	if (m->tris)	Free(m->tris);
	if (m->frames)	Free(m->frames);
	if (m->raw)		Free(m->raw);

	Free(m);
}

CHLMdl *HLMdlLoad(U8 *name)
{
	CHLMdl	*m;
	U8		*d;
	I64		 size = 0;
	I64		 p;
	I64		 i;
	I64		 j;
	I64		 group;
	I64		 sub;
	I64		 skin_bytes;

	d = HLFileLoad(name, &size);
	if (!d)
	{
		"HLMdl: %s not found\n", name;
		return NULL;
	}

	if (size < 84 || HLRdU32(d) != HLMDL_MAGIC || HLRdI32(d + 4) != HLMDL_VERSION)
	{
		"HLMdl: %s is not an IDPO version 6 model\n", name;
		Free(d);
		return NULL;
	}

	m           = CAlloc(sizeof(CHLMdl));
	m->raw      = d;
	m->raw_size = size;

	HLRdVec(d + 8, m->scale);
	HLRdVec(d + 20, m->translate);

	m->num_skins   = HLRdI32(d + 48);
	m->skin_width  = HLRdI32(d + 52);
	m->skin_height = HLRdI32(d + 56);
	m->num_verts   = HLRdI32(d + 60);
	m->num_tris    = HLRdI32(d + 64);
	m->num_frames  = HLRdI32(d + 68);

	m->flags       = HLRdI32(d + 76);

	if (m->num_verts <= 0 || m->num_tris <= 0 || m->num_frames <= 0 ||
		m->skin_width <= 0 || m->skin_height <= 0)
	{
		"HLMdl: %s has degenerate counts\n", name;
		HLMdlFree(m);
		return NULL;
	}

	skin_bytes = m->skin_width * m->skin_height;
	p          = 84;

	for (i = 0; i < m->num_skins; i++)
	{
		if (p + 4 > size)
		{
			HLMdlFree(m);
			return NULL;
		}

		group = HLRdI32(d + p);
		p += 4;

		if (group)
		{
			//skin group: count, per-skin intervals, then the images
			sub = HLRdI32(d + p);
			p += 4 + sub * 4;
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += sub * skin_bytes;
		}
		else
		{
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += skin_bytes;
		}
	}

	m->skin.width  = m->skin_width;
	m->skin.height = m->skin_height;
	m->skin.clamp  = TRUE;		//skins are not power-of-two and never tile

	//IDPO skins index gfx/palette.lmp and carry no palette of their own
	m->skin.palette = hl_pal_rgb;

	HLRdName(name, m->skin.name, 16);

	if (!m->skin.texels[0])
	{
		"HLMdl: %s has no usable skin\n", name;
		HLMdlFree(m);
		return NULL;
	}

	if (p + m->num_verts * 12 > size)
	{
		HLMdlFree(m);
		return NULL;
	}

	m->tc = CAlloc(m->num_verts * sizeof(CHLMdlTexCoord));
	for (i = 0; i < m->num_verts; i++)
	{
		m->tc[i].on_seam = HLRdI32(d + p);
		m->tc[i].s       = HLRdI32(d + p + 4);
		m->tc[i].t       = HLRdI32(d + p + 8);
		p += 12;
	}

	if (p + m->num_tris * 16 > size)
	{
		HLMdlFree(m);
		return NULL;
	}

	m->tris = CAlloc(m->num_tris * sizeof(CHLMdlTri));
	for (i = 0; i < m->num_tris; i++)
	{
		m->tris[i].faces_front = HLRdI32(d + p);
		for (j = 0; j < 3; j++)
			m->tris[i].vert[j] = HLRdI32(d + p + 4 + j * 4);
		p += 16;
	}

	m->frames = CAlloc(m->num_frames * sizeof(CHLMdlFrame));
	for (i = 0; i < m->num_frames; i++)
	{
		if (p + 4 > size)
			break;

		group = HLRdI32(d + p);
		p += 4;

		if (group)
		{
			//group: count, bounds (two 8-byte verts), one interval per
			//pose, then the poses
			sub = HLRdI32(d + p);
			p += 4 + 8;

			//file intervals are cumulative; the first is the per-pose period
			if (sub > 0 && p + 4 <= size)
				m->frames[i].interval = HLRdF32(d + p);

			if (m->frames[i].interval <= 0.0)
				m->frames[i].interval = 0.1;

			p += sub * 4;

			for (j = 0; j < sub; j++)
			{
				if (p + 24 + m->num_verts * 4 > size)
					break;

				if (j == 0)
				{
					HLRdName(d + p + 8, m->frames[i].name, 16);
					m->frames[i].verts = d + p + 24;
				}

				if (j < HLMDL_MAX_POSES)
				{
					m->frames[i].poses[j] = d + p + 24;
					m->frames[i].num_poses = j + 1;
				}

				p += 24 + m->num_verts * 4;
			}
		}
		else
		{
			if (p + 24 + m->num_verts * 4 > size)
				break;

			HLRdName(d + p + 8, m->frames[i].name, 16);
			m->frames[i].verts     = d + p + 24;
			m->frames[i].poses[0]  = d + p + 24;
			m->frames[i].num_poses = 1;
			m->frames[i].interval  = 0.1;
			p += 24 + m->num_verts * 4;
		}
	}

	return m;
}


//the cache owns what it hands out; only HLMdlCacheFree frees it

#define HLMDL_CACHE_MAX	256
#define HLMDL_NAME_MAX	64

U8		hl_mdl_cache_name[HLMDL_CACHE_MAX * HLMDL_NAME_MAX];
CHLMdl  *hl_mdl_cache_mdl[HLMDL_CACHE_MAX];
I64		hl_mdl_cache_count = 0;

U0 HLMdlCacheInit()
{//globals are not zeroed
	I64 i;

	for (i = 0; i < HLMDL_CACHE_MAX; i++)
	{
		hl_mdl_cache_mdl[i]                    = NULL;
		hl_mdl_cache_name[i * HLMDL_NAME_MAX]   = 0;
	}

	hl_mdl_cache_count = 0;
}

CHLMdl *HLMdlCacheGet(U8 *name)
{
	I64 i;
	U8 *slot;

	if (!name || !name[0])
		return NULL;

	for (i = 0; i < hl_mdl_cache_count; i++)
	{
		if (!StrICompare(&hl_mdl_cache_name[i * HLMDL_NAME_MAX], name))
			return hl_mdl_cache_mdl[i];
	}

	if (hl_mdl_cache_count >= HLMDL_CACHE_MAX)
		return HLMdlLoad(name);	//cache full, return an owned copy

	i    = hl_mdl_cache_count;
	slot = &hl_mdl_cache_name[i * HLMDL_NAME_MAX];

	HLStrCopy(slot, name, HLMDL_NAME_MAX);
	hl_mdl_cache_mdl[i] = HLMdlLoad(name);
	hl_mdl_cache_count++;

	return hl_mdl_cache_mdl[i];
}

U0 HLMdlCacheFree()
{//nothing else may free cached models
	I64 i;

	for (i = 0; i < hl_mdl_cache_count; i++)
	{
		if (hl_mdl_cache_mdl[i])
			HLMdlFree(hl_mdl_cache_mdl[i]);
		hl_mdl_cache_mdl[i] = NULL;
	}

	hl_mdl_cache_count = 0;
}

I64 HLMdlFrameByName(CHLMdl *m, U8 *name)
{
	I64 i;

	for (i = 0; i < m->num_frames; i++)
	{
		if (!StrICompare(m->frames[i].name, name))
			return i;
	}

	return -1;
}

U8 *HLMdlPoseVerts(CHLMdlFrame *fr, F64 time)
{//R_SetupAliasFrame pose pick:
 //    pose += (int)(cl.time / interval) % numposes;
	I64 pose;

	if (!fr)
		return NULL;

	if (fr->num_poses <= 1 || fr->interval <= 0.0)
		return fr->verts;

	pose = ToI64(time / fr->interval) % fr->num_poses;
	if (pose < 0)
		pose += fr->num_poses;

	if (!fr->poses[pose])
		return fr->verts;

	return fr->poses[pose];
}

U0 HLMdlDrawView(CHLCanvas *c, CHLMdl *m, I64 frame, F64 fwd, F64 rgt, F64 up,
	F64 scale, I64 light, F64 depth_bias = 1.0)
{//view models use the world axes (x fwd, y left, z up) at the origin:
 //   camera x (right)   = -model y
 //   camera y (up)      =  model z
 //   camera z (forward) =  model x
	CHLMdlFrame		*fr;
	U8				*verts;
	CHLMdlTri		*tri;
	CHLPolyVert		 poly[3];
	CHLPolyVert		 clipped[HLMAX_POLY_VERTS];
	CHLScreenVert	 scr[HLMAX_POLY_VERTS];
	U8				*vp;
	F64				 local[3];
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = HLMdlPoseVerts(fr, hl_light_time);
	if (!verts)
		return;

	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				valid = FALSE;
				break;
			}

			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			poly[j].cam[0] = -local[1] * scale + rgt;
			poly[j].cam[1] =  local[2] * scale + up;
			poly[j].cam[2] =  local[0] * scale + fwd;

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;
			poly[j].light = ToF64(light);
		}

		if (!valid)
			goto qvm_next;

		count = HLDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];

				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;

				//equivalent to GLQuake's glDepthRange(0, 0.3). s_over_z and
				//t_over_z scale by the same factor; the rasterizer recovers
				//s as s_over_z/inv_z
				inv_z *= depth_bias;

				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
				scr[j].light    = clipped[j].light;
			}

			HLDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qvm_next:
	}
}

// CL_NewTranslation. A player skin reserves two 16-entry palette ranges, 16-31
// shirt and 96-111 trousers, remapped in a private copy of the skin.

#define HLTOP_RANGE		16
#define HLBOTTOM_RANGE	96

U0 HLMdlTranslation(I64 top, I64 bottom, U8 *table)
{
	I64 i;

	for (i = 0; i < 256; i++)
		table[i] = i;

	//colours are 0-13, each naming a 16-entry block
	top    = (top & 15) << 4;
	bottom = (bottom & 15) << 4;

	for (i = 0; i < 16; i++)
	{
		//the upper half of the palette runs bright-to-dark; those blocks reverse
		if (top < 128)
			table[HLTOP_RANGE + i] = top + i;
		else
			table[HLTOP_RANGE + i] = top + 15 - i;

		if (bottom < 128)
			table[HLBOTTOM_RANGE + i] = bottom + i;
		else
			table[HLBOTTOM_RANGE + i] = bottom + 15 - i;
	}
}

CHLMdl *hl_mdl_preview		= NULL;
U8    *hl_mdl_preview_skin	= NULL;	//the private, translated copy
U8    *hl_mdl_preview_src	= NULL;	//the untouched skin in the file buffer
I64    hl_mdl_preview_top	= -1;
I64    hl_mdl_preview_bottom	= -1;

CHLMdl *HLMdlPreviewGet(I64 top, I64 bottom)
{
	U8	table[256];
	I64	bytes;
	I64	i;

	if (!hl_mdl_preview)
	{
		hl_mdl_preview = HLMdlLoad("progs/player.mdl");
		if (!hl_mdl_preview)
			return NULL;

		bytes = hl_mdl_preview->skin_width * hl_mdl_preview->skin_height;

		hl_mdl_preview_src  = hl_mdl_preview->skin.texels[0];
		hl_mdl_preview_skin = MAlloc(bytes);

		if (!hl_mdl_preview_src)
		{
			HLMdlFree(hl_mdl_preview);
			hl_mdl_preview = NULL;
			return NULL;
		}

		MemCopy(hl_mdl_preview_skin, hl_mdl_preview_src, bytes);

		hl_mdl_preview->skin.texels[0] = hl_mdl_preview_skin;
	}

	if (top == hl_mdl_preview_top && bottom == hl_mdl_preview_bottom)
		return hl_mdl_preview;

	HLMdlTranslation(top, bottom, table);

	bytes = hl_mdl_preview->skin_width * hl_mdl_preview->skin_height;

	//translate from the original skin, never the copy
	for (i = 0; i < bytes; i++)
		hl_mdl_preview_skin[i] = table[hl_mdl_preview_src[i]];

	hl_mdl_preview_top    = top;
	hl_mdl_preview_bottom = bottom;

	return hl_mdl_preview;
}

U0 HLMdlPreviewFree()
{//the private skin is freed here, the raw buffer by HLMdlFree
	if (hl_mdl_preview)
	{
		//restore the borrowed pointer before HLMdlFree
		hl_mdl_preview->skin.texels[0] = hl_mdl_preview_src;
		HLMdlFree(hl_mdl_preview);
	}

	if (hl_mdl_preview_skin)
		Free(hl_mdl_preview_skin);

	hl_mdl_preview        = NULL;
	hl_mdl_preview_skin   = NULL;
	hl_mdl_preview_src    = NULL;
	hl_mdl_preview_top    = -1;
	hl_mdl_preview_bottom = -1;
}

U0 HLMdlDrawAngles(CHLCanvas *c, CHLMdl *m, I64 frame, F64 *origin, F64 *angles,
	I64 light)
{//model pitch is inverted, as in the original's alias transform; model y points
 //left, hence the minus on right
	CHLMdlFrame		*fr;
	U8				*verts;
	CHLMdlTri		*tri;
	CHLPolyVert		 poly[3];
	CHLPolyVert		 clipped[HLMAX_POLY_VERTS];
	CHLScreenVert	 scr[HLMAX_POLY_VERTS];
	U8				*vp;
	F64				 mang[3];
	F64				 fwd[3];
	F64				 rgt[3];
	F64				 upv[3];
	F64				 world[3];
	F64				 local[3];
	F64				 rel[3];
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = HLMdlPoseVerts(fr, hl_light_time);
	if (!verts)
		return;

	mang[0] = -angles[0];
	mang[1] =  angles[1];
	mang[2] =  angles[2];
	HLAngleVectors(mang, fwd, rgt, upv);

	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				valid = FALSE;
				break;
			}

			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			world[0] = origin[0] + local[0] * fwd[0] - local[1] * rgt[0] +
				local[2] * upv[0];
			world[1] = origin[1] + local[0] * fwd[1] - local[1] * rgt[1] +
				local[2] * upv[1];
			world[2] = origin[2] + local[0] * fwd[2] - local[1] * rgt[2] +
				local[2] * upv[2];

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;
			poly[j].light = ToF64(light);

			HLVecSub(world, c->origin, rel);
			poly[j].cam[0] = HLVecDot(rel, c->right);
			poly[j].cam[1] = HLVecDot(rel, c->up);
			poly[j].cam[2] = HLVecDot(rel, c->forward);
		}

		if (!valid)
			goto qma_next;

		count = HLDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
				scr[j].light    = clipped[j].light;
			}

			HLDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qma_next:
	}
}

U0 HLMdlDraw(CHLCanvas *c, CHLMdl *m, I64 frame, F64 *origin, F64 yaw,
	I64 light)
{
	CHLMdlFrame		*fr;
	U8				*verts;
	CHLMdlTri		*tri;
	CHLPolyVert		 poly[3];
	CHLPolyVert		 clipped[HLMAX_POLY_VERTS];
	CHLScreenVert	 scr[HLMAX_POLY_VERTS];
	U8				*vp;
	F64				 world[3];
	F64				 local[3];
	F64				 rel[3];
	F64				 sy;
	F64				 cy;
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr    = &m->frames[frame];
	verts = HLMdlPoseVerts(fr, hl_light_time);
	if (!verts)
		return;

	sy        = Sin(yaw * HLDEG2RAD);
	cy        = Cos(yaw * HLDEG2RAD);
	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				valid = FALSE;
				break;
			}

			//unpack: three bytes scaled and offset by the header pair
			vp       = verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			world[0] = local[0] * cy - local[1] * sy + origin[0];
			world[1] = local[0] * sy + local[1] * cy + origin[1];
			world[2] = local[2] + origin[2];

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			//back-facing tris on a seam vertex read the right half of the skin
			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;
			poly[j].light = ToF64(light);

			HLVecSub(world, c->origin, rel);
			poly[j].cam[0] = HLVecDot(rel, c->right);
			poly[j].cam[1] = HLVecDot(rel, c->up);
			poly[j].cam[2] = HLVecDot(rel, c->forward);
		}

		if (!valid)
			goto qm_next;

		count = HLDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
				scr[j].light    = clipped[j].light;
			}

			HLDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light, 0);
		}

qm_next:
	}
}
