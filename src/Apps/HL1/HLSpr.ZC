// HLSpr.ZC - IDSP sprite models.
//
// Third model class after brush and alias. Carries the effects with no geometry:
// explosion fireball (progs/s_explod.spr), bubbles, glows.
//
// 36-byte header then one record per frame:
//
//     "IDSP", version 1, type, boundingradius, maxwidth, maxheight,
//     numframes, beamlength, synctype
//
//     per frame: group flag; then origin[2], width, height and width*height
//     palette indices. A group carries a count and intervals first.
//
// Palette index 255 is transparent. A sprite is a rect with most of it cut away,
// and the cutout is the shape.

#define HLSPR_MAX_FRAMES	64
#define HLSPR_TRANSPARENT	255

//SPR version. Quake shipped 1; every Half-Life sprite is 2. The structural
//difference is a palette between the header and the frames
#define HLSPR_VERSION_Q		1
#define HLSPR_VERSION_HL		2

//texFormat, the word version 2 added. Selects how a texel reaches the screen
#define HLSPR_NORMAL			0	//index 255 is the cutout
#define HLSPR_ADDITIVE		1	//added to what is behind it
#define HLSPR_INDEXALPHA		2	//index is the alpha, palette[255] the colour
#define HLSPR_ALPHATEST		3	//index 255 cut, the rest opaque

//type, the orientation the quad is built with. Version 1 carries it too; only
//VP_PARALLEL was handled here, which is why a decal or a beam laid flat came
//out facing the camera
#define HLSPR_VP_PARALLEL_UPRIGHT	0	//up is world Z, right faces the viewer
#define HLSPR_FACING_UPRIGHT		1	//up is world Z, right across the sightline
#define HLSPR_VP_PARALLEL			2	//flat on, both axes from the view basis
#define HLSPR_ORIENTED				3	//the entity's own basis, a wall decal
#define HLSPR_VP_PARALLEL_ORIENTED	4	//flat on, rolled about the sightline

//two axes within a degree of parallel give a degenerate cross product, so an
//upright sprite is dropped when the sightline is that close to vertical
#define HLSPR_UPRIGHT_LIMIT	0.999848	//cos(1 degree)

class CHLSprFrame
{
	I64	 origin_x;		//texel offset from centre
	I64	 origin_y;
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from raw
};

class CHLSpr
{
	U8			 name[64];
	U8			*raw;			//owned
	I64			 version;
	I64			 type;
	I64			 tex_format;	//HLSPR_*, v2 only
	I64			 max_width;
	I64			 max_height;
	I64			 num_frames;
	F64			 interval;		//seconds per frame, grouped sprites
	U8			*palette;		//v2 carries its own; NULL means the global one
	CHLSprFrame	 frames[HLSPR_MAX_FRAMES];
};

U32 HLSprColor(CHLSpr *sp, I64 texel)
{//one texel to 0x00RRGGBB through the applicable palette
	texel &= 255;

	if (!sp->palette)
		return HLPalColor(texel);

	return (sp->palette[texel * 3] << 16) |
		   (sp->palette[texel * 3 + 1] << 8) |
			sp->palette[texel * 3 + 2];
}

Bool HLSprTexelVisible(CHLSpr *sp, I64 texel)
{//whether a texel draws at all
 //
 //INDEXALPHA sprites are monochrome masks: the index is coverage, so 0 is fully
 //transparent and anything above it shows. Every other format cuts on the last
 //palette entry
	if (sp->tex_format == HLSPR_INDEXALPHA)
		return ToBool(texel != 0);

	return ToBool(texel != HLSPR_TRANSPARENT);
}

U0 HLSprPutPixel(CHLSpr *sp, U32 *row, I64 x, I64 texel, I64 light,
	I64 shade)
{//one visible texel to the framebuffer through the sprite's blend mode
 //
 //ADDITIVE and INDEXALPHA read what is already there. Every glow, beam and
 //light cone in HL is one of the two
	I64	r;
	I64	g;
	I64	b;
	U32	c32;
	U32	dst;

	if (sp->palette)
	{
		//v2 carries its own colours, so the global colormap is the wrong
		//shading table. Shade the RGB directly
		//
		//INDEXALPHA is a mask: the index is coverage and palette[255] the
		//colour it draws in
		if (sp->tex_format == HLSPR_INDEXALPHA)
			c32 = HLSprColor(sp, 255);
		else
			c32 = HLSprColor(sp, texel);

		//fully parenthesised against ZealC precedence: the shifts apply
		//before the scale, not inside it
		r = (((c32 >> 16) & 255) * light) / 255;
		g = (((c32 >> 8) & 255) * light) / 255;
		b = ((c32 & 255) * light) / 255;

		if (sp->tex_format == HLSPR_INDEXALPHA)
		{
			r = (r * texel) / 255;
			g = (g * texel) / 255;
			b = (b * texel) / 255;
		}

		if (sp->tex_format == HLSPR_ADDITIVE ||
			sp->tex_format == HLSPR_INDEXALPHA)
		{
			dst = row[x];

			r += (dst >> 16) & 255;
			g += (dst >> 8) & 255;
			b += dst & 255;

			if (r > 255)	r = 255;
			if (g > 255)	g = 255;
			if (b > 255)	b = 255;
		}

		row[x] = (r << 16) | (g << 8) | b;
	}
	else if (texel >= HLPAL_FULLBRIGHT)
		row[x] = HLPalColor(texel);
	else
		row[x] = HLPalColor(hl_pal_colormap[shade * HLPAL_COLORS + texel]);
}

CHLSpr *HLSprLoad(U8 *name)
{//load one sprite from the paks
	CHLSpr	*sp;
	U8		*d;
	I64		 size = 0;
	I64		 p;
	I64		 i;
	I64		 group;
	I64		 sub;
	I64		 w;
	I64		 h;

	d = HLFileLoad(name, &size);
	if (!d || size < 36)
	{
		if (d)
			Free(d);
		return NULL;
	}

	if (d[0] != 'I' || d[1] != 'D' || d[2] != 'S' || d[3] != 'P')
	{
		Free(d);
		return NULL;
	}

	sp = CAlloc(sizeof(CHLSpr));
	sp->raw = d;
	HLStrCopy(sp->name, name, 64);

	sp->version = HLRdI32(d + 4);

	if (sp->version != HLSPR_VERSION_Q && sp->version != HLSPR_VERSION_HL)
	{
		"HLSpr: %s is version %d, expected 1 or 2\n", name, sp->version;
		Free(d);
		Free(sp);
		return NULL;
	}

	//version 2 inserts texFormat after type, shifting every later field by four
	//bytes. The wrong layout puts the frame offsets inside the texels
	if (sp->version == HLSPR_VERSION_HL)
	{
		sp->type       = HLRdI32(d + 8);
		sp->tex_format = HLRdI32(d + 12);
		sp->max_width  = HLRdI32(d + 20);
		sp->max_height = HLRdI32(d + 24);
		sp->num_frames = HLRdI32(d + 28);
		p              = 40;
	}
	else
	{
		sp->type       = HLRdI32(d + 8);
		sp->tex_format = HLSPR_NORMAL;
		sp->max_width  = HLRdI32(d + 16);
		sp->max_height = HLRdI32(d + 20);
		sp->num_frames = HLRdI32(d + 24);
		p              = 36;
	}

	sp->interval = 0.1;
	sp->palette  = NULL;

	if (sp->num_frames < 1 || sp->num_frames > HLSPR_MAX_FRAMES)
	{
		Free(d);
		Free(sp);
		return NULL;
	}

	//v2: u16 colour count then count*3 RGB, before the first frame
	if (sp->version == HLSPR_VERSION_HL)
	{
		I64 colors;

		if (p + 2 > size)
		{
			Free(d);
			Free(sp);
			return NULL;
		}

		colors = HLRdU16(d + p);
		p += 2;

		if (colors > 0 && p + colors * 3 <= size)
		{
			sp->palette = d + p;
			p += colors * 3;
		}
	}

	for (i = 0; i < sp->num_frames; i++)
	{
		if (p + 4 > size)
			break;

		group = HLRdI32(d + p);
		p += 4;

		//groups carry their own count and interval table. Only subframe 0 is
		//kept; s_explod.spr is a plain sequence driven by QuakeC .frame
		if (group)
		{
			if (p + 4 > size)
				break;

			sub = HLRdI32(d + p);
			p += 4;

			if (sub > 0 && p + 4 <= size)
				sp->interval = HLRdF32(d + p);

			if (sp->interval <= 0.0)
				sp->interval = 0.1;

			p += sub * 4;
		}

		if (p + 16 > size)
			break;

		sp->frames[i].origin_x = HLRdI32(d + p);
		sp->frames[i].origin_y = HLRdI32(d + p + 4);
		w = HLRdI32(d + p + 8);
		h = HLRdI32(d + p + 12);
		p += 16;

		if (w < 1 || h < 1 || p + w * h > size)
			break;

		sp->frames[i].width  = w;
		sp->frames[i].height = h;
		sp->frames[i].pixels = d + p;

		p += w * h;
	}

	return sp;
}

U0 HLSprDrawRect(CHLCanvas *c, CHLSpr *sp, I64 frame,
	I64 dst_x, I64 dst_y, I64 src_x, I64 src_y, I64 sw, I64 sh,
	I64 tint_r, I64 tint_g, I64 tint_b)
{//screen space blit of a sub-rectangle, for the HUD
 //
 //HL HUD art is one sprite sheet per resolution and sprites/hud.txt names a
 //rect inside it per element, so this takes a rect rather than a frame
 //
 //texFormat selects the blend. HL's HUD sheets are additive and authored
 //light-on-black; drawn opaque, every number sits in a black box
	CHLSprFrame	*fr;
	U32			*row;
	I64			 x, y;
	I64			 tx, ty;
	I64			 texel;
	I64			 r, g, b;
	I64			 dr, dg, db;
	U32			 c32;

	if (!c || !sp || frame < 0 || frame >= sp->num_frames)
		return;

	fr = &sp->frames[frame];

	if (!fr->pixels || sw < 1 || sh < 1)
		return;

	for (y = 0; y < sh; y++)
	{
		ty = src_y + y;

		if (ty < 0 || ty >= fr->height)
			goto qsdr_next_row;

		if (dst_y + y < 0 || dst_y + y >= c->height)
			goto qsdr_next_row;

		row = c->pixels + (dst_y + y) * c->width;

		for (x = 0; x < sw; x++)
		{
			tx = src_x + x;

			if (tx < 0 || tx >= fr->width)
				goto qsdr_next_col;
			if (dst_x + x < 0 || dst_x + x >= c->width)
				goto qsdr_next_col;

			texel = fr->pixels[ty * fr->width + tx];

			if (!HLSprTexelVisible(sp, texel))
				goto qsdr_next_col;

			//INDEXALPHA: the index is coverage and the colour comes from
			//the caller, which is how HL tints one sheet per element
			if (sp->tex_format == HLSPR_INDEXALPHA)
			{
				r = (tint_r * texel) / 255;
				g = (tint_g * texel) / 255;
				b = (tint_b * texel) / 255;
			}
			else
			{
				c32 = HLSprColor(sp, texel);

				r = (((c32 >> 16) & 255) * tint_r) / 255;
				g = (((c32 >> 8) & 255) * tint_g) / 255;
				b = ((c32 & 255) * tint_b) / 255;
			}

			if (sp->tex_format == HLSPR_ADDITIVE ||
				sp->tex_format == HLSPR_INDEXALPHA)
			{
				//add to what is already there, clamped per channel
				c32 = row[dst_x + x];

				dr = ((c32 >> 16) & 255) + r;
				dg = ((c32 >> 8) & 255) + g;
				db = (c32 & 255) + b;

				if (dr > 255)	dr = 255;
				if (dg > 255)	dg = 255;
				if (db > 255)	db = 255;

				r = dr;
				g = dg;
				b = db;
			}

			row[dst_x + x] = (r << 16) | (g << 8) | b;

qsdr_next_col:
		}

qsdr_next_row:
	}
}

U0 HLSprFree(CHLSpr *sp)
{
	if (!sp)
		return;

	if (sp->raw)
		Free(sp->raw);

	Free(sp);
}

U0 HLSprDraw(CHLCanvas *c, CHLSpr *sp, I64 frame, F64 *origin, I64 light)
{//R_DrawSpriteModel - camera-facing quad built from the view axes, not the
 //sprite's own. Always flat-on, so texels step in screen space and one 1/z
 //serves the whole quad
	CHLSprFrame	*fr;
	U32			*row;
	F64			*zrow;
	F64			 rel[3];
	F64			 cam_x;
	F64			 cam_y;
	F64			 cam_z;
	F64			 inv_z;
	F64			 sx;
	F64			 sy;
	F64			 half_w;
	F64			 half_h;
	I64			 x0, x1, y0, y1;
	I64			 x, y;
	I64			 tx, ty;
	I64			 texel;
	I64			 shade;

	if (!sp || frame < 0 || frame >= sp->num_frames)
		return;

	fr = &sp->frames[frame];
	if (!fr->pixels || fr->width < 1 || fr->height < 1)
		return;

	//to camera space, as in the world transform
	HLVecSub(origin, c->origin, rel);
	cam_x = HLVecDot(rel, c->right);
	cam_y = HLVecDot(rel, c->up);
	cam_z = HLVecDot(rel, c->forward);

	if (cam_z < 1.0)
		return;

	inv_z = 1.0 / cam_z;

	sx = c->center_x + cam_x * c->x_scale * inv_z;
	sy = c->center_y - cam_y * c->y_scale * inv_z;

	//frame origin is a texel offset from centre
	half_w = ToF64(fr->width) * 0.5 * c->x_scale * inv_z;
	half_h = ToF64(fr->height) * 0.5 * c->y_scale * inv_z;

	sx += ToF64(fr->origin_x + fr->width / 2) * c->x_scale * inv_z;
	sy -= ToF64(fr->origin_y - fr->height / 2) * c->y_scale * inv_z;

	x0 = ToI64(Ceil(sx - half_w));
	x1 = ToI64(Ceil(sx + half_w));
	y0 = ToI64(Ceil(sy - half_h));
	y1 = ToI64(Ceil(sy + half_h));

	if (x0 < c->vx)					x0 = c->vx;
	if (y0 < c->vy)					y0 = c->vy;
	if (x1 > c->vx + c->vw)			x1 = c->vx + c->vw;
	if (y1 > c->vy + c->vh)			y1 = c->vy + c->vh;

	if (x1 <= x0 || y1 <= y0)
		return;

	shade = ClampI64((255 - light) >> 2, 0, HLPAL_SHADES - 1);

	for (y = y0; y < y1; y++)
	{
		row  = c->pixels + y * c->width;
		zrow = c->depth + y * c->width;

		ty = ToI64((ToF64(y) - (sy - half_h)) / (half_h * 2.0) *
				ToF64(fr->height));
		ty = ClampI64(ty, 0, fr->height - 1);

		for (x = x0; x < x1; x++)
		{
			if (inv_z <= zrow[x])
				goto qsd_next;

			tx = ToI64((ToF64(x) - (sx - half_w)) / (half_w * 2.0) *
					ToF64(fr->width));
			tx = ClampI64(tx, 0, fr->width - 1);

			texel = fr->pixels[ty * fr->width + tx];

			if (!HLSprTexelVisible(sp, texel))
				goto qsd_next;

			HLSprPutPixel(sp, row, x, texel, light, shade);

			zrow[x] = inv_z;

qsd_next:
		}
	}
}
