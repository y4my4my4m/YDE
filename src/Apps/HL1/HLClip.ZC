// HLClip.ZC - entity-aware collision and player movement.
//
// needs the edict field table, so it sits after HLProgs
//   HLPhys - hull traces against the world BSP only
//   HLClip - the same plus every solid edict, and movement built on it
//
// from world.c (SV_Move and friends) and sv_phys/sv_user

//.solid values, here rather than HLGame - collision runs earlier in the
//include order
#define HLSOLID_NOT_			0
#define HLSOLID_TRIGGER_		1
#define HLSOLID_BBOX_		2
#define HLSOLID_SLIDEBOX_	3
#define HLSOLID_BSP_			4

//precache index -> BSP brush model number
//
// .modelindex indexes the precache list, not map->models: the world is precache
// slot 1 but BSP model 0. -1 = not a brush model.
#define HLCLIP_MAX_PRECACHE	1024

I64 hl_precache_bmodel[HLCLIP_MAX_PRECACHE];

U0 HLClipPrecacheReset()
{//globals aren't zeroed
	I64 i;

	for (i = 0; i < HLCLIP_MAX_PRECACHE; i++)
		hl_precache_bmodel[i] = -1;
}

I64 HLClipBrushModel(I64 precache_index)
{//BSP model number for a precache slot, -1 if not a brush model
	if (precache_index < 1 || precache_index >= HLCLIP_MAX_PRECACHE)
		return -1;

	return hl_precache_bmodel[precache_index];
}

//--- which native brush entities turn, as opposed to merely being aimed -----
//
// hl_entities[i].angles is not a safe signal on its own:
//
//   - HLEntSetMoveDir folds a sliding mover's "angle" key into movedir and
//     clears angles[1] only, so a func_door authored with a pitch or roll
//     keeps it.
//   - HLEntTrain writes angles[1] every frame with the yaw it is travelling
//     at. Rotating on any non-zero angle would turn every moving func_train's
//     collision hull.
//
// Rotation is therefore opt in per entity, set by the spawn function of a class
// whose brushwork turns - func_rotating, func_door_rotating,
// momentary_rot_button, a banking func_tracktrain. Everything else pays one
// array read per trace.
//
// The angles are read live from the entity, so a spinning brush needs no
// further notification: register once at spawn, then move angles.
Bool hl_brush_rotates[HLENT_MAX];

//Render rotation is a separate flag. The trace applies the entity's angles by
//rotating the ray into brush space, which is correct for a hull built from that
//brush's own planes but has no bevels: a long thin brush at an angle leaves
//seams a moving player can be pushed through. A func_tracktrain is exactly that
//shape and the player stands on it, so its car turns on screen while its hull
//stays axial. Everything else sets both.
Bool hl_brush_rotates_draw[HLENT_MAX];

U0 HLClipRotatingReset()
{//globals aren't zeroed. Must also be called when a new map's entities are
 //parsed: the flags are indexed by entity slot, and slot 12 being a
 //func_rotating in one map says nothing about the next
	I64 i;

	for (i = 0; i < HLENT_MAX; i++)
	{
		hl_brush_rotates[i]      = FALSE;
		hl_brush_rotates_draw[i] = FALSE;
	}
}

U0 HLClipSetRotating(I64 ent, Bool on)
{//call from the spawn function of a class whose brushwork turns
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	hl_brush_rotates[ent]      = on;
	hl_brush_rotates_draw[ent] = on;
}

U0 HLClipSetRotatingDraw(I64 ent, Bool on)
{//Rotate the render only, leaving the collision hull axial.
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	hl_brush_rotates_draw[ent] = on;
}

Bool HLClipIsRotatingDraw(I64 ent)
{//For the renderer's entity loop.
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return hl_brush_rotates_draw[ent];
}

Bool HLClipIsRotating(I64 ent)
{//for the renderer's entity loop: it makes the same decision, and the two must
 //not disagree or the brush draws turned and collides straight
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return hl_brush_rotates[ent];
}

//SV_HullForEntity's hull choice. HL has four hulls where quake had three, and
//none of the boxes are the same size:
//
//   0  point            gibs, bullets, tracelines
//   1  32x32x72         standing player, most humans
//   2  64x64x64         big monsters
//   3  32x32x36         crouched player - quake had no crouch and no hull 3
//
//the compiler expanded the brushwork by each of these, so the wrong choice
//clips against geometry that was never built
U0 HLHullClipMins(I64 hull, F64 *out)
{//the box the BSP compiler expanded each hull by
	if (hull == 1)
		HLVecSet(out, -16.0, -16.0, -36.0);
	else if (hull == 2)
		HLVecSet(out, -32.0, -32.0, -32.0);
	else if (hull == 3)
		HLVecSet(out, -16.0, -16.0, -18.0);
	else
		HLVecSet(out, 0.0, 0.0, 0.0);
}

U0 HLHullOffset(I64 hull, F64 *mins, F64 *offset)
{//SV_HullForEntity's "calculate an offset value to center the origin"
 //
 //hulls are a fixed size, so an off-centre box is shifted into the hull's frame.
 //the player box matches hull 1 exactly, so the offset is zero there; an ammo
 //box at '0 0 0'..'32 32 56' is the case that needs it.
	F64 clip[3];
	I64 j;

	HLHullClipMins(hull, clip);

	for (j = 0; j < 3; j++)
		offset[j] = clip[j] - mins[j];
}

I64 HLHullForSize(F64 *mins, F64 *maxs)
{//PM_HullForBsp / SV_HullForEntity. width picks the family, height then picks
 //between the standing and crouched hulls of that family
	F64 width  = maxs[0] - mins[0];
	F64 height = maxs[2] - mins[2];

	//hull 0 is the point hull HLBSPMakeHull0 synthesises, not head_node[0];
	//HLTraceHull resolves it through hull0_head
	if (width < 3.0)
		return 0;

	if (width <= 32.0)
	{
		//a ducked player is 36 tall against the standing 72. anything at or
		//under the crouch hull's height traces against hull 3, or a crouching
		//player will not fit through the vents the level was built around
		if (height <= 36.0)
			return 3;

		return 1;
	}

	return 2;
}

U0 HLTraceInit(CHLTrace *trace, F64 *end)
{//assume the end was reached untouched
	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	trace->ent         = -1;
	trace->in_open     = FALSE;
	trace->in_water    = FALSE;
	HLVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	HLVecCopy(end, trace->end_pos);
}

U0 HLTraceHullRotated(CHLMap *map, I64 model, I64 hull, F64 *offset,
	F64 *angles, F64 *start, F64 *end, CHLTrace *trace)
{//sweep one brush model's hull - clipnodes are authored around the origin, so
 //shift the move into model space and shift the result back out
 //
 //angles is the brush entity's (pitch, yaw, roll) in degrees, NULL or identity
 //for nearly every trace. Identity takes the same path as the un-rotated
 //HLTraceHull: one HLMatAnglesActive call and two vector subtracts.
 //
 //Otherwise this is SV_ClipMoveToEntity's rotated branch: the move is carried
 //into model space, traced against the un-rotated clipnodes, and the impact
 //plane carried back out. Rotating the hull instead is not possible; the
 //clipnodes are the map's and are shared.
 //
 //Inaccuracy inherited from the original: hulls 1 to 3 are the brushwork
 //pre-grown by an axial box, and that expansion was baked in model space.
 //Tracing a rotated hull therefore sweeps a box rotated with the brush rather
 //than one that stays axial in the world. The error is at most the difference
 //between a box and its rotation, a few units on a 32-wide hull; GoldSrc ships
 //the same one. The box-to-hull correction in `offset` is likewise subtracted
 //in world space before the rotation, as SV_ClipMoveToEntity does.
	F64  lstart[3];
	F64  lend[3];
	F64  wstart[3];
	F64  wend[3];
	F64  nrm[3];
	F64  m[12];
	I64  head;
	I64  i;
	Bool rotated = FALSE;

	HLTraceInit(trace, end);

	//validate before reading num_models off it
	if (!HLMapValid(map, "HLTraceHull"))
		return;

	if (model < 0 || model >= map->num_models)
		return;

	//all four slots are populated in BSP30. quake left slot 3 zero, which is
	//also the world's clipnode root, so the old clamp stopped a hull-3 request
	//tracing the whole world under one entity
	if (hull < 0 || hull > 3)
		hull = 1;

	//head_node[0] is a render-node index the vis walk needs; the point hull
	//lives in its own root
	if (hull)
		head = map->models[model].head_node[hull];
	else
		head = map->models[model].hull0_head;

	//empty submodel, no hull to trace
	if (head < 0)
		return;

	//only model 0 legitimately roots at 0; a submodel rooting there would
	//report the whole level as its own hull
	if (model > 0 && head == 0)
		return;

	if (angles)
	{
		if (HLMatAnglesActive(angles))
			rotated = TRUE;
	}

	if (rotated)
	{
		//the matrix's translation column is offset, so HLMatTransformInv does
		//"subtract where the brush sits, then unrotate" in one pass
		HLMatFromAngles(angles, offset, m);

		HLMatTransformInv(start, m, lstart);
		HLMatTransformInv(end, m, lend);
	}
	else
	{
		HLVecSub(start, offset, lstart);
		HLVecSub(end, offset, lend);
	}

	HLVecCopy(lend, trace->end_pos);

	hl_hull_head = head;
	HLRecursiveHullCheck(map, head, 0.0, 1.0, lstart, lend, trace);

	if (!rotated)
	{
		//back into world space
		HLVecAdd(trace->end_pos, offset, trace->end_pos);
		return;
	}

	//--- carry the result back out of model space ---

	if (trace->hit)
	{
		//the normal rotates but must not translate, so HLMatRotate and not
		//HLMatTransform: transforming puts the brush's position into a unit
		//vector and the slide move pushes the player at the map origin
		HLMatRotate(trace->plane_normal, m, nrm);
		HLVecCopy(nrm, trace->plane_normal);

		//and the plane distance follows the normal: for the model plane
		//dot(n_m, x_m) = d, substituting x_m = R'(x_w - offset) gives
		//dot(n_w, x_w) = d + dot(n_w, offset).
		//
		//Asymmetric on purpose: the un-rotated path leaves plane_dist in model
		//space, which callers accept because a model-space distance pairs with
		//a model-space normal identical to the world one. Rotating the normal
		//breaks that pairing, so the rotated path corrects the distance.
		trace->plane_dist += HLVecDot(trace->plane_normal, offset);
	}

	//end_pos from the fraction along the original world move rather than by
	//transforming the model-space end_pos forward. Same answer when the trace is
	//clean; when it is not, HLRecursiveHullCheck's "backup past 0" escape hatch
	//can leave end_pos off the segment, and re-deriving keeps the result on the
	//line the caller asked about. fraction is 1.0 when nothing was hit, so an
	//untouched move lands exactly on end.
	//
	//copied to locals first: this writes trace->end_pos element by element while
	//reading the endpoints, and a caller may pass its own trace->end_pos as
	//start or end.
	HLVecCopy(start, wstart);
	HLVecCopy(end, wend);

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = wstart[i] + (wend[i] - wstart[i]) * trace->fraction;
}

U0 HLTraceHull(CHLMap *map, I64 model, I64 hull, F64 *offset, F64 *start,
	F64 *end, CHLTrace *trace)
{//the engine's un-rotated hull sweep
 //
 //forwards to the rotated form rather than duplicating the head resolution and
 //the validity checks above
	HLTraceHullRotated(map, model, hull, offset, NULL, start, end, trace);
}

U0 HLClipMoveToBox(F64 *bmins, F64 *bmaxs, F64 *mins, F64 *maxs, F64 *start,
	F64 *end, CHLTrace *trace)
{//sweep a moving box against a stationary one
 //
 //grow the stationary box by the mover's size and the sweep becomes a point
 //sweep, as the pre-expanded hulls do, then an ordinary slab test
	F64  emins[3];
	F64  emaxs[3];
	F64  d;
	F64  t1;
	F64  t2;
	F64  swap;
	F64  enter    = 0.0;
	F64  leave    = 1.0;
	F64  sign     = 0.0;
	I64  axis     = -1;
	I64  i;
	Bool inside   = TRUE;

	HLTraceInit(trace, end);

	for (i = 0; i < 3; i++)
	{
		emins[i] = bmins[i] - maxs[i];
		emaxs[i] = bmaxs[i] - mins[i];

		//the epsilon matters: resting exactly on the expanded face is not
		//strictly inside, so the slab test blocks at fraction ~0 forever while
		//the position test calls the mover clear
		if (start[i] < emins[i] - HLPHYS_EPSILON ||
			start[i] > emaxs[i] + HLPHYS_EPSILON)
			inside = FALSE;
	}

	//deviates from the original, which reports solid: the unstick pass only
	//knows world geometry, so ignore the entity and let it separate
	if (inside)
	{
		trace->all_solid   = FALSE;
		trace->start_solid = TRUE;
		return;
	}

	for (i = 0; i < 3; i++)
	{
		d = end[i] - start[i];

		if (d > -HLPHYS_EPSILON && d < HLPHYS_EPSILON)
		{
			//parallel to this pair of faces: alongside, or never near
			if (start[i] < emins[i] || start[i] > emaxs[i])
			{
				trace->all_solid = FALSE;
				return;
			}
		}
		else
		{
			t1 = (emins[i] - start[i]) / d;
			t2 = (emaxs[i] - start[i]) / d;

			if (t1 > t2)
			{
				swap = t1;
				t1   = t2;
				t2   = swap;
			}

			if (t1 > enter)
			{
				enter = t1;
				axis  = i;
				//the face met is the one the motion came from
				if (d < 0.0)
					sign = 1.0;
				else
					sign = -1.0;
			}

			if (t2 < leave)
				leave = t2;

			if (enter > leave)
			{
				trace->all_solid = FALSE;
				return;
			}
		}
	}

	trace->all_solid = FALSE;

	if (axis < 0 || enter >= 1.0)
		return;

	//back off so the mover doesn't rest inside the surface
	enter -= HLPHYS_EPSILON;
	if (enter < 0.0)
		enter = 0.0;

	trace->fraction          = enter;
	trace->hit               = TRUE;
	trace->plane_normal[axis] = sign;

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = start[i] + (end[i] - start[i]) * enter;
}

U0 HLClipToEntities(CHLMap *map, F64 *start, F64 *end, F64 *mins, F64 *maxs,
	I64 pass, Bool nomonsters, CHLTrace *trace)
{//narrow an existing world trace with every solid edict in the way
 //
 //SV_ClipToLinks without the area tree: the edict count is small enough that a
 //linear pass beats maintaining the links
	CHLTrace	tr;
	F64		eorg[3];
	F64		eofs[3];
	I64		ehull;
	F64		emins[3];
	F64		emaxs[3];
	I64		i;
	I64		j;
	I64		solid;
	I64		model;

	//from 1: HLTraceEntity already traced edict 0 through the real world hull
	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i] || i == pass)
			goto qc_next;

		solid = ToI64(HLPrFieldF(i, hl_fld_solid));

		//triggers are not obstacles, SOLID_NOT is not there at all
		if (solid == HLSOLID_NOT_ || solid == HLSOLID_TRIGGER_)
			goto qc_next;

		//never collide with an owner - a rocket has to clear the shooter
		if (pass > 0)
		{
			if (HLPrEdictNum(HLPrFieldI(i, hl_fld_owner)) == pass)
				goto qc_next;
			if (HLPrEdictNum(HLPrFieldI(pass, hl_fld_owner)) == i)
				goto qc_next;
		}

		if (nomonsters && solid != HLSOLID_BSP_)
			goto qc_next;

		for (j = 0; j < 3; j++)
		{
			eorg[j]  = HLPrFieldF(i, hl_fld_origin + j);
			emins[j] = HLPrFieldF(i, hl_fld_mins + j);
			emaxs[j] = HLPrFieldF(i, hl_fld_maxs + j);
		}

		if (solid == HLSOLID_BSP_)
		{
			//brush model: its own clipnodes, offset to where it sits. the
			//precache slot is not the BSP model number.
			model = HLClipBrushModel(ToI64(HLPrFieldF(i, hl_fld_modelindex)));
			if (model < 0)
				goto qc_next;

			//SV_ClipMoveToEntity: model position plus the same box-to-hull
			//correction the world trace needs
			ehull = HLHullForSize(mins, maxs);
			HLHullOffset(ehull, mins, eofs);
			for (j = 0; j < 3; j++)
				eofs[j] += eorg[j];

			HLTraceHull(map, model, ehull, eofs, start, end,
				&tr);
		}
		else
		{
			for (j = 0; j < 3; j++)
			{
				emins[j] += eorg[j];
				emaxs[j] += eorg[j];
			}

			HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);
		}

		//keep the earliest impact
		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			trace->ent      = i;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);
		}

		if (tr.start_solid)
		{
			trace->start_solid = TRUE;
			if (trace->ent < 0)
				trace->ent = i;
		}

qc_next:
	}
}

//which native entity the last trace hit, -1 for none. kept beside the trace
//rather than in it: CHLTrace.ent is an edict number and the two numbering
//schemes must not be confused
I64 hl_trace_native_ent = -1;

U0 HLClipToNativeBrushes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{//brush entities owned by HLEntity.ZC
 //
 //HLClipToEntities walks QuakeC edicts, and without a VM there are none, so
 //every door, platform, catwalk and tram in the map is solid only because of
 //this pass. HL levels stand the player on brush entities constantly, so their
 //absence reads as falling through the floor.
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 eofs[3];
	I64			 ehull;
	I64			 i;
	I64			 j;

	if (!hl_entities || !HLMapValid(map, "HLClipToNativeBrushes"))
		return;

	ehull = HLHullForSize(mins, maxs);

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->solid != HLSOLID_BSP)
			goto qcnb_next;

		//"*N" resolved at parse time - already a BSP model number, not a
		//precache slot, so no HLClipBrushModel indirection here
		if (e->brush_model < 1 || e->brush_model >= map->num_models)
			goto qcnb_next;

		//model position plus the box-to-hull correction, as the edict path
		//does for SOLID_BSP
		HLHullOffset(ehull, mins, eofs);
		for (j = 0; j < 3; j++)
			eofs[j] += e->origin[j];

		//a registered rotating brush traces through its orientation. the flag
		//is tested first so ordinary brushes do not pay for the angle test
		if (hl_brush_rotates[i])
			HLTraceHullRotated(map, e->brush_model, ehull, eofs, e->angles,
				start, end, &tr);
		else
			HLTraceHull(map, e->brush_model, ehull, eofs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);
			hl_trace_native_ent = i;
		}

		if (tr.start_solid)
			trace->start_solid = TRUE;

qcnb_next:
	}
}

U0 HLTraceEntity(CHLMap *map, F64 *start, F64 *end, F64 *mins, F64 *maxs,
	I64 pass, Bool nomonsters, CHLTrace *trace)
{//SV_Move: the world first, then every solid entity
	I64 hull = HLHullForSize(mins, maxs);
	F64 offset[3];

	//world sits at the origin, so the offset is box vs hull only
	HLHullOffset(hull, mins, offset);

	HLTraceHull(map, 0, hull, offset, start, end, trace);

	//buried in the world - entities cannot improve on that, only clobber it
	if (trace->all_solid)
		return;

	hl_trace_native_ent = -1;

	HLClipToEntities(map, start, end, mins, maxs, pass, nomonsters, trace);
	HLClipToNativeBrushes(map, start, end, mins, maxs, trace);
}


I64 HLTestEntityPosition(CHLMap *map, I64 ent)
{//SV_TestEntityPosition: what the entity is embedded in - an edict number,
 //0 for the world, -1 when clear
	CHLTrace	tr;
	F64		org[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	for (j = 0; j < 3; j++)
	{
		org[j]  = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	HLTraceEntity(map, org, org, mins, maxs, ent, FALSE, &tr);

	if (tr.all_solid)
		return 0;				//buried in the world

	if (tr.start_solid && tr.ent > 0)
		return tr.ent;

	return -1;
}

U0 HLImpact(I64 e1, I64 e2)
{//SV_Impact: fire the touch function of both entities
 //
 //HLPlayerTouchTriggers only reaches SOLID_TRIGGER, so this is the only path to
 //button_touch and door_touch, and to monsters registering the player.
 //
 //self/other are saved and restored: this runs from inside a move the caller is
 //part way through.
	I64 old_self;
	I64 old_other;
	I64 touch;

	if (e1 < 0 || e2 < 0)
		return;

	old_self  = HLPrGetI(hl_ofs_self);
	old_other = HLPrGetI(hl_ofs_other);

	touch = HLPrFieldI(e1, hl_fld_touch);
	if (touch > 0 && touch < hl_pr_num_functions &&
		ToI64(HLPrFieldF(e1, hl_fld_solid)) != HLSOLID_NOT_)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(e1));
		HLPrSetI(hl_ofs_other, HLPrEdictValue(e2));
		HLPrExecute(touch);
		hl_pr_error = FALSE;
	}

	touch = HLPrFieldI(e2, hl_fld_touch);
	if (touch > 0 && touch < hl_pr_num_functions &&
		ToI64(HLPrFieldF(e2, hl_fld_solid)) != HLSOLID_NOT_)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(e2));
		HLPrSetI(hl_ofs_other, HLPrEdictValue(e1));
		HLPrExecute(touch);
		hl_pr_error = FALSE;
	}

	HLPrSetI(hl_ofs_self, old_self);
	HLPrSetI(hl_ofs_other, old_other);
}

U0 HLPushEntity(CHLMap *map, I64 ent, F64 *push, CHLTrace *trace)
{//SV_PushEntity: shove by a fixed offset, stopping where it hits
	F64		org[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		solid;
	Bool	nomonsters;
	I64		j;

	for (j = 0; j < 3; j++)
	{
		org[j]  = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
		end[j]  = org[j] + push[j];
	}

	//SV_PushEntity picks MOVE_NOMONSTERS for TRIGGER and NOT: dropped backpacks
	//are SOLID_TRIGGER and would rest on the corpse's bounding box
	solid      = ToI64(HLPrFieldF(ent, hl_fld_solid));
	nomonsters = ToBool(solid == HLSOLID_TRIGGER_ || solid == HLSOLID_NOT_);

	HLTraceEntity(map, org, end, mins, maxs, ent, nomonsters, trace);

	for (j = 0; j < 3; j++)
		HLPrSetFieldF(ent, hl_fld_origin + j, trace->end_pos[j]);

	//SV_PushEntity ends with an impact when it hit something
	if (trace->ent >= 0)
		HLImpact(ent, trace->ent);
}

//--- pm_shared.c ------------------------------------------------------------
//
// Everything below this line is a port of pm_shared/pm_shared.c. The engine's
// pmove_t is a single struct the PM_ functions read and write in place; there is
// no such struct here, so its fields are file globals named hl_pm_*. They are
// live only for the duration of one HLPlayerMove call, which copies the caller's
// origin and velocity in at the top and back out at the bottom.
//
// Naming: HLPM<Name> mirrors PM_<Name> one for one. Functions without the PM
// prefix (HLTracePlayer, HLGameLinkEdict) are engine-side services pm_shared
// reached through function pointers.

//the player box QuakeC's setsize gives the client, for moves with no edict.
//pmove->player_mins[pmove->usehull] / player_maxs[usehull]
F64 hl_player_mins[3];
F64 hl_player_maxs[3];

//--- ducking ---------------------------------------------------------------
//
// PM_Duck. HL crouches, quake did not, and half the level geometry assumes it:
// vents, crawlspaces, the gap under the tram.
//
// the box swaps between hull 1 (72 tall) and hull 3 (36 tall). the origin is the
// midpoint of the box, not the feet, so a change of size under stationary feet
// moves the origin by half the height difference

//PLAYER_DUCKING_MULTIPLIER. Scales cmd.forwardmove/sidemove/upmove inside
//PM_Duck, before PM_WalkMove builds wishvel from them - not the normalised
//wishspeed afterwards. See HLPMDuck.
#define HLPM_DUCK_MULT		0.333

//pmove->flDuckTime, in seconds rather than the SDK's milliseconds. PM_Duck arms
//it at 1.0 (the SDK's 1000) and PM_ReduceTimers counts it down; the transition
//completes once it has fallen to 1.0 - TIME_TO_DUCK.
#define HLPM_DUCK_TIMER		1.0

//PM_Jump refuses to fire again until the key is released, so holding jump
//does not auto-hop. pmove->oldbuttons & IN_JUMP
Bool hl_jump_held    = FALSE;

//pmove->oldbuttons & IN_DUCK
Bool hl_duck_held_last = FALSE;

//PM_UpdateStepSound. pmove->flTimeStepSound, in seconds; which of the four step
//samples is next; and the one-shot the shell drains to play it. HL alternates
//rather than choosing at random, so the cadence is regular.
F64  hl_step_time  = 0.0;
I64  hl_step_side  = 0;
Bool hl_step_play  = FALSE;

//the distance counter the pre-pm_shared cadence used, kept only because
//HLSaveWriteMove/HLSaveReadMove still carry it in the move block. Nothing reads
//it; PM_UpdateStepSound is a timer, not an odometer. Retire it with the save
//slot, replacing it with hl_step_time.
F64  hl_step_dist  = 0.0;

//PM_UpdateStepSound's chosen sample set and volume, published for whoever owns
//sound. step kinds follow the SDK's STEP_* enum as far as this tree can tell
//them apart: there is no materials.txt texture lookup, so every dry surface is
//STEP_CONCRETE.
#define HLPM_STEP_CONCRETE	0
#define HLPM_STEP_SLOSH		6
#define HLPM_STEP_WADE		7
#define HLPM_STEP_LADDER		8

I64 hl_step_kind = HLPM_STEP_CONCRETE;
F64 hl_step_vol  = 0.5;

//trigger_gravity's multiplier on sv_gravity, pmove->gravity. A hook, like
//hl_surface_friction: HLEntity.ZC owns trigger_gravity but compiles after this
//file, so the shell copies hl_ent_gravity into this each tick
F64 hl_gravity_scale = 1.0;

Bool hl_ducking      = FALSE;	//pmove->flags & FL_DUCKING, box is the small one
Bool hl_duck_pending = FALSE;	//pmove->bInDuck, key held, box still large
F64	 hl_duck_time    = 0.0;		//pmove->flDuckTime, counting down
F64	 hl_view_ofs_z   = HLPHYS_VIEW_Z;

U0 HLDuckSetHull(Bool ducked)
{//pmove->usehull: point the trace box at hull 1 or hull 3
	if (ducked)
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_DUCK_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_DUCK_MAXS_Z);
	}
	else
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_MAXS_Z);
	}
}

F64 HLDuckSpline(F64 t)
{//PM_SplineFraction: ease the view down instead of dropping it in one frame.
 //the SDK's scale argument is folded into t by the caller
	F64 tt = t * t;

	return 3.0 * tt - 2.0 * tt * t;
}

U0 HLDuckReset()
{//globals aren't zeroed and a declaration initialiser on one is not honoured,
 //so every field is set here; HLClipInit calls it
	hl_jump_held      = FALSE;
	hl_duck_held_last = FALSE;
	hl_gravity_scale  = 1.0;
	hl_step_time      = 0.0;
	hl_step_dist      = 0.0;
	hl_step_side      = 0;
	hl_step_play      = FALSE;
	hl_step_kind      = HLPM_STEP_CONCRETE;
	hl_step_vol       = 0.5;
	hl_ducking        = FALSE;
	hl_duck_pending   = FALSE;
	hl_duck_time      = 0.0;
	hl_view_ofs_z     = HLPHYS_VIEW_Z;
	HLDuckSetHull(FALSE);
}

I64 hl_move_pass = 0;		//edict doing the current player move, 0 = none

//what the last move came to rest on. hl_ground_entity is an edict number with 0
//for the world, as .groundentity is; hl_ground_native is an index into
//hl_entities, -1 for none. The two numbering schemes are disjoint and a brush
//entity owned by HLEntity.ZC has no edict, so both are needed.
I64 hl_ground_entity = 0;
I64 hl_ground_native = -1;

I64 HLStairFlag(Bool b)
{//ToI64 on a Bool reads the seven bytes after it, so branch instead
	if (b)
		return 1;

	return 0;
}

//stair step-up diagnostics, armed with stairlog 1. bounded - a stair emits
//one per frame while walking.
#define HLSTAIR_MAX_REPORTS	200

Bool	hl_stair_log		= FALSE;
I64		hl_stair_reports	= 0;
U8		hl_stair_line[128];
F64		hl_stair_last_nz	  = 0.0;
F64		hl_stair_last_frac = 0.0;
F64		hl_stair_nz[4];
I64		hl_stair_nz_count  = 0;

//--- the pm_shared parts that needed the entity world ----------------------
//
// ladders, water jumps, currents and fall damage. everything here is read by
// files later in the include order, so the state is global; there is no pmove_t
// to hang it off.

Bool	hl_on_ladder		= FALSE;	//g_onladder
I64		hl_ladder_ent		= -1;		//index into hl_entities, -1 for none

//pmove->waterjumptime, in seconds; the SDK counts it in cmd.msec
F64		hl_waterjump_time	= 0.0;
F64		hl_waterjump_dir[3];			//pmove->movedir, the push at the ledge

//pmove->flFallVelocity, and what PM_CheckFalling decided to do about it.
//
// The damage is not applied here. pm_shared does not own damage either:
// CBasePlayer::PostThink asks the gamerules for FlPlayerFallDamage and calls
// TakeDamage. This tree has no player damage system, so the number is queued for
// whoever owns health to claim and zero, and the two sound cues likewise.
F64		hl_fall_velocity		= 0.0;
F64		hl_fall_damage_pending = 0.0;	//hitpoints owed, accumulated
F64		hl_fall_sound_vol	= 0.0;		//landing step sound volume, 0 = silent
Bool	hl_fall_pain			= FALSE;	//also player/pl_fallpain3.wav
F64		hl_fall_punch_z		= 0.0;		//punchangle roll for the landing shake

//pmove->friction, the per-surface multiplier. func_friction sets it; the
//materials.txt texture types do not exist here. PM_Friction, PM_Accelerate,
//PM_AirAccelerate and PM_WaterMove all scale by it.
F64		hl_surface_friction	= 1.0;

//pmove->basevelocity: the velocity of the surface, not of the player. Added in
//just before the move and pulled back out after, so the player's own velocity
//never accumulates the surface's.
F64		hl_base_velocity[3];

//--- pusher-driven base velocity -------------------------------------------
//
// A rider on a func_train, func_plat, func_door or func_tracktrain must be
// carried by the pusher's velocity through basevelocity, exactly as a conveyor
// carries one. Teleporting the rider's origin by the pusher's delta instead
// breaks three things at once:
//
//   - the move runs at the un-carried position, so friction and acceleration
//     are computed relative to the world rather than to the deck;
//   - the origin arrives after PM_CatagorizePosition has decided what the player
//     is standing on, so the ground entity is a tick stale;
//   - a duck completing on the same tick shifts the origin by 18 as well, and
//     the two shifts are applied in the wrong order.
//
// HLEntity.ZC owns the pushers and compiles after this file, so it writes these
// and HLPMPlatformBaseVelocity folds them in. Same hook pattern as
// hl_surface_friction and hl_gravity_scale.
//
// Contract, per server tick, before HLPlayerMove runs:
//
//   hl_platform_active    TRUE when the player is standing on a pusher that is
//                         moving or turning this tick. Cleared by the entity
//                         layer every tick before the mover pass, the way
//                         hl_surface_friction is, since stepping OFF a platform
//                         produces no event to hang a restore on.
//   hl_platform_velocity  the pusher's pev->velocity, world units per second.
//   hl_platform_avel_z    the pusher's pev->avelocity[1], degrees per second.
//                         Yaw only: a rider on a pitching or rolling brush is
//                         not modelled, and neither is one in GoldSrc.
//   hl_platform_pivot     the pusher's origin, the point avel_z turns about.
//
// The rider is then carried by v + omega x r with no origin teleport at all,
// which is what SV_PushRotate computes for a passenger on a cornering tram.
//
// hl_platform_yaw_carry is written back by this file: the degrees of yaw the
// rider was turned by this tick, for whoever owns the view angles to add. It is
// a publication, not an input, and is overwritten every move.
F64		hl_platform_velocity[3];
F64		hl_platform_pivot[3];
F64		hl_platform_avel_z		= 0.0;
Bool	hl_platform_active		= FALSE;
F64		hl_platform_yaw_carry	= 0.0;

//--- pmove_t ---------------------------------------------------------------
//
// The fields of the engine's playermove_t that the PM_ functions share. Live for
// the duration of one HLPlayerMove only.
CHLMap *hl_pm_map;
F64		hl_pm_org[3];			//pmove->origin
F64		hl_pm_vel[3];			//pmove->velocity
F64		hl_pm_wishdir[3];		//unit world direction of the command
F64		hl_pm_move;			//command magnitude, the cmd.forwardmove analogue
F64		hl_pm_view[3];			//pmove->angles
Bool	hl_pm_have_view	= FALSE;
F64		hl_pm_frametime	= 0.0;
F64		hl_pm_maxspeed		= HLPHYS_MAXSPEED;
I64		hl_pm_onground		= -1;	//pmove->onground, -1 airborne, 0 on something
I64		hl_pm_waterlevel	= 0;
I64		hl_pm_watertype	= HLCONTENTS_EMPTY;
Bool	hl_pm_wj_extern	= FALSE;	//QuakeC's FL_WATERJUMP, alongside the timer
Bool	hl_pm_jump_btn		= FALSE;	//cmd.buttons & IN_JUMP
Bool	hl_pm_duck_btn		= FALSE;	//cmd.buttons & IN_DUCK
Bool	hl_pm_on_ladder	= FALSE;	//movetype would be MOVETYPE_FLY this tick

U0 HLMoveStateReset()
{//globals aren't zeroed and a declaration initialiser on one is not honoured
	hl_on_ladder			= FALSE;
	hl_ladder_ent			= -1;

	hl_waterjump_time		= 0.0;
	HLVecSet(hl_waterjump_dir, 0.0, 0.0, 0.0);

	hl_fall_velocity		= 0.0;
	hl_fall_damage_pending	= 0.0;
	hl_fall_sound_vol		= 0.0;
	hl_fall_pain			= FALSE;
	hl_fall_punch_z			= 0.0;

	hl_surface_friction		= 1.0;
	HLVecSet(hl_base_velocity, 0.0, 0.0, 0.0);

	HLVecSet(hl_platform_velocity, 0.0, 0.0, 0.0);
	HLVecSet(hl_platform_pivot, 0.0, 0.0, 0.0);
	hl_platform_avel_z		= 0.0;
	hl_platform_active		= FALSE;
	hl_platform_yaw_carry	= 0.0;

	hl_ground_entity		= 0;
	hl_ground_native		= -1;

	hl_pm_map				= NULL;
	HLVecSet(hl_pm_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
	HLVecSet(hl_pm_wishdir, 0.0, 0.0, 0.0);
	HLVecSet(hl_pm_view, 0.0, 0.0, 0.0);
	hl_pm_move				= 0.0;
	hl_pm_have_view			= FALSE;
	hl_pm_frametime			= 0.0;
	hl_pm_maxspeed			= HLPHYS_MAXSPEED;
	hl_pm_onground			= -1;
	hl_pm_waterlevel		= 0;
	hl_pm_watertype			= HLCONTENTS_EMPTY;
	hl_pm_wj_extern			= FALSE;
	hl_pm_jump_btn			= FALSE;
	hl_pm_duck_btn			= FALSE;
	hl_pm_on_ladder			= FALSE;

	hl_stair_nz_count		= 0;
	hl_stair_nz[0]			= 0.0;
	hl_stair_nz[1]			= 0.0;
	hl_stair_nz[2]			= 0.0;
	hl_stair_nz[3]			= 0.0;
	hl_stair_last_nz		= 0.0;
	hl_stair_last_frac		= 0.0;
}

U0 HLClipInit()
{//globals aren't zeroed
	HLDuckReset;
	HLMoveStateReset;
	hl_move_pass = 0;

	HLClipPrecacheReset;

	//startup only; the entity spawn pass calls it again for each map - see
	//HLClipRotatingReset
	HLClipRotatingReset;
}

U0 HLTracePlayer(CHLMap *map, F64 *start, F64 *end, CHLTrace *trace)
{//the player's own sweep, world plus everything solid
	HLTraceEntity(map, start, end, hl_player_mins, hl_player_maxs, hl_move_pass,
		FALSE, trace);
}

U0 HLPMTrace(F64 *start, F64 *end, CHLTrace *trace)
{//pmove->PM_PlayerTrace, against the hull pmove->usehull selects
	HLTracePlayer(hl_pm_map, start, end, trace);
}

Bool HLDuckFits(CHLMap *map, F64 *origin)
{//PM_TestPlayerPosition == -1: does the current box fit here
	CHLTrace tr;

	HLTracePlayer(map, origin, origin, &tr);

	return ToBool(!tr.start_solid);
}

U0 HLPMFixCrouchStuck(F64 dir)
{//PM_FixPlayerCrouchStuck. One unit at a time up to 36, then give up and put
 //the origin back. STUCK_MOVEUP is 1, STUCK_MOVEDOWN is -1.
	F64 test[3];
	I64 i;

	if (HLDuckFits(hl_pm_map, hl_pm_org))
		return;

	HLVecCopy(hl_pm_org, test);

	for (i = 0; i < 36; i++)
	{
		hl_pm_org[2] += dir;

		if (HLDuckFits(hl_pm_map, hl_pm_org))
			return;
	}

	HLVecCopy(test, hl_pm_org);
}

U0 HLCheckVelocity(F64 *velocity)
{//PM_CheckVelocity: per axis, so a diagonal is not clamped harder
	I64 i;

	for (i = 0; i < 3; i++)
	{
		if (velocity[i] > HLPHYS_MAXVELOCITY)
			velocity[i] = HLPHYS_MAXVELOCITY;
		if (velocity[i] < -HLPHYS_MAXVELOCITY)
			velocity[i] = -HLPHYS_MAXVELOCITY;
	}
}

U0 HLPMCheckVelocity()
{//PM_CheckVelocity on pmove->velocity
	HLCheckVelocity(hl_pm_vel);
}

Bool HLPMInWaterJump()
{//pmove->waterjumptime as a predicate
 //
 //two sources: PM_CheckWaterJump's own timer, and QuakeC's FL_WATERJUMP, which
 //the shell services and passes in. Either one owns the move outright.
	if (hl_waterjump_time > 0.0)
		return TRUE;

	return hl_pm_wj_extern;
}

//PM_ClipVelocity's STOP_EPSILON. 0.1, not HLPHYS_EPSILON: HLClipVelocity in
//HLPhys.ZC snaps at 1/32 for the AI's benefit and is left alone.
#define HLPM_STOP_EPSILON	0.1

//MAX_CLIP_PLANES. PM_FlyMove gives up after this many distinct planes.
#define HLPHYS_MAXPLANES		5

//PM_ClipVelocity / PM_FlyMove return bits
#define HLBLOCK_FLOOR		1
#define HLBLOCK_WALL			2

I64 HLPMClipVelocity(F64 *in, F64 *normal, F64 *out, F64 overbounce)
{//PM_ClipVelocity: slide off the impacting object, returning the blocked flags
	F64 backoff;
	F64 angle   = normal[2];
	I64 blocked = 0;
	I64 i;

	//a positive z component is floor, exactly zero is a wall or step. Not a
	//tolerance: the compiler leaves near-vertical bevels all over an expanded
	//hull and treating those as walls steps up on every one
	if (angle > 0.0)
		blocked |= HLBLOCK_FLOOR;
	if (HLIsZeroF(angle))
		blocked |= HLBLOCK_WALL;

	backoff = HLVecDot(in, normal) * overbounce;

	for (i = 0; i < 3; i++)
	{
		out[i] = in[i] - normal[i] * backoff;

		if (out[i] > -HLPM_STOP_EPSILON && out[i] < HLPM_STOP_EPSILON)
			out[i] = 0.0;
	}

	return blocked;
}

U0 HLPMAddCorrectGravity()
{//PM_AddCorrectGravity: half the tick's gravity before the move
 //
 //"yes, this 0.5 looks wrong, but it's not". Leapfrog integration, and the
 //reason an HL jump arc does not match a quake one at identical constants.
 //
 //basevelocity[2] is spent here and zeroed: a lift carries the rider up by
 //being added to the velocity outright, not by surviving into the slide move
 //where the floor would clip it away.
	if (HLPMInWaterJump())
		return;

	hl_pm_vel[2] -= hl_gravity_scale * HLPHYS_GRAVITY * 0.5 * hl_pm_frametime;
	hl_pm_vel[2] += hl_base_velocity[2] * hl_pm_frametime;
	hl_base_velocity[2] = 0.0;

	HLPMCheckVelocity;
}

U0 HLPMFixupGravityVelocity()
{//PM_FixupGravityVelocity: the other half of the tick's gravity, after the move
	if (HLPMInWaterJump())
		return;

	hl_pm_vel[2] -= hl_gravity_scale * HLPHYS_GRAVITY * hl_pm_frametime * 0.5;

	HLPMCheckVelocity;
}

//CONTENTS_CURRENT_* push. PM_CheckWater adds 50 * waterlevel along the leaf's
//direction, so the deeper the player is the harder the current pulls.
#define HLPM_CURRENT_SPEED	50.0

U0 HLPMCurrentBaseVelocity(I64 contents)
{//PM_CheckWater's current_table pass
 //
 //the leaf inside a current brush carries the push direction in place of
 //CONTENTS_WATER, so the brush is passable and says which way it shoves. This is
 //quake's mechanism and the one the map compiler still emits.
 //
 //HL's own conveyor path is absent: func_conveyor sets FL_CONVEYOR and the
 //closed engine turns that flag into basevelocity from the entity's movedir
 //times its speed. That is engine code, not pm_shared, and the flag is
 //HLEntity.ZC's to set - it can drive hl_platform_velocity instead.
	F64 speed;

	if (!HLContentsCurrent(contents))
		return;

	speed = HLPM_CURRENT_SPEED * hl_pm_waterlevel;

	if (contents == HLCONTENTS_CURRENT_0)
		hl_base_velocity[0] += speed;
	else if (contents == HLCONTENTS_CURRENT_90)
		hl_base_velocity[1] += speed;
	else if (contents == HLCONTENTS_CURRENT_180)
		hl_base_velocity[0] -= speed;
	else if (contents == HLCONTENTS_CURRENT_270)
		hl_base_velocity[1] -= speed;
	else if (contents == HLCONTENTS_CURRENT_UP)
		hl_base_velocity[2] += speed;
	else
		hl_base_velocity[2] -= speed;	//CURRENT_DOWN, the only value left
}

Bool HLPMCheckWater()
{//PM_CheckWater: set pmove->waterlevel and pmove->watertype
 //
 //hull aware, which is the point of running it here rather than taking the
 //shell's number: the sample heights come from player_mins[usehull] and
 //player_maxs[usehull], so a crouched player in ankle-deep water reads level 2
 //where a standing one reads level 1.
 //
 //deviation: the SDK's liquid test is `cont <= CONTENTS_WATER && cont >
 //CONTENTS_TRANSLUCENT`, a range that also catches CONTENTS_SKY, ORIGIN and
 //CLIP. HLContentsLiquid names the three liquids and the six currents, which is
 //the intent.
	F64 point[3];
	F64 height;
	I64 contents;
	I64 truecont;

	hl_pm_waterlevel = 0;
	hl_pm_watertype  = HLCONTENTS_EMPTY;

	if (!hl_pm_map)
		return FALSE;

	//just above the feet, at the centre of the box in x and y
	point[0] = hl_pm_org[0] + (hl_player_mins[0] + hl_player_maxs[0]) * 0.5;
	point[1] = hl_pm_org[1] + (hl_player_mins[1] + hl_player_maxs[1]) * 0.5;
	point[2] = hl_pm_org[2] + hl_player_mins[2] + 1.0;

	truecont = HLPointContents(hl_pm_map, point);
	contents = truecont;

	if (!HLContentsLiquid(contents))
		return FALSE;

	hl_pm_watertype  = HLContentsWaterType(contents);
	hl_pm_waterlevel = 1;

	//the hull midpoint
	height   = hl_player_mins[2] + hl_player_maxs[2];
	point[2] = hl_pm_org[2] + height * 0.5;

	contents = HLPointContents(hl_pm_map, point);

	if (HLContentsLiquid(contents))
	{
		hl_pm_waterlevel = 2;

		//the eye. view_ofs follows the duck, so a crouch under a low surface
		//submerges the view without the box moving
		point[2] = hl_pm_org[2] + hl_view_ofs_z;

		contents = HLPointContents(hl_pm_map, point);
		if (HLContentsLiquid(contents))
			hl_pm_waterlevel = 3;
	}

	//"the deeper we are, the stronger the current", off the feet sample
	HLPMCurrentBaseVelocity(truecont);

	return ToBool(hl_pm_waterlevel > 1);
}

Bool HLPMInWater()
{//PM_InWater
	return ToBool(hl_pm_waterlevel > 1);
}

U0 HLPMCatagorizePosition()
{//PM_CatagorizePosition: what the player is standing in, and on
 //
 //the ground is a two unit probe straight down, not a flag left behind by the
 //slide move. Running it after every origin change - after the duck's 18 unit
 //shift, after the move, after the water move - is what keeps the ground entity
 //current, and a rider whose ground entity is a tick stale is a rider a pusher
 //has already stopped carrying.
	CHLTrace tr;
	F64		point[3];

	//"doing this before we move may introduce a potential latency in water
	//detection, but doing it after can get us stuck on the bottom in water"
	HLPMCheckWater;

	point[0] = hl_pm_org[0];
	point[1] = hl_pm_org[1];
	point[2] = hl_pm_org[2] - 2.0;

	hl_ground_entity = 0;
	hl_ground_native = -1;

	//"shooting up really fast. Definitely not on ground." This is what stops a
	//jump being cancelled by its own ground probe on the tick it fires: a
	//268 unit jump clears 180 comfortably.
	if (hl_pm_vel[2] > 180.0)
	{
		hl_pm_onground = -1;
		return;
	}

	hl_trace_native_ent = -1;
	HLPMTrace(hl_pm_org, point, &tr);

	if (tr.plane_normal[2] < 0.7)
	{
		hl_pm_onground = -1;	//too steep
		return;
	}

	hl_pm_onground = 0;

	//who is underneath. .groundentity carries the edict for SV_PushMove's
	//benefit; hl_ground_native names the brush entity HLEntity.ZC owns, which
	//has no edict at all
	if (tr.ent > 0)
		hl_ground_entity = tr.ent;

	if (hl_trace_native_ent >= 0)
		hl_ground_native = hl_trace_native_ent;

	//standing on something ends a water jump
	hl_waterjump_time = 0.0;
	hl_pm_wj_extern   = FALSE;

	//"if we could make the move, drop us down that 1 pixel". Skipped in water,
	//where it would stick the player to the bottom
	if (hl_pm_waterlevel < 2 && !tr.start_solid && !tr.all_solid)
		HLVecCopy(tr.end_pos, hl_pm_org);
}

I64 HLPMFlyMove()
{//PM_FlyMove: sweep the player, sliding along whatever is hit
 //
 //every plane hit is remembered: clipping each surface as it arrives lets the
 //second clip undo the first in a corner and grinds the velocity to nothing. so
 //a direction paralleling all planes so far, else the crease of two, else three
 //or more is a dead end and stopping is correct.
 //
 //this does not decide ground contact. PM_CatagorizePosition does, from its own
 //probe, and the caller runs it afterwards.
	CHLTrace	trace;
	F64		planes[HLPHYS_MAXPLANES * 3];
	F64		primal[3];
	F64		original[3];
	F64		new_vel[3];
	F64		end[3];
	F64		dir[3];
	F64		time_left   = hl_pm_frametime;
	F64		all_fraction = 0.0;
	F64		d;
	F64		bounce;
	I64		numplanes = 0;
	I64		blocked   = 0;
	I64		bump;
	I64		i;
	I64		j;
	Bool	ok;
	Bool	found;
	Bool	reflect;

	HLVecCopy(hl_pm_vel, primal);
	HLVecCopy(hl_pm_vel, original);

	//numbumps is 4
	for (bump = 0; bump < HLPHYS_MAXCLIP; bump++)
	{
		if (hl_pm_vel[0] == 0.0 && hl_pm_vel[1] == 0.0 && hl_pm_vel[2] == 0.0)
			break;

		HLVecMA(hl_pm_org, time_left, hl_pm_vel, end);
		HLPMTrace(hl_pm_org, end, &trace);

		all_fraction += trace.fraction;

		if (trace.all_solid)
		{
			//embedded in geometry, HLCheckStuck recovers
			HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
			return HLBLOCK_FLOOR | HLBLOCK_WALL;
		}

		if (trace.fraction > 0.0)
		{
			//ground covered, the planes collected so far no longer constrain
			HLVecCopy(trace.end_pos, hl_pm_org);
			HLVecCopy(hl_pm_vel, original);
			numplanes = 0;
		}

		if (trace.fraction == 1.0)
			break;

		//touch functions read the edict, so the position reached is pushed onto
		//it first: the original moves through a pointer into the edict, this
		//keeps the player origin in its own copy. PM_AddToTouched's job.
		if (hl_move_pass > 0 && trace.ent >= 0)
		{
			for (i = 0; i < 3; i++)
				HLPrSetFieldF(hl_move_pass, hl_fld_origin + i, hl_pm_org[i]);

			HLImpact(hl_move_pass, trace.ent);
		}

		//0.7 is about 45 degrees: flatter than that is floor
		if (trace.plane_normal[2] > 0.7)
			blocked |= HLBLOCK_FLOOR;

		//exactly vertical, as PM_FlyMove requires, not a tolerance. e1m1's hull
		//has 117 near-vertical bevels the compiler added when expanding for the
		//player box; the original slides along them and sets neither bit
		if (HLIsZeroF(trace.plane_normal[2]))
			blocked |= HLBLOCK_WALL;

		//debug: normal of the last thing hit, and every surface touched. a bevel
		//at 0.124 and a true wall at 0.000 look the same from outside and want
		//opposite fixes
		hl_stair_last_nz   = trace.plane_normal[2];
		hl_stair_last_frac = trace.fraction;

		if (hl_stair_nz_count < 4)
		{
			hl_stair_nz[hl_stair_nz_count] = trace.plane_normal[2];
			hl_stair_nz_count++;
		}

		time_left -= time_left * trace.fraction;

		if (numplanes >= HLPHYS_MAXPLANES)
		{
			HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
			break;
		}

		HLVecCopy(trace.plane_normal, &planes[numplanes * 3]);
		numplanes++;

		//"only give this a try for first impact plane because you can get
		//yourself stuck in an acute corner by jumping in place". Airborne, or on
		//a surface whose friction has been altered by func_friction, the first
		//plane reflects rather than merely clipping: movevars->bounce is 1, so
		//a slope with friction 1 behaves identically and only a slippery one
		//actually bounces
		reflect = FALSE;
		if (numplanes == 1)
		{
			if (hl_pm_onground == -1 || hl_surface_friction != 1.0)
				reflect = TRUE;
		}

		if (reflect)
		{
			if (planes[2] > 0.7)
				bounce = 1.0;
			else
				bounce = 1.0 + 1.0 * (1.0 - hl_surface_friction);

			HLPMClipVelocity(original, planes, new_vel, bounce);

			HLVecCopy(new_vel, hl_pm_vel);
			HLVecCopy(new_vel, original);

			goto qfm_next;
		}

		//a slide direction that runs along every plane hit
		found = FALSE;
		i     = 0;

		while (i < numplanes && !found)
		{
			HLPMClipVelocity(original, &planes[i * 3], new_vel, 1.0);

			ok = TRUE;
			for (j = 0; j < numplanes; j++)
			{
				if (j != i && HLVecDot(new_vel, &planes[j * 3]) < 0.0)
					ok = FALSE;
			}

			if (ok)
				found = TRUE;
			else
				i++;
		}

		if (found)
			HLVecCopy(new_vel, hl_pm_vel);
		else
		{
			if (numplanes != 2)
			{
				HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
				break;
			}

			//slide along the crease where the two planes meet
			HLVecCross(planes, &planes[3], dir);
			d = HLVecDot(dir, hl_pm_vel);
			HLVecScale(dir, d, hl_pm_vel);
		}

		//sliding turned the move back on itself: stop, or tight corners fling
		//the player backwards
		if (HLVecDot(hl_pm_vel, primal) <= 0.0)
		{
			HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
			break;
		}

qfm_next:
	}

	//"don't stick": every bump was refused outright, so the move made no
	//progress at all and the velocity is pointing into geometry
	if (all_fraction == 0.0)
		HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);

	return blocked;
}

U0 HLPMAccelerate(F64 *wishdir, F64 wishspeed, F64 accel)
{//PM_Accelerate: add speed along wishdir, never past wishspeed in that direction
	F64 currentspeed;
	F64 addspeed;
	F64 accelspeed;

	if (HLPMInWaterJump())
		return;

	currentspeed = HLVecDot(hl_pm_vel, wishdir);
	addspeed     = wishspeed - currentspeed;

	if (addspeed <= 0.0)
		return;

	//pmove->friction is in the step size, so a slippery surface accelerates as
	//slowly as it decelerates
	accelspeed = accel * hl_pm_frametime * wishspeed * hl_surface_friction;

	if (accelspeed > addspeed)
		accelspeed = addspeed;

	HLVecMA(hl_pm_vel, accelspeed, wishdir, hl_pm_vel);
}

U0 HLPMAirAccelerate(F64 *wishdir, F64 wishspeed, F64 accel)
{//PM_AirAccelerate
 //
 //the asymmetry is deliberate in the SDK: the 30 unit/s cap applies to the
 //target (addspeed), but the step size still scales with the uncapped wishspeed.
 //Moving sideways relative to velocity therefore keeps adding speed the cap
 //never sees, which is airstrafing. Using the capped value in both places
 //removes HL air movement.
	F64 wishspd = wishspeed;
	F64 currentspeed;
	F64 addspeed;
	F64 accelspeed;

	if (HLPMInWaterJump())
		return;

	if (wishspd > HLPHYS_AIRSPEEDCAP)
		wishspd = HLPHYS_AIRSPEEDCAP;

	currentspeed = HLVecDot(hl_pm_vel, wishdir);
	addspeed     = wishspd - currentspeed;

	if (addspeed <= 0.0)
		return;

	accelspeed = accel * wishspeed * hl_pm_frametime * hl_surface_friction;

	if (accelspeed > addspeed)
		accelspeed = addspeed;

	HLVecMA(hl_pm_vel, accelspeed, wishdir, hl_pm_vel);
}

U0 HLPMFriction()
{//PM_Friction, the ground branch. The water branch is commented out in the SDK
 //and stays that way here.
 //
 //control is floored at stopspeed so the stop stays crisp.
	CHLTrace tr;
	F64	start[3];
	F64	stop[3];
	F64	speed;
	F64	friction;
	F64	control;
	F64	drop = 0.0;
	F64	newspeed;

	if (HLPMInWaterJump())
		return;

	speed = Sqrt(hl_pm_vel[0] * hl_pm_vel[0] + hl_pm_vel[1] * hl_pm_vel[1] +
				 hl_pm_vel[2] * hl_pm_vel[2]);

	if (speed < 0.1)
		return;

	if (hl_pm_onground != -1)
	{
		//--- edge friction ---
		//probe 16 units ahead along the direction of travel and 34 down from the
		//feet. nothing under it means the leading edge is over a drop, and
		//movevars->edgefriction doubles friction there, which is what lets the
		//player stop on the lip of a ledge instead of skating off.
		//
		//divided by the full 3D speed, as the original does, so a fast descent
		//shortens the horizontal reach of the probe
		start[0] = hl_pm_org[0] + hl_pm_vel[0] / speed * 16.0;
		start[1] = hl_pm_org[1] + hl_pm_vel[1] / speed * 16.0;
		start[2] = hl_pm_org[2] + hl_player_mins[2];

		stop[0] = start[0];
		stop[1] = start[1];
		stop[2] = start[2] - 34.0;

		HLPMTrace(start, stop, &tr);

		friction = HLPHYS_FRICTION;
		if (tr.fraction == 1.0)
			friction *= HLPHYS_EDGEFRICTION;

		//pmove->friction, the func_friction multiplier
		friction *= hl_surface_friction;

		if (speed < HLPHYS_STOPSPEED)
			control = HLPHYS_STOPSPEED;
		else
			control = speed;

		drop += control * friction * hl_pm_frametime;
	}

	newspeed = speed - drop;
	if (newspeed < 0.0)
		newspeed = 0.0;

	newspeed /= speed;

	hl_pm_vel[0] *= newspeed;
	hl_pm_vel[1] *= newspeed;
	hl_pm_vel[2] *= newspeed;
}

U0 HLPMFlatWish(F64 *wishvel, F64 *wishdir, F64 *_wishspeed)
{//PM_WalkMove / PM_AirMove's opening: wishvel from the flattened view basis
 //
 //the SDK zeroes forward[2] and right[2], renormalises each, and builds
 //wishvel = forward*forwardmove + right*sidemove. The shell hands over one unit
 //direction and one magnitude instead, which is the same vector: flattening a
 //normalised combination and renormalising gives the direction, and the
 //magnitude is the command's.
	F64 flat[3];
	F64 wishspeed;

	HLVecSet(flat, hl_pm_wishdir[0], hl_pm_wishdir[1], 0.0);
	HLVecNormalize(flat);

	HLVecScale(flat, hl_pm_move, wishvel);
	wishvel[2] = 0.0;

	HLVecCopy(wishvel, wishdir);
	wishspeed = HLVecNormalize(wishdir);

	//clamp to server defined max speed
	if (wishspeed > hl_pm_maxspeed)
	{
		HLVecScale(wishvel, hl_pm_maxspeed / wishspeed, wishvel);
		wishspeed = hl_pm_maxspeed;
	}

	if (_wishspeed)
		*_wishspeed = wishspeed;
}

U0 HLPMWalkMove()
{//PM_WalkMove
 //
 //the step-up is not a lift applied to a blocked move. Both moves are run in
 //full - flat from the original position, and again from one stepsize up - and
 //whichever travelled further horizontally is kept. A naive "hit a wall, rise,
 //retry" picks the stepped result even when it went nowhere, which is what puts
 //the player on top of things a step could never have reached.
	CHLTrace	trace;
	F64		wishvel[3];
	F64		wishdir[3];
	F64		dest[3];
	F64		original[3];
	F64		originalvel[3];
	F64		down[3];
	F64		downvel[3];
	F64		up[3];
	F64		wishspeed = 0.0;
	F64		spd;
	F64		downdist;
	F64		updist;
	I64		oldonground;
	Bool	usedown;

	HLPMFlatWish(wishvel, wishdir, &wishspeed);

	//"set pmove velocity". The vertical component is discarded either side of
	//the acceleration so a slope's residue cannot be steered
	hl_pm_vel[2] = 0.0;
	HLPMAccelerate(wishdir, wishspeed, HLPHYS_ACCEL);
	hl_pm_vel[2] = 0.0;

	//the surface's velocity, added immediately before the move
	HLVecAdd(hl_pm_vel, hl_base_velocity, hl_pm_vel);

	spd = HLVecLength(hl_pm_vel);
	if (spd < 1.0)
	{
		HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
		return;
	}

	oldonground = hl_pm_onground;

	//--- first try moving directly to the next spot, at constant height ---
	dest[0] = hl_pm_org[0] + hl_pm_vel[0] * hl_pm_frametime;
	dest[1] = hl_pm_org[1] + hl_pm_vel[1] * hl_pm_frametime;
	dest[2] = hl_pm_org[2];

	HLPMTrace(hl_pm_org, dest, &trace);

	if (trace.fraction == 1.0)
	{
		HLVecCopy(trace.end_pos, hl_pm_org);
		return;
	}

	//"don't walk up stairs if not on ground". The water exemption is how a
	//swimmer climbs out onto a ledge without jumping
	if (oldonground == -1 && hl_pm_waterlevel == 0)
		return;

	//a water jump is scripted movement; a step on top of it fights it
	if (HLPMInWaterJump())
		return;

	//--- try sliding forward both on ground and up one step, take the move that
	//    goes farthest ---
	HLVecCopy(hl_pm_org, original);
	HLVecCopy(hl_pm_vel, originalvel);

	//globals aren't zeroed; an unfilled slot prints as a real surface
	hl_stair_nz_count = 0;
	hl_stair_nz[0]    = 0.0;
	hl_stair_nz[1]    = 0.0;
	hl_stair_nz[2]    = 0.0;
	hl_stair_nz[3]    = 0.0;

	HLPMFlyMove;

	HLVecCopy(hl_pm_org, down);
	HLVecCopy(hl_pm_vel, downvel);

	HLVecCopy(original, hl_pm_org);
	HLVecCopy(originalvel, hl_pm_vel);

	//start out up one stair height
	HLVecCopy(hl_pm_org, dest);
	dest[2] += HLPHYS_STEPSIZE;

	HLPMTrace(hl_pm_org, dest, &trace);

	if (!trace.start_solid && !trace.all_solid)
		HLVecCopy(trace.end_pos, hl_pm_org);

	HLPMFlyMove;

	//now press back down the step height
	HLVecCopy(hl_pm_org, dest);
	dest[2] -= HLPHYS_STEPSIZE;

	HLPMTrace(hl_pm_org, dest, &trace);

	usedown = FALSE;

	//"if we are not on the ground any more then use the original movement
	//attempt": the raised move can end over a face too steep to stand on
	if (trace.plane_normal[2] < 0.7)
		usedown = TRUE;
	else
	{
		if (!trace.start_solid && !trace.all_solid)
			HLVecCopy(trace.end_pos, hl_pm_org);

		HLVecCopy(hl_pm_org, up);

		//decide which one went farther, in the horizontal plane only
		downdist = (down[0] - original[0]) * (down[0] - original[0]) +
				   (down[1] - original[1]) * (down[1] - original[1]);
		updist   = (up[0] - original[0]) * (up[0] - original[0]) +
				   (up[1] - original[1]) * (up[1] - original[1]);

		if (downdist > updist)
			usedown = TRUE;
		else
			hl_pm_vel[2] = downvel[2];	//keep the z the flat move ended with
	}

	if (hl_stair_log && hl_stair_reports < HLSTAIR_MAX_REPORTS)
	{
		hl_stair_reports++;

		StrPrint(hl_stair_line,
			"stair: dn(%5.2f,%5.2f) up(%5.2f,%5.2f) dz %4.1f n_z %4.2f %d\n",
			down[0] - original[0], down[1] - original[1],
			hl_pm_org[0] - original[0], hl_pm_org[1] - original[1],
			hl_pm_org[2] - original[2], trace.plane_normal[2],
			HLStairFlag(usedown));

		HLLog(hl_stair_line);
		HLLogFlush;
	}

	if (usedown)
	{
		HLVecCopy(down, hl_pm_org);
		HLVecCopy(downvel, hl_pm_vel);
	}
}

U0 HLPMAirMove()
{//PM_AirMove
	F64 wishvel[3];
	F64 wishdir[3];
	F64 wishspeed = 0.0;

	HLPMFlatWish(wishvel, wishdir, &wishspeed);

	HLPMAirAccelerate(wishdir, wishspeed, HLPHYS_AIRACCEL);

	HLVecAdd(hl_pm_vel, hl_base_velocity, hl_pm_vel);

	HLPMFlyMove;
}

U0 HLPMWaterMove()
{//PM_WaterMove
 //
 //three numbers differ from quake: friction is movevars->friction scaled by
 //pmove->friction rather than a fixed 4, the wish is cut to 0.8 rather than 0.7,
 //and acceleration is measured against the post-friction speed.
	CHLTrace	trace;
	F64		wishvel[3];
	F64		wishdir[3];
	F64		temp[3];
	F64		start[3];
	F64		dest[3];
	F64		wishspeed;
	F64		speed;
	F64		newspeed;
	F64		addspeed;
	F64		accelspeed;

	//user intentions. The vertical component of the wish is kept while
	//submerged, so looking up and pressing forward swims up
	HLVecScale(hl_pm_wishdir, hl_pm_move, wishvel);

	//"sinking after no other movement occurs": no input drifts towards the
	//bottom rather than hovering, and drives the feet onto a platform so
	//PM_CatagorizePosition can name it
	if (hl_pm_move < 0.1)
		wishvel[2] -= HLPHYS_WATERSINK;

	HLVecCopy(wishvel, wishdir);
	wishspeed = HLVecNormalize(wishdir);

	if (wishspeed > hl_pm_maxspeed)
	{
		HLVecScale(wishvel, hl_pm_maxspeed / wishspeed, wishvel);
		wishspeed = hl_pm_maxspeed;
	}

	//"slow us down a bit"
	wishspeed *= HLPHYS_WATERSPEED;

	//a current is dragged along with everything else rather than added on top of
	//the result, so it is folded in before the water friction
	HLVecAdd(hl_pm_vel, hl_base_velocity, hl_pm_vel);

	//--- water friction ---
	HLVecCopy(hl_pm_vel, temp);
	speed    = HLVecNormalize(temp);
	newspeed = 0.0;

	if (speed > 0.0)
	{
		newspeed = speed - hl_pm_frametime * speed * HLPHYS_WATERFRICTION *
			hl_surface_friction;

		if (newspeed < 0.0)
			newspeed = 0.0;

		HLVecScale(hl_pm_vel, newspeed / speed, hl_pm_vel);
	}

	//--- water acceleration ---
	//order matters: friction has already run, so the shortfall is measured
	//against the post-friction speed
	if (wishspeed < 0.1)
		return;

	addspeed = wishspeed - newspeed;

	if (addspeed > 0.0)
	{
		HLVecNormalize(wishvel);

		accelspeed = HLPHYS_ACCEL * wishspeed * hl_pm_frametime *
			hl_surface_friction;

		if (accelspeed > addspeed)
			accelspeed = addspeed;

		HLVecMA(hl_pm_vel, accelspeed, wishvel, hl_pm_vel);
	}

	//--- the move ---
	//"assume it is a stair or a slope, so press down from stepheight above".
	//A purely vertical probe onto the destination: nothing tests the horizontal
	//path, which is how a submerged stair is climbed without a step retry. When
	//the destination is not reachable that way, slide normally.
	HLVecMA(hl_pm_org, hl_pm_frametime, hl_pm_vel, dest);
	HLVecCopy(dest, start);
	start[2] += HLPHYS_STEPSIZE + 1.0;

	HLPMTrace(start, dest, &trace);

	if (!trace.start_solid && !trace.all_solid)
	{
		HLVecCopy(trace.end_pos, hl_pm_org);
		return;
	}

	HLPMFlyMove;
}

//--- func_ladder -----------------------------------------------------------
//
// PM_Ladder / PM_LadderMove.
//
// a func_ladder is a brush entity with real clipnodes that the game marks
// SOLID_NOT with pev->skin = CONTENTS_LADDER, so it never blocks anything. the
// player is on it whenever the player hull overlaps it: that overlap is the
// mount, with no use key, no trigger and no ground check, so it is retested
// every tick.

I64 HLLadderFind(CHLMap *map, F64 *origin)
{//PM_Ladder: the first func_ladder whose hull contains the player, -1 = none
 //
 //the engine matches pe->skin == CONTENTS_LADDER. CHLEntity has no skin field,
 //so the classname discriminates instead; the set is the same, skin being
 //CONTENTS_LADDER only on func_ladder.
	CHLEntity	*e;
	F64			 eofs[3];
	F64			 test[3];
	I64			 hull;
	I64			 head;
	I64			 i;
	I64			 j;

	if (!hl_entities || !HLMapValid(map, "HLLadderFind"))
		return -1;

	//the box in use decides the overlap, so this runs after PM_Duck: crouching
	//on a ladder narrows the reach by 18 units of height
	hull = HLHullForSize(hl_player_mins, hl_player_maxs);

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		//brush test first: it rejects the hundreds of point entities a map
		//carries for one compare, where the StrCompare below would not
		if (!e->in_use || e->brush_model < 1 ||
			e->brush_model >= map->num_models)
			goto qlf_next;

		if (StrCompare(e->classname, "func_ladder"))
			goto qlf_next;

		//the same clipnode root and box-to-hull correction the solid brush pass
		//uses, so "inside" means what a blocking trace against this brush
		//would have meant
		if (hull)
			head = map->models[e->brush_model].head_node[hull];
		else
			head = map->models[e->brush_model].hull0_head;

		//negative is an empty submodel; 0 is the world's root and a submodel
		//rooting there would report the whole level as ladder
		if (head <= 0)
			goto qlf_next;

		HLHullOffset(hull, hl_player_mins, eofs);
		for (j = 0; j < 3; j++)
			eofs[j] += e->origin[j];

		HLVecSub(origin, eofs, test);

		//the pre-expanded hull reads solid exactly where the player box would
		//touch the brush; anything else is not a mount
		if (HLHullPointContents(map, head, test) == HLCONTENTS_SOLID)
			return i;

qlf_next:
	}

	return -1;
}

U0 HLPMLadderMove(I64 ent)
{//PM_LadderMove: steer along the plane of the ladder instead of into it
 //
 //pm_shared switches movetype to MOVETYPE_FLY for the tick, so the caller runs
 //no gravity, no friction and no step-up: the ladder owns the velocity outright.
	CHLEntity	*e;
	CHLTrace	 tr;
	F64			 fwd[3];
	F64			 rgt[3];
	F64			 flat_f[3];
	F64			 flat_r[3];
	F64			 centre[3];
	F64			 eofs[3];
	F64			 floor_pt[3];
	F64			 wish[3];
	F64			 perp[3];
	F64			 tmp[3];
	F64			 into[3];
	F64			 lateral[3];
	F64			 speed;
	F64			 f_amt;
	F64			 r_amt;
	F64			 normal_amt;
	I64			 j;
	Bool		 on_floor;

	if (ent < 0 || ent >= hl_num_entities || !hl_pm_have_view)
		return;

	e = &hl_entities[ent];

	HLAngleVectors(hl_pm_view, fwd, rgt, NULL);

	//"they shouldn't be able to move faster than their maxspeed", then the duck
	//multiplier on top. PM_Duck has already scaled the walk command; the ladder
	//carries its own speed and scales it separately, as the SDK does
	speed = HLPHYS_CLIMBSPEED;
	if (speed > hl_pm_maxspeed)
		speed = hl_pm_maxspeed;

	if (hl_ducking)
		speed *= HLPM_DUCK_MULT;

	//pm_shared reads cmd.forwardmove and cmd.sidemove; there is no cmd here. the
	//wish arrives flattened and normalised, so the forward and right amounts are
	//recovered by projecting it back onto the flattened basis - the signs and
	//the ratio survive normalisation, which is all the decomposition needs
	HLVecSet(flat_f, fwd[0], fwd[1], 0.0);
	HLVecSet(flat_r, rgt[0], rgt[1], 0.0);
	HLVecNormalize(flat_f);
	HLVecNormalize(flat_r);

	//deviation: a diagonal press gives 141/141 here where the SDK gives 200/200,
	//because the caller normalised the pair. the SDK's is the usual diagonal
	//speed bonus and nothing depends on it
	f_amt = HLVecDot(hl_pm_wishdir, flat_f) * speed;
	r_amt = HLVecDot(hl_pm_wishdir, flat_r) * speed;

	//dismount: back to MOVETYPE_WALK and thrown along the full view forward, so
	//looking away from a ladder and jumping gets off it
	if (hl_pm_jump_btn)
	{
		HLVecScale(fwd, HLPHYS_LADDER_JUMP, hl_pm_vel);
		return;
	}

	//feet one unit down. standing on real floor changes what pushing away from
	//the ladder means - see the last branch
	HLVecCopy(hl_pm_org, floor_pt);
	floor_pt[2] += hl_player_mins[2] - 1.0;
	on_floor = ToBool(HLPointContents(hl_pm_map, floor_pt) == HLCONTENTS_SOLID);

	//a point trace from the player to a point inside the ladder brush, purely to
	//get the normal of the face being climbed.
	//
	//the point hull is required: against the player-expanded hull the start is
	//already inside solid, and a solid->empty crossing records no plane, so the
	//trace comes back untouched and the ladder does nothing.
	for (j = 0; j < 3; j++)
		centre[j] = e->origin[j] + (e->mins[j] + e->maxs[j]) * 0.5;

	//deviation: the SDK writes VectorAdd(modelmins, modelmaxs, c); VectorScale(c,
	//0.5, c), which is the centre only if the brush was built around the origin.
	//HL brushes are built in place, so for any ladder away from 0 0 0 that point
	//lands outside the brush and the trace misses it. the true centre is the
	//intent.
	//
	//the point hull's box-to-hull correction is zero, so the model offset is
	//where the entity sits
	HLVecCopy(e->origin, eofs);

	HLTraceHull(hl_pm_map, e->brush_model, 0, eofs, hl_pm_org, centre, &tr);

	//never reached the brush: no face to climb along. pm_shared leaves the
	//velocity untouched here too, and with gravity zeroed the player hangs
	//still rather than dropping
	if (!tr.hit)
		return;

	//deviation: the SDK tests forwardmove/sidemove against exact zero, which it
	//can - they come from integer button amounts. these came through a
	//normalise, so a window is needed
	if (f_amt > -0.1 && f_amt < 0.1 && r_amt > -0.1 && r_amt < 0.1)
	{
		//no input clears the velocity, so a ladder holds the player in place
		//instead of letting them slide back down
		HLVecSet(hl_pm_vel, 0.0, 0.0, 0.0);
		return;
	}

	//the wish in world space, built from the full 3D view forward: looking up the
	//ladder and pressing forward gives a wish with a large vertical component,
	//and the decomposition below turns it into travel along the face
	HLVecScale(fwd, f_amt, wish);
	HLVecMA(wish, r_amt, rgt, wish);

	//perp: horizontal, lying in the plane of the ladder face
	HLVecSet(tmp, 0.0, 0.0, 1.0);
	HLVecCross(tmp, tr.plane_normal, perp);

	//a face pointing straight up or down has no horizontal direction to be along.
	//the SDK normalises blind and gets a zero vector; slide along the face
	//instead of steering into it
	if (HLVecNormalize(perp) < HLPHYS_EPSILON)
	{
		HLClipVelocity(wish, tr.plane_normal, HLPHYS_OVERCLIP, hl_pm_vel);
		return;
	}

	//split the wish into "into the ladder" and "along the ladder"
	normal_amt = HLVecDot(wish, tr.plane_normal);
	HLVecScale(tr.plane_normal, normal_amt, into);
	HLVecSub(wish, into, lateral);

	//tmp becomes the up direction of the face. pressing into the ladder makes
	//normal_amt negative (the normal faces back at the player), so -normal_amt
	//is positive and the player climbs: forward on a ladder is up
	HLVecCross(tr.plane_normal, perp, tmp);
	HLVecMA(lateral, -normal_amt, tmp, hl_pm_vel);

	//on the floor and pressing away from the ladder steps off it. without this
	//the bottom of a ladder is a trap: the lateral velocity is always along the
	//face, so there is no way to walk out
	if (on_floor && normal_amt > 0.0)
		HLVecMA(hl_pm_vel, HLPHYS_CLIMBSPEED, tr.plane_normal, hl_pm_vel);
}

//item touch boxes are padded; the builtins need this too, so it lives here
//rather than in HLGame.ZC
#define HLFL_ITEM_LINK	256

U0 HLGameLinkEdict(I64 ent)
{//SV_LinkEdict: recompute absmin/absmax from origin and box
 //
 //engine-owned: QuakeC reads them and never writes them. FireBullets takes its
 //muzzle height from absmin_z, and findradius and T_RadiusDamage measure with
 //them.
	F64 org[3];
	I64 j;

	if (ent < 0 || ent >= hl_pr_max_edicts)
		return;
	if (hl_fld_absmin < 0 || hl_fld_absmax < 0)
		return;

	for (j = 0; j < 3; j++)
		org[j] = HLPrFieldF(ent, hl_fld_origin + j);

	//the abs box is expanded so touching boxes still register: movement stops an
	//epsilon short of surfaces.
	//
	//the 15 unit item margin is X and Y only. On Z it would reach below the
	//floor and every box test would start inside solid.
	for (j = 0; j < 3; j++)
	{
		HLPrSetFieldF(ent, hl_fld_absmin + j,
			org[j] + HLPrFieldF(ent, hl_fld_mins + j));
		HLPrSetFieldF(ent, hl_fld_absmax + j,
			org[j] + HLPrFieldF(ent, hl_fld_maxs + j));
	}

	if (ToI64(HLPrFieldF(ent, hl_fld_flags)) & HLFL_ITEM_LINK)
	{
		for (j = 0; j < 2; j++)
		{
			HLPrSetFieldF(ent, hl_fld_absmin + j,
				HLPrFieldF(ent, hl_fld_absmin + j) - 15.0);
			HLPrSetFieldF(ent, hl_fld_absmax + j,
				HLPrFieldF(ent, hl_fld_absmax + j) + 15.0);
		}
	}
	else
	{
		for (j = 0; j < 3; j++)
		{
			HLPrSetFieldF(ent, hl_fld_absmin + j,
				HLPrFieldF(ent, hl_fld_absmin + j) - 1.0);
			HLPrSetFieldF(ent, hl_fld_absmax + j,
				HLPrFieldF(ent, hl_fld_absmax + j) + 1.0);
		}
	}
}

//--- water jump ------------------------------------------------------------
//
// PM_CheckWaterJump / PM_WaterJump. climbing out of a pool onto a ledge too
// high to swim over: the engine takes the move away from the player for two
// seconds and pushes them at the ledge while they rise.

U0 HLPMCheckWaterJump()
{//PM_CheckWaterJump: arm a water jump when swimming into a near-vertical ledge
	CHLTrace tr;
	F64 flat_fwd[3];
	F64 flat_vel[3];
	F64 vec_start[3];
	F64 vec_end[3];
	F64 save_mins[3];
	F64 save_maxs[3];
	F64 push[3];
	F64 top;
	F64 curspeed;
	F64 nz;

	//already going
	if (HLPMInWaterJump())
		return;

	//"only hop out if we are moving up": sinking this fast means the player has
	//just jumped in, and popping them back out fights the input
	if (hl_pm_vel[2] < HLPHYS_WJ_SINKING)
		return;

	//no view basis, no idea which way "at the ledge" is
	if (!hl_pm_have_view)
		return;

	HLAngleVectors(hl_pm_view, flat_fwd, NULL, NULL);
	flat_fwd[2] = 0.0;
	HLVecNormalize(flat_fwd);

	HLVecSet(flat_vel, hl_pm_vel[0], hl_pm_vel[1], 0.0);
	curspeed = HLVecNormalize(flat_vel);

	//"are we backing into water from steps or something?": moving away from where
	//the player is looking is deliberate, so do not pop them forward
	if (curspeed != 0.0 && HLVecDot(flat_vel, flat_fwd) < 0.0)
		return;

	//the top of the box has to be read before the hull is swapped, as the SDK
	//reads player_maxs[savehull]
	top = hl_player_maxs[2];

	//both probes use the point hull, as pm_shared's usehull switch does: the
	//question is whether a 24 unit reach is clear, not whether the body fits
	HLVecCopy(hl_player_mins, save_mins);
	HLVecCopy(hl_player_maxs, save_maxs);
	HLVecSet(hl_player_mins, 0.0, 0.0, 0.0);
	HLVecSet(hl_player_maxs, 0.0, 0.0, 0.0);

	//low probe, at chest height, looking for the wall
	HLVecCopy(hl_pm_org, vec_start);
	vec_start[2] += HLPHYS_WJ_HEIGHT;
	HLVecMA(vec_start, HLPHYS_WJ_FORWARD, flat_fwd, vec_end);

	HLPMTrace(vec_start, vec_end, &tr);

	nz = tr.plane_normal[2];
	if (nz < 0.0)
		nz = -nz;

	//near vertical only; anything the player can swim up needs no scripted jump
	if (tr.fraction < 1.0 && nz < 0.1)
	{
		//the push comes off the low probe's plane, so it is taken before the
		//trace is reused. negative: the normal faces back at the player and the
		//jump goes the other way, into the ledge
		HLVecScale(tr.plane_normal, HLPHYS_WJ_PUSH, push);

		//high probe, at the top of the box: the ledge has to be clear up there
		//or this is a wall and the jump ends inside it
		vec_start[2] += top - HLPHYS_WJ_HEIGHT;
		HLVecMA(vec_start, HLPHYS_WJ_FORWARD, flat_fwd, vec_end);

		HLPMTrace(vec_start, vec_end, &tr);

		if (tr.fraction == 1.0)
		{
			hl_waterjump_time = HLPHYS_WJ_TIME;
			HLVecCopy(push, hl_waterjump_dir);
			hl_pm_vel[2] = HLPHYS_WJ_UP;

			//oldbuttons |= IN_JUMP: the jump is scripted from here, so a held
			//jump key must not fire again when it ends
			hl_jump_held = TRUE;
		}
	}

	HLVecCopy(save_mins, hl_player_mins);
	HLVecCopy(save_maxs, hl_player_maxs);
}

U0 HLPMWaterJump()
{//PM_WaterJump: run the timer down and hold the horizontal push
 //
 //the external FL_WATERJUMP form has no timer of its own here: the shell decides
 //when it ends and has already written movedir into the velocity, so only the
 //native timer is serviced
	if (hl_waterjump_time <= 0.0)
		return;

	//the SDK clamps here because a save game can carry a nonsense value. kept for
	//the same reason: a timer that never expires disables gravity
	if (hl_waterjump_time > 10.0)
		hl_waterjump_time = 10.0;

	hl_waterjump_time -= hl_pm_frametime;

	if (hl_waterjump_time < 0.0 || hl_pm_waterlevel == 0)
		hl_waterjump_time = 0.0;

	//the horizontal velocity is replaced every tick, not accelerated, so the
	//pop-out is identical every time
	hl_pm_vel[0] = hl_waterjump_dir[0];
	hl_pm_vel[1] = hl_waterjump_dir[1];
}

//--- fall damage -----------------------------------------------------------
//
// PM_CheckFalling picks the landing sound and the screen punch. the damage is
// not in pm_shared: CBasePlayer::PostThink compares against
// PLAYER_MAX_SAFE_FALL_SPEED, asks the gamerules for FlPlayerFallDamage and
// calls TakeDamage. see hl_fall_damage_pending for why it is only queued here.

U0 HLPMCheckFalling()
{//end-of-move: settle up for a fall that has just landed
	F64 fvol;

	//one-shot cues, consumed or not
	hl_fall_sound_vol = 0.0;
	hl_fall_pain      = FALSE;

	if (hl_pm_onground != -1 && hl_fall_velocity >= HLPHYS_FALL_PUNCH)
	{
		fvol = 0.5;

		//water breaks a fall completely: the SDK's first branch is empty and
		//leaves fvol set, but the sound is suppressed by the fvol test below in
		//no version - it plays. Silence is the intent and CBasePlayer::WaterMove
		//zeroes the counter, so nothing is owed
		if (hl_pm_waterlevel > 0)
			fvol = 0.0;
		else if (hl_fall_velocity > HLPHYS_FALL_SAFE)
		{
			//player/pl_fallpain3.wav. the SDK randomises between pain2 and
			//pain3 with a switch whose first case has no break, so case 0 falls
			//into case 1 and only pain3 plays. one sound here too.
			hl_fall_pain = TRUE;
			fvol         = 1.0;

			//DAMAGE_FOR_FALL_SPEED: everything above the safe speed, scaled so
			//that arriving at PLAYER_FATAL_FALL_SPEED is exactly 100 points.
			//Accumulated, not overwritten: whoever claims it may be a tick
			//behind and two landings must not become one.
			hl_fall_damage_pending += (hl_fall_velocity - HLPHYS_FALL_SAFE) *
				(100.0 / (HLPHYS_FALL_FATAL - HLPHYS_FALL_SAFE));
		}
		else if (hl_fall_velocity > HLPHYS_FALL_SAFE * 0.5)
			fvol = 0.85;

		//the SDK's fourth branch, fvol = 0 below PLAYER_MIN_BOUNCE_SPEED (200),
		//is unreachable: the outer test already demands 350

		if (fvol > 0.0)
		{
			//"play landing step right away"
			hl_step_time = 0.0;
			hl_fall_sound_vol = fvol;

			//punchangle[2], a roll and not a pitch. the SDK clamps punchangle[0],
			//a different axis; the clamp is applied to the axis written
			hl_fall_punch_z = hl_fall_velocity * 0.013;
			if (hl_fall_punch_z > 8.0)
				hl_fall_punch_z = 8.0;
		}
	}

	if (hl_pm_onground != -1)
		hl_fall_velocity = 0.0;
}

U0 HLPMUpdateStepSound()
{//PM_UpdateStepSound: a step every flTimeStepSound, so the cadence tracks speed
 //
 //deviation: there is no materials.txt and no way to name the texture under the
 //player, so PM_CatagorizeTextureType and the CHAR_TEX_* switch are absent and
 //every dry surface reports STEP_CONCRETE. All the concrete cases carry the same
 //volumes and intervals anyway - 0.2/400ms walking, 0.5/300ms running - so only
 //vent, dirt and grate lose their distinct volume. The knee and feet water
 //probes are kept: those change the sample set, not just its loudness.
	F64		knee[3];
	F64		feet[3];
	F64		height;
	F64		speed;
	F64		velwalk;
	F64		velrun;
	F64		flduck;
	F64		fvol;
	I64		step;
	Bool	walking;
	Bool	moving;

	if (hl_step_time > 0.0)
		return;

	speed = HLVecLength(hl_pm_vel);

	//"UNDONE: need defined numbers for run, walk, crouch, crouch run velocities"
	if (hl_ducking || hl_pm_on_ladder)
	{
		velwalk = 60.0;
		velrun  = 80.0;
		flduck  = 0.1;		//the SDK's 100ms
	}
	else
	{
		velwalk = 120.0;
		velrun  = 210.0;
		flduck  = 0.0;
	}

	moving = FALSE;
	if (hl_pm_on_ladder || hl_pm_onground != -1)
	{
		//"if pmove->flTimeStepSound is zero, get the new sound right away - we
		//just started moving in new level". The timer is zero here by the guard
		//above, so speed alone gates it
		if (speed > 0.0 && speed >= velwalk)
			moving = TRUE;
	}

	if (!moving)
		return;

	walking = ToBool(speed < velrun);

	HLVecCopy(hl_pm_org, knee);
	HLVecCopy(hl_pm_org, feet);

	height  = hl_player_maxs[2] - hl_player_mins[2];
	knee[2] = hl_pm_org[2] - 0.3 * height;
	feet[2] = hl_pm_org[2] - 0.5 * height;

	if (hl_pm_on_ladder)
	{
		step         = HLPM_STEP_LADDER;
		fvol         = 0.35;
		hl_step_time = 0.35;
	}
	else if (HLPointContents(hl_pm_map, knee) == HLCONTENTS_WATER)
	{
		step         = HLPM_STEP_WADE;
		fvol         = 0.65;
		hl_step_time = 0.6;
	}
	else if (HLPointContents(hl_pm_map, feet) == HLCONTENTS_WATER)
	{
		step = HLPM_STEP_SLOSH;

		if (walking)
		{
			fvol         = 0.2;
			hl_step_time = 0.4;
		}
		else
		{
			fvol         = 0.5;
			hl_step_time = 0.3;
		}
	}
	else
	{
		step = HLPM_STEP_CONCRETE;

		if (walking)
		{
			fvol         = 0.2;
			hl_step_time = 0.4;
		}
		else
		{
			fvol         = 0.5;
			hl_step_time = 0.3;
		}
	}

	//"slower step time if ducking"
	hl_step_time += flduck;

	//"35% volume if ducking"
	if (hl_ducking)
		fvol *= 0.35;

	//PM_PlayStepSound alternates left and right rather than choosing at random,
	//so the cadence is regular. The shell drains hl_step_play.
	hl_step_side = (hl_step_side + 1) & 3;
	hl_step_kind = step;
	hl_step_vol  = fvol;
	hl_step_play = TRUE;
}

U0 HLPMUnDuck()
{//PM_UnDuck
 //
 //the raised origin is traced with the ducked hull first, then with the standing
 //one; either being solid keeps the player crouched. The position is
 //recategorised afterwards because the origin moved 18 units, and the ground
 //entity has to name what is under the new box or a pusher stops carrying.
	CHLTrace	trace;
	F64		new_origin[3];

	HLVecCopy(hl_pm_org, new_origin);

	//origin[i] += (player_mins[1][i] - player_mins[0][i]). Only z differs
	//between the hulls, by 18, so the feet stay put
	if (hl_pm_onground != -1)
		new_origin[2] += HLPHYS_DUCK_SHIFT;

	//still the small hull here: if the raised origin is inside geometry even at
	//36 tall there is nothing to test with the tall box
	HLPMTrace(new_origin, new_origin, &trace);

	if (trace.start_solid)
		return;

	HLDuckSetHull(FALSE);

	HLPMTrace(new_origin, new_origin, &trace);

	if (trace.start_solid)
	{
		//"changing hulls stuck us into something": stay ducked with the duck
		//hull until there is a clear spot
		HLDuckSetHull(TRUE);
		return;
	}

	hl_ducking      = FALSE;
	hl_duck_pending = FALSE;
	hl_view_ofs_z   = HLPHYS_VIEW_Z;
	hl_duck_time    = 0.0;

	HLVecCopy(new_origin, hl_pm_org);

	//"recatagorize position since ducking can change origin"
	HLPMCatagorizePosition;
}

U0 HLPMDuck()
{//PM_Duck, run before the move so the trace box is right for this tick
 //
 //the duck multiplier belongs here, on the command, not on the normalised
 //wishspeed PM_WalkMove derives from it: PM_WalkMove clamps the command's
 //magnitude to maxspeed and only then measures the wish, so scaling afterwards
 //applies the cut to an already-clamped number and comes out low.
	F64		time;
	F64		duck_fraction;
	F64		more;
	Bool	pressed;
	Bool	want;

	//nButtonPressed: the press edge, not the held state. Re-arming the timer
	//every tick the key is down would restart the transition forever.
	pressed           = ToBool(hl_pm_duck_btn && !hl_duck_held_last);
	hl_duck_held_last = hl_pm_duck_btn;

	//cmd.forwardmove/sidemove/upmove *= PLAYER_DUCKING_MULTIPLIER, while
	//FL_DUCKING is already set. The cut therefore applies from the tick after
	//the duck completes, not during the transition.
	if (hl_ducking)
		hl_pm_move *= HLPM_DUCK_MULT;

	//(buttons & IN_DUCK) || bInDuck || (flags & FL_DUCKING)
	want = ToBool(hl_pm_duck_btn || hl_duck_pending || hl_ducking);

	if (!want)
		return;

	if (!hl_pm_duck_btn)
	{
		HLPMUnDuck;
		return;
	}

	if (pressed && !hl_ducking)
	{
		//"use 1 second so super long jump will work". The timer is a full
		//second; the transition itself finishes after TIME_TO_DUCK.
		hl_duck_time    = HLPM_DUCK_TIMER;
		hl_duck_pending = TRUE;
	}

	if (!hl_duck_pending)
		return;

	//time = max(0, 1 - flDuckTime/1000): seconds spent in the transition
	time = HLPM_DUCK_TIMER - hl_duck_time;
	if (time < 0.0)
		time = 0.0;

	//"finish ducking immediately if duck time is over or not on ground".
	//onground is fresh here: PM_CatagorizePosition ran at the top of the move,
	//so a player standing on a platform is not mistaken for an airborne one and
	//sent through the branch that skips the origin shift.
	if (hl_duck_time <= HLPM_DUCK_TIMER - HLPHYS_DUCK_TIME ||
		hl_pm_onground == -1)
	{
		HLDuckSetHull(TRUE);
		hl_view_ofs_z   = HLPHYS_DUCK_VIEW_Z;
		hl_ducking      = TRUE;
		hl_duck_pending = FALSE;

		//"HACKHACK - Fudge for collision bug". Airborne the box shrinks around
		//the origin and the feet rise 18 units, which is what lets a ducked
		//jump clear a gap the standing box cannot.
		if (hl_pm_onground != -1)
		{
			//origin[i] -= (player_mins[1][i] - player_mins[0][i]). Only z
			//differs between the hulls, by 18, so the feet stay put.
			hl_pm_org[2] -= HLPHYS_DUCK_SHIFT;

			HLPMFixCrouchStuck(1.0);	//STUCK_MOVEUP

			//"recatagorize position since ducking can change origin"
			HLPMCatagorizePosition;
		}

		return;
	}

	//mid-transition the origin has not moved yet, so the eye has to travel the
	//whole way down on its own: the target is VEC_DUCK_VIEW - fMore, which is
	//below the ducked eye height, and the origin shift at the end makes up the
	//difference. Lerping to VEC_DUCK_VIEW instead snaps the view up 18 units
	//the instant the duck completes.
	more          = HLPHYS_DUCK_MINS_Z - HLPHYS_MINS_Z;
	duck_fraction = HLDuckSpline(time / HLPHYS_DUCK_TIME);

	hl_view_ofs_z = (HLPHYS_DUCK_VIEW_Z - more) * duck_fraction +
					HLPHYS_VIEW_Z * (1.0 - duck_fraction);
}

U0 HLPMCheckParameters()
{//PM_CheckParamters, the clamp order the duck multiplier depends on
 //
 //the command triple is scaled down to maxspeed FIRST, and PM_Duck's 0.333 is
 //applied to the result. clientmaxspeed is pev->maxspeed, which nothing in this
 //tree sets, so pmove->maxspeed stays sv_maxspeed.
 //
 //not ported: PM_DropPunchAngle and the view angle assembly, which the shell
 //owns (HLDropPunchAngle), and the FL_FROZEN / FL_ONTRAIN / dead cases, which
 //the shell decides before it builds the wish.
	F64 spd = hl_pm_move;

	if (spd < 0.0)
		spd = -spd;

	if (spd != 0.0 && spd > hl_pm_maxspeed)
		hl_pm_move *= hl_pm_maxspeed / spd;
}

U0 HLPMReduceTimers()
{//PM_ReduceTimers
 //
 //flTimeStepSound, flDuckTime and flSwimTime, in seconds rather than the SDK's
 //milliseconds. flSwimTime gates the swim sound, which this tree does not play.
	if (hl_step_time > 0.0)
	{
		hl_step_time -= hl_pm_frametime;
		if (hl_step_time < 0.0)
			hl_step_time = 0.0;
	}

	if (hl_duck_time > 0.0)
	{
		hl_duck_time -= hl_pm_frametime;
		if (hl_duck_time < 0.0)
			hl_duck_time = 0.0;
	}
}

U0 HLPreventMegaBunny()
{//PM_PreventMegaBunnyJumping: called on the jump, not every frame
	F64 maxscaled = HLPHYS_BUNNY_FACTOR * hl_pm_maxspeed;
	F64 spd;
	F64 fraction;

	if (maxscaled <= 0.0)
		return;

	spd = HLVecLength(hl_pm_vel);

	if (spd <= maxscaled)
		return;

	fraction = (maxscaled / spd) * HLPHYS_BUNNY_SCALE;

	HLVecScale(hl_pm_vel, fraction, hl_pm_vel);
}

U0 HLPMJump()
{//PM_Jump
 //
 //not ported: the TFC feign-death case, the super long jump module (no
 //hl_items), and the swim sound. The ducked jump is: sqrt(2*800*45) either way,
 //the longjump branch being the only thing that differs.
	if (HLPMInWaterJump())
	{
		//"see if we are waterjumping. If so, decrement count and return."
		hl_waterjump_time -= hl_pm_frametime;
		if (hl_waterjump_time < 0.0)
			hl_waterjump_time = 0.0;

		return;
	}

	//"if we are in the water most of the way": swimming, not jumping
	if (hl_pm_waterlevel >= 2)
	{
		hl_pm_onground = -1;

		if (hl_pm_watertype == HLCONTENTS_WATER)
			hl_pm_vel[2] = 100.0;
		else if (hl_pm_watertype == HLCONTENTS_SLIME)
			hl_pm_vel[2] = 80.0;
		else
			hl_pm_vel[2] = 50.0;

		return;
	}

	//"no more effect": in air
	if (hl_pm_onground == -1)
	{
		hl_jump_held = TRUE;
		return;
	}

	//"don't pogo stick"
	if (hl_jump_held)
		return;

	hl_pm_onground = -1;

	//scale the whole velocity back before adding the jump, or each hop compounds
	//the last without limit
	HLPreventMegaBunny;

	//sqrt(2 * 800 * 45), exactly enough to clear 45 units, ducked or not
	hl_pm_vel[2] = HLPHYS_JUMP;

	//"decay it for simulation": the jump is applied after PM_AddCorrectGravity
	//has already taken its half, so the other half is taken here and the arc
	//starts from the same place a mid-tick jump would
	HLPMFixupGravityVelocity;

	hl_jump_held = TRUE;
}

U0 HLPMPlatformBaseVelocity()
{//pmove->basevelocity from the pusher under the player
 //
 //v + omega x r, evaluated at the rider's own position: a passenger standing off
 //the axis of a turning tracktrain is carried around the corner by the same
 //tangential velocity SV_PushRotate would have swung them through, and the
 //carry happens inside the move rather than as a teleport applied after it.
 //
 //Yaw only. omega is about z, so omega x r is (-w*ry, w*rx, 0) with w in radians
 //per second and r the offset from the pivot in the horizontal plane.
	F64 w;
	F64 rx;
	F64 ry;

	HLVecSet(hl_base_velocity, 0.0, 0.0, 0.0);
	hl_platform_yaw_carry = 0.0;

	if (!hl_platform_active)
		return;

	HLVecAdd(hl_base_velocity, hl_platform_velocity, hl_base_velocity);

	if (!HLIsZeroF(hl_platform_avel_z))
	{
		w  = hl_platform_avel_z * HLDEG2RAD;
		rx = hl_pm_org[0] - hl_platform_pivot[0];
		ry = hl_pm_org[1] - hl_platform_pivot[1];

		hl_base_velocity[0] -= w * ry;
		hl_base_velocity[1] += w * rx;

		//published for whoever owns the view: SV_PushRotate turns a rider's own
		//angles by the pusher's delta as well as swinging their position
		hl_platform_yaw_carry = hl_platform_avel_z * hl_pm_frametime;
	}
}

U0 HLPlayerMove(CHLMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, Bool jump, F64 dt, Bool *_on_ground, I64 water_level,
	Bool waterjump, F64 *view_angles = NULL, I64 mover = 0,
	Bool duck = FALSE)
{//PM_PlayerMove: one tick of player movement, in the SDK's order
 //
 //mover is the edict being moved, as SV_FlyMove takes it: PM_FlyMove writes the
 //position reached onto it before the touch functions run. A global would make a
 //remote client's move land on whichever edict moved last.
 //
 //water_level is the shell's number, computed with the standing hull. It seeds
 //nothing: PM_CheckWater recomputes with the hull actually in use and is run
 //again after every origin change, which is the only way a crouch under a low
 //surface reads as submerged.
	I64		saved_pass;
	I64		ladder;

	//no world, no traces. The shell calls this from the menu frame, where the
	//map may not be loaded yet, and every probe below would log a failure
	if (!map)
		return;

	saved_pass   = hl_move_pass;
	hl_move_pass = mover;

	//--- load pmove_t ---
	hl_pm_map = map;
	HLVecCopy(origin, hl_pm_org);
	HLVecCopy(velocity, hl_pm_vel);
	HLVecCopy(wishdir, hl_pm_wishdir);

	hl_pm_move      = wishspeed;
	hl_pm_frametime = dt;
	hl_pm_maxspeed  = HLPHYS_MAXSPEED;
	hl_pm_jump_btn  = jump;
	hl_pm_duck_btn  = duck;
	hl_pm_wj_extern = waterjump;
	hl_pm_waterlevel = water_level;

	hl_pm_have_view = FALSE;
	if (view_angles)
	{
		HLVecCopy(view_angles, hl_pm_view);
		hl_pm_have_view = TRUE;
	}

	//--- PM_CheckParamters, then the frame's timers ---
	HLPMCheckParameters;
	HLPMReduceTimers;

	//the surface under the player, sampled before anything moves. Currents are
	//added to this by PM_CheckWater inside PM_CatagorizePosition.
	HLPMPlatformBaseVelocity;

	//"now that we are unstuck, see where we are (waterlevel and type,
	//pmove->onground)". HLCheckStuck is the shell's, run before the move.
	HLPMCatagorizePosition;

	//"if we are not on ground, store off how fast we are moving down". Read here
	//and not after the move: WalkMove has zeroed the downward component by then
	//and every landing would report zero.
	if (hl_pm_onground == -1)
		hl_fall_velocity = -hl_pm_vel[2];

	//--- PM_Ladder ---
	//mounted purely by hull overlap, so it is retested every tick
	ladder = -1;
	if (hl_pm_have_view)
		ladder = HLLadderFind(map, hl_pm_org);

	hl_ladder_ent = ladder;
	hl_on_ladder  = ToBool(ladder >= 0);

	//PM_UpdateStepSound reads movetype == MOVETYPE_FLY, which PM_LadderMove sets
	//and this tick has not yet. hl_pm_on_ladder therefore still holds last
	//tick's answer here, as the SDK's does.
	HLPMUpdateStepSound;

	HLPMDuck;

	hl_pm_on_ladder = hl_on_ladder;

	//--- MOVETYPE_FLY: the ladder owns the velocity outright ---
	if (ladder >= 0)
	{
		HLPMLadderMove(ladder);

		HLPMCheckWater;

		hl_jump_held = jump;

		//grabbing a ladder cancels the fall: nothing is owed on arrival, and a
		//long climb down must not bill for the descent
		hl_fall_velocity  = 0.0;
		hl_fall_sound_vol = 0.0;
		hl_fall_pain      = FALSE;

		HLVecAdd(hl_pm_vel, hl_base_velocity, hl_pm_vel);
		HLPMFlyMove;
		HLVecSub(hl_pm_vel, hl_base_velocity, hl_pm_vel);

		hl_pm_onground = -1;
		goto qpm_done;
	}

	//--- MOVETYPE_WALK ---
	if (!HLPMInWater())
		HLPMAddCorrectGravity;

	//"if we are leaping out of the water, just update the counters"
	if (HLPMInWaterJump())
	{
		HLPMWaterJump;
		HLPMFlyMove;
		HLPMCheckWater;

		hl_pm_onground = -1;
		goto qpm_done;
	}

	if (hl_pm_waterlevel >= 2)
	{
		//at the surface only. fully under there is no ledge in reach and
		//PM_CheckWaterJump's low probe would be looking at the pool wall
		if (hl_pm_waterlevel == 2)
			HLPMCheckWaterJump;

		//"if we are falling again, then we must not be trying to jump out of
		//water any more"
		if (hl_pm_vel[2] < 0.0 && hl_waterjump_time > 0.0)
			hl_waterjump_time = 0.0;

		if (jump)
			HLPMJump;
		else
			hl_jump_held = FALSE;

		HLPMWaterMove;

		HLVecSub(hl_pm_vel, hl_base_velocity, hl_pm_vel);

		//"get a final position"
		HLPMCatagorizePosition;

		//water breaks the fall, so a dive owes nothing on touching bottom
		hl_fall_velocity  = 0.0;
		hl_fall_sound_vol = 0.0;
		hl_fall_pain      = FALSE;

		goto qpm_done;
	}

	//--- not underwater ---
	if (jump)
		HLPMJump;
	else
		hl_jump_held = FALSE;

	//"friction is handled before we add in any base velocity. That way, if we
	//are on a conveyor, we don't slow when standing still, relative to the
	//conveyor."
	if (hl_pm_onground != -1)
	{
		hl_pm_vel[2] = 0.0;
		HLPMFriction;
	}

	HLPMCheckVelocity;

	if (hl_pm_onground != -1)
		HLPMWalkMove;
	else
		HLPMAirMove;

	//"set final flags": the ground entity is re-derived from where the move
	//actually ended, so a rider who has just stepped onto a platform is riding
	//it this tick and not next
	HLPMCatagorizePosition;

	//"now pull the base velocity back out", so the player's own velocity never
	//accumulates the surface's: step off a conveyor and the carry stops
	HLVecSub(hl_pm_vel, hl_base_velocity, hl_pm_vel);
	HLPMCheckVelocity;

	if (!HLPMInWater())
		HLPMFixupGravityVelocity;

	//"if we are on ground, no downward velocity"
	if (hl_pm_onground != -1)
		hl_pm_vel[2] = 0.0;

	HLPMCheckFalling;

qpm_done:
	//--- store pmove_t back ---
	HLVecCopy(hl_pm_org, origin);
	HLVecCopy(hl_pm_vel, velocity);

	if (_on_ground)
		*_on_ground = ToBool(hl_pm_onground != -1);

	//restored on every exit; leaking it leaves the next HLCheckStuck tracing
	//with a stale pass entity
	hl_move_pass = saved_pass;
}
