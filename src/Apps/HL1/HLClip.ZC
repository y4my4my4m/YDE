// HLClip.ZC - entity-aware collision and player movement.
//
// needs the edict field table, so it sits after HLProgs
//   HLPhys - hull traces against the world BSP only
//   HLClip - the same plus every solid edict, and movement built on it
//
// from world.c (SV_Move and friends) and sv_phys/sv_user

//.solid values, here rather than HLGame - collision runs earlier in the
//include order
#define HLSOLID_NOT_			0
#define HLSOLID_TRIGGER_		1
#define HLSOLID_BBOX_		2
#define HLSOLID_SLIDEBOX_	3
#define HLSOLID_BSP_			4

//precache index -> BSP brush model number
//
// .modelindex indexes the PRECACHE list, not map->models: the world is
// precache slot 1 but BSP model 0, and "*3" lands wherever it lands.
// -1 = not a brush model.
#define HLCLIP_MAX_PRECACHE	1024

I64 hl_precache_bmodel[HLCLIP_MAX_PRECACHE];

U0 HLClipPrecacheReset()
{//globals aren't zeroed
	I64 i;

	for (i = 0; i < HLCLIP_MAX_PRECACHE; i++)
		hl_precache_bmodel[i] = -1;
}

I64 HLClipBrushModel(I64 precache_index)
{//BSP model number for a precache slot, -1 if not a brush model
	if (precache_index < 1 || precache_index >= HLCLIP_MAX_PRECACHE)
		return -1;

	return hl_precache_bmodel[precache_index];
}

//--- which native brush entities are TURNED, not merely aimed ---------------
//
// hl_entities[i].angles is not a safe signal on its own, which is the whole
// reason this array exists:
//
//   - HLEntSetMoveDir folds a sliding mover's "angle" key into movedir and
//     clears angles[1], but only angles[1] - a func_door authored with a
//     pitch or roll would keep it.
//   - HLEntTrain WRITES angles[1] every frame with the yaw it is travelling
//     at, as bookkeeping for whatever wants to read it. Rotating on any
//     non-zero angle would silently turn every moving func_train's collision
//     hull, breaking geometry that works today.
//
// So rotation is OPT IN, per entity, set by the spawn function of a class
// that really does turn its brushwork - func_rotating, func_door_rotating,
// momentary_rot_button, a banking func_tracktrain. Everything else is
// untouched and pays one array read per trace.
//
// The angles themselves are still read live from the entity, so a spinning
// brush needs no further notification: register once at spawn, then just move
// angles.
Bool hl_brush_rotates[HLENT_MAX];

U0 HLClipRotatingReset()
{//globals aren't zeroed, and this MUST also be called when a new map's
 //entities are parsed - the flags are indexed by entity slot, and slot 12
 //being a func_rotating in one map says nothing about the next one
	I64 i;

	for (i = 0; i < HLENT_MAX; i++)
		hl_brush_rotates[i] = FALSE;
}

U0 HLClipSetRotating(I64 ent, Bool on)
{//call from the spawn function of a class whose BRUSHWORK turns
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	hl_brush_rotates[ent] = on;
}

Bool HLClipIsRotating(I64 ent)
{//for the renderer's entity loop: it has to make the same decision, and the
 //two must not disagree or the brush draws turned and collides straight
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return hl_brush_rotates[ent];
}

//SV_HullForEntity's hull choice. HL has FOUR hulls where quake had three, and
//none of the boxes are the same size:
//
//   0  point            gibs, bullets, tracelines
//   1  32x32x72         standing player, most humans
//   2  64x64x64         big monsters
//   3  32x32x36         crouched player - quake had no crouch and no hull 3
//
//the compiler expanded the brushwork by each of these, so picking the wrong
//one does not just clip badly, it clips against geometry that was never built
U0 HLHullClipMins(I64 hull, F64 *out)
{//the box the BSP compiler expanded each hull by
	if (hull == 1)
		HLVecSet(out, -16.0, -16.0, -36.0);
	else if (hull == 2)
		HLVecSet(out, -32.0, -32.0, -32.0);
	else if (hull == 3)
		HLVecSet(out, -16.0, -16.0, -18.0);
	else
		HLVecSet(out, 0.0, 0.0, 0.0);
}

U0 HLHullOffset(I64 hull, F64 *mins, F64 *offset)
{//SV_HullForEntity's "calculate an offset value to center the origin"
 //
 //hulls are a fixed size, so an off-centre box gets shifted into the hull's
 //frame. the player box matches hull 1 exactly, so the offset is zero there -
 //an ammo box at '0 0 0'..'32 32 56' is the case that needs it.
	F64 clip[3];
	I64 j;

	HLHullClipMins(hull, clip);

	for (j = 0; j < 3; j++)
		offset[j] = clip[j] - mins[j];
}

I64 HLHullForSize(F64 *mins, F64 *maxs)
{//PM_HullForBsp / SV_HullForEntity. width picks the family, height then picks
 //between the standing and crouched hulls of that family
	F64 width  = maxs[0] - mins[0];
	F64 height = maxs[2] - mins[2];

	//hull 0 is the point hull HLBSPMakeHull0 synthesises, NOT head_node[0] -
	//HLTraceHull resolves it through hull0_head
	if (width < 3.0)
		return 0;

	if (width <= 32.0)
	{
		//a ducked player is 36 tall against the standing 72. anything at or
		//under the crouch hull's height traces against hull 3, or a crouching
		//player cannot fit through the vents the level was built around
		if (height <= 36.0)
			return 3;

		return 1;
	}

	return 2;
}

U0 HLTraceInit(CHLTrace *trace, F64 *end)
{//assume the end was reached untouched
	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	trace->ent         = -1;
	trace->in_open     = FALSE;
	trace->in_water    = FALSE;
	HLVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	HLVecCopy(end, trace->end_pos);
}

U0 HLTraceHullRotated(CHLMap *map, I64 model, I64 hull, F64 *offset,
	F64 *angles, F64 *start, F64 *end, CHLTrace *trace)
{//sweep one brush model's hull - clipnodes are authored around the origin, so
 //shift the move into model space and shift the result back out
 //
 //angles is the brush entity's (pitch, yaw, roll) in degrees, NULL or
 //identity for the overwhelming majority of traces. When it is identity this
 //is the old HLTraceHull to the instruction: one call to HLMatAnglesActive
 //and then the same two vector subtracts.
 //
 //When it is not, this is SV_ClipMoveToEntity's rotated branch: the move is
 //carried INTO model space, traced against the un-rotated clipnodes, and the
 //impact plane carried back out. Doing it the other way - rotating the hull -
 //is not possible, the clipnodes are the map's and are shared.
 //
 //KNOWN INACCURACY, inherited from the original and not fixable here: hulls 1
 //to 3 are the brushwork pre-grown by an AXIAL box, and that expansion was
 //baked in model space. Tracing a rotated hull therefore sweeps a box that is
 //rotated with the brush rather than one that stays axial in the world. The
 //error is at most the difference between a box and its rotation - a few
 //units on a 32-wide hull - and GoldSrc ships the same one. The box-to-hull
 //correction in `offset` is likewise subtracted in world space before the
 //rotation, exactly as SV_ClipMoveToEntity does it.
	F64  lstart[3];
	F64  lend[3];
	F64  wstart[3];
	F64  wend[3];
	F64  nrm[3];
	F64  m[12];
	I64  head;
	I64  i;
	Bool rotated = FALSE;

	HLTraceInit(trace, end);

	//validate before reading num_models off it
	if (!HLMapValid(map, "HLTraceHull"))
		return;

	if (model < 0 || model >= map->num_models)
		return;

	//all four slots are populated in BSP30. quake left slot 3 zero, which is
	//also the WORLD's clipnode root, so the old clamp existed to stop a hull-3
	//request tracing the whole world under one entity
	if (hull < 0 || hull > 3)
		hull = 1;

	//head_node[0] is a render-node index the vis walk needs; the point hull
	//lives in its own root
	if (hull)
		head = map->models[model].head_node[hull];
	else
		head = map->models[model].hull0_head;

	//empty submodel, no hull to trace
	if (head < 0)
		return;

	//only model 0 legitimately roots at 0; a submodel rooting there would
	//report the whole level as its own hull
	if (model > 0 && head == 0)
		return;

	if (angles)
	{
		if (HLMatAnglesActive(angles))
			rotated = TRUE;
	}

	if (rotated)
	{
		//the matrix's translation column IS offset, so HLMatTransformInv does
		//"subtract where the brush sits, then unrotate" in one pass
		HLMatFromAngles(angles, offset, m);

		HLMatTransformInv(start, m, lstart);
		HLMatTransformInv(end, m, lend);
	}
	else
	{
		HLVecSub(start, offset, lstart);
		HLVecSub(end, offset, lend);
	}

	HLVecCopy(lend, trace->end_pos);

	hl_hull_head = head;
	HLRecursiveHullCheck(map, head, 0.0, 1.0, lstart, lend, trace);

	if (!rotated)
	{
		//back into world space
		HLVecAdd(trace->end_pos, offset, trace->end_pos);
		return;
	}

	//--- carry the result back out of model space ---

	if (trace->hit)
	{
		//the normal rotates but must NOT translate, so this is HLMatRotate and
		//not HLMatTransform. Getting that wrong puts the brush's position into
		//a unit vector and the slide move then pushes the player at the map
		//origin.
		HLMatRotate(trace->plane_normal, m, nrm);
		HLVecCopy(nrm, trace->plane_normal);

		//and the plane distance follows the normal: for the model plane
		//dot(n_m, x_m) = d, substituting x_m = R'(x_w - offset) gives
		//dot(n_w, x_w) = d + dot(n_w, offset).
		//
		//ASYMMETRY, on purpose: the un-rotated path above leaves plane_dist in
		//MODEL space, which it has always done, and callers live with it
		//because a model-space distance still pairs with a model-space normal
		//that happens to be identical to the world one. Once the normal is
		//rotated that pairing is broken, so the rotated path has to be right.
		trace->plane_dist += HLVecDot(trace->plane_normal, offset);
	}

	//end_pos from the fraction along the ORIGINAL world move rather than by
	//transforming the model-space end_pos forward. Same answer when the trace
	//is clean, and strictly better when it is not: HLRecursiveHullCheck's
	//"backup past 0" escape hatch can leave end_pos slightly off the segment,
	//and re-deriving it here keeps the result on the line the caller asked
	//about. fraction is 1.0 when nothing was hit, so an untouched move lands
	//exactly on end.
	//
	//copied to locals first because this writes trace->end_pos element by
	//element while reading the endpoints, and a caller is free to hand us its
	//own trace->end_pos as start or end.
	HLVecCopy(start, wstart);
	HLVecCopy(end, wend);

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = wstart[i] + (wend[i] - wstart[i]) * trace->fraction;
}

U0 HLTraceHull(CHLMap *map, I64 model, I64 hull, F64 *offset, F64 *start,
	F64 *end, CHLTrace *trace)
{//the engine's un-rotated hull sweep, unchanged for every existing caller.
 //
 //a thin forward to the rotated form rather than a second copy of the head
 //resolution and the validity checks above - two copies of that would drift,
 //and a submodel that roots at clipnode 0 reporting the whole level as its
 //own hull is exactly the sort of bug the drift would cause
	HLTraceHullRotated(map, model, hull, offset, NULL, start, end, trace);
}

U0 HLClipMoveToBox(F64 *bmins, F64 *bmaxs, F64 *mins, F64 *maxs, F64 *start,
	F64 *end, CHLTrace *trace)
{//sweep a moving box against a stationary one
 //
 //grow the stationary box by the mover's size and it becomes a point sweep -
 //the same trick the pre-expanded hulls use. then an ordinary slab test.
	F64  emins[3];
	F64  emaxs[3];
	F64  d;
	F64  t1;
	F64  t2;
	F64  swap;
	F64  enter    = 0.0;
	F64  leave    = 1.0;
	F64  sign     = 0.0;
	I64  axis     = -1;
	I64  i;
	Bool inside   = TRUE;

	HLTraceInit(trace, end);

	for (i = 0; i < 3; i++)
	{
		emins[i] = bmins[i] - maxs[i];
		emaxs[i] = bmaxs[i] - mins[i];

		//the epsilon is load bearing: resting exactly ON the expanded face is
		//not strictly inside, so the slab test blocks at fraction ~0 forever
		//while the position test still calls the mover clear
		if (start[i] < emins[i] - HLPHYS_EPSILON ||
			start[i] > emaxs[i] + HLPHYS_EPSILON)
			inside = FALSE;
	}

	//NOTE: deviates from the original, which reports solid. the unstick pass
	//only knows world geometry, so ignore the entity and let it separate
	if (inside)
	{
		trace->all_solid   = FALSE;
		trace->start_solid = TRUE;
		return;
	}

	for (i = 0; i < 3; i++)
	{
		d = end[i] - start[i];

		if (d > -HLPHYS_EPSILON && d < HLPHYS_EPSILON)
		{
			//parallel to this pair of faces: alongside, or never near
			if (start[i] < emins[i] || start[i] > emaxs[i])
			{
				trace->all_solid = FALSE;
				return;
			}
		}
		else
		{
			t1 = (emins[i] - start[i]) / d;
			t2 = (emaxs[i] - start[i]) / d;

			if (t1 > t2)
			{
				swap = t1;
				t1   = t2;
				t2   = swap;
			}

			if (t1 > enter)
			{
				enter = t1;
				axis  = i;
				//the face met is the one the motion came from
				if (d < 0.0)
					sign = 1.0;
				else
					sign = -1.0;
			}

			if (t2 < leave)
				leave = t2;

			if (enter > leave)
			{
				trace->all_solid = FALSE;
				return;
			}
		}
	}

	trace->all_solid = FALSE;

	if (axis < 0 || enter >= 1.0)
		return;

	//back off so the mover doesn't rest inside the surface
	enter -= HLPHYS_EPSILON;
	if (enter < 0.0)
		enter = 0.0;

	trace->fraction          = enter;
	trace->hit               = TRUE;
	trace->plane_normal[axis] = sign;

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = start[i] + (end[i] - start[i]) * enter;
}

U0 HLClipToEntities(CHLMap *map, F64 *start, F64 *end, F64 *mins, F64 *maxs,
	I64 pass, Bool nomonsters, CHLTrace *trace)
{//narrow an existing world trace with every solid edict in the way
 //
 //SV_ClipToLinks without the area tree - the edict count is small enough that
 //a linear pass beats maintaining the links
	CHLTrace	tr;
	F64		eorg[3];
	F64		eofs[3];
	I64		ehull;
	F64		emins[3];
	F64		emaxs[3];
	I64		i;
	I64		j;
	I64		solid;
	I64		model;

	//from 1: HLTraceEntity already traced edict 0 through the real world hull
	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i] || i == pass)
			goto qc_next;

		solid = ToI64(HLPrFieldF(i, hl_fld_solid));

		//triggers are not obstacles, SOLID_NOT is not there at all
		if (solid == HLSOLID_NOT_ || solid == HLSOLID_TRIGGER_)
			goto qc_next;

		//never collide with your own owner - a rocket has to clear the shooter
		if (pass > 0)
		{
			if (HLPrEdictNum(HLPrFieldI(i, hl_fld_owner)) == pass)
				goto qc_next;
			if (HLPrEdictNum(HLPrFieldI(pass, hl_fld_owner)) == i)
				goto qc_next;
		}

		if (nomonsters && solid != HLSOLID_BSP_)
			goto qc_next;

		for (j = 0; j < 3; j++)
		{
			eorg[j]  = HLPrFieldF(i, hl_fld_origin + j);
			emins[j] = HLPrFieldF(i, hl_fld_mins + j);
			emaxs[j] = HLPrFieldF(i, hl_fld_maxs + j);
		}

		if (solid == HLSOLID_BSP_)
		{
			//brush model: its own clipnodes, offset to where it sits. the
			//precache slot is NOT the BSP model number.
			model = HLClipBrushModel(ToI64(HLPrFieldF(i, hl_fld_modelindex)));
			if (model < 0)
				goto qc_next;

			//SV_ClipMoveToEntity: model position PLUS the same box-to-hull
			//correction the world trace needs
			ehull = HLHullForSize(mins, maxs);
			HLHullOffset(ehull, mins, eofs);
			for (j = 0; j < 3; j++)
				eofs[j] += eorg[j];

			HLTraceHull(map, model, ehull, eofs, start, end,
				&tr);
		}
		else
		{
			for (j = 0; j < 3; j++)
			{
				emins[j] += eorg[j];
				emaxs[j] += eorg[j];
			}

			HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);
		}

		//keep the earliest impact
		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			trace->ent      = i;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);
		}

		if (tr.start_solid)
		{
			trace->start_solid = TRUE;
			if (trace->ent < 0)
				trace->ent = i;
		}

qc_next:
	}
}

//which native entity the last trace hit, -1 for none. kept beside the trace
//rather than in it: CHLTrace.ent is an EDICT number and the two numbering
//schemes must not be confused
I64 hl_trace_native_ent = -1;

U0 HLClipToNativeBrushes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{//brush entities owned by HLEntity.ZC
 //
 //HLClipToEntities above walks QuakeC edicts, and without a VM there are
 //none - so every door, platform, catwalk and tram in the map is solid only
 //because of this pass. HL levels stand the player on brush entities
 //constantly, which is why their absence reads as falling through the floor
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 eofs[3];
	I64			 ehull;
	I64			 i;
	I64			 j;

	if (!hl_entities || !HLMapValid(map, "HLClipToNativeBrushes"))
		return;

	ehull = HLHullForSize(mins, maxs);

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->solid != HLSOLID_BSP)
			goto qcnb_next;

		//"*N" resolved at parse time - already a BSP model number, not a
		//precache slot, so no HLClipBrushModel indirection here
		if (e->brush_model < 1 || e->brush_model >= map->num_models)
			goto qcnb_next;

		//model position PLUS the box-to-hull correction, same as the edict
		//path does for SOLID_BSP
		HLHullOffset(ehull, mins, eofs);
		for (j = 0; j < 3; j++)
			eofs[j] += e->origin[j];

		//a registered rotating brush traces through its orientation; every
		//other entity takes the same path it always has. the flag is tested
		//FIRST so the angle test is not paid for by ordinary brushes
		if (hl_brush_rotates[i])
			HLTraceHullRotated(map, e->brush_model, ehull, eofs, e->angles,
				start, end, &tr);
		else
			HLTraceHull(map, e->brush_model, ehull, eofs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);
			hl_trace_native_ent = i;
		}

		if (tr.start_solid)
			trace->start_solid = TRUE;

qcnb_next:
	}
}

U0 HLTraceEntity(CHLMap *map, F64 *start, F64 *end, F64 *mins, F64 *maxs,
	I64 pass, Bool nomonsters, CHLTrace *trace)
{//SV_Move: the world first, then every solid entity
	I64 hull = HLHullForSize(mins, maxs);
	F64 offset[3];

	//world sits at the origin, so the offset is box vs hull only
	HLHullOffset(hull, mins, offset);

	HLTraceHull(map, 0, hull, offset, start, end, trace);

	//buried in the world - entities can't improve on that, only clobber it
	if (trace->all_solid)
		return;

	hl_trace_native_ent = -1;

	HLClipToEntities(map, start, end, mins, maxs, pass, nomonsters, trace);
	HLClipToNativeBrushes(map, start, end, mins, maxs, trace);
}


I64 HLTestEntityPosition(CHLMap *map, I64 ent)
{//SV_TestEntityPosition: what the entity is embedded in - an edict number,
 //0 for the world, -1 when clear
	CHLTrace	tr;
	F64		org[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	for (j = 0; j < 3; j++)
	{
		org[j]  = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	HLTraceEntity(map, org, org, mins, maxs, ent, FALSE, &tr);

	if (tr.all_solid)
		return 0;				//buried in the world

	if (tr.start_solid && tr.ent > 0)
		return tr.ent;

	return -1;
}

U0 HLImpact(I64 e1, I64 e2)
{//SV_Impact: fire the touch function of BOTH entities
 //
 //HLPlayerTouchTriggers only reaches SOLID_TRIGGER, so this is the only path to
 //button_touch and door_touch, and to monsters registering the player.
 //
 //self/other are saved and restored - this runs from inside a move the caller
 //is still part way through.
	I64 old_self;
	I64 old_other;
	I64 touch;

	if (e1 < 0 || e2 < 0)
		return;

	old_self  = HLPrGetI(hl_ofs_self);
	old_other = HLPrGetI(hl_ofs_other);

	touch = HLPrFieldI(e1, hl_fld_touch);
	if (touch > 0 && touch < hl_pr_num_functions &&
		ToI64(HLPrFieldF(e1, hl_fld_solid)) != HLSOLID_NOT_)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(e1));
		HLPrSetI(hl_ofs_other, HLPrEdictValue(e2));
		HLPrExecute(touch);
		hl_pr_error = FALSE;
	}

	touch = HLPrFieldI(e2, hl_fld_touch);
	if (touch > 0 && touch < hl_pr_num_functions &&
		ToI64(HLPrFieldF(e2, hl_fld_solid)) != HLSOLID_NOT_)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(e2));
		HLPrSetI(hl_ofs_other, HLPrEdictValue(e1));
		HLPrExecute(touch);
		hl_pr_error = FALSE;
	}

	HLPrSetI(hl_ofs_self, old_self);
	HLPrSetI(hl_ofs_other, old_other);
}

U0 HLPushEntity(CHLMap *map, I64 ent, F64 *push, CHLTrace *trace)
{//SV_PushEntity: shove by a fixed offset, stopping where it hits
	F64		org[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		solid;
	Bool	nomonsters;
	I64		j;

	for (j = 0; j < 3; j++)
	{
		org[j]  = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
		end[j]  = org[j] + push[j];
	}

	//SV_PushEntity picks MOVE_NOMONSTERS for TRIGGER and NOT - dropped
	//backpacks are SOLID_TRIGGER and would rest on the corpse's bounding box
	solid      = ToI64(HLPrFieldF(ent, hl_fld_solid));
	nomonsters = ToBool(solid == HLSOLID_TRIGGER_ || solid == HLSOLID_NOT_);

	HLTraceEntity(map, org, end, mins, maxs, ent, nomonsters, trace);

	for (j = 0; j < 3; j++)
		HLPrSetFieldF(ent, hl_fld_origin + j, trace->end_pos[j]);

	//SV_PushEntity ends with an impact when it hit something
	if (trace->ent >= 0)
		HLImpact(ent, trace->ent);
}

//the player box QuakeC's setsize gives the client, for moves with no edict
F64 hl_player_mins[3];
F64 hl_player_maxs[3];

//--- ducking ---------------------------------------------------------------
//
// PM_Duck. HL crouches, quake did not, and half the level geometry assumes it:
// vents, crawlspaces, the gap under the tram. so this is not cosmetic.
//
// the box swaps between hull 1 (72 tall) and hull 3 (36 tall). the ORIGIN is
// the midpoint of the box, not the feet, so a change of size under stationary
// feet has to move the origin by half the height difference

//PM_Jump refuses to fire again until the key is released, so holding jump
//does not auto-hop. tracked here because there is no pmove->oldbuttons yet
Bool hl_jump_held    = FALSE;

//trigger_gravity's multiplier on sv_gravity. A HOOK, like hl_surface_friction:
//HLEntity.ZC owns trigger_gravity but compiles AFTER this file, so it cannot
//be read from there - the shell copies hl_ent_gravity into this each tick
F64 hl_gravity_scale = 1.0;

Bool hl_ducking      = FALSE;	//box is currently the small one
Bool hl_duck_pending = FALSE;	//key held, animating down, box still large
F64	 hl_duck_time    = 0.0;		//seconds spent in the transition
F64	 hl_view_ofs_z   = HLPHYS_VIEW_Z;

U0 HLDuckSetHull(Bool ducked)
{//point the trace box at hull 1 or hull 3
	if (ducked)
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_DUCK_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_DUCK_MAXS_Z);
	}
	else
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_MAXS_Z);
	}
}

F64 HLDuckSpline(F64 t)
{//PM_SplineFraction - ease the view down instead of dropping it in one frame
	F64 tt = t * t;

	return 3.0 * tt - 2.0 * tt * t;
}

U0 HLDuckReset()
{//globals aren't zeroed and a declaration initialiser on one is not honoured,
 //so every field is set here and HLClipInit calls it
	hl_jump_held     = FALSE;
	hl_gravity_scale = 1.0;
	hl_ducking       = FALSE;
	hl_duck_pending = FALSE;
	hl_duck_time    = 0.0;
	hl_view_ofs_z   = HLPHYS_VIEW_Z;
	HLDuckSetHull(FALSE);
}
I64 hl_move_pass = 0;		//edict doing the current player move, 0 = none

//what the last move came to rest on, 0 = world
I64 hl_ground_entity = 0;

I64 HLStairFlag(Bool b)
{//HACK: ToI64 on a Bool reads the seven bytes after it, so branch instead
	if (b)
		return 1;

	return 0;
}

//stair step-up diagnostics, armed with stairlog 1. bounded - a stair emits
//one per frame while walking.
#define HLSTAIR_MAX_REPORTS	200

Bool	hl_stair_log		= FALSE;
I64		hl_stair_reports	= 0;
U8		hl_stair_line[128];
F64		hl_stair_last_nz	  = 0.0;
F64		hl_stair_last_frac = 0.0;
F64		hl_stair_nz[4];
I64		hl_stair_nz_count  = 0;

//--- the pm_shared parts that needed the entity world ----------------------
//
// ladders, water jumps, currents and fall damage. everything here is read by
// files LATER in the include order, which is why the state is global and not
// a pmove struct - there is no pmove_t to hang it off.

Bool	hl_on_ladder		= FALSE;	//PM_Ladder found one this tick
I64		hl_ladder_ent		= -1;		//index into hl_entities, -1 for none

//pmove->waterjumptime, in SECONDS - the SDK counts it in cmd.msec
F64		hl_waterjump_time	= 0.0;
F64		hl_waterjump_dir[3];			//pmove->movedir, the push at the ledge

//pmove->flFallVelocity, and what PM_CheckFalling decided to do about it.
//
// THE DAMAGE IS NOT APPLIED HERE. pm_shared does not own damage either -
// CBasePlayer::PostThink asks the gamerules for FlPlayerFallDamage and calls
// TakeDamage. this tree has no player damage system yet and it is not this
// file's to invent, so the number is QUEUED for whoever owns health to claim
// and zero, and the two sound cues are published the same way.
F64		hl_fall_velocity		= 0.0;
F64		hl_fall_damage_pending = 0.0;	//hitpoints owed, accumulated
F64		hl_fall_sound_vol	= 0.0;		//landing step sound volume, 0 = silent
Bool	hl_fall_pain			= FALSE;	//also player/pl_fallpain3.wav
F64		hl_fall_punch_z		= 0.0;		//punchangle roll for the landing shake

//pmove->friction, the per-surface multiplier.
//
// LEFT OUT: what normally sets it. materials.txt texture types and
// func_friction are the two sources and neither is this file's - so this stays
// 1.0 unless something else assigns it, and PM_Friction reads it either way.
F64		hl_surface_friction	= 1.0;

//pmove->basevelocity - the velocity of the surface, not of the player. added
//in just before the move and pulled straight back out after
F64		hl_base_velocity[3];

U0 HLMoveStateReset()
{//globals aren't zeroed and a declaration initialiser on one is not honoured
	hl_on_ladder			= FALSE;
	hl_ladder_ent			= -1;

	hl_waterjump_time		= 0.0;
	HLVecSet(hl_waterjump_dir, 0.0, 0.0, 0.0);

	hl_fall_velocity		= 0.0;
	hl_fall_damage_pending	= 0.0;
	hl_fall_sound_vol		= 0.0;
	hl_fall_pain			= FALSE;
	hl_fall_punch_z			= 0.0;

	hl_surface_friction		= 1.0;
	HLVecSet(hl_base_velocity, 0.0, 0.0, 0.0);
}

U0 HLClipInit()
{//globals aren't zeroed
	HLDuckReset;
	HLMoveStateReset;
	hl_move_pass = 0;

	HLClipPrecacheReset;

	//startup only - see the note on HLClipRotatingReset, the entity spawn pass
	//has to call it again for each map
	HLClipRotatingReset;
}

U0 HLTracePlayer(CHLMap *map, F64 *start, F64 *end, CHLTrace *trace)
{//the player's own sweep, world plus everything solid
	HLTraceEntity(map, start, end, hl_player_mins, hl_player_maxs, hl_move_pass,
		FALSE, trace);
}

Bool HLDuckFits(CHLMap *map, F64 *origin)
{//PM_PlayerTrace against itself - does the CURRENT box fit here at all
	CHLTrace tr;

	HLTracePlayer(map, origin, origin, &tr);

	return ToBool(!tr.start_solid);
}

U0 HLDuckUpdate(CHLMap *map, F64 *origin, Bool duck_held, Bool on_ground,
	F64 dt)
{//PM_Duck, run before the move so the trace box is right for this tick
	F64 frac;
	F64 test[3];

	if (duck_held)
	{
		if (!hl_ducking && !hl_duck_pending)
		{
			hl_duck_pending = TRUE;
			hl_duck_time    = 0.0;
		}

		if (hl_duck_pending)
		{
			hl_duck_time += dt;

			//the view eases down over the transition; the BOX does not move
			//until the end, or the player would clip into the floor midway
			frac = hl_duck_time / HLPHYS_DUCK_TIME;
			if (frac > 1.0)
				frac = 1.0;

			hl_view_ofs_z = HLPHYS_VIEW_Z -
				(HLPHYS_VIEW_Z - HLPHYS_DUCK_VIEW_Z) * HLDuckSpline(frac);

			//in the air the crouch snaps - PM_Duck finishes immediately when
			//there is no ground, which is what makes a ducked jump clear a
			//gap the standing box cannot
			if (frac >= 1.0 || !on_ground)
			{
				hl_ducking      = TRUE;
				hl_duck_pending = FALSE;
				hl_view_ofs_z   = HLPHYS_DUCK_VIEW_Z;

				HLDuckSetHull(TRUE);

				//feet stay put, so the midpoint drops by half the height lost
				if (on_ground)
					origin[2] -= HLPHYS_DUCK_SHIFT;
			}
		}

		return;
	}

	//key released
	hl_duck_pending = FALSE;

	if (!hl_ducking)
	{
		hl_view_ofs_z = HLPHYS_VIEW_Z;
		return;
	}

	HLVecCopy(origin, test);

	if (on_ground)
		test[2] += HLPHYS_DUCK_SHIFT;

	//stand back up only if the TALL box fits at the raised origin. checked
	//with the big hull selected, then reverted if it does not
	HLDuckSetHull(FALSE);

	if (!HLDuckFits(map, test))
	{
		//still under something - stay crouched, no partial states
		HLDuckSetHull(TRUE);
		return;
	}

	HLVecCopy(test, origin);

	hl_ducking    = FALSE;
	hl_duck_time  = 0.0;
	hl_view_ofs_z = HLPHYS_VIEW_Z;
}

//--- func_ladder -----------------------------------------------------------
//
// PM_Ladder / PM_LadderMove.
//
// a func_ladder is a brush entity the compiler gave real clipnodes but the
// game marks SOLID_NOT with pev->skin = CONTENTS_LADDER, so it never blocks
// anything. the player is "on" it whenever the player HULL overlaps it - that
// overlap IS the mount, there is no use key, no trigger and no ground check.
// which also means it has to be retested every tick.

I64 HLLadderFind(CHLMap *map, F64 *origin)
{//PM_Ladder: the first func_ladder whose hull contains the player, -1 = none
 //
 //the engine matches pe->skin == CONTENTS_LADDER. CHLEntity has no skin field,
 //so the classname is the discriminator here - the same set either way, skin
 //is only ever CONTENTS_LADDER on func_ladder.
	CHLEntity	*e;
	F64			 eofs[3];
	F64			 test[3];
	I64			 hull;
	I64			 head;
	I64			 i;
	I64			 j;

	if (!hl_entities || !HLMapValid(map, "HLLadderFind"))
		return -1;

	//the box in use decides the overlap, so this must run AFTER PM_Duck -
	//crouching on a ladder narrows the reach by 18 units of height
	hull = HLHullForSize(hl_player_mins, hl_player_maxs);

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		//brush test FIRST. it rejects the hundreds of point entities a map
		//carries for the cost of one compare; the StrCompare below would not
		if (!e->in_use || e->brush_model < 1 ||
			e->brush_model >= map->num_models)
			goto qlf_next;

		if (StrCompare(e->classname, "func_ladder"))
			goto qlf_next;

		//the same clipnode root and the same box-to-hull correction the solid
		//brush pass uses, so "inside" means exactly what a blocking trace
		//against this brush would have meant
		if (hull)
			head = map->models[e->brush_model].head_node[hull];
		else
			head = map->models[e->brush_model].hull0_head;

		//negative is an empty submodel; 0 is the WORLD's root and a submodel
		//rooting there would report the whole level as ladder
		if (head <= 0)
			goto qlf_next;

		HLHullOffset(hull, hl_player_mins, eofs);
		for (j = 0; j < 3; j++)
			eofs[j] += e->origin[j];

		HLVecSub(origin, eofs, test);

		//the pre-expanded hull reads SOLID exactly where the player box would
		//touch the brush. anything else is not a mount
		if (HLHullPointContents(map, head, test) == HLCONTENTS_SOLID)
			return i;

qlf_next:
	}

	return -1;
}

U0 HLLadderMove(CHLMap *map, I64 ent, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 *view_angles, Bool jump)
{//PM_LadderMove: steer along the plane of the ladder instead of into it
 //
 //pm_shared switches movetype to MOVETYPE_FLY for the tick, so the caller must
 //run no gravity, no friction, no step-up and no base velocity - the ladder
 //owns the velocity outright.
	CHLEntity	*e;
	CHLTrace	 tr;
	F64			 fwd[3];
	F64			 rgt[3];
	F64			 flat_f[3];
	F64			 flat_r[3];
	F64			 centre[3];
	F64			 eofs[3];
	F64			 floor_pt[3];
	F64			 wish[3];
	F64			 perp[3];
	F64			 tmp[3];
	F64			 into[3];
	F64			 lateral[3];
	F64			 f_amt;
	F64			 r_amt;
	F64			 normal_amt;
	I64			 j;
	Bool		 on_floor;

	if (ent < 0 || ent >= hl_num_entities || !view_angles)
		return;

	e = &hl_entities[ent];

	HLAngleVectors(view_angles, fwd, rgt, NULL);

	//pm_shared reads cmd.forwardmove and cmd.sidemove; there is no cmd here.
	//the wish arrives already flattened and normalised, so recover how much of
	//it was forward and how much right by projecting it back onto the
	//FLATTENED basis - the signs and the ratio survive normalisation, which is
	//all the decomposition below needs
	HLVecSet(flat_f, fwd[0], fwd[1], 0.0);
	HLVecSet(flat_r, rgt[0], rgt[1], 0.0);
	HLVecNormalize(flat_f);
	HLVecNormalize(flat_r);

	//DEVIATION: a diagonal press gives 141/141 here where the SDK gives
	//200/200, because the caller normalised the pair. the SDK's is the usual
	//diagonal speed bonus and nothing depends on it
	f_amt = HLVecDot(wishdir, flat_f) * HLPHYS_CLIMBSPEED;
	r_amt = HLVecDot(wishdir, flat_r) * HLPHYS_CLIMBSPEED;

	//dismount: back to MOVETYPE_WALK and thrown along the FULL view forward,
	//which is why looking away from a ladder and jumping is how you get off it
	if (jump)
	{
		HLVecScale(fwd, HLPHYS_LADDER_JUMP, velocity);
		return;
	}

	//feet one unit down. standing on real floor changes what pushing AWAY from
	//the ladder means - see the last branch
	HLVecCopy(origin, floor_pt);
	floor_pt[2] += hl_player_mins[2] - 1.0;
	on_floor = ToBool(HLPointContents(map, floor_pt) == HLCONTENTS_SOLID);

	//a point trace from the player to a point INSIDE the ladder brush. all it
	//is for is the normal of the face being climbed.
	//
	//the POINT hull is deliberate and load bearing: against the
	//player-expanded hull the start is already inside solid, and a
	//solid->empty crossing records no plane at all, so the trace would come
	//back untouched and the ladder would do nothing.
	for (j = 0; j < 3; j++)
		centre[j] = e->origin[j] + (e->mins[j] + e->maxs[j]) * 0.5;

	//DEVIATION: the SDK writes VectorMA(modelmins, 0.5, modelmaxs, ...), which
	//is only the centre if the brush was built around the origin. HL brushes
	//are built in place, so for any ladder away from 0 0 0 that lands outside
	//the brush and the trace misses it. the true centre is the intent.
	//
	//the point hull's box-to-hull correction is zero, so the model offset is
	//just where the entity sits
	HLVecCopy(e->origin, eofs);

	HLTraceHull(map, e->brush_model, 0, eofs, origin, centre, &tr);

	//never reached the brush - no face to climb along. pm_shared leaves the
	//velocity untouched here too, and having zeroed gravity that means the
	//player hangs still rather than dropping
	if (!tr.hit)
		return;

	//DEVIATION: the SDK tests forwardmove/sidemove against exact zero, which
	//it can - they come from integer button amounts. these came through a
	//normalise, so a window is needed
	if (f_amt > -0.1 && f_amt < 0.1 && r_amt > -0.1 && r_amt < 0.1)
	{
		//no input CLEARS the velocity. that is what makes a ladder hold the
		//player in place instead of letting them slide back down it
		HLVecSet(velocity, 0.0, 0.0, 0.0);
		return;
	}

	//the wish in world space, built from the FULL 3D view forward. that is the
	//whole trick of ladders: looking up the ladder and pressing forward gives
	//a wish with a large vertical component, and the decomposition below turns
	//it into travel along the face
	HLVecScale(fwd, f_amt, wish);
	HLVecMA(wish, r_amt, rgt, wish);

	//perp: horizontal, lying in the plane of the ladder face
	HLVecSet(tmp, 0.0, 0.0, 1.0);
	HLVecCross(tmp, tr.plane_normal, perp);

	//a face pointing straight up or down has no horizontal direction to be
	//"along". the SDK normalises blind and gets a zero vector; slide along the
	//face instead of steering into it
	if (HLVecNormalize(perp) < HLPHYS_EPSILON)
	{
		HLClipVelocity(wish, tr.plane_normal, HLPHYS_OVERCLIP, velocity);
		return;
	}

	//split the wish into "into the ladder" and "along the ladder"
	normal_amt = HLVecDot(wish, tr.plane_normal);
	HLVecScale(tr.plane_normal, normal_amt, into);
	HLVecSub(wish, into, lateral);

	//tmp becomes the UP direction of the face. pressing INTO the ladder makes
	//normal_amt negative (the normal faces back at the player), so -normal_amt
	//is positive and the player climbs: forward on a ladder is up
	HLVecCross(tr.plane_normal, perp, tmp);
	HLVecMA(lateral, -normal_amt, tmp, velocity);

	//on the floor and pressing AWAY from the ladder steps off it. without this
	//the bottom of a ladder is a trap - the lateral velocity is always along
	//the face, so there is no way to walk out
	if (on_floor && normal_amt > 0.0)
		HLVecMA(velocity, HLPHYS_CLIMBSPEED, tr.plane_normal, velocity);
}

//--- currents and conveyors ------------------------------------------------
//
// CONTENTS_CURRENT_0..CURRENT_DOWN. this is the quake mechanism and the one
// the map compiler still emits: the leaf inside a current brush carries the
// push direction INSTEAD OF CONTENTS_SOLID, so the brush is passable and says
// which way it shoves.
//
// LEFT OUT: HL's own conveyor path. func_conveyor sets FL_CONVEYOR and the
// closed engine turns that flag into basevelocity from the entity's movedir
// times its speed - that is engine code, not pm_shared, and the flag is
// HLEntity.ZC's to set. a func_conveyor built WITHOUT current contents carries
// nothing here.

U0 HLBaseVelocity(CHLMap *map, F64 *origin, Bool on_ground, I64 water_level,
	F64 *out)
{//pmove->basevelocity: the velocity of the surface, not of the player
	F64 point[3];
	F64 speed;
	I64 contents;

	HLVecSet(out, 0.0, 0.0, 0.0);

	if (!HLMapValid(map, "HLBaseVelocity"))
		return;

	//sampled at the FEET, one unit up - the same place HLWaterLevelGet
	//samples. a current you are standing in only contains the bottom of the
	//box, and the origin is the box's MIDDLE
	HLVecCopy(origin, point);
	point[2] = origin[2] + hl_player_mins[2] + 1.0;

	contents = HLPointContents(map, point);

	if (!HLContentsCurrent(contents))
		return;

	speed = HLPHYS_CURRENT_SPEED;

	//an ankle-deep current with ground under it is halved, as quake 2 does -
	//otherwise a shallow stream shoves harder than the player can walk
	if (water_level == 1 && on_ground)
		speed *= 0.5;

	if (contents == HLCONTENTS_CURRENT_0)
		out[0] = speed;
	else if (contents == HLCONTENTS_CURRENT_90)
		out[1] = speed;
	else if (contents == HLCONTENTS_CURRENT_180)
		out[0] = -speed;
	else if (contents == HLCONTENTS_CURRENT_270)
		out[1] = -speed;
	else if (contents == HLCONTENTS_CURRENT_UP)
		out[2] = speed;
	else
		out[2] = -speed;		//CURRENT_DOWN, the only value left in the range
}

//clip planes before giving up on finding a way out
#define HLPHYS_MAXPLANES		5

//HLFlyMove return bits, same meaning as SV_FlyMove's
#define HLBLOCK_FLOOR		1
#define HLBLOCK_WALL		2

I64 HLFlyMove(CHLMap *map, F64 *origin, F64 *velocity, F64 dt, Bool *_ground,
	CHLTrace *_steptrace)
{//SV_FlyMove: sweep the player, sliding along whatever is hit
 //
 //every plane hit is REMEMBERED. clipping each surface as it arrives lets the
 //second clip undo the first in a corner and grinds the velocity to nothing.
 //so: a direction paralleling all planes so far, else the crease of two, else
 //three-plus is a real dead end and stopping is correct.
 //
 //ground contact is decided here from the plane the move landed on, not by a
 //separate downward probe - the same trace that stops the fall names the floor
	CHLTrace	trace;
	F64		planes[HLPHYS_MAXPLANES * 3];
	F64		primal[3];
	F64		original[3];
	F64		new_vel[3];
	F64		end[3];
	F64		dir[3];
	F64		time_left = dt;
	F64		d;
	I64		numplanes = 0;
	I64		blocked   = 0;
	I64		bump;
	I64		i;
	I64		j;
	Bool	ok;
	Bool	found;

	HLVecCopy(velocity, primal);
	HLVecCopy(velocity, original);

	for (bump = 0; bump < HLPHYS_MAXCLIP; bump++)
	{
		if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
			break;

		HLVecMA(origin, time_left, velocity, end);
		HLTracePlayer(map, origin, end, &trace);

		if (trace.all_solid)
		{
			//embedded in geometry, HLCheckStuck recovers
			HLVecSet(velocity, 0.0, 0.0, 0.0);
			return HLBLOCK_FLOOR | HLBLOCK_WALL;
		}

		if (trace.fraction > 0.0)
		{
			//ground covered, the planes collected so far no longer constrain
			HLVecCopy(trace.end_pos, origin);
			HLVecCopy(velocity, original);
			numplanes = 0;
		}

		if (trace.fraction == 1.0)
			break;

		//0.7 is about 45 degrees: flatter than that is floor
		if (trace.plane_normal[2] > 0.7)
		{
			blocked |= HLBLOCK_FLOOR;

			//ground only counts on SOLID_BSP - SV_FlyMove sets FL_ONGROUND
			//only for the world or a brush entity, which is why nothing can
			//stand on a monster
			if (trace.ent <= 0 ||
				ToI64(HLPrFieldF(trace.ent, hl_fld_solid)) == HLSOLID_BSP_)
			{
				if (_ground)
					*_ground = TRUE;

			//.groundentity: SV_PushMove reads it to decide who rides a plat.
			//world is edict 0 as far as QuakeC is concerned.
				if (trace.ent > 0)
					hl_ground_entity = trace.ent;
				else
					hl_ground_entity = 0;
			}
		}

		//touch functions read the edict, so push the position reached onto it
		//first - the original moves through a pointer into the edict, this
		//keeps the player origin in its own copy
		if (hl_move_pass > 0 && trace.ent >= 0)
		{
			for (i = 0; i < 3; i++)
				HLPrSetFieldF(hl_move_pass, hl_fld_origin + i, origin[i]);

			HLImpact(hl_move_pass, trace.ent);
		}

		//debug: normal of the last thing hit. the wall bit needs an exactly
		//vertical plane, so near-vertical blockers leave no other record.
		hl_stair_last_nz   = trace.plane_normal[2];
		hl_stair_last_frac = trace.fraction;

		//every surface touched: a bevel at 0.124 and a true wall at 0.000 look
		//the same from outside and want opposite fixes
		if (hl_stair_nz_count < 4)
		{
			hl_stair_nz[hl_stair_nz_count] = trace.plane_normal[2];
			hl_stair_nz_count++;
		}

		//EXACTLY vertical, as SV_FlyMove requires - not a tolerance. e1m1's
		//hull has 117 near-vertical bevels the compiler added when expanding
		//for the player box; the original slides along them and sets neither
		//bit. a tolerance here would step up on every one.
		if (HLIsZeroF(trace.plane_normal[2]))
		{
			blocked |= HLBLOCK_WALL;

			//wall friction needs the plane, the step retry needs the blocker
			if (_steptrace)
				MemCopy(_steptrace, &trace, sizeof(CHLTrace));
		}

		time_left -= time_left * trace.fraction;

		if (numplanes >= HLPHYS_MAXPLANES)
		{
			HLVecSet(velocity, 0.0, 0.0, 0.0);
			return HLBLOCK_FLOOR | HLBLOCK_WALL;
		}

		HLVecCopy(trace.plane_normal, &planes[numplanes * 3]);
		numplanes++;

		//a slide direction that runs along every plane hit
		found = FALSE;
		i     = 0;

		while (i < numplanes && !found)
		{
			HLClipVelocity(original, &planes[i * 3], 1.0, new_vel);

			ok = TRUE;
			for (j = 0; j < numplanes; j++)
			{
				if (j != i && HLVecDot(new_vel, &planes[j * 3]) < 0.0)
					ok = FALSE;
			}

			if (ok)
				found = TRUE;
			else
				i++;
		}

		if (found)
			HLVecCopy(new_vel, velocity);
		else
		{
			if (numplanes != 2)
			{
				HLVecSet(velocity, 0.0, 0.0, 0.0);
				return HLBLOCK_FLOOR | HLBLOCK_WALL;
			}

			//slide along the crease where the two planes meet
			HLVecCross(planes, &planes[3], dir);
			d = HLVecDot(dir, velocity);
			HLVecScale(dir, d, velocity);
		}

		//sliding turned the move back on itself - stop, or tight corners fling
		//the player backwards
		if (HLVecDot(velocity, primal) <= 0.0)
		{
			HLVecSet(velocity, 0.0, 0.0, 0.0);
			return blocked;
		}
	}

	return blocked;
}

Bool HLSlideMove(CHLMap *map, F64 *origin, F64 *velocity, F64 dt)
{//move and slide, discarding what was hit
	return ToBool(HLFlyMove(map, origin, velocity, dt, NULL, NULL) != 0);
}

U0 HLPushMove(CHLMap *map, F64 *origin, F64 *push, CHLTrace *trace)
{//SV_PushEntity minus the linking, which is unused here
	F64 end[3];

	HLVecAdd(origin, push, end);
	HLTracePlayer(map, origin, end, trace);
	HLVecCopy(trace->end_pos, origin);
}

U0 HLWallFriction(F64 *velocity, F64 *view_angles, F64 *normal)
{//SV_WallFriction: bleed off speed when running at a wall face-on
 //
 //scaled by how directly the player FACES the wall, not by impact - glancing
 //contact keeps its speed, head-on stops dead
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 into[3];
	F64 side[3];
	F64 d;
	F64 i;

	HLAngleVectors(view_angles, fwd, rgt, upv);

	d = HLVecDot(normal, fwd) + 0.5;
	if (d >= 0.0)
		return;

	//drop the component heading into the wall, scale what is left
	i = HLVecDot(normal, velocity);
	HLVecScale(normal, i, into);
	HLVecSub(velocity, into, side);

	velocity[0] = side[0] * (1.0 + d);
	velocity[1] = side[1] * (1.0 + d);
}

I64 HLTryUnstick(CHLMap *map, F64 *origin, F64 *velocity, F64 *oldvel)
{//SV_TryUnstick: nudge out of a seam the hulls will not let the player leave
 //
 //hulls are built from integer planes, so a step can make no progress at all.
 //eight small axial shoves, each followed by a retry; first one that travels
 //wins.
	F64		oldorg[3];
	F64		dir[3];
	CHLTrace	tr;
	F64		dx;
	F64		dy;
	I64		clip;
	I64		i;

	HLVecCopy(origin, oldorg);

	for (i = 0; i < 8; i++)
	{
		HLVecSet(dir, 0.0, 0.0, 0.0);

		switch (i)
		{
			case 0:	dir[0] =  2.0;					break;
			case 1:	dir[1] =  2.0;					break;
			case 2:	dir[0] = -2.0;					break;
			case 3:	dir[1] = -2.0;					break;
			case 4:	dir[0] =  2.0; dir[1] =  2.0;	break;
			case 5:	dir[0] = -2.0; dir[1] =  2.0;	break;
			case 6:	dir[0] =  2.0; dir[1] = -2.0;	break;
			default: dir[0] = -2.0; dir[1] = -2.0;	break;
		}

		HLPushMove(map, origin, dir, &tr);

		//retry the move that was refused
		velocity[0] = oldvel[0];
		velocity[1] = oldvel[1];
		velocity[2] = 0.0;

		clip = HLFlyMove(map, origin, velocity, 0.1, NULL, NULL);

		dx = origin[0] - oldorg[0];
		dy = origin[1] - oldorg[1];
		if (dx < 0.0) dx = -dx;
		if (dy < 0.0) dy = -dy;

		if (dx > 4.0 || dy > 4.0)
			return clip;

		//no progress, back to the start and try the next direction
		HLVecCopy(oldorg, origin);
	}

	HLVecSet(velocity, 0.0, 0.0, 0.0);
	return HLBLOCK_FLOOR | HLBLOCK_WALL;
}

U0 HLWalkMove(CHLMap *map, F64 *origin, F64 *velocity, F64 dt, Bool old_ground,
	Bool *_ground, F64 *view_angles, I64 water_level = 0,
	Bool waterjump = FALSE)
{//SV_WalkMove: walk, climbing steps where a step is what blocked the move
 //
 //the step-up is not speculative - it runs only when the flat move hit a wall
 //and the player was already on the ground, which is what stops wall climbing
 //mid-jump.
 //
 //the stepped result is kept only if the move DOWN lands on real floor. near
 //a wall-slope junction it can end up on a face too steep to stand on.
	F64		oldorg[3];
	F64		oldvel[3];
	F64		nosteporg[3];
	F64		nostepvel[3];
	F64		upmove[3];
	F64		downmove[3];
	CHLTrace	downtrace;
	CHLTrace	steptrace;
	CHLTrace	tr;
	F64		dx;
	F64		dy;
	I64		clip;
	Bool	flat_ground = FALSE;
	Bool	step_ground = FALSE;
	Bool	obstructed;
	F64		want_d;
	F64		got_d;
	U8		*verdict;

	HLVecCopy(origin, oldorg);
	HLVecCopy(velocity, oldvel);

	//globals aren't zeroed - an unfilled slot would print as a real surface
	hl_stair_nz_count = 0;
	hl_stair_nz[0]    = 0.0;
	hl_stair_nz[1]    = 0.0;
	hl_stair_nz[2]    = 0.0;
	hl_stair_nz[3]    = 0.0;

	clip = HLFlyMove(map, origin, velocity, dt, &flat_ground, &steptrace);

	//was the move actually obstructed? gravity means ordinary walking always
	//ends at fraction 0 on a normal of 1, so distance asked vs distance got is
	//the only thing that separates blocked from walking
	want_d = Sqrt(oldvel[0] * oldvel[0] + oldvel[1] * oldvel[1]) * dt;
	got_d  = Sqrt((origin[0] - oldorg[0]) * (origin[0] - oldorg[0]) +
				  (origin[1] - oldorg[1]) * (origin[1] - oldorg[1]));

	obstructed = ToBool(want_d > 1.0 && got_d < want_d * 0.5);

	//nothing wall-like stopped it, so there is no step to climb. logged
	//anyway: from outside this looks identical to a step that failed.
	if ((clip & HLBLOCK_WALL) == 0)
	{
		if (hl_stair_log && obstructed &&
			hl_stair_reports < HLSTAIR_MAX_REPORTS)
		{
			hl_stair_reports++;
			StrPrint(hl_stair_line,
				"stair: BLOCKED clip %d want %5.2f got %5.2f old %d "
				"hit %d: %6.3f %6.3f %6.3f %6.3f\n",
				clip, want_d, got_d, HLStairFlag(old_ground),
				hl_stair_nz_count,
				hl_stair_nz[0], hl_stair_nz[1], hl_stair_nz[2], hl_stair_nz[3]);
			HLLog(hl_stair_line);
			HLLogFlush;
		}

		if (_ground)
			*_ground = flat_ground;
		return;
	}

	//no stairs while airborne, unless in water. SV_WalkMove guards on
	//!oldonground && waterlevel == 0, which is how a swimmer climbs out onto
	//a ledge without jumping.
	if (!old_ground && water_level == 0)
	{
		if (hl_stair_log && obstructed &&
			hl_stair_reports < HLSTAIR_MAX_REPORTS)
		{
			hl_stair_reports++;
			HLLog("stair: BLOCKED but AIRBORNE - step refused\n");
			HLLogFlush;
		}

		if (_ground)
			*_ground = flat_ground;
		return;
	}

	//FL_WATERJUMP is already scripted movement, a step on top of it fights it
	if (waterjump)
	{
		if (hl_stair_log && obstructed &&
			hl_stair_reports < HLSTAIR_MAX_REPORTS)
		{
			hl_stair_reports++;
			HLLog("stair: BLOCKED but WATERJUMP - step refused\n");
			HLLogFlush;
		}

		if (_ground)
			*_ground = flat_ground;
		return;
	}

	//keep the un-stepped result so it can be restored
	HLVecCopy(origin, nosteporg);
	HLVecCopy(velocity, nostepvel);

	//back to the start, lift by a step, retry horizontally
	HLVecCopy(oldorg, origin);

	HLVecSet(upmove, 0.0, 0.0, HLPHYS_STEPSIZE);
	HLVecSet(downmove, 0.0, 0.0, -HLPHYS_STEPSIZE + oldvel[2] * dt);

	HLPushMove(map, origin, upmove, &tr);

	velocity[0] = oldvel[0];
	velocity[1] = oldvel[1];
	velocity[2] = 0.0;

	clip = HLFlyMove(map, origin, velocity, dt, &step_ground, &steptrace);

	//hull seams can eat the step even when a legal move exists two units away
	if (clip)
	{
		dx = origin[0] - oldorg[0];
		dy = origin[1] - oldorg[1];
		if (dx < 0.0) dx = -dx;
		if (dy < 0.0) dy = -dy;

		if (dx < 0.03125 && dy < 0.03125)
			clip = HLTryUnstick(map, origin, velocity, oldvel);
	}

	//extra friction for running at a wall head-on
	if ((clip & HLBLOCK_WALL) && view_angles)
		HLWallFriction(velocity, view_angles, steptrace.plane_normal);

	//settle back down onto whatever is below
	HLPushMove(map, origin, downmove, &downtrace);

	//which rejection fired, and what the down-trace landed on - the normal is
	//the whole decision
	if (hl_stair_log && hl_stair_reports < HLSTAIR_MAX_REPORTS)
	{
		hl_stair_reports++;

		if (downtrace.plane_normal[2] > 0.7)
			verdict = "KEPT";
		else
			verdict = "REVERT";

		StrPrint(hl_stair_line,
			"stair: up %4.1f fwd(%5.2f,%5.2f) clip %d dn n_z %4.2f %s\n",
			origin[2] - oldorg[2],
			origin[0] - oldorg[0], origin[1] - oldorg[1],
			clip, downtrace.plane_normal[2], verdict);

		HLLog(hl_stair_line);
		HLLogFlush;
	}

	if (downtrace.plane_normal[2] > 0.7)
	{
		if (_ground)
			*_ground = TRUE;
	}
	else
	{
		//nothing worth standing on, discard the step
		HLVecCopy(nosteporg, origin);
		HLVecCopy(nostepvel, velocity);

		if (_ground)
			*_ground = flat_ground;
	}
}

U0 HLAccelerate(F64 *velocity, F64 *wishdir, F64 wishspeed, F64 accel, F64 dt)
{//add speed along wishdir, never past wishspeed in that direction
	F64 current = HLVecDot(velocity, wishdir);
	F64 add     = wishspeed - current;
	F64 amount;

	if (add <= 0.0)
		return;

	amount = accel * dt * wishspeed;
	if (amount > add)
		amount = add;

	HLVecMA(velocity, amount, wishdir, velocity);
}

U0 HLAirAccelerate(F64 *velocity, F64 *wishdir, F64 wishspeed, F64 accel,
	F64 dt)
{//PM_AirAccelerate
 //
 //the asymmetry below is the whole trick, and it is deliberate in the SDK:
 //the speed CAP is applied to the target (addspeed), but the step size still
 //scales with the UNCAPPED wishspeed. so moving sideways relative to your
 //velocity keeps adding speed the cap never sees, which is airstrafing.
 //"fixing" it to use the capped value removes HL movement entirely
	F64 wishspd = wishspeed;
	F64 current;
	F64 add;
	F64 amount;

	if (wishspd > HLPHYS_AIRSPEEDCAP)
		wishspd = HLPHYS_AIRSPEEDCAP;

	current = HLVecDot(velocity, wishdir);
	add     = wishspd - current;

	if (add <= 0.0)
		return;

	amount = accel * wishspeed * dt;
	if (amount > add)
		amount = add;

	HLVecMA(velocity, amount, wishdir, velocity);
}

U0 HLCheckVelocity(F64 *velocity)
{//PM_CheckVelocity - per axis, so a diagonal is not clamped harder
	I64 i;

	for (i = 0; i < 3; i++)
	{
		if (velocity[i] > HLPHYS_MAXVELOCITY)
			velocity[i] = HLPHYS_MAXVELOCITY;
		if (velocity[i] < -HLPHYS_MAXVELOCITY)
			velocity[i] = -HLPHYS_MAXVELOCITY;
	}
}

U0 HLPreventMegaBunny(F64 *velocity)
{//PM_PreventMegaBunnyJumping - called on the jump, not every frame
	F64 maxscaled = HLPHYS_BUNNY_FACTOR * HLPHYS_MAXSPEED;
	F64 spd       = HLVecLength(velocity);
	F64 fraction;

	if (spd <= maxscaled)
		return;

	fraction = (maxscaled / spd) * HLPHYS_BUNNY_SCALE;

	velocity[0] *= fraction;
	velocity[1] *= fraction;
	velocity[2] *= fraction;
}

U0 HLFriction(CHLMap *map, F64 *origin, F64 *velocity, F64 dt)
{//PM_Friction, ground branch only - the caller runs it only when on ground
 //stopspeed floor keeps the stop crisp
	CHLTrace tr;
	F64 speed = Sqrt(velocity[0] * velocity[0] + velocity[1] * velocity[1] +
					 velocity[2] * velocity[2]);
	F64 start[3];
	F64 stop[3];
	F64 zbox[3];
	F64 friction;
	F64 control;
	F64 drop;
	F64 newspeed;

	if (speed < 0.1)
	{
		velocity[0] = 0.0;
		velocity[1] = 0.0;
		return;
	}

	//--- EDGE FRICTION ---
	//probe 16 units ahead along the direction of travel and 34 down from the
	//feet. nothing under it means the leading edge is over a drop, and
	//movevars->edgefriction DOUBLES friction there. this is why HL lets the
	//player stop on the lip of a ledge instead of skating off it. one trace a
	//tick, and it is the cheap half of "per-surface" friction.
	friction = HLPHYS_FRICTION;

	//divided by the FULL speed, as the original does, so a fast descent
	//shortens the horizontal reach of the probe
	start[0] = origin[0] + velocity[0] / speed * 16.0;
	start[1] = origin[1] + velocity[1] / speed * 16.0;
	start[2] = origin[2] + hl_player_mins[2];
	stop[0]  = start[0];
	stop[1]  = start[1];
	stop[2]  = start[2] - 34.0;

	//DEVIATION: a POINT trace, as quake's SV_UserFriction does, not
	//pm_shared's PM_PlayerTrace. the start is at FOOT height while the trace
	//sweeps the box's CENTRE, so with the player hull the box would begin 36
	//units into the floor, come back start_solid at fraction 1, and double the
	//friction on every surface in the game
	HLVecSet(zbox, 0.0, 0.0, 0.0);
	HLTraceEntity(map, start, stop, zbox, zbox, hl_move_pass, FALSE, &tr);

	if (tr.fraction == 1.0)
		friction *= HLPHYS_EDGEFRICTION;

	//pmove->friction. see hl_surface_friction - nothing sets it yet
	friction *= hl_surface_friction;

	if (speed < HLPHYS_STOPSPEED)
		control = HLPHYS_STOPSPEED;
	else
		control = speed;

	drop     = control * friction * dt;
	newspeed = speed - drop;

	if (newspeed < 0.0)
		newspeed = 0.0;

	newspeed /= speed;

	velocity[0] *= newspeed;
	velocity[1] *= newspeed;
	velocity[2] *= newspeed;
}

U0 HLWaterMove(CHLMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, F64 dt, Bool *_ground, I64 water_level = 2)
{//PM_WaterMove - HL's, not quake's SV_WaterMove that stood here before
 //
 //three numbers differ from quake and all three are felt: friction is 1 per
 //second rather than 4, it is scaled by pmove->friction (the surface
 //multiplier) and NOT by movevars->friction, and the wish is cut to 0.8 rather
 //than 0.7. the acceleration is also measured against the POST-friction speed.
 //
 //water_level only reaches the move at the bottom, which needs to know the
 //player is in liquid at all to allow a step
	F64  wishvel[3];
	F64  temp[3];
	F64  wish;
	F64  speed;
	F64  newspeed;
	F64  addspeed;
	F64  accelspeed;
	Bool on_ground;

	//user intent. the caller keeps the VERTICAL component of the wish while
	//submerged, which is what makes looking up and pressing forward swim up
	HLVecScale(wishdir, wishspeed, wishvel);

	//"drift towards bottom" - no input at all sinks rather than hovers, and
	//also drives the feet into a platform so it can be named as ground below
	if (wishspeed < 1.0)
		wishvel[2] -= HLPHYS_WATERSINK;

	wish = HLVecLength(wishvel);
	if (wish > HLPHYS_MAXSPEED)
	{
		HLVecScale(wishvel, HLPHYS_MAXSPEED / wish, wishvel);
		wish = HLPHYS_MAXSPEED;
	}

	//"Slow us down a bit"
	wish *= HLPHYS_WATERSPEED;

	//--- water friction ---
	HLVecCopy(velocity, temp);
	speed    = HLVecNormalize(temp);
	newspeed = 0.0;

	if (speed > 0.0)
	{
		newspeed = speed - dt * speed * HLPHYS_WATERFRICTION *
			hl_surface_friction;
		if (newspeed < 0.0)
			newspeed = 0.0;

		HLVecScale(velocity, newspeed / speed, velocity);
	}

	//--- water acceleration ---
	//the ORDER matters: friction has already run, so the shortfall is measured
	//against the POST-friction speed. accelerating first and then bleeding it
	//off gives a noticeably weaker swim
	if (wish >= 0.1)
	{
		addspeed = wish - newspeed;

		if (addspeed > 0.0)
		{
			HLVecNormalize(wishvel);

			accelspeed = HLPHYS_ACCEL * wish * dt * hl_surface_friction;
			if (accelspeed > addspeed)
				accelspeed = addspeed;

			HLVecMA(velocity, accelspeed, wishvel, velocity);
		}
	}

	//--- the move ---
	//
	//DEVIATION, and the one place this does not follow PM_WaterMove. the SDK
	//(and quake's SV_WaterMove before it) ends with "assume it is a stair or a
	//slope, so press down from stepheight above": build the destination, probe
	//straight DOWN onto it from a step above, and keep the result if the probe
	//was not in solid. two problems with that here.
	//
	//  - the probe is purely VERTICAL, so nothing ever tests the HORIZONTAL
	//    path. any wall thin enough that the far side is open at both heights
	//    is swum straight through. that is a real quake bug, not a feature to
	//    reproduce.
	//  - it cannot name what it landed on, and resting on a brush entity has to
	//    set ground + groundentity or SV_PushMove never treats the player as a
	//    rider and a plat crushes them instead of carrying them.
	//
	//HLWalkMove does the same job honestly: slide the real move, and if a WALL
	//stopped it, retry a step higher. its own airborne guard is written
	//`!old_ground && water_level == 0` precisely so that a swimmer keeps the
	//step retry - that is how you climb submerged stairs and get out of a pool
	//onto a ledge without jumping, which is the behaviour the SDK's probe was
	//there to provide.
	//
	//cleared as SV_WalkMove clears FL_ONGROUND; the move restores it on contact
	hl_ground_entity = 0;
	on_ground        = FALSE;

	//old_ground FALSE: floating, not standing. no view angles either - wall
	//friction is a running-into-a-wall effect and does not belong in water
	HLWalkMove(map, origin, velocity, dt, FALSE, &on_ground, NULL,
		water_level, FALSE);

	if (_ground)
		*_ground = on_ground;
}

//item touch boxes are padded; the builtins need this too, so it lives here
//rather than in HLGame.ZC
#define HLFL_ITEM_LINK	256

U0 HLGameLinkEdict(I64 ent)
{//SV_LinkEdict: recompute absmin/absmax from origin and box
 //
 //engine-owned - QuakeC reads them constantly and never writes them.
 //FireBullets takes its muzzle height from absmin_z, and findradius and
 //T_RadiusDamage measure with them.
	F64 org[3];
	I64 j;

	if (ent < 0 || ent >= hl_pr_max_edicts)
		return;
	if (hl_fld_absmin < 0 || hl_fld_absmax < 0)
		return;

	for (j = 0; j < 3; j++)
		org[j] = HLPrFieldF(ent, hl_fld_origin + j);

	//the abs box is expanded so touching boxes still register - movement stops
	//an epsilon short of surfaces.
	//
	//the 15 unit item margin is X AND Y ONLY: on Z it would reach below the
	//floor and every box test would start inside solid.
	for (j = 0; j < 3; j++)
	{
		HLPrSetFieldF(ent, hl_fld_absmin + j,
			org[j] + HLPrFieldF(ent, hl_fld_mins + j));
		HLPrSetFieldF(ent, hl_fld_absmax + j,
			org[j] + HLPrFieldF(ent, hl_fld_maxs + j));
	}

	if (ToI64(HLPrFieldF(ent, hl_fld_flags)) & HLFL_ITEM_LINK)
	{
		for (j = 0; j < 2; j++)
		{
			HLPrSetFieldF(ent, hl_fld_absmin + j,
				HLPrFieldF(ent, hl_fld_absmin + j) - 15.0);
			HLPrSetFieldF(ent, hl_fld_absmax + j,
				HLPrFieldF(ent, hl_fld_absmax + j) + 15.0);
		}
	}
	else
	{
		for (j = 0; j < 3; j++)
		{
			HLPrSetFieldF(ent, hl_fld_absmin + j,
				HLPrFieldF(ent, hl_fld_absmin + j) - 1.0);
			HLPrSetFieldF(ent, hl_fld_absmax + j,
				HLPrFieldF(ent, hl_fld_absmax + j) + 1.0);
		}
	}
}

//--- water jump ------------------------------------------------------------
//
// PM_CheckWaterJump / PM_WaterJump. climbing out of a pool onto a ledge too
// high to swim over: the engine takes the move away from the player for two
// seconds and pushes them at the ledge while they rise.

U0 HLCheckWaterJump(CHLMap *map, F64 *origin, F64 *velocity, F64 *view_angles)
{//arm a water jump when the player is swimming INTO a near-vertical ledge
	CHLTrace tr;
	F64 flat_fwd[3];
	F64 flat_vel[3];
	F64 vec_start[3];
	F64 vec_end[3];
	F64 zbox[3];
	F64 push[3];
	F64 curspeed;
	F64 nz;

	//already going
	if (hl_waterjump_time > 0.0)
		return;

	//"only hop out if we are moving up" - sinking this fast means the player
	//just jumped IN, and popping them back out fights them
	if (velocity[2] < HLPHYS_WJ_SINKING)
		return;

	//no view basis, no idea which way "at the ledge" is
	if (!view_angles)
		return;

	HLAngleVectors(view_angles, flat_fwd, NULL, NULL);
	flat_fwd[2] = 0.0;
	HLVecNormalize(flat_fwd);

	HLVecSet(flat_vel, velocity[0], velocity[1], 0.0);
	curspeed = HLVecNormalize(flat_vel);

	//"are we backing into water from steps or something?" - moving away from
	//where the player is looking is deliberate, do not pop them forward
	if (curspeed > 0.0 && HLVecDot(flat_vel, flat_fwd) < 0.0)
		return;

	//both probes use the POINT hull, as pm_shared switches usehull to do: the
	//question is whether a 24 unit reach is clear, not whether the body fits
	HLVecSet(zbox, 0.0, 0.0, 0.0);

	//low probe, at chest height, looking for the wall
	HLVecCopy(origin, vec_start);
	vec_start[2] += HLPHYS_WJ_HEIGHT;
	HLVecMA(vec_start, HLPHYS_WJ_FORWARD, flat_fwd, vec_end);

	HLTraceEntity(map, vec_start, vec_end, zbox, zbox, hl_move_pass, FALSE,
		&tr);

	if (tr.fraction >= 1.0)
		return;

	nz = tr.plane_normal[2];
	if (nz < 0.0)
		nz = -nz;

	//near vertical only. anything the player could simply swim up is not worth
	//scripting a jump for
	if (nz >= 0.1)
		return;

	//the push is off the LOW probe's plane, so it has to be taken before the
	//trace is reused below. negative: the normal faces back at the player and
	//the jump goes the other way, INTO the ledge
	HLVecScale(tr.plane_normal, HLPHYS_WJ_PUSH, push);

	//high probe, at the top of the box: the ledge has to be CLEAR up there or
	//this is just a wall and the jump would end inside it
	vec_start[2] = origin[2] + hl_player_maxs[2];
	HLVecMA(vec_start, HLPHYS_WJ_FORWARD, flat_fwd, vec_end);

	HLTraceEntity(map, vec_start, vec_end, zbox, zbox, hl_move_pass, FALSE,
		&tr);

	if (tr.fraction < 1.0)
		return;

	hl_waterjump_time = HLPHYS_WJ_TIME;
	HLVecCopy(push, hl_waterjump_dir);
	velocity[2] = HLPHYS_WJ_UP;

	//oldbuttons |= IN_JUMP - the jump is now scripted, so a held jump key must
	//not fire again when it ends
	hl_jump_held = TRUE;
}

Bool HLWaterJumpService(F64 *velocity, I64 water_level, F64 dt)
{//PM_WaterJump: run the timer down and hold the horizontal push
	if (hl_waterjump_time <= 0.0)
		return FALSE;

	//the SDK clamps a nonsense value here because a save game could carry one.
	//kept for the same reason: a timer that never expires disables gravity
	if (hl_waterjump_time > 10.0)
		hl_waterjump_time = 10.0;

	hl_waterjump_time -= dt;

	//timed out, or cleared the water
	if (hl_waterjump_time <= 0.0 || water_level == 0)
	{
		hl_waterjump_time = 0.0;
		return FALSE;
	}

	//the horizontal velocity is REPLACED every tick, not accelerated - that is
	//what makes the pop-out identical every time
	velocity[0] = hl_waterjump_dir[0];
	velocity[1] = hl_waterjump_dir[1];

	return TRUE;
}

//--- fall damage -----------------------------------------------------------
//
// PM_CheckFalling picks the landing sound and the screen punch. the DAMAGE is
// not in pm_shared at all: CBasePlayer::PostThink compares against
// PLAYER_MAX_SAFE_FALL_SPEED, asks the gamerules for FlPlayerFallDamage and
// calls TakeDamage. see hl_fall_damage_pending for why it is only queued here.

U0 HLCheckFalling(Bool on_ground, I64 water_level)
{//end-of-move: settle up for a fall that has just landed
	F64 fvol;

	//one-shot cues, consumed or not
	hl_fall_sound_vol = 0.0;
	hl_fall_pain      = FALSE;

	if (!on_ground)
		return;

	//water breaks a fall completely. pm_shared skips the sound in water and
	//CBasePlayer::WaterMove zeroes the counter, so nothing is ever owed
	if (water_level > 0)
	{
		hl_fall_velocity = 0.0;
		return;
	}

	if (hl_fall_velocity >= HLPHYS_FALL_PUNCH)
	{
		fvol = 0.5;

		if (hl_fall_velocity > HLPHYS_FALL_SAFE)
		{
			//player/pl_fallpain3.wav. the SDK randomises between pain2 and
			//pain3 with a switch whose first case has no break, so case 0
			//falls into case 1 and only pain3 ever plays - its own comment
			//says so. one sound, deliberately
			hl_fall_pain = TRUE;
			fvol         = 1.0;

			//DAMAGE_FOR_FALL_SPEED: everything above the safe speed, scaled so
			//that arriving at PLAYER_FATAL_FALL_SPEED is exactly 100 points.
			//ACCUMULATED, not overwritten - whoever claims this may be a tick
			//behind and two landings must not silently become one
			hl_fall_damage_pending += (hl_fall_velocity - HLPHYS_FALL_SAFE) *
				(100.0 / (HLPHYS_FALL_FATAL - HLPHYS_FALL_SAFE));
		}
		else if (hl_fall_velocity > HLPHYS_FALL_SAFE * 0.5)
			fvol = 0.85;

		//LEFT OUT: the SDK's fourth branch, fvol = 0 below
		//PLAYER_MIN_BOUNCE_SPEED (200). it is unreachable - the outer test
		//already demanded 350 - so a landing loud enough to reach here is
		//never silent

		hl_fall_sound_vol = fvol;

		//punchangle[2], a ROLL and not a pitch. the SDK then clamps
		//punchangle[0], which is a different axis and a bug it has never
		//fixed; the clamp is applied to the axis actually written
		hl_fall_punch_z = hl_fall_velocity * 0.013;
		if (hl_fall_punch_z > 8.0)
			hl_fall_punch_z = 8.0;
	}

	hl_fall_velocity = 0.0;
}

U0 HLPlayerMove(CHLMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, Bool jump, F64 dt, Bool *_on_ground, I64 water_level,
	Bool waterjump, F64 *view_angles = NULL, I64 mover = 0,
	Bool duck = FALSE)
{//one tick of player movement
 //
 //mover is the edict being moved, as SV_FlyMove takes it: HLFlyMove writes the
 //position reached onto it before the touch functions run. a global would
 //make a remote client's move land on whichever edict moved last.
	Bool on_ground;
	Bool wj;
	I64  saved_pass;
	I64  ladder;

	saved_pass  = hl_move_pass;
	hl_move_pass = mover;

	//clamp to sv_maxspeed, as SV_AirMove does
	if (wishspeed > HLPHYS_MAXSPEED)
		wishspeed = HLPHYS_MAXSPEED;

	//PM_Duck runs BEFORE the move: it may resize the trace box and shift the
	//origin, and everything below has to see the result
	on_ground = FALSE;
	if (_on_ground)
		on_ground = *_on_ground;

	//PM_PlayerMove records the fall speed at the TOP of the tick, from the
	//velocity the previous move left behind. it cannot be read after the move -
	//WalkMove has zeroed the downward component by then, so every landing would
	//report zero
	if (!on_ground)
		hl_fall_velocity = -velocity[2];

	HLDuckUpdate(map, origin, duck, on_ground, dt);

	//the conveyor or current under the player. sampled here because the box the
	//duck update just chose decides where the feet are, and because both the
	//walking and the swimming path below want it
	HLBaseVelocity(map, origin, on_ground, water_level, hl_base_velocity);

	//--- func_ladder ---
	//mounted purely by hull overlap, so it is retested every tick, and after
	//PM_Duck because the box in use decides the overlap
	ladder = -1;
	if (view_angles)
		ladder = HLLadderFind(map, origin);

	hl_ladder_ent = ladder;
	hl_on_ladder  = ToBool(ladder >= 0);

	if (ladder >= 0)
	{
		//MOVETYPE_FLY for the tick: no gravity, no friction, no step-up and no
		//base velocity. PM_LadderMove sets the velocity outright and the only
		//thing left to do is move along it
		HLVecSet(hl_base_velocity, 0.0, 0.0, 0.0);

		HLLadderMove(map, ladder, origin, velocity, wishdir, view_angles,
			jump);

		hl_jump_held = jump;

		//grabbing a ladder cancels the fall - nothing is owed on arrival, and
		//a long climb down must not bill for the descent
		hl_fall_velocity  = 0.0;
		hl_fall_sound_vol = 0.0;
		hl_fall_pain      = FALSE;

		on_ground = FALSE;
		HLFlyMove(map, origin, velocity, dt, &on_ground, NULL);

		if (_on_ground)
			*_on_ground = on_ground;

		hl_move_pass = saved_pass;
		return;
	}

	//--- water jump ---
	//the parameter carries the QuakeC-driven flag (PlayerJump sets FL_WATERJUMP
	//and HLPlayerWaterJump services it); hl_waterjump_time is the native
	//PM_CheckWaterJump's own. either one owns the move outright.
	wj = ToBool(waterjump);
	if (HLWaterJumpService(velocity, water_level, dt))
		wj = TRUE;

	//the engine's job during one is to stop interfering - no gravity, no
	//friction, no ground check
	if (wj)
	{
		//scripted movement, so the surface under the player has no say either
		HLVecSet(hl_base_velocity, 0.0, 0.0, 0.0);

		HLSlideMove(map, origin, velocity, dt);

		if (_on_ground)
			*_on_ground = FALSE;

		//restored on EVERY exit. leaking it left the next HLCheckStuck tracing
		//with a stale pass entity
		hl_move_pass = saved_pass;
		return;
	}

	//swimming: no gravity, but still detect standing on BSP. the original
	//clears onground inside WalkMove and lets FlyMove set it again.
	if (water_level >= 2)
	{
		//at the surface only. fully under there is no ledge in reach and
		//PM_CheckWaterJump's low probe would be looking at the pool wall
		if (water_level == 2)
			HLCheckWaterJump(map, origin, velocity, view_angles);

		//"if we are falling again, then we must not be trying to jump out of
		//water any more"
		if (velocity[2] < 0.0 && hl_waterjump_time > 0.0)
			hl_waterjump_time = 0.0;

		//a current in the water is carried the same way a conveyor is, and this
		//is the case CONTENTS_CURRENT_* mostly exists for. PM_WaterMove folds
		//basevelocity in before its own friction, so the current is dragged
		//along with everything else rather than added on top of the result
		HLVecAdd(velocity, hl_base_velocity, velocity);

		HLWaterMove(map, origin, velocity, wishdir, wishspeed, dt, &on_ground,
			water_level);

		HLVecSub(velocity, hl_base_velocity, velocity);
		HLCheckVelocity(velocity);

		//water breaks the fall, so a dive owes nothing on touching bottom
		hl_fall_velocity  = 0.0;
		hl_fall_sound_vol = 0.0;
		hl_fall_pain      = FALSE;

		if (_on_ground)
			*_on_ground = on_ground;

		hl_move_pass = saved_pass;
		return;
	}

	//ground state comes from the PREVIOUS move, as SV_ClientThink reads
	//FL_ONGROUND. no downward probe - a 2-unit look-down finds floor at high
	//frame rates and the jump never leaves the ground.

	//PM_AddCorrectGravity: HALF the tick's gravity before the move and half
	//after. leapfrog integration, and the reason an HL jump arc does not
	//match a quake one even at identical constants
	velocity[2] -= HLPHYS_GRAVITY * hl_gravity_scale * 0.5 * dt;
	HLCheckVelocity(velocity);

	//user input first: friction and acceleration, per PM_WalkMove.
	//
	//base velocity was sampled above and is folded in AFTER friction, not
	//before. pm_shared spells out why: "friction is handled before we add in
	//any base velocity. That way, if we are on a conveyor, we don't slow when
	//standing still, relative to the conveyor"
	if (on_ground)
	{
		HLFriction(map, origin, velocity, dt);
		HLAccelerate(velocity, wishdir, wishspeed, HLPHYS_ACCEL, dt);

		//only reached without the VM; PlayerJump owns this otherwise
		if (jump && !hl_jump_held)
		{
			//scale the whole velocity back before adding the jump, or each
			//hop compounds the last one without limit
			HLPreventMegaBunny(velocity);

			velocity[2] = HLPHYS_JUMP;
			on_ground   = FALSE;
		}
	}
	else
	{
		//capped-target acceleration - see HLAirAccelerate
		HLAirAccelerate(velocity, wishdir, wishspeed, HLPHYS_AIRACCEL, dt);
	}

	hl_jump_held = jump;

	//PM_WalkMove and PM_AirMove both fold base velocity in immediately before
	//the move
	HLVecAdd(velocity, hl_base_velocity, velocity);

	HLWalkMove(map, origin, velocity, dt, on_ground, &on_ground, view_angles,
		water_level, waterjump);

	//and PM_PlayerMove pulls it straight back out, so the player's own velocity
	//never accumulates the surface's - step off a conveyor and the carry stops
	//with the step
	HLVecSub(velocity, hl_base_velocity, velocity);
	HLCheckVelocity(velocity);

	//PM_FixupGravityVelocity: the other half of the tick's gravity, after the
	//move. skipped when the move ended on the floor - WalkMove has already
	//zeroed the downward component there and re-applying it just accumulates
	if (!on_ground)
	{
		velocity[2] -= HLPHYS_GRAVITY * hl_gravity_scale * 0.5 * dt;
		HLCheckVelocity(velocity);
	}

	//landing sound, screen punch, and the fall damage queued for whoever owns
	//health. reads hl_fall_velocity, captured at the top of this function
	HLCheckFalling(on_ground, water_level);

	if (_on_ground)
		*_on_ground = on_ground;

	hl_move_pass = saved_pass;
}
