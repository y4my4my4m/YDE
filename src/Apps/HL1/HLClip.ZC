// entity-aware collision and player movement, from world.c
// (SV_Move and friends) and sv_phys/sv_user.
//
// needs the edict field table, so it sits after HLProgs. HLPhys traces hulls
// against the world BSP alone; here traces also hit every solid edict.

#define HLSOLID_NOT_			0
#define HLSOLID_TRIGGER_		1
#define HLSOLID_BBOX_		2
#define HLSOLID_SLIDEBOX_	3
#define HLSOLID_BSP_			4

#define HLCLIP_MAX_PRECACHE	1024

I64 hl_precache_bmodel[HLCLIP_MAX_PRECACHE];

U0 HLClipPrecacheReset()
{
	I64 i;

	for (i = 0; i < HLCLIP_MAX_PRECACHE; i++)
		hl_precache_bmodel[i] = -1;
}

I64 HLClipBrushModel(I64 precache_index)
{
	if (precache_index < 1 || precache_index >= HLCLIP_MAX_PRECACHE)
		return -1;

	return hl_precache_bmodel[precache_index];
}

Bool hl_brush_rotates[HLENT_MAX];


U0 HLClipRotatingReset()
{
	I64 i;

	for (i = 0; i < HLENT_MAX; i++)
		hl_brush_rotates[i] = FALSE;
}

U0 HLClipSetRotating(I64 ent, Bool on)
{
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	hl_brush_rotates[ent] = on;
}

U0 HLClipSetRotatingDraw(I64 ent, Bool on)
{
	HLClipSetRotating(ent, on);
}

Bool HLClipIsRotatingDraw(I64 ent)
{
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return hl_brush_rotates[ent];
}

Bool HLClipIsRotating(I64 ent)
{
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return hl_brush_rotates[ent];
}

U0 HLHullClipMins(I64 hull, F64 *out)
{
	if (hull == 1)
		HLVecSet(out, -16.0, -16.0, -36.0);
	else if (hull == 2)
		HLVecSet(out, -32.0, -32.0, -32.0);
	else if (hull == 3)
		HLVecSet(out, -16.0, -16.0, -18.0);
	else
		HLVecSet(out, 0.0, 0.0, 0.0);
}

U0 HLHullOffset(I64 hull, F64 *mins, F64 *offset)
{
	F64 clip[3];
	I64 j;

	HLHullClipMins(hull, clip);

	for (j = 0; j < 3; j++)
		offset[j] = clip[j] - mins[j];
}

I64 HLHullForSize(F64 *mins, F64 *maxs)
{
	F64 width  = maxs[0] - mins[0];
	F64 height = maxs[2] - mins[2];

	if (width < 3.0)
		return 0;

	if (width <= 32.0)
	{
		if (height <= 36.0)
			return 3;

		return 1;
	}

	return 2;
}

U0 HLTraceInit(CHLTrace *trace, F64 *end)
{
	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	trace->in_open     = FALSE;
	trace->in_water    = FALSE;
	HLVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	HLVecCopy(end, trace->end_pos);
}

U0 HLTraceHullRotated(CHLMap *map, I64 model, I64 hull, F64 *offset,
	F64 *angles, F64 *start, F64 *end, CHLTrace *trace)
{
	F64  lstart[3];
	F64  lend[3];
	F64  wstart[3];
	F64  wend[3];
	F64  nrm[3];
	F64  m[12];
	I64  head;
	I64  i;
	Bool rotated = FALSE;

	HLTraceInit(trace, end);

	if (!HLMapValid(map, "HLTraceHull"))
		return;

	if (model < 0 || model >= map->num_models)
		return;

	if (hull < 0 || hull > 3)
		hull = 1;

	if (hull)
		head = map->models[model].head_node[hull];
	else
		head = map->models[model].hull0_head;

	if (head < 0)
		return;

	if (model > 0 && head == 0)
		return;

	if (angles)
	{
		if (HLMatAnglesActive(angles))
			rotated = TRUE;
	}

	if (rotated)
	{
		HLMatFromAngles(angles, offset, m);

		HLMatTransformInv(start, m, lstart);
		HLMatTransformInv(end, m, lend);
	}
	else
	{
		HLVecSub(start, offset, lstart);
		HLVecSub(end, offset, lend);
	}

	HLVecCopy(lend, trace->end_pos);

	hl_hull_head = head;
	HLRecursiveHullCheck(map, head, 0.0, 1.0, lstart, lend, trace);

	if (!rotated)
	{
		HLVecAdd(trace->end_pos, offset, trace->end_pos);
		return;
	}


	if (trace->hit)
	{
		HLMatRotate(trace->plane_normal, m, nrm);
		HLVecCopy(nrm, trace->plane_normal);

		trace->plane_dist += HLVecDot(trace->plane_normal, offset);
	}

	HLVecCopy(start, wstart);
	HLVecCopy(end, wend);

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = wstart[i] + (wend[i] - wstart[i]) * trace->fraction;
}

U0 HLTraceHull(CHLMap *map, I64 model, I64 hull, F64 *offset, F64 *start,
	F64 *end, CHLTrace *trace)
{
	HLTraceHullRotated(map, model, hull, offset, NULL, start, end, trace);
}

U0 HLClipMoveToBox(F64 *bmins, F64 *bmaxs, F64 *mins, F64 *maxs, F64 *start,
	F64 *end, CHLTrace *trace)
{
	F64  emins[3];
	F64  emaxs[3];
	F64  d;
	F64  t1;
	F64  t2;
	F64  swap;
	F64  enter    = 0.0;
	F64  leave    = 1.0;
	F64  sign     = 0.0;
	I64  axis     = -1;
	I64  i;
	Bool inside   = TRUE;

	HLTraceInit(trace, end);

	for (i = 0; i < 3; i++)
	{
		emins[i] = bmins[i] - maxs[i];
		emaxs[i] = bmaxs[i] - mins[i];

		if (start[i] < emins[i] - HLPHYS_EPSILON ||
			start[i] > emaxs[i] + HLPHYS_EPSILON)
			inside = FALSE;
	}

	if (inside)
	{
		trace->all_solid   = FALSE;
		trace->start_solid = TRUE;
		return;
	}

	for (i = 0; i < 3; i++)
	{
		d = end[i] - start[i];

		if (d > -HLPHYS_EPSILON && d < HLPHYS_EPSILON)
		{
			if (start[i] < emins[i] || start[i] > emaxs[i])
			{
				trace->all_solid = FALSE;
				return;
			}
		}
		else
		{
			t1 = (emins[i] - start[i]) / d;
			t2 = (emaxs[i] - start[i]) / d;

			if (t1 > t2)
			{
				swap = t1;
				t1   = t2;
				t2   = swap;
			}

			if (t1 > enter)
			{
				enter = t1;
				axis  = i;
				if (d < 0.0)
					sign = 1.0;
				else
					sign = -1.0;
			}

			if (t2 < leave)
				leave = t2;

			if (enter > leave)
			{
				trace->all_solid = FALSE;
				return;
			}
		}
	}

	trace->all_solid = FALSE;

	if (axis < 0 || enter >= 1.0)
		return;

	enter -= HLPHYS_EPSILON;
	if (enter < 0.0)
		enter = 0.0;

	trace->fraction          = enter;
	trace->hit               = TRUE;
	trace->plane_normal[axis] = sign;

	for (i = 0; i < 3; i++)
		trace->end_pos[i] = start[i] + (end[i] - start[i]) * enter;
}

I64 hl_trace_native_ent = -1;

I64 hl_trace_native_solid = -1;

U0 HLClipToNativeBrushes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 eofs[3];
	I64			 ehull;
	I64			 i;
	I64			 j;

	if (!hl_entities || !HLMapValid(map, "HLClipToNativeBrushes"))
		return;

	ehull = HLHullForSize(mins, maxs);

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->solid != HLSOLID_BSP)
			goto qcnb_next;

		if (e->monsterclip && !hl_clip_for_monster)
			goto qcnb_next;

		if (e->brush_model < 1 || e->brush_model >= map->num_models)
			goto qcnb_next;

		HLHullOffset(ehull, mins, eofs);
		for (j = 0; j < 3; j++)
			eofs[j] += e->origin[j];

		if (hl_brush_rotates[i])
			HLTraceHullRotated(map, e->brush_model, ehull, eofs, e->angles,
				start, end, &tr);
		else
			HLTraceHull(map, e->brush_model, ehull, eofs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);
			hl_trace_native_ent = i;
		}

		if (tr.start_solid)
		{
			trace->start_solid    = TRUE;
			hl_trace_native_solid = i;
		}

qcnb_next:
	}
}

U0 HLTraceEntity(CHLMap *map, F64 *start, F64 *end, F64 *mins, F64 *maxs,
	I64 pass, Bool nomonsters, CHLTrace *trace)
{
	I64 hull = HLHullForSize(mins, maxs);
	F64 offset[3];

	//world sits at the origin, so the offset is box vs hull only
	HLHullOffset(hull, mins, offset);

	HLTraceHull(map, 0, hull, offset, start, end, trace);

	if (trace->all_solid)
		return;

	hl_trace_native_ent   = -1;
	hl_trace_native_solid = -1;

	no_warn pass;

	HLClipToNativeBrushes(map, start, end, mins, maxs, trace);

	if (!nomonsters && hl_ent_slidebox_hook)
		hl_ent_slidebox_hook(map, start, end, mins, maxs, trace);
}



F64 hl_player_mins[3];
F64 hl_player_maxs[3];


#define HLPM_DUCK_MULT		0.333

#define HLPM_DUCK_TIMER		1.0

Bool hl_jump_held    = FALSE;

Bool hl_duck_held_last = FALSE;

F64  hl_step_time  = 0.0;
I64  hl_step_side  = 0;
Bool hl_step_play  = FALSE;

F64  hl_step_dist  = 0.0;

I64 hl_step_kind = HLSTEP_CONCRETE;
F64 hl_step_vol  = 0.5;

F64 hl_gravity_scale = 1.0;

Bool hl_ducking      = FALSE;
Bool hl_duck_pending = FALSE;
F64	 hl_duck_time    = 0.0;
F64	 hl_view_ofs_z   = HLPHYS_VIEW_Z;

U0 HLDuckSetHull(Bool ducked)
{//pmove->usehull: point the trace box at hull 1 or hull 3
	if (ducked)
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_DUCK_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_DUCK_MAXS_Z);
	}
	else
	{
		HLVecSet(hl_player_mins, -16.0, -16.0, HLPHYS_MINS_Z);
		HLVecSet(hl_player_maxs,  16.0,  16.0, HLPHYS_MAXS_Z);
	}
}

F64 HLDuckSpline(F64 t)
{
	F64 tt = t * t;

	return 3.0 * tt - 2.0 * tt * t;
}

U0 HLDuckReset()
{
	hl_jump_held      = FALSE;
	hl_duck_held_last = FALSE;
	hl_gravity_scale  = 1.0;
	hl_step_time      = 0.0;
	hl_step_dist      = 0.0;
	hl_step_side      = 0;
	hl_step_play      = FALSE;
	hl_step_kind      = HLSTEP_CONCRETE;
	hl_step_vol       = 0.5;
	hl_ducking        = FALSE;
	hl_duck_pending   = FALSE;
	hl_duck_time      = 0.0;
	hl_view_ofs_z     = HLPHYS_VIEW_Z;
	HLDuckSetHull(FALSE);
}

#define HLPM_STUCK_SLOTS		54

F64 hl_pm_stuck_table[HLPM_STUCK_SLOTS * 3];

U0 HLPMStuckPut(I64 *idx, F64 x, F64 y, F64 z)
{
	I64 i = *idx;

	if (i < 0 || i >= HLPM_STUCK_SLOTS)
		return;

	hl_pm_stuck_table[i * 3]     = x;
	hl_pm_stuck_table[i * 3 + 1] = y;
	hl_pm_stuck_table[i * 3 + 2] = z;

	*idx = i + 1;
}

U0 HLPMCreateStuckTable()
{
	F64 zi[3];
	I64 idx = 0;
	I64 i;
	I64 j;
	I64 k;

	for (i = 0; i < HLPM_STUCK_SLOTS * 3; i++)
		hl_pm_stuck_table[i] = 0.0;

	for (i = -1; i <= 1; i++)
	{
		HLPMStuckPut(&idx, 0.0, 0.0, ToF64(i) * 0.125);
	}

	for (i = -1; i <= 1; i++)
	{
		HLPMStuckPut(&idx, 0.0, ToF64(i) * 0.125, 0.0);
	}

	for (i = -1; i <= 1; i++)
	{
		HLPMStuckPut(&idx, ToF64(i) * 0.125, 0.0, 0.0);
	}

	for (i = -1; i <= 1; i += 2)
	{
		for (j = -1; j <= 1; j += 2)
		{
			for (k = -1; k <= 1; k += 2)
			{
				HLPMStuckPut(&idx, ToF64(i) * 0.125, ToF64(j) * 0.125,
					ToF64(k) * 0.125);
			}
		}
	}

	zi[0] = 0.0;
	zi[1] = 1.0;
	zi[2] = 6.0;

	for (i = 0; i < 3; i++)
	{
		HLPMStuckPut(&idx, 0.0, 0.0, zi[i]);
	}

	for (i = -1; i <= 1; i++)
	{
		HLPMStuckPut(&idx, 0.0, ToF64(i) * 2.0, 0.0);
	}

	for (i = -1; i <= 1; i++)
	{
		HLPMStuckPut(&idx, ToF64(i) * 2.0, 0.0, 0.0);
	}

	for (i = 0; i < 3; i++)
	{
		for (j = -1; j <= 1; j++)
		{
			for (k = -1; k <= 1; k++)
			{
				HLPMStuckPut(&idx, ToF64(j) * 2.0, ToF64(k) * 2.0, zi[i]);
			}
		}
	}
}

I64 hl_move_pass = 0;		//edict doing the current player move, 0 = none

I64 hl_ground_entity = 0;
I64 hl_ground_native = -1;

I64 HLStairFlag(Bool b)
{
	if (b)
		return 1;

	return 0;
}

//stair step-up diagnostics, armed with stairlog 1.
#define HLSTAIR_MAX_REPORTS	200

Bool	hl_stair_log		= FALSE;
I64		hl_stair_reports	= 0;
U8		hl_stair_line[128];
F64		hl_stair_last_nz	  = 0.0;
F64		hl_stair_last_frac = 0.0;
F64		hl_stair_nz[4];
I64		hl_stair_nz_count  = 0;

#define HLRIDE_LINES	1024
#define HLRIDE_WIDTH	256
#define HLRIDE_FLUSH	256

U8	   *hl_ride_buf		= NULL;
Bool	hl_ride_log		= FALSE;
I64		hl_ride_ticks	= 0;
I64		hl_ride_head	= 0;

I64		hl_ride_probe_calls	= 0;
Bool	hl_ride_probe_hit	= FALSE;
Bool	hl_ride_probe_solid	= FALSE;
F64		hl_ride_probe_frac	= 1.0;
F64		hl_ride_probe_nrm[3];
I64		hl_ride_probe_nat	= -1;

I64		hl_ride_rides	= -1;
I64		hl_ride_branch	= 0;

U0 HLRideLogFree()
{
	if (hl_ride_buf)
		Free(hl_ride_buf);

	hl_ride_buf   = NULL;
	hl_ride_log   = FALSE;
	hl_ride_ticks = 0;
	hl_ride_head  = 0;
}

U0 HLRideLogArm()
{
	HLRideLogFree;

	hl_ride_buf = CAlloc(HLRIDE_LINES * HLRIDE_WIDTH);

	hl_ride_probe_calls	= 0;
	hl_ride_probe_hit	= FALSE;
	hl_ride_probe_solid	= FALSE;
	hl_ride_probe_frac	= 1.0;
	HLVecSet(hl_ride_probe_nrm, 0.0, 0.0, 0.0);
	hl_ride_probe_nat	= -1;
	hl_ride_rides		= -1;
	hl_ride_branch		= 0;

	hl_ride_log = ToBool(hl_ride_buf != NULL);
}

U0 HLRideLogPut(U8 *s)
{
	if (!hl_ride_buf)
		return;

	HLStrCopy(hl_ride_buf + hl_ride_head * HLRIDE_WIDTH, s, HLRIDE_WIDTH);

	hl_ride_head = (hl_ride_head + 1) % HLRIDE_LINES;
	hl_ride_ticks++;
}

U0 HLRideLogFlush()
{
	U8 *out;
	U8 *slot;
	I64 count = hl_ride_ticks;
	I64 first;
	I64 len;
	I64 n;
	I64 i;
	I64 k;

	if (!hl_ride_buf || !hl_disk_writes || count <= 0)
		return;

	if (count > HLRIDE_LINES)
		count = HLRIDE_LINES;

	first = (hl_ride_head - count + HLRIDE_LINES) % HLRIDE_LINES;

	//the slack is the legend below, which runs to about 800 bytes
	out = CAlloc(count * (HLRIDE_WIDTH + 1) + 2048);

	if (!out)
		return;

	StrPrint(out,
		"ridelog. one record per server tick, oldest first, 72 Hz.\n"
		"  N T      tick index, hl_ent_time\n"
		"  og gn    hl_pm_onground, hl_ground_native\n"
		"  pc h s   ground probes this tick, trace.hit, trace.start_solid\n"
		"  f n      probe fraction, probe plane normal xyz\n"
		"  pn       hl_trace_native_ent\n"
		"  pa       hl_platform_active\n"
		"  rd br    HLEntPlayerRides for the tracktrain: -1 not asked, 0 no,\n"
		"           1 yes. branch 1 ground clause, 2 box, 3 neither, 4 no player\n"
		"  pv av pi hl_platform_velocity, hl_platform_avel_z, pivot xy\n"
		"  o v      player origin, player velocity\n"
		"  T        tracktrain index, then its origin, angles[1],\n"
		"           avelocity[1]\n\n");

	len = StrLen(out);

	for (i = 0; i < count; i++)
	{
		k    = (first + i) % HLRIDE_LINES;
		slot = hl_ride_buf + k * HLRIDE_WIDTH;
		n    = StrLen(slot);

		MemCopy(out + len, slot, n);
		len += n;

		out[len] = '\n';
		len++;
	}

	out[len] = 0;

	FileWrite("::/Apps/HL1/RIDELOG.TXT", out, len);
	Free(out);
}


