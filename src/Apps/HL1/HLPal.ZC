// HLPal.ZC - global palette and colormap
//
//   gfx/palette.lmp   768 bytes, 256 RGB triples
//
// This is NOT how the world is coloured any more. BSP30 gives every texture
// its own 256 colours, so walls, sprites and studio skins each carry a private
// palette and the renderer composites in RGB. What is left here is the shared
// palette that 2D art is still authored against: the console font, HUD pieces,
// menu lumps and quake-format sprites.
//
// gfx/colormap.lmp is a QUAKE file. valve/ has no such lump, so when it is
// absent the table is generated from the palette instead - it is a pure
// function of the palette anyway.

#define HLPAL_COLORS			256
#define HLPAL_SHADES			64
#define HLPAL_FULLBRIGHT		224		//indices >= this ignore lighting

U8	 hl_pal_rgb[HLPAL_COLORS * 3];
U32	 hl_pal_argb[HLPAL_COLORS];
U8	*hl_pal_colormap = NULL;
Bool hl_pal_loaded = FALSE;

//backing store for the generated table. only used when the lump is missing,
//but a global because hl_pal_colormap normally borrows from a mounted pak and
//must stay valid for as long as one
U8	 hl_pal_colormap_gen[HLPAL_COLORS * HLPAL_SHADES];

I64 HLPalNearest(I64 r, I64 g, I64 b)
{//closest palette entry by squared distance in RGB
	I64 best      = 0;
	I64 best_dist = I64_MAX;
	I64 dr, dg, db, dist;
	I64 i;

	for (i = 0; i < HLPAL_COLORS; i++)
	{
		dr = ToI64(hl_pal_rgb[i * 3])     - r;
		dg = ToI64(hl_pal_rgb[i * 3 + 1]) - g;
		db = ToI64(hl_pal_rgb[i * 3 + 2]) - b;

		dist = dr * dr + dg * dg + db * db;

		if (dist < best_dist)
		{
			best_dist = dist;
			best      = i;
		}
	}

	return best;
}

U0 HLPalBuildColormap()
{//row 0 is the palette untouched, row 63 is black. this is what quake's
 //utility produced and what every consumer of the table assumes
 //
 //the fullbright range is copied through unshaded at every level, exactly as
 //the original does - those indices are lamps and screens
	I64 shade;
	I64 i;
	I64 num;
	I64 r, g, b;

	for (shade = 0; shade < HLPAL_SHADES; shade++)
	{
		//63 steps from full brightness down to zero
		num = (HLPAL_SHADES - 1 - shade) * 255 / (HLPAL_SHADES - 1);

		for (i = 0; i < HLPAL_COLORS; i++)
		{
			if (i >= HLPAL_FULLBRIGHT)
			{
				hl_pal_colormap_gen[shade * HLPAL_COLORS + i] = i;
				goto qpbc_next;
			}

			r = (hl_pal_rgb[i * 3]     * num) / 255;
			g = (hl_pal_rgb[i * 3 + 1] * num) / 255;
			b = (hl_pal_rgb[i * 3 + 2] * num) / 255;

			hl_pal_colormap_gen[shade * HLPAL_COLORS + i] =
				HLPalNearest(r, g, b);

qpbc_next:
		}
	}

	hl_pal_colormap = hl_pal_colormap_gen;
}

Bool HLPalLoad()
{//palette out of the mounted paks, colormap from the file or generated
	U8  *p;
	I64  size = 0;
	I64  i;

	hl_pal_loaded   = FALSE;
	hl_pal_colormap = NULL;

	p = HLPakData("gfx/palette.lmp", &size);
	if (!p || size < HLPAL_COLORS * 3)
	{
		"HLPal: gfx/palette.lmp missing or short\n";
		return FALSE;
	}
	MemCopy(hl_pal_rgb, p, HLPAL_COLORS * 3);

	for (i = 0; i < HLPAL_COLORS; i++)
	{
		hl_pal_argb[i] = (hl_pal_rgb[i * 3] << 16) |
					   (hl_pal_rgb[i * 3 + 1] << 8) |
						hl_pal_rgb[i * 3 + 2];
	}

	p = HLPakData("gfx/colormap.lmp", &size);

	if (p && size >= HLPAL_COLORS * HLPAL_SHADES)
	{
		//borrowed, the pak stays mounted for the life of the program
		hl_pal_colormap = p;
	}
	else
	{
		//the expected case on valve/ - 16k of nearest-colour search, once
		"HLPal: no gfx/colormap.lmp, generating from the palette\n";
		HLPalBuildColormap;
	}

	hl_pal_loaded = TRUE;

	return TRUE;
}

U32 HLPalColor(I64 index)
{//palette index to 0x00RRGGBB
	return hl_pal_argb[index & 255];
}

//--- screen tint -----------------------------------------------------------
//
// 8bpp indices can't be blended - averaging index 10 and 14 gives an unrelated
// colour - so the wash is folded into the palette, as the original does

I64	 hl_tint_r	= 0;
I64	 hl_tint_g	= 0;
I64	 hl_tint_b	= 0;
I64	 hl_tint_a	= 0;		//0 = no tint, 255 = fully the tint colour

//--- gamma -----------------------------------------------------------------
//
// applied by rebuilding the palette, so it costs nothing per frame and covers
// the HUD and menus too
//
// 1.0 is untouched, lower brightens - same sense as the original's slider
#define HLGAMMA_MIN	0.5
#define HLGAMMA_MAX	1.0

F64 hl_gamma			= 1.0;
U8	hl_gamma_ramp[256];
Bool hl_gamma_dirty	= TRUE;

U0 HLPalBuildGammaRamp()
{//ramp[v] = 255 * (v/255) ^ gamma
	F64 g = hl_gamma;
	F64 v;
	I64 i;

	if (g < HLGAMMA_MIN)	g = HLGAMMA_MIN;
	if (g > HLGAMMA_MAX)	g = HLGAMMA_MAX;

	for (i = 0; i < 256; i++)
	{
		if (g == 1.0)
			hl_gamma_ramp[i] = i;
		else
		{
			v = Pow(ToF64(i) / 255.0, g) * 255.0;
			hl_gamma_ramp[i] = ClampI64(ToI64(v + 0.5), 0, 255);
		}
	}

	hl_gamma_dirty = FALSE;
}

//--- display ramps ---------------------------------------------------------
//
// the world is composited in RGB now, so gamma and the damage/water tint can
// no longer hide inside a 256 entry palette. they become three 256 entry
// channel ramps applied at blit time
//
// doing it at blit and not in the surface cache is deliberate: a damage flash
// would otherwise invalidate every cached surface on the screen

U8	hl_disp_r[256];
U8	hl_disp_g[256];
U8	hl_disp_b[256];
Bool hl_disp_identity = TRUE;	//no tint, gamma 1.0 - blit can copy straight

U0 HLPalBuildDisplayRamps()
{
	I64 i;
	I64 v;

	for (i = 0; i < 256; i++)
	{
		//blend toward the tint first, gamma last - the other order lets the
		//tint undo the gamma
		v = i + ((hl_tint_r - i) * hl_tint_a) / 255;
		hl_disp_r[i] = hl_gamma_ramp[ClampI64(v, 0, 255)];

		v = i + ((hl_tint_g - i) * hl_tint_a) / 255;
		hl_disp_g[i] = hl_gamma_ramp[ClampI64(v, 0, 255)];

		v = i + ((hl_tint_b - i) * hl_tint_a) / 255;
		hl_disp_b[i] = hl_gamma_ramp[ClampI64(v, 0, 255)];
	}

	hl_disp_identity = ToBool(!hl_tint_a && hl_gamma == 1.0);
}

U0 HLPalRebuild()
{//tint and gamma used to be folded INTO hl_pal_argb, because 8bpp indices
 //cannot be blended. the canvas is RGB now, so both are screen space effects
 //applied once at blit time instead
 //
 //that also fixes what the old approach could not do: the tint now covers the
 //world, which is no longer drawn through this palette at all
	if (hl_gamma_dirty)
		HLPalBuildGammaRamp;

	HLPalBuildDisplayRamps;
}

U0 HLPalSetGamma(F64 g)
{
	if (g < HLGAMMA_MIN)	g = HLGAMMA_MIN;
	if (g > HLGAMMA_MAX)	g = HLGAMMA_MAX;

	if (g == hl_gamma)
		return;

	hl_gamma       = g;
	hl_gamma_dirty = TRUE;

	//apply now - only the in-game water/damage path dirties the palette,
	//so a menu gamma change wouldn't show until a map was running
	HLPalRebuild;
}

U0 HLPalSetTint(I64 r, I64 g, I64 b, I64 a)
{//underwater/damage wash, rebuilds only on change
	a = ClampI64(a, 0, 255);

	if (r == hl_tint_r && g == hl_tint_g && b == hl_tint_b && a == hl_tint_a &&
		!hl_gamma_dirty)
		return;

	hl_tint_r = r;
	hl_tint_g = g;
	hl_tint_b = b;
	hl_tint_a = a;

	HLPalRebuild;
}
