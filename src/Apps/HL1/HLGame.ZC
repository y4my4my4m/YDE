// HLGame.ZC - drives the QuakeC VM: spawning, thinking, drawing
//
// the entity text is the input to the game. each block becomes an edict whose
// fields come from the key/value pairs, then the spawn function named by its
// classname runs
//
// thereafter entities advance by running any think whose nextthink has come
// due. that mechanism animates monsters, opens doors and bobs items

#define HLGAME_MAX_EDICTS	600
#define HLGAME_FRAME_TIME	0.1		//QuakeC assumes 10Hz thinking
#define HLGAME_LIGHT			170		//no lit surface found
#define HLGAME_STATIC_DIST	2000.0	//statics are range limited like entities

//QuakeC value types, as emitted in the def tables
#define HLTYPE_VOID		0
#define HLTYPE_STRING	1
#define HLTYPE_FLOAT		2
#define HLTYPE_VECTOR	3
#define HLTYPE_ENTITY	4
#define HLTYPE_FIELD		5
#define HLTYPE_FUNCTION	6
#define HLTYPE_POINTER	7

Bool hl_game_active	= FALSE;

//"A map is loaded and the native world is running."
//
//hl_game_active is NOT that. It means "progs.dat loaded and the QuakeC world
//spawned", and HLGameInit returns early when progs.dat is missing - which it
//always is, because Half-Life ships none. So hl_game_active is permanently
//FALSE and every feature gated on it is silently dead.
//
//Set by HLLoadMap, cleared by HLGameShutdown.
Bool hl_world_active	= FALSE;
F64	 hl_game_time	= 0.0;
I64	 hl_game_spawned	= 0;
I64	 hl_game_thinks	= 0;

//inventory carried between levels. SetChangeParms packs it into parm1..parm16
//and reloading the bytecode wipes the global pool, so the engine holds it
//across the transition. the parm globals are the spawn parms
#define HLGAME_MAX_PARMS	HLPR_MAX_PARM_GLOBALS
F64	 hl_saved_parms[HLGAME_MAX_PARMS];

F64	 hl_saved_serverflags	= 0.0;
Bool hl_have_saved_parms		= FALSE;
Bool hl_world_warned			= FALSE;

//--- skill.cfg --------------------------------------------------------------
//
// valve/skill.cfg is game data, not SDK data. The SDK checkout carries no copy
// and every sk_ cvar defaults to "0" in dlls/game.cpp:411-429; the shipped file
// is the source of the real figures. 249 entries, three tiers per constant,
// the tier written as a digit on the end of the name.
//
// Format: one "name value" per line, value quoted, // comments to end of line,
// tabs and spaces both separators.
//
// CGameRules::RefreshSkillData, dlls/gamerules.cpp:114, clamps the skill cvar
// to 1..3 and pulls every constant through GetSkillCvar, dlls/skill.cpp:29,
// which appends that digit to the base name. Both are reproduced below.
//
// The engine execs skill.cfg into the cvar table. This reads it into a table of
// its own instead: 249 sk_ names in hl_cvars would swamp a linear cvar lookup
// that runs per frame.

#define HLSKILL_MAX_VARS	320
#define HLSKILL_NAME_MAX	40

class CHLSkillVar
{
	U8	name[HLSKILL_NAME_MAX];	//with the tier digit, as written in the file
	F64	value;
};

CHLSkillVar	hl_skill_var[HLSKILL_MAX_VARS];
I64			hl_skill_count	= 0;
I64			hl_skill_level	= 1;	//gSkillData.iSkillLevel, 1..3
Bool		hl_skill_loaded	= FALSE;

I64 HLSkillFind(U8 *name)
{//index of a full name including its tier digit, -1 absent
	I64 i;

	for (i = 0; i < hl_skill_count; i++)
	{
		if (!StrICompare(hl_skill_var[i].name, name))
			return i;
	}

	return -1;
}

U0 HLSkillDefine(U8 *name, F64 value)
{//Cvar_Set semantics: an unknown name is created, a known one overwritten
	I64 i = HLSkillFind(name);

	if (i < 0)
	{
		if (hl_skill_count >= HLSKILL_MAX_VARS)
			return;

		i = hl_skill_count;
		hl_skill_count++;
		HLStrCopy(hl_skill_var[i].name, name, HLSKILL_NAME_MAX);
	}

	hl_skill_var[i].value = value;
}

U0 HLSkillParse(U8 *text, I64 size)
{//one name and one quoted value a line. Anything that is not a pair is
 //skipped: the header comment, the group comments, the blank lines
	U8	 name[HLSKILL_NAME_MAX];
	U8	 val[32];
	I64	 i = 0;
	I64	 n;

	while (i < size)
	{
		while (i < size && text[i] <= ' ')
			i++;

		if (i >= size)
			break;

		if (i + 1 < size && text[i] == '/' && text[i + 1] == '/')
		{
			while (i < size && text[i] != '\n')
				i++;
			goto sk_next;
		}

		//name: unquoted, runs to the first separator
		n = 0;
		while (i < size && text[i] > ' ')
		{
			if (n < HLSKILL_NAME_MAX - 1)
			{
				name[n] = text[i];
				n++;
			}
			i++;
		}
		name[n] = 0;

		//value on the same line only. A name alone at end of line is dropped
		while (i < size && (text[i] == ' ' || text[i] == '\t'))
			i++;

		if (i >= size || text[i] == '\n' || text[i] == '\r')
			goto sk_next;

		n = 0;

		if (text[i] == '"')
		{
			i++;
			while (i < size && text[i] != '"' && text[i] != '\n')
			{
				if (n < 31)
				{
					val[n] = text[i];
					n++;
				}
				i++;
			}
			if (i < size && text[i] == '"')
				i++;
		}
		else
		{
			while (i < size && text[i] > ' ')
			{
				if (n < 31)
				{
					val[n] = text[i];
					n++;
				}
				i++;
			}
		}

		val[n] = 0;

		//only sk_ names. The file holds nothing else, and a stray token from a
		//hand-edited copy stays out of the table
		if (name[0] == 's' && name[1] == 'k' && name[2] == '_')
			HLSkillDefine(name, HLAtoF(val));

sk_next:
	}
}

F64 HLSkillCvar(U8 *base, F64 fallback)
{//GetSkillCvar, dlls/skill.cpp:29 - base name plus the resolved tier digit.
 //
 //The SDK warns on a zero and returns it, which is how a missing skill.cfg
 //produces monsters with no health. The table figure is used instead
	U8	 name[HLSKILL_NAME_MAX];
	I64	 i;

	StrPrint(name, "%s%d", base, hl_skill_level);

	i = HLSkillFind(name);

	if (i < 0)
		return fallback;

	if (hl_skill_var[i].value <= 0.0)
		return fallback;

	return hl_skill_var[i].value;
}

U0 HLSkillApply()
{//RefreshSkillData's back half. The tables in HLAI.ZC and HLWeapon.ZC are
 //built once at build time and hold the tier 1 figures; this overwrites the
 //skill-driven fields at every map load.
 //
 //Assignment is absolute, never a scale, so the pass is idempotent.
 //
 //The push runs from here rather than the two tables reading a lookup because
 //the compiler is single-pass: HLAI.ZC and HLWeapon.ZC both precede this file
 //and cannot name HLSkillCvar.
 //
 //Second arguments are the table's own values, used when skill.cfg is absent.

	//--- monsters, HLAI.ZC's hl_ai_mon_info ---
	hl_ai_mon_info[HLMON_HEADCRAB].health     = HLSkillCvar("sk_headcrab_health", 10.0);
	hl_ai_mon_info[HLMON_HEADCRAB].melee_dmg  = HLSkillCvar("sk_headcrab_dmg_bite", 5.0);

	hl_ai_mon_info[HLMON_ZOMBIE].health       = HLSkillCvar("sk_zombie_health", 50.0);
	hl_ai_mon_info[HLMON_ZOMBIE].melee_dmg    = HLSkillCvar("sk_zombie_dmg_one_slash", 10.0);
	hl_ai_mon_info[HLMON_ZOMBIE].melee2_dmg   = HLSkillCvar("sk_zombie_dmg_both_slash", 25.0);

	hl_ai_mon_info[HLMON_SCIENTIST].health    = HLSkillCvar("sk_scientist_health", 20.0);

	//CBarney fires a 9mm pistol: monDmg9MM, not a barney-specific figure
	hl_ai_mon_info[HLMON_BARNEY].health       = HLSkillCvar("sk_barney_health", 35.0);
	hl_ai_mon_info[HLMON_BARNEY].range_dmg    = HLSkillCvar("sk_9mm_bullet", 5.0);

	hl_ai_mon_info[HLMON_HOUNDEYE].health     = HLSkillCvar("sk_houndeye_health", 20.0);
	hl_ai_mon_info[HLMON_HOUNDEYE].range_dmg  = HLSkillCvar("sk_houndeye_dmg_blast", 10.0);

	hl_ai_mon_info[HLMON_HGRUNT].health       = HLSkillCvar("sk_hgrunt_health", 50.0);
	hl_ai_mon_info[HLMON_HGRUNT].melee_dmg    = HLSkillCvar("sk_hgrunt_kick", 5.0);
	hl_ai_mon_info[HLMON_HGRUNT].range_dmg    = HLSkillCvar("sk_9mmAR_bullet", 3.0);

	hl_ai_mon_info[HLMON_ISLAVE].health       = HLSkillCvar("sk_islave_health", 30.0);
	hl_ai_mon_info[HLMON_ISLAVE].melee_dmg    = HLSkillCvar("sk_islave_dmg_claw", 8.0);
	hl_ai_mon_info[HLMON_ISLAVE].range_dmg    = HLSkillCvar("sk_islave_dmg_zap", 10.0);

	hl_ai_mon_info[HLMON_BULLSQUID].health    = HLSkillCvar("sk_bullsquid_health", 40.0);
	hl_ai_mon_info[HLMON_BULLSQUID].melee_dmg = HLSkillCvar("sk_bullsquid_dmg_bite", 15.0);
	hl_ai_mon_info[HLMON_BULLSQUID].melee2_dmg = HLSkillCvar("sk_bullsquid_dmg_whip", 25.0);

	//both takes are the same punch, CAGrunt has one melee figure
	hl_ai_mon_info[HLMON_AGRUNT].health       = HLSkillCvar("sk_agrunt_health", 60.0);
	hl_ai_mon_info[HLMON_AGRUNT].melee_dmg    = HLSkillCvar("sk_agrunt_dmg_punch", 10.0);
	hl_ai_mon_info[HLMON_AGRUNT].melee2_dmg   = HLSkillCvar("sk_agrunt_dmg_punch", 10.0);
	hl_ai_mon_info[HLMON_AGRUNT].range_dmg    = HLSkillCvar("sk_hornet_dmg", 4.0);

	//RANGE1 is the energy ball spray: attack1's event options window runs
	//0.4s at one ball per 0.2s, controller.cpp:630-661, so two balls
	hl_ai_mon_info[HLMON_CONTROLLER].health     = HLSkillCvar("sk_controller_health", 60.0);
	hl_ai_mon_info[HLMON_CONTROLLER].range_dmg  = HLSkillCvar("sk_controller_dmgball", 3.0) * 2.0;
	hl_ai_mon_info[HLMON_CONTROLLER].range2_dmg = HLSkillCvar("sk_controller_dmgzap", 15.0);

	//CSentry fires one 9mmAR round a think
	hl_ai_mon_info[HLMON_SENTRY].health       = HLSkillCvar("sk_sentry_health", 40.0);
	hl_ai_mon_info[HLMON_SENTRY].range_dmg    = HLSkillCvar("sk_9mmAR_bullet", 3.0);

	//a placed mine carries pev->dmg through to its blast
	hl_ai_mon_info[HLMON_TRIPMINE].range_dmg  = HLSkillCvar("sk_plr_tripmine", 150.0);

	//CBarnacle (barnacle.cpp:112) and CRoach (roach.cpp:126) hardcode their
	//health; neither is a skill cvar

	//--- player weapons, HLWeapon.ZC's hl_wpn_info ---
	//
	//Every sk_plr_ figure is identical across the three tiers in the shipped
	//file. Driven from it anyway so a modified copy takes effect.
	hl_wpn_info[HLWPN_CROWBAR].damage      = HLSkillCvar("sk_plr_crowbar", 10.0);

	hl_wpn_info[HLWPN_GLOCK].damage        = HLSkillCvar("sk_plr_9mm_bullet", 8.0);
	hl_wpn_info[HLWPN_GLOCK].sec_damage    = HLSkillCvar("sk_plr_9mm_bullet", 8.0);

	hl_wpn_info[HLWPN_PYTHON].damage       = HLSkillCvar("sk_plr_357_bullet", 40.0);

	hl_wpn_info[HLWPN_MP5].damage          = HLSkillCvar("sk_plr_9mmAR_bullet", 5.0);
	hl_wpn_info[HLWPN_MP5].sec_damage      = HLSkillCvar("sk_plr_9mmAR_grenade", 100.0);

	//the bolt does the monster figure to anything that is not a player
	hl_wpn_info[HLWPN_CROSSBOW].damage     = HLSkillCvar("sk_plr_xbow_bolt_monster", 50.0);

	hl_wpn_info[HLWPN_SHOTGUN].damage      = HLSkillCvar("sk_plr_buckshot", 5.0);
	hl_wpn_info[HLWPN_SHOTGUN].sec_damage  = HLSkillCvar("sk_plr_buckshot", 5.0);

	hl_wpn_info[HLWPN_RPG].damage          = HLSkillCvar("sk_plr_rpg", 100.0);
	hl_wpn_info[HLWPN_GAUSS].damage        = HLSkillCvar("sk_plr_gauss", 20.0);

	hl_wpn_info[HLWPN_EGON].damage         = HLSkillCvar("sk_plr_egon_wide", 14.0);
	hl_wpn_info[HLWPN_EGON].sec_damage     = HLSkillCvar("sk_plr_egon_narrow", 6.0);

	hl_wpn_info[HLWPN_HANDGRENADE].damage  = HLSkillCvar("sk_plr_hand_grenade", 100.0);
	hl_wpn_info[HLWPN_TRIPMINE].damage     = HLSkillCvar("sk_plr_tripmine", 150.0);
	hl_wpn_info[HLWPN_SATCHEL].damage      = HLSkillCvar("sk_plr_satchel", 150.0);
	hl_wpn_info[HLWPN_SNARK].damage        = HLSkillCvar("sk_snark_dmg_pop", 5.0);

	//HLWPN_HORNETGUN is left alone: gSkillData.plrDmgHornet is assigned 7 in
	//RefreshSkillData (gamerules.cpp:288) and has no cvar. sk_hornet_dmg is the
	//monster figure and applies to the alien grunt only

	//The shotgun grunt folds pellets by buckshot into one hit, so both figures
	//are the monster's and neither belongs in the weapon table
	hl_ai_grunt_pellets  = HLSkillCvar("sk_hgrunt_pellets", 3.0);
	hl_ai_grunt_buckshot = HLSkillCvar("sk_plr_buckshot", 5.0);
}

Bool HLSkillLoad()
{//RefreshSkillData's front half: resolve the tier, then read the file
	U8	*text;
	U8	 line[96];
	I64	 size = 0;
	I64	 skill;

	hl_skill_count  = 0;
	hl_skill_loaded = FALSE;

	//gamerules.cpp:121-128 clamps below 1 up and above 3 down, so the cvar's
	//0 is Easy. g_iSkillLevel keeps the raw value; nothing here reads it
	skill = ToI64(HLCvarGet("skill") + 0.5);

	if (skill < 1)
		skill = 1;
	if (skill > 3)
		skill = 3;

	hl_skill_level = skill;

	//borrowed, owned by the file cache. Not Freed
	text = HLFileData("skill.cfg", &size);

	if (!text || size <= 0)
	{
		HLLog("skill: no skill.cfg, tables keep their built-in figures\n");
		HLSkillApply;
		return FALSE;
	}

	HLSkillParse(text, size);
	hl_skill_loaded = TRUE;

	StrPrint(line, "skill: level %d, %d entries from skill.cfg\n",
		hl_skill_level, hl_skill_count);
	HLLog(line);

	HLSkillApply;

	return TRUE;
}

I64 HLGameFindFieldDef(U8 *name, I64 *_type)
{//the field def type decides how a map value converts
	I64 i;

	for (i = 0; i < hl_pr_num_fielddefs; i++)
	{
		if (!StrCompare(HLPrStr(hl_pr_fielddefs[i].name), name))
		{
			if (_type)
				*_type = hl_pr_fielddefs[i].type & 0x7FFF;	//high bit is a flag
			return hl_pr_fielddefs[i].ofs;
		}
	}

	if (_type)
		*_type = HLTYPE_VOID;

	return -1;
}

Bool HLGameSetField(I64 ent, U8 *key, U8 *value)
{//one map key/value onto an entity field
	I64 ftype;
	I64 ofs;
	F64 v[3];
	I64 fn;
	U8	anglebuf[64];
	I64	n;

	//ED_ParseEdict's "angle" rewrite. maps write a bare yaw as "angle",
	//progs.dat only has the vector "angles"; unrewritten the key is dropped and
	//every entity spawns facing east. SetMovedir reads self.angles for door
	//travel direction. -1 and -2 (up / down) pass through untouched
	if (!StrCompare(key, "angle"))
	{
		//built by hand, not StrPrint - the value is up to 160 chars from the
		//entity lump and would not fit "0 %s 0". a yaw is a few digits,
		//anything longer is malformed
		anglebuf[0] = '0';
		anglebuf[1] = ' ';

		//leaves room for the trailing " 0" and the terminator
		HLStrCopy(anglebuf + 2, value, sizeof(anglebuf) - 5);

		n = StrLen(anglebuf);
		anglebuf[n]     = ' ';
		anglebuf[n + 1] = '0';
		anglebuf[n + 2] = 0;

		key   = "angles";
		value = anglebuf;
	}

	ofs = HLGameFindFieldDef(key, &ftype);
	if (ofs < 0)
		return FALSE;

	switch (ftype)
	{
		case HLTYPE_FLOAT:
			HLPrSetFieldF(ent, ofs, HLAtoF(value));
			break;

		case HLTYPE_VECTOR:
			HLParseVec(value, v);
			HLPrSetFieldF(ent, ofs, v[0]);
			HLPrSetFieldF(ent, ofs + 1, v[1]);
			HLPrSetFieldF(ent, ofs + 2, v[2]);
			break;

		case HLTYPE_STRING:
			//map strings aren't in the compiled blob, copy to the heap first
			HLPrSetFieldI(ent, ofs, HLPrNewString(value));
			break;

		case HLTYPE_ENTITY:
			HLPrSetFieldI(ent, ofs, HLPrEdictValue(ToI64(HLAtoF(value))));
			break;

		case HLTYPE_FUNCTION:
			fn = HLPrFindFunction(value);
			if (fn < 0)
				fn = 0;
			HLPrSetFieldI(ent, ofs, fn);
			break;

		default:
			return FALSE;
	}

	return TRUE;
}

//defs.qc spawnflags the engine reserves for entity filtering
#define HLSPAWNFLAG_NOT_EASY			256
#define HLSPAWNFLAG_NOT_MEDIUM		512
#define HLSPAWNFLAG_NOT_HARD			1024
#define HLSPAWNFLAG_NOT_DEATHMATCH	2048

//coop resolved for this level. not zeroed by the loader;
//HLGameApplyModeCvars is the init and every reader goes through it first
Bool hl_coop_active = FALSE;

U0 HLGameApplyModeCvars()
{//resolve the game mode, then publish it to the VM
 //
 //coop and deathmatch are mutually exclusive - Host_InitLocal forces
 //deathmatch off whenever coop is set. later tests (entity inhibit,
 //SelectSpawnPoint, respawn) read the resolved pair, settled once here
 //
 //SV_SpawnServer publishes these as progs globals, not cvars. CheatCommand
 //(impulse 9) returns early on deathmatch || coop, and SelectSpawnPoint reads
 //coop to pick info_player_coop. at 0 the QuakeC side plays single player
	hl_coop_active = FALSE;

	if (HLCvarGet("coop") != 0.0)
	{
		hl_coop_active = TRUE;

		if (HLCvarGet("deathmatch") != 0.0)
			HLCvarSet("deathmatch", 0.0);
	}

	if (hl_ofs_coop >= 0)
		HLPrSetF(hl_ofs_coop, HLCvarGet("coop"));
	if (hl_ofs_deathmatch >= 0)
		HLPrSetF(hl_ofs_deathmatch, HLCvarGet("deathmatch"));

	//teamplay is a progs global too, read only by T_Damage - 1 blocks damage
	//between team mates, 2 lets it through
	if (hl_ofs_teamplay >= 0)
		HLPrSetF(hl_ofs_teamplay, HLCvarGet("teamplay"));
}

Bool HLGameInhibitEntity(I64 ent)
{//ED_LoadFromFile - does this entity belong in the game being started
	I64 flags;
	I64 skill;

	//edict 0 is worldspawn, not optional
	if (ent <= 0 || hl_fld_spawnflags < 0)
		return FALSE;

	flags = ToI64(HLPrFieldF(ent, hl_fld_spawnflags));

	//coop takes the skill path, not the deathmatch one - deathmatch is forced
	//to 0 above, so monsters spawn as in single player. the coop test guards
	//against a cvar written elsewhere
	//
	//deathmatch-only entities carry 1792 (NOT_EASY|NOT_MEDIUM|NOT_HARD) and
	//stay inhibited by whichever skill line matches, which is how the original
	//keeps DM pads out of a coop game
	if (!hl_coop_active && HLCvarGet("deathmatch") != 0.0)
		return ToBool(flags & HLSPAWNFLAG_NOT_DEATHMATCH);

	//current_skill is the clamped integer, not the raw cvar - skill 3 uses
	//the hard set
	skill = ToI64(HLCvarGet("skill") + 0.5);
	skill = ClampI64(skill, 0, 3);

	if (skill == 0 && (flags & HLSPAWNFLAG_NOT_EASY))
		return TRUE;
	if (skill == 1 && (flags & HLSPAWNFLAG_NOT_MEDIUM))
		return TRUE;
	if (skill >= 2 && (flags & HLSPAWNFLAG_NOT_HARD))
		return TRUE;

	return FALSE;
}

I64 HLGameSpawnEntities(CHLMap *map)
{//walk the entity text, build each edict, run its spawn function
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[160];
	U8	 classname[64];
	U8	 line[128];
	I64	 inhibited = 0;
	I64	 ent;
	I64	 k;
	I64	 fn;
	I64	 spawned = 0;
	Bool first    = TRUE;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end)
	{
		if (*p == '{')
		{
			//the first block is worldspawn, which owns edict 0
			if (first)
			{
				ent   = 0;
				first = FALSE;
			}
			else
				ent = HLPrSpawnEdict;

			classname[0] = 0;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				//The scan runs to the closing quote; only the copy is
				//capped. Stopping the scan at the buffer size leaves p
				//inside the string and every later quote reads as a
				//delimiter. worldspawn's "wad" value is 108 bytes.
				while (p < end && *p != '"')
				{
					if (k < 63)
					{
						key[k] = *p;
						k++;
					}
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"')
				{
					if (k < 159)
					{
						val[k] = *p;
						k++;
					}
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					HLStrCopy(classname, val, 64);

				HLGameSetField(ent, key, val);
			}

			//ED_LoadFromFile's inhibit test. the map carries every entity for
			//every skill, the engine drops the ones that don't belong
			if (HLGameInhibitEntity(ent))
			{
				//name what is dropped - over-inhibiting and an empty map look
				//identical on screen
				if (inhibited < 24 && classname[0])
				{
					StrPrint(line, "  inhibit %s (spawnflags %d)\n",
						classname,
						ToI64(HLPrFieldF(ent, hl_fld_spawnflags)));
					HLLog(line);
				}

				HLPrFreeEdict(ent);
				inhibited++;
				goto qge_next_ent;
			}

			if (classname[0])
			{
				//the spawn function shares the classname. anything without one
				//(lights, path corners) is data only
				fn = HLPrFindFunction(classname);
				if (fn > 0)
				{
					HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
					HLPrSetI(hl_ofs_other, 0);
					HLPrExecute(fn);
					spawned++;

					if (hl_pr_error)
					{
						"HLGame: error spawning %s\n", classname;
						hl_pr_error = FALSE;
					}

					//the world must stay non-damageable. a damageable world
					//means that spawn ran with self pointing at edict 0. name
					//it and repair the invariant
					if (HLPrFieldF(0, hl_fld_takedamage) != 0.0)
					{
						StrPrint(line, "HLGame: %s corrupted world.takedamage\n",
							classname);
						HLLog(line);

						HLPrSetFieldF(0, hl_fld_takedamage, 0.0);
						HLPrSetFieldF(0, hl_fld_health, 0.0);
					}
				}
			}

qge_next_ent:
		}

		if (p < end)
			p++;
	}

	if (inhibited)
	{
		StrPrint(line, "HLGame: %d entities inhibited by skill/deathmatch\n",
			inhibited);
		HLLog(line);
	}

	return spawned;
}

//--- entity physics --------------------------------------------------------
//
// SV_Physics. thinks decide what an entity intends, this pass moves it -
// without it a rocket gets a velocity and hangs motionless in the air
//
// .movetype selects the rule: things that translate (NOCLIP, PUSH), things
// that fall (TOSS, BOUNCE, STEP), and things that must report a collision to
// QuakeC so it can explode them (FLYMISSILE)
//movetypes are declared in HLEnt.ZC - the native entity system needs them
//and compiles first


#define HLPHYS_SV_GRAVITY	800.0
#define HLFL_ONGROUND_		512
#define HLFL_CLIENT			8
#define HLFL_ITEM_			256


U0 HLGameLinkAll()
{//refresh every live entity's bounds, once per frame before thinking
	I64 i;

	for (i = 0; i < hl_pr_num_edicts; i++)
	{
		if (!hl_pr_edict_free[i])
			HLGameLinkEdict(i);
	}
}

U0 HLGameCallTouch(I64 self_ent, I64 other_ent)
{//run a touch function with the self/other pair the server would pass
	I64 fn;

	//the world has no touch, and running one puts edict 0 in self inside
	//damage code that was never meant to see it
	if (self_ent <= 0)
		return;

	//touch only dispatches for solid entities - a trigger sets SOLID_NOT the
	//moment it fires and must stop receiving impacts
	if (HLPrFieldF(self_ent, hl_fld_solid) == ToF64(HLSOLID_NOT_))
		return;

	fn = HLPrFieldI(self_ent, hl_fld_touch);

	if (fn <= 0 || fn >= hl_pr_num_functions)
		return;

	HLPrSetI(hl_ofs_self, HLPrEdictValue(self_ent));
	HLPrSetI(hl_ofs_other, HLPrEdictValue(other_ent));
	HLPrExecute(fn);
	hl_pr_error = FALSE;
}

I64 HLGameGroundEntUnder(I64 ent)
{//what this box is resting on, or 0 for none. SV_PushMove carries a rider
 //only when FL_ONGROUND is set and groundentity is the pusher; an entity with
 //the flag but no ground entity is treated as an obstruction and crushed
 //instead of lifted
	CHLTrace	tr;
	F64		start[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	if (!hl_bi_map)
		return 0;

	for (j = 0; j < 3; j++)
	{
		start[j] = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j]  = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j]  = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	HLVecCopy(start, end);
	end[2] -= 1.0;

	HLTraceEntity(hl_bi_map, start, end, mins, maxs, ent, FALSE, &tr);

	if (tr.fraction >= 1.0 && !tr.all_solid && !tr.start_solid)
		return 0;

	if (tr.ent < 0)
		return 0;			//the world

	return tr.ent;
}

Bool HLGameHasGroundUnder(I64 ent)
{//test for support under this box. one unit is what SV_movestep and the step
 //code treat as contact
	CHLTrace	tr;
	F64		start[3];
	F64		end[3];
	F64		mins[3];
	F64		maxs[3];
	I64		j;

	if (!hl_bi_map)
		return TRUE;		//no world to test against, do not start falling

	for (j = 0; j < 3; j++)
	{
		start[j] = HLPrFieldF(ent, hl_fld_origin + j);
		mins[j]  = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j]  = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	HLVecCopy(start, end);
	end[2] -= 1.0;

	HLTraceEntity(hl_bi_map, start, end, mins, maxs, ent, FALSE, &tr);

	return ToBool(tr.fraction < 1.0 || tr.all_solid || tr.start_solid);
}

U0 HLGamePhysicsEntity(I64 ent, F64 dt)
{//one entity, one tick
	CHLTrace	tr;
	F64		origin[3];
	F64		velocity[3];
	F64		avelocity[3];
	F64		end[3];
	F64		emins[3];
	F64		emaxs[3];
	F64		grav;
	I64		movetype;
	I64		hit;
	I64		j;
	I64		solid;
	Bool	ground_ok;

	movetype = ToI64(HLPrFieldF(ent, hl_fld_movetype));

	//dispatch by movetype as SV_Physics_Client does, not by whether this is
	//the player. a WALK player is moved by the player code, but PlayerDie sets
	//TOSS and from there the corpse belongs to SV_Physics_Toss
	if (movetype == HLMOVETYPE_NONE || movetype == HLMOVETYPE_WALK)
		return;

	for (j = 0; j < 3; j++)
	{
		origin[j]    = HLPrFieldF(ent, hl_fld_origin + j);
		velocity[j]  = HLPrFieldF(ent, hl_fld_velocity + j);
		avelocity[j] = HLPrFieldF(ent, hl_fld_avelocity + j);
	}

	//anything with an angular velocity spins - rockets, gibs
	if (avelocity[0] != 0.0 || avelocity[1] != 0.0 || avelocity[2] != 0.0)
	{
		for (j = 0; j < 3; j++)
			HLPrSetFieldF(ent, hl_fld_angles + j,
				HLAngleNorm(HLPrFieldF(ent, hl_fld_angles + j) +
					avelocity[j] * dt));
	}

	if (movetype == HLMOVETYPE_ANGLENOCLIP || movetype == HLMOVETYPE_ANGLECLIP)
		return;		//angles only, no translation

	//an entity at rest on the floor is finished - SV_Physics_Toss and _Step
	//both return before gravity and before the sweep when FL_ONGROUND is set.
	//skipping only gravity is not enough, nothing here applies friction
	if (movetype == HLMOVETYPE_TOSS || movetype == HLMOVETYPE_BOUNCE ||
		movetype == HLMOVETYPE_STEP)
	{
		if (ToBool(ToI64(HLPrFieldF(ent, hl_fld_flags)) & HLFL_ONGROUND_))
		{
			//deviation: FL_ONGROUND is set by the move builtins and by
			//droptofloor, and nothing here clears it - SV_movestep does that
			//through FL_PARTIALGROUND, which this port does not carry. an
			//entity whose floor went away would keep the flag, skip gravity
			//and hang in the air. re-prove the ground and clear the flag when
			//there is nothing underneath
			if (!HLGameHasGroundUnder(ent))
			{
				HLPrSetFieldF(ent, hl_fld_flags,
					ToF64(ToI64(HLPrFieldF(ent, hl_fld_flags)) &
						~HLFL_ONGROUND_));
			}
			else
				return;
		}

		//gravity, scaled by the entity's own multiplier if it has one
		grav = HLPrFieldF(ent, hl_fld_gravity);
		if (grav <= 0.0)
			grav = 1.0;

		velocity[2] -= HLPHYS_SV_GRAVITY * grav * dt;
	}

	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		HLPrSetFieldF(ent, hl_fld_velocity + 2, velocity[2]);
		return;
	}

	HLVecMA(origin, dt, velocity, end);

	//NOCLIP and PUSH pass through geometry - a door must move through its own
	//brush volume
	if (movetype == HLMOVETYPE_NOCLIP || movetype == HLMOVETYPE_PUSH)
	{
		for (j = 0; j < 3; j++)
			HLPrSetFieldF(ent, hl_fld_origin + j, end[j]);

		HLPrSetFieldF(ent, hl_fld_velocity + 2, velocity[2]);

		//brush movers think on their own local clock
		if (movetype == HLMOVETYPE_PUSH && hl_fld_ltime >= 0)
			HLPrSetFieldF(ent, hl_fld_ltime, HLPrFieldF(ent, hl_fld_ltime) + dt);

		return;
	}

	//everything else sweeps against the world and every solid entity
	for (j = 0; j < 3; j++)
	{
		emins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		emaxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	//SV_PushEntity's MOVE_NOMONSTERS rule - TRIGGER and NOT clip against
	//brush models only, or a dropped backpack lands on its own corpse
	solid = ToI64(HLPrFieldF(ent, hl_fld_solid));

	HLTraceEntity(hl_bi_map, origin, end, emins, emaxs, ent,
		ToBool(solid == HLSOLID_TRIGGER_ || solid == HLSOLID_NOT_), &tr);
	hit = tr.ent;

	for (j = 0; j < 3; j++)
		HLPrSetFieldF(ent, hl_fld_origin + j, tr.end_pos[j]);

	if (tr.fraction < 1.0 || hit >= 0)
	{
		if (movetype == HLMOVETYPE_BOUNCE || movetype == HLMOVETYPE_TOSS ||
			movetype == HLMOVETYPE_STEP)
		{
			//BOUNCE reflects and loses energy, everything else slides
			if (movetype == HLMOVETYPE_BOUNCE)
				HLClipVelocity(velocity, tr.plane_normal, 1.5, velocity);
			else
				HLClipVelocity(velocity, tr.plane_normal, 1.0, velocity);

			for (j = 0; j < 3; j++)
				HLPrSetFieldF(ent, hl_fld_velocity + j, velocity[j]);

			//landing flat brings it to rest, not merely grounded - velocity
			//and avelocity are zeroed. BOUNCE is exempt until it has slowed,
			//so grenades still bounce
			//
			//STEP may only take ground from a brush surface, SV_FlyMove's
			//gate - nothing can stand on a monster. TOSS and
			//BOUNCE have no such gate, a gib can settle on a corpse
			if (movetype == HLMOVETYPE_STEP && tr.ent > 0 &&
				ToI64(HLPrFieldF(tr.ent, hl_fld_solid)) != HLSOLID_BSP_)
				ground_ok = FALSE;
			else
				ground_ok = TRUE;

			if (tr.plane_normal[2] > 0.7 && ground_ok &&
				(movetype != HLMOVETYPE_BOUNCE || velocity[2] < 60.0))
			{
				HLPrSetFieldF(ent, hl_fld_flags,
					ToF64(ToI64(HLPrFieldF(ent, hl_fld_flags)) | HLFL_ONGROUND_));

				//record which entity it landed on, not merely that it landed -
				//SV_PushMove decides who rides by comparing .groundentity
				//against the pusher; FL_ONGROUND without it leaves a body
				//hanging where the lift left it.
				//the world traces as -1 here but is edict 0 to QuakeC
				if (hl_fld_groundentity >= 0)
				{
					if (tr.ent > 0)
						HLPrSetFieldI(ent, hl_fld_groundentity,
							HLPrEdictValue(tr.ent));
					else
						HLPrSetFieldI(ent, hl_fld_groundentity,
							HLPrEdictValue(0));
				}

				for (j = 0; j < 3; j++)
				{
					HLPrSetFieldF(ent, hl_fld_velocity + j, 0.0);
					HLPrSetFieldF(ent, hl_fld_avelocity + j, 0.0);
				}
			}
		}
		else
		{
			//FLY and FLYMISSILE stop; the touch handler decides what
			//that means - for a rocket, exploding
			for (j = 0; j < 3; j++)
				HLPrSetFieldF(ent, hl_fld_velocity + j, 0.0);
		}

		//tell QuakeC about the collision. the world is edict 0, which is what
		//the missile code expects
		if (hit >= 0)
		{
			HLGameCallTouch(ent, hit);
			HLGameCallTouch(hit, ent);
		}
		else
			HLGameCallTouch(ent, 0);
	}
	else
	{
		for (j = 0; j < 3; j++)
			HLPrSetFieldF(ent, hl_fld_velocity + j, velocity[j]);
	}
}

#define HLGAME_MAX_PUSHED	256

I64 hl_pushed_ent[HLGAME_MAX_PUSHED];
F64 hl_pushed_from[HLGAME_MAX_PUSHED * 3];

U0 HLGamePushMove(I64 pusher, F64 movetime)
{//SV_PushMove - translate a door or platform and carry, or crush, whatever
 //is in the way
 //
 //the pusher moves first, then anything inside its new volume is shoved by
 //the same offset. a rider that cannot be shoved clear rolls back the whole
 //move and calls .blocked - that rollback is how a door reverses and how a
 //crusher damages
	F64  move[3];
	F64  mins[3];
	F64  maxs[3];
	F64  pushorig[3];
	F64  entorig[3];
	F64  velocity[3];
	CHLTrace tr;
	I64  num_pushed = 0;
	I64  i;
	I64  j;
	I64  movetype;
	I64  solid;
	I64  blocked_fn;
	I64  ground;
	Bool overlaps;

	for (j = 0; j < 3; j++)
		velocity[j] = HLPrFieldF(pusher, hl_fld_velocity + j);

	//standing still, advance its clock only
	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		HLPrSetFieldF(pusher, hl_fld_ltime,
			HLPrFieldF(pusher, hl_fld_ltime) + movetime);
		return;
	}


	for (j = 0; j < 3; j++)
	{
		move[j]     = velocity[j] * movetime;
		pushorig[j] = HLPrFieldF(pusher, hl_fld_origin + j);
		mins[j]     = HLPrFieldF(pusher, hl_fld_absmin + j) + move[j];
		maxs[j]     = HLPrFieldF(pusher, hl_fld_absmax + j) + move[j];
	}

	//pusher to its final position first
	for (j = 0; j < 3; j++)
		HLPrSetFieldF(pusher, hl_fld_origin + j, pushorig[j] + move[j]);

	HLPrSetFieldF(pusher, hl_fld_ltime,
		HLPrFieldF(pusher, hl_fld_ltime) + movetime);
	HLGameLinkEdict(pusher);

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i] || i == pusher)
			goto qpm_next;

		movetype = ToI64(HLPrFieldF(i, hl_fld_movetype));
		if (movetype == HLMOVETYPE_PUSH || movetype == HLMOVETYPE_NONE ||
			movetype == HLMOVETYPE_NOCLIP)
			goto qpm_next;

		//anything standing on the pusher rides unconditionally, otherwise it
		//only matters inside the new volume
		ground = HLPrEdictNum(HLPrFieldI(i, hl_fld_groundentity));

		if (!(ToI64(HLPrFieldF(i, hl_fld_flags)) & HLFL_ONGROUND_) ||
			ground != pusher)
		{
			overlaps = TRUE;
			for (j = 0; j < 3; j++)
			{
				if (HLPrFieldF(i, hl_fld_absmin + j) >= maxs[j] ||
					HLPrFieldF(i, hl_fld_absmax + j) <= mins[j])
					overlaps = FALSE;
			}

			if (!overlaps)
				goto qpm_next;

			if (HLTestEntityPosition(hl_bi_map, i) < 0)
				goto qpm_next;
		}

		//riders other than the player lose ground contact while carried
		if (movetype != HLMOVETYPE_WALK)
			HLPrSetFieldF(i, hl_fld_flags,
				ToF64(ToI64(HLPrFieldF(i, hl_fld_flags)) & ~HLFL_ONGROUND_));

		for (j = 0; j < 3; j++)
			entorig[j] = HLPrFieldF(i, hl_fld_origin + j);

		if (num_pushed < HLGAME_MAX_PUSHED)
		{
			hl_pushed_ent[num_pushed] = i;
			for (j = 0; j < 3; j++)
				hl_pushed_from[num_pushed * 3 + j] = entorig[j];
			num_pushed++;
		}

		//pusher goes non-solid for the shove, or the rider is blocked by the
		//thing carrying it
		solid = ToI64(HLPrFieldF(pusher, hl_fld_solid));
		HLPrSetFieldF(pusher, hl_fld_solid, ToF64(HLSOLID_NOT_));

		HLPushEntity(hl_bi_map, i, move, &tr);

		HLPrSetFieldF(pusher, hl_fld_solid, ToF64(solid));
		HLGameLinkEdict(i);

		//still stuck in the pusher, so this move cannot happen
		if (HLTestEntityPosition(hl_bi_map, i) >= 0)
		{
			//a zero-width entity can't block anything
			if (HLPrFieldF(i, hl_fld_mins + 0) == HLPrFieldF(i, hl_fld_maxs + 0))
				goto qpm_next;

			//corpses and triggers flatten out of the way instead of jamming
			//the door
			solid = ToI64(HLPrFieldF(i, hl_fld_solid));
			if (solid == HLSOLID_NOT_ || solid == HLSOLID_TRIGGER_)
			{
				HLPrSetFieldF(i, hl_fld_mins + 0, 0.0);
				HLPrSetFieldF(i, hl_fld_mins + 1, 0.0);
				for (j = 0; j < 3; j++)
					HLPrSetFieldF(i, hl_fld_maxs + j,
						HLPrFieldF(i, hl_fld_mins + j));
				HLGameLinkEdict(i);
				goto qpm_next;
			}

			//rider back
			for (j = 0; j < 3; j++)
				HLPrSetFieldF(i, hl_fld_origin + j, entorig[j]);
			HLGameLinkEdict(i);

			//pusher back, and un-advance its clock
			for (j = 0; j < 3; j++)
				HLPrSetFieldF(pusher, hl_fld_origin + j, pushorig[j]);
			HLPrSetFieldF(pusher, hl_fld_ltime,
				HLPrFieldF(pusher, hl_fld_ltime) - movetime);
			HLGameLinkEdict(pusher);

			//QuakeC decides what blocked means - door reverses, crusher does
			//damage, no handler waits
			blocked_fn = HLPrFieldI(pusher, hl_fld_blocked);
			if (blocked_fn > 0 && blocked_fn < hl_pr_num_functions)
			{
				HLPrSetI(hl_ofs_self, HLPrEdictValue(pusher));
				HLPrSetI(hl_ofs_other, HLPrEdictValue(i));
				HLPrExecute(blocked_fn);
				hl_pr_error = FALSE;
			}

			//undo everything already carried this move
			for (j = 0; j < num_pushed; j++)
			{
				HLPrSetFieldF(hl_pushed_ent[j], hl_fld_origin + 0,
					hl_pushed_from[j * 3 + 0]);
				HLPrSetFieldF(hl_pushed_ent[j], hl_fld_origin + 1,
					hl_pushed_from[j * 3 + 1]);
				HLPrSetFieldF(hl_pushed_ent[j], hl_fld_origin + 2,
					hl_pushed_from[j * 3 + 2]);
				HLGameLinkEdict(hl_pushed_ent[j]);
			}

			return;
		}

qpm_next:
	}
}

U0 HLGamePhysicsPusher(I64 ent, F64 dt)
{//SV_Physics_Pusher - doors, platforms, buttons
 //
 //these run on their own clock. SUB_CalcMove schedules nextthink as
 //ltime + traveltime, not time + traveltime, so comparing nextthink against
 //game time fires them at the wrong moment or never
	F64 old_ltime;
	F64 thinktime;
	F64 movetime;
	F64 avelocity[3];
	I64 think;
	I64 j;

	old_ltime = HLPrFieldF(ent, hl_fld_ltime);
	thinktime = HLPrFieldF(ent, hl_fld_nextthink);

	//move only as far as the scheduled think, so it lands exactly on time
	//
	//no thinktime > 0 guard, matching SV_Physics_Pusher, which has
	//none. with nothing scheduled nextthink is 0, movetime clamps to zero, and
	//an idle pusher neither moves nor advances its clock. a guard would send it
	//down the else branch and drift ltime ahead of the schedule its own think
	//times are expressed in
	if (thinktime < old_ltime + dt)
	{
		movetime = thinktime - old_ltime;
		if (movetime < 0.0)
			movetime = 0.0;
	}
	else
		movetime = dt;

	if (movetime > 0.0)
	{
		for (j = 0; j < 3; j++)
			avelocity[j] = HLPrFieldF(ent, hl_fld_avelocity + j);

		//rotation applies directly, only translation can shove anything
		for (j = 0; j < 3; j++)
		{
			if (avelocity[j] != 0.0)
				HLPrSetFieldF(ent, hl_fld_angles + j,
					HLAngleNorm(HLPrFieldF(ent, hl_fld_angles + j) +
						avelocity[j] * movetime));
		}

		HLGamePushMove(ent, movetime);
	}

	//think when the local clock reaches the scheduled time
	if (thinktime > old_ltime && thinktime <= HLPrFieldF(ent, hl_fld_ltime))
	{
		HLPrSetFieldF(ent, hl_fld_nextthink, 0.0);

		think = HLPrFieldI(ent, hl_fld_think);
		if (think > 0 && think < hl_pr_num_functions)
		{
			HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
			HLPrSetI(hl_ofs_other, 0);
			HLPrExecute(think);
			hl_pr_error = FALSE;
			hl_game_thinks++;
		}
	}
}

U0 HLGameRunPhysics(F64 dt)
{//a touch handler can remove entities mid-pass, so recheck the free flag
	I64 i;
	I64 movetype;

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
			goto qrp_next;

		movetype = ToI64(HLPrFieldF(i, hl_fld_movetype));

		//pushers own their think scheduling and skip the ordinary pass
		if (movetype == HLMOVETYPE_PUSH)
			HLGamePhysicsPusher(i, dt);
		else
			HLGamePhysicsEntity(i, dt);

qrp_next:
	}
}

U0 HLGameTouchTriggersFor(I64 client)
{//triggers overlapping one client edict, for remote players after their
 //origin is snapped - HLGameFrame's pass still sees last frame's position
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	k;
	I64	touch;
	Bool overlap;

	if (client <= 0 || hl_pr_edict_free[client])
		return;

	for (k = 0; k < 3; k++)
	{
		amins[k] = HLPrFieldF(client, hl_fld_absmin + k);
		amaxs[k] = HLPrFieldF(client, hl_fld_absmax + k);
	}

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i] || i == client)
			goto qgtf_next;

		if (ToI64(HLPrFieldF(i, hl_fld_solid)) != HLSOLID_TRIGGER_)
			goto qgtf_next;

		touch = HLPrFieldI(i, hl_fld_touch);
		if (touch <= 0 || touch >= hl_pr_num_functions)
			goto qgtf_next;

		overlap = TRUE;
		for (k = 0; k < 3; k++)
		{
			bmins[k] = HLPrFieldF(i, hl_fld_absmin + k);
			bmaxs[k] = HLPrFieldF(i, hl_fld_absmax + k);
			if (amins[k] > bmaxs[k] || amaxs[k] < bmins[k])
				overlap = FALSE;
		}

		if (!overlap)
			goto qgtf_next;

		HLPrSetI(hl_ofs_self, HLPrEdictValue(i));
		HLPrSetI(hl_ofs_other, HLPrEdictValue(client));
		HLPrExecute(touch);
		hl_pr_error = FALSE;

		//teleporters relocate the client mid-pass
		HLGameLinkEdict(client);
		for (k = 0; k < 3; k++)
		{
			amins[k] = HLPrFieldF(client, hl_fld_absmin + k);
			amaxs[k] = HLPrFieldF(client, hl_fld_absmax + k);
		}

qgtf_next:
	}
}

U0 HLGameTouchTriggersAll()
{//SV_TouchLinks, without the area tree
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	j;
	I64	k;
	I64	touch;
	Bool overlap;

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i] || i == hl_player_edict)
			goto qtt_next;

		if (ToI64(HLPrFieldF(i, hl_fld_solid)) != HLSOLID_TRIGGER_)
			goto qtt_next;

		touch = HLPrFieldI(i, hl_fld_touch);
		if (touch <= 0 || touch >= hl_pr_num_functions)
			goto qtt_next;

		for (k = 0; k < 3; k++)
		{
			amins[k] = HLPrFieldF(i, hl_fld_absmin + k);
			amaxs[k] = HLPrFieldF(i, hl_fld_absmax + k);
		}

		for (j = 1; j < hl_pr_num_edicts; j++)
		{
			if (hl_pr_edict_free[j] || j == i)
				goto qtt_inner;

			//only touchable things, and never another trigger
			if (ToI64(HLPrFieldF(j, hl_fld_solid)) == HLSOLID_TRIGGER_ ||
				ToI64(HLPrFieldF(j, hl_fld_solid)) == HLSOLID_NOT_)
				goto qtt_inner;

			overlap = TRUE;
			for (k = 0; k < 3; k++)
			{
				bmins[k] = HLPrFieldF(j, hl_fld_absmin + k);
				bmaxs[k] = HLPrFieldF(j, hl_fld_absmax + k);

				if (bmins[k] > amaxs[k] || bmaxs[k] < amins[k])
					overlap = FALSE;
			}

			if (!overlap)
				goto qtt_inner;

			HLPrSetI(hl_ofs_self, HLPrEdictValue(i));
			HLPrSetI(hl_ofs_other, HLPrEdictValue(j));
			HLPrExecute(touch);
			hl_pr_error = FALSE;

qtt_inner:
		}

qtt_next:
	}
}

U0 HLGameForceRetouch()
{//re-link every entity and re-run trigger touches for a frame or two
 //
 //touches only fire when something moves, so spawn_tdeath sets
 //force_retouch = 2 to catch an entity resting inside a freshly spawned
 //trigger. without it a telefrag on an occupied destination fails silently
	I64 retouch;
	I64 i;

	if (hl_ofs_force_retouch < 0)
		return;

	retouch = ToI64(HLPrGetF(hl_ofs_force_retouch));
	if (retouch <= 0)
		return;

	//bounds first, a trigger spawned this frame has none yet
	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (!hl_pr_edict_free[i])
			HLGameLinkEdict(i);
	}

	HLGameTouchTriggersAll;

	HLPrSetF(hl_ofs_force_retouch, ToF64(retouch - 1));
}

U0 HLGameRunThinks()
{//thinks can spawn or free other entities, so re-read the bound each pass
	I64 i;
	I64 think;
	I64 flags;
	F64 nextthink;
	U8  wline[128];

	i = 0;
	while (i < hl_pr_num_edicts)
	{
		//pushers already thought in the physics pass on their local clock,
		//running them here fires the think twice. FL_CLIENT thinks run after
		//PlayerPostThink, the SV_Physics_Client order
		flags = 0;
		if (!hl_pr_edict_free[i])
			flags = ToI64(HLPrFieldF(i, hl_fld_flags));

		if (!hl_pr_edict_free[i] &&
			ToI64(HLPrFieldF(i, hl_fld_movetype)) != HLMOVETYPE_PUSH &&
			!(flags & HLFL_CLIENT))
		{
			nextthink = HLPrFieldF(i, hl_fld_nextthink);

			if (nextthink > 0.0 && nextthink <= hl_game_time)
			{
				//clear before calling, the think usually reschedules itself
				HLPrSetFieldF(i, hl_fld_nextthink, 0.0);

				think = HLPrFieldI(i, hl_fld_think);
				if (think > 0 && think < hl_pr_num_functions)
				{
					HLPrSetI(hl_ofs_self, HLPrEdictValue(i));
					HLPrSetI(hl_ofs_other, 0);
					HLPrExecute(think);
					hl_game_thinks++;

					if (hl_pr_error)
						hl_pr_error = FALSE;

					//same invariant as at spawn - whichever think leaves the
					//world damageable ran with self pointing at edict 0.
					//reported once, so the log names the classname
					if (HLPrFieldF(0, hl_fld_takedamage) != 0.0)
					{
						if (!hl_world_warned)
						{
							StrPrint(wline,
								"HLGame: think of %s corrupted world.takedamage\n",
								HLPrStr(HLPrFieldI(i, hl_fld_classname)));
							HLLog(wline);
							hl_world_warned = TRUE;
						}

						HLPrSetFieldF(0, hl_fld_takedamage, 0.0);
						HLPrSetFieldF(0, hl_fld_health, 0.0);
					}
				}
			}
		}

		i++;
	}
}

//set when a coop game swallowed a "restart" - the remote pass in HLSvRunClients
//picks it up and respawns the other bodies. not zeroed by the loader
Bool hl_coop_respawn_pending = FALSE;

Bool HLGameCoopRespawn(I64 ent)
{//respawn(), coop branch of client.qc:
 //    CopyToBodyQue (self); setspawnparms (self); PutClientInServer ();
 //
 //back into the running level - no map reload, so nobody else loses progress
	I64 fn;
	I64 slot;
	I64 ofs;
	I64 i;

	if (ent <= 0 || ent >= hl_pr_num_edicts || hl_pr_edict_free[ent])
		return FALSE;

	//leave a corpse where they fell, as the original does
	fn = HLPrFindFunction("CopyToBodyQue");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
		HLPrSetI(hl_ofs_other, 0);
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	//setspawnparms: the kit this client had at level start, not at death.
	//clients are edicts 1..maxclients, so the slot is the edict minus one
	slot = ent - 1;
	if (slot >= 0 && slot < HLSV_MAX_CLIENTS && hl_client_parms_set[slot])
	{
		for (i = 0; i < HLGAME_MAX_PARMS; i++)
		{
			ofs = hl_ofs_parms[i];
			if (ofs >= 0)
				HLPrSetF(ofs,
					hl_client_parms[slot * HLPR_MAX_PARM_GLOBALS + i]);
		}
	}

	fn = HLPrFindFunction("PutClientInServer");
	if (fn <= 0)
		return FALSE;

	HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
	HLPrSetI(hl_ofs_other, 0);
	HLPrExecute(fn);
	hl_pr_error = FALSE;

	HLGameLinkEdict(ent);

	return TRUE;
}

U0 HLGameFrame(F64 dt)
{//advance game time, run one round of thinking
	I64 fn;

	if (!hl_game_active)
		return;

	hl_game_time += dt;

	//SV_SpawnServer publishes the game mode globals. they must be explicitly
	//zero in single player - CheatCommand (impulse 9) returns early on
	//deathmatch || coop
	HLGameApplyModeCvars;

	//skill sits outside pr_global_struct, at global offset 349, and progs
	//never writes it - the engine publishes it by name via ED_FindGlobal.
	//left at 0, every monster behaves as if on Easy
	if (hl_ofs_skill >= 0)
		HLPrSetF(hl_ofs_skill, HLCvarGet("skill"));

	HLPrSetF(hl_ofs_time, hl_game_time);
	HLPrSetF(hl_ofs_frametime, dt);

	fn = HLPrFindFunction("StartFrame");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, 0);
		HLPrExecute(fn);
		if (hl_pr_error)
			hl_pr_error = FALSE;
	}

	//bounds first, so absmin/absmax match where entities actually are
	HLGameLinkAll;

	//physics before thinks, the server order - move, touch, then think.
	//reversed, rockets explode a tick late.
	//retouch runs before physics, as SV_Physics does
	HLGameForceRetouch;

	HLGameRunPhysics(dt);
	HLGameRunThinks;

	//coop must not reload the level on a death. stock client.qc avoids
	//it - respawn() only reaches localcmd("restart\n") on the single player
	//branch - but a mod reaching here would throw away every other
	//player's progress, so the request is swallowed and serviced in place
	//
	//the local body is done here, right before the shell adopts .origin off the
	//edict. remotes are cached in the server slots, so HLSvRunClients redoes
	//them where it can also fix the cache
	if (hl_coop_active && hl_restart_pending)
	{
		hl_restart_pending = FALSE;
		HLLog("HLGame: coop - respawning in place, not restarting\n");

		if (hl_player_edict > 0 &&
			HLPrFieldF(hl_player_edict, hl_fld_health) <= 0.0)
			HLGameCoopRespawn(hl_player_edict);

		hl_coop_respawn_pending = TRUE;
	}
}

U0 HLGameSaveParms()
{//SetChangeParms packs the inventory into parm1..parm16, keep a copy. the
 //game logic owns the rules, the engine only carries the result
	I64	fn;
	I64	ofs;
	I64	i;
	I64	slot;
	I64	ent;
	F64	value;

	hl_have_saved_parms = FALSE;

	if (!hl_game_active || hl_player_edict <= 0)
		return;

	fn = HLPrFindFunction("SetChangeParms");

	//SV_SaveSpawnparms runs SetChangeParms for every client and stores the
	//result on that client - in coop each player carries their own kit across
	//the level change, so one shared copy would hand everyone the host's
	//loadout. clients are edicts 1..maxclients
	for (slot = 0; slot < HLSV_MAX_CLIENTS; slot++)
	{
		ent = slot + 1;

		if (ent >= hl_pr_num_edicts || hl_pr_edict_free[ent])
			goto qsp_next;
		if (!(ToI64(HLPrFieldF(ent, hl_fld_flags)) & HLFL_CLIENT))
			goto qsp_next;

		if (fn > 0)
		{
			HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
			HLPrExecute(fn);
			hl_pr_error = FALSE;
		}

		for (i = 0; i < HLGAME_MAX_PARMS; i++)
		{
			ofs = hl_ofs_parms[i];
			if (ofs < 0)
				goto qsp_next_parm;

			//via a temp - this compiler computes the slot address before
			//evaluating the call and can lose the store
			value = HLPrGetF(ofs);
			hl_client_parms[slot * HLPR_MAX_PARM_GLOBALS + i] = value;

qsp_next_parm:
		}

		hl_client_parms_set[slot] = TRUE;

qsp_next:
	}

	//the local player's set is also the one restored into the freshly loaded
	//bytecode, so worldspawn and the first ClientConnect see something sane
	for (i = 0; i < HLGAME_MAX_PARMS; i++)
	{
		hl_saved_parms[i] = 0.0;
		ofs = hl_ofs_parms[i];

		if (ofs >= 0)
		{
			value = hl_client_parms[i];
			hl_saved_parms[i] = value;
		}
	}

	//serverflags tracks which episode runes are collected. it is a progs
	//global, not a client field - episode progression is shared in coop, so it
	//is read once here and never stamped per player
	if (hl_ofs_serverflags >= 0)
	{
		value = HLPrGetF(hl_ofs_serverflags);
		hl_saved_serverflags = value;
	}

	hl_have_saved_parms = TRUE;
}

U0 HLGameClearParms()
{//a death restart must not hand back the items the player died with
	hl_have_saved_parms = FALSE;
}

U0 HLGameRestoreParms()
{//back into the freshly loaded bytecode before the player spawns -
 //ClientConnect reads these to rebuild the loadout
	I64	ofs;
	I64	i;

	if (!hl_have_saved_parms)
		return;

	for (i = 0; i < HLGAME_MAX_PARMS; i++)
	{
		ofs = hl_ofs_parms[i];
		if (ofs >= 0)
			HLPrSetF(ofs, hl_saved_parms[i]);
	}

	if (hl_ofs_serverflags >= 0)
		HLPrSetF(hl_ofs_serverflags, hl_saved_serverflags);
}

U0 HLDropPunchAngle(I64 ent, F64 dt)
{//DropPunchAngle, top of SV_ClientThink
 //
 //the decay lives here, not in QuakeC - the weapons set .punchangle and never
 //clear it, so without this the view stays pitched down forever
 //
 //normalise, shorten by 10/sec, scale back, so it decays along its own axis
	F64 v[3];
	F64 len;
	I64 j;

	if (ent <= 0 || hl_fld_punchangle < 0)
		return;

	for (j = 0; j < 3; j++)
		v[j] = HLPrFieldF(ent, hl_fld_punchangle + j);

	len = HLVecLength(v);
	if (len <= 0.0)
		return;

	for (j = 0; j < 3; j++)
		v[j] /= len;

	len -= 10.0 * dt;
	if (len < 0.0)
		len = 0.0;

	for (j = 0; j < 3; j++)
		HLPrSetFieldF(ent, hl_fld_punchangle + j, v[j] * len);
}

Bool HLGameInit(CHLMap *map, Bool spawn_entities = TRUE)
{//load the bytecode, wire the builtins, populate the world
 //
 //spawn_entities is FALSE when a savegame supplies the entity state - the
 //bytecode still has to come up, but spawn side effects would linger past
 //the restore that overwrites them
	I64 i;
	I64 ent;

	hl_game_active  = FALSE;

	hl_game_time    = 1.0;		//QuakeC reads time 0 as never scheduled
	hl_game_thinks  = 0;
	hl_game_spawned = 0;

	//globals aren't zeroed
	hl_coop_active          = FALSE;
	hl_coop_respawn_pending = FALSE;

	//RefreshSkillData is called from CGameRules' constructor, which runs on
	//map load before any entity spawns. Here that is ahead of the HLPrLoad
	//return below, because the native path - HLEntSpawnAll, then
	//HLAIMonRegisterAll - is what reads the tables this fills, and it runs
	//only when this function has already returned FALSE
	HLSkillLoad;

	if (!HLPrLoad("progs.dat", HLGAME_MAX_EDICTS))
		return FALSE;

	HLPrCacheOffsets;
	HLBiInit;
	hl_bi_map = map;

	//before any spawn runs. HLGameInhibitEntity reads the resolved pair for
	//every map entity, and PutClientInServer -> SelectSpawnPoint reads the
	//coop global to pick info_player_coop over info_player_start. published
	//per-frame only it would be 0 for the whole spawn pass and coop players
	//would all pile onto the single player start
	HLGameApplyModeCvars;

	//before any spawn runs - slot 1 = world, 2..N = its submodels
	HLBiPrecacheWorld(map, hl_map_name);

	//without these the image isn't stock QuakeC and would fault confusingly
	if (hl_ofs_self < 0 || hl_ofs_time < 0 || hl_fld_nextthink < 0 ||
		hl_fld_think < 0)
	{
		"HLGame: progs.dat is missing required symbols\n";
		return FALSE;
	}

	HLPrSetF(hl_ofs_time, hl_game_time);
	HLPrSetF(hl_ofs_frametime, HLGAME_FRAME_TIME);

	//every client edict is reserved before any map entity spawns.
	//SV_SpawnServer:
	//    sv.num_edicts = svs.maxclients + 1;
	//    for (i = 0; i < svs.maxclients; i++)
	//        svs.clients[i].edict = EDICT_NUM(i + 1);
	//clients are always edicts 1..maxclients. .colormap is the edict number
	//and the client reads cl.scores[colormap - 1], so a player at edict 11
	//with maxclients 4 is not representable on the wire
	//bound is svs.maxclients, not the compile-time ceiling. the original reserves
	//exactly as many as the server accepts, so a solo game reserves one and
	//world entities start at edict 2
	for (i = 0; i < hl_sv_maxclients; i++)
	{
		ent = HLPrSpawnEdict;

		if (i == 0)
			hl_player_edict = ent;
	}

	//carried in from the previous level, restored before anything spawns so
	//worldspawn and ClientConnect both see it
	HLGameRestoreParms;

	//no main() call. world.qc defines one but documents it as test
	//scaffolding, and SV_SpawnServer never runs it

	if (spawn_entities)
	{
		hl_game_spawned = HLGameSpawnEntities(map);
		HLHeapCheck("after map spawn");
	}
	else
	{
		//a savegame restores the precache lists from the file instead
		hl_game_spawned = 0;
	}

	//the world must never be damageable - T_Damage bails on it, and edict 0
	//has no death function, so getting through means a null call on every hit
	HLPrSetFieldF(0, hl_fld_takedamage, 0.0);
	HLPrSetFieldF(0, hl_fld_health, 0.0);
	HLPrSetFieldF(0, hl_fld_solid, ToF64(HLSOLID_BSP_));

	hl_game_active  = TRUE;

	"HLGame: %d entities spawned, %d edicts live\n",
		hl_game_spawned, hl_pr_num_edicts;

	return TRUE;
}

U0 HLGameShutdown()
{//the player handle dies with the vm - HLPrStr hands back pointers into the
 //string blob HLPrFree is about to release, and every HLPlayer accessor gates on
 //hl_player_active alone
	hl_game_active    = FALSE;
	hl_world_active   = FALSE;
	hl_player_active  = FALSE;
	hl_player_edict   = 0;
	hl_bi_map      = NULL;

	//per-map state, all pointing at things about to be freed
	//
	//logged per step: a fault in any of these lands inside the allocator, where
	//the backtrace names Free and nothing else. the last line names the step
	HLLog("  shutdown: statics\n");	HLLogFlush;
	HLBiStaticClear;
	HLBiBeamsClear;
	HLBiIntermissionClear;
	HLBiCenterClear;

	HLLog("  shutdown: lights/ambients\n");	HLLogFlush;
	HLDlightClear;
	HLSndAmbientClear;
	HLLightInit;

	HLLog("  shutdown: precache\n");	HLLogFlush;
	HLBiFreePrecache;

	HLLog("  shutdown: bsp models\n");	HLLogFlush;
	HLBiBspCacheFree;
	HLBiSprCacheFree;

	HLLog("  shutdown: progs\n");	HLLogFlush;
	HLPrFree;

	HLLog("  shutdown: ok\n");	HLLogFlush;
}

U0 HLGameDrawStatics(CHLCanvas *c, CHLMap *map)
{//statics are not edicts any more, so they draw from their own list
	CHLStaticEnt	*se;
	F64			 d[3];
	I64			 i;

	for (i = 0; i < hl_static_count; i++)
	{
		se = &hl_static_ent[i];

		if (!se->mdl)
			goto qds_next;

		HLVecSub(se->origin, c->origin, d);
		if (HLVecLength(d) > HLGAME_STATIC_DIST)
			goto qds_next;

		HLMdlDraw(c, se->mdl, se->frame, se->origin, se->angles[1],
			HLLightPoint(map, se->origin));

qds_next:
	}
}

//protocol effect flags. QuakeC sets .effects, the client turns them into light
#define HLEF_BRIGHTFIELD		1
#define HLEF_MUZZLEFLASH		2
#define HLEF_BRIGHTLIGHT		4
#define HLEF_DIMLIGHT		8

U0 HLGameEntityLights(F64 time)
{//.effects -> dynamic lights, once per frame
 //
 //these move, so none of it can come from the compiled lightmap. re-added
 //every frame with a one frame lifetime, pinning them to the entity
	F64 org[3];
	I64 effects;
	I64 i;
	I64 j;

	if (hl_fld_effects < 0)
		return;

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
			goto qel_next;

		effects = ToI64(HLPrFieldF(i, hl_fld_effects));
		if (!effects)
			goto qel_next;

		for (j = 0; j < 3; j++)
			org[j] = HLPrFieldF(i, hl_fld_origin + j);

		if (effects & HLEF_MUZZLEFLASH)
		{
			//the flash sits in front of the eye, not at the feet
			org[2] += 16.0;
			HLDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.1, 0.0, time);
			org[2] -= 16.0;

			//SV_WriteEntitiesToClient: the server clears this bit after showing
			//it once. QuakeC only ever sets it, so without the clear the light
			//stays on for the rest of the level
			HLPrSetFieldF(i, hl_fld_effects,
				ToF64(effects & ~HLEF_MUZZLEFLASH));
		}

		if (effects & HLEF_BRIGHTLIGHT)
		{
			org[2] += 16.0;
			HLDlightAdd(org, 400.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);
			org[2] -= 16.0;
		}

		if (effects & HLEF_DIMLIGHT)
			HLDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);

qel_next:
	}
}

//HLFL_CLIENT is defined with the physics flags above

//HL's player is taller than quake's: 32x32x72 standing, origin at the feet
//plus 36. must agree with hull 1 in HLClip exactly, or the player traces
//against a box the compiler never expanded the world by
#define HLPL_MINS_XY		-16.0
#define HLPL_MAXS_XY		16.0
#define HLPL_MINS_Z		-36.0
#define HLPL_MAXS_Z		36.0
#define HLPL_VIEW_OFS_Z	28.0

//ducked: 32x32x36, view drops with it. hull 3
#define HLPL_DUCK_MINS_Z	-18.0
#define HLPL_DUCK_MAXS_Z	18.0
#define HLPL_DUCK_VIEW_Z	12.0

U0 HLEdictSetVec(I64 ent, I64 fld, F64 x, F64 y, F64 z)
{
	HLPrSetFieldF(ent, fld, x);
	HLPrSetFieldF(ent, fld + 1, y);
	HLPrSetFieldF(ent, fld + 2, z);
}

Bool HLClientSpawnAt(I64 ent, F64 *origin, F64 *angles, U8 *player_name)
{//outfit any edict as a client. the local player is the first
 //
 //split out of HLPlayerSpawn so a remote client gets a body through the
 //identical path - SetNewParms, ClientConnect, PutClientInServer
 //
 //.netname is set before ClientConnect so the join bprint has a name
	I64  fn;
	U8  *netname;

	if (ent <= 0)
		return FALSE;

	//SelectSpawnPoint reads the coop and deathmatch globals, not the cvars:
	//coop -> "info_player_coop" (falling back to info_player_start when the
	//map has none), deathmatch -> the info_player_deathmatch ring. resolve
	//them again here so a mode change between levels cannot spawn a late
	//joiner by the previous game's rules
	HLGameApplyModeCvars;

	if (!player_name || !player_name[0])
		netname = "player";
	else
		netname = player_name;

	HLEdictSetVec(ent, hl_fld_origin, origin[0], origin[1], origin[2]);
	HLEdictSetVec(ent, hl_fld_angles, 0.0, angles[1], 0.0);
	HLEdictSetVec(ent, hl_fld_v_angle, 0.0, angles[1], 0.0);
	HLEdictSetVec(ent, hl_fld_velocity, 0.0, 0.0, 0.0);
	HLEdictSetVec(ent, hl_fld_mins, HLPL_MINS_XY, HLPL_MINS_XY, HLPL_MINS_Z);
	HLEdictSetVec(ent, hl_fld_maxs, HLPL_MAXS_XY, HLPL_MAXS_XY, HLPL_MAXS_Z);
	HLEdictSetVec(ent, hl_fld_view_ofs, 0.0, 0.0, HLPL_VIEW_OFS_Z);

	HLPrSetFieldF(ent, hl_fld_flags, ToF64(HLFL_CLIENT));
	HLPrSetFieldI(ent, hl_fld_classname, HLPrNewString("player"));
	HLPrSetFieldI(ent, hl_fld_netname, HLPrNewString(netname));

	fn = HLPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	fn = HLPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
		HLPrSetI(hl_ofs_other, 0);
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	fn = HLPrFindFunction("PutClientInServer");
	if (fn <= 0)
		return FALSE;

	HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
	HLPrSetI(hl_ofs_other, 0);
	HLPrExecute(fn);
	hl_pr_error = FALSE;

	//PutClientInServer can wipe runtime fields, pin the name again so frags
	//and obituaries still see it
	HLPrSetFieldI(ent, hl_fld_netname, HLPrNewString(netname));

	//PutClientInServer picks the spawn point, so hand back what it chose
	origin[0] = HLPrFieldF(ent, hl_fld_origin);
	origin[1] = HLPrFieldF(ent, hl_fld_origin + 1);
	origin[2] = HLPrFieldF(ent, hl_fld_origin + 2);

	return TRUE;
}

U0 HLGameDrawEntities(CHLCanvas *c, CHLMap *map, F64 *view_origin, F64 max_dist)
{//every live entity with a model
	F64		eorg[3];
	F64		eang[3];
	F64		d[3];
	CHLMdl	*mdl;
	I64		 i;
	I64		 idx;
	I64		 frame;
	I64		 bm;
	I64		 top;
	I64		 bottom;
	I64		 cmap;
	U8		*name;
	U8		*mstr;

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
			goto qg_next;

		//never draw the player's own body in first person - the model exists
		//for other clients and demos, from inside the head it wraps the camera
		if (i == hl_player_edict)
			goto qg_next;

		idx = ToI64(HLPrFieldF(i, hl_fld_modelindex));
		if (idx <= 0 || idx >= hl_precache_model_count)
			goto qg_next;

		//the model string is checked as well as the index. QuakeC
		//hides a picked-up item by nulling .model, which leaves .modelindex
		//alone - only setmodel writes that. SV_WriteEntitiesToClient:
		//    if (!ent->v.modelindex || !pr_strings[ent->v.model])
		mstr = HLPrStr(HLPrFieldI(i, hl_fld_model));
		if (!mstr || !mstr[0])
			goto qg_next;

		eorg[0] = HLPrFieldF(i, hl_fld_origin);
		eorg[1] = HLPrFieldF(i, hl_fld_origin + 1);
		eorg[2] = HLPrFieldF(i, hl_fld_origin + 2);

		name = hl_precache_model[idx];

		//brush models are map geometry and go through the face path. the
		//origin goes with them or every door draws shut
		//
		//handled before the distance cull and not subject to it: a brush
		//entity's .origin is an offset from where the brushes were authored,
		//not a position - e1m1's water lift parks at (0,0,-400). culling on
		//that offset hides the lift while its collision stays. the original
		//culls these by PVS and frustum, never by distance
		if (name[0] == '*')
		{
			bm = HLClipBrushModel(idx);
			if (bm > 0)
				//.frame selects the alternate texture chain - a button lit
				//while pressed, a door with its lamp on
				HLDrawBrushModel(c, map, bm, eorg,
					ToI64(HLPrFieldF(i, hl_fld_frame)));
			goto qg_next;
		}

		//sprites always face the eye, so they need no angles
		if (idx > 0 && idx < HLBI_MAX_PRECACHE && hl_precache_spr[idx])
		{
			HLVecSub(eorg, view_origin, d);
			if (HLVecLength(d) > max_dist)
				goto qg_next;

			HLSprDraw(c, hl_precache_spr[idx],
				ToI64(HLPrFieldF(i, hl_fld_frame)), eorg,
				HLLightPoint(map, eorg));
			goto qg_next;
		}

		//an external .bsp (ammo box, crate) is a brush model in its own file,
		//and its origin IS a real position, unlike a submodel's
		if (idx > 0 && idx < HLBI_MAX_PRECACHE && hl_precache_bsp[idx])
		{
			HLVecSub(eorg, view_origin, d);
			if (HLVecLength(d) > max_dist)
				goto qg_next;

			HLDrawBrushModel(c, hl_precache_bsp[idx], 0, eorg,
				ToI64(HLPrFieldF(i, hl_fld_frame)));
			goto qg_next;
		}

		//CL_RelinkEntities' trail pass, before the distance reject - the trail
		//is particles in the world, not this entity's drawing
		if (idx > 0 && idx < HLBI_MAX_PRECACHE && hl_precache_mdl[idx])
			HLPartEntityTrail(i, eorg, hl_precache_mdl[idx]->flags, tS);

		//alias models are point entities, so a distance reject is meaningful
		HLVecSub(eorg, view_origin, d);
		if (HLVecLength(d) > max_dist)
			goto qg_next;

		eang[0] = HLPrFieldF(i, hl_fld_angles);
		eang[1] = HLPrFieldF(i, hl_fld_angles + 1);
		eang[2] = HLPrFieldF(i, hl_fld_angles + 2);

		if (!StrICompare(name, "progs/player.mdl"))
		{
			cmap = 0;
			if (hl_fld_colormap >= 0)
				cmap = ToI64(HLPrFieldF(i, hl_fld_colormap));

			//.colormap is a client number, the colours are in the scoreboard
			HLSvColorsForColormap(cmap, &top, &bottom);
			mdl = HLMdlPreviewGet(top, bottom);
		}
		else
			mdl = hl_precache_mdl[idx];

		if (!mdl)
			goto qg_next;

		frame = ToI64(HLPrFieldF(i, hl_fld_frame));
		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		//CL_RelinkEntities spins powerups and runes on the client from one
		//shared clock, so they turn in unison - nothing in QuakeC drives it,
		//the flag is in the model file. drawn copy only, writing the edict
		//would fight the game logic
		if (mdl->flags & HLMDLF_ROTATE)
			eang[1] = HLAngleNorm(100.0 * hl_game_time);

		//lit from the surface underneath, not a flat constant. full orientation,
		//not yaw alone - SV_ClientThink leans a player's body by a third of
		//their view pitch, and a yaw-only draw discards that
		HLMdlDrawAngles(c, mdl, frame, eorg, eang, HLLightPoint(map, eorg));

qg_next:
	}
}
