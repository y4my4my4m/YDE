	hl_ai_mon_info[HLMON_ASSASSIN].health     = HLSkillCvar("sk_hassassin_health", 50.0);
	hl_ai_mon_info[HLMON_ASSASSIN].range_dmg  = HLSkillCvar("sk_9mm_bullet", 5.0);

	hl_ai_mon_info[HLMON_GARGANTUA].health      = HLSkillCvar("sk_gargantua_health", 800.0);
