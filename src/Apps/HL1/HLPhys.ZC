// HLPhys.ZC - player movement and collision against the clipnode hulls
//
// Hulls 1 and 2 are the render geometry pre-grown by a player and a monster box,
// so collision is a point trace, not a box sweep. No bounds are carried here.
//
// Recursion below is direct self-recursion. Routing it through a
// forward-declared helper miscompiles on this compiler.

#define HLCONTENTS_NODE		0		//not a leaf value; only children are

#define HLPHYS_GRAVITY		800.0
#define HLPHYS_MAXSPEED		320.0
#define HLPHYS_ACCEL			10.0

//sv_airaccelerate is 10 in HL, not quake's 0.7. HLPHYS_AIRSPEEDCAP below bounds
//it; the pair defines airstrafing. See HLAirAccelerate
#define HLPHYS_AIRACCEL		10.0
#define HLPHYS_AIRSPEEDCAP	30.0

#define HLPHYS_FRICTION		4.0
#define HLPHYS_STOPSPEED		100.0

//PM_Jump: sqrt(2 * 800 * 45), exactly enough to clear 45 units. Quake used a
//round 270
#define HLPHYS_JUMP			268.3281573

//PM_PreventMegaBunnyJumping: above 1.7x maxspeed a jump scales the whole
//velocity by 0.65, which stops bunnyhopping compounding
#define HLPHYS_BUNNY_FACTOR	1.7
#define HLPHYS_BUNNY_SCALE	0.65

//PM_CheckVelocity clamps every axis to sv_maxvelocity
#define HLPHYS_MAXVELOCITY	2000.0

#define HLPHYS_STEPSIZE		18.0
//SV_FlyMove numbumps. An extra bump slides along one more plane than the
//original allows and lands the player elsewhere in a tight corner
#define HLPHYS_MAXCLIP		4
#define HLPHYS_EPSILON		0.03125	//1/32, matches the compiler's precision
#define HLPHYS_OVERCLIP		1.0

//HL player box, matching hull 1's expansion. Used to sample liquid depth.
//See HLHullClipMins
#define HLPHYS_MINS_Z		-36.0
#define HLPHYS_MAXS_Z		36.0
#define HLPHYS_VIEW_Z		28.0

//ducked: hull 3. The view drops with the box, animated over TIME_TO_DUCK rather
//than snapping
#define HLPHYS_DUCK_MINS_Z	-18.0
#define HLPHYS_DUCK_MAXS_Z	18.0
#define HLPHYS_DUCK_VIEW_Z	12.0
#define HLPHYS_DUCK_TIME		0.4

//how far the origin moves when the box changes size under stationary feet
#define HLPHYS_DUCK_SHIFT	18.0

//PM_WaterMove: movevars->waterfriction is 1, not quake's 4, and the friction
//term scales by pmove->friction (the surface multiplier, 1 by default) rather
//than movevars->friction
#define HLPHYS_WATERFRICTION	1.0
#define HLPHYS_WATERSPEED	0.8		//0.8 in HL, quake used 0.7
#define HLPHYS_WATERSINK		60.0	//drift down when not actively swimming

//PM_LadderMove: MAX_CLIMB_SPEED. The dismount throws the player along the full
//view forward at 270
#define HLPHYS_CLIMBSPEED	200.0
#define HLPHYS_LADDER_JUMP	270.0

//PM_CheckWaterJump / PM_WaterJump. WJ_HEIGHT is the probe height above the
//origin, the forward reach is 24, and the scripted push lasts 2 seconds. The SDK
//counts it in milliseconds; this file is in seconds throughout
#define HLPHYS_WJ_HEIGHT		8.0
#define HLPHYS_WJ_FORWARD	24.0
#define HLPHYS_WJ_TIME		2.0
#define HLPHYS_WJ_UP			225.0
#define HLPHYS_WJ_PUSH		-50.0	//movedir = -50 * ledge normal
#define HLPHYS_WJ_SINKING	-180.0	//falling faster than this means entering water

//player.h. PLAYER_MAX_SAFE_FALL_SPEED is where damage starts,
//PLAYER_FATAL_FALL_SPEED where it reaches exactly 100 points, and
//PLAYER_FALL_PUNCH_THRESHHOLD where the landing becomes audible
#define HLPHYS_FALL_SAFE		580.0
#define HLPHYS_FALL_FATAL	1024.0
#define HLPHYS_FALL_PUNCH	350.0
#define HLPHYS_FALL_BOUNCE	200.0

//movevars->edgefriction. PM_Friction doubles friction when nothing is under the
//leading edge, which lets the player stop on the lip of a drop
#define HLPHYS_EDGEFRICTION	2.0

//CONTENTS_CURRENT_* push. func_conveyor defaults pev->speed to 100, and the same
//number serves for a world current
#define HLPHYS_CURRENT_SPEED	100.0

//--- 3x4 transforms ---------------------------------------------------------
//
// Required by rotating brush entities: func_rotating, func_door_rotating,
// momentary_rot_button and a banking func_tracktrain place their brushwork with
// (pitch, yaw, roll) rather than a translation.
//
// HLStudio.ZC has the same three functions (HLStAngleMatrix,
// HLStVectorTransform, HLStConcatTransforms) and they are not reused: it compiles
// after HLDraw.ZC and the compiler is single pass, so the renderer cannot see
// them. HLPhys is the earliest file both the renderer and the clipper can reach.
//
// Layout is row major, 3 rows of 4 - [xx xy xz tx][yx yy yz ty][zx zy zz tz] -
// with an implied (0 0 0 1) fourth row, so one matrix carries a rotation and a
// translation. Same layout as HLStudio's bone matrices.
//
// None of these may alias: `in` and `out` must be different arrays. Each writes
// out[0] before reading in[1].

U0 HLMatFromAngles(F64 *angles, F64 *origin, F64 *m)
{//AngleMatrix - (pitch, yaw, roll) in degrees plus a translation
 //
 //the columns are the entity's basis: column 0 forward, column 1 -right,
 //column 2 up (see HLAngleVectors). The matrix is a pure rotation, so its
 //transpose is its inverse, and the inverse below is three dot products
 //against the columns
	F64 sr;
	F64 sp;
	F64 sy;
	F64 cr;
	F64 cp;
	F64 cy;
	F64 a;

	a  = angles[0] * HLDEG2RAD;
	sp = Sin(a);
	cp = Cos(a);

	a  = angles[1] * HLDEG2RAD;
	sy = Sin(a);
	cy = Cos(a);

	a  = angles[2] * HLDEG2RAD;
	sr = Sin(a);
	cr = Cos(a);

	m[0] = cp * cy;
	m[4] = cp * sy;
	m[8] = -sp;

	m[1] = sr * sp * cy - cr * sy;
	m[5] = sr * sp * sy + cr * cy;
	m[9] = sr * cp;

	m[2]  = cr * sp * cy + sr * sy;
	m[6]  = cr * sp * sy - sr * cy;
	m[10] = cr * cp;

	m[3]  = origin[0];
	m[7]  = origin[1];
	m[11] = origin[2];
}

U0 HLMatRotate(F64 *in, F64 *m, F64 *out)
{//rotation only, for a normal or direction, which must not be translated
	out[0] = in[0] * m[0] + in[1] * m[1] + in[2] * m[2];
	out[1] = in[0] * m[4] + in[1] * m[5] + in[2] * m[6];
	out[2] = in[0] * m[8] + in[1] * m[9] + in[2] * m[10];
}

U0 HLMatRotateInv(F64 *in, F64 *m, F64 *out)
{//rotate by the inverse, i.e. the transpose, valid for a pure rotation.
 //world direction -> model direction
	out[0] = in[0] * m[0] + in[1] * m[4] + in[2] * m[8];
	out[1] = in[0] * m[1] + in[1] * m[5] + in[2] * m[9];
	out[2] = in[0] * m[2] + in[1] * m[6] + in[2] * m[10];
}

U0 HLMatTransform(F64 *in, F64 *m, F64 *out)
{//model point -> world point
	out[0] = in[0] * m[0] + in[1] * m[1] + in[2] * m[2]  + m[3];
	out[1] = in[0] * m[4] + in[1] * m[5] + in[2] * m[6]  + m[7];
	out[2] = in[0] * m[8] + in[1] * m[9] + in[2] * m[10] + m[11];
}

U0 HLMatTransformInv(F64 *in, F64 *m, F64 *out)
{//world point -> model point. The translation is subtracted before unrotating
	F64 t[3];

	t[0] = in[0] - m[3];
	t[1] = in[1] - m[7];
	t[2] = in[2] - m[11];

	out[0] = t[0] * m[0] + t[1] * m[4] + t[2] * m[8];
	out[1] = t[0] * m[1] + t[1] * m[5] + t[2] * m[9];
	out[2] = t[0] * m[2] + t[1] * m[6] + t[2] * m[10];
}

Bool HLMatAnglesActive(F64 *angles)
{//TRUE for any orientation other than identity. Keeps an unrotated brush off
 //the matrix path
 //
 //written with relationals, not ==: F64 equality is sign-of-zero sensitive on
 //this compiler and misses -0.0 (see HLIsZeroF below). Under == a -0.0 angle
 //reads as rotated, and every static func_wall pays a matrix multiply per vertex
	if (angles[0] < 0.0 || angles[0] > 0.0)
		return TRUE;
	if (angles[1] < 0.0 || angles[1] > 0.0)
		return TRUE;
	if (angles[2] < 0.0 || angles[2] > 0.0)
		return TRUE;

	return FALSE;
}

class CHLTrace
{
	Bool all_solid;		//the whole sweep was inside solid
	Bool start_solid;	//the sweep began inside solid
	F64	 fraction;		//how far along the move it reached, 0..1
	F64	 end_pos[3];
	F64	 plane_normal[3];
	F64	 plane_dist;
	Bool hit;			//a plane was struck
	I64	 ent;			//edict struck, -1 for the world

	//what the sweep crossed. visible() rejects a sight line through both
	Bool in_open;
	Bool in_water;
};

I64 HLHullPointContents(CHLMap *map, I64 num, F64 *p)
{//walk the clipnode tree until a negative (contents) child appears
	CHLClipNode	*node;
	CHLPlane		*plane;
	F64			 d;

	while (num >= 0)
	{
		if (num >= map->num_clipnodes)
			return HLCONTENTS_SOLID;

		node  = &map->clipnodes[num];
		plane = &map->planes[node->plane_num];

		//axial planes are the common case and skip the dot product
		if (plane->type < 3)
			d = p[plane->type] - plane->dist;
		else
			d = HLVecDot(p, plane->normal) - plane->dist;

		if (d < 0.0)
			num = node->children[1];
		else
			num = node->children[0];
	}

	return num;
}

Bool HLIsZeroF(F64 v)
{//exactly-zero test written without == on an F64
 //F64 equality is sign-of-zero sensitive on this compiler and misses -0.0,
 //which SV_FlyMove's step test must match. Relationals are not affected
	return ToBool(v <= 0.0 && v >= 0.0);
}

//hull->firstclipnode. The backup loop tests against the whole hull, not the
//subtree being recursed. Set by the entry points below
I64 hl_hull_head = 0;

Bool HLRecursiveHullCheck(CHLMap *map, I64 num, F64 p1f, F64 p2f,
	F64 *p1, F64 *p2, CHLTrace *trace)
{//sweep a point p1 to p2. FALSE once the move is blocked
 //direct self-recursion only; see the file header
	CHLClipNode	*node;
	CHLPlane		*plane;
	F64			 t1;
	F64			 t2;
	F64			 frac;
	F64			 midf;
	F64			 mid[3];
	F64			 zero[3];
	I64			 side;
	I64			 i;

	//--- leaf ---
	if (num < 0)
	{
		if (num != HLCONTENTS_SOLID)
		{
			trace->all_solid = FALSE;

			//SV_RecursiveHullCheck records what it crossed as it goes
			if (num == HLCONTENTS_EMPTY)
				trace->in_open = TRUE;
			else
				trace->in_water = TRUE;

			return TRUE;
		}

		trace->start_solid = TRUE;
		return TRUE;
	}

	if (num >= map->num_clipnodes)
		return FALSE;

	node  = &map->clipnodes[num];
	plane = &map->planes[node->plane_num];

	if (plane->type < 3)
	{
		t1 = p1[plane->type] - plane->dist;
		t2 = p2[plane->type] - plane->dist;
	}
	else
	{
		t1 = HLVecDot(p1, plane->normal) - plane->dist;
		t2 = HLVecDot(p2, plane->normal) - plane->dist;
	}

	//wholly on one side; no split
	if (t1 >= 0.0 && t2 >= 0.0)
		return HLRecursiveHullCheck(map, node->children[0], p1f, p2f, p1, p2,
			trace);
	if (t1 < 0.0 && t2 < 0.0)
		return HLRecursiveHullCheck(map, node->children[1], p1f, p2f, p1, p2,
			trace);

	//--- split: stop short of the plane so the point never lands on it ---
	if (t1 < 0.0)
		frac = (t1 + HLPHYS_EPSILON) / (t1 - t2);
	else
		frac = (t1 - HLPHYS_EPSILON) / (t1 - t2);

	if (frac < 0.0)
		frac = 0.0;
	if (frac > 1.0)
		frac = 1.0;

	midf = p1f + (p2f - p1f) * frac;
	for (i = 0; i < 3; i++)
		mid[i] = p1[i] + frac * (p2[i] - p1[i]);

	if (t1 < 0.0)
		side = 1;
	else
		side = 0;

	//near side first; if it blocks, the far side is unreachable
	if (!HLRecursiveHullCheck(map, node->children[side], p1f, midf, p1, mid,
			trace))
		return FALSE;

	//far side open; the move continues into it
	if (HLHullPointContents(map, node->children[side ^ 1], mid) !=
			HLCONTENTS_SOLID)
		return HLRecursiveHullCheck(map, node->children[side ^ 1], midf, p2f,
			mid, p2, trace);

	//started in solid and never left it; no usable impact
	if (trace->all_solid)
		return FALSE;

	//impact. The stored normal faces back along the move
	if (side)
	{
		//subtracted from zero, not multiplied by -1, as VectorSubtract from
		//vec3_origin does. 0.0 - 0.0 is +0.0 while 0.0 * -1.0 is -0.0, and
		//SV_FlyMove's step test on normal[2] fails against -0.0: a stair
		//approached from the back side of its plane blocks the player
		HLVecSet(zero, 0.0, 0.0, 0.0);
		HLVecSub(zero, plane->normal, trace->plane_normal);

		trace->plane_dist = -plane->dist;
	}
	else
	{
		HLVecCopy(plane->normal, trace->plane_normal);
		trace->plane_dist = plane->dist;
	}

	//back out until the impact point is clear of solid. The DIST_EPSILON nudge
	//is off one plane and says nothing about the others bounding the leaf, so an
	//inside corner still lands in solid and the next move starts all-solid
	while (HLHullPointContents(map, hl_hull_head, mid) == HLCONTENTS_SOLID)
	{
		frac -= 0.1;

		if (frac < 0.0)
		{
			//the original logs "backup past 0" and keeps the point
			//anyway; there is nothing better to return
			trace->fraction = midf;
			HLVecCopy(mid, trace->end_pos);
			trace->hit = TRUE;
			return FALSE;
		}

		midf = p1f + (p2f - p1f) * frac;
		for (i = 0; i < 3; i++)
			mid[i] = p1[i] + frac * (p2[i] - p1[i]);
	}

	trace->fraction = midf;
	HLVecCopy(mid, trace->end_pos);
	trace->hit = TRUE;

	return FALSE;
}

U0 HLTraceMove(CHLMap *map, F64 *start, F64 *end, CHLTrace *trace)
{//sweep the player's origin through hull 1
	I64 head;

	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	trace->ent         = -1;
	HLVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	HLVecCopy(end, trace->end_pos);

	//guarded after init, so a rejected map still returns a formed trace
	if (!HLMapValid(map, "HLTraceMove"))
		return;

	head = map->models[0].head_node[1];

	hl_hull_head = head;
	HLRecursiveHullCheck(map, head, 0.0, 1.0, start, end, trace);
}

U0 HLTracePoint(CHLMap *map, F64 *start, F64 *end, CHLTrace *trace)
{//UTIL_TraceLine: sweep a dimensionless point through the world, hull 0
 //
 //hull 1 stops when the 32x32x72 player box touches, so its end_pos sits up to
 //half a hull diagonal off the surface. Anything that reads end_pos as a point
 //on a surface - decals, lightmap samples, effect origins pulled out along the
 //plane normal - uses this instead.
 //
 //World only. Entity clipping lives in HLClip.ZC, which compiles later
	I64 head;

	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	trace->ent         = -1;
	HLVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	HLVecCopy(end, trace->end_pos);

	if (!HLMapValid(map, "HLTracePoint"))
		return;

	//hull 0 is the render tree rebased into the clipnode array by
	//HLBSPMakeHull0. -1 when the model has no render root
	head = map->models[0].hull0_head;
	if (head < 0)
		return;

	hl_hull_head = head;
	HLRecursiveHullCheck(map, head, 0.0, 1.0, start, end, trace);
}

F64  hl_old_origin[3];		//last origin known to be in open space
I64  hl_stuck_reports = 0;	//capped, so a stuck frame cannot flood the console

Bool HLTestPlayerPosition(CHLMap *map, F64 *origin)
{//TRUE when the player box at this origin is embedded in solid
	CHLTrace trace;

	HLTraceMove(map, origin, origin, &trace);
	return trace.all_solid;
}

U0 HLCheckStuck(CHLMap *map, F64 *origin)
{//push the player back out of solid. Without this, stuck is permanent: the slide
 //move sees all_solid, zeroes velocity and leaves the origin alone.
 //Recovery order matches the original: last open origin, then outward one unit
 //at a time and up 18, enough to clear a step but not to cross a wall
	F64 org[3];
	I64 i;
	I64 j;
	I64 z;

	if (!HLTestPlayerPosition(map, origin))
	{
		HLVecCopy(origin, hl_old_origin);
		return;
	}

	HLVecCopy(origin, org);

	HLVecCopy(hl_old_origin, origin);
	if (!HLTestPlayerPosition(map, origin))
		return;

	for (z = 0; z < 18; z++)
	{
		for (i = -1; i <= 1; i++)
		{
			for (j = -1; j <= 1; j++)
			{
				origin[0] = org[0] + ToF64(i);
				origin[1] = org[1] + ToF64(j);
				origin[2] = org[2] + ToF64(z);

				if (!HLTestPlayerPosition(map, origin))
					return;
			}
		}
	}

	//nothing open nearby; restore the original position and report
	HLVecCopy(org, origin);

	if (hl_stuck_reports < 8)
	{
		hl_stuck_reports++;
		"HLPhys: player stuck at %.0f %.0f %.0f\n", org[0], org[1], org[2];
	}
}

U0 HLClipVelocity(F64 *v, F64 *normal, F64 overbounce, F64 *out)
{//remove the component of v heading into the plane, so the move slides
	F64 backoff = HLVecDot(v, normal) * overbounce;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		out[i] = v[i] - normal[i] * backoff;

		//snapped to zero, or the player creeps back into the surface
		if (out[i] > -HLPHYS_EPSILON && out[i] < HLPHYS_EPSILON)
			out[i] = 0.0;
	}
}










I64 HLPointContents(CHLMap *map, F64 *p)
{//volume this point is in: empty, solid, water, slime or lava
 //walks the render node tree. Hull 0 is that tree, not a clipnode hull; feeding
 //head_node[0] to the clipnode walker indexes a different array
	CHLNode	*node;
	CHLPlane	*plane;
	I64		 num;
	F64		 d;

	//an unusable map reads as solid, which stops movement rather than leaking
	if (!HLMapValid(map, "HLPointContents"))
		return HLCONTENTS_SOLID;

	num = map->models[0].head_node[0];

	while (num >= 0)
	{
		if (num >= map->num_nodes)
			return HLCONTENTS_SOLID;

		node  = &map->nodes[num];
		plane = &map->planes[node->plane_num];

		if (plane->type < 3)
			d = p[plane->type] - plane->dist;
		else
			d = HLVecDot(p, plane->normal) - plane->dist;

		if (d < 0.0)
			num = node->children[1];
		else
			num = node->children[0];
	}

	//a negative child is ~(leaf index); the leaf carries the contents
	num = -1 - num;
	if (num < 0 || num >= map->num_leafs)
		return HLCONTENTS_SOLID;

	return map->leafs[num].contents;
}

Bool HLContentsCurrent(I64 c)
{//one of the six CONTENTS_CURRENT_* values
 //
 //a contiguous run, -9 (CURRENT_0) down to -14 (CURRENT_DOWN), so one range test
 //replaces six compares. A range and not a bitmask: quake and HL enumerate
 //contents where quake 2 bit-flags them
	if (c <= HLCONTENTS_CURRENT_0 && c >= HLCONTENTS_CURRENT_DOWN)
		return TRUE;

	return FALSE;
}

Bool HLContentsLiquid(I64 c)
{//swimmable contents
 //
 //a current brush is a water brush the compiler tagged with a push direction:
 //its leaf carries CURRENT_x instead of CONTENTS_WATER, not as well as. Missing
 //that makes a river read as air - no swimming, no tint, and full fall damage
	if (c == HLCONTENTS_WATER || c == HLCONTENTS_SLIME || c == HLCONTENTS_LAVA)
		return TRUE;

	return HLContentsCurrent(c);
}

I64 HLContentsWaterType(I64 c)
{//the .watertype QuakeC sees. It compares against CONTENTS_WATER and knows
 //nothing about currents, so a current reports as plain water
	if (HLContentsCurrent(c))
		return HLCONTENTS_WATER;

	return c;
}

I64 HLWaterLevelGet(CHLMap *map, F64 *origin, I64 *_watertype)
{//liquid depth, 0 dry to 3 fully under
 //sampled at feet, waist and eyes, which QuakeC keys swimming and drowning on
	F64 point[3];
	I64 contents;
	I64 level = 0;

	if (_watertype)
		*_watertype = HLCONTENTS_EMPTY;

	//feet, one unit above the bottom of the box
	HLVecCopy(origin, point);
	point[2] = origin[2] + HLPHYS_MINS_Z + 1.0;

	contents = HLPointContents(map, point);
	if (!HLContentsLiquid(contents))
		return 0;

	level = 1;
	if (_watertype)
		*_watertype = HLContentsWaterType(contents);

	//waist
	point[2] = origin[2] + (HLPHYS_MINS_Z + HLPHYS_MAXS_Z) * 0.5;
	contents = HLPointContents(map, point);
	if (HLContentsLiquid(contents))
	{
		level = 2;

		//eyes: fully submerged, gates swimming and drowning
		point[2] = origin[2] + HLPHYS_VIEW_Z;
		contents = HLPointContents(map, point);
		if (HLContentsLiquid(contents))
			level = 3;
	}

	return level;
}


