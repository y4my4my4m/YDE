// engine services shared by the shell
//
// the QuakeC builtin dispatcher went with the VM. what is left: the cvar table,
// the model and sound precache lists, temp entities, beams, intermission and
// finale state, centerprint, and the console print and stuffcmd queues
// HLMenu.ZC drains.

#define HLBI_MAX_PRECACHE	256

U8		*hl_precache_model[HLBI_MAX_PRECACHE];

U8		 hl_world_model_name[96];
CHLMdl	*hl_precache_mdl[HLBI_MAX_PRECACHE];
CHLMap	*hl_precache_bsp[HLBI_MAX_PRECACHE];
CHLSpr	*hl_precache_spr[HLBI_MAX_PRECACHE];
I64		 hl_precache_model_count = 0;
U8		*hl_precache_sound[HLBI_MAX_PRECACHE];
I64		 hl_precache_sound_count = 0;

#define HLCVAR_MAX	64

class CHLCvar
{
	U8	name[24];
	F64	value;
};

CHLCvar	hl_cvars[HLCVAR_MAX];
I64		hl_cvar_count = 0;

U0 HLCvarDefine(U8 *name, F64 value)
{
	U8 full_line[64];

	if (hl_cvar_count >= HLCVAR_MAX)
	{
		StrPrint(full_line, "cvar table full, dropped %s\n", name);
		HLLog(full_line);
		return;
	}

	HLStrCopy(hl_cvars[hl_cvar_count].name, name, 24);
	hl_cvars[hl_cvar_count].value = value;
	hl_cvar_count++;
}

I64 HLCvarIndex(U8 *name)
{
	I64 i;

	for (i = 0; i < hl_cvar_count; i++)
		if (!StrICompare(hl_cvars[i].name, name))
			return i;

	return -1;
}

F64 HLCvarGet(U8 *name)
{//unknown names read as 0, as Cvar_VariableValue does
	I64 i = HLCvarIndex(name);

	if (i < 0)
		return 0.0;

	return hl_cvars[i].value;
}

U0 HLCvarSet(U8 *name, F64 value)
{
	I64 i = HLCvarIndex(name);

	if (i < 0)
		HLCvarDefine(name, value);
	else
		hl_cvars[i].value = value;
}

U0 HLCvarInit()
{
	hl_cvar_count = 0;

	HLCvarDefine("r_ambient",	0.0);
	HLCvarDefine("crosshair",	1.0);

	HLCvarDefine("showtriggers",	0.0);

	HLCvarDefine("r_speeds",	0.0);

	HLCvarDefine("r_decals",		300.0);
	HLCvarDefine("r_dynamic",	1.0);
	HLCvarDefine("r_drawentities",	1.0);
	HLCvarDefine("r_drawsprites",	1.0);
	HLCvarDefine("r_lightpoint",	1.0);
	HLCvarDefine("r_beams",		1.0);
	HLCvarDefine("r_drawsky",	1.0);

	HLCvarDefine("volume",		0.7);
	HLCvarDefine("bgmvolume",	1.0);
	HLCvarDefine("suitvolume",	0.25);
	HLCvarDefine("room_off",		0.0);
	HLCvarDefine("cl_nolerp",	0.0);
	HLCvarDefine("cl_crossx",	0.0);
	HLCvarDefine("cl_crossy",	0.0);
	HLCvarDefine("ambient_level", 0.3);
	HLCvarDefine("ambient_fade", 100.0);
	HLCvarDefine("viewsize",		100.0);
	HLCvarDefine("demoloop",		1.0);
	HLCvarDefine("cl_forwardspeed", 400.0);
	HLCvarDefine("cl_backspeed",	400.0);
	HLCvarDefine("m_pitch",		0.022);
	HLCvarDefine("lookspring",	0.0);
	HLCvarDefine("lookstrafe",	0.0);
	HLCvarDefine("registered",	0.0);
	HLCvarDefine("skill",		1.0);
	HLCvarDefine("deathmatch",	0.0);
	HLCvarDefine("coop",			0.0);
	HLCvarDefine("teamplay",		0.0);
	HLCvarDefine("fraglimit",	0.0);
	HLCvarDefine("timelimit",	0.0);

	HLCvarDefine("sv_cheats",	1.0);

	HLCvarDefine("cl_netdraw",	0.0);

	HLCvarDefine("chase_active",	0.0);
	HLCvarDefine("chase_back",	100.0);
	HLCvarDefine("chase_up",		16.0);
	HLCvarDefine("chase_right",	0.0);
}


#define HLBSP_CACHE_MAX	24
#define HLBSP_NAME_MAX	64

U8		 hl_bsp_cache_name[HLBSP_CACHE_MAX * HLBSP_NAME_MAX];
CHLMap	*hl_bsp_cache_map[HLBSP_CACHE_MAX];
I64		 hl_bsp_cache_count = 0;

#define HLSPR_CACHE_MAX	16

U8		 hl_spr_cache_name[HLSPR_CACHE_MAX * HLBSP_NAME_MAX];
CHLSpr	*hl_spr_cache_spr[HLSPR_CACHE_MAX];
I64		 hl_spr_cache_count = 0;

Bool HLBiIsSprName(U8 *name)
{
	I64 n;

	if (!name || name[0] == '*')
		return FALSE;

	n = StrLen(name);
	if (n < 5)
		return FALSE;

	return ToBool(!StrICompare(name + n - 4, ".spr"));
}

CHLSpr *HLBiSprCacheGet(U8 *name)
{
	I64 i;

	if (!HLBiIsSprName(name))
		return NULL;

	for (i = 0; i < hl_spr_cache_count; i++)
	{
		if (!StrICompare(&hl_spr_cache_name[i * HLBSP_NAME_MAX], name))
			return hl_spr_cache_spr[i];
	}

	if (hl_spr_cache_count >= HLSPR_CACHE_MAX)
		return NULL;

	i = hl_spr_cache_count;
	HLStrCopy(&hl_spr_cache_name[i * HLBSP_NAME_MAX], name, HLBSP_NAME_MAX);
	hl_spr_cache_spr[i] = HLSprLoad(name);
	hl_spr_cache_count++;

	return hl_spr_cache_spr[i];
}

U0 HLBiSprCacheFree()
{
	I64 i;

	for (i = 0; i < hl_spr_cache_count && i < HLSPR_CACHE_MAX; i++)
	{
		if (hl_spr_cache_spr[i])
			HLSprFree(hl_spr_cache_spr[i]);

		hl_spr_cache_spr[i] = NULL;
		hl_spr_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	hl_spr_cache_count = 0;

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_spr[i] = NULL;
}

U0 HLBiBspCacheInit()
{
	I64 i;

	hl_bsp_cache_count = 0;

	for (i = 0; i < HLBSP_CACHE_MAX; i++)
	{
		hl_bsp_cache_map[i] = NULL;
		hl_bsp_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_bsp[i] = NULL;

	hl_spr_cache_count = 0;
	for (i = 0; i < HLSPR_CACHE_MAX; i++)
	{
		hl_spr_cache_spr[i] = NULL;
		hl_spr_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_spr[i] = NULL;
}

Bool HLBiIsBspName(U8 *name)
{
	I64 n;

	if (!name || name[0] == '*')
		return FALSE;

	n = StrLen(name);
	if (n < 5)
		return FALSE;

	return ToBool(!StrICompare(name + n - 4, ".bsp"));
}

CHLMap *HLBiBspCacheGet(U8 *name)
{
	I64 i;

	if (!HLBiIsBspName(name))
		return NULL;

	for (i = 0; i < hl_bsp_cache_count; i++)
	{
		if (!StrICompare(&hl_bsp_cache_name[i * HLBSP_NAME_MAX], name))
			return hl_bsp_cache_map[i];
	}

	if (hl_bsp_cache_count >= HLBSP_CACHE_MAX)
		return NULL;

	i = hl_bsp_cache_count;
	HLStrCopy(&hl_bsp_cache_name[i * HLBSP_NAME_MAX], name, HLBSP_NAME_MAX);
	hl_bsp_cache_map[i] = HLBSPLoad(name);
	hl_bsp_cache_count++;

	return hl_bsp_cache_map[i];
}

U0 HLBiBspCacheFree()
{
	I64 i;

	for (i = 0; i < hl_bsp_cache_count && i < HLBSP_CACHE_MAX; i++)
	{
		if (hl_bsp_cache_map[i])
			HLBSPFree(hl_bsp_cache_map[i]);

		hl_bsp_cache_map[i] = NULL;
		hl_bsp_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	hl_bsp_cache_count = 0;

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_bsp[i] = NULL;
}

I64 HLBiPrecacheModel(U8 *name)
{//index 0 is "no model", real entries start at 1
	I64 i;

	for (i = 1; i < hl_precache_model_count; i++)
	{
		if (!StrCompare(hl_precache_model[i], name))
			return i;
	}

	if (hl_precache_model_count >= HLBI_MAX_PRECACHE)
		return 0;

	if (!hl_precache_model_count)
	{
		//slot 0 is "no model" - set empty explicitly, globals are not zeroed
		hl_precache_model[0] = NULL;
		hl_precache_mdl[0]   = NULL;
		hl_precache_model_count = 1;
	}

	i = hl_precache_model_count;
	hl_precache_model_count++;

	hl_precache_model[i] = name;
	hl_precache_mdl[i]   = NULL;

	if (name[0] != '*' && StrLen(name) > 4 &&
		!StrICompare(name + StrLen(name) - 4, ".mdl"))
		hl_precache_mdl[i] = HLMdlCacheGet(name);

	hl_precache_bsp[i] = HLBiBspCacheGet(name);
	hl_precache_spr[i] = HLBiSprCacheGet(name);

	if (name[0] == '*' && i < HLCLIP_MAX_PRECACHE)
		hl_precache_bmodel[i] = ToI64(HLAtoF(name + 1));

	return i;
}

CHLMdl *HLBiFindModel(U8 *name)
{
	I64 i;

	if (!name || !name[0])
		return NULL;

	for (i = 1; i < hl_precache_model_count; i++)
	{
		if (hl_precache_model[i] && !StrICompare(hl_precache_model[i], name))
			return hl_precache_mdl[i];
	}

	return NULL;
}


#define HLBI_MAX_STATIC	256

class CHLStaticEnt
{
	CHLMdl	*mdl;
	F64		 origin[3];
	F64		 angles[3];
	I64		 frame;
};

CHLStaticEnt	hl_static_ent[HLBI_MAX_STATIC];
I64			hl_static_count = 0;

U0 HLBiStaticClear()
{
	hl_static_count = 0;
}

Bool HLBiWireRoom(CHLMsg *m, I64 need)
{
	I64 cap;

	if (!m)
		return FALSE;

	if (m == &hl_sv_datagram)
		cap = HLNET_MAX_DATAGRAM;
	else
		cap = HLNET_MAX_MSG;

	return ToBool(m->len < cap - need);
}

U0 HLBiWireByte(CHLMsg *m, I64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteByte(m, value);
}

U0 HLBiWireString(CHLMsg *m, U8 *str)
{
	if (!HLBiWireRoom(m, 64))
		return;
	HLMsgWriteString(m, str);
}


U0 HLBiFreePrecache()
{
	HLClipPrecacheReset;

	I64 i;

	for (i = 0; i < hl_precache_model_count; i++)
	{
		if (hl_precache_mdl[i])
		{
			hl_precache_mdl[i] = NULL;
		}
	}

	hl_precache_model_count = 0;
	hl_precache_sound_count = 0;
}

Bool hl_intermission	= FALSE;

F64	 hl_completed_time	= 0.0;
Bool hl_finale		= FALSE;
//SCR_CenterPrint's buffer is 1024.
#define HLCENTER_MAX	1024

U8	 hl_finale_text[HLCENTER_MAX];

U0 HLBiIntermissionClear()
{
	hl_intermission   = FALSE;
	hl_finale         = FALSE;
	hl_completed_time = 0.0;
	hl_finale_text[0] = 0;
}

#define HLTE_SPIKE			0
#define HLTE_SUPERSPIKE		1
#define HLTE_GUNSHOT			2
#define HLTE_EXPLOSION		3
#define HLTE_TAREXPLOSION	4
#define HLTE_LIGHTNING1		5
#define HLTE_LIGHTNING2		6
#define HLTE_WIZSPIKE		7
#define HLTE_KNIGHTSPIKE		8
#define HLTE_LIGHTNING3		9
#define HLTE_LAVASPLASH		10
#define HLTE_TELEPORT		11
#define HLTE_EXPLOSION2		12
#define HLTE_BEAM			13

I64 hl_te_count	= 0;

U0 HLBiRicochet(F64 *org)
{
	I64 r;

	if (HLPartRandI(5))
	{
		HLSndPlayAt("weapons/tink1.wav", org, 1.0, 1.0);
		return;
	}

	r = HLPartRandI(4);

	if (r == 1)
		HLSndPlayAt("weapons/ric1.wav", org, 1.0, 1.0);
	else if (r == 2)
		HLSndPlayAt("weapons/ric2.wav", org, 1.0, 1.0);
	else
		HLSndPlayAt("weapons/ric3.wav", org, 1.0, 1.0);
}

U0 HLBiTempEntity(I64 type, F64 *org)
{
	F64 zero[3];

	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_te_count++;

	switch (type)
	{
		case HLTE_EXPLOSION:
		case HLTE_TAREXPLOSION:
			HLFxExplosion(org, 100.0, 0, tS);
			HLSndPlayAt("weapons/r_exp3.wav", org, 1.0, 1.0);
			break;

		case HLTE_GUNSHOT:
			HLFxGunshot(org, tS);
			break;

		case HLTE_SPIKE:
			HLFxGunshot(org, tS);
			HLBiRicochet(org);
			break;

		case HLTE_SUPERSPIKE:
			HLFxGunshot(org, tS);
			HLBiRicochet(org);
			break;

		case HLTE_WIZSPIKE:
			HLPartEffect(org, zero, 20, 30, tS);
			HLSndPlayAt("wizard/hit.wav", org, 1.0, 1.0);
			break;

		case HLTE_KNIGHTSPIKE:
			HLPartEffect(org, zero, 226, 20, tS);
			HLSndPlayAt("hknight/hit.wav", org, 1.0, 1.0);
			break;

		case HLTE_LAVASPLASH:
			HLPartLavaSplash(org, tS);
			break;

		case HLTE_TELEPORT:
			HLPartTeleport(org, tS);
			break;

		default:
			break;
	}
}


#define HLBI_MAX_BEAMS	16
#define HLBEAM_SEGMENT	30.0
#define HLBEAM_LIFE		0.2

class CHLBeam
{
	F64		 start[3];
	F64		 end[3];
	F64		 die_time;
	I64		 entity;
	CHLMdl	*mdl;
};

CHLBeam	hl_beam[HLBI_MAX_BEAMS];
I64		hl_beam_count = 0;

U0 HLBiBeamsClear()
{
	hl_beam_count = 0;
}

U0 HLBiBeamAdd(I64 type, F64 *start, F64 *end, F64 time, I64 entity = 0)
{
	CHLBeam	*b;
	U8		*name;
	I64		 i;
	I64		 slot = -1;

	if (type == HLTE_LIGHTNING1)
		name = "progs/bolt.mdl";
	else if (type == HLTE_LIGHTNING2)
		name = "progs/bolt2.mdl";
	else
		name = "progs/bolt3.mdl";

	if (entity)
	{
		for (i = 0; i < hl_beam_count; i++)
		{
			if (hl_beam[i].entity == entity)
			{
				slot = i;
				break;
			}
		}
	}

	if (slot < 0)
	{
		for (i = 0; i < hl_beam_count; i++)
		{
			if (hl_beam[i].die_time <= time)
			{
				slot = i;
				break;
			}
		}
	}

	if (slot < 0)
	{
		if (hl_beam_count < HLBI_MAX_BEAMS)
		{
			slot = hl_beam_count;
			hl_beam_count++;
		}
		else
			slot = 0;
	}

	b = &hl_beam[slot];
	HLVecCopy(start, b->start);
	HLVecCopy(end, b->end);
	b->die_time = time + HLBEAM_LIFE;
	b->entity   = entity;
	b->mdl      = HLBiFindModel(name);
}

U0 HLBiBeamsFollow(I64 view_entity)
{
	I64 i;

	if (view_entity <= 0)
		return;

	for (i = 0; i < hl_beam_count; i++)
	{
		if (hl_beam[i].entity != view_entity)
			goto qbf_next;

		if (view_entity < HLNET_MAX_ENTS)
			HLVecCopy(hl_net_cl[view_entity].origin, hl_beam[i].start);

qbf_next:
	}
}

#define HLBEAM_LIGHT			240

U0 HLBiDrawBeams(CHLCanvas *c, F64 time)
{
	CHLBeam	*b;
	F64		 dir[3];
	F64		 org[3];
	F64		 ang[3];
	F64		 len;
	I64		 i;
	I64		 seg;
	I64		 steps;

	for (i = 0; i < hl_beam_count; i++)
	{
		b = &hl_beam[i];

		if (b->die_time <= time || !b->mdl)
			goto qb_next;

		HLVecSub(b->end, b->start, dir);
		len = HLVecLength(dir);

		if (len < 1.0)
			goto qb_next;

		HLVecScale(dir, 1.0 / len, dir);

		HLVecToAngles(dir, ang);

		steps = ToI64(len / HLBEAM_SEGMENT) + 1;
		HLVecCopy(b->start, org);

		for (seg = 0; seg < steps; seg++)
		{
			ang[2] = ToF64(RandU32() % 360);

			HLMdlDrawAngles(c, b->mdl, 0, org, ang, HLBEAM_LIGHT);

			org[0] += dir[0] * HLBEAM_SEGMENT;
			org[1] += dir[1] * HLBEAM_SEGMENT;
			org[2] += dir[2] * HLBEAM_SEGMENT;
		}

qb_next:
	}
}

#define HLCENTER_TIME	2.0

U8  hl_center_text[HLCENTER_MAX];
F64 hl_center_until	= 0.0;
F64 hl_center_start	= 0.0;

Bool hl_restart_pending	= FALSE;

U0 HLBiCenterClear()
{
	hl_center_text[0] = 0;
	hl_center_until   = 0.0;
	hl_center_start   = 0.0;
}

#define HLBI_PRINT_MAX	1024

U8	hl_bi_print_buf[HLBI_PRINT_MAX];
I64	hl_bi_print_len = 0;

U0 HLBiPrintAppend(U8 *s)
{
	I64 n;

	if (!s)
		return;

	n = StrLen(s);

	if (hl_bi_print_len + n + 1 >= HLBI_PRINT_MAX)
		return;

	MemCopy(hl_bi_print_buf + hl_bi_print_len, s, n);
	hl_bi_print_len += n;
	hl_bi_print_buf[hl_bi_print_len] = 0;
}

#define HLBI_STUFF_MAX	512

U8	hl_bi_stuff_buf[HLBI_STUFF_MAX];
I64	hl_bi_stuff_len = 0;

U0 HLBiStuffCmd(I64 ent, U8 *s)
{
	I64 n;
	I64 slot;

	if (!s || !s[0])
		return;

	if (ent > 0 && ent != hl_player_edict)
	{
		slot = ent - 1;		//edicts 1..maxclients are reserved per slot
		if (slot >= 0 && slot < HLSV_MAX_CLIENTS)
		{
			HLBiWireByte(&hl_sv_client_msg[slot], HLSVC_STUFFTEXT);
			HLBiWireString(&hl_sv_client_msg[slot], s);
		}
		return;
	}

	n = StrLen(s);

	if (hl_bi_stuff_len + n + 1 >= HLBI_STUFF_MAX)
		return;

	MemCopy(hl_bi_stuff_buf + hl_bi_stuff_len, s, n);
	hl_bi_stuff_len += n;
	hl_bi_stuff_buf[hl_bi_stuff_len] = 0;
}
