// HLBuiltin.ZC - the engine services QuakeC calls into.
//
// a QuakeC function with a negative first_statement is a builtin, the negated
// value is its number. shareware progs references 65 of them, 1..78.
//
// args arrive in the reserved parameter cells, results go in the return cell.
// anything unimplemented is a no-op returning zero - degrade, don't halt the
// VM mid-frame.

#define HLBI_MAX_PRECACHE	256

//must be a function. ZealC #define substitutes a bare token only, so a
//function-like macro parses its "(n)" as code and fails with "Invalid class".

CHLMap	*hl_bi_map		= NULL;		//set by the app before the VM runs
Bool	 hl_bi_dprint	= FALSE;	//dprint is noisy, off by default

//globals are not zeroed, and the precache free walks every slot - garbage
//here becomes a wild Free()
U8		*hl_precache_model[HLBI_MAX_PRECACHE];

//backing store for the world entry and its "*N" submodel names - the precache
//table holds borrowed pointers and these have to outlive the map
U8		 hl_world_model_name[96];
U8		 hl_submodel_names[HLBI_MAX_PRECACHE * 8];
CHLMdl	*hl_precache_mdl[HLBI_MAX_PRECACHE];
CHLMap	*hl_precache_bsp[HLBI_MAX_PRECACHE];	//external .bsp models
CHLSpr	*hl_precache_spr[HLBI_MAX_PRECACHE];	//.spr sprite models
I64		 hl_precache_model_count = 0;
U8		*hl_precache_sound[HLBI_MAX_PRECACHE];
I64		 hl_precache_sound_count = 0;

//trace result globals, resolved by name at init
I64 hl_ofs_trace_allsolid	= -1;
I64 hl_ofs_trace_startsolid	= -1;
I64 hl_ofs_trace_fraction	= -1;
I64 hl_ofs_trace_endpos		= -1;
I64 hl_ofs_trace_plane_normal = -1;
I64 hl_ofs_trace_plane_dist	= -1;
I64 hl_ofs_trace_ent			= -1;
I64 hl_ofs_trace_inopen		= -1;
I64 hl_ofs_trace_inwater		= -1;

U8 hl_bi_err_line[256];

//--- cvars -----------------------------------------------------------------
//
//progs.dat queries exactly ten: registered, skill, deathmatch, coop, teamplay,
//samelevel, noexit, fraglimit, timelimit, temp1. registered gates
//trigger_onlyregistered_touch, so a hardcoded 0 gives the shareware nag.

#define HLCVAR_MAX	32

class CHLCvar
{
	U8	name[24];
	F64	value;
};

CHLCvar	hl_cvars[HLCVAR_MAX];
I64		hl_cvar_count = 0;

U0 HLCvarDefine(U8 *name, F64 value)
{
	if (hl_cvar_count >= HLCVAR_MAX)
		return;

	HLStrCopy(hl_cvars[hl_cvar_count].name, name, 24);
	hl_cvars[hl_cvar_count].value = value;
	hl_cvar_count++;
}

I64 HLCvarIndex(U8 *name)
{
	I64 i;

	for (i = 0; i < hl_cvar_count; i++)
		if (!StrICompare(hl_cvars[i].name, name))
			return i;

	return -1;
}

F64 HLCvarGet(U8 *name)
{//unknown names read as 0, as Cvar_VariableValue does
	I64 i = HLCvarIndex(name);

	if (i < 0)
		return 0.0;

	return hl_cvars[i].value;
}

U0 HLCvarSet(U8 *name, F64 value)
{//an unknown name is created, as Cvar_Set does for cvar_set from progs
	I64 i = HLCvarIndex(name);

	if (i < 0)
		HLCvarDefine(name, value);
	else
		hl_cvars[i].value = value;
}

U0 HLCvarInit()
{//the original's own registration defaults
	hl_cvar_count = 0;

	HLCvarDefine("r_ambient",	0.0);
	//1, not Quake's 0: HL always shows a reticle and has no menu toggle for it.
	//The reticle itself is per weapon, so an unarmed map still draws nothing.
	HLCvarDefine("crosshair",	1.0);
	HLCvarDefine("cl_nolerp",	0.0);
	HLCvarDefine("cl_crossx",	0.0);
	HLCvarDefine("cl_crossy",	0.0);
	HLCvarDefine("ambient_level", 0.3);
	HLCvarDefine("ambient_fade", 100.0);
	HLCvarDefine("viewsize",		100.0);
	HLCvarDefine("demoloop",		1.0);
	HLCvarDefine("cl_forwardspeed", 400.0);
	HLCvarDefine("cl_backspeed",	400.0);
	HLCvarDefine("m_pitch",		0.022);
	HLCvarDefine("lookspring",	0.0);
	HLCvarDefine("lookstrafe",	0.0);
	HLCvarDefine("registered",	0.0);
	HLCvarDefine("skill",		1.0);
	HLCvarDefine("deathmatch",	0.0);
	HLCvarDefine("coop",			0.0);
	HLCvarDefine("teamplay",		0.0);
	HLCvarDefine("fraglimit",	0.0);
	HLCvarDefine("timelimit",	0.0);

	//not an NQ cvar - cheats there are ungated commands (god, noclip, fly,
	//give, impulse 9). registered anyway so it reads back.
	HLCvarDefine("sv_cheats",	1.0);

	//draw from the client's reconstructed table instead of the server edicts
	HLCvarDefine("cl_netdraw",	0.0); // host draws edicts; guest forces wire path

	//chase camera. chase_active pulls the eye back behind the player, the
	//other three are the offset in V_CalcRefdef's own units
	HLCvarDefine("chase_active",	0.0);
	HLCvarDefine("chase_back",	100.0);
	HLCvarDefine("chase_up",		16.0);
	HLCvarDefine("chase_right",	0.0);
}

//--- helpers ---------------------------------------------------------------

I64 HLBiArg(I64 n)
{//global offset of arg n - slots are three cells wide so vectors fit
	return HLPR_OFS_PARM0 + n * HLPR_PARM_STRIDE;
}

F64 HLBiArgF(I64 n)
{
	return HLPrGetF(HLBiArg(n));
}

I64 HLBiArgI(I64 n)
{
	return HLPrGetI(HLBiArg(n));
}

U0 HLBiArgV(I64 n, F64 *out)
{
	HLPrGetV(HLBiArg(n), out);
}

U8 *HLBiArgS(I64 n)
{
	return HLPrStr(HLPrGetI(HLBiArg(n)));
}

I64 HLBiArgEnt(I64 n)
{
	return HLPrEdictNum(HLPrGetI(HLBiArg(n)));
}

U0 HLBiRetF(F64 v)
{
	HLPrSetF(HLPR_OFS_RETURN, v);
}

U0 HLBiRetV(F64 *v)
{
	HLPrSetV(HLPR_OFS_RETURN, v);
}

U0 HLBiRetEnt(I64 num)
{
	HLPrSetI(HLPR_OFS_RETURN, HLPrEdictValue(num));
}

U0 HLBiGetFieldV(I64 ent, I64 fld, F64 *out)
{
	out[0] = HLPrFieldF(ent, fld);
	out[1] = HLPrFieldF(ent, fld + 1);
	out[2] = HLPrFieldF(ent, fld + 2);
}

U0 HLBiSetFieldV(I64 ent, I64 fld, F64 *v)
{
	HLPrSetFieldF(ent, fld, v[0]);
	HLPrSetFieldF(ent, fld + 1, v[1]);
	HLPrSetFieldF(ent, fld + 2, v[2]);
}

U0 HLBiPrecacheWorld(CHLMap *map, U8 *mapname)
{//SV_SpawnServer's fixed reservation: slot 1 is the world, 2..N its inline
 //submodels "*1".."*(n-1)", before any QuakeC spawn precaches anything
 //
 //order is not cosmetic - the client builds its model table from this list
 //and resolves "*N" against the world at entry 1. filling it lazily puts "*1"
 //at index 1 and the client fails with "Model *1 not found".
	I64	 i;
	I64	 n;
	U8	*s;

	if (!mapname || !mapname[0])
		return;

	hl_precache_model[0]    = NULL;
	hl_precache_mdl[0]      = NULL;
	hl_precache_model_count = 1;

	//slot 1: the world. copied - the caller's buffer is reused per map.
	HLStrCopy(hl_world_model_name, mapname, 96);
	hl_precache_model[1] = hl_world_model_name;
	hl_precache_mdl[1]   = NULL;
	hl_precache_model_count = 2;

	if (!map)
		return;

	//hl_precache_model is the smaller table, so it sets the bound
	n = map->num_models;
	if (n > HLBI_MAX_PRECACHE - 2)
		n = HLBI_MAX_PRECACHE - 2;

	for (i = 1; i < n; i++)
	{
		if (hl_precache_model_count >= HLBI_MAX_PRECACHE)
			break;

		s = hl_submodel_names + (i - 1) * 8;
		StrPrint(s, "*%d", i);

		hl_precache_model[hl_precache_model_count] = s;
		hl_precache_mdl[hl_precache_model_count]   = NULL;
		hl_precache_bmodel[hl_precache_model_count] = i;
		hl_precache_model_count++;
	}
}

//--- external brush models --------------------------------------------------
//
// ammo boxes, health boxes and the exploding crate are whole .bsp files in the
// PAK, loaded with setmodel("maps/b_shell0.bsp") - not alias models and not
// "*N" submodels. no bounds means droptofloor has nothing to stand on.

#define HLBSP_CACHE_MAX	24
#define HLBSP_NAME_MAX	64

U8		 hl_bsp_cache_name[HLBSP_CACHE_MAX * HLBSP_NAME_MAX];
CHLMap	*hl_bsp_cache_map[HLBSP_CACHE_MAX];
I64		 hl_bsp_cache_count = 0;

#define HLSPR_CACHE_MAX	16

U8		 hl_spr_cache_name[HLSPR_CACHE_MAX * HLBSP_NAME_MAX];
CHLSpr	*hl_spr_cache_spr[HLSPR_CACHE_MAX];
I64		 hl_spr_cache_count = 0;

Bool HLBiIsSprName(U8 *name)
{
	I64 n;

	if (!name || name[0] == '*')
		return FALSE;

	n = StrLen(name);
	if (n < 5)
		return FALSE;

	return ToBool(!StrICompare(name + n - 4, ".spr"));
}

CHLSpr *HLBiSprCacheGet(U8 *name)
{//one copy of each sprite, loaded on first request
	I64 i;

	if (!HLBiIsSprName(name))
		return NULL;

	for (i = 0; i < hl_spr_cache_count; i++)
	{
		if (!StrICompare(&hl_spr_cache_name[i * HLBSP_NAME_MAX], name))
			return hl_spr_cache_spr[i];
	}

	if (hl_spr_cache_count >= HLSPR_CACHE_MAX)
		return NULL;

	i = hl_spr_cache_count;
	HLStrCopy(&hl_spr_cache_name[i * HLBSP_NAME_MAX], name, HLBSP_NAME_MAX);
	hl_spr_cache_spr[i] = HLSprLoad(name);
	hl_spr_cache_count++;

	return hl_spr_cache_spr[i];
}

U0 HLBiSprCacheFree()
{
	I64 i;

	for (i = 0; i < hl_spr_cache_count && i < HLSPR_CACHE_MAX; i++)
	{
		if (hl_spr_cache_spr[i])
			HLSprFree(hl_spr_cache_spr[i]);

		hl_spr_cache_spr[i] = NULL;
		hl_spr_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	hl_spr_cache_count = 0;

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_spr[i] = NULL;
}

U0 HLBiBspCacheInit()
{//globals are not zeroed - a stale count sends HLBiBspCacheFree through
 //garbage pointers and faults inside the allocator, not here
	I64 i;

	hl_bsp_cache_count = 0;

	for (i = 0; i < HLBSP_CACHE_MAX; i++)
	{
		hl_bsp_cache_map[i] = NULL;
		hl_bsp_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_bsp[i] = NULL;

	hl_spr_cache_count = 0;
	for (i = 0; i < HLSPR_CACHE_MAX; i++)
	{
		hl_spr_cache_spr[i] = NULL;
		hl_spr_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_spr[i] = NULL;
}

Bool HLBiIsBspName(U8 *name)
{
	I64 n;

	if (!name || name[0] == '*')
		return FALSE;

	n = StrLen(name);
	if (n < 5)
		return FALSE;

	return ToBool(!StrICompare(name + n - 4, ".bsp"));
}

CHLMap *HLBiBspCacheGet(U8 *name)
{//one copy of each external brush model, loaded on first request
	I64 i;

	if (!HLBiIsBspName(name))
		return NULL;

	for (i = 0; i < hl_bsp_cache_count; i++)
	{
		if (!StrICompare(&hl_bsp_cache_name[i * HLBSP_NAME_MAX], name))
			return hl_bsp_cache_map[i];
	}

	if (hl_bsp_cache_count >= HLBSP_CACHE_MAX)
		return NULL;

	i = hl_bsp_cache_count;
	HLStrCopy(&hl_bsp_cache_name[i * HLBSP_NAME_MAX], name, HLBSP_NAME_MAX);
	hl_bsp_cache_map[i] = HLBSPLoad(name);
	hl_bsp_cache_count++;

	return hl_bsp_cache_map[i];
}

U0 HLBiBspCacheFree()
{//released with the map, nothing else may free these
	I64 i;

	for (i = 0; i < hl_bsp_cache_count && i < HLBSP_CACHE_MAX; i++)
	{
		if (hl_bsp_cache_map[i])
			HLBSPFree(hl_bsp_cache_map[i]);

		hl_bsp_cache_map[i] = NULL;
		hl_bsp_cache_name[i * HLBSP_NAME_MAX] = 0;
	}

	hl_bsp_cache_count = 0;

	//these pointed at the maps released above
	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
		hl_precache_bsp[i] = NULL;
}

I64 HLBiPrecacheModel(U8 *name)
{//index 0 is "no model", real entries start at 1
	I64 i;

	for (i = 1; i < hl_precache_model_count; i++)
	{
		if (!StrCompare(hl_precache_model[i], name))
			return i;
	}

	if (hl_precache_model_count >= HLBI_MAX_PRECACHE)
		return 0;

	if (!hl_precache_model_count)
	{
		//slot 0 is "no model" - set empty explicitly, globals are not zeroed
		hl_precache_model[0] = NULL;
		hl_precache_mdl[0]   = NULL;
		hl_precache_model_count = 1;
	}

	i = hl_precache_model_count;
	hl_precache_model_count++;

	hl_precache_model[i] = name;
	hl_precache_mdl[i]   = NULL;

	//"*N" brush models live in the map, only alias models load here
	if (name[0] != '*' && StrLen(name) > 4 &&
		!StrICompare(name + StrLen(name) - 4, ".mdl"))
		hl_precache_mdl[i] = HLMdlCacheGet(name);

	//an external .bsp is a brush model in its own file, a .spr is a sprite
	hl_precache_bsp[i] = HLBiBspCacheGet(name);
	hl_precache_spr[i] = HLBiSprCacheGet(name);

	//collision needs the translation: .modelindex is this slot, not the BSP
	//model number
	if (name[0] == '*' && i < HLCLIP_MAX_PRECACHE)
		hl_precache_bmodel[i] = ToI64(HLAtoF(name + 1));

	return i;
}

CHLMdl *HLBiFindModel(U8 *name)
{//an already-precached alias model. the view-model renderer learns the
 //weapon's name from QuakeC rather than loading it itself.
	I64 i;

	if (!name || !name[0])
		return NULL;

	for (i = 1; i < hl_precache_model_count; i++)
	{
		if (hl_precache_model[i] && !StrICompare(hl_precache_model[i], name))
			return hl_precache_mdl[i];
	}

	return NULL;
}

//--- static entities -------------------------------------------------------
//
// makestatic() hands an entity that will never move, think or be touched to
// the client permanently, then frees the edict - that is the point, a large
// map does not burn hundreds of slots on scenery.

#define HLBI_MAX_STATIC	256

class CHLStaticEnt
{
	CHLMdl	*mdl;
	F64		 origin[3];
	F64		 angles[3];
	I64		 frame;
};

CHLStaticEnt	hl_static_ent[HLBI_MAX_STATIC];
I64			hl_static_count = 0;

U0 HLBiStaticClear()
{
	hl_static_count = 0;
}

#define HLMSG_BROADCAST	0
#define HLMSG_ONE		1
#define HLMSG_ALL		2
#define HLMSG_INIT		3

CHLMsg *HLBiWriteDest()
{//WriteDest: arg 0 of every Write* names the destination. MSG_ONE reads
 //msg_entity, which QuakeC assigns before writing.
	I64 dest;
	I64 entnum;

	dest = ToI64(HLBiArgF(0));

	switch (dest)
	{
		case HLMSG_BROADCAST:
			return &hl_sv_datagram;

		case HLMSG_ONE:
			if (hl_ofs_msg_entity < 0)
				return NULL;
			entnum = HLPrGetI(hl_ofs_msg_entity);
			entnum = HLPrEdictNum(entnum);
			if (entnum < 1 || entnum > HLSV_MAX_CLIENTS)
				return NULL;	//WriteDest: not a client
			return &hl_sv_client_msg[entnum - 1];

		case HLMSG_ALL:
			return &hl_sv_reliable_datagram;

		case HLMSG_INIT:
			return &hl_sv_signon;
	}

	return NULL;
}

Bool HLBiWireRoom(CHLMsg *m, I64 need)
{//sv.datagram is capped at the unreliable size; reliable buffers run to
 //MAX_MSGLEN because they are chunked on the way out
	I64 cap;

	if (!m)
		return FALSE;

	if (m == &hl_sv_datagram)
		cap = HLNET_MAX_DATAGRAM;
	else
		cap = HLNET_MAX_MSG;

	return ToBool(m->len < cap - need);
}

U0 HLBiWireByte(CHLMsg *m, I64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteByte(m, value);
}

U0 HLBiWireChar(CHLMsg *m, I64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteChar(m, value);
}

U0 HLBiWireCoord(CHLMsg *m, F64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteCoord(m, value);
}

U0 HLBiWireShort(CHLMsg *m, I64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteShort(m, value);
}

U0 HLBiWireLong(CHLMsg *m, I64 value)
{
	if (!HLBiWireRoom(m, 8))
		return;
	HLMsgWriteLong(m, value);
}

U0 HLBiWireAngle(CHLMsg *m, F64 value)
{
	if (!HLBiWireRoom(m, 4))
		return;
	HLMsgWriteAngle(m, value);
}

U0 HLBiWireString(CHLMsg *m, U8 *str)
{
	if (!HLBiWireRoom(m, 64))
		return;
	HLMsgWriteString(m, str);
}


U0 HLBiParticleWire(F64 *org, F64 *dir, I64 color, I64 count)
{//PF_particle's other half: svc_particle on sv.datagram, or remotes see no
 //blood, sparks or gunshot puffs at all
	I64 j;
	I64 d;

	if (count > 255)
		count = 255;
	if (count < 0)
		count = 0;

	HLBiWireByte(&hl_sv_datagram, HLSVC_PARTICLE);
	for (j = 0; j < 3; j++)
		HLBiWireCoord(&hl_sv_datagram, org[j]);

	//direction is a signed byte in 1/16ths, so it clamps hard
	for (j = 0; j < 3; j++)
	{
		d = ToI64(dir[j] * 16.0);
		if (d > 127)
			d = 127;
		if (d < -128)
			d = -128;
		HLBiWireByte(&hl_sv_datagram, d & 255);
	}

	//SV_StartParticle writes count then colour. reversed, this parser agrees
	//with itself, but any other client reads the colour as a count and the
	//count as a colour - blood renders grey in ironwail
	HLBiWireByte(&hl_sv_datagram, count);
	HLBiWireByte(&hl_sv_datagram, color);
}

CHLMsg *HLBiClientMsg(I64 ent)
{//reliable channel for a client edict, NULL for the local one. edicts
 //1..maxclients are reserved per slot, so the slot is ent - 1.
	I64 slot;

	if (ent <= 0 || ent == hl_player_edict)
		return NULL;

	slot = ent - 1;
	if (slot < 0 || slot >= HLSV_MAX_CLIENTS)
		return NULL;

	return &hl_sv_client_msg[slot];
}

U0 HLBiMakeStatic()
{//builtin 69
	CHLStaticEnt	*se;
	I64			 ent = HLBiArgEnt(0);
	I64			 idx;
	I64			 j;

	if (ent <= 0)
		return;

	if (hl_static_count < HLBI_MAX_STATIC)
	{
		se  = &hl_static_ent[hl_static_count];
		idx = ToI64(HLPrFieldF(ent, hl_fld_modelindex));

		se->mdl = NULL;
		if (idx > 0 && idx < hl_precache_model_count)
			se->mdl = hl_precache_mdl[idx];

		for (j = 0; j < 3; j++)
		{
			se->origin[j] = HLPrFieldF(ent, hl_fld_origin + j);
			se->angles[j] = HLPrFieldF(ent, hl_fld_angles + j);
		}

		se->frame = ToI64(HLPrFieldF(ent, hl_fld_frame));

		//a static entity with no model would hold a slot for nothing
		if (se->mdl)
			hl_static_count++;
	}

	//svc_spawnstatic into sv.signon so a joining client hears about the
	//torches during prespawn. never sent again - no edict to update.
	idx = ToI64(HLPrFieldF(ent, hl_fld_modelindex));
	if (idx > 0)
	{
		HLBiWireByte(&hl_sv_signon, HLSVC_SPAWNSTATIC);
		HLBiWireByte(&hl_sv_signon, idx);
		HLBiWireByte(&hl_sv_signon, ToI64(HLPrFieldF(ent, hl_fld_frame)));

		if (hl_fld_colormap >= 0)
			HLBiWireByte(&hl_sv_signon,
				ToI64(HLPrFieldF(ent, hl_fld_colormap)));
		else
			HLBiWireByte(&hl_sv_signon, 0);

		if (hl_fld_skin >= 0)
			HLBiWireByte(&hl_sv_signon, ToI64(HLPrFieldF(ent, hl_fld_skin)));
		else
			HLBiWireByte(&hl_sv_signon, 0);

		for (j = 0; j < 3; j++)
		{
			HLBiWireCoord(&hl_sv_signon, HLPrFieldF(ent, hl_fld_origin + j));
			HLBiWireAngle(&hl_sv_signon, HLPrFieldF(ent, hl_fld_angles + j));
		}
	}

	//freed either way, that is what makestatic means
	HLPrFreeEdict(ent);
}

U0 HLBiFreePrecache()
{
	//the brush-model translation table is per-map too
	HLClipPrecacheReset;

	I64 i;

	for (i = 0; i < hl_precache_model_count; i++)
	{
		if (hl_precache_mdl[i])
		{
			//the cache owns these, freeing here would double free
			hl_precache_mdl[i] = NULL;
		}
	}

	hl_precache_model_count = 0;
	hl_precache_sound_count = 0;
}

U0 HLBiSetMinMaxSize(I64 ent, F64 *mins, F64 *maxs)
{//SetMinMaxSize, which ends with SV_LinkEdict
 //
 //the link is not optional - absmin/absmax are derived there and FireBullets
 //takes its muzzle height straight from them:
 //
 //    src_z = self.absmin_z + self.size_z * 0.7;
	F64 size[3];

	HLBiSetFieldV(ent, hl_fld_mins, mins);
	HLBiSetFieldV(ent, hl_fld_maxs, maxs);
	HLVecSub(maxs, mins, size);
	HLBiSetFieldV(ent, hl_fld_size, size);

	HLGameLinkEdict(ent);
}

F64 HLSvFlagF(Bool b)
{//widen a Bool to the 1.0/0.0 QuakeC tests against
	if (b)
		return 1.0;
	return 0.0;
}

U0 HLBiStoreTrace(CHLTrace *tr, I64 hit_ent)
{//publish a trace into the globals QuakeC reads afterwards
	HLPrSetF(hl_ofs_trace_allsolid, ToF64(tr->all_solid));
	HLPrSetF(hl_ofs_trace_startsolid, ToF64(tr->start_solid));
	HLPrSetF(hl_ofs_trace_fraction, tr->fraction);
	HLPrSetV(hl_ofs_trace_endpos, tr->end_pos);
	HLPrSetV(hl_ofs_trace_plane_normal, tr->plane_normal);
	HLPrSetF(hl_ofs_trace_plane_dist, tr->plane_dist);
	HLPrSetI(hl_ofs_trace_ent, HLPrEdictValue(hit_ent));
	//visible() rejects a sight line that crossed both - this is what stops a
	//monster tracking the player through the surface of a pool
	HLPrSetF(hl_ofs_trace_inopen, HLSvFlagF(tr->in_open));
	HLPrSetF(hl_ofs_trace_inwater, HLSvFlagF(tr->in_water));
}

//--- temp entities ---------------------------------------------------------
//
// effects are broadcast, not spawned: QuakeC writes SVC_TEMPENTITY, a type,
// then coordinates. reassembled here and handed to the particle system.

#define HLSVC_TEMPENTITY		23
#define HLSVC_INTERMISSION	30
#define HLSVC_FINALE			31
#define HLSVC_CUTSCENE		34

//--- intermission and finale -----------------------------------------------
//
// QuakeC broadcasts svc_intermission, or svc_finale plus the episode text.
// it has already parked the camera on an info_intermission, so the engine
// owes only the overlay - IntermissionThink watches button0 for the exit.
Bool hl_intermission	= FALSE;

//cl.completed_time - the clock stops when the intermission starts
F64	 hl_completed_time	= 0.0;
Bool hl_finale		= FALSE;
//SCR_CenterPrint's buffer is 1024. the longest string sent is the episode
//finale at 265 chars; match the original rather than the observed maximum.
#define HLCENTER_MAX	1024

U8	 hl_finale_text[HLCENTER_MAX];

U0 HLBiIntermissionClear()
{
	hl_intermission   = FALSE;
	hl_finale         = FALSE;
	hl_completed_time = 0.0;
	hl_finale_text[0] = 0;
}

#define HLTE_SPIKE			0
#define HLTE_SUPERSPIKE		1
#define HLTE_GUNSHOT			2
#define HLTE_EXPLOSION		3
#define HLTE_TAREXPLOSION	4
#define HLTE_LIGHTNING1		5
#define HLTE_LIGHTNING2		6
#define HLTE_WIZSPIKE		7
#define HLTE_KNIGHTSPIKE		8
#define HLTE_LIGHTNING3		9
#define HLTE_LAVASPLASH		10
#define HLTE_TELEPORT		11
#define HLTE_EXPLOSION2		12
#define HLTE_BEAM			13

#define HLMSG_IDLE			0
#define HLMSG_WANT_TYPE		1
#define HLMSG_WANT_COORDS	2
#define HLMSG_WANT_BEAM_ENT	3

I64 hl_msg_beam_ent = 0;	//owner of the beam being reassembled
#define HLMSG_WANT_BEAM		4
#define HLMSG_WANT_TEXT		5

//beams are self-illuminated in the original
#define HLBEAM_LIGHT			240

//movement diagnostics. failures dominating means the step geometry refuses
//legal moves; successes dominating means the steering choice is wrong.
I64 hl_move_ok	= 0;
I64 hl_move_fail	= 0;
I64 hl_yaw_reports = 0;
U8  hl_yaw_line[128];

//FL_ONGROUND - the move step sets it directly and physics keys gravity off it
#define HLFL_ONGROUND_MOVE	512
#define HLFL_SWIM_			2		//defs.qc: FL_SWIM
#define HLFL_FLY_			1		//defs.qc: FL_FLY

//solidity values, duplicated from the game layer - this file compiles first
//and traceline needs them
#define HLBI_SOLID_NOT		0
#define HLBI_SOLID_TRIGGER	1
#define HLBI_SOLID_BBOX		2
#define HLBI_SOLID_SLIDEBOX	3
#define HLBI_SOLID_BSP		4

I64 hl_msg_state	= HLMSG_IDLE;
I64 hl_msg_type	= 0;
I64 hl_msg_axis	= 0;
F64 hl_msg_org[3];
F64 hl_msg_end[3];
I64 hl_te_count	= 0;

U0 HLBiRicochet(F64 *org)
{//CL_ParseTEnt's impact sound - rand()%5 means the tink wins four in five
	I64 r;

	if (HLPartRandI(5))
	{
		HLSndPlayAt("weapons/tink1.wav", org, 1.0, 1.0);
		return;
	}

	r = HLPartRandI(4);

	if (r == 1)
		HLSndPlayAt("weapons/ric1.wav", org, 1.0, 1.0);
	else if (r == 2)
		HLSndPlayAt("weapons/ric2.wav", org, 1.0, 1.0);
	else
		HLSndPlayAt("weapons/ric3.wav", org, 1.0, 1.0);
}

U0 HLBiTempEntity(I64 type, F64 *org)
{//a decoded temp entity into particles and sound
 //
 //the sounds are not decoration - QuakeC never plays them. GrenadeExplode
 //writes TE_EXPLOSION and nothing else; CL_ParseTEnt turns that into
 //weapons/r_exp3.wav, and CL_InitTEnts is what precaches it.
	F64 zero[3];

	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_te_count++;

	switch (type)
	{
		case HLTE_EXPLOSION:
		case HLTE_TAREXPLOSION:
			HLPartExplosion(org, tS);
			//the flash that lights the room, the original's figures
			HLDlightAdd(org, 350.0, 0.5, 300.0, tS);
			HLSndPlayAt("weapons/r_exp3.wav", org, 1.0, 1.0);
			break;

		case HLTE_GUNSHOT:
			//colour 0 is the dark-to-grey ramp. no sound, the weapon made one.
			HLPartEffect(org, zero, 0, 20, tS);
			break;

		case HLTE_SPIKE:
			HLPartEffect(org, zero, 0, 10, tS);
			HLBiRicochet(org);
			break;

		case HLTE_SUPERSPIKE:
			HLPartEffect(org, zero, 0, 20, tS);
			HLBiRicochet(org);
			break;

		//own colours, not the nail's: 20 is the Scrag's green ramp, 226 the
		//Death Knight's orange
		case HLTE_WIZSPIKE:
			HLPartEffect(org, zero, 20, 30, tS);
			HLSndPlayAt("wizard/hit.wav", org, 1.0, 1.0);
			break;

		case HLTE_KNIGHTSPIKE:
			HLPartEffect(org, zero, 226, 20, tS);
			HLSndPlayAt("hknight/hit.wav", org, 1.0, 1.0);
			break;

		case HLTE_LAVASPLASH:
			HLPartLavaSplash(org, tS);
			break;

		case HLTE_TELEPORT:
			HLPartTeleport(org, tS);
			break;

		default:
			//the lightning types need a line renderer, not particles
			break;
	}
}

//--- lightning beams -------------------------------------------------------
//
// TE_LIGHTNING1/2/3 carry an entity index and two points where every other
// temp entity carries one - six coordinates into a three-coordinate parser
// corrupt the following effect too.
//
// the original tiles the bolt model along the vector every 30 units, random
// roll per segment so it crackles.

#define HLBI_MAX_BEAMS	16
#define HLBEAM_SEGMENT	30.0
#define HLBEAM_LIFE		0.2		//seconds, matching the original

class CHLBeam
{
	F64		 start[3];
	F64		 end[3];
	F64		 die_time;
	I64		 entity;		//owner; a beam from the view entity follows it
	CHLMdl	*mdl;
};

CHLBeam	hl_beam[HLBI_MAX_BEAMS];
I64		hl_beam_count = 0;

U0 HLBiBeamsClear()
{
	hl_beam_count = 0;
}

U0 HLBiBeamAdd(I64 type, F64 *start, F64 *end, F64 time, I64 entity = 0)
{//beams are short lived, so the oldest is recycled when full
 //
 //CL_ParseBeam replaces an existing beam from the same entity rather than
 //stacking, which keeps a firing lightning gun to a single bolt
	CHLBeam	*b;
	U8		*name;
	I64		 i;
	I64		 slot = -1;

	if (type == HLTE_LIGHTNING1)
		name = "progs/bolt.mdl";
	else if (type == HLTE_LIGHTNING2)
		name = "progs/bolt2.mdl";
	else
		name = "progs/bolt3.mdl";

	//an entity that already has a beam gets it replaced
	if (entity)
	{
		for (i = 0; i < hl_beam_count; i++)
		{
			if (hl_beam[i].entity == entity)
			{
				slot = i;
				break;
			}
		}
	}

	//otherwise prefer an expired slot
	if (slot < 0)
	{
		for (i = 0; i < hl_beam_count; i++)
		{
			if (hl_beam[i].die_time <= time)
			{
				slot = i;
				break;
			}
		}
	}

	if (slot < 0)
	{
		if (hl_beam_count < HLBI_MAX_BEAMS)
		{
			slot = hl_beam_count;
			hl_beam_count++;
		}
		else
			slot = 0;
	}

	b = &hl_beam[slot];
	HLVecCopy(start, b->start);
	HLVecCopy(end, b->end);
	b->die_time = time + HLBEAM_LIFE;
	b->entity   = entity;
	b->mdl      = HLBiFindModel(name);
}

U0 HLBiBeamsFollow(I64 view_entity)
{//CL_UpdateTEnts: snap a view-entity beam's START to the current origin every
 //frame, or the bolt hangs where it was fired from
	I64 i;
	I64 j;

	if (view_entity <= 0)
		return;

	for (i = 0; i < hl_beam_count; i++)
	{
		if (hl_beam[i].entity != view_entity)
			goto qbf_next;

		for (j = 0; j < 3; j++)
			hl_beam[i].start[j] = HLPrFieldF(view_entity, hl_fld_origin + j);

qbf_next:
	}
}

U0 HLBiDrawBeams(CHLCanvas *c, F64 time)
{//tile each live beam's model along its length
	CHLBeam	*b;
	F64		 dir[3];
	F64		 org[3];
	F64		 ang[3];
	F64		 len;
	I64		 i;
	I64		 seg;
	I64		 steps;

	for (i = 0; i < hl_beam_count; i++)
	{
		b = &hl_beam[i];

		if (b->die_time <= time || !b->mdl)
			goto qb_next;

		HLVecSub(b->end, b->start, dir);
		len = HLVecLength(dir);

		if (len < 1.0)
			goto qb_next;

		HLVecScale(dir, 1.0 / len, dir);

		//pitch and yaw point down the beam; the roll is random so segments
		//do not line up into a smooth tube
		HLVecToAngles(dir, ang);

		steps = ToI64(len / HLBEAM_SEGMENT) + 1;
		HLVecCopy(b->start, org);

		for (seg = 0; seg < steps; seg++)
		{
			ang[2] = ToF64(RandU32() % 360);

			HLMdlDrawAngles(c, b->mdl, 0, org, ang, HLBEAM_LIGHT);

			org[0] += dir[0] * HLBEAM_SEGMENT;
			org[1] += dir[1] * HLBEAM_SEGMENT;
			org[2] += dir[2] * HLBEAM_SEGMENT;
		}

qb_next:
	}
}

//--- centerprint -----------------------------------------------------------
//
// "you need the silver key", the skill signs in start.bsp. SUB_UseTargets
// calls this then plays misc/talk.wav.
//
// dismissal is time based - scr_centertime, 2.0s, counted down in
// SCR_CheckDrawCenterString. no key or click clears it.
//
// a message that never goes away is being re-sent, not stuck - a
// trigger_multiple re-fires every .wait seconds while something stands in it.
#define HLCENTER_TIME	2.0

U8  hl_center_text[HLCENTER_MAX];
F64 hl_center_until	= 0.0;
F64 hl_center_start	= 0.0;	//when the string was posted - the typing origin

//--- localcmd ---------------------------------------------------------------
//
// QuakeC pushes console commands at the engine here, and single-player death
// depends on it:
//
//     void() respawn = { ... localcmd ("restart\n"); };
//
// a no-op stalls the whole death cycle. only the commands QuakeC issues are
// honoured; anything else is reported once rather than dropped silently.
Bool hl_restart_pending	= FALSE;
I64  hl_localcmd_reports	= 0;

U0 HLBiLocalCmd(U8 *cmd)
{
	if (!cmd || !cmd[0])
		return;

	//restart reloads the map: same level, fresh start, no carried items
	if (!StrNICompare(cmd, "restart", 7))
	{
		hl_restart_pending = TRUE;
		return;
	}

	//level exit goes through the changelevel builtin, not here
	if (hl_localcmd_reports < 8)
	{
		hl_localcmd_reports++;
		"HLBi: unhandled localcmd '%s'\n", cmd;
	}
}

U0 HLBiCenterClear()
{
	hl_center_text[0] = 0;
	hl_center_until   = 0.0;
	hl_center_start   = 0.0;
}

U0 HLBiCenterPrint(I64 ent, U8 *str)
{//PF_centerprint - arg 0 names the client, ignoring it puts a remote's
 //objective message on the host's screen
	CHLMsg *m;

	if (!str || !str[0])
		return;

	m = HLBiClientMsg(ent);
	if (m)
	{
		HLBiWireByte(m, HLSVC_CENTERPRINT);
		HLBiWireString(m, str);
		return;
	}

	HLStrCopy(hl_center_text, str, HLCENTER_MAX);
	hl_center_until = tS + HLCENTER_TIME;
	hl_center_start = tS;
}

//--- checkclient ------------------------------------------------------------
//
//PF_checkclient. monsters ask this whether a player is worth noticing - both
//the round-robin and the PVS test matter, a fixed edict makes the whole level
//hunt one body.

//MAX_MAP_LEAFS is 8192 in BSP29, so a PVS row never exceeds 1024 bytes
#define HLBI_MAX_LEAFS	8192
#define HLBI_PVS_BYTES	(HLBI_MAX_LEAFS / 8)
#define HLBI_FL_NOTARGET	128

U8	 hl_checkpvs[HLBI_PVS_BYTES];
I64	 hl_sv_lastcheck		= 1;
F64	 hl_sv_lastchecktime	= 0.0;

U0 HLBiCheckClientReset()
{//SV_SpawnServer clears these with the sv struct; here they are globals and
 //globals are not zeroed - a garbage lastchecktime never passes the 0.1s test
 //and checkclient hands every monster the world
	hl_sv_lastcheck     = 1;
	hl_sv_lastchecktime = 0.0;

	MemSet(hl_checkpvs, 0, HLBI_PVS_BYTES);
}

I64 HLBiNewCheckClient(I64 check)
{//PF_newcheckclient: step to the next live client and cache its PVS row
	I64 i;
	I64 leaf;
	F64 org[3];
	F64 ofs[3];

	if (check < 1)
		check = 1;
	if (check > HLSV_MAX_CLIENTS)
		check = HLSV_MAX_CLIENTS;

	if (check == HLSV_MAX_CLIENTS)
		i = 1;
	else
		i = check + 1;

	while (TRUE)
	{
		if (i == HLSV_MAX_CLIENTS + 1)
			i = 1;

		if (i == check)
			break;			//nothing else to look at

		if (!hl_pr_edict_free[i] && HLPrFieldF(i, hl_fld_health) > 0.0)
		{
			if (hl_fld_flags < 0 ||
				!(ToI64(HLPrFieldF(i, hl_fld_flags)) & HLBI_FL_NOTARGET))
				break;
		}

		i++;
	}

	//PVS from the client's eyes, not its feet
	HLBiGetFieldV(i, hl_fld_origin, org);
	if (hl_fld_view_ofs >= 0)
	{
		HLBiGetFieldV(i, hl_fld_view_ofs, ofs);
		org[0] += ofs[0];
		org[1] += ofs[1];
		org[2] += ofs[2];
	}

	leaf = -1;
	if (hl_bi_map)
		leaf = HLVisLeafForPoint(hl_bi_map, org);

	if (leaf >= 0 && leaf < hl_bi_map->num_leafs)
		HLVisDecompress(hl_bi_map, hl_bi_map->leafs[leaf].vis_offset,
			hl_checkpvs, HLBI_PVS_BYTES);
	else
		MemSet(hl_checkpvs, 0xFF, HLBI_PVS_BYTES);

	return i;
}

U0 HLBiCheckClient()
{
	I64 ent;
	I64 self;
	I64 leaf;
	I64 l;
	F64 view[3];
	F64 ofs[3];
	F64 now;

	if (hl_ofs_self < 0 || hl_fld_health < 0 || !hl_pr_edict_free)
	{
		HLBiRetEnt(0);
		return;
	}

	now = HLPrGetF(hl_ofs_time);

	//one new pick per 0.1s, shared by every monster asking this frame
	if (now - hl_sv_lastchecktime >= 0.1)
	{
		hl_sv_lastcheck     = HLBiNewCheckClient(hl_sv_lastcheck);
		hl_sv_lastchecktime = now;
	}

	ent = hl_sv_lastcheck;

	//never index the free list out of range
	if (ent < 1 || ent >= hl_pr_num_edicts)
	{
		hl_sv_lastcheck = 1;
		ent            = 1;
	}

	if (hl_pr_edict_free[ent] || HLPrFieldF(ent, hl_fld_health) <= 0.0)
	{
		HLBiRetEnt(hl_player_edict);
		return;
	}

	self = HLPrEdictNum(HLPrGetI(hl_ofs_self));
	HLBiGetFieldV(self, hl_fld_origin, view);
	if (hl_fld_view_ofs >= 0)
	{
		HLBiGetFieldV(self, hl_fld_view_ofs, ofs);
		view[0] += ofs[0];
		view[1] += ofs[1];
		view[2] += ofs[2];
	}

	//leaf 0 is the solid leaf, so PVS bit 0 is leaf 1
	l = -1;
	if (hl_bi_map)
	{
		leaf = HLVisLeafForPoint(hl_bi_map, view);
		if (leaf >= 0 && leaf < hl_bi_map->num_leafs)
			l = leaf - 1;
	}

	if (l < 0 || l >= HLBI_MAX_LEAFS ||
		!(hl_checkpvs[l >> 3] & (1 << (l & 7))))
	{
		HLBiRetEnt(0);		//world: cannot possibly see the check entity
		return;
	}

	HLBiRetEnt(ent);
}

I64 HLBiSoundIndex(U8 *sample)
{//1-based index into the sound precache (wire: byte sound_num), 0 = miss
	I64 i;

	if (!sample || !sample[0])
		return 0;

	for (i = 0; i < hl_precache_sound_count; i++)
	{
		if (hl_precache_sound[i] && !StrCompare(hl_precache_sound[i], sample))
			return i + 1;
	}

	return 0;
}

U0 HLBiAmbientSignon(F64 *pos, U8 *sample, F64 vol, F64 attenuation)
{//PF_ambientsound's other half: svc_spawnstaticsound into sv.signon, so a
 //joining client starts the same water and torch loops
	I64 num;
	I64 j;

	num = HLBiSoundIndex(sample);
	if (num < 1)
		return;

	HLBiWireByte(&hl_sv_signon, HLSVC_SPAWNSTATICSOUND);
	for (j = 0; j < 3; j++)
		HLBiWireCoord(&hl_sv_signon, pos[j]);
	HLBiWireByte(&hl_sv_signon, num);
	HLBiWireByte(&hl_sv_signon, ToI64(vol * 255.0));
	HLBiWireByte(&hl_sv_signon, ToI64(attenuation * 64.0));
}

U0 HLSvStartSound(I64 ent, I64 channel, U8 *sample, I64 volume, F64 attenuation)
{//SV_StartSound -> svc_sound on sv.datagram. local play is the caller's job.
	I64 sound_num;
	I64 field_mask;
	I64 packed;
	F64 org[3];
	F64 mins[3];
	F64 maxs[3];
	I64 j;

	if (!sample || !sample[0])
		return;
	if (hl_sv_datagram.len > HLNET_MAX_DATAGRAM - 16)
		return;

	sound_num = HLBiSoundIndex(sample);
	if (sound_num < 1)
		return;

	if (volume < 0)
		volume = 0;
	if (volume > 255)
		volume = 255;
	if (attenuation < 0.0)
		attenuation = 0.0;
	if (attenuation > 4.0)
		attenuation = 4.0;
	if (channel < 0)
		channel = 0;
	if (channel > 7)
		channel = 7;
	if (ent < 0)
		ent = 0;

	packed = (ent << 3) | channel;

	field_mask = 0;
	if (volume != HLSND_DEFAULT_VOL)
		field_mask |= HLSND_VOLUME;
	if (attenuation != HLSND_DEFAULT_ATTEN)
		field_mask |= HLSND_ATTENUATION;

	HLMsgWriteByte(&hl_sv_datagram, HLSVC_SOUND);
	HLMsgWriteByte(&hl_sv_datagram, field_mask);
	if (field_mask & HLSND_VOLUME)
		HLMsgWriteByte(&hl_sv_datagram, volume);
	if (field_mask & HLSND_ATTENUATION)
		HLMsgWriteByte(&hl_sv_datagram, ToI64(attenuation * 64.0));
	HLMsgWriteShort(&hl_sv_datagram, packed);
	HLMsgWriteByte(&hl_sv_datagram, sound_num);

	HLBiGetFieldV(ent, hl_fld_origin, org);
	HLBiGetFieldV(ent, hl_fld_mins, mins);
	HLBiGetFieldV(ent, hl_fld_maxs, maxs);
	for (j = 0; j < 3; j++)
		org[j] += 0.5 * (mins[j] + maxs[j]);

	for (j = 0; j < 3; j++)
		HLMsgWriteCoord(&hl_sv_datagram, org[j]);
}

U0 HLBiWriteByte(CHLMsg *m, I64 value)
{//emit to the routed destination and drive the local reassembler, so the host
 //sees its own temp entities without a round trip
	HLBiWireByte(m, value);

	if (hl_msg_state == HLMSG_IDLE)
	{
		if (value == HLSVC_TEMPENTITY)
			hl_msg_state = HLMSG_WANT_TYPE;
		else if (value == HLSVC_INTERMISSION)
		{
			hl_intermission   = TRUE;
			hl_completed_time = HLPrGetF(hl_ofs_time);
		}
		else if (value == HLSVC_FINALE || value == HLSVC_CUTSCENE)
		{
			//the text arrives as the next WriteString
			hl_intermission   = TRUE;
			hl_finale         = TRUE;
			hl_completed_time = HLPrGetF(hl_ofs_time);
			hl_finale_text[0] = 0;
			hl_msg_state      = HLMSG_WANT_TEXT;
		}
		return;
	}

	if (hl_msg_state == HLMSG_WANT_TYPE)
	{
		hl_msg_type = value;
		hl_msg_axis = 0;

		//a beam carries an entity index then six coordinates, start and end
		if (hl_msg_type == HLTE_LIGHTNING1 || hl_msg_type == HLTE_LIGHTNING2 ||
			hl_msg_type == HLTE_LIGHTNING3)
			hl_msg_state = HLMSG_WANT_BEAM_ENT;
		else
			hl_msg_state = HLMSG_WANT_COORDS;
	}
}

U0 HLBiWriteString(CHLMsg *m, U8 *str)
{//only the finale text is consumed locally, the wire copy always goes out
	HLBiWireString(m, str);

	if (hl_msg_state == HLMSG_WANT_TEXT)
	{
		if (str)
		{
			HLStrCopy(hl_finale_text, str, HLCENTER_MAX);

			//svc_finale is SCR_CenterPrint - centerprint owns wrap and typing
			HLStrCopy(hl_center_text, str, HLCENTER_MAX);
			hl_center_until = tS + HLCENTER_TIME;
			hl_center_start = tS;
		}
		hl_msg_state = HLMSG_IDLE;
	}
}

U0 HLBiWriteEntity(CHLMsg *m, I64 value)
{//the beam's owner. the coordinates that follow are where it was fired, but
 //CL_UpdateTEnts re-anchors a view-entity beam every frame so it tracks.
	HLBiWireShort(m, value);

	if (hl_msg_state == HLMSG_WANT_BEAM_ENT)
	{
		hl_msg_beam_ent = value;
		hl_msg_state    = HLMSG_WANT_BEAM;
	}
}

U0 HLBiWriteCoord(CHLMsg *m, F64 value)
{
	HLBiWireCoord(m, value);

	if (hl_msg_state == HLMSG_WANT_BEAM)
	{
		//six coordinates: start then end
		if (hl_msg_axis < 3)
			hl_msg_org[hl_msg_axis] = value;
		else if (hl_msg_axis < 6)
			hl_msg_end[hl_msg_axis - 3] = value;

		hl_msg_axis++;

		if (hl_msg_axis >= 6)
		{
			HLBiBeamAdd(hl_msg_type, hl_msg_org, hl_msg_end, tS,
				hl_msg_beam_ent);
			hl_msg_state = HLMSG_IDLE;
		}

		return;
	}

	if (hl_msg_state != HLMSG_WANT_COORDS)
		return;

	if (hl_msg_axis < 3)
	{
		hl_msg_org[hl_msg_axis] = value;
		hl_msg_axis++;
	}

	if (hl_msg_axis >= 3)
	{
		HLBiTempEntity(hl_msg_type, hl_msg_org);
		hl_msg_state = HLMSG_IDLE;
	}
}

//--- individual builtins ---------------------------------------------------

U0 HLBiMakeVectors()
{
	F64 angles[3];
	F64 forward[3];
	F64 right[3];
	F64 up[3];

	HLBiArgV(0, angles);
	HLAngleVectors(angles, forward, right, up);

	HLPrSetV(hl_ofs_v_forward, forward);
	HLPrSetV(hl_ofs_v_right, right);
	HLPrSetV(hl_ofs_v_up, up);
}

U0 HLBiSetOrigin()
{
	I64 ent = HLBiArgEnt(0);
	F64 org[3];

	HLBiArgV(1, org);
	HLBiSetFieldV(ent, hl_fld_origin, org);
}

U0 HLBiSetModel()
{
	I64 ent  = HLBiArgEnt(0);
	U8 *name = HLBiArgS(1);
	I64 idx  = HLBiPrecacheModel(name);
	I64 bm;
	F64 mins[3];
	F64 maxs[3];

	HLPrSetFieldI(ent, hl_fld_model, HLPrGetI(HLBiArg(1)));
	HLPrSetFieldF(ent, hl_fld_modelindex, ToF64(idx));

	//an external .bsp carries its bounds in its worldmodel entry - without
	//them the entity keeps a zero box and droptofloor fails
	if (idx > 0 && idx < HLBI_MAX_PRECACHE && hl_precache_bsp[idx])
	{
		HLVecCopy(hl_precache_bsp[idx]->models[0].mins, mins);
		HLVecCopy(hl_precache_bsp[idx]->models[0].maxs, maxs);
		HLBiSetMinMaxSize(ent, mins, maxs);
		return;
	}

	//a brush model takes its bounds straight from the BSP
	if (name[0] == '*' && hl_bi_map)
	{
		bm = ToI64(HLAtoF(name + 1));
		if (0 <= bm < hl_bi_map->num_models)
		{
			HLVecCopy(hl_bi_map->models[bm].mins, mins);
			HLVecCopy(hl_bi_map->models[bm].maxs, maxs);
			HLBiSetMinMaxSize(ent, mins, maxs);
		}
	}
}

U0 HLBiSetSize()
{
	I64 ent = HLBiArgEnt(0);
	F64 mins[3];
	F64 maxs[3];

	HLBiArgV(1, mins);
	HLBiArgV(2, maxs);
	HLBiSetMinMaxSize(ent, mins, maxs);
}

U0 HLBiTraceEnt(I64 ent, F64 *start, F64 *end, CHLTrace *tr)
{//SV_Move with the mover's own mins/maxs - what droptofloor, movestep and the
 //AI floor check all use. world-only tracing makes brush entities invisible
 //to the AI: monsters walk through closed doors and plats are not floor.
	F64 mins[3];
	F64 maxs[3];
	I64 j;

	for (j = 0; j < 3; j++)
	{
		mins[j] = HLPrFieldF(ent, hl_fld_mins + j);
		maxs[j] = HLPrFieldF(ent, hl_fld_maxs + j);
	}

	HLTraceEntity(hl_bi_map, start, end, mins, maxs, ent, FALSE, tr);
}

U0 HLBiTraceLine()
{//traceline(v1, v2, nomonsters, ignore). PF_traceline is
 //
 //    SV_Move (v1, vec3_origin, vec3_origin, v2, nomonsters, ent)
 //
 //world and every solid entity, with a zero-sized box - a point trace through
 //hull 0. hull 1 reports the world 16 units early in every direction.
	CHLTrace	tr;
	F64		v1[3];
	F64		v2[3];
	F64		zero[3];
	I64		ignore;
	Bool	nomonsters;

	HLBiArgV(0, v1);
	HLBiArgV(1, v2);
	nomonsters = ToBool(HLBiArgF(2) != 0.0);
	ignore     = HLBiArgEnt(3);

	HLVecSet(zero, 0.0, 0.0, 0.0);

	if (!hl_bi_map)
	{
		//no map: a clean miss, don't leave the trace globals stale
		HLTraceInit(&tr, v2);
		tr.all_solid = FALSE;
		HLBiStoreTrace(&tr, 0);
		return;
	}

	HLTraceEntity(hl_bi_map, v1, v2, zero, zero, ignore, nomonsters, &tr);

	//trace_ent is what was struck, or the world
	if (tr.ent > 0)
		HLBiStoreTrace(&tr, tr.ent);
	else
		HLBiStoreTrace(&tr, 0);
}

U0 HLBiPointContents()
{
	F64 p[3];
	I64 c = HLCONTENTS_EMPTY;

	HLBiArgV(0, p);

	if (hl_bi_map)
		c = HLHullPointContents(hl_bi_map, hl_bi_map->models[0].head_node[1], p);

	HLBiRetF(ToF64(c));
}

U0 HLBiDropToFloor()
{//drop up to 256 units, report whether it landed
	I64		ent = HLPrEdictNum(HLPrGetI(hl_ofs_self));
	CHLTrace	tr;
	F64		start[3];
	F64		end[3];

	HLBiGetFieldV(ent, hl_fld_origin, start);
	HLVecCopy(start, end);
	end[2] -= 256.0;

	if (!hl_bi_map)
	{
		HLBiRetF(0.0);
		return;
	}

	HLBiTraceEnt(ent, start, end, &tr);

	if (tr.fraction == 1.0 || tr.all_solid)
		HLBiRetF(0.0);
	else
	{
		HLBiSetFieldV(ent, hl_fld_origin, tr.end_pos);

		//SV_LinkEdict after the move, or absmin/absmax still describe where
		//the item was before it dropped
		HLGameLinkEdict(ent);

		//PF_droptofloor marks it as resting on what it hit - SUB_regen and
		//the AI floor checks read these back
		if (hl_fld_flags >= 0)
			HLPrSetFieldF(ent, hl_fld_flags,
				ToF64(ToI64(HLPrFieldF(ent, hl_fld_flags)) | HLFL_ONGROUND_MOVE));

		if (hl_fld_groundentity >= 0 && tr.ent >= 0)
			HLPrSetFieldI(ent, hl_fld_groundentity, HLPrEdictValue(tr.ent));

		HLBiRetF(1.0);
	}
}

Bool HLBiCheckBottomEnt(I64 ent)
{//SV_CheckBottom: real floor under the whole box. stops a monster walking off
 //a ledge, and into deep water - water is not solid, so the corner test falls
 //through to the trace, which finds no floor.
	CHLTrace	tr;
	F64		org[3];
	F64		mins[3];
	F64		maxs[3];
	F64		zero[3];
	F64		start[3];
	F64		stop[3];
	F64		mid;
	F64		bottom;
	I64		x;
	I64		y;
	I64		j;

	if (!hl_bi_map)
		return TRUE;

	HLBiGetFieldV(ent, hl_fld_origin, org);
	HLBiGetFieldV(ent, hl_fld_mins, mins);
	HLBiGetFieldV(ent, hl_fld_maxs, maxs);

	for (j = 0; j < 3; j++)
	{
		mins[j] += org[j];
		maxs[j] += org[j];
	}

	HLVecSet(zero, 0.0, 0.0, 0.0);

	//fast out: solid world under all four corners
	start[2] = mins[2] - 1.0;
	for (x = 0; x <= 1; x++)
	{
		for (y = 0; y <= 1; y++)
		{
			if (x)	start[0] = maxs[0];
			else	start[0] = mins[0];
			if (y)	start[1] = maxs[1];
			else	start[1] = mins[1];

			if (HLHullPointContents(hl_bi_map,
					hl_bi_map->models[0].head_node[1], start) !=
				HLCONTENTS_SOLID)
				goto qcb_real;
		}
	}

	return TRUE;

qcb_real:
	//the midpoint must find floor within two step heights
	start[2] = mins[2];
	start[0] = (mins[0] + maxs[0]) * 0.5;
	start[1] = (mins[1] + maxs[1]) * 0.5;
	HLVecCopy(start, stop);
	stop[2] = start[2] - HLPHYS_STEPSIZE * 2.0;

	HLTraceEntity(hl_bi_map, start, stop, zero, zero, ent, TRUE, &tr);

	if (tr.fraction == 1.0)
		return FALSE;

	mid    = tr.end_pos[2];
	bottom = mid;

	//and every corner within one step of that midpoint, or it's overhanging
	for (x = 0; x <= 1; x++)
	{
		for (y = 0; y <= 1; y++)
		{
			if (x)	start[0] = maxs[0];
			else	start[0] = mins[0];
			if (y)	start[1] = maxs[1];
			else	start[1] = mins[1];

			stop[0] = start[0];
			stop[1] = start[1];

			HLTraceEntity(hl_bi_map, start, stop, zero, zero, ent, TRUE, &tr);

			if (tr.fraction != 1.0 && tr.end_pos[2] > bottom)
				bottom = tr.end_pos[2];

			if (tr.fraction == 1.0 ||
				mid - tr.end_pos[2] > HLPHYS_STEPSIZE)
				return FALSE;
		}
	}

	return TRUE;
}

Bool HLBiMoveStep(I64 ent, F64 yaw, F64 dist)
{//SV_movestep: walk one step along a heading
 //
 //no horizontal sweep. project to the destination raised by one step height,
 //then trace downward for floor: walls make that trace start solid, ledges
 //find no floor within two step heights.
 //
 //a horizontal sweep refuses nearly every move - the start point is already
 //inside the expanded hull.
	CHLTrace	tr;
	F64		origin[3];
	F64		neworg[3];
	F64		end[3];
	F64		rad;
	F64		dz;
	I64		flags;
	I64		enemy;
	I64		attempt;

	if (!hl_bi_map)
		return FALSE;

	HLBiGetFieldV(ent, hl_fld_origin, origin);
	rad = yaw * HLDEG2RAD;

	flags = ToI64(HLPrFieldF(ent, hl_fld_flags));

	//swimmers and fliers don't step - they move in three dimensions and nudge
	//toward the target's height. as walkers, a fish needs floor to move.
	if (flags & (HLFL_SWIM_ | HLFL_FLY_))
	{
		enemy = 0;
		if (hl_fld_enemy >= 0)
			enemy = HLPrEdictNum(HLPrFieldI(ent, hl_fld_enemy));

		for (attempt = 0; attempt < 2; attempt++)
		{
			neworg[0] = origin[0] + Cos(rad) * dist;
			neworg[1] = origin[1] + Sin(rad) * dist;
			neworg[2] = origin[2];

			//first attempt closes the height gap, the second retries flat in
			//case the climb was what blocked it
			if (attempt == 0 && enemy > 0)
			{
				dz = origin[2] - HLPrFieldF(enemy, hl_fld_origin + 2);
				if (dz > 40.0)
					neworg[2] -= 8.0;
				if (dz < 30.0)
					neworg[2] += 8.0;
			}

			HLBiTraceEnt(ent, origin, neworg, &tr);

			if (tr.fraction == 1.0)
			{
				//a swimmer must not leave its water
				if ((flags & HLFL_SWIM_) &&
					HLHullPointContents(hl_bi_map,
						hl_bi_map->models[0].head_node[1], tr.end_pos) ==
					HLCONTENTS_EMPTY)
					return FALSE;

				HLBiSetFieldV(ent, hl_fld_origin, tr.end_pos);
				HLGameLinkEdict(ent);
				return TRUE;
			}

			if (enemy <= 0)
				break;
		}

		return FALSE;
	}

	//destination, lifted to clear ordinary steps and thresholds
	neworg[0] = origin[0] + Cos(rad) * dist;
	neworg[1] = origin[1] + Sin(rad) * dist;
	neworg[2] = origin[2] + HLPHYS_STEPSIZE;

	HLVecCopy(neworg, end);
	end[2] -= HLPHYS_STEPSIZE * 2.0;

	HLBiTraceEnt(ent, neworg, end, &tr);

	if (tr.all_solid)
		return FALSE;

	//start solid means the lift hit a ceiling, retry unlifted
	if (tr.start_solid)
	{
		neworg[2] -= HLPHYS_STEPSIZE;
		HLBiTraceEnt(ent, neworg, end, &tr);

		if (tr.all_solid || tr.start_solid)
			return FALSE;
	}

	//nothing within two step heights - that's a ledge
	if (tr.fraction == 1.0)
		return FALSE;

	if (tr.plane_normal[2] < 0.7)
		return FALSE;			//too steep to stand on

	HLBiSetFieldV(ent, hl_fld_origin, tr.end_pos);

	//the downward trace proves only that something is under the destination.
	//SV_CheckBottom proves the whole box is supported
	if (!HLBiCheckBottomEnt(ent))
	{
		HLBiSetFieldV(ent, hl_fld_origin, origin);
		return FALSE;
	}

	//standing on something now, so gravity has to stop pulling
	flags = ToI64(HLPrFieldF(ent, hl_fld_flags));
	HLPrSetFieldF(ent, hl_fld_flags, ToF64(flags | HLFL_ONGROUND_MOVE));
	HLGameLinkEdict(ent);

	return TRUE;
}

U0 HLBiWalkMove()
{//walkmove(yaw, dist) - move along an explicit heading
	I64 ent = HLPrEdictNum(HLPrGetI(hl_ofs_self));

	HLBiRetF(ToF64(HLBiMoveStep(ent, HLBiArgF(0), HLBiArgF(1))));
}

U0 HLBiMoveToGoal()
{//movetogoal(dist) - head for goalentity, steering around obstacles
 //
 //movetogoal takes a distance and nothing else. it is not walkmove renamed;
 //taking that distance as a yaw marches every monster into the nearest wall.
	I64	ent		= HLPrEdictNum(HLPrGetI(hl_ofs_self));
	F64	dist	= HLBiArgF(0);
	I64	goal;
	F64	origin[3];
	F64	gorigin[3];
	F64	d[3];
	F64	ideal;
	F64	turn;
	I64	i;

	if (!hl_bi_map)
	{
		HLBiRetF(0.0);
		return;
	}

	HLBiGetFieldV(ent, hl_fld_origin, origin);
	goal = HLPrEdictNum(HLPrFieldI(ent, hl_fld_goalentity));

	if (goal > 0 && goal < hl_pr_num_edicts && !hl_pr_edict_free[goal])
	{
		HLBiGetFieldV(goal, hl_fld_origin, gorigin);
		HLVecSub(gorigin, origin, d);

		if (d[0] == 0.0 && d[1] == 0.0)
			ideal = HLPrFieldF(ent, hl_fld_ideal_yaw);
		else
		{
			ideal = Arg(d[0], d[1]) / HLDEG2RAD;
			if (ideal < 0.0)
				ideal += 360.0;
		}
	}
	else
		ideal = HLPrFieldF(ent, hl_fld_ideal_yaw);

	//straight at the goal, then wider detours either side - this is how a
	//monster rounds a corner instead of stalling on it
	for (i = 0; i < 5; i++)
	{
		switch (i)
		{
			case 0:	turn = 0.0;		break;
			case 1:	turn = 45.0;	break;
			case 2:	turn = -45.0;	break;
			case 3:	turn = 90.0;	break;
			default: turn = -90.0;	break;
		}

		if (HLBiMoveStep(ent, HLAngleNorm(ideal + turn), dist))
		{
			//face the way it actually went, so ChangeYaw turns the body to
			//match and the walk animation reads right
			HLPrSetFieldF(ent, hl_fld_ideal_yaw, HLAngleNorm(ideal + turn));
			hl_move_ok++;
			HLBiRetF(1.0);
			return;
		}
	}

	hl_move_fail++;

	//boxed in - report failure so the AI picks a new goal
	HLBiRetF(0.0);
}

U0 HLBiChangeYaw()
{//turn toward ideal_yaw at yaw_speed, the short way round
	I64 ent		= HLPrEdictNum(HLPrGetI(hl_ofs_self));
	F64 current	= HLAngleNorm(HLPrFieldF(ent, hl_fld_angles + 1));
	F64 ideal	= HLPrFieldF(ent, hl_fld_ideal_yaw);
	F64 speed	= HLPrFieldF(ent, hl_fld_yaw_speed);
	F64 move;

	if (current == ideal)
		return;

	move = ideal - current;

	if (ideal > current)
	{
		if (move >= 180.0)
			move -= 360.0;
	}
	else
	{
		if (move <= -180.0)
			move += 360.0;
	}

	if (move > 0.0)
	{
		if (move > speed)
			move = speed;
	}
	else
	{
		if (move < -speed)
			move = -speed;
	}

	HLPrSetFieldF(ent, hl_fld_angles + 1, HLAngleNorm(current + move));

	//turn state sample: yaw_speed 0 never turns, a static ideal_yaw means the
	//AI is not tracking, and both sane places the fault in the draw-time
	//rotation
	if (hl_yaw_reports < 3)
	{
		hl_yaw_reports++;
		StrPrint(hl_yaw_line,
			"yaw: %s cur=%.0f ideal=%.0f speed=%.0f -> %.0f\n",
			HLPrStr(HLPrFieldI(ent, hl_fld_classname)),
			current, ideal, speed, HLAngleNorm(current + move));
		HLLog(hl_yaw_line);
	}
}

//find() diagnostics.
//
//SUB_UseTargets and LinkDoors both walk entities with
//    do { t = find(t, field, value); if (!t) return; ... } while (1);
//which terminates only because find resumes after the entity handed to it -
//return the same entity twice and the loop never ends.
//
//count consecutive calls that fail to advance, log the first few.
#define HLFIND_MAX_REPORTS	12
I64 hl_find_last_start	= -1;
I64 hl_find_last_result	= -1;
I64 hl_find_repeats		= 0;
I64 hl_find_reports		= 0;
U8  hl_find_line[160];

U0 HLBiFind()
{//linear scan from a start entity for a string field match
	I64  start = HLBiArgEnt(0);
	I64  fld   = HLPrGetI(HLBiArg(1));
	U8  *match = HLBiArgS(2);
	I64  found = 0;
	I64  i;
	U8  *s;

	for (i = start + 1; i < hl_pr_num_edicts; i++)
	{
		if (!hl_pr_edict_free[i])
		{
			s = HLPrStr(HLPrFieldI(i, fld));
			if (s[0] && !StrCompare(s, match))
			{
				found = i;
				goto qf_done;
			}
		}
	}

qf_done:
	//same start, same answer: a caller's walk is not progressing
	if (start == hl_find_last_start && found == hl_find_last_result && found != 0)
		hl_find_repeats++;
	else
		hl_find_repeats = 0;

	if (hl_find_repeats == 8 && hl_find_reports < HLFIND_MAX_REPORTS)
	{
		hl_find_reports++;

		StrPrint(hl_find_line,
			"find: NOT ADVANCING start=%d -> %d field=%d match='%s'\n",
			start, found, fld, match);
		HLLog(hl_find_line);
		HLPrStackDump;
		HLLogFlush;
	}

	hl_find_last_start  = start;
	hl_find_last_result = found;

	HLBiRetEnt(found);
}

U0 HLBiSetSpawnParms()
{//PF_setspawnparms - the arg names the client, and edicts 1..maxclients are
 //the client slots, so edict number is slot plus one
	I64	ent;
	I64	slot;
	I64	ofs;
	I64	i;

	ent  = HLBiArgEnt(0);
	slot = ent - 1;

	//a hard error in the original. leaving the globals alone is the safe
	//equivalent - ClientConnect sees SetNewParms' output, not another
	//player's kit.
	if (slot < 0 || slot >= HLSV_MAX_CLIENTS)
		return;

	if (!hl_client_parms_set[slot])
		return;

	for (i = 0; i < HLPR_MAX_PARM_GLOBALS; i++)
	{
		ofs = hl_ofs_parms[i];
		if (ofs >= 0)
			HLPrSetF(ofs, hl_client_parms[slot * HLPR_MAX_PARM_GLOBALS + i]);
	}
}

U0 HLBiFindRadius()
{//PF_findradius: a .chain-linked list of every solid edict whose box centre is
 //inside the sphere. T_RadiusDamage and GrenadeExplode walk the whole list -
 //returning only the first hit makes splash damage a no-op.
	F64 org[3];
	F64 rad;
	F64 eorg[3];
	F64 mins[3];
	F64 maxs[3];
	F64 d[3];
	I64 i;
	I64 j;
	I64 chain;

	HLBiArgV(0, org);
	rad = HLBiArgF(1);
	chain = 0;		//world terminates the list, as in the original

	if (hl_fld_chain < 0)
	{
		HLBiRetEnt(0);
		return;
	}

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
			goto qfr_next;

		if (HLPrFieldF(i, hl_fld_solid) == 0.0)
			goto qfr_next;

		HLBiGetFieldV(i, hl_fld_origin, eorg);
		HLBiGetFieldV(i, hl_fld_mins, mins);
		HLBiGetFieldV(i, hl_fld_maxs, maxs);

		for (j = 0; j < 3; j++)
			eorg[j] = eorg[j] + (mins[j] + maxs[j]) * 0.5;

		HLVecSub(eorg, org, d);
		if (HLVecLength(d) > rad)
			goto qfr_next;

		HLPrSetFieldI(i, hl_fld_chain, HLPrEdictValue(chain));
		chain = i;

qfr_next:
	}

	HLBiRetEnt(chain);
}

U0 HLBiNextEnt()
{
	I64 i = HLBiArgEnt(0) + 1;

	while (i < hl_pr_num_edicts)
	{
		if (!hl_pr_edict_free[i])
		{
			HLBiRetEnt(i);
			return;
		}
		i++;
	}

	HLBiRetEnt(0);
}

U0 HLBiVecToYaw()
{
	F64 v[3];
	F64 yaw;

	HLBiArgV(0, v);

	if (v[0] == 0.0 && v[1] == 0.0)
		yaw = 0.0;
	else
	{
		yaw = Arg(v[0], v[1]) / HLDEG2RAD;
		if (yaw < 0.0)
			yaw += 360.0;
	}

	HLBiRetF(yaw);
}

U0 HLBiVecToAngles()
{
	F64 v[3];
	F64 out[3];

	HLBiArgV(0, v);
	HLVecToAngles(v, out);
	HLBiRetV(out);
}

U0 HLBiVtos()
{//PF_vtos: "%5.1f %5.1f %5.1f"
	F64 v[3];
	U8  buf[64];

	HLBiArgV(0, v);
	StrPrint(buf, "%5.1f %5.1f %5.1f", v[0], v[1], v[2]);

	HLPrSetI(HLPR_OFS_RETURN, HLPrTempString(buf));
}

U0 HLBiFtos()
{//PF_ftos: whole numbers as integers, everything else %5.1f
	F64 v = HLBiArgF(0);
	U8  buf[32];

	if (v == ToF64(ToI64(v)))
		StrPrint(buf, "%d", ToI64(v));
	else
		StrPrint(buf, "%5.1f", v);

	HLPrSetI(HLPR_OFS_RETURN, HLPrTempString(buf));
}

U0 HLBiSpawn()
{
	HLBiRetEnt(HLPrSpawnEdict);
}

U0 HLBiRemove()
{
	HLPrFreeEdict(HLBiArgEnt(0));
}

//text QuakeC printed, waiting for the console to collect it. the console is
//in HLMenu.ZC, compiled after this file, so it is parked here and drained
//there - same arrangement as the fov and cheat requests.
//
//W_ChangeWeapon answers a key with no weapon behind it via sprint("no
//weapon.\n"); dropped, that is indistinguishable from a dead key.
#define HLBI_PRINT_MAX	1024

U8	hl_bi_print_buf[HLBI_PRINT_MAX];
I64	hl_bi_print_len = 0;

U0 HLBiPrintAppend(U8 *s)
{
	I64 n;

	if (!s)
		return;

	n = StrLen(s);

	//dropped, not truncated - a half line is worse than a missing one
	if (hl_bi_print_len + n + 1 >= HLBI_PRINT_MAX)
		return;

	MemCopy(hl_bi_print_buf + hl_bi_print_len, s, n);
	hl_bi_print_len += n;
	hl_bi_print_buf[hl_bi_print_len] = 0;
}

//commands QuakeC pushed at the client with stuffcmd, waiting to run.
//
//stuffcmd is Cbuf_AddText - a console command run as if typed. "bf" is
//V_BonusFlash_f, fired on every item pickup and every tick of a powerup
//running out, so a stub here kills the pickup flash and the powerup warning.
#define HLBI_STUFF_MAX	512

U8	hl_bi_stuff_buf[HLBI_STUFF_MAX];
I64	hl_bi_stuff_len = 0;

U0 HLBiStuffCmd(I64 ent, U8 *s)
{//stuffcmd(client, text) - arg 0 names the client that runs it, or the host
 //flashes when a remote picks something up
	I64 n;
	I64 slot;

	if (!s || !s[0])
		return;

	//remote client: svc_stufftext on its own reliable channel
	if (ent > 0 && ent != hl_player_edict)
	{
		slot = ent - 1;		//edicts 1..maxclients are reserved per slot
		if (slot >= 0 && slot < HLSV_MAX_CLIENTS)
		{
			HLBiWireByte(&hl_sv_client_msg[slot], HLSVC_STUFFTEXT);
			HLBiWireString(&hl_sv_client_msg[slot], s);
		}
		return;
	}

	n = StrLen(s);

	if (hl_bi_stuff_len + n + 1 >= HLBI_STUFF_MAX)
		return;

	MemCopy(hl_bi_stuff_buf + hl_bi_stuff_len, s, n);
	hl_bi_stuff_len += n;
	hl_bi_stuff_buf[hl_bi_stuff_len] = 0;
}

U0 HLBiPrint(I64 first_arg, I64 dest = 0)
{//bprint/sprint/dprint all funnel here
 //dest: 0 = this machine only (dprint), 1 = every client (bprint), or a
 //client edict for sprint
	I64		 i;
	I64		 argc = hl_pr_argc;
	CHLMsg	*m;

	//bounded by pr_argc, not by hunting for a zero slot: the OFS_PARM globals
	//keep whatever the previous call left, so sprint would trail off into the
	//sound name a sound() passed moments earlier. PF_VarString does the same.
	if (argc > HLPR_MAX_PARMS)
		argc = HLPR_MAX_PARMS;

	//sprint to a remote: svc_print on its own channel, nowhere else
	m = HLBiClientMsg(dest);
	if (m)
	{
		HLBiWireByte(m, HLSVC_PRINT);
		for (i = first_arg; i < argc; i++)
			HLBiWireString(m, HLBiArgS(i));
		return;
	}

	//bprint reaches everyone through the protocol, including this machine - the
	//listen server's own client parses svc_print like any other, so printing
	//locally too doubles every join and obituary
	if (dest == 1)
	{
		HLBiWireByte(&hl_sv_reliable_datagram, HLSVC_PRINT);
		for (i = first_arg; i < argc; i++)
			HLBiWireString(&hl_sv_reliable_datagram, HLBiArgS(i));
		return;
	}

	for (i = first_arg; i < argc; i++)
	{
		HLBiPrintAppend(HLBiArgS(i));

		if (hl_bi_dprint)
			"%s", HLBiArgS(i);
	}
}

//--- dispatch --------------------------------------------------------------

U0 HLBiDispatch(I64 num)
{
	F64		v[3];
	F64		a[3];
	F64		bmax[3];
	I64		ent;
	CHLTrace	bi_trace;

	switch (num)
	{
		case 1:		HLBiMakeVectors;		break;
		case 2:		HLBiSetOrigin;		break;
		case 3:		HLBiSetModel;		break;
		case 4:		HLBiSetSize;			break;

		case 6:		break;				//break: debugger hook, ignored

		case 7:		HLBiRetF(ToF64(RandU32 & 0xFFFF) / 65536.0);	break;

		case 8:
			//sound(entity, channel, sample, volume, attenuation) - play local
			//and write svc_sound so remotes hear it
			ent = HLBiArgEnt(0);
			HLBiGetFieldV(ent, hl_fld_origin, v);

			//a brush entity's origin is often 0,0,0 with the geometry in its
			//bounds, so use the box centre
			HLBiGetFieldV(ent, hl_fld_mins, a);
			if (a[0] != 0.0 || a[1] != 0.0 || a[2] != 0.0)
			{
				HLBiGetFieldV(ent, hl_fld_maxs, bmax);
				v[0] += (a[0] + bmax[0]) * 0.5;
				v[1] += (a[1] + bmax[1]) * 0.5;
				v[2] += (a[2] + bmax[2]) * 0.5;
			}

			HLSndPlayAt(HLBiArgS(2), v, HLBiArgF(3), HLBiArgF(4),
				ent, ToI64(HLBiArgF(1)));
			HLSvStartSound(ent, ToI64(HLBiArgF(1)), HLBiArgS(2),
				ToI64(HLBiArgF(3) * 255.0), HLBiArgF(4));
			break;

		case 9:
			HLBiArgV(0, v);
			HLVecNormalize(v);
			HLBiRetV(v);
			break;

		case 10:
		case 11:
			//PF_objerror prints the edict then Host_Errors - dump who and
			//where. the edict is not freed, unlike the original: ED_Free
			//here deletes the door and its whole chain.
			"QuakeC error: %s\n", HLBiArgS(0);
			StrPrint(hl_bi_err_line, "QuakeC error: %s\n", HLBiArgS(0));
			HLLog(hl_bi_err_line);
			HLPrChainDump;
			HLPrStackDump;
			HLLogFlush;
			hl_pr_error = TRUE;
			break;

		case 12:
			HLBiArgV(0, v);
			HLBiRetF(HLVecLength(v));
			break;

		case 13:	HLBiVecToYaw;		break;
		case 14:	HLBiSpawn;			break;
		case 15:	HLBiRemove;			break;
		case 16:	HLBiTraceLine;		break;

		case 17:	HLBiCheckClient;		break;	//checkclient

		case 18:	HLBiFind;			break;

		case 19:	//precache_sound
		case 76:
			if (hl_precache_sound_count < HLBI_MAX_PRECACHE)
			{
				hl_precache_sound[hl_precache_sound_count] = HLBiArgS(0);
				hl_precache_sound_count++;
			}
			HLPrSetI(HLPR_OFS_RETURN, HLPrGetI(HLBiArg(0)));
			break;

		case 20:	//precache_model
		case 75:
			HLBiPrecacheModel(HLBiArgS(0));
			HLPrSetI(HLPR_OFS_RETURN, HLPrGetI(HLBiArg(0)));
			break;

		case 21:	//stuffcmd(client, text) - Cbuf_AddText on the client
			HLBiStuffCmd(HLBiArgEnt(0), HLBiArgS(1));
			break;
		case 22:	HLBiFindRadius;		break;
		case 23:	HLBiPrint(0, 1);					break;	//bprint: everyone
		case 24:	HLBiPrint(1, HLBiArgEnt(0));		break;	//sprint: one client
		case 25:	HLBiPrint(0);					break;	//dprint: local only
		case 26:	HLBiFtos;			break;

		case 27:	HLBiVtos;			break;	//vtos
		case 28:	break;				//coredump
		case 29:	hl_pr_trace = TRUE;	break;
		case 30:	hl_pr_trace = FALSE;	break;
		case 31:	break;				//eprint

		case 32:	HLBiWalkMove;		break;
		case 34:	HLBiDropToFloor;		break;
		case 35:	HLLightStyleSet(ToI64(HLBiArgF(0)), HLBiArgS(1));	break;

		case 36:	HLBiRetF(Round(HLBiArgF(0)));	break;
		case 37:	HLBiRetF(Floor(HLBiArgF(0)));	break;
		case 38:	HLBiRetF(Ceil(HLBiArgF(0)));	break;

		case 40:
			//checkbottom(entity) - a blind "yes" tells the AI every ledge is
			//safe to walk off
			ent = HLBiArgEnt(0);
			HLBiGetFieldV(ent, hl_fld_origin, v);
			HLVecCopy(v, bmax);
			bmax[2] -= HLPHYS_STEPSIZE * 2.0;

			if (!hl_bi_map)
				HLBiRetF(1.0);
			else
			{
				HLBiTraceEnt(ent, v, bmax, &bi_trace);
				HLBiRetF(ToF64(bi_trace.fraction < 1.0));
			}
			break;
		case 41:	HLBiPointContents;	break;
		case 43:	HLBiRetF(Abs(HLBiArgF(0)));	break;

		case 44:
			//aim(entity, speed) - where the shooter is actually facing.
			//v_forward belongs to whoever last called makevectors, usually a
			//monster, so shots would fly along its heading.
			ent = HLPrEdictNum(HLPrGetI(hl_ofs_self));
			HLBiGetFieldV(ent, hl_fld_v_angle, a);

			//clients aim along v_angle, everything else its body angles
			if (a[0] == 0.0 && a[1] == 0.0 && a[2] == 0.0)
				HLBiGetFieldV(ent, hl_fld_angles, a);

			HLAngleVectors(a, v, NULL, NULL);
			HLBiRetV(v);
			break;

		case 45:	HLBiRetF(HLCvarGet(HLBiArgS(0)));	break;	//cvar
		case 46:	HLBiLocalCmd(HLBiArgS(0));	break;	//localcmd
		case 47:	HLBiNextEnt;			break;
		case 48:	//particle(origin, dir, color, count)
			HLBiArgV(0, v);
			HLBiArgV(1, a);
			HLPartEffect(v, a, ToI64(HLBiArgF(2)), ToI64(HLBiArgF(3)), tS);
			HLBiParticleWire(v, a, ToI64(HLBiArgF(2)), ToI64(HLBiArgF(3)));
			break;
		case 49:	HLBiChangeYaw;		break;
		case 51:	HLBiVecToAngles;		break;

		//the byte and coord writers also feed the local temp-entity
		//reassembler, so the host sees its own effects
		case 52:	HLBiWriteByte(HLBiWriteDest, ToI64(HLBiArgF(1)));	break;
		case 53:	HLBiWriteByte(HLBiWriteDest, ToI64(HLBiArgF(1)));	break;
		case 54:	HLBiWireShort(HLBiWriteDest, ToI64(HLBiArgF(1)));	break;
		case 55:	HLBiWireLong(HLBiWriteDest, ToI64(HLBiArgF(1)));	break;
		case 56:	HLBiWriteCoord(HLBiWriteDest, HLBiArgF(1));		break;
		case 57:	HLBiWireAngle(HLBiWriteDest, HLBiArgF(1));			break;
		case 58:	HLBiWriteString(HLBiWriteDest, HLBiArgS(1));		break;
		case 59:	HLBiWriteEntity(HLBiWriteDest, HLBiArgEnt(1));		break;

		case 67:	HLBiMoveToGoal;		break;	//movetogoal(dist)

		case 68:
		case 77:
			HLPrSetI(HLPR_OFS_RETURN, HLPrGetI(HLBiArg(0)));	break;	//precache_file

		case 69:	HLBiMakeStatic;		break;
		case 70:
			//changelevel(mapname) - recorded, not acted on. tearing the world
			//down inside a think frees the running bytecode; the app services
			//this between frames.
			HLStrCopy(hl_change_map, HLBiArgS(0), 64);
			hl_change_pending = TRUE;
			break;
		case 72:	//cvar_set(name, value) - the value arrives as a string
			HLCvarSet(HLBiArgS(0), HLAtoF(HLBiArgS(1)));
			break;
		case 73:	HLBiCenterPrint(HLBiArgEnt(0), HLBiArgS(1));	break;
		case 74:
			//ambientsound(pos, sample, volume, attenuation) - a permanent
			//looping source, not a one-shot at load
			HLBiArgV(0, v);
			HLSndAmbientAdd(v, HLBiArgS(1), HLBiArgF(2), HLBiArgF(3));
			HLBiAmbientSignon(v, HLBiArgS(1), HLBiArgF(2), HLBiArgF(3));
			break;

		case 78:
			//PF_setspawnparms(client): stored parms into parm1..parm16 so
			//ClientConnect rebuilds the loadout they arrived with. per client,
			//on a level change.
			HLBiSetSpawnParms;
			break;

		default:
			//unknown builtins return zero rather than stopping the VM
			HLPrSetI(HLPR_OFS_RETURN, 0);
			break;
	}
}

U0 HLBiInit()
{//install the dispatcher, resolve the trace globals
	I64 i;

	//clear the precache tables before anything walks them, or teardown frees
	//heap garbage
	for (i = 0; i < HLBI_MAX_PRECACHE; i++)
	{
		hl_precache_model[i] = NULL;
		hl_precache_mdl[i]   = NULL;
		hl_precache_sound[i] = NULL;
	}
	hl_precache_model_count = 0;
	hl_precache_sound_count = 0;

	//the precache->BSP-model table is the same state and resets with it. stale
	//mappings against reassigned indices make HLClipBrushModel return -1, and
	//collision skips a brush entity with no model number - doors go non-solid.
	HLClipPrecacheReset;

	hl_pr_builtin_call = &HLBiDispatch;

	hl_ofs_trace_allsolid		= HLPrFindGlobal("trace_allsolid");
	hl_ofs_trace_startsolid		= HLPrFindGlobal("trace_startsolid");
	hl_ofs_trace_fraction		= HLPrFindGlobal("trace_fraction");
	hl_ofs_trace_endpos			= HLPrFindGlobal("trace_endpos");
	hl_ofs_trace_plane_normal	= HLPrFindGlobal("trace_plane_normal");
	hl_ofs_trace_plane_dist		= HLPrFindGlobal("trace_plane_dist");
	hl_ofs_trace_ent				= HLPrFindGlobal("trace_ent");
	hl_ofs_trace_inopen			= HLPrFindGlobal("trace_inopen");
	hl_ofs_trace_inwater			= HLPrFindGlobal("trace_inwater");

	HLBiCheckClientReset;
}
