// HLPlayer.ZC - the player as a real QuakeC client edict
//
//   spawn   ClientConnect then PutClientInServer - health, weapon, inventory
//   frame   publish input and position, PlayerPreThink, move,
//           PlayerPostThink, then read back what QuakeC changed
//
// QuakeC owns health, weapons and teleports, so the read-back is mandatory

//entity flags and solidity for the touch pass, HLFL_CLIENT lives in HLGame.ZC
#define HLFL_ONGROUND	512
#define HLFL_WATERJUMP	2048

//HLSOLID_* now live in HLEnt.ZC, which compiles first

#define HLDEAD_NO		0

//hl_player_active lives next to hl_player_edict in HLProgs.ZC (HLNetSv needs it)
I64	 hl_player_touches	= 0;

U0 HLPlayerSetVec(I64 fld, F64 x, F64 y, F64 z)
{
	HLPrSetFieldF(hl_player_edict, fld, x);
	HLPrSetFieldF(hl_player_edict, fld + 1, y);
	HLPrSetFieldF(hl_player_edict, fld + 2, z);
}

Bool HLPlayerSpawn(F64 *origin, F64 *angles, U8 *player_name)
{//hand the reserved edict to QuakeC and let it outfit the player
	I64 fn;
	U8 *netname;

	hl_player_active  = FALSE;
	hl_player_touches = 0;

	if (hl_player_edict <= 0)
		return FALSE;

	if (!player_name || !player_name[0])
		netname = "player";
	else
		netname = player_name;

	//minimum state PutClientInServer expects to find already set
	HLPlayerSetVec(hl_fld_origin, origin[0], origin[1], origin[2]);
	HLPlayerSetVec(hl_fld_angles, 0.0, angles[1], 0.0);
	HLPlayerSetVec(hl_fld_v_angle, 0.0, angles[1], 0.0);
	HLPlayerSetVec(hl_fld_velocity, 0.0, 0.0, 0.0);
	HLPlayerSetVec(hl_fld_mins, HLPL_MINS_XY, HLPL_MINS_XY, HLPL_MINS_Z);
	HLPlayerSetVec(hl_fld_maxs, HLPL_MAXS_XY, HLPL_MAXS_XY, HLPL_MAXS_Z);
	HLPlayerSetVec(hl_fld_view_ofs, 0.0, 0.0, HLPL_VIEW_OFS_Z);

	HLPrSetFieldF(hl_player_edict, hl_fld_flags, ToF64(HLFL_CLIENT));
	HLPrSetFieldI(hl_player_edict, hl_fld_classname, HLPrNewString("player"));
	//ClientConnect bprints self.netname
	HLPrSetFieldI(hl_player_edict, hl_fld_netname, HLPrNewString(netname));

	//SetNewParms fills the spawn parm globals ClientConnect reads
	fn = HLPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(hl_player_edict));
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	fn = HLPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(hl_player_edict));
		HLPrSetI(hl_ofs_other, 0);
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	fn = HLPrFindFunction("PutClientInServer");
	if (fn <= 0)
	{
		"HLPlayer: PutClientInServer missing\n";
		return FALSE;
	}

	HLPrSetI(hl_ofs_self, HLPrEdictValue(hl_player_edict));
	HLPrSetI(hl_ofs_other, 0);
	HLPrExecute(fn);
	hl_pr_error = FALSE;

	//PutClientInServer wipes runtime fields, pin the name again
	HLPrSetFieldI(hl_player_edict, hl_fld_netname, HLPrNewString(netname));

	//PutClientInServer picks its own spawn point, adopt what it chose
	origin[0] = HLPrFieldF(hl_player_edict, hl_fld_origin);
	origin[1] = HLPrFieldF(hl_player_edict, hl_fld_origin + 1);
	origin[2] = HLPrFieldF(hl_player_edict, hl_fld_origin + 2);

	hl_player_active = TRUE;

	//PutClientInServer assigns th_die = PlayerDie, and a VM error aborts
	//mid-function - unset th_die means death never runs at all
	if (hl_fld_th_die >= 0 && !HLPrFieldI(hl_player_edict, hl_fld_th_die))
		HLLog("player: WARNING th_die unset, death will not work\n");

	return TRUE;
}

Bool HLPlayerBoxTouches(I64 ent, F64 *org)
{//SV_TouchLinks overlap test - the two STORED absolute boxes, never boxes
 //rebuilt from origin and size. SV_LinkEdict PADS what it stores:
 //  FL_ITEM   15 units in X and Y, so items grab from beside and off ledges
 //  everything 1 unit on every axis, moves stop an epsilon short of a surface
	F64 emins[3];
	F64 emaxs[3];
	F64 pmins[3];
	F64 pmaxs[3];
	F64 eorg[3];
	I64 i;

	if (hl_fld_absmin >= 0 && hl_fld_absmax >= 0)
	{
		//caller linked the player box just before this, both sides current
		for (i = 0; i < 3; i++)
		{
			emins[i] = HLPrFieldF(ent, hl_fld_absmin + i);
			emaxs[i] = HLPrFieldF(ent, hl_fld_absmax + i);
			pmins[i] = HLPrFieldF(hl_player_edict, hl_fld_absmin + i);
			pmaxs[i] = HLPrFieldF(hl_player_edict, hl_fld_absmax + i);
		}
	}
	else
	{
		//no abs fields in this progs.dat - raw boxes plus the 1 unit
		//slack SV_LinkEdict would have applied
		eorg[0] = HLPrFieldF(ent, hl_fld_origin);
		eorg[1] = HLPrFieldF(ent, hl_fld_origin + 1);
		eorg[2] = HLPrFieldF(ent, hl_fld_origin + 2);

		for (i = 0; i < 3; i++)
		{
			emins[i] = eorg[i] + HLPrFieldF(ent, hl_fld_mins + i) - 1.0;
			emaxs[i] = eorg[i] + HLPrFieldF(ent, hl_fld_maxs + i) + 1.0;
		}

		pmins[0] = org[0] + HLPL_MINS_XY - 1.0;
		pmins[1] = org[1] + HLPL_MINS_XY - 1.0;
		pmins[2] = org[2] + HLPL_MINS_Z  - 1.0;
		pmaxs[0] = org[0] + HLPL_MAXS_XY + 1.0;
		pmaxs[1] = org[1] + HLPL_MAXS_XY + 1.0;
		pmaxs[2] = org[2] + HLPL_MAXS_Z  + 1.0;
	}

	for (i = 0; i < 3; i++)
	{
		if (pmins[i] > emaxs[i] || pmaxs[i] < emins[i])
			return FALSE;
	}

	return TRUE;
}

U0 HLPlayerTouchTriggers(F64 *org, F64 *velocity)
{//run touch on every trigger the player is inside - doors, items, teleporters
	I64 i;
	I64 touch;
	I64 j;

	//publish the CURRENT position before touching anything - the read-back
	//below is unconditional and a stale edict drags the player backwards
	//every step. QuakeC's own box tests read .origin and .absmin/.absmax too
	for (j = 0; j < 3; j++)
	{
		HLPrSetFieldF(hl_player_edict, hl_fld_origin + j, org[j]);
		HLPrSetFieldF(hl_player_edict, hl_fld_velocity + j, velocity[j]);
	}

	HLGameLinkEdict(hl_player_edict);

	i = 1;
	while (i < hl_pr_num_edicts)
	{
		if (!hl_pr_edict_free[i] && i != hl_player_edict)
		{
			if (HLPrFieldF(i, hl_fld_solid) == ToF64(HLSOLID_TRIGGER))
			{
				touch = HLPrFieldI(i, hl_fld_touch);

				if (touch > 0 && touch < hl_pr_num_functions &&
					HLPlayerBoxTouches(i, org))
				{
					//touch runs on the trigger, player is "other"
					HLPrSetI(hl_ofs_self, HLPrEdictValue(i));
					HLPrSetI(hl_ofs_other, HLPrEdictValue(hl_player_edict));
					HLPrExecute(touch);
					hl_pr_error = FALSE;
					hl_player_touches++;

					//a touch can MOVE the player - teleporters do - so adopt
					//the new position now or post-think pushes the old one
					//back and the trigger refires forever. safe to read
					//unconditionally only because of the publish above
					org[0] = HLPrFieldF(hl_player_edict, hl_fld_origin);
					org[1] = HLPrFieldF(hl_player_edict, hl_fld_origin + 1);
					org[2] = HLPrFieldF(hl_player_edict, hl_fld_origin + 2);

					//teleporters set a launch velocity too
					velocity[0] = HLPrFieldF(hl_player_edict, hl_fld_velocity);
					velocity[1] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 1);
					velocity[2] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 2);

					//relink so later triggers this pass see the new bounds
					HLGameLinkEdict(hl_player_edict);
				}
			}
		}

		i++;
	}
}

Bool HLPlayerWaterJump(F64 *velocity, F64 game_time)
{//service an in-progress water jump, TRUE while one runs
 //QuakeC sets the flag and the up velocity, the engine owns the END - clear
 //it out of liquid or on timeout, else gravity is skipped forever
	I64 flags;

	if (!hl_player_active)
		return FALSE;

	flags = ToI64(HLPrFieldF(hl_player_edict, hl_fld_flags));

	if (!(flags & HLFL_WATERJUMP))
		return FALSE;

	//out of the water, or timed out
	if (HLPrFieldF(hl_player_edict, hl_fld_waterlevel) == 0.0 ||
		game_time > HLPrFieldF(hl_player_edict, hl_fld_teleport_time))
	{
		HLPrSetFieldF(hl_player_edict, hl_fld_flags,
			ToF64(flags & ~HLFL_WATERJUMP));
		HLPrSetFieldF(hl_player_edict, hl_fld_teleport_time, 0.0);
		return FALSE;
	}

	//horizontal push comes from movedir, the ledge normal QuakeC recorded
	velocity[0] = HLPrFieldF(hl_player_edict, hl_fld_movedir);
	velocity[1] = HLPrFieldF(hl_player_edict, hl_fld_movedir + 1);

	return TRUE;
}

U0 HLPlayerWater(I64 level, I64 type)
{//publish liquid depth - QuakeC keys swimming, drowning, splash and tint here
	if (!hl_player_active)
		return;

	HLPrSetFieldF(hl_player_edict, hl_fld_waterlevel, ToF64(level));
	HLPrSetFieldF(hl_player_edict, hl_fld_watertype, ToF64(type));
}

U0 HLPlayerPreThink(F64 *origin, F64 *velocity, F64 *angles, Bool on_ground,
	Bool attack, Bool jump, I64 impulse)
{//publish the engine's view of the player, then let QuakeC react
	I64 fn;
	I64 flags;

	if (!hl_player_active)
		return;

	HLPlayerSetVec(hl_fld_origin, origin[0], origin[1], origin[2]);
	HLPlayerSetVec(hl_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//SV_ClientThink: the body leans a THIRD of the view pitch, inverted -
	//    ent->v.angles[PITCH] = -ent->v.v_angle[PITCH] / 3
	//zeroing it left every player standing bolt upright to everyone else.
	//v_angle keeps the full view, which is what the weapon code aims along
	HLPlayerSetVec(hl_fld_angles, -angles[0] / 3.0, angles[1], 0.0);
	HLPlayerSetVec(hl_fld_v_angle, angles[0], angles[1], angles[2]);

	//touch only the two bits the engine owns - overwriting the field destroys
	//FL_JUMPRELEASED, FL_INWATER, FL_WATERJUMP and FL_GODMODE
	flags = ToI64(HLPrFieldF(hl_player_edict, hl_fld_flags));
	flags |= HLFL_CLIENT;

	if (on_ground)
		flags |= HLFL_ONGROUND;
	else
		flags &= ~HLFL_ONGROUND;

	HLPrSetFieldF(hl_player_edict, hl_fld_flags, ToF64(flags));

	HLPrSetFieldF(hl_player_edict, hl_fld_button0, ToF64(attack));
	HLPrSetFieldF(hl_player_edict, hl_fld_button2, ToF64(jump));
	//only when non-zero, as SV_ReadClientMove does. ImpulseCommands clears the
	//field in post-think, so an empty tick must not wipe a pending impulse
	if (impulse)
		HLPrSetFieldF(hl_player_edict, hl_fld_impulse, ToF64(impulse));

	fn = HLPrFindFunction("PlayerPreThink");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(hl_player_edict));
		HLPrSetI(hl_ofs_other, 0);
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	//read velocity back - PlayerJump runs inside PreThink and adds the jump
	//impulse onto the edict. a stale copy discards it inside the same tick
	velocity[0] = HLPrFieldF(hl_player_edict, hl_fld_velocity);
	velocity[1] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 1);
	velocity[2] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 2);

	//QuakeC can teleport or shove during pre-think
	origin[0] = HLPrFieldF(hl_player_edict, hl_fld_origin);
	origin[1] = HLPrFieldF(hl_player_edict, hl_fld_origin + 1);
	origin[2] = HLPrFieldF(hl_player_edict, hl_fld_origin + 2);

	//.impulse is DELIBERATELY NOT CLEARED HERE - ImpulseCommands reaches it
	//from PlayerPOSTthink via W_WeaponFrame and zeroes it once it has acted.
	//SV_ReadClientMove only ever sets it
}

U0 HLPlayerPostThink(F64 *origin, F64 *velocity, F64 *angles,
	Bool on_ground = FALSE, I64 water_level = 0, I64 water_type = 0)
{//run the post-move logic, then accept whatever QuakeC decided
	I64  fn;
	I64  flags;
	F64  fixangle;

	if (!hl_player_active)
		return;

	HLPlayerSetVec(hl_fld_origin, origin[0], origin[1], origin[2]);
	HLPlayerSetVec(hl_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//refresh FL_ONGROUND after the move - PostThink's landing test reads
	//    (self.jump_flag < -300) && (self.flags & FL_ONGROUND)
	//and PreThink's pre-move value says airborne on the frame that matters.
	//SV_WalkMove sets it on the edict itself
	flags = ToI64(HLPrFieldF(hl_player_edict, hl_fld_flags));
	if (on_ground)
		flags |= HLFL_ONGROUND;
	else
		flags &= ~HLFL_ONGROUND;
	HLPrSetFieldF(hl_player_edict, hl_fld_flags, ToF64(flags));

	//watertype picks the splash variant of the landing sound
	if (hl_fld_waterlevel >= 0)
		HLPrSetFieldF(hl_player_edict, hl_fld_waterlevel, ToF64(water_level));
	if (hl_fld_watertype >= 0)
		HLPrSetFieldF(hl_player_edict, hl_fld_watertype, ToF64(water_type));

	fn = HLPrFindFunction("PlayerPostThink");
	if (fn > 0)
	{
		HLPrSetI(hl_ofs_self, HLPrEdictValue(hl_player_edict));
		HLPrSetI(hl_ofs_other, 0);
		HLPrExecute(fn);
		hl_pr_error = FALSE;
	}

	//QuakeC owns teleports and knockback, its position wins
	origin[0] = HLPrFieldF(hl_player_edict, hl_fld_origin);
	origin[1] = HLPrFieldF(hl_player_edict, hl_fld_origin + 1);
	origin[2] = HLPrFieldF(hl_player_edict, hl_fld_origin + 2);

	velocity[0] = HLPrFieldF(hl_player_edict, hl_fld_velocity);
	velocity[1] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 1);
	velocity[2] = HLPrFieldF(hl_player_edict, hl_fld_velocity + 2);

	//fixangle: a teleporter asking for a view snap
	fixangle = HLPrFieldF(hl_player_edict, hl_fld_fixangle);
	if (fixangle != 0.0)
	{
		angles[0] = HLPrFieldF(hl_player_edict, hl_fld_angles);
		angles[1] = HLPrFieldF(hl_player_edict, hl_fld_angles + 1);
		angles[2] = HLPrFieldF(hl_player_edict, hl_fld_angles + 2);
		HLPrSetFieldF(hl_player_edict, hl_fld_fixangle, 0.0);
	}
}

F64 HLPlayerHealth()
{
	if (!hl_player_active)
		return 0.0;

	return HLPrFieldF(hl_player_edict, hl_fld_health);
}

F64 HLPlayerArmor()
{
	if (!hl_player_active)
		return 0.0;

	return HLPrFieldF(hl_player_edict, hl_fld_armorvalue);
}

F64 HLPlayerAmmo()
{
	if (!hl_player_active)
		return 0.0;

	return HLPrFieldF(hl_player_edict, hl_fld_currentammo);
}

F64 HLPlayerViewHeight()
{//cl.viewheight - NOT a constant
 //
 //with no VM the duck state owns it: HLDuckUpdate eases hl_view_ofs_z between
 //28 and 12 across the crouch. with a VM, QuakeC's .view_ofs wins, because
 //PlayerDie sets it to '0 0 -8' so the camera drops with the body
	if (!hl_player_active || hl_player_edict <= 0 || hl_fld_view_ofs < 0)
		return hl_view_ofs_z;

	return HLPrFieldF(hl_player_edict, hl_fld_view_ofs + 2);
}

Bool HLPlayerDead()
{
	if (!hl_player_active)
		return FALSE;

	return ToBool(HLPrFieldF(hl_player_edict, hl_fld_deadflag) != ToF64(HLDEAD_NO)
		|| HLPlayerHealth <= 0.0);
}

Bool HLPlayerWalking()
{//TRUE while the player entity is still MOVETYPE_WALK
 //PlayerDie switches to MOVETYPE_TOSS and the corpse becomes an ordinary
 //falling object, the way SV_Physics_Client dispatches it
	if (!hl_player_active || hl_player_edict <= 0)
		return TRUE;

	return ToBool(ToI64(HLPrFieldF(hl_player_edict, hl_fld_movetype)) ==
		HLMOVETYPE_WALK);
}

Bool HLPlayerFrozen()
{//TRUE when movement input must be ignored entirely
 //SV_ClientThink returns early on MOVETYPE_NONE (intermission parks the
 //client there) and on health <= 0, before it reads the move
	I64 movetype;

	if (!hl_player_active || hl_player_edict <= 0)
		return FALSE;

	movetype = ToI64(HLPrFieldF(hl_player_edict, hl_fld_movetype));
	if (movetype == HLMOVETYPE_NONE)
		return TRUE;

	return ToBool(HLPlayerHealth <= 0.0);
}

U8 *HLPlayerWeaponModel()
{//view model QuakeC wants shown, e.g. "progs/v_shot.mdl"
	I64 s;

	if (!hl_player_active)
		return NULL;

	s = HLPrFieldI(hl_player_edict, hl_fld_weaponmodel);
	if (!s)
		return NULL;

	return HLPrStr(s);
}

I64 HLPlayerWeaponFrame()
{
	if (!hl_player_active)
		return 0;

	return ToI64(HLPrFieldF(hl_player_edict, hl_fld_weaponframe));
}
