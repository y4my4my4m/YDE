// HLPlayer.ZC - player state for the shell
//
// The player was a QuakeC client edict: publish input and position, run
// PlayerPreThink, move, run PlayerPostThink, read back what the bytecode
// changed. Half-Life ships no progs.dat, so none of that ever ran.
//
// The native player lives in HLEntity.ZC. What remains here is the read side
// the shell asks for, plus no-op stubs for the frame hooks HL1.ZC still calls.

//--- frame hooks ------------------------------------------------------------
//
// No-ops. Each drove the player edict through the bytecode; no edict is ever
// allocated. Retained for the calls in HL1.ZC.

Bool HLPlayerSpawn(F64 *origin, F64 *angles, U8 *player_name)
{//there is no client edict to hand to game logic
	no_warn origin;
	no_warn angles;
	no_warn player_name;

	return FALSE;
}

U0 HLPlayerTouchTriggers(F64 *org, F64 *velocity)
{//HLEntity.ZC runs the native trigger pass
	no_warn org;
	no_warn velocity;
}

Bool HLPlayerWaterJump(F64 *velocity, F64 game_time)
{
	no_warn velocity;
	no_warn game_time;

	return FALSE;
}

U0 HLPlayerWater(I64 level, I64 type)
{
	no_warn level;
	no_warn type;
}

U0 HLPlayerPreThink(F64 *origin, F64 *velocity, F64 *angles, Bool on_ground,
	Bool attack, Bool jump, I64 impulse)
{
	no_warn origin;
	no_warn velocity;
	no_warn angles;
	no_warn on_ground;
	no_warn attack;
	no_warn jump;
	no_warn impulse;
}

U0 HLPlayerPostThink(F64 *origin, F64 *velocity, F64 *angles,
	Bool on_ground = FALSE, I64 water_level = 0, I64 water_type = 0)
{
	no_warn origin;
	no_warn velocity;
	no_warn angles;
	no_warn on_ground;
	no_warn water_level;
	no_warn water_type;
}

//--- state accessors --------------------------------------------------------
//
// The native entity world owns player state; these read it directly.

F64 HLPlayerHealth()
{
	return hl_ent_player_health;
}

F64 HLPlayerArmor()
{
	return hl_ent_player_armor;
}

F64 HLPlayerViewHeight()
{//cl.viewheight, not a constant
 //
 //The duck state owns it: HLDuckUpdate eases hl_view_ofs_z from VEC_VIEW 28
 //down to VEC_DUCK_VIEW - fMore, which is below the ducked eye height because
 //the origin has not dropped yet
	return hl_view_ofs_z;
}

Bool HLPlayerDead()
{
	return hl_ent_player_dead;
}

Bool HLPlayerWalking()
{//TRUE while the player moves under its own feet
 //
 //Always TRUE: the native world has no MOVETYPE, and corpse physics is not
 //modelled, so the walk path stays selected as it did with no player edict
	return TRUE;
}

Bool HLPlayerFrozen()
{//TRUE when movement input must be ignored
 //
 //hl_ent_input_locked, not hl_ent_player_dead: the lock is what
 //CBasePlayer::Killed sets and CBasePlayer::Spawn clears, and it is the flag
 //the rest of the shell tests. The two agree today
	return hl_ent_input_locked;
}

U8 *HLPlayerWeaponModel()
{//no alias view model: HL's viewmodel is a studio model owned by HLWeapon.ZC
	return NULL;
}

I64 HLPlayerWeaponFrame()
{//the studio sequence in HLWeapon.ZC replaces the alias frame counter
	return 0;
}
