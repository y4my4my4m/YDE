I64 HLDeltaScaled(F64 v, F64 scale)
{
	return ToI64(v * scale);
}

Bool HLDeltaFieldDiffers(CHLDeltaField *f, F64 *from, F64 *to, U8 *from_str,
	U8 *to_str)
{
	if ((f->type & HLDT_TYPEMASK) == HLDT_STRING)
	{
		if (!from_str || !to_str)
			return FALSE;

		//StrCompare returns 0 when equal
		return ToBool(StrCompare(from_str, to_str) != 0);
	}

	return ToBool(from[f->slot] != to[f->slot]);
}

U0 HLDeltaWriteField(CHLMsg *m, CHLDeltaField *f, F64 v, U8 *str, F64 timebase)
{
	I64 base = f->type & HLDT_TYPEMASK;
	I64 iv;

	if (base == HLDT_STRING)
	{
		HLBitWriteBitString(m, str);
		return;
	}

	if (base == HLDT_ANGLE)
	{
		HLBitWriteBitAngle(m, v, f->bits);
		return;
	}

	if (base == HLDT_TIMEWINDOW_8)
	{
		HLBitWriteSBits(m, ToI64((timebase - v) * 100.0), f->bits);
		return;
	}

	if (base == HLDT_TIMEWINDOW_BIG)
	{
		HLBitWriteSBits(m, ToI64((timebase - v) * f->scale), f->bits);
		return;
	}

	iv = HLDeltaScaled(v, f->scale);

	if (f->type & HLDT_SIGNED)
		HLBitWriteSBits(m, iv, f->bits);
	else
		HLBitWriteBits(m, iv, f->bits);
}

F64 HLDeltaReadField(CHLMsg *m, CHLDeltaField *f, U8 *str, I64 str_max,
	F64 timebase)
{
	I64	base = f->type & HLDT_TYPEMASK;
	I64	iv;
	F64	v;

	if (base == HLDT_STRING)
	{
		HLBitReadBitString(m, str, str_max);
		return 0.0;
	}

	if (base == HLDT_ANGLE)
		return HLBitReadBitAngle(m, f->bits);

	if (base == HLDT_TIMEWINDOW_8)
		return timebase - ToF64(HLBitReadSBits(m, f->bits)) / 100.0;

	if (base == HLDT_TIMEWINDOW_BIG)
		return timebase - ToF64(HLBitReadSBits(m, f->bits)) / f->scale;

	if (f->type & HLDT_SIGNED)
		iv = HLBitReadSBits(m, f->bits);
	else
		iv = HLBitReadBits(m, f->bits);

	v = ToF64(iv) / f->scale;

	if (f->post != 0.0)
		v = v * f->post;

	return v;
}

//mask bytes the widest table can need.
#define HLDELTA_MAX_MASK	8

Bool HLDeltaAnyChange(CHLDelta *d, F64 *from, F64 *to, U8 *from_str, U8 *to_str)
{
	I64 i;

	if (!d)
		return FALSE;

	for (i = 0; i < d->count && i < HLDELTA_MAX_MASK * 8; i++)
	{
		if (HLDeltaFieldDiffers(&d->f[i], from, to, from_str, to_str))
			return TRUE;
	}

	return FALSE;
}

U0 HLDeltaWrite(CHLMsg *m, CHLDelta *d, F64 *from, F64 *to, U8 *from_str,
	U8 *to_str, F64 timebase)
{
	U8	mask[HLDELTA_MAX_MASK];
	I64	i;
	I64	last;
	I64	bytecount;

	if (!m || !d)
		return;

	MemSet(mask, 0, HLDELTA_MAX_MASK);
	last = -1;

	for (i = 0; i < d->count && i < HLDELTA_MAX_MASK * 8; i++)
	{
		if (!HLDeltaFieldDiffers(&d->f[i], from, to, from_str, to_str))
			goto qdw_next;

		mask[i >> 3] = mask[i >> 3] | (1 << (i & 7));
		last = i;

qdw_next:
	}

	if (last < 0)
		bytecount = 0;
	else
		bytecount = (last >> 3) + 1;

	if (bytecount > 7)
	{
		HLLog("net: delta mask over 7 bytes - table too wide for protocol 48\n");
		HLLogFlush;
		bytecount = 7;
	}

	HLBitWriteBits(m, bytecount, 3);

	for (i = 0; i < bytecount; i++)
		HLBitWriteBits(m, mask[i], 8);

	for (i = 0; i < d->count && i < bytecount * 8; i++)
	{
		if (!(mask[i >> 3] & (1 << (i & 7))))
			goto qdw_next2;

		HLDeltaWriteField(m, &d->f[i], to[d->f[i].slot], to_str, timebase);

qdw_next2:
	}
}

Bool HLDeltaRead(CHLMsg *m, CHLDelta *d, F64 *to, U8 *to_str, I64 str_max,
	F64 timebase)
{
	U8	mask[HLDELTA_MAX_MASK];
	I64	i;
	I64	bytecount;
	I64	slot;

	if (!m || !d)
		return FALSE;

	MemSet(mask, 0, HLDELTA_MAX_MASK);

	bytecount = HLBitReadBits(m, 3);

	for (i = 0; i < bytecount; i++)
		mask[i] = HLBitReadBits(m, 8);

	if (m->badread)
		return FALSE;

	for (i = 0; i < bytecount * 8; i++)
	{
		if (!(mask[i >> 3] & (1 << (i & 7))))
			goto qdr_next;

		if (i >= d->count)
		{
			HLLog("net: delta field past end of table - delta.lst mismatch\n");
			HLLogFlush;
			return FALSE;
		}

		slot = d->f[i].slot;
		to[slot] = HLDeltaReadField(m, &d->f[i], to_str, str_max, timebase);

qdr_next:
	}

	return ToBool(!m->badread);
}


class CHLEntState48
{
	F64	 v[HLDELTA_MAX_SLOTS];
	Bool player;
	Bool custom;
	Bool active;
	F64	 msgtime;
};

class CHLClData48
{
	F64	 v[HLDELTA_MAX_SLOTS];
	U8	 physinfo[256];
};

U0 HLState48Clear(CHLEntState48 *e)
{
	I64 i;

	if (!e)
		return;

	for (i = 0; i < HLDELTA_MAX_SLOTS; i++)
		e->v[i] = 0.0;

	e->player  = FALSE;
	e->custom  = FALSE;
	e->active  = FALSE;
	e->msgtime = 0.0;
}

U0 HLClData48Clear(CHLClData48 *c)
{
	I64 i;

	if (!c)
		return;

	for (i = 0; i < HLDELTA_MAX_SLOTS; i++)
		c->v[i] = 0.0;

	c->physinfo[0] = 0;
}

CHLEntState48	hl_net_bl48[HLNET_MAX_ENTS];
CHLEntState48	hl_net_cl48[HLNET_MAX_ENTS];
CHLClData48		hl_cl_data48;
CHLClData48		hl_cl_data48_prev;

U0 HLNetStates48Clear()
{
	I64 i;

	for (i = 0; i < HLNET_MAX_ENTS; i++)
	{
		HLState48Clear(&hl_net_bl48[i]);
		HLState48Clear(&hl_net_cl48[i]);
	}

	HLClData48Clear(&hl_cl_data48);
	HLClData48Clear(&hl_cl_data48_prev);
}

HLNetStates48Clear;

CHLDelta *HLDeltaForEnt(CHLEntState48 *e)
{
	if (!e)
		return &hl_delta_entity;

	if (e->custom)
		return &hl_delta_custom;

	if (e->player)
		return &hl_delta_player;

	return &hl_delta_entity;
}

Bool HLDeltaWriteEntState(CHLMsg *m, CHLEntState48 *from, CHLEntState48 *to,
	F64 timebase)
{
	if (!m || !from || !to)
		return FALSE;

	HLDeltaWrite(m, HLDeltaForEnt(to), from->v, to->v, NULL, NULL, timebase);

	return ToBool(!m->overflowed);
}

Bool HLDeltaReadEntState(CHLMsg *m, CHLEntState48 *from, CHLEntState48 *to,
	F64 timebase)
{
	I64 i;

	if (!m || !from || !to)
		return FALSE;

	if (from != to)
	{
		for (i = 0; i < HLDELTA_MAX_SLOTS; i++)
			to->v[i] = from->v[i];

		to->player = from->player;
		to->custom = from->custom;
	}

	return HLDeltaRead(m, HLDeltaForEnt(to), to->v, NULL, 0, timebase);
}


#define HLPE_OFF_BITS	6
#define HLPE_NUM_BITS	11
#define HLPE_OFF_MAX	62		//widest gap the offset form expresses
#define HLPE_OFF_END	63
#define HLPE_MAX_NUM	2048	//1 << HLPE_NUM_BITS

#define HLPE_MAX_ENTS	256

#define HLPE_FRAMES		8
#define HLPE_FRAME_MASK	7

class CHLFrame48
{
	I64				seq;
	Bool			valid;
	F64				msgtime;
	I64				count;
	I64				num[HLPE_MAX_ENTS];
	CHLEntState48	ent[HLPE_MAX_ENTS];
};

CHLFrame48		hl_pe_cl[HLPE_FRAMES];
CHLFrame48		hl_pe_sv[HLPE_FRAMES];
CHLEntState48	hl_pe_zero;

CHLEntState48	hl_pe_tmp;
CHLEntState48	hl_pe_scratch;

CHLFrame48		hl_pe_stage;

CHLFrame48		hl_pe_sv_stage;

I64	hl_net48_players = 0;

U0 HLState48Copy(CHLEntState48 *dst, CHLEntState48 *src)
{
	if (!dst || !src)
		return;

	MemCopy(dst, src, sizeof(CHLEntState48));
}

U0 HLPEFrameClear(CHLFrame48 *f)
{
	if (!f)
		return;

	f->seq     = -1;
	f->valid   = FALSE;
	f->msgtime = 0.0;
	f->count   = 0;
}

U0 HLPEFramesClear()
{
	I64 i;

	for (i = 0; i < HLPE_FRAMES; i++)
	{
		HLPEFrameClear(&hl_pe_cl[i]);
		HLPEFrameClear(&hl_pe_sv[i]);
	}

	HLPEFrameClear(&hl_pe_stage);
	HLPEFrameClear(&hl_pe_sv_stage);
	HLState48Clear(&hl_pe_zero);
	HLState48Clear(&hl_pe_tmp);
	HLState48Clear(&hl_pe_scratch);
	hl_net48_players = 0;
}

HLPEFramesClear;

CHLFrame48 *HLPEFrameSlot(CHLFrame48 *ring, I64 seq)
{
	if (!ring)
		return NULL;

	return &ring[seq & HLPE_FRAME_MASK];
}

CHLFrame48 *HLPEFrameByLowByte(CHLFrame48 *ring, I64 low)
{
	I64 i;

	if (!ring)
		return NULL;

	for (i = 0; i < HLPE_FRAMES; i++)
	{
		if (ring[i].valid && (ring[i].seq & 0xFF) == (low & 0xFF))
			return &ring[i];
	}

	return NULL;
}

CHLFrame48 *HLPEFrameBySeq(CHLFrame48 *ring, I64 seq)
{
	I64 i;

	if (!ring || seq < 0)
		return NULL;

	for (i = 0; i < HLPE_FRAMES; i++)
	{
		if (ring[i].valid && ring[i].seq == seq)
			return &ring[i];
	}

	return NULL;
}

U0 HLPEFrameCopy(CHLFrame48 *dst, CHLFrame48 *src)
{
	I64 i;

	if (!dst || !src)
		return;

	dst->seq     = src->seq;
	dst->valid   = src->valid;
	dst->msgtime = src->msgtime;
	dst->count   = src->count;

	for (i = 0; i < src->count; i++)
	{
		dst->num[i] = src->num[i];
		HLState48Copy(&dst->ent[i], &src->ent[i]);
	}
}

U0 HLPEFrameStore(CHLFrame48 *ring, CHLFrame48 *src, I64 seq, F64 msgtime)
{
	CHLFrame48 *dst;

	if (!ring || !src || seq < 0)
		return;

	src->seq     = seq;
	src->valid   = TRUE;
	src->msgtime = msgtime;

	dst = HLPEFrameSlot(ring, seq);
	HLPEFrameCopy(dst, src);
}

CHLEntState48 *HLPEBaseline(I64 num)
{
	if (num < 0 || num >= HLNET_MAX_ENTS)
		return &hl_pe_zero;

	return &hl_net_bl48[num];
}

Bool HLPEIsPlayer(I64 num)
{
	if (hl_net48_players < 1)
		return FALSE;

	return ToBool(num >= 1 && num <= hl_net48_players);
}

Bool HLPEFrameAppend(CHLFrame48 *f, I64 num, CHLEntState48 *e)
{
	if (!f || !e || f->count >= HLPE_MAX_ENTS)
		return FALSE;

	f->num[f->count] = num;
	HLState48Copy(&f->ent[f->count], e);
	f->count++;

	return TRUE;
}

U0 HLPEWriteHeader(CHLMsg *m, I64 num, I64 *numbase, Bool remove, Bool custom,
	Bool full)
{
	I64 off;

	if (!m || !numbase)
		return;

	off = num - *numbase;

	if (off >= 1 && off <= HLPE_OFF_MAX)
	{
		HLBitWriteBits(m, 1, 1);
		HLBitWriteBits(m, off, HLPE_OFF_BITS);
	}
	else
	{
		HLBitWriteBits(m, 0, 1);
		HLBitWriteBits(m, num, HLPE_NUM_BITS);
	}

	*numbase = num;

	if (remove)
	{
		HLBitWriteBits(m, 1, 1);
		return;
	}

	HLBitWriteBits(m, 0, 1);

	if (custom)
		HLBitWriteBits(m, 1, 1);
	else
		HLBitWriteBits(m, 0, 1);

	if (full)
		HLBitWriteBits(m, 0, 1);
}

U0 HLPEWriteEnd(CHLMsg *m, Bool zero_end)
{
	if (!m)
		return;

	if (zero_end)
	{
		HLBitWriteBits(m, 0, 16);
		return;
	}

	HLBitWriteBits(m, 1, 1);
	HLBitWriteBits(m, HLPE_OFF_END, HLPE_OFF_BITS);
}

I64 HLPEReadHeader(CHLMsg *m, I64 *numbase, I64 *_num, Bool *_remove,
	Bool *_custom, Bool full, Bool zero_end)
{//1 a header was decoded, 0 end of block, -1 malformed
	I64	 form;
	I64	 off;
	I64	 num;
	I64	 save;
	I64	 peek;
	Bool rem;

	if (!m || !numbase || !_num || !_remove || !_custom)
		return -1;

	*_num    = 0;
	*_remove = FALSE;
	*_custom = FALSE;

	if (zero_end)
	{
		save = m->rbit;
		peek = HLBitReadBits(m, 16);
		m->rbit = save;

		if (m->badread)
			return -1;

		if (!peek)
		{
			HLBitReadBits(m, 16);
			return 0;
		}
	}

	form = HLBitReadBits(m, 1);

	if (form)
	{
		off = HLBitReadBits(m, HLPE_OFF_BITS);

		if (m->badread)
			return -1;

		if (off == HLPE_OFF_END)
			return 0;

		num = *numbase + off;
	}
	else
	{
		num = HLBitReadBits(m, HLPE_NUM_BITS);

		if (m->badread)
			return -1;
	}

	if (num < 0 || num >= HLPE_MAX_NUM)
		return -1;

	*numbase = num;
	*_num    = num;

	rem = ToBool(HLBitReadBits(m, 1) != 0);
	*_remove = rem;

	if (!rem)
	{
		*_custom = ToBool(HLBitReadBits(m, 1) != 0);

		if (full)
		{
			if (HLBitReadBits(m, 1))
				HLBitReadBits(m, 6);
		}
	}

	if (m->badread)
		return -1;

	return 1;
}

Bool HLNetWritePacketEntities(CHLMsg *m, CHLFrame48 *from, CHLFrame48 *to,
	I64 delta_seq, F64 timebase)
{
	I64				oldi;
	I64				newi;
	I64				numbase;
	I64				newnum;
	I64				oldnum;
	Bool			full;
	CHLEntState48	*base;
	CHLEntState48	*cur;

	if (!m || !to)
		return FALSE;

	full = ToBool(from == NULL);

	if (to->count > 0 && to->num[0] == 0)
	{
		HLLog("net: entity 0 in a packet entities frame\n");
		HLLogFlush;
		return FALSE;
	}

	if (!full && from->count > 0 && from->num[0] == 0)
	{
		HLLog("net: entity 0 in the reference frame\n");
		HLLogFlush;
		return FALSE;
	}

	if (full)
		HLMsgWriteByte(m, HLSVC_PACKETENTITIES);
	else
		HLMsgWriteByte(m, HLSVC_DELTAPACKETENTITIES);

	HLMsgWriteShort(m, to->count);

	if (!full)
		HLMsgWriteByte(m, delta_seq & 0xFF);

	HLBitWriteStart(m);

	oldi    = 0;
	newi    = 0;
	numbase = 0;

	while (TRUE)
	{
		newnum = HLPE_MAX_NUM;
		oldnum = HLPE_MAX_NUM;

		if (newi < to->count)
			newnum = to->num[newi];

		if (!full && oldi < from->count)
			oldnum = from->num[oldi];

		if (newnum >= HLPE_MAX_NUM && oldnum >= HLPE_MAX_NUM)
			break;

		if (newnum == oldnum)
		{
			base = &from->ent[oldi];
			cur  = &to->ent[newi];

			if (HLDeltaAnyChange(HLDeltaForEnt(cur), base->v, cur->v, NULL,
				NULL))
			{
				HLPEWriteHeader(m, newnum, &numbase, FALSE, cur->custom, full);
				HLDeltaWrite(m, HLDeltaForEnt(cur), base->v, cur->v, NULL, NULL,
					timebase);
			}

			oldi++;
			newi++;
		}
		else if (newnum < oldnum)
		{
			cur  = &to->ent[newi];
			base = HLPEBaseline(newnum);

			HLPEWriteHeader(m, newnum, &numbase, FALSE, cur->custom, full);
			HLDeltaWrite(m, HLDeltaForEnt(cur), base->v, cur->v, NULL, NULL,
				timebase);

			newi++;
		}
		else
		{
			HLPEWriteHeader(m, oldnum, &numbase, TRUE, FALSE, full);
			oldi++;
		}

		if (m->overflowed)
			return FALSE;
	}

	HLPEWriteEnd(m, TRUE);
	HLBitWriteEnd(m);

	return ToBool(!m->overflowed);
}

Bool HLNetReadPacketEntities(CHLMsg *m, CHLFrame48 *from, CHLFrame48 *to,
	Bool full, F64 timebase)
{
	I64				oldi;
	I64				numbase;
	I64				num;
	I64				prev;
	I64				declared;
	I64				r;
	Bool			remove;
	Bool			custom;
	CHLEntState48	*base;
	CHLEntState48	*tmp;

	if (!m || !to)
		return FALSE;

	tmp = &hl_pe_tmp;

	declared = HLMsgReadShort(m);

	if (!full)
		HLMsgReadByte(m);

	if (m->badread)
		return FALSE;

	to->count = 0;
	oldi      = 0;
	numbase   = 0;
	prev      = -1;

	HLBitReadStart(m);

	while (TRUE)
	{
		r = HLPEReadHeader(m, &numbase, &num, &remove, &custom, full, TRUE);

		if (r < 0)
			return FALSE;

		if (!r)
			break;

		if (num <= prev)
		{
			HLLog("net: packet entities out of order\n");
			HLLogFlush;
			return FALSE;
		}

		prev = num;

		if (from)
		{
			while (oldi < from->count && from->num[oldi] < num)
			{
				if (!HLPEFrameAppend(to, from->num[oldi], &from->ent[oldi]))
					return FALSE;

				oldi++;
			}
		}

		base = NULL;

		if (from && oldi < from->count && from->num[oldi] == num)
		{
			base = &from->ent[oldi];
			oldi++;
		}

		if (!base)
			base = HLPEBaseline(num);

		if (remove)
			goto qpe_next;

		HLState48Copy(tmp, base);
		tmp->custom  = custom;
		tmp->player  = HLPEIsPlayer(num);
		tmp->active  = TRUE;
		tmp->msgtime = timebase;

		if (!HLDeltaRead(m, HLDeltaForEnt(tmp), tmp->v, NULL, 0, timebase))
			return FALSE;

		if (!HLPEFrameAppend(to, num, tmp))
			return FALSE;

qpe_next:
	}

	if (from)
	{
		while (oldi < from->count)
		{
			if (!HLPEFrameAppend(to, from->num[oldi], &from->ent[oldi]))
				return FALSE;

			oldi++;
		}
	}

	HLBitReadEnd(m);

	to->msgtime = timebase;

	if (declared != to->count)
	{
		HLLog("net: packet entities count disagrees with the stream\n");
		HLLogFlush;
	}

	return ToBool(!m->badread);
}

U0 HLPEFrameToEntTable(CHLFrame48 *f)
{
	I64 i;
	I64 num;

	for (i = 0; i < HLNET_MAX_ENTS; i++)
		hl_net_cl48[i].active = FALSE;

	if (!f)
		return;

	for (i = 0; i < f->count; i++)
	{
		num = f->num[i];

		if (num < 0 || num >= HLNET_MAX_ENTS)
			goto qpt_next;

		HLState48Copy(&hl_net_cl48[num], &f->ent[i]);

qpt_next:
	}
}

Bool HLNetParsePacketEntities48(CHLMsg *m, Bool is_delta, I64 seq, F64 timebase)
{
	CHLFrame48	*from;
	CHLFrame48	*slot;
	I64			 dseq;

	if (!m)
		return FALSE;

	from = NULL;

	if (is_delta)
	{
		if (m->read + 3 > m->len)
		{
			m->badread = TRUE;
			return FALSE;
		}

		dseq = m->data[m->read + 2];
		from = HLPEFrameByLowByte(hl_pe_cl, dseq);

		if (!from)
		{
			HLLog("net: delta packet entities against a frame that is gone\n");
			HLLogFlush;
			return FALSE;
		}
	}

	HLPEFrameClear(&hl_pe_stage);

	if (!HLNetReadPacketEntities(m, from, &hl_pe_stage, ToBool(!is_delta),
		timebase))
		return FALSE;

	hl_pe_stage.seq   = seq;
	hl_pe_stage.valid = TRUE;

	slot = HLPEFrameSlot(hl_pe_cl, seq);
	HLPEFrameCopy(slot, &hl_pe_stage);
	HLPEFrameToEntTable(slot);

	return TRUE;
}

Bool HLNetWriteSpawnBaseline(CHLMsg *m, CHLEntState48 *tbl, I64 count,
	F64 timebase)
{
	I64	i;
	I64	numbase;

	if (!m || !tbl)
		return FALSE;

	if (count > HLNET_MAX_ENTS)
		count = HLNET_MAX_ENTS;

	HLMsgWriteByte(m, HLSVC_SPAWNBASELINE);
	HLBitWriteStart(m);

	numbase = 0;

	for (i = 0; i < count; i++)
	{
		if (!tbl[i].active)
			goto qbl_next;

		HLPEWriteHeader(m, i, &numbase, FALSE, tbl[i].custom, FALSE);
		HLDeltaWrite(m, HLDeltaForEnt(&tbl[i]), hl_pe_zero.v, tbl[i].v, NULL,
			NULL, timebase);

		if (m->overflowed)
			return FALSE;

qbl_next:
	}

	HLPEWriteEnd(m, FALSE);
	HLBitWriteEnd(m);

	return ToBool(!m->overflowed);
}

Bool HLNetReadSpawnBaseline(CHLMsg *m, F64 timebase)
{
	I64				numbase;
	I64				num;
	I64				prev;
	I64				r;
	Bool			remove;
	Bool			custom;
	CHLEntState48	*e;

	if (!m)
		return FALSE;

	numbase = 0;
	prev    = -1;

	HLBitReadStart(m);

	while (TRUE)
	{
		r = HLPEReadHeader(m, &numbase, &num, &remove, &custom, FALSE, FALSE);

		if (r < 0)
			return FALSE;

		if (!r)
			break;

		if (num <= prev)
		{
			HLLog("net: spawnbaseline out of order\n");
			HLLogFlush;
			return FALSE;
		}

		prev = num;

		if (remove)
		{
			HLLog("net: removal bit in spawnbaseline\n");
			HLLogFlush;
			return FALSE;
		}

		if (num < HLNET_MAX_ENTS)
			e = &hl_net_bl48[num];
		else
			e = &hl_pe_scratch;

		HLState48Clear(e);
		e->custom  = custom;
		e->player  = HLPEIsPlayer(num);
		e->active  = TRUE;
		e->msgtime = timebase;

		if (!HLDeltaRead(m, HLDeltaForEnt(e), e->v, NULL, 0, timebase))
			return FALSE;
	}

	HLBitReadEnd(m);

	return ToBool(!m->badread);
}


#define HLMV_FLOATS			24
#define HLMV_PRE_FLOATS		16

#define HLMV_GRAVITY		0
#define HLMV_STOPSPEED		1
#define HLMV_MAXSPEED		2
#define HLMV_SPECTATORMAX	3
#define HLMV_ACCELERATE		4
#define HLMV_AIRACCELERATE	5
#define HLMV_WATERACCEL		6
#define HLMV_FRICTION		7
#define HLMV_EDGEFRICTION	8
#define HLMV_WATERFRICTION	9
#define HLMV_ENTGRAVITY		10
#define HLMV_BOUNCE			11
#define HLMV_STEPSIZE		12
#define HLMV_MAXVELOCITY	13
#define HLMV_ZMAX			14
#define HLMV_WAVEHEIGHT		15
#define HLMV_ROLLANGLE		16
#define HLMV_ROLLSPEED		17
#define HLMV_SKYCOLOR_R		18
#define HLMV_SKYCOLOR_G		19
#define HLMV_SKYCOLOR_B		20
#define HLMV_SKYVEC_X		21
#define HLMV_SKYVEC_Y		22
#define HLMV_SKYVEC_Z		23

#define HLMV_SKYNAME_LEN	32		//char skyName[32], pm_movevars.h:34

class CHLMoveVars48
{
	F64		v[HLMV_FLOATS];
	Bool	footsteps;
	U8		skyname[HLMV_SKYNAME_LEN];
};

CHLMoveVars48	hl_movevars48;

U0 HLMoveVars48Clear(CHLMoveVars48 *mv)
{
	I64 i;

	if (!mv)
		return;

	for (i = 0; i < HLMV_FLOATS; i++)
		mv->v[i] = 0.0;

	mv->footsteps  = FALSE;
	mv->skyname[0] = 0;
}

U0 HLMoveVars48Defaults(CHLMoveVars48 *mv)
{
	if (!mv)
		return;

	HLMoveVars48Clear(mv);

	mv->v[HLMV_GRAVITY]      = 800.0;
	mv->v[HLMV_STOPSPEED]    = 100.0;
	mv->v[HLMV_MAXSPEED]     = 320.0;
	mv->v[HLMV_SPECTATORMAX] = 500.0;
	mv->v[HLMV_ACCELERATE]   = 10.0;
	mv->v[HLMV_AIRACCELERATE] = 10.0;
	mv->v[HLMV_WATERACCEL]   = 10.0;
	mv->v[HLMV_FRICTION]     = 4.0;
	mv->v[HLMV_EDGEFRICTION] = 2.0;
	mv->v[HLMV_WATERFRICTION] = 1.0;
	mv->v[HLMV_ENTGRAVITY]   = 1.0;
	mv->v[HLMV_BOUNCE]       = 1.0;
	mv->v[HLMV_STEPSIZE]     = 18.0;
	mv->v[HLMV_MAXVELOCITY]  = 2000.0;
	mv->v[HLMV_ZMAX]         = 4096.0;
	mv->v[HLMV_ROLLANGLE]    = 2.0;
	mv->v[HLMV_ROLLSPEED]    = 200.0;
	mv->v[HLMV_SKYCOLOR_R]   = 0.0;
	mv->v[HLMV_SKYCOLOR_G]   = 0.0;
	mv->v[HLMV_SKYCOLOR_B]   = 0.0;
	mv->v[HLMV_SKYVEC_X]     = 0.0;
	mv->v[HLMV_SKYVEC_Y]     = 0.0;
	mv->v[HLMV_SKYVEC_Z]     = 0.0;
	mv->footsteps            = TRUE;
	mv->skyname[0]           = 0;
}

U0 HLMoveVars48Init()
{
	HLMoveVars48Defaults(&hl_movevars48);
}

HLMoveVars48Init;

U0 HLNetWriteMoveVars48(CHLMsg *m, CHLMoveVars48 *mv)
{
	I64 i;

	if (!m || !mv)
		return;

	HLMsgWriteByte(m, HLSVC_NEWMOVEVARS);

	for (i = 0; i < HLMV_PRE_FLOATS; i++)
		HLMsgWriteFloat(m, mv->v[i]);

	if (mv->footsteps)
		HLMsgWriteByte(m, 1);
	else
		HLMsgWriteByte(m, 0);

	HLMsgWriteString(m, mv->skyname);

	for (i = HLMV_PRE_FLOATS; i < HLMV_FLOATS; i++)
		HLMsgWriteFloat(m, mv->v[i]);
}

Bool HLNetReadMoveVars48(CHLMsg *m, CHLMoveVars48 *mv)
{
	I64 i;

	if (!m || !mv)
		return FALSE;

	for (i = 0; i < HLMV_PRE_FLOATS; i++)
		mv->v[i] = HLMsgReadFloat(m);

	mv->footsteps = ToBool(HLMsgReadByte(m) != 0);

	HLMsgReadString(m, mv->skyname, HLMV_SKYNAME_LEN);

	for (i = HLMV_PRE_FLOATS; i < HLMV_FLOATS; i++)
		mv->v[i] = HLMsgReadFloat(m);

	return ToBool(!m->badread);
}


#define HLUSERMSG_MAX		192		//64..255
#define HLUSERMSG_NAME		20		//svc_newusermsg carries 16, plus NUL
#define HLUSERMSG_MAX_BODY	192

class CHLUserMsg
{
	U8	 name[HLUSERMSG_NAME];
	I64	 size;			//-1 = variable length, leading byte
	Bool used;
	I64	 count;
	I64	 body_len;
	U8	 body[HLUSERMSG_MAX_BODY];
};

CHLUserMsg	hl_usermsg[HLUSERMSG_MAX];
I64			hl_usermsg_count = 0;
I64			hl_usermsg_unknown = 0;

U0 HLUserMsgClear()
{
	I64 i;

	for (i = 0; i < HLUSERMSG_MAX; i++)
	{
		hl_usermsg[i].name[0]  = 0;
		hl_usermsg[i].size     = -1;
		hl_usermsg[i].used     = FALSE;
		hl_usermsg[i].count    = 0;
		hl_usermsg[i].body_len = 0;
	}

	hl_usermsg_count   = 0;
	hl_usermsg_unknown = 0;
}

HLUserMsgClear;

Bool HLUserMsgRegister(I64 num, I64 size, U8 *name)
{
	I64 idx;

	if (num < HLUSERMSG_FIRST || num > 255)
		return FALSE;

	idx = num - HLUSERMSG_FIRST;

	if (!hl_usermsg[idx].used)
		hl_usermsg_count++;

	HLStrCopy(hl_usermsg[idx].name, name, HLUSERMSG_NAME);

	//0xFF on the wire means variable length
	if (size == 255)
		size = -1;

	hl_usermsg[idx].size = size;
	hl_usermsg[idx].used = TRUE;

	return TRUE;
}

I64 HLUserMsgFind(U8 *name)
{
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = 0; i < HLUSERMSG_MAX; i++)
	{
		if (hl_usermsg[i].used && !StrCompare(hl_usermsg[i].name, name))
			return i + HLUSERMSG_FIRST;
	}

	return -1;
}

CHLUserMsg *HLUserMsgGet(I64 num)
{
	if (num < HLUSERMSG_FIRST || num > 255)
		return NULL;

	if (!hl_usermsg[num - HLUSERMSG_FIRST].used)
		return NULL;

	return &hl_usermsg[num - HLUSERMSG_FIRST];
}
