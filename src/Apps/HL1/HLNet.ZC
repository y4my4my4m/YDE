U0 HLDeltaAdd(CHLDelta *d, I64 slot, I64 type, I64 bits, F64 scale,
	F64 post, U8 *name)
{
	CHLDeltaField *f;

	if (!d || d->count >= HLDELTA_MAX_FIELDS)
		return;

	f = &d->f[d->count];
	f->slot  = slot;
	f->type  = type;
	f->bits  = bits;
	f->scale = scale;
	f->post  = post;
	HLStrCopy(f->name, name, 24);

	d->count++;
}

U0 HLDeltaClear(CHLDelta *d, U8 *name)
{
	d->count = 0;
	HLStrCopy(d->name, name, 24);
}

