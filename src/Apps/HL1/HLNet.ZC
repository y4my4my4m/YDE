#define HLDT_SIGNED			0x80000000
#define HLDT_TYPEMASK		0x7FFFFFFF

#define HLDELTA_MAX_SLOTS	64
#define HLDELTA_MAX_FIELDS	64

class CHLDeltaField
{
	I64	slot;
	I64	type;
	I64	bits;
	F64	scale;
	F64	post;		//DEFINE_DELTA_POST postmultiply, 0.0 = none
	U8	name[24];
};

class CHLDelta
{
	CHLDeltaField	f[HLDELTA_MAX_FIELDS];
	I64				count;
	U8				name[24];
};

