U0 HLDeltaInitPlayer()
{
	CHLDelta *d = &hl_delta_player;

	HLDeltaClear(d, "entity_state_player_t");

	HLDeltaAdd(d, HLES_ANIMTIME, HLDT_TIMEWINDOW_8, 8, 1.0, 0.0, "animtime");
	HLDeltaAdd(d, HLES_FRAME, HLDT_FLOAT, 8, 1.0, 0.0, "frame");
	HLDeltaAdd(d, HLES_ORIGIN + 0, HLDT_SIGNED | HLDT_FLOAT, 18, 32.0, 0.0,
		"origin[0]");
