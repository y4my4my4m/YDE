F64		hl_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		hl_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		hl_opt_res			= 0;		//index into hl_res_w / hl_res_h
Bool	hl_opt_fullscreen	= TRUE;
