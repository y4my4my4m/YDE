// HLMenu.ZC - main menu, console, and the game state machine
//
// Engine side, not QuakeC. The main menu follows HL's VGUI layout: a tiled
// photographic backdrop from resource/background, a left-aligned item column,
// and the selected item's help text to its right. Dialogs are laid out on the
// coordinates in valve/resource/*.res, scaled from the 800x600 space that art
// is authored in. The help page keeps the Quake plaque furniture; valve/ has
// no art for it and VGUI replaced it wholesale.

#define HLST_MENU		0
#define HLST_PLAYING		1
#define HLST_CONSOLE		2

//Main menu items, in resource/GameMenu.res order - keys 1, 5, 7, 8, 9, 14,
//15, 18, 19, 20, 21. Labels and help text are the shipped English strings
//from resource/gameui_english.txt.
//
//GameMenu.res key 17, ChangeGame, is absent: it carries notsteam and this
//port has no mod switcher dialog. The "game" console command sets hl_game_dir.
//
//Visibility is the three res flags. OnlyInGame hides the row outside a map,
//notsingle hides it while a single player game runs, notmulti hides it while
//a multiplayer game runs. The visible list is built per frame by HLMenuItems
//and hl_menu_row indexes that list, not this table.
#define HLITEM_RESUME	0
#define HLITEM_PLAYERS	1
#define HLITEM_NEWGAME	2
#define HLITEM_SAVE		3
#define HLITEM_LOAD		4
#define HLITEM_FIND		5
#define HLITEM_CREATE	6
#define HLITEM_OPTIONS	7
#define HLITEM_DISCONNECT 8
#define HLITEM_LEAVE		9
#define HLITEM_QUIT		10
#define HLITEM_MAX		11

//Item column, as fractions of the canvas. VGUI positions in 640x480 units and
//scales; fixed pixels would push the column off a 320x240 canvas.
#define HLMENU_COL_X		0.15
#define HLMENU_COL_Y		0.37
#define HLMENU_HINT_X	0.45
#define HLMENU_PITCH		2.00	//row pitch in glyph heights

//Submenu furniture, unchanged from the Quake page layout.
#define HLMENU_X			72
#define HLMENU_Y			32
#define HLMENU_ROW_H		20
#define HLMENU_CURSOR_X	54

#define HLCON_LINES		24
#define HLCON_WIDTH		40
#define HLCON_HEIGHT		128		//console drops down this far

//current page. One page per shipped dialog; the Quake MULTIPLAYER, SETUP,
//LANCONFIG and GAMEOPT pages are gone - HL's main menu reaches the server
//browser and Create Server directly and keeps player setup in Options.
#define HLPAGE_MAIN		0
#define HLPAGE_OPTIONS	1
#define HLPAGE_NOTICE	2
#define HLPAGE_HELP		3
#define HLPAGE_SINGLE	4
#define HLPAGE_KEYS		5
#define HLPAGE_NEWGAME	6
#define HLPAGE_LOADGAME	7
#define HLPAGE_SAVEGAME	8
#define HLPAGE_BROWSER	9	//OpenServerBrowser
#define HLPAGE_CREATE	10	//CreateMultiplayerGameServerPage
#define HLPAGE_RULES		11	//CreateMultiplayerGameGameplayPage
#define HLPAGE_MPSETUP	12	//OptionsSubMultiplayer, opened full screen
#define HLPAGE_MPADV		13	//MultiplayerAdvancedDialog
#define HLPAGE_SPRAY		14	//SpraypaintList, its own picker here
#define HLPAGE_PLAYERS	15	//PlayerListDialog

//resource/*.res dialog geometry is authored in the 800x600 space the background
//art uses: LoadGameDialog alone is 152+508 wide, past 640.
#define HLDLG_W			800
#define HLDLG_H			600

//HL keeps an unbounded save list. Eight slots, named so slot 0 is the file the
//single-slot path already wrote.
#define HLSAVE_SLOTS		8
#define HLSAVE_NAME_MAX	48

//NewGameDialog's Difficulty combo. skill 1/2/3; "default" "1" is Medium.
#define HLSKILL_EASY		0
#define HLSKILL_MEDIUM	1
#define HLSKILL_HARD		2
#define HLSKILL_ROWS		3

//M_Menu_SinglePlayer_f's rows, in the original's order
#define HLSP_NEWGAME		0
#define HLSP_LOAD		1
#define HLSP_SAVE		2
#define HLSP_ROWS		3

I64  hl_sp_row       = 0;
Bool hl_menu_save_req = FALSE;	//polled by the main loop, it owns save/load
Bool hl_menu_load_req = FALSE;

//CBasePlayer's flashlight, impulse 100. EF_DIMLIGHT is a projected spot in
//the retail client and this renderer has none, so the beam is a dlight parked
//ahead of the eye and refreshed once a frame. m_iFlashBattery drains and
//recharges on the SDK's two clocks.
#define HLFLASH_DRAIN	1.2		//FLASH_DRAIN_TIME, seconds per unit spent
#define HLFLASH_CHARGE	0.2		//FLASH_CHARGE_TIME, seconds per unit regained
#define HLFLASH_RADIUS	220.0	//dlight radius, no SDK counterpart
#define HLFLASH_AHEAD	72.0	//how far down the view ray the beam lands

Bool hl_flash_on		= FALSE;
I64  hl_flash_battery	= 100;
F64  hl_flash_next		= 0.0;	//next drain or charge tick, wall clock

//CBasePlayer::m_pLastItem, for lastinv. HLWeaponSetActive does not record the
//weapon it holstered, so the swap is noticed once a frame instead.
I64  hl_con_wpn_seen	= -1;	//what hl_wpn_active was at the last sample
I64  hl_con_wpn_prev	= -1;	//the one before that

//ClientCommand "fov" reports the live value. hl_fov lives in the shell, which
//compiles after this file and clears the request once it has applied it, so
//the last value asked for is shadowed here.
F64  hl_con_fov_last	= 90.0;

//M_Help's NUM_HELP_PAGES. help0..help5.lmp are in PAK0 on both releases - the
//pages are the ordering info, which is why the row reads HELP/ORDERING either
//way. that label is baked into gfx/mainmenu.lmp, not gated on a version
#define HLHELP_PAGES		6

//--- server browser ---------------------------------------------------------
//
// The Internet and LAN tabs of the server browser. The shipped ServerBrowser
// dialog is not in valve/resource - it lives in the Steam client's own
// ServerBrowser.dll - so the columns follow the four the game's list shows:
// server name, map, players, ping.
#define HLBR_TAB_INTERNET	0
#define HLBR_TAB_LAN		1
#define HLBR_TAB_COUNT		2

//sort keys, in column order
#define HLBR_SORT_NAME		0
#define HLBR_SORT_MAP		1
#define HLBR_SORT_PLAYERS	2
#define HLBR_SORT_PING		3
#define HLBR_SORT_COUNT		4

//rows above the list: the tab strip, then Refresh, then the address field
#define HLBR_STRIP		0
#define HLBR_REFRESH		1
#define HLBR_ADDRESS		2
#define HLBR_HEAD		3	//first list row; rows past this index the list

//--- create server ----------------------------------------------------------
//
// CreateMultiplayerGameServerPage.res is the first tab: MapList combo at
// 66,28 and Label1 "#Valve_Listen_MapName" at 28,28. The remaining fields are
// the STRING and NUMBER entries of valve/settings.scr's SERVER_OPTIONS block,
// which is what the dialog's second tab feeds from.
#define HLCS_MAP			0
#define HLCS_HOSTNAME	1	//hostname, settings.scr
#define HLCS_MAXPLAYERS	2	//maxplayers, NUMBER 1..32
#define HLCS_PASSWORD	3	//sv_password
#define HLCS_RULES		4	//opens the gameplay page
#define HLCS_START		5
#define HLCS_ROWS		6

//CreateMultiplayerGameGameplayPage.res is a CPanelListPanel filled from
//settings.scr at runtime, so the row order below is that file's order.
#define HLR_TEAMLIST		0	//mp_teamlist, STRING
#define HLR_FRAGLIMIT	1	//mp_fraglimit, NUMBER 0..
#define HLR_TIMELIMIT	2	//mp_timelimit, NUMBER 0.. minutes
#define HLR_FALLDAMAGE	3	//mp_falldamage, LIST Normal/Realistic
#define HLR_TEAMPLAY		4	//mp_teamplay, BOOL
#define HLR_FRIENDLYFIRE	5	//mp_friendlyfire, BOOL
#define HLR_WEAPONSTAY	6	//mp_weaponstay, BOOL
#define HLR_FORCERESPAWN	7	//mp_forcerespawn, BOOL
#define HLR_FOOTSTEPS	8	//mp_footsteps, BOOL, defaults on
#define HLR_FLASHLIGHT	9	//mp_flashlight, BOOL
#define HLR_AUTOCROSSHAIR 10	//mp_autocrosshair, BOOL
#define HLR_CLOSE		11
#define HLR_ROWS			12

//--- player setup -----------------------------------------------------------
//
// OptionsSubMultiplayer.res, in its tabPosition order: NameEntry 1,
// "Player model" 2, Primary Color Slider 3, Secondary Color Slider 4,
// SpraypaintList 5, SpraypaintColor 6, Advanced 7. High Quality Models is
// tabPosition 5 with visible 0 and enabled 0 in the shipped file; it is drawn
// here because this renderer has both model sets.
#define HLPS_NAME		0
#define HLPS_MODEL		1
#define HLPS_PRIMARY		2
#define HLPS_SECONDARY	3
#define HLPS_SPRAY		4
#define HLPS_SPRAYCOLOR	5
#define HLPS_HIMODELS	6
#define HLPS_ADVANCED	7
#define HLPS_CLOSE		8
#define HLPS_ROWS		9

//MultiplayerAdvancedDialog.res is a CPanelListPanel filled from
//valve/user.scr, whose INFO_OPTIONS block holds one entry.
#define HLADV_DECALS		0	//mp_decals, NUMBER 0..4096, default 300
#define HLADV_CLOSE		1
#define HLADV_ROWS		2

//M_Options_Draw's rows, in its order. resolution, screen and gun depth are
//ours - the original has no windowed video to configure
//--- key bindings -----------------------------------------------------------
//
// keys.c's keybindings[256]: one command string per key, and any number of
// keys may carry the same command. Key_SetBinding writes it, Key_Event walks
// it, and bind / unbind / unbindall edit it.
//
// The key space is the ZealOS scan code - kbd.down_bitmap is 256 bits indexed
// by the bare scan code - with the mouse buttons and the wheel appended above
// it. gfx/shell/kb_def.lst binds MOUSE1, MOUSE2, MWHEELUP and MWHEELDOWN, and
// those are HL keynums, not scan codes.
#define HLKEY_MOUSE1		0x100
#define HLKEY_MOUSE2		0x101
#define HLKEY_MOUSE3		0x102
#define HLKEY_MOUSE4		0x103
#define HLKEY_MOUSE5		0x104
#define HLKEY_MWHEELUP		0x105
#define HLKEY_MWHEELDOWN	0x106
#define HLKEY_MAX			0x107

//longest command the shipped files bind is "+voicerecord"; config.cfg's
//"quit prompt" and "save quick" are shorter still
#define HLKEY_CMD_MAX		40

//Flat fixed stride, not a U8 *table[]: adjacent string literals concatenate
//and truncate at the first NUL, which collapses such a table to one entry.
U8		hl_key_bind[HLKEY_MAX * HLKEY_CMD_MAX];
Bool	hl_key_held[HLKEY_MAX];

//--- held actions -----------------------------------------------------------
//
// One kbutton_t per +command. A command may sit on two keys at once - kb_def
// binds both w and UPARROW to +forward - so the press count is kept rather
// than a flag: releasing one key must not clear a state the other still holds.
// hl_in_state mirrors the counts as the bitfield the frame loop reads.
#define HLIN_FORWARD		0
#define HLIN_BACK		1
#define HLIN_LEFT		2	//+left, turn left
#define HLIN_RIGHT		3
#define HLIN_MOVELEFT	4	//+moveleft, strafe
#define HLIN_MOVERIGHT	5
#define HLIN_JUMP		6
#define HLIN_DUCK		7
#define HLIN_SPEED		8
#define HLIN_USE			9
#define HLIN_ATTACK		10
#define HLIN_ATTACK2		11
#define HLIN_RELOAD		12
#define HLIN_SCORE		13	//+showscores
#define HLIN_LOOKUP		14
#define HLIN_LOOKDOWN	15
#define HLIN_KLOOK		16
#define HLIN_STRAFE		17
#define HLIN_MOVEUP		18
#define HLIN_MOVEDOWN	19
#define HLIN_MLOOK		20
#define HLIN_VOICE		21	//+voicerecord, accepted and inert
#define HLIN_COUNT		22

I64		hl_in_count[HLIN_COUNT];
I64		hl_in_state;

//One-shot requests, set on the press edge and cleared by whoever services
//them. The frame loop and HLWeapon.ZC read these instead of scan codes.
I64		hl_in_slot_want;		//slot1..slot5 as 1..5, 0 for none
I64		hl_in_cycle_want;		//invnext +1, invprev -1, 0 for none
Bool	hl_in_lastinv_want;
Bool	hl_in_centerview_want;
I64		hl_in_msg_want;		//1 messagemode, 2 messagemode2, 0 none

//HLWeapon.ZC compiles before this file and reads 1-5, q, z and r off the
//keyboard itself, so it cannot see this table. While that holds, an action it
//would also service off the same scan code is left to it rather than fired
//twice. Clear this once HLWeapon.ZC reads hl_in_state and the want flags.
Bool	hl_in_wpn_direct;

//kb_act.lst lists two actions this port has no machinery for. The bind is
//accepted, and the first press says why rather than failing silently.
Bool	hl_in_voice_said;
Bool	hl_in_spray_said;

//Host_Pause_f. The shell stops stepping the server; rendering carries on, as
//it does in the original. Single player only - sv_pausable is 0 on a listen
//server and a guest cannot stop the host's clock.
Bool	hl_paused;

//HLCfgLoad runs BEFORE HLCvarInit, so it parks crosshair here - setting the
//cvar early gets a second entry appended by the init that follows
I64		hl_opt_crosshair	= 1;
I64		hl_keys_row		= 0;
I64		hl_keys_top		= 0;		//first list row on screen
Bool	hl_keys_capture	= FALSE;	//next keypress is the new binding

U8 *HLBindGet(I64 k)
{//the command bound to a key, "" when none. key 0 is never a real scan code,
 //so its slot doubles as the empty string an out-of-range key returns
	if (k <= 0 || k >= HLKEY_MAX)
		return hl_key_bind;

	return hl_key_bind + k * HLKEY_CMD_MAX;
}

U0 HLBindSet(I64 k, U8 *cmd)
{//Key_SetBinding
	if (k <= 0 || k >= HLKEY_MAX)
		return;

	HLStrCopy(hl_key_bind + k * HLKEY_CMD_MAX, cmd, HLKEY_CMD_MAX);
}

U0 HLBindClear(I64 k)
{//Key_Unbind_f's body
	if (k <= 0 || k >= HLKEY_MAX)
		return;

	hl_key_bind[k * HLKEY_CMD_MAX] = 0;
}

U0 HLBindClearAll()
{//Key_Unbindall_f. globals aren't zeroed, so this is also the table's init
	I64 i;

	for (i = 0; i < HLKEY_MAX; i++)
	{
		hl_key_bind[i * HLKEY_CMD_MAX] = 0;
		hl_key_held[i]                 = FALSE;
	}
}

I64 HLKeyFromName(U8 *name)
{//gfx/shell/kb_keys.lst's NAME column to a ZealOS scan code, 0 for none.
 //
 //kb_keys.lst is tab separated - keynum "NAME" "DISPLAY" COLOR - and its
 //keynums are HL's own, unrelated to scan codes, so the name is the join key.
 //Rows named <UNKNOWN KEYNUM> are unassigned and never reach here.
 //
 //The SC_* set is src/Kernel/KernelA.HH. Printable characters go through
 //Char2ScanCode, which returns the shifted position ORed with SCF_SHIFT for
 //'~', '!' and the rest of the upper row; down_bitmap is indexed by the bare
 //scan code, so the flag bits are masked off. A shifted character therefore
 //binds the physical key, which makes '~' and '`' one key, as kb_def.lst
 //already assumes by binding both to toggleconsole.
 //
 //Unmapped by design: KP_*, JOY* and AUX* - the kernel reports the keypad
 //through the same scan codes as the cursor block and has no joystick.
	I64 ch;

	if (!name[0])					return 0;

	if (!StrICompare(name, "TAB"))		return SC_TAB;
	if (!StrICompare(name, "ENTER"))		return SC_ENTER;
	if (!StrICompare(name, "ESCAPE"))	return SC_ESC;
	if (!StrICompare(name, "SPACE"))		return Char2ScanCode(' ') & 0x7F;
	if (!StrICompare(name, "BACKSPACE"))	return SC_BACKSPACE;
	if (!StrICompare(name, "UPARROW"))	return SC_CURSOR_UP;
	if (!StrICompare(name, "DOWNARROW"))	return SC_CURSOR_DOWN;
	if (!StrICompare(name, "LEFTARROW"))	return SC_CURSOR_LEFT;
	if (!StrICompare(name, "RIGHTARROW"))	return SC_CURSOR_RIGHT;
	if (!StrICompare(name, "ALT"))		return SC_ALT;
	if (!StrICompare(name, "CTRL"))		return SC_CTRL;
	if (!StrICompare(name, "SHIFT"))		return SC_SHIFT;
	if (!StrICompare(name, "CAPSLOCK"))	return SC_CAPS;
	if (!StrICompare(name, "INS"))		return SC_INS;
	if (!StrICompare(name, "DEL"))		return SC_DELETE;
	if (!StrICompare(name, "PGDN"))		return SC_PAGE_DOWN;
	if (!StrICompare(name, "PGUP"))		return SC_PAGE_UP;
	if (!StrICompare(name, "HOME"))		return SC_HOME;
	if (!StrICompare(name, "END"))		return SC_END;
	if (!StrICompare(name, "PAUSE"))		return SC_PAUSE;

	if (!StrICompare(name, "F1"))		return SC_F1;
	if (!StrICompare(name, "F2"))		return SC_F2;
	if (!StrICompare(name, "F3"))		return SC_F3;
	if (!StrICompare(name, "F4"))		return SC_F4;
	if (!StrICompare(name, "F5"))		return SC_F5;
	if (!StrICompare(name, "F6"))		return SC_F6;
	if (!StrICompare(name, "F7"))		return SC_F7;
	if (!StrICompare(name, "F8"))		return SC_F8;
	if (!StrICompare(name, "F9"))		return SC_F9;
	if (!StrICompare(name, "F10"))		return SC_F10;
	if (!StrICompare(name, "F11"))		return SC_F11;
	if (!StrICompare(name, "F12"))		return SC_F12;

	if (!StrICompare(name, "MOUSE1"))	return HLKEY_MOUSE1;
	if (!StrICompare(name, "MOUSE2"))	return HLKEY_MOUSE2;
	if (!StrICompare(name, "MOUSE3"))	return HLKEY_MOUSE3;
	if (!StrICompare(name, "MOUSE4"))	return HLKEY_MOUSE4;
	if (!StrICompare(name, "MOUSE5"))	return HLKEY_MOUSE5;
	if (!StrICompare(name, "MWHEELUP"))	return HLKEY_MWHEELUP;
	if (!StrICompare(name, "MWHEELDOWN"))	return HLKEY_MWHEELDOWN;

	//kb_def.lst spells the backslash key "\\", doubled inside the quotes, and
	//COM_ParseFile does not unescape it either - the engine compares the raw
	//two characters against its own key table. Taken as the one key here
	if (name[0] == '\\' && name[1] == '\\' && !name[2])
		return Char2ScanCode('\\') & 0x7F;

	//a single printable character is the key that types it
	if (!name[1])
	{
		ch = name[0];
		if (ch >= 'A' && ch <= 'Z')
			ch += 32;

		return Char2ScanCode(ch) & 0x7F;
	}

	//HLKeyName falls back to 0xNN for a key the mapping cannot spell, and the
	//config it wrote has to load again
	if (name[0] == '0' && (name[1] == 'x' || name[1] == 'X'))
		return Str2I64(name + 2, 16);

	return 0;
}

U0 HLKeyName(U8 *out, I64 k)
{//inverse of HLKeyFromName, in kb_keys.lst's spelling. "" for an unbound slot
	I64 ch;

	if (k <= 0 || k >= HLKEY_MAX)
	{
		out[0] = 0;
		return;
	}

	if (k == SC_TAB)			{ StrPrint(out, "TAB");		return; }
	if (k == SC_ENTER)			{ StrPrint(out, "ENTER");		return; }
	if (k == SC_ESC)			{ StrPrint(out, "ESCAPE");	return; }
	if (k == SC_BACKSPACE)		{ StrPrint(out, "BACKSPACE");	return; }
	if (k == SC_CURSOR_UP)		{ StrPrint(out, "UPARROW");	return; }
	if (k == SC_CURSOR_DOWN)	{ StrPrint(out, "DOWNARROW");	return; }
	if (k == SC_CURSOR_LEFT)	{ StrPrint(out, "LEFTARROW");	return; }
	if (k == SC_CURSOR_RIGHT)	{ StrPrint(out, "RIGHTARROW");	return; }
	if (k == SC_ALT)			{ StrPrint(out, "ALT");		return; }
	if (k == SC_CTRL)			{ StrPrint(out, "CTRL");		return; }
	if (k == SC_SHIFT)			{ StrPrint(out, "SHIFT");		return; }
	if (k == SC_CAPS)			{ StrPrint(out, "CAPSLOCK");	return; }
	if (k == SC_INS)			{ StrPrint(out, "INS");		return; }
	if (k == SC_DELETE)			{ StrPrint(out, "DEL");		return; }
	if (k == SC_PAGE_DOWN)		{ StrPrint(out, "PGDN");		return; }
	if (k == SC_PAGE_UP)		{ StrPrint(out, "PGUP");		return; }
	if (k == SC_HOME)			{ StrPrint(out, "HOME");		return; }
	if (k == SC_END)			{ StrPrint(out, "END");		return; }
	if (k == SC_PAUSE)			{ StrPrint(out, "PAUSE");		return; }

	if (k == SC_F1)		{ StrPrint(out, "F1");	return; }
	if (k == SC_F2)		{ StrPrint(out, "F2");	return; }
	if (k == SC_F3)		{ StrPrint(out, "F3");	return; }
	if (k == SC_F4)		{ StrPrint(out, "F4");	return; }
	if (k == SC_F5)		{ StrPrint(out, "F5");	return; }
	if (k == SC_F6)		{ StrPrint(out, "F6");	return; }
	if (k == SC_F7)		{ StrPrint(out, "F7");	return; }
	if (k == SC_F8)		{ StrPrint(out, "F8");	return; }
	if (k == SC_F9)		{ StrPrint(out, "F9");	return; }
	if (k == SC_F10)		{ StrPrint(out, "F10");	return; }
	if (k == SC_F11)		{ StrPrint(out, "F11");	return; }
	if (k == SC_F12)		{ StrPrint(out, "F12");	return; }

	if (k == HLKEY_MOUSE1)		{ StrPrint(out, "MOUSE1");	return; }
	if (k == HLKEY_MOUSE2)		{ StrPrint(out, "MOUSE2");	return; }
	if (k == HLKEY_MOUSE3)		{ StrPrint(out, "MOUSE3");	return; }
	if (k == HLKEY_MOUSE4)		{ StrPrint(out, "MOUSE4");	return; }
	if (k == HLKEY_MOUSE5)		{ StrPrint(out, "MOUSE5");	return; }
	if (k == HLKEY_MWHEELUP)	{ StrPrint(out, "MWHEELUP");	return; }
	if (k == HLKEY_MWHEELDOWN)	{ StrPrint(out, "MWHEELDOWN");	return; }

	if (k == (Char2ScanCode(' ') & 0x7F))
	{
		StrPrint(out, "SPACE");
		return;
	}

	ch = ScanCode2Char(k);
	if (ch > 32 && ch < 127)
	{
		StrPrint(out, "%c", ch);
		return;
	}

	//a key the mapping has no name for still has to round-trip through the
	//config, so the number stands in and HLKeyFromName is not asked for it
	StrPrint(out, "0x%02X", k);
}

Bool HLInDown(I64 b)
{//the held state of one +command
	if (b < 0 || b >= HLIN_COUNT)
		return FALSE;

	return ToBool(hl_in_count[b] > 0);
}

U0 HLInPublish()
{//mirror the press counts into the bitfield the frame loop reads
	I64 i;

	hl_in_state = 0;

	for (i = 0; i < HLIN_COUNT; i++)
	{
		if (hl_in_count[i] > 0)
			Bts(&hl_in_state, i);
	}
}

U0 HLInClearAll()
{//IN_ClearStates. also the init: globals aren't zeroed
	I64 i;

	for (i = 0; i < HLIN_COUNT; i++)
		hl_in_count[i] = 0;

	hl_in_state           = 0;
	hl_in_slot_want       = 0;
	hl_in_cycle_want      = 0;
	hl_in_lastinv_want    = FALSE;
	hl_in_centerview_want = FALSE;
	hl_in_msg_want        = 0;

	//hl_in_voice_said and hl_in_spray_said are NOT reset here: this runs every
	//frame the menu owns the keyboard, and the notice is meant to appear once
}

I64 HLInBitOf(U8 *cmd)
{//a +command's name, without the sign, to its HLIN_ bit. -1 for none.
 //cl_dll/input.c registers exactly these; +mlook and +voicerecord are held
 //here too so a bind on them is not reported as unknown
	if (!StrICompare(cmd, "forward"))	return HLIN_FORWARD;
	if (!StrICompare(cmd, "back"))		return HLIN_BACK;
	if (!StrICompare(cmd, "left"))		return HLIN_LEFT;
	if (!StrICompare(cmd, "right"))		return HLIN_RIGHT;
	if (!StrICompare(cmd, "moveleft"))	return HLIN_MOVELEFT;
	if (!StrICompare(cmd, "moveright"))	return HLIN_MOVERIGHT;
	if (!StrICompare(cmd, "jump"))		return HLIN_JUMP;
	if (!StrICompare(cmd, "duck"))		return HLIN_DUCK;
	if (!StrICompare(cmd, "speed"))		return HLIN_SPEED;
	if (!StrICompare(cmd, "use"))		return HLIN_USE;
	if (!StrICompare(cmd, "attack"))		return HLIN_ATTACK;
	if (!StrICompare(cmd, "attack2"))	return HLIN_ATTACK2;
	if (!StrICompare(cmd, "reload"))		return HLIN_RELOAD;
	if (!StrICompare(cmd, "showscores"))	return HLIN_SCORE;
	if (!StrICompare(cmd, "lookup"))		return HLIN_LOOKUP;
	if (!StrICompare(cmd, "lookdown"))	return HLIN_LOOKDOWN;
	if (!StrICompare(cmd, "klook"))		return HLIN_KLOOK;
	if (!StrICompare(cmd, "strafe"))		return HLIN_STRAFE;
	if (!StrICompare(cmd, "moveup"))		return HLIN_MOVEUP;
	if (!StrICompare(cmd, "movedown"))	return HLIN_MOVEDOWN;
	if (!StrICompare(cmd, "mlook"))		return HLIN_MLOOK;
	if (!StrICompare(cmd, "voicerecord"))	return HLIN_VOICE;

	return -1;
}

I64 HLBindKeyOfAction(U8 *cmd, I64 nth)
{//the nth key carrying a command, 0 for none. The keyboard page shows two
 //columns because HL does: kb_def.lst gives +forward both w and UPARROW
	I64 k;
	I64 seen = 0;

	if (!cmd[0])
		return 0;

	for (k = 1; k < HLKEY_MAX; k++)
	{
		if (!StrICompare(hl_key_bind + k * HLKEY_CMD_MAX, cmd))
		{
			if (seen == nth)
				return k;
			seen++;
		}
	}

	return 0;
}

Bool HLBindActionDown(U8 *cmd)
{//any key carrying a command held right now, straight off the keyboard.
 //
 //For the handful of commands the shell services in every key_dest, the way
 //Key_Event handles ESCAPE and the console toggle ahead of the bindings.
 //Mouse keys are not tested: the shell owns the mouse latch.
	I64 k;

	for (k = 1; k < 0x100; k++)
	{
		if (!StrICompare(hl_key_bind + k * HLKEY_CMD_MAX, cmd))
		{
			if (Bt(kbd.down_bitmap, k))
				return TRUE;
		}
	}

	return FALSE;
}

//--- the shipped action list ------------------------------------------------
//
// gfx/shell/kb_act.lst, in menu order: two quoted fields per line,
// "command" "#Valve_Token". A command of blank is a divider whose second field
// is either a ========== rule or a #Valve_*_Title section header. 51 lines
// shipped, so the cap is slack.
//
// The label token resolves against resource/valve_english.txt, which is
// UTF-16LE.
#define HLACT_MAX			64
#define HLACT_CMD_MAX		20
#define HLACT_LBL_MAX		44

#define HLACT_ACTION			0
#define HLACT_HEADER			1
#define HLACT_RULE			2

U8		hl_act_cmd[HLACT_MAX * HLACT_CMD_MAX];
U8		hl_act_lbl[HLACT_MAX * HLACT_LBL_MAX];
U8		hl_act_kind[HLACT_MAX];
I64		hl_act_count;
Bool	hl_act_from_file;	//the shipped list loaded, not the compiled-in one

I64 HLQuotedField(U8 *out, U8 *src, I64 i, I64 max)
{//one "quoted" field into out, returning the index just past its closing
 //quote. out is emptied when there is no field left on the line
	I64 n = 0;

	out[0] = 0;

	while (src[i] && src[i] != '"')
		i++;

	if (!src[i])
		return i;

	i++;

	while (src[i] && src[i] != '"')
	{
		if (n < max - 1)
		{
			out[n] = src[i];
			n++;
		}
		i++;
	}

	out[n] = 0;

	if (src[i])
		i++;

	return i;
}

U0 HLActAdd(U8 *cmd, U8 *label, I64 kind)
{//one row of the customize list
	if (hl_act_count >= HLACT_MAX)
		return;

	HLStrCopy(hl_act_cmd + hl_act_count * HLACT_CMD_MAX, cmd, HLACT_CMD_MAX);
	HLStrCopy(hl_act_lbl + hl_act_count * HLACT_LBL_MAX, label, HLACT_LBL_MAX);
	hl_act_kind[hl_act_count] = kind;
	hl_act_count++;
}

U8 *HLLocLoad(I64 *_size)
{//resource/valve_english.txt as plain bytes.
 //
 //The file is UTF-16LE with a BOM. Every label in it is ASCII, so the BOM is
 //skipped and every other byte taken where the high byte is zero; anything
 //else becomes '?' rather than desynchronising the stream.
	U8	*raw;
	U8	*out;
	I64	 size = 0;
	I64	 i;
	I64	 n = 0;

	*_size = 0;

	raw = HLFileLoad("resource/valve_english.txt", &size);
	if (!raw)
		return NULL;

	if (size < 4)
	{
		Free(raw);
		return NULL;
	}

	i = 0;
	if (raw[0] == 0xFF && raw[1] == 0xFE)
		i = 2;

	out = MAlloc(size / 2 + 2);

	while (i + 1 < size)
	{
		if (raw[i + 1])
			out[n] = '?';
		else
			out[n] = raw[i];

		n++;
		i += 2;
	}

	out[n] = 0;
	Free(raw);

	*_size = n;
	return out;
}

U0 HLLocFind(U8 *out, I64 max, U8 *loc, I64 loc_size, U8 *token)
{//"#Valve_Token" to its English string. the token is emitted unchanged when
 //the table is missing or has no entry, so a row is never blank
	U8	pat[64];
	I64	i;
	I64	plen;

	HLStrCopy(out, token, max);

	if (!loc || loc_size <= 0)
		return;

	//quoted, or Valve_Jump matches Valve_Jump_Something first
	StrPrint(pat, "\"%s\"", token);
	plen = StrLen(pat);

	//the table is a couple of hundred kilobytes and this runs once per row, so
	//the opening quote and first character gate the compare
	for (i = 0; i + plen < loc_size; i++)
	{
		if (loc[i] != '"' || loc[i + 1] != pat[1])
			goto qlf_next;

		if (!StrNICompare(loc + i, pat, plen))
		{
			HLQuotedField(out, loc, i + plen, max);
			return;
		}

qlf_next:
	}
}

