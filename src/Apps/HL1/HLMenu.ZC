//S_LocalSound's menu feedback:
//  menu1 - moving the highlight
//  menu2 - entering a page or confirming
//  menu3 - changing a value
//played at the listener with zero attenuation, always full volume
//HL has no misc/menu*.wav - those are quake's. The equivalents live in
//common/ and are what GoldSrc's own UI uses
#define HLMSND_MOVE		"common/wpn_moveselect.wav"
#define HLMSND_ENTER		"common/wpn_select.wav"
#define HLMSND_VALUE		"common/wpn_hudon.wav"

//--- preferences ------------------------------------------------------------
//
// plain text beside the game data, one "key value" per line. not a struct dump
// so it survives fields being added or removed - unknown keys are skipped and
// missing ones keep their default
//
// per-machine state, not source. in .gitignore
#define HLCFG_PATH	"HL1CFG.TXT"

U0 HLSetupDefaults()
{//globals aren't zeroed and HLCfgLoad runs before HLMenuInit, so defaults must
 //land first or a config with no name line leaves junk in the buffer
	//bindings included - a config predating the customize page has no bind
	//lines, and an unset scancode matches nothing
	HLBindDefaults;
	HLHostNameInit;
	HLAliasInit;

	//the host cache is a global table with a global count - unset, slist walks
	//off the end of it before a single reply has arrived
	HLSlistInit;

	//the episode/level tables are globals too - unset, game options reads
	//null map names
	HLGoInit;

	hl_opt_crosshair = 1;

	HLStrCopy(hl_setup_name, "player", 16);
	hl_setup_top     = 0;
	hl_setup_bottom  = 0;
	hl_setup_editing   = FALSE;
	hl_setup_ate_enter = FALSE;
	hl_setup_len       = 6;

	HLStrCopy(hl_lan_addr, "10.0.0.1", 24);
	hl_lan_len       = 8;
	hl_lan_row       = 0;
	hl_lan_editing   = FALSE;
	hl_lan_ate_enter = FALSE;
	hl_mp_start_dm   = FALSE;
	hl_mp_row        = 0;
	hl_set_row       = 0;

	//HLCfgLoad reads this before the archives are mounted
	hl_game_dir[0]   = 0;
}

U0 HLCfgSave()
{//called whenever an option changes
	U8 buf[512];

	StrPrint(buf,
		"sensitivity %d\n"
		"volume %d\n"
		"res %d\n"
		"fullscreen %d\n"
		"gamma %d\n"
		"gunclip %d\n"
		"musicvol %d\n"
		"hostname %s\n"
		"crosshair %d\n"
		"bindfwd %d\n"
		"bindback %d\n"
		"bindleft %d\n"
		"bindright %d\n"
		"bindjump %d\n"
		"bindduck %d\n"
		"binduse %d\n"
		"topcolor %d\n"
		"bottomcolor %d\n"
		"name %s\n"
		"game %s\n",
		ToI64(hl_opt_sensitivity * 1000.0),
		hl_opt_volume,
		hl_opt_res,
		ToI64(hl_opt_fullscreen),
		ToI64(hl_opt_gamma * 1000.0),
		ToI64(hl_opt_gunclip),
		ToI64(hl_music_volume * 1000.0),
		hl_host_name,
		hl_opt_crosshair,
		hl_bind_key[HLBIND_FORWARD],
		hl_bind_key[HLBIND_BACK],
		hl_bind_key[HLBIND_LEFT],
		hl_bind_key[HLBIND_RIGHT],
		hl_bind_key[HLBIND_JUMP],
		hl_bind_key[HLBIND_DUCK],
		hl_bind_key[HLBIND_USE],
		hl_setup_top,
		hl_setup_bottom,
		hl_setup_name,
		hl_game_dir);

	//thousandths, so the file holds no float text to parse
	if (!hl_disk_writes)
		return;

	FileWrite(HLCFG_PATH, buf, StrLen(buf));
}

I64 HLCfgValue(U8 *line)
{//the integer after the first space, or 0
	I64 i = 0;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	return Str2I64(line + i);
}

U0 HLCfgLoad()
{//anything missing or unparsable keeps its default
	U8	*raw;
	U8	 line[128];
	I64	 size = 0;
	I64	 i    = 0;
	I64	 n;
	I64	 v;

	raw = FileRead(HLCFG_PATH, &size);
	if (!raw)
		return;

	while (i < size)
	{
		//bounded line copy
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 127)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qcl_next;

		v = HLCfgValue(line);

		if (!StrNICompare(line, "sensitivity ", 12))
			hl_opt_sensitivity = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "volume ", 7))
			hl_opt_volume = ClampI64(v, 0, 100);
		else if (!StrNICompare(line, "res ", 4))
			hl_opt_res = ClampI64(v, 0, HLRES_COUNT - 1);
		else if (!StrNICompare(line, "gunclip ", 8))
			hl_opt_gunclip = ToBool(v != 0);
		else if (!StrNICompare(line, "musicvol ", 9))
			hl_music_volume = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "hostname ", 9))
			HLStrCopy(hl_host_name, line + 9, 32);
		else if (!StrNICompare(line, "crosshair ", 10))
			hl_opt_crosshair = v;
		else if (!StrNICompare(line, "bindfwd ", 8))
			hl_bind_key[HLBIND_FORWARD] = v;
		else if (!StrNICompare(line, "bindback ", 9))
			hl_bind_key[HLBIND_BACK] = v;
		else if (!StrNICompare(line, "bindleft ", 9))
			hl_bind_key[HLBIND_LEFT] = v;
		else if (!StrNICompare(line, "bindright ", 10))
			hl_bind_key[HLBIND_RIGHT] = v;
		else if (!StrNICompare(line, "bindjump ", 9))
			hl_bind_key[HLBIND_JUMP] = v;
		else if (!StrNICompare(line, "bindduck ", 9))
			hl_bind_key[HLBIND_DUCK] = v;
		else if (!StrNICompare(line, "binduse ", 8))
			hl_bind_key[HLBIND_USE] = v;
		else if (!StrNICompare(line, "topcolor ", 9))
			hl_setup_top = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "bottomcolor ", 12))
			hl_setup_bottom = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "name ", 5))
			HLStrCopy(hl_setup_name, line + 5, 16);
		else if (!StrNICompare(line, "game ", 5))
			HLStrCopy(hl_game_dir, line + 5, 32);
		else if (!StrNICompare(line, "fullscreen ", 11))
			hl_opt_fullscreen = ToBool(v);
		else if (!StrNICompare(line, "gamma ", 6))
			hl_opt_gamma = ToF64(v) / 1000.0;

qcl_next:
	}

	Free(raw);

	//a hand-edited file can hold anything, clamp before pushing to hardware
	if (hl_opt_sensitivity < 0.02)	hl_opt_sensitivity = 0.02;
	if (hl_opt_sensitivity > 0.60)	hl_opt_sensitivity = 0.60;

	//scale the mix, not the AC97 master - that register is system wide
	hl_snd_master = ToF64(hl_opt_volume) / 100.0;
	HLPalSetGamma(hl_opt_gamma);
}

//the menu is authored for 320x200. every fixed coordinate is offset by this
//so the page moves as one block, the same term M_DrawPic adds
#define HLMENU_VW	320

//M_DrawSlider's conchars pieces: 128 left cap, 129 trough, 130 right cap,
//131 handle. range 0..1 positions the handle
#define HLSLIDER_CELLS	10

//resource/BackgroundLayout.txt: twelve tiles on a 4x3 grid at 256 pitch. The
//right column and bottom row are cropped, so the composite is exactly 800x600.
#define HLBG_W		800
#define HLBG_H		600
#define HLBG_PITCH	256

//Composite scaled to the canvas once, at HLApplyVideo, not per frame.
U32	*hl_menu_bg		= NULL;
I64	 hl_menu_bg_w	= 0;
I64	 hl_menu_bg_h	= 0;
Bool hl_menu_bg_art	= FALSE;	//the real tiles loaded, not the fallback

//Globals are not zeroed and declaration initialisers do not run, so a junk
//hl_menu_bg would be passed to Free on the first rebuild.
hl_menu_bg     = NULL;
hl_menu_bg_w   = 0;
hl_menu_bg_h   = 0;
hl_menu_bg_art = FALSE;

U0 HLMenuBgTile(U8 *name, I64 ox, I64 oy)
{//One background tile, nearest-neighbour scaled into the composite.
 //
 //TGA type 2, 32bpp BGRA, no colour map, origin bottom-left.
	U8	 path[160];
	U8	*d;
	U8	*src;
	U32	*dst;
	I64	 size = 0;
	I64	 tw;
	I64	 th;
	I64	 dx0;
	I64	 dx1;
	I64	 dy0;
	I64	 dy1;
	I64	 dx;
	I64	 dy;
	I64	 sx;
	I64	 sy;

	if (!HLFileResolve(name, path))
		return;

	d = FileRead(path, &size);

	if (!d)
		return;

	if (size < 18)
		goto qbt_done;
	if (d[1] || d[2] != 2 || d[16] != 32)
		goto qbt_done;

	tw = d[12] + (d[13] << 8);
	th = d[14] + (d[15] << 8);

	if (tw < 1 || th < 1 || 18 + d[0] + tw * th * 4 > size)
		goto qbt_done;

	//Destination rect for this tile's slot in the 800x600 composite.
	dx0 = ox * hl_menu_bg_w / HLBG_W;
	dx1 = (ox + tw) * hl_menu_bg_w / HLBG_W;
	dy0 = oy * hl_menu_bg_h / HLBG_H;
	dy1 = (oy + th) * hl_menu_bg_h / HLBG_H;

	if (dx1 > hl_menu_bg_w)	dx1 = hl_menu_bg_w;
	if (dy1 > hl_menu_bg_h)	dy1 = hl_menu_bg_h;

	for (dy = dy0; dy < dy1; dy++)
	{
		sy = dy * HLBG_H / hl_menu_bg_h - oy;

		if (sy < 0)		sy = 0;
		if (sy >= th)	sy = th - 1;

		//Bottom-left origin: row 0 on disk is the bottom scanline.
		src = d + 18 + d[0] + (th - 1 - sy) * tw * 4;
		dst = hl_menu_bg + dy * hl_menu_bg_w;

		for (dx = dx0; dx < dx1; dx++)
		{
			sx = dx * HLBG_W / hl_menu_bg_w - ox;

			if (sx < 0)		sx = 0;
			if (sx >= tw)	sx = tw - 1;

			dst[dx] = (src[sx * 4 + 2] << 16) |
					  (src[sx * 4 + 1] << 8) |
					   src[sx * 4];
		}
	}

qbt_done:
	Free(d);
}

U0 HLMenuBgLambda()
{//gfx/lambda.bmp into the composite, when resource/background is not installed.
 //
 //128x128, 8bpp, no compression, BGRA palette at 54, image at the header's data
 //offset, bottom-up. Drawn dim and off to the right, which is roughly where the
 //logo sits in the shipped art.
	U8	 path[160];
	U8	*d;
	U32	*dst;
	I64	 size = 0;
	I64	 ofs;
	I64	 bw;
	I64	 bh;
	I64	 stride;
	I64	 span;
	I64	 ox;
	I64	 oy;
	I64	 dx;
	I64	 dy;
	I64	 sx;
	I64	 sy;
	I64	 pal;
	U8	 texel;
	I64	 r;
	I64	 g;
	I64	 b;

	if (!HLFileResolve("gfx/lambda.bmp", path))
		return;

	d = FileRead(path, &size);

	if (!d)
		return;

	if (size < 54 || d[0] != 'B' || d[1] != 'M')
		goto qbl_done;

	ofs = HLRdI32(d + 10);
	bw  = HLRdI32(d + 18);
	bh  = HLRdI32(d + 22);

	//8bpp uncompressed only; that is what the shipped file is.
	if (d[28] != 8 || d[29] || HLRdI32(d + 30) || bw < 1 || bh < 1)
		goto qbl_done;

	//Rows are padded to four bytes.
	stride = (bw + 3) & -4;
	pal    = 54;

	if (ofs + stride * bh > size || pal + 1024 > size)
		goto qbl_done;

	//Half the canvas height, right of centre.
	span = hl_menu_bg_h / 2;

	if (span < 8)
		goto qbl_done;

	ox = hl_menu_bg_w - span - hl_menu_bg_w / 10;
	oy = (hl_menu_bg_h - span) / 3;

	for (dy = 0; dy < span; dy++)
	{
		if (oy + dy < 0 || oy + dy >= hl_menu_bg_h)
			goto qbl_next_row;

		sy = dy * bh / span;

		if (sy < 0)		sy = 0;
		if (sy >= bh)	sy = bh - 1;

		dst = hl_menu_bg + (oy + dy) * hl_menu_bg_w;

		for (dx = 0; dx < span; dx++)
		{
			if (ox + dx < 0 || ox + dx >= hl_menu_bg_w)
				goto qbl_next_col;

			sx = dx * bw / span;

			if (sx < 0)		sx = 0;
			if (sx >= bw)	sx = bw - 1;

			//Bottom-up: row 0 on disk is the bottom scanline.
			texel = d[ofs + (bh - 1 - sy) * stride + sx];

			//Palette entries are BGRA. Quartered, so the logo reads as a dim
			//shape behind the item column rather than a bright plate.
			b = d[pal + texel * 4];
			g = d[pal + texel * 4 + 1];
			r = d[pal + texel * 4 + 2];

			dst[ox + dx] = ((r >> 2) << 16) | ((g >> 2) << 8) | (b >> 2);

qbl_next_col:
		}

qbl_next_row:
	}

qbl_done:
	Free(d);
}

U0 HLMenuBgBuild(I64 w, I64 h)
{//Rebuild the backdrop for a canvas size. Called on every resolution change.
	U8	 name[80];
	I64	 col;
	I64	 row;

	if (hl_menu_bg)
		Free(hl_menu_bg);

	hl_menu_bg     = NULL;
	hl_menu_bg_w   = 0;
	hl_menu_bg_h   = 0;
	hl_menu_bg_art = FALSE;

	if (w < 1 || h < 1)
		return;

	hl_menu_bg   = MAlloc(w * h * sizeof(U32));
	hl_menu_bg_w = w;
	hl_menu_bg_h = h;

	MemSet(hl_menu_bg, 0, w * h * sizeof(U32));

	//resource/background is 3MB of TGA and a trimmed install will not have it.
	if (HLFileExists("resource/background/800_1_a_loading.tga"))
	{
		for (row = 0; row < 3; row++)
		{
			for (col = 0; col < 4; col++)
			{
				StrPrint(name, "resource/background/800_%d_%c_loading.tga",
					row + 1, 'a' + col);

				HLMenuBgTile(name, col * HLBG_PITCH, row * HLBG_PITCH);
			}
		}

		hl_menu_bg_art = TRUE;
		return;
	}

	//Fallback: the lambda over black, and HLMenuDraw adds the wordmark the
	//shipped art carries.
	HLMenuBgLambda;
}

U0 HLMenuBgDraw(CHLCanvas *c)
{//The composite, or black when the art is absent.
	I64 y;

	//Rebuilt here rather than at HLApplyVideo: the menu is the only consumer
	//and the first frame after a resolution change is not a timed one.
	if (hl_menu_bg_w != c->width || hl_menu_bg_h != c->height)
		HLMenuBgBuild(c->width, c->height);

	if (hl_menu_bg && hl_menu_bg_w == c->width && hl_menu_bg_h == c->height)
	{
		for (y = 0; y < c->height; y++)
			MemCopy(c->pixels + y * c->width,
				hl_menu_bg + y * hl_menu_bg_w,
				c->width * sizeof(U32));

		return;
	}

	MemSet(c->pixels, 0, c->width * c->height * sizeof(U32));

	if (hl_pic_conback.pixels)
		HLPicDrawFill(c, &hl_pic_conback);
}

//ClientScheme.res colours. The item column is BrightControlText, the selection
//BrightBaseText, the help text DimBaseText.
#define HLMENU_C_ITEM	0x00C4B550
#define HLMENU_C_SEL		0x00FFFFFF
#define HLMENU_C_HINT	0x00A0AA95

I64 HLMenuTexelLum(U8 *pal, U8 texel)
{//Brightest channel of a palette entry, 0..255.
	U32 rgb;
	I64 r;
	I64 g;
	I64 b;

	if (pal)
	{
		r = pal[texel * 3];
		g = pal[texel * 3 + 1];
		b = pal[texel * 3 + 2];
	}
	else
	{
		rgb = HLPalColor(texel);
		r   = (rgb >> 16) & 255;
		g   = (rgb >> 8) & 255;
		b   = rgb & 255;
	}

	if (g > r)	r = g;
	if (b > r)	r = b;

	return r;
}

U0 HLMenuCharColor(CHLCanvas *c, I64 x, I64 y, I64 ch, I64 rgb)
{//One glyph, recoloured. The font's own colours are modulation only.
 //
 //CONCHARS glyphs are pre-coloured orange over a dark outline. Scaling a flat
 //colour by each texel's luminance keeps the outline dark, which is what VGUI
 //text over a photograph needs to stay legible.
	U8	*base;
	U8	*pal;
	U8	*src;
	U32	*dst;
	I64	 ofs;
	I64	 gx;
	I64	 gy;
	I64	 gw;
	I64	 gh;
	I64	 sx;
	I64	 sy;
	I64	 px;
	I64	 py;
	I64	 stride;
	I64	 lim;
	I64	 cut;
	I64	 lum;
	I64	 cr;
	I64	 cg;
	I64	 cb;
	U8	 texel;

	ch &= 255;

	if (ch == 32)
		return;

	cr = (rgb >> 16) & 255;
	cg = (rgb >> 8) & 255;
	cb = rgb & 255;

	if (hl_font.ready)
	{
		if (!hl_font.pixels)
			return;

		ofs    = hl_font.start[ch];
		gw     = hl_font.cwidth[ch];
		gh     = hl_font.row_height;
		stride = HLFONT_WIDTH;
		gx     = ofs % HLFONT_WIDTH;
		gy     = ofs / HLFONT_WIDTH;
		lim    = hl_font.height;
		pal    = hl_font.palette;
		cut    = HLSPR_TRANSPARENT;
		base   = hl_font.pixels;
	}
	else
	{
		if (!hl_conchars)
			return;

		gw     = HLCHAR_W;
		gh     = HLCHAR_H;
		stride = 128;
		gx     = (ch & 15) * HLCHAR_W;
		gy     = (ch >> 4) * HLCHAR_H;
		lim    = 128;
		pal    = NULL;
		cut    = 0;
		base   = hl_conchars;
	}

	if (gw < 1)
		return;

	for (sy = 0; sy < gh; sy++)
	{
		py = y + sy;

		if (py < 0 || py >= c->height)
			goto qmc_next_row;
		if (gy + sy >= lim)
			goto qmc_next_row;

		src = base + (gy + sy) * stride + gx;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < gw; sx++)
		{
			px = x + sx;

			if (px < 0 || px >= c->width)
				goto qmc_next_col;
			if (gx + sx >= stride)
				goto qmc_next_col;

			texel = src[sx];

			if (texel == cut)
				goto qmc_next_col;

			lum = HLMenuTexelLum(pal, texel);

			dst[px] = ((cr * lum / 255) << 16) |
					  ((cg * lum / 255) << 8) |
					   (cb * lum / 255);

qmc_next_col:
		}

qmc_next_row:
	}
}

U0 HLMenuStrColor(CHLCanvas *c, I64 x, I64 y, U8 *s, I64 rgb)
{//Advances per glyph; the HL font is variable width.
	I64 i  = 0;
	I64 cx = x;

	while (s[i])
	{
		HLMenuCharColor(c, cx, y, s[i], rgb);
		cx += HLFontCharWidth(s[i]);
		i++;
	}
}

//--- VGUI dialogs ------------------------------------------------------------

I64 HLDlgX(CHLCanvas *c, I64 x)
{
	return x * c->width / HLDLG_W;
}

I64 HLDlgY(CHLCanvas *c, I64 y)
{
	return y * c->height / HLDLG_H;
}

I64 HLMenuLineH()
{//Row pitch for a list, one glyph plus leading.
	if (hl_font.ready)
		return hl_font.row_height + 2;

	return HLCHAR_H + 2;
}

U0 HLMenuPanel(CHLCanvas *c, I64 x, I64 y, I64 w, I64 h, U8 *title)
{//A VGUI Frame: ControlBG over the backdrop, a border, and a title.
 //
 //ClientScheme ControlBG is "90 106 80 124", so alpha 124/255. Blended here
 //rather than drawn opaque; the backdrop reads through, as it does in HL.
	U32	*dst;
	I64	 px;
	I64	 py;
	I64	 r;
	I64	 g;
	I64	 b;
	U32	 s;

	if (w < 2 || h < 2)
		return;

	for (py = y; py < y + h; py++)
	{
		if (py < 0 || py >= c->height)
			goto qmp_next_row;

		dst = c->pixels + py * c->width;

		for (px = x; px < x + w; px++)
		{
			if (px < 0 || px >= c->width)
				goto qmp_next_col;

			s = dst[px];
			r = (s >> 16) & 255;
			g = (s >> 8) & 255;
			b = s & 255;

			//131 = 255 - 124.
			r = (r * 131 + 90 * 124) / 255;
			g = (g * 131 + 106 * 124) / 255;
			b = (b * 131 + 80 * 124) / 255;

			dst[px] = (r << 16) | (g << 8) | b;

qmp_next_col:
		}

qmp_next_row:
	}

	//Border, one pixel, DimBaseText. The scheme's BorderBright is 0 255 0,
	//which is a placeholder in the shipped file rather than a colour.
	for (px = x; px < x + w; px++)
	{
		if (px < 0 || px >= c->width)
			goto qmp_next_edge_x;

		if (y >= 0 && y < c->height)
			c->pixels[y * c->width + px] = HLMENU_C_HINT;
		if (y + h - 1 >= 0 && y + h - 1 < c->height)
			c->pixels[(y + h - 1) * c->width + px] = HLMENU_C_HINT;

qmp_next_edge_x:
	}

	for (py = y; py < y + h; py++)
	{
		if (py < 0 || py >= c->height)
			goto qmp_next_edge_y;

		if (x >= 0 && x < c->width)
			c->pixels[py * c->width + x] = HLMENU_C_HINT;
		if (x + w - 1 >= 0 && x + w - 1 < c->width)
			c->pixels[py * c->width + x + w - 1] = HLMENU_C_HINT;

qmp_next_edge_y:
	}

	if (title)
		HLMenuStrColor(c, x + 8, y + 4, title, HLMENU_C_SEL);
}

U0 HLMenuBackdrop(CHLCanvas *c)
{//M_Draw's rule: with a game running the world stays up and dimmed, so the
 //menu reads as an overlay. only outside a game does conback fill the screen
	if (hl_menu_ingame)
	{
		HLDrawFadeScreen(c);
		return;
	}

	//index 0 is black in the global palette, and black is 0 in RGB too, so
	//the byte fill still says the right thing on a 32bpp canvas
	MemSet(c->pixels, 0, c->width * c->height * sizeof(U32));

	if (hl_pic_conback.pixels)
		HLPicDrawFill(c, &hl_pic_conback);
}

U0 HLMenuSlider(CHLCanvas *c, I64 x, I64 y, F64 range)
{
	I64 i;

	if (range < 0.0)	range = 0.0;
	if (range > 1.0)	range = 1.0;

	HLCharDraw(c, x - HLCHAR_W, y, 128);

	for (i = 0; i < HLSLIDER_CELLS; i++)
		HLCharDraw(c, x + i * HLCHAR_W, y, 129);

	HLCharDraw(c, x + HLSLIDER_CELLS * HLCHAR_W, y, 130);

	HLCharDraw(c, x + ToI64((HLSLIDER_CELLS - 1) * HLCHAR_W * range), y, 131);
}

I64 HLMenuXOfs(CHLCanvas *c)
{
	I64 ofs = (c->width - HLMENU_VW) / 2;

	if (ofs < 0)
		ofs = 0;

	return ofs;
}

U0 HLMenuSound(U8 *name)
{
	HLSndPlayAt(name, hl_snd_listener, 1.0, 0.0);
}

U0 HLMenuInit()
{//globals aren't zeroed, a junk request flag saves or loads with no world
	hl_sp_row         = 0;
	hl_menu_save_req  = FALSE;
	hl_menu_load_req  = FALSE;
	hl_menu_leave_req = FALSE;
	hl_skill_row      = HLSKILL_MEDIUM;
	hl_slot_row       = 0;
	hl_menu_slot      = 0;
	hl_opt_tab        = HLTAB_VIDEO;
	hl_opt_row        = 0;
	hl_flash_on       = FALSE;
	hl_flash_battery  = 100;
	hl_flash_next     = 0.0;
	hl_con_wpn_seen   = -1;
	hl_con_wpn_prev   = -1;
	hl_con_fov_last   = 90.0;

	U8	name[24];
	I64	i;

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		hl_slot_used[i]                  = FALSE;
		hl_slot_map[i * HLSAVE_NAME_MAX] = 0;
	}

	HLPicLoad("gfx/qplaque.lmp", &hl_pic_qplaque);
	HLPicLoad("gfx/conback.lmp", &hl_pic_conback);

	for (i = 0; i < HLHELP_PAGES; i++)
	{
		StrPrint(name, "gfx/help%d.lmp", i);
		HLPicLoad(name, &hl_pic_help[i]);
	}
	HLPicLoad("gfx/sp_menu.lmp", &hl_pic_sp_menu);
	HLPicLoad("gfx/ttl_sgl.lmp", &hl_pic_p_single);
	HLPicLoad("gfx/p_multi.lmp", &hl_pic_p_multi);
	HLPicLoad("gfx/mp_menu.lmp", &hl_pic_mp_menu);
	HLPicLoad("gfx/p_option.lmp", &hl_pic_p_option);
	HLPicLoad("gfx/menuplyr.lmp", &hl_pic_menuplyr);

	for (i = 0; i < 6; i++)
	{
		StrPrint(name, "gfx/menudot%d.lmp", i + 1);
		HLPicLoad(name, &hl_pic_cursor[i]);
	}

	for (i = 0; i < HLCON_LINES; i++)
		hl_con_time[i] = -1000.0;

	for (i = 0; i < HLCON_LINES * HLCON_WIDTH; i++)
		hl_con_text[i] = 0;

	hl_con_line     = 0;
	hl_con_ready    = TRUE;
	hl_state        = HLST_MENU;
	hl_menu_row     = 0;
	hl_menu_ingame  = FALSE;
	hl_quit_request = FALSE;
}

U0 HLConPrint(U8 *s)
{//wraps, never truncates. 40 columns, and dropping the tail hides exactly the
 //part worth reading - QuakeC's sprint output is not width aware either
	I64	 i = 0;
	I64	 n;
	U8	*row;

	if (!hl_con_ready)
		return;

	//an empty string still costs a blank line
	while (TRUE)
	{
		row = hl_con_text + (hl_con_line % HLCON_LINES) * HLCON_WIDTH;
		n   = 0;

		while (s[i] && n < HLCON_WIDTH - 1)
		{
			row[n] = s[i];
			n++;
			i++;
		}

		row[n] = 0;
		hl_con_time[hl_con_line % HLCON_LINES] = tS;
		hl_con_line++;

		if (!s[i])
			return;
	}
}

//--- console input ---------------------------------------------------------
//
// CharGet and KeyGet block, so typing runs off the same non-blocking scancode
// poll the game uses. every key needs its own edge detect or one tap repeats
// per frame - a screenful of characters at 190fps

#define HLCON_INPUT_MAX	62

U8	 hl_con_input[HLCON_INPUT_MAX + 2];
I64	 hl_con_input_len	= 0;

//Key_Console's history ring. edit_line is where typing goes, history_line is
//where the cursor-key walk sits
#define HLCON_HISTORY	32

U8	 hl_con_hist[HLCON_HISTORY * (HLCON_INPUT_MAX + 2)];
I64	 hl_con_edit_line	= 0;
I64	 hl_con_hist_line	= 0;

U0 HLConHistoryInit()
{//globals aren't zeroed, and these index a fixed array
	I64 i;

	for (i = 0; i < HLCON_HISTORY; i++)
		hl_con_hist[i * (HLCON_INPUT_MAX + 2)] = 0;

	hl_con_edit_line = 0;
	hl_con_hist_line = 0;
}

U0 HLConHistoryRecall(I64 line)
{//stored line into the edit buffer
	U8 *src;

	if (line < 0 || line >= HLCON_HISTORY)
		return;

	src = &hl_con_hist[line * (HLCON_INPUT_MAX + 2)];
	HLStrCopy(hl_con_input, src, HLCON_INPUT_MAX + 1);
	hl_con_input_len = StrLen(hl_con_input);
}
U8	 hl_key_prev[256];

//Key_Message: chat prompt without opening the console
Bool hl_msg_mode		= FALSE;
Bool hl_msg_team		= FALSE;
U8	 hl_chat_buf[32];
I64	 hl_chat_len		= 0;

Bool hl_con_want_noclip	= FALSE;	//console asked for a noclip toggle
Bool hl_con_want_quit	= FALSE;

//printable keys, walked by character and mapped through Char2ScanCode. minus
//is deliberately absent - it carries both '-' and '_', so whichever appeared
//first always won and sv_cheats came out sv-cheats. handled below, where the
//shift state is available
U8 *hl_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ./";

U0 HLConInputReset()
{
	I64 i;

	for (i = 0; i < 256; i++)
		hl_key_prev[i] = 0;

	hl_con_input[0]   = 0;
	hl_con_input_len  = 0;
	hl_con_want_noclip = FALSE;
	hl_con_want_quit   = FALSE;
	hl_msg_mode  = FALSE;
	hl_msg_team  = FALSE;
	hl_chat_buf[0] = 0;
	hl_chat_len    = 0;
}

Bool HLConKeyEdge(I64 sc)
{//TRUE only on the frame a key goes down
	Bool down;
	Bool was;

	if (sc <= 0 || sc >= 256)
		return FALSE;

	down = ToBool(Bt(kbd.down_bitmap, sc));
	was  = ToBool(hl_key_prev[sc]);

	if (down)
		hl_key_prev[sc] = 1;
	else
		hl_key_prev[sc] = 0;

	return ToBool(down && !was);
}

//--- console command helpers ------------------------------------------------

F64  hl_con_fov_want	= 0.0;	//non-zero, console asked for a new fov
Bool hl_con_want_save	= FALSE;
Bool hl_con_want_load	= FALSE;
Bool hl_con_save_ok		= TRUE;

//the shell owns the counter and is compiled after this file, so it publishes
//a copy here
I64 hl_net_mismatch_report = 0;
U8  hl_con_net_line[128];

U0 HLConDrainProgs()
{//drain the QuakeC print buffer into the console, one line per newline
	U8	line[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (hl_bi_print_len < 1)
		return;

	for (i = 0; i < hl_bi_print_len; i++)
	{
		c = hl_bi_print_buf[i];

		if (c == '\n' || n >= 126)
		{
			line[n] = 0;
			if (n > 0)
				HLConPrint(line);
			n = 0;
		}

		if (c != '\n')
		{
			line[n] = c;
			n++;
		}
	}

	//QuakeC does not always terminate its lines, so flush the tail rather than
	//hold it until the next print
	if (n > 0)
	{
		line[n] = 0;
		HLConPrint(line);
	}

	hl_bi_print_len    = 0;
	hl_bi_print_buf[0] = 0;
}

U32 HLConParseIPV4(U8 *s)
{//dotted quad to host-order U32, 0 on failure
	I64 part[4];
	I64 n = 0;
	I64 v;
	I64 digits;
	I64 i = 0;

	while (n < 4)
	{
		v      = 0;
		digits = 0;

		while (s[i] >= '0' && s[i] <= '9')
		{
			v = v * 10 + (s[i] - '0');
			digits++;
			i++;

			if (v > 255)
				return 0;
		}

		if (!digits)
			return 0;

		part[n] = v;
		n++;

		if (n < 4)
		{
			if (s[i] != '.')
				return 0;
			i++;
		}
	}

	//an optional :port is accepted and ignored - every host we speak to is on
	//HLNET_PORT_DEFAULT, and CCREP_SERVER_INFO advertises itself as ip:port, so
	//rejecting the suffix meant a server picked off the slist would not join
	//while the same address typed by hand would
	if (s[i] == ':')
	{
		i++;
		while (s[i] >= '0' && s[i] <= '9')
			i++;
	}

	//anything else trailing means it was not an address
	if (s[i] && s[i] != ' ')
		return 0;

	//ipv4_globals layout: little-endian host order, first octet in the low byte
	return part[0] | (part[1] << 8) | (part[2] << 16) | (part[3] << 24);
}

U0 HLConConnectIP(U32 ip)
{//the connect itself, by address. slist already holds the U32 it answered
 //from, so joining a discovered server never formats or re-parses a string
	U8	msg[96];
	U32	me;

	if (!HLNetUdpAvailable())
	{
		HLConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	if (!ip)
	{
		HLConPrint("no address to connect to");
		return;
	}

	StrPrint(msg, "connecting to %d.%d.%d.%d...",
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	HLConPrint(msg);

	//pick an address when the link has no DHCP, the direct VM-to-VM case.
	//the qip command overrides it
	HLNetAutoIP(ip);

	if (!HLNetUdpOpen(HLNET_PORT_DEFAULT))
	{
		HLConPrint(hl_udp_status);
		return;
	}

	hl_udp_server = FALSE;
	HLNetDgrmInit;
	HLNetUdpSetPeer(ip);

	//resolve the server MAC here, where a stall is acceptable, never in the
	//frame loop. doubles as the reachability test - no ARP reply, no machine
	if (!HLNetUdpResolvePeer)
	{
		HLConPrint("no arp reply - is the other vm up and on this link?");
		return;
	}

	//join now rather than wait for the retry tick
	HLNetClientSendConnect(hl_setup_name, hl_setup_top, hl_setup_bottom);

	me = HLNetLocalIP();

	StrPrint(msg, "me %d.%d.%d.%d -> server %d.%d.%d.%d",
		me & 255, (me >> 8) & 255, (me >> 16) & 255, (me >> 24) & 255,
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	HLConPrint(msg);
}

U0 HLConConnect(U8 *args)
{//"connect <ip>" - parse, then hand off. accepts an optional :port suffix
	U32 ip = HLConParseIPV4(args);

	if (!ip)
	{
		HLConPrint("usage: connect 10.0.0.1");
		return;
	}

	HLConConnectIP(ip);
}

U0 HLConSlist()
{//NET_Slist_f - start a scan and print the cache as it stands
 //
 //nothing here waits. the CCREPs land in the recv path over the next second,
 //so the first slist usually prints an empty list and the next one prints the
 //servers. that is why the searching line exists - without it an empty table
 //is indistinguishable from a broken scan
	U8	line[80];
	I64	i;

	if (!HLNetUdpAvailable())
	{
		HLConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	//no autoip: 10.0.0.1 is the address a host takes, and handing it to a
	//scanning client collides with the very server it is looking for
	if (!HLNetLocalIP())
	{
		HLConPrint("set ip first: qip 10.0.0.2");
		return;
	}

	if (!HLNetUdpOpen(HLNET_PORT_DEFAULT))
	{
		HLConPrint(hl_udp_status);
		return;
	}

	//a listen host answers CCREQ instead of collecting CCREP, so it can only
	//ever find itself - say so rather than print an empty list forever
	if (hl_udp_server)
	{
		HLConPrint("hosting - slist is for clients");
		return;
	}

	if (!HLNetSlistBroadcast)
		HLConPrint("broadcast failed - no link?");
	else
		HLConPrint("searching for lan servers...");

	if (!hl_slist_count)
	{
		HLConPrint("no servers yet - run slist again");
		return;
	}

	HLConPrint("address        host    map     players");

	for (i = 0; i < hl_slist_count; i++)
	{
		StrPrint(line, "%s %s %s %d/%d",
			hl_slist[i].addr,
			hl_slist[i].name,
			hl_slist[i].map,
			hl_slist[i].players,
			hl_slist[i].max_players);
		HLConPrint(line);
	}
}

U0 HLCvarValueStr(U8 *out, F64 v)
{//cvars are strings in the original, so 1 prints back as 1, not 1.00
	if (v == ToF64(ToI64(v)))
		StrPrint(out, "%d", ToI64(v));
	else
		StrPrint(out, "%g", v);
}

Bool HLConCvarCommand(U8 *line)
{//Cvar_Command. TRUE when the line named a cvar, set or reported
	U8	name[24];
	U8	out[64];
	U8	vbuf[32];
	I64	i = 0;
	I64	j;

	while (line[i] && line[i] != ' ' && i < 23)
	{
		name[i] = line[i];
		i++;
	}
	name[i] = 0;

	//unknown names are rejected here, unlike HLCvarSet which creates on demand -
	//a typo becoming a new cvar reports success for a setting nothing reads
	if (HLCvarIndex(name) < 0)
		return FALSE;

	j = i;
	while (line[j] == ' ')
		j++;

	if (!line[j])
	{
		HLCvarValueStr(vbuf, HLCvarGet(name));
		StrPrint(out, "\"%s\" is \"%s\"", name, vbuf);
		HLConPrint(out);
		return TRUE;
	}

	HLCvarSet(name, HLAtoF(line + j));

	HLCvarValueStr(vbuf, HLCvarGet(name));
	StrPrint(out, "%s set to %s", name, vbuf);
	HLConPrint(out);

	return TRUE;
}

U0 HLConCvar(U8 *args)
{//Cvar_Command: "name value" sets, bare "name" reports
	U8	 name[24];
	U8	 line[64];
	U8	 vbuf[32];
	I64	 i = 0;
	I64	 j;

	while (args[i] && args[i] != ' ' && i < 23)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
		return;

	j = i;
	while (args[j] == ' ')
		j++;

	if (!args[j])
	{
		HLCvarValueStr(vbuf, HLCvarGet(name));
		StrPrint(line, "\"%s\" is \"%s\"", name, vbuf);
		HLConPrint(line);
		return;
	}

	HLCvarSet(name, HLAtoF(args + j));
	HLCvarValueStr(vbuf, HLCvarGet(name));
	StrPrint(line, "%s set to %s", name, vbuf);
	HLConPrint(line);
}

Bool HLConCheatAllowed()
{//HL's gate is sv_cheats alone: g_flWeaponCheat is read from it in
 //ServerActivate, and CheatImpulseCommands returns immediately when it is 0.
 //Quake gated the engine cheats on deathmatch instead, which is not HL's rule.
	if (HLCvarGet("sv_cheats") == 0.0)
	{
		HLConPrint("sv_cheats is 0");
		return FALSE;
	}

	return TRUE;
}

U0 HLConReportFlag(U8 *name, Bool on)
{//Host_God_f's report line.
	U8 msg[64];

	if (on)
		StrPrint(msg, "%s ON", name);
	else
		StrPrint(msg, "%s OFF", name);

	HLConPrint(msg);
}

Bool HLConAimBasis(F64 *eye, F64 *fwd)
{//the eye and forward vector FindEntityForward traces along.
 //
 //hl_angles and hl_view belong to the shell, which compiles after this file,
 //so the eye is taken from the sound listener - HLSndListener is handed
 //hl_view every frame - and the heading from listener_right. AngleVectors'
 //right is roll free, right = (sin yaw, -cos yaw, 0), so forward at zero
 //pitch is (-right[1], right[0], 0). Pitch is the one thing lost: the probe
 //runs level with the eye rather than up or down the view ray.
	if (!hl_game_active || !hl_map || !hl_entities)
		return FALSE;

	HLVecCopy(hl_snd_listener, eye);
	HLVecSet(fwd, -hl_snd_right[1], hl_snd_right[0], 0.0);

	if (HLVecNormalize(fwd) <= 0.0)
		return FALSE;

	return TRUE;
}

I64 HLConEntityForward()
{//FindEntityForward. HLTraceEntity clips against SOLID_BSP brushes only, so a
 //SLIDEBOX monster is invisible to it - the probe is HLEntUseInFront's box
 //test walked out along the ray instead, which keeps +use and the aiming
 //impulses agreeing on what is in front. -1 when nothing is.
	CHLEntity	*e;
	F64			 eye[3];
	F64			 fwd[3];
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	F64			 d;
	I64			 i;
	I64			 j;

	if (!HLConAimBasis(eye, fwd))
		return -1;

	d = 16.0;

	while (d <= 2048.0)
	{
		HLVecMA(eye, d, fwd, probe);

		for (j = 0; j < 3; j++)
		{
			pmins[j] = probe[j] - 16.0;
			pmaxs[j] = probe[j] + 16.0;
		}

		for (i = 0; i < hl_num_entities; i++)
		{
			e = &hl_entities[i];

			//SOLID_NOT is what the trace would pass straight through
			if (!e->in_use || e->solid == HLSOLID_NOT || i == hl_ent_player)
				goto qcef_next;

			if (HLEntBoxOverlap(e, pmins, pmaxs))
				return i;

qcef_next:
		}

		d += 16.0;
	}

	return -1;
}

U8 *HLConMonStateName(I64 s)
{//ReportAIState's pStateNames. A comparison chain, not a table: adjacent
 //string literals in a U8 * array collapse to one entry on this compiler
	if (s == HLMSTATE_IDLE)		return "Idle";
	if (s == HLMSTATE_ALERT)		return "Alert";
	if (s == HLMSTATE_COMBAT)	return "Combat";
	if (s == HLMSTATE_SCRIPT)	return "Scripted";
	if (s == HLMSTATE_DEAD)		return "Dead";

	return "None";
}

U8 *HLConMonSchedName(I64 s)
{//ReportAIState prints m_pSchedule->pName. These are the port's schedule ids
	if (s == HLSCHED_IDLE_STAND)		return "IdleStand";
	if (s == HLSCHED_ALERT_STAND)	return "AlertStand";
	if (s == HLSCHED_ALERT_FACE)		return "AlertFace";
	if (s == HLSCHED_WAKE_ANGRY)		return "WakeAngry";
	if (s == HLSCHED_CHASE_ENEMY)	return "ChaseEnemy";
	if (s == HLSCHED_MELEE_ATTACK1)	return "MeleeAttack1";
	if (s == HLSCHED_RANGE_ATTACK1)	return "RangeAttack1";
	if (s == HLSCHED_TAKE_COVER)		return "TakeCover";
	if (s == HLSCHED_SMALL_FLINCH)	return "SmallFlinch";
	if (s == HLSCHED_DIE)			return "Die";

	return "None";
}

U8 *HLConGlobalStateName(I64 s)
{//CGlobalState::DumpGlobals' estates
	if (s == HLGLOBAL_ON)	return "On";
	if (s == HLGLOBAL_DEAD)	return "Dead";

	return "Off";
}

U0 HLConReportAIState(I64 ent)
{//CBaseMonster::ReportAIState, for the one monster the probe found.
 //
 //Activity is absent: the port drives sequences by label off the schedule, so
 //there is no activity_map to name.
	CHLEntity	*e = HLEntGet(ent);
	U8			 msg[128];
	I64			 s;

	if (!e)
		return;

	s = hl_ai_mon_of[ent];

	if (s < 0)
	{
		StrPrint(msg, "%s: not a monster", e->classname);
		HLConPrint(msg);
		return;
	}

	StrPrint(msg, "%s: State: %s, Schedule %s, Task %d (status %d),",
		e->classname,
		HLConMonStateName(hl_ai_mon[s].state),
		HLConMonSchedName(hl_ai_mon[s].sched),
		hl_ai_mon[s].task, hl_ai_mon[s].task_status);
	HLConPrint(msg);

	if (!hl_ai_mon[s].have_enemy)
		HLConPrint("No enemy");
	else if (hl_ai_mon[s].enemy < 0)
		HLConPrint("Enemy is player");
	else
	{
		e = HLEntGet(hl_ai_mon[s].enemy);

		if (e)
			StrPrint(msg, "Enemy is %s", e->classname);
		else
			StrPrint(msg, "Enemy is entity %d", hl_ai_mon[s].enemy);

		HLConPrint(msg);
	}
}

U0 HLConFlashlightToggle()
{//CBasePlayer::FlashlightTurnOn / FlashlightTurnOff. Both sounds are
 //items/flashlight1.wav in the SDK, so the toggle plays one either way
	if (!hl_game_active)
		return;

	if (hl_flash_on)
	{
		hl_flash_on   = FALSE;
		hl_flash_next = tS + HLFLASH_CHARGE;
		HLMenuSound("items/flashlight1.wav");
		return;
	}

	//FlashlightTurnOn does nothing without WEAPON_SUIT
	if (!hl_ent_player_suit)
	{
		HLConPrint("impulse 100: no HEV suit");
		return;
	}

	if (hl_flash_battery <= 0)
	{
		HLConPrint("impulse 100: flashlight battery is flat");
		return;
	}

	hl_flash_on   = TRUE;
	hl_flash_next = tS + HLFLASH_DRAIN;
	HLMenuSound("items/flashlight1.wav");
}

U0 HLConFlashlightFrame()
{//CBasePlayer::UpdatePlayerSound's flashlight half: spend a battery unit every
 //FLASH_DRAIN_TIME while lit, regain one every FLASH_CHARGE_TIME while off,
 //and cut out when the cell is empty.
 //
 //The beam itself is a dlight re-added each frame. It is placed down the view
 //ray at eye height rather than projected onto whatever is ahead - see
 //HLConAimBasis for why there is no pitch here.
	F64 eye[3];
	F64 fwd[3];
	F64 pos[3];

	if (!hl_game_active)
		return;

	if (!hl_flash_on)
	{
		if (hl_flash_battery < 100 && tS >= hl_flash_next)
		{
			hl_flash_battery++;
			hl_flash_next = tS + HLFLASH_CHARGE;
		}
		return;
	}

	if (tS >= hl_flash_next)
	{
		hl_flash_battery--;
		hl_flash_next = tS + HLFLASH_DRAIN;

		if (hl_flash_battery <= 0)
		{
			hl_flash_battery = 0;
			hl_flash_on      = FALSE;
			HLMenuSound("items/flashlight1.wav");
			return;
		}
	}

	if (!HLConAimBasis(eye, fwd))
		return;

	HLVecMA(eye, HLFLASH_AHEAD, fwd, pos);

	//life is one frame's worth: the light is re-added below every frame, and a
	//longer one would trail behind the player
	HLDlightAdd(pos, HLFLASH_RADIUS, 0.1, 0.0, tS, 255, 250, 220);
}

U0 HLConTrackLastItem()
{//CBasePlayer::m_pLastItem. HLWeaponSetActive keeps no record of the weapon it
 //holstered, so the change is sampled here instead, once a frame
	if (hl_wpn_active == hl_con_wpn_seen)
		return;

	hl_con_wpn_prev = hl_con_wpn_seen;
	hl_con_wpn_seen = hl_wpn_active;
}

//Weapon-selection impulses ride the next move message: the input block
//overwrites .impulse every tick, so one is queued here and survives one tick.
I64 hl_con_impulse_want = 0;

U0 HLConImpulse(I64 n)
{//CBasePlayer::CheatImpulseCommands. HL dispatches impulses in the game DLL
 //against the player object, not by poking an edict field the way Host_Impulse_f
 //did: there is no QuakeC player here, so the native systems are driven
 //directly.
 //
 //Weapon-selection impulses (1..10) still ride the input block, which consumes
 //them once, so those are queued rather than handled.
	CHLEntity	*e;
	U8			 msg[128];
	I64			 ent;
	I64			 i;

	if (n >= 1 && n <= 10)
	{
		hl_con_impulse_want = n;
		StrPrint(msg, "impulse %d", n);
		HLConPrint(msg);
		return;
	}

	//--- ImpulseCommands, the three that are not cheats -----------------------

	//case 99: the Logo user message toggles the client's valve logo sprite.
	if (n == 99)
	{
		HLConPrint("impulse 99: no client Logo user message or logo sprite");
		return;
	}

	//case 100: the level designer's flashlight.
	if (n == 100)
	{
		HLConFlashlightToggle;
		return;
	}

	//case 201: CSprayCan paints a decal where the eye ray lands.
	if (n == 201)
	{
		HLConPrint("impulse 201: no decal layer - infodecal is unsupported, so a spraycan has nothing to mark");
		return;
	}

	//--- CheatImpulseCommands ------------------------------------------------

	if (!HLConCheatAllowed)
		return;

	//case 76: Create("monster_human_grunt", ...) after the map is running.
	if (n == 76)
	{
		HLConPrint("impulse 76: no runtime entity creation - monsters exist only from the map's entity lump");
		return;
	}

	//case 101: gEvilImpulse101, the give-all block.
	if (n == 101)
	{
		HLWeaponGiveAll;
		HLConPrint("impulse 101");
		return;
	}

	//case 102: CGib::SpawnRandomGibs.
	if (n == 102)
	{
		HLConPrint("impulse 102: no gib models and no runtime entity creation for SpawnRandomGibs");
		return;
	}

	//case 103: ReportAIState for the monster in front of the player.
	if (n == 103)
	{
		ent = HLConEntityForward;

		if (ent < 0)
			HLConPrint("nothing in front");
		else
			HLConReportAIState(ent);
		return;
	}

	//case 104: gGlobalState.DumpGlobals. The port's records carry no level
	//name, so the "(levelName)" column of the SDK's line is absent.
	if (n == 104)
	{
		HLConPrint("-- Globals --");

		for (i = 0; i < hl_ent_global_count; i++)
		{
			if (!hl_ent_globals[i].name[0])
				goto qci_glob;

			StrPrint(msg, "%s: (%s)", hl_ent_globals[i].name,
				HLConGlobalStateName(hl_ent_globals[i].state));
			HLConPrint(msg);

qci_glob:
		}

		StrPrint(msg, "%d entities in use", HLEntCountInUse);
		HLConPrint(msg);
		return;
	}

	//case 105: m_fNoPlayerSound, which takes the player off the sound list the
	//monsters listen to.
	if (n == 105)
	{
		HLConPrint("impulse 105: HLAILook senses by sight alone - there is no CSoundEnt list to leave. notarget is the nearest equivalent");
		return;
	}

	//case 106: name the entity in front of the player.
	if (n == 106)
	{
		ent = HLConEntityForward;
		e   = HLEntGet(ent);

		if (!e)
		{
			HLConPrint("nothing in front");
			return;
		}

		if (e->targetname[0])
			StrPrint(msg, "Classname: %s - Targetname: %s", e->classname,
				e->targetname);
		else
			StrPrint(msg, "Classname: %s - TargetName: No Targetname",
				e->classname);
		HLConPrint(msg);

		StrPrint(msg, "Model: %s", e->model_name);
		HLConPrint(msg);

		if (e->global_state[0])
		{
			StrPrint(msg, "Globalname: %s", e->global_state);
			HLConPrint(msg);
		}
		return;
	}

	//case 107: TRACE_TEXTURE names the face the eye ray lands on. CHLTrace
	//carries a plane, not the face behind it, so there is no name to report.
	if (n == 107)
	{
		HLConPrint("impulse 107: the trace reports a plane, not the face, so there is no texture name");
		return;
	}

	//cases 195..197 and 199: the node_viewer entities and WorldGraph.
	if ((n >= 195 && n <= 197) || n == 199)
	{
		HLConPrint("impulse: no node graph - WorldGraph and the node_viewer entities are absent");
		return;
	}

	//case 202: CBloodSplat, another decal.
	if (n == 202)
	{
		HLConPrint("impulse 202: no decal layer for a blood splat");
		return;
	}

	//case 203: remove the creature in front. SUB_Remove's effect, done the way
	//HLEntFireTargets retires a killtarget.
	if (n == 203)
	{
		ent = HLConEntityForward;
		e   = HLEntGet(ent);

		if (!e)
		{
			HLConPrint("nothing in front");
			return;
		}

		if (!e->takedamage)
		{
			StrPrint(msg, "%s does not take damage", e->classname);
			HLConPrint(msg);
			return;
		}

		StrPrint(msg, "removed %s", e->classname);
		HLConPrint(msg);

		e->in_use     = FALSE;
		e->solid      = HLSOLID_NOT;
		e->think_fn   = HLM_NONE;
		e->next_think = 0.0;
		return;
	}

	StrPrint(msg, "impulse %d: not an impulse the game DLL handles", n);
	HLConPrint(msg);
}

U0 HLConGive(U8 *args)
{//ClientCommand "give". HL takes a CLASSNAME - `give weapon_shotgun`,
 //`give item_battery` - not Quake's single letter and amount.
	U8	msg[96];
	U8	name[64];
	I64	count = 0;
	I64	id;
	I64	ammo;
	I64	i = 0;

	//One token. Trailing text is ignored, as Cmd_Argv(1) does.
	while (args[i] && args[i] != ' ' && args[i] != '\t' && i < 63)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
	{
		HLConPrint("give <classname>, e.g. give weapon_shotgun");
		return;
	}

	//A weapon by classname, exactly as the pickup path resolves it.
	id = HLWeaponFindByClass(name);

	if (id >= 0)
	{
		if (HLWeaponGive(id))
			StrPrint(msg, "gave %s", name);
		else
			StrPrint(msg, "%s: already carried and full", name);

		HLConPrint(msg);
		return;
	}

	//An ammo box by classname.
	ammo = HLWeaponAmmoForClass(name, &count);

	if (ammo >= 0)
	{
		if (HLWeaponGiveAmmo(ammo, count))
			StrPrint(msg, "gave %s (%d)", name, count);
		else
			StrPrint(msg, "%s: pool full", name);

		HLConPrint(msg);
		return;
	}

	if (!StrICompare(name, "item_suit"))
	{
		hl_ent_player_suit = TRUE;
		HLConPrint("gave item_suit");
		return;
	}

	if (!StrICompare(name, "item_battery"))
	{
		hl_ent_player_armor = HLENT_MAX_ARMOR;
		HLConPrint("gave item_battery");
		return;
	}

	if (!StrICompare(name, "item_healthkit"))
	{
		hl_ent_player_health = HLENT_MAX_HEALTH;
		HLConPrint("gave item_healthkit");
		return;
	}

	StrPrint(msg, "give: no such item \"%s\"", name);
	HLConPrint(msg);
}

U0 HLConSelectItem(U8 *args)
{//ClientCommand "use" and the weapon_* forms, both CBasePlayer::SelectItem.
 //The argument is a weapon classname, not a targetname: HL's +use is a key,
 //not a console command
	U8	msg[96];
	U8	name[64];
	I64	id;
	I64	i = 0;

	while (args[i] && args[i] != ' ' && args[i] != '\t' && i < 63)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
	{
		HLConPrint("use <classname>, e.g. use weapon_shotgun");
		return;
	}

	id = HLWeaponFindByClass(name);

	//SelectItem walks the carried items only, so an unowned weapon is silently
	//nothing rather than an error
	if (id < 0 || !hl_wpn_have[id])
		return;

	if (id == hl_wpn_active)
		return;

	hl_con_wpn_prev = hl_wpn_active;
	hl_con_wpn_seen = id;
	HLWeaponSetActive(id);

	StrPrint(msg, "selected %s", name);
	HLConPrint(msg);
}

U0 HLConLastInv()
{//ClientCommand "lastinv" - CBasePlayer::SelectLastItem
	if (hl_con_wpn_prev < 0 || !hl_wpn_have[hl_con_wpn_prev])
		return;

	if (hl_con_wpn_prev == hl_wpn_active)
		return;

	hl_con_wpn_seen = hl_con_wpn_prev;
	hl_con_wpn_prev = hl_wpn_active;
	HLWeaponSetActive(hl_con_wpn_seen);
}

U0 HLConDrop(U8 *args)
{//ClientCommand "drop" - CBasePlayer::DropPlayerItem
	U8	name[64];
	I64	id;
	I64	i = 0;

	//the SDK's first test: single player never drops, and weaponstay makes
	//multiplayer behave the same way
	if (HLCvarGet("deathmatch") == 0.0 && HLCvarGet("coop") == 0.0)
	{
		HLConPrint("no dropping in single player");
		return;
	}

	while (args[i] && args[i] != ' ' && args[i] != '\t' && i < 63)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	//an empty name means the active item, as it does in the SDK
	if (!name[0])
		id = hl_wpn_active;
	else
		id = HLWeaponFindByClass(name);

	if (id < 0 || !hl_wpn_have[id])
		return;

	HLConPrint("drop: no weaponbox - the port cannot create an entity after the map's entity lump is parsed");
}

U0 HLConStatus()
{//Host_Status_f, cut to what this build can report
	U8 msg[96];

	StrPrint(msg, "map %s", hl_map_name);
	HLConPrint(msg);

	StrPrint(msg, "entities %d  time %4.1f", HLEntCountInUse, hl_game_time);
	HLConPrint(msg);

	//Native player state, not the QuakeC edict: single player has no edict.
	StrPrint(msg, "health %d  armor %d  suit %d",
		ToI64(hl_ent_player_health), ToI64(hl_ent_player_armor),
		HLStairFlag(hl_ent_player_suit));
	HLConPrint(msg);

	StrPrint(msg, "godmode %d  notarget %d",
		HLStairFlag(hl_ent_godmode), HLStairFlag(hl_ent_notarget));
	HLConPrint(msg);
}

//--- Cmd_ token walk --------------------------------------------------------

I64 HLConToken(U8 *out, U8 *src, I64 i, I64 max)
{//one space-delimited word into out, returns the index just past it
	I64 n = 0;

	while (src[i] == ' ' || src[i] == '\t')
		i++;

	while (src[i] && src[i] != ' ' && src[i] != '\t' && n < max - 1)
	{
		out[n] = src[i];
		n++;
		i++;
	}
	out[n] = 0;

	//an over-long word must not leave the rest of it as the next token
	while (src[i] && src[i] != ' ' && src[i] != '\t')
		i++;

	return i;
}

I64 HLConSkipSpace(U8 *src, I64 i)
{
	while (src[i] == ' ' || src[i] == '\t')
		i++;
	return i;
}

U0 HLCmdBindList()
{//Key_WriteBindings' shape, to the console instead of a file
	U8	msg[80];
	U8	keyname[24];
	I64	i;

	for (i = 0; i < HLBIND_COUNT; i++)
	{
		HLBindKeyName(keyname, hl_bind_key[i]);
		StrPrint(msg, "\"%s\" = \"%s\"", keyname, hl_bind_cmd[i]);
		HLConPrint(msg);
	}
}

U0 HLCmdBind(U8 *args)
{//Key_Bind_f. no args lists, key alone reports, key+action binds
	U8	key[24];
	U8	act[32];
	U8	keyname[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	I64	slot;

	i = HLConSkipSpace(args, 0);
	if (!args[i])
	{
		HLCmdBindList;
		return;
	}

	i = HLConToken(key, args, i, 24);
	sc = HLBindKeyParse(key);
	if (sc <= 0)
	{
		StrPrint(msg, "\"%s\" isn't a valid key", key);
		HLConPrint(msg);
		return;
	}

	i = HLConSkipSpace(args, i);
	if (!args[i])
	{
		for (slot = 0; slot < HLBIND_COUNT; slot++)
		{
			if (hl_bind_key[slot] == sc)
			{
				StrPrint(msg, "\"%s\" = \"%s\"", key, hl_bind_cmd[slot]);
				HLConPrint(msg);
				return;
			}
		}

		StrPrint(msg, "\"%s\" is not bound", key);
		HLConPrint(msg);
		return;
	}

	HLConToken(act, args, i, 32);
	slot = HLBindFindAction(act);
	if (slot < 0)
	{
		StrPrint(msg, "no such action: %s", act);
		HLConPrint(msg);
		return;
	}

	//one key drives one action, as the customize page enforces
	for (i = 0; i < HLBIND_COUNT; i++)
	{
		if (i != slot && hl_bind_key[i] == sc)
			hl_bind_key[i] = 0;
	}

	hl_bind_key[slot] = sc;
	HLCfgSave;

	HLBindKeyName(keyname, sc);
	StrPrint(msg, "bound %s to %s", keyname, hl_bind_cmd[slot]);
	HLConPrint(msg);
}

U0 HLCmdUnbind(U8 *args)
{//Key_Unbind_f
	U8	key[24];
	U8	msg[80];
	I64	i;
	I64	sc;
	Bool hit = FALSE;

	HLConToken(key, args, 0, 24);
	sc = HLBindKeyParse(key);
	if (sc <= 0)
	{
		HLConPrint("unbind <key>");
		return;
	}

	for (i = 0; i < HLBIND_COUNT; i++)
	{
		if (hl_bind_key[i] == sc)
		{
			hl_bind_key[i] = 0;
			hit = TRUE;
		}
	}

	if (!hit)
	{
		StrPrint(msg, "\"%s\" is not bound", key);
		HLConPrint(msg);
		return;
	}

	HLCfgSave;
	StrPrint(msg, "unbound %s", key);
	HLConPrint(msg);
}

U0 HLCmdUnbindAll()
{//Key_Unbindall_f. the config keeps its bind lines, they just read 0
	I64 i;

	for (i = 0; i < HLBIND_COUNT; i++)
		hl_bind_key[i] = 0;

	HLCfgSave;
	HLConPrint("all keys unbound");
}

U0 HLCmdCvarList()
{//Cvar_List_f
	U8	msg[80];
	U8	vbuf[32];
	I64	i;

	for (i = 0; i < hl_cvar_count; i++)
	{
		HLCvarValueStr(vbuf, hl_cvars[i].value);
		StrPrint(msg, "%s \"%s\"", hl_cvars[i].name, vbuf);
		HLConPrint(msg);
	}

	StrPrint(msg, "%d cvars", hl_cvar_count);
	HLConPrint(msg);
}

U0 HLCmdAliasList()
{
	U8	msg[80];
	I64	i;

	if (!hl_alias_count)
	{
		HLConPrint("no alias commands");
		return;
	}

	for (i = 0; i < hl_alias_count; i++)
	{
		StrPrint(msg, "%s : %s", hl_alias_name + i * HLALIAS_NAME,
			hl_alias_text + i * HLALIAS_TEXT);
		HLConPrint(msg);
	}
}

U0 HLCmdAlias(U8 *args)
{//Cmd_Alias_f. no args lists, name alone is a redefine to nothing useful so
 //it lists that one instead
	U8	name[HLALIAS_NAME];
	U8	msg[80];
	I64	i;
	I64	slot;

	i = HLConSkipSpace(args, 0);
	if (!args[i])
	{
		HLCmdAliasList;
		return;
	}

	i = HLConToken(name, args, i, HLALIAS_NAME);
	i = HLConSkipSpace(args, i);

	slot = HLAliasFind(name);

	if (!args[i])
	{
		if (slot < 0)
			StrPrint(msg, "no alias named %s", name);
		else
			StrPrint(msg, "%s : %s", name, hl_alias_text + slot * HLALIAS_TEXT);
		HLConPrint(msg);
		return;
	}

	if (slot < 0)
	{
		if (hl_alias_count >= HLALIAS_MAX)
		{
			HLConPrint("alias table full");
			return;
		}
		slot = hl_alias_count;
		hl_alias_count++;
	}

	HLStrCopy(hl_alias_name + slot * HLALIAS_NAME, name, HLALIAS_NAME);
	HLStrCopy(hl_alias_text + slot * HLALIAS_TEXT, args + i, HLALIAS_TEXT);

	StrPrint(msg, "%s : %s", hl_alias_name + slot * HLALIAS_NAME,
		hl_alias_text + slot * HLALIAS_TEXT);
	HLConPrint(msg);
}

U0 HLCmdUnalias(U8 *args)
{//not in id, but unbind has no counterpart here without it
	U8	name[HLALIAS_NAME];
	U8	msg[80];
	I64	slot;
	I64	i;

	HLConToken(name, args, 0, HLALIAS_NAME);
	if (!name[0])
	{
		HLConPrint("unalias <name>");
		return;
	}

	slot = HLAliasFind(name);
	if (slot < 0)
	{
		StrPrint(msg, "no alias named %s", name);
		HLConPrint(msg);
		return;
	}

	//swap the tail down, the table has no ordering to keep
	for (i = slot; i < hl_alias_count - 1; i++)
	{
		HLStrCopy(hl_alias_name + i * HLALIAS_NAME,
			hl_alias_name + (i + 1) * HLALIAS_NAME, HLALIAS_NAME);
		HLStrCopy(hl_alias_text + i * HLALIAS_TEXT,
			hl_alias_text + (i + 1) * HLALIAS_TEXT, HLALIAS_TEXT);
	}

	hl_alias_count--;
	hl_alias_name[hl_alias_count * HLALIAS_NAME] = 0;
	hl_alias_text[hl_alias_count * HLALIAS_TEXT] = 0;

	StrPrint(msg, "removed alias %s", name);
	HLConPrint(msg);
}

Bool hl_con_want_bf = FALSE;

U0 HLConExec(U8 *line, Bool echo = TRUE)
{//unknown input is echoed, not swallowed, so a typo looks like a typo
 //
 //echo: the "]line" receipt belongs to what the user typed. Cbuf_AddText
 //prints nothing, so a stuffcmd must not either - QuakeC sends bf on every
 //pickup
	U8  msg[80];
	U8 *role;
	U32 myip;
	I64 si;
	I64 e;
	CHLNetSock *sock;

	//Host_Color_f scratch
	U8 *p;
	I64 ctop;
	I64 cbot;

	//exec / alias scratch. one line at a time, so nothing here outlives the
	//call that filled it
	U8  *raw;
	U8   fline[128];
	U8   acmd[HLALIAS_TEXT];
	U8   aname[HLALIAS_NAME];
	I64  fsize;
	I64  fi;
	I64  fn;
	I64  ai;
	I64  an;
	I64  aslot;

	if (!line[0])
		return;

	if (echo)
	{
		StrPrint(msg, "]%s", line);
		HLConPrint(msg);
	}

	//--- level control ---
	//heap sweep, off by default - it walks every live allocation. needs the
	//kernel built with _CONFIG_HEAP_DEBUG to catch overruns into live blocks
	if (!StrNICompare(line, "heapcheck", 9))
	{
		if (line[9] == ' ')
			hl_heap_check_on = ToBool(HLAtoF(line + 10) != 0.0);
		else
			hl_heap_check_on = !hl_heap_check_on;

		if (hl_heap_check_on)
			HLConPrint("heapcheck on");
		else
			HLConPrint("heapcheck off");
		return;
	}

	//COM_AddGameDirectory. mounting happens at startup, and the archives back
	//every model and sound in use, so this only records the directory
	//"game <dir>" and "game" for plain valve. deferred rather than done here:
	//this file compiles before the shell that owns the archives, and the swap
	//frees every pak while lookups are still handing out interior pointers
	if (!StrNICompare(line, "game ", 5) || !StrICompare(line, "game"))
	{
		if (line[4])
			HLStrCopy(hl_gamedir_next, line + 5, 32);
		else
			hl_gamedir_next[0] = 0;

		hl_gamedir_pending = TRUE;
		HLConPrint("switching gamedir");
		return;
	}

	//CL_PlayDemo_f / CL_Stop_f
	if (!StrNICompare(line, "playdemo ", 9))
	{
		if (HLDemoStart(line + 9))
			HLConPrint("playing demo");
		else
			HLConPrint("couldn't open demo");
		return;
	}

	//Host_Demos_f: the attract loop cycles demo1..3 behind the main menu
	if (!StrICompare(line, "demos"))
	{
		hl_demo_loop_index = 0;
		if (HLDemoNextInLoop)
			HLConPrint("demo loop started");
		else
			HLConPrint("no demos found");
		return;
	}

	//Host_Color_f. one argument sets both, two set shirt then trousers.
	//THE TROUSER COLOUR IS THE TEAM - HLSvApplyClientColors writes .team from
	//it, so this has to reach the edict rather than only the config, or a
	//player who changes colour mid-game keeps their old team
	if (!StrNICompare(line, "color ", 6))
	{
		p = line + 6;
		while (*p == ' ')
			p++;

		ctop = ClampI64(ToI64(HLAtoF(p)), 0, 13);

		//second number if there is one, else shirt and trousers match
		while (*p && *p != ' ')
			p++;
		while (*p == ' ')
			p++;

		if (*p)
			cbot = ClampI64(ToI64(HLAtoF(p)), 0, 13);
		else
			cbot = ctop;

		hl_setup_top    = ctop;
		hl_setup_bottom = cbot;

		if (hl_player_active && hl_player_edict > 0)
			HLSvApplyClientColors(hl_player_edict, ctop, cbot);

		//force the identity out again so remotes see the new colours
		si = HLSvFindLocalSlot;
		if (si >= 0)
			hl_sv_clients[si].sent_ident = FALSE;

		HLCfgSave;
		StrPrint(msg, "color %d %d", ctop, cbot);
		HLConPrint(msg);
		return;
	}

	//Cvar hostname. a string, so it is a command here rather than a cvar row
	if (!StrNICompare(line, "hostname ", 9))
	{
		HLStrCopy(hl_host_name, line + 9, 32);
		HLCfgSave;
		HLConPrint("hostname set");
		return;
	}

	if (!StrICompare(line, "hostname"))
	{
		StrPrint(msg, "hostname is %s", hl_host_name);
		HLConPrint(msg);
		return;
	}

	if (!StrICompare(line, "stopdemo"))
	{
		HLDemoStop;
		hl_demo_loop = FALSE;
		HLConPrint("demo stopped");
		return;
	}

	if (!StrNICompare(line, "map ", 4))
	{
		HLStrCopy(hl_change_map, line + 4, 64);
		hl_change_pending = TRUE;
		return;
	}

	if (!StrNICompare(line, "changelevel ", 12))
	{
		HLStrCopy(hl_change_map, line + 12, 64);
		hl_change_pending = TRUE;
		return;
	}

	//NET_Slist_f. asynchronous by design, see HLConSlist
	if (!StrICompare(line, "slist"))
	{
		HLConSlist;
		return;
	}

	//netstat - what the client/server split is doing. not original, net_stats
	//is the closest thing
	if (!StrICompare(line, "netstat"))
	{
		//40 columns each. the mismatch count gets its own line - it decides
		//whether the client's reconstruction can be drawn from at all
		StrPrint(hl_con_net_line, "net: %d ents, %d bytes, %d parsed",
			hl_net_num_ents, hl_net_datagram.len, hl_net_parsed);
		HLConPrint(hl_con_net_line);

		StrPrint(hl_con_net_line, "net: MISMATCHED %d, dropped %d",
			hl_net_mismatch_report, hl_net_dropped);
		HLConPrint(hl_con_net_line);

		StrPrint(hl_con_net_line, "net: hp %d ar %d am %d wp %d",
			hl_cl.health, hl_cl.armorvalue, hl_cl.currentammo, hl_cl.weapon);
		HLConPrint(hl_con_net_line);

		StrPrint(hl_con_net_line, "net: %d clients connected",
			hl_sv_client_count);
		HLConPrint(hl_con_net_line);

		//host side: where each remote body is right now
		if (hl_udp_ready && hl_udp_server)
		{
			for (si = 0; si < HLSV_MAX_CLIENTS; si++)
			{
				if (!hl_sv_clients[si].active || hl_sv_clients[si].local)
					goto ns_next;

				e = hl_sv_clients[si].edict;
				if (e > 0)
					StrPrint(hl_con_net_line,
						"net: remote[%d] edict %d at %.0f %.0f %.0f",
						si, e,
						hl_sv_clients[si].origin[0],
						hl_sv_clients[si].origin[1],
						hl_sv_clients[si].origin[2]);
				else
					StrPrint(hl_con_net_line,
						"net: remote[%d] edict 0 (not spawned)", si);
				HLConPrint(hl_con_net_line);

				sock = HLNetDgrmSock(si);
				if (sock && sock->active)
				{
					StrPrint(hl_con_net_line,
						"net: remote[%d] udp %d.%d.%d.%d:%d signon %d",
						si,
						sock->ip & 255, (sock->ip >> 8) & 255,
						(sock->ip >> 16) & 255, (sock->ip >> 24) & 255,
						sock->port, hl_sv_clients[si].signon);
					HLConPrint(hl_con_net_line);
				}

ns_next:
			}
		}

		StrPrint(hl_con_net_line, "net: moves %d/%d ping %4.1fms",
			hl_net_moves_sent, hl_net_moves_read, hl_net_move_ping * 1000.0);
		HLConPrint(hl_con_net_line);

		HLConPrint(hl_udp_status);

		myip = HLNetLocalIP();
		StrPrint(hl_con_net_line, "udp: local ip %d.%d.%d.%d",
			myip & 255, (myip >> 8) & 255,
			(myip >> 16) & 255, (myip >> 24) & 255);
		HLConPrint(hl_con_net_line);

		if (hl_udp_ready)
		{
			if (hl_udp_server)
				role = "hosting";
			else
				role = "joined";

			StrPrint(hl_con_net_line, "udp: %s peer %d.%d.%d.%d",
				role,
				hl_udp_peer_ip & 255, (hl_udp_peer_ip >> 8) & 255,
				(hl_udp_peer_ip >> 16) & 255, (hl_udp_peer_ip >> 24) & 255);
			HLConPrint(hl_con_net_line);

			StrPrint(hl_con_net_line, "udp: %d sent %d recvd %d err %d unresolved",
				hl_udp_sent, hl_udp_recvd, hl_udp_errors, hl_udp_unresolved);
			HLConPrint(hl_con_net_line);

			if (hl_udp_peer_ip)
			{
				if (HLNetUdpPeerResolved)
					HLConPrint("udp: peer mac RESOLVED");
				else
				{
					StrPrint(hl_con_net_line,
						"udp: peer mac UNRESOLVED, %d sends skipped",
						hl_udp_unresolved);
					HLConPrint(hl_con_net_line);
				}
			}
		}
		return;
	}

	//qip <a.b.c.d> - static address for a link with no DHCP, which is two QEMU
	//guests wired together with -netdev socket
	if (!StrNICompare(line, "qip ", 4))
	{
		if (!HLNetUdpAvailable())
		{
			HLConPrint("no net stack - run RunNet.ZC, not Run.ZC");
			return;
		}

		//print the status either way, it names which failure
		HLNetUdpSetLocalIP(HLConParseIPV4(line + 4));
		HLConPrint(hl_udp_status);
		return;
	}

	//netdhcp - useless on a direct VM-to-VM link, it just times out
	if (!StrICompare(line, "netdhcp"))
	{
		if (!HLNetUdpAvailable())
		{
			HLConPrint("no net stack - run RunNet.ZC");
			return;
		}

		HLConPrint("dhcp: asking, this may take a few seconds...");
		HLNetDhcp;
		HLConPrint(hl_udp_status);
		return;
	}

	//stairlog 1 - every step-up attempt and whether it was kept
	if (!StrNICompare(line, "stairlog ", 9))
	{
		hl_stair_log     = ToBool(Str2I64(line + 9) != 0);
		hl_stair_reports = 0;

		if (hl_stair_log)
			HLConPrint("stair logging ON - see HL1LOG.TXT");
		else
			HLConPrint("stair logging off");
		return;
	}

	//bf - V_BonusFlash_f. stuffed by QuakeC on every pickup, so it arrives far
	//more often than it is typed
	if (!StrICompare(line, "bf"))
	{
		hl_con_want_bf = TRUE;
		return;
	}

	//CDAudio_Play / CDAudio_Stop
	if (!StrNICompare(line, "music ", 6))
	{
		if (!StrICompare(line + 6, "stop"))
		{
			HLMusicFree;
			AudioSFXStopAll;
			HLConPrint("music stopped");
		}
		else
		{
			HLMusicPlay(Str2I64(line + 6), tS);
			HLConPrint(hl_music_status);
		}
		return;
	}

	//Host_Connect_f. parses the quad itself instead of calling
	//PresentationToNetwork, so this file compiles with no net stack
	if (!StrNICompare(line, "connect ", 8))
	{
		HLConConnect(line + 8);
		return;
	}

	//bare connect would fall through to the cvar lookup and come back as
	//"unknown command", which reads as the command not existing
	if (!StrICompare(line, "connect"))
	{
		HLConPrint("usage: connect 10.0.0.1");
		return;
	}

	if (!StrICompare(line, "disconnect"))
	{
		HLNetUdpClose;
		hl_cl_viewent = 0;
		HLConPrint("disconnected");
		return;
	}

	//Host_Say_f via Cmd_ForwardToServer. on a listen host the console pauses
	//the server tick, so call Host_Say directly; a guest forwards over UDP
	if (!StrNICompare(line, "say_team ", 9))
	{
		if (hl_udp_ready && !hl_udp_server)
			HLNetClientSendStringCmd(line);
		else if (hl_game_active)
		{
			HLHostSay(HLSvFindLocalSlot, line + 9, TRUE);
			HLConDrainProgs;
		}
		else
			HLConPrint("Can't \"say_team\", not connected");
		return;
	}
	if (!StrICompare(line, "say_team"))
	{
		HLConPrint("usage: say_team <text>");
		return;
	}
	if (!StrNICompare(line, "say ", 4))
	{
		if (hl_udp_ready && !hl_udp_server)
			HLNetClientSendStringCmd(line);
		else if (hl_game_active)
		{
			HLHostSay(HLSvFindLocalSlot, line + 4, FALSE);
			HLConDrainProgs;
		}
		else
			HLConPrint("Can't \"say\", not connected");
		return;
	}
	if (!StrICompare(line, "say"))
	{
		HLConPrint("usage: say <text>");
		return;
	}
	if (!StrNICompare(line, "tell ", 5))
	{
		if (hl_udp_ready && !hl_udp_server)
			HLNetClientSendStringCmd(line);
		else if (hl_game_active)
		{
			HLHostTell(HLSvFindLocalSlot, line + 5);
			HLConDrainProgs;
		}
		else
			HLConPrint("Can't \"tell\", not connected");
		return;
	}
	if (!StrICompare(line, "tell"))
	{
		HLConPrint("usage: tell <name> <text>");
		return;
	}

	if (!StrICompare(line, "host"))
	{
		//under SLIRP prefer DHCP (10.0.2.15) - AutoIP 10.0.0.1 is socket MP
		//only and breaks hostfwd replies
		if (!HLNetLocalIP)
			HLNetDhcp;
		if (!HLNetLocalIP)
			HLNetAutoIP(0);

		if (HLNetUdpOpen(HLNET_PORT_DEFAULT))
		{
			hl_udp_server = TRUE;
			HLNetDgrmInit;
			HLConPrint(hl_udp_status);
			HLConPrint("hosting - clients may connect to this ip");
		}
		else
			HLConPrint(hl_udp_status);
		return;
	}

	//diskwrite 0|1 - kill every write this app makes, for bisecting the crash
	//on quit. not an original command
	if (!StrNICompare(line, "diskwrite ", 10))
	{
		hl_disk_writes = ToBool(Str2I64(line + 10) != 0);
		if (hl_disk_writes)
			HLConPrint("disk writes enabled");
		else
			HLConPrint("disk writes DISABLED");
		return;
	}

	//explicit set, the fallthrough at the bottom handles the bare form
	if (!StrNICompare(line, "set ", 4))
	{
		HLConCvar(line + 4);
		return;
	}

	if (!StrICompare(line, "restart"))
	{
		//what QuakeC's respawn() stuffs on a single-player death
		hl_restart_pending = TRUE;
		return;
	}

	//--- movement cheats. Host_Noclip_f and Host_Fly_f swap the movetype; the
	//--- flycam stands in, player movement is driven from this side
	if (!StrICompare(line, "noclip"))
	{
		if (!HLConCheatAllowed)
			return;

		hl_con_want_noclip = TRUE;
		HLConPrint("noclip toggled");
		return;
	}

	if (!StrICompare(line, "fly"))
	{
		if (!HLConCheatAllowed)
			return;

		hl_con_want_noclip = TRUE;
		HLConPrint("fly mode toggled");
		return;
	}

	//--- flag cheats, as Host_God_f and Host_Notarget_f do it
	if (!StrICompare(line, "god"))
	{
		if (!HLConCheatAllowed)
			return;

		hl_ent_godmode = !hl_ent_godmode;
		HLConReportFlag("godmode", hl_ent_godmode);
		return;
	}

	if (!StrICompare(line, "notarget"))
	{
		if (!HLConCheatAllowed)
			return;

		hl_ent_notarget = !hl_ent_notarget;
		HLConReportFlag("notarget", hl_ent_notarget);
		return;
	}

	if (!StrICompare(line, "kill"))
	{
		//ClientKill is not a cheat in HL and is not gated on sv_cheats.
		HLEntKillPlayer;
		HLConPrint("killed");
		return;
	}

	//--- impulse: QuakeC consumes .impulse once. every weapon switch and
	//--- cheat code arrives this way
	if (!StrNICompare(line, "impulse ", 8))
	{
		//The gate is inside: weapon selection impulses are not cheats.
		HLConImpulse(Str2I64(line + 8));
		return;
	}

	if (!StrNICompare(line, "give ", 5))
	{
		if (!HLConCheatAllowed)
			return;
		HLConGive(line + 5);
		return;
	}

	//ClientCommand "fov". Setting is gated on sv_cheats; reporting is not
	if (!StrNICompare(line, "fov ", 4))
	{
		if (!HLConCheatAllowed)
			return;

		//hl_fov is in the app shell, compiled after this file - request it
		hl_con_fov_want = ToF64(Str2I64(line + 4));
		if (hl_con_fov_want < 30.0)	hl_con_fov_want = 30.0;
		if (hl_con_fov_want > 130.0)	hl_con_fov_want = 130.0;
		hl_con_fov_last = hl_con_fov_want;
		StrPrint(msg, "fov %d", ToI64(hl_con_fov_want));
		HLConPrint(msg);
		return;
	}

	if (!StrICompare(line, "fov"))
	{
		StrPrint(msg, "\"fov\" is \"%d\"", ToI64(hl_con_fov_last));
		HLConPrint(msg);
		return;
	}

	//ClientCommand "drop"
	if (!StrNICompare(line, "drop ", 5))
	{
		HLConDrop(line + 5);
		return;
	}

	if (!StrICompare(line, "drop"))
	{
		HLConDrop("");
		return;
	}

	//ClientCommand "use" and the weapon_* forms, both SelectItem
	if (!StrNICompare(line, "use ", 4))
	{
		HLConSelectItem(line + 4);
		return;
	}

	if (!StrICompare(line, "use"))
	{
		HLConPrint("use <classname>, e.g. use weapon_shotgun");
		return;
	}

	if (!StrNICompare(line, "weapon_", 7))
	{
		HLConSelectItem(line);
		return;
	}

	if (!StrICompare(line, "lastinv"))
	{
		HLConLastInv;
		return;
	}

	//ClientCommand "fullupdate" - ForceClientDllUpdate resends every HUD value
	//the client caches. The HUD here is drawn from live state each frame, so
	//there is nothing to resend; a guest still forwards it to its host
	if (!StrICompare(line, "fullupdate"))
	{
		if (hl_udp_ready && !hl_udp_server)
			HLNetClientSendStringCmd(line);
		else
			HLConPrint("fullupdate: the hud reads live state, nothing to resend");
		return;
	}

	//ClientCommand "closemenus" - ignored there too
	if (!StrICompare(line, "closemenus"))
		return;

	if (!StrICompare(line, "save"))
	{
		if (hl_con_save_ok)
			HLConPrint("saved");
		else
			HLConPrint("save failed");
		hl_con_want_save = TRUE;
		return;
	}

	if (!StrICompare(line, "load"))
	{
		hl_con_want_load = TRUE;
		return;
	}

	if (!StrICompare(line, "status"))
	{
		HLConStatus;
		return;
	}

	if (!StrICompare(line, "version"))
	{
		HLConPrint("HL1 shareware data, engine written for ZealOS");
		return;
	}

	if (!StrICompare(line, "quit"))
	{
		hl_con_want_quit = TRUE;
		return;
	}

	//--- binds, aliases and scripts ---
	if (!StrNICompare(line, "bind ", 5))
	{
		HLCmdBind(line + 5);
		return;
	}

	if (!StrICompare(line, "bind"))
	{
		HLCmdBindList;
		return;
	}

	if (!StrNICompare(line, "unbindall", 9))
	{
		HLCmdUnbindAll;
		return;
	}

	if (!StrNICompare(line, "unbind ", 7))
	{
		HLCmdUnbind(line + 7);
		return;
	}

	//Cmd_Echo_f: everything after the keyword, verbatim
	if (!StrNICompare(line, "echo ", 5))
	{
		HLConPrint(line + 5);
		return;
	}

	if (!StrICompare(line, "echo"))
	{
		HLConPrint("");
		return;
	}

	if (!StrICompare(line, "cvarlist"))
	{
		HLCmdCvarList;
		return;
	}

	if (!StrNICompare(line, "alias ", 6))
	{
		HLCmdAlias(line + 6);
		return;
	}

	if (!StrICompare(line, "alias"))
	{
		HLCmdAliasList;
		return;
	}

	if (!StrNICompare(line, "unalias ", 8))
	{
		HLCmdUnalias(line + 8);
		return;
	}

	//Cmd_Wait_f defers the rest of the command buffer by a frame. this
	//dispatcher runs one line to completion with nothing queued behind it,
	//so there is nothing to defer - accepted and ignored
	if (!StrICompare(line, "wait"))
		return;

	//Cmd_Exec_f. pak first like COM_LoadFile, then the disk
	if (!StrNICompare(line, "exec ", 5))
	{
		fi = HLConSkipSpace(line, 5);
		HLConToken(fline, line, fi, 128);

		fsize = 0;
		raw   = HLFileLoad(fline, &fsize);

		if (!raw && FileFind(fline))
			raw = FileRead(fline, &fsize);

		if (!raw || fsize <= 0)
		{
			if (raw)
				Free(raw);
			StrPrint(msg, "couldn't exec %s", fline);
			HLConPrint(msg);
			return;
		}

		StrPrint(msg, "execing %s", fline);
		HLConPrint(msg);

		fi = 0;
		while (fi < fsize)
		{
			fn = 0;
			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r' && fn < 127)
			{
				fline[fn] = raw[fi];
				fn++;
				fi++;
			}
			fline[fn] = 0;

			while (fi < fsize && raw[fi] != '\n' && raw[fi] != '\r')
				fi++;
			while (fi < fsize && (raw[fi] == '\n' || raw[fi] == '\r'))
				fi++;

			//strip a // comment tail, then trailing blanks
			for (an = 0; an < fn - 1; an++)
			{
				if (fline[an] == '/' && fline[an + 1] == '/')
				{
					fline[an] = 0;
					fn = an;
					break;
				}
			}
			while (fn > 0 && (fline[fn - 1] == ' ' || fline[fn - 1] == '\t'))
			{
				fn--;
				fline[fn] = 0;
			}

			//leading blanks too, a config is indented like source
			an = 0;
			while (fline[an] == ' ' || fline[an] == '\t')
				an++;

			if (fline[an])
				HLConExec(fline + an, FALSE);
		}

		Free(raw);
		return;
	}

	if (!StrICompare(line, "help"))
	{
		HLConPrint("map <n>  changelevel <n>  restart  save  load");
		HLConPrint("god  notarget  noclip  fly  kill");
		HLConPrint("give <classname>  drop [classname]  use <classname>");
		HLConPrint("weapon_<name>  lastinv  fov [n]  fullupdate");
		HLConPrint("impulse <n>: 100 light, 101 all, 103 ai, 104 globals, 106 name, 203 remove");
		HLConPrint("say <text>  say_team <text>  tell <name> <text>");
		HLConPrint("bind <key> <action>  unbind <key>  unbindall");
		HLConPrint("alias <n> <text>  unalias <n>  exec <file>");
		HLConPrint("echo <text>  cvarlist  set <name> <v>  wait");
		HLConPrint("connect <ip>  disconnect  host  slist  netstat  qip <ip>");
		HLConPrint("playdemo <n>  demos  stopdemo  music <n|stop>");
		HLConPrint("hostname [name]  color <t> <b>  status  version  quit");
		return;
	}

	//--- alias expansion ---
	//Cmd_ExecuteString checks the alias list after the builtins and before
	//Cvar_Command, so an alias can't shadow a real command
	HLConToken(aname, line, 0, HLALIAS_NAME);
	aslot = HLAliasFind(aname);
	if (aslot >= 0)
	{
		//an alias naming itself would spin forever, so cap the nesting the
		//way the original caps its alias loop
		if (hl_alias_depth >= HLALIAS_DEPTH)
		{
			HLConPrint("alias recursion too deep");
			return;
		}

		HLStrCopy(acmd, hl_alias_text + aslot * HLALIAS_TEXT, HLALIAS_TEXT);
		hl_alias_depth++;

		//semicolons split, as Cbuf_InsertText's parse does
		ai = 0;
		while (acmd[ai])
		{
			an = 0;
			while (acmd[ai] && acmd[ai] != ';' && an < HLALIAS_TEXT - 1)
			{
				fline[an] = acmd[ai];
				an++;
				ai++;
			}
			fline[an] = 0;

			while (acmd[ai] == ';')
				ai++;

			while (an > 0 && (fline[an - 1] == ' ' || fline[an - 1] == '\t'))
			{
				an--;
				fline[an] = 0;
			}

			fn = 0;
			while (fline[fn] == ' ' || fline[fn] == '\t')
				fn++;

			if (fline[fn])
				HLConExec(fline + fn, FALSE);
		}

		hl_alias_depth--;
		return;
	}

	//last resort, as Cmd_ExecuteString does: no command matched, so fall
	//through to Cvar_Command. this is why the original has no set keyword
	if (HLConCvarCommand(line))
		return;

	HLConPrint("unknown command");
}

U0 HLMsgModeBegin(Bool team)
{//Con_MessageMode_f / Con_MessageMode2_f
	hl_msg_mode  = TRUE;
	hl_msg_team  = team;
	hl_chat_buf[0] = 0;
	hl_chat_len    = 0;
}

U0 HLMsgModeCancel()
{
	hl_msg_mode  = FALSE;
	hl_msg_team  = FALSE;
	hl_chat_buf[0] = 0;
	hl_chat_len    = 0;
}

U0 HLMsgModeInput()
{//Key_Message: type into chat_buffer, Enter sends say / say_team.
 //sits after HLConExec, single-pass compiler
	I64	 i;
	I64	 sc;
	U8	 ch;
	U8	 cmd[48];

	if (!hl_msg_mode)
		return;

	if (HLConKeyEdge(SC_ESC))
	{
		HLMsgModeCancel;
		return;
	}

	if (HLConKeyEdge(SC_ENTER))
	{
		if (hl_chat_len > 0)
		{
			if (hl_msg_team)
				StrPrint(cmd, "say_team %s", hl_chat_buf);
			else
				StrPrint(cmd, "say %s", hl_chat_buf);

			//no receipt. the "]say lol" line belongs to a command TYPED at the
			//console; messagemode already showed the text as it was entered,
			//and the server echoes it back as "name: lol" for everyone. three
			//copies of one message is two too many
			HLConExec(cmd, FALSE);
		}
		HLMsgModeCancel;
		return;
	}

	if (HLConKeyEdge(SC_BACKSPACE) && hl_chat_len > 0)
	{
		hl_chat_len--;
		hl_chat_buf[hl_chat_len] = 0;
		return;
	}

	i = 0;
	while (hl_con_charset[i])
	{
		ch = hl_con_charset[i];
		sc = Char2ScanCode(ch);
		if (HLConKeyEdge(sc) && hl_chat_len < 31)
		{
			hl_chat_buf[hl_chat_len] = ch;
			hl_chat_len++;
			hl_chat_buf[hl_chat_len] = 0;
		}
		i++;
	}

	if (HLConKeyEdge(Char2ScanCode('-')) && hl_chat_len < 31)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			hl_chat_buf[hl_chat_len] = '_';
		else
			hl_chat_buf[hl_chat_len] = '-';
		hl_chat_len++;
		hl_chat_buf[hl_chat_len] = 0;
	}
}

U0 HLConDrainStuff()
{//Cbuf_Execute. stuffcmd text IS console text, so it goes through the same
 //executor and anything the console understands works
	U8	cmd[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (hl_bi_stuff_len < 1)
		return;

	for (i = 0; i < hl_bi_stuff_len; i++)
	{
		c = hl_bi_stuff_buf[i];

		if (c == '\n' || c == ';' || n >= 126)
		{
			cmd[n] = 0;
			if (n > 0)
				HLConExec(cmd, FALSE);
			n = 0;
		}

		if (c != '\n' && c != ';')
		{
			cmd[n] = c;
			n++;
		}
	}

	if (n > 0)
	{
		cmd[n] = 0;
		HLConExec(cmd);
	}

	hl_bi_stuff_len    = 0;
	hl_bi_stuff_buf[0] = 0;
}

U0 HLConInput()
{//one frame of typing
	I64 i;
	I64 sc;
	I64 ch;

	//printable characters
	i = 0;
	while (hl_con_charset[i])
	{
		ch = hl_con_charset[i];
		sc = Char2ScanCode(ch);

		if (HLConKeyEdge(sc) && hl_con_input_len < HLCON_INPUT_MAX)
		{
			hl_con_input[hl_con_input_len] = ch;
			hl_con_input_len++;
			hl_con_input[hl_con_input_len] = 0;
		}

		i++;
	}

	//minus resolved by shift, one edge check so the two characters can't
	//fight over the key
	if (HLConKeyEdge(Char2ScanCode('-')) && hl_con_input_len < HLCON_INPUT_MAX)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			hl_con_input[hl_con_input_len] = '_';
		else
			hl_con_input[hl_con_input_len] = '-';

		hl_con_input_len++;
		hl_con_input[hl_con_input_len] = 0;
	}

	if (HLConKeyEdge(SC_BACKSPACE) && hl_con_input_len > 0)
	{
		hl_con_input_len--;
		hl_con_input[hl_con_input_len] = 0;
	}

	//Key_Console's history walk. an empty slot ends it rather than cycling
	//through blanks
	if (HLConKeyEdge(SC_CURSOR_UP))
	{
		I64 probe = hl_con_hist_line;
		I64 tries;

		for (tries = 0; tries < HLCON_HISTORY; tries++)
		{
			probe--;
			if (probe < 0)
				probe = HLCON_HISTORY - 1;

			if (probe == hl_con_edit_line)
				break;

			if (hl_con_hist[probe * (HLCON_INPUT_MAX + 2)])
			{
				hl_con_hist_line = probe;
				HLConHistoryRecall(probe);
				break;
			}
		}
	}

	if (HLConKeyEdge(SC_CURSOR_DOWN))
	{
		if (hl_con_hist_line == hl_con_edit_line)
		{
			hl_con_input[0]  = 0;
			hl_con_input_len = 0;
		}
		else
		{
			hl_con_hist_line++;
			if (hl_con_hist_line >= HLCON_HISTORY)
				hl_con_hist_line = 0;

			if (hl_con_hist_line == hl_con_edit_line)
			{
				hl_con_input[0]  = 0;
				hl_con_input_len = 0;
			}
			else
				HLConHistoryRecall(hl_con_hist_line);
		}
	}

	if (HLConKeyEdge(SC_ENTER))
	{
		//store before executing, a command that changes state must still
		//be recallable
		if (hl_con_input_len > 0)
		{
			HLStrCopy(&hl_con_hist[hl_con_edit_line * (HLCON_INPUT_MAX + 2)],
				hl_con_input, HLCON_INPUT_MAX + 1);

			hl_con_edit_line++;
			if (hl_con_edit_line >= HLCON_HISTORY)
				hl_con_edit_line = 0;

			hl_con_hist[hl_con_edit_line * (HLCON_INPUT_MAX + 2)] = 0;
			hl_con_hist_line = hl_con_edit_line;
		}

		HLConExec(hl_con_input);
		hl_con_input[0]  = 0;
		hl_con_input_len = 0;
	}
}

U0 HLConDrawNotify(CHLCanvas *c)
{//Con_DrawNotify: newest few lines, top left, while still fresh. suppressed
 //with the console down or the same text appears twice
	I64	 i;
	I64	 line;
	I64	 y = 0;
	I64	 x;
	U8	*row;
	U8	 prompt[16];

	//the shell calls this once a frame with the console down, which is the only
	//per-frame hook this file owns - the flashlight and m_pLastItem ride it
	HLConFlashlightFrame;
	HLConTrackLastItem;

	if (!hl_con_ready)
		return;

	for (i = HLCON_NOTIFY_LINES; i > 0; i--)
	{
		line = hl_con_line - i;
		if (line < 0)
			goto qcn_next;

		if (tS - hl_con_time[line % HLCON_LINES] > HLCON_NOTIFY_TIME)
			goto qcn_next;

		row = hl_con_text + (line % HLCON_LINES) * HLCON_WIDTH;
		if (row[0])
		{
			HLStrDraw(c, 8, y, row);
			y += HLCHAR_H;
		}

qcn_next:
	}

	//Con_DrawNotify's key_message branch
	if (hl_msg_mode)
	{
		if (hl_msg_team)
			StrPrint(prompt, "say_team:");
		else
			StrPrint(prompt, "say:");
		HLStrDraw(c, 8, y, prompt);
		x = 8 + StrLen(prompt) * HLCHAR_W;
		HLStrDraw(c, x, y, hl_chat_buf);
		if ((ToI64(tS * 4.0) & 1) == 0)
			HLStrDraw(c, x + hl_chat_len * HLCHAR_W, y, "_");
	}
}

U0 HLConDraw(CHLCanvas *c)
{//slides over whatever is behind it
	I64	 i;
	I64	 line;
	I64	 y;
	I64	 con_h;
	U8	*row;

	//the notify path is skipped while the console is open, so the per-frame
	//work it carries is repeated here or the flashlight goes out
	HLConFlashlightFrame;
	HLConTrackLastItem;

	//a fraction of the screen, not a fixed 128 - at 640x480 a fixed slice
	//covers a quarter of the view and the background stops part way across
	con_h = c->height / 2;
	if (con_h < HLCON_HEIGHT)
		con_h = HLCON_HEIGHT;

	if (hl_pic_conback.pixels)
		HLPicDrawFillPart(c, &hl_pic_conback, con_h);

	//oldest first, so new text lands at the bottom
	y = 4;
	for (i = HLCON_LINES; i > 0; i--)
	{
		line = hl_con_line - i;
		if (line < 0)
			goto qc_next;

		row = hl_con_text + (line % HLCON_LINES) * HLCON_WIDTH;
		if (row[0] && y + HLCHAR_H < con_h)
		{
			HLStrDraw(c, 8, y, row);
			y += HLCHAR_H;
		}

qc_next:
	}

	//prompt, input line, blinking caret
	HLStrDraw(c, 8, con_h - HLCHAR_H - 2, "]");
	HLStrDraw(c, 8 + HLCHAR_W, con_h - HLCHAR_H - 2, hl_con_input);

	if (ToI64(tS * 3.0) & 1)
		HLStrDraw(c, 8 + HLCHAR_W * (hl_con_input_len + 1),
			con_h - HLCHAR_H - 2, "_");
}

U0 HLMenuPlaque(CHLCanvas *c, CHLPic *title)
{//shared submenu furniture, placed as M_Multiplayer_Draw places it
	I64 mx = HLMenuXOfs(c);

	HLMenuBackdrop(c);

	if (hl_pic_qplaque.pixels)
		HLPicDraw(c, &hl_pic_qplaque, mx + 16, 4);

	if (title && title->pixels)
		HLPicDraw(c, title, mx + (HLMENU_VW - title->width) / 2, 4);
}

U0 HLMenuRowsText(CHLCanvas *c, I64 mx, I64 sel, I64 count, U8 *labels)
{//draw `count` rows of text at the item block, selected row highlighted
 //
 //labels is a flat 24-byte-per-entry block rather than a U8** table: adjacent
 //string literals concatenate by length in ZealC and truncate at the first
 //embedded NUL, which collapses a literal table to one entry
	I64 i;
	I64 y;

	for (i = 0; i < count; i++)
	{
		y = HLMENU_Y + i * HLMENU_ROW_H;

		if (i == sel)
			HLStrDraw(c, mx + 72, y, &labels[i * 24]);
		else
			HLStrDrawAlt(c, mx + 72, y, &labels[i * 24]);
	}
}

U8 *HLMenuItemLabel(I64 item)
{//resource/gameui_english.txt, GameUI_GameMenu_*.
 //
 //Comparison chain rather than a table: adjacent string literals concatenate
 //by length in ZealC and truncate at the first embedded NUL, which collapses a
 //literal table to one entry.
	if (item == HLITEM_RESUME)	return "Resume game";
	if (item == HLITEM_NEWGAME)	return "New game";
	if (item == HLITEM_SAVE)		return "Save game";
	if (item == HLITEM_LOAD)		return "Load game";
	if (item == HLITEM_FIND)		return "Find servers";
	if (item == HLITEM_CREATE)	return "Create server";
	if (item == HLITEM_OPTIONS)	return "Options";
	if (item == HLITEM_LEAVE)	return "Leave game";
	if (item == HLITEM_QUIT)		return "Quit";

	return NULL;
}

U8 *HLMenuItemHint(I64 item)
{//resource/gameui_english.txt, GameUI_MainMenu_Hint_*. Items GameMenu.res gives
 //no HelpText to have none here either.
	if (item == HLITEM_NEWGAME)	return "Start a new single player game.";
	if (item == HLITEM_LOAD)		return "Load a previously saved game.";
	if (item == HLITEM_FIND)		return "Search for online multiplayer servers.";
	if (item == HLITEM_CREATE)
		return "Host an online multiplayer server for others to join.";
	if (item == HLITEM_OPTIONS)
		return "Change game settings, configure controls.";
	if (item == HLITEM_QUIT)		return "Quit playing Half-Life.";

	return NULL;
}

I64 HLMenuItems(I64 *out)
{//The visible item list, GameMenu.res order with OnlyInGame applied. Returns
 //the count; hl_menu_row indexes this, not the HLITEM_* table.
	I64 n = 0;

	if (hl_menu_ingame)
	{
		out[n] = HLITEM_RESUME;
		n++;
	}

	out[n] = HLITEM_NEWGAME;
	n++;

	if (hl_menu_ingame)
	{
		out[n] = HLITEM_SAVE;
		n++;
	}

	out[n] = HLITEM_LOAD;
	n++;
	out[n] = HLITEM_FIND;
	n++;
	out[n] = HLITEM_CREATE;
	n++;
	out[n] = HLITEM_OPTIONS;
	n++;

	if (hl_menu_ingame)
	{
		out[n] = HLITEM_LEAVE;
		n++;
	}

	out[n] = HLITEM_QUIT;
	n++;

	return n;
}

U0 HLMenuCursor(CHLCanvas *c, I64 x, I64 y)
{//the main menu's six-frame 10Hz cursor
	I64 frame = ToI64(tS * 10.0) % 6;

	if (hl_pic_cursor[frame].pixels)
		HLPicDraw(c, &hl_pic_cursor[frame], x, y);
}

U0 HLMenuBar(CHLCanvas *c, I64 x, I64 y, I64 w, I64 h, F64 frac)
{//A CCvarSlider track: border plus a filled portion.
	I64 px;
	I64 py;
	I64 fill;

	if (w < 2 || h < 2)
		return;

	if (frac < 0.0)	frac = 0.0;
	if (frac > 1.0)	frac = 1.0;

	fill = ToI64(ToF64(w - 2) * frac);

	for (py = y; py < y + h; py++)
	{
		if (py < 0 || py >= c->height)
			goto qmb_next_row;

		for (px = x; px < x + w; px++)
		{
			if (px < 0 || px >= c->width)
				goto qmb_next_col;

			if (py == y || py == y + h - 1 || px == x || px == x + w - 1)
				c->pixels[py * c->width + px] = HLMENU_C_HINT;
			else if (px - x - 1 < fill)
				c->pixels[py * c->width + px] = HLMENU_C_ITEM;

qmb_next_col:
		}

qmb_next_row:
	}
}

U8 *HLOptTabLabel(I64 tab)
{//resource/gameui_english.txt: GameUI_Keyboard, GameUI_Mouse ("Aim"),
 //GameUI_Audio, GameUI_Video.
	if (tab == HLTAB_KEYBOARD)	return "Keyboard";
	if (tab == HLTAB_AIM)		return "Aim";
	if (tab == HLTAB_AUDIO)		return "Audio";
	if (tab == HLTAB_VIDEO)		return "Video";

	return NULL;
}

I64 HLOptRows(I64 tab)
{//Including the strip at row 0 and Close at the last row.
	if (tab == HLTAB_KEYBOARD)	return HLKB_CLOSE + 1;
	if (tab == HLTAB_AIM)		return HLAIM_CLOSE + 1;
	if (tab == HLTAB_AUDIO)		return HLAUD_CLOSE + 1;

	return HLVID_CLOSE + 1;
}

U0 HLOptRowLabel(CHLCanvas *c, I64 x, I64 y, I64 row, U8 *label)
{//A control label, bright when it holds the selection.
	if (row == hl_opt_row)
		HLMenuStrColor(c, x, y, label, HLMENU_C_SEL);
	else
		HLMenuStrColor(c, x, y, label, HLMENU_C_ITEM);
}

U0 HLOptDraw(CHLCanvas *c)
{//HL's Options dialog: a tab strip over one page of controls.
	U8	 line[80];
	U8	*label;
	I64	 x;
	I64	 y;
	I64	 w;
	I64	 h;
	I64	 col;
	I64	 val;
	I64	 pitch;
	I64	 tx;
	I64	 bw;
	I64	 bh;
	I64	 i;
	I64	 rows;

	HLMenuBgDraw(c);

	x = HLDlgX(c, 152);
	y = HLDlgY(c, 142);
	w = HLDlgX(c, 508);
	h = HLDlgY(c, 414);

	HLMenuPanel(c, x, y, w, h, "Options");

	pitch = HLMenuLineH();
	col   = x + HLDlgX(c, 20);
	val   = x + HLDlgX(c, 260);
	bw    = HLDlgX(c, 180);
	bh    = pitch - 2;

	if (bh < 4)
		bh = 4;

	rows = HLOptRows(hl_opt_tab);

	if (hl_opt_row < 0)			hl_opt_row = 0;
	if (hl_opt_row >= rows)		hl_opt_row = rows - 1;

	//--- tab strip ---
	tx = col;

	for (i = 0; i < HLTAB_COUNT; i++)
	{
		label = HLOptTabLabel(i);

		if (!label)
			goto qod_next_tab;

		//The active tab is bright; brackets mark that the strip itself holds
		//the selection, so Left/Right is known to move between pages.
		if (i == hl_opt_tab && hl_opt_row == HLOPT_STRIP)
			StrPrint(line, "[%s]", label);
		else
			StrPrint(line, " %s ", label);

		if (i == hl_opt_tab)
			HLMenuStrColor(c, tx, y + HLDlgY(c, 34), line, HLMENU_C_SEL);
		else
			HLMenuStrColor(c, tx, y + HLDlgY(c, 34), line, HLMENU_C_ITEM);

		tx += HLFontStrWidth(line) + 6;

qod_next_tab:
	}

	y = y + HLDlgY(c, 64);

	//--- the page ---
	if (hl_opt_tab == HLTAB_KEYBOARD)
	{
		HLOptRowLabel(c, col, y + HLKB_BINDINGS * pitch, HLKB_BINDINGS,
			"Edit key bindings");
		HLOptRowLabel(c, col, y + HLKB_DEFAULTS * pitch, HLKB_DEFAULTS,
			"Use defaults");

		//Not an HL row: HL binds walking to +speed and has no toggle. Kept
		//because this port has no run key by default.
		if (HLCvarGet("cl_forwardspeed") > 200.0)
			StrPrint(line, "Always run");
		else
			StrPrint(line, "Always walk");

		HLOptRowLabel(c, col, y + HLKB_ALWAYSRUN * pitch, HLKB_ALWAYSRUN, line);
		HLOptRowLabel(c, col, y + HLKB_CLOSE * pitch, HLKB_CLOSE, "Close");
	}
	else if (hl_opt_tab == HLTAB_AIM)
	{
		HLOptRowLabel(c, col, y + HLAIM_SENS * pitch, HLAIM_SENS,
			"Aim sensitivity");
		HLMenuBar(c, val, y + HLAIM_SENS * pitch, bw, bh,
			(hl_opt_sensitivity - 0.02) / (0.60 - 0.02));

		//Invert is the sign of m_pitch, not a separate flag.
		if (HLCvarGet("m_pitch") < 0.0)
			StrPrint(line, "Invert mouse   on");
		else
			StrPrint(line, "Invert mouse   off");

		HLOptRowLabel(c, col, y + HLAIM_INVERT * pitch, HLAIM_INVERT, line);
		HLOptRowLabel(c, col, y + HLAIM_CLOSE * pitch, HLAIM_CLOSE, "Close");
	}
	else if (hl_opt_tab == HLTAB_AUDIO)
	{
		HLOptRowLabel(c, col, y + HLAUD_SFX * pitch, HLAUD_SFX,
			"Sound effects volume");
		HLMenuBar(c, val, y + HLAUD_SFX * pitch, bw, bh,
			ToF64(hl_opt_volume) / 100.0);

		//MP3 volume in HL's dialog; the tracks come from the music folder.
		HLOptRowLabel(c, col, y + HLAUD_MP3 * pitch, HLAUD_MP3, "MP3 volume");
		HLMenuBar(c, val, y + HLAUD_MP3 * pitch, bw, bh, hl_music_volume);

		HLOptRowLabel(c, col, y + HLAUD_CLOSE * pitch, HLAUD_CLOSE, "Close");
	}
	else
	{
		StrPrint(line, "Resolution     %dx%d",
			hl_res_w[hl_opt_res], hl_res_h[hl_opt_res]);
		HLOptRowLabel(c, col, y + HLVID_RES * pitch, HLVID_RES, line);

		if (hl_opt_fullscreen)
			StrPrint(line, "Windowed       off");
		else
			StrPrint(line, "Windowed       on");

		HLOptRowLabel(c, col, y + HLVID_WINDOWED * pitch, HLVID_WINDOWED, line);

		//The bar fills as the picture brightens; the gamma exponent runs the
		//other way.
		HLOptRowLabel(c, col, y + HLVID_GAMMA * pitch, HLVID_GAMMA, "Gamma");
		HLMenuBar(c, val, y + HLVID_GAMMA * pitch, bw, bh,
			(HLGAMMA_MAX - hl_opt_gamma) / (HLGAMMA_MAX - HLGAMMA_MIN));

		HLOptRowLabel(c, col, y + HLVID_CLOSE * pitch, HLVID_CLOSE, "Close");
	}

	HLMenuStrColor(c, col, y + (rows + 1) * pitch,
		"Arrows move and adjust, Enter selects, Esc closes", HLMENU_C_HINT);
}

U0 HLOptResetDefaults()
{//every value this page owns back to a fresh install, bindings included,
 //then written out so it survives a restart
	HLCvarSet("viewsize",		100.0);

	//400 is HLCvarInit's default, always run ON. 200 is a state a fresh
	//install never starts in
	HLCvarSet("cl_forwardspeed",	400.0);
	HLCvarSet("cl_backspeed",	400.0);
	HLCvarSet("m_pitch",			0.022);
	HLCvarSet("lookspring",		0.0);
	HLCvarSet("lookstrafe",		0.0);
	HLCvarSet("crosshair",		1.0);
	hl_opt_crosshair = 1;

	hl_opt_sensitivity = 0.15;
	hl_opt_volume      = 70;
	hl_snd_master      = ToF64(hl_opt_volume) / 100.0;
	hl_music_volume    = 0.7;
	hl_opt_gamma       = 1.0;
	hl_opt_gunclip     = TRUE;

	HLMusicApplyVolume;
	HLBindDefaults;
	HLCfgSave;

	HLMenuSound(HLMSND_VALUE);
}

U0 HLKeysDraw(CHLCanvas *c)
{//M_Keys_Draw: every bindable action and the key that runs it
	U8	line[64];
	U8	keyname[24];
	I64	mx = HLMenuXOfs(c);
	I64	y  = 60;
	I64	i;

	HLMenuPlaque(c, &hl_pic_p_option);

	for (i = 0; i < HLBIND_COUNT; i++)
	{
		HLBindKeyName(keyname, hl_bind_key[i]);
		StrPrint(line, "%-18s %s", hl_bind_label[i], keyname);
		HLStrDrawAlt(c, mx + 64, y + i * 16, line);
	}

	HLStrDrawAlt(c, mx + 64, y + HLBIND_COUNT * 16, "back");

	//capturing swaps the caret for "=", as the original does
	if (hl_keys_capture)
		HLStrDrawAlt(c, mx + 48, y + hl_keys_row * 16, "=");
	else
		HLStrDrawAlt(c, mx + 48, y + hl_keys_row * 16, ">");

	if (hl_keys_capture)
		HLStrDrawCenterAlt(c, c->height - 20, "press a key, or escape to cancel");
	else
		HLStrDrawCenterAlt(c, c->height - 20, "enter rebinds, escape exits");
}

Bool HLKeysKey(I64 sc)
{//capture swallows the next key whole. escape is tested first or it can be
 //bound, and the way out of the menu goes with it
	I64 i;

	if (hl_keys_capture)
	{
		hl_keys_capture = FALSE;

		if (sc != SC_ESC && hl_keys_row >= 0 && hl_keys_row < HLBIND_COUNT)
		{
			//clear the key off its old action or one press fires two
			for (i = 0; i < HLBIND_COUNT; i++)
			{
				if (i != hl_keys_row && hl_bind_key[i] == sc)
					hl_bind_key[i] = 0;
			}

			hl_bind_key[hl_keys_row] = sc;
			HLCfgSave;
		}

		HLMenuSound(HLMSND_VALUE);
		return TRUE;
	}

	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_OPTIONS;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_keys_row--;
		if (hl_keys_row < 0)
			hl_keys_row = HLBIND_COUNT;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_keys_row++;
		if (hl_keys_row > HLBIND_COUNT)
			hl_keys_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//the row past the last binding is back
		if (hl_keys_row >= HLBIND_COUNT)
		{
			HLMenuSound(HLMSND_MOVE);
			hl_menu_page = HLPAGE_OPTIONS;
			return TRUE;
		}

		HLMenuSound(HLMSND_ENTER);
		hl_keys_capture = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 HLNoticeDraw(CHLCanvas *c)
{//plain message page, for what the shareware build cannot offer
	HLMenuBackdrop(c);

	HLStrDrawCenterAlt(c, 90, hl_notice);
	HLStrDrawCenterAlt(c, c->height - 20, "press enter or escape");
}

U0 HLHelpDraw(CHLCanvas *c)
{//M_Help_Draw: one full-screen picture per page
	CHLPic *p = &hl_pic_help[hl_help_page];

	HLMenuBackdrop(c);

	//authored at 320x200, centred in the virtual box rather than stretched
	if (p->pixels)
		HLPicDraw(c, p, HLMenuXOfs(c) + (HLMENU_VW - p->width) / 2, 4);
	else
		HLStrDrawCenterAlt(c, 90, "help pages not found in pak");

	HLStrDrawCenterAlt(c, c->height - 20, "left/right pages, escape exits");
}

Bool HLHelpKey(I64 sc)
{
	if (sc == SC_CURSOR_LEFT)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_help_page--;
		if (hl_help_page < 0)
			hl_help_page = HLHELP_PAGES - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_RIGHT || sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_help_page++;
		if (hl_help_page >= HLHELP_PAGES)
			hl_help_page = 0;
		return TRUE;
	}

	return FALSE;
}

U0 HLLanDraw(CHLCanvas *c)
{//M_LanConfig_Draw: title, address field, JOIN row
	U8	line[64];
	I64	mx = HLMenuXOfs(c);
	I64	y  = 56;
	I64	i;

	HLMenuPlaque(c, &hl_pic_p_multi);

	HLStrDrawCenterAlt(c, 40, "join game - tcp/ip");

	HLStrDrawAlt(c, mx + 56, y, "address");

	//plain field. M_DrawTextBox would need the gfx/box_*.lmp tiles assembled
	if (hl_lan_editing)
		StrPrint(line, "%s_", hl_lan_addr);
	else
		StrPrint(line, "%s", hl_lan_addr);

	HLStrDrawAlt(c, mx + 144, y, line);

	HLStrDrawAlt(c, mx + 56, y + 24, "search for local games");
	HLStrDrawAlt(c, mx + 56, y + 40, "join game");
	HLStrDrawAlt(c, mx + 56, y + 56, "back");

	if (hl_lan_row == HLLAN_ADDRESS)		HLMenuCursor(c, mx + 40, y - 4);
	else if (hl_lan_row == HLLAN_SEARCH)	HLMenuCursor(c, mx + 40, y + 20);
	else if (hl_lan_row == HLLAN_JOIN)	HLMenuCursor(c, mx + 40, y + 36);
	else								HLMenuCursor(c, mx + 40, y + 52);

	//M_Slist_Draw. replies land asynchronously, so the list is whatever has
	//arrived so far - picking one copies it into the address field
	if (HLNetSlistSearching)
		HLStrDrawAlt(c, mx + 56, y + 80, "searching...");
	else if (hl_slist_count < 1 && hl_slist_asked)
		HLStrDrawAlt(c, mx + 56, y + 80, "no servers found");

	for (i = 0; i < hl_slist_count && i < 6; i++)
	{
		StrPrint(line, "%d %-16s %s %d/%d", i + 1,
			hl_slist[i].name, hl_slist[i].map,
			hl_slist[i].players, hl_slist[i].max_players);
		HLStrDrawAlt(c, mx + 56, y + 96 + i * 10, line);
	}

	if (hl_slist_count > 0)
		HLStrDrawCenterAlt(c, c->height - 30,
			"number key copies that server's address");

	if (hl_lan_editing)
		HLStrDrawCenterAlt(c, c->height - 20, "type the address, enter when done");
	else
		HLStrDrawCenterAlt(c, c->height - 20, "enter selects, escape returns");
}

U0 HLLanInput()
{//digits and dots only, so the field can't hold what the parser rejects
	I64 i;
	I64 sc;
	I64 ch;

	if (!hl_lan_editing)
		return;

	i = 0;
	while (hl_con_charset[i])
	{
		ch = hl_con_charset[i];

		if ((ch >= '0' && ch <= '9') || ch == '.')
		{
			sc = Char2ScanCode(ch);

			if (HLConKeyEdge(sc) && hl_lan_len < 23)
			{
				hl_lan_addr[hl_lan_len] = ch;
				hl_lan_len++;
				hl_lan_addr[hl_lan_len] = 0;
			}
		}

		i++;
	}

	if (HLConKeyEdge(SC_BACKSPACE) && hl_lan_len > 0)
	{
		hl_lan_len--;
		hl_lan_addr[hl_lan_len] = 0;
	}

	if (HLConKeyEdge(SC_ENTER))
	{
		hl_lan_editing   = FALSE;
		hl_lan_ate_enter = TRUE;
		HLMenuSound(HLMSND_ENTER);
	}
}

Bool HLLanKey(I64 sc)
{
	I64 i;
	I64 n;

	if (hl_lan_editing)
		return TRUE;

	//the ENTER that ended editing must not be seen twice or the field reopens
	if (hl_lan_ate_enter)
	{
		hl_lan_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	//1..6 join that server outright - the original's slist is a list you pick
	//from, not a way to fill in a text field
	i = -1;
	for (n = 0; n < 6; n++)
	{
		if (sc == Char2ScanCode('1' + n))
			i = n;
	}

	if (i >= 0)
	{
		if (i < hl_slist_count)
		{
			//join the U32 it ANSWERED FROM. the printable form is for the
			//list only - formatting an address and parsing it back is two
			//more places for a join to fail than there need to be
			HLStrCopy(hl_lan_addr, hl_slist[i].addr, 24);
			hl_lan_len = StrLen(hl_lan_addr);
			HLMenuSound(HLMSND_ENTER);
			HLConConnectIP(hl_slist[i].ip);
			hl_menu_page = HLPAGE_MAIN;
		}
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_lan_row--;
		if (hl_lan_row < 0)
			hl_lan_row = HLLAN_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_lan_row++;
		if (hl_lan_row >= HLLAN_ROWS)
			hl_lan_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_lan_row == HLLAN_ADDRESS)
		{
			hl_lan_editing = TRUE;
			hl_lan_len     = StrLen(hl_lan_addr);
		}
		else if (hl_lan_row == HLLAN_SEARCH)
		{
			//Datagram_SearchForHosts. returns at once, replies fill the table
			//over the next couple of seconds
			HLNetSlistBroadcast;
		}
		else if (hl_lan_row == HLLAN_JOIN)
		{
			//straight through the connect command, one join path not two
			HLConConnect(hl_lan_addr);
			hl_menu_page = HLPAGE_MAIN;
		}
		else
			hl_menu_page = HLPAGE_MULTI;

		return TRUE;
	}

	return FALSE;
}

U0 HLSingleDraw(CHLCanvas *c)
{//M_SinglePlayer_Draw. the three rows are one image, 20 pixel pitch
	I64 mx = HLMenuXOfs(c);

	U8 labels[HLSP_ROWS * 24];

	HLMenuPlaque(c, &hl_pic_p_single);

	if (hl_pic_sp_menu.pixels)
		HLPicDraw(c, &hl_pic_sp_menu, mx + 72, HLMENU_Y);
	else
	{
		//gfx/sp_menu.lmp does not exist in valve/. Adjacent string literals
		//concatenate in ZealC, so the labels go into a flat block.
		HLStrCopy(&labels[HLSP_NEWGAME * 24], "NEW GAME", 24);
		HLStrCopy(&labels[HLSP_LOAD * 24], "LOAD GAME", 24);
		HLStrCopy(&labels[HLSP_SAVE * 24], "SAVE GAME", 24);

		HLMenuRowsText(c, mx, hl_sp_row, HLSP_ROWS, labels);
	}

	HLMenuCursor(c, mx + 72 - 18, HLMENU_Y + hl_sp_row * HLMENU_ROW_H - 4);
}

Bool HLSingleKey(I64 sc, Bool *_start_game)
{
	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_sp_row--;
		if (hl_sp_row < 0)
			hl_sp_row = HLSP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_sp_row++;
		if (hl_sp_row >= HLSP_ROWS)
			hl_sp_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_sp_row == HLSP_NEWGAME)
		{
			//M_SinglePlayer_Key: New Game restarts at the campaign's first map.
			//quake's is "start", a hub the player walks out of to pick skill
			//and episode; HL has no hub and opens on the tram in c0a0
			//player. cvars first, they govern how QuakeC spawns everything
			HLCvarSet("deathmatch", 0.0);
			HLCvarSet("coop", 0.0);

			//svs.maxclients 1 - solo reserves one edict, as the original does
			HLSvMaxClientsSet(1);

			HLStrCopy(hl_change_map, "c0a0", 64);
			hl_change_pending = TRUE;

			if (_start_game)
				*_start_game = TRUE;

			hl_menu_page = HLPAGE_MAIN;
		}
		else if (hl_sp_row == HLSP_LOAD)
		{
			//one slot. deferred - loading tears the world down and this runs
			//inside the menu's own frame
			hl_menu_load_req = TRUE;
			hl_menu_page     = HLPAGE_MAIN;

			if (_start_game)
				*_start_game = TRUE;
		}
		else
		{
			//saving needs a world to save
			if (hl_game_active)
			{
				hl_menu_save_req = TRUE;
				hl_menu_page     = HLPAGE_MAIN;

				if (_start_game)
					*_start_game = TRUE;
			}
		}

		return TRUE;
	}

	return FALSE;
}

U0 HLMultiDraw(CHLCanvas *c)
{//M_Multiplayer_Draw. the rows are artwork, gfx/mp_menu.lmp, not console font
	U8	labels[HLMP_ROWS * 24];
	I64	mx = HLMenuXOfs(c);

	HLMenuPlaque(c, &hl_pic_p_multi);

	//one image at x=72 y=32, the original's 20 pixel row pitch
	if (hl_pic_mp_menu.pixels)
		HLPicDraw(c, &hl_pic_mp_menu, mx + 72, HLMENU_Y);
	else
	{
		//gfx/mp_menu.lmp does not exist in valve/ either. only the three baked
		//rows - "back" is drawn as text below regardless
		HLStrCopy(&labels[HLMP_JOIN * 24], "JOIN A GAME", 24);
		HLStrCopy(&labels[HLMP_NEW * 24], "NEW GAME", 24);
		HLStrCopy(&labels[HLMP_SETUP * 24], "SETUP", 24);

		HLMenuRowsText(c, mx, hl_mp_row, 3, labels);
	}

	//no artwork for back, it is not one of the three baked rows
	HLStrDrawAlt(c, mx + 72, HLMENU_Y + 3 * HLMENU_ROW_H, "back");

	HLMenuCursor(c, mx + 72 - 18, HLMENU_Y + hl_mp_row * HLMENU_ROW_H - 4);

	//join needs a UDP socket; new game runs a real deathmatch server the local
	//client reaches over loopback
	if (HLNetUdpAvailable())
	{
		HLStrDrawCenterAlt(c, c->height - 30, "new game hosts on this machine");
		HLStrDrawCenterAlt(c, c->height - 20, "join: console, then connect <ip>");
	}
	else
	{
		HLStrDrawCenterAlt(c, c->height - 30, "new game runs a local deathmatch");
		HLStrDrawCenterAlt(c, c->height - 20, "network play: run RunNet.ZC");
	}
}

U0 HLSetupDraw(CHLCanvas *c)
{
	CHLMdl	*preview;
	U8		 line[64];
	F64		 porg[3];
	F64		 pang[3];
	F64		 veye[3];
	F64		 vang[3];
	I64		 mx = HLMenuXOfs(c);
	I64		 y  = 40;

	HLMenuPlaque(c, &hl_pic_p_multi);

	HLStrDrawAlt(c, mx + 32, y, "your name");
	if (hl_setup_editing)
	{
		StrPrint(line, "%s_", hl_setup_name);
		HLStrDrawAlt(c, mx + 32, y + 8, line);
	}
	else
		HLStrDrawAlt(c, mx + 32, y + 8, hl_setup_name);

	StrPrint(line, "shirt colour    %d", hl_setup_top);
	HLStrDrawAlt(c, mx + 32, y + 32, line);

	StrPrint(line, "trouser colour  %d", hl_setup_bottom);
	HLStrDrawAlt(c, mx + 32, y + 64, line);

	HLStrDrawAlt(c, mx + 32, y + 72, "back");

	//the rotating player model. real world path with a synthetic camera, not a
	//sprite, so the colours are the translated skin others actually see
	preview = HLMdlPreviewGet(hl_setup_top, hl_setup_bottom);
	if (preview)
	{
		//needs a camera and a CLEAN depth buffer - both live on the canvas and
		//still hold the last rendered frame, whose geometry would win the
		//depth test and eat the model
		HLVecSet(veye, 0.0, 0.0, 0.0);
		HLVecSet(vang, 0.0, 0.0, 0.0);
		HLDrawSetView(c, veye, vang, 90.0);

		MemSet(c->depth, 0, c->width * c->height * sizeof(F64));

		//down +x from the eye, offset right of the text, spun by the clock
		HLVecSet(porg, 76.0, -26.0, -22.0);
		HLVecSet(pang, 0.0, HLAngleNorm(tS * 60.0), 0.0);

		HLMdlDrawAngles(c, preview, 0, porg, pang, 176);
	}

	if (hl_set_row == HLSET_NAME)			HLStrDrawAlt(c, mx + 16, y,      ">");
	else if (hl_set_row == HLSET_TOP)		HLStrDrawAlt(c, mx + 16, y + 32, ">");
	else if (hl_set_row == HLSET_BOTTOM)	HLStrDrawAlt(c, mx + 16, y + 48, ">");
	else								HLStrDrawAlt(c, mx + 16, y + 72, ">");

	if (hl_setup_editing)
		HLStrDrawCenterAlt(c, c->height - 20, "type a name, enter when done");
	else
		HLStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool HLMultiKey(I64 sc)
{
	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_mp_row--;
		if (hl_mp_row < 0)
			hl_mp_row = HLMP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_mp_row++;
		if (hl_mp_row >= HLMP_ROWS)
			hl_mp_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
		return TRUE;	//nothing on this page is a value

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_mp_row == HLMP_JOIN)
		{
			if (HLNetUdpAvailable())
			{
				hl_menu_page = HLPAGE_LANCONFIG;
				hl_lan_row   = 0;
				return TRUE;
			}

			//only reachable without a net stack, the branch above returns
			HLStrCopy(hl_notice, "quit and run RunNet.ZC for network play", 64);
			hl_menu_page = HLPAGE_NOTICE;
		}
		else if (hl_mp_row == HLMP_NEW)
		{
			//M_Menu_Net_f: NEW GAME opens game options, it does not start
			//anything. the map, the mode and the limits are chosen there
			hl_menu_page = HLPAGE_GAMEOPT;
			hl_go_row    = 0;

			//the page shows a mode, so one must be set. neither cvar on
			//resolves to single player and the label would be lying
			if (HLCvarGet("coop") == 0.0 && HLCvarGet("deathmatch") == 0.0)
			{
				HLCvarSet("deathmatch", 1.0);
				HLCvarSet("coop", 0.0);
			}
		}
		else if (hl_mp_row == HLMP_SETUP)
		{
			hl_menu_page = HLPAGE_SETUP;
			hl_set_row   = 0;
		}
		else
			hl_menu_page = HLPAGE_MAIN;

		return TRUE;
	}

	return FALSE;
}

U0 HLGoDraw(CHLCanvas *c)
{//M_GameOptions_Draw. the values are read back off the cvars, never cached -
 //the console can set any of them behind this page
	U8	line[64];
	I64	y;
	I64	pitch;
	I64	mx;
	I64	v;

	mx = HLMenuXOfs(c);

	HLMenuPlaque(c, &hl_pic_p_multi);

	//nine rows at a 16 pitch run off a 200 row canvas and the last ones can
	//never be reached. same three steps down HLOptDraw takes
	y     = 60;
	pitch = 16;

	if (y + HLGO_ROWS * pitch + 24 > c->height)
	{
		y     = 40;
		pitch = 12;
	}

	if (y + HLGO_ROWS * pitch + 24 > c->height)
	{
		y     = 32;
		pitch = HLCHAR_H;
	}

	HLStrDrawAlt(c, mx + 64, y + HLGO_BEGIN * pitch, "begin game");

	StrPrint(line, "%-14s %d", "max players", hl_go_maxplayers);
	HLStrDrawAlt(c, mx + 64, y + HLGO_MAXPLAYERS * pitch, line);

	//coop and deathmatch are never both set, so coop alone names the mode
	if (HLCvarGet("coop") != 0.0)
		StrPrint(line, "%-14s %s", "game type", "cooperative");
	else
		StrPrint(line, "%-14s %s", "game type", "deathmatch");
	HLStrDrawAlt(c, mx + 64, y + HLGO_GAMETYPE * pitch, line);

	v = ToI64(HLCvarGet("teamplay"));
	if (v == 1)
		StrPrint(line, "%-14s %s", "teamplay", "no friendly fire");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "teamplay", "friendly fire");
	else
		StrPrint(line, "%-14s %s", "teamplay", "off");
	HLStrDrawAlt(c, mx + 64, y + HLGO_TEAMPLAY * pitch, line);

	v = ToI64(HLCvarGet("skill"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "skill", "easy");
	else if (v == 1)
		StrPrint(line, "%-14s %s", "skill", "normal");
	else if (v == 2)
		StrPrint(line, "%-14s %s", "skill", "hard");
	else
		StrPrint(line, "%-14s %s", "skill", "nightmare");
	HLStrDrawAlt(c, mx + 64, y + HLGO_SKILL * pitch, line);

	//zero is off in both, not a limit of nothing
	v = ToI64(HLCvarGet("fraglimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "frag limit", "none");
	else
		StrPrint(line, "%-14s %d frags", "frag limit", v);
	HLStrDrawAlt(c, mx + 64, y + HLGO_FRAGLIMIT * pitch, line);

	v = ToI64(HLCvarGet("timelimit"));
	if (v <= 0)
		StrPrint(line, "%-14s %s", "time limit", "none");
	else
		StrPrint(line, "%-14s %d minutes", "time limit", v);
	HLStrDrawAlt(c, mx + 64, y + HLGO_TIMELIMIT * pitch, line);

	StrPrint(line, "%-14s %s", "episode", hl_go_ep_name[hl_go_episode]);
	HLStrDrawAlt(c, mx + 64, y + HLGO_EPISODE * pitch, line);

	StrPrint(line, "%-14s %s", "level",
		hl_go_map[hl_go_ep_first[hl_go_episode] + hl_go_level]);
	HLStrDrawAlt(c, mx + 64, y + HLGO_LEVEL * pitch, line);

	//a caret, the spinning cursor is oversized at this pitch
	HLStrDrawAlt(c, mx + 48, y + hl_go_row * pitch, ">");

	HLStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool HLGoKey(I64 sc)
{//M_GameOptions_Key. every row writes its cvar as it is edited, so the world
 //is already configured by the time begin game queues the map
	I64 dir;
	I64 v;
	I64 count;

	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_MULTI;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_go_row--;
		if (hl_go_row < 0)
			hl_go_row = HLGO_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_go_row++;
		if (hl_go_row >= HLGO_ROWS)
			hl_go_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_NetStart_Change is never called for the begin row
		if (hl_go_row == HLGO_BEGIN)
			return TRUE;

		HLMenuSound(HLMSND_VALUE);

		dir = 1;
		if (sc == SC_CURSOR_LEFT)
			dir = -1;

		switch (hl_go_row)
		{
			case HLGO_MAXPLAYERS:
				//the slot table is allocated at HLSV_MAX_CLIENTS before any map
				//spawns, so there is no cvar to write - this bounds the choice
				hl_go_maxplayers += dir;
				if (hl_go_maxplayers > HLSV_MAX_CLIENTS)
					hl_go_maxplayers = 2;
				if (hl_go_maxplayers < 2)
					hl_go_maxplayers = HLSV_MAX_CLIENTS;
				break;

			case HLGO_GAMETYPE:
				//MUTUALLY EXCLUSIVE. both set is a state the mode resolver
				//cannot describe, so the pair is always written together
				if (HLCvarGet("coop") != 0.0)
				{
					HLCvarSet("coop", 0.0);
					HLCvarSet("deathmatch", 1.0);
				}
				else
				{
					HLCvarSet("coop", 1.0);
					HLCvarSet("deathmatch", 0.0);
				}
				break;

			case HLGO_TEAMPLAY:
				v = ToI64(HLCvarGet("teamplay")) + dir;
				if (v > 2)	v = 0;
				if (v < 0)	v = 2;
				HLCvarSet("teamplay", ToF64(v));
				break;

			case HLGO_SKILL:
				v = ToI64(HLCvarGet("skill")) + dir;
				if (v > 3)	v = 0;
				if (v < 0)	v = 3;
				HLCvarSet("skill", ToF64(v));
				break;

			case HLGO_FRAGLIMIT:
				v = ToI64(HLCvarGet("fraglimit")) + dir * 10;
				if (v > 100)	v = 0;
				if (v < 0)		v = 100;
				HLCvarSet("fraglimit", ToF64(v));
				break;

			case HLGO_TIMELIMIT:
				v = ToI64(HLCvarGet("timelimit")) + dir * 5;
				if (v > 60)	v = 0;
				if (v < 0)	v = 60;
				HLCvarSet("timelimit", ToF64(v));
				break;

			case HLGO_EPISODE:
				//shareware wraps at two, which is what hides episodes 2-4,
				//end and the dm maps - their files are not on the disc
				count = HLGoEpisodeCount();
				hl_go_episode += dir;
				if (hl_go_episode >= count)	hl_go_episode = 0;
				if (hl_go_episode < 0)		hl_go_episode = count - 1;

				//episodes are different lengths, the old index can be past
				//the end of the new one
				hl_go_level = 0;
				break;

			case HLGO_LEVEL:
				count = HLGoLevelCount();
				hl_go_level += dir;
				if (hl_go_level >= count)	hl_go_level = 0;
				if (hl_go_level < 0)			hl_go_level = count - 1;
				break;

			default:
				break;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		//only the top row does anything, the rest are left/right values
		if (hl_go_row != HLGO_BEGIN)
			return TRUE;

		HLMenuSound(HLMSND_ENTER);

		//bind so a remote client has something to reach. not fatal if it
		//fails - a listen server with nobody connected still runs
		if (HLNetUdpAvailable())
		{
			//DHCP first under SLIRP, AutoIP 10.0.0.1 only without it - that
			//address is socket MP, not hostfwd
			if (!HLNetLocalIP)
				HLNetDhcp;
			if (!HLNetLocalIP)
				HLNetAutoIP(0);

			if (HLNetUdpOpen(HLNET_PORT_DEFAULT))
			{
				hl_udp_server = TRUE;
				HLNetDgrmInit;
			}
		}

		//the map must RESTART so items spawn with the mode already active.
		//hl_mp_start_dm is what drops the attract loop and leaves the menu, the
		//frame loop services the pending change
		//before the changelevel: HLGameInit reserves this many edicts
		HLSvMaxClientsSet(hl_go_maxplayers);

		HLStrCopy(hl_change_map,
			hl_go_map[hl_go_ep_first[hl_go_episode] + hl_go_level], 64);
		hl_change_pending = TRUE;
		hl_mp_start_dm    = TRUE;
		return TRUE;
	}

	return FALSE;
}

U0 HLSetupInput()
{//same charset and edge detection the console uses
	I64 i;
	I64 sc;
	I64 ch;

	if (!hl_setup_editing)
		return;

	i = 0;
	while (hl_con_charset[i])
	{
		ch = hl_con_charset[i];
		sc = Char2ScanCode(ch);

		if (HLConKeyEdge(sc) && hl_setup_len < 15)
		{
			hl_setup_name[hl_setup_len] = ch;
			hl_setup_len++;
			hl_setup_name[hl_setup_len] = 0;
		}

		i++;
	}

	if (HLConKeyEdge(SC_BACKSPACE) && hl_setup_len > 0)
	{
		hl_setup_len--;
		hl_setup_name[hl_setup_len] = 0;
	}

	if (HLConKeyEdge(SC_ENTER))
	{
		hl_setup_editing = FALSE;
		hl_setup_ate_enter = TRUE;
		HLCfgSave;
		HLMenuSound(HLMSND_ENTER);
	}
}

Bool HLSetupKey(I64 sc)
{

	//while editing, every key belongs to HLSetupInput, which polls the keyboard
	//directly - the shell only forwards a handful of scancodes here
	if (hl_setup_editing)
		return TRUE;

	//this and HLSetupInput see the same physical press, so swallow the ENTER
	//that ended editing or the row handler below re-enters it at once
	if (hl_setup_ate_enter)
	{
		hl_setup_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_set_row--;
		if (hl_set_row < 0)
			hl_set_row = HLSET_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_set_row++;
		if (hl_set_row >= HLSET_ROWS)
			hl_set_row = 0;
		return TRUE;
	}

	//14 colours, the colormap's player-shirt range
	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		if (hl_set_row == HLSET_TOP || hl_set_row == HLSET_BOTTOM)
		{
			HLMenuSound(HLMSND_VALUE);

			if (hl_set_row == HLSET_TOP)
			{
				if (sc == SC_CURSOR_RIGHT)	hl_setup_top++;
				else						hl_setup_top--;

				if (hl_setup_top > 13)	hl_setup_top = 0;
				if (hl_setup_top < 0)	hl_setup_top = 13;
			}
			else
			{
				if (sc == SC_CURSOR_RIGHT)	hl_setup_bottom++;
				else						hl_setup_bottom--;

				if (hl_setup_bottom > 13)	hl_setup_bottom = 0;
				if (hl_setup_bottom < 0)		hl_setup_bottom = 13;
			}

			HLCfgSave;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_set_row == HLSET_NAME)
		{
			hl_setup_editing = TRUE;
			hl_setup_len     = StrLen(hl_setup_name);
		}
		else if (hl_set_row == HLSET_BACK)
		{
			HLCfgSave;
			hl_menu_page = HLPAGE_MULTI;
		}

		return TRUE;
	}

	return FALSE;
}

U0 HLMenuSlotPath(I64 slot, U8 *out)
{//Slot 0 is HLSAVE1.SAV, the name the single-slot path already writes.
	StrPrint(out, "HLSAVE%d.SAV", slot + 1);
}

U0 HLMenuSlotScan()
{//Which slots hold a save, and which map each is in.
 //
 //HLSaveReadHeader loads the file into hl_save_buf as a side effect, so this
 //must not run between a header read and its HLSaveRestore.
	U8	path[32];
	U8	map[96];
	I64	i;

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		hl_slot_used[i]                     = FALSE;
		hl_slot_map[i * HLSAVE_NAME_MAX]    = 0;

		HLMenuSlotPath(i, path);

		if (HLSaveReadHeader(path, map))
		{
			hl_slot_used[i] = TRUE;
			HLStrCopy(&hl_slot_map[i * HLSAVE_NAME_MAX], map, HLSAVE_NAME_MAX);
		}
	}

	HLSaveDiscard;
}

U8 *HLMenuSkillLabel(I64 row)
{//resource/gameui_english.txt GameUI_Easy / Medium / Hard.
	if (row == HLSKILL_EASY)		return "Easy";
	if (row == HLSKILL_MEDIUM)	return "Medium";
	if (row == HLSKILL_HARD)		return "Hard";

	return NULL;
}

U0 HLNewGameDraw(CHLCanvas *c)
{//NewGameDialog.res: 390,254 280x302. Difficulty label at 40,40, the combo at
 //40,68, Play at 40,180, Cancel below it.
	I64	 x;
	I64	 y;
	I64	 w;
	I64	 h;
	I64	 pitch;
	I64	 i;
	U8	*label;

	HLMenuBgDraw(c);

	x = HLDlgX(c, 390);
	y = HLDlgY(c, 254);
	w = HLDlgX(c, 280);
	h = HLDlgY(c, 302);

	HLMenuPanel(c, x, y, w, h, "New Game");

	pitch = HLMenuLineH();

	HLMenuStrColor(c, x + HLDlgX(c, 40), y + HLDlgY(c, 40),
		"Select Difficulty", HLMENU_C_HINT);

	for (i = 0; i < HLSKILL_ROWS; i++)
	{
		label = HLMenuSkillLabel(i);

		if (!label)
			goto qng_next;

		if (i == hl_skill_row)
			HLMenuStrColor(c, x + HLDlgX(c, 52),
				y + HLDlgY(c, 68) + i * pitch, label, HLMENU_C_SEL);
		else
			HLMenuStrColor(c, x + HLDlgX(c, 52),
				y + HLDlgY(c, 68) + i * pitch, label, HLMENU_C_ITEM);

qng_next:
	}

	HLMenuStrColor(c, x + HLDlgX(c, 40), y + HLDlgY(c, 180),
		"Enter - Play Half-Life", HLMENU_C_ITEM);
	HLMenuStrColor(c, x + HLDlgX(c, 40), y + HLDlgY(c, 180) + pitch,
		"Esc   - Cancel", HLMENU_C_ITEM);
}

Bool HLNewGameKey(I64 sc, Bool *_start_game)
{
	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_skill_row--;
		if (hl_skill_row < 0)
			hl_skill_row = HLSKILL_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_skill_row++;
		if (hl_skill_row >= HLSKILL_ROWS)
			hl_skill_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		//gSkillData reads skill 1..3; the combo is 0-based.
		HLCvarSet("skill", ToF64(hl_skill_row + 1));
		HLCvarSet("deathmatch", 0.0);
		HLCvarSet("coop", 0.0);
		HLSvMaxClientsSet(1);

		//HL has no episode or skill hub; the campaign opens on the tram.
		HLStrCopy(hl_change_map, "c0a0", 64);
		hl_change_pending = TRUE;

		if (_start_game)
			*_start_game = TRUE;

		hl_menu_page = HLPAGE_MAIN;
		return TRUE;
	}

	return FALSE;
}

U0 HLSlotListDraw(CHLCanvas *c, U8 *title, U8 *help, U8 *action, Bool new_row)
{//The body shared by LoadGameDialog and SaveGameDialog: both are 152,142
 //508x414 with the help label at 20,30 and the buttons on the bottom row.
	I64	 x;
	I64	 y;
	I64	 w;
	I64	 h;
	I64	 pitch;
	I64	 row;
	I64	 i;
	I64	 col;
	U8	 line[96];

	HLMenuBgDraw(c);

	x = HLDlgX(c, 152);
	y = HLDlgY(c, 142);
	w = HLDlgX(c, 508);
	h = HLDlgY(c, 414);

	HLMenuPanel(c, x, y, w, h, title);

	pitch = HLMenuLineH();
	col   = x + HLDlgX(c, 20);

	HLMenuStrColor(c, col, y + HLDlgY(c, 30), help, HLMENU_C_HINT);

	row = 0;

	if (new_row)
	{
		if (hl_slot_row == 0)
			HLMenuStrColor(c, col, y + HLDlgY(c, 80), "New Saved Game",
				HLMENU_C_SEL);
		else
			HLMenuStrColor(c, col, y + HLDlgY(c, 80), "New Saved Game",
				HLMENU_C_ITEM);

		row = 1;
	}

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		if (!hl_slot_used[i])
			goto qsl_next;

		StrPrint(line, "Slot %d - %s", i + 1,
			&hl_slot_map[i * HLSAVE_NAME_MAX]);

		if (row == hl_slot_row)
			HLMenuStrColor(c, col, y + HLDlgY(c, 80) + row * pitch, line,
				HLMENU_C_SEL);
		else
			HLMenuStrColor(c, col, y + HLDlgY(c, 80) + row * pitch, line,
				HLMENU_C_ITEM);

		row++;

qsl_next:
	}

	if (!row)
		HLMenuStrColor(c, col, y + HLDlgY(c, 80), "No saved games.",
			HLMENU_C_HINT);

	HLMenuStrColor(c, col, y + HLDlgY(c, 378), action, HLMENU_C_ITEM);
	HLMenuStrColor(c, col, y + HLDlgY(c, 378) + pitch, "Esc   - Cancel",
		HLMENU_C_ITEM);
}

I64 HLSlotRowCount(Bool new_row)
{//Rows the list is showing: used slots, plus New Saved Game on the save page.
	I64 n = 0;
	I64 i;

	if (new_row)
		n = 1;

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		if (hl_slot_used[i])
			n++;
	}

	return n;
}

I64 HLSlotAtRow(I64 want, Bool new_row)
{//Slot index for a list row, or -1 for the New Saved Game row.
	I64 row = 0;
	I64 i;

	if (new_row)
	{
		if (!want)
			return -1;

		row = 1;
	}

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		if (!hl_slot_used[i])
			goto qsa_next;

		if (row == want)
			return i;

		row++;

qsa_next:
	}

	return -1;
}

I64 HLSlotFirstFree()
{//Lowest slot with no save in it, or -1 when all eight are taken.
	I64 i;

	for (i = 0; i < HLSAVE_SLOTS; i++)
	{
		if (!hl_slot_used[i])
			return i;
	}

	return -1;
}

Bool HLSlotKey(I64 sc, Bool *_start_game, Bool saving)
{//Shared navigation for both slot lists.
	I64 count = HLSlotRowCount(saving);
	I64 slot;

	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_slot_row--;
		if (hl_slot_row < 0)
			hl_slot_row = count - 1;
		if (hl_slot_row < 0)
			hl_slot_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_slot_row++;
		if (hl_slot_row >= count)
			hl_slot_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		if (!count)
			return TRUE;

		slot = HLSlotAtRow(hl_slot_row, saving);

		if (saving)
		{
			//New Saved Game takes the lowest empty slot; picking an existing
			//row overwrites it, which is what the dialog's help text says.
			if (slot < 0)
				slot = HLSlotFirstFree();

			if (slot < 0)
				return TRUE;
			if (!hl_game_active)
				return TRUE;

			HLMenuSound(HLMSND_ENTER);
			hl_menu_slot     = slot;
			hl_menu_save_req = TRUE;
		}
		else
		{
			if (slot < 0)
				return TRUE;

			HLMenuSound(HLMSND_ENTER);
			hl_menu_slot     = slot;
			hl_menu_load_req = TRUE;
		}

		hl_menu_page = HLPAGE_MAIN;

		if (_start_game)
			*_start_game = TRUE;

		return TRUE;
	}

	return FALSE;
}

U0 HLLoadGameDraw(CHLCanvas *c)
{
	HLSlotListDraw(c, "Load Game",
		"Select a saved game in the list below, then press Enter.",
		"Enter - Load", FALSE);
}

U0 HLSaveGameDraw(CHLCanvas *c)
{
	HLSlotListDraw(c, "Save Game",
		"Select 'New Saved Game' to create a file, or a saved game to overwrite it.",
		"Enter - Save", TRUE);
}

U0 HLMenuDraw(CHLCanvas *c)
{//HL's main menu: backdrop, item column, help text for the armed item.
	I64	 items[HLITEM_MAX];
	I64	 count;
	I64	 i;
	I64	 gh;
	I64	 pitch;
	I64	 col_x;
	I64	 hint_x;
	I64	 top;
	I64	 y;
	U8	*label;
	U8	*hint;

	if (hl_menu_page == HLPAGE_OPTIONS)
	{
		HLOptDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_KEYS)
	{
		HLKeysDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_NOTICE)
	{
		HLNoticeDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_HELP)
	{
		HLHelpDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_LANCONFIG)
	{
		HLLanDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_SINGLE)
	{
		HLSingleDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_MULTI)
	{
		HLMultiDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_SETUP)
	{
		HLSetupDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_GAMEOPT)
	{
		HLGoDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_NEWGAME)
	{
		HLNewGameDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_LOADGAME)
	{
		HLLoadGameDraw(c);
		return;
	}

	if (hl_menu_page == HLPAGE_SAVEGAME)
	{
		HLSaveGameDraw(c);
		return;
	}

	//In game the world stays up and dimmed; out of game the backdrop fills.
	if (hl_menu_ingame)
		HLDrawFadeScreen(c);
	else
	{
		HLMenuBgDraw(c);

		//The shipped backdrop carries the wordmark. Without it, draw one.
		if (!hl_menu_bg_art)
			HLMenuStrColor(c, ToI64(c->width * HLMENU_COL_X),
				ToI64(c->height * 0.16), "HALF-LIFE", HLMENU_C_SEL);
	}

	count = HLMenuItems(items);

	if (hl_menu_row < 0)			hl_menu_row = 0;
	if (hl_menu_row >= count)	hl_menu_row = count - 1;

	gh = HLCHAR_H;
	if (hl_font.ready)
		gh = hl_font.row_height;

	pitch  = ToI64(gh * HLMENU_PITCH);
	col_x  = ToI64(c->width * HLMENU_COL_X);
	hint_x = ToI64(c->width * HLMENU_HINT_X);
	top    = ToI64(c->height * HLMENU_COL_Y);

	//Bottom-anchored: the list grows upward from a fixed baseline as items
	//appear in game, the way VGUI lays the column out.
	if (top + count * pitch + pitch > c->height)
		top = c->height - count * pitch - pitch;

	for (i = 0; i < count; i++)
	{
		label = HLMenuItemLabel(items[i]);

		if (!label)
			goto qmd_next;

		y = top + i * pitch;

		if (i == hl_menu_row)
		{
			HLMenuStrColor(c, col_x, y, label, HLMENU_C_SEL);

			hint = HLMenuItemHint(items[i]);

			if (hint)
				HLMenuStrColor(c, hint_x, y, hint, HLMENU_C_HINT);
		}
		else
			HLMenuStrColor(c, col_x, y, label, HLMENU_C_ITEM);

qmd_next:
	}
}

Bool HLOptKey(I64 sc)
{//Up/Down walk the page, Left/Right adjust or change tab, Enter activates.
	I64 rows = HLOptRows(hl_opt_tab);

	if (hl_opt_row >= rows)
		hl_opt_row = rows - 1;

	if (sc == SC_ESC)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_page = HLPAGE_MAIN;
		return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_opt_row--;
		if (hl_opt_row < 0)
			hl_opt_row = rows - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_opt_row++;
		if (hl_opt_row >= rows)
			hl_opt_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		HLMenuSound(HLMSND_VALUE);

		//On the strip, Left/Right is the tab change. The row index is kept
		//inside the new page's range by HLOptDraw and the guard above.
		if (hl_opt_row == HLOPT_STRIP)
		{
			if (sc == SC_CURSOR_LEFT)
				hl_opt_tab--;
			else
				hl_opt_tab++;

			if (hl_opt_tab < 0)
				hl_opt_tab = HLTAB_COUNT - 1;
			if (hl_opt_tab >= HLTAB_COUNT)
				hl_opt_tab = 0;

			return TRUE;
		}

		if (hl_opt_tab == HLTAB_KEYBOARD)
		{
			if (hl_opt_row == HLKB_ALWAYSRUN)
			{
				//The speed cvars move together, as M_AdjustSliders does.
				if (HLCvarGet("cl_forwardspeed") > 200.0)
				{
					HLCvarSet("cl_forwardspeed", 200.0);
					HLCvarSet("cl_backspeed", 200.0);
				}
				else
				{
					HLCvarSet("cl_forwardspeed", 400.0);
					HLCvarSet("cl_backspeed", 400.0);
				}
			}
		}
		else if (hl_opt_tab == HLTAB_AIM)
		{
			if (hl_opt_row == HLAIM_SENS)
			{
				if (sc == SC_CURSOR_LEFT)
					hl_opt_sensitivity -= 0.02;
				else
					hl_opt_sensitivity += 0.02;

				if (hl_opt_sensitivity < 0.02)
					hl_opt_sensitivity = 0.02;
				if (hl_opt_sensitivity > 0.60)
					hl_opt_sensitivity = 0.60;
			}
			else if (hl_opt_row == HLAIM_INVERT)
				HLCvarSet("m_pitch", -HLCvarGet("m_pitch"));
		}
		else if (hl_opt_tab == HLTAB_AUDIO)
		{
			if (hl_opt_row == HLAUD_SFX)
			{
				if (sc == SC_CURSOR_LEFT)
					hl_opt_volume -= 10;
				else
					hl_opt_volume += 10;

				hl_opt_volume = ClampI64(hl_opt_volume, 0, 100);
				hl_snd_master = ToF64(hl_opt_volume) / 100.0;
			}
			else if (hl_opt_row == HLAUD_MP3)
			{
				//Applied to the running track, so the bar is audible as it
				//moves.
				if (sc == SC_CURSOR_LEFT)
					hl_music_volume -= 0.1;
				else
					hl_music_volume += 0.1;

				if (hl_music_volume < 0.0)
					hl_music_volume = 0.0;
				if (hl_music_volume > 1.0)
					hl_music_volume = 1.0;

				HLMusicApplyVolume;
			}
		}
		else
		{
			if (hl_opt_row == HLVID_RES)
			{
				if (sc == SC_CURSOR_LEFT)
					hl_opt_res--;
				else
					hl_opt_res++;

				hl_opt_res = ClampI64(hl_opt_res, 0, HLRES_COUNT - 1);

				//The render target cannot be reallocated here; the compositor
				//may be mid-blit. The shell rebuilds between frames on this
				//flag.
				hl_res_dirty = TRUE;
			}
			else if (hl_opt_row == HLVID_WINDOWED)
			{
				hl_opt_fullscreen = !hl_opt_fullscreen;
				hl_res_dirty      = TRUE;
			}
			else if (hl_opt_row == HLVID_GAMMA)
			{
				//Left darkens. M_AdjustSliders does gamma -= dir * 0.05 with
				//dir -1 for left, so left raises the exponent; the bar shows
				//(max - gamma), so both track.
				if (sc == SC_CURSOR_LEFT)
					hl_opt_gamma += 0.05;
				else
					hl_opt_gamma -= 0.05;

				if (hl_opt_gamma < HLGAMMA_MIN)
					hl_opt_gamma = HLGAMMA_MIN;
				if (hl_opt_gamma > HLGAMMA_MAX)
					hl_opt_gamma = HLGAMMA_MAX;

				HLPalSetGamma(hl_opt_gamma);
			}
		}

		//Written straight out; there is no Apply button.
		HLCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_opt_row == HLOPT_STRIP)
			return TRUE;

		if (hl_opt_tab == HLTAB_KEYBOARD)
		{
			if (hl_opt_row == HLKB_BINDINGS)
			{
				hl_keys_row     = 0;
				hl_keys_capture = FALSE;
				hl_menu_page    = HLPAGE_KEYS;
			}
			else if (hl_opt_row == HLKB_DEFAULTS)
				HLOptResetDefaults;
			else if (hl_opt_row == HLKB_CLOSE)
				hl_menu_page = HLPAGE_MAIN;
		}
		else if (hl_opt_tab == HLTAB_AIM)
		{
			if (hl_opt_row == HLAIM_CLOSE)
				hl_menu_page = HLPAGE_MAIN;
		}
		else if (hl_opt_tab == HLTAB_AUDIO)
		{
			if (hl_opt_row == HLAUD_CLOSE)
				hl_menu_page = HLPAGE_MAIN;
		}
		else
		{
			if (hl_opt_row == HLVID_CLOSE)
				hl_menu_page = HLPAGE_MAIN;
		}

		return TRUE;
	}

	return FALSE;
}

Bool HLMenuKey(I64 sc, Bool *_start_game)
{//M_Keydown. TRUE when the key was consumed
	I64 main_items[HLITEM_MAX];
	I64 main_count;

	*_start_game = FALSE;

	if (hl_menu_page == HLPAGE_NOTICE)
	{
		if (sc == SC_ENTER)
		{
			HLMenuSound(HLMSND_ENTER);
			hl_menu_page = HLPAGE_MAIN;
			return TRUE;
		}
		return FALSE;
	}

	if (hl_menu_page == HLPAGE_OPTIONS)
		return HLOptKey(sc);

	if (hl_menu_page == HLPAGE_KEYS)
		return HLKeysKey(sc);

	if (hl_menu_page == HLPAGE_HELP)
		return HLHelpKey(sc);

	if (hl_menu_page == HLPAGE_LANCONFIG)
		return HLLanKey(sc);

	if (hl_menu_page == HLPAGE_SINGLE)
		return HLSingleKey(sc, _start_game);

	if (hl_menu_page == HLPAGE_MULTI)
		return HLMultiKey(sc);

	if (hl_menu_page == HLPAGE_SETUP)
		return HLSetupKey(sc);

	if (hl_menu_page == HLPAGE_GAMEOPT)
		return HLGoKey(sc);

	if (hl_menu_page == HLPAGE_NEWGAME)
		return HLNewGameKey(sc, _start_game);

	if (hl_menu_page == HLPAGE_LOADGAME)
		return HLSlotKey(sc, _start_game, FALSE);

	if (hl_menu_page == HLPAGE_SAVEGAME)
		return HLSlotKey(sc, _start_game, TRUE);

	main_count = HLMenuItems(main_items);

	if (sc == SC_CURSOR_UP)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_row--;
		if (hl_menu_row < 0)
			hl_menu_row = main_count - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		HLMenuSound(HLMSND_MOVE);
		hl_menu_row++;
		if (hl_menu_row >= main_count)
			hl_menu_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		HLMenuSound(HLMSND_ENTER);

		if (hl_menu_row < 0 || hl_menu_row >= main_count)
			return TRUE;

		switch (main_items[hl_menu_row])
		{
			case HLITEM_RESUME:
				hl_state = HLST_PLAYING;
				break;

			case HLITEM_NEWGAME:
				hl_menu_page  = HLPAGE_NEWGAME;
				hl_skill_row  = HLSKILL_MEDIUM;
				break;

			case HLITEM_SAVE:
				hl_menu_page = HLPAGE_SAVEGAME;
				hl_slot_row  = 0;
				HLMenuSlotScan;
				break;

			case HLITEM_LOAD:
				hl_menu_page = HLPAGE_LOADGAME;
				hl_slot_row  = 0;
				HLMenuSlotScan;
				break;

			case HLITEM_FIND:
				hl_menu_page = HLPAGE_LANCONFIG;
				hl_lan_row   = 0;
				break;

			case HLITEM_CREATE:
				hl_menu_page = HLPAGE_GAMEOPT;
				hl_go_row    = 0;
				break;

			case HLITEM_OPTIONS:
				hl_menu_page = HLPAGE_OPTIONS;
				hl_opt_row   = 0;
				break;

			case HLITEM_LEAVE:
				hl_menu_leave_req = TRUE;
				break;

			case HLITEM_QUIT:
				hl_quit_request = TRUE;
				break;

			default:
				break;
		}
		return TRUE;
	}

	return FALSE;
}
