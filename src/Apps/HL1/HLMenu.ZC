// HLMenu.ZC - main menu, console, and the game state machine
//
// Engine side, not QuakeC. The main menu follows HL's VGUI layout: a tiled
// photographic backdrop from resource/background, a left-aligned item column,
// and the selected item's help text to its right. Submenus keep the Quake page
// furniture, which valve/ has no art for and which VGUI replaced wholesale.

#define HLST_MENU		0
#define HLST_PLAYING		1
#define HLST_CONSOLE		2

//Main menu items, in resource/GameMenu.res order. Labels and help text are
//the shipped English strings from resource/gameui_english.txt.
//
//RESUME, SAVE and LEAVE carry OnlyInGame, so the visible list is built per
//frame by HLMenuItems and hl_menu_row indexes that list, not this table.
#define HLITEM_RESUME	0
#define HLITEM_NEWGAME	1
#define HLITEM_SAVE		2
#define HLITEM_LOAD		3
#define HLITEM_FIND		4
#define HLITEM_CREATE	5
#define HLITEM_OPTIONS	6
#define HLITEM_LEAVE		7
#define HLITEM_QUIT		8
#define HLITEM_MAX		9

//Item column, as fractions of the canvas. VGUI positions in 640x480 units and
//scales; fixed pixels would push the column off a 320x240 canvas.
#define HLMENU_COL_X		0.15
#define HLMENU_COL_Y		0.37
#define HLMENU_HINT_X	0.45
#define HLMENU_PITCH		2.00	//row pitch in glyph heights

//Submenu furniture, unchanged from the Quake page layout.
#define HLMENU_X			72
#define HLMENU_Y			32
#define HLMENU_ROW_H		20
#define HLMENU_CURSOR_X	54

#define HLCON_LINES		24
#define HLCON_WIDTH		40
#define HLCON_HEIGHT		128		//console drops down this far

//current page
#define HLPAGE_MAIN		0
#define HLPAGE_OPTIONS	1
#define HLPAGE_NOTICE	2
#define HLPAGE_MULTI		3
#define HLPAGE_SETUP		4
#define HLPAGE_HELP		5
#define HLPAGE_LANCONFIG	6
#define HLPAGE_SINGLE	7
#define HLPAGE_KEYS		8
#define HLPAGE_GAMEOPT	9
#define HLPAGE_NEWGAME	10
#define HLPAGE_LOADGAME	11
#define HLPAGE_SAVEGAME	12

//resource/*.res dialog geometry is authored in the 800x600 space the background
//art uses: LoadGameDialog alone is 152+508 wide, past 640.
#define HLDLG_W			800
#define HLDLG_H			600

//HL keeps an unbounded save list. Eight slots, named so slot 0 is the file the
//single-slot path already wrote.
#define HLSAVE_SLOTS		8
#define HLSAVE_NAME_MAX	48

//NewGameDialog's Difficulty combo. skill 1/2/3; "default" "1" is Medium.
#define HLSKILL_EASY		0
#define HLSKILL_MEDIUM	1
#define HLSKILL_HARD		2
#define HLSKILL_ROWS		3

//M_Menu_SinglePlayer_f's rows, in the original's order
#define HLSP_NEWGAME		0
#define HLSP_LOAD		1
#define HLSP_SAVE		2
#define HLSP_ROWS		3

I64  hl_sp_row       = 0;
Bool hl_menu_save_req = FALSE;	//polled by the main loop, it owns save/load
Bool hl_menu_load_req = FALSE;

//CBasePlayer's flashlight, impulse 100. EF_DIMLIGHT is a projected spot in
//the retail client and this renderer has none, so the beam is a dlight parked
//ahead of the eye and refreshed once a frame. m_iFlashBattery drains and
//recharges on the SDK's two clocks.
#define HLFLASH_DRAIN	1.2		//FLASH_DRAIN_TIME, seconds per unit spent
#define HLFLASH_CHARGE	0.2		//FLASH_CHARGE_TIME, seconds per unit regained
#define HLFLASH_RADIUS	220.0	//dlight radius, no SDK counterpart
#define HLFLASH_AHEAD	72.0	//how far down the view ray the beam lands

Bool hl_flash_on		= FALSE;
I64  hl_flash_battery	= 100;
F64  hl_flash_next		= 0.0;	//next drain or charge tick, wall clock

//CBasePlayer::m_pLastItem, for lastinv. HLWeaponSetActive does not record the
//weapon it holstered, so the swap is noticed once a frame instead.
I64  hl_con_wpn_seen	= -1;	//what hl_wpn_active was at the last sample
I64  hl_con_wpn_prev	= -1;	//the one before that

//ClientCommand "fov" reports the live value. hl_fov lives in the shell, which
//compiles after this file and clears the request once it has applied it, so
//the last value asked for is shadowed here.
F64  hl_con_fov_last	= 90.0;

//M_LanConfig, the JOIN GAME - TCP/IP page. address typed here, not console
#define HLLAN_ADDRESS	0
#define HLLAN_SEARCH		1		//broadcast query, results listed below
#define HLLAN_JOIN		2
#define HLLAN_BACK		3
#define HLLAN_ROWS		4

//M_Help's NUM_HELP_PAGES. help0..help5.lmp are in PAK0 on both releases - the
//pages are the ordering info, which is why the row reads HELP/ORDERING either
//way. that label is baked into gfx/mainmenu.lmp, not gated on a version
#define HLHELP_PAGES		6

//multiplayer rows. the first three MUST match gfx/mp_menu.lmp - JOIN A GAME,
//NEW GAME, SETUP. back is ours, drawn small underneath. no level row: the map
//is chosen on game options, where the original keeps it
#define HLMP_JOIN		0
#define HLMP_NEW			1
#define HLMP_SETUP		2
#define HLMP_BACK		3
#define HLMP_ROWS		4

//setup rows. no "accept changes" row - values apply as they are edited
#define HLSET_NAME		0
#define HLSET_TOP		1
#define HLSET_BOTTOM		2
#define HLSET_BACK		3
#define HLSET_ROWS		4

//M_Options_Draw's rows, in its order. resolution, screen and gun depth are
//ours - the original has no windowed video to configure
//--- key bindings -----------------------------------------------------------
//
// movement keys live in a table so the customize page can rebind and save
// them. same idea as the original's bind commands with default.cfg

#define HLBIND_FORWARD	0
#define HLBIND_BACK		1
#define HLBIND_LEFT		2
#define HLBIND_RIGHT		3
#define HLBIND_JUMP		4
//HL crouches and quake did not - vents, crawlspaces and the tram all need it
#define HLBIND_DUCK		5
//+use. HL operates doors, buttons and trains by hand; quake walked into them
#define HLBIND_USE		6
#define HLBIND_COUNT		7

I64		hl_bind_key[HLBIND_COUNT];
U8		*hl_bind_label[HLBIND_COUNT];
//console spelling of the same actions, so bind/unbind talk in id's names
U8		*hl_bind_cmd[HLBIND_COUNT];
//HLCfgLoad runs BEFORE HLCvarInit, so it parks crosshair here - setting the
//cvar early gets a second entry appended by the init that follows
I64		hl_opt_crosshair	= 1;
I64		hl_keys_row		= 0;
Bool	hl_keys_capture	= FALSE;	//next keypress is the new binding

U0 HLBindDefaults()
{//globals aren't zeroed, set every slot
	hl_bind_key[HLBIND_FORWARD] = Char2ScanCode('w');
	hl_bind_key[HLBIND_BACK]    = Char2ScanCode('s');
	hl_bind_key[HLBIND_LEFT]    = Char2ScanCode('a');
	hl_bind_key[HLBIND_RIGHT]   = Char2ScanCode('d');
	hl_bind_key[HLBIND_JUMP]    = Char2ScanCode(' ');
	hl_bind_key[HLBIND_DUCK]    = Char2ScanCode('c');
	hl_bind_key[HLBIND_USE]     = Char2ScanCode('e');

	hl_bind_label[HLBIND_FORWARD] = "move forward";
	hl_bind_label[HLBIND_BACK]    = "move back";
	hl_bind_label[HLBIND_LEFT]    = "move left";
	hl_bind_label[HLBIND_RIGHT]   = "move right";
	hl_bind_label[HLBIND_JUMP]    = "jump / swim up";
	hl_bind_label[HLBIND_DUCK]    = "duck";
	hl_bind_label[HLBIND_USE]     = "use";

	hl_bind_cmd[HLBIND_FORWARD] = "+forward";
	hl_bind_cmd[HLBIND_BACK]    = "+back";
	hl_bind_cmd[HLBIND_LEFT]    = "+moveleft";
	hl_bind_cmd[HLBIND_RIGHT]   = "+moveright";
	hl_bind_cmd[HLBIND_JUMP]    = "+jump";
	hl_bind_cmd[HLBIND_DUCK]    = "+duck";
	hl_bind_cmd[HLBIND_USE]     = "+use";
}

U0 HLBindKeyName(U8 *out, I64 sc)
{//printable name for a scancode, spelling out the non-character keys
	I64 ch;

	//the customize page clears a slot to 0, and unbind does the same. no
	//scancode of 0 arrives from the keyboard, so it reads as empty
	if (sc <= 0)
	{
		StrPrint(out, "???");
		return;
	}

	if (sc == Char2ScanCode(' '))
	{
		StrPrint(out, "space");
		return;
	}

	ch = ScanCode2Char(sc);
	if (ch > 32 && ch < 127)
		StrPrint(out, "%c", ch);
	else
		StrPrint(out, "key %d", sc);
}

I64 HLBindKeyParse(U8 *name)
{//inverse of HLBindKeyName: 0 when nothing sane comes out
	I64 sc;
	I64 ch;

	if (!name[0])
		return 0;

	if (!StrICompare(name, "space"))
		return Char2ScanCode(' ');

	if (!name[1])
	{
		ch = name[0];
		if (ch >= 'A' && ch <= 'Z')
			ch += 32;
		return Char2ScanCode(ch);
	}

	//"key 42" prints as two tokens, so accept the bare number too
	if (!StrNICompare(name, "key", 3))
	{
		sc = Str2I64(name + 3);
		if (sc > 0)
			return sc;
		return 0;
	}

	if (name[0] >= '0' && name[0] <= '9')
	{
		sc = Str2I64(name);
		if (sc > 0)
			return sc;
	}

	return 0;
}

I64 HLBindFindAction(U8 *cmd)
{//action name to HLBIND_ index, -1 for none. leading + optional
	I64 i;

	if (!cmd[0])
		return -1;

	for (i = 0; i < HLBIND_COUNT; i++)
	{
		if (!StrICompare(cmd, hl_bind_cmd[i]))
			return i;
		if (!StrICompare(cmd, hl_bind_cmd[i] + 1))
			return i;
	}

	return -1;
}

//--- aliases ---------------------------------------------------------------
//
// Cmd_Alias_f's list. a fixed table, not a malloc'd chain: nothing here frees
// and 32 is more than any config ships with

#define HLALIAS_MAX		32
#define HLALIAS_NAME		64
#define HLALIAS_TEXT		128
#define HLALIAS_DEPTH	8		//Cmd_ExecuteString's recursion guard

U8	hl_alias_name[HLALIAS_MAX * HLALIAS_NAME];
U8	hl_alias_text[HLALIAS_MAX * HLALIAS_TEXT];
I64	hl_alias_count = 0;
I64	hl_alias_depth = 0;

U0 HLAliasInit()
{//globals aren't zeroed and the count indexes a fixed array
	I64 i;

	for (i = 0; i < HLALIAS_MAX; i++)
	{
		hl_alias_name[i * HLALIAS_NAME] = 0;
		hl_alias_text[i * HLALIAS_TEXT] = 0;
	}

	hl_alias_count = 0;
	hl_alias_depth = 0;
}

I64 HLAliasFind(U8 *name)
{//index or -1
	I64 i;

	for (i = 0; i < hl_alias_count; i++)
	{
		if (!StrICompare(hl_alias_name + i * HLALIAS_NAME, name))
			return i;
	}

	return -1;
}

//No screen-size row. Quake shrank the 3D view inside the status bar; HL always
//renders full screen, so viewsize is pinned at 100 and the - / = keys are not
//bound to it.
//OptionsDialog's tab strip. HL ships Multiplayer, Keyboard, Aim, Audio, Video,
//Voice and Lock. Only the four with controls this port implements are listed;
//the other three would be empty pages.
#define HLTAB_KEYBOARD	0
#define HLTAB_AIM		1
#define HLTAB_AUDIO		2
#define HLTAB_VIDEO		3
#define HLTAB_COUNT		4

//Row 0 of every page is the tab strip itself, so Up from the first control
//reaches it and Left/Right there changes page. The last row is Close.
#define HLOPT_STRIP		0

#define HLKB_BINDINGS	1
