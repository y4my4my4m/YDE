//--- save slots -------------------------------------------------------------
I64		hl_skill_row		= HLSKILL_MEDIUM;
I64		hl_slot_row		= 0;
I64		hl_menu_slot		= 0;		//slot the shell saves to / loads from
Bool	hl_slot_used[HLSAVE_SLOTS];
