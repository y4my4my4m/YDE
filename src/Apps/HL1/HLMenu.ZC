#define HLVID_RES		1
#define HLVID_WINDOWED	2
#define HLVID_GAMMA		3
#define HLVID_CLOSE		4

//render target sizes, not window sizes - the result is centred and integer
//scaled into whatever window it lands in. this is the performance dial,
//640x480 is four times the rasteriser work of 320x240
#define HLRES_COUNT		5
I64 hl_res_w[HLRES_COUNT] = {320, 400, 512, 640, 800};
I64 hl_res_h[HLRES_COUNT] = {240, 300, 384, 480, 600};

