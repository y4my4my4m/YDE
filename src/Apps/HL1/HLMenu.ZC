	HLActAdd("blank", "MISCELLANEOUS",      HLACT_HEADER);
	HLActAdd("+showscores", "Display multiplayer scores", HLACT_ACTION);
	HLActAdd("snapshot",   "Take screen shot", HLACT_ACTION);
	HLActAdd("save quick", "Quick save",       HLACT_ACTION);
	HLActAdd("load quick", "Quick load",       HLACT_ACTION);
	HLActAdd("pause",      "Pause game",       HLACT_ACTION);
	HLActAdd("quit",       "Quit game",        HLACT_ACTION);
}

U0 HLActLoad()
{//gfx/shell/kb_act.lst into the customize list, labels resolved as it goes
	U8	*raw;
	U8	*loc;
	U8	 line[160];
	U8	 cmd[HLACT_CMD_MAX];
	U8	 tok[64];
	U8	 label[HLACT_LBL_MAX];
	I64	 size = 0;
	I64	 loc_size = 0;
	I64	 i = 0;
	I64	 n;
	I64	 p;
	I64	 kind;

	hl_act_count     = 0;
	hl_act_from_file = FALSE;

	raw = HLFileLoad("gfx/shell/kb_act.lst", &size);
	if (!raw || size <= 0)
	{
		if (raw)
			Free(raw);

		HLActFallback;
		return;
	}

	loc = HLLocLoad(&loc_size);

	while (i < size)
	{
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 159)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && raw[i] != '\n' && raw[i] != '\r')
			i++;
		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qal_next;

		p = HLQuotedField(cmd, line, 0, HLACT_CMD_MAX);
		p = HLQuotedField(tok, line, p, 64);

		if (!cmd[0])
			goto qal_next;

		kind = HLACT_ACTION;
		if (!StrICompare(cmd, "blank"))
		{
			//a divider: either a rule of equals signs or a section title
			if (tok[0] == '#')
				kind = HLACT_HEADER;
			else
				kind = HLACT_RULE;
		}

		if (tok[0] == '#')
			HLLocFind(label, HLACT_LBL_MAX, loc, loc_size, tok + 1);
		else
			HLStrCopy(label, tok, HLACT_LBL_MAX);

		//the rules are pure VGUI furniture and cost a row each on a 320x240
		//canvas, so the headers carry the separation instead
		if (kind != HLACT_RULE)
			HLActAdd(cmd, label, kind);

qal_next:
	}

	Free(raw);
	if (loc)
		Free(loc);

	hl_act_from_file = TRUE;

	//an unreadable or empty list leaves nothing to bind against
	if (hl_act_count < 2)
	{
		hl_act_count     = 0;
		hl_act_from_file = FALSE;
		HLActFallback;
	}
}

