#define HLOPT_SENS		1
#define HLOPT_VOLUME		2
#define HLOPT_MUSICVOL	3		//the /music folder, not a CD
#define HLOPT_ALWAYSRUN	4		//cl_forwardspeed 200 or 400
#define HLOPT_INVERT		5		//m_pitch sign
//no lookspring/lookstrafe rows: both need a +mlook key to hold, and this port
//mouse-looks permanently. the cvars still exist for the console
#define HLOPT_RES		6
#define HLOPT_FULLSCREEN	7
#define HLOPT_GAMMA		8
