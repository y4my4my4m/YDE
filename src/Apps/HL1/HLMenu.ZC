I64 HLGoEpisodeCount()
{//M_GameOptions_Key's own count: 7 registered, 2 otherwise. episodes 2-4, end
 //and the dm maps are all PAK1, so shareware reaches start and episode 1 only
	if (HLCvarGet("registered") != 0.0)
		return HLGO_EPISODES;

	return 2;
}

I64 HLGoLevelCount()
{//levels in the selected episode, never zero
	return hl_go_ep_count[hl_go_episode];
}

I64		hl_set_row		= 0;

//player identity, the original's name and color client commands. held here
//and published on the wire at signon
U8		hl_setup_name[16];

//COM_AddGameDirectory's target, empty means valve only
U8		hl_game_dir[32];
I64		hl_setup_top		= 0;	//shirt, 0-13
I64		hl_setup_bottom	= 0;	//trousers, 0-13
Bool	hl_setup_editing	= FALSE;
Bool	hl_setup_ate_enter = FALSE;

//join page address field
I64		hl_lan_row		= 0;
U8		hl_lan_addr[24];
Bool	hl_lan_editing	= FALSE;
I64		hl_lan_len		= 0;
Bool	hl_lan_ate_enter	= FALSE;
I64		hl_setup_len		= 0;

//the multiplayer page wants a listen server, the app shell owns the world
Bool	hl_mp_start_dm	= FALSE;

//live settings the options page edits
F64		hl_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		hl_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		hl_opt_res			= 0;		//index into hl_res_w / hl_res_h
Bool	hl_opt_fullscreen	= TRUE;
F64		hl_opt_gamma			= 1.0;		//1.0 untouched, lower is brighter

//FALSE is the software renderer's behaviour - the gun goes in the depth buffer
//like any model and sinks into a wall pressed against. TRUE is GLQuake's
//glDepthRange(0, 0.3), which never intersects anything
Bool	hl_opt_gunclip		= FALSE;
Bool	hl_res_dirty			= FALSE;	//the app must rebuild the canvas

