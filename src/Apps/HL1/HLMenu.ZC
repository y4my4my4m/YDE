	HLActAdd("+right",     "Turn right",    HLACT_ACTION);
	HLActAdd("+moveleft",  "Move left (strafe)",  HLACT_ACTION);
	HLActAdd("+moveright", "Move right (strafe)", HLACT_ACTION);
	HLActAdd("+jump",      "Jump",          HLACT_ACTION);
	HLActAdd("+duck",      "Duck",          HLACT_ACTION);
	HLActAdd("+moveup",    "Swim up",       HLACT_ACTION);
	HLActAdd("+movedown",  "Swim down",     HLACT_ACTION);
	HLActAdd("+lookup",    "Look up",       HLACT_ACTION);
	HLActAdd("+lookdown",  "Look down",     HLACT_ACTION);
	HLActAdd("force_centerview", "Look straight ahead", HLACT_ACTION);
	HLActAdd("+strafe",    "Strafe modifier",        HLACT_ACTION);
	HLActAdd("+mlook",     "Mouse look modifier",    HLACT_ACTION);
	HLActAdd("+klook",     "Keyboard look modifier", HLACT_ACTION);
	HLActAdd("+use",       "Use items",     HLACT_ACTION);

	HLActAdd("blank", "COMMUNICATION",      HLACT_HEADER);
	HLActAdd("+voicerecord", "Use voice communication", HLACT_ACTION);
	HLActAdd("messagemode",  "Chat message", HLACT_ACTION);
	HLActAdd("messagemode2", "Team message", HLACT_ACTION);

	HLActAdd("blank", "COMBAT",             HLACT_HEADER);
	HLActAdd("+attack",    "Primary attack",   HLACT_ACTION);
	HLActAdd("+attack2",   "Secondary attack", HLACT_ACTION);
	HLActAdd("+reload",    "Reload weapon",    HLACT_ACTION);
	HLActAdd("+speed",     "Walk",             HLACT_ACTION);
	HLActAdd("impulse 100", "Flashlight",      HLACT_ACTION);
	HLActAdd("impulse 201", "Spray logo",      HLACT_ACTION);
	HLActAdd("slot1",      "Weapon category 1", HLACT_ACTION);
	HLActAdd("slot2",      "Weapon category 2", HLACT_ACTION);
