// HL1.ZC - app shell: window, input, frame loop.
//
// rendering runs on this task; the blit runs in the draw_it callback on the
// window manager task, which must never block - it copies pixels and nothing
// else.

//cl_forwardspeed, and that times cl_movespeedkey: the original's defaults.
//Run exceeds sv_maxspeed (320); the move code clamps, so diagonals are no
//faster than straight.
#define HLMOVE_SPEED		200.0	//world units per second
#define HLMOVE_FAST		400.0
#define HLPITCH_LIMIT	89.0

//CL_AdjustAngles' rates, degrees per second. cl_yawspeed and cl_pitchspeed in
//the original, which this port has no cvars for.
#define HLLOOK_YAWSPEED	210.0
#define HLLOOK_PITCHSPEED	225.0
//HL's first map. c0a0 is the tram ride: brush entities and scripted sequences,
//no combat. Skill and episode are chosen in-world, not from a menu page.
#define HLDEFAULT_MAP	"maps/c0a0.bsp"

//entities are not in the PVS, so range-limit instead. 2000 covers a large
//room without submitting the whole level.
#define HLENT_DRAW_DIST	2000.0
#define HLENT_LIGHT		170		//flat shade until models sample the lightmap

#define HLVIEW_HEIGHT	22.0	//eye height above the player origin

//server tick: off the jiffy counter, not the render rate. QuakeC timings and
//the physics were tuned against 72Hz.
#define HLSERVER_HZ			72.0
#define HLSERVER_STEP		(1.0 / HLSERVER_HZ)
#define HLSERVER_MAX_CATCHUP	4

//view model sits at the eye; its verts carry the offset. V_CalcRefdef
//copies the view origin in and adds only bob.
#define HLVM_FORWARD		0.0
#define HLVM_RIGHT		0.0
#define HLVM_UP			0.0
#define HLVM_LIGHT		200		//weapons read brighter than world entities

//hl_map declared in HLBSP.ZC (needed by HLNetSv before this file).
CHLVisState	*hl_vis		= NULL;
CHLCanvas	*hl_canvas	= NULL;

//Resolution the canvas was actually built at. hl_opt_res is what the menu asked
//for, which is not the same thing once an allocation has been refused.
I64			 hl_res_applied = 0;

F64	 hl_origin[3];		//player origin, what physics moves
F64	 hl_view[3];			//eye position, origin plus the view height
F64	 hl_velocity[3];
F64	 hl_angles[3];
Bool hl_on_ground	= FALSE;
Bool hl_noclip		= FALSE;
I64	 hl_water_level	= 0;
I64	 hl_water_type	= 0;
I64	 hl_water_last	= 0;	//water level last frame, for surface crossings
F64	 hl_fov			= 90.0;
I64	 hl_blit_w		= 320;
I64	 hl_blit_h		= 240;
I64	 hl_blit_x		= 0;
I64	 hl_blit_y		= 0;
Bool hl_draw_entities = TRUE;
I64	 hl_ent_drawn	= 0;
Bool hl_ready		= FALSE;
F64	 hl_fps			= 0.0;
I64	 hl_frame_count	= 0;

Bool hl_loading = FALSE;		//SCR_BeginLoadingPlaque / scr_drawloading

U0 HLDrawIt(CTask *task, CDC *dc)
{//window manager task: copy only. Every pointer is cleared before the owner
 //frees it; these guards keep teardown out of an in-flight blit.
	//A map load blocks the game task but not this one, and hl_vis stays NULL
	//throughout, so blit the plaque the loader painted.
	if (hl_loading && hl_ready && hl_canvas)
	{
		HLDrawBlitFit(hl_canvas, dc, hl_blit_x, hl_blit_y, hl_blit_w, hl_blit_h);
		return;
	}

	if (!hl_ready || !hl_canvas)
		return;

	HLDrawBlitFit(hl_canvas, dc, hl_blit_x, hl_blit_y, hl_blit_w, hl_blit_h);


	//No HUD text here: Sbar draws it into the canvas, through the game's own
	//art and palette.
}

U0 HLRenderEntities()
{//brush models first, then alias. Depth tested, so order affects speed only.
	CHLEntity *e;
	F64		  dist[3];
	F64		  cycle;
	I64		  i;

	hl_ent_drawn = 0;

	//Model 0 is the world itself and is already drawn by the PVS path.
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!hl_r_drawentities)
			goto qde_next_brush;

		//EF_NODRAW, and dead slots. A trigger volume is a real brush model
		//with a real texture on it; drawing it fills the screen with the
		//mapper's trigger texture and costs a full surface pass per volume.
		if (!e->in_use || (e->effects & HLEF_NODRAW))
			goto qde_next_brush;

		if (e->brush_model > 0)
		{
			//Same registry the trace uses, so draw and collide agree.
			//e->angles is not a valid signal: HLTrainNext writes yaw into
			//angles[1] every frame as bookkeeping.
			if (HLClipIsRotatingDraw(i))
				HLDrawBrushModel(hl_canvas, hl_map, e->brush_model,
					e->origin, e->frame, e->angles);
			else
				HLDrawBrushModel(hl_canvas, hl_map, e->brush_model,
					e->origin, e->frame);
			hl_ent_drawn++;
		}

qde_next_brush:
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->mdl && !e->studio)
			goto qde_next;

		//Distance reject before touching the triangles.
		HLVecSub(e->origin, hl_origin, dist);
		if (HLVecLength(dist) >= HLENT_DRAW_DIST)
			goto qde_next;

		if (e->studio)
		{
			//HLAI.ZC owns playback: anim_start per entity, so a scripted
			//one-shot holds its last frame instead of looping.
			cycle = HLAIEntityCycle(e);

			//e->controllers, not NULL: raw setting 0 is not neutral, it is
			//the channel's start. scientist.mdl's controller 0 spans
			//-60..60, so a NULL array held every head bone 60 degrees over
			//and made every NPC look sideways. MonsterInit calls
			//InitBoneControllers for exactly this reason.
			//Trailing entity index keys the sequence-transition latch. Without
			//it a sequence change swaps the pose in one frame.
			HLStudioDraw(hl_canvas, e->studio, e->origin, e->angles,
				e->seq, cycle, 0.0, e->body, e->skin,
				HLEntLightPoint(hl_map, e), e->controllers, 0.0, i);
		}
		else
			HLMdlDraw(hl_canvas, e->mdl, e->frame, e->origin,
				e->angles[1], HLEntLightPoint(hl_map, e));

		hl_ent_drawn++;

qde_next:
	}
}

//--- stuck detector --------------------------------------------------------
//
// Input applied and origin unchanged across several server steps means the move
// is being refused.
#define HLSTUCK_STEPS	12		//consecutive refused steps before reporting
#define HLSTUCK_REPORTS	4

F64 hl_stuck_org[3];
I64 hl_stuck_steps	= 0;
I64 hl_stuck_said	= 0;
U8  hl_stuck_line[192];

U0 HLStuckInit()
{
	HLVecSet(hl_stuck_org, 0.0, 0.0, 0.0);
	hl_stuck_steps = 0;
	hl_stuck_said  = 0;
}

U0 HLStuckCheck(F64 *wishdir, F64 wishspeed)
{//Called once per server step, after the move.
	F64		d[3];
	F64		probe[3];
	CHLTrace	tr;
	I64		blocker;

	//No wish direction: standing still is correct.
	if (wishspeed <= 0.0 ||
		(wishdir[0] == 0.0 && wishdir[1] == 0.0 && wishdir[2] == 0.0))
	{
		hl_stuck_steps = 0;
		HLVecCopy(hl_origin, hl_stuck_org);
		return;
	}

	HLVecSub(hl_origin, hl_stuck_org, d);

	if (HLVecLength(d) > 0.5)
	{
		hl_stuck_steps = 0;
		HLVecCopy(hl_origin, hl_stuck_org);
		return;
	}

	hl_stuck_steps++;

	if (hl_stuck_steps != HLSTUCK_STEPS || hl_stuck_said >= HLSTUCK_REPORTS)
		return;

	//Only report when the sweep is clear; a wall legitimately blocks the move.
	HLVecMA(hl_origin, 4.0, wishdir, probe);
	HLTracePlayer(hl_map, hl_origin, probe, &tr);

	if (tr.fraction < 1.0)
	{
		//Geometry in the way: not stuck.
		hl_stuck_steps = 0;
		return;
	}

	hl_stuck_said++;

	blocker = -1;
	if (hl_game_active && hl_player_edict > 0)
		blocker = HLTestEntityPosition(hl_map, hl_player_edict);

	StrPrint(hl_stuck_line,
		"stuck: at %.0f %.0f %.0f vel %.0f %.0f %.0f ground=%d water=%d\n",
		hl_origin[0], hl_origin[1], hl_origin[2],
		hl_velocity[0], hl_velocity[1], hl_velocity[2],
		hl_on_ground, hl_water_level);
	HLLog(hl_stuck_line);

	if (blocker < 0)
		HLLog("stuck: player position is CLEAR - the move is being refused\n");
	else if (blocker == 0)
		HLLog("stuck: player is embedded in the WORLD\n");
	else
	{
		StrPrint(hl_stuck_line, "stuck: embedded in edict %d (%s)\n", blocker,
			HLPrStr(HLPrFieldI(blocker, hl_fld_classname)));
		HLLog(hl_stuck_line);
	}

	//A clear position is not the question; the sweep is. Repeat the move and
	//report the trace that refuses it. ent -1 is the world.
	HLVecMA(hl_origin, 4.0, wishdir, probe);
	HLTracePlayer(hl_map, hl_origin, probe, &tr);

	StrPrint(hl_stuck_line,
		"stuck: probe frac=%.3f solid=%d/%d hit=%d ent=%d n=%.2f %.2f %.2f\n",
		tr.fraction, tr.all_solid, tr.start_solid, tr.hit, tr.ent,
		tr.plane_normal[0], tr.plane_normal[1], tr.plane_normal[2]);
	HLLog(hl_stuck_line);

	if (tr.ent > 0)
	{
		StrPrint(hl_stuck_line, "stuck: blocked by edict %d (%s) solid=%d\n",
			tr.ent, HLPrStr(HLPrFieldI(tr.ent, hl_fld_classname)),
			ToI64(HLPrFieldF(tr.ent, hl_fld_solid)));
		HLLog(hl_stuck_line);

		//Blocker bounds plus brush number: bounds far from the player mean the
		//trace ran against the wrong submodel.
		StrPrint(hl_stuck_line,
			"stuck:   bmodel=%d org %.0f %.0f %.0f  mins %.0f %.0f %.0f  maxs %.0f %.0f %.0f\n",
			HLClipBrushModel(ToI64(HLPrFieldF(tr.ent, hl_fld_modelindex))),
			HLPrFieldF(tr.ent, hl_fld_origin + 0),
			HLPrFieldF(tr.ent, hl_fld_origin + 1),
			HLPrFieldF(tr.ent, hl_fld_origin + 2),
			HLPrFieldF(tr.ent, hl_fld_mins + 0),
			HLPrFieldF(tr.ent, hl_fld_mins + 1),
			HLPrFieldF(tr.ent, hl_fld_mins + 2),
			HLPrFieldF(tr.ent, hl_fld_maxs + 0),
			HLPrFieldF(tr.ent, hl_fld_maxs + 1),
			HLPrFieldF(tr.ent, hl_fld_maxs + 2));
		HLLog(hl_stuck_line);
	}

	HLLogFlush;
}

//--- cshifts ----------------------------------------------------------------
//
// V_UpdatePalette blends four shifts, each a destination colour plus a percent,
// applied in sequence so a hit while underwater reads as both.
//
//   CONTENTS - eye submersion (HLLiquidView)
//   DAMAGE   - red, scaled by damage taken, decays at 150/sec
//   BONUS    - pickup flash, decays at 100/sec
//   POWERUP  - quad blue, invulnerability yellow, suit green
#define HLCS_DAMAGE_RATE		150.0
#define HLCS_BONUS_RATE		100.0

//powerup bits from defs.qc. 4096 is IT_AXE, always held - do not use it for a
//powerup test.
//
//    IT_AXE             4096      IT_INVISIBILITY   524288
//    IT_SUPERHEALTH    16384      IT_INVULNERABILITY 1048576
//    IT_KEY1          131072      IT_SUIT          2097152
//    IT_KEY2          262144      IT_QUAD          4194304
#define HLIT_INVISIBILITY	524288
#define HLIT_INVULNERABILITY	1048576
#define HLIT_SUIT			2097152
#define HLIT_QUAD			4194304

F64 hl_cs_dmg_pct	= 0.0;
F64 hl_cs_bonus_pct	= 0.0;

U0 HLCShiftInit()
{
	hl_cs_dmg_pct   = 0.0;
	hl_cs_bonus_pct = 0.0;
}

U0 HLCShiftDamage(F64 count)
{//V_ParseDamage: percent += 3*count, clamped to 150.
	hl_cs_dmg_pct += 3.0 * count;

	if (hl_cs_dmg_pct < 0.0)
		hl_cs_dmg_pct = 0.0;
	if (hl_cs_dmg_pct > 150.0)
		hl_cs_dmg_pct = 150.0;
}

U0 HLCShiftBonus()
{//V_BonusFlash: the pickup flash is a fixed colour at 50 percent.
	hl_cs_bonus_pct = 50.0;
}

U0 HLCShiftUpdate(F64 dt)
{//Decay both flashes. The original uses host_frametime here.
	hl_cs_dmg_pct -= dt * HLCS_DAMAGE_RATE;
	if (hl_cs_dmg_pct < 0.0)
		hl_cs_dmg_pct = 0.0;

	hl_cs_bonus_pct -= dt * HLCS_BONUS_RATE;
	if (hl_cs_bonus_pct < 0.0)
		hl_cs_bonus_pct = 0.0;
}

U0 HLCShiftAdd(F64 *_r, F64 *_g, F64 *_b, F64 *_a,
	F64 dr, F64 dg, F64 db, F64 percent)
{//one shift folded into the running blend, as V_CalcBlend does it
 //
 //    a2 = percent/255      <- 255, not 100; the percents are 0..255
 //    a  = a + a2*(1-a)
 //    a2 = a2/a
 //    r  = r*(1-a2) + destcolor*a2
 //
 //destcolor stays fully saturated and the alpha carries the strength. Scaling
 //the colour by its own percent first shifts twice and washes the destination
 //out.
	F64 a2;

	if (percent <= 0.0)
		return;

	a2 = percent / 255.0;
	if (a2 > 1.0)
		a2 = 1.0;

	*_a = *_a + a2 * (1.0 - *_a);
	if (*_a <= 0.0)
		return;

	a2 = a2 / *_a;

	*_r = *_r * (1.0 - a2) + dr * a2;
	*_g = *_g * (1.0 - a2) + dg * a2;
	*_b = *_b * (1.0 - a2) + db * a2;
}

U0 HLCShiftBlend(I64 *_r, I64 *_g, I64 *_b, I64 *_a)
{//V_CalcBlend. contents, damage, bonus, powerup, in that order
 //
 //in: the CONTENTS shift, destcolor in _r.._b and its percent in _a
 //out: the folded tint, alpha 0..255
	F64 r = 0.0;
	F64 g = 0.0;
	F64 b = 0.0;
	F64 a = 0.0;
	I64 items = 0;

	//V_CalcPowerupCshift reads cl.items, off svc_clientdata: a demo or a
	//remote client has no server edict to read.
	if (HLClientMode)
		items = hl_cl.items;
	else if (hl_player_active && hl_player_edict > 0 && hl_fld_items >= 0)
		items = ToI64(HLPrFieldF(hl_player_edict, hl_fld_items));

	HLCShiftAdd(&r, &g, &b, &a,
		ToF64(*_r), ToF64(*_g), ToF64(*_b), ToF64(*_a));

	//V_ParseDamage caps its own percent at 150
	HLCShiftAdd(&r, &g, &b, &a, 255.0, 0.0, 0.0, hl_cs_dmg_pct);

	//the pickup flash
	HLCShiftAdd(&r, &g, &b, &a, 215.0, 186.0, 69.0, hl_cs_bonus_pct);

	//V_CalcPowerupCshift is an if/else chain: one shift only, in this order
	if (items & HLIT_QUAD)
		HLCShiftAdd(&r, &g, &b, &a, 0.0, 0.0, 255.0, 30.0);
	else if (items & HLIT_SUIT)
		HLCShiftAdd(&r, &g, &b, &a, 0.0, 255.0, 0.0, 20.0);
	else if (items & HLIT_INVISIBILITY)
		HLCShiftAdd(&r, &g, &b, &a, 100.0, 100.0, 100.0, 100.0);
	else if (items & HLIT_INVULNERABILITY)
		HLCShiftAdd(&r, &g, &b, &a, 255.0, 255.0, 0.0, 30.0);

	if (a > 1.0)
		a = 1.0;
	if (a < 0.0)
		a = 0.0;

	*_r = ClampI64(ToI64(r), 0, 255);
	*_g = ClampI64(ToI64(g), 0, 255);
	*_b = ClampI64(ToI64(b), 0, 255);
	*_a = ClampI64(ToI64(a * 255.0), 0, 255);
}

//--- weapon punch and damage kick ------------------------------------------
//
// Two view-only effects, applied to a copy of the angles:
//
//   punchangle  - QuakeC sets .punchangle on fire (shotgun uses -2 pitch)
//   damage kick - V_ParseDamage turns a hit into roll and pitch, directed by
//                 where the damage came from
//
// Cvar defaults below are the original's.
#define HLKICK_ROLL		0.6
#define HLKICK_PITCH		0.6
#define HLKICK_TIME		0.5

F64 hl_dmg_roll		= 0.0;
F64 hl_dmg_pitch		= 0.0;
F64 hl_dmg_time		= 0.0;
F64 hl_punch[3];
F64 hl_dmg_last		= 0.0;	//dmg_take+dmg_save seen last frame
I64 hl_con_return_state = HLST_PLAYING;	//state the console was opened from

//Entities whose reconstructed client state disagreed with the server's world on
//the last tick. Should be 0; anything else is an encode or decode fault.
I64 hl_net_mismatch = 0;

//When the last connection request went out, so it can be repeated.
F64 hl_join_last_try = 0.0;
U8  hl_join_line[96];
F64 hl_heap_check_last = 0.0;
U8  hl_heap_check_line[48];

F64 hl_tick_log_last = 0.0;
I64 hl_tick_log_n    = 0;
U8  hl_tick_line[160];

U0 HLViewKickInit()
{
	hl_dmg_roll  = 0.0;
	hl_dmg_pitch = 0.0;
	hl_dmg_time  = 0.0;
	hl_dmg_last  = 0.0;
	HLVecSet(hl_punch, 0.0, 0.0, 0.0);
}

U0 HLViewKickUpdate(F64 dt)
{//Pick up a new punch or hit, and decay what is already running.
	F64 from[3];
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 dir[3];
	F64 count;
	F64 side;
	F64 len;
	I64 inflictor;
	I64 j;

	if (!hl_player_active || hl_player_edict <= 0)
	{
		HLViewKickInit;
		return;
	}

	//--- weapon punch ---
	//
	//Read straight off the edict - the field IS the current kick. Recovery
	//happens in DropPunchAngle each client think.
	if (hl_fld_punchangle >= 0)
	{
		for (j = 0; j < 3; j++)
			hl_punch[j] = HLPrFieldF(hl_player_edict, hl_fld_punchangle + j);
	}

	//--- damage kick ---
	//
	//Thin client: QuakeC never writes local dmg_take. svc_damage parks the hit
	//in hl_net_damage_*, V_ParseDamage's inputs.
	if (hl_net_damage_pending)
	{
		count = ToF64(hl_net_damage_take) + ToF64(hl_net_damage_save);
		if (count < 10.0)
			count = 10.0;
		if (count > 255.0)
			count = 255.0;

		HLCShiftDamage(count);

		HLVecSub(hl_net_damage_from, hl_origin, dir);
		len = HLVecLength(dir);
		if (len > 0.0)
		{
			HLVecScale(dir, 1.0 / len, dir);
			HLAngleVectors(hl_angles, fwd, rgt, upv);
			side        = HLVecDot(dir, rgt);
			hl_dmg_roll  = count * side * HLKICK_ROLL;
			side        = HLVecDot(dir, fwd);
			hl_dmg_pitch = count * side * HLKICK_PITCH;
			hl_dmg_time  = HLKICK_TIME;
		}

		hl_net_damage_pending = FALSE;
		hl_net_damage_take    = 0;
		hl_net_damage_save    = 0;
	}
	else if (hl_fld_dmg_take >= 0 && hl_fld_dmg_save >= 0)
	{
		count = HLPrFieldF(hl_player_edict, hl_fld_dmg_take) +
				HLPrFieldF(hl_player_edict, hl_fld_dmg_save);

		//Only a change counts as a fresh hit; the fields persist between frames.
		if (count > 0.0 && count != hl_dmg_last)
		{
			if (count < 10.0)
				count = 10.0;

			//V_ParseDamage reads armour and blood as bytes - cap at 255.
			if (count > 255.0)
				count = 255.0;

			//V_ParseDamage does the kick and the cshift from the one message.
			HLCShiftDamage(count);

			inflictor = 0;
			if (hl_fld_dmg_inflictor >= 0)
				inflictor = HLPrEdictNum(
					HLPrFieldI(hl_player_edict, hl_fld_dmg_inflictor));

			if (inflictor > 0)
			{
				for (j = 0; j < 3; j++)
					from[j] = HLPrFieldF(inflictor, hl_fld_origin + j);

				HLVecSub(from, hl_origin, dir);
				len = HLVecLength(dir);

				if (len > 0.0)
				{
					HLVecScale(dir, 1.0 / len, dir);
					HLAngleVectors(hl_angles, fwd, rgt, upv);

					//Where the damage came from decides which way the view is
					//thrown: sideways damage rolls it, frontal damage pitches.
					side        = HLVecDot(dir, rgt);
					hl_dmg_roll  = count * side * HLKICK_ROLL;

					side        = HLVecDot(dir, fwd);
					hl_dmg_pitch = count * side * HLKICK_PITCH;

					hl_dmg_time  = HLKICK_TIME;
				}
			}
		}

		hl_dmg_last = count;

		//SV_WriteClientdataToMessage clears these after sending: left standing,
		//an identical second hit reads as no change and gives no flash or kick.
		if (count > 0.0)
		{
			HLPrSetFieldF(hl_player_edict, hl_fld_dmg_take, 0.0);
			HLPrSetFieldF(hl_player_edict, hl_fld_dmg_save, 0.0);
			hl_dmg_last = 0.0;
		}
	}

	//Thin client: punchangle arrives in clientdata, not on the local edict.
	//The host has already decayed it, so this is the value to use as-is.
	if (hl_udp_ready && !hl_udp_server)
	{
		for (j = 0; j < 3; j++)
			hl_punch[j] = hl_cl.punchangle[j];
	}

	if (hl_dmg_time > 0.0)
	{
		hl_dmg_time -= dt;
		if (hl_dmg_time < 0.0)
			hl_dmg_time = 0.0;
	}

	//Pickup flash is driven by QuakeC stuffing "bf", not by watching .items:
	//health and already-held ammo set no bit, and a fading powerup clears one.

	HLCShiftUpdate(dt);
}

//V_AddIdle: three sines that make the view breathe when standing still.
//v_idlescale is 0 in stock HL1, so this is off by default.
#define HLIDLE_ROLL_CYCLE	0.5
#define HLIDLE_PITCH_CYCLE	1.0
#define HLIDLE_YAW_CYCLE		2.0
#define HLIDLE_ROLL_LEVEL	0.1
#define HLIDLE_PITCH_LEVEL	0.3
#define HLIDLE_YAW_LEVEL		0.3

F64 hl_idle_scale = 0.0;		//v_idlescale

U0 HLViewAddIdle(F64 *angles)
{
	if (hl_idle_scale == 0.0)
		return;

	angles[2] += hl_idle_scale * Sin(tS * HLIDLE_ROLL_CYCLE) * HLIDLE_ROLL_LEVEL;
	angles[0] += hl_idle_scale * Sin(tS * HLIDLE_PITCH_CYCLE) * HLIDLE_PITCH_LEVEL;
	angles[1] += hl_idle_scale * Sin(tS * HLIDLE_YAW_CYCLE) * HLIDLE_YAW_LEVEL;
}

U0 HLViewApplyKick(F64 *angles)
{//Fold every view-only angle effect into a copy of the angles.
	F64 frac;

	angles[0] += hl_punch[0];
	angles[1] += hl_punch[1];
	angles[2] += hl_punch[2];

	if (hl_dmg_time > 0.0)
	{
		frac = hl_dmg_time / HLKICK_TIME;
		angles[2] += frac * hl_dmg_roll;
		angles[0] += frac * hl_dmg_pitch;
	}

	HLViewAddIdle(angles);
}

//--- view bob and roll -----------------------------------------------------
//
// View-only: applied to the render copy of the angles, never to hl_angles, which
// feeds .v_angle and would lean the player's aim with the camera.

//cl_bob, cl_bobcycle, cl_bobup - cl_dll/view.cpp:1720-1722. Quake's defaults
//are 0.02 and 0.6, which double the amplitude and run the cycle 25% fast.
#define HLBOB_AMOUNT		0.01	//bob per unit of horizontal speed
#define HLBOB_CYCLE		0.8		//seconds for a full step cycle
#define HLBOB_UP			0.5		//fraction of the cycle spent rising

//V_CalcRoll takes movevars->rollangle/rollspeed, not the cl_ cvars (view.cpp:410).
//Those defaults live in the engine, which is not in the SDK checkout; GoldSrc
//ships sv_rollangle 0, so stock HL1 does not lean into a strafe. Quake's 2.0 is
//what the fork inherited.
#define HLROLL_ANGLE		0.0		//degrees of lean at full strafe
#define HLROLL_SPEED		200.0	//strafe speed at which the lean maxes out

F64 hl_bob_time	= 0.0;	//accumulated walking time, NOT wall-clock time
F64 hl_bob_value	= 0.0;	//last computed bob, held while airborne
F64 hl_bob_prev	= 0.0;	//real time of the previous update

U0 HLViewBobUpdate()
{//V_CalcBob. Called once per frame; read twice, for the eye and the weapon, so
 //advancing the clock in the reader would double the cycle rate.
 //
 //Airborne holds the last value (original: if (onground == -1) return bob;);
 //zeroing jolts the view on every jump. The cycle runs on accumulated walking
 //time, not wall-clock, so the phase resumes where it left off on landing.
	F64 cycle;
	F64 bob;
	F64 speed;
	F64 dt;

	dt         = tS - hl_bob_prev;
	hl_bob_prev = tS;

	//A level load must not dump a huge delta into the cycle.
	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	if (!hl_on_ground)
		return;

	hl_bob_time += dt;

	cycle = hl_bob_time - ToF64(ToI64(hl_bob_time / HLBOB_CYCLE)) * HLBOB_CYCLE;
	cycle /= HLBOB_CYCLE;

	//Rise and fall occupy different fractions of the cycle.
	if (cycle < HLBOB_UP)
		cycle = pi * cycle / HLBOB_UP;
	else
		cycle = pi + pi * (cycle - HLBOB_UP) / (1.0 - HLBOB_UP);

	//Horizontal speed only: falling must not bob.
	speed = Sqrt(hl_velocity[0] * hl_velocity[0] +
				 hl_velocity[1] * hl_velocity[1]);

	bob = speed * HLBOB_AMOUNT;
	bob = bob * 0.3 + bob * 0.7 * Sin(cycle);

	if (bob > 4.0)
		bob = 4.0;
	if (bob < -7.0)
		bob = -7.0;

	hl_bob_value = bob;
}

F64 HLViewBob()
{//The bob for this frame. Read-only: HLViewBobUpdate owns the clock.
	return hl_bob_value;
}

F64 hl_view_oldz	= 0.0;	//eye height being caught up to after a step
F64 hl_step_prev	= 0.0;

F64 HLViewStepOffset()
{//V_CalcRefdef stair smoothing: the eye chases the new height at 80 units/sec,
 //never lagging more than 12 units behind. Up only; falling is immediate.
	F64 dt = tS - hl_step_prev;

	hl_step_prev = tS;

	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	if (!hl_on_ground || hl_origin[2] - hl_view_oldz <= 0.0)
	{
		hl_view_oldz = hl_origin[2];
		return 0.0;
	}

	hl_view_oldz += dt * 80.0;

	if (hl_view_oldz > hl_origin[2])
		hl_view_oldz = hl_origin[2];
	if (hl_origin[2] - hl_view_oldz > 12.0)
		hl_view_oldz = hl_origin[2] - 12.0;

	return hl_view_oldz - hl_origin[2];
}

F64 HLViewRoll(F64 *angles, F64 *velocity)
{//Lean into a strafe, proportional to sideways speed.
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 side;
	F64 sign;

	HLAngleVectors(angles, fwd, rgt, upv);
	side = HLVecDot(velocity, rgt);

	if (side < 0.0)
	{
		sign = -1.0;
		side = -side;
	}
	else
		sign = 1.0;

	if (side < HLROLL_SPEED)
		side = side * HLROLL_ANGLE / HLROLL_SPEED;
	else
		side = HLROLL_ANGLE;

	return side * sign;
}


U0 HLLiquidView()
{//screen wash, view warp and the surface-crossing sounds.
 //Tints are the original's, folded into the palette rather than blended per
 //pixel: 8bpp indices cannot be averaged.
	I64 r = 0;
	I64 g = 0;
	I64 b = 0;
	I64 a = 0;

	//Water level 3 is eye depth; only a submerged eye tints the view.
	if (hl_water_level >= 3)
	{
		switch (hl_water_type)
		{
			case HLCONTENTS_LAVA:
				r = 255; g = 80;  b = 0;  a = 150;
				break;
			case HLCONTENTS_SLIME:
				r = 0;   g = 25;  b = 5;  a = 150;
				break;
			default:
				r = 130; g = 80;  b = 50; a = 128;
				break;
		}

		hl_warp_amount = 4.0;
	}
	else
		hl_warp_amount = 0.0;

	hl_warp_time = tS;

	//All four shifts collapse into one tint.
	HLCShiftBlend(&r, &g, &b, &a);

	HLPalSetTint(r, g, b, a);

	//Edged against last frame, or the sound fires every frame while submerged.
	if (hl_water_level > 0 && hl_water_last == 0)
	{
		if (hl_water_type == HLCONTENTS_LAVA)
			HLSndPlayAt("player/inlava.wav", hl_view, 1.0, 0.0);
		else if (hl_water_type == HLCONTENTS_SLIME)
			HLSndPlayAt("player/slimbrn2.wav", hl_view, 1.0, 0.0);
		else
			HLSndPlayAt("player/inh2o.wav", hl_view, 1.0, 0.0);
	}
	else if (hl_water_level == 0 && hl_water_last > 0)
		HLSndPlayAt("misc/outwater.wav", hl_view, 1.0, 0.0);

	hl_water_last = hl_water_level;
}

U0 HLHudDrawFrame(CHLCanvas *c)
{//HL HUD in place of Quake's status bar: none of Sbar's art (SBAR, IBAR, the
 //big digits) exists in valve/.
 //
 //With a VM the numbers come from the player edict; without one, from the
 //native entity world.
	I64 health  = 100;
	I64 battery = 0;
	I64 ammo    = -1;

	//The entity world owns the player's health and armour. HLPlayerHealth and
	//HLPlayerArmor now read the same globals, so there is no second path.
	health  = ToI64(hl_ent_player_health);
	battery = ToI64(hl_ent_player_armor);

	ammo = HLWeaponAmmo;

	//HL hides the suit readout until item_suit sets hl_ent_player_suit.
	HLHudDraw(c, health, battery, ammo, hl_ent_player_suit);
}

//--- CHudMessage, drawing half ----------------------------------------------
//
// The state lives in HLHud.ZC. Measuring and drawing are here because the font
// is in HLWad.ZC, which compiles after HLHud.ZC.

I64 HLHudMsgLines(I64 *_widest)
{//Line count and widest line, both needed before the block can be placed.
 //
 //game_text carries an unprocessed escape: a literal backslash then n.
	I64 lines = 1;
	I64 w     = 0;
	I64 best  = 0;
	I64 i     = 0;

	while (hl_msg_text[i])
	{
		if (hl_msg_text[i] == '\\' && hl_msg_text[i + 1] == 'n')
		{
			if (w > best)
				best = w;

			w = 0;
			lines++;
			i += 2;
			goto qhml_next;
		}

		w += HLFontCharWidth(hl_msg_text[i]);
		i++;

qhml_next:
	}

	if (w > best)
		best = w;

	if (_widest)
		*_widest = best;

	return lines;
}

U0 HLHudMsgChar(CHLCanvas *c, I64 x, I64 y, I64 ch, I64 r, I64 g, I64 b)
{//One glyph in a flat colour.
 //
 //CONCHARS glyphs are pre-coloured orange over a dark outline, so the colour is
 //modulated by each texel's luminance rather than replacing it. Same rule as
 //HLMenuCharColor, which compiles later and cannot be called from here.
	U8	*base;
	U8	*pal;
	U8	*src;
	U32	*dst;
	I64	 ofs;
	I64	 gx;
	I64	 gy;
	I64	 gw;
	I64	 gh;
	I64	 sx;
	I64	 sy;
	I64	 px;
	I64	 py;
	I64	 stride;
	I64	 lim;
	I64	 cut;
	I64	 lum;
	U8	 texel;

	ch &= 255;

	if (ch == 32)
		return;

	if (hl_font.ready)
	{
		if (!hl_font.pixels)
			return;

		ofs    = hl_font.start[ch];
		gw     = hl_font.cwidth[ch];
		gh     = hl_font.row_height;
		stride = HLFONT_WIDTH;
		gx     = ofs % HLFONT_WIDTH;
		gy     = ofs / HLFONT_WIDTH;
		lim    = hl_font.height;
		pal    = hl_font.palette;
		cut    = HLSPR_TRANSPARENT;
		base   = hl_font.pixels;
	}
	else
	{
		if (!hl_conchars)
			return;

		gw     = HLCHAR_W;
		gh     = HLCHAR_H;
		stride = 128;
		gx     = (ch & 15) * HLCHAR_W;
		gy     = (ch >> 4) * HLCHAR_H;
		lim    = 128;
		pal    = NULL;
		cut    = 0;
		base   = hl_conchars;
	}

	if (gw < 1)
		return;

	for (sy = 0; sy < gh; sy++)
	{
		py = y + sy;

		if (py < 0 || py >= c->height)
			goto qhmc_next_row;
		if (gy + sy >= lim)
			goto qhmc_next_row;

		src = base + (gy + sy) * stride + gx;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < gw; sx++)
		{
			px = x + sx;

			if (px < 0 || px >= c->width)
				goto qhmc_next_col;
			if (gx + sx >= stride)
				goto qhmc_next_col;

			texel = src[sx];

			if (texel == cut)
				goto qhmc_next_col;

			if (pal)
			{
				lum = pal[texel * 3];
				if (pal[texel * 3 + 1] > lum)	lum = pal[texel * 3 + 1];
				if (pal[texel * 3 + 2] > lum)	lum = pal[texel * 3 + 2];
			}
			else
				lum = 255;

			dst[px] = ((r * lum / 255) << 16) |
					  ((g * lum / 255) << 8) |
					   (b * lum / 255);

qhmc_next_col:
		}

qhmc_next_row:
	}
}

U0 HLHudMsgDraw(CHLCanvas *c)
{//CHudMessage::Draw and MessageScanNextChar.
 //
 //blend runs 0 for pure source to 255 for pure destination, and the
 //destination is black: that is how HL fades text with no alpha channel.
	F64	 t;
	F64	 fade_time;
	F64	 char_time;
	F64	 delta;
	I64	 blend;
	I64	 lines;
	I64	 widest = 0;
	I64	 gh;
	I64	 x0;
	I64	 y0;
	I64	 x;
	I64	 y;
	I64	 i;
	I64	 sr;
	I64	 sg;
	I64	 sb;
	I64	 dr;
	I64	 dg;
	I64	 db;
	I64	 scanned;
	Bool flicker;

	if (!hl_msg_active || !hl_msg_text[0])
		return;

	t = tS - hl_msg_start;

	gh = HLCHAR_H;
	if (hl_font.ready)
		gh = hl_font.row_height;

	lines = HLHudMsgLines(&widest);

	//Effect 2 holds each character for fadein seconds, so the string's own
	//length extends the hold.
	if (hl_msg_effect == HLMSG_FX_WRITEOUT)
		fade_time = hl_msg_fadein * ToF64(StrLen(hl_msg_text)) + hl_msg_hold;
	else
		fade_time = hl_msg_fadein + hl_msg_hold;

	if (t > fade_time + hl_msg_fadeout)
	{
		hl_msg_active = FALSE;
		return;
	}

	//--- whole-string blend ---
	blend = 0;

	if (hl_msg_effect == HLMSG_FX_WRITEOUT)
	{
		if (t > fade_time && hl_msg_fadeout > 0.0)
			blend = ToI64((t - fade_time) / hl_msg_fadeout * 255.0);
	}
	else
	{
		if (t < hl_msg_fadein && hl_msg_fadein > 0.0)
			blend = ToI64((hl_msg_fadein - t) / hl_msg_fadein * 255.0);
		else if (t > fade_time)
		{
			if (hl_msg_fadeout > 0.0)
				blend = ToI64((t - fade_time) / hl_msg_fadeout * 255.0);
			else
				blend = 255;
		}
	}

	x0 = HLHudMsgAxis(hl_msg_x, widest, c->width);
	y0 = HLHudMsgAxis(hl_msg_y, lines * gh, c->height);

	x       = x0;
	y       = y0;
	i       = 0;
	scanned = 0;

	//MessageScanStart rolls the flicker once per line, not per character:
	//10 in 100 lines get a second pass in colour 2 over the first
	//(message.cpp:232).
	flicker = ToBool(hl_msg_effect == HLMSG_FX_FLICKER &&
				RandU32() % 100 < 10);

	while (hl_msg_text[i])
	{
		if (hl_msg_text[i] == '\\' && hl_msg_text[i + 1] == 'n')
		{
			x = x0;
			y += gh;
			i += 2;

			flicker = ToBool(hl_msg_effect == HLMSG_FX_FLICKER &&
						RandU32() % 100 < 10);

			goto qhmd_next;
		}

		sr = hl_msg_r1;
		sg = hl_msg_g1;
		sb = hl_msg_b1;
		dr = 0;
		dg = 0;
		db = 0;

		if (hl_msg_effect == HLMSG_FX_WRITEOUT)
		{
			//A character the scan has not reached is black; the one being
			//written crossfades from colour 2 to colour 1 over fxtime.
			char_time = ToF64(scanned) * hl_msg_fadein;

			if (char_time > t)
			{
				sr    = 0;
				sg    = 0;
				sb    = 0;
				blend = 0;
			}
			else
			{
				delta = t - char_time;

				if (t <= fade_time)
				{
					if (hl_msg_fxtime > 0.0 && delta <= hl_msg_fxtime)
					{
						dr    = hl_msg_r2;
						dg    = hl_msg_g2;
						db    = hl_msg_b2;
						blend = 255 -
							ToI64(delta / hl_msg_fxtime * 255.0 + 0.5);
					}
					else
						blend = 0;
				}
			}
		}

		if (blend > 255)	blend = 255;
		if (blend < 0)		blend = 0;

		//The SDK's >> 8, not / 255: an 8-bit blend of two 8-bit channels.
		HLHudMsgChar(c, x, y, hl_msg_text[i],
			(sr * (255 - blend) + dr * blend) >> 8,
			(sg * (255 - blend) + dg * blend) >> 8,
			(sb * (255 - blend) + db * blend) >> 8);

		//Effect 1 overdraws the same glyph in colour 2 on a flickering line
		//(message.cpp:199).
		if (flicker)
			HLHudMsgChar(c, x, y, hl_msg_text[i],
				hl_msg_r2, hl_msg_g2, hl_msg_b2);

		x += HLFontCharWidth(hl_msg_text[i]);
		i++;
		scanned++;

qhmd_next:
	}
}

U0 HLRenderFrame()
{//One full frame into the private canvas.
	F64		 forward[3];
	F64		 right[3];
	F64		 up[3];
	F64		 fov_y;
	F64		 fov_use;
	F64		 view_angles[3];
	F64		 saved_idle;
	F64		 chase_f[3];
	F64		 chase_r[3];
	F64		 chase_u[3];
	F64		 chase_want[3];
	F64		 chase_zero[3];
	CHLTrace	 chase_tr;
	CHLMdl	*vm_mdl;
	F64		 vm_depth;
	F64		 snd_fwd[3];
	F64		 snd_right[3];
	I64		 skip_ent;
	I64		 vm_frame;
	I64		 i;
	Bool	 vm_show;

	HLAngleVectors(hl_angles, forward, right, up);

	//A scoped weapon overrides the player fov. CBasePlayerWeapon sets
	//m_pPlayer->m_iFOV; 0 means "no override, use default_fov".
	fov_use = hl_fov;

	if (hl_wpn_zoom_fov > 0)
		fov_use = ToF64(hl_wpn_zoom_fov);

	fov_y = HLDrawFovY(fov_use, hl_canvas->width, hl_canvas->height);

	//Bob and roll are view-only: hl_angles feeds .v_angle. Updated once here,
	//read twice below, for the eye and for the weapon.
	HLViewBobUpdate;

	HLVecCopy(hl_origin, hl_view);

	//The step offset is negative while catching up, pulling the eye down. Eye
	//Eye height is never a constant: the duck spline eases hl_view_ofs_z from
	//VEC_VIEW 28 down over TIME_TO_DUCK, and it drops on death. HLPlayerMove is
	//the mover on both the VM and the native path, so HLPlayerViewHeight is the
	//answer on both.
	//
	//This used to be gated on hl_game_active, which is only ever TRUE once
	//progs.dat has loaded - and HL ships none. The native path therefore took
	//the constant and never read hl_view_ofs_z, so the whole crouch showed as an
	//18 unit snap the instant PM_Duck shifted the origin.
	//Dead: the eye height is a substitution, not an offset, and no bob or step
	//smoothing runs. PlayerDeathThink ramps it toward the corpse's own height.
	if (hl_ent_deadflag != HLDEAD_NO)
		hl_view[2] += hl_ent_death_view_ofs;
	else
		hl_view[2] += HLPlayerViewHeight + HLViewBob + HLViewStepOffset;

	//DeathCam roll: the body tips over as it falls.
	if (hl_ent_deadflag != HLDEAD_NO)
		hl_angles[2] += hl_ent_death_roll;

	//1/32 unit off any exact plane: a water surface vanishes with the eye
	//sitting precisely on its node line.
	hl_view[0] += 1.0 / 32.0;
	hl_view[1] += 1.0 / 32.0;
	hl_view[2] += 1.0 / 32.0;

	//Chase_Update: pull the eye back along the view axis and trace to it, so the
	//camera stops at the wall instead of ending up outside the level. Not at
	//intermission, where the view belongs to the info_intermission spot, and not
	//in a demo, whose camera is the recorded one.
	if (HLCvarGet("chase_active") != 0.0 && !hl_intermission && !hl_demo_playing &&
		HLMapValid(hl_map, "HLChaseUpdate"))
	{
		HLVecSet(chase_zero, 0.0, 0.0, 0.0);
		HLAngleVectors(hl_angles, chase_f, chase_r, chase_u);

		for (i = 0; i < 3; i++)
			chase_want[i] = hl_view[i]
				- chase_f[i] * HLCvarGet("chase_back")
				+ chase_r[i] * HLCvarGet("chase_right")
				+ chase_u[i] * HLCvarGet("chase_up");

		//Point trace: the camera has no size of its own.
		HLTraceEntity(hl_map, hl_view, chase_want, chase_zero, chase_zero,
			hl_player_edict, TRUE, &chase_tr);

		for (i = 0; i < 3; i++)
			hl_view[i] = chase_tr.end_pos[i];

		//Back 4 units off the surface it stopped on, or the near plane clips it.
		if (chase_tr.fraction < 1.0)
		{
			for (i = 0; i < 3; i++)
				hl_view[i] += chase_tr.plane_normal[i] * 4.0;
		}
	}

	HLVecCopy(hl_angles, view_angles);

	//V_CalcIntermissionRefdef: idle sway at scale 1, and none of the gameplay
	//view motion - no roll, no kicks, no bob.
	if (hl_intermission)
	{
		saved_idle   = hl_idle_scale;
		hl_idle_scale = 1.0;
		view_angles[2] = 0.0;
		HLViewAddIdle(view_angles);
		hl_idle_scale = saved_idle;
	}
	else
	{
		view_angles[2] = HLViewRoll(hl_angles, hl_velocity);

		//Weapon recoil and damage kicks, on the render copy only.
		HLViewApplyKick(view_angles);
	}

	//V_CalcRefdef sets roll to 80 and returns early once health hits zero.
	if (hl_game_active && HLPlayerDead)
		view_angles[2] = 80.0;

	//Listener panning runs off the view right vector.
	HLAngleVectors(view_angles, snd_fwd, snd_right, NULL);
	HLSndListener(hl_view, snd_right);

	//The listener's own body is full volume and centred, so the mixer needs to
	//know which entity that is.
	if (HLClientMode)
		hl_snd_viewent = hl_cl_viewent;
	else
		hl_snd_viewent = hl_player_edict;

	//S_Update: re-aim everything still playing.
	HLSndUpdate;

	//Light styles step at 10Hz off the game clock; ambients retrigger as their
	//previous instance runs out.
	HLLightAnimate(hl_game_time);
	HLTurbFrame(tS);

	//Before HLLightFrame, so a muzzle flash added this frame is live this frame.
	if (hl_game_active)
		HLGameEntityLights(tS);

	HLLightFrame(tS);

	//R_PushDlights: mark which faces each light reaches once, before anything is
	//drawn.
	hl_ambient_light = ToI64(HLCvarGet("r_ambient"));
	HLPushDlights(hl_map, tS);

	//One surface-cache generation per frame: entries touched this frame must not
	//be evicted out from under the drawing below.
	//
	//HLSurfCacheSetMap does NOT belong here. It flushes the cache, and calling
	//it per frame emptied all 512 slots microseconds before the traversal that
	//was supposed to hit them - a 100% miss rate and a full re-light of every
	//visible surface, every frame. HLLoadMap owns that call.
	hl_surf_frame++;

	HLSndAmbientUpdate(hl_game_time);

	//S_UpdateAmbientSounds: per-leaf wind and water. Leaf and cvars are passed in
	//because HLSound.ZC compiles before both.
	if (HLMapValid(hl_map, "HLSndLeafAmbients"))
		HLSndLeafAmbients(hl_map, HLVisLeafForPoint(hl_map, hl_view),
			HLCvarGet("ambient_level"), HLCvarGet("ambient_fade"), tS);

	HLLiquidView;

	HLDrawClear(hl_canvas, 0);
	//SCR_CalcRefdef before the projection, so the view rect it picks is what the
	//projection centres on. sb_lines, not a fixed 24: below viewsize 110 the
	//inventory row is on screen too and the view has to clear both.
	HLDrawSetViewRect(hl_canvas, HLCvarGet("viewsize"), HLSbarLines);

	//r_speeds: the per-frame cost breakdown HLDrawClear reports.
	HLRSpeeds(ToBool(HLCvarGet("r_speeds") != 0.0));

	//Draw-pass toggles. HLDraw.ZC and HLPart.ZC compile before the cvar table,
	//so the values are copied in here once a frame. Set any to 0 to take that
	//pass out of the frame and see what it was costing.
	hl_r_decals        = ToBool(HLCvarGet("r_decals") != 0.0);
	hl_r_dynamic       = ToBool(HLCvarGet("r_dynamic") != 0.0);
	hl_r_drawentities  = ToBool(HLCvarGet("r_drawentities") != 0.0);
	hl_r_drawsprites   = ToBool(HLCvarGet("r_drawsprites") != 0.0);
	hl_r_lightpoint    = ToBool(HLCvarGet("r_lightpoint") != 0.0);
	hl_r_beams         = ToBool(HLCvarGet("r_beams") != 0.0);
	HLDrawSetView(hl_canvas, hl_view, view_angles, fov_use);

	//No world, no world render. A changelevel from inside a demo stream leaves
	//the frame loop running while the map it draws is gone, mid-load or after a
	//failed load.
	if (!HLMapValid(hl_map, "HLRenderFrame") || !hl_vis)
	{
		HLHudDrawFrame(hl_canvas);
		return;
	}

	HLVisBuildList(hl_vis, hl_view, forward, right, up, fov_use, fov_y);
	HLDrawWorld(hl_canvas, hl_map, hl_vis);

	if (hl_draw_entities)
	{
		//VM live: entities come from the QuakeC world. Playback: the stream is
		//the entity list. The map's own entity lump is neither; it still holds
		//triggers, and InitTrigger clears modelindex, so a real client is never
		//told about one.
		if (hl_game_active || HLClientMode)
		{
			//Host draws from edicts, so the remote body HLSvSpawnRemote made is
			//visible. A guest has no copy of the host player in its edict table
			//and must take the wire path.
			if (HLClientMode)
			{
				//svc_setview names this client's body; 0 draws everyone.
				skip_ent = hl_cl_viewent;
				//No distance cull on the wire path for MP: DM spawns are often
				//more than HLENT_DRAW_DIST apart.
				HLNetDrawEntities(hl_canvas, hl_map, hl_view, 10000.0,
					skip_ent);
			}
			else if (HLCvarGet("cl_netdraw") != 0.0)
				HLNetDrawEntities(hl_canvas, hl_map, hl_view, HLENT_DRAW_DIST,
					hl_player_edict);
			else if (hl_udp_ready && hl_udp_server)
			{
				//Host MP: remote bodies are ordinary edicts with player.mdl, so the
				//normal path draws them. The wire path would draw a second body in
				//the same place.
				HLGameDrawEntities(hl_canvas, hl_map, hl_view, 10000.0);
			}
			else
				HLGameDrawEntities(hl_canvas, hl_map, hl_view, HLENT_DRAW_DIST);
			HLGameDrawStatics(hl_canvas, hl_map);
			//CL_UpdateTEnts re-anchors the local bolt before drawing.
			if (hl_udp_ready && !hl_udp_server || hl_demo_playing)
				HLBiBeamsFollow(hl_cl_viewent);
			else
				HLBiBeamsFollow(hl_player_edict);

			HLBiDrawBeams(hl_canvas, tS);
		}
		else
			HLRenderEntities;
	}

	//env_beam and env_laser, after the world and entity passes. Additive and
	//depth tested, writing no depth.
	HLEntDrawBeams(hl_canvas);

	//Particles are depth tested.
	HLPartDraw(hl_canvas, tS);

	//Weapon last, over everything. QuakeC owns the model and the frame.
	//
	//Hidden at intermission: execute_changelevel zeroes the player's modelindex
	//and parks the camera, so the view is a spectator shot.
	//
	//Client side, dead is cl.stats[STAT_HEALTH]; HLPlayerDead would read an
	//edict that does not exist.
	if (HLClientMode)
		vm_show = ToBool(hl_cl.health > 0 && !hl_intermission);
	else
		vm_show = ToBool(hl_player_active && !HLPlayerDead && !hl_intermission);

	if (vm_show)
	{
		vm_mdl = NULL;
		vm_frame = HLPlayerWeaponFrame;

		//Thin client: weaponmodel on the wire is a precache index, not a
		//QuakeC string. Prefer that so the viewgun tracks the host.
		if (HLClientMode && hl_cl.weaponmodel > 0 &&
			hl_cl.weaponmodel < hl_precache_model_count)
		{
			vm_mdl   = hl_precache_mdl[hl_cl.weaponmodel];
			vm_frame = hl_cl.weaponframe;
		}

		if (!vm_mdl)
			vm_mdl = HLBiFindModel(HLPlayerWeaponModel);

		if (vm_mdl)
		{
			//Screen-locked, not placed in the world: drawn in camera space, so
			//the camera and model rotations cancel by construction - no angles,
			//and no sign convention.
			//
			//Bob is forward, not vertical. V_CalcRefdef gives eye and gun the
			//same viewheight + bob, so they rise together. The only relative
			//motion is
			//
			//    view->origin[i] += forward[i] * bob * 0.4;
			//
			//depth 1.0 is the software renderer's world range, which lets the
			//gun sink into walls. 1/0.3 is GLQuake's depth compression.
			if (hl_opt_gunclip)
				vm_depth = 1.0 / 0.3;
			else
				vm_depth = 1.0;

			HLMdlDrawView(hl_canvas, vm_mdl, vm_frame,
				HLVM_FORWARD + HLViewBob * 0.4, HLVM_RIGHT, HLVM_UP,
				1.0, HLVM_LIGHT, vm_depth);
		}
	}

	//Over the world, under the overlays. Hidden when the view is not the
	//player's own.
	if (!hl_intermission)
		HLSbarCrosshair(hl_canvas);

	//SCR_UpdateScreen's split: intermission 1 is the stat sheet alone; only the
	//finale (2) pairs its plaque with the centerprint.
	if (!hl_intermission || hl_finale)
		HLSbarCenterPrint(hl_canvas);

	//Sbar_IntermissionOverlay: deathmatch shows the rankings at intermission, not
	//a stat sheet; secrets and kills are single-player accounting.
	if (hl_intermission && !hl_finale && HLCvarGet("deathmatch") != 0.0)
	{
		HLSbarDrawScoreboard(hl_canvas);
	}
	else
	{
		//The stat sheet reads cl.completed_time, frozen when the level ended.
		HLSbarIntermission(hl_canvas, hl_completed_time);
	}

	//Sbar over everything, including the weapon. At intermission the overlay
	//replaces it entirely.
	if (!hl_intermission)
	{
		HLSbarTileClear(hl_canvas);
		HLHudDrawFrame(hl_canvas);
	}

	//env_fade and the game title logo. Above the HUD and outside the
	//intermission gate, so a fade still runs while the overlay is up.
	HLHudOverlayDraw(hl_canvas);

	//game_text / env_message, over the HUD and under the console.
	HLHudMsgDraw(hl_canvas);

	//TAB deathmatch scoreboard (SCR_DrawScoreboard / Sbar_DeathmatchOverlay).
	if (hl_scoreboard_show)
		HLSbarDrawScoreboard(hl_canvas);

	//Console last, over the finished frame. Closed, the notify lines still carry
	//pickup messages and the messagemode prompt.
	if (hl_state == HLST_CONSOLE)
		HLConDraw(hl_canvas);
	else
		HLConDrawNotify(hl_canvas);
}

U0 HLCenterView(CTask *task)
{//aspect-preserving fit, centred: raising the render resolution adds detail
 //rather than shrinking the picture.
	I64 w = task->pix_width;
	I64 h = task->pix_height;
	I64 cw;
	I64 ch;

	if (!hl_canvas)
		return;

	cw = hl_canvas->width;
	ch = hl_canvas->height;

	//Widest fit that still leaves the height inside the window.
	hl_blit_w = w;
	hl_blit_h = (w * ch) / cw;

	if (hl_blit_h > h)
	{
		hl_blit_h = h;
		hl_blit_w = (h * cw) / ch;
	}

	if (hl_blit_w < 1) hl_blit_w = 1;
	if (hl_blit_h < 1) hl_blit_h = 1;

	hl_blit_x = (w - hl_blit_w) / 2;
	hl_blit_y = (h - hl_blit_h) / 2;
}

U0 HLApplyVideo()
{//rebuild the render target and resize the window. The compositor reads the
 //canvas through draw_it, so the drain-before-free that teardown needs applies
 //here too, or a resolution change frees memory mid-blit.
	CHLCanvas *old;
	I64		  w = hl_res_w[hl_opt_res];
	I64		  h = hl_res_h[hl_opt_res];

	//Breadcrumbs to the log, not the console: if the machine wedges here the
	//console is never composited again, but HL1LOG.TXT survives a reboot. The
	//last line written names the step that did not return.
	HLLog("video: drain\n");
	HLLogFlush;

	hl_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);

	HLLog("video: free canvas\n");
	HLLogFlush;

	old      = hl_canvas;
	hl_canvas = NULL;
	HLDrawFree(old);

	hl_canvas = HLDrawNew(w, h);

	//12 bytes per pixel across the colour and depth planes, so 800x600 needs
	//5.8MB against 320x240's 0.9MB, on top of the wads and the loaded map. A
	//refused allocation must not leave a NULL canvas: every draw path and the
	//compositor dereference it unguarded.
	if (!hl_canvas)
	{
		"HL1: %d x %d canvas refused, staying at %d x %d\n",
			w, h, hl_res_w[hl_res_applied], hl_res_h[hl_res_applied];

		hl_opt_res = hl_res_applied;
		w          = hl_res_w[hl_opt_res];
		h          = hl_res_h[hl_opt_res];

		hl_canvas = HLDrawNew(w, h);
	}

	//Last resort: the smallest target in the table. Nothing downstream can run
	//without a canvas.
	if (!hl_canvas)
	{
		hl_opt_res = 0;
		w          = hl_res_w[0];
		h          = hl_res_h[0];
		hl_canvas  = HLDrawNew(w, h);
	}

	if (!hl_canvas)
	{
		"HL1: no canvas could be allocated\n";
		hl_quit_request = TRUE;
		hl_res_dirty    = FALSE;

		//Every exit restores the callback. Left NULL, the window stays blank for
		//the rest of the session, including the frames the quit path still runs.
		Fs->draw_it = &HLDrawIt;
		return;
	}

	hl_res_applied = hl_opt_res;

	HLLog("video: canvas ok, resizing window\n");
	HLLogFlush;

	//Windowed sizes to the render target, landing close to 1:1.
	if (hl_opt_fullscreen)
		WinMax;
	else
	{
		WinHorz(2, 2 + (w / FONT_WIDTH));
		WinVert(2, 2 + (h / FONT_HEIGHT));
	}

	HLLog("video: window resized, restoring draw_it\n");
	HLLogFlush;

	//WinMax, WinHorz and WinVert are synchronous. Each ends in
	//TaskDerivedValsUpdate, which calls WinDerivedValsUpdate and writes
	//pix_width and pix_height before returning, so centring reads the new size
	//with no sleep in between.
	HLCenterView(Fs);

	Fs->draw_it  = &HLDrawIt;
	hl_res_dirty = FALSE;

	//Both of these only feed the next frame, so they run outside the drained
	//section. HLHudLoad reads sprite sheets off disk and blocks for an unbounded
	//time; hl_ready is still FALSE, so no blit can observe either one.
	//A resolution change picks a different row set out of hud.txt.
	HLHudLoad(hl_canvas->width);

	//The view rect is derived from the canvas and is otherwise only recomputed
	//inside the render path, which the menu does not enter.
	HLDrawSetViewRect(hl_canvas, HLCvarGet("viewsize"), HLSbarLines);
}

Bool HLLoadMap(U8 *mapname)
{
	I64 ent_count;
	I64 mdl_count;
	U8  line[256];

	if (hl_vis)
	{
		HLVisFree(hl_vis);
		hl_vis = NULL;
	}
	if (hl_map)
	{
		HLBSPFree(hl_map);
		hl_map = NULL;
	}

	hl_map = HLBSPLoad(mapname);
	if (!hl_map)
		return FALSE;

	HLStrCopy(hl_map_name, mapname, 96);

	//Trail memory is keyed by edict number, which the next map reuses for
	//entirely different entities.
	HLPartTrailReset;

	hl_vis = HLVisNew(hl_map);

	//Ordered: models resolve against the parsed list. Not folded into one print;
	//argument evaluation order would not guarantee the sequence.
	ent_count = HLEntParse(hl_map);
	mdl_count = HLEntLoadModels;

	HLHeapCheck("after HLBSPLoad");

	StrPrint(line, "map %s: %d entities, %d static models\n",
		mapname, ent_count, mdl_count);
	HLLog(line);

	//makestatic and ambientsound write into sv.signon while the map's spawn
	//functions run, so it must be empty before the world comes up.
	HLSvClearSignon;

	//The stream carries its own baselines, updates and view state. Bringing up
	//QuakeC here spawns a second live world, player and all, and the two fight
	//over every edict.
	if (hl_demo_playing)
	{
		//A leftover world holds edicts and precache slots the demo's own
		//numbering collides with.
		HLGameShutdown;

		HLNetStatesClear;
		HLNetClientClear;
	}

	//Bring up the QuakeC world. If the bytecode is unavailable the game falls
	//back to the static entity list, which still renders but never thinks.
	else if (HLGameInit(hl_map))
	{
		StrPrint(line, "QuakeC: %d spawn functions ran, %d edicts live\n",
			hl_game_spawned, hl_pr_num_edicts);
		HLLog(line);

		//Baselines are signon, not datagram: sent once after the spawn and before
		//any update, because every later delta is measured from them.
		HLNetStatesClear;
		HLNetClientClear;

		//The local player is client 0, in the same slot table as the remotes.
		HLSvClientsClear;
		HLSvAddClient(0, TRUE, hl_player_edict, hl_game_time);

		//The native world has no player edict; the slot record is the body.
		if (!hl_game_active)
			HLNetPlayerActivate(0, hl_origin, hl_angles,
				hl_setup_top, hl_setup_bottom);

		HLMsgClear(&hl_net_send);

		//Identity into the signon buffer before the send, or the name and colours
		//sit in a buffer nobody reads.
		HLNetWriteIdentity(&hl_net_send, 0, hl_setup_name,
			hl_setup_top, hl_setup_bottom);

		//SV_CreateBaseline: once into sv.signon after the spawn, so every joiner
		//replays the same bytes and deltas from the same reference.
		HLNetWriteBaselines(&hl_sv_signon);
		HLMsgAppendIfRoom(&hl_net_send, &hl_sv_signon, HLNET_MAX_MSG);

		HLNetSendToClient(&hl_net_send);
		HLNetClientFrame;

		StrPrint(line, "net: %d baselines, %d bytes signon, name '%s'\n",
			hl_net_num_ents, hl_net_send.len, hl_cl_name);
		HLLog(line);
	}
	else
	{
		//No bytecode: the normal case for Half-Life. Game logic is native, in
		//HLEntity.ZC, so run its spawn pass instead.
		StrPrint(line, "entities: %d classes spawned natively\n",
			HLEntSpawnAll(hl_map));
		HLLog(line);

		//After the spawn pass: HLEntSpawnAll resets this to -1 as part of its
		//per-map reset, and the pusher rider check needs it set.
		hl_ent_player = 0;

		HLEntReport;

		//Speech needs the sentence table, reachable only once the game directory
		//is mounted.
		if (!hl_ai_sent_count)
			HLAISentencesLoad;
	}

	//Hand the player to QuakeC. PutClientInServer chooses the spawn point, so
	//hl_origin is replaced by whatever the game logic decided.
	if (hl_game_active)
	{
		if (HLPlayerSpawn(hl_origin, hl_angles, hl_setup_name))
		{
			//Slot state first: HLSvApplyClientColors resolves .colormap through
			//the slot table, so the slot must already own the edict.
			if (hl_sv_clients[0].active && hl_sv_clients[0].local)
			{
				hl_sv_clients[0].top    = hl_setup_top & 15;
				hl_sv_clients[0].bottom = hl_setup_bottom & 15;
				HLStrCopy(hl_sv_clients[0].name, hl_setup_name, 32);
			}

			//Shirt/trousers from the setup page - remotes see these via colormap.
			HLSvApplyClientColors(hl_player_edict, hl_setup_top, hl_setup_bottom);

			StrPrint(line, "player: edict %d, health %3.0f\n",
				hl_player_edict, HLPlayerHealth);
			HLLog(line);
		}
		else
			HLLog("player: FAILED to spawn as a client\n");
	}

	//Flushed here, before the window opens, so the load report survives even
	//if the game faults later.
	HLLogFlush;
	"HL1: %d entities, %d alias models\n", ent_count, mdl_count;

	HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
	hl_on_ground = FALSE;

	if (!HLEntFindPlayerStart(hl_origin, hl_angles))
	{
		//No spawn point: centre of the world bounds, likely inside geometry, so
		//noclip rather than trapped in a wall.
		"HL1: no info_player_start, using model bounds (noclip on)\n";
		hl_noclip = TRUE;
		hl_origin[0] = (hl_map->models[0].mins[0] + hl_map->models[0].maxs[0]) * 0.5;
		hl_origin[1] = (hl_map->models[0].mins[1] + hl_map->models[0].maxs[1]) * 0.5;
		hl_origin[2] = (hl_map->models[0].mins[2] + hl_map->models[0].maxs[2]) * 0.5;
		HLVecSet(hl_angles, 0.0, 0.0, 0.0);
	}

	//Seed the unstick fallback; globals are not zeroed.
	HLVecCopy(hl_origin, hl_old_origin);

	//The surface cache is keyed by face index, so it belongs to exactly one map.
	//Set once here, after the map is built; never from the render loop.
	HLSurfCacheSetMap(hl_map);

	//The native world is up. hl_game_active cannot say this - it tracks the
	//QuakeC VM, which never loads because HL ships no progs.dat.
	hl_world_active = TRUE;

	return TRUE;
}

//CChangeLevel's transition file: the player and inventory between two maps.
#define HLTRANSITION_PATH	"HLTRANS.SAV"

//hl_menu_slot selects the file. Slot 0 keeps the name the single-slot path
//wrote, so saves made before the slot list are still slot 1 in the menu.
U0 HLSavePath(I64 slot, U8 *out)
{
	if (slot < 0)				slot = 0;
	if (slot >= HLSAVE_SLOTS)	slot = HLSAVE_SLOTS - 1;

	StrPrint(out, "HLSAVE%d.SAV", slot + 1);
}

Bool HLSaveGame()
{
	U8 path[32];

	HLSavePath(hl_menu_slot, path);

	return HLSaveWrite(path, hl_map_name, hl_game_time, hl_origin,
		hl_velocity, hl_angles, hl_on_ground, hl_water_level, hl_water_type);
}

Bool HLLoadGame()
{//load the save's map, then pour the saved world into it. Spawn functions are
 //not run: the restore overwrites their output, and their side effects would
 //linger on top of the restored state.
	U8 mapname[96];
	U8 line[160];
	U8 path[32];

	HLSavePath(hl_menu_slot, path);

	if (!HLSaveReadHeader(path, mapname))
		return FALSE;

	HLGameShutdown;
	HLEntFree;

	if (hl_vis)
	{
		HLVisFree(hl_vis);
		hl_vis = NULL;
	}
	if (hl_map)
	{
		HLBSPFree(hl_map);
		hl_map = NULL;
	}

	if (!HLLoadMap(mapname))
	{
		StrPrint(line, "load: %s failed to load\n", mapname);
		HLLog(line);
		HLSaveDiscard;
		return FALSE;
	}

	HLSvClearSignon;

	//The VM is optional and, for Half-Life, always absent: HL ships no
	//progs.dat. HLLoadMap has already spawned the native world and the restore
	//below overwrites it, so a failed HLGameInit is not an error here.
	HLGameInit(hl_map, FALSE);

	if (!HLSaveRestore(&hl_game_time, hl_origin, hl_velocity, hl_angles,
		&hl_on_ground, &hl_water_level, &hl_water_type))
	{
		HLLog("load: restore failed\n");
		return FALSE;
	}

	//A restored world is a new world to the protocol: fresh baselines, or every
	//entity deltas against a reference that no longer describes it.
	HLNetStatesClear;
	HLNetClientClear;
	HLMsgClear(&hl_net_send);
	HLNetWriteBaselines(&hl_sv_signon);
	HLMsgAppendIfRoom(&hl_net_send, &hl_sv_signon, HLNET_MAX_MSG);
	HLNetSendToClient(&hl_net_send);
	HLNetClientFrame;

	//Derived state that must agree with the restored origin.
	HLVecCopy(hl_origin, hl_old_origin);
	hl_world_warned = FALSE;
	HLBiIntermissionClear;

	//Engine diagnostics to the log: Con_Printf feeds the notify lines, and that
	//space belongs to the game's own messages.
	StrPrint(line, "load: %s at %.0f %.0f %.0f\n", mapname,
		hl_origin[0], hl_origin[1], hl_origin[2]);
	HLLog(line);
	HLLogFlush;

	return TRUE;
}

Bool HLPakMountOne(U8 *dir, I64 index)
{//mount dir/pakN, trying both cases. Valve ships PAK0.PAK; a mission pack
 //dropped in by hand is usually pak0.pak, and FileFind is case sensitive.
	U8 pakname[64];

	StrPrint(pakname, "%s/%s/PAK%d.PAK", hl_game_root, dir, index);
	if (FileFind(pakname))
		return HLPakMount(pakname);

	StrPrint(pakname, "%s/%s/pak%d.pak", hl_game_root, dir, index);
	if (FileFind(pakname))
		return HLPakMount(pakname);

	return FALSE;
}

U0 HLPakMountGame()
{//COM_AddGameDirectory: valve first, then the mod on top. HLPakFind searches
 //newest first, so a mod shadows by name, progs.dat included.
	I64	i;

	if (!HLPakMountOne("valve", 0))
		return;

	i = 1;
	while (i < HLPAK_MAX_PAKS && HLPakMountOne("valve", i))
		i++;

	if (!hl_game_dir[0])
		return;

	if (!HLPakMountOne(hl_game_dir, 0))
	{
		HLLog("gamedir: no pak0 in that directory\n");
		return;
	}

	i = 1;
	while (i < HLPAK_MAX_PAKS && HLPakMountOne(hl_game_dir, i))
		i++;
}

Bool HLGameDirSwitch(U8 *dir)
{//"game <dir>" with no restart
 //
 //Every lookup hands back a pointer into the archive: hl_pal_colormap points
 //into gfx/colormap.lmp, and the wad art likewise. Nothing may still hold one
 //when the paks go, so drop the world, every cache and the compositor, then
 //remount and reload the art that lives in them.
	U8	line[96];

	if (!dir)
		return FALSE;

	//The wm reads menu art straight out of the archives.
	hl_ready = FALSE;
	Sleep(60);

	HLDemoStop;
	hl_demo_loop = FALSE;

	//Frees the precache, the external bsp and sprite caches, and the VM.
	HLGameShutdown;
	HLEntFree;

	//HLClipInit runs at startup only, so ladder/waterjump/fall state would
	//otherwise survive a level change. HLClip.ZC cannot reach this path.
	HLMoveStateReset;

	HLSurfCacheFlush;
	HLSurfCacheSetMap(NULL);

	if (hl_vis)
	{
		HLVisFree(hl_vis);
		hl_vis = NULL;
	}
	if (hl_map)
	{
		HLBSPFree(hl_map);
		hl_map = NULL;
	}

	//The mixer borrows sample buffers on its own task, so it must be quiet before
	//the memory behind them goes.
	HLMusicFree;
	HLSndFree;

	HLMdlCacheFree;
	HLStudioCacheFree;
	HLMdlPreviewFree;

	//The surface cache above held texel pointers into these, so they go after it.
	HLWad3UnmountAll;
	HLPakUnmountAll;

	HLStrCopy(hl_game_dir, dir, 32);
	HLWad3SetGameDir(hl_game_dir);
	HLPakMountGame;

	//No shareware Half-Life, so nothing to re-test on a gamedir switch.
	HLCvarSet("registered", 1.0);

	if (!HLPalLoad)
	{
		HLLog("gamedir: palette missing, cannot continue\n");
		return FALSE;
	}

	HLWadInit;
	HLSbarInit;
	HLMenuInit;

	HLNetStatesClear;
	HLNetClientClear;
	HLBiFreePrecache;

	hl_menu_ingame = FALSE;
	hl_menu_page   = HLPAGE_MAIN;
	hl_state       = HLST_MENU;
	hl_map_name[0] = 0;

	hl_ready = TRUE;

	//No ternary in ZealC.
	if (dir[0])
		StrPrint(line, "gamedir: now %s\n", dir);
	else
		StrPrint(line, "gamedir: now valve\n");
	HLLog(line);
	HLConPrint(line);
	HLCfgSave;

	return TRUE;
}

Bool HLChangeLevel(U8 *mapname)
{//Tear the world down and bring up the next map, carrying the player's
 //inventory across. Runs between frames, never inside a think.
	U8  path[96];
	U8  line[160];
	F64 landmark_ofs[3];
	Bool landmark_ok;
	I64 li;
	I64 ci;

	//svs survives SV_SpawnServer: connected players follow the server to the next
	//map instead of being dropped.
	hl_sv_keep_clients = TRUE;

	//CChangeLevel::ChangeLevelNow. The player's position is carried across as an
	//offset from the landmark, not as a world position: the two maps overlap
	//only at that point, and info_player_start in a continuation map is where a
	//fresh game would begin, not where the corridor comes out.
	//
	//gpGlobals->vecLandmarkOffset is the OLD map's landmark origin. On the new
	//map the same targetname is found again and the offset is re-applied, so the
	//player arrives the same distance and bearing from it.
	landmark_ok = FALSE;

	if (hl_ent_changelevel_landmark[0])
	{
		li = HLEntFindByTargetname(hl_ent_changelevel_landmark, 0);

		if (li >= 0)
		{
			HLVecSub(hl_origin, hl_entities[li].origin, landmark_ofs);
			landmark_ok = TRUE;
		}
	}

	//The inventory is native now; nothing to pack out of a QuakeC world.
	HLGameShutdown;
	HLEntFree;

	if (hl_vis)
	{
		HLVisFree(hl_vis);
		hl_vis = NULL;
	}
	if (hl_map)
	{
		HLBSPFree(hl_map);
		hl_map = NULL;
	}

	//SCR_BeginLoadingPlaque: paint the plaque ONCE, before anything is freed,
	//and leave it up for the whole load.
	if (hl_canvas)
	{
		HLDrawClear(hl_canvas, 0);
		if (hl_pic_conback.pixels)
			HLPicDrawFill(hl_canvas, &hl_pic_conback);
		HLSbarLoadingPlaque(hl_canvas);
		hl_loading = TRUE;
	}

	//QuakeC passes a bare map name; the archive stores full paths.
	if (!StrNICompare(mapname, "maps/", 5))
		HLStrCopy(path, mapname, 96);
	else
		StrPrint(path, "maps/%s.bsp", mapname);

	if (!HLLoadMap(path))
	{
		hl_sv_keep_clients = FALSE;
		hl_loading = FALSE;
		StrPrint(line, "changelevel: %s failed to load\n", path);
		HLLog(line);
		return FALSE;
	}

	hl_sv_keep_clients = FALSE;
	hl_loading = FALSE;

	//Stale velocity keeps shoving the player, and a stale water level swims the
	//move code on dry land.
	HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
	hl_water_level  = 0;
	hl_water_type   = 0;
	hl_on_ground    = FALSE;
	hl_world_warned = FALSE;

	//Landmark placement, after the new world exists so its own info_landmark can
	//be found. Falls back to whatever HLLoadMap chose when either map is missing
	//the landmark - a map pair without one is a mapping error, not a crash.
	if (landmark_ok)
	{
		li = HLEntFindByTargetname(hl_ent_changelevel_landmark, 0);

		if (li >= 0)
		{
			HLVecAdd(hl_entities[li].origin, landmark_ofs, hl_origin);

			StrPrint(line, "changelevel: landmark %s, offset %.0f %.0f %.0f\n",
				hl_ent_changelevel_landmark,
				landmark_ofs[0], landmark_ofs[1], landmark_ofs[2]);
			HLLog(line);
		}
		else
		{
			StrPrint(line, "changelevel: landmark %s absent in %s\n",
				hl_ent_changelevel_landmark, path);
			HLLog(line);
		}
	}

	//No second spawn: HLLoadMap already placed the player for this level.
	//Colours still need reapplying; the slot table was rebuilt.
	if (hl_game_active)
	{
		HLSvApplyClientColors(hl_player_edict, hl_setup_top, hl_setup_bottom);
		if (hl_sv_clients[0].active && hl_sv_clients[0].local)
		{
			hl_sv_clients[0].top    = hl_setup_top & 15;
			hl_sv_clients[0].bottom = hl_setup_bottom & 15;
			HLStrCopy(hl_sv_clients[0].name, hl_setup_name, 32);
		}
	}

	//SV_SpawnServer's tail: every connected client is sent the new serverinfo
	//and put back to signon 1, so it reloads and walks prespawn/spawn/begin
	//again. Without it a changelevel moves the host alone.
	if (hl_udp_ready && hl_udp_server)
	{
		for (ci = 0; ci < HLSV_MAX_CLIENTS; ci++)
		{
			if (!hl_sv_clients[ci].active || hl_sv_clients[ci].local)
				goto qcl_next_client;

			//The edict was reserved fresh by HLLoadMap, so the slot must point
			//at the new one before setview names it.
			hl_sv_clients[ci].edict   = ci + 1;
			hl_sv_clients[ci].spawned = FALSE;
			hl_sv_clients[ci].signon  = 0;

			//Identity and colours travel again; the scoreboard was rebuilt.
			hl_sv_clients[ci].sent_ident = FALSE;

			HLNetSendServerInfo(ci);

qcl_next_client:
		}
	}

	//The previous map's origin is meaningless here, and the unstick fallback
	//drags the player back to it otherwise.
	HLVecCopy(hl_origin, hl_old_origin);

	StrPrint(line, "changelevel: spawned at %.0f %.0f %.0f\n",
		hl_origin[0], hl_origin[1], hl_origin[2]);
	HLLog(line);

	//Log only: the original prints nothing to the player on a level change.
	StrPrint(line, "changelevel -> %s\n", path);
	HLLog(line);
	HLLogFlush;

	return TRUE;
}

U0 HLClientPrecacheRebuild()
{//CL_ParseServerInfo precache resolution, deferred until after the map load it
 //depends on. Replayed in wire order, so every modelindex and sound number
 //lands on the entry it meant on the server.
	U8	*name;
	I64	 j;

	HLBiFreePrecache;

	//Slot 0 is no model; slot 1 is the map, already loaded. Resolving it through
	//the external-BSP cache would load the whole map twice.
	hl_precache_model[0]    = NULL;
	hl_precache_mdl[0]      = NULL;
	hl_precache_model_count = 1;

	for (j = 0; j < hl_cl_model_count; j++)
	{
		name = hl_cl_model_names + j * HLCL_PRECACHE_NAME;
		if (j == 0)
		{
			HLStrCopy(hl_world_model_name, name, 96);
			hl_precache_model[1] = hl_world_model_name;
			hl_precache_mdl[1]   = NULL;
			hl_precache_model_count = 2;
		}
		else
			HLBiPrecacheModel(name);
	}

	for (j = 0; j < hl_cl_sound_count; j++)
		hl_precache_sound[j] = hl_cl_sound_names + j * HLCL_PRECACHE_NAME;
	hl_precache_sound_count = hl_cl_sound_count;

	StrPrint(hl_join_line, "client: %d models, %d sounds precached\n",
		hl_precache_model_count, hl_precache_sound_count);
	HLLog(hl_join_line);
}

U0 HLInputDrain()
{//consume queued key messages.
 //
 //Input is read as raw state through kbd.down_bitmap, so MessageGet is never
 //called and a session's worth of KEY_DOWN/UP pairs piles up. On return the
 //terminal drains that backlog as typed input and the shell hands it to the
 //compiler, faulting inside ExeCmdLine.
 //
 //Bounded at 64: a frame never holds many, and a runaway queue must hang the
 //loop rather than crash later.
	I64 ch;
	I64 sc;
	I64 guard = 0;

	while (guard < 64 && KeyScan(&ch, &sc))
		guard++;
}

U0 HLInputDrainAll()
{//the same drain at exit, where it has to finish the job.
 //
 //Drain until the queue reports empty, ceiling 65536 so a broken queue cannot
 //spin forever, four passes because messages can still be posted between them.
	I64 ch;
	I64 sc;
	I64 guard;
	I64 pass;

	for (pass = 0; pass < 4; pass++)
	{
		guard = 0;
		while (guard < 65536 && KeyScan(&ch, &sc))
			guard++;

		//Nothing left on this pass means nothing is still arriving.
		if (!guard)
			break;

		//Let anything mid-post land before the next sweep.
		Sleep(10);
	}
}

//Accumulator for the UI-frozen server tick, separate from the frame loop's own,
//which does not advance while the menu is up.
F64 hl_host_ui_accum = 0.0;

U0 HLSvHostTickInit()
{//globals are not zeroed
	hl_host_ui_accum = 0.0;
}

U0 HLSvHostTick(F64 dt)
{//Host_Frame runs Host_ServerFrame whenever sv.active. key_dest decides where
 //input goes and what is drawn, never whether the world runs, so a host sitting
 //in the menu or the console keeps serving its clients.
 //
 //No local input here: CL_SendCmd builds an empty move while the menu owns the
 //keyboard.
	I64 steps = 0;
	I64 k;
	F64 nomove[3];

	//sv.active is the only condition: Host_Frame does not ask whether anyone is
	//connected, and single player does not pause either. Not gated on
	//hl_udp_server, which is only set at host time.
	if (!hl_game_active)
		return;

	//A demo is not a server: the stream owns the world and the demo pump already
	//advances it.
	if (hl_demo_playing)
		return;

	hl_host_ui_accum += dt;

	HLVecSet(nomove, 0.0, 0.0, 0.0);

	while (hl_host_ui_accum >= HLSERVER_STEP && steps < HLSERVER_MAX_CATCHUP)
	{
		//The local player is a client edict and still needs its server frame:
		//SV_Physics runs SV_Physics_Client for every client, so vanilla drops
		//you out of a jump and drowns you while the menu is up. HLGameFrame
		//covers the world only, and the local move lives in the frame loop,
		//which the menu skips.
		if (hl_game_active && hl_player_edict > 0)
		{
			HLDropPunchAngle(hl_player_edict, HLSERVER_STEP);

			//Empty move: no direction, no jump, no attack, no impulse. This is
			//the move CL_SendCmd builds when the menu owns the keyboard.
			HLPlayerPreThink(hl_origin, hl_velocity, hl_angles, hl_on_ground,
				FALSE, FALSE, 0);

			if (!hl_noclip && HLPlayerWalking)
				HLPlayerMove(hl_map, hl_origin, hl_velocity, nomove, 0.0,
					FALSE, HLSERVER_STEP, &hl_on_ground, hl_water_level,
					HLPlayerWaterJump(hl_velocity, hl_game_time), hl_angles,
					hl_player_edict);

			for (k = 0; k < 3; k++)
				HLPrSetFieldF(hl_player_edict, hl_fld_origin + k, hl_origin[k]);
		}

		HLGameFrame(HLSERVER_STEP);

		if (hl_game_active && hl_player_edict > 0)
		{
			for (k = 0; k < 3; k++)
				hl_origin[k] = HLPrFieldF(hl_player_edict, hl_fld_origin + k);

			HLPlayerTouchTriggers(hl_origin, hl_velocity);
			HLPlayerPostThink(hl_origin, hl_velocity, hl_angles,
				hl_on_ground, hl_water_level, hl_water_type);
			HLSvRunEntityThink(hl_player_edict);
		}

		//Read before running the clients. NET_Poll is unconditional in
		//Host_Frame, not part of the client's own frame, and this call is the
		//only place a remote's clc_move is parsed.
		HLNetServerReadClient(hl_player_edict, hl_game_time);

		HLSvRunClients(HLSERVER_STEP, hl_game_time);
		HLNetServerFrame(hl_player_edict, hl_game_time);

		hl_host_ui_accum -= HLSERVER_STEP;
		steps++;
	}

	//A long pause in the menu must not bank steps and then fast forward.
	if (hl_host_ui_accum > HLSERVER_STEP)
		hl_host_ui_accum = 0.0;

}

U0 HLGameLoop()
{
	F64  forward[3];
	F64  right[3];
	F64  up[3];
	F64  move[3];
	F64  speed;
	F64  net_fwd;
	F64  net_side;
	F64  now;
	F64  last;
	F64  dt;
	F64  fps_time;

	I64  dx;
	I64  dy;
	I64  fps_frames   = 0;
	I64  impulse      = 0;
	I64  i            = 0;
	I64  menu_sc      = 0;
	I64  last_menu_sc = 0;
	Bool attack       = FALSE;

	//The three mouse buttons the key table can carry, sampled before
	//MouseRawReset and handed to HLBindFrame - it has no other way to see them.
	Bool mouse1       = FALSE;
	Bool mouse2       = FALSE;
	Bool mouse3       = FALSE;
	Bool esc_held     = FALSE;
	Bool start_game   = FALSE;
	Bool tilde_held   = FALSE;
	I64  wheel_dz     = 0;
	Bool save_held    = FALSE;
	Bool load_held    = FALSE;
	Bool hl_load_request = FALSE;
	F64  srv_accum    = 0.0;
	I64  srv_steps    = 0;

	//+use is edge triggered, so the previous state must survive the tick.
	Bool use_now      = FALSE;
	Bool hl_use_held  = FALSE;

	//changelevel log line; HLGameLoop has no `line` of its own.
	U8   cl_line[96];

	//The +use probe's view basis, declared here rather than in the block that
	//uses it: this compiler only resolves types for declarations at function top.
	F64  use_fwd[3];
	F64  use_rgt[3];
	F64  use_up[3];
	F64  use_eye[3];

	//Game time comes from the kernel tick, not from frame timing.
	last     = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
	fps_time = last;

	while (TRUE)
	{
		now  = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
		dt   = now - last;
		last = now;

		//A long stall (first frame, or a map load) must not launch the camera.
		if (dt > 0.1)
			dt = 0.1;

		//First: the state branches below goto past this, and the menu path is
		//where a resolution change is requested.
		if (hl_res_dirty)
			HLApplyVideo;

		//Keep the message queue empty. Left to accumulate, the shell replays
		//the whole session's keystrokes as a command line on exit.
		HLInputDrain;

		//F2 saves, F3 loads: one slot, bound to the keys.
		if (Bt(kbd.down_bitmap, SC_F2))
		{
			if (!save_held)
			{
				save_held = TRUE;
				if (hl_game_active)
					HLSaveGame;
			}
		}
		else
			save_held = FALSE;

		if (Bt(kbd.down_bitmap, SC_F3))
		{
			if (!load_held)
			{
				load_held = TRUE;
				//Deferred: reloading tears down the world, and this runs
				//between frames rather than inside one.
				hl_load_request = TRUE;
			}
		}
		else
			load_held = FALSE;

		//The Single Player menu page cannot call these itself: HLMenu.ZC
		//compiles before both, and loading tears the world down mid-frame.
		if (hl_menu_save_req)
		{
			hl_menu_save_req = FALSE;
			if (hl_world_active)
				HLSaveGame;
		}

		if (hl_menu_load_req)
		{
			hl_menu_load_req = FALSE;
			hl_load_request  = TRUE;
		}

		if (hl_load_request)
		{
			hl_load_request = FALSE;
			HLLoadGame;
			goto ql_next_frame;
		}

		//GameMenu.res "Disconnect"/"Leave game": drop the world and go back to
		//the title screen. Same teardown order as a map change.
		if (hl_menu_leave_req)
		{
			hl_menu_leave_req = FALSE;

			HLGameShutdown;
			HLEntFree;

			if (hl_vis)
			{
				HLVisFree(hl_vis);
				hl_vis = NULL;
			}
			if (hl_map)
			{
				HLBSPFree(hl_map);
				hl_map = NULL;
			}

			hl_game_active = FALSE;
			hl_menu_ingame = FALSE;
			hl_state       = HLST_MENU;
			hl_menu_page   = HLPAGE_MAIN;
			hl_menu_row    = 0;
			hl_map_name[0] = 0;

			goto ql_next_frame;
		}

		//--- joining: the network runs outside the in-game tick ---
		//
		//An unjoined client sits in the menu, where the tick never runs. The
		//request repeats at 1Hz because a datagram can be lost.
		//
		//Keep poking the host while the map loads, or last_msg goes stale and
		//the host's timeout kills the body mid-join.
		if (hl_udp_ready && !hl_udp_server &&
			(!hl_menu_ingame || hl_change_pending || !hl_game_active))
		{
			if (tS - hl_join_last_try > 1.0)
			{
				hl_join_last_try = tS;

				if (!HLNetUdpPeerResolved)
					HLNetUdpArpProbe;

				HLNetClientSendConnect(hl_setup_name, hl_setup_top, hl_setup_bottom);
			}

			HLNetClientFrame;
		}

		//Host_Frame calls CL_ReadFromServer unconditionally: the console and
		//menu states skip the frame tail, so pump here.
		if (hl_demo_playing)
		{
			//Map first: everything after svc_serverinfo describes that world,
			//and the changelevel would clear tables filled before it.
			if (hl_change_pending)
			{
				hl_change_pending = FALSE;
				if (HLChangeLevel(hl_change_map))
					HLClientPrecacheRebuild;
				else
				{
					HLLog("demo: level failed to load, stopping\n");
					hl_demo_loop = FALSE;
					HLDemoStop;
				}
			}

			HLNetClientFrame;

			//Track the view entity here too: the tick is skipped with the menu
			//open, and the world still renders behind it.
			if (hl_demo_playing)
			{
				if (hl_cl_viewent > 0 && hl_cl_viewent < HLNET_MAX_ENTS)
					HLVecCopy(hl_net_cl[hl_cl_viewent].origin, hl_origin);
				HLVecCopy(hl_demo_angles, hl_angles);
			}

			//A finished demo leaves a map with no QuakeC and no stream behind
			//it: go back to the menu the attract loop came from.
			if (!hl_demo_playing && !hl_game_active)
			{
				//A changelevel the dead stream asked for must die with it, or
				//the frame tail loads it as a real game.
				hl_change_pending = FALSE;

				hl_menu_ingame = FALSE;
				hl_menu_page   = HLPAGE_MAIN;
				hl_state       = HLST_MENU;
			}
		}

		//The server named a level: load it, then continue stock signon
		//(prespawn -> spawn -> begin). Play does not start until signon 4.
		if (hl_net_join_pending)
		{
			hl_net_join_pending = FALSE;

			//A level named by a dead stream must not fall through to the
			//ordinary changelevel service, which spawns a live player.
			if (hl_demo_playing || (hl_udp_ready && !hl_udp_server))
			{
				//HLGameLoop has no scratch line buffer of its own, so build the
				//message in the join buffer's scratch.
				if (hl_demo_playing)
					StrPrint(hl_join_line, "demo: %s, level %s\n",
						hl_demo_name, hl_net_join_map);
				else
					StrPrint(hl_join_line, "net: joining, server level %s\n",
						hl_net_join_map);
				HLLog(hl_join_line);

				//Stream and live server both name the level in svc_serverinfo.
				//M_Draw keeps the menu over the attract loop, so only a live
				//join forces the view to the world.
				HLStrCopy(hl_change_map, hl_net_join_map, 64);
				hl_change_pending = TRUE;
				hl_menu_ingame    = TRUE;
				if (!hl_demo_playing || hl_state != HLST_MENU)
					hl_state = HLST_PLAYING;
			}
		}

		//--- mouse: read deltas and the wheel before the reset clears them ---
		//
		//Drained even while typing, or they pile up and lurch the view the
		//moment the console closes. Ahead of the key poll below, which needs
		//the wheel delta and the button latches MouseRawReset is about to
		//clear: kb_def.lst binds MOUSE1, MOUSE2 and both wheel directions.
		dx = mouse_hard.raw_data.x;
		dy = mouse_hard.raw_data.y;

		//Wheel is raw_data.z, already a per-frame delta. mouse.pos.z is not
		//usable: raw mode never updates it.
		wheel_dz = mouse_hard.raw_data.z;

		//Fire is the latch or the level, and needs both.
		//
		//raw_bttns only reads set on a frame where the mouse sent a packet, and
		//a PS/2 mouse sends nothing while a button is held still, so on its own
		//holding fire registers only while also moving.
		//
		//bttns is the level, but the kernel only maintains it in raw mode with
		//the accompanying Mouse.ZC change: FALSE forever on an older build.
		//Neither source can false-positive; the level is cleared on entry below.
		mouse1 = ToBool(mouse_hard.raw_bttns[0] || mouse_hard.bttns[0]);
		mouse2 = ToBool(mouse_hard.raw_bttns[1] || mouse_hard.bttns[1]);
		mouse3 = ToBool(mouse_hard.raw_bttns[2] || mouse_hard.bttns[2]);

		MouseRawReset;

		//--- Key_Event: every bound key, once a frame ---
		//
		//The table is gfx/shell/kb_def.lst over the console's bind command, so
		//nothing below tests a scan code. It runs only while the game owns the
		//keyboard; in any other state the held actions are released, or a key
		//down as the console opens stays walking.
		HLBindFrame(mouse1, mouse2, mouse3, wheel_dz,
			ToBool(hl_state == HLST_PLAYING && !hl_msg_mode));

		//IN_AttackDown. kb_def.lst puts +attack on MOUSE1 and ENTER, so the
		//button no longer has a private path into the move.
		attack = HLInDown(HLIN_ATTACK);

		//--- toggleconsole ---
		//
		//Con_ToggleConsole_f opens from any key_dest, so the bind is tested
		//here rather than run from the dispatcher above, which only fires while
		//playing. Same reason ESCAPE is intercepted below.
		if (HLBindActionDown("toggleconsole"))
		{
			if (!tilde_held)
			{
				tilde_held = TRUE;

				//Closing returns to the game when connected, else the menu.
				if (hl_state == HLST_CONSOLE)
				{
					if (hl_menu_ingame)
						hl_state = HLST_PLAYING;
					else
					{
						hl_state     = HLST_MENU;
						hl_menu_page = HLPAGE_MAIN;
					}
				}
				else
				{
					hl_state = HLST_CONSOLE;

					//Clear edge state, or keys held as the console opens
					//register as fresh presses.
					HLConInputReset;
				}
			}
		}
		else
			tilde_held = FALSE;

		//--- messagemode / messagemode2, and +showscores ---
		//
		//Con_MessageMode_f is a bind now, so the request arrives as a flag.
		//HLConInputReset keeps the opening press out of the chat line, the job
		//HLConKeyEdge used to do here.
		hl_scoreboard_show = FALSE;
		if (hl_state == HLST_PLAYING && !hl_msg_mode)
		{
			if (hl_in_msg_want)
			{
				HLMsgModeBegin(ToBool(hl_in_msg_want == 2));
				HLConInputReset;
			}

			hl_scoreboard_show = HLInDown(HLIN_SCORE);
		}

		hl_in_msg_want = 0;

		//--- ESC toggles the menu; quitting is a menu choice ---
		if (Bt(kbd.down_bitmap, SC_ESC))
		{
			if (!esc_held)
			{
				esc_held = TRUE;

				//Arriving at a menu page sets m_entersound, which M_Draw plays
				//as misc/menu2.wav; backing out is not silent.
				if (hl_msg_mode)
					HLMsgModeCancel;
				else if (hl_state == HLST_PLAYING)
				{
					hl_state = HLST_MENU;
					HLMenuSound(HLMSND_ENTER);
				}
				else if (hl_state == HLST_CONSOLE)
				{
					//Key_Console passes ESC straight to M_ToggleMenu_f.
					hl_state     = HLST_MENU;
					hl_menu_page = HLPAGE_MAIN;
					HLMenuSound(HLMSND_ENTER);
				}
				//The keyboard page owns ESC: it cancels an armed SetNewKey and
				//otherwise steps back to the options tabs, not to the top
				else if (hl_menu_page == HLPAGE_KEYS)
					HLKeysKey(SC_ESC);
				else if (hl_menu_page != HLPAGE_MAIN)
				{
					hl_menu_page = HLPAGE_MAIN;	//back out of a submenu first
					HLMenuSound(HLMSND_ENTER);
				}
				else if (hl_menu_ingame)
					hl_state = HLST_PLAYING;
			}
		}
		else
			esc_held = FALSE;

		//--- console: typing owns the keyboard, the world keeps running ---
		if (hl_state == HLST_CONSOLE)
		{
			HLConInput;

			if (hl_con_want_noclip)
			{
				hl_noclip = !hl_noclip;
				HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
				hl_con_want_noclip = FALSE;
			}

			//Console requests that touch app-shell state, applied here because
			//this file is compiled after the console.
			if (hl_con_fov_want != 0.0)
			{
				hl_fov          = hl_con_fov_want;
				hl_con_fov_want = 0.0;
			}

			if (hl_con_want_save)
			{
				hl_con_want_save = FALSE;
				hl_con_save_ok   = HLSaveGame;
			}

			if (hl_con_want_load)
			{
				hl_con_want_load = FALSE;
				hl_load_request  = TRUE;
			}

			if (hl_con_want_quit)
				break;

			//No early-out: jumping to the next frame skips the server tick,
			//which stops the world and every remote client with it -
			//HLSvRunClients and HLNetServerFrame both live in that tick. The
			//local player is held still by the input gate below instead.
		}

		//--- console opened from the menu: no world to render behind it ---
		//
		//HLRenderFrame draws the console at its tail and needs a map. From the
		//title screen there is none, so the menu art stands in as the backdrop.
		if (hl_state == HLST_CONSOLE && !hl_menu_ingame)
		{
			HLMenuDraw(hl_canvas);
			HLConDraw(hl_canvas);
			HLCenterView(Fs);
			hl_ready = TRUE;

			//The console owns the keyboard, not the server.
			HLSvHostTick(dt);

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//--- menu: no local simulation. The server still runs, see HLSvHostTick
		if (hl_state == HLST_MENU)
		{
			menu_sc = 0;

			//SetNewKey takes any key, so the whole bitmap is scanned while the
			//keyboard page is armed. The five navigation codes below would be
			//the only ones it could ever see otherwise.
			if (hl_menu_page == HLPAGE_KEYS && hl_keys_capture)
			{
				for (i = 1; i < 0x100; i++)
				{
					if (Bt(kbd.down_bitmap, i))
					{
						menu_sc = i;
						break;
					}
				}
			}
			else
			{
				if (Bt(kbd.down_bitmap, SC_CURSOR_UP))		menu_sc = SC_CURSOR_UP;
				if (Bt(kbd.down_bitmap, SC_CURSOR_DOWN))	menu_sc = SC_CURSOR_DOWN;
				if (Bt(kbd.down_bitmap, SC_CURSOR_LEFT))	menu_sc = SC_CURSOR_LEFT;
				if (Bt(kbd.down_bitmap, SC_CURSOR_RIGHT))	menu_sc = SC_CURSOR_RIGHT;
				if (Bt(kbd.down_bitmap, SC_ENTER))			menu_sc = SC_ENTER;

				//ClearKey and the page keys, for the keyboard page. Every other
				//page returns FALSE for them and the press is dropped.
				if (Bt(kbd.down_bitmap, SC_PAGE_UP))		menu_sc = SC_PAGE_UP;
				if (Bt(kbd.down_bitmap, SC_PAGE_DOWN))		menu_sc = SC_PAGE_DOWN;
				if (Bt(kbd.down_bitmap, SC_DELETE))			menu_sc = SC_DELETE;
				if (Bt(kbd.down_bitmap, SC_BACKSPACE))		menu_sc = SC_BACKSPACE;
			}

			//The name editor polls the keyboard itself, so it runs before the
			//scancode dispatch and swallows the frame when it is active.
			HLSetupInput;
			HLLanInput;

			//Edge trigger, or a held arrow runs the whole list.
			if (menu_sc && menu_sc != last_menu_sc && !hl_setup_editing &&
				!hl_lan_editing)
			{
				if (HLMenuKey(menu_sc, &start_game))
				{
					if (start_game)
					{
						//cls.demonum = -1: any choice cancels the attract
						//loop, and the demo stops before the world it drives
						//is replaced.
						HLDemoStop;
						hl_demo_loop = FALSE;

						hl_menu_ingame = TRUE;
						hl_state       = HLST_PLAYING;
					}
				}
			}
			last_menu_sc = menu_sc;

			//Multiplayer new game: the map must restart so items spawn with
			//deathmatch already active. Flipping it on a live level leaves the
			//existing ones wrong.
			if (hl_mp_start_dm)
			{
				//cls.demonum = -1. The attract loop owns the world until
				//something else claims it, and must be dropped before the map
				//switch or the demo pump keeps serving its own changelevels
				//over the top of the new game.
				HLDemoStop;
				hl_demo_loop = FALSE;

				//The menu already queued the map switch; leaving the menu is
				//what lets the frame loop service it.
				hl_mp_start_dm = FALSE;
				hl_menu_ingame = TRUE;
				hl_state       = HLST_PLAYING;
			}

			if (hl_quit_request)
				break;

			//Render the frozen world first, so HLMenuBackdrop has something to
			//dither over.
			if (hl_menu_ingame && hl_map && hl_vis)
				HLRenderFrame;

			HLMenuDraw(hl_canvas);
			HLCenterView(Fs);
			hl_ready = TRUE;

			//A menu on the host must not freeze the guests.
			HLSvHostTick(dt);

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//Typing owns the keyboard and mouse: the player holds still, but the
		//server keeps running for everyone else.
		if (hl_state != HLST_PLAYING || hl_msg_mode)
		{
			dx       = 0;
			dy       = 0;
			wheel_dz = 0;
			attack   = FALSE;
		}

		//V_CalcIntermissionRefdef reads the parked entity's angles every frame,
		//so the mouse has no say until play resumes.
		if (hl_intermission)
		{
			dx = 0;
			dy = 0;
		}

		//m_pitch carries invert in its sign, as the original does; magnitude
		//comes from the sensitivity slider.
		hl_angles[1] -= ToF64(dx) * hl_opt_sensitivity;
		if (HLCvarGet("m_pitch") < 0.0)
			hl_angles[0] -= ToF64(dy) * hl_opt_sensitivity;
		else
			hl_angles[0] += ToF64(dy) * hl_opt_sensitivity;

		//--- CL_AdjustAngles: the keyboard's share of the view ---
		//
		//+left and +right turn, unless +strafe is held, when they become
		//sidemove instead and the movement block below takes them. +forward
		//and +back pitch rather than move while +klook is held. +lookup and
		//+lookdown are unconditional.
		if (hl_state == HLST_PLAYING && !hl_msg_mode && !hl_intermission)
		{
			if (HLInDown(HLIN_LOOKUP))
				hl_angles[0] -= HLLOOK_PITCHSPEED * dt;
			if (HLInDown(HLIN_LOOKDOWN))
				hl_angles[0] += HLLOOK_PITCHSPEED * dt;

			if (HLInDown(HLIN_KLOOK))
			{
				if (HLInDown(HLIN_FORWARD))
					hl_angles[0] -= HLLOOK_PITCHSPEED * dt;
				if (HLInDown(HLIN_BACK))
					hl_angles[0] += HLLOOK_PITCHSPEED * dt;
			}

			if (!HLInDown(HLIN_STRAFE))
			{
				if (HLInDown(HLIN_LEFT))
					hl_angles[1] += HLLOOK_YAWSPEED * dt;
				if (HLInDown(HLIN_RIGHT))
					hl_angles[1] -= HLLOOK_YAWSPEED * dt;
			}
		}

		if (hl_angles[0] > HLPITCH_LIMIT)
			hl_angles[0] = HLPITCH_LIMIT;
		if (hl_angles[0] < -HLPITCH_LIMIT)
			hl_angles[0] = -HLPITCH_LIMIT;

		hl_angles[1] = HLAngleNorm(hl_angles[1]);

		//Weapon select, edge triggered: an impulse is a one-shot, not a state.
		//CL_SendMove zeroes in_impulse straight after transmitting it, and
		//resending makes the cycle impulses unusable.
		//
		//slot1..slot5, invnext and invprev arrive from the key table as one-shot
		//requests already on the press edge, so nothing is latched here. HL's
		//slotN is the game's impulse N, and invnext / invprev are 10 and 12.
		impulse = 0;

		if (hl_in_slot_want)
		{
			impulse         = hl_in_slot_want;
			hl_in_slot_want = 0;
		}

		if (hl_in_cycle_want > 0)
			impulse = 10;
		else if (hl_in_cycle_want < 0)
			impulse = 12;

			//The native weapon layer compiles before HLMenu.ZC and cannot name
		//hl_in_cycle_want. Hand it across here.
		hl_wpn_cycle_want = hl_in_cycle_want;

		hl_in_cycle_want = 0;

		//CBasePlayer::SelectLastItem. Native weapons only - the QuakeC path has
		//no last-item slot and HLConLastInv is where the shell keeps it
		if (hl_in_lastinv_want)
		{
			hl_in_lastinv_want = FALSE;
			HLConLastInv;
		}

		//force_centerview / centerview: V_StartPitchDrift's endpoint, which is
		//simply the level pitch here - there is no drift to start
		if (hl_in_centerview_want)
		{
			hl_in_centerview_want = FALSE;
			hl_angles[0]          = 0.0;
		}


		//--- movement wish direction ---
		HLAngleVectors(hl_angles, forward, right, up);
		HLVecSet(move, 0.0, 0.0, 0.0);
		//Stock clc_move shorts are view-relative (forwardmove/sidemove/upmove).
		net_fwd  = 0.0;
		net_side = 0.0;

		//messagemode and the console both own the keyboard: no walk while
		//typing. The world still ticks; only this player's input is dropped.
		if (hl_msg_mode || hl_state == HLST_CONSOLE)
		{
			if (hl_msg_mode)
				HLMsgModeInput;
			impulse = 0;
			attack  = FALSE;
		}
		//A dead player has no input. SV_ClientThink bails before the move:
		//    if (movetype == MOVETYPE_NONE) return;
		//    if (health <= 0) return;
		else if (hl_game_active && HLPlayerFrozen)
		{
			//Movement only: PlayerDeathThink waits on a button release then a
			//press to respawn, so attack must survive. SV_ClientThink returns
			//before the move, but after the buttons.
			impulse = 0;
		}
		else
		{
			//CL_KeyState per axis. +klook has taken +forward and +back for the
			//pitch above, so they contribute no movement while it is held.
			if (!HLInDown(HLIN_KLOOK))
			{
				if (HLInDown(HLIN_FORWARD))
				{
					HLVecAdd(move, forward, move);
					net_fwd += 1.0;
				}
				if (HLInDown(HLIN_BACK))
				{
					HLVecSub(move, forward, move);
					net_fwd -= 1.0;
				}
			}

			//+strafe turns the turn keys into strafe keys, which is the whole
			//point of the modifier
			if (HLInDown(HLIN_MOVERIGHT) ||
				(HLInDown(HLIN_STRAFE) && HLInDown(HLIN_RIGHT)))
			{
				HLVecAdd(move, right, move);
				net_side += 1.0;
			}
			if (HLInDown(HLIN_MOVELEFT) ||
				(HLInDown(HLIN_STRAFE) && HLInDown(HLIN_LEFT)))
			{
				HLVecSub(move, right, move);
				net_side -= 1.0;
			}

			//+moveup and +movedown are the swim pair. The z term is flattened
			//out of water further down, and drives noclip flight either way.
			if (HLInDown(HLIN_MOVEUP))
				move[2] += 1.0;
			if (HLInDown(HLIN_MOVEDOWN))
				move[2] -= 1.0;
		}

		//cl_forwardspeed is the always-run setting; there is no separate flag.
		//+speed is the walk key and swaps whichever way it is set.
		speed = HLCvarGet("cl_forwardspeed");
		if (speed < HLMOVE_SPEED)
			speed = HLMOVE_SPEED;

		if (HLInDown(HLIN_SPEED))
		{
			if (speed >= HLMOVE_FAST)
				speed = HLMOVE_SPEED;
			else
				speed = HLMOVE_FAST;
		}

		if (hl_noclip)
		{
			//Free flight.
			HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
			if (HLVecLength(move) > 0.0)
			{
				HLVecNormalize(move);
				HLVecMA(hl_origin, speed * dt, move, hl_origin);
			}
		}
		else
		{
			hl_water_level = HLWaterLevelGet(hl_map, hl_origin, &hl_water_type);
			HLPlayerWater(hl_water_level, hl_water_type);

			//Flatten the wish out of water, or looking up drives into the floor.
			//Swimming keeps z, which is the lift.
			if (hl_water_level < 2)
				move[2] = 0.0;

			if (HLVecLength(move) > 0.0)
				HLVecNormalize(move);
		}

		//A console impulse lands after the suppression above: Host_Impulse_f
		//queues it whatever key_dest is, and typing the command leaves the
		//console open on that frame.
		if (hl_con_impulse_want)
		{
			impulse            = hl_con_impulse_want;
			hl_con_impulse_want = 0;
		}

		//Console heapcheck 1 only: the sweep walks every live allocation.
		if (hl_heap_check_on && tS - hl_heap_check_last > 1.0)
		{
			hl_heap_check_last = tS;
			StrPrint(hl_heap_check_line, "in game f%d", hl_frame_count);
			HLHeapCheck(hl_heap_check_line);
		}

		//--- server frames at a fixed rate ---
		//
		//The server steps at HLSERVER_STEP; rendering runs free. Driving
		//PreThink, the move and PostThink at render rate over-runs everything by
		//nearly 3x. Catch-up is capped, or a stall fires a burst at once.
		//
		//The log below runs from the frame loop, not the tick, so it still
		//reports when the tick itself is being gated.
		if (hl_net_active && hl_udp_server && tS - hl_tick_log_last > 1.0)
		{
			hl_tick_log_last = tS;

			if (hl_tick_log_n < 120)
			{
				hl_tick_log_n++;

				StrPrint(hl_tick_line,
					"tick: state %d act %d self %d rem %d org(%.0f %.0f) "
					"mv(%.0f %.0f) sig %d\n",
					hl_state, HLSvFlagI(hl_game_active), hl_player_edict,
					hl_sv_clients[1].edict,
					hl_sv_clients[1].origin[0], hl_sv_clients[1].origin[1],
					hl_sv_clients[1].cmd[0], hl_sv_clients[1].cmd[1],
					hl_sv_clients[1].signon);
				HLLog(hl_tick_line);
				HLLogFlush;
			}
		}

		//Host_Pause_f stops the server clock and leaves the renderer running,
		//so the world freezes with the view still live. Time is not banked:
		//unpausing must not fire the whole paused interval as catch-up.
		if (hl_paused)
			srv_accum = 0.0;
		else
			srv_accum += dt;

		srv_steps  = 0;

		while (srv_accum >= HLSERVER_STEP && srv_steps < HLSERVER_MAX_CATCHUP)
		{
			//Unsticking belongs to HLPlayerMove, which runs PM_CheckStuck
			//against the hull actually in use. The shell's own call used
			//HLCheckStuck, which is hardcoded to the standing hull: a ducked
			//player is 18 units inside it, so every tick it declared them stuck
			//and teleported them back to the standing origin while velocity
			//kept integrating. That was the fatal crouch.
			//
			//The pass entity is still set here: HLPlayerMove reads it.
			hl_move_pass = hl_player_edict;


			//Demo playback owns the frame: no input, no move, no think. Vanilla
			//has no prediction either - V_CalcRefdef puts the view on
			//cl_entities[cl.viewentity], and the angles are the three floats
			//recorded beside every demo message.
			if (hl_demo_playing)
			{
				if (hl_cl_viewent > 0 && hl_cl_viewent < HLNET_MAX_ENTS)
					HLVecCopy(hl_net_cl[hl_cl_viewent].origin, hl_origin);

				HLVecCopy(hl_demo_angles, hl_angles);
				HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
				hl_on_ground = TRUE;
			}
			else if (hl_game_active)
			{
				//--- upstream: the client's move goes over the wire ------------
				//
				//CL_SendMove then SV_ReadClientMove: angles, buttons and impulse
				//reach the edict serialised, so the input path is a real
				//client/server boundary and a second player arrives this way.
				//
				//The move vector round-trips for symmetry, but the engine still
				//applies its own copy; the wish is not reconstructed server-side
				//the way SV_ClientThink does.
				if (hl_net_active)
				{
					//Stock: CL_SendMove only after signon 4. A listen host
					//never walks UDP signon; hl_cl_signon stays 0.
					if (!hl_udp_ready || hl_udp_server || hl_cl_signon >= 4)
					{
						HLNetClientSendMove(hl_angles,
							net_fwd * speed, net_side * speed, 0.0,
							attack, HLInDown(HLIN_JUMP),
							impulse, hl_game_time);
					}

					HLNetServerReadClient(hl_player_edict, hl_game_time);
				}

				//SV_ClientThink opens with this, so the kick from the last shot
				//has recovered before the frame is built.
				HLDropPunchAngle(hl_player_edict, HLSERVER_STEP);

				HLPlayerPreThink(hl_origin, hl_velocity, hl_angles, hl_on_ground,
					attack, HLInDown(HLIN_JUMP), impulse);

				//Consumed: catch-up runs several ticks per rendered frame, and
				//the original's impulse rides one move message only. Left set,
				//ImpulseCommands cycles past the weapon asked for.
				impulse = 0;

				//QuakeC owns jumping: PlayerJump set the vertical velocity in
				//pre-think. WALK players only - SV_Physics_Client hands a TOSS
				//corpse to the entity pass, and WALK physics on one re-fires the
				//touch of whatever it rests on every frame.
				//A dead player still falls but takes no input: PlayerDeathThink
				//runs the corpse, and CBasePlayer::PreThink returns early on
				//pev->deadflag before any command is applied.
				if (hl_ent_input_locked)
				{
					HLVecSet(move, 0.0, 0.0, 0.0);
					speed = 0.0;
				}

				if (!hl_noclip && HLPlayerWalking)
					HLPlayerMove(hl_map, hl_origin, hl_velocity, move, speed,
						FALSE, HLSERVER_STEP, &hl_on_ground, hl_water_level,
						HLPlayerWaterJump(hl_velocity, hl_game_time), hl_angles,
						hl_player_edict, HLInDown(HLIN_DUCK));

				//Publish .groundentity: a platform only carries riders it can
				//identify.
				if (hl_player_edict > 0 && hl_fld_groundentity >= 0)
					HLPrSetFieldI(hl_player_edict, hl_fld_groundentity,
						HLPrEdictValue(hl_ground_entity));

				//Thin client: a guest does not run the world think pass on top
				//of parsing the host's entity storm. Its world comes off the
				//wire via HLNetClientFrame + cl_netdraw; local motion is still
				//predicted below.
				//
				//Publish the post-move position before the pushers run. PreThink
				//wrote the pre-move origin, so a pusher would test the player a
				//tick behind, stay blocked and fire plat_crush every frame. In
				//the original sv_player->v.origin is the position.
				if (hl_game_active && hl_player_edict > 0)
				{
					for (i = 0; i < 3; i++)
					{
						HLPrSetFieldF(hl_player_edict, hl_fld_origin + i,
							hl_origin[i]);
						HLPrSetFieldF(hl_player_edict, hl_fld_velocity + i,
							hl_velocity[i]);
					}
				}

				//The local world does not run while a demo plays - the stream
				//already contains everything that happened.
				if (!HLClientMode)
					HLGameFrame(HLSERVER_STEP);

				//Adopt what the physics pass did to the body. Published just
				//above, so any difference here is what the pusher did.
				if (hl_game_active && hl_player_edict > 0)
				{
					for (i = 0; i < 3; i++)
					{
						hl_origin[i]   = HLPrFieldF(hl_player_edict,
											hl_fld_origin + i);
						hl_velocity[i] = HLPrFieldF(hl_player_edict,
											hl_fld_velocity + i);
					}
				}

				HLPlayerTouchTriggers(hl_origin, hl_velocity);
				HLPlayerPostThink(hl_origin, hl_velocity, hl_angles,
					hl_on_ground, hl_water_level, hl_water_type);
				//Local player frame chains, as remotes do in HLSvRunClients.
				if (hl_player_edict > 0)
					HLSvRunEntityThink(hl_player_edict);
				HLStuckCheck(move, speed);

				//Anything QuakeC printed this tick goes to the console, and
				//anything it stuffed at the client gets executed.
				HLConDrainProgs;
				HLConDrainStuff;

				if (hl_con_want_bf)
				{
					hl_con_want_bf = FALSE;
					HLCShiftBonus;
				}

				//The mixer has no loop flag, so music is retriggered when the
				//track runs out.
				HLMusicUpdate(tS);

				//--- the client/server boundary --------------------------------
				//
				//The world is settled for this tick, which is where
				//SV_SendClientDatagram runs: the server serialises and the local
				//client rebuilds its copy from the bytes.
				//
				//The renderer still reads the world directly. HLNetVerify can
				//only measure the reconstruction while that known-good reference
				//is still there to compare against.
				if (hl_net_active && (hl_player_edict > 0 || hl_udp_ready))
				{
					//The shell owns the local player natively; publish it
					//before the server frame reads the slot table.
					if (!hl_game_active && hl_sv_local_slot >= 0)
						HLNetPublishPlayer(hl_sv_local_slot, hl_origin,
							hl_angles, hl_velocity, hl_on_ground,
							hl_ent_player_health);

					if (hl_udp_ready && hl_udp_server)
						HLSvRunClients(HLSERVER_STEP, hl_game_time);

					//Host builds the datagram; guest only drains the wire.
					if (hl_udp_server || !hl_udp_ready)
						HLNetServerFrame(hl_player_edict, hl_game_time);

					HLNetClientFrame;

					//Guest: HUD / death / viewweapon follow host clientdata.
					HLNetSyncLocalFromClient;

					//svc_print / Host_Say may have arrived this tick.
					HLConDrainProgs;

					//HLNetVerify compares against edicts, which the native
					//world does not have.
					if (hl_game_active && (hl_udp_server || !hl_udp_ready))
					{
						hl_net_mismatch        = HLNetVerify(hl_player_edict);
						hl_net_mismatch_report = hl_net_mismatch;
					}
				}

				//After the wire: the guest hit kick reads hl_net_damage_pending
				//from svc_damage parsed above. The host reads dmg_* from the
				//edict.
				HLViewKickUpdate(HLSERVER_STEP);

				//Keep the OS responsive under catch-up bursts.
				if (hl_udp_ready && !hl_udp_server)
					Yield;
			}
			else if (!hl_noclip)
			{
				//No bytecode loaded, so the engine owns jumping.
				HLPlayerMove(hl_map, hl_origin, hl_velocity, move, speed,
					HLInDown(HLIN_JUMP), HLSERVER_STEP,
					&hl_on_ground, hl_water_level, FALSE, hl_angles,
					hl_player_edict, HLInDown(HLIN_DUCK));
			}

			//Native entities run on the same fixed step as the player, after
			//the move: a door that opened this tick is open when the touch test
			//below asks, not one tick stale.
			if (!hl_game_active)
			{
				//HLGameFrame owns this clock and returns early without a VM, so
				//nothing else advances it. The ambient mixer, the texture
				//animation and the light styles all read it.
				hl_game_time += HLSERVER_STEP;

				HLEntFrame(hl_map, HLSERVER_STEP, hl_origin);
				HLEntTouchPlayer(hl_origin);

				//After the entity pass: a script triggered this tick starts on
				//the next one, which is what HLAIFrame's scan expects.
				HLAIFrame(HLSERVER_STEP);

				//Weapons are not ticked here. HLWeapon.ZC installs itself into
				//hl_hud_weapon_hook and HLHudDraw calls it, deriving dt from
				//hl_ent_time and carrying the canvas view basis it needs for
				//hitscan. Ticking it here too would advance every refire and
				//reload timer twice per frame.

				//HLClip.ZC accumulates fall damage and exposes no damage API; it
				//cannot reach the health that lives in the entity world.
				if (hl_fall_damage_pending > 0.0)
				{
					HLEntHurtPlayer(hl_fall_damage_pending, HLDMG_FALL);
					hl_fall_damage_pending = 0.0;
				}

				//Footsteps: HLClip.ZC decides when, HLSound.ZC decides which
				//sample. materials.txt maps the texture under the player to one
				//of nine step sets; the hardcoded player/pl_step%d here ignored
				//all of it, so metal, ducts and grates sounded like concrete.
				if (hl_step_play)
				{
					HLSndFootstep(hl_map, hl_origin, HLVecLength(hl_velocity),
						hl_ducking, hl_on_ladder, hl_water_level, tS, 0);

					hl_step_play = FALSE;
				}

				//Landing cues, one shot per touchdown.
				if (hl_fall_sound_vol > 0.0)
				{
					//PM_CheckFalling plays the landing on the surface's own
					//set, after zeroing the step timer so it fires at once.
					HLSndLandStep(hl_map, hl_origin, hl_fall_sound_vol, 0);

					if (hl_fall_pain)
						HLSndPlayAt("player/pl_fallpain3.wav", hl_origin,
							1.0, 1.0, 0, 0);

					hl_fall_sound_vol = 0.0;
					hl_fall_pain      = FALSE;
				}

				//trigger_gravity is owned by HLEntity.ZC, which compiles after
				//HLClip.ZC and cannot be read from the movement code.
				hl_gravity_scale = hl_ent_gravity;

				//env_shake: jitter the view punch for the shake's duration.
				//punchangle is view-only, so this shakes the camera without
				//touching hl_angles and without moving the player's aim.
				//Amplitude is in units, scaled by 0.05 to degrees.
				if (hl_ent_shake_pending)
				{
					if (hl_ent_time < hl_ent_shake_until)
					{
						//HLPartRand is symmetric in [-r, r]; no centring term.
						hl_punch[0] += HLPartRand(hl_ent_shake_amp * 0.05);
						hl_punch[2] += HLPartRand(hl_ent_shake_amp * 0.05);
					}
					else
						hl_ent_shake_pending = FALSE;
				}

				//punchangle is normally published by the VM into hl_punch and
				//decayed on the edict. With no VM nothing owns it, so the
				//landing shake is applied and decayed here.
				if (hl_fall_punch_z != 0.0)
				{
					hl_punch[2]     += hl_fall_punch_z;
					hl_fall_punch_z  = 0.0;
				}

				hl_punch[0] -= hl_punch[0] * 10.0 * HLSERVER_STEP;
				hl_punch[1] -= hl_punch[1] * 10.0 * HLSERVER_STEP;
				hl_punch[2] -= hl_punch[2] * 10.0 * HLSERVER_STEP;

				//Triggers request these rather than doing them: they run inside
				//the entity pass and the shell owns hl_origin and hl_velocity,
				//so writing from there would fight the move in progress this
				//tick.
				if (hl_ent_teleport_pending)
				{
					HLVecCopy(hl_ent_teleport_to, hl_origin);
					HLVecSet(hl_velocity, 0.0, 0.0, 0.0);
					hl_on_ground = FALSE;
					hl_ent_teleport_pending = FALSE;
				}

				if (hl_ent_push_pending)
				{
					//Added, not assigned: a conveyor and a jump compose.
					HLVecAdd(hl_velocity, hl_ent_push_vel, hl_velocity);
					hl_ent_push_pending = FALSE;
				}

				//PlayerDeathThink's respawn gate needs both edges: every button
				//released, then one pressed. The entity layer cannot read the
				//keyboard, so the state is published here.
				hl_ent_death_button = ToBool(HLInDown(HLIN_JUMP) ||
					HLInDown(HLIN_ATTACK) || HLInDown(HLIN_ATTACK2) ||
					HLInDown(HLIN_USE) || HLInDown(HLIN_FORWARD) ||
					HLInDown(HLIN_BACK));

				//respawn(): the entity layer picks the spawn point, the shell
				//owns the origin.
				if (hl_ent_respawn_pending)
				{
					hl_ent_respawn_pending = FALSE;

					HLVecCopy(hl_ent_respawn_org, hl_origin);
					HLVecCopy(hl_ent_respawn_ang, hl_angles);
					HLVecSet(hl_velocity, 0.0, 0.0, 0.0);

					hl_on_ground   = FALSE;
					hl_water_level = 0;
					hl_water_type  = 0;

					HLVecCopy(hl_origin, hl_old_origin);
				}

				//SV_PushRotate turned the rider; pm_shared already swung the
				//origin through the tangential base velocity, so only the view
				//angle is left to carry.
				if (!HLIsZeroF(hl_platform_yaw_carry))
				{
					hl_angles[1] += hl_platform_yaw_carry;

					while (hl_angles[1] >= 360.0)
						hl_angles[1] -= 360.0;
					while (hl_angles[1] < 0.0)
						hl_angles[1] += 360.0;

					hl_platform_yaw_carry = 0.0;
				}

				//+use on the edge, not while held: a held key would re-fire a
				//toggle door every tick.
				use_now = HLInDown(HLIN_USE);

				if (use_now && !hl_use_held)
				{
					HLAngleVectors(hl_angles, use_fwd, use_rgt, use_up);

					HLVecCopy(hl_origin, use_eye);
					use_eye[2] += HLPlayerViewHeight;

					HLEntUseInFront(use_eye, use_fwd);

					//Monsters carry no use_fn, so HLEntUseInFront never
					//sees them. CTalkMonster::FollowerUse is a separate
					//pass over the same ray.
					HLAIFollowerUseInFront(use_eye, use_fwd);
				}

				hl_use_held = use_now;

				//No flashlight test here: impulse 100 is an ordinary binding
				//and HLConImpulse toggles it on the press edge the key table
				//already provides.
			}

			srv_accum -= HLSERVER_STEP;
			srv_steps++;
		}

		//A long stall must not leave a backlog that replays later.
		if (srv_accum > HLSERVER_STEP)
			srv_accum = 0.0;

		//trigger_changelevel posts the next map. Loaded here and not inside the
		//tick, because HLChangeLevel frees the entity list the trigger is
		//running inside.
		//
		//Not routed through hl_change_pending: that flag has demo-playback
		//semantics and is force-cleared when an attract stream ends.
		if (hl_ent_changelevel_pending)
		{
			hl_ent_changelevel_pending = FALSE;

			if (hl_ent_changelevel[0])
			{
				//Own buffer: `line` is a local of HL1(), not of this function.
				StrPrint(cl_line, "changelevel: %s\n", hl_ent_changelevel);
				HLLog(cl_line);

				//CChangeLevel writes a transition file before the world is torn
				//down and reads it back on the far side. That is what carries
				//the inventory and the suit charge across.
				HLSaveTransitionWrite(HLTRANSITION_PATH, hl_ent_changelevel,
					hl_ent_changelevel_landmark, hl_origin, hl_angles);

				if (HLChangeLevel(hl_ent_changelevel))
					HLSaveTransitionRestore(HLTRANSITION_PATH, hl_origin,
						hl_angles);
				else
				{
					//A failed load leaves hl_map NULL, and the frame loop then
					//calls the renderer, the entity tick and the ambient pass
					//with it - each of which reports a bad map pointer and
					//keeps going. Drop to the menu instead.
					HLLog("changelevel: failed to load\n");

					hl_world_active = FALSE;
					hl_game_active  = FALSE;
					hl_menu_ingame  = FALSE;
					hl_state        = HLST_MENU;
					hl_menu_page    = HLPAGE_MAIN;
					hl_menu_row     = 0;

					goto ql_next_frame;
				}
			}
		}

		//Particles age on the render clock, not the game clock.
		HLPartUpdate(dt, tS);

		HLCenterView(Fs);
		HLRenderFrame;
		hl_ready = TRUE;

		hl_frame_count++;
		fps_frames++;
		if (now - fps_time >= 0.5)
		{
			hl_fps      = ToF64(fps_frames) / (now - fps_time);
			fps_frames = 0;
			fps_time   = now;
		}

		//A level change is requested from inside a think, so it is serviced
		//here, between frames. A death restart reloads the same map with no
		//carried inventory, and goes first so the two cannot both fire.
		if (hl_restart_pending)
		{
			hl_restart_pending = FALSE;
			HLGameClearParms;
			HLChangeLevel(hl_map_name);
			goto ql_next_frame;
		}

		//"game <dir>" arrives from the console, which compiles before this file
		//and cannot call in directly. Serviced between frames like a changelevel,
		//and before it, because it invalidates every archive the map would load
		//from.
		if (hl_gamedir_pending)
		{
			hl_gamedir_pending = FALSE;
			hl_change_pending  = FALSE;
			HLGameDirSwitch(hl_gamedir_next);
			goto ql_next_frame;
		}

		//Not during playback: the demo pump owns its own changelevels, and this
		//copy would service one without the client precache rebuild.
		if (hl_change_pending && !hl_demo_playing)
		{
			hl_change_pending = FALSE;
			HLChangeLevel(hl_change_map);

			//Guest: after map load, reply to signonnum 1 with "prespawn".
			if (hl_udp_ready && !hl_udp_server && hl_net_need_prespawn)
			{
				hl_net_need_prespawn = FALSE;
				HLLog("net: cl -> prespawn (map loaded)\n");
				HLLogFlush;
				HLNetClientSendStringCmd("prespawn");
			}
		}

		LBts(&Fs->task_flags, TASKf_IDLE);
		Yield;
		LBtr(&Fs->task_flags, TASKf_IDLE);

ql_next_frame:
	}
}

U0 HLDocCursorPark()
{//park the terminal's document cursor at the end.
 //
 //The cursor is left wherever the last write or click put it, which in DolDoc
 //is an editing position, not a prompt. Anything typed after is inserted into
 //existing text and the shell hands the merged line to the compiler, faulting
 //inside ExeCmdLine after HL1 has exited.
	CDoc *doc;
	Bool  unlock;

	doc = Fs->put_doc;
	if (!doc)
		return;

	unlock = DocLock(doc);

	doc->cur_entry = &doc->head;
	doc->cur_col   = 0;

	if (unlock)
		DocUnlock(doc);
}

U0 HL1(U8 *mapname = HLDEFAULT_MAP)
{
	CHLCanvas	*canvas			= NULL;
	CHLVisState	*vis			= NULL;
	CHLMap		*map			= NULL;
	Bool		 raw_was_on		= FALSE;
	Bool		 demo_boot		= FALSE;
	Bool		 final_active	= FALSE;
	I64			 final_edicts	= 0;
	I64			 final_thinks	= 0;
	I64			 final_models	= 0;
	I64			 final_snd		= 0;
	I64			 final_drop		= 0;
	I64			 final_move_ok	= 0;
	I64			 final_move_fail = 0;
	I64			 final_errors	= 0;
	F64			 final_time		= 0.0;
	U8			 line[256];
	U8			 pakname[64];
	I64			 i;

	"  init HLLogReset\n";
	HLLogReset;

	//Before any allocation of ours: corruption reported here came from
	//elsewhere.
	HLHeapCheck("entry");

	"  init HLPakInit\n";
	HLPakInit;
	"  init HLWad3Init\n";
	HLWad3Init;
	"  init HLAIInit\n";
	HLAIInit;
	"  init HLSndInit\n";
	HLSndInit;
	"  init HLPartInit\n";
	HLPartInit;
	"  init HLClipInit\n";
	HLClipInit;
	//ZealC does not honour a declaration initialiser on a global, and every
	//pointer below is handed to Free() at teardown: one never assigned is freed
	//as garbage, faulting inside the allocator.
	hl_music_frames     = NULL;
	hl_music_count      = 0;
	hl_music_rate       = HLSND_RATE;
	hl_music_track      = 0;
	hl_save_buf         = NULL;
	hl_mdl_preview      = NULL;
	hl_mdl_preview_skin = NULL;
	hl_vis              = NULL;
	hl_map              = NULL;
	hl_entities         = NULL;
	hl_num_entities     = 0;

	"  init HLMdlCacheInit\n";
	HLMdlCacheInit;
	"  init HLStudioCacheInit\n";
	HLStudioCacheInit;
	"  init HLBiBspCacheInit\n";
	HLBiBspCacheInit;
	"  init HLSurfCacheInit\n";
	HLSurfCacheInit;
	"  init HLMusicReset\n";
	HLMusicReset;
	"  init HLPlayerStateInit\n";
	HLPlayerStateInit;
	"  init HLSvHostTickInit\n";
	HLSvHostTickInit;
	"  init HLClientParmsInit\n";
	HLClientParmsInit;
	"  init HLDemoInit\n";
	HLDemoInit;
	"  init HLConHistoryInit\n";
	HLConHistoryInit;
	"  init HLLightInit\n";
	HLLightInit;
	"  init HLTurbInit\n";
	HLTurbInit;
	"  init HLNetInit\n";
	HLNetInit;
	"  init HLNetUdpInit\n";
	HLNetUdpInit;
	"  init HLNetStatesClear\n";
	HLNetStatesClear;

	"  init HLNetPlayersInit\n";
	HLNetPlayersInit;
	"  init HLNetClockInit\n";
	HLNetClockInit;
	"  init HLSetupDefaults\n";
	HLSetupDefaults;
	"  init HLCfgLoad\n";
	HLCfgLoad;
	"  init HLViewKickInit\n";
	HLViewKickInit;
	"  init HLCShiftInit\n";
	HLCShiftInit;
	"  init HLStuckInit\n";
	HLStuckInit;

	//Cvars once, before anything can read them. Not in HLBiInit, which runs
	//again on every map load and would throw away "registered" and "skill".
	"  init HLCvarInit\n";
	HLCvarInit;

	//Applied after the cvars exist: HLCfgLoad ran earlier and only parked the
	//value, which defining it there would have shadowed.
	HLCvarSet("crosshair", ToF64(hl_opt_crosshair));

	//Search root first: HLFileResolve needs it before anything is looked up.
	HLPakSetGameDir(hl_game_dir);

	//COM_AddGameDirectory walks pak%i until one is missing. Unlike Quake a pak is
	//not required: a retail HL install keeps maps, wads and much of models/
	//loose, and the renderer needs none of pak0's contents.
	"  init HLPakMountGame\n";
	HLPakMountGame;

	if (!hl_pak_count && !HLFileExists(HLDEFAULT_MAP))
	{
		"HL1: no pak and no %s under ::/Apps/HL1/valve/.\n", HLDEFAULT_MAP;
		"HL1: See ::/Apps/HL1/README.md for what to copy in.\n";
		return;
	}

	if (hl_game_dir[0])
	{
		StrPrint(pakname, "HL1: gamedir %s\n", hl_game_dir);
		"%s", pakname;
	}

	//Key bindings need the search path: gfx/shell/kb_act.lst, kb_def.lst and
	//resource/valve_english.txt all live under it. HLCfgLoad ran before the
	//mount and left its bind lines for the tail of this, which is HL's order -
	//defaults, then config.cfg, then the player's own file.
	"  init HLBindStartup\n";
	HLBindStartup;

	//No shareware Half-Life, so no gfx/pop.lmp test and nothing to gate. The cvar
	//stays because trigger_onlyregistered_touch and the menus read it.
	HLCvarSet("registered", 1.0);

	if (!HLPalLoad)
	{
		"HL1: palette load failed\n";
		return;
	}

	//Interface art: gfx.wad plus the standalone gfx/*.lmp menu pictures.
	"  init HLWadInit\n";
	HLWadInit;
	"  init HLSbarInit\n";
	HLSbarInit;
	"  init HLMenuInit\n";
	HLMenuInit;

	//A stock boot loads no playable map: quake.rc's startdemos supplies the
	//world, each demo naming its own level in svc_serverinfo. The direct load is
	//the fallback for a boot with no attract loop.
	demo_boot = FALSE;
	if (HLCvarGet("demoloop") != 0.0)
		demo_boot = HLDemoNextInLoop;

	if (demo_boot)
		HLLog("demo: attract loop started\n");
	else if (!HLLoadMap(mapname))
	{
		"HL1: could not load %s\n", mapname;
		return;
	}

	//Explicit, not initialisers: a global's declaration initialiser is not
	//honoured.
	hl_state       = HLST_MENU;
	hl_menu_ingame = FALSE;

	hl_canvas = HLDrawNew(hl_res_w[hl_opt_res], hl_res_h[hl_opt_res]);

	//The configured resolution may not fit; drop to the smallest rather than
	//dereference NULL on the first frame.
	if (!hl_canvas)
	{
		"HL1: %d x %d canvas refused at startup, using %d x %d\n",
			hl_res_w[hl_opt_res], hl_res_h[hl_opt_res],
			hl_res_w[0], hl_res_h[0];

		hl_opt_res = 0;
		hl_canvas  = HLDrawNew(hl_res_w[0], hl_res_h[0]);
	}

	if (!hl_canvas)
	{
		"HL1: no canvas could be allocated\n";
		return;
	}

	hl_res_applied = hl_opt_res;

	//hud.txt carries one row per element per resolution, so the table can only be
	//picked once the canvas size is known.
	HLHudLoad(hl_canvas->width);
	hl_ready  = FALSE;

	//Checkpoints: the first of these that reports corruption brackets it.
	HLHeapCheck("startup");

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		AutoComplete;
		WinBorder;
		WinMax;
		DocCursor;
		DocClear;

		HLCenterView(Fs);

		//Raw mode gives relative deltas and keeps clicks off the window manager.
		//Must be turned back off on every exit path.
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;

		Fs->draw_it = &HLDrawIt;

		//raw_data.z is a delta the frame loop's MouseRawReset clears, not a
		//position: discard what accumulated before the loop, or entering the game
		//arrives as one large scroll.
		MouseRawReset;

		//MouseRawReset does not touch the button levels, and a click landing just
		//before raw mode reads as fire held on the first frame.
		mouse_hard.bttns[0] = FALSE;
		mouse_hard.bttns[1] = FALSE;
		mouse_hard.bttns[2] = FALSE;

		HLGameLoop;
	}
	catch
		PutExcept;

	//--- teardown ---
	//Detaching draw_it is not enough: an already-entered HLDrawIt keeps running.
	//Stop it drawing, detach, let the in-flight call drain, then free.
	hl_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(100);

	//Clear each global before releasing it, so a late HLDrawIt sees NULL.
	canvas   = hl_canvas;
	hl_canvas = NULL;
	vis      = hl_vis;
	hl_vis    = NULL;
	map      = hl_map;
	hl_map    = NULL;

	if (!raw_was_on)
		MouseRaw(FALSE);

	SettingsPop;
	MenuPop;

	//Capture the VM stats before shutdown clears them. DocClear wiped the startup
	//messages, so this summary is the only readable one.
	final_active  = hl_game_active;
	final_edicts  = hl_pr_num_edicts;
	final_thinks  = hl_game_thinks;
	final_time    = hl_game_time;
	final_models  = hl_precache_model_count;

	final_snd      = hl_snd_played;
	final_drop     = hl_snd_dropped;
	final_move_ok  = hl_move_ok;
	final_move_fail = hl_move_fail;
	final_errors    = hl_pr_errors;

	//Breadcrumbed and flushed after every step, so the last line in HL1LOG.TXT
	//names the step that was running if it faults.
	HLHeapCheck("teardown");

	HLLog("teardown: begin\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	//The QuakeC world points at the map, so it goes first.
	"  init HLGameShutdown\n";
	HLGameShutdown;
	HLLog("teardown: HLGameShutdown ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	"  init HLMusicFree\n";
	HLMusicFree;
	"  init HLSndFree\n";
	HLSndFree;
	HLLog("teardown: HLSndFree ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	//The socket is registered with the net stack, not this task: it outlives the
	//app if it is not closed.
	"  init HLNetUdpClose\n";
	HLNetUdpClose;
	"  init HLMdlPreviewFree\n";
	HLMdlPreviewFree;
	HLLog("teardown: net/preview ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	//Released before the map, so nothing outlives what it was spawned from.
	"  init HLEntFree\n";
	HLEntFree;
	HLLog("teardown: HLEntFree ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	//Up to 512 lit-surface blocks plus a slot table sized to the map's face count,
	//both allocated during rendering; a menu-only session has neither.
	"  init HLSurfCacheFlush\n";
	HLSurfCacheFlush;
	HLSurfCacheSetMap(NULL);
	HLLog("teardown: HLSurfCacheFlush ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	HLDrawFree(canvas);
	HLLog("teardown: HLDrawFree ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	HLVisFree(vis);
	HLLog("teardown: HLVisFree ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	HLBSPFree(map);
	HLLog("teardown: HLBSPFree ok\n");

	//Last: the precache and the static entity list both point into it.
	"  init HLMdlCacheFree\n";
	HLMdlCacheFree;
	"  init HLStudioCacheFree\n";
	HLStudioCacheFree;
	HLLog("teardown: model caches freed ok\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	StrPrint(line, "exit: %d frames rendered\n", hl_frame_count);
	HLLog(line);

	if (final_active)
	{
		StrPrint(line, "QuakeC: %d edicts, %d models precached\n",
			final_edicts, final_models);
		HLLog(line);
		StrPrint(line, "QuakeC: %d thinks over %4.1f s of game time\n",
			final_thinks, final_time);
		HLLog(line);

		//Only four mixer streams, so drops are expected in a firefight. A zero
		//played count means the audio path never worked.
		StrPrint(line, "sound: %d played, %d dropped (4 streams)\n",
			final_snd, final_drop);
		HLLog(line);




		//Includes the ones the console suppressed: large with a healthy think
		//count means they are being survived.
		StrPrint(line, "QuakeC errors: %d\n", final_errors);
		HLLog(line);

		//Spawning but never thinking is a different fault from not spawning.
		if (final_thinks == 0)
			HLLog("QuakeC: WARNING - nothing ever thought. Check nextthink.\n");
	}
	else
		HLLog("QuakeC: did not load - entities were static\n");

	//Written last: this line missing with everything above it present means the
	//fault is after all local cleanup.
	HLHeapCheck("returning");

	HLLog("teardown: returning\n");
	"  init HLLogFlush\n";
	HLLogFlush;

	"\nLog written to ::/Apps/HL1/HL1LOG.TXT\n";

	//Anything queued during teardown must not reach the shell either, and the
	//cursor is parked only once nothing further writes to the document.
	"  init HLInputDrainAll\n";
	HLInputDrainAll;
	"  init HLDocCursorPark\n";
	HLDocCursorPark;

	//The shell's lexer holds cur_entry into the terminal document and rebuilds
	//the task title from it every iteration:
	//
	//    doc_e = cc->lex_include_stack->cur_entry;
	//    while (doc_e != doc && ptr2 < ptr3)
	//        switch (doc_e->type_u8) ...
	//
	//DocClear in the setup above freed every entry, so that walk reads freed
	//memory and faults inside ExeCmdLine. It only runs while title_src is
	//TTS_CUR_LEX; ExeCmdLine restores the previous value when its loop finishes.
	Fs->title_src = TTS_LOCKED_CONST;

	//Settle before handing the task back: the wm, the mixer and the block cache
	//run on their own tasks and may still hold work referring to this one.
	Sleep(200);

}
