// little-endian readers for on-disk quake structures
// ZealC casts are no-ops; no class is overlaid on raw file bytes.

U16 HLRdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

I64 HLRdI16(U8 *p)
{
	I64 v = p[0] | (p[1] << 8);

	if (v & 0x8000)
		v -= 0x10000;

	return v;
}

U32 HLRdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 HLRdI32(U8 *p)
{
	I64 v = HLRdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;

	return v;
}

F64 HLRdF32(U8 *p)
{
	U32 b   = HLRdU32(p);
	I64 sgn = b >> 31;
	I64 exp = (b >> 23) & 0xFF;
	I64 man = b & 0x7FFFFF;
	I64 d;
	F64 r;

	if (!exp)
		d = sgn << 63;			//zero or denormal, flush to zero
	else if (exp == 255)
		d = sgn << 63;			//no inf/nan in valid map data
	else
		d = (sgn << 63) | ((exp + 896) << 52) | (man << 29);	//896 = 1023-127

	MemCopy(&r, &d, 8);

	return r;
}

U32 HLWrF32(F64 v)
{//inverse of HLRdF32; round to nearest, underflow to zero, overflow to inf
	I64 bits;
	I64 sgn;
	I64 exp;
	I64 man;

	MemCopy(&bits, &v, 8);

	sgn = (bits >> 63) & 1;
	exp = (bits >> 52) & 0x7FF;
	man = bits & 0xFFFFFFFFFFFFF;

	if (!exp)
		return sgn << 31;			//zero or denormal, flush to zero

	if (exp == 0x7FF)
		return (sgn << 31) | 0x7F800000;	//inf/nan -> inf

	exp -= 896;						//rebias 1023 to 127

	if (exp <= 0)
		return sgn << 31;			//underflows binary32

	if (exp >= 255)
		return (sgn << 31) | 0x7F800000;

	//round to nearest on the bit below the 23 bit mantissa
	man += 0x10000000;
	if (man > 0xFFFFFFFFFFFFF)
	{
		man = 0;
		exp++;
		if (exp >= 255)
			return (sgn << 31) | 0x7F800000;
	}

	return (sgn << 31) | (exp << 23) | (man >> 29);
}

U0 HLRdVec(U8 *p, F64 *out)
{
	out[0] = HLRdF32(p);
	out[1] = HLRdF32(p + 4);
	out[2] = HLRdF32(p + 8);
}

U0 HLStrCopy(U8 *dst, U8 *src, I64 max)
{
	I64 i = 0;

	if (max <= 0)
		return;

	while (i < max - 1 && src[i])
	{
		dst[i] = src[i];
		i++;
	}

	dst[i] = 0;
}

#define HLLOG_MAX	(512 * 1024)

Bool hl_log_echo = FALSE;

//console: heapcheck 1
Bool hl_heap_check_on = FALSE;

U8	 hl_log_buf[HLLOG_MAX];
I64	 hl_log_len = 0;

U0 HLLogReset()
{
	hl_log_len     = 0;
	hl_log_buf[0]  = 0;
}

U0 HLLog(U8 *s)
{
	I64 n = StrLen(s);

	if (hl_log_len + n + 1 >= HLLOG_MAX)
		return;

	MemCopy(hl_log_buf + hl_log_len, s, n);
	hl_log_len += n;
	hl_log_buf[hl_log_len] = 0;

	//a raw dollar sign (0x24) in a runtime string is a DolDoc command. It must not
	//appear literally in this source either: the lexer pairs them before tokenising,
	//across file boundaries
	if (hl_log_echo)
		"%s", s;
}

//diskwrite 0 from the console suppresses all log writes
Bool hl_disk_writes = TRUE;

U0 HLLogFlush()
{
	if (!hl_disk_writes)
		return;

	if (hl_log_len > 0)
		FileWrite("::/Apps/HL1/HL1LOG.TXT", hl_log_buf, hl_log_len);
}

I64 HLHeapCheck(U8 *where)
{//_CONFIG_HEAP_DEBUG carries caller1, the return address that allocated the block
	CMemUsed	*m;
	CMemUsed	*head;
	CMemUsed	*prev = NULL;
	CHeapCtrl	*hc;
	U8			 line[200];
	I64			 n = 0;

	hc = Fs->data_heap;
	if (!hc || !hl_heap_check_on)
		return 0;

#if _CONFIG_HEAP_DEBUG
	head = (&hc->next_um)(U8 *) - offset(CMemUsed.next);
	m    = hc->next_um;

	while (m != head)
	{
		//IsInHeapCtrl walks the block list with the heap locked, O(blocks x mem_blks)
		if (m->hc != hc || m->size < sizeof(CMemUsed) ||
			m->size > 0x40000000 || !IsInHeapCtrl(m, hc))
		{
			StrPrint(line,
				"HEAP CORRUPT at %s: block %d @%08X size %d\n",
				where, n, m, m->size);
			HLLog(line);

			if (prev)
			{
				StrPrint(line,
					"  previous block @%08X size %d alloced by %08X / %08X\n",
					prev, prev->size, prev->caller1, prev->caller2);
				HLLog(line);
			}

			HLLogFlush;
			return -1;
		}

		prev = m;
		n++;

		if (n > 2000000)
		{
			StrPrint(line, "HEAP CORRUPT at %s: used list cycles\n", where);
			HLLog(line);
			HLLogFlush;
			return -1;
		}

		m = m->next;
	}

	StrPrint(line, "heap ok at %s: %d blocks\n", where, n);
	HLLog(line);
	HLLogFlush;
	return n;
#else
	if (HeapCtrlWalk(hc))
		StrPrint(line, "heap ok at %s - FREE LISTS ONLY, "
			"set _CONFIG_HEAP_DEBUG in KernelA.HH\n", where);
	else
		StrPrint(line, "HEAP CORRUPT at %s (free lists)\n", where);

	HLLog(line);
	HLLogFlush;
	return 0;
#endif
}


F64 HLAtoF(U8 *s)
{
	F64  sign  = 1.0;
	F64  value = 0.0;
	F64  scale = 0.1;
	I64  i     = 0;

	while (s[i] == ' ' || s[i] == '\t')
		i++;

	if (s[i] == '-')
	{
		sign = -1.0;
		i++;
	}
	else if (s[i] == '+')
		i++;

	while ('0' <= s[i] <= '9')
	{
		value = value * 10.0 + ToF64(s[i] - '0');
		i++;
	}

	if (s[i] == '.')
	{
		i++;
		while ('0' <= s[i] <= '9')
		{
			value += ToF64(s[i] - '0') * scale;
			scale *= 0.1;
			i++;
		}
	}

	return sign * value;
}

U0 HLParseVec(U8 *s, F64 *out)
{
	U8  tok[64];
	I64 i = 0;
	I64 n = 0;
	I64 k;

	out[0] = 0.0;
	out[1] = 0.0;
	out[2] = 0.0;

	while (s[i] && n < 3)
	{
		while (s[i] == ' ' || s[i] == '\t')
			i++;

		k = 0;
		while (s[i] && s[i] != ' ' && s[i] != '\t' && k < 63)
		{
			tok[k] = s[i];
			k++;
			i++;
		}
		tok[k] = 0;

		if (k > 0)
		{
			out[n] = HLAtoF(tok);
			n++;
		}
	}
}

U0 HLRdName(U8 *p, U8 *out, I64 max)
{//fixed width nul padded on-disk name -> nul terminated
	I64 i = 0;

	while (i < max - 1 && p[i])
	{
		out[i] = p[i];
		i++;
	}

	out[i] = 0;
}
