// HLSave.ZC - Host_Savegame_f / Host_Loadgame_f
//
// A binary container, not id's text .sav: no ftos, no tokenizer, and
// round-tripping physics state through decimal loses precision. Not
// interchangeable with id's files.
//
// Holds everything the VM cannot rebuild:
//   - the global pool
//   - the entity field block and the free list
//   - the string heap; map keys are appended to it at load and entity fields
//     hold offsets into it
//   - the precache lists, since .modelindex is an index into them
//   - light styles, carried parms, engine-side player state
//
// Load brings the map and bytecode up but does not run the spawn functions, then
// overwrites the world.

// Version 2 appends a spawn parm block for every client slot as a trailer, past
// everything version 1 wrote: CHLSaveHeader's size is baked into every v1 file on
// disk, so growing the class would shift the body and misread them. A v1 file has
// no trailer and loads as one client.
#define HLSAVE_MAGIC			0x56535A51	//"QZSV" little-endian
#define HLSAVE_VERSION		2
#define HLSAVE_VERSION_MIN	1

//I64 slot count, I64 parms per slot, then per slot an I64 set flag and its parms.
//The counts live in the trailer, not the frozen header
#define HLSAVE_PARM_BYTES	(16 + HLSV_MAX_CLIENTS * (8 + HLPR_MAX_PARM_GLOBALS * 8))

class CHLSaveHeader
{
	U32	magic;
	U32	version;
	U8	mapname[96];
	F64	game_time;
	F64	origin[3];
	F64	velocity[3];
	F64	angles[3];
	I64	on_ground;
	I64	water_level;
	I64	water_type;
	I64	num_edicts;
	I64	edict_stride;
	I64	num_globals;
	I64	strings_size;
	I64	string_alloc;
	I64	num_models;
	I64	num_sounds;
	F64	saved_parms[HLGAME_MAX_PARMS];
	F64	saved_serverflags;
};

U8 *HLSaveAppend(U8 *dst, U8 *src, I64 bytes)
{//append and return the new write point
	MemCopy(dst, src, bytes);
	return dst + bytes;
}

U0 HLSaveSpawnParms()
{//SV_SaveSpawnparms: run SetChangeParms once per active client with self set to
 //that client's body, keeping what it leaves in parm1..parm16
 //
 //the same call the changelevel path makes, over every slot instead of the local
 //player alone. Without it a coop save carries one inventory and the other
 //players respawn empty
	I64	fn;
	I64	ofs;
	I64	ent;
	I64	i;
	I64	j;
	F64	value;

	fn = HLPrFindFunction("SetChangeParms");
	if (fn <= 0)
		return;

	for (i = 0; i < HLSV_MAX_CLIENTS; i++)
	{
		if (!hl_sv_clients[i].active)
			goto qsp_next;

		ent = hl_sv_clients[i].edict;
		if (ent < 1 || ent >= hl_pr_num_edicts || hl_pr_edict_free[ent])
			goto qsp_next;

		HLPrSetI(hl_ofs_self, HLPrEdictValue(ent));
		HLPrExecute(fn);
		hl_pr_error = FALSE;

		for (j = 0; j < HLPR_MAX_PARM_GLOBALS; j++)
		{
			ofs = hl_ofs_parms[j];
			if (ofs < 0)
				goto qsp_next_parm;

			//via a temp: this compiler computes the slot address before
			//evaluating the call and can lose the store
			value = HLPrGetF(ofs);
			hl_client_parms[i * HLPR_MAX_PARM_GLOBALS + j] = value;

qsp_next_parm:
		}

		hl_client_parms_set[i] = TRUE;

qsp_next:
	}
}

Bool HLSaveWrite(U8 *path, U8 *mapname, F64 game_time, F64 *origin,
	F64 *velocity, F64 *angles, Bool on_ground, I64 water_level,
	I64 water_type)
{//Host_Savegame_f
	CHLSaveHeader	 hdr;
	U8				*buf;
	U8				*p;
	I64				 total;
	I64				 edict_bytes;
	I64				 ofs;
	I64				 i;
	I64				 j;

	//guards the counts the buffer size is computed from. A save against a torn
	//down world sizes the buffer from stale counts and faults later, in Free
	if (!hl_game_active || !hl_pr_edicts || !hl_pr_globals || !hl_pr_strings)
	{
		"HLSave: no game in progress\n";
		return FALSE;
	}

	if (hl_pr_num_edicts < 1 || hl_pr_edict_stride < 1 ||
		hl_pr_num_globals < 1 || hl_pr_strings_size < 1)
	{
		"HLSave: world is not loaded\n";
		return FALSE;
	}

	if (hl_intermission)
	{
		"HLSave: can't save in intermission\n";
		return FALSE;
	}

	//Host_Savegame_f refuses deathmatch: there is nothing coherent to restore
	//when the level is a scoreboard. Coop saves, and keeps every inventory
	if (HLCvarGet("deathmatch") != 0.0)
	{
		"HLSave: can't save a deathmatch game\n";
		return FALSE;
	}

	//every active client's parms are refreshed first; they are written below
	HLSaveSpawnParms;

	MemSet(&hdr, 0, sizeof(CHLSaveHeader));

	hdr.magic        = HLSAVE_MAGIC;
	hdr.version      = HLSAVE_VERSION;
	HLStrCopy(hdr.mapname, mapname, 96);
	hdr.game_time    = game_time;
	//no ToI64() here: it is the F64->I64 intrinsic and would reinterpret the
	//Bool's bits as a double
	hdr.on_ground    = on_ground;
	hdr.water_level  = water_level;
	hdr.water_type   = water_type;
	hdr.num_edicts   = hl_pr_num_edicts;
	hdr.edict_stride = hl_pr_edict_stride;
	hdr.num_globals  = hl_pr_num_globals;
	hdr.strings_size = hl_pr_strings_size;
	hdr.string_alloc = hl_pr_string_alloc;
	hdr.num_models   = hl_precache_model_count;
	hdr.num_sounds   = hl_precache_sound_count;

	for (j = 0; j < 3; j++)
	{
		hdr.origin[j]   = origin[j];
		hdr.velocity[j] = velocity[j];
		hdr.angles[j]   = angles[j];
	}

	for (j = 0; j < HLGAME_MAX_PARMS; j++)
		hdr.saved_parms[j] = hl_saved_parms[j];
	hdr.saved_serverflags = hl_saved_serverflags;

	edict_bytes = hl_pr_num_edicts * hl_pr_edict_stride;

	total = sizeof(CHLSaveHeader)
		+ hl_pr_num_globals * 4
		+ edict_bytes
		+ hl_pr_num_edicts			//one free flag per edict
		+ hl_pr_strings_size
		+ HLMAX_LIGHTSTYLES * HLLIGHTSTYLE_LEN
		+ (hl_precache_model_count + hl_precache_sound_count) * 8
		+ HLSAVE_PARM_BYTES;

	if (total < 1)
	{
		"HLSave: refusing a %d byte save\n", total;
		return FALSE;
	}

	buf = MAlloc(total);
	if (!buf)
	{
		"HLSave: out of memory for %d bytes\n", total;
		return FALSE;
	}

	p = buf;

	p = HLSaveAppend(p, &hdr, sizeof(CHLSaveHeader));
	p = HLSaveAppend(p, hl_pr_globals, hl_pr_num_globals * 4);
	p = HLSaveAppend(p, hl_pr_edicts, edict_bytes);

	//Bool is wider than a byte, so the free list is packed down
	for (i = 0; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
			p[0] = 1;
		else
			p[0] = 0;
		p++;
	}

	p = HLSaveAppend(p, hl_pr_strings, hl_pr_strings_size);
	p = HLSaveAppend(p, hl_lightstyle, HLMAX_LIGHTSTYLES * HLLIGHTSTYLE_LEN);

	//precache names as offsets into the heap, not copies: the heap is already in
	//this file, so an offset cannot drift from the entity string fields
	for (i = 0; i < hl_precache_model_count; i++)
	{
		ofs = 0;
		if (hl_precache_model[i])
			ofs = hl_precache_model[i] - hl_pr_strings;
		MemCopy(p, &ofs, 8);
		p += 8;
	}

	for (i = 0; i < hl_precache_sound_count; i++)
	{
		ofs = 0;
		if (hl_precache_sound[i])
			ofs = hl_precache_sound[i] - hl_pr_strings;
		MemCopy(p, &ofs, 8);
		p += 8;
	}

	//--- version 2 trailer: per client spawn parms ---
	ofs = HLSV_MAX_CLIENTS;
	MemCopy(p, &ofs, 8);
	p += 8;

	ofs = HLPR_MAX_PARM_GLOBALS;
	MemCopy(p, &ofs, 8);
	p += 8;

	for (i = 0; i < HLSV_MAX_CLIENTS; i++)
	{
		ofs = 0;
		if (hl_client_parms_set[i])
			ofs = 1;
		MemCopy(p, &ofs, 8);
		p += 8;

		MemCopy(p, &hl_client_parms[i * HLPR_MAX_PARM_GLOBALS],
			HLPR_MAX_PARM_GLOBALS * 8);
		p += HLPR_MAX_PARM_GLOBALS * 8;
	}

	if (FileWrite(path, buf, total) < 1)
	{
		"HLSave: could not write %s\n", path;
		Free(buf);
		return FALSE;
	}

	Free(buf);

	"HLSave: wrote %s (%d bytes, %d edicts)\n", path, total, hl_pr_num_edicts;
	return TRUE;
}

//load is two halves; only the shell knows how to bring a map up
//
//HLSaveReadHeader reports which map is needed, the shell loads it, and
//HLSaveRestore writes the saved state into the fresh world
U8	*hl_save_buf		= NULL;
I64	 hl_save_size	= 0;
CHLSaveHeader hl_save_hdr;

U0 HLSaveDiscard()
{
	if (hl_save_buf)
	{
		Free(hl_save_buf);
		hl_save_buf = NULL;
	}
	hl_save_size = 0;
}

Bool HLSaveReadHeader(U8 *path, U8 *_mapname)
{//read the file and report the map it belongs to
	I64 size = 0;

	HLSaveDiscard;

	hl_save_buf = FileRead(path, &size);
	if (!hl_save_buf)
	{
		"HLSave: %s not found\n", path;
		return FALSE;
	}

	hl_save_size = size;

	if (size < sizeof(CHLSaveHeader))
	{
		"HLSave: %s is truncated\n", path;
		HLSaveDiscard;
		return FALSE;
	}

	MemCopy(&hl_save_hdr, hl_save_buf, sizeof(CHLSaveHeader));

	//a version 1 file is readable and stops after the precache lists. Only a
	//foreign magic or a future version is rejected
	if (hl_save_hdr.magic != HLSAVE_MAGIC ||
		hl_save_hdr.version < HLSAVE_VERSION_MIN ||
		hl_save_hdr.version > HLSAVE_VERSION)
	{
		"HLSave: %s is not a version %d..%d save\n", path,
			HLSAVE_VERSION_MIN, HLSAVE_VERSION;
		HLSaveDiscard;
		return FALSE;
	}

	HLStrCopy(_mapname, hl_save_hdr.mapname, 96);
	return TRUE;
}

Bool HLSaveRestore(F64 *_game_time, F64 *origin, F64 *velocity, F64 *angles,
	Bool *_on_ground, I64 *_water_level, I64 *_water_type)
{//Host_Loadgame_f second half: overwrite the fresh world
	CHLSaveHeader	*hdr = &hl_save_hdr;
	U8				*p;
	I64				 edict_bytes;
	I64				 ofs;
	I64				 i;
	I64				 j;
	I64				 slots;
	I64				 nparm;
	I64				 flag;
	I64				 remaining;
	F64				 value;

	if (!hl_save_buf)
		return FALSE;

	//layouts must match exactly or the field block is misread. They differ only
	//when the bytecode changed under the save
	if (hdr->edict_stride != hl_pr_edict_stride ||
		hdr->num_globals != hl_pr_num_globals ||
		hdr->strings_size != hl_pr_strings_size)
	{
		"HLSave: save does not match this progs.dat\n";
		HLSaveDiscard;
		return FALSE;
	}

	if (hdr->num_edicts < 1 || hdr->num_edicts > hl_pr_max_edicts)
	{
		"HLSave: edict count out of range\n";
		HLSaveDiscard;
		return FALSE;
	}

	edict_bytes = hdr->num_edicts * hdr->edict_stride;
	p           = hl_save_buf + sizeof(CHLSaveHeader);

	MemCopy(hl_pr_globals, p, hdr->num_globals * 4);
	p += hdr->num_globals * 4;

	MemCopy(hl_pr_edicts, p, edict_bytes);
	p += edict_bytes;

	for (i = 0; i < hdr->num_edicts; i++)
	{
		hl_pr_edict_free[i] = ToBool(p[0]);
		p++;
	}

	hl_pr_num_edicts = hdr->num_edicts;

	//entity string fields are offsets into this heap
	MemCopy(hl_pr_strings, p, hdr->strings_size);
	p += hdr->strings_size;
	hl_pr_string_alloc = hdr->string_alloc;

	MemCopy(hl_lightstyle, p, HLMAX_LIGHTSTYLES * HLLIGHTSTYLE_LEN);
	p += HLMAX_LIGHTSTYLES * HLLIGHTSTYLE_LEN;

	//rebuilt in index order: re-precaching by name returns the same indices, so
	//every .modelindex still means what it did at save time
	for (i = 0; i < hdr->num_models; i++)
	{
		MemCopy(&ofs, p, 8);
		p += 8;

		if (i > 0 && ofs > 0 && ofs < hl_pr_strings_size)
			HLBiPrecacheModel(HLPrStr(ofs));
	}

	for (i = 0; i < hdr->num_sounds; i++)
	{
		MemCopy(&ofs, p, 8);
		p += 8;

		if (ofs > 0 && ofs < hl_pr_strings_size &&
			hl_precache_sound_count < HLBI_MAX_PRECACHE)
		{
			hl_precache_sound[hl_precache_sound_count] = HLPrStr(ofs);
			hl_precache_sound_count++;
		}
	}

	for (j = 0; j < HLGAME_MAX_PARMS; j++)
		hl_saved_parms[j] = hdr->saved_parms[j];
	hl_saved_serverflags = hdr->saved_serverflags;
	hl_have_saved_parms  = TRUE;

	//--- per client spawn parms ---
	//
	//every slot is seeded from the header first. That is all a version 1 file
	//has: slot 0 holds the player's kit and no other slot is set
	for (i = 0; i < HLSV_MAX_CLIENTS; i++)
		hl_client_parms_set[i] = FALSE;

	for (j = 0; j < HLPR_MAX_PARM_GLOBALS; j++)
		hl_client_parms[j] = hdr->saved_parms[j];
	hl_client_parms_set[0] = TRUE;

	remaining = hl_save_size - (p - hl_save_buf);

	if (hdr->version >= 2 && remaining >= 16)
	{
		//the counts live here, not in the header: the header is frozen at its
		//version 1 size and a wider HLSV_MAX_CLIENTS must still read old files
		MemCopy(&slots, p, 8);
		p += 8;
		MemCopy(&nparm, p, 8);
		p += 8;
		remaining -= 16;

		if (slots >= 0 && nparm >= 0 &&
			remaining >= slots * (8 + nparm * 8))
		{
			for (i = 0; i < slots; i++)
			{
				MemCopy(&flag, p, 8);
				p += 8;

				//every parm in the file is read, and those this build has
				//room for are kept. A save from a bigger progs must not
				//walk off the array
				for (j = 0; j < nparm; j++)
				{
					MemCopy(&value, p, 8);
					p += 8;

					if (i < HLSV_MAX_CLIENTS && j < HLPR_MAX_PARM_GLOBALS)
						hl_client_parms[i * HLPR_MAX_PARM_GLOBALS + j] = value;
				}

				if (i < HLSV_MAX_CLIENTS)
					hl_client_parms_set[i] = ToBool(flag);
			}
		}
		else
			"HLSave: parm block is malformed, keeping one client\n";
	}

	for (j = 0; j < 3; j++)
	{
		origin[j]   = hdr->origin[j];
		velocity[j] = hdr->velocity[j];
		angles[j]   = hdr->angles[j];
	}

	*_game_time   = hdr->game_time;
	*_on_ground   = ToBool(hdr->on_ground);
	*_water_level = hdr->water_level;
	*_water_type  = hdr->water_type;

	//the VM clock must agree with the restored time, or every scheduled think
	//fires at once, or never
	HLPrSetF(hl_ofs_time, hdr->game_time);
	hl_game_time = hdr->game_time;

	//absmin/absmax are derived, so they are rebuilt rather than restored
	HLGameLinkAll;

	"HLSave: restored %d edicts at t=%.1f\n", hl_pr_num_edicts, hdr->game_time;

	HLSaveDiscard;
	return TRUE;
}
