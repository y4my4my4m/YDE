U0 HLSaveWriteGlobals()
{
	I64 blk = HLSaveBlockBegin(HLSB_GLOBALS);
	I64 i;

	HLSavePutI(hl_ent_global_count);

	for (i = 0; i < hl_ent_global_count; i++)
	{
		HLSavePutStr(hl_ent_globals[i].name);
		HLSavePutI(hl_ent_globals[i].state);
	}

	HLSavePutI(hl_ent_globalname_count);

	for (i = 0; i < hl_ent_globalname_count; i++)
	{
		HLSavePutStr(hl_ent_globalnames[i].name);
		HLSavePutStr(hl_ent_globalnames[i].level);
		HLSavePutI(hl_ent_globalnames[i].state);
	}

	HLSaveBlockEnd(blk);
}

U0 HLSaveReadGlobals()
{
	U8	name[64];
	U8	level[64];
	I64	count;
	I64	state;
	I64	n = 0;
	I64	i;

	count = HLSaveGetI;

	for (i = 0; i < count; i++)
	{
		HLSaveGetStr(name, 64);
		state = HLSaveGetI;

		if (hl_saver_err || n >= HLENT_GLOBAL_MAX)
			goto qsrg_next;

		HLStrCopy(hl_ent_globals[n].name, name, 64);
		hl_ent_globals[n].state = state;
		n++;

qsrg_next:
	}

	hl_ent_global_count = n;

	n     = 0;
	count = HLSaveGetI;

	for (i = 0; i < count; i++)
	{
		HLSaveGetStr(name, 64);
		HLSaveGetStr(level, 64);
		state = HLSaveGetI;

		if (hl_saver_err || n >= HLENT_GLOBALNAME_MAX)
			goto qsrg_next2;

		HLStrCopy(hl_ent_globalnames[n].name, name, 64);
		HLStrCopy(hl_ent_globalnames[n].level, level, 64);
		hl_ent_globalnames[n].state = state;
		n++;

qsrg_next2:
	}

	hl_ent_globalname_count = n;
}

U0 HLSaveWriteMM()
{
	I64 blk = HLSaveBlockBegin(HLSB_MM);
	I64 i;
	I64 j;

	HLSavePutI(hl_mm_count);
	HLSavePutI(HLENT_MM_MAX);
	HLSavePutI(HLENT_MM_THREADS);

	for (i = 0; i < hl_mm_count; i++)
	{
		HLSavePutI(hl_mm[i].ent);
		HLSavePutI(hl_mm[i].count);

		for (j = 0; j < HLENT_MM_THREADS; j++)
		{
			HLSavePutI(hl_mm[i].fired[j]);

			if (hl_mm[i].started[j] < 0.0)
				HLSavePutT(0.0);
			else
				HLSavePutT(hl_mm[i].started[j]);
		}

		for (j = 0; j < HLENT_MM_MAX; j++)
		{
			HLSavePutStr(&hl_mm[i].name[j * 64]);
			HLSavePutF(hl_mm[i].delay[j]);
		}
	}

	HLSaveBlockEnd(blk);
}

U0 HLSaveReadMM()
{
	U8	name[64];
	I64	count;
	I64	slots;
	I64	runs;
	I64	ent;
	I64	n;
	I64	fired;
	I64	i;
	I64	j;
	F64	started;
	F64	delay;

	count = HLSaveGetI;
	slots = HLSaveGetI;
	runs  = HLSaveGetI;

	if (count > HLENT_MM_SLOTS)
		count = HLENT_MM_SLOTS;

	hl_mm_count = 0;

	for (i = 0; i < count; i++)
	{
		ent = HLSaveGetI;
		n   = HLSaveGetI;

		if (hl_saver_err)
			return;

		hl_mm[i].ent   = ent;
		hl_mm[i].count = n;

		for (j = 0; j < HLENT_MM_THREADS; j++)
		{
			hl_mm[i].fired[j]   = 0;
			hl_mm[i].started[j] = -1.0;
		}

		for (j = 0; j < runs; j++)
		{
			fired   = HLSaveGetI;
			started = HLSaveGetT;

			if (j >= HLENT_MM_THREADS)
				goto qsrm_next_run;

			//0 is HLSavePutT's "never": the run was free
			if (started <= 0.0)
				goto qsrm_next_run;

			hl_mm[i].fired[j]   = fired;
			hl_mm[i].started[j] = started;

qsrm_next_run:
		}

		if (hl_saver_err)
			return;

		for (j = 0; j < slots; j++)
		{
			HLSaveGetStr(name, 64);
			delay = HLSaveGetF;

			if (j >= HLENT_MM_MAX)
				goto qsrm_next_slot;

			HLStrCopy(&hl_mm[i].name[j * 64], name, 64);
			hl_mm[i].delay[j] = delay;

qsrm_next_slot:
		}

		hl_mm_count = i + 1;
	}
}

