U0 HLSaveReadMove()
{
	hl_ducking        = HLSaveGetB;
	hl_duck_pending   = HLSaveGetB;
	hl_duck_held_last = HLSaveGetB;
	hl_duck_time      = HLSaveGetF;
	hl_view_ofs_z     = HLSaveGetF;

	hl_jump_held  = HLSaveGetB;
	hl_on_ladder  = HLSaveGetB;
	hl_ladder_ent = HLSaveGetI;

	hl_waterjump_time = HLSaveGetF;
	HLSaveGetV(hl_waterjump_dir);

	hl_fall_velocity       = HLSaveGetF;
	hl_fall_damage_pending = HLSaveGetF;

	hl_gravity_scale = HLSaveGetF;
	hl_step_dist     = HLSaveGetF;
	hl_step_side     = HLSaveGetI;
	hl_ground_entity = HLSaveGetI;

	HLDuckSetHull(hl_ducking);

	hl_fall_sound_vol = 0.0;
	hl_fall_pain      = FALSE;
	hl_fall_punch_z   = 0.0;
	hl_step_play      = FALSE;
