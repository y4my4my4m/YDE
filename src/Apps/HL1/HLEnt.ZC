// HLEnt.ZC - ED_LoadFromFile, entity lump parsing and static spawning
//
// the lump is brace-delimited quoted key/value text sliced out of the map
// buffer, not NUL terminated - every scan is bounded by an end pointer
//
//   brush entities  "model" "*N", index into the bsp's model list
//   point entities  origin only, model normally comes from progs precache
//
// no QuakeC VM on this path, so point entities take their model from the table
// below and everything spawns in its rest pose

#define HLENT_MAX	1024

//--- entity state ----------------------------------------------------------
//
// The SDK's entvars_t plus the CBaseToggle state a mover needs, flattened.
// HL keeps entvars (engine-visible) separate from the C++ class instance
// (game-only); with the game compiled in there is no boundary to maintain, so
// this is one struct.
//
// Behaviour lives in HLEntity.ZC. This file only parses and resolves models,
// because it compiles before the traces the movers need.

//movetypes. declared here rather than with the QuakeC glue in HLGame.ZC - the
//native entities need them and compile first
#define HLMOVETYPE_NONE			0
#define HLMOVETYPE_ANGLENOCLIP	1
#define HLMOVETYPE_ANGLECLIP		2
#define HLMOVETYPE_WALK			3
#define HLMOVETYPE_STEP			4
#define HLMOVETYPE_FLY			5
#define HLMOVETYPE_TOSS			6
#define HLMOVETYPE_PUSH			7
#define HLMOVETYPE_NOCLIP		8
#define HLMOVETYPE_FLYMISSILE	9
#define HLMOVETYPE_BOUNCE		10

//Which class spawned an entity. The SDK asks this with dynamic_cast and
//virtual overrides; here the behaviour is shared and only a few places need to
//tell two movers apart - func_train offsets its destination by its own mins,
//func_tracktrain does not.
#define HLC_NONE			0
#define HLC_DOOR			1
#define HLC_BUTTON			2
#define HLC_TRAIN			3
#define HLC_TRACKTRAIN		4
#define HLC_PLAT			5
#define HLC_PATH			6
#define HLC_TRIGGER			7
#define HLC_WALL			8
#define HLC_LIGHT			9
#define HLC_MANAGER			10
#define HLC_SCRIPT			11	//scripted_sequence, driven by HLAI.ZC
#define HLC_MONSTER			12
#define HLC_SENTENCE			13	//scripted_sentence, also HLAI.ZC's job
#define HLC_ITEM				14	//item_* pickup, touched not used
#define HLC_CHARGER			15	//func_healthcharger / func_recharge
#define HLC_SPRITE			16	//env_sprite / env_glow / cycler_sprite
#define HLC_BEAM				17	//env_beam / env_laser
#define HLC_ROTATE			18	//motion is angular, not linear
#define HLC_PUSHABLE			19	//func_pushable, stepped by its own pass
#define HLC_TRACKCHANGE		20	//func_trackchange, a platrot that carries a car
#define HLC_TRACKAUTO		21	//func_trackautochange, CFuncTrackAuto

//solid types
#define HLSOLID_NOT			0
#define HLSOLID_TRIGGER		1
#define HLSOLID_BBOX			2
#define HLSOLID_SLIDEBOX		3
#define HLSOLID_BSP			4

//toggle_state - CBaseToggle. a door at rest is AT_TOP or AT_BOTTOM, never
//in between; the two GOING states own the interval
#define HLTS_AT_TOP			0
#define HLTS_AT_BOTTOM		1
#define HLTS_GOING_UP		2
#define HLTS_GOING_DOWN		3

//pev->controller slots: four generic channels plus the mouth at 4
#define HLENT_MAX_CTL		5

//USE_TYPE. SET carries a value, the rest do not
#define HLUSE_OFF			0
#define HLUSE_ON				1
#define HLUSE_SET			2
#define HLUSE_TOGGLE			3

class CHLEntity
{
	U8		 classname[64];
	U8		 model_name[64];	//raw "model" value, "*N" for brush models
	F64		 origin[3];
	F64		 angles[3];
	I64			 brush_model;	//BSP model index, or -1
	CHLMdl		*mdl;			//resolved IDPO alias model, or NULL
	CHLStudio	*studio;		//resolved IDST studio model, or NULL
	I64			 frame;

	//studio playback. without a VM nothing drives these, so everything plays
	//its first sequence on the wall clock
	I64			 seq;
	I64			 body;
	I64			 skin;

	//pev->controller, the five raw studio bone controller settings: 0..3 over
	//0..255 and the mouth at 4 over 0..64. Raw zero is not neutral - a channel
	//authored over -60..60 sits at its start there, which cranks the head bone
	//hard over - so HLEntLoadModels seeds these with InitBoneControllers
	F64		 controllers[HLENT_MAX_CTL];

	//pev->blending, the two sequence blend axis settings. Held over 0..1, the
	//renderer's slerp fraction; the SDK's byte is this times 255. A sequence
	//with one blend ignores them. The aim pitch of a firing monster is the
	//only writer
	F64		 blending[2];

	//"pose" on the monster_*_dead classes, an index into that class's pose
	//table. CDeadScientist::KeyValue
	I64		 pose;

	//--- targeting ---
	U8		 targetname[64];
	U8		 target[64];
	U8		 killtarget[64];
	U8		 master[64];		//a multisource/button that must be on first
	U8		 message[128];
	U8		 netname[64];
	I64		 spawnflags;

	//pev->weapons. On an hgrunt this is the loadout: bit 3 shotgun, bit 2
	//grenade launcher, hgrunt.cpp:1012. Nothing else in the campaign reads it
	I64		 weapons;

	//"this talker follows the player": HLAI's mirror of hl_ai_talk[].follow ==
	//HLTLK_PLAYER, kept here because HLEntity.ZC compiles first and the carry
	//across a changelevel cannot read that table. HLAITalkEnsure re-applies it
	//on the far side
	Bool	 follow_player;

	//--- physics ---
	I64		 movetype;
	I64		 solid;
	F64		 velocity[3];
	F64		 avelocity[3];		//degrees per second
	F64		 mins[3];			//model relative
	F64		 maxs[3];
	F64		 absmin[3];			//world space, rebuilt on every move
	F64		 absmax[3];
	F64		 size[3];

	//--- mover state ---
	F64		 speed;

	//CFuncTrackTrain::m_startSpeed, plats.cpp:969. Spawn always thinks Find at
	//+0.1 (plats.cpp:1521), Find copies it into pev->speed (plats.cpp:1406),
	//and Next parks a train whose speed is zero (plats.cpp:1164). A tracktrain
	//self-starts iff startspeed is nonzero, named or not
	F64		 start_speed;

	//CFuncTrackTrain::m_speed and m_length, plats.cpp:1500 and :960. m_speed is
	//the "speed" key, the maximum the car runs at; speed above is pev->speed,
	//which a path node overwrites as the car passes. m_length is the "wheels"
	//key: the distance Next aims ahead and the range a track change counts as
	//"car is on the lift". Every shipped tracktrain carries wheels - 170 on the
	//intro tram, 50 in zone 3
	F64		 train_speed;
	F64		 train_length;

	F64		 wait;
	F64		 delay;
	F64		 lip;
	F64		 height;
	F64		 dmg;

	//CBaseTrigger::m_bitsDamageInflict, the "damagetype" key, triggers.cpp:575.
	//HurtTouch does not read it: the switch on it is #if 0 in the shipped SDK.
	//DMG_RADIATION is the one bit anything reads - it marks the volumes the
	//geiger counter ranges on. 312 entities across 77 shipped maps carry the key
	I64		 damage_type;

	F64		 damage;
	F64		 health;
	F64		 max_health;
	I64		 takedamage;
	I64		 toggle_state;
	I64		 ent_class;			//HLC_*, set by the spawn function

	//--- scripted sequences and animation ---
	//
	//HL's script entities carry their payload in m_isz* keys rather than in
	//target/targetname, so they need their own fields
	U8		 ai_play[64];		//m_iszPlay - sequence to run
	U8		 ai_idle[64];		//m_iszIdle - sequence while waiting
	U8		 ai_entity[64];		//m_iszEntity - who to run it on
	I64		 ai_moveto;			//m_fMoveTo: 0 none, 1 walk, 2 run, 4 instant
	F64		 ai_radius;			//m_flRadius

	//studio playback state. cycle is derived from (now - anim_start) so a
	//scripted sequence can play once instead of looping
	F64		 anim_start;
	Bool	 anim_loop;
	Bool	 anim_done;

	//Highest sequence frame whose mstudioevent_t list has already been fired.
	//-1 means the sequence has not been stepped yet.
	I64		 anim_event_frame;

	//sound selection. HL stores these as small integers indexing a table
	//baked into the game code, not as paths - see HLEntSoundFor*
	I64		 move_snd;
	I64		 stop_snd;
	I64		 snd_index;			//the "sounds" key
	F64		 volume;

	//CBaseDoor / CBaseButton refusal cues. locked_sound and unlocked_sound
	//index ButtonSound, the same table as "sounds"; locked_sentence and
	//unlocked_sentence index a sentence group name. doors.cpp:436-481
	I64		 locked_snd;
	I64		 unlocked_snd;
	I64		 locked_sentence;
	I64		 unlocked_sentence;

	//locksound_t, doors.cpp:106. Debounce stamps and the sequential sentence
	//cursors, held on the entity because the port has no per-class state block
	F64		 lock_wait_snd;		//flwaitSound
	F64		 lock_wait_sent;	//flwaitSentence
	I64		 lock_sent_ord;		//iLockedSentence
	I64		 unlock_sent_ord;	//iUnlockedSentence
	Bool	 lock_sent_eof;		//bEOFLocked
	Bool	 unlock_sent_eof;	//bEOFUnlocked

	F64		 position1[3];		//retracted
	F64		 position2[3];		//extended
	F64		 angle1[3];			//rotating doors, same idea
	F64		 angle2[3];
	F64		 finaldest[3];
	F64		 finalangle[3];
	F64		 move_dir[3];		//the axis "angle" resolved to a unit vector

	//--- scheduling ---
	//methods are integer ids dispatched through a switch, not function
	//pointers: the dispatcher can then be defined after every implementation,
	//which a single-pass compiler needs
	I64		 think_fn;
	F64		 next_think;		//absolute game time, 0 = never
	I64		 move_done;			//fires when a linear/angular move arrives
	I64		 touch_fn;
	I64		 use_fn;
	I64		 blocked_fn;

	//"free this entity once its deferred fire has actually gone off". The delay
	//on a fire rides on the firing entity's own think here, not on a separate
	//DelayedUse entity as in the SDK, so a fire-once class cannot free itself
	//the moment it schedules one - see HLM_AUTO_THINK
	Bool	 remove_after_fire;

	I64		 owner;				//entity index, -1 for none
	I64		 activator;			//who last used this, for target chains
	F64		 ltime;				//pusher local time
	F64		 pain_finished;

	//--- render ---
	I64		 rendermode;
	F64		 renderamt;
	F64		 rendercolor[3];
	I64		 renderfx;
	I64		 effects;
	I64		 style;				//lightstyle for light entities

	//--- effects and env_* classes ------------------------------------------
	//
	// One group: the env_* / game_* / item_* families keep their payload in
	// class specific keys, and the generic parser above has nowhere to put
	// them.

	//sprites. env_sprite, env_glow and cycler_sprite are a .spr at a point,
	//so they cannot use mdl/studio - those two are IDPO/IDST only
	CHLSpr	*spr;				//borrowed from the sprite cache, never owned
	F64		 framerate;			//sprite animation, frames per second
	F64		 scale;				//sprite scale, 1.0 = texel per pixel at 1 unit
	Bool	 visible;			//a toggled sprite/beam that is currently ON

	//beams. env_beam names its two ends by targetname, env_laser names one and
	//fires from its own origin. resolved to indices at spawn because the names
	//are only meaningful during the entity pass
	U8		 beam_start_name[64];
	U8		 beam_end_name[64];
	I64		 beam_start;		//entity index, -1 = use this entity's origin
	I64		 beam_end;
	F64		 beam_width;

	//CLightning::m_frameStart, effects.cpp:563; CLaser reads the same key at
	//effects.cpp:1029. The texture frame the ribbon draws with;
	//the beam does not animate off it. 108 of the 803 shipped env_beam and
	//env_laser entities set it nonzero, all of them on sprites/lgtning.spr or
	//sprites/plasma.spr, whose frames are different bolt shapes
	I64		 beam_frame;

	//NoiseAmplitude and TextureScroll, held as the map spells them. The SDK
	//keeps both as ints - effects.cpp:543, effects.cpp:1009 - and the wire
	//format carries the scale: width and scroll in 0.1s, noise amplitude in
	//0.01s, const.h:131-135. The scale belongs to the draw call, not here
	F64		 beam_noise;		//SetNoise, m_noiseAmplitude
	F64		 beam_scroll;		//SetScrollRate, m_speed

	F64		 beam_life;			//CLightning "life", 0 = a permanent server beam
	F64		 beam_restrike;		//"StrikeTime", the gap between strikes
	Bool	 beam_active;		//CLightning m_active / CLaser::IsOn

	//env_bubbles. density is bubbles per fizz; "current" is a horizontal drift
	//the SDK smuggles through rendercolor. Its "frequency" key is the shared
	//field below - CBubbling reads it as an int, CEnvShake as a float.
	I64		 density;

	//env_blood. the SDK keeps these in pev->impulse and pev->dmg, which this
	//port uses for other things
	I64		 blood_color;		//palette index, red or yellow
	F64		 blood_amount;

	//gibshooter / env_shooter. m_iGibs is the capacity, gib_left the counter
	//ShootThink walks down
	I64		 gib_count;			//m_iGibs
	I64		 gib_left;
	F64		 gib_velocity;		//m_flVelocity
	F64		 gib_variance;		//m_flVariance
	F64		 gib_life;			//m_flGibLife
	U8		 shoot_model[64];	//"shootmodel", env_shooter's own gib model

	//text. env_message names an entry in titles.txt; game_text carries the
	//literal string in "message" plus its own placement
	F64		 hold_time;			//holdtime - how long the text stays up
	F64		 fade_in;
	F64		 fade_out;
	F64		 text_x;			//game_text x/y, -1 = centre on that axis
	F64		 text_y;

	//game_text "color" and "color2", 0..255 per channel. CGameText::KeyValue,
	//maprules.cpp:275 and :285, fills r1/g1/b1 and r2/g2/b2. The fourth
	//component each key may carry is alpha, which CHudMessage never reads.
	//White when the keys are absent, which is CHudMessage's own default
	F64		 text_color[3];
	F64		 text_color2[3];

	//screen effects. env_shake / env_fade / trigger_gravity feed the pending
	//globals in HLEntity.ZC rather than acting directly - the shell owns the
	//view and the player's gravity
	F64		 radius;			//env_shake, env_sound, scripted_sentence
	F64		 amplitude;
	F64		 frequency;
	F64		 duration;
	F64		 magnitude;			//env_explosion iMagnitude
	F64		 max_delay;			//env_spark MaxDelay
	F64		 modifier;			//func_friction, a percentage
	F64		 damp;				//func_pendulum, how fast a swing dies away
	F64		 gravity;			//trigger_gravity, a multiplier
	I64		 roomtype;			//env_sound - reverb preset id
	I64		 preset;			//speaker - CSpeaker::m_preset, sound.cpp:1975

	//angular movers. func_door_rotating / func_rotating / momentary_rot_button
	//travel in degrees, so SUB_CalcMove needs an angular twin and the arrival
	//has to know which of the two it is finishing
	F64		 distance;			//degrees of travel
	Bool	 moving_angular;	//the in-flight move is an angle move
	F64		 momentary_frac;	//momentary_* position, 0..1

	//CBasePlatTrain::KeyValue's "rotation", plats.cpp:78 - m_vecFinalAngle.x.
	//Degrees a func_platrot turns through its travel, and the resting
	//orientation a func_trackchange is built at
	F64		 rot_amount;

	//func_trackchange / func_trackautochange. CFuncTrackChange, plats.cpp:1618.
	//The two path_track chains the lift joins and the car it carries, held by
	//name from the map and as indices once Find resolves them
	U8		 track_top[64];		//"toptrack", m_trackTopName
	U8		 track_bottom[64];	//"bottomtrack", m_trackBottomName
	U8		 track_train[64];	//"train", m_trainName
	I64		 track_top_ent;		//m_trackTop, -1 unresolved
	I64		 track_bottom_ent;	//m_trackBottom, -1 unresolved
	I64		 track_train_ent;	//m_train, -1 unresolved
	I64		 track_code;		//m_code, an HLTRAIN_ verdict from EvaluateTrain
	I64		 track_target;		//m_targetState, in this port's toggle polarity
	Bool	 track_use;			//m_use, cleared while the lift travels

	//mirrors HLClipSetRotating for this slot. the registry in HLClip.ZC is the
	//authority - draw and trace both read it - but HLEntSetAbsBox needs the
	//same answer and holds a pointer, not an index
	Bool	 rotates;

	//chargers. func_healthcharger and func_recharge meter out a pool and then
	//refuse until it refills
	F64		 charge;			//what is left in this one
	F64		 charge_next;		//next tick this charger will give anything

	//game time of the last +use on an FCAP_CONTINUOUS_USE entity. Stands in
	//for CMomentaryRotButton::m_lastUsed and for PFLAG_USING on a charger:
	//both run until the key is released, which is a gap in this stamp
	F64		 use_last;

	//func_breakable / func_pushable "material", CBreakable::m_Material.
	//Selects the break sound, the shard sound and the debris model; 7
	//(unbreakable glass) also makes the brush immune. func_break.h:19
	I64		 material;

	//CBreakable::m_iszSpawnObject as the map spells it: an index into
	//pSpawnObjects, func_break.cpp:37, not a classname. 0 drops nothing
	I64		 spawn_object;

	//CWorldItem::m_iType, items.cpp:48. 42 antidote, 43 security, 44 battery,
	//45 suit
	I64		 item_type;

	//trigger_camera. CTriggerCamera, triggers.cpp:2157. m_flWait is the shared
	//wait key and m_state is toggle_state; the rest have no existing home
	U8		 cam_moveto[64];	//m_sPath, the first path_corner
	F64		 cam_accel;			//m_acceleration, 500 when the key is absent
	F64		 cam_decel;			//m_deceleration
	F64		 cam_return;		//m_flReturnTime, absolute
	F64		 cam_stop;			//m_flStopTime, absolute
	F64		 cam_move_dist;		//m_moveDistance
	F64		 cam_target_speed;	//m_targetSpeed
	F64		 cam_initial_speed;	//m_initialSpeed, pev->speed at spawn
	I64		 cam_path;			//m_pentPath, entity index, -1 none
	I64		 cam_target;		//m_hTarget, entity index, -1 none

	//player_loadsaved. CRevertSaved keeps its four durations in pev->dmg_take,
	//pev->dmg_save and two members, player.cpp:4952
	F64		 revert_message_time;	//m_messageTime
	F64		 revert_load_time;		//m_loadTime

	//func_pushable. CPushable, dlls/func_break.cpp:790
	F64		 push_friction;		//"friction", clamped to 399 at spawn
	F64		 push_max_speed;	//m_maxSpeed, 400 - friction. units per second
	F64		 push_buoyancy;		//pev->skin, scaled by the box cross-section
	F64		 push_snd_time;		//m_soundTime, game time of the last scrape
	I64		 push_snd_last;		//m_lastSound, index into the three scrape wavs

	//func_rotating. CFuncRotating::KeyValue, dlls/bmodels.cpp:319
	F64		 fan_friction;		//m_flFanFriction, the key over 100
	F64		 fan_atten;			//m_flAttenuation, from the radius spawnflags

	//ambient_generic modulation. CAmbientGeneric::KeyValue, dlls/sound.cpp:283.
	//Held raw as the map wrote them; HLSndAmbientAddEx applies every clamp and
	//rescale. fadein and fadeout share fade_in/fade_out with env_fade - the key
	//names are identical and no entity is both classes.
	I64		 amb_pitch;			//m_dpv.pitchrun
	I64		 amb_pitchstart;
	I64		 amb_spinup;
	I64		 amb_spindown;
	I64		 amb_volstart;
	I64		 amb_lfotype;
	I64		 amb_lforate;
	I64		 amb_lfomodpitch;
	I64		 amb_lfomodvol;
	I64		 amb_cspinup;

	//misc keys the new classes read
	U8		 texture[64];		//infodecal texture, beam sprite path
	U8		 next_map[64];		//trigger_changelevel "map"
	U8		 landmark[64];		//trigger_changelevel "landmark"
	U8		 global_state[64];	//env_global / multisource "globalstate"
	U8		 global_name[64];	//pev->globalname, the transition identity
	U8		 ai_sentence[64];	//scripted_sentence "sentence"
	U8		 ai_listener[64];	//scripted_sentence "listener"
	F64		 ai_refire;			//scripted_sentence "refire", m_flRepeat
	I64		 ai_atten;			//scripted_sentence "attenuation", pev->impulse
							//0 idle, 1 static, 2 norm, 3 none
	I64		 trigger_mode;		//env_global triggermode / trigger_auto
								//triggerstate, both as HLUSE_*. No entity
								//carries both keys
	I64		 initial_state;		//env_global initialstate

	//--- cached R_LightPoint sample -----------------------------------------
	//
	// GoldSrc keeps the model lighting on the entity and re-samples only when
	// something that feeds it changed. See HLEntLightPoint.
	F64		 light_org[3];		//where light_value was sampled
	I64		 light_value;		//the sample, 24..128
	I64		 light_style;		//lightstyle of the face it landed on, -1 none
	I64		 light_style_val;	//that style's value at sample time
	Bool	 light_dlit;		//a dynamic light was inside the sample
	Bool	 light_valid;		//there is a sample at all

	Bool	 in_use;
	Bool	 spawned;			//its class function has run
};

CHLEntity	*hl_entities		= NULL;
I64			 hl_num_entities	= 0;

//how far an entity may drift before its light sample is thrown away. A model
//shifting a couple of units inside one luxel samples the same texel
#define HLENT_LIGHT_SLOP	4.0

I64 HLEntLightPoint(CHLMap *map, CHLEntity *e)
{//R_LightPoint, cached on the entity the way GoldSrc caches it on cl_entity_t
 //
 //The trace is 2048 units of BSP descent plus a marksurface walk, and a static
 //prop in a lit room needs it once, not once per frame. The sample is dropped
 //when the entity moves, when the lightstyle its face animates on changes
 //value, or when a dynamic light reaches it
	F64	 delta[3];
	Bool dlit;
	Bool resample;

	if (!e)
		return HLLIGHT_FALLBACK;

	dlit     = HLDlightNear(e->origin, hl_light_time);
	resample = FALSE;

	//a flash on the entity re-samples for as long as it lasts, and once more
	//after it dies: the cached value still carries its contribution
	if (dlit || e->light_dlit)
		resample = TRUE;
	else if (!e->light_valid)
		resample = TRUE;
	else
	{
		HLVecSub(e->origin, e->light_org, delta);

		if (HLVecLength(delta) > HLENT_LIGHT_SLOP)
			resample = TRUE;
		//every lightstyle on the face the sample landed on, folded. One style
		//index does not identify what can change the sample
		else if (e->light_style >= 0 &&
			hl_light_pt_key != e->light_style_val)
			resample = TRUE;
	}

	if (!resample)
		return e->light_value;

	e->light_value     = HLLightPoint(map, e->origin);
	e->light_style     = hl_light_pt_key;	//-1 when no lit face was found
	e->light_style_val = hl_light_pt_key;

	HLVecCopy(e->origin, e->light_org);
	e->light_dlit  = dlit;
	e->light_valid = TRUE;

	return e->light_value;
}

U8 *HLEntModelForClass(U8 *classname)
{//classname to model path, standing in for the precache the game DLL would
 //normally do. HL point entities carry no "model" key - the class decides it
 //in code, so without that code the mapping has to live somewhere
 //
 //a comparison chain, not a NUL-separated table: adjacent-literal
 //concatenation in ZealC is length-based and truncates at the first embedded
 //\0, which collapses such a table to one entry and walks off into the heap
	if (!StrCompare(classname, "monster_scientist"))
		return "models/scientist.mdl";

	//CSittingScientist and CDeadScientist are separate classes on the same
	//model; the prop pass in HLAI.ZC gives each its own sequence
	if (!StrCompare(classname, "monster_sitting_scientist"))
		return "models/scientist.mdl";
	if (!StrCompare(classname, "monster_scientist_dead"))
		return "models/scientist.mdl";

	if (!StrCompare(classname, "monster_barney"))	return "models/barney.mdl";
	if (!StrCompare(classname, "monster_barney_dead"))
		return "models/barney.mdl";
	if (!StrCompare(classname, "monster_hgrunt_dead"))
		return "models/hgrunt.mdl";

	//CDeadHEV wears the player model, which is where its dead* poses live
	if (!StrCompare(classname, "monster_hevsuit_dead"))
		return "models/player.mdl";

	if (!StrCompare(classname, "monster_gman"))		return "models/gman.mdl";
	if (!StrCompare(classname, "monster_barnacle"))
		return "models/barnacle.mdl";
	if (!StrCompare(classname, "monster_tripmine"))
		return "models/v_tripmine.mdl";
	if (!StrCompare(classname, "monster_sentry"))
		return "models/sentry.mdl";
	if (!StrCompare(classname, "monster_cockroach"))
		return "models/roach.mdl";
	if (!StrCompare(classname, "monster_headcrab"))	return "models/headcrab.mdl";
	if (!StrCompare(classname, "monster_zombie"))	return "models/zombie.mdl";
	if (!StrCompare(classname, "monster_houndeye"))	return "models/houndeye.mdl";
	if (!StrCompare(classname, "monster_alien_slave"))
		return "models/islave.mdl";
	if (!StrCompare(classname, "monster_alien_grunt"))
		return "models/agrunt.mdl";
	if (!StrCompare(classname, "monster_human_grunt"))
		return "models/hgrunt.mdl";
	if (!StrCompare(classname, "monster_bullchicken"))
		return "models/bullsquid.mdl";
	if (!StrCompare(classname, "monster_human_assassin"))
		return "models/hassassin.mdl";
	if (!StrCompare(classname, "monster_alien_controller"))
		return "models/controller.mdl";
	if (!StrCompare(classname, "monster_gargantua"))	return "models/garg.mdl";
	if (!StrCompare(classname, "monster_snark"))	return "models/w_squeak.mdl";
	if (!StrCompare(classname, "monster_leech"))	return "models/leech.mdl";
	if (!StrCompare(classname, "monster_ichthyosaur"))
		return "models/icky.mdl";

	if (!StrCompare(classname, "item_healthkit"))
		return "models/w_medkit.mdl";
	if (!StrCompare(classname, "item_battery"))	return "models/w_battery.mdl";
	if (!StrCompare(classname, "item_suit"))	return "models/w_suit.mdl";
	if (!StrCompare(classname, "item_longjump"))
		return "models/w_longjump.mdl";

	//items.cpp:266 and :290. Both reached only through world_items, which
	//HLEntParse renames before this pass runs
	if (!StrCompare(classname, "item_antidote"))
		return "models/w_antidote.mdl";
	if (!StrCompare(classname, "item_security"))
		return "models/w_security.mdl";

	//CItemSoda::Spawn, effects.cpp:2227. env_beverage dispenses these
	if (!StrCompare(classname, "item_sodacan"))
		return "models/can.mdl";

	//Xen flora, dlls/xen.cpp. 184 ship across c4a1-c4a3 and 177 of them carry
	//no "model" key at all, so without this table they draw nothing.
	//CXenSpore picks its model off pev->skin, which each subclass sets before
	//calling the base Spawn (xen.cpp:491, :497, :519 against pModelNames at
	//:545); the parentheses are part of the shipped filenames
	if (!StrCompare(classname, "xen_plantlight"))	return "models/light.mdl";
	if (!StrCompare(classname, "xen_hair"))			return "models/hair.mdl";
	if (!StrCompare(classname, "xen_tree"))			return "models/tree.mdl";
	if (!StrCompare(classname, "xen_spore_small"))
		return "models/fungus(small).mdl";
	if (!StrCompare(classname, "xen_spore_medium"))	return "models/fungus.mdl";
	if (!StrCompare(classname, "xen_spore_large"))
		return "models/fungus(large).mdl";

	if (!StrCompare(classname, "weapon_crowbar"))	return "models/w_crowbar.mdl";
	if (!StrCompare(classname, "weapon_9mmhandgun"))
		return "models/w_9mmhandgun.mdl";
	if (!StrCompare(classname, "weapon_357"))	return "models/w_357.mdl";
	if (!StrCompare(classname, "weapon_9mmAR"))	return "models/w_9mmAR.mdl";
	if (!StrCompare(classname, "weapon_shotgun"))	return "models/w_shotgun.mdl";
	if (!StrCompare(classname, "weapon_crossbow"))	return "models/w_crossbow.mdl";
	if (!StrCompare(classname, "weapon_rpg"))	return "models/w_rpg.mdl";
	if (!StrCompare(classname, "weapon_satchel"))	return "models/w_satchel.mdl";
	if (!StrCompare(classname, "weapon_handgrenade"))
		return "models/w_grenade.mdl";
	if (!StrCompare(classname, "weapon_tripmine"))	return "models/w_tripmine.mdl";
	if (!StrCompare(classname, "weapon_egon"))	return "models/w_egon.mdl";
	if (!StrCompare(classname, "weapon_gauss"))	return "models/w_gauss.mdl";
	if (!StrCompare(classname, "ammo_9mmclip"))	return "models/w_9mmclip.mdl";
	if (!StrCompare(classname, "ammo_9mmbox"))	return "models/w_chainammo.mdl";
	if (!StrCompare(classname, "ammo_buckshot"))
		return "models/w_shotbox.mdl";
	if (!StrCompare(classname, "ammo_rpgclip"))	return "models/w_rpgammo.mdl";
	if (!StrCompare(classname, "ammo_357"))	return "models/w_357ammobox.mdl";

	//The alias classnames. weapons.cpp registers weapon_glock, weapon_mp5 and
	//weapon_python beside the 9mm/AR/357 names for the same weapon, and the
	//ammo names follow the same pair. HLWeaponFindByClass folds them onto the
	//table row; this pass keys off the raw classname and compiles before
	//HLWeapon.ZC, so the model is listed here rather than resolved.
	//
	//10 weapon_ and 127 ammo_ instances ship under these names
	if (!StrCompare(classname, "weapon_glock"))
		return "models/w_9mmhandgun.mdl";
	if (!StrCompare(classname, "weapon_mp5"))	return "models/w_9mmAR.mdl";
	if (!StrCompare(classname, "weapon_python"))	return "models/w_357.mdl";
	if (!StrCompare(classname, "ammo_glockclip"))	return "models/w_9mmclip.mdl";
	if (!StrCompare(classname, "ammo_mp5clip"))
		return "models/w_9mmARclip.mdl";
	if (!StrCompare(classname, "ammo_mp5grenades"))
		return "models/w_ARgrenade.mdl";
	if (!StrCompare(classname, "ammo_egonclip"))	return "models/w_gaussammo.mdl";

	//the rest of pSpawnObjects, func_break.cpp:37, which a breakable or a dead
	//grunt can put in the world where no mapper placed one
	if (!StrCompare(classname, "ammo_9mmAR"))
		return "models/w_9mmARclip.mdl";
	if (!StrCompare(classname, "ammo_ARgrenades"))
		return "models/w_ARgrenade.mdl";
	if (!StrCompare(classname, "ammo_crossbow"))
		return "models/w_crossbow_clip.mdl";
	if (!StrCompare(classname, "ammo_gaussclip"))
		return "models/w_gaussammo.mdl";
	if (!StrCompare(classname, "weapon_snark"))
		return "models/w_sqknest.mdl";
	if (!StrCompare(classname, "weapon_hornetgun"))
		return "models/w_hgun.mdl";

	if (!StrCompare(classname, "item_artifact_invulnerability"))
		return "progs/invulner.mdl";
	if (!StrCompare(classname, "item_artifact_super_damage"))
		return "progs/quaddama.mdl";
	if (!StrCompare(classname, "item_artifact_envirosuit"))
		return "progs/suit.mdl";
	if (!StrCompare(classname, "item_artifact_invisibility"))
		return "progs/invisibl.mdl";

	if (!StrCompare(classname, "item_armor1"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armor2"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armorInv"))	return "progs/armor.mdl";
	if (!StrCompare(classname, "item_key1"))		return "progs/w_s_key.mdl";
	if (!StrCompare(classname, "item_key2"))		return "progs/w_g_key.mdl";
	if (!StrCompare(classname, "item_backpack"))	return "progs/backpack.mdl";

	if (!StrCompare(classname, "weapon_supershotgun"))
		return "progs/g_shot.mdl";
	if (!StrCompare(classname, "weapon_nailgun"))	return "progs/g_nail.mdl";
	if (!StrCompare(classname, "weapon_supernailgun"))
		return "progs/g_nail2.mdl";
	if (!StrCompare(classname, "weapon_grenadelauncher"))
		return "progs/g_rock.mdl";
	if (!StrCompare(classname, "weapon_rocketlauncher"))
		return "progs/g_rock2.mdl";
	if (!StrCompare(classname, "weapon_lightning"))	return "progs/g_light.mdl";

	if (!StrCompare(classname, "monster_army"))		return "progs/soldier.mdl";
	if (!StrCompare(classname, "monster_dog"))		return "progs/dog.mdl";
	if (!StrCompare(classname, "monster_ogre"))		return "progs/ogre.mdl";
	if (!StrCompare(classname, "monster_knight"))	return "progs/knight.mdl";
	if (!StrCompare(classname, "monster_hell_knight"))
		return "progs/hknight.mdl";
	if (!StrCompare(classname, "monster_zombie"))	return "progs/zombie.mdl";
	if (!StrCompare(classname, "monster_wizard"))	return "progs/wizard.mdl";
	if (!StrCompare(classname, "monster_demon1"))	return "progs/demon.mdl";
	if (!StrCompare(classname, "monster_shambler"))	return "progs/shambler.mdl";
	if (!StrCompare(classname, "monster_enforcer"))	return "progs/enforcer.mdl";
	if (!StrCompare(classname, "monster_fish"))		return "progs/fish.mdl";
	if (!StrCompare(classname, "monster_tarbaby"))	return "progs/tarbaby.mdl";
	if (!StrCompare(classname, "monster_boss"))		return "progs/boss.mdl";

	return NULL;
}

//--- sprite cache -----------------------------------------------------------
//
// HLSpr.ZC has HLSprLoad and HLSprFree but no cache; the HUD loads its sheets
// once by hand and needs none. The entity world does: a map with sixty
// env_glows on the same sprites/glow01.spr would otherwise decode and hold
// sixty copies.
//
// Entities borrow from here, as they borrow from the model caches, so HLEntFree
// only NULLs the pointers.

#define HLENT_SPR_CACHE	64

class CHLEntSprSlot
{
	U8		 name[64];
	CHLSpr	*spr;
};

CHLEntSprSlot	hl_ent_spr_cache[HLENT_SPR_CACHE];
I64				hl_ent_spr_count = 0;

U0 HLEntSprCacheInit()
{//globals aren't zeroed, and this one holds pointers - a stale non-NULL here
 //is a free of something that was never allocated
	I64 i;

	for (i = 0; i < HLENT_SPR_CACHE; i++)
	{
		hl_ent_spr_cache[i].name[0] = 0;
		hl_ent_spr_cache[i].spr     = NULL;
	}

	hl_ent_spr_count = 0;
}

HLEntSprCacheInit;

U0 HLEntSprCacheFree()
{
	I64 i;

	for (i = 0; i < hl_ent_spr_count; i++)
	{
		if (hl_ent_spr_cache[i].spr)
			HLSprFree(hl_ent_spr_cache[i].spr);

		hl_ent_spr_cache[i].spr     = NULL;
		hl_ent_spr_cache[i].name[0] = 0;
	}

	hl_ent_spr_count = 0;
}

CHLSpr *HLEntSprCacheGet(U8 *name)
{//NULL when the file is missing, which is not an error - a mission pack sprite
 //in a valve-only install is a normal state
	CHLSpr	*sp;
	I64		 i;

	if (!name || !name[0])
		return NULL;

	for (i = 0; i < hl_ent_spr_count; i++)
	{
		if (!StrICompare(hl_ent_spr_cache[i].name, name))
			return hl_ent_spr_cache[i].spr;
	}

	if (hl_ent_spr_count >= HLENT_SPR_CACHE)
		return NULL;

	sp = HLSprLoad(name);

	//a miss is cached too, or a map full of one missing sprite retries the
	//whole loose-then-pak lookup once per entity
	i = hl_ent_spr_count;
	HLStrCopy(hl_ent_spr_cache[i].name, name, 64);
	hl_ent_spr_cache[i].spr = sp;
	hl_ent_spr_count        = i + 1;

	return sp;
}

//--- titles.txt -------------------------------------------------------------
//
// env_message's "message" is not the text. It is a key into valve/titles.txt,
// which the game DLL reads and the engine never sees:
//
//     <dollar>position -1 -1  <- layout directives, one per line, file scoped
//     C1A0_TRAINRIDE
//     {
//     Announcement text, one or more lines
//     }
//
// Without this an env_message displays "C1A0_TRAINRIDE" on screen.
//
// The directives set position, colour, fade and effect. HLEntTitleLook in
// HLEntity.ZC parses them into CHLTitleMsg and HLHudMsgShow honours them.
//
// A literal dollar is written as <dollar> above: the ZealC lexer runs DolDoc
// before tokenizing, so one in a comment opens a command and swallows source
// to the next one or to EOF.
//
// Braces are compared as 0x7B/0x7D rather than as character literals: a lone
// open-brace character literal unbalances this file for every brace-counting
// tool that reads it.

U8	*hl_ent_titles		= NULL;
I64	 hl_ent_titles_size	= 0;
Bool hl_ent_titles_tried	= FALSE;

U0 HLEntTitlesInit()
{
	hl_ent_titles      = NULL;
	hl_ent_titles_size = 0;
	hl_ent_titles_tried = FALSE;
}

HLEntTitlesInit;

U0 HLEntTitlesLoad()
{//once per task. the file is ~11KB and every map wants it, so it stays
	if (hl_ent_titles_tried)
		return;

	hl_ent_titles_tried = TRUE;
	hl_ent_titles       = HLFileLoad("titles.txt", &hl_ent_titles_size);

	if (!hl_ent_titles)
		"HLEnt: titles.txt missing - env_message shows its key\n";
}

Bool HLEntTitleFind(U8 *name, U8 *out, I64 max)
{//the block after a line that is exactly `name`, lines joined with newlines
	U8	*p;
	U8	*end;
	I64	 n;
	I64	 k;
	I64	 len;
	Bool matched;

	if (!out || max < 1)
		return FALSE;

	out[0] = 0;

	if (!name || !name[0])
		return FALSE;

	HLEntTitlesLoad;

	if (!hl_ent_titles)
		return FALSE;

	len = StrLen(name);
	p   = hl_ent_titles;
	end = hl_ent_titles + hl_ent_titles_size;

	while (p < end)
	{
		//p is at the start of a line. a title key is the whole line, so a
		//prefix match is not enough - C1A0_ and C1A0_TRAINRIDE both exist
		matched = FALSE;

		if (p + len <= end && !StrNICompare(p, name, len))
		{
			k = len;

			//trailing spaces and the CR of a DOS line ending do not count
			while (p + k < end && (p[k] == ' ' || p[k] == 9 || p[k] == 13))
				k++;

			if (p + k >= end || p[k] == 10)
				matched = TRUE;
		}

		//advance to the next line either way
		while (p < end && *p != 10)
			p++;
		if (p < end)
			p++;

		if (!matched)
			goto qetf_next;

		//the opening brace is on its own line, possibly after blank lines
		while (p < end && (*p == 10 || *p == 13 || *p == ' ' || *p == 9))
			p++;

		if (p >= end || *p != 0x7B)
			return FALSE;

		//skip past the brace and its line ending
		p++;
		while (p < end && *p != 10)
			p++;
		if (p < end)
			p++;

		n = 0;

		while (p < end && *p != 0x7D && n < max - 1)
		{
			//CR dropped: the centreprint drawer measures in characters and a
			//stray 13 draws as a glyph
			if (*p != 13)
			{
				out[n] = *p;
				n++;
			}

			p++;
		}

		//the last line ends with a newline before the closing brace, which
		//would draw as an empty trailing row
		while (n > 0 && (out[n - 1] == 10 || out[n - 1] == ' '))
			n--;

		out[n] = 0;

		return ToBool(n > 0);

qetf_next:
	}

	return FALSE;
}

U0 HLEntFree()
{
	I64 i;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		//all three are owned by their caches, never by the entity
		hl_entities[i].mdl    = NULL;
		hl_entities[i].studio = NULL;
		hl_entities[i].spr    = NULL;
	}

	//sprites are not shared outside the entity world, so unlike the model
	//caches this one dies with the entity table
	HLEntSprCacheFree;

	Free(hl_entities);
	hl_entities     = NULL;
	hl_num_entities = 0;
}

I64 HLEntParse(CHLMap *map)
{//ED_LoadFromFile - returns the count
	CHLEntity	*e;
	U8			*p;
	U8			*end;
	U8			 key[64];
	U8			 val[160];
	I64			 k;
	Bool		 in_block = FALSE;

	HLEntFree;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	hl_entities     = CAlloc(HLENT_MAX * sizeof(CHLEntity));
	hl_num_entities = 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_num_entities < HLENT_MAX)
	{
		if (*p == '{')
		{
			e = &hl_entities[hl_num_entities];
			e->classname[0]  = 0;
			e->model_name[0] = 0;
			e->brush_model   = -1;
			e->mdl           = NULL;
			e->studio        = NULL;
			e->frame         = 0;
			e->seq           = 0;
			e->body          = 0;
			e->skin          = 0;
			e->pose          = 0;

			//neutral is per model and the model is not resolved yet, so this
			//is only the "nothing set it" state. HLEntLoadModels overwrites it
			for (k = 0; k < HLENT_MAX_CTL; k++)
				e->controllers[k] = 0.0;

			//SetBlending has not run; the sequence's own start pose stands
			e->blending[0] = 0.0;
			e->blending[1] = 0.0;

			//CAlloc zeroed the block, but an entity slot is reused across
			//map loads, so everything with a non-zero resting value is set
			//here explicitly
			e->targetname[0] = 0;
			e->target[0]     = 0;
			e->killtarget[0] = 0;
			e->master[0]     = 0;
			e->message[0]    = 0;
			e->netname[0]    = 0;
			e->spawnflags    = 0;
			e->weapons       = 0;

			e->movetype      = HLMOVETYPE_NONE;
			e->solid         = HLSOLID_NOT;
			HLVecSet(e->velocity, 0.0, 0.0, 0.0);
			HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
			HLVecSet(e->mins, 0.0, 0.0, 0.0);
			HLVecSet(e->maxs, 0.0, 0.0, 0.0);

			e->speed         = 0.0;
			e->start_speed   = 0.0;
			e->wait          = 0.0;
			e->delay         = 0.0;
			e->lip           = 0.0;
			e->height        = 0.0;
			e->dmg           = 0.0;
			e->damage_type   = 0;
			e->damage        = 0.0;
			e->health        = 0.0;
			e->takedamage    = 0;
			e->toggle_state  = HLTS_AT_BOTTOM;
			e->ent_class     = HLC_NONE;
			e->ai_play[0]    = 0;
			e->ai_idle[0]    = 0;
			e->ai_entity[0]  = 0;
			e->ai_moveto     = 0;
			e->ai_radius     = 0.0;
			e->anim_start    = 0.0;
			e->anim_loop     = TRUE;
			e->anim_done     = FALSE;
			e->anim_event_frame = -1;
			e->move_snd      = 0;
			e->stop_snd      = 0;
			e->snd_index     = 0;
			e->volume        = 1.0;

			e->locked_snd        = 0;
			e->unlocked_snd      = 0;
			e->locked_sentence   = 0;
			e->unlocked_sentence = 0;
			e->lock_wait_snd     = 0.0;
			e->lock_wait_sent    = 0.0;
			e->lock_sent_ord     = 0;
			e->unlock_sent_ord   = 0;
			e->lock_sent_eof     = FALSE;
			e->unlock_sent_eof   = FALSE;

			e->think_fn      = 0;
			e->next_think    = 0.0;
			e->move_done     = 0;
			e->touch_fn      = 0;
			e->use_fn        = 0;
			e->blocked_fn    = 0;
			e->remove_after_fire = FALSE;

			e->owner         = -1;
			e->activator     = -1;
			e->ltime         = 0.0;

			e->rendermode    = 0;
			e->renderamt     = 0.0;
			e->renderfx      = 0;
			e->effects       = 0;
			e->style         = 0;

			//no sample yet. A reused slot in a new map must not shade its
			//model with the lighting of the room the last one stood in
			e->light_valid   = FALSE;
			e->light_dlit    = FALSE;
			e->light_value   = 0;
			e->light_style   = -1;
			e->light_style_val = 0;
			HLVecSet(e->light_org, 0.0, 0.0, 0.0);

			//effect/env_* group. same reason as the block above: CAlloc zeroed
			//the table once, but a slot is reused on the next map load, so
			//anything whose resting value is not zero is set here by hand
			e->spr            = NULL;
			e->framerate      = 10.0;	//CSprite's default, frames per second
			e->scale          = 1.0;
			e->visible        = FALSE;
			e->beam_start_name[0] = 0;
			e->beam_end_name[0]   = 0;
			e->beam_start     = -1;
			e->beam_end       = -1;
			e->beam_width     = 0.0;
			e->beam_frame     = 0;

			//zero is the SDK default for both. CLightning::Spawn
			//(effects.cpp:458) and CLaser::Spawn (effects.cpp:960) assign
			//neither, so an absent key leaves a zeroed member: no noise, no
			//scroll
			e->beam_noise     = 0.0;
			e->beam_scroll    = 0.0;

			e->beam_life      = 0.0;
			e->beam_restrike  = 0.0;
			e->beam_active    = FALSE;
			e->density        = 0;
			e->blood_color    = 247;	//BLOOD_COLOR_RED, the default
			e->blood_amount   = 0.0;
			e->gib_count      = 0;
			e->gib_left       = 0;
			e->gib_velocity   = 0.0;
			e->gib_variance   = 0.0;
			e->gib_life       = 0.0;
			e->shoot_model[0] = 0;
			e->hold_time      = 0.0;
			e->fade_in        = 0.0;
			e->fade_out       = 0.0;
			e->text_x         = -1.0;
			e->text_y         = -1.0;
			HLVecSet(e->text_color, 255.0, 255.0, 255.0);
			HLVecSet(e->text_color2, 255.0, 255.0, 255.0);
			e->radius         = 0.0;
			e->amplitude      = 0.0;
			e->frequency      = 0.0;
			e->duration       = 0.0;
			e->magnitude      = 0.0;
			e->max_delay      = 0.0;
			e->modifier       = 100.0;	//a percentage, 100 = untouched
			e->damp           = 0.0;
			e->gravity        = 0.0;
			e->roomtype       = 0;
			e->preset         = 0;
			e->distance       = 0.0;
			e->rot_amount     = 0.0;

			e->track_top[0]     = 0;
			e->track_bottom[0]  = 0;
			e->track_train[0]   = 0;
			e->track_top_ent    = -1;
			e->track_bottom_ent = -1;
			e->track_train_ent  = -1;
			e->track_code       = 0;
			e->track_target     = 0;
			e->track_use        = FALSE;
			e->train_speed      = 0.0;
			e->train_length     = 0.0;

			e->moving_angular = FALSE;
			e->momentary_frac = 0.0;
			e->rotates        = FALSE;
			e->charge         = 0.0;
			e->charge_next    = 0.0;
			e->use_last       = -1.0;

			//CBreakable's member is zeroed, so an absent key is matGlass.
			//The matWood default in func_break.cpp:84 covers out-of-range
			//values only. 26 breakables in the shipped maps carry no key
			e->material       = 0;
			e->spawn_object   = 0;
			e->item_type      = 0;

			e->cam_moveto[0]      = 0;
			e->cam_accel          = 0.0;
			e->cam_decel          = 0.0;
			e->cam_return         = 0.0;
			e->cam_stop           = 0.0;
			e->cam_move_dist      = 0.0;
			e->cam_target_speed   = 0.0;
			e->cam_initial_speed  = 0.0;
			e->cam_path           = -1;
			e->cam_target         = -1;
			e->revert_message_time = 0.0;
			e->revert_load_time    = 0.0;

			//CPushable::Spawn reads pev->friction, which ED_LoadFromFile
			//leaves zero when the key is absent: max speed 400
			e->push_friction  = 0.0;
			e->push_max_speed = 0.0;
			e->push_buoyancy  = 0.0;
			e->push_snd_time  = 0.0;
			e->push_snd_last  = 0;

			//zero means "no key". CFuncRotating::Spawn turns it into 1
			e->fan_friction   = 0.0;
			e->fan_atten      = 0.0;

			e->amb_pitch      = 0;
			e->amb_pitchstart = 0;
			e->amb_spinup     = 0;
			e->amb_spindown   = 0;
			e->amb_volstart   = 0;
			e->amb_lfotype    = 0;
			e->amb_lforate    = 0;
			e->amb_lfomodpitch = 0;
			e->amb_lfomodvol  = 0;
			e->amb_cspinup    = 0;

			e->texture[0]     = 0;
			e->next_map[0]    = 0;
			e->landmark[0]    = 0;
			e->global_state[0] = 0;
			e->global_name[0]  = 0;
			e->ai_sentence[0] = 0;
			e->ai_listener[0] = 0;
			e->ai_refire      = 0.0;
			e->ai_atten       = 0;

			//both keys that land here sit in a zeroed pev member when the
			//mapper omits them, and both read 0 as USE_OFF: CEnvGlobal::Use
			//buttons.cpp:103, CAutoTrigger::KeyValue triggers.cpp:141. Every
			//env_global in the retail maps writes triggermode, so this default
			//is only ever observed by a trigger_auto
			e->trigger_mode   = HLUSE_OFF;
			e->initial_state  = 0;

			e->in_use        = TRUE;
			e->spawned       = FALSE;
			HLVecSet(e->origin, 0.0, 0.0, 0.0);
			HLVecSet(e->angles, 0.0, 0.0, 0.0);
			in_block = TRUE;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;

				//the scan runs to the closing quote; only the copy is capped.
				//capping the scan leaves p inside the string on an overlong
				//value, and every quote after it reads as a delimiter
				while (p < end && *p != '"')
				{
					if (k < 63)
					{
						key[k] = *p;
						k++;
					}

					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;

				//scan to the closing quote, copy at most 159. the longest value
				//in a shipped map is worldspawn's "wad", 117 bytes in t0a0b.bsp
				while (p < end && *p != '"')
				{
					if (k < 159)
					{
						val[k] = *p;
						k++;
					}

					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					HLStrCopy(e->classname, val, 64);
				else if (!StrCompare(key, "model"))
					HLStrCopy(e->model_name, val, 64);
				else if (!StrCompare(key, "origin"))
					HLParseVec(val, e->origin);
				else if (!StrCompare(key, "angle"))
				{
					//"angle" is a shorthand the movers overload: -1 means
					//straight up, -2 straight down, anything else is a yaw.
					//kept raw here, HLEntSetMoveDir resolves it
					e->angles[1] = HLAtoF(val);
				}
				else if (!StrCompare(key, "angles"))
					HLParseVec(val, e->angles);
				else if (!StrCompare(key, "targetname"))
					HLStrCopy(e->targetname, val, 64);
				else if (!StrCompare(key, "target"))
					HLStrCopy(e->target, val, 64);
				else if (!StrCompare(key, "killtarget"))
					HLStrCopy(e->killtarget, val, 64);
				else if (!StrCompare(key, "master"))
					HLStrCopy(e->master, val, 64);
				else if (!StrCompare(key, "message"))
					HLStrCopy(e->message, val, 128);
				else if (!StrCompare(key, "netname"))
					HLStrCopy(e->netname, val, 64);
				else if (!StrCompare(key, "spawnflags"))
					e->spawnflags = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "weapons"))
					e->weapons = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "speed"))
					e->speed = HLAtoF(val);
				else if (!StrCompare(key, "startspeed"))
					e->start_speed = HLAtoF(val);
				else if (!StrCompare(key, "wait"))
					e->wait = HLAtoF(val);
				else if (!StrCompare(key, "delay"))
					e->delay = HLAtoF(val);
				else if (!StrCompare(key, "lip"))
					e->lip = HLAtoF(val);
				else if (!StrCompare(key, "height"))
					e->height = HLAtoF(val);
				else if (!StrCompare(key, "dmg"))
					e->dmg = HLAtoF(val);
				else if (!StrCompare(key, "damagetype"))
					e->damage_type = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "health"))
					e->health = HLAtoF(val);
				else if (!StrCompare(key, "m_iszPlay"))
					HLStrCopy(e->ai_play, val, 64);
				else if (!StrCompare(key, "m_iszIdle"))
					HLStrCopy(e->ai_idle, val, 64);
				else if (!StrCompare(key, "m_iszEntity"))
					HLStrCopy(e->ai_entity, val, 64);
				else if (!StrCompare(key, "m_fMoveTo"))
					e->ai_moveto = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "m_flRadius"))
					e->ai_radius = HLAtoF(val);
				else if (!StrCompare(key, "movesnd"))
					e->move_snd = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "stopsnd"))
					e->stop_snd = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "sounds"))
					e->snd_index = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "locked_sound"))
					e->locked_snd = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "unlocked_sound"))
					e->unlocked_snd = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "locked_sentence"))
					e->locked_sentence = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "unlocked_sentence"))
					e->unlocked_sentence = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "volume"))
					e->volume = HLAtoF(val);
				else if (!StrCompare(key, "style"))
					e->style = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "rendermode"))
					e->rendermode = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "renderamt"))
					e->renderamt = HLAtoF(val);
				else if (!StrCompare(key, "renderfx"))
					e->renderfx = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "rendercolor"))
					HLParseVec(val, e->rendercolor);
				else if (!StrCompare(key, "body"))
					e->body = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "skin"))
					e->skin = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "sequence"))
					e->seq = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "pose"))
					e->pose = ToI64(HLAtoF(val));

				//--- effect and env_* keys ---
				//
				//case is significant: the FGD spells some of these with
				//capitals and the SDK compares case sensitively (KeyValue
				//does StrCmp, not stricmp), so "MaxDelay" and "maxdelay" are
				//different keys and only the first exists in a compiled map
				else if (!StrCompare(key, "framerate"))
					e->framerate = HLAtoF(val);
				else if (!StrCompare(key, "scale"))
					e->scale = HLAtoF(val);
				else if (!StrCompare(key, "LightningStart"))
					HLStrCopy(e->beam_start_name, val, 64);
				else if (!StrCompare(key, "LightningEnd") ||
						 !StrCompare(key, "LaserTarget"))
					HLStrCopy(e->beam_end_name, val, 64);
				else if (!StrCompare(key, "BoltWidth") ||
						 !StrCompare(key, "width"))
					e->beam_width = HLAtoF(val);
				else if (!StrCompare(key, "framestart"))
					e->beam_frame = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "NoiseAmplitude"))
					e->beam_noise = HLAtoF(val);
				else if (!StrCompare(key, "TextureScroll"))
					e->beam_scroll = HLAtoF(val);
				else if (!StrCompare(key, "holdtime"))
					e->hold_time = HLAtoF(val);
				else if (!StrCompare(key, "fadein"))
					e->fade_in = HLAtoF(val);
				else if (!StrCompare(key, "fadeout"))
					e->fade_out = HLAtoF(val);
				else if (!StrCompare(key, "x"))
					e->text_x = HLAtoF(val);
				else if (!StrCompare(key, "y"))
					e->text_y = HLAtoF(val);
				else if (!StrCompare(key, "radius"))
					e->radius = HLAtoF(val);
				else if (!StrCompare(key, "amplitude"))
					e->amplitude = HLAtoF(val);
				else if (!StrCompare(key, "frequency"))
					e->frequency = HLAtoF(val);
				else if (!StrCompare(key, "duration"))
					e->duration = HLAtoF(val);
				else if (!StrCompare(key, "iMagnitude"))
					e->magnitude = HLAtoF(val);
				else if (!StrCompare(key, "MaxDelay"))
					e->max_delay = HLAtoF(val);
				else if (!StrCompare(key, "modifier"))
					e->modifier = HLAtoF(val);
				else if (!StrCompare(key, "damp"))
					e->damp = HLAtoF(val);
				else if (!StrCompare(key, "gravity"))
					e->gravity = HLAtoF(val);
				else if (!StrCompare(key, "material"))
				{
					//CBreakable::KeyValue, func_break.cpp:83-84. Anything
					//outside 0..matLastMaterial-1 lands on matWood
					e->material = ToI64(HLAtoF(val));

					if (e->material < 0 || e->material > 9)
						e->material = 1;
				}
				else if (!StrCompare(key, "spawnobject"))
					e->spawn_object = ToI64(HLAtoF(val));

				//--- trigger_camera, CTriggerCamera::KeyValue, triggers.cpp:2223 ---
				else if (!StrCompare(key, "moveto"))
					HLStrCopy(e->cam_moveto, val, 64);
				else if (!StrCompare(key, "acceleration"))
					e->cam_accel = HLAtoF(val);
				else if (!StrCompare(key, "deceleration"))
					e->cam_decel = HLAtoF(val);

				//--- player_loadsaved, CRevertSaved::KeyValue, player.cpp:4989 ---
				else if (!StrCompare(key, "messagetime"))
					e->revert_message_time = HLAtoF(val);
				else if (!StrCompare(key, "loadtime"))
					e->revert_load_time = HLAtoF(val);

				else if (!StrCompare(key, "type"))
					e->item_type = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "roomtype"))
					e->roomtype = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "preset"))
					e->preset = ToI64(HLAtoF(val));

				//--- func_pushable, CPushable::KeyValue ---
				//
				//"friction" is pev->friction, func_break.cpp:832; "buoyancy"
				//is pev->skin, func_break.cpp:886. The "size" key selects a
				//player-hull bbox and is dropped: this port keeps a pushable
				//on its brush hull, see HLEntSpawnPushable
				else if (!StrCompare(key, "friction"))
					e->push_friction = HLAtoF(val);
				else if (!StrCompare(key, "buoyancy"))
					e->push_buoyancy = HLAtoF(val);

				//--- func_rotating ---
				//dlls/bmodels.cpp:319 divides by 100 at parse
				else if (!StrCompare(key, "fanfriction"))
					e->fan_friction = HLAtoF(val) / 100.0;

				//--- ambient_generic modulation ---
				//raw; HLSndAmbientAddEx owns the clamps
				else if (!StrCompare(key, "pitch"))
					e->amb_pitch = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "pitchstart"))
					e->amb_pitchstart = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "spinup"))
					e->amb_spinup = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "spindown"))
					e->amb_spindown = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "volstart"))
					e->amb_volstart = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "lfotype"))
					e->amb_lfotype = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "lforate"))
					e->amb_lforate = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "lfomodpitch"))
					e->amb_lfomodpitch = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "lfomodvol"))
					e->amb_lfomodvol = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "cspinup"))
					e->amb_cspinup = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "distance"))
					e->distance = HLAtoF(val);
				else if (!StrCompare(key, "rotation"))
					e->rot_amount = HLAtoF(val);
				else if (!StrCompare(key, "toptrack"))
					HLStrCopy(e->track_top, val, 64);
				else if (!StrCompare(key, "bottomtrack"))
					HLStrCopy(e->track_bottom, val, 64);
				else if (!StrCompare(key, "train"))
					HLStrCopy(e->track_train, val, 64);
				//CFuncTrackTrain::KeyValue, plats.cpp:960
				else if (!StrCompare(key, "wheels"))
					e->train_length = HLAtoF(val);
				else if (!StrCompare(key, "texture"))
					HLStrCopy(e->texture, val, 64);
				else if (!StrCompare(key, "map"))
					HLStrCopy(e->next_map, val, 64);
				else if (!StrCompare(key, "landmark"))
					HLStrCopy(e->landmark, val, 64);
				else if (!StrCompare(key, "globalstate"))
					HLStrCopy(e->global_state, val, 64);
				else if (!StrCompare(key, "globalname"))
					HLStrCopy(e->global_name, val, 64);
				else if (!StrCompare(key, "sentence"))
					HLStrCopy(e->ai_sentence, val, 64);
				else if (!StrCompare(key, "listener"))
					HLStrCopy(e->ai_listener, val, 64);
				else if (!StrCompare(key, "refire"))
					e->ai_refire = HLAtoF(val);
				else if (!StrCompare(key, "attenuation"))
					e->ai_atten = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "triggermode"))
					e->trigger_mode = ToI64(HLAtoF(val));

				//--- trigger_auto ---
				//CAutoTrigger::KeyValue, triggers.cpp:141: 0 is USE_OFF, 2 is
				//USE_TOGGLE, every other value USE_ON. HLUSE_OFF is 0, so that
				//case needs no remap.
				else if (!StrCompare(key, "triggerstate"))
				{
					e->trigger_mode = ToI64(HLAtoF(val));

					if (e->trigger_mode == 2)
						e->trigger_mode = HLUSE_TOGGLE;
					else if (e->trigger_mode != 0)
						e->trigger_mode = HLUSE_ON;
				}
				else if (!StrCompare(key, "initialstate"))
					e->initial_state = ToI64(HLAtoF(val));

				//--- env_bubbles ---
				//"frequency" is parsed above, shared with env_shake.
				else if (!StrCompare(key, "density"))
					e->density = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "current"))
				{
					//CBubbling::KeyValue puts this in pev->speed, and Spawn then
					//packs it into rendercolor for the client. Kept as a speed
					//here - there is no client to pack it for
					e->speed = HLAtoF(val);
				}

				//--- env_blood and game_text share "color" ---
				//
				//CBlood::KeyValue maps 1 to BLOOD_COLOR_YELLOW and everything
				//else to BLOOD_COLOR_RED (effects.cpp:1759), so its value is a
				//selector. CGameText::KeyValue reads the same key name as an
				//RGB triple (maprules.cpp:275).
				//
				//Both readings are taken off the one key rather than branching
				//on classname: "classname" is the LAST key in the block on both
				//shipped entities that carry "color", so no branch on it can be
				//taken here. The two fields are disjoint - env_blood never draws
				//text, and a game_text triple reads as neither 1 nor 0 and lands
				//on the red it already defaults to
				else if (!StrCompare(key, "color"))
				{
					if (HLAtoF(val) == 1.0)
						e->blood_color = 195;	//BLOOD_COLOR_YELLOW
					else
						e->blood_color = 247;	//BLOOD_COLOR_RED

					HLParseVec(val, e->text_color);
				}
				else if (!StrCompare(key, "color2"))
					HLParseVec(val, e->text_color2);
				else if (!StrCompare(key, "amount"))
					e->blood_amount = HLAtoF(val);

				//--- gibshooter / env_shooter ---
				else if (!StrCompare(key, "m_iGibs"))
					e->gib_count = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "m_flVelocity"))
					e->gib_velocity = HLAtoF(val);
				else if (!StrCompare(key, "m_flVariance"))
					e->gib_variance = HLAtoF(val);
				else if (!StrCompare(key, "m_flGibLife"))
					e->gib_life = HLAtoF(val);
				else if (!StrCompare(key, "shootmodel"))
					HLStrCopy(e->shoot_model, val, 64);

				//--- env_beam / env_laser ---
				else if (!StrCompare(key, "life"))
					e->beam_life = HLAtoF(val);
				else if (!StrCompare(key, "StrikeTime"))
					e->beam_restrike = HLAtoF(val);
				else if (!StrCompare(key, "damage"))
				{
					//CLaser and CLightning both spell beam damage "damage".
					//trigger_hurt's is "dmg" and is a different field
					e->damage = HLAtoF(val);
				}
				else if (!StrCompare(key, "Radius"))
				{
					//env_beam's strike radius. Capitalised, and so a different
					//key from env_shake's lowercase "radius"
					e->radius = HLAtoF(val);
				}

				//not parsed, and why:
				//
				//  spawnorigin        func_rotating's rotation centre when it
				//                     is not the brush origin, bmodels.cpp:332.
				//                     HLTraceHullRotated turns about the origin,
				//                     so honouring this would move the hull away
				//                     from the brush. 94 of the 97 shipped uses
				//                     are "0 0 0", which bmodels.cpp:336 rejects
				//                     as the null vector anyway
				//  channel            game_text's HUD slot, maprules.cpp:257.
				//                     HLHudMsgShow holds one message, so every
				//                     channel resolves to the same slot. One
				//                     entity in the shipped maps sets the key
			}

			if (in_block && e->classname[0])
			{
				//"*N" is an inline bsp model
				if (e->model_name[0] == '*')
					e->brush_model = ToI64(HLAtoF(e->model_name + 1));

				//CWorldItem::Spawn, items.cpp:55, is a shim that creates the
				//item its "type" names and removes itself. Renamed in place
				//here rather than at spawn: HLEntLoadModels runs first and
				//resolves the model off the classname
				if (!StrCompare(e->classname, "world_items"))
				{
					if (e->item_type == 42)
						HLStrCopy(e->classname, "item_antidote", 64);
					else if (e->item_type == 43)
						HLStrCopy(e->classname, "item_security", 64);
					else if (e->item_type == 44)
						HLStrCopy(e->classname, "item_battery", 64);
					else if (e->item_type == 45)
						HLStrCopy(e->classname, "item_suit", 64);
				}

				hl_num_entities++;
			}

			in_block = FALSE;
		}

		if (p < end)
			p++;
	}

	return hl_num_entities;
}

U0 HLEntInitBoneControllers(CHLEntity *e)
{//CBaseAnimating::InitBoneControllers - SetController(0..3, 0.0)
 //
 //the raw settings are not neutral at zero. scientist.mdl channel 0 is bone 20
 //over -60..60 degrees, so a raw zero holds every scientist's head 60 degrees
 //round; barney is the same and hgrunt runs to 70. HLStudioCtlSetting maps the
 //world value the SDK asks for onto the raw setting HLStudioDraw wants.
 //
 //the mouth stays at zero: channel 4 is a 0..N range whose start is closed
	F64 setting;
	I64 c;

	for (c = 0; c < HLENT_MAX_CTL; c++)
		e->controllers[c] = 0.0;

	if (!e->studio)
		return;

	for (c = 0; c < 4; c++)
	{
		setting = HLStudioCtlSetting(e->studio, c, 0.0);

		//-1 means the model carries no such channel, and zero is as good a
		//setting as any for a channel nothing reads
		if (setting >= 0.0)
			e->controllers[c] = setting;
	}
}

I64 HLEntLoadModels()
{//resolve models for point entities. both caches share, so the map's forty
 //scientists cost one model between them
	CHLEntity	*e;
	U8			*path;
	I64			 n;
	I64			 i;
	I64			 loaded = 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (e->brush_model >= 0 || e->mdl || e->studio || e->spr)
			goto qel_next;

		//a mapper-placed model (cycler, env_sprite, monster_generic) names it
		//outright. otherwise fall back to the class table
		path = e->model_name;

		if (!path[0] || path[0] == '*')
			path = HLEntModelForClass(e->classname);

		if (!path)
			goto qel_next;

		n = StrLen(path);

		//.spr before .mdl: env_sprite, env_glow and cycler_sprite all put a
		//sprite path in the "model" key, and nothing else in the entity world
		//loads one. resolved here rather than at spawn - this pass owns turning
		//a model key into a loaded model
		if (n >= 5 && !StrICompare(path + n - 4, ".spr"))
		{
			e->spr = HLEntSprCacheGet(path);

			if (e->spr)
				loaded++;

			goto qel_next;
		}

		//.mdl only, some items are brush models in their own .bsp
		if (n < 5 || StrICompare(path + n - 4, ".mdl"))
			goto qel_next;

		//IDST first: everything in HL is a studio model. IDPO is the inherited
		//Quake alias path
		e->studio = HLStudioCacheGet(path);

		if (e->studio)
		{
			HLEntInitBoneControllers(e);
			loaded++;
			goto qel_next;
		}

		e->mdl = HLMdlCacheGet(path);
		if (e->mdl)
			loaded++;

qel_next:
	}

	return loaded;
}

Bool HLEntFindPlayerStart(F64 *origin, F64 *angles)
{//info_player_start. the map is not consulted - the entity list was already
 //parsed out of it
	I64 i;

	HLVecSet(origin, 0.0, 0.0, 0.0);
	HLVecSet(angles, 0.0, 0.0, 0.0);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!StrCompare(hl_entities[i].classname, "info_player_start"))
		{
			//this is the origin, not the eye - the caller adds view height
			HLVecCopy(hl_entities[i].origin, origin);
			HLVecCopy(hl_entities[i].angles, angles);
			return TRUE;
		}
	}

	return FALSE;
}

//--- SOLID_SLIDEBOX clipping hook -------------------------------------------
//
// SV_ClipToLinks clips a move against every solid edict, boxes included. The
// port's HLTraceEntity lives in HLClip.ZC and clips the world, QuakeC edicts
// and SOLID_BSP native brushes only, so monsters and the player pass through
// each other. The box pass needs the monster table, which is HLEntity.ZC's,
// and HLEntity.ZC compiles after HLClip.ZC - so the body arrives through this
// pointer, the same backward-call idiom as hl_hud_weapon_hook in HLHud.ZC.
//
// Installed by HLEntity.ZC. HLTraceEntity calls it last, after the world and
// the brush passes, and only when the caller did not ask for nomonsters.

//which native entity is doing the moving, so the sweep does not clip against
//its own box. -1 means the player is the mover, which is what every trace
//outside the monster mover wants: HLAI.ZC raises it around its own moves and
//lowers it again, and a hitscan leaves it alone so bullets stop on monsters
I64 hl_ent_clip_ignore = -1;

U0 (*hl_ent_slidebox_hook)(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace) = NULL;

//a declaration initialiser on a global does not run, so both are set here
hl_ent_clip_ignore    = -1;
hl_ent_slidebox_hook  = NULL;
