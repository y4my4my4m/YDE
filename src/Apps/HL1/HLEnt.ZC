CHLEntity	*hl_entities		= NULL;
I64			 hl_num_entities	= 0;

#define HLENT_LIGHT_SLOP	4.0

I64 HLEntLightPoint(CHLMap *map, CHLEntity *e)
{
	F64	 delta[3];
	Bool dlit;
	Bool resample;

	if (!e)
		return HLLIGHT_FALLBACK;

	dlit     = HLDlightNear(e->origin, hl_light_time);
	resample = FALSE;

	if (dlit || e->light_dlit)
		resample = TRUE;
	else if (!e->light_valid)
		resample = TRUE;
	else
	{
		HLVecSub(e->origin, e->light_org, delta);

		if (HLVecLength(delta) > HLENT_LIGHT_SLOP)
			resample = TRUE;
		else if (e->light_style >= 0 &&
			hl_light_pt_key != e->light_style_val)
			resample = TRUE;
	}

	if (!resample)
		return e->light_value;

	e->light_value     = HLLightPoint(map, e->origin);
	e->light_style     = hl_light_pt_key;	//-1 when no lit face was found
	e->light_style_val = hl_light_pt_key;

	HLVecCopy(e->origin, e->light_org);
	e->light_dlit  = dlit;
	e->light_valid = TRUE;

	return e->light_value;
}

