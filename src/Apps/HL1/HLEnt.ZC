// HLEnt.ZC - ED_LoadFromFile, entity lump parsing and static spawning
//
// the lump is brace-delimited quoted key/value text sliced out of the map
// buffer, not NUL terminated - every scan is bounded by an end pointer
//
//   brush entities  "model" "*N", index into the bsp's model list
//   point entities  origin only, model normally comes from progs precache
//
// NOTE: no QuakeC VM yet, so point entities get their model from the table
// below and everything spawns in its rest pose

#define HLENT_MAX	1024

//--- entity state ----------------------------------------------------------
//
// The SDK's entvars_t plus the CBaseToggle state a mover needs, flattened.
// HL keeps entvars (engine-visible) separate from the C++ class instance
// (game-only); with the game compiled in there is no boundary to maintain, so
// this is one struct.
//
// Behaviour lives in HLEntity.ZC. This file only parses and resolves models,
// because it compiles before the traces the movers need.

//movetypes. these used to live in HLGame.ZC with the rest of the QuakeC
//glue; the native entities need them and compile first
#define HLMOVETYPE_NONE			0
#define HLMOVETYPE_ANGLENOCLIP	1
#define HLMOVETYPE_ANGLECLIP		2
#define HLMOVETYPE_WALK			3
#define HLMOVETYPE_STEP			4
#define HLMOVETYPE_FLY			5
#define HLMOVETYPE_TOSS			6
#define HLMOVETYPE_PUSH			7
#define HLMOVETYPE_NOCLIP		8
#define HLMOVETYPE_FLYMISSILE	9
#define HLMOVETYPE_BOUNCE		10

//Which class spawned an entity. The SDK asks this with dynamic_cast and
//virtual overrides; here the behaviour is shared and only a handful of places
//need to tell two movers apart - func_train offsets its destination by its
//own mins, func_tracktrain does not, and that is the whole difference between
//riding the tram and watching it slide half a car off the rails.
#define HLC_NONE			0
#define HLC_DOOR			1
#define HLC_BUTTON			2
#define HLC_TRAIN			3
#define HLC_TRACKTRAIN		4
#define HLC_PLAT			5
#define HLC_PATH			6
#define HLC_TRIGGER			7
#define HLC_WALL			8
#define HLC_LIGHT			9
#define HLC_MANAGER			10

//solid types
#define HLSOLID_NOT			0
#define HLSOLID_TRIGGER		1
#define HLSOLID_BBOX			2
#define HLSOLID_SLIDEBOX		3
#define HLSOLID_BSP			4

//toggle_state - CBaseToggle. a door at rest is AT_TOP or AT_BOTTOM, never
//in between; the two GOING states own the interval
#define HLTS_AT_TOP			0
#define HLTS_AT_BOTTOM		1
#define HLTS_GOING_UP		2
#define HLTS_GOING_DOWN		3

//USE_TYPE. SET carries a value, the rest do not
#define HLUSE_OFF			0
#define HLUSE_ON				1
#define HLUSE_SET			2
#define HLUSE_TOGGLE			3

class CHLEntity
{
	U8		 classname[64];
	U8		 model_name[64];	//raw "model" value, "*N" for brush models
	F64		 origin[3];
	F64		 angles[3];
	I64			 brush_model;	//BSP model index, or -1
	CHLMdl		*mdl;			//resolved IDPO alias model, or NULL
	CHLStudio	*studio;		//resolved IDST studio model, or NULL
	I64			 frame;

	//studio playback. without a VM nothing drives these, so everything plays
	//its first sequence on the wall clock - enough to see a map populated
	I64			 seq;
	I64			 body;
	I64			 skin;

	//--- targeting ---
	U8		 targetname[64];
	U8		 target[64];
	U8		 killtarget[64];
	U8		 master[64];		//a multisource/button that must be on first
	U8		 message[128];
	U8		 netname[64];
	I64		 spawnflags;

	//--- physics ---
	I64		 movetype;
	I64		 solid;
	F64		 velocity[3];
	F64		 avelocity[3];		//degrees per second
	F64		 mins[3];			//model relative
	F64		 maxs[3];
	F64		 absmin[3];			//world space, rebuilt on every move
	F64		 absmax[3];
	F64		 size[3];

	//--- mover state ---
	F64		 speed;
	F64		 wait;
	F64		 delay;
	F64		 lip;
	F64		 height;
	F64		 dmg;
	F64		 damage;
	F64		 health;
	F64		 max_health;
	I64		 takedamage;
	I64		 toggle_state;
	I64		 ent_class;			//HLC_*, set by the spawn function
	F64		 position1[3];		//retracted
	F64		 position2[3];		//extended
	F64		 angle1[3];			//rotating doors, same idea
	F64		 angle2[3];
	F64		 finaldest[3];
	F64		 finalangle[3];
	F64		 move_dir[3];		//the axis "angle" resolved to a unit vector

	//--- scheduling ---
	//methods are integer ids dispatched through a switch, not function
	//pointers: the dispatcher can then be defined after every implementation,
	//which a single-pass compiler needs
	I64		 think_fn;
	F64		 next_think;		//absolute game time, 0 = never
	I64		 move_done;			//fires when a linear/angular move arrives
	I64		 touch_fn;
	I64		 use_fn;
	I64		 blocked_fn;

	I64		 owner;				//entity index, -1 for none
	I64		 activator;			//who last used this, for target chains
	F64		 ltime;				//pusher local time
	F64		 pain_finished;

	//--- render ---
	I64		 rendermode;
	F64		 renderamt;
	F64		 rendercolor[3];
	I64		 renderfx;
	I64		 effects;
	I64		 style;				//lightstyle for light entities

	Bool	 in_use;
	Bool	 spawned;			//its class function has run
};

CHLEntity	*hl_entities		= NULL;
I64			 hl_num_entities	= 0;

U8 *HLEntModelForClass(U8 *classname)
{//classname to model path, standing in for the precache the game DLL would
 //normally do. HL point entities carry no "model" key - the class decides it
 //in code, so without that code the mapping has to live somewhere
 //
 //HACK: a comparison chain, not a NUL-separated table - adjacent-literal
 //concatenation is length-based and truncates at the first embedded \0, so
 //the table collapsed to one entry and the walk ran off into the heap
	if (!StrCompare(classname, "monster_scientist"))
		return "models/scientist.mdl";
	if (!StrCompare(classname, "monster_barney"))	return "models/barney.mdl";
	if (!StrCompare(classname, "monster_headcrab"))	return "models/headcrab.mdl";
	if (!StrCompare(classname, "monster_zombie"))	return "models/zombie.mdl";
	if (!StrCompare(classname, "monster_houndeye"))	return "models/houndeye.mdl";
	if (!StrCompare(classname, "monster_alien_slave"))
		return "models/islave.mdl";
	if (!StrCompare(classname, "monster_alien_grunt"))
		return "models/agrunt.mdl";
	if (!StrCompare(classname, "monster_human_grunt"))
		return "models/hgrunt.mdl";
	if (!StrCompare(classname, "monster_bullchicken"))
		return "models/bullsquid.mdl";
	if (!StrCompare(classname, "monster_human_assassin"))
		return "models/hassassin.mdl";
	if (!StrCompare(classname, "monster_alien_controller"))
		return "models/controller.mdl";
	if (!StrCompare(classname, "monster_gargantua"))	return "models/garg.mdl";
	if (!StrCompare(classname, "monster_snark"))	return "models/w_squeak.mdl";
	if (!StrCompare(classname, "monster_leech"))	return "models/leech.mdl";
	if (!StrCompare(classname, "monster_ichthyosaur"))
		return "models/icky.mdl";

	if (!StrCompare(classname, "item_healthkit"))
		return "models/w_medkit.mdl";
	if (!StrCompare(classname, "item_battery"))	return "models/w_battery.mdl";
	if (!StrCompare(classname, "item_suit"))	return "models/w_suit.mdl";
	if (!StrCompare(classname, "item_longjump"))
		return "models/w_longjump.mdl";

	if (!StrCompare(classname, "weapon_crowbar"))	return "models/w_crowbar.mdl";
	if (!StrCompare(classname, "weapon_9mmhandgun"))
		return "models/w_9mmhandgun.mdl";
	if (!StrCompare(classname, "weapon_357"))	return "models/w_357.mdl";
	if (!StrCompare(classname, "weapon_9mmAR"))	return "models/w_9mmAR.mdl";
	if (!StrCompare(classname, "weapon_shotgun"))	return "models/w_shotgun.mdl";
	if (!StrCompare(classname, "weapon_crossbow"))	return "models/w_crossbow.mdl";
	if (!StrCompare(classname, "weapon_rpg"))	return "models/w_rpg.mdl";
	if (!StrCompare(classname, "weapon_satchel"))	return "models/w_satchel.mdl";
	if (!StrCompare(classname, "weapon_handgrenade"))
		return "models/w_grenade.mdl";
	if (!StrCompare(classname, "weapon_tripmine"))	return "models/w_tripmine.mdl";
	if (!StrCompare(classname, "weapon_egon"))	return "models/w_egon.mdl";
	if (!StrCompare(classname, "weapon_gauss"))	return "models/w_gauss.mdl";
	if (!StrCompare(classname, "ammo_9mmclip"))	return "models/w_9mmclip.mdl";
	if (!StrCompare(classname, "ammo_9mmbox"))	return "models/w_chainammo.mdl";
	if (!StrCompare(classname, "ammo_buckshot"))
		return "models/w_shotbox.mdl";
	if (!StrCompare(classname, "ammo_rpgclip"))	return "models/w_rpgammo.mdl";
	if (!StrCompare(classname, "ammo_357"))	return "models/w_357ammobox.mdl";

	if (!StrCompare(classname, "item_artifact_invulnerability"))
		return "progs/invulner.mdl";
	if (!StrCompare(classname, "item_artifact_super_damage"))
		return "progs/quaddama.mdl";
	if (!StrCompare(classname, "item_artifact_envirosuit"))
		return "progs/suit.mdl";
	if (!StrCompare(classname, "item_artifact_invisibility"))
		return "progs/invisibl.mdl";

	if (!StrCompare(classname, "item_armor1"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armor2"))		return "progs/armor.mdl";
	if (!StrCompare(classname, "item_armorInv"))	return "progs/armor.mdl";
	if (!StrCompare(classname, "item_key1"))		return "progs/w_s_key.mdl";
	if (!StrCompare(classname, "item_key2"))		return "progs/w_g_key.mdl";
	if (!StrCompare(classname, "item_backpack"))	return "progs/backpack.mdl";

	if (!StrCompare(classname, "weapon_supershotgun"))
		return "progs/g_shot.mdl";
	if (!StrCompare(classname, "weapon_nailgun"))	return "progs/g_nail.mdl";
	if (!StrCompare(classname, "weapon_supernailgun"))
		return "progs/g_nail2.mdl";
	if (!StrCompare(classname, "weapon_grenadelauncher"))
		return "progs/g_rock.mdl";
	if (!StrCompare(classname, "weapon_rocketlauncher"))
		return "progs/g_rock2.mdl";
	if (!StrCompare(classname, "weapon_lightning"))	return "progs/g_light.mdl";

	if (!StrCompare(classname, "monster_army"))		return "progs/soldier.mdl";
	if (!StrCompare(classname, "monster_dog"))		return "progs/dog.mdl";
	if (!StrCompare(classname, "monster_ogre"))		return "progs/ogre.mdl";
	if (!StrCompare(classname, "monster_knight"))	return "progs/knight.mdl";
	if (!StrCompare(classname, "monster_hell_knight"))
		return "progs/hknight.mdl";
	if (!StrCompare(classname, "monster_zombie"))	return "progs/zombie.mdl";
	if (!StrCompare(classname, "monster_wizard"))	return "progs/wizard.mdl";
	if (!StrCompare(classname, "monster_demon1"))	return "progs/demon.mdl";
	if (!StrCompare(classname, "monster_shambler"))	return "progs/shambler.mdl";
	if (!StrCompare(classname, "monster_enforcer"))	return "progs/enforcer.mdl";
	if (!StrCompare(classname, "monster_fish"))		return "progs/fish.mdl";
	if (!StrCompare(classname, "monster_tarbaby"))	return "progs/tarbaby.mdl";
	if (!StrCompare(classname, "monster_boss"))		return "progs/boss.mdl";

	return NULL;
}

U0 HLEntFree()
{
	I64 i;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		//both are owned by their caches, never by the entity
		hl_entities[i].mdl    = NULL;
		hl_entities[i].studio = NULL;
	}

	Free(hl_entities);
	hl_entities     = NULL;
	hl_num_entities = 0;
}

I64 HLEntParse(CHLMap *map)
{//ED_LoadFromFile - returns the count
	CHLEntity	*e;
	U8			*p;
	U8			*end;
	U8			 key[64];
	U8			 val[160];
	I64			 k;
	Bool		 in_block = FALSE;

	HLEntFree;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	hl_entities     = CAlloc(HLENT_MAX * sizeof(CHLEntity));
	hl_num_entities = 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_num_entities < HLENT_MAX)
	{
		if (*p == '{')
		{
			e = &hl_entities[hl_num_entities];
			e->classname[0]  = 0;
			e->model_name[0] = 0;
			e->brush_model   = -1;
			e->mdl           = NULL;
			e->studio        = NULL;
			e->frame         = 0;
			e->seq           = 0;
			e->body          = 0;
			e->skin          = 0;

			//CAlloc zeroed the block, but an entity slot is reused across
			//map loads, so everything with a non-zero resting value is set
			//here explicitly
			e->targetname[0] = 0;
			e->target[0]     = 0;
			e->killtarget[0] = 0;
			e->master[0]     = 0;
			e->message[0]    = 0;
			e->netname[0]    = 0;
			e->spawnflags    = 0;

			e->movetype      = HLMOVETYPE_NONE;
			e->solid         = HLSOLID_NOT;
			HLVecSet(e->velocity, 0.0, 0.0, 0.0);
			HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
			HLVecSet(e->mins, 0.0, 0.0, 0.0);
			HLVecSet(e->maxs, 0.0, 0.0, 0.0);

			e->speed         = 0.0;
			e->wait          = 0.0;
			e->delay         = 0.0;
			e->lip           = 0.0;
			e->height        = 0.0;
			e->dmg           = 0.0;
			e->health        = 0.0;
			e->takedamage    = 0;
			e->toggle_state  = HLTS_AT_BOTTOM;
			e->ent_class     = HLC_NONE;

			e->think_fn      = 0;
			e->next_think    = 0.0;
			e->move_done     = 0;
			e->touch_fn      = 0;
			e->use_fn        = 0;
			e->blocked_fn    = 0;

			e->owner         = -1;
			e->activator     = -1;
			e->ltime         = 0.0;

			e->rendermode    = 0;
			e->renderamt     = 0.0;
			e->renderfx      = 0;
			e->effects       = 0;
			e->style         = 0;

			e->in_use        = TRUE;
			e->spawned       = FALSE;
			HLVecSet(e->origin, 0.0, 0.0, 0.0);
			HLVecSet(e->angles, 0.0, 0.0, 0.0);
			in_block = TRUE;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 63)
				{
					key[k] = *p;
					k++;
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 159)
				{
					val[k] = *p;
					k++;
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					HLStrCopy(e->classname, val, 64);
				else if (!StrCompare(key, "model"))
					HLStrCopy(e->model_name, val, 64);
				else if (!StrCompare(key, "origin"))
					HLParseVec(val, e->origin);
				else if (!StrCompare(key, "angle"))
				{
					//"angle" is a shorthand the movers overload: -1 means
					//straight up, -2 straight down, anything else is a yaw.
					//kept raw here, HLEntSetMoveDir resolves it
					e->angles[1] = HLAtoF(val);
				}
				else if (!StrCompare(key, "angles"))
					HLParseVec(val, e->angles);
				else if (!StrCompare(key, "targetname"))
					HLStrCopy(e->targetname, val, 64);
				else if (!StrCompare(key, "target"))
					HLStrCopy(e->target, val, 64);
				else if (!StrCompare(key, "killtarget"))
					HLStrCopy(e->killtarget, val, 64);
				else if (!StrCompare(key, "master"))
					HLStrCopy(e->master, val, 64);
				else if (!StrCompare(key, "message"))
					HLStrCopy(e->message, val, 128);
				else if (!StrCompare(key, "netname"))
					HLStrCopy(e->netname, val, 64);
				else if (!StrCompare(key, "spawnflags"))
					e->spawnflags = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "speed"))
					e->speed = HLAtoF(val);
				else if (!StrCompare(key, "wait"))
					e->wait = HLAtoF(val);
				else if (!StrCompare(key, "delay"))
					e->delay = HLAtoF(val);
				else if (!StrCompare(key, "lip"))
					e->lip = HLAtoF(val);
				else if (!StrCompare(key, "height"))
					e->height = HLAtoF(val);
				else if (!StrCompare(key, "dmg"))
					e->dmg = HLAtoF(val);
				else if (!StrCompare(key, "health"))
					e->health = HLAtoF(val);
				else if (!StrCompare(key, "style"))
					e->style = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "rendermode"))
					e->rendermode = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "renderamt"))
					e->renderamt = HLAtoF(val);
				else if (!StrCompare(key, "renderfx"))
					e->renderfx = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "rendercolor"))
					HLParseVec(val, e->rendercolor);
				else if (!StrCompare(key, "body"))
					e->body = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "skin"))
					e->skin = ToI64(HLAtoF(val));
				else if (!StrCompare(key, "sequence"))
					e->seq = ToI64(HLAtoF(val));
			}

			if (in_block && e->classname[0])
			{
				//"*N" is an inline bsp model
				if (e->model_name[0] == '*')
					e->brush_model = ToI64(HLAtoF(e->model_name + 1));

				hl_num_entities++;
			}

			in_block = FALSE;
		}

		if (p < end)
			p++;
	}

	return hl_num_entities;
}

I64 HLEntLoadModels()
{//resolve models for point entities. both caches share, so the map's forty
 //scientists cost one model between them
	CHLEntity	*e;
	U8			*path;
	I64			 n;
	I64			 i;
	I64			 loaded = 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (e->brush_model >= 0 || e->mdl || e->studio)
			goto qel_next;

		//a mapper-placed model (cycler, env_sprite, monster_generic) names it
		//outright. otherwise fall back to the class table
		path = e->model_name;

		if (!path[0] || path[0] == '*')
			path = HLEntModelForClass(e->classname);

		if (!path)
			goto qel_next;

		n = StrLen(path);

		//.mdl only, some items are brush models in their own .bsp
		if (n < 5 || StrICompare(path + n - 4, ".mdl"))
			goto qel_next;

		//IDST first: everything in HL is a studio model, and IDPO is only
		//still here because the alias path came across with the fork
		e->studio = HLStudioCacheGet(path);

		if (e->studio)
		{
			loaded++;
			goto qel_next;
		}

		e->mdl = HLMdlCacheGet(path);
		if (e->mdl)
			loaded++;

qel_next:
	}

	return loaded;
}

Bool HLEntFindPlayerStart(F64 *origin, F64 *angles)
{//info_player_start. the map is not consulted - the entity list was already
 //parsed out of it
	I64 i;

	HLVecSet(origin, 0.0, 0.0, 0.0);
	HLVecSet(angles, 0.0, 0.0, 0.0);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!StrCompare(hl_entities[i].classname, "info_player_start"))
		{
			//this is the origin, not the eye - the caller adds view height
			HLVecCopy(hl_entities[i].origin, origin);
			HLVecCopy(hl_entities[i].angles, angles);
			return TRUE;
		}
	}

	return FALSE;
}
