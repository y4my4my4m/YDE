// Run.ZC - build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier one,
// so this order is load-bearing
//
//   HLFmt  byte readers            (no deps)
//   HLPak  archive                 -> HLFmt
//   HLWad3 WAD3 texture archives   -> HLFmt, HLPak
//   HLPal  palette/colormap        -> HLPak
//   HLMath vectors, view basis     (no deps)
//   HLBSP  map loader              -> HLFmt, HLPak
//   HLVis  PVS + traversal         -> HLMath, HLBSP
//   HLPhys collision + movement    -> HLMath, HLBSP
//   HLDraw rasterizer              -> HLMath, HLBSP, HLPal, HLVis
//   HLMDL  alias models            -> HLDraw, HLBSP
//   HLStudio studio models (IDST)  -> HLDraw, HLBSP, HLPak
//   HLProgs QuakeC bytecode VM     -> HLFmt, HLPak, HLMath
//   HLBuiltin QuakeC engine calls  -> HLProgs, HLPhys, HLMDL
//   HLEnt  entity parse + models   -> HLMath, HLBSP, HLMDL, HLStudio
//   HLEntity native entity logic   -> HLEnt, HLClip, HLDraw
//   HLNetUdp real transport         -> HLNet (+ ::/Home/Net if loaded)
//   HLNetSv server datagram/client parse -> HLNet, HLNetUdp, HLProgs, HLGame, HLVis
//   HLTest self-checks             -> everything above
//   HL1 app shell               -> everything above

Cd(__DIR__);;

#include "HLFmt"
#include "HLPak"
#include "HLWad3"
#include "HLPal"
#include "HLMath"
#include "HLNet"

// net stack is NOT loaded here - the NIC probe THROWS with no supported card,
// and drags in TCP/TLS/HTTP. RunNet.ZC loads it first, then this file; HLNetUdp
// builds real transport or stubs depending on what's already present.

#include "HLNetUdp"
#include "HLNetDgrm"
#include "HLDemo"
#include "HLBSP"
#include "HLVis"
#include "HLPhys"
#include "HLDraw"
#include "HLMDL"
#include "HLStudio"
#include "HLSpr"
#include "HLPart"
#include "HLSound"
#include "HLWad"
#include "HLProgs"
#include "HLClip"
#include "HLBuiltin"
#include "HLEnt"
#include "HLEntity"
#include "HLGame"
#include "HLNetSv"
#include "HLSave"
#include "HLPlayer"
#include "HLSbar"
#include "HLMenu"
#include "HLTest"
#include "HL1"

HL1;

//HLTest is not run here - HL1 DocClears on startup and wipes anything
//printed first. symbols stay live in this task, so run HLTest; from the
//prompt after quitting.
"\nType $$LTBLUE$$HLTest;$$FG$$ to run the data-layer self-check.\n";
