// overlay screens that sit outside the HUD
//
// HL has no status bar; its HUD is an overlay drawn by HLHud.ZC. what remains
// here is centreprint, the intermission plaque, the deathmatch scoreboard, the
// loading plaque and the crosshair, drawn inside the indexed canvas and so
// through the world palette.

#define HLSBAR_H			24
#define HLSBAR_W			320
#define HLSBAR_DIGIT_W	24

Bool hl_sbar_ready = FALSE;

CHLPic hl_pic_backtile;	//gfx.wad "backtile", the fill beside the view
CHLPic hl_pic_nums[10];
CHLPic hl_pic_minus;

CHLPic hl_pic_complete;
CHLPic hl_pic_inter;
CHLPic hl_pic_finale;
CHLPic hl_pic_loading;
CHLPic hl_pic_ranking;
CHLPic hl_pic_scorebar;
CHLPic hl_pic_colon;

U0 HLSbarInit()
{
	U8	name[24];
	I64	i;

	hl_sbar_ready = FALSE;

	HLWadPic("BACKTILE", &hl_pic_backtile);
	HLWadPic("NUM_MINUS", &hl_pic_minus);

	for (i = 0; i < 10; i++)
	{
		StrPrint(name, "NUM_%d", i);
		HLWadPic(name, &hl_pic_nums[i]);
	}

	HLWadPic("NUM_COLON", &hl_pic_colon);

	//standalone lumps, not gfx.wad entries
	HLPicLoad("gfx/complete.lmp", &hl_pic_complete);
	HLPicLoad("gfx/inter.lmp",    &hl_pic_inter);
	HLPicLoad("gfx/finale.lmp",   &hl_pic_finale);
	HLPicLoad("gfx/loading.lmp",  &hl_pic_loading);
	HLPicLoad("gfx/ranking.lmp",  &hl_pic_ranking);
	HLWadPic("SCOREBAR",          &hl_pic_scorebar);

	hl_sbar_ready = ToBool(hl_pic_backtile.pixels != NULL);
}

U0 HLSbarNumber(CHLCanvas *c, I64 x, I64 y, I64 value, I64 digits)
{
	U8		str[16];
	CHLPic	*pic;
	I64		 len;
	I64		 i;
	I64		 ch;
	I64		 draw_x;

	if (value > 999)
		value = 999;
	if (value < -99)
		value = -99;

	StrPrint(str, "%d", value);
	len = StrLen(str);

	draw_x = x + (digits - len) * HLSBAR_DIGIT_W;

	for (i = 0; i < len; i++)
	{
		ch = str[i];

		if (ch == '-')
			pic = &hl_pic_minus;
		else if ('0' <= ch <= '9')
			pic = &hl_pic_nums[ch - '0'];
		else
			pic = NULL;

		if (pic)
			HLPicDraw(c, pic, draw_x + i * HLSBAR_DIGIT_W, y);
	}
}

Bool HLIsBreak(U8 *s, I64 i)
{
	if (s[i] == '\n')
		return TRUE;

	//0x5C is backslash, as a number so it never needs escaping here
	if (s[i] == 0x5C && s[i + 1] == 'n')
		return TRUE;

	return FALSE;
}

U0 HLSbarCenterPrint(CHLCanvas *c)
{
	U8	line[128];
	I64 i = 0;
	I64 n = 0;
	I64 y;
	I64 rows = 1;
	I64 k;
	I64 remaining;

	if (!hl_center_text[0])
		return;

	if (!hl_intermission && tS > hl_center_until)
		return;

	if (hl_intermission)
		remaining = ToI64(8.0 * (tS - hl_center_start));
	else
		remaining = 9999;

	for (k = 0; hl_center_text[k]; k++)
	{
		if (HLIsBreak(hl_center_text, k))
			rows++;
	}

	if (rows <= 4)
		y = ToI64(ToF64(c->height) * 0.35);
	else
		y = 48 * c->height / 200;

	while (TRUE)
	{
		if (hl_center_text[i] == 0 || HLIsBreak(hl_center_text, i))
		{
			line[n] = 0;
			if (n)
				HLStrDrawCenter(c, y, line);

			y += HLCHAR_H;
			n  = 0;

			if (!hl_center_text[i] || remaining <= 0)
				return;

			if (hl_center_text[i] != '\n')
				i++;
		}
		else if (n < 127)
		{
			if (remaining <= 0)
			{
				line[n] = 0;
				if (n)
					HLStrDrawCenter(c, y, line);
				return;
			}

			line[n] = hl_center_text[i];
			n++;
			remaining--;
		}

		i++;
	}
}

U0 HLSbarIntermission(CHLCanvas *c, F64 level_time)
{
	I64 mins;
	I64 secs;
	I64 ox;
	I64 oy;

	if (!hl_intermission)
		return;

	if (hl_finale)
	{
		if (hl_pic_finale.pixels)
			HLPicDraw(c, &hl_pic_finale,
				(c->width - hl_pic_finale.width) / 2, 16 * c->height / 200);
		return;
	}

	mins = ToI64(level_time) / 60;
	secs = ToI64(level_time) % 60;

	//Sbar_IntermissionOverlay layout, 320x200 coords offset onto the canvas
	ox = (c->width - 320) / 2;
	if (ox < 0)
		ox = 0;
	oy = (c->height - 200) / 2;
	if (oy < 0)
		oy = 0;

	HLPicDraw(c, &hl_pic_complete, ox + 64, oy + 24);
	HLPicDraw(c, &hl_pic_inter, ox, oy + 56);

	HLSbarNumber(c, ox + 160, oy + 64, mins, 3);
	HLPicDraw(c, &hl_pic_colon, ox + 234, oy + 64);
	HLPicDraw(c, &hl_pic_nums[(secs / 10) % 10], ox + 246, oy + 64);
	HLPicDraw(c, &hl_pic_nums[secs % 10], ox + 266, oy + 64);
}

I64 HLSbarLines()
{
	return 0;
}

U0 HLSbarTileClear(CHLCanvas *c)
{
	I64 bottom = c->height - HLSbarLines;

	if (!hl_sbar_ready)
		return;

	if (c->vx > 0)
	{
		HLPicTile(c, &hl_pic_backtile, 0, 0, c->vx, bottom);
		HLPicTile(c, &hl_pic_backtile, c->vx + c->vw, 0,
			c->width - (c->vx + c->vw), bottom);
	}

	if (c->vy > 0)
	{
		HLPicTile(c, &hl_pic_backtile, c->vx, 0, c->vw, c->vy);
		HLPicTile(c, &hl_pic_backtile, c->vx, c->vy + c->vh, c->vw,
			bottom - (c->vy + c->vh));
	}
}

U0 HLSbarFill(CHLCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 color)
{
	I64	 i;
	I64	 j;
	I64	 yy;
	I64	 xx;
	U32	*row;
	U32	 argb;

	if (!c || !c->pixels || w < 1 || h < 1)
		return;

	color = color & 255;
	argb  = HLPalColor(color);

	for (j = 0; j < h; j++)
	{
		yy = y + j;
		if (yy >= 0 && yy < c->height)
		{
			row = c->pixels + yy * c->width;
			for (i = 0; i < w; i++)
			{
				xx = x + i;
				if (xx >= 0 && xx < c->width)
					row[xx] = argb;
			}
		}
	}
}

I64 HLSbarColorForMap(I64 m)
{
	return (m & 255) + 8;
}

U0 HLSbarSoloScoreboard(CHLCanvas *c)
{
	U8	line[64];
	I64	mins;
	I64	secs;
	I64	bx;
	I64	top;
	I64	len;

	if (!c)
		return;

	top = c->height - HLSBAR_H;
	bx  = (c->width - HLSBAR_W) / 2;
	if (bx < 0)
		bx = 0;

	if (hl_pic_scorebar.pixels)
		HLPicDraw(c, &hl_pic_scorebar, bx, top);

	mins = ToI64(hl_game_time) / 60;
	secs = ToI64(hl_game_time) % 60;

	StrPrint(line, "Time :%3d:%02d", mins, secs);
	HLStrDraw(c, bx + 184, top + 4, line);

	if (hl_net_level_name[0])
		HLStrCopy(line, hl_net_level_name, 64);
	else
		HLStrCopy(line, hl_map_name, 64);

	len = StrLen(line);
	HLStrDraw(c, bx + 232 - len * 4, top + 12, line);
}

U0 HLSbarDrawScoreboard(CHLCanvas *c)
{
	I64		fragsort[HLSV_MAX_CLIENTS];
	I64		n;
	I64		i;
	I64		j;
	I64		k;
	I64		tmp;
	I64		x;
	I64		y;
	I64		top;
	I64		bottom;
	I64		f;
	U8		line[40];

	if (!c)
		return;

	HLSbarSoloScoreboard(c);

	if (HLCvarGet("deathmatch") == 0.0)
		return;

	n = 0;
	for (i = 0; i < HLSV_MAX_CLIENTS; i++)
	{
		if (hl_scores[i].active && hl_scores[i].name[0])
		{
			fragsort[n] = i;
			n++;
		}
	}
	if (n < 1)
		return;

	for (i = 0; i < n; i++)
	{
		for (j = 0; j < n - 1 - i; j++)
		{
			if (hl_scores[fragsort[j]].frags < hl_scores[fragsort[j + 1]].frags)
			{
				tmp = fragsort[j];
				fragsort[j] = fragsort[j + 1];
				fragsort[j + 1] = tmp;
			}
		}
	}

	if (hl_pic_ranking.pixels)
		HLPicDraw(c, &hl_pic_ranking,
			(c->width - hl_pic_ranking.width) / 2, 8);
	else
		HLStrDrawCenterAlt(c, 8, "FRAGS");

	x = (c->width - 200) / 2;
	if (x < 8)
		x = 8;

	y = 28;
	if (hl_pic_ranking.pixels && hl_pic_ranking.height + 12 > y)
		y = hl_pic_ranking.height + 12;

	for (i = 0; i < n; i++)
	{
		k = fragsort[i];

		top    = hl_scores[k].colors & 0xF0;
		bottom = (hl_scores[k].colors & 15) << 4;
		top    = HLSbarColorForMap(top);
		bottom = HLSbarColorForMap(bottom);

		HLSbarFill(c, x, y, 40, 4, top);
		HLSbarFill(c, x, y + 4, 40, 4, bottom);

		f = hl_scores[k].frags;
		StrPrint(line, "%3d", f);
		HLStrDraw(c, x + 8, y, line);
		HLStrDraw(c, x + 64, y, hl_scores[k].name);

		y += 10;
	}
}

U0 HLSbarLoadingPlaque(CHLCanvas *c)
{//SCR_DrawLoading, centred at y=48 in the 320x200 layout
	if (!hl_pic_loading.pixels)
		return;

	HLPicDraw(c, &hl_pic_loading,
		(c->width - hl_pic_loading.width) / 2, 48 * c->height / 200);
}
