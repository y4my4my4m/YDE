// HLSbar.ZC - status bar
//
// built from the game art, not text. SBAR and IBAR are 320x24 strips, big
// digits are 24x24 pics (NUM_ health, ANUM_ ammo), icons and faces are lumps
//
// drawn inside the indexed canvas, so it goes through the world palette

#define HLSBAR_H			24
#define HLSBAR_INV_H		24		//IBAR row, sits directly above SBAR
#define HLSBAR_W			320		//the art is a fixed width strip, centred
#define HLSBAR_DIGIT_W	24
#define HLSBAR_LINES		2		//IBAR inventory above SBAR status

//.items bits, which pick the armor and ammo icons
#define HLIT_SHOTGUN			1
#define HLIT_SUPER_SHOTGUN	2
#define HLIT_NAILGUN			4
#define HLIT_SUPER_NAILGUN	8
#define HLIT_GRENADE_LAUNCHER 16
#define HLIT_ROCKET_LAUNCHER	32
#define HLIT_LIGHTNING		64
#define HLIT_ARMOR1			8192
#define HLIT_ARMOR2			16384
#define HLIT_ARMOR3			32768
#define HLIT_INVISIBILITY	524288
#define HLIT_INVULNERABILITY	1048576
#define HLIT_SUIT			2097152
#define HLIT_QUAD			4194304

Bool hl_sbar_ready = FALSE;

CHLPic hl_pic_sbar;
CHLPic hl_pic_ibar;
CHLPic hl_pic_backtile;	//gfx.wad "backtile", the fill beside the bar
CHLPic hl_pic_nums[10];
CHLPic hl_pic_anums[10];
CHLPic hl_pic_minus;
CHLPic hl_pic_faces[5];
CHLPic hl_pic_face_pain[5];
CHLPic hl_pic_armor[3];
CHLPic hl_pic_ammo[4];

//Sbar_DrawInventory art. INV_ unselected, INV2_ selected, INVA flash unused
CHLPic hl_pic_weap[2 * 7];
CHLPic hl_pic_items[6];		//keys, then the four powerups
CHLPic hl_pic_sigil[4];

//Sbar_IntermissionOverlay art
CHLPic hl_pic_complete;		//gfx/complete.lmp
CHLPic hl_pic_inter;			//gfx/inter.lmp, stat sheet background
CHLPic hl_pic_finale;			//gfx/finale.lmp
CHLPic hl_pic_loading;		//gfx/loading.lmp
CHLPic hl_pic_ranking;		//gfx/ranking.lmp, deathmatch scoreboard header
CHLPic hl_pic_scorebar;		//SCOREBAR, replaces SBAR while scores are held

//Sbar_DrawFace tests these before the health face - a powerup replaces the
//portrait rather than tinting it
CHLPic hl_pic_face_quad;
CHLPic hl_pic_face_invis;
CHLPic hl_pic_face_invuln;
CHLPic hl_pic_face_invis_invuln;
CHLPic hl_pic_colon;
CHLPic hl_pic_slash;
I64   hl_sbar_num_y = 0;	//row the small ammo digits sit on

U0 HLSbarInit()
{//resolve every pic once. a missing lump leaves a zeroed CHLPic, which the blit
 //skips, so partial art degrades instead of faulting
	U8	name[24];
	I64	i;

	hl_sbar_ready = FALSE;

	HLWadPic("SBAR", &hl_pic_sbar);
	HLWadPic("IBAR", &hl_pic_ibar);
	HLWadPic("BACKTILE", &hl_pic_backtile);
	HLWadPic("NUM_MINUS", &hl_pic_minus);

	for (i = 0; i < 10; i++)
	{
		StrPrint(name, "NUM_%d", i);
		HLWadPic(name, &hl_pic_nums[i]);

		StrPrint(name, "ANUM_%d", i);
		HLWadPic(name, &hl_pic_anums[i]);
	}

	//FACE1 healthy to FACE5 nearly dead, each with a _P pain variant
	for (i = 0; i < 5; i++)
	{
		StrPrint(name, "FACE%d", i + 1);
		HLWadPic(name, &hl_pic_faces[i]);

		StrPrint(name, "FACE_P%d", i + 1);
		HLWadPic(name, &hl_pic_face_pain[i]);
	}

	HLWadPic("FACE_QUAD",   &hl_pic_face_quad);
	HLWadPic("FACE_INVIS",  &hl_pic_face_invis);
	HLWadPic("FACE_INVUL2", &hl_pic_face_invuln);
	HLWadPic("FACE_INV2",   &hl_pic_face_invis_invuln);

	for (i = 0; i < 3; i++)
	{
		StrPrint(name, "SB_ARMOR%d", i + 1);
		HLWadPic(name, &hl_pic_armor[i]);
	}

	HLWadPic("SB_SHELLS", &hl_pic_ammo[0]);
	HLWadPic("SB_NAILS",  &hl_pic_ammo[1]);
	HLWadPic("SB_ROCKET", &hl_pic_ammo[2]);
	HLWadPic("SB_CELLS",  &hl_pic_ammo[3]);

	HLWadPic("INV_SHOTGUN",   &hl_pic_weap[0]);
	HLWadPic("INV_SSHOTGUN",  &hl_pic_weap[1]);
	HLWadPic("INV_NAILGUN",   &hl_pic_weap[2]);
	HLWadPic("INV_SNAILGUN",  &hl_pic_weap[3]);
	HLWadPic("INV_RLAUNCH",   &hl_pic_weap[4]);
	HLWadPic("INV_SRLAUNCH",  &hl_pic_weap[5]);
	HLWadPic("INV_LIGHTNG",   &hl_pic_weap[6]);

	HLWadPic("INV2_SHOTGUN",  &hl_pic_weap[7]);
	HLWadPic("INV2_SSHOTGUN", &hl_pic_weap[8]);
	HLWadPic("INV2_NAILGUN",  &hl_pic_weap[9]);
	HLWadPic("INV2_SNAILGUN", &hl_pic_weap[10]);
	HLWadPic("INV2_RLAUNCH",  &hl_pic_weap[11]);
	HLWadPic("INV2_SRLAUNCH", &hl_pic_weap[12]);
	HLWadPic("INV2_LIGHTNG",  &hl_pic_weap[13]);

	HLWadPic("SB_KEY1",  &hl_pic_items[0]);
	HLWadPic("SB_KEY2",  &hl_pic_items[1]);
	HLWadPic("SB_INVIS", &hl_pic_items[2]);
	HLWadPic("SB_INVULN",&hl_pic_items[3]);
	HLWadPic("SB_SUIT",  &hl_pic_items[4]);
	HLWadPic("SB_QUAD",  &hl_pic_items[5]);

	HLWadPic("SB_SIGIL1", &hl_pic_sigil[0]);
	HLWadPic("SB_SIGIL2", &hl_pic_sigil[1]);
	HLWadPic("SB_SIGIL3", &hl_pic_sigil[2]);
	HLWadPic("SB_SIGIL4", &hl_pic_sigil[3]);

	HLWadPic("NUM_COLON", &hl_pic_colon);
	HLWadPic("NUM_SLASH", &hl_pic_slash);

	//standalone lumps, not gfx.wad entries
	HLPicLoad("gfx/complete.lmp", &hl_pic_complete);
	HLPicLoad("gfx/inter.lmp",    &hl_pic_inter);
	HLPicLoad("gfx/finale.lmp",   &hl_pic_finale);
	HLPicLoad("gfx/loading.lmp",  &hl_pic_loading);
	HLPicLoad("gfx/ranking.lmp",  &hl_pic_ranking);
	HLWadPic("SCOREBAR",          &hl_pic_scorebar);

	hl_sbar_ready = ToBool(hl_pic_sbar.pixels != NULL);
}

U0 HLSbarNumber(CHLCanvas *c, I64 x, I64 y, I64 value, I64 digits, Bool alt)
{//right aligned big number, clamped to the field so it cannot spill into the
 //neighbouring element
	U8		str[16];
	CHLPic	*pic;
	I64		 len;
	I64		 i;
	I64		 ch;
	I64		 draw_x;

	if (value > 999)
		value = 999;
	if (value < -99)
		value = -99;

	StrPrint(str, "%d", value);
	len = StrLen(str);

	//right align inside the field
	draw_x = x + (digits - len) * HLSBAR_DIGIT_W;

	for (i = 0; i < len; i++)
	{
		ch = str[i];

		if (ch == '-')
			pic = &hl_pic_minus;
		else if ('0' <= ch <= '9')
		{
			if (alt)
				pic = &hl_pic_anums[ch - '0'];
			else
				pic = &hl_pic_nums[ch - '0'];
		}
		else
			pic = NULL;

		if (pic)
			HLPicDraw(c, pic, draw_x + i * HLSBAR_DIGIT_W, y);
	}
}

I64 HLSbarFaceIndex(I64 health)
{//FACE1 healthy, FACE5 nearly dead
	if (health >= 100)	return 0;
	if (health >= 80)	return 1;
	if (health >= 60)	return 2;
	if (health >= 40)	return 3;

	return 4;
}

Bool HLIsBreak(U8 *s, I64 i)
{//message text can arrive with the escape unprocessed, a literal backslash then
 //'n', so both forms count as a break
	if (s[i] == '\n')
		return TRUE;

	//0x5C is backslash, as a number so it never needs escaping here
	if (s[i] == 0x5C && s[i + 1] == 'n')
		return TRUE;

	return FALSE;
}

U0 HLSbarCenterPrint(CHLCanvas *c)
{//SCR_DrawCenterString. wraps on its own newlines, block at 0.35 screen height
 //or 48 when tall. during an intermission it types out at scr_printspeed, 8
 //chars a second from when the string was posted
	U8	line[128];
	I64 i = 0;
	I64 n = 0;
	I64 y;
	I64 rows = 1;
	I64 k;
	I64 remaining;

	if (!hl_center_text[0])
		return;

	//SCR_CheckDrawCenterString: no timeout during an intermission, the finale
	//text stays as long as the screen does
	if (!hl_intermission && tS > hl_center_until)
		return;

	if (hl_intermission)
		remaining = ToI64(8.0 * (tS - hl_center_start));
	else
		remaining = 9999;

	for (k = 0; hl_center_text[k]; k++)
	{
		if (HLIsBreak(hl_center_text, k))
			rows++;
	}

	//320x200 layout: a short message floats above centre, a long one pins to the
	//top for room to grow
	if (rows <= 4)
		y = ToI64(ToF64(c->height) * 0.35);
	else
		y = 48 * c->height / 200;

	while (TRUE)
	{
		if (hl_center_text[i] == 0 || HLIsBreak(hl_center_text, i))
		{
			line[n] = 0;
			if (n)
				HLStrDrawCenter(c, y, line);

			y += HLCHAR_H;
			n  = 0;

			if (!hl_center_text[i] || remaining <= 0)
				return;

			//the two char escape eats an extra byte
			if (hl_center_text[i] != '\n')
				i++;
		}
		else if (n < 127)
		{
			if (remaining <= 0)
			{
				//mid line cut, draw what has been typed
				line[n] = 0;
				if (n)
					HLStrDrawCenter(c, y, line);
				return;
			}

			line[n] = hl_center_text[i];
			n++;
			remaining--;
		}

		i++;
	}
}

U0 HLSbarIntermission(CHLCanvas *c, F64 level_time)
{//end of level screen: time, secrets, kills. single player only -
 //Sbar_IntermissionOverlay hands a deathmatch to the rankings instead, and the
 //caller makes that choice because the scoreboard is defined further down
 //
 //QuakeC parks the camera and keeps running IntermissionThink, which watches
 //button0. draw only - swallowing input here strands the player
	I64 mins;
	I64 secs;
	I64 ox;
	I64 oy;

	if (!hl_intermission)
		return;


	//Sbar_FinaleOverlay: plaque only. svc_finale routes its text through the
	//centerprint path, which owns the wrap and the typing
	if (hl_finale)
	{
		//16 rows down in the 200 row layout, scaled like the text below it, so
		//the spacing holds at any render resolution
		if (hl_pic_finale.pixels)
			HLPicDraw(c, &hl_pic_finale,
				(c->width - hl_pic_finale.width) / 2, 16 * c->height / 200);
		return;
	}

	mins = ToI64(level_time) / 60;
	secs = ToI64(level_time) % 60;

	//Sbar_IntermissionOverlay layout, 320x200 coords offset onto the canvas
	ox = (c->width - 320) / 2;
	if (ox < 0)
		ox = 0;
	oy = (c->height - 200) / 2;
	if (oy < 0)
		oy = 0;

	HLPicDraw(c, &hl_pic_complete, ox + 64, oy + 24);
	HLPicDraw(c, &hl_pic_inter, ox, oy + 56);

	//minutes, colon, two digits of seconds
	HLSbarNumber(c, ox + 160, oy + 64, mins, 3, FALSE);
	HLPicDraw(c, &hl_pic_colon, ox + 234, oy + 64);
	HLPicDraw(c, &hl_pic_nums[(secs / 10) % 10], ox + 246, oy + 64);
	HLPicDraw(c, &hl_pic_nums[secs % 10], ox + 266, oy + 64);

	if (hl_ofs_found_secrets >= 0 && hl_ofs_total_secrets >= 0)
	{
		HLSbarNumber(c, ox + 160, oy + 104,
			ToI64(HLPrGetF(hl_ofs_found_secrets)), 3, FALSE);
		HLPicDraw(c, &hl_pic_slash, ox + 232, oy + 104);
		HLSbarNumber(c, ox + 240, oy + 104,
			ToI64(HLPrGetF(hl_ofs_total_secrets)), 3, FALSE);
	}

	if (hl_ofs_killed_monsters >= 0 && hl_ofs_total_monsters >= 0)
	{
		HLSbarNumber(c, ox + 160, oy + 144,
			ToI64(HLPrGetF(hl_ofs_killed_monsters)), 3, FALSE);
		HLPicDraw(c, &hl_pic_slash, ox + 232, oy + 144);
		HLSbarNumber(c, ox + 240, oy + 144,
			ToI64(HLPrGetF(hl_ofs_total_monsters)), 3, FALSE);
	}
}

U0 HLSbarSmallNumber(CHLCanvas *c, I64 x, I64 value)
{//Sbar_DrawCharacter with 18 + digit, CONCHARS holds the small gold digits at
 //18. right aligned over three columns, leading zeroes blank
	I64 digits[3];
	I64 i;

	if (value < 0)
		value = 0;
	if (value > 999)
		value = 999;

	digits[0] = value / 100;
	digits[1] = (value / 10) % 10;
	digits[2] = value % 10;

	for (i = 0; i < 3; i++)
	{
		//"%3i" leaves leading zeroes as spaces, and a space draws nothing
		if (i == 0 && digits[0] == 0)
			goto qsn_next;
		if (i == 1 && digits[0] == 0 && digits[1] == 0)
			goto qsn_next;

		HLCharDraw(c, x + i * HLCHAR_W, hl_sbar_num_y, 18 + digits[i]);

qsn_next:
	}
}

U0 HLSbarDrawInventory(CHLCanvas *c, I64 bx, I64 top, I64 items)
{//Sbar_DrawInventory: weapons, four ammo counts, keys, powerups, sigils.
 //offsets are the original's, from the top of the IBAR
	CHLPic	*pic;
	I64		 ibar_y = top - 24;
	I64		 active;
	I64		 ammo[4];
	I64		 i;
	I64		 sel;

	if (!hl_pic_ibar.pixels)
		return;

	HLPicDraw(c, &hl_pic_ibar, bx, ibar_y);

	//STAT_ACTIVEWEAPON, .weapon is the item bit of the current weapon
	active = 0;
	if (hl_fld_weapon >= 0)
		active = ToI64(HLPrFieldF(hl_player_edict, hl_fld_weapon));

	for (i = 0; i < 7; i++)
	{
		if (!(items & (HLIT_SHOTGUN << i)))
			goto qsi_next_weap;

		sel = 0;
		if (active == (HLIT_SHOTGUN << i))
			sel = 7;

		pic = &hl_pic_weap[sel + i];
		if (pic->pixels)
			HLPicDraw(c, pic, bx + i * 24, ibar_y + 8);

qsi_next_weap:
	}

	ammo[0] = 0;
	ammo[1] = 0;
	ammo[2] = 0;
	ammo[3] = 0;

	if (hl_fld_ammo_shells >= 0)
		ammo[0] = ToI64(HLPrFieldF(hl_player_edict, hl_fld_ammo_shells));
	if (hl_fld_ammo_nails >= 0)
		ammo[1] = ToI64(HLPrFieldF(hl_player_edict, hl_fld_ammo_nails));
	if (hl_fld_ammo_rockets >= 0)
		ammo[2] = ToI64(HLPrFieldF(hl_player_edict, hl_fld_ammo_rockets));
	if (hl_fld_ammo_cells >= 0)
		ammo[3] = ToI64(HLPrFieldF(hl_player_edict, hl_fld_ammo_cells));

	//three small digits per count, at (6*i+1)*8 - 2
	for (i = 0; i < 4; i++)
	{
		hl_sbar_num_y = ibar_y;
		HLSbarSmallNumber(c, bx + (6 * i + 1) * 8 - 2, ammo[i]);
	}

	//keys and powerups are bits 17..22, from x=192 in 16 pixel steps
	for (i = 0; i < 6; i++)
	{
		if (!(items & (1 << (17 + i))))
			goto qsi_next_item;

		pic = &hl_pic_items[i];
		if (pic->pixels)
			HLPicDraw(c, pic, bx + 192 + i * 16, ibar_y + 8);

qsi_next_item:
	}

	//sigils are bits 28..31, right aligned on the 320 wide bar
	for (i = 0; i < 4; i++)
	{
		if (!(items & (1 << (28 + i))))
			goto qsi_next_sigil;

		pic = &hl_pic_sigil[i];
		if (pic->pixels)
			HLPicDraw(c, pic, bx + 320 - 32 + i * 8, ibar_y + 8);

qsi_next_sigil:
	}
}

I64 HLSbarLines()
{//Always 0. Quake reserved sb_lines rows at the bottom of the screen for the
 //status bar and shrank the 3D view above them; HL has no status bar. Its HUD
 //is an overlay on a full-screen view, so nothing is reserved.
 //
 //The Quake bar draw below still reads this, which is what keeps it from
 //painting over the HUD.
	return 0;
}

U0 HLSbarTileClear(CHLCanvas *c)
{//SCR_TileClear: border around a shrunken view, nothing at viewsize 100
 //
 //the backdrop stops at height - sb_lines, not at a fixed bar height: as the
 //bar rows are dropped the border grows down into them, and at 120 it runs to
 //the bottom of the screen
	I64 bottom = c->height - HLSbarLines;

	if (!hl_sbar_ready)
		return;

	if (c->vx > 0)
	{
		HLPicTile(c, &hl_pic_backtile, 0, 0, c->vx, bottom);
		HLPicTile(c, &hl_pic_backtile, c->vx + c->vw, 0,
			c->width - (c->vx + c->vw), bottom);
	}

	if (c->vy > 0)
	{
		HLPicTile(c, &hl_pic_backtile, c->vx, 0, c->vw, c->vy);
		HLPicTile(c, &hl_pic_backtile, c->vx, c->vy + c->vh, c->vw,
			bottom - (c->vy + c->vh));
	}
}

U0 HLSbarDraw(CHLCanvas *c)
{//Sbar_Draw
	CHLPic	*icon;
	I64		 top;
	I64		 bx;
	I64		 health;
	I64		 armor;
	I64		 ammo;
	I64		 items;
	I64		 face;
	CHLPic	*facepic;
	I64		 lines;

	//playback and remote play have no local QuakeC world, which is why sbar.c
	//reads cl.stats and not the edict - the edict was never spawned
	if (!hl_sbar_ready || (!hl_player_active && !HLClientMode))
		return;

	//sb_lines 0 means viewsize 120 - no bar at all, and no backdrop either
	lines = HLSbarLines;
	if (lines < 1)
		return;

	if (hl_player_active)
	{
		health = ToI64(HLPlayerHealth);
		armor  = ToI64(HLPlayerArmor);
		ammo   = ToI64(HLPlayerAmmo);
		items  = ToI64(HLPrFieldF(hl_player_edict, hl_fld_items));
	}
	else
	{
		//svc_clientdata carries all four, the only source during playback
		health = hl_cl.health;
		armor  = hl_cl.armorvalue;
		ammo   = hl_cl.currentammo;
		items  = hl_cl.items;
	}

	top = c->height - HLSBAR_H;

	//art is a fixed 320 wide, centred not stretched, so every element takes
	//the same base offset
	bx = (c->width - HLSBAR_W) / 2;
	if (bx < 0)
		bx = 0;

	//Sbar_Draw tiles first when the screen is wider than the art, over exactly
	//the sb_lines rows still on screen, so a partially hidden bar gets a shorter
	//band. a fully hidden one returned above
	if (c->width > HLSBAR_W)
		HLPicTile(c, &hl_pic_backtile, 0, c->height - lines, c->width, lines);

	//only the status line survives at 110, the inventory row needs both
	if (lines > HLSBAR_H)
		HLSbarDrawInventory(c, bx, top, items);

	//--- status line ---
	HLPicDraw(c, &hl_pic_sbar, bx, top);

	//armor icon is the grade held, hidden entirely when there is none
	if (items & HLIT_ARMOR3)
		icon = &hl_pic_armor[2];
	else if (items & HLIT_ARMOR2)
		icon = &hl_pic_armor[1];
	else if (items & HLIT_ARMOR1)
		icon = &hl_pic_armor[0];
	else
		icon = NULL;

	if (icon && armor > 0)
	{
		HLPicDraw(c, icon, bx + 0, top);
		HLSbarNumber(c, bx + 24, top, armor, 3, FALSE);
	}

	//Sbar_DrawFace order: both rings, quad, each ring alone, then health.
	//the number beside it draws either way
	facepic = NULL;
	if ((items & (HLIT_INVISIBILITY | HLIT_INVULNERABILITY)) ==
		(HLIT_INVISIBILITY | HLIT_INVULNERABILITY))
		facepic = &hl_pic_face_invis_invuln;
	else if (items & HLIT_QUAD)
		facepic = &hl_pic_face_quad;
	else if (items & HLIT_INVISIBILITY)
		facepic = &hl_pic_face_invis;
	else if (items & HLIT_INVULNERABILITY)
		facepic = &hl_pic_face_invuln;

	if (!facepic || !facepic->pixels)
	{
		face   = HLSbarFaceIndex(health);
		facepic = &hl_pic_faces[face];
	}

	if (facepic->pixels)
		HLPicDraw(c, facepic, bx + 112, top);
	HLSbarNumber(c, bx + 136, top, health, 3, FALSE);

	//ammo icon follows the selected weapon
	icon = NULL;
	if (items & (HLIT_SHOTGUN | HLIT_SUPER_SHOTGUN))
		icon = &hl_pic_ammo[0];
	if (items & (HLIT_NAILGUN | HLIT_SUPER_NAILGUN))
		icon = &hl_pic_ammo[1];
	if (items & (HLIT_GRENADE_LAUNCHER | HLIT_ROCKET_LAUNCHER))
		icon = &hl_pic_ammo[2];
	if (items & HLIT_LIGHTNING)
		icon = &hl_pic_ammo[3];

	if (icon)
		HLPicDraw(c, icon, bx + 224, top);

	HLSbarNumber(c, bx + 248, top, ammo, 3, TRUE);
}

U0 HLSbarFill(CHLCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 color)
{//Draw_Fill: solid palette rect for the scoreboard color bars
	I64	 i;
	I64	 j;
	I64	 yy;
	I64	 xx;
	U32	*row;
	U32	 argb;

	if (!c || !c->pixels || w < 1 || h < 1)
		return;

	color = color & 255;
	argb  = HLPalColor(color);

	for (j = 0; j < h; j++)
	{
		yy = y + j;
		if (yy >= 0 && yy < c->height)
		{
			row = c->pixels + yy * c->width;
			for (i = 0; i < w; i++)
			{
				xx = x + i;
				if (xx >= 0 && xx < c->width)
					row[xx] = argb;
			}
		}
	}
}

I64 HLSbarColorForMap(I64 m)
{//Sbar_ColorForMap: color nibble to palette index
	return (m & 255) + 8;
}

U0 HLSbarSoloScoreboard(CHLCanvas *c)
{//Sbar_SoloScoreboard. this lives in the status bar strip, replacing the bar's
 //normal contents while scores are held - not over the middle of the screen,
 //where it would sit on top of the ranking plaque and the frag list
	U8	line[64];
	I64	mins;
	I64	secs;
	I64	bx;
	I64	top;
	I64	len;

	if (!c)
		return;

	//the strip is a fixed 320 wide and centred, the base every other row uses
	top = c->height - HLSBAR_H;
	bx  = (c->width - HLSBAR_W) / 2;
	if (bx < 0)
		bx = 0;

	//Sbar_Draw swaps SBAR for SCOREBAR while scores are held, so these stats
	//replace the bar rather than printing over the health and ammo already
	//drawn there
	if (hl_pic_scorebar.pixels)
		HLPicDraw(c, &hl_pic_scorebar, bx, top);

	mins = ToI64(hl_game_time) / 60;
	secs = ToI64(hl_game_time) % 60;

	//left column: monster and secret totals
	StrPrint(line, "Monsters:%3d /%3d",
		ToI64(HLPrGetF(hl_ofs_killed_monsters)),
		ToI64(HLPrGetF(hl_ofs_total_monsters)));
	HLStrDraw(c, bx + 8, top + 4, line);

	StrPrint(line, "Secrets :%3d /%3d",
		ToI64(HLPrGetF(hl_ofs_found_secrets)),
		ToI64(HLPrGetF(hl_ofs_total_secrets)));
	HLStrDraw(c, bx + 8, top + 12, line);

	//right column: elapsed time, then the level name right-aligned under it
	StrPrint(line, "Time :%3d:%02d", mins, secs);
	HLStrDraw(c, bx + 184, top + 4, line);

	if (hl_net_level_name[0])
		HLStrCopy(line, hl_net_level_name, 64);
	else
		HLStrCopy(line, hl_map_name, 64);

	len = StrLen(line);
	HLStrDraw(c, bx + 232 - len * 4, top + 12, line);
}

U0 HLSbarDrawScoreboard(CHLCanvas *c)
{//Sbar_DeathmatchOverlay, ranked by frags with shirt/pants bars
	I64		fragsort[HLSV_MAX_CLIENTS];
	I64		n;
	I64		i;
	I64		j;
	I64		k;
	I64		tmp;
	I64		x;
	I64		y;
	I64		top;
	I64		bottom;
	I64		f;
	U8		line[40];

	if (!c)
		return;

	//Sbar_DrawScoreboard: solo stats always, the frag list only in deathmatch.
	//gating the whole call on deathmatch leaves coop with no scoreboard
	HLSbarSoloScoreboard(c);

	if (HLCvarGet("deathmatch") == 0.0)
		return;

	n = 0;
	for (i = 0; i < HLSV_MAX_CLIENTS; i++)
	{
		if (hl_scores[i].active && hl_scores[i].name[0])
		{
			fragsort[n] = i;
			n++;
		}
	}
	if (n < 1)
		return;

	for (i = 0; i < n; i++)
	{
		for (j = 0; j < n - 1 - i; j++)
		{
			if (hl_scores[fragsort[j]].frags < hl_scores[fragsort[j + 1]].frags)
			{
				tmp = fragsort[j];
				fragsort[j] = fragsort[j + 1];
				fragsort[j + 1] = tmp;
			}
		}
	}

	//Sbar_DeathmatchOverlay opens with the ranking plaque, centred at y 8. the
	//console-font FRAGS line is the fallback when the wad lump is absent
	if (hl_pic_ranking.pixels)
		HLPicDraw(c, &hl_pic_ranking,
			(c->width - hl_pic_ranking.width) / 2, 8);
	else
		HLStrDrawCenterAlt(c, 8, "FRAGS");

	x = (c->width - 200) / 2;
	if (x < 8)
		x = 8;

	//clear of the plaque, which is taller than a text row
	y = 28;
	if (hl_pic_ranking.pixels && hl_pic_ranking.height + 12 > y)
		y = hl_pic_ranking.height + 12;

	for (i = 0; i < n; i++)
	{
		k = fragsort[i];

		top    = hl_scores[k].colors & 0xF0;
		bottom = (hl_scores[k].colors & 15) << 4;
		top    = HLSbarColorForMap(top);
		bottom = HLSbarColorForMap(bottom);

		HLSbarFill(c, x, y, 40, 4, top);
		HLSbarFill(c, x, y + 4, 40, 4, bottom);

		f = hl_scores[k].frags;
		StrPrint(line, "%3d", f);
		HLStrDraw(c, x + 8, y, line);
		HLStrDraw(c, x + 64, y, hl_scores[k].name);

		y += 10;
	}
}

U0 HLSbarLoadingPlaque(CHLCanvas *c)
{//SCR_DrawLoading, centred at y=48 in the 320x200 layout
	if (!hl_pic_loading.pixels)
		return;

	HLPicDraw(c, &hl_pic_loading,
		(c->width - hl_pic_loading.width) / 2, 48 * c->height / 200);
}

U0 HLSbarCrosshair(CHLCanvas *c)
{//SCR_DrawCrosshair. no crosshair art - a '+' from the console font, centred on
 //the view rect not the screen, offset by cl_crossx/y
	I64 x;
	I64 y;

	if (HLCvarGet("crosshair") == 0.0)
		return;

	x = c->vx + c->vw / 2 + ToI64(HLCvarGet("cl_crossx"));
	y = c->vy + c->vh / 2 + ToI64(HLCvarGet("cl_crossy"));

	HLCharDraw(c, x, y, '+');
}
