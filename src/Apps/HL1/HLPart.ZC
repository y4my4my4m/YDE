// HLPart.ZC - particles
//
// most visible effects - explosions, blood, sparks, teleport fog - are not
// the particle builtin, they arrive as temp entities in a network message
// assembled by the Write* builtins
//
// drawn as points, depth tested against the world

#define HLPART_MAX		2048
#define HLPART_GRAVITY	-40.0	//particles fall slower than players

//particle behaviours
#define HLPT_STATIC		0
#define HLPT_GRAV		1
#define HLPT_FIRE		2		//ramps up the colour table then dies
#define HLPT_EXPLODE		3
#define HLPT_BLOB		4

class CHLParticle
{
	F64	org[3];
	F64	vel[3];
	F64	die;
	F64	ramp;
	I64	color;
	I64	type;
};

CHLParticle	hl_particles[HLPART_MAX];
I64			hl_part_count	= 0;
I64			hl_part_drawn	= 0;

//an index walks these as the particle ages, yellow down to dark red
I64 hl_ramp_fire[8]		= {0x6f, 0x6e, 0x6d, 0x6c, 0x6b, 0x6a, 0x68, 0x66};
I64 hl_ramp_explode[8]	= {0x6f, 0x6d, 0x6b, 0x69, 0x67, 0x65, 0x63, 0x61};

U0 HLPartInit()
{//globals aren't zeroed and this is walked every frame
	I64 i;

	for (i = 0; i < HLPART_MAX; i++)
	{
		hl_particles[i].die   = 0.0;
		hl_particles[i].type  = HLPT_STATIC;
		hl_particles[i].color = 0;
		hl_particles[i].ramp  = 0.0;
		HLVecSet(hl_particles[i].org, 0.0, 0.0, 0.0);
		HLVecSet(hl_particles[i].vel, 0.0, 0.0, 0.0);
	}

	hl_part_count = 0;
	hl_part_drawn = 0;
}

F64 HLPartRand(F64 range)
{//symmetric random in [-range, range]
	return (ToF64(RandU32 & 0xFFFF) / 32768.0 - 1.0) * range;
}

I64 HLPartRandI(I64 n)
{
	if (n <= 0)
		return 0;

	return RandU32 % n;
}

CHLParticle *HLPartAlloc(F64 now)
{//first dead slot, NULL when saturated - a busy moment drops sparks
	I64 i;

	for (i = 0; i < HLPART_MAX; i++)
	{
		if (hl_particles[i].die <= now)
		{
			if (i >= hl_part_count)
				hl_part_count = i + 1;
			return &hl_particles[i];
		}
	}

	return NULL;
}

U0 HLPartExplosion(F64 *org, F64 now)
{//R_ParticleExplosion
	CHLParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < 512; i++)
	{
		p = HLPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 5.0;
		p->color = hl_ramp_explode[0];
		p->ramp  = ToF64(HLPartRandI(4));

		if (i & 1)
			p->type = HLPT_EXPLODE;
		else
			p->type = HLPT_FIRE;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(HLPartRandI(32) - 16);
			p->vel[j] = HLPartRand(256.0);
		}
	}
}

U0 HLPartEffect(F64 *org, F64 *dir, I64 color, I64 count, F64 now)
{//R_RunParticleEffect - colour snapped to an 8 entry group and randomised
 //inside it, that is where the speckle comes from
	CHLParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < count; i++)
	{
		p = HLPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 0.1 * ToF64(HLPartRandI(5));
		p->color = (color & ~7) + HLPartRandI(8);
		p->type  = HLPT_GRAV;
		p->ramp  = 0.0;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(HLPartRandI(16) - 8);
			if (dir)
				p->vel[j] = dir[j] * 15.0 + HLPartRand(150.0);
			else
				p->vel[j] = HLPartRand(150.0);
		}
	}
}

U0 HLPartLavaSplash(F64 *org, F64 now)
{//R_LavaSplash
	CHLParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;

	for (i = -16; i < 16; i++)
	{
		for (j = -16; j < 16; j++)
		{
			p = HLPartAlloc(now);
			if (!p)
				return;

			p->die   = now + 2.0 + ToF64(HLPartRandI(64)) / 64.0;
			p->color = 224 + HLPartRandI(8);
			p->type  = HLPT_BLOB;
			p->ramp  = 0.0;

			dir[0] = ToF64(j * 8 + HLPartRandI(8));
			dir[1] = ToF64(i * 8 + HLPartRandI(8));
			dir[2] = 256.0;

			p->org[0] = org[0] + dir[0];
			p->org[1] = org[1] + dir[1];
			p->org[2] = org[2] + ToF64(HLPartRandI(64));

			HLVecNormalize(dir);
			vel = 50.0 + ToF64(HLPartRandI(64));
			HLVecScale(dir, vel, p->vel);
		}
	}
}

U0 HLPartTeleport(F64 *org, F64 now)
{//R_TeleportSplash
	CHLParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;
	I64			 k;

	for (i = -16; i < 16; i += 4)
	{
		for (j = -16; j < 16; j += 4)
		{
			for (k = -24; k < 32; k += 4)
			{
				p = HLPartAlloc(now);
				if (!p)
					return;

				p->die   = now + 0.2 + ToF64(HLPartRandI(8)) / 64.0;
				p->color = 7 + HLPartRandI(8);
				p->type  = HLPT_STATIC;
				p->ramp  = 0.0;

				p->org[0] = org[0] + ToF64(i) + ToF64(HLPartRandI(4));
				p->org[1] = org[1] + ToF64(j) + ToF64(HLPartRandI(4));
				p->org[2] = org[2] + ToF64(k) + ToF64(HLPartRandI(4));

				dir[0] = ToF64(j * 8);
				dir[1] = ToF64(i * 8);
				dir[2] = ToF64(k * 8);

				HLVecNormalize(dir);
				vel = 50.0 + ToF64(HLPartRandI(64));
				HLVecScale(dir, vel, p->vel);
			}
		}
	}
}

//--- entity trails ---------------------------------------------------------
//
// R_RocketTrail - laid along the segment moved since the last frame, one
// particle every three units, so density is speed independent. which trail
// comes from the model header flags word

#define HLTRAIL_ROCKET	0
#define HLTRAIL_SMOKE	1
#define HLTRAIL_BLOOD	2
#define HLTRAIL_TRACER	3
#define HLTRAIL_SLIGHT	4		//zombie gib: sparser blood
#define HLTRAIL_TRACER2	5
#define HLTRAIL_VOOR		6

//per-entity trail memory - CL_RelinkEntities keeps the previous position on
//the client entity, the edict only ever holds where the entity IS
#define HLTRAIL_MAX_ENTS	1024

F64	 hl_trail_org[HLTRAIL_MAX_ENTS * 3];
Bool hl_trail_valid[HLTRAIL_MAX_ENTS];

U0 HLPartTrailReset()
{//globals aren't zeroed, a slot carried across a map load would trail from
 //the old level's coordinates
	I64 i;

	for (i = 0; i < HLTRAIL_MAX_ENTS; i++)
	{
		hl_trail_valid[i]        = FALSE;
		hl_trail_org[i * 3]      = 0.0;
		hl_trail_org[i * 3 + 1]  = 0.0;
		hl_trail_org[i * 3 + 2]  = 0.0;
	}
}

U0 HLPartTrail(F64 *start, F64 *end, I64 type, F64 now)
{
	CHLParticle	*p;
	F64			 vec[3];
	F64			 pos[3];
	F64			 len;
	I64			 step;
	I64			 j;

	HLVecCopy(start, pos);
	HLVecSub(end, start, vec);
	len = HLVecLength(vec);

	if (len < 0.01)
		return;

	//a teleport moves an entity arbitrarily far in one frame, don't paint a
	//line across the level
	if (len > 1000.0)
		return;

	HLVecScale(vec, 1.0 / len, vec);

	//blood is sparser, as the original
	step = 3;
	if (type == HLTRAIL_SLIGHT)
		step = 6;

	while (len > 0.0)
	{
		len -= ToF64(step);

		p = HLPartAlloc(now);
		if (!p)
			return;

		HLVecSet(p->vel, 0.0, 0.0, 0.0);
		p->ramp = 0.0;
		p->type = HLPT_STATIC;
		p->die  = now + 2.0;

		switch (type)
		{
			case HLTRAIL_ROCKET:
				//fire ramp, drifts up as it cools
				p->die   = now + 2.0;
				p->type  = HLPT_FIRE;
				p->ramp  = ToF64(HLPartRandI(4));
				p->color = hl_ramp_fire[ClampI64(ToI64(p->ramp), 0, 7)];
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + HLPartRand(3.0);
				break;

			case HLTRAIL_SMOKE:
				p->die   = now + 2.0;
				p->type  = HLPT_FIRE;
				p->ramp  = ToF64(HLPartRandI(4)) + 2.0;
				p->color = hl_ramp_fire[ClampI64(ToI64(p->ramp), 0, 7)];
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + HLPartRand(3.0);
				break;

			case HLTRAIL_BLOOD:
			case HLTRAIL_SLIGHT:
				//palette blood range is 67..70
				p->die   = now + 2.0;
				p->type  = HLPT_GRAV;
				p->color = 67 + HLPartRandI(4);
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + HLPartRand(3.0);
				break;

			case HLTRAIL_TRACER:
			case HLTRAIL_TRACER2:
				p->die   = now + 0.5;
				p->type  = HLPT_STATIC;
				if (type == HLTRAIL_TRACER)
					p->color = 52 + (HLPartRandI(2) << 1);
				else
					p->color = 230 + (HLPartRandI(2) << 1);
				HLVecCopy(pos, p->org);
				break;

			default:
				//TRAIL_VOOR, the vore's spit
				p->die   = now + 0.3;
				p->color = 9 * 16 + 8 + HLPartRandI(4);
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + HLPartRand(16.0);
				break;
		}

		HLVecMA(pos, ToF64(step), vec, pos);
	}
}

U0 HLPartEntityTrail(I64 slot, F64 *org, I64 flags, F64 now)
{//CL_RelinkEntities trail dispatch - segment runs from where the entity was
 //last drawn to where it is now
	F64 *prev;

	if (slot < 0 || slot >= HLTRAIL_MAX_ENTS || !flags)
		return;

	prev = hl_trail_org + slot * 3;

	if (hl_trail_valid[slot])
	{
		if (flags & HLMDLF_ROCKET)
			HLPartTrail(prev, org, HLTRAIL_ROCKET, now);
		else if (flags & HLMDLF_GRENADE)
			HLPartTrail(prev, org, HLTRAIL_SMOKE, now);
		else if (flags & HLMDLF_GIB)
			HLPartTrail(prev, org, HLTRAIL_BLOOD, now);
		else if (flags & HLMDLF_ZOMGIB)
			HLPartTrail(prev, org, HLTRAIL_SLIGHT, now);
		else if (flags & HLMDLF_TRACER)
			HLPartTrail(prev, org, HLTRAIL_TRACER, now);
		else if (flags & HLMDLF_TRACER2)
			HLPartTrail(prev, org, HLTRAIL_TRACER2, now);
		else if (flags & HLMDLF_TRACER3)
			HLPartTrail(prev, org, HLTRAIL_VOOR, now);
	}

	HLVecCopy(org, prev);
	hl_trail_valid[slot] = TRUE;
}

U0 HLPartUpdate(F64 dt, F64 now)
{//R_UpdateParticles
	CHLParticle	*p;
	I64			 i;
	I64			 idx;

	for (i = 0; i < hl_part_count; i++)
	{
		p = &hl_particles[i];

		if (p->die <= now)
			goto qp_next;

		HLVecMA(p->org, dt, p->vel, p->org);

		switch (p->type)
		{
			case HLPT_FIRE:
				//5Hz through the fire table, then expires
				p->ramp += dt * 5.0;
				idx = ToI64(p->ramp);
				if (idx >= 6)
					p->die = now;
				else
					p->color = hl_ramp_fire[ClampI64(idx, 0, 7)];
				p->vel[2] += HLPART_GRAVITY * dt;
				break;

			case HLPT_EXPLODE:
				p->ramp += dt * 10.0;
				idx = ToI64(p->ramp);
				if (idx >= 8)
					p->die = now;
				else
					p->color = hl_ramp_explode[ClampI64(idx, 0, 7)];
				p->vel[2] += HLPART_GRAVITY * dt;
				break;

			case HLPT_GRAV:
			case HLPT_BLOB:
				p->vel[2] += HLPART_GRAVITY * dt;
				break;

			default:
				break;
		}

qp_next:
	}
}

U0 HLPartDraw(CHLCanvas *c, F64 now)
{//D_DrawParticle
	CHLParticle	*p;
	F64			 rel[3];
	F64			 cam[3];
	F64			 inv_z;
	F64			 sx;
	F64			 sy;
	I64			 i;
	I64			 x;
	I64			 y;
	I64			 px;
	I64			 py;
	I64			 size;
	I64			 izi;
	I64			 vw;
	I64			 pix_shift;
	I64			 pix_min;
	I64			 pix_max;

	hl_part_drawn = 0;

	//D_DrawParticle sizing, from D_SetupFrame. a particle is a square block
	//whose side comes straight from 1/z, so it grows as it nears the eye
	//
	//all three bounds scale with r_refdef.vrect.width, the 3d view rect and not
	//the whole screen - measuring against the canvas made them oversized at any
	//viewsize below 100
	vw = c->vw;
	if (vw < 1)
		vw = c->width;

	pix_shift = 8 - ToI64(ToF64(vw) / 320.0 + 0.5);
	pix_min   = vw / 320;
	if (pix_min < 1)
		pix_min = 1;
	pix_max = ToI64(ToF64(vw) / 80.0 + 0.5);
	if (pix_max < 1)
		pix_max = 1;

	for (i = 0; i < hl_part_count; i++)
	{
		p = &hl_particles[i];

		if (p->die <= now)
			goto qd_next;

		HLVecSub(p->org, c->origin, rel);
		cam[2] = HLVecDot(rel, c->forward);

		//behind the near clip
		if (cam[2] < HLNEAR_CLIP)
			goto qd_next;

		cam[0] = HLVecDot(rel, c->right);
		cam[1] = HLVecDot(rel, c->up);

		inv_z = 1.0 / cam[2];
		sx    = c->center_x + cam[0] * c->x_scale * inv_z;
		sy    = c->center_y - cam[1] * c->y_scale * inv_z;

		x = ToI64(sx);
		y = ToI64(sy);

		//izi is the original's fixed point 1/z, zi * 0x8000, and the shift turns it
		//into a pixel count
		izi  = ToI64(inv_z * 32768.0);
		size = izi >> pix_shift;

		if (size < pix_min)
			size = pix_min;
		else if (size > pix_max)
			size = pix_max;

		for (py = y; py < y + size; py++)
		{
			if (py < 0 || py >= c->height)
				goto qd_skip_row;

			for (px = x; px < x + size; px++)
			{
				if (px >= 0 && px < c->width)
				{
					if (inv_z > c->depth[py * c->width + px])
					{
						c->pixels[py * c->width + px] = HLPalColor(p->color);
						c->depth[py * c->width + px]  = inv_z;
					}
				}
			}

qd_skip_row:
		}

		hl_part_drawn++;

qd_next:
	}
}
