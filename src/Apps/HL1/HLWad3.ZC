// HLWad3.ZC - WAD3 texture archives
//
// Quake embedded every world texture in the BSP. Half-Life usually does not:
// the compiler writes a miptex header with all four mip offsets ZERO and the
// texels stay in a shared .wad, named by worldspawn's "wad" key. A map that
// cannot find its wads draws entirely in the missing-texture colour, so this
// has to be mounted before HLBSPLoadTextures runs.
//
// header: "WAD3", i32 numlumps, i32 infotableofs
// lump directory entry is 32 bytes:
//   i32 filepos, i32 disksize, i32 size, u8 type, u8 compression, u8 pad[2],
//   char name[16]
//
// type 0x43 is miptex. compression is always 0 in shipped wads - the format
// has a slot for it and nothing ever used it.
//
// a miptex body is the same layout as the embedded one, PLUS a palette: after
// the four mip levels comes u16 colours (always 256) then 3*256 RGB. that
// per-texture palette is the reason the renderer cannot stay 8bpp.
//
// like HLPak the whole archive stays resident and lookups hand back interior
// pointers - halflife.wad is ~70MB but ZealOS FileRead has no seek

#define HLWAD3_MAX			16
#define HLWAD3_TYP_MIPTEX	0x43

#define HLWAD3_NAME_MAX		64		//basename of one archive
#define HLWAD3_PATH_MAX		256		//one absolute path out of the "wad" list
#define HLWAD3_KEY_MAX		1024	//the whole ';' separated list

class CHLWad3Lump
{
	U8	name[16];
	I64	offset;
	I64	disk_size;
	I64	size;
	I64	type;
};

class CHLWad3
{
	U8			*data;
	Bool		 owns_data;	//FALSE when HLFileData's cache owns it
	I64			 data_size;
	CHLWad3Lump	*lumps;
	I64			 num_lumps;
	U8			 name[HLWAD3_NAME_MAX];	//basename, for reporting and dedup
};

CHLWad3	*hl_wad3s[HLWAD3_MAX];
I64		 hl_wad3_count = 0;


U0 HLWad3Init()
{//globals aren't zeroed
	I64 i;

	hl_wad3_count = 0;
	for (i = 0; i < HLWAD3_MAX; i++)
		hl_wad3s[i] = NULL;
}

U0 HLWad3SetGameDir(U8 *dir)
{//the search root is HLPak's - wads resolve through the same loose-then-pak
 //path as every other game file. kept as its own entry point because the
 //"game" command reads better calling both
	HLPakSetGameDir(dir);
}

U0 HLWad3BaseName(U8 *path, U8 *out, I64 max)
{//"\half-life\valve\halflife.wad" -> "halflife.wad"
 //
 //the key stores the ABSOLUTE path from whatever machine compiled the map,
 //with dos separators. only the last component is usable
	I64 start = 0;
	I64 i     = 0;
	I64 o     = 0;

	while (path[i])
	{
		if (path[i] == '\\' || path[i] == '/' || path[i] == ':')
			start = i + 1;
		i++;
	}

	while (o < max - 1 && path[start + o])
	{
		out[o] = path[start + o];
		o++;
	}

	out[o] = 0;
}

Bool HLWad3AlreadyMounted(U8 *basename)
{
	I64 i;

	for (i = 0; i < hl_wad3_count; i++)
	{
		if (hl_wad3s[i] && !StrICompare(hl_wad3s[i]->name, basename))
			return TRUE;
	}

	return FALSE;
}

Bool HLWad3MountData(U8 *data, I64 size, U8 *basename, Bool owns)
{//index an in-memory archive. takes ownership of data on success only when
 //owns is set - HLFileData's cache keeps its own copies
	CHLWad3		*wad;
	CHLWad3Lump	*l;
	U8			*rec;
	I64			 num_lumps;
	I64			 table_ofs;
	I64			 i;

	if (size < 12 || MemCompare(data, "WAD3", 4))
	{
		"HLWad3: %s is not a WAD3 archive\n", basename;
		return FALSE;
	}

	num_lumps = HLRdI32(data + 4);
	table_ofs = HLRdI32(data + 8);

	if (num_lumps <= 0 || table_ofs < 12 ||
		table_ofs + num_lumps * 32 > size)
	{
		"HLWad3: %s has a corrupt directory\n", basename;
		return FALSE;
	}

	wad            = CAlloc(sizeof(CHLWad3));
	wad->data      = data;
	wad->owns_data = owns;
	wad->data_size = size;
	wad->num_lumps = num_lumps;
	wad->lumps     = CAlloc(num_lumps * sizeof(CHLWad3Lump));
	HLRdName(basename, wad->name, HLWAD3_NAME_MAX);

	for (i = 0; i < num_lumps; i++)
	{
		rec = data + table_ofs + i * 32;
		l   = &wad->lumps[i];

		l->offset    = HLRdI32(rec);
		l->disk_size = HLRdI32(rec + 4);
		l->size      = HLRdI32(rec + 8);
		l->type      = rec[12];
		HLRdName(rec + 16, l->name, 16);

		//compression byte is rec[13]; nothing ships compressed, and a
		//non-zero value here would make the body undecodable, so drop it
		if (rec[13] || l->offset < 0 || l->disk_size < 0 ||
			l->offset + l->disk_size > size)
		{
			l->name[0]   = 0;
			l->disk_size = 0;
		}
	}

	hl_wad3s[hl_wad3_count] = wad;
	hl_wad3_count++;

	return TRUE;
}

Bool HLWad3MountByName(U8 *basename)
{//HLFileData already searches gamedir, then valve, then the paks, and folds
 //case on the way - a wad is just another game file
	U8	*d;
	I64	 size = 0;

	if (!basename || !basename[0])
		return FALSE;

	if (HLWad3AlreadyMounted(basename))
		return TRUE;

	if (hl_wad3_count >= HLWAD3_MAX)
	{
		"HLWad3: too many archives mounted, skipping %s\n", basename;
		return FALSE;
	}

	d = HLFileData(basename, &size);

	if (!d || size <= 0)
	{
		"HLWad3: %s not found\n", basename;
		return FALSE;
	}

	//borrowed: the loose-file cache or the pak owns it until the next unmount
	if (!HLWad3MountData(d, size, basename, FALSE))
		return FALSE;

	"HLWad3: mounted %s (%d bytes)\n", basename, size;

	return TRUE;
}

U0 HLWad3UnmountAll()
{//nothing may still hold a texel pointer - flush the surface cache first
	CHLWad3	*wad;
	I64		 i;

	for (i = 0; i < HLWAD3_MAX; i++)
	{
		wad         = hl_wad3s[i];
		hl_wad3s[i] = NULL;		//cleared before the free, not after

		if (!wad)
			goto qw3u_next;

		if (wad->lumps)
			Free(wad->lumps);
		if (wad->data && wad->owns_data)
			Free(wad->data);

		Free(wad);

qw3u_next:
	}

	hl_wad3_count = 0;
}

U8 *HLWad3FindMip(U8 *name, I64 *_size = NULL)
{//newest archive first so a mod wad overrides. returns a BORROWED pointer to
 //the miptex body, laid out exactly like an embedded one
	CHLWad3		*wad;
	CHLWad3Lump	*l;
	I64			 w;
	I64			 i;

	for (w = hl_wad3_count - 1; w >= 0; w--)
	{
		wad = hl_wad3s[w];
		if (!wad)
			goto qw3f_next_wad;

		for (i = 0; i < wad->num_lumps; i++)
		{
			l = &wad->lumps[i];

			if (l->type != HLWAD3_TYP_MIPTEX || !l->name[0])
				goto qw3f_next_lump;

			if (StrICompare(l->name, name))
				goto qw3f_next_lump;

			if (_size)
				*_size = l->disk_size;

			return wad->data + l->offset;

qw3f_next_lump:
		}

qw3f_next_wad:
	}

	if (_size)
		*_size = 0;

	return NULL;
}

I64 HLWad3ParseKey(U8 *ents, I64 ents_len, U8 *key, U8 *out, I64 max)
{//pull one quoted value out of the entity text. worldspawn is always the
 //first block, and "wad" only ever appears there, so a flat scan is enough
 //
 //returns the value length, 0 if the key is absent
	I64 key_len = StrLen(key);
	I64 i       = 0;
	I64 o       = 0;

	out[0] = 0;

	if (!ents || ents_len <= 0)
		return 0;

	while (i < ents_len)
	{
		//a key is always a quoted token, so anchor on the opening quote
		if (ents[i] != '"')
		{
			i++;
			goto qw3p_next;
		}

		if (i + 1 + key_len + 1 > ents_len)
			return 0;

		if (MemCompare(ents + i + 1, key, key_len) ||
			ents[i + 1 + key_len] != '"')
		{
			//skip to the end of this token so a value cannot be read as a key
			i++;
			while (i < ents_len && ents[i] != '"')
				i++;
			i++;
			goto qw3p_next;
		}

		//past the key, skip whitespace, then the value opens
		i += key_len + 2;
		while (i < ents_len && (ents[i] == ' ' || ents[i] == '\t' ||
								ents[i] == '\n' || ents[i] == '\r'))
			i++;

		if (i >= ents_len || ents[i] != '"')
			return 0;

		i++;
		while (i < ents_len && ents[i] != '"' && o < max - 1)
		{
			out[o] = ents[i];
			o++;
			i++;
		}

		out[o] = 0;
		return o;

qw3p_next:
	}

	return 0;
}

I64 HLWad3MountForMap(U8 *ents, I64 ents_len)
{//mount every wad worldspawn asks for. the value is a ';' separated list of
 //absolute paths; only the basenames survive
 //
 //returns how many mounted
	U8	 list[HLWAD3_KEY_MAX];
	U8	 base[HLWAD3_NAME_MAX];
	U8	 one[HLWAD3_PATH_MAX];
	I64	 len;
	I64	 i;
	I64	 o;
	I64	 mounted = 0;

	len = HLWad3ParseKey(ents, ents_len, "wad", list, HLWAD3_KEY_MAX);

	if (!len)
	{//maps with every texture embedded are legal and need no wads
		return 0;
	}

	i = 0;
	while (i <= len)
	{
		o = 0;
		while (i < len && list[i] != ';' && o < HLWAD3_PATH_MAX - 1)
		{
			one[o] = list[i];
			o++;
			i++;
		}

		one[o] = 0;

		//skip past the separator, and past any overflow tail
		while (i < len && list[i] != ';')
			i++;
		i++;

		if (!o)
			goto qw3m_next;

		HLWad3BaseName(one, base, HLWAD3_NAME_MAX);

		if (base[0] && HLWad3MountByName(base))
			mounted++;

qw3m_next:
	}

	return mounted;
}

U0 HLWad3Report()
{//load time sanity dump
	CHLWad3	*wad;
	I64		 i;
	I64		 j;
	I64		 mips;

	if (!hl_wad3_count)
	{
		"HLWad3: nothing mounted\n";
		return;
	}

	for (i = 0; i < hl_wad3_count; i++)
	{
		wad = hl_wad3s[i];
		if (!wad)
			goto qw3r_next;

		mips = 0;
		for (j = 0; j < wad->num_lumps; j++)
		{
			if (wad->lumps[j].type == HLWAD3_TYP_MIPTEX)
				mips++;
		}

		"  %-24s %5d lumps, %5d miptex, %8d bytes\n",
			wad->name, wad->num_lumps, mips, wad->data_size;

qw3r_next:
	}
}
