// HLTest.ZC - staged self checks
//
// a wrong F32 decode gives geometry that looks plausible and is subtly warped,
// so run in-guest and print numbers to compare against the host

U0 HLTestFmt()
{//known bit patterns through the binary32 decoder
	U8  buf[4];
	F64 v;

	"$$LTBLUE$$--- HLFmt ---$$FG$$\n";

	//1.0f = 0x3F800000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x80; buf[3] = 0x3F;
	v = HLRdF32(buf);
	"  1.0        -> %8.5f  %s\n", v, "expect 1.00000";

	//-2.5f = 0xC0200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0xC0;
	v = HLRdF32(buf);
	"  -2.5       -> %8.5f  %s\n", v, "expect -2.50000";

	//0.15625f = 0x3E200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0x3E;
	v = HLRdF32(buf);
	"  0.15625    -> %8.5f  %s\n", v, "expect 0.15625";

	//0.0f
	buf[0] = 0; buf[1] = 0; buf[2] = 0; buf[3] = 0;
	v = HLRdF32(buf);
	"  0.0        -> %8.5f  %s\n", v, "expect 0.00000";

	//FFFFFFFF must come back -1 signed, 4294967295 raw
	buf[0] = 0xFF; buf[1] = 0xFF; buf[2] = 0xFF; buf[3] = 0xFF;
	"  I32 of FFFFFFFF -> %d  expect -1\n", HLRdI32(buf);

	//0x00000180 = 384
	buf[0] = 0x80; buf[1] = 0x01; buf[2] = 0x00; buf[3] = 0x00;
	"  I32 of 00000180 -> %d  expect 384\n", HLRdI32(buf);
	"  U16 of 0180     -> %d  expect 384\n", HLRdU16(buf);

	//0xFF9C = -100 signed
	buf[0] = 0x9C; buf[1] = 0xFF;
	"  I16 of FF9C     -> %d  expect -100\n", HLRdI16(buf);
}

U0 HLTestPal()
{
	"$$LTBLUE$$--- HLPal ---$$FG$$\n";

	if (!HLPalLoad)
	{
		"  palette load FAILED\n";
		return;
	}

	//0 is black in the id palette, 15 the brightest grey
	"  loaded, colormap %s\n", "present";
	"  pal[0]   = %08X\n", hl_pal_argb[0];
	"  pal[15]  = %08X\n", hl_pal_argb[15];
	"  pal[255] = %08X\n", hl_pal_argb[255];
	"  colormap[0][0] = %d  colormap[63][0] = %d\n",
		hl_pal_colormap[0], hl_pal_colormap[63 * 256];
}

U0 HLTestMap(U8 *mapname)
{
	CHLMap *map;
	F64    lo[3];
	F64    hi[3];
	I64    i;
	I64    j;
	I64    solid = 0;

	"$$LTBLUE$$--- BSP %s ---$$FG$$\n", mapname;

	map = HLBSPLoad(mapname);
	if (!map)
		return;

	HLBSPReport(map);

	//cheapest end to end check on the F32 decoder, a broken mantissa or
	//exponent shows up as absurd extents
	for (j = 0; j < 3; j++)
	{
		lo[j] = 999999.0;
		hi[j] = -999999.0;
	}

	for (i = 0; i < map->num_vertices; i++)
	{
		for (j = 0; j < 3; j++)
		{
			if (map->vertices[i].pt[j] < lo[j])
				lo[j] = map->vertices[i].pt[j];
			if (map->vertices[i].pt[j] > hi[j])
				hi[j] = map->vertices[i].pt[j];
		}
	}

	"  vert bounds  x %8.1f .. %8.1f\n", lo[0], hi[0];
	"               y %8.1f .. %8.1f\n", lo[1], hi[1];
	"               z %8.1f .. %8.1f\n", lo[2], hi[2];

	for (i = 0; i < map->num_leafs; i++)
	{
		if (map->leafs[i].contents == HLCONTENTS_SOLID)
			solid++;
	}
	"  solid leafs  %d of %d\n", solid, map->num_leafs;

	//real names prove the miptex walk landed on real headers
	"  textures:";
	for (i = 0; i < 5 && i < map->num_textures; i++)
		" %s(%dx%d)", map->textures[i].name, map->textures[i].width,
			map->textures[i].height;
	"\n";

	//model 0 is worldspawn, it should span the level
	if (map->num_models > 0)
	{
		"  model0 mins  %8.1f %8.1f %8.1f\n",
			map->models[0].mins[0], map->models[0].mins[1], map->models[0].mins[2];
		"  model0 maxs  %8.1f %8.1f %8.1f\n",
			map->models[0].maxs[0], map->models[0].maxs[1], map->models[0].maxs[2];
	}

	HLBSPFree(map);
}

I64 HLTestFlag(Bool b)
{//GOTCHA: ToI64 on a Bool reads the seven bytes past it, which is where the
 //1819242241 attack flag came from. branch, don't cast
	if (b)
		return 1;

	return 0;
}

U0 HLTestNetDelta()
{//a wrong mask bit still makes a well formed message carrying the wrong field,
 //and the client accumulates that error forever
	CHLMsg		m;
	CHLEntState	now;
	CHLEntState	was;
	F64			mv[3];
	I64			bits;

	"$$LTBLUE$$--- HLNet delta ---$$FG$$\n";

	HLNetStatesClear;
	HLMsgClear(&m);

	HLNetStateClear(&was);
	HLNetStateClear(&now);

	//one axis and the frame, nothing else may go on the wire
	now.origin[0] = 64.0;
	now.frame     = 3;

	HLNetWriteEntityUpdate(&m, 12, &now, &was);
	"  moved x + frame -> %d bytes  %s\n", m.len,
		"expect 5: mask, num, frame, coord lo, coord hi";

	//high bit set on the first byte, stripped before the mask goes on, same as
	//the client message loop does
	bits = HLMsgReadByte(&m);
	"  signal bit  -> %8d  %s\n", HLTestFlag(ToBool(bits & HLU_SIGNAL)), "expect 1";
	bits &= 127;

	if (HLNetReadEntityUpdate(&m, bits))
	{
		"  client x    -> %8.3f  %s\n", hl_net_cl[12].origin[0], "expect 64.000";
		"  client frame-> %8d  %s\n", hl_net_cl[12].frame,       "expect 3";
		"  client y    -> %8.3f  %s\n", hl_net_cl[12].origin[1], "expect 0.000";
		"  client model-> %8d  %s\n", hl_net_cl[12].modelindex,  "expect 0";
	}
	else
		"  delta       -> FAILED to apply\n";

	//an entity matching its baseline still costs mask + number, two bytes. in
	//nq that pair IS the still-visible signal, suppress it and an idle entity
	//looks like one that left the pvs
	HLMsgClear(&m);
	HLNetWriteEntityUpdate(&m, 12, &was, &was);
	"  unchanged   -> %d bytes  %s\n", m.len, "expect 2: mask, num";

	//below a tenth of a unit no origin bit, the coord format can't represent
	//the difference anyway
	HLMsgClear(&m);
	HLNetStateClear(&now);
	now.origin[0] = 0.05;
	HLNetWriteEntityUpdate(&m, 12, &now, &was);
	bits = HLMsgReadByte(&m) & 127;
	"  0.05 move   -> origin bit %d  %s\n",
		HLTestFlag(ToBool(bits & HLU_ORIGIN1)), "expect 0";

	HLMsgClear(&m);
	HLNetStateClear(&now);
	now.origin[0] = 0.5;
	HLNetWriteEntityUpdate(&m, 12, &now, &was);
	bits = HLMsgReadByte(&m) & 127;
	"  0.50 move   -> origin bit %d  %s\n",
		HLTestFlag(ToBool(bits & HLU_ORIGIN1)), "expect 1";

	//above 255 the entity number switches to the long form
	HLMsgClear(&m);
	HLNetStateClear(&now);
	now.origin[2] = -8.0;
	HLNetWriteEntityUpdate(&m, 300, &now, &was);
	bits = HLMsgReadByte(&m) & 127;
	if (bits & HLU_MOREBITS)
		bits |= HLMsgReadByte(&m) << 8;
	"  ent 300     -> longentity %d  %s\n", HLTestFlag(ToBool(bits & HLU_LONGENTITY)),
		"expect 1";

	//--- codecs added for svc_time and svc_clientdata ---
	HLMsgClear(&m);
	HLMsgWriteFloat(&m, 12.5);
	HLMsgWriteChar(&m, -7);
	HLMsgWriteChar(&m, 120);
	HLMsgWriteLong(&m, -3);

	"  float       -> %8.3f  %s\n", HLMsgReadFloat(&m),  "expect 12.500";
	"  char neg    -> %8d  %s\n", HLMsgReadChar(&m),     "expect -7";
	"  char pos    -> %8d  %s\n", HLMsgReadChar(&m),     "expect 120";
	"  long neg    -> %8d  %s\n", HLMsgReadLong(&m),     "expect -3";

	//--- upstream: clc_move round trip ---
	//
	//client encoder into the server decoder, no shared state between them.
	//entity 0 so the reader touches no edict. stock layout, no trailing coords
	HLNetInit;
	HLNetClientClear;

	HLVecSet(mv, 10.0, 20.0, 30.0);
	HLNetClientSendMove(mv, 400.0, -200.0, 0.0, TRUE, FALSE, 5, 0.0);

	if (HLNetServerGetMessage(&m))
	{
		m.read    = 0;
		m.badread = FALSE;

		//byte + float + 3 angles + 3 shorts + buttons + impulse = 16
		"  clc_move len-> %8d  %s\n", m.len, "expect 16 (stock, no origin)";

		"  clc byte    -> %8d  %s\n", HLMsgReadByte(&m), "expect 3 (clc_move)";

		if (HLNetServerReadMove(&m, 0, 0.0))
		{
			"  move fwd    -> %8.1f  %s\n", hl_net_move_cmd[0], "expect 400.0";
			"  move side   -> %8.1f  %s\n", hl_net_move_cmd[1], "expect -200.0";
			"  move attack -> %8d  %s\n", HLTestFlag(hl_net_move_attack), "expect 1";
			"  move jump   -> %8d  %s\n", HLTestFlag(hl_net_move_jump),   "expect 0";
			"  move impulse-> %8d  %s\n", hl_net_move_impulse,       "expect 5";

			//angles only survive to 256 steps per turn, so 20 degrees
			//comes back as the nearest step
			"  move yaw    -> %8.2f  %s\n", hl_net_move_angles[1],
				"expect ~19.69 (256 steps/turn)";

			"  move unread -> %8d  %s\n", m.len - m.read, "expect 0";
		}
		else
			"  clc_move    -> FAILED to read\n";
	}
	else
		"  clc_move    -> NOT QUEUED\n";

	//CL_ParseUpdate seeds from the baseline on first sight, without that an
	//entity arrives with modelindex 0 and never draws
	HLNetStatesClear;
	hl_net_baseline[40].modelindex = 9;
	hl_net_baseline[40].origin[0]  = 100.0;

	HLMsgClear(&m);
	HLNetStateClear(&now);
	now.modelindex = 9;
	now.origin[0]  = 100.0;
	now.frame      = 2;
	HLNetWriteEntityUpdate(&m, 40, &now, &hl_net_baseline[40]);

	bits = HLMsgReadByte(&m) & 127;
	HLNetReadEntityUpdate(&m, bits);
	"  seeded model-> %8d  %s\n", hl_net_cl[40].modelindex, "expect 9";
	"  seeded x    -> %8.3f  %s\n", hl_net_cl[40].origin[0], "expect 100.000";
	"  seeded frame-> %8d  %s\n", hl_net_cl[40].frame,       "expect 2";
}

U0 HLTestDgrmHdr()
{//winquake datagram headers are big endian U32 pairs, CTL is one word, DATA
 //reliable is flags|length then sequence
	U8	 buf[8];
	U32	 word;
	U32	 flags;
	U32	 len;
	U32	 seq;

	"$$LTBLUE$$--- HLNet dgrm hdr ---$$FG$$\n";

	//CTL: NETFLAG_CTL | payload length, 4 byte header
	word = HLNETFLAG_CTL | 12;
	HLNetWriteBigLong(buf, word);
	word = HLNetReadBigLong(buf);
	flags = word & ~HLNETFLAG_LENGTH_MASK;
	len   = word & HLNETFLAG_LENGTH_MASK;
	"  ctl flags  -> %08X  %s\n", flags, "expect 80000000";
	"  ctl length -> %8d  %s\n", len, "expect 12";

	//DATA|EOM reliable: 8 byte header, flags|length then sequence
	seq  = 42;
	word = HLNETFLAG_DATA | HLNETFLAG_EOM | 100;
	HLNetWriteBigLong(buf, word);
	HLNetWriteBigLong(buf + 4, seq);
	word = HLNetReadBigLong(buf);
	seq  = HLNetReadBigLong(buf + 4);
	flags = word & ~HLNETFLAG_LENGTH_MASK;
	len   = word & HLNETFLAG_LENGTH_MASK;
	"  data flags -> %08X  %s\n", flags, "expect 00090000";
	"  data len   -> %8d  %s\n", len, "expect 100";
	"  data seq   -> %8d  %s\n", seq, "expect 42";

	//BigLong is its own inverse
	word = HLNetBigLong(HLNetBigLong(0x12345678));
	"  biglong    -> %08X  %s\n", word, "expect 12345678";
}

U0 HLTestDgrmFrame()
{//framing with no nic. encode on sock a, process on b through HLNetDgrmProcess,
 //the same path Recv takes after demux
	CHLNetSock	*a;
	CHLNetSock	*b;
	CHLMsg		m;
	CHLMsg		out;
	U8			 pkt[HLNET_MAX_DATAGRAM + HLNET_HEADERSIZE];
	I64			 packet_len;
	I64			 ret;
	U32			 word;
	U32			 flags;
	U32			 len;
	U32			 seq;

	"$$LTBLUE$$--- HLNet dgrm frame ---$$FG$$\n";

	a = &hl_net_socks[0];
	b = &hl_net_socks[1];
	HLNetSockClear(a);
	HLNetSockClear(b);
	a->active = TRUE;
	a->ip     = 0x0200000A;	//10.0.0.2 host order
	b->active = TRUE;
	b->ip     = 0x0100000A;	//10.0.0.1

	//mirrors the HLNetDgrmSendUnreliable header layout
	HLMsgClear(&m);
	HLMsgWriteByte(&m, 7);
	HLMsgWriteLong(&m, 0x11223344);
	packet_len = HLNET_HEADERSIZE + m.len;
	HLNetWriteBigLong(pkt, packet_len | HLNETFLAG_UNRELIABLE);
	HLNetWriteBigLong(pkt + 4, a->unrel_send_seq++);
	MemCopy(pkt + HLNET_HEADERSIZE, m.data, m.len);

	word  = HLNetReadBigLong(pkt);
	flags = word & ~HLNETFLAG_LENGTH_MASK;
	len   = word & HLNETFLAG_LENGTH_MASK;
	seq   = HLNetReadBigLong(pkt + 4);
	"  unrel flags-> %08X  %s\n", flags, "expect 00100000";
	"  unrel len  -> %8d  %s\n", len, "expect 13";
	"  unrel seq  -> %8d  %s\n", seq, "expect 0";

	ret = HLNetDgrmProcess(b, pkt, packet_len, &out);
	"  unrel ret  -> %8d  %s\n", ret, "expect 2";
	"  unrel byte -> %8d  %s\n", out.data[0], "expect 7";
	"  unrel long -> %08X  %s\n",
		out.data[1] | (out.data[2] << 8) | (out.data[3] << 16) | (out.data[4] << 24),
		"expect 11223344";

	//single chunk DATA|EOM, the ack may fail with no nic
	HLMsgClear(&m);
	HLMsgWriteByte(&m, HLSVC_NOP);
	HLMsgWriteString(&m, "hi");
	MemCopy(a->send_msg, m.data, m.len);
	a->send_len    = m.len;
	a->send_offset = 0;
	a->can_send    = FALSE;
	packet_len = HLNET_HEADERSIZE + m.len;
	HLNetWriteBigLong(pkt, packet_len | HLNETFLAG_DATA | HLNETFLAG_EOM);
	HLNetWriteBigLong(pkt + 4, a->send_seq++);
	MemCopy(pkt + HLNET_HEADERSIZE, a->send_msg, m.len);

	ret = HLNetDgrmProcess(b, pkt, packet_len, &out);
	"  rel ret    -> %8d  %s\n", ret, "expect 1";
	"  rel svc    -> %8d  %s\n", out.data[0], "expect 1";
	"  b recv_seq -> %8d  %s\n", b->recv_seq, "expect 1";

	HLNetSockClear(a);
	"  clear send -> %8d  %s\n", a->can_send, "expect 1";

	HLNetDgrmInit;
}

U0 HLTestNet()
{//round trip the wire codecs. these formats are shared with demo files and
 //other clients, an off by one in the scaling isn't a local matter
	CHLMsg	m;
	U8		str[32];
	F64		f;
	I64		i;

	"$$LTBLUE$$--- HLNet ---$$FG$$\n";

	HLNetInit;
	HLMsgClear(&m);

	HLMsgWriteByte(&m, 200);
	HLMsgWriteShort(&m, -1234);
	HLMsgWriteLong(&m, 0x12345678);

	//coords quantise to eighths, so 12.5 survives exactly and this stays a test
	//of the codec, not of rounding
	HLMsgWriteCoord(&m, 12.5);
	HLMsgWriteCoord(&m, -300.25);

	//256 steps per turn, so 90 degrees is exactly 64
	HLMsgWriteAngle(&m, 90.0);
	HLMsgWriteString(&m, "hello");

	"  wrote %d bytes, overflowed %d  %s\n", m.len, m.overflowed,
		"expect 0 overflow";

	i = HLMsgReadByte(&m);
	"  byte       -> %10d  %s\n", i, "expect 200";

	i = HLMsgReadShort(&m);
	"  short      -> %10d  %s\n", i, "expect -1234";

	i = HLMsgReadLong(&m);
	"  long       -> %10X  %s\n", i, "expect 12345678";

	f = HLMsgReadCoord(&m);
	"  coord      -> %10.4f  %s\n", f, "expect 12.5000";

	f = HLMsgReadCoord(&m);
	"  coord      -> %10.4f  %s\n", f, "expect -300.2500";

	f = HLMsgReadAngle(&m);
	"  angle      -> %10.4f  %s\n", f, "expect 90.0000";

	HLMsgReadString(&m, str, 32);
	"  string     -> '%s'  %s\n", str, "expect 'hello'";

	"  badread    -> %10d  %s\n", m.badread, "expect 0";

	//overread must be caught, not walk off the buffer
	HLMsgReadLong(&m);
	"  overread   -> badread %d  %s\n", m.badread, "expect 1";

	//loopback must deliver a whole message unchanged
	HLMsgClear(&hl_net_send);
	HLMsgWriteByte(&hl_net_send, HLSVC_TIME);
	HLMsgWriteCoord(&hl_net_send, 64.0);

	if (HLNetSendToClient(&hl_net_send) && HLNetGetMessage(&m))
	{
		i = HLMsgReadByte(&m);
		f = HLMsgReadCoord(&m);
		"  loopback   -> svc %d coord %6.1f  %s\n", i, f, "expect svc 7 / 64.0";
	}
	else
		"  loopback   -> FAILED to round-trip\n";

	HLTestDgrmHdr;
	HLTestDgrmFrame;
	HLTestNetDelta;
}

U0 HLTestStudio(U8 *name)
{//load one studio model and dump what came out of it. the single most useful
 //check there is: it exercises the loose-file lookup, the IDST header, the
 //external T file and the skin table in one go
	CHLStudio	*m;
	CHLTexture	*tex;
	I64			 i;
	I64			 verts = 0;
	I64			 meshes = 0;

	"\n$$LTBLUE$$--- studio: %s ---$$FG$$\n", name;

	m = HLStudioLoad(name);
	if (!m)
		return;

	HLStudioReport(m);

	for (i = 0; i < m->num_bodyparts; i++)
	{
		if (m->bodyparts[i].num_models > 0)
		{
			verts  += m->bodyparts[i].models[0].num_verts;
			meshes += m->bodyparts[i].models[0].num_meshes;
		}
	}

	"  submodel 0   %6d verts, %d meshes\n", verts, meshes;

	//a skin that resolves to NULL is why a model would draw as nothing
	tex = HLStudioSkin(m, 0, 0);
	if (!tex)
		"  skin 0       $$RED$$unresolved$$FG$$\n";
	else if (tex->palette)
		"  skin 0       %6d x %d, palette ok\n", tex->width, tex->height;
	else
		"  skin 0       %6d x %d, $$RED$$no palette$$FG$$\n",
			tex->width, tex->height;

	HLStudioFree(m);
}

U0 HLTestRender(U8 *mapname)
{//render ONE frame off-screen and report numbers
 //
 //the game shell, the window, the HUD and the frame loop are all out of the
 //picture: if this is clean the renderer core is fine and the fault is above
 //it; if this faults, it is the rasterizer and we have a bounded place to look
	CHLMap		*map;
	CHLVisState	*vis;
	CHLCanvas	*c;
	F64			 origin[3];
	F64			 angles[3];
	F64			 forward[3];
	F64			 right[3];
	F64			 up[3];
	F64			 fov_y;
	CHLTrace	 tr;
	F64			 drop[3];
	I64			 i;
	I64			 lit = 0;
	I64			 black = 0;
	I64			 solid_brush = 0;

	"\n$$LTBLUE$$--- render: %s ---$$FG$$\n", mapname;

	map = HLBSPLoad(mapname);
	if (!map)
		return;

	HLLightInit;
	HLTurbInit;
	HLSurfCacheInit;
	HLSurfCacheSetMap(map);

	HLEntParse(map);
	HLEntSpawnAll(map);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use && hl_entities[i].solid == HLSOLID_BSP)
			solid_brush++;
	}

	if (!HLEntFindPlayerStart(origin, angles))
	{
		"  no info_player_start, using the model centre\n";
		origin[0] = (map->models[0].mins[0] + map->models[0].maxs[0]) * 0.5;
		origin[1] = (map->models[0].mins[1] + map->models[0].maxs[1]) * 0.5;
		origin[2] = (map->models[0].mins[2] + map->models[0].maxs[2]) * 0.5;
		HLVecSet(angles, 0.0, 0.0, 0.0);
	}

	origin[2] += HLPHYS_VIEW_Z;

	"  eye          %8.1f %8.1f %8.1f\n", origin[0], origin[1], origin[2];

	vis = HLVisNew(map);
	c   = HLDrawNew(320, 200);

	if (!vis || !c)
	{
		"  $$RED$$canvas or vis allocation failed$$FG$$\n";
		return;
	}

	HLDrawSetViewRect(c, 100.0, 0);
	HLDrawSetView(c, origin, angles, 90.0);
	HLDrawClear(c, 0);

	fov_y = HLDrawFovY(90.0, c->vw, c->vh);
	HLAngleVectors(angles, forward, right, up);

	"  vis...\n";
	HLVisBuildList(vis, origin, forward, right, up, 90.0, fov_y);
	"  vis          %d faces, %d nodes visited\n",
		vis->face_count, vis->nodes_visited;

	"  world...\n";
	HLDrawWorld(c, map, vis);

	"  drawn        %d faces, %d spans\n", c->faces_drawn, c->spans_drawn;
	"  surfcache    %d builds, %d hits, %d bytes\n",
		hl_surf_builds, hl_surf_hits, hl_surf_bytes;

	//a correct frame is mostly NOT the clear colour. all-black means nothing
	//rasterised; a scatter of unrelated colours means the span loop is
	//reading outside the texture
	for (i = 0; i < c->width * c->height; i++)
	{
		if (c->pixels[i])
			lit++;
		else
			black++;
	}

	"  pixels       %d non-black, %d black\n", lit, black;
	"  sample       %08X %08X %08X %08X\n",
		c->pixels[c->width * 100 + 40],
		c->pixels[c->width * 100 + 120],
		c->pixels[c->width * 100 + 200],
		c->pixels[c->width * 100 + 280];
	"  disp ramps   identity=%d r[128]=%d g[128]=%d b[128]=%d\n",
		hl_disp_identity, hl_disp_r[128], hl_disp_g[128], hl_disp_b[128];

	//--- collision ---
	//
	//drop the player box straight down from the eye. a sane world hull finds
	//floor within a few hundred units; fraction 1.0 means the trace fell all
	//the way through and the clipnodes are not being consulted
	HLClipInit;

	"  hulls        clipnodes %d, world head_node %d %d %d %d\n",
		map->num_clipnodes,
		map->models[0].head_node[0], map->models[0].head_node[1],
		map->models[0].head_node[2], map->models[0].head_node[3];

	"  player box   %.0f %.0f %.0f .. %.0f %.0f %.0f  (hull %d)\n",
		hl_player_mins[0], hl_player_mins[1], hl_player_mins[2],
		hl_player_maxs[0], hl_player_maxs[1], hl_player_maxs[2],
		HLHullForSize(hl_player_mins, hl_player_maxs);

	HLVecCopy(origin, drop);
	drop[2] -= 4096.0;

	HLTraceEntity(map, origin, drop, hl_player_mins, hl_player_maxs,
		0, FALSE, &tr);

	"  floor trace  fraction %f  hit %d  allsolid %d  startsolid %d\n",
		tr.fraction, tr.hit, tr.all_solid, tr.start_solid;

	if (tr.fraction < 1.0)
		"  floor at     %.1f, %.1f below the eye, normal %.2f %.2f %.2f\n",
			tr.end_pos[2], origin[2] - tr.end_pos[2],
			tr.plane_normal[0], tr.plane_normal[1], tr.plane_normal[2];
	else
		"  $$RED$$no floor found in 4096 units$$FG$$\n";

	"  brush ents   %d solid of %d\n", solid_brush, hl_num_entities;
	"  ambients     %d registered\n", hl_ambient_count;

	//what the map actually wired up. trains and their path nodes first,
	//since that is what drives the c0a0 intro
	"\n";
	HLEntDump("func_track");
	HLEntDump("func_train");
	HLEntDump("path_");
	HLEntDump("trigger_auto");
	HLEntDump("multi_manager");
	HLEntDump("ambient_generic");

	HLSurfCacheSetMap(NULL);
	HLDrawFree(c);
	HLVisFree(vis);
	HLEntFree;
	HLBSPFree(map);
}

U0 HLTestPic(U8 *path)
{//what a 2D lump actually IS on disk. quake art is (w, h, pixels) indexing
 //the global palette; HL art appends its own 256 colour palette like a miptex
	CHLPic	pic;
	I64		size = 0;

	if (!HLFileData(path, &size))
	{
		"  %-24s $$RED$$missing$$FG$$\n", path;
		return;
	}

	if (!HLPicLoad(path, &pic))
	{
		"  %-24s %6d bytes, $$RED$$header rejected$$FG$$\n", path, size;
		return;
	}

	//w*h+8 is a quake lump exactly; +2+768 more is an HL one. anything else
	//is a format this loader does not understand, and drawing it produces
	//noise rather than a wrong-coloured picture
	"  %-24s %4d x %-4d %7d bytes, expect %7d, palette %d\n",
		path, pic.width, pic.height, size,
		pic.width * pic.height + 8, ToI64(pic.palette != NULL);
}

U0 HLTestSoundFile(U8 *name)
{//load one wav and report what came out. silence is usually a missing file
 //or a format the decoder rejects, and those look identical from the outside
	CHLSound *snd = HLSndLoad(name);

	if (!snd)
	{
		"  %-28s $$RED$$not loaded$$FG$$\n", name;
		return;
	}

	"  %-28s %7d frames @ %d Hz\n", name, snd->count, snd->rate;
}

U0 HLTestSound()
{
	"\n$$LTBLUE$$--- sound ---$$FG$$\n";

	//NOT a cvar - the mixer reads hl_snd_master, which the options menu
	//drives from hl_opt_volume. asking HLCvarGet for it returns 0 and looks
	//exactly like a muted game
	"  master vol   %g\n", hl_snd_master;

	HLTestSoundFile("doors/doormove1.wav");
	HLTestSoundFile("buttons/button1.wav");
	HLTestSoundFile("ambience/labdrone1.wav");

	//nothing has spawned yet at this point in the run - the map-time count is
	//reported by HLTestRender instead
}

U0 HLTestSpr(U8 *name)
{//HL HUD art is SPR v2 - version, texFormat and a private palette
	CHLSpr *sp = HLSprLoad(name);

	if (!sp)
	{
		"  %-28s $$RED$$not loaded$$FG$$\n", name;
		return;
	}

	"  %-28s v%d fmt %d  %3d x %-3d %2d frames  palette %d\n",
		name, sp->version, sp->tex_format, sp->max_width, sp->max_height,
		sp->num_frames, ToI64(sp->palette != NULL);

	HLSprFree(sp);
}

U0 HLTestAnim(U8 *name)
{//prove whether the RLE animation channels decode at all
 //
 //a model stuck in its rest pose and a model whose cycle never advances look
 //identical on screen. This separates them: set up the same sequence at two
 //different cycles and compare a bone. Identical means the channel decode is
 //returning nothing and every bone is sitting at bone->value[]
	CHLStudio	*m;
	F64			 root[12];
	F64			 org[3];
	F64			 ang[3];
	F64			 adj[HLST_MAX_CONTROLLERS];
	F64			 a0[3];
	F64			 a1[3];
	I64			 i;
	I64			 bone = 5;

	"\n$$LTBLUE$$--- animation: %s ---$$FG$$\n", name;

	m = HLStudioLoad(name);
	if (!m)
		return;

	if (m->num_seqs < 1 || m->num_bones <= bone)
	{
		"  $$RED$$no sequences or too few bones$$FG$$\n";
		HLStudioFree(m);
		return;
	}

	for (i = 0; i < HLST_MAX_CONTROLLERS; i++)
		adj[i] = 0.0;

	HLVecSet(org, 0.0, 0.0, 0.0);
	HLVecSet(ang, 0.0, 0.0, 0.0);
	HLStAngleMatrix(ang, org, root);

	"  seq 0        %s, %d frames @ %g fps, group %d\n",
		m->seqs[0].label, m->seqs[0].num_frames, m->seqs[0].fps,
		m->seqs[0].seq_group;

	HLStSetupBones(m, 0, 0.0, 0.0, adj, root);
	a0[0] = hl_st_bone_tf[bone * 12 + 3];
	a0[1] = hl_st_bone_tf[bone * 12 + 7];
	a0[2] = hl_st_bone_tf[bone * 12 + 11];

	HLStSetupBones(m, 0, 0.5, 0.0, adj, root);
	a1[0] = hl_st_bone_tf[bone * 12 + 3];
	a1[1] = hl_st_bone_tf[bone * 12 + 7];
	a1[2] = hl_st_bone_tf[bone * 12 + 11];

	"  bone %d @0.0  %8.2f %8.2f %8.2f\n", bone, a0[0], a0[1], a0[2];
	"  bone %d @0.5  %8.2f %8.2f %8.2f\n", bone, a1[0], a1[1], a1[2];

	if (a0[0] == a1[0] && a0[1] == a1[1] && a0[2] == a1[2])
		"  $$RED$$IDENTICAL - channel decode is returning nothing$$FG$$\n";
	else
		"  $$GREEN$$bones move - decode works, look upstream at cycle$$FG$$\n";

	HLStudioFree(m);
}

U0 HLTestSentences()
{//parse sentences.txt and resolve a few known sentences to word paths
	U8	path[96];
	I64	i;
	I64	n;

	"\n$$LTBLUE$$--- sentences ---$$FG$$\n";

	HLAISentencesLoad;

	if (!hl_ai_sent_count)
		return;

	//HG_ALERT0 is a hgrunt line with a directory prefix and modifiers, so it
	//exercises every part of the tokeniser
	i = HLAISentenceFind("HG_ALERT0");

	if (i < 0)
		"  HG_ALERT0    $$RED$$absent$$FG$$\n";
	else
	{
		"  HG_ALERT0    words:";

		n = 0;
		while (n < 8 && HLAISentenceWord(i, n, path))
		{
			" %s", path;
			n++;
		}

		"\n";
	}
}

U0 HLTestHud()
{//parse hud.txt and report what resolved. an element count of 0 means the
 //table parsed but nothing matched the resolution; missing sheets mean the
 //.spr files are not where hud.txt says
	I64 i;

	"\n$$LTBLUE$$--- hud ---$$FG$$\n";

	if (!HLHudLoad(640))
		return;

	for (i = 0; i < 3; i++)
	{
		U8	name[32];
		I64	idx;

		if (!i)		HLRdName("cross", name, 32);
		else if (i == 1)	HLRdName("number_0", name, 32);
		else		HLRdName("suit_full", name, 32);

		idx = HLHudFind(name);

		if (idx < 0)
			"  %-12s $$RED$$absent$$FG$$\n", name;
		else
			"  %-12s sheet %d  rect %d %d %d %d\n", name,
				hl_hud_entry[idx].sheet, hl_hud_entry[idx].x,
				hl_hud_entry[idx].y, hl_hud_entry[idx].w,
				hl_hud_entry[idx].h;
	}
}

U0 HLTestSprites()
{
	"\n$$LTBLUE$$--- sprites ---$$FG$$\n";

	HLTestSpr("sprites/640hud1.spr");
	HLTestSpr("sprites/640hud2.spr");
	HLTestSpr("sprites/muzzleflash1.spr");
}

U0 HLTestPics()
{
	"\n$$LTBLUE$$--- 2D art ---$$FG$$\n";

	HLTestPic("gfx/conback.lmp");
	HLTestPic("gfx/palette.lmp");
	HLTestPic("gfx/lambda.lmp");
}

U0 HLTest()
{
	U8 line[160];

	"\n$$GREEN$$===== HL1 data layer self-test =====$$FG$$\n\n";

	"  game root    %s\n", hl_game_root;

	HLPakInit;
	HLWad3Init;
	HLPakSetGameDir("");

	//a pak is OPTIONAL: whether valve/ has one depends on which release the
	//install came from, and nothing here needs its contents. mounted by hand
	//rather than through HLPakMountGame, which lives in the shell and
	//compiles after this file
	StrPrint(line, "%s/valve/PAK0.PAK", hl_game_root);
	if (!HLPakMount(line))
	{
		StrPrint(line, "%s/valve/pak0.pak", hl_game_root);
		HLPakMount(line);
	}

	if (hl_pak_count)
		"  pak          mounted\n";
	else
		"  pak          none (fine - everything resolves loose)\n";

	HLTestFmt;
	HLTestNet;
	HLTestPal;
	HLTestMap("maps/c0a0.bsp");
	HLTestStudio("models/scientist.mdl");
	HLTestPics;
	HLTestSound;
	HLTestSprites;
	HLTestHud;
	HLTestSentences;
	HLTestAnim("models/scientist.mdl");
	HLTestRender("maps/c1a0.bsp");

	"\n$$GREEN$$===== done =====$$FG$$\n";
}
