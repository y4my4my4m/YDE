// server datagram out, client parse in.
//
// SV_SendClientDatagram, SV_WriteClientdataToMessage, SV_WriteEntitiesToClient,
// SV_CreateBaseline, CL_ParseServerMessage.
//
// the world source is native throughout: hl_net_pl[] for bodies,
// hl_sv_clients[] for identity, input and score, hl_entities[0] for worldspawn.
// no edict field is read.
//
// two readers and a router:
//   HLNetClientParse48   protocol 48, reads a GoldSrc stream
//   HLNetClientParse15   protocol 15, reads the loopback
//   HLNetClientParse     dispatches on hl_net_protocol
//
// HLNetWriteServerInfo, HLNetWriteClientdata and HLNetWriteEntityUpdate are
// protocol 15; the 48 signon writers are driven by Accept48 and
// HLSvSendClientSignon. HLNetServerFrame routes a slot whose netchan negotiated
// 48 to HLSv48SendFrame once signon reaches 4. HLNetParseFromClient selects the
// clc_ table from HLNetSlotIs48; same-engine peers keep the protocol-15
// clc_move payload layout on the 48 opcodes.
//
// HLNetParse48Unverified refuses svc_sound, svc_event and svc_temp_entity.
//
// protocol 48 opcodes use the plain HLSVC_/HLCLC_ names from HLNet.ZC. the four
// whose number was reused in 48, plus the wholesale-renumbered clc_ table, are
// spelled HLSVC15_/HLCLC15_ here.
#define HLSVC15_UPDATESTAT		3
#define HLSVC15_UPDATENAME		13
#define HLSVC15_UPDATEFRAGS		14
#define HLSVC15_UPDATECOLORS	17
#define HLSVC15_SELLSCREEN		33

//Protocol 15 clc_.
#define HLCLC15_BAD			0
#define HLCLC15_NOP			1
#define HLCLC15_DISCONNECT	2
#define HLCLC15_MOVE		3
#define HLCLC15_STRINGCMD	4

I64	hl_net_protocol = 15;

Bool	hl_net_want48 = FALSE;

hl_net_want48 = FALSE;


Bool HLNetSlotIs48(I64 slot)
{
	CHLNet48Chan *c;

	c = HLNet48ChanFor(slot);
	if (!c)
		return FALSE;

	return c->active;
}

Bool HLNetSendReliable(I64 slot, CHLMsg *m)
{
	if (!m || m->len < 1 || m->overflowed)
		return FALSE;

	if (HLNetSlotIs48(slot))
		return HLNet48Transmit(slot, m->data, m->len, TRUE);

	return HLNetDgrmSendReliable(slot, m);
}

Bool HLNetSendUnreliable(I64 slot, CHLMsg *m)
{
	if (!m || m->len < 1 || m->overflowed)
		return FALSE;

	if (HLNetSlotIs48(slot))
		return HLNet48Transmit(slot, m->data, m->len, FALSE);

	return HLNetDgrmSendUnreliable(slot, m);
}

