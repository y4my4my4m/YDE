	HLStrCopy(m->snd_alert,  "controller/con_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "controller/con_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "controller/con_die1.wav", 48);

	//--- barnacle. CBarnacle::Spawn, barnacle.cpp:100. 25 health, and a hull
	//that hangs BELOW the origin: UTIL_SetSize(-16,-16,-32)-(16,16,0) at :105,
	//the only monster here whose maxs z is zero, so HLAIMonHull cannot express
	//it. MOVETYPE_NONE, and flies is raised so nothing drops it to the floor.
	//
	//No walk, no run, no ranged attack and no schedule: HLAIBarnacleThink
	//replaces the whole state machine. barnacle.mdl carries idle1, idle2,
	//idle3, flinch_sm, attack1, chewcycle and death.
	m = &hl_ai_mon_info[HLMON_BARNACLE];
	HLStrCopy(m->classname, "monster_barnacle", 32);
	m->classify   = HLCLASS_ALIEN_MONSTER;
	m->health     = 25.0;			//barnacle.cpp:112, not a skill cvar
	m->fov        = 0.5;			//barnacle.cpp:114
	m->walk_speed = 0.0;
	m->run_speed  = 0.0;
	m->yaw_speed  = 0.0;
	m->flies      = TRUE;
	m->blood      = HLBLOOD_RED;
	m->view_ofs   = 0.0;
	HLVecSet(m->mins, -16.0, -16.0, -32.0);
	HLVecSet(m->maxs, 16.0, 16.0, 0.0);
	HLAIMonSeq(HLMON_BARNACLE, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_BARNACLE, HLACT_MELEE,  "attack1");
	HLAIMonSeq(HLMON_BARNACLE, HLACT_EAT,    "chewcycle");
	HLAIMonSeq(HLMON_BARNACLE, HLACT_DIE,    "death");
	HLAIMonSeq(HLMON_BARNACLE, HLACT_FLINCH, "flinch_sm");

	//snd_die is left empty: CBarnacle::Killed picks between bcl_die1 and
	//bcl_die3 on CHAN_WEAPON, barnacle.cpp:340-343, where the table's single
	//path would play one of them on CHAN_VOICE

	//--- tripmine. CTripmineGrenade::Spawn, tripmine.cpp:94. A CGrenade, not a
	//monster: no Classify, no schedule, no sequence but the held "world" pose
	//at framerate 0. health is 1 so any hit kills it (tripmine.cpp:130) and
	//range_dmg carries pev->dmg through to the blast.
	m = &hl_ai_mon_info[HLMON_TRIPMINE];
	HLStrCopy(m->classname, "monster_tripmine", 32);
	m->classify   = HLCLASS_NONE;	//CBaseEntity::Classify, cbase.h
	m->health     = 1.0;			//tripmine.cpp:130
	m->fov        = -1.0;
	m->walk_speed = 0.0;
	m->run_speed  = 0.0;
	m->yaw_speed  = 0.0;
	m->flies      = TRUE;
	m->blood      = HLBLOOD_DONT;
	m->range_dmg  = HLMINE_DAMAGE;
	m->view_ofs   = 0.0;
	HLVecSet(m->mins, -8.0, -8.0, -8.0);
	HLVecSet(m->maxs, 8.0, 8.0, 8.0);

	//--- sentry. CSentry::Spawn, turret.cpp:1165. VIEW_FIELD_FULL, a 1200 unit
	//reach, and one 9mmAR round per 0.1s think while the aim is inside 30
	//degrees. The box hangs both ways off the origin at the retract height and
	//never changes size: CSentry sets m_iRetractHeight and m_iDeployHeight to
	//the same 64.
	//
	//The body never turns - bone controllers 0 and 1 carry the whole aim - so
	//yaw_speed is unused and HLAITurretMove runs its own rate.
	m = &hl_ai_mon_info[HLMON_SENTRY];
	HLStrCopy(m->classname, "monster_sentry", 32);
	m->classify      = HLCLASS_MACHINE;
	m->health        = 40.0;		//sk_sentry_health1, valve/skill.cfg:233
	m->fov           = -1.0;		//VIEW_FIELD_FULL, turret.cpp:268
	m->look_dist     = HLTUR_RANGE;
	m->walk_speed    = 0.0;
	m->run_speed     = 0.0;
	m->yaw_speed     = 0.0;
	m->flies         = TRUE;		//MOVETYPE_FLY, turret.cpp:249
	m->blood         = HLBLOOD_DONT;
	m->view_ofs      = 48.0;		//turret.cpp:1170
