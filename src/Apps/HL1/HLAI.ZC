	//--- cockroach. CRoach::Spawn, roach.cpp:117. One health, a two-unit hull,
	//CLASS_INSECT and a relationship row that fears everything: it runs from
	//whatever it sees and dies to a footstep.
	//
	//ISoundMask is bits_SOUND_CARCASS | bits_SOUND_MEAT, roach.cpp:69 - a
	//roach hears nothing but food.
	//
	//No sequence labels: roach.mdl carries two sequences both called "run", so
	//a by-label lookup returns the first for both. They differ by activity -
	//index 0 is ACT_WALK at 30fps, index 1 is ACT_IDLE at 8 - which is what
	//HLStudioLookupActivity resolves.
	m = &hl_ai_mon_info[HLMON_COCKROACH];
	HLStrCopy(m->classname, "monster_cockroach", 32);
	m->classify   = HLCLASS_INSECT;
	m->health     = 1.0;			//roach.cpp:126
	m->fov        = -1.0;			//"can virtually see 360 degrees", :401
	m->look_dist  = HLRCH_LOOK_DIST;
	m->walk_speed = 40.0;
	m->run_speed  = 40.0;
	m->yaw_speed  = 120.0;			//SetYawSpeed, roach.cpp:110
	m->blood      = HLBLOOD_YELLOW;
	m->flees      = TRUE;
	m->sound_mask = HLSOUND_CARCASS | HLSOUND_MEAT;
	HLAIMonHull(HLMON_COCKROACH, 1.0, 2.0, 1.0);

