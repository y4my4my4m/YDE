	HLStrCopy(m->snd_die,    "agrunt/ag_die1.wav", 48);

	//--- alien controller. CController: 60 health, MOVETYPE_FLY, all-round
	//vision, view_ofs -2, a 32x64 hull. Both its attacks are projectiles - a
	//homing energy ball and a head-mounted zap - so each is fired as a hitscan.
	//
	//RANGE1 is the ball spray. controller.cpp:328 arms m_flShootEnd from the
	//event's options string and RunTask (:630-661) then spawns a
	//controller_energy_ball every 0.2s until it expires, each landing
	//sk_controller_dmgball1 (:1415). controller.mdl seq 0 attack1 carries
	//options "6" -> 0.4s -> 2 balls -> 6 damage; seq 1 attack2 carries "20" ->
	//1.33s -> 7 balls -> 21. Both are activity 28 at weight 1 and
	//LookupActivity picks between them at random; HLAIMonSeq holds one label
	//per slot, so the port always runs attack1 and the heavier take is lost.
	//
	//RANGE2 is seq 5 shoot, activity 29: one controller_head_ball at
	//sk_controller_dmgzap1 (:1233).
	//
	//CheckRangeAttack1 is 256..2048 and CheckRangeAttack2 64..2048,
	//controller.cpp:790-808.
	m = &hl_ai_mon_info[HLMON_CONTROLLER];
	HLStrCopy(m->classname, "monster_alien_controller", 32);
	m->classify     = HLCLASS_ALIEN_MILITARY;
	m->health       = 60.0;			//sk_controller_health1
	m->fov          = -1.0;			//VIEW_FIELD_FULL
	m->walk_speed   = 40.0;
	m->run_speed    = 120.0;
	m->yaw_speed    = 120.0;
	m->range_min    = 256.0;
	m->range_max    = 2048.0;
	m->range_dmg    = 6.0;			//2 balls at sk_controller_dmgball1
	m->range2_min   = 64.0;
	m->range2_max   = 2048.0;
	m->range2_dmg   = 15.0;			//sk_controller_dmgzap1
	m->attack_rate  = 1.0;
	m->flies        = TRUE;
	m->blood        = HLBLOOD_YELLOW;
	m->attack_noise = 384.0;
	HLAIMonHull(HLMON_CONTROLLER, 32.0, 64.0, -2.0);
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_IDLE,   "idle2");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RANGE,  "attack1");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RANGE2, "shoot");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_DIE,    "die1");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_FLINCH, "flinch1");
