	HLVecSet(hl_ai_mon[s].enemy_pos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].goal, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].lastpos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].heard_pos, 0.0, 0.0, 0.0);
}


//GUN_GROUP and its submodels, hgrunt.cpp:71-74
#define HLGRUNT_GUN_GROUP		2
#define HLGRUNT_GUN_MP5			0
#define HLGRUNT_GUN_SHOTGUN		1
#define HLGRUNT_GUN_NONE		2

//HEAD_GROUP and its submodels, hgrunt.cpp:66-70
#define HLGRUNT_HEAD_GROUP		1
#define HLGRUNT_HEAD_GRUNT		0
#define HLGRUNT_HEAD_SHOTGUN	2
#define HLGRUNT_HEAD_M203		3

//pev->weapons on monster_human_grunt, hgrunt.cpp:61-64.
#define HLGRUNT_W_9MMAR			1
#define HLGRUNT_W_HANDGRENADE	2
#define HLGRUNT_W_GLAUNCHER		4
#define HLGRUNT_W_SHOTGUN		8

//m_cClipSize for a shotgun grunt, hgrunt.cpp:1016
#define HLGRUNT_SHOTGUN_CLIP	8

//BARNEY_BODY_*, barney.cpp:39-41.
#define HLBARNEY_GUN_GROUP		1
#define HLBARNEY_GUN_GONE		2

I64 HLAIBodygroup(CHLStudio *m, I64 body, I64 group)
{//::GetBodygroup, animating.cpp. Which submodel of one bodypart `body` selects
	CHLStBodyPart	*bp;
	I64				 base;

	if (!m || group < 0 || group >= m->num_bodyparts)
		return 0;

	bp   = &m->bodyparts[group];
	base = bp->base;

	if (base < 1 || bp->num_models < 1)
		return 0;

	return (body / base) % bp->num_models;
}

U0 HLAISetBodygroup(CHLEntity *e, I64 group, I64 value)
{//::SetBodygroup, animating.cpp. Replaces one bodypart's digit in pev->body
	CHLStBodyPart	*bp;
	I64				 base;
	I64				 cur;

	if (!e || !e->studio || group < 0 || group >= e->studio->num_bodyparts)
		return;

	bp   = &e->studio->bodyparts[group];
	base = bp->base;

	if (base < 1 || bp->num_models < 1)
		return;

	if (value < 0 || value >= bp->num_models)
		return;

	cur = (e->body / base) % bp->num_models;

	e->body = e->body - cur * base + value * base;
}

U0 HLAIMonRegisterAll()
{
	CHLEntity	*e;
	CHLMonInfo	*mi;
	U8			*label;
	F64			 aim[3];
	I64			 i;
	I64			 kind;
	I64			 s;
	I64			 seq;
	I64			 w;
	I64			 node;

	hl_ai_script_log = FALSE;

	if (HLCvarIndex("scriptlog") < 0)
		HLCvarDefine("scriptlog", 0.0);

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent  = -1;
		hl_ai_mon[i].kind = -1;
	}

	for (i = 0; i < HLENT_MAX; i++)
	{
		hl_ai_mon_of[i] = -1;

		HLAICineResetRow(i);
		HLAITalkResetRow(i);
	}

	hl_ai_mon_count = 0;
	hl_ai_talk_wait = 0.0;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_MONSTER)
			goto qamr_next;

		kind = HLAIMonKindFor(e->classname);

		if (kind < 0)
			goto qamr_next;

		if (!e->studio)
		{
			if (kind == HLMON_BARNACLE)
				e->studio = HLStudioCacheGet("models/barnacle.mdl");
			else if (kind == HLMON_TRIPMINE)
				e->studio = HLStudioCacheGet("models/v_tripmine.mdl");
			else if (kind == HLMON_SENTRY)
				e->studio = HLStudioCacheGet("models/sentry.mdl");
			else if (kind == HLMON_TURRET)
				e->studio = HLStudioCacheGet("models/turret.mdl");
			else if (kind == HLMON_MINITURRET)
				e->studio = HLStudioCacheGet("models/miniturret.mdl");
			else if (kind == HLMON_TENTACLE)
				e->studio = HLStudioCacheGet("models/tentacle2.mdl");
			else if (kind == HLMON_NIHILANTH)
				e->studio = HLStudioCacheGet("models/nihilanth.mdl");
			else if (kind == HLMON_APACHE)
				e->studio = HLStudioCacheGet("models/apache.mdl");
			else if (kind == HLMON_OSPREY)
				e->studio = HLStudioCacheGet("models/osprey.mdl");
			else if (kind == HLMON_HEADCRAB &&
				!StrICompare(e->classname, "monster_babycrab"))
				e->studio = HLStudioCacheGet("models/baby_headcrab.mdl");

			if (e->studio)
				HLEntInitBoneControllers(e);
		}

		if (!e->studio)
			goto qamr_next;

		if (hl_ai_mon_count >= HLAI_MON_MAX)
		{
			"HLAI: more than %d monsters, the rest are idle\n", HLAI_MON_MAX;
			goto qamr_done;
		}

		s  = hl_ai_mon_count;
		mi = &hl_ai_mon_info[kind];

		hl_ai_mon[s].ent  = i;
		hl_ai_mon[s].kind = kind;
		HLAIMonReset(s);

		hl_ai_mon[s].last_health   = mi->health;
		hl_ai_mon[s].ideal_yaw     = e->angles[1];
		hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
			ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));

		hl_ai_mon[s].next_look = hl_ent_time +
			ToF64(s % 8) * (HLAI_LOOK_PERIOD / 8.0);

		hl_ai_mon_of[i] = s;
		hl_ai_mon_count++;

		HLVecCopy(mi->mins, e->mins);
		HLVecCopy(mi->maxs, e->maxs);

		if (kind == HLMON_GENERIC &&
			(StrIMatch("holo.mdl", e->studio->name) ||
			 StrIMatch("player.mdl", e->studio->name)))
		{
			HLVecSet(e->mins, -16.0, -16.0, -36.0);
			HLVecSet(e->maxs, 16.0, 16.0, 36.0);
		}

		HLEntSetAbsBox(e);

		seq = HLStudioLookupActivity(e->studio, 1);

		if (seq < 0)
		{
			label = HLAIMonSeqOf(kind, HLACT_IDLE);

			if (label)
				seq = HLStudioSeqByName(e->studio, label);
		}

		//a model with neither keeps sequence 0: a ribcage carries one pose
		if (seq >= 0)
		{
			e->seq              = seq;
			e->anim_loop        = TRUE;
			e->anim_done        = FALSE;
			e->anim_event_frame = -1;
			e->anim_start       = hl_ent_time;

			hl_ai_mon[s].act_seq = seq;
		}

		e->health     = mi->health;
		e->max_health = mi->health;
		e->takedamage = HLDMG_TAKE_YES;

		if (kind != HLMON_TRIPMINE && !HLAIIsTurretKind(kind))
		{
			e->angles[0] = 0.0;
			e->angles[2] = 0.0;
		}

		//CBarnacle::Spawn is MOVETYPE_NONE, barnacle.cpp:108.
		if (kind == HLMON_BARNACLE)
			e->movetype = HLMOVETYPE_NONE;

		//SF_GENERICMONSTER_NOTSOLID, genericmonster.cpp:121-125.
		if (kind == HLMON_GENERIC && (e->spawnflags & HLMON_SF_NOTSOLID))
		{
			e->solid      = HLSOLID_NOT;
			e->takedamage = HLDMG_TAKE_NO;
		}

		if (kind == HLMON_HGRUNT)
		{
			w = e->weapons;

			if (!w)
				w = HLGRUNT_W_9MMAR | HLGRUNT_W_HANDGRENADE;

			//hgrunt.cpp:1024-1027. Four grunts in five wear the light skin
			e->skin = 1;

			if (HLPartRandI(100) < 80)
				e->skin = 0;

			if (w & HLGRUNT_W_SHOTGUN)
			{
				HLAISetBodygroup(e, HLGRUNT_GUN_GROUP, HLGRUNT_GUN_SHOTGUN);
				HLAISetBodygroup(e, HLGRUNT_HEAD_GROUP, HLGRUNT_HEAD_SHOTGUN);

				hl_ai_mon[s].clip = HLGRUNT_SHOTGUN_CLIP;
				hl_ai_mon[s].ammo = HLGRUNT_SHOTGUN_CLIP;
			}
			else if (w & HLGRUNT_W_GLAUNCHER)
			{
				HLAISetBodygroup(e, HLGRUNT_HEAD_GROUP, HLGRUNT_HEAD_M203);
				e->skin = 1;
			}
		}

		//CBaseTurret::Spawn, turret.cpp:249-252.
		if (HLAIIsTurretKind(kind))
		{
			e->movetype  = HLMOVETYPE_FLY;
			e->solid     = HLSOLID_SLIDEBOX;
			e->seq       = 0;
			e->anim_loop = FALSE;

			hl_ai_mon[s].tur_state  = HLTUR_OFF;
			hl_ai_mon[s].tur_rate   = HLTUR_TURNRATE;
			hl_ai_mon[s].tur_orient = e->orient;

			//ceiling mount: authored orientation 1, or pitch near 180
			if (e->orient == 1 || e->angles[0] > 90.0)
			{
				hl_ai_mon[s].tur_orient = 1;
				e->angles[0] = 180.0;
				e->angles[1] = HLAngleNorm(e->angles[1] + 180.0);
			}
			else
			{
				e->angles[0] = 0.0;
			}

			e->angles[2] = 0.0;

			HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
			HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);
		}

		//CBabyCrab::Spawn, headcrab.cpp:498-506
		if (kind == HLMON_HEADCRAB &&
			!StrICompare(e->classname, "monster_babycrab"))
		{
			e->health     = mi->health * 0.25;
			e->max_health = e->health;
			hl_ai_mon[s].last_health = e->health;
			HLVecSet(e->mins, -6.0, -6.0, 0.0);
			HLVecSet(e->maxs, 6.0, 6.0, 12.0);
			HLEntSetAbsBox(e);
		}

		if (kind == HLMON_TRIPMINE)
		{
			e->movetype  = HLMOVETYPE_FLY;
			e->solid     = HLSOLID_NOT;
			e->body      = HLMINE_BODY;
			e->seq       = HLMINE_SEQ;
			e->anim_loop = FALSE;

			//framerate 0: a placed mine holds frame 0 of "world"
			e->anim_start = hl_ent_time;
			e->anim_done  = TRUE;

			HLEntSetAbsBox(e);

			hl_ai_mon[s].mine_arm = hl_ent_time + HLMINE_ARM_SLOW;

			if (e->spawnflags & HLMINE_SF_FAST)
				hl_ai_mon[s].mine_arm = hl_ent_time + HLMINE_ARM_FAST;

			//UTIL_MakeAimVectors, util.cpp
			HLVecSet(aim, -e->angles[0], e->angles[1], e->angles[2]);
			HLAngleVectors(aim, hl_ai_mon[s].mine_dir, NULL, NULL);

			HLVecMA(e->origin, HLMINE_RANGE, hl_ai_mon[s].mine_dir,
				hl_ai_mon[s].mine_end);
			HLVecCopy(hl_ai_mon[s].mine_end, hl_ai_mon[s].mine_beam);

			if (!hl_ai_laser_spr)
				hl_ai_laser_spr =
					HLEntSprCacheGet("sprites/laserbeam.spr");
		}

		if (kind == HLMON_BIGMOMMA && e->target[0])
		{
			node = HLEntFindByTargetname(e->target, 0);
			if (node >= 0 &&
				!StrCompare(hl_entities[node].classname, "info_bigmomma"))
			{
				HLVecCopy(hl_entities[node].origin, hl_ai_mon[s].goal);
				hl_ai_mon[s].have_goal     = TRUE;
				hl_ai_mon[s].goal_is_enemy = FALSE;
				hl_ai_mon[s].goal_tol      = 128.0;
			}
		}

qamr_next:
	}

qamr_done:
	if (hl_ai_mon_count)
		"HLAI: %d monsters\n", hl_ai_mon_count;
}

U0 HLAIMonSync()
{
	if (!StrCompare(hl_ai_mon_map, hl_map_name) &&
		hl_entities == hl_ai_mon_base &&
		hl_num_entities >= hl_ai_mon_ents)
	{
		hl_ai_mon_ents  = hl_num_entities;
		hl_ai_mon_clock = hl_ent_time;
		return;
	}

	HLStrCopy(hl_ai_mon_map, hl_map_name, 96);
	hl_ai_mon_base  = hl_entities;
	hl_ai_mon_ents  = hl_num_entities;
	hl_ai_mon_clock = hl_ent_time;

	hl_ai_graph_map[0] = 0;
	hl_ai_graph_ready  = FALSE;
	hl_ai_graph_tries  = 0;
	hl_ai_graph_retry  = 0.0;

	HLAIMonRegisterAll;
}


U0 HLAIPlayerOrigin(F64 *out)
{
	HLVecCopy(hl_ent_player_org, out);
}

U0 HLAIMonEye(I64 s, F64 *out)
{
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
	{
		HLVecSet(out, 0.0, 0.0, 0.0);
		return;
	}

	HLVecCopy(e->origin, out);
	out[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

	if (HLAIIsTurretKind(hl_ai_mon[s].kind) && hl_ai_mon[s].tur_orient == 1)
		out[2] -= 2.0 * hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;
}

Bool HLAITargetIsPlayer(I64 target)
{//the player is target -1; every other index is an entity
	return ToBool(target < 0);
}

F64 HLAITargetHealth(I64 target)
{
	CHLEntity *e;

	if (HLAITargetIsPlayer(target))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return 0.0;

		return hl_ent_player_health;
	}

	e = HLEntGet(target);

	if (!e)
		return 0.0;

	return e->health;
}

Bool HLAITargetPos(I64 target, F64 *feet, F64 *eye)
{
	CHLEntity	*e;
	I64			 s;

	if (HLAITargetIsPlayer(target))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(feet);
		HLVecCopy(feet, eye);
		eye[2] += HLPHYS_VIEW_Z;

		return TRUE;
	}

	e = HLEntGet(target);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = -1;

	if (target < HLENT_MAX)
		s = hl_ai_mon_of[target];

	if (s < 0)
		return FALSE;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return FALSE;

	HLVecCopy(e->origin, feet);
	HLVecCopy(e->origin, eye);
	eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

	return TRUE;
}

I64 HLAITargetClass(I64 target)
{
	I64 s;

	if (HLAITargetIsPlayer(target))
		return HLCLASS_PLAYER;

	if (target < 0 || target >= HLENT_MAX)
		return HLCLASS_NONE;

	s = hl_ai_mon_of[target];

	if (s < 0)
		return HLCLASS_NONE;

	//CBaseTurret::Classify, turret.cpp:1129
	if (HLAIIsTurretKind(hl_ai_mon[s].kind) &&
		hl_ai_mon[s].tur_state == HLTUR_OFF)
		return HLCLASS_NONE;

	return hl_ai_mon_info[hl_ai_mon[s].kind].classify;
}

Bool HLAIInViewCone(I64 s, F64 *point)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 forward[3];
	F64			 ang[3];
	F64			 dir[3];

	if (!e)
		return FALSE;

	HLVecSet(ang, 0.0, e->angles[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(point, e->origin, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return TRUE;

	return ToBool(HLVecDot(dir, forward) >=
		hl_ai_mon_info[hl_ai_mon[s].kind].fov);
}

Bool HLAIPlayerSees(F64 *point)
{
	F64 forward[3];
	F64 ang[3];
	F64 dir[3];

	HLVecSet(ang, 0.0, hl_ent_player_ang[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(point, hl_ent_player_org, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return TRUE;

	return ToBool(HLVecDot(dir, forward) >= 0.7);
}

Bool HLAIVisible(I64 s, F64 *target_eye)
{
	CHLTrace	tr;
	F64			 eye[3];
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLAIMonEye(s, eye);
	HLVecSet(zero, 0.0, 0.0, 0.0);

	HLTraceEntity(hl_map, eye, target_eye, zero, zero, 0, TRUE, &tr);

	if (tr.in_open && tr.in_water)
		return FALSE;

	return ToBool(tr.fraction >= 1.0);
}

U0 HLAILook(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best      = -1;
	I64			 best_rel  = 0;
	I64			 rel;
	I64			 sighted   = 0;
	I64			 target;
	I64			 i;
	Bool		 found     = FALSE;
	Bool		 is_player;

	HLAIClearCond(s, HLCOND_SEE_HATE | HLCOND_SEE_DISLIKE | HLCOND_SEE_FEAR |
		HLCOND_SEE_ENEMY | HLCOND_SEE_CLIENT);

	if (!e)
		return;

	//See no evil if prisoner is set, monsters.cpp:316-317
	if (e->spawnflags & HLAI_SF_MONSTER_PRISONER)
		return;

	mi        = &hl_ai_mon_info[hl_ai_mon[s].kind];
	best_dist = mi->look_dist;

	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;
		is_player = FALSE;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qal_next;

			//don't see prisoners, monsters.cpp:330
			if (hl_entities[i].spawnflags & HLAI_SF_MONSTER_PRISONER)
				goto qal_next;
		}
		else
		{
			is_player = TRUE;

			if (hl_ent_notarget)
			{
				goto qal_next;
			}
		}

		rel = HLAIRelationship(mi->classify, HLAITargetClass(target));

		if (rel == HLREL_NONE)
			goto qal_next;

		if (rel == HLREL_ALLY && !is_player)
			goto qal_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qal_next;

		HLVecSub(feet, e->origin, d);
		dist = HLVecLength(d);

		if (dist > mi->look_dist)
			goto qal_next;

		if (!HLAIInViewCone(s, feet))
			goto qal_next;

		if (!HLAIVisible(s, eye))
			goto qal_next;

		if (is_player)
		{
			//SF_MONSTER_WAIT_TILL_SEEN, monsters.cpp:339
			if (e->spawnflags & HLAI_SF_MONSTER_WAIT_TILL_SEEN)
			{
				if (!HLAIPlayerSees(e->origin))
					goto qal_next;

				e->spawnflags = e->spawnflags & ~HLAI_SF_MONSTER_WAIT_TILL_SEEN;
			}

			sighted = sighted | HLCOND_SEE_CLIENT;
		}

		if (rel == HLREL_ALLY)
			goto qal_next;

		//iSighted, monsters.cpp:358-397.
		if (target == hl_ai_mon[s].enemy && hl_ai_mon[s].have_enemy)
			sighted = sighted | HLCOND_SEE_ENEMY;

		if (rel == HLREL_HATE)
			sighted = sighted | HLCOND_SEE_HATE;
		else if (rel == HLREL_DISLIKE)
			sighted = sighted | HLCOND_SEE_DISLIKE;
		else if (rel == HLREL_FEAR)
			sighted = sighted | HLCOND_SEE_FEAR;

		if (found)
		{
			if (rel < best_rel)
				goto qal_next;

			if (rel == best_rel && dist >= best_dist)
				goto qal_next;
		}

		best      = target;
		best_rel  = rel;
		best_dist = dist;
		found     = TRUE;

qal_next:
		i++;
	}

	HLAISetCond(s, sighted);

	if (!found)
		return;

	//bits_COND_NEW_ENEMY, monsters.cpp:3363.
	if (!hl_ai_mon[s].have_enemy || hl_ai_mon[s].enemy != best)
	{
		HLAISetCond(s, HLCOND_NEW_ENEMY);
		HLAIClearCond(s, HLCOND_ENEMY_DEAD);
	}

	hl_ai_mon[s].have_enemy = TRUE;
	hl_ai_mon[s].enemy      = best;
	hl_ai_mon[s].enemy_seen = hl_ent_time;

	HLAISetCond(s, HLCOND_SEE_ENEMY);

	if (HLAITargetPos(best, feet, eye))
		HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
}


I64 HLAIBestSound(I64 s)
{
	CHLMonInfo	*mi;
	F64			 ear[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 mask;
	I64			 sched;
	I64			 best = -1;
	I64			 i;

	if (hl_ai_mon[s].kind < 0)
		return -1;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//"iMySounds &= m_pSchedule->iSoundMask", monsters.cpp:216.
	mask  = mi->sound_mask;
	sched = hl_ai_mon[s].sched;

	if (sched > HLSCHED_NONE && sched < HLSCHED_COUNT)
		mask = mask & hl_ai_sched_snd[sched];

	if (!mask)
		return -1;

	HLAIMonEye(s, ear);

	best_dist = 8192.0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			goto qabs_next;

		if (!(hl_ai_snd[i].type & mask))
			goto qabs_next;

		HLVecSub(hl_ai_snd[i].origin, ear, d);
		dist = HLVecLength(d);

		if (dist > hl_ai_snd[i].volume * mi->hear_sens)
			goto qabs_next;

		if (dist >= best_dist)
			goto qabs_next;

		best      = i;
		best_dist = dist;

qabs_next:
	}

	return best;
}

U0 HLAIListen(I64 s)
{
	I64 i;

	//"ClearConditions(bits_COND_HEAR_SOUND)", monsters.cpp:207
	HLAIClearCond(s, HLCOND_HEAR_SOUND);

	i = HLAIBestSound(s);

	if (i < 0)
	{
		hl_ai_mon[s].heard = -1;
		return;
	}

	hl_ai_mon[s].heard      = i;
	hl_ai_mon[s].heard_type = hl_ai_snd[i].type;

	HLAISetCond(s, HLCOND_HEAR_SOUND);

	HLVecCopy(hl_ai_snd[i].origin, hl_ai_mon[s].heard_pos);
}

U0 HLAISmell(I64 s)
{
	CHLMonInfo	*mi;
	F64			 nose[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 mask;
	I64			 best = -1;
	I64			 i;
	I64			 t;

	HLAIClearCond(s, HLCOND_SMELL | HLCOND_SMELL_FOOD);
	hl_ai_mon[s].have_smell = FALSE;
	hl_ai_mon[s].smell_type = HLSOUND_NONE;

	if (hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	mask = mi->sound_mask & (HLSOUND_CARCASS | HLSOUND_MEAT | HLSOUND_GARBAGE);

	if (!mask)
		return;

	HLAIMonEye(s, nose);
	best_dist = 8192.0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			goto qasm_next;

		t = hl_ai_snd[i].type;

		if (!(t & mask))
			goto qasm_next;

		HLVecSub(hl_ai_snd[i].origin, nose, d);
		dist = HLVecLength(d);

		if (dist > hl_ai_snd[i].volume * mi->hear_sens)
			goto qasm_next;

		if (dist >= best_dist)
			goto qasm_next;

		best      = i;
		best_dist = dist;

qasm_next:
	}

	if (best < 0)
		return;

	hl_ai_mon[s].have_smell = TRUE;
	hl_ai_mon[s].smell_type = hl_ai_snd[best].type;
	HLVecCopy(hl_ai_snd[best].origin, hl_ai_mon[s].smell_pos);

	HLAISetCond(s, HLCOND_SMELL);

	if (hl_ai_snd[best].type & (HLSOUND_CARCASS | HLSOUND_MEAT))
		HLAISetCond(s, HLCOND_SMELL_FOOD);
}


Bool HLAIInSquad(I64 s)
{
	return ToBool(hl_ai_mon[s].squad >= 0);
}

I64 HLAISquadLeader(I64 s)
{
	if (hl_ai_mon[s].squad < 0)
		return s;

	return hl_ai_mon[s].squad;
}

Bool HLAIIsLeader(I64 s)
{
	return ToBool(hl_ai_mon[s].squad == s);
}

I64 HLAISquadCount(I64 s)
{
	I64 leader;
	I64 n = 0;
	I64 i;

	if (!HLAIInSquad(s))
		return 0;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && hl_ai_mon[i].state != HLMSTATE_DEAD)
			n++;
	}

	return n;
}

Bool HLAISquadEnemySplit(I64 s)
{
	I64		leader;
	I64		i;
	Bool	have;
	I64		want;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);
	have   = hl_ai_mon[leader].have_enemy;
	want   = hl_ai_mon[leader].enemy;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader)
			goto qaes_next;

		if (!hl_ai_mon[i].have_enemy)
			goto qaes_next;

		if (!have || hl_ai_mon[i].enemy != want)
			return TRUE;

qaes_next:
	}

	return FALSE;
}

Bool HLAIOccupySlot(I64 s, I64 desired)
{
	I64 leader;
	I64 mask;
	I64 i;

	if (!HLAIInSquad(s))
		return TRUE;

	if (HLAISquadEnemySplit(s))
	{
		hl_ai_mon[s].my_slot = HLSLOT_SQUAD_SPLIT;
		return TRUE;
	}

	leader = HLAISquadLeader(s);

	if (hl_ai_mon[s].my_slot & desired)
		return TRUE;

	if (!(desired & ~hl_ai_mon[leader].squad_slots))
		return FALSE;

	for (i = 0; i < HLAI_NUM_SLOTS; i++)
	{
		mask = 1 << i;

		if (!(desired & mask))
			goto qaos_next;

		if (hl_ai_mon[leader].squad_slots & mask)
			goto qaos_next;

		hl_ai_mon[leader].squad_slots |= mask;
		hl_ai_mon[s].my_slot = mask;

		return TRUE;

qaos_next:
	}

	return FALSE;
}

U0 HLAIVacateSlot(I64 s)
{
	I64 leader;

	if (hl_ai_mon[s].my_slot == HLSLOT_NONE || !HLAIInSquad(s))
	{
		hl_ai_mon[s].my_slot = HLSLOT_NONE;
		return;
	}

	leader = HLAISquadLeader(s);

	hl_ai_mon[leader].squad_slots &= ~hl_ai_mon[s].my_slot;
	hl_ai_mon[s].my_slot = HLSLOT_NONE;
}

Bool HLAISquadMemberInRange(I64 s, F64 *loc, F64 dist)
{
	F64	d[3];
	I64	leader;
	I64	i;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasm_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qasm_next;

		HLVecSub(loc, hl_entities[hl_ai_mon[i].ent].origin, d);
		d[2] = 0.0;

		if (HLVecLength(d) <= dist)
			return TRUE;

qasm_next:
	}

	return FALSE;
}

Bool HLAIValidateCover(I64 s, F64 *cover)
{
	return ToBool(!HLAISquadMemberInRange(s, cover, 128.0));
}

Bool HLAINoFriendlyFire(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dir[3];
	F64			 rel[3];
	F64			 along;
	F64			 range;
	F64			 off;
	I64			 leader;
	I64			 i;

	if (!e || !HLAIInSquad(s) || !hl_ai_mon[s].have_enemy)
		return TRUE;

	HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, dir);
	dir[2] = 0.0;

	range = HLVecNormalize(dir);

	if (range <= 0.0)
		return TRUE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qanf_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qanf_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qanf_next;

		HLVecSub(hl_entities[hl_ai_mon[i].ent].origin, e->origin, rel);
		rel[2] = 0.0;

		along = HLVecDot(rel, dir);

		if (along <= 0.0 || along >= range)
			goto qanf_next;

		HLVecMA(rel, -along, dir, rel);

		off = HLVecLength(rel);

		if (off < 32.0)
			return FALSE;

qanf_next:
	}

	return TRUE;
}

U0 HLAISquadAdd(I64 leader, I64 s)
{
	if (hl_ai_mon[s].squad >= 0)
		return;

	hl_ai_mon[s].squad     = leader;
	hl_ai_mon[s].my_slot   = HLSLOT_NONE;
	hl_ai_mon[leader].squad = leader;
}

U0 HLAISquadRemove(I64 s)
{
	I64 leader;
	I64 heir = -1;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	HLAIVacateSlot(s);

	leader = HLAISquadLeader(s);

	hl_ai_mon[s].squad = -1;

	if (leader != s)
		return;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && i != s &&
			hl_ai_mon[i].state != HLMSTATE_DEAD)
		{
			heir = i;
			goto qasr_found;
		}
	}

qasr_found:
	if (heir < 0)
	{
		for (i = 0; i < hl_ai_mon_count; i++)
		{
			if (hl_ai_mon[i].squad == leader)
			{
				hl_ai_mon[i].squad   = -1;
				hl_ai_mon[i].my_slot = HLSLOT_NONE;
			}
		}

		return;
	}

	hl_ai_mon[heir].squad_slots = hl_ai_mon[leader].squad_slots;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader)
			hl_ai_mon[i].squad = heir;
	}

	hl_ai_mon[heir].squad = heir;
}

U0 HLAISquadMakeEnemy(I64 s, I64 enemy)
{
	I64 leader;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasme_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qasme_next;

		if (hl_ai_mon[i].have_enemy && hl_ai_mon[i].enemy == enemy)
			goto qasme_next;

		if (hl_ai_mon[i].have_enemy &&
			hl_ent_time - hl_ai_mon[i].enemy_seen <= HLAI_LOOK_PERIOD * 2.0)
			goto qasme_next;

		hl_ai_mon[i].have_enemy = TRUE;
		hl_ai_mon[i].enemy      = enemy;

		HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[i].enemy_pos);

		hl_ai_mon[i].enemy_seen = hl_ent_time - HLAI_LOSE_ENEMY * 0.5;

		hl_ai_mon[i].sched      = HLSCHED_NONE;
		hl_ai_mon[i].sched_done = TRUE;

		if (hl_ai_mon[i].state == HLMSTATE_IDLE)
			hl_ai_mon[i].state = HLMSTATE_ALERT;

qasme_next:
	}
}

I64 HLAISquadRecruit(I64 s, F64 radius, I64 max_members)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*re;
	F64			 my_eye[3];
	F64			 their_eye[3];
	F64			 d[3];
	I64			 count = 1;
	I64			 i;

	if (!e || hl_ai_mon[s].squad >= 0 || max_members < 2)
		return 0;

	hl_ai_mon[s].squad       = s;
	hl_ai_mon[s].squad_slots = 0;

	HLAIMonEye(s, my_eye);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (count >= max_members)
			goto qasrc_done;

		if (i == s || hl_ai_mon[i].squad >= 0)
			goto qasrc_next;

		if (hl_ai_mon[i].kind != hl_ai_mon[s].kind)
			goto qasrc_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD || hl_ai_mon[i].scripted)
			goto qasrc_next;

		re = HLEntGet(hl_ai_mon[i].ent);

		if (!re)
			goto qasrc_next;

		HLVecSub(re->origin, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qasrc_next;

		HLAIMonEye(i, their_eye);

		if (!HLAIVisible(s, their_eye))
			goto qasrc_next;

		HLAISquadAdd(s, i);
		count++;

qasrc_next:
	}

qasrc_done:
	if (count == 1)
	{
		hl_ai_mon[s].squad = -1;
		return 0;
	}

	return count;
}


F64 HLAIYawTo(F64 *from, F64 *to)
{
	F64 d[3];

	HLVecSub(to, from, d);
	d[2] = 0.0;

	if (HLVecNormalize(d) <= 0.0)
		return 0.0;

	return Arg(d[0], d[1]) / HLDEG2RAD;
}

F64 HLAIYawDiff(F64 want, F64 have)
{
	F64 d = HLAngleNorm(want) - HLAngleNorm(have);

	if (d > 180.0)
		d -= 360.0;

	if (d < -180.0)
		d += 360.0;

	return d;
}

Bool HLAITurnToward(I64 s, F64 want, F64 dt)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 diff;
	F64			 step;

	if (!e)
		return TRUE;

	hl_ai_mon[s].ideal_yaw = HLAngleNorm(want);

	diff = HLAIYawDiff(want, e->angles[1]);
	step = hl_ai_mon_info[hl_ai_mon[s].kind].yaw_speed * dt;

	if (diff < 0.0)
	{
		if (step > -diff)
			step = -diff;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > diff)
			step = diff;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}

	if (diff < 0.0)
		diff = -diff;

	return ToBool(diff <= HLAI_FACE_TOL);
}


#define HLAI_MOVE_OK		0
#define HLAI_MOVE_ARRIVED	1
#define HLAI_MOVE_BLOCKED	2

//LOCALMOVE_*, monsters.h:28-30
#define HLAI_LM_INVALID		0
#define HLAI_LM_NOTRI		1
#define HLAI_LM_VALID		2

#define HLAI_LOCAL_STEP		16.0	//LOCAL_STEP_SIZE, monsters.cpp:1299
#define HLAI_DIST_CHECK		200.0	//DIST_TO_CHECK, monsters.cpp:1796
#define HLAI_MOVE_CHECK		0.1

Bool HLAIDropToFloor(CHLEntity *e, F64 *pos, F64 *out)
{
	CHLTrace	tr;
	F64			 up[3];
	F64			 down[3];

	HLVecCopy(pos, up);
	up[2] += HLAI_STEP_HEIGHT;

	HLTraceEntity(hl_map, pos, up, e->mins, e->maxs, 0, TRUE, &tr);
	HLVecCopy(tr.end_pos, up);

	HLVecCopy(up, down);
	down[2] -= HLAI_STEP_HEIGHT * 3.0;

	HLTraceEntity(hl_map, up, down, e->mins, e->maxs, 0, TRUE, &tr);

	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

Bool HLAIDropToFloorHard(CHLEntity *e, F64 *mins, F64 *maxs, F64 *out)
{//DROP_TO_FLOOR
	CHLTrace	tr;
	F64			 start[3];
	F64			 end[3];

	if (!e || !hl_map)
		return FALSE;

	HLVecCopy(e->origin, start);
	start[2] += 1.0;

	HLVecCopy(start, end);
	end[2] -= HLAI_DROP_DIST;

	HLTraceEntity(hl_map, start, end, mins, maxs, 0, TRUE, &tr);

	if (tr.all_solid || tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

Bool HLAIStepTo(I64 s, F64 *from, F64 *to, F64 *out)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 up[3];
	F64			 over[3];
	F64			 down[3];
	Bool		 ok = FALSE;

	if (!e || !hl_map)
		return FALSE;

	hl_ent_clip_ignore   = hl_ai_mon[s].ent;
	hl_clip_for_monster  = TRUE;

	if (hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		HLTraceEntity(hl_map, from, to, e->mins, e->maxs, 0, FALSE, &tr);

		if (!tr.all_solid && !tr.start_solid && tr.fraction >= 1.0)
		{
			HLVecCopy(to, out);
			ok = TRUE;
		}

		hl_ent_clip_ignore  = -1;
		hl_clip_for_monster = FALSE;

		return ok;
	}

	HLVecCopy(from, up);
	up[2] += HLAI_STEP_HEIGHT;

	HLVecCopy(to, over);
	over[2] = up[2];

	HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

	if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
	{
		up[2]   = from[2];
		over[2] = from[2];

		HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

		if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
		{
			hl_ent_clip_ignore  = -1;
			hl_clip_for_monster = FALSE;
			return FALSE;
		}
	}

	HLVecCopy(over, down);
	down[2] -= HLAI_STEP_HEIGHT * 2.0;

	HLTraceEntity(hl_map, over, down, e->mins, e->maxs, 0, FALSE, &tr);

	hl_ent_clip_ignore  = -1;
	hl_clip_for_monster = FALSE;

	if (tr.all_solid || tr.start_solid)
		return FALSE;

	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

I64 HLAICheckLocalMove(I64 s, F64 *start, F64 *end, F64 *_dist)
{//::CheckLocalMove, monsters.cpp:1300.
	F64	at[3];
	F64	to[3];
	F64	dir[3];
	F64	dist;
	F64	walked;
	F64	size;

	if (_dist)
		*_dist = 0.0;

	HLVecSub(end, start, dir);
	dir[2] = 0.0;

	dist = HLVecNormalize(dir);

	if (dist <= 0.0)
		return HLAI_LM_VALID;

	HLVecCopy(start, at);

	walked = 0.0;

	while (walked < dist)
	{
		size = HLAI_LOCAL_STEP;

		//the last hop stops one unit short of the goal, monsters.cpp:1344-1345
		if (walked + HLAI_LOCAL_STEP >= dist - 1.0)
			size = (dist - walked) - 1.0;

		if (size <= 0.0)
			goto qclm_done;

		HLVecMA(at, size, dir, to);

		if (!HLAIStepTo(s, at, to, at))
		{
			if (_dist)
				*_dist = walked;

			return HLAI_LM_INVALID;
		}

		walked += HLAI_LOCAL_STEP;
	}

qclm_done:
	if (_dist)
		*_dist = dist;

	if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		if (end[2] - at[2] > 64.0 || at[2] - end[2] > 64.0)
			return HLAI_LM_NOTRI;
	}

	return HLAI_LM_VALID;
}

Bool HLAITriangulate(I64 s, F64 *start, F64 *end, F64 dist, F64 *apex)
{//::FTriangulate, monsters.cpp:1626.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 fwd[3];
	F64			 side[3];
	F64			 rise[3];
	F64			 ahead[3];
	F64			 left[3];
	F64			 right[3];
	F64			 top[3];
	F64			 bottom[3];
	F64			 push[3];
	F64			 pushz[3];
	F64			 size_x;
	F64			 size_z;
	Bool		 flies;
	I64			 i;

	if (!e)
		return FALSE;

	flies = hl_ai_mon_info[hl_ai_mon[s].kind].flies;

	size_x = e->maxs[0] - e->mins[0];

	if (size_x < 24.0)
		size_x = 24.0;
	else if (size_x > 48.0)
		size_x = 48.0;

	size_z = e->maxs[2] - e->mins[2];

	HLVecSub(end, start, fwd);

	if (HLVecNormalize(fwd) <= 0.0)
		return FALSE;

	HLVecSet(rise, 0.0, 0.0, 1.0);
	HLVecCross(fwd, rise, side);

	HLVecMA(start, dist + size_x, fwd, ahead);

	HLVecMA(ahead, -(size_x * 3.0), side, left);
	HLVecMA(ahead, size_x * 3.0, side, right);

	//over and under, for a flier only, monsters.cpp:1662-1665
	HLVecMA(start, dist, fwd, ahead);
	HLVecMA(ahead, size_z * 3.0, rise, top);
	HLVecMA(ahead, -(size_z * 3.0), rise, bottom);

	HLVecScale(side, size_x * 2.0, push);
	HLVecScale(rise, size_z * 2.0, pushz);

	for (i = 0; i < 8; i++)
	{
		if (HLAICheckLocalMove(s, start, right, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, right, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(right, apex);
				return TRUE;
			}
		}

		if (HLAICheckLocalMove(s, start, left, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, left, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(left, apex);
				return TRUE;
			}
		}

		if (flies)
		{
			if (HLAICheckLocalMove(s, start, top, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, top, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(top, apex);
					return TRUE;
				}
			}

			if (HLAICheckLocalMove(s, start, bottom, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, bottom, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(bottom, apex);
					return TRUE;
				}
			}
		}

		HLVecAdd(right, push, right);
		HLVecSub(left, push, left);

		if (flies)
		{
			HLVecAdd(top, pushz, top);
			HLVecSub(bottom, pushz, bottom);
		}
	}

	return FALSE;
}

F64 HLAIGroundSpeed(I64 s, F64 fallback)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 gs;

	if (e && e->studio)
	{
		gs = HLStudioSeqGroundSpeed(e->studio, e->seq);

		if (gs > 0.0)
			return gs;
	}

	return fallback;
}

I64 HLAIMoveStep(I64 s, F64 speed, F64 dt)
{//::Move plus ::MoveExecute, monsters.cpp:1798 and :1980, for one tick
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 way[3];
	F64			 dir[3];
	F64			 at[3];
	F64			 to[3];
	F64			 apex[3];
	F64			 tgt[3];
	F64			 dist;
	F64			 tol;
	F64			 check;
	F64			 hit;
	F64			 ground;
	F64			 total;
	F64			 sub;
	F64			 closed;
	I64			 local;
	I64			 route;
	I64			 guard;

	if (!e || !hl_map || !hl_ai_mon[s].have_goal)
		return HLAI_MOVE_BLOCKED;

	if (HLAIRouteStale(s))
		HLAIRouteClear(s);

	//AdvanceRoute, monsters.cpp:768
	guard = 0;

	while (TRUE)
	{
		HLAIWayPoint(s, way, &tol);

		HLVecSub(way, e->origin, dir);
		dir[2] = 0.0;

		dist = HLVecNormalize(dir);

		if (dist > tol)
			goto qms_have_way;

		if (!HLAIAdvanceWay(s))
			return HLAI_MOVE_ARRIVED;

		guard++;

		if (guard > HLNODE_PATH_MAX + 2)
			return HLAI_MOVE_ARRIVED;
	}

qms_have_way:

	ground = HLAIGroundSpeed(s, speed);

	if (ground <= 0.0)
		return HLAI_MOVE_OK;

	if (hl_ent_time >= hl_ai_mon[s].next_move_check)
	{
		hl_ai_mon[s].next_move_check = hl_ent_time + HLAI_MOVE_CHECK;

		check = HLAI_DIST_CHECK;

		if (dist < check)
			check = dist;

		HLVecMA(e->origin, check, dir, to);

		hit   = 0.0;
		local = HLAICheckLocalMove(s, e->origin, to, &hit);

		if (local != HLAI_LM_VALID)
		{
			//BuildRoute's order, monsters.cpp:751-790
			if (local == HLAI_LM_NOTRI)
				goto qms_try_nodes;

			if (!HLAITriangulate(s, e->origin, way, hit, apex))
				goto qms_try_nodes;

			hl_ai_mon[s].have_detour = TRUE;
			HLVecCopy(apex, hl_ai_mon[s].detour);

			HLVecSub(apex, e->origin, dir);
			dir[2] = 0.0;

			dist = HLVecNormalize(dir);

			if (dist <= 0.0)
				return HLAI_MOVE_BLOCKED;

			goto qms_routed;

qms_try_nodes:
			route = HLAINodeRoute(s, hl_ai_mon[s].goal);

			if (route == HLAI_ROUTE_NONE)
				return HLAI_MOVE_BLOCKED;

			if (route == HLAI_ROUTE_OK)
			{
				HLAIWayPoint(s, way, &tol);

				HLVecSub(way, e->origin, dir);
				dir[2] = 0.0;

				dist = HLVecNormalize(dir);

				if (dist <= 0.0)
					return HLAI_MOVE_BLOCKED;
			}

qms_routed:
		}
	}

	HLVecMA(e->origin, dist, dir, tgt);

	total = ground * dt;

	if (total > dist)
		total = dist;

	HLVecCopy(e->origin, at);

	while (total > 0.001)
	{
		sub = HLAI_LOCAL_STEP;

		if (sub > total)
			sub = total;

		HLVecMA(at, sub, dir, to);

		if (!HLAIStepTo(s, at, to, at))
			goto qms_moved;

		total -= sub;
	}

qms_moved:
	HLVecSub(tgt, at, to);
	to[2] = 0.0;
	closed = dist - HLVecLength(to);

	HLVecCopy(at, e->origin);
	HLEntSetAbsBox(e);

	if (closed < ground * dt * 0.2)
	{
		if (hl_ai_mon[s].stuck_since <= 0.0)
			hl_ai_mon[s].stuck_since = hl_ent_time;
		else if (hl_ent_time - hl_ai_mon[s].stuck_since >= HLAI_STUCK_TIME)
			return HLAI_MOVE_BLOCKED;
	}
	else
		hl_ai_mon[s].stuck_since = 0.0;

	return HLAI_MOVE_OK;
}


#define HLAI_COVER_STEPS	8
#define HLAI_COVER_RANGE	3
#define HLAI_COVER_STEP		96.0

Bool HLAICoverSpotOk(I64 s, F64 *spot, F64 *threat, Bool need_hidden)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 floor[3];
	F64			 eye[3];
	F64			 zero[3];

	if (!e || !hl_map)
		return FALSE;

	if (!HLAIDropToFloor(e, spot, floor))
		return FALSE;

	HLTraceEntity(hl_map, e->origin, floor, e->mins, e->maxs, 0, TRUE, &tr);

	if (tr.fraction < 1.0)
		return FALSE;

	if (need_hidden)
	{
		HLVecCopy(floor, eye);
		eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

		HLVecSet(zero, 0.0, 0.0, 0.0);

		HLTraceEntity(hl_map, threat, eye, zero, zero, 0, TRUE, &tr);

		if (tr.fraction >= 1.0)
			return FALSE;
	}

	if (!HLAIValidateCover(s, floor))
		return FALSE;

	HLVecCopy(floor, spot);

	return TRUE;
}

Bool HLAIFindNodeCover(I64 s, F64 *threat, Bool need_hidden, F64 *out)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 spot[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best = -1;
	I64			 hint;
	I64			 i;

	if (!e || hl_ai_node_count <= 0)
		return FALSE;

	best_dist = 8192.0;

	for (i = 0; i < hl_ai_node_count; i++)
	{
		hint = hl_ai_node_hint[i];

		if (hint != HLHINT_COVER_MED && hint != HLHINT_COVER_LOW)
			goto qfnc_next;

		spot[0] = hl_ai_node_org[i * 3];
		spot[1] = hl_ai_node_org[i * 3 + 1];
		spot[2] = hl_ai_node_org[i * 3 + 2];
		HLVecSub(spot, e->origin, d);
		dist = HLVecLength(d);

		if (dist >= best_dist)
			goto qfnc_next;

		if (!HLAICoverSpotOk(s, spot, threat, need_hidden))
			goto qfnc_next;

		best      = i;
		best_dist = dist;

qfnc_next:
	}

	if (best < 0)
		return FALSE;

	out[0] = hl_ai_node_org[best * 3];
	out[1] = hl_ai_node_org[best * 3 + 1];
	out[2] = hl_ai_node_org[best * 3 + 2];
	return TRUE;
}

Bool HLAIFindCover(I64 s, F64 *threat, Bool need_hidden, F64 *out)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 away[3];
	F64			 dir[3];
	F64			 spot[3];
	F64			 base;
	F64			 ang;
	I64			 step;
	I64			 ring;
	I64			 turn;

	if (!e)
		return FALSE;

	HLVecSub(e->origin, threat, away);
	away[2] = 0.0;

	if (HLVecNormalize(away) <= 0.0)
		HLVecSet(away, 1.0, 0.0, 0.0);

	base = Arg(away[0], away[1]) / HLDEG2RAD;

	for (ring = 1; ring <= HLAI_COVER_RANGE; ring++)
	{
		for (step = 0; step < HLAI_COVER_STEPS; step++)
		{
			turn = ToI64(ToF64(step + 1) / 2.0);

			if (step & 1)
				ang = base + ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));
			else
				ang = base - ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));

			HLVecSet(dir, Cos(ang * HLDEG2RAD), Sin(ang * HLDEG2RAD), 0.0);
			HLVecMA(e->origin, ToF64(ring) * HLAI_COVER_STEP, dir, spot);

			if (HLAICoverSpotOk(s, spot, threat, need_hidden))
			{
				HLVecCopy(spot, out);
				return TRUE;
			}
		}
	}

	return HLAIFindNodeCover(s, threat, need_hidden, out);
}


U0 HLAIMonSound(I64 s, U8 *path)
{
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !path || !path[0])
		return;

	HLSndPlayAt(path, e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_VOICE);
}

U0 HLDmgHurt(I64 target, I64 attacker, F64 damage, I64 bits)
{
	CHLEntity	*e = HLEntGet(target);
	F64			 left;

	if (damage <= 0.0)
		return;

	left = 0.0;

	if (e)
		left = e->health - damage;

	HLDmgNote(target, bits, left);
	HLEntTakeDamageType(target, attacker, damage, bits);
}

U0 HLAIHurt(I64 target, I64 attacker, F64 damage, I64 bits = HLDMG_GENERIC)
{
	CHLEntity *a;

	if (damage <= 0.0)
		return;

	if (HLAITargetIsPlayer(target))
	{
		a = HLEntGet(attacker);

		if (a)
			HLEntHurtPlayer(damage, HLDMG_GENERIC, a->origin);
		else
			HLEntHurtPlayer(damage);

		return;
	}

	HLDmgHurt(target, attacker, damage, bits);
}

U0 HLAIBlastDamage(I64 s, F64 radius, F64 damage)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 mine;
	I64			 target;
	I64			 i;
	I64			 pack;

	if (!e)
		return;

	//houndeye.cpp:628-631
	pack = HLAISquadCount(s);

	if (pack > 1)
		damage = damage + damage * 1.1 * ToF64(pack - 1);

	mine   = hl_ai_mon_info[hl_ai_mon[s].kind].classify;
	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qabd_next;
		}

		if (HLAIRelationship(mine, HLAITargetClass(target)) <= HLREL_NONE)
			goto qabd_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qabd_next;

		HLVecSub(feet, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qabd_next;

		//DMG_SONIC|DMG_ALWAYSGIB
		HLAIHurt(target, hl_ai_mon[s].ent, damage,
			HLDMG_SONIC | HLDMG_ALWAYSGIB);

qabd_next:
		i++;
	}
}

U0 HLAIAttackNoise(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->attack_noise <= 0.0)
		return;

	HLAIInsertSound(HLSOUND_COMBAT, e->origin, mi->attack_noise, 0.3);
}

Bool HLAIHullAttack(I64 s, F64 reach, F64 damage, I64 bits = HLDMG_SLASH)
{//CheckTraceHullAttack, dlls/combat.cpp:1133
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	I64			 blood;
	I64			 vs;

	if (!e || !hl_ai_mon[s].have_enemy)
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (dist > reach)
		return FALSE;

	if (!HLAIInViewCone(s, feet))
		return FALSE;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, damage, bits);

	blood = HLBLOOD_RED;

	if (!HLAITargetIsPlayer(hl_ai_mon[s].enemy))
	{
		vs = hl_ai_mon_of[hl_ai_mon[s].enemy];

		if (vs >= 0 && hl_ai_mon[vs].kind >= 0)
			blood = hl_ai_mon_info[hl_ai_mon[vs].kind].blood;
	}

	HLVecNormalize(d);
	d[2] = 0.0;

	HLFxBloodDrips(eye, d, blood, ToI64(damage), tS);

	return TRUE;
}

Bool HLAIMuzzlePos(I64 s, F64 *out)
{
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !e->studio)
		return FALSE;

	if (HLStudioAttachCount(e->studio) < 1)
		return FALSE;

	return HLStudioAttachment(e->studio, e->origin, e->angles, e->seq,
		HLAIEntityCycle(e), 0.0, 0, out, e->controllers, 0.0);
}

U0 HLAIGunPos(I64 s, F64 *out)
{
	if (HLAIMuzzlePos(s, out))
		return;

	HLAIMonEye(s, out);
}

U0 HLAIMuzzleFlash(I64 s)
{//pev->effects |= EF_MUZZLEFLASH - hgrunt.cpp:803, barney.cpp:353,
 //agrunt.cpp:445
	F64 muzzle[3];

	if (!HLAIMuzzlePos(s, muzzle))
		return;

	HLFxMuzzleFlash(muzzle, 0.5, tS);
}

Bool HLAITracerDue()
{//combat.cpp:1405.
	Bool due;

	due = ToBool((hl_ai_tracer_count % 4) == 0);
	hl_ai_tracer_count++;

	return due;
}

U0 HLAIFireAttack(I64 s, Bool melee)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 dmg;
	F64			 src[3];
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (melee)
	{
		HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		return;
	}

	HLAIAttackNoise(s);

	if (mi->blast_radius > 0.0)
	{
		HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
		return;
	}

	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (dist > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	if (tracer)
		HLFxTracer(src, eye, tS);

	dmg = mi->range_dmg * ToF64(mi->range_bullets);

	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, dmg, bits);
}


//scriptevent.h. HLStudio.ZC names 1004/1005/1008/1009, the same values.
#define HLAI_EV_DEAD			1000
#define HLAI_EV_NOINTERRUPT		1001
#define HLAI_EV_CANINTERRUPT	1002
#define HLAI_EV_FIREEVENT		1003
#define HLAI_EV_SOUND			1004
#define HLAI_EV_SENTENCE		1005
#define HLAI_EV_INAIR			1006
#define HLAI_EV_ENDANIMATION	1007
#define HLAI_EV_SOUND_VOICE		1008
#define HLAI_EV_SENTENCE_RND1	1009
#define HLAI_EV_NOT_DEAD		1010

//monsterevent.h
#define HLAI_EV_BODYDROP_LIGHT	2001
#define HLAI_EV_BODYDROP_HEAVY	2002
#define HLAI_EV_SWISHSOUND		2010

#define HLAI_HULL_REACH			70.0

#define HLAIPRJ_NONE			0
#define HLAIPRJ_SPIT			1
#define HLAIPRJ_HORNET			2
#define HLAIPRJ_GRENADE			3
#define HLAIPRJ_CTRLBALL		4
#define HLAIPRJ_FLAME			5
#define HLAIPRJ_ROCKET			6

#define HLAI_PROJ_Q				16

class CHLAIProjReq
{
	I64	 kind;
	F64	 org[3];
	F64	 vel[3];
	F64	 damage;
	F64	 life;
	F64	 gravity;
	F64	 friction;
	Bool bounce;
	I64	 owner;
};

CHLAIProjReq	hl_ai_proj_q[HLAI_PROJ_Q];
I64				hl_ai_proj_q_n = 0;
I64				hl_ai_proj_dropped = 0;

Bool HLAIProjRequest(I64 kind, F64 *org, F64 *vel, F64 damage, F64 life,
	F64 gravity, F64 friction, Bool bounce, I64 owner)
{
	CHLAIProjReq *r;

	if (kind <= HLAIPRJ_NONE || hl_ai_proj_q_n >= HLAI_PROJ_Q)
	{
		hl_ai_proj_dropped++;
		return FALSE;
	}

	r = &hl_ai_proj_q[hl_ai_proj_q_n++];
	r->kind     = kind;
	r->damage   = damage;
	r->life     = life;
	r->gravity  = gravity;
	r->friction = friction;
	r->bounce   = bounce;
	r->owner    = owner;
	HLVecCopy(org, r->org);
	HLVecCopy(vel, r->vel);
	return TRUE;
}

U0 HLAIProjAtEnemy(I64 s, I64 kind, F64 speed, F64 damage, F64 life,
	F64 gravity = 0.0, F64 friction = 0.0, Bool bounce = FALSE)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 src[3];
	F64			 dir[3];
	F64			 vel[3];

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLAIGunPos(s, src);
	HLVecSub(eye, src, dir);

	if (HLVecLength(dir) < 1.0)
		return;

	HLVecNormalize(dir);
	HLVecScale(dir, speed, vel);
	HLAIProjRequest(kind, src, vel, damage, life, gravity, friction, bounce,
		hl_ai_mon[s].ent);
}

U0 HLAIShootOnce(I64 s, F64 dmg_abs = 0.0)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 dmg;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 src[3];
	F64			 aim_dir[3];
	F64			 aim_ang[3];
	F64			 aim_set;
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	dmg = mi->range_dmg;

	if (dmg_abs > 0.0)
		dmg = dmg_abs;

	if (mi->clip_size > 0 && hl_ai_mon[s].ammo > 0)
		hl_ai_mon[s].ammo--;

	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLVecSub(eye, src, aim_dir);
	HLVecToAngles(aim_dir, aim_ang);
	hl_ai_mon[s].aim_pitch = aim_ang[0];

	aim_set = HLStudioBlendSetting(e->studio, e->seq, 0, aim_ang[0]);

	if (aim_set >= 0.0)
		e->blending[0] = aim_set / 255.0;

	HLVecSub(feet, e->origin, d);

	if (mi->range2_max > mi->range_max)
	{
		if (HLVecLength(d) > mi->range2_max)
			return;
	}
	else if (HLVecLength(d) > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	//TE_TRACER, combat.cpp:1427.
	if (tracer)
		HLFxTracer(src, eye, tS);

	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, dmg, bits);
}

U0 HLAIClawFoley(I64 s, Bool hit)
{//the hit and miss sounds every claw event plays. zombie.cpp's
 //pAttackHitSounds / pAttackMissSounds, which islave.cpp reuses verbatim
	if (hit)
		HLAIMonSound(s, "zombie/claw_strike1.wav");
	else
		HLAIMonSound(s, "zombie/claw_miss1.wav");
}

U0 HLAIBodyDrop(I64 s, Bool heavy)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 vol = 1.0;

	if (!e)
		return;

	if (heavy)
		vol = 1.0;
	else
		vol = 0.8;

	if (HLPartRandI(2))
		HLSndPlayAt("common/bodydrop3.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);
	else
		HLSndPlayAt("common/bodydrop4.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);

	HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);
}

Bool HLAISharedEvent(I64 s, CHLEntity *e, I64 self, I64 code, U8 *options)
{
	if (code == HLAI_EV_DEAD)
	{
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = 0.0;

		return TRUE;
	}

	if (code == HLAI_EV_NOT_DEAD)
	{
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = e->max_health;

		return TRUE;
	}

	if (code == HLAI_EV_FIREEVENT || code == HLAI_EV_SOUND ||
		code == HLAI_EV_SOUND_VOICE || code == HLAI_EV_SENTENCE ||
		code == HLAI_EV_SENTENCE_RND1)
	{
		if (!options || !options[0])
			return TRUE;
	}

	if (code == HLAI_EV_FIREEVENT)
	{
		HLEntFireTargetsNamed(options, self, hl_ent_player, HLUSE_TOGGLE, 0.0);
		return TRUE;
	}

	if (code == HLAI_EV_SOUND)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLENT_CHAN_BODY);
		return TRUE;
	}

	if (code == HLAI_EV_SOUND_VOICE)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLCHAN_VOICE);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE)
	{
		HLAISentencePlay(options, self, e->origin, 1.0, HLATTN_IDLE);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE_RND1)
	{
		if (HLPartRandI(3))
			HLAISentencePlay(options, self, e->origin, 1.0, HLATTN_IDLE);

		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_LIGHT)
	{
		HLAIBodyDrop(s, FALSE);
		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_HEAVY)
	{
		HLAIBodyDrop(s, TRUE);
		return TRUE;
	}

	if (code == HLAI_EV_SWISHSOUND)
	{
		HLAIMonSound(s, "zombie/claw_miss2.wav");
		return TRUE;
	}

	//SCRIPT_EVENT_NOINTERRUPT / CANINTERRUPT, monsters.cpp:2679-2685
	if (code == HLAI_EV_NOINTERRUPT)
	{
		if (hl_ai_cine[self].owner >= 0)
			hl_ai_cine[hl_ai_cine[self].owner].interrupt = FALSE;
		return TRUE;
	}

	if (code == HLAI_EV_CANINTERRUPT)
	{
		if (hl_ai_cine[self].owner >= 0)
		{
			if (!(hl_entities[hl_ai_cine[self].owner].spawnflags &
				HLAI_SF_NOINTERRUPT))
				hl_ai_cine[hl_ai_cine[self].owner].interrupt = TRUE;
		}
		return TRUE;
	}

	if (code == HLAI_EV_INAIR || code == HLAI_EV_ENDANIMATION)
		return TRUE;

	return FALSE;
}

#define HLSCI_HEAL				25.0

//"Don't heal again for 1 minute", scientist.cpp:1099
#define HLSCI_HEAL_WAIT			60.0

//CanHeal's half-health gate
#define HLSCI_HEAL_MAX_HP		100.0

//Heal's own range check
#define HLSCI_HEAL_RANGE		100.0
#define HLSCI_HEAL_BREAK		90.0

//NUM_SCIENTIST_HEADS, scientist.cpp:31.
#define HLSCI_HEADS				4

Bool HLAICanHeal(I64 s)
{//CScientist::CanHeal
	I64	ent = hl_ai_mon[s].ent;

	if (hl_ai_mon[s].kind != HLMON_SCIENTIST)
		return FALSE;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	if (hl_ai_talk[ent].follow != HLTLK_PLAYER)
		return FALSE;

	if (hl_ent_player < 0 || hl_ent_player_dead)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].heal_time)
		return FALSE;

	if (hl_ent_player_health > HLSCI_HEAL_MAX_HP * 0.5)
		return FALSE;

	return TRUE;
}

U0 HLAIHeal(I64 s)
{//CScientist::Heal, scientist.cpp:1088. The give_shot event, not the task
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 pl[3];
	F64			 d[3];

	if (!e || !HLAICanHeal(s))
		return;

	HLAIPlayerOrigin(pl);
	HLVecSub(pl, e->origin, d);

	if (HLVecLength(d) > HLSCI_HEAL_RANGE)
		return;

	hl_ent_player_health += HLSCI_HEAL;

	if (hl_ent_player_health > HLSCI_HEAL_MAX_HP)
		hl_ent_player_health = HLSCI_HEAL_MAX_HP;

	hl_ai_mon[s].heal_time = hl_ent_time + HLSCI_HEAL_WAIT;
}

U0 HLAIMonAnimEvent(I64 s, I64 self, I64 code, U8 *options)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 gib_dir[3];
	F64			 leap_feet[3];
	F64			 leap_eye[3];
	F64			 leap_dir[3];
	I64			 kind;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	kind = hl_ai_mon[s].kind;
	mi   = &hl_ai_mon_info[kind];

	if (code >= 1000)
	{
		HLAISharedEvent(s, e, self, code, options);
		return;
	}

	if (kind == HLMON_ZOMBIE)
	{
		if (code == 1 || code == 2)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		if (code == 3)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee2_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		return;
	}

	if (kind == HLMON_BARNACLE)
	{
		if (code == 2)
		{
			HLVecSet(gib_dir, 0.0, 0.0, -1.0);
			HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir,
				HLGIB_HEALTH_VALUE, 1, TRUE, mi->blood, hl_ent_time);
		}

		return;
	}

	if (kind == HLMON_HEADCRAB)
	{
		if (code == 2)
		{
			HLAIMonSound(s, mi->snd_attack);

			if (hl_ai_mon[s].have_enemy &&
				HLAITargetPos(hl_ai_mon[s].enemy, leap_feet, leap_eye))
			{
				HLVecSub(leap_eye, e->origin, leap_dir);
				leap_dir[2] += 0.2 * HLVecLength(leap_dir);
				HLVecNormalize(leap_dir);
				HLVecScale(leap_dir, 350.0, hl_ai_mon[s].leap_vel);
				hl_ai_mon[s].leaping = TRUE;
				hl_ai_mon[s].leap_die = hl_ent_time + 1.0;
			}
			else
				HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		}

		return;
	}

	if (kind == HLMON_BULLSQUID)
	{
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_SPIT, 900.0, mi->range_dmg, 3.0);
			return;
		}

		if (code == 2)
		{
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg);
			return;
		}

		if (code == 4)
		{
			//BSQUID_AE_WHIP is DMG_CLUB|DMG_ALWAYSGIB, dlls/bullsquid.cpp:588
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee2_dmg,
				HLDMG_CLUB | HLDMG_ALWAYSGIB);
			return;
		}

		//3 blink and 5 hop are a skin change and a velocity shove
		return;
	}

	if (kind == HLMON_HOUNDEYE)
	{
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_alert);
			return;
		}

		if (code == 2)
		{
			HLAIMonSound(s, "houndeye/he_attack1.wav");
			return;
		}

		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			HLAIMonSound(s, "houndeye/he_pain3.wav");
			return;
		}

		if (code == 5)
		{
			HLAIMonSound(s, "houndeye/he_pain1.wav");
			return;
		}

		//6 hop back and 7 close eye are velocity and skin
		return;
	}

	if (kind == HLMON_HGRUNT)
	{
		if (code == 2)
		{
			HLAIMonSound(s, "hgrunt/gr_reload1.wav");
			hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
			return;
		}

		if (code == 3)
		{
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg, HLDMG_CLUB);
			return;
		}

		if (code == 4)
		{
			if (HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP) ==
				HLGRUNT_GUN_SHOTGUN)
			{
				HLAIShootOnce(s, hl_ai_grunt_pellets * hl_ai_grunt_buckshot);
				HLAIMonSound(s, "weapons/sbarrel1.wav");
			}
			else
			{
				HLAIShootOnce(s);

				if (HLPartRandI(2))
					HLAIMonSound(s, "hgrunt/gr_mgun1.wav");
				else
					HLAIMonSound(s, "hgrunt/gr_mgun2.wav");
			}

			HLAIAttackNoise(s);
			return;
		}

		if (code == 5)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 6)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 10)
		{
			if (hl_ent_time > hl_ai_talk_wait)
			{
				HLAISentencePlay("HG_ALERT", self, e->origin, 1.0,
					HLENT_SND_ATTEN);

				hl_ai_talk_wait = hl_ent_time + 1.5 + HLPartRand(0.5);
			}

			return;
		}

		if (code == 7 || code == 8 || code == 9)
		{
			HLAIProjAtEnemy(s, HLAIPRJ_GRENADE, 750.0, 100.0, 3.5, 0.5, 0.8,
				TRUE);
			return;
		}

		return;
	}

	if (kind == HLMON_ISLAVE)
	{
		if (code == 1)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));
			return;
		}

		if (code == 2)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH, 25.0));
			return;
		}

		if (code == 3)
		{
			HLAIMonSound(s, "debris/zap4.wav");
			return;
		}

		if (code == 4)
		{
			HLAIMonSound(s, "hassault/hw_shoot1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		//5 clears the beams
		return;
	}

	if (kind == HLMON_BARNEY)
	{
		if (code == 2)
		{
			hl_ai_mon[s].gun_drawn = TRUE;
			return;
		}

		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			hl_ai_mon[s].gun_drawn = FALSE;
			return;
		}

		return;
	}

	if (kind == HLMON_AGRUNT)
	{
		if (code >= 1 && code <= 5)
		{
			HLAIMonSound(s, "agrunt/ag_fire1.wav");
			HLAIProjAtEnemy(s, HLAIPRJ_HORNET, 300.0, mi->range_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 6 || code == 7 || code == 12 || code == 13)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, mi->melee_range,
				mi->melee_dmg, HLDMG_CLUB));
			return;
		}

		if (code == 10 || code == 11)
		{
			HLAIMonSound(s, "player/pl_ladder2.wav");
			HLAIInsertSound(HLSOUND_WORLD, e->origin, 128.0, 0.2);
			return;
		}

		return;
	}

	if (kind == HLMON_CONTROLLER)
	{
		//CONTROLLER_AE_BALL_SHOOT, controller.cpp:298
		if (code == 2)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0, mi->range2_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		//CONTROLLER_AE_SMALL_SHOOT, controller.cpp:328: energy ball spray
		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0, mi->range_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		//1 opens the head, 4 and 5 are the charge-up glows
		return;
	}

	if (kind == HLMON_ASSASSIN)
	{
		if (code == 1)
		{
			HLAIMonSound(s, "weapons/pl_gun1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 2)
		{
			//ASSASSIN_AE_TOSS1: CGrenade::ShootTimed(..., 2.0), hassassin.cpp:254
			HLAIProjAtEnemy(s, HLAIPRJ_GRENADE, 750.0, 100.0, 2.0, 0.5, 0.8,
				TRUE);
			return;
		}

		//3 is ASSASSIN_AE_JUMP: velocity launch lives on the leap path
		return;
	}

	if (kind == HLMON_GARGANTUA)
	{
		if (code == 1)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, mi->melee_range,
				mi->melee_dmg, HLDMG_SLASH));
			return;
		}

		if (code == 3 || code == 4)
		{
			HLAIMonSound(s, "garg/gar_step1.wav");
			HLAIInsertSound(HLSOUND_WORLD, e->origin, 256.0, 0.3);
			return;
		}

		if (code == 5)
		{
			HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
			HLAIMonSound(s, "garg/gar_stomp1.wav");
			HLAIAttackNoise(s);
			return;
		}

		if (code == 6)
		{
			HLAIMonSound(s, "garg/gar_idle1.wav");
			return;
		}

		return;
	}

	if (kind == HLMON_SCIENTIST)
	{
		if (code == 1)
		{
			HLAIHeal(s);
			return;
		}

		if (code == 2)
		{
			e->body = e->body % HLSCI_HEADS + HLSCI_HEADS;
			return;
		}

		if (code == 3)
		{
			e->body = e->body % HLSCI_HEADS;
			return;
		}

		return;
	}
}

U0 HLAIMonEvents(I64 s, I64 self, F64 cycle)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLStudio	*m;
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 frame_f;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!e || !e->studio)
		return;

	m = e->studio;

	if (e->seq < 0 || e->seq >= m->num_seqs || !m->events)
		return;

	sq = &m->seqs[e->seq];

	if (sq->num_events < 1)
		return;

	frame_f = cycle * ToF64(sq->num_frames - 1);
	frame   = ToI64(frame_f);

	if (frame < 0)
		frame = 0;
	if (frame > sq->num_frames - 1)
		frame = sq->num_frames - 1;

	last = e->anim_event_frame;

	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &m->events[sq->first_event + i];

		if (ev->frame > last && ev->frame <= frame)
			HLAIMonAnimEvent(s, self, ev->code, ev->options);
	}

	e->anim_event_frame = frame;
}


U0 HLAITaskComplete(I64 s)
{
	hl_ai_mon[s].task_status = HLTK_DONE;
}

U0 HLAITaskFail(I64 s)
{
 //SetConditions(bits_COND_TASK_FAILED)
	hl_ai_mon[s].task_status = HLTK_FAILED;

	HLAISetCond(s, HLCOND_TASK_FAILED);
}

I64 HLAIActToSDK(I64 act)
{
	if (act == HLACT_IDLE)			return 1;
	if (act == HLACT_WALK)			return 3;
	if (act == HLACT_RUN)			return 4;
	if (act == HLACT_MELEE)			return 30;
	if (act == HLACT_RANGE)			return 28;
	if (act == HLACT_DIE)			return 36;
	if (act == HLACT_FLINCH)		return 26;
	if (act == HLACT_MELEE2)		return 31;
	if (act == HLACT_RANGE2)		return 29;
	if (act == HLACT_RELOAD)		return 32;
	if (act == HLACT_COMBAT_IDLE)	return 62;
	if (act == HLACT_SIGNAL)		return 21;
	if (act == HLACT_THREAT)		return 57;
	if (act == HLACT_VICTORY)		return 65;
	if (act == HLACT_COWER)			return 25;
	if (act == HLACT_ARM)			return 33;
	if (act == HLACT_DISARM)		return 34;
	if (act == HLACT_EAT)			return 35;
	if (act == HLACT_SPECIAL)		return 60;
	if (act == HLACT_BARN_HIT)		return 40;
	if (act == HLACT_BARN_PULL)		return 41;
	if (act == HLACT_BARN_CHOMP)	return 42;
	if (act == HLACT_BARN_CHEW)		return 43;

	return -1;
}

I64 HLAIDeathSDKAct(I64 s)
{//GetDeathActivity, combat.cpp:348. SDK activity numbers: 36 simple, 37 back,
 //38 forward, 66 headshot, 68 gutshot. LookupActivity failure is -1.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 forward[3];
	F64			 src[3];
	F64			 dest[3];
	F64			 mins[3];
	F64			 maxs[3];
	F64			 neg[3];
	F64			 flDot;
	I64			 death;
	Bool		 tried_dir;

	if (!e)
		return 36;

	tried_dir = FALSE;
	death     = 36;

	HLAngleVectors(e->angles, forward, NULL, NULL);
	neg[0] = -hl_attack_dir[0];
	neg[1] = -hl_attack_dir[1];
	neg[2] = -hl_attack_dir[2];
	flDot  = HLVecDot(forward, neg);

	//HITGROUP_HEAD 1, HITGROUP_STOMACH 3, HITGROUP_GENERIC 0
	if (hl_last_hitgroup == 1)
		death = 66;
	else if (hl_last_hitgroup == 3)
		death = 68;
	else
	{
		tried_dir = TRUE;

		if (flDot > 0.3)
			death = 38;
		else if (flDot <= -0.3)
			death = 37;
	}

	if (!e->studio || HLStudioLookupActivity(e->studio, death) < 0)
	{
		if (tried_dir)
			death = 36;
		else if (flDot > 0.3)
			death = 38;
		else if (flDot <= -0.3)
			death = 37;
	}

	if (!e->studio || HLStudioLookupActivity(e->studio, death) < 0)
		death = 36;

	if (e->absmax[0] > e->absmin[0] || e->absmax[2] > e->absmin[2])
	{
		src[0] = (e->absmin[0] + e->absmax[0]) * 0.5;
		src[1] = (e->absmin[1] + e->absmax[1]) * 0.5;
		src[2] = (e->absmin[2] + e->absmax[2]) * 0.5;
	}
	else
	{
		src[0] = e->origin[0] + (e->mins[0] + e->maxs[0]) * 0.5;
		src[1] = e->origin[1] + (e->mins[1] + e->maxs[1]) * 0.5;
		src[2] = e->origin[2] + (e->mins[2] + e->maxs[2]) * 0.5;
	}

	HLVecSet(mins, -16.0, -16.0, -18.0);
	HLVecSet(maxs,  16.0,  16.0,  18.0);

	if (death == 38 && hl_map)
	{
		HLVecMA(src, 64.0, forward, dest);
		HLTraceEntity(hl_map, src, dest, mins, maxs, 0, FALSE, &tr);

		if (tr.fraction != 1.0)
			death = 36;
	}

	if (death == 37 && hl_map)
	{
		dest[0] = src[0] - forward[0] * 64.0;
		dest[1] = src[1] - forward[1] * 64.0;
		dest[2] = src[2] - forward[2] * 64.0;
		HLTraceEntity(hl_map, src, dest, mins, maxs, 0, FALSE, &tr);

		if (tr.fraction != 1.0)
			death = 36;
	}

	return death;
}

I64 HLAISpreadLabel(I64 kind, CHLStudio *m, I64 act, I64 seq)
{
	U8	*label;
	I64	 activity;
	I64	 weight_total = 0;
	I64	 count        = 0;
	I64	 pick         = seq;
	I64	 other;
	I64	 a;
	I64	 i;

	if (!m || seq < 0 || seq >= m->num_seqs)
		return seq;

	activity = m->seqs[seq].activity;

	if (activity <= 0)
		return seq;

	for (i = 0; i < m->num_seqs; i++)
	{
		if (m->seqs[i].activity == activity)
			count++;
	}

	if (count < 2)
		return seq;

	for (a = 0; a < HLACT_COUNT; a++)
	{
		if (a == act)
			goto qsl_next_act;

		label = HLAIMonSeqOf(kind, a);

		if (!label)
			goto qsl_next_act;

		other = HLStudioSeqByName(m, label);

		if (other >= 0 && other < m->num_seqs &&
			m->seqs[other].activity == activity)
			return seq;

qsl_next_act:
	}

	for (i = 0; i < m->num_seqs; i++)
	{
		if (m->seqs[i].activity != activity)
			goto qsl_next_seq;

		weight_total += m->seqs[i].act_weight;

		if (!weight_total ||
			(RandU32 % weight_total) < m->seqs[i].act_weight)
			pick = i;

qsl_next_seq:
	}

	return pick;
}

I64 HLAIResolveActivity(I64 s, I64 act)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	U8			*label;
	I64			 seq;
	I64			 sdk;

	if (!e || !e->studio)
		return -1;

	if (hl_ai_mon[s].kind == HLMON_HGRUNT &&
		(act == HLACT_RANGE || act == HLACT_RELOAD))
	{
		if (HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP) ==
			HLGRUNT_GUN_SHOTGUN)
		{
			if (act == HLACT_RANGE)
				return HLStudioSeqByName(e->studio, "standing_shotgun");

			return HLStudioSeqByName(e->studio, "reload_shotgun");
		}

		if (act == HLACT_RANGE)
			return HLStudioSeqByName(e->studio, "standing_mp5");

		return HLStudioSeqByName(e->studio, "reload_mp5");
	}

	sdk = HLAIActToSDK(act);

	if (sdk > 0)
	{
		seq = HLStudioLookupActivity(e->studio, sdk);

		if (seq >= 0)
			return seq;
	}

	label = HLAIMonSeqOf(hl_ai_mon[s].kind, act);

	if (!label)
		return -1;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
		return -1;

	return HLAISpreadLabel(hl_ai_mon[s].kind, e->studio, act, seq);
}

U0 HLAISetActivity(I64 s, I64 act)
{//::SetActivity, monsters.cpp:1222
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 cycle;
	F64			 dur;
	I64			 seq;
	I64			 was;
	I64			 own;
	Bool		 loop;
	Bool		 keep;

	if (!e)
		return;

	was = hl_ai_mon[s].activity;

	own = -1;

	if (hl_ai_mon[s].ent >= 0 && hl_ai_mon[s].ent < HLENT_MAX)
		own = hl_ai_cine[hl_ai_mon[s].ent].owner;

	if (own >= 0)
	{
		if (hl_ai_cine[own].state == HLSS_PLAYING ||
			hl_ai_cine[own].state == HLSS_WAIT)
		{
			hl_ai_mon[s].activity = act;
			return;
		}
	}

	if (act == was && e->studio && e->anim_loop &&
		e->seq >= 0 && e->seq == hl_ai_mon[s].act_seq)
		return;

	seq = HLAIResolveActivity(s, act);

	if (seq < 0 && act != HLACT_IDLE)
	{
		act = HLACT_IDLE;
		seq = HLAIResolveActivity(s, act);
	}

	if (seq < 0)
		return;

	hl_ai_mon[s].activity = act;
	hl_ai_mon[s].act_seq  = seq;

	if (seq == e->seq && e->anim_loop)
		return;

	loop = ToBool(act == HLACT_IDLE || act == HLACT_WALK || act == HLACT_RUN ||
		act == HLACT_COMBAT_IDLE || act == HLACT_BARN_PULL ||
		act == HLACT_BARN_CHEW);

	//"don't reset frame between walk and run", monsters.cpp:1234.
	keep = ToBool((was == HLACT_WALK || was == HLACT_RUN) &&
		(act == HLACT_WALK || act == HLACT_RUN));

	cycle = 0.0;

	if (keep)
		cycle = HLAIEntityCycle(e);

	e->seq        = seq;
	e->anim_done  = FALSE;

	e->anim_event_frame = -1;

	e->anim_loop = ToBool(loop || HLStudioSeqLoops(e->studio, seq));

	//ResetSequenceInfo's pev->animtime = gpGlobals->time
	dur = HLStudioSeqDuration(e->studio, seq);

	e->anim_start = hl_ent_time - cycle * dur;
}

Bool HLAIAnimDone(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dur;

	if (!e || !e->studio)
		return TRUE;

	dur = HLStudioSeqDuration(e->studio, e->seq);

	if (dur <= 0.0)
		return TRUE;

	return ToBool(hl_ent_time - e->anim_start >= dur);
}

Bool HLAITalkPointOf(I64 who, F64 *out)
{
	CHLEntity *e;

	HLVecSet(out, 0.0, 0.0, 0.0);

	if (who == HLTLK_PLAYER)
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(out);

		return TRUE;
	}

	if (who < 0)
		return FALSE;

	e = HLEntGet(who);

	if (!e || e->health <= 0.0)
		return FALSE;

	HLVecCopy(e->origin, out);

	return TRUE;
}

U0 HLAIStartTask(I64 s, I64 task, F64 data)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 away[3];
	F64			 cover[3];
	F64			 flame_src[3];
	F64			 flame_fwd[3];
	F64			 flame_vel[3];

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	hl_ai_mon[s].task_status = HLTK_RUNNING;
	hl_ai_mon[s].task_start  = hl_ent_time;

	switch (task)
	{
		case HLTASK_WAIT:
			break;

		case HLTASK_WAIT_RANDOM:
			hl_ai_mon[s].task_start = hl_ent_time -
				HLPartRand(1.0) * data * 0.5;
			break;

		case HLTASK_WAIT_FOR_ANIM:
			break;

		case HLTASK_SET_ACTIVITY:
			HLAISetActivity(s, ToI64(data));
			HLAITaskComplete(s);
			break;

		case HLTASK_STOP_MOVING:
			hl_ai_mon[s].have_goal     = FALSE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].move_speed    = 0.0;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			break;

		case HLTASK_FACE_GOAL:
			break;

		case HLTASK_PATH_TO_ENEMY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = TRUE;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);

			hl_ai_mon[s].goal_tol = 48.0;

			if (mi->melee_range > 0.0)
				hl_ai_mon[s].goal_tol = mi->melee_range * 0.75;

			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_AWAY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(e->origin, hl_ai_mon[s].enemy_pos, away);
			away[2] = 0.0;

			if (HLVecNormalize(away) <= 0.0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecMA(e->origin, data, away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			hl_ai_mon[s].move_speed = mi->walk_speed;
			HLAISetActivity(s, HLACT_WALK);
			break;

		case HLTASK_RUN_PATH:
			hl_ai_mon[s].move_speed = mi->run_speed;
			HLAISetActivity(s, HLACT_RUN);
			break;

		case HLTASK_MELEE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE);
			break;

		case HLTASK_RANGE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE);
			break;

		case HLTASK_SOUND_ATTACK:
			HLAIMonSound(s, mi->snd_attack);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_ALERT:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_DIE:
			HLAIMonSound(s, mi->snd_die);
			HLAITaskComplete(s);
			break;

		case HLTASK_DIE:
		{
			I64	sdk;
			I64	seq;

			sdk = HLAIDeathSDKAct(s);
			seq = -1;

			if (e->studio)
				seq = HLStudioLookupActivity(e->studio, sdk);

			if (seq >= 0)
			{
				hl_ai_mon[s].activity = HLACT_DIE;
				hl_ai_mon[s].act_seq  = seq;
				e->seq                = seq;
				e->anim_done          = FALSE;
				e->anim_event_frame   = -1;
				e->anim_loop = ToBool(HLStudioSeqLoops(e->studio, seq));
				e->anim_start = hl_ent_time;
			}
			else
				HLAISetActivity(s, HLACT_DIE);

			e->takedamage = HLDMG_TAKE_NO;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->health     = 0.0;

			hl_ai_mon[s].have_goal  = FALSE;
			hl_ai_mon[s].have_enemy = FALSE;

			HLAISquadRemove(s);
			break;
		}

		case HLTASK_WAIT_INDEF:
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			break;

		case HLTASK_FACE_IDEAL:
			break;

		case HLTASK_SMALL_FLINCH:
			hl_ai_mon[s].flinched = TRUE;

			HLAISetActivity(s, HLACT_FLINCH);

			if (hl_ent_time >= hl_ai_mon[s].next_pain_snd)
			{
				if (mi->snd_pain[0])
					HLAIMonSound(s, mi->snd_pain);
				hl_ai_mon[s].next_pain_snd = hl_ent_time + 1.0;
			}
			break;

		case HLTASK_FIND_COVER_ENEMY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].enemy_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_SOUND:
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].heard_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_ORG:
			if (!HLAIFindCover(s, e->origin, FALSE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_SOUND:
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].heard_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 48.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);

			hl_ai_mon[s].ideal_yaw =
				HLAIYawTo(e->origin, hl_ai_mon[s].heard_pos);

			HLAITaskComplete(s);
			break;

		case HLTASK_STORE_LASTPOS:
			HLVecCopy(e->origin, hl_ai_mon[s].lastpos);
			hl_ai_mon[s].have_lastpos = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_LASTPOS:
			if (!hl_ai_mon[s].have_lastpos)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].lastpos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_CLEAR_LASTPOS:
			hl_ai_mon[s].have_lastpos = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RELOAD))
			{
				hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RELOAD);
			break;

		case HLTASK_MELEE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE2))
			{
				HLAIHullAttack(s, mi->melee2_range, mi->melee2_dmg);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE2);

			//CGargantua::StartTask TASK_FLAME_SWEEP, gargantua.cpp:1089.
			if (hl_ai_mon[s].kind == HLMON_GARGANTUA)
			{
				HLAIGunPos(s, flame_src);
				HLAngleVectors(e->angles, flame_fwd, NULL, NULL);
				HLVecScale(flame_fwd, 330.0, flame_vel);
				HLAIProjRequest(HLAIPRJ_FLAME, flame_src, flame_vel,
					mi->melee2_dmg, 4.5, 0.0, 0.0, FALSE, hl_ai_mon[s].ent);
				HLAIMonSound(s, "garg/gar_flameon1.wav");
				HLAIAttackNoise(s);
			}
			break;

		case HLTASK_RANGE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (hl_ai_mon[s].kind == HLMON_APACHE ||
				hl_ai_mon[s].kind == HLMON_OSPREY)
			{
				HLAIMonSound(s, "weapons/rocketfire1.wav");
				HLAIProjAtEnemy(s, HLAIPRJ_ROCKET, 1000.0, mi->range2_dmg,
					0.0, 0.5, 0.0, FALSE);
				HLAIAttackNoise(s);
				HLAITaskComplete(s);
				break;
			}

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE2))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE2);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;
			HLAISetActivity(s, HLACT_SPECIAL);
			break;

		case HLTASK_SOUND_IDLE:
			HLAIMonSound(s, mi->snd_idle);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_PAIN:
			if (mi->snd_pain[0])
				HLAIMonSound(s, mi->snd_pain);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_WAKE:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] + data);
			break;

		case HLTASK_TURN_RIGHT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] - data);
			break;

		case HLTASK_SET_SCHEDULE:
			HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			HLAISetActivity(s, ToI64(data));
			break;

		case HLTASK_EAT:
			HLAISetActivity(s, HLACT_EAT);
			break;

		case HLTASK_SUGGEST_STATE:
			HLAITaskComplete(s);
			break;

		case HLTASK_OCCUPY_SLOT:
			if (HLAIOccupySlot(s, ToI64(data)))
				HLAITaskComplete(s);
			else
				HLAITaskFail(s);
			break;

		case HLTASK_SAY_HEAL:
			//scientist.cpp:469-476. One sentence, then done.
			HLAISentencePlay("SC_HEAL", hl_ai_mon[s].ent, e->origin, 1.0,
				HLATTN_IDLE);
			HLAITaskComplete(s);
			break;

		case HLTASK_HEAL:
			//scientist.cpp:504. The take carries the event that does the work
			HLAISetActivity(s, HLACT_MELEE);
			break;

		case HLTASK_FACE_TARGET:
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			hl_ai_mon[s].ideal_yaw = HLAIYawTo(e->origin, away);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:879.
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = data;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].move_speed    = mi->walk_speed;

			HLAISetActivity(s, HLACT_WALK);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAIRunPath(I64 s, F64 dt)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 res;
	I64			 node;
	I64			 nxt;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!hl_ai_mon[s].have_goal)
	{
		HLAITaskComplete(s);
		return;
	}

	if (hl_ai_mon[s].goal_is_enemy && hl_ai_mon[s].have_enemy)
	{
		if (hl_ent_time - hl_ai_mon[s].enemy_seen <= HLAI_LOOK_PERIOD * 2.0 &&
			HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
			HLVecCopy(feet, hl_ai_mon[s].goal);
		}
		else
			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
	}

	HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt);

	res = HLAIMoveStep(s, hl_ai_mon[s].move_speed, dt);

	if (res == HLAI_MOVE_ARRIVED)
	{
		if (hl_ai_mon[s].kind == HLMON_BIGMOMMA &&
			!hl_ai_mon[s].goal_is_enemy && e->target[0])
		{
			node = HLEntFindByTargetname(e->target, 0);
			if (node >= 0 &&
				!StrCompare(hl_entities[node].classname, "info_bigmomma"))
			{
				if (hl_entities[node].message[0])
					HLEntFireTargetsNamed(hl_entities[node].message, node,
						hl_ai_mon[s].ent, HLUSE_TOGGLE, 0.0);

				if (hl_entities[node].health > 0.0)
					e->health = hl_entities[node].health *
						(e->max_health / 150.0);

				HLStrCopy(e->target, hl_entities[node].target, 64);
				if (e->target[0])
				{
					nxt = HLEntFindByTargetname(e->target, 0);
					if (nxt >= 0 &&
						!StrCompare(hl_entities[nxt].classname,
							"info_bigmomma"))
					{
						HLVecCopy(hl_entities[nxt].origin, hl_ai_mon[s].goal);
						hl_ai_mon[s].have_goal     = TRUE;
						hl_ai_mon[s].goal_is_enemy = FALSE;
						hl_ai_mon[s].goal_tol      = 128.0;
						hl_ai_mon[s].path_start    = hl_ent_time;
						HLAIRouteClear(s);
						return;
					}
				}
				hl_ai_mon[s].have_goal = FALSE;
			}
		}

		HLAITaskComplete(s);
		return;
	}

	if (res == HLAI_MOVE_BLOCKED)
	{
		HLAITaskFail(s);
		return;
	}

	if (hl_ent_time - hl_ai_mon[s].path_start > HLAI_PATH_TIMEOUT)
	{
		HLAITaskFail(s);
		return;
	}

	if (mi->melee_range > 0.0 && hl_ai_mon[s].have_enemy)
	{
		if (HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecSub(feet, e->origin, d);

			if (HLVecLength(d) <= mi->melee_range)
				HLAITaskComplete(s);
		}
	}
}

U0 HLAIRunTask(I64 s, I64 task, F64 data, F64 dt)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 tpos[3];
	F64			 tdiff[3];

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	switch (task)
	{
		case HLTASK_WAIT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_RANDOM:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_FOR_ANIM:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin,
				hl_ai_mon[s].enemy_pos), dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_GOAL:
			if (!hl_ai_mon[s].have_goal)
			{
				HLAITaskComplete(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt))
				HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_RUN_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_MELEE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_RANGE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				if (hl_ai_mon[s].kind == HLMON_NIHILANTH)
				{
					HLAIMonSound(s, mi->snd_attack);
					HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0,
						mi->range_dmg, 5.0);
					HLAIAttackNoise(s);
				}
				else
					HLAIFireAttack(s, FALSE);

				HLAITaskComplete(s);
			}
			break;

		case HLTASK_DIE:
			break;

		case HLTASK_WAIT_INDEF:
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			if (hl_ai_mon[s].have_enemy)
				HLAITurnToward(s, HLAIYawTo(e->origin,
					hl_ai_mon[s].enemy_pos), dt);

			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_IDEAL:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_SMALL_FLINCH:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			if (HLAIAnimDone(s))
			{
				hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_MELEE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_HEAL:
			//scientist.cpp:579-590.
			if (HLAIAnimDone(s))
			{
				HLAITaskComplete(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, tpos))
			{
				HLAITaskComplete(s);
				break;
			}

			HLVecSub(tpos, e->origin, tdiff);

			if (HLVecLength(tdiff) > HLSCI_HEAL_BREAK)
			{
				HLAITaskComplete(s);
				break;
			}

			HLAITurnToward(s, HLAIYawTo(e->origin, tpos), dt);
			break;

		case HLTASK_RANGE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_RIGHT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_EAT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_TARGET:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:410-425
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, tpos))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(tpos, hl_ai_mon[s].goal, tdiff);

			if (HLVecLength(tdiff) > data * 0.5)
			{
				HLVecCopy(tpos, hl_ai_mon[s].goal);
				hl_ai_mon[s].path_start  = hl_ent_time;
				hl_ai_mon[s].stuck_since = 0.0;
				hl_ai_mon[s].have_detour = FALSE;
				HLAIRouteClear(s);
			}

			HLVecSub(hl_ai_mon[s].goal, e->origin, tdiff);
			tdiff[2] = 0.0;

			if (HLVecLength(tdiff) < data)
			{
				HLAITaskComplete(s);
				break;
			}

			HLAIRunPath(s, dt);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAISetSchedule(I64 s, I64 sched)
{
	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	HLAIVacateSlot(s);

	hl_ai_mon[s].in_cover   = FALSE;
	hl_ai_mon[s].sched      = sched;
	hl_ai_mon[s].task       = 0;
	hl_ai_mon[s].sched_done = FALSE;

	//"m_afConditions = 0", schedule.cpp:82.
	hl_ai_mon[s].conds = HLCOND_NONE;

	if (!hl_ai_sched_len[sched])
	{
		hl_ai_mon[s].sched_done  = TRUE;
		hl_ai_mon[s].task_status = HLTK_DONE;
		return;
	}

	HLAIStartTask(s, hl_ai_sched_task[sched * HLAI_SCHED_TASKS],
		hl_ai_sched_data[sched * HLAI_SCHED_TASKS]);
}

U0 HLAIRunSchedule(I64 s, F64 dt)
{
	I64 sched = hl_ai_mon[s].sched;
	I64 slot;
	I64 budget = HLAI_SCHED_TASKS + 1;

	if (sched <= HLSCHED_NONE || sched >= HLSCHED_COUNT)
		return;

	while (budget > 0)
	{
		budget--;

		if (hl_ai_mon[s].sched_done)
			return;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		if (hl_ai_mon[s].task_status == HLTK_RUNNING)
		{
			HLAIRunTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot], dt);

			if (hl_ai_mon[s].task_status == HLTK_RUNNING)
				return;
		}

		if (hl_ai_mon[s].task_status == HLTK_FAILED)
		{
			if (hl_ai_mon[s].fail_sched > HLSCHED_NONE &&
				hl_ai_mon[s].fail_sched != sched)
			{
				HLAISetSchedule(s, hl_ai_mon[s].fail_sched);
				return;
			}

			hl_ai_mon[s].sched      = HLSCHED_NONE;
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		if (hl_ai_sched_task[slot] == HLTASK_SET_SCHEDULE)
		{
			HLAISetSchedule(s, ToI64(hl_ai_sched_data[slot]));
			return;
		}

		hl_ai_mon[s].task++;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		HLAIStartTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot]);
	}
}


U0 HLAISetState(I64 s, I64 state)
{
	if (hl_ai_mon[s].state == state)
		return;

	hl_ai_mon[s].state      = state;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;
}


U0 HLAICineLog(I64 self, U8 *what, F64 a, F64 b)
{
	CHLEntity	*script;
	I64			 t;

	if (!hl_ai_script_log)
		return;

	script = HLEntGet(self);

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	"SCRIPT %6.2f %-9s \"%s\" mv%d st%d ent%d %8.1f %8.1f\n",
		hl_ent_time, what, script->targetname, script->ai_moveto,
		hl_ai_cine[self].state, t, a, b;
}

Bool HLAICanPlaySequence(I64 t, Bool disregard, I64 level)
{//CBaseMonster::CanPlaySequence, monsters.cpp:3110
	CHLEntity	*e;
	I64			 s;

	if (t < 0 || t >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(t);

	if (!e)
		return FALSE;

	if (hl_ai_cine[t].owner >= 0)
		return FALSE;

	s = hl_ai_mon_of[t];

	if (s < 0)
		return ToBool(e->studio != NULL);

	if (hl_ai_mon[s].state == HLMSTATE_DEAD || e->health <= 0.0)
		return FALSE;

	if (disregard)
		return TRUE;

	if (hl_ai_mon[s].state == HLMSTATE_NONE ||
		hl_ai_mon[s].state == HLMSTATE_IDLE)
		return TRUE;

	return ToBool(hl_ai_mon[s].state == HLMSTATE_ALERT &&
		level >= HLSS_INT_BY_NAME);
}

I64 HLAICineFind(I64 self)
{//CCineMonster::FindEntity, scripted.cpp:272.
	CHLEntity	*script = HLEntGet(self);
	F64			 d[3];
	Bool		 over;
	I64			 i;

	if (!script || !script->ai_entity[0])
		return -1;

	over = ToBool((script->spawnflags & HLAI_SF_OVERRIDESTATE) ||
		!StrCompare(script->classname, "aiscripted_sequence"));

	i = HLEntFindByTargetname(script->ai_entity, 0);

	while (i >= 0)
	{
		if (HLAICanPlaySequence(i, over, HLSS_INT_BY_NAME))
			return i;

		i = HLEntFindByTargetname(script->ai_entity, i + 1);
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qacf_next;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qacf_next;

		HLVecSub(hl_entities[i].origin, script->origin, d);

		if (HLVecLength(d) > script->ai_radius)
			goto qacf_next;

		if (HLAICanPlaySequence(i, over, HLSS_INT_IDLE))
			return i;

qacf_next:
	}

	return -1;
}

U0 HLAICineDelayStart(I64 self, I64 state)
{//CCineMonster::DelayStart, scripted.cpp:725.
	CHLEntity	*script = HLEntGet(self);
	I64			 i;

	if (!script)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || hl_entities[i].ent_class != HLC_SCRIPT)
			goto qacd_next;

		if (!script->targetname[0])
		{
			if (i != self)
				goto qacd_next;
		}
		else if (StrICompare(hl_entities[i].targetname, script->targetname))
			goto qacd_next;

		if (state)
			hl_ai_cine[i].delay++;
		else
		{
			hl_ai_cine[i].delay--;

			if (hl_ai_cine[i].delay <= 0)
				hl_ai_cine[i].start = hl_ent_time + 0.05;
		}

qacd_next:
	}
}

Bool HLAICineSetSeq(I64 t, U8 *label)
{//CCineMonster::StartSequence, scripted.cpp:493.
	CHLEntity	*e;
	CHLStSeq	*sq;
	U8			*src;
	I64			 seq;
	I64			 avail;

	if (t < 0 || t >= HLENT_MAX || !label || !label[0])
		return FALSE;

	e = HLEntGet(t);

	if (!e || !e->studio)
		return FALSE;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
	{
		"HLAI: %s has no sequence \"%s\"\n", e->classname, label;
		seq = 0;
	}

	sq = &e->studio->seqs[seq];
	src = HLStudioSeqData(e->studio, sq->seq_group, &avail);

	if (sq->seq_group > 0 && !src)
		"HLAI: %s seq \"%s\" group %d missing - rest pose\n",
			e->classname, label, sq->seq_group;

	e->seq              = seq;
	e->anim_start       = hl_ent_time;
	e->anim_done        = FALSE;
	e->anim_event_frame = -1;
	e->anim_loop        = HLStudioSeqLoops(e->studio, seq);

	return TRUE;
}

U0 HLAICineRelease(I64 self)
{//CBaseMonster::CineCleanup, scripted.cpp:796.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	F64			 bone[3];
	F64			 old[3];
	F64			 dx;
	F64			 dy;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	hl_ai_cine[self].actor = -1;
	hl_ai_cine[self].state = HLSS_CLEANUP;

	if (t < 0 || t >= HLENT_MAX)
		return;

	hl_ai_cine[t].owner = -1;

	actor = HLEntGet(t);

	if (!actor)
		return;

	actor->movetype = hl_ai_cine[self].movetype;
	actor->solid    = hl_ai_cine[self].solid;

	s = hl_ai_mon_of[t];

	if (s < 0)
		return;

	if (script->ai_play[0] &&
		!(script->spawnflags & HLAI_SF_NOSCRIPTMOVEMENT))
	{
		HLVecCopy(actor->origin, old);

		if (actor->studio)
		{
			HLStudioPose(actor->studio, actor->origin, actor->angles,
				actor->seq, HLAIEntityCycle(actor), actor->blending[0],
				actor->controllers, actor->blending[1]);

			if (HLStudioBonePos(actor->studio, 0, bone))
			{
				dx = old[0] - bone[0];
				dy = old[1] - bone[1];

				//"don't move monster if they don't seem to move", < 8 units 2D
				if (dx * dx + dy * dy >= 64.0)
				{
					actor->origin[0] = bone[0];
					actor->origin[1] = bone[1];
					actor->origin[2] = bone[2] + 1.0;
				}
			}
		}

		if (HLAIDropToFloorHard(actor, actor->mins, actor->maxs, floor))
			HLVecCopy(floor, actor->origin);
		else
			HLVecCopy(old, actor->origin);

		HLEntSetAbsBox(actor);
	}

	hl_ai_mon[s].scripted   = FALSE;
	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].activity   = HLACT_IDLE;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;

	if (actor->health > 0.0)
		HLAISetState(s, HLMSTATE_IDLE);
	else
		HLAISetState(s, HLMSTATE_DEAD);
}

U0 HLAICineDone(I64 self)
{//CCineMonster::SequenceDone, scripted.cpp:561.
	CHLEntity *script = HLEntGet(self);
	I64			 t;
	I64			 s;

	if (!script)
		return;

	HLAICineLog(self, "done", 0.0, 0.0);

	t = hl_ai_cine[self].actor;

	HLAICineRelease(self);

	//CCineAI::FixScriptMonsterSchedule, scripted.cpp:610.
	if (!StrCompare(script->classname, "aiscripted_sequence") &&
		script->ai_finish == HLAI_FINISH_AMBUSH &&
		t >= 0 && t < HLENT_MAX)
	{
		s = hl_ai_mon_of[t];

		if (s >= 0 && hl_ai_mon[s].state != HLMSTATE_DEAD)
			HLAISetSchedule(s, HLSCHED_AMBUSH);
	}

	hl_ai_cine[self].start   = hl_ent_time + HLAI_CINE_NEVER;
	hl_ai_cine[self].delay   = 0;
	hl_ai_cine[self].blocked = 0.0;

	hl_ai_cine[self].retry = -1.0;

	if (script->spawnflags & HLAI_SF_REPEATABLE)
		script->toggle_state = HLTS_AT_BOTTOM;
	else
		script->toggle_state = HLTS_AT_TOP;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);
}

U0 HLAICinePossess(I64 self)
{//CCineMonster::PossessEntity, scripted.cpp:321.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	F64			 left;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = HLAICineFind(self);

	if (t < 0)
	{
		hl_ai_cine[self].retry = hl_ent_time + HLAI_CINE_RETRY;
		return;
	}

	actor = HLEntGet(t);

	hl_ai_cine[self].actor    = t;
	hl_ai_cine[self].movetype = actor->movetype;
	hl_ai_cine[self].solid    = actor->solid;
	hl_ai_cine[self].retry    = -1.0;
	hl_ai_cine[t].owner       = self;

	if (script->spawnflags & HLAI_SF_NOINTERRUPT)
		hl_ai_cine[self].interrupt = FALSE;
	else
		hl_ai_cine[self].interrupt = TRUE;

	s = hl_ai_mon_of[t];

	if (s >= 0)
	{
		hl_ai_mon[s].scripted  = TRUE;
		hl_ai_mon[s].have_goal = FALSE;

		HLAISetState(s, HLMSTATE_SCRIPT);

		if (!hl_ai_mon[s].settled)
		{
			hl_ai_mon[s].settled = TRUE;

			if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies &&
				HLAIDropToFloorHard(actor, actor->mins, actor->maxs, floor))
			{
				HLVecCopy(floor, actor->origin);
				HLEntSetAbsBox(actor);
			}
		}
	}

	HLVecSub(script->origin, actor->origin, floor);
	left = HLVecLength(floor);

	hl_ai_cine[self].blocked = 0.0;

	if ((script->ai_moveto == HLAI_MOVE_WALK ||
		script->ai_moveto == HLAI_MOVE_RUN) && s >= 0 &&
		HLAIResolveActivity(s, HLACT_WALK) >= 0)
	{
		if (script->ai_moveto == HLAI_MOVE_WALK)
			hl_ai_cine[self].state = HLSS_WALK_TO_MARK;
		else
			hl_ai_cine[self].state = HLSS_RUN_TO_MARK;

		hl_ai_mon[s].have_detour     = FALSE;
		HLAIRouteClear(s);
		hl_ai_mon[s].stuck_since     = 0.0;
		hl_ai_mon[s].next_move_check = 0.0;

		HLAICineDelayStart(self, 1);
		HLAICineLog(self, "possess", left, 0.0);
	}
	else
	{
		hl_ai_cine[self].state = HLSS_WAIT;

		//5 turns to face without moving
		if (script->ai_moveto != HLAI_MOVE_NONE &&
			script->ai_moveto != HLAI_MOVE_TURN)
		{
			HLVecCopy(script->origin, actor->origin);
			HLEntSetAbsBox(actor);

			//EF_NOINTERP, scripted.cpp:369.
			HLStudioLatchInvalidate(t);

			HLAICineLog(self, "place", left, 0.0);
		}
		else
			HLAICineLog(self, "possess", left, 0.0);

		if (script->ai_moveto == HLAI_MOVE_INSTANT)
			actor->angles[1] = HLAngleNorm(script->angles[1]);

		if (script->ai_moveto == HLAI_MOVE_INSTANT)
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
	}

	//TASK_FACE_SCRIPT, schedule.cpp:1293.
	if (s >= 0)
	{
		if (script->ai_moveto == HLAI_MOVE_NONE ||
			script->ai_moveto == HLAI_MOVE_INSTANT)
			hl_ai_mon[s].ideal_yaw = actor->angles[1];
		else
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(script->angles[1]);
	}

	if (script->ai_idle[0])
	{
		HLAICineSetSeq(t, script->ai_idle);

		if (s >= 0)
		{
			hl_ai_mon[s].activity = HLACT_IDLE;
			hl_ai_mon[s].act_seq  = actor->seq;
		}

		if (!script->ai_play[0])
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
	}
}

U0 HLAICineBeginPlay(I64 self)
{//TASK_WAIT_FOR_SCRIPT completing, schedule.cpp:522.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	if (t < 0)
	{
		HLAICineDone(self);
		return;
	}

	if (!script->ai_play[0])
	{
		if (script->ai_idle[0] &&
			script->ai_moveto == HLAI_MOVE_INSTANT &&
			!script->target[0])
		{
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
			return;
		}

		HLAICineDone(self);
		return;
	}

	HLAICineSetSeq(t, script->ai_play);

	hl_ai_cine[self].state = HLSS_PLAYING;
	script->toggle_state   = HLTS_GOING_UP;

	HLAICineLog(self, "play", 0.0, 0.0);

	actor = HLEntGet(t);
	s     = hl_ai_mon_of[t];

	if (actor)
		actor->movetype = HLMOVETYPE_FLY;

	script->pain_finished = hl_ent_time;

	if (actor && actor->studio)
		script->pain_finished += HLStudioSeqDuration(actor->studio, actor->seq);

	if (s >= 0)
		hl_ai_mon[s].activity = HLACT_IDLE;
}

U0 HLAICineActorTick(I64 s, F64 dt)
{
	CHLEntity	*actor = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*script;
	CHLMonInfo	*mi;
	F64			 aim[3];
	F64			 speed;
	F64			 left;
	I64			 self;
	I64			 st;
	I64			 moved;

	if (!actor || hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
		return;

	self = hl_ai_cine[hl_ai_mon[s].ent].owner;

	if (self < 0)
		return;

	script = HLEntGet(self);

	if (!script)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	st = hl_ai_cine[self].state;

	//CineCleanup's deadflag branch, scripted.cpp:818
	if (st != HLSS_PLAYING && actor->health <= 0.0)
	{
		HLAICineDone(self);
		return;
	}

	if (st == HLSS_WALK_TO_MARK || st == HLSS_RUN_TO_MARK)
	{
		speed = mi->walk_speed;

		if (st == HLSS_RUN_TO_MARK)
			speed = mi->run_speed;

		hl_ai_mon[s].have_goal     = TRUE;
		hl_ai_mon[s].goal_is_enemy = FALSE;
		hl_ai_mon[s].goal_tol      = 8.0;
		hl_ai_mon[s].move_speed    = speed;

		HLVecCopy(script->origin, hl_ai_mon[s].goal);

		if (st == HLSS_WALK_TO_MARK)
			HLAISetActivity(s, HLACT_WALK);
		else
			HLAISetActivity(s, HLACT_RUN);

		HLAITurnToward(s, HLAIYawTo(actor->origin, script->origin), dt);

		moved = HLAIMoveStep(s, speed, dt);

		if (moved == HLAI_MOVE_OK)
		{
			hl_ai_cine[self].blocked = 0.0;
			return;
		}

		HLVecSub(script->origin, actor->origin, aim);
		left = HLVecLength(aim);

		if (moved == HLAI_MOVE_BLOCKED)
		{
			hl_ai_mon[s].have_detour     = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].stuck_since     = 0.0;
			hl_ai_mon[s].next_move_check = 0.0;

			if (hl_ai_cine[self].blocked == 0.0)
			{
				hl_ai_cine[self].blocked = hl_ent_time;

				HLAICineLog(self, "blocked", left, 0.0);
			}

			if (hl_ent_time - hl_ai_cine[self].blocked < HLAI_CINE_WALK_GIVEUP)
				return;

			HLAICineLog(self, "giveup", left,
				hl_ent_time - hl_ai_cine[self].blocked);
		}
		else
			HLAICineLog(self, "arrived", left, 0.0);

		hl_ai_cine[self].blocked = 0.0;

		//TASK_PLANT_ON_SCRIPT, schedule.cpp:1279.
		if (left > 8.0)
			HLStudioLatchInvalidate(hl_ai_mon[s].ent);

		HLVecCopy(script->origin, actor->origin);
		HLEntSetAbsBox(actor);

		hl_ai_mon[s].have_goal = FALSE;

		hl_ai_mon[s].ideal_yaw = HLAngleNorm(script->angles[1]);
		actor->angles[1]       = hl_ai_mon[s].ideal_yaw;

		if (script->ai_idle[0])
			HLAICineSetSeq(hl_ai_mon[s].ent, script->ai_idle);
		else
			HLAISetActivity(s, HLACT_IDLE);

		hl_ai_cine[self].state = HLSS_WAIT;

		HLAICineDelayStart(self, 0);

		return;
	}

	if (st == HLSS_WAIT)
	{
		//TASK_WAIT_FOR_SCRIPT, schedule.cpp:1251
		if (!script->ai_idle[0])
			HLAISetActivity(s, HLACT_IDLE);
		else if (!StrICompare(script->ai_idle, script->ai_play))
			actor->anim_start = hl_ent_time;

		HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt);

		if (script->ai_idle[0] && !script->ai_play[0] &&
			script->ai_moveto == HLAI_MOVE_INSTANT &&
			!script->target[0])
			return;

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
			HLAICineBeginPlay(self);

		return;
	}

}

U0 HLAICineTick(I64 self)
{
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	//CCineMonster::Spawn, scripted.cpp:143.
	if (hl_ai_cine[self].retry == 0.0)
	{
		if (!script->targetname[0] || script->ai_idle[0])
			hl_ai_cine[self].retry = hl_ent_time + 1.0;
		else
			hl_ai_cine[self].retry = -1.0;

		if (script->targetname[0])
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
		else
			hl_ai_cine[self].start = 0.0;
	}

	t = hl_ai_cine[self].actor;

	if (script->toggle_state == HLTS_GOING_DOWN)
	{
		script->toggle_state = HLTS_AT_BOTTOM;

		//CCineMonster::Use, scripted.cpp:181.
		if (t >= 0)
			hl_ai_cine[self].start = hl_ent_time + 0.05;
		else
			hl_ai_cine[self].retry = hl_ent_time;
	}

	if (script->toggle_state == HLTS_AT_TOP)
		return;

	if (t < 0)
	{
		if (hl_ai_cine[self].retry >= 0.0 &&
			hl_ent_time >= hl_ai_cine[self].retry)
			HLAICinePossess(self);

		return;
	}

	s = hl_ai_mon_of[t];

	if (s < 0 && hl_ai_cine[self].state == HLSS_WAIT)
	{
		if (script->ai_idle[0] &&
			!StrICompare(script->ai_idle, script->ai_play))
		{
			actor = HLEntGet(t);

			if (actor)
				actor->anim_start = hl_ent_time;
		}

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
		{
			if (!(script->ai_idle[0] && !script->ai_play[0] &&
				script->ai_moveto == HLAI_MOVE_INSTANT &&
				!script->target[0]))
				HLAICineBeginPlay(self);
		}
	}

	if (hl_ai_cine[self].state == HLSS_PLAYING &&
		hl_ent_time >= script->pain_finished)
		HLAICineDone(self);
}


//TALKRANGE_MIN, talkmonster.h:26
#define HLAI_TALKRANGE_MIN	500.0
//TLK_STARE_DIST, talkmonster.h:28
#define HLAI_TLK_STARE_DIST	128.0

//TALKGROUPNAMES, talkmonster.h:41-62
#define HLTLK_ANSWER		0
#define HLTLK_QUESTION		1
#define HLTLK_IDLE			2
#define HLTLK_STARE			3
#define HLTLK_USE			4
#define HLTLK_UNUSE			5
#define HLTLK_STOP			6
#define HLTLK_NOSHOOT		7
#define HLTLK_HELLO			8
#define HLTLK_PHELLO		9
#define HLTLK_PIDLE			10
#define HLTLK_PQUESTION		11
#define HLTLK_PLHURT1		12
#define HLTLK_PLHURT2		13
#define HLTLK_PLHURT3		14
#define HLTLK_SMELL			15
#define HLTLK_WOUND			16
#define HLTLK_MORTAL		17
#define HLTLK_CGROUPS		18

#define HLAI_TLK_NAME		16

//SF_MONSTER_GAG and SF_MONSTER_PREDISASTER, monsters.h:45 and :52
#define HLAI_SF_MONSTER_GAG			2
#define HLAI_SF_PREDISASTER			256

//SF_SENTENCE_*, scripted.cpp:954-957
#define HLAI_SF_SENTENCE_ONCE		1
#define HLAI_SF_SENTENCE_FOLLOWERS	2
#define HLAI_SF_SENTENCE_INTERRUPT	4
#define HLAI_SF_SENTENCE_CONCURRENT	8

#define HLAI_SENTENCE_PLAYER_RADIUS	4096.0

Bool HLAITalkLineClear(F64 *from, F64 *to)
{
	CHLTrace	tr;
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLTraceEntity(hl_map, from, to, zero, zero, 0, TRUE, &tr);

	return ToBool(tr.fraction >= 1.0);
}

U8	hl_ai_tlk_grp[HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME];

U0 HLAITalkSetGrp(I64 kind, I64 which, U8 *name)
{
	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return;

	HLStrCopy(&hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME],
		name, HLAI_TLK_NAME);
}

U8 *HLAITalkGrp(I64 kind, I64 which)
{
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT)
		return NULL;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return NULL;

	p = &hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAITalkGroupsInit()
{//CScientist::TalkInit, scientist.cpp:738-758 and CBarney::TalkInit,
 //barney.cpp:462-484. A leading ! names one sentence rather than a group;
	I64 i;

	for (i = 0; i < HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME; i++)
		hl_ai_tlk_grp[i] = 0;

	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_ANSWER,    "SC_ANSWER");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_QUESTION,  "SC_QUESTION");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_IDLE,      "SC_IDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STARE,     "SC_STARE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_USE,       "SC_OK");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_UNUSE,     "SC_WAIT");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STOP,      "SC_STOP");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_NOSHOOT,   "SC_SCARED");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_HELLO,     "SC_HELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PHELLO,    "SC_PHELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PIDLE,     "SC_PIDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PQUESTION, "SC_PQUEST");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT1,   "!SC_CUREA");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT2,   "!SC_CUREB");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT3,   "!SC_CUREC");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_SMELL,     "SC_SMELL");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_WOUND,     "SC_WOUND");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_MORTAL,    "SC_MORTAL");

	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_ANSWER,    "BA_ANSWER");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_QUESTION,  "BA_QUESTION");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_IDLE,      "BA_IDLE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STARE,     "BA_STARE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_USE,       "BA_OK");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_UNUSE,     "BA_WAIT");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STOP,      "BA_STOP");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_NOSHOOT,   "BA_SCARED");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_HELLO,     "BA_HELLO");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PQUESTION, "BA_PQUEST");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT1,   "!BA_CUREA");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT2,   "!BA_CUREB");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT3,   "!BA_CUREC");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_SMELL,     "BA_SMELL");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_WOUND,     "BA_WOUND");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_MORTAL,    "BA_MORTAL");

}

HLAITalkGroupsInit;

I64 HLAITalkKindOf(I64 ent)
{
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return -1;

	e = HLEntGet(ent);

	if (!e)
		return -1;

	if (!StrCompare(e->classname, "monster_sitting_scientist"))
		return HLMON_SCIENTIST;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return -1;

	if (hl_ai_mon[s].kind == HLMON_SCIENTIST ||
		hl_ai_mon[s].kind == HLMON_BARNEY)
		return hl_ai_mon[s].kind;

	return -1;
}

U0 HLAITalkEnsure(I64 ent)
{
	CHLEntity	*e;
	I64			 head;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (hl_ai_talk[ent].inited)
		return;

	hl_ai_talk[ent].inited      = TRUE;
	hl_ai_talk[ent].voice_pitch = HLPITCH_NORM;

	e = HLEntGet(ent);

	if (!e)
		return;

	if (e->follow_player)
	{
		hl_ai_talk[ent].follow      = HLTLK_PLAYER;
		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	}

	if (HLAITalkKindOf(ent) != HLMON_SCIENTIST)
		return;

	head = e->body % 4;

	if (head == 0)
		hl_ai_talk[ent].voice_pitch = 105;

	if (head == 2)
		hl_ai_talk[ent].voice_pitch = 95;
}

I64 HLAITalkPitch(I64 ent)
{//GetVoicePitch, talkmonster.cpp:872: m_voicePitch plus 0..3
	HLAITalkEnsure(ent);

	if (ent < 0 || ent >= HLENT_MAX)
		return HLPITCH_NORM;

	return hl_ai_talk[ent].voice_pitch + HLPartRandI(4);
}

Bool HLAITalkIsTalking(I64 ent)
{//IsTalking, talkmonster.cpp:1310
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	if (hl_ai_talk[ent].stop_talk > hl_ent_time)
		return TRUE;

	return HLAISentenceTalking(ent);
}

U0 HLAITalkTalk(I64 ent, F64 duration)
{//Talk, talkmonster.cpp:1218.
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (duration <= 0.0)
		hl_ai_talk[ent].stop_talk = hl_ent_time + 3.0;
	else
		hl_ai_talk[ent].stop_talk = hl_ent_time + duration;
}

Bool HLAITalkOk(I64 ent)
{//FOkToSpeak, talkmonster.cpp:913.
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	if (hl_ent_time <= hl_ai_talk_wait)
		return FALSE;

	if (e->spawnflags & HLAI_SF_MONSTER_GAG)
		return FALSE;

	s = hl_ai_mon_of[ent];

	if (s >= 0)
	{
		if (hl_ai_mon[s].state == HLMSTATE_DEAD)
			return FALSE;

		//MONSTERSTATE_PRONE, talkmonster.cpp:914
		if (hl_ai_mon[s].barn_host >= 0)
			return FALSE;

		if (hl_ai_mon[s].have_enemy &&
			hl_ai_mon[s].state == HLMSTATE_COMBAT)
			return FALSE;
	}

	return TRUE;
}

Bool HLAITalkPlaySentence(I64 ent, U8 *group, F64 duration, F64 volume,
	F64 atten)
{//PlaySentence, talkmonster.cpp:1151.
	CHLEntity *e;

	if (!group || !group[0])
		return FALSE;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	HLAITalkEnsure(ent);

	if (!HLAISentencePlay(group, ent, e->origin, volume, atten,
		HLAITalkPitch(ent)))
		return FALSE;

	HLAITalkTalk(ent, duration);

	hl_ai_talk_wait = hl_ent_time + duration + 2.0;

	//If you say anything, don't greet the player - talkmonster.cpp:1164
	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return TRUE;
}

Bool HLAITalkIsFriendClass(U8 *classname)
{//m_szFriends, talkmonster.cpp:53-58
	if (!StrCompare(classname, "monster_barney"))
		return TRUE;

	if (!StrCompare(classname, "monster_scientist"))
		return TRUE;

	return ToBool(!StrCompare(classname, "monster_sitting_scientist"));
}

Bool HLAITalkScriptPoseHold(I64 ent)
{
	CHLEntity	*script;
	I64			 cine;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	cine = hl_ai_cine[ent].owner;

	if (cine < 0)
		return FALSE;

	script = HLEntGet(cine);

	if (!script || script->ent_class != HLC_SCRIPT)
		return FALSE;

	if (script->ai_moveto != HLAI_MOVE_INSTANT)
		return FALSE;

	if (!script->ai_idle[0] || script->ai_play[0])
		return FALSE;

	return TRUE;
}

U0 HLAITalkShutUpFriends(I64 ent)
{//ShutUpFriends, talkmonster.cpp:704.
	I64 i;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatsu_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatsu_next;

		if (hl_entities[i].health <= 0.0)
			goto qatsu_next;

		HLAISentenceStop(i);

		if (i < HLENT_MAX)
			hl_ai_talk[i].stop_talk = 0.0;

qatsu_next:
	}
}

I64 HLAITalkNearestFriend(I64 ent, Bool want_player)
{//FindNearestFriend, talkmonster.cpp:802.
	CHLEntity	*e;
	CHLEntity	*f;
	F64			 start[3];
	F64			 check[3];
	F64			 d[3];
	F64			 dist;
	F64			 best  = HLAI_TALKRANGE_MIN;
	I64			 found = HLTLK_NOBODY;
	I64			 i;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return HLTLK_NOBODY;

	e = HLEntGet(ent);

	if (!e)
		return HLTLK_NOBODY;

	HLVecCopy(e->origin, start);
	start[2] = e->absmax[2];

	if (want_player)
	{
		if (!HLAITalkPointOf(HLTLK_PLAYER, check))
			return HLTLK_NOBODY;

		HLVecCopy(hl_snd_listener, check);
		HLVecSub(start, check, d);

		if (HLVecLength(d) >= HLAI_TALKRANGE_MIN)
			return HLTLK_NOBODY;

		if (!HLAITalkLineClear(start, check))
			return HLTLK_NOBODY;

		return HLTLK_PLAYER;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatnf_next;

		f = &hl_entities[i];

		if (!HLAITalkIsFriendClass(f->classname))
			goto qatnf_next;

		if (f->health <= 0.0)
			goto qatnf_next;

		s = -1;

		if (i < HLENT_MAX)
			s = hl_ai_mon_of[i];

		if (s >= 0 && hl_ai_mon[s].state == HLMSTATE_DEAD)
			goto qatnf_next;

		if (s >= 0 && hl_ai_mon[s].state == HLMSTATE_SCRIPT &&
			!HLAITalkScriptPoseHold(i))
			goto qatnf_next;

		HLVecCopy(f->origin, check);
		check[2] = f->absmax[2];

		HLVecSub(start, check, d);
		dist = HLVecLength(d);

		if (dist >= best)
			goto qatnf_next;

		if (!HLAITalkLineClear(start, check))
			goto qatnf_next;

		found = i;
		best  = dist;

qatnf_next:
	}

	return found;
}

U0 HLAITalkHeadTurn(I64 ent, F64 *point, F64 limit = HLAI_TLK_HEAD_MAX)
{//IdleHeadTurn, talkmonster.cpp:1007.
	CHLEntity	*e;
	F64			 yaw;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	if (yaw > limit)
		yaw = limit;

	if (yaw < -limit)
		yaw = -limit;

	hl_ai_talk[ent].head_turn = yaw;

	setting = HLStudioCtlSetting(e->studio, 0, yaw);

	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkHeadSet(I64 ent, F64 degrees)
{
	CHLEntity	*e;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	hl_ai_talk[ent].head_turn = degrees;

	setting = HLStudioCtlSetting(e->studio, 0, degrees);

	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkFaceTarget(I64 ent, Bool reset_when_done = TRUE,
	F64 limit = HLAI_TLK_HEAD_MAX)
{
	F64 point[3];

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (!HLAITalkIsTalking(ent))
	{
		if (reset_when_done && hl_ai_talk[ent].head_turn != 0.0)
			HLAITalkHeadSet(ent, 0.0);

		return;
	}

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	HLAITalkHeadTurn(ent, point, limit);
}

U0 HLAITalkSetAnswer(I64 listener, I64 speaker)
{//SetAnswerQuestion, talkmonster.cpp:1226, and the sitting override at
 //scientist.cpp:1398. A question makes the listener owe an answer.
	if (listener < 0 || listener >= HLENT_MAX)
		return;

	hl_ai_talk[listener].talk_target = speaker;

	hl_ai_talk[listener].response = hl_ent_time + 3.5 + HLPartRand(0.5);
}

Bool HLAITalkIdleRespond(I64 ent)
{//IdleRespond, talkmonster.cpp:905
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return FALSE;

	return HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_ANSWER),
		3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
}

Bool HLAITalkIdleHello(I64 ent)
{//FIdleHello, talkmonster.cpp:974.
	CHLEntity	*e;
	F64			 point[3];
	I64			 kind;
	I64			 s;
	U8			*grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (HLAITalkNearestFriend(ent, TRUE) != HLTLK_PLAYER)
		return FALSE;

	HLVecCopy(hl_snd_listener, point);

	s = hl_ai_mon_of[ent];

	if (s >= 0 && !HLAIInViewCone(s, point))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

	grp = HLAITalkGrp(kind, HLTLK_HELLO);

	if (e->spawnflags & HLAI_SF_PREDISASTER)
		grp = HLAITalkGrp(kind, HLTLK_PHELLO);

	if (!HLAITalkPlaySentence(ent, grp, 3.25 + HLPartRand(0.25), 1.0,
		HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return TRUE;
}

Bool HLAITalkIdleStare(I64 ent)
{//FIdleStare, talkmonster.cpp:959
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (!HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_STARE),
		6.25 + HLPartRand(1.25), 1.0, HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLAITalkNearestFriend(ent, TRUE);

	return TRUE;
}

Bool HLAITalkIdleSpeak(I64 ent)
{//FIdleSpeak, talkmonster.cpp:1026.
	CHLEntity	*e;
	F64			 duration;
	I64			 kind;
	I64			 other;
	I64			 s;
	U8			*idle_grp;
	U8			*quest_grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_PIDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_PQUESTION);
		duration  = 5.0 + HLPartRand(0.2);
	}
	else
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_IDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_QUESTION);
		duration  = 3.0 + HLPartRand(0.2);
	}

	if (hl_ai_talk[ent].follow == HLTLK_PLAYER && hl_ent_player >= 0 &&
		!hl_ent_player_dead)
	{
		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_HEAVY) &&
			hl_ent_player_health <= 100.0 / 8.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT3),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_HEAVY;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_MEDIUM) &&
			hl_ent_player_health <= 100.0 / 4.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT2),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_MEDIUM;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_LIGHT) &&
			hl_ent_player_health <= 100.0 / 2.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT1),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_LIGHT;
			return TRUE;
		}
	}

	other = HLAITalkNearestFriend(ent, FALSE);

	if (other >= 0 && HLPartRandI(100) < 75)
	{
		s = -1;

		if (other < HLENT_MAX)
			s = hl_ai_mon_of[other];

		if (s < 0 || !hl_ai_mon[s].have_goal)
		{
			if (HLAITalkPlaySentence(ent, quest_grp, duration, 1.0,
				HLATTN_IDLE))
			{
				hl_ai_talk[ent].talk_target = other;

				HLAITalkSetAnswer(other, ent);

				hl_ai_talk[other].stop_talk = hl_ai_talk[ent].stop_talk;

				hl_ai_talk[ent].n_speak++;

				return TRUE;
			}
		}
	}

	if (HLPartRandI(2))
	{
		other = HLAITalkNearestFriend(ent, TRUE);

		if (other != HLTLK_NOBODY)
		{
			if (HLAITalkPlaySentence(ent, idle_grp, duration, 1.0,
				HLATTN_IDLE))
			{
				hl_ai_talk[ent].talk_target = other;
				hl_ai_talk[ent].n_speak++;

				return TRUE;
			}
		}
	}

	HLAITalkTalk(ent, 0.0);
	hl_ai_talk_wait = 0.0;

	return FALSE;
}

Bool HLAITalkCanPlaySentence(I64 ent, Bool disregard_state)
{//CTalkMonster::CanPlaySentence, talkmonster.cpp:949.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (disregard_state)
		return ToBool(e->health > 0.0);

	return HLAITalkOk(ent);
}


Bool HLAITalkIsFollowing(I64 ent)
{//IsFollowing, talkmonster.h:142: a target that is the player
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return ToBool(hl_ai_talk[ent].follow == HLTLK_PLAYER);
}

Bool HLAITalkCanFollow(I64 ent)
{//CanFollow, talkmonster.cpp:1395
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = hl_ai_mon_of[ent];

	if (s >= 0 && hl_ai_mon[s].state == HLMSTATE_SCRIPT)
	{
		if (hl_ai_cine[ent].owner < 0)
			return FALSE;

		if (!hl_ai_cine[hl_ai_cine[ent].owner].interrupt)
			return FALSE;
	}

	return ToBool(!HLAITalkIsFollowing(ent));
}

U0 HLAITalkStopFollowing(I64 ent, Bool clear_schedule)
{//StopFollowing, talkmonster.cpp:1364
	I64 kind;
	I64 s;

	if (!HLAITalkIsFollowing(ent))
		return;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_UNUSE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	}

	hl_ai_talk[ent].follow = HLTLK_NOBODY;
	hl_entities[ent].follow_player = FALSE;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return;

	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].move_speed = 0.0;

	if (clear_schedule)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}

	if (hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_COMBAT);
}

U0 HLAITalkStartFollowing(I64 ent)
{//StartFollowing, talkmonster.cpp:1383. Only the player leads.
	I64 kind;
	I64 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (hl_ai_cine[ent].owner >= 0)
		HLAICineRelease(hl_ai_cine[ent].owner);

	s = hl_ai_mon_of[ent];

	if (s >= 0 && hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_ALERT);

	hl_ai_talk[ent].follow      = HLTLK_PLAYER;
	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	hl_entities[ent].follow_player = TRUE;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_USE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

	if (s >= 0)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}
}

U0 HLAITalkLimitFollowers(I64 keep, I64 max_followers)
{//LimitFollowers, talkmonster.cpp:726.
	I64 count = 0;
	I64 i;

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		if (i == keep || !hl_entities[i].in_use)
			goto qatlf_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatlf_next;

		if (!HLAITalkIsFollowing(i))
			goto qatlf_next;

		count++;

		if (count > max_followers)
			HLAITalkStopFollowing(i, TRUE);

qatlf_next:
	}
}

U0 HLAITalkFollowerUse(I64 ent)
{//FollowerUse, talkmonster.cpp:1412. The +USE half of the follow system.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	HLAITalkEnsure(ent);

	if (hl_ai_talk[ent].use_time > hl_ent_time)
		return;

	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		if (HLAITalkKindOf(ent) == HLMON_SCIENTIST)
		{
			HLAITalkTalk(ent, 10.0);
			HLAITalkPlaySentence(ent, "SC_POK", 2.0, 1.0, HLATTN_NORM);
		}

		return;
	}

	if (!HLAITalkCanFollow(ent))
	{
		HLAITalkStopFollowing(ent, TRUE);
		return;
	}

	HLAITalkLimitFollowers(ent, 1);
	HLAITalkStartFollowing(ent);

	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;
}

I64 HLAIFollowerUseInFront(F64 *player_org, F64 *forward)
{
	CHLEntity	*e;
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 i;

	if (!hl_entities || !player_org || !forward)
		return 0;

	HLVecMA(player_org, 48.0, forward, probe);

	for (i = 0; i < 3; i++)
	{
		pmins[i] = probe[i] - 16.0;
		pmaxs[i] = probe[i] + 16.0;
	}

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->health <= 0.0)
			goto qafu_next;

		if (!HLAITalkIsFriendClass(e->classname))
			goto qafu_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qafu_next;

		HLAITalkFollowerUse(i);

		return 1;

qafu_next:
	}

	return 0;
}


Bool HLAITalkPlayScripted(I64 ent, U8 *sentence, F64 duration, F64 volume,
	F64 atten, Bool concurrent, I64 listener)
{//PlayScriptedSentence, talkmonster.cpp:1193.
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	if (!concurrent)
		HLAITalkShutUpFriends(ent);

	hl_ai_talk[ent].use_time    = hl_ent_time + duration;
	hl_ai_talk[ent].talk_target = listener;

	return HLAITalkPlaySentence(ent, sentence, duration, volume, atten);
}

Bool HLAIAcceptableSpeaker(CHLEntity *script, I64 who)
{//CScriptedSentence::AcceptableSpeaker, scripted.cpp:1103
	Bool override;

	if (who < 0 || who >= HLENT_MAX)
		return FALSE;

	if (HLAITalkKindOf(who) < 0 && hl_ai_mon_of[who] < 0)
		return TRUE;

	if (script->spawnflags & HLAI_SF_SENTENCE_FOLLOWERS)
	{
		if (!HLAITalkIsFollowing(who))
			return FALSE;
	}

	override = ToBool(script->spawnflags & HLAI_SF_SENTENCE_INTERRUPT);

	return HLAITalkCanPlaySentence(who, override);
}

I64 HLAISentenceSpeaker(CHLEntity *script)
{//CScriptedSentence::FindEntity
	F64	d[3];
	I64	i;

	if (!script->ai_entity[0])
		return -1;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qass_next;

		if (StrICompare(hl_entities[i].targetname, script->ai_entity))
			goto qass_next;

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next:
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qass_next2;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qass_next2;

		//scripted_sentence spells the key lowercase "radius"
		HLVecSub(hl_entities[i].origin, script->origin, d);

		if (HLVecLength(d) > script->radius)
			goto qass_next2;

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next2:
	}

	return -1;
}

I64 HLAISentenceListener(CHLEntity *script, I64 speaker)
{//the listener half of StartSentence
	CHLEntity	*sp;
	F64			 d[3];
	F64			 radius;
	F64			 dist;
	F64			 best;
	I64			 found;
	I64			 i;

	sp = HLEntGet(speaker);

	if (!sp || !script->ai_listener[0])
		return HLTLK_NOBODY;

	radius = script->radius;

	if (!StrCompare(script->ai_listener, "player"))
		radius = HLAI_SENTENCE_PLAYER_RADIUS;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qasl_next;

		if (!StrCompare(hl_entities[i].targetname, script->ai_listener))
			return i;

qasl_next:
	}

	if (!StrCompare(script->ai_listener, "player"))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return HLTLK_NOBODY;

		HLVecSub(hl_snd_listener, sp->origin, d);

		if (HLVecLength(d) > radius)
			return HLTLK_NOBODY;

		return HLTLK_PLAYER;
	}

	found = HLTLK_NOBODY;
	best  = radius;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qasl2_next;

		if (StrCompare(hl_entities[i].classname, script->ai_listener))
			goto qasl2_next;

		HLVecSub(hl_entities[i].origin, sp->origin, d);
		dist = HLVecLength(d);

		if (dist >= best)
			goto qasl2_next;

		found = i;
		best  = dist;

qasl2_next:
	}

	return found;
}

F64 HLAISentenceAtten(I64 impulse)
{//CScriptedSentence::Spawn's attenuation switch, scripted.cpp:1046-1063.
	if (impulse == 1)
		return HLATTN_STATIC;

	if (impulse == 2)
		return HLATTN_NORM;

	if (impulse == 3)
		return HLATTN_NONE;

	return HLATTN_IDLE;
}


#define HLAI_TALK_PERIOD	0.5

U0 HLAITalkIdealYaw(I64 s, F64 dt)
{//TASK_TLK_IDEALYAW, talkmonster.cpp:412-433, followed by TASK_FACE_IDEAL.
	CHLEntity	*e;
	F64			 point[3];
	F64			 yaw;
	F64			 step;
	I64			 ent;

	if (s < 0)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (hl_ai_mon[s].have_goal ||
		hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (!HLAITalkIsTalking(ent))
		return;

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	if (yaw < 0.0)
	{
		yaw += HLAI_TLK_YAW_SLACK;

		if (yaw > 0.0)
			yaw = 0.0;
	}
	else
	{
		yaw -= HLAI_TLK_YAW_SLACK;

		if (yaw < 0.0)
			yaw = 0.0;
	}

	if (yaw == 0.0)
		return;

	step = HLAI_TLK_YAW_SPEED * dt;

	if (yaw < 0.0)
	{
		if (step > -yaw)
			step = -yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > yaw)
			step = yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}
}

U0 HLAITalkThink(I64 s, F64 dt)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 point[3];
	F64			 d[3];
	I64			 ent;
	I64			 kind;

	if (!e)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return;

	HLAITalkEnsure(ent);

	HLAITalkIdealYaw(s, dt);

	HLAITalkFaceTarget(ent);

	if (hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (hl_ai_mon[s].state == HLMSTATE_SCRIPT &&
		!HLAITalkScriptPoseHold(ent))
		return;

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + HLAI_TALK_PERIOD;

	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		hl_ai_talk[ent].response = 0.0;

		if (HLAITalkIdleRespond(ent))
			return;
	}

	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO))
	{
		if (HLAITalkIdleHello(ent))
			return;
	}

	//TrySmellTalk, talkmonster.cpp:1333
	if (HLAITalkOk(ent))
	{
		if (hl_ent_time > hl_ai_talk[ent].last_smelled)
			hl_ai_talk[ent].bits_said &= ~HLTLK_SAID_SMELLED;

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_SMELLED) &&
			HLAIHasCond(s, HLCOND_SMELL))
		{
			if (HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_SMELL),
				3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE))
			{
				hl_ai_talk[ent].last_smelled = hl_ent_time + 60.0;
				hl_ai_talk[ent].bits_said |= HLTLK_SAID_SMELLED;
				return;
			}
		}
	}

	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_LIGHT) &&
		e->health <= e->max_health * 0.75)
	{
		if (HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_WOUND),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE))
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_LIGHT;
		return;
	}

	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_HEAVY) &&
		e->health <= e->max_health * 0.5)
	{
		if (HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_MORTAL),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE))
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_HEAVY;
		return;
	}

	if (HLAITalkOk(ent) && !HLPartRandI(hl_ai_talk[ent].n_speak * 2 + 1))
	{
		if (HLAITalkIdleSpeak(ent))
			return;
	}

	if (HLAITalkIsTalking(ent) || HLPartRandI(7))
		return;

	if (hl_ent_player < 0 || hl_ent_player_dead)
		return;

	HLVecCopy(hl_snd_listener, point);
	HLVecSub(point, e->origin, d);
	d[2] = 0.0;

	if (HLVecLength(d) >= HLAI_TLK_STARE_DIST)
		return;

	if (!HLAIInViewCone(s, point))
		return;

	HLAITalkIdleStare(ent);
}

U0 HLAISitScientistThink(I64 ent)
{//CSittingScientist::SittingThink, scientist.cpp:1303.
	CHLEntity	*e = HLEntGet(ent);
	F64			 point[3];
	F64			 floor[3];
	F64			 yaw;
	I64			 roll;
	I64			 who;

	if (!e || !e->studio || e->health <= 0.0)
		return;

	if (ent < HLENT_MAX && hl_ai_cine[ent].owner >= 0)
		return;

	HLAITalkEnsure(ent);

	if (ent < HLENT_MAX && !hl_ai_talk[ent].settled)
	{
		hl_ai_talk[ent].settled = TRUE;

		if (HLAIDropToFloorHard(e, e->mins, e->maxs, floor))
		{
			HLVecCopy(floor, e->origin);
			HLEntSetAbsBox(e);
		}
	}

	HLAITalkFaceTarget(ent, FALSE, HLAI_TLK_SIT_HEAD_MAX);

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + 0.1;

	if (HLAITalkIdleHello(ent))
	{
		who = HLAITalkNearestFriend(ent, TRUE);

		if (who != HLTLK_NOBODY && HLAITalkPointOf(who, point))
		{
			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);

			HLAITalkHeadSet(ent, 0.0);
		}

		return;
	}

	if (hl_ent_time - e->anim_start <
		HLStudioSeqDuration(e->studio, e->seq))
		return;

	roll = HLPartRandI(100);

	hl_ai_talk[ent].head_turn = 0.0;

	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		HLAITalkIdleRespond(ent);
		HLAISetSequence(e, "sitscared", FALSE);
		hl_ai_talk[ent].response = 0.0;
	}
	else if (roll < 30)
	{
		if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
			who = HLAITalkNearestFriend(ent, FALSE);
		else
			who = HLAITalkNearestFriend(ent, TRUE);

		if (!HLAITalkIdleSpeak(ent) || who == HLTLK_NOBODY)
		{
			//RANDOM_LONG(0,8) * 10 - 40: nine steps of ten degrees, centred
			hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;
			HLAISetSequence(e, "sitting3", FALSE);
		}
		else
		{
			HLAITalkPointOf(who, point);

			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);
		}
	}
	else if (roll < 60)
	{
		HLAISetSequence(e, "sitting3", FALSE);
		hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;

		if (HLPartRandI(100) < 5)
			HLAITalkIdleSpeak(ent);
	}
	else if (roll < 80)
		HLAISetSequence(e, "sitting2", FALSE);
	else
		HLAISetSequence(e, "sitscared", FALSE);

	HLAITalkHeadSet(ent, hl_ai_talk[ent].head_turn);
}


U0 HLAIBarnacleChew(I64 s)
{//one of the three chew takes on CHAN_WEAPON, barnacle.cpp:222-227
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 roll;

	if (!e)
		return;

	roll = HLPartRandI(3);

	if (roll == 0)
		HLSndPlayAt("barnacle/bcl_chew1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else if (roll == 1)
		HLSndPlayAt("barnacle/bcl_chew2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else
		HLSndPlayAt("barnacle/bcl_chew3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
}

U0 HLAIBarnacleRelease(I64 s)
{//BarnacleVictimReleased, monsters.cpp:187
	CHLEntity	*ve;
	I64			 v = hl_ai_mon[s].barn_prey;

	hl_ai_mon[s].barn_prey    = -1;
	hl_ai_mon[s].barn_lifting = FALSE;
	hl_ai_mon[s].barn_kill    = -1.0;
	hl_ai_mon[s].barn_adj     = HLBARN_ADJ_IDLE;

	if (v < 0 || v >= hl_ai_mon_count)
		return;

	hl_ai_mon[v].barn_host = -1;

	ve = HLEntGet(hl_ai_mon[v].ent);

	if (ve)
		ve->movetype = HLMOVETYPE_STEP;

	if (hl_ai_mon[v].state != HLMSTATE_DEAD)
		HLAISetState(v, HLMSTATE_IDLE);

	hl_ai_mon[v].settled = FALSE;
}

I64 HLAIBarnacleTouch(I64 s, F64 *_len)
{//TongueTouchEnt, barnacle.cpp:393.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*c;
	CHLTrace	 tr;
	F64			 down[3];
	F64			 zero[3];
	F64			 bmins[3];
	F64			 bmaxs[3];
	F64			 length;
	I64			 mine;
	I64			 i;

	if (_len)
		*_len = 0.0;

	if (!e || !hl_map)
		return HLBARN_NOBODY;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecCopy(e->origin, down);
	down[2] -= HLBARN_TONGUE_MAX;

	//ignore_monsters, barnacle.cpp:399
	HLTraceEntity(hl_map, e->origin, down, zero, zero, 0, TRUE, &tr);

	length = e->origin[2] - tr.end_pos[2];

	if (length < 0.0)
		length = -length;

	if (_len)
		*_len = length;

	//the column the tongue occupies, barnacle.cpp:403-407
	HLVecSet(bmins, e->origin[0] - HLBARN_CHECK_SPACE,
		e->origin[1] - HLBARN_CHECK_SPACE, e->origin[2] - length);
	HLVecSet(bmaxs, e->origin[0] + HLBARN_CHECK_SPACE,
		e->origin[1] + HLBARN_CHECK_SPACE, e->origin[2]);

	mine = hl_ai_mon_info[hl_ai_mon[s].kind].classify;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (i == s || hl_ai_mon[i].ent < 0)
			goto qabt_next;

		if (hl_ai_mon[i].barn_host >= 0)
			goto qabt_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qabt_next;

		//IRelationship( pList[i] ) > R_NO, barnacle.cpp:415
		if (HLAIRelationship(mine,
			hl_ai_mon_info[hl_ai_mon[i].kind].classify) <= HLREL_NONE)
			goto qabt_next;

		c = HLEntGet(hl_ai_mon[i].ent);

		if (!c || c->health <= 0.0)
			goto qabt_next;

		if (c->absmax[0] < bmins[0] || c->absmin[0] > bmaxs[0])
			goto qabt_next;
		if (c->absmax[1] < bmins[1] || c->absmin[1] > bmaxs[1])
			goto qabt_next;
		if (c->absmax[2] < bmins[2] || c->absmin[2] > bmaxs[2])
			goto qabt_next;

		return i;

qabt_next:
	}

	return HLBARN_NOBODY;
}

U0 HLAIBarnacleGrab(I64 s, I64 v)
{//the FBecomeProne branch, barnacle.cpp:273-291
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve = HLEntGet(hl_ai_mon[v].ent);

	if (!e || !ve)
		return;

	HLSndPlayAt("barnacle/bcl_alert2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	//SetSequenceByName("attack1")
	HLAISetActivity(s, HLACT_MELEE);

	hl_ai_mon[s].barn_adj     = HLBARN_ADJ_HELD;
	hl_ai_mon[s].barn_prey    = v;
	hl_ai_mon[s].barn_lifting = TRUE;
	hl_ai_mon[s].barn_kill    = -1.0;
	hl_ai_mon[v].barn_host    = s;

	ve->movetype = HLMOVETYPE_FLY;
	ve->origin[0] = e->origin[0];
	ve->origin[1] = e->origin[1];
	HLEntSetAbsBox(ve);

	hl_ai_mon[s].barn_alt = e->origin[2] - (ve->origin[2] +
		hl_ai_mon_info[hl_ai_mon[v].kind].view_ofs);

	HLAISetSchedule(v, HLSCHED_BARNACLE_GRAB);
}

U0 HLAIBarnacleLift(I64 s, I64 v)
{//the m_fLiftingPrey branch, barnacle.cpp:167-203
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve = HLEntGet(hl_ai_mon[v].ent);
	F64			 org[3];
	F64			 gap;

	if (!e || !ve)
		return;

	HLVecCopy(ve->origin, org);
	org[0] = e->origin[0] -
		HLBARN_NECK_OFS * Cos(ve->angles[1] * HLDEG2RAD);
	org[1] = e->origin[1] -
		HLBARN_NECK_OFS * Sin(ve->angles[1] * HLDEG2RAD);
	org[2] += HLBARN_PULL_SPEED;

	hl_ai_mon[s].barn_alt -= HLBARN_PULL_SPEED;

	HLVecCopy(org, ve->origin);
	HLEntSetAbsBox(ve);

	gap = e->origin[2] - (org[2] +
		hl_ai_mon_info[hl_ai_mon[v].kind].view_ofs - HLBARN_MOUTH_SLACK);

	if (gap < 0.0)
		gap = -gap;

	if (gap >= HLBARN_BODY_HEIGHT)
		return;

	hl_ai_mon[s].barn_lifting = FALSE;

	HLSndPlayAt("barnacle/bcl_bite3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	hl_ai_mon[s].barn_kill = hl_ent_time + HLBARN_KILL_DELAY;

	//BarnacleVictimBitten, monsters.cpp:171
	HLAISetSchedule(v, HLSCHED_BARNACLE_CHOMP);
	HLAISetActivity(s, HLACT_EAT);
}

U0 HLAIBarnacleThink(I64 s)
{//BarnacleThink, barnacle.cpp:143, on its own 0.1s cadence.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve;
	F64			 gib_dir[3];
	F64			 length;
	F64			 setting;
	I64			 touched;
	I64			 v;

	if (!e)
		return;

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLBARN_THINK;

	v      = hl_ai_mon[s].barn_prey;
	length = 0.0;

	//someone killed the prey, barnacle.cpp:152-158
	if (v >= 0)
	{
		ve = HLEntGet(hl_ai_mon[v].ent);

		if (!ve || ve->health <= 0.0 || hl_ai_mon[v].state == HLMSTATE_DEAD)
		{
			HLAIBarnacleRelease(s);
			v = -1;
		}
	}

	if (v >= 0)
	{
		if (hl_ai_mon[s].barn_lifting)
			HLAIBarnacleLift(s, v);
		else
		{
			ve = HLEntGet(hl_ai_mon[v].ent);

			if (ve && hl_ai_mon[s].barn_kill >= 0.0 &&
				hl_ent_time > hl_ai_mon[s].barn_kill)
			{
				HLDmgHurt(hl_ai_mon[v].ent, hl_ai_mon[s].ent, ve->health,
					HLDMG_SLASH | HLDMG_ALWAYSGIB);
				hl_ai_mon[s].barn_gibs = HLBARN_KILL_GIBS;
				goto qabk_ctl;
			}

			//a chew on one think in fifty, barnacle.cpp:228
			if (HLPartRandI(50) == 0)
			{
				HLAIBarnacleChew(s);
				HLAISetSchedule(v, HLSCHED_BARNACLE_CHOMP);
			}
		}

		goto qabk_ctl;
	}


	if (HLAIAnimDone(s))
	{
		HLAISetActivity(s, HLACT_IDLE);
		hl_ai_mon[s].barn_adj = HLBARN_ADJ_IDLE;
	}

	if (hl_ai_mon[s].barn_gibs > 0 && HLPartRandI(100) == 1)
	{
		hl_ai_mon[s].barn_gibs--;

		//SpawnRandomGibs(pev, 1, 1), barnacle.cpp:253.
		HLVecSet(gib_dir, 0.0, 0.0, -1.0);
		HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir, HLGIB_HEALTH_VALUE,
			1, TRUE, HLBLOOD_RED, hl_ent_time);

		HLAIBarnacleChew(s);
	}

	touched = HLAIBarnacleTouch(s, &length);

	if (touched != HLBARN_NOBODY && hl_ai_mon[s].barn_ext)
		HLAIBarnacleGrab(s, touched);
	else if (hl_ai_mon[s].barn_alt < length)
	{
		hl_ai_mon[s].barn_alt += HLBARN_PULL_SPEED;
		hl_ai_mon[s].barn_ext  = FALSE;
	}
	else
	{
		hl_ai_mon[s].barn_alt = length;
		hl_ai_mon[s].barn_ext = TRUE;
	}

qabk_ctl:
	setting = HLStudioCtlSetting(e->studio, 0,
		-(hl_ai_mon[s].barn_alt + hl_ai_mon[s].barn_adj));

	if (setting >= 0.0)
		e->controllers[0] = setting;
}

U0 HLAIBarnacleKilled(I64 s)
{//CBarnacle::Killed, barnacle.cpp:326. Drops the prey and stops being solid;
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 setting;

	HLAIBarnacleRelease(s);

	if (!e)
		return;

	e->solid      = HLSOLID_NOT;
	e->takedamage = HLDMG_TAKE_NO;

	if (HLPartRandI(2))
		HLSndPlayAt("barnacle/bcl_die1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else
		HLSndPlayAt("barnacle/bcl_die3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	hl_ai_mon[s].barn_alt = 0.0;
	hl_ai_mon[s].barn_adj = 0.0;

	setting = HLStudioCtlSetting(e->studio, 0, 0.0);

	if (setting >= 0.0)
		e->controllers[0] = setting;
}


U0 HLAIRadiusDamage(F64 *src, F64 damage, F64 radius, I64 attacker,
	I64 bits = HLDMG_BLAST)
{//::RadiusDamage, dlls/combat.cpp:1038.
	CHLEntity	*e;
	CHLTrace	 tr;
	F64			 spot[3];
	F64			 from[3];
	F64			 zero[3];
	F64			 delta[3];
	F64			 falloff;
	F64			 dist;
	F64			 hurt;
	I64			 i;

	if (!hl_entities || !hl_map || radius <= 0.0)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	falloff = damage / radius;

	//"in case grenade is lying on the ground", combat.cpp:1049
	HLVecCopy(src, from);
	from[2] += 1.0;

	HLVecCopy(hl_ent_player_org, spot);
	spot[2] += (hl_player_mins[2] + hl_player_maxs[2]) * 0.5;

	HLVecSub(spot, from, delta);
	dist = HLVecLength(delta);

	if (dist <= radius && !hl_ent_player_dead)
	{
		HLTraceEntity(hl_map, from, spot, zero, zero, hl_move_pass, FALSE,
			&tr);

		if (tr.fraction >= 1.0)
		{
			hurt = damage - dist * falloff;

			if (hurt > 0.0)
				HLEntHurtPlayer(hurt, bits, src);
		}
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->takedamage == HLDMG_TAKE_NO)
			goto qard_next;

		if (e->absmax[0] > e->absmin[0] || e->absmax[2] > e->absmin[2])
		{
			spot[0] = (e->absmin[0] + e->absmax[0]) * 0.5;
			spot[1] = (e->absmin[1] + e->absmax[1]) * 0.5;
			spot[2] = (e->absmin[2] + e->absmax[2]) * 0.5;
		}
		else
			HLVecCopy(e->origin, spot);

		HLVecSub(spot, from, delta);
		dist = HLVecLength(delta);

		if (dist > radius)
			goto qard_next;

		HLTraceEntity(hl_map, from, spot, zero, zero, hl_move_pass, FALSE,
			&tr);

		if (tr.fraction < 1.0 && hl_trace_native_ent != i)
			goto qard_next;

		hurt = damage - dist * falloff;

		if (hurt <= 0.0)
			goto qard_next;

		HLDmgHurt(i, attacker, hurt, bits);

qard_next:
	}

	HLEntDrainCalls();
}

U0 HLAITripmineFree(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 ent = hl_ai_mon[s].ent;

	if (e)
	{
		e->in_use     = FALSE;
		e->solid      = HLSOLID_NOT;
		e->takedamage = HLDMG_TAKE_NO;
	}

	if (ent >= 0 && ent < HLENT_MAX)
		hl_ai_mon_of[ent] = -1;

	hl_ai_mon[s].ent        = -1;
	hl_ai_mon[s].mine_armed = FALSE;
}

U0 HLAITripmineExplode(I64 s)
{//DelayDeathThink into CGrenade::Explode, tripmine.cpp:344 and
 //ggrenade.cpp:51. The blast is DMG_BLAST at pev->dmg over dmg * 2.5
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 org[3];
	F64			 dmg;

	if (!e)
		return;

	dmg = hl_ai_mon_info[hl_ai_mon[s].kind].range_dmg;

	HLVecCopy(e->origin, org);

	HLFxExplosionCreate(hl_map, org, ToI64(dmg), tS);

	HLAIInsertSound(HLSOUND_COMBAT, org, 1024.0, 3.0);

	HLSndPlayAt("weapons/explode3.wav", org, 1.0, HLENT_SND_ATTEN, 0,
		HLCHAN_WEAPON);

	HLAITripmineFree(s);

	HLAIRadiusDamage(org, dmg, dmg * HLMINE_BLAST_SCALE, -1);

	//ggrenade.cpp:110-112. CHAN_VOICE there;
	HLSndPlayAt("weapons/debris1.wav", org, 0.55, HLENT_SND_ATTEN, 0,
		HLCHAN_BODY);
}

U0 HLAITripmineArm(I64 s)
{//PowerupThink's arming branch plus MakeBeam, tripmine.cpp:216-262
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 zero[3];

	if (!e || !hl_map)
		return;

	e->solid = HLSOLID_BBOX;
	HLEntSetAbsBox(e);

	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_ent_clip_ignore = hl_ai_mon[s].ent;

	HLTraceEntity(hl_map, e->origin, hl_ai_mon[s].mine_end, zero, zero, 0,
		FALSE, &tr);

	hl_ent_clip_ignore = -1;

	hl_ai_mon[s].mine_len   = tr.fraction;
	hl_ai_mon[s].mine_armed = TRUE;

	HLVecMA(e->origin, HLMINE_RANGE * tr.fraction, hl_ai_mon[s].mine_dir,
		hl_ai_mon[s].mine_beam);

	//EMIT_SOUND_DYN at 0.5 and pitch 75, tripmine.cpp:225
	HLSndPlayAt("weapons/mine_activate.wav", e->origin, 0.5, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_VOICE, 75);
}

U0 HLAITripmineThink(I64 s)
{//PowerupThink and BeamBreakThink in one, on tripmine.cpp's own 0.1s cadence
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 zero[3];
	F64			 delta;

	if (!e)
		return;

	//Killed, tripmine.cpp:334: the blast lands a random beat later
	if (e->health <= 0.0 && !hl_ai_mon[s].mine_dying)
	{
		hl_ai_mon[s].mine_dying = TRUE;
		hl_ai_mon[s].mine_armed = FALSE;
		e->takedamage           = HLDMG_TAKE_NO;
		hl_ai_mon[s].mine_boom  = hl_ent_time + 0.1 +
			ToF64(HLPartRandI(3)) * 0.1;
	}

	if (hl_ai_mon[s].mine_dying)
	{
		if (hl_ent_time >= hl_ai_mon[s].mine_boom)
			HLAITripmineExplode(s);

		return;
	}

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLMINE_THINK;

	if (!hl_ai_mon[s].mine_armed)
	{
		if (hl_ent_time > hl_ai_mon[s].mine_arm)
			HLAITripmineArm(s);

		return;
	}

	//BeamBreakThink, tripmine.cpp:264.
	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_ent_clip_ignore = hl_ai_mon[s].ent;

	HLTraceEntity(hl_map, e->origin, hl_ai_mon[s].mine_end, zero, zero, 0,
		FALSE, &tr);

	hl_ent_clip_ignore = -1;

	HLVecMA(e->origin, HLMINE_RANGE * tr.fraction, hl_ai_mon[s].mine_dir,
		hl_ai_mon[s].mine_beam);

	delta = hl_ai_mon[s].mine_len - tr.fraction;

	if (delta < 0.0)
		delta = -delta;

	//anything crossing the wire moves the fraction, tripmine.cpp:289
	if (delta > HLMINE_BREAK_TOL)
	{
		e->health = 0.0;

		hl_ai_mon[s].mine_dying = TRUE;
		hl_ai_mon[s].mine_armed = FALSE;
		e->takedamage           = HLDMG_TAKE_NO;
		hl_ai_mon[s].mine_boom  = hl_ent_time + 0.1 +
			ToF64(HLPartRandI(3)) * 0.1;
	}
}

U0 HLAITripmineBeams(CHLCanvas *c)
{
	CHLSprFrame	*fr;
	CHLEntity	*e;
	I64			 i;

	if (!c || !hl_ai_laser_spr || !hl_entities)
		return;

	if (hl_ai_laser_spr->num_frames < 1 || !hl_ai_laser_spr->palette)
		return;

	fr = &hl_ai_laser_spr->frames[0];

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].kind != HLMON_TRIPMINE || !hl_ai_mon[i].mine_armed)
			goto qatb_next;

		e = HLEntGet(hl_ai_mon[i].ent);

		if (!e)
			goto qatb_next;

		HLDrawBeam(c, e->origin, hl_ai_mon[i].mine_beam, fr->pixels,
			hl_ai_laser_spr->palette, fr->width, fr->height,
			HLMINE_BEAM_WIDTH, 0.0, HLMINE_BEAM_SCROLL, tS,
			HLMINE_BEAM_R, HLMINE_BEAM_G, HLMINE_BEAM_B,
			HLMINE_BEAM_BRIGHT);

qatb_next:
	}
}


Bool HLAITurretMove(I64 s)
{//MoveTurret, turret.cpp:1043. TRUE while either axis is still travelling.
 //The aim goes onto bone controllers 0 and 1; pev->angles never moves
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 setting;
	F64			 dir;
	F64			 dist;
	Bool		 moved = FALSE;

	if (!e)
		return FALSE;

	if (hl_ai_mon[s].tur_cur[0] != hl_ai_mon[s].tur_goal[0])
	{
		dir = -1.0;

		if (hl_ai_mon[s].tur_goal[0] > hl_ai_mon[s].tur_cur[0])
			dir = 1.0;

		hl_ai_mon[s].tur_cur[0] += 0.1 * hl_ai_mon[s].tur_rate * dir;

		if (dir == 1.0)
		{
			if (hl_ai_mon[s].tur_cur[0] > hl_ai_mon[s].tur_goal[0])
				hl_ai_mon[s].tur_cur[0] = hl_ai_mon[s].tur_goal[0];
		}
		else if (hl_ai_mon[s].tur_cur[0] < hl_ai_mon[s].tur_goal[0])
			hl_ai_mon[s].tur_cur[0] = hl_ai_mon[s].tur_goal[0];

		//SetBoneController(1, -m_vecCurAngles.x), turret.cpp:1069
		setting = HLStudioCtlSetting(e->studio, 1, -hl_ai_mon[s].tur_cur[0]);

		if (setting >= 0.0)
			e->controllers[1] = setting;

		moved = TRUE;
	}

	if (hl_ai_mon[s].tur_cur[1] != hl_ai_mon[s].tur_goal[1])
	{
		dir = -1.0;

		if (hl_ai_mon[s].tur_goal[1] > hl_ai_mon[s].tur_cur[1])
			dir = 1.0;

		dist = hl_ai_mon[s].tur_goal[1] - hl_ai_mon[s].tur_cur[1];

		if (dist < 0.0)
			dist = -dist;

		if (dist > 180.0)
		{
			dist = 360.0 - dist;
			dir  = -dir;
		}

		//accelerate while far off, hold 45 degrees per 0.1s while close
		if (dist > 30.0)
		{
			if (hl_ai_mon[s].tur_rate < HLTUR_TURNRATE * 10.0)
				hl_ai_mon[s].tur_rate += HLTUR_TURNRATE;
		}
		else if (hl_ai_mon[s].tur_rate > 45.0)
			hl_ai_mon[s].tur_rate -= HLTUR_TURNRATE;
		else
			hl_ai_mon[s].tur_rate += HLTUR_TURNRATE;

		hl_ai_mon[s].tur_cur[1] += 0.1 * hl_ai_mon[s].tur_rate * dir;

		if (hl_ai_mon[s].tur_cur[1] < 0.0)
			hl_ai_mon[s].tur_cur[1] += 360.0;
		else if (hl_ai_mon[s].tur_cur[1] >= 360.0)
			hl_ai_mon[s].tur_cur[1] -= 360.0;

		if (dist < 0.05 * HLTUR_TURNRATE)
			hl_ai_mon[s].tur_cur[1] = hl_ai_mon[s].tur_goal[1];

		setting = HLStudioCtlSetting(e->studio, 0,
			hl_ai_mon[s].tur_cur[1] - e->angles[1]);

		if (setting >= 0.0)
			e->controllers[0] = setting;

		moved = TRUE;
	}

	if (!moved)
		hl_ai_mon[s].tur_rate = HLTUR_TURNRATE;

	return moved;
}

U0 HLAITurretPing(I64 s)
{//Ping, turret.cpp:419. One note a second while searching.
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ai_mon[s].tur_ping == 0.0)
		hl_ai_mon[s].tur_ping = hl_ent_time + 1.0;
	else if (hl_ai_mon[s].tur_ping <= hl_ent_time)
	{
		hl_ai_mon[s].tur_ping = hl_ent_time + 1.0;

		HLSndPlayAt("turret/tu_ping.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_ITEM);
	}
}

Bool HLAISentryTouched(I64 s)
{//SentryTouch, turret.cpp:1230
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*c;
	F64			 mins[3];
	F64			 maxs[3];
	I64			 i;

	if (!e)
		return FALSE;

	if (!hl_ent_player_dead && hl_ent_player >= 0)
	{
		HLVecAdd(hl_ent_player_org, hl_player_mins, mins);
		HLVecAdd(hl_ent_player_org, hl_player_maxs, maxs);

		if (maxs[0] >= e->absmin[0] && mins[0] <= e->absmax[0] &&
			maxs[1] >= e->absmin[1] && mins[1] <= e->absmax[1] &&
			maxs[2] >= e->absmin[2] && mins[2] <= e->absmax[2])
			return TRUE;
	}

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (i == s || hl_ai_mon[i].ent < 0)
			goto qast_next;

		c = HLEntGet(hl_ai_mon[i].ent);

		if (!c || c->health <= 0.0)
			goto qast_next;

		if (c->absmax[0] < e->absmin[0] || c->absmin[0] > e->absmax[0])
			goto qast_next;
		if (c->absmax[1] < e->absmin[1] || c->absmin[1] > e->absmax[1])
			goto qast_next;
		if (c->absmax[2] < e->absmin[2] || c->absmin[2] > e->absmax[2])
			goto qast_next;

		return TRUE;

qast_next:
	}

	return FALSE;
}

U0 HLAISentryDeath(I64 s)
{//SentryDeath, turret.cpp:1239.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 spot[3];
	F64			 up[3];
	F64			 setting;
	F64			 roll;

	if (!e)
		return;

	if (hl_ai_mon[s].tur_state != HLTUR_DEAD)
	{
		hl_ai_mon[s].tur_state   = HLTUR_DEAD;
		hl_ai_mon[s].tur_dmg_time = hl_ent_time;

		roll = HLFxRandF(0.0, 1.0);

		if (roll <= 0.33)
			HLSndPlayAt("turret/tu_die.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		else if (roll <= 0.66)
			HLSndPlayAt("turret/tu_die2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		else
			HLSndPlayAt("turret/tu_die3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);

		//SetBoneController(0, 0) and (1, 0), turret.cpp:1264-1265
		setting = HLStudioCtlSetting(e->studio, 0, 0.0);

		if (setting >= 0.0)
			e->controllers[0] = setting;

		setting = HLStudioCtlSetting(e->studio, 1, 0.0);

		if (setting >= 0.0)
			e->controllers[1] = setting;

		HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
		HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);

		HLAISetActivity(s, HLACT_DIE);

		e->solid      = HLSOLID_NOT;
		e->takedamage = HLDMG_TAKE_NO;

		HLAISetState(s, HLMSTATE_DEAD);

		e->angles[1] = HLAngleNorm(e->angles[1] +
			ToF64(HLPartRandI(3)) * 120.0);

		HLEntSetAbsBox(e);
	}

	//smoke for up to two seconds and sparks for up to five
	if (hl_ent_time - hl_ai_mon[s].tur_dmg_time > HLTUR_SPARK_TIME)
		return;

	HLVecSet(spot, e->origin[0] + HLPartRand(16.0),
		e->origin[1] + HLPartRand(16.0), e->origin[2] + 16.0);

	if (hl_ent_time - hl_ai_mon[s].tur_dmg_time < 2.0)
		HLFxSmoke(spot, 15.0, tS);

	HLVecSet(up, 0.0, 0.0, 1.0);
	HLFxSparkShower(spot, up, tS);
}

U0 HLAISentryDeploy(I64 s)
{//Deploy, turret.cpp:638
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ai_mon[s].activity != HLACT_ARM)
	{
		HLAISetActivity(s, HLACT_ARM);

		HLSndPlayAt("turret/tu_deploy.wav", e->origin, HLTUR_MACH_VOL,
			HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_BODY);

		return;
	}

	if (!HLAIAnimDone(s))
		return;


	HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
	HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);

	HLAISetActivity(s, HLACT_COMBAT_IDLE);

	hl_ai_mon[s].tur_state = HLTUR_SEARCH;

	hl_ai_mon[s].tur_sight = 0.0;
}

U0 HLAISentrySearch(I64 s)
{//SearchThink, turret.cpp:822, less the retract and spin-down branches that
 //CSentry's 1e6 timers make unreachable
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];

	if (!e)
		return;

	HLAISetActivity(s, HLACT_COMBAT_IDLE);
	HLAITurretPing(s);

	//"Dead enemy forces a search for new one", turret.cpp:837
	if (hl_ai_mon[s].have_enemy)
	{
		if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
			hl_ai_mon[s].have_enemy = FALSE;
	}

	if (!hl_ai_mon[s].have_enemy)
		HLAILook(s);

	if (hl_ai_mon[s].have_enemy)
	{
		hl_ai_mon[s].tur_sight = 0.0;
		hl_ai_mon[s].tur_state = HLTUR_ACTIVE;
		return;
	}

	//"generic hunt for new victims", turret.cpp:876
	hl_ai_mon[s].tur_goal[1] += 0.1 * hl_ai_mon[s].tur_rate;

	if (hl_ai_mon[s].tur_goal[1] >= 360.0)
		hl_ai_mon[s].tur_goal[1] -= 360.0;

	HLAITurretMove(s);
}

U0 HLAISentryActive(I64 s)
{//ActiveThink, turret.cpp:462
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 mid[3];
	F64			 feet[3];
	F64			 eye[3];
	F64			 dir[3];
	F64			 want[3];
	F64			 aim[3];
	F64			 forward[3];
	F64			 dist;
	Bool		 seen;
	Bool		 attack;

	if (!e)
		return;

	if (!hl_ai_mon[s].have_enemy ||
		!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
	{
		hl_ai_mon[s].have_enemy = FALSE;

		if (hl_ai_mon[s].tur_sight == 0.0)
			hl_ai_mon[s].tur_sight = hl_ent_time + HLTUR_HOLD;
		else if (hl_ent_time > hl_ai_mon[s].tur_sight)
		{
			hl_ai_mon[s].tur_sight = 0.0;
			hl_ai_mon[s].tur_state = HLTUR_SEARCH;
		}

		HLAISetActivity(s, HLACT_COMBAT_IDLE);
		HLAITurretMove(s);
		return;
	}

	HLAIMonEye(s, mid);

	HLVecSub(eye, mid, dir);
	dist = HLVecLength(dir);

	seen = ToBool(dist <= HLTUR_RANGE && HLAIVisible(s, eye));

	if (!seen)
	{
		if (hl_ai_mon[s].tur_sight == 0.0)
			hl_ai_mon[s].tur_sight = hl_ent_time + HLTUR_HOLD;
		else if (hl_ent_time > hl_ai_mon[s].tur_sight)
		{
			hl_ai_mon[s].have_enemy = FALSE;
			hl_ai_mon[s].tur_sight  = 0.0;
			hl_ai_mon[s].tur_state  = HLTUR_SEARCH;
			return;
		}
	}
	else
	{
		hl_ai_mon[s].tur_sight = 0.0;
		HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
		hl_ai_mon[s].enemy_seen = hl_ent_time;
	}

	//UTIL_MakeAimVectors(m_vecCurAngles), turret.cpp:525.
	HLVecSet(aim, -hl_ai_mon[s].tur_cur[0], hl_ai_mon[s].tur_cur[1], 0.0);
	HLAngleVectors(aim, forward, NULL, NULL);

	HLVecNormalize(dir);

	//30 degree slop before it will fire, turret.cpp:536
	attack = ToBool(HLVecDot(dir, forward) > HLTUR_AIM_DOT);

	if (attack)
	{
		HLAISetActivity(s, HLACT_RANGE);

		if (hl_ent_time >= hl_ai_mon[s].next_attack)
		{
			hl_ai_mon[s].next_attack = hl_ent_time +
				hl_ai_mon_info[hl_ai_mon[s].kind].attack_rate;

			HLAIFireAttack(s, FALSE);

			if (hl_ai_mon[s].kind == HLMON_TURRET)
				HLSndPlayAt("turret/tu_fire1.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else if (HLPartRandI(3) == 0)
				HLSndPlayAt("weapons/hks1.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else if (HLPartRandI(2))
				HLSndPlayAt("weapons/hks2.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else
				HLSndPlayAt("weapons/hks3.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
		}
	}
	else
		HLAISetActivity(s, HLACT_COMBAT_IDLE);

	if (seen)
	{
		HLVecSub(eye, mid, dir);
		HLVecToAngles(dir, want);

		if (want[0] > 180.0)
			want[0] -= 360.0;

		if (want[0] > 90.0)
			want[0] = 90.0;
		else if (want[0] < HLTUR_MIN_PITCH)
			want[0] = HLTUR_MIN_PITCH;

		hl_ai_mon[s].tur_goal[0] = want[0];
		hl_ai_mon[s].tur_goal[1] = want[1];
	}

	HLAITurretMove(s);
}

U0 HLAISentryThink(I64 s)
{//the CSentry state machine on turret.cpp's own 0.1s cadence
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLTUR_THINK;

	if (hl_ai_mon[s].tur_state == HLTUR_DEAD)
	{
		HLAISentryDeath(s);
		return;
	}

	if (e->health <= 0.0)
	{
		HLAISentryDeath(s);
		return;
	}

	//CSentry::TakeDamage deploys on the first hit, turret.cpp:1204.
	if (hl_ai_mon[s].tur_state == HLTUR_OFF)
	{
		if (e->health < hl_ai_mon[s].last_health || HLAISentryTouched(s))
		{
			hl_ai_mon[s].last_health = e->health;
			hl_ai_mon[s].tur_state   = HLTUR_DEPLOY;

			HLSndPlayAt("turret/tu_alert.wav", e->origin, HLTUR_MACH_VOL,
				HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		}
		else
		{
			HLAISetActivity(s, HLACT_IDLE);
			return;
		}
	}

	hl_ai_mon[s].last_health = e->health;

	if (hl_ai_mon[s].tur_state == HLTUR_DEPLOY)
	{
		HLAISentryDeploy(s);
		return;
	}

	if (hl_ai_mon[s].tur_state == HLTUR_SEARCH)
	{
		HLAISentrySearch(s);
		return;
	}

	HLAISentryActive(s);
}


U0 HLAIRoachDest(I64 s, I64 mode)
{//PickNewDest, roach.cpp:296.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dir[3];
	F64			 dist;

	if (!e)
		return;

	hl_ai_mon[s].rch_mode = mode;

	//a carcass it can smell wins, roach.cpp:304-320
	if (mode == HLRCH_SMELL_FOOD && hl_ai_mon[s].heard >= 0)
	{
		HLVecSet(hl_ai_mon[s].goal,
			hl_ai_mon[s].heard_pos[0] + HLPartRand(3.0),
			hl_ai_mon[s].heard_pos[1] + HLPartRand(3.0),
			hl_ai_mon[s].heard_pos[2]);

		hl_ai_mon[s].have_goal     = TRUE;
		hl_ai_mon[s].goal_is_enemy = FALSE;
		hl_ai_mon[s].goal_tol      = 8.0;

		return;
	}

	HLVecSet(dir, HLPartRand(1.0), HLPartRand(1.0), 0.0);

	if (HLVecNormalize(dir) <= 0.0)
		HLVecSet(dir, 1.0, 0.0, 0.0);

	dist = HLRCH_DEST_MIN + ToF64(HLPartRandI(HLRCH_DEST_RANGE));

	HLVecMA(e->origin, dist, dir, hl_ai_mon[s].goal);
	hl_ai_mon[s].goal[2] = e->origin[2];

	hl_ai_mon[s].have_goal     = TRUE;
	hl_ai_mon[s].goal_is_enemy = FALSE;
	hl_ai_mon[s].goal_tol      = 8.0;
	hl_ai_mon[s].have_detour   = FALSE;
	HLAIRouteClear(s);
	hl_ai_mon[s].stuck_since   = 0.0;

	if (HLPartRandI(10) == 1)
		HLSndPlayAt("roach/rch_walk.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_BODY, 80 + HLPartRandI(40));
}

U0 HLAIRoachKilled(I64 s)
{//CRoach::Killed, roach.cpp:161.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 ent = hl_ai_mon[s].ent;

	if (e)
	{
		e->solid = HLSOLID_NOT;

		if (HLPartRandI(5) == 1)
			HLSndPlayAt("roach/rch_die.wav", e->origin, 0.8, HLENT_SND_ATTEN,
				ent + 1, HLCHAN_VOICE, 80 + HLPartRandI(40));
		else
			HLSndPlayAt("roach/rch_smash.wav", e->origin, 0.7,
				HLENT_SND_ATTEN, ent + 1, HLCHAN_BODY,
				80 + HLPartRandI(40));

		HLAIInsertSound(HLSOUND_WORLD, e->origin, 128.0, 1.0);

		e->in_use     = FALSE;
		e->takedamage = HLDMG_TAKE_NO;
	}

	if (ent >= 0 && ent < HLENT_MAX)
		hl_ai_mon_of[ent] = -1;

	hl_ai_mon[s].ent = -1;
}

Bool HLAIRoachSquashed(I64 s)
{//CRoach::Touch, roach.cpp:84: a moving player crushes it.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 mins[3];
	F64			 maxs[3];

	if (!e || hl_ent_player < 0 || hl_ent_player_dead)
		return FALSE;

	//"if pOther->pev->velocity == g_vecZero ...
	if (hl_ai_player_move <= 0.0)
		return FALSE;

	HLVecAdd(hl_ent_player_org, hl_player_mins, mins);
	HLVecAdd(hl_ent_player_org, hl_player_maxs, maxs);

	if (maxs[0] < e->absmin[0] || mins[0] > e->absmax[0])
		return FALSE;
	if (maxs[1] < e->absmin[1] || mins[1] > e->absmax[1])
		return FALSE;
	if (maxs[2] < e->absmin[2] || mins[2] > e->absmax[2])
		return FALSE;

	return TRUE;
}

U0 HLAIRoachThink(I64 s)
{//CRoach::MonsterThink, roach.cpp:190
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 lit;
	F64			 dz;
	I64			 moved;

	if (!e)
		return;

	if (e->health <= 0.0 || HLAIRoachSquashed(s))
	{
		HLAIRoachKilled(s);
		return;
	}

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLRCH_THINK;

	if (!hl_ai_mon[s].rch_lit)
	{
		hl_ai_mon[s].rch_lit   = TRUE;
		hl_ai_mon[s].own_think = hl_ent_time + 1.0;
		return;
	}

	lit = ToF64(HLEntLightPoint(hl_map, e));

	if (hl_ai_mon[s].rch_light < 0.0)
		hl_ai_mon[s].rch_light = lit;

	if (hl_ai_mon[s].rch_mode == HLRCH_IDLE ||
		hl_ai_mon[s].rch_mode == HLRCH_EAT)
	{
		if (HLPartRandI(4) == 1)
		{
			hl_ai_mon[s].have_enemy = FALSE;
			HLAILook(s);

			if (hl_ai_mon[s].have_enemy)
			{
				hl_ai_mon[s].rch_nofood = hl_ent_time + HLRCH_NOFOOD_MIN +
					ToF64(HLPartRandI(HLRCH_NOFOOD_RANGE));

				HLAIRoachDest(s, HLRCH_SCARED_ENT);
				HLAISetActivity(s, HLACT_WALK);
			}
			else if (HLPartRandI(150) == 1)
			{
				//boredom, roach.cpp:229
				if (hl_ai_mon[s].rch_mode == HLRCH_EAT)
					hl_ai_mon[s].rch_nofood = hl_ent_time +
						HLRCH_NOFOOD_MIN +
						ToF64(HLPartRandI(HLRCH_NOFOOD_RANGE));

				HLAIRoachDest(s, HLRCH_BORED);
				HLAISetActivity(s, HLACT_WALK);
			}
		}

		//"don't do this stuff if eating", roach.cpp:243
		if (hl_ai_mon[s].rch_mode == HLRCH_IDLE)
		{
			if (hl_ent_time >= hl_ai_mon[s].rch_nofood)
				HLAIListen(s);

			if (lit > hl_ai_mon[s].rch_light)
			{
				HLAIRoachDest(s, HLRCH_SCARED_LIGHT);
				HLAISetActivity(s, HLACT_WALK);
			}
			else if (hl_ai_mon[s].heard >= 0 &&
				hl_ent_time >= hl_ai_mon[s].rch_nofood)
			{
				//food on another z-plane is out of reach, roach.cpp:262
				dz = hl_ai_mon[s].heard_pos[2] - e->origin[2];

				if (dz < 0.0)
					dz = -dz;

				if (dz <= HLRCH_FOOD_Z)
				{
					HLAIRoachDest(s, HLRCH_SMELL_FOOD);
					HLAISetActivity(s, HLACT_WALK);
				}
			}
		}
	}
	else if (hl_ai_mon[s].rch_mode == HLRCH_SCARED_LIGHT)
	{
		if (lit <= hl_ai_mon[s].rch_light)
		{
			hl_ai_mon[s].rch_light = lit;
			hl_ai_mon[s].rch_mode  = HLRCH_IDLE;
			hl_ai_mon[s].have_goal = FALSE;

			HLAISetActivity(s, HLACT_IDLE);
		}
	}

	if (hl_ai_mon[s].activity != HLACT_WALK || !hl_ai_mon[s].have_goal)
	{
		HLAISetActivity(s, HLACT_IDLE);
		return;
	}

	//MakeIdealYaw plus ChangeYaw, roach.cpp:358-360
	hl_ai_mon[s].ideal_yaw = HLAIYawTo(e->origin, hl_ai_mon[s].goal);
	HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, HLRCH_THINK);

	moved = HLAIMoveStep(s, hl_ai_mon_info[hl_ai_mon[s].kind].walk_speed,
		HLRCH_THINK);

	//"stuck, so just pick a new spot to run off to", roach.cpp:366
	if (moved == HLAI_MOVE_BLOCKED)
	{
		HLAIRoachDest(s, hl_ai_mon[s].rch_mode);
		return;
	}

	if (moved == HLAI_MOVE_ARRIVED)
	{
		//"this is roach's new comfortable light level", roach.cpp:381
		hl_ai_mon[s].rch_light = lit;
		hl_ai_mon[s].have_goal = FALSE;

		if (hl_ai_mon[s].rch_mode == HLRCH_SMELL_FOOD)
			hl_ai_mon[s].rch_mode = HLRCH_EAT;
		else
			hl_ai_mon[s].rch_mode = HLRCH_IDLE;

		HLAISetActivity(s, HLACT_IDLE);
		return;
	}

	//"random skitter while moving", roach.cpp:392, unless it is on a b-line
	if (HLPartRandI(150) == 1 &&
		hl_ai_mon[s].rch_mode != HLRCH_SCARED_LIGHT &&
		hl_ai_mon[s].rch_mode != HLRCH_SMELL_FOOD)
		HLAIRoachDest(s, HLRCH_BORED);
}

F64 HLAIMeleeDot(I64 s)
{//flDot
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 forward[3];
	F64			 ang[3];
	F64			 dir[3];
	F64			 feet[3];
	F64			 eye[3];

	if (!e || !hl_ai_mon[s].have_enemy)
		return 1.0;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return 1.0;

	HLVecSet(ang, 0.0, e->angles[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(feet, e->origin, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return 1.0;

	return HLVecDot(dir, forward);
}

Bool HLAICanMelee(I64 s, F64 dist)
{
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee_range <= 0.0)
		return FALSE;

	if (dist > mi->melee_range)
		return FALSE;

	if (HLAIMeleeDot(s) < 0.7)
		return FALSE;

	//CBullsquid::CheckMeleeAttack1, bullsquid.cpp:359.
	if (hl_ai_mon[s].kind == HLMON_BULLSQUID &&
		HLAITargetHealth(hl_ai_mon[s].enemy) > mi->melee2_dmg)
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanMelee2(I64 s, F64 dist)
{
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee2_range <= 0.0)
		return FALSE;

	if (dist > mi->melee2_range)
		return FALSE;

	//CGargantua::CheckMeleeAttack2, gargantua.cpp:934
	if (hl_ai_mon[s].kind == HLMON_GARGANTUA)
	{
		if (HLAIMeleeDot(s) < 0.8)
			return FALSE;
		if (dist <= 80.0)
			return FALSE;
	}
	else if (HLAIMeleeDot(s) < 0.7)
		return FALSE;

	//CBullsquid::CheckMeleeAttack2, bullsquid.cpp:374
	if (hl_ai_mon[s].kind == HLMON_BULLSQUID && HLAICanMelee(s, dist))
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanRange(I64 s, F64 dist)
{
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 feet[3];
	F64			 eye[3];

	if (mi->range_max <= 0.0)
		return FALSE;

	if (dist < mi->range_min || dist > mi->range_max)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].next_attack)
		return FALSE;

	if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
		return FALSE;

	if (!HLAINoFriendlyFire(s))
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	return HLAIVisible(s, eye);
}

Bool HLAICanRange2(I64 s, F64 dist)
{//CheckRangeAttack2, monsters.cpp:959.
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 feet[3];
	F64			 eye[3];

	if (mi->range2_max <= 0.0)
		return FALSE;

	if (dist < mi->range2_min || dist > mi->range2_max)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].next_attack)
		return FALSE;

	if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
		return FALSE;

	if (!HLAINoFriendlyFire(s))
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	return HLAIVisible(s, eye);
}

U0 HLAICheckEnemy(I64 s)
{//CBaseMonster::CheckEnemy plus CheckAttacks, monsters.cpp:1057 and :1005.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*enemy;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	I64			 es;

	HLAIClearCond(s, HLCOND_ENEMY_FACING_ME | HLCOND_CAN_ATTACK |
		HLCOND_NO_AMMO_LOADED);

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
	{
		HLAISetCond(s, HLCOND_ENEMY_DEAD);
		HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
		return;
	}

	//"if ( !pEnemy->IsAlive() )", monsters.cpp:1073.
	if (HLAITargetIsPlayer(hl_ai_mon[s].enemy))
	{
		if (hl_ent_player_dead)
		{
			HLAISetCond(s, HLCOND_ENEMY_DEAD);
			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
			return;
		}
	}
	else
	{
		enemy = HLEntGet(hl_ai_mon[s].enemy);

		if (!enemy || enemy->health <= 0.0)
		{
			HLAISetCond(s, HLCOND_ENEMY_DEAD);
			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
			return;
		}
	}

	if (HLAIVisible(s, eye))
		HLAIClearCond(s, HLCOND_ENEMY_OCCLUDED);
	else
		HLAISetCond(s, HLCOND_ENEMY_OCCLUDED);

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (dist >= HLAI_DIST_TOOFAR)
		HLAISetCond(s, HLCOND_ENEMY_TOOFAR);
	else
		HLAIClearCond(s, HLCOND_ENEMY_TOOFAR);

	//"pEnemyMonster->FInViewCone(this)", monsters.cpp:1108.
	if (HLAIHasCond(s, HLCOND_SEE_ENEMY) &&
		!HLAITargetIsPlayer(hl_ai_mon[s].enemy) &&
		hl_ai_mon[s].enemy >= 0 && hl_ai_mon[s].enemy < HLENT_MAX)
	{
		es = hl_ai_mon_of[hl_ai_mon[s].enemy];

		if (es >= 0 && HLAIInViewCone(es, e->origin))
			HLAISetCond(s, HLCOND_ENEMY_FACING_ME);
	}

	if (hl_ai_mon_info[hl_ai_mon[s].kind].clip_size > 0 &&
		hl_ai_mon[s].ammo <= 0)
		HLAISetCond(s, HLCOND_NO_AMMO_LOADED);

	//FCanCheckAttacks, monsters.cpp:1044
	if (!HLAIHasCond(s, HLCOND_SEE_ENEMY) ||
		HLAIHasCond(s, HLCOND_ENEMY_TOOFAR))
		return;

	if (HLAICanRange(s, dist))
		HLAISetCond(s, HLCOND_CAN_RANGE1);

	if (HLAICanRange2(s, dist))
		HLAISetCond(s, HLCOND_CAN_RANGE2);

	if (HLAICanMelee(s, dist))
		HLAISetCond(s, HLCOND_CAN_MELEE1);

	if (HLAICanMelee2(s, dist))
		HLAISetCond(s, HLCOND_CAN_MELEE2);
}

I64 HLAISelectSchedule(I64 s)
{
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 d[3];
	F64			 tgt[3];
	F64			 tdelta[3];
	F64			 dist;

	if (!e)
		return HLSCHED_IDLE_STAND;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return HLSCHED_DIE;

	if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
	{
		if (!hl_ai_mon[s].have_enemy || HLAIHasCond(s, HLCOND_ENEMY_DEAD))
		{
			hl_ai_mon[s].have_enemy = FALSE;

			HLAIClearCond(s, HLCOND_ENEMY_DEAD);
			HLAISetState(s, HLMSTATE_ALERT);

			return HLSCHED_ALERT_STAND;
		}

		HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, d);
		dist = HLVecLength(d);

		if (mi->flees)
			return HLSCHED_TAKE_COVER;

		if (HLAIHasCond(s, HLCOND_NO_AMMO_LOADED))
			return HLSCHED_RELOAD;

		if (!hl_ai_mon[s].gun_drawn &&
			HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_ARM))
		{
			hl_ai_mon[s].gun_drawn = TRUE;
			return HLSCHED_ARM_WEAPON;
		}

		//schedule.cpp:1427.
		if (HLAIHasCond(s, HLCOND_NEW_ENEMY))
			return HLSCHED_WAKE_ANGRY;

		//schedule.cpp:1434
		if (HLAIHasCond(s, HLCOND_LIGHT_DAMAGE) && !hl_ai_mon[s].flinched)
			return HLSCHED_SMALL_FLINCH;

		//schedule.cpp:1438.
		if (!HLAIHasCond(s, HLCOND_SEE_ENEMY))
		{
			if (!HLAIHasCond(s, HLCOND_ENEMY_OCCLUDED))
				return HLSCHED_COMBAT_FACE;

			if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY * 0.5)
				return HLSCHED_STANDOFF;

			return HLSCHED_CHASE_ENEMY;
		}

		//the heavier swing first when both are in reach.
		if (HLAIHasCond(s, HLCOND_CAN_MELEE2))
			return HLSCHED_MELEE_ATTACK2;

		if (HLAIHasCond(s, HLCOND_CAN_MELEE1))
			return HLSCHED_MELEE_ATTACK1;

		if (HLAIHasCond(s, HLCOND_CAN_RANGE1))
		{
			if (!mi->slot_attack || HLAIOccupySlot(s, mi->slot_attack))
				return HLSCHED_RANGE_ATTACK1;

			if (hl_ai_mon[s].in_cover)
				return HLSCHED_STANDOFF;

			return HLSCHED_TAKE_COVER;
		}

		//schedule.cpp:1461.
		if (HLAIHasCond(s, HLCOND_CAN_RANGE2))
			return HLSCHED_RANGE_ATTACK2;

		//in melee reach with the refire up but facing away.
		if (mi->melee_range > 0.0 && dist <= mi->melee_range &&
			HLAIMeleeDot(s) < 0.7)
			return HLSCHED_COMBAT_FACE;

		if (hl_ent_time < hl_ai_mon[s].next_attack)
		{
			if (mi->melee_range > 0.0 && dist <= mi->melee_range)
				return HLSCHED_COMBAT_FACE;

			if (mi->range_max > 0.0 && dist >= mi->range_min &&
				dist <= mi->range_max)
				return HLSCHED_COMBAT_STAND;

			if (mi->range2_max > 0.0 && dist >= mi->range2_min &&
				dist <= mi->range2_max)
				return HLSCHED_COMBAT_STAND;
		}

		return HLSCHED_CHASE_ENEMY;
	}

	if (hl_ai_mon[s].ent >= 0 && hl_ai_mon[s].ent < HLENT_MAX &&
		HLAITalkIsFollowing(hl_ai_mon[s].ent))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			HLAITalkStopFollowing(hl_ai_mon[s].ent, FALSE);
		else if (!hl_ai_mon[s].have_enemy)
		{
			//scientist.cpp:978-983
			if (HLAICanHeal(s) && HLAITalkPointOf(HLTLK_PLAYER, tgt))
			{
				HLVecSub(tgt, e->origin, tdelta);

				if (HLVecLength(tdelta) <= HLAI_FOLLOW_DIST)
					return HLSCHED_HEAL;
			}

			return HLSCHED_TARGET_FACE;
		}
	}

	if (hl_ai_mon[s].state == HLMSTATE_ALERT)
	{
		//schedule.cpp:1383.
		if (HLAIHasCond(s, HLCOND_ENEMY_DEAD))
		{
			HLAIClearCond(s, HLCOND_ENEMY_DEAD);

			if (HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_VICTORY))
				return HLSCHED_VICTORY_DANCE;
		}

		if (hl_ai_mon[s].have_enemy)
			return HLSCHED_ALERT_FACE;

		if (HLAIHasCond(s, HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE))
			return HLSCHED_ALERT_SM_FLINCH;

		if (HLAIHasCond(s, HLCOND_HEAR_SOUND) && hl_ai_mon[s].heard >= 0)
		{
			if (hl_ai_mon[s].heard_type & HLSOUND_DANGER)
				return HLSCHED_COVER_SOUND;

			return HLSCHED_INVEST_SOUND;
		}

		return HLSCHED_ALERT_STAND;
	}

	if (HLAIHasCond(s, HLCOND_HEAR_SOUND) && hl_ai_mon[s].heard >= 0)
	{
		HLAISetState(s, HLMSTATE_ALERT);
		return HLSCHED_ALERT_STAND;
	}

	return HLSCHED_IDLE_STAND;
}


U0 HLAIDropItem(I64 s, U8 *classname, F64 up)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 pos[3];

	if (!e)
		return;

	HLVecCopy(e->origin, pos);

	pos[2] = pos[2] + up;

	HLEntCreateNamed(classname, pos, e->angles, hl_ai_mon[s].ent);
}

//"pev->origin + (0,0,32)"
#define HLAI_DROP_UP			32.0

U0 HLAIDropDeathItems(I64 s)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 gun;

	if (!e)
		return;

	//CBarney::Killed, barney.cpp:614.
	if (hl_ai_mon[s].kind == HLMON_BARNEY)
	{
		if (HLAIBodygroup(e->studio, e->body, HLBARNEY_GUN_GROUP) >=
			HLBARNEY_GUN_GONE)
			return;

		HLAISetBodygroup(e, HLBARNEY_GUN_GROUP, HLBARNEY_GUN_GONE);
		HLAIDropItem(s, "weapon_9mmhandgun", HLAI_DROP_UP);

		return;
	}

	//CHGrunt::HandleAnimEvent, hgrunt.cpp:849-873
	if (hl_ai_mon[s].kind != HLMON_HGRUNT)
		return;

	gun = HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP);

	if (gun == HLGRUNT_GUN_NONE)
		return;

	HLAISetBodygroup(e, HLGRUNT_GUN_GROUP, HLGRUNT_GUN_NONE);

	if (gun == HLGRUNT_GUN_SHOTGUN)
		HLAIDropItem(s, "weapon_shotgun", HLAI_DROP_UP);
	else
		HLAIDropItem(s, "weapon_9mmAR", HLAI_DROP_UP);

	//hgrunt.cpp:868, read off the head bodygroup for the reason above.
	if (HLAIBodygroup(e->studio, e->body, HLGRUNT_HEAD_GROUP) ==
		HLGRUNT_HEAD_M203)
		HLAIDropItem(s, "ammo_ARgrenades", HLAI_DROP_UP);
}

U0 HLAIMonThink(I64 s, F64 dt)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	CHLTrace	 leap_tr;
	F64			 gib_dir[3];
	F64			 leap_start[3];
	F64			 leap_end[3];
	F64			 over;
	F64			 dur;
	I64			 bits;
	I64			 seq;
	Bool		 gib;
	Bool		 human;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
	{
		hl_ai_mon[s].leap_vel[2] -= HLPHYS_GRAVITY * dt;
		HLVecCopy(e->origin, leap_start);
		HLVecMA(leap_start, dt, hl_ai_mon[s].leap_vel, leap_end);

		hl_ent_clip_ignore  = hl_ai_mon[s].ent;
		hl_clip_for_monster = TRUE;
		HLTraceEntity(hl_map, leap_start, leap_end, e->mins, e->maxs, 0,
			FALSE, &leap_tr);
		hl_ent_clip_ignore  = -1;
		hl_clip_for_monster = FALSE;

		HLVecCopy(leap_tr.end_pos, e->origin);
		HLEntSetAbsBox(e);

		if (hl_ai_mon[s].leaping && hl_ent_clip_hit_player)
		{
			HLAIHullAttack(s, mi->melee_range * 1.5, mi->melee_dmg);
			hl_ai_mon[s].leaping = FALSE;
		}
		else if (leap_tr.fraction < 1.0 || hl_ent_time >= hl_ai_mon[s].leap_die)
		{
			hl_ai_mon[s].leaping = FALSE;
			hl_ai_mon[s].tossing = FALSE;
		}

		if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
			return;
	}

	if (hl_ai_mon[s].kind == HLMON_TRIPMINE)
	{
		HLAITripmineThink(s);
		return;
	}

	if (HLAIIsTurretKind(hl_ai_mon[s].kind))
	{
		HLAISentryThink(s);
		return;
	}

	if (hl_ai_mon[s].kind == HLMON_COCKROACH)
	{
		HLAIRoachThink(s);
		return;
	}

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
	{
		HLAIRunSchedule(s, dt);
		return;
	}

	if (e->health <= 0.0)
	{
		hl_ai_mon[s].last_health = 0.0;
		hl_ai_mon_kills++;

		HLAIDropDeathItems(s);

		HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);

		bits = HLDmgNoteBits(hl_ai_mon[s].ent);
		over = HLDmgNoteHealth(hl_ai_mon[s].ent);
		gib  = FALSE;

		if ((bits & HLDMG_ALWAYSGIB) != 0)
			gib = TRUE;
		else if ((bits & HLDMG_NEVERGIB) == 0 && over < HLGIB_HEALTH_VALUE)
			gib = TRUE;

		if (gib)
		{
			//HasHumanGibs
			human = ToBool(mi->classify == HLCLASS_HUMAN_MILITARY ||
				mi->classify == HLCLASS_HUMAN_PASSIVE ||
				mi->classify == HLCLASS_PLAYER_ALLY);

			//GibMonster opens with the splat
			HLSndPlayAt("common/bodysplat.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, HLCHAN_WEAPON);

			HLVecCopy(hl_attack_dir, gib_dir);

			HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir, over,
				HLGIB_DEATH_COUNT, human, mi->blood, hl_ent_time);

			//only humans throw skulls, dlls/combat.cpp:310-315
			if (human)
				HLGibSpawnHeadGib(e->origin, e->origin, over, mi->blood,
					hl_ent_time);
		}

		if (hl_ai_mon[s].kind == HLMON_BARNACLE)
			HLAIBarnacleKilled(s);

		if (hl_ai_mon[s].barn_host >= 0)
		{
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_prey = -1;
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_lifting = FALSE;
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_kill = -1.0;
			hl_ai_mon[s].barn_host = -1;
			e->movetype = HLMOVETYPE_STEP;
		}

		HLAISetState(s, HLMSTATE_DEAD);
		HLAISetSchedule(s, HLSCHED_DIE);
		return;
	}

	if (hl_ai_mon[s].barn_host >= 0)
	{
		HLAIRunSchedule(s, dt);
		return;
	}

	if (hl_ai_mon[s].kind == HLMON_BARNACLE)
	{
		HLAIBarnacleThink(s);
		return;
	}

	if (e->health < hl_ai_mon[s].last_health)
	{
		if (hl_ai_mon[s].last_health - e->health >= HLAI_HEAVY_DAMAGE)
			HLAISetCond(s, HLCOND_HEAVY_DAMAGE);

		HLAISetCond(s, HLCOND_LIGHT_DAMAGE);

		hl_ai_mon[s].last_health = e->health;

		if (hl_ai_mon[s].state == HLMSTATE_IDLE)
			HLAISetState(s, HLMSTATE_ALERT);

		HLAIInsertSound(HLSOUND_COMBAT, e->origin, 384.0, 0.3);
	}

	hl_ai_mon[s].last_health = e->health;

	if (!hl_ai_mon[s].settled)
	{
		hl_ai_mon[s].settled = TRUE;

		if (!mi->flies &&
			HLAIDropToFloorHard(e, e->mins, e->maxs, e->origin))
			HLEntSetAbsBox(e);
	}

	if (hl_ai_mon[s].kind == HLMON_GENERIC)
		return;

	if (!hl_ai_mon[s].squad_tried)
	{
		hl_ai_mon[s].squad_tried = TRUE;

		if (mi->squads)
			HLAISquadRecruit(s, HLAI_SQUAD_RADIUS, HLAI_SQUAD_MAX - 1);
	}

	if (hl_ent_time >= hl_ai_mon[s].next_blink)
	{
		hl_ai_mon[s].next_blink = hl_ent_time + 0.1;

		//houndeye.cpp:856-866.
		if (hl_ai_mon[s].kind == HLMON_HOUNDEYE)
		{
			if (e->skin == 0)
			{
				if (HLPartRandI(128) == 0)
					e->skin = 3;
			}
			else
				e->skin--;
		}

		//bullsquid.cpp:779-789
		if (hl_ai_mon[s].kind == HLMON_BULLSQUID)
		{
			e->skin = 0;

			if (HLPartRandI(40) == 0)
				e->skin = 1;
		}
	}

	if (hl_ent_time >= hl_ai_mon[s].next_look)
	{
		hl_ai_mon[s].next_look = hl_ent_time + HLAI_LOOK_PERIOD;
		HLAILook(s);
		HLAIListen(s);
		HLAISmell(s);
		HLAICheckEnemy(s);
	}

	if (hl_ai_mon[s].have_enemy)
	{
		if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY)
		{
			hl_ai_mon[s].have_enemy = FALSE;

			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED |
				HLCOND_ENEMY_TOOFAR | HLCOND_ENEMY_FACING_ME |
				HLCOND_CAN_ATTACK);

			if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
				HLAISetState(s, HLMSTATE_ALERT);
		}
		else if (hl_ai_mon[s].state != HLMSTATE_COMBAT)
		{
			HLAISquadMakeEnemy(s, hl_ai_mon[s].enemy);

			HLAISetState(s, HLMSTATE_COMBAT);
		}
	}

	if (hl_ai_mon[s].state != HLMSTATE_COMBAT && mi->snd_idle[0])
	{
		if (hl_ent_time >= hl_ai_mon[s].next_idle_snd)
		{
			HLAIMonSound(s, mi->snd_idle);
			hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
				ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));
		}
	}

	HLAITalkThink(s, dt);

	if (!HLAISchedValid(s))
		hl_ai_mon[s].sched_done = TRUE;

	if (hl_ai_mon[s].sched == HLSCHED_NONE || hl_ai_mon[s].sched_done)
		HLAISetSchedule(s, HLAISelectSchedule(s));

	HLAIRunSchedule(s, dt);

	if (hl_ai_mon[s].state != HLMSTATE_SCRIPT &&
		hl_ai_mon[s].state != HLMSTATE_DEAD &&
		hl_ai_mon[s].activity == HLACT_IDLE && e->studio &&
		hl_ent_time >= hl_ai_mon[s].next_fidget)
	{
		if (e->anim_loop)
			seq = HLStudioLookupActivity(e->studio, HLAIActToSDK(HLACT_IDLE));
		else
			seq = HLStudioLookupActivityHeaviest(e->studio,
				HLAIActToSDK(HLACT_IDLE));

		if (seq >= 0 && seq != e->seq)
		{
			//ResetSequenceInfo, animating.cpp:110
			e->seq              = seq;
			e->anim_start       = hl_ent_time;
			e->anim_done        = FALSE;
			e->anim_event_frame = -1;
			e->anim_loop        = HLStudioSeqLoops(e->studio, seq);

			hl_ai_mon[s].act_seq = seq;
		}

		dur = HLStudioSeqDuration(e->studio, e->seq);

		if (dur <= 0.0)
			dur = 1.0;

		hl_ai_mon[s].next_fidget = hl_ent_time + dur;
	}

	HLAIClearCond(s, HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE);
}

U0 HLAIMonsterJumpCheck()
{
	CHLEntity	*trig;
	CHLEntity	*mon;
	F64			 speed;
	F64			 height;
	I64			 s;
	I64			 i;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		trig = &hl_entities[i];

		if (!trig->in_use || trig->touch_fn != HLM_MONSTERJUMP_TOUCH)
			goto qmj_trig;

		if (trig->solid != HLSOLID_TRIGGER)
			goto qmj_trig;

		speed  = trig->speed;
		height = trig->height;
		if (speed <= 0.0)
			speed = 200.0;
		if (height <= 0.0)
			height = 150.0;

		for (s = 0; s < hl_ai_mon_count; s++)
		{
			if (hl_ai_mon[s].ent < 0)
				goto qmj_mon;

			if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
				goto qmj_mon;

			if (hl_ai_mon[s].state == HLMSTATE_DEAD)
				goto qmj_mon;

			mon = HLEntGet(hl_ai_mon[s].ent);
			if (!mon || !mon->in_use)
				goto qmj_mon;

			if (!HLEntBoxOverlap(trig, mon->absmin, mon->absmax))
				goto qmj_mon;

			mon->origin[2] += 1.0;
			HLEntSetAbsBox(mon);

			HLVecScale(trig->move_dir, speed, hl_ai_mon[s].leap_vel);
			hl_ai_mon[s].leap_vel[2] += height;
			hl_ai_mon[s].tossing     = TRUE;
			hl_ai_mon[s].leap_die    = hl_ent_time + 2.0;

			HLEntSetThink(trig, HLM_MONSTERJUMP_THINK, hl_ent_time);

qmj_mon:
		}

qmj_trig:
	}
}

U0 HLAIMonsterFrame(F64 dt)
{
	CHLEntity	*e;
	F64			 d[3];
	I64			 s;
	I64			 i;

	HLAIMonSync;

	//"nodegraph 1" in the console turns the route diagnostics on
	hl_ai_graph_log = ToBool(HLCvarGet("nodegraph") != 0.0);

	HLVecSub(hl_ent_player_org, hl_ai_player_last, d);
	hl_ai_player_move = HLVecLength(d);
	HLVecCopy(hl_ent_player_org, hl_ai_player_last);

	hl_ai_script_log = ToBool(HLCvarGet("scriptlog") != 0.0);
	hl_ai_graph_log  = ToBool(HLCvarGet("nodegraph") != 0.0);

	HLAIGraphEnsure();

	if (!hl_ai_mon_count || !hl_map)
		return;

	HLAIMonsterJumpCheck;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		s = hl_ai_mon[i].ent;

		if (s < 0 || s >= HLENT_MAX)
			hl_ai_mon[i].scripted = FALSE;
		else
			hl_ai_mon[i].scripted = ToBool(hl_ai_cine[s].owner >= 0);
	}

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].ent < 0)
			goto qamf_next;

		e = HLEntGet(hl_ai_mon[i].ent);

		if (!e)
		{
			if (!hl_ai_mon_revive || hl_ai_mon[i].state == HLMSTATE_DEAD)
				goto qamf_next;

			if (hl_ai_mon[i].ent >= hl_num_entities)
				goto qamf_next;

			e = &hl_entities[hl_ai_mon[i].ent];

			e->in_use     = TRUE;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->takedamage = HLDMG_TAKE_NO;
			e->think_fn   = HLM_NONE;
			e->next_think = 0.0;
			e->health     = 0.0;
		}

		if (hl_ai_mon[i].scripted)
		{
			HLAISetState(i, HLMSTATE_SCRIPT);
			HLAICineActorTick(i, dt);
			goto qamf_next;
		}

		if (hl_ai_mon[i].state == HLMSTATE_SCRIPT)
			HLAISetState(i, HLMSTATE_IDLE);

		if (hl_ai_mon[i].state == HLMSTATE_NONE)
			HLAISetState(i, HLMSTATE_IDLE);

		HLAIMonThink(i, dt);

qamf_next:
	}
}


U8 *HLAIStateName(I64 state)
{
	if (state == HLMSTATE_IDLE)		return "Idle";
	if (state == HLMSTATE_ALERT)	return "Alert";
	if (state == HLMSTATE_COMBAT)	return "Combat";
	if (state == HLMSTATE_SCRIPT)	return "Scripted";
	if (state == HLMSTATE_DEAD)		return "Dead";

	return "None";
}

U8 *HLAISchedName(I64 sched)
{//the pName field of each Schedule_t in defaultai.cpp
	if (sched == HLSCHED_IDLE_STAND)		return "IdleStand";
	if (sched == HLSCHED_ALERT_STAND)		return "AlertStand";
	if (sched == HLSCHED_ALERT_FACE)		return "AlertFace";
	if (sched == HLSCHED_WAKE_ANGRY)		return "WakeAngry";
	if (sched == HLSCHED_CHASE_ENEMY)		return "ChaseEnemy";
	if (sched == HLSCHED_MELEE_ATTACK1)		return "MeleeAttack1";
	if (sched == HLSCHED_RANGE_ATTACK1)		return "RangeAttack1";
	if (sched == HLSCHED_TAKE_COVER)		return "TakeCoverFromEnemy";
	if (sched == HLSCHED_SMALL_FLINCH)		return "SmallFlinch";
	if (sched == HLSCHED_DIE)				return "Die";
	if (sched == HLSCHED_IDLE_WALK)			return "IdleWalk";
	if (sched == HLSCHED_ALERT_SM_FLINCH)	return "AlertSmallFlinch";
	if (sched == HLSCHED_INVEST_SOUND)		return "InvestigateSound";
	if (sched == HLSCHED_COMBAT_FACE)		return "CombatFace";
	if (sched == HLSCHED_COMBAT_STAND)		return "CombatStand";
	if (sched == HLSCHED_CHASE_FAILED)		return "ChaseEnemyFailed";
	if (sched == HLSCHED_STANDOFF)			return "Standoff";
	if (sched == HLSCHED_RELOAD)			return "Reload";
	if (sched == HLSCHED_ARM_WEAPON)		return "ArmWeapon";
	if (sched == HLSCHED_MELEE_ATTACK2)		return "MeleeAttack2";
	if (sched == HLSCHED_RANGE_ATTACK2)		return "RangeAttack2";
	if (sched == HLSCHED_SPECIAL_ATTACK1)	return "SpecialAttack1";
	if (sched == HLSCHED_COVER_SOUND)		return "TakeCoverFromBestSound";
	if (sched == HLSCHED_COVER_ORIGIN)		return "TakeCoverFromOrigin";
	if (sched == HLSCHED_COWER)				return "Cower";
	if (sched == HLSCHED_VICTORY_DANCE)		return "VictoryDance";
	if (sched == HLSCHED_AMBUSH)			return "Ambush";
	if (sched == HLSCHED_BARNACLE_GRAB)		return "BarnacleVictim";
	if (sched == HLSCHED_BARNACLE_CHOMP)	return "BarnacleChomp";
	if (sched == HLSCHED_FAIL)				return "Fail";
	if (sched == HLSCHED_TARGET_FACE)		return "FaceTarget";
	if (sched == HLSCHED_TARGET_CHASE)		return "Follow";
	if (sched == HLSCHED_HEAL)				return "Heal";

	return "No Schedule";
}

U8 *HLAIActName(I64 act)
{//activity_map[] in monsters.cpp, restricted to the activities this port has
	if (act == HLACT_IDLE)			return "ACT_IDLE";
	if (act == HLACT_WALK)			return "ACT_WALK";
	if (act == HLACT_RUN)			return "ACT_RUN";
	if (act == HLACT_MELEE)			return "ACT_MELEE_ATTACK1";
	if (act == HLACT_MELEE2)		return "ACT_MELEE_ATTACK2";
	if (act == HLACT_RANGE)			return "ACT_RANGE_ATTACK1";
	if (act == HLACT_RANGE2)		return "ACT_RANGE_ATTACK2";
	if (act == HLACT_DIE)			return "ACT_DIESIMPLE";
	if (act == HLACT_FLINCH)		return "ACT_SMALL_FLINCH";
	if (act == HLACT_RELOAD)		return "ACT_RELOAD";
	if (act == HLACT_COMBAT_IDLE)	return "ACT_COMBAT_IDLE";
	if (act == HLACT_SIGNAL)		return "ACT_SIGNAL1";
	if (act == HLACT_THREAT)		return "ACT_THREAT_DISPLAY";
	if (act == HLACT_VICTORY)		return "ACT_VICTORY_DANCE";
	if (act == HLACT_COWER)			return "ACT_COWER";
	if (act == HLACT_ARM)			return "ACT_ARM";
	if (act == HLACT_DISARM)		return "ACT_DISARM";
	if (act == HLACT_EAT)			return "ACT_EAT";
	if (act == HLACT_SPECIAL)		return "ACT_SPECIAL_ATTACK1";
	if (act == HLACT_BARN_HIT)		return "ACT_BARNACLE_HIT";
	if (act == HLACT_BARN_PULL)		return "ACT_BARNACLE_PULL";
	if (act == HLACT_BARN_CHOMP)	return "ACT_BARNACLE_CHOMP";
	if (act == HLACT_BARN_CHEW)		return "ACT_BARNACLE_CHEW";

	return "ACT_INVALID";
}

U0 HLAIMonReportOne(I64 i)
{
	CHLEntity	*e = HLEntGet(hl_ai_mon[i].ent);
	I64			 slot;
	I64			 task;

	if (!e)
		return;

	"%s: ", e->classname;
	"State: %s, ", HLAIStateName(hl_ai_mon[i].state);
	"Activity %s, ", HLAIActName(hl_ai_mon[i].activity);

	if (hl_ai_mon[i].sched > HLSCHED_NONE &&
		hl_ai_mon[i].sched < HLSCHED_COUNT)
	{
		"Schedule %s, ", HLAISchedName(hl_ai_mon[i].sched);

		if (hl_ai_mon[i].task < hl_ai_sched_len[hl_ai_mon[i].sched])
		{
			slot = hl_ai_mon[i].sched * HLAI_SCHED_TASKS + hl_ai_mon[i].task;
			task = hl_ai_sched_task[slot];

			"Task %d (#%d), ", task, hl_ai_mon[i].task;
		}
	}
	else
		"No Schedule, ";

	if (hl_ai_mon[i].have_enemy)
	{
		if (HLAITargetIsPlayer(hl_ai_mon[i].enemy))
			"\nEnemy is player";
		else
			"\nEnemy is %s", hl_entities[hl_ai_mon[i].enemy].classname;
	}
	else
		"No enemy";

	if (hl_ai_mon[i].have_goal && hl_ai_mon[i].move_speed > 0.0)
		" Moving ";

	if (!HLAIInSquad(i))
		"not ";

	"In Squad, ";

	if (!HLAIIsLeader(i))
		"not ";

	"Leader.";

	"\n";
	"Yaw speed:%3.1f,Health: %3.1f\n",
		hl_ai_mon_info[hl_ai_mon[i].kind].yaw_speed, e->health;

	slot = HLAISquadLeader(i);

	"  slot %d of %d, ammo %d/%d, heard %d at %.0f %.0f %.0f\n",
		hl_ai_mon[i].my_slot, hl_ai_mon[slot].squad_slots, hl_ai_mon[i].ammo,
		hl_ai_mon[i].clip,
		hl_ai_mon[i].heard_type, hl_ai_mon[i].heard_pos[0],
		hl_ai_mon[i].heard_pos[1], hl_ai_mon[i].heard_pos[2];

	"  body %d, aim pitch %3.1f, blend %.2f\n",
		e->body, hl_ai_mon[i].aim_pitch, e->blending[0];
}

U0 HLAIMonReport()
{
	I64 i;
	I64 live = 0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire > hl_ent_time)
			live++;
	}

	"HLAI: %d monsters tracked, %d dead, %d sounds in the world\n",
		hl_ai_mon_count, hl_ai_mon_kills, live;

	if (hl_ai_graph_ready)
		"HLAI: node graph %s, %d nodes %d links\n", hl_ai_graph_map,
			hl_ai_node_count, hl_ai_link_count;
	else
		"HLAI: no node graph for %s\n", hl_ai_graph_map;

	for (i = 0; i < hl_ai_mon_count; i++)
		HLAIMonReportOne(i);
}


U0 HLAISentenceFrame(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 duration;
	F64			 volume;
	F64			 atten;
	I64			 who;
	I64			 listener;
	Bool		 concurrent;

	if (!e || self >= HLENT_MAX)
		return;

	if (!hl_ai_talk[self].inited)
	{
		hl_ai_talk[self].inited = TRUE;

		if (!e->targetname[0])
		{
			e->toggle_state            = HLTS_GOING_DOWN;
			hl_ai_talk[self].next_think = hl_ent_time + 1.0;
		}
	}

	if (e->toggle_state == HLTS_AT_TOP)
	{
		if (hl_ent_time < hl_ai_talk[self].next_think)
			return;

		e->toggle_state = HLTS_AT_BOTTOM;

		if (!e->targetname[0])
			e->toggle_state = HLTS_GOING_DOWN;

		return;
	}

	if (e->toggle_state != HLTS_GOING_DOWN)
		return;

	if (e->pain_finished < 0.0)
	{
		e->pain_finished            = 0.0;
		hl_ai_talk[self].next_think = 0.0;
	}

	if (hl_ent_time < hl_ai_talk[self].next_think)
		return;

	who = HLAISentenceSpeaker(e);

	if (who < 0)
	{
		//nobody acceptable: try again on m_flRepeat + 0.5, scripted.cpp:1089.
		hl_ai_talk[self].next_think = hl_ent_time + e->ai_refire + 0.5;
		return;
	}

	duration = e->duration;
	atten    = HLAISentenceAtten(e->ai_atten);

	if (e->volume > 1.0)
		volume = e->volume * 0.1;
	else
		volume = 1.0;

	//StartSentence, scripted.cpp:1193
	concurrent = ToBool(!(e->spawnflags & HLAI_SF_SENTENCE_CONCURRENT));

	listener = HLAISentenceListener(e, who);

	if (!HLAITalkPlayScripted(who, e->ai_sentence, duration, volume, atten,
		concurrent, listener))
	{
		hl_ai_talk[self].next_think = hl_ent_time + e->ai_refire + 0.5;
		return;
	}

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	if (e->spawnflags & HLAI_SF_SENTENCE_ONCE)
	{
		e->in_use = FALSE;
		return;
	}

	hl_ai_talk[self].next_think = hl_ent_time + duration + e->ai_refire;

	if (e->targetname[0])
		e->toggle_state = HLTS_AT_TOP;
}

U0 HLAIFrame(F64 dt)
{
	CHLEntity	*e;
	I64			 i;

	if (!hl_entities)
		return;

	HLAIMonSync;

	HLAISentenceUpdate(hl_ent_time);

	HLAISoundFrame;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use)
			goto qaif_next;

		if (e->studio && HLStudioHasMouth(e->studio))
			e->controllers[HLST_MOUTH_CTL] =
				HLStudioMouthSetting(HLSndVoiceAmplitude(i + 1));

		if (e->ent_class == HLC_SCRIPT)
		{
			HLAICineTick(i);
			goto qaif_next;
		}

		if (e->ent_class == HLC_SENTENCE)
		{
			HLAISentenceFrame(i);
			goto qaif_next;
		}

		if (!StrCompare(e->classname, "monster_sitting_scientist"))
		{
			HLAISitScientistThink(i);

			if (e->studio)
				HLAIEntityEvents(e, i, HLAIEntityCycle(e));

			goto qaif_next;
		}

		if (e->studio && e->anim_start == 0.0 && e->ent_class != HLC_MONSTER)
		{
			e->anim_start = hl_ent_time;
			e->anim_loop  = TRUE;
		}

		if (e->studio)
		{
			if (i < HLENT_MAX && hl_ai_mon_of[i] >= 0)
				HLAIMonEvents(hl_ai_mon_of[i], i, HLAIEntityCycle(e));
			else
				HLAIEntityEvents(e, i, HLAIEntityCycle(e));
		}

qaif_next:
	}

	HLAIMonsterFrame(dt);
}
