// HLAI.ZC - scripted sequences, sentences and combat AI
//
// HL's characters are scripted rather than emergent: scripted_sequence
// entities name a monster, a mark to stand on and an animation to play, plus
// sentences for the speech.
//
// Compiles after HLEntity.ZC, so it can call the entity system. The reverse is
// not true; HLEntity.ZC's dispatcher only records that a script was triggered
// and the frame function here does the work.
//
// Second half of the file: monster state machine, task/schedule interpreter,
// sensing through the CLASS_* relationship matrix, attacks and death. There is
// no node graph in this tree, so movement is straight at the goal with a wall
// slide and a monster will not go round a corner.

//--- sentences --------------------------------------------------------------
//
// sound/sentences.txt is a table of
//
//     NAME  dir/word1(mods) word2! word3
//
// Each word is sound/<dir>/<word>.wav. A '/' inside a token sets the directory
// for the words that follow, '(...)' carries pitch and timing modifiers, and
// '!' ',' '.' are punctuation affecting delivery. Words play in sequence, so a
// sentence is a small scheduler rather than one sound.
//
// The file is ~50KB holding around a thousand sentences. It stays resident and
// the table indexes into it; pre-splitting every word would cost a few hundred
// KB of globals to save one tokenise at play time.

#define HLAI_MAX_SENTENCES	1400
#define HLAI_SENT_NAME		20
#define HLAI_WORD_MAX		48

class CHLSentence
{
	U8	 name[HLAI_SENT_NAME];
	U8	*text;			//borrowed from hl_ai_sent_raw, NUL terminated
};

CHLSentence	hl_ai_sent[HLAI_MAX_SENTENCES];
I64			hl_ai_sent_count = 0;
U8			*hl_ai_sent_raw  = NULL;

// A sentence runs on the speaker's CHAN_VOICE, one per entity, not one for the
// whole world: EMIT_SOUND_DYN on CHAN_VOICE replaces that entity's line and
// leaves every other entity's alone (talkmonster.cpp:1214). Two characters in
// the same room are both heard. A channel is keyed by entity index, so a second
// line from the same speaker cuts the first.
#define HLAI_SENT_CHANS		6

class CHLSentChan
{
	I64	sent;		//index into hl_ai_sent, -1 when idle
	I64	word;		//next word to play
	F64	next;		//hl_ent_time the next word starts
	I64	ent;		//speaking entity index, -1 for a fixed world position
	F64	org[3];
	F64	volume;
	F64	atten;
	I64	pitch;		//percentage of the recorded rate
	F64	claimed;	//hl_ent_time the channel was taken, for eviction
	U8	dir[HLAI_WORD_MAX];	//the sound/ subdirectory the sentence has reached
};

CHLSentChan	hl_ai_sentch[HLAI_SENT_CHANS];

//scratch directory buffer for a word lookup made outside any channel
U8	hl_ai_sent_dir[HLAI_WORD_MAX];

U0 HLAIInit()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	I64 i;

	hl_ai_sent_count  = 0;
	hl_ai_sent_raw    = NULL;
	hl_ai_sent_dir[0] = 0;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		hl_ai_sentch[i].sent    = -1;
		hl_ai_sentch[i].word    = 0;
		hl_ai_sentch[i].next    = 0.0;
		hl_ai_sentch[i].ent     = -1;
		hl_ai_sentch[i].volume  = 1.0;
		hl_ai_sentch[i].atten   = HLENT_SND_ATTEN;
		hl_ai_sentch[i].pitch   = HLPITCH_NORM;
		hl_ai_sentch[i].claimed = 0.0;
		hl_ai_sentch[i].dir[0]  = 0;

		hl_ai_sentch[i].org[0] = 0.0;
		hl_ai_sentch[i].org[1] = 0.0;
		hl_ai_sentch[i].org[2] = 0.0;
	}
}

//top-level, so the table is sane before anything can reach it
HLAIInit;

Bool HLAIIsSpace(I64 c)
{
	return ToBool(c == ' ' || c == '\t' || c == '\r' || c == '\n');
}

U0 HLAISentencesLoad()
{//parse sound/sentences.txt into the name table
	U8	*d;
	I64	 size = 0;
	I64	 pos  = 0;
	I64	 k;
	I64	 slot;

	HLAIInit;

	//owned copy: the table points into it for the life of the program and the
	//word lists are NUL terminated in place
	d = HLFileLoad("sound/sentences.txt", &size);

	if (!d || size < 8)
	{
		"HLAI: sound/sentences.txt missing - no speech\n";

		if (d)
			Free(d);

		return;
	}

	hl_ai_sent_raw = d;

	while (pos < size && hl_ai_sent_count < HLAI_MAX_SENTENCES)
	{
		while (pos < size && HLAIIsSpace(d[pos]))
			pos++;

		if (pos >= size)
			break;

		//comment to end of line
		if (d[pos] == '/')
		{
			while (pos < size && d[pos] != '\n')
				pos++;

			goto qasl_next;
		}

		slot = hl_ai_sent_count;

		//the name is the first token
		k = 0;
		while (pos < size && !HLAIIsSpace(d[pos]) && k < HLAI_SENT_NAME - 1)
		{
			hl_ai_sent[slot].name[k] = d[pos];
			k++;
			pos++;
		}

		hl_ai_sent[slot].name[k] = 0;

		//an over-long name would otherwise leak into the word list
		while (pos < size && !HLAIIsSpace(d[pos]))
			pos++;

		//skip the gap but not a newline: a name with no words is not a
		//sentence, and the next line is a fresh entry
		while (pos < size && (d[pos] == ' ' || d[pos] == '\t'))
			pos++;

		if (pos >= size || d[pos] == '\n')
			goto qasl_next;

		hl_ai_sent[slot].text = d + pos;

		while (pos < size && d[pos] != '\n')
			pos++;

		if (pos < size)
		{
			d[pos] = 0;
			pos++;
		}

		if (hl_ai_sent[slot].name[0])
			hl_ai_sent_count++;

		goto qasl_done;

qasl_next:
		if (pos < size)
			pos++;

qasl_done:
	}

	"HLAI: %d sentences\n", hl_ai_sent_count;
}

I64 HLAISentenceFind(U8 *name)
{//sentences are referenced as "!NAME" in entity keys and on the wire
	I64 i;

	if (!name)
		return -1;

	if (name[0] == '!')
		name++;

	for (i = 0; i < hl_ai_sent_count; i++)
	{
		if (!StrICompare(hl_ai_sent[i].name, name))
			return i;
	}

	return -1;
}

I64 HLAISentenceWord(I64 idx, I64 want, U8 *out, U8 *dir = NULL)
{//word number `want`, resolved to a sound path. returns 1 on success
 //
 //dir is the caller's HLAI_WORD_MAX directory buffer, carried per channel: the
 //'/' prefix is sticky across the words of one sentence and two sentences run
 //at once. NULL takes the shared scratch, for a one-off lookup
 //
 //(...) modifiers are skipped: they carry pitch and timing, and the mixer has no
 //pitch control. punctuation is stripped, so "grenade!" is the file grenade.wav
	U8	*t;
	U8	 word[HLAI_WORD_MAX];
	I64	 i = 0;
	I64	 k;
	I64	 n = 0;
	I64	 c;

	out[0] = 0;

	if (!dir)
	{
		dir    = hl_ai_sent_dir;
		dir[0] = 0;
	}

	if (idx < 0 || idx >= hl_ai_sent_count)
		return 0;

	t = hl_ai_sent[idx].text;

	if (!t)
		return 0;

	while (t[i])
	{
		while (t[i] && HLAIIsSpace(t[i]))
			i++;

		if (!t[i])
			break;

		k = 0;

		//ZealC has no `continue`; a label at the end of the loop body is the
		//idiom used throughout this tree.
		while (t[i] && !HLAIIsSpace(t[i]))
		{
			c = t[i];

			//(p120 t40) - pitch and timing are not honoured
			if (c == '(')
			{
				while (t[i] && t[i] != ')')
					i++;

				if (t[i])
					i++;

				goto qasw_next_char;
			}

			//a '/' ends the directory prefix, not the word
			if (c == '/')
			{
				word[k] = 0;
				HLRdName(word, dir, HLAI_WORD_MAX);
				k = 0;
				i++;
				goto qasw_next_char;
			}

			//punctuation is delivery, not part of the filename
			if (c == '!' || c == ',' || c == '.' || c == '?' || c == ';')
			{
				i++;
				goto qasw_next_char;
			}

			if (k < HLAI_WORD_MAX - 1)
			{
				word[k] = c;
				k++;
			}

			i++;

qasw_next_char:
		}

		word[k] = 0;

		//a token that was only a directory contributes no word
		if (!k)
			goto qasw_next_token;

		if (n == want)
		{
			if (dir[0])
				StrPrint(out, "%s/%s.wav", dir, word);
			else
				StrPrint(out, "%s.wav", word);

			return 1;
		}

		n++;

qasw_next_token:
	}

	return 0;
}

I64 HLAISentenceChan(I64 ent)
{//the channel this entity speaks on: its own if it already holds one, else a
 //free one, else the one claimed longest ago
	I64	i;
	I64	free_slot = -1;
	I64	oldest    = 0;

	if (ent >= 0)
	{
		for (i = 0; i < HLAI_SENT_CHANS; i++)
		{
			if (hl_ai_sentch[i].sent >= 0 && hl_ai_sentch[i].ent == ent)
				return i;
		}
	}

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent < 0 && free_slot < 0)
			free_slot = i;

		if (hl_ai_sentch[i].claimed < hl_ai_sentch[oldest].claimed)
			oldest = i;
	}

	if (free_slot >= 0)
		return free_slot;

	return oldest;
}

Bool HLAISentenceTalking(I64 ent)
{//is this entity's voice channel still running words
	I64 i;

	if (ent < 0)
		return FALSE;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent >= 0 && hl_ai_sentch[i].ent == ent)
			return TRUE;
	}

	return FALSE;
}

//Every speech path in this file plays on HLCHAN_VOICE, common/const.h's
//CHAN_VOICE of 2, and HLSndVoiceAmplitude reads that channel to drive bone
//controller 4. HLEntity.ZC:157 defines HLENT_CHAN_VOICE as 3, which is
//CHAN_ITEM; HLWeapon.ZC and HLEntity.ZC still use it. Replacement is per
//(entnum, entchannel), so a monster's line still cuts its own previous line.

U0 HLAISentenceStop(I64 ent)
{//SENTENCE_STOP, reached through CBaseMonster::SentenceStop. Drops the word
 //scheduler and cuts the word already in the mixer
	I64 i;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent < 0 || hl_ai_sentch[i].ent != ent)
			goto qass_next;

		hl_ai_sentch[i].sent = -1;

		if (ent >= 0)
			HLSndStop(ent + 1, HLCHAN_VOICE);

qass_next:
	}
}

Bool HLAISentencePlay(U8 *name, I64 ent, F64 *origin, F64 volume, F64 atten,
	I64 pitch = HLPITCH_NORM)
{//CTalkMonster::PlaySentence's dispatch, talkmonster.cpp:1206-1216: a leading
 //! names one sentence, anything else names a group and SENTENCEG_PlayRndSz
 //draws a member from it without repeating until the group is exhausted.
 //
 //The group table and its LRU live in HLSound.ZC (HLSndSentencePick,
 //HLSound.ZC:2841), which is loaded from the same sound/sentences.txt. The pick
 //comes back as "!NAMEn" and resolves in this file's own name table.
	I64	idx;
	I64	grp;
	U8	picked[48];

	if (!name || !name[0])
		return FALSE;

	//a map or a table can reference speech before HL1.ZC has loaded it
	if (!hl_ai_sent_count)
		HLAISentencesLoad;

	if (name[0] == '!')
		idx = HLAISentenceFind(name);
	else
	{
		grp = HLSndSentenceGroupIndex(name);

		if (grp < 0)
			return FALSE;

		picked[0] = 0;

		if (HLSndSentencePick(grp, picked) < 0 || !picked[0])
			return FALSE;

		idx = HLAISentenceFind(picked);
	}

	if (idx < 0)
		return FALSE;

	grp = HLAISentenceChan(ent);

	//taking a live channel means the previous line stops mid-word
	if (hl_ai_sentch[grp].sent >= 0 && hl_ai_sentch[grp].ent >= 0)
		HLSndStop(hl_ai_sentch[grp].ent + 1, HLCHAN_VOICE);

	hl_ai_sentch[grp].sent    = idx;
	hl_ai_sentch[grp].word    = 0;
	hl_ai_sentch[grp].next    = 0.0;
	hl_ai_sentch[grp].ent     = ent;
	hl_ai_sentch[grp].volume  = volume;
	hl_ai_sentch[grp].atten   = atten;
	hl_ai_sentch[grp].pitch   = pitch;
	hl_ai_sentch[grp].claimed = hl_ent_time;
	hl_ai_sentch[grp].dir[0]  = 0;

	if (origin)
		HLVecCopy(origin, hl_ai_sentch[grp].org);
	else
		HLVecSet(hl_ai_sentch[grp].org, 0.0, 0.0, 0.0);

	return TRUE;
}

U0 HLAISentenceChanTick(I64 c, F64 now)
{//advance one channel to its next word once the previous one has had its time
 //
 //the duration comes from the decoded sample rather than a fixed step, so a
 //long word is not cut off and a short one leaves no gap
	CHLEntity	*e;
	CHLSound	*snd;
	U8			 path[96];
	F64			 dur;
	I64			 entnum;

	if (hl_ai_sentch[c].sent < 0)
		return;

	//the voice follows its speaker: a character walking while talking is heard
	//where they are, not where they started
	if (hl_ai_sentch[c].ent >= 0)
	{
		e = HLEntGet(hl_ai_sentch[c].ent);

		if (e)
			HLVecCopy(e->origin, hl_ai_sentch[c].org);
	}

	if (now < hl_ai_sentch[c].next)
		return;

	if (!HLAISentenceWord(hl_ai_sentch[c].sent, hl_ai_sentch[c].word, path,
		hl_ai_sentch[c].dir))
	{
		hl_ai_sentch[c].sent = -1;
		return;
	}

	snd = HLSndLoad(path);

	entnum = 0;

	if (hl_ai_sentch[c].ent >= 0)
		entnum = hl_ai_sentch[c].ent + 1;

	if (snd && snd->rate > 0)
	{
		HLSndPlayAt(path, hl_ai_sentch[c].org, hl_ai_sentch[c].volume,
			hl_ai_sentch[c].atten, entnum, HLCHAN_VOICE,
			hl_ai_sentch[c].pitch);

		dur = ToF64(snd->count) / ToF64(snd->rate);

		//pitch is a percentage of the recorded rate, so it shortens the word
		if (hl_ai_sentch[c].pitch > 0)
			dur = dur * 100.0 / ToF64(hl_ai_sentch[c].pitch);
	}
	else
	{
		//a missing word must not stall the rest of the sentence
		dur = 0.05;
	}

	//HL leaves a small gap between words; without it a sentence slurs
	hl_ai_sentch[c].next = now + dur + 0.03;
	hl_ai_sentch[c].word++;
}

U0 HLAISentenceUpdate(F64 now)
{//every live channel, plus the requests HLSound.ZC parked
 //
 //HLSndEmitDyn, the speaker and anything else that hands a "!NAME" to the mixer
 //queue their request there (HLSound.ZC:2941) because the word scheduler
 //compiles later. Draining it here is what makes those requests audible.
	CHLSentReq	req;
	I64			 ent;
	I64			 i;

	while (HLSndSentenceNext(&req))
	{
		//HLSndPlayAt's entnum convention is entity index + 1, 0 for the world
		ent = -1;

		if (req.entnum > 0)
			ent = req.entnum - 1;

		HLAISentencePlay(req.name, ent, req.origin, req.volume,
			req.attenuation, req.pitch);
	}

	for (i = 0; i < HLAI_SENT_CHANS; i++)
		HLAISentenceChanTick(i, now);
}

//--- animation --------------------------------------------------------------

U0 HLAISetSequence(CHLEntity *e, U8 *label, Bool loop)
{//point an entity at a named sequence and restart its cycle
	I64 seq;

	if (!e || !e->studio || !label || !label[0])
		return;

	seq = HLStudioSeqByName(e->studio, label);

	//maps routinely name sequences their model does not carry; leaving the
	//previous one running beats falling back to sequence 0
	if (seq < 0)
		return;

	e->seq        = seq;
	e->anim_start = hl_ent_time;
	e->anim_done  = FALSE;

	//A new sequence has its own event list; the old frame index means nothing.
	e->anim_event_frame = -1;

	//the sequence's own STUDIO_LOOPING flag overrides the caller
	e->anim_loop = ToBool(loop || HLStudioSeqLoops(e->studio, seq));
}

U0 HLAIFireEvent(CHLEntity *e, I64 self, CHLStEvent *ev)
{//One mstudioevent_t on an entity that is not a tracked monster - a prop or a
 //scripted actor with no AI slot. Only the shared script events apply: a
 //monster goes through HLAIMonAnimEvent instead, which handles the whole set.
	if (!ev->options[0])
		return;

	//A real entnum, unlike the rest of the entity sound paths: a room of grunts
	//all firing voice lines on entnum 0 would cut each other down to one.
	if (ev->code == HLST_EV_SOUND)
	{
		HLSndPlayAt(ev->options, e->origin, 1.0, HLENT_SND_ATTEN, self + 1,
			HLENT_CHAN_BODY);
		return;
	}

	if (ev->code == HLST_EV_SOUND_VOICE)
	{
		HLSndPlayAt(ev->options, e->origin, 1.0, HLENT_SND_ATTEN, self + 1,
			HLCHAN_VOICE);
		return;
	}

	//on the entity's own voice channel, so two props speaking do not collide
	if (ev->code == HLST_EV_SENTENCE || ev->code == HLST_EV_SENTENCE_RND1)
		HLAISentencePlay(ev->options, self, e->origin, 1.0, HLENT_SND_ATTEN);
}

U0 HLAIEntityEvents(CHLEntity *e, I64 self, F64 cycle)
{//Fire the events the sequence has passed since the last tick.
 //
 //StudioFrameAdvance keeps the last frame reached and dispatches everything in
 //(last, now]. Sampling the current frame alone drops any event the tick
 //stepped over, which at 72Hz over a 30fps sequence is most of them.
	CHLStudio	*m;
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 frame_f;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!e || !e->studio)
		return;

	m = e->studio;

	if (e->seq < 0 || e->seq >= m->num_seqs || !m->events)
		return;

	sq = &m->seqs[e->seq];

	if (sq->num_events < 1)
		return;

	frame_f = cycle * ToF64(sq->num_frames - 1);
	frame   = ToI64(frame_f);

	if (frame < 0)
		frame = 0;
	if (frame > sq->num_frames - 1)
		frame = sq->num_frames - 1;

	last = e->anim_event_frame;

	//A loop that wrapped, or a sequence that was just started, replays the
	//whole list from the beginning rather than skipping to the new position.
	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &m->events[sq->first_event + i];

		if (ev->frame > last && ev->frame <= frame)
			HLAIFireEvent(e, self, ev);
	}

	e->anim_event_frame = frame;
}

F64 HLAIEntityCycle(CHLEntity *e)
{//0..1 through the entity's current sequence
 //
 //derived from anim_start rather than the wall clock, so a scripted one-shot
 //holds its last frame instead of looping
	F64 dur;
	F64 t;

	if (!e || !e->studio)
		return 0.0;

	if (e->seq < 0 || e->seq >= e->studio->num_seqs)
		return 0.0;

	dur = HLStudioSeqDuration(e->studio, e->seq);

	if (dur <= 0.0)
		return 0.0;

	t = hl_ent_time - e->anim_start;

	if (t < 0.0)
		t = 0.0;

	if (!e->anim_loop && t >= dur)
		return 1.0;

	t = t / dur;

	return t - Floor(t);
}

//--- scripted_sequence ------------------------------------------------------
//
// dlls/scripted.cpp. A scripted_sequence names an actor, a mark to stand on,
// an idle take to hold until the cue and a play take to run on the cue. The
// driver itself is at the foot of this file: it walks the actor to the mark
// through the monster mover, which is defined a few thousand lines below here
// and ZealC is single-pass. Only the constants and the by-name lookup the
// sentence player also needs live at this point.

//SF_SCRIPT_*, scripted.h:22
#define HLAI_SF_WAITTILLSEEN		1
#define HLAI_SF_EXITAGITATED		2
#define HLAI_SF_REPEATABLE			4
#define HLAI_SF_LEAVECORPSE			8
#define HLAI_SF_NOINTERRUPT			32
#define HLAI_SF_OVERRIDESTATE		64
#define HLAI_SF_NOSCRIPTMOVEMENT	128

//m_fMoveTo
#define HLAI_MOVE_NONE			0
#define HLAI_MOVE_WALK			1
#define HLAI_MOVE_RUN			2
#define HLAI_MOVE_INSTANT		4
#define HLAI_MOVE_TURN			5

//SCRIPTSTATE, basemonster.h:30. m_scriptState of the possessed actor.
#define HLSS_PLAYING			0
#define HLSS_WAIT				1
#define HLSS_CLEANUP			2
#define HLSS_WALK_TO_MARK		3
#define HLSS_RUN_TO_MARK		4

//SS_INTERRUPT, scripted.h:33. How far up the state ladder a script may reach
//for its actor: by targetname reaches ALERT, by classname only IDLE.
#define HLSS_INT_IDLE			0
#define HLSS_INT_BY_NAME		1
#define HLSS_INT_AI				2

//m_startTime parked. CCineMonster::Spawn puts a named script 1e6 seconds out
//so TASK_WAIT_FOR_SCRIPT holds until a trigger or DelayStart brings it back.
#define HLAI_CINE_NEVER			1.0e6

//CineThink's retry interval when no actor was free, seconds. scripted.cpp:487
#define HLAI_CINE_RETRY			1.0

//--- combat AI --------------------------------------------------------------
//
// Ported from the SDK's dlls/: monsterstate.cpp (the state machine),
// schedule.cpp and defaultai.cpp (schedules, tasks, StartTask/RunTask/
// TaskComplete/TaskFail), monsters.cpp (Look, FInViewCone, FVisible, and the
// CLASS_*/IRelationship matrix), plus the Spawn() and SelectSchedule() bodies
// of headcrab.cpp, zombie.cpp, scientist.cpp, barney.cpp, houndeye.cpp,
// hgrunt.cpp, islave.cpp and bullsquid.cpp for the numbers.
//
// Implemented:
//
//   - the five MONSTERSTATE_ values and the transitions between them
//   - a task/schedule interpreter. A schedule is a list of (task, data); each
//     task is Start-ed once and Run every tick until it completes or fails,
//     and a failed task abandons the whole schedule, as TaskFail does.
//   - Look(): view cone from m_flFieldOfView, a point trace for FVisible, and
//     the relationship matrix - barney shoots aliens and ignores the player, a
//     scientist runs from a zombie.
//   - melee and ranged attacks gated on range, view cone, sight and refire
//   - HandleAnimEvent, per monster: every attack lands on the mstudioevent_t
//     the animator marked, so a zombie's swing connects on frame 10 of 36 and
//     the follow-through can be walked out of, and the foley - body drops,
//     claw swishes, burst fire, reloads - plays where the SDK plays it
//   - squads (squadmonster.cpp): slots, OccupySlot/VacateSlot, SquadRecruit,
//     SquadMakeEnemy, NoFriendlyFire and cover spacing, so a fireteam of
//     grunts puts two men up and the rest in cover
//   - hearing (soundent.cpp): a world sound list, the player's own footstep
//     and weapon entry, and the investigate and take-cover-from-sound
//     schedules that act on it
//   - death: the die sequence plays and holds on its last frame, or the body
//     gibs below -40 health
//
// Not implemented, and the consequence of each:
//
//   - No node graph. HL routes every monster move through the map's info_node
//     network (nodes.cpp, CGraph::FindShortestPath) built by a separate
//     compile step; this tree has neither the graph nor the .nod files.
//     Movement here is straight at the goal with one wall-slide retry and a
//     floor probe that refuses a step off a ledge. A monster will not go round
//     a corner: it grinds along the wall between it and its enemy until the
//     enemy steps into the open. The slide is not routing.
//
//   - No FL_MONSTERCLIP. SOLID_SLIDEBOX entities clip each other and the
//     player through HLEntClipToSlideboxes, but func_monsterclip brushes are
//     ordinary walls here: a monster is stopped by the same geometry the
//     player is, and the invisible fences a mapper drew to keep it out of a
//     corridor do nothing.
//
//   - No projectiles. The bullsquid's spit, the islave's hornet swarm, the
//     agrunt's hornets, the controller's energy ball and every grenade are
//     entities the SDK creates at an animation event and integrates; there is
//     no runtime entity allocation here. Each is fired as a hitscan on the
//     same event instead, at the same per-round damage, so the shot lands
//     instantly rather than travelling.
//
//   - No scent (bits_COND_SMELL, bits_COND_SMELL_FOOD). Sound sensing is
//     implemented; the scent half of the same list is not, so a bullsquid
//     hears a corpse drop but does not track one it never heard.
//
//   - No hitgroup-specific flinches, no headcrab leap (LeapTouch needs a
//     monster mover with velocity, which does not exist here - the crab walks
//     up and bites on the leap event), no grenades, no item drops, no node
//     cover (lateral cover only), no scripted death poses.
//
//   - The player cannot hurt a monster. HLWeapon.ZC's hitscan has no monster
//     damage path, so the death path below is reachable only through
//     HLEntTakeDamage from a trigger_hurt, a func_breakable chain, or another
//     monster.
//
// State lives in the parallel table below, indexed by slot, with
// hl_ai_mon_of[] mapping an entity index to its slot: HLEnt.ZC is not editable
// from here, so anything the shared CHLEntity does not carry lives here.
//
// The death path is shared with func_breakable. HLEntTakeDamage queues
// HLM_BREAK_DIE at zero health and HLBreakableDie clears in_use - correct for
// glass, wrong for a monster, which has to stay in the world and fall over.
// That call is in HLEntity.ZC and unreachable from here, so HLAIMonSync
// notices a monster whose slot went away and puts the corpse back, non-solid
// and immune, to play its die sequence. hl_ai_mon_revive disables that.

#define HLAI_MON_MAX			192

//MONSTERSTATE_*, monsterstate.cpp
#define HLMSTATE_NONE			0
#define HLMSTATE_IDLE			1
#define HLMSTATE_ALERT			2
#define HLMSTATE_COMBAT			3
#define HLMSTATE_SCRIPT			4
#define HLMSTATE_DEAD			5

//CLASS_*, monsters.h. The values are HL's, with the gaps left in so a class
//added later lands on the same number the SDK uses.
#define HLCLASS_NONE			0
#define HLCLASS_MACHINE			1
#define HLCLASS_PLAYER			2
#define HLCLASS_HUMAN_PASSIVE	3
#define HLCLASS_HUMAN_MILITARY	4
#define HLCLASS_ALIEN_MILITARY	5
#define HLCLASS_ALIEN_MONSTER	6
#define HLCLASS_ALIEN_PREY		7
#define HLCLASS_ALIEN_PREDATOR	8
#define HLCLASS_PLAYER_ALLY		10

//R_*, monsters.h
#define HLREL_ALLY				-2
#define HLREL_FEAR				-1
#define HLREL_NONE				0
#define HLREL_DISLIKE			1
#define HLREL_HATE				2

//which sequence a task wants. Activity in the SDK, an index here: ACT_ lookup
//by activity number picks the wrong take on half the models (houndeye has three
//sequences labelled "run" at ACT_RUN), and scripted_sequence already resolves
//by label. The table names the sequence; this indexes a slot in it.
#define HLACT_IDLE				0
#define HLACT_WALK				1
#define HLACT_RUN				2
#define HLACT_MELEE				3	//ACT_MELEE_ATTACK1
#define HLACT_RANGE				4	//ACT_RANGE_ATTACK1
#define HLACT_DIE				5
#define HLACT_FLINCH			6	//ACT_SMALL_FLINCH
#define HLACT_MELEE2			7	//ACT_MELEE_ATTACK2
#define HLACT_RANGE2			8	//ACT_RANGE_ATTACK2
#define HLACT_RELOAD			9	//ACT_RELOAD
#define HLACT_COMBAT_IDLE		10	//ACT_COMBAT_IDLE
#define HLACT_SIGNAL			11	//ACT_SIGNAL1, the grunt's advance wave
#define HLACT_THREAT			12	//ACT_THREAT_DISPLAY
#define HLACT_VICTORY			13	//ACT_VICTORY_DANCE
#define HLACT_COWER				14	//ACT_COWER
#define HLACT_ARM				15	//ACT_ARM
#define HLACT_EAT				16	//ACT_EAT
#define HLACT_SPECIAL			17	//ACT_SPECIAL_ATTACK1
#define HLACT_BARN_HIT			18	//ACT_BARNACLE_HIT
#define HLACT_BARN_PULL			19	//ACT_BARNACLE_PULL
#define HLACT_BARN_CHOMP		20	//ACT_BARNACLE_CHOMP
#define HLACT_BARN_CHEW			21	//ACT_BARNACLE_CHEW
#define HLACT_COUNT				22

//TASK_*, schedule.h. Contiguous from zero: the dispatcher is a switch and a
//sparse set would build a jump table with holes in it.
#define HLTASK_WAIT				0
#define HLTASK_WAIT_RANDOM		1
#define HLTASK_WAIT_FOR_ANIM	2
#define HLTASK_SET_ACTIVITY		3
#define HLTASK_STOP_MOVING		4
#define HLTASK_FACE_ENEMY		5
#define HLTASK_FACE_GOAL		6
#define HLTASK_PATH_TO_ENEMY	7
#define HLTASK_PATH_AWAY		8
#define HLTASK_WALK_PATH		9
#define HLTASK_RUN_PATH			10
#define HLTASK_MELEE_ATTACK1	11
#define HLTASK_RANGE_ATTACK1	12
#define HLTASK_SOUND_ATTACK		13
#define HLTASK_SOUND_ALERT		14
#define HLTASK_SOUND_DIE		15
#define HLTASK_DIE				16

//TASK_WAIT_INDEFINITE. Only a trigger or a condition leaves it
#define HLTASK_WAIT_INDEF		17

//TASK_WAIT_FACE_ENEMY: wait data seconds, turning to the enemy throughout
#define HLTASK_WAIT_FACE_ENEMY	18

//TASK_FACE_IDEAL: turn to ideal_yaw, which another task set
#define HLTASK_FACE_IDEAL		19

//TASK_SMALL_FLINCH: play the flinch take and note the time, so
//CBaseMonster::Killed's flinch throttle has something to compare against
#define HLTASK_SMALL_FLINCH		20

//TASK_FIND_COVER_FROM_ENEMY / _BEST_SOUND / _FROM_ORIGIN. The SDK asks
//CGraph for a node the threat cannot see; these three sample lateral points
//instead - FindLateralCover is the SDK's own first choice and needs no graph
#define HLTASK_FIND_COVER_ENEMY	21
#define HLTASK_FIND_COVER_SOUND	22
#define HLTASK_FIND_COVER_ORG	23

//TASK_GET_PATH_TO_BESTSOUND
#define HLTASK_PATH_TO_SOUND	24

//TASK_STORE_LASTPOSITION / _GET_PATH_TO_ / _CLEAR_, which is how
//slInvestigateSound sends a monster to a noise and back to its post
#define HLTASK_STORE_LASTPOS	25
#define HLTASK_PATH_TO_LASTPOS	26
#define HLTASK_CLEAR_LASTPOS	27

//TASK_RELOAD: refill m_cAmmoLoaded over the reload take
#define HLTASK_RELOAD			28

//the second attack of each kind, and TASK_SPECIAL_ATTACK1
#define HLTASK_MELEE_ATTACK2	29
#define HLTASK_RANGE_ATTACK2	30
#define HLTASK_SPECIAL_ATTACK1	31

//TASK_SOUND_IDLE / _PAIN / _WAKE
#define HLTASK_SOUND_IDLE		32
#define HLTASK_SOUND_PAIN		33
#define HLTASK_SOUND_WAKE		34

//TASK_TURN_LEFT / _RIGHT, data in degrees
#define HLTASK_TURN_LEFT		35
#define HLTASK_TURN_RIGHT		36

//TASK_SET_SCHEDULE, data is the HLSCHED_ to jump to
#define HLTASK_SET_SCHEDULE		37

//TASK_PLAY_SEQUENCE: set the activity and wait for the take to finish, which
//TASK_SET_ACTIVITY does not do
#define HLTASK_PLAY_SEQUENCE	38

//TASK_EAT: ignore food for data seconds. No scent system, so it is the wait
#define HLTASK_EAT				39

//TASK_SUGGEST_STATE, data is the HLMSTATE_ to move to
#define HLTASK_SUGGEST_STATE	40

//no SDK task. Occupies one of the squad slots in data, failing when they are
//all taken - the SDK does this inside each GetSchedule instead, which needs a
//per-monster GetSchedule this port replaces with a table
#define HLTASK_OCCUPY_SLOT		41

//TASK_FACE_TARGET and TASK_MOVE_TO_TARGET_RANGE, AI_BaseNPC_Schedule.cpp:828
//and :879. The target is m_hTargetEnt, the follow leader, not m_hEnemy.
//data on the move task is the stand-off distance in world units.
#define HLTASK_FACE_TARGET		42
#define HLTASK_MOVE_TO_TARGET	43

#define HLTASK_COUNT			44

//TASKSTATUS_*, but only the three states that matter without interrupts
#define HLTK_RUNNING			0
#define HLTK_DONE				1
#define HLTK_FAILED				2

//SCHED_*, defaultai.cpp. The subset a monster with no squad, no cover and no
//node graph can run.
#define HLSCHED_NONE			0
#define HLSCHED_IDLE_STAND		1
#define HLSCHED_ALERT_STAND		2
#define HLSCHED_ALERT_FACE		3
#define HLSCHED_WAKE_ANGRY		4
#define HLSCHED_CHASE_ENEMY		5
#define HLSCHED_MELEE_ATTACK1	6
#define HLSCHED_RANGE_ATTACK1	7
#define HLSCHED_TAKE_COVER		8	//slTakeCoverFromEnemy
#define HLSCHED_SMALL_FLINCH	9
#define HLSCHED_DIE				10
#define HLSCHED_IDLE_WALK		11
#define HLSCHED_ALERT_SM_FLINCH	12	//slAlertSmallFlinch
#define HLSCHED_INVEST_SOUND	13	//slInvestigateSound
#define HLSCHED_COMBAT_FACE		14
#define HLSCHED_COMBAT_STAND	15
#define HLSCHED_CHASE_FAILED	16	//slChaseEnemyFailed
#define HLSCHED_STANDOFF		17
#define HLSCHED_RELOAD			18
#define HLSCHED_ARM_WEAPON		19
#define HLSCHED_MELEE_ATTACK2	20
#define HLSCHED_RANGE_ATTACK2	21
#define HLSCHED_SPECIAL_ATTACK1	22
#define HLSCHED_COVER_SOUND		23	//slTakeCoverFromBestSound
#define HLSCHED_COVER_ORIGIN	24	//slTakeCoverFromOrigin
#define HLSCHED_COWER			25
#define HLSCHED_VICTORY_DANCE	26
#define HLSCHED_AMBUSH			27
#define HLSCHED_BARNACLE_GRAB	28	//slBarnacleVictimGrab
#define HLSCHED_BARNACLE_CHOMP	29	//slBarnacleVictimChomp
#define HLSCHED_FAIL			30

//the follow loop. slFaceTarget (scientist.cpp:236-240) jumps to slFollow
//(scientist.cpp:132-137), which walks to within 128 units and ends; the
//selector then hands back FACE, so the pair cycles for as long as the
//follower has a leader.
#define HLSCHED_TARGET_FACE		31
#define HLSCHED_TARGET_CHASE	32

#define HLSCHED_COUNT			33

//slInvestigateSound is twelve tasks long, the longest in defaultai.cpp that
//this port reproduces
#define HLAI_SCHED_TASKS		14

//--- squad slots, squadmonster.h --------------------------------------------
//
// A squad's leader holds the occupied set; a member takes a bit before it may
// run the behaviour that bit guards, so only two of a fireteam shoot at once
// and the rest take cover or hold. The values are the SDK's bit positions.

#define HLSLOT_NONE				0

#define HLSLOT_HGRUNT_ENGAGE1	1		//1 << 0
#define HLSLOT_HGRUNT_ENGAGE2	2		//1 << 1
#define HLSLOTS_HGRUNT_ENGAGE	3

#define HLSLOT_HGRUNT_GRENADE1	4		//1 << 2
#define HLSLOT_HGRUNT_GRENADE2	8		//1 << 3
#define HLSLOTS_HGRUNT_GRENADE	12

#define HLSLOT_AGRUNT_HORNET1	16		//1 << 4
#define HLSLOT_AGRUNT_HORNET2	32		//1 << 5
#define HLSLOTS_AGRUNT_HORNET	48
#define HLSLOT_AGRUNT_CHASE		64		//1 << 6

#define HLSLOT_HOUND_ATTACK1	128		//1 << 7
#define HLSLOT_HOUND_ATTACK2	256		//1 << 8
#define HLSLOT_HOUND_ATTACK3	512		//1 << 9
#define HLSLOTS_HOUND_ATTACK	896

//1 << 10. Set on a member when the squad is not all fighting one enemy, which
//disables slots so nobody is stranded waiting for a bit held against another
//target
#define HLSLOT_SQUAD_SPLIT		1024

#define HLAI_NUM_SLOTS			11
#define HLAI_SQUAD_MAX			5		//MAX_SQUAD_MEMBERS
#define HLAI_SQUAD_RADIUS		1024.0	//StartMonster's SquadRecruit call

//--- the world sound list, soundent.h ---------------------------------------

#define HLSOUND_NONE			0
#define HLSOUND_COMBAT			1		//gunshots, explosions
#define HLSOUND_WORLD			2		//a door, breaking glass
#define HLSOUND_PLAYER			4		//the player walking, shooting, falling
#define HLSOUND_CARCASS			8
#define HLSOUND_MEAT			16
#define HLSOUND_DANGER			32		//a live grenade
#define HLSOUND_GARBAGE			64
#define HLSOUND_ALL				127

#define HLAI_WORLD_SOUNDS		64		//MAX_WORLD_SOUNDS

//within this many degrees counts as facing. The SDK's FacingIdeal is 0.06
//radians off pev->ideal_yaw, tighter than a monster turning at yaw_speed can
//hold, so tasks waiting on it never finish.
#define HLAI_FACE_TOL			12.0

//eye height of the player above hl_origin. HLVIEW_HEIGHT in HL1.ZC, repeated
//here because that file compiles later. Bob and step offset ride on top, worth
//a couple of units, immaterial at sighting range.
#define HLAI_PLAYER_EYE			22.0

//how far a monster steps up or down in one move, and how far it probes for a
//floor. 18 is HL's step height.
#define HLAI_STEP_HEIGHT		18.0

//a path task gives up after this long, or after this long making no progress
#define HLAI_PATH_TIMEOUT		20.0
#define HLAI_STUCK_TIME			0.8

//COMBAT falls back to ALERT once the enemy has been out of sight this long -
//CBaseMonster::CheckEnemy's MONSTER_LOST_ENEMY window
#define HLAI_LOSE_ENEMY			8.0

//idle chatter interval, seconds. The range is an integer because HLPartRandI
//takes one
#define HLAI_IDLE_SND_MIN		8.0
#define HLAI_IDLE_SND_RANGE		12

//how often Look() runs, seconds. The SDK's MonsterThink is 0.1 and Look is part
//of it; here the think runs per tick because it also drives movement, so
//sensing is throttled separately. Look traces against every candidate, and at
//tick rate a room of monsters spends the frame in HLTraceEntity.
#define HLAI_LOOK_PERIOD		0.2

//--- the monster table ------------------------------------------------------
//
// One row per monster, the same shape as CHLWeaponInfo in HLWeapon.ZC and for
// the same reason: the SDK gives each monster a C++ class, but the ones in
// scope differ only in numbers, hull, sequence labels and sounds. A monster
// needing its own code - the barnacle (no movement), the tentacle
// (sound-driven), the gargantua (stomp), anything with a projectile - is
// absent rather than approximated.
//
// Sequence labels are read out of the shipped models in valve/models and
// resolved through HLStudioSeqByName, never by index: no two of these models
// agree on order. Per-model facts that forced a choice:
//
//   headcrab.mdl has no "die"; the death is "dieback". Its attack sequence
//   "jump" is the leap, used here as the bite, the leap being unimplemented.
//   zombie.mdl has no run sequence, only "walk", so a zombie's run slot is
//   "walk" - which is why a zombie in HL never sprints.
//   houndeye.mdl carries three sequences called "run"; by-label lookup takes
//   the first, which is the SDK's own weighting favourite.
//   bullsquid.mdl's idle is "idle", not "idle1", and its death is "die".

#define HLMON_HEADCRAB			0
#define HLMON_ZOMBIE			1
#define HLMON_SCIENTIST			2
#define HLMON_BARNEY			3
#define HLMON_HOUNDEYE			4
#define HLMON_HGRUNT			5
#define HLMON_ISLAVE			6
#define HLMON_BULLSQUID			7
#define HLMON_AGRUNT			8
#define HLMON_CONTROLLER		9
#define HLMON_COUNT				10

class CHLMonInfo
{
	U8	classname[32];		//monster_* entity classname
	I64	classify;			//HLCLASS_*, Classify() in the SDK

	F64	health;				//gSkillData at skill 1, from valve/skill.cfg
	F64	mins[3];			//UTIL_SetSize in Spawn()
	F64	maxs[3];
	F64	view_ofs;			//pev->view_ofs z, the eye the traces run from

	F64	fov;				//m_flFieldOfView, the COSINE of the half angle
	F64	look_dist;			//m_flDistLook
	F64	walk_speed;			//world units per second
	F64	run_speed;
	F64	yaw_speed;			//degrees per second

	//melee: reach and damage. melee_range 0 means it has no melee attack
	F64	melee_range;
	F64	melee_dmg;

	//ranged: hitscan unless blast_radius is set, in which case the attack
	//damages everything inside that radius of the MONSTER (houndeye sonic)
	F64	range_min;
	F64	range_max;			//0 means it has no ranged attack
	F64	range_dmg;
	I64	range_bullets;
	F64	blast_radius;

	F64	attack_rate;		//seconds between attacks, either kind

	//no attack of any kind. HL's CScientist flees anything it dislikes; here
	//that is anything the relationship matrix makes fear or hate, since a
	//monster with no attack cannot act on hate.
	Bool flees;

	//CheckMeleeAttack2: the heavier of two melee takes. 0 means there is only
	//one. The zombie's both_slash and the bullsquid's tailwhip land here.
	F64	melee2_range;
	F64	melee2_dmg;

	//bits_CAP_SQUAD, set in Spawn(). Only these form squads
	Bool squads;

	//MOVETYPE_FLY. A flier holds the height it spawned at instead of being
	//dropped to the floor every step
	Bool flies;

	//m_bloodColor, HLBLOOD_* in HLPart.ZC. Decides the colour of the spray an
	//anim event throws when a claw connects
	I64	blood;

	//m_cClipSize. 0 never reloads, which is every monster but the grunt
	I64	clip_size;

	//HearingSensitivity() and ISoundMask(), monsters.cpp. The mask is which
	//CSound types this monster reacts to at all
	F64	hear_sens;
	I64	sound_mask;

	//the squad slots this monster must hold to run its ranged attack, from the
	//OccupySlot call in its GetSchedule. 0 means the attack is never gated
	I64	slot_attack;

	//how far the attack itself puts a bits_SOUND_COMBAT in the world sound
	//list. hgrunt.cpp's HGRUNT_AE_BURST1 inserts one at 384 units for 0.3s
	F64	attack_noise;

	//sequence labels, one 24-byte cell per HLACT_*. Flat rather than
	//[HLACT_COUNT][24] so the pointer handed to HLStudioSeqByName is a U8*.
	U8	seq[HLACT_COUNT * 24];

	//sound paths under sound/. empty is silence, not a missing file.
	U8	snd_idle[48];
	U8	snd_alert[48];
	U8	snd_attack[48];
	U8	snd_die[48];
};

CHLMonInfo	hl_ai_mon_info[HLMON_COUNT];

//--- per-monster state ------------------------------------------------------

class CHLMonState
{
	I64		ent;			//entity index, -1 for a free slot
	I64		kind;			//HLMON_*
	I64		state;			//HLMSTATE_*

	I64		sched;			//HLSCHED_*
	I64		task;			//index into that schedule's task list
	I64		task_status;	//HLTK_*
	F64		task_start;		//hl_ent_time when the task was Start-ed
	Bool	sched_done;		//ran off the end of the list

	//enemy. -1 is the player, so a separate flag says whether there is one at
	//all rather than overloading the index as m_hEnemy's NULL does
	Bool	have_enemy;
	I64		enemy;
	F64		enemy_pos[3];	//last known position, not the live one
	F64		enemy_seen;		//hl_ent_time of the last clear sight line

	//movement goal
	Bool	have_goal;
	Bool	goal_is_enemy;	//refresh it from the enemy every tick
	F64		goal[3];
	F64	 	goal_tol;
	F64		move_speed;
	F64		path_start;
	F64		stuck_since;

	//FTriangulate's apex, monsters.cpp:1901-1903. m_Route holds ROUTE_SIZE
	//waypoints and InsertWaypoint pushes the apex in front of the goal; with no
	//node graph the route is never longer than one detour plus the goal, so it
	//is one slot rather than an array.
	Bool	have_detour;
	F64		detour[3];

	//next CheckLocalMove lookahead, on CBaseMonster::MonsterThink's own 0.1s
	//cadence. The lookahead walks 200 units in 16-unit hops and each hop is
	//three hull sweeps; the server tick is faster than the SDK's think
	F64		next_move_check;

	F64		ideal_yaw;
	F64		next_attack;
	F64		next_idle_snd;
	F64		next_look;		//Look() is throttled - see HLAI_LOOK_PERIOD
	F64		last_health;	//to notice damage without a hook in HLEntTakeDamage
	Bool	scripted;		//a scripted_sequence owns it this tick

	//DROP_TO_FLOOR, on the first think rather than at registration: the trace
	//it needs is defined further down and ZealC is single-pass
	Bool	settled;

	//--- squad, squadmonster.cpp ---
	//
	//m_hSquadLeader as a slot index. A leader points at itself, -1 is no
	//squad. The leader owns squad_slots for the whole squad; my_slot is the
	//one bit this member holds out of it.
	I64		squad;
	I64		squad_slots;	//m_afSquadSlots, meaningful on the leader only
	I64		my_slot;		//m_iMySlot
	Bool	squad_tried;	//StartMonster has run its one SquadRecruit

	//TASK_STORE_LASTPOSITION's m_vecLastPosition, which is how a monster that
	//walked off to a noise finds its post again
	Bool	have_lastpos;
	F64		lastpos[3];

	//m_cAmmoLoaded, and the pain sound throttle CBaseMonster::TakeDamage keeps
	I64		ammo;
	F64		next_pain_snd;

	//the world sound this monster last heard, and where it was. The index
	//alone is not enough: the entry expires while the monster is still
	//walking to it
	I64		heard;
	F64		heard_pos[3];
	I64		heard_type;

	//current HLACT_, for ReportAIState. m_Activity in the SDK
	I64		activity;

	//the sequence index `activity` last resolved to, -1 for none. Anything that
	//moves the entity off it - a scripted_sequence taking the actor, a death
	//take - breaks the "already playing it" gate in HLAISetActivity, so the
	//activity is resolved again instead of being left on the foreign sequence
	I64		act_seq;

	//next CBaseMonster::RunAI, for the eye blink only. RunAI is on a 0.1s think
	//and the blink counts down in think steps, so running it on the server tick
	//makes the blink six frames long and ten times as frequent
	F64		next_blink;

	//m_fGunDrawn, barney's holster bodygroup. The draw take runs once, on the
	//first transition out of idle
	Bool	gun_drawn;

	//bits_MEMORY_INCOVER, and the schedule to run when the current one fails.
	//TASK_SET_FAIL_SCHEDULE's m_failSchedule
	Bool	in_cover;
	I64		fail_sched;
};

CHLMonState	hl_ai_mon[HLAI_MON_MAX];
I64			hl_ai_mon_count = 0;

//entity index -> slot, -1 for an untracked entity
I64			hl_ai_mon_of[HLENT_MAX];

//what the registration pass last ran against. A new map reuses the same slots,
//so all three are compared: the block can be reallocated at the same address,
//and hl_ent_time restarting at zero is the only always-true signal.
CHLEntity	*hl_ai_mon_base  = NULL;
I64			hl_ai_mon_ents   = 0;
F64			hl_ai_mon_clock  = 0.0;

Bool		hl_ai_mon_revive = TRUE;
I64			hl_ai_mon_kills  = 0;

//CBaseEntity::FireBullets' `static int tracerCount`, combat.cpp:1374. One
//counter for every monster in the world, as the SDK's is
I64			hl_ai_tracer_count = 0;

//--- scripted_sequence state ------------------------------------------------
//
// The CCineMonster fields the shared CHLEntity does not carry, one row per
// entity index. A scripted_sequence uses its own row; an entity being acted on
// uses owner only. Indexed by entity rather than by a script slot so
// CanPlaySequence can ask "is this one already taken" in one load.

class CHLCineState
{
	F64	start;		//m_startTime, absolute game time
	F64	retry;		//next CineThink. 0 is unspawned, negative is no think
	I64	delay;		//m_iDelay, actors of this group still walking to a mark
	I64	state;		//m_scriptState of the actor this script holds
	I64	movetype;	//m_saved_movetype
	I64	solid;		//m_saved_solid
	I64	actor;		//m_hTargetEnt as an entity index, -1 for none
	I64	owner;		//m_pCine of THIS entity as a script index, -1 for none
};

CHLCineState	hl_ai_cine[HLENT_MAX];

U0 HLAICineResetRow(I64 i)
{//globals are not zeroed and the whole table is walked every tick
	hl_ai_cine[i].start    = HLAI_CINE_NEVER;
	hl_ai_cine[i].retry    = 0.0;
	hl_ai_cine[i].delay    = 0;
	hl_ai_cine[i].state    = HLSS_WAIT;
	hl_ai_cine[i].movetype = HLMOVETYPE_STEP;
	hl_ai_cine[i].solid    = HLSOLID_SLIDEBOX;
	hl_ai_cine[i].actor    = -1;
	hl_ai_cine[i].owner    = -1;
}

//--- talk monster state -----------------------------------------------------
//
// dlls/talkmonster.cpp. CTalkMonster is what separates a scientist from a
// headcrab: it greets the player, holds conversations with its own kind, turns
// its head at whoever is speaking, and follows on +use. The fields live one row
// per entity index for the reason CHLCineState does - CHLEntity belongs to
// HLEntity.ZC.
//
// Rows exist for every entity, not only tracked monsters: CSittingScientist
// takes no AI slot and still talks.

//m_bitsSaid, talkmonster.h:30-37
#define HLTLK_SAID_DMG_LIGHT	1
#define HLTLK_SAID_DMG_MEDIUM	2
#define HLTLK_SAID_DMG_HEAVY	4
#define HLTLK_SAID_HELLO		8
#define HLTLK_SAID_WOUND_LIGHT	16
#define HLTLK_SAID_WOUND_HEAVY	32
#define HLTLK_SAID_HEARD		64
#define HLTLK_SAID_SMELLED		128

//m_hTalkTarget / m_hTargetEnt as an index. The player is not in the monster
//table and its live position comes from the listener, so it needs its own value
#define HLTLK_NOBODY			-1
#define HLTLK_PLAYER			-2

//head bone controller envelope, degrees off the body's yaw. scientist.mdl slot
//0 is bone 20 Bip02 Head type XR over -60..60 at index 0 and barney.mdl slot 0
//is bone 21 Bip01 Head over the same range; hgrunt runs to 70. HLStudioCtlSetting
//clamps a larger angle onto the rail rather than rejecting it, which reads as a
//head rotated square to the shoulders
#define HLAI_TLK_HEAD_MAX		60.0

//CSittingScientist cannot turn its body, so its head carries the whole angle.
//m_headTurn spans RANDOM_LONG(0,8) * 10 - 40, scientist.cpp:1390
#define HLAI_TLK_SIT_HEAD_MAX	40.0

//TASK_TLK_IDEALYAW, talkmonster.cpp:424: the body turns until the listener sits
//within this of its facing and the head covers the remainder
#define HLAI_TLK_YAW_SLACK		45.0

//pev->yaw_speed while addressing someone, talkmonster.cpp:417. Degrees per
//second, and not the per-kind rate the movement tasks use
#define HLAI_TLK_YAW_SPEED		60.0

class CHLTalkState
{
	I64		bits_said;		//m_bitsSaid
	I64		n_speak;		//m_nSpeak, how often this one has started talking
	I64		voice_pitch;	//m_voicePitch, a percentage of the recorded rate
	F64		use_time;		//m_useTime, no +USE until then
	F64		stop_talk;		//m_flStopTalkTime, when the current line ends
	F64		last_smelled;	//m_flLastSaidSmelled
	F64		response;		//CSittingScientist::m_flResponseDelay
	F64		next_think;		//SittingThink's own 0.1s cadence
	F64		head_turn;		//m_headTurn, degrees off the body's yaw
	I64		talk_target;	//m_hTalkTarget
	I64		follow;			//m_hTargetEnt, the follow leader
	Bool	inited;			//TalkInit has run for this row
};

CHLTalkState	hl_ai_talk[HLENT_MAX];

//CTalkMonster::g_talkWaitTime, talkmonster.cpp:30. One global for the whole
//map: only one character starts a line at a time, which is what keeps a room of
//scientists from all speaking at once. It gates the START of a line, not the
//line itself, so two already-running sentences still overlap.
F64	hl_ai_talk_wait = 0.0;

U0 HLAITalkResetRow(I64 i)
{//globals are not zeroed and the whole table is walked every tick
	hl_ai_talk[i].bits_said    = 0;
	hl_ai_talk[i].n_speak      = 0;
	hl_ai_talk[i].voice_pitch  = HLPITCH_NORM;
	hl_ai_talk[i].use_time     = 0.0;
	hl_ai_talk[i].stop_talk    = 0.0;
	hl_ai_talk[i].last_smelled = 0.0;
	hl_ai_talk[i].response     = 0.0;
	hl_ai_talk[i].next_think   = 0.0;
	hl_ai_talk[i].head_turn    = 0.0;
	hl_ai_talk[i].talk_target  = HLTLK_NOBODY;
	hl_ai_talk[i].follow       = HLTLK_NOBODY;
	hl_ai_talk[i].inited       = FALSE;
}

//--- the world sound list ---------------------------------------------------
//
// CSoundEnt, dlls/soundent.cpp. HL's monsters hear through a global list of
// CSound records rather than through the mixer: anything that wants to be
// noticed calls CSoundEnt::InsertSound with a type, a position, a radius and a
// lifetime, and CBaseMonster::Listen walks the live entries against the
// monster's own sound mask and hearing sensitivity.
//
// The SDK keeps a free list and an active list threaded through one pool. A
// flat array with an expiry stamp holds the same information: the pool is 64
// entries and the walk is over all of them, which at this size costs less than
// maintaining two threaded lists.
//
// Volume is the audible radius in world units, as m_iVolume is in the SDK -
// not a mixer gain. Nothing here plays a sound; HLSndPlayAt is separate and a
// caller that wants both makes both calls, exactly as the SDK does.

class CHLWorldSound
{
	F64	origin[3];
	F64	expire;		//m_flExpireTime, absolute game time
	F64	volume;		//m_iVolume, the radius at hearing sensitivity 1.0
	I64	type;		//HLSOUND_*
};

CHLWorldSound	hl_ai_snd[HLAI_WORLD_SOUNDS];

//the player's own entry. CSoundEnt::Update keeps one per client rather than
//inserting a fresh record every frame, so a walking player does not fill the
//pool
I64	hl_ai_snd_player = 0;

//where the listener was last tick, to derive the player's speed without
//reaching hl_velocity in HL1.ZC, which compiles later
F64		hl_ai_snd_prev[3];
Bool	hl_ai_snd_prev_ok = FALSE;
F64		hl_ai_snd_next    = 0.0;

//CBasePlayer::m_iWeaponVolume, set by whatever fires a weapon and decayed
//here. HLWeapon.ZC compiles after this file and can write it.
F64	hl_ai_gun_volume = 0.0;

U0 HLAISoundListInit()
{//globals are not zeroed and this table is walked every tick
	I64 i;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		hl_ai_snd[i].expire = 0.0;
		hl_ai_snd[i].volume = 0.0;
		hl_ai_snd[i].type   = HLSOUND_NONE;

		HLVecSet(hl_ai_snd[i].origin, 0.0, 0.0, 0.0);
	}

	//slot 0 is the client's, reserved as CSoundEnt reserves one per player
	hl_ai_snd_player  = 0;
	hl_ai_snd_prev_ok = FALSE;
	hl_ai_snd_next    = 0.0;
	hl_ai_gun_volume  = 0.0;

	HLVecSet(hl_ai_snd_prev, 0.0, 0.0, 0.0);
}

I64 HLAIAllocSound()
{//IAllocSound: the first expired entry, or the one that expires soonest
 //
 //the SDK returns SOUNDLIST_EMPTY when the pool is full and drops the sound.
 //Recycling the oldest instead keeps the newest event audible, which is the
 //one a monster should react to.
	F64	oldest;
	I64	best = 1;
	I64	i;

	//slot 0 belongs to the player and is never handed out
	oldest = hl_ai_snd[1].expire;

	for (i = 1; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			return i;

		if (hl_ai_snd[i].expire < oldest)
		{
			oldest = hl_ai_snd[i].expire;
			best   = i;
		}
	}

	return best;
}

U0 HLAIInsertSound(I64 type, F64 *origin, F64 volume, F64 duration)
{//CSoundEnt::InsertSound. volume is the audible radius in world units
	I64 i;

	if (!origin || volume <= 0.0 || duration <= 0.0)
		return;

	i = HLAIAllocSound;

	HLVecCopy(origin, hl_ai_snd[i].origin);

	hl_ai_snd[i].type   = type;
	hl_ai_snd[i].volume = volume;
	hl_ai_snd[i].expire = hl_ent_time + duration;
}

U0 HLAIPlayerSound(F64 *origin, F64 speed)
{//CSoundEnt::Update's client entry plus CBasePlayer::UpdatePlayerSound
 //
 //the SDK scales the radius off the player's speed and adds m_iWeaponVolume,
 //which a fired weapon sets and which decays. A crouching, still player makes
 //no sound at all, which is what lets someone sneak past a sleeping houndeye.
	F64 vol;

	//UpdatePlayerSound's bar: below this the player is not audible
	if (speed <= 100.0)
		vol = 0.0;
	else
		vol = speed;

	if (hl_ai_gun_volume > vol)
		vol = hl_ai_gun_volume;

	//m_iWeaponVolume decays over about a quarter second in the SDK
	hl_ai_gun_volume -= hl_ai_gun_volume * 0.25;

	if (hl_ai_gun_volume < 1.0)
		hl_ai_gun_volume = 0.0;

	if (vol <= 0.0)
	{
		hl_ai_snd[hl_ai_snd_player].expire = 0.0;
		return;
	}

	HLVecCopy(origin, hl_ai_snd[hl_ai_snd_player].origin);

	hl_ai_snd[hl_ai_snd_player].type   = HLSOUND_PLAYER;
	hl_ai_snd[hl_ai_snd_player].volume = vol;

	//0.3 is the SDK's client sound lifetime, long enough to survive one
	//monster think at the SDK's 0.1s cadence
	hl_ai_snd[hl_ai_snd_player].expire = hl_ent_time + 0.3;
}

U0 HLAISoundFrame()
{//the player half of CSoundEnt::Update, once per tick
 //
 //hl_velocity lives in HL1.ZC and compiles later, so the speed comes from how
 //far the listener moved since the last call. Bob rides on top of it and adds
 //a few units a second, well under the 100-unit audibility bar.
	F64 d[3];
	F64 dt;
	F64 speed;

	dt = hl_ent_time - hl_ai_snd_next;

	//the listener is re-sampled at a fixed cadence rather than per tick: at
	//72Hz the per-tick delta is a couple of units and rounds to noise
	if (dt < 0.1)
		return;

	hl_ai_snd_next = hl_ent_time;

	if (!hl_ai_snd_prev_ok || dt <= 0.0 || dt > 1.0)
	{
		HLVecCopy(hl_snd_listener, hl_ai_snd_prev);
		hl_ai_snd_prev_ok = TRUE;
		return;
	}

	HLVecSub(hl_snd_listener, hl_ai_snd_prev, d);
	speed = HLVecLength(d) / dt;

	HLVecCopy(hl_snd_listener, hl_ai_snd_prev);

	//the entry sits at the player's feet, where the noise is made
	d[0] = hl_snd_listener[0];
	d[1] = hl_snd_listener[1];
	d[2] = hl_snd_listener[2] - HLAI_PLAYER_EYE;

	HLAIPlayerSound(d, speed);
}

//--- schedules --------------------------------------------------------------
//
// Flat arrays rather than nested initialisers: a global's initialiser is
// unreliable on this compiler, so every row is appended by a call at runtime.

I64	hl_ai_sched_task[HLSCHED_COUNT * HLAI_SCHED_TASKS];
F64	hl_ai_sched_data[HLSCHED_COUNT * HLAI_SCHED_TASKS];
I64	hl_ai_sched_len[HLSCHED_COUNT];

U0 HLAISchedAdd(I64 sched, I64 task, F64 data)
{//append one task to a schedule
	I64 n;

	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	n = hl_ai_sched_len[sched];

	if (n >= HLAI_SCHED_TASKS)
	{
		"HLAI: schedule %d full\n", sched;
		return;
	}

	hl_ai_sched_task[sched * HLAI_SCHED_TASKS + n] = task;
	hl_ai_sched_data[sched * HLAI_SCHED_TASKS + n] = data;

	//incremented separately: `x[i++] = f()` loses the store on this compiler
	hl_ai_sched_len[sched] = n + 1;
}

U0 HLAISchedInit()
{//defaultai.cpp's slIdleStand, slAlertFace, slChaseEnemy and the rest, cut
 //down to the tasks a monster with no node graph and no squad can run
	I64 i;

	for (i = 0; i < HLSCHED_COUNT; i++)
		hl_ai_sched_len[i] = 0;

	//slIdleStand: stand there, look around, wait a random while
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_WAIT_RANDOM, 5.0);

	//slAlertStand: the same, shorter - an alert monster re-decides often
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_WAIT_RANDOM, 2.0);

	//slAlertFace: turn to whatever it noticed
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_WAIT, 1.0);

	//slWakeAngry: the noise on first seeing an enemy, before anything moves
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_SOUND_ALERT, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_WAIT, 0.4);

	//slChaseEnemy. In the SDK TASK_GET_PATH_TO_ENEMY calls the node graph and
	//fails when there is no route; here it only records the goal, so the run
	//that follows is a straight line with a wall slide.
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_PATH_TO_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_SET_ACTIVITY, HLACT_RUN);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_FACE_ENEMY, 0.0);

	//slMeleeAttack1
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_MELEE_ATTACK1, 0.0);

	//slRangeAttack1
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_RANGE_ATTACK1, 0.0);

	//slTakeCoverFromEnemy, with the cover node lookup replaced by
	//FindLateralCover's sampling - see HLAIFindCover
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_SOUND_ALERT, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_WAIT, 0.2);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_FIND_COVER_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_WAIT, 1.0);

	//slSmallFlinch
	HLAISchedAdd(HLSCHED_SMALL_FLINCH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_SMALL_FLINCH, HLTASK_SET_ACTIVITY, HLACT_FLINCH);
	HLAISchedAdd(HLSCHED_SMALL_FLINCH, HLTASK_WAIT_FOR_ANIM, 0.0);

	//slDie. TASK_DIE holds the last frame; no corpse removal and no gibs, so
	//the body stays where it fell.
	HLAISchedAdd(HLSCHED_DIE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_DIE, HLTASK_SOUND_DIE, 0.0);
	HLAISchedAdd(HLSCHED_DIE, HLTASK_DIE, 0.0);

	//slIdleWalk: wander. The SDK walks the route the node graph left in
	//m_Route; with no graph the goal is a clear point nearby, so an idle
	//monster paces rather than patrols.
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_FIND_COVER_ORG, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_FACE_GOAL, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_STOP_MOVING, 0.0);

	//slAlertSmallFlinch: flinch, then face what hit you. The SDK's
	//TASK_SET_SCHEDULE(SCHED_ALERT_FACE) is the last task, so it is here too
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_SMALL_FLINCH, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_SET_SCHEDULE,
		HLSCHED_ALERT_FACE);

	//slInvestigateSound: walk to the noise, look around, walk back to the
	//post. The whole point of the sound list - a gunshot two rooms away pulls
	//a patrol out of position.
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_STORE_LASTPOS, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PATH_TO_SOUND, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_FACE_IDEAL, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PLAY_SEQUENCE, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WAIT, 10.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PATH_TO_LASTPOS, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_CLEAR_LASTPOS, 0.0);

	//slCombatFace
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_FACE_ENEMY, 0.0);

	//slCombatStand: hold, facing the enemy, until something changes. The SDK
	//waits indefinitely on the conditions; here the state machine re-selects
	//when the enemy moves, so it is a bounded wait instead
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_SET_ACTIVITY, HLACT_COMBAT_IDLE);
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_WAIT_FACE_ENEMY, 1.0);

	//slChaseEnemyFailed: the chase could not get there, so break contact and
	//come back facing. This is where a blocked path lands now instead of
	//re-selecting the same chase next tick.
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_WAIT, 0.2);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_FIND_COVER_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_WAIT, 1.0);

	//slStandoff: in cover or out of contact, hold and watch. What a grunt
	//with no engage slot does instead of walking into the open.
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_SET_ACTIVITY, HLACT_COMBAT_IDLE);
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_WAIT_FACE_ENEMY, 2.0);

	//slReload
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_RELOAD, 0.0);

	//slArmWeapon: barney drawing his pistol
	HLAISchedAdd(HLSCHED_ARM_WEAPON, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ARM_WEAPON, HLTASK_PLAY_SEQUENCE, HLACT_ARM);

	//slSecondaryMeleeAttack
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_MELEE_ATTACK2, 0.0);

	//slRangeAttack2
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_RANGE_ATTACK2, 0.0);

	//slSpecialAttack1: the houndeye's warm-up blast and the agrunt's threat
	//display both run through this
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_SPECIAL_ATTACK1, 0.0);

	//slTakeCoverFromBestSound. TASK_TURN_LEFT 179 is the SDK's way of putting
	//the monster's back to what it ran from
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_FIND_COVER_SOUND, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_TURN_LEFT, 179.0);

	//slTakeCoverFromOrigin
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_FIND_COVER_ORG, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_TURN_LEFT, 179.0);

	//slCower: nowhere left to run
	HLAISchedAdd(HLSCHED_COWER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COWER, HLTASK_PLAY_SEQUENCE, HLACT_COWER);

	//slVictoryDance
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_PLAY_SEQUENCE, HLACT_VICTORY);
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_WAIT, 1.0);

	//slAmbush: hold position until something is seen. The SF_MONSTER_WAIT_
	//FOR_SCRIPT spawnflag monsters use to stay put in a trap room
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_WAIT_INDEF, 0.0);

	//slBarnacleVictimGrab: the tongue has hit, so play the hit take and then
	//cycle the pull take while the barnacle hoists
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_PLAY_SEQUENCE, HLACT_BARN_HIT);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_SET_ACTIVITY, HLACT_BARN_PULL);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_WAIT_INDEF, 0.0);

	//slBarnacleVictimChomp
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_PLAY_SEQUENCE,
		HLACT_BARN_CHOMP);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_SET_ACTIVITY, HLACT_BARN_CHEW);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_WAIT_INDEF, 0.0);

	//slFail: stand still for two seconds after a schedule collapses, so a
	//monster whose every option fails does not thrash through the selector
	//once per tick
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_WAIT, 2.0);

	//slFaceTarget, scientist.cpp:236-240. Ends by jumping to the chase, so a
	//follower that has caught up turns to its leader and then waits on the
	//move task rather than falling back through the selector.
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_FACE_TARGET, 0.0);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_SET_SCHEDULE,
		HLSCHED_TARGET_CHASE);

	//slFollow, scientist.cpp:132-137. 128 units is tlFollow's own figure.
	//TASK_SET_FAIL_SCHEDULE(SCHED_CANT_FOLLOW) has no counterpart here: the
	//move task stops the follow itself when it cannot reach the leader.
	HLAISchedAdd(HLSCHED_TARGET_CHASE, HLTASK_MOVE_TO_TARGET, 128.0);
}

//--- the table's contents ---------------------------------------------------

U0 HLAIMonSeq(I64 kind, I64 act, U8 *label)
{//one sequence label. The label has to be copied: a U8* table of literals
 //collapses to one entry on this compiler
	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return;

	HLStrCopy(&hl_ai_mon_info[kind].seq[act * 24], label, 24);
}

U8 *HLAIMonSeqOf(I64 kind, I64 act)
{//the label for one activity, NULL when the monster has no such sequence
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return NULL;

	p = &hl_ai_mon_info[kind].seq[act * 24];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAIMonHull(I64 kind, F64 w, F64 h, F64 eye)
{//UTIL_SetSize plus view_ofs. Monsters stand on their origin, so mins z is 0
	CHLMonInfo *m;

	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	m = &hl_ai_mon_info[kind];

	HLVecSet(m->mins, -w, -w, 0.0);
	HLVecSet(m->maxs, w, w, h);
	m->view_ofs = eye;
}

U0 HLAIMonTableInit()
{//every row, assigned field by field
 //
 //health and damage are gSkillData at skill 1, from valve/skill.cfg. FOV is
 //m_flFieldOfView from each Spawn(), a cosine: 0.5 is a 120 degree cone, -1.0
 //is all round.
	CHLMonInfo	*m;
	I64			 i;
	I64			 j;

	for (i = 0; i < HLMON_COUNT; i++)
	{
		m = &hl_ai_mon_info[i];

		m->classname[0]   = 0;
		m->classify       = HLCLASS_NONE;
		m->health         = 20.0;
		m->view_ofs       = 20.0;
		m->fov            = 0.5;
		m->look_dist      = 2048.0;
		m->walk_speed     = 32.0;
		m->run_speed      = 120.0;
		m->yaw_speed      = 120.0;
		m->melee_range    = 0.0;
		m->melee_dmg      = 0.0;
		m->range_min      = 0.0;
		m->range_max      = 0.0;
		m->range_dmg      = 0.0;
		m->range_bullets  = 1;
		m->blast_radius   = 0.0;
		m->attack_rate    = 1.0;
		m->flees          = FALSE;
		m->melee2_range   = 0.0;
		m->melee2_dmg     = 0.0;
		m->squads         = FALSE;
		m->flies          = FALSE;
		m->blood          = HLBLOOD_RED;
		m->clip_size      = 0;
		m->slot_attack    = HLSLOT_NONE;
		m->attack_noise   = 0.0;

		//HearingSensitivity() is 1.0 in CBaseMonster and ISoundMask() is
		//bits_ALL_SOUNDS; the rows below narrow either where the SDK does
		m->hear_sens      = 1.0;
		m->sound_mask     = HLSOUND_ALL;

		m->snd_idle[0]    = 0;
		m->snd_alert[0]   = 0;
		m->snd_attack[0]  = 0;
		m->snd_die[0]     = 0;

		HLVecSet(m->mins, -16.0, -16.0, 0.0);
		HLVecSet(m->maxs, 16.0, 16.0, 72.0);

		for (j = 0; j < HLACT_COUNT; j++)
			m->seq[j * 24] = 0;
	}

	//--- headcrab. CHeadCrab: 10 health, bite 5, all-round vision, and in the
	//SDK a 256-unit leap as its range attack. The leap needs a monster mover
	//with velocity and a touch callback; neither exists, so the crab is
	//melee-only and closes on foot.
	m = &hl_ai_mon_info[HLMON_HEADCRAB];
	HLStrCopy(m->classname, "monster_headcrab", 32);
	m->classify    = HLCLASS_ALIEN_PREY;
	m->health      = 10.0;
	m->fov         = -1.0;			//pev->view_ofs/FOV: crabs see everything
	m->walk_speed  = 40.0;
	m->run_speed   = 150.0;
	m->yaw_speed   = 200.0;
	m->melee_range = 40.0;
	m->melee_dmg   = 5.0;
	m->attack_rate = 0.6;
	HLAIMonHull(HLMON_HEADCRAB, 12.0, 24.0, 12.0);
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_MELEE,  "jump");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_DIE,    "dieback");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_COMBAT_IDLE, "angry");
	HLStrCopy(m->snd_idle,   "headcrab/hc_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "headcrab/hc_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "headcrab/hc_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "headcrab/hc_die1.wav", 48);

	//--- zombie. CZombie: 50 health, one_slash 10 on attack1 (the left and
	//right claws, ZOMBIE_AE_ATTACK_LEFT/RIGHT), both_slash 25 on attack2
	//(ZOMBIE_AE_ATTACK_BOTH). No run sequence in the model.
	m = &hl_ai_mon_info[HLMON_ZOMBIE];
	HLStrCopy(m->classname, "monster_zombie", 32);
	m->classify    = HLCLASS_ALIEN_MONSTER;
	m->health      = 50.0;
	m->fov         = 0.2;
	m->walk_speed  = 30.0;
	m->run_speed   = 60.0;
	m->yaw_speed   = 90.0;
	m->melee_range = 64.0;
	m->melee_dmg   = 10.0;
	m->attack_rate = 1.0;
	HLAIMonHull(HLMON_ZOMBIE, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_RUN,    "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE,  "attack1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE2, "attack2");

	//CheckTraceHullAttack's reach is 70 for both takes, wider than the 64 the
	//attack is chosen at
	m->melee2_range = 70.0;
	m->melee2_dmg   = 25.0;			//sk_zombie_dmg_both_slash1
	HLStrCopy(m->snd_idle,   "zombie/zo_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "zombie/zo_alert10.wav", 48);
	HLStrCopy(m->snd_attack, "zombie/zo_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "zombie/zo_pain1.wav", 48);

	//--- scientist. CScientist: 20 health, no attack, SelectSchedule a chain of
	//flee and follow behaviours. Following the player needs CTalkMonster's use
	//handling and a player-relative goal; only the flee half is here.
	m = &hl_ai_mon_info[HLMON_SCIENTIST];
	HLStrCopy(m->classname, "monster_scientist", 32);
	m->classify   = HLCLASS_HUMAN_PASSIVE;
	m->health     = 20.0;
	m->fov        = 0.5;
	m->walk_speed = 40.0;
	m->run_speed  = 180.0;
	m->yaw_speed  = 120.0;
	m->flees      = TRUE;
	HLAIMonHull(HLMON_SCIENTIST, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_WALK,   "walk_scared");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_FLINCH, "flinch1");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_COWER,  "cowering_in_corner");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_BARN_HIT,   "barnacled1");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_BARN_PULL,  "barnacled2");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_BARN_CHOMP, "barnacled3");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_BARN_CHEW,  "barnacled4");
	HLStrCopy(m->snd_alert, "scientist/sci_fear1.wav", 48);
	HLStrCopy(m->snd_die,   "scientist/sci_die1.wav", 48);

	//--- barney. CBarney: 35 health, pistol at monDmg9MM (5), out to 1024
	//units. PLAYER_ALLY, so the relationship matrix keeps him off the player
	//and pointed at whatever the player is fighting.
	m = &hl_ai_mon_info[HLMON_BARNEY];
	HLStrCopy(m->classname, "monster_barney", 32);
	m->classify     = HLCLASS_PLAYER_ALLY;
	m->health       = 35.0;
	m->fov          = 0.5;
	m->walk_speed   = 40.0;
	m->run_speed    = 160.0;
	m->yaw_speed    = 120.0;
	m->range_min    = 64.0;
	m->range_max    = 1024.0;
	m->range_dmg    = 5.0;
	m->attack_rate  = 0.4;
	HLAIMonHull(HLMON_BARNEY, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_BARNEY, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_BARNEY, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_BARNEY, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_BARNEY, HLACT_RANGE,  "shootgun");
	HLAIMonSeq(HLMON_BARNEY, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_BARNEY, HLACT_FLINCH, "smlflinch");
	HLAIMonSeq(HLMON_BARNEY, HLACT_ARM,    "draw");
	HLAIMonSeq(HLMON_BARNEY, HLACT_RELOAD, "reload");
	HLAIMonSeq(HLMON_BARNEY, HLACT_COWER,  "cower_stand");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_HIT,   "barnaclehit");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_PULL,  "barnaclepull");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_CHOMP, "barnaclecrunch");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_CHEW,  "barnaclechew");

	//the pistol comes out of the holster on BARNEY_AE_DRAW, so ACT_ARM has to
	//run before the first shot. blood is red and a hit puts one gunshot in the
	//world sound list at pistol range
	m->attack_noise = 384.0;
	HLStrCopy(m->snd_alert,  "barney/ba_attack1.wav", 48);
	HLStrCopy(m->snd_attack, "barney/ba_attack2.wav", 48);
	HLStrCopy(m->snd_die,    "barney/ba_die1.wav", 48);

	//--- houndeye. CHoundeye: 20 health, sonic blast is radius damage of 10 out
	//to HOUNDEYE_MAX_ATTACK_RADIUS 384, not a hitscan, so it hurts through a
	//corner. The pack scaling of the blast is squad code and is absent.
	m = &hl_ai_mon_info[HLMON_HOUNDEYE];
	HLStrCopy(m->classname, "monster_houndeye", 32);
	m->classify     = HLCLASS_ALIEN_MONSTER;
	m->health       = 20.0;
	m->fov          = 0.5;
	m->walk_speed   = 40.0;
	m->run_speed    = 150.0;
	m->yaw_speed    = 180.0;
	m->range_min    = 0.0;
	m->range_max    = 384.0;
	m->range_dmg    = 10.0;
	m->blast_radius = 384.0;
	m->attack_rate  = 1.5;
	HLAIMonHull(HLMON_HOUNDEYE, 16.0, 36.0, 20.0);
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_IDLE,   "idle2");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_WALK,   "walk2");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_RANGE,  "attack");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_DIE,    "die");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_FLINCH, "flinch_small");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_COMBAT_IDLE, "madidle");
	HLAIMonSeq(HLMON_HOUNDEYE, HLACT_SPECIAL,     "jumpback");

	//CHoundeye sets bits_CAP_SQUAD, and its GetSchedule takes one of the three
	//attack slots before blasting: a pack fires in turn rather than together
	m->squads      = TRUE;
	m->slot_attack = HLSLOTS_HOUND_ATTACK;
	m->blood       = HLBLOOD_YELLOW;

	//the blast is loud. hgrunt.cpp's figure for a gunshot, which is the only
	//radius the SDK states for a combat sound
	m->attack_noise = 384.0;
	HLStrCopy(m->snd_idle,   "houndeye/he_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "houndeye/he_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "houndeye/he_blast1.wav", 48);
	HLStrCopy(m->snd_die,    "houndeye/he_die1.wav", 48);

	//--- human grunt. CHGrunt: 50 health, MP5 at 9mmAR_bullet (3) x3 in a
	//burst. No squad, no grenades, no signals, no crouching.
	m = &hl_ai_mon_info[HLMON_HGRUNT];
	HLStrCopy(m->classname, "monster_human_grunt", 32);
	m->classify      = HLCLASS_HUMAN_MILITARY;
	m->health        = 50.0;
	m->fov           = 0.2;
	m->walk_speed    = 40.0;
	m->run_speed     = 160.0;
	m->yaw_speed     = 150.0;
	m->melee_range   = 64.0;
	m->melee_dmg     = 5.0;			//sk_hgrunt_kick1, the frontkick
	m->range_min     = 128.0;
	m->range_max     = 2048.0;
	m->range_dmg     = 3.0;
	m->range_bullets = 3;
	m->attack_rate   = 0.6;
	HLAIMonHull(HLMON_HGRUNT, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_HGRUNT, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_WALK,   "walk1");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_MELEE,  "frontkick");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_RANGE,  "standing_mp5");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_FLINCH, "smflinch");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_RELOAD, "reload_mp5");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_COMBAT_IDLE, "combatidle");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_SIGNAL,  "advance_signal");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_VICTORY, "victorydance");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_COWER,   "cower");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_BARN_HIT,   "barnacled1");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_BARN_PULL,  "barnacled2");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_BARN_CHOMP, "barnacled3");
	HLAIMonSeq(HLMON_HGRUNT, HLACT_BARN_CHEW,  "barnacled4");

	//CHGrunt sets bits_CAP_SQUAD and its GetSchedule takes an engage slot
	//before it will stand and fire. Two of a fireteam shoot; the rest take
	//cover or hold, which is the whole difference between a squad of grunts
	//and four individuals.
	m->squads      = TRUE;
	m->slot_attack = HLSLOTS_HGRUNT_ENGAGE;
	m->clip_size   = 36;			//GRUNT_CLIP_SIZE
	m->attack_noise = 384.0;		//HGRUNT_AE_BURST1's InsertSound

	//grunts are the one class that goes looking. ISoundMask is the default,
	//but the sensitivity is what makes them investigate a shot two rooms off
	m->hear_sens = 1.0;
	HLStrCopy(m->snd_idle,   "hgrunt/gr_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "hgrunt/gr_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "hgrunt/gr_mgun1.wav", 48);
	HLStrCopy(m->snd_die,    "hgrunt/gr_die1.wav", 48);

	//--- alien slave. CISlave: 30 health, claw 8 in melee, zap 10 at range.
	//The hornet swarm and the arc between slaves are projectile and beam
	//effects and are absent, so the zap is a hitscan with a sound.
	m = &hl_ai_mon_info[HLMON_ISLAVE];
	HLStrCopy(m->classname, "monster_alien_slave", 32);
	m->classify    = HLCLASS_ALIEN_MILITARY;
	m->health      = 30.0;
	m->fov         = 0.2;
	m->walk_speed  = 40.0;
	m->run_speed   = 150.0;
	m->yaw_speed   = 120.0;
	m->melee_range = 64.0;
	m->melee_dmg   = 8.0;
	m->range_min   = 64.0;
	m->range_max   = 1024.0;
	m->range_dmg   = 10.0;
	m->attack_rate = 1.2;
	HLAIMonHull(HLMON_ISLAVE, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_ISLAVE, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_WALK,   "walk1");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_RUN,    "run1");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_MELEE,  "attack1");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_RANGE,  "zapattack1");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_ISLAVE, HLACT_FLINCH, "flinch2");

	//CISlave is a CSquadMonster, but nothing in its GetSchedule gates on a
	//slot: the squad only shares enemies and cover spacing
	m->squads = TRUE;
	m->blood  = HLBLOOD_YELLOW;
	m->attack_noise = 384.0;
	HLStrCopy(m->snd_alert,  "aslave/slv_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "debris/zap4.wav", 48);
	HLStrCopy(m->snd_die,    "aslave/slv_die1.wav", 48);

	//--- bullsquid. CBullsquid: 40 health, bite 15 on BSQUID_AE_BITE and whip
	//25 on BSQUID_AE_TAILWHIP, both with a 85-unit reach. The spit is a
	//projectile entity and is absent, so it is melee-only.
	m = &hl_ai_mon_info[HLMON_BULLSQUID];
	HLStrCopy(m->classname, "monster_bullchicken", 32);
	m->classify    = HLCLASS_ALIEN_PREDATOR;
	m->health      = 40.0;
	m->fov         = 0.2;
	m->walk_speed  = 40.0;
	m->run_speed   = 180.0;
	m->yaw_speed   = 150.0;
	m->melee_range  = 85.0;
	m->melee_dmg    = 15.0;			//sk_bullsquid_dmg_bite1
	m->melee2_range = 85.0;
	m->melee2_dmg   = 25.0;			//sk_bullsquid_dmg_whip1
	m->attack_rate  = 1.0;
	m->blood        = HLBLOOD_YELLOW;
	HLAIMonHull(HLMON_BULLSQUID, 32.0, 64.0, 40.0);
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_IDLE,   "idle");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_MELEE,  "bite");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_MELEE2, "whip");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_DIE,    "die");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_FLINCH, "flinchs");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_EAT,    "eat");
	HLAIMonSeq(HLMON_BULLSQUID, HLACT_SPECIAL, "suprisedhop");

	//CBullsquid::ISoundMask is bits_SOUND_WORLD | COMBAT | PLAYER | MEAT: a
	//squid comes to a gunshot or a corpse and ignores rubbish
	m->sound_mask = HLSOUND_WORLD | HLSOUND_COMBAT | HLSOUND_PLAYER |
		HLSOUND_MEAT;
	HLStrCopy(m->snd_idle,   "bullchicken/bc_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "bullchicken/bc_attackgrowl.wav", 48);
	HLStrCopy(m->snd_attack, "bullchicken/bc_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "bullchicken/bc_die1.wav", 48);

	//--- alien grunt. CAGrunt: 60 health, punch 10 at AGRUNT_MELEE_DIST 100,
	//FOV 0.2, a 32x64 hull. The hornet swarm is a homing projectile entity;
	//with no projectile system it is fired as a hitscan burst of three at
	//sk_hornet_dmg1, which is what the swarm lands over its flight.
	m = &hl_ai_mon_info[HLMON_AGRUNT];
	HLStrCopy(m->classname, "monster_alien_grunt", 32);
	m->classify      = HLCLASS_ALIEN_MILITARY;
	m->health        = 60.0;		//sk_agrunt_health1
	m->fov           = 0.2;
	m->walk_speed    = 40.0;
	m->run_speed     = 150.0;
	m->yaw_speed     = 110.0;
	m->melee_range   = 100.0;		//AGRUNT_MELEE_DIST
	m->melee_dmg     = 10.0;		//sk_agrunt_dmg_punch1
	m->range_min     = 100.0;		//CheckRangeAttack1: beyond melee reach
	m->range_max     = 1024.0;
	m->range_dmg     = 4.0;			//sk_hornet_dmg1
	m->range_bullets = 3;
	m->attack_rate   = 1.5;
	m->squads        = TRUE;
	m->slot_attack   = HLSLOTS_AGRUNT_HORNET;
	m->blood         = HLBLOOD_YELLOW;
	m->attack_noise  = 384.0;
	HLAIMonHull(HLMON_AGRUNT, 32.0, 64.0, 48.0);
	HLAIMonSeq(HLMON_AGRUNT, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_MELEE,  "mattack2");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_MELEE2, "mattack3");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_RANGE,  "hornetattack");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_RANGE2, "longshoot");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_FLINCH, "smallflinch");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_THREAT, "threat");
	HLAIMonSeq(HLMON_AGRUNT, HLACT_VICTORY, "victoryeat");
	m->melee2_range = 100.0;
	m->melee2_dmg   = 10.0;
	HLStrCopy(m->snd_idle,   "agrunt/ag_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "agrunt/ag_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "agrunt/ag_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "agrunt/ag_die1.wav", 48);

	//--- alien controller. CController: 60 health, MOVETYPE_FLY, all-round
	//vision, view_ofs -2, a 32x64 hull. Both its attacks are projectiles - a
	//homing energy ball and a head-mounted zap - so the zap is fired as a
	//hitscan at sk_controller_dmgzap1 and the ball is absent.
	m = &hl_ai_mon_info[HLMON_CONTROLLER];
	HLStrCopy(m->classname, "monster_alien_controller", 32);
	m->classify     = HLCLASS_ALIEN_MILITARY;
	m->health       = 60.0;			//sk_controller_health1
	m->fov          = -1.0;			//VIEW_FIELD_FULL
	m->walk_speed   = 40.0;
	m->run_speed    = 120.0;
	m->yaw_speed    = 120.0;
	m->range_min    = 64.0;
	m->range_max    = 2048.0;
	m->range_dmg    = 15.0;			//sk_controller_dmgzap1
	m->attack_rate  = 1.0;
	m->flies        = TRUE;
	m->blood        = HLBLOOD_YELLOW;
	m->attack_noise = 384.0;
	HLAIMonHull(HLMON_CONTROLLER, 32.0, 64.0, -2.0);
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_IDLE,   "idle2");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RANGE,  "shoot");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_RANGE2, "attack1");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_DIE,    "die1");
	HLAIMonSeq(HLMON_CONTROLLER, HLACT_FLINCH, "flinch1");
	HLStrCopy(m->snd_idle,   "controller/con_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "controller/con_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "controller/con_attack1.wav", 48);
	HLStrCopy(m->snd_die,    "controller/con_die1.wav", 48);
}

U0 HLAIMonInit()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	I64 i;

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent           = -1;
		hl_ai_mon[i].kind          = -1;
		hl_ai_mon[i].state         = HLMSTATE_NONE;
		hl_ai_mon[i].sched         = HLSCHED_NONE;
		hl_ai_mon[i].task          = 0;
		hl_ai_mon[i].task_status   = HLTK_DONE;
		hl_ai_mon[i].task_start    = 0.0;
		hl_ai_mon[i].sched_done    = TRUE;
		hl_ai_mon[i].have_enemy    = FALSE;
		hl_ai_mon[i].enemy         = -1;
		hl_ai_mon[i].enemy_seen    = 0.0;
		hl_ai_mon[i].have_goal     = FALSE;
		hl_ai_mon[i].goal_is_enemy = FALSE;
		hl_ai_mon[i].goal_tol      = 32.0;
		hl_ai_mon[i].move_speed    = 0.0;
		hl_ai_mon[i].path_start    = 0.0;
		hl_ai_mon[i].stuck_since   = 0.0;
		hl_ai_mon[i].have_detour   = FALSE;
		hl_ai_mon[i].next_move_check = 0.0;
		hl_ai_mon[i].ideal_yaw     = 0.0;
		hl_ai_mon[i].next_attack   = 0.0;
		hl_ai_mon[i].next_idle_snd = 0.0;
		hl_ai_mon[i].next_look     = 0.0;
		hl_ai_mon[i].last_health   = 0.0;
		hl_ai_mon[i].scripted      = FALSE;
		hl_ai_mon[i].settled       = FALSE;
		hl_ai_mon[i].squad         = -1;
		hl_ai_mon[i].squad_slots   = 0;
		hl_ai_mon[i].my_slot       = HLSLOT_NONE;
		hl_ai_mon[i].squad_tried   = FALSE;
		hl_ai_mon[i].have_lastpos  = FALSE;
		hl_ai_mon[i].ammo          = 0;
		hl_ai_mon[i].next_pain_snd = 0.0;
		hl_ai_mon[i].heard         = -1;
		hl_ai_mon[i].heard_type    = HLSOUND_NONE;
		hl_ai_mon[i].activity      = HLACT_IDLE;
		hl_ai_mon[i].act_seq       = -1;
		hl_ai_mon[i].next_blink    = 0.0;
		hl_ai_mon[i].gun_drawn     = FALSE;
		hl_ai_mon[i].in_cover      = FALSE;
		hl_ai_mon[i].fail_sched    = HLSCHED_FAIL;

		HLVecSet(hl_ai_mon[i].enemy_pos, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].goal, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].lastpos, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].heard_pos, 0.0, 0.0, 0.0);
	}

	for (i = 0; i < HLENT_MAX; i++)
		hl_ai_mon_of[i] = -1;

	hl_ai_mon_count  = 0;
	hl_ai_mon_base   = NULL;
	hl_ai_mon_ents   = 0;
	hl_ai_mon_clock  = 0.0;
	hl_ai_mon_revive = TRUE;
	hl_ai_mon_kills  = 0;
	hl_ai_tracer_count = 0;

	HLAIMonTableInit;
	HLAISchedInit;
	HLAISoundListInit;
}

//top-level, so the tables are sane before anything can reach them
HLAIMonInit;

//--- relationships ----------------------------------------------------------
//
// CBaseMonster::IRelationship indexes a 13x13 table of R_* values by (my
// class, their class). Reproduced as a comparison chain over the nine classes
// the table above uses, rather than as a 169-entry array of which 120 entries
// are unknown. Anything not named below is R_NONE, meaning ignore: a wrong
// R_HATE makes monsters attack their own side, a wrong R_NONE only makes them
// passive.
//
// Barney is CLASS_PLAYER_ALLY, so the player is R_ALLY and every alien is
// R_DISLIKE - he shoots a headcrab and not the player.

I64 HLAIRelationship(I64 mine, I64 theirs)
{
	if (mine == theirs)
	{
		//own kind. HL's diagonal is R_NO except for the military classes, so
		//two grunts do not fight and neither do two zombies
		return HLREL_NONE;
	}

	if (mine == HLCLASS_HUMAN_PASSIVE)
	{
		//the scientist row. Player and allies are allies, everything else is
		//feared. HL's row hates rather than fears some of these, but a monster
		//with no attack cannot act on hate; CScientist::SelectSchedule flees
		//either way.
		if (theirs == HLCLASS_PLAYER)			return HLREL_ALLY;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_PREY)		return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_FEAR;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_PLAYER_ALLY)
	{
		//barney. Hates the military, dislikes aliens, allied to the player and
		//to scientists
		if (theirs == HLCLASS_PLAYER)			return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_HUMAN_MILITARY)
	{
		//grunts hate the player and his allies above all else
		if (theirs == HLCLASS_PLAYER)			return HLREL_HATE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_HATE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_ALIEN_MILITARY)
	{
		if (theirs == HLCLASS_PLAYER)			return HLREL_HATE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_ALIEN_MONSTER || mine == HLCLASS_ALIEN_PREY ||
		mine == HLCLASS_ALIEN_PREDATOR)
	{
		//the wildlife. Dislikes anything human-shaped, ignores other aliens,
		//except that a predator hunts prey - a bullsquid eats headcrabs.
		if (mine == HLCLASS_ALIEN_PREDATOR && theirs == HLCLASS_ALIEN_PREY)
			return HLREL_HATE;

		if (mine == HLCLASS_ALIEN_PREY && theirs == HLCLASS_ALIEN_PREDATOR)
			return HLREL_FEAR;

		if (theirs == HLCLASS_PLAYER)			return HLREL_DISLIKE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	return HLREL_NONE;
}

//--- registration -----------------------------------------------------------

I64 HLAIMonKindFor(U8 *classname)
{//classname to a table row. A comparison chain, not a U8* table: adjacent
 //string literals concatenate by length on this compiler and a literal table
 //collapses to its first entry, as HLEntModelForClass documents
	I64 i;

	if (!classname || !classname[0])
		return -1;

	for (i = 0; i < HLMON_COUNT; i++)
	{
		if (!StrICompare(hl_ai_mon_info[i].classname, classname))
			return i;
	}

	//aliases the maps use. monster_generic wears whatever model the mapper
	//named and has no behaviour of its own in the SDK, so it is excluded.
	if (!StrICompare(classname, "monster_scientist_dead"))
		return -1;

	return -1;
}

U0 HLAIMonReset(I64 s)
{//one slot back to its resting state, keeping ent and kind
	hl_ai_mon[s].state         = HLMSTATE_IDLE;
	hl_ai_mon[s].sched         = HLSCHED_NONE;
	hl_ai_mon[s].task          = 0;
	hl_ai_mon[s].task_status   = HLTK_DONE;
	hl_ai_mon[s].task_start    = 0.0;
	hl_ai_mon[s].sched_done    = TRUE;
	hl_ai_mon[s].have_enemy    = FALSE;
	hl_ai_mon[s].enemy         = -1;
	hl_ai_mon[s].enemy_seen    = 0.0;
	hl_ai_mon[s].have_goal     = FALSE;
	hl_ai_mon[s].goal_is_enemy = FALSE;
	hl_ai_mon[s].goal_tol      = 32.0;
	hl_ai_mon[s].move_speed    = 0.0;
	hl_ai_mon[s].path_start    = 0.0;
	hl_ai_mon[s].stuck_since   = 0.0;
	hl_ai_mon[s].have_detour   = FALSE;
	hl_ai_mon[s].next_move_check = 0.0;
	hl_ai_mon[s].next_attack   = 0.0;
	hl_ai_mon[s].next_look     = 0.0;
	hl_ai_mon[s].scripted      = FALSE;
	hl_ai_mon[s].settled       = FALSE;
	hl_ai_mon[s].squad         = -1;
	hl_ai_mon[s].squad_slots   = 0;
	hl_ai_mon[s].my_slot       = HLSLOT_NONE;
	hl_ai_mon[s].squad_tried   = FALSE;
	hl_ai_mon[s].have_lastpos  = FALSE;
	hl_ai_mon[s].next_pain_snd = 0.0;
	hl_ai_mon[s].heard         = -1;
	hl_ai_mon[s].heard_type    = HLSOUND_NONE;
	hl_ai_mon[s].activity      = HLACT_IDLE;
	hl_ai_mon[s].act_seq       = -1;
	hl_ai_mon[s].next_blink    = 0.0;
	hl_ai_mon[s].gun_drawn     = FALSE;
	hl_ai_mon[s].in_cover      = FALSE;
	hl_ai_mon[s].fail_sched    = HLSCHED_FAIL;

	//m_cAmmoLoaded starts full, as CHGrunt::Spawn leaves it. The caller sets
	//kind before calling; a slot with none has no clip either
	hl_ai_mon[s].ammo = 0;

	if (hl_ai_mon[s].kind >= 0 && hl_ai_mon[s].kind < HLMON_COUNT)
		hl_ai_mon[s].ammo = hl_ai_mon_info[hl_ai_mon[s].kind].clip_size;

	HLVecSet(hl_ai_mon[s].enemy_pos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].goal, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].lastpos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].heard_pos, 0.0, 0.0, 0.0);
}

U0 HLAIMonRegisterAll()
{//claim a slot for every live monster in the entity table
 //
 //applies the parts of Spawn() the generic monster branch in HLEntSpawnOne
 //could not: the hull, and the health from gSkillData. The map's "health" key
 //is overwritten because every CBaseMonster::Spawn assigns pev->health from
 //gSkillData unconditionally and ignores the key.
	CHLEntity	*e;
	CHLMonInfo	*mi;
	I64			 i;
	I64			 kind;
	I64			 s;

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent  = -1;
		hl_ai_mon[i].kind = -1;
	}

	for (i = 0; i < HLENT_MAX; i++)
	{
		hl_ai_mon_of[i] = -1;

		HLAICineResetRow(i);
		HLAITalkResetRow(i);
	}

	hl_ai_mon_count = 0;
	hl_ai_talk_wait = 0.0;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_MONSTER)
			goto qamr_next;

		//no model: nothing to animate and no way to tell what it is.
		//HLEntLoadModels already failed on it, so leave it as scenery
		if (!e->studio)
			goto qamr_next;

		kind = HLAIMonKindFor(e->classname);

		if (kind < 0)
			goto qamr_next;

		if (hl_ai_mon_count >= HLAI_MON_MAX)
		{
			"HLAI: more than %d monsters, the rest are idle\n", HLAI_MON_MAX;
			goto qamr_done;
		}

		s  = hl_ai_mon_count;
		mi = &hl_ai_mon_info[kind];

		hl_ai_mon[s].ent  = i;
		hl_ai_mon[s].kind = kind;
		HLAIMonReset(s);

		hl_ai_mon[s].last_health   = mi->health;
		hl_ai_mon[s].ideal_yaw     = e->angles[1];
		hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
			ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));

		//staggered, so a roomful of monsters does not all Look on one tick
		hl_ai_mon[s].next_look = hl_ent_time +
			ToF64(s % 8) * (HLAI_LOOK_PERIOD / 8.0);

		hl_ai_mon_of[i] = s;
		hl_ai_mon_count++;

		//the parts of Spawn() the shared entity struct can carry
		HLVecCopy(mi->mins, e->mins);
		HLVecCopy(mi->maxs, e->maxs);
		HLEntSetAbsBox(e);

		e->health     = mi->health;
		e->max_health = mi->health;
		e->takedamage = HLDMG_TAKE_YES;

		//pitch and roll are not animated; a mapper-set pitch renders the
		//monster leaning over
		e->angles[0] = 0.0;
		e->angles[2] = 0.0;

qamr_next:
	}

qamr_done:
	if (hl_ai_mon_count)
		"HLAI: %d monsters\n", hl_ai_mon_count;
}

U0 HLAIMonSync()
{//re-register when the entity table has been rebuilt
 //
 //HLEntSpawnAll is in HLEntity.ZC and compiles first, so there is no per-map
 //hook and the change is detected instead. All three tests are needed: a fresh
 //CAlloc can land on the same address, an entity count can repeat across two
 //maps, and hl_ent_time restarting at zero is the one signal HLEntSpawnAll
 //always produces.
	if (hl_entities == hl_ai_mon_base && hl_num_entities == hl_ai_mon_ents &&
		hl_ent_time >= hl_ai_mon_clock)
	{
		hl_ai_mon_clock = hl_ent_time;
		return;
	}

	hl_ai_mon_base  = hl_entities;
	hl_ai_mon_ents  = hl_num_entities;
	hl_ai_mon_clock = hl_ent_time;

	HLAIMonRegisterAll;
}

//--- sensing ----------------------------------------------------------------

U0 HLAIPlayerOrigin(F64 *out)
{//the player's feet, which is what a monster's range checks compare against
 //
 //hl_origin lives in HL1.ZC and compiles later, so the position comes from
 //hl_snd_listener, the eye HL1.ZC hands the mixer every rendered frame. It
 //carries view bob and the step offset on top of HLAI_PLAYER_EYE, a couple of
 //units, immaterial at sighting range.
	HLVecCopy(hl_snd_listener, out);
	out[2] -= HLAI_PLAYER_EYE;
}

U0 HLAIMonEye(I64 s, F64 *out)
{//pev->origin + pev->view_ofs, where a monster's sight lines start
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
	{
		HLVecSet(out, 0.0, 0.0, 0.0);
		return;
	}

	HLVecCopy(e->origin, out);
	out[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;
}

Bool HLAITargetIsPlayer(I64 target)
{//the player is target -1; every other index is an entity
	return ToBool(target < 0);
}

Bool HLAITargetPos(I64 target, F64 *feet, F64 *eye)
{//where a target is and where to aim at it. FALSE when it is gone or dead, so
 //a monster stops shooting a corpse
	CHLEntity	*e;
	I64			 s;

	if (HLAITargetIsPlayer(target))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(feet);
		HLVecCopy(hl_snd_listener, eye);

		return TRUE;
	}

	e = HLEntGet(target);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = -1;

	if (target < HLENT_MAX)
		s = hl_ai_mon_of[target];

	if (s < 0)
		return FALSE;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return FALSE;

	HLVecCopy(e->origin, feet);
	HLVecCopy(e->origin, eye);
	eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

	return TRUE;
}

I64 HLAITargetClass(I64 target)
{//Classify() for either kind of target
	I64 s;

	if (HLAITargetIsPlayer(target))
		return HLCLASS_PLAYER;

	if (target < 0 || target >= HLENT_MAX)
		return HLCLASS_NONE;

	s = hl_ai_mon_of[target];

	if (s < 0)
		return HLCLASS_NONE;

	return hl_ai_mon_info[hl_ai_mon[s].kind].classify;
}

Bool HLAIInViewCone(I64 s, F64 *point)
{//FInViewCone: dot of the monster's facing with the direction to the point,
 //against m_flFieldOfView. A cosine, so -1.0 is all round.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 forward[3];
	F64			 ang[3];
	F64			 dir[3];

	if (!e)
		return FALSE;

	//yaw only. HL uses the full angle vector, but nothing here pitches a
	//monster and pev->angles as-is would let a mapper's stray pitch key
	//blind it
	HLVecSet(ang, 0.0, e->angles[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(point, e->origin, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return TRUE;

	return ToBool(HLVecDot(dir, forward) >=
		hl_ai_mon_info[hl_ai_mon[s].kind].fov);
}

Bool HLAIVisible(I64 s, F64 *target_eye)
{//FVisible: a point trace from eye to eye. Anything in the way blocks it
 //
 //HL also rejects a line crossing from air into water. CHLTrace reports both
 //contents, so that test is applied here too.
	CHLTrace	tr;
	F64			 eye[3];
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLAIMonEye(s, eye);
	HLVecSet(zero, 0.0, 0.0, 0.0);

	HLTraceEntity(hl_map, eye, target_eye, zero, zero, 0, TRUE, &tr);

	if (tr.in_open && tr.in_water)
		return FALSE;

	return ToBool(tr.fraction >= 1.0);
}

U0 HLAILook(I64 s)
{//CBaseMonster::Look plus BestVisibleEnemy, over the player and every live
 //monster: there is no entity list to walk with ALL_CONTENTS, so the candidates
 //are the only two things that can be a target.
 //
 //Deviation: BestVisibleEnemy returns only targets whose relationship is worse
 //than R_NONE, so a feared target never becomes m_hEnemy. With no sound sensing
 //that leaves a fleeing monster nothing to flee from, so fear counts here and
 //the schedule selector decides whether the enemy is charged or run from.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best      = -1;
	I64			 best_rel  = 0;
	I64			 rel;
	I64			 target;
	I64			 i;
	Bool		 found     = FALSE;

	if (!e)
		return;

	mi        = &hl_ai_mon_info[hl_ai_mon[s].kind];
	best_dist = mi->look_dist;

	//-1 is the player, then every entity index. One loop over both keeps the
	//player out of the scoring as a special case
	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qal_next;
		}
		else if (hl_ent_notarget)
		{
			//FL_NOTARGET: CBaseMonster::Look skips the player entirely, so it
			//is never seen and never becomes m_hEnemy.
			goto qal_next;
		}

		rel = HLAIRelationship(mi->classify, HLAITargetClass(target));

		if (rel == HLREL_NONE || rel == HLREL_ALLY)
			goto qal_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qal_next;

		HLVecSub(feet, e->origin, d);
		dist = HLVecLength(d);

		if (dist > mi->look_dist)
			goto qal_next;

		if (!HLAIInViewCone(s, feet))
			goto qal_next;

		if (!HLAIVisible(s, eye))
			goto qal_next;

		//BestVisibleEnemy's rule: a hated target beats a disliked one at any
		//range, and within one relationship the nearest wins.
		//
		//`found` rather than a sentinel in best_rel: R_NONE sits in the middle
		//of the R_* range, between R_FEAR and R_DISLIKE, so no value means
		//"nothing yet" and also compares correctly against fear
		if (found)
		{
			if (rel < best_rel)
				goto qal_next;

			if (rel == best_rel && dist >= best_dist)
				goto qal_next;
		}

		best      = target;
		best_rel  = rel;
		best_dist = dist;
		found     = TRUE;

qal_next:
		i++;
	}

	if (!found)
		return;

	hl_ai_mon[s].have_enemy = TRUE;
	hl_ai_mon[s].enemy      = best;
	hl_ai_mon[s].enemy_seen = hl_ent_time;

	if (HLAITargetPos(best, feet, eye))
		HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
}

//--- hearing ----------------------------------------------------------------
//
// CBaseMonster::Listen plus PBestSound, monsters.cpp. Listen builds a per
// monster audible list and PBestSound picks the nearest entry off it; with a
// 64-entry pool the two collapse into one walk that returns the nearest
// audible sound directly.
//
// A sound is audible when the distance to it is within its own radius scaled
// by the monster's HearingSensitivity, and when its type is in the monster's
// ISoundMask. Nothing here traces: HL's monsters hear through walls, which is
// what makes a gunshot in the next room pull a squad out of position.

I64 HLAIBestSound(I64 s)
{//PBestSound over the live entries, returning the pool index or -1
	CHLMonInfo	*mi;
	F64			 ear[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best = -1;
	I64			 i;

	if (hl_ai_mon[s].kind < 0)
		return -1;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//EarPosition() is the eye in CBaseMonster; only the tentacle overrides it
	HLAIMonEye(s, ear);

	//PBestSound's own starting bar
	best_dist = 8192.0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			goto qabs_next;

		if (!(hl_ai_snd[i].type & mi->sound_mask))
			goto qabs_next;

		HLVecSub(hl_ai_snd[i].origin, ear, d);
		dist = HLVecLength(d);

		//Listen's audibility test: the radius is scaled by the listener, not
		//by the source
		if (dist > hl_ai_snd[i].volume * mi->hear_sens)
			goto qabs_next;

		if (dist >= best_dist)
			goto qabs_next;

		best      = i;
		best_dist = dist;

qabs_next:
	}

	return best;
}

U0 HLAIListen(I64 s)
{//Listen: latch the best audible sound onto the slot
 //
 //the position is copied rather than kept as an index. A pool entry expires
 //while the monster is still walking to it, and a monster that forgets where
 //it was going mid-schedule stops dead in a corridor.
	I64 i;

	i = HLAIBestSound(s);

	if (i < 0)
	{
		hl_ai_mon[s].heard = -1;
		return;
	}

	hl_ai_mon[s].heard      = i;
	hl_ai_mon[s].heard_type = hl_ai_snd[i].type;

	HLVecCopy(hl_ai_snd[i].origin, hl_ai_mon[s].heard_pos);
}

//--- squads -----------------------------------------------------------------
//
// CSquadMonster, dlls/squadmonster.cpp. A squad is a leader and up to four
// members; the leader holds m_afSquadSlots, the set of behaviour bits the
// squad has handed out. A member takes a bit before running the behaviour it
// guards and gives it back when its schedule changes, so at most two grunts
// out of a fireteam are standing and firing at any moment and the rest are in
// cover or holding.
//
// EHANDLEs become slot indices: hl_ai_mon[s].squad is the leader's slot, and a
// leader points at itself. -1 is no squad.

Bool HLAIInSquad(I64 s)
{//InSquad: m_hSquadLeader is not NULL
	return ToBool(hl_ai_mon[s].squad >= 0);
}

I64 HLAISquadLeader(I64 s)
{//MySquadLeader, which returns the monster itself when it has no squad
	if (hl_ai_mon[s].squad < 0)
		return s;

	return hl_ai_mon[s].squad;
}

Bool HLAIIsLeader(I64 s)
{//IsLeader: m_hSquadLeader == this
	return ToBool(hl_ai_mon[s].squad == s);
}

I64 HLAISquadCount(I64 s)
{//SquadCount, callable from a leader or a follower
	I64 leader;
	I64 n = 0;
	I64 i;

	if (!HLAIInSquad(s))
		return 0;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && hl_ai_mon[i].state != HLMSTATE_DEAD)
			n++;
	}

	return n;
}

Bool HLAISquadEnemySplit(I64 s)
{//SquadEnemySplit: TRUE when the members are not all on one enemy
	I64		leader;
	I64		i;
	Bool	have;
	I64		want;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);
	have   = hl_ai_mon[leader].have_enemy;
	want   = hl_ai_mon[leader].enemy;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader)
			goto qaes_next;

		if (!hl_ai_mon[i].have_enemy)
			goto qaes_next;

		//a member fighting something the leader is not
		if (!have || hl_ai_mon[i].enemy != want)
			return TRUE;

qaes_next:
	}

	return FALSE;
}

Bool HLAIOccupySlot(I64 s, I64 desired)
{//OccupySlot: take one of the desired bits, or fail
	I64 leader;
	I64 mask;
	I64 i;

	//a monster with no squad answers to nobody and always succeeds
	if (!HLAIInSquad(s))
		return TRUE;

	if (HLAISquadEnemySplit(s))
	{
		//slots are disabled while the squad is split, so a member is not
		//stranded waiting for a bit held against a different enemy
		hl_ai_mon[s].my_slot = HLSLOT_SQUAD_SPLIT;
		return TRUE;
	}

	leader = HLAISquadLeader(s);

	//already holding one of them
	if (hl_ai_mon[s].my_slot & desired)
		return TRUE;

	//none of the desired bits are free
	if (!(desired & ~hl_ai_mon[leader].squad_slots))
		return FALSE;

	for (i = 0; i < HLAI_NUM_SLOTS; i++)
	{
		mask = 1 << i;

		if (!(desired & mask))
			goto qaos_next;

		if (hl_ai_mon[leader].squad_slots & mask)
			goto qaos_next;

		hl_ai_mon[leader].squad_slots |= mask;
		hl_ai_mon[s].my_slot = mask;

		return TRUE;

qaos_next:
	}

	return FALSE;
}

U0 HLAIVacateSlot(I64 s)
{//VacateSlot, called from ScheduleChange and from Killed
	I64 leader;

	if (hl_ai_mon[s].my_slot == HLSLOT_NONE || !HLAIInSquad(s))
	{
		hl_ai_mon[s].my_slot = HLSLOT_NONE;
		return;
	}

	leader = HLAISquadLeader(s);

	hl_ai_mon[leader].squad_slots &= ~hl_ai_mon[s].my_slot;
	hl_ai_mon[s].my_slot = HLSLOT_NONE;
}

Bool HLAISquadMemberInRange(I64 s, F64 *loc, F64 dist)
{//SquadMemberInRange: is any squadmate within dist of a spot, in 2D
	F64	d[3];
	I64	leader;
	I64	i;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasm_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qasm_next;

		HLVecSub(loc, hl_entities[hl_ai_mon[i].ent].origin, d);
		d[2] = 0.0;

		if (HLVecLength(d) <= dist)
			return TRUE;

qasm_next:
	}

	return FALSE;
}

Bool HLAIValidateCover(I64 s, F64 *cover)
{//FValidateCover: a spot another squad member is already standing on is not
 //cover. 128 is the SDK's spacing
	return ToBool(!HLAISquadMemberInRange(s, cover, 128.0));
}

Bool HLAINoFriendlyFire(I64 s)
{//NoFriendlyFire: is the line to the enemy clear of squadmates
 //
 //the SDK builds three planes around the firing line and tests every member
 //against them. The same question answered directly: a member is in the way
 //when it is in front, roughly along the line, and no further off it than a
 //hull width.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dir[3];
	F64			 rel[3];
	F64			 along;
	F64			 range;
	F64			 off;
	I64			 leader;
	I64			 i;

	if (!e || !HLAIInSquad(s) || !hl_ai_mon[s].have_enemy)
		return TRUE;

	HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, dir);
	dir[2] = 0.0;

	range = HLVecNormalize(dir);

	if (range <= 0.0)
		return TRUE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qanf_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qanf_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qanf_next;

		HLVecSub(hl_entities[hl_ai_mon[i].ent].origin, e->origin, rel);
		rel[2] = 0.0;

		along = HLVecDot(rel, dir);

		//behind the shooter, or past the target
		if (along <= 0.0 || along >= range)
			goto qanf_next;

		HLVecMA(rel, -along, dir, rel);

		off = HLVecLength(rel);

		//32 is a monster hull's half width plus slop, the width of the
		//SDK's left and right planes
		if (off < 32.0)
			return FALSE;

qanf_next:
	}

	return TRUE;
}

U0 HLAISquadAdd(I64 leader, I64 s)
{//SquadAdd: link one recruit to a leader
	if (hl_ai_mon[s].squad >= 0)
		return;

	hl_ai_mon[s].squad     = leader;
	hl_ai_mon[s].my_slot   = HLSLOT_NONE;
	hl_ai_mon[leader].squad = leader;
}

U0 HLAISquadRemove(I64 s)
{//SquadRemove plus SquadDisband. A leader that dies hands the squad to the
 //next surviving member rather than leaving four monsters pointing at a corpse
	I64 leader;
	I64 heir = -1;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	HLAIVacateSlot(s);

	leader = HLAISquadLeader(s);

	hl_ai_mon[s].squad = -1;

	if (leader != s)
		return;

	//the leader is leaving: find an heir
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && i != s &&
			hl_ai_mon[i].state != HLMSTATE_DEAD)
		{
			heir = i;
			goto qasr_found;
		}
	}

qasr_found:
	if (heir < 0)
	{
		//SquadDisband: nobody left, so unlink whatever still points here
		for (i = 0; i < hl_ai_mon_count; i++)
		{
			if (hl_ai_mon[i].squad == leader)
			{
				hl_ai_mon[i].squad   = -1;
				hl_ai_mon[i].my_slot = HLSLOT_NONE;
			}
		}

		return;
	}

	hl_ai_mon[heir].squad_slots = hl_ai_mon[leader].squad_slots;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader)
			hl_ai_mon[i].squad = heir;
	}

	hl_ai_mon[heir].squad = heir;
}

U0 HLAISquadMakeEnemy(I64 s, I64 enemy)
{//SquadMakeEnemy: point every member that is not already fighting at the same
 //target. This is what makes one grunt seeing the player turn the whole squad
	I64 leader;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasme_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qasme_next;

		//a member already engaged with this enemy, or with eyes on another
		//one, keeps what it has
		if (hl_ai_mon[i].have_enemy && hl_ai_mon[i].enemy == enemy)
			goto qasme_next;

		if (hl_ai_mon[i].have_enemy &&
			hl_ent_time - hl_ai_mon[i].enemy_seen <= HLAI_LOOK_PERIOD * 2.0)
			goto qasme_next;

		hl_ai_mon[i].have_enemy = TRUE;
		hl_ai_mon[i].enemy      = enemy;

		//the last known position comes from the member that saw it, not from
		//a fresh trace: the others have not looked yet
		HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[i].enemy_pos);

		//not enemy_seen: a member told about an enemy has not seen it, and
		//backdating the sight would let it shoot through a wall
		hl_ai_mon[i].enemy_seen = hl_ent_time - HLAI_LOSE_ENEMY * 0.5;

		//bits_COND_NEW_ENEMY: drop whatever it was doing and re-select
		hl_ai_mon[i].sched      = HLSCHED_NONE;
		hl_ai_mon[i].sched_done = TRUE;

		if (hl_ai_mon[i].state == HLMSTATE_IDLE)
			hl_ai_mon[i].state = HLMSTATE_ALERT;

qasme_next:
	}
}

I64 HLAISquadRecruit(I64 s, F64 radius, I64 max_members)
{//SquadRecruit: gather monsters of my own class into a squad, returning its
 //size. Called once, from the first think, as StartMonster does
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*re;
	F64			 my_eye[3];
	F64			 their_eye[3];
	F64			 d[3];
	I64			 count = 1;
	I64			 i;

	if (!e || hl_ai_mon[s].squad >= 0 || max_members < 2)
		return 0;

	//I am my own leader until somebody joins
	hl_ai_mon[s].squad       = s;
	hl_ai_mon[s].squad_slots = 0;

	HLAIMonEye(s, my_eye);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (count >= max_members)
			goto qasrc_done;

		if (i == s || hl_ai_mon[i].squad >= 0)
			goto qasrc_next;

		//same class only, and for the wildlife the same classname too: the
		//SDK will not put a headcrab and a houndeye in one pack
		if (hl_ai_mon[i].kind != hl_ai_mon[s].kind)
			goto qasrc_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD || hl_ai_mon[i].scripted)
			goto qasrc_next;

		re = HLEntGet(hl_ai_mon[i].ent);

		if (!re)
			goto qasrc_next;

		HLVecSub(re->origin, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qasrc_next;

		//SquadRecruit traces to the recruit and skips anyone it cannot see,
		//so a grunt does not join a squad through a wall
		HLAIMonEye(i, their_eye);

		if (!HLAIVisible(s, their_eye))
			goto qasrc_next;

		HLAISquadAdd(s, i);
		count++;

qasrc_next:
	}

qasrc_done:
	//no single-member squads
	if (count == 1)
	{
		hl_ai_mon[s].squad = -1;
		return 0;
	}

	return count;
}

//--- turning ----------------------------------------------------------------

F64 HLAIYawTo(F64 *from, F64 *to)
{//UTIL_VecToYaw for the direction between two points
	F64 d[3];

	HLVecSub(to, from, d);
	d[2] = 0.0;

	if (HLVecNormalize(d) <= 0.0)
		return 0.0;

	return Arg(d[0], d[1]) / HLDEG2RAD;
}

F64 HLAIYawDiff(F64 want, F64 have)
{//shortest signed arc between two yaws, degrees. Turning by the raw difference
 //spins a monster the long way round through 359 degrees
	F64 d = HLAngleNorm(want) - HLAngleNorm(have);

	if (d > 180.0)
		d -= 360.0;

	if (d < -180.0)
		d += 360.0;

	return d;
}

Bool HLAITurnToward(I64 s, F64 want, F64 dt)
{//ChangeYaw: step pev->angles towards ideal_yaw at yaw_speed. TRUE once within
 //HLAI_FACE_TOL, which is what the facing tasks wait on
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 diff;
	F64			 step;

	if (!e)
		return TRUE;

	hl_ai_mon[s].ideal_yaw = HLAngleNorm(want);

	diff = HLAIYawDiff(want, e->angles[1]);
	step = hl_ai_mon_info[hl_ai_mon[s].kind].yaw_speed * dt;

	if (diff < 0.0)
	{
		if (step > -diff)
			step = -diff;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > diff)
			step = diff;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}

	if (diff < 0.0)
		diff = -diff;

	return ToBool(diff <= HLAI_FACE_TOL);
}

//--- movement ---------------------------------------------------------------
//
// CBaseMonster::Move, MoveExecute, CheckLocalMove and FTriangulate,
// dlls/monsters.cpp:1798, :1980, :1300 and :1626.
//
// The SDK's Move walks m_Route, which CGraph filled. There is no node graph
// here, so the route is the goal plus at most one triangulated apex. Everything
// below the route is the SDK's: the same 16-unit hop, the same lift-carry-drop
// step, the same 200-unit lookahead, the same eight-iteration apex search. A
// monster still cannot route around a room, but it no longer enters geometry.

#define HLAI_MOVE_OK		0
#define HLAI_MOVE_ARRIVED	1
#define HLAI_MOVE_BLOCKED	2

//LOCALMOVE_*, monsters.h:28-30
#define HLAI_LM_INVALID		0
#define HLAI_LM_NOTRI		1
#define HLAI_LM_VALID		2

#define HLAI_LOCAL_STEP		16.0	//LOCAL_STEP_SIZE, monsters.cpp:1299
#define HLAI_DIST_CHECK		200.0	//DIST_TO_CHECK, monsters.cpp:1796
#define HLAI_MOVE_CHECK		0.1		//CBaseMonster::MonsterThink's interval

Bool HLAIDropToFloor(CHLEntity *e, F64 *pos, F64 *out)
{//CheckLocalMove's floor test. Probe up HLAI_STEP_HEIGHT for headroom, then
 //down three times that for a floor, and refuse the move when there is none:
 //nothing integrates gravity for a STEP entity here, so without this a monster
 //walks off a catwalk and keeps walking through the air.
	CHLTrace	tr;
	F64			 up[3];
	F64			 down[3];

	HLVecCopy(pos, up);
	up[2] += HLAI_STEP_HEIGHT;

	//the step up must clear a ceiling first, or the down trace starts inside
	//solid and reports the whole sweep as blocked
	HLTraceEntity(hl_map, pos, up, e->mins, e->maxs, 0, TRUE, &tr);
	HLVecCopy(tr.end_pos, up);

	HLVecCopy(up, down);
	down[2] -= HLAI_STEP_HEIGHT * 3.0;

	HLTraceEntity(hl_map, up, down, e->mins, e->maxs, 0, TRUE, &tr);

	//no floor inside a step and a fall of one more step: a ledge
	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

Bool HLAIStepTo(I64 s, F64 *from, F64 *to, F64 *out)
{//SV_movestep, which is what the engine's WALK_MOVE runs: lift by one step
 //height, carry the box across, drop two step heights onto a floor. FALSE is
 //WALKMOVE_CHECKONLY failing - a step too tall, nothing to land on, or
 //something solid in between. Every mover below is built on this.
 //
 //Destination and source are at the same height in every caller: the direction
 //is flattened before the hop is taken.
 //
 //Deviation: SV_movestep does not sweep the horizontal leg, it traces straight
 //down at the destination, which is why CheckLocalMove and MoveExecute both cap
 //the hop at 16 units. The leg is swept here too. A monster cutting the corner
 //of a doorframe is what the destination-only test misses, and the sweep is one
 //trace.
 //
 //A trace that begins embedded reports the whole sweep clear: HLTraceEntity
 //returns on all_solid before any entity pass, HLClip.ZC:618, leaving
 //HLTraceInit's fraction of 1.0 and end_pos on the far end, HLClip.ZC:181-188.
 //Taken at face value that walks a stuck monster through the wall it is stuck
 //in, so all_solid and start_solid both refuse the step.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 up[3];
	F64			 over[3];
	F64			 down[3];
	Bool		 ok = FALSE;

	if (!e || !hl_map)
		return FALSE;

	//the sweep clips the box solids as well, so a monster is stopped by another
	//monster and by the player. hl_ent_clip_ignore keeps it out of its own box
	//and is lowered again on every exit: left raised, the player stays solid to
	//everything that traces afterwards, HLEntity.ZC:1094-1097
	hl_ent_clip_ignore = hl_ai_mon[s].ent;

	//a MOVETYPE_FLY monster holds the height it is given. There is no floor
	//under a controller
	if (hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		HLTraceEntity(hl_map, from, to, e->mins, e->maxs, 0, FALSE, &tr);

		if (!tr.all_solid && !tr.start_solid && tr.fraction >= 1.0)
		{
			HLVecCopy(to, out);
			ok = TRUE;
		}

		hl_ent_clip_ignore = -1;

		return ok;
	}

	HLVecCopy(from, up);
	up[2] += HLAI_STEP_HEIGHT;

	HLVecCopy(to, over);
	over[2] = up[2];

	HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

	if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
	{
		//the lift put the box in a ceiling. SV_movestep drops it by one step
		//and retries flat, which is how a monster crosses a low crawlspace
		up[2]   = from[2];
		over[2] = from[2];

		HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

		if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
		{
			hl_ent_clip_ignore = -1;
			return FALSE;
		}
	}

	//two step heights down from one step up: a net fall of one step, the drop
	//the engine lets a monster walk off
	HLVecCopy(over, down);
	down[2] -= HLAI_STEP_HEIGHT * 2.0;

	HLTraceEntity(hl_map, over, down, e->mins, e->maxs, 0, FALSE, &tr);

	hl_ent_clip_ignore = -1;

	if (tr.all_solid || tr.start_solid)
		return FALSE;

	//nothing to land on within a step: walked off an edge
	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

I64 HLAICheckLocalMove(I64 s, F64 *start, F64 *end, F64 *_dist)
{//::CheckLocalMove, monsters.cpp:1300. Walk the straight line in
 //LOCAL_STEP_SIZE hops; *_dist is how far it got, which FTriangulate needs to
 //place its apex past the obstruction.
 //
 //Deviation: the SDK carries the monster along the line with UTIL_SetOrigin and
 //undoes the move afterwards, monsters.cpp:1316 and :1397. The walk here is on
 //a local position and the entity never moves, so no trace observes the probe.
 //
 //The pTarget case, "if this step hits target ent the move is legal",
 //monsters.cpp:1356-1361, has no counterpart: callers pass a position rather
 //than an entity, and the goal tolerance already stops the monster short of a
 //body.
	F64	at[3];
	F64	to[3];
	F64	dir[3];
	F64	dist;
	F64	walked;
	F64	size;

	if (_dist)
		*_dist = 0.0;

	HLVecSub(end, start, dir);
	dir[2] = 0.0;

	dist = HLVecNormalize(dir);

	if (dist <= 0.0)
		return HLAI_LM_VALID;

	HLVecCopy(start, at);

	walked = 0.0;

	while (walked < dist)
	{
		size = HLAI_LOCAL_STEP;

		//the last hop stops one unit short of the goal, monsters.cpp:1344-1345
		if (walked + HLAI_LOCAL_STEP >= dist - 1.0)
			size = (dist - walked) - 1.0;

		if (size <= 0.0)
			goto qclm_done;

		HLVecMA(at, size, dir, to);

		if (!HLAIStepTo(s, at, to, at))
		{
			if (_dist)
				*_dist = walked;

			return HLAI_LM_INVALID;
		}

		walked += HLAI_LOCAL_STEP;
	}

qclm_done:
	if (_dist)
		*_dist = dist;

	//"the monster can move to a spot UNDER the target, but not to it",
	//monsters.cpp:1375-1382. 64 is the SDK's own constant, chosen because
	//pev->size.z is wrong for a headcrab. Triangulating out of this only walks
	//the same line again
	if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		if (end[2] - at[2] > 64.0 || at[2] - end[2] > 64.0)
			return HLAI_LM_NOTRI;
	}

	return HLAI_LM_VALID;
}

Bool HLAITriangulate(I64 s, F64 *start, F64 *end, F64 dist, F64 *apex)
{//::FTriangulate, monsters.cpp:1626. Probe an apex either side of the
 //obstruction and take the first from which the goal is still reachable.
 //
 //vecFarSide is m_Route[m_iRouteIndex].vecLocation, monsters.cpp:1668; with no
 //route that is the goal itself.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 fwd[3];
	F64			 side[3];
	F64			 rise[3];
	F64			 ahead[3];
	F64			 left[3];
	F64			 right[3];
	F64			 top[3];
	F64			 bottom[3];
	F64			 push[3];
	F64			 pushz[3];
	F64			 size_x;
	F64			 size_z;
	Bool		 flies;
	I64			 i;

	if (!e)
		return FALSE;

	flies = hl_ai_mon_info[hl_ai_mon[s].kind].flies;

	//CheckLocalMove works in 16-unit hops and the SDK clamps the apex offset to
	//[24, 48] regardless of hull, monsters.cpp:1638-1644
	size_x = e->maxs[0] - e->mins[0];

	if (size_x < 24.0)
		size_x = 24.0;
	else if (size_x > 48.0)
		size_x = 48.0;

	size_z = e->maxs[2] - e->mins[2];

	HLVecSub(end, start, fwd);

	if (HLVecNormalize(fwd) <= 0.0)
		return FALSE;

	HLVecSet(rise, 0.0, 0.0, 1.0);
	HLVecCross(fwd, rise, side);

	//one hull width past the obstruction so the turn back onto course clears
	//it, three hull widths out to the side, monsters.cpp:1660-1661
	HLVecMA(start, dist + size_x, fwd, ahead);

	HLVecMA(ahead, -(size_x * 3.0), side, left);
	HLVecMA(ahead, size_x * 3.0, side, right);

	//over and under, for a flier only, monsters.cpp:1662-1665
	HLVecMA(start, dist, fwd, ahead);
	HLVecMA(ahead, size_z * 3.0, rise, top);
	HLVecMA(ahead, -(size_z * 3.0), rise, bottom);

	HLVecScale(side, size_x * 2.0, push);
	HLVecScale(rise, size_z * 2.0, pushz);

	for (i = 0; i < 8; i++)
	{
		if (HLAICheckLocalMove(s, start, right, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, right, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(right, apex);
				return TRUE;
			}
		}

		if (HLAICheckLocalMove(s, start, left, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, left, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(left, apex);
				return TRUE;
			}
		}

		if (flies)
		{
			if (HLAICheckLocalMove(s, start, top, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, top, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(top, apex);
					return TRUE;
				}
			}

			if (HLAICheckLocalMove(s, start, bottom, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, bottom, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(bottom, apex);
					return TRUE;
				}
			}
		}

		HLVecAdd(right, push, right);
		HLVecSub(left, push, left);

		if (flies)
		{
			HLVecAdd(top, pushz, top);
			HLVecSub(bottom, pushz, bottom);
		}
	}

	return FALSE;
}

F64 HLAIGroundSpeed(I64 s, F64 fallback)
{//m_flGroundSpeed. GetSequenceInfo derives it from the distance studiomdl baked
 //into the sequence, animating.cpp:114, so the feet match the ground. The table
 //figure is two to five times wrong - a scientist walk is 58.75 u/s derived
 //against 40 in the table - and the difference is the feet sliding.
 //
 //The fallback covers a sequence that carries no linear movement.
 //monsters.cpp:1953 and :1987 both divide by this and must never see zero
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 gs;

	if (e && e->studio)
	{
		gs = HLStudioSeqGroundSpeed(e->studio, e->seq);

		if (gs > 0.0)
			return gs;
	}

	return fallback;
}

I64 HLAIMoveStep(I64 s, F64 speed, F64 dt)
{//::Move plus ::MoveExecute, monsters.cpp:1798 and :1980, for one tick
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 way[3];
	F64			 dir[3];
	F64			 at[3];
	F64			 to[3];
	F64			 apex[3];
	F64			 dist;
	F64			 tol;
	F64			 check;
	F64			 hit;
	F64			 ground;
	F64			 total;
	F64			 sub;
	F64			 moved;
	I64			 local;

	if (!e || !hl_map || !hl_ai_mon[s].have_goal)
		return HLAI_MOVE_BLOCKED;

	//m_Route reduced to the goal plus at most one detour. FTriangulate's apex
	//is inserted in front of the goal, monsters.cpp:1901-1903
	tol = hl_ai_mon[s].goal_tol;

	if (hl_ai_mon[s].have_detour)
	{
		HLVecCopy(hl_ai_mon[s].detour, way);

		//an apex is a waypoint, not the destination, so it is left behind at
		//MONSTER_CUT_CORNER_DIST rather than at the task's own tolerance -
		//which is 128 units for a follow, wide enough to skip the detour
		//entirely. monsters.cpp:37 and :1968-1977
		tol = 8.0;
	}
	else
		HLVecCopy(hl_ai_mon[s].goal, way);

	HLVecSub(way, e->origin, dir);
	dir[2] = 0.0;

	dist = HLVecNormalize(dir);

	if (dist <= tol)
	{
		if (!hl_ai_mon[s].have_detour)
			return HLAI_MOVE_ARRIVED;

		//AdvanceRoute: the apex is behind us, aim at the goal again this tick
		hl_ai_mon[s].have_detour = FALSE;

		HLVecCopy(hl_ai_mon[s].goal, way);

		HLVecSub(way, e->origin, dir);
		dir[2] = 0.0;

		dist = HLVecNormalize(dir);

		if (dist <= hl_ai_mon[s].goal_tol)
			return HLAI_MOVE_ARRIVED;
	}

	ground = HLAIGroundSpeed(s, speed);

	if (ground <= 0.0)
		return HLAI_MOVE_OK;

	//--- lookahead, monsters.cpp:1851-1874 ---
	//
	//throttled to CBaseMonster::MonsterThink's own 0.1s interval rather than run
	//per server tick: this walks up to 200 units in 16-unit hops and every hop
	//costs two hull sweeps
	if (hl_ent_time >= hl_ai_mon[s].next_move_check)
	{
		hl_ai_mon[s].next_move_check = hl_ent_time + HLAI_MOVE_CHECK;

		check = HLAI_DIST_CHECK;

		if (dist < check)
			check = dist;

		HLVecMA(e->origin, check, dir, to);

		hit   = 0.0;
		local = HLAICheckLocalMove(s, e->origin, to, &hit);

		if (local != HLAI_LM_VALID)
		{
			//nothing further to try: the SDK falls back to the node graph here
			//and there is none
			if (local == HLAI_LM_NOTRI)
				return HLAI_MOVE_BLOCKED;

			if (!HLAITriangulate(s, e->origin, way, hit, apex))
				return HLAI_MOVE_BLOCKED;

			hl_ai_mon[s].have_detour = TRUE;
			HLVecCopy(apex, hl_ai_mon[s].detour);

			HLVecSub(apex, e->origin, dir);
			dir[2] = 0.0;

			dist = HLVecNormalize(dir);

			if (dist <= 0.0)
				return HLAI_MOVE_BLOCKED;
		}
	}

	//--- MoveExecute, monsters.cpp:1987-1995 ---
	//
	//"don't walk more than 16 units or stairs stop working": each hop lifts a
	//step height and drops again, and a longer hop steps over the tread
	total = ground * dt;

	if (total > dist)
		total = dist;

	HLVecCopy(e->origin, at);

	while (total > 0.001)
	{
		sub = HLAI_LOCAL_STEP;

		if (sub > total)
			sub = total;

		HLVecMA(at, sub, dir, to);

		if (!HLAIStepTo(s, at, to, at))
			goto qms_moved;

		total -= sub;
	}

qms_moved:
	HLVecSub(at, e->origin, to);
	to[2] = 0.0;
	moved = HLVecLength(to);

	HLVecCopy(at, e->origin);
	HLEntSetAbsBox(e);

	//stuck detection. A monster grinding on geometry makes almost no ground per
	//tick; after HLAI_STUCK_TIME the path task fails and the state machine picks
	//something else. The SDK has no equivalent - it has a node graph
	if (moved < ground * dt * 0.2)
	{
		if (hl_ai_mon[s].stuck_since <= 0.0)
			hl_ai_mon[s].stuck_since = hl_ent_time;
		else if (hl_ent_time - hl_ai_mon[s].stuck_since >= HLAI_STUCK_TIME)
			return HLAI_MOVE_BLOCKED;
	}
	else
		hl_ai_mon[s].stuck_since = 0.0;

	return HLAI_MOVE_OK;
}

//--- cover ------------------------------------------------------------------
//
// CBaseMonster::FindLateralCover and FindCover, monsters.cpp. The SDK tries
// lateral cover first - step sideways along the plane through the monster,
// testing whether the threat can still see the spot - and only falls back to
// CGraph's node cover when that fails. There is no graph here, so the lateral
// pass is the whole of it, widened to a ring of directions so a monster backed
// into a corner has somewhere to go.
//
// A candidate is cover when the threat has no line to a point at eye height
// above it, the monster can stand there, and no squadmate is already using it
// (FValidateCover).

#define HLAI_COVER_STEPS	8		//directions sampled around the monster
#define HLAI_COVER_RANGE	3		//how many distances out each direction
#define HLAI_COVER_STEP		96.0	//COVER_DELTA, the SDK's lateral step

Bool HLAICoverSpotOk(I64 s, F64 *spot, F64 *threat, Bool need_hidden)
{//one candidate: standable, out of sight of the threat, clear of squadmates
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 floor[3];
	F64			 eye[3];
	F64			 zero[3];

	if (!e || !hl_map)
		return FALSE;

	//nothing integrates gravity for a STEP entity, so a spot with no floor
	//under it is not a spot
	if (!HLAIDropToFloor(e, spot, floor))
		return FALSE;

	//the monster has to be able to get there. One straight sweep, which is
	//all the movement code can do anyway
	HLTraceEntity(hl_map, e->origin, floor, e->mins, e->maxs, 0, TRUE, &tr);

	if (tr.fraction < 1.0)
		return FALSE;

	if (need_hidden)
	{
		//FVisible from the threat to where the monster's eyes would be
		HLVecCopy(floor, eye);
		eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

		HLVecSet(zero, 0.0, 0.0, 0.0);

		HLTraceEntity(hl_map, threat, eye, zero, zero, 0, TRUE, &tr);

		//still in the open
		if (tr.fraction >= 1.0)
			return FALSE;
	}

	if (!HLAIValidateCover(s, floor))
		return FALSE;

	HLVecCopy(floor, spot);

	return TRUE;
}

Bool HLAIFindCover(I64 s, F64 *threat, Bool need_hidden, F64 *out)
{//FindLateralCover: sample a ring of directions at increasing distance and
 //take the first spot the threat cannot see. TRUE and out is the spot.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 away[3];
	F64			 dir[3];
	F64			 spot[3];
	F64			 base;
	F64			 ang;
	I64			 step;
	I64			 ring;
	I64			 turn;

	if (!e)
		return FALSE;

	//directly away from the threat is the first thing tried, so a monster
	//breaking contact does not sidestep into it
	HLVecSub(e->origin, threat, away);
	away[2] = 0.0;

	if (HLVecNormalize(away) <= 0.0)
		HLVecSet(away, 1.0, 0.0, 0.0);

	base = Arg(away[0], away[1]) / HLDEG2RAD;

	for (ring = 1; ring <= HLAI_COVER_RANGE; ring++)
	{
		for (step = 0; step < HLAI_COVER_STEPS; step++)
		{
			//alternate either side of "away" rather than sweeping one way
			//round: the SDK tries left then right at each distance
			//arithmetic is F64 here, so the halving is truncated explicitly
			//rather than relying on the assignment to do it
			turn = ToI64(ToF64(step + 1) / 2.0);

			if (step & 1)
				ang = base + ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));
			else
				ang = base - ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));

			HLVecSet(dir, Cos(ang * HLDEG2RAD), Sin(ang * HLDEG2RAD), 0.0);
			HLVecMA(e->origin, ToF64(ring) * HLAI_COVER_STEP, dir, spot);

			if (HLAICoverSpotOk(s, spot, threat, need_hidden))
			{
				HLVecCopy(spot, out);
				return TRUE;
			}
		}
	}

	return FALSE;
}

//--- attacks ----------------------------------------------------------------

U0 HLAIMonSound(I64 s, U8 *path)
{//at the monster's own position, on the channel HLEntity.ZC reserves for entity
 //speech, so a new line cuts the previous one
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !path || !path[0])
		return;

	HLSndPlayAt(path, e->origin, 1.0, HLENT_SND_ATTEN, 0, HLENT_CHAN_USE);
}

U0 HLDmgHurt(I64 target, I64 attacker, F64 damage, I64 bits)
{//HLEntTakeDamageType with the hit recorded for the monster death path.
 //
 //this sits in HLAI rather than beside HLDmgNote because HLPart compiles at 79
 //and HLEntTakeDamageType does not exist until HLEntity at 93. HLAI is 95 and
 //HLWeapon is 97, so this is the first file that can wrap it for both
	CHLEntity	*e = HLEntGet(target);
	F64			 left;

	if (damage <= 0.0)
		return;

	left = 0.0;

	if (e)
		left = e->health - damage;

	HLDmgNote(target, bits, left);
	HLEntTakeDamageType(target, attacker, damage, bits);
}

U0 HLAIHurt(I64 target, I64 attacker, F64 damage, I64 bits = HLDMG_GENERIC)
{//one damage call for either kind of target. The player's health lives in
 //HLEntity.ZC's native player state, a monster's in its entity slot
 //
 //bits is bitsDamageType. The player path drops it: hl_ent_player_health has no
 //gib rule and no time-based accumulator behind it
	if (damage <= 0.0)
		return;

	if (HLAITargetIsPlayer(target))
	{
		HLEntHurtPlayer(damage);
		return;
	}

	HLDmgHurt(target, attacker, damage, bits);
}

U0 HLAIBlastDamage(I64 s, F64 radius, F64 damage)
{//RadiusDamage without falloff or a line-of-sight test. The only user is the
 //houndeye's sonic blast, which in the SDK is UTIL_MonstersInSphere plus a flat
 //gSkillData figure and passes through cover by design.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 mine;
	I64			 target;
	I64			 i;

	if (!e)
		return;

	mine   = hl_ai_mon_info[hl_ai_mon[s].kind].classify;
	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qabd_next;
		}

		//a blast respects the relationship table: houndeyes do not hurt
		//each other
		if (HLAIRelationship(mine, HLAITargetClass(target)) <= HLREL_NONE)
			goto qabd_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qabd_next;

		HLVecSub(feet, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qabd_next;

		//DMG_SONIC|DMG_ALWAYSGIB, dlls/houndeye.cpp:663 - the blast takes a
		//victim apart whatever the overkill
		HLAIHurt(target, hl_ai_mon[s].ent, damage,
			HLDMG_SONIC | HLDMG_ALWAYSGIB);

qabd_next:
		i++;
	}
}

U0 HLAIAttackNoise(I64 s)
{//CSoundEnt::InsertSound(bits_SOUND_COMBAT, ...) from an attack event
 //
 //hgrunt.cpp's HGRUNT_AE_BURST1 inserts one at 384 units for 0.3 seconds; the
 //other armed monsters make the same call at their own radius. This is what
 //draws a second squad to a firefight.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->attack_noise <= 0.0)
		return;

	HLAIInsertSound(HLSOUND_COMBAT, e->origin, mi->attack_noise, 0.3);
}

Bool HLAIHullAttack(I64 s, F64 reach, F64 damage, I64 bits = HLDMG_SLASH)
{//CheckTraceHullAttack, dlls/combat.cpp:1133: sweep a hull forward from the eye
 //and damage whatever it meets
 //
 //the SDK traces a hull and hits whatever edict it finds. There are no edicts
 //here, so the sweep is replaced by the same range and cone test the SDK's
 //hull would have produced against the one target that matters. TRUE when it
 //connected, which is what decides the hit or miss foley.
 //
 //iDmgType is DMG_SLASH at seven of the eleven SDK call sites, so it is the
 //default; the punches and the whip name their own
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	I64			 blood;
	I64			 vs;

	if (!e || !hl_ai_mon[s].have_enemy)
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (dist > reach)
		return FALSE;

	//the hull sweeps forward, so something behind the monster is not hit
	if (!HLAIInViewCone(s, feet))
		return FALSE;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, damage, bits);

	//CBaseMonster::TraceAttack ends in SpawnBlood(vecSpot, BloodColor(),
	//flDamage), which is UTIL_BloodDrips along the reverse of the attack
	//direction, in the victim's own m_bloodColor
	blood = HLBLOOD_RED;

	if (!HLAITargetIsPlayer(hl_ai_mon[s].enemy))
	{
		vs = hl_ai_mon_of[hl_ai_mon[s].enemy];

		if (vs >= 0 && hl_ai_mon[vs].kind >= 0)
			blood = hl_ai_mon_info[hl_ai_mon[vs].kind].blood;
	}

	HLVecNormalize(d);
	d[2] = 0.0;

	//tS, not hl_ent_time: HLPartUpdate and HLPartDraw run on the render
	//clock, so an effect stamped with the server clock expires on the wrong
	//one.
	HLFxBloodDrips(eye, d, blood, ToI64(damage), tS);

	return TRUE;
}

Bool HLAIMuzzlePos(I64 s, F64 *out)
{//GetAttachment(0, ...) - attachment 0 is the gun on every armed monster in the
 //SDK: hgrunt.cpp:284 drops the weapon from it, agrunt.cpp:941 launches hornets
 //from it, and the engine hangs EF_MUZZLEFLASH off the same point.
 //
 //FALSE when the model carries no attachment, in which case the caller keeps
 //GetGunPosition's eye. The pose is the one HL1.ZC draws this entity in -
 //e->controllers, blend 0 - so the muzzle sits where the barrel is drawn
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !e->studio)
		return FALSE;

	if (HLStudioAttachCount(e->studio) < 1)
		return FALSE;

	return HLStudioAttachment(e->studio, e->origin, e->angles, e->seq,
		HLAIEntityCycle(e), 0.0, 0, out, e->controllers, 0.0);
}

U0 HLAIGunPos(I64 s, F64 *out)
{//where a monster's round leaves it. Studio attachment 0 when the model has
 //one, CBaseMonster::GetGunPosition's origin + view_ofs otherwise
	if (HLAIMuzzlePos(s, out))
		return;

	HLAIMonEye(s, out);
}

U0 HLAIMuzzleFlash(I64 s)
{//pev->effects |= EF_MUZZLEFLASH - hgrunt.cpp:803, barney.cpp:353,
 //agrunt.cpp:445, hassassin.cpp:229, turret.cpp:623
 //
 //R_MuzzleFlash type 1 carries no scale byte, so the sprite is drawn at the
 //0.5 default
	F64 muzzle[3];

	if (!HLAIMuzzlePos(s, muzzle))
		return;

	HLFxMuzzleFlash(muzzle, 0.5, tS);
}

Bool HLAITracerDue()
{//combat.cpp:1405. iTracerFreq is 4 for a monster (cbase.h:255) and hgrunt,
 //barney and the hassassin all take that default; only the shotgun grunt passes
 //0. The counter steps once per round fired, world wide
	Bool due;

	due = ToBool((hl_ai_tracer_count % 4) == 0);
	hl_ai_tracer_count++;

	return due;
}

U0 HLAIFireAttack(I64 s, Bool melee)
{//land the hit for a monster whose model carries no event for it
 //
 //the SDK fires on an animation event inside the sequence (mstudioevent_t,
 //HandleAnimEvent), which HLAIMonEvents below now reproduces. This remains the
 //path for a sequence with no event in it and for the blast attacks, which the
 //SDK also applies from a single event.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 dmg;
	F64			 src[3];
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (melee)
	{
		//25% slop over the reach used to choose the attack, so an enemy backing
		//away at walking pace does not dodge every swing by an inch
		HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		return;
	}

	HLAIAttackNoise(s);

	if (mi->blast_radius > 0.0)
	{
		HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
		return;
	}

	//hitscan. FireBullets with no cone: the SDK's per-weapon spread values are
	//small enough that at these ranges they decide misses, not damage, and there
	//is no hit-group table to spread damage across.
	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (dist > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	//the burst is applied as one call here, so it draws the one tracer the
	//counter is due rather than one per round
	if (tracer)
		HLFxTracer(src, eye, tS);

	dmg = mi->range_dmg * ToF64(mi->range_bullets);

	//DMG_BULLET | (iDamage > 16 ? DMG_ALWAYSGIB : DMG_NEVERGIB),
	//dlls/combat.cpp:1445. iDamage is the round, not the burst, so the test is
	//on range_dmg and not on the product
	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, dmg, bits);
}

//--- animation events -------------------------------------------------------
//
// HandleAnimEvent. Every attack in HL lands on an mstudioevent_t embedded in
// the attack sequence at the frame the claw or the muzzle actually reaches the
// target, not at the end of the take: a zombie's swing connects on frame 10 of
// 36 and the remaining 26 frames are the follow-through, which the enemy can
// walk out of.
//
// Codes below 1000 are client-side effects. 1000..1999 are the shared script
// events CBaseMonster::HandleAnimEvent interprets. 2000..2999 are shared
// monster events - body drops and weapon swishes. Everything below 100 is
// per-monster and means nothing without knowing which monster is playing it,
// which is why the dispatch is on (kind, code).
//
// Placed here rather than beside HLAIEntityEvents at the top of the file
// because it reaches the monster table, the damage path and the sound list,
// none of which exist that early: ZealC is single-pass.

//scriptevent.h. HLStudio.ZC names 1004/1005/1008 but its HLST_EV_SENTENCE_RND1
//is 1010, which is SCRIPT_EVENT_NOT_DEAD; the group form is 1009.
#define HLAI_EV_DEAD			1000
#define HLAI_EV_NOINTERRUPT		1001
#define HLAI_EV_CANINTERRUPT	1002
#define HLAI_EV_FIREEVENT		1003
#define HLAI_EV_SOUND			1004
#define HLAI_EV_SENTENCE		1005
#define HLAI_EV_INAIR			1006
#define HLAI_EV_ENDANIMATION	1007
#define HLAI_EV_SOUND_VOICE		1008
#define HLAI_EV_SENTENCE_RND1	1009
#define HLAI_EV_NOT_DEAD		1010

//monsterevent.h
#define HLAI_EV_BODYDROP_LIGHT	2001
#define HLAI_EV_BODYDROP_HEAVY	2002
#define HLAI_EV_SWISHSOUND		2010

//CheckTraceHullAttack's reach for every humanoid claw in the SDK
#define HLAI_HULL_REACH			70.0

U0 HLAIShootOnce(I64 s)
{//one round of a burst. CBaseMonster::FireBullets for a single bullet
 //
 //the SDK traces a bullet with a per-weapon cone and applies the damage where
 //it lands. There is no hit-group table here, so a bullet that has line of
 //sight to the enemy hits it for the row's per-bullet figure.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 src[3];
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//m_cAmmoLoaded, spent whether or not the round connects
	if (mi->clip_size > 0 && hl_ai_mon[s].ammo > 0)
		hl_ai_mon[s].ammo--;

	//Shoot() flashes and steps the tracer counter before the trace, so a round
	//into a wall still shows both
	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLVecSub(feet, e->origin, d);

	if (HLVecLength(d) > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	//TE_TRACER, combat.cpp:1427. The SDK draws it to tr.vecEndPos whether or not
	//the round reached anything; there is no bullet trace on this path, so it is
	//drawn only for a round with a clear sight line and never crosses a wall
	if (tracer)
		HLFxTracer(src, eye, tS);

	//one round, so combat.cpp:1445's bits apply directly
	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, mi->range_dmg, bits);
}

U0 HLAIClawFoley(I64 s, Bool hit)
{//the hit and miss sounds every claw event plays. zombie.cpp's
 //pAttackHitSounds / pAttackMissSounds, which islave.cpp reuses verbatim
	if (hit)
		HLAIMonSound(s, "zombie/claw_strike1.wav");
	else
		HLAIMonSound(s, "zombie/claw_miss1.wav");
}

U0 HLAIBodyDrop(I64 s, Bool heavy)
{//MONSTER_EVENT_BODYDROP_LIGHT / _HEAVY. Both pick between the same two
 //samples; the heavy form drops the pitch to 90, which this mixer path cannot
 //express, so the two differ only in the volume
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 vol = 1.0;

	if (!e)
		return;

	if (heavy)
		vol = 1.0;
	else
		vol = 0.8;

	if (HLPartRandI(2))
		HLSndPlayAt("common/bodydrop3.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);
	else
		HLSndPlayAt("common/bodydrop4.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);

	//a body hitting the floor is a world sound. CSoundEnt has no such call in
	//the SDK, but bits_SOUND_CARCASS is what a bullsquid comes to eat
	HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);
}

Bool HLAISharedEvent(I64 s, CHLEntity *e, I64 self, I64 code, U8 *options)
{//CBaseMonster::HandleAnimEvent, the base every monster falls through to.
 //TRUE when the code was consumed.
	if (code == HLAI_EV_DEAD)
	{
		//a scripted death take. The script's own actor dies at the frame the
		//animator marked, not at the end of the sequence
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = 0.0;

		return TRUE;
	}

	if (code == HLAI_EV_NOT_DEAD)
	{
		//the other half of a life/death take: the actor gets up again
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = e->max_health;

		return TRUE;
	}

	//the payload-carrying codes only. An empty options field would play the
	//missing-sound sample or fire an unnamed target
	if (code == HLAI_EV_FIREEVENT || code == HLAI_EV_SOUND ||
		code == HLAI_EV_SOUND_VOICE || code == HLAI_EV_SENTENCE ||
		code == HLAI_EV_SENTENCE_RND1)
	{
		if (!options || !options[0])
			return TRUE;
	}

	if (code == HLAI_EV_FIREEVENT)
	{
		HLEntFireTargetsNamed(options, self, hl_ent_player, HLUSE_TOGGLE, 0.0);
		return TRUE;
	}

	if (code == HLAI_EV_SOUND)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLENT_SND_ATTEN, self + 1,
			HLENT_CHAN_BODY);
		return TRUE;
	}

	if (code == HLAI_EV_SOUND_VOICE)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLENT_SND_ATTEN, self + 1,
			HLCHAN_VOICE);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE)
	{
		HLAISentencePlay(options, self, e->origin, 1.0, HLENT_SND_ATTEN);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE_RND1)
	{
		//SCRIPT_EVENT_SENTENCE_RND1 plays two times in three
		if (HLPartRandI(3))
			HLAISentencePlay(options, self, e->origin, 1.0, HLENT_SND_ATTEN);

		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_LIGHT)
	{
		HLAIBodyDrop(s, FALSE);
		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_HEAVY)
	{
		HLAIBodyDrop(s, TRUE);
		return TRUE;
	}

	if (code == HLAI_EV_SWISHSOUND)
	{
		//the note in monsters.cpp is that no monster may use this event unless
		//its own precache carries the sample
		HLAIMonSound(s, "zombie/claw_miss2.wav");
		return TRUE;
	}

	//1001, 1002, 1006 and 1007 control a scripted_sequence's interruptibility
	//and its exit animation. Scripts here are not interruptible and CineCleanup
	//drops the actor straight into IDLE, so all four are no-ops rather than
	//unhandled.
	if (code == HLAI_EV_NOINTERRUPT || code == HLAI_EV_CANINTERRUPT ||
		code == HLAI_EV_INAIR || code == HLAI_EV_ENDANIMATION)
		return TRUE;

	return FALSE;
}

U0 HLAIMonAnimEvent(I64 s, I64 self, I64 code, U8 *options)
{//the per-monster HandleAnimEvent, dispatched on (class, code)
 //
 //a comparison chain on the kind rather than a switch: the bodies share almost
 //everything and a switch on the outer key would repeat the melee call ten
 //times over
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	I64			 kind;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	kind = hl_ai_mon[s].kind;
	mi   = &hl_ai_mon_info[kind];

	//the shared codes first, as every HandleAnimEvent's default branch does -
	//except that the base runs last there and first here, which only matters
	//for a monster that reuses a shared number, and none do
	if (code >= 1000)
	{
		HLAISharedEvent(s, e, self, code, options);
		return;
	}

	//--- CZombie. attack1 carries ATTACK_RIGHT at frame 10 and ATTACK_LEFT at
	//19, so one take lands two blows; attack2 carries ATTACK_BOTH
	if (kind == HLMON_ZOMBIE)
	{
		if (code == 1 || code == 2)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		if (code == 3)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee2_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		return;
	}

	//--- CHeadCrab. HC_AE_JUMPATTACK is the leap, which needs a monster mover
	//with velocity and a touch callback. The bite is applied at the same
	//frame instead, so the crab hurts on contact rather than never
	if (kind == HLMON_HEADCRAB)
	{
		if (code == 2)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		}

		return;
	}

	//--- CBullsquid
	if (kind == HLMON_BULLSQUID)
	{
		//BSQUID_AE_SPIT. CSquidSpit is a projectile entity and is absent, so
		//the event is the growl alone
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_attack);
			return;
		}

		if (code == 2)
		{
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg);
			return;
		}

		if (code == 4)
		{
			//BSQUID_AE_WHIP is DMG_CLUB|DMG_ALWAYSGIB, dlls/bullsquid.cpp:588
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee2_dmg,
				HLDMG_CLUB | HLDMG_ALWAYSGIB);
			return;
		}

		//3 blink and 5 hop are a skin change and a velocity shove
		return;
	}

	//--- CHoundeye
	if (kind == HLMON_HOUNDEYE)
	{
		//HOUND_AE_WARN and _STARTATTACK, the two beats before the blast
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_alert);
			return;
		}

		if (code == 2)
		{
			HLAIMonSound(s, "houndeye/he_attack1.wav");
			return;
		}

		//HOUND_AE_THUMP: SonicAttack. The blast is radius damage with no
		//falloff and no line of sight test, as UTIL_MonstersInSphere is
		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			HLAIMonSound(s, "houndeye/he_pain3.wav");
			return;
		}

		if (code == 5)
		{
			HLAIMonSound(s, "houndeye/he_pain1.wav");
			return;
		}

		//6 hop back and 7 close eye are velocity and skin
		return;
	}

	//--- CHGrunt. The three-round burst is three events in one take, which is
	//why a grunt's fire is a burst and not one shot per schedule
	if (kind == HLMON_HGRUNT)
	{
		if (code == 2)
		{
			HLAIMonSound(s, "hgrunt/gr_reload1.wav");
			hl_ai_mon[s].ammo = mi->clip_size;
			return;
		}

		if (code == 3)
		{
			//HGRUNT_AE_KICK. CHGrunt::Kick is a TakeDamage of DMG_CLUB,
			//dlls/hgrunt.cpp:955
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg, HLDMG_CLUB);
			return;
		}

		if (code == 4)
		{
			//the first round of the burst is the one that makes the noise and
			//puts a sound in the world list
			HLAIShootOnce(s);

			if (HLPartRandI(2))
				HLAIMonSound(s, "hgrunt/gr_mgun1.wav");
			else
				HLAIMonSound(s, "hgrunt/gr_mgun2.wav");

			HLAIAttackNoise(s);
			return;
		}

		if (code == 5)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 6)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 10)
		{
			//HGRUNT_AE_CAUGHT_ENEMY: the squad is told the player is back.
			//A group name, so a member is drawn from HG_ALERT0..n rather than
			//the same line every time
			HLAISentencePlay("HG_ALERT", self, e->origin, 1.0,
				HLENT_SND_ATTEN);
			return;
		}

		//7, 8 and 9 are grenades and 11 drops the gun as an item; neither a
		//grenade entity nor an item drop exists here
		return;
	}

	//--- CISlave
	if (kind == HLMON_ISLAVE)
	{
		if (code == 1)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));
			return;
		}

		if (code == 2)
		{
			//ISLAVE_AE_CLAWRAKE, sk_islave_dmg_clawrake1. No sequence in
			//islave.mdl carries it, so this is reachable only from a model
			//that does
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH, 25.0));
			return;
		}

		if (code == 3)
		{
			//ISLAVE_AE_ZAP_POWERUP, once per beam. The arm beams are a
			//temp-entity effect and are absent; the charge sound is not
			HLAIMonSound(s, "debris/zap4.wav");
			return;
		}

		if (code == 4)
		{
			//ISLAVE_AE_ZAP_SHOOT. The beam is a hitscan here
			HLAIMonSound(s, "hassault/hw_shoot1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		//5 clears the beams
		return;
	}

	//--- CBarney
	if (kind == HLMON_BARNEY)
	{
		if (code == 2)
		{
			//BARNEY_AE_DRAW: the pistol leaves the holster. The bodygroup
			//change is HLDraw.ZC's business, so only the flag is set
			hl_ai_mon[s].gun_drawn = TRUE;
			return;
		}

		if (code == 3)
		{
			//BarneyFirePistol
			HLAIMonSound(s, mi->snd_attack);
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			hl_ai_mon[s].gun_drawn = FALSE;
			return;
		}

		return;
	}

	//--- CAGrunt. Five hornet events over one take; each is one round of the
	//swarm, fired as a bullet for want of a projectile
	if (kind == HLMON_AGRUNT)
	{
		if (code >= 1 && code <= 5)
		{
			HLAIMonSound(s, "agrunt/ag_fire1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 6 || code == 7 || code == 12 || code == 13)
		{
			//PUNCH, BITE and the two handed punches all land the same figure,
			//and all are DMG_CLUB - dlls/agrunt.cpp:508 and :538
			HLAIClawFoley(s, HLAIHullAttack(s, mi->melee_range,
				mi->melee_dmg, HLDMG_CLUB));
			return;
		}

		if (code == 10 || code == 11)
		{
			//AGRUNT_AE_LEFT_FOOT / _RIGHT_FOOT. A footstep is a world sound,
			//which is how a bullsquid notices one walking past
			HLAIMonSound(s, "player/pl_ladder2.wav");
			HLAIInsertSound(HLSOUND_WORLD, e->origin, 128.0, 0.2);
			return;
		}

		return;
	}

	//--- CController. Both attacks throw an entity - a homing energy ball and
	//a head-mounted zap - so each shot event fires a bullet instead
	if (kind == HLMON_CONTROLLER)
	{
		if (code == 2 || code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		//1 opens the head, 4 and 5 are the charge-up glows
		return;
	}

	//--- CScientist. SCIENTIST_AE_HEAL and the needle events belong to the
	//heal behaviour, which needs CTalkMonster's follow logic and is absent
}

U0 HLAIMonEvents(I64 s, I64 self, F64 cycle)
{//StudioFrameAdvance's event dispatch for a monster
 //
 //the same walk HLAIEntityEvents does, routed to HandleAnimEvent instead of
 //to the script-event subset. Duplicated rather than shared because the
 //shared one is defined at the top of the file, hundreds of lines before the
 //monster table exists, and this compiler has no forward declarations.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLStudio	*m;
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 frame_f;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!e || !e->studio)
		return;

	m = e->studio;

	if (e->seq < 0 || e->seq >= m->num_seqs || !m->events)
		return;

	sq = &m->seqs[e->seq];

	if (sq->num_events < 1)
		return;

	frame_f = cycle * ToF64(sq->num_frames - 1);
	frame   = ToI64(frame_f);

	if (frame < 0)
		frame = 0;
	if (frame > sq->num_frames - 1)
		frame = sq->num_frames - 1;

	last = e->anim_event_frame;

	//a loop that wrapped, or a sequence just started, replays the list from
	//the beginning rather than skipping to the new position
	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &m->events[sq->first_event + i];

		if (ev->frame > last && ev->frame <= frame)
			HLAIMonAnimEvent(s, self, ev->code, ev->options);
	}

	e->anim_event_frame = frame;
}

//--- tasks ------------------------------------------------------------------
//
// schedule.cpp's interpreter. TaskComplete and TaskFail only set a status;
// RunTask notices and moves on, so a task can finish inside its own Start
// without the dispatcher losing its place.

U0 HLAITaskComplete(I64 s)
{
	hl_ai_mon[s].task_status = HLTK_DONE;
}

U0 HLAITaskFail(I64 s)
{//a failed task abandons the schedule, not just itself. The SDK has a
 //per-schedule failure schedule; here the state machine re-selects from scratch
 //next tick, which lands in the same place for the schedules that exist.
	hl_ai_mon[s].task_status = HLTK_FAILED;
}

//dlls/activity.h. HLACT_ is this port's own dense enum; LookupActivity matches
//against the number studiomdl baked into the sequence, so the two have to be
//mapped. -1 for an activity with no SDK counterpart.
//
//Verified against the shipped models: scientist.mdl carries walk at 3, run at
//4 and six idle takes at 1 with actweights 50/1/2/1/1/10.
I64 HLAIActToSDK(I64 act)
{
	if (act == HLACT_IDLE)			return 1;	//ACT_IDLE
	if (act == HLACT_WALK)			return 3;	//ACT_WALK
	if (act == HLACT_RUN)			return 4;	//ACT_RUN
	if (act == HLACT_MELEE)			return 30;	//ACT_MELEE_ATTACK1
	if (act == HLACT_RANGE)			return 28;	//ACT_RANGE_ATTACK1
	if (act == HLACT_DIE)			return 36;	//ACT_DIESIMPLE
	if (act == HLACT_FLINCH)		return 26;	//ACT_SMALL_FLINCH
	if (act == HLACT_MELEE2)		return 31;	//ACT_MELEE_ATTACK2
	if (act == HLACT_RANGE2)		return 29;	//ACT_RANGE_ATTACK2
	if (act == HLACT_RELOAD)		return 32;	//ACT_RELOAD
	if (act == HLACT_COMBAT_IDLE)	return 62;	//ACT_COMBAT_IDLE
	if (act == HLACT_SIGNAL)		return 21;	//ACT_SIGNAL1
	if (act == HLACT_THREAT)		return 57;	//ACT_THREAT_DISPLAY
	if (act == HLACT_VICTORY)		return 65;	//ACT_VICTORY_DANCE
	if (act == HLACT_COWER)			return 25;	//ACT_COWER
	if (act == HLACT_ARM)			return 33;	//ACT_ARM
	if (act == HLACT_EAT)			return 35;	//ACT_EAT
	if (act == HLACT_SPECIAL)		return 60;	//ACT_SPECIAL_ATTACK1
	if (act == HLACT_BARN_HIT)		return 40;	//ACT_BARNACLE_HIT
	if (act == HLACT_BARN_PULL)		return 41;	//ACT_BARNACLE_PULL
	if (act == HLACT_BARN_CHOMP)	return 42;	//ACT_BARNACLE_CHOMP
	if (act == HLACT_BARN_CHEW)		return 43;	//ACT_BARNACLE_CHEW

	return -1;
}

I64 HLAIResolveActivity(I64 s, I64 act)
{//::LookupActivity first, the label table second. -1 when the model has
 //neither.
 //
 //The label table picks one hardcoded take per activity, so a scientist with
 //six idles always played idle1. LookupActivity draws from all of them in
 //proportion to actweight, animation.cpp:84-109
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	U8			*label;
	I64			 seq;
	I64			 sdk;

	if (!e || !e->studio)
		return -1;

	sdk = HLAIActToSDK(act);

	if (sdk > 0)
	{
		seq = HLStudioLookupActivity(e->studio, sdk);

		if (seq >= 0)
			return seq;
	}

	//models whose sequences carry activity 0 - and the takes this port names
	//that studiomdl never tagged - still resolve through the table
	label = HLAIMonSeqOf(hl_ai_mon[s].kind, act);

	if (!label)
		return -1;

	return HLStudioSeqByName(e->studio, label);
}

U0 HLAISetActivity(I64 s, I64 act)
{//::SetActivity, monsters.cpp:1222
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 cycle;
	F64			 dur;
	I64			 seq;
	I64			 was;
	Bool		 loop;
	Bool		 keep;

	if (!e)
		return;

	was = hl_ai_mon[s].activity;

	//schedule.cpp:277 and :296 call SetActivity only on m_Activity !=
	//m_IdealActivity. Several callers here run every tick instead, and
	//LookupActivity re-rolls its weighted pick on every call, so without this
	//gate a scientist would draw a new idle take and restart the cycle at frame
	//zero for as long as it stood still.
	//
	//A one-shot is exempt: monsters.cpp:1231 forces frame 0 when the sequence
	//does not loop, which is how a schedule replays an attack take back to back
	if (act == was && e->studio && e->anim_loop &&
		e->seq >= 0 && e->seq == hl_ai_mon[s].act_seq)
		return;

	seq = HLAIResolveActivity(s, act);

	//an activity the model has no take for falls back to idle rather than
	//leaving the previous one running: a monster with no combat idle should
	//stand, not keep walking on the spot
	if (seq < 0 && act != HLACT_IDLE)
	{
		act = HLACT_IDLE;
		seq = HLAIResolveActivity(s, act);
	}

	if (seq < 0)
		return;

	//m_Activity, which ReportAIState prints
	hl_ai_mon[s].activity = act;
	hl_ai_mon[s].act_seq  = seq;

	//monsters.cpp:1231: the cycle restarts when the sequence index changes, or
	//when the current sequence does not loop - which is how a schedule replays
	//an attack take back to back. Re-selecting the same looping take leaves it
	//running, so a weighted re-roll landing where it already was does not
	//stutter the walk
	if (seq == e->seq && e->anim_loop)
		return;

	//only the ambulatory and idle activities loop. Attack, flinch and death are
	//one-shots, and HLAIEntityCycle holds a one-shot's last frame
	loop = ToBool(act == HLACT_IDLE || act == HLACT_WALK || act == HLACT_RUN ||
		act == HLACT_COMBAT_IDLE || act == HLACT_BARN_PULL ||
		act == HLACT_BARN_CHEW);

	//"don't reset frame between walk and run", monsters.cpp:1234. The SDK keeps
	//the raw frame index; the two takes differ in length, so the phase is what
	//carries over here
	keep = ToBool((was == HLACT_WALK || was == HLACT_RUN) &&
		(act == HLACT_WALK || act == HLACT_RUN));

	cycle = 0.0;

	if (keep)
		cycle = HLAIEntityCycle(e);

	e->seq        = seq;
	e->anim_done  = FALSE;

	//a new sequence has its own event list; the old frame index means nothing
	e->anim_event_frame = -1;

	//the sequence's own STUDIO_LOOPING flag overrides the choice above
	e->anim_loop = ToBool(loop || HLStudioSeqLoops(e->studio, seq));

	//ResetSequenceInfo's pev->animtime = gpGlobals->time, animating.cpp:116,
	//backed off by the phase being carried over
	dur = HLStudioSeqDuration(e->studio, seq);

	e->anim_start = hl_ent_time - cycle * dur;
}

Bool HLAIAnimDone(I64 s)
{//TRUE once the current one-shot sequence has run out
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dur;

	if (!e || !e->studio)
		return TRUE;

	dur = HLStudioSeqDuration(e->studio, e->seq);

	//a sequence with no duration would wait forever
	if (dur <= 0.0)
		return TRUE;

	return ToBool(hl_ent_time - e->anim_start >= dur);
}

Bool HLAITalkPointOf(I64 who, F64 *out)
{//where a talk target or follow leader stands. FALSE when it is gone or dead
	CHLEntity *e;

	HLVecSet(out, 0.0, 0.0, 0.0);

	if (who == HLTLK_PLAYER)
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(out);

		return TRUE;
	}

	if (who < 0)
		return FALSE;

	e = HLEntGet(who);

	if (!e || e->health <= 0.0)
		return FALSE;

	HLVecCopy(e->origin, out);

	return TRUE;
}

U0 HLAIStartTask(I64 s, I64 task, F64 data)
{//StartTask: the one-off half of a task. Anything decidable now is decided here
 //and the task completes immediately
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 away[3];
	F64			 cover[3];

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	hl_ai_mon[s].task_status = HLTK_RUNNING;
	hl_ai_mon[s].task_start  = hl_ent_time;

	switch (task)
	{
		case HLTASK_WAIT:
			break;

		case HLTASK_WAIT_RANDOM:
			//rolled into task_start rather than stored: RunTask compares
			//against the same data every tick, so shortening the window means
			//backdating the start
			hl_ai_mon[s].task_start = hl_ent_time -
				HLPartRand(1.0) * data * 0.5;
			break;

		case HLTASK_WAIT_FOR_ANIM:
			break;

		case HLTASK_SET_ACTIVITY:
			HLAISetActivity(s, ToI64(data));
			HLAITaskComplete(s);
			break;

		case HLTASK_STOP_MOVING:
			hl_ai_mon[s].have_goal     = FALSE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].move_speed    = 0.0;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			break;

		case HLTASK_FACE_GOAL:
			break;

		case HLTASK_PATH_TO_ENEMY:
			//TASK_GET_PATH_TO_ENEMY in the SDK asks CGraph for a route and
			//fails when there is none, which keeps a monster from walking at a
			//wall. There is no graph, so this cannot fail and the monster
			//walks at the wall - the largest behavioural difference here.
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = TRUE;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;

			//stop short of the enemy rather than inside it: melee reach if it
			//has one, otherwise 48 units
			hl_ai_mon[s].goal_tol = 48.0;

			if (mi->melee_range > 0.0)
				hl_ai_mon[s].goal_tol = mi->melee_range * 0.75;

			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_AWAY:
			//TASK_FIND_COVER_FROM_ENEMY, with the cover node lookup replaced
			//by "directly away". The SDK picks a node the enemy cannot see;
			//this picks a straight line, so a fleeing monster runs into
			//whatever is behind it as often as it gets clear.
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(e->origin, hl_ai_mon[s].enemy_pos, away);
			away[2] = 0.0;

			if (HLVecNormalize(away) <= 0.0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecMA(e->origin, data, away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			hl_ai_mon[s].move_speed = mi->walk_speed;
			HLAISetActivity(s, HLACT_WALK);
			break;

		case HLTASK_RUN_PATH:
			hl_ai_mon[s].move_speed = mi->run_speed;
			HLAISetActivity(s, HLACT_RUN);
			break;

		case HLTASK_MELEE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			//no attack sequence in the model: land the hit now. RunTask times
			//the hit off the sequence, so without one there is nothing to
			//time it to
			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE);
			break;

		case HLTASK_RANGE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE);
			break;

		case HLTASK_SOUND_ATTACK:
			HLAIMonSound(s, mi->snd_attack);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_ALERT:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_DIE:
			HLAIMonSound(s, mi->snd_die);
			HLAITaskComplete(s);
			break;

		case HLTASK_DIE:
			//BecomeDead: out of the damage set, out of the collision set, and
			//holding the last frame of the die sequence. A corpse that could
			//still be killed would queue HLM_BREAK_DIE on every further hit.
			HLAISetActivity(s, HLACT_DIE);

			e->takedamage = HLDMG_TAKE_NO;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->health     = 0.0;

			hl_ai_mon[s].have_goal  = FALSE;
			hl_ai_mon[s].have_enemy = FALSE;

			//Killed: the squad loses a member and its slot
			HLAISquadRemove(s);
			break;

		case HLTASK_WAIT_INDEF:
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			break;

		case HLTASK_FACE_IDEAL:
			break;

		case HLTASK_SMALL_FLINCH:
			//TASK_SMALL_FLINCH plus bits_MEMORY_FLINCHED. The pain sound goes
			//with it: CBaseMonster::TakeDamage calls PainSound at the same
			//moment the flinch schedule is set
			HLAISetActivity(s, HLACT_FLINCH);

			if (hl_ent_time >= hl_ai_mon[s].next_pain_snd)
			{
				HLAIMonSound(s, mi->snd_die);
				hl_ai_mon[s].next_pain_snd = hl_ent_time + 1.0;
			}
			break;

		case HLTASK_FIND_COVER_ENEMY:
			//TASK_FIND_COVER_FROM_ENEMY
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].enemy_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_SOUND:
			//TASK_FIND_COVER_FROM_BEST_SOUND
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].heard_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_ORG:
			//TASK_FIND_COVER_FROM_ORIGIN: anywhere but here. Nothing has to be
			//hidden from, so the visibility test is off and any standable spot
			//will do
			if (!HLAIFindCover(s, e->origin, FALSE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_SOUND:
			//TASK_GET_PATH_TO_BESTSOUND
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].heard_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 48.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;

			//the facing task that follows turns toward the noise
			hl_ai_mon[s].ideal_yaw =
				HLAIYawTo(e->origin, hl_ai_mon[s].heard_pos);

			HLAITaskComplete(s);
			break;

		case HLTASK_STORE_LASTPOS:
			HLVecCopy(e->origin, hl_ai_mon[s].lastpos);
			hl_ai_mon[s].have_lastpos = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_LASTPOS:
			if (!hl_ai_mon[s].have_lastpos)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].lastpos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_CLEAR_LASTPOS:
			hl_ai_mon[s].have_lastpos = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			//HGRUNT_AE_RELOAD refills the clip on the event; without a reload
			//take in the model there is nothing to hang it on, so it refills
			//here and the task ends
			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RELOAD))
			{
				hl_ai_mon[s].ammo = mi->clip_size;
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RELOAD);
			break;

		case HLTASK_MELEE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE2))
			{
				HLAIHullAttack(s, mi->melee2_range, mi->melee2_dmg);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE2);
			break;

		case HLTASK_RANGE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE2))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE2);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			//TASK_SPECIAL_ATTACK1: a display rather than a hit. The houndeye's
			//hop back and the agrunt's threat both land here and neither does
			//damage on its own
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;
			HLAISetActivity(s, HLACT_SPECIAL);
			break;

		case HLTASK_SOUND_IDLE:
			HLAIMonSound(s, mi->snd_idle);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_PAIN:
			HLAIMonSound(s, mi->snd_die);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_WAKE:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] + data);
			break;

		case HLTASK_TURN_RIGHT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] - data);
			break;

		case HLTASK_SET_SCHEDULE:
			//the schedule change happens in RunSchedule, which owns the task
			//cursor: reaching into it from here would leave the interpreter
			//pointing into the schedule it just left
			HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			HLAISetActivity(s, ToI64(data));
			break;

		case HLTASK_EAT:
			HLAISetActivity(s, HLACT_EAT);
			break;

		case HLTASK_SUGGEST_STATE:
			HLAITaskComplete(s);
			break;

		case HLTASK_OCCUPY_SLOT:
			if (HLAIOccupySlot(s, ToI64(data)))
				HLAITaskComplete(s);
			else
				HLAITaskFail(s);
			break;

		case HLTASK_FACE_TARGET:
			//AI_BaseNPC_Schedule.cpp:828 - MakeIdealYaw at m_hTargetEnt and
			//let RunTask turn. No target is a task failure there too
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			hl_ai_mon[s].ideal_yaw = HLAIYawTo(e->origin, away);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:879. MoveToTarget walks, so the follow is
			//a walk and not a run
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = data;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			hl_ai_mon[s].move_speed    = mi->walk_speed;

			HLAISetActivity(s, HLACT_WALK);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAIRunPath(I64 s, F64 dt)
{//the body of TASK_WALK_PATH and TASK_RUN_PATH, which differ only in the speed
 //and the activity StartTask already chose. A function rather than two cases
 //sharing one body, for the reason in HLAIRunTask.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 res;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!hl_ai_mon[s].have_goal)
	{
		HLAITaskComplete(s);
		return;
	}

	//a chase re-aims at the enemy every tick. This is the goal moving, not a
	//route update: without it a monster runs at the spot the enemy stood in
	//when the schedule started. Out of sight it heads for the last known
	//position, CheckEnemy's m_vecLastKnownPos.
	if (hl_ai_mon[s].goal_is_enemy && hl_ai_mon[s].have_enemy)
	{
		if (hl_ent_time - hl_ai_mon[s].enemy_seen <= HLAI_LOOK_PERIOD * 2.0 &&
			HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
			HLVecCopy(feet, hl_ai_mon[s].goal);
		}
		else
			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
	}

	//a monster always faces its travel direction: strafing needs four-way
	//blends the studio layer does not do
	HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt);

	res = HLAIMoveStep(s, hl_ai_mon[s].move_speed, dt);

	if (res == HLAI_MOVE_ARRIVED)
	{
		HLAITaskComplete(s);
		return;
	}

	if (res == HLAI_MOVE_BLOCKED)
	{
		HLAITaskFail(s);
		return;
	}

	//an unreachable goal must not hold the schedule forever
	if (hl_ent_time - hl_ai_mon[s].path_start > HLAI_PATH_TIMEOUT)
	{
		HLAITaskFail(s);
		return;
	}

	//in melee reach mid-run: stop now, so the attack goes off this tick rather
	//than once the goal tolerance is met
	if (mi->melee_range > 0.0 && hl_ai_mon[s].have_enemy)
	{
		if (HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecSub(feet, e->origin, d);

			if (HLVecLength(d) <= mi->melee_range)
				HLAITaskComplete(s);
		}
	}
}

U0 HLAIRunTask(I64 s, I64 task, F64 data, F64 dt)
{//RunTask: the per-tick half. Only the tasks that take time appear here
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 tpos[3];
	F64			 tdiff[3];

	if (!e)
		return;

	//no `case A: case B:` sharing one body below: consecutive case labels are
	//a construct nothing else in this tree exercises. Every case carries its
	//own body.
	switch (task)
	{
		case HLTASK_WAIT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_RANDOM:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_FOR_ANIM:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin,
				hl_ai_mon[s].enemy_pos), dt))
				HLAITaskComplete(s);

			//backstop against a face-lock. The SDK has no such guard because
			//ChangeYaw always reaches ideal_yaw
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_GOAL:
			if (!hl_ai_mon[s].have_goal)
			{
				HLAITaskComplete(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt))
				HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_RUN_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_MELEE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_RANGE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_DIE:
			//never completes. No corpse cleanup and no gibs, so the schedule
			//parks here and the body holds its last frame
			break;

		case HLTASK_WAIT_INDEF:
			//TASK_WAIT_INDEFINITE. Only a condition leaves it, which for this
			//interpreter means the state machine dropping the schedule
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			if (hl_ai_mon[s].have_enemy)
				HLAITurnToward(s, HLAIYawTo(e->origin,
					hl_ai_mon[s].enemy_pos), dt);

			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_IDEAL:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			//the same backstop TASK_FACE_ENEMY carries
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_SMALL_FLINCH:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			if (HLAIAnimDone(s))
			{
				hl_ai_mon[s].ammo =
					hl_ai_mon_info[hl_ai_mon[s].kind].clip_size;
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_MELEE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_RANGE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_RIGHT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_EAT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_TARGET:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			//the same backstop TASK_FACE_ENEMY carries
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:410-425: the goal is re-aimed once the
			//leader has moved more than half the stand-off distance from it,
			//not every tick, so a follower is not permanently re-routing
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, tpos))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(tpos, hl_ai_mon[s].goal, tdiff);

			if (HLVecLength(tdiff) > data * 0.5)
			{
				HLVecCopy(tpos, hl_ai_mon[s].goal);
				hl_ai_mon[s].path_start  = hl_ent_time;
				hl_ai_mon[s].stuck_since = 0.0;
				hl_ai_mon[s].have_detour = FALSE;
			}

			HLVecSub(hl_ai_mon[s].goal, e->origin, tdiff);
			tdiff[2] = 0.0;

			//Length2D, as the SDK's distance check is
			if (HLVecLength(tdiff) < data)
			{
				HLAITaskComplete(s);
				break;
			}

			HLAIRunPath(s, dt);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAISetSchedule(I64 s, I64 sched)
{//ChangeSchedule: take the list from the top
	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	//CSquadMonster::ScheduleChange gives the squad slot back on every schedule
	//change, so a grunt that stops firing releases its engage bit to the next
	//man rather than holding it for the rest of the fight
	HLAIVacateSlot(s);

	hl_ai_mon[s].in_cover   = FALSE;
	hl_ai_mon[s].sched      = sched;
	hl_ai_mon[s].task       = 0;
	hl_ai_mon[s].sched_done = FALSE;

	if (!hl_ai_sched_len[sched])
	{
		hl_ai_mon[s].sched_done  = TRUE;
		hl_ai_mon[s].task_status = HLTK_DONE;
		return;
	}

	HLAIStartTask(s, hl_ai_sched_task[sched * HLAI_SCHED_TASKS],
		hl_ai_sched_data[sched * HLAI_SCHED_TASKS]);
}

U0 HLAIRunSchedule(I64 s, F64 dt)
{//one tick of the current schedule, advancing through as many tasks as
 //complete immediately
	I64 sched = hl_ai_mon[s].sched;
	I64 slot;
	I64 budget = HLAI_SCHED_TASKS + 1;

	if (sched <= HLSCHED_NONE || sched >= HLSCHED_COUNT)
		return;

	while (budget > 0)
	{
		budget--;

		if (hl_ai_mon[s].sched_done)
			return;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		if (hl_ai_mon[s].task_status == HLTK_RUNNING)
		{
			HLAIRunTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot], dt);

			//still running after RunTask: nothing more this tick
			if (hl_ai_mon[s].task_status == HLTK_RUNNING)
				return;
		}

		if (hl_ai_mon[s].task_status == HLTK_FAILED)
		{
			//TaskFail runs the fail schedule, m_failSchedule, which for every
			//schedule here is slFail: stand still for two seconds rather than
			//re-select the same failing option once per tick
			if (hl_ai_mon[s].fail_sched > HLSCHED_NONE &&
				hl_ai_mon[s].fail_sched != sched)
			{
				HLAISetSchedule(s, hl_ai_mon[s].fail_sched);
				return;
			}

			hl_ai_mon[s].sched      = HLSCHED_NONE;
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		//TASK_SET_SCHEDULE jumps rather than advancing. The switch happens
		//here, not in StartTask, because this loop owns the task cursor
		if (hl_ai_sched_task[slot] == HLTASK_SET_SCHEDULE)
		{
			HLAISetSchedule(s, ToI64(hl_ai_sched_data[slot]));
			return;
		}

		//done: next task
		hl_ai_mon[s].task++;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		HLAIStartTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot]);
	}
}

//--- the state machine ------------------------------------------------------

U0 HLAISetState(I64 s, I64 state)
{//SetState. The schedule is dropped, so the selector runs fresh in the new state
 //rather than finishing a schedule belonging to the old one
	if (hl_ai_mon[s].state == state)
		return;

	hl_ai_mon[s].state      = state;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;
}

//--- the scripted_sequence driver -------------------------------------------
//
// CCineMonster, dlls/scripted.cpp, plus the tlScriptedWalk / tlScriptedRun /
// tlScriptedWait task lists (defaultai.cpp:799-862) that carry the actor
// through it. Kept as one state machine on m_scriptState rather than as rows
// in the schedule table: these tasks are private to the script, never
// interleave with the combat schedules, and three of the five have no
// equivalent among the HLTASK_ set.
//
// Placed after the mover, HLAISetActivity and HLAISetState because it uses all
// three. ZealC is single-pass and has no forward declarations.
//
// toggle_state on the script entity, the only field HLEntity.ZC's dispatcher
// can reach:
//
//   AT_BOTTOM   no cue yet. The script may already hold its actor, posed in
//               m_iszIdle on the mark: a script naming an idle take possesses
//               at map load even when it is named (scripted.cpp:143), which is
//               how the guard is already leaning on his rail when you see him.
//   GOING_DOWN  cue posted by the dispatcher. Consumed here on the next tick.
//   GOING_UP    m_iszPlay running.
//   AT_TOP      retired. The SDK removes the entity instead.
//
// Not reproduced: SF_SCRIPT_WAITTILLSEEN, m_flRepeat, m_iFinishSchedule, and
// the root-bone query CineCleanup uses to find where a sequence left the
// actor. The last means an actor whose play take walks it forward snaps back
// to the mark's floor position on release rather than to where it ended.

Bool HLAICanPlaySequence(I64 t, Bool disregard, I64 level)
{//CBaseMonster::CanPlaySequence, monsters.cpp:3110
	CHLEntity	*e;
	I64			 s;

	if (t < 0 || t >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(t);

	if (!e)
		return FALSE;

	//m_pCine: already held, by this script or another
	if (hl_ai_cine[t].owner >= 0)
		return FALSE;

	s = hl_ai_mon_of[t];

	//an actor with no AI slot - monster_generic wearing the forklift or the
	//loader - has no state to conflict with. It needs only a model to animate.
	if (s < 0)
		return ToBool(e->studio != NULL);

	if (hl_ai_mon[s].state == HLMSTATE_DEAD || e->health <= 0.0)
		return FALSE;

	//SF_SCRIPT_OVERRIDESTATE, and every aiscripted_sequence
	if (disregard)
		return TRUE;

	if (hl_ai_mon[s].state == HLMSTATE_NONE ||
		hl_ai_mon[s].state == HLMSTATE_IDLE)
		return TRUE;

	return ToBool(hl_ai_mon[s].state == HLMSTATE_ALERT &&
		level >= HLSS_INT_BY_NAME);
}

I64 HLAICineFind(I64 self)
{//CCineMonster::FindEntity, scripted.cpp:272. Every targetname match is tried
 //at SS_INTERRUPT_BY_NAME before the classname pass, which is limited to
 //m_flRadius and reaches only an idle actor.
	CHLEntity	*script = HLEntGet(self);
	F64			 d[3];
	Bool		 over;
	I64			 i;

	if (!script || !script->ai_entity[0])
		return -1;

	over = ToBool((script->spawnflags & HLAI_SF_OVERRIDESTATE) ||
		!StrCompare(script->classname, "aiscripted_sequence"));

	i = HLEntFindByTargetname(script->ai_entity, 0);

	while (i >= 0)
	{
		if (HLAICanPlaySequence(i, over, HLSS_INT_BY_NAME))
			return i;

		i = HLEntFindByTargetname(script->ai_entity, i + 1);
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qacf_next;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qacf_next;

		//a radius of 0 means anywhere in the map
		if (script->ai_radius > 0.0)
		{
			HLVecSub(hl_entities[i].origin, script->origin, d);

			if (HLVecLength(d) > script->ai_radius)
				goto qacf_next;
		}

		if (HLAICanPlaySequence(i, over, HLSS_INT_IDLE))
			return i;

qacf_next:
	}

	return -1;
}

U0 HLAICineDelayStart(I64 self, I64 state)
{//CCineMonster::DelayStart, scripted.cpp:725. Every scripted_sequence sharing
 //this targetname counts one actor still on its way; the group starts when the
 //count reaches zero. Two scientists walking to two marks both arrive before
 //either plays, which is what "act in concert" means in the entity comment.
	CHLEntity	*script = HLEntGet(self);
	I64			 i;

	if (!script)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || hl_entities[i].ent_class != HLC_SCRIPT)
			goto qacd_next;

		//an unnamed script is a group of one
		if (!script->targetname[0])
		{
			if (i != self)
				goto qacd_next;
		}
		else if (StrICompare(hl_entities[i].targetname, script->targetname))
			goto qacd_next;

		if (state)
			hl_ai_cine[i].delay++;
		else
		{
			hl_ai_cine[i].delay--;

			if (hl_ai_cine[i].delay <= 0)
				hl_ai_cine[i].start = hl_ent_time + 0.05;
		}

qacd_next:
	}
}

Bool HLAICineSetSeq(I64 t, U8 *label)
{//CCineMonster::StartSequence, scripted.cpp:493. An unknown label falls back
 //to sequence 0 as the SDK does after its error: leaving the previous take
 //running would play a walk cycle through a scripted death.
	CHLEntity	*e;
	I64			 seq;

	if (t < 0 || t >= HLENT_MAX || !label || !label[0])
		return FALSE;

	e = HLEntGet(t);

	if (!e || !e->studio)
		return FALSE;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
	{
		"HLAI: %s has no sequence \"%s\"\n", e->classname, label;
		seq = 0;
	}

	e->seq              = seq;
	e->anim_start       = hl_ent_time;
	e->anim_done        = FALSE;
	e->anim_event_frame = -1;
	e->anim_loop        = HLStudioSeqLoops(e->studio, seq);

	return TRUE;
}

U0 HLAICineRelease(I64 self)
{//CBaseMonster::CineCleanup, scripted.cpp:796. Hand the actor back with the
 //movetype and solid the script saved, put it on the floor, and drop its
 //schedule so the selector runs fresh in IDLE.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	hl_ai_cine[self].actor = -1;
	hl_ai_cine[self].state = HLSS_CLEANUP;

	if (t < 0 || t >= HLENT_MAX)
		return;

	hl_ai_cine[t].owner = -1;

	actor = HLEntGet(t);

	if (!actor)
		return;

	actor->movetype = hl_ai_cine[self].movetype;
	actor->solid    = hl_ai_cine[self].solid;

	s = hl_ai_mon_of[t];

	if (s < 0)
		return;

	//SF_SCRIPT_NOSCRIPTMOVEMENT leaves the actor where the take ended. The SDK
	//otherwise reads bone 0 to find that position and drops from there; there
	//is no bone query outside the renderer here, so only the drop is done.
	if (!(script->spawnflags & HLAI_SF_NOSCRIPTMOVEMENT))
	{
		if (HLAIDropToFloor(actor, actor->origin, floor))
			HLVecCopy(floor, actor->origin);

		HLEntSetAbsBox(actor);
	}

	hl_ai_mon[s].scripted   = FALSE;
	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].activity   = HLACT_IDLE;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;

	//m_IdealMonsterState. A script that killed its actor leaves it dead
	if (actor->health > 0.0)
		HLAISetState(s, HLMSTATE_IDLE);
	else
		HLAISetState(s, HLMSTATE_DEAD);
}

U0 HLAICineDone(I64 self)
{//CCineMonster::SequenceDone, scripted.cpp:561. The actor is released before
 //the targets fire: firing hands it straight to the next script in the chain,
 //which is how the walking scientists in c0a0 bounce between two marks.
	CHLEntity *script = HLEntGet(self);

	if (!script)
		return;

	HLAICineRelease(self);

	hl_ai_cine[self].start = HLAI_CINE_NEVER;
	hl_ai_cine[self].delay = 0;

	//no think scheduled: a repeatable script waits to be fired again rather
	//than snatching its actor back from whatever the targets just started
	hl_ai_cine[self].retry = -1.0;

	if (script->spawnflags & HLAI_SF_REPEATABLE)
		script->toggle_state = HLTS_AT_BOTTOM;
	else
		script->toggle_state = HLTS_AT_TOP;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);
}

U0 HLAICinePossess(I64 self)
{//CCineMonster::PossessEntity, scripted.cpp:321. Claim the actor, record what
 //will be handed back, set m_scriptState from m_fMoveTo, pose the idle take.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = HLAICineFind(self);

	if (t < 0)
	{
		//CineThink retries rather than retiring: the actor is often finishing
		//an earlier script in the same chain
		hl_ai_cine[self].retry = hl_ent_time + HLAI_CINE_RETRY;
		return;
	}

	actor = HLEntGet(t);

	hl_ai_cine[self].actor    = t;
	hl_ai_cine[self].movetype = actor->movetype;
	hl_ai_cine[self].solid    = actor->solid;
	hl_ai_cine[self].retry    = -1.0;
	hl_ai_cine[t].owner       = self;

	s = hl_ai_mon_of[t];

	if (s >= 0)
	{
		hl_ai_mon[s].scripted  = TRUE;
		hl_ai_mon[s].have_goal = FALSE;

		HLAISetState(s, HLMSTATE_SCRIPT);

		//DROP_TO_FLOOR, which every CBaseMonster::Spawn runs before a script
		//can reach the actor. HLAIMonThink does it on the first think and a
		//monster possessed at map load never gets one, so it is done here too.
		if (!hl_ai_mon[s].settled)
		{
			hl_ai_mon[s].settled = TRUE;

			if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies &&
				HLAIDropToFloor(actor, actor->origin, floor))
			{
				HLVecCopy(floor, actor->origin);
				HLEntSetAbsBox(actor);
			}
		}
	}

	//m_fMoveTo. 1 and 2 leave the actor where it stands and route it; the rest
	//place it. An actor with no AI slot cannot route, so it is placed too.
	if (script->ai_moveto == HLAI_MOVE_WALK && s >= 0)
	{
		hl_ai_cine[self].state = HLSS_WALK_TO_MARK;

		HLAICineDelayStart(self, 1);
	}
	else if (script->ai_moveto == HLAI_MOVE_RUN && s >= 0)
	{
		hl_ai_cine[self].state = HLSS_RUN_TO_MARK;

		HLAICineDelayStart(self, 1);
	}
	else
	{
		hl_ai_cine[self].state = HLSS_WAIT;

		//5 turns to face without moving
		if (script->ai_moveto != HLAI_MOVE_NONE &&
			script->ai_moveto != HLAI_MOVE_TURN)
		{
			HLVecCopy(script->origin, actor->origin);
			HLEntSetAbsBox(actor);
		}

		if (script->ai_moveto != HLAI_MOVE_NONE)
			actor->angles[1] = HLAngleNorm(script->angles[1]);

		//m_startTime = time + 1E6 on a teleport: a placed actor holds its idle
		//until the trigger whether or not the script carries a targetname
		if (script->ai_moveto == HLAI_MOVE_INSTANT)
			hl_ai_cine[self].start = HLAI_CINE_NEVER;
	}

	if (s >= 0)
		hl_ai_mon[s].ideal_yaw = actor->angles[1];

	//m_iszIdle poses the actor now. The play take waits for the cue.
	if (script->ai_idle[0])
		HLAICineSetSeq(t, script->ai_idle);
}

U0 HLAICineBeginPlay(I64 self)
{//TASK_WAIT_FOR_SCRIPT completing, schedule.cpp:522. m_iszPlay starts and
 //TASK_PLAY_SCRIPT waits it out. An empty m_iszPlay finishes the script here
 //(scripted.cpp:495): ten of the seventeen scripts in c0a0 carry none and
 //exist only to move an actor to a mark and fire the next link.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	if (t < 0 || !script->ai_play[0])
	{
		HLAICineDone(self);
		return;
	}

	HLAICineSetSeq(t, script->ai_play);

	hl_ai_cine[self].state = HLSS_PLAYING;
	script->toggle_state   = HLTS_GOING_UP;

	actor = HLEntGet(t);
	s     = hl_ai_mon_of[t];

	//the end is scheduled off the sequence duration rather than watched on the
	//renderer's cycle: the renderer does not run for an off-screen actor and
	//the script still has to complete
	script->pain_finished = hl_ent_time;

	if (actor && actor->studio)
		script->pain_finished += HLStudioSeqDuration(actor->studio, actor->seq);

	//the take is the script's, not an activity. Leaving m_Activity on WALK
	//would let the next HLAISetActivity call decide it is already playing.
	if (s >= 0)
		hl_ai_mon[s].activity = HLACT_IDLE;
}

U0 HLAICineActorTick(I64 s, F64 dt)
{//tlScriptedWalk, tlScriptedRun and tlScriptedWait as one state machine. Runs
 //in place of the AI think for a monster a script holds.
	CHLEntity	*actor = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*script;
	CHLMonInfo	*mi;
	F64			 speed;
	I64			 self;
	I64			 st;
	I64			 moved;

	if (!actor || hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
		return;

	self = hl_ai_cine[hl_ai_mon[s].ent].owner;

	if (self < 0)
		return;

	script = HLEntGet(self);

	if (!script)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	st = hl_ai_cine[self].state;

	//CineCleanup's deadflag branch, scripted.cpp:818: an actor killed on its
	//way to the mark leaves the script. One killed during the play take does
	//not - a scripted death is a take like any other and runs to its end.
	if (st != HLSS_PLAYING && actor->health <= 0.0)
	{
		HLAICineDone(self);
		return;
	}

	if (st == HLSS_WALK_TO_MARK || st == HLSS_RUN_TO_MARK)
	{
		//TASK_WALK_TO_TARGET / TASK_RUN_TO_TARGET at TARGET_MOVE_SCRIPTED, then
		//TASK_WAIT_FOR_MOVEMENT. No node graph, so the route is straight at the
		//mark with the mover's one wall slide.
		speed = mi->walk_speed;

		if (st == HLSS_RUN_TO_MARK)
			speed = mi->run_speed;

		hl_ai_mon[s].have_goal     = TRUE;
		hl_ai_mon[s].goal_is_enemy = FALSE;
		hl_ai_mon[s].goal_tol      = 8.0;
		hl_ai_mon[s].move_speed    = speed;

		//the mark does not move, so a triangulated apex stays valid until the
		//actor reaches it. This block runs every tick and must not clear it
		HLVecCopy(script->origin, hl_ai_mon[s].goal);

		if (st == HLSS_WALK_TO_MARK)
			HLAISetActivity(s, HLACT_WALK);
		else
			HLAISetActivity(s, HLACT_RUN);

		HLAITurnToward(s, HLAIYawTo(actor->origin, script->origin), dt);

		moved = HLAIMoveStep(s, speed, dt);

		if (moved == HLAI_MOVE_OK)
			return;

		//TASK_PLANT_ON_SCRIPT: on the mark exactly, arrived or blocked. An
		//actor that cannot route the last few units would otherwise hold the
		//whole group on its DelayStart count for the rest of the map.
		HLVecCopy(script->origin, actor->origin);
		HLEntSetAbsBox(actor);

		hl_ai_mon[s].have_goal = FALSE;

		//TASK_FACE_SCRIPT then TASK_FACE_IDEAL. The turn is instant: the actor
		//is standing on the mark and the wait below has nothing to turn during.
		hl_ai_mon[s].ideal_yaw = HLAngleNorm(script->angles[1]);
		actor->angles[1]       = hl_ai_mon[s].ideal_yaw;

		if (script->ai_idle[0])
			HLAICineSetSeq(hl_ai_mon[s].ent, script->ai_idle);
		else
			HLAISetActivity(s, HLACT_IDLE);

		//TASK_ENABLE_SCRIPT: one fewer actor still walking
		hl_ai_cine[self].state = HLSS_WAIT;

		HLAICineDelayStart(self, 0);

		return;
	}

	if (st == HLSS_WAIT)
	{
		//TASK_WAIT_FOR_SCRIPT, schedule.cpp:1251
		if (!script->ai_idle[0])
			HLAISetActivity(s, HLACT_IDLE);
		else if (!StrICompare(script->ai_idle, script->ai_play))
			//pev->framerate = 0 when idle and play name the same take: frame 0
			//is held until the cue. scripted.cpp:384
			actor->anim_start = hl_ent_time;

		HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt);

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
			HLAICineBeginPlay(self);

		return;
	}

	//HLSS_PLAYING is TASK_PLAY_SCRIPT: nothing to do but hold still. The take
	//running out is noticed on the script's own clock in HLAICineTick, so an
	//actor with no AI slot reaches the end the same way this one does.
}

U0 HLAICineTick(I64 self)
{//one scripted_sequence, one tick: Spawn, Use, CineThink and the end of
 //TASK_PLAY_SCRIPT. The actor's half is HLAICineActorTick when it has an AI
 //slot; an actor without one is driven entirely from here.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	//CCineMonster::Spawn, scripted.cpp:143. A script with no targetname, or
	//one naming an idle take, thinks a second after the map loads and takes its
	//actor then; a named script parks m_startTime until it is used.
	if (hl_ai_cine[self].retry == 0.0)
	{
		if (!script->targetname[0] || script->ai_idle[0])
			hl_ai_cine[self].retry = hl_ent_time + 1.0;
		else
			hl_ai_cine[self].retry = -1.0;

		if (script->targetname[0])
			hl_ai_cine[self].start = HLAI_CINE_NEVER;
		else
			hl_ai_cine[self].start = 0.0;
	}

	t = hl_ai_cine[self].actor;

	//--- the cue, posted by the dispatcher in HLEntity.ZC ---
	if (script->toggle_state == HLTS_GOING_DOWN)
	{
		script->toggle_state = HLTS_AT_BOTTOM;

		//CCineMonster::Use, scripted.cpp:181. An actor already in hand needs
		//only its start time brought forward; otherwise think now and find one.
		if (t >= 0)
			hl_ai_cine[self].start = hl_ent_time + 0.05;
		else
			hl_ai_cine[self].retry = hl_ent_time;
	}

	if (script->toggle_state == HLTS_AT_TOP)
		return;

	//--- CineThink ---
	if (t < 0)
	{
		if (hl_ai_cine[self].retry >= 0.0 &&
			hl_ent_time >= hl_ai_cine[self].retry)
			HLAICinePossess(self);

		return;
	}

	//--- an actor with no AI slot ---
	s = hl_ai_mon_of[t];

	if (s < 0 && hl_ai_cine[self].state == HLSS_WAIT)
	{
		if (script->ai_idle[0] &&
			!StrICompare(script->ai_idle, script->ai_play))
		{
			actor = HLEntGet(t);

			if (actor)
				actor->anim_start = hl_ent_time;
		}

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
			HLAICineBeginPlay(self);
	}

	//--- TASK_PLAY_SCRIPT: the take has run out ---
	if (hl_ai_cine[self].state == HLSS_PLAYING &&
		hl_ent_time >= script->pain_finished)
		HLAICineDone(self);
}

//--- CTalkMonster -----------------------------------------------------------
//
// dlls/talkmonster.cpp. The behaviour layer over CBaseMonster that scientists
// and barneys carry: greetings, idle conversation, the head turn towards
// whoever is speaking, and the follow system the retinal-scanner puzzles need.
//
// The port has no condition bits and no per-monster GetSchedule override, so
// the talk stack CTalkMonster::GetScheduleOfType(SCHED_IDLE_STAND) runs
// (talkmonster.cpp:1233-1290) is driven from the think instead, the same place
// this port already drives IdleSound from. The order of the tests is the SDK's.

//TALKRANGE_MIN, talkmonster.h:26
#define HLAI_TALKRANGE_MIN	500.0
//TLK_STARE_DIST, talkmonster.h:28
#define HLAI_TLK_STARE_DIST	128.0

//TALKGROUPNAMES, talkmonster.h:41-62
#define HLTLK_ANSWER		0
#define HLTLK_QUESTION		1
#define HLTLK_IDLE			2
#define HLTLK_STARE			3
#define HLTLK_USE			4
#define HLTLK_UNUSE			5
#define HLTLK_STOP			6
#define HLTLK_NOSHOOT		7
#define HLTLK_HELLO			8
#define HLTLK_PHELLO		9
#define HLTLK_PIDLE			10
#define HLTLK_PQUESTION		11
#define HLTLK_PLHURT1		12
#define HLTLK_PLHURT2		13
#define HLTLK_PLHURT3		14
#define HLTLK_SMELL			15
#define HLTLK_WOUND			16
#define HLTLK_MORTAL		17
#define HLTLK_CGROUPS		18

//longest shipped group name is SC_PQUEST at nine characters
#define HLAI_TLK_NAME		16

//SF_MONSTER_GAG and SF_MONSTER_PREDISASTER, monsters.h:45 and :52
#define HLAI_SF_MONSTER_GAG			2
#define HLAI_SF_PREDISASTER			256

//SF_SENTENCE_*, scripted.cpp:954-957
#define HLAI_SF_SENTENCE_ONCE		1
#define HLAI_SF_SENTENCE_FOLLOWERS	2
#define HLAI_SF_SENTENCE_INTERRUPT	4
#define HLAI_SF_SENTENCE_CONCURRENT	8

//radius UTIL_FindEntityGeneric uses for a listener named "player",
//scripted.cpp:1200
#define HLAI_SENTENCE_PLAYER_RADIUS	4096.0

Bool HLAITalkLineClear(F64 *from, F64 *to)
{//a point trace with nothing in the way, as FindNearestFriend's
 //UTIL_TraceLine(ignore_monsters) is
	CHLTrace	tr;
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLTraceEntity(hl_map, from, to, zero, zero, 0, TRUE, &tr);

	return ToBool(tr.fraction >= 1.0);
}

//one flat block at a fixed stride: a U8* table of string literals collapses to
//a single entry on this compiler
U8	hl_ai_tlk_grp[HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME];

U0 HLAITalkSetGrp(I64 kind, I64 which, U8 *name)
{
	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return;

	HLStrCopy(&hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME],
		name, HLAI_TLK_NAME);
}

U8 *HLAITalkGrp(I64 kind, I64 which)
{//m_szGrp[which] for a monster kind, or NULL where the SDK leaves it NULL
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT)
		return NULL;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return NULL;

	p = &hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAITalkGroupsInit()
{//CScientist::TalkInit, scientist.cpp:738-758 and CBarney::TalkInit,
 //barney.cpp:462-484. A leading ! names one sentence rather than a group;
 //SC_CUREA and its siblings carry no trailing number and so form no group.
	I64 i;

	for (i = 0; i < HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME; i++)
		hl_ai_tlk_grp[i] = 0;

	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_ANSWER,    "SC_ANSWER");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_QUESTION,  "SC_QUESTION");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_IDLE,      "SC_IDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STARE,     "SC_STARE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_USE,       "SC_OK");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_UNUSE,     "SC_WAIT");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STOP,      "SC_STOP");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_NOSHOOT,   "SC_SCARED");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_HELLO,     "SC_HELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PHELLO,    "SC_PHELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PIDLE,     "SC_PIDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PQUESTION, "SC_PQUEST");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT1,   "!SC_CUREA");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT2,   "!SC_CUREB");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT3,   "!SC_CUREC");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_SMELL,     "SC_SMELL");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_WOUND,     "SC_WOUND");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_MORTAL,    "SC_MORTAL");

	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_ANSWER,    "BA_ANSWER");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_QUESTION,  "BA_QUESTION");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_IDLE,      "BA_IDLE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STARE,     "BA_STARE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_USE,       "BA_OK");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_UNUSE,     "BA_WAIT");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STOP,      "BA_STOP");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_NOSHOOT,   "BA_SCARED");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_HELLO,     "BA_HELLO");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PQUESTION, "BA_PQUEST");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT1,   "!BA_CUREA");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT2,   "!BA_CUREB");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT3,   "!BA_CUREC");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_SMELL,     "BA_SMELL");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_WOUND,     "BA_WOUND");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_MORTAL,    "BA_MORTAL");

	//barney has no pre-disaster hello or idle group; the SDK leaves both NULL
}

//top-level: static data, so once is enough and a map change does not disturb it
HLAITalkGroupsInit;

I64 HLAITalkKindOf(I64 ent)
{//which m_szGrp table an entity speaks from, or -1 for a monster that does not
 //talk. monster_sitting_scientist is its own class over the scientist's groups
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return -1;

	e = HLEntGet(ent);

	if (!e)
		return -1;

	if (!StrCompare(e->classname, "monster_sitting_scientist"))
		return HLMON_SCIENTIST;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return -1;

	if (hl_ai_mon[s].kind == HLMON_SCIENTIST ||
		hl_ai_mon[s].kind == HLMON_BARNEY)
		return hl_ai_mon[s].kind;

	return -1;
}

U0 HLAITalkEnsure(I64 ent)
{//CTalkMonster::TalkInit plus the per-head voice pitch CScientist::Spawn picks,
 //scientist.cpp:764-767. Lazy rather than called from Spawn: HLEntity.ZC
 //compiles first and cannot reach this table.
	CHLEntity	*e;
	I64			 head;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (hl_ai_talk[ent].inited)
		return;

	hl_ai_talk[ent].inited      = TRUE;
	hl_ai_talk[ent].voice_pitch = HLPITCH_NORM;

	e = HLEntGet(ent);

	if (!e)
		return;

	if (HLAITalkKindOf(ent) != HLMON_SCIENTIST)
		return;

	//pev->body indexes the head: 0 glasses, 1 einstein, 2 luther, 3 slick.
	//NUM_SCIENTIST_HEADS is 4 and the needle bodygroup adds a multiple of it
	head = e->body % 4;

	if (head == 0)
		hl_ai_talk[ent].voice_pitch = 105;

	if (head == 2)
		hl_ai_talk[ent].voice_pitch = 95;
}

I64 HLAITalkPitch(I64 ent)
{//GetVoicePitch, talkmonster.cpp:872: m_voicePitch plus 0..3
	HLAITalkEnsure(ent);

	if (ent < 0 || ent >= HLENT_MAX)
		return HLPITCH_NORM;

	return hl_ai_talk[ent].voice_pitch + HLPartRandI(4);
}

Bool HLAITalkIsTalking(I64 ent)
{//IsTalking, talkmonster.cpp:1310
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return ToBool(hl_ai_talk[ent].stop_talk > hl_ent_time);
}

U0 HLAITalkTalk(I64 ent, F64 duration)
{//Talk, talkmonster.cpp:1218. A line with no duration is assumed to run three
 //seconds
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (duration <= 0.0)
		hl_ai_talk[ent].stop_talk = hl_ent_time + 3.0;
	else
		hl_ai_talk[ent].stop_talk = hl_ent_time + duration;
}

Bool HLAITalkOk(I64 ent)
{//FOkToSpeak, talkmonster.cpp:913. The PVS test has no counterpart here - the
 //player's leaf is not tracked server-side - so the visibility part of it is
 //left to the callers that already trace.
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	//g_talkWaitTime: somebody else has the floor
	if (hl_ent_time <= hl_ai_talk_wait)
		return FALSE;

	if (e->spawnflags & HLAI_SF_MONSTER_GAG)
		return FALSE;

	s = hl_ai_mon_of[ent];

	if (s >= 0)
	{
		if (hl_ai_mon[s].state == HLMSTATE_DEAD)
			return FALSE;

		//don't talk if you're in combat
		if (hl_ai_mon[s].have_enemy &&
			hl_ai_mon[s].state == HLMSTATE_COMBAT)
			return FALSE;
	}

	return TRUE;
}

Bool HLAITalkPlaySentence(I64 ent, U8 *group, F64 duration, F64 volume,
	F64 atten)
{//PlaySentence, talkmonster.cpp:1206. g_talkWaitTime is pushed out past the
 //line plus two seconds, which is the gap between one character finishing and
 //the next being allowed to start.
	CHLEntity *e;

	if (!group || !group[0])
		return FALSE;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	HLAITalkEnsure(ent);
	HLAITalkTalk(ent, duration);

	hl_ai_talk_wait = hl_ent_time + duration + 2.0;

	//saying anything at all counts as having greeted the player
	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return HLAISentencePlay(group, ent, e->origin, volume, atten,
		HLAITalkPitch(ent));
}

Bool HLAITalkIsFriendClass(U8 *classname)
{//m_szFriends, talkmonster.cpp:53-58
	if (!StrCompare(classname, "monster_barney"))
		return TRUE;

	if (!StrCompare(classname, "monster_scientist"))
		return TRUE;

	return ToBool(!StrCompare(classname, "monster_sitting_scientist"));
}

U0 HLAITalkShutUpFriends(I64 ent)
{//ShutUpFriends, talkmonster.cpp:704. Every friend in the map stops mid-word
 //so one scripted line is heard clean.
	I64 i;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatsu_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatsu_next;

		if (hl_entities[i].health <= 0.0)
			goto qatsu_next;

		HLAISentenceStop(i);

		if (i < HLENT_MAX)
			hl_ai_talk[i].stop_talk = 0.0;

qatsu_next:
	}
}

I64 HLAITalkNearestFriend(I64 ent, Bool want_player)
{//FindNearestFriend, talkmonster.cpp:802. The trace runs from the top of one
 //bounding box to the top of the other, which is what lets two characters see
 //each other over a desk.
	CHLEntity	*e;
	CHLEntity	*f;
	F64			 start[3];
	F64			 check[3];
	F64			 d[3];
	F64			 dist;
	F64			 best  = HLAI_TALKRANGE_MIN;
	I64			 found = HLTLK_NOBODY;
	I64			 i;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return HLTLK_NOBODY;

	e = HLEntGet(ent);

	if (!e)
		return HLTLK_NOBODY;

	HLVecCopy(e->origin, start);
	start[2] = e->absmax[2];

	if (want_player)
	{
		if (!HLAITalkPointOf(HLTLK_PLAYER, check))
			return HLTLK_NOBODY;

		//the listener eye, not the feet: FindNearestFriend raises the check
		//point to the target's absmax
		HLVecCopy(hl_snd_listener, check);
		HLVecSub(start, check, d);

		if (HLVecLength(d) >= HLAI_TALKRANGE_MIN)
			return HLTLK_NOBODY;

		if (!HLAITalkLineClear(start, check))
			return HLTLK_NOBODY;

		return HLTLK_PLAYER;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatnf_next;

		f = &hl_entities[i];

		if (!HLAITalkIsFriendClass(f->classname))
			goto qatnf_next;

		//don't talk to self or dead people
		if (f->health <= 0.0)
			goto qatnf_next;

		s = -1;

		if (i < HLENT_MAX)
			s = hl_ai_mon_of[i];

		//in a script or prone: not available to be spoken to
		if (s >= 0 && (hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
			hl_ai_mon[s].state == HLMSTATE_DEAD))
			goto qatnf_next;

		HLVecCopy(f->origin, check);
		check[2] = f->absmax[2];

		HLVecSub(start, check, d);
		dist = HLVecLength(d);

		if (dist >= best)
			goto qatnf_next;

		if (!HLAITalkLineClear(start, check))
			goto qatnf_next;

		found = i;
		best  = dist;

qatnf_next:
	}

	return found;
}

U0 HLAITalkHeadTurn(I64 ent, F64 *point, F64 limit = HLAI_TLK_HEAD_MAX)
{//IdleHeadTurn, talkmonster.cpp:1007. Controller 0 is the head yaw, in degrees
 //off the body's own yaw.
 //
 //SetBoneController maps through the controller's start and end: raw 0 is the
 //START of the range, not the middle, so writing the angle straight into
 //pev->controller aims scientist.mdl's head at -60 degrees and the character
 //stares sideways. HLStudioCtlSetting is that mapping.
 //
 //limit is the envelope the caller can absorb elsewhere. The SDK leans on
 //TASK_TLK_IDEALYAW turning the body first and lets the engine clamp what is
 //left; here the body turn is best effort, so the head is bounded at the write
 //site as well
	CHLEntity	*e;
	F64			 yaw;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	//HLAIYawDiff is the signed shortest arc, which is the SDK's fold to
	//[-180, 180]. HLAngleNorm folds to [0, 360) and would put every head hard
	//over one way
	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	if (yaw > limit)
		yaw = limit;

	if (yaw < -limit)
		yaw = -limit;

	hl_ai_talk[ent].head_turn = yaw;

	setting = HLStudioCtlSetting(e->studio, 0, yaw);

	//the model carries no such controller
	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkHeadSet(I64 ent, F64 degrees)
{//TASK_TLK_HEADRESET and CSittingScientist's m_headTurn, both of which set the
 //controller from an angle rather than from a point
	CHLEntity	*e;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	hl_ai_talk[ent].head_turn = degrees;

	setting = HLStudioCtlSetting(e->studio, 0, degrees);

	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkFaceTarget(I64 ent, Bool reset_when_done = TRUE,
	F64 limit = HLAI_TLK_HEAD_MAX)
{//the head half of TASK_TLK_EYECONTACT: hold the head on whoever is being
 //spoken to for as long as the line runs, then TASK_TLK_HEADRESET.
 //
 //CSittingScientist drives the controller from m_headTurn on its own think and
 //must not have it centred here, so it asks for no reset.
	F64 point[3];

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (!HLAITalkIsTalking(ent))
	{
		if (reset_when_done && hl_ai_talk[ent].head_turn != 0.0)
			HLAITalkHeadSet(ent, 0.0);

		return;
	}

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	//the listener's eye rather than its feet, so a head does not aim at a floor
	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	HLAITalkHeadTurn(ent, point, limit);
}

U0 HLAITalkSetAnswer(I64 listener, I64 speaker)
{//SetAnswerQuestion, talkmonster.cpp:1226, and the sitting override at
 //scientist.cpp:1398. A question makes the listener owe an answer.
	if (listener < 0 || listener >= HLENT_MAX)
		return;

	hl_ai_talk[listener].talk_target = speaker;

	//CSittingScientist waits three to four seconds; a standing one answers on
	//its own idle schedule, which the response delay stands in for here
	hl_ai_talk[listener].response = hl_ent_time + 3.5 + HLPartRand(0.5);
}

Bool HLAITalkIdleRespond(I64 ent)
{//IdleRespond, talkmonster.cpp:905
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return FALSE;

	return HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_ANSWER),
		3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
}

Bool HLAITalkIdleHello(I64 ent)
{//FIdleHello, talkmonster.cpp:974. Greets the player once, and only when the
 //player is inside the view cone and visible.
	CHLEntity	*e;
	F64			 point[3];
	I64			 kind;
	I64			 s;
	U8			*grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (HLAITalkNearestFriend(ent, TRUE) != HLTLK_PLAYER)
		return FALSE;

	HLVecCopy(hl_snd_listener, point);

	s = hl_ai_mon_of[ent];

	//FInViewCone. A sitting scientist takes no AI slot and so has no cone;
	//the SDK gives it m_flFieldOfView from CScientist::Spawn either way
	if (s >= 0 && !HLAIInViewCone(s, point))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

	grp = HLAITalkGrp(kind, HLTLK_HELLO);

	if (e->spawnflags & HLAI_SF_PREDISASTER)
		grp = HLAITalkGrp(kind, HLTLK_PHELLO);

	if (!HLAITalkPlaySentence(ent, grp, 3.25 + HLPartRand(0.25), 1.0,
		HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return TRUE;
}

Bool HLAITalkIdleStare(I64 ent)
{//FIdleStare, talkmonster.cpp:959
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (!HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_STARE),
		6.25 + HLPartRand(1.25), 1.0, HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLAITalkNearestFriend(ent, TRUE);

	return TRUE;
}

Bool HLAITalkIdleSpeak(I64 ent)
{//FIdleSpeak, talkmonster.cpp:1026. Ask a question of a nearby friend, comment
 //on the player's wounds, or make a statement - in that order.
	CHLEntity	*e;
	F64			 duration;
	I64			 kind;
	I64			 other;
	U8			*idle_grp;
	U8			*quest_grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_PIDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_PQUESTION);
		duration  = 5.0 + HLPartRand(0.2);
	}
	else
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_IDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_QUESTION);
		duration  = 3.0 + HLPartRand(0.2);
	}

	//following a live player who is hurt: comment on it, worst wound first.
	//pev->max_health for a client is 100 and there is no per-client record
	//here, so the thresholds are against that figure
	if (hl_ai_talk[ent].follow == HLTLK_PLAYER && hl_ent_player >= 0 &&
		!hl_ent_player_dead)
	{
		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_HEAVY) &&
			hl_ent_player_health <= 100.0 / 8.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT3),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_HEAVY;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_MEDIUM) &&
			hl_ent_player_health <= 100.0 / 4.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT2),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_MEDIUM;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_LIGHT) &&
			hl_ent_player_health <= 100.0 / 2.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT1),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_LIGHT;
			return TRUE;
		}
	}

	//a friend within talking range answers three questions in four
	other = HLAITalkNearestFriend(ent, FALSE);

	if (other >= 0 && HLPartRandI(100) < 75)
	{
		if (HLAITalkPlaySentence(ent, quest_grp, duration, 1.0, HLATTN_IDLE))
		{
			hl_ai_talk[ent].talk_target = other;

			HLAITalkSetAnswer(other, ent);

			//the friend is held silent for as long as the question runs
			hl_ai_talk[other].stop_talk = hl_ai_talk[ent].stop_talk;

			hl_ai_talk[ent].n_speak++;

			return TRUE;
		}
	}

	//otherwise a statement, half the time, facing the player
	if (HLPartRandI(2))
	{
		other = HLAITalkNearestFriend(ent, TRUE);

		if (other != HLTLK_NOBODY)
		{
			if (HLAITalkPlaySentence(ent, idle_grp, duration, 1.0,
				HLATTN_IDLE))
			{
				hl_ai_talk[ent].talk_target = other;
				hl_ai_talk[ent].n_speak++;

				return TRUE;
			}
		}
	}

	//didn't speak: release the floor rather than holding it for the two
	//seconds PlaySentence would have added
	HLAITalkTalk(ent, 0.0);
	hl_ai_talk_wait = 0.0;

	return FALSE;
}

Bool HLAITalkCanPlaySentence(I64 ent, Bool disregard_state)
{//CTalkMonster::CanPlaySentence, talkmonster.cpp:949. Disregarding state means
 //anything not dead can be made to speak, which is CBaseMonster's own rule.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (disregard_state)
		return ToBool(e->health > 0.0);

	return HLAITalkOk(ent);
}

//--- the follow system ------------------------------------------------------

Bool HLAITalkIsFollowing(I64 ent)
{//IsFollowing, talkmonster.h:142: a target that is the player
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return ToBool(hl_ai_talk[ent].follow == HLTLK_PLAYER);
}

Bool HLAITalkCanFollow(I64 ent)
{//CanFollow, talkmonster.cpp:1395
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = hl_ai_mon_of[ent];

	//in a script that cannot be interrupted
	if (s >= 0 && hl_ai_mon[s].state == HLMSTATE_SCRIPT)
	{
		if (hl_ai_cine[ent].owner < 0)
			return FALSE;

		if (hl_entities[hl_ai_cine[ent].owner].spawnflags &
			HLAI_SF_NOINTERRUPT)
			return FALSE;
	}

	return ToBool(!HLAITalkIsFollowing(ent));
}

U0 HLAITalkStopFollowing(I64 ent, Bool clear_schedule)
{//StopFollowing, talkmonster.cpp:1364
	I64 kind;
	I64 s;

	if (!HLAITalkIsFollowing(ent))
		return;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_UNUSE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	}

	hl_ai_talk[ent].follow = HLTLK_NOBODY;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return;

	//RouteClear: stop him from walking toward the player
	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].move_speed = 0.0;

	if (clear_schedule)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}

	if (hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_COMBAT);
}

U0 HLAITalkStartFollowing(I64 ent)
{//StartFollowing, talkmonster.cpp:1383. Only the player leads.
	I64 kind;
	I64 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	//m_pCine->CancelScript
	if (hl_ai_cine[ent].owner >= 0)
		HLAICineRelease(hl_ai_cine[ent].owner);

	s = hl_ai_mon_of[ent];

	if (s >= 0 && hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_ALERT);

	hl_ai_talk[ent].follow      = HLTLK_PLAYER;
	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_USE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

	if (s >= 0)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}
}

U0 HLAITalkLimitFollowers(I64 keep, I64 max_followers)
{//LimitFollowers, talkmonster.cpp:726. Everyone past the limit is dropped, so
 //the player leads one scientist rather than a parade.
	I64 count = 0;
	I64 i;

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		if (i == keep || !hl_entities[i].in_use)
			goto qatlf_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatlf_next;

		if (!HLAITalkIsFollowing(i))
			goto qatlf_next;

		count++;

		if (count > max_followers)
			HLAITalkStopFollowing(i, TRUE);

qatlf_next:
	}
}

U0 HLAITalkFollowerUse(I64 ent)
{//FollowerUse, talkmonster.cpp:1412. The +USE half of the follow system.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	HLAITalkEnsure(ent);

	//no +USE during a scripted_sentence
	if (hl_ai_talk[ent].use_time > hl_ent_time)
		return;

	//pre-disaster followers can't be used. DeclineFollowing is the character's
	//own refusal line; CBarney has none, so only the scientist speaks
	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		if (HLAITalkKindOf(ent) == HLMON_SCIENTIST)
		{
			HLAITalkTalk(ent, 10.0);
			HLAITalkPlaySentence(ent, "SC_POK", 2.0, 1.0, HLATTN_NORM);
		}

		return;
	}

	if (!HLAITalkCanFollow(ent))
	{
		HLAITalkStopFollowing(ent, TRUE);
		return;
	}

	HLAITalkLimitFollowers(ent, 1);
	HLAITalkStartFollowing(ent);

	//don't say hi after you've started following
	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;
}

I64 HLAIFollowerUseInFront(F64 *player_org, F64 *forward)
{//the +use key against a talk monster. HLEntUseInFront in HLEntity.ZC only
 //considers classes with a use_fn and a monster has none, so the probe is
 //repeated here over the friend classes. Returns 1 when one was used.
 //
 //HL traces 64 units through CBasePlayer::PlayerUse; the box test here is the
 //same coarse probe HLEntUseInFront runs.
	CHLEntity	*e;
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 i;

	if (!hl_entities || !player_org || !forward)
		return 0;

	HLVecMA(player_org, 48.0, forward, probe);

	for (i = 0; i < 3; i++)
	{
		pmins[i] = probe[i] - 16.0;
		pmaxs[i] = probe[i] + 16.0;
	}

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->health <= 0.0)
			goto qafu_next;

		if (!HLAITalkIsFriendClass(e->classname))
			goto qafu_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qafu_next;

		HLAITalkFollowerUse(i);

		return 1;

qafu_next:
	}

	return 0;
}

//--- scripted_sentence ------------------------------------------------------

U0 HLAITalkPlayScripted(I64 ent, U8 *sentence, F64 duration, F64 volume,
	F64 atten, Bool concurrent, I64 listener)
{//PlayScriptedSentence, talkmonster.cpp:1193. m_useTime blocks +USE for the
 //length of the line, so a scripted speech cannot be interrupted by walking up
 //and pressing use.
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (!concurrent)
		HLAITalkShutUpFriends(ent);

	hl_ai_talk[ent].use_time    = hl_ent_time + duration;
	hl_ai_talk[ent].talk_target = listener;

	HLAITalkPlaySentence(ent, sentence, duration, volume, atten);
}

Bool HLAIAcceptableSpeaker(CHLEntity *script, I64 who)
{//CScriptedSentence::AcceptableSpeaker, scripted.cpp:1103
	Bool override;

	if (who < 0 || who >= HLENT_MAX)
		return FALSE;

	//not a monster: anything else the map points at can speak
	if (HLAITalkKindOf(who) < 0 && hl_ai_mon_of[who] < 0)
		return TRUE;

	//SF_SENTENCE_FOLLOWERS: only say it if the speaker is following the player
	if (script->spawnflags & HLAI_SF_SENTENCE_FOLLOWERS)
	{
		if (!HLAITalkIsFollowing(who))
			return FALSE;
	}

	override = ToBool(script->spawnflags & HLAI_SF_SENTENCE_INTERRUPT);

	return HLAITalkCanPlaySentence(who, override);
}

I64 HLAISentenceSpeaker(CHLEntity *script)
{//CScriptedSentence::FindEntity, scripted.cpp:1140, with AcceptableSpeaker
 //applied. The targetname pass walks every match rather than stopping at the
 //first, so a busy scientist does not veto the line for a free one.
	F64	d[3];
	I64	i;

	if (!script->ai_entity[0])
		return -1;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qass_next;

		if (StrCompare(hl_entities[i].targetname, script->ai_entity))
			goto qass_next;

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next:
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qass_next2;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qass_next2;

		//a radius of 0 means anywhere in the map
		if (script->ai_radius > 0.0)
		{
			HLVecSub(hl_entities[i].origin, script->origin, d);

			if (HLVecLength(d) > script->ai_radius)
				goto qass_next2;
		}

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next2:
	}

	return -1;
}

I64 HLAISentenceListener(CHLEntity *script, I64 speaker)
{//the listener half of StartSentence, scripted.cpp:1204. The listener becomes
 //m_hTalkTarget, so it is what the speaker's head turns towards.
 //
 //Deviation: CHLEntity carries no "listener" key, so only the player form is
 //resolved. UTIL_FindEntityGeneric searches 4096 units for a listener named
 //"player" and m_flRadius for any other name.
	CHLEntity	*sp;
	F64			 d[3];

	sp = HLEntGet(speaker);

	if (!sp || hl_ent_player < 0 || hl_ent_player_dead)
		return HLTLK_NOBODY;

	HLVecSub(hl_snd_listener, sp->origin, d);

	if (HLVecLength(d) > HLAI_SENTENCE_PLAYER_RADIUS)
		return HLTLK_NOBODY;

	return HLTLK_PLAYER;
}

//--- the idle talk driver ---------------------------------------------------

//how often a talker re-runs the stack. The SDK reaches it once per schedule
//selection, which for slIdleStand is a random wait of up to five seconds
#define HLAI_TALK_PERIOD	0.5

U0 HLAITalkIdealYaw(I64 s, F64 dt)
{//TASK_TLK_IDEALYAW, talkmonster.cpp:412-433, followed by TASK_FACE_IDEAL. Both
 //sit ahead of TASK_TLK_EYECONTACT in tlIdleSpeak and tlIdleResponse.
 //
 //The body turns until the listener is within HLAI_TLK_YAW_SLACK of its facing
 //and the head covers what is left. This is what keeps the head inside the
 //controller's range: with the body fixed, a listener 120 degrees round asks the
 //head for 120 and HLStudioCtlSetting pins it at 60.
 //
 //Recomputed per tick rather than latched into pev->ideal_yaw, so it stops of
 //its own accord once the slack is met.
	CHLEntity	*e;
	F64			 point[3];
	F64			 yaw;
	F64			 step;
	I64			 ent;

	if (s < 0)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	//a monster on a route, fighting, under a script or dead does not stand and
	//address anyone
	if (hl_ai_mon[s].have_goal ||
		hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (!HLAITalkIsTalking(ent))
		return;

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	//the listener's eye, matching HLAITalkFaceTarget, so head and body aim at
	//one point
	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	//what the body owes past the slack
	if (yaw < 0.0)
	{
		yaw += HLAI_TLK_YAW_SLACK;

		if (yaw > 0.0)
			yaw = 0.0;
	}
	else
	{
		yaw -= HLAI_TLK_YAW_SLACK;

		if (yaw < 0.0)
			yaw = 0.0;
	}

	if (yaw == 0.0)
		return;

	step = HLAI_TLK_YAW_SPEED * dt;

	if (yaw < 0.0)
	{
		if (step > -yaw)
			step = -yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > yaw)
			step = yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}
}

U0 HLAITalkThink(I64 s, F64 dt)
{//the talk stack CTalkMonster::GetScheduleOfType runs for SCHED_IDLE_STAND,
 //talkmonster.cpp:1233-1290, in the SDK's order. Driven from the think because
 //this port's selector is a table rather than a per-monster override.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 point[3];
	F64			 d[3];
	I64			 ent;
	I64			 kind;

	if (!e)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return;

	HLAITalkEnsure(ent);

	//the body turn comes first: HLAITalkFaceTarget reads e->angles[1] and would
	//otherwise spend one tick on a stale facing
	HLAITalkIdealYaw(s, dt);

	//eye contact runs every tick, not on the talk cadence: a head that only
	//moves twice a second reads as a twitch
	HLAITalkFaceTarget(ent);

	//combat, script and death have their own speech
	if (hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + HLAI_TALK_PERIOD;

	//an owed answer comes before anything this one might start
	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		hl_ai_talk[ent].response = 0.0;

		if (HLAITalkIdleRespond(ent))
			return;
	}

	//if never seen the player, try to greet him
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO))
	{
		if (HLAITalkIdleHello(ent))
			return;
	}

	//sustained light wounds
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_LIGHT) &&
		e->health <= e->max_health * 0.75)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_WOUND),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
		hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_LIGHT;
		return;
	}

	//sustained heavy wounds
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_HEAVY) &&
		e->health <= e->max_health * 0.5)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_MORTAL),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
		hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_HEAVY;
		return;
	}

	//talk about the world. The chance falls off with how much this one has
	//already said, which is what stops one character monologuing
	if (HLAITalkOk(ent) && !HLPartRandI(hl_ai_talk[ent].n_speak * 2 + 1))
	{
		if (HLAITalkIdleSpeak(ent))
			return;
	}

	//the player standing close gets a remark
	if (HLAITalkIsTalking(ent) || HLPartRandI(7))
		return;

	if (hl_ent_player < 0 || hl_ent_player_dead)
		return;

	HLVecCopy(hl_snd_listener, point);
	HLVecSub(point, e->origin, d);
	d[2] = 0.0;

	if (HLVecLength(d) >= HLAI_TLK_STARE_DIST)
		return;

	//Deviation: the SDK also requires the player to be facing the monster,
	//through UTIL_DotPoints on the client's v_forward. The view angles live in
	//HL1.ZC, which compiles later, so proximity inside the monster's own cone
	//stands in for it - the monster notices being loomed over, not being
	//looked at.
	if (!HLAIInViewCone(s, point))
		return;

	HLAITalkIdleStare(ent);
}

U0 HLAISitScientistThink(I64 ent)
{//CSittingScientist::SittingThink, scientist.cpp:1303. No AI slot, no routing
 //and no fighting: it sits, turns its head and speaks.
	CHLEntity	*e = HLEntGet(ent);
	F64			 point[3];
	F64			 yaw;
	I64			 roll;
	I64			 who;

	if (!e || !e->studio || e->health <= 0.0)
		return;

	//a scripted_sequence holding this one owns its sequence
	if (ent < HLENT_MAX && hl_ai_cine[ent].owner >= 0)
		return;

	HLAITalkEnsure(ent);

	//eye contact is per tick; the rest is the SDK's own 0.1s think.
	//
	//Deviation: the SDK's sitting scientist turns its head once, at the moment
	//it asks a question, scientist.cpp:1436. Holding the head every tick with no
	//body to turn lets a listener standing behind it drive the controller onto
	//its rail, so the sitting envelope bounds it
	HLAITalkFaceTarget(ent, FALSE, HLAI_TLK_SIT_HEAD_MAX);

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + 0.1;

	//try to greet the player
	if (HLAITalkIdleHello(ent))
	{
		who = HLAITalkNearestFriend(ent, TRUE);

		if (who != HLTLK_NOBODY && HLAITalkPointOf(who, point))
		{
			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			//the look takes are the turn; the controller goes back to centre
			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);

			HLAITalkHeadSet(ent, 0.0);
		}

		return;
	}

	//m_fSequenceFinished. StudioFrameAdvance raises it on a wrap as well as on
	//a one-shot ending, so a looping sitting take finishes once per pass
	if (hl_ent_time - e->anim_start <
		HLStudioSeqDuration(e->studio, e->seq))
		return;

	roll = HLPartRandI(100);

	hl_ai_talk[ent].head_turn = 0.0;

	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		//respond to a question
		HLAITalkIdleRespond(ent);
		HLAISetSequence(e, "sitscared", FALSE);
		hl_ai_talk[ent].response = 0.0;
	}
	else if (roll < 30)
	{
		if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
			who = HLAITalkNearestFriend(ent, FALSE);
		else
			who = HLAITalkNearestFriend(ent, TRUE);

		if (!HLAITalkIdleSpeak(ent) || who == HLTLK_NOBODY)
		{
			//RANDOM_LONG(0,8) * 10 - 40: nine steps of ten degrees, centred
			hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;
			HLAISetSequence(e, "sitting3", FALSE);
		}
		else
		{
			//only turn the head if we spoke
			HLAITalkPointOf(who, point);

			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);
		}
	}
	else if (roll < 60)
	{
		HLAISetSequence(e, "sitting3", FALSE);
		hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;

		if (HLPartRandI(100) < 5)
			HLAITalkIdleSpeak(ent);
	}
	else if (roll < 80)
		HLAISetSequence(e, "sitting2", FALSE);
	else
		HLAISetSequence(e, "sitscared", FALSE);

	HLAITalkHeadSet(ent, hl_ai_talk[ent].head_turn);
}

Bool HLAICanMelee(I64 s, F64 dist)
{//CheckMeleeAttack1: in reach, refire up, and roughly facing
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee_range <= 0.0)
		return FALSE;

	if (dist > mi->melee_range)
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanMelee2(I64 s, F64 dist)
{//CheckMeleeAttack2: the heavier swing, which every monster that has one picks
 //at the same reach as the lighter
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee2_range <= 0.0)
		return FALSE;

	if (dist > mi->melee2_range)
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanRange(I64 s, F64 dist)
{//CheckRangeAttack1: inside the band, refire up, ammo left, no squadmate in
 //the line, and a clear sight line. The SDK traces from the gun position,
 //this from the eye.
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 feet[3];
	F64			 eye[3];

	if (mi->range_max <= 0.0)
		return FALSE;

	if (dist < mi->range_min || dist > mi->range_max)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].next_attack)
		return FALSE;

	//bits_COND_NO_AMMO_LOADED. Only the grunt carries a clip
	if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
		return FALSE;

	//NoFriendlyFire: a grunt will not shoot through the man in front of him
	if (!HLAINoFriendlyFire(s))
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	return HLAIVisible(s, eye);
}

I64 HLAISelectSchedule(I64 s)
{//CBaseMonster::GetSchedule, per state, with the per-monster GetSchedule
 //overrides folded in through the table: what differs between CHGrunt's and
 //CBullsquid's is which slots gate the attack and whether there is a clip,
 //both of which are rows here
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 d[3];
	F64			 dist;

	if (!e)
		return HLSCHED_IDLE_STAND;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return HLSCHED_DIE;

	if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
	{
		if (!hl_ai_mon[s].have_enemy)
		{
			HLAISetState(s, HLMSTATE_ALERT);
			return HLSCHED_ALERT_STAND;
		}

		HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, d);
		dist = HLVecLength(d);

		//a monster with no attack runs. CScientist's SelectSchedule is this
		//plus a stack of talk behaviours
		if (mi->flees)
			return HLSCHED_TAKE_COVER;

		//bits_COND_NO_AMMO_LOADED beats everything else CHGrunt::GetSchedule
		//tests, which is why a grunt reloads in the open
		if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
			return HLSCHED_RELOAD;

		//CBarney::GetSchedule draws the pistol before its first shot
		if (!hl_ai_mon[s].gun_drawn &&
			HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_ARM))
		{
			hl_ai_mon[s].gun_drawn = TRUE;
			return HLSCHED_ARM_WEAPON;
		}

		//the heavier swing first when both are in reach, as every
		//CheckMeleeAttack2 is tested before CheckMeleeAttack1 in the SDK's
		//condition order
		if (HLAICanMelee2(s, dist))
			return HLSCHED_MELEE_ATTACK2;

		if (HLAICanMelee(s, dist))
			return HLSCHED_MELEE_ATTACK1;

		if (HLAICanRange(s, dist))
		{
			//the squad gate. CHGrunt::GetSchedule takes an engage slot before
			//standing up to fire and stands off when there is none, so two of
			//a fireteam shoot and the rest hold or move.
			if (!mi->slot_attack || HLAIOccupySlot(s, mi->slot_attack))
				return HLSCHED_RANGE_ATTACK1;

			//no slot: get out of the doorway rather than queue in it
			if (hl_ai_mon[s].in_cover)
				return HLSCHED_STANDOFF;

			return HLSCHED_TAKE_COVER;
		}

		//in range but not ready to swing or shoot: stand and face rather than
		//chase. Otherwise the chase schedule restarts every few ticks while
		//the refire runs down, which reads as running on the spot; for a
		//ranged monster it is also what holds barney and the grunts at a
		//firing line instead of closing to arm's length.
		if (hl_ent_time < hl_ai_mon[s].next_attack)
		{
			if (mi->melee_range > 0.0 && dist <= mi->melee_range)
				return HLSCHED_COMBAT_FACE;

			if (mi->range_max > 0.0 && dist >= mi->range_min &&
				dist <= mi->range_max)
				return HLSCHED_COMBAT_STAND;
		}

		//out of contact for a while but not yet forgotten: hold and watch
		//instead of charging the last known position over and over
		if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY * 0.5)
			return HLSCHED_STANDOFF;

		return HLSCHED_CHASE_ENEMY;
	}

	//following the player, in IDLE or ALERT: face and follow, the loop
	//CScientist::GetSchedule enters at scientist.cpp:985. A dead leader ends
	//the follow rather than being chased around as a corpse.
	if (hl_ai_mon[s].ent >= 0 && hl_ai_mon[s].ent < HLENT_MAX &&
		HLAITalkIsFollowing(hl_ai_mon[s].ent))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			HLAITalkStopFollowing(hl_ai_mon[s].ent, FALSE);
		else if (!hl_ai_mon[s].have_enemy)
			return HLSCHED_TARGET_FACE;
	}

	if (hl_ai_mon[s].state == HLMSTATE_ALERT)
	{
		if (hl_ai_mon[s].have_enemy)
			return HLSCHED_ALERT_FACE;

		//bits_COND_HEAR_SOUND. A danger sound is run from; anything else is
		//walked to, which is CBaseMonster::GetSchedule's own split
		if (hl_ai_mon[s].heard >= 0)
		{
			if (hl_ai_mon[s].heard_type & HLSOUND_DANGER)
				return HLSCHED_COVER_SOUND;

			return HLSCHED_INVEST_SOUND;
		}

		return HLSCHED_ALERT_STAND;
	}

	//MONSTERSTATE_IDLE. A noise wakes it into ALERT rather than being acted
	//on from here, which is what CBaseMonster::GetIdealState does
	if (hl_ai_mon[s].heard >= 0)
	{
		HLAISetState(s, HLMSTATE_ALERT);
		return HLSCHED_ALERT_STAND;
	}

	return HLSCHED_IDLE_STAND;
}

U0 HLAIMonThink(I64 s, F64 dt)
{//CBaseMonster::MonsterThink for one monster
 //
 //the SDK runs this on a 0.1s think and lets the engine's monster mover
 //integrate movement in between. There is no such mover here - HLAIMoveStep is
 //the movement - so it runs on the server tick. Every decision it makes is
 //time-based, so the cadence change is invisible.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 gib_dir[3];
	F64			 over;
	I64			 bits;
	Bool		 gib;
	Bool		 human;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//--- death, first: nothing else applies to a corpse ---
	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
	{
		HLAIRunSchedule(s, dt);
		return;
	}

	if (e->health <= 0.0)
	{
		hl_ai_mon[s].last_health = 0.0;
		hl_ai_mon_kills++;

		//a corpse is bits_SOUND_CARCASS for half a minute, which is what a
		//bullsquid comes to eat. CSoundEnt's own carcass lifetime
		HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);

		//CBaseMonster::TakeDamage reads bitsDamageType where health crosses
		//zero and picks GIB_ALWAYS, GIB_NEVER or GIB_NORMAL from it
		//(dlls/combat.cpp:911-925); ShouldGibMonster (:535) turns GIB_NORMAL
		//into a gib only below GIB_HEALTH_VALUE.
		//
		//HLEntTakeDamageType clamps a dead entity's health to zero, so the
		//overkill comes from the damage note and not from e->health
		bits = HLDmgNoteBits(hl_ai_mon[s].ent);
		over = HLDmgNoteHealth(hl_ai_mon[s].ent);
		gib  = FALSE;

		if ((bits & HLDMG_ALWAYSGIB) != 0)
			gib = TRUE;
		else if ((bits & HLDMG_NEVERGIB) == 0 && over < HLGIB_HEALTH_VALUE)
			gib = TRUE;

		if (gib)
		{
			//HasHumanGibs, dlls/combat.cpp:256 - hgibs.mdl for the human
			//classes, agibs.mdl for everything else
			human = ToBool(mi->classify == HLCLASS_HUMAN_MILITARY ||
				mi->classify == HLCLASS_HUMAN_PASSIVE ||
				mi->classify == HLCLASS_PLAYER_ALLY);

			//GibMonster opens with the splat, dlls/combat.cpp:307, on
			//CHAN_WEAPON
			HLSndPlayAt("common/bodysplat.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, HLCHAN_WEAPON);

			//g_vecAttackDir is not tracked; the gibs are thrown straight up,
			//which is what a victim killed by radius damage gets in the SDK
			HLVecSet(gib_dir, 0.0, 0.0, 1.0);

			//four pieces either way. The velocity scale reads the victim's
			//health, which is the overkill and not max_health
			HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir, over,
				HLGIB_DEATH_COUNT, human, mi->blood, hl_ent_time);

			//only humans throw skulls, dlls/combat.cpp:310-315
			if (human)
				HLGibSpawnHeadGib(e->origin, e->origin, over, mi->blood,
					hl_ent_time);
		}

		HLAISetState(s, HLMSTATE_DEAD);
		HLAISetSchedule(s, HLSCHED_DIE);
		return;
	}

	//--- damage taken since the last tick ---
	//
	//HLEntity.ZC compiles first, so there is no hook in HLEntTakeDamage and the
	//health drop is detected instead. bits_COND_LIGHT_DAMAGE in the SDK: it
	//flinches, and goes alert if it had no enemy.
	if (e->health < hl_ai_mon[s].last_health)
	{
		hl_ai_mon[s].last_health = e->health;

		if (hl_ai_mon[s].state == HLMSTATE_IDLE)
			HLAISetState(s, HLMSTATE_ALERT);

		//being shot at is a combat sound in its own right, which is how a
		//squad two rooms away learns there is a fight
		HLAIInsertSound(HLSOUND_COMBAT, e->origin, 384.0, 0.3);

		//not while attacking: a flinch on every tick of incoming fire means the
		//attack never lands
		if (hl_ai_mon[s].sched != HLSCHED_MELEE_ATTACK1 &&
			hl_ai_mon[s].sched != HLSCHED_MELEE_ATTACK2 &&
			hl_ai_mon[s].sched != HLSCHED_RANGE_ATTACK1 &&
			hl_ai_mon[s].sched != HLSCHED_RANGE_ATTACK2 &&
			hl_ai_mon[s].sched != HLSCHED_SMALL_FLINCH &&
			hl_ai_mon[s].sched != HLSCHED_ALERT_SM_FLINCH)
		{
			//slAlertSmallFlinch turns to face what hit it afterwards;
			//slSmallFlinch does not. The SDK picks by state
			if (hl_ai_mon[s].state == HLMSTATE_ALERT)
				HLAISetSchedule(s, HLSCHED_ALERT_SM_FLINCH);
			else
				HLAISetSchedule(s, HLSCHED_SMALL_FLINCH);
		}
	}

	hl_ai_mon[s].last_health = e->health;

	//--- settle on the floor ---
	//
	//DROP_TO_FLOOR, as every CBaseMonster::Spawn does. Mappers place monsters a
	//few units clear of the ground and nothing integrates gravity for a STEP
	//entity here, so without this they hover for the whole level.
	if (!hl_ai_mon[s].settled)
	{
		hl_ai_mon[s].settled = TRUE;

		//a MOVETYPE_FLY monster holds the height the mapper put it at
		if (!mi->flies && HLAIDropToFloor(e, e->origin, e->origin))
			HLEntSetAbsBox(e);
	}

	//--- squad formation ---
	//
	//CSquadMonster::StartMonster runs one SquadRecruit on the first think,
	//never again: a squad is whoever was standing together when the map
	//started, and a reinforcement that walks in later joins nothing.
	if (!hl_ai_mon[s].squad_tried)
	{
		hl_ai_mon[s].squad_tried = TRUE;

		if (mi->squads)
			HLAISquadRecruit(s, HLAI_SQUAD_RADIUS, HLAI_SQUAD_MAX - 1);
	}

	//--- eye blink ---
	//
	//pev->skin picks a skin family and the eye is a family swap: houndeyet.mdl
	//carries three families differing only in eye.bmp, bullsquidt.mdl two.
	//
	//m_fDontBlink, which houndeye.cpp raises while the monster sleeps, has no
	//counterpart: nothing here puts a houndeye to sleep.
	if (hl_ent_time >= hl_ai_mon[s].next_blink)
	{
		hl_ai_mon[s].next_blink = hl_ent_time + 0.1;

		//houndeye.cpp:856-866. HOUNDEYE_EYE_FRAMES is 4, houndeye.cpp:38, so a
		//blink starts at family 3 and counts down one family per think
		if (hl_ai_mon[s].kind == HLMON_HOUNDEYE)
		{
			if (e->skin == 0)
			{
				if (HLPartRandI(128) == 0)
					e->skin = 3;
			}
			else
				e->skin--;
		}

		//bullsquid.cpp:779-789: the eye is cleared every think and reopened by
		//the roll that follows, so a blink lasts exactly one think
		if (hl_ai_mon[s].kind == HLMON_BULLSQUID)
		{
			e->skin = 0;

			if (HLPartRandI(40) == 0)
				e->skin = 1;
		}
	}

	//--- sensing ---
	if (hl_ent_time >= hl_ai_mon[s].next_look)
	{
		hl_ai_mon[s].next_look = hl_ent_time + HLAI_LOOK_PERIOD;
		HLAILook(s);
		HLAIListen(s);
	}

	if (hl_ai_mon[s].have_enemy)
	{
		//CheckEnemy drops m_hEnemy after this long with no sight line, which
		//stops a monster staring at a wall
		if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY)
		{
			hl_ai_mon[s].have_enemy = FALSE;

			if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
				HLAISetState(s, HLMSTATE_ALERT);
		}
		else if (hl_ai_mon[s].state != HLMSTATE_COMBAT)
		{
			//first sight: wake-up beat, then combat
			//
			//CSquadMonster::GetIdealState calls SquadMakeEnemy on
			//bits_COND_NEW_ENEMY, so the whole squad turns on what one member
			//saw rather than each finding it separately
			HLAISquadMakeEnemy(s, hl_ai_mon[s].enemy);

			HLAISetState(s, HLMSTATE_COMBAT);
			HLAISetSchedule(s, HLSCHED_WAKE_ANGRY);
		}
	}

	//--- idle noises ---
	//
	//HL calls IdleSound from inside the idle schedules. Driving it from the
	//think instead keeps it out of combat, where the attack and alert lines
	//take the channel
	if (hl_ai_mon[s].state != HLMSTATE_COMBAT && mi->snd_idle[0])
	{
		if (hl_ent_time >= hl_ai_mon[s].next_idle_snd)
		{
			HLAIMonSound(s, mi->snd_idle);
			hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
				ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));
		}
	}

	//--- speech ---
	//
	//CTalkMonster's idle stack. A monster that is not a talker returns from
	//this at once.
	HLAITalkThink(s, dt);

	//--- schedule ---
	if (hl_ai_mon[s].sched == HLSCHED_NONE || hl_ai_mon[s].sched_done)
		HLAISetSchedule(s, HLAISelectSchedule(s));

	HLAIRunSchedule(s, dt);
}

U0 HLAIMonsterFrame(F64 dt)
{//every tracked monster, one tick
	CHLEntity	*e;
	I64			 s;
	I64			 i;

	HLAIMonSync;

	if (!hl_ai_mon_count || !hl_map)
		return;

	//--- who is under script control this tick ---
	//
	//m_pCine, which here is hl_ai_cine[ent].owner. It is set from the moment a
	//script possesses its actor, not from the moment the play take starts: an
	//actor posed in m_iszIdle on its mark is already the script's and must not
	//be walked off it by the selector.
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		s = hl_ai_mon[i].ent;

		if (s < 0 || s >= HLENT_MAX)
			hl_ai_mon[i].scripted = FALSE;
		else
			hl_ai_mon[i].scripted = ToBool(hl_ai_cine[s].owner >= 0);
	}

	//--- think ---
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].ent < 0)
			goto qamf_next;

		e = HLEntGet(hl_ai_mon[i].ent);

		if (!e)
		{
			//the entity system removed it: HLEntTakeDamage queues
			//HLM_BREAK_DIE and HLBreakableDie clears in_use - right for glass,
			//wrong for a monster, and that call is in HLEntity.ZC. Put the
			//corpse back, inert, so it falls over instead of blinking out.
			if (!hl_ai_mon_revive || hl_ai_mon[i].state == HLMSTATE_DEAD)
				goto qamf_next;

			if (hl_ai_mon[i].ent >= hl_num_entities)
				goto qamf_next;

			e = &hl_entities[hl_ai_mon[i].ent];

			e->in_use     = TRUE;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->takedamage = HLDMG_TAKE_NO;
			e->think_fn   = HLM_NONE;
			e->next_think = 0.0;
			e->health     = 0.0;
		}

		if (hl_ai_mon[i].scripted)
		{
			//MONSTERSTATE_SCRIPT: the script's task list runs instead of the
			//AI's. CineCleanup drops the schedule and returns it to IDLE.
			HLAISetState(i, HLMSTATE_SCRIPT);
			HLAICineActorTick(i, dt);
			goto qamf_next;
		}

		if (hl_ai_mon[i].state == HLMSTATE_SCRIPT)
			HLAISetState(i, HLMSTATE_IDLE);

		if (hl_ai_mon[i].state == HLMSTATE_NONE)
			HLAISetState(i, HLMSTATE_IDLE);

		HLAIMonThink(i, dt);

qamf_next:
	}
}

//--- ReportAIState ----------------------------------------------------------
//
// CBaseMonster::ReportAIState, monsters.cpp, which impulse 103 reaches through
// player.cpp. The names come out of comparison chains rather than U8* tables:
// adjacent string literals concatenate and truncate at the first NUL on this
// compiler, so a table of literals collapses to one entry.

U8 *HLAIStateName(I64 state)
{//pStateNames[] in ReportAIState. The SDK's array is in enum order, which is
 //None Idle Combat Alert Hunt Prone Scripted Dead; MONSTERSTATE_ itself has
 //Alert before Combat, so the SDK prints two of them wrongly. The names here
 //follow the enum
	if (state == HLMSTATE_IDLE)		return "Idle";
	if (state == HLMSTATE_ALERT)	return "Alert";
	if (state == HLMSTATE_COMBAT)	return "Combat";
	if (state == HLMSTATE_SCRIPT)	return "Scripted";
	if (state == HLMSTATE_DEAD)		return "Dead";

	return "None";
}

U8 *HLAISchedName(I64 sched)
{//the pName field of each Schedule_t in defaultai.cpp
	if (sched == HLSCHED_IDLE_STAND)		return "IdleStand";
	if (sched == HLSCHED_ALERT_STAND)		return "AlertStand";
	if (sched == HLSCHED_ALERT_FACE)		return "AlertFace";
	if (sched == HLSCHED_WAKE_ANGRY)		return "WakeAngry";
	if (sched == HLSCHED_CHASE_ENEMY)		return "ChaseEnemy";
	if (sched == HLSCHED_MELEE_ATTACK1)		return "MeleeAttack1";
	if (sched == HLSCHED_RANGE_ATTACK1)		return "RangeAttack1";
	if (sched == HLSCHED_TAKE_COVER)		return "TakeCoverFromEnemy";
	if (sched == HLSCHED_SMALL_FLINCH)		return "SmallFlinch";
	if (sched == HLSCHED_DIE)				return "Die";
	if (sched == HLSCHED_IDLE_WALK)			return "IdleWalk";
	if (sched == HLSCHED_ALERT_SM_FLINCH)	return "AlertSmallFlinch";
	if (sched == HLSCHED_INVEST_SOUND)		return "InvestigateSound";
	if (sched == HLSCHED_COMBAT_FACE)		return "CombatFace";
	if (sched == HLSCHED_COMBAT_STAND)		return "CombatStand";
	if (sched == HLSCHED_CHASE_FAILED)		return "ChaseEnemyFailed";
	if (sched == HLSCHED_STANDOFF)			return "Standoff";
	if (sched == HLSCHED_RELOAD)			return "Reload";
	if (sched == HLSCHED_ARM_WEAPON)		return "ArmWeapon";
	if (sched == HLSCHED_MELEE_ATTACK2)		return "MeleeAttack2";
	if (sched == HLSCHED_RANGE_ATTACK2)		return "RangeAttack2";
	if (sched == HLSCHED_SPECIAL_ATTACK1)	return "SpecialAttack1";
	if (sched == HLSCHED_COVER_SOUND)		return "TakeCoverFromBestSound";
	if (sched == HLSCHED_COVER_ORIGIN)		return "TakeCoverFromOrigin";
	if (sched == HLSCHED_COWER)				return "Cower";
	if (sched == HLSCHED_VICTORY_DANCE)		return "VictoryDance";
	if (sched == HLSCHED_AMBUSH)			return "Ambush";
	if (sched == HLSCHED_BARNACLE_GRAB)		return "BarnacleVictim";
	if (sched == HLSCHED_BARNACLE_CHOMP)	return "BarnacleChomp";
	if (sched == HLSCHED_FAIL)				return "Fail";

	return "No Schedule";
}

U8 *HLAIActName(I64 act)
{//activity_map[] in monsters.cpp, restricted to the activities this port has
	if (act == HLACT_IDLE)			return "ACT_IDLE";
	if (act == HLACT_WALK)			return "ACT_WALK";
	if (act == HLACT_RUN)			return "ACT_RUN";
	if (act == HLACT_MELEE)			return "ACT_MELEE_ATTACK1";
	if (act == HLACT_MELEE2)		return "ACT_MELEE_ATTACK2";
	if (act == HLACT_RANGE)			return "ACT_RANGE_ATTACK1";
	if (act == HLACT_RANGE2)		return "ACT_RANGE_ATTACK2";
	if (act == HLACT_DIE)			return "ACT_DIESIMPLE";
	if (act == HLACT_FLINCH)		return "ACT_SMALL_FLINCH";
	if (act == HLACT_RELOAD)		return "ACT_RELOAD";
	if (act == HLACT_COMBAT_IDLE)	return "ACT_COMBAT_IDLE";
	if (act == HLACT_SIGNAL)		return "ACT_SIGNAL1";
	if (act == HLACT_THREAT)		return "ACT_THREAT_DISPLAY";
	if (act == HLACT_VICTORY)		return "ACT_VICTORY_DANCE";
	if (act == HLACT_COWER)			return "ACT_COWER";
	if (act == HLACT_ARM)			return "ACT_ARM";
	if (act == HLACT_EAT)			return "ACT_EAT";
	if (act == HLACT_SPECIAL)		return "ACT_SPECIAL_ATTACK1";
	if (act == HLACT_BARN_HIT)		return "ACT_BARNACLE_HIT";
	if (act == HLACT_BARN_PULL)		return "ACT_BARNACLE_PULL";
	if (act == HLACT_BARN_CHOMP)	return "ACT_BARNACLE_CHOMP";
	if (act == HLACT_BARN_CHEW)		return "ACT_BARNACLE_CHEW";

	return "ACT_INVALID";
}

U0 HLAIMonReportOne(I64 i)
{//one monster, in the layout ReportAIState prints
	CHLEntity	*e = HLEntGet(hl_ai_mon[i].ent);
	I64			 slot;
	I64			 task;

	if (!e)
		return;

	"%s: ", e->classname;
	"State: %s, ", HLAIStateName(hl_ai_mon[i].state);
	"Activity %s, ", HLAIActName(hl_ai_mon[i].activity);

	if (hl_ai_mon[i].sched > HLSCHED_NONE &&
		hl_ai_mon[i].sched < HLSCHED_COUNT)
	{
		"Schedule %s, ", HLAISchedName(hl_ai_mon[i].sched);

		if (hl_ai_mon[i].task < hl_ai_sched_len[hl_ai_mon[i].sched])
		{
			slot = hl_ai_mon[i].sched * HLAI_SCHED_TASKS + hl_ai_mon[i].task;
			task = hl_ai_sched_task[slot];

			"Task %d (#%d), ", task, hl_ai_mon[i].task;
		}
	}
	else
		"No Schedule, ";

	if (hl_ai_mon[i].have_enemy)
	{
		if (HLAITargetIsPlayer(hl_ai_mon[i].enemy))
			"\nEnemy is player";
		else
			"\nEnemy is %s", hl_entities[hl_ai_mon[i].enemy].classname;
	}
	else
		"No enemy";

	if (hl_ai_mon[i].have_goal && hl_ai_mon[i].move_speed > 0.0)
		" Moving ";

	//the squad line CSquadMonster adds to the report
	if (!HLAIInSquad(i))
		"not ";

	"In Squad, ";

	if (!HLAIIsLeader(i))
		"not ";

	"Leader.";

	"\n";
	"Yaw speed:%3.1f,Health: %3.1f\n",
		hl_ai_mon_info[hl_ai_mon[i].kind].yaw_speed, e->health;

	//not in the SDK's report: this port's own state, which has no other way
	//out. Slots, ammo and the last sound heard are what a squad fight turns on
	slot = HLAISquadLeader(i);

	"  slot %d of %d, ammo %d, heard %d at %.0f %.0f %.0f\n",
		hl_ai_mon[i].my_slot, hl_ai_mon[slot].squad_slots, hl_ai_mon[i].ammo,
		hl_ai_mon[i].heard_type, hl_ai_mon[i].heard_pos[0],
		hl_ai_mon[i].heard_pos[1], hl_ai_mon[i].heard_pos[2];
}

U0 HLAIMonReport()
{//dump AI state for every monster. Distinguishes "no monsters registered" from
 //"registered and idle", which look identical on screen
	I64 i;
	I64 live = 0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire > hl_ent_time)
			live++;
	}

	"HLAI: %d monsters tracked, %d dead, %d sounds in the world\n",
		hl_ai_mon_count, hl_ai_mon_kills, live;

	for (i = 0; i < hl_ai_mon_count; i++)
		HLAIMonReportOne(i);
}

//--- the frame --------------------------------------------------------------

U0 HLAISentenceFrame(I64 self)
{//one scripted_sentence, one tick: Spawn, FindThink and DelayThink,
 //scripted.cpp:1023-1099.
 //
 //Deviations, both from keys CHLEntity does not carry: "attenuation"
 //(pev->impulse, scripted.cpp:1004) always reads as ATTN_IDLE, the SDK's
 //default case, and "refire" (m_flRepeat, scripted.cpp:1000) reads as zero, so
 //a sentence that cannot find a speaker retries every half second rather than
 //on the mapper's interval.
	CHLEntity	*e = HLEntGet(self);
	F64			 duration;
	F64			 volume;
	I64			 who;
	I64			 listener;
	Bool		 concurrent;

	if (!e || self >= HLENT_MAX)
		return;

	//Spawn: a scripted_sentence nothing can name starts a second after the map
	if (!hl_ai_talk[self].inited)
	{
		hl_ai_talk[self].inited = TRUE;

		if (!e->targetname[0])
		{
			e->toggle_state            = HLTS_GOING_DOWN;
			hl_ai_talk[self].next_think = hl_ent_time + 1.0;
		}
	}

	if (e->toggle_state != HLTS_GOING_DOWN)
		return;

	//DelayThink holds m_active down for m_flDuration + m_flRepeat after a line
	if (hl_ent_time < hl_ai_talk[self].next_think)
		return;

	who = HLAISentenceSpeaker(e);

	if (who < 0)
	{
		//nobody acceptable: try again. m_flRepeat + 0.5 in the SDK
		hl_ai_talk[self].next_think = hl_ent_time + 0.5;
		return;
	}

	duration = e->duration;

	//KeyValue scales the "volume" key by 0.1; no key means full volume
	volume = e->volume * 0.1;

	if (volume <= 0.0)
		volume = 1.0;

	//StartSentence, scripted.cpp:1193: bConcurrent is set when the CONCURRENT
	//spawnflag is CLEAR, and PlayScriptedSentence silences the speaker's
	//friends only when bConcurrent is false. The flag therefore reads
	//backwards - setting it is what shuts everyone else up. Reproduced.
	concurrent = ToBool(!(e->spawnflags & HLAI_SF_SENTENCE_CONCURRENT));

	listener = HLAISentenceListener(e, who);

	HLAITalkPlayScripted(who, e->ai_sentence, duration, volume, HLATTN_IDLE,
		concurrent, listener);

	//the sentence fires the trigger's own target too; HL chains a line of
	//dialogue into whatever follows it
	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	//SF_SENTENCE_ONCE removes the entity outright
	if (e->spawnflags & HLAI_SF_SENTENCE_ONCE)
	{
		e->in_use = FALSE;
		return;
	}

	//DelayThink: re-arm once the line and the refire have run out. An unnamed
	//one re-arms itself, a named one waits to be used again
	hl_ai_talk[self].next_think = hl_ent_time + duration;

	if (e->targetname[0])
		e->toggle_state = HLTS_AT_BOTTOM;
}

U0 HLAIFrame(F64 dt)
{//drive every script, keep idle props animating, then tick the monsters
 //
 //a scan rather than a schedule: ZealC is single-pass, so HLEntity.ZC's
 //dispatcher cannot call into this file. A triggered script only sets
 //toggle_state and this notices on the next tick.
	CHLEntity	*e;
	I64			 i;

	if (!hl_entities)
		return;

	//before the event pass below, which indexes hl_ai_mon_of: on the first
	//tick of a new map that table still describes the last one. Idempotent, so
	//HLAIMonsterFrame calling it again at the end costs three comparisons.
	HLAIMonSync;

	HLAISentenceUpdate(hl_ent_time);

	//CSoundEnt::Update: age the world sound list and re-post the player's own
	//entry. Before the monster pass, so a monster hears this tick's footsteps
	//rather than last tick's
	HLAISoundFrame;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use)
			goto qaif_next;

		//--- jaw ---
		//
		//The engine fills cl_entity_s.mouth.mouthopen from the playing voice and
		//StudioModelRenderer.cpp:620 hands it to bone controller 4, scaled by 64
		//rather than 255, StudioModelRenderer.cpp:150. It is amplitude, not
		//animation: the talk sequences move the head, never the jaw.
		//
		//HLStudioMouthSetting and not HLStudioCtlSetting - the latter returns a
		//0..255 setting and HLStCalcBoneAdj divides channel 4 by 64, so anything
		//over a quarter would clamp the jaw fully open.
		//
		//Assigned rather than accumulated, so silence closes the jaw. Ahead of
		//every early exit below: a scripted actor and a sitting scientist both
		//speak and both leave this loop before the studio pass.
		if (e->studio && HLStudioHasMouth(e->studio))
			e->controllers[HLST_MOUTH_CTL] =
				HLStudioMouthSetting(HLSndVoiceAmplitude(i + 1));

		if (e->ent_class == HLC_SCRIPT)
		{
			HLAICineTick(i);
			goto qaif_next;
		}

		//scripted_sentence, scripted.cpp:1023-1099. HLEntity.ZC spawns these
		//and posts GOING_DOWN on use as it does for a script: its dispatcher
		//compiles before this file and cannot call the sentence player.
		//
		//   AT_BOTTOM   m_active, waiting to be used
		//   GOING_DOWN  FindThink: look for a speaker each tick until one is
		//               acceptable
		//   AT_TOP      spent
		//
		//hl_ai_talk[i].next_think carries pev->nextthink and .inited carries
		//"Spawn has run": a scripted_sentence is never a talker, so its row in
		//that table is otherwise unused.
		if (e->ent_class == HLC_SENTENCE)
		{
			HLAISentenceFrame(i);
			goto qaif_next;
		}

		//CSittingScientist. Its own think, not the monster state machine: it
		//takes no AI slot
		if (!StrCompare(e->classname, "monster_sitting_scientist"))
		{
			HLAISitScientistThink(i);
			goto qaif_next;
		}

		//an unscripted studio prop plays its own first sequence.
		//
		//Monsters are excluded: HLAIMonsterFrame owns their sequence, and
		//seeding anim_start here would race the state machine on the first
		//tick after a spawn
		if (e->studio && e->anim_start == 0.0 && e->ent_class != HLC_MONSTER)
		{
			e->anim_start = hl_ent_time;
			e->anim_loop  = TRUE;
		}

		//Animation events. A tracked monster goes through HandleAnimEvent,
		//which lands its attacks on the frame the animator marked; anything
		//else gets the shared script events only.
		if (e->studio)
		{
			if (i < HLENT_MAX && hl_ai_mon_of[i] >= 0)
				HLAIMonEvents(hl_ai_mon_of[i], i, HLAIEntityCycle(e));
			else
				HLAIEntityEvents(e, i, HLAIEntityCycle(e));
		}

qaif_next:
	}

	//after the script pass: a script that started or finished this tick has
	//already claimed or released its actor, so HLAIMonsterFrame sees the
	//settled ownership rather than last tick's
	HLAIMonsterFrame(dt);
}
