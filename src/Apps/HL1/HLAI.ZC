	HLAIMonSeq(HLMON_BARNEY, HLACT_COWER,  "cower_stand");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_HIT,   "barnaclehit");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_PULL,  "barnaclepull");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_CHOMP, "barnaclecrunch");
	HLAIMonSeq(HLMON_BARNEY, HLACT_BARN_CHEW,  "barnaclechew");

	m->attack_noise = 384.0;
	HLStrCopy(m->snd_alert,  "barney/ba_attack1.wav", 48);
