// HLAI.ZC - scripted sequences, sentences and combat AI
//
// HL's characters are scripted rather than emergent: scripted_sequence
// entities name a monster, a mark to stand on and an animation to play, plus
// sentences for the speech.
//
// Compiles after HLEntity.ZC, so it can call the entity system. The reverse is
// not true; HLEntity.ZC's dispatcher only records that a script was triggered
// and the frame function here does the work.
//
// Second half of the file: monster state machine, task/schedule interpreter,
// sensing through the CLASS_* relationship matrix, attacks and death.
// Movement is straight at the goal, then a triangulated detour, then the map's
// node graph loaded from maps/graphs/<map>.nod.

//--- sentences --------------------------------------------------------------
//
// sound/sentences.txt is a table of
//
//     NAME  dir/word1(mods) word2! word3
//
// Each word is sound/<dir>/<word>.wav. A '/' inside a token sets the directory
// for the words that follow, '(...)' carries pitch and timing modifiers, and
// '!' ',' '.' are punctuation affecting delivery. Words play in sequence, so a
// sentence is a small scheduler rather than one sound.
//
// The file is ~50KB holding around a thousand sentences. It stays resident and
// the table indexes into it; pre-splitting every word would cost a few hundred
// KB of globals to save one tokenise at play time.

#define HLAI_MAX_SENTENCES	1400
#define HLAI_SENT_NAME		20
#define HLAI_WORD_MAX		48

class CHLSentence
{
	U8	 name[HLAI_SENT_NAME];
	U8	*text;			//borrowed from hl_ai_sent_raw, NUL terminated
};

CHLSentence	hl_ai_sent[HLAI_MAX_SENTENCES];
I64			hl_ai_sent_count = 0;
U8			*hl_ai_sent_raw  = NULL;

// A sentence runs on the speaker's CHAN_VOICE, one per entity, not one for the
// whole world: EMIT_SOUND_DYN on CHAN_VOICE replaces that entity's line and
// leaves every other entity's alone (talkmonster.cpp:1214). Two characters in
// the same room are both heard. A channel is keyed by entity index, so a second
// line from the same speaker cuts the first.
#define HLAI_SENT_CHANS		6

class CHLSentChan
{
	I64	sent;		//index into hl_ai_sent, -1 when idle
	I64	word;		//next word to play
	F64	next;		//hl_ent_time the next word starts
	I64	ent;		//speaking entity index, -1 for a fixed world position
	F64	org[3];
	F64	volume;
	F64	atten;
	I64	pitch;		//percentage of the recorded rate
	I64	entchannel;	//mixer channel the words play on
	F64	claimed;	//hl_ent_time the channel was taken, for eviction
	U8	dir[HLAI_WORD_MAX];	//the sound/ subdirectory the sentence has reached
};

CHLSentChan	hl_ai_sentch[HLAI_SENT_CHANS];

//scratch directory buffer for a word lookup made outside any channel
U8	hl_ai_sent_dir[HLAI_WORD_MAX];

//CTalkMonster::g_talkWaitTime, talkmonster.cpp:30. Declared here (before the
//word ticker) because ZealC is single-pass - an earlier use saw an undefined
//name and reported Invalid lval. Only one character starts a line at a time.
F64	hl_ai_talk_wait = 0.0;

U0 HLAIInit()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	I64 i;

	hl_ai_sent_count  = 0;
	hl_ai_sent_raw    = NULL;
	hl_ai_sent_dir[0] = 0;
	hl_ai_talk_wait   = 0.0;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		hl_ai_sentch[i].sent    = -1;
		hl_ai_sentch[i].word    = 0;
		hl_ai_sentch[i].next    = 0.0;
		hl_ai_sentch[i].ent     = -1;
		hl_ai_sentch[i].volume  = 1.0;
		hl_ai_sentch[i].atten   = HLENT_SND_ATTEN;
		hl_ai_sentch[i].pitch   = HLPITCH_NORM;
		hl_ai_sentch[i].entchannel = HLCHAN_VOICE;
		hl_ai_sentch[i].claimed = 0.0;
		hl_ai_sentch[i].dir[0]  = 0;

		hl_ai_sentch[i].org[0] = 0.0;
		hl_ai_sentch[i].org[1] = 0.0;
		hl_ai_sentch[i].org[2] = 0.0;
	}
}

//top-level, so the table is sane before anything can reach it
HLAIInit;

Bool HLAIIsSpace(I64 c)
{
	return ToBool(c == ' ' || c == '\t' || c == '\r' || c == '\n');
}

U0 HLAISentencesLoad()
{//parse sound/sentences.txt into the name table
	U8	*d;
	I64	 size = 0;
	I64	 pos  = 0;
	I64	 k;
	I64	 slot;

	HLAIInit;

	//owned copy: the table points into it for the life of the program and the
	//word lists are NUL terminated in place
	d = HLFileLoad("sound/sentences.txt", &size);

	if (!d || size < 8)
	{
		"HLAI: sound/sentences.txt missing - no speech\n";

		if (d)
			Free(d);

		return;
	}

	hl_ai_sent_raw = d;

	while (pos < size && hl_ai_sent_count < HLAI_MAX_SENTENCES)
	{
		while (pos < size && HLAIIsSpace(d[pos]))
			pos++;

		if (pos >= size)
			break;

		//comment to end of line
		if (d[pos] == '/')
		{
			while (pos < size && d[pos] != '\n')
				pos++;

			goto qasl_next;
		}

		slot = hl_ai_sent_count;

		//the name is the first token
		k = 0;
		while (pos < size && !HLAIIsSpace(d[pos]) && k < HLAI_SENT_NAME - 1)
		{
			hl_ai_sent[slot].name[k] = d[pos];
			k++;
			pos++;
		}

		hl_ai_sent[slot].name[k] = 0;

		//an over-long name would otherwise leak into the word list
		while (pos < size && !HLAIIsSpace(d[pos]))
			pos++;

		//skip the gap but not a newline: a name with no words is not a
		//sentence, and the next line is a fresh entry
		while (pos < size && (d[pos] == ' ' || d[pos] == '\t'))
			pos++;

		if (pos >= size || d[pos] == '\n')
			goto qasl_next;

		hl_ai_sent[slot].text = d + pos;

		while (pos < size && d[pos] != '\n')
			pos++;

		if (pos < size)
		{
			d[pos] = 0;
			pos++;
		}

		if (hl_ai_sent[slot].name[0])
			hl_ai_sent_count++;

		goto qasl_done;

qasl_next:
		if (pos < size)
			pos++;

qasl_done:
	}

	"HLAI: %d sentences\n", hl_ai_sent_count;
}

I64 HLAISentenceFind(U8 *name)
{//sentences are referenced as "!NAME" in entity keys and on the wire
	I64 i;

	if (!name)
		return -1;

	if (name[0] == '!')
		name++;

	for (i = 0; i < hl_ai_sent_count; i++)
	{
		if (!StrICompare(hl_ai_sent[i].name, name))
			return i;
	}

	return -1;
}

I64 HLAISentenceWord(I64 idx, I64 want, U8 *out, U8 *dir = NULL)
{//word number `want`, resolved to a sound path. returns 1 on success
 //
 //dir is the caller's HLAI_WORD_MAX directory buffer, carried per channel: the
 //'/' prefix is sticky across the words of one sentence and two sentences run
 //at once. NULL takes the shared scratch, for a one-off lookup
 //
 //(...) modifiers are skipped: they carry pitch and timing, and the mixer has no
 //pitch control. punctuation is stripped, so "grenade!" is the file grenade.wav
	U8	*t;
	U8	 word[HLAI_WORD_MAX];
	I64	 i = 0;
	I64	 k;
	I64	 n = 0;
	I64	 c;

	out[0] = 0;

	if (!dir)
	{
		dir    = hl_ai_sent_dir;
		dir[0] = 0;
	}

	if (idx < 0 || idx >= hl_ai_sent_count)
		return 0;

	t = hl_ai_sent[idx].text;

	if (!t)
		return 0;

	while (t[i])
	{
		while (t[i] && HLAIIsSpace(t[i]))
			i++;

		if (!t[i])
			break;

		k = 0;

		//ZealC has no `continue`; a label at the end of the loop body is the
		//idiom used throughout this tree.
		while (t[i] && !HLAIIsSpace(t[i]))
		{
			c = t[i];

			//(p120 t40) - pitch and timing are not honoured
			if (c == '(')
			{
				while (t[i] && t[i] != ')')
					i++;

				if (t[i])
					i++;

				goto qasw_next_char;
			}

			//a '/' ends the directory prefix, not the word
			if (c == '/')
			{
				word[k] = 0;
				HLRdName(word, dir, HLAI_WORD_MAX);
				k = 0;
				i++;
				goto qasw_next_char;
			}

			//punctuation is delivery, not part of the filename. A comma also
			//ENDS the word: sentences.txt runs entries together with no
			//space, "atmospherics_on,vitalsigns_on" (HEV_AAx), and gluing
			//them makes one bogus filename that silently skips both words
			if (c == '!' || c == ',' || c == '.' || c == '?' || c == ';')
			{
				i++;
				if (c == ',' && k)
					break;
				goto qasw_next_char;
			}

			if (k < HLAI_WORD_MAX - 1)
			{
				word[k] = c;
				k++;
			}

			i++;

qasw_next_char:
		}

		word[k] = 0;

		//a token that was only a directory contributes no word
		if (!k)
			goto qasw_next_token;

		if (n == want)
		{
			if (dir[0])
				StrPrint(out, "%s/%s.wav", dir, word);
			else
				StrPrint(out, "%s.wav", word);

			return 1;
		}

		n++;

qasw_next_token:
	}

	return 0;
}

I64 HLAISentenceChan(I64 ent)
{//the channel this entity speaks on: its own if it already holds one, else a
 //free one, else the one claimed longest ago
	I64	i;
	I64	free_slot = -1;
	I64	oldest    = 0;

	if (ent >= 0)
	{
		for (i = 0; i < HLAI_SENT_CHANS; i++)
		{
			if (hl_ai_sentch[i].sent >= 0 && hl_ai_sentch[i].ent == ent)
				return i;
		}
	}

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent < 0 && free_slot < 0)
			free_slot = i;

		if (hl_ai_sentch[i].claimed < hl_ai_sentch[oldest].claimed)
			oldest = i;
	}

	if (free_slot >= 0)
		return free_slot;

	return oldest;
}

Bool HLAISentenceTalking(I64 ent)
{//is this entity's voice channel still running words
	I64 i;

	if (ent < 0)
		return FALSE;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent >= 0 && hl_ai_sentch[i].ent == ent)
			return TRUE;
	}

	return FALSE;
}

//Speech defaults to HLCHAN_VOICE, common/const.h's CHAN_VOICE of 2, and
//HLSndVoiceAmplitude reads that channel to drive bone controller 4. The suit
//voice overrides it to CHAN_STATIC (EMIT_SOUND_SUIT, sound.cpp:1439), which is
//why the channel is carried per request rather than fixed here. HLEntity.ZC:157
//defines HLENT_CHAN_VOICE as 3, which is CHAN_ITEM; HLWeapon.ZC and HLEntity.ZC
//still use it. Replacement is per (entnum, entchannel), so a monster's line
//still cuts its own previous line.

U0 HLAISentenceStop(I64 ent)
{//SENTENCE_STOP, reached through CBaseMonster::SentenceStop. Drops the word
 //scheduler and cuts the word already in the mixer
	I64 i;

	for (i = 0; i < HLAI_SENT_CHANS; i++)
	{
		if (hl_ai_sentch[i].sent < 0 || hl_ai_sentch[i].ent != ent)
			goto qass_next;

		hl_ai_sentch[i].sent = -1;

		if (ent >= 0)
			HLSndStop(ent + 1, hl_ai_sentch[i].entchannel);

qass_next:
	}
}

Bool HLAISentencePlay(U8 *name, I64 ent, F64 *origin, F64 volume, F64 atten,
	I64 pitch = HLPITCH_NORM, I64 entchannel = HLCHAN_VOICE)
{//CTalkMonster::PlaySentence's dispatch, talkmonster.cpp:1206-1216: a leading
 //! names one sentence, anything else names a group and SENTENCEG_PlayRndSz
 //draws a member from it without repeating until the group is exhausted.
 //
 //The group table and its LRU live in HLSound.ZC (HLSndSentencePick,
 //HLSound.ZC:2841), which is loaded from the same sound/sentences.txt. The pick
 //comes back as "!NAMEn" and resolves in this file's own name table.
	I64	idx;
	I64	grp;
	U8	picked[48];

	if (!name || !name[0])
		return FALSE;

	//a map or a table can reference speech before HL1.ZC has loaded it
	if (!hl_ai_sent_count)
		HLAISentencesLoad;

	if (name[0] == '!')
		idx = HLAISentenceFind(name);
	else
	{
		grp = HLSndSentenceGroupIndex(name);

		if (grp < 0)
			return FALSE;

		picked[0] = 0;

		if (HLSndSentencePick(grp, picked) < 0 || !picked[0])
			return FALSE;

		idx = HLAISentenceFind(picked);
	}

	if (idx < 0)
		return FALSE;

	grp = HLAISentenceChan(ent);

	//taking a live channel means the previous line stops mid-word, on whatever
	//mixer channel that line was using
	if (hl_ai_sentch[grp].sent >= 0 && hl_ai_sentch[grp].ent >= 0)
		HLSndStop(hl_ai_sentch[grp].ent + 1, hl_ai_sentch[grp].entchannel);

	hl_ai_sentch[grp].sent    = idx;
	hl_ai_sentch[grp].word    = 0;
	hl_ai_sentch[grp].next    = 0.0;
	hl_ai_sentch[grp].ent     = ent;
	hl_ai_sentch[grp].volume  = volume;
	hl_ai_sentch[grp].atten   = atten;
	hl_ai_sentch[grp].pitch   = pitch;
	hl_ai_sentch[grp].claimed = hl_ent_time;
	hl_ai_sentch[grp].dir[0]  = 0;

	//EMIT_SOUND_SUIT is CHAN_STATIC, sound.cpp:1439, and player pain is
	//CHAN_VOICE: sound replacement is per (entnum, entchannel), so the suit
	//voice and the pain sound must not share one or each suit word cuts the pain
	hl_ai_sentch[grp].entchannel = entchannel;

	if (origin)
		HLVecCopy(origin, hl_ai_sentch[grp].org);
	else
		HLVecSet(hl_ai_sentch[grp].org, 0.0, 0.0, 0.0);

	return TRUE;
}

U0 HLAISentenceChanTick(I64 c, F64 now)
{//advance one channel to its next word once the previous one has had its time
 //
 //the duration comes from the decoded sample rather than a fixed step, so a
 //long word is not cut off and a short one leaves no gap
	CHLEntity	*e;
	CHLSound	*snd;
	U8			 path[96];
	F64			 dur;
	I64			 entnum;

	if (hl_ai_sentch[c].sent < 0)
		return;

	//the voice follows its speaker: a character walking while talking is heard
	//where they are, not where they started
	if (hl_ai_sentch[c].ent >= 0)
	{
		e = HLEntGet(hl_ai_sentch[c].ent);

		if (e)
			HLVecCopy(e->origin, hl_ai_sentch[c].org);
	}

	if (now < hl_ai_sentch[c].next)
		return;

	if (!HLAISentenceWord(hl_ai_sentch[c].sent, hl_ai_sentch[c].word, path,
		hl_ai_sentch[c].dir))
	{
		hl_ai_sentch[c].sent = -1;
		return;
	}

	snd = HLSndLoad(path);

	entnum = 0;

	if (hl_ai_sentch[c].ent >= 0)
		entnum = hl_ai_sentch[c].ent + 1;

	if (snd && snd->rate > 0)
	{
		HLSndPlayAt(path, hl_ai_sentch[c].org, hl_ai_sentch[c].volume,
			hl_ai_sentch[c].atten, entnum, hl_ai_sentch[c].entchannel,
			hl_ai_sentch[c].pitch);

		dur = ToF64(snd->count) / ToF64(snd->rate);

		//pitch is a percentage of the recorded rate, so it shortens the word
		if (hl_ai_sentch[c].pitch > 0)
			dur = dur * 100.0 / ToF64(hl_ai_sentch[c].pitch);
	}
	else
	{
		//a missing word must not stall the rest of the sentence
		dur = 0.05;
	}

	//CTalkMonster::PlaySentence, talkmonster.cpp:1158: the floor is held until
	//two seconds past the end of the line. Applied per word rather than once at
	//dispatch because the sentence length is not known until the last word is
	//decoded; HLSndTalkWaitSet only ever raises the deadline, so the wait ends
	//two seconds after the final word. World speech (entnum 0) is the announcer
	//itself and sets its own wait in HLSndSpeakerUpdate.
	if (hl_ai_sentch[c].ent >= 0)
	{
		HLSndTalkWaitSet(now + dur + 2.0);

		//HLSndTalkWaitSet only raises the announcer clock (HLSound compiles
		//earlier); talk monsters read hl_ai_talk_wait
		if (now + dur + 2.0 > hl_ai_talk_wait)
			hl_ai_talk_wait = now + dur + 2.0;
	}

	//HL leaves a small gap between words; without it a sentence slurs
	hl_ai_sentch[c].next = now + dur + 0.03;
	hl_ai_sentch[c].word++;
}

U0 HLAISentenceUpdate(F64 now)
{//every live channel, plus the requests HLSound.ZC parked
 //
 //HLSndEmitDyn, the speaker and anything else that hands a "!NAME" to the mixer
 //queue their request there (HLSound.ZC:2941) because the word scheduler
 //compiles later. Draining it here is what makes those requests audible.
	CHLSentReq	req;
	I64			 ent;
	I64			 i;

	while (HLSndSentenceNext(&req))
	{
		//HLSndPlayAt's entnum convention is entity index + 1, 0 for the world
		ent = -1;

		if (req.entnum > 0)
			ent = req.entnum - 1;

		HLAISentencePlay(req.name, ent, req.origin, req.volume,
			req.attenuation, req.pitch, req.entchannel);
	}

	for (i = 0; i < HLAI_SENT_CHANS; i++)
		HLAISentenceChanTick(i, now);
}

//--- animation --------------------------------------------------------------

U0 HLAISetSequence(CHLEntity *e, U8 *label, Bool loop)
{//point an entity at a named sequence and restart its cycle
	I64 seq;

	if (!e || !e->studio || !label || !label[0])
		return;

	seq = HLStudioSeqByName(e->studio, label);

	//maps routinely name sequences their model does not carry; leaving the
	//previous one running beats falling back to sequence 0
	if (seq < 0)
		return;

	e->seq        = seq;
	e->anim_start = hl_ent_time;
	e->anim_done  = FALSE;

	//A new sequence has its own event list; the old frame index means nothing.
	e->anim_event_frame = -1;

	//the sequence's own STUDIO_LOOPING flag overrides the caller
	e->anim_loop = ToBool(loop || HLStudioSeqLoops(e->studio, seq));
}

U0 HLAIFireEvent(CHLEntity *e, I64 self, CHLStEvent *ev)
{//One mstudioevent_t on an entity that is not a tracked monster - a prop or a
 //scripted actor with no AI slot. Only the shared script events apply: a
 //monster goes through HLAIMonAnimEvent instead, which handles the whole set.
	if (!ev->options[0])
		return;

	//A real entnum, unlike the rest of the entity sound paths: a room of grunts
	//all firing voice lines on entnum 0 would cut each other down to one.
	//
	//ATTN_IDLE, not ATTN_NORM: all four script sound events carry it -
	//monsters.cpp:2659, :2663 and :2671. dist_mult is attenuation / 1000, so
	//ATTN_IDLE 2.0 is silent past 500 units and ATTN_NORM 0.8 past 1250. These
	//events carry the footsteps (common/npc_step*.wav on frames 0 and 8 of every
	//walk and run sequence), which at ATTN_NORM are still at 60 percent volume
	//where the original has them silent.
	if (ev->code == HLST_EV_SOUND)
	{
		HLSndPlayAt(ev->options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLENT_CHAN_BODY);
		return;
	}

	if (ev->code == HLST_EV_SOUND_VOICE)
	{
		HLSndPlayAt(ev->options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLCHAN_VOICE);
		return;
	}

	//SCRIPT_EVENT_SENTENCE_RND1 plays two times in three: monsters.cpp:2666
	//breaks on RANDOM_LONG(0,2) == 0 and otherwise falls into the plain case
	if (ev->code == HLST_EV_SENTENCE_RND1 && !HLPartRandI(3))
		return;

	//on the entity's own voice channel, so two props speaking do not collide
	if (ev->code == HLST_EV_SENTENCE || ev->code == HLST_EV_SENTENCE_RND1)
		HLAISentencePlay(ev->options, self, e->origin, 1.0, HLATTN_IDLE);
}

U0 HLAIEntityEvents(CHLEntity *e, I64 self, F64 cycle)
{//Fire the events the sequence has passed since the last tick.
 //
 //StudioFrameAdvance keeps the last frame reached and dispatches everything in
 //(last, now]. Sampling the current frame alone drops any event the tick
 //stepped over, which at 72Hz over a 30fps sequence is most of them.
	CHLStudio	*m;
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 frame_f;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!e || !e->studio)
		return;

	m = e->studio;

	if (e->seq < 0 || e->seq >= m->num_seqs || !m->events)
		return;

	sq = &m->seqs[e->seq];

	if (sq->num_events < 1)
		return;

	frame_f = cycle * ToF64(sq->num_frames - 1);
	frame   = ToI64(frame_f);

	if (frame < 0)
		frame = 0;
	if (frame > sq->num_frames - 1)
		frame = sq->num_frames - 1;

	last = e->anim_event_frame;

	//A loop that wrapped, or a sequence that was just started, replays the
	//whole list from the beginning rather than skipping to the new position.
	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &m->events[sq->first_event + i];

		if (ev->frame > last && ev->frame <= frame)
			HLAIFireEvent(e, self, ev);
	}

	e->anim_event_frame = frame;
}

F64 HLAIEntityCycle(CHLEntity *e)
{//0..1 through the entity's current sequence
 //
 //derived from anim_start rather than the wall clock, so a scripted one-shot
 //holds its last frame instead of looping
	F64 dur;
	F64 t;

	if (!e || !e->studio)
		return 0.0;

	if (e->seq < 0 || e->seq >= e->studio->num_seqs)
		return 0.0;

	dur = HLStudioSeqDuration(e->studio, e->seq);

	if (dur <= 0.0)
		return 0.0;

	t = hl_ent_time - e->anim_start;

	if (t < 0.0)
		t = 0.0;

	if (!e->anim_loop && t >= dur)
		return 1.0;

	t = t / dur;

	return t - Floor(t);
}

//--- scripted_sequence ------------------------------------------------------
//
// dlls/scripted.cpp. A scripted_sequence names an actor, a mark to stand on,
// an idle take to hold until the cue and a play take to run on the cue. The
// driver itself is at the foot of this file: it walks the actor to the mark
// through the monster mover, which is defined a few thousand lines below here
// and ZealC is single-pass. Only the constants and the by-name lookup the
// sentence player also needs live at this point.

//SF_SCRIPT_*, scripted.h:22
#define HLAI_SF_WAITTILLSEEN		1
#define HLAI_SF_EXITAGITATED		2
#define HLAI_SF_REPEATABLE			4
#define HLAI_SF_LEAVECORPSE			8
#define HLAI_SF_NOINTERRUPT			32
#define HLAI_SF_OVERRIDESTATE		64
#define HLAI_SF_NOSCRIPTMOVEMENT	128

//m_fMoveTo
#define HLAI_MOVE_NONE			0
#define HLAI_MOVE_WALK			1
#define HLAI_MOVE_RUN			2
#define HLAI_MOVE_INSTANT		4
#define HLAI_MOVE_TURN			5

//SCRIPTSTATE, basemonster.h:30. m_scriptState of the possessed actor.
#define HLSS_PLAYING			0
#define HLSS_WAIT				1
#define HLSS_CLEANUP			2
#define HLSS_WALK_TO_MARK		3
#define HLSS_RUN_TO_MARK		4

//SS_INTERRUPT, scripted.h:33. How far up the state ladder a script may reach
//for its actor: by targetname reaches ALERT, by classname only IDLE.
#define HLSS_INT_IDLE			0
#define HLSS_INT_BY_NAME		1
#define HLSS_INT_AI				2

//Offset added to hl_ent_time to park m_startTime (scripted.cpp: Spawn and
//PossessEntity case 4). Absolute 1e6 used to fire once uptime crossed it.
#define HLAI_CINE_NEVER			1.0e6

//CineThink's retry interval when no actor was free, seconds. scripted.cpp:487
#define HLAI_CINE_RETRY			1.0

//Deviation: how long a walk to the mark may keep failing before the actor is
//placed on it, seconds.
//
//Move() answers a failed local move with TaskFail (monsters.cpp:1917 and
//:1925). In MONSTERSTATE_SCRIPT that reselects SCHED_AISCRIPT, which hands back
//slWalkToScript (defaultai.cpp:1076), so the SDK restarts the walk and retries
//for as long as the map runs. The node graph covers most of what used to stall
//here; a mark off the graph, or on a map with no .nod, still cannot be walked
//to. Retrying for this long and then planting keeps the level moving; every
//plant is a routing failure and prints under scriptlog.
#define HLAI_CINE_WALK_GIVEUP	6.0

//--- combat AI --------------------------------------------------------------
//
// Ported from the SDK's dlls/: monsterstate.cpp (the state machine),
// schedule.cpp and defaultai.cpp (schedules, tasks, StartTask/RunTask/
// TaskComplete/TaskFail), monsters.cpp (Look, FInViewCone, FVisible, and the
// CLASS_*/IRelationship matrix), plus the Spawn() and SelectSchedule() bodies
// of headcrab.cpp, zombie.cpp, scientist.cpp, barney.cpp, houndeye.cpp,
// hgrunt.cpp, islave.cpp and bullsquid.cpp for the numbers.
//
// Implemented:
//
//   - the five MONSTERSTATE_ values and the transitions between them
//   - a task/schedule interpreter. A schedule is a list of (task, data); each
//     task is Start-ed once and Run every tick until it completes or fails,
//     and a failed task abandons the whole schedule, as TaskFail does.
//   - Look(): view cone from m_flFieldOfView, a point trace for FVisible, and
//     the relationship matrix - barney shoots aliens and ignores the player, a
//     scientist runs from a zombie.
//   - melee and ranged attacks gated on range, view cone, sight and refire
//   - HandleAnimEvent, per monster: every attack lands on the mstudioevent_t
//     the animator marked, so a zombie's swing connects on frame 10 of 36 and
//     the follow-through can be walked out of, and the foley - body drops,
//     claw swishes, burst fire, reloads - plays where the SDK plays it
//   - squads (squadmonster.cpp): slots, OccupySlot/VacateSlot, SquadRecruit,
//     SquadMakeEnemy, NoFriendlyFire and cover spacing, so a fireteam of
//     grunts puts two men up and the rest in cover
//   - hearing (soundent.cpp): a world sound list, the player's own footstep
//     and weapon entry, and the investigate and take-cover-from-sound
//     schedules that act on it
//   - death: the die sequence plays and holds on its last frame, or the body
//     gibs below -40 health
//
// Not implemented, and the consequence of each:
//
//   - The node graph is loaded, not built, and the route is acquired lazily.
//     CBaseMonster::BuildRoute lays the whole route at task start and
//     TASK_GET_PATH_TO_* fails when no route exists (monsters.cpp:751); here
//     the path tasks only record the goal and the mover asks for nodes at the
//     point BuildRoute would - after a straight line and a triangulated
//     detour have both failed. The consequence is that a monster commits to
//     an unreachable goal for one lookahead interval before the route search
//     runs, rather than choosing a different schedule outright.
//     disposal.bsp ships no .nod and falls back to straight-line movement.
//
//   - FL_MONSTERCLIP / func_monsterclip: live via e->monsterclip +
//     hl_clip_for_monster on AI traces.
//
 //   - AI projectiles: spit / hornet / controller ball / grunt+assassin
 //     grenade / garg flame queue
//     through HLAIProjRequest into hl_proj[] (HLWeapon drains). Islave zap
//     stays hitscan (SDK beam).
//
//   - Scent (bits_COND_SMELL, bits_COND_SMELL_FOOD): HLAISmell over the world
//     sound pool (CARCASS/MEAT/GARBAGE).
//
//   - Node cover: lateral ring then HINT_TACTICAL_COVER_* via HLAIFindNodeCover.
//     Headcrab leap: live. GetDeathActivity picks directional / hitgroup die
//     takes when the model carries them; HLACT_DIE remains the fallback.
//
//   - The player hurts monsters through HLWeapon → HLDmgHurt. Death path notes
//     below about trigger_hurt still apply for non-weapon damage.
//
// State lives in the parallel table below, indexed by slot, with
// hl_ai_mon_of[] mapping an entity index to its slot: HLEnt.ZC is not editable
// from here, so anything the shared CHLEntity does not carry lives here.
//
// The death path is shared with func_breakable. HLEntTakeDamage queues
// HLM_BREAK_DIE at zero health and HLBreakableDie clears in_use - correct for
// glass, wrong for a monster, which has to stay in the world and fall over.
// That call is in HLEntity.ZC and unreachable from here, so HLAIMonSync
// notices a monster whose slot went away and puts the corpse back, non-solid
// and immune, to play its die sequence. hl_ai_mon_revive disables that.

#define HLAI_MON_MAX			192

