	hl_ai_mon[s].sched         = HLSCHED_NONE;
	hl_ai_mon[s].task          = 0;
	hl_ai_mon[s].task_status   = HLTK_DONE;
	hl_ai_mon[s].task_start    = 0.0;
	hl_ai_mon[s].sched_done    = TRUE;
	hl_ai_mon[s].conds         = HLCOND_NONE;
	hl_ai_mon[s].flinched      = FALSE;
	hl_ai_mon[s].have_enemy    = FALSE;
	hl_ai_mon[s].enemy         = -1;
	hl_ai_mon[s].enemy_seen    = 0.0;
	hl_ai_mon[s].have_goal     = FALSE;
	hl_ai_mon[s].goal_is_enemy = FALSE;
	hl_ai_mon[s].goal_tol      = 32.0;
	hl_ai_mon[s].move_speed    = 0.0;
	hl_ai_mon[s].path_start    = 0.0;
	hl_ai_mon[s].stuck_since   = 0.0;
	hl_ai_mon[s].have_detour   = FALSE;
	hl_ai_mon[s].route_len     = 0;
	hl_ai_mon[s].route_at      = 0;
	hl_ai_mon[s].route_time    = 0.0;
	hl_ai_mon[s].next_move_check = 0.0;
	hl_ai_mon[s].next_attack   = 0.0;
	hl_ai_mon[s].next_look     = 0.0;
	hl_ai_mon[s].scripted      = FALSE;
	hl_ai_mon[s].settled       = FALSE;
	hl_ai_mon[s].squad         = -1;
	hl_ai_mon[s].squad_slots   = 0;
	hl_ai_mon[s].my_slot       = HLSLOT_NONE;
	hl_ai_mon[s].squad_tried   = FALSE;
	hl_ai_mon[s].have_lastpos  = FALSE;
	hl_ai_mon[s].next_pain_snd = 0.0;
	hl_ai_mon[s].heard         = -1;
	hl_ai_mon[s].heard_type    = HLSOUND_NONE;
	hl_ai_mon[s].have_smell    = FALSE;
	hl_ai_mon[s].smell_type    = HLSOUND_NONE;
	hl_ai_mon[s].activity      = HLACT_IDLE;
	hl_ai_mon[s].act_seq       = -1;
	hl_ai_mon[s].next_blink    = 0.0;
	hl_ai_mon[s].next_fidget   = 0.0;
	hl_ai_mon[s].gun_drawn     = FALSE;
	hl_ai_mon[s].in_cover      = FALSE;
	hl_ai_mon[s].fail_sched    = HLSCHED_FAIL;
	hl_ai_mon[s].own_think    = 0.0;
	hl_ai_mon[s].barn_alt      = 0.0;
	hl_ai_mon[s].barn_adj      = HLBARN_ADJ_IDLE;
	hl_ai_mon[s].barn_kill     = -1.0;
	hl_ai_mon[s].barn_gibs     = 0;
	hl_ai_mon[s].barn_prey     = -1;
	hl_ai_mon[s].barn_lifting  = FALSE;
	hl_ai_mon[s].barn_ext      = FALSE;
	hl_ai_mon[s].barn_host     = -1;
	hl_ai_mon[s].mine_arm      = 0.0;
	hl_ai_mon[s].mine_len      = 1.0;
	hl_ai_mon[s].mine_boom     = 0.0;
	hl_ai_mon[s].mine_armed    = FALSE;
	hl_ai_mon[s].mine_dying    = FALSE;
	hl_ai_mon[s].tur_rate      = HLTUR_TURNRATE;
	hl_ai_mon[s].tur_ping      = 0.0;
	hl_ai_mon[s].tur_sight     = 0.0;
	hl_ai_mon[s].tur_dmg_time  = 0.0;
	hl_ai_mon[s].tur_state     = HLTUR_OFF;
	hl_ai_mon[s].tur_orient    = 0;
	hl_ai_mon[s].rch_light     = -1.0;
	hl_ai_mon[s].rch_nofood    = 0.0;
	hl_ai_mon[s].rch_mode      = HLRCH_IDLE;
	hl_ai_mon[s].rch_lit       = FALSE;

	HLVecSet(hl_ai_mon[s].mine_dir, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].mine_end, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].mine_beam, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].tur_cur, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].tur_goal, 0.0, 0.0, 0.0);

	hl_ai_mon[s].ammo      = 0;
	hl_ai_mon[s].clip      = 0;
	hl_ai_mon[s].aim_pitch = 0.0;
	hl_ai_mon[s].leaping   = FALSE;
	HLVecSet(hl_ai_mon[s].leap_vel, 0.0, 0.0, 0.0);
	hl_ai_mon[s].leap_die  = 0.0;
	hl_ai_mon[s].tossing   = FALSE;
	hl_ai_mon[s].heal_time = 0.0;

	if (hl_ai_mon[s].kind >= 0 && hl_ai_mon[s].kind < HLMON_COUNT)
		hl_ai_mon[s].clip = hl_ai_mon_info[hl_ai_mon[s].kind].clip_size;

