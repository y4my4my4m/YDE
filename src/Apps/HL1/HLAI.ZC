	//m_MonsterState = MONSTERSTATE_NONE. The class defines Classify,
	//SetYawSpeed, HandleAnimEvent, ISoundMask and Spawn and nothing else: no
	//GetSchedule, no attack, no ISoundMask but zero. "Purely for scripted
	//sequence work", genericmonster.cpp:16.
	//
	//No sequence labels. The model is the mapper's "model" key, so a label
	//table would be a guess; HLAIResolveActivity falls through to
	//LookupActivity on the number studiomdl baked in, which is what
	//CBaseMonster does. A model carrying no ACT_IDLE resolves nothing and
	//HLAISetActivity leaves the take where it is - correct for a bone pile.
	//
	//The 82 entities in valve/maps: 40 wear gib, ribcage, pelvis and skull
	//models, 33 wear holo.mdl, 6 wear the forklift, the loader and scigun, 3
	//wear barney.mdl or scientist.mdl. 15 are named by a scripted_sequence.
	//HLAIMonThink branches out of the state machine for this row: giving a
	//ribcage the base class's chase behaviour moves scenery.
	m = &hl_ai_mon_info[HLMON_GENERIC];
	HLStrCopy(m->classname, "monster_generic", 32);
	m->classify   = HLCLASS_PLAYER_ALLY;	//genericmonster.cpp:48
	m->health     = 8.0;					//genericmonster.cpp:117, not skill
	m->fov        = 0.5;					//genericmonster.cpp:119
	m->yaw_speed  = 90.0;					//SetYawSpeed, genericmonster.cpp:63
	m->blood      = HLBLOOD_RED;
	m->sound_mask = HLSOUND_NONE;			//"can't hear", genericmonster.cpp:86

	//walk and run speeds are the shared human figures. Only a
	//scripted_sequence moves this row, and only for a model that carries a
	//walk take - see the HLAIResolveActivity gate in HLAICinePossess
	m->walk_speed = 40.0;
	m->run_speed  = 150.0;

	//VEC_HUMAN_HULL. CGenericMonster::Spawn gives player.mdl and holo.mdl the
	//centred VEC_HULL instead (genericmonster.cpp:106); not reproduced,
	//because every holo.mdl in the shipped maps carries
	//SF_GENERICMONSTER_NOTSOLID and its box is never swept against
	HLAIMonHull(HLMON_GENERIC, 16.0, 72.0, 52.0);
}

//--- node routing, per monster ----------------------------------------------

I64 HLAIMonCaps(I64 kind)
{//m_afCapability, set in each Spawn(). Only the door group is read by the node
 //search, so only that is carried.
 //
 //barney.cpp:424, hgrunt.cpp:997, islave.cpp:540 and zombie.cpp:284 set
 //bits_CAP_DOORS_GROUP; scientist.cpp:687 spells the same three bits out.
 //agrunt.cpp:589, houndeye.cpp:346 and the rows with no assignment at all -
 //headcrab, bullsquid, controller, cockroach, generic - carry none, so an
 //alien is routed only through doorways that are already open.
	if (kind == HLMON_BARNEY || kind == HLMON_HGRUNT ||
		kind == HLMON_ISLAVE || kind == HLMON_ZOMBIE ||
		kind == HLMON_SCIENTIST)
		return HLCAP_DOORS_GROUP;

	return 0;
}

I64 HLAIMonHullIndex(I64 kind)
{//CGraph::HullIndex, nodes.cpp:442. Keyed on mins x, which is what the SDK
 //compares: -12 headcrab, -16 VEC_HUMAN_HULL_MIN, -32 the big aliens. The
 //cockroach's -1 matches nothing and takes the SDK's own fallback.
	CHLMonInfo *mi;

	if (kind < 0 || kind >= HLMON_COUNT)
		return HLHULL_HUMAN;

	mi = &hl_ai_mon_info[kind];

	if (mi->flies)
		return HLHULL_FLY;

	if (mi->mins[0] > -12.5 && mi->mins[0] < -11.5)
		return HLHULL_SMALL;

	if (mi->mins[0] > -32.5 && mi->mins[0] < -31.5)
		return HLHULL_LARGE;

	return HLHULL_HUMAN;
}

I64 HLAIMonNodeType(I64 kind)
{//CGraph::NodeType, nodes.cpp:459. Water level is not tracked per monster, so
 //a flier takes air nodes and everything else land nodes; no shipped ground
 //monster here swims.
	if (kind >= 0 && kind < HLMON_COUNT)
	{
		if (hl_ai_mon_info[kind].flies)
			return HLNODE_AIR;
	}

	return HLNODE_LAND;
}

U0 HLAIRouteClear(I64 s)
{//RouteNew's node half, monsters.cpp:617.
 //
 //route_time is not touched: it is the rate limiter on the search itself and
 //belongs to the monster, not to the route. Clearing it here would let a
 //chase, which discards its route whenever the enemy moves, rebuild every
 //think.
	hl_ai_mon[s].route_len = 0;
	hl_ai_mon[s].route_at  = 0;

	HLVecSet(hl_ai_mon[s].route_for, 0.0, 0.0, 0.0);
}

I64 HLAINodeRoute(I64 s, F64 *dest)
{//CBaseMonster::FGetNodeRoute, monsters.cpp:2790. Nearest node to the monster,
 //nearest node to the destination, shortest path between them.
 //
 //The goal itself is not stored in route_node: HLAIWayPoint falls through to
 //the goal once the nodes run out, which is what FGetNodeRoute's trailing
 //bits_MF_IS_GOAL waypoint does.
 //
 //Returns HLAI_ROUTE_*. WAIT and NONE are separate because the caller treats a
 //build it was not allowed to attempt differently from one that found nothing.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	U8			 line[160];
	I64			 path[HLNODE_PATH_MAX];
	I64			 types;
	I64			 src_node;
	I64			 dst_node;
	I64			 found;
	I64			 i;

	if (!e)
		return HLAI_ROUTE_NONE;

	//parenthesised: a bare no-arg name yields its address in an expression
	if (!HLAIGraphEnsure())
	{
		if (hl_ai_graph_log)
			HLLog("route: no graph\n");
		return HLAI_ROUTE_NONE;
	}

	//a build is two linear node scans with a trace each plus a Dijkstra. On a
	//chase the goal moves every tick and the schedule would rebuild every tick.
	//A stamp ahead of the clock is a map change: hl_ent_time restarts at zero.
	//
	//Tested before the route is discarded: a throttled call must leave the
	//route it was asked to replace intact
	if (hl_ai_mon[s].route_time > 0.0 &&
		hl_ent_time >= hl_ai_mon[s].route_time &&
		hl_ent_time - hl_ai_mon[s].route_time < HLAI_NODE_REROUTE)
		return HLAI_ROUTE_WAIT;

	hl_ai_mon[s].route_time = hl_ent_time;

	HLAIRouteClear(s);

	types    = HLAIMonNodeType(hl_ai_mon[s].kind);
	src_node = HLAIFindNearestNode(e->origin, types);

	if (src_node < 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line,
				"route: no node sees %s at %.0f %.0f %.0f (%d nodes)\n",
				e->classname, e->origin[0], e->origin[1], e->origin[2],
				hl_ai_node_count);
			HLLog(line);
		}
		return HLAI_ROUTE_NONE;
	}

	dst_node = HLAIFindNearestNode(dest, types);

	if (dst_node < 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line, "route: no node sees goal %.0f %.0f %.0f\n",
				dest[0], dest[1], dest[2]);
			HLLog(line);
		}
		return HLAI_ROUTE_NONE;
	}

	found = HLAIFindShortestPath(path, src_node, dst_node,
		HLAIMonHullIndex(hl_ai_mon[s].kind),
		HLAIMonCaps(hl_ai_mon[s].kind));

	if (found <= 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line, "nodegraph: no path %d to %d for slot %d\n",
				src_node, dst_node, s);
			HLLog(line);
		}

		return HLAI_ROUTE_NONE;
	}

	for (i = 0; i < found; i++)
		hl_ai_mon[s].route_node[i] = path[i];

	hl_ai_mon[s].route_len = found;

	//RouteNew, monsters.cpp:617: a new route supersedes the apex the old one
	//was detouring around
	hl_ai_mon[s].have_detour = FALSE;

	//the node under the monster is the one it is standing on; walking to it
	//first is a step backwards down the route
	if (found > 1)
		hl_ai_mon[s].route_at = 1;
	else
		hl_ai_mon[s].route_at = 0;

	HLVecCopy(dest, hl_ai_mon[s].route_for);

	if (hl_ai_graph_log)
	{
		StrPrint(line, "nodegraph: slot %d routed %d nodes, %d to %d\n", s,
			found, src_node, dst_node);
		HLLog(line);
	}

	return HLAI_ROUTE_OK;
}

Bool HLAIRouteStale(I64 s)
{//the route was built to route_for and the goal has moved off it. A chase
 //re-aims at the enemy every tick, so without this the nodes lead to where
 //the enemy was when the schedule started
	F64 d[3];

	if (hl_ai_mon[s].route_len <= 0)
		return FALSE;

	HLVecSub(hl_ai_mon[s].goal, hl_ai_mon[s].route_for, d);

	return ToBool(HLVecLength(d) > HLAI_NODE_SLOP);
}

U0 HLAIWayPoint(I64 s, F64 *way, F64 *_tol)
{//the point the mover is currently steering at, and how close counts as
 //reached. m_Route[m_iRouteIndex], in precedence order: the triangulated apex,
 //then the node route, then the goal
	I64 node;

	if (hl_ai_mon[s].have_detour)
	{
		HLVecCopy(hl_ai_mon[s].detour, way);
		*_tol = HLAI_NODE_TOL;
		return;
	}

	if (hl_ai_mon[s].route_len > 0 &&
		hl_ai_mon[s].route_at < hl_ai_mon[s].route_len)
	{
		node = hl_ai_mon[s].route_node[hl_ai_mon[s].route_at];

		if (node >= 0 && node < hl_ai_node_count)
		{
			way[0] = hl_ai_node_org[node * 3];
			way[1] = hl_ai_node_org[node * 3 + 1];
			way[2] = hl_ai_node_org[node * 3 + 2];

			*_tol = HLAI_NODE_TOL;
			return;
		}
	}

	HLVecCopy(hl_ai_mon[s].goal, way);
	*_tol = hl_ai_mon[s].goal_tol;
}

Bool HLAIAdvanceWay(I64 s)
{//AdvanceRoute, monsters.cpp:768. FALSE when the goal itself was the waypoint
 //that was reached, which is the end of the move
	if (hl_ai_mon[s].have_detour)
	{
		hl_ai_mon[s].have_detour = FALSE;
		return TRUE;
	}

	if (hl_ai_mon[s].route_len > 0 &&
		hl_ai_mon[s].route_at < hl_ai_mon[s].route_len)
	{
		hl_ai_mon[s].route_at++;
		return TRUE;
	}

	return FALSE;
}

U0 HLAIMonInit()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	I64 i;

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent           = -1;
		hl_ai_mon[i].kind          = -1;
		hl_ai_mon[i].state         = HLMSTATE_NONE;
		hl_ai_mon[i].sched         = HLSCHED_NONE;
		hl_ai_mon[i].task          = 0;
		hl_ai_mon[i].task_status   = HLTK_DONE;
		hl_ai_mon[i].task_start    = 0.0;
		hl_ai_mon[i].sched_done    = TRUE;
		hl_ai_mon[i].have_enemy    = FALSE;
		hl_ai_mon[i].enemy         = -1;
		hl_ai_mon[i].enemy_seen    = 0.0;
		hl_ai_mon[i].have_goal     = FALSE;
		hl_ai_mon[i].goal_is_enemy = FALSE;
		hl_ai_mon[i].goal_tol      = 32.0;
		hl_ai_mon[i].move_speed    = 0.0;
		hl_ai_mon[i].path_start    = 0.0;
		hl_ai_mon[i].stuck_since   = 0.0;
		hl_ai_mon[i].have_detour   = FALSE;
		hl_ai_mon[i].route_len     = 0;
		hl_ai_mon[i].route_at      = 0;
		hl_ai_mon[i].route_time    = 0.0;
		hl_ai_mon[i].next_move_check = 0.0;
		hl_ai_mon[i].ideal_yaw     = 0.0;
		hl_ai_mon[i].next_attack   = 0.0;
		hl_ai_mon[i].next_idle_snd = 0.0;
		hl_ai_mon[i].next_look     = 0.0;
		hl_ai_mon[i].last_health   = 0.0;
		hl_ai_mon[i].scripted      = FALSE;
		hl_ai_mon[i].settled       = FALSE;
		hl_ai_mon[i].squad         = -1;
		hl_ai_mon[i].squad_slots   = 0;
		hl_ai_mon[i].my_slot       = HLSLOT_NONE;
		hl_ai_mon[i].squad_tried   = FALSE;
		hl_ai_mon[i].have_lastpos  = FALSE;
		hl_ai_mon[i].ammo          = 0;
		hl_ai_mon[i].clip          = 0;
		hl_ai_mon[i].heal_time     = 0.0;
		hl_ai_mon[i].aim_pitch     = 0.0;
		hl_ai_mon[i].next_pain_snd = 0.0;
		hl_ai_mon[i].heard         = -1;
		hl_ai_mon[i].heard_type    = HLSOUND_NONE;
		hl_ai_mon[i].activity      = HLACT_IDLE;
		hl_ai_mon[i].act_seq       = -1;
		hl_ai_mon[i].next_blink    = 0.0;
		hl_ai_mon[i].gun_drawn     = FALSE;
		hl_ai_mon[i].in_cover      = FALSE;
		hl_ai_mon[i].fail_sched    = HLSCHED_FAIL;
		hl_ai_mon[i].own_think    = 0.0;
		hl_ai_mon[i].barn_alt      = 0.0;
		hl_ai_mon[i].barn_adj      = HLBARN_ADJ_IDLE;
		hl_ai_mon[i].barn_kill     = -1.0;
		hl_ai_mon[i].barn_gibs     = 0;
		hl_ai_mon[i].barn_prey     = -1;
		hl_ai_mon[i].barn_lifting  = FALSE;
		hl_ai_mon[i].barn_ext      = FALSE;
		hl_ai_mon[i].barn_host     = -1;
		hl_ai_mon[i].mine_arm      = 0.0;
		hl_ai_mon[i].mine_len      = 1.0;
		hl_ai_mon[i].mine_boom     = 0.0;
		hl_ai_mon[i].mine_armed    = FALSE;
		hl_ai_mon[i].mine_dying    = FALSE;
		hl_ai_mon[i].tur_rate      = HLTUR_TURNRATE;
		hl_ai_mon[i].tur_ping      = 0.0;
		hl_ai_mon[i].tur_sight     = 0.0;
		hl_ai_mon[i].tur_dmg_time  = 0.0;
		hl_ai_mon[i].tur_state     = HLTUR_OFF;
		hl_ai_mon[i].rch_light     = -1.0;
		hl_ai_mon[i].rch_nofood    = 0.0;
		hl_ai_mon[i].rch_mode      = HLRCH_IDLE;
		hl_ai_mon[i].rch_lit       = FALSE;

		HLVecSet(hl_ai_mon[i].mine_dir, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].mine_end, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].mine_beam, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].tur_cur, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].tur_goal, 0.0, 0.0, 0.0);

		HLVecSet(hl_ai_mon[i].enemy_pos, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].route_for, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].goal, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].lastpos, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].heard_pos, 0.0, 0.0, 0.0);
		HLVecSet(hl_ai_mon[i].smell_pos, 0.0, 0.0, 0.0);
		hl_ai_mon[i].have_smell = FALSE;
		hl_ai_mon[i].smell_type = HLSOUND_NONE;
	}

	for (i = 0; i < HLENT_MAX; i++)
		hl_ai_mon_of[i] = -1;

	hl_ai_mon_count  = 0;
	hl_ai_mon_base   = NULL;
	hl_ai_mon_ents   = 0;
	hl_ai_mon_clock  = 0.0;
	hl_ai_mon_map[0] = 0;
	hl_ai_mon_revive = TRUE;
	hl_ai_mon_kills  = 0;
	hl_ai_tracer_count = 0;
	hl_ai_laser_spr  = NULL;
	hl_ai_player_move = 0.0;

	HLVecSet(hl_ai_player_last, 0.0, 0.0, 0.0);

	HLAIMonTableInit;
	HLAISchedInit;
	HLAISoundListInit;
}

//top-level, so the tables are sane before anything can reach them
HLAIMonInit;

//--- relationships ----------------------------------------------------------
//
// CBaseMonster::IRelationship indexes a 13x13 table of R_* values by (my
// class, their class). Reproduced as a comparison chain over the nine classes
// the table above uses, rather than as a 169-entry array of which 120 entries
// are unknown. Anything not named below is R_NONE, meaning ignore: a wrong
// R_HATE makes monsters attack their own side, a wrong R_NONE only makes them
// passive.
//
// Barney is CLASS_PLAYER_ALLY, so the player is R_ALLY and every alien is
// R_DISLIKE - he shoots a headcrab and not the player.

I64 HLAIRelationship(I64 mine, I64 theirs)
{
	if (mine == theirs)
	{
		//own kind. HL's diagonal is R_NO except for the military classes, so
		//two grunts do not fight and neither do two zombies
		return HLREL_NONE;
	}

	if (mine == HLCLASS_INSECT)
	{
		//monsters.cpp:2213. A roach fears everything except its own kind and
		//the alien military, which is the row's only R_NO outside the diagonal
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_NONE;

		return HLREL_FEAR;
	}

	if (mine == HLCLASS_MACHINE)
	{
		//monsters.cpp:2204. A turret dislikes everything but the military that
		//set it up: HUMAN_MILITARY is the one R_NO on the row
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_NONE;
		if (theirs == HLCLASS_NONE)				return HLREL_NONE;

		return HLREL_DISLIKE;
	}

	if (mine == HLCLASS_HUMAN_PASSIVE)
	{
		//the scientist row. Player and allies are allies, everything else is
		//feared. HL's row hates rather than fears some of these, but a monster
		//with no attack cannot act on hate; CScientist::SelectSchedule flees
		//either way.
		if (theirs == HLCLASS_PLAYER)			return HLREL_ALLY;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_PREY)		return HLREL_FEAR;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_FEAR;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_PLAYER_ALLY)
	{
		//barney. Hates the military, dislikes aliens, allied to the player and
		//to scientists
		if (theirs == HLCLASS_PLAYER)			return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_ALLY;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_HUMAN_MILITARY)
	{
		//grunts hate the player and his allies above all else
		if (theirs == HLCLASS_PLAYER)			return HLREL_HATE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_HATE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_ALIEN_MONSTER)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_ALIEN_PREDATOR)	return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_ALIEN_MILITARY)
	{
		if (theirs == HLCLASS_PLAYER)			return HLREL_HATE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_HATE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	if (mine == HLCLASS_ALIEN_MONSTER || mine == HLCLASS_ALIEN_PREY ||
		mine == HLCLASS_ALIEN_PREDATOR)
	{
		//the wildlife. Dislikes anything human-shaped, ignores other aliens,
		//except that a predator hunts prey - a bullsquid eats headcrabs.
		if (mine == HLCLASS_ALIEN_PREDATOR && theirs == HLCLASS_ALIEN_PREY)
			return HLREL_HATE;

		if (mine == HLCLASS_ALIEN_PREY && theirs == HLCLASS_ALIEN_PREDATOR)
			return HLREL_FEAR;

		if (theirs == HLCLASS_PLAYER)			return HLREL_DISLIKE;
		if (theirs == HLCLASS_PLAYER_ALLY)		return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_PASSIVE)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_HUMAN_MILITARY)	return HLREL_DISLIKE;
		if (theirs == HLCLASS_MACHINE)			return HLREL_DISLIKE;

		return HLREL_NONE;
	}

	return HLREL_NONE;
}

//--- registration -----------------------------------------------------------

Bool HLAIIsTurretKind(I64 kind)
{//CSentry / CTurret / CMiniTurret share HLAISentryThink
	if (kind == HLMON_SENTRY)
		return TRUE;
	if (kind == HLMON_TURRET)
		return TRUE;
	if (kind == HLMON_MINITURRET)
		return TRUE;
	return FALSE;
}

I64 HLAIMonKindFor(U8 *classname)
{//classname to a table row. A comparison chain, not a U8* table: adjacent
 //string literals concatenate by length on this compiler and a literal table
 //collapses to its first entry, as HLEntModelForClass documents
	I64 i;

	if (!classname || !classname[0])
		return -1;

	//CBabyCrab is CHeadCrab with 0.25 health and a smaller box at Spawn;
	//same kind row, register pass scales the hull
	if (!StrICompare(classname, "monster_babycrab"))
		return HLMON_HEADCRAB;

	for (i = 0; i < HLMON_COUNT; i++)
	{
		if (!StrICompare(hl_ai_mon_info[i].classname, classname))
			return i;
	}

	//monster_scientist_dead is CDeadScientist, a pose over the same model and
	//a different class; HLEntSpawnDeadMonster owns it
	if (!StrICompare(classname, "monster_scientist_dead"))
		return -1;

	return -1;
}

U0 HLAIMonReset(I64 s)
{//one slot back to its resting state, keeping ent and kind
	hl_ai_mon[s].state         = HLMSTATE_IDLE;
	hl_ai_mon[s].sched         = HLSCHED_NONE;
	hl_ai_mon[s].task          = 0;
	hl_ai_mon[s].task_status   = HLTK_DONE;
	hl_ai_mon[s].task_start    = 0.0;
	hl_ai_mon[s].sched_done    = TRUE;
	hl_ai_mon[s].conds         = HLCOND_NONE;
	hl_ai_mon[s].flinched      = FALSE;
	hl_ai_mon[s].have_enemy    = FALSE;
	hl_ai_mon[s].enemy         = -1;
	hl_ai_mon[s].enemy_seen    = 0.0;
	hl_ai_mon[s].have_goal     = FALSE;
	hl_ai_mon[s].goal_is_enemy = FALSE;
	hl_ai_mon[s].goal_tol      = 32.0;
	hl_ai_mon[s].move_speed    = 0.0;
	hl_ai_mon[s].path_start    = 0.0;
	hl_ai_mon[s].stuck_since   = 0.0;
	hl_ai_mon[s].have_detour   = FALSE;
	hl_ai_mon[s].route_len     = 0;
	hl_ai_mon[s].route_at      = 0;
	hl_ai_mon[s].route_time    = 0.0;
	hl_ai_mon[s].next_move_check = 0.0;
	hl_ai_mon[s].next_attack   = 0.0;
	hl_ai_mon[s].next_look     = 0.0;
	hl_ai_mon[s].scripted      = FALSE;
	hl_ai_mon[s].settled       = FALSE;
	hl_ai_mon[s].squad         = -1;
	hl_ai_mon[s].squad_slots   = 0;
	hl_ai_mon[s].my_slot       = HLSLOT_NONE;
	hl_ai_mon[s].squad_tried   = FALSE;
	hl_ai_mon[s].have_lastpos  = FALSE;
	hl_ai_mon[s].next_pain_snd = 0.0;
	hl_ai_mon[s].heard         = -1;
	hl_ai_mon[s].heard_type    = HLSOUND_NONE;
	hl_ai_mon[s].have_smell    = FALSE;
	hl_ai_mon[s].smell_type    = HLSOUND_NONE;
	hl_ai_mon[s].activity      = HLACT_IDLE;
	hl_ai_mon[s].act_seq       = -1;
	hl_ai_mon[s].next_blink    = 0.0;
	hl_ai_mon[s].next_fidget   = 0.0;
	hl_ai_mon[s].gun_drawn     = FALSE;
	hl_ai_mon[s].in_cover      = FALSE;
	hl_ai_mon[s].fail_sched    = HLSCHED_FAIL;
	hl_ai_mon[s].own_think    = 0.0;
	hl_ai_mon[s].barn_alt      = 0.0;
	hl_ai_mon[s].barn_adj      = HLBARN_ADJ_IDLE;
	hl_ai_mon[s].barn_kill     = -1.0;
	hl_ai_mon[s].barn_gibs     = 0;
	hl_ai_mon[s].barn_prey     = -1;
	hl_ai_mon[s].barn_lifting  = FALSE;
	hl_ai_mon[s].barn_ext      = FALSE;
	hl_ai_mon[s].barn_host     = -1;
	hl_ai_mon[s].mine_arm      = 0.0;
	hl_ai_mon[s].mine_len      = 1.0;
	hl_ai_mon[s].mine_boom     = 0.0;
	hl_ai_mon[s].mine_armed    = FALSE;
	hl_ai_mon[s].mine_dying    = FALSE;
	hl_ai_mon[s].tur_rate      = HLTUR_TURNRATE;
	hl_ai_mon[s].tur_ping      = 0.0;
	hl_ai_mon[s].tur_sight     = 0.0;
	hl_ai_mon[s].tur_dmg_time  = 0.0;
	hl_ai_mon[s].tur_state     = HLTUR_OFF;
	hl_ai_mon[s].tur_orient    = 0;
	hl_ai_mon[s].rch_light     = -1.0;
	hl_ai_mon[s].rch_nofood    = 0.0;
	hl_ai_mon[s].rch_mode      = HLRCH_IDLE;
	hl_ai_mon[s].rch_lit       = FALSE;

	HLVecSet(hl_ai_mon[s].mine_dir, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].mine_end, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].mine_beam, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].tur_cur, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].tur_goal, 0.0, 0.0, 0.0);

	//m_cAmmoLoaded starts full, as CHGrunt::Spawn leaves it. The caller sets
	//kind before calling; a slot with none has no clip either
	hl_ai_mon[s].ammo      = 0;
	hl_ai_mon[s].clip      = 0;
	hl_ai_mon[s].aim_pitch = 0.0;
	hl_ai_mon[s].leaping   = FALSE;
	HLVecSet(hl_ai_mon[s].leap_vel, 0.0, 0.0, 0.0);
	hl_ai_mon[s].leap_die  = 0.0;
	hl_ai_mon[s].tossing   = FALSE;
	hl_ai_mon[s].heal_time = 0.0;

	if (hl_ai_mon[s].kind >= 0 && hl_ai_mon[s].kind < HLMON_COUNT)
		hl_ai_mon[s].clip = hl_ai_mon_info[hl_ai_mon[s].kind].clip_size;

	hl_ai_mon[s].ammo = hl_ai_mon[s].clip;

	HLVecSet(hl_ai_mon[s].enemy_pos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].goal, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].lastpos, 0.0, 0.0, 0.0);
	HLVecSet(hl_ai_mon[s].heard_pos, 0.0, 0.0, 0.0);
}

//--- bodygroups -------------------------------------------------------------
//
//pev->body packs one submodel choice per bodypart into one integer, each part
//contributing a digit of place value bp->base. Measured from the shipped
//models: hgrunt.mdl is body(1 submodel, base 1) / heads(4, base 1) /
//weapons(3, base 4); barney.mdl is studio(1, base 1) / gun(3, base 1).

//GUN_GROUP and its submodels, hgrunt.cpp:71-74
#define HLGRUNT_GUN_GROUP		2
#define HLGRUNT_GUN_MP5			0
#define HLGRUNT_GUN_SHOTGUN		1
#define HLGRUNT_GUN_NONE		2

//HEAD_GROUP and its submodels, hgrunt.cpp:66-70
#define HLGRUNT_HEAD_GROUP		1
#define HLGRUNT_HEAD_GRUNT		0
#define HLGRUNT_HEAD_SHOTGUN	2
#define HLGRUNT_HEAD_M203		3

//pev->weapons on monster_human_grunt, hgrunt.cpp:61-64. 52 of the 205 grunts
//in the shipped maps carry the key: 15 shotgun, 14 grenade launcher
#define HLGRUNT_W_9MMAR			1
#define HLGRUNT_W_HANDGRENADE	2
#define HLGRUNT_W_GLAUNCHER		4
#define HLGRUNT_W_SHOTGUN		8

//m_cClipSize for a shotgun grunt, hgrunt.cpp:1016
#define HLGRUNT_SHOTGUN_CLIP	8

//BARNEY_BODY_*, barney.cpp:39-41. bodypart 0 carries one submodel, so pev->body
//is the gun group directly - which is why CBarney assigns it rather than
//calling SetBodygroup
#define HLBARNEY_GUN_GROUP		1
#define HLBARNEY_GUN_GONE		2

I64 HLAIBodygroup(CHLStudio *m, I64 body, I64 group)
{//::GetBodygroup, animating.cpp. Which submodel of one bodypart `body` selects
	CHLStBodyPart	*bp;
	I64				 base;

	if (!m || group < 0 || group >= m->num_bodyparts)
		return 0;

	bp   = &m->bodyparts[group];
	base = bp->base;

	if (base < 1 || bp->num_models < 1)
		return 0;

	return (body / base) % bp->num_models;
}

U0 HLAISetBodygroup(CHLEntity *e, I64 group, I64 value)
{//::SetBodygroup, animating.cpp. Replaces one bodypart's digit in pev->body
	CHLStBodyPart	*bp;
	I64				 base;
	I64				 cur;

	if (!e || !e->studio || group < 0 || group >= e->studio->num_bodyparts)
		return;

	bp   = &e->studio->bodyparts[group];
	base = bp->base;

	if (base < 1 || bp->num_models < 1)
		return;

	if (value < 0 || value >= bp->num_models)
		return;

	cur = (e->body / base) % bp->num_models;

	e->body = e->body - cur * base + value * base;
}

U0 HLAIMonRegisterAll()
{//claim a slot for every live monster in the entity table
 //
 //applies the parts of Spawn() the generic monster branch in HLEntSpawnOne
 //could not: the hull, and the health from gSkillData. The map's "health" key
 //is overwritten because every CBaseMonster::Spawn assigns pev->health from
 //gSkillData unconditionally and ignores the key.
	CHLEntity	*e;
	CHLMonInfo	*mi;
	U8			*label;
	F64			 aim[3];
	I64			 i;
	I64			 kind;
	I64			 s;
	I64			 seq;
	I64			 w;
	I64			 node;

	//HLConCvarCommand rejects a name that is not in the table, so the script
	//trace registers its own here. HLCvarInit runs at startup, before any map
	hl_ai_script_log = FALSE;

	if (HLCvarIndex("scriptlog") < 0)
		HLCvarDefine("scriptlog", 0.0);

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent  = -1;
		hl_ai_mon[i].kind = -1;
	}

	for (i = 0; i < HLENT_MAX; i++)
	{
		hl_ai_mon_of[i] = -1;

		HLAICineResetRow(i);
		HLAITalkResetRow(i);
	}

	hl_ai_mon_count = 0;
	hl_ai_talk_wait = 0.0;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_MONSTER)
			goto qamr_next;

		kind = HLAIMonKindFor(e->classname);

		if (kind < 0)
			goto qamr_next;

		//HLEntModelForClass in HLEnt.ZC has no row for these classes, so
		//HLEntLoadModels left them with no model at all. Loaded here rather
		//than left as scenery; the cache is shared, so a map's eighty
		//barnacles still cost one model
		if (!e->studio)
		{
			if (kind == HLMON_BARNACLE)
				e->studio = HLStudioCacheGet("models/barnacle.mdl");
			else if (kind == HLMON_TRIPMINE)
				e->studio = HLStudioCacheGet("models/v_tripmine.mdl");
			else if (kind == HLMON_SENTRY)
				e->studio = HLStudioCacheGet("models/sentry.mdl");
			else if (kind == HLMON_TURRET)
				e->studio = HLStudioCacheGet("models/turret.mdl");
			else if (kind == HLMON_MINITURRET)
				e->studio = HLStudioCacheGet("models/miniturret.mdl");
			else if (kind == HLMON_TENTACLE)
				e->studio = HLStudioCacheGet("models/tentacle2.mdl");
			else if (kind == HLMON_NIHILANTH)
				e->studio = HLStudioCacheGet("models/nihilanth.mdl");
			else if (kind == HLMON_APACHE)
				e->studio = HLStudioCacheGet("models/apache.mdl");
			else if (kind == HLMON_OSPREY)
				e->studio = HLStudioCacheGet("models/osprey.mdl");
			else if (kind == HLMON_HEADCRAB &&
				!StrICompare(e->classname, "monster_babycrab"))
				e->studio = HLStudioCacheGet("models/baby_headcrab.mdl");

			if (e->studio)
				HLEntInitBoneControllers(e);
		}

		//no model: nothing to animate and no way to tell what it is.
		//HLEntLoadModels already failed on it, so leave it as scenery
		if (!e->studio)
			goto qamr_next;

		if (hl_ai_mon_count >= HLAI_MON_MAX)
		{
			"HLAI: more than %d monsters, the rest are idle\n", HLAI_MON_MAX;
			goto qamr_done;
		}

		s  = hl_ai_mon_count;
		mi = &hl_ai_mon_info[kind];

		hl_ai_mon[s].ent  = i;
		hl_ai_mon[s].kind = kind;
		HLAIMonReset(s);

		hl_ai_mon[s].last_health   = mi->health;
		hl_ai_mon[s].ideal_yaw     = e->angles[1];
		hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
			ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));

		//staggered, so a roomful of monsters does not all Look on one tick
		hl_ai_mon[s].next_look = hl_ent_time +
			ToF64(s % 8) * (HLAI_LOOK_PERIOD / 8.0);

		hl_ai_mon_of[i] = s;
		hl_ai_mon_count++;

		//the parts of Spawn() the shared entity struct can carry
		HLVecCopy(mi->mins, e->mins);
		HLVecCopy(mi->maxs, e->maxs);

		//CGenericMonster::Spawn, genericmonster.cpp:110-112: player.mdl and
		//holo.mdl take the centred VEC_HULL, every other model the standing
		//VEC_HUMAN_HULL. Both are authored around their middle - holo.mdl's
		//takes run -36.5 to 37.5 and player.mdl's -36.1 to 37.2, against 0 to
		//72 for every other studio monster - so on the standing hull the floor
		//drop plants their waist on the ground. 33 of the 82 monster_generic in
		//valve/maps wear holo.mdl.
		//
		//studiohdr_t::name at offset 8, which is the path studiomdl compiled
		//from, not the mapper's key
		if (kind == HLMON_GENERIC &&
			(StrIMatch("holo.mdl", e->studio->name) ||
			 StrIMatch("player.mdl", e->studio->name)))
		{
			HLVecSet(e->mins, -16.0, -16.0, -36.0);
			HLVecSet(e->maxs, 16.0, 16.0, 36.0);
		}

		HLEntSetAbsBox(e);

		//SetActivity(ACT_IDLE). HLEntSpawnOne leaves pev->sequence at 0 and
		//sequence 0 is a walk take in scientist.mdl, hgrunt.mdl and
		//bullsquid.mdl, an attack in controller.mdl and a run in roach.mdl, so
		//a monster held on it walks or fires on the spot until some schedule
		//first sets an activity. HLMON_GENERIC never runs one: HLAIMonThink
		//returns above the state machine for that row, and 36 of the 82
		//instances in valve/maps wear holo.mdl, scientist.mdl or barney.mdl,
		//whose sequence 0 is a walk.
		//
		//HLAIResolveActivity is defined further down and ZealC is single-pass,
		//so its two steps are repeated here: LookupActivity on ACT_IDLE, then
		//the label table for the models that tag nothing.
		seq = HLStudioLookupActivity(e->studio, 1);

		if (seq < 0)
		{
			label = HLAIMonSeqOf(kind, HLACT_IDLE);

			if (label)
				seq = HLStudioSeqByName(e->studio, label);
		}

		//a model with neither keeps sequence 0: a ribcage carries one pose
		if (seq >= 0)
		{
			e->seq              = seq;
			e->anim_loop        = TRUE;
			e->anim_done        = FALSE;
			e->anim_event_frame = -1;
			e->anim_start       = hl_ent_time;

			//m_Activity is already HLACT_IDLE out of HLAIMonReset; recording
			//the take with it is what keeps the first HLAISetActivity(IDLE)
			//from re-rolling the weighted pick and restarting the cycle
			hl_ai_mon[s].act_seq = seq;
		}

		e->health     = mi->health;
		e->max_health = mi->health;
		e->takedamage = HLDMG_TAKE_YES;

		//pitch and roll are not animated; a mapper-set pitch renders the
		//monster leaning over.
		//
		//The tripmine keeps both: pev->angles is the normal of the surface it
		//is stuck to and the tripwire runs down it, so a ceiling mine has a
		//pitch of 90 and firing its wire along the floor is the wrong wall.
		//Turrets keep pitch until the orientation pass below reads it.
		if (kind != HLMON_TRIPMINE && !HLAIIsTurretKind(kind))
		{
			e->angles[0] = 0.0;
			e->angles[2] = 0.0;
		}

		//CBarnacle::Spawn is MOVETYPE_NONE, barnacle.cpp:108. The generic
		//monster_ branch in HLEntSpawnOne gives every monster MOVETYPE_STEP
		if (kind == HLMON_BARNACLE)
			e->movetype = HLMOVETYPE_NONE;

		//SF_GENERICMONSTER_NOTSOLID, genericmonster.cpp:121-125. The holograms
		//and the bone piles: the player walks through them and they cannot be
		//shot. 75 of the 82 monster_generic entities in the shipped maps carry
		//the flag, so the common case is a prop and not an actor
		if (kind == HLMON_GENERIC && (e->spawnflags & HLMON_SF_NOTSOLID))
		{
			e->solid      = HLSOLID_NOT;
			e->takedamage = HLDMG_TAKE_NO;
		}

		//CHGrunt::Spawn, hgrunt.cpp:1005-1036. pev->weapons is the loadout the
		//mapper set; an unset key means 9mmAR plus hand grenades.
		//
		//The shotgun is a gun submodel and a head submodel and an eight round
		//clip. The grenade launcher is a head submodel and the dark skin only:
		//it shares GUN_MP5, so the launcher itself is drawn on the head model.
		//Both are read back by HLAIDropDeathItems, which is what makes the
		//corpse leave the right weapon
		if (kind == HLMON_HGRUNT)
		{
			w = e->weapons;

			if (!w)
				w = HLGRUNT_W_9MMAR | HLGRUNT_W_HANDGRENADE;

			//hgrunt.cpp:1024-1027. Four grunts in five wear the light skin
			e->skin = 1;

			if (HLPartRandI(100) < 80)
				e->skin = 0;

			if (w & HLGRUNT_W_SHOTGUN)
			{
				HLAISetBodygroup(e, HLGRUNT_GUN_GROUP, HLGRUNT_GUN_SHOTGUN);
				HLAISetBodygroup(e, HLGRUNT_HEAD_GROUP, HLGRUNT_HEAD_SHOTGUN);

				hl_ai_mon[s].clip = HLGRUNT_SHOTGUN_CLIP;
				hl_ai_mon[s].ammo = HLGRUNT_SHOTGUN_CLIP;
			}
			else if (w & HLGRUNT_W_GLAUNCHER)
			{
				HLAISetBodygroup(e, HLGRUNT_HEAD_GROUP, HLGRUNT_HEAD_M203);
				e->skin = 1;
			}
		}

		//CBaseTurret::Spawn, turret.cpp:249-252. MOVETYPE_FLY, SOLID_SLIDEBOX,
		//sequence 0 held. m_flStartYaw is pev->angles.y, which the yaw
		//controller is measured against. orientation key / ceiling angles:
		//m_iOrientation 1 flips pitch to 180 and yaw +180 (turret.cpp:368-377).
		if (HLAIIsTurretKind(kind))
		{
			e->movetype  = HLMOVETYPE_FLY;
			e->solid     = HLSOLID_SLIDEBOX;
			e->seq       = 0;
			e->anim_loop = FALSE;

			hl_ai_mon[s].tur_state  = HLTUR_OFF;
			hl_ai_mon[s].tur_rate   = HLTUR_TURNRATE;
			hl_ai_mon[s].tur_orient = e->orient;

			//ceiling mount: authored orientation 1, or pitch near 180
			if (e->orient == 1 || e->angles[0] > 90.0)
			{
				hl_ai_mon[s].tur_orient = 1;
				e->angles[0] = 180.0;
				e->angles[1] = HLAngleNorm(e->angles[1] + 180.0);
			}
			else
			{
				e->angles[0] = 0.0;
			}

			e->angles[2] = 0.0;

			HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
			HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);
		}

		//CBabyCrab::Spawn, headcrab.cpp:498-506: same sequences, 0.25 health,
		//tiny hull over the adult VEC size
		if (kind == HLMON_HEADCRAB &&
			!StrICompare(e->classname, "monster_babycrab"))
		{
			e->health     = mi->health * 0.25;
			e->max_health = e->health;
			hl_ai_mon[s].last_health = e->health;
			HLVecSet(e->mins, -6.0, -6.0, 0.0);
			HLVecSet(e->maxs, 6.0, 6.0, 12.0);
			HLEntSetAbsBox(e);
		}

		//CTripmineGrenade::Spawn, tripmine.cpp:97-118. MOVETYPE_FLY and
		//SOLID_NOT until the beam comes up, the held "world" pose at
		//framerate 0, and a powerup clock the spawnflag shortens.
		//
		//pev->angles is the surface normal the mapper faced it along; the
		//tripwire runs down its forward vector
		if (kind == HLMON_TRIPMINE)
		{
			e->movetype  = HLMOVETYPE_FLY;
			e->solid     = HLSOLID_NOT;
			e->body      = HLMINE_BODY;
			e->seq       = HLMINE_SEQ;
			e->anim_loop = FALSE;

			//framerate 0: a placed mine holds frame 0 of "world"
			e->anim_start = hl_ent_time;
			e->anim_done  = TRUE;

			HLEntSetAbsBox(e);

			hl_ai_mon[s].mine_arm = hl_ent_time + HLMINE_ARM_SLOW;

			if (e->spawnflags & HLMINE_SF_FAST)
				hl_ai_mon[s].mine_arm = hl_ent_time + HLMINE_ARM_FAST;

			//UTIL_MakeAimVectors, util.cpp: pitch is negated before the basis
			//is built, so a ceiling mine's wire points down and not up
			HLVecSet(aim, -e->angles[0], e->angles[1], e->angles[2]);
			HLAngleVectors(aim, hl_ai_mon[s].mine_dir, NULL, NULL);

			HLVecMA(e->origin, HLMINE_RANGE, hl_ai_mon[s].mine_dir,
				hl_ai_mon[s].mine_end);
			HLVecCopy(hl_ai_mon[s].mine_end, hl_ai_mon[s].mine_beam);

			if (!hl_ai_laser_spr)
				hl_ai_laser_spr =
					HLEntSprCacheGet("sprites/laserbeam.spr");
		}

		//CBigMomma::Activate / NodeStart: target names the first info_bigmomma.
		//Seed have_goal so idle walk schedules head there. Combat still chases
		//the player; HLAIRunPath advances the node chain on arrival.
		if (kind == HLMON_BIGMOMMA && e->target[0])
		{
			node = HLEntFindByTargetname(e->target, 0);
			if (node >= 0 &&
				!StrCompare(hl_entities[node].classname, "info_bigmomma"))
			{
				HLVecCopy(hl_entities[node].origin, hl_ai_mon[s].goal);
				hl_ai_mon[s].have_goal     = TRUE;
				hl_ai_mon[s].goal_is_enemy = FALSE;
				hl_ai_mon[s].goal_tol      = 128.0;
			}
		}

qamr_next:
	}

qamr_done:
	if (hl_ai_mon_count)
		"HLAI: %d monsters\n", hl_ai_mon_count;
}

U0 HLAIMonSync()
{//re-register when the entity table has been rebuilt
 //
 //HLEntSpawnAll is in HLEntity.ZC and compiles first, so there is no per-map
 //hook and the change is detected instead. The map name is the decisive
 //signal - pointer reuse and matching entity counts across tram maps used to
 //skip re-registration, which left cine/talk rows and g_talkWaitTime from the
 //previous map sitting on the new entity indices.
 //
 //On the same map the count is compared with >=, not ==. HLEntCreateNamed
 //appends a slot and bumps hl_num_entities at runtime - a dropped weapon, a
 //breakable's spawn object - and an == here read that as a new map and
 //re-registered, which puts every monster's health back to the table figure
 //and stands the corpses up. Only item_, weapon_ and ammo_ classes can be
 //created that way, none of them HLC_MONSTER, so growth alone needs no
 //re-registration.
	if (!StrCompare(hl_ai_mon_map, hl_map_name) &&
		hl_entities == hl_ai_mon_base &&
		hl_num_entities >= hl_ai_mon_ents)
	{
		hl_ai_mon_ents  = hl_num_entities;
		hl_ai_mon_clock = hl_ent_time;
		return;
	}

	HLStrCopy(hl_ai_mon_map, hl_map_name, 96);
	hl_ai_mon_base  = hl_entities;
	hl_ai_mon_ents  = hl_num_entities;
	hl_ai_mon_clock = hl_ent_time;

	//Force the graph probe to treat this as a new map even if Ensure has not
	//run yet this tick - drops a stale hl_ai_graph_retry from the tram ride.
	hl_ai_graph_map[0] = 0;
	hl_ai_graph_ready  = FALSE;
	hl_ai_graph_tries  = 0;
	hl_ai_graph_retry  = 0.0;

	HLAIMonRegisterAll;
}

//--- sensing ----------------------------------------------------------------

U0 HLAIPlayerOrigin(F64 *out)
{//the player's feet, which is what a monster's range checks compare against
 //
 //hl_origin lives in HL1.ZC and compiles later, so the position comes from
 //hl_snd_listener, the eye HL1.ZC hands the mixer every rendered frame. It
 //carries view bob and the step offset on top of HLAI_PLAYER_EYE, a couple of
 //units, immaterial at sighting range.
	HLVecCopy(hl_snd_listener, out);
	out[2] -= HLAI_PLAYER_EYE;
}

U0 HLAIMonEye(I64 s, F64 *out)
{//pev->origin + pev->view_ofs, where a monster's sight lines start
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
	{
		HLVecSet(out, 0.0, 0.0, 0.0);
		return;
	}

	HLVecCopy(e->origin, out);
	out[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

	//CBaseTurret::Initialize ceiling: pev->view_ofs.z negated, turret.cpp:372
	if (HLAIIsTurretKind(hl_ai_mon[s].kind) && hl_ai_mon[s].tur_orient == 1)
		out[2] -= 2.0 * hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;
}

Bool HLAITargetIsPlayer(I64 target)
{//the player is target -1; every other index is an entity
	return ToBool(target < 0);
}

F64 HLAITargetHealth(I64 target)
{//pev->health of either kind of target. The player's lives in HLEntity.ZC's
 //native player state, a monster's in its entity slot. 0 when it is gone.
	CHLEntity *e;

	if (HLAITargetIsPlayer(target))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return 0.0;

		return hl_ent_player_health;
	}

	e = HLEntGet(target);

	if (!e)
		return 0.0;

	return e->health;
}

Bool HLAITargetPos(I64 target, F64 *feet, F64 *eye)
{//where a target is and where to aim at it. FALSE when it is gone or dead, so
 //a monster stops shooting a corpse
	CHLEntity	*e;
	I64			 s;

	if (HLAITargetIsPlayer(target))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(feet);
		HLVecCopy(hl_snd_listener, eye);

		return TRUE;
	}

	e = HLEntGet(target);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = -1;

	if (target < HLENT_MAX)
		s = hl_ai_mon_of[target];

	if (s < 0)
		return FALSE;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return FALSE;

	HLVecCopy(e->origin, feet);
	HLVecCopy(e->origin, eye);
	eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

	return TRUE;
}

I64 HLAITargetClass(I64 target)
{//Classify() for either kind of target
	I64 s;

	if (HLAITargetIsPlayer(target))
		return HLCLASS_PLAYER;

	if (target < 0 || target >= HLENT_MAX)
		return HLCLASS_NONE;

	s = hl_ai_mon_of[target];

	if (s < 0)
		return HLCLASS_NONE;

	//CBaseTurret::Classify, turret.cpp:1129: a turret is CLASS_MACHINE only
	//while it is deployed. Folded and asleep it is CLASS_NONE, which is what
	//keeps a barney from shooting one that has not woken up
	if (HLAIIsTurretKind(hl_ai_mon[s].kind) &&
		hl_ai_mon[s].tur_state == HLTUR_OFF)
		return HLCLASS_NONE;

	return hl_ai_mon_info[hl_ai_mon[s].kind].classify;
}

Bool HLAIInViewCone(I64 s, F64 *point)
{//FInViewCone: dot of the monster's facing with the direction to the point,
 //against m_flFieldOfView. A cosine, so -1.0 is all round.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 forward[3];
	F64			 ang[3];
	F64			 dir[3];

	if (!e)
		return FALSE;

	//yaw only. HL uses the full angle vector, but nothing here pitches a
	//monster and pev->angles as-is would let a mapper's stray pitch key
	//blind it
	HLVecSet(ang, 0.0, e->angles[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(point, e->origin, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return TRUE;

	return ToBool(HLVecDot(dir, forward) >=
		hl_ai_mon_info[hl_ai_mon[s].kind].fov);
}

Bool HLAIPlayerSees(F64 *point)
{//player's FInViewCone(monster): yaw from hl_ent_player_ang vs the point.
 //VIEW_FIELD_NARROW (0.7) matches a player who has not been given a monster
 //FOV; WAIT_TILL_SEEN only needs "facing us", not combat FOV.
	F64 forward[3];
	F64 ang[3];
	F64 dir[3];

	HLVecSet(ang, 0.0, hl_ent_player_ang[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(point, hl_ent_player_org, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return TRUE;

	return ToBool(HLVecDot(dir, forward) >= 0.7);
}

Bool HLAIVisible(I64 s, F64 *target_eye)
{//FVisible: a point trace from eye to eye. Anything in the way blocks it
 //
 //HL also rejects a line crossing from air into water. CHLTrace reports both
 //contents, so that test is applied here too.
	CHLTrace	tr;
	F64			 eye[3];
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLAIMonEye(s, eye);
	HLVecSet(zero, 0.0, 0.0, 0.0);

	HLTraceEntity(hl_map, eye, target_eye, zero, zero, 0, TRUE, &tr);

	if (tr.in_open && tr.in_water)
		return FALSE;

	return ToBool(tr.fraction >= 1.0);
}

U0 HLAILook(I64 s)
{//CBaseMonster::Look plus BestVisibleEnemy, over the player and every live
 //monster: there is no entity list to walk with ALL_CONTENTS, so the candidates
 //are the only two things that can be a target.
 //
 //Deviation: BestVisibleEnemy returns only targets whose relationship is worse
 //than R_NONE, so a feared target never becomes m_hEnemy. With no sound sensing
 //that leaves a fleeing monster nothing to flee from, so fear counts here and
 //the schedule selector decides whether the enemy is charged or run from.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best      = -1;
	I64			 best_rel  = 0;
	I64			 rel;
	I64			 sighted   = 0;
	I64			 target;
	I64			 i;
	Bool		 found     = FALSE;
	Bool		 is_player;

	//"DON'T let visibility information from last frame sit around", monsters.
	//cpp:310. Cleared before the early return: a monster that has lost sight of
	//everything must not keep last pass's SEE_ bits
	HLAIClearCond(s, HLCOND_SEE_HATE | HLCOND_SEE_DISLIKE | HLCOND_SEE_FEAR |
		HLCOND_SEE_ENEMY | HLCOND_SEE_CLIENT);

	if (!e)
		return;

	mi        = &hl_ai_mon_info[hl_ai_mon[s].kind];
	best_dist = mi->look_dist;

	//-1 is the player, then every entity index. One loop over both keeps the
	//player out of the scoring as a special case
	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;
		is_player = FALSE;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qal_next;
		}
		else
		{
			is_player = TRUE;

			if (hl_ent_notarget)
			{
				//FL_NOTARGET: CBaseMonster::Look skips the player entirely, so it
				//is never seen and never becomes m_hEnemy.
				goto qal_next;
			}
		}

		rel = HLAIRelationship(mi->classify, HLAITargetClass(target));

		//R_NO is skipped. R_AL (ally) still runs for the player so SEE_CLIENT
		//and SF_MONSTER_WAIT_TILL_SEEN fire; allies are not enemy-scored below
		if (rel == HLREL_NONE)
			goto qal_next;

		if (rel == HLREL_ALLY && !is_player)
			goto qal_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qal_next;

		HLVecSub(feet, e->origin, d);
		dist = HLVecLength(d);

		if (dist > mi->look_dist)
			goto qal_next;

		if (!HLAIInViewCone(s, feet))
			goto qal_next;

		if (!HLAIVisible(s, eye))
			goto qal_next;

		if (is_player)
		{
			//SF_MONSTER_WAIT_TILL_SEEN, monsters.cpp:339: ignore the player
			//until they face us, then clear the flag and become normal
			if (e->spawnflags & HLAI_SF_MONSTER_WAIT_TILL_SEEN)
			{
				if (!HLAIPlayerSees(e->origin))
					goto qal_next;

				e->spawnflags = e->spawnflags & ~HLAI_SF_MONSTER_WAIT_TILL_SEEN;
			}

			sighted = sighted | HLCOND_SEE_CLIENT;
		}

		//allies (barney/scientist vs player) raise SEE_CLIENT only
		if (rel == HLREL_ALLY)
			goto qal_next;

		//iSighted, monsters.cpp:358-397. Accumulated over every visible
		//candidate, not just the one that wins the enemy slot
		if (target == hl_ai_mon[s].enemy && hl_ai_mon[s].have_enemy)
			sighted = sighted | HLCOND_SEE_ENEMY;

		if (rel == HLREL_HATE)
			sighted = sighted | HLCOND_SEE_HATE;
		else if (rel == HLREL_DISLIKE)
			sighted = sighted | HLCOND_SEE_DISLIKE;
		else if (rel == HLREL_FEAR)
			sighted = sighted | HLCOND_SEE_FEAR;

		//BestVisibleEnemy's rule: a hated target beats a disliked one at any
		//range, and within one relationship the nearest wins.
		//
		//`found` rather than a sentinel in best_rel: R_NONE sits in the middle
		//of the R_* range, between R_FEAR and R_DISLIKE, so no value means
		//"nothing yet" and also compares correctly against fear
		if (found)
		{
			if (rel < best_rel)
				goto qal_next;

			if (rel == best_rel && dist >= best_dist)
				goto qal_next;
		}

		best      = target;
		best_rel  = rel;
		best_dist = dist;
		found     = TRUE;

qal_next:
		i++;
	}

	HLAISetCond(s, sighted);

	if (!found)
		return;

	//bits_COND_NEW_ENEMY, monsters.cpp:3363. Raised when the pick differs from
	//the one held, which is also the transition GetIdealState reads to enter
	//COMBAT. Re-picking the same target every look pass must not raise it or
	//every schedule with NEW_ENEMY in its mask restarts five times a second
	if (!hl_ai_mon[s].have_enemy || hl_ai_mon[s].enemy != best)
	{
		HLAISetCond(s, HLCOND_NEW_ENEMY);
		HLAIClearCond(s, HLCOND_ENEMY_DEAD);
	}

	hl_ai_mon[s].have_enemy = TRUE;
	hl_ai_mon[s].enemy      = best;
	hl_ai_mon[s].enemy_seen = hl_ent_time;

	//the winner is visible by construction, so SEE_ENEMY holds whether or not
	//it was the enemy when the loop tested it
	HLAISetCond(s, HLCOND_SEE_ENEMY);

	if (HLAITargetPos(best, feet, eye))
		HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
}

//--- hearing ----------------------------------------------------------------
//
// CBaseMonster::Listen plus PBestSound, monsters.cpp. Listen builds a per
// monster audible list and PBestSound picks the nearest entry off it; with a
// 64-entry pool the two collapse into one walk that returns the nearest
// audible sound directly.
//
// A sound is audible when the distance to it is within its own radius scaled
// by the monster's HearingSensitivity, and when its type is in the monster's
// ISoundMask. Nothing here traces: HL's monsters hear through walls, which is
// what makes a gunshot in the next room pull a squad out of position.

I64 HLAIBestSound(I64 s)
{//PBestSound over the live entries, returning the pool index or -1
	CHLMonInfo	*mi;
	F64			 ear[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 mask;
	I64			 sched;
	I64			 best = -1;
	I64			 i;

	if (hl_ai_mon[s].kind < 0)
		return -1;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//"iMySounds &= m_pSchedule->iSoundMask", monsters.cpp:216. The running
	//schedule narrows what the monster hears, never widens it: a grunt walking
	//to one noise is deaf to the next unless it is a danger sound
	mask  = mi->sound_mask;
	sched = hl_ai_mon[s].sched;

	if (sched > HLSCHED_NONE && sched < HLSCHED_COUNT)
		mask = mask & hl_ai_sched_snd[sched];

	if (!mask)
		return -1;

	//EarPosition() is the eye in CBaseMonster; only the tentacle overrides it
	HLAIMonEye(s, ear);

	//PBestSound's own starting bar
	best_dist = 8192.0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			goto qabs_next;

		if (!(hl_ai_snd[i].type & mask))
			goto qabs_next;

		HLVecSub(hl_ai_snd[i].origin, ear, d);
		dist = HLVecLength(d);

		//Listen's audibility test: the radius is scaled by the listener, not
		//by the source
		if (dist > hl_ai_snd[i].volume * mi->hear_sens)
			goto qabs_next;

		if (dist >= best_dist)
			goto qabs_next;

		best      = i;
		best_dist = dist;

qabs_next:
	}

	return best;
}

U0 HLAIListen(I64 s)
{//Listen: latch the best audible sound onto the slot
 //
 //the position is copied rather than kept as an index. A pool entry expires
 //while the monster is still walking to it, and a monster that forgets where
 //it was going mid-schedule stops dead in a corridor.
	I64 i;

	//"ClearConditions(bits_COND_HEAR_SOUND)", monsters.cpp:207
	HLAIClearCond(s, HLCOND_HEAR_SOUND);

	i = HLAIBestSound(s);

	if (i < 0)
	{
		hl_ai_mon[s].heard = -1;
		return;
	}

	hl_ai_mon[s].heard      = i;
	hl_ai_mon[s].heard_type = hl_ai_snd[i].type;

	HLAISetCond(s, HLCOND_HEAR_SOUND);

	HLVecCopy(hl_ai_snd[i].origin, hl_ai_mon[s].heard_pos);
}

U0 HLAISmell(I64 s)
{//PBestScent: CARCASS / MEAT / GARBAGE from the world sound pool.
 //bits_COND_SMELL and bits_COND_SMELL_FOOD, monsters.cpp Listen's scent twin.
	CHLMonInfo	*mi;
	F64			 nose[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 mask;
	I64			 best = -1;
	I64			 i;
	I64			 t;

	HLAIClearCond(s, HLCOND_SMELL | HLCOND_SMELL_FOOD);
	hl_ai_mon[s].have_smell = FALSE;
	hl_ai_mon[s].smell_type = HLSOUND_NONE;

	if (hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	mask = mi->sound_mask & (HLSOUND_CARCASS | HLSOUND_MEAT | HLSOUND_GARBAGE);

	if (!mask)
		return;

	HLAIMonEye(s, nose);
	best_dist = 8192.0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			goto qasm_next;

		t = hl_ai_snd[i].type;

		if (!(t & mask))
			goto qasm_next;

		HLVecSub(hl_ai_snd[i].origin, nose, d);
		dist = HLVecLength(d);

		if (dist > hl_ai_snd[i].volume * mi->hear_sens)
			goto qasm_next;

		if (dist >= best_dist)
			goto qasm_next;

		best      = i;
		best_dist = dist;

qasm_next:
	}

	if (best < 0)
		return;

	hl_ai_mon[s].have_smell = TRUE;
	hl_ai_mon[s].smell_type = hl_ai_snd[best].type;
	HLVecCopy(hl_ai_snd[best].origin, hl_ai_mon[s].smell_pos);

	HLAISetCond(s, HLCOND_SMELL);

	if (hl_ai_snd[best].type & (HLSOUND_CARCASS | HLSOUND_MEAT))
		HLAISetCond(s, HLCOND_SMELL_FOOD);
}

//--- squads -----------------------------------------------------------------
//
// CSquadMonster, dlls/squadmonster.cpp. A squad is a leader and up to four
// members; the leader holds m_afSquadSlots, the set of behaviour bits the
// squad has handed out. A member takes a bit before running the behaviour it
// guards and gives it back when its schedule changes, so at most two grunts
// out of a fireteam are standing and firing at any moment and the rest are in
// cover or holding.
//
// EHANDLEs become slot indices: hl_ai_mon[s].squad is the leader's slot, and a
// leader points at itself. -1 is no squad.

Bool HLAIInSquad(I64 s)
{//InSquad: m_hSquadLeader is not NULL
	return ToBool(hl_ai_mon[s].squad >= 0);
}

I64 HLAISquadLeader(I64 s)
{//MySquadLeader, which returns the monster itself when it has no squad
	if (hl_ai_mon[s].squad < 0)
		return s;

	return hl_ai_mon[s].squad;
}

Bool HLAIIsLeader(I64 s)
{//IsLeader: m_hSquadLeader == this
	return ToBool(hl_ai_mon[s].squad == s);
}

I64 HLAISquadCount(I64 s)
{//SquadCount, callable from a leader or a follower
	I64 leader;
	I64 n = 0;
	I64 i;

	if (!HLAIInSquad(s))
		return 0;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && hl_ai_mon[i].state != HLMSTATE_DEAD)
			n++;
	}

	return n;
}

Bool HLAISquadEnemySplit(I64 s)
{//SquadEnemySplit: TRUE when the members are not all on one enemy
	I64		leader;
	I64		i;
	Bool	have;
	I64		want;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);
	have   = hl_ai_mon[leader].have_enemy;
	want   = hl_ai_mon[leader].enemy;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader)
			goto qaes_next;

		if (!hl_ai_mon[i].have_enemy)
			goto qaes_next;

		//a member fighting something the leader is not
		if (!have || hl_ai_mon[i].enemy != want)
			return TRUE;

qaes_next:
	}

	return FALSE;
}

Bool HLAIOccupySlot(I64 s, I64 desired)
{//OccupySlot: take one of the desired bits, or fail
	I64 leader;
	I64 mask;
	I64 i;

	//a monster with no squad answers to nobody and always succeeds
	if (!HLAIInSquad(s))
		return TRUE;

	if (HLAISquadEnemySplit(s))
	{
		//slots are disabled while the squad is split, so a member is not
		//stranded waiting for a bit held against a different enemy
		hl_ai_mon[s].my_slot = HLSLOT_SQUAD_SPLIT;
		return TRUE;
	}

	leader = HLAISquadLeader(s);

	//already holding one of them
	if (hl_ai_mon[s].my_slot & desired)
		return TRUE;

	//none of the desired bits are free
	if (!(desired & ~hl_ai_mon[leader].squad_slots))
		return FALSE;

	for (i = 0; i < HLAI_NUM_SLOTS; i++)
	{
		mask = 1 << i;

		if (!(desired & mask))
			goto qaos_next;

		if (hl_ai_mon[leader].squad_slots & mask)
			goto qaos_next;

		hl_ai_mon[leader].squad_slots |= mask;
		hl_ai_mon[s].my_slot = mask;

		return TRUE;

qaos_next:
	}

	return FALSE;
}

U0 HLAIVacateSlot(I64 s)
{//VacateSlot, called from ScheduleChange and from Killed
	I64 leader;

	if (hl_ai_mon[s].my_slot == HLSLOT_NONE || !HLAIInSquad(s))
	{
		hl_ai_mon[s].my_slot = HLSLOT_NONE;
		return;
	}

	leader = HLAISquadLeader(s);

	hl_ai_mon[leader].squad_slots &= ~hl_ai_mon[s].my_slot;
	hl_ai_mon[s].my_slot = HLSLOT_NONE;
}

Bool HLAISquadMemberInRange(I64 s, F64 *loc, F64 dist)
{//SquadMemberInRange: is any squadmate within dist of a spot, in 2D
	F64	d[3];
	I64	leader;
	I64	i;

	if (!HLAIInSquad(s))
		return FALSE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasm_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qasm_next;

		HLVecSub(loc, hl_entities[hl_ai_mon[i].ent].origin, d);
		d[2] = 0.0;

		if (HLVecLength(d) <= dist)
			return TRUE;

qasm_next:
	}

	return FALSE;
}

Bool HLAIValidateCover(I64 s, F64 *cover)
{//FValidateCover: a spot another squad member is already standing on is not
 //cover. 128 is the SDK's spacing
	return ToBool(!HLAISquadMemberInRange(s, cover, 128.0));
}

Bool HLAINoFriendlyFire(I64 s)
{//NoFriendlyFire: is the line to the enemy clear of squadmates
 //
 //the SDK builds three planes around the firing line and tests every member
 //against them. The same question answered directly: a member is in the way
 //when it is in front, roughly along the line, and no further off it than a
 //hull width.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dir[3];
	F64			 rel[3];
	F64			 along;
	F64			 range;
	F64			 off;
	I64			 leader;
	I64			 i;

	if (!e || !HLAIInSquad(s) || !hl_ai_mon[s].have_enemy)
		return TRUE;

	HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, dir);
	dir[2] = 0.0;

	range = HLVecNormalize(dir);

	if (range <= 0.0)
		return TRUE;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qanf_next;

		if (hl_ai_mon[i].ent < 0 || !HLEntGet(hl_ai_mon[i].ent))
			goto qanf_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qanf_next;

		HLVecSub(hl_entities[hl_ai_mon[i].ent].origin, e->origin, rel);
		rel[2] = 0.0;

		along = HLVecDot(rel, dir);

		//behind the shooter, or past the target
		if (along <= 0.0 || along >= range)
			goto qanf_next;

		HLVecMA(rel, -along, dir, rel);

		off = HLVecLength(rel);

		//32 is a monster hull's half width plus slop, the width of the
		//SDK's left and right planes
		if (off < 32.0)
			return FALSE;

qanf_next:
	}

	return TRUE;
}

U0 HLAISquadAdd(I64 leader, I64 s)
{//SquadAdd: link one recruit to a leader
	if (hl_ai_mon[s].squad >= 0)
		return;

	hl_ai_mon[s].squad     = leader;
	hl_ai_mon[s].my_slot   = HLSLOT_NONE;
	hl_ai_mon[leader].squad = leader;
}

U0 HLAISquadRemove(I64 s)
{//SquadRemove plus SquadDisband. A leader that dies hands the squad to the
 //next surviving member rather than leaving four monsters pointing at a corpse
	I64 leader;
	I64 heir = -1;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	HLAIVacateSlot(s);

	leader = HLAISquadLeader(s);

	hl_ai_mon[s].squad = -1;

	if (leader != s)
		return;

	//the leader is leaving: find an heir
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader && i != s &&
			hl_ai_mon[i].state != HLMSTATE_DEAD)
		{
			heir = i;
			goto qasr_found;
		}
	}

qasr_found:
	if (heir < 0)
	{
		//SquadDisband: nobody left, so unlink whatever still points here
		for (i = 0; i < hl_ai_mon_count; i++)
		{
			if (hl_ai_mon[i].squad == leader)
			{
				hl_ai_mon[i].squad   = -1;
				hl_ai_mon[i].my_slot = HLSLOT_NONE;
			}
		}

		return;
	}

	hl_ai_mon[heir].squad_slots = hl_ai_mon[leader].squad_slots;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad == leader)
			hl_ai_mon[i].squad = heir;
	}

	hl_ai_mon[heir].squad = heir;
}

U0 HLAISquadMakeEnemy(I64 s, I64 enemy)
{//SquadMakeEnemy: point every member that is not already fighting at the same
 //target. This is what makes one grunt seeing the player turn the whole squad
	I64 leader;
	I64 i;

	if (!HLAIInSquad(s))
		return;

	leader = HLAISquadLeader(s);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].squad != leader || i == s)
			goto qasme_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qasme_next;

		//a member already engaged with this enemy, or with eyes on another
		//one, keeps what it has
		if (hl_ai_mon[i].have_enemy && hl_ai_mon[i].enemy == enemy)
			goto qasme_next;

		if (hl_ai_mon[i].have_enemy &&
			hl_ent_time - hl_ai_mon[i].enemy_seen <= HLAI_LOOK_PERIOD * 2.0)
			goto qasme_next;

		hl_ai_mon[i].have_enemy = TRUE;
		hl_ai_mon[i].enemy      = enemy;

		//the last known position comes from the member that saw it, not from
		//a fresh trace: the others have not looked yet
		HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[i].enemy_pos);

		//not enemy_seen: a member told about an enemy has not seen it, and
		//backdating the sight would let it shoot through a wall
		hl_ai_mon[i].enemy_seen = hl_ent_time - HLAI_LOSE_ENEMY * 0.5;

		//bits_COND_NEW_ENEMY: drop whatever it was doing and re-select
		hl_ai_mon[i].sched      = HLSCHED_NONE;
		hl_ai_mon[i].sched_done = TRUE;

		if (hl_ai_mon[i].state == HLMSTATE_IDLE)
			hl_ai_mon[i].state = HLMSTATE_ALERT;

qasme_next:
	}
}

I64 HLAISquadRecruit(I64 s, F64 radius, I64 max_members)
{//SquadRecruit: gather monsters of my own class into a squad, returning its
 //size. Called once, from the first think, as StartMonster does
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*re;
	F64			 my_eye[3];
	F64			 their_eye[3];
	F64			 d[3];
	I64			 count = 1;
	I64			 i;

	if (!e || hl_ai_mon[s].squad >= 0 || max_members < 2)
		return 0;

	//I am my own leader until somebody joins
	hl_ai_mon[s].squad       = s;
	hl_ai_mon[s].squad_slots = 0;

	HLAIMonEye(s, my_eye);

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (count >= max_members)
			goto qasrc_done;

		if (i == s || hl_ai_mon[i].squad >= 0)
			goto qasrc_next;

		//same class only, and for the wildlife the same classname too: the
		//SDK will not put a headcrab and a houndeye in one pack
		if (hl_ai_mon[i].kind != hl_ai_mon[s].kind)
			goto qasrc_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD || hl_ai_mon[i].scripted)
			goto qasrc_next;

		re = HLEntGet(hl_ai_mon[i].ent);

		if (!re)
			goto qasrc_next;

		HLVecSub(re->origin, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qasrc_next;

		//SquadRecruit traces to the recruit and skips anyone it cannot see,
		//so a grunt does not join a squad through a wall
		HLAIMonEye(i, their_eye);

		if (!HLAIVisible(s, their_eye))
			goto qasrc_next;

		HLAISquadAdd(s, i);
		count++;

qasrc_next:
	}

qasrc_done:
	//no single-member squads
	if (count == 1)
	{
		hl_ai_mon[s].squad = -1;
		return 0;
	}

	return count;
}

//--- turning ----------------------------------------------------------------

F64 HLAIYawTo(F64 *from, F64 *to)
{//UTIL_VecToYaw for the direction between two points
	F64 d[3];

	HLVecSub(to, from, d);
	d[2] = 0.0;

	if (HLVecNormalize(d) <= 0.0)
		return 0.0;

	return Arg(d[0], d[1]) / HLDEG2RAD;
}

F64 HLAIYawDiff(F64 want, F64 have)
{//shortest signed arc between two yaws, degrees. Turning by the raw difference
 //spins a monster the long way round through 359 degrees
	F64 d = HLAngleNorm(want) - HLAngleNorm(have);

	if (d > 180.0)
		d -= 360.0;

	if (d < -180.0)
		d += 360.0;

	return d;
}

Bool HLAITurnToward(I64 s, F64 want, F64 dt)
{//ChangeYaw: step pev->angles towards ideal_yaw at yaw_speed. TRUE once within
 //HLAI_FACE_TOL, which is what the facing tasks wait on
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 diff;
	F64			 step;

	if (!e)
		return TRUE;

	hl_ai_mon[s].ideal_yaw = HLAngleNorm(want);

	diff = HLAIYawDiff(want, e->angles[1]);
	step = hl_ai_mon_info[hl_ai_mon[s].kind].yaw_speed * dt;

	if (diff < 0.0)
	{
		if (step > -diff)
			step = -diff;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > diff)
			step = diff;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}

	if (diff < 0.0)
		diff = -diff;

	return ToBool(diff <= HLAI_FACE_TOL);
}

//--- movement ---------------------------------------------------------------
//
// CBaseMonster::Move, MoveExecute, CheckLocalMove and FTriangulate,
// dlls/monsters.cpp:1798, :1980, :1300 and :1626.
//
// The SDK's Move walks m_Route, which CGraph filled. There is no node graph
// here, so the route is the goal plus at most one triangulated apex. Everything
// below the route is the SDK's: the same 16-unit hop, the same lift-carry-drop
// step, the same 200-unit lookahead, the same eight-iteration apex search. A
// monster still cannot route around a room, but it no longer enters geometry.

#define HLAI_MOVE_OK		0
#define HLAI_MOVE_ARRIVED	1
#define HLAI_MOVE_BLOCKED	2

//LOCALMOVE_*, monsters.h:28-30
#define HLAI_LM_INVALID		0
#define HLAI_LM_NOTRI		1
#define HLAI_LM_VALID		2

#define HLAI_LOCAL_STEP		16.0	//LOCAL_STEP_SIZE, monsters.cpp:1299
#define HLAI_DIST_CHECK		200.0	//DIST_TO_CHECK, monsters.cpp:1796
#define HLAI_MOVE_CHECK		0.1		//CBaseMonster::MonsterThink's interval

Bool HLAIDropToFloor(CHLEntity *e, F64 *pos, F64 *out)
{//CheckLocalMove's floor test. Probe up HLAI_STEP_HEIGHT for headroom, then
 //down three times that for a floor, and refuse the move when there is none:
 //nothing integrates gravity for a STEP entity here, so without this a monster
 //walks off a catwalk and keeps walking through the air.
	CHLTrace	tr;
	F64			 up[3];
	F64			 down[3];

	HLVecCopy(pos, up);
	up[2] += HLAI_STEP_HEIGHT;

	//the step up must clear a ceiling first, or the down trace starts inside
	//solid and reports the whole sweep as blocked
	HLTraceEntity(hl_map, pos, up, e->mins, e->maxs, 0, TRUE, &tr);
	HLVecCopy(tr.end_pos, up);

	HLVecCopy(up, down);
	down[2] -= HLAI_STEP_HEIGHT * 3.0;

	HLTraceEntity(hl_map, up, down, e->mins, e->maxs, 0, TRUE, &tr);

	//no floor inside a step and a fall of one more step: a ledge
	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

Bool HLAIDropToFloorHard(CHLEntity *e, F64 *mins, F64 *maxs, F64 *out)
{//DROP_TO_FLOOR, pr_cmds.c PF_droptofloor, as CBaseMonster::MonsterInit runs
 //it at monsters.cpp:2087. Raise one unit, sweep the box 256 straight down,
 //take the endpoint.
 //
 //HLAIDropToFloor above is CheckLocalMove's ledge probe: it steps up 18 and
 //falls 54, so it settles nothing the mapper hung higher than 36. 145 of the
 //1313 ground monster instances in valve/maps sit further off their floor than
 //that and stayed in the air.
 //
 //FALSE is the engine's 0 return, which PF_droptofloor gives on allsolid or
 //fraction == 1 and on nothing else. start_solid is not a failure there: a box
 //overlapping brushwork at the origin still settles, and refusing it strands
 //monster_sitting_scientist at c1a0d '-3392 1758 -199' 89 units above its
 //floor. The caller's position is left alone on FALSE.
 //
 //mins and maxs are passed rather than read off the entity so a caller can
 //drop against a box other than the clip box.
	CHLTrace	tr;
	F64			 start[3];
	F64			 end[3];

	if (!e || !hl_map)
		return FALSE;

	HLVecCopy(e->origin, start);
	start[2] += 1.0;

	HLVecCopy(start, end);
	end[2] -= HLAI_DROP_DIST;

	HLTraceEntity(hl_map, start, end, mins, maxs, 0, TRUE, &tr);

	if (tr.all_solid || tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

Bool HLAIStepTo(I64 s, F64 *from, F64 *to, F64 *out)
{//SV_movestep, which is what the engine's WALK_MOVE runs: lift by one step
 //height, carry the box across, drop two step heights onto a floor. FALSE is
 //WALKMOVE_CHECKONLY failing - a step too tall, nothing to land on, or
 //something solid in between. Every mover below is built on this.
 //
 //Destination and source are at the same height in every caller: the direction
 //is flattened before the hop is taken.
 //
 //Deviation: SV_movestep does not sweep the horizontal leg, it traces straight
 //down at the destination, which is why CheckLocalMove and MoveExecute both cap
 //the hop at 16 units. The leg is swept here too. A monster cutting the corner
 //of a doorframe is what the destination-only test misses, and the sweep is one
 //trace.
 //
 //A trace that begins embedded reports the whole sweep clear: HLTraceEntity
 //returns on all_solid before any entity pass, HLClip.ZC:618, leaving
 //HLTraceInit's fraction of 1.0 and end_pos on the far end, HLClip.ZC:181-188.
 //Taken at face value that walks a stuck monster through the wall it is stuck
 //in, so all_solid and start_solid both refuse the step.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 up[3];
	F64			 over[3];
	F64			 down[3];
	Bool		 ok = FALSE;

	if (!e || !hl_map)
		return FALSE;

	//the sweep clips the box solids as well, so a monster is stopped by another
	//monster and by the player. hl_ent_clip_ignore keeps it out of its own box
	//and is lowered again on every exit: left raised, the player stays solid to
	//everything that traces afterwards, HLEntity.ZC:1094-1097
	hl_ent_clip_ignore   = hl_ai_mon[s].ent;
	hl_clip_for_monster  = TRUE;

	//a MOVETYPE_FLY monster holds the height it is given. There is no floor
	//under a controller
	if (hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		HLTraceEntity(hl_map, from, to, e->mins, e->maxs, 0, FALSE, &tr);

		if (!tr.all_solid && !tr.start_solid && tr.fraction >= 1.0)
		{
			HLVecCopy(to, out);
			ok = TRUE;
		}

		hl_ent_clip_ignore  = -1;
		hl_clip_for_monster = FALSE;

		return ok;
	}

	HLVecCopy(from, up);
	up[2] += HLAI_STEP_HEIGHT;

	HLVecCopy(to, over);
	over[2] = up[2];

	HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

	if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
	{
		//the lift put the box in a ceiling. SV_movestep drops it by one step
		//and retries flat, which is how a monster crosses a low crawlspace
		up[2]   = from[2];
		over[2] = from[2];

		HLTraceEntity(hl_map, up, over, e->mins, e->maxs, 0, FALSE, &tr);

		if (tr.all_solid || tr.start_solid || tr.fraction < 1.0)
		{
			hl_ent_clip_ignore  = -1;
			hl_clip_for_monster = FALSE;
			return FALSE;
		}
	}

	//two step heights down from one step up: a net fall of one step, the drop
	//the engine lets a monster walk off
	HLVecCopy(over, down);
	down[2] -= HLAI_STEP_HEIGHT * 2.0;

	HLTraceEntity(hl_map, over, down, e->mins, e->maxs, 0, FALSE, &tr);

	hl_ent_clip_ignore  = -1;
	hl_clip_for_monster = FALSE;

	if (tr.all_solid || tr.start_solid)
		return FALSE;

	//nothing to land on within a step: walked off an edge
	if (tr.fraction >= 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, out);

	return TRUE;
}

I64 HLAICheckLocalMove(I64 s, F64 *start, F64 *end, F64 *_dist)
{//::CheckLocalMove, monsters.cpp:1300. Walk the straight line in
 //LOCAL_STEP_SIZE hops; *_dist is how far it got, which FTriangulate needs to
 //place its apex past the obstruction.
 //
 //Deviation: the SDK carries the monster along the line with UTIL_SetOrigin and
 //undoes the move afterwards, monsters.cpp:1316 and :1397. The walk here is on
 //a local position and the entity never moves, so no trace observes the probe.
 //
 //The pTarget case, "if this step hits target ent the move is legal",
 //monsters.cpp:1356-1361, has no counterpart: callers pass a position rather
 //than an entity, and the goal tolerance already stops the monster short of a
 //body.
	F64	at[3];
	F64	to[3];
	F64	dir[3];
	F64	dist;
	F64	walked;
	F64	size;

	if (_dist)
		*_dist = 0.0;

	HLVecSub(end, start, dir);
	dir[2] = 0.0;

	dist = HLVecNormalize(dir);

	if (dist <= 0.0)
		return HLAI_LM_VALID;

	HLVecCopy(start, at);

	walked = 0.0;

	while (walked < dist)
	{
		size = HLAI_LOCAL_STEP;

		//the last hop stops one unit short of the goal, monsters.cpp:1344-1345
		if (walked + HLAI_LOCAL_STEP >= dist - 1.0)
			size = (dist - walked) - 1.0;

		if (size <= 0.0)
			goto qclm_done;

		HLVecMA(at, size, dir, to);

		if (!HLAIStepTo(s, at, to, at))
		{
			if (_dist)
				*_dist = walked;

			return HLAI_LM_INVALID;
		}

		walked += HLAI_LOCAL_STEP;
	}

qclm_done:
	if (_dist)
		*_dist = dist;

	//"the monster can move to a spot UNDER the target, but not to it",
	//monsters.cpp:1375-1382. 64 is the SDK's own constant, chosen because
	//pev->size.z is wrong for a headcrab. Triangulating out of this only walks
	//the same line again
	if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies)
	{
		if (end[2] - at[2] > 64.0 || at[2] - end[2] > 64.0)
			return HLAI_LM_NOTRI;
	}

	return HLAI_LM_VALID;
}

Bool HLAITriangulate(I64 s, F64 *start, F64 *end, F64 dist, F64 *apex)
{//::FTriangulate, monsters.cpp:1626. Probe an apex either side of the
 //obstruction and take the first from which the goal is still reachable.
 //
 //vecFarSide is m_Route[m_iRouteIndex].vecLocation, monsters.cpp:1668; with no
 //route that is the goal itself.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 fwd[3];
	F64			 side[3];
	F64			 rise[3];
	F64			 ahead[3];
	F64			 left[3];
	F64			 right[3];
	F64			 top[3];
	F64			 bottom[3];
	F64			 push[3];
	F64			 pushz[3];
	F64			 size_x;
	F64			 size_z;
	Bool		 flies;
	I64			 i;

	if (!e)
		return FALSE;

	flies = hl_ai_mon_info[hl_ai_mon[s].kind].flies;

	//CheckLocalMove works in 16-unit hops and the SDK clamps the apex offset to
	//[24, 48] regardless of hull, monsters.cpp:1638-1644
	size_x = e->maxs[0] - e->mins[0];

	if (size_x < 24.0)
		size_x = 24.0;
	else if (size_x > 48.0)
		size_x = 48.0;

	size_z = e->maxs[2] - e->mins[2];

	HLVecSub(end, start, fwd);

	if (HLVecNormalize(fwd) <= 0.0)
		return FALSE;

	HLVecSet(rise, 0.0, 0.0, 1.0);
	HLVecCross(fwd, rise, side);

	//one hull width past the obstruction so the turn back onto course clears
	//it, three hull widths out to the side, monsters.cpp:1660-1661
	HLVecMA(start, dist + size_x, fwd, ahead);

	HLVecMA(ahead, -(size_x * 3.0), side, left);
	HLVecMA(ahead, size_x * 3.0, side, right);

	//over and under, for a flier only, monsters.cpp:1662-1665
	HLVecMA(start, dist, fwd, ahead);
	HLVecMA(ahead, size_z * 3.0, rise, top);
	HLVecMA(ahead, -(size_z * 3.0), rise, bottom);

	HLVecScale(side, size_x * 2.0, push);
	HLVecScale(rise, size_z * 2.0, pushz);

	for (i = 0; i < 8; i++)
	{
		if (HLAICheckLocalMove(s, start, right, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, right, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(right, apex);
				return TRUE;
			}
		}

		if (HLAICheckLocalMove(s, start, left, NULL) == HLAI_LM_VALID)
		{
			if (HLAICheckLocalMove(s, left, end, NULL) == HLAI_LM_VALID)
			{
				HLVecCopy(left, apex);
				return TRUE;
			}
		}

		if (flies)
		{
			if (HLAICheckLocalMove(s, start, top, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, top, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(top, apex);
					return TRUE;
				}
			}

			if (HLAICheckLocalMove(s, start, bottom, NULL) == HLAI_LM_VALID)
			{
				if (HLAICheckLocalMove(s, bottom, end, NULL) == HLAI_LM_VALID)
				{
					HLVecCopy(bottom, apex);
					return TRUE;
				}
			}
		}

		HLVecAdd(right, push, right);
		HLVecSub(left, push, left);

		if (flies)
		{
			HLVecAdd(top, pushz, top);
			HLVecSub(bottom, pushz, bottom);
		}
	}

	return FALSE;
}

F64 HLAIGroundSpeed(I64 s, F64 fallback)
{//m_flGroundSpeed. GetSequenceInfo derives it from the distance studiomdl baked
 //into the sequence, animating.cpp:114, so the feet match the ground. The table
 //figure is two to five times wrong - a scientist walk is 58.75 u/s derived
 //against 40 in the table - and the difference is the feet sliding.
 //
 //The fallback covers a sequence that carries no linear movement.
 //monsters.cpp:1953 and :1987 both divide by this and must never see zero
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 gs;

	if (e && e->studio)
	{
		gs = HLStudioSeqGroundSpeed(e->studio, e->seq);

		if (gs > 0.0)
			return gs;
	}

	return fallback;
}

I64 HLAIMoveStep(I64 s, F64 speed, F64 dt)
{//::Move plus ::MoveExecute, monsters.cpp:1798 and :1980, for one tick
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 way[3];
	F64			 dir[3];
	F64			 at[3];
	F64			 to[3];
	F64			 apex[3];
	F64			 tgt[3];
	F64			 dist;
	F64			 tol;
	F64			 check;
	F64			 hit;
	F64			 ground;
	F64			 total;
	F64			 sub;
	F64			 closed;
	I64			 local;
	I64			 route;
	I64			 guard;

	if (!e || !hl_map || !hl_ai_mon[s].have_goal)
		return HLAI_MOVE_BLOCKED;

	//m_Route: the triangulated apex, then the node route, then the goal.
	//FTriangulate's apex is inserted in front of the rest, monsters.cpp:
	//1901-1903, and an apex or node is left behind at MONSTER_CUT_CORNER_DIST
	//rather than at the task's own tolerance - which is 128 units for a
	//follow, wide enough to skip the whole detour. monsters.cpp:37 and
	//:1968-1977
	//
	//a route built for a goal that has since moved leads nowhere useful
	if (HLAIRouteStale(s))
		HLAIRouteClear(s);

	//AdvanceRoute, monsters.cpp:768: waypoints already behind the monster are
	//consumed before the step is taken, however many of them there are
	guard = 0;

	while (TRUE)
	{
		HLAIWayPoint(s, way, &tol);

		HLVecSub(way, e->origin, dir);
		dir[2] = 0.0;

		dist = HLVecNormalize(dir);

		if (dist > tol)
			goto qms_have_way;

		if (!HLAIAdvanceWay(s))
			return HLAI_MOVE_ARRIVED;

		guard++;

		if (guard > HLNODE_PATH_MAX + 2)
			return HLAI_MOVE_ARRIVED;
	}

qms_have_way:

	ground = HLAIGroundSpeed(s, speed);

	if (ground <= 0.0)
		return HLAI_MOVE_OK;

	//--- lookahead, monsters.cpp:1851-1874 ---
	//
	//throttled to CBaseMonster::MonsterThink's own 0.1s interval rather than run
	//per server tick: this walks up to 200 units in 16-unit hops and every hop
	//costs two hull sweeps
	if (hl_ent_time >= hl_ai_mon[s].next_move_check)
	{
		hl_ai_mon[s].next_move_check = hl_ent_time + HLAI_MOVE_CHECK;

		check = HLAI_DIST_CHECK;

		if (dist < check)
			check = dist;

		HLVecMA(e->origin, check, dir, to);

		hit   = 0.0;
		local = HLAICheckLocalMove(s, e->origin, to, &hit);

		if (local != HLAI_LM_VALID)
		{
			//BuildRoute's order, monsters.cpp:751-790: straight line, then
			//triangulate around the obstruction, then last ditch the nodes
			if (local == HLAI_LM_NOTRI)
				goto qms_try_nodes;

			if (!HLAITriangulate(s, e->origin, way, hit, apex))
				goto qms_try_nodes;

			hl_ai_mon[s].have_detour = TRUE;
			HLVecCopy(apex, hl_ai_mon[s].detour);

			HLVecSub(apex, e->origin, dir);
			dir[2] = 0.0;

			dist = HLVecNormalize(dir);

			if (dist <= 0.0)
				return HLAI_MOVE_BLOCKED;

			goto qms_routed;

qms_try_nodes:
			//already on a node route and the leg to the next node is blocked:
			//rebuilding is the only move left, and HLAINodeRoute's own
			//interval keeps that from running every think.
			//
			//HLAI_ROUTE_WAIT is that interval refusing the call, not a verdict
			//on the goal, so the tick walks the route it already has and the
			//rebuild is retried on the next lookahead. HLAI_NODE_REROUTE is
			//0.5s against HLAI_STUCK_TIME's 0.8s, so a block that outlives the
			//retry still ends the task through the progress test below.
			route = HLAINodeRoute(s, hl_ai_mon[s].goal);

			if (route == HLAI_ROUTE_NONE)
				return HLAI_MOVE_BLOCKED;

			if (route == HLAI_ROUTE_OK)
			{
				HLAIWayPoint(s, way, &tol);

				HLVecSub(way, e->origin, dir);
				dir[2] = 0.0;

				dist = HLVecNormalize(dir);

				if (dist <= 0.0)
					return HLAI_MOVE_BLOCKED;
			}

qms_routed:
		}
	}

	//the point being steered at, in the plane of the origin: the waypoint, or
	//the apex the lookahead just substituted for it. dir is flattened and dist
	//is the 2D distance, so this is exact. Held for the progress test below,
	//which must not be affected by the route advancing under it.
	HLVecMA(e->origin, dist, dir, tgt);

	//--- MoveExecute, monsters.cpp:1987-1995 ---
	//
	//"don't walk more than 16 units or stairs stop working": each hop lifts a
	//step height and drops again, and a longer hop steps over the tread
	total = ground * dt;

	if (total > dist)
		total = dist;

	HLVecCopy(e->origin, at);

	while (total > 0.001)
	{
		sub = HLAI_LOCAL_STEP;

		if (sub > total)
			sub = total;

		HLVecMA(at, sub, dir, to);

		if (!HLAIStepTo(s, at, to, at))
			goto qms_moved;

		total -= sub;
	}

qms_moved:
	//ground closed on the steering target, not ground covered. HLAIStepTo hops
	//in HLAI_LOCAL_STEP pieces and stops at the first blocked piece, so a
	//monster whose remaining pieces run along a wall still covers distance while
	//standing off the waypoint at the same range forever. Negative when the
	//partial move ended further out than it started.
	HLVecSub(tgt, at, to);
	to[2] = 0.0;
	closed = dist - HLVecLength(to);

	HLVecCopy(at, e->origin);
	HLEntSetAbsBox(e);

	//stuck detection. After HLAI_STUCK_TIME without closing on the waypoint the
	//path task fails and the state machine picks something else. The SDK has no
	//equivalent - CBaseMonster::Move leans on CheckLocalMove failing, and
	//UTIL_MoveToOrigin never slides, so an SDK monster stops dead instead of
	//grinding along the geometry.
	//
	//The target is whatever HLAIWayPoint returned, so a triangulated detour is
	//judged on reaching its apex and does not trip this while it rounds the
	//obstruction.
	if (closed < ground * dt * 0.2)
	{
		if (hl_ai_mon[s].stuck_since <= 0.0)
			hl_ai_mon[s].stuck_since = hl_ent_time;
		else if (hl_ent_time - hl_ai_mon[s].stuck_since >= HLAI_STUCK_TIME)
			return HLAI_MOVE_BLOCKED;
	}
	else
		hl_ai_mon[s].stuck_since = 0.0;

	return HLAI_MOVE_OK;
}

//--- cover ------------------------------------------------------------------
//
// CBaseMonster::FindLateralCover and FindCover, monsters.cpp. The SDK tries
// lateral cover first - step sideways along the plane through the monster,
// testing whether the threat can still see the spot - and only falls back to
// CGraph's node cover when that fails. Lateral first; then hint-typed nodes.

#define HLAI_COVER_STEPS	8		//directions sampled around the monster
#define HLAI_COVER_RANGE	3		//how many distances out each direction
#define HLAI_COVER_STEP		96.0	//COVER_DELTA, the SDK's lateral step

Bool HLAICoverSpotOk(I64 s, F64 *spot, F64 *threat, Bool need_hidden)
{//one candidate: standable, out of sight of the threat, clear of squadmates
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 floor[3];
	F64			 eye[3];
	F64			 zero[3];

	if (!e || !hl_map)
		return FALSE;

	//nothing integrates gravity for a STEP entity, so a spot with no floor
	//under it is not a spot
	if (!HLAIDropToFloor(e, spot, floor))
		return FALSE;

	//the monster has to be able to get there. One straight sweep, which is
	//all the movement code can do anyway
	HLTraceEntity(hl_map, e->origin, floor, e->mins, e->maxs, 0, TRUE, &tr);

	if (tr.fraction < 1.0)
		return FALSE;

	if (need_hidden)
	{
		//FVisible from the threat to where the monster's eyes would be
		HLVecCopy(floor, eye);
		eye[2] += hl_ai_mon_info[hl_ai_mon[s].kind].view_ofs;

		HLVecSet(zero, 0.0, 0.0, 0.0);

		HLTraceEntity(hl_map, threat, eye, zero, zero, 0, TRUE, &tr);

		//still in the open
		if (tr.fraction >= 1.0)
			return FALSE;
	}

	if (!HLAIValidateCover(s, floor))
		return FALSE;

	HLVecCopy(floor, spot);

	return TRUE;
}

Bool HLAIFindNodeCover(I64 s, F64 *threat, Bool need_hidden, F64 *out)
{//FindCoverNode: nearest HINT_TACTICAL_COVER_* the threat cannot see
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 spot[3];
	F64			 d[3];
	F64			 dist;
	F64			 best_dist;
	I64			 best = -1;
	I64			 hint;
	I64			 i;

	if (!e || hl_ai_node_count <= 0)
		return FALSE;

	best_dist = 8192.0;

	for (i = 0; i < hl_ai_node_count; i++)
	{
		hint = hl_ai_node_hint[i];

		if (hint != HLHINT_COVER_MED && hint != HLHINT_COVER_LOW)
			goto qfnc_next;

		spot[0] = hl_ai_node_org[i * 3];
		spot[1] = hl_ai_node_org[i * 3 + 1];
		spot[2] = hl_ai_node_org[i * 3 + 2];
		HLVecSub(spot, e->origin, d);
		dist = HLVecLength(d);

		if (dist >= best_dist)
			goto qfnc_next;

		if (!HLAICoverSpotOk(s, spot, threat, need_hidden))
			goto qfnc_next;

		best      = i;
		best_dist = dist;

qfnc_next:
	}

	if (best < 0)
		return FALSE;

	out[0] = hl_ai_node_org[best * 3];
	out[1] = hl_ai_node_org[best * 3 + 1];
	out[2] = hl_ai_node_org[best * 3 + 2];
	return TRUE;
}

Bool HLAIFindCover(I64 s, F64 *threat, Bool need_hidden, F64 *out)
{//FindLateralCover then FindCoverNode
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 away[3];
	F64			 dir[3];
	F64			 spot[3];
	F64			 base;
	F64			 ang;
	I64			 step;
	I64			 ring;
	I64			 turn;

	if (!e)
		return FALSE;

	//directly away from the threat is the first thing tried, so a monster
	//breaking contact does not sidestep into it
	HLVecSub(e->origin, threat, away);
	away[2] = 0.0;

	if (HLVecNormalize(away) <= 0.0)
		HLVecSet(away, 1.0, 0.0, 0.0);

	base = Arg(away[0], away[1]) / HLDEG2RAD;

	for (ring = 1; ring <= HLAI_COVER_RANGE; ring++)
	{
		for (step = 0; step < HLAI_COVER_STEPS; step++)
		{
			//alternate either side of "away" rather than sweeping one way
			//round: the SDK tries left then right at each distance
			//arithmetic is F64 here, so the halving is truncated explicitly
			//rather than relying on the assignment to do it
			turn = ToI64(ToF64(step + 1) / 2.0);

			if (step & 1)
				ang = base + ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));
			else
				ang = base - ToF64(turn) * (360.0 / ToF64(HLAI_COVER_STEPS));

			HLVecSet(dir, Cos(ang * HLDEG2RAD), Sin(ang * HLDEG2RAD), 0.0);
			HLVecMA(e->origin, ToF64(ring) * HLAI_COVER_STEP, dir, spot);

			if (HLAICoverSpotOk(s, spot, threat, need_hidden))
			{
				HLVecCopy(spot, out);
				return TRUE;
			}
		}
	}

	return HLAIFindNodeCover(s, threat, need_hidden, out);
}

//--- attacks ----------------------------------------------------------------

U0 HLAIMonSound(I64 s, U8 *path)
{//at the monster's own position on CHAN_VOICE, so a new line cuts that
 //monster's previous one and nothing else.
 //
 //entnum is the entity index plus one: replacement is keyed on
 //(entnum, entchannel), so passing 0 puts every monster in the map on the
 //world's key and one monster's line cuts another's
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !path || !path[0])
		return;

	HLSndPlayAt(path, e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_VOICE);
}

U0 HLDmgHurt(I64 target, I64 attacker, F64 damage, I64 bits)
{//HLEntTakeDamageType with the hit recorded for the monster death path.
 //
 //this sits in HLAI rather than beside HLDmgNote because HLPart compiles at 79
 //and HLEntTakeDamageType does not exist until HLEntity at 93. HLAI is 95 and
 //HLWeapon is 97, so this is the first file that can wrap it for both
	CHLEntity	*e = HLEntGet(target);
	F64			 left;

	if (damage <= 0.0)
		return;

	left = 0.0;

	if (e)
		left = e->health - damage;

	HLDmgNote(target, bits, left);
	HLEntTakeDamageType(target, attacker, damage, bits);
}

U0 HLAIHurt(I64 target, I64 attacker, F64 damage, I64 bits = HLDMG_GENERIC)
{//one damage call for either kind of target. The player's health lives in
 //HLEntity.ZC's native player state, a monster's in its entity slot
 //
 //bits is bitsDamageType. The player path drops it: hl_ent_player_health has no
 //gib rule and no time-based accumulator behind it
	CHLEntity *a;

	if (damage <= 0.0)
		return;

	if (HLAITargetIsPlayer(target))
	{
		//damageOrigin for the compass is the inflictor's centre,
		//player.cpp:4195-4201. An attacker with no entity slot passes NULL:
		//HLHudDamageSource ignores that, where a zero vector would latch and
		//point the wedges at the world origin
		a = HLEntGet(attacker);

		if (a)
			HLEntHurtPlayer(damage, HLDMG_GENERIC, a->origin);
		else
			HLEntHurtPlayer(damage);

		return;
	}

	HLDmgHurt(target, attacker, damage, bits);
}

U0 HLAIBlastDamage(I64 s, F64 radius, F64 damage)
{//RadiusDamage without falloff or a line-of-sight test. The only user is the
 //houndeye's sonic blast, which in the SDK is UTIL_MonstersInSphere plus a flat
 //gSkillData figure and passes through cover by design.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 mine;
	I64			 target;
	I64			 i;
	I64			 pack;

	if (!e)
		return;

	//houndeye.cpp:628-631: a pack multiplies the blast, HOUNDEYE_SQUAD_BONUS
	//1.1 per member past the first
	pack = HLAISquadCount(s);

	if (pack > 1)
		damage = damage + damage * 1.1 * ToF64(pack - 1);

	mine   = hl_ai_mon_info[hl_ai_mon[s].kind].classify;
	target = -1;
	i      = -1;

	while (i < hl_num_entities)
	{
		target = i;

		if (i >= 0)
		{
			if (hl_ai_mon_of[i] < 0 || i == hl_ai_mon[s].ent)
				goto qabd_next;
		}

		//a blast respects the relationship table: houndeyes do not hurt
		//each other
		if (HLAIRelationship(mine, HLAITargetClass(target)) <= HLREL_NONE)
			goto qabd_next;

		if (!HLAITargetPos(target, feet, eye))
			goto qabd_next;

		HLVecSub(feet, e->origin, d);

		if (HLVecLength(d) > radius)
			goto qabd_next;

		//DMG_SONIC|DMG_ALWAYSGIB, dlls/houndeye.cpp:663 - the blast takes a
		//victim apart whatever the overkill
		HLAIHurt(target, hl_ai_mon[s].ent, damage,
			HLDMG_SONIC | HLDMG_ALWAYSGIB);

qabd_next:
		i++;
	}
}

U0 HLAIAttackNoise(I64 s)
{//CSoundEnt::InsertSound(bits_SOUND_COMBAT, ...) from an attack event
 //
 //hgrunt.cpp's HGRUNT_AE_BURST1 inserts one at 384 units for 0.3 seconds; the
 //other armed monsters make the same call at their own radius. This is what
 //draws a second squad to a firefight.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->attack_noise <= 0.0)
		return;

	HLAIInsertSound(HLSOUND_COMBAT, e->origin, mi->attack_noise, 0.3);
}

Bool HLAIHullAttack(I64 s, F64 reach, F64 damage, I64 bits = HLDMG_SLASH)
{//CheckTraceHullAttack, dlls/combat.cpp:1133: sweep a hull forward from the eye
 //and damage whatever it meets
 //
 //the SDK traces a hull and hits whatever edict it finds. There are no edicts
 //here, so the sweep is replaced by the same range and cone test the SDK's
 //hull would have produced against the one target that matters. TRUE when it
 //connected, which is what decides the hit or miss foley.
 //
 //iDmgType is DMG_SLASH at seven of the eleven SDK call sites, so it is the
 //default; the punches and the whip name their own
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	I64			 blood;
	I64			 vs;

	if (!e || !hl_ai_mon[s].have_enemy)
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (dist > reach)
		return FALSE;

	//the hull sweeps forward, so something behind the monster is not hit
	if (!HLAIInViewCone(s, feet))
		return FALSE;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, damage, bits);

	//CBaseMonster::TraceAttack ends in SpawnBlood(vecSpot, BloodColor(),
	//flDamage), which is UTIL_BloodDrips along the reverse of the attack
	//direction, in the victim's own m_bloodColor
	blood = HLBLOOD_RED;

	if (!HLAITargetIsPlayer(hl_ai_mon[s].enemy))
	{
		vs = hl_ai_mon_of[hl_ai_mon[s].enemy];

		if (vs >= 0 && hl_ai_mon[vs].kind >= 0)
			blood = hl_ai_mon_info[hl_ai_mon[vs].kind].blood;
	}

	HLVecNormalize(d);
	d[2] = 0.0;

	//tS, not hl_ent_time: HLPartUpdate and HLPartDraw run on the render
	//clock, so an effect stamped with the server clock expires on the wrong
	//one.
	HLFxBloodDrips(eye, d, blood, ToI64(damage), tS);

	return TRUE;
}

Bool HLAIMuzzlePos(I64 s, F64 *out)
{//GetAttachment(0, ...) - attachment 0 is the gun on every armed monster in the
 //SDK: hgrunt.cpp:284 drops the weapon from it, agrunt.cpp:941 launches hornets
 //from it, and the engine hangs EF_MUZZLEFLASH off the same point.
 //
 //FALSE when the model carries no attachment, in which case the caller keeps
 //GetGunPosition's eye. The pose is the one HL1.ZC draws this entity in -
 //e->controllers, blend 0 - so the muzzle sits where the barrel is drawn
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e || !e->studio)
		return FALSE;

	if (HLStudioAttachCount(e->studio) < 1)
		return FALSE;

	return HLStudioAttachment(e->studio, e->origin, e->angles, e->seq,
		HLAIEntityCycle(e), 0.0, 0, out, e->controllers, 0.0);
}

U0 HLAIGunPos(I64 s, F64 *out)
{//where a monster's round leaves it. Studio attachment 0 when the model has
 //one, CBaseMonster::GetGunPosition's origin + view_ofs otherwise
	if (HLAIMuzzlePos(s, out))
		return;

	HLAIMonEye(s, out);
}

U0 HLAIMuzzleFlash(I64 s)
{//pev->effects |= EF_MUZZLEFLASH - hgrunt.cpp:803, barney.cpp:353,
 //agrunt.cpp:445, hassassin.cpp:229, turret.cpp:623
 //
 //R_MuzzleFlash type 1 carries no scale byte, so the sprite is drawn at the
 //0.5 default
	F64 muzzle[3];

	if (!HLAIMuzzlePos(s, muzzle))
		return;

	HLFxMuzzleFlash(muzzle, 0.5, tS);
}

Bool HLAITracerDue()
{//combat.cpp:1405. iTracerFreq is 4 for a monster (cbase.h:255) and hgrunt,
 //barney and the hassassin all take that default; only the shotgun grunt passes
 //0. The counter steps once per round fired, world wide
	Bool due;

	due = ToBool((hl_ai_tracer_count % 4) == 0);
	hl_ai_tracer_count++;

	return due;
}

U0 HLAIFireAttack(I64 s, Bool melee)
{//land the hit for a monster whose model carries no event for it
 //
 //the SDK fires on an animation event inside the sequence (mstudioevent_t,
 //HandleAnimEvent), which HLAIMonEvents below now reproduces. This remains the
 //path for a sequence with no event in it and for the blast attacks, which the
 //SDK also applies from a single event.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	F64			 dmg;
	F64			 src[3];
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (melee)
	{
		//25% slop over the reach used to choose the attack, so an enemy backing
		//away at walking pace does not dodge every swing by an inch
		HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		return;
	}

	HLAIAttackNoise(s);

	if (mi->blast_radius > 0.0)
	{
		HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
		return;
	}

	//hitscan. FireBullets with no cone: the SDK's per-weapon spread values are
	//small enough that at these ranges they decide misses, not damage, and there
	//is no hit-group table to spread damage across.
	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (dist > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	//the burst is applied as one call here, so it draws the one tracer the
	//counter is due rather than one per round
	if (tracer)
		HLFxTracer(src, eye, tS);

	dmg = mi->range_dmg * ToF64(mi->range_bullets);

	//DMG_BULLET | (iDamage > 16 ? DMG_ALWAYSGIB : DMG_NEVERGIB),
	//dlls/combat.cpp:1445. iDamage is the round, not the burst, so the test is
	//on range_dmg and not on the product
	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, dmg, bits);
}

//--- animation events -------------------------------------------------------
//
// HandleAnimEvent. Every attack in HL lands on an mstudioevent_t embedded in
// the attack sequence at the frame the claw or the muzzle actually reaches the
// target, not at the end of the take: a zombie's swing connects on frame 10 of
// 36 and the remaining 26 frames are the follow-through, which the enemy can
// walk out of.
//
// Codes below 1000 are client-side effects. 1000..1999 are the shared script
// events CBaseMonster::HandleAnimEvent interprets. 2000..2999 are shared
// monster events - body drops and weapon swishes. Everything below 100 is
// per-monster and means nothing without knowing which monster is playing it,
// which is why the dispatch is on (kind, code).
//
// Placed here rather than beside HLAIEntityEvents at the top of the file
// because it reaches the monster table, the damage path and the sound list,
// none of which exist that early: ZealC is single-pass.

//scriptevent.h. HLStudio.ZC names 1004/1005/1008/1009, the same values.
#define HLAI_EV_DEAD			1000
#define HLAI_EV_NOINTERRUPT		1001
#define HLAI_EV_CANINTERRUPT	1002
#define HLAI_EV_FIREEVENT		1003
#define HLAI_EV_SOUND			1004
#define HLAI_EV_SENTENCE		1005
#define HLAI_EV_INAIR			1006
#define HLAI_EV_ENDANIMATION	1007
#define HLAI_EV_SOUND_VOICE		1008
#define HLAI_EV_SENTENCE_RND1	1009
#define HLAI_EV_NOT_DEAD		1010

//monsterevent.h
#define HLAI_EV_BODYDROP_LIGHT	2001
#define HLAI_EV_BODYDROP_HEAVY	2002
#define HLAI_EV_SWISHSOUND		2010

//CheckTraceHullAttack's reach for every humanoid claw in the SDK
#define HLAI_HULL_REACH			70.0

//--- AI projectile requests -------------------------------------------------
//
// HLWeapon.ZC owns hl_proj[] and HLProjSpawn, but compiles after this file.
// Anim events queue a shot here; HLProjDrainAI in HLWeapon drains it into the
// real pool each projectile step.
//
// Semantic kinds (not HLPRJ_*): HLWeapon maps them.
#define HLAIPRJ_NONE			0
#define HLAIPRJ_SPIT			1
#define HLAIPRJ_HORNET			2
#define HLAIPRJ_GRENADE			3
#define HLAIPRJ_CTRLBALL		4
#define HLAIPRJ_FLAME			5		//CGargantua FlameUpdate volume
#define HLAIPRJ_ROCKET			6		//CApache FireRocket / CRpgRocket

#define HLAI_PROJ_Q				16

class CHLAIProjReq
{
	I64	 kind;			//HLAIPRJ_*
	F64	 org[3];
	F64	 vel[3];
	F64	 damage;
	F64	 life;
	F64	 gravity;
	F64	 friction;
	Bool bounce;
	I64	 owner;			//entity index
};

CHLAIProjReq	hl_ai_proj_q[HLAI_PROJ_Q];
I64				hl_ai_proj_q_n = 0;
I64				hl_ai_proj_dropped = 0;

Bool HLAIProjRequest(I64 kind, F64 *org, F64 *vel, F64 damage, F64 life,
	F64 gravity, F64 friction, Bool bounce, I64 owner)
{//push one shot. FALSE when the queue is full
	CHLAIProjReq *r;

	if (kind <= HLAIPRJ_NONE || hl_ai_proj_q_n >= HLAI_PROJ_Q)
	{
		hl_ai_proj_dropped++;
		return FALSE;
	}

	r = &hl_ai_proj_q[hl_ai_proj_q_n++];
	r->kind     = kind;
	r->damage   = damage;
	r->life     = life;
	r->gravity  = gravity;
	r->friction = friction;
	r->bounce   = bounce;
	r->owner    = owner;
	HLVecCopy(org, r->org);
	HLVecCopy(vel, r->vel);
	return TRUE;
}

U0 HLAIProjAtEnemy(I64 s, I64 kind, F64 speed, F64 damage, F64 life,
	F64 gravity = 0.0, F64 friction = 0.0, Bool bounce = FALSE)
{//aim from gun/mouth at the enemy eye and queue. No-op without a live enemy
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];
	F64			 src[3];
	F64			 dir[3];
	F64			 vel[3];

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	HLAIGunPos(s, src);
	HLVecSub(eye, src, dir);

	if (HLVecLength(dir) < 1.0)
		return;

	HLVecNormalize(dir);
	HLVecScale(dir, speed, vel);
	HLAIProjRequest(kind, src, vel, damage, life, gravity, friction, bounce,
		hl_ai_mon[s].ent);
}

U0 HLAIShootOnce(I64 s, F64 dmg_abs = 0.0)
{//one round of a burst. CBaseMonster::FireBullets for a single bullet
 //
 //the SDK traces a bullet with a per-weapon cone and applies the damage where
 //it lands. There is no hit-group table here, so a bullet that has line of
 //sight to the enemy hits it for the row's per-bullet figure.
 //
 //dmg_abs overrides range_dmg for this round; 0 takes the row's figure. It
 //folds a multi-pellet round into one hit - CHGrunt::Shotgun fires
 //gSkillData.hgruntShotgunPellets buckshot in a 15 degree cone from one event,
 //hgrunt.cpp:891 - and carries the second ranged attack's figure, which lives
 //in range2_dmg rather than range_dmg.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 dmg;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 src[3];
	F64			 aim_dir[3];
	F64			 aim_ang[3];
	F64			 aim_set;
	Bool		 tracer;
	I64			 bits;

	if (!e || !hl_ai_mon[s].have_enemy || hl_ai_mon[s].kind < 0)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	dmg = mi->range_dmg;

	if (dmg_abs > 0.0)
		dmg = dmg_abs;

	//m_cAmmoLoaded, spent whether or not the round connects
	if (mi->clip_size > 0 && hl_ai_mon[s].ammo > 0)
		hl_ai_mon[s].ammo--;

	//Shoot() flashes and steps the tracer counter before the trace, so a round
	//into a wall still shows both
	HLAIGunPos(s, src);
	HLAIMuzzleFlash(s);

	tracer = HLAITracerDue();

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return;

	//"SetBlending( 0, angDir.x )", the last line of both Shoot and Shotgun,
	//hgrunt.cpp:875 and :898. HLVecToAngles is VectorAngles: pitch positive up,
	//folded to [0,360). HLStudioBlendSetting folds it back into the sequence's
	//own range, so a value above 180 is not a problem here
	HLVecSub(eye, src, aim_dir);
	HLVecToAngles(aim_dir, aim_ang);
	hl_ai_mon[s].aim_pitch = aim_ang[0];

	//SetBlending reads pev->sequence, so the setting belongs to the take that
	//is playing. -1 is a sequence with no such axis, and leaves the last
	//value alone the way pev->blending keeps it
	//0..255 out of SetBlending, 0..1 into the renderer's slerp
	aim_set = HLStudioBlendSetting(e->studio, e->seq, 0, aim_ang[0]);

	if (aim_set >= 0.0)
		e->blending[0] = aim_set / 255.0;

	HLVecSub(feet, e->origin, d);

	//the farther of the two bands: one call serves both ranged attacks
	if (mi->range2_max > mi->range_max)
	{
		if (HLVecLength(d) > mi->range2_max)
			return;
	}
	else if (HLVecLength(d) > mi->range_max)
		return;

	if (!HLAIVisible(s, eye))
		return;

	//TE_TRACER, combat.cpp:1427. The SDK draws it to tr.vecEndPos whether or not
	//the round reached anything; there is no bullet trace on this path, so it is
	//drawn only for a round with a clear sight line and never crosses a wall
	if (tracer)
		HLFxTracer(src, eye, tS);

	//DMG_BULLET | (iDamage > 16 ? DMG_ALWAYSGIB : DMG_NEVERGIB),
	//combat.cpp:1445. iDamage is the single round, so the test is on range_dmg
	//and not on dmg, which may carry a folded pellet spread.
	bits = HLDMG_BULLET | HLDMG_NEVERGIB;

	if (mi->range_dmg > 16.0)
		bits = HLDMG_BULLET | HLDMG_ALWAYSGIB;

	HLAIHurt(hl_ai_mon[s].enemy, hl_ai_mon[s].ent, dmg, bits);
}

U0 HLAIClawFoley(I64 s, Bool hit)
{//the hit and miss sounds every claw event plays. zombie.cpp's
 //pAttackHitSounds / pAttackMissSounds, which islave.cpp reuses verbatim
	if (hit)
		HLAIMonSound(s, "zombie/claw_strike1.wav");
	else
		HLAIMonSound(s, "zombie/claw_miss1.wav");
}

U0 HLAIBodyDrop(I64 s, Bool heavy)
{//MONSTER_EVENT_BODYDROP_LIGHT / _HEAVY. Both pick between the same two
 //samples; the heavy form drops the pitch to 90, which this mixer path cannot
 //express, so the two differ only in the volume
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 vol = 1.0;

	if (!e)
		return;

	if (heavy)
		vol = 1.0;
	else
		vol = 0.8;

	if (HLPartRandI(2))
		HLSndPlayAt("common/bodydrop3.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);
	else
		HLSndPlayAt("common/bodydrop4.wav", e->origin, vol, HLENT_SND_ATTEN,
			0, HLENT_CHAN_BODY);

	//a body hitting the floor is a world sound. CSoundEnt has no such call in
	//the SDK, but bits_SOUND_CARCASS is what a bullsquid comes to eat
	HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);
}

Bool HLAISharedEvent(I64 s, CHLEntity *e, I64 self, I64 code, U8 *options)
{//CBaseMonster::HandleAnimEvent, the base every monster falls through to.
 //TRUE when the code was consumed.
	if (code == HLAI_EV_DEAD)
	{
		//a scripted death take. The script's own actor dies at the frame the
		//animator marked, not at the end of the sequence
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = 0.0;

		return TRUE;
	}

	if (code == HLAI_EV_NOT_DEAD)
	{
		//the other half of a life/death take: the actor gets up again
		if (hl_ai_mon[s].state == HLMSTATE_SCRIPT)
			e->health = e->max_health;

		return TRUE;
	}

	//the payload-carrying codes only. An empty options field would play the
	//missing-sound sample or fire an unnamed target
	if (code == HLAI_EV_FIREEVENT || code == HLAI_EV_SOUND ||
		code == HLAI_EV_SOUND_VOICE || code == HLAI_EV_SENTENCE ||
		code == HLAI_EV_SENTENCE_RND1)
	{
		if (!options || !options[0])
			return TRUE;
	}

	if (code == HLAI_EV_FIREEVENT)
	{
		HLEntFireTargetsNamed(options, self, hl_ent_player, HLUSE_TOGGLE, 0.0);
		return TRUE;
	}

	//ATTN_IDLE on all four, monsters.cpp:2659, :2663 and :2671. Not
	//HLENT_SND_ATTEN: that is ATTN_NORM, and dist_mult is attenuation / 1000,
	//so ATTN_NORM carries these to 1250 units where ATTN_IDLE stops at 500.
	//Every monster footstep in the game is one of these events -
	//common/npc_step*.wav, frames 0 and 8 of walk and run.
	if (code == HLAI_EV_SOUND)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLENT_CHAN_BODY);
		return TRUE;
	}

	if (code == HLAI_EV_SOUND_VOICE)
	{
		HLSndPlayAt(options, e->origin, 1.0, HLATTN_IDLE, self + 1,
			HLCHAN_VOICE);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE)
	{
		HLAISentencePlay(options, self, e->origin, 1.0, HLATTN_IDLE);
		return TRUE;
	}

	if (code == HLAI_EV_SENTENCE_RND1)
	{
		//SCRIPT_EVENT_SENTENCE_RND1 plays two times in three
		if (HLPartRandI(3))
			HLAISentencePlay(options, self, e->origin, 1.0, HLATTN_IDLE);

		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_LIGHT)
	{
		HLAIBodyDrop(s, FALSE);
		return TRUE;
	}

	if (code == HLAI_EV_BODYDROP_HEAVY)
	{
		HLAIBodyDrop(s, TRUE);
		return TRUE;
	}

	if (code == HLAI_EV_SWISHSOUND)
	{
		//the note in monsters.cpp is that no monster may use this event unless
		//its own precache carries the sample
		HLAIMonSound(s, "zombie/claw_miss2.wav");
		return TRUE;
	}

	//SCRIPT_EVENT_NOINTERRUPT / CANINTERRUPT, monsters.cpp:2679-2685
	if (code == HLAI_EV_NOINTERRUPT)
	{
		if (hl_ai_cine[self].owner >= 0)
			hl_ai_cine[hl_ai_cine[self].owner].interrupt = FALSE;
		return TRUE;
	}

	if (code == HLAI_EV_CANINTERRUPT)
	{
		if (hl_ai_cine[self].owner >= 0)
		{
			if (!(hl_entities[hl_ai_cine[self].owner].spawnflags &
				HLAI_SF_NOINTERRUPT))
				hl_ai_cine[hl_ai_cine[self].owner].interrupt = TRUE;
		}
		return TRUE;
	}

	//INAIR / ENDANIMATION: exit pose bookkeeping not ported; consume quietly
	if (code == HLAI_EV_INAIR || code == HLAI_EV_ENDANIMATION)
		return TRUE;

	return FALSE;
}

//--- the scientist's syringe ------------------------------------------------
//
//gSkillData.scientistHeal, sk_scientist_heal, valve/skill.cfg:348-350, 25 on
//all three tiers. dlls/game.cpp defaults every sk_ cvar to 0, so the shipped
//file is the source
#define HLSCI_HEAL				25.0

//"Don't heal again for 1 minute", scientist.cpp:1099
#define HLSCI_HEAL_WAIT			60.0

//CanHeal's half-health gate, scientist.cpp:1082, against a client's
//pev->max_health of 100. There is no per-client record here
#define HLSCI_HEAL_MAX_HP		100.0

//Heal's own range check, scientist.cpp:1094, and TargetDistance in RunTask,
//scientist.cpp:585
#define HLSCI_HEAL_RANGE		100.0
#define HLSCI_HEAL_BREAK		90.0

//NUM_SCIENTIST_HEADS, scientist.cpp:31. pev->body is head + 4 * needle, so the
//needle bodygroup is a multiple of the head count rather than a bodypart
#define HLSCI_HEADS				4

Bool HLAICanHeal(I64 s)
{//CScientist::CanHeal, scientist.cpp:1080
 //
 //m_hTargetEnt is the player and nothing else: only the player is ever
 //followed here, so the target-is-a-monster case the SDK allows cannot arise
	I64	ent = hl_ai_mon[s].ent;

	if (hl_ai_mon[s].kind != HLMON_SCIENTIST)
		return FALSE;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	if (hl_ai_talk[ent].follow != HLTLK_PLAYER)
		return FALSE;

	if (hl_ent_player < 0 || hl_ent_player_dead)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].heal_time)
		return FALSE;

	if (hl_ent_player_health > HLSCI_HEAL_MAX_HP * 0.5)
		return FALSE;

	return TRUE;
}

U0 HLAIHeal(I64 s)
{//CScientist::Heal, scientist.cpp:1088. The give_shot event, not the task
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 pl[3];
	F64			 d[3];

	if (!e || !HLAICanHeal(s))
		return;

	HLAIPlayerOrigin(pl);
	HLVecSub(pl, e->origin, d);

	if (HLVecLength(d) > HLSCI_HEAL_RANGE)
		return;

	//TakeHealth clamps at pev->max_health
	hl_ent_player_health += HLSCI_HEAL;

	if (hl_ent_player_health > HLSCI_HEAL_MAX_HP)
		hl_ent_player_health = HLSCI_HEAL_MAX_HP;

	hl_ai_mon[s].heal_time = hl_ent_time + HLSCI_HEAL_WAIT;
}

U0 HLAIMonAnimEvent(I64 s, I64 self, I64 code, U8 *options)
{//the per-monster HandleAnimEvent, dispatched on (class, code)
 //
 //a comparison chain on the kind rather than a switch: the bodies share almost
 //everything and a switch on the outer key would repeat the melee call ten
 //times over
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 gib_dir[3];
	F64			 leap_feet[3];
	F64			 leap_eye[3];
	F64			 leap_dir[3];
	I64			 kind;

	if (!e || hl_ai_mon[s].kind < 0)
		return;

	kind = hl_ai_mon[s].kind;
	mi   = &hl_ai_mon_info[kind];

	//the shared codes first, as every HandleAnimEvent's default branch does -
	//except that the base runs last there and first here, which only matters
	//for a monster that reuses a shared number, and none do
	if (code >= 1000)
	{
		HLAISharedEvent(s, e, self, code, options);
		return;
	}

	//--- CZombie. attack1 carries ATTACK_RIGHT at frame 10 and ATTACK_LEFT at
	//19, so one take lands two blows; attack2 carries ATTACK_BOTH
	if (kind == HLMON_ZOMBIE)
	{
		if (code == 1 || code == 2)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		if (code == 3)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee2_dmg));

			if (HLPartRandI(2))
				HLAIMonSound(s, mi->snd_attack);

			return;
		}

		return;
	}

	//--- CBarnacle. BARNACLE_AE_PUKEGIB, barnacle.cpp:29, on four frames of
	//the death take: the last meal comes back up as it dies
	if (kind == HLMON_BARNACLE)
	{
		if (code == 2)
		{
			HLVecSet(gib_dir, 0.0, 0.0, -1.0);
			HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir,
				HLGIB_HEALTH_VALUE, 1, TRUE, mi->blood, hl_ent_time);
		}

		return;
	}

	//--- CHeadCrab. HC_AE_JUMPATTACK: launch toward the enemy (CHeadCrab leap)
	if (kind == HLMON_HEADCRAB)
	{
		if (code == 2)
		{
			HLAIMonSound(s, mi->snd_attack);

			if (hl_ai_mon[s].have_enemy &&
				HLAITargetPos(hl_ai_mon[s].enemy, leap_feet, leap_eye))
			{
				HLVecSub(leap_eye, e->origin, leap_dir);
				leap_dir[2] += 0.2 * HLVecLength(leap_dir);
				HLVecNormalize(leap_dir);
				HLVecScale(leap_dir, 350.0, hl_ai_mon[s].leap_vel);
				hl_ai_mon[s].leaping = TRUE;
				hl_ai_mon[s].leap_die = hl_ent_time + 1.0;
			}
			else
				HLAIHullAttack(s, mi->melee_range * 1.25, mi->melee_dmg);
		}

		return;
	}

	//--- CBullsquid
	if (kind == HLMON_BULLSQUID)
	{
		//BSQUID_AE_SPIT. CSquidSpit via the AI proj queue → HLPRJ_SPIT
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_SPIT, 900.0, mi->range_dmg, 3.0);
			return;
		}

		if (code == 2)
		{
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg);
			return;
		}

		if (code == 4)
		{
			//BSQUID_AE_WHIP is DMG_CLUB|DMG_ALWAYSGIB, dlls/bullsquid.cpp:588
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee2_dmg,
				HLDMG_CLUB | HLDMG_ALWAYSGIB);
			return;
		}

		//3 blink and 5 hop are a skin change and a velocity shove
		return;
	}

	//--- CHoundeye
	if (kind == HLMON_HOUNDEYE)
	{
		//HOUND_AE_WARN and _STARTATTACK, the two beats before the blast
		if (code == 1)
		{
			HLAIMonSound(s, mi->snd_alert);
			return;
		}

		if (code == 2)
		{
			HLAIMonSound(s, "houndeye/he_attack1.wav");
			return;
		}

		//HOUND_AE_THUMP: SonicAttack. The blast is radius damage with no
		//falloff and no line of sight test, as UTIL_MonstersInSphere is
		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			HLAIMonSound(s, "houndeye/he_pain3.wav");
			return;
		}

		if (code == 5)
		{
			HLAIMonSound(s, "houndeye/he_pain1.wav");
			return;
		}

		//6 hop back and 7 close eye are velocity and skin
		return;
	}

	//--- CHGrunt. The three-round burst is three events in one take, which is
	//why a grunt's fire is a burst and not one shot per schedule
	if (kind == HLMON_HGRUNT)
	{
		if (code == 2)
		{
			HLAIMonSound(s, "hgrunt/gr_reload1.wav");
			hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
			return;
		}

		if (code == 3)
		{
			//HGRUNT_AE_KICK. CHGrunt::Kick is a TakeDamage of DMG_CLUB,
			//dlls/hgrunt.cpp:955
			HLAIHullAttack(s, HLAI_HULL_REACH, mi->melee_dmg, HLDMG_CLUB);
			return;
		}

		if (code == 4)
		{
			//HGRUNT_AE_BURST1, hgrunt.cpp:913-937. The first round of the
			//burst is the one that makes the noise and puts a sound in the
			//world list.
			//
			//Measured from hgrunt.mdl: standing_mp5 carries events 4, 5 and 6,
			//standing_shotgun carries 4 alone, which is why the shotgun's one
			//pull is here and not on the later two
			if (HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP) ==
				HLGRUNT_GUN_SHOTGUN)
			{
				//pellets folded into one hit; the cone is not traced
				HLAIShootOnce(s, hl_ai_grunt_pellets * hl_ai_grunt_buckshot);
				HLAIMonSound(s, "weapons/sbarrel1.wav");
			}
			else
			{
				HLAIShootOnce(s);

				if (HLPartRandI(2))
					HLAIMonSound(s, "hgrunt/gr_mgun1.wav");
				else
					HLAIMonSound(s, "hgrunt/gr_mgun2.wav");
			}

			HLAIAttackNoise(s);
			return;
		}

		if (code == 5)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 6)
		{
			HLAIShootOnce(s);
			return;
		}

		if (code == 10)
		{
			//HGRUNT_AE_CAUGHT_ENEMY: the squad is told the player is back.
			//A group name, so a member is drawn from HG_ALERT0..n rather than
			//the same line every time.
			//
			//CHGrunt::FOkToSpeak and JustSpoke share CTalkMonster::
			//g_talkWaitTime with the talkers, hgrunt.cpp:334 and :357: a grunt
			//neither shouts over a scientist nor over another grunt, and holds
			//the floor 1.5 to 2 seconds after it speaks
			if (hl_ent_time > hl_ai_talk_wait)
			{
				HLAISentencePlay("HG_ALERT", self, e->origin, 1.0,
					HLENT_SND_ATTEN);

				hl_ai_talk_wait = hl_ent_time + 1.5 + HLPartRand(0.5);
			}

			return;
		}

		//7, 8 and 9 are the grenade events. CHGrunt::HandleAnimEvent tosses a
		//CGrenade::ShootTimed; queue a timed grenade toward the enemy
		if (code == 7 || code == 8 || code == 9)
		{
			HLAIProjAtEnemy(s, HLAIPRJ_GRENADE, 750.0, 100.0, 3.5, 0.5, 0.8,
				TRUE);
			return;
		}

		//11 is HGRUNT_AE_DROP_GUN, which HLAIDropDeathItems does at the moment
		//of death instead of partway through the death take
		return;
	}

	//--- CISlave
	if (kind == HLMON_ISLAVE)
	{
		if (code == 1)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH,
				mi->melee_dmg));
			return;
		}

		if (code == 2)
		{
			//ISLAVE_AE_CLAWRAKE, sk_islave_dmg_clawrake1. No sequence in
			//islave.mdl carries it, so this is reachable only from a model
			//that does
			HLAIClawFoley(s, HLAIHullAttack(s, HLAI_HULL_REACH, 25.0));
			return;
		}

		if (code == 3)
		{
			//ISLAVE_AE_ZAP_POWERUP, once per beam. The charge sound only.
			//
			//CISlave::ArmBeam traces three random rays out to 512 units and
			//hangs a lgtning.spr beam off the nearest hit, up to
			//ISLAVE_MAX_BEAMS of them, held until ZAP_DONE clears them.
			//HLDrawBeam can draw them; what is absent is the per-slot array of
			//eight endpoints and their lifetime, which is the cost of this
			HLAIMonSound(s, "debris/zap4.wav");
			return;
		}

		if (code == 4)
		{
			//ISLAVE_AE_ZAP_SHOOT. The beam is a hitscan here
			HLAIMonSound(s, "hassault/hw_shoot1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		//5 clears the beams
		return;
	}

	//--- CBarney
	if (kind == HLMON_BARNEY)
	{
		if (code == 2)
		{
			//BARNEY_AE_DRAW: the pistol leaves the holster. The bodygroup
			//change is HLDraw.ZC's business, so only the flag is set
			hl_ai_mon[s].gun_drawn = TRUE;
			return;
		}

		if (code == 3)
		{
			//BarneyFirePistol
			HLAIMonSound(s, mi->snd_attack);
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 4)
		{
			hl_ai_mon[s].gun_drawn = FALSE;
			return;
		}

		return;
	}

	//--- CAGrunt. Five hornet events over one take; each is one CHornet
	if (kind == HLMON_AGRUNT)
	{
		if (code >= 1 && code <= 5)
		{
			HLAIMonSound(s, "agrunt/ag_fire1.wav");
			HLAIProjAtEnemy(s, HLAIPRJ_HORNET, 300.0, mi->range_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 6 || code == 7 || code == 12 || code == 13)
		{
			//PUNCH, BITE and the two handed punches all land the same figure,
			//and all are DMG_CLUB - dlls/agrunt.cpp:508 and :538
			HLAIClawFoley(s, HLAIHullAttack(s, mi->melee_range,
				mi->melee_dmg, HLDMG_CLUB));
			return;
		}

		if (code == 10 || code == 11)
		{
			//AGRUNT_AE_LEFT_FOOT / _RIGHT_FOOT. A footstep is a world sound,
			//which is how a bullsquid notices one walking past
			HLAIMonSound(s, "player/pl_ladder2.wav");
			HLAIInsertSound(HLSOUND_WORLD, e->origin, 128.0, 0.2);
			return;
		}

		return;
	}

	//--- CController. Head-ball and energy-ball spray as flying projectiles
	if (kind == HLMON_CONTROLLER)
	{
		//CONTROLLER_AE_BALL_SHOOT, controller.cpp:298: one
		//controller_head_ball at sk_controller_dmgzap1
		if (code == 2)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0, mi->range2_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		//CONTROLLER_AE_SMALL_SHOOT, controller.cpp:328: energy ball spray
		if (code == 3)
		{
			HLAIMonSound(s, mi->snd_attack);
			HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0, mi->range_dmg, 5.0);
			HLAIAttackNoise(s);
			return;
		}

		//1 opens the head, 4 and 5 are the charge-up glows
		return;
	}

	//--- CHAssassin. ASSASSIN_AE_SHOOT1 / TOSS1 / JUMP, hassassin.cpp:57-59
	if (kind == HLMON_ASSASSIN)
	{
		if (code == 1)
		{
			HLAIMonSound(s, "weapons/pl_gun1.wav");
			HLAIShootOnce(s);
			HLAIAttackNoise(s);
			return;
		}

		if (code == 2)
		{
			//ASSASSIN_AE_TOSS1: CGrenade::ShootTimed(..., 2.0), hassassin.cpp:254
			HLAIProjAtEnemy(s, HLAIPRJ_GRENADE, 750.0, 100.0, 2.0, 0.5, 0.8,
				TRUE);
			return;
		}

		//3 is ASSASSIN_AE_JUMP: velocity launch lives on the leap path
		return;
	}

	//--- CGargantua. GARG_AE_SLASH_LEFT / FOOT / STOMP / BREATHE.
	//Flame is not an anim event: shootflames2 has none. TASK_MELEE_ATTACK2
	//queues HLAIPRJ_FLAME (gargantua.cpp TASK_FLAME_SWEEP).
	if (kind == HLMON_GARGANTUA)
	{
		if (code == 1)
		{
			HLAIClawFoley(s, HLAIHullAttack(s, mi->melee_range,
				mi->melee_dmg, HLDMG_SLASH));
			return;
		}

		if (code == 3 || code == 4)
		{
			HLAIMonSound(s, "garg/gar_step1.wav");
			HLAIInsertSound(HLSOUND_WORLD, e->origin, 256.0, 0.3);
			return;
		}

		if (code == 5)
		{
			HLAIBlastDamage(s, mi->blast_radius, mi->range_dmg);
			HLAIMonSound(s, "garg/gar_stomp1.wav");
			HLAIAttackNoise(s);
			return;
		}

		if (code == 6)
		{
			HLAIMonSound(s, "garg/gar_idle1.wav");
			return;
		}

		return;
	}

	//--- CScientist, scientist.cpp:640-663
	if (kind == HLMON_SCIENTIST)
	{
		//SCIENTIST_AE_HEAL, on give_shot
		if (code == 1)
		{
			HLAIHeal(s);
			return;
		}

		//SCIENTIST_AE_NEEDLEON and _NEEDLEOFF, on pull_needle and
		//return_needle. pev->body carries the head in the low digit and the
		//needle above it, so the head survives the swap
		if (code == 2)
		{
			e->body = e->body % HLSCI_HEADS + HLSCI_HEADS;
			return;
		}

		if (code == 3)
		{
			e->body = e->body % HLSCI_HEADS;
			return;
		}

		return;
	}
}

U0 HLAIMonEvents(I64 s, I64 self, F64 cycle)
{//StudioFrameAdvance's event dispatch for a monster
 //
 //the same walk HLAIEntityEvents does, routed to HandleAnimEvent instead of
 //to the script-event subset. Duplicated rather than shared because the
 //shared one is defined at the top of the file, hundreds of lines before the
 //monster table exists, and this compiler has no forward declarations.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLStudio	*m;
	CHLStSeq	*sq;
	CHLStEvent	*ev;
	F64			 frame_f;
	I64			 frame;
	I64			 last;
	I64			 i;

	if (!e || !e->studio)
		return;

	m = e->studio;

	if (e->seq < 0 || e->seq >= m->num_seqs || !m->events)
		return;

	sq = &m->seqs[e->seq];

	if (sq->num_events < 1)
		return;

	frame_f = cycle * ToF64(sq->num_frames - 1);
	frame   = ToI64(frame_f);

	if (frame < 0)
		frame = 0;
	if (frame > sq->num_frames - 1)
		frame = sq->num_frames - 1;

	last = e->anim_event_frame;

	//a loop that wrapped, or a sequence just started, replays the list from
	//the beginning rather than skipping to the new position
	if (last < 0 || frame < last)
		last = -1;

	if (frame == last)
		return;

	for (i = 0; i < sq->num_events; i++)
	{
		ev = &m->events[sq->first_event + i];

		if (ev->frame > last && ev->frame <= frame)
			HLAIMonAnimEvent(s, self, ev->code, ev->options);
	}

	e->anim_event_frame = frame;
}

//--- tasks ------------------------------------------------------------------
//
// schedule.cpp's interpreter. TaskComplete and TaskFail only set a status;
// RunTask notices and moves on, so a task can finish inside its own Start
// without the dispatcher losing its place.

U0 HLAITaskComplete(I64 s)
{
	hl_ai_mon[s].task_status = HLTK_DONE;
}

U0 HLAITaskFail(I64 s)
{//a failed task abandons the schedule, not just itself. TaskFail is
 //SetConditions(bits_COND_TASK_FAILED), basemonster.h:214, and slChaseEnemy is
 //the one schedule here that names the bit in its own interrupt mask
	hl_ai_mon[s].task_status = HLTK_FAILED;

	HLAISetCond(s, HLCOND_TASK_FAILED);
}

//dlls/activity.h. HLACT_ is this port's own dense enum; LookupActivity matches
//against the number studiomdl baked into the sequence, so the two have to be
//mapped. -1 for an activity with no SDK counterpart.
//
//Verified against the shipped models: scientist.mdl carries walk at 3, run at
//4 and six idle takes at 1 with actweights 50/1/2/1/1/10.
I64 HLAIActToSDK(I64 act)
{
	if (act == HLACT_IDLE)			return 1;	//ACT_IDLE
	if (act == HLACT_WALK)			return 3;	//ACT_WALK
	if (act == HLACT_RUN)			return 4;	//ACT_RUN
	if (act == HLACT_MELEE)			return 30;	//ACT_MELEE_ATTACK1
	if (act == HLACT_RANGE)			return 28;	//ACT_RANGE_ATTACK1
	if (act == HLACT_DIE)			return 36;	//ACT_DIESIMPLE
	if (act == HLACT_FLINCH)		return 26;	//ACT_SMALL_FLINCH
	if (act == HLACT_MELEE2)		return 31;	//ACT_MELEE_ATTACK2
	if (act == HLACT_RANGE2)		return 29;	//ACT_RANGE_ATTACK2
	if (act == HLACT_RELOAD)		return 32;	//ACT_RELOAD
	if (act == HLACT_COMBAT_IDLE)	return 62;	//ACT_COMBAT_IDLE
	if (act == HLACT_SIGNAL)		return 21;	//ACT_SIGNAL1
	if (act == HLACT_THREAT)		return 57;	//ACT_THREAT_DISPLAY
	if (act == HLACT_VICTORY)		return 65;	//ACT_VICTORY_DANCE
	if (act == HLACT_COWER)			return 25;	//ACT_COWER
	if (act == HLACT_ARM)			return 33;	//ACT_ARM
	if (act == HLACT_DISARM)		return 34;	//ACT_DISARM
	if (act == HLACT_EAT)			return 35;	//ACT_EAT
	if (act == HLACT_SPECIAL)		return 60;	//ACT_SPECIAL_ATTACK1
	if (act == HLACT_BARN_HIT)		return 40;	//ACT_BARNACLE_HIT
	if (act == HLACT_BARN_PULL)		return 41;	//ACT_BARNACLE_PULL
	if (act == HLACT_BARN_CHOMP)	return 42;	//ACT_BARNACLE_CHOMP
	if (act == HLACT_BARN_CHEW)		return 43;	//ACT_BARNACLE_CHEW

	return -1;
}

I64 HLAIDeathSDKAct(I64 s)
{//GetDeathActivity, combat.cpp:348. SDK activity numbers: 36 simple, 37 back,
 //38 forward, 66 headshot, 68 gutshot. LookupActivity failure is -1.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 forward[3];
	F64			 src[3];
	F64			 dest[3];
	F64			 mins[3];
	F64			 maxs[3];
	F64			 neg[3];
	F64			 flDot;
	I64			 death;
	Bool		 tried_dir;

	if (!e)
		return 36;

	tried_dir = FALSE;
	death     = 36;	//ACT_DIESIMPLE

	HLAngleVectors(e->angles, forward, NULL, NULL);
	neg[0] = -hl_attack_dir[0];
	neg[1] = -hl_attack_dir[1];
	neg[2] = -hl_attack_dir[2];
	flDot  = HLVecDot(forward, neg);

	//HITGROUP_HEAD 1, HITGROUP_STOMACH 3, HITGROUP_GENERIC 0
	if (hl_last_hitgroup == 1)
		death = 66;	//ACT_DIE_HEADSHOT
	else if (hl_last_hitgroup == 3)
		death = 68;	//ACT_DIE_GUTSHOT
	else
	{
		tried_dir = TRUE;

		if (flDot > 0.3)
			death = 38;	//ACT_DIEFORWARD
		else if (flDot <= -0.3)
			death = 37;	//ACT_DIEBACKWARD
	}

	if (!e->studio || HLStudioLookupActivity(e->studio, death) < 0)
	{
		if (tried_dir)
			death = 36;
		else if (flDot > 0.3)
			death = 38;
		else if (flDot <= -0.3)
			death = 37;
	}

	if (!e->studio || HLStudioLookupActivity(e->studio, death) < 0)
		death = 36;

	//Center()
	if (e->absmax[0] > e->absmin[0] || e->absmax[2] > e->absmin[2])
	{
		src[0] = (e->absmin[0] + e->absmax[0]) * 0.5;
		src[1] = (e->absmin[1] + e->absmax[1]) * 0.5;
		src[2] = (e->absmin[2] + e->absmax[2]) * 0.5;
	}
	else
	{
		src[0] = e->origin[0] + (e->mins[0] + e->maxs[0]) * 0.5;
		src[1] = e->origin[1] + (e->mins[1] + e->maxs[1]) * 0.5;
		src[2] = e->origin[2] + (e->mins[2] + e->maxs[2]) * 0.5;
	}

	//head_hull = VEC_DUCK_HULL
	HLVecSet(mins, -16.0, -16.0, -18.0);
	HLVecSet(maxs,  16.0,  16.0,  18.0);

	if (death == 38 && hl_map)
	{
		HLVecMA(src, 64.0, forward, dest);
		HLTraceEntity(hl_map, src, dest, mins, maxs, 0, FALSE, &tr);

		if (tr.fraction != 1.0)
			death = 36;
	}

	if (death == 37 && hl_map)
	{
		dest[0] = src[0] - forward[0] * 64.0;
		dest[1] = src[1] - forward[1] * 64.0;
		dest[2] = src[2] - forward[2] * 64.0;
		HLTraceEntity(hl_map, src, dest, mins, maxs, 0, FALSE, &tr);

		if (tr.fraction != 1.0)
			death = 36;
	}

	return death;
}

I64 HLAISpreadLabel(I64 kind, CHLStudio *m, I64 act, I64 seq)
{//A label-table hit that landed on a take sharing its activity with others.
 //
 //HLAIResolveActivity asks LookupActivity first and reaches the label table
 //only when the model tags no take with the number HLAIActToSDK gave. Where
 //the model files the take under a different activity, that number is the
 //port's name for the behaviour rather than the animator's, and the weighted
 //spread LookupActivity would have applied is lost. Measured over the 13
 //monster models with a label table, five slots of 105 land here:
 //
 //   headcrab MELEE      jump, jump_variation1, jump_variation2   act 28 w2/1/1
 //   houndeye COMBAT_IDLE madidle, madidle2, madidle3             act 47 w2/3/1
 //   zombie   MELEE2     attack1, attack2                         act 30 w5/1
 //   agrunt   MELEE2     mattack2, mattack3                       act 30 w1/1
 //   agrunt   RANGE2     hornetattack, quickshoot, longshoot       act 28 w1/1/1
 //
 //The last three must not spread: the port separates MELEE from MELEE2 and
 //RANGE from RANGE2 by naming the take, because the model files both under one
 //activity, and spreading would make the two slots indistinguishable. The test
 //for that is whether another slot of this monster names a take carrying the
 //same activity.
 //
 //Weighting matches LookupActivity's running reservoir, animation.cpp:84-109.
	U8	*label;
	I64	 activity;
	I64	 weight_total = 0;
	I64	 count        = 0;
	I64	 pick         = seq;
	I64	 other;
	I64	 a;
	I64	 i;

	if (!m || seq < 0 || seq >= m->num_seqs)
		return seq;

	activity = m->seqs[seq].activity;

	if (activity <= 0)
		return seq;

	for (i = 0; i < m->num_seqs; i++)
	{
		if (m->seqs[i].activity == activity)
			count++;
	}

	if (count < 2)
		return seq;

	//another slot claims one of these takes by name: the split is deliberate
	for (a = 0; a < HLACT_COUNT; a++)
	{
		if (a == act)
			goto qsl_next_act;

		label = HLAIMonSeqOf(kind, a);

		if (!label)
			goto qsl_next_act;

		other = HLStudioSeqByName(m, label);

		if (other >= 0 && other < m->num_seqs &&
			m->seqs[other].activity == activity)
			return seq;

qsl_next_act:
	}

	for (i = 0; i < m->num_seqs; i++)
	{
		if (m->seqs[i].activity != activity)
			goto qsl_next_seq;

		weight_total += m->seqs[i].act_weight;

		if (!weight_total ||
			(RandU32 % weight_total) < m->seqs[i].act_weight)
			pick = i;

qsl_next_seq:
	}

	return pick;
}

I64 HLAIResolveActivity(I64 s, I64 act)
{//::LookupActivity first, the label table second. -1 when the model has
 //neither.
 //
 //The label table picks one hardcoded take per activity, so a scientist with
 //six idles always played idle1. LookupActivity draws from all of them in
 //proportion to actweight, animation.cpp:84-109
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	U8			*label;
	I64			 seq;
	I64			 sdk;

	if (!e || !e->studio)
		return -1;

	//CHGrunt::SetActivity, hgrunt.cpp:1866-1898. Measured from hgrunt.mdl:
	//only crouching_mp5 and crouching_shotgun carry ACT_RANGE_ATTACK1, and
	//reload_shotgun carries no activity at all, so the weighted pick below
	//cannot reach the standing takes and cannot tell the two weapons apart.
	//The grunt names the take, as the SDK does.
	//
	//m_fStanding is not modelled - nothing crouches in this port - so the
	//standing pair is always the one chosen
	if (hl_ai_mon[s].kind == HLMON_HGRUNT &&
		(act == HLACT_RANGE || act == HLACT_RELOAD))
	{
		if (HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP) ==
			HLGRUNT_GUN_SHOTGUN)
		{
			if (act == HLACT_RANGE)
				return HLStudioSeqByName(e->studio, "standing_shotgun");

			return HLStudioSeqByName(e->studio, "reload_shotgun");
		}

		if (act == HLACT_RANGE)
			return HLStudioSeqByName(e->studio, "standing_mp5");

		return HLStudioSeqByName(e->studio, "reload_mp5");
	}

	sdk = HLAIActToSDK(act);

	if (sdk > 0)
	{
		seq = HLStudioLookupActivity(e->studio, sdk);

		if (seq >= 0)
			return seq;
	}

	//models whose sequences carry activity 0 - and the takes this port names
	//that studiomdl never tagged - still resolve through the table
	label = HLAIMonSeqOf(hl_ai_mon[s].kind, act);

	if (!label)
		return -1;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
		return -1;

	return HLAISpreadLabel(hl_ai_mon[s].kind, e->studio, act, seq);
}

U0 HLAISetActivity(I64 s, I64 act)
{//::SetActivity, monsters.cpp:1222
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 cycle;
	F64			 dur;
	I64			 seq;
	I64			 was;
	I64			 own;
	Bool		 loop;
	Bool		 keep;

	if (!e)
		return;

	was = hl_ai_mon[s].activity;

	//TASK_PLAY_SCRIPT and TASK_WAIT_FOR_SCRIPT: while WAIT/PLAYING the take is
	//the script's, not an activity (scripted.cpp:493). Guarding only PLAYING
	//let WAIT overwrite m_iszIdle (c0a0 flashlight knock). WALK/RUN_TO_MARK
	//still need SetActivity to drive the walk cycle.
	own = -1;

	if (hl_ai_mon[s].ent >= 0 && hl_ai_mon[s].ent < HLENT_MAX)
		own = hl_ai_cine[hl_ai_mon[s].ent].owner;

	if (own >= 0)
	{
		if (hl_ai_cine[own].state == HLSS_PLAYING ||
			hl_ai_cine[own].state == HLSS_WAIT)
		{
			hl_ai_mon[s].activity = act;
			return;
		}
	}

	//schedule.cpp:277 and :296 call SetActivity only on m_Activity !=
	//m_IdealActivity. Several callers here run every tick instead, and
	//LookupActivity re-rolls its weighted pick on every call, so without this
	//gate a scientist would draw a new idle take and restart the cycle at frame
	//zero for as long as it stood still.
	//
	//A one-shot is exempt: monsters.cpp:1231 forces frame 0 when the sequence
	//does not loop, which is how a schedule replays an attack take back to back
	if (act == was && e->studio && e->anim_loop &&
		e->seq >= 0 && e->seq == hl_ai_mon[s].act_seq)
		return;

	seq = HLAIResolveActivity(s, act);

	//an activity the model has no take for falls back to idle rather than
	//leaving the previous one running: a monster with no combat idle should
	//stand, not keep walking on the spot
	if (seq < 0 && act != HLACT_IDLE)
	{
		act = HLACT_IDLE;
		seq = HLAIResolveActivity(s, act);
	}

	if (seq < 0)
		return;

	//m_Activity, which ReportAIState prints
	hl_ai_mon[s].activity = act;
	hl_ai_mon[s].act_seq  = seq;

	//monsters.cpp:1231: the cycle restarts when the sequence index changes, or
	//when the current sequence does not loop - which is how a schedule replays
	//an attack take back to back. Re-selecting the same looping take leaves it
	//running, so a weighted re-roll landing where it already was does not
	//stutter the walk
	if (seq == e->seq && e->anim_loop)
		return;

	//only the ambulatory and idle activities loop. Attack, flinch and death are
	//one-shots, and HLAIEntityCycle holds a one-shot's last frame
	loop = ToBool(act == HLACT_IDLE || act == HLACT_WALK || act == HLACT_RUN ||
		act == HLACT_COMBAT_IDLE || act == HLACT_BARN_PULL ||
		act == HLACT_BARN_CHEW);

	//"don't reset frame between walk and run", monsters.cpp:1234. The SDK keeps
	//the raw frame index; the two takes differ in length, so the phase is what
	//carries over here
	keep = ToBool((was == HLACT_WALK || was == HLACT_RUN) &&
		(act == HLACT_WALK || act == HLACT_RUN));

	cycle = 0.0;

	if (keep)
		cycle = HLAIEntityCycle(e);

	e->seq        = seq;
	e->anim_done  = FALSE;

	//a new sequence has its own event list; the old frame index means nothing
	e->anim_event_frame = -1;

	//the sequence's own STUDIO_LOOPING flag overrides the choice above
	e->anim_loop = ToBool(loop || HLStudioSeqLoops(e->studio, seq));

	//ResetSequenceInfo's pev->animtime = gpGlobals->time, animating.cpp:116,
	//backed off by the phase being carried over
	dur = HLStudioSeqDuration(e->studio, seq);

	e->anim_start = hl_ent_time - cycle * dur;
}

Bool HLAIAnimDone(I64 s)
{//TRUE once the current one-shot sequence has run out
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dur;

	if (!e || !e->studio)
		return TRUE;

	dur = HLStudioSeqDuration(e->studio, e->seq);

	//a sequence with no duration would wait forever
	if (dur <= 0.0)
		return TRUE;

	return ToBool(hl_ent_time - e->anim_start >= dur);
}

Bool HLAITalkPointOf(I64 who, F64 *out)
{//where a talk target or follow leader stands. FALSE when it is gone or dead
	CHLEntity *e;

	HLVecSet(out, 0.0, 0.0, 0.0);

	if (who == HLTLK_PLAYER)
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return FALSE;

		HLAIPlayerOrigin(out);

		return TRUE;
	}

	if (who < 0)
		return FALSE;

	e = HLEntGet(who);

	if (!e || e->health <= 0.0)
		return FALSE;

	HLVecCopy(e->origin, out);

	return TRUE;
}

U0 HLAIStartTask(I64 s, I64 task, F64 data)
{//StartTask: the one-off half of a task. Anything decidable now is decided here
 //and the task completes immediately
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 away[3];
	F64			 cover[3];
	F64			 flame_src[3];
	F64			 flame_fwd[3];
	F64			 flame_vel[3];

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	hl_ai_mon[s].task_status = HLTK_RUNNING;
	hl_ai_mon[s].task_start  = hl_ent_time;

	switch (task)
	{
		case HLTASK_WAIT:
			break;

		case HLTASK_WAIT_RANDOM:
			//rolled into task_start rather than stored: RunTask compares
			//against the same data every tick, so shortening the window means
			//backdating the start
			hl_ai_mon[s].task_start = hl_ent_time -
				HLPartRand(1.0) * data * 0.5;
			break;

		case HLTASK_WAIT_FOR_ANIM:
			break;

		case HLTASK_SET_ACTIVITY:
			HLAISetActivity(s, ToI64(data));
			HLAITaskComplete(s);
			break;

		case HLTASK_STOP_MOVING:
			hl_ai_mon[s].have_goal     = FALSE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].move_speed    = 0.0;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			break;

		case HLTASK_FACE_GOAL:
			break;

		case HLTASK_PATH_TO_ENEMY:
			//TASK_GET_PATH_TO_ENEMY in the SDK asks CGraph for a route and
			//fails when there is none, which keeps a monster from walking at a
			//wall. There is no graph, so this cannot fail and the monster
			//walks at the wall - the largest behavioural difference here.
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = TRUE;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);

			//stop short of the enemy rather than inside it: melee reach if it
			//has one, otherwise 48 units
			hl_ai_mon[s].goal_tol = 48.0;

			if (mi->melee_range > 0.0)
				hl_ai_mon[s].goal_tol = mi->melee_range * 0.75;

			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_AWAY:
			//TASK_FIND_COVER_FROM_ENEMY, with the cover node lookup replaced
			//by "directly away". The SDK picks a node the enemy cannot see;
			//this picks a straight line, so a fleeing monster runs into
			//whatever is behind it as often as it gets clear.
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(e->origin, hl_ai_mon[s].enemy_pos, away);
			away[2] = 0.0;

			if (HLVecNormalize(away) <= 0.0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecMA(e->origin, data, away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			hl_ai_mon[s].move_speed = mi->walk_speed;
			HLAISetActivity(s, HLACT_WALK);
			break;

		case HLTASK_RUN_PATH:
			hl_ai_mon[s].move_speed = mi->run_speed;
			HLAISetActivity(s, HLACT_RUN);
			break;

		case HLTASK_MELEE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			//no attack sequence in the model: land the hit now. RunTask times
			//the hit off the sequence, so without one there is nothing to
			//time it to
			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE);
			break;

		case HLTASK_RANGE_ATTACK1:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE);
			break;

		case HLTASK_SOUND_ATTACK:
			HLAIMonSound(s, mi->snd_attack);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_ALERT:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_DIE:
			HLAIMonSound(s, mi->snd_die);
			HLAITaskComplete(s);
			break;

		case HLTASK_DIE:
		{
			//BecomeDead: out of the damage set, out of the collision set, and
			//holding the last frame of the die sequence. A corpse that could
			//still be killed would queue HLM_BREAK_DIE on every further hit.
			I64	sdk;
			I64	seq;

			sdk = HLAIDeathSDKAct(s);
			seq = -1;

			if (e->studio)
				seq = HLStudioLookupActivity(e->studio, sdk);

			if (seq >= 0)
			{
				hl_ai_mon[s].activity = HLACT_DIE;
				hl_ai_mon[s].act_seq  = seq;
				e->seq                = seq;
				e->anim_done          = FALSE;
				e->anim_event_frame   = -1;
				e->anim_loop = ToBool(HLStudioSeqLoops(e->studio, seq));
				e->anim_start = hl_ent_time;
			}
			else
				HLAISetActivity(s, HLACT_DIE);

			e->takedamage = HLDMG_TAKE_NO;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->health     = 0.0;

			hl_ai_mon[s].have_goal  = FALSE;
			hl_ai_mon[s].have_enemy = FALSE;

			//Killed: the squad loses a member and its slot
			HLAISquadRemove(s);
			break;
		}

		case HLTASK_WAIT_INDEF:
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			break;

		case HLTASK_FACE_IDEAL:
			break;

		case HLTASK_SMALL_FLINCH:
			//TASK_SMALL_FLINCH. TASK_REMEMBER(bits_MEMORY_FLINCHED) precedes it
			//in both tlSmallFlinch (defaultai.cpp:672) and tlAlertSmallFlinch
			//(:250); folded in here rather than given a task of its own, the
			//memory set having no other user.
			//
			//The pain sound goes with it: CBaseMonster::TakeDamage calls
			//PainSound at the same moment the flinch schedule is set
			hl_ai_mon[s].flinched = TRUE;

			HLAISetActivity(s, HLACT_FLINCH);

			if (hl_ent_time >= hl_ai_mon[s].next_pain_snd)
			{
				if (mi->snd_pain[0])
					HLAIMonSound(s, mi->snd_pain);
				hl_ai_mon[s].next_pain_snd = hl_ent_time + 1.0;
			}
			break;

		case HLTASK_FIND_COVER_ENEMY:
			//TASK_FIND_COVER_FROM_ENEMY
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].enemy_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_SOUND:
			//TASK_FIND_COVER_FROM_BEST_SOUND
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAIFindCover(s, hl_ai_mon[s].heard_pos, TRUE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].in_cover      = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_FIND_COVER_ORG:
			//TASK_FIND_COVER_FROM_ORIGIN: anywhere but here. Nothing has to be
			//hidden from, so the visibility test is off and any standable spot
			//will do
			if (!HLAIFindCover(s, e->origin, FALSE, cover))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(cover, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 24.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_SOUND:
			//TASK_GET_PATH_TO_BESTSOUND
			if (hl_ai_mon[s].heard < 0)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].heard_pos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 48.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);

			//the facing task that follows turns toward the noise
			hl_ai_mon[s].ideal_yaw =
				HLAIYawTo(e->origin, hl_ai_mon[s].heard_pos);

			HLAITaskComplete(s);
			break;

		case HLTASK_STORE_LASTPOS:
			HLVecCopy(e->origin, hl_ai_mon[s].lastpos);
			hl_ai_mon[s].have_lastpos = TRUE;
			HLAITaskComplete(s);
			break;

		case HLTASK_PATH_TO_LASTPOS:
			if (!hl_ai_mon[s].have_lastpos)
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(hl_ai_mon[s].lastpos, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = 32.0;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			HLAITaskComplete(s);
			break;

		case HLTASK_CLEAR_LASTPOS:
			hl_ai_mon[s].have_lastpos = FALSE;
			HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			//HGRUNT_AE_RELOAD refills the clip on the event; without a reload
			//take in the model there is nothing to hang it on, so it refills
			//here and the task ends
			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RELOAD))
			{
				hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RELOAD);
			break;

		case HLTASK_MELEE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_MELEE2))
			{
				HLAIHullAttack(s, mi->melee2_range, mi->melee2_dmg);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_MELEE2);

			//CGargantua::StartTask TASK_FLAME_SWEEP, gargantua.cpp:1089.
			//shootflames2 carries no AE_*; FlameCreate runs at task start.
			//4.5s is tlGargFlame's TASK_FLAME_SWEEP duration.
			if (hl_ai_mon[s].kind == HLMON_GARGANTUA)
			{
				HLAIGunPos(s, flame_src);
				HLAngleVectors(e->angles, flame_fwd, NULL, NULL);
				HLVecScale(flame_fwd, 330.0, flame_vel);
				HLAIProjRequest(HLAIPRJ_FLAME, flame_src, flame_vel,
					mi->melee2_dmg, 4.5, 0.0, 0.0, FALSE, hl_ai_mon[s].ent);
				HLAIMonSound(s, "garg/gar_flameon1.wav");
				HLAIAttackNoise(s);
			}
			break;

		case HLTASK_RANGE_ATTACK2:
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;

			//CApache::FireRocket / COsprey gunship: HVR via hl_proj
			if (hl_ai_mon[s].kind == HLMON_APACHE ||
				hl_ai_mon[s].kind == HLMON_OSPREY)
			{
				HLAIMonSound(s, "weapons/rocketfire1.wav");
				HLAIProjAtEnemy(s, HLAIPRJ_ROCKET, 1000.0, mi->range2_dmg,
					0.0, 0.5, 0.0, FALSE);
				HLAIAttackNoise(s);
				HLAITaskComplete(s);
				break;
			}

			if (!HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_RANGE2))
			{
				HLAIFireAttack(s, FALSE);
				HLAITaskComplete(s);
				break;
			}

			HLAISetActivity(s, HLACT_RANGE2);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			//TASK_SPECIAL_ATTACK1: a display rather than a hit. The houndeye's
			//hop back and the agrunt's threat both land here and neither does
			//damage on its own
			hl_ai_mon[s].next_attack = hl_ent_time + mi->attack_rate;
			HLAISetActivity(s, HLACT_SPECIAL);
			break;

		case HLTASK_SOUND_IDLE:
			HLAIMonSound(s, mi->snd_idle);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_PAIN:
			if (mi->snd_pain[0])
				HLAIMonSound(s, mi->snd_pain);
			HLAITaskComplete(s);
			break;

		case HLTASK_SOUND_WAKE:
			HLAIMonSound(s, mi->snd_alert);
			HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] + data);
			break;

		case HLTASK_TURN_RIGHT:
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(e->angles[1] - data);
			break;

		case HLTASK_SET_SCHEDULE:
			//the schedule change happens in RunSchedule, which owns the task
			//cursor: reaching into it from here would leave the interpreter
			//pointing into the schedule it just left
			HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			HLAISetActivity(s, ToI64(data));
			break;

		case HLTASK_EAT:
			HLAISetActivity(s, HLACT_EAT);
			break;

		case HLTASK_SUGGEST_STATE:
			HLAITaskComplete(s);
			break;

		case HLTASK_OCCUPY_SLOT:
			if (HLAIOccupySlot(s, ToI64(data)))
				HLAITaskComplete(s);
			else
				HLAITaskFail(s);
			break;

		case HLTASK_SAY_HEAL:
			//scientist.cpp:469-476. One sentence, then done. FOkToSpeak is
			//commented out in the SDK, so the line plays regardless
			HLAISentencePlay("SC_HEAL", hl_ai_mon[s].ent, e->origin, 1.0,
				HLATTN_IDLE);
			HLAITaskComplete(s);
			break;

		case HLTASK_HEAL:
			//scientist.cpp:504. The take carries the event that does the work
			HLAISetActivity(s, HLACT_MELEE);
			break;

		case HLTASK_FACE_TARGET:
			//AI_BaseNPC_Schedule.cpp:828 - MakeIdealYaw at m_hTargetEnt and
			//let RunTask turn. No target is a task failure there too
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			hl_ai_mon[s].ideal_yaw = HLAIYawTo(e->origin, away);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:879. MoveToTarget walks, so the follow is
			//a walk and not a run
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, away))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecCopy(away, hl_ai_mon[s].goal);
			hl_ai_mon[s].have_goal     = TRUE;
			hl_ai_mon[s].goal_is_enemy = FALSE;
			hl_ai_mon[s].goal_tol      = data;
			hl_ai_mon[s].path_start    = hl_ent_time;
			hl_ai_mon[s].stuck_since   = 0.0;
			hl_ai_mon[s].have_detour   = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].move_speed    = mi->walk_speed;

			HLAISetActivity(s, HLACT_WALK);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAIRunPath(I64 s, F64 dt)
{//the body of TASK_WALK_PATH and TASK_RUN_PATH, which differ only in the speed
 //and the activity StartTask already chose. A function rather than two cases
 //sharing one body, for the reason in HLAIRunTask.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	I64			 res;
	I64			 node;
	I64			 nxt;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (!hl_ai_mon[s].have_goal)
	{
		HLAITaskComplete(s);
		return;
	}

	//a chase re-aims at the enemy every tick. This is the goal moving, not a
	//route update: without it a monster runs at the spot the enemy stood in
	//when the schedule started. Out of sight it heads for the last known
	//position, CheckEnemy's m_vecLastKnownPos.
	if (hl_ai_mon[s].goal_is_enemy && hl_ai_mon[s].have_enemy)
	{
		if (hl_ent_time - hl_ai_mon[s].enemy_seen <= HLAI_LOOK_PERIOD * 2.0 &&
			HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
			HLVecCopy(feet, hl_ai_mon[s].goal);
		}
		else
			HLVecCopy(hl_ai_mon[s].enemy_pos, hl_ai_mon[s].goal);
	}

	//a monster always faces its travel direction: strafing needs four-way
	//blends the studio layer does not do
	HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt);

	res = HLAIMoveStep(s, hl_ai_mon[s].move_speed, dt);

	if (res == HLAI_MOVE_ARRIVED)
	{
		//CBigMomma::NodeReach: advance pev->target along the info_bigmomma chain
		if (hl_ai_mon[s].kind == HLMON_BIGMOMMA &&
			!hl_ai_mon[s].goal_is_enemy && e->target[0])
		{
			node = HLEntFindByTargetname(e->target, 0);
			if (node >= 0 &&
				!StrCompare(hl_entities[node].classname, "info_bigmomma"))
			{
				if (hl_entities[node].message[0])
					HLEntFireTargetsNamed(hl_entities[node].message, node,
						hl_ai_mon[s].ent, HLUSE_TOGGLE, 0.0);

				if (hl_entities[node].health > 0.0)
					e->health = hl_entities[node].health *
						(e->max_health / 150.0);

				HLStrCopy(e->target, hl_entities[node].target, 64);
				if (e->target[0])
				{
					nxt = HLEntFindByTargetname(e->target, 0);
					if (nxt >= 0 &&
						!StrCompare(hl_entities[nxt].classname,
							"info_bigmomma"))
					{
						HLVecCopy(hl_entities[nxt].origin, hl_ai_mon[s].goal);
						hl_ai_mon[s].have_goal     = TRUE;
						hl_ai_mon[s].goal_is_enemy = FALSE;
						hl_ai_mon[s].goal_tol      = 128.0;
						hl_ai_mon[s].path_start    = hl_ent_time;
						HLAIRouteClear(s);
						return;
					}
				}
				hl_ai_mon[s].have_goal = FALSE;
			}
		}

		HLAITaskComplete(s);
		return;
	}

	if (res == HLAI_MOVE_BLOCKED)
	{
		HLAITaskFail(s);
		return;
	}

	//an unreachable goal must not hold the schedule forever
	if (hl_ent_time - hl_ai_mon[s].path_start > HLAI_PATH_TIMEOUT)
	{
		HLAITaskFail(s);
		return;
	}

	//in melee reach mid-run: stop now, so the attack goes off this tick rather
	//than once the goal tolerance is met
	if (mi->melee_range > 0.0 && hl_ai_mon[s].have_enemy)
	{
		if (HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		{
			HLVecSub(feet, e->origin, d);

			if (HLVecLength(d) <= mi->melee_range)
				HLAITaskComplete(s);
		}
	}
}

U0 HLAIRunTask(I64 s, I64 task, F64 data, F64 dt)
{//RunTask: the per-tick half. Only the tasks that take time appear here
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	F64			 tpos[3];
	F64			 tdiff[3];

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//no `case A: case B:` sharing one body below: consecutive case labels are
	//a construct nothing else in this tree exercises. Every case carries its
	//own body.
	switch (task)
	{
		case HLTASK_WAIT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_RANDOM:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_WAIT_FOR_ANIM:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_ENEMY:
			if (!hl_ai_mon[s].have_enemy)
			{
				HLAITaskFail(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin,
				hl_ai_mon[s].enemy_pos), dt))
				HLAITaskComplete(s);

			//backstop against a face-lock. The SDK has no such guard because
			//ChangeYaw always reaches ideal_yaw
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_GOAL:
			if (!hl_ai_mon[s].have_goal)
			{
				HLAITaskComplete(s);
				break;
			}

			if (HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].goal), dt))
				HLAITaskComplete(s);
			break;

		case HLTASK_WALK_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_RUN_PATH:
			HLAIRunPath(s, dt);
			break;

		case HLTASK_MELEE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				HLAIFireAttack(s, TRUE);
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_RANGE_ATTACK1:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
			{
				//CNihilanth balls after attack1/shoot; HLAIPRJ lives below
				//FireAttack in this file
				if (hl_ai_mon[s].kind == HLMON_NIHILANTH)
				{
					HLAIMonSound(s, mi->snd_attack);
					HLAIProjAtEnemy(s, HLAIPRJ_CTRLBALL, 800.0,
						mi->range_dmg, 5.0);
					HLAIAttackNoise(s);
				}
				else
					HLAIFireAttack(s, FALSE);

				HLAITaskComplete(s);
			}
			break;

		case HLTASK_DIE:
			//never completes. No corpse cleanup and no gibs, so the schedule
			//parks here and the body holds its last frame
			break;

		case HLTASK_WAIT_INDEF:
			//TASK_WAIT_INDEFINITE. Only a condition leaves it, which for this
			//interpreter means the state machine dropping the schedule
			break;

		case HLTASK_WAIT_FACE_ENEMY:
			if (hl_ai_mon[s].have_enemy)
				HLAITurnToward(s, HLAIYawTo(e->origin,
					hl_ai_mon[s].enemy_pos), dt);

			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_IDEAL:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			//the same backstop TASK_FACE_ENEMY carries
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_SMALL_FLINCH:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_RELOAD:
			if (HLAIAnimDone(s))
			{
				hl_ai_mon[s].ammo = hl_ai_mon[s].clip;
				HLAITaskComplete(s);
			}
			break;

		case HLTASK_MELEE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_HEAL:
			//scientist.cpp:579-590. Ends on the take, or early if the target
			//has walked out of reach, and keeps turning to face it meanwhile
			if (HLAIAnimDone(s))
			{
				HLAITaskComplete(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, tpos))
			{
				HLAITaskComplete(s);
				break;
			}

			HLVecSub(tpos, e->origin, tdiff);

			if (HLVecLength(tdiff) > HLSCI_HEAL_BREAK)
			{
				HLAITaskComplete(s);
				break;
			}

			HLAITurnToward(s, HLAIYawTo(e->origin, tpos), dt);
			break;

		case HLTASK_RANGE_ATTACK2:
			HLAITurnToward(s, HLAIYawTo(e->origin, hl_ai_mon[s].enemy_pos),
				dt);

			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_SPECIAL_ATTACK1:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_LEFT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_TURN_RIGHT:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_PLAY_SEQUENCE:
			if (HLAIAnimDone(s))
				HLAITaskComplete(s);
			break;

		case HLTASK_EAT:
			if (hl_ent_time - hl_ai_mon[s].task_start >= data)
				HLAITaskComplete(s);
			break;

		case HLTASK_FACE_TARGET:
			if (HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt))
				HLAITaskComplete(s);

			//the same backstop TASK_FACE_ENEMY carries
			if (hl_ent_time - hl_ai_mon[s].task_start > 3.0)
				HLAITaskComplete(s);
			break;

		case HLTASK_MOVE_TO_TARGET:
			//AI_BaseNPC_Schedule.cpp:410-425: the goal is re-aimed once the
			//leader has moved more than half the stand-off distance from it,
			//not every tick, so a follower is not permanently re-routing
			if (hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
			{
				HLAITaskFail(s);
				break;
			}

			if (!HLAITalkPointOf(hl_ai_talk[hl_ai_mon[s].ent].follow, tpos))
			{
				HLAITaskFail(s);
				break;
			}

			HLVecSub(tpos, hl_ai_mon[s].goal, tdiff);

			if (HLVecLength(tdiff) > data * 0.5)
			{
				HLVecCopy(tpos, hl_ai_mon[s].goal);
				hl_ai_mon[s].path_start  = hl_ent_time;
				hl_ai_mon[s].stuck_since = 0.0;
				hl_ai_mon[s].have_detour = FALSE;
				HLAIRouteClear(s);
			}

			HLVecSub(hl_ai_mon[s].goal, e->origin, tdiff);
			tdiff[2] = 0.0;

			//Length2D, as the SDK's distance check is
			if (HLVecLength(tdiff) < data)
			{
				HLAITaskComplete(s);
				break;
			}

			HLAIRunPath(s, dt);
			break;

		default:
			HLAITaskComplete(s);
			break;
	}
}

U0 HLAISetSchedule(I64 s, I64 sched)
{//ChangeSchedule: take the list from the top
	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	//CSquadMonster::ScheduleChange gives the squad slot back on every schedule
	//change, so a grunt that stops firing releases its engage bit to the next
	//man rather than holding it for the rest of the fight
	HLAIVacateSlot(s);

	hl_ai_mon[s].in_cover   = FALSE;
	hl_ai_mon[s].sched      = sched;
	hl_ai_mon[s].task       = 0;
	hl_ai_mon[s].sched_done = FALSE;

	//"m_afConditions = 0", schedule.cpp:82. A bit the old schedule did not act
	//on must not survive into the new one, or the schedule the selector just
	//chose is aborted on its first tick by the condition that chose it
	hl_ai_mon[s].conds = HLCOND_NONE;

	if (!hl_ai_sched_len[sched])
	{
		hl_ai_mon[s].sched_done  = TRUE;
		hl_ai_mon[s].task_status = HLTK_DONE;
		return;
	}

	HLAIStartTask(s, hl_ai_sched_task[sched * HLAI_SCHED_TASKS],
		hl_ai_sched_data[sched * HLAI_SCHED_TASKS]);
}

U0 HLAIRunSchedule(I64 s, F64 dt)
{//one tick of the current schedule, advancing through as many tasks as
 //complete immediately
	I64 sched = hl_ai_mon[s].sched;
	I64 slot;
	I64 budget = HLAI_SCHED_TASKS + 1;

	if (sched <= HLSCHED_NONE || sched >= HLSCHED_COUNT)
		return;

	while (budget > 0)
	{
		budget--;

		if (hl_ai_mon[s].sched_done)
			return;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		if (hl_ai_mon[s].task_status == HLTK_RUNNING)
		{
			HLAIRunTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot], dt);

			//still running after RunTask: nothing more this tick
			if (hl_ai_mon[s].task_status == HLTK_RUNNING)
				return;
		}

		if (hl_ai_mon[s].task_status == HLTK_FAILED)
		{
			//TaskFail runs the fail schedule, m_failSchedule, which for every
			//schedule here is slFail: stand still for two seconds rather than
			//re-select the same failing option once per tick
			if (hl_ai_mon[s].fail_sched > HLSCHED_NONE &&
				hl_ai_mon[s].fail_sched != sched)
			{
				HLAISetSchedule(s, hl_ai_mon[s].fail_sched);
				return;
			}

			hl_ai_mon[s].sched      = HLSCHED_NONE;
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		//TASK_SET_SCHEDULE jumps rather than advancing. The switch happens
		//here, not in StartTask, because this loop owns the task cursor
		if (hl_ai_sched_task[slot] == HLTASK_SET_SCHEDULE)
		{
			HLAISetSchedule(s, ToI64(hl_ai_sched_data[slot]));
			return;
		}

		//done: next task
		hl_ai_mon[s].task++;

		if (hl_ai_mon[s].task >= hl_ai_sched_len[sched])
		{
			hl_ai_mon[s].sched_done = TRUE;
			return;
		}

		slot = sched * HLAI_SCHED_TASKS + hl_ai_mon[s].task;

		HLAIStartTask(s, hl_ai_sched_task[slot], hl_ai_sched_data[slot]);
	}
}

//--- the state machine ------------------------------------------------------

U0 HLAISetState(I64 s, I64 state)
{//SetState. The schedule is dropped, so the selector runs fresh in the new state
 //rather than finishing a schedule belonging to the old one
	if (hl_ai_mon[s].state == state)
		return;

	hl_ai_mon[s].state      = state;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;
}

//--- the scripted_sequence driver -------------------------------------------
//
// CCineMonster, dlls/scripted.cpp, plus the tlScriptedWalk / tlScriptedRun /
// tlScriptedWait task lists (defaultai.cpp:799-862) that carry the actor
// through it. Kept as one state machine on m_scriptState rather than as rows
// in the schedule table: these tasks are private to the script, never
// interleave with the combat schedules, and three of the five have no
// equivalent among the HLTASK_ set.
//
// Placed after the mover, HLAISetActivity and HLAISetState because it uses all
// three. ZealC is single-pass and has no forward declarations.
//
// toggle_state on the script entity, the only field HLEntity.ZC's dispatcher
// can reach:
//
//   AT_BOTTOM   no cue yet. The script may already hold its actor, posed in
//               m_iszIdle on the mark: a script naming an idle take possesses
//               at map load even when it is named (scripted.cpp:143), which is
//               how the guard is already leaning on his rail when you see him.
//   GOING_DOWN  cue posted by the dispatcher. Consumed here on the next tick.
//   GOING_UP    m_iszPlay running.
//   AT_TOP      retired. The SDK removes the entity instead.
//
// Not reproduced: SF_SCRIPT_WAITTILLSEEN (FGD bit, unread in SDK scripted.cpp),
// CCineMonster m_flRepeat (parsed, never read - sentence refire uses it).
// Root-bone cleanup and aiscripted m_iFinishSchedule are below.

U0 HLAICineLog(I64 self, U8 *what, F64 a, F64 b)
{//one line per script state change, behind `scriptlog 1`. ALERT(at_aiconsole)
 //in scripted.cpp, with the two numbers that decide whether an actor walked to
 //its mark or was put there: distance left and the mover's verdict
	CHLEntity	*script;
	I64			 t;

	if (!hl_ai_script_log)
		return;

	script = HLEntGet(self);

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	"SCRIPT %6.2f %-9s \"%s\" mv%d st%d ent%d %8.1f %8.1f\n",
		hl_ent_time, what, script->targetname, script->ai_moveto,
		hl_ai_cine[self].state, t, a, b;
}

Bool HLAICanPlaySequence(I64 t, Bool disregard, I64 level)
{//CBaseMonster::CanPlaySequence, monsters.cpp:3110
	CHLEntity	*e;
	I64			 s;

	if (t < 0 || t >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(t);

	if (!e)
		return FALSE;

	//m_pCine: already held, by this script or another
	if (hl_ai_cine[t].owner >= 0)
		return FALSE;

	s = hl_ai_mon_of[t];

	//an actor with no AI slot has no state to conflict with and needs only a
	//model to animate. What lands here is a monster_ class the table has no row
	//for, and a cycler or an env_ entity a mapper named as the actor
	if (s < 0)
		return ToBool(e->studio != NULL);

	if (hl_ai_mon[s].state == HLMSTATE_DEAD || e->health <= 0.0)
		return FALSE;

	//SF_SCRIPT_OVERRIDESTATE, and every aiscripted_sequence
	if (disregard)
		return TRUE;

	if (hl_ai_mon[s].state == HLMSTATE_NONE ||
		hl_ai_mon[s].state == HLMSTATE_IDLE)
		return TRUE;

	return ToBool(hl_ai_mon[s].state == HLMSTATE_ALERT &&
		level >= HLSS_INT_BY_NAME);
}

I64 HLAICineFind(I64 self)
{//CCineMonster::FindEntity, scripted.cpp:272. Every targetname match is tried
 //at SS_INTERRUPT_BY_NAME before the classname pass, which is limited to
 //m_flRadius and reaches only an idle actor.
	CHLEntity	*script = HLEntGet(self);
	F64			 d[3];
	Bool		 over;
	I64			 i;

	if (!script || !script->ai_entity[0])
		return -1;

	over = ToBool((script->spawnflags & HLAI_SF_OVERRIDESTATE) ||
		!StrCompare(script->classname, "aiscripted_sequence"));

	i = HLEntFindByTargetname(script->ai_entity, 0);

	while (i >= 0)
	{
		if (HLAICanPlaySequence(i, over, HLSS_INT_BY_NAME))
			return i;

		i = HLEntFindByTargetname(script->ai_entity, i + 1);
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qacf_next;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qacf_next;

		//UTIL_FindEntityInSphere has no zero-radius case: the engine tests the
		//candidate's box centre against the radius, so radius 0 admits only an
		//exact coincidence and the classname pass is off. 59 of the 512 shipped
		//scripts carry no m_flRadius; 57 resolve by targetname and never reach
		//here, and neither of the other two names a classname in its map
		HLVecSub(hl_entities[i].origin, script->origin, d);

		if (HLVecLength(d) > script->ai_radius)
			goto qacf_next;

		if (HLAICanPlaySequence(i, over, HLSS_INT_IDLE))
			return i;

qacf_next:
	}

	return -1;
}

U0 HLAICineDelayStart(I64 self, I64 state)
{//CCineMonster::DelayStart, scripted.cpp:725. Every scripted_sequence sharing
 //this targetname counts one actor still on its way; the group starts when the
 //count reaches zero. Two scientists walking to two marks both arrive before
 //either plays, which is what "act in concert" means in the entity comment.
	CHLEntity	*script = HLEntGet(self);
	I64			 i;

	if (!script)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || hl_entities[i].ent_class != HLC_SCRIPT)
			goto qacd_next;

		//an unnamed script is a group of one
		if (!script->targetname[0])
		{
			if (i != self)
				goto qacd_next;
		}
		else if (StrICompare(hl_entities[i].targetname, script->targetname))
			goto qacd_next;

		if (state)
			hl_ai_cine[i].delay++;
		else
		{
			hl_ai_cine[i].delay--;

			if (hl_ai_cine[i].delay <= 0)
				hl_ai_cine[i].start = hl_ent_time + 0.05;
		}

qacd_next:
	}
}

Bool HLAICineSetSeq(I64 t, U8 *label)
{//CCineMonster::StartSequence, scripted.cpp:493. An unknown label falls back
 //to sequence 0 as the SDK does after its error: leaving the previous take
 //running would play a walk cycle through a scripted death.
	CHLEntity	*e;
	I64			 seq;

	if (t < 0 || t >= HLENT_MAX || !label || !label[0])
		return FALSE;

	e = HLEntGet(t);

	if (!e || !e->studio)
		return FALSE;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
	{
		"HLAI: %s has no sequence \"%s\"\n", e->classname, label;
		seq = 0;
	}

	e->seq              = seq;
	e->anim_start       = hl_ent_time;
	e->anim_done        = FALSE;
	e->anim_event_frame = -1;
	e->anim_loop        = HLStudioSeqLoops(e->studio, seq);

	return TRUE;
}

U0 HLAICineRelease(I64 self)
{//CBaseMonster::CineCleanup, scripted.cpp:796. Hand the actor back with the
 //movetype and solid the script saved, put it on the floor, and drop its
 //schedule so the selector runs fresh in IDLE.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	F64			 bone[3];
	F64			 old[3];
	F64			 dx;
	F64			 dy;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	hl_ai_cine[self].actor = -1;
	hl_ai_cine[self].state = HLSS_CLEANUP;

	if (t < 0 || t >= HLENT_MAX)
		return;

	hl_ai_cine[t].owner = -1;

	actor = HLEntGet(t);

	if (!actor)
		return;

	actor->movetype = hl_ai_cine[self].movetype;
	actor->solid    = hl_ai_cine[self].solid;

	s = hl_ai_mon_of[t];

	if (s < 0)
		return;

	//SF_SCRIPT_NOSCRIPTMOVEMENT leaves the actor where the take ended.
	//Otherwise GetBonePosition(0) + DROP_TO_FLOOR, scripted.cpp:846-885.
	//Only when a play take ran: idle-only possession must not yank the actor.
	if (script->ai_play[0] &&
		!(script->spawnflags & HLAI_SF_NOSCRIPTMOVEMENT))
	{
		HLVecCopy(actor->origin, old);

		if (actor->studio)
		{
			HLStudioPose(actor->studio, actor->origin, actor->angles,
				actor->seq, HLAIEntityCycle(actor), actor->blending[0],
				actor->controllers, actor->blending[1]);

			if (HLStudioBonePos(actor->studio, 0, bone))
			{
				dx = old[0] - bone[0];
				dy = old[1] - bone[1];

				//"don't move monster if they don't seem to move", < 8 units 2D
				if (dx * dx + dy * dy >= 64.0)
				{
					actor->origin[0] = bone[0];
					actor->origin[1] = bone[1];
					actor->origin[2] = bone[2] + 1.0;
				}
			}
		}

		if (HLAIDropToFloorHard(actor, actor->mins, actor->maxs, floor))
			HLVecCopy(floor, actor->origin);
		else
			HLVecCopy(old, actor->origin);

		HLEntSetAbsBox(actor);
	}

	hl_ai_mon[s].scripted   = FALSE;
	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].activity   = HLACT_IDLE;
	hl_ai_mon[s].sched      = HLSCHED_NONE;
	hl_ai_mon[s].sched_done = TRUE;

	//m_IdealMonsterState. A script that killed its actor leaves it dead
	if (actor->health > 0.0)
		HLAISetState(s, HLMSTATE_IDLE);
	else
		HLAISetState(s, HLMSTATE_DEAD);
}

U0 HLAICineDone(I64 self)
{//CCineMonster::SequenceDone, scripted.cpp:561. The actor is released before
 //the targets fire: firing hands it straight to the next script in the chain,
 //which is how the walking scientists in c0a0 bounce between two marks.
	CHLEntity *script = HLEntGet(self);
	I64			 t;
	I64			 s;

	if (!script)
		return;

	HLAICineLog(self, "done", 0.0, 0.0);

	t = hl_ai_cine[self].actor;

	HLAICineRelease(self);

	//CCineAI::FixScriptMonsterSchedule, scripted.cpp:610. Ordinary
	//scripted_sequence just clears (Release already did). aiscripted may
	//force AMBUSH from m_iFinishSchedule.
	if (!StrCompare(script->classname, "aiscripted_sequence") &&
		script->ai_finish == HLAI_FINISH_AMBUSH &&
		t >= 0 && t < HLENT_MAX)
	{
		s = hl_ai_mon_of[t];

		if (s >= 0 && hl_ai_mon[s].state != HLMSTATE_DEAD)
			HLAISetSchedule(s, HLSCHED_AMBUSH);
	}

	hl_ai_cine[self].start   = hl_ent_time + HLAI_CINE_NEVER;
	hl_ai_cine[self].delay   = 0;
	hl_ai_cine[self].blocked = 0.0;

	//no think scheduled: a repeatable script waits to be fired again rather
	//than snatching its actor back from whatever the targets just started
	hl_ai_cine[self].retry = -1.0;

	if (script->spawnflags & HLAI_SF_REPEATABLE)
		script->toggle_state = HLTS_AT_BOTTOM;
	else
		script->toggle_state = HLTS_AT_TOP;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);
}

U0 HLAICinePossess(I64 self)
{//CCineMonster::PossessEntity, scripted.cpp:321. Claim the actor, record what
 //will be handed back, set m_scriptState from m_fMoveTo, pose the idle take.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	F64			 floor[3];
	F64			 left;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = HLAICineFind(self);

	if (t < 0)
	{
		//CineThink retries rather than retiring: the actor is often finishing
		//an earlier script in the same chain
		hl_ai_cine[self].retry = hl_ent_time + HLAI_CINE_RETRY;
		return;
	}

	actor = HLEntGet(t);

	hl_ai_cine[self].actor    = t;
	hl_ai_cine[self].movetype = actor->movetype;
	hl_ai_cine[self].solid    = actor->solid;
	hl_ai_cine[self].retry    = -1.0;
	hl_ai_cine[t].owner       = self;

	//Spawn sets m_interruptable from SF_SCRIPT_NOINTERRUPT, scripted.cpp:151
	if (script->spawnflags & HLAI_SF_NOINTERRUPT)
		hl_ai_cine[self].interrupt = FALSE;
	else
		hl_ai_cine[self].interrupt = TRUE;

	s = hl_ai_mon_of[t];

	if (s >= 0)
	{
		hl_ai_mon[s].scripted  = TRUE;
		hl_ai_mon[s].have_goal = FALSE;

		HLAISetState(s, HLMSTATE_SCRIPT);

		//DROP_TO_FLOOR, which every CBaseMonster::Spawn runs before a script
		//can reach the actor. HLAIMonThink does it on the first think and a
		//monster possessed at map load never gets one, so it is done here too.
		if (!hl_ai_mon[s].settled)
		{
			hl_ai_mon[s].settled = TRUE;

			if (!hl_ai_mon_info[hl_ai_mon[s].kind].flies &&
				HLAIDropToFloorHard(actor, actor->mins, actor->maxs, floor))
			{
				HLVecCopy(floor, actor->origin);
				HLEntSetAbsBox(actor);
			}
		}
	}

	HLVecSub(script->origin, actor->origin, floor);
	left = HLVecLength(floor);

	hl_ai_cine[self].blocked = 0.0;

	//m_fMoveTo. 1 and 2 leave the actor where it stands and route it; the rest
	//place it. An actor with no AI slot cannot route, so it is placed too.
	//
	//So is one whose model has no walk take. HLAISetActivity falls back to
	//HLACT_IDLE when an activity resolves to nothing, and LookupActivity then
	//draws a weighted ACT_IDLE take: holo.mdl tags twenty of its twenty-seven
	//sequences ACT_IDLE and none ACT_WALK, so routing it would play a tutorial
	//animation across the floor. Placing it is what this port already did for
	//every actor with no slot.
	if ((script->ai_moveto == HLAI_MOVE_WALK ||
		script->ai_moveto == HLAI_MOVE_RUN) && s >= 0 &&
		HLAIResolveActivity(s, HLACT_WALK) >= 0)
	{
		if (script->ai_moveto == HLAI_MOVE_WALK)
			hl_ai_cine[self].state = HLSS_WALK_TO_MARK;
		else
			hl_ai_cine[self].state = HLSS_RUN_TO_MARK;

		//RouteClear, which MoveToTarget runs before it lays the new route
		//(monsters.cpp:1750). The detour, the stuck timer and the lookahead
		//deadline all belong to whatever the actor was doing a tick ago; kept,
		//a monster that was already grinding on geometry reports blocked on the
		//script's first mover call and is planted on the mark instead of walking
		hl_ai_mon[s].have_detour     = FALSE;
		HLAIRouteClear(s);
		hl_ai_mon[s].stuck_since     = 0.0;
		hl_ai_mon[s].next_move_check = 0.0;

		HLAICineDelayStart(self, 1);
		HLAICineLog(self, "possess", left, 0.0);
	}
	else
	{
		hl_ai_cine[self].state = HLSS_WAIT;

		//5 turns to face without moving
		if (script->ai_moveto != HLAI_MOVE_NONE &&
			script->ai_moveto != HLAI_MOVE_TURN)
		{
			HLVecCopy(script->origin, actor->origin);
			HLEntSetAbsBox(actor);

			//EF_NOINTERP, scripted.cpp:369. The pose the actor left was struck
			//where it stood, not on the mark
			HLStudioLatchInvalidate(t);

			HLAICineLog(self, "place", left, 0.0);
		}
		else
			HLAICineLog(self, "possess", left, 0.0);

		//pev->angles.y is snapped in case 4 alone, scripted.cpp:371. 0 keeps the
		//facing the mapper gave the actor; 5 is slFaceScript, TASK_FACE_SCRIPT
		//setting ideal_yaw and TASK_FACE_IDEAL turning onto it at yaw_speed,
		//which the HLSS_WAIT branch runs each tick. Snapping all of them spun
		//355 of the 512 scripts in valve/maps on the frame they were possessed.
		if (script->ai_moveto == HLAI_MOVE_INSTANT)
			actor->angles[1] = HLAngleNorm(script->angles[1]);

		//m_startTime = time + 1E6 on a teleport: a placed actor holds its idle
		//until the trigger whether or not the script carries a targetname
		if (script->ai_moveto == HLAI_MOVE_INSTANT)
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
	}

	//TASK_FACE_SCRIPT, schedule.cpp:1293. Every script schedule but slWaitScript
	//carries it, so the mark's yaw is the goal for 1, 2 and 5 and the actor's
	//own facing is the goal for 0 and for the already-snapped 4.
	if (s >= 0)
	{
		if (script->ai_moveto == HLAI_MOVE_NONE ||
			script->ai_moveto == HLAI_MOVE_INSTANT)
			hl_ai_mon[s].ideal_yaw = actor->angles[1];
		else
			hl_ai_mon[s].ideal_yaw = HLAngleNorm(script->angles[1]);
	}

	//m_iszIdle poses the actor now. The play take waits for the cue.
	//
	//Idle with no play (c0a0 flashlight knock): park start like Instant does.
	//Unnamed scripts otherwise leave start at 0 and BeginPlay → empty play →
	//CineDone releases the actor before the idle is held.
	if (script->ai_idle[0])
	{
		HLAICineSetSeq(t, script->ai_idle);

		if (s >= 0)
		{
			hl_ai_mon[s].activity = HLACT_IDLE;
			hl_ai_mon[s].act_seq  = actor->seq;
		}

		if (!script->ai_play[0])
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
	}
}

U0 HLAICineBeginPlay(I64 self)
{//TASK_WAIT_FOR_SCRIPT completing, schedule.cpp:522. m_iszPlay starts and
 //TASK_PLAY_SCRIPT waits it out. An empty m_iszPlay finishes the script here
 //(scripted.cpp:495): ten of the seventeen scripts in c0a0 carry none and
 //exist only to move an actor to a mark and fire the next link.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	t = hl_ai_cine[self].actor;

	if (t < 0 || !script->ai_play[0])
	{
		HLAICineDone(self);
		return;
	}

	HLAICineSetSeq(t, script->ai_play);

	hl_ai_cine[self].state = HLSS_PLAYING;
	script->toggle_state   = HLTS_GOING_UP;

	HLAICineLog(self, "play", 0.0, 0.0);

	actor = HLEntGet(t);
	s     = hl_ai_mon_of[t];

	//StartTask(TASK_PLAY_SCRIPT), schedule.cpp:1266-1271. The take owns the
	//actor's origin for its duration, so the engine must not: MOVETYPE_FLY
	//takes SV_Physics_Step's gravity and ground friction off it, and the
	//FL_ONGROUND clear that follows stops the ground snap re-applying them.
	//CineCleanup puts m_saved_movetype back, scripted.cpp:805, which
	//HLAICineRelease already does from hl_ai_cine[self].movetype.
	//
	//Bookkeeping in this port rather than behaviour: no physics pass reads a
	//monster's movetype here - the only readers of the field are the PUSH
	//tests in HLEntity.ZC:12515 and :13141 - and there is no entity flags
	//word, so the ClearBits(pev->flags, FL_ONGROUND) half has nothing to
	//clear. 282 of the 512 scripted_sequence and aiscripted_sequence entities
	//in valve/maps carry an m_iszPlay and reach this path.
	if (actor)
		actor->movetype = HLMOVETYPE_FLY;

	//the end is scheduled off the sequence duration rather than watched on the
	//renderer's cycle: the renderer does not run for an off-screen actor and
	//the script still has to complete
	script->pain_finished = hl_ent_time;

	if (actor && actor->studio)
		script->pain_finished += HLStudioSeqDuration(actor->studio, actor->seq);

	//the take is the script's, not an activity. Leaving m_Activity on WALK
	//would let the next HLAISetActivity call decide it is already playing.
	if (s >= 0)
		hl_ai_mon[s].activity = HLACT_IDLE;
}

U0 HLAICineActorTick(I64 s, F64 dt)
{//tlScriptedWalk, tlScriptedRun and tlScriptedWait as one state machine. Runs
 //in place of the AI think for a monster a script holds.
	CHLEntity	*actor = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*script;
	CHLMonInfo	*mi;
	F64			 aim[3];
	F64			 speed;
	F64			 left;
	I64			 self;
	I64			 st;
	I64			 moved;

	if (!actor || hl_ai_mon[s].ent < 0 || hl_ai_mon[s].ent >= HLENT_MAX)
		return;

	self = hl_ai_cine[hl_ai_mon[s].ent].owner;

	if (self < 0)
		return;

	script = HLEntGet(self);

	if (!script)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	st = hl_ai_cine[self].state;

	//CineCleanup's deadflag branch, scripted.cpp:818: an actor killed on its
	//way to the mark leaves the script. One killed during the play take does
	//not - a scripted death is a take like any other and runs to its end.
	if (st != HLSS_PLAYING && actor->health <= 0.0)
	{
		HLAICineDone(self);
		return;
	}

	if (st == HLSS_WALK_TO_MARK || st == HLSS_RUN_TO_MARK)
	{
		//TASK_WALK_TO_TARGET / TASK_RUN_TO_TARGET at TARGET_MOVE_SCRIPTED, then
		//TASK_WAIT_FOR_MOVEMENT. No node graph, so the route is straight at the
		//mark with the mover's one wall slide.
		speed = mi->walk_speed;

		if (st == HLSS_RUN_TO_MARK)
			speed = mi->run_speed;

		hl_ai_mon[s].have_goal     = TRUE;
		hl_ai_mon[s].goal_is_enemy = FALSE;
		hl_ai_mon[s].goal_tol      = 8.0;
		hl_ai_mon[s].move_speed    = speed;

		//the mark does not move, so a triangulated apex stays valid until the
		//actor reaches it. This block runs every tick and must not clear it
		HLVecCopy(script->origin, hl_ai_mon[s].goal);

		if (st == HLSS_WALK_TO_MARK)
			HLAISetActivity(s, HLACT_WALK);
		else
			HLAISetActivity(s, HLACT_RUN);

		HLAITurnToward(s, HLAIYawTo(actor->origin, script->origin), dt);

		moved = HLAIMoveStep(s, speed, dt);

		if (moved == HLAI_MOVE_OK)
		{
			hl_ai_cine[self].blocked = 0.0;
			return;
		}

		HLVecSub(script->origin, actor->origin, aim);
		left = HLVecLength(aim);

		if (moved == HLAI_MOVE_BLOCKED)
		{
			//TaskFail, monsters.cpp:1917. In MONSTERSTATE_SCRIPT that reselects
			//SCHED_AISCRIPT and gets slWalkToScript straight back, so the walk
			//restarts: the SDK never places an actor that failed to route.
			//Reproduced by dropping the detour and the stuck timer and letting
			//this block run again next tick.
			hl_ai_mon[s].have_detour     = FALSE;
			HLAIRouteClear(s);
			hl_ai_mon[s].stuck_since     = 0.0;
			hl_ai_mon[s].next_move_check = 0.0;

			if (hl_ai_cine[self].blocked == 0.0)
			{
				hl_ai_cine[self].blocked = hl_ent_time;

				HLAICineLog(self, "blocked", left, 0.0);
			}

			//the retry is bounded: with no node graph a line the mover cannot
			//walk never opens, and the group's DelayStart count never falls
			if (hl_ent_time - hl_ai_cine[self].blocked < HLAI_CINE_WALK_GIVEUP)
				return;

			HLAICineLog(self, "giveup", left,
				hl_ent_time - hl_ai_cine[self].blocked);
		}
		else
			HLAICineLog(self, "arrived", left, 0.0);

		hl_ai_cine[self].blocked = 0.0;

		//TASK_PLANT_ON_SCRIPT, schedule.cpp:1279. Reached only on arrival in the
		//SDK; reached here on a give-up as well, and that case moves the actor a
		//visible distance rather than the last few units, so the pose it left
		//behind is dropped with it
		if (left > 8.0)
			HLStudioLatchInvalidate(hl_ai_mon[s].ent);

		HLVecCopy(script->origin, actor->origin);
		HLEntSetAbsBox(actor);

		hl_ai_mon[s].have_goal = FALSE;

		//TASK_FACE_SCRIPT then TASK_FACE_IDEAL. The turn is instant: the actor
		//is standing on the mark and the wait below has nothing to turn during.
		hl_ai_mon[s].ideal_yaw = HLAngleNorm(script->angles[1]);
		actor->angles[1]       = hl_ai_mon[s].ideal_yaw;

		if (script->ai_idle[0])
			HLAICineSetSeq(hl_ai_mon[s].ent, script->ai_idle);
		else
			HLAISetActivity(s, HLACT_IDLE);

		//TASK_ENABLE_SCRIPT: one fewer actor still walking
		hl_ai_cine[self].state = HLSS_WAIT;

		HLAICineDelayStart(self, 0);

		return;
	}

	if (st == HLSS_WAIT)
	{
		//TASK_WAIT_FOR_SCRIPT, schedule.cpp:1251
		if (!script->ai_idle[0])
			HLAISetActivity(s, HLACT_IDLE);
		else if (!StrICompare(script->ai_idle, script->ai_play))
			//pev->framerate = 0 when idle and play name the same take: frame 0
			//is held until the cue. scripted.cpp:384
			actor->anim_start = hl_ent_time;

		HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, dt);

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
			HLAICineBeginPlay(self);

		return;
	}

	//HLSS_PLAYING is TASK_PLAY_SCRIPT: nothing to do but hold still. The take
	//running out is noticed on the script's own clock in HLAICineTick, so an
	//actor with no AI slot reaches the end the same way this one does.
}

U0 HLAICineTick(I64 self)
{//one scripted_sequence, one tick: Spawn, Use, CineThink and the end of
 //TASK_PLAY_SCRIPT. The actor's half is HLAICineActorTick when it has an AI
 //slot; an actor without one is driven entirely from here.
	CHLEntity	*script = HLEntGet(self);
	CHLEntity	*actor;
	I64			 t;
	I64			 s;

	if (!script)
		return;

	//CCineMonster::Spawn, scripted.cpp:143. A script with no targetname, or
	//one naming an idle take, thinks a second after the map loads and takes its
	//actor then; a named script parks m_startTime until it is used.
	if (hl_ai_cine[self].retry == 0.0)
	{
		if (!script->targetname[0] || script->ai_idle[0])
			hl_ai_cine[self].retry = hl_ent_time + 1.0;
		else
			hl_ai_cine[self].retry = -1.0;

		if (script->targetname[0])
			hl_ai_cine[self].start = hl_ent_time + HLAI_CINE_NEVER;
		else
			hl_ai_cine[self].start = 0.0;
	}

	t = hl_ai_cine[self].actor;

	//--- the cue, posted by the dispatcher in HLEntity.ZC ---
	if (script->toggle_state == HLTS_GOING_DOWN)
	{
		script->toggle_state = HLTS_AT_BOTTOM;

		//CCineMonster::Use, scripted.cpp:181. An actor already in hand needs
		//only its start time brought forward; otherwise think now and find one.
		if (t >= 0)
			hl_ai_cine[self].start = hl_ent_time + 0.05;
		else
			hl_ai_cine[self].retry = hl_ent_time;
	}

	if (script->toggle_state == HLTS_AT_TOP)
		return;

	//--- CineThink ---
	if (t < 0)
	{
		if (hl_ai_cine[self].retry >= 0.0 &&
			hl_ent_time >= hl_ai_cine[self].retry)
			HLAICinePossess(self);

		return;
	}

	//--- an actor with no AI slot ---
	s = hl_ai_mon_of[t];

	if (s < 0 && hl_ai_cine[self].state == HLSS_WAIT)
	{
		if (script->ai_idle[0] &&
			!StrICompare(script->ai_idle, script->ai_play))
		{
			actor = HLEntGet(t);

			if (actor)
				actor->anim_start = hl_ent_time;
		}

		if (hl_ai_cine[self].delay <= 0 &&
			hl_ent_time >= hl_ai_cine[self].start)
			HLAICineBeginPlay(self);
	}

	//--- TASK_PLAY_SCRIPT: the take has run out ---
	if (hl_ai_cine[self].state == HLSS_PLAYING &&
		hl_ent_time >= script->pain_finished)
		HLAICineDone(self);
}

//--- CTalkMonster -----------------------------------------------------------
//
// dlls/talkmonster.cpp. The behaviour layer over CBaseMonster that scientists
// and barneys carry: greetings, idle conversation, the head turn towards
// whoever is speaking, and the follow system the retinal-scanner puzzles need.
//
// The port has no condition bits and no per-monster GetSchedule override, so
// the talk stack CTalkMonster::GetScheduleOfType(SCHED_IDLE_STAND) runs
// (talkmonster.cpp:1233-1290) is driven from the think instead, the same place
// this port already drives IdleSound from. The order of the tests is the SDK's.

//TALKRANGE_MIN, talkmonster.h:26
#define HLAI_TALKRANGE_MIN	500.0
//TLK_STARE_DIST, talkmonster.h:28
#define HLAI_TLK_STARE_DIST	128.0

//TALKGROUPNAMES, talkmonster.h:41-62
#define HLTLK_ANSWER		0
#define HLTLK_QUESTION		1
#define HLTLK_IDLE			2
#define HLTLK_STARE			3
#define HLTLK_USE			4
#define HLTLK_UNUSE			5
#define HLTLK_STOP			6
#define HLTLK_NOSHOOT		7
#define HLTLK_HELLO			8
#define HLTLK_PHELLO		9
#define HLTLK_PIDLE			10
#define HLTLK_PQUESTION		11
#define HLTLK_PLHURT1		12
#define HLTLK_PLHURT2		13
#define HLTLK_PLHURT3		14
#define HLTLK_SMELL			15
#define HLTLK_WOUND			16
#define HLTLK_MORTAL		17
#define HLTLK_CGROUPS		18

//longest shipped group name is SC_PQUEST at nine characters
#define HLAI_TLK_NAME		16

//SF_MONSTER_GAG and SF_MONSTER_PREDISASTER, monsters.h:45 and :52
#define HLAI_SF_MONSTER_GAG			2
#define HLAI_SF_PREDISASTER			256

//SF_SENTENCE_*, scripted.cpp:954-957
#define HLAI_SF_SENTENCE_ONCE		1
#define HLAI_SF_SENTENCE_FOLLOWERS	2
#define HLAI_SF_SENTENCE_INTERRUPT	4
#define HLAI_SF_SENTENCE_CONCURRENT	8

//radius UTIL_FindEntityGeneric uses for a listener named "player",
//scripted.cpp:1200
#define HLAI_SENTENCE_PLAYER_RADIUS	4096.0

Bool HLAITalkLineClear(F64 *from, F64 *to)
{//a point trace with nothing in the way, as FindNearestFriend's
 //UTIL_TraceLine(ignore_monsters) is
	CHLTrace	tr;
	F64			 zero[3];

	if (!hl_map)
		return FALSE;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLTraceEntity(hl_map, from, to, zero, zero, 0, TRUE, &tr);

	return ToBool(tr.fraction >= 1.0);
}

//one flat block at a fixed stride: a U8* table of string literals collapses to
//a single entry on this compiler
U8	hl_ai_tlk_grp[HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME];

U0 HLAITalkSetGrp(I64 kind, I64 which, U8 *name)
{
	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return;

	HLStrCopy(&hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME],
		name, HLAI_TLK_NAME);
}

U8 *HLAITalkGrp(I64 kind, I64 which)
{//m_szGrp[which] for a monster kind, or NULL where the SDK leaves it NULL
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT)
		return NULL;

	if (which < 0 || which >= HLTLK_CGROUPS)
		return NULL;

	p = &hl_ai_tlk_grp[(kind * HLTLK_CGROUPS + which) * HLAI_TLK_NAME];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAITalkGroupsInit()
{//CScientist::TalkInit, scientist.cpp:738-758 and CBarney::TalkInit,
 //barney.cpp:462-484. A leading ! names one sentence rather than a group;
 //SC_CUREA and its siblings carry no trailing number and so form no group.
	I64 i;

	for (i = 0; i < HLMON_COUNT * HLTLK_CGROUPS * HLAI_TLK_NAME; i++)
		hl_ai_tlk_grp[i] = 0;

	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_ANSWER,    "SC_ANSWER");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_QUESTION,  "SC_QUESTION");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_IDLE,      "SC_IDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STARE,     "SC_STARE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_USE,       "SC_OK");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_UNUSE,     "SC_WAIT");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_STOP,      "SC_STOP");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_NOSHOOT,   "SC_SCARED");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_HELLO,     "SC_HELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PHELLO,    "SC_PHELLO");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PIDLE,     "SC_PIDLE");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PQUESTION, "SC_PQUEST");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT1,   "!SC_CUREA");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT2,   "!SC_CUREB");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_PLHURT3,   "!SC_CUREC");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_SMELL,     "SC_SMELL");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_WOUND,     "SC_WOUND");
	HLAITalkSetGrp(HLMON_SCIENTIST, HLTLK_MORTAL,    "SC_MORTAL");

	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_ANSWER,    "BA_ANSWER");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_QUESTION,  "BA_QUESTION");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_IDLE,      "BA_IDLE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STARE,     "BA_STARE");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_USE,       "BA_OK");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_UNUSE,     "BA_WAIT");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_STOP,      "BA_STOP");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_NOSHOOT,   "BA_SCARED");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_HELLO,     "BA_HELLO");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PQUESTION, "BA_PQUEST");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT1,   "!BA_CUREA");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT2,   "!BA_CUREB");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_PLHURT3,   "!BA_CUREC");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_SMELL,     "BA_SMELL");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_WOUND,     "BA_WOUND");
	HLAITalkSetGrp(HLMON_BARNEY, HLTLK_MORTAL,    "BA_MORTAL");

	//barney has no pre-disaster hello or idle group; the SDK leaves both NULL
}

//top-level: static data, so once is enough and a map change does not disturb it
HLAITalkGroupsInit;

I64 HLAITalkKindOf(I64 ent)
{//which m_szGrp table an entity speaks from, or -1 for a monster that does not
 //talk. monster_sitting_scientist is its own class over the scientist's groups
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return -1;

	e = HLEntGet(ent);

	if (!e)
		return -1;

	if (!StrCompare(e->classname, "monster_sitting_scientist"))
		return HLMON_SCIENTIST;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return -1;

	if (hl_ai_mon[s].kind == HLMON_SCIENTIST ||
		hl_ai_mon[s].kind == HLMON_BARNEY)
		return hl_ai_mon[s].kind;

	return -1;
}

U0 HLAITalkEnsure(I64 ent)
{//CTalkMonster::TalkInit plus the per-head voice pitch CScientist::Spawn picks,
 //scientist.cpp:764-767. Lazy rather than called from Spawn: HLEntity.ZC
 //compiles first and cannot reach this table.
	CHLEntity	*e;
	I64			 head;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (hl_ai_talk[ent].inited)
		return;

	hl_ai_talk[ent].inited      = TRUE;
	hl_ai_talk[ent].voice_pitch = HLPITCH_NORM;

	e = HLEntGet(ent);

	if (!e)
		return;

	//a talker carried across a changelevel resumes following. follow_player is
	//this file's own mirror, set by StartFollowing and copied through the
	//carry record in HLEntity.ZC
	if (e->follow_player)
	{
		hl_ai_talk[ent].follow      = HLTLK_PLAYER;
		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	}

	if (HLAITalkKindOf(ent) != HLMON_SCIENTIST)
		return;

	//pev->body indexes the head: 0 glasses, 1 einstein, 2 luther, 3 slick.
	//NUM_SCIENTIST_HEADS is 4 and the needle bodygroup adds a multiple of it
	head = e->body % 4;

	if (head == 0)
		hl_ai_talk[ent].voice_pitch = 105;

	if (head == 2)
		hl_ai_talk[ent].voice_pitch = 95;
}

I64 HLAITalkPitch(I64 ent)
{//GetVoicePitch, talkmonster.cpp:872: m_voicePitch plus 0..3
	HLAITalkEnsure(ent);

	if (ent < 0 || ent >= HLENT_MAX)
		return HLPITCH_NORM;

	return hl_ai_talk[ent].voice_pitch + HLPartRandI(4);
}

Bool HLAITalkIsTalking(I64 ent)
{//IsTalking, talkmonster.cpp:1310
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	if (hl_ai_talk[ent].stop_talk > hl_ent_time)
		return TRUE;

	//m_flStopTalkTime is an estimate: HLAITalkTalk is given three seconds when
	//the caller has no duration. The word scheduler knows when the line
	//actually ends, so a sentence still running holds the flag past it.
	return HLAISentenceTalking(ent);
}

U0 HLAITalkTalk(I64 ent, F64 duration)
{//Talk, talkmonster.cpp:1218. A line with no duration is assumed to run three
 //seconds
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (duration <= 0.0)
		hl_ai_talk[ent].stop_talk = hl_ent_time + 3.0;
	else
		hl_ai_talk[ent].stop_talk = hl_ent_time + duration;
}

Bool HLAITalkOk(I64 ent)
{//FOkToSpeak, talkmonster.cpp:913. The PVS test has no counterpart here - the
 //player's leaf is not tracked server-side - so the visibility part of it is
 //left to the callers that already trace.
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	//g_talkWaitTime: somebody else has the floor
	if (hl_ent_time <= hl_ai_talk_wait)
		return FALSE;

	if (e->spawnflags & HLAI_SF_MONSTER_GAG)
		return FALSE;

	s = hl_ai_mon_of[ent];

	if (s >= 0)
	{
		if (hl_ai_mon[s].state == HLMSTATE_DEAD)
			return FALSE;

		//MONSTERSTATE_PRONE, talkmonster.cpp:914: hanging from a barnacle
		//tongue silences the idle stack. barn_host is this port's PRONE
		if (hl_ai_mon[s].barn_host >= 0)
			return FALSE;

		//don't talk if you're in combat
		if (hl_ai_mon[s].have_enemy &&
			hl_ai_mon[s].state == HLMSTATE_COMBAT)
			return FALSE;
	}

	return TRUE;
}

Bool HLAITalkPlaySentence(I64 ent, U8 *group, F64 duration, F64 volume,
	F64 atten)
{//PlaySentence, talkmonster.cpp:1206. g_talkWaitTime is pushed out past the
 //line plus two seconds, which is the gap between one character finishing and
 //the next being allowed to start.
	CHLEntity *e;

	if (!group || !group[0])
		return FALSE;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	HLAITalkEnsure(ent);
	HLAITalkTalk(ent, duration);

	hl_ai_talk_wait = hl_ent_time + duration + 2.0;

	//saying anything at all counts as having greeted the player
	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return HLAISentencePlay(group, ent, e->origin, volume, atten,
		HLAITalkPitch(ent));
}

Bool HLAITalkIsFriendClass(U8 *classname)
{//m_szFriends, talkmonster.cpp:53-58
	if (!StrCompare(classname, "monster_barney"))
		return TRUE;

	if (!StrCompare(classname, "monster_scientist"))
		return TRUE;

	return ToBool(!StrCompare(classname, "monster_sitting_scientist"));
}

U0 HLAITalkShutUpFriends(I64 ent)
{//ShutUpFriends, talkmonster.cpp:704. Every friend in the map stops mid-word
 //so one scripted line is heard clean.
	I64 i;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatsu_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatsu_next;

		if (hl_entities[i].health <= 0.0)
			goto qatsu_next;

		HLAISentenceStop(i);

		if (i < HLENT_MAX)
			hl_ai_talk[i].stop_talk = 0.0;

qatsu_next:
	}
}

I64 HLAITalkNearestFriend(I64 ent, Bool want_player)
{//FindNearestFriend, talkmonster.cpp:802. The trace runs from the top of one
 //bounding box to the top of the other, which is what lets two characters see
 //each other over a desk.
	CHLEntity	*e;
	CHLEntity	*f;
	F64			 start[3];
	F64			 check[3];
	F64			 d[3];
	F64			 dist;
	F64			 best  = HLAI_TALKRANGE_MIN;
	I64			 found = HLTLK_NOBODY;
	I64			 i;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return HLTLK_NOBODY;

	e = HLEntGet(ent);

	if (!e)
		return HLTLK_NOBODY;

	HLVecCopy(e->origin, start);
	start[2] = e->absmax[2];

	if (want_player)
	{
		if (!HLAITalkPointOf(HLTLK_PLAYER, check))
			return HLTLK_NOBODY;

		//the listener eye, not the feet: FindNearestFriend raises the check
		//point to the target's absmax
		HLVecCopy(hl_snd_listener, check);
		HLVecSub(start, check, d);

		if (HLVecLength(d) >= HLAI_TALKRANGE_MIN)
			return HLTLK_NOBODY;

		if (!HLAITalkLineClear(start, check))
			return HLTLK_NOBODY;

		return HLTLK_PLAYER;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (i == ent || !hl_entities[i].in_use)
			goto qatnf_next;

		f = &hl_entities[i];

		if (!HLAITalkIsFriendClass(f->classname))
			goto qatnf_next;

		//don't talk to self or dead people
		if (f->health <= 0.0)
			goto qatnf_next;

		s = -1;

		if (i < HLENT_MAX)
			s = hl_ai_mon_of[i];

		//in a script or prone: not available to be spoken to
		if (s >= 0 && (hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
			hl_ai_mon[s].state == HLMSTATE_DEAD))
			goto qatnf_next;

		HLVecCopy(f->origin, check);
		check[2] = f->absmax[2];

		HLVecSub(start, check, d);
		dist = HLVecLength(d);

		if (dist >= best)
			goto qatnf_next;

		if (!HLAITalkLineClear(start, check))
			goto qatnf_next;

		found = i;
		best  = dist;

qatnf_next:
	}

	return found;
}

U0 HLAITalkHeadTurn(I64 ent, F64 *point, F64 limit = HLAI_TLK_HEAD_MAX)
{//IdleHeadTurn, talkmonster.cpp:1007. Controller 0 is the head yaw, in degrees
 //off the body's own yaw.
 //
 //SetBoneController maps through the controller's start and end: raw 0 is the
 //START of the range, not the middle, so writing the angle straight into
 //pev->controller aims scientist.mdl's head at -60 degrees and the character
 //stares sideways. HLStudioCtlSetting is that mapping.
 //
 //limit is the envelope the caller can absorb elsewhere. The SDK leans on
 //TASK_TLK_IDEALYAW turning the body first and lets the engine clamp what is
 //left; here the body turn is best effort, so the head is bounded at the write
 //site as well
	CHLEntity	*e;
	F64			 yaw;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	//HLAIYawDiff is the signed shortest arc, which is the SDK's fold to
	//[-180, 180]. HLAngleNorm folds to [0, 360) and would put every head hard
	//over one way
	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	if (yaw > limit)
		yaw = limit;

	if (yaw < -limit)
		yaw = -limit;

	hl_ai_talk[ent].head_turn = yaw;

	setting = HLStudioCtlSetting(e->studio, 0, yaw);

	//the model carries no such controller
	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkHeadSet(I64 ent, F64 degrees)
{//TASK_TLK_HEADRESET and CSittingScientist's m_headTurn, both of which set the
 //controller from an angle rather than from a point
	CHLEntity	*e;
	F64			 setting;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e || !e->studio)
		return;

	hl_ai_talk[ent].head_turn = degrees;

	setting = HLStudioCtlSetting(e->studio, 0, degrees);

	if (setting < 0.0)
		return;

	e->controllers[0] = setting;
}

U0 HLAITalkFaceTarget(I64 ent, Bool reset_when_done = TRUE,
	F64 limit = HLAI_TLK_HEAD_MAX)
{//the head half of TASK_TLK_EYECONTACT: hold the head on whoever is being
 //spoken to for as long as the line runs, then TASK_TLK_HEADRESET.
 //
 //CSittingScientist drives the controller from m_headTurn on its own think and
 //must not have it centred here, so it asks for no reset.
	F64 point[3];

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (!HLAITalkIsTalking(ent))
	{
		if (reset_when_done && hl_ai_talk[ent].head_turn != 0.0)
			HLAITalkHeadSet(ent, 0.0);

		return;
	}

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	//the listener's eye rather than its feet, so a head does not aim at a floor
	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	HLAITalkHeadTurn(ent, point, limit);
}

U0 HLAITalkSetAnswer(I64 listener, I64 speaker)
{//SetAnswerQuestion, talkmonster.cpp:1226, and the sitting override at
 //scientist.cpp:1398. A question makes the listener owe an answer.
	if (listener < 0 || listener >= HLENT_MAX)
		return;

	hl_ai_talk[listener].talk_target = speaker;

	//CSittingScientist waits three to four seconds; a standing one answers on
	//its own idle schedule, which the response delay stands in for here
	hl_ai_talk[listener].response = hl_ent_time + 3.5 + HLPartRand(0.5);
}

Bool HLAITalkIdleRespond(I64 ent)
{//IdleRespond, talkmonster.cpp:905
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return FALSE;

	return HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_ANSWER),
		3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
}

Bool HLAITalkIdleHello(I64 ent)
{//FIdleHello, talkmonster.cpp:974. Greets the player once, and only when the
 //player is inside the view cone and visible.
	CHLEntity	*e;
	F64			 point[3];
	I64			 kind;
	I64			 s;
	U8			*grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (HLAITalkNearestFriend(ent, TRUE) != HLTLK_PLAYER)
		return FALSE;

	HLVecCopy(hl_snd_listener, point);

	s = hl_ai_mon_of[ent];

	//FInViewCone. A sitting scientist takes no AI slot and so has no cone;
	//the SDK gives it m_flFieldOfView from CScientist::Spawn either way
	if (s >= 0 && !HLAIInViewCone(s, point))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

	grp = HLAITalkGrp(kind, HLTLK_HELLO);

	if (e->spawnflags & HLAI_SF_PREDISASTER)
		grp = HLAITalkGrp(kind, HLTLK_PHELLO);

	if (!HLAITalkPlaySentence(ent, grp, 3.25 + HLPartRand(0.25), 1.0,
		HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;

	return TRUE;
}

Bool HLAITalkIdleStare(I64 ent)
{//FIdleStare, talkmonster.cpp:959
	I64 kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	if (!HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_STARE),
		6.25 + HLPartRand(1.25), 1.0, HLATTN_IDLE))
		return FALSE;

	hl_ai_talk[ent].talk_target = HLAITalkNearestFriend(ent, TRUE);

	return TRUE;
}

Bool HLAITalkIdleSpeak(I64 ent)
{//FIdleSpeak, talkmonster.cpp:1026. Ask a question of a nearby friend, comment
 //on the player's wounds, or make a statement - in that order.
	CHLEntity	*e;
	F64			 duration;
	I64			 kind;
	I64			 other;
	U8			*idle_grp;
	U8			*quest_grp;

	kind = HLAITalkKindOf(ent);

	if (kind < 0 || !HLAITalkOk(ent))
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_PIDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_PQUESTION);
		duration  = 5.0 + HLPartRand(0.2);
	}
	else
	{
		idle_grp  = HLAITalkGrp(kind, HLTLK_IDLE);
		quest_grp = HLAITalkGrp(kind, HLTLK_QUESTION);
		duration  = 3.0 + HLPartRand(0.2);
	}

	//following a live player who is hurt: comment on it, worst wound first.
	//pev->max_health for a client is 100 and there is no per-client record
	//here, so the thresholds are against that figure
	if (hl_ai_talk[ent].follow == HLTLK_PLAYER && hl_ent_player >= 0 &&
		!hl_ent_player_dead)
	{
		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_HEAVY) &&
			hl_ent_player_health <= 100.0 / 8.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT3),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_HEAVY;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_MEDIUM) &&
			hl_ent_player_health <= 100.0 / 4.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT2),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_MEDIUM;
			return TRUE;
		}

		if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_DMG_LIGHT) &&
			hl_ent_player_health <= 100.0 / 2.0)
		{
			HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_PLHURT1),
				duration, 1.0, HLATTN_IDLE);
			hl_ai_talk[ent].bits_said |= HLTLK_SAID_DMG_LIGHT;
			return TRUE;
		}
	}

	//a friend within talking range answers three questions in four
	other = HLAITalkNearestFriend(ent, FALSE);

	if (other >= 0 && HLPartRandI(100) < 75)
	{
		if (HLAITalkPlaySentence(ent, quest_grp, duration, 1.0, HLATTN_IDLE))
		{
			hl_ai_talk[ent].talk_target = other;

			HLAITalkSetAnswer(other, ent);

			//the friend is held silent for as long as the question runs
			hl_ai_talk[other].stop_talk = hl_ai_talk[ent].stop_talk;

			hl_ai_talk[ent].n_speak++;

			return TRUE;
		}
	}

	//otherwise a statement, half the time, facing the player
	if (HLPartRandI(2))
	{
		other = HLAITalkNearestFriend(ent, TRUE);

		if (other != HLTLK_NOBODY)
		{
			if (HLAITalkPlaySentence(ent, idle_grp, duration, 1.0,
				HLATTN_IDLE))
			{
				hl_ai_talk[ent].talk_target = other;
				hl_ai_talk[ent].n_speak++;

				return TRUE;
			}
		}
	}

	//didn't speak: release the floor rather than holding it for the two
	//seconds PlaySentence would have added
	HLAITalkTalk(ent, 0.0);
	hl_ai_talk_wait = 0.0;

	return FALSE;
}

Bool HLAITalkCanPlaySentence(I64 ent, Bool disregard_state)
{//CTalkMonster::CanPlaySentence, talkmonster.cpp:949. Disregarding state means
 //anything not dead can be made to speak, which is CBaseMonster's own rule.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e)
		return FALSE;

	if (disregard_state)
		return ToBool(e->health > 0.0);

	return HLAITalkOk(ent);
}

//--- the follow system ------------------------------------------------------

Bool HLAITalkIsFollowing(I64 ent)
{//IsFollowing, talkmonster.h:142: a target that is the player
	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	return ToBool(hl_ai_talk[ent].follow == HLTLK_PLAYER);
}

Bool HLAITalkCanFollow(I64 ent)
{//CanFollow, talkmonster.cpp:1395
	CHLEntity	*e;
	I64			 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return FALSE;

	e = HLEntGet(ent);

	if (!e || e->health <= 0.0)
		return FALSE;

	s = hl_ai_mon_of[ent];

	//in a script that cannot be interrupted (CanInterrupt, scripted.cpp:654)
	if (s >= 0 && hl_ai_mon[s].state == HLMSTATE_SCRIPT)
	{
		if (hl_ai_cine[ent].owner < 0)
			return FALSE;

		if (!hl_ai_cine[hl_ai_cine[ent].owner].interrupt)
			return FALSE;
	}

	return ToBool(!HLAITalkIsFollowing(ent));
}

U0 HLAITalkStopFollowing(I64 ent, Bool clear_schedule)
{//StopFollowing, talkmonster.cpp:1364
	I64 kind;
	I64 s;

	if (!HLAITalkIsFollowing(ent))
		return;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_UNUSE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

		hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	}

	hl_ai_talk[ent].follow = HLTLK_NOBODY;
	hl_entities[ent].follow_player = FALSE;

	s = hl_ai_mon_of[ent];

	if (s < 0)
		return;

	//RouteClear: stop him from walking toward the player
	hl_ai_mon[s].have_goal  = FALSE;
	hl_ai_mon[s].move_speed = 0.0;

	if (clear_schedule)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}

	if (hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_COMBAT);
}

U0 HLAITalkStartFollowing(I64 ent)
{//StartFollowing, talkmonster.cpp:1383. Only the player leads.
	I64 kind;
	I64 s;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	//m_pCine->CancelScript
	if (hl_ai_cine[ent].owner >= 0)
		HLAICineRelease(hl_ai_cine[ent].owner);

	s = hl_ai_mon_of[ent];

	if (s >= 0 && hl_ai_mon[s].have_enemy)
		HLAISetState(s, HLMSTATE_ALERT);

	hl_ai_talk[ent].follow      = HLTLK_PLAYER;
	hl_ai_talk[ent].talk_target = HLTLK_PLAYER;
	hl_entities[ent].follow_player = TRUE;

	kind = HLAITalkKindOf(ent);

	if (kind >= 0)
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_USE),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);

	if (s >= 0)
	{
		hl_ai_mon[s].sched      = HLSCHED_NONE;
		hl_ai_mon[s].sched_done = TRUE;
	}
}

U0 HLAITalkLimitFollowers(I64 keep, I64 max_followers)
{//LimitFollowers, talkmonster.cpp:726. Everyone past the limit is dropped, so
 //the player leads one scientist rather than a parade.
	I64 count = 0;
	I64 i;

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		if (i == keep || !hl_entities[i].in_use)
			goto qatlf_next;

		if (!HLAITalkIsFriendClass(hl_entities[i].classname))
			goto qatlf_next;

		if (!HLAITalkIsFollowing(i))
			goto qatlf_next;

		count++;

		if (count > max_followers)
			HLAITalkStopFollowing(i, TRUE);

qatlf_next:
	}
}

U0 HLAITalkFollowerUse(I64 ent)
{//FollowerUse, talkmonster.cpp:1412. The +USE half of the follow system.
	CHLEntity *e;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	HLAITalkEnsure(ent);

	//no +USE during a scripted_sentence
	if (hl_ai_talk[ent].use_time > hl_ent_time)
		return;

	//pre-disaster followers can't be used. DeclineFollowing is the character's
	//own refusal line; CBarney has none, so only the scientist speaks
	if (e->spawnflags & HLAI_SF_PREDISASTER)
	{
		if (HLAITalkKindOf(ent) == HLMON_SCIENTIST)
		{
			HLAITalkTalk(ent, 10.0);
			HLAITalkPlaySentence(ent, "SC_POK", 2.0, 1.0, HLATTN_NORM);
		}

		return;
	}

	if (!HLAITalkCanFollow(ent))
	{
		HLAITalkStopFollowing(ent, TRUE);
		return;
	}

	HLAITalkLimitFollowers(ent, 1);
	HLAITalkStartFollowing(ent);

	//don't say hi after you've started following
	hl_ai_talk[ent].bits_said |= HLTLK_SAID_HELLO;
}

I64 HLAIFollowerUseInFront(F64 *player_org, F64 *forward)
{//the +use key against a talk monster. HLEntUseInFront in HLEntity.ZC only
 //considers classes with a use_fn and a monster has none, so the probe is
 //repeated here over the friend classes. Returns 1 when one was used.
 //
 //HL traces 64 units through CBasePlayer::PlayerUse; the box test here is the
 //same coarse probe HLEntUseInFront runs.
	CHLEntity	*e;
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 i;

	if (!hl_entities || !player_org || !forward)
		return 0;

	HLVecMA(player_org, 48.0, forward, probe);

	for (i = 0; i < 3; i++)
	{
		pmins[i] = probe[i] - 16.0;
		pmaxs[i] = probe[i] + 16.0;
	}

	for (i = 0; i < hl_num_entities && i < HLENT_MAX; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->health <= 0.0)
			goto qafu_next;

		if (!HLAITalkIsFriendClass(e->classname))
			goto qafu_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qafu_next;

		HLAITalkFollowerUse(i);

		return 1;

qafu_next:
	}

	return 0;
}

//--- scripted_sentence ------------------------------------------------------

U0 HLAITalkPlayScripted(I64 ent, U8 *sentence, F64 duration, F64 volume,
	F64 atten, Bool concurrent, I64 listener)
{//PlayScriptedSentence, talkmonster.cpp:1193. m_useTime blocks +USE for the
 //length of the line, so a scripted speech cannot be interrupted by walking up
 //and pressing use.
	if (ent < 0 || ent >= HLENT_MAX)
		return;

	if (!concurrent)
		HLAITalkShutUpFriends(ent);

	hl_ai_talk[ent].use_time    = hl_ent_time + duration;
	hl_ai_talk[ent].talk_target = listener;

	HLAITalkPlaySentence(ent, sentence, duration, volume, atten);
}

Bool HLAIAcceptableSpeaker(CHLEntity *script, I64 who)
{//CScriptedSentence::AcceptableSpeaker, scripted.cpp:1103
	Bool override;

	if (who < 0 || who >= HLENT_MAX)
		return FALSE;

	//not a monster: anything else the map points at can speak
	if (HLAITalkKindOf(who) < 0 && hl_ai_mon_of[who] < 0)
		return TRUE;

	//SF_SENTENCE_FOLLOWERS: only say it if the speaker is following the player
	if (script->spawnflags & HLAI_SF_SENTENCE_FOLLOWERS)
	{
		if (!HLAITalkIsFollowing(who))
			return FALSE;
	}

	override = ToBool(script->spawnflags & HLAI_SF_SENTENCE_INTERRUPT);

	return HLAITalkCanPlaySentence(who, override);
}

I64 HLAISentenceSpeaker(CHLEntity *script)
{//CScriptedSentence::FindEntity, scripted.cpp:1140, with AcceptableSpeaker
 //applied. The targetname pass walks every match rather than stopping at the
 //first, so a busy scientist does not veto the line for a free one.
	F64	d[3];
	I64	i;

	if (!script->ai_entity[0])
		return -1;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qass_next;

		if (StrICompare(hl_entities[i].targetname, script->ai_entity))
			goto qass_next;

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next:
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use || !hl_entities[i].studio)
			goto qass_next2;

		if (StrICompare(hl_entities[i].classname, script->ai_entity))
			goto qass_next2;

		//scripted_sentence spells the key lowercase "radius", scripted.cpp:995,
		//so it lands in e->radius, not e->ai_radius. Reading ai_radius here
		//discarded the authored figure on 197 of the 203 shipped sentences and
		//searched the whole map. UTIL_FindEntityInSphere has no zero case
		HLVecSub(hl_entities[i].origin, script->origin, d);

		if (HLVecLength(d) > script->radius)
			goto qass_next2;

		if (HLAIAcceptableSpeaker(script, i))
			return i;

qass_next2:
	}

	return -1;
}

I64 HLAISentenceListener(CHLEntity *script, I64 speaker)
{//the listener half of StartSentence, scripted.cpp:1197-1204, over
 //UTIL_FindEntityGeneric, util.cpp:552. The listener becomes m_hTalkTarget, so
 //it is what the speaker's head turns towards.
 //
 //The key lands in e->ai_listener, HLEnt.ZC:1522. 101 of the 203 shipped
 //sentences carry it, 12 of them naming a monster rather than the player.
 //
 //Order is the SDK's: targetname first and unbounded, then the nearest
 //classname match inside the radius. "player" raises the radius to 4096 and is
 //compared case-sensitively, as FStrEq is - two shipped sentences spell it
 //"Player" and find nobody in retail either.
	CHLEntity	*sp;
	F64			 d[3];
	F64			 radius;
	F64			 dist;
	F64			 best;
	I64			 found;
	I64			 i;

	sp = HLEntGet(speaker);

	if (!sp || !script->ai_listener[0])
		return HLTLK_NOBODY;

	radius = script->radius;

	if (!StrCompare(script->ai_listener, "player"))
		radius = HLAI_SENTENCE_PLAYER_RADIUS;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qasl_next;

		if (!StrCompare(hl_entities[i].targetname, script->ai_listener))
			return i;

qasl_next:
	}

	//the client is not in hl_entities, so the classname pass resolves it here
	if (!StrCompare(script->ai_listener, "player"))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			return HLTLK_NOBODY;

		HLVecSub(hl_snd_listener, sp->origin, d);

		if (HLVecLength(d) > radius)
			return HLTLK_NOBODY;

		return HLTLK_PLAYER;
	}

	found = HLTLK_NOBODY;
	best  = radius;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qasl2_next;

		if (StrCompare(hl_entities[i].classname, script->ai_listener))
			goto qasl2_next;

		HLVecSub(hl_entities[i].origin, sp->origin, d);
		dist = HLVecLength(d);

		if (dist >= best)
			goto qasl2_next;

		found = i;
		best  = dist;

qasl2_next:
	}

	return found;
}

F64 HLAISentenceAtten(I64 impulse)
{//CScriptedSentence::Spawn's attenuation switch, scripted.cpp:1046-1063. The
 //"attenuation" key lands in pev->impulse and is mapped once at spawn.
 //
 //132 of the 203 shipped sentences carry the key: 53 ask for ATTN_NONE, 27 for
 //ATTN_NORM, 25 for ATTN_STATIC
	if (impulse == 1)
		return HLATTN_STATIC;

	if (impulse == 2)
		return HLATTN_NORM;

	if (impulse == 3)
		return HLATTN_NONE;

	return HLATTN_IDLE;
}

//--- the idle talk driver ---------------------------------------------------

//how often a talker re-runs the stack. The SDK reaches it once per schedule
//selection, which for slIdleStand is a random wait of up to five seconds
#define HLAI_TALK_PERIOD	0.5

U0 HLAITalkIdealYaw(I64 s, F64 dt)
{//TASK_TLK_IDEALYAW, talkmonster.cpp:412-433, followed by TASK_FACE_IDEAL. Both
 //sit ahead of TASK_TLK_EYECONTACT in tlIdleSpeak and tlIdleResponse.
 //
 //The body turns until the listener is within HLAI_TLK_YAW_SLACK of its facing
 //and the head covers what is left. This is what keeps the head inside the
 //controller's range: with the body fixed, a listener 120 degrees round asks the
 //head for 120 and HLStudioCtlSetting pins it at 60.
 //
 //Recomputed per tick rather than latched into pev->ideal_yaw, so it stops of
 //its own accord once the slack is met.
	CHLEntity	*e;
	F64			 point[3];
	F64			 yaw;
	F64			 step;
	I64			 ent;

	if (s < 0)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	//a monster on a route, fighting, under a script or dead does not stand and
	//address anyone
	if (hl_ai_mon[s].have_goal ||
		hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (!HLAITalkIsTalking(ent))
		return;

	if (!HLAITalkPointOf(hl_ai_talk[ent].talk_target, point))
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	//the listener's eye, matching HLAITalkFaceTarget, so head and body aim at
	//one point
	if (hl_ai_talk[ent].talk_target == HLTLK_PLAYER)
		HLVecCopy(hl_snd_listener, point);

	yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

	//what the body owes past the slack
	if (yaw < 0.0)
	{
		yaw += HLAI_TLK_YAW_SLACK;

		if (yaw > 0.0)
			yaw = 0.0;
	}
	else
	{
		yaw -= HLAI_TLK_YAW_SLACK;

		if (yaw < 0.0)
			yaw = 0.0;
	}

	if (yaw == 0.0)
		return;

	step = HLAI_TLK_YAW_SPEED * dt;

	if (yaw < 0.0)
	{
		if (step > -yaw)
			step = -yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] - step);
	}
	else
	{
		if (step > yaw)
			step = yaw;

		e->angles[1] = HLAngleNorm(e->angles[1] + step);
	}
}

U0 HLAITalkThink(I64 s, F64 dt)
{//the talk stack CTalkMonster::GetScheduleOfType runs for SCHED_IDLE_STAND,
 //talkmonster.cpp:1233-1290, in the SDK's order. Driven from the think because
 //this port's selector is a table rather than a per-monster override.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 point[3];
	F64			 d[3];
	I64			 ent;
	I64			 kind;

	if (!e)
		return;

	ent = hl_ai_mon[s].ent;

	if (ent < 0 || ent >= HLENT_MAX)
		return;

	kind = HLAITalkKindOf(ent);

	if (kind < 0)
		return;

	HLAITalkEnsure(ent);

	//the body turn comes first: HLAITalkFaceTarget reads e->angles[1] and would
	//otherwise spend one tick on a stale facing
	HLAITalkIdealYaw(s, dt);

	//eye contact runs every tick, not on the talk cadence: a head that only
	//moves twice a second reads as a twitch
	HLAITalkFaceTarget(ent);

	//combat, script and death have their own speech
	if (hl_ai_mon[s].state == HLMSTATE_COMBAT ||
		hl_ai_mon[s].state == HLMSTATE_SCRIPT ||
		hl_ai_mon[s].state == HLMSTATE_DEAD)
		return;

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + HLAI_TALK_PERIOD;

	//an owed answer comes before anything this one might start
	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		hl_ai_talk[ent].response = 0.0;

		if (HLAITalkIdleRespond(ent))
			return;
	}

	//if never seen the player, try to greet him
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO))
	{
		if (HLAITalkIdleHello(ent))
			return;
	}

	//sustained light wounds
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_LIGHT) &&
		e->health <= e->max_health * 0.75)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_WOUND),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
		hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_LIGHT;
		return;
	}

	//sustained heavy wounds
	if (!(hl_ai_talk[ent].bits_said & HLTLK_SAID_WOUND_HEAVY) &&
		e->health <= e->max_health * 0.5)
	{
		HLAITalkPlaySentence(ent, HLAITalkGrp(kind, HLTLK_MORTAL),
			3.0 + HLPartRand(0.2), 1.0, HLATTN_IDLE);
		hl_ai_talk[ent].bits_said |= HLTLK_SAID_WOUND_HEAVY;
		return;
	}

	//talk about the world. The chance falls off with how much this one has
	//already said, which is what stops one character monologuing
	if (HLAITalkOk(ent) && !HLPartRandI(hl_ai_talk[ent].n_speak * 2 + 1))
	{
		if (HLAITalkIdleSpeak(ent))
			return;
	}

	//the player standing close gets a remark
	if (HLAITalkIsTalking(ent) || HLPartRandI(7))
		return;

	if (hl_ent_player < 0 || hl_ent_player_dead)
		return;

	HLVecCopy(hl_snd_listener, point);
	HLVecSub(point, e->origin, d);
	d[2] = 0.0;

	if (HLVecLength(d) >= HLAI_TLK_STARE_DIST)
		return;

	//Deviation: the SDK also requires the player to be facing the monster,
	//through UTIL_DotPoints on the client's v_forward. The view angles live in
	//HL1.ZC, which compiles later, so proximity inside the monster's own cone
	//stands in for it - the monster notices being loomed over, not being
	//looked at.
	if (!HLAIInViewCone(s, point))
		return;

	HLAITalkIdleStare(ent);
}

U0 HLAISitScientistThink(I64 ent)
{//CSittingScientist::SittingThink, scientist.cpp:1303. No AI slot, no routing
 //and no fighting: it sits, turns its head and speaks.
	CHLEntity	*e = HLEntGet(ent);
	F64			 point[3];
	F64			 floor[3];
	F64			 yaw;
	I64			 roll;
	I64			 who;

	if (!e || !e->studio || e->health <= 0.0)
		return;

	//a scripted_sequence holding this one owns its sequence
	if (ent < HLENT_MAX && hl_ai_cine[ent].owner >= 0)
		return;

	HLAITalkEnsure(ent);

	//--- settle on the seat ---
	//
	//CSittingScientist::Spawn's DROP_TO_FLOOR, scientist.cpp:1273, done on the
	//first think for the reason the monster settle is: HLEntity.ZC compiles
	//first and cannot reach the trace.
	//
	//The drop runs against UTIL_SetSize's (-14,-14,0)-(14,14,36), which is what
	//e->mins and e->maxs hold. Sequences 71 to 75 of scientist.mdl reach 35.07
	//below the origin and 22.48 above it, so the rendered figure hangs below
	//the traced box; that is retail's geometry, and the mapper authored the nine
	//shipped origins against it.
	if (ent < HLENT_MAX && !hl_ai_talk[ent].settled)
	{
		hl_ai_talk[ent].settled = TRUE;

		if (HLAIDropToFloorHard(e, e->mins, e->maxs, floor))
		{
			HLVecCopy(floor, e->origin);
			HLEntSetAbsBox(e);
		}
	}

	//eye contact is per tick; the rest is the SDK's own 0.1s think.
	//
	//Deviation: the SDK's sitting scientist turns its head once, at the moment
	//it asks a question, scientist.cpp:1436. Holding the head every tick with no
	//body to turn lets a listener standing behind it drive the controller onto
	//its rail, so the sitting envelope bounds it
	HLAITalkFaceTarget(ent, FALSE, HLAI_TLK_SIT_HEAD_MAX);

	if (hl_ent_time < hl_ai_talk[ent].next_think)
		return;

	hl_ai_talk[ent].next_think = hl_ent_time + 0.1;

	//try to greet the player
	if (HLAITalkIdleHello(ent))
	{
		who = HLAITalkNearestFriend(ent, TRUE);

		if (who != HLTLK_NOBODY && HLAITalkPointOf(who, point))
		{
			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			//the look takes are the turn; the controller goes back to centre
			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);

			HLAITalkHeadSet(ent, 0.0);
		}

		return;
	}

	//m_fSequenceFinished. StudioFrameAdvance raises it on a wrap as well as on
	//a one-shot ending, so a looping sitting take finishes once per pass
	if (hl_ent_time - e->anim_start <
		HLStudioSeqDuration(e->studio, e->seq))
		return;

	roll = HLPartRandI(100);

	hl_ai_talk[ent].head_turn = 0.0;

	if (hl_ai_talk[ent].response > 0.0 &&
		hl_ent_time > hl_ai_talk[ent].response)
	{
		//respond to a question
		HLAITalkIdleRespond(ent);
		HLAISetSequence(e, "sitscared", FALSE);
		hl_ai_talk[ent].response = 0.0;
	}
	else if (roll < 30)
	{
		if (hl_ai_talk[ent].bits_said & HLTLK_SAID_HELLO)
			who = HLAITalkNearestFriend(ent, FALSE);
		else
			who = HLAITalkNearestFriend(ent, TRUE);

		if (!HLAITalkIdleSpeak(ent) || who == HLTLK_NOBODY)
		{
			//RANDOM_LONG(0,8) * 10 - 40: nine steps of ten degrees, centred
			hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;
			HLAISetSequence(e, "sitting3", FALSE);
		}
		else
		{
			//only turn the head if we spoke
			HLAITalkPointOf(who, point);

			if (who == HLTLK_PLAYER)
				HLVecCopy(hl_snd_listener, point);

			yaw = HLAIYawDiff(HLAIYawTo(e->origin, point), e->angles[1]);

			if (yaw > 0.0)
				HLAISetSequence(e, "sitlookleft", FALSE);
			else
				HLAISetSequence(e, "sitlookright", FALSE);
		}
	}
	else if (roll < 60)
	{
		HLAISetSequence(e, "sitting3", FALSE);
		hl_ai_talk[ent].head_turn = ToF64(HLPartRandI(9)) * 10.0 - 40.0;

		if (HLPartRandI(100) < 5)
			HLAITalkIdleSpeak(ent);
	}
	else if (roll < 80)
		HLAISetSequence(e, "sitting2", FALSE);
	else
		HLAISetSequence(e, "sitscared", FALSE);

	HLAITalkHeadSet(ent, hl_ai_talk[ent].head_turn);
}

//--- monster_barnacle -------------------------------------------------------
//
// dlls/barnacle.cpp. CBarnacle derives from CBaseMonster and uses none of it:
// no schedule, no task list, no route. BarnacleThink (barnacle.cpp:143) traces
// straight down, grows the tongue to the first surface, grabs the first live
// thing standing under it, hoists it and eats it.
//
// The victim half already exists - HLACT_BARN_HIT/PULL/CHOMP/CHEW, the
// scientist, barney and hgrunt sequence rows, and slBarnacleVictimGrab and
// slBarnacleVictimChomp - and was unreachable until now.
//
// Deviation: the player is not a candidate. FBecomeProne on CBasePlayer sets
// PFLAG_ONBARNACLE (player.cpp:4358) and the lift then runs through player
// movement, which lives in HL1.ZC and compiles after this file. Only tracked
// monsters are eaten.
//
// Deviation: CBarnacle::TakeDamage turns any DMG_CLUB hit into a kill
// (barnacle.cpp:131) - one crowbar swing. HLEntTakeDamage is in HLEntity.ZC
// and carries no hook, so a crowbar does its own damage instead.

U0 HLAIBarnacleChew(I64 s)
{//one of the three chew takes on CHAN_WEAPON, barnacle.cpp:222-227
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 roll;

	if (!e)
		return;

	roll = HLPartRandI(3);

	if (roll == 0)
		HLSndPlayAt("barnacle/bcl_chew1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else if (roll == 1)
		HLSndPlayAt("barnacle/bcl_chew2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else
		HLSndPlayAt("barnacle/bcl_chew3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
}

U0 HLAIBarnacleRelease(I64 s)
{//BarnacleVictimReleased, monsters.cpp:187: the victim goes back to MOVETYPE_
 //STEP and MONSTERSTATE_IDLE, and the barnacle back to fishing
	CHLEntity	*ve;
	I64			 v = hl_ai_mon[s].barn_prey;

	hl_ai_mon[s].barn_prey    = -1;
	hl_ai_mon[s].barn_lifting = FALSE;
	hl_ai_mon[s].barn_kill    = -1.0;
	hl_ai_mon[s].barn_adj     = HLBARN_ADJ_IDLE;

	if (v < 0 || v >= hl_ai_mon_count)
		return;

	hl_ai_mon[v].barn_host = -1;

	ve = HLEntGet(hl_ai_mon[v].ent);

	if (ve)
		ve->movetype = HLMOVETYPE_STEP;

	//SetState drops the schedule, so the victim leaves slBarnacleVictimGrab
	//instead of hanging on its TASK_WAIT_INDEFINITE forever
	if (hl_ai_mon[v].state != HLMSTATE_DEAD)
		HLAISetState(v, HLMSTATE_IDLE);

	//the pull take is a loop; the victim needs a pose it can stand in
	hl_ai_mon[v].settled = FALSE;
}

I64 HLAIBarnacleTouch(I64 s, F64 *_len)
{//TongueTouchEnt, barnacle.cpp:393. One point trace down for the length the
 //tongue may hang to, then the first hostile whose box stands in that column.
 //
 //Deviation: UTIL_EntitiesInBox walks the engine's area list; the candidates
 //here are the tracked monsters, the same set HLAILook draws from. The player
 //is excluded - see the note above.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*c;
	CHLTrace	 tr;
	F64			 down[3];
	F64			 zero[3];
	F64			 bmins[3];
	F64			 bmaxs[3];
	F64			 length;
	I64			 mine;
	I64			 i;

	if (_len)
		*_len = 0.0;

	if (!e || !hl_map)
		return HLBARN_NOBODY;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecCopy(e->origin, down);
	down[2] -= HLBARN_TONGUE_MAX;

	//ignore_monsters, barnacle.cpp:399: the length follows architecture only,
	//so a body walking under the tongue does not shorten it
	HLTraceEntity(hl_map, e->origin, down, zero, zero, 0, TRUE, &tr);

	length = e->origin[2] - tr.end_pos[2];

	if (length < 0.0)
		length = -length;

	if (_len)
		*_len = length;

	//the column the tongue occupies, barnacle.cpp:403-407
	HLVecSet(bmins, e->origin[0] - HLBARN_CHECK_SPACE,
		e->origin[1] - HLBARN_CHECK_SPACE, e->origin[2] - length);
	HLVecSet(bmaxs, e->origin[0] + HLBARN_CHECK_SPACE,
		e->origin[1] + HLBARN_CHECK_SPACE, e->origin[2]);

	mine = hl_ai_mon_info[hl_ai_mon[s].kind].classify;

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (i == s || hl_ai_mon[i].ent < 0)
			goto qabt_next;

		//already hanging from another tongue, or dead
		if (hl_ai_mon[i].barn_host >= 0)
			goto qabt_next;

		if (hl_ai_mon[i].state == HLMSTATE_DEAD)
			goto qabt_next;

		//IRelationship( pList[i] ) > R_NO, barnacle.cpp:415
		if (HLAIRelationship(mine,
			hl_ai_mon_info[hl_ai_mon[i].kind].classify) <= HLREL_NONE)
			goto qabt_next;

		c = HLEntGet(hl_ai_mon[i].ent);

		if (!c || c->health <= 0.0)
			goto qabt_next;

		if (c->absmax[0] < bmins[0] || c->absmin[0] > bmaxs[0])
			goto qabt_next;
		if (c->absmax[1] < bmins[1] || c->absmin[1] > bmaxs[1])
			goto qabt_next;
		if (c->absmax[2] < bmins[2] || c->absmin[2] > bmaxs[2])
			goto qabt_next;

		return i;

qabt_next:
	}

	return HLBARN_NOBODY;
}

U0 HLAIBarnacleGrab(I64 s, I64 v)
{//the FBecomeProne branch, barnacle.cpp:273-291
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve = HLEntGet(hl_ai_mon[v].ent);

	if (!e || !ve)
		return;

	HLSndPlayAt("barnacle/bcl_alert2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	//SetSequenceByName("attack1"), barnacle.cpp:277 - the label, not an
	//activity: attack1 carries activity 0 in barnacle.mdl
	HLAISetActivity(s, HLACT_MELEE);

	hl_ai_mon[s].barn_adj     = HLBARN_ADJ_HELD;
	hl_ai_mon[s].barn_prey    = v;
	hl_ai_mon[s].barn_lifting = TRUE;
	hl_ai_mon[s].barn_kill    = -1.0;
	hl_ai_mon[v].barn_host    = s;

	ve->movetype = HLMOVETYPE_FLY;
	ve->origin[0] = e->origin[0];
	ve->origin[1] = e->origin[1];
	HLEntSetAbsBox(ve);

	//m_flAltitude is the drop from the barnacle to the victim's eye,
	//barnacle.cpp:290
	hl_ai_mon[s].barn_alt = e->origin[2] - (ve->origin[2] +
		hl_ai_mon_info[hl_ai_mon[v].kind].view_ofs);

	HLAISetSchedule(v, HLSCHED_BARNACLE_GRAB);
}

U0 HLAIBarnacleLift(I64 s, I64 v)
{//the m_fLiftingPrey branch, barnacle.cpp:167-203
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve = HLEntGet(hl_ai_mon[v].ent);
	F64			 org[3];
	F64			 gap;

	if (!e || !ve)
		return;

	//dragged onto the barnacle's own column, less a guess at where the neck
	//is, barnacle.cpp:171-178
	HLVecCopy(ve->origin, org);
	org[0] = e->origin[0] -
		HLBARN_NECK_OFS * Cos(ve->angles[1] * HLDEG2RAD);
	org[1] = e->origin[1] -
		HLBARN_NECK_OFS * Sin(ve->angles[1] * HLDEG2RAD);
	org[2] += HLBARN_PULL_SPEED;

	hl_ai_mon[s].barn_alt -= HLBARN_PULL_SPEED;

	HLVecCopy(org, ve->origin);
	HLEntSetAbsBox(ve);

	//the head is in the mouth once the victim's eye sits within one body
	//height of the barnacle's origin, barnacle.cpp:180
	gap = e->origin[2] - (org[2] +
		hl_ai_mon_info[hl_ai_mon[v].kind].view_ofs - HLBARN_MOUTH_SLACK);

	if (gap < 0.0)
		gap = -gap;

	if (gap >= HLBARN_BODY_HEIGHT)
		return;

	hl_ai_mon[s].barn_lifting = FALSE;

	HLSndPlayAt("barnacle/bcl_bite3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	hl_ai_mon[s].barn_kill = hl_ent_time + HLBARN_KILL_DELAY;

	//BarnacleVictimBitten, monsters.cpp:171
	HLAISetSchedule(v, HLSCHED_BARNACLE_CHOMP);
	HLAISetActivity(s, HLACT_EAT);
}

U0 HLAIBarnacleThink(I64 s)
{//BarnacleThink, barnacle.cpp:143, on its own 0.1s cadence. Replaces the
 //schedule machinery outright: a barnacle selects nothing and moves nowhere.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*ve;
	F64			 gib_dir[3];
	F64			 length;
	F64			 setting;
	I64			 touched;
	I64			 v;

	if (!e)
		return;

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLBARN_THINK;

	v      = hl_ai_mon[s].barn_prey;
	length = 0.0;

	//someone killed the prey, barnacle.cpp:152-158
	if (v >= 0)
	{
		ve = HLEntGet(hl_ai_mon[v].ent);

		if (!ve || ve->health <= 0.0 || hl_ai_mon[v].state == HLMSTATE_DEAD)
		{
			HLAIBarnacleRelease(s);
			v = -1;
		}
	}

	if (v >= 0)
	{
		if (hl_ai_mon[s].barn_lifting)
			HLAIBarnacleLift(s, v);
		else
		{
			ve = HLEntGet(hl_ai_mon[v].ent);

			//the killing bite, ten seconds after the victim is in place
			if (ve && hl_ai_mon[s].barn_kill >= 0.0 &&
				hl_ent_time > hl_ai_mon[s].barn_kill)
			{
				HLDmgHurt(hl_ai_mon[v].ent, hl_ai_mon[s].ent, ve->health,
					HLDMG_SLASH | HLDMG_ALWAYSGIB);
				hl_ai_mon[s].barn_gibs = HLBARN_KILL_GIBS;
				goto qabk_ctl;
			}

			//a chew on one think in fifty, barnacle.cpp:228
			if (HLPartRandI(50) == 0)
			{
				HLAIBarnacleChew(s);
				HLAISetSchedule(v, HLSCHED_BARNACLE_CHOMP);
			}
		}

		goto qabk_ctl;
	}

	//--- no prey: fidget, cough up the last meal, and fish ---

	//a finished take re-rolls the idle and resets the tongue bias,
	//barnacle.cpp:245-249
	if (HLAIAnimDone(s))
	{
		HLAISetActivity(s, HLACT_IDLE);
		hl_ai_mon[s].barn_adj = HLBARN_ADJ_IDLE;
	}

	if (hl_ai_mon[s].barn_gibs > 0 && HLPartRandI(100) == 1)
	{
		hl_ai_mon[s].barn_gibs--;

		//SpawnRandomGibs(pev, 1, 1), barnacle.cpp:253. Thrown down, out of the
		//mouth. The health figure is the velocity scale, not a health
		HLVecSet(gib_dir, 0.0, 0.0, -1.0);
		HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir, HLGIB_HEALTH_VALUE,
			1, TRUE, HLBLOOD_RED, hl_ent_time);

		HLAIBarnacleChew(s);
	}

	touched = HLAIBarnacleTouch(s, &length);

	if (touched != HLBARN_NOBODY && hl_ai_mon[s].barn_ext)
		HLAIBarnacleGrab(s, touched);
	else if (hl_ai_mon[s].barn_alt < length)
	{
		//the tongue hangs higher than it may: lower it a step at a time
		hl_ai_mon[s].barn_alt += HLBARN_PULL_SPEED;
		hl_ai_mon[s].barn_ext  = FALSE;
	}
	else
	{
		hl_ai_mon[s].barn_alt = length;
		hl_ai_mon[s].barn_ext = TRUE;
	}

qabk_ctl:
	//SetBoneController(0, -(m_flAltitude + m_flTongueAdj)), barnacle.cpp:322
	setting = HLStudioCtlSetting(e->studio, 0,
		-(hl_ai_mon[s].barn_alt + hl_ai_mon[s].barn_adj));

	if (setting >= 0.0)
		e->controllers[0] = setting;
}

U0 HLAIBarnacleKilled(I64 s)
{//CBarnacle::Killed, barnacle.cpp:326. Drops the prey and stops being solid;
 //the shared death path plays the die take from there
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 setting;

	HLAIBarnacleRelease(s);

	if (!e)
		return;

	e->solid      = HLSOLID_NOT;
	e->takedamage = HLDMG_TAKE_NO;

	if (HLPartRandI(2))
		HLSndPlayAt("barnacle/bcl_die1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
	else
		HLSndPlayAt("barnacle/bcl_die3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);

	//SetBoneController(0, 0), barnacle.cpp:347: the tongue retracts as it dies
	hl_ai_mon[s].barn_alt = 0.0;
	hl_ai_mon[s].barn_adj = 0.0;

	setting = HLStudioCtlSetting(e->studio, 0, 0.0);

	if (setting >= 0.0)
		e->controllers[0] = setting;
}

//--- monster_tripmine -------------------------------------------------------
//
// dlls/tripmine.cpp:77. CTripmineGrenade is a CGrenade, not a monster: it has
// no schedule, no Classify and no corpse. Spawn holds sequence "world" at
// framerate 0, PowerupThink (:165) waits out the arm delay and puts the beam
// up, BeamBreakThink (:264) re-traces the tripwire every think and detonates
// the moment the trace fraction moves.
//
// weapon_tripmine, the pickup and the mine a player places, is a separate
// class in the same file and lives in HLWeapon.ZC. That file compiles at 97
// against this one's 95, so nothing there is reachable from here and the two
// share constants only.

U0 HLAIRadiusDamage(F64 *src, F64 damage, F64 radius, I64 attacker,
	I64 bits = HLDMG_BLAST)
{//::RadiusDamage, dlls/combat.cpp:1038. Linear falloff, and the blast must be
 //able to see the target.
 //
 //HLWeaponRadiusDamage in HLWeapon.ZC is the same routine and compiles two
 //files later, so it cannot be called from here
	CHLEntity	*e;
	CHLTrace	 tr;
	F64			 spot[3];
	F64			 from[3];
	F64			 zero[3];
	F64			 delta[3];
	F64			 falloff;
	F64			 dist;
	F64			 hurt;
	I64			 i;

	if (!hl_entities || !hl_map || radius <= 0.0)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	falloff = damage / radius;

	//"in case grenade is lying on the ground", combat.cpp:1049
	HLVecCopy(src, from);
	from[2] += 1.0;

	//UTIL_FindEntityInSphere walks every edict and a client is an edict. The
	//loop below walks hl_entities, which the player has no slot in
	HLVecCopy(hl_ent_player_org, spot);
	spot[2] += (hl_player_mins[2] + hl_player_maxs[2]) * 0.5;

	HLVecSub(spot, from, delta);
	dist = HLVecLength(delta);

	if (dist <= radius && !hl_ent_player_dead)
	{
		HLTraceEntity(hl_map, from, spot, zero, zero, hl_move_pass, FALSE,
			&tr);

		//no entity index to compare tr.ent against, so only a clear line
		//counts
		if (tr.fraction >= 1.0)
		{
			hurt = damage - dist * falloff;

			if (hurt > 0.0)
				HLEntHurtPlayer(hurt, bits, src);
		}
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->takedamage == HLDMG_TAKE_NO)
			goto qard_next;

		//BodyTarget is the middle of the box. absmin/absmax are only rebuilt
		//for entities the spawn pass linked, so fall back to the origin
		if (e->absmax[0] > e->absmin[0] || e->absmax[2] > e->absmin[2])
		{
			spot[0] = (e->absmin[0] + e->absmax[0]) * 0.5;
			spot[1] = (e->absmin[1] + e->absmax[1]) * 0.5;
			spot[2] = (e->absmin[2] + e->absmax[2]) * 0.5;
		}
		else
			HLVecCopy(e->origin, spot);

		HLVecSub(spot, from, delta);
		dist = HLVecLength(delta);

		if (dist > radius)
			goto qard_next;

		HLTraceEntity(hl_map, from, spot, zero, zero, hl_move_pass, FALSE,
			&tr);

		//tr.ent is the progs edict a trace ended on and stays -1 with no VM;
		//a native entity's index arrives in hl_trace_native_ent. Comparing
		//tr.ent made every solid entity shield itself from the blast
		if (tr.fraction < 1.0 && hl_trace_native_ent != i)
			goto qard_next;

		hurt = damage - dist * falloff;

		if (hurt <= 0.0)
			goto qard_next;

		HLDmgHurt(i, attacker, hurt, bits);

qard_next:
	}

	HLEntDrainCalls();
}

U0 HLAITripmineFree(I64 s)
{//the mine is gone: the entity leaves the world and the slot stops tracking it
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 ent = hl_ai_mon[s].ent;

	if (e)
	{
		e->in_use     = FALSE;
		e->solid      = HLSOLID_NOT;
		e->takedamage = HLDMG_TAKE_NO;
	}

	if (ent >= 0 && ent < HLENT_MAX)
		hl_ai_mon_of[ent] = -1;

	hl_ai_mon[s].ent        = -1;
	hl_ai_mon[s].mine_armed = FALSE;
}

U0 HLAITripmineExplode(I64 s)
{//DelayDeathThink into CGrenade::Explode, tripmine.cpp:344 and
 //ggrenade.cpp:51. The blast is DMG_BLAST at pev->dmg over dmg * 2.5
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 org[3];
	F64			 dmg;

	if (!e)
		return;

	dmg = hl_ai_mon_info[hl_ai_mon[s].kind].range_dmg;

	HLVecCopy(e->origin, org);

	//ExplosionCreate's own scale is (magnitude - 50) * 0.6, the figure
	//CGrenade::Explode writes into TE_EXPLOSION at ggrenade.cpp:81
	HLFxExplosionCreate(hl_map, org, ToI64(dmg), tS);

	//bits_SOUND_COMBAT at NORMAL_EXPLOSION_VOLUME for three seconds,
	//ggrenade.cpp:85
	HLAIInsertSound(HLSOUND_COMBAT, org, 1024.0, 3.0);

	//the client's R_Explosion picks one of explode3/4/5; HLEntity.ZC's
	//env_explosion emits explode3 on the same event
	HLSndPlayAt("weapons/explode3.wav", org, 1.0, HLENT_SND_ATTEN, 0,
		HLCHAN_WEAPON);

	HLAITripmineFree(s);

	//after the entity is out of the world, so the blast does not damage the
	//mine's own box
	HLAIRadiusDamage(org, dmg, dmg * HLMINE_BLAST_SCALE, -1);

	//ggrenade.cpp:110-112. CHAN_VOICE there; channel 2 drives the studio
	//mouth controller here, so the debris goes on CHAN_BODY
	HLSndPlayAt("weapons/debris1.wav", org, 0.55, HLENT_SND_ATTEN, 0,
		HLCHAN_BODY);
}

U0 HLAITripmineArm(I64 s)
{//PowerupThink's arming branch plus MakeBeam, tripmine.cpp:216-262
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 zero[3];

	if (!e || !hl_map)
		return;

	e->solid = HLSOLID_BBOX;
	HLEntSetAbsBox(e);

	//dont_ignore_monsters, tripmine.cpp:245: a body standing in the wire at
	//the moment it arms sets the length the break test compares against.
	//
	//hl_ent_clip_ignore, not HLTraceEntity's pass: pass is a progs edict
	//index, and the box solids arrive through HLEntClipToSlideboxes, which
	//keys on this global. It also decides whether the player's box counts -
	//a value of -1 means the player is the mover and is skipped, which would
	//make the mine blind to the one thing that must set it off
	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_ent_clip_ignore = hl_ai_mon[s].ent;

	HLTraceEntity(hl_map, e->origin, hl_ai_mon[s].mine_end, zero, zero, 0,
		FALSE, &tr);

	hl_ent_clip_ignore = -1;

	hl_ai_mon[s].mine_len   = tr.fraction;
	hl_ai_mon[s].mine_armed = TRUE;

	HLVecMA(e->origin, HLMINE_RANGE * tr.fraction, hl_ai_mon[s].mine_dir,
		hl_ai_mon[s].mine_beam);

	//EMIT_SOUND_DYN at 0.5 and pitch 75, tripmine.cpp:225
	HLSndPlayAt("weapons/mine_activate.wav", e->origin, 0.5, HLENT_SND_ATTEN,
		hl_ai_mon[s].ent + 1, HLCHAN_VOICE, 75);
}

U0 HLAITripmineThink(I64 s)
{//PowerupThink and BeamBreakThink in one, on tripmine.cpp's own 0.1s cadence
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLTrace	 tr;
	F64			 zero[3];
	F64			 delta;

	if (!e)
		return;

	//Killed, tripmine.cpp:334: the blast lands a random beat later
	if (e->health <= 0.0 && !hl_ai_mon[s].mine_dying)
	{
		hl_ai_mon[s].mine_dying = TRUE;
		hl_ai_mon[s].mine_armed = FALSE;
		e->takedamage           = HLDMG_TAKE_NO;
		hl_ai_mon[s].mine_boom  = hl_ent_time + 0.1 +
			ToF64(HLPartRandI(3)) * 0.1;
	}

	if (hl_ai_mon[s].mine_dying)
	{
		if (hl_ent_time >= hl_ai_mon[s].mine_boom)
			HLAITripmineExplode(s);

		return;
	}

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLMINE_THINK;

	if (!hl_ai_mon[s].mine_armed)
	{
		if (hl_ent_time > hl_ai_mon[s].mine_arm)
			HLAITripmineArm(s);

		return;
	}

	//BeamBreakThink, tripmine.cpp:264. FTRACE_SIMPLEBOX at :271 makes the
	//sweep hit a monster's box rather than its hitboxes; every trace here is
	//box against box already
	HLVecSet(zero, 0.0, 0.0, 0.0);
	hl_ent_clip_ignore = hl_ai_mon[s].ent;

	HLTraceEntity(hl_map, e->origin, hl_ai_mon[s].mine_end, zero, zero, 0,
		FALSE, &tr);

	hl_ent_clip_ignore = -1;

	HLVecMA(e->origin, HLMINE_RANGE * tr.fraction, hl_ai_mon[s].mine_dir,
		hl_ai_mon[s].mine_beam);

	delta = hl_ai_mon[s].mine_len - tr.fraction;

	if (delta < 0.0)
		delta = -delta;

	//anything crossing the wire moves the fraction, tripmine.cpp:289
	if (delta > HLMINE_BREAK_TOL)
	{
		e->health = 0.0;

		hl_ai_mon[s].mine_dying = TRUE;
		hl_ai_mon[s].mine_armed = FALSE;
		e->takedamage           = HLDMG_TAKE_NO;
		hl_ai_mon[s].mine_boom  = hl_ent_time + 0.1 +
			ToF64(HLPartRandI(3)) * 0.1;
	}
}

U0 HLAITripmineBeams(CHLCanvas *c)
{//the tripwire of every armed mine. Mirrors HLEntDrawBeams, which only draws
 //HLC_BEAM entities and resolves both endpoints to entity origins; a mine's
 //far end is a traced point and has no entity behind it.
 //
 //Additive and depth tested, writing no depth, so this belongs after the world
 //and entity passes. Not called from anywhere yet: the render loop is in
 //HL1.ZC, which compiles after this file
	CHLSprFrame	*fr;
	CHLEntity	*e;
	I64			 i;

	if (!c || !hl_ai_laser_spr || !hl_entities)
		return;

	if (hl_ai_laser_spr->num_frames < 1 || !hl_ai_laser_spr->palette)
		return;

	fr = &hl_ai_laser_spr->frames[0];

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].kind != HLMON_TRIPMINE || !hl_ai_mon[i].mine_armed)
			goto qatb_next;

		e = HLEntGet(hl_ai_mon[i].ent);

		if (!e)
			goto qatb_next;

		HLDrawBeam(c, e->origin, hl_ai_mon[i].mine_beam, fr->pixels,
			hl_ai_laser_spr->palette, fr->width, fr->height,
			HLMINE_BEAM_WIDTH, 0.0, HLMINE_BEAM_SCROLL, tS,
			HLMINE_BEAM_R, HLMINE_BEAM_G, HLMINE_BEAM_B,
			HLMINE_BEAM_BRIGHT);

qatb_next:
	}
}

//--- monster_sentry ---------------------------------------------------------
//
// dlls/turret.cpp:1158. CSentry is a CBaseTurret and a CBaseTurret runs no
// schedule: five think functions, a two-axis aim carried entirely on bone
// controllers, and a body that never turns.
//
// CSentry sets m_flMaxWait and m_flMaxSpin to 1e6 (turret.cpp:1171-1172), so
// Retire, SpinDownCall and AutoSearchThink are unreachable for this class: a
// deployed sentry stays deployed and its barrel stays spinning. Deploy,
// SearchThink and ActiveThink are the whole of it.
//
// Deviation: ceiling orientation (m_iOrientation 1) flips angles + view eye
// at register. Search pitch still uses the floor hunt path; floor-mounted
// sentries never carry the key in the campaign.

Bool HLAITurretMove(I64 s)
{//MoveTurret, turret.cpp:1043. TRUE while either axis is still travelling.
 //The aim goes onto bone controllers 0 and 1; pev->angles never moves
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 setting;
	F64			 dir;
	F64			 dist;
	Bool		 moved = FALSE;

	if (!e)
		return FALSE;

	if (hl_ai_mon[s].tur_cur[0] != hl_ai_mon[s].tur_goal[0])
	{
		dir = -1.0;

		if (hl_ai_mon[s].tur_goal[0] > hl_ai_mon[s].tur_cur[0])
			dir = 1.0;

		hl_ai_mon[s].tur_cur[0] += 0.1 * hl_ai_mon[s].tur_rate * dir;

		//started below the goal and now past it: peg
		if (dir == 1.0)
		{
			if (hl_ai_mon[s].tur_cur[0] > hl_ai_mon[s].tur_goal[0])
				hl_ai_mon[s].tur_cur[0] = hl_ai_mon[s].tur_goal[0];
		}
		else if (hl_ai_mon[s].tur_cur[0] < hl_ai_mon[s].tur_goal[0])
			hl_ai_mon[s].tur_cur[0] = hl_ai_mon[s].tur_goal[0];

		//SetBoneController(1, -m_vecCurAngles.x), turret.cpp:1069
		setting = HLStudioCtlSetting(e->studio, 1, -hl_ai_mon[s].tur_cur[0]);

		if (setting >= 0.0)
			e->controllers[1] = setting;

		moved = TRUE;
	}

	if (hl_ai_mon[s].tur_cur[1] != hl_ai_mon[s].tur_goal[1])
	{
		dir = -1.0;

		if (hl_ai_mon[s].tur_goal[1] > hl_ai_mon[s].tur_cur[1])
			dir = 1.0;

		dist = hl_ai_mon[s].tur_goal[1] - hl_ai_mon[s].tur_cur[1];

		if (dist < 0.0)
			dist = -dist;

		//the short way round
		if (dist > 180.0)
		{
			dist = 360.0 - dist;
			dir  = -dir;
		}

		//accelerate while far off, hold 45 degrees per 0.1s while close
		if (dist > 30.0)
		{
			if (hl_ai_mon[s].tur_rate < HLTUR_TURNRATE * 10.0)
				hl_ai_mon[s].tur_rate += HLTUR_TURNRATE;
		}
		else if (hl_ai_mon[s].tur_rate > 45.0)
			hl_ai_mon[s].tur_rate -= HLTUR_TURNRATE;
		else
			hl_ai_mon[s].tur_rate += HLTUR_TURNRATE;

		hl_ai_mon[s].tur_cur[1] += 0.1 * hl_ai_mon[s].tur_rate * dir;

		if (hl_ai_mon[s].tur_cur[1] < 0.0)
			hl_ai_mon[s].tur_cur[1] += 360.0;
		else if (hl_ai_mon[s].tur_cur[1] >= 360.0)
			hl_ai_mon[s].tur_cur[1] -= 360.0;

		if (dist < 0.05 * HLTUR_TURNRATE)
			hl_ai_mon[s].tur_cur[1] = hl_ai_mon[s].tur_goal[1];

		//SetBoneController(0, m_vecCurAngles.y - pev->angles.y),
		//turret.cpp:1112
		setting = HLStudioCtlSetting(e->studio, 0,
			hl_ai_mon[s].tur_cur[1] - e->angles[1]);

		if (setting >= 0.0)
			e->controllers[0] = setting;

		moved = TRUE;
	}

	if (!moved)
		hl_ai_mon[s].tur_rate = HLTUR_TURNRATE;

	return moved;
}

U0 HLAITurretPing(I64 s)
{//Ping, turret.cpp:419. One note a second while searching. The eye glow is a
 //CSprite attachment and has no counterpart here
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ai_mon[s].tur_ping == 0.0)
		hl_ai_mon[s].tur_ping = hl_ent_time + 1.0;
	else if (hl_ai_mon[s].tur_ping <= hl_ent_time)
	{
		hl_ai_mon[s].tur_ping = hl_ent_time + 1.0;

		HLSndPlayAt("turret/tu_ping.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_ITEM);
	}
}

Bool HLAISentryTouched(I64 s)
{//SentryTouch, turret.cpp:1230: a player or a monster standing in the box
 //wakes it. The engine calls this from the touch pass; there is none here, so
 //the box test runs on the turret's own think
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*c;
	F64			 mins[3];
	F64			 maxs[3];
	I64			 i;

	if (!e)
		return FALSE;

	if (!hl_ent_player_dead && hl_ent_player >= 0)
	{
		HLVecAdd(hl_ent_player_org, hl_player_mins, mins);
		HLVecAdd(hl_ent_player_org, hl_player_maxs, maxs);

		if (maxs[0] >= e->absmin[0] && mins[0] <= e->absmax[0] &&
			maxs[1] >= e->absmin[1] && mins[1] <= e->absmax[1] &&
			maxs[2] >= e->absmin[2] && mins[2] <= e->absmax[2])
			return TRUE;
	}

	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (i == s || hl_ai_mon[i].ent < 0)
			goto qast_next;

		c = HLEntGet(hl_ai_mon[i].ent);

		if (!c || c->health <= 0.0)
			goto qast_next;

		if (c->absmax[0] < e->absmin[0] || c->absmin[0] > e->absmax[0])
			goto qast_next;
		if (c->absmax[1] < e->absmin[1] || c->absmin[1] > e->absmax[1])
			goto qast_next;
		if (c->absmax[2] < e->absmin[2] || c->absmin[2] > e->absmax[2])
			goto qast_next;

		return TRUE;

qast_next:
	}

	return FALSE;
}

U0 HLAISentryDeath(I64 s)
{//SentryDeath, turret.cpp:1239. No gibs and no blood: CBaseTurret overrides
 //GibMonster to do nothing and BloodColor to DONT_BLEED
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 spot[3];
	F64			 up[3];
	F64			 setting;
	F64			 roll;

	if (!e)
		return;

	if (hl_ai_mon[s].tur_state != HLTUR_DEAD)
	{
		hl_ai_mon[s].tur_state   = HLTUR_DEAD;
		hl_ai_mon[s].tur_dmg_time = hl_ent_time;

		roll = HLFxRandF(0.0, 1.0);

		if (roll <= 0.33)
			HLSndPlayAt("turret/tu_die.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		else if (roll <= 0.66)
			HLSndPlayAt("turret/tu_die2.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		else
			HLSndPlayAt("turret/tu_die3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
				hl_ai_mon[s].ent + 1, HLCHAN_BODY);

		//SetBoneController(0, 0) and (1, 0), turret.cpp:1264-1265
		setting = HLStudioCtlSetting(e->studio, 0, 0.0);

		if (setting >= 0.0)
			e->controllers[0] = setting;

		setting = HLStudioCtlSetting(e->studio, 1, 0.0);

		if (setting >= 0.0)
			e->controllers[1] = setting;

		HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
		HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);

		HLAISetActivity(s, HLACT_DIE);

		e->solid      = HLSOLID_NOT;
		e->takedamage = HLDMG_TAKE_NO;

		//so HLAIMonsterFrame's revive pass leaves the wreck alone
		HLAISetState(s, HLMSTATE_DEAD);

		//"pev->angles.y = UTIL_AngleMod(pev->angles.y + RANDOM_LONG(0,2)*120)",
		//turret.cpp:1270: the wreck settles facing one of three ways
		e->angles[1] = HLAngleNorm(e->angles[1] +
			ToF64(HLPartRandI(3)) * 120.0);

		HLEntSetAbsBox(e);
	}

	//smoke for up to two seconds and sparks for up to five, turret.cpp:1281
	//and :1289. The SDK draws both off attachment 1; the origin is used here
	if (hl_ent_time - hl_ai_mon[s].tur_dmg_time > HLTUR_SPARK_TIME)
		return;

	HLVecSet(spot, e->origin[0] + HLPartRand(16.0),
		e->origin[1] + HLPartRand(16.0), e->origin[2] + 16.0);

	if (hl_ent_time - hl_ai_mon[s].tur_dmg_time < 2.0)
		HLFxSmoke(spot, 15.0, tS);

	HLVecSet(up, 0.0, 0.0, 1.0);
	HLFxSparkShower(spot, up, tS);
}

U0 HLAISentryDeploy(I64 s)
{//Deploy, turret.cpp:638
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ai_mon[s].activity != HLACT_ARM)
	{
		HLAISetActivity(s, HLACT_ARM);

		HLSndPlayAt("turret/tu_deploy.wav", e->origin, HLTUR_MACH_VOL,
			HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_BODY);

		return;
	}

	if (!HLAIAnimDone(s))
		return;

	//CSentry's deploy height equals its retract height, so the box the SDK
	//resizes here does not change

	HLVecSet(hl_ai_mon[s].tur_cur, 0.0, e->angles[1], 0.0);
	HLVecSet(hl_ai_mon[s].tur_goal, 0.0, e->angles[1], 0.0);

	HLAISetActivity(s, HLACT_COMBAT_IDLE);

	hl_ai_mon[s].tur_state = HLTUR_SEARCH;

	//m_flLastSight = time + m_flMaxWait, and CSentry's m_flMaxWait is 1e6:
	//it never times out and never retires
	hl_ai_mon[s].tur_sight = 0.0;
}

U0 HLAISentrySearch(I64 s)
{//SearchThink, turret.cpp:822, less the retract and spin-down branches that
 //CSentry's 1e6 timers make unreachable
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 feet[3];
	F64			 eye[3];

	if (!e)
		return;

	HLAISetActivity(s, HLACT_COMBAT_IDLE);
	HLAITurretPing(s);

	//"Dead enemy forces a search for new one", turret.cpp:837
	if (hl_ai_mon[s].have_enemy)
	{
		if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
			hl_ai_mon[s].have_enemy = FALSE;
	}

	if (!hl_ai_mon[s].have_enemy)
		HLAILook(s);

	if (hl_ai_mon[s].have_enemy)
	{
		hl_ai_mon[s].tur_sight = 0.0;
		hl_ai_mon[s].tur_state = HLTUR_ACTIVE;
		return;
	}

	//"generic hunt for new victims", turret.cpp:876: the goal yaw walks round
	//and MoveTurret chases it
	hl_ai_mon[s].tur_goal[1] += 0.1 * hl_ai_mon[s].tur_rate;

	if (hl_ai_mon[s].tur_goal[1] >= 360.0)
		hl_ai_mon[s].tur_goal[1] -= 360.0;

	HLAITurretMove(s);
}

U0 HLAISentryActive(I64 s)
{//ActiveThink, turret.cpp:462
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 mid[3];
	F64			 feet[3];
	F64			 eye[3];
	F64			 dir[3];
	F64			 want[3];
	F64			 aim[3];
	F64			 forward[3];
	F64			 dist;
	Bool		 seen;
	Bool		 attack;

	if (!e)
		return;

	if (!hl_ai_mon[s].have_enemy ||
		!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
	{
		//the enemy died or left: back to searching after the hold
		hl_ai_mon[s].have_enemy = FALSE;

		if (hl_ai_mon[s].tur_sight == 0.0)
			hl_ai_mon[s].tur_sight = hl_ent_time + HLTUR_HOLD;
		else if (hl_ent_time > hl_ai_mon[s].tur_sight)
		{
			hl_ai_mon[s].tur_sight = 0.0;
			hl_ai_mon[s].tur_state = HLTUR_SEARCH;
		}

		HLAISetActivity(s, HLACT_COMBAT_IDLE);
		HLAITurretMove(s);
		return;
	}

	HLAIMonEye(s, mid);

	//BodyTarget, the middle of the enemy's box, which HLAITargetPos returns as
	//its eye
	HLVecSub(eye, mid, dir);
	dist = HLVecLength(dir);

	seen = ToBool(dist <= HLTUR_RANGE && HLAIVisible(s, eye));

	if (!seen)
	{
		if (hl_ai_mon[s].tur_sight == 0.0)
			hl_ai_mon[s].tur_sight = hl_ent_time + HLTUR_HOLD;
		else if (hl_ent_time > hl_ai_mon[s].tur_sight)
		{
			hl_ai_mon[s].have_enemy = FALSE;
			hl_ai_mon[s].tur_sight  = 0.0;
			hl_ai_mon[s].tur_state  = HLTUR_SEARCH;
			return;
		}
	}
	else
	{
		hl_ai_mon[s].tur_sight = 0.0;
		HLVecCopy(feet, hl_ai_mon[s].enemy_pos);
		hl_ai_mon[s].enemy_seen = hl_ent_time;
	}

	//UTIL_MakeAimVectors(m_vecCurAngles), turret.cpp:525. The gun's own
	//direction, not the body's
	HLVecSet(aim, -hl_ai_mon[s].tur_cur[0], hl_ai_mon[s].tur_cur[1], 0.0);
	HLAngleVectors(aim, forward, NULL, NULL);

	HLVecNormalize(dir);

	//30 degree slop before it will fire, turret.cpp:536
	attack = ToBool(HLVecDot(dir, forward) > HLTUR_AIM_DOT);

	if (attack)
	{
		HLAISetActivity(s, HLACT_RANGE);

		//m_iSpin is raised by the base SpinUpCall on the first call, so a
		//sentry shoots as soon as it is aimed
		if (hl_ent_time >= hl_ai_mon[s].next_attack)
		{
			hl_ai_mon[s].next_attack = hl_ent_time +
				hl_ai_mon_info[hl_ai_mon[s].kind].attack_rate;

			HLAIFireAttack(s, FALSE);

			//CTurret::Shoot uses tu_fire1 (12mm); CSentry / CMiniTurret use
			//the three MP5 reports, turret.cpp:616 and :1188-1193
			if (hl_ai_mon[s].kind == HLMON_TURRET)
				HLSndPlayAt("turret/tu_fire1.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else if (HLPartRandI(3) == 0)
				HLSndPlayAt("weapons/hks1.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else if (HLPartRandI(2))
				HLSndPlayAt("weapons/hks2.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
			else
				HLSndPlayAt("weapons/hks3.wav", e->origin, 1.0,
					HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_WEAPON);
		}
	}
	else
		HLAISetActivity(s, HLACT_COMBAT_IDLE);

	if (seen)
	{
		HLVecSub(eye, mid, dir);
		HLVecToAngles(dir, want);

		//"now all numbers should be in [1...360], pin to turret limitations",
		//turret.cpp:583-597. HLVecToAngles is VectorAngles: pitch positive up,
		//yaw in [0,360)
		if (want[0] > 180.0)
			want[0] -= 360.0;

		if (want[0] > 90.0)
			want[0] = 90.0;
		else if (want[0] < HLTUR_MIN_PITCH)
			want[0] = HLTUR_MIN_PITCH;

		hl_ai_mon[s].tur_goal[0] = want[0];
		hl_ai_mon[s].tur_goal[1] = want[1];
	}

	HLAITurretMove(s);
}

U0 HLAISentryThink(I64 s)
{//the CSentry state machine on turret.cpp's own 0.1s cadence
	CHLEntity *e = HLEntGet(hl_ai_mon[s].ent);

	if (!e)
		return;

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLTUR_THINK;

	if (hl_ai_mon[s].tur_state == HLTUR_DEAD)
	{
		HLAISentryDeath(s);
		return;
	}

	if (e->health <= 0.0)
	{
		HLAISentryDeath(s);
		return;
	}

	//CSentry::TakeDamage deploys on the first hit, turret.cpp:1204. SentryTouch
	//does the same for anything that walks into it
	if (hl_ai_mon[s].tur_state == HLTUR_OFF)
	{
		if (e->health < hl_ai_mon[s].last_health || HLAISentryTouched(s))
		{
			hl_ai_mon[s].last_health = e->health;
			hl_ai_mon[s].tur_state   = HLTUR_DEPLOY;

			HLSndPlayAt("turret/tu_alert.wav", e->origin, HLTUR_MACH_VOL,
				HLENT_SND_ATTEN, hl_ai_mon[s].ent + 1, HLCHAN_BODY);
		}
		else
		{
			HLAISetActivity(s, HLACT_IDLE);
			return;
		}
	}

	hl_ai_mon[s].last_health = e->health;

	if (hl_ai_mon[s].tur_state == HLTUR_DEPLOY)
	{
		HLAISentryDeploy(s);
		return;
	}

	if (hl_ai_mon[s].tur_state == HLTUR_SEARCH)
	{
		HLAISentrySearch(s);
		return;
	}

	HLAISentryActive(s);
}

//--- monster_cockroach ------------------------------------------------------
//
// dlls/roach.cpp:60. CRoach overrides MonsterThink outright: no schedule, no
// task list, six modes and a random destination it walks to. It fears
// everything (the CLASS_INSECT row, monsters.cpp:2213), runs from light that
// gets brighter than where it started, walks to a carcass, and dies to one
// footstep.

U0 HLAIRoachDest(I64 s, I64 mode)
{//PickNewDest, roach.cpp:296. A random spot 256 to 511 units off, at the
 //roach's own height. The SDK re-rolls anything closer than 128; a minimum of
 //256 on the radius cannot produce one, so the loop has no counterpart
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 dir[3];
	F64			 dist;

	if (!e)
		return;

	hl_ai_mon[s].rch_mode = mode;

	//a carcass it can smell wins, roach.cpp:304-320
	if (mode == HLRCH_SMELL_FOOD && hl_ai_mon[s].heard >= 0)
	{
		HLVecSet(hl_ai_mon[s].goal,
			hl_ai_mon[s].heard_pos[0] + HLPartRand(3.0),
			hl_ai_mon[s].heard_pos[1] + HLPartRand(3.0),
			hl_ai_mon[s].heard_pos[2]);

		hl_ai_mon[s].have_goal     = TRUE;
		hl_ai_mon[s].goal_is_enemy = FALSE;
		hl_ai_mon[s].goal_tol      = 8.0;

		return;
	}

	HLVecSet(dir, HLPartRand(1.0), HLPartRand(1.0), 0.0);

	if (HLVecNormalize(dir) <= 0.0)
		HLVecSet(dir, 1.0, 0.0, 0.0);

	dist = HLRCH_DEST_MIN + ToF64(HLPartRandI(HLRCH_DEST_RANGE));

	HLVecMA(e->origin, dist, dir, hl_ai_mon[s].goal);
	hl_ai_mon[s].goal[2] = e->origin[2];

	hl_ai_mon[s].have_goal     = TRUE;
	hl_ai_mon[s].goal_is_enemy = FALSE;
	hl_ai_mon[s].goal_tol      = 8.0;
	hl_ai_mon[s].have_detour   = FALSE;
	HLAIRouteClear(s);
	hl_ai_mon[s].stuck_since   = 0.0;

	//"every once in a while, a roach will play a skitter sound",
	//roach.cpp:340. Pitch 80 to 119
	if (HLPartRandI(10) == 1)
		HLSndPlayAt("roach/rch_walk.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ai_mon[s].ent + 1, HLCHAN_BODY, 80 + HLPartRandI(40));
}

U0 HLAIRoachKilled(I64 s)
{//CRoach::Killed, roach.cpp:161. No corpse: UTIL_Remove takes it out of the
 //world, so there is no die take and no gib
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 ent = hl_ai_mon[s].ent;

	if (e)
	{
		e->solid = HLSOLID_NOT;

		if (HLPartRandI(5) == 1)
			HLSndPlayAt("roach/rch_die.wav", e->origin, 0.8, HLENT_SND_ATTEN,
				ent + 1, HLCHAN_VOICE, 80 + HLPartRandI(40));
		else
			HLSndPlayAt("roach/rch_smash.wav", e->origin, 0.7,
				HLENT_SND_ATTEN, ent + 1, HLCHAN_BODY,
				80 + HLPartRandI(40));

		HLAIInsertSound(HLSOUND_WORLD, e->origin, 128.0, 1.0);

		e->in_use     = FALSE;
		e->takedamage = HLDMG_TAKE_NO;
	}

	if (ent >= 0 && ent < HLENT_MAX)
		hl_ai_mon_of[ent] = -1;

	hl_ai_mon[s].ent = -1;
}

Bool HLAIRoachSquashed(I64 s)
{//CRoach::Touch, roach.cpp:84: a moving player crushes it. The engine calls
 //this from the touch pass; there is none here, so the box test runs on the
 //roach's own think
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 mins[3];
	F64			 maxs[3];

	if (!e || hl_ent_player < 0 || hl_ent_player_dead)
		return FALSE;

	//"if pOther->pev->velocity == g_vecZero ... return", roach.cpp:88: a
	//standing player does not squash it
	if (hl_ai_player_move <= 0.0)
		return FALSE;

	HLVecAdd(hl_ent_player_org, hl_player_mins, mins);
	HLVecAdd(hl_ent_player_org, hl_player_maxs, maxs);

	if (maxs[0] < e->absmin[0] || mins[0] > e->absmax[0])
		return FALSE;
	if (maxs[1] < e->absmin[1] || mins[1] > e->absmax[1])
		return FALSE;
	if (maxs[2] < e->absmin[2] || mins[2] > e->absmax[2])
		return FALSE;

	return TRUE;
}

U0 HLAIRoachThink(I64 s)
{//CRoach::MonsterThink, roach.cpp:190
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 lit;
	F64			 dz;
	I64			 moved;

	if (!e)
		return;

	if (e->health <= 0.0 || HLAIRoachSquashed(s))
	{
		HLAIRoachKilled(s);
		return;
	}

	if (hl_ent_time < hl_ai_mon[s].own_think)
		return;

	hl_ai_mon[s].own_think = hl_ent_time + HLRCH_THINK;

	//"suspend the creature for a second so the world finishes spawning, then
	//we'll collect the light level", roach.cpp:203
	if (!hl_ai_mon[s].rch_lit)
	{
		hl_ai_mon[s].rch_lit   = TRUE;
		hl_ai_mon[s].own_think = hl_ent_time + 1.0;
		return;
	}

	lit = ToF64(HLEntLightPoint(hl_map, e));

	if (hl_ai_mon[s].rch_light < 0.0)
		hl_ai_mon[s].rch_light = lit;

	if (hl_ai_mon[s].rch_mode == HLRCH_IDLE ||
		hl_ai_mon[s].rch_mode == HLRCH_EAT)
	{
		//"sample environment to see if anything scary is around ... at
		//random", roach.cpp:215
		if (HLPartRandI(4) == 1)
		{
			hl_ai_mon[s].have_enemy = FALSE;
			HLAILook(s);

			if (hl_ai_mon[s].have_enemy)
			{
				hl_ai_mon[s].rch_nofood = hl_ent_time + HLRCH_NOFOOD_MIN +
					ToF64(HLPartRandI(HLRCH_NOFOOD_RANGE));

				HLAIRoachDest(s, HLRCH_SCARED_ENT);
				HLAISetActivity(s, HLACT_WALK);
			}
			else if (HLPartRandI(150) == 1)
			{
				//boredom, roach.cpp:229
				if (hl_ai_mon[s].rch_mode == HLRCH_EAT)
					hl_ai_mon[s].rch_nofood = hl_ent_time +
						HLRCH_NOFOOD_MIN +
						ToF64(HLPartRandI(HLRCH_NOFOOD_RANGE));

				HLAIRoachDest(s, HLRCH_BORED);
				HLAISetActivity(s, HLACT_WALK);
			}
		}

		//"don't do this stuff if eating", roach.cpp:243
		if (hl_ai_mon[s].rch_mode == HLRCH_IDLE)
		{
			if (hl_ent_time >= hl_ai_mon[s].rch_nofood)
				HLAIListen(s);

			if (lit > hl_ai_mon[s].rch_light)
			{
				//someone turned the lights on
				HLAIRoachDest(s, HLRCH_SCARED_LIGHT);
				HLAISetActivity(s, HLACT_WALK);
			}
			else if (hl_ai_mon[s].heard >= 0 &&
				hl_ent_time >= hl_ai_mon[s].rch_nofood)
			{
				//food on another z-plane is out of reach, roach.cpp:262
				dz = hl_ai_mon[s].heard_pos[2] - e->origin[2];

				if (dz < 0.0)
					dz = -dz;

				if (dz <= HLRCH_FOOD_Z)
				{
					HLAIRoachDest(s, HLRCH_SMELL_FOOD);
					HLAISetActivity(s, HLACT_WALK);
				}
			}
		}
	}
	else if (hl_ai_mon[s].rch_mode == HLRCH_SCARED_LIGHT)
	{
		//"stop if we're over a spot at least as dark as where we started",
		//roach.cpp:277
		if (lit <= hl_ai_mon[s].rch_light)
		{
			hl_ai_mon[s].rch_light = lit;
			hl_ai_mon[s].rch_mode  = HLRCH_IDLE;
			hl_ai_mon[s].have_goal = FALSE;

			HLAISetActivity(s, HLACT_IDLE);
		}
	}

	if (hl_ai_mon[s].activity != HLACT_WALK || !hl_ai_mon[s].have_goal)
	{
		HLAISetActivity(s, HLACT_IDLE);
		return;
	}

	//MakeIdealYaw plus ChangeYaw, roach.cpp:358-360
	hl_ai_mon[s].ideal_yaw = HLAIYawTo(e->origin, hl_ai_mon[s].goal);
	HLAITurnToward(s, hl_ai_mon[s].ideal_yaw, HLRCH_THINK);

	moved = HLAIMoveStep(s, hl_ai_mon_info[hl_ai_mon[s].kind].walk_speed,
		HLRCH_THINK);

	//"stuck, so just pick a new spot to run off to", roach.cpp:366
	if (moved == HLAI_MOVE_BLOCKED)
	{
		HLAIRoachDest(s, hl_ai_mon[s].rch_mode);
		return;
	}

	if (moved == HLAI_MOVE_ARRIVED)
	{
		//"this is roach's new comfortable light level", roach.cpp:381
		hl_ai_mon[s].rch_light = lit;
		hl_ai_mon[s].have_goal = FALSE;

		if (hl_ai_mon[s].rch_mode == HLRCH_SMELL_FOOD)
			hl_ai_mon[s].rch_mode = HLRCH_EAT;
		else
			hl_ai_mon[s].rch_mode = HLRCH_IDLE;

		HLAISetActivity(s, HLACT_IDLE);
		return;
	}

	//"random skitter while moving", roach.cpp:392, unless it is on a b-line
	if (HLPartRandI(150) == 1 &&
		hl_ai_mon[s].rch_mode != HLRCH_SCARED_LIGHT &&
		hl_ai_mon[s].rch_mode != HLRCH_SMELL_FOOD)
		HLAIRoachDest(s, HLRCH_BORED);
}

F64 HLAIMeleeDot(I64 s)
{//flDot, the value CheckAttacks hands every Check*Attack*, monsters.cpp:1006:
 //the dot of the monster's flat facing with the flat direction to its enemy.
 //1.0 with no enemy to face, so a caller is never blocked by a missing target.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 forward[3];
	F64			 ang[3];
	F64			 dir[3];
	F64			 feet[3];
	F64			 eye[3];

	if (!e || !hl_ai_mon[s].have_enemy)
		return 1.0;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return 1.0;

	//yaw only, as HLAIInViewCone is: nothing here pitches a monster
	HLVecSet(ang, 0.0, e->angles[1], 0.0);
	HLAngleVectors(ang, forward, NULL, NULL);

	HLVecSub(feet, e->origin, dir);
	dir[2] = 0.0;

	if (HLVecNormalize(dir) <= 0.0)
		return 1.0;

	return HLVecDot(dir, forward);
}

Bool HLAICanMelee(I64 s, F64 dist)
{//CheckMeleeAttack1: in reach, facing, and refire up
 //
 //flDot >= 0.7 is CBaseMonster::CheckMeleeAttack1, monsters.cpp:972, and every
 //override keeps it. The SDK's FL_ONGROUND test on the enemy is absent; no
 //monster here leaves the floor.
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee_range <= 0.0)
		return FALSE;

	if (dist > mi->melee_range)
		return FALSE;

	if (HLAIMeleeDot(s) < 0.7)
		return FALSE;

	//CBullsquid::CheckMeleeAttack1, bullsquid.cpp:359. The tailwhip is a
	//finisher, offered only when it would kill. melee2_dmg holds the whip's
	//figure, gSkillData.bullsquidDmgWhip.
	if (hl_ai_mon[s].kind == HLMON_BULLSQUID &&
		HLAITargetHealth(hl_ai_mon[s].enemy) > mi->melee2_dmg)
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanMelee2(I64 s, F64 dist)
{//CheckMeleeAttack2: the second melee take, which every monster that has one
 //picks at the same reach as the first
 //
 //flDot >= 0.7, CBaseMonster::CheckMeleeAttack2, monsters.cpp:984
	CHLMonInfo *mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	if (mi->melee2_range <= 0.0)
		return FALSE;

	if (dist > mi->melee2_range)
		return FALSE;

	//CGargantua::CheckMeleeAttack2, gargantua.cpp:934: flame beyond swipe
	//reach (GARG_ATTACKDIST 80), inside GARG_FLAME_LENGTH, dot >= 0.8
	if (hl_ai_mon[s].kind == HLMON_GARGANTUA)
	{
		if (HLAIMeleeDot(s) < 0.8)
			return FALSE;
		if (dist <= 80.0)
			return FALSE;
	}
	else if (HLAIMeleeDot(s) < 0.7)
		return FALSE;

	//CBullsquid::CheckMeleeAttack2, bullsquid.cpp:374: the bite yields to the
	//tailwhip. HLAISelectSchedule takes MELEE2 first, so without this the whip
	//never plays.
	if (hl_ai_mon[s].kind == HLMON_BULLSQUID && HLAICanMelee(s, dist))
		return FALSE;

	return ToBool(hl_ent_time >= hl_ai_mon[s].next_attack);
}

Bool HLAICanRange(I64 s, F64 dist)
{//CheckRangeAttack1: inside the band, refire up, ammo left, no squadmate in
 //the line, and a clear sight line. The SDK traces from the gun position,
 //this from the eye.
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 feet[3];
	F64			 eye[3];

	if (mi->range_max <= 0.0)
		return FALSE;

	if (dist < mi->range_min || dist > mi->range_max)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].next_attack)
		return FALSE;

	//bits_COND_NO_AMMO_LOADED. Only the grunt carries a clip
	if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
		return FALSE;

	//NoFriendlyFire: a grunt will not shoot through the man in front of him
	if (!HLAINoFriendlyFire(s))
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	return HLAIVisible(s, eye);
}

Bool HLAICanRange2(I64 s, F64 dist)
{//CheckRangeAttack2, monsters.cpp:959. Same tests as the first, over the
 //range2_ band. range2_max 0 stands in for bits_CAP_RANGE_ATTACK2, which
 //CheckAttacks consults before calling this at monsters.cpp:1021.
 //
 //Only the controller has a second ranged attack, so the clip and friendly
 //fire tests carry no row today; both are kept to match HLAICanRange.
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 feet[3];
	F64			 eye[3];

	if (mi->range2_max <= 0.0)
		return FALSE;

	if (dist < mi->range2_min || dist > mi->range2_max)
		return FALSE;

	if (hl_ent_time < hl_ai_mon[s].next_attack)
		return FALSE;

	if (mi->clip_size > 0 && hl_ai_mon[s].ammo <= 0)
		return FALSE;

	if (!HLAINoFriendlyFire(s))
		return FALSE;

	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
		return FALSE;

	return HLAIVisible(s, eye);
}

U0 HLAICheckEnemy(I64 s)
{//CBaseMonster::CheckEnemy plus CheckAttacks, monsters.cpp:1057 and :1005.
 //Runs after Look, on the same throttle, and raises the enemy-relative half of
 //the condition set: occlusion, death, range and which attacks have come open.
 //
 //m_vecEnemyLKP is hl_ai_mon[s].enemy_pos and Look already refreshed it on a
 //clear sight line, so the trailing-velocity fudge at monsters.cpp:1117 has
 //nothing to apply to and is absent.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLEntity	*enemy;
	F64			 feet[3];
	F64			 eye[3];
	F64			 d[3];
	F64			 dist;
	I64			 es;

	HLAIClearCond(s, HLCOND_ENEMY_FACING_ME | HLCOND_CAN_ATTACK |
		HLCOND_NO_AMMO_LOADED);

	if (!e || !hl_ai_mon[s].have_enemy)
		return;

	//an enemy that has left the world is a dead one as far as the selector is
	//concerned: both end in "find another or drop to ALERT"
	if (!HLAITargetPos(hl_ai_mon[s].enemy, feet, eye))
	{
		HLAISetCond(s, HLCOND_ENEMY_DEAD);
		HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
		return;
	}

	//"if ( !pEnemy->IsAlive() )", monsters.cpp:1073. Ahead of the occlusion
	//test, which the SDK clears again on this branch
	if (HLAITargetIsPlayer(hl_ai_mon[s].enemy))
	{
		if (hl_ent_player_dead)
		{
			HLAISetCond(s, HLCOND_ENEMY_DEAD);
			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
			return;
		}
	}
	else
	{
		enemy = HLEntGet(hl_ai_mon[s].enemy);

		if (!enemy || enemy->health <= 0.0)
		{
			HLAISetCond(s, HLCOND_ENEMY_DEAD);
			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED);
			return;
		}
	}

	//FVisible against the eye, the same trace Look used
	if (HLAIVisible(s, eye))
		HLAIClearCond(s, HLCOND_ENEMY_OCCLUDED);
	else
		HLAISetCond(s, HLCOND_ENEMY_OCCLUDED);

	//distance to the enemy's feet. The SDK takes the nearest of origin, head
	//and feet; the three differ by at most half a hull and only ENEMY_TOOFAR
	//and the attack bands read it, all of which are hundreds of units wide
	HLVecSub(feet, e->origin, d);
	dist = HLVecLength(d);

	if (dist >= HLAI_DIST_TOOFAR)
		HLAISetCond(s, HLCOND_ENEMY_TOOFAR);
	else
		HLAIClearCond(s, HLCOND_ENEMY_TOOFAR);

	//"pEnemyMonster->FInViewCone(this)", monsters.cpp:1108. Only a monster
	//enemy: MyMonsterPointer is NULL on a player, so the bit never rises
	//against one
	if (HLAIHasCond(s, HLCOND_SEE_ENEMY) &&
		!HLAITargetIsPlayer(hl_ai_mon[s].enemy) &&
		hl_ai_mon[s].enemy >= 0 && hl_ai_mon[s].enemy < HLENT_MAX)
	{
		es = hl_ai_mon_of[hl_ai_mon[s].enemy];

		if (es >= 0 && HLAIInViewCone(es, e->origin))
			HLAISetCond(s, HLCOND_ENEMY_FACING_ME);
	}

	//bits_COND_NO_AMMO_LOADED, CheckAmmo. Only the grunt carries a clip
	if (hl_ai_mon_info[hl_ai_mon[s].kind].clip_size > 0 &&
		hl_ai_mon[s].ammo <= 0)
		HLAISetCond(s, HLCOND_NO_AMMO_LOADED);

	//FCanCheckAttacks, monsters.cpp:1044: attacks are only tested with the
	//enemy in sight and inside m_flDistTooFar
	if (!HLAIHasCond(s, HLCOND_SEE_ENEMY) ||
		HLAIHasCond(s, HLCOND_ENEMY_TOOFAR))
		return;

	if (HLAICanRange(s, dist))
		HLAISetCond(s, HLCOND_CAN_RANGE1);

	if (HLAICanRange2(s, dist))
		HLAISetCond(s, HLCOND_CAN_RANGE2);

	if (HLAICanMelee(s, dist))
		HLAISetCond(s, HLCOND_CAN_MELEE1);

	if (HLAICanMelee2(s, dist))
		HLAISetCond(s, HLCOND_CAN_MELEE2);
}

I64 HLAISelectSchedule(I64 s)
{//CBaseMonster::GetSchedule, per state, with the per-monster GetSchedule
 //overrides folded in through the table: what differs between CHGrunt's and
 //CBullsquid's is which slots gate the attack and whether there is a clip,
 //both of which are rows here
	CHLEntity	*e  = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi = &hl_ai_mon_info[hl_ai_mon[s].kind];
	F64			 d[3];
	F64			 tgt[3];
	F64			 tdelta[3];
	F64			 dist;

	if (!e)
		return HLSCHED_IDLE_STAND;

	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
		return HLSCHED_DIE;

	if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
	{
		//schedule.cpp:1409-1470's arms, in its order, with the per-monster
		//overrides CHGrunt and CBarney add folded in through the table.
		//
		//Every attack is chosen off the HLCOND_CAN_ bits HLAICheckEnemy raised
		//and not by re-testing reach here: the SDK samples its conditions once
		//a think, so an attack that came open a fifth of a second ago is the
		//one taken. That is what keeps a monster committed to a swing.
		if (!hl_ai_mon[s].have_enemy || HLAIHasCond(s, HLCOND_ENEMY_DEAD))
		{
			//"clear the current (dead) enemy and try to find another",
			//schedule.cpp:1411. Look finds the next one on its own pass
			hl_ai_mon[s].have_enemy = FALSE;

			HLAIClearCond(s, HLCOND_ENEMY_DEAD);
			HLAISetState(s, HLMSTATE_ALERT);

			return HLSCHED_ALERT_STAND;
		}

		HLVecSub(hl_ai_mon[s].enemy_pos, e->origin, d);
		dist = HLVecLength(d);

		//a monster with no attack runs. CScientist's SelectSchedule is this
		//plus a stack of talk behaviours
		if (mi->flees)
			return HLSCHED_TAKE_COVER;

		//bits_COND_NO_AMMO_LOADED beats everything else CHGrunt::GetSchedule
		//tests, which is why a grunt reloads in the open
		if (HLAIHasCond(s, HLCOND_NO_AMMO_LOADED))
			return HLSCHED_RELOAD;

		//CBarney::GetSchedule draws the pistol before its first shot
		if (!hl_ai_mon[s].gun_drawn &&
			HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_ARM))
		{
			hl_ai_mon[s].gun_drawn = TRUE;
			return HLSCHED_ARM_WEAPON;
		}

		//schedule.cpp:1427. The wake-up beat, on the transition into combat
		//and on a switch of target
		if (HLAIHasCond(s, HLCOND_NEW_ENEMY))
			return HLSCHED_WAKE_ANGRY;

		//schedule.cpp:1434: light damage flinches once per monster, and never
		//over an attack take - those schedules leave the damage bits out of
		//their interrupt masks, so this arm is only reached between them
		if (HLAIHasCond(s, HLCOND_LIGHT_DAMAGE) && !hl_ai_mon[s].flinched)
			return HLSCHED_SMALL_FLINCH;

		//schedule.cpp:1438. No sight line: turn to the last known position when
		//the enemy is merely behind, run at it when the world is in the way
		if (!HLAIHasCond(s, HLCOND_SEE_ENEMY))
		{
			if (!HLAIHasCond(s, HLCOND_ENEMY_OCCLUDED))
				return HLSCHED_COMBAT_FACE;

			//out of contact for a while but not yet forgotten: hold and watch
			//instead of charging the last known position over and over
			if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY * 0.5)
				return HLSCHED_STANDOFF;

			return HLSCHED_CHASE_ENEMY;
		}

		//the heavier swing first when both are in reach. schedule.cpp:1464
		//takes MELEE1 first; the two only overlap on the zombie and the agrunt,
		//whose takes carry the same figure. CBullsquid gates the two apart in
		//HLAICanMelee2, so the order does not reach it.
		if (HLAIHasCond(s, HLCOND_CAN_MELEE2))
			return HLSCHED_MELEE_ATTACK2;

		if (HLAIHasCond(s, HLCOND_CAN_MELEE1))
			return HLSCHED_MELEE_ATTACK1;

		if (HLAIHasCond(s, HLCOND_CAN_RANGE1))
		{
			//the squad gate. CHGrunt::GetSchedule takes an engage slot before
			//standing up to fire and stands off when there is none, so two of
			//a fireteam shoot and the rest hold or move.
			if (!mi->slot_attack || HLAIOccupySlot(s, mi->slot_attack))
				return HLSCHED_RANGE_ATTACK1;

			//no slot: get out of the doorway rather than queue in it
			if (hl_ai_mon[s].in_cover)
				return HLSCHED_STANDOFF;

			return HLSCHED_TAKE_COVER;
		}

		//schedule.cpp:1461. The second ranged attack, the controller's head
		//zap. Ungated by a squad slot: no monster with one forms squads.
		if (HLAIHasCond(s, HLCOND_CAN_RANGE2))
			return HLSCHED_RANGE_ATTACK2;

		//in melee reach with the refire up but facing away. schedule.cpp:1476
		//returns SCHED_COMBAT_FACE on the same FacingIdeal failure; chasing an
		//enemy already at arm's length has nowhere to move to.
		if (mi->melee_range > 0.0 && dist <= mi->melee_range &&
			HLAIMeleeDot(s) < 0.7)
			return HLSCHED_COMBAT_FACE;

		//in range but not ready to swing or shoot: stand and face rather than
		//chase. Otherwise the chase schedule restarts every few ticks while
		//the refire runs down, which reads as running on the spot; for a
		//ranged monster it is also what holds barney and the grunts at a
		//firing line instead of closing to arm's length.
		//
		//Read live rather than off a condition: the refire clock moves between
		//sense passes and no bits_COND_ carries it
		if (hl_ent_time < hl_ai_mon[s].next_attack)
		{
			if (mi->melee_range > 0.0 && dist <= mi->melee_range)
				return HLSCHED_COMBAT_FACE;

			if (mi->range_max > 0.0 && dist >= mi->range_min &&
				dist <= mi->range_max)
				return HLSCHED_COMBAT_STAND;

			if (mi->range2_max > 0.0 && dist >= mi->range2_min &&
				dist <= mi->range2_max)
				return HLSCHED_COMBAT_STAND;
		}

		return HLSCHED_CHASE_ENEMY;
	}

	//following the player, in IDLE or ALERT: face and follow, the loop
	//CScientist::GetSchedule enters at scientist.cpp:985. A dead leader ends
	//the follow rather than being chased around as a corpse.
	if (hl_ai_mon[s].ent >= 0 && hl_ai_mon[s].ent < HLENT_MAX &&
		HLAITalkIsFollowing(hl_ai_mon[s].ent))
	{
		if (hl_ent_player < 0 || hl_ent_player_dead)
			HLAITalkStopFollowing(hl_ai_mon[s].ent, FALSE);
		else if (!hl_ai_mon[s].have_enemy)
		{
			//scientist.cpp:978-983: inside 128 units of the leader, a
			//scientist heals before it goes back to facing. TargetDistance is
			//the 3D distance to m_hTargetEnt
			if (HLAICanHeal(s) && HLAITalkPointOf(HLTLK_PLAYER, tgt))
			{
				HLVecSub(tgt, e->origin, tdelta);

				if (HLVecLength(tdelta) <= HLAI_FOLLOW_DIST)
					return HLSCHED_HEAL;
			}

			return HLSCHED_TARGET_FACE;
		}
	}

	if (hl_ai_mon[s].state == HLMSTATE_ALERT)
	{
		//schedule.cpp:1383. The enemy died while this monster was alert rather
		//than fighting, and the model has a take for gloating
		if (HLAIHasCond(s, HLCOND_ENEMY_DEAD))
		{
			HLAIClearCond(s, HLCOND_ENEMY_DEAD);

			if (HLAIMonSeqOf(hl_ai_mon[s].kind, HLACT_VICTORY))
				return HLSCHED_VICTORY_DANCE;
		}

		if (hl_ai_mon[s].have_enemy)
			return HLSCHED_ALERT_FACE;

		//schedule.cpp:1389. Shot at with nothing in sight: flinch, then face
		//where it came from.
		//
		//The SDK splits on FlYawDiff against m_vecEnemyLKP and runs
		//slTakeCoverFromOrigin when already facing that way. Nothing here calls
		//MakeIdealYaw on damage, so ideal_yaw carries no attack direction to
		//split on and only the flinch arm is taken.
		if (HLAIHasCond(s, HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE))
			return HLSCHED_ALERT_SM_FLINCH;

		//bits_COND_HEAR_SOUND. A danger sound is run from; anything else is
		//walked to, which is CBaseMonster::GetSchedule's own split
		if (HLAIHasCond(s, HLCOND_HEAR_SOUND) && hl_ai_mon[s].heard >= 0)
		{
			if (hl_ai_mon[s].heard_type & HLSOUND_DANGER)
				return HLSCHED_COVER_SOUND;

			return HLSCHED_INVEST_SOUND;
		}

		return HLSCHED_ALERT_STAND;
	}

	//MONSTERSTATE_IDLE. A noise wakes it into ALERT rather than being acted
	//on from here, which is what CBaseMonster::GetIdealState does
	if (HLAIHasCond(s, HLCOND_HEAR_SOUND) && hl_ai_mon[s].heard >= 0)
	{
		HLAISetState(s, HLMSTATE_ALERT);
		return HLSCHED_ALERT_STAND;
	}

	return HLSCHED_IDLE_STAND;
}

//--- what a corpse leaves behind --------------------------------------------
//
// CBaseMonster::DropItem, monsters.cpp:3403. Two monsters in this port drop
// anything: CHGrunt on HGRUNT_AE_DROP_GUN (hgrunt.cpp:849-873) and CBarney in
// Killed (barney.cpp:614-624). 163 grunts and 39 barneys are placed across the
// shipped maps and none of them yielded a round before this.
//
// Deviation: the grunt's drop is an animation event partway through its death
// take, so the SDK spawns the gun where the hand is at that frame. It is done
// at the moment of death here, and the anim event dispatcher would fire it
// once per replay of the take.

U0 HLAIDropItem(I64 s, U8 *classname, F64 up)
{//DropItem at the monster's origin lifted by `up`. The SDK reads attachment 0
 //for the gun and BodyTarget for the grenades; both land within a hull of this
 //and only the pickup box, which is 32 units on a side, reads the position.
 //
 //pev->velocity and the random spin DropItem gives the item are not carried:
 //HLEntCreateNamed makes a MOVETYPE_NONE pickup that hangs where it is made
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	F64			 pos[3];

	if (!e)
		return;

	HLVecCopy(e->origin, pos);

	pos[2] = pos[2] + up;

	HLEntCreateNamed(classname, pos, e->angles, hl_ai_mon[s].ent);
}

//"pev->origin + (0,0,32)": above the floor the corpse is lying on, so the
//pickup box is not buried in it
#define HLAI_DROP_UP			32.0

U0 HLAIDropDeathItems(I64 s)
{//everything the monster was carrying, once, at the moment health crosses zero
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	I64			 gun;

	if (!e)
		return;

	//CBarney::Killed, barney.cpp:614. "if ( pev->body < BARNEY_BODY_GUNGONE )"
	//- a barney killed twice does not drop two pistols
	if (hl_ai_mon[s].kind == HLMON_BARNEY)
	{
		if (HLAIBodygroup(e->studio, e->body, HLBARNEY_GUN_GROUP) >=
			HLBARNEY_GUN_GONE)
			return;

		HLAISetBodygroup(e, HLBARNEY_GUN_GROUP, HLBARNEY_GUN_GONE);
		HLAIDropItem(s, "weapon_9mmhandgun", HLAI_DROP_UP);

		return;
	}

	//CHGrunt::HandleAnimEvent, hgrunt.cpp:849-873
	if (hl_ai_mon[s].kind != HLMON_HGRUNT)
		return;

	gun = HLAIBodygroup(e->studio, e->body, HLGRUNT_GUN_GROUP);

	if (gun == HLGRUNT_GUN_NONE)
		return;

	HLAISetBodygroup(e, HLGRUNT_GUN_GROUP, HLGRUNT_GUN_NONE);

	if (gun == HLGRUNT_GUN_SHOTGUN)
		HLAIDropItem(s, "weapon_shotgun", HLAI_DROP_UP);
	else
		HLAIDropItem(s, "weapon_9mmAR", HLAI_DROP_UP);

	//hgrunt.cpp:868, read off the head bodygroup for the reason above. The
	//SDK drops these at BodyTarget(pev->origin), the hull centre, which for a
	//16x72 grunt is four units above HLAI_DROP_UP
	if (HLAIBodygroup(e->studio, e->body, HLGRUNT_HEAD_GROUP) ==
		HLGRUNT_HEAD_M203)
		HLAIDropItem(s, "ammo_ARgrenades", HLAI_DROP_UP);
}

U0 HLAIMonThink(I64 s, F64 dt)
{//CBaseMonster::MonsterThink for one monster
 //
 //the SDK runs this on a 0.1s think and lets the engine's monster mover
 //integrate movement in between. There is no such mover here - HLAIMoveStep is
 //the movement - so it runs on the server tick. Every decision it makes is
 //time-based, so the cadence change is invisible.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	CHLMonInfo	*mi;
	CHLTrace	 leap_tr;
	F64			 gib_dir[3];
	F64			 leap_start[3];
	F64			 leap_end[3];
	F64			 over;
	F64			 dur;
	I64			 bits;
	I64			 seq;
	Bool		 gib;
	Bool		 human;

	if (!e)
		return;

	mi = &hl_ai_mon_info[hl_ai_mon[s].kind];

	//--- headcrab leap / monsterjump toss ---
	if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
	{
		hl_ai_mon[s].leap_vel[2] -= HLPHYS_GRAVITY * dt;
		HLVecCopy(e->origin, leap_start);
		HLVecMA(leap_start, dt, hl_ai_mon[s].leap_vel, leap_end);

		hl_ent_clip_ignore  = hl_ai_mon[s].ent;
		hl_clip_for_monster = TRUE;
		HLTraceEntity(hl_map, leap_start, leap_end, e->mins, e->maxs, 0,
			FALSE, &leap_tr);
		hl_ent_clip_ignore  = -1;
		hl_clip_for_monster = FALSE;

		HLVecCopy(leap_tr.end_pos, e->origin);
		HLEntSetAbsBox(e);

		//LeapTouch: headcrab attack only
		if (hl_ai_mon[s].leaping && hl_ent_clip_hit_player)
		{
			HLAIHullAttack(s, mi->melee_range * 1.5, mi->melee_dmg);
			hl_ai_mon[s].leaping = FALSE;
		}
		else if (leap_tr.fraction < 1.0 || hl_ent_time >= hl_ai_mon[s].leap_die)
		{
			hl_ai_mon[s].leaping = FALSE;
			hl_ai_mon[s].tossing = FALSE;
		}

		if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
			return;
	}

	//--- tripmine ---
	//
	//CTripmineGrenade is a CGrenade. Ahead of the death path: its death is a
	//detonation and it leaves no corpse to gib or animate
	if (hl_ai_mon[s].kind == HLMON_TRIPMINE)
	{
		HLAITripmineThink(s);
		return;
	}

	//--- sentry / turret / miniturret ---
	//
	//CBaseTurret runs think functions rather than schedules, and CSentry
	//overrides Killed with SentryDeath: no gibs, no corpse pose off the shared
	//table, and the wreck keeps smoking for five seconds
	if (HLAIIsTurretKind(hl_ai_mon[s].kind))
	{
		HLAISentryThink(s);
		return;
	}

	//--- cockroach ---
	//
	//CRoach overrides MonsterThink. Ahead of the death path: UTIL_Remove takes
	//it out of the world rather than leaving a corpse
	if (hl_ai_mon[s].kind == HLMON_COCKROACH)
	{
		HLAIRoachThink(s);
		return;
	}

	//--- death, first: nothing else applies to a corpse ---
	if (hl_ai_mon[s].state == HLMSTATE_DEAD)
	{
		HLAIRunSchedule(s, dt);
		return;
	}

	if (e->health <= 0.0)
	{
		hl_ai_mon[s].last_health = 0.0;
		hl_ai_mon_kills++;

		//the gun, before the gib branch: a gibbed grunt still drops its MP5 in
		//the SDK, GibMonster leaving pev->body alone
		HLAIDropDeathItems(s);

		//a corpse is bits_SOUND_CARCASS for half a minute, which is what a
		//bullsquid comes to eat. CSoundEnt's own carcass lifetime
		HLAIInsertSound(HLSOUND_CARCASS, e->origin, 256.0, 30.0);

		//CBaseMonster::TakeDamage reads bitsDamageType where health crosses
		//zero and picks GIB_ALWAYS, GIB_NEVER or GIB_NORMAL from it
		//(dlls/combat.cpp:911-925); ShouldGibMonster (:535) turns GIB_NORMAL
		//into a gib only below GIB_HEALTH_VALUE.
		//
		//HLEntTakeDamageType clamps a dead entity's health to zero, so the
		//overkill comes from the damage note and not from e->health
		bits = HLDmgNoteBits(hl_ai_mon[s].ent);
		over = HLDmgNoteHealth(hl_ai_mon[s].ent);
		gib  = FALSE;

		if ((bits & HLDMG_ALWAYSGIB) != 0)
			gib = TRUE;
		else if ((bits & HLDMG_NEVERGIB) == 0 && over < HLGIB_HEALTH_VALUE)
			gib = TRUE;

		if (gib)
		{
			//HasHumanGibs, dlls/combat.cpp:256 - hgibs.mdl for the human
			//classes, agibs.mdl for everything else
			human = ToBool(mi->classify == HLCLASS_HUMAN_MILITARY ||
				mi->classify == HLCLASS_HUMAN_PASSIVE ||
				mi->classify == HLCLASS_PLAYER_ALLY);

			//GibMonster opens with the splat, dlls/combat.cpp:307, on
			//CHAN_WEAPON
			HLSndPlayAt("common/bodysplat.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, HLCHAN_WEAPON);

			//g_vecAttackDir via hl_attack_dir
			HLVecCopy(hl_attack_dir, gib_dir);

			//four pieces either way. The velocity scale reads the victim's
			//health, which is the overkill and not max_health
			HLGibSpawnRandomGibs(e->absmin, e->size, gib_dir, over,
				HLGIB_DEATH_COUNT, human, mi->blood, hl_ent_time);

			//only humans throw skulls, dlls/combat.cpp:310-315
			if (human)
				HLGibSpawnHeadGib(e->origin, e->origin, over, mi->blood,
					hl_ent_time);
		}

		//CBarnacle::Killed drops whatever it was holding before the shared
		//path takes over, barnacle.cpp:326
		if (hl_ai_mon[s].kind == HLMON_BARNACLE)
			HLAIBarnacleKilled(s);

		//a victim killed on the tongue stops being the barnacle's; its host
		//notices on the next think either way, this clears the back pointer
		if (hl_ai_mon[s].barn_host >= 0)
		{
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_prey = -1;
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_lifting = FALSE;
			hl_ai_mon[hl_ai_mon[s].barn_host].barn_kill = -1.0;
			hl_ai_mon[s].barn_host = -1;
			e->movetype = HLMOVETYPE_STEP;
		}

		HLAISetState(s, HLMSTATE_DEAD);
		HLAISetSchedule(s, HLSCHED_DIE);
		return;
	}

	//--- hanging from a tongue ---
	//
	//MONSTERSTATE_PRONE. The victim schedules end on TASK_WAIT_INDEFINITE, so
	//the take plays and nothing selects over it. Sensing, movement and the
	//selector are all skipped: the barnacle owns the position.
	if (hl_ai_mon[s].barn_host >= 0)
	{
		HLAIRunSchedule(s, dt);
		return;
	}

	//--- barnacle ---
	//
	//BarnacleThink replaces the state machine outright
	if (hl_ai_mon[s].kind == HLMON_BARNACLE)
	{
		HLAIBarnacleThink(s);
		return;
	}

	//--- damage taken since the last tick ---
	//
	//HLEntity.ZC compiles first, so there is no hook in HLEntTakeDamage and the
	//health drop is detected instead.
	//
	//CBaseMonster::TakeDamage raises LIGHT_DAMAGE on any damage and adds
	//HEAVY_DAMAGE at 20 or more, combat.cpp:957-963. Which schedules that
	//aborts is the interrupt mask's business, not this block's: the attack
	//schedules leave both bits out, so a burst landing on a swinging zombie no
	//longer cancels the swing, and the flinch itself is chosen by the selector.
	if (e->health < hl_ai_mon[s].last_health)
	{
		if (hl_ai_mon[s].last_health - e->health >= HLAI_HEAVY_DAMAGE)
			HLAISetCond(s, HLCOND_HEAVY_DAMAGE);

		HLAISetCond(s, HLCOND_LIGHT_DAMAGE);

		hl_ai_mon[s].last_health = e->health;

		if (hl_ai_mon[s].state == HLMSTATE_IDLE)
			HLAISetState(s, HLMSTATE_ALERT);

		//being shot at is a combat sound in its own right, which is how a
		//squad two rooms away learns there is a fight
		HLAIInsertSound(HLSOUND_COMBAT, e->origin, 384.0, 0.3);
	}

	hl_ai_mon[s].last_health = e->health;

	//--- settle on the floor ---
	//
	//DROP_TO_FLOOR, as every CBaseMonster::Spawn does. Mappers place monsters a
	//few units clear of the ground and nothing integrates gravity for a STEP
	//entity here, so without this they hover for the whole level. The reach is
	//256 units: measured over valve/maps, 145 ground instances stand further
	//than 36 above their floor, which is all the step probe could cross.
	if (!hl_ai_mon[s].settled)
	{
		hl_ai_mon[s].settled = TRUE;

		//a MOVETYPE_FLY monster holds the height the mapper put it at
		if (!mi->flies &&
			HLAIDropToFloorHard(e, e->mins, e->maxs, e->origin))
			HLEntSetAbsBox(e);
	}

	//--- generic ---
	//
	//CGenericMonster is a CBaseMonster with no GetSchedule, no attack and
	//ISoundMask NULL. It reaches here for the death path, the damage bits and
	//the floor drop above, and stops: what it wears is the mapper's model key,
	//and half the shipped instances are ribcages and bone piles. Running the
	//base class's sensing and chase over those moves scenery across the room.
	//
	//Its state stays MONSTERSTATE_NONE in the SDK and IDLE here, which is what
	//lets a scripted_sequence claim it by classname - see HLAICanPlaySequence
	if (hl_ai_mon[s].kind == HLMON_GENERIC)
		return;

	//--- squad formation ---
	//
	//CSquadMonster::StartMonster runs one SquadRecruit on the first think,
	//never again: a squad is whoever was standing together when the map
	//started, and a reinforcement that walks in later joins nothing.
	if (!hl_ai_mon[s].squad_tried)
	{
		hl_ai_mon[s].squad_tried = TRUE;

		if (mi->squads)
			HLAISquadRecruit(s, HLAI_SQUAD_RADIUS, HLAI_SQUAD_MAX - 1);
	}

	//--- eye blink ---
	//
	//pev->skin picks a skin family and the eye is a family swap: houndeyet.mdl
	//carries three families differing only in eye.bmp, bullsquidt.mdl two.
	//
	//m_fDontBlink, which houndeye.cpp raises while the monster sleeps, has no
	//counterpart: nothing here puts a houndeye to sleep.
	if (hl_ent_time >= hl_ai_mon[s].next_blink)
	{
		hl_ai_mon[s].next_blink = hl_ent_time + 0.1;

		//houndeye.cpp:856-866. HOUNDEYE_EYE_FRAMES is 4, houndeye.cpp:38, so a
		//blink starts at family 3 and counts down one family per think
		if (hl_ai_mon[s].kind == HLMON_HOUNDEYE)
		{
			if (e->skin == 0)
			{
				if (HLPartRandI(128) == 0)
					e->skin = 3;
			}
			else
				e->skin--;
		}

		//bullsquid.cpp:779-789: the eye is cleared every think and reopened by
		//the roll that follows, so a blink lasts exactly one think
		if (hl_ai_mon[s].kind == HLMON_BULLSQUID)
		{
			e->skin = 0;

			if (HLPartRandI(40) == 0)
				e->skin = 1;
		}
	}

	//--- sensing ---
	//
	//RunAI's order: Look, Listen, then CheckEnemy on whatever Look settled on
	//(monsterstate.cpp:86-97). All three on the one throttle, so the condition
	//set is coherent - CheckEnemy reads the SEE_ENEMY bit Look just wrote
	if (hl_ent_time >= hl_ai_mon[s].next_look)
	{
		hl_ai_mon[s].next_look = hl_ent_time + HLAI_LOOK_PERIOD;
		HLAILook(s);
		HLAIListen(s);
		HLAISmell(s);
		HLAICheckEnemy(s);
	}

	if (hl_ai_mon[s].have_enemy)
	{
		//CheckEnemy drops m_hEnemy after this long with no sight line, which
		//stops a monster staring at a wall
		if (hl_ent_time - hl_ai_mon[s].enemy_seen > HLAI_LOSE_ENEMY)
		{
			hl_ai_mon[s].have_enemy = FALSE;

			HLAIClearCond(s, HLCOND_SEE_ENEMY | HLCOND_ENEMY_OCCLUDED |
				HLCOND_ENEMY_TOOFAR | HLCOND_ENEMY_FACING_ME |
				HLCOND_CAN_ATTACK);

			if (hl_ai_mon[s].state == HLMSTATE_COMBAT)
				HLAISetState(s, HLMSTATE_ALERT);
		}
		else if (hl_ai_mon[s].state != HLMSTATE_COMBAT)
		{
			//GetIdealState's IDLE and ALERT arms, monsterstate.cpp:137 and
			//:180: NEW_ENEMY or SEE_ENEMY moves the monster to COMBAT.
			//
			//CSquadMonster::GetIdealState calls SquadMakeEnemy on
			//bits_COND_NEW_ENEMY, so the whole squad turns on what one member
			//saw rather than each finding it separately.
			//
			//The wake-up beat is no longer set here: SetState drops the
			//schedule and the selector reads NEW_ENEMY to pick slWakeAngry,
			//which is where CBaseMonster::GetSchedule chooses it
			//(schedule.cpp:1427)
			HLAISquadMakeEnemy(s, hl_ai_mon[s].enemy);

			HLAISetState(s, HLMSTATE_COMBAT);
		}
	}

	//--- idle noises ---
	//
	//HL calls IdleSound from inside the idle schedules. Driving it from the
	//think instead keeps it out of combat, where the attack and alert lines
	//take the channel
	if (hl_ai_mon[s].state != HLMSTATE_COMBAT && mi->snd_idle[0])
	{
		if (hl_ent_time >= hl_ai_mon[s].next_idle_snd)
		{
			HLAIMonSound(s, mi->snd_idle);
			hl_ai_mon[s].next_idle_snd = hl_ent_time + HLAI_IDLE_SND_MIN +
				ToF64(HLPartRandI(HLAI_IDLE_SND_RANGE));
		}
	}

	//--- speech ---
	//
	//CTalkMonster's idle stack. A monster that is not a talker returns from
	//this at once.
	HLAITalkThink(s, dt);

	//--- schedule ---
	//
	//MaintainSchedule, schedule.cpp:200. Validate, re-select, then run, all in
	//one pass: the two damage bits are dropped at the foot of this function, so
	//a schedule they interrupt has to be replaced on the same tick or the
	//flinch they were raised for never happens.
	//
	//HLAISelectSchedule runs before HLAISetSchedule clears the condition set,
	//so the bits that ended the last schedule are the ones that pick the next
	if (!HLAISchedValid(s))
		hl_ai_mon[s].sched_done = TRUE;

	if (hl_ai_mon[s].sched == HLSCHED_NONE || hl_ai_mon[s].sched_done)
		HLAISetSchedule(s, HLAISelectSchedule(s));

	HLAIRunSchedule(s, dt);

	//--- fidget ---
	//
	//monsters.cpp:530-551, which sits in MonsterThink after RunAI and not in
	//any schedule. A monster standing on ACT_IDLE re-rolls its idle each time
	//the take runs out: a looping one may land on a fidget, and a fidget having
	//ended returns to the heaviest weighted idle rather than to another fidget.
	//This is the only caller of LookupActivityHeaviest in the SDK.
	//
	//The take is set here rather than through HLAISetActivity, whose job is to
	//resolve an activity: m_Activity does not change across a fidget.
	if (hl_ai_mon[s].state != HLMSTATE_SCRIPT &&
		hl_ai_mon[s].state != HLMSTATE_DEAD &&
		hl_ai_mon[s].activity == HLACT_IDLE && e->studio &&
		hl_ent_time >= hl_ai_mon[s].next_fidget)
	{
		if (e->anim_loop)
			seq = HLStudioLookupActivity(e->studio, HLAIActToSDK(HLACT_IDLE));
		else
			seq = HLStudioLookupActivityHeaviest(e->studio,
				HLAIActToSDK(HLACT_IDLE));

		if (seq >= 0 && seq != e->seq)
		{
			//ResetSequenceInfo, animating.cpp:110
			e->seq              = seq;
			e->anim_start       = hl_ent_time;
			e->anim_done        = FALSE;
			e->anim_event_frame = -1;
			e->anim_loop        = HLStudioSeqLoops(e->studio, seq);

			//HLAISetActivity's "already playing it" gate compares against this
			hl_ai_mon[s].act_seq = seq;
		}

		dur = HLStudioSeqDuration(e->studio, e->seq);

		//a take with no duration would re-roll every tick
		if (dur <= 0.0)
			dur = 1.0;

		hl_ai_mon[s].next_fidget = hl_ent_time + dur;
	}

	//"we throw them out cause we don't want them sitting around through the
	//lifespan of a schedule that doesn't use them", monsterstate.cpp:109-111.
	//The two damage bits last one think and no longer
	HLAIClearCond(s, HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE);
}

U0 HLAIMonsterJumpCheck()
{//CTriggerMonsterJump::Touch for every live AI slot. Player touch never
 //reaches these volumes; HLEntTouchPlayer only tests the player box.
	CHLEntity	*trig;
	CHLEntity	*mon;
	F64			 speed;
	F64			 height;
	I64			 s;
	I64			 i;

	if (!hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		trig = &hl_entities[i];

		if (!trig->in_use || trig->touch_fn != HLM_MONSTERJUMP_TOUCH)
			goto qmj_trig;

		if (trig->solid != HLSOLID_TRIGGER)
			goto qmj_trig;

		speed  = trig->speed;
		height = trig->height;
		if (speed <= 0.0)
			speed = 200.0;
		if (height <= 0.0)
			height = 150.0;

		for (s = 0; s < hl_ai_mon_count; s++)
		{
			if (hl_ai_mon[s].ent < 0)
				goto qmj_mon;

			if (hl_ai_mon[s].leaping || hl_ai_mon[s].tossing)
				goto qmj_mon;

			if (hl_ai_mon[s].state == HLMSTATE_DEAD)
				goto qmj_mon;

			mon = HLEntGet(hl_ai_mon[s].ent);
			if (!mon || !mon->in_use)
				goto qmj_mon;

			if (!HLEntBoxOverlap(trig, mon->absmin, mon->absmax))
				goto qmj_mon;

			mon->origin[2] += 1.0;
			HLEntSetAbsBox(mon);

			HLVecScale(trig->move_dir, speed, hl_ai_mon[s].leap_vel);
			hl_ai_mon[s].leap_vel[2] += height;
			hl_ai_mon[s].tossing     = TRUE;
			hl_ai_mon[s].leap_die    = hl_ent_time + 2.0;

			HLEntSetThink(trig, HLM_MONSTERJUMP_THINK, hl_ent_time);

qmj_mon:
		}

qmj_trig:
	}
}

U0 HLAIMonsterFrame(F64 dt)
{//every tracked monster, one tick
	CHLEntity	*e;
	F64			 d[3];
	I64			 s;
	I64			 i;

	HLAIMonSync;

	//"nodegraph 1" in the console turns the route diagnostics on. The Bool
	//had no writer; the cvar never reached it
	hl_ai_graph_log = ToBool(HLCvarGet("nodegraph") != 0.0);

	//how far the player moved since the last monster frame, which stands in
	//for pev->velocity being nonzero
	HLVecSub(hl_ent_player_org, hl_ai_player_last, d);
	hl_ai_player_move = HLVecLength(d);
	HLVecCopy(hl_ent_player_org, hl_ai_player_last);

	//read once per frame, not once per script tick: the trace is turned on with
	//a level already running
	hl_ai_script_log = ToBool(HLCvarGet("scriptlog") != 0.0);
	hl_ai_graph_log  = ToBool(HLCvarGet("nodegraph") != 0.0);

	//load the map's node graph here rather than on the first route request, so
	//HLAIMonReport describes the map that is up. A no-op once the name matches
	HLAIGraphEnsure();

	if (!hl_ai_mon_count || !hl_map)
		return;

	HLAIMonsterJumpCheck;

	//--- who is under script control this tick ---
	//
	//m_pCine, which here is hl_ai_cine[ent].owner. It is set from the moment a
	//script possesses its actor, not from the moment the play take starts: an
	//actor posed in m_iszIdle on its mark is already the script's and must not
	//be walked off it by the selector.
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		s = hl_ai_mon[i].ent;

		if (s < 0 || s >= HLENT_MAX)
			hl_ai_mon[i].scripted = FALSE;
		else
			hl_ai_mon[i].scripted = ToBool(hl_ai_cine[s].owner >= 0);
	}

	//--- think ---
	for (i = 0; i < hl_ai_mon_count; i++)
	{
		if (hl_ai_mon[i].ent < 0)
			goto qamf_next;

		e = HLEntGet(hl_ai_mon[i].ent);

		if (!e)
		{
			//the entity system removed it: HLEntTakeDamage queues
			//HLM_BREAK_DIE and HLBreakableDie clears in_use - right for glass,
			//wrong for a monster, and that call is in HLEntity.ZC. Put the
			//corpse back, inert, so it falls over instead of blinking out.
			if (!hl_ai_mon_revive || hl_ai_mon[i].state == HLMSTATE_DEAD)
				goto qamf_next;

			if (hl_ai_mon[i].ent >= hl_num_entities)
				goto qamf_next;

			e = &hl_entities[hl_ai_mon[i].ent];

			e->in_use     = TRUE;
			e->solid      = HLSOLID_NOT;
			e->movetype   = HLMOVETYPE_NONE;
			e->takedamage = HLDMG_TAKE_NO;
			e->think_fn   = HLM_NONE;
			e->next_think = 0.0;
			e->health     = 0.0;
		}

		if (hl_ai_mon[i].scripted)
		{
			//MONSTERSTATE_SCRIPT: the script's task list runs instead of the
			//AI's. CineCleanup drops the schedule and returns it to IDLE.
			HLAISetState(i, HLMSTATE_SCRIPT);
			HLAICineActorTick(i, dt);
			goto qamf_next;
		}

		if (hl_ai_mon[i].state == HLMSTATE_SCRIPT)
			HLAISetState(i, HLMSTATE_IDLE);

		if (hl_ai_mon[i].state == HLMSTATE_NONE)
			HLAISetState(i, HLMSTATE_IDLE);

		HLAIMonThink(i, dt);

qamf_next:
	}
}

//--- ReportAIState ----------------------------------------------------------
//
// CBaseMonster::ReportAIState, monsters.cpp, which impulse 103 reaches through
// player.cpp. The names come out of comparison chains rather than U8* tables:
// adjacent string literals concatenate and truncate at the first NUL on this
// compiler, so a table of literals collapses to one entry.

U8 *HLAIStateName(I64 state)
{//pStateNames[] in ReportAIState. The SDK's array is in enum order, which is
 //None Idle Combat Alert Hunt Prone Scripted Dead; MONSTERSTATE_ itself has
 //Alert before Combat, so the SDK prints two of them wrongly. The names here
 //follow the enum
	if (state == HLMSTATE_IDLE)		return "Idle";
	if (state == HLMSTATE_ALERT)	return "Alert";
	if (state == HLMSTATE_COMBAT)	return "Combat";
	if (state == HLMSTATE_SCRIPT)	return "Scripted";
	if (state == HLMSTATE_DEAD)		return "Dead";

	return "None";
}

U8 *HLAISchedName(I64 sched)
{//the pName field of each Schedule_t in defaultai.cpp
	if (sched == HLSCHED_IDLE_STAND)		return "IdleStand";
	if (sched == HLSCHED_ALERT_STAND)		return "AlertStand";
	if (sched == HLSCHED_ALERT_FACE)		return "AlertFace";
	if (sched == HLSCHED_WAKE_ANGRY)		return "WakeAngry";
	if (sched == HLSCHED_CHASE_ENEMY)		return "ChaseEnemy";
	if (sched == HLSCHED_MELEE_ATTACK1)		return "MeleeAttack1";
	if (sched == HLSCHED_RANGE_ATTACK1)		return "RangeAttack1";
	if (sched == HLSCHED_TAKE_COVER)		return "TakeCoverFromEnemy";
	if (sched == HLSCHED_SMALL_FLINCH)		return "SmallFlinch";
	if (sched == HLSCHED_DIE)				return "Die";
	if (sched == HLSCHED_IDLE_WALK)			return "IdleWalk";
	if (sched == HLSCHED_ALERT_SM_FLINCH)	return "AlertSmallFlinch";
	if (sched == HLSCHED_INVEST_SOUND)		return "InvestigateSound";
	if (sched == HLSCHED_COMBAT_FACE)		return "CombatFace";
	if (sched == HLSCHED_COMBAT_STAND)		return "CombatStand";
	if (sched == HLSCHED_CHASE_FAILED)		return "ChaseEnemyFailed";
	if (sched == HLSCHED_STANDOFF)			return "Standoff";
	if (sched == HLSCHED_RELOAD)			return "Reload";
	if (sched == HLSCHED_ARM_WEAPON)		return "ArmWeapon";
	if (sched == HLSCHED_MELEE_ATTACK2)		return "MeleeAttack2";
	if (sched == HLSCHED_RANGE_ATTACK2)		return "RangeAttack2";
	if (sched == HLSCHED_SPECIAL_ATTACK1)	return "SpecialAttack1";
	if (sched == HLSCHED_COVER_SOUND)		return "TakeCoverFromBestSound";
	if (sched == HLSCHED_COVER_ORIGIN)		return "TakeCoverFromOrigin";
	if (sched == HLSCHED_COWER)				return "Cower";
	if (sched == HLSCHED_VICTORY_DANCE)		return "VictoryDance";
	if (sched == HLSCHED_AMBUSH)			return "Ambush";
	if (sched == HLSCHED_BARNACLE_GRAB)		return "BarnacleVictim";
	if (sched == HLSCHED_BARNACLE_CHOMP)	return "BarnacleChomp";
	if (sched == HLSCHED_FAIL)				return "Fail";
	if (sched == HLSCHED_TARGET_FACE)		return "FaceTarget";
	if (sched == HLSCHED_TARGET_CHASE)		return "Follow";
	if (sched == HLSCHED_HEAL)				return "Heal";

	return "No Schedule";
}

U8 *HLAIActName(I64 act)
{//activity_map[] in monsters.cpp, restricted to the activities this port has
	if (act == HLACT_IDLE)			return "ACT_IDLE";
	if (act == HLACT_WALK)			return "ACT_WALK";
	if (act == HLACT_RUN)			return "ACT_RUN";
	if (act == HLACT_MELEE)			return "ACT_MELEE_ATTACK1";
	if (act == HLACT_MELEE2)		return "ACT_MELEE_ATTACK2";
	if (act == HLACT_RANGE)			return "ACT_RANGE_ATTACK1";
	if (act == HLACT_RANGE2)		return "ACT_RANGE_ATTACK2";
	if (act == HLACT_DIE)			return "ACT_DIESIMPLE";
	if (act == HLACT_FLINCH)		return "ACT_SMALL_FLINCH";
	if (act == HLACT_RELOAD)		return "ACT_RELOAD";
	if (act == HLACT_COMBAT_IDLE)	return "ACT_COMBAT_IDLE";
	if (act == HLACT_SIGNAL)		return "ACT_SIGNAL1";
	if (act == HLACT_THREAT)		return "ACT_THREAT_DISPLAY";
	if (act == HLACT_VICTORY)		return "ACT_VICTORY_DANCE";
	if (act == HLACT_COWER)			return "ACT_COWER";
	if (act == HLACT_ARM)			return "ACT_ARM";
	if (act == HLACT_DISARM)		return "ACT_DISARM";
	if (act == HLACT_EAT)			return "ACT_EAT";
	if (act == HLACT_SPECIAL)		return "ACT_SPECIAL_ATTACK1";
	if (act == HLACT_BARN_HIT)		return "ACT_BARNACLE_HIT";
	if (act == HLACT_BARN_PULL)		return "ACT_BARNACLE_PULL";
	if (act == HLACT_BARN_CHOMP)	return "ACT_BARNACLE_CHOMP";
	if (act == HLACT_BARN_CHEW)		return "ACT_BARNACLE_CHEW";

	return "ACT_INVALID";
}

U0 HLAIMonReportOne(I64 i)
{//one monster, in the layout ReportAIState prints
	CHLEntity	*e = HLEntGet(hl_ai_mon[i].ent);
	I64			 slot;
	I64			 task;

	if (!e)
		return;

	"%s: ", e->classname;
	"State: %s, ", HLAIStateName(hl_ai_mon[i].state);
	"Activity %s, ", HLAIActName(hl_ai_mon[i].activity);

	if (hl_ai_mon[i].sched > HLSCHED_NONE &&
		hl_ai_mon[i].sched < HLSCHED_COUNT)
	{
		"Schedule %s, ", HLAISchedName(hl_ai_mon[i].sched);

		if (hl_ai_mon[i].task < hl_ai_sched_len[hl_ai_mon[i].sched])
		{
			slot = hl_ai_mon[i].sched * HLAI_SCHED_TASKS + hl_ai_mon[i].task;
			task = hl_ai_sched_task[slot];

			"Task %d (#%d), ", task, hl_ai_mon[i].task;
		}
	}
	else
		"No Schedule, ";

	if (hl_ai_mon[i].have_enemy)
	{
		if (HLAITargetIsPlayer(hl_ai_mon[i].enemy))
			"\nEnemy is player";
		else
			"\nEnemy is %s", hl_entities[hl_ai_mon[i].enemy].classname;
	}
	else
		"No enemy";

	if (hl_ai_mon[i].have_goal && hl_ai_mon[i].move_speed > 0.0)
		" Moving ";

	//the squad line CSquadMonster adds to the report
	if (!HLAIInSquad(i))
		"not ";

	"In Squad, ";

	if (!HLAIIsLeader(i))
		"not ";

	"Leader.";

	"\n";
	"Yaw speed:%3.1f,Health: %3.1f\n",
		hl_ai_mon_info[hl_ai_mon[i].kind].yaw_speed, e->health;

	//not in the SDK's report: this port's own state, which has no other way
	//out. Slots, ammo and the last sound heard are what a squad fight turns on
	slot = HLAISquadLeader(i);

	"  slot %d of %d, ammo %d/%d, heard %d at %.0f %.0f %.0f\n",
		hl_ai_mon[i].my_slot, hl_ai_mon[slot].squad_slots, hl_ai_mon[i].ammo,
		hl_ai_mon[i].clip,
		hl_ai_mon[i].heard_type, hl_ai_mon[i].heard_pos[0],
		hl_ai_mon[i].heard_pos[1], hl_ai_mon[i].heard_pos[2];

	"  body %d, aim pitch %3.1f, blend %.2f\n",
		e->body, hl_ai_mon[i].aim_pitch, e->blending[0];
}

U0 HLAIMonReport()
{//dump AI state for every monster. Distinguishes "no monsters registered" from
 //"registered and idle", which look identical on screen
	I64 i;
	I64 live = 0;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire > hl_ent_time)
			live++;
	}

	"HLAI: %d monsters tracked, %d dead, %d sounds in the world\n",
		hl_ai_mon_count, hl_ai_mon_kills, live;

	if (hl_ai_graph_ready)
		"HLAI: node graph %s, %d nodes %d links\n", hl_ai_graph_map,
			hl_ai_node_count, hl_ai_link_count;
	else
		"HLAI: no node graph for %s\n", hl_ai_graph_map;

	for (i = 0; i < hl_ai_mon_count; i++)
		HLAIMonReportOne(i);
}

//--- the frame --------------------------------------------------------------

U0 HLAISentenceFrame(I64 self)
{//one scripted_sentence, one tick: Spawn, FindThink and DelayThink,
 //scripted.cpp:1023-1099
	CHLEntity	*e = HLEntGet(self);
	F64			 duration;
	F64			 volume;
	F64			 atten;
	I64			 who;
	I64			 listener;
	Bool		 concurrent;

	if (!e || self >= HLENT_MAX)
		return;

	//Spawn: a scripted_sentence nothing can name starts a second after the map
	if (!hl_ai_talk[self].inited)
	{
		hl_ai_talk[self].inited = TRUE;

		if (!e->targetname[0])
		{
			e->toggle_state            = HLTS_GOING_DOWN;
			hl_ai_talk[self].next_think = hl_ent_time + 1.0;
		}
	}

	//DelayThink done: m_active back on, wait for Use (or unnamed auto-find)
	if (e->toggle_state == HLTS_AT_TOP)
	{
		if (hl_ent_time < hl_ai_talk[self].next_think)
			return;

		e->toggle_state = HLTS_AT_BOTTOM;

		if (!e->targetname[0])
			e->toggle_state = HLTS_GOING_DOWN;

		return;
	}

	if (e->toggle_state != HLTS_GOING_DOWN)
		return;

	//Use kicked FindThink while a prior next_think wait was pending
	if (e->pain_finished < 0.0)
	{
		e->pain_finished            = 0.0;
		hl_ai_talk[self].next_think = 0.0;
	}

	//DelayThink holds m_active down for m_flDuration + m_flRepeat after a line
	if (hl_ent_time < hl_ai_talk[self].next_think)
		return;

	who = HLAISentenceSpeaker(e);

	if (who < 0)
	{
		//nobody acceptable: try again on m_flRepeat + 0.5, scripted.cpp:1089.
		//156 of the 203 shipped sentences carry a non-zero refire
		hl_ai_talk[self].next_think = hl_ent_time + e->ai_refire + 0.5;
		return;
	}

	duration = e->duration;
	atten    = HLAISentenceAtten(e->ai_atten);

	//KeyValue scales the "volume" key by 0.1 and Spawn floors a missing key
	//to full, scripted.cpp:1050. The parse default for e->volume is 1.0, so a
	//raw value at or below it is "no key": scaling it played 85 of the 203
	//shipped sentences at a tenth volume - every scripted line without the
	//key, inaudibly. Authored values run 2..10; a mapper asking for 0.1 by
	//writing "1" loses that here, and no shipped map does
	if (e->volume > 1.0)
		volume = e->volume * 0.1;
	else
		volume = 1.0;

	//StartSentence, scripted.cpp:1193: bConcurrent is set when the CONCURRENT
	//spawnflag is CLEAR, and PlayScriptedSentence silences the speaker's
	//friends only when bConcurrent is false. The flag therefore reads
	//backwards - setting it is what shuts everyone else up. Reproduced.
	concurrent = ToBool(!(e->spawnflags & HLAI_SF_SENTENCE_CONCURRENT));

	listener = HLAISentenceListener(e, who);

	HLAITalkPlayScripted(who, e->ai_sentence, duration, volume, atten,
		concurrent, listener);

	//the sentence fires the trigger's own target too; HL chains a line of
	//dialogue into whatever follows it
	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	//SF_SENTENCE_ONCE removes the entity outright
	if (e->spawnflags & HLAI_SF_SENTENCE_ONCE)
	{
		e->in_use = FALSE;
		return;
	}

	//DelayThink: re-arm once the line and the refire have run out,
	//scripted.cpp:1082. An unnamed one re-arms itself, a named one waits to be
	//used again. AT_TOP = m_active FALSE through the delay; AT_BOTTOM once the
	//wait expires (handled below via next_think while named stays AT_TOP until
	//Use). Named scripts park AT_BOTTOM only after the delay so Use matches
	//SDK m_active gating.
	hl_ai_talk[self].next_think = hl_ent_time + duration + e->ai_refire;

	if (e->targetname[0])
		e->toggle_state = HLTS_AT_TOP;
}

U0 HLAIFrame(F64 dt)
{//drive every script, keep idle props animating, then tick the monsters
 //
 //a scan rather than a schedule: ZealC is single-pass, so HLEntity.ZC's
 //dispatcher cannot call into this file. A triggered script only sets
 //toggle_state and this notices on the next tick.
	CHLEntity	*e;
	I64			 i;

	if (!hl_entities)
		return;

	//before the event pass below, which indexes hl_ai_mon_of: on the first
	//tick of a new map that table still describes the last one. Idempotent, so
	//HLAIMonsterFrame calling it again at the end costs three comparisons.
	HLAIMonSync;

	HLAISentenceUpdate(hl_ent_time);

	//CSoundEnt::Update: age the world sound list and re-post the player's own
	//entry. Before the monster pass, so a monster hears this tick's footsteps
	//rather than last tick's
	HLAISoundFrame;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use)
			goto qaif_next;

		//--- jaw ---
		//
		//The engine fills cl_entity_s.mouth.mouthopen from the playing voice and
		//StudioModelRenderer.cpp:620 hands it to bone controller 4, scaled by 64
		//rather than 255, StudioModelRenderer.cpp:150. It is amplitude, not
		//animation: the talk sequences move the head, never the jaw.
		//
		//HLStudioMouthSetting and not HLStudioCtlSetting - the latter returns a
		//0..255 setting and HLStCalcBoneAdj divides channel 4 by 64, so anything
		//over a quarter would clamp the jaw fully open.
		//
		//Assigned rather than accumulated, so silence closes the jaw. Ahead of
		//early exits that skip the studio pass (scripts/sentences): a scripted
		//actor still gets events when its own entity is visited; sitting
		//scientists fire events on their branch below.
		if (e->studio && HLStudioHasMouth(e->studio))
			e->controllers[HLST_MOUTH_CTL] =
				HLStudioMouthSetting(HLSndVoiceAmplitude(i + 1));

		if (e->ent_class == HLC_SCRIPT)
		{
			HLAICineTick(i);
			goto qaif_next;
		}

		//scripted_sentence, scripted.cpp:1023-1099. HLEntity.ZC spawns these
		//and posts GOING_DOWN on use as it does for a script: its dispatcher
		//compiles before this file and cannot call the sentence player.
		//
		//   AT_BOTTOM   m_active, waiting to be used
		//   GOING_DOWN  FindThink: look for a speaker each tick until one is
		//               acceptable
		//   AT_TOP      DelayThink: m_active false until duration+refire
		//
		//hl_ai_talk[i].next_think carries pev->nextthink and .inited carries
		//"Spawn has run": a scripted_sentence is never a talker, so its row in
		//that table is otherwise unused.
		if (e->ent_class == HLC_SENTENCE)
		{
			HLAISentenceFrame(i);
			goto qaif_next;
		}

		//CSittingScientist. Its own think, not the monster state machine: it
		//takes no AI slot. Still fire shared script events (sentence/sound on
		//the sit takes) before leaving - skipping the studio pass silenced
		//every SCRIPT_EVENT_* baked into sitting sequences.
		if (!StrCompare(e->classname, "monster_sitting_scientist"))
		{
			HLAISitScientistThink(i);

			if (e->studio)
				HLAIEntityEvents(e, i, HLAIEntityCycle(e));

			goto qaif_next;
		}

		//an unscripted studio prop plays its own first sequence.
		//
		//Monsters are excluded: HLAIMonsterFrame owns their sequence, and
		//seeding anim_start here would race the state machine on the first
		//tick after a spawn
		if (e->studio && e->anim_start == 0.0 && e->ent_class != HLC_MONSTER)
		{
			e->anim_start = hl_ent_time;
			e->anim_loop  = TRUE;
		}

		//Animation events. A tracked monster goes through HandleAnimEvent,
		//which lands its attacks on the frame the animator marked; anything
		//else gets the shared script events only.
		if (e->studio)
		{
			if (i < HLENT_MAX && hl_ai_mon_of[i] >= 0)
				HLAIMonEvents(hl_ai_mon_of[i], i, HLAIEntityCycle(e));
			else
				HLAIEntityEvents(e, i, HLAIEntityCycle(e));
		}

qaif_next:
	}

	//after the script pass: a script that started or finished this tick has
	//already claimed or released its actor, so HLAIMonsterFrame sees the
	//settled ownership rather than last tick's
	HLAIMonsterFrame(dt);
}
