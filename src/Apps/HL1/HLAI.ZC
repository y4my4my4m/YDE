//--- node graph, dlls/nodes.cpp ---------------------------------------------
//
// CGraph. GoldSrc collects the map's info_node and info_node_air entities at
// first load, links them with hull-by-hull sweeps, computes the routing
// tables and writes maps/graphs/<map>.nod. The file is loaded here and never
// built: valve/maps/graphs ships one for every shipped map that carries nodes
// except disposal.bsp, and building it would reproduce the file already on
// disk from an O(n^2) sweep over every node pair.
//
// Measured over the 125 shipped maps: 5301 info_node and 261 info_node_air,
// most in c2a3d.bsp at 239. The 95 shipped .nod files carry 5554 nodes, which
// is the entity total less disposal.bsp's 8 - graph and entity counts agree
// map for map. Largest link pool is c2a3d.bsp at 2408.
//
// Rebuilding rather than loading was rejected on two counts. The graph needs
// the whole move stack - LinkVisibleNodes traces four hulls across every node
// pair and RejectInlineLinks then walks the survivors - and the result would
// have to be cached back to disk to be affordable, which the shipped read-only
// game tree does not invite. CheckNODFile compares the .bsp and .nod
// modification times to decide whether the cache is stale; both files here are
// retail and immutable, so the comparison has no work to do and is not ported.
//
// File layout, GRAPH_VERSION 16, a 32 bit x86 struct dump. Offsets verified
// against the shipped files: predicted and actual lengths agree for all 95.
//
//   0        I32    version, 16
//   4        8396   CGraph, of which +24 m_cNodes, +28 m_cLinks,
//                   +32 m_nRouteInfo, +8384 m_nHashLinks
//   8400     88*n   CNode
//   ...      24*l   CLink
//   ...      16*n   DIST_INFO, m_nRouteInfo bytes, 2*m_nHashLinks bytes
//
//   CNode   0 origin[3] f32, 12 originPeek[3] f32, 24 Region[3] u8,
//           28 afNodeInfo, 32 cNumLinks, 36 iFirstLink,
//           40 pNextBestNode[4][2], 72 flClosestSoFar, 76 iPreviousNode,
//           80 sHintType i16, 82 sHintActivity i16, 84 flHintYaw f32
//   CLink   0 iSrcNode, 4 iDestNode, 8 pLinkEnt, 12 modelname[4] not NUL
//           terminated, 16 afLinkInfo, 20 flWeight f32
//
// The trailing three blocks are read past. DIST_INFO and the region tables
// make FindNearestNode constant time and the compressed routing table makes
// NextNodeInRoute constant time; both are 1998 budget decisions. At 239 nodes
// a linear scan and a Dijkstra over the same link weights answer identically.
// pLinkEnt is a saved 32 bit pointer and is meaningful only as nonzero, which
// is how FSetGraphPointers reads it.

#define HLNODE_MAX				256		//239 in c2a3d.bsp, the largest shipped
#define HLLINK_MAX				2560	//2408 in c2a3d.bsp
#define HLNODE_VERSION			16		//GRAPH_VERSION, nodes.h:107
#define HLNODE_HDR				8400	//4 + sizeof(CGraph)
#define HLNODE_STRIDE			88		//sizeof(CNode)
#define HLLINK_STRIDE			24		//sizeof(CLink)

//bits_NODE_*, nodes.h:26-28
#define HLNODE_LAND				1
#define HLNODE_AIR				2
#define HLNODE_WATER			4

//bits_LINK_*, nodes.h:65-68
#define HLLINK_SMALL			1
#define HLLINK_HUMAN			2
#define HLLINK_LARGE			4
#define HLLINK_FLY				8

//NODE_*_HULL, nodes.h:71-74
#define HLHULL_SMALL			0
#define HLHULL_HUMAN			1
#define HLHULL_LARGE			2
#define HLHULL_FLY				3

//bits_CAP_*, cbase.h:590-593. Only the door group is read here
#define HLCAP_USE				0x0040
#define HLCAP_AUTO_DOORS		0x0100
#define HLCAP_OPEN_DOORS		0x0200
#define HLCAP_DOORS_GROUP		0x0340

//SF_DOOR_NO_AUTO_RETURN, doors.h:24. HLSF_DOOR_USE_ONLY is HLEntity.ZC:2833
#define HLAI_SF_DOOR_NO_RETURN	32

//MAX_PATH_SIZE, cbase.h:29
#define HLNODE_PATH_MAX			10

//how close a node waypoint counts as reached. MONSTER_CUT_CORNER_DIST,
//monsters.cpp:37, "8 means the monster's bounding box is contained within the
//box of the node in WC"
#define HLAI_NODE_TOL			8.0

//how far the goal may drift before the route to it is discarded, world units
#define HLAI_NODE_SLOP			128.0

//floor under repeated route builds for one monster, seconds. A build is a
//nearest-node search per endpoint plus a Dijkstra
#define HLAI_NODE_REROUTE		0.5

//HLAINodeRoute's result. WAIT is the HLAI_NODE_REROUTE floor refusing the call
//and says nothing about whether a path exists; NONE is FGetNodeRoute's own
//failure - no graph, no node near an endpoint, or no path between them
#define HLAI_ROUTE_NONE			0
#define HLAI_ROUTE_OK			1
#define HLAI_ROUTE_WAIT			2

F64		hl_ai_node_org[HLNODE_MAX * 3];
F64		hl_ai_node_peek[HLNODE_MAX * 3];
I64		hl_ai_node_info[HLNODE_MAX];
I64		hl_ai_node_nlink[HLNODE_MAX];
I64		hl_ai_node_link0[HLNODE_MAX];
I64		hl_ai_node_hint[HLNODE_MAX];		//sHintType
I64		hl_ai_node_hint_act[HLNODE_MAX];	//sHintActivity
F64		hl_ai_node_hint_yaw[HLNODE_MAX];	//flHintYaw

//HINT_TACTICAL_COVER_*, nodes.h - FindCoverNode looks for these
#define HLHINT_COVER_MED		100
#define HLHINT_COVER_LOW		101

I64		hl_ai_link_dest[HLLINK_MAX];
I64		hl_ai_link_flags[HLLINK_MAX];
F64		hl_ai_link_weight[HLLINK_MAX];

//entity index of the brush that blocks this link, -1 for none. The file
//carries a dead pointer and four characters of the brush model name;
//HLAIGraphBind resolves the name the way FSetGraphPointers does
I64		hl_ai_link_ent[HLLINK_MAX];
U8		hl_ai_link_model[HLLINK_MAX * 5];

I64		hl_ai_node_count  = 0;
I64		hl_ai_link_count  = 0;
Bool	hl_ai_graph_ready = FALSE;

//the map hl_ai_graph_ready describes. A load failure leaves this set and the
//flag clear, so a map with no graph is probed once rather than every tick
U8		hl_ai_graph_map[96];

//Dijkstra scratch. m_flClosestSoFar and m_iPreviousNode live in CNode in the
//SDK; a loaded graph is read only here, so they are parallel arrays
F64		hl_ai_node_dist[HLNODE_MAX];
I64		hl_ai_node_prev[HLNODE_MAX];
Bool	hl_ai_node_done[HLNODE_MAX];

//per-route tracing into HL1LOG.TXT. No console binding; set it from HLTest or
//the prompt
Bool	hl_ai_graph_log = FALSE;

F64		hl_ai_graph_retry;
I64		hl_ai_graph_tries;

U0 HLAIGraphReset()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	hl_ai_node_count   = 0;
	hl_ai_link_count   = 0;
	hl_ai_graph_ready  = FALSE;
	hl_ai_graph_map[0] = 0;
	hl_ai_graph_retry  = 0.0;
	hl_ai_graph_tries  = 0;
}

HLAIGraphReset;

U0 HLAIGraphBaseName(U8 *in, U8 *out)
{//"maps/c1a0.bsp", "c1a0.bsp" and "c1a0" all reduce to "c1a0". hl_map_name
 //holds whatever the caller of HLLoadMap passed, which is any of the three
	I64 start = 0;
	I64 end;
	I64 i;
	I64 n;

	n = StrLen(in);

	for (i = 0; i < n; i++)
	{
		if (in[i] == '/' || in[i] == '\\')
			start = i + 1;
	}

	end = n;

	if (end - start > 4)
	{
		if (in[end - 4] == '.')
			end -= 4;
	}

	n = end - start;

	if (n > 90)
		n = 90;

	for (i = 0; i < n; i++)
		out[i] = in[start + i];

	out[n] = 0;
}

Bool HLAIGraphLoad(U8 *base)
{//CGraph::FLoadGraph, nodes.cpp:2317, reading only the node and link blocks
	U8	*d;
	U8	*p;
	U8	 path[160];
	U8	 line[160];
	I64	 size = 0;
	I64	 n;
	I64	 l;
	I64	 i;
	I64	 j;
	I64	 lbase;
	I64	 off;
	I64	 dest;

	hl_ai_node_count = 0;
	hl_ai_link_count = 0;

	//one lowercase probe, not HLFileResolve's three case variants: the graphs
	//are this port's own data, always lowercase, never in a pak. A map with no
	//graph - the tram maps c0a0a/b/c ship none - misses on an existing
	//directory, which FileFind takes quietly; the case variants walked
	//uppercase directory names and printed a red Cd error per probe
	StrPrint(path, "%s/valve/maps/graphs/%s.nod", hl_game_root, base);

	if (!FileFind(path))
		return FALSE;

	d = FileRead(path, &size);

	if (!d)
		return FALSE;

	if (size < HLNODE_HDR + HLNODE_STRIDE)
		goto qgl_bad;

	if (HLRdI32(d) != HLNODE_VERSION)
	{
		StrPrint(line, "nodegraph: %s version %d, want %d\n", path,
			HLRdI32(d), HLNODE_VERSION);
		HLLog(line);
		goto qgl_bad;
	}

	n = HLRdI32(d + 4 + 24);
	l = HLRdI32(d + 4 + 28);

	if (n <= 0 || l < 0)
		goto qgl_bad;

	lbase = HLNODE_HDR + HLNODE_STRIDE * n;

	if (size < lbase + HLLINK_STRIDE * l)
		goto qgl_bad;

	//a map past the measured maxima loads its first HLNODE_MAX nodes and the
	//links that fall inside them; a truncated graph routes worse than a full
	//one and better than none
	if (n > HLNODE_MAX)
	{
		StrPrint(line, "nodegraph: %s has %d nodes, capped at %d\n", path, n,
			HLNODE_MAX);
		HLLog(line);
		n = HLNODE_MAX;
	}

	if (l > HLLINK_MAX)
	{
		StrPrint(line, "nodegraph: %s has %d links, capped at %d\n", path, l,
			HLLINK_MAX);
		HLLog(line);
		l = HLLINK_MAX;
	}

	for (i = 0; i < n; i++)
	{
		p = d + HLNODE_HDR + HLNODE_STRIDE * i;

		hl_ai_node_org[i * 3]      = HLRdF32(p);
		hl_ai_node_org[i * 3 + 1]  = HLRdF32(p + 4);
		hl_ai_node_org[i * 3 + 2]  = HLRdF32(p + 8);

		hl_ai_node_peek[i * 3]     = HLRdF32(p + 12);
		hl_ai_node_peek[i * 3 + 1] = HLRdF32(p + 16);
		hl_ai_node_peek[i * 3 + 2] = HLRdF32(p + 20);

		hl_ai_node_info[i]  = HLRdI32(p + 28);
		hl_ai_node_nlink[i] = HLRdI32(p + 32);
		hl_ai_node_link0[i] = HLRdI32(p + 36);

		//sHintType / sHintActivity / flHintYaw at +80/+82/+84
		hl_ai_node_hint[i]     = HLRdI16(p + 80);
		hl_ai_node_hint_act[i] = HLRdI16(p + 82);
		hl_ai_node_hint_yaw[i] = HLRdF32(p + 84);
	}

	for (i = 0; i < l; i++)
	{
		p = d + lbase + HLLINK_STRIDE * i;

		dest = HLRdI32(p + 4);

		//a link into a node the cap dropped is dead; point it at itself so the
		//search never leaves the loaded set
		if (dest < 0 || dest >= n)
			dest = HLRdI32(p);

		if (dest < 0 || dest >= n)
			dest = 0;

		hl_ai_link_dest[i]   = dest;
		hl_ai_link_flags[i]  = HLRdI32(p + 16);
		hl_ai_link_weight[i] = HLRdF32(p + 20);

		//nonzero pLinkEnt is the SDK's own "this link had a blocker when the
		//graph was written", nodes.cpp:2574
		if (HLRdU32(p + 8))
			hl_ai_link_ent[i] = -2;
		else
			hl_ai_link_ent[i] = -1;

		for (j = 0; j < 4; j++)
			hl_ai_link_model[i * 5 + j] = p[12 + j];

		hl_ai_link_model[i * 5 + 4] = 0;
	}

	//clamp the per-node link windows to what was loaded
	for (i = 0; i < n; i++)
	{
		off = hl_ai_node_link0[i];

		if (off < 0 || off >= l)
		{
			hl_ai_node_link0[i] = 0;
			hl_ai_node_nlink[i] = 0;
		}
		else if (off + hl_ai_node_nlink[i] > l)
			hl_ai_node_nlink[i] = l - off;
	}

	hl_ai_node_count = n;
	hl_ai_link_count = l;

	Free(d);

	return TRUE;

qgl_bad:
	Free(d);

	return FALSE;
}

U0 HLAIGraphBind()
{//CGraph::FSetGraphPointers, nodes.cpp:2563. Resolve the four saved characters
 //of each blocker's brush model name to an entity index.
 //
 //FL_GRAPHED is not set on the resolved entity: nothing here disables a link
 //when its door is destroyed, so the flag has no reader.
	CHLEntity	*e;
	U8			 line[128];
	I64			 i;
	I64			 j;
	I64			 miss = 0;

	for (i = 0; i < hl_ai_link_count; i++)
	{
		if (hl_ai_link_ent[i] != -2)
			goto qgb_next;

		hl_ai_link_ent[i] = -1;

		for (j = 0; j < hl_num_entities; j++)
		{
			e = HLEntGet(j);

			if (!e)
				goto qgb_next_ent;

			//the saved name is at most four characters and the compare is
			//exact, as FIND_ENTITY_BY_STRING's is against name[5]
			if (!StrCompare(e->model_name, hl_ai_link_model + i * 5))
			{
				hl_ai_link_ent[i] = j;
				goto qgb_next;
			}

qgb_next_ent:
		}

		//"Could not find model", nodes.cpp:2587: the brush was removed from
		//the world after the graph was written
		miss++;

qgb_next:
	}

	if (miss && hl_ai_graph_log)
	{
		StrPrint(line, "nodegraph: %d link blockers unresolved\n", miss);
		HLLog(line);
	}
}

Bool HLAIGraphEnsure()
{//load the graph for the map that is up, once. Map name is the key.
 //Misses (tram maps with no .nod) cache under that name so we do not
 //reprobe every tick. A changelevel with a different hl_map_name retries.
 //
 //Deviation: do NOT keep hl_ai_graph_retry across maps. Old clock + new
 //map time=0 made Ensure bail for minutes after the intro tram, so c1a0
 //walk-to-mark scripts starved. Direct map load was fine (retry≈0).
	U8	base[96];
	U8	line[160];

	if (!hl_map_name[0])
		return FALSE;

	if (!StrCompare(hl_ai_graph_map, hl_map_name))
		return hl_ai_graph_ready;

	//map changed (or first call): wipe stale nodes + old-map retry clock
	hl_ai_node_count  = 0;
	hl_ai_link_count  = 0;
	hl_ai_graph_ready = FALSE;
	hl_ai_graph_tries = 0;
	hl_ai_graph_retry = 0.0;

	HLAIGraphBaseName(hl_map_name, base);

	if (!HLAIGraphLoad(base))
	{
		//tram maps c0a0a/b/c ship none - not an error
		StrPrint(line,
			"nodegraph: %s has none, straight-line movement\n", base);
		HLLog(line);
		HLStrCopy(hl_ai_graph_map, hl_map_name, 96);
		return FALSE;
	}

	HLStrCopy(hl_ai_graph_map, hl_map_name, 96);
	HLAIGraphBind;
	hl_ai_graph_ready = TRUE;

	StrPrint(line, "nodegraph: %s, %d nodes %d links\n", base,
		hl_ai_node_count, hl_ai_link_count);
	HLLog(line);

	return TRUE;
}

Bool HLAILinkOpen(I64 link, I64 caps)
{//CGraph::HandleLinkEnt with queryType NODEGRAPH_STATIC, nodes.cpp:1102.
 //FindShortestPath is the only caller and always asks statically: "can this
 //ever be handled", not "is it open now".
 //
 //Under STATIC the func_breakable arm returns TRUE unconditionally and the
 //manual-door arm's NOMONSTERS test is bypassed, so the door cases collapse to
 //"can open doors, or the door is parked open and stays that way".
	CHLEntity	*e;
	I64			 ent;

	if (link < 0 || link >= hl_ai_link_count)
		return FALSE;

	ent = hl_ai_link_ent[link];

	//no blocker recorded, or its brush is gone. "dead path ent", :1114,
	//returns TRUE
	if (ent < 0)
		return TRUE;

	e = HLEntGet(ent);

	if (!e)
		return TRUE;

	if (!StrCompare(e->classname, "func_door") ||
		!StrCompare(e->classname, "func_door_rotating"))
	{
		if (caps & HLCAP_OPEN_DOORS)
			return TRUE;

		//parked at the top with no auto return: it will still be open when the
		//monster arrives
		if (e->toggle_state == HLTS_AT_TOP &&
			e->spawnflags & HLAI_SF_DOOR_NO_RETURN)
			return TRUE;

		return FALSE;
	}

	if (!StrCompare(e->classname, "func_breakable"))
		return TRUE;

	//"Unhandled Ent in Path", nodes.cpp:1166
	return FALSE;
}

I64 HLAIFindNearestNode(F64 *org, I64 want_types)
{//CGraph::FindNearestNode, nodes.cpp:869, plus CheckNode at :821. -1 is none.
 //
 //Deviation: the SDK narrows the search with m_RangeStart/m_RangeEnd over 256
 //regions per axis and short-circuits on a hash of the query point. Both are
 //skipped; the scan is linear over at most 239 nodes and applies the same two
 //tests, nearest by distance to m_vecOriginPeek among those the point can
 //trace to.
	CHLTrace	tr;
	F64			d[3];
	F64			peek[3];
	F64			zero[3];
	F64			dist;
	F64			best = 999999.0;
	I64			near = -1;
	I64			i;

	if (!hl_ai_graph_ready || !hl_map)
		return -1;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	for (i = 0; i < hl_ai_node_count; i++)
	{
		if (!(hl_ai_node_info[i] & want_types))
			goto qfnn_next;

		peek[0] = hl_ai_node_peek[i * 3];
		peek[1] = hl_ai_node_peek[i * 3 + 1];
		peek[2] = hl_ai_node_peek[i * 3 + 2];

		HLVecSub(org, peek, d);

		dist = HLVecLength(d);

		if (dist >= best)
			goto qfnn_next;

		//ignore_monsters: a body standing on a node must not hide it
		HLTraceEntity(hl_map, org, peek, zero, zero, 0, TRUE, &tr);

		if (tr.fraction < 1.0)
			goto qfnn_next;

		near = i;
		best = dist;

qfnn_next:
	}

	return near;
}

I64 HLAIFindShortestPath(I64 *path, I64 start, I64 dest, I64 hull, I64 caps)
{//CGraph::FindShortestPath, nodes.cpp:1183. Node count written to path, 0 for
 //no route.
 //
 //Deviation: the SDK takes the precomputed route when m_fRoutingComplete,
 //walking NextNodeInRoute through the compressed table, and falls back to this
 //search otherwise. The table is not loaded, so the search always runs. It is
 //the same graph and the same weights, so the answer is the same route.
 //
 //Deviation: CQueuePriority is a binary heap capped at MAX_STACK_NODES, 100.
 //Here the open set is a scan for the smallest unfinished distance, O(n^2) on
 //at most 239 nodes, which removes the cap - the SDK's heap silently drops
 //insertions past 100.
	F64	weight;
	F64	reach;
	F64	best;
	I64	hull_mask;
	I64	at;
	I64	link;
	I64	to;
	I64	i;
	I64	count;
	I64	total;

	if (!hl_ai_graph_ready)
		return 0;

	if (start < 0 || start >= hl_ai_node_count)
		return 0;

	if (dest < 0 || dest >= hl_ai_node_count)
		return 0;

	if (start == dest)
	{
		path[0] = start;
		path[1] = dest;
		return 2;
	}

	hull_mask = HLLINK_HUMAN;

	if (hull == HLHULL_SMALL)
		hull_mask = HLLINK_SMALL;
	else if (hull == HLHULL_LARGE)
		hull_mask = HLLINK_LARGE;
	else if (hull == HLHULL_FLY)
		hull_mask = HLLINK_FLY;

	for (i = 0; i < hl_ai_node_count; i++)
	{
		hl_ai_node_dist[i] = -1.0;
		hl_ai_node_prev[i] = start;
		hl_ai_node_done[i] = FALSE;
	}

	hl_ai_node_dist[start] = 0.0;

	while (TRUE)
	{
		at   = -1;
		best = 0.0;

		for (i = 0; i < hl_ai_node_count; i++)
		{
			if (hl_ai_node_done[i])
				goto qfsp_next_open;

			if (hl_ai_node_dist[i] < -0.5)
				goto qfsp_next_open;

			if (at < 0 || hl_ai_node_dist[i] < best)
			{
				at   = i;
				best = hl_ai_node_dist[i];
			}

qfsp_next_open:
		}

		if (at < 0)
			goto qfsp_walked;

		//straight line weights, so the first pop of the destination is final
		if (at == dest)
			goto qfsp_walked;

		hl_ai_node_done[at] = TRUE;

		for (i = 0; i < hl_ai_node_nlink[at]; i++)
		{
			link = hl_ai_node_link0[at] + i;

			if (link < 0 || link >= hl_ai_link_count)
				goto qfsp_next_link;

			//"monster is too large to walk this connection", :1296
			if ((hl_ai_link_flags[link] & hull_mask) != hull_mask)
				goto qfsp_next_link;

			if (!HLAILinkOpen(link, caps))
				goto qfsp_next_link;

			to     = hl_ai_link_dest[link];
			weight = hl_ai_link_weight[link];
			reach  = best + weight;

			if (hl_ai_node_dist[to] < -0.5 ||
				reach < hl_ai_node_dist[to] - 0.001)
			{
				hl_ai_node_dist[to] = reach;
				hl_ai_node_prev[to] = at;
			}

qfsp_next_link:
		}
	}

qfsp_walked:
	if (hl_ai_node_dist[dest] < -0.5)
		return 0;

	//length the predecessor chain
	total = 1;
	at    = dest;

	while (at != start)
	{
		at = hl_ai_node_prev[at];
		total++;

		if (total > hl_ai_node_count)
			return 0;
	}

	count = total;

	if (count > HLNODE_PATH_MAX)
		count = HLNODE_PATH_MAX;

	//keep the head of the chain, the leg nearest the monster: step back over
	//the tail the cap drops, then fill forwards from the source. The SDK caps
	//iNumPathNodes while walking out from the source and reaches the same set
	at = dest;

	for (i = 0; i < total - count; i++)
		at = hl_ai_node_prev[at];

	for (i = count - 1; i >= 0; i--)
	{
		path[i] = at;
		at      = hl_ai_node_prev[at];
	}

	return count;
}

class CHLMonInfo
{
	U8	classname[32];		//monster_* entity classname
	I64	classify;			//HLCLASS_*, Classify() in the SDK

	F64	health;				//gSkillData at skill 1, from valve/skill.cfg
	F64	mins[3];			//UTIL_SetSize in Spawn()
	F64	maxs[3];
	F64	view_ofs;			//pev->view_ofs z, the eye the traces run from

	F64	fov;				//m_flFieldOfView, the COSINE of the half angle
	F64	look_dist;			//m_flDistLook
	F64	walk_speed;			//world units per second
	F64	run_speed;
	F64	yaw_speed;			//degrees per second

	//melee: reach and damage. melee_range 0 means it has no melee attack
	F64	melee_range;
	F64	melee_dmg;

	//ranged: hitscan unless blast_radius is set, in which case the attack
	//damages everything inside that radius of the MONSTER (houndeye sonic)
	F64	range_min;
	F64	range_max;			//0 means it has no ranged attack
	F64	range_dmg;
	I64	range_bullets;
	F64	blast_radius;

	//CheckRangeAttack2: the second ranged take. range2_max 0 means there is
	//only one, and stands in for bits_CAP_RANGE_ATTACK2. Only the controller
	//carries both.
	F64	range2_min;
	F64	range2_max;
	F64	range2_dmg;

	F64	attack_rate;		//seconds between attacks, either kind

	//no attack of any kind. HL's CScientist flees anything it dislikes; here
	//that is anything the relationship matrix makes fear or hate, since a
	//monster with no attack cannot act on hate.
	Bool flees;

	//CheckMeleeAttack2: the heavier of two melee takes. 0 means there is only
	//one. The zombie's both_slash and the bullsquid's tailwhip land here.
	F64	melee2_range;
	F64	melee2_dmg;

	//bits_CAP_SQUAD, set in Spawn(). Only these form squads
	Bool squads;

	//MOVETYPE_FLY. A flier holds the height it spawned at instead of being
	//dropped to the floor every step
	Bool flies;

	//m_bloodColor, HLBLOOD_* in HLPart.ZC. Decides the colour of the spray an
	//anim event throws when a claw connects
	I64	blood;

	//m_cClipSize. 0 never reloads, which is every monster but the grunt
	I64	clip_size;

	//HearingSensitivity() and ISoundMask(), monsters.cpp. The mask is which
	//CSound types this monster reacts to at all
	F64	hear_sens;
	I64	sound_mask;

	//the squad slots this monster must hold to run its ranged attack, from the
	//OccupySlot call in its GetSchedule. 0 means the attack is never gated
	I64	slot_attack;

	//how far the attack itself puts a bits_SOUND_COMBAT in the world sound
	//list. hgrunt.cpp's HGRUNT_AE_BURST1 inserts one at 384 units for 0.3s
	F64	attack_noise;

	//sequence labels, one 24-byte cell per HLACT_*. Flat rather than
	//[HLACT_COUNT][24] so the pointer handed to HLStudioSeqByName is a U8*.
	U8	seq[HLACT_COUNT * 24];

	//sound paths under sound/. empty is silence, not a missing file.
	U8	snd_idle[48];
	U8	snd_alert[48];
	U8	snd_attack[48];
	U8	snd_pain[48];
	U8	snd_die[48];
};

CHLMonInfo	hl_ai_mon_info[HLMON_COUNT];

//--- per-monster state ------------------------------------------------------

class CHLMonState
{
	I64		ent;			//entity index, -1 for a free slot
	I64		kind;			//HLMON_*
	I64		state;			//HLMSTATE_*

	I64		sched;			//HLSCHED_*
	I64		task;			//index into that schedule's task list
	I64		task_status;	//HLTK_*
	F64		task_start;		//hl_ent_time when the task was Start-ed
	Bool	sched_done;		//ran off the end of the list

	//m_afConditions, HLCOND_*. ChangeSchedule clears the whole set, so a bit
	//lives from the sense pass that raised it to the next schedule change
	I64		conds;

	//bits_MEMORY_FLINCHED, monsters.h:104. TASK_SMALL_FLINCH sets it and
	//nothing in the SDK clears it: a monster flinches once in a fight
	Bool	flinched;

	//enemy. -1 is the player, so a separate flag says whether there is one at
	//all rather than overloading the index as m_hEnemy's NULL does
	Bool	have_enemy;
	I64		enemy;
	F64		enemy_pos[3];	//last known position, not the live one
	F64		enemy_seen;		//hl_ent_time of the last clear sight line

	//movement goal
	Bool	have_goal;
	Bool	goal_is_enemy;	//refresh it from the enemy every tick
	F64		goal[3];
	F64	 	goal_tol;
	F64		move_speed;
	F64		path_start;
	F64		stuck_since;

	//FTriangulate's apex, monsters.cpp:1901-1903. m_Route holds ROUTE_SIZE
	//waypoints and InsertWaypoint pushes the apex in front of the goal. The
	//apex is one slot; the node route below is the rest of m_Route.
	Bool	have_detour;
	F64		detour[3];

	//FGetNodeRoute's iPath, monsters.cpp:2790. Node indices into the loaded
	//graph, walked in order and then the goal itself, which is what
	//FGetNodeRoute appends past the last node it copied. route_len 0 is no
	//route and the mover heads straight at the goal.
	I64		route_len;
	I64		route_at;
	I64		route_node[HLNODE_PATH_MAX];

	//the goal the route was built for, and when. A goal that has moved further
	//than HLAI_NODE_SLOP invalidates the route: TASK_GET_PATH_TO_ENEMY re-aims
	//at the enemy every tick and the nodes behind it go stale with it
	F64		route_for[3];
	F64		route_time;

	//next CheckLocalMove lookahead, on CBaseMonster::MonsterThink's own 0.1s
	//cadence. The lookahead walks 200 units in 16-unit hops and each hop is
	//three hull sweeps; the server tick is faster than the SDK's think
	F64		next_move_check;

	F64		ideal_yaw;
	F64		next_attack;
	F64		next_idle_snd;
	F64		next_look;		//Look() is throttled - see HLAI_LOOK_PERIOD
	F64		last_health;	//to notice damage without a hook in HLEntTakeDamage
	Bool	scripted;		//a scripted_sequence owns it this tick

	//DROP_TO_FLOOR, on the first think rather than at registration: the trace
	//it needs is defined further down and ZealC is single-pass
	Bool	settled;

	//--- squad, squadmonster.cpp ---
	//
	//m_hSquadLeader as a slot index. A leader points at itself, -1 is no
	//squad. The leader owns squad_slots for the whole squad; my_slot is the
	//one bit this member holds out of it.
	I64		squad;
	I64		squad_slots;	//m_afSquadSlots, meaningful on the leader only
	I64		my_slot;		//m_iMySlot
	Bool	squad_tried;	//StartMonster has run its one SquadRecruit

	//TASK_STORE_LASTPOSITION's m_vecLastPosition, which is how a monster that
	//walked off to a noise finds its post again
	Bool	have_lastpos;
	F64		lastpos[3];

	//m_cAmmoLoaded, and the pain sound throttle CBaseMonster::TakeDamage keeps
	I64		ammo;
	F64		next_pain_snd;

	//m_healTime, scientist.cpp:114. One minute between injections
	F64		heal_time;

	//m_cClipSize. Per slot rather than per kind: CHGrunt::Spawn gives a
	//HGRUNT_SHOTGUN grunt eight rounds and every other grunt thirty-six,
	//hgrunt.cpp:1013-1021
	I64		clip;

	//aim pitch fed to the range attack take's blend axis, in degrees, positive
	//down. SetBlending's world value; HLStudioBlendSetting maps it to the
	//0..255 setting the renderer takes
	F64		aim_pitch;

	//CHeadCrab leap: HC_AE_JUMPATTACK sets leaping and leap_vel; HLAIMonThink
	//integrates until ground or lifetime. LeapTouch damage on player contact.
	//tossing is trigger_monsterjump: same flight, no LeapTouch damage.
	Bool	leaping;
	F64		leap_vel[3];
	F64		leap_die;
	Bool	tossing;

	//the world sound this monster last heard, and where it was. The index
	//alone is not enough: the entry expires while the monster is still
	//walking to it
	I64		heard;
	F64		heard_pos[3];

	//PBestScent latch. Separate from heard_pos so Listen and Smell do not
	//overwrite each other mid-schedule
	Bool	have_smell;
	F64		smell_pos[3];
	I64		smell_type;
	I64		heard_type;

	//current HLACT_, for ReportAIState. m_Activity in the SDK
	I64		activity;

	//the sequence index `activity` last resolved to, -1 for none. Anything that
	//moves the entity off it - a scripted_sequence taking the actor, a death
	//take - breaks the "already playing it" gate in HLAISetActivity, so the
	//activity is resolved again instead of being left on the foreign sequence
	I64		act_seq;

	//when the idle take running now runs out. MonsterThink's fidget block keys
	//on m_fSequenceFinished, which for a looping take is raised once per cycle;
	//nothing here latches a cycle edge, so the deadline stands in for it
	F64		next_fidget;

	//next CBaseMonster::RunAI, for the eye blink only. RunAI is on a 0.1s think
	//and the blink counts down in think steps, so running it on the server tick
	//makes the blink six frames long and ten times as frequent
	F64		next_blink;

	//m_fGunDrawn, barney's holster bodygroup. The draw take runs once, on the
	//first transition out of idle
	Bool	gun_drawn;

	//bits_MEMORY_INCOVER, and the schedule to run when the current one fails.
	//TASK_SET_FAIL_SCHEDULE's m_failSchedule
	Bool	in_cover;
	I64		fail_sched;

	//--- CBarnacle, dlls/barnacle.cpp ---
	//
	//Predator side on the barnacle's own slot, victim side on the slot of
	//whatever hangs from it. A barnacle runs no schedule and no task list, so
	//these are the whole of its state.
	F64		own_think;		//pev->nextthink, for a monster that runs its own
	F64		barn_alt;		//m_flAltitude, tongue length in world units
	F64		barn_adj;		//m_flTongueAdj, the bone controller's bias
	F64		barn_kill;		//m_flKillVictimTime, negative while lifting
	I64		barn_gibs;		//m_cGibs, coughed up one at a time after a kill
	I64		barn_prey;		//m_hEnemy as a monster slot, -1 for none
	Bool	barn_lifting;	//m_fLiftingPrey
	Bool	barn_ext;		//m_fTongueExtended

	//MONSTERSTATE_PRONE: the slot of the barnacle holding this monster, -1
	//when it is free. A held victim runs its schedule and nothing else
	I64		barn_host;

	//--- CTripmineGrenade, dlls/tripmine.cpp ---
	F64		mine_arm;		//m_flPowerUp, when the beam comes up
	F64		mine_len;		//m_flBeamLength, the arming trace's fraction
	F64		mine_dir[3];	//m_vecDir, forward off pev->angles
	F64		mine_end[3];	//m_vecEnd, origin + dir * 2048
	F64		mine_beam[3];	//MakeBeam's vecTmpEnd, where the drawn beam stops
	F64		mine_boom;		//DelayDeathThink, tripmine.cpp:344
	Bool	mine_armed;		//the beam is up and the mine is live
	Bool	mine_dying;		//Killed has run, the blast is pending

	//--- CBaseTurret, dlls/turret.cpp ---
	F64		tur_cur[3];		//m_vecCurAngles, where the gun points
	F64		tur_goal[3];	//m_vecGoalAngles
	F64		tur_rate;		//m_fTurnRate, degrees per 0.1s
	F64		tur_ping;		//m_flPingTime
	F64		tur_sight;		//m_flLastSight
	F64		tur_dmg_time;	//pev->dmgtime, when it died
	I64		tur_state;		//HLTUR_*
	I64		tur_orient;		//m_iOrientation: 0 floor, 1 ceiling

	//--- CRoach, dlls/roach.cpp ---
	F64		rch_light;		//m_flLastLightLevel, negative before the first
	F64		rch_nofood;		//m_flHungryTime, no food until then
	I64		rch_mode;		//HLRCH_*
	Bool	rch_lit;		//m_fLightHacked, the one-second startup delay
};

CHLMonState	hl_ai_mon[HLAI_MON_MAX];
I64			hl_ai_mon_count = 0;

//entity index -> slot, -1 for an untracked entity
I64			hl_ai_mon_of[HLENT_MAX];

//what the registration pass last ran against. A new map reuses the same slots,
//so the map name is the primary key (same pattern as hl_ai_graph_map). Pointer
//and count alone are not enough: CAlloc can return the same address, and an
//entity count can repeat across two maps.
CHLEntity	*hl_ai_mon_base  = NULL;
I64			hl_ai_mon_ents   = 0;
F64			hl_ai_mon_clock  = 0.0;
U8			hl_ai_mon_map[96];

Bool		hl_ai_mon_revive = TRUE;
I64			hl_ai_mon_kills  = 0;

//g_pModelNameLaser, dlls/effects.cpp:39, which is what CTripmineGrenade::
//MakeBeam hands to BeamCreate. One sprite for every mine in the map;
//HLAIMonInit clears it and HLAIMonRegisterAll loads it on the first tripmine
CHLSpr		*hl_ai_laser_spr = NULL;

//pev->velocity of the player, which CRoach::Touch tests before it lets itself
//be squashed (roach.cpp:88). hl_velocity lives in HL1.ZC and compiles later,
//so the movement is measured here: the position at the last monster frame and
//how far it travelled since. HLAIMonsterFrame refreshes both.
F64			hl_ai_player_last[3];
F64			hl_ai_player_move = 0.0;

//CBaseEntity::FireBullets' `static int tracerCount`, combat.cpp:1374. One
//counter for every monster in the world, as the SDK's is
I64			hl_ai_tracer_count = 0;

//--- scripted_sequence state ------------------------------------------------
//
// The CCineMonster fields the shared CHLEntity does not carry, one row per
// entity index. A scripted_sequence uses its own row; an entity being acted on
// uses owner only. Indexed by entity rather than by a script slot so
// CanPlaySequence can ask "is this one already taken" in one load.

class CHLCineState
{
	F64	start;		//m_startTime, absolute game time
	F64	retry;		//next CineThink. 0 is unspawned, negative is no think
	I64	delay;		//m_iDelay, actors of this group still walking to a mark
	I64	state;		//m_scriptState of the actor this script holds
	I64	movetype;	//m_saved_movetype
	I64	solid;		//m_saved_solid
	I64	actor;		//m_hTargetEnt as an entity index, -1 for none
	I64	owner;		//m_pCine of THIS entity as a script index, -1 for none
	F64	blocked;	//when the walk to the mark first failed, 0 while it moves
	Bool	interrupt;	//m_interruptable; AE 1001/1002 and SF_SCRIPT_NOINTERRUPT
};

CHLCineState	hl_ai_cine[HLENT_MAX];

//`scriptlog 1` at the console. Refreshed once per frame in HLAIMonsterFrame so
//it can be turned on with a script already running, and assigned in
//HLAIMonRegisterAll because a declaration initialiser on a global does not run.
Bool	hl_ai_script_log;

U0 HLAICineResetRow(I64 i)
{//globals are not zeroed and the whole table is walked every tick
	hl_ai_cine[i].start    = HLAI_CINE_NEVER;
	hl_ai_cine[i].retry    = 0.0;
	hl_ai_cine[i].delay    = 0;
	hl_ai_cine[i].state    = HLSS_WAIT;
	hl_ai_cine[i].movetype = HLMOVETYPE_STEP;
	hl_ai_cine[i].solid    = HLSOLID_SLIDEBOX;
	hl_ai_cine[i].actor    = -1;
	hl_ai_cine[i].owner    = -1;
	hl_ai_cine[i].blocked  = 0.0;
	hl_ai_cine[i].interrupt = TRUE;
}

//--- talk monster state -----------------------------------------------------
//
// dlls/talkmonster.cpp. CTalkMonster is what separates a scientist from a
// headcrab: it greets the player, holds conversations with its own kind, turns
// its head at whoever is speaking, and follows on +use. The fields live one row
// per entity index for the reason CHLCineState does - CHLEntity belongs to
// HLEntity.ZC.
//
// Rows exist for every entity, not only tracked monsters: CSittingScientist
// takes no AI slot and still talks.

//m_bitsSaid, talkmonster.h:30-37
#define HLTLK_SAID_DMG_LIGHT	1
#define HLTLK_SAID_DMG_MEDIUM	2
#define HLTLK_SAID_DMG_HEAVY	4
#define HLTLK_SAID_HELLO		8
#define HLTLK_SAID_WOUND_LIGHT	16
#define HLTLK_SAID_WOUND_HEAVY	32
#define HLTLK_SAID_HEARD		64
#define HLTLK_SAID_SMELLED		128

//m_hTalkTarget / m_hTargetEnt as an index. The player is not in the monster
//table and its live position comes from the listener, so it needs its own value
#define HLTLK_NOBODY			-1
#define HLTLK_PLAYER			-2

//head bone controller envelope, degrees off the body's yaw. scientist.mdl slot
//0 is bone 20 Bip02 Head type XR over -60..60 at index 0 and barney.mdl slot 0
//is bone 21 Bip01 Head over the same range; hgrunt runs to 70. HLStudioCtlSetting
//clamps a larger angle onto the rail rather than rejecting it, which reads as a
//head rotated square to the shoulders
#define HLAI_TLK_HEAD_MAX		60.0

//CSittingScientist cannot turn its body, so its head carries the whole angle.
//m_headTurn spans RANDOM_LONG(0,8) * 10 - 40, scientist.cpp:1390
#define HLAI_TLK_SIT_HEAD_MAX	40.0

//TASK_TLK_IDEALYAW, talkmonster.cpp:424: the body turns until the listener sits
//within this of its facing and the head covers the remainder
#define HLAI_TLK_YAW_SLACK		45.0

//pev->yaw_speed while addressing someone, talkmonster.cpp:417. Degrees per
//second, and not the per-kind rate the movement tasks use
#define HLAI_TLK_YAW_SPEED		60.0

class CHLTalkState
{
	I64		bits_said;		//m_bitsSaid
	I64		n_speak;		//m_nSpeak, how often this one has started talking
	I64		voice_pitch;	//m_voicePitch, a percentage of the recorded rate
	F64		use_time;		//m_useTime, no +USE until then
	F64		stop_talk;		//m_flStopTalkTime, when the current line ends
	F64		last_smelled;	//m_flLastSaidSmelled
	F64		response;		//CSittingScientist::m_flResponseDelay
	F64		next_think;		//SittingThink's own 0.1s cadence
	F64		head_turn;		//m_headTurn, degrees off the body's yaw
	I64		talk_target;	//m_hTalkTarget
	I64		follow;			//m_hTargetEnt, the follow leader
	Bool	inited;			//TalkInit has run for this row

	//CSittingScientist::Spawn's DROP_TO_FLOOR, scientist.cpp:1273. This class
	//takes no AI slot, so hl_ai_mon[].settled cannot carry it
	Bool	settled;
};

CHLTalkState	hl_ai_talk[HLENT_MAX];

//hl_ai_talk_wait lives with the sentence globals at the top of this file
//(single-pass: the word ticker writes it before this point).

U0 HLAITalkResetRow(I64 i)
{//globals are not zeroed and the whole table is walked every tick
	hl_ai_talk[i].bits_said    = 0;
	hl_ai_talk[i].n_speak      = 0;
	hl_ai_talk[i].voice_pitch  = HLPITCH_NORM;
	hl_ai_talk[i].use_time     = 0.0;
	hl_ai_talk[i].stop_talk    = 0.0;
	hl_ai_talk[i].last_smelled = 0.0;
	hl_ai_talk[i].response     = 0.0;
	hl_ai_talk[i].next_think   = 0.0;
	hl_ai_talk[i].head_turn    = 0.0;
	hl_ai_talk[i].talk_target  = HLTLK_NOBODY;
	hl_ai_talk[i].follow       = HLTLK_NOBODY;
	hl_ai_talk[i].inited       = FALSE;
	hl_ai_talk[i].settled      = FALSE;
}

//--- the world sound list ---------------------------------------------------
//
// CSoundEnt, dlls/soundent.cpp. HL's monsters hear through a global list of
// CSound records rather than through the mixer: anything that wants to be
// noticed calls CSoundEnt::InsertSound with a type, a position, a radius and a
// lifetime, and CBaseMonster::Listen walks the live entries against the
// monster's own sound mask and hearing sensitivity.
//
// The SDK keeps a free list and an active list threaded through one pool. A
// flat array with an expiry stamp holds the same information: the pool is 64
// entries and the walk is over all of them, which at this size costs less than
// maintaining two threaded lists.
//
// Volume is the audible radius in world units, as m_iVolume is in the SDK -
// not a mixer gain. Nothing here plays a sound; HLSndPlayAt is separate and a
// caller that wants both makes both calls, exactly as the SDK does.

class CHLWorldSound
{
	F64	origin[3];
	F64	expire;		//m_flExpireTime, absolute game time
	F64	volume;		//m_iVolume, the radius at hearing sensitivity 1.0
	I64	type;		//HLSOUND_*
};

CHLWorldSound	hl_ai_snd[HLAI_WORLD_SOUNDS];

//the player's own entry. CSoundEnt::Update keeps one per client rather than
//inserting a fresh record every frame, so a walking player does not fill the
//pool
I64	hl_ai_snd_player = 0;

//where the listener was last tick, to derive the player's speed without
//reaching hl_velocity in HL1.ZC, which compiles later
F64		hl_ai_snd_prev[3];
Bool	hl_ai_snd_prev_ok = FALSE;
F64		hl_ai_snd_next    = 0.0;

//CBasePlayer::m_iWeaponVolume, set by whatever fires a weapon and decayed
//here. HLWeapon.ZC compiles after this file and can write it.
F64	hl_ai_gun_volume = 0.0;

U0 HLAISoundListInit()
{//globals are not zeroed and this table is walked every tick
	I64 i;

	for (i = 0; i < HLAI_WORLD_SOUNDS; i++)
	{
		hl_ai_snd[i].expire = 0.0;
		hl_ai_snd[i].volume = 0.0;
		hl_ai_snd[i].type   = HLSOUND_NONE;

		HLVecSet(hl_ai_snd[i].origin, 0.0, 0.0, 0.0);
	}

	//slot 0 is the client's, reserved as CSoundEnt reserves one per player
	hl_ai_snd_player  = 0;
	hl_ai_snd_prev_ok = FALSE;
	hl_ai_snd_next    = 0.0;
	hl_ai_gun_volume  = 0.0;

	HLVecSet(hl_ai_snd_prev, 0.0, 0.0, 0.0);
}

I64 HLAIAllocSound()
{//IAllocSound: the first expired entry, or the one that expires soonest
 //
 //the SDK returns SOUNDLIST_EMPTY when the pool is full and drops the sound.
 //Recycling the oldest instead keeps the newest event audible, which is the
 //one a monster should react to.
	F64	oldest;
	I64	best = 1;
	I64	i;

	//slot 0 belongs to the player and is never handed out
	oldest = hl_ai_snd[1].expire;

	for (i = 1; i < HLAI_WORLD_SOUNDS; i++)
	{
		if (hl_ai_snd[i].expire <= hl_ent_time)
			return i;

		if (hl_ai_snd[i].expire < oldest)
		{
			oldest = hl_ai_snd[i].expire;
			best   = i;
		}
	}

	return best;
}

U0 HLAIInsertSound(I64 type, F64 *origin, F64 volume, F64 duration)
{//CSoundEnt::InsertSound. volume is the audible radius in world units
	I64 i;

	if (!origin || volume <= 0.0 || duration <= 0.0)
		return;

	i = HLAIAllocSound;

	HLVecCopy(origin, hl_ai_snd[i].origin);

	hl_ai_snd[i].type   = type;
	hl_ai_snd[i].volume = volume;
	hl_ai_snd[i].expire = hl_ent_time + duration;
}

U0 HLAIPlayerSound(F64 *origin, F64 speed)
{//CSoundEnt::Update's client entry plus CBasePlayer::UpdatePlayerSound
 //
 //the SDK scales the radius off the player's speed and adds m_iWeaponVolume,
 //which a fired weapon sets and which decays. A crouching, still player makes
 //no sound at all, which is what lets someone sneak past a sleeping houndeye.
	F64 vol;

	//UpdatePlayerSound's bar: below this the player is not audible
	if (speed <= 100.0)
		vol = 0.0;
	else
		vol = speed;

	if (hl_ai_gun_volume > vol)
		vol = hl_ai_gun_volume;

	//m_iWeaponVolume decays over about a quarter second in the SDK
	hl_ai_gun_volume -= hl_ai_gun_volume * 0.25;

	if (hl_ai_gun_volume < 1.0)
		hl_ai_gun_volume = 0.0;

	if (vol <= 0.0)
	{
		hl_ai_snd[hl_ai_snd_player].expire = 0.0;
		return;
	}

	HLVecCopy(origin, hl_ai_snd[hl_ai_snd_player].origin);

	hl_ai_snd[hl_ai_snd_player].type   = HLSOUND_PLAYER;
	hl_ai_snd[hl_ai_snd_player].volume = vol;

	//0.3 is the SDK's client sound lifetime, long enough to survive one
	//monster think at the SDK's 0.1s cadence
	hl_ai_snd[hl_ai_snd_player].expire = hl_ent_time + 0.3;
}

U0 HLAISoundFrame()
{//the player half of CSoundEnt::Update, once per tick
 //
 //hl_velocity lives in HL1.ZC and compiles later, so the speed comes from how
 //far the listener moved since the last call. Bob rides on top of it and adds
 //a few units a second, well under the 100-unit audibility bar.
	F64 d[3];
	F64 dt;
	F64 speed;

	dt = hl_ent_time - hl_ai_snd_next;

	//the listener is re-sampled at a fixed cadence rather than per tick: at
	//72Hz the per-tick delta is a couple of units and rounds to noise
	if (dt < 0.1)
		return;

	hl_ai_snd_next = hl_ent_time;

	if (!hl_ai_snd_prev_ok || dt <= 0.0 || dt > 1.0)
	{
		HLVecCopy(hl_snd_listener, hl_ai_snd_prev);
		hl_ai_snd_prev_ok = TRUE;
		return;
	}

	HLVecSub(hl_snd_listener, hl_ai_snd_prev, d);
	speed = HLVecLength(d) / dt;

	HLVecCopy(hl_snd_listener, hl_ai_snd_prev);

	//the entry sits at the player's feet, where the noise is made
	d[0] = hl_snd_listener[0];
	d[1] = hl_snd_listener[1];
	d[2] = hl_snd_listener[2] - HLAI_PLAYER_EYE;

	HLAIPlayerSound(d, speed);
}

//--- schedules --------------------------------------------------------------
//
// Flat arrays rather than nested initialisers: a global's initialiser is
// unreliable on this compiler, so every row is appended by a call at runtime.

I64	hl_ai_sched_task[HLSCHED_COUNT * HLAI_SCHED_TASKS];
F64	hl_ai_sched_data[HLSCHED_COUNT * HLAI_SCHED_TASKS];
I64	hl_ai_sched_len[HLSCHED_COUNT];

//Schedule_t::iInterruptMask and ::iSoundMask, schedule.h:255-288. The first is
//which HLCOND_ bits abort this schedule, the second which HLSOUND_ types the
//monster hears at all while running it - Listen ands its own ISoundMask with
//it, monsters.cpp:216.
I64	hl_ai_sched_int[HLSCHED_COUNT];
I64	hl_ai_sched_snd[HLSCHED_COUNT];

U0 HLAISchedMask(I64 sched, I64 interrupt, I64 sound)
{//the two masks of one schedule
	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	hl_ai_sched_int[sched] = interrupt;
	hl_ai_sched_snd[sched] = sound;
}

U0 HLAISchedAdd(I64 sched, I64 task, F64 data)
{//append one task to a schedule
	I64 n;

	if (sched < 0 || sched >= HLSCHED_COUNT)
		return;

	n = hl_ai_sched_len[sched];

	if (n >= HLAI_SCHED_TASKS)
	{
		"HLAI: schedule %d full\n", sched;
		return;
	}

	hl_ai_sched_task[sched * HLAI_SCHED_TASKS + n] = task;
	hl_ai_sched_data[sched * HLAI_SCHED_TASKS + n] = data;

	//incremented separately: `x[i++] = f()` loses the store on this compiler
	hl_ai_sched_len[sched] = n + 1;
}

U0 HLAISetCond(I64 s, I64 bits)
{//SetConditions, basemonster.h
	hl_ai_mon[s].conds = hl_ai_mon[s].conds | bits;
}

U0 HLAIClearCond(I64 s, I64 bits)
{//ClearConditions
	hl_ai_mon[s].conds = hl_ai_mon[s].conds & ~bits;
}

Bool HLAIHasCond(I64 s, I64 bits)
{//HasConditions: any of them
	return ToBool((hl_ai_mon[s].conds & bits) != 0);
}

Bool HLAISchedValid(I64 s)
{//FScheduleValid, schedule.cpp:169. FALSE once a condition in the running
 //schedule's interrupt mask has come up, which abandons it mid-task.
 //
 //bits_COND_TASK_FAILED is folded into the interpreter's HLTK_FAILED and
 //bits_COND_SCHEDULE_DONE into sched_done, so neither is tested here.
	I64 sched = hl_ai_mon[s].sched;

	if (sched <= HLSCHED_NONE || sched >= HLSCHED_COUNT)
		return FALSE;

	return ToBool((hl_ai_mon[s].conds & hl_ai_sched_int[sched]) == 0);
}

U0 HLAISchedInit()
{//defaultai.cpp's slIdleStand, slAlertFace, slChaseEnemy and the rest, cut
 //down to the tasks a monster with no node graph and no squad can run
	I64 i;

	for (i = 0; i < HLSCHED_COUNT; i++)
	{
		hl_ai_sched_len[i] = 0;

		//a schedule with no HLAISchedMask call runs to its last task, which is
		//what a zero iInterruptMask means in defaultai.cpp
		hl_ai_sched_int[i] = HLCOND_NONE;
		hl_ai_sched_snd[i] = HLSOUND_NONE;
	}

	//slIdleStand: stand there, look around, wait a random while
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_IDLE_STAND, HLTASK_WAIT_RANDOM, 5.0);

	//slAlertStand: the same, shorter - an alert monster re-decides often
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_ALERT_STAND, HLTASK_WAIT_RANDOM, 2.0);

	//slAlertFace: turn to whatever it noticed
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_FACE, HLTASK_WAIT, 1.0);

	//slWakeAngry: the noise on first seeing an enemy, before anything moves
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_SOUND_ALERT, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_WAKE_ANGRY, HLTASK_WAIT, 0.4);

	//slChaseEnemy. In the SDK TASK_GET_PATH_TO_ENEMY calls the node graph and
	//fails when there is no route; here it only records the goal, so the run
	//that follows is a straight line with a wall slide.
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_PATH_TO_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_SET_ACTIVITY, HLACT_RUN);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_ENEMY, HLTASK_FACE_ENEMY, 0.0);

	//slMeleeAttack1
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK1, HLTASK_MELEE_ATTACK1, 0.0);

	//slRangeAttack1
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK1, HLTASK_RANGE_ATTACK1, 0.0);

	//slTakeCoverFromEnemy, with the cover node lookup replaced by
	//FindLateralCover's sampling - see HLAIFindCover
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_SOUND_ALERT, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_WAIT, 0.2);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_FIND_COVER_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_TAKE_COVER, HLTASK_WAIT, 1.0);

	//slSmallFlinch, defaultai.cpp:672. TASK_SMALL_FLINCH rather than
	//SET_ACTIVITY plus WAIT_FOR_ANIM: it is the task that raises
	//bits_MEMORY_FLINCHED, and without it the selector picks this schedule
	//again on the next round of incoming fire
	HLAISchedAdd(HLSCHED_SMALL_FLINCH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_SMALL_FLINCH, HLTASK_SMALL_FLINCH, 0.0);

	//slDie. TASK_DIE holds the last frame; no corpse removal and no gibs, so
	//the body stays where it fell.
	HLAISchedAdd(HLSCHED_DIE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_DIE, HLTASK_SOUND_DIE, 0.0);
	HLAISchedAdd(HLSCHED_DIE, HLTASK_DIE, 0.0);

	//slIdleWalk: wander. The SDK walks the route the node graph left in
	//m_Route; with no graph the goal is a clear point nearby, so an idle
	//monster paces rather than patrols.
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_FIND_COVER_ORG, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_FACE_GOAL, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_IDLE_WALK, HLTASK_STOP_MOVING, 0.0);

	//slAlertSmallFlinch: flinch, then face what hit you. The SDK's
	//TASK_SET_SCHEDULE(SCHED_ALERT_FACE) is the last task, so it is here too
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_SMALL_FLINCH, 0.0);
	HLAISchedAdd(HLSCHED_ALERT_SM_FLINCH, HLTASK_SET_SCHEDULE,
		HLSCHED_ALERT_FACE);

	//slInvestigateSound: walk to the noise, look around, walk back to the
	//post. The whole point of the sound list - a gunshot two rooms away pulls
	//a patrol out of position.
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_STORE_LASTPOS, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PATH_TO_SOUND, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_FACE_IDEAL, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PLAY_SEQUENCE, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WAIT, 10.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_PATH_TO_LASTPOS, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_WALK_PATH, 0.0);
	HLAISchedAdd(HLSCHED_INVEST_SOUND, HLTASK_CLEAR_LASTPOS, 0.0);

	//slCombatFace
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_COMBAT_FACE, HLTASK_FACE_ENEMY, 0.0);

	//slCombatStand: hold, facing the enemy, until something changes. The SDK
	//waits indefinitely on the conditions; here the state machine re-selects
	//when the enemy moves, so it is a bounded wait instead
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_SET_ACTIVITY, HLACT_COMBAT_IDLE);
	HLAISchedAdd(HLSCHED_COMBAT_STAND, HLTASK_WAIT_FACE_ENEMY, 1.0);

	//slChaseEnemyFailed: the chase could not get there, so break contact and
	//come back facing. This is where a blocked path lands now instead of
	//re-selecting the same chase next tick.
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_WAIT, 0.2);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_FIND_COVER_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_CHASE_FAILED, HLTASK_WAIT, 1.0);

	//slStandoff: in cover or out of contact, hold and watch. What a grunt
	//with no engage slot does instead of walking into the open.
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_SET_ACTIVITY, HLACT_COMBAT_IDLE);
	HLAISchedAdd(HLSCHED_STANDOFF, HLTASK_WAIT_FACE_ENEMY, 2.0);

	//slReload
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RELOAD, HLTASK_RELOAD, 0.0);

	//slArmWeapon: barney drawing his pistol
	HLAISchedAdd(HLSCHED_ARM_WEAPON, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_ARM_WEAPON, HLTASK_PLAY_SEQUENCE, HLACT_ARM);

	//slSecondaryMeleeAttack
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_SOUND_ATTACK, 0.0);
	HLAISchedAdd(HLSCHED_MELEE_ATTACK2, HLTASK_MELEE_ATTACK2, 0.0);

	//slRangeAttack2
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_RANGE_ATTACK2, HLTASK_RANGE_ATTACK2, 0.0);

	//slSpecialAttack1: the houndeye's warm-up blast and the agrunt's threat
	//display both run through this
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_FACE_ENEMY, 0.0);
	HLAISchedAdd(HLSCHED_SPECIAL_ATTACK1, HLTASK_SPECIAL_ATTACK1, 0.0);

	//slTakeCoverFromBestSound. TASK_TURN_LEFT 179 is the SDK's way of putting
	//the monster's back to what it ran from
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_FIND_COVER_SOUND, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_SOUND, HLTASK_TURN_LEFT, 179.0);

	//slTakeCoverFromOrigin
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_FIND_COVER_ORG, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_RUN_PATH, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COVER_ORIGIN, HLTASK_TURN_LEFT, 179.0);

	//slCower: nowhere left to run
	HLAISchedAdd(HLSCHED_COWER, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_COWER, HLTASK_PLAY_SEQUENCE, HLACT_COWER);

	//slVictoryDance
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_PLAY_SEQUENCE, HLACT_VICTORY);
	HLAISchedAdd(HLSCHED_VICTORY_DANCE, HLTASK_WAIT, 1.0);

	//slAmbush: hold position until something is seen. The SF_MONSTER_WAIT_
	//FOR_SCRIPT spawnflag monsters use to stay put in a trap room
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_AMBUSH, HLTASK_WAIT_INDEF, 0.0);

	//slBarnacleVictimGrab: the tongue has hit, so play the hit take and then
	//cycle the pull take while the barnacle hoists
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_PLAY_SEQUENCE, HLACT_BARN_HIT);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_SET_ACTIVITY, HLACT_BARN_PULL);
	HLAISchedAdd(HLSCHED_BARNACLE_GRAB, HLTASK_WAIT_INDEF, 0.0);

	//slBarnacleVictimChomp
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_PLAY_SEQUENCE,
		HLACT_BARN_CHOMP);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_SET_ACTIVITY, HLACT_BARN_CHEW);
	HLAISchedAdd(HLSCHED_BARNACLE_CHOMP, HLTASK_WAIT_INDEF, 0.0);

	//slFail: stand still for two seconds after a schedule collapses, so a
	//monster whose every option fails does not thrash through the selector
	//once per tick
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_FAIL, HLTASK_WAIT, 2.0);

	//slFaceTarget, scientist.cpp:236-240. Ends by jumping to the chase, so a
	//follower that has caught up turns to its leader and then waits on the
	//move task rather than falling back through the selector.
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_STOP_MOVING, 0.0);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_FACE_TARGET, 0.0);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_SET_ACTIVITY, HLACT_IDLE);
	HLAISchedAdd(HLSCHED_TARGET_FACE, HLTASK_SET_SCHEDULE,
		HLSCHED_TARGET_CHASE);

	//slFollow, scientist.cpp:132-137. 128 units is tlFollow's own figure.
	//TASK_SET_FAIL_SCHEDULE(SCHED_CANT_FOLLOW) has no counterpart here: the
	//move task stops the follow itself when it cannot reach the leader.
	HLAISchedAdd(HLSCHED_TARGET_CHASE, HLTASK_MOVE_TO_TARGET,
		HLAI_FOLLOW_DIST);

	//tlHeal, scientist.cpp:211-219. TASK_SET_FAIL_SCHEDULE(SCHED_TARGET_CHASE)
	//has no counterpart: a failed task here ends the schedule and the selector
	//hands back the follow pair on the next tick.
	//
	//The needle takes are ACT_ARM and ACT_DISARM - scientist.mdl's pull_needle
	//and return_needle, sequences 28 and 29 - and the injection itself is
	//ACT_MELEE_ATTACK1, give_shot, whose one event delivers the health
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_MOVE_TO_TARGET, 50.0);
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_FACE_TARGET, 0.0);
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_SAY_HEAL, 0.0);
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_PLAY_SEQUENCE, HLACT_ARM);
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_HEAL, 0.0);
	HLAISchedAdd(HLSCHED_HEAL, HLTASK_PLAY_SEQUENCE, HLACT_DISARM);

	//--- interrupt masks ---
	//
	//Schedule_t's third and fourth members, one line per schedule rather than
	//interleaved with the task appends above: a mask is a single value and the
	//column reads as the table defaultai.cpp writes it as.
	//
	//A schedule with no line here has both masks zero and runs to its last
	//task. That is deliberate for every attack take, the flinches, the death
	//and the barnacle victim pair, all of which carry a zero mask in the SDK.
	//
	//Every sound mask below is HLSOUND_ types narrowed from the monster's own
	//ISoundMask, not widened: Listen ands the two.

	//slIdleStand, defaultai.cpp:60. The one place a monster hears rubbish
	HLAISchedMask(HLSCHED_IDLE_STAND,
		HLCOND_NEW_ENEMY | HLCOND_SEE_FEAR | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_HEAR_SOUND,
		HLSOUND_COMBAT | HLSOUND_WORLD | HLSOUND_PLAYER | HLSOUND_DANGER |
		HLSOUND_MEAT | HLSOUND_CARCASS | HLSOUND_GARBAGE);

	//slIdleWalk, defaultai.cpp:105. Deaf to the world and the player: a monster
	//already walking does not stop for a door
	HLAISchedMask(HLSCHED_IDLE_WALK,
		HLCOND_NEW_ENEMY | HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE |
		HLCOND_HEAR_SOUND,
		HLSOUND_COMBAT | HLSOUND_MEAT | HLSOUND_CARCASS | HLSOUND_GARBAGE);

	//slAmbush, defaultai.cpp:140. Sight and pain only, which is what makes it
	//hold through a firefight in the next room
	HLAISchedMask(HLSCHED_AMBUSH,
		HLCOND_NEW_ENEMY | HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE,
		HLSOUND_NONE);

	//slAlertFace, defaultai.cpp:180
	HLAISchedMask(HLSCHED_ALERT_FACE,
		HLCOND_NEW_ENEMY | HLCOND_SEE_FEAR | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE,
		HLSOUND_NONE);

	//slAlertStand, defaultai.cpp:280
	HLAISchedMask(HLSCHED_ALERT_STAND,
		HLCOND_NEW_ENEMY | HLCOND_SEE_ENEMY | HLCOND_SEE_FEAR |
		HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE | HLCOND_HEAR_SOUND,
		HLSOUND_COMBAT | HLSOUND_WORLD | HLSOUND_PLAYER | HLSOUND_DANGER |
		HLSOUND_MEAT | HLSOUND_CARCASS | HLSOUND_GARBAGE);

	//slInvestigateSound, defaultai.cpp:325. Only a danger sound turns a monster
	//already walking to a noise: otherwise its own footsteps re-target it
	HLAISchedMask(HLSCHED_INVEST_SOUND,
		HLCOND_NEW_ENEMY | HLCOND_SEE_FEAR | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slCombatStand and slCombatFace
	HLAISchedMask(HLSCHED_COMBAT_STAND,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_CAN_ATTACK,
		HLSOUND_NONE);

	HLAISchedMask(HLSCHED_COMBAT_FACE,
		HLCOND_CAN_ATTACK | HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD,
		HLSOUND_NONE);

	//slStandoff. Melee does not break it: the point of a standoff is to hold
	//range, so only a shot that has come open pulls it out
	HLAISchedMask(HLSCHED_STANDOFF,
		HLCOND_CAN_RANGE1 | HLCOND_CAN_RANGE2 | HLCOND_ENEMY_DEAD |
		HLCOND_NEW_ENEMY | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slReload. Heavy damage only: a grunt finishes the magazine under fire
	HLAISchedMask(HLSCHED_RELOAD, HLCOND_HEAVY_DAMAGE, HLSOUND_NONE);

	//slRangeAttack1 and slRangeAttack2
	HLAISchedMask(HLSCHED_RANGE_ATTACK1,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_ENEMY_OCCLUDED |
		HLCOND_NO_AMMO_LOADED | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	HLAISchedMask(HLSCHED_RANGE_ATTACK2,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_ENEMY_OCCLUDED | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slPrimaryMeleeAttack and slSecondaryMeleeAttack: no sound mask, so a
	//grenade under a zombie's feet does not stop the swing
	HLAISchedMask(HLSCHED_MELEE_ATTACK1,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_ENEMY_OCCLUDED,
		HLSOUND_NONE);

	HLAISchedMask(HLSCHED_MELEE_ATTACK2,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_ENEMY_OCCLUDED,
		HLSOUND_NONE);

	//slSpecialAttack1
	HLAISchedMask(HLSCHED_SPECIAL_ATTACK1,
		HLCOND_NEW_ENEMY | HLCOND_ENEMY_DEAD | HLCOND_LIGHT_DAMAGE |
		HLCOND_HEAVY_DAMAGE | HLCOND_ENEMY_OCCLUDED |
		HLCOND_NO_AMMO_LOADED | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slChaseEnemy. Any attack coming open ends the run, which is what stops a
	//monster jogging into contact and past it
	HLAISchedMask(HLSCHED_CHASE_ENEMY,
		HLCOND_NEW_ENEMY | HLCOND_CAN_ATTACK | HLCOND_TASK_FAILED |
		HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slChaseEnemyFailed. No TASK_FAILED: it is where a failed chase lands
	HLAISchedMask(HLSCHED_CHASE_FAILED,
		HLCOND_NEW_ENEMY | HLCOND_CAN_ATTACK | HLCOND_HEAR_SOUND,
		HLSOUND_DANGER);

	//slTakeCoverFromEnemy, slTakeCoverFromBestSound and slTakeCoverFromOrigin.
	//A monster running for cover keeps running: only a different enemy stops it
	HLAISchedMask(HLSCHED_TAKE_COVER, HLCOND_NEW_ENEMY, HLSOUND_NONE);
	HLAISchedMask(HLSCHED_COVER_SOUND, HLCOND_NEW_ENEMY, HLSOUND_NONE);
	HLAISchedMask(HLSCHED_COVER_ORIGIN, HLCOND_NEW_ENEMY, HLSOUND_NONE);

	//slFail, defaultai.cpp:39. An attack coming open cuts the two-second stall
	HLAISchedMask(HLSCHED_FAIL, HLCOND_CAN_ATTACK, HLSOUND_NONE);

	//slFaceTarget and slFollow, scientist.cpp:246 and :143. bits_COND_CLIENT_
	//PUSH is absent - nothing here pushes a follower out of a doorway
	HLAISchedMask(HLSCHED_TARGET_FACE,
		HLCOND_NEW_ENEMY | HLCOND_HEAR_SOUND,
		HLSOUND_COMBAT | HLSOUND_DANGER);

	HLAISchedMask(HLSCHED_TARGET_CHASE,
		HLCOND_NEW_ENEMY | HLCOND_LIGHT_DAMAGE | HLCOND_HEAVY_DAMAGE |
		HLCOND_HEAR_SOUND,
		HLSOUND_COMBAT | HLSOUND_DANGER);
}

//--- the table's contents ---------------------------------------------------

U0 HLAIMonSeq(I64 kind, I64 act, U8 *label)
{//one sequence label. The label has to be copied: a U8* table of literals
 //collapses to one entry on this compiler
	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return;

	HLStrCopy(&hl_ai_mon_info[kind].seq[act * 24], label, 24);
}

U8 *HLAIMonSeqOf(I64 kind, I64 act)
{//the label for one activity, NULL when the monster has no such sequence
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return NULL;

	p = &hl_ai_mon_info[kind].seq[act * 24];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAIMonHull(I64 kind, F64 w, F64 h, F64 eye)
{//UTIL_SetSize plus view_ofs. Monsters stand on their origin, so mins z is 0
	CHLMonInfo *m;

	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	m = &hl_ai_mon_info[kind];

	HLVecSet(m->mins, -w, -w, 0.0);
	HLVecSet(m->maxs, w, w, h);
	m->view_ofs = eye;
}

U0 HLAIMonTableInit()
{//every row, assigned field by field
 //
 //health and damage are gSkillData at skill 1, from valve/skill.cfg. Every
 //sk_-named figure below is a fallback: HLSkillApply in HLGame.ZC re-reads
 //skill.cfg at each map load and assigns over health, melee_dmg, melee2_dmg
 //and range_dmg. Read the file, not this table, for the value in play.
 //
 //FOV is m_flFieldOfView from each Spawn(), a cosine: 0.5 is a 120 degree
 //cone, -1.0 is all round.
	CHLMonInfo	*m;
	I64			 i;
	I64			 j;

	for (i = 0; i < HLMON_COUNT; i++)
	{
		m = &hl_ai_mon_info[i];

		m->classname[0]   = 0;
		m->classify       = HLCLASS_NONE;
		m->health         = 20.0;
		m->view_ofs       = 20.0;
		m->fov            = 0.5;
		m->look_dist      = 2048.0;
		m->walk_speed     = 32.0;
		m->run_speed      = 120.0;
		m->yaw_speed      = 120.0;
		m->melee_range    = 0.0;
		m->melee_dmg      = 0.0;
		m->range_min      = 0.0;
		m->range_max      = 0.0;
		m->range_dmg      = 0.0;
		m->range_bullets  = 1;
		m->blast_radius   = 0.0;
		m->range2_min     = 0.0;
		m->range2_max     = 0.0;
		m->range2_dmg     = 0.0;
		m->attack_rate    = 1.0;
		m->flees          = FALSE;
		m->melee2_range   = 0.0;
		m->melee2_dmg     = 0.0;
		m->squads         = FALSE;
		m->flies          = FALSE;
		m->blood          = HLBLOOD_RED;
		m->clip_size      = 0;
		m->slot_attack    = HLSLOT_NONE;
		m->attack_noise   = 0.0;

		//HearingSensitivity() is 1.0 in CBaseMonster and ISoundMask() is
		//bits_ALL_SOUNDS; the rows below narrow either where the SDK does
		m->hear_sens      = 1.0;
		m->sound_mask     = HLSOUND_ALL;

		m->snd_idle[0]    = 0;
		m->snd_alert[0]   = 0;
		m->snd_attack[0]  = 0;
		m->snd_pain[0]    = 0;
		m->snd_die[0]     = 0;

		HLVecSet(m->mins, -16.0, -16.0, 0.0);
		HLVecSet(m->maxs, 16.0, 16.0, 72.0);

		for (j = 0; j < HLACT_COUNT; j++)
			m->seq[j * 24] = 0;
	}

	//--- headcrab. CHeadCrab: 10 health, bite 5, all-round vision. MELEE is
	//"jump"; HC_AE_JUMPATTACK launches leap_vel and HLAIMonThink integrates
	//until ground or lifetime (LeapTouch damage on player contact).
	m = &hl_ai_mon_info[HLMON_HEADCRAB];
	HLStrCopy(m->classname, "monster_headcrab", 32);
	m->classify    = HLCLASS_ALIEN_PREY;
	m->health      = 10.0;
	m->fov         = -1.0;			//pev->view_ofs/FOV: crabs see everything
	m->walk_speed  = 40.0;
	m->run_speed   = 150.0;
	m->yaw_speed   = 200.0;
	m->melee_range = 40.0;
	m->melee_dmg   = 5.0;
	m->attack_rate = 0.6;
	HLAIMonHull(HLMON_HEADCRAB, 12.0, 24.0, 12.0);
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_MELEE,  "jump");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_DIE,    "dieback");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_COMBAT_IDLE, "angry");
	HLStrCopy(m->snd_idle,   "headcrab/hc_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "headcrab/hc_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "headcrab/hc_attack1.wav", 48);
	HLStrCopy(m->snd_pain,   "headcrab/hc_pain1.wav", 48);
	HLStrCopy(m->snd_die,    "headcrab/hc_die1.wav", 48);

	//--- zombie. CZombie: 50 health, one_slash 10 on attack1 (the left and
	//right claws, ZOMBIE_AE_ATTACK_LEFT/RIGHT), both_slash 25 on attack2
	//(ZOMBIE_AE_ATTACK_BOTH). No run sequence in the model.
	m = &hl_ai_mon_info[HLMON_ZOMBIE];
	HLStrCopy(m->classname, "monster_zombie", 32);
	m->classify    = HLCLASS_ALIEN_MONSTER;
	m->health      = 50.0;
	m->fov         = 0.2;
	m->walk_speed  = 30.0;
	m->run_speed   = 60.0;
	m->yaw_speed   = 90.0;
	m->melee_range = 64.0;
	m->melee_dmg   = 10.0;
	m->attack_rate = 1.0;
	HLAIMonHull(HLMON_ZOMBIE, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_RUN,    "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE,  "attack1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE2, "attack2");

	//CheckTraceHullAttack's reach is 70 for both takes, wider than the 64 the
	//attack is chosen at
	m->melee2_range = 70.0;
	m->melee2_dmg   = 25.0;			//sk_zombie_dmg_both_slash1
	HLStrCopy(m->snd_idle,   "zombie/zo_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "zombie/zo_alert10.wav", 48);
	HLStrCopy(m->snd_attack, "zombie/zo_attack1.wav", 48);
	HLStrCopy(m->snd_pain,   "zombie/zo_pain1.wav", 48);
	HLStrCopy(m->snd_die,    "zombie/zo_pain2.wav", 48);

	//--- scientist. CScientist: 20 health, no attack, SelectSchedule a chain of
	//flee and follow behaviours. Following the player needs CTalkMonster's use
	//handling and a player-relative goal; only the flee half is here.
	m = &hl_ai_mon_info[HLMON_SCIENTIST];
	HLStrCopy(m->classname, "monster_scientist", 32);
	m->classify   = HLCLASS_HUMAN_PASSIVE;
	m->health     = 20.0;
	m->fov        = 0.5;
	m->walk_speed = 40.0;
	m->run_speed  = 180.0;
	m->yaw_speed  = 120.0;
	m->flees      = TRUE;
	HLAIMonHull(HLMON_SCIENTIST, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_WALK,   "walk_scared");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_FLINCH, "flinch1");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_COWER,  "cowering_in_corner");
	HLAIMonSeq(HLMON_SCIENTIST, HLACT_BARN_HIT,   "barnacled1");
