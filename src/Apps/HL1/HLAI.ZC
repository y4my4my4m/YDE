	m->yaw_speed    = 120.0;
	m->range_min    = 64.0;
	m->range_max    = 1024.0;
	m->range_dmg    = 5.0;
	m->attack_rate  = 0.4;
	HLAIMonHull(HLMON_BARNEY, 16.0, 72.0, 52.0);
