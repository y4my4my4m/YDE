U0 HLAIMonSeq(I64 kind, I64 act, U8 *label)
{
	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return;

	HLStrCopy(&hl_ai_mon_info[kind].seq[act * 24], label, 24);
}

U8 *HLAIMonSeqOf(I64 kind, I64 act)
{
	U8 *p;

	if (kind < 0 || kind >= HLMON_COUNT || act < 0 || act >= HLACT_COUNT)
		return NULL;

	p = &hl_ai_mon_info[kind].seq[act * 24];

	if (!p[0])
		return NULL;

	return p;
}

U0 HLAIMonHull(I64 kind, F64 w, F64 h, F64 eye)
{
	CHLMonInfo *m;

	if (kind < 0 || kind >= HLMON_COUNT)
		return;

	m = &hl_ai_mon_info[kind];

	HLVecSet(m->mins, -w, -w, 0.0);
	HLVecSet(m->maxs, w, w, h);
	m->view_ofs = eye;
}

U0 HLAIMonTableInit()
{
	CHLMonInfo	*m;
	I64			 i;
	I64			 j;

	for (i = 0; i < HLMON_COUNT; i++)
	{
		m = &hl_ai_mon_info[i];

		m->classname[0]   = 0;
		m->classify       = HLCLASS_NONE;
		m->health         = 20.0;
		m->view_ofs       = 20.0;
		m->fov            = 0.5;
		m->look_dist      = 2048.0;
		m->walk_speed     = 32.0;
		m->run_speed      = 120.0;
		m->yaw_speed      = 120.0;
		m->melee_range    = 0.0;
		m->melee_dmg      = 0.0;
		m->range_min      = 0.0;
		m->range_max      = 0.0;
		m->range_dmg      = 0.0;
		m->range_bullets  = 1;
		m->blast_radius   = 0.0;
		m->range2_min     = 0.0;
		m->range2_max     = 0.0;
		m->range2_dmg     = 0.0;
		m->attack_rate    = 1.0;
		m->flees          = FALSE;
		m->melee2_range   = 0.0;
		m->melee2_dmg     = 0.0;
		m->squads         = FALSE;
		m->flies          = FALSE;
		m->blood          = HLBLOOD_RED;
		m->clip_size      = 0;
		m->slot_attack    = HLSLOT_NONE;
		m->attack_noise   = 0.0;

		m->hear_sens      = 1.0;
		m->sound_mask     = HLSOUND_ALL;

		m->snd_idle[0]    = 0;
		m->snd_alert[0]   = 0;
		m->snd_attack[0]  = 0;
		m->snd_pain[0]    = 0;
		m->snd_die[0]     = 0;

		HLVecSet(m->mins, -16.0, -16.0, 0.0);
		HLVecSet(m->maxs, 16.0, 16.0, 72.0);

		for (j = 0; j < HLACT_COUNT; j++)
			m->seq[j * 24] = 0;
	}

	m = &hl_ai_mon_info[HLMON_HEADCRAB];
	HLStrCopy(m->classname, "monster_headcrab", 32);
	m->classify    = HLCLASS_ALIEN_PREY;
	m->health      = 10.0;
	m->fov         = -1.0;
	m->walk_speed  = 40.0;
	m->run_speed   = 150.0;
	m->yaw_speed   = 200.0;
	m->melee_range = 40.0;
	m->melee_dmg   = 5.0;
	m->attack_rate = 0.6;
	HLAIMonHull(HLMON_HEADCRAB, 12.0, 24.0, 12.0);
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_RUN,    "run");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_MELEE,  "jump");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_DIE,    "dieback");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_HEADCRAB, HLACT_COMBAT_IDLE, "angry");
	HLStrCopy(m->snd_idle,   "headcrab/hc_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "headcrab/hc_alert1.wav", 48);
	HLStrCopy(m->snd_attack, "headcrab/hc_attack1.wav", 48);
	HLStrCopy(m->snd_pain,   "headcrab/hc_pain1.wav", 48);
	HLStrCopy(m->snd_die,    "headcrab/hc_die1.wav", 48);

	m = &hl_ai_mon_info[HLMON_ZOMBIE];
	HLStrCopy(m->classname, "monster_zombie", 32);
	m->classify    = HLCLASS_ALIEN_MONSTER;
	m->health      = 50.0;
	m->fov         = 0.2;
	m->walk_speed  = 30.0;
	m->run_speed   = 60.0;
	m->yaw_speed   = 90.0;
	m->melee_range = 64.0;
	m->melee_dmg   = 10.0;
	m->attack_rate = 1.0;
	HLAIMonHull(HLMON_ZOMBIE, 16.0, 72.0, 52.0);
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_IDLE,   "idle1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_WALK,   "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_RUN,    "walk");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE,  "attack1");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_DIE,    "diesimple");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_FLINCH, "flinch");
	HLAIMonSeq(HLMON_ZOMBIE, HLACT_MELEE2, "attack2");

	m->melee2_range = 70.0;
	m->melee2_dmg   = 25.0;
	HLStrCopy(m->snd_idle,   "zombie/zo_idle1.wav", 48);
	HLStrCopy(m->snd_alert,  "zombie/zo_alert10.wav", 48);
	HLStrCopy(m->snd_attack, "zombie/zo_attack1.wav", 48);
	HLStrCopy(m->snd_pain,   "zombie/zo_pain1.wav", 48);
	HLStrCopy(m->snd_die,    "zombie/zo_pain2.wav", 48);

	m = &hl_ai_mon_info[HLMON_SCIENTIST];
