U0 HLAIGraphReset()
{
	hl_ai_node_count   = 0;
	hl_ai_link_count   = 0;
	hl_ai_graph_ready  = FALSE;
	hl_ai_graph_map[0] = 0;
	hl_ai_graph_retry  = 0.0;
	hl_ai_graph_tries  = 0;
}

HLAIGraphReset;

U0 HLAIGraphBaseName(U8 *in, U8 *out)
{//"maps/c1a0.bsp", "c1a0.bsp" and "c1a0" all reduce to "c1a0".
	I64 start = 0;
	I64 end;
	I64 i;
	I64 n;

	n = StrLen(in);

	for (i = 0; i < n; i++)
	{
		if (in[i] == '/' || in[i] == '\\')
			start = i + 1;
	}

	end = n;

	if (end - start > 4)
	{
		if (in[end - 4] == '.')
			end -= 4;
	}

	n = end - start;

	if (n > 90)
		n = 90;

	for (i = 0; i < n; i++)
		out[i] = in[start + i];

	out[n] = 0;
}

Bool HLAIGraphLoad(U8 *base)
{//CGraph::FLoadGraph, nodes.cpp:2317, reading only the node and link blocks
	U8	*d;
	U8	*p;
	U8	 path[160];
	U8	 line[160];
	I64	 size = 0;
	I64	 n;
	I64	 l;
	I64	 i;
	I64	 j;
	I64	 lbase;
	I64	 off;
	I64	 dest;

	hl_ai_node_count = 0;
	hl_ai_link_count = 0;

	StrPrint(path, "%s/valve/maps/graphs/%s.nod", hl_game_root, base);

	if (!FileFind(path))
		return FALSE;

	d = FileRead(path, &size);

	if (!d)
		return FALSE;

	if (size < HLNODE_HDR + HLNODE_STRIDE)
		goto qgl_bad;

	if (HLRdI32(d) != HLNODE_VERSION)
	{
		StrPrint(line, "nodegraph: %s version %d, want %d\n", path,
			HLRdI32(d), HLNODE_VERSION);
		HLLog(line);
		goto qgl_bad;
	}

	n = HLRdI32(d + 4 + 24);
	l = HLRdI32(d + 4 + 28);

	if (n <= 0 || l < 0)
		goto qgl_bad;

	lbase = HLNODE_HDR + HLNODE_STRIDE * n;

	if (size < lbase + HLLINK_STRIDE * l)
		goto qgl_bad;

	if (n > HLNODE_MAX)
	{
		StrPrint(line, "nodegraph: %s has %d nodes, capped at %d\n", path, n,
			HLNODE_MAX);
		HLLog(line);
		n = HLNODE_MAX;
	}

	if (l > HLLINK_MAX)
	{
		StrPrint(line, "nodegraph: %s has %d links, capped at %d\n", path, l,
			HLLINK_MAX);
		HLLog(line);
		l = HLLINK_MAX;
	}

	for (i = 0; i < n; i++)
	{
		p = d + HLNODE_HDR + HLNODE_STRIDE * i;

		hl_ai_node_org[i * 3]      = HLRdF32(p);
		hl_ai_node_org[i * 3 + 1]  = HLRdF32(p + 4);
		hl_ai_node_org[i * 3 + 2]  = HLRdF32(p + 8);

		hl_ai_node_peek[i * 3]     = HLRdF32(p + 12);
		hl_ai_node_peek[i * 3 + 1] = HLRdF32(p + 16);
		hl_ai_node_peek[i * 3 + 2] = HLRdF32(p + 20);

		hl_ai_node_info[i]  = HLRdI32(p + 28);
		hl_ai_node_nlink[i] = HLRdI32(p + 32);
		hl_ai_node_link0[i] = HLRdI32(p + 36);

		//sHintType / sHintActivity / flHintYaw at +80/+82/+84
		hl_ai_node_hint[i]     = HLRdI16(p + 80);
		hl_ai_node_hint_act[i] = HLRdI16(p + 82);
		hl_ai_node_hint_yaw[i] = HLRdF32(p + 84);
	}

	for (i = 0; i < l; i++)
	{
		p = d + lbase + HLLINK_STRIDE * i;

		dest = HLRdI32(p + 4);

		if (dest < 0 || dest >= n)
			dest = HLRdI32(p);

		if (dest < 0 || dest >= n)
			dest = 0;

		hl_ai_link_dest[i]   = dest;
		hl_ai_link_flags[i]  = HLRdI32(p + 16);
		hl_ai_link_weight[i] = HLRdF32(p + 20);

		if (HLRdU32(p + 8))
			hl_ai_link_ent[i] = -2;
		else
			hl_ai_link_ent[i] = -1;

		for (j = 0; j < 4; j++)
			hl_ai_link_model[i * 5 + j] = p[12 + j];

		hl_ai_link_model[i * 5 + 4] = 0;
	}

	for (i = 0; i < n; i++)
	{
		off = hl_ai_node_link0[i];

		if (off < 0 || off >= l)
		{
			hl_ai_node_link0[i] = 0;
			hl_ai_node_nlink[i] = 0;
		}
		else if (off + hl_ai_node_nlink[i] > l)
			hl_ai_node_nlink[i] = l - off;
	}

	hl_ai_node_count = n;
	hl_ai_link_count = l;

	Free(d);

	return TRUE;

qgl_bad:
	Free(d);

	return FALSE;
}

U0 HLAIGraphBind()
{//CGraph::FSetGraphPointers, nodes.cpp:2563.
	CHLEntity	*e;
	U8			 line[128];
	I64			 i;
	I64			 j;
	I64			 miss = 0;

	for (i = 0; i < hl_ai_link_count; i++)
	{
		if (hl_ai_link_ent[i] != -2)
			goto qgb_next;

		hl_ai_link_ent[i] = -1;

		for (j = 0; j < hl_num_entities; j++)
		{
			e = HLEntGet(j);

			if (!e)
				goto qgb_next_ent;

			if (!StrCompare(e->model_name, hl_ai_link_model + i * 5))
			{
				hl_ai_link_ent[i] = j;
				goto qgb_next;
			}

qgb_next_ent:
		}

		//"Could not find model", nodes.cpp:2587
		miss++;

qgb_next:
	}

	if (miss && hl_ai_graph_log)
	{
		StrPrint(line, "nodegraph: %d link blockers unresolved\n", miss);
		HLLog(line);
	}
}

Bool HLAIGraphEnsure()
{
	U8	base[96];
	U8	line[160];

	if (!hl_map_name[0])
		return FALSE;

	if (!StrCompare(hl_ai_graph_map, hl_map_name))
		return hl_ai_graph_ready;

	hl_ai_node_count  = 0;
	hl_ai_link_count  = 0;
	hl_ai_graph_ready = FALSE;
	hl_ai_graph_tries = 0;
	hl_ai_graph_retry = 0.0;

	HLAIGraphBaseName(hl_map_name, base);

	if (!HLAIGraphLoad(base))
	{
		StrPrint(line,
			"nodegraph: %s has none, straight-line movement\n", base);
		HLLog(line);
		HLStrCopy(hl_ai_graph_map, hl_map_name, 96);
		return FALSE;
	}

	HLStrCopy(hl_ai_graph_map, hl_map_name, 96);
	HLAIGraphBind;
	hl_ai_graph_ready = TRUE;

	StrPrint(line, "nodegraph: %s, %d nodes %d links\n", base,
		hl_ai_node_count, hl_ai_link_count);
	HLLog(line);

	return TRUE;
}

Bool HLAILinkOpen(I64 link, I64 caps)
{//CGraph::HandleLinkEnt with queryType NODEGRAPH_STATIC, nodes.cpp:1102.
	CHLEntity	*e;
	I64			 ent;

	if (link < 0 || link >= hl_ai_link_count)
		return FALSE;

	ent = hl_ai_link_ent[link];

	if (ent < 0)
		return TRUE;

	e = HLEntGet(ent);

	if (!e)
		return TRUE;

	if (!StrCompare(e->classname, "func_door") ||
		!StrCompare(e->classname, "func_door_rotating"))
	{
		if (caps & HLCAP_OPEN_DOORS)
			return TRUE;

		if (e->toggle_state == HLTS_AT_TOP &&
			e->spawnflags & HLAI_SF_DOOR_NO_RETURN)
			return TRUE;

		return FALSE;
	}

	if (!StrCompare(e->classname, "func_breakable"))
		return TRUE;

	//"Unhandled Ent in Path", nodes.cpp:1166
	return FALSE;
}

I64 HLAIFindNearestNode(F64 *org, I64 want_types)
{//CGraph::FindNearestNode, nodes.cpp:869, plus CheckNode at :821. -1 is none.
	CHLTrace	tr;
	F64			d[3];
	F64			peek[3];
	F64			zero[3];
	F64			dist;
	F64			best = 999999.0;
	I64			near = -1;
	I64			i;

	if (!hl_ai_graph_ready || !hl_map)
		return -1;

	HLVecSet(zero, 0.0, 0.0, 0.0);

	for (i = 0; i < hl_ai_node_count; i++)
	{
		if (!(hl_ai_node_info[i] & want_types))
			goto qfnn_next;

		peek[0] = hl_ai_node_peek[i * 3];
		peek[1] = hl_ai_node_peek[i * 3 + 1];
		peek[2] = hl_ai_node_peek[i * 3 + 2];

		HLVecSub(org, peek, d);

		dist = HLVecLength(d);

		if (dist >= best)
			goto qfnn_next;

		HLTraceEntity(hl_map, org, peek, zero, zero, 0, TRUE, &tr);

		if (tr.fraction < 1.0)
			goto qfnn_next;

		near = i;
		best = dist;

qfnn_next:
	}

	return near;
}

I64 HLAIFindShortestPath(I64 *path, I64 start, I64 dest, I64 hull, I64 caps)
{//CGraph::FindShortestPath, nodes.cpp:1183.
	F64	weight;
	F64	reach;
	F64	best;
	I64	hull_mask;
	I64	at;
	I64	link;
	I64	to;
	I64	i;
	I64	count;
	I64	total;

	if (!hl_ai_graph_ready)
		return 0;

	if (start < 0 || start >= hl_ai_node_count)
		return 0;

	if (dest < 0 || dest >= hl_ai_node_count)
		return 0;

	if (start == dest)
	{
		path[0] = start;
		path[1] = dest;
		return 2;
	}

	hull_mask = HLLINK_HUMAN;

	if (hull == HLHULL_SMALL)
		hull_mask = HLLINK_SMALL;
	else if (hull == HLHULL_LARGE)
		hull_mask = HLLINK_LARGE;
	else if (hull == HLHULL_FLY)
		hull_mask = HLLINK_FLY;

	for (i = 0; i < hl_ai_node_count; i++)
	{
		hl_ai_node_dist[i] = -1.0;
		hl_ai_node_prev[i] = start;
		hl_ai_node_done[i] = FALSE;
	}

	hl_ai_node_dist[start] = 0.0;

	while (TRUE)
	{
		at   = -1;
		best = 0.0;

		for (i = 0; i < hl_ai_node_count; i++)
		{
			if (hl_ai_node_done[i])
				goto qfsp_next_open;

			if (hl_ai_node_dist[i] < -0.5)
				goto qfsp_next_open;

			if (at < 0 || hl_ai_node_dist[i] < best)
			{
				at   = i;
				best = hl_ai_node_dist[i];
			}

qfsp_next_open:
		}

		if (at < 0)
			goto qfsp_walked;

		if (at == dest)
			goto qfsp_walked;

		hl_ai_node_done[at] = TRUE;

		for (i = 0; i < hl_ai_node_nlink[at]; i++)
		{
			link = hl_ai_node_link0[at] + i;

			if (link < 0 || link >= hl_ai_link_count)
				goto qfsp_next_link;

			//"monster is too large to walk this connection", :1296
			if ((hl_ai_link_flags[link] & hull_mask) != hull_mask)
				goto qfsp_next_link;

			if (!HLAILinkOpen(link, caps))
				goto qfsp_next_link;

			to     = hl_ai_link_dest[link];
			weight = hl_ai_link_weight[link];
			reach  = best + weight;

			if (hl_ai_node_dist[to] < -0.5 ||
				reach < hl_ai_node_dist[to] - 0.001)
			{
				hl_ai_node_dist[to] = reach;
				hl_ai_node_prev[to] = at;
			}

qfsp_next_link:
		}
	}

qfsp_walked:
	if (hl_ai_node_dist[dest] < -0.5)
		return 0;

	total = 1;
	at    = dest;

	while (at != start)
	{
		at = hl_ai_node_prev[at];
		total++;

		if (total > hl_ai_node_count)
			return 0;
	}

	count = total;

	if (count > HLNODE_PATH_MAX)
		count = HLNODE_PATH_MAX;

	at = dest;

	for (i = 0; i < total - count; i++)
		at = hl_ai_node_prev[at];

	for (i = count - 1; i >= 0; i--)
	{
		path[i] = at;
		at      = hl_ai_node_prev[at];
	}

	return count;
}

