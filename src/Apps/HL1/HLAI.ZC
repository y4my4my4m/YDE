I64 HLAIMonCaps(I64 kind)
{
	if (kind == HLMON_BARNEY || kind == HLMON_HGRUNT ||
		kind == HLMON_ISLAVE || kind == HLMON_ZOMBIE ||
		kind == HLMON_SCIENTIST)
		return HLCAP_DOORS_GROUP;

	return 0;
}

I64 HLAIMonHullIndex(I64 kind)
{//CGraph::HullIndex, nodes.cpp:442.
	CHLMonInfo *mi;

	if (kind < 0 || kind >= HLMON_COUNT)
		return HLHULL_HUMAN;

	mi = &hl_ai_mon_info[kind];

	if (mi->flies)
		return HLHULL_FLY;

	if (mi->mins[0] > -12.5 && mi->mins[0] < -11.5)
		return HLHULL_SMALL;

	if (mi->mins[0] > -32.5 && mi->mins[0] < -31.5)
		return HLHULL_LARGE;

	return HLHULL_HUMAN;
}

I64 HLAIMonNodeType(I64 kind)
{//CGraph::NodeType, nodes.cpp:459.
	if (kind >= 0 && kind < HLMON_COUNT)
	{
		if (hl_ai_mon_info[kind].flies)
			return HLNODE_AIR;
	}

	return HLNODE_LAND;
}

U0 HLAIRouteClear(I64 s)
{//RouteNew's node half, monsters.cpp:617.
	hl_ai_mon[s].route_len = 0;
	hl_ai_mon[s].route_at  = 0;

	HLVecSet(hl_ai_mon[s].route_for, 0.0, 0.0, 0.0);
}

I64 HLAINodeRoute(I64 s, F64 *dest)
{//CBaseMonster::FGetNodeRoute, monsters.cpp:2790.
	CHLEntity	*e = HLEntGet(hl_ai_mon[s].ent);
	U8			 line[160];
	I64			 path[HLNODE_PATH_MAX];
	I64			 types;
	I64			 src_node;
	I64			 dst_node;
	I64			 found;
	I64			 i;

	if (!e)
		return HLAI_ROUTE_NONE;

	if (!HLAIGraphEnsure())
	{
		if (hl_ai_graph_log)
			HLLog("route: no graph\n");
		return HLAI_ROUTE_NONE;
	}

	if (hl_ai_mon[s].route_time > 0.0 &&
		hl_ent_time >= hl_ai_mon[s].route_time &&
		hl_ent_time - hl_ai_mon[s].route_time < HLAI_NODE_REROUTE)
		return HLAI_ROUTE_WAIT;

	hl_ai_mon[s].route_time = hl_ent_time;

	HLAIRouteClear(s);

	types    = HLAIMonNodeType(hl_ai_mon[s].kind);
	src_node = HLAIFindNearestNode(e->origin, types);

	if (src_node < 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line,
				"route: no node sees %s at %.0f %.0f %.0f (%d nodes)\n",
				e->classname, e->origin[0], e->origin[1], e->origin[2],
				hl_ai_node_count);
			HLLog(line);
		}
		return HLAI_ROUTE_NONE;
	}

	dst_node = HLAIFindNearestNode(dest, types);

	if (dst_node < 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line, "route: no node sees goal %.0f %.0f %.0f\n",
				dest[0], dest[1], dest[2]);
			HLLog(line);
		}
		return HLAI_ROUTE_NONE;
	}

	found = HLAIFindShortestPath(path, src_node, dst_node,
		HLAIMonHullIndex(hl_ai_mon[s].kind),
		HLAIMonCaps(hl_ai_mon[s].kind));

	if (found <= 0)
	{
		if (hl_ai_graph_log)
		{
			StrPrint(line, "nodegraph: no path %d to %d for slot %d\n",
				src_node, dst_node, s);
			HLLog(line);
		}

		return HLAI_ROUTE_NONE;
	}

	for (i = 0; i < found; i++)
		hl_ai_mon[s].route_node[i] = path[i];

	hl_ai_mon[s].route_len = found;

	//RouteNew, monsters.cpp:617
	hl_ai_mon[s].have_detour = FALSE;

	if (found > 1)
		hl_ai_mon[s].route_at = 1;
	else
		hl_ai_mon[s].route_at = 0;

	HLVecCopy(dest, hl_ai_mon[s].route_for);

	if (hl_ai_graph_log)
	{
		StrPrint(line, "nodegraph: slot %d routed %d nodes, %d to %d\n", s,
			found, src_node, dst_node);
		HLLog(line);
	}

	return HLAI_ROUTE_OK;
}

Bool HLAIRouteStale(I64 s)
{
	F64 d[3];

	if (hl_ai_mon[s].route_len <= 0)
		return FALSE;

	HLVecSub(hl_ai_mon[s].goal, hl_ai_mon[s].route_for, d);

	return ToBool(HLVecLength(d) > HLAI_NODE_SLOP);
}

U0 HLAIWayPoint(I64 s, F64 *way, F64 *_tol)
{
	I64 node;

	if (hl_ai_mon[s].have_detour)
	{
		HLVecCopy(hl_ai_mon[s].detour, way);
		*_tol = HLAI_NODE_TOL;
		return;
	}

	if (hl_ai_mon[s].route_len > 0 &&
		hl_ai_mon[s].route_at < hl_ai_mon[s].route_len)
	{
		node = hl_ai_mon[s].route_node[hl_ai_mon[s].route_at];

		if (node >= 0 && node < hl_ai_node_count)
		{
			way[0] = hl_ai_node_org[node * 3];
			way[1] = hl_ai_node_org[node * 3 + 1];
			way[2] = hl_ai_node_org[node * 3 + 2];

			*_tol = HLAI_NODE_TOL;
			return;
		}
	}

	HLVecCopy(hl_ai_mon[s].goal, way);
	*_tol = hl_ai_mon[s].goal_tol;
}

Bool HLAIAdvanceWay(I64 s)
{//AdvanceRoute, monsters.cpp:768.
	if (hl_ai_mon[s].have_detour)
	{
		hl_ai_mon[s].have_detour = FALSE;
		return TRUE;
	}

	if (hl_ai_mon[s].route_len > 0 &&
		hl_ai_mon[s].route_at < hl_ai_mon[s].route_len)
	{
		hl_ai_mon[s].route_at++;
		return TRUE;
	}

	return FALSE;
}

U0 HLAIMonInit()
{
	I64 i;

	for (i = 0; i < HLAI_MON_MAX; i++)
	{
		hl_ai_mon[i].ent           = -1;
		hl_ai_mon[i].kind          = -1;
		hl_ai_mon[i].state         = HLMSTATE_NONE;
