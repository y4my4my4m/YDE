U0 HLEntPlayerReset()
{
	hl_ent_player_health   = 100.0;
	hl_ent_player_armor    = 0.0;
	hl_ent_player_dead     = FALSE;
	hl_ent_player_damage   = 0.0;
	hl_ent_last_dmg        = 0.0;
	hl_ent_last_dmg_type   = 0;
	hl_ent_dmg_usermsg     = FALSE;

	hl_ent_deadflag        = HLDEAD_NO;
	hl_ent_death_time      = 0.0;
	hl_ent_dead_time       = 0.0;
	hl_ent_player_gibbed   = FALSE;
	hl_ent_death_view_ofs  = HLPHYS_VIEW_Z;
	hl_ent_death_roll      = 0.0;
	hl_ent_input_locked    = FALSE;
	hl_ent_death_button    = FALSE;
	hl_ent_respawn_pending = FALSE;

	HLEntSuitQueueReset;

	hl_hud_geiger_range   = 1000.0;
	hl_ent_geiger_delay   = 0.0;

	HLVecSet(hl_ent_respawn_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_respawn_ang, 0.0, 0.0, 0.0);
	hl_ent_teleport_pending = FALSE;
	hl_ent_push_pending    = FALSE;
	hl_ent_spin_pending    = FALSE;
	hl_ent_spin_yaw        = 0.0;

	HLVecSet(hl_ent_teleport_to, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_push_vel, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_spin_pivot, 0.0, 0.0, 0.0);

	HLVecSet(hl_ent_player_org, 0.0, 0.0, 0.0);

	hl_ent_shake_amp     = 0.0;
	hl_ent_shake_freq    = 0.0;
	hl_ent_shake_until   = 0.0;
	hl_ent_shake_pending = FALSE;

	HLVecSet(hl_ent_fade_color, 0.0, 0.0, 0.0);
	hl_ent_fade_alpha    = 0.0;
	hl_ent_fade_duration = 0.0;
	hl_ent_fade_hold     = 0.0;
	hl_ent_fade_in       = FALSE;
	hl_ent_fade_pending  = FALSE;

	hl_ent_gravity  = 1.0;

	hl_ent_roomtype = 0;
	HLSndRoomtypeSet(0);

	hl_ent_changelevel[0]      = 0;
	hl_ent_changelevel_pending = FALSE;
	hl_ent_autosave_pending    = FALSE;

	HLVecSet(hl_ent_player_ang, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_cam_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_cam_ang, 0.0, 0.0, 0.0);
	hl_ent_cam_active = FALSE;
	hl_ent_cam_freeze = FALSE;
	hl_ent_cam_ent    = -1;

	hl_ent_weaponstrip_pending = FALSE;
	hl_ent_pack_weapons_pending = FALSE;
	hl_ent_tank_mount = -1;
	hl_ent_train_mount = -1;
	hl_ent_train_fwd_was = FALSE;
	hl_ent_train_back_was = FALSE;
	hl_ent_tank_rocket_pending = FALSE;
	hl_ent_loadsaved_pending   = FALSE;
	hl_ent_endsection[0]       = 0;
	hl_ent_endsection_pending  = FALSE;

}

HLEntPlayerReset;

U0 HLEntPlayerNewGame()
{
	hl_ent_player_suit     = FALSE;
	hl_ent_godmode         = FALSE;
	hl_ent_notarget        = FALSE;
	hl_ent_player_longjump = FALSE;

	hl_ent_changelevel_landmark[0] = 0;

	hl_ent_carry_name[0] = 0;
	hl_ent_carry_path[0] = 0;
	hl_ent_carry_speed   = 0.0;
	hl_ent_carry_valid   = FALSE;
	HLVecSet(hl_ent_carry_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_carry_ang, 0.0, 0.0, 0.0);
}

HLEntPlayerNewGame;


#define HLENT_GLOBAL_MAX		64

#define HLGLOBAL_OFF			0
#define HLGLOBAL_ON			1
#define HLGLOBAL_DEAD		2

class CHLEntGlobalState
{
	U8	name[64];
	I64	state;
};

CHLEntGlobalState	hl_ent_globals[HLENT_GLOBAL_MAX];
I64					hl_ent_global_count = 0;

U0 HLEntGlobalResetAll()
{
	I64 i;

	for (i = 0; i < HLENT_GLOBAL_MAX; i++)
	{
		hl_ent_globals[i].name[0] = 0;
		hl_ent_globals[i].state   = HLGLOBAL_OFF;
	}

	hl_ent_global_count = 0;
}

HLEntGlobalResetAll;

I64 HLEntGlobalGet(U8 *name)
{
	I64 i;

	if (!name || !name[0])
		return HLGLOBAL_OFF;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
			return hl_ent_globals[i].state;
	}

	return HLGLOBAL_OFF;
}

U0 HLEntGlobalSet(U8 *name, I64 state)
{
	I64 i;

	if (!name || !name[0])
		return;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
		{
			hl_ent_globals[i].state = state;
			return;
		}
	}

	if (hl_ent_global_count >= HLENT_GLOBAL_MAX)
		return;

	i = hl_ent_global_count;
	HLStrCopy(hl_ent_globals[i].name, name, 64);
	hl_ent_globals[i].state = state;
	hl_ent_global_count     = i + 1;
}


#define HLENT_GLOBALNAME_MAX	192

class CHLEntGlobalName
{
	U8	name[64];
	U8	level[64];
	I64	state;
};

CHLEntGlobalName	hl_ent_globalnames[HLENT_GLOBALNAME_MAX];
I64					hl_ent_globalname_count = 0;

U0 HLEntGlobalNameResetAll()
{
	I64 i;

	for (i = 0; i < HLENT_GLOBALNAME_MAX; i++)
	{
		hl_ent_globalnames[i].name[0]  = 0;
		hl_ent_globalnames[i].level[0] = 0;
		hl_ent_globalnames[i].state    = HLGLOBAL_OFF;
	}

	hl_ent_globalname_count = 0;
}

HLEntGlobalNameResetAll;

U0 HLEntNewGame()
{
	HLEntPlayerNewGame;
	HLEntGlobalResetAll;
	HLEntGlobalNameResetAll;
}

I64 HLEntGlobalNameFind(U8 *name)
{//CGlobalState::Find, world.cpp:275. Slot index, -1 for not in the table
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = 0; i < hl_ent_globalname_count; i++)
	{
		if (!StrICompare(hl_ent_globalnames[i].name, name))
			return i;
	}

	return -1;
}

U0 HLEntGlobalNameAdd(U8 *name, U8 *level, I64 state)
{//CGlobalState::EntityAdd, world.cpp:315
	I64 i;

	if (!name || !name[0])
		return;

	if (HLEntGlobalNameFind(name) >= 0)
		return;

	if (hl_ent_globalname_count >= HLENT_GLOBALNAME_MAX)
		return;

	i = hl_ent_globalname_count;

	HLStrCopy(hl_ent_globalnames[i].name, name, 64);
	HLStrCopy(hl_ent_globalnames[i].level, level, 64);
	hl_ent_globalnames[i].state = state;

	hl_ent_globalname_count = i + 1;
}

U0 HLEntGlobalNameSetState(U8 *name, I64 state)
{//CGlobalState::EntitySetState, world.cpp:330.
	I64 i = HLEntGlobalNameFind(name);

	if (i < 0)
		return;

	hl_ent_globalnames[i].state = state;
}

U0 HLEntGlobalNameUpdate(U8 *name, U8 *level)
{//CGlobalState::EntityUpdate, world.cpp:414
	I64 i = HLEntGlobalNameFind(name);

	if (i < 0)
		return;

	HLStrCopy(hl_ent_globalnames[i].level, level, 64);
}

U0 HLEntGlobalNameDied(CHLEntity *e)
{//CBaseEntity::UpdateOnRemove, subs.cpp:109
	if (!e || !e->global_name[0])
		return;

	HLEntGlobalNameSetState(e->global_name, HLGLOBAL_DEAD);
}

Bool HLEntGlobalNameSpawnAllows(CHLEntity *e, U8 *level)
{//DispatchSpawn's global block, cbase.cpp:156.
	I64 i;

	if (!e || !e->global_name[0])
		return TRUE;

	i = HLEntGlobalNameFind(e->global_name);

	if (i < 0)
	{
		//"Spawned entities default to 'On'", cbase.cpp:170
		HLEntGlobalNameAdd(e->global_name, level, HLGLOBAL_ON);
		return TRUE;
	}

	if (hl_ent_globalnames[i].state == HLGLOBAL_DEAD)
		return FALSE;

	HLStrCopy(hl_ent_globalnames[i].level, level, 64);

	return TRUE;
}

I64 HLEntCountInUse()
{//impulse 104's report.
	I64 n = 0;
	I64 i;

	if (!hl_entities)
		return 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use)
			n++;
	}

	return n;
}

U0 HLEntSuitUpdate(U8 *name, F64 norepeat = 0.0)
{//CBasePlayer::SetSuitUpdate, dlls/player.cpp:2463.
	I64	i;
	I64	empty = -1;

	if (!hl_ent_player_suit || !name || !name[0])
		return;

	if (name[0] == '!')
	{
		if (HLSndSentenceLookup(name) < 0)
			return;
	}
	else if (HLSndSentenceGroupIndex(name) < 0)
		return;

	for (i = 0; i < HLENT_SUITNR_MAX; i++)
	{
		if (!hl_ent_suitnr[i * HLENT_SUITNAME])
		{
			empty = i;
			goto qesu_next_nr;
		}

		if (StrCompare(&hl_ent_suitnr[i * HLENT_SUITNAME], name))
			goto qesu_next_nr;

		if (hl_ent_suitnr_time[i] >= hl_ent_time)
			return;

		hl_ent_suitnr[i * HLENT_SUITNAME] = 0;
		hl_ent_suitnr_time[i]             = 0.0;
		empty                             = i;
		break;

qesu_next_nr:
	}

	if (norepeat > 0.0)
	{
		if (empty < 0)
			empty = HLPartRandI(HLENT_SUITNR_MAX);

		HLStrCopy(&hl_ent_suitnr[empty * HLENT_SUITNAME], name, HLENT_SUITNAME);
		hl_ent_suitnr_time[empty] = hl_ent_time + norepeat;
	}

	HLStrCopy(&hl_ent_suitq[hl_ent_suitq_next * HLENT_SUITNAME], name,
		HLENT_SUITNAME);

	hl_ent_suitq_next++;
	if (hl_ent_suitq_next == HLENT_SUITQ_MAX)
		hl_ent_suitq_next = 0;

	if (hl_ent_suit_update <= hl_ent_time)
	{
		if (hl_ent_suit_update == 0.0)
			hl_ent_suit_update = hl_ent_time + HLENT_SUIT_FIRST;
		else
			hl_ent_suit_update = hl_ent_time + HLENT_SUIT_UPDATE;
	}
}

U0 HLEntSuitGroup(U8 *group)
{
	HLEntSuitUpdate(group, 0.0);
}

U0 HLEntUpdateGeigerCounter()
{
	F64	 nearest = 1000.0;
	F64	 pc[3];
	F64	 tc[3];
	F64	 d[3];
	F64	 range;
	I64	 i;
	I64	 j;

	if (hl_ent_time < hl_ent_geiger_delay)
		return;

	hl_ent_geiger_delay = hl_ent_time + HLENT_GEIGER_DELAY;

	if (!hl_entities)
	{
		hl_hud_geiger_range = 1000.0;
		return;
	}

	for (j = 0; j < 3; j++)
		pc[j] = hl_ent_player_org[j] +
			(hl_player_mins[j] + hl_player_maxs[j]) * 0.5;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qeug_next;

		if (!(hl_entities[i].damage_type & HLDMG_RADIATION))
			goto qeug_next;

		if (StrCompare(hl_entities[i].classname, "trigger_hurt"))
			goto qeug_next;

		for (j = 0; j < 3; j++)
		{
			tc[j] = (hl_entities[i].absmin[j] + hl_entities[i].absmax[j]) * 0.5;
			d[j]  = tc[j] - pc[j];
		}

		range = HLVecLength(d);

		if (range < nearest)
			nearest = range;

qeug_next:
	}

	hl_hud_geiger_range = nearest;
}

U0 HLEntCheckSuitUpdate()
{//CBasePlayer::CheckSuitUpdate, dlls/player.cpp:2403, run from PostThink.
	U8	*slot;
	I64	 search;
	I64	 i;

	if (!hl_ent_player_suit)
		return;

	//player.cpp:2409-2414
	HLEntUpdateGeigerCounter;

	if (hl_ent_suit_update <= 0.0 || hl_ent_time < hl_ent_suit_update)
		return;

	search = hl_ent_suitq_next;
	slot   = NULL;

	for (i = 0; i < HLENT_SUITQ_MAX; i++)
	{
		if (hl_ent_suitq[search * HLENT_SUITNAME])
		{
			slot = &hl_ent_suitq[search * HLENT_SUITNAME];
			break;
		}

		search++;
		if (search == HLENT_SUITQ_MAX)
			search = 0;
	}

	if (!slot)
	{
		hl_ent_suit_update = 0.0;
		return;
	}

	if (slot[0] == '!')
		HLSndSentenceQueue(slot, hl_ent_player_org, HLENT_SUIT_VOL, HLATTN_NORM,
			HLPITCH_NORM, hl_ent_player + 1, HLCHAN_STATIC);
	else
		HLSndSentencePlayRndSz(slot, hl_ent_player_org, HLENT_SUIT_VOL,
			HLATTN_NORM, HLPITCH_NORM, hl_ent_player + 1, HLCHAN_STATIC);

	slot[0]            = 0;
	hl_ent_suit_update = hl_ent_time + HLENT_SUIT_UPDATE;
}

U0 HLEntPlayerDeathSound(I64 damage_type)
{
	I64 n;

	if (damage_type & HLDMG_DROWN)
	{
		HLSndPlayAt("player/h2odeath.wav", hl_ent_player_org, 1.0, 0.0,
			hl_ent_player + 1, HLENT_CHAN_VOICE);
		goto qepds_suit;
	}

	n = HLPartRandI(5) + 1;

	if (n == 1)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 2)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 3)
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);

qepds_suit:
	HLEntSuitGroup("HEV_DEAD");
}

U0 HLEntPlayerPainSound()
{
	I64 n = HLPartRandI(3);

	if (n == 0)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 1)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
}

U0 HLEntGibPlayer()
{
	F64 absmin[3];
	F64 size[3];
	F64 dir[3];
	F64 eye[3];
	I64 i;

	HLSndPlayAt("common/bodysplat.wav", hl_ent_player_org, 1.0, HLENT_SND_ATTEN,
		hl_ent_player + 1, HLENT_CHAN_BODY);

	for (i = 0; i < 3; i++)
	{
		absmin[i] = hl_ent_player_org[i] + hl_player_mins[i];
		size[i]   = hl_player_maxs[i] - hl_player_mins[i];
	}

	HLVecSet(dir, 0.0, 0.0, -1.0);

	HLVecCopy(hl_ent_player_org, eye);
	eye[2] += HLPHYS_VIEW_Z;

	HLGibSpawnHeadGib(eye, NULL, hl_ent_player_health, HLBLOOD_RED, tS);
	HLGibSpawnRandomGibs(absmin, size, dir, hl_ent_player_health, 4, TRUE,
		HLBLOOD_RED, tS);
}

U0 HLEntPlayerKilled(I64 damage_type)
{
	CHLEntity *tank;

	if (hl_ent_player_dead)
		return;

	if (hl_ent_tank_mount >= 0 && hl_entities &&
		hl_ent_tank_mount < hl_num_entities &&
		hl_entities[hl_ent_tank_mount].in_use)
	{
		tank = &hl_entities[hl_ent_tank_mount];
		tank->tank_mounted = FALSE;
		tank->think_fn     = HLM_NONE;
		tank->next_think   = 0.0;
	}
	hl_ent_tank_mount = -1;
	hl_ent_train_mount = -1;

	hl_ent_player_dead  = TRUE;
	hl_ent_deadflag     = HLDEAD_DYING;
	hl_ent_death_time   = hl_ent_time;
	hl_ent_dead_time    = 0.0;
	hl_ent_input_locked = TRUE;

	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;

	hl_ent_player_gibbed = FALSE;

	if (damage_type & HLDMG_ALWAYSGIB)
		hl_ent_player_gibbed = TRUE;
	else if (hl_ent_player_health < HLENT_PLAYER_GIB_HEALTH &&
		!(damage_type & HLDMG_NEVERGIB))
		hl_ent_player_gibbed = TRUE;

	if (hl_ent_player_gibbed)
	{
		HLEntGibPlayer;

		hl_ent_death_view_ofs = HLENT_DEAD_VIEWHEIGHT;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL;
		hl_ent_deadflag       = HLDEAD_DEAD;
		hl_ent_dead_time      = hl_ent_time;

		if (HLCvarGet("deathmatch") != 0.0)
			hl_ent_pack_weapons_pending = TRUE;
		return;
	}

	HLEntPlayerDeathSound(damage_type);

	if (HLCvarGet("deathmatch") != 0.0)
		hl_ent_pack_weapons_pending = TRUE;
}

U0 HLEntKillPlayer()
{
	hl_ent_player_health = 0.0;
	HLEntPlayerKilled(HLDMG_GENERIC);
}

U0 HLEntHurtPlayer(F64 damage, I64 damage_type = HLDMG_GENERIC,
	F64 *source = NULL)
{
	F64  absorbed;
	F64  to_armor;
	F64  health_prev;
	Bool fmajor;
	Bool fcritical;

	if (damage <= 0.0 || hl_ent_player_dead)
		return;

	if (hl_ent_godmode)
		return;

	if (hl_ent_player_armor > 0.0 &&
		!(damage_type & (HLDMG_FALL | HLDMG_DROWN)))
	{
		absorbed = damage * 0.8;
		to_armor = absorbed * 0.5;

		if (to_armor > hl_ent_player_armor)
		{
			to_armor = hl_ent_player_armor;
			absorbed = to_armor * 2.0;
		}

		hl_ent_player_armor -= to_armor;
		damage -= absorbed;
	}

	HLHudDamageSource(source);

	hl_ent_last_dmg      = damage;
	hl_ent_last_dmg_type = damage_type;
	hl_ent_dmg_usermsg   = TRUE;

	health_prev = hl_ent_player_health;

	hl_ent_player_damage += damage;
	hl_ent_player_health -= damage;

	if (hl_ent_player_health <= 0.0)
	{
		HLEntPlayerKilled(damage_type);
		hl_ent_player_health = 0.0;
		return;
	}

	fmajor    = ToBool(damage > 25.0);
	fcritical = ToBool(hl_ent_player_health < 30.0);

	if (damage_type & HLDMG_CLUB)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG4", 30.0);
	}

	if (damage_type & (HLDMG_FALL | HLDMG_CRUSH))
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG5", 30.0);
		else
			HLEntSuitUpdate("!HEV_DMG4", 30.0);
	}

	//"if (m_lastDamageAmount > 5)" - blood loss, not every graze
	if (damage_type & HLDMG_BULLET)
	{
		if (damage > 5.0)
			HLEntSuitUpdate("!HEV_DMG6", 30.0);
	}

	if (damage_type & HLDMG_SLASH)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG1", 30.0);
		else
			HLEntSuitUpdate("!HEV_DMG0", 30.0);
	}

	if (damage_type & HLDMG_SONIC)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG2", 60.0);
	}

	if (damage_type & (HLDMG_POISON | HLDMG_PARALYZE))
		HLEntSuitUpdate("!HEV_DMG3", 60.0);

	if (damage_type & HLDMG_ACID)
		HLEntSuitUpdate("!HEV_DET1", 60.0);

	if (damage_type & HLDMG_NERVEGAS)
		HLEntSuitUpdate("!HEV_DET0", 60.0);

	if (damage_type & HLDMG_RADIATION)
		HLEntSuitUpdate("!HEV_DET2", 60.0);

	if (fmajor && health_prev >= 75.0)
	{
		HLEntSuitUpdate("!HEV_MED1", 1800.0);
		HLEntSuitUpdate("!HEV_HEAL7", 1800.0);
	}

	if (fcritical && health_prev < 75.0)
	{
		if (hl_ent_player_health < 6.0)
			HLEntSuitUpdate("!HEV_HLTH3", 600.0);
		else if (hl_ent_player_health < 20.0)
			HLEntSuitUpdate("!HEV_HLTH2", 600.0);

		if (!HLPartRandI(4) && health_prev < 50.0)
			HLEntSuitUpdate("!HEV_DMG7", 300.0);
	}

	HLEntPlayerPainSound;
}

U0 HLEntPlayerRespawn()
{
	F64 org[3];
	F64 ang[3];

	hl_ent_player_health = HLENT_MAX_HEALTH;
	hl_ent_player_armor  = 0.0;
	hl_ent_player_dead   = FALSE;
	hl_ent_deadflag      = HLDEAD_NO;
	hl_ent_player_gibbed = FALSE;
	hl_ent_death_time    = 0.0;
	hl_ent_dead_time     = 0.0;

	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;
	hl_ent_input_locked   = FALSE;

	hl_ent_shake_pending = FALSE;
	hl_ent_fade_pending  = FALSE;

	if (HLEntFindPlayerStart(org, ang))
	{
		HLVecCopy(org, hl_ent_respawn_org);
		HLVecCopy(ang, hl_ent_respawn_ang);
		hl_ent_respawn_pending = TRUE;
	}

}

U0 HLEntPlayerDeathThink()
{
	F64 elapsed;
	F64 frac;

	if (!hl_ent_player_dead)
		return;

	elapsed = hl_ent_time - hl_ent_death_time;

	if (hl_ent_deadflag == HLDEAD_DYING)
	{
		frac = elapsed / HLENT_DEATH_ANIM_TIME;

		if (frac > 1.0)
			frac = 1.0;

		hl_ent_death_view_ofs = HLPHYS_VIEW_Z +
			(HLENT_DEAD_VIEWHEIGHT - HLPHYS_VIEW_Z) * frac;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL * frac;

		if (elapsed < HLENT_DEATH_ANIM_TIME)
			return;

		hl_ent_deadflag  = HLDEAD_DEAD;
		hl_ent_dead_time = hl_ent_time;
		return;
	}

	if (hl_ent_deadflag == HLDEAD_DEAD)
	{
		if (hl_ent_death_button)
			return;

		if (hl_ent_time < hl_ent_dead_time + HLENT_RESPAWN_DELAY)
			return;

		hl_ent_dead_time = hl_ent_time;
		hl_ent_deadflag  = HLDEAD_RESPAWNABLE;
		return;
	}

	if (!hl_ent_death_button)
		return;

	//client.cpp:140 respawn(): deathmatch/coop Spawn in place;
	if (HLCvarGet("deathmatch") != 0.0 || HLCvarGet("coop") != 0.0)
		HLEntPlayerRespawn;
	else
		hl_ent_loadsaved_pending = TRUE;
}


Bool HLEntValid(I64 i)
{
	if (i < 0 || i >= hl_num_entities || !hl_entities)
		return FALSE;

	return hl_entities[i].in_use;
}

CHLEntity *HLEntGet(I64 i)
{
	if (!HLEntValid(i))
		return NULL;

	return &hl_entities[i];
}

U0 HLEntMakeDormant(I64 self)
{//CBaseEntity::MakeDormant, cbase.cpp. Inert until a restore merge wakes it.
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->dormant    = TRUE;
	e->solid      = HLSOLID_NOT;
	e->movetype   = HLMOVETYPE_NONE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
	e->touch_fn   = HLM_NONE;
	e->use_fn     = HLM_NONE;
	e->blocked_fn = HLM_NONE;
	e->move_done  = HLM_NONE;
	e->effects    = e->effects | HLEF_NODRAW;
}

U0 HLEntWakeDormant(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->dormant = FALSE;
	e->effects = e->effects & ~HLEF_NODRAW;
}

I64 HLEntFindByTargetname(U8 *name, I64 start)
{
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = start; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qefb_next;

		if (!StrICompare(hl_entities[i].targetname, name))
			return i;

qefb_next:
	}

	return -1;
}

U0 HLEntSetAbsBox(CHLEntity *e)
{
	F64 radius = 0.0;
	F64 v;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] + e->mins[i] - 1.0;
		e->absmax[i] = e->origin[i] + e->maxs[i] + 1.0;
		e->size[i]   = e->maxs[i] - e->mins[i];
	}

	if (!e->rotates)
		return;

	for (i = 0; i < 3; i++)
	{
		v = e->mins[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;

		v = e->maxs[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;
	}

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] - radius - 1.0;
		e->absmax[i] = e->origin[i] + radius + 1.0;
	}
}

U0 HLEntSetBrushSize(CHLMap *map, CHLEntity *e)
{
	CHLModel *bm;

	if (e->brush_model < 1 || !map || e->brush_model >= map->num_models)
		return;

	bm = &map->models[e->brush_model];

	HLVecCopy(bm->mins, e->mins);
	HLVecCopy(bm->maxs, e->maxs);

	HLEntSetAbsBox(e);
}

U0 HLEntSetMoveDir(CHLEntity *e)
{
	F64 yaw = e->angles[1];

	if (yaw == -1.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
		e->angles[1] = 0.0;
		return;
	}

	if (yaw == -2.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, -1.0);
		e->angles[1] = 0.0;
		return;
	}

	HLVecSet(e->move_dir, Cos(yaw * HLDEG2RAD), Sin(yaw * HLDEG2RAD), 0.0);
	e->angles[1] = 0.0;
}

Bool hl_ent_clip_hit_player = FALSE;

U0 HLEntClipToSlideboxes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 emins[3];
	F64			 emaxs[3];
	F64			 smins[3];
	F64			 smaxs[3];
	F64			 v;
	I64			 i;
	I64			 j;

	hl_ent_clip_hit_player = FALSE;

	if (!hl_entities)
		return;

	for (j = 0; j < 3; j++)
	{
		smins[j] = start[j] + mins[j];
		smaxs[j] = start[j] + maxs[j];

		v = end[j] + mins[j];
		if (v < smins[j])
			smins[j] = v;

		v = end[j] + maxs[j];
		if (v > smaxs[j])
			smaxs[j] = v;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || i == hl_ent_clip_ignore)
			goto qecs_next;

		if (e->solid != HLSOLID_SLIDEBOX && e->solid != HLSOLID_BBOX)
			goto qecs_next;

		if (e->absmin[0] > smaxs[0] || e->absmax[0] < smins[0] ||
			e->absmin[1] > smaxs[1] || e->absmax[1] < smins[1] ||
			e->absmin[2] > smaxs[2] || e->absmax[2] < smins[2])
			goto qecs_next;

		if (e->size[0] <= 0.0 || e->size[1] <= 0.0 || e->size[2] <= 0.0)
			goto qecs_next;

		for (j = 0; j < 3; j++)
		{
			emins[j] = e->origin[j] + e->mins[j];
			emaxs[j] = e->origin[j] + e->maxs[j];
		}

		HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);

			hl_trace_native_ent    = i;
			hl_ent_clip_hit_player = FALSE;
		}

qecs_next:
	}

	if (hl_ent_clip_ignore < 0 || hl_ent_player_health <= 0.0)
		return;

	for (j = 0; j < 3; j++)
	{
		emins[j] = hl_ent_player_org[j] + hl_player_mins[j];
		emaxs[j] = hl_ent_player_org[j] + hl_player_maxs[j];
	}

	for (j = 0; j < 3; j++)
	{
		if (emins[j] - 1.0 > smaxs[j] || emaxs[j] + 1.0 < smins[j])
			return;
	}

	HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

	if (tr.fraction < trace->fraction)
	{
		trace->fraction = tr.fraction;
		trace->hit      = tr.hit;
		HLVecCopy(tr.end_pos, trace->end_pos);
		HLVecCopy(tr.plane_normal, trace->plane_normal);

		hl_trace_native_ent    = -1;
		hl_ent_clip_hit_player = TRUE;
	}
}

hl_ent_clip_hit_player = FALSE;
hl_ent_slidebox_hook   = &HLEntClipToSlideboxes;

Bool HLEntTraceDecalSurface(CHLTrace *tr)
{//EV_HLDM_DecalGunshot
	I64 hit;

	if (hl_ent_clip_hit_player)
		return FALSE;

	hit = hl_trace_native_ent;

	if (hit >= 0)
	{
		if (!hl_entities || hit >= hl_num_entities)
			return FALSE;

		return ToBool(hl_entities[hit].solid == HLSOLID_BSP);
	}

	no_warn tr;

	return TRUE;
}

F64 HLEntAbsF(F64 v)
{
	if (v < 0.0)
		return -v;

	return v;
}

U0 HLEntAxisDir(CHLEntity *e, I64 flag_roll, I64 flag_pitch)
{
	if (e->spawnflags & flag_roll)
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
	else if (e->spawnflags & flag_pitch)
		HLVecSet(e->move_dir, 1.0, 0.0, 0.0);
	else
		HLVecSet(e->move_dir, 0.0, 1.0, 0.0);
}

F64 HLEntAxisDelta(CHLEntity *e, F64 *a, F64 *b)
{
	if (e->move_dir[2] != 0.0)
		return a[2] - b[2];

	if (e->move_dir[0] != 0.0)
		return a[0] - b[0];

	return a[1] - b[1];
}


