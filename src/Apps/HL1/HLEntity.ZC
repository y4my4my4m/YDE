// HLEntity.ZC - native entity behaviour, replacing the QuakeC VM
//
// Half-Life game logic is a native DLL, not bytecode, so there is nothing to
// interpret. HLProgs.ZC and HLBuiltin.ZC are unused here.
//
// Two SDK C++ mechanisms are integers here:
//
//   LINK_ENTITY_TO_CLASS   classname -> spawn dispatch, HLEntSpawnOne
//   virtual Think/Use/...  method ID dispatched through a switch
//
// Method IDs rather than function pointers because ZealC is single-pass: the
// dispatcher sits after every implementation it calls, and an entity can
// schedule a method defined later in the file.
//
// SUB_UseTargets, SUB_CalcMove and CBaseToggle carry most brush entities: a
// toggle that moves between two points and fires its target on arrival.

//--- method ids -------------------------------------------------------------
//
// Grouped by owning class. 0 is "no method" and every scheduling field rests
// there, so a zeroed entity does nothing.

#define HLM_NONE				0

#define HLM_REMOVE			1	//free the slot on the next think
#define HLM_FIRE_TARGETS		2	//delayed SUB_UseTargets
#define HLM_MOVE_DONE		3	//arrival, dispatches move_done

#define HLM_DOOR_GO_UP		10
#define HLM_DOOR_GO_DOWN		11
#define HLM_DOOR_HIT_TOP		12
#define HLM_DOOR_HIT_BOTTOM	13
#define HLM_DOOR_USE			14
#define HLM_DOOR_TOUCH		15
#define HLM_DOOR_BLOCKED		16	//activator is the blocker, -1 for the player
#define HLM_DOOR_LEAF		17	//one leaf of a door group, no further fan out
#define HLM_PLAT_BLOCKED		18	//func_plat: retreat rather than crush

#define HLM_BUTTON_USE		20
#define HLM_BUTTON_TOUCH		21
#define HLM_BUTTON_GO_UP		22
#define HLM_BUTTON_GO_DOWN	23
#define HLM_BUTTON_HIT_TOP	24
#define HLM_BUTTON_HIT_BOTTOM 25
#define HLM_BUTTON_RETURN	26

#define HLM_TRAIN_NEXT		30
#define HLM_TRAIN_USE		31
#define HLM_TRAIN_WAIT		32
#define HLM_TRAIN_START		33
#define HLM_TRAIN_BLOCKED	34	//func_train and func_tracktrain both grind

#define HLM_TRIGGER_TOUCH	40
#define HLM_TRIGGER_USE		41
#define HLM_TRIGGER_ENABLE	42
#define HLM_MULTI_MANAGER_USE 43
#define HLM_MULTI_MANAGER_TICK 44
#define HLM_RELAY_USE		45
#define HLM_AUTO_THINK		46
#define HLM_AMBIENT_USE		47

#define HLM_LIGHT_USE		50
#define HLM_WALL_USE			51

#define HLM_SCRIPT_USE		59	//handled in HLAI.ZC - see HLScriptUse

#define HLM_BREAK_USE		60	//damaged into breaking by a use, not a hit
#define HLM_BREAK_DIE		61	//health reached zero
#define HLM_HURT_TOUCH		62
#define HLM_PUSH_TOUCH		63
#define HLM_TELEPORT_TOUCH	64

//angular movers. a separate family from the linear ones because the arrival
//snaps angles rather than an origin
#define HLM_ROT_DOOR_USE			70
#define HLM_ROT_DOOR_GO_UP		71
#define HLM_ROT_DOOR_GO_DOWN		72
#define HLM_ROT_DOOR_HIT_TOP		73
#define HLM_ROT_DOOR_HIT_BOTTOM	74
#define HLM_ROT_DOOR_TOUCH		75
#define HLM_ROTATE_USE			76
#define HLM_PENDULUM_USE			77
#define HLM_PENDULUM_SWING		78

//momentary_*. these carry a position rather than an on/off state, and are the
//only classes that use HLUSE_SET and its value
#define HLM_MOMENTARY_USE		80
#define HLM_MOMENTARY_DOOR_USE	81
#define HLM_MOMENTARY_RETURN		82

//the env_* effect family
#define HLM_SPRITE_USE			90
#define HLM_BEAM_USE				91
#define HLM_RENDER_USE			92
#define HLM_MESSAGE_USE			93
#define HLM_FADE_USE				94
#define HLM_SHAKE_USE			95
#define HLM_EXPLOSION_USE		96
#define HLM_SPARK_THINK			97
#define HLM_SPARK_USE			98
#define HLM_GLOBAL_USE			99
#define HLM_SENTENCE_USE			100	//handled in HLAI.ZC, see HLC_SENTENCE
#define HLM_GAME_TEXT_USE		101

#define HLM_EXPLOSION_SMOKE		102	//CEnvExplosion::Smoke, 0.3s after the blast
#define HLM_BUBBLE_USE			103
#define HLM_BUBBLE_THINK			104	//CBubbling::FizzThink
#define HLM_SMOKER_THINK			105	//CSmoker::Think
#define HLM_FUNNEL_USE			106
#define HLM_BLOOD_USE			107
#define HLM_SHOOTER_USE			108
#define HLM_SHOOTER_THINK		109	//CGibShooter::ShootThink

//items, chargers and the trigger volumes that act on the player
#define HLM_ITEM_TOUCH			110
#define HLM_CHARGER_USE			111
#define HLM_CHARGER_THINK		112
#define HLM_CONVEYOR_TOUCH		113
#define HLM_FRICTION_TOUCH		114
#define HLM_GRAVITY_TOUCH		115
#define HLM_CHANGELEVEL_TOUCH	116
#define HLM_CHANGELEVEL_USE		117

//env_laser. a beam with a think, unlike env_beam's pure on/off state
#define HLM_LASER_USE			118
#define HLM_LASER_THINK			119	//CLaser::StrikeThink
#define HLM_BEAM_DAMAGE_THINK	120	//CLightning::DamageThink

#define HLM_DECAL_THINK			121	//CDecal::StaticDecal
#define HLM_DECAL_USE			122	//CDecal::TriggerDecal
#define HLM_CDAUDIO_PLAY			123	//CTriggerCDAudio::PlayTrack, as touch or use
#define HLM_CDAUDIO_RADIUS		124	//CTargetCDAudio::Think, the radius poll
#define HLM_MAKER_USE			125	//CMonsterMaker::CyclicUse / ToggleUse
#define HLM_MAKER_THINK			126	//CMonsterMaker::MakerThink

//how long a "toggle" trigger stays untouchable after firing
#define HLENT_TRIGGER_DEBOUNCE	0.2

//SUB_CalcMove refuses to divide by a zero traveltime
#define HLENT_MIN_MOVE_TIME	0.0001

//multi_manager fires up to this many targets, each at its own offset
#define HLENT_MM_MAX			16

//ATTN_NORM. attenuation is a plain multiplier here, 1.0 being the normal
//falloff and 0 meaning "audible everywhere"
#define HLENT_SND_ATTEN		1.0

//channels, so a door's move sound is replaced by its stop sound rather than
//overlapping it
#define HLENT_CHAN_MOVE		1
#define HLENT_CHAN_USE		2

//S_StartSound's channels, for the paths that pass a real entnum. Replacement is
//per (entnum, entchannel), so a monster's voice line cuts its own previous line
//and nothing else.
//CHAN_VOICE and CHAN_BODY, common/const.h:617 and :619. HLSndVoiceAmplitude
//filters on channel 2 to drive the studio mouth controller; 3 is CHAN_ITEM and
//moves no jaw
#define HLENT_CHAN_VOICE		2
#define HLENT_CHAN_BODY		4

class CHLMultiManager
{//parsed out of the entity's own key/values: every key that is not a known
 //field is a targetname, and its value is the delay
	I64	ent;					//owning entity index
	U8	name[HLENT_MM_MAX * 64];
	F64	delay[HLENT_MM_MAX];
	I64	count;
	I64	fired;					//how many have gone off this cycle
	F64	started;
};

CHLMultiManager	hl_mm[32];
I64				hl_mm_count = 0;

//game clock the entity system runs on. separate from hl_light_time, which is
//a render clock and keeps ticking through a pause
F64	hl_ent_time     = 0.0;
I64	hl_ent_thinks   = 0;
I64	hl_ent_spawned  = 0;

//the player, as an entity the movers can push and triggers can fire on.
//index -1 until a map is up
I64	hl_ent_player   = -1;

//length of the tick HLEntFrame is running, seconds. Anything driven off the
//held +use key rather than off a think needs it
F64	hl_ent_frame_dt = 0.0;

//how long after the last +use an FCAP_CONTINUOUS_USE entity still counts the
//key as down. Seven ticks at the shell's 72Hz, so a stall does not read as a
//release; a real release is noticed within a tenth of a second
#define HLENT_USE_HOLD_GAP	0.1

//--- player state, native side ---------------------------------------------
//
// There is no edict, so the player state the entity world touches lives here.
//
// Trigger effects on the player are pending rather than applied: the shell owns
// hl_origin and hl_velocity, and writing them from inside the entity pass would
// fight the move already in progress this tick.

F64		hl_ent_player_health	= 100.0;
F64		hl_ent_player_armor		= 0.0;
Bool	hl_ent_player_dead		= FALSE;

F64		hl_ent_teleport_to[3];
Bool	hl_ent_teleport_pending	= FALSE;

F64		hl_ent_push_vel[3];
Bool	hl_ent_push_pending		= FALSE;

//SV_PushRotate's effect on a rider. The shell owns hl_origin and hl_angles, so
//the rotation is posted and drained there. pivot is the pusher's origin.
Bool	hl_ent_spin_pending		= FALSE;
F64		hl_ent_spin_pivot[3];
F64		hl_ent_spin_yaw			= 0.0;

//damage the player has taken this tick, applied and cleared by the shell
F64		hl_ent_player_damage	= 0.0;

//--- damage types -----------------------------------------------------------
//
// bitsDamageType, dlls/cbase.h:609-636, complete.
//
// DMG_GENERIC is 0, so a caller that passes nothing gets it.
//
// Bits at 1<<15 and above are the time-based set: a hit carrying one of them
// applies its damage immediately like any other, then leaves a residual the
// player state counts down. Of the eight, only poison and drown-recover have
// live bodies in CBasePlayer::CheckTimeBasedDamage (dlls/player.cpp:2215-2245);
// the other six have their TakeDamage lines commented out and expire silently.

#define HLDMG_GENERIC		0
#define HLDMG_CRUSH			1		//1 << 0, a mover closing on the player
#define HLDMG_BULLET			2		//1 << 1
#define HLDMG_SLASH			4		//1 << 2
#define HLDMG_BURN			8		//1 << 3
#define HLDMG_FREEZE			16		//1 << 4
#define HLDMG_FALL			32		//1 << 5
#define HLDMG_BLAST			64		//1 << 6
#define HLDMG_CLUB			128		//1 << 7
#define HLDMG_SHOCK			256		//1 << 8
#define HLDMG_SONIC			512		//1 << 9
#define HLDMG_ENERGYBEAM		1024	//1 << 10
#define HLDMG_NEVERGIB		4096	//1 << 12
#define HLDMG_ALWAYSGIB		8192	//1 << 13
#define HLDMG_DROWN			16384	//1 << 14

//DMG_TIMEBASED is ~0x3fff in the SDK; here it is the positive mask of the eight
//bits above, which is what a test against a parsed damagetype needs
#define HLDMG_PARALYZE		32768		//1 << 15
#define HLDMG_NERVEGAS		65536		//1 << 16
#define HLDMG_POISON			131072		//1 << 17
#define HLDMG_RADIATION		262144		//1 << 18
#define HLDMG_DROWNRECOVER	524288		//1 << 19
#define HLDMG_ACID			1048576		//1 << 20
#define HLDMG_SLOWBURN		2097152		//1 << 21
#define HLDMG_SLOWFREEZE		4194304		//1 << 22
#define HLDMG_MORTAR			8388608		//1 << 23
#define HLDMG_TIMEBASED		8355840		//1<<15 .. 1<<22

//CheckTimeBasedDamage runs on a 2 second period (dlls/player.cpp:2202) and
//poison is the only entry that still deals damage - the nervegas, radiation,
//acid, slowburn and slowfreeze TakeDamage lines are commented out
//(dlls/player.cpp:2222-2256). POISON_DAMAGE 2.0 over POISON_DURATION 5
//intervals, dlls/cbase.h:651-652.
#define HLDMG_TBD_PERIOD		2.0
#define HLDMG_POISON_DAMAGE	2.0
#define HLDMG_POISON_DURATION 5

//--- player death -----------------------------------------------------------
//
// CBasePlayer::Killed and CBasePlayer::PlayerDeathThink. deadflag is a four
// state machine, not a bool: dying (the animation is playing), dead (the body
// has settled), respawnable (the delay is served and a key press will do it).
//
// hl_ent_player_dead stays as the "is the player dead at all" flag every other
// file already tests. hl_ent_deadflag is the stage inside that.

#define HLDEAD_NO			0
#define HLDEAD_DYING			1	//DEAD_DYING, the death animation is running
#define HLDEAD_DEAD			2	//DEAD_DEAD, settled, waiting for buttons up
#define HLDEAD_RESPAWNABLE	3	//DEAD_RESPAWNABLE, a key press respawns

//CBasePlayer::Killed's own gib threshold. cbase.h's GIB_HEALTH_VALUE is -30 and
//is what CBaseMonster::Killed tests; the player's Killed compares against -40
//directly, so the two are not the same number
#define HLENT_GIB_HEALTH_VALUE	-30.0	//GIB_HEALTH_VALUE, monsters
#define HLENT_PLAYER_GIB_HEALTH	-40.0	//CBasePlayer::Killed

//PlayerDeathThink's animation window: "120 frames at 30fps - animations should
//be no longer than this"
#define HLENT_DEATH_ANIM_TIME	4.0

//the delay between the body settling and the respawn gate opening. HL's
//singleplayer path opens it as soon as every button is released; the wait is
//there so a key still held from the death frame does not respawn instantly
#define HLENT_RESPAWN_DELAY		0.5

//deadflag. HLDEAD_*
I64		hl_ent_deadflag			= HLDEAD_NO;

//gpGlobals->time the player died, on the ENTITY clock. The death animation
//window is measured from it
F64		hl_ent_death_time		= 0.0;

//m_fDeadTime - when the body finished settling and became respawnable
F64		hl_ent_dead_time		= 0.0;

//Killed's gib branch fired. The shell hides the view model and the corpse
Bool	hl_ent_player_gibbed	= FALSE;

//PM_DEAD_VIEWHEIGHT, pm_shared.c. The shell adds this to the origin instead of
//the normal 28 while the player is dead, and rolls the view by
//hl_ent_death_roll - the client's "dead view angle", cl_dll/view.cpp
#define HLENT_DEAD_VIEWHEIGHT	-8.0
#define HLENT_DEAD_VIEW_ROLL		80.0

//eye height above the player origin to use INSTEAD of the normal one, valid
//only while hl_ent_player_dead. A substitution rather than an offset, as
//pm_shared's "pmove->view_ofs[2] = PM_DEAD_VIEWHEIGHT" is; it ramps from
//HLPHYS_VIEW_Z down to HLENT_DEAD_VIEWHEIGHT across the death animation, which
//is the body falling over seen from inside it
F64		hl_ent_death_view_ofs	= HLPHYS_VIEW_Z;

//degrees of roll to ADD to the view. 0 while alive
F64		hl_ent_death_roll		= 0.0;

//"the player may not act". Set for the whole of death and cleared on respawn.
//The shell must drop movement, weapon and +use input while it is set - HL does
//this by taking the player's think away, which has no equivalent here
Bool	hl_ent_input_locked		= FALSE;

//the respawn gate. PlayerDeathThink waits for every button to be RELEASED, then
//for one to be PRESSED again. The shell owns the keyboard, so it publishes
//"something is down" here and the death think reads it
Bool	hl_ent_death_button		= FALSE;

//respawn request. Drained by the shell, which owns hl_origin and hl_angles:
//origin is an info_player_start, as CBasePlayer::Spawn's GetPlayerSpawnSpot
Bool	hl_ent_respawn_pending	= FALSE;
F64		hl_ent_respawn_org[3];
F64		hl_ent_respawn_ang[3];

//EMIT_GROUPNAME_SUIT. The HEV suit's sentence groups are played by the sentence
//scheduler in HLAI.ZC, which compiles after this file, so the group name is
//posted rather than spoken. "HEV_DEAD" is the one DeathSound asks for
U8		hl_ent_suit_group[32];
Bool	hl_ent_suit_pending		= FALSE;

//--- pending screen and player effects, from the env_* / trigger_* classes ---
//
// Same rule as the teleport above: the entity pass owns neither the view, the
// player's gravity, nor which map loads next. Each is a request HL1.ZC drains.

//player origin at the start of this tick's entity pass, stashed by HLEntFrame.
//A think running later in the tick (a charger metering out health, an env_sound
//testing its radius) has no origin argument
F64		hl_ent_player_org[3];

//env_shake. amplitude in units, frequency in Hz, both straight off the entity.
//hl_ent_shake_until is on the ENTITY clock, so a paused game does not shake
F64		hl_ent_shake_amp		= 0.0;
F64		hl_ent_shake_freq		= 0.0;
F64		hl_ent_shake_until		= 0.0;
Bool	hl_ent_shake_pending	= FALSE;

//env_fade. renderamt is the alpha 0..255 and rendercolor the colour, which is
//how the SDK stores it - there are no dedicated keys
F64		hl_ent_fade_color[3];
F64		hl_ent_fade_alpha		= 0.0;
F64		hl_ent_fade_duration	= 0.0;
F64		hl_ent_fade_hold		= 0.0;
Bool	hl_ent_fade_in			= FALSE;	//SF_FADE_IN: fade FROM the colour
Bool	hl_ent_fade_pending		= FALSE;

//trigger_gravity. a multiplier on the normal 800, not an absolute value.
//persistent: HL leaves it set until another trigger changes it, so a low
//gravity section stays low after the brush is left
F64		hl_ent_gravity			= 1.0;

//env_sound. the reverb preset for wherever the player is standing, recomputed
//every tick by HLEntFrame. 0 is "normal room", which is also the no-op value
I64		hl_ent_roomtype			= 0;

//trigger_changelevel. HL1.ZC owns HLChangeLevel and compiles after this file,
//so the request is posted here and drained there. Not mirrored into
//hl_change_map/hl_change_pending: the shell's main loop drains those already,
//and setting both changes level twice
U8		hl_ent_changelevel[64];
U8		hl_ent_changelevel_landmark[64];
Bool	hl_ent_changelevel_pending	= FALSE;

//item_suit / item_longjump. flags for the layers that own the HUD gating and
//the jump change
Bool	hl_ent_player_suit		= FALSE;

//sv_cheats state. HL keeps these as FL_GODMODE / FL_NOTARGET on the player
//edict; there is no player edict here, so they are flags on the native player.
Bool	hl_ent_godmode			= FALSE;
Bool	hl_ent_notarget			= FALSE;
Bool	hl_ent_player_longjump	= FALSE;

//MAX_NORMAL_BATTERY. a battery picked up at 100 armour is refused
//pev->effects. EF_NODRAW is the only bit this port acts on.
#define HLEF_NODRAW			128

#define HLENT_MAX_ARMOR		100.0
#define HLENT_MAX_HEALTH		100.0

U0 HLEntPlayerReset()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	hl_ent_player_health   = 100.0;
	hl_ent_player_armor    = 0.0;
	hl_ent_player_dead     = FALSE;
	hl_ent_player_damage   = 0.0;

	//CBasePlayer::Spawn's deadflag = DEAD_NO and view_ofs = VEC_VIEW
	hl_ent_deadflag        = HLDEAD_NO;
	hl_ent_death_time      = 0.0;
	hl_ent_dead_time       = 0.0;
	hl_ent_player_gibbed   = FALSE;
	hl_ent_death_view_ofs  = HLPHYS_VIEW_Z;
	hl_ent_death_roll      = 0.0;
	hl_ent_input_locked    = FALSE;
	hl_ent_death_button    = FALSE;
	hl_ent_respawn_pending = FALSE;
	hl_ent_suit_group[0]   = 0;
	hl_ent_suit_pending    = FALSE;

	HLVecSet(hl_ent_respawn_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_respawn_ang, 0.0, 0.0, 0.0);
	hl_ent_teleport_pending = FALSE;
	hl_ent_push_pending    = FALSE;
	hl_ent_spin_pending    = FALSE;
	hl_ent_spin_yaw        = 0.0;

	HLVecSet(hl_ent_teleport_to, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_push_vel, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_spin_pivot, 0.0, 0.0, 0.0);

	HLVecSet(hl_ent_player_org, 0.0, 0.0, 0.0);

	hl_ent_shake_amp     = 0.0;
	hl_ent_shake_freq    = 0.0;
	hl_ent_shake_until   = 0.0;
	hl_ent_shake_pending = FALSE;

	HLVecSet(hl_ent_fade_color, 0.0, 0.0, 0.0);
	hl_ent_fade_alpha    = 0.0;
	hl_ent_fade_duration = 0.0;
	hl_ent_fade_hold     = 0.0;
	hl_ent_fade_in       = FALSE;
	hl_ent_fade_pending  = FALSE;

	hl_ent_gravity  = 1.0;
	hl_ent_roomtype = 0;

	hl_ent_changelevel[0]          = 0;
	hl_ent_changelevel_landmark[0] = 0;
	hl_ent_changelevel_pending     = FALSE;

	//not the suit or the longjump: those are inventory and survive a
	//changelevel. See HLEntPlayerNewGame
}

HLEntPlayerReset;

U0 HLEntPlayerNewGame()
{//what a changelevel must not clear. called from outside this file: only the
 //shell distinguishes "new game" from "next map"
	hl_ent_player_suit     = FALSE;
	hl_ent_godmode         = FALSE;
	hl_ent_notarget        = FALSE;
	hl_ent_player_longjump = FALSE;
}

HLEntPlayerNewGame;

//--- global state (env_global) -----------------------------------------------
//
// HL's cross-level flags. A named state that survives a changelevel, set by
// env_global and read by any entity with a globalstate key.
//
// Not cleared by HLEntSpawnAll: surviving the map change is the point.
// HLEntGlobalResetAll is for a new game and, like HLEntPlayerNewGame, is called
// from outside.

#define HLENT_GLOBAL_MAX		64

#define HLGLOBAL_OFF			0
#define HLGLOBAL_ON			1
#define HLGLOBAL_DEAD		2

class CHLEntGlobalState
{
	U8	name[64];
	I64	state;
};

CHLEntGlobalState	hl_ent_globals[HLENT_GLOBAL_MAX];
I64					hl_ent_global_count = 0;

U0 HLEntGlobalResetAll()
{
	I64 i;

	for (i = 0; i < HLENT_GLOBAL_MAX; i++)
	{
		hl_ent_globals[i].name[0] = 0;
		hl_ent_globals[i].state   = HLGLOBAL_OFF;
	}

	hl_ent_global_count = 0;
}

HLEntGlobalResetAll;

I64 HLEntGlobalGet(U8 *name)
{//HLGLOBAL_OFF for anything never set, as on an unvisited level
	I64 i;

	if (!name || !name[0])
		return HLGLOBAL_OFF;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
			return hl_ent_globals[i].state;
	}

	return HLGLOBAL_OFF;
}

U0 HLEntGlobalSet(U8 *name, I64 state)
{
	I64 i;

	if (!name || !name[0])
		return;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
		{
			hl_ent_globals[i].state = state;
			return;
		}
	}

	if (hl_ent_global_count >= HLENT_GLOBAL_MAX)
		return;

	i = hl_ent_global_count;
	HLStrCopy(hl_ent_globals[i].name, name, 64);
	hl_ent_globals[i].state = state;
	hl_ent_global_count     = i + 1;
}

I64 HLEntCountInUse()
{//impulse 104's report.
	I64 n = 0;
	I64 i;

	if (!hl_entities)
		return 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use)
			n++;
	}

	return n;
}

U0 HLEntSuitGroup(U8 *group)
{//EMIT_GROUPNAME_SUIT. Posted for the sentence scheduler in HLAI.ZC - see
 //hl_ent_suit_group. A pending group is not queued behind another: the SDK's
 //SetSuitUpdate also drops a line when one is already speaking
	if (!group || !group[0] || hl_ent_suit_pending)
		return;

	HLStrCopy(hl_ent_suit_group, group, 32);
	hl_ent_suit_pending = TRUE;
}

U0 HLEntPlayerDeathSound(I64 damage_type)
{//CBasePlayer::DeathSound - one of five draws, two of which are silence, then
 //the suit's death group
	I64 n;

	//the water death is in the SDK as a commented block testing waterlevel == 3.
	//Restored here on DMG_DROWN, which is the same condition by the time the
	//damage arrives, and is the one sample a drowning has
	if (damage_type & HLDMG_DROWN)
	{
		//ATTN_NONE: heard everywhere, since it is the player's own death
		HLSndPlayAt("player/h2odeath.wav", hl_ent_player_org, 1.0, 0.0,
			hl_ent_player + 1, HLENT_CHAN_VOICE);
		goto qepds_suit;
	}

	//"temporarily using pain sounds for death sounds" - Valve's own comment.
	//RANDOM_LONG(1,5) with no case 4 or 5, so death is silent two times in five
	n = HLPartRandI(5) + 1;

	if (n == 1)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 2)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 3)
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);

qepds_suit:
	HLEntSuitGroup("HEV_DEAD");
}

U0 HLEntPlayerPainSound()
{//CBasePlayer::Pain - a flat third each, not the death sound's five-way draw
	I64 n = HLPartRandI(3);

	if (n == 0)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 1)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
}

U0 HLEntGibPlayer()
{//CBaseMonster::GibMonster on the player. HasHumanGibs is true for a player, so
 //it is one head gib plus four random ones out of hgibs.mdl
	F64 absmin[3];
	F64 size[3];
	F64 dir[3];
	F64 eye[3];
	I64 i;

	HLSndPlayAt("common/bodysplat.wav", hl_ent_player_org, 1.0, HLENT_SND_ATTEN,
		hl_ent_player + 1, HLENT_CHAN_BODY);

	//SpawnRandomGibs works in the victim's box, which for the player is the
	//standing hull around the origin
	for (i = 0; i < 3; i++)
	{
		absmin[i] = hl_ent_player_org[i] + hl_player_mins[i];
		size[i]   = hl_player_maxs[i] - hl_player_mins[i];
	}

	//g_vecAttackDir, the direction the killing blow came from. There is no
	//inflictor recorded here, so the gibs go straight up rather than back down
	//an attack vector
	HLVecSet(dir, 0.0, 0.0, -1.0);

	//SpawnHeadGib comes off the eye. Its target argument is another player to
	//throw the skull at, which single player has none of
	HLVecCopy(hl_ent_player_org, eye);
	eye[2] += HLPHYS_VIEW_Z;

	HLGibSpawnHeadGib(eye, NULL, hl_ent_player_health, HLBLOOD_RED, tS);
	HLGibSpawnRandomGibs(absmin, size, dir, hl_ent_player_health, 4, TRUE,
		HLBLOOD_RED, tS);
}

U0 HLEntPlayerKilled(I64 damage_type)
{//CBasePlayer::Killed
 //
 //Everything the SDK does through the client message channel - the health and
 //ammo HUD updates, the FOV reset, the model swap - is skipped: the HUD reads
 //hl_ent_player_health directly and there is no player model to swap
	if (hl_ent_player_dead)
		return;

	hl_ent_player_dead  = TRUE;
	hl_ent_deadflag     = HLDEAD_DYING;
	hl_ent_death_time   = hl_ent_time;
	hl_ent_dead_time    = 0.0;
	hl_ent_input_locked = TRUE;

	//the view drops to the floor over the death animation. Held at the standing
	//height for this frame and ramped by the death think
	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;

	//( pev->health < -40 && iGib != GIB_NEVER ) || iGib == GIB_ALWAYS. The port
	//has no iGib argument, so it comes off the damage bits, which is where
	//CBaseMonster::TakeDamage got it from in the first place
	hl_ent_player_gibbed = FALSE;

	if (damage_type & HLDMG_ALWAYSGIB)
		hl_ent_player_gibbed = TRUE;
	else if (hl_ent_player_health < HLENT_PLAYER_GIB_HEALTH &&
		!(damage_type & HLDMG_NEVERGIB))
		hl_ent_player_gibbed = TRUE;

	if (hl_ent_player_gibbed)
	{
		//GibMonster clears the model and returns before DeathSound: a gibbed
		//player makes no death noise of their own
		HLEntGibPlayer;

		//the body is gone, so there is no animation to wait out
		hl_ent_death_view_ofs = HLENT_DEAD_VIEWHEIGHT;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL;
		hl_ent_deadflag       = HLDEAD_DEAD;
		hl_ent_dead_time      = hl_ent_time;
		return;
	}

	HLEntPlayerDeathSound(damage_type);
}

U0 HLEntKillPlayer()
{//ClientKill: suicide, straight to dead with no damage accounting and no
 //godmode exemption.
	hl_ent_player_health = 0.0;
	HLEntPlayerKilled(HLDMG_GENERIC);
}

U0 HLEntHurtPlayer(F64 damage, I64 damage_type = HLDMG_GENERIC)
{//CBasePlayer::TakeDamage
 //
 //ArmorRatio: the suit soaks 80% of incoming damage while charge remains, at 2
 //points of charge per point absorbed. ARMOR_RATIO 0.2, ARMOR_BONUS 0.5
	F64 absorbed;
	F64 to_armor;

	if (damage <= 0.0 || hl_ent_player_dead)
		return;

	//FL_GODMODE: CBaseEntity::TakeDamage returns before the armour ratio, so
	//the suit charge is not spent either.
	if (hl_ent_godmode)
		return;

	//"armor doesn't protect against fall or drown damage!"
	if (hl_ent_player_armor > 0.0 &&
		!(damage_type & (HLDMG_FALL | HLDMG_DROWN)))
	{
		absorbed = damage * 0.8;
		to_armor = absorbed * 0.5;

		if (to_armor > hl_ent_player_armor)
		{
			//the charge runs out partway through, so only part is soaked
			to_armor = hl_ent_player_armor;
			absorbed = to_armor * 2.0;
		}

		hl_ent_player_armor -= to_armor;
		damage -= absorbed;
	}

	hl_ent_player_damage += damage;
	hl_ent_player_health -= damage;

	if (hl_ent_player_health <= 0.0)
	{
		//NOT clamped to zero before the gib test: Killed compares the health
		//against -40, so how far past zero the hit went is the whole question
		HLEntPlayerKilled(damage_type);
		hl_ent_player_health = 0.0;
		return;
	}

	//"no pain sound during death animation" - CBaseMonster::TakeDamage plays it
	//only while deadflag is DEAD_NO
	HLEntPlayerPainSound;
}

U0 HLEntPlayerRespawn()
{//CBasePlayer::Spawn's half of respawn(): the state reset. The move to the
 //spawn spot is GetPlayerSpawnSpot's, and is posted for the shell
	F64 org[3];
	F64 ang[3];

	hl_ent_player_health = HLENT_MAX_HEALTH;
	hl_ent_player_armor  = 0.0;
	hl_ent_player_dead   = FALSE;
	hl_ent_deadflag      = HLDEAD_NO;
	hl_ent_player_gibbed = FALSE;
	hl_ent_death_time    = 0.0;
	hl_ent_dead_time     = 0.0;

	//view_ofs back to VEC_VIEW, which is the shell's normal eye height
	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;
	hl_ent_input_locked   = FALSE;

	//a pending screen effect from the death - a fade, a shake - is not carried
	//into the new life
	hl_ent_shake_pending = FALSE;
	hl_ent_fade_pending  = FALSE;

	if (HLEntFindPlayerStart(org, ang))
	{
		HLVecCopy(org, hl_ent_respawn_org);
		HLVecCopy(ang, hl_ent_respawn_ang);
		hl_ent_respawn_pending = TRUE;
	}

	//no info_player_start: the health is restored where the body lies, which is
	//what respawn() falls back to when GetPlayerSpawnSpot finds nothing
}

U0 HLEntPlayerDeathThink()
{//CBasePlayer::PlayerDeathThink, run from HLEntFrame rather than off a think
 //field: the player is not an entity slot
 //
 //Weapon dropping (PackDeadPlayerItems) and the multiplayer body queue are not
 //here: single player, and HLWeapon.ZC compiles after this file
	F64 elapsed;
	F64 frac;

	if (!hl_ent_player_dead)
		return;

	elapsed = hl_ent_time - hl_ent_death_time;

	if (hl_ent_deadflag == HLDEAD_DYING)
	{
		//StudioFrameAdvance and the m_flRespawnTimer < 4.0 wait. There is no
		//player model to animate, so the window is spent dropping the view from
		//standing height to PM_DEAD_VIEWHEIGHT and rolling it over, which is
		//what the animation looks like from the inside
		frac = elapsed / HLENT_DEATH_ANIM_TIME;

		if (frac > 1.0)
			frac = 1.0;

		hl_ent_death_view_ofs = HLPHYS_VIEW_Z +
			(HLENT_DEAD_VIEWHEIGHT - HLPHYS_VIEW_Z) * frac;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL * frac;

		if (elapsed < HLENT_DEATH_ANIM_TIME)
			return;

		//"once we're done animating our death and we're on the ground"
		hl_ent_deadflag  = HLDEAD_DEAD;
		hl_ent_dead_time = hl_ent_time;
		return;
	}

	if (hl_ent_deadflag == HLDEAD_DEAD)
	{
		//"wait for all buttons released". A key still held from the death frame
		//must not count as the respawn press
		if (hl_ent_death_button)
			return;

		if (hl_ent_time < hl_ent_dead_time + HLENT_RESPAWN_DELAY)
			return;

		//FPlayerCanRespawn is always true in single player
		hl_ent_dead_time = hl_ent_time;
		hl_ent_deadflag  = HLDEAD_RESPAWNABLE;
		return;
	}

	//HLDEAD_RESPAWNABLE: "wait for any button down". forcerespawn is
	//multiplayer only, so there is no timeout on this side - the player waits on
	//their corpse until they press something
	if (!hl_ent_death_button)
		return;

	HLEntPlayerRespawn;
}

//--- helpers ----------------------------------------------------------------

Bool HLEntValid(I64 i)
{
	if (i < 0 || i >= hl_num_entities || !hl_entities)
		return FALSE;

	return hl_entities[i].in_use;
}

CHLEntity *HLEntGet(I64 i)
{
	if (!HLEntValid(i))
		return NULL;

	return &hl_entities[i];
}

I64 HLEntFindByTargetname(U8 *name, I64 start)
{//next entity whose targetname matches, -1 when the chain ends
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = start; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qefb_next;

		if (!StrICompare(hl_entities[i].targetname, name))
			return i;

qefb_next:
	}

	return -1;
}

U0 HLEntSetAbsBox(CHLEntity *e)
{//SV_LinkEdict's bounds, rebuilt after anything moves
	F64 radius = 0.0;
	F64 v;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] + e->mins[i] - 1.0;
		e->absmax[i] = e->origin[i] + e->maxs[i] + 1.0;
		e->size[i]   = e->maxs[i] - e->mins[i];
	}

	if (!e->rotates)
		return;

	//SV_LinkEdict's rotating-solid case: the axial box is wrong at every angle
	//but 0/90/180/270, so it is replaced by the sphere that contains the box at
	//any orientation.
	//
	//Broad phase only - the hull trace is exact, because HLTraceHullRotated
	//works in the brush's own frame. Without the sphere a door turned 45 degrees
	//has corners outside its own bounds and the rider test misses the player.
	//
	//the absolute value is open coded: HLEntAbsF is defined further down this
	//file and a single-pass compiler cannot see it from here
	for (i = 0; i < 3; i++)
	{
		v = e->mins[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;

		v = e->maxs[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;
	}

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] - radius - 1.0;
		e->absmax[i] = e->origin[i] + radius + 1.0;
	}
}

U0 HLEntSetBrushSize(CHLMap *map, CHLEntity *e)
{//a brush entity's box comes from its BSP submodel, not from key/values
	CHLModel *bm;

	if (e->brush_model < 1 || !map || e->brush_model >= map->num_models)
		return;

	bm = &map->models[e->brush_model];

	HLVecCopy(bm->mins, e->mins);
	HLVecCopy(bm->maxs, e->maxs);

	HLEntSetAbsBox(e);
}

U0 HLEntSetMoveDir(CHLEntity *e)
{//SetMovedir - the "angle" key doubles as a movement axis for brush movers.
 //yaw -1 is straight up, yaw -2 straight down
	F64 yaw = e->angles[1];

	if (yaw == -1.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
		e->angles[1] = 0.0;
		return;
	}

	if (yaw == -2.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, -1.0);
		e->angles[1] = 0.0;
		return;
	}

	HLVecSet(e->move_dir, Cos(yaw * HLDEG2RAD), Sin(yaw * HLDEG2RAD), 0.0);
	e->angles[1] = 0.0;
}

//TRUE when the last trace's earliest impact was the player's own box. The
//player is not in hl_entities, so hl_trace_native_ent cannot name it
Bool hl_ent_clip_hit_player = FALSE;

U0 HLEntClipToSlideboxes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{//SV_ClipToLinks for the box solids: monsters, and the player
 //
 //installed into hl_ent_slidebox_hook, so HLTraceEntity in HLClip.ZC runs it
 //after the world and brush passes. HLClip.ZC compiles first and cannot name
 //this function.
 //
 //SV_ClipMoveToEntity takes the non-BSP branch for a box solid: the entity's
 //own mins/maxs at its origin, swept by HLClipMoveToBox, which grows the
 //stationary box by the mover and reduces the sweep to a point. absmin/absmax
 //are not used - those carry SV_LinkEdict's one unit of broad phase slop.
 //
 //start_solid is deliberately not propagated. Two monsters that spawn or get
 //pushed into one another would otherwise refuse every move in every
 //direction; letting the pair separate is what HLClipMoveToBox's own note
 //describes for the world case.
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 emins[3];
	F64			 emaxs[3];
	F64			 smins[3];
	F64			 smaxs[3];
	F64			 v;
	I64			 i;
	I64			 j;

	//this pass runs last, so a stale flag from the previous trace would survive
	//a move that ended on a wall
	hl_ent_clip_hit_player = FALSE;

	if (!hl_entities)
		return;

	//SV_Move's trace box, the broad phase both loops below reject against.
	//SV_ClipToLinks gets its candidates from the area tree; a linear pass over
	//the whole table has to do the box test itself, and every move, every line
	//of sight and every bullet in the frame comes through here
	for (j = 0; j < 3; j++)
	{
		smins[j] = start[j] + mins[j];
		smaxs[j] = start[j] + maxs[j];

		v = end[j] + mins[j];
		if (v < smins[j])
			smins[j] = v;

		v = end[j] + maxs[j];
		if (v > smaxs[j])
			smaxs[j] = v;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || i == hl_ent_clip_ignore)
			goto qecs_next;

		//SOLID_NOT and SOLID_TRIGGER are not obstacles, SOLID_BSP was clipped
		//by the brush pass, and a corpse has had its solid cleared
		if (e->solid != HLSOLID_SLIDEBOX && e->solid != HLSOLID_BBOX)
			goto qecs_next;

		//broad phase. absmin/absmax are maintained by HLEntSetAbsBox and
		//already carry SV_LinkEdict's unit of slop, so a box that misses the
		//sweep here cannot narrow it below
		if (e->absmin[0] > smaxs[0] || e->absmax[0] < smins[0] ||
			e->absmin[1] > smaxs[1] || e->absmax[1] < smins[1] ||
			e->absmin[2] > smaxs[2] || e->absmax[2] < smins[2])
			goto qecs_next;

		//a zero-sized box is a point entity that never had a hull set
		if (e->size[0] <= 0.0 || e->size[1] <= 0.0 || e->size[2] <= 0.0)
			goto qecs_next;

		for (j = 0; j < 3; j++)
		{
			emins[j] = e->origin[j] + e->mins[j];
			emaxs[j] = e->origin[j] + e->maxs[j];
		}

		HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);

			hl_trace_native_ent    = i;
			hl_ent_clip_hit_player = FALSE;
		}

qecs_next:
	}

	//the player, which lives in globals rather than in the entity table. Only
	//a monster's own move clips against it: hl_ent_clip_ignore of -1 means the
	//player is the mover, and a hitscan wants to pass through the man holding
	//the gun as well
	if (hl_ent_clip_ignore < 0 || hl_ent_player_health <= 0.0)
		return;

	for (j = 0; j < 3; j++)
	{
		emins[j] = hl_ent_player_org[j] + hl_player_mins[j];
		emaxs[j] = hl_ent_player_org[j] + hl_player_maxs[j];
	}

	//the same broad phase, on the one box that is not in the table
	for (j = 0; j < 3; j++)
	{
		if (emins[j] - 1.0 > smaxs[j] || emaxs[j] + 1.0 < smins[j])
			return;
	}

	HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

	if (tr.fraction < trace->fraction)
	{
		trace->fraction = tr.fraction;
		trace->hit      = tr.hit;
		HLVecCopy(tr.end_pos, trace->end_pos);
		HLVecCopy(tr.plane_normal, trace->plane_normal);

		hl_trace_native_ent    = -1;
		hl_ent_clip_hit_player = TRUE;
	}
}

//a declaration initialiser on a global does not run
hl_ent_clip_hit_player = FALSE;
hl_ent_slidebox_hook   = &HLEntClipToSlideboxes;

F64 HLEntAbsF(F64 v)
{
	if (v < 0.0)
		return -v;

	return v;
}

//--- rotation axes ----------------------------------------------------------
//
// CBaseToggle::AxisDir. A rotating brush stores its axis in move_dir. The two
// spawnflag bits that pick it differ per class - a door and a fan disagree - so
// the caller passes the pair in.
//
// The SDK names ("Z axis", "X axis") are the index into angles, not a world
// axis. angles is (pitch, yaw, roll):
//
//   default   (0,1,0)   yaw   - turns about world Z, an ordinary swinging door
//   "Z axis"  (0,0,1)   roll  - turns about world X
//   "X axis"  (1,0,0)   pitch - turns about world Y
//
// Substituting real world axes swings doors through the floor; reproduced as
// written.
U0 HLEntAxisDir(CHLEntity *e, I64 flag_roll, I64 flag_pitch)
{
	if (e->spawnflags & flag_roll)
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
	else if (e->spawnflags & flag_pitch)
		HLVecSet(e->move_dir, 1.0, 0.0, 0.0);
	else
		HLVecSet(e->move_dir, 0.0, 1.0, 0.0);
}

F64 HLEntAxisDelta(CHLEntity *e, F64 *a, F64 *b)
{//CBaseToggle::AxisDelta - travel between two angle triples along the single
 //axis this entity turns about. All three would count the two static axes and
 //read a 359->1 wrap as 358 degrees
	if (e->move_dir[2] != 0.0)
		return a[2] - b[2];

	if (e->move_dir[0] != 0.0)
		return a[0] - b[0];

	return a[1] - b[1];
}

//--- sounds -----------------------------------------------------------------
//
// Brush entities carry a small integer, not a sound path; the game code maps it
// to a filename.
//
// Comparison chains rather than tables, for the reason given in
// HLEntModelForClass - adjacent-literal concatenation truncates at the first
// embedded NUL and the table collapses to one entry.

U8 *HLEntDoorMoveSound(I64 n)
{//CBaseDoor::m_bMoveSnd
	if (n == 1)		return "doors/doormove1.wav";
	if (n == 2)		return "doors/doormove2.wav";
	if (n == 3)		return "doors/doormove3.wav";
	if (n == 4)		return "doors/doormove4.wav";
	if (n == 5)		return "doors/doormove5.wav";
	if (n == 6)		return "doors/doormove6.wav";
	if (n == 7)		return "doors/doormove7.wav";
	if (n == 8)		return "doors/doormove8.wav";
	if (n == 9)		return "doors/doormove9.wav";
	if (n == 10)	return "doors/doormove10.wav";

	return NULL;	//0 is common/null.wav - deliberate silence
}

U8 *HLEntDoorStopSound(I64 n)
{//CBaseDoor::m_bStopSnd
	if (n == 1)		return "doors/doorstop1.wav";
	if (n == 2)		return "doors/doorstop2.wav";
	if (n == 3)		return "doors/doorstop3.wav";
	if (n == 4)		return "doors/doorstop4.wav";
	if (n == 5)		return "doors/doorstop5.wav";
	if (n == 6)		return "doors/doorstop6.wav";
	if (n == 7)		return "doors/doorstop7.wav";
	if (n == 8)		return "doors/doorstop8.wav";

	return NULL;
}

U8 *HLEntTrainSound(I64 n)
{//CFuncTrackTrain::m_sounds. the looping running noise, restarted while the
 //train moves and stopped when it parks
	if (n == 1)		return "plats/ttrain1.wav";
	if (n == 2)		return "plats/ttrain2.wav";
	if (n == 3)		return "plats/ttrain3.wav";
	if (n == 4)		return "plats/ttrain4.wav";
	if (n == 5)		return "plats/ttrain6.wav";
	if (n == 6)		return "plats/ttrain7.wav";

	return NULL;
}

U8 *HLEntButtonSound(I64 n)
{//ButtonSound. the full table runs to 40; these are the entries HL1's own maps
 //reference
	if (n == 1)		return "buttons/button1.wav";
	if (n == 2)		return "buttons/button2.wav";
	if (n == 3)		return "buttons/button3.wav";
	if (n == 4)		return "buttons/button4.wav";
	if (n == 5)		return "buttons/button5.wav";
	if (n == 6)		return "buttons/button6.wav";
	if (n == 7)		return "buttons/button7.wav";
	if (n == 8)		return "buttons/button8.wav";
	if (n == 9)		return "buttons/button9.wav";
	if (n == 10)	return "buttons/button10.wav";
	if (n == 11)	return "buttons/button11.wav";
	if (n == 12)	return "buttons/latchlocked1.wav";
	if (n == 13)	return "buttons/latchunlocked1.wav";
	if (n == 14)	return "buttons/lightswitch2.wav";
	if (n == 21)	return "buttons/lever1.wav";
	if (n == 22)	return "buttons/lever2.wav";
	if (n == 23)	return "buttons/lever3.wav";
	if (n == 24)	return "buttons/lever4.wav";
	if (n == 25)	return "buttons/lever5.wav";

	return NULL;
}

U0 HLEntSound(CHLEntity *e, U8 *path, I64 channel)
{//at the entity's own centre, so a door is heard where it is
	F64 centre[3];
	I64 i;

	if (!path || !path[0])
		return;

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	HLSndPlayAt(path, centre, e->volume, HLENT_SND_ATTEN, 0, channel);
}

//--- scheduling -------------------------------------------------------------

U0 HLEntSetThink(CHLEntity *e, I64 method, F64 at)
{//absolute time, matching pev->nextthink. 0 disarms
	e->think_fn   = method;
	e->next_think = at;
}

U0 HLEntCalcMove(CHLEntity *e, F64 *dest, F64 speed, I64 done_method)
{//SUB_CalcMove - constant velocity that arrives exactly on a think
 //
 //the arrival is scheduled, not detected: floating point never lands on the
 //destination exactly, and a "close enough" test drifts over a level's worth of
 //door cycles
	F64 delta[3];
	F64 length;
	F64 travel;

	HLVecCopy(dest, e->finaldest);
	e->move_done = done_method;

	if (speed <= 0.0)
		speed = 100.0;

	HLVecSub(dest, e->origin, delta);
	length = HLVecLength(delta);

	if (length < 0.0001)
	{
		//already there - still take the think, so the arrival handler runs
		//exactly once either way
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);
		HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + HLENT_MIN_MOVE_TIME);
		return;
	}

	travel = length / speed;
	if (travel < HLENT_MIN_MOVE_TIME)
		travel = HLENT_MIN_MOVE_TIME;

	e->velocity[0] = delta[0] / travel;
	e->velocity[1] = delta[1] / travel;
	e->velocity[2] = delta[2] / travel;

	e->moving_angular = FALSE;

	HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + travel);
}

U0 HLEntCalcAngleMove(CHLEntity *e, F64 *dest, F64 speed, I64 done_method)
{//CBaseToggle::AngularMove - SUB_CalcMove's twin, in degrees
 //
 //shares HLM_MOVE_DONE with the linear path; moving_angular tells the arrival
 //which of the two it is finishing, so an angular arrival does not snap the
 //origin to a stale linear finaldest
	F64 delta[3];
	F64 length;
	F64 travel;

	HLVecCopy(dest, e->finalangle);
	e->move_done      = done_method;
	e->moving_angular = TRUE;

	if (speed <= 0.0)
		speed = 100.0;

	HLVecSub(dest, e->angles, delta);
	length = HLVecLength(delta);

	if (length < 0.0001)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + HLENT_MIN_MOVE_TIME);
		return;
	}

	travel = length / speed;
	if (travel < HLENT_MIN_MOVE_TIME)
		travel = HLENT_MIN_MOVE_TIME;

	e->avelocity[0] = delta[0] / travel;
	e->avelocity[1] = delta[1] / travel;
	e->avelocity[2] = delta[2] / travel;

	HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + travel);
}

//--- master / multisource ---------------------------------------------------

Bool HLEntMasterAllows(CHLEntity *e)
{//UTIL_IsMasterTriggered. a locked door names a multisource; until every
 //input to that source is on, the door refuses to be used
	I64 m;

	if (!e->master[0])
		return TRUE;

	m = HLEntFindByTargetname(e->master, 0);
	if (m < 0)
		return TRUE;

	//CMultiSource::IsTriggered also gates on its global state: a cross-level
	//lock is satisfied by its inputs and by a flag set on an earlier map. Only
	//checked when the key is present
	if (hl_entities[m].global_state[0])
	{
		if (HLEntGlobalGet(hl_entities[m].global_state) != HLGLOBAL_ON)
			return FALSE;
	}

	//multisource state is kept in toggle_state: AT_TOP means satisfied
	return ToBool(hl_entities[m].toggle_state == HLTS_AT_TOP);
}

//--- the call queue ---------------------------------------------------------
//
// HLEntCallMethod is defined at the bottom, after every implementation it
// dispatches, so code above it cannot call it. A forward declaration is not an
// option: see the note at the top of HLPhys.ZC - routing a call through one
// miscompiles.
//
// Callers above queue the method instead, and the frame driver drains the queue.
// This also bounds a target loop: two multi_managers naming each other would
// otherwise recurse until the stack ran out.

#define HLENT_CALLQ_MAX		256
#define HLENT_CALLQ_BUDGET	4096	//dispatches allowed per drain

class CHLEntCall
{
	I64	ent;
	I64	method;
	I64	activator;
	I64	use_type;
	F64	value;
};

CHLEntCall	hl_ent_callq[HLENT_CALLQ_MAX];
I64			hl_ent_callq_head = 0;
I64			hl_ent_callq_tail = 0;
I64			hl_ent_callq_lost = 0;

U0 HLEntQueueCall(I64 ent, I64 method, I64 activator, I64 use_type, F64 value)
{
	I64 next = (hl_ent_callq_tail + 1) % HLENT_CALLQ_MAX;

	if (method == HLM_NONE)
		return;

	if (next == hl_ent_callq_head)
	{
		//full - drop rather than overwrite an unread entry. reported a few
		//times so a runaway chain is visible
		if (hl_ent_callq_lost < 4)
			"HLEnt: call queue full, dropping method %d\n", method;

		hl_ent_callq_lost++;
		return;
	}

	hl_ent_callq[hl_ent_callq_tail].ent       = ent;
	hl_ent_callq[hl_ent_callq_tail].method    = method;
	hl_ent_callq[hl_ent_callq_tail].activator = activator;
	hl_ent_callq[hl_ent_callq_tail].use_type  = use_type;
	hl_ent_callq[hl_ent_callq_tail].value     = value;

	hl_ent_callq_tail = next;
}

U0 HLEntFireTargets(I64 self, I64 activator, I64 use_type, F64 value)
{//SUB_UseTargets - fire everything sharing this entity's target name, and
 //remove everything sharing its killtarget
	CHLEntity	*e = HLEntGet(self);
	I64			 t;

	if (!e)
		return;

	if (e->killtarget[0])
	{
		t = HLEntFindByTargetname(e->killtarget, 0);

		while (t >= 0)
		{
			hl_entities[t].in_use     = FALSE;
			hl_entities[t].solid      = HLSOLID_NOT;
			hl_entities[t].think_fn   = HLM_NONE;
			hl_entities[t].next_think = 0.0;

			t = HLEntFindByTargetname(e->killtarget, t + 1);
		}
	}

	if (!e->target[0])
		return;

	t = HLEntFindByTargetname(e->target, 0);

	while (t >= 0)
	{
		//an entity must not fire itself; the recursion never ends
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, use_type,
				value);
		}

		t = HLEntFindByTargetname(e->target, t + 1);
	}
}

U0 HLEntFireTargetsNamed(U8 *name, I64 self, I64 activator, I64 use_type,
	F64 value)
{//FireTargets: fire by name, with no firing entity's target field involved.
 //A path_track's pass-fire and a multi_manager's per-key fire both need this.
	I64 t;

	if (!name || !name[0])
		return;

	t = HLEntFindByTargetname(name, 0);

	while (t >= 0)
	{
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, use_type,
				value);
		}

		t = HLEntFindByTargetname(name, t + 1);
	}
}

U0 HLEntUseTargets(I64 self, I64 activator, I64 use_type = HLUSE_TOGGLE,
	F64 value = 0.0)
{//the delay key defers the fire. HL spawns a DelayedUse entity for this; here
 //the delay rides on the firing entity's own think, which is equivalent unless
 //something re-fires inside the window
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->delay > 0.0)
	{
		//a fire already pending keeps its own time. HL owns each deferred fire
		//on its own DelayedUse entity, so a second use inside the window is a
		//second fire; here the two share one think, and rescheduling would
		//push the first one out by another delay every time something used
		//this entity again
		if (e->think_fn == HLM_FIRE_TARGETS && e->next_think > hl_ent_time)
			return;

		e->activator = activator;
		HLEntSetThink(e, HLM_FIRE_TARGETS, hl_ent_time + e->delay);
		return;
	}

	HLEntFireTargets(self, activator, use_type, value);
}

//--- door groups ------------------------------------------------------------
//
// CBaseDoor::Blocked walks "all door pieces with the same targetname". That is
// the whole of GoldSrc's door linking: Quake's LinkDoors, which fused doors by
// touching brushes, is not in the HL SDK. A named pair already moves together
// through SUB_UseTargets, which fires every entity holding the name.
//
// The direct player paths are what needs the group. HL reaches a two leaf door
// by touch, and the player's box straddles the seam so both leaves run
// DoorTouch. HLEntUseInFront fires one entity and stops, so the near leaf opens
// alone.
//
// An unnamed pair has no name to group on and falls back to the brush test,
// which is safe only between two unnamed doors. c0a0b rests a func_door named
// "doors" against a func_door_rotating named "lockdoor"; linking those would
// throw the lock open with the lift.

#define HLDOOR_LINK_SLOP	1.0		//LinkDoors' tolerance

Bool HLEntIsDoor(CHLEntity *e)
{//func_door, func_water and func_door_rotating - the classes CBaseDoor::Blocked
 //accepts. momentary_door carries HLC_DOOR and func_plat carries the door
 //methods; neither is a leaf of anything, and the pair of tests excludes both
	if (!e)
		return FALSE;

	if (e->ent_class != HLC_DOOR)
		return FALSE;

	return ToBool(e->use_fn == HLM_DOOR_USE || e->use_fn == HLM_ROT_DOOR_USE);
}

Bool HLEntDoorsTouch(CHLEntity *a, CHLEntity *b)
{//LinkDoors' box test, over the bounds HLEntSetAbsBox already maintains
	I64 i;

	for (i = 0; i < 3; i++)
	{
		if (a->absmin[i] > b->absmax[i] + HLDOOR_LINK_SLOP)
			return FALSE;

		if (b->absmin[i] > a->absmax[i] + HLDOOR_LINK_SLOP)
			return FALSE;
	}

	return TRUE;
}

I64 HLDoorGroupNext(I64 self, I64 start)
{//next leaf of self's group, -1 when the group ends
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	I64			 i;

	if (!HLEntIsDoor(e))
		return -1;

	for (i = start; i < hl_num_entities; i++)
	{
		if (i == self)
			goto qdgn_next;

		o = HLEntGet(i);
		if (!HLEntIsDoor(o))
			goto qdgn_next;

		//a named door groups by name and by nothing else
		if (e->targetname[0])
		{
			if (!StrICompare(o->targetname, e->targetname))
				return i;

			goto qdgn_next;
		}

		if (!o->targetname[0] && HLEntDoorsTouch(e, o))
			return i;

qdgn_next:
	}

	return -1;
}

//--- doors ------------------------------------------------------------------
//
// func_door. SF_DOOR_START_OPEN swaps the two positions at spawn rather than
// running the mover, so everything below still thinks it opens "up"

#define HLSF_DOOR_START_OPEN		1
#define HLSF_DOOR_PASSABLE		8
#define HLSF_DOOR_TOGGLE			32
#define HLSF_DOOR_USE_ONLY		256
#define HLSF_DOOR_TOUCH_OPENS	0		//the default when USE_ONLY is clear

U0 HLDoorGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//already moving or open - a second use is dropped
	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_AT_TOP)
		return;

	e->toggle_state = HLTS_GOING_UP;
	e->activator    = activator;

	HLEntSound(e, HLEntDoorMoveSound(e->move_snd), HLENT_CHAN_MOVE);

	HLEntCalcMove(e, e->position2, e->speed, HLM_DOOR_HIT_TOP);
}

U0 HLDoorGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	HLEntSound(e, HLEntDoorMoveSound(e->move_snd), HLENT_CHAN_MOVE);

	HLEntCalcMove(e, e->position1, e->speed, HLM_DOOR_HIT_BOTTOM);
}

U0 HLDoorHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	HLEntSound(e, HLEntDoorStopSound(e->stop_snd), HLENT_CHAN_MOVE);

	//SF_DOOR_TOGGLE and a negative wait both mean "stay open"
	if (e->spawnflags & HLSF_DOOR_TOGGLE)
		goto qdht_fire;

	if (e->wait < 0.0)
		goto qdht_fire;

	HLEntSetThink(e, HLM_DOOR_GO_DOWN, hl_ent_time + e->wait);

qdht_fire:
	//the door's own target fires on open, not on close
	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);
}

U0 HLDoorHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;

	HLEntSound(e, HLEntDoorStopSound(e->stop_snd), HLENT_CHAN_MOVE);
}

U0 HLDoorUseLeaf(I64 self, I64 activator)
{//CBaseDoor::DoorActivate on one leaf, with no group fan out
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	if (e->toggle_state == HLTS_AT_TOP || e->toggle_state == HLTS_GOING_UP)
	{
		//only a TOGGLE door closes on a second use; a normal one is on its
		//wait timer
		if (e->spawnflags & HLSF_DOOR_TOGGLE)
			HLDoorGoDown(self);

		return;
	}

	HLDoorGoUp(self, activator);
}

U0 HLDoorUse(I64 self, I64 activator)
{//CBaseDoor::Use, over every leaf of the group
	I64 peer = HLDoorGroupNext(self, 0);

	HLDoorUseLeaf(self, activator);

	//queued rather than called: a peer may be a func_door_rotating, whose mover
	//is defined further down this file. HLM_DOOR_LEAF does not fan out again,
	//so a group of any size costs one round
	while (peer >= 0)
	{
		HLEntQueueCall(peer, HLM_DOOR_LEAF, activator, HLUSE_TOGGLE, 0.0);
		peer = HLDoorGroupNext(self, peer + 1);
	}
}

//--- buttons ----------------------------------------------------------------

#define HLSF_BUTTON_DONT_MOVE	1
#define HLSF_BUTTON_TOGGLE		32
#define HLSF_BUTTON_TOUCH_ONLY	256

U0 HLButtonHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);

	//a negative wait latches the button down permanently
	if (e->wait < 0.0)
		return;

	if (e->spawnflags & HLSF_BUTTON_TOGGLE)
		return;

	HLEntSetThink(e, HLM_BUTTON_RETURN, hl_ent_time + e->wait);
}

U0 HLButtonHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;
}

U0 HLButtonGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->activator    = activator;
	e->toggle_state = HLTS_GOING_UP;

	HLEntSound(e, HLEntButtonSound(e->snd_index), HLENT_CHAN_USE);

	//SF_BUTTON_DONT_MOVE makes the button a pure trigger surface
	if (e->spawnflags & HLSF_BUTTON_DONT_MOVE)
	{
		HLButtonHitTop(self);
		return;
	}

	HLEntCalcMove(e, e->position2, e->speed, HLM_BUTTON_HIT_TOP);
}

U0 HLButtonGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	if (e->spawnflags & HLSF_BUTTON_DONT_MOVE)
	{
		HLButtonHitBottom(self);
		return;
	}

	HLEntCalcMove(e, e->position1, e->speed, HLM_BUTTON_HIT_BOTTOM);
}

U0 HLButtonUse(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_GOING_DOWN)
		return;

	if (e->toggle_state == HLTS_AT_TOP)
	{
		if (e->spawnflags & HLSF_BUTTON_TOGGLE)
			HLButtonGoDown(self);

		return;
	}

	HLButtonGoUp(self, activator);
}

//--- trains -----------------------------------------------------------------
//
// func_train walks a chain of path_corner entities. c0a0's tram is a
// func_tracktrain on path_track: the same corner walk, plus orientation.

//func_train's flags
#define HLSF_TRAIN_WAIT_RETRIGGER	1
#define HLSF_TRAIN_START_ON			4

//func_tracktrain reassigns the same bits: bit 2 is FORWARDONLY, not START_ON.
//Reading a tracktrain's spawnflags with the func_train table starts trams that
//should be waiting for a script
#define HLSF_TRACKTRAIN_NOPITCH		1
#define HLSF_TRACKTRAIN_NOCONTROL	2
#define HLSF_TRACKTRAIN_FORWARDONLY	4
#define HLSF_TRACKTRAIN_PASSABLE	8

//CFuncTrackTrain holds its running noise open on CHAN_STATIC and stops it when
//the train parks. Restarting it at every path_track, which is what calling
//HLEntSound per node does, gives one clipped hit per node instead of a loop.
I64 hl_train_voice[HLENT_MAX];

Bool hl_train_voice_valid = FALSE;

U0 HLTrainVoiceReset()
{//S_StopAllSounds' share of this file: a looping voice is never released by the
 //mixer on its own, so a train still moving when the level ends keeps its noise
 //running under the next map. Only stop handles from a previous map - on the
 //very first call the array is uninitialised garbage.
	I64 i;

	for (i = 0; i < HLENT_MAX; i++)
	{
		if (hl_train_voice_valid && hl_train_voice[i] >= 0)
			AudioSFXStop(hl_train_voice[i]);

		hl_train_voice[i] = -1;
	}

	hl_train_voice_valid = TRUE;
}

U0 HLTrainVoiceStop(I64 self)
{
	if (self < 0 || self >= HLENT_MAX)
		return;

	if (hl_train_voice[self] >= 0)
	{
		AudioSFXStop(hl_train_voice[self]);
		hl_train_voice[self] = -1;
	}
}

U0 HLTrainVoiceStart(I64 self, CHLEntity *e)
{//Held open while the train moves. Volume only is re-aimed; the phase is never
 //reset, so there is no seam at a node.
	CHLSound	*snd;
	U8			*path;
	F64			 dist;
	F64			 rel[3];
	I64			 vol;
	I64			 i;

	if (self < 0 || self >= HLENT_MAX)
		return;

	path = HLEntTrainSound(e->snd_index);

	if (!path)
		return;

	//Attenuated by distance from the listener, as a positional loop would be.
	//The mixer has no loop panning, so both ears match.
	for (i = 0; i < 3; i++)
		rel[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5 -
					hl_snd_listener[i];

	dist = HLVecLength(rel);
	vol  = ToI64((1.0 - dist / 1500.0) * e->volume * hl_snd_master *
			ToF64(AUDIO_VOL_UNITY));

	if (vol < 1)
	{
		HLTrainVoiceStop(self);
		return;
	}

	if (hl_train_voice[self] >= 0 && AudioSFXPlaying(hl_train_voice[self]))
	{
		AudioSFXVoiceVolSet(hl_train_voice[self], vol, vol);
		return;
	}

	snd = HLSndLoad(path);

	if (!snd || !snd->frames || snd->count < 1)
		return;

	hl_train_voice[self] = AudioSFXPlayRef(snd->frames, snd->count, snd->rate,
							vol, vol, TRUE);
}

U0 HLTrainNext(I64 self)
{//the train has arrived at its current corner: fire that corner's target,
 //then head for the next one
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*corner;
	F64			 dest[3];
	F64			 delta[3];
	F64			 was;
	F64			 dyaw;
	I64			 next;

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	next = HLEntFindByTargetname(e->target, 0);

	if (next < 0)
	{
		//broken path - stop rather than spin looking for it every frame
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	corner = &hl_entities[next];

	//A node's pass-fire is its `message` key, not its `target`: `target` names
	//the next node. c0a0's whole intro hangs off this - trainstop8 opens the
	//room2 door, trainstop9 runs the scientist script, trainstop11 fades out.
	if (corner->message[0])
		HLEntFireTargetsNamed(corner->message, next, self, HLUSE_TOGGLE, 0.0);

	//the corner's own target names the next corner
	HLStrCopy(e->target, corner->target, 64);

	//a corner's speed overrides the train's for the leg leaving it
	if (corner->speed > 0.0)
		e->speed = corner->speed;

	//where the train parks relative to the node differs by class:
	//
	//  func_train      the node marks where the brush's mins corner goes, so
	//                  the origin is offset by it
	//  func_tracktrain the node is where the origin goes: the brush is modelled
	//                  around it and rotates there
	if (e->ent_class == HLC_TRACKTRAIN)
		HLVecCopy(corner->origin, dest);
	else
	{
		dest[0] = corner->origin[0] - e->mins[0];
		dest[1] = corner->origin[1] - e->mins[1];
		dest[2] = corner->origin[2] - e->mins[2];
	}

	HLTrainVoiceStart(self, e);

	//CFuncTrackTrain::Next orientation. HL looks m_length units ahead along the
	//track spline; the direction of the leg being entered is the same vector
	//wherever the leg is straight, which every shipped path_track run is
	//between nodes.
	//
	//The 180 is Valve's: tracktrain brushwork is modelled facing west, so the
	//yaw derived from the direction of travel is a half turn out.
	//
	//func_train does not turn. Its yaw is bookkeeping only and it is not
	//registered with HLClipSetRotating, so writing it would rotate nothing but
	//would still be a lie.
	HLVecSub(dest, e->origin, delta);

	if (e->ent_class == HLC_TRACKTRAIN &&
		(!HLIsZeroF(delta[0]) || !HLIsZeroF(delta[1])))
	{
		was = e->angles[1];

		e->angles[1] = Arg(delta[0], delta[1]) / HLDEG2RAD + 180.0;

		while (e->angles[1] >= 360.0)
			e->angles[1] -= 360.0;
		while (e->angles[1] < 0.0)
			e->angles[1] += 360.0;

		//Shortest way round, or a car turning from 350 to 10 degrees swings its
		//passenger 340 degrees the wrong way.
		dyaw = e->angles[1] - was;

		while (dyaw > 180.0)
			dyaw -= 360.0;
		while (dyaw < -180.0)
			dyaw += 360.0;

		//Banked rather than applied here: HLEntPlayerRides is defined with the
		//mover pass and cannot be called from this far up the file.
		e->yaw_delta += dyaw;
	}

	//"m_flWait = pTarg->GetDelay()", plats.cpp:775, where CPathCorner::GetDelay
	//returns its own wait key (cbase.h:548). Carried on the train because Wait
	//runs a move later, by which time the corner is no longer resolvable
	e->wait = corner->wait;

	if (corner->wait > 0.0)
	{
		//pause at this corner before leaving
		HLEntCalcMove(e, dest, e->speed, HLM_TRAIN_WAIT);
		return;
	}

	HLEntCalcMove(e, dest, e->speed, HLM_TRAIN_NEXT);
}

U0 HLTrainWait(I64 self)
{//CFuncTrain::Wait, plats.cpp:728. Parked at a corner - resume after its wait
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	//HLTrainNext stored the arrived-at corner's wait here. A zero means
	//"Next() right now"; the entity clock cannot dispatch at exactly now, so
	//the next think does it
	HLEntSetThink(e, HLM_TRAIN_NEXT, hl_ent_time + e->wait);
}

U0 HLTrainUse(I64 self)
{//a stopped train starts, a moving one stops
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->think_fn != HLM_NONE)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);
		return;
	}

	HLTrainNext(self);
}

//--- triggers ---------------------------------------------------------------

#define HLSF_TRIGGER_MONSTERS	1
#define HLSF_TRIGGER_NO_CLIENTS	2

//CAutoTrigger. Without it the trigger stays in the world after firing, which
//costs nothing: its think is disarmed and it has no touch and no use
#define HLSF_AUTO_FIREONCE		1

Bool HLTriggerCanFire(CHLEntity *e)
{
	if (!HLEntMasterAllows(e))
		return FALSE;

	//pain_finished doubles as the debounce clock here - a brush trigger is
	//touched every frame the player stands in it
	if (e->pain_finished > hl_ent_time)
		return FALSE;

	return TRUE;
}

U0 HLTriggerTouch(I64 self, I64 other)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLTriggerCanFire(e))
		return;

	e->pain_finished = hl_ent_time + HLENT_TRIGGER_DEBOUNCE;

	HLEntUseTargets(self, other, HLUSE_TOGGLE, 0.0);

	//trigger_once removes itself. wait < 0 means the same for a multiple
	if (e->wait < 0.0)
	{
		//solid immediately, so a second touch this tick does nothing, but the
		//slot stays in use until any deferred fire has run - see HLM_AUTO_THINK
		e->solid = HLSOLID_NOT;

		if (e->think_fn == HLM_FIRE_TARGETS)
			e->remove_after_fire = TRUE;
		else
			e->in_use = FALSE;

		return;
	}

	if (e->wait > 0.0)
		e->pain_finished = hl_ent_time + e->wait;
}

U0 HLTriggerUse(I64 self, I64 activator)
{//trigger_relay and anything else fired rather than touched
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	HLEntUseTargets(self, activator, HLUSE_TOGGLE, 0.0);
}

U0 HLTriggerToggleUse(I64 self)
{//CBaseTrigger::ToggleUse, dlls/triggers.cpp:897. Flips the volume between
 //SOLID_TRIGGER and SOLID_NOT rather than firing anything
 //
 //force_retouch has no analogue here: the touch pass tests overlap every frame
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->solid == HLSOLID_NOT)
		e->solid = HLSOLID_TRIGGER;
	else
		e->solid = HLSOLID_NOT;

	HLEntSetAbsBox(e);
}

//--- multi_manager ----------------------------------------------------------
//
// fires N named targets, each at its own offset, off one use. the offsets are
// key/values whose keys are the target names, so the generic key parser cannot
// pick them up and they are re-scanned here

I64 HLMMFind(I64 ent)
{
	I64 i;

	for (i = 0; i < hl_mm_count; i++)
	{
		if (hl_mm[i].ent == ent)
			return i;
	}

	return -1;
}

U0 HLMMUse(I64 self, I64 activator)
{
	CHLEntity	*e = HLEntGet(self);
	I64			 m;

	if (!e)
		return;

	m = HLMMFind(self);
	if (m < 0)
		return;

	//re-triggering mid-cycle restarts it, matching CMultiManager::Use with
	//no SF_MULTIMAN_THREAD
	hl_mm[m].fired   = 0;
	hl_mm[m].started = hl_ent_time;
	e->activator     = activator;

	HLEntSetThink(e, HLM_MULTI_MANAGER_TICK, hl_ent_time);
}

U0 HLMMTick(I64 self)
{//walk the schedule, firing everything whose offset has come due
	CHLEntity	*e = HLEntGet(self);
	I64			 m;
	I64			 t;
	F64			 elapsed;
	F64			 soonest = -1.0;
	I64			 i;

	if (!e)
		return;

	m = HLMMFind(self);
	if (m < 0)
		return;

	elapsed = hl_ent_time - hl_mm[m].started;

	for (i = 0; i < hl_mm[m].count; i++)
	{
		if (hl_mm[m].fired & (1 << i))
			goto qmmt_next;

		if (hl_mm[m].delay[i] > elapsed)
		{
			//track the next one due so the think can be scheduled exactly
			if (soonest < 0.0 || hl_mm[m].delay[i] < soonest)
				soonest = hl_mm[m].delay[i];

			goto qmmt_next;
		}

		hl_mm[m].fired |= 1 << i;

		t = HLEntFindByTargetname(&hl_mm[m].name[i * 64], 0);

		while (t >= 0)
		{
			if (t != self && hl_entities[t].use_fn)
			{
				hl_entities[t].activator = e->activator;
				HLEntQueueCall(t, hl_entities[t].use_fn, e->activator,
					HLUSE_TOGGLE, 0.0);
			}

			t = HLEntFindByTargetname(&hl_mm[m].name[i * 64], t + 1);
		}

qmmt_next:
	}

	if (soonest < 0.0)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	HLEntSetThink(e, HLM_MULTI_MANAGER_TICK,
		hl_mm[m].started + soonest);
}

//--- lights -----------------------------------------------------------------

U0 HLLightUse(I64 self, I64 use_type)
{//a switchable light toggles its style between "on" and "off" patterns
	CHLEntity *e = HLEntGet(self);
	Bool	   on;

	if (!e || e->style < 32)
		return;

	on = ToBool(e->toggle_state == HLTS_AT_TOP);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;
	else
		on = !on;

	if (on)
	{
		HLLightStyleSet(e->style, "m");
		e->toggle_state = HLTS_AT_TOP;
	}
	else
	{
		HLLightStyleSet(e->style, "a");
		e->toggle_state = HLTS_AT_BOTTOM;
	}
}

//--- breakable materials ----------------------------------------------------
//
// CBreakable::m_Material, func_break.h:19. The "material" key selects the shard
// noise on a hit, the burst on the break and the debris model.
//
// Shipped single-player and deathmatch maps: 759+207 wood, 542+77 metal,
// 251+21 glass, 173+1 ceiling tile, 104 cinder block, 89 rocks, 80+1 computer,
// 75+2 flesh, 26 unbreakable glass, 26 with no key at all.

#define HLMAT_GLASS			0
#define HLMAT_WOOD			1
#define HLMAT_METAL			2
#define HLMAT_FLESH			3
#define HLMAT_CINDERBLOCK	4
#define HLMAT_CEILINGTILE	5
#define HLMAT_COMPUTER		6
#define HLMAT_UNBREAKGLASS	7
#define HLMAT_ROCKS			8
#define HLMAT_NONE			9

Bool HLEntMatBreakable(I64 mat)
{//CBreakable::IsBreakable, func_break.cpp:762
	return ToBool(mat != HLMAT_UNBREAKGLASS);
}

U8 *HLEntMatShardSound(I64 mat)
{//CBreakable::DamageSound, func_break.cpp:380-430. One of the material's list,
 //played on a hit that does not kill the brush.
 //
 //A comparison chain, not a table: adjacent-literal concatenation truncates at
 //the first embedded NUL - see HLEntModelForClass.
	I64 n;

	//"if (material == matComputer && RANDOM_LONG(0,1)) material = matMetal",
	//func_break.cpp:395 - half a computer's hits sound like metal
	if (mat == HLMAT_COMPUTER && HLFxRandI(0, 1) != 0)
		mat = HLMAT_METAL;

	if (mat == HLMAT_GLASS || mat == HLMAT_UNBREAKGLASS ||
		mat == HLMAT_COMPUTER)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/glass1.wav";
		if (n == 2)	return "debris/glass2.wav";
		return "debris/glass3.wav";
	}

	if (mat == HLMAT_WOOD)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/wood1.wav";
		if (n == 2)	return "debris/wood2.wav";
		return "debris/wood3.wav";
	}

	if (mat == HLMAT_METAL)
	{
		//the SDK fills three slots and then picks over two, func_break.cpp:412
		//- metal2.wav is unreachable. Reproduced as written
		n = HLFxRandI(1, 2);
		if (n == 1)	return "debris/metal1.wav";
		return "debris/metal3.wav";
	}

	if (mat == HLMAT_FLESH)
	{
		n = HLFxRandI(1, 6);
		if (n == 1)	return "debris/flesh1.wav";
		if (n == 2)	return "debris/flesh2.wav";
		if (n == 3)	return "debris/flesh3.wav";
		if (n == 4)	return "debris/flesh5.wav";
		if (n == 5)	return "debris/flesh6.wav";
		return "debris/flesh7.wav";
	}

	if (mat == HLMAT_ROCKS || mat == HLMAT_CINDERBLOCK)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/concrete1.wav";
		if (n == 2)	return "debris/concrete2.wav";
		return "debris/concrete3.wav";
	}

	//matCeilingTile and matNone have no shard list
	return NULL;
}

U8 *HLEntMatBreakSound(I64 mat)
{//CBreakable::Die's material switch, func_break.cpp:601-676
	if (mat == HLMAT_GLASS)
	{
		if (HLFxRandI(0, 1))	return "debris/bustglass2.wav";
		return "debris/bustglass1.wav";
	}

	if (mat == HLMAT_WOOD)
	{
		if (HLFxRandI(0, 1))	return "debris/bustcrate2.wav";
		return "debris/bustcrate1.wav";
	}

	if (mat == HLMAT_METAL || mat == HLMAT_COMPUTER)
	{
		if (HLFxRandI(0, 1))	return "debris/bustmetal2.wav";
		return "debris/bustmetal1.wav";
	}

	if (mat == HLMAT_FLESH)
	{
		if (HLFxRandI(0, 1))	return "debris/bustflesh2.wav";
		return "debris/bustflesh1.wav";
	}

	if (mat == HLMAT_ROCKS || mat == HLMAT_CINDERBLOCK)
	{
		if (HLFxRandI(0, 1))	return "debris/bustconcrete2.wav";
		return "debris/bustconcrete1.wav";
	}

	if (mat == HLMAT_CEILINGTILE)
		return "debris/bustceiling.wav";

	//matUnbreakableGlass and matNone fall out of the switch silent
	return NULL;
}

U0 HLEntSoundDyn(I64 self, U8 *path, I64 channel, F64 volume, I64 pitch)
{//EMIT_SOUND_DYN at the entity's own centre - HLEntSound with the volume and
 //pitch the break path varies, and on the brush's own channel rather than the
 //world's. entnum is index+1, the convention HLAI.ZC's speech uses
	CHLEntity	*e = HLEntGet(self);
	F64			 centre[3];
	I64			 i;

	if (!e || !path || !path[0])
		return;

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	HLSndPlayAt(path, centre, volume, HLENT_SND_ATTEN, self + 1, channel,
		pitch);
}

Bool HLEntIsBreakableBrush(CHLEntity *e)
{//HLBreakableDie is the death path for monsters as well - see the note at the
 //head of HLAI.ZC - and only the brush classes take material treatment
	if (!StrCompare(e->classname, "func_breakable"))
		return TRUE;

	return ToBool(!StrCompare(e->classname, "func_pushable"));
}

//--- damage -----------------------------------------------------------------
//
// CBaseEntity::TakeDamage, reduced to what the brush entities need. Monsters
// and the player go through their own paths.

#define HLDMG_TAKE_NO		0
#define HLDMG_TAKE_YES		1
#define HLDMG_TAKE_AIM		2	//only a direct hit, not splash

U0 HLEntTakeDamageType(I64 self, I64 attacker, F64 damage, I64 bits)
{//health down, and the Killed path once it runs out. bits is a HLDMG_* mask;
 //CBreakable::TakeDamage scales by it, func_break.cpp:551-559
	CHLEntity	*e = HLEntGet(self);
	Bool		 brush;
	I64			 pitch;

	if (!e || damage <= 0.0)
		return;

	if (e->takedamage == HLDMG_TAKE_NO)
		return;

	brush = HLEntIsBreakableBrush(e);

	if (brush)
	{
		//unbreakable glass absorbs everything, func_break.cpp:550
		if (!HLEntMatBreakable(e->material))
			return;

		//"Breakables take double damage from the crowbar", func_break.cpp:554
		if (bits & HLDMG_CLUB)
			damage *= 2.0;

		//a crossbow dart's poison counts for a tenth, func_break.cpp:558
		if (bits & HLDMG_POISON)
			damage *= 0.1;
	}

	e->health -= damage;

	if (e->health > 0.0)
	{
		//"Make a shard noise each time func breakable is hit", func_break.cpp:572
		if (brush)
		{
			//func_break.cpp:385-390: two hits in three at the recorded rate,
			//the third somewhere in 95..129
			pitch = HLPITCH_NORM;
			if (HLFxRandI(0, 2) == 0)
				pitch = 95 + HLFxRandI(0, 34);

			HLEntSoundDyn(self, HLEntMatShardSound(e->material),
				HLENT_CHAN_VOICE, HLFxRandF(0.75, 1.0), pitch);
		}

		return;
	}

	//dead. the break is queued rather than run here so a chain of breakables
	//taking splash damage cannot recurse
	e->health    = 0.0;
	e->activator = attacker;

	HLEntQueueCall(self, HLM_BREAK_DIE, attacker, HLUSE_TOGGLE, 0.0);
}

U0 HLEntTakeDamage(I64 self, I64 attacker, F64 damage)
{//untyped damage. Callers that know the weapon use HLEntTakeDamageType
	HLEntTakeDamageType(self, attacker, damage, HLDMG_GENERIC);
}

U0 HLBreakableDie(I64 self)
{//CBreakable::Die - the material burst, then fire the target and stop existing
 //
 //Debris models are absent: the gib pool in HLPart.ZC carries one model bit
 //(hgibs/agibs) and has no slot for woodgibs.mdl and its siblings
	CHLEntity	*e = HLEntGet(self);
	F64			 fvol;
	I64			 pitch;

	if (!e)
		return;

	if (HLEntIsBreakableBrush(e))
	{
		//func_break.cpp:588-590. 95..124, snapped to 100 across the middle
		pitch = 95 + HLFxRandI(0, 29);
		if (pitch > 97 && pitch < 103)
			pitch = 100;

		//"The more negative pev->health, the louder", func_break.cpp:598.
		//health is clamped to zero before the break is queued, so overkill no
		//longer reaches here and this is the 0.85..1.0 base alone
		fvol = HLFxRandF(0.85, 1.0);

		HLEntSoundDyn(self, HLEntMatBreakSound(e->material), HLENT_CHAN_VOICE,
			fvol, pitch);
	}
	else
		HLEntSound(e, HLEntDoorStopSound(e->stop_snd), HLENT_CHAN_MOVE);

	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);

	e->solid = HLSOLID_NOT;

	//a breakable with a delay key deferred its fire onto its own think, so the
	//slot has to outlive the break - see HLM_AUTO_THINK
	if (e->think_fn == HLM_FIRE_TARGETS)
	{
		e->remove_after_fire = TRUE;
		return;
	}

	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

//--- trigger effects --------------------------------------------------------
//
// The effect on whatever touched the volume, beyond firing its target.

//CBaseTrigger::HurtTouch spawnflags, dlls/triggers.cpp:32-36. START_OFF is
//consumed by the spawn, the rest are read on touch
#define HLSF_HURT_TARGETONCE		1
#define HLSF_HURT_START_OFF		2
#define HLSF_HURT_NO_CLIENTS		8
#define HLSF_HURT_CLIENTONLYFIRE	16
#define HLSF_HURT_CLIENTONLYTOUCH	32

U0 HLHurtTouch(I64 self, I64 other)
{//CBaseTrigger::HurtTouch, dlls/triggers.cpp:914. The player is the only
 //toucher this port routes here, so the CLIENTONLYTOUCH and multiplayer
 //per-player masks collapse away and NO_CLIENTS means "never fires"
	CHLEntity	*e = HLEntGet(self);
	F64			 dmg;

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	//SF_TRIGGER_HURT_NO_CLIENTS, dlls/triggers.cpp:927
	if (e->spawnflags & HLSF_HURT_NO_CLIENTS)
		return;

	if (e->pain_finished > hl_ent_time)
		return;

	e->pain_finished = hl_ent_time + 0.5;

	//"fldmg = pev->dmg * 0.5; // 0.5 seconds worth of damage, pev->dmg is
	//damage/second", dlls/triggers.cpp:1001. The dmg key is a rate per second
	//and the trigger fires twice a second, so the half is not optional.
	//
	//The damagetype switch below that line is #if 0 in the shipped SDK, so
	//radiation and poison volumes deal their plain dmg rate like any other.
	dmg = e->dmg * 0.5;

	//a negative dmg heals - TakeHealth(-fldmg), dlls/triggers.cpp:1015
	if (dmg < 0.0)
	{
		hl_ent_player_health -= dmg;

		if (hl_ent_player_health > 100.0)
			hl_ent_player_health = 100.0;
	}
	else
		HLEntHurtPlayer(dmg);

	if (!e->target[0])
		return;

	//SF_TRIGGER_HURT_CLIENTONLYFIRE gates the target on the toucher being a
	//client; the player is the only toucher here, so it never blocks
	HLEntUseTargets(self, other, HLUSE_TOGGLE, 0.0);

	//SF_TRIGGER_HURT_TARGETONCE clears pev->target, dlls/triggers.cpp:1042
	if (e->spawnflags & HLSF_HURT_TARGETONCE)
		e->target[0] = 0;
}

U0 HLPushTouch(I64 self)
{//trigger_push. speed along the movedir, added to the toucher's velocity
 //rather than replacing it, so a conveyor and a jump compose
	CHLEntity *e = HLEntGet(self);
	F64		   speed;
	I64		   i;

	if (!e)
		return;

	speed = e->speed;
	if (speed == 0.0)
		speed = 100.0;

	for (i = 0; i < 3; i++)
		hl_ent_push_vel[i] = e->move_dir[i] * speed;

	hl_ent_push_pending = TRUE;
}

U0 HLTeleportTouch(I64 self)
{//trigger_teleport. the destination is an info_teleport_destination named by
 //the trigger's target, so this consumes the target rather than firing it
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*dst;
	I64			 t;

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	t = HLEntFindByTargetname(e->target, 0);
	if (t < 0)
		return;

	dst = &hl_entities[t];

	HLVecCopy(dst->origin, hl_ent_teleport_to);

	//HL drops the player to the destination's feet plus one unit of clearance
	hl_ent_teleport_to[2] -= HLPHYS_MINS_Z;
	hl_ent_teleport_to[2] += 1.0;

	hl_ent_teleport_pending = TRUE;
}

//--- rotating doors ---------------------------------------------------------
//
// CRotDoor. A func_door whose travel is in degrees about one axis instead of
// along a vector: the state machine below is HLDoor* with HLEntCalcMove swapped
// for HLEntCalcAngleMove.
//
// A separate set of methods rather than a flag inside the linear ones, because
// the arrival snaps angles; a wrong branch there snaps the origin to a stale
// finaldest instead.
//
// The axis spawnflag bits are the door's, 64 and 128, not func_rotating's 4 and
// 8. Sharing one table starts every door on the wrong axis.
#define HLSF_DOOR_ROTATE_BACKWARDS	2
#define HLSF_DOOR_ROTATE_Z			64		//roll, turns about world X
#define HLSF_DOOR_ROTATE_X			128		//pitch, turns about world Y

U0 HLRotDoorGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_AT_TOP)
		return;

	e->toggle_state = HLTS_GOING_UP;
	e->activator    = activator;

	HLEntSound(e, HLEntDoorMoveSound(e->move_snd), HLENT_CHAN_MOVE);

	HLEntCalcAngleMove(e, e->angle2, e->speed, HLM_ROT_DOOR_HIT_TOP);
}

U0 HLRotDoorGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	HLEntSound(e, HLEntDoorMoveSound(e->move_snd), HLENT_CHAN_MOVE);

	HLEntCalcAngleMove(e, e->angle1, e->speed, HLM_ROT_DOOR_HIT_BOTTOM);
}

U0 HLRotDoorHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	HLEntSound(e, HLEntDoorStopSound(e->stop_snd), HLENT_CHAN_MOVE);

	if (e->spawnflags & HLSF_DOOR_TOGGLE)
		goto qrdht_fire;

	if (e->wait < 0.0)
		goto qrdht_fire;

	HLEntSetThink(e, HLM_ROT_DOOR_GO_DOWN, hl_ent_time + e->wait);

qrdht_fire:
	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);
}

U0 HLRotDoorHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;

	HLEntSound(e, HLEntDoorStopSound(e->stop_snd), HLENT_CHAN_MOVE);
}

U0 HLRotDoorUseLeaf(I64 self, I64 activator)
{//CBaseDoor::DoorActivate on one swinging leaf, with no group fan out
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	if (e->toggle_state == HLTS_AT_TOP || e->toggle_state == HLTS_GOING_UP)
	{
		if (e->spawnflags & HLSF_DOOR_TOGGLE)
			HLRotDoorGoDown(self);

		return;
	}

	HLRotDoorGoUp(self, activator);
}

U0 HLRotDoorUse(I64 self, I64 activator)
{//CBaseDoor::Use, over every leaf of the group. A double door built as two
 //swinging halves is the common case for this class
	I64 peer = HLDoorGroupNext(self, 0);

	HLRotDoorUseLeaf(self, activator);

	while (peer >= 0)
	{
		HLEntQueueCall(peer, HLM_DOOR_LEAF, activator, HLUSE_TOGGLE, 0.0);
		peer = HLDoorGroupNext(self, peer + 1);
	}
}

//--- a blocked door ---------------------------------------------------------
//
// CBaseDoor::Blocked, reached through blocked_fn from HLEntFrame's mover pass.
// Both door classes share it; which one a leaf is comes off use_fn, as in
// HLM_DOOR_LEAF. Defined here rather than beside the other door methods
// because it drives the swinging movers as well.

U0 HLDoorReverse(I64 self)
{//turn one leaf around mid-travel
 //
 //the activator is whoever opened the door, not whoever is standing in it, so
 //it is carried through rather than replaced
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->use_fn == HLM_ROT_DOOR_USE)
	{
		if (e->toggle_state == HLTS_GOING_DOWN)
			HLRotDoorGoUp(self, e->activator);
		else
			HLRotDoorGoDown(self);

		return;
	}

	if (e->toggle_state == HLTS_GOING_DOWN)
		HLDoorGoUp(self, e->activator);
	else
		HLDoorGoDown(self);
}

U0 HLDoorBlocked(I64 self, I64 blocker)
{//CBaseDoor::Blocked. blocker is an entity index, -1 for the player, the
 //numbering HLAITargetIsPlayer uses
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	F64			 svel[3];
	F64			 savel[3];
	F64			 dv[3];
	F64			 da[3];
	Bool		 together;
	I64			 peer;
	I64			 j;

	if (!e)
		return;

	//dmg is per block. trigger_hurt reads the same field as a rate, which is
	//that class's own reading of it
	if (e->dmg > 0.0)
	{
		if (blocker < 0)
			HLEntHurtPlayer(e->dmg, HLDMG_CRUSH);
		else
			HLEntTakeDamage(blocker, self, e->dmg);
	}

	//a negative wait never comes back, so the door squashes instead of
	//reversing
	if (e->wait < 0.0)
		return;

	//the travel this leaf was on, read before the reversal replaces it: the
	//peer test below is "was moving with me"
	HLVecCopy(e->velocity, svel);
	HLVecCopy(e->avelocity, savel);

	HLDoorReverse(self);

	//The group is by targetname only here. HLDoorGroupNext falls back to
	//touching bounds for an unnamed door; CBaseDoor::Blocked does not, and two
	//independent doors sharing a frame would reverse each other.
	if (!e->targetname[0])
		return;

	peer = HLDoorGroupNext(self, 0);

	while (peer >= 0)
	{
		o = HLEntGet(peer);

		if (!o || o->wait < 0.0)
			goto qdb_next;

		//A peer travelling with this leaf is realigned onto it, so a double
		//door does not reverse out of step.
		//
		//Two deviations from the SDK, which compares the peer's avelocity
		//against this door's velocity and reads its own velocity after the
		//reversal has already overwritten it. Either one alone leaves every
		//peer unaligned.
		together = TRUE;

		HLVecSub(o->velocity, svel, dv);
		HLVecSub(o->avelocity, savel, da);

		for (j = 0; j < 3; j++)
		{
			if (!HLIsZeroF(dv[j]) || !HLIsZeroF(da[j]))
				together = FALSE;
		}

		if (together)
		{
			if (o->use_fn == HLM_ROT_DOOR_USE)
			{
				HLVecCopy(e->angles, o->angles);
				HLVecSet(o->avelocity, 0.0, 0.0, 0.0);
			}
			else
			{
				HLVecCopy(e->origin, o->origin);
				HLVecSet(o->velocity, 0.0, 0.0, 0.0);
			}

			HLEntSetAbsBox(o);
		}

		//direct, not queued: both movers are defined above, and the realign
		//has to be the reversal's starting point. HLDoorReverse does not fan
		//out, so the group costs one pass
		HLDoorReverse(peer);

qdb_next:
		peer = HLDoorGroupNext(self, peer + 1);
	}
}

U0 HLPlatBlocked(I64 self, I64 blocker)
{//CFuncPlat::Blocked - a lift never crushes, it goes back where it came from
 //
 //One point of damage, not pev->dmg: a plat's dmg key is not a crush value
 //and the SDK hurts the blocker "a little" regardless of it
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (blocker < 0)
		HLEntHurtPlayer(1.0, HLDMG_CRUSH);
	else
		HLEntTakeDamage(blocker, self, 1.0);

	//the travel is the door mover's, so the reversal is too. A plat blocked
	//while parked has no direction to reverse and is left alone
	if (e->toggle_state == HLTS_GOING_UP)
		HLDoorGoDown(self);
	else if (e->toggle_state == HLTS_GOING_DOWN)
		HLDoorGoUp(self, e->activator);
}

//how long a train waits before it can crush the same blocker again -
//CFuncTrain's m_flActivateFinished
#define HLENT_TRAIN_CRUSH_WAIT	0.5

U0 HLTrainBlocked(I64 self, I64 blocker)
{//CFuncTrain::Blocked - a train does not stop and does not reverse, it grinds
 //
 //CFuncTrackTrain::Blocked shares the damage and adds a shove away from the
 //train. The shove is not ported: a rider is already carried by base velocity
 //and anything else in the way is a monster this pass cannot push.
 //
 //The rate limit covers both classes. The SDK gates only func_train, because
 //its Blocked is reached once per touch; here the mover pass asks every tick,
 //and an ungated dmg 100 tram kills through a wall in three
	CHLEntity *e = HLEntGet(self);

	if (!e || e->dmg <= 0.0)
		return;

	if (hl_ent_time < e->pain_finished)
		return;

	e->pain_finished = hl_ent_time + HLENT_TRAIN_CRUSH_WAIT;

	if (blocker < 0)
		HLEntHurtPlayer(e->dmg, HLDMG_CRUSH);
	else
		HLEntTakeDamage(blocker, self, e->dmg);
}

//--- func_rotating ----------------------------------------------------------
//
// CFuncRotating: fans, turbines, the odd rotating platform. Its own spawnflag
// table, which overlaps the door's numerically and means something else.
#define HLSF_ROTATE_INSTANT		1
#define HLSF_ROTATE_BACKWARDS	2
#define HLSF_ROTATE_Z_AXIS		4		//roll
#define HLSF_ROTATE_X_AXIS		8		//pitch
#define HLSF_ROTATE_ACCDCC		16
#define HLSF_ROTATE_HURT			32
#define HLSF_ROTATE_NOT_SOLID	64

U8 *HLEntFanSound(I64 n)
{//CFuncRotating::Precache. a comparison chain for the reason given in
 //HLEntModelForClass
	if (n == 1)		return "fans/fan1.wav";
	if (n == 2)		return "fans/fan2.wav";
	if (n == 3)		return "fans/fan3.wav";
	if (n == 4)		return "fans/fan4.wav";
	if (n == 5)		return "fans/fan5.wav";

	return NULL;
}

//--- ambient_generic --------------------------------------------------------
//
// CAmbientGeneric. The spawnflag bits are radius selectors, not booleans:
//
//   1   PLAYEVERYWHERE   ATTN_NONE, non positional
//   2   SMALLRADIUS      ATTN_IDLE   2.0
//   4   MEDIUMRADIUS     ATTN_STATIC 1.25
//   8   LARGERADIUS      ATTN_NORM   0.8
//   16  START_SILENT     waits for a trigger
//   32  NOT_LOOPING      one shot per trigger
//
// Reading bit 0 as START_SILENT and bit 1 as NOT_LOOPING drops every ambient a
// map marked PLAYEVERYWHERE or SMALLRADIUS, which is most of them.
#define HLSF_AMBIENT_EVERYWHERE		1
#define HLSF_AMBIENT_SMALLRADIUS		2
#define HLSF_AMBIENT_MEDIUMRADIUS	4
#define HLSF_AMBIENT_LARGERADIUS		8
#define HLSF_AMBIENT_START_SILENT	16
#define HLSF_AMBIENT_NOT_LOOPING		32

F64 HLAmbientVolume(CHLEntity *e)
{//"health" is 0-10.
	F64 vol = e->health / 10.0;

	if (vol <= 0.0)
		vol = 1.0;
	if (vol > 1.0)
		vol = 1.0;

	return vol;
}

F64 HLAmbientAtten(CHLEntity *e)
{//CAmbientGeneric::Spawn's m_flAttenuation ladder, first bit set wins.
	if (e->spawnflags & HLSF_AMBIENT_EVERYWHERE)
		return 0.0;
	if (e->spawnflags & HLSF_AMBIENT_SMALLRADIUS)
		return 2.0;
	if (e->spawnflags & HLSF_AMBIENT_MEDIUMRADIUS)
		return 1.25;
	if (e->spawnflags & HLSF_AMBIENT_LARGERADIUS)
		return 0.8;

	//No radius bit: ATTN_STATIC, the same as MEDIUMRADIUS.
	return 1.25;
}

U0 HLAmbientUse(I64 self)
{//CAmbientGeneric::ToggleUse.
 //
 //A non-looping source plays once per trigger and is never in the ambient
 //table. A looping one toggles: added to the table to start, removed to stop.
	CHLEntity	*e = HLEntGet(self);
	F64			 centre[3];
	I64			 i;

	if (!e || !e->message[0])
		return;

	if (e->spawnflags & HLSF_AMBIENT_NOT_LOOPING)
	{
		//PLAYEVERYWHERE sounds are not positional; the mixer takes that as
		//attenuation 0, so the origin is only used for panning it ignores.
		for (i = 0; i < 3; i++)
			centre[i] = e->origin[i];

		HLSndPlayAt(e->message, centre, HLAmbientVolume(e),
			HLAmbientAtten(e), self + 1, HLENT_CHAN_VOICE);
		return;
	}

	if (HLSndAmbientFind(e->message, e->origin) >= 0)
		HLSndAmbientRemove(e->message, e->origin);
	else
		HLSndAmbientAdd(e->origin, e->message, HLAmbientVolume(e),
			HLAmbientAtten(e));
}

U0 HLRotatingUse(I64 self, I64 use_type)
{//spinning or stopped. not the SDK's SpinUp/SpinDown ramp:
 //
 //SF_BRUSH_ACCDCC eases in over fanfriction, and the ease also drives the pitch
 //shift on the fan loop. The ambient mixer here can start a loop but not retune
 //or stop one, so the pitch half is unreachable. Full speed immediately.
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = ToBool(e->toggle_state == HLTS_AT_TOP);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;
	else
		on = !on;

	if (on)
	{
		HLVecScale(e->move_dir, e->speed, e->avelocity);
		e->toggle_state = HLTS_AT_TOP;
	}
	else
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		e->toggle_state = HLTS_AT_BOTTOM;
	}
}

//--- func_pendulum ----------------------------------------------------------
//
// CPendulum. Not a sine wave: the SDK integrates a constant angular
// acceleration towards the centre of the swing and clamps at maxspeed, so a
// pendulum overshoots and settles. Reproduced as an integrator.
#define HLSF_PENDULUM_SWING			2	//rope, hurts on touch
#define HLSF_PENDULUM_AUTO_RETURN	16

//the SDK reruns Swing on a fixed 0.1s think rather than every frame, and the
//integration constant is tuned to that step
#define HLENT_PENDULUM_STEP			0.1

U0 HLPendulumSwing(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 delta;

	if (!e)
		return;

	//distance of the current angle from the middle of the swing. accelerate
	//towards it, so the sign of delta is the sign of the force
	delta = HLEntAxisDelta(e, e->angles, e->angle2);

	if (delta > 0.0 && e->height > 0.0)
		e->momentary_frac -= e->height * HLENT_PENDULUM_STEP;
	else
		e->momentary_frac += e->height * HLENT_PENDULUM_STEP;

	//momentary_frac is the signed angular speed here; a pendulum is never also
	//a momentary button
	if (e->momentary_frac > e->speed)
		e->momentary_frac = e->speed;
	else if (e->momentary_frac < -e->speed)
		e->momentary_frac = -e->speed;

	HLVecScale(e->move_dir, e->momentary_frac, e->avelocity);

	//"damp" bleeds the swing away. absent means it never settles, which is what
	//machinery wants
	if (e->damp > 0.0)
		e->momentary_frac -= e->damp * e->momentary_frac * HLENT_PENDULUM_STEP;

	HLEntSetThink(e, HLM_PENDULUM_SWING, hl_ent_time + HLENT_PENDULUM_STEP);
}

U0 HLPendulumUse(I64 self)
{//a stopped pendulum starts, a swinging one freezes where it is
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->think_fn == HLM_PENDULUM_SWING)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		return;
	}

	e->momentary_frac = 0.0;
	HLPendulumSwing(self);
}

//--- momentary_door / momentary_rot_button ----------------------------------
//
// The only classes in HL that carry a position rather than a state. The button
// turns while +use is held and passes its fraction to the door as USE_SET; the
// door parks proportionally, which is how the c1a3 pipe valves work.
//
// FCAP_CONTINUOUS_USE, buttons.cpp:884: the button turns for as long as IN_USE
// is down, at pev->speed degrees a second over m_flMoveDistance. HLEntUseInFront
// takes a held flag and re-fires this class every tick while the key is down.
// An edge press with no held follow-up still ratchets one step, so a shell that
// only delivers edges reaches the same end position in steps.
#define HLSF_MOMENTARY_DOOR		1	//"door hurts" / not solid, per class
#define HLENT_MOMENTARY_STEP		0.125

U0 HLMomentaryDoorUse(I64 self, I64 use_type, F64 value)
{//CMomentaryDoor::Use - only USE_SET means anything, everything else is a
 //button press arriving at a class that has no on/off
	CHLEntity	*e = HLEntGet(self);
	F64			 delta[3];

	if (!e || use_type != HLUSE_SET)
		return;

	if (value < 0.0)
		value = 0.0;
	if (value > 1.0)
		value = 1.0;

	e->momentary_frac = value;

	HLVecSub(e->position2, e->position1, delta);
	HLVecMA(e->position1, value, delta, e->origin);

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);
}

U0 HLMomentaryRotUse(I64 self, I64 activator, Bool held = FALSE)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 delta[3];
	F64			 step;
	Bool		 first;
	I64			 t;

	if (!e)
		return;

	e->activator = activator;

	//CMomentaryRotButton::UpdateSelf plays the cue on the 0->1 edge of
	//m_lastUsed, buttons.cpp:1029. A gap in the stamp is a released key
	first      = ToBool(hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP);
	e->use_last = hl_ent_time;

	step = HLENT_MOMENTARY_STEP;

	if (held)
	{
		//pev->speed degrees a second across m_flMoveDistance degrees of
		//travel, CMomentaryRotButton::Use. Below a degree of travel the
		//fraction is meaningless, so the ratchet stands in
		if (e->distance >= 1.0 && e->speed > 0.0)
			step = e->speed * hl_ent_frame_dt / e->distance;
	}

	e->momentary_frac += step;
	if (e->momentary_frac > 1.0)
		e->momentary_frac = 1.0;

	//interpolate the angle rather than spin to it: the fraction is the state,
	//and an in-flight angular move would fight the next press
	HLVecSub(e->angle2, e->angle1, delta);
	HLVecMA(e->angle1, e->momentary_frac, delta, e->angles);

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);

	if (first)
		HLEntSound(e, HLEntButtonSound(e->snd_index), HLENT_CHAN_USE);

	//CMomentaryRotButton::UpdateTarget - the value reaches the target as a SET
	//with a magnitude, unlike every other class. SUB_UseTargets cannot carry
	//that, so the chain is walked here
	if (!e->target[0])
		return;

	t = HLEntFindByTargetname(e->target, 0);

	while (t >= 0)
	{
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, HLUSE_SET,
				e->momentary_frac);
		}

		t = HLEntFindByTargetname(e->target, t + 1);
	}
}

//--- env_render -------------------------------------------------------------
//
// Copies its own render fields onto its target. The four mask bits mean "leave
// that field alone", so one env_render can fade a set of brushes without also
// recolouring them.
#define HLSF_RENDER_MASKFX		1
#define HLSF_RENDER_MASKAMT		2
#define HLSF_RENDER_MASKMODE		4
#define HLSF_RENDER_MASKCOLOR	8

U0 HLRenderUse(I64 self)
{//HLDrawFace has no alpha or additive path, so rendermode 4/5 and renderamt are
 //stored and ignored until it has one
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*t;
	I64			 i;

	if (!e)
		return;

	i = HLEntFindByTargetname(e->target, 0);

	while (i >= 0)
	{
		t = &hl_entities[i];

		if (!(e->spawnflags & HLSF_RENDER_MASKFX))
			t->renderfx = e->renderfx;

		if (!(e->spawnflags & HLSF_RENDER_MASKAMT))
			t->renderamt = e->renderamt;

		if (!(e->spawnflags & HLSF_RENDER_MASKMODE))
			t->rendermode = e->rendermode;

		if (!(e->spawnflags & HLSF_RENDER_MASKCOLOR))
			HLVecCopy(e->rendercolor, t->rendercolor);

		i = HLEntFindByTargetname(e->target, i + 1);
	}
}

//--- env_sprite / env_glow / env_beam / env_laser ---------------------------
//
// All four are either showing or not, and the toggle is here.
//
// Beams draw: HLEntDrawBeams at the end of this file walks the entity list and
// calls HLDrawBeam per active one. env_sprite and env_glow do not - no caller
// of HLSprDrawModel exists anywhere in the tree - so e->visible on a sprite
// still drives nothing but its own removal.
#define HLSF_SPRITE_STARTON		1
#define HLSF_SPRITE_ONCE			2

//effects.h's SF_BEAM_*. The three texture bits (SHADEIN, SHADEOUT, DECALS) are
//recognised and unused: HLDrawBeam shades the ribbon uniformly
#define HLSF_BEAM_STARTON		1
#define HLSF_BEAM_TOGGLE			2
#define HLSF_BEAM_RANDOM			4
#define HLSF_BEAM_RING			8
#define HLSF_BEAM_SPARKSTART		16
#define HLSF_BEAM_SPARKEND		32
#define HLSF_BEAM_DECALS			64
#define HLSF_BEAM_SHADEIN		128
#define HLSF_BEAM_SHADEOUT		256

U0 HLSpriteUse(I64 self, I64 use_type)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (use_type == HLUSE_ON)
		e->visible = TRUE;
	else if (use_type == HLUSE_OFF)
		e->visible = FALSE;
	else
		e->visible = !e->visible;

	//SF_SPRITE_ONCE: CSprite::AnimateThink removes itself after one pass. no
	//per-sprite frame clock here, so the lifetime is frame count / framerate
	if (e->visible && (e->spawnflags & HLSF_SPRITE_ONCE) && e->spr)
	{
		if (e->framerate > 0.0)
			HLEntSetThink(e, HLM_REMOVE, hl_ent_time +
				ToF64(e->spr->num_frames) / e->framerate);
		else
			HLEntSetThink(e, HLM_REMOVE, hl_ent_time + 1.0);
	}
}

//--- env_message / game_text ------------------------------------------------
//
// env_message names an entry in valve/titles.txt; game_text carries the literal
// string. Both go to HLHudMsgShow, which is CHudMessage - position, two
// colours, fade in, fade out, hold and the three effects.
//
// HLEntTitleFind in HLEnt.ZC returns the block text alone and drops the layout
// directives, so an env_message routed through it drew in the HL font's own
// amber over the centreprint layout. HLEntTitleLook below reads the directives
// as well.
//
// The directive syntax, from the file's own header:
//
//     <dollar>position x y      0..1 per axis, -1 centres on that axis
//     <dollar>effect n          0 fade, 1 flicker, 2 scan out
//     <dollar>color r g b       the settled colour
//     <dollar>color2 r g b      effect 1's flash, effect 2's leading edge
//     <dollar>fadein s          effect 2 spends this per character
//     <dollar>fadeout s
//     <dollar>holdtime s
//     <dollar>fxtime s          how far the highlight lags the leading edge
//     NAME
//     {
//     text
//     }
//
// Directives are file scoped and latch: each applies to every message below it
// until overwritten. So the parse cannot seek to the name, it has to read from
// the top.
#define HLSF_MESSAGE_ONCE	1

//missing-title complaint budget, so a map with no titles.txt cannot fill the
//console
I64 hl_ent_title_misses = 0;

class CHLTitleMsg
{//client_textmessage_t, common/Sequence.h:17. a1/a2 are unused by the SDK's
 //own draw path and are not carried.
	I64	effect;
	I64	r1;
	I64	g1;
	I64	b1;
	I64	r2;
	I64	g2;
	I64	b2;
	F64	x;
	F64	y;
	F64	fadein;
	F64	fadeout;
	F64	holdtime;
	F64	fxtime;
};

U0 HLTitleDefaults(CHLTitleMsg *t)
{//What a message with no directive above it gets. White, centred, no effect.
	t->effect   = 0;
	t->r1       = 255;
	t->g1       = 255;
	t->b1       = 255;
	t->r2       = 255;
	t->g2       = 255;
	t->b2       = 255;
	t->x        = -1.0;
	t->y        = -1.0;
	t->fadein   = 0.0;
	t->fadeout  = 0.0;
	t->holdtime = 2.0;
	t->fxtime   = 0.0;
}

U8 *HLTitleTok(U8 *p, U8 *end, U8 *out, I64 max)
{//Next whitespace delimited token, returning the cursor past it. Stops at the
 //line end: a directive never continues onto the next line.
 //
 //The scan runs to the real delimiter; only the copy is capped.
	I64 k = 0;

	while (p < end && (*p == ' ' || *p == 9))
		p++;

	while (p < end && *p != ' ' && *p != 9 && *p != 10 && *p != 13)
	{
		if (k < max - 1)
		{
			out[k] = *p;
			k++;
		}

		p++;
	}

	out[k] = 0;

	return p;
}

U8 *HLTitleNum(U8 *p, U8 *end, F64 *v)
{//One number off the line. A missing token leaves the field alone.
	U8 tok[32];

	p = HLTitleTok(p, end, tok, 32);

	if (tok[0])
		*v = HLAtoF(tok);

	return p;
}

U0 HLTitleDirective(U8 *p, U8 *end, CHLTitleMsg *t)
{//p is at the character after the leading dollar.
	U8	tok[32];
	F64	a;
	F64	b;
	F64	c;

	p = HLTitleTok(p, end, tok, 32);

	if (!StrCompare(tok, "position"))
	{
		p = HLTitleNum(p, end, &t->x);
		    HLTitleNum(p, end, &t->y);
		return;
	}

	if (!StrCompare(tok, "effect"))
	{
		a = ToF64(t->effect);
		HLTitleNum(p, end, &a);
		t->effect = ToI64(a);
		return;
	}

	if (!StrCompare(tok, "color") || !StrCompare(tok, "color2"))
	{
		a = 255.0;
		b = 255.0;
		c = 255.0;

		p = HLTitleNum(p, end, &a);
		p = HLTitleNum(p, end, &b);
		    HLTitleNum(p, end, &c);

		if (!StrCompare(tok, "color"))
		{
			t->r1 = ClampI64(ToI64(a), 0, 255);
			t->g1 = ClampI64(ToI64(b), 0, 255);
			t->b1 = ClampI64(ToI64(c), 0, 255);
		}
		else
		{
			t->r2 = ClampI64(ToI64(a), 0, 255);
			t->g2 = ClampI64(ToI64(b), 0, 255);
			t->b2 = ClampI64(ToI64(c), 0, 255);
		}

		return;
	}

	if (!StrCompare(tok, "fadein"))
		HLTitleNum(p, end, &t->fadein);
	else if (!StrCompare(tok, "fadeout"))
		HLTitleNum(p, end, &t->fadeout);
	else if (!StrCompare(tok, "holdtime"))
		HLTitleNum(p, end, &t->holdtime);
	else if (!StrCompare(tok, "fxtime"))
		HLTitleNum(p, end, &t->fxtime);
}

Bool HLEntTitleLook(U8 *name, U8 *out, I64 max, CHLTitleMsg *t)
{//The engine's titles.txt loader: read every directive from the top, stop on
 //the message whose name line matches, return its block and the directive
 //state that reached it.
 //
 //Braces are compared as 0x7B/0x7D rather than as character literals: a lone
 //open-brace character literal unbalances this file for every brace-counting
 //tool that reads it.
	U8	*p;
	U8	*end;
	U8	*eol;
	U8	*s;
	U8	*le;
	I64	 len;
	I64	 n;
	Bool matched;

	if (!t)
		return FALSE;

	HLTitleDefaults(t);

	if (!out || max < 1)
		return FALSE;

	out[0] = 0;

	if (!name || !name[0])
		return FALSE;

	HLEntTitlesLoad;

	if (!hl_ent_titles)
		return FALSE;

	len = StrLen(name);
	p   = hl_ent_titles;
	end = hl_ent_titles + hl_ent_titles_size;

	while (p < end)
	{
		eol = p;
		while (eol < end && *eol != 10)
			eol++;

		//trim the CR of a DOS line ending and any trailing blanks
		le = eol;
		while (le > p && (le[-1] == 13 || le[-1] == ' ' || le[-1] == 9))
			le--;

		s = p;
		while (s < le && (*s == ' ' || *s == 9))
			s++;

		//cursor for the next line, set before any of the branches move p
		p = eol;
		if (p < end)
			p++;

		if (s >= le)
			goto qetl_next;

		if (s[0] == '/' && s + 1 < le && s[1] == '/')
			goto qetl_next;

		//0x24 is the dollar. Written as a number: the compiler's lexer opens a
		//DolDoc command on a raw one and swallows the rest of the file.
		if (s[0] == 0x24)
		{
			HLTitleDirective(s + 1, le, t);
			goto qetl_next;
		}

		//a stray brace outside a block
		if (s[0] == 0x7B || s[0] == 0x7D)
			goto qetl_next;

		//a name line. The whole line is the key, so C1A0_ must not match
		//C1A0_TRAINRIDE
		matched = FALSE;

		if (le - s == len && !StrNICompare(s, name, len))
			matched = TRUE;

		//every name is followed by a braced block; skip or take it, but never
		//fall through to read its text as directives
		while (p < end && *p != 0x7B)
			p++;

		if (p >= end)
			return FALSE;

		p++;

		while (p < end && *p != 10)
			p++;
		if (p < end)
			p++;

		n = 0;

		while (p < end && *p != 0x7D)
		{
			if (matched && *p != 13)
			{
				//HLHudMsgDraw breaks lines on the two character escape that
				//game_text carries, not on byte 10. A block's real newlines
				//are rewritten into it here.
				if (*p == 10)
				{
					if (n < max - 2)
					{
						out[n]     = '\\';
						out[n + 1] = 'n';
						n += 2;
					}
				}
				else if (n < max - 1)
				{
					out[n] = *p;
					n++;
				}
			}

			p++;
		}

		if (p < end)
			p++;

		if (!matched)
			goto qetl_next;

		//the block's last line ends with a newline before the closing brace,
		//which would place an empty trailing row
		while (n > 1 && out[n - 2] == '\\' && out[n - 1] == 'n')
			n -= 2;

		out[n] = 0;

		return ToBool(n > 0);

qetl_next:
	}

	return FALSE;
}

U0 HLMessageUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	CHLTitleMsg	 t;
	U8			 text[HLMSG_MAX_TEXT];

	if (!e || !e->message[0])
		return;

	//holdtime and the rest come from titles.txt, not from the entity: CMessage
	//has no timing keys at all - dlls/effects.cpp:2040
	if (HLEntTitleLook(e->message, text, HLMSG_MAX_TEXT, &t))
		HLHudMsgShow(text, t.effect, t.x, t.y,
			t.r1, t.g1, t.b1, t.r2, t.g2, t.b2,
			t.fadein, t.fadeout, t.holdtime, t.fxtime);
	else if (hl_ent_title_misses < 8)
	{
		//nothing is drawn; the miss is reported instead, capped
		hl_ent_title_misses++;
		"HLEnt: env_message '%s' not in titles.txt\n", e->message;
	}

	//SF_MESSAGE_ONCE
	if (e->spawnflags & HLSF_MESSAGE_ONCE)
		e->in_use = FALSE;
}

U0 HLGameTextUse(I64 self)
{//game_text's message is the text, escapes unprocessed - a literal backslash
 //then n, which HLHudMsgDraw breaks on.
 //
 //Drawn white: CHLEntity has no colour pair for it. HLEnt.ZC's "color" key is
 //claimed by env_blood's selector and "color2" is not parsed at all, so both
 //would have to be added there before this can honour them.
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLHudMsgShow(e->message, 0, e->text_x, e->text_y,
		255, 255, 255, 255, 255, 255,
		e->fade_in, e->fade_out, e->hold_time, 0.25);
}

//--- env_fade / env_shake ---------------------------------------------------
//
// env_shake is a pure view effect and stays a pending request. env_fade goes
// straight to the HUD overlay: HLHudFadeSet owns the ramp, so the request no
// longer has to survive to the shell.
//
// pev->dmg_take is the duration and pev->dmg_save the hold time -
// dlls/effects.cpp:1920. SF_FADE_ONLYONE is single player irrelevant: there is
// one client either way.
#define HLSF_FADE_IN			1
#define HLSF_FADE_MODULATE	2

U0 HLFadeUse(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//kept for the save file, which carries the fade across a level change
	HLVecCopy(e->rendercolor, hl_ent_fade_color);
	hl_ent_fade_alpha    = e->renderamt;
	hl_ent_fade_duration = e->duration;
	hl_ent_fade_hold     = e->hold_time;
	hl_ent_fade_in       = ToBool(e->spawnflags & HLSF_FADE_IN);
	hl_ent_fade_pending  = FALSE;

	//SF_FADE_MODULATE is a multiply rather than a blend. The overlay blends;
	//no shipped single player map sets the bit.
	HLHudFadeSet(ToI64(e->rendercolor[0]), ToI64(e->rendercolor[1]),
		ToI64(e->rendercolor[2]), ToI64(e->renderamt),
		e->duration, e->hold_time, hl_ent_fade_in);
}

U0 HLShakeUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];

	if (!e)
		return;

	//radius 0 means everyone; past the radius there is nothing. tested against
	//the stashed origin - a think has no player argument
	if (e->radius > 0.0)
	{
		HLVecSub(hl_ent_player_org, e->origin, dist);

		if (HLVecLength(dist) > e->radius)
			return;
	}

	hl_ent_shake_amp     = e->amplitude;
	hl_ent_shake_freq    = e->frequency;
	hl_ent_shake_until   = hl_ent_time + e->duration;
	hl_ent_shake_pending = TRUE;
}

//--- env_explosion ----------------------------------------------------------
//
// explode.h's SF_ENVEXPLOSION_*. The decal bit is parsed and ignored: there is
// no decal layer, so a scorch mark has nowhere to go.
#define HLSF_EXPLOSION_NODAMAGE	1
#define HLSF_EXPLOSION_REPEATABLE	2
#define HLSF_EXPLOSION_NOFIREBALL	4
#define HLSF_EXPLOSION_NOSMOKE		8
#define HLSF_EXPLOSION_NODECAL		16
#define HLSF_EXPLOSION_NOSPARKS	32

U0 HLExplosionSmoke(I64 self)
{//CEnvExplosion::Smoke - a second puff 0.3s behind the fireball, and the point
 //at which a non-repeatable explosion is removed
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLEntSetThink(e, HLM_NONE, 0.0);

	//TE_SMOKE at the sprite scale CEnvExplosion computed at spawn
	if (!(e->spawnflags & HLSF_EXPLOSION_NOSMOKE))
		HLFxSmoke(e->origin, e->scale, tS);

	//UTIL_Remove. In the SDK this is here rather than in Use, so a repeatable
	//explosion survives its own smoke
	if (!(e->spawnflags & HLSF_EXPLOSION_REPEATABLE))
		e->in_use = FALSE;
}

U0 HLExplosionUse(I64 self)
{//CEnvExplosion::Use. iMagnitude is the damage; the radius is 2.5x it, as
 //RadiusDamage is called
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];
	F64			 up[3];
	F64			 radius;
	F64			 len;
	F64			 damage;
	I64			 sparks;
	I64			 i;

	if (!e)
		return;

	//the SDK traces 40 units down and pulls the blast out of whatever it hits,
	//so a fireball on the floor is not half inside it. Not done here: the origin
	//is only used to place particles, which have no volume to sink into

	//TE_EXPLOSION at the scale computed at spawn. NOFIREBALL sends the same
	//message with a zero sprite scale, which here is the particle-free flag
	if (!(e->spawnflags & HLSF_EXPLOSION_NOFIREBALL))
		HLFxExplosion(e->origin, e->scale, 0, tS);
	else
		HLFxExplosion(e->origin, e->scale, 8, tS);	//TE_EXPLFLAG_NOPARTICLES

	//explode3. the SDK randomises over three variants
	HLSndPlayAt("weapons/explode3.wav", e->origin, 1.0, HLENT_SND_ATTEN, 0,
		HLENT_CHAN_MOVE);

	//spark_shower, RANDOM_LONG(0,3) of them, each scattered along the surface
	//normal the blast was traced against. There is no trace here, so they go up
	if (!(e->spawnflags & HLSF_EXPLOSION_NOSPARKS))
	{
		sparks = HLPartRandI(4);
		HLVecSet(up, 0.0, 0.0, 1.0);

		for (i = 0; i < sparks; i++)
			HLFxSparkShower(e->origin, up, tS);
	}

	if (e->spawnflags & HLSF_EXPLOSION_NODAMAGE)
		goto qeu_done;

	radius = e->magnitude * 2.5;
	if (radius <= 0.0)
		goto qeu_done;

	HLVecSub(hl_ent_player_org, e->origin, dist);
	len = HLVecLength(dist);

	if (len < radius)
	{
		//RadiusDamage's linear falloff. no trace to the target, so a wall
		//between the player and the blast does not shield them
		damage = e->magnitude * (1.0 - len / radius);
		HLEntHurtPlayer(damage, HLDMG_BLAST);
	}

qeu_done:
	HLEntSetThink(e, HLM_EXPLOSION_SMOKE, hl_ent_time + 0.3);
}

//--- env_spark --------------------------------------------------------------
#define HLSF_SPARK_TOGGLE	32
#define HLSF_SPARK_START_ON	64

U8 *HLEntSparkSound(I64 n)
{//DoSpark picks one of six at random
	if (n == 1)		return "buttons/spark1.wav";
	if (n == 2)		return "buttons/spark2.wav";
	if (n == 3)		return "buttons/spark3.wav";
	if (n == 4)		return "buttons/spark4.wav";
	if (n == 5)		return "buttons/spark5.wav";

	return "buttons/spark6.wav";
}

U0 HLSparkThink(I64 self)
{//a spark, then reschedule at a random point inside MaxDelay
	CHLEntity	*e = HLEntGet(self);
	F64			 dir[3];
	F64			 wait;

	if (!e)
		return;

	HLSndPlayAt(HLEntSparkSound(HLPartRandI(6) + 1), e->origin, 0.4,
		HLENT_SND_ATTEN, 0, 0);

	//DoSpark is UTIL_Sparks at the entity, then the sound. The "angle" key is
	//the shower's axis, which UTIL_Sparks itself does not take - it goes to
	//HLFxSparkShower, whose burst walks along the normal
	HLVecCopy(e->move_dir, dir);
	HLFxSparkShower(e->origin, dir, tS);

	wait = e->max_delay;
	if (wait <= 0.0)
		wait = 1.5;

	//0.1 .. MaxDelay, jittered
	HLEntSetThink(e, HLM_SPARK_THINK,
		hl_ent_time + 0.1 + ToF64(HLPartRandI(100)) * 0.01 * wait);
}

U0 HLSparkUse(I64 self, I64 use_type)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	//an untoggleable spark sparks once when fired
	if (!(e->spawnflags & HLSF_SPARK_TOGGLE))
	{
		HLSparkThink(self);
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	//"on" is whether it sparks after this use
	on = ToBool(e->think_fn != HLM_SPARK_THINK);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	if (on)
		HLEntSetThink(e, HLM_SPARK_THINK, hl_ent_time + 0.1);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

//--- env_bubbles ------------------------------------------------------------
//
// CBubbling. A brush volume that fizzes: TE_FIZZ fills the model's box with
// rising bubble sprites. There is no bubble sprite here, so the bubbles are
// particles in the palette's pale blue range, released across the brush and
// given an upward velocity.
//
// "current" is a horizontal drift, which the SDK smuggles to the client packed
// into rendercolor. Applied straight to the particle velocity here.
#define HLSF_BUBBLES_STARTOFF	1

U0 HLBubbleThink(I64 self)
{//CBubbling::FizzThink
	CHLEntity	*e = HLEntGet(self);
	F64			 wait;
	F64			 speed;
	I64			 count;

	if (!e)
		return;

	//m_density is the bubble count per fizz
	count = e->density;
	if (count < 1)
		count = 1;

	//"current", which CBubbling::Spawn packs into rendercolor for the client.
	//UTIL_Bubbles' own default is 8 when nothing is set
	speed = e->speed;
	if (speed <= 0.0)
		speed = 8.0;

	//the bubbles rise the height of the brush and are gone at the top of it,
	//which is where TE_FIZZ's water surface is
	HLFxBubbles(e->absmin, e->absmax, e->size[2], count, speed, tS);

	//"if ( m_frequency > 19 ) 0.5 else 2.5 - (0.1 * m_frequency)"
	if (e->frequency > 19)
		wait = 0.5;
	else
		wait = 2.5 - 0.1 * ToF64(e->frequency);

	HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + wait);
}

U0 HLBubbleUse(I64 self, I64 use_type)
{//CBubbling::Use - ShouldToggle against m_state, which is the think being armed
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = ToBool(e->think_fn != HLM_BUBBLE_THINK);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	if (on)
		HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + 0.1);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

//--- env_smoker -------------------------------------------------------------
//
// CSmoker, in gargantua.cpp rather than effects.cpp - it exists for the
// gargantua's footfalls and is created at runtime there. A mapper-placed one
// works the same way: health is the puff count, dmg the horizontal spread and
// scale the sprite size.

U0 HLSmokerThink(I64 self)
{//CSmoker::Think - one puff, then count down
	CHLEntity	*e = HLEntGet(self);
	F64			 org[3];

	if (!e)
		return;

	//"origin.x + RANDOM_FLOAT(-pev->dmg, pev->dmg)" on x and y, z untouched
	org[0] = e->origin[0] + HLPartRand(e->dmg);
	org[1] = e->origin[1] + HLPartRand(e->dmg);
	org[2] = e->origin[2];

	//"RANDOM_LONG(pev->scale, pev->scale * 1.1)" is the sprite scale byte
	HLFxSmoke(org, e->scale + ToF64(HLPartRandI(11)) * 0.01 * e->scale, tS);

	e->health -= 1.0;

	if (e->health > 0.0)
		HLEntSetThink(e, HLM_SMOKER_THINK,
			hl_ent_time + 0.1 + ToF64(HLPartRandI(10)) * 0.01);
	else
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		e->in_use = FALSE;
	}
}

//--- env_funnel -------------------------------------------------------------
//
// CEnvFunnel. TE_LARGEFUNNEL: a cone of sprites falling in toward the origin,
// or thrown outward when SF_FUNNEL_REVERSE is set. Built here out of particles
// released on a ring 256 units up, aimed at or away from the origin.
//
// Fires once and removes itself, as the SDK's Use does.
#define HLSF_FUNNEL_REVERSE	1

U0 HLFunnelUse(I64 self)
{//CEnvFunnel::Use
	CHLEntity	*e = HLEntGet(self);
	CHLParticle	*p;
	F64			 dir[3];
	F64			 ang;
	F64			 rad;
	Bool		 reverse;
	I64			 i;

	if (!e)
		return;

	reverse = ToBool(e->spawnflags & HLSF_FUNNEL_REVERSE);

	for (i = 0; i < 128; i++)
	{
		p = HLPartAlloc(tS);
		if (!p)
			goto qfu_done;

		//a point on a ring of random radius, 256 units above the origin. The
		//funnel's mouth is wide and its throat is the entity
		ang = ToF64(HLPartRandI(360)) * HLDEG2RAD;
		rad = 32.0 + ToF64(HLPartRandI(224));

		p->org[0] = e->origin[0] + Cos(ang) * rad;
		p->org[1] = e->origin[1] + Sin(ang) * rad;
		p->org[2] = e->origin[2] + 100.0 + ToF64(HLPartRandI(156));

		HLVecSub(e->origin, p->org, dir);
		HLVecNormalize(dir);

		if (reverse)
			HLVecScale(dir, -1.0, dir);

		HLVecScale(dir, 80.0 + ToF64(HLPartRandI(120)), p->vel);

		p->type  = HLPT_STATIC;
		p->ramp  = 0.0;
		p->color = 254;		//flare6.spr is white
		p->die   = tS + 2.0;
	}

qfu_done:
	//SUB_Remove on the next think
	e->in_use = FALSE;
}

//--- env_blood --------------------------------------------------------------
//
// CBlood. A spray of blood at a point, at the player, or along the entity's
// own angle. The decal bit is parsed and dropped - no decal layer.
#define HLSF_BLOOD_RANDOM	1
#define HLSF_BLOOD_STREAM	2
#define HLSF_BLOOD_PLAYER	4
#define HLSF_BLOOD_DECAL		8

U0 HLBloodUse(I64 self)
{//CBlood::Use - UTIL_BloodDrips, or UTIL_BloodStream for a jet
	CHLEntity	*e = HLEntGet(self);
	F64			 org[3];
	F64			 dir[3];
	I64			 amount;

	if (!e)
		return;

	//BloodPosition: SF_BLOOD_PLAYER sprays at the player's eye, jittered by 10
	//units on each axis
	if (e->spawnflags & HLSF_BLOOD_PLAYER)
	{
		org[0] = hl_ent_player_org[0] + HLPartRand(10.0);
		org[1] = hl_ent_player_org[1] + HLPartRand(10.0);
		org[2] = hl_ent_player_org[2] + HLPartRand(10.0);
	}
	else
		HLVecCopy(e->origin, org);

	//Direction: UTIL_RandomBloodVector for SF_BLOOD_RANDOM, otherwise the
	//entity's own movedir
	if (e->spawnflags & HLSF_BLOOD_RANDOM)
		HLFxRandomBloodVector(dir);
	else
		HLVecCopy(e->move_dir, dir);

	//"amount" is the blood volume, clamped to a byte by the temp entity
	amount = ToI64(e->blood_amount);

	if (amount < 1)
		amount = 1;
	if (amount > 255)
		amount = 255;

	//"UTIL_BloodStream( ..., (Color() == BLOOD_COLOR_RED) ? 70 : Color(), ... )"
	//- a red stream is sent as palette 70 rather than 247, which is the darker
	//arterial ramp
	if (e->spawnflags & HLSF_BLOOD_STREAM)
	{
		if (e->blood_color == HLBLOOD_RED)
			HLFxBloodStream(org, dir, 70, amount, tS);
		else
			HLFxBloodStream(org, dir, e->blood_color, amount, tS);
	}
	else
		HLFxBloodDrips(org, dir, e->blood_color, amount, tS);

	//SF_BLOOD_DECAL: the SDK traces along the spray for amount*2 units and
	//marks whatever it hits. There is no trace here, so the decal is laid at the
	//spray origin facing back along the direction
	if (e->spawnflags & HLSF_BLOOD_DECAL)
	{
		HLVecScale(dir, -1.0, dir);
		HLFxBloodDecal(org, dir, e->blood_color);
	}
}

//--- gibshooter / env_shooter -----------------------------------------------
//
// CGibShooter and CEnvShooter. Both throw m_iGibs gibs, one every m_flDelay,
// along the entity's angle scattered by m_flVariance.
//
// The gib pool in HLPart.ZC carries them: hl_gibs is a fixed table with its own
// bounce integrator, independent of hl_entities, so CreateGib maps onto
// HLGibAlloc/HLGibSpawn and the SDK's ShootThink transfers almost whole.
//
// env_shooter's "shootmodel" is parsed and unused - the pool draws hgibs.mdl or
// agibs.mdl and has no third model slot.
#define HLSF_GIBSHOOTER_REPEATABLE	1

U0 HLShooterThink(I64 self)
{//CGibShooter::ShootThink - one gib per think
	CHLEntity	*e = HLEntGet(self);
	CHLGib		*g;
	F64			 dir[3];
	F64			 wait;
	I64			 body;

	if (!e)
		return;

	//movedir scattered by m_flVariance on all three axes. The SDK builds the
	//scatter out of v_forward/v_right/v_up, which for an axial movedir is the
	//same as jittering the vector itself
	dir[0] = e->move_dir[0] + HLPartRand(e->gib_variance);
	dir[1] = e->move_dir[1] + HLPartRand(e->gib_variance);
	dir[2] = e->move_dir[2] + HLPartRand(e->gib_variance);

	HLVecNormalize(dir);

	//"avoid throwing random amounts of the 0th gib. (skull)"
	body = HLFxRandI(1, HLGIB_HUMAN_COUNT - 1);

	g = HLGibAlloc(tS);
	HLGibSpawn(g, e->origin, TRUE, body, HLBLOOD_RED, tS);

	HLVecScale(dir, e->gib_velocity, g->velocity);

	g->avelocity[0] = HLFxRandF(100.0, 200.0);
	g->avelocity[1] = HLFxRandF(100.0, 300.0);
	g->avelocity[2] = 0.0;

	//m_flGibLife with the SDK's +/- 5%
	g->die = tS + e->gib_life * HLFxRandF(0.95, 1.05);

	HLGibLimitVelocity(g);

	e->gib_left--;

	if (e->gib_left > 0)
	{
		wait = e->delay;
		if (wait <= 0.0)
			wait = 0.1;

		HLEntSetThink(e, HLM_SHOOTER_THINK, hl_ent_time + wait);
		return;
	}

	//exhausted: refill and stop, or remove
	HLEntSetThink(e, HLM_NONE, 0.0);

	if (e->spawnflags & HLSF_GIBSHOOTER_REPEATABLE)
		e->gib_left = e->gib_count;
	else
		e->in_use = FALSE;
}

U0 HLShooterUse(I64 self)
{//CGibShooter::Use - starts the think immediately
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//a shooter used again mid-burst restarts the count, as refilling m_iGibs
	//through Spawn would
	if (e->gib_left <= 0)
		e->gib_left = e->gib_count;

	HLEntSetThink(e, HLM_SHOOTER_THINK, hl_ent_time);
}

//--- env_laser --------------------------------------------------------------
//
// CLaser. Unlike env_beam it has a think: every 0.1s it traces from its origin
// to its target and damages whatever the line crosses, at pev->dmg per second.
//
// Not drawn. HLDraw.ZC has no line primitive - see HLEntSpawnBeam - so the laser
// is an invisible damage line. The state is complete: on/off, the endpoint, the
// width and the damage rate.

F64 HLEntPointSegDist(F64 *p, F64 *a, F64 *b)
{//distance from a point to the segment ab. The beam has no trace, so "is the
 //player in the beam" is this test against the player's centre
	F64 ab[3];
	F64 ap[3];
	F64 closest[3];
	F64 len2;
	F64 t;

	HLVecSub(b, a, ab);
	HLVecSub(p, a, ap);

	len2 = HLVecDot(ab, ab);

	if (len2 < 0.0001)
		return HLVecLength(ap);

	t = HLVecDot(ap, ab) / len2;

	if (t < 0.0)
		t = 0.0;
	if (t > 1.0)
		t = 1.0;

	HLVecMA(a, t, ab, closest);
	HLVecSub(p, closest, ap);

	return HLVecLength(ap);
}

U0 HLLaserThink(I64 self)
{//CLaser::StrikeThink into CBeam::BeamDamage. Damage is pev->dmg scaled by the
 //time since the last think, so the rate is per second whatever the tick is
	CHLEntity	*e = HLEntGet(self);
	F64			 end[3];
	F64			 dist;

	if (!e)
		return;

	//the endpoint is LaserTarget, resolved to an index at spawn. Without one the
	//laser is a zero length segment at its own origin
	if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_end].origin, end);
	else
		HLVecCopy(e->origin, end);

	if (e->damage > 0.0)
	{
		dist = HLEntPointSegDist(hl_ent_player_org, e->origin, end);

		//the beam's own half-width plus the player's: the SDK traces a line and
		//hits the player's box, which is 16 units across. BoltWidth is stored
		//in 0.1s of a unit (const.h:131), so the half-width is width * 0.05
		if (dist < e->beam_width * 0.05 + 16.0)
			HLEntHurtPlayer(e->damage * 0.1, HLDMG_ENERGYBEAM);
	}

	//DoSparks at the impact point, which is the endpoint since there is no trace
	if (e->spawnflags & HLSF_BEAM_SPARKEND)
		HLFxSparks(end, tS);

	HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time + 0.1);
}

U0 HLLaserUse(I64 self, I64 use_type)
{//CLaser::Use - ShouldToggle against IsOn, which is the EF_NODRAW bit. Here it
 //is the visible flag the beam already carries
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = !e->visible;

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	e->visible     = on;
	e->beam_active = on;

	if (on)
		HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

U0 HLBeamUse(I64 self, I64 use_type)
{//CLightning::ToggleUse. Its own rather than the sprite's: SF_BEAM_TOGGLE is bit
 //1, which is SF_SPRITE_ONCE on a sprite, and the sprite path would read a
 //toggleable beam as a one-shot and remove it
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = !e->visible;

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	e->visible     = on;
	e->beam_active = on;

	//"DoSparks( GetStartPos(), GetEndPos() )" when it comes on
	if (on && (e->spawnflags & HLSF_BEAM_SPARKSTART))
		HLFxSparks(e->origin, tS);
}

U0 HLBeamDamageThink(I64 self)
{//CLightning::DamageThink - env_beam's server-side damage, the same line test as
 //the laser's but between the two named endpoints
	CHLEntity	*e = HLEntGet(self);
	F64			 start[3];
	F64			 end[3];
	F64			 dist;

	if (!e)
		return;

	if (e->beam_start >= 0 && e->beam_start < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_start].origin, start);
	else
		HLVecCopy(e->origin, start);

	if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_end].origin, end);
	else
		HLVecCopy(e->origin, end);

	if (e->beam_active && e->damage > 0.0)
	{
		dist = HLEntPointSegDist(hl_ent_player_org, start, end);

		//BoltWidth is in 0.1s of a unit, const.h:131
		if (dist < e->beam_width * 0.05 + 16.0)
			HLEntHurtPlayer(e->damage * 0.1, HLDMG_ENERGYBEAM);
	}

	HLEntSetThink(e, HLM_BEAM_DAMAGE_THINK, hl_ent_time + 0.1);
}

//--- infodecal --------------------------------------------------------------
//
// CDecal, dlls/world.cpp:105. Nothing about a decal is baked at compile time:
// an unnamed one sprays itself on one think after the map spawns
// (world.cpp:125-129), a named one waits for its use (world.cpp:132-136).
//
// The "texture" key names a patch in decals.wad. DECAL_INDEX is an engine call
// over the whole archive; HLDecalName covers the gDecals subset only, which is
// 1050 of the 1925 infodecals in the shipped maps. A name outside it resolves
// to -1 and the entity is dropped, as CDecal::KeyValue does on a miss
// (world.cpp:191).
//
// SF_DECAL_NOTINDEATHMATCH gates a decal on gpGlobals->deathmatch. This port is
// single-player, so the bit never applies.

I64 HLDecalIndexByName(U8 *name)
{//DECAL_INDEX. The map spells the name with the masked-texture prefix and in
 //upper case; gDecals carries it lower case and without the prefix
	U8	*base;
	U8	*p;
	I64	 i;

	if (!name || !name[0])
		return -1;

	p = name;

	if (*p == 0x7B)
		p++;

	for (i = 0; i < HLDECAL_TEX_MAX; i++)
	{
		base = HLDecalName(i);

		if (base && !StrICompare(base, p))
			return i;
	}

	return -1;
}

U0 HLDecalPlace(I64 self)
{//CDecal::StaticDecal, world.cpp:164, and CDecal::TriggerDecal, world.cpp:138 -
 //the same trace and the same removal, so one body serves both
 //
 //The 10 unit diagonal probe is Valve's: an infodecal is authored a unit or two
 //off the face it belongs to, on no particular axis
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 start[3];
	F64			 end[3];

	if (!e)
		return;

	if (e->skin >= 0 && hl_map)
	{
		HLVecSet(start, e->origin[0] - 5.0, e->origin[1] - 5.0,
			e->origin[2] - 5.0);
		HLVecSet(end, e->origin[0] + 5.0, e->origin[1] + 5.0,
			e->origin[2] + 5.0);

		HLTraceMove(hl_map, start, end, &tr);

		if (tr.hit && tr.fraction < 1.0)
			HLDecalAdd(tr.end_pos, tr.plane_normal, e->skin);
	}

	//SUB_Remove. The whole entity is one think
	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

//--- trigger_cdaudio / target_cdaudio ---------------------------------------
//
// CTriggerCDAudio::PlayTrack, dlls/triggers.cpp:728: PlayCDTrack((int)health),
// then remove. "health" is the overloaded track number, -1 meaning stop
// (triggers.cpp:797-801).
//
// HLMusicPlay reads valve/music/trackNN.wav. The shipped tree carries the Steam
// MP3 layout in valve/media instead, which HLSound.ZC cannot decode, so a cue
// finds no file and returns FALSE. The cue itself is real either way.

U0 HLCDAudioPlay(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	I64			 track;

	if (!e)
		return;

	track = ToI64(e->health);

	//"if ( iTrack < -1 || iTrack > 30 )", triggers.cpp:786
	if (track >= -1 && track <= 30)
	{
		if (track == -1)
			HLMusicFree;
		else
			HLMusicPlay(track, tS);
	}

	//PlayTrack clears the touch and removes; target_cdaudio's Play does the
	//same through CTargetCDAudio::Play, triggers.cpp:794
	e->touch_fn   = HLM_NONE;
	e->use_fn     = HLM_NONE;
	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

U0 HLCDAudioRadiusThink(I64 self)
{//CTargetCDAudio::Think, dlls/triggers.cpp:775. Polls at 0.5s and fires when
 //the player is inside "radius". The SDK stuffs that key into pev->scale
 //(triggers.cpp:753); the parser here has a radius field of its own
	CHLEntity	*e = HLEntGet(self);
	F64			 rel[3];

	if (!e)
		return;

	HLVecSub(hl_ent_player_org, e->origin, rel);

	if (HLVecLength(rel) <= e->radius)
	{
		HLCDAudioPlay(self);
		return;
	}

	HLEntSetThink(e, HLM_CDAUDIO_RADIUS, hl_ent_time + 0.5);
}

//--- monstermaker -----------------------------------------------------------
//
// CMonsterMaker, dlls/monstermaker.cpp:33. 331 makers across 52 shipped maps.
//
// Its three own keys - monstertype, monstercount, m_imaxlivechildren - are not
// in the generic key table, so the entity lump is re-scanned for maker blocks
// the way HLEntParseMultiManagers re-scans for multi_manager ones. The rest of
// the state (live count, ground plane, active flag) has no CHLEntity field
// either and lives beside it.
//
// Children are allocated above hl_num_entities, which the parse pass leaves as
// the parsed count while the table itself is HLENT_MAX slots wide and zeroed by
// CAlloc (HLEnt.ZC:792). Growing the count is what makes HLAIMonSync notice a
// new monster.
//
// Deviations from the SDK, both forced:
//
//   DeathNotice is a callback the child fires at its owner. Nothing here calls
//   it, so the live count is recounted from the entity table on each think
//   instead. Same result, one scan per maker per delay.
//
//   SF_MONSTER_FALL_TO_GROUND is an engine drop the child gets on spawn. There
//   is none here, so the child is placed on the traced ground plane directly.

#define HLSF_MAKER_START_ON		1
#define HLSF_MAKER_CYCLIC		4

//SF_MONSTERMAKER_MONSTERCLIP passes SF_MONSTER_HITMONSTERCLIP to the child.
//func_monsterclip is inert here, so the bit is recognised and unused
#define HLSF_MAKER_MONSTERCLIP	8

//makers per map. c3a1, the busiest, has 33. Headroom for children comes out of
//HLENT_MAX: the fullest single-player map parses 719 entities against 1024
#define HLMAKER_MAX	64

class CHLMonsterMaker
{
	I64		ent;				//owning entity index
	U8		monster[64];		//monstertype, a monster_* classname
	I64		num_monsters;		//m_cNumMonsters, what is left to make
	I64		max_live;			//m_iMaxLiveChildren, 0 = no ceiling
	I64		live;				//m_cLiveChildren
	F64		ground;				//m_flGround, 0 until the first make traces it
	Bool	active;				//m_fActive
};

CHLMonsterMaker	hl_maker[HLMAKER_MAX];
I64				hl_maker_count = 0;
I64				hl_maker_made  = 0;		//children spawned this map, for the report

U0 HLMakerReset()
{//globals are not zeroed and this table is walked by name lookup
	I64 i;

	for (i = 0; i < HLMAKER_MAX; i++)
	{
		hl_maker[i].ent          = -1;
		hl_maker[i].monster[0]   = 0;
		hl_maker[i].num_monsters = 0;
		hl_maker[i].max_live     = 0;
		hl_maker[i].live         = 0;
		hl_maker[i].ground       = 0.0;
		hl_maker[i].active       = FALSE;
	}

	hl_maker_count = 0;
	hl_maker_made  = 0;
}

I64 HLMakerFind(I64 ent)
{
	I64 i;

	for (i = 0; i < hl_maker_count; i++)
	{
		if (hl_maker[i].ent == ent)
			return i;
	}

	return -1;
}

I64 HLMakerCountLive(I64 owner)
{//DeathNotice's decrement, recovered by counting. A child keeps its slot and
 //its owner after it dies; health at or below zero is what HLAI reads as dead
	I64 n = 0;
	I64 i;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use && hl_entities[i].owner == owner &&
			hl_entities[i].ent_class == HLC_MONSTER &&
			hl_entities[i].health > 0.0)
			n++;
	}

	return n;
}

Bool HLMakerBoxClear(CHLEntity *e, F64 ground)
{//"don't build a stack of monsters", monstermaker.cpp:176-183. A 68 unit square
 //column from the ground up to the maker, tested against monsters and the player
	F64	mins[3];
	F64	maxs[3];
	I64	i;

	HLVecSet(mins, e->origin[0] - 34.0, e->origin[1] - 34.0, ground);
	HLVecSet(maxs, e->origin[0] + 34.0, e->origin[1] + 34.0, e->origin[2]);

	if (!hl_ent_player_dead &&
		hl_ent_player_org[0] + 16.0 > mins[0] &&
		hl_ent_player_org[0] - 16.0 < maxs[0] &&
		hl_ent_player_org[1] + 16.0 > mins[1] &&
		hl_ent_player_org[1] - 16.0 < maxs[1] &&
		hl_ent_player_org[2] + 72.0 > mins[2] &&
		hl_ent_player_org[2] < maxs[2])
		return FALSE;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use ||
			hl_entities[i].ent_class != HLC_MONSTER ||
			hl_entities[i].health <= 0.0)
			goto qmbc_next;

		if (hl_entities[i].absmax[0] > mins[0] &&
			hl_entities[i].absmin[0] < maxs[0] &&
			hl_entities[i].absmax[1] > mins[1] &&
			hl_entities[i].absmin[1] < maxs[1] &&
			hl_entities[i].absmax[2] > mins[2] &&
			hl_entities[i].absmin[2] < maxs[2])
			return FALSE;

qmbc_next:
	}

	return TRUE;
}

U0 HLMakerMakeMonster(I64 self)
{//CMonsterMaker::MakeMonster, monstermaker.cpp:158
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*c;
	CHLTrace	 tr;
	U8			*path;
	F64			 down[3];
	I64			 mk;
	I64			 child;
	I64			 n;

	if (!e)
		return;

	mk = HLMakerFind(self);

	if (mk < 0)
		return;

	//CREATE_NAMED_ENTITY takes any class; the child path here is the monster
	//spawn only. Two makers in the shipped maps name ammo_357 instead
	if (StrNICompare(hl_maker[mk].monster, "monster_", 8))
		return;

	if (hl_maker[mk].max_live > 0)
	{
		hl_maker[mk].live = HLMakerCountLive(self);

		if (hl_maker[mk].live >= hl_maker[mk].max_live)
			return;
	}

	//"set altitude. Now that I'm activated, any breakables, etc should be out
	//from under me", monstermaker.cpp:168-173. Traced once and kept
	if (hl_maker[mk].ground == 0.0 && hl_map)
	{
		HLVecSet(down, e->origin[0], e->origin[1], e->origin[2] - 2048.0);
		HLTraceMove(hl_map, e->origin, down, &tr);
		hl_maker[mk].ground = tr.end_pos[2];
	}

	if (!HLMakerBoxClear(e, hl_maker[mk].ground))
		return;

	if (hl_num_entities >= HLENT_MAX)
		return;

	child = hl_num_entities;
	c     = &hl_entities[child];

	//a slot above the parsed count has never been written: HLEnt.ZC CAllocs the
	//whole HLENT_MAX table on every map load, so everything not set here is
	//already zero. Only the members whose resting value is not zero are listed
	HLStrCopy(c->classname, hl_maker[mk].monster, 64);

	c->brush_model      = -1;
	c->owner            = self;
	c->activator        = -1;
	c->beam_start       = -1;
	c->beam_end         = -1;
	c->light_style      = -1;
	c->light_valid      = FALSE;
	c->anim_event_frame = -1;
	c->anim_loop        = TRUE;
	c->framerate        = 10.0;
	c->scale            = 1.0;
	c->volume           = 1.0;
	c->modifier         = 100.0;
	c->blood_color      = 247;
	c->text_x           = -1.0;
	c->text_y           = -1.0;
	c->trigger_mode     = HLUSE_TOGGLE;
	c->toggle_state     = HLTS_AT_BOTTOM;

	HLVecCopy(e->origin, c->origin);
	HLVecCopy(e->angles, c->angles);

	//no engine drop for SF_MONSTER_FALL_TO_GROUND: stand the child on the plane
	//the altitude trace already found
	if (hl_maker[mk].ground != 0.0)
		c->origin[2] = hl_maker[mk].ground;

	//"if I have a netname (overloaded), give the child monster that name as a
	//targetname", monstermaker.cpp:210
	if (e->netname[0])
		HLStrCopy(c->targetname, e->netname, 64);

	//the parts of the monster_ spawn branch a child needs. That branch is in
	//HLEntSpawnClass, which compiles after this function, so it cannot be
	//called; HLAIMonRegisterAll overwrites the hull and health per kind
	c->movetype   = HLMOVETYPE_STEP;
	c->solid      = HLSOLID_SLIDEBOX;
	c->ent_class  = HLC_MONSTER;
	c->takedamage = HLDMG_TAKE_YES;
	c->health     = 20.0;
	c->spawned    = TRUE;
	c->in_use     = TRUE;

	HLVecSet(c->mins, -16.0, -16.0, 0.0);
	HLVecSet(c->maxs, 16.0, 16.0, 72.0);
	HLEntSetAbsBox(c);

	//UTIL_PrecacheOther's model. A child with none is scenery to
	//HLAIMonRegisterAll and never gets an AI slot
	path = HLEntModelForClass(c->classname);

	if (path)
	{
		c->studio = HLStudioCacheGet(path);

		if (c->studio)
			HLEntInitBoneControllers(c);
	}

	//the count moves last: HLAIMonSync registers on the change and must not see
	//a half-built slot
	hl_num_entities++;
	hl_maker_made++;

	//"delay already overloaded for this entity, so can't call SUB_UseTargets",
	//monstermaker.cpp:196-200
	if (e->target[0])
		HLEntFireTargetsNamed(e->target, self, self, HLUSE_TOGGLE, 0.0);

	hl_maker[mk].live++;

	if (hl_maker[mk].num_monsters > 0)
	{
		n = hl_maker[mk].num_monsters - 1;
		hl_maker[mk].num_monsters = n;

		//"Disable this forever. Don't kill it because it still gets death
		//notices", monstermaker.cpp:219
		if (n == 0)
		{
			hl_maker[mk].active = FALSE;
			e->use_fn   = HLM_NONE;
			e->think_fn = HLM_NONE;
			e->next_think = 0.0;
		}
	}
}

U0 HLMakerThink(I64 self)
{//CMonsterMaker::MakerThink, monstermaker.cpp:270
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);

	HLMakerMakeMonster(self);
}

U0 HLMakerUse(I64 self, I64 use_type)
{//CyclicUse drops one child per fire, monstermaker.cpp:241. ToggleUse flips the
 //think on and off, monstermaker.cpp:249
	CHLEntity	*e = HLEntGet(self);
	I64			 mk;

	if (!e)
		return;

	mk = HLMakerFind(self);

	if (mk < 0)
		return;

	if (e->spawnflags & HLSF_MAKER_CYCLIC)
	{
		HLMakerMakeMonster(self);
		return;
	}

	//ShouldToggle: an explicit ON or OFF that matches the current state is a
	//no-op, and only a TOGGLE flips
	if (use_type == HLUSE_ON && hl_maker[mk].active)
		return;

	if (use_type == HLUSE_OFF && !hl_maker[mk].active)
		return;

	if (hl_maker[mk].active)
	{
		hl_maker[mk].active = FALSE;
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	hl_maker[mk].active = TRUE;
	HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time);
}

//--- env_global -------------------------------------------------------------
#define HLSF_GLOBAL_SET_SPAWN	1

U0 HLGlobalUse(I64 self, I64 use_type)
{//triggermode overrides the incoming use type, which is how one env_global can
 //be fired by a generic trigger and still mean "turn this ON"
	CHLEntity	*e = HLEntGet(self);
	I64			 mode;
	I64			 state;

	if (!e || !e->global_state[0])
		return;

	mode = e->trigger_mode;

	if (mode == HLUSE_OFF || mode == HLUSE_ON || mode == HLUSE_SET)
		use_type = mode;

	state = HLEntGlobalGet(e->global_state);

	if (use_type == HLUSE_ON)
		state = HLGLOBAL_ON;
	else if (use_type == HLUSE_OFF)
		state = HLGLOBAL_OFF;
	else if (use_type == HLUSE_SET)
		state = HLGLOBAL_DEAD;
	else if (state == HLGLOBAL_ON)
		state = HLGLOBAL_OFF;
	else
		state = HLGLOBAL_ON;

	HLEntGlobalSet(e->global_state, state);
}

//--- items ------------------------------------------------------------------
//
// CItem::ItemTouch. Single player, so nothing respawns: a taken item is gone.
//
// A failed pickup leaves the item in the world: a medkit walked over at full
// health stays for later.

U0 HLItemTouch(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 took = FALSE;

	if (!e)
		return;

	if (!StrICompare(e->classname, "item_healthkit"))
	{
		//gSkillData.healthkitCapacity, skill 1
		if (hl_ent_player_health < HLENT_MAX_HEALTH)
		{
			hl_ent_player_health += 15.0;

			if (hl_ent_player_health > HLENT_MAX_HEALTH)
				hl_ent_player_health = HLENT_MAX_HEALTH;

			HLSndPlayAt("items/smallmedkit1.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, 0);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_battery"))
	{
		//CItemBattery::MyTouch, items.cpp:225-226: armour below the cap and
		//the suit bit set. Without the suit there is nothing to charge, and
		//the battery stays on the floor for after item_suit
		if (hl_ent_player_armor < HLENT_MAX_ARMOR && hl_ent_player_suit)
		{
			//gSkillData.batteryCapacity, sk_battery1, skill.cfg:336
			hl_ent_player_armor += 15.0;

			if (hl_ent_player_armor > HLENT_MAX_ARMOR)
				hl_ent_player_armor = HLENT_MAX_ARMOR;

			HLSndPlayAt("items/gunpickup2.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, 0);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_suit"))
	{
		if (!hl_ent_player_suit)
		{
			hl_ent_player_suit = TRUE;
			HLSndPlayAt("items/tr_kevlar.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, 0);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_longjump"))
	{
		//the module needs the suit, as in HL
		if (!hl_ent_player_longjump && hl_ent_player_suit)
		{
			hl_ent_player_longjump = TRUE;
			HLSndPlayAt("items/gunpickup2.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, 0, 0);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_antidote"))
	{
		//CItemAntidote's only effect in the shipped game is a message
		HLSndPlayAt("items/smallmedkit1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			0, 0);
		took = TRUE;
	}

	if (!took)
		return;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	//not touchable again either way, but the slot outlives a deferred fire -
	//see HLM_AUTO_THINK
	e->solid = HLSOLID_NOT;

	if (e->think_fn == HLM_FIRE_TARGETS)
		e->remove_after_fire = TRUE;
	else
		e->in_use = FALSE;
}

//--- chargers ---------------------------------------------------------------
//
// func_healthcharger and func_recharge. FCAP_CONTINUOUS_USE, h_battery.cpp:39
// and healthkit.cpp:113: one point every 0.1s while +use is down, stopping on
// release, on a full player, or on an empty pool.
//
// The think runs while HLChargerUse keeps stamping use_last. A shell that only
// delivers the key edge stamps once and the drain stops HLENT_USE_HOLD_GAP
// later; one that delivers a held key drains for as long as it is held.
//
// The range test stands in for the SDK's trace to the charger.
//gSkillData, gamerules.cpp:287 and :289, read from valve/skill.cfg at skill 1.
//30 is the deathmatch suit charger, multiplay_gamerules.cpp:139
#define HLENT_CHARGE_HEALTH		50.0	//sk_healthcharger1, skill.cfg:340
#define HLENT_CHARGE_ARMOR		75.0	//sk_suitcharger1, skill.cfg:332
#define HLENT_CHARGE_STEP		0.1		//seconds between points
#define HLENT_CHARGE_RANGE		72.0	//how far you can stand and still charge

U0 HLChargerThink(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];
	Bool		 health;
	Bool		 full;

	if (!e)
		return;

	//by classname, not by a reused field: "style" and "sounds" already carry a
	//lightstyle and a sound index
	health = ToBool(!StrICompare(e->classname, "func_healthcharger"));

	//key released. CBasePlayer::PlayerUse re-Uses a continuous entity only
	//while pev->button carries IN_USE, player.cpp:1669
	if (hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	HLVecSub(hl_ent_player_org, e->origin, dist);

	if (HLVecLength(dist) > HLENT_CHARGE_RANGE)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	if (e->charge <= 0.0)
	{
		//CBaseCharger plays a refusal once and then goes quiet
		HLEntSound(e, "items/suitchargeno1.wav", HLENT_CHAN_USE);
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	full = FALSE;

	if (health)
	{
		if (hl_ent_player_health >= HLENT_MAX_HEALTH)
			full = TRUE;
		else
			hl_ent_player_health += 1.0;
	}
	else
	{
		if (hl_ent_player_armor >= HLENT_MAX_ARMOR)
			full = TRUE;
		else
			hl_ent_player_armor += 1.0;
	}

	if (full)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	e->charge -= 1.0;

	HLEntSetThink(e, HLM_CHARGER_THINK, hl_ent_time + HLENT_CHARGE_STEP);
}

U0 HLChargerUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 first;

	if (!e)
		return;

	//a gap in the stamp means the key was released between this use and the
	//last, which is where the start cue belongs
	first       = ToBool(hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP);
	e->use_last = hl_ent_time;

	if (e->charge <= 0.0)
	{
		if (first)
			HLEntSound(e, "items/suitchargeno1.wav", HLENT_CHAN_USE);

		return;
	}

	//the start cue only. the SDK loops for as long as it is charging; stopping
	//a loop needs a channel this side can reclaim
	if (first)
	{
		if (!StrICompare(e->classname, "func_healthcharger"))
			HLEntSound(e, "items/medshot4.wav", HLENT_CHAN_USE);
		else
			HLEntSound(e, "items/suitchargeok1.wav", HLENT_CHAN_USE);
	}

	//already draining: the think owns the pacing, and re-entering it here
	//would give a point per tick instead of one every HLENT_CHARGE_STEP
	if (e->think_fn == HLM_CHARGER_THINK)
		return;

	HLChargerThink(self);
}

Bool HLEntCapsContinuousUse(CHLEntity *e)
{//FCAP_CONTINUOUS_USE: the class is Used every frame IN_USE is down rather
 //than once on the press, player.cpp:1669
 //
 //The wall chargers (h_battery.cpp:39, healthkit.cpp:113) and
 //momentary_rot_button unless SF_MOMENTARY_DOOR is set (buttons.cpp:884).
 //CPushable also carries it, func_break.cpp:790; pushing is a physics path
 //this port does not have
	if (e->use_fn == HLM_CHARGER_USE)
		return TRUE;

	if (e->use_fn != HLM_MOMENTARY_USE)
		return FALSE;

	return ToBool(!(e->spawnflags & HLSF_MOMENTARY_DOOR));
}

//--- trigger volumes that act on the player ---------------------------------

U0 HLConveyorTouch(I64 self)
{//func_conveyor. speed along movedir, as a push
 //
 //HL uses pmove->basevelocity, which does not accumulate and does not survive
 //stepping off. That global belongs to HLClip.ZC and is overwritten from the
 //water current every tick, so the push queue is used instead. Shows as extra
 //momentum when jumping off the belt.
	CHLEntity	*e = HLEntGet(self);
	F64			 speed;
	I64			 i;

	if (!e)
		return;

	speed = e->speed;
	if (speed == 0.0)
		speed = 100.0;

	for (i = 0; i < 3; i++)
		hl_ent_push_vel[i] = e->move_dir[i] * speed;

	hl_ent_push_pending = TRUE;
}

U0 HLFrictionTouch(I64 self)
{//func_friction. "modifier" is a percentage, 100 being normal
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//hl_surface_friction belongs to HLClip.ZC, which reads it inside
	//PM_Friction. HLEntFrame puts it back to 1.0 every tick, so stepping off
	//the brush restores normal traction without the brush being told
	hl_surface_friction = e->modifier / 100.0;

	if (hl_surface_friction <= 0.0)
		hl_surface_friction = 0.05;
}

U0 HLGravityTouch(I64 self)
{//trigger_gravity. persistent, not per tick - see hl_ent_gravity
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	hl_ent_gravity = e->gravity;

	if (hl_ent_gravity <= 0.0)
		hl_ent_gravity = 1.0;
}

U0 HLChangeLevelTouch(I64 self)
{//trigger_changelevel. the map name and the landmark are posted for the shell
 //
 //the trigger takes itself out of use immediately: the request sits for several
 //ticks until the shell's loop drains it, and a brush trigger re-touches on
 //every one of them
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	if (!e->next_map[0])
		return;

	if (hl_ent_changelevel_pending)
		return;

	HLStrCopy(hl_ent_changelevel, e->next_map, 64);
	HLStrCopy(hl_ent_changelevel_landmark, e->landmark, 64);
	hl_ent_changelevel_pending = TRUE;

	e->in_use = FALSE;
	e->solid  = HLSOLID_NOT;
}

//--- the dispatcher ---------------------------------------------------------
//
// The virtual call. Defined last, so every implementation above is visible;
// that is why methods are integers.

U0 HLEntCallMethod(I64 self, I64 method, I64 activator = -1,
	I64 use_type = HLUSE_TOGGLE, F64 value = 0.0)
{
	CHLEntity *e = HLEntGet(self);

	if (!e || method == HLM_NONE)
		return;

	switch (method)
	{
		case HLM_REMOVE:
			e->in_use = FALSE;
			e->solid  = HLSOLID_NOT;
			break;

		case HLM_FIRE_TARGETS:
			HLEntSetThink(e, HLM_NONE, 0.0);
			HLEntFireTargets(self, e->activator, use_type, value);

			//a fire-once entity that deferred through its delay is removed
			//HERE, not at the call site: see HLM_AUTO_THINK
			if (e->remove_after_fire)
				e->in_use = FALSE;
			break;

		case HLM_MOVE_DONE:
			//arrival: stop, snap to the exact destination, then hand over to
			//whatever asked for the move. moving_angular keeps the two kinds
			//of move apart - an angular arrival must not snap the origin to a
			//finaldest left over from a previous linear move
			if (e->moving_angular)
			{
				HLVecCopy(e->finalangle, e->angles);
				HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
				e->moving_angular = FALSE;

				//the rotating box is the orientation-independent radius, so it
				//is rebuilt even though the origin did not move
				HLEntSetAbsBox(e);
			}
			else
			{
				HLVecCopy(e->finaldest, e->origin);
				HLVecSet(e->velocity, 0.0, 0.0, 0.0);
				HLEntSetAbsBox(e);
			}

			HLEntSetThink(e, HLM_NONE, 0.0);
			HLEntCallMethod(self, e->move_done, activator, use_type, value);
			break;

		case HLM_DOOR_GO_UP:		HLDoorGoUp(self, activator);	break;
		case HLM_DOOR_GO_DOWN:		HLDoorGoDown(self);				break;
		case HLM_DOOR_HIT_TOP:		HLDoorHitTop(self);				break;
		case HLM_DOOR_HIT_BOTTOM:	HLDoorHitBottom(self);			break;
		case HLM_DOOR_USE:			HLDoorUse(self, activator);		break;
		case HLM_DOOR_LEAF:
			//a leaf reached through its group. Whether it swings or slides is
			//the leaf's own business, so a mixed group works
			if (e->use_fn == HLM_ROT_DOOR_USE)
				HLRotDoorUseLeaf(self, activator);
			else
				HLDoorUseLeaf(self, activator);
			break;

		case HLM_DOOR_TOUCH:
			//a touch-opened door ignores the touch when USE_ONLY is set
			if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
				HLDoorUse(self, activator);
			break;

		case HLM_DOOR_BLOCKED:		HLDoorBlocked(self, activator);	break;
		case HLM_PLAT_BLOCKED:		HLPlatBlocked(self, activator);	break;

		case HLM_BUTTON_USE:		HLButtonUse(self, activator);	break;
		case HLM_BUTTON_TOUCH:
			if (e->spawnflags & HLSF_BUTTON_TOUCH_ONLY)
				HLButtonUse(self, activator);
			break;
		case HLM_BUTTON_GO_UP:		HLButtonGoUp(self, activator);	break;
		case HLM_BUTTON_GO_DOWN:	HLButtonGoDown(self);			break;
		case HLM_BUTTON_HIT_TOP:	HLButtonHitTop(self);			break;
		case HLM_BUTTON_HIT_BOTTOM:	HLButtonHitBottom(self);		break;
		case HLM_BUTTON_RETURN:		HLButtonGoDown(self);			break;

		case HLM_TRAIN_NEXT:		HLTrainNext(self);				break;
		case HLM_TRAIN_WAIT:		HLTrainWait(self);				break;
		case HLM_TRAIN_USE:			HLTrainUse(self);				break;
		case HLM_TRAIN_START:		HLTrainNext(self);				break;
		case HLM_TRAIN_BLOCKED:		HLTrainBlocked(self, activator); break;

		case HLM_TRIGGER_TOUCH:		HLTriggerTouch(self, activator); break;
		case HLM_TRIGGER_USE:		HLTriggerUse(self, activator);	break;
		case HLM_RELAY_USE:			HLTriggerUse(self, activator);	break;
		case HLM_TRIGGER_ENABLE:	HLTriggerToggleUse(self);		break;

		case HLM_AUTO_THINK:
			//trigger_auto fires once at level start and is then gone.
			//
			//The removal cannot happen here when the entity has a delay key:
			//HLEntUseTargets defers such a fire onto this entity's own think,
			//and HLEntFrame skips a think on an entity with in_use clear, so
			//clearing it in the same breath cancels the fire that was just
			//scheduled. c0a0's intro is two of these - the tram start at .3s
			//and the announcer lines at 1s - and both were lost.
			//
			//The SDK does not have the problem because SUB_UseTargets spawns a
			//separate DelayedUse entity to own the delay, so UTIL_Remove on the
			//trigger_auto leaves the pending fire alone. remove_after_fire is
			//that separate entity, folded into a flag.
			//the think is already disarmed: the dispatch loop clears it before
			//the method runs, as SV_RunThink does
			e->remove_after_fire = ToBool(e->spawnflags & HLSF_AUTO_FIREONCE);

			HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

			//fired immediately - no delay, so nothing is pending and the
			//HLM_FIRE_TARGETS branch will never run
			if (e->remove_after_fire && e->think_fn != HLM_FIRE_TARGETS)
				e->in_use = FALSE;
			break;

		case HLM_AMBIENT_USE:		HLAmbientUse(self);				break;

		case HLM_MULTI_MANAGER_USE:	HLMMUse(self, activator);		break;
		case HLM_MULTI_MANAGER_TICK: HLMMTick(self);				break;

		case HLM_LIGHT_USE:			HLLightUse(self, use_type);		break;

		case HLM_SCRIPT_USE:
			//scripted_sequence lives in HLAI.ZC, which compiles after this
			//file, so the request is recorded and HLAIFrame picks it up on the
			//next tick. GOING_DOWN is "start requested" - a script has no
			//physical up and down
			if (e->toggle_state == HLTS_AT_BOTTOM)
			{
				e->activator    = activator;
				e->toggle_state = HLTS_GOING_DOWN;
			}
			break;

		case HLM_BREAK_DIE:			HLBreakableDie(self);			break;
		case HLM_HURT_TOUCH:		HLHurtTouch(self, activator);	break;
		case HLM_PUSH_TOUCH:		HLPushTouch(self);				break;
		case HLM_TELEPORT_TOUCH:	HLTeleportTouch(self);			break;

		case HLM_BREAK_USE:
			//a breakable fired rather than shot dies outright, which is how
			//SF_BREAK_TRIGGER_ONLY glass is broken by a script
			HLEntQueueCall(self, HLM_BREAK_DIE, activator, use_type, 0.0);
			break;

		case HLM_WALL_USE:
			//func_wall toggles its texture frame, which is how the SDK does
			//"switch the screen to the other image"
			e->frame = 1 - e->frame;
			break;

		//--- angular movers ---
		case HLM_ROT_DOOR_USE:		HLRotDoorUse(self, activator);	break;
		case HLM_ROT_DOOR_GO_UP:	HLRotDoorGoUp(self, activator);	break;
		case HLM_ROT_DOOR_GO_DOWN:	HLRotDoorGoDown(self);			break;
		case HLM_ROT_DOOR_HIT_TOP:	HLRotDoorHitTop(self);			break;
		case HLM_ROT_DOOR_HIT_BOTTOM: HLRotDoorHitBottom(self);		break;
		case HLM_ROT_DOOR_TOUCH:
			//same USE_ONLY rule as the linear door's touch
			if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
				HLRotDoorUse(self, activator);
			break;
		case HLM_ROTATE_USE:		HLRotatingUse(self, use_type);	break;
		case HLM_PENDULUM_USE:		HLPendulumUse(self);			break;
		case HLM_PENDULUM_SWING:	HLPendulumSwing(self);			break;

		//--- momentary ---
		//USE_SET is what CBasePlayer::PlayerUse sends a continuous-use class,
		//player.cpp:1675, and is how a held key is told from a press here
		case HLM_MOMENTARY_USE:
			HLMomentaryRotUse(self, activator,
				ToBool(use_type == HLUSE_SET));
			break;
		case HLM_MOMENTARY_DOOR_USE:
			HLMomentaryDoorUse(self, use_type, value);
			break;

		//--- effects ---
		case HLM_SPRITE_USE:		HLSpriteUse(self, use_type);	break;
		case HLM_BEAM_USE:			HLBeamUse(self, use_type);		break;
		case HLM_RENDER_USE:		HLRenderUse(self);				break;
		case HLM_MESSAGE_USE:		HLMessageUse(self);				break;
		case HLM_GAME_TEXT_USE:		HLGameTextUse(self);			break;
		case HLM_FADE_USE:			HLFadeUse(self);				break;
		case HLM_SHAKE_USE:			HLShakeUse(self);				break;
		case HLM_EXPLOSION_USE:		HLExplosionUse(self);			break;
		case HLM_EXPLOSION_SMOKE:	HLExplosionSmoke(self);			break;
		case HLM_SPARK_THINK:		HLSparkThink(self);				break;
		case HLM_SPARK_USE:			HLSparkUse(self, use_type);		break;
		case HLM_GLOBAL_USE:		HLGlobalUse(self, use_type);	break;

		case HLM_BUBBLE_USE:		HLBubbleUse(self, use_type);	break;
		case HLM_BUBBLE_THINK:		HLBubbleThink(self);			break;
		case HLM_SMOKER_THINK:		HLSmokerThink(self);			break;
		case HLM_FUNNEL_USE:		HLFunnelUse(self);				break;
		case HLM_BLOOD_USE:			HLBloodUse(self);				break;
		case HLM_SHOOTER_USE:		HLShooterUse(self);				break;
		case HLM_SHOOTER_THINK:		HLShooterThink(self);			break;
		case HLM_LASER_USE:			HLLaserUse(self, use_type);		break;
		case HLM_LASER_THINK:		HLLaserThink(self);				break;
		case HLM_BEAM_DAMAGE_THINK:	HLBeamDamageThink(self);		break;

		case HLM_DECAL_THINK:		HLDecalPlace(self);				break;
		case HLM_DECAL_USE:			HLDecalPlace(self);				break;
		case HLM_CDAUDIO_PLAY:		HLCDAudioPlay(self);			break;
		case HLM_CDAUDIO_RADIUS:	HLCDAudioRadiusThink(self);		break;
		case HLM_MAKER_USE:			HLMakerUse(self, use_type);		break;
		case HLM_MAKER_THINK:		HLMakerThink(self);				break;

		case HLM_SENTENCE_USE:
			//scripted_sentence lives in HLAI.ZC, which owns the sentence
			//scheduler and compiles after this file. GOING_DOWN is "requested",
			//as for scripted_sequence
			if (e->toggle_state == HLTS_AT_BOTTOM)
			{
				e->activator    = activator;
				e->toggle_state = HLTS_GOING_DOWN;
			}
			break;

		//--- items, chargers, player-affecting volumes ---
		case HLM_ITEM_TOUCH:		HLItemTouch(self);				break;
		case HLM_CHARGER_USE:		HLChargerUse(self);				break;
		case HLM_CHARGER_THINK:		HLChargerThink(self);			break;
		case HLM_CONVEYOR_TOUCH:	HLConveyorTouch(self);			break;
		case HLM_FRICTION_TOUCH:	HLFrictionTouch(self);			break;
		case HLM_GRAVITY_TOUCH:		HLGravityTouch(self);			break;
		case HLM_CHANGELEVEL_TOUCH:	HLChangeLevelTouch(self);		break;
		case HLM_CHANGELEVEL_USE:	HLChangeLevelTouch(self);		break;

		default:
			break;
	}
}

//--- spawning ---------------------------------------------------------------
//
// LINK_ENTITY_TO_CLASS. a comparison chain rather than a table for the reason
// given in HLEntModelForClass.
//
// A spawn function sets the physics type, the collision box, the method IDs
// and, for a mover, the two positions it travels between.

U0 HLEntSpawnToggleBrush(CHLMap *map, CHLEntity *e)
{//shared front half of every brush mover
	HLEntSetMoveDir(e);
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_PUSH;
	e->solid    = HLSOLID_BSP;

	if (e->speed <= 0.0)
		e->speed = 100.0;
}

U0 HLEntSpawnDoor(CHLMap *map, CHLEntity *e)
{//func_door / func_water. position1 is where it was built, position2 is
 //that plus the travel along move_dir
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	HLVecCopy(e->origin, e->position1);

	//the door slides its own size along the movement axis, less "lip" - so a
	//lip of 8 leaves 8 units of the door showing when open
	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	//START_OPEN swaps the endpoints instead of moving the brush, so every
	//later "go up" still means "go to position2"
	if (e->spawnflags & HLSF_DOOR_START_OPEN)
	{
		HLVecCopy(e->position2, e->origin);
		HLVecCopy(e->position1, e->position2);
		HLVecCopy(e->origin, e->position1);
	}

	e->ent_class    = HLC_DOOR;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_DOOR_USE;
	e->touch_fn     = HLM_DOOR_TOUCH;
	e->blocked_fn   = HLM_DOOR_BLOCKED;

	if (e->wait == 0.0)
		e->wait = 3.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnButton(CHLMap *map, CHLEntity *e)
{
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	if (e->speed <= 0.0)
		e->speed = 40.0;

	HLVecCopy(e->origin, e->position1);

	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	e->ent_class    = HLC_BUTTON;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_BUTTON_USE;
	e->touch_fn     = HLM_BUTTON_TOUCH;

	if (e->wait == 0.0)
		e->wait = 1.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnTrain(CHLMap *map, CHLEntity *e, I64 cls)
{
	CHLEntity	*node;
	I64			 first;

	HLEntSetBrushSize(map, e);

	e->movetype   = HLMOVETYPE_PUSH;
	e->solid      = HLSOLID_BSP;
	e->use_fn     = HLM_TRAIN_USE;
	e->blocked_fn = HLM_TRAIN_BLOCKED;
	e->ent_class  = cls;

	if (e->speed <= 0.0)
		e->speed = 100.0;

	//CFuncTrackTrain::Activate snaps the train onto its first path node at
	//spawn. Without this a train sits wherever its brush was built, which for
	//c0a0's tram is thousands of units from the track the player spawns on.
	//
	//Path nodes need not have spawned yet: the whole entity list is parsed
	//before any spawn function runs, so a targetname lookup resolves regardless
	//of spawn order.
	first = HLEntFindByTargetname(e->target, 0);

	if (first >= 0)
	{
		node = &hl_entities[first];

		//same parking rule as HLTrainNext - see the note there
		if (cls == HLC_TRACKTRAIN)
			HLVecCopy(node->origin, e->origin);
		else
		{
			e->origin[0] = node->origin[0] - e->mins[0];
			e->origin[1] = node->origin[1] - e->mins[1];
			e->origin[2] = node->origin[2] - e->mins[2];
		}
	}

	//func_train reads bit 2 as START_ON; a tracktrain reads it as FORWARDONLY
	//and starts on its own startspeed instead
	if (cls == HLC_TRAIN)
	{
		//START_ON, or nothing in the map can name it: an unnamed train with a
		//path is meant to be running
		if (e->spawnflags & HLSF_TRAIN_START_ON || !e->targetname[0])
			HLEntSetThink(e, HLM_TRAIN_START, hl_ent_time + 0.1);
	}
	else if (e->start_speed != 0.0)
	{
		//CFuncTrackTrain has no Activate. Spawn always thinks Find at +0.1
		//(plats.cpp:1521), Find sets pev->speed = m_startSpeed (plats.cpp:1406)
		//and Next parks at once when speed is 0 (plats.cpp:1166). So a
		//tracktrain self-starts iff startspeed is nonzero, named or not:
		//c0a0a's tram carries targetname "train" and startspeed 300 and nothing
		//in the map fires it.
		e->speed = e->start_speed;
		HLEntSetThink(e, HLM_TRAIN_START, hl_ent_time + 0.1);
	}

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnPlat(CHLMap *map, CHLEntity *e)
{//func_plat - a lift between two heights on the Z axis
 //
 //CFuncPlat derives the travel from the brush height when "height" is absent,
 //and rests at the top
	HLEntSetBrushSize(map, e);

	e->movetype   = HLMOVETYPE_PUSH;
	e->solid      = HLSOLID_BSP;
	e->ent_class  = HLC_PLAT;
	e->use_fn     = HLM_DOOR_USE;
	e->touch_fn   = HLM_DOOR_TOUCH;
	e->blocked_fn = HLM_PLAT_BLOCKED;

	if (e->speed <= 0.0)
		e->speed = 150.0;

	if (e->height <= 0.0)
		e->height = e->size[2] - e->lip;

	if (e->height <= 0.0)
		e->height = 64.0;

	//reuse the door mover: position2 is "extended", which for a lift is down
	HLVecCopy(e->origin, e->position1);
	HLVecCopy(e->origin, e->position2);
	e->position2[2] -= e->height;

	e->toggle_state = HLTS_AT_BOTTOM;

	if (e->wait == 0.0)
		e->wait = 3.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnTrigger(CHLMap *map, CHLEntity *e, Bool once)
{//brush triggers are invisible and non-solid but still tested for overlap
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_TRIGGER;

	//CBaseTrigger::InitTrigger: EF_NODRAW unless showtriggers is set. Without
	//it the renderer draws the trigger volume as a wall, texture and all -
	//AAATRIGGER and whatever else the mapper left on the brush.
	if (HLCvarGet("showtriggers") == 0.0)
		e->effects = e->effects | HLEF_NODRAW;
	e->touch_fn = HLM_TRIGGER_TOUCH;
	e->use_fn   = HLM_TRIGGER_USE;

	if (once)
		e->wait = -1.0;
	else if (e->wait == 0.0)
		e->wait = 0.2;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotBrush(CHLMap *map, CHLEntity *e, I64 self, I64 flag_roll,
	I64 flag_pitch)
{//shared front half of every angular brush mover
 //
 //not HLEntSpawnToggleBrush: that calls HLEntSetMoveDir, which reads the "angle"
 //key as a translation direction and zeroes angles[1] on the way out. For a
 //rotating brush the authored angles are its rest orientation.
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_PUSH;

	if (e->speed <= 0.0)
		e->speed = 100.0;

	HLEntAxisDir(e, flag_roll, flag_pitch);

	//"backwards" is bit 2 for every rotating class in HL
	if (e->spawnflags & HLSF_DOOR_ROTATE_BACKWARDS)
		HLVecScale(e->move_dir, -1.0, e->move_dir);

	//register with the collision side. opt in per entity: e->angles alone is not
	//a safe signal, since HLTrainNext writes yaw into angles[1] every frame as
	//bookkeeping and auto-detection would rotate every moving train's hull. The
	//renderer gates on HLClipIsRotating too, so draw and collide agree
	e->rotates = TRUE;
	HLClipSetRotating(self, TRUE);

	//after e->rotates, which the box depends on
	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotDoor(CHLMap *map, CHLEntity *e, I64 self)
{//func_door_rotating. CRotDoor: a func_door whose travel is in degrees
	F64 saved[3];

	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	//distance 0 cannot move. the SDK warns and leaves it stuck, which here seals
	//a doorway with a solid brush, so it defaults to 90 degrees
	if (e->distance == 0.0)
		e->distance = 90.0;

	HLVecCopy(e->angles, e->angle1);
	HLVecMA(e->angle1, e->distance, e->move_dir, e->angle2);

	if (e->spawnflags & HLSF_DOOR_PASSABLE)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//START_OPEN puts the door at angle2 and swaps the endpoints, so downstream
	//"go up" still means angle2. Same as the linear door's two positions
	if (e->spawnflags & HLSF_DOOR_START_OPEN)
	{
		HLVecCopy(e->angle1, saved);
		HLVecCopy(e->angle2, e->angles);
		HLVecCopy(saved, e->angle2);
		HLVecCopy(e->angles, e->angle1);
		HLVecScale(e->move_dir, -1.0, e->move_dir);
	}

	e->ent_class    = HLC_DOOR;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_ROT_DOOR_USE;
	e->touch_fn     = HLM_ROT_DOOR_TOUCH;
	e->blocked_fn   = HLM_DOOR_BLOCKED;

	if (e->wait == 0.0)
		e->wait = 3.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotating(CHLMap *map, CHLEntity *e, I64 self)
{//func_rotating - fans and turbines. its own axis flag bits, 4 and 8, not the
 //door's 64 and 128
	U8	*snd;
	F64	 vol;

	HLEntSpawnRotBrush(map, e, self, HLSF_ROTATE_Z_AXIS, HLSF_ROTATE_X_AXIS);

	e->ent_class    = HLC_ROTATE;
	e->use_fn       = HLM_ROTATE_USE;
	e->toggle_state = HLTS_AT_BOTTOM;

	if (e->spawnflags & HLSF_ROTATE_NOT_SOLID)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//the fan loop. registered once, at spawn, and only for a fan that starts
	//running: the ambient mixer can start a loop but cannot stop or retune one,
	//so a toggled fan would hum on after being switched off
	snd = HLEntFanSound(e->snd_index);

	//func_rotating's "volume" is 0-10, like ambient_generic's
	vol = e->volume;
	if (vol > 1.0)
		vol = vol / 10.0;
	if (vol <= 0.0 || vol > 1.0)
		vol = 1.0;

	//SF_BRUSH_ROTATE_INSTANT, or nothing in the map can name it: a fan with a
	//speed and no trigger is meant to be running
	if ((e->spawnflags & HLSF_ROTATE_INSTANT) || !e->targetname[0])
	{
		HLRotatingUse(self, HLUSE_ON);

		if (snd)
			HLSndAmbientAdd(e->origin, snd, vol, HLENT_SND_ATTEN);
	}
}

U0 HLEntSpawnPendulum(CHLMap *map, CHLEntity *e, I64 self)
{//func_pendulum. CPendulum uses the door's axis bits, not the fan's
 //
 //fields reused rather than added, safe because a pendulum is never also one of
 //the classes that wants them:
 //
 //   height          the constant angular acceleration, speed^2 / 2*distance
 //   angle2          the centre of the swing, not an endpoint
 //   momentary_frac  the signed angular speed the integrator carries
	F64 dist;

	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	e->ent_class = HLC_ROTATE;
	e->use_fn    = HLM_PENDULUM_USE;

	if (e->spawnflags & HLSF_DOOR_PASSABLE)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	dist = HLEntAbsF(e->distance);

	//no distance means no swing. left inert rather than defaulted: a pendulum is
	//decoration, unlike a door that would seal a corridor
	if (dist < 0.0001)
		return;

	e->height = e->speed * e->speed / (2.0 * dist);

	HLVecCopy(e->angles, e->angle1);
	HLVecMA(e->angle1, e->distance * 0.5, e->move_dir, e->angle2);

	e->momentary_frac = 0.0;

	if ((e->spawnflags & HLSF_ROTATE_INSTANT) || !e->targetname[0])
		HLPendulumSwing(self);
}

U0 HLEntSpawnMomentaryRot(CHLMap *map, CHLEntity *e, I64 self)
{//momentary_rot_button - a valve wheel. see the deviation note on
 //HLMomentaryRotUse: each +use ratchets it one step, because +use is an edge
	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	e->ent_class = HLC_ROTATE;
	e->use_fn    = HLM_MOMENTARY_USE;

	if (e->spawnflags & HLSF_MOMENTARY_DOOR)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//a negative distance turns the other way: the authored angles are then the
	//fully-open end, not the closed one
	if (e->distance < 0.0)
	{
		HLVecCopy(e->angles, e->angle2);
		HLVecMA(e->angle2, -e->distance, e->move_dir, e->angle1);
		HLVecCopy(e->angle1, e->angles);
	}
	else
	{
		HLVecCopy(e->angles, e->angle1);
		HLVecMA(e->angle1, e->distance, e->move_dir, e->angle2);
	}

	e->momentary_frac = 0.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnMomentaryDoor(CHLMap *map, CHLEntity *e)
{//momentary_door - a linear door parked proportionally by a USE_SET value
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	HLVecCopy(e->origin, e->position1);

	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	e->ent_class      = HLC_DOOR;
	e->use_fn         = HLM_MOMENTARY_DOOR_USE;
	e->momentary_frac = 0.0;

	//no touch and no ordinary use: a momentary door has no state to toggle, and
	//wiring it to HLM_DOOR_USE would make it snap fully open on a bump
	e->touch_fn = HLM_NONE;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnSprite(CHLEntity *e, Bool toggleable)
{//env_sprite / env_glow / cycler_sprite. the sprite itself was resolved by
 //HLEntLoadModels, which is the pass that owns "model key to loaded model"
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_NOT;
	e->ent_class = HLC_SPRITE;

	if (e->scale <= 0.0)
		e->scale = 1.0;

	if (!toggleable)
	{
		//env_glow and cycler_sprite have no Use - always visible
		e->visible = TRUE;
		return;
	}

	e->use_fn = HLM_SPRITE_USE;

	//SF_SPRITE_STARTON, or nothing in the map can name it: an unnamed sprite
	//waiting to be switched on waits forever, and HL1's flare and glow sprites
	//carry no targetname. Same rule as the unnamed scripted_sequence above
	e->visible = ToBool((e->spawnflags & HLSF_SPRITE_STARTON) ||
		!e->targetname[0]);
}

U0 HLEntSpawnBeam(CHLEntity *e)
{//env_beam / env_laser. the endpoints are targetnames, resolved to indices here
 //because the whole entity list is parsed before any spawn function runs
	e->movetype   = HLMOVETYPE_NONE;
	e->solid      = HLSOLID_NOT;
	e->ent_class  = HLC_BEAM;
	e->use_fn     = HLM_BEAM_USE;

	e->beam_start = HLEntFindByTargetname(e->beam_start_name, 0);
	e->beam_end   = HLEntFindByTargetname(e->beam_end_name, 0);

	//PRECACHE_MODEL( (char *)STRING(m_iszSpriteName) ), effects.cpp:466. The
	//draw pass runs off e->spr and must not touch the loader
	if (e->texture[0] && !e->spr)
		e->spr = HLEntSprCacheGet(e->texture);

	//env_laser fires from its own origin, so a missing start end is normal
	e->visible = ToBool((e->spawnflags & HLSF_BEAM_STARTON) ||
		!e->targetname[0]);

	e->beam_active = e->visible;

	//CLightning::ServerSide - a beam with no "life" is a permanent one the
	//server owns, and only that kind carries damage. m_active gates it, so the
	//think is armed whatever the state and tests the flag itself
	if (e->damage > 0.0 && e->beam_life == 0.0 &&
		!(e->spawnflags & HLSF_BEAM_RING))
		HLEntSetThink(e, HLM_BEAM_DAMAGE_THINK, hl_ent_time + 0.1);
}

U0 HLEntSpawnLaser(CHLEntity *e)
{//CLaser::Spawn, effects.cpp:960. Unlike env_beam it has a strike think of its
 //own, so it is a separate spawn rather than a flag on the beam one
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_NOT;
	e->ent_class = HLC_BEAM;
	e->use_fn    = HLM_LASER_USE;

	//LaserTarget, which the parser puts in the shared end-name field
	e->beam_start = -1;
	e->beam_end   = HLEntFindByTargetname(e->beam_end_name, 0);

	if (e->texture[0] && !e->spr)
		e->spr = HLEntSprCacheGet(e->texture);

	//"if ( pev->targetname && !(pev->spawnflags & SF_BEAM_STARTON) ) TurnOff()"
	e->visible = ToBool((e->spawnflags & HLSF_BEAM_STARTON) ||
		!e->targetname[0]);

	e->beam_active = e->visible;

	if (e->visible)
		HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time + 0.1);
}

U0 HLEntSpawnBubbles(CHLMap *map, CHLEntity *e)
{//CBubbling::Spawn - a brush volume, never solid and never drawn
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;
	e->use_fn   = HLM_BUBBLE_USE;

	//"renderamt = 0 - the engine won't draw this model if this is set to 0 and
	//blending is on". The comment above says never drawn; nothing enforced it,
	//and the water volumes carry AAATRIGGER
	e->effects = e->effects | HLEF_NODRAW;

	HLEntSetAbsBox(e);

	//"if ( !(pev->spawnflags & SF_BUBBLES_STARTOFF) ) nextthink = time + 2.0"
	if (!(e->spawnflags & HLSF_BUBBLES_STARTOFF))
		HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + 2.0);
}

U0 HLEntSpawnShooter(CHLEntity *e)
{//CGibShooter::Spawn, shared by env_shooter
	HLEntSetMoveDir(e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;
	e->use_fn   = HLM_SHOOTER_USE;

	//"if ( m_flDelay == 0 ) m_flDelay = 0.1" and "if ( m_flGibLife == 0 )
	//m_flGibLife = 25". The delay key is the gap between gibs here, not a fire
	//delay, so a shooter must never route through HLEntUseTargets' deferral
	if (e->delay == 0.0)
		e->delay = 0.1;

	if (e->gib_life == 0.0)
		e->gib_life = 25.0;

	if (e->gib_count < 1)
		e->gib_count = 1;

	e->gib_left = e->gib_count;
}

U0 HLEntSpawnItem(CHLEntity *e)
{//item_healthkit and friends
 //
 //HL spawns items MOVETYPE_TOSS so they settle onto the floor. There is no toss
 //integrator for non-player entities here, so an item stays where the mapper put
 //it
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_TRIGGER;
	e->ent_class = HLC_ITEM;
	e->touch_fn  = HLM_ITEM_TOUCH;

	//CItem::Spawn's UTIL_SetSize. an item has no brush model, so its bounds
	//would otherwise be a zero-size point at the origin
	HLVecSet(e->mins, -16.0, -16.0, 0.0);
	HLVecSet(e->maxs, 16.0, 16.0, 16.0);

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnCharger(CHLMap *map, CHLEntity *e, Bool health)
{//func_healthcharger / func_recharge - a solid wall unit operated with +use
	HLEntSetBrushSize(map, e);

	e->movetype  = HLMOVETYPE_PUSH;
	e->solid     = HLSOLID_BSP;
	e->ent_class = HLC_CHARGER;
	e->use_fn    = HLM_CHARGER_USE;

	if (health)
		e->charge = HLENT_CHARGE_HEALTH;
	else
		e->charge = HLENT_CHARGE_ARMOR;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnInert(CHLMap *map, CHLEntity *e, Bool hide = FALSE)
{//recognised, no behaviour. a brush entity still gets its bounds for a later
 //pass, and is never solid
 //
 //hide is for the classes whose own Spawn takes the model off the screen:
 //CFuncMonsterClip and CFuncMortarField set EF_NODRAW, CFuncTankControls sets
 //it too, and CTriggerVolume zeroes modelindex outright. The rest keep a
 //visible brush in HL - func_guntarget and func_trackchange are meant to be
 //seen - so this is per class rather than blanket
	if (e->brush_model >= 1)
		HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;

	if (hide && HLCvarGet("showtriggers") == 0.0)
		e->effects = e->effects | HLEF_NODRAW;
}

U0 HLEntSetSeqByName(CHLEntity *e, U8 *label)
{//pev->sequence = LookupSequence(label), and hold it
 //
 //a pose is a take of its own, not a loop: the body plays once and stays on
 //its last frame, which is what pev->framerate = 0 leaves in the SDK. A label
 //the model does not carry leaves the sequence alone rather than falling back
 //to sequence 0, which for scientist.mdl is the walk cycle
	I64 seq;

	if (!e->studio || !label || !label[0])
		return;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
		return;

	e->seq              = seq;
	e->frame            = 0;
	e->anim_start       = hl_ent_time;
	e->anim_loop        = FALSE;
	e->anim_done        = FALSE;
	e->anim_event_frame = -1;
}

U0 HLEntScientistHead(CHLEntity *e)
{//the head half of CScientist::Spawn, shared by the sitting and dead classes
 //
 //NUM_SCIENTIST_HEADS is 4 and a body of -1 asks for a random one. HEAD_LUTHER
 //is 2 and takes skin 1, so his hands match his face
	if (e->body == -1)
		e->body = HLPartRandI(4);

	if (e->body == 2)
		e->skin = 1;
	else
		e->skin = 0;
}

U0 HLEntSitScientistSeq(CHLEntity *e, I64 which)
{//SITTING_ANIM_*, scientist.cpp
 //
 //the SDK indexes off m_baseSequence = LookupSequence("sitlookleft") and
 //trusts the five to be contiguous. They are - 71 to 75 in scientist.mdl - but
 //each is looked up by its own name here, so a model that reorders them still
 //sits down. A chain, not a table of literals: adjacent string literals
 //concatenate by length on this compiler and collapse such a table to one
 //entry
	if (which <= 0)
	{
		HLEntSetSeqByName(e, "sitlookleft");
		return;
	}

	if (which == 1)
	{
		HLEntSetSeqByName(e, "sitlookright");
		return;
	}

	if (which == 2)
	{
		HLEntSetSeqByName(e, "sitscared");
		return;
	}

	if (which == 3)
	{
		HLEntSetSeqByName(e, "sitting2");
		return;
	}

	HLEntSetSeqByName(e, "sitting3");
}

U0 HLEntDeadPose(CHLEntity *e)
{//m_szPoses[m_iPose] for whichever dead class this is
 //
 //four tables, one per class, each in its own comparison chain for the reason
 //HLEntSitScientistSeq gives. CDeadScientist's index 3 is "dead_hang", which
 //the shipped scientist.mdl does not carry; the SDK complains and leaves the
 //model on sequence 0, and so does this
	I64 pose = e->pose;

	if (pose < 0)
		pose = 0;

	if (!StrCompare(e->classname, "monster_scientist_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "lying_on_back");
		if (pose == 1)	HLEntSetSeqByName(e, "lying_on_stomach");
		if (pose == 2)	HLEntSetSeqByName(e, "dead_sitting");
		if (pose == 3)	HLEntSetSeqByName(e, "dead_hang");
		if (pose == 4)	HLEntSetSeqByName(e, "dead_table1");
		if (pose == 5)	HLEntSetSeqByName(e, "dead_table2");
		if (pose >= 6)	HLEntSetSeqByName(e, "dead_table3");
		return;
	}

	if (!StrCompare(e->classname, "monster_barney_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "lying_on_back");
		if (pose == 1)	HLEntSetSeqByName(e, "lying_on_side");
		if (pose >= 2)	HLEntSetSeqByName(e, "lying_on_stomach");
		return;
	}

	if (!StrCompare(e->classname, "monster_hgrunt_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "deadstomach");
		if (pose == 1)	HLEntSetSeqByName(e, "deadside");
		if (pose >= 2)	HLEntSetSeqByName(e, "deadsitting");
		return;
	}

	//CDeadHEV, which wears the player model
	if (pose == 0)	HLEntSetSeqByName(e, "deadback");
	if (pose == 1)	HLEntSetSeqByName(e, "deadsitting");
	if (pose == 2)	HLEntSetSeqByName(e, "deadstomach");
	if (pose >= 3)	HLEntSetSeqByName(e, "deadtable");
}

U0 HLEntSpawnDeadMonster(CHLEntity *e)
{//CBaseMonster::MonsterInitDead, plus the pose each dead class picks
 //
 //UTIL_SetSize(g_vecZero, g_vecZero): a corpse has no hull and blocks nothing,
 //which is why the box clip skips a zero-sized entity
	e->movetype   = HLMOVETYPE_TOSS;
	e->solid      = HLSOLID_BBOX;
	e->effects    = 0;
	e->takedamage = HLDMG_TAKE_YES;

	if (e->health <= 0.0)
		e->health = 8.0;

	e->max_health = e->health;

	HLVecSet(e->mins, 0.0, 0.0, 0.0);
	HLVecSet(e->maxs, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);

	if (!StrCompare(e->classname, "monster_scientist_dead"))
		HLEntScientistHead(e);

	HLEntDeadPose(e);
}

I64 HLEntSpawnOne(CHLMap *map, I64 i)
{//returns 1 if the classname was recognised
	CHLEntity	*e = &hl_entities[i];
	I64			 slot;

	if (e->spawned)
		return 0;

	e->spawned = TRUE;

	//--- doors ---
	if (!StrCompare(e->classname, "func_door") ||
		!StrCompare(e->classname, "func_water"))
	{
		HLEntSpawnDoor(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "func_door_rotating"))
	{
		HLEntSpawnRotDoor(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "momentary_door"))
	{
		HLEntSpawnMomentaryDoor(map, e);
		return 1;
	}

	//--- buttons ---
	if (!StrCompare(e->classname, "func_button") ||
		!StrCompare(e->classname, "func_rot_button"))
	{
		//func_rot_button turns in HL and is spawned as a linear button here. It
		//appears in no HL1 map - the census is momentary_rot_button and
		//func_button only - so it shares the linear path
		HLEntSpawnButton(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "momentary_rot_button"))
	{
		HLEntSpawnMomentaryRot(map, e, i);
		return 1;
	}

	//--- rotating brushwork ---
	if (!StrCompare(e->classname, "func_rotating"))
	{
		HLEntSpawnRotating(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "func_pendulum"))
	{
		HLEntSpawnPendulum(map, e, i);
		return 1;
	}

	//--- trains ---
	if (!StrCompare(e->classname, "func_train") ||
		!StrCompare(e->classname, "func_tracktrain"))
	{
		if (!StrCompare(e->classname, "func_tracktrain"))
		{
			HLEntSpawnTrain(map, e, HLC_TRACKTRAIN);

			//The car turns, so its hull and its bounds turn. An axial hull on
			//a 288 by 150 car drops the rider through the deck past 22 degrees
			//of yaw; an axial box makes HLEntPlayerRides miss them at the ends
			//and the carry stops. Bank (the "bank" key) is not applied: HL
			//drives it through avelocity.z over several frames.
			HLClipSetRotating(i, TRUE);
			e->rotates = TRUE;

			//HLEntSpawnTrain already sized the box with rotates clear
			HLEntSetAbsBox(e);
		}
		else
			HLEntSpawnTrain(map, e, HLC_TRAIN);

		return 1;
	}

	if (!StrCompare(e->classname, "path_corner") ||
		!StrCompare(e->classname, "path_track"))
	{
		//pure data - a named point with a target and an optional wait
		e->movetype  = HLMOVETYPE_NONE;
		e->solid     = HLSOLID_NOT;
		e->ent_class = HLC_PATH;
		return 1;
	}

	if (!StrCompare(e->classname, "func_plat") ||
		!StrCompare(e->classname, "func_platrot"))
	{
		HLEntSpawnPlat(map, e);
		return 1;
	}

	//--- triggers ---
	if (!StrCompare(e->classname, "trigger_once"))
	{
		HLEntSpawnTrigger(map, e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_multiple"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_hurt"))
	{
		//CTriggerHurt::Spawn, dlls/triggers.cpp:808
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_HURT_TOUCH;

		//"if ( !FStringNull ( pev->targetname ) ) SetUse ( ToggleUse ); else
		//SetUse ( NULL )". A named hurt volume is switched on and off, never
		//used as a relay, so the generic trigger use must not stand
		if (e->targetname[0])
			e->use_fn = HLM_TRIGGER_ENABLE;
		else
			e->use_fn = HLM_NONE;

		//SF_TRIGGER_HURT_START_OFF, dlls/triggers.cpp:828
		if (e->spawnflags & HLSF_HURT_START_OFF)
			e->solid = HLSOLID_NOT;

		if (e->dmg == 0.0)
			e->dmg = 10.0;

		HLEntSetAbsBox(e);

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_push"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		HLEntSetMoveDir(e);
		e->touch_fn = HLM_PUSH_TOUCH;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_teleport"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_TELEPORT_TOUCH;

		//the target names the destination and is CONSUMED by the teleport, so
		//the generic use path must not also fire it
		e->use_fn = HLM_NONE;

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_relay"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_RELAY_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_changelevel"))
	{
		//a brush volume, not a point entity: it has a "model" and the player
		//crossing it is the trigger. Spawned as a relay it fires its target and
		//never changes level
		HLEntSpawnTrigger(map, e, TRUE);

		e->touch_fn = HLM_CHANGELEVEL_TOUCH;

		//USE_ONLY: fired by a script rather than walked into. c1a0's tram
		//transition is one of these
		e->use_fn = HLM_CHANGELEVEL_USE;

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_gravity"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_GRAVITY_TOUCH;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_auto"))
	{
		//fires once shortly after level start. CAutoTrigger::Precache sets
		//nextthink to time + 0.1 and nothing else: the fixed tenth lets the
		//rest of the map finish spawning.
		//
		//The delay key belongs to SUB_UseTargets, which defers the fire by it,
		//and is not part of this schedule. Scheduling the think at +delay as
		//well spent it twice: c0a0's announcer trigger has delay 1 and fired
		//at 2s, and every trigger_auto in the map ran a delay behind the
		//sequencing the mapper wrote
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		HLEntSetThink(e, HLM_AUTO_THINK, hl_ent_time + 0.1);
		return 1;
	}

	if (!StrCompare(e->classname, "multi_manager"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_MULTI_MANAGER_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "multisource"))
	{
		//every input must be on before it satisfies a master check. no input
		//logic here, so it starts satisfied: unlocked rather than locked
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->toggle_state = HLTS_AT_TOP;
		e->use_fn       = HLM_TRIGGER_USE;
		return 1;
	}

	//--- static brushwork ---
	if (!StrCompare(e->classname, "func_breakable") ||
		!StrCompare(e->classname, "func_pushable"))
	{
		HLEntSetBrushSize(map, e);

		e->movetype   = HLMOVETYPE_PUSH;
		e->solid      = HLSOLID_BSP;
		e->ent_class  = HLC_WALL;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 1.0;

		//SF_BREAK_TRIGGER_ONLY. such a brush ignores damage entirely and only
		//goes when a script says so
		if (e->spawnflags & 1)
		{
			e->takedamage = HLDMG_TAKE_NO;
			e->use_fn     = HLM_BREAK_USE;
		}
		else
			e->use_fn = HLM_BREAK_USE;

		return 1;
	}

	if (!StrCompare(e->classname, "func_wall") ||
		!StrCompare(e->classname, "func_wall_toggle"))
	{
		HLEntSetBrushSize(map, e);
		e->movetype  = HLMOVETYPE_PUSH;
		e->solid     = HLSOLID_BSP;
		e->ent_class = HLC_WALL;
		e->use_fn    = HLM_WALL_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "func_illusionary"))
	{
		//CFuncIllusionary: drawn, and not solid. The one brush class that is
		//meant to be seen without being touched
		HLEntSetBrushSize(map, e);
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	if (!StrCompare(e->classname, "func_ladder"))
	{
		//CLadder::Precache. Not solid, and invisible unless showtriggers is
		//set - HL hides it with rendermode kRenderTransTexture and renderamt 0
		//rather than EF_NODRAW, which comes to the same thing for a renderer
		//that acts on the one bit. Climbing is not ported; the volume still has
		//to disappear, and it is the single biggest source of a mapper texture
		//left on screen: 171 of them over 55 maps, all AAATRIGGER
		HLEntSetBrushSize(map, e);
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		if (HLCvarGet("showtriggers") == 0.0)
			e->effects = e->effects | HLEF_NODRAW;

		return 1;
	}

	if (!StrCompare(e->classname, "func_conveyor"))
	{
		//solid, since the player stands on the belt, and it pushes on touch.
		//HLEntTouchPlayer special-cases this touch_fn - a solid brush is not
		//otherwise touch tested
		HLEntSetBrushSize(map, e);
		HLEntSetMoveDir(e);

		e->movetype  = HLMOVETYPE_PUSH;
		e->solid     = HLSOLID_BSP;
		e->ent_class = HLC_WALL;
		e->touch_fn  = HLM_CONVEYOR_TOUCH;

		HLEntSetAbsBox(e);
		return 1;
	}

	if (!StrCompare(e->classname, "func_friction"))
	{
		//a volume, not a surface: HL implements "this floor is slippery" as a
		//trigger brush you walk through, which is why it has no visible model
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_FRICTION_TOUCH;
		e->use_fn   = HLM_NONE;
		return 1;
	}

	if (!StrCompare(e->classname, "func_healthcharger"))
	{
		HLEntSpawnCharger(map, e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "func_recharge"))
	{
		HLEntSpawnCharger(map, e, FALSE);
		return 1;
	}

	//--- items ---
	if (!StrCompare(e->classname, "item_healthkit") ||
		!StrCompare(e->classname, "item_battery") ||
		!StrCompare(e->classname, "item_suit") ||
		!StrCompare(e->classname, "item_longjump") ||
		!StrCompare(e->classname, "item_antidote"))
	{
		HLEntSpawnItem(e);
		return 1;
	}

	//weapon_* and ammo_* belong to HLWeapon.ZC, which walks the entity list
	//itself and rebuilds the pickup box from the origin. Recognised here, and
	//left non-solid and touch-less so both pickup paths cannot claim one item
	if (!StrNICompare(e->classname, "weapon_", 7) ||
		!StrNICompare(e->classname, "ammo_", 5))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	//--- env_*: the effect family ---
	if (!StrCompare(e->classname, "env_sprite"))
	{
		HLEntSpawnSprite(e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "env_glow") ||
		!StrCompare(e->classname, "cycler_sprite"))
	{
		HLEntSpawnSprite(e, FALSE);
		return 1;
	}

	if (!StrCompare(e->classname, "env_beam") ||
		!StrCompare(e->classname, "env_lightning"))
	{
		HLEntSpawnBeam(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_laser"))
	{
		HLEntSpawnLaser(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_render"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_RENDER_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_message"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_MESSAGE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "game_text"))
	{
		//the only difference from env_message is where the words come from:
		//game_text's are already in "message", env_message's are a key into
		//titles.txt. Two methods rather than one classname test per fire
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_GAME_TEXT_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_fade"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_FADE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_shake"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_SHAKE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_explosion"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_EXPLOSION_USE;

		//CEnvExplosion::Spawn's m_spriteScale, floored at 10. The scale field is
		//otherwise a sprite's, and env_explosion has no sprite
		e->scale = (e->magnitude - 50.0) * 0.6;

		if (e->scale < 10.0)
			e->scale = 10.0;

		return 1;
	}

	if (!StrCompare(e->classname, "env_spark"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_SPARK_USE;

		//the spark direction is the "angle" key. resolving it here is safe -
		//env_spark has no brushwork whose orientation could be lost
		HLEntSetMoveDir(e);

		if (e->max_delay <= 0.0)
			e->max_delay = 1.5;

		//SF_SPARK_START_ON, or a spark nothing can name. same rule as the
		//unnamed sprite
		if ((e->spawnflags & HLSF_SPARK_START_ON) || !e->targetname[0])
			HLEntSetThink(e, HLM_SPARK_THINK, hl_ent_time + 0.2 +
				ToF64(HLPartRandI(100)) * 0.01);

		return 1;
	}

	if (!StrCompare(e->classname, "env_bubbles"))
	{
		HLEntSpawnBubbles(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_smoker"))
	{
		//CSmoker::Spawn thinks immediately. health is the puff count, dmg the
		//horizontal spread; a mapper-placed one usually leaves both empty,
		//since the class exists for the gargantua to create at runtime
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		if (e->health <= 0.0)
			e->health = 10.0;

		if (e->dmg <= 0.0)
			e->dmg = 8.0;

		HLEntSetThink(e, HLM_SMOKER_THINK, hl_ent_time + 0.1);
		return 1;
	}

	if (!StrCompare(e->classname, "env_funnel"))
	{
		//CEnvFunnel::Spawn - solid nothing, invisible, waits to be used
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_FUNNEL_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_blood"))
	{
		//CBlood::Spawn - SetMovedir, so the "angle" key is the spray direction
		HLEntSetMoveDir(e);

		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_BLOOD_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "gibshooter") ||
		!StrCompare(e->classname, "env_shooter"))
	{
		HLEntSpawnShooter(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_global"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_GLOBAL_USE;

		//SF_GLOBAL_SET_SPAWN: the initial state is applied on map load rather
		//than waiting to be triggered
		if ((e->spawnflags & HLSF_GLOBAL_SET_SPAWN) && e->global_state[0])
		{
			//only adds state: overwriting on every map load would undo a flag
			//an earlier map set
			if (HLEntGlobalGet(e->global_state) == HLGLOBAL_OFF)
				HLEntGlobalSet(e->global_state, e->initial_state);
		}

		return 1;
	}

	if (!StrCompare(e->classname, "env_sound"))
	{
		//pure data. HLEntFrame picks the nearest one containing the player and
		//publishes its roomtype - see hl_ent_roomtype
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	//--- cycler ---
	if (!StrCompare(e->classname, "cycler"))
	{
		//a studio model that changes animation when shot. HLEntLoadModels
		//resolved the "model" key, so it draws; the animation change needs
		//monster damage routing
		e->movetype   = HLMOVETYPE_NONE;
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 80.0;

		return 1;
	}

	//--- scripts and actors ---
	if (!StrCompare(e->classname, "scripted_sentence"))
	{
		//speech without a sequence. HLAI.ZC owns the sentence scheduler and
		//compiles after this file, so this only posts the request, with the same
		//GOING_DOWN convention as scripted_sequence. HLAIFrame picks it up at
		//its HLC_SENTENCE branch, HLAI.ZC:8259.
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->ent_class    = HLC_SENTENCE;
		e->use_fn       = HLM_SENTENCE_USE;
		e->toggle_state = HLTS_AT_BOTTOM;

		return 1;
	}

	if (!StrCompare(e->classname, "scripted_sequence") ||
		!StrCompare(e->classname, "aiscripted_sequence"))
	{
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->ent_class    = HLC_SCRIPT;
		e->use_fn       = HLM_SCRIPT_USE;
		e->toggle_state = HLTS_AT_BOTTOM;
		e->owner        = -1;

		//a script nothing can name runs as soon as the map does
		if (!e->targetname[0])
			e->toggle_state = HLTS_GOING_DOWN;

		return 1;
	}

	//CSittingScientist. A separate class from CScientist on the same model: it
	//never moves, never routes and never fights, so it takes no AI slot and
	//HLAIMonKindFor leaves it alone
	if (!StrCompare(e->classname, "monster_sitting_scientist"))
	{
		e->movetype   = HLMOVETYPE_STEP;
		e->solid      = HLSOLID_SLIDEBOX;
		e->ent_class  = HLC_MONSTER;
		e->takedamage = HLDMG_TAKE_YES;
		e->health     = 50.0;
		e->effects    = 0;

		//UTIL_SetSize(-14,-14,0)-(14,14,36) - a seated man, not a standing one
		HLVecSet(e->mins, -14.0, -14.0, 0.0);
		HLVecSet(e->maxs, 14.0, 14.0, 36.0);
		HLEntSetAbsBox(e);

		HLEntScientistHead(e);

		//pev->sequence = m_baseSequence + RANDOM_LONG(0,4): one of the five
		//sitting takes, which is the whole of this class's behaviour here.
		//SittingThink also turns the head and speaks; both need the talk
		//monster layer, which is not ported
		HLEntSitScientistSeq(e, HLPartRandI(5));

		return 1;
	}

	//the dead props: CDeadScientist, CDeadBarney, CDeadHGrunt and CDeadHEV.
	//Each is its own class over a pose table, indexed by the "pose" key
	if (!StrCompare(e->classname, "monster_scientist_dead") ||
		!StrCompare(e->classname, "monster_barney_dead") ||
		!StrCompare(e->classname, "monster_hgrunt_dead") ||
		!StrCompare(e->classname, "monster_hevsuit_dead"))
	{
		HLEntSpawnDeadMonster(e);
		return 1;
	}

	//monsters are recognised so they get a class tag and stop counting as
	//unknown. their models were already resolved by HLEntLoadModels
	if (!StrNICompare(e->classname, "monster_", 8))
	{
		e->movetype   = HLMOVETYPE_STEP;
		e->solid      = HLSOLID_SLIDEBOX;
		e->ent_class  = HLC_MONSTER;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 20.0;

		//CScientist::Spawn picks a head for a body of -1, which one of c1a0's
		//scientists is authored with
		if (!StrCompare(e->classname, "monster_scientist"))
			HLEntScientistHead(e);

		//a hull, so the box clip has something to sweep against. The AI table
		//overwrites it per monster in HLAIMonRegisterAll; this is VEC_HUMAN_HULL
		//for the classes that never reach it
		if (e->size[0] <= 0.0)
		{
			HLVecSet(e->mins, -16.0, -16.0, 0.0);
			HLVecSet(e->maxs, 16.0, 16.0, 72.0);
			HLEntSetAbsBox(e);
		}

		//CGMan and the rest of the idle props: sequence 0 is a sensible idle in
		//gman.mdl (idle01) and roach.mdl (run), and monster_generic wears
		//whatever the mapper named, so nothing else needs choosing here
		return 1;
	}

	//--- sound ---
	if (!StrCompare(e->classname, "ambient_generic"))
	{
		//"message" is the wav path relative to sound/. "health" is the volume
		//on a 0-10 scale, not the 0-1 the mixer wants.
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_AMBIENT_USE;

		if (!e->message[0])
			return 1;

		//START_SILENT waits for a trigger. Everything else is playing from the
		//first frame - and c0a0's two announcer lines are 49, EVERYWHERE plus
		//START_SILENT plus NOT_LOOPING, fired by a multi_manager.
		if (!(e->spawnflags & HLSF_AMBIENT_START_SILENT) &&
			!(e->spawnflags & HLSF_AMBIENT_NOT_LOOPING))
			HLSndAmbientAdd(e->origin, e->message, HLAmbientVolume(e),
				HLAmbientAtten(e));

		return 1;
	}

	//--- lights ---
	if (!StrCompare(e->classname, "light") ||
		!StrCompare(e->classname, "light_spot") ||
		!StrCompare(e->classname, "light_environment"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		//only a light with a style is switchable; the rest were baked into
		//the lightmap by qrad and have nothing left to do at runtime
		if (e->style >= 32)
		{
			e->use_fn = HLM_LIGHT_USE;

			//SF_LIGHT_START_OFF
			if (e->spawnflags & 1)
			{
				HLLightStyleSet(e->style, "a");
				e->toggle_state = HLTS_AT_BOTTOM;
			}
			else
			{
				HLLightStyleSet(e->style, "m");
				e->toggle_state = HLTS_AT_TOP;
			}
		}

		return 1;
	}

	//worldspawn and the player starts carry no behaviour
	if (!StrCompare(e->classname, "info_teleport_destination") ||
		!StrCompare(e->classname, "info_landmark") ||
		!StrCompare(e->classname, "info_target") ||
		!StrCompare(e->classname, "info_intermission"))
	{
		//pure data - a named point something else aims at, teleports to, or
		//parks a camera on. info_target is a beam anchor
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	if (!StrCompare(e->classname, "worldspawn") ||
		!StrCompare(e->classname, "info_player_start") ||
		!StrCompare(e->classname, "info_player_deathmatch") ||
		!StrCompare(e->classname, "info_player_coop") ||
		!StrCompare(e->classname, "info_node") ||
		!StrCompare(e->classname, "info_node_air"))
		return 1;

	//--- monstermaker ---
	if (!StrCompare(e->classname, "monstermaker"))
	{
		//CMonsterMaker::Spawn, dlls/monstermaker.cpp:103
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;

		slot = HLMakerFind(i);

		//no monstertype, or the block scan overflowed: nothing to make
		if (slot < 0)
			return 1;

		//the spawn pass runs at time zero and the think loop reads a next_think
		//of zero as disarmed, so a maker with no delay key needs a floor. Every
		//monstermaker in the shipped maps carries delay 1 or more
		if (e->delay <= 0.0)
			e->delay = 0.1;

		if (e->targetname[0])
		{
			e->use_fn = HLM_MAKER_USE;

			if (e->spawnflags & HLSF_MAKER_START_ON)
			{
				hl_maker[slot].active = TRUE;
				HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);
			}
		}
		else
		{
			//"no targetname, just start"
			hl_maker[slot].active = TRUE;
			HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);
		}

		return 1;
	}

	//--- infodecal ---
	if (!StrCompare(e->classname, "infodecal"))
	{
		//CDecal::Spawn, dlls/world.cpp:117
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;

		//CDecal::KeyValue, world.cpp:184: the texture name becomes pev->skin
		e->skin = HLDecalIndexByName(e->texture);

		//"if ( pev->skin < 0 ) REMOVE_ENTITY", world.cpp:119
		if (e->skin < 0)
		{
			e->in_use = FALSE;
			return 1;
		}

		//"the decal will spray itself on as soon as the world is done
		//spawning", world.cpp:127. Not at hl_ent_time: the spawn pass runs at
		//time zero and the think loop treats a next_think of zero as disarmed
		if (!e->targetname[0])
			HLEntSetThink(e, HLM_DECAL_THINK, hl_ent_time + 0.1);
		else
			e->use_fn = HLM_DECAL_USE;

		return 1;
	}

	//--- CD audio cues ---
	if (!StrCompare(e->classname, "trigger_cdaudio"))
	{
		//CTriggerCDAudio::Spawn is InitTrigger and nothing else,
		//dlls/triggers.cpp:686. The touch and the use both call PlayTrack
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_CDAUDIO_PLAY;
		e->use_fn   = HLM_CDAUDIO_PLAY;
		return 1;
	}

	if (!StrCompare(e->classname, "target_cdaudio"))
	{
		//CTargetCDAudio::Spawn, dlls/triggers.cpp:765. The think is armed only
		//when a radius was authored; the rest are fired by name
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;
		e->use_fn   = HLM_CDAUDIO_PLAY;

		if (e->radius > 0.0)
			HLEntSetThink(e, HLM_CDAUDIO_RADIUS, hl_ent_time + 1.0);

		return 1;
	}

	//--- recognised, deliberately inert -------------------------------------
	//
	// Each of these needs a system that does not exist, not an entity. Claimed
	// here so HLEntReport's "not recognised" count means "a class nobody has
	// looked at".
	//
	// Grouped by what is missing:
	//
	//   runtime entity creation - weaponbox, world_items. env_shooter and
	//     gibshooter are NOT here: their timing, count and spread are real and
	//     the gibs are particles - see HLShooterThink.
	//
	//   monster AI - func_monsterclip (solid to monsters only, so it must not be
	//     solid here or it walls the player in), trigger_monsterjump,
	//     info_bigmomma, func_tank and its controls/mortar/laser/rocket
	//     variants, func_guntarget, func_mortar_field.
	//
	//   a save system hook - trigger_autosave, trigger_transition (marks which
	//     entities cross a changelevel), player_loadsaved, trigger_endsection.
	//
	//   a rasteriser feature - env_beverage, the xen_* organic props (studio
	//     models, which do draw, without their glow).
	//
	//   CD audio - speaker, which is a sentence scheduler rather than a track
	//     cue and shares nothing with the two cdaudio classes above.
	//
	//   a view override the shell would have to own - trigger_camera.
	//
	//   inventory reach-across - player_weaponstrip. HLWeapon.ZC compiles after
	//     this file, so it would need the same pending-flag treatment as the
	//     teleport.
	if (!StrCompare(e->classname, "weaponbox") ||
		!StrCompare(e->classname, "world_items") ||
		!StrCompare(e->classname, "info_bigmomma") ||
		!StrCompare(e->classname, "func_guntarget") ||
		!StrCompare(e->classname, "func_traincontrols") ||
		!StrCompare(e->classname, "func_trackchange") ||
		!StrCompare(e->classname, "func_trackautochange"))
	{
		HLEntSpawnInert(map, e);
		return 1;
	}

	//CFuncMonsterClip::Spawn and CFuncMortarField::Spawn both set EF_NODRAW,
	//and CTriggerMonsterJump is a CBaseTrigger, so InitTrigger sets it there
	if (!StrCompare(e->classname, "func_monsterclip") ||
		!StrCompare(e->classname, "trigger_monsterjump") ||
		!StrCompare(e->classname, "func_mortar_field"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	//CFuncTankControls::Spawn sets EF_NODRAW; the guns themselves are the thing
	//the player looks at, so the prefix test must not catch the controls
	if (!StrCompare(e->classname, "func_tankcontrols"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	if (!StrNICompare(e->classname, "func_tank", 9) ||
		!StrNICompare(e->classname, "xen_", 4))
	{
		HLEntSpawnInert(map, e);
		return 1;
	}

	//the brush volumes among these are all hidden by their own Spawn: the three
	//triggers through CBaseTrigger::InitTrigger, trigger_transition by having
	//its modelindex cleared. The point entities carry no model, so the flag
	//costs them nothing
	if (!StrCompare(e->classname, "trigger_autosave") ||
		!StrCompare(e->classname, "trigger_transition") ||
		!StrCompare(e->classname, "trigger_endsection") ||
		!StrCompare(e->classname, "trigger_camera") ||
		!StrCompare(e->classname, "player_loadsaved") ||
		!StrCompare(e->classname, "player_weaponstrip") ||
		!StrCompare(e->classname, "speaker"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "env_beverage"))
	{
		HLEntSpawnInert(map, e);
		return 1;
	}

	return 0;
}

U0 HLEntParseMultiManagers(CHLMap *map)
{//a multi_manager's targets are its key names, with the delay as the value, so
 //the generic parser has no field list to match them against. re-scan the lump
 //for those blocks only
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[64];
	U8	 name[64];
	I64	 k;
	I64	 slot;
	I64	 ent;
	I64	 n;
	I64	 block;
	I64	 seen;

	hl_mm_count = 0;
	block       = 0;

	if (!map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_mm_count < 32)
	{
		//No p++ here: qpmm_next_char below advances. Doing both stepped the
		//scan two bytes per non-brace character, so it saw every other byte
		//and missed any block opening on the wrong parity. Every
		//multi_manager in the game parsed as empty.
		if (*p != '{')
			goto qpmm_next_char;

		p++;
		slot          = hl_mm_count;
		hl_mm[slot].count = 0;
		name[0]       = 0;

		while (p < end && *p != '}')
		{
			//key
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			//The scan runs to the closing quote; only the copy is capped. A
			//scan that stops at the cap leaves p inside the string, and every
			//quote in the remainder reads as a delimiter. worldspawn's "wad"
			//value is 108 characters against a 64 byte buffer, so the first
			//block of every map desynchronises the parser and it reaches the
			//end of the lump without a closing brace.
			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					key[k] = *p;
					k++;
				}

				p++;
			}
			key[k] = 0;
			if (p < end)
				p++;

			//value
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					val[k] = *p;
					k++;
				}

				p++;
			}
			val[k] = 0;
			if (p < end)
				p++;

			if (!StrCompare(key, "classname"))
			{
				HLStrCopy(name, val, 64);
				goto qpmm_next_key;
			}

			//everything that is not one of the handful of real fields is a
			//target name
			if (!StrCompare(key, "targetname") ||
				!StrCompare(key, "origin") ||
				!StrCompare(key, "angle") ||
				!StrCompare(key, "angles") ||
				!StrCompare(key, "spawnflags") ||
				!StrCompare(key, "wait") ||
				!StrCompare(key, "model"))
				goto qpmm_next_key;

			if (hl_mm[slot].count < HLENT_MM_MAX)
			{
				n = hl_mm[slot].count;
				HLStrCopy(&hl_mm[slot].name[n * 64], key, 64);
				hl_mm[slot].delay[n] = HLAtoF(val);
				hl_mm[slot].count    = n + 1;
			}

qpmm_next_key:
		}

		if (!StrCompare(name, "multi_manager"))
		{
			//Bind the Nth multi_manager block to the Nth multi_manager entity.
			//The lump and hl_entities are both in file order, so the counts
			//agree - but only if this count advances for every block, including
			//one with no target keys. Keying it off hl_mm_count instead skips
			//the empty block's entity and shifts every later manager onto the
			//wrong schedule.
			ent  = -1;
			seen = 0;

			for (n = 0; n < hl_num_entities; n++)
			{
				if (StrCompare(hl_entities[n].classname, "multi_manager"))
					goto qpmm_next_ent;

				if (seen == block)
				{
					ent = n;
					break;
				}

				seen++;

qpmm_next_ent:
			}

			block++;

			if (ent >= 0 && hl_mm[slot].count > 0)
			{
				hl_mm[slot].ent     = ent;
				hl_mm[slot].fired   = 0;
				hl_mm[slot].started = 0.0;
				hl_mm_count++;
			}
		}

qpmm_next_char:
		if (p < end)
			p++;
	}
}

U0 HLEntParseMakers(CHLMap *map)
{//monstertype, monstercount and m_imaxlivechildren are CMonsterMaker's own
 //keys and are not in the generic field table, so the lump is re-scanned for
 //monstermaker blocks. Same scan and same block-to-entity binding as
 //HLEntParseMultiManagers above - read the notes there
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[64];
	U8	 name[64];
	U8	 monster[64];
	I64	 k;
	I64	 slot;
	I64	 ent;
	I64	 n;
	I64	 block;
	I64	 seen;
	I64	 count;
	I64	 max_live;

	HLMakerReset;
	block = 0;

	if (!map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_maker_count < HLMAKER_MAX)
	{
		if (*p != '{')
			goto qpmk_next_char;

		p++;
		name[0]    = 0;
		monster[0] = 0;
		count      = 0;
		max_live   = 0;

		while (p < end && *p != '}')
		{
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					key[k] = *p;
					k++;
				}

				p++;
			}
			key[k] = 0;
			if (p < end)
				p++;

			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					val[k] = *p;
					k++;
				}

				p++;
			}
			val[k] = 0;
			if (p < end)
				p++;

			if (!StrCompare(key, "classname"))
				HLStrCopy(name, val, 64);
			else if (!StrCompare(key, "monstertype"))
				HLStrCopy(monster, val, 64);
			else if (!StrCompare(key, "monstercount"))
				count = ToI64(HLAtoF(val));
			else if (!StrCompare(key, "m_imaxlivechildren"))
				max_live = ToI64(HLAtoF(val));
		}

		if (!StrCompare(name, "monstermaker"))
		{
			ent  = -1;
			seen = 0;

			for (n = 0; n < hl_num_entities; n++)
			{
				if (StrCompare(hl_entities[n].classname, "monstermaker"))
					goto qpmk_next_ent;

				if (seen == block)
				{
					ent = n;
					break;
				}

				seen++;

qpmk_next_ent:
			}

			block++;

			if (ent >= 0 && monster[0])
			{
				slot = hl_maker_count;

				hl_maker[slot].ent          = ent;
				HLStrCopy(hl_maker[slot].monster, monster, 64);
				hl_maker[slot].num_monsters = count;
				hl_maker[slot].max_live     = max_live;
				hl_maker[slot].live         = 0;
				hl_maker[slot].ground       = 0.0;
				hl_maker[slot].active       = FALSE;

				hl_maker_count++;
			}
		}

qpmk_next_char:
		if (p < end)
			p++;
	}
}

//Bounded trace of the first entity events after a map loads, written to the
//log. A scripted opening either fires or it does not, and the console is the
//only place that can be observed from inside the VM.
#define HLENT_TRACE_MAX		96	//c0a0's opening alone is over forty events
#define HLENT_TRACE_WINDOW	20.0	//seconds of game time

I64  hl_ent_trace_count = 0;
Bool hl_ent_trace_on    = FALSE;

U0 HLEntTraceReset()
{
	hl_ent_trace_count = 0;
	hl_ent_trace_on    = FALSE;
}

U0 HLEntTrace(U8 *what, I64 ent, I64 method)
{//One line per dispatched event: who, what method, what class, what name.
 //
 //The method id is the whole point of the line. Two thinks on one entity are
 //a delayed fire behind an auto trigger; four are a bug, and without the id
 //they read the same
	CHLEntity	*e;
	U8			 line[192];

	if (!hl_ent_trace_on || hl_ent_trace_count >= HLENT_TRACE_MAX)
		return;

	if (hl_ent_time > HLENT_TRACE_WINDOW)
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	hl_ent_trace_count++;

	StrPrint(line, "ENT %6.2f %-6s m%-3d %3d %-22s \"%s\" -> \"%s\"\n",
		hl_ent_time, what, method, ent, e->classname, e->targetname,
		e->target);

	HLLog(line);
	"%s", line;

	if (hl_ent_trace_count == HLENT_TRACE_MAX)
	{
		HLLog("ENT trace budget reached\n");
		"ENT trace budget reached\n";
	}
}

//--- worldspawn startdark / gametitle ---------------------------------------
//
// Two keys the entity table does not carry. CWorld::KeyValue turns startdark
// into the engine cvar v_dark and gametitle into gDisplayTitle -
// dlls/world.cpp:702 and :718 - and CWorld::Spawn applies both at :648.
// gDisplayTitle reaches the client on the player's first spawn,
// dlls/player.cpp:4154.
//
// c0a0's worldspawn sets both. Without them the chapter opens on a lit world
// with no logo.
//
// The lump is re-scanned rather than the keys added to CHLEntity, the way
// HLEntParseMultiManagers does - read the notes there, in particular that the
// scan runs to the real delimiter and only the copy is capped.

U0 HLEntWorldStartup(CHLMap *map)
{
	CHLTitleMsg	 t;
	U8			*p;
	U8			*end;
	U8			 key[64];
	U8			 val[64];
	U8			 text[HLMSG_MAX_TEXT];
	I64			 k;
	Bool		 dark;
	Bool		 title;

	dark  = FALSE;
	title = FALSE;

	if (!map || !map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	//worldspawn is the first block of the lump, always
	while (p < end && *p != '{')
		p++;

	if (p < end)
		p++;

	while (p < end && *p != '}')
	{
		while (p < end && *p != '"' && *p != '}')
			p++;
		if (p >= end || *p == '}')
			break;

		p++;
		k = 0;
		while (p < end && *p != '"')
		{
			if (k < 63)
			{
				key[k] = *p;
				k++;
			}

			p++;
		}
		key[k] = 0;
		if (p < end)
			p++;

		while (p < end && *p != '"' && *p != '}')
			p++;
		if (p >= end || *p == '}')
			break;

		p++;
		k = 0;
		while (p < end && *p != '"')
		{
			if (k < 63)
			{
				val[k] = *p;
				k++;
			}

			p++;
		}
		val[k] = 0;
		if (p < end)
			p++;

		if (!StrCompare(key, "startdark") && HLAtoF(val) != 0.0)
			dark = TRUE;
		else if (!StrCompare(key, "gametitle") && HLAtoF(val) != 0.0)
			title = TRUE;
	}

	if (dark)
	{
		//v_dark's own ramp is engine side and not in the SDK. Held at black
		//and released after three seconds, so a map that sets startdark and
		//never fires an env_fade still comes back. c0a0 fires one at 0.3s,
		//which replaces this.
		HLHudFadeSet(0, 0, 0, 255, 0.0, 3.0, FALSE);
	}

	if (title)
	{
		//GAMETITLE holds the logo's timing and colour; its block text is a
		//placeholder the SDK never draws - valve/titles.txt:518.
		if (HLEntTitleLook("GAMETITLE", text, HLMSG_MAX_TEXT, &t))
			HLHudTitleShow(t.r1, t.g1, t.b1, t.x, t.y,
				t.fadein, t.holdtime, t.fadeout);
	}
}

I64 HLEntSpawnAll(CHLMap *map)
{//ED_LoadFromFile's second half: run every class function
	I64 i;
	I64 known = 0;

	hl_ent_time       = 0.0;
	hl_ent_thinks     = 0;
	hl_ent_player     = -1;
	hl_ent_callq_head = 0;
	hl_ent_callq_tail = 0;
	hl_ent_callq_lost = 0;

	//ambients are re-registered by the spawn pass below, so the previous
	//map's must go first or they accumulate
	HLSndAmbientClear;

	//HLClip.ZC's rotation registry is indexed by entity slot and HLClipInit runs
	//at startup only. A slot that held a func_rotating in one map says nothing
	//about the next, and a stale flag traces an ordinary door through an
	//orientation it does not have
	HLClipRotatingReset;

	//Looping train voices are indexed the same way and leak across a map change
	//for the same reason.
	HLTrainVoiceReset;

	//Trace the opening seconds. Bounded by count and by game time, so it costs
	//nothing after the level has settled.
	HLEntTraceReset;
	hl_ent_trace_on = TRUE;

	//a fresh map means full health and no stale pending effect
	HLEntPlayerReset;

	//the missing-title complaint budget is per map, so a bad titles.txt is
	//reported on the map that needed it rather than once ever
	hl_ent_title_misses = 0;

	//no message from the previous map survives the load
	HLHudMsgClear;

	//startdark and gametitle, before anything can fire an env_fade over them
	HLEntWorldStartup(map);

	HLEntParseMultiManagers(map);

	//monstermaker keys, on the same terms and before the spawn pass reads them
	HLEntParseMakers(map);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qesa_next;

		if (HLEntSpawnOne(map, i))
			known++;
		else
		{
			//unrecognised. left unspawned so the report counts it and a later
			//pass can claim it once the class exists
			hl_entities[i].spawned = FALSE;

			//ED_LoadFromFile removes an entity whose classname resolves to no
			//class, so nothing unrecognised is ever on screen in HL. Here the
			//slot survives to be counted, and a brush model on it would be
			//drawn with whatever the mapper left on the faces
			if (hl_entities[i].brush_model > 0)
				hl_entities[i].effects =
					hl_entities[i].effects | HLEF_NODRAW;
		}

qesa_next:
	}

	hl_ent_spawned = known;

	return known;
}

//--- the frame --------------------------------------------------------------

U0 HLEntDrainCalls()
{//dispatch everything queued, including anything queued BY the dispatch, up
 //to a budget. a target loop hits the budget instead of the stack
	I64 budget = HLENT_CALLQ_BUDGET;
	I64 ent;
	I64 method;
	I64 activator;
	I64 use_type;
	F64 value;

	while (hl_ent_callq_head != hl_ent_callq_tail && budget > 0)
	{
		ent       = hl_ent_callq[hl_ent_callq_head].ent;
		method    = hl_ent_callq[hl_ent_callq_head].method;
		activator = hl_ent_callq[hl_ent_callq_head].activator;
		use_type  = hl_ent_callq[hl_ent_callq_head].use_type;
		value     = hl_ent_callq[hl_ent_callq_head].value;

		hl_ent_callq_head = (hl_ent_callq_head + 1) % HLENT_CALLQ_MAX;

		HLEntTrace("use", ent, method);
		HLEntCallMethod(ent, method, activator, use_type, value);

		budget--;
	}

	if (!budget)
	{
		//a chain that will not settle. drop the rest, or it comes back next
		//frame and every frame after
		hl_ent_callq_head = hl_ent_callq_tail;
		"HLEnt: call budget exhausted, target loop?\n";
	}
}

Bool HLEntBoxOverlap(CHLEntity *e, F64 *mins, F64 *maxs)
{//world space AABB test against an entity's linked bounds
	if (maxs[0] < e->absmin[0] || mins[0] > e->absmax[0])
		return FALSE;
	if (maxs[1] < e->absmin[1] || mins[1] > e->absmax[1])
		return FALSE;
	if (maxs[2] < e->absmin[2] || mins[2] > e->absmax[2])
		return FALSE;

	return TRUE;
}

Bool HLEntPlayerRides(CHLEntity *e, F64 *player_org)
{//is the player standing on, or inside, this mover?
 //
 //Asked before the mover is stepped: riders are decided against the pre-step
 //position, as SV_PushMove does.
	F64 pmins[3];
	F64 pmaxs[3];
	I64 i;

	if (!player_org)
		return FALSE;

	for (i = 0; i < 3; i++)
	{
		pmins[i] = player_org[i] + hl_player_mins[i];
		pmaxs[i] = player_org[i] + hl_player_maxs[i];
	}

	//4 units of slack under the feet, so standing on a platform counts as riding
	//it. A fast mover steps further than one unit, so this is generous rather
	//than exact
	pmins[2] -= 4.0;

	return HLEntBoxOverlap(e, pmins, pmaxs);
}

U0 HLEntPushPlayer(F64 *move, F64 *player_org)
{//carry the rider by the same delta the mover took
 //
 //the mover never refuses its own move: a rider is carried, and anything the
 //step ends up inside is handled after the fact by HLEntCheckBlocked
	I64 i;

	for (i = 0; i < 3; i++)
		player_org[i] += move[i];
}

Bool HLEntBoxInBrush(CHLMap *map, I64 self, F64 *borg, F64 *bang, F64 *org,
	F64 *mins, F64 *maxs)
{//is the box at org embedded in self's brush, that brush placed at borg/bang?
 //
 //SV_TestEntityPosition against one brush entity: the trace
 //HLClipToNativeBrushes runs for a move, with a zero length sweep. borg and
 //bang are arguments rather than read off the entity so the same brush can be
 //tested at its pre-step placement.
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 eofs[3];
	I64			 ehull;
	I64			 j;

	if (!e || e->solid != HLSOLID_BSP)
		return FALSE;

	if (!HLMapValid(map, "HLEntBoxInBrush"))
		return FALSE;

	if (e->brush_model < 1 || e->brush_model >= map->num_models)
		return FALSE;

	ehull = HLHullForSize(mins, maxs);

	HLHullOffset(ehull, mins, eofs);
	for (j = 0; j < 3; j++)
		eofs[j] += borg[j];

	if (hl_brush_rotates[self])
		HLTraceHullRotated(map, e->brush_model, ehull, eofs, bang, org, org,
			&tr);
	else
		HLTraceHull(map, e->brush_model, ehull, eofs, org, org, &tr);

	return tr.start_solid;
}

U0 HLEntCheckBlocked(CHLMap *map, I64 self, F64 *oldorg, F64 *oldang,
	Bool rides, F64 *player_org)
{//SV_PushMove's blocked case: the step this tick put a solid box inside the
 //mover, and the mover's blocked method decides what that costs
 //
 //"inside now and clear before", not "inside now". A mover retracting off
 //something already embedded in it is not blocked, and on the second test's
 //absence a reversed door blocks again every tick and never leaves.
 //
 //One blocker per tick: a second dispatch reverses a door straight back.
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	I64			 i;

	if (!e || e->blocked_fn == HLM_NONE)
		return;

	//a rider is carried by base velocity, not crushed - decided against the
	//pre-step position, as HLEntPlayerRides is
	if (player_org && hl_ent_player >= 0 && !rides &&
		hl_ent_player_health > 0.0)
	{
		if (HLEntBoxInBrush(map, self, e->origin, e->angles, player_org,
			hl_player_mins, hl_player_maxs) &&
			!HLEntBoxInBrush(map, self, oldorg, oldang, player_org,
			hl_player_mins, hl_player_maxs))
		{
			HLEntCallMethod(self, e->blocked_fn, -1, HLUSE_TOGGLE, 0.0);
			return;
		}
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		o = HLEntGet(i);

		if (i == self || !o || !o->in_use)
			goto qecb_next;

		//the box solids only: another brush entity is level geometry, and a
		//trigger is not an obstacle
		if (o->solid != HLSOLID_SLIDEBOX && o->solid != HLSOLID_BBOX)
			goto qecb_next;

		//a zero-sized box is a point entity that never had a hull set
		if (o->size[0] <= 0.0 || o->size[1] <= 0.0 || o->size[2] <= 0.0)
			goto qecb_next;

		//broad phase over the linked bounds before either brush trace
		if (!HLEntBoxOverlap(e, o->absmin, o->absmax))
			goto qecb_next;

		if (!HLEntBoxInBrush(map, self, e->origin, e->angles, o->origin,
			o->mins, o->maxs))
			goto qecb_next;

		if (HLEntBoxInBrush(map, self, oldorg, oldang, o->origin, o->mins,
			o->maxs))
			goto qecb_next;

		HLEntCallMethod(self, e->blocked_fn, i, HLUSE_TOGGLE, 0.0);
		return;

qecb_next:
	}
}

U0 HLEntFrame(CHLMap *map, F64 dt, F64 *player_org)
{//one server tick of the entity world
 //
 //player_org is passed in rather than read from a global because the shell
 //owns it and compiles after this file
	CHLEntity	*e;
	F64			 move[3];
	F64			 oldorg[3];
	F64			 oldang[3];
	F64			 dist[3];
	F64			 best;
	F64			 len;
	Bool		 rides;
	Bool		 linear;
	Bool		 angular;
	Bool		 found;
	I64			 room;
	I64			 think;
	I64			 i;
	I64			 j;

	if (!hl_entities || !map)
		return;

	hl_ent_time     += dt;
	hl_ent_frame_dt  = dt;

	//pending effects are per tick: a trigger the player has left must stop
	//pushing, and a stale teleport must not fire twice
	hl_ent_push_pending = FALSE;
	hl_ent_spin_pending = FALSE;

	//Cleared before the mover pass, like hl_surface_friction: stepping off a
	//platform produces no event to hang the reset on.
	hl_platform_active      = FALSE;
	hl_platform_avel_z      = 0.0;
	HLVecSet(hl_platform_velocity, 0.0, 0.0, 0.0);

	//friction belongs to HLClip.ZC and is read inside PM_Friction. Cleared here
	//rather than by func_friction, because stepping OFF a slippery brush
	//produces no event - there is nothing to hang the restore on
	hl_surface_friction = 1.0;

	//stash the origin for anything that runs later in the tick without one - a
	//charger metering out health, an env_shake testing its radius. See
	//hl_ent_player_org
	if (player_org)
		HLVecCopy(player_org, hl_ent_player_org);

	//--- looping voices ---
	//
	//A tracktrain's running noise is re-aimed every tick, not per node: the
	//listener moves between nodes and the loop must follow it. A parked train
	//has no think scheduled, which is the signal to stop.
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (e->ent_class != HLC_TRACKTRAIN)
			goto qef_next_voice;

		if (e->in_use && e->think_fn != HLM_NONE)
			HLTrainVoiceStart(i, e);
		else
			HLTrainVoiceStop(i);

qef_next_voice:
	}

	//--- movers ---
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->movetype != HLMOVETYPE_PUSH)
			goto qef_next_move;

		linear = !(HLIsZeroF(e->velocity[0]) && HLIsZeroF(e->velocity[1]) &&
			HLIsZeroF(e->velocity[2]));

		angular = !(HLIsZeroF(e->avelocity[0]) && HLIsZeroF(e->avelocity[1]) &&
			HLIsZeroF(e->avelocity[2]));

		if (!linear && !angular)
			goto qef_next_move;

		//the pre-step placement, for HLEntCheckBlocked's "clear before" test
		HLVecCopy(e->origin, oldorg);
		HLVecCopy(e->angles, oldang);

		//angles first and unconditionally: a fan or a swinging door has
		//avelocity and no velocity at all
		if (angular)
		{
			e->angles[0] += e->avelocity[0] * dt;
			e->angles[1] += e->avelocity[1] * dt;
			e->angles[2] += e->avelocity[2] * dt;

			//kept in range so a fan that has been spinning for an hour is not
			//feeding six-figure degrees into Cos/Sin, where the argument
			//reduction eats the precision the angle had left
			for (j = 0; j < 3; j++)
			{
				while (e->angles[j] >= 360.0)
					e->angles[j] -= 360.0;

				while (e->angles[j] < 0.0)
					e->angles[j] += 360.0;
			}
		}

		rides = FALSE;

		//An angular-only step rebuilds nothing: a rotating brush's bounds are
		//the orientation-independent radius (see HLEntSetAbsBox), and a
		//non-rotating entity changing angles is a train's bookkeeping.
		if (linear)
		{
			move[0] = e->velocity[0] * dt;
			move[1] = e->velocity[1] * dt;
			move[2] = e->velocity[2] * dt;

			//riders are decided against the pre-step position, as SV_PushMove
			//does
			if (player_org && hl_ent_player >= 0)
				rides = HLEntPlayerRides(e, player_org);

			e->origin[0] += move[0];
			e->origin[1] += move[1];
			e->origin[2] += move[2];

			HLEntSetAbsBox(e);

			if (rides)
			{
				//The rider is carried by base velocity, not by writing its
				//origin. pm_shared adds basevelocity before the move and
				//subtracts it after, so the carry is clipped by the world like
				//any other motion and cannot fight the duck's 18-unit origin
				//shift.
				hl_platform_active = TRUE;

				hl_platform_velocity[0] = e->velocity[0];
				hl_platform_velocity[1] = e->velocity[1];
				hl_platform_velocity[2] = e->velocity[2];

				HLVecCopy(e->origin, hl_platform_pivot);

				//SV_PushRotate's angular term, as a rate:
				//HLPMPlatformBaseVelocity evaluates v + w x r at the rider's
				//own position.
				if (dt > 0.0)
					hl_platform_avel_z = e->yaw_delta / dt;
				else
					hl_platform_avel_z = 0.0;
			}

			//Consumed whether or not anyone was riding: a banked delta would
			//otherwise be applied to whoever stepped on next.
			e->yaw_delta = 0.0;
		}

		//A swinging door blocks too, so this is outside the linear branch. The
		//blocked method may reverse this mover and its group; a peer later in
		//the table then steps this tick on its new velocity, one tick ahead of
		//the leaf that reversed it.
		HLEntCheckBlocked(map, i, oldorg, oldang, rides, player_org);

qef_next_move:
	}

	//--- env_sound ---------------------------------------------------------
	//
	// The nearest env_sound whose radius contains the player wins, as in HL: the
	// reverb preset is a property of where the player stands, not of an entity
	// touched.
	//
	// Nothing reads hl_ent_roomtype: HLSound.ZC mixes dry, with no reverb tail to
	// configure. Costs one pass over the entity list.
	if (player_org)
	{
		best  = 0.0;
		room  = 0;
		found = FALSE;

		for (i = 0; i < hl_num_entities; i++)
		{
			e = &hl_entities[i];

			if (!e->in_use || e->radius <= 0.0)
				goto qef_next_room;

			if (StrCompare(e->classname, "env_sound"))
				goto qef_next_room;

			HLVecSub(player_org, e->origin, dist);
			len = HLVecLength(dist);

			if (len > e->radius)
				goto qef_next_room;

			//"found" rather than a non-zero roomtype: 0 is a legitimate value
			//("normal room"), so testing the value would let a farther
			//env_sound overwrite a nearer one
			if (found && len >= best)
				goto qef_next_room;

			best  = len;
			room  = e->roomtype;
			found = TRUE;

qef_next_room:
		}

		hl_ent_roomtype = room;
	}

	//--- thinks ---
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->think_fn)
			goto qef_next_think;

		if (e->next_think <= 0.0 || e->next_think > hl_ent_time)
			goto qef_next_think;

		hl_ent_thinks++;

		//SV_RunThink clears nextthink BEFORE calling the think, and the order
		//is the whole contract: a method that reschedules wins, because its
		//HLEntSetThink runs after this; a method that reschedules nothing is
		//disarmed, and one that returns early - a bad index, a class that no
		//longer applies - cannot come back every tick forever.
		//
		//Clearing it after the call instead overwrites the new schedule with
		//"never"; leaving it to each method makes every method responsible for
		//disarming itself, and the one that forgets thinks on every tick until
		//the trace budget hides it.
		think = e->think_fn;

		e->think_fn   = HLM_NONE;
		e->next_think = 0.0;

		HLEntTrace("think", i, think);
		HLEntCallMethod(i, think, e->activator, HLUSE_TOGGLE, 0.0);

qef_next_think:
	}

	HLEntDrainCalls();

	//CBasePlayer::PlayerDeathThink. Last, so a trigger that killed the player
	//this tick has already run and the death state machine starts on the tick
	//the damage landed rather than the one after
	HLEntPlayerDeathThink;
}

U0 HLEntTouchPlayer(F64 *player_org)
{//test the player against every trigger and touchable mover
	CHLEntity	*e;
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 i;

	if (!hl_entities || !player_org)
		return;

	for (i = 0; i < 3; i++)
	{
		pmins[i] = player_org[i] + hl_player_mins[i];
		pmaxs[i] = player_org[i] + hl_player_maxs[i];
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->touch_fn)
			goto qetp_next;

		//a trigger volume is always tested; a solid entity only when its touch
		//should fire on a bump. A conveyor is solid and stood on, so its touch
		//fires too
		if (e->solid != HLSOLID_TRIGGER && e->touch_fn != HLM_DOOR_TOUCH &&
			e->touch_fn != HLM_ROT_DOOR_TOUCH &&
			e->touch_fn != HLM_BUTTON_TOUCH &&
			e->touch_fn != HLM_CONVEYOR_TOUCH)
			goto qetp_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qetp_next;

		HLEntQueueCall(i, e->touch_fn, hl_ent_player, HLUSE_TOGGLE, 0.0);

qetp_next:
	}

	HLEntDrainCalls();
}

I64 HLEntUseInFront(F64 *player_org, F64 *forward, Bool held = FALSE)
{//the +use key: fire the nearest usable entity the player is looking at.
 //HL traces 64 units; the box test here is coarser but needs no trace
 //
 //held is CBasePlayer::PlayerUse's every-frame pass, player.cpp:1669: the key
 //is still down and only FCAP_CONTINUOUS_USE classes answer. The shell calls
 //this once on the press edge with held clear, then once a tick with it set
 //for as long as the key stays down
	CHLEntity	*e;
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 use_type;
	I64			 i;
	I64			 fired = 0;

	if (!hl_entities || !player_org || !forward)
		return 0;

	use_type = HLUSE_TOGGLE;
	if (held)
		use_type = HLUSE_SET;	//player.cpp:1675

	HLVecMA(player_org, 48.0, forward, probe);

	for (i = 0; i < 3; i++)
	{
		pmins[i] = probe[i] - 16.0;
		pmaxs[i] = probe[i] + 16.0;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->use_fn)
			goto qeuf_next;

		//only classes the player operates by hand. A wall charger is reachable
		//no other way - nothing in a map targets one
		//FCAP_IMPULSE_USE. CBasePlatTrain grants it to func_plat, func_train
		//and func_door; CFuncTrackTrain does not - it carries
		//FCAP_DIRECTIONAL_USE, meaning the controls drive it, not a player
		//walking up to the car. Without this a tracktrain toggles on every
		//+use press, so the scripted tram can be started and stopped by hand.
		if (e->ent_class == HLC_TRACKTRAIN)
			goto qeuf_next;

		if (e->use_fn != HLM_DOOR_USE && e->use_fn != HLM_BUTTON_USE &&
			e->use_fn != HLM_TRAIN_USE && e->use_fn != HLM_ROT_DOOR_USE &&
			e->use_fn != HLM_CHARGER_USE && e->use_fn != HLM_MOMENTARY_USE)
			goto qeuf_next;

		//a held key reaches only the continuous classes; a door would toggle
		//on every tick
		if (held && !HLEntCapsContinuousUse(e))
			goto qeuf_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qeuf_next;

		HLEntQueueCall(i, e->use_fn, hl_ent_player, use_type, 0.0);
		fired++;
		break;

qeuf_next:
	}

	HLEntDrainCalls();

	return fired;
}

U0 HLEntDump(U8 *filter = NULL)
{//list the entity table, optionally filtered by a classname prefix: which
 //movers exist, what names them, and what they name in turn
	CHLEntity	*e;
	I64			 i;
	I64			 shown = 0;

	"$$LTBLUE$$%-22s %-18s %-18s %5s %5s$$FG$$\n",
		"classname", "targetname", "target", "flags", "state";

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use)
			goto qed_next;

		if (filter && StrNICompare(e->classname, filter, StrLen(filter)))
			goto qed_next;

		"%-22s %-18s %-18s %5d %5d\n",
			e->classname, e->targetname, e->target,
			e->spawnflags, e->toggle_state;

		shown++;

qed_next:
	}

	"%d shown of %d\n", shown, hl_num_entities;
}

U0 HLEntDrawBeams(CHLCanvas *c)
{//env_beam and env_laser. Endpoints resolve exactly as HLBeamDamageThink does:
 //a named entity's origin, or this entity's own where the name did not resolve
 //
 //Additive and depth tested, writing no depth, so this runs after the world and
 //entity passes. hl_r_beams is checked inside HLDrawBeam.
	CHLEntity	*e;
	CHLSpr		*sp;
	CHLSprFrame	*fr;
	F64			 start[3];
	F64			 end[3];
	I64			 lit;
	I64			 i;

	if (!c || !hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_BEAM || !e->beam_active)
			goto qedb_next;

		//the sprite is resolved in HLEntSpawnBeam; the frame path never loads
		sp = e->spr;

		if (!sp || sp->num_frames < 1 || !sp->palette)
			goto qedb_next;

		if (e->beam_start >= 0 && e->beam_start < hl_num_entities)
			HLVecCopy(hl_entities[e->beam_start].origin, start);
		else
			HLVecCopy(e->origin, start);

		if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
			HLVecCopy(hl_entities[e->beam_end].origin, end);
		else
			HLVecCopy(e->origin, end);

		//CBeam takes its colour from pev->rendercolor and its brightness from
		//pev->renderamt, effects.h:126-133. Every one of the 803 env_beam and
		//env_laser entities in the shipped maps carries both keys, so there is
		//no default to invent; a zero brightness is a beam the mapper turned
		//down and it stays dark
		lit = ToI64(e->renderamt);

		if (lit < 0)
			lit = 0;
		else if (lit > 255)
			lit = 255;

		fr = &sp->frames[0];

		//BoltWidth and TextureScroll are stored in 0.1s, NoiseAmplitude in
		//0.01s - const.h:130-135. tS is the render clock: scroll and noise are
		//visual, not simulation
		HLDrawBeam(c, start, end, fr->pixels, sp->palette,
			fr->width, fr->height,
			e->beam_width * 0.1, e->beam_noise * 0.01, e->beam_scroll * 0.1,
			tS,
			ToI64(e->rendercolor[0]), ToI64(e->rendercolor[1]),
			ToI64(e->rendercolor[2]), lit);

qedb_next:
	}
}

U0 HLEntReport()
{//load time sanity dump
	I64 i;
	I64 movers   = 0;
	I64 triggers = 0;
	I64 unknown  = 0;
	I64 rotating = 0;
	I64 sprites  = 0;
	I64 items    = 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qer_next;

		if (hl_entities[i].rotates)
			rotating++;

		if (hl_entities[i].spr)
			sprites++;

		if (hl_entities[i].ent_class == HLC_ITEM)
			items++;

		if (!hl_entities[i].spawned)
			unknown++;
		else if (hl_entities[i].movetype == HLMOVETYPE_PUSH)
			movers++;
		else if (hl_entities[i].solid == HLSOLID_TRIGGER)
			triggers++;

qer_next:
	}

	//hl_mm_count is filled by HLEntParseMultiManagers, which runs inside
	//HLEntSpawnAll. Reported from the parse pass it is always 0 and reads as a
	//failure that is not there.
	"HLEnt: %d entities, %d movers, %d triggers, %d multi_manager blocks\n",
		hl_num_entities, movers, triggers, hl_mm_count;

	"HLEnt: %d rotating brushes, %d sprites, %d items\n",
		rotating, sprites, items;

	if (hl_maker_count)
		"HLEnt: %d monstermakers, %d children spawned\n",
			hl_maker_count, hl_maker_made;

	if (unknown)
		"HLEnt: %d classnames not recognised (inert)\n", unknown;
}
