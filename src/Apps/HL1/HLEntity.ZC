// HLEntity.ZC - native entity behaviour, replacing the QuakeC VM
//
// Half-Life game logic is a native DLL, not bytecode, so there is nothing to
// interpret. HLProgs.ZC and HLBuiltin.ZC are unused here.
//
// Two SDK C++ mechanisms are integers here:
//
//   LINK_ENTITY_TO_CLASS   classname -> spawn dispatch, HLEntSpawnOne
//   virtual Think/Use/...  method ID dispatched through a switch
//
// Method IDs rather than function pointers because ZealC is single-pass: the
// dispatcher sits after every implementation it calls, and an entity can
// schedule a method defined later in the file.
//
// SUB_UseTargets, SUB_CalcMove and CBaseToggle carry most brush entities: a
// toggle that moves between two points and fires its target on arrival.

//--- method ids -------------------------------------------------------------
//
// Grouped by owning class. 0 is "no method" and every scheduling field rests
// there, so a zeroed entity does nothing.

#define HLM_NONE				0

#define HLM_REMOVE			1	//free the slot on the next think
#define HLM_FIRE_TARGETS		2	//delayed SUB_UseTargets
#define HLM_MOVE_DONE		3	//arrival, dispatches move_done
#define HLM_CORPSE_FALL		4	//CBaseMonster::CorpseFallThink, monsters.cpp:3246

#define HLM_DOOR_GO_UP		10
#define HLM_DOOR_GO_DOWN		11
#define HLM_DOOR_HIT_TOP		12
#define HLM_DOOR_HIT_BOTTOM	13
#define HLM_DOOR_USE			14
#define HLM_DOOR_TOUCH		15
#define HLM_DOOR_BLOCKED		16	//activator is the blocker, -1 for the player
#define HLM_DOOR_LEAF		17	//one leaf of a door group, no further fan out
#define HLM_PLAT_BLOCKED		18	//func_plat: retreat rather than crush
#define HLM_DOOR_GROUP		19	//+use fan out, the one path that reaches a
								//single leaf. not a use_fn

#define HLM_BUTTON_USE		20
#define HLM_BUTTON_TOUCH		21
#define HLM_BUTTON_GO_UP		22
#define HLM_BUTTON_GO_DOWN	23
#define HLM_BUTTON_HIT_TOP	24
#define HLM_BUTTON_HIT_BOTTOM 25
#define HLM_BUTTON_RETURN	26

#define HLM_TRAIN_NEXT		30
#define HLM_TRAIN_USE		31
#define HLM_TRAIN_WAIT		32
#define HLM_TRAIN_START		33
#define HLM_TRAIN_BLOCKED	34	//func_train and func_tracktrain both grind
#define HLM_TRAIN_DEADEND	35	//CFuncTrackTrain::DeadEnd, plats.cpp:1298

#define HLM_TRACK_FIND		36	//CFuncTrackChange::Find, plats.cpp:1756
#define HLM_TRACK_USE		37
#define HLM_TRACK_HIT_TOP	38	//this port's top - CFuncTrackChange::HitBottom
#define HLM_TRACK_HIT_BOTTOM	39	//CFuncTrackChange::HitTop

#define HLM_TRIGGER_TOUCH	40
#define HLM_TRIGGER_USE		41
#define HLM_TRIGGER_ENABLE	42
#define HLM_MULTI_MANAGER_USE 43
#define HLM_MULTI_MANAGER_TICK 44
#define HLM_RELAY_USE		45
#define HLM_AUTO_THINK		46
#define HLM_AMBIENT_USE		47

#define HLM_LIGHT_USE		50
#define HLM_WALL_USE			51

#define HLM_SCRIPT_USE		59	//handled in HLAI.ZC - see HLScriptUse

#define HLM_BREAK_USE		60	//damaged into breaking by a use, not a hit
#define HLM_BREAK_DIE		61	//health reached zero
#define HLM_HURT_TOUCH		62
#define HLM_PUSH_TOUCH		63
#define HLM_TELEPORT_TOUCH	64

//angular movers. a separate family from the linear ones because the arrival
//snaps angles rather than an origin
#define HLM_ROT_DOOR_USE			70
#define HLM_ROT_DOOR_GO_UP		71
#define HLM_ROT_DOOR_GO_DOWN		72
#define HLM_ROT_DOOR_HIT_TOP		73
#define HLM_ROT_DOOR_HIT_BOTTOM	74
#define HLM_ROT_DOOR_TOUCH		75
#define HLM_ROTATE_USE			76
#define HLM_PENDULUM_USE			77
#define HLM_PENDULUM_SWING		78

//momentary_*. these carry a position rather than an on/off state, and are the
//only classes that use HLUSE_SET and its value
#define HLM_MOMENTARY_USE		80
#define HLM_MOMENTARY_DOOR_USE	81
#define HLM_MOMENTARY_RETURN		82

//the env_* effect family
#define HLM_SPRITE_USE			90
#define HLM_BEAM_USE				91
#define HLM_RENDER_USE			92
#define HLM_MESSAGE_USE			93
#define HLM_FADE_USE				94
#define HLM_SHAKE_USE			95
#define HLM_EXPLOSION_USE		96
#define HLM_SPARK_THINK			97
#define HLM_SPARK_USE			98
#define HLM_GLOBAL_USE			99
#define HLM_SENTENCE_USE			100	//handled in HLAI.ZC, see HLC_SENTENCE
#define HLM_GAME_TEXT_USE		101

#define HLM_EXPLOSION_SMOKE		102	//CEnvExplosion::Smoke, 0.3s after the blast
#define HLM_BUBBLE_USE			103
#define HLM_BUBBLE_THINK			104	//CBubbling::FizzThink
#define HLM_SMOKER_THINK			105	//CSmoker::Think
#define HLM_FUNNEL_USE			106
#define HLM_BLOOD_USE			107
#define HLM_SHOOTER_USE			108
#define HLM_SHOOTER_THINK		109	//CGibShooter::ShootThink

//items, chargers and the trigger volumes that act on the player
#define HLM_ITEM_TOUCH			110
#define HLM_CHARGER_USE			111
#define HLM_CHARGER_THINK		112
#define HLM_CONVEYOR_TOUCH		113
#define HLM_FRICTION_TOUCH		114
#define HLM_GRAVITY_TOUCH		115
#define HLM_CHANGELEVEL_TOUCH	116
#define HLM_CHANGELEVEL_USE		117

//env_laser. a beam with a think, unlike env_beam's pure on/off state
#define HLM_LASER_USE			118
#define HLM_LASER_THINK			119	//CLaser::StrikeThink
#define HLM_BEAM_DAMAGE_THINK	120	//CLightning::DamageThink

#define HLM_DECAL_THINK			121	//CDecal::StaticDecal
#define HLM_DECAL_USE			122	//CDecal::TriggerDecal
#define HLM_CDAUDIO_PLAY			123	//CTriggerCDAudio::PlayTrack, as touch or use
#define HLM_CDAUDIO_RADIUS		124	//CTargetCDAudio::Think, the radius poll
#define HLM_MAKER_USE			125	//CMonsterMaker::CyclicUse / ToggleUse
#define HLM_MAKER_THINK			126	//CMonsterMaker::MakerThink
#define HLM_SPEAKER_USE			127	//CSpeaker::ToggleUse

#define HLM_PUSH_MOVE_TOUCH		128	//CPushable::Touch, func_break.cpp:910
#define HLM_PUSH_MOVE_USE		129	//CPushable::Use, func_break.cpp:895
#define HLM_MULTISOURCE_USE		130	//CMultiSource::Use, buttons.cpp:182
#define HLM_ROTATE_SPIN_UP		131	//CFuncRotating::SpinUp, bmodels.cpp:585
#define HLM_ROTATE_SPIN_DOWN		132	//CFuncRotating::SpinDown, bmodels.cpp:615

#define HLM_CAMERA_USE			133	//CTriggerCamera::Use, triggers.cpp:2251
#define HLM_CAMERA_THINK			134	//CTriggerCamera::FollowTarget, :2340
#define HLM_STRIP_USE			135	//CStripWeapons::Use, player.cpp:4935
#define HLM_REVERT_USE			136	//CRevertSaved::Use, player.cpp:5017
#define HLM_REVERT_MESSAGE		137	//CRevertSaved::MessageThink, player.cpp:5025
#define HLM_ENDSECTION			138	//CTriggerEndSection, triggers.cpp:2004/:2035
#define HLM_BEVERAGE_USE			139	//CEnvBeverage::Use, effects.cpp:2161
#define HLM_SODA_THINK			140	//CItemSoda::CanThink, effects.cpp:2235
#define HLM_AUTOSAVE_TOUCH		141	//CTriggerSave::SaveTouch, triggers.cpp:1977
#define HLM_XEN_TREE_TOUCH		142	//CXenTree::Touch, xen.cpp:336

//how long a "toggle" trigger stays untouchable after firing
#define HLENT_TRIGGER_DEBOUNCE	0.2

//SUB_CalcMove refuses to divide by a zero traveltime
#define HLENT_MIN_MOVE_TIME	0.0001

//multi_manager fires up to this many targets, each at its own offset.
//MAX_MULTI_TARGETS, cbase.h:427; CMultiManager::KeyValue drops the rest
//(triggers.cpp:330), so a 34-key manager loses its tail in retail too
#define HLENT_MM_MAX			16

//multi_managers tracked per map. rustmill ships 48 and c1a0e 45; a cap below
//that drops the ones later in the entity lump entirely, and on c1a0e those are
//the resonance cascade's teleport and fade chain
#define HLENT_MM_SLOTS			64

//concurrent cycles one SF_MULTIMAN_THREAD manager may have in flight. The SDK
//is unbounded - ManagerUse clones a whole entity per use, triggers.cpp:432 -
//and this is not; a use with every run busy displaces the oldest. 1098
//multi_managers ship across 109 maps, 19 of them threaded across 8 maps
#define HLENT_MM_THREADS		4

//ATTN_NORM, common/const.h:628. Attenuation divides sound_nominal_clip_dist
//1000, so 0.8 is silence at 1250 units and 0 means "audible everywhere".
//Every user of this constant is an ATTN_NORM site in the SDK.
#define HLENT_SND_ATTEN		HLATTN_NORM

//A mover enum, not CHAN_ values, though the numbers overlap HLCHAN_WEAPON and
//HLCHAN_VOICE. Doors, buttons and chargers now pass the HLCHAN_ constant their
//SDK counterpart emits on; these remain for the sites with no SDK counterpart.
#define HLENT_CHAN_MOVE		1
#define HLENT_CHAN_USE		2

//S_StartSound's channels, for the paths that pass a real entnum. Replacement is
//per (entnum, entchannel), so a monster's voice line cuts its own previous line
//and nothing else.
//CHAN_VOICE and CHAN_BODY, common/const.h:617 and :619. HLSndVoiceAmplitude
//filters on channel 2 to drive the studio mouth controller; 3 is CHAN_ITEM and
//moves no jaw
#define HLENT_CHAN_VOICE		2
#define HLENT_CHAN_BODY		4

class CHLMultiManager
{//parsed out of the entity's own key/values: every key that is not a known
 //field is a targetname, and its value is the delay
	I64	ent;					//owning entity index
	U8	name[HLENT_MM_MAX * 64];
	F64	delay[HLENT_MM_MAX];
	I64	count;

	//one entry per concurrent cycle. started < 0 marks a free run; an unthreaded
	//manager only ever uses run 0. This is the whole of what CMultiManager::Clone
	//duplicates that is not shared - m_index and m_startTime - since the target
	//list and delays are copied verbatim and the class has no other mutable state
	I64	fired[HLENT_MM_THREADS];	//bit per target already fired in this run
	F64	started[HLENT_MM_THREADS];
};

CHLMultiManager	hl_mm[HLENT_MM_SLOTS];
I64				hl_mm_count = 0;

//game clock the entity system runs on. separate from hl_light_time, which is
//a render clock and keeps ticking through a pause
F64	hl_ent_time     = 0.0;
I64	hl_ent_thinks   = 0;
I64	hl_ent_spawned  = 0;

//the player, as an entity the movers can push and triggers can fire on.
//index -1 until a map is up
I64	hl_ent_player   = -1;

//length of the tick HLEntFrame is running, seconds. Anything driven off the
//held +use key rather than off a think needs it
F64	hl_ent_frame_dt = 0.0;

//how long after the last +use an FCAP_CONTINUOUS_USE entity still counts the
//key as down. Seven ticks at the shell's 72Hz, so a stall does not read as a
//release; a real release is noticed within a tenth of a second
#define HLENT_USE_HOLD_GAP	0.1

//--- player state, native side ---------------------------------------------
//
// There is no edict, so the player state the entity world touches lives here.
//
// Trigger effects on the player are pending rather than applied: the shell owns
// hl_origin and hl_velocity, and writing them from inside the entity pass would
// fight the move already in progress this tick.

F64		hl_ent_player_health	= 100.0;
F64		hl_ent_player_armor		= 0.0;
Bool	hl_ent_player_dead		= FALSE;

F64		hl_ent_teleport_to[3];
Bool	hl_ent_teleport_pending	= FALSE;

F64		hl_ent_push_vel[3];
Bool	hl_ent_push_pending		= FALSE;

//SV_PushRotate's effect on a rider. The shell owns hl_origin and hl_angles, so
//the rotation is posted and drained there. pivot is the pusher's origin.
Bool	hl_ent_spin_pending		= FALSE;
F64		hl_ent_spin_pivot[3];
F64		hl_ent_spin_yaw			= 0.0;

//damage the player has taken this tick, applied and cleared by the shell
F64		hl_ent_player_damage	= 0.0;

//the last hit applied to the player and its bitsDamageType, for the death trace
//in HL1.ZC. Post-armour, so it is the figure the health actually lost
F64		hl_ent_last_dmg			= 0.0;
I64		hl_ent_last_dmg_type	= 0;

//--- damage types -----------------------------------------------------------
//
// bitsDamageType, dlls/cbase.h:609-636, complete.
//
// DMG_GENERIC is 0, so a caller that passes nothing gets it.
//
// Bits at 1<<15 and above are the time-based set: a hit carrying one of them
// applies its damage immediately like any other, then leaves a residual the
// player state counts down. Of the eight, only poison and drown-recover have
// live bodies in CBasePlayer::CheckTimeBasedDamage (dlls/player.cpp:2215-2245);
// the other six have their TakeDamage lines commented out and expire silently.

#define HLDMG_GENERIC		0
#define HLDMG_CRUSH			1		//1 << 0, a mover closing on the player
#define HLDMG_BULLET			2		//1 << 1
#define HLDMG_SLASH			4		//1 << 2
#define HLDMG_BURN			8		//1 << 3
#define HLDMG_FREEZE			16		//1 << 4
#define HLDMG_FALL			32		//1 << 5
#define HLDMG_BLAST			64		//1 << 6
#define HLDMG_CLUB			128		//1 << 7
#define HLDMG_SHOCK			256		//1 << 8
#define HLDMG_SONIC			512		//1 << 9
#define HLDMG_ENERGYBEAM		1024	//1 << 10
#define HLDMG_NEVERGIB		4096	//1 << 12
#define HLDMG_ALWAYSGIB		8192	//1 << 13
#define HLDMG_DROWN			16384	//1 << 14

//DMG_TIMEBASED is ~0x3fff in the SDK; here it is the positive mask of the eight
//bits above, which is what a test against a parsed damagetype needs
#define HLDMG_PARALYZE		32768		//1 << 15
#define HLDMG_NERVEGAS		65536		//1 << 16
#define HLDMG_POISON			131072		//1 << 17
#define HLDMG_RADIATION		262144		//1 << 18
#define HLDMG_DROWNRECOVER	524288		//1 << 19
#define HLDMG_ACID			1048576		//1 << 20
#define HLDMG_SLOWBURN		2097152		//1 << 21
#define HLDMG_SLOWFREEZE		4194304		//1 << 22
#define HLDMG_MORTAR			8388608		//1 << 23
#define HLDMG_TIMEBASED		8355840		//1<<15 .. 1<<22

//CheckTimeBasedDamage runs on a 2 second period (dlls/player.cpp:2202) and
//poison is the only entry that still deals damage - the nervegas, radiation,
//acid, slowburn and slowfreeze TakeDamage lines are commented out
//(dlls/player.cpp:2222-2256). POISON_DAMAGE 2.0 over POISON_DURATION 5
//intervals, dlls/cbase.h:651-652.
#define HLDMG_TBD_PERIOD		2.0
#define HLDMG_POISON_DAMAGE	2.0
#define HLDMG_POISON_DURATION 5

//--- player death -----------------------------------------------------------
//
// CBasePlayer::Killed and CBasePlayer::PlayerDeathThink. deadflag is a four
// state machine, not a bool: dying (the animation is playing), dead (the body
// has settled), respawnable (the delay is served and a key press will do it).
//
// hl_ent_player_dead stays as the "is the player dead at all" flag every other
// file already tests. hl_ent_deadflag is the stage inside that.

#define HLDEAD_NO			0
#define HLDEAD_DYING			1	//DEAD_DYING, the death animation is running
#define HLDEAD_DEAD			2	//DEAD_DEAD, settled, waiting for buttons up
#define HLDEAD_RESPAWNABLE	3	//DEAD_RESPAWNABLE, a key press respawns

//CBasePlayer::Killed's own gib threshold. cbase.h's GIB_HEALTH_VALUE is -30 and
//is what CBaseMonster::Killed tests; the player's Killed compares against -40
//directly, so the two are not the same number
#define HLENT_GIB_HEALTH_VALUE	-30.0	//GIB_HEALTH_VALUE, monsters
#define HLENT_PLAYER_GIB_HEALTH	-40.0	//CBasePlayer::Killed

//PlayerDeathThink's animation window: "120 frames at 30fps - animations should
//be no longer than this"
#define HLENT_DEATH_ANIM_TIME	4.0

//the delay between the body settling and the respawn gate opening. HL's
//singleplayer path opens it as soon as every button is released; the wait is
//there so a key still held from the death frame does not respawn instantly
#define HLENT_RESPAWN_DELAY		0.5

//deadflag. HLDEAD_*
I64		hl_ent_deadflag			= HLDEAD_NO;

//gpGlobals->time the player died, on the ENTITY clock. The death animation
//window is measured from it
F64		hl_ent_death_time		= 0.0;

//m_fDeadTime - when the body finished settling and became respawnable
F64		hl_ent_dead_time		= 0.0;

//Killed's gib branch fired. The shell hides the view model and the corpse
Bool	hl_ent_player_gibbed	= FALSE;

//PM_DEAD_VIEWHEIGHT, pm_shared.c. The shell adds this to the origin instead of
//the normal 28 while the player is dead, and rolls the view by
//hl_ent_death_roll - the client's "dead view angle", cl_dll/view.cpp
#define HLENT_DEAD_VIEWHEIGHT	-8.0
#define HLENT_DEAD_VIEW_ROLL		80.0

//eye height above the player origin to use INSTEAD of the normal one, valid
//only while hl_ent_player_dead. A substitution rather than an offset, as
//pm_shared's "pmove->view_ofs[2] = PM_DEAD_VIEWHEIGHT" is; it ramps from
//HLPHYS_VIEW_Z down to HLENT_DEAD_VIEWHEIGHT across the death animation, which
//is the body falling over seen from inside it
F64		hl_ent_death_view_ofs	= HLPHYS_VIEW_Z;

//degrees of roll to ADD to the view. 0 while alive
F64		hl_ent_death_roll		= 0.0;

//"the player may not act". Set for the whole of death and cleared on respawn.
//The shell must drop movement, weapon and +use input while it is set - HL does
//this by taking the player's think away, which has no equivalent here
Bool	hl_ent_input_locked		= FALSE;

//the respawn gate. PlayerDeathThink waits for every button to be RELEASED, then
//for one to be PRESSED again. The shell owns the keyboard, so it publishes
//"something is down" here and the death think reads it
Bool	hl_ent_death_button		= FALSE;

//respawn request. Drained by the shell, which owns hl_origin and hl_angles:
//origin is an info_player_start, as CBasePlayer::Spawn's GetPlayerSpawnSpot
Bool	hl_ent_respawn_pending	= FALSE;
F64		hl_ent_respawn_org[3];
F64		hl_ent_respawn_ang[3];

//--- HEV suit voice ---------------------------------------------------------
//
// CBasePlayer::SetSuitUpdate / CheckSuitUpdate, dlls/player.cpp:2403-2557. A
// short queue rather than a single slot: several lines are raised by one hit and
// the suit reads them out one at a time, 3.5 seconds apart.
//
// The queue holds names, not the SDK's sentence and group indices. HLSound.ZC
// resolves a name at playback and a group index has no reverse lookup here.
// A leading ! is a specific sentence, as it is everywhere else in the tree;
// anything else is a group. That distinction carries the SDK's fgroup argument.
//
// The word scheduler is in HLAI.ZC and compiles after this file, so a picked
// line goes out through HLSound.ZC's sentence request queue, which HLAI.ZC
// drains.

//CSUITPLAYLIST, CSUITNOREPEAT, CBSENTENCENAME_MAX+1, player.h:45,58
#define HLENT_SUITQ_MAX		4
#define HLENT_SUITNR_MAX		32
#define HLENT_SUITNAME		32

//SUITUPDATETIME, SUITFIRSTUPDATETIME, player.cpp:2400-2401
#define HLENT_SUIT_UPDATE	3.5
#define HLENT_SUIT_FIRST		0.1

//EMIT_SOUND_SUIT's level. The suit speaks into the player's ear, so it is heard
//everywhere: attenuation 0
#define HLENT_SUIT_VOL		0.85

//flat blocks at a fixed stride: an array of string pointers collapses to one
//entry. An empty slot is a leading NUL
U8		hl_ent_suitq[HLENT_SUITQ_MAX * HLENT_SUITNAME];
I64		hl_ent_suitq_next;		//m_iSuitPlayNext
F64		hl_ent_suit_update;		//m_flSuitUpdate, 0 = the queue is idle

U8		hl_ent_suitnr[HLENT_SUITNR_MAX * HLENT_SUITNAME];
F64		hl_ent_suitnr_time[HLENT_SUITNR_MAX];

//GEIGERDELAY, player.cpp:2361. m_flgeigerDelay: the next entity-clock time the
//range is re-measured
#define HLENT_GEIGER_DELAY	0.25
F64		hl_ent_geiger_delay;

U0 HLEntSuitQueueReset()
{//SetSuitUpdate(NULL): empty the playlist. The norepeat list goes with it,
 //since its times are on the entity clock and a new map restarts that
	I64 i;

	for (i = 0; i < HLENT_SUITQ_MAX; i++)
		hl_ent_suitq[i * HLENT_SUITNAME] = 0;

	for (i = 0; i < HLENT_SUITNR_MAX; i++)
	{
		hl_ent_suitnr[i * HLENT_SUITNAME] = 0;
		hl_ent_suitnr_time[i]             = 0.0;
	}

	hl_ent_suitq_next  = 0;
	hl_ent_suit_update = 0.0;
}

//--- pending screen and player effects, from the env_* / trigger_* classes ---
//
// Same rule as the teleport above: the entity pass owns neither the view, the
// player's gravity, nor which map loads next. Each is a request HL1.ZC drains.

//player origin at the start of this tick's entity pass, stashed by HLEntFrame.
//A think running later in the tick (a charger metering out health, an env_sound
//testing its radius) has no origin argument
F64		hl_ent_player_org[3];

//env_shake. amplitude in units, frequency in Hz, both straight off the entity.
//hl_ent_shake_until is on the ENTITY clock, so a paused game does not shake
F64		hl_ent_shake_amp		= 0.0;
F64		hl_ent_shake_freq		= 0.0;
F64		hl_ent_shake_until		= 0.0;
Bool	hl_ent_shake_pending	= FALSE;

//env_fade. renderamt is the alpha 0..255 and rendercolor the colour, which is
//how the SDK stores it - there are no dedicated keys
F64		hl_ent_fade_color[3];
F64		hl_ent_fade_alpha		= 0.0;
F64		hl_ent_fade_duration	= 0.0;
F64		hl_ent_fade_hold		= 0.0;
Bool	hl_ent_fade_in			= FALSE;	//SF_FADE_IN: fade FROM the colour
Bool	hl_ent_fade_pending		= FALSE;

//trigger_gravity. a multiplier on the normal 800, not an absolute value.
//persistent: HL leaves it set until another trigger changes it, so a low
//gravity section stays low after the brush is left
F64		hl_ent_gravity			= 1.0;

//env_sound. the reverb preset for wherever the player is standing, recomputed
//every tick by HLEntFrame. 0 is "normal room", which is also the no-op value
I64		hl_ent_roomtype			= 0;

//trigger_changelevel. HL1.ZC owns HLChangeLevel and compiles after this file,
//so the request is posted here and drained there. Not mirrored into
//hl_change_map/hl_change_pending: the shell's main loop drains those already,
//and setting both changes level twice
U8		hl_ent_changelevel[64];
U8		hl_ent_changelevel_landmark[64];
Bool	hl_ent_changelevel_pending	= FALSE;

//--- changelevel capture ----------------------------------------------------
//
// `cllog 1` records the touch path against every trigger_changelevel in the
// map, written to ::/Apps/HL1/CLLOG.TXT. Armed and flushed on the cvar edge,
// the way ridelog is.
//
// One record per tick while the player box is within HLCL_NEAR of the volume,
// plus one every HLCL_BEAT ticks otherwise, so a car that never arrives is
// still tracked. c0a0's volume is a 24 unit slab at x -2280..-2256 and the
// tram crosses it at 300 units/s: the near band is what makes the crossing
// legible, the beat is what shows where the car went instead.
//
// A ring is not needed. The near band is entered once per map and the beat is
// decimated, so HLCL_LINES covers minutes.
#define HLCL_LINES	768
#define HLCL_WIDTH	192
#define HLCL_NEAR	512.0	//units, per axis, from the volume's box
#define HLCL_BEAT	64		//ticks between out-of-band records

U8	   *hl_cl_buf		= NULL;	//HLCL_LINES * HLCL_WIDTH, live while armed
Bool	hl_cl_log		= FALSE;
I64		hl_cl_lines		= 0;
I64		hl_cl_ticks		= 0;

//furthest point HLChangeLevelTouch reached, and how many times it was
//dispatched. 0 is "never entered".
//  1 entity gone     2 master denied   3 no map key
//  4 already pending 5 posted
I64		hl_cl_stage		= 0;
I64		hl_cl_touches	= 0;

//globals are not zeroed and the declaration initialisers above do not run. The
//buffer pointer is freed on the disarm edge, so it has to start NULL
hl_cl_buf		= NULL;
hl_cl_log		= FALSE;
hl_cl_lines		= 0;
hl_cl_ticks		= 0;
hl_cl_stage		= 0;
hl_cl_touches	= 0;

//trigger_autosave. SERVER_COMMAND("autosave\n") in the SDK; here a request the
//shell drains, for the same reason the changelevel one is: HLSave.ZC and the
//slot path both compile after this file
Bool	hl_ent_autosave_pending		= FALSE;

//player view angles at the start of this tick's entity pass, the twin of
//hl_ent_player_org. Pitch is the engine's sign - down is positive - because
//that is what the shell holds and what SF_CAMERA_PLAYER_POSITION negates
F64		hl_ent_player_ang[3];

//trigger_camera. The eye belongs to the shell, so the camera publishes one and
//HL1.ZC substitutes it for the player's, the way env_fade publishes an overlay.
//hl_ent_cam_freeze is SF_CAMERA_PLAYER_TAKECONTROL: EnableControl(FALSE), the
//player keeps his body and loses input for the length of the shot
F64		hl_ent_cam_org[3];
F64		hl_ent_cam_ang[3];
Bool	hl_ent_cam_active	= FALSE;
Bool	hl_ent_cam_freeze	= FALSE;
I64		hl_ent_cam_ent		= -1;		//which camera holds the view, -1 none

//player_weaponstrip. RemoveAllItems(FALSE), player.cpp:4948. HLWeapon.ZC owns
//the inventory and compiles after this file, so the strip is a request it
//drains - the same treatment the teleport gets
Bool	hl_ent_weaponstrip_pending	= FALSE;

//player_loadsaved. The reload itself needs a save system; the fade, the message
//and the timing are the entity's and run here. The shell drains the request
Bool	hl_ent_loadsaved_pending	= FALSE;

//trigger_endsection. pfnEndSection takes the section name and hands the player
//back to the menu. The name is carried so the shell can pick a credits roll
U8		hl_ent_endsection[64];
Bool	hl_ent_endsection_pending	= FALSE;

//--- transition carry --------------------------------------------------------
//
// CChangeLevel::ChangeLevelNow carries the entities inside the transition
// volume into the next map, and DispatchRestore merges each one onto the
// destination map's entity of the same globalname, repositioned by the landmark
// offset (saverestore.cpp). Without that merge the destination copy sits at its
// own first path node: c0a0a's tram parks at trainstop27, 2408 units along the
// track from trainstop16 where the player arrives, and drives away.
//
// Only the tracktrain the player is riding is carried. That is narrower than
// the SDK, which carries everything in the volume, and it is the case the intro
// ride needs.
//
// The carry itself matches on globalname (HLEnt.ZC:1519 parses the key into
// e->global_name); every map in the intro chain names its tram "train" and
// globals it "intro_train".
U8		hl_ent_carry_name[64];
U8		hl_ent_carry_path[64];		//m_ppath - the node the car last passed
F64		hl_ent_carry_org[3];		//relative to the OLD map's landmark
F64		hl_ent_carry_ang[3];
F64		hl_ent_carry_speed			= 0.0;
Bool	hl_ent_carry_valid			= FALSE;

//item_suit / item_longjump. flags for the layers that own the HUD gating and
//the jump change
Bool	hl_ent_player_suit		= FALSE;

//sv_cheats state. HL keeps these as FL_GODMODE / FL_NOTARGET on the player
//edict; there is no player edict here, so they are flags on the native player.
Bool	hl_ent_godmode			= FALSE;
Bool	hl_ent_notarget			= FALSE;
Bool	hl_ent_player_longjump	= FALSE;

//MAX_NORMAL_BATTERY. a battery picked up at 100 armour is refused
//pev->effects. EF_NODRAW is the only bit this port acts on.
#define HLEF_NODRAW			128

#define HLENT_MAX_ARMOR		100.0
#define HLENT_MAX_HEALTH		100.0

U0 HLEntPlayerReset()
{//globals aren't zeroed and a declaration initialiser on one is unreliable
	hl_ent_player_health   = 100.0;
	hl_ent_player_armor    = 0.0;
	hl_ent_player_dead     = FALSE;
	hl_ent_player_damage   = 0.0;
	hl_ent_last_dmg        = 0.0;
	hl_ent_last_dmg_type   = 0;

	//CBasePlayer::Spawn's deadflag = DEAD_NO and view_ofs = VEC_VIEW
	hl_ent_deadflag        = HLDEAD_NO;
	hl_ent_death_time      = 0.0;
	hl_ent_dead_time       = 0.0;
	hl_ent_player_gibbed   = FALSE;
	hl_ent_death_view_ofs  = HLPHYS_VIEW_Z;
	hl_ent_death_roll      = 0.0;
	hl_ent_input_locked    = FALSE;
	hl_ent_death_button    = FALSE;
	hl_ent_respawn_pending = FALSE;

	HLEntSuitQueueReset;

	//m_flgeigerRange starts at its no-source value; the counter is silent until
	//a scan lowers it
	hl_hud_geiger_range   = 1000.0;
	hl_ent_geiger_delay   = 0.0;

	HLVecSet(hl_ent_respawn_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_respawn_ang, 0.0, 0.0, 0.0);
	hl_ent_teleport_pending = FALSE;
	hl_ent_push_pending    = FALSE;
	hl_ent_spin_pending    = FALSE;
	hl_ent_spin_yaw        = 0.0;

	HLVecSet(hl_ent_teleport_to, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_push_vel, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_spin_pivot, 0.0, 0.0, 0.0);

	HLVecSet(hl_ent_player_org, 0.0, 0.0, 0.0);

	hl_ent_shake_amp     = 0.0;
	hl_ent_shake_freq    = 0.0;
	hl_ent_shake_until   = 0.0;
	hl_ent_shake_pending = FALSE;

	HLVecSet(hl_ent_fade_color, 0.0, 0.0, 0.0);
	hl_ent_fade_alpha    = 0.0;
	hl_ent_fade_duration = 0.0;
	hl_ent_fade_hold     = 0.0;
	hl_ent_fade_in       = FALSE;
	hl_ent_fade_pending  = FALSE;

	hl_ent_gravity  = 1.0;

	//a new map starts dry: the mixer holds the last roomtype until an env_sound
	//replaces it, so it has to be told
	hl_ent_roomtype = 0;
	HLSndRoomtypeSet(0);

	hl_ent_changelevel[0]      = 0;
	hl_ent_changelevel_pending = FALSE;
	hl_ent_autosave_pending    = FALSE;

	HLVecSet(hl_ent_player_ang, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_cam_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_cam_ang, 0.0, 0.0, 0.0);
	hl_ent_cam_active = FALSE;
	hl_ent_cam_freeze = FALSE;
	hl_ent_cam_ent    = -1;

	hl_ent_weaponstrip_pending = FALSE;
	hl_ent_loadsaved_pending   = FALSE;
	hl_ent_endsection[0]       = 0;
	hl_ent_endsection_pending  = FALSE;

	//not the suit or the longjump: those are inventory and survive a
	//changelevel. See HLEntPlayerNewGame
	//
	//Nor the landmark name or the transition carry. HLEntSpawnAll calls this at
	//the top of the new map's spawn pass, and both are read after that: the
	//carry by HLEntSpawnTrain during the pass, the landmark by HLChangeLevel
	//once the pass has finished. Clearing them here places every transition at
	//info_player_start instead of at the landmark.
}

HLEntPlayerReset;

U0 HLEntPlayerNewGame()
{//what a changelevel must not clear. called from outside this file: only the
 //shell distinguishes "new game" from "next map"
	hl_ent_player_suit     = FALSE;
	hl_ent_godmode         = FALSE;
	hl_ent_notarget        = FALSE;
	hl_ent_player_longjump = FALSE;

	//A landmark and a carried car belong to a transition in progress. They
	//outlive HLEntPlayerReset by design; a new game is where they end
	hl_ent_changelevel_landmark[0] = 0;

	hl_ent_carry_name[0] = 0;
	hl_ent_carry_path[0] = 0;
	hl_ent_carry_speed   = 0.0;
	hl_ent_carry_valid   = FALSE;
	HLVecSet(hl_ent_carry_org, 0.0, 0.0, 0.0);
	HLVecSet(hl_ent_carry_ang, 0.0, 0.0, 0.0);
}

HLEntPlayerNewGame;

//--- global state (env_global) -----------------------------------------------
//
// HL's cross-level flags. A named state that survives a changelevel, set by
// env_global and read by any entity with a globalstate key.
//
// Not cleared by HLEntSpawnAll: surviving the map change is the point.
// HLEntGlobalResetAll is for a new game and, like HLEntPlayerNewGame, is called
// from outside.

#define HLENT_GLOBAL_MAX		64

#define HLGLOBAL_OFF			0
#define HLGLOBAL_ON			1
#define HLGLOBAL_DEAD		2

class CHLEntGlobalState
{
	U8	name[64];
	I64	state;
};

CHLEntGlobalState	hl_ent_globals[HLENT_GLOBAL_MAX];
I64					hl_ent_global_count = 0;

U0 HLEntGlobalResetAll()
{
	I64 i;

	for (i = 0; i < HLENT_GLOBAL_MAX; i++)
	{
		hl_ent_globals[i].name[0] = 0;
		hl_ent_globals[i].state   = HLGLOBAL_OFF;
	}

	hl_ent_global_count = 0;
}

HLEntGlobalResetAll;

I64 HLEntGlobalGet(U8 *name)
{//HLGLOBAL_OFF for anything never set, as on an unvisited level
	I64 i;

	if (!name || !name[0])
		return HLGLOBAL_OFF;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
			return hl_ent_globals[i].state;
	}

	return HLGLOBAL_OFF;
}

U0 HLEntGlobalSet(U8 *name, I64 state)
{
	I64 i;

	if (!name || !name[0])
		return;

	for (i = 0; i < hl_ent_global_count; i++)
	{
		if (!StrICompare(hl_ent_globals[i].name, name))
		{
			hl_ent_globals[i].state = state;
			return;
		}
	}

	if (hl_ent_global_count >= HLENT_GLOBAL_MAX)
		return;

	i = hl_ent_global_count;
	HLStrCopy(hl_ent_globals[i].name, name, 64);
	hl_ent_globals[i].state = state;
	hl_ent_global_count     = i + 1;
}

//--- globalname persistence (CGlobalState) -----------------------------------
//
// The pev->globalname table, world.cpp:275-420. Distinct from the env_global
// table above: that one is keyed on the "globalstate" key and read by
// multisource and master gating; this one is keyed on "globalname" and decides
// whether an entity exists at all on a map the player returns to.
//
// CBaseEntity::UpdateOnRemove, subs.cpp:109: an entity with a globalname sets
// its entry GLOBAL_DEAD as it is removed. DispatchSpawn, cbase.cpp:156: an
// entity whose globalname is already GLOBAL_DEAD is deleted instead of spawned,
// and one absent from the table is added GLOBAL_ON.
//
// 363 shipped entities carry the key across 62 maps - 204 func_breakable, 63
// func_door, 50 func_pushable, 22 func_tracktrain, 18 func_train, 4
// func_door_rotating, 2 monster_apache - resolving to 172 distinct names, at
// most 46 on one map (c2a2b1). The table spans a whole playthrough, so it is
// sized for the 172, not the 46.
//
// Only removal writes DEAD, and only func_breakable and func_pushable are ever
// removed, so what this buys is: a crate smashed before a changelevel is still
// smashed on the way back.
//
// Deviation: DispatchSpawn's middle clause - "levelName is not this map, so
// MakeDormant" - is not implemented. It exists to hold the destination copy of
// a carried entity inert until DispatchRestore's merge calls EntityUpdate, and
// this port's carry covers only the ridden tracktrain (see hl_ent_carry_*).
// Spawning the other 341 dormant would make them permanently invisible and
// non-solid. levelName is recorded so the clause can be added with the carry.

#define HLENT_GLOBALNAME_MAX	192

class CHLEntGlobalName
{
	U8	name[64];
	U8	level[64];
	I64	state;
};

CHLEntGlobalName	hl_ent_globalnames[HLENT_GLOBALNAME_MAX];
I64					hl_ent_globalname_count = 0;

U0 HLEntGlobalNameResetAll()
{//a new game. Surviving a changelevel is the point, so nothing else clears it
	I64 i;

	for (i = 0; i < HLENT_GLOBALNAME_MAX; i++)
	{
		hl_ent_globalnames[i].name[0]  = 0;
		hl_ent_globalnames[i].level[0] = 0;
		hl_ent_globalnames[i].state    = HLGLOBAL_OFF;
	}

	hl_ent_globalname_count = 0;
}

HLEntGlobalNameResetAll;

U0 HLEntNewGame()
{//everything that survives a changelevel and must not survive a new game.
 //
 //The three tables below are cleared at load only, so a second campaign in one
 //session inherits the first one's env_global flags, its dead globalnames and
 //its suit. Defined here because it is the last of the three declarations.
	HLEntPlayerNewGame;
	HLEntGlobalResetAll;
	HLEntGlobalNameResetAll;
}

I64 HLEntGlobalNameFind(U8 *name)
{//CGlobalState::Find, world.cpp:275. Slot index, -1 for not in the table
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = 0; i < hl_ent_globalname_count; i++)
	{
		if (!StrICompare(hl_ent_globalnames[i].name, name))
			return i;
	}

	return -1;
}

U0 HLEntGlobalNameAdd(U8 *name, U8 *level, I64 state)
{//CGlobalState::EntityAdd, world.cpp:315
	I64 i;

	if (!name || !name[0])
		return;

	if (HLEntGlobalNameFind(name) >= 0)
		return;

	if (hl_ent_globalname_count >= HLENT_GLOBALNAME_MAX)
		return;

	i = hl_ent_globalname_count;

	HLStrCopy(hl_ent_globalnames[i].name, name, 64);
	HLStrCopy(hl_ent_globalnames[i].level, level, 64);
	hl_ent_globalnames[i].state = state;

	hl_ent_globalname_count = i + 1;
}

U0 HLEntGlobalNameSetState(U8 *name, I64 state)
{//CGlobalState::EntitySetState, world.cpp:330. Silently drops a name that was
 //never added, as the SDK does
	I64 i = HLEntGlobalNameFind(name);

	if (i < 0)
		return;

	hl_ent_globalnames[i].state = state;
}

U0 HLEntGlobalNameUpdate(U8 *name, U8 *level)
{//CGlobalState::EntityUpdate, world.cpp:414: the global's definition now comes
 //from this map
	I64 i = HLEntGlobalNameFind(name);

	if (i < 0)
		return;

	HLStrCopy(hl_ent_globalnames[i].level, level, 64);
}

U0 HLEntGlobalNameDied(CHLEntity *e)
{//CBaseEntity::UpdateOnRemove, subs.cpp:109
	if (!e || !e->global_name[0])
		return;

	HLEntGlobalNameSetState(e->global_name, HLGLOBAL_DEAD);
}

Bool HLEntGlobalNameSpawnAllows(CHLEntity *e, U8 *level)
{//DispatchSpawn's global block, cbase.cpp:156. FALSE means "already dead on a
 //previous visit, do not spawn"
	I64 i;

	if (!e || !e->global_name[0])
		return TRUE;

	i = HLEntGlobalNameFind(e->global_name);

	if (i < 0)
	{
		//"Spawned entities default to 'On'", cbase.cpp:170
		HLEntGlobalNameAdd(e->global_name, level, HLGLOBAL_ON);
		return TRUE;
	}

	if (hl_ent_globalnames[i].state == HLGLOBAL_DEAD)
		return FALSE;

	//this map now owns the global
	HLStrCopy(hl_ent_globalnames[i].level, level, 64);

	return TRUE;
}

I64 HLEntCountInUse()
{//impulse 104's report.
	I64 n = 0;
	I64 i;

	if (!hl_entities)
		return 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use)
			n++;
	}

	return n;
}

U0 HLEntSuitUpdate(U8 *name, F64 norepeat = 0.0)
{//CBasePlayer::SetSuitUpdate, dlls/player.cpp:2463. name is "!HEV_DMG4" for one
 //sentence or "HEV_DEAD" for a group. norepeat is in seconds; 0 is SUIT_REPEAT_OK
	I64	i;
	I64	empty = -1;

	//"Ignore suit updates if no suit"
	if (!hl_ent_player_suit || !name || !name[0])
		return;

	//SENTENCEG_Lookup / SENTENCEG_GetIndex reject an unknown name before it
	//reaches the queue, so a typo in a map or a missing sentences.txt does not
	//stall the playlist on a line that can never be spoken
	if (name[0] == '!')
	{
		if (HLSndSentenceLookup(name) < 0)
			return;
	}
	else if (HLSndSentenceGroupIndex(name) < 0)
		return;

	//the norepeat list cancels a line already spoken inside its window
	for (i = 0; i < HLENT_SUITNR_MAX; i++)
	{
		if (!hl_ent_suitnr[i * HLENT_SUITNAME])
		{
			empty = i;
			goto qesu_next_nr;
		}

		if (StrCompare(&hl_ent_suitnr[i * HLENT_SUITNAME], name))
			goto qesu_next_nr;

		//still marked
		if (hl_ent_suitnr_time[i] >= hl_ent_time)
			return;

		//the window has expired, take the slot back
		hl_ent_suitnr[i * HLENT_SUITNAME] = 0;
		hl_ent_suitnr_time[i]             = 0.0;
		empty                             = i;
		break;

qesu_next_nr:
	}

	if (norepeat > 0.0)
	{
		//"pick random slot to take over"
		if (empty < 0)
			empty = HLPartRandI(HLENT_SUITNR_MAX);

		HLStrCopy(&hl_ent_suitnr[empty * HLENT_SUITNAME], name, HLENT_SUITNAME);
		hl_ent_suitnr_time[empty] = hl_ent_time + norepeat;
	}

	//"find empty spot in queue, or overwrite last spot" - m_iSuitPlayNext walks
	//forward and wraps, so a fifth line displaces the oldest
	HLStrCopy(&hl_ent_suitq[hl_ent_suitq_next * HLENT_SUITNAME], name,
		HLENT_SUITNAME);

	hl_ent_suitq_next++;
	if (hl_ent_suitq_next == HLENT_SUITQ_MAX)
		hl_ent_suitq_next = 0;

	if (hl_ent_suit_update <= hl_ent_time)
	{
		//"play queue is empty, don't delay too long before playback"
		if (hl_ent_suit_update == 0.0)
			hl_ent_suit_update = hl_ent_time + HLENT_SUIT_FIRST;
		else
			hl_ent_suit_update = hl_ent_time + HLENT_SUIT_UPDATE;
	}
}

U0 HLEntSuitGroup(U8 *group)
{//EMIT_GROUPNAME_SUIT with SUIT_REPEAT_OK
	HLEntSuitUpdate(group, 0.0);
}

U0 HLEntUpdateGeigerCounter()
{//CBasePlayer::UpdateGeigerCounter (player.cpp:2363) and
 //CTriggerHurt::RadiationThink (triggers.cpp:838) collapsed into one scan.
 //
 //The SDK splits the measurement: every radiation trigger_hurt runs its own
 //0.25s think that lowers m_flgeigerRange when it is nearer than the current
 //value, and the player's own 0.25s tick raises it back to 1000 one time in
 //four. That min-with-decay reconstructs "nearest source" from N independent
 //writers. One writer scanning all of them gives the same answer directly, and
 //without the up-to-four-tick lag before the range recovers on leaving a pool.
 //
 //Range is centre to centre: the trigger's absbox centre against the player's,
 //triggers.cpp:877-878. Units are world units, 1000 meaning "no source".
 //
 //FIND_CLIENT_IN_PVS (triggers.cpp:862) is not reproduced. It is a visibility
 //gate on a warning whose whole purpose is to sound before the pool is in
 //sight; honouring it silences the counter the moment the player rounds a
 //corner toward the source, which is when it should be loudest.
 //
 //SF_TRIGGER_HURT_START_OFF is not consulted, matching the SDK: Spawn clears
 //solid but leaves RadiationThink scheduled, so a switched-off volume still
 //ranges. in_use is the only gate, since a removed entity loses its think
	F64	 nearest = 1000.0;
	F64	 pc[3];
	F64	 tc[3];
	F64	 d[3];
	F64	 range;
	I64	 i;
	I64	 j;

	if (hl_ent_time < hl_ent_geiger_delay)
		return;

	hl_ent_geiger_delay = hl_ent_time + HLENT_GEIGER_DELAY;

	if (!hl_entities)
	{
		hl_hud_geiger_range = 1000.0;
		return;
	}

	//the player has no entity slot and so no absbox; its centre comes from the
	//live hull, which is the ducked one while ducked
	for (j = 0; j < 3; j++)
		pc[j] = hl_ent_player_org[j] +
			(hl_player_mins[j] + hl_player_maxs[j]) * 0.5;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qeug_next;

		if (!(hl_entities[i].damage_type & HLDMG_RADIATION))
			goto qeug_next;

		if (StrCompare(hl_entities[i].classname, "trigger_hurt"))
			goto qeug_next;

		for (j = 0; j < 3; j++)
		{
			tc[j] = (hl_entities[i].absmin[j] + hl_entities[i].absmax[j]) * 0.5;
			d[j]  = tc[j] - pc[j];
		}

		range = HLVecLength(d);

		if (range < nearest)
			nearest = range;

qeug_next:
	}

	hl_hud_geiger_range = nearest;
}

U0 HLEntCheckSuitUpdate()
{//CBasePlayer::CheckSuitUpdate, dlls/player.cpp:2403, run from PostThink.
 //One line per call, at most one every SUITUPDATETIME.
	U8	*slot;
	I64	 search;
	I64	 i;

	if (!hl_ent_player_suit)
		return;

	//player.cpp:2409-2414: no suit means no geiger, and the geiger runs on its
	//own cadence ahead of the suit's timer. Placing it after the timer test
	//would gate a 0.25s measurement on a 3.5s voice queue
	HLEntUpdateGeigerCounter;

	if (hl_ent_suit_update <= 0.0 || hl_ent_time < hl_ent_suit_update)
		return;

	//"play a sentence off of the end of the queue"
	search = hl_ent_suitq_next;
	slot   = NULL;

	for (i = 0; i < HLENT_SUITQ_MAX; i++)
	{
		if (hl_ent_suitq[search * HLENT_SUITNAME])
		{
			slot = &hl_ent_suitq[search * HLENT_SUITNAME];
			break;
		}

		search++;
		if (search == HLENT_SUITQ_MAX)
			search = 0;
	}

	if (!slot)
	{
		//"queue is empty, don't check"
		hl_ent_suit_update = 0.0;
		return;
	}

	//EMIT_SOUND_SUIT reaches EMIT_SOUND_DYN on CHAN_STATIC at ATTN_NORM,
	//sound.cpp:1439. On CHAN_VOICE the suit and the player's pain share a key
	//and the suit replaces the pain sound.
	if (slot[0] == '!')
		HLSndSentenceQueue(slot, hl_ent_player_org, HLENT_SUIT_VOL, HLATTN_NORM,
			HLPITCH_NORM, hl_ent_player + 1, HLCHAN_STATIC);
	else
		HLSndSentencePlayRndSz(slot, hl_ent_player_org, HLENT_SUIT_VOL,
			HLATTN_NORM, HLPITCH_NORM, hl_ent_player + 1, HLCHAN_STATIC);

	slot[0]            = 0;
	hl_ent_suit_update = hl_ent_time + HLENT_SUIT_UPDATE;
}

U0 HLEntPlayerDeathSound(I64 damage_type)
{//CBasePlayer::DeathSound - one of five draws, two of which are silence, then
 //the suit's death group
	I64 n;

	//the water death is in the SDK as a commented block testing waterlevel == 3.
	//Restored here on DMG_DROWN, which is the same condition by the time the
	//damage arrives, and is the one sample a drowning has
	if (damage_type & HLDMG_DROWN)
	{
		//ATTN_NONE: heard everywhere, since it is the player's own death
		HLSndPlayAt("player/h2odeath.wav", hl_ent_player_org, 1.0, 0.0,
			hl_ent_player + 1, HLENT_CHAN_VOICE);
		goto qepds_suit;
	}

	//"temporarily using pain sounds for death sounds" - Valve's own comment.
	//RANDOM_LONG(1,5) with no case 4 or 5, so death is silent two times in five
	n = HLPartRandI(5) + 1;

	if (n == 1)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 2)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 3)
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);

qepds_suit:
	HLEntSuitGroup("HEV_DEAD");
}

U0 HLEntPlayerPainSound()
{//CBasePlayer::Pain - a flat third each, not the death sound's five-way draw
	I64 n = HLPartRandI(3);

	if (n == 0)
		HLSndPlayAt("player/pl_pain5.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else if (n == 1)
		HLSndPlayAt("player/pl_pain6.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
	else
		HLSndPlayAt("player/pl_pain7.wav", hl_ent_player_org, 1.0,
			HLENT_SND_ATTEN, hl_ent_player + 1, HLENT_CHAN_VOICE);
}

U0 HLEntGibPlayer()
{//CBaseMonster::GibMonster on the player. HasHumanGibs is true for a player, so
 //it is one head gib plus four random ones out of hgibs.mdl
	F64 absmin[3];
	F64 size[3];
	F64 dir[3];
	F64 eye[3];
	I64 i;

	HLSndPlayAt("common/bodysplat.wav", hl_ent_player_org, 1.0, HLENT_SND_ATTEN,
		hl_ent_player + 1, HLENT_CHAN_BODY);

	//SpawnRandomGibs works in the victim's box, which for the player is the
	//standing hull around the origin
	for (i = 0; i < 3; i++)
	{
		absmin[i] = hl_ent_player_org[i] + hl_player_mins[i];
		size[i]   = hl_player_maxs[i] - hl_player_mins[i];
	}

	//g_vecAttackDir, the direction the killing blow came from. There is no
	//inflictor recorded here, so the gibs go straight up rather than back down
	//an attack vector
	HLVecSet(dir, 0.0, 0.0, -1.0);

	//SpawnHeadGib comes off the eye. Its target argument is another player to
	//throw the skull at, which single player has none of
	HLVecCopy(hl_ent_player_org, eye);
	eye[2] += HLPHYS_VIEW_Z;

	HLGibSpawnHeadGib(eye, NULL, hl_ent_player_health, HLBLOOD_RED, tS);
	HLGibSpawnRandomGibs(absmin, size, dir, hl_ent_player_health, 4, TRUE,
		HLBLOOD_RED, tS);
}

U0 HLEntPlayerKilled(I64 damage_type)
{//CBasePlayer::Killed
 //
 //Everything the SDK does through the client message channel - the health and
 //ammo HUD updates, the FOV reset, the model swap - is skipped: the HUD reads
 //hl_ent_player_health directly and there is no player model to swap
	if (hl_ent_player_dead)
		return;

	hl_ent_player_dead  = TRUE;
	hl_ent_deadflag     = HLDEAD_DYING;
	hl_ent_death_time   = hl_ent_time;
	hl_ent_dead_time    = 0.0;
	hl_ent_input_locked = TRUE;

	//the view drops to the floor over the death animation. Held at the standing
	//height for this frame and ramped by the death think
	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;

	//( pev->health < -40 && iGib != GIB_NEVER ) || iGib == GIB_ALWAYS. The port
	//has no iGib argument, so it comes off the damage bits, which is where
	//CBaseMonster::TakeDamage got it from in the first place
	hl_ent_player_gibbed = FALSE;

	if (damage_type & HLDMG_ALWAYSGIB)
		hl_ent_player_gibbed = TRUE;
	else if (hl_ent_player_health < HLENT_PLAYER_GIB_HEALTH &&
		!(damage_type & HLDMG_NEVERGIB))
		hl_ent_player_gibbed = TRUE;

	if (hl_ent_player_gibbed)
	{
		//GibMonster clears the model and returns before DeathSound: a gibbed
		//player makes no death noise of their own
		HLEntGibPlayer;

		//the body is gone, so there is no animation to wait out
		hl_ent_death_view_ofs = HLENT_DEAD_VIEWHEIGHT;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL;
		hl_ent_deadflag       = HLDEAD_DEAD;
		hl_ent_dead_time      = hl_ent_time;
		return;
	}

	HLEntPlayerDeathSound(damage_type);
}

U0 HLEntKillPlayer()
{//ClientKill: suicide, straight to dead with no damage accounting and no
 //godmode exemption.
	hl_ent_player_health = 0.0;
	HLEntPlayerKilled(HLDMG_GENERIC);
}

U0 HLEntHurtPlayer(F64 damage, I64 damage_type = HLDMG_GENERIC,
	F64 *source = NULL)
{//CBasePlayer::TakeDamage
 //
 //ArmorRatio: the suit soaks 80% of incoming damage while charge remains, at 2
 //points of charge per point absorbed. ARMOR_RATIO 0.2, ARMOR_BONUS 0.5
 //
 //source is the attacker's world position for the damage compass. NULL is
 //damage with no bearing - drowning, falling, a trigger_hurt - and leaves the
 //wedges alone rather than aiming them at the world origin
	F64  absorbed;
	F64  to_armor;
	F64  health_prev;
	Bool fmajor;
	Bool fcritical;

	if (damage <= 0.0 || hl_ent_player_dead)
		return;

	//FL_GODMODE: CBaseEntity::TakeDamage returns before the armour ratio, so
	//the suit charge is not spent either.
	if (hl_ent_godmode)
		return;

	//"armor doesn't protect against fall or drown damage!"
	if (hl_ent_player_armor > 0.0 &&
		!(damage_type & (HLDMG_FALL | HLDMG_DROWN)))
	{
		absorbed = damage * 0.8;
		to_armor = absorbed * 0.5;

		if (to_armor > hl_ent_player_armor)
		{
			//the charge runs out partway through, so only part is soaked
			to_armor = hl_ent_player_armor;
			absorbed = to_armor * 2.0;
		}

		hl_ent_player_armor -= to_armor;
		damage -= absorbed;
	}

	//CHudHealth::MsgFunc_Damage's vecFrom
	HLHudDamageSource(source);

	//the damage that actually reached the player, after the suit, with the mask
	//that carried it. Read by the death trace in HL1.ZC
	hl_ent_last_dmg      = damage;
	hl_ent_last_dmg_type = damage_type;

	health_prev = hl_ent_player_health;

	hl_ent_player_damage += damage;
	hl_ent_player_health -= damage;

	if (hl_ent_player_health <= 0.0)
	{
		//NOT clamped to zero before the gib test: Killed compares the health
		//against -40, so how far past zero the hit went is the whole question
		HLEntPlayerKilled(damage_type);
		hl_ent_player_health = 0.0;
		return;
	}

	//--- HEV voice ---
	//
	//CBasePlayer::TakeDamage's bitsDamage cascade, dlls/player.cpp:551-680. The
	//SDK loops so that one hit carrying several bits raises one line per bit;
	//the tests below are flat for the same reason - the bits are disjoint in
	//everything this tree raises.
	//
	//ftrivial (damage under 20 with no armour change) is not reproduced: it
	//gates only the loop, and every line below is already gated by fmajor.
	fmajor    = ToBool(damage > 25.0);
	fcritical = ToBool(hl_ent_player_health < 30.0);

	if (damage_type & HLDMG_CLUB)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG4", 30.0);		//minor fracture
	}

	if (damage_type & (HLDMG_FALL | HLDMG_CRUSH))
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG5", 30.0);		//major fracture
		else
			HLEntSuitUpdate("!HEV_DMG4", 30.0);
	}

	//"if (m_lastDamageAmount > 5)" - blood loss, not every graze
	if (damage_type & HLDMG_BULLET)
	{
		if (damage > 5.0)
			HLEntSuitUpdate("!HEV_DMG6", 30.0);		//blood loss detected
	}

	if (damage_type & HLDMG_SLASH)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG1", 30.0);		//major laceration
		else
			HLEntSuitUpdate("!HEV_DMG0", 30.0);		//minor laceration
	}

	if (damage_type & HLDMG_SONIC)
	{
		if (fmajor)
			HLEntSuitUpdate("!HEV_DMG2", 60.0);		//internal bleeding
	}

	if (damage_type & (HLDMG_POISON | HLDMG_PARALYZE))
		HLEntSuitUpdate("!HEV_DMG3", 60.0);			//blood toxins detected

	if (damage_type & HLDMG_ACID)
		HLEntSuitUpdate("!HEV_DET1", 60.0);			//hazardous chemicals

	if (damage_type & HLDMG_NERVEGAS)
		HLEntSuitUpdate("!HEV_DET0", 60.0);			//biohazard detected

	if (damage_type & HLDMG_RADIATION)
		HLEntSuitUpdate("!HEV_DET2", 60.0);			//radiation detected

	//"first time we take major damage"
	if (fmajor && health_prev >= 75.0)
	{
		HLEntSuitUpdate("!HEV_MED1", 1800.0);		//automedic on
		HLEntSuitUpdate("!HEV_HEAL7", 1800.0);		//morphine shot
	}

	//"already took major damage, now it's critical"
	if (fcritical && health_prev < 75.0)
	{
		if (hl_ent_player_health < 6.0)
			HLEntSuitUpdate("!HEV_HLTH3", 600.0);	//near death
		else if (hl_ent_player_health < 20.0)
			HLEntSuitUpdate("!HEV_HLTH2", 600.0);	//health critical

		if (!HLPartRandI(4) && health_prev < 50.0)
			HLEntSuitUpdate("!HEV_DMG7", 300.0);	//seek medical attention
	}

	//"no pain sound during death animation" - CBaseMonster::TakeDamage plays it
	//only while deadflag is DEAD_NO
	HLEntPlayerPainSound;
}

U0 HLEntPlayerRespawn()
{//CBasePlayer::Spawn's half of respawn(): the state reset. The move to the
 //spawn spot is GetPlayerSpawnSpot's, and is posted for the shell
	F64 org[3];
	F64 ang[3];

	hl_ent_player_health = HLENT_MAX_HEALTH;
	hl_ent_player_armor  = 0.0;
	hl_ent_player_dead   = FALSE;
	hl_ent_deadflag      = HLDEAD_NO;
	hl_ent_player_gibbed = FALSE;
	hl_ent_death_time    = 0.0;
	hl_ent_dead_time     = 0.0;

	//view_ofs back to VEC_VIEW, which is the shell's normal eye height
	hl_ent_death_view_ofs = HLPHYS_VIEW_Z;
	hl_ent_death_roll     = 0.0;
	hl_ent_input_locked   = FALSE;

	//a pending screen effect from the death - a fade, a shake - is not carried
	//into the new life
	hl_ent_shake_pending = FALSE;
	hl_ent_fade_pending  = FALSE;

	if (HLEntFindPlayerStart(org, ang))
	{
		HLVecCopy(org, hl_ent_respawn_org);
		HLVecCopy(ang, hl_ent_respawn_ang);
		hl_ent_respawn_pending = TRUE;
	}

	//no info_player_start: the health is restored where the body lies, which is
	//what respawn() falls back to when GetPlayerSpawnSpot finds nothing
}

U0 HLEntPlayerDeathThink()
{//CBasePlayer::PlayerDeathThink, run from HLEntFrame rather than off a think
 //field: the player is not an entity slot
 //
 //Weapon dropping (PackDeadPlayerItems) and the multiplayer body queue are not
 //here: single player, and HLWeapon.ZC compiles after this file
	F64 elapsed;
	F64 frac;

	if (!hl_ent_player_dead)
		return;

	elapsed = hl_ent_time - hl_ent_death_time;

	if (hl_ent_deadflag == HLDEAD_DYING)
	{
		//StudioFrameAdvance and the m_flRespawnTimer < 4.0 wait. There is no
		//player model to animate, so the window is spent dropping the view from
		//standing height to PM_DEAD_VIEWHEIGHT and rolling it over, which is
		//what the animation looks like from the inside
		frac = elapsed / HLENT_DEATH_ANIM_TIME;

		if (frac > 1.0)
			frac = 1.0;

		hl_ent_death_view_ofs = HLPHYS_VIEW_Z +
			(HLENT_DEAD_VIEWHEIGHT - HLPHYS_VIEW_Z) * frac;
		hl_ent_death_roll     = HLENT_DEAD_VIEW_ROLL * frac;

		if (elapsed < HLENT_DEATH_ANIM_TIME)
			return;

		//"once we're done animating our death and we're on the ground"
		hl_ent_deadflag  = HLDEAD_DEAD;
		hl_ent_dead_time = hl_ent_time;
		return;
	}

	if (hl_ent_deadflag == HLDEAD_DEAD)
	{
		//"wait for all buttons released". A key still held from the death frame
		//must not count as the respawn press
		if (hl_ent_death_button)
			return;

		if (hl_ent_time < hl_ent_dead_time + HLENT_RESPAWN_DELAY)
			return;

		//FPlayerCanRespawn is always true in single player
		hl_ent_dead_time = hl_ent_time;
		hl_ent_deadflag  = HLDEAD_RESPAWNABLE;
		return;
	}

	//HLDEAD_RESPAWNABLE: "wait for any button down". forcerespawn is
	//multiplayer only, so there is no timeout on this side - the player waits on
	//their corpse until they press something
	if (!hl_ent_death_button)
		return;

	HLEntPlayerRespawn;
}

//--- helpers ----------------------------------------------------------------

Bool HLEntValid(I64 i)
{
	if (i < 0 || i >= hl_num_entities || !hl_entities)
		return FALSE;

	return hl_entities[i].in_use;
}

CHLEntity *HLEntGet(I64 i)
{
	if (!HLEntValid(i))
		return NULL;

	return &hl_entities[i];
}

I64 HLEntFindByTargetname(U8 *name, I64 start)
{//next entity whose targetname matches, -1 when the chain ends
	I64 i;

	if (!name || !name[0])
		return -1;

	for (i = start; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qefb_next;

		if (!StrICompare(hl_entities[i].targetname, name))
			return i;

qefb_next:
	}

	return -1;
}

U0 HLEntSetAbsBox(CHLEntity *e)
{//SV_LinkEdict's bounds, rebuilt after anything moves
	F64 radius = 0.0;
	F64 v;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] + e->mins[i] - 1.0;
		e->absmax[i] = e->origin[i] + e->maxs[i] + 1.0;
		e->size[i]   = e->maxs[i] - e->mins[i];
	}

	if (!e->rotates)
		return;

	//SV_LinkEdict's rotating-solid case: the axial box is wrong at every angle
	//but 0/90/180/270, so it is replaced by the sphere that contains the box at
	//any orientation.
	//
	//Broad phase only - the hull trace is exact, because HLTraceHullRotated
	//works in the brush's own frame. Without the sphere a door turned 45 degrees
	//has corners outside its own bounds and the rider test misses the player.
	//
	//the absolute value is open coded: HLEntAbsF is defined further down this
	//file and a single-pass compiler cannot see it from here
	for (i = 0; i < 3; i++)
	{
		v = e->mins[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;

		v = e->maxs[i];
		if (v < 0.0)
			v = -v;
		if (v > radius)
			radius = v;
	}

	for (i = 0; i < 3; i++)
	{
		e->absmin[i] = e->origin[i] - radius - 1.0;
		e->absmax[i] = e->origin[i] + radius + 1.0;
	}
}

U0 HLEntSetBrushSize(CHLMap *map, CHLEntity *e)
{//a brush entity's box comes from its BSP submodel, not from key/values
	CHLModel *bm;

	if (e->brush_model < 1 || !map || e->brush_model >= map->num_models)
		return;

	bm = &map->models[e->brush_model];

	HLVecCopy(bm->mins, e->mins);
	HLVecCopy(bm->maxs, e->maxs);

	HLEntSetAbsBox(e);
}

U0 HLEntSetMoveDir(CHLEntity *e)
{//SetMovedir - the "angle" key doubles as a movement axis for brush movers.
 //yaw -1 is straight up, yaw -2 straight down
	F64 yaw = e->angles[1];

	if (yaw == -1.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
		e->angles[1] = 0.0;
		return;
	}

	if (yaw == -2.0)
	{
		HLVecSet(e->move_dir, 0.0, 0.0, -1.0);
		e->angles[1] = 0.0;
		return;
	}

	HLVecSet(e->move_dir, Cos(yaw * HLDEG2RAD), Sin(yaw * HLDEG2RAD), 0.0);
	e->angles[1] = 0.0;
}

//TRUE when the last trace's earliest impact was the player's own box. The
//player is not in hl_entities, so hl_trace_native_ent cannot name it
Bool hl_ent_clip_hit_player = FALSE;

U0 HLEntClipToSlideboxes(CHLMap *map, F64 *start, F64 *end, F64 *mins,
	F64 *maxs, CHLTrace *trace)
{//SV_ClipToLinks for the box solids: monsters, and the player
 //
 //installed into hl_ent_slidebox_hook, so HLTraceEntity in HLClip.ZC runs it
 //after the world and brush passes. HLClip.ZC compiles first and cannot name
 //this function.
 //
 //SV_ClipMoveToEntity takes the non-BSP branch for a box solid: the entity's
 //own mins/maxs at its origin, swept by HLClipMoveToBox, which grows the
 //stationary box by the mover and reduces the sweep to a point. absmin/absmax
 //are not used - those carry SV_LinkEdict's one unit of broad phase slop.
 //
 //start_solid is deliberately not propagated. Two monsters that spawn or get
 //pushed into one another would otherwise refuse every move in every
 //direction; letting the pair separate is what HLClipMoveToBox's own note
 //describes for the world case.
	CHLTrace	 tr;
	CHLEntity	*e;
	F64			 emins[3];
	F64			 emaxs[3];
	F64			 smins[3];
	F64			 smaxs[3];
	F64			 v;
	I64			 i;
	I64			 j;

	//this pass runs last, so a stale flag from the previous trace would survive
	//a move that ended on a wall
	hl_ent_clip_hit_player = FALSE;

	if (!hl_entities)
		return;

	//SV_Move's trace box, the broad phase both loops below reject against.
	//SV_ClipToLinks gets its candidates from the area tree; a linear pass over
	//the whole table has to do the box test itself, and every move, every line
	//of sight and every bullet in the frame comes through here
	for (j = 0; j < 3; j++)
	{
		smins[j] = start[j] + mins[j];
		smaxs[j] = start[j] + maxs[j];

		v = end[j] + mins[j];
		if (v < smins[j])
			smins[j] = v;

		v = end[j] + maxs[j];
		if (v > smaxs[j])
			smaxs[j] = v;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || i == hl_ent_clip_ignore)
			goto qecs_next;

		//SOLID_NOT and SOLID_TRIGGER are not obstacles, SOLID_BSP was clipped
		//by the brush pass, and a corpse has had its solid cleared
		if (e->solid != HLSOLID_SLIDEBOX && e->solid != HLSOLID_BBOX)
			goto qecs_next;

		//broad phase. absmin/absmax are maintained by HLEntSetAbsBox and
		//already carry SV_LinkEdict's unit of slop, so a box that misses the
		//sweep here cannot narrow it below
		if (e->absmin[0] > smaxs[0] || e->absmax[0] < smins[0] ||
			e->absmin[1] > smaxs[1] || e->absmax[1] < smins[1] ||
			e->absmin[2] > smaxs[2] || e->absmax[2] < smins[2])
			goto qecs_next;

		//a zero-sized box is a point entity that never had a hull set
		if (e->size[0] <= 0.0 || e->size[1] <= 0.0 || e->size[2] <= 0.0)
			goto qecs_next;

		for (j = 0; j < 3; j++)
		{
			emins[j] = e->origin[j] + e->mins[j];
			emaxs[j] = e->origin[j] + e->maxs[j];
		}

		HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

		if (tr.fraction < trace->fraction)
		{
			trace->fraction = tr.fraction;
			trace->hit      = tr.hit;
			HLVecCopy(tr.end_pos, trace->end_pos);
			HLVecCopy(tr.plane_normal, trace->plane_normal);

			hl_trace_native_ent    = i;
			hl_ent_clip_hit_player = FALSE;
		}

qecs_next:
	}

	//the player, which lives in globals rather than in the entity table. Only
	//a monster's own move clips against it: hl_ent_clip_ignore of -1 means the
	//player is the mover, and a hitscan wants to pass through the man holding
	//the gun as well
	if (hl_ent_clip_ignore < 0 || hl_ent_player_health <= 0.0)
		return;

	for (j = 0; j < 3; j++)
	{
		emins[j] = hl_ent_player_org[j] + hl_player_mins[j];
		emaxs[j] = hl_ent_player_org[j] + hl_player_maxs[j];
	}

	//the same broad phase, on the one box that is not in the table
	for (j = 0; j < 3; j++)
	{
		if (emins[j] - 1.0 > smaxs[j] || emaxs[j] + 1.0 < smins[j])
			return;
	}

	HLClipMoveToBox(emins, emaxs, mins, maxs, start, end, &tr);

	if (tr.fraction < trace->fraction)
	{
		trace->fraction = tr.fraction;
		trace->hit      = tr.hit;
		HLVecCopy(tr.end_pos, trace->end_pos);
		HLVecCopy(tr.plane_normal, trace->plane_normal);

		hl_trace_native_ent    = -1;
		hl_ent_clip_hit_player = TRUE;
	}
}

//a declaration initialiser on a global does not run
hl_ent_clip_hit_player = FALSE;
hl_ent_slidebox_hook   = &HLEntClipToSlideboxes;

Bool HLEntTraceDecalSurface(CHLTrace *tr)
{//EV_HLDM_DecalGunshot, cl_dll/ev_hldm.cpp:298, and DecalGunshot,
 //dlls/weapons.cpp:167: a mark goes down only where solid is SOLID_BSP.
 //
 //HLEntClipToSlideboxes narrows a trace against SOLID_SLIDEBOX and SOLID_BBOX
 //entities, so a shot that hits a monster ends on a bounding box face in open
 //air. A decal there stays when the monster moves.
 //
 //Reads the state the last trace left, so it is called before any further
 //trace - HLDmgHurt and HLWeaponTextureAt both overwrite it.
 //
 //MOVETYPE_PUSHSTEP, which EV_HLDM_GunshotDecalTrace also accepts
 //(ev_hldm.cpp:281), belongs to pushable brushes and is not a native movetype
 //here.
	I64 hit;

	if (hl_ent_clip_hit_player)
		return FALSE;

	hit = hl_trace_native_ent;

	if (hit >= 0)
	{
		if (!hl_entities || hit >= hl_num_entities)
			return FALSE;

		return ToBool(hl_entities[hit].solid == HLSOLID_BSP);
	}

	//No native entity won the trace, so it ended on world geometry, which
	//takes decals.
	no_warn tr;

	return TRUE;
}

F64 HLEntAbsF(F64 v)
{
	if (v < 0.0)
		return -v;

	return v;
}

//--- rotation axes ----------------------------------------------------------
//
// CBaseToggle::AxisDir. A rotating brush stores its axis in move_dir. The two
// spawnflag bits that pick it differ per class - a door and a fan disagree - so
// the caller passes the pair in.
//
// The SDK names ("Z axis", "X axis") are the index into angles, not a world
// axis. angles is (pitch, yaw, roll):
//
//   default   (0,1,0)   yaw   - turns about world Z, an ordinary swinging door
//   "Z axis"  (0,0,1)   roll  - turns about world X
//   "X axis"  (1,0,0)   pitch - turns about world Y
//
// Substituting real world axes swings doors through the floor; reproduced as
// written.
U0 HLEntAxisDir(CHLEntity *e, I64 flag_roll, I64 flag_pitch)
{
	if (e->spawnflags & flag_roll)
		HLVecSet(e->move_dir, 0.0, 0.0, 1.0);
	else if (e->spawnflags & flag_pitch)
		HLVecSet(e->move_dir, 1.0, 0.0, 0.0);
	else
		HLVecSet(e->move_dir, 0.0, 1.0, 0.0);
}

F64 HLEntAxisDelta(CHLEntity *e, F64 *a, F64 *b)
{//CBaseToggle::AxisDelta - travel between two angle triples along the single
 //axis this entity turns about. All three would count the two static axes and
 //read a 359->1 wrap as 358 degrees
	if (e->move_dir[2] != 0.0)
		return a[2] - b[2];

	if (e->move_dir[0] != 0.0)
		return a[0] - b[0];

	return a[1] - b[1];
}

//--- sounds -----------------------------------------------------------------
//
// Brush entities carry a small integer, not a sound path; the game code maps it
// to a filename.
//
// Comparison chains rather than tables, for the reason given in
// HLEntModelForClass - adjacent-literal concatenation truncates at the first
// embedded NUL and the table collapses to one entry.

U8 *HLEntDoorMoveSound(I64 n)
{//CBaseDoor::m_bMoveSnd
	if (n == 1)		return "doors/doormove1.wav";
	if (n == 2)		return "doors/doormove2.wav";
	if (n == 3)		return "doors/doormove3.wav";
	if (n == 4)		return "doors/doormove4.wav";
	if (n == 5)		return "doors/doormove5.wav";
	if (n == 6)		return "doors/doormove6.wav";
	if (n == 7)		return "doors/doormove7.wav";
	if (n == 8)		return "doors/doormove8.wav";
	if (n == 9)		return "doors/doormove9.wav";
	if (n == 10)	return "doors/doormove10.wav";

	return NULL;	//0 is common/null.wav - deliberate silence
}

U8 *HLEntDoorStopSound(I64 n)
{//CBaseDoor::m_bStopSnd
	if (n == 1)		return "doors/doorstop1.wav";
	if (n == 2)		return "doors/doorstop2.wav";
	if (n == 3)		return "doors/doorstop3.wav";
	if (n == 4)		return "doors/doorstop4.wav";
	if (n == 5)		return "doors/doorstop5.wav";
	if (n == 6)		return "doors/doorstop6.wav";
	if (n == 7)		return "doors/doorstop7.wav";
	if (n == 8)		return "doors/doorstop8.wav";

	return NULL;
}

U8 *HLEntTrainSound(I64 n)
{//CFuncTrackTrain::m_sounds. the looping running noise, restarted while the
 //train moves and stopped when it parks
	if (n == 1)		return "plats/ttrain1.wav";
	if (n == 2)		return "plats/ttrain2.wav";
	if (n == 3)		return "plats/ttrain3.wav";
	if (n == 4)		return "plats/ttrain4.wav";
	if (n == 5)		return "plats/ttrain6.wav";
	if (n == 6)		return "plats/ttrain7.wav";

	return NULL;
}

U8 *HLEntButtonSound(I64 n)
{//ButtonSound. the full table runs to 40; these are the entries HL1's own maps
 //reference
	if (n == 1)		return "buttons/button1.wav";
	if (n == 2)		return "buttons/button2.wav";
	if (n == 3)		return "buttons/button3.wav";
	if (n == 4)		return "buttons/button4.wav";
	if (n == 5)		return "buttons/button5.wav";
	if (n == 6)		return "buttons/button6.wav";
	if (n == 7)		return "buttons/button7.wav";
	if (n == 8)		return "buttons/button8.wav";
	if (n == 9)		return "buttons/button9.wav";
	if (n == 10)	return "buttons/button10.wav";
	if (n == 11)	return "buttons/button11.wav";
	if (n == 12)	return "buttons/latchlocked1.wav";
	if (n == 13)	return "buttons/latchunlocked1.wav";
	if (n == 14)	return "buttons/lightswitch2.wav";
	if (n == 21)	return "buttons/lever1.wav";
	if (n == 22)	return "buttons/lever2.wav";
	if (n == 23)	return "buttons/lever3.wav";
	if (n == 24)	return "buttons/lever4.wav";
	if (n == 25)	return "buttons/lever5.wav";

	return NULL;
}

U0 HLEntSound(I64 self, CHLEntity *e, U8 *path, I64 channel,
	F64 volume = -1.0)
{//at the entity's own centre, so a door is heard where it is.
 //
 //entnum is index+1, the convention HLEntSoundDyn and HLAI.ZC's speech use.
 //Replacement is per (entnum, entchannel), so entnum 0 puts every door,
 //button and charger in the map on one key and each cuts the last.
 //
 //volume -1 takes the entity's own "volume" key, which CBasePlatTrain::KeyValue
 //(plats.cpp:93) reads as a 0..1 fraction and every other class leaves at 1.
	F64 centre[3];
	I64 i;

	if (!path || !path[0])
		return;

	if (volume < 0.0)
		volume = e->volume;

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	HLSndPlayAt(path, centre, volume, HLENT_SND_ATTEN, self + 1, channel);
}

//--- scheduling -------------------------------------------------------------

U0 HLEntSetThink(CHLEntity *e, I64 method, F64 at)
{//absolute time, matching pev->nextthink. 0 disarms
	e->think_fn   = method;
	e->next_think = at;
}

U0 HLEntCalcMove(CHLEntity *e, F64 *dest, F64 speed, I64 done_method)
{//SUB_CalcMove - constant velocity that arrives exactly on a think
 //
 //the arrival is scheduled, not detected: floating point never lands on the
 //destination exactly, and a "close enough" test drifts over a level's worth of
 //door cycles
	F64 delta[3];
	F64 length;
	F64 travel;

	HLVecCopy(dest, e->finaldest);
	e->move_done = done_method;

	if (speed <= 0.0)
		speed = 100.0;

	HLVecSub(dest, e->origin, delta);
	length = HLVecLength(delta);

	if (length < 0.0001)
	{
		//already there - still take the think, so the arrival handler runs
		//exactly once either way
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);
		HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + HLENT_MIN_MOVE_TIME);
		return;
	}

	travel = length / speed;
	if (travel < HLENT_MIN_MOVE_TIME)
		travel = HLENT_MIN_MOVE_TIME;

	e->velocity[0] = delta[0] / travel;
	e->velocity[1] = delta[1] / travel;
	e->velocity[2] = delta[2] / travel;

	e->moving_angular = FALSE;

	HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + travel);
}

U0 HLEntCalcAngleMove(CHLEntity *e, F64 *dest, F64 speed, I64 done_method)
{//CBaseToggle::AngularMove - SUB_CalcMove's twin, in degrees
 //
 //shares HLM_MOVE_DONE with the linear path; moving_angular tells the arrival
 //which of the two it is finishing, so an angular arrival does not snap the
 //origin to a stale linear finaldest
	F64 delta[3];
	F64 length;
	F64 travel;

	HLVecCopy(dest, e->finalangle);
	e->move_done      = done_method;
	e->moving_angular = TRUE;

	if (speed <= 0.0)
		speed = 100.0;

	HLVecSub(dest, e->angles, delta);
	length = HLVecLength(delta);

	if (length < 0.0001)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + HLENT_MIN_MOVE_TIME);
		return;
	}

	travel = length / speed;
	if (travel < HLENT_MIN_MOVE_TIME)
		travel = HLENT_MIN_MOVE_TIME;

	e->avelocity[0] = delta[0] / travel;
	e->avelocity[1] = delta[1] / travel;
	e->avelocity[2] = delta[2] / travel;

	HLEntSetThink(e, HLM_MOVE_DONE, hl_ent_time + travel);
}

//--- master / multisource ---------------------------------------------------

Bool HLEntMasterAllows(CHLEntity *e)
{//UTIL_IsMasterTriggered. a locked door names a multisource; until every
 //input to that source is on, the door refuses to be used
	I64 m;

	if (!e->master[0])
		return TRUE;

	m = HLEntFindByTargetname(e->master, 0);
	if (m < 0)
		return TRUE;

	//CMultiSource::IsTriggered also gates on its global state: a cross-level
	//lock is satisfied by its inputs and by a flag set on an earlier map. Only
	//checked when the key is present
	if (hl_entities[m].global_state[0])
	{
		if (HLEntGlobalGet(hl_entities[m].global_state) != HLGLOBAL_ON)
			return FALSE;
	}

	//multisource state is kept in toggle_state: AT_TOP means satisfied
	return ToBool(hl_entities[m].toggle_state == HLTS_AT_TOP);
}

//--- locked / unlocked cues -------------------------------------------------
//
// PlayLockSounds, doors.cpp:106, shared by doors and buttons. Four keys, all
// indices into tables baked into the game code: the two sounds index
// ButtonSound, the two sentences index the group tables below.

//DOOR_SENTENCEWAIT, DOOR_SOUNDWAIT, BUTTON_SOUNDWAIT, doors.cpp:97-99
#define HLENT_LOCK_SENTWAIT	6.0
#define HLENT_LOCK_SNDWAIT	3.0
#define HLENT_LOCK_BTNWAIT	0.5

U8 *HLEntLockedSentence(I64 n)
{//CBaseDoor::Precache, doors.cpp:453-467. CBaseButton::Precache, buttons.cpp:324,
 //carries the same nine
	if (n == 1)	return "NA";		//access denied
	if (n == 2)	return "ND";		//security lockout
	if (n == 3)	return "NF";		//blast door
	if (n == 4)	return "NFIRE";		//fire door
	if (n == 5)	return "NCHEM";		//chemical door
	if (n == 6)	return "NRAD";		//radiation door
	if (n == 7)	return "NCON";		//gen containment
	if (n == 8)	return "NH";		//maintenance door
	if (n == 9)	return "NG";		//broken door

	return NULL;
}

U8 *HLEntUnlockedSentence(I64 n)
{//CBaseDoor::Precache, doors.cpp:469-481. Eight entries, one fewer than the
 //locked table: there is no unlocked twin of "broken door"
	if (n == 1)	return "EA";		//access granted
	if (n == 2)	return "ED";		//security door
	if (n == 3)	return "EF";		//blast door
	if (n == 4)	return "EFIRE";		//fire door
	if (n == 5)	return "ECHEM";		//chemical door
	if (n == 6)	return "ERAD";		//radiation door
	if (n == 7)	return "ECON";		//gen containment
	if (n == 8)	return "EH";		//maintenance door

	return NULL;
}

U0 HLEntPlayLockSounds(I64 self, CHLEntity *e, Bool locked, Bool button)
{//PlayLockSounds, doors.cpp:106
	U8	*path;
	U8	*group;
	U8	 name[48];
	F64	 centre[3];
	F64	 soundwait;
	F64	 vol;
	I64	 grp;
	I64	 prev;
	I64	 ord;
	I64	 count;
	I64	 i;
	Bool play_snd;
	Bool play_sent;
	Bool eof;

	if (!e)
		return;

	if (button)
		soundwait = HLENT_LOCK_BTNWAIT;
	else
		soundwait = HLENT_LOCK_SNDWAIT;

	if (locked)
	{
		path  = HLEntButtonSound(e->locked_snd);
		group = HLEntLockedSentence(e->locked_sentence);
		prev  = e->lock_sent_ord;
		eof   = e->lock_sent_eof;
	}
	else
	{
		path  = HLEntButtonSound(e->unlocked_snd);
		group = HLEntUnlockedSentence(e->unlocked_sentence);
		prev  = e->unlock_sent_ord;
		eof   = e->unlock_sent_eof;
	}

	play_snd  = FALSE;
	play_sent = FALSE;

	if (path && hl_ent_time > e->lock_wait_snd)
		play_snd = TRUE;

	if (group && !eof && hl_ent_time > e->lock_wait_sent)
		play_sent = TRUE;

	if (!play_snd && !play_sent)
		return;

	//"if playing both sentence and sound, lower sound volume so we hear
	//sentence", doors.cpp:163
	if (play_snd && play_sent)
		vol = 0.25;
	else
		vol = 1.0;

	if (play_snd)
	{
		//CHAN_ITEM, doors.cpp:134. Not the entity's "volume" key: the cue is a
		//refusal, played at the volume PlayLockSounds picked
		HLEntSound(self, e, path, HLCHAN_ITEM, vol);
		e->lock_wait_snd = hl_ent_time + soundwait;
	}

	if (!play_sent)
		return;

	grp = HLSndSentenceGroupIndex(group);

	if (grp < 0)
		return;

	count = hl_snd_sentg[grp].count;

	if (count < 1)
		return;

	//USENTENCEG_PickSequential with freset FALSE, sound.cpp:1048. The clamp
	//makes the last member repeat and the cursor still advance, which is what
	//raises the EOF flag below and stops the line
	ord = prev;

	if (ord >= count)
		ord = count - 1;

	StrPrint(name, "!%s%d", hl_snd_sentg[grp].name, ord);

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	//0.85, ATTN_NORM, doors.cpp:144
	HLSndSentenceQueue(name, centre, 0.85, HLENT_SND_ATTEN, HLPITCH_NORM,
		self + 1, HLCHAN_VOICE);

	//"make sure we don't keep calling last sentence in list", doors.cpp:149.
	//The two cursors are exclusive: playing one resets the other
	if (locked)
	{
		e->lock_sent_eof   = ToBool(prev == ord + 1);
		e->lock_sent_ord   = ord + 1;
		e->unlock_sent_ord = 0;
	}
	else
	{
		e->unlock_sent_eof = ToBool(prev == ord + 1);
		e->unlock_sent_ord = ord + 1;
		e->lock_sent_ord   = 0;
	}

	e->lock_wait_sent = hl_ent_time + HLENT_LOCK_SENTWAIT;
}

//--- the call queue ---------------------------------------------------------
//
// HLEntCallMethod is defined at the bottom, after every implementation it
// dispatches, so code above it cannot call it. A forward declaration is not an
// option: see the note at the top of HLPhys.ZC - routing a call through one
// miscompiles.
//
// Callers above queue the method instead, and the frame driver drains the queue.
// This also bounds a target loop: two multi_managers naming each other would
// otherwise recurse until the stack ran out.

#define HLENT_CALLQ_MAX		256
#define HLENT_CALLQ_BUDGET	4096	//dispatches allowed per drain

class CHLEntCall
{
	I64	ent;
	I64	method;
	I64	activator;
	I64	use_type;
	F64	value;

	//pCaller: the entity that fired, distinct from pActivator, the player or
	//monster that started the chain. Only CMultiSource::Use reads it - it
	//identifies which of its registered inputs just toggled
	I64	caller;
};

CHLEntCall	hl_ent_callq[HLENT_CALLQ_MAX];
I64			hl_ent_callq_head = 0;
I64			hl_ent_callq_tail = 0;
I64			hl_ent_callq_lost = 0;

//pCaller of the method HLEntDrainCalls is running, -1 for none. Carried beside
//the dispatch rather than through HLEntCallMethod's signature, which every
//spawn and think path already calls with five arguments.
I64			hl_ent_call_caller = -1;

U0 HLEntQueueCall(I64 ent, I64 method, I64 activator, I64 use_type, F64 value,
	I64 caller = -1)
{
	I64 next = (hl_ent_callq_tail + 1) % HLENT_CALLQ_MAX;

	if (method == HLM_NONE)
		return;

	if (next == hl_ent_callq_head)
	{
		//full - drop rather than overwrite an unread entry. reported a few
		//times so a runaway chain is visible
		if (hl_ent_callq_lost < 4)
			"HLEnt: call queue full, dropping method %d\n", method;

		hl_ent_callq_lost++;
		return;
	}

	hl_ent_callq[hl_ent_callq_tail].ent       = ent;
	hl_ent_callq[hl_ent_callq_tail].method    = method;
	hl_ent_callq[hl_ent_callq_tail].activator = activator;
	hl_ent_callq[hl_ent_callq_tail].use_type  = use_type;
	hl_ent_callq[hl_ent_callq_tail].value     = value;
	hl_ent_callq[hl_ent_callq_tail].caller    = caller;

	hl_ent_callq_tail = next;
}

U0 HLEntFireTargets(I64 self, I64 activator, I64 use_type, F64 value)
{//SUB_UseTargets - fire everything sharing this entity's target name, and
 //remove everything sharing its killtarget
	CHLEntity	*e = HLEntGet(self);
	I64			 t;

	if (!e)
		return;

	if (e->killtarget[0])
	{
		t = HLEntFindByTargetname(e->killtarget, 0);

		while (t >= 0)
		{
			hl_entities[t].in_use     = FALSE;
			hl_entities[t].solid      = HLSOLID_NOT;
			hl_entities[t].think_fn   = HLM_NONE;
			hl_entities[t].next_think = 0.0;

			t = HLEntFindByTargetname(e->killtarget, t + 1);
		}
	}

	if (!e->target[0])
		return;

	t = HLEntFindByTargetname(e->target, 0);

	while (t >= 0)
	{
		//an entity must not fire itself; the recursion never ends
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, use_type,
				value, self);
		}

		t = HLEntFindByTargetname(e->target, t + 1);
	}
}

U0 HLEntFireTargetsNamed(U8 *name, I64 self, I64 activator, I64 use_type,
	F64 value)
{//FireTargets: fire by name, with no firing entity's target field involved.
 //A path_track's pass-fire and a multi_manager's per-key fire both need this.
	I64 t;

	if (!name || !name[0])
		return;

	t = HLEntFindByTargetname(name, 0);

	while (t >= 0)
	{
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, use_type,
				value, self);
		}

		t = HLEntFindByTargetname(name, t + 1);
	}
}

U0 HLEntUseTargets(I64 self, I64 activator, I64 use_type = HLUSE_TOGGLE,
	F64 value = 0.0)
{//the delay key defers the fire. HL spawns a DelayedUse entity for this; here
 //the delay rides on the firing entity's own think, which is equivalent unless
 //something re-fires inside the window
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->delay > 0.0)
	{
		//a fire already pending keeps its own time. HL owns each deferred fire
		//on its own DelayedUse entity, so a second use inside the window is a
		//second fire; here the two share one think, and rescheduling would
		//push the first one out by another delay every time something used
		//this entity again
		if (e->think_fn == HLM_FIRE_TARGETS && e->next_think > hl_ent_time)
			return;

		e->activator = activator;
		HLEntSetThink(e, HLM_FIRE_TARGETS, hl_ent_time + e->delay);
		return;
	}

	HLEntFireTargets(self, activator, use_type, value);
}

//--- door groups ------------------------------------------------------------
//
// CBaseDoor::Blocked walks "all door pieces with the same targetname". That is
// the whole of GoldSrc's door linking: Quake's LinkDoors, which fused doors by
// touching brushes, is not in the HL SDK. A named pair already moves together
// through SUB_UseTargets, which fires every entity holding the name.
//
// So the group must not ride on use_fn. Both paths that reach a door through
// use_fn already reach every leaf: SUB_UseTargets by name, and HLEntTouchPlayer
// over every leaf the player's box overlaps. Fanning out from either activates
// an n leaf group n times each. A
// leaf with SF_DOOR_NO_AUTO_RETURN toggles direction per activation, so an
// even sized group ends where it started and never opens - c0a0b's four panel
// blast door, and 96 more groups across the shipped maps.
//
// HLEntUseInFront is the one path that fires a single entity and stops, and it
// queues HLM_DOOR_GROUP for that reason.
//
// An unnamed pair has no name to group on and falls back to the brush test,
// which is safe only between two unnamed doors. c0a0b rests a func_door named
// "doors" against a func_door_rotating named "lockdoor"; linking those would
// throw the lock open with the lift.
//
// The name branch of the group serves CBaseDoor::Blocked alone. The use paths
// ask for the brush branch only, which for a named leaf is empty - matching
// CBaseDoor::Use, which acts on one door.

#define HLDOOR_LINK_SLOP	1.0		//LinkDoors' tolerance

Bool HLEntIsDoor(CHLEntity *e)
{//func_door, func_water and func_door_rotating - the classes CBaseDoor::Blocked
 //accepts. momentary_door carries HLC_DOOR and func_plat carries the door
 //methods; neither is a leaf of anything, and the pair of tests excludes both
	if (!e)
		return FALSE;

	if (e->ent_class != HLC_DOOR)
		return FALSE;

	return ToBool(e->use_fn == HLM_DOOR_USE || e->use_fn == HLM_ROT_DOOR_USE);
}

Bool HLEntDoorsTouch(CHLEntity *a, CHLEntity *b)
{//LinkDoors' box test, over the bounds HLEntSetAbsBox already maintains
	I64 i;

	for (i = 0; i < 3; i++)
	{
		if (a->absmin[i] > b->absmax[i] + HLDOOR_LINK_SLOP)
			return FALSE;

		if (b->absmin[i] > a->absmax[i] + HLDOOR_LINK_SLOP)
			return FALSE;
	}

	return TRUE;
}

I64 HLDoorGroupNext(I64 self, I64 start, Bool by_name = TRUE)
{//next leaf of self's group, -1 when the group ends. by_name clear drops the
 //targetname branch, leaving the touching brush one: a named leaf then has no
 //group at all
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	I64			 i;

	if (!HLEntIsDoor(e))
		return -1;

	if (e->targetname[0] && !by_name)
		return -1;

	for (i = start; i < hl_num_entities; i++)
	{
		if (i == self)
			goto qdgn_next;

		o = HLEntGet(i);
		if (!HLEntIsDoor(o))
			goto qdgn_next;

		//a named door groups by name and by nothing else
		if (e->targetname[0])
		{
			if (!StrICompare(o->targetname, e->targetname))
				return i;

			goto qdgn_next;
		}

		if (!o->targetname[0] && HLEntDoorsTouch(e, o))
			return i;

qdgn_next:
	}

	return -1;
}

//--- runtime entity creation ------------------------------------------------
//
// CBaseEntity::Create, for the pickup classes only: item_*, weapon_* and ammo_*
// are what every drop path in the SDK asks for.
//
// The class branch that spawns one of these is in HLEntSpawnClass, far below in
// this file and out of reach of a single-pass compiler, so the item spawn is
// inlined here. HLMakerMakeMonster carries the monster twin for the same reason.

U8 *HLEntSpawnObjectClass(I64 n)
{//CBreakable::pSpawnObjects, func_break.cpp:37. The map carries the index, not
 //the name. 0 is NULL - the breakable drops nothing
	if (n == 1)		return "item_battery";
	if (n == 2)		return "item_healthkit";
	if (n == 3)		return "weapon_9mmhandgun";
	if (n == 4)		return "ammo_9mmclip";
	if (n == 5)		return "weapon_9mmAR";
	if (n == 6)		return "ammo_9mmAR";
	if (n == 7)		return "ammo_ARgrenades";
	if (n == 8)		return "weapon_shotgun";
	if (n == 9)		return "ammo_buckshot";
	if (n == 10)	return "weapon_crossbow";
	if (n == 11)	return "ammo_crossbow";
	if (n == 12)	return "weapon_357";
	if (n == 13)	return "ammo_357";
	if (n == 14)	return "weapon_rpg";
	if (n == 15)	return "ammo_rpgclip";
	if (n == 16)	return "ammo_gaussclip";
	if (n == 17)	return "weapon_handgrenade";
	if (n == 18)	return "weapon_tripmine";
	if (n == 19)	return "weapon_satchel";
	if (n == 20)	return "weapon_snark";
	if (n == 21)	return "weapon_hornetgun";

	return NULL;
}

I64 HLEntCreateNamed(U8 *classname, F64 *origin, F64 *angles, I64 owner)
{//the new entity's index, -1 when the table is full or the class is not one
 //this port can create at runtime
 //
 //a slot above the parsed count has never been written: HLEnt.ZC CAllocs the
 //whole HLENT_MAX table on every map load, so everything not set here is
 //already zero. Only the members whose resting value is not zero are listed
	CHLEntity	*c;
	U8			*path;
	I64			 i;

	if (!classname || !classname[0] || !hl_entities || !origin)
		return -1;

	if (StrNICompare(classname, "item_", 5) &&
		StrNICompare(classname, "weapon_", 7) &&
		StrNICompare(classname, "ammo_", 5))
		return -1;

	if (hl_num_entities >= HLENT_MAX)
		return -1;

	i = hl_num_entities;
	c = &hl_entities[i];

	HLStrCopy(c->classname, classname, 64);

	c->brush_model      = -1;
	c->owner            = owner;
	c->activator        = -1;
	c->beam_start       = -1;
	c->beam_end         = -1;
	c->light_style      = -1;
	c->light_valid      = FALSE;
	c->anim_event_frame = -1;
	c->anim_loop        = TRUE;
	c->framerate        = 10.0;
	c->scale            = 1.0;
	c->volume           = 1.0;
	c->modifier         = 100.0;
	c->blood_color      = 247;
	c->text_x           = -1.0;
	c->text_y           = -1.0;
	c->trigger_mode     = HLUSE_TOGGLE;
	c->toggle_state     = HLTS_AT_BOTTOM;

	HLVecCopy(origin, c->origin);

	if (angles)
		HLVecCopy(angles, c->angles);

	//CItem::Spawn, items.cpp:90. MOVETYPE_TOSS and DROP_TO_FLOOR are absent for
	//the reason given in HLEntSpawnItem: a dropped item hangs where it is made
	if (!StrNICompare(classname, "item_", 5))
	{
		c->movetype  = HLMOVETYPE_NONE;
		c->solid     = HLSOLID_TRIGGER;
		c->ent_class = HLC_ITEM;
		c->touch_fn  = HLM_ITEM_TOUCH;
	}
	else
	{
		//weapon_* and ammo_* stay non-solid and touchless: HLWeapon.ZC sweeps
		//the entity list itself every frame and rebuilds the pickup box from
		//the origin. Two pickup paths on one entity claim it twice
		c->movetype = HLMOVETYPE_NONE;
		c->solid    = HLSOLID_NOT;
	}

	//UTIL_SetSize(-16,-16,0)..(16,16,16)
	HLVecSet(c->mins, -16.0, -16.0, 0.0);
	HLVecSet(c->maxs, 16.0, 16.0, 16.0);
	HLEntSetAbsBox(c);

	//UTIL_PrecacheOther's model. A class with no entry draws nothing and is
	//still picked up
	path = HLEntModelForClass(classname);

	if (path)
	{
		c->studio = HLStudioCacheGet(path);

		if (c->studio)
			HLEntInitBoneControllers(c);
	}

	c->spawned = TRUE;
	c->in_use  = TRUE;

	//the count moves last: nothing that syncs on it may see a half-built slot
	hl_num_entities++;

	return i;
}

//--- trigger_camera ---------------------------------------------------------
//
// CTriggerCamera, dlls/triggers.cpp:2157. A point entity that takes the eye,
// swings to face a target and optionally flies a path_corner chain. c5a1's
// G-Man monologue is one of the two in the shipped game.
//
// MOVETYPE_NOCLIP is not a mover this port runs, so the think integrates its own
// velocity and avelocity. The think is scheduled every tick, which is what the
// SDK does too - nextthink = gpGlobals->time.

#define HLSF_CAMERA_PLAYER_POSITION		1
#define HLSF_CAMERA_PLAYER_TARGET		2
#define HLSF_CAMERA_PLAYER_TAKECONTROL	4

//SF_CORNER_FIREONCE, trains.h:34
#define HLSF_CORNER_FIREONCE			4

//cam_target for SF_CAMERA_PLAYER_TARGET. hl_ent_player is entity slot 0, which
//is worldspawn, so the player cannot be named by index
#define HLENT_CAM_TARGET_PLAYER		-2

F64 HLEntApproach(F64 target, F64 value, F64 speed)
{//UTIL_Approach, util.cpp
	F64 delta = target - value;

	if (delta > speed)
		return value + speed;

	if (delta < -speed)
		return value - speed;

	return target;
}

U0 HLCameraRelease(I64 self)
{//the view goes back to the player, triggers.cpp:2345-2355
	CHLEntity *e = HLEntGet(self);

	if (hl_ent_cam_ent == self)
	{
		hl_ent_cam_active = FALSE;
		hl_ent_cam_freeze = FALSE;
		hl_ent_cam_ent    = -1;
	}

	if (!e)
		return;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	//m_state, held in toggle_state: AT_TOP is running
	e->toggle_state = HLTS_AT_BOTTOM;
	HLEntSetThink(e, HLM_NONE, 0.0);
}

U0 HLCameraMove(I64 self)
{//CTriggerCamera::Move, triggers.cpp:2396
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*p;
	F64			 delta[3];
	F64			 frac;
	F64			 dt;
	I64			 next;
	I64			 i;

	if (!e || e->cam_path < 0)
		return;

	dt = hl_ent_frame_dt;

	e->cam_move_dist -= e->speed * dt;

	if (e->cam_move_dist <= 0.0)
	{
		p = HLEntGet(e->cam_path);

		//a corner's "message" is its passtarget, fired on arrival
		if (p && p->message[0])
		{
			HLEntFireTargetsNamed(p->message, self, self, HLUSE_TOGGLE, 0.0);

			if (p->spawnflags & HLSF_CORNER_FIREONCE)
				p->message[0] = 0;
		}

		next = -1;

		if (p && p->target[0])
			next = HLEntFindByTargetname(p->target, 0);

		p = NULL;

		if (next >= 0)
			p = HLEntGet(next);

		if (!p)
		{
			e->cam_path = -1;
			HLVecSet(e->velocity, 0.0, 0.0, 0.0);
		}
		else
		{
			e->cam_path = next;

			if (p->speed != 0.0)
				e->cam_target_speed = p->speed;

			HLVecSub(p->origin, e->origin, delta);
			e->cam_move_dist = HLVecLength(delta);
			HLVecNormalize(delta);
			HLVecCopy(delta, e->move_dir);
			e->cam_stop = hl_ent_time + p->delay;
		}
	}

	if (e->cam_stop > hl_ent_time)
		e->speed = HLEntApproach(0.0, e->speed, e->cam_decel * dt);
	else
		e->speed = HLEntApproach(e->cam_target_speed, e->speed,
			e->cam_accel * dt);

	//"fraction = 2 * frametime", triggers.cpp:2444 - a first order lag onto the
	//path direction, not a straight assignment
	frac = 2.0 * dt;

	for (i = 0; i < 3; i++)
		e->velocity[i] = e->move_dir[i] * e->speed * frac +
			e->velocity[i] * (1.0 - frac);
}

U0 HLCameraThink(I64 self)
{//CTriggerCamera::FollowTarget, triggers.cpp:2340
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*t;
	F64			 delta[3];
	F64			 goal[3];
	F64			 dx;
	F64			 dy;
	F64			 dt;
	I64			 i;

	if (!e)
		return;

	//the player dying releases the view in the SDK through IsAlive; here the
	//camera simply stops holding it
	if (e->cam_target == -1 || e->cam_return < hl_ent_time)
	{
		HLCameraRelease(self);
		return;
	}

	//HLENT_CAM_TARGET_PLAYER: hl_ent_player is entity slot 0 for the pusher
	//rider test, not a body with an origin, so the aim point is the stashed
	//player origin
	if (e->cam_target == HLENT_CAM_TARGET_PLAYER)
		HLVecCopy(hl_ent_player_org, goal);
	else
	{
		t = HLEntGet(e->cam_target);

		if (!t)
		{
			HLCameraRelease(self);
			return;
		}

		HLVecCopy(t->origin, goal);
	}

	dt = hl_ent_frame_dt;

	HLVecSub(goal, e->origin, delta);
	HLVecToAngles(delta, goal);
	goal[0] = -goal[0];

	if (e->angles[1] > 360.0)
		e->angles[1] -= 360.0;

	if (e->angles[1] < 0.0)
		e->angles[1] += 360.0;

	dx = goal[0] - e->angles[0];
	dy = goal[1] - e->angles[1];

	if (dx < -180.0)
		dx += 360.0;
	if (dx > 180.0)
		dx -= 360.0;

	if (dy < -180.0)
		dy += 360.0;
	if (dy > 180.0)
		dy -= 360.0;

	//40 per second toward the goal, triggers.cpp:2382
	e->avelocity[0] = dx * 40.0 * dt;
	e->avelocity[1] = dy * 40.0 * dt;

	if (!(e->spawnflags & HLSF_CAMERA_PLAYER_TAKECONTROL))
	{
		HLVecScale(e->velocity, 0.8, e->velocity);

		if (HLVecLength(e->velocity) < 10.0)
			HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	}

	HLCameraMove(self);

	//the engine's MOVETYPE_NOCLIP integration, which this port has no pass for
	for (i = 0; i < 3; i++)
	{
		e->origin[i] += e->velocity[i] * dt;
		e->angles[i] += e->avelocity[i];
	}

	HLVecCopy(e->origin, hl_ent_cam_org);
	HLVecCopy(e->angles, hl_ent_cam_ang);

	HLEntSetThink(e, HLM_CAMERA_THINK, hl_ent_time);
}

U0 HLCameraUse(I64 self, I64 activator, I64 use_type)
{//CTriggerCamera::Use, triggers.cpp:2251
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*p;
	Bool		 on;

	if (!e)
		return;

	on = ToBool(e->toggle_state == HLTS_AT_TOP);

	//ShouldToggle: an explicit ON or OFF matching the current state is a no-op
	if (use_type == HLUSE_ON && on)
		return;
	if (use_type == HLUSE_OFF && !on)
		return;

	if (on)
	{
		//"m_flReturnTime = gpGlobals->time" - the next think releases the view
		e->cam_return   = hl_ent_time;
		e->toggle_state = HLTS_AT_BOTTOM;
		return;
	}

	e->toggle_state = HLTS_AT_TOP;

	e->cam_return       = hl_ent_time + e->wait;
	e->speed            = e->cam_initial_speed;
	e->cam_target_speed = e->cam_initial_speed;

	if (e->spawnflags & HLSF_CAMERA_PLAYER_TARGET)
		e->cam_target = HLENT_CAM_TARGET_PLAYER;
	else if (e->target[0])
		e->cam_target = HLEntFindByTargetname(e->target, 0);
	else
		e->cam_target = -1;

	//"Nothing to look at!", triggers.cpp:2284 - the state stays on and the
	//camera never takes the view
	if (e->cam_target < 0)
		return;

	e->cam_path = -1;

	if (e->cam_moveto[0])
		e->cam_path = HLEntFindByTargetname(e->cam_moveto, 0);

	e->cam_stop = hl_ent_time;

	if (e->cam_path >= 0)
	{
		p = HLEntGet(e->cam_path);

		if (p)
		{
			if (p->speed != 0.0)
				e->cam_target_speed = p->speed;

			e->cam_stop += p->delay;
		}
	}

	if (e->spawnflags & HLSF_CAMERA_PLAYER_POSITION)
	{
		//origin + view_ofs, and the player's yaw with the pitch flipped
		HLVecCopy(hl_ent_player_org, e->origin);
		e->origin[2] += HLPHYS_VIEW_Z;

		e->angles[0] = -hl_ent_player_ang[0];
		e->angles[1] = hl_ent_player_ang[1];
		e->angles[2] = 0.0;
	}

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	//SET_VIEW, triggers.cpp:2327
	hl_ent_cam_ent    = self;
	hl_ent_cam_active = TRUE;
	hl_ent_cam_freeze = ToBool((e->spawnflags &
		HLSF_CAMERA_PLAYER_TAKECONTROL) != 0);

	HLVecCopy(e->origin, hl_ent_cam_org);
	HLVecCopy(e->angles, hl_ent_cam_ang);

	e->cam_move_dist = 0.0;

	HLCameraMove(self);

	HLEntSetThink(e, HLM_CAMERA_THINK, hl_ent_time);
}

//--- doors ------------------------------------------------------------------
//
// func_door. SF_DOOR_START_OPEN swaps the two positions at spawn rather than
// running the mover, so everything below still thinks it opens "up"

#define HLSF_DOOR_START_OPEN		1
#define HLSF_DOOR_PASSABLE		8
#define HLSF_DOOR_TOGGLE			32
#define HLSF_DOOR_USE_ONLY		256
#define HLSF_DOOR_TOUCH_OPENS	0		//the default when USE_ONLY is clear

//--- func_platrot -----------------------------------------------------------
//
// CFuncPlatRot turns as it travels. The turn is not a move of its own: the
// linear half schedules the arrival and the angular half is an avelocity held
// for exactly that span, plats.cpp:569 and :591.
//
// The port's plat runs on the door mover, and the two disagree on which end is
// which. CFuncPlat rests at m_vecPosition1 in TS_AT_TOP and descends to
// m_vecPosition2; HLEntSpawnPlat rests at position1 in HLTS_AT_BOTTOM and the
// door's "go up" carries it to position2. So the port's up is the SDK's down:
//
//   HLDoorGoUp   -> position2, physically down -> CFuncPlatRot::GoDown -> angle1
//   HLDoorGoDown -> position1, physically up   -> CFuncPlatRot::GoUp   -> angle2
//
// angle1 is m_start, angle2 is m_end. func_door_rotating owns the same pair,
// and no entity is both.

U0 HLPlatRotMove(CHLEntity *e, F64 *dest)
{//CFuncPlatRot::RotMove, plats.cpp:608. time is the span SUB_CalcMove just
 //scheduled for the linear half
 //
 //The SDK's short-travel branch also pushes nextthink out by a second. Not
 //reproduced: that think is the linear arrival here, and delaying it strands
 //the plat between its two positions. HLENT_MIN_MOVE_TIME already floors the
 //span, so the residual is applied over one tick instead
	F64 delta[3];
	F64 time;

	HLVecSub(dest, e->angles, delta);

	time = e->next_think - hl_ent_time;

	if (time >= 0.1)
		HLVecScale(delta, 1.0 / time, e->avelocity);
	else
		HLVecCopy(delta, e->avelocity);
}

U0 HLDoorTouchLatch(CHLEntity *e, Bool on)
{//"SetTouch(NULL); // Temporarily disable the touch function, until movement
 //is finished", doors.cpp:512, and the two restores at doors.cpp:630 and :695.
 //
 //HLEntTouchPlayer queues touch_fn once a tick for as long as the player box
 //overlaps, so without the latch a standing player re-enters DoorTouch every
 //tick. On a NO_AUTO_RETURN door that reverses the leaf each time and it never
 //finishes travelling.
 //
 //Keyed off use_fn, not ent_class: momentary_door is HLC_DOOR with no touch at
 //all and must not acquire one here
	if (!on)
	{
		e->touch_fn = HLM_NONE;
		return;
	}

	if (e->use_fn == HLM_ROT_DOOR_USE)
		e->touch_fn = HLM_ROT_DOOR_TOUCH;
	else if (e->use_fn == HLM_DOOR_USE)
		e->touch_fn = HLM_DOOR_TOUCH;
}

U0 HLDoorGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//already moving or open - a second use is dropped
	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_AT_TOP)
		return;

	e->toggle_state = HLTS_GOING_UP;
	e->activator    = activator;

	//CHAN_STATIC, doors.cpp:576
	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	HLEntCalcMove(e, e->position2, e->speed, HLM_DOOR_HIT_TOP);

	//after the linear call: the angular rate is the residual over the span it
	//scheduled
	if (e->ent_class == HLC_PLAT && e->rotates)
		HLPlatRotMove(e, e->angle1);
}

U0 HLDoorGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	//CHAN_STATIC, doors.cpp:576
	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	HLEntCalcMove(e, e->position1, e->speed, HLM_DOOR_HIT_BOTTOM);

	if (e->ent_class == HLC_PLAT && e->rotates)
		HLPlatRotMove(e, e->angle2);
}

U0 HLDoorHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	//CFuncPlatRot::HitBottom, plats.cpp:579 - the port's top is the SDK's
	//bottom, see the note above HLPlatRotMove. The angle is snapped, not
	//integrated to: the linear arrival is scheduled and the angular one would
	//otherwise land a tick either side of it
	if (e->ent_class == HLC_PLAT && e->rotates)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLVecCopy(e->angle1, e->angles);
		HLEntSetAbsBox(e);
	}

	//CHAN_STATIC, doors.cpp:619
	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);

	//SF_DOOR_TOGGLE and a negative wait both mean "stay open"
	if (e->spawnflags & HLSF_DOOR_TOGGLE)
	{
		//"Re-instate touch method, movement is complete", doors.cpp:630. Only
		//on this branch: an auto-return door regains its touch at the bottom
		if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
			HLDoorTouchLatch(e, TRUE);

		goto qdht_fire;
	}

	if (e->wait < 0.0)
		goto qdht_fire;

	HLEntSetThink(e, HLM_DOOR_GO_DOWN, hl_ent_time + e->wait);

qdht_fire:
	//the door's own target fires on open, not on close
	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);
}

U0 HLDoorHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;

	//CFuncPlatRot::HitTop, plats.cpp:599
	if (e->ent_class == HLC_PLAT && e->rotates)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLVecCopy(e->angle2, e->angles);
		HLEntSetAbsBox(e);
	}

	//"Re-instate touch method, cycle is complete", doors.cpp:695
	if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
		HLDoorTouchLatch(e, TRUE);

	//CHAN_STATIC, doors.cpp:619
	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);
}

Bool HLDoorUseLeaf(I64 self, I64 activator)
{//CBaseDoor::Use, doors.cpp:518, then CBaseDoor::DoorActivate, doors.cpp:530,
 //on one leaf with no group fan out. Returns DoorActivate's int: whether the
 //leaf acted, which is what latches the touch off at the call site
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return FALSE;

	//"if not ready to be used, ignore use command", doors.cpp:522. A leaf in
	//flight drops the call outright; only AT_BOTTOM, or AT_TOP on a
	//NO_AUTO_RETURN door, activates. Acting while GOING_UP or GOING_DOWN
	//reverses the leaf once per call, and the touch path calls once a tick
	if (e->toggle_state != HLTS_AT_BOTTOM &&
		!(e->toggle_state == HLTS_AT_TOP &&
		  (e->spawnflags & HLSF_DOOR_TOGGLE)))
		return FALSE;

	if (!HLEntMasterAllows(e))
		return FALSE;

	//"door should close", doors.cpp:537
	if (e->toggle_state == HLTS_AT_TOP)
	{
		HLDoorGoDown(self);
		return TRUE;
	}

	//"play door unlock sounds", doors.cpp:551, after the master gate and before
	//the move
	HLEntPlayLockSounds(self, e, FALSE, FALSE);

	HLDoorGoUp(self, activator);

	return TRUE;
}

U0 HLDoorUse(I64 self, I64 activator)
{//CBaseDoor::Use - one door. The callers that reach this through use_fn reach
 //every leaf themselves; see the note above HLDoorGroupNext
	HLDoorUseLeaf(self, activator);
}

U0 HLDoorUseGroup(I64 self, I64 activator)
{//the +use fan out, HLM_DOOR_GROUP. Covers both door classes: the leaf call is
 //queued, and HLM_DOOR_LEAF picks the swinging or the sliding mover off the
 //leaf's own use_fn. HLM_DOOR_LEAF does not fan out again, so a group of any
 //size costs one round
	I64 peer = HLDoorGroupNext(self, 0, FALSE);

	HLEntQueueCall(self, HLM_DOOR_LEAF, activator, HLUSE_TOGGLE, 0.0);

	while (peer >= 0)
	{
		HLEntQueueCall(peer, HLM_DOOR_LEAF, activator, HLUSE_TOGGLE, 0.0);
		peer = HLDoorGroupNext(self, peer + 1, FALSE);
	}
}

Bool HLDoorTouchAllows(I64 self, CHLEntity *e)
{//the front half of CBaseDoor::DoorTouch, doors.cpp:485-506. CRotDoor inherits
 //the method, doors.cpp:872, so HLRotDoorTouch shares this gate
	if (!e)
		return FALSE;

	//"If door has master, and it's not ready to trigger, play 'locked' sound",
	//doors.cpp:494. The SDK falls through to the targetname test; a locked
	//named door would cue twice, and the debounce swallows the second
	if (!HLEntMasterAllows(e))
	{
		HLEntPlayLockSounds(self, e, TRUE, FALSE);
		return FALSE;
	}

	//"If door is somebody's target, then touching does nothing. You have to
	//activate the owner", doors.cpp:499. A named door refuses the touch whether
	//or not USE_ONLY is set, and says so
	if (e->targetname[0])
	{
		HLEntPlayLockSounds(self, e, TRUE, FALSE);
		return FALSE;
	}

	if (e->spawnflags & HLSF_DOOR_USE_ONLY)
		return FALSE;

	return TRUE;
}

U0 HLDoorTouch(I64 self, I64 activator)
{//CBaseDoor::DoorTouch, doors.cpp:485
	CHLEntity *e = HLEntGet(self);

	if (!HLDoorTouchAllows(self, e))
		return;

	//"if (DoorActivate()) SetTouch(NULL)", doors.cpp:511
	if (HLDoorUseLeaf(self, activator))
		HLDoorTouchLatch(e, FALSE);
}

//--- buttons ----------------------------------------------------------------

#define HLSF_BUTTON_DONT_MOVE	1
#define HLSF_BUTTON_TOGGLE		32
#define HLSF_BUTTON_TOUCH_ONLY	256

//func_rot_button reassigns bit 1: SF_ROTBUTTON_NOTSOLID, buttons.cpp:34, not
//SF_BUTTON_DONT_MOVE. 2 of the 36 shipped rot buttons carry it. e->rotates
//separates the two readings of the bit throughout the button methods
#define HLSF_ROTBUTTON_NOTSOLID	1

U0 HLButtonHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//CBaseButton::TriggerAndWait. A rotating button carries no linear velocity;
	//the mover pass integrates avelocity for it
	if (e->rotates)
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	else
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	e->toggle_state = HLTS_AT_TOP;

	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);

	//a negative wait latches the button down permanently
	if (e->wait < 0.0)
		return;

	if (e->spawnflags & HLSF_BUTTON_TOGGLE)
		return;

	HLEntSetThink(e, HLM_BUTTON_RETURN, hl_ent_time + e->wait);
}

U0 HLButtonHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->rotates)
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	else
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	e->toggle_state = HLTS_AT_BOTTOM;
}

U0 HLButtonGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->activator    = activator;
	e->toggle_state = HLTS_GOING_UP;

	//CBaseButton::ButtonActivate, buttons.cpp:656, CHAN_VOICE
	HLEntSound(self, e, HLEntButtonSound(e->snd_index), HLCHAN_VOICE);

	//SF_BUTTON_DONT_MOVE makes the button a pure trigger surface. The bit means
	//NOTSOLID on a rot button, which is applied at spawn instead
	if (!e->rotates && (e->spawnflags & HLSF_BUTTON_DONT_MOVE))
	{
		HLButtonHitTop(self);
		return;
	}

	//"if (!m_fRotating) LinearMove else AngularMove", CBaseButton::ButtonActivate,
	//buttons.cpp:690
	if (e->rotates)
		HLEntCalcAngleMove(e, e->angle2, e->speed, HLM_BUTTON_HIT_TOP);
	else
		HLEntCalcMove(e, e->position2, e->speed, HLM_BUTTON_HIT_TOP);
}

U0 HLButtonGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	if (!e->rotates && (e->spawnflags & HLSF_BUTTON_DONT_MOVE))
	{
		HLButtonHitBottom(self);
		return;
	}

	//CBaseButton::ButtonReturn, buttons.cpp:737
	if (e->rotates)
		HLEntCalcAngleMove(e, e->angle1, e->speed, HLM_BUTTON_HIT_BOTTOM);
	else
		HLEntCalcMove(e, e->position1, e->speed, HLM_BUTTON_HIT_BOTTOM);
}

U0 HLButtonUse(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//ButtonResponseToTouch, buttons.cpp:606, before the master gate: a button
	//mid-move or latched down answers nothing at all, locked or not
	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_GOING_DOWN)
		return;

	if (e->toggle_state == HLTS_AT_TOP)
	{
		if (e->spawnflags & HLSF_BUTTON_TOGGLE)
			HLButtonGoDown(self);

		return;
	}

	//"button is locked, play locked sound", buttons.cpp:674. The SDK emits the
	//button's own noise first, in ButtonActivate above this gate; that sound
	//belongs to a button that moves, so it stays in HLButtonGoUp
	if (!HLEntMasterAllows(e))
	{
		HLEntPlayLockSounds(self, e, TRUE, TRUE);
		return;
	}

	//"button is unlocked, play unlocked sound", buttons.cpp:680
	HLEntPlayLockSounds(self, e, FALSE, TRUE);

	HLButtonGoUp(self, activator);
}

//--- trains -----------------------------------------------------------------
//
// func_train walks a chain of path_corner entities. c0a0's tram is a
// func_tracktrain on path_track: the same corner walk, plus orientation.

//func_train's flags
#define HLSF_TRAIN_WAIT_RETRIGGER	1
#define HLSF_TRAIN_START_ON			4

//func_tracktrain reassigns the same bits: bit 2 is FORWARDONLY, not START_ON.
//Reading a tracktrain's spawnflags with the func_train table starts trams that
//should be waiting for a script
#define HLSF_TRACKTRAIN_NOPITCH		1
#define HLSF_TRACKTRAIN_NOCONTROL	2
#define HLSF_TRACKTRAIN_FORWARDONLY	4
#define HLSF_TRACKTRAIN_PASSABLE	8

//CFuncTrackTrain holds its running noise open on CHAN_STATIC and stops it when
//the train parks. Restarting it at every path_track, which is what calling
//HLEntSound per node does, gives one clipped hit per node instead of a loop.
I64 hl_train_voice[HLENT_MAX];		//HLSndLoopHold handle, -1 when silent
I64 hl_train_pitch[HLENT_MAX];		//quantised pitch hl_train_voice runs at
Bool hl_train_playing[HLENT_MAX];	//m_soundPlaying, plats.cpp:1099

//CFuncRotating holds noiseRunning open on CHAN_STATIC and stops it at the
//bottom of SpinDown, dlls/bmodels.cpp:641. Registering the fan through the
//ambient table instead gave a loop that could be started and never stopped or
//retuned, so a switched-off fan hummed on.
I64 hl_fan_voice[HLENT_MAX];		//HLSndLoopHold handle, -1 when silent
I64 hl_fan_pitch[HLENT_MAX];		//quantised pitch hl_fan_voice runs at

Bool hl_train_voice_valid = FALSE;

//UpdateSound, plats.cpp:1092-1094 and :1129
#define HLTRAIN_STARTPITCH	60.0
#define HLTRAIN_MAXPITCH	200.0
#define HLTRAIN_MAXSPEED	1000.0

U0 HLTrainVoiceReset()
{//S_StopAllSounds' share of this file: a looping voice is never released by the
 //mixer on its own, so a train still moving when the level ends keeps its noise
 //running under the next map. Only stop handles from a previous map - on the
 //very first call the array is uninitialised garbage.
	I64 i;

	for (i = 0; i < HLENT_MAX; i++)
	{
		if (hl_train_voice_valid)
		{
			HLSndLoopStop(hl_train_voice[i]);
			HLSndLoopStop(hl_fan_voice[i]);
		}

		hl_train_voice[i]   = -1;
		hl_train_pitch[i]   = 0;
		hl_train_playing[i] = FALSE;

		hl_fan_voice[i]     = -1;
		hl_fan_pitch[i]     = 0;
	}

	hl_train_voice_valid = TRUE;
}

F64 HLTrainVolume(CHLEntity *e)
{//CFuncTrackTrain::KeyValue, plats.cpp:981-982, reads "volume" with atoi and
 //scales by 0.1; Precache, plats.cpp:1528-1529, turns 0 into 1.0. The parser
 //stores the key unscaled because scripted_sentence and func_rotating scale it
 //themselves and the default is 1.0, so the 0-10 range is folded here. Every
 //shipped func_tracktrain writes 10, 8 or 4.
	F64 vol = e->volume;

	if (vol > 1.0)
		vol = vol * 0.1;

	if (vol <= 0.0 || vol > 1.0)
		vol = 1.0;

	return vol;
}

U0 HLTrainCentre(CHLEntity *e, F64 *out)
{
	I64 i;

	for (i = 0; i < 3; i++)
		out[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;
}

U0 HLTrainVoiceStop(I64 self)
{//CFuncTrackTrain::StopSound, plats.cpp:1097
	CHLEntity	*e;
	F64			 centre[3];

	if (self < 0 || self >= HLENT_MAX)
		return;

	HLSndLoopStop(hl_train_voice[self]);
	hl_train_voice[self] = -1;
	hl_train_pitch[self] = 0;

	if (!hl_train_playing[self])
		return;

	hl_train_playing[self] = FALSE;

	e = HLEntGet(self);

	if (!e)
		return;

	HLTrainCentre(e, centre);

	//plats.cpp:1112
	HLSndPlayAt("plats/ttrain_brake1.wav", centre, HLTrainVolume(e),
		HLATTN_NORM, self + 1, HLCHAN_ITEM, HLPITCH_NORM);
}

//Lines of tracktrain start/stop decision left to log on this map. The entity
//trace is a whole-map budget the opening seconds spend; this is the one
//decision the intro chain turns on, so it carries its own. Shared with the
//three silent exits in HLTrackTrainNext, which stop the car without a word.
I64 hl_train_use_log = 8;

U0 HLTrainParkLog(I64 self, CHLEntity *e, U8 *why)
{//one line naming which exit stopped a tracktrain, and its state
	U8 line[192];

	if (hl_train_use_log <= 0)
		return;

	hl_train_use_log--;

	StrPrint(line, "TRAIN %6.2f %3d %-12s %s sp %7.1f tgt %s nd %3d\n",
		hl_ent_time, self, e->targetname, why, e->speed, e->target,
		HLEntFindByTargetname(e->target, 0));

	HLLog(line);
	"%s", line;
}

U0 HLTrainVoiceStart(I64 self, CHLEntity *e)
{//CFuncTrackTrain::UpdateSound, plats.cpp:1122. Held open while the train
 //moves and re-aimed, never restarted, except when the quantised pitch changes.
	U8	*path;
	F64	 centre[3];
	F64	 vol;
	F64	 speed;
	I64	 pitch;

	if (self < 0 || self >= HLENT_MAX)
		return;

	path = HLEntTrainSound(e->snd_index);

	if (!path)
		return;

	HLTrainCentre(e, centre);

	vol   = HLTrainVolume(e);
	speed = e->speed;

	if (speed < 0.0)
		speed = -speed;

	pitch = ToI64(HLTRAIN_STARTPITCH + speed *
			(HLTRAIN_MAXPITCH - HLTRAIN_STARTPITCH) / HLTRAIN_MAXSPEED);

	if (!hl_train_playing[self])
	{
		hl_train_playing[self] = TRUE;

		//plats.cpp:1134
		HLSndPlayAt("plats/ttrain_start1.wav", centre, vol, HLATTN_NORM,
			self + 1, HLCHAN_ITEM, HLPITCH_NORM);
	}

	//plats.cpp:1135 emits the loop on CHAN_STATIC at ATTN_NORM, spatialised
	//like any other sound. The old hand-rolled 1500-unit radius reached past
	//ATTN_NORM's 1250 and held every train at full scale until it cut.
	hl_train_voice[self] = HLSndLoopHold(hl_train_voice[self],
							hl_train_pitch[self], path, centre, vol,
							HLATTN_NORM, pitch);

	hl_train_pitch[self] = HLSndLoopPitchQuant(pitch);
}

//--- path_track traversal ---------------------------------------------------

//CPathTrack spawnflags, trains.h:25
#define HLSF_PATH_DISABLED			1
#define HLSF_PATH_FIREONCE			2
#define HLSF_PATH_DISABLE_TRAIN		8

F64 HLAngleDistance(F64 next, F64 cur)
{//UTIL_AngleDistance, util.cpp: signed shortest way from cur to next, degrees.
 //Both arguments must already be in [0,360)
	F64 delta = next - cur;

	if (delta < -180.0)
		return delta + 360.0;

	if (delta > 180.0)
		return delta - 360.0;

	return delta;
}

I64 HLPathLookAhead(I64 node, F64 *pos, F64 dist, Bool test = TRUE)
{//CPathTrack::LookAhead, pathcorner.cpp:287, forward only
 //
 //pos carries in the point to start from and carries out the point dist units
 //further along the track polyline. The return is the node that sample lands
 //on, or -1 at the end of the path.
 //
 //test is the SDK's move flag: a position sample stops at a disabled node, a
 //facing sample walks through it. func_trackchange sets and clears that bit as
 //it travels, which is how the lift decides which way the car may leave.
 //
 //Backward travel is absent: nothing in this port reverses a tracktrain, and
 //the reverse walk needs the previous-node links CPathTrack::Link builds.
 //CPathTrack::Project is absent for the same reason.
	CHLEntity	*n;
	F64			 dir[3];
	F64			 len;
	F64			 frac;
	I64			 cur = node;
	I64			 nxt;
	I64			 hops;
	I64			 i;

	if (cur < 0)
		return -1;

	//bounded rather than "while dist > 0": a path_track ring joined by a zero
	//length leg subtracts nothing and never terminates
	for (hops = 0; hops < HLENT_MAX; hops++)
	{
		if (dist <= 0.0)
			return cur;

		nxt = HLEntFindByTargetname(hl_entities[cur].target, 0);

		if (nxt < 0)
			return -1;

		//ValidPath, pathcorner.cpp:236
		if (test && (hl_entities[nxt].spawnflags & HLSF_PATH_DISABLED))
			return -1;

		n = &hl_entities[nxt];

		HLVecSub(n->origin, pos, dir);
		len = HLVecLength(dir);

		if (len > dist)
		{
			frac = dist / len;

			for (i = 0; i < 3; i++)
				pos[i] += dir[i] * frac;

			return cur;
		}

		dist -= len;
		HLVecCopy(n->origin, pos);
		cur = nxt;
	}

	return cur;
}

U0 HLTrackTrainNext(I64 self)
{//CFuncTrackTrain::Next, plats.cpp:1162
 //
 //Runs every server tick, not once per node. plats.cpp:1266 asks for a think
 //0.5s out but passes alwaysThink, which sets FL_ALWAYSTHINK and makes the
 //engine run the think every frame regardless; the 10x factors below are 1/0.1
 //and are only a turn rate at that cadence.
 //
 //The car is aimed at a point 100 units up the track and turns toward it at ten
 //times the residual per second, so the facing settles with a 0.1s time
 //constant and the deck never steps out from under a rider. Snapping the yaw at
 //each node instead walks a passenger off the deck: the one-tick omega x r
 //carry is a chord across the turn, its outward error is r*(1-cos(theta/2)) per
 //node, and on c0a0's 15 degree corners that accumulates past the 288 by 150
 //deck within six nodes.
 //
 //Pitch is not driven. UTIL_VecToAngles' pitch sign is not established for this
 //port's brush rotation, every tracktrain in the intro chain carries
 //SF_TRACKTRAIN_NOPITCH, and every other shipped tracktrain path is flat.
 //
 //Bank is not driven: the "bank" key is not parsed, and no shipped tracktrain
 //sets it.
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*fire;
	F64			 next_pos[3];
	F64			 next_front[3];
	F64			 delta[3];
	F64			 want;
	F64			 vy;
	F64			 look;
	I64			 ppath;
	I64			 pnext;
	I64			 i;

	if (!e)
		return;

	//"TRAIN(%s): Speed is 0", plats.cpp:1166
	if (HLIsZeroF(e->speed))
	{
		HLTrainParkLog(self, e, "park speed0");
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLTrainVoiceStop(self);
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	//m_ppath, the node the car last passed, held in e->target. The SDK keeps
	//pev->target naming the first node for the life of the entity and m_ppath
	//beside it; there is no m_ppath field here, and nothing reads a tracktrain's
	//target after spawn
	ppath = HLEntFindByTargetname(e->target, 0);

	if (ppath < 0)
	{
		//"TRAIN(%s): Lost path", plats.cpp:1176. StopSound only: the velocity is
		//left alone because a func_trackchange carrying the car clears its path
		//and then drives it by hand - see HLTrackUpdateTrain
		HLTrainParkLog(self, e, "lost path  ");
		HLTrainVoiceStop(self);
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	HLTrainVoiceStart(self, e);

	//Velocity is the 0.1s-ahead sample over 0.1s. Sampling the polyline rather
	//than aiming at the next node is what puts the car ON the track through a
	//corner instead of across its chord.
	//
	//m_height lifts the car above the rail, so the track is sampled from the
	//rail plane and the result lifted back
	HLVecCopy(e->origin, next_pos);
	next_pos[2] -= e->height;
	pnext = HLPathLookAhead(ppath, next_pos, e->speed * 0.1);
	next_pos[2] += e->height;

	for (i = 0; i < 3; i++)
		e->velocity[i] = (next_pos[i] - e->origin[i]) * 10.0;

	//m_length, the "wheels" key, or 100 when absent - plats.cpp:1194. The
	//facing sample passes testFlag 0, so a disabled node does not shorten it
	look = 100.0;

	if (e->train_length > 0.0)
		look = e->train_length;

	HLVecCopy(e->origin, next_front);
	next_front[2] -= e->height;
	HLPathLookAhead(ppath, next_front, look, FALSE);
	next_front[2] += e->height;

	HLVecSub(next_front, e->origin, delta);

	want = e->angles[1];

	//"if ( !pnext || (delta.x == 0 && delta.y == 0) ) angles = pev->angles":
	//at a dead end, or with the sample point directly overhead, hold the
	//current facing rather than deriving one from nothing
	if (pnext >= 0 && (!HLIsZeroF(delta[0]) || !HLIsZeroF(delta[1])))
	{
		//The 180 is Valve's: tracktrain brushwork is modelled facing west, so
		//the yaw derived from the direction of travel is a half turn out
		want = HLAngleNorm(Arg(delta[0], delta[1]) / HLDEG2RAD + 180.0);
	}

	e->angles[1] = HLAngleNorm(e->angles[1]);

	vy = HLAngleDistance(want, e->angles[1]);

	e->avelocity[0] = 0.0;
	e->avelocity[1] = vy * 10.0;
	e->avelocity[2] = 0.0;

	if (pnext < 0)
	{
		//End of path. CFuncTrackTrain::DeadEnd glides the remaining gap at the
		//old speed; SUB_CalcMove does the same thing and schedules the arrival
		HLTrainParkLog(self, e, "dead end   ");
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLTrainVoiceStop(self);
		HLEntCalcMove(e, next_pos, e->speed, HLM_TRAIN_DEADEND);
		e->speed = 0.0;
		return;
	}

	if (pnext != ppath)
	{
		//pFire, plats.cpp:1235. Speed here is always positive - reverse is not
		//reachable - so the node that fires is the one just entered
		fire = &hl_entities[pnext];

		HLStrCopy(e->target, fire->targetname, 64);

		//A node's pass-fire is its `message` key, not its `target`: `target`
		//names the next node. c0a0's whole intro hangs off this - trainstop8
		//opens the room2 door, trainstop9 runs the scientist script,
		//trainstop11 fades out.
		if (fire->message[0])
		{
			HLEntFireTargetsNamed(fire->message, pnext, self, HLUSE_TOGGLE, 0.0);

			if (fire->spawnflags & HLSF_PATH_FIREONCE)
				fire->message[0] = 0;
		}

		if (fire->spawnflags & HLSF_PATH_DISABLE_TRAIN)
			e->spawnflags = e->spawnflags | HLSF_TRACKTRAIN_NOCONTROL;

		//"don't copy speed from target if it is 0 (uninitialized)". c0a0's
		//trainstop17 carries speed 0 and must not park the tram there
		if (e->spawnflags & HLSF_TRACKTRAIN_NOCONTROL)
		{
			if (!HLIsZeroF(fire->speed))
				e->speed = fire->speed;
		}
	}

	//FL_ALWAYSTHINK. The think loop fires anything whose next_think is at or
	//before the clock, and the clock has already advanced this tick, so this
	//lands on the next one
	HLEntSetThink(e, HLM_TRAIN_NEXT, hl_ent_time);
}

U0 HLTrainNext(I64 self)
{//the train has arrived at its current corner: fire that corner's target,
 //then head for the next one
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*corner;
	F64			 dest[3];
	I64			 next;

	if (!e)
		return;

	//func_tracktrain follows the track continuously and shares nothing with
	//CFuncTrain's corner-to-corner hop below
	if (e->ent_class == HLC_TRACKTRAIN)
	{
		HLTrackTrainNext(self);
		return;
	}

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	next = HLEntFindByTargetname(e->target, 0);

	if (next < 0)
	{
		//broken path - stop rather than spin looking for it every frame
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	corner = &hl_entities[next];

	//A node's pass-fire is its `message` key, not its `target`: `target` names
	//the next node. c0a0's whole intro hangs off this - trainstop8 opens the
	//room2 door, trainstop9 runs the scientist script, trainstop11 fades out.
	if (corner->message[0])
		HLEntFireTargetsNamed(corner->message, next, self, HLUSE_TOGGLE, 0.0);

	//the corner's own target names the next corner
	HLStrCopy(e->target, corner->target, 64);

	//a corner's speed overrides the train's for the leg leaving it
	if (corner->speed > 0.0)
		e->speed = corner->speed;

	//The node marks where the brush's mins corner goes, so the origin is offset
	//by it. A tracktrain parks its origin on the node instead and never reaches
	//here.
	dest[0] = corner->origin[0] - e->mins[0];
	dest[1] = corner->origin[1] - e->mins[1];
	dest[2] = corner->origin[2] - e->mins[2];

	HLTrainVoiceStart(self, e);

	//func_train does not turn: its brush is not registered with
	//HLClipSetRotating, so angles are left alone.

	//"m_flWait = pTarg->GetDelay()", plats.cpp:775, where CPathCorner::GetDelay
	//returns its own wait key (cbase.h:548). Carried on the train because Wait
	//runs a move later, by which time the corner is no longer resolvable
	e->wait = corner->wait;

	if (corner->wait > 0.0)
	{
		//pause at this corner before leaving
		HLEntCalcMove(e, dest, e->speed, HLM_TRAIN_WAIT);
		return;
	}

	HLEntCalcMove(e, dest, e->speed, HLM_TRAIN_NEXT);
}

U0 HLTrainWait(I64 self)
{//CFuncTrain::Wait, plats.cpp:728. Parked at a corner - resume after its wait
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);

	//HLTrainNext stored the arrived-at corner's wait here. A zero means
	//"Next() right now"; the entity clock cannot dispatch at exactly now, so
	//the next think does it
	HLEntSetThink(e, HLM_TRAIN_NEXT, hl_ent_time + e->wait);
}

U0 HLTrainUse(I64 self, I64 use_type)
{//a stopped train starts, a moving one stops
 //
 //CFuncTrackTrain::Use, plats.cpp:1031, reads pev->speed for that state and
 //restores it from m_speed on the way back up. The think stands in for it on
 //func_train, which has no such test - CFuncTrain::Use toggles
 //SF_TRAIN_WAIT_RETRIGGER and never touches pev->speed, so a func_train's speed
 //is never zero and a speed test would leave it able to stop and never start.
 //
 //The two answers differ on a tracktrain parked at a dead end: Next zeroes the
 //speed there (plats.cpp:1272), and a Use arriving afterwards reached Next with
 //speed 0, which parks again. Every restart in the tree then runs through
 //HLTrackAutoTargets, which only a func_trackchange reaches.
	CHLEntity	*e = HLEntGet(self);
	U8			 line[192];
	Bool		 running;

	if (!e)
		return;

	running = ToBool(e->think_fn != HLM_NONE);

	if (e->ent_class == HLC_TRACKTRAIN)
		running = !HLIsZeroF(e->speed);

	//speed and m_speed are the state the branch below reads; node is the first
	//path node e->target resolves to, -1 when the chain is broken
	if (hl_train_use_log > 0)
	{
		hl_train_use_log--;

		StrPrint(line,
			"TRAIN %6.2f %3d %-16s cls %2d run %d sp %7.1f ms %7.1f ss %7.1f nd %3d\n",
			hl_ent_time, self, e->targetname, e->ent_class, ToI64(running),
			e->speed, e->train_speed, e->start_speed,
			HLEntFindByTargetname(e->target, 0));

		HLLog(line);
		"%s", line;
	}

	//"if (!ShouldToggle(useType, (pev->speed != 0))) return", CFuncTrackTrain::
	//Use, plats.cpp:1035, via CBaseEntity::ShouldToggle, cbase.cpp:726. An ON
	//at a running car and an OFF at a parked one do nothing. c0a0c's and
	//c0a0d's trams spawn running from startspeed 300 and take a trigger_auto
	//USE_ON a second later; without the gate that Use parks them for good.
	//
	//Tracktrain only. CFuncTrain::Use, plats.cpp:687, has no such test and
	//toggles SF_TRAIN_WAIT_RETRIGGER whatever the type.
	if (e->ent_class == HLC_TRACKTRAIN &&
		use_type != HLUSE_TOGGLE && use_type != HLUSE_SET)
	{
		if (running && use_type == HLUSE_ON)
			return;

		if (!running && use_type == HLUSE_OFF)
			return;
	}

	if (running)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		HLVecSet(e->velocity, 0.0, 0.0, 0.0);

		//a tracktrain stopped mid-corner keeps turning otherwise: the mover pass
		//integrates avelocity with no think involved
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);

		//"pev->speed = 0 ... StopSound()", plats.cpp:1043
		if (e->ent_class == HLC_TRACKTRAIN)
		{
			e->speed = 0.0;
			HLTrainVoiceStop(self);
		}

		return;
	}

	//"pev->speed = m_speed * m_dir", plats.cpp:1040. m_dir is 1: reverse is not
	//reachable in this port, and m_speed is the "speed" key, held in train_speed
	if (e->ent_class == HLC_TRACKTRAIN && e->train_speed > 0.0)
		e->speed = e->train_speed;

	HLTrainNext(self);
}

U0 HLTrackDeadEnd(I64 self)
{//CFuncTrackTrain::DeadEnd, plats.cpp:1298. The node the car stopped on is not
 //m_ppath - the walk runs to the end of the enabled chain first - and its
 //netname is the dead-end fire. c0a0b's "upper1" and c0a0d's "lower88" carry
 //nothing else, so this is the whole of how the intro tram calls the lift.
	CHLEntity	*e = HLEntGet(self);
	I64			 cur;
	I64			 nxt;
	I64			 hops;

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);

	cur = HLEntFindByTargetname(e->target, 0);

	if (cur < 0)
		return;

	//bounded, as HLPathLookAhead is: a ring of nodes has no end to reach
	for (hops = 0; hops < HLENT_MAX; hops++)
	{
		nxt = HLEntFindByTargetname(hl_entities[cur].target, 0);

		if (nxt < 0)
			goto qtde_fire;

		if (hl_entities[nxt].spawnflags & HLSF_PATH_DISABLED)
			goto qtde_fire;

		cur = nxt;
	}

qtde_fire:
	//m_ppath is not moved: the SDK's pTrack is a local
	if (hl_entities[cur].netname[0])
		HLEntFireTargetsNamed(hl_entities[cur].netname, cur, self,
			HLUSE_TOGGLE, 0.0);
}

//--- func_trackchange -------------------------------------------------------
//
// CFuncTrackChange, plats.cpp:1618. A func_platrot that carries a
// func_tracktrain between two path_track chains and turns it to face the new
// one. Which chain the car may leave by is the SF_PATH_DISABLED bit on each
// node, which this class sets and clears as it travels.
//
// Polarity follows the note above HLPlatRotMove: this file's plat rests at
// position1 in HLTS_AT_BOTTOM, so
//
//   HLTrackGoUp   -> position2, angle1 -> CFuncTrackChange::GoDown
//   HLTrackGoDown -> position1, angle2 -> CFuncTrackChange::GoUp
//   HLTS_AT_BOTTOM                     -> TS_AT_TOP
//   HLTS_AT_TOP                        -> TS_AT_BOTTOM
//
// The move and stop sounds come off the door table, as every other plat in this
// file does. CBasePlatTrain::Precache maps the same two keys to plats/*.wav.
//
// Six instances ship: c0a0b and c0a0d carry the intro tram (func_trackautochange)
// and c2a1, c2a2, c2a2b1 and c2a2e are the zone 3 lifts.

#define HLSF_TRACK_ACTIVATETRAIN	1	//plats.cpp:1604
#define HLSF_TRACK_RELINK			2
#define HLSF_TRACK_ROTMOVE			4
#define HLSF_TRACK_STARTBOTTOM		8
#define HLSF_TRACK_DONT_MOVE		16	//turn in place, no linear travel

//CFuncTrackChange::EvaluateTrain's verdict, plats.cpp:1616
#define HLTRAIN_SAFE			0
#define HLTRAIN_BLOCKING		1
#define HLTRAIN_FOLLOWING		2

U0 HLAngleVectorsInv(F64 *angles, F64 *forward, F64 *right, F64 *up)
{//UTIL_MakeInvVectors, util.cpp: HLAngleVectors' basis with right negated and
 //then transposed, which maps a world offset into the frame the angles name
	F64 t;

	HLAngleVectors(angles, forward, right, up);

	right[0] = -right[0];
	right[1] = -right[1];
	right[2] = -right[2];

	t          = forward[1];
	forward[1] = right[0];
	right[0]   = t;

	t          = forward[2];
	forward[2] = up[0];
	up[0]      = t;

	t        = right[2];
	right[2] = up[1];
	up[1]    = t;
}

I64 HLTrackPrevious(I64 node)
{//CPathTrack::GetPrevious, pathcorner.cpp:266. CPathTrack::Link builds the back
 //pointer during Activate; this file has no link pass, so the owner is found by
 //scan. Only EvaluateTrain needs it, at most twice per lift use
	I64 i;

	if (node < 0 || !hl_entities[node].targetname[0])
		return -1;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qtp_next;

		if (StrCompare(hl_entities[i].classname, "path_track"))
			goto qtp_next;

		if (!StrCompare(hl_entities[i].target, hl_entities[node].targetname))
			return i;

qtp_next:
	}

	return -1;
}

I64 HLTrackNearest(I64 node, F64 *org)
{//CPathTrack::Nearest, pathcorner.cpp:371. Walks forward from this node and
 //keeps the one closest in XY; a ring that closes on the start node ends it
	F64	 d[3];
	F64	 best;
	F64	 dist;
	I64	 found;
	I64	 cur;
	I64	 hops;

	if (node < 0)
		return -1;

	HLVecSub(org, hl_entities[node].origin, d);
	d[2] = 0.0;
	best  = HLVecLength(d);
	found = node;

	cur = HLEntFindByTargetname(hl_entities[node].target, 0);

	for (hops = 0; hops < HLENT_MAX; hops++)
	{
		if (cur < 0 || cur == node)
			return found;

		HLVecSub(org, hl_entities[cur].origin, d);
		d[2] = 0.0;
		dist = HLVecLength(d);

		if (dist < best)
		{
			best  = dist;
			found = cur;
		}

		cur = HLEntFindByTargetname(hl_entities[cur].target, 0);
	}

	return found;
}

U0 HLTrackSetTrack(I64 train, I64 node)
{//CFuncTrackTrain::SetTrack, trains.h:148. m_ppath is this file's e->target
	CHLEntity	*t = HLEntGet(train);
	I64			 n;

	if (!t)
		return;

	n = HLTrackNearest(node, t->origin);

	if (n < 0)
		return;

	HLStrCopy(t->target, hl_entities[n].targetname, 64);
}

I64 HLTrackEvaluate(CHLEntity *e, I64 node)
{//CFuncTrackChange::EvaluateTrain, plats.cpp:1805
	CHLEntity	*t;
	F64			 d[3];
	F64			 len;
	I64			 cur;
	I64			 prev;
	I64			 nxt;

	if (node < 0 || e->track_train_ent < 0)
		return HLTRAIN_SAFE;

	t = HLEntGet(e->track_train_ent);

	if (!t)
		return HLTRAIN_SAFE;

	//the lift acts only while the car sits on this node or on either neighbour
	cur  = HLEntFindByTargetname(t->target, 0);
	nxt  = HLEntFindByTargetname(hl_entities[node].target, 0);
	prev = HLTrackPrevious(node);

	if (cur != node && cur != prev && cur != nxt)
		return HLTRAIN_SAFE;

	if (!HLIsZeroF(t->speed))
		return HLTRAIN_BLOCKING;

	HLVecSub(e->origin, t->origin, d);
	d[2] = 0.0;
	len  = HLVecLength(d);

	//"Empirically determined close distance", plats.cpp:1816: inside the car's
	//own length it is on the lift, past 150 beyond that it is clear of it
	if (len < t->train_length)
		return HLTRAIN_FOLLOWING;

	if (len > 150.0 + t->train_length)
		return HLTRAIN_SAFE;

	return HLTRAIN_BLOCKING;
}

U0 HLTrackDisable(I64 node, Bool off)
{//SetBits/ClearBits on SF_PATH_DISABLED
	if (node < 0)
		return;

	if (off)
		hl_entities[node].spawnflags |= HLSF_PATH_DISABLED;
	else
		hl_entities[node].spawnflags &= ~HLSF_PATH_DISABLED;
}

U0 HLTrackAutoTargets(I64 self, I64 state)
{//CFuncTrackChange::UpdateAutoTargets, plats.cpp:1927, and the CFuncTrackAuto
 //override at plats.cpp:2023.
 //
 //The plain class enables the node the lift is resting on and disables the
 //other. The auto class works one node further along - it enables the node the
 //car will leave BY, which is the successor of the end it is heading for - and
 //restarts a parked car it is carrying.
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*t;
	I64			 tgt;
	I64			 nxt;

	if (!e || e->track_top_ent < 0 || e->track_bottom_ent < 0)
		return;

	if (e->ent_class != HLC_TRACKAUTO)
	{
		//HLTS_AT_BOTTOM is TS_AT_TOP
		HLTrackDisable(e->track_top_ent,
			ToBool(state != HLTS_AT_BOTTOM));
		HLTrackDisable(e->track_bottom_ent,
			ToBool(state != HLTS_AT_TOP));
		return;
	}

	//m_targetState, not the argument: plats.cpp:2029 ignores what it is passed
	if (e->track_target == HLTS_AT_BOTTOM)
	{
		tgt = HLEntFindByTargetname(hl_entities[e->track_top_ent].target, 0);
		nxt = HLEntFindByTargetname(hl_entities[e->track_bottom_ent].target, 0);
	}
	else
	{
		tgt = HLEntFindByTargetname(hl_entities[e->track_bottom_ent].target, 0);
		nxt = HLEntFindByTargetname(hl_entities[e->track_top_ent].target, 0);
	}

	if (tgt >= 0)
	{
		HLTrackDisable(tgt, FALSE);

		//"m_train->Use( this, this, USE_ON, 0 )", plats.cpp:2046: a parked car
		//on the lift is sent on its way at its authored speed
		t = HLEntGet(e->track_train_ent);

		if (e->track_code == HLTRAIN_FOLLOWING && t && HLIsZeroF(t->speed))
		{
			t->speed = t->train_speed;
			HLTrackTrainNext(e->track_train_ent);
		}
	}

	HLTrackDisable(nxt, TRUE);
}

U0 HLTrackUpdateTrain(CHLEntity *e, F64 *dest)
{//CFuncTrackChange::UpdateTrain, plats.cpp:1830. The car is not carried by the
 //push pass - it is a pusher itself - so the lift hands it the lift's own
 //velocity plus the tangential term its offset from the lift axis picks up over
 //the remaining turn to dest.
	CHLEntity	*t = HLEntGet(e->track_train_ent);
	F64			 fwd[3];
	F64			 right[3];
	F64			 up[3];
	F64			 delta[3];
	F64			 offset[3];
	F64			 lcl[3];
	F64			 time;
	I64			 i;

	if (!t)
		return;

	time = e->next_think - hl_ent_time;

	HLVecCopy(e->velocity, t->velocity);
	HLVecCopy(e->avelocity, t->avelocity);

	//The car's own scheduling is suspended for the ride. The SDK reschedules
	//whatever think the car holds onto the lift's arrival; here that think is
	//an HLM_MOVE_DONE, which snaps the origin back to the destination the car
	//had before the lift picked it up. What the SDK's think does at that moment
	//- zero the velocity - HLTrackHitTop and HLTrackHitBottom do instead
	HLEntSetThink(t, HLM_NONE, 0.0);
	t->move_done = HLM_NONE;

	if (time <= 0.0)
		return;

	HLVecSub(t->origin, e->origin, offset);
	HLVecSub(dest, e->angles, delta);

	HLAngleVectorsInv(delta, fwd, right, up);

	lcl[0] = HLVecDot(offset, fwd);
	lcl[1] = HLVecDot(offset, right);
	lcl[2] = HLVecDot(offset, up);

	for (i = 0; i < 3; i++)
		t->velocity[i] = e->velocity[i] + (lcl[i] - offset[i]) / time;
}

U0 HLTrackGoUp(I64 self)
{//CFuncTrackChange::GoDown, plats.cpp:1857 - toward position2, physically down
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->track_code == HLTRAIN_BLOCKING)
		return;

	HLTrackAutoTargets(self, HLTS_GOING_UP);

	e->toggle_state = HLTS_GOING_UP;

	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	if (e->spawnflags & HLSF_TRACK_DONT_MOVE)
		HLEntCalcAngleMove(e, e->angle1, e->speed, HLM_TRACK_HIT_TOP);
	else
	{
		HLEntCalcMove(e, e->position2, e->speed, HLM_TRACK_HIT_TOP);
		HLPlatRotMove(e, e->angle1);
	}

	//the carry is set up after the move, because it reads the span the move
	//just scheduled
	if (e->track_code == HLTRAIN_FOLLOWING)
	{
		HLTrackUpdateTrain(e, e->angle1);

		//m_train->m_ppath = NULL: the car stops steering itself for the ride
		if (e->track_train_ent >= 0)
			hl_entities[e->track_train_ent].target[0] = 0;
	}
}

U0 HLTrackGoDown(I64 self)
{//CFuncTrackChange::GoUp, plats.cpp:1888 - toward position1, physically up
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->track_code == HLTRAIN_BLOCKING)
		return;

	HLTrackAutoTargets(self, HLTS_GOING_DOWN);

	e->toggle_state = HLTS_GOING_DOWN;

	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	if (e->spawnflags & HLSF_TRACK_DONT_MOVE)
		HLEntCalcAngleMove(e, e->angle2, e->speed, HLM_TRACK_HIT_BOTTOM);
	else
	{
		HLEntCalcMove(e, e->position1, e->speed, HLM_TRACK_HIT_BOTTOM);
		HLPlatRotMove(e, e->angle2);
	}

	if (e->track_code == HLTRAIN_FOLLOWING)
	{
		HLTrackUpdateTrain(e, e->angle2);

		if (e->track_train_ent >= 0)
			hl_entities[e->track_train_ent].target[0] = 0;
	}
}

U0 HLTrackHitTop(I64 self)
{//CFuncTrackChange::HitBottom, plats.cpp:1975 - this port's top
	CHLEntity *e = HLEntGet(self);
	CHLEntity *t;

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	//CFuncPlatRot::HitBottom snaps m_start, as HLDoorHitTop does. A lift with
	//no "rotation" key has no angle pair, and snapping to it would throw away
	//the authored angles - c0a0d's lift carries rotation 0
	if (e->rotates)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLVecCopy(e->angle1, e->angles);
		HLEntSetAbsBox(e);
	}

	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);

	//CFuncTrackTrain::DeadEnd's own effect, arriving with the lift: the car it
	//was carrying stops dead and takes the node this end of the lift feeds
	if (e->track_code == HLTRAIN_FOLLOWING)
	{
		t = HLEntGet(e->track_train_ent);

		if (t)
		{
			HLVecSet(t->velocity, 0.0, 0.0, 0.0);
			HLVecSet(t->avelocity, 0.0, 0.0, 0.0);
		}

		HLTrackSetTrack(e->track_train_ent, e->track_bottom_ent);
	}

	HLEntSetThink(e, HLM_NONE, 0.0);

	HLTrackAutoTargets(self, HLTS_AT_TOP);

	e->track_use = TRUE;
}

U0 HLTrackHitBottom(I64 self)
{//CFuncTrackChange::HitTop, plats.cpp:1995 - this port's bottom
	CHLEntity *e = HLEntGet(self);
	CHLEntity *t;

	if (!e)
		return;

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;

	if (e->rotates)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		HLVecCopy(e->angle2, e->angles);
		HLEntSetAbsBox(e);
	}

	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);

	if (e->track_code == HLTRAIN_FOLLOWING)
	{
		t = HLEntGet(e->track_train_ent);

		if (t)
		{
			HLVecSet(t->velocity, 0.0, 0.0, 0.0);
			HLVecSet(t->avelocity, 0.0, 0.0, 0.0);
		}

		HLTrackSetTrack(e->track_train_ent, e->track_top_ent);
	}

	HLEntSetThink(e, HLM_NONE, 0.0);

	HLTrackAutoTargets(self, HLTS_AT_BOTTOM);

	e->track_use = TRUE;
}

U0 HLTrackUse(I64 self, I64 activator)
{//CFuncTrackChange::Use, plats.cpp:1938, and CFuncTrackAuto::Use, plats.cpp:2050
 //
 //ShouldToggle on m_targetState is not reproduced: every path a shipped map
 //takes into here carries USE_TOGGLE, for which it is always true
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*a;
	CHLEntity	*t;
	I64			 node;
	I64			 leave;

	if (!e)
		return;

	if (e->toggle_state == HLTS_AT_BOTTOM)
		node = e->track_top_ent;
	else if (e->toggle_state == HLTS_AT_TOP)
		node = e->track_bottom_ent;
	else
		node = -1;

	if (e->ent_class != HLC_TRACKAUTO)
	{
		if (node < 0)
			return;

		e->track_code = HLTrackEvaluate(e, node);

		if (e->track_code == HLTRAIN_BLOCKING)
		{
			//CHAN_VOICE at full volume, plats.cpp:1955
			HLEntSound(self, e, "buttons/button11.wav", HLCHAN_VOICE, 1.0);
			return;
		}

		e->track_use = FALSE;

		if (e->toggle_state == HLTS_AT_BOTTOM)
			HLTrackGoUp(self);
		else
			HLTrackGoDown(self);

		return;
	}

	//--- func_trackautochange ---
	if (!e->track_use)
		return;

	a = HLEntGet(activator);

	//fired by the car itself: ride it across if it is standing on the lift and
	//the lift is not already at the end it is heading for
	if (a && !StrCompare(a->classname, "func_tracktrain"))
	{
		e->track_code = HLTrackEvaluate(e, node);

		if (e->track_code != HLTRAIN_FOLLOWING)
			return;

		if (e->toggle_state == e->track_target)
			return;

		e->track_use = FALSE;

		if (e->toggle_state == HLTS_AT_BOTTOM)
			HLTrackGoUp(self);
		else
			HLTrackGoDown(self);

		return;
	}

	//fired by anything else: flip which end the lift will travel to, unless the
	//car is already on the node it would leave by
	leave = -1;

	if (node >= 0)
		leave = HLEntFindByTargetname(hl_entities[node].target, 0);

	t = HLEntGet(e->track_train_ent);

	if (leave >= 0 && t &&
		StrCompare(t->target, hl_entities[leave].targetname))
	{
		if (e->track_target == HLTS_AT_BOTTOM)
			e->track_target = HLTS_AT_TOP;
		else
			e->track_target = HLTS_AT_BOTTOM;
	}

	HLTrackAutoTargets(self, e->track_target);
}

U0 HLTrackFind(I64 self)
{//CFuncTrackChange::Find, plats.cpp:1756. Runs 2s after spawn, by which time
 //every path_track and the car exist. Each named chain is walked to the node
 //nearest the lift's own centre, so a mapper may name any node on it
	CHLEntity	*e = HLEntGet(self);
	F64			 centre[3];
	I64			 i;

	if (!e)
		return;

	e->track_top_ent    = HLEntFindByTargetname(e->track_top, 0);
	e->track_bottom_ent = HLEntFindByTargetname(e->track_bottom, 0);
	e->track_train_ent  = HLEntFindByTargetname(e->track_train, 0);

	//"Can't find top track / bottom track / train for track change", the three
	//error paths at plats.cpp:1760, :1782 and :1776. Find is not rescheduled:
	//the SDK leaves the think set only until all three resolve
	if (e->track_top_ent < 0 || e->track_bottom_ent < 0 ||
		e->track_train_ent < 0)
		return;

	for (i = 0; i < 3; i++)
		centre[i] = (e->absmin[i] + e->absmax[i]) * 0.5;

	e->track_bottom_ent = HLTrackNearest(e->track_bottom_ent, centre);
	e->track_top_ent    = HLTrackNearest(e->track_top_ent, centre);

	HLTrackAutoTargets(self, e->toggle_state);
}

//--- triggers ---------------------------------------------------------------

#define HLSF_TRIGGER_MONSTERS	1
#define HLSF_TRIGGER_NO_CLIENTS	2

//CAutoTrigger. Without it the trigger stays in the world after firing, which
//costs nothing: its think is disarmed and it has no touch and no use
#define HLSF_AUTO_FIREONCE		1

Bool HLTriggerCanFire(CHLEntity *e)
{
	if (!HLEntMasterAllows(e))
		return FALSE;

	//pain_finished doubles as the debounce clock here - a brush trigger is
	//touched every frame the player stands in it
	if (e->pain_finished > hl_ent_time)
		return FALSE;

	return TRUE;
}

U0 HLTriggerTouch(I64 self, I64 other)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLTriggerCanFire(e))
		return;

	e->pain_finished = hl_ent_time + HLENT_TRIGGER_DEBOUNCE;

	HLEntUseTargets(self, other, HLUSE_TOGGLE, 0.0);

	//trigger_once removes itself. wait < 0 means the same for a multiple
	if (e->wait < 0.0)
	{
		//solid immediately, so a second touch this tick does nothing, but the
		//slot stays in use until any deferred fire has run - see HLM_AUTO_THINK
		e->solid = HLSOLID_NOT;

		if (e->think_fn == HLM_FIRE_TARGETS)
			e->remove_after_fire = TRUE;
		else
			e->in_use = FALSE;

		return;
	}

	if (e->wait > 0.0)
		e->pain_finished = hl_ent_time + e->wait;
}

U0 HLTriggerUse(I64 self, I64 activator)
{//trigger_relay and anything else fired rather than touched.
 //
 //CTriggerRelay carries the same triggerstate key as trigger_auto and fires
 //its m_triggerType, triggers.cpp:210-244. trigger_mode parses 0/1/2 to
 //OFF/ON/TOGGLE and defaults OFF, matching a zeroed pev member
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	HLEntUseTargets(self, activator, e->trigger_mode, 0.0);
}

U0 HLTriggerToggleUse(I64 self)
{//CBaseTrigger::ToggleUse, dlls/triggers.cpp:897. Flips the volume between
 //SOLID_TRIGGER and SOLID_NOT rather than firing anything
 //
 //force_retouch has no analogue here: the touch pass tests overlap every frame
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->solid == HLSOLID_NOT)
		e->solid = HLSOLID_TRIGGER;
	else
		e->solid = HLSOLID_NOT;

	HLEntSetAbsBox(e);
}

//--- multi_manager ----------------------------------------------------------
//
// fires N named targets, each at its own offset, off one use. the offsets are
// key/values whose keys are the target names, so the generic key parser cannot
// pick them up and they are re-scanned here

//SF_MULTIMAN_THREAD, triggers.cpp:261. SF_MULTIMAN_CLONE (0x80000000) has no
//counterpart: a clone is a run slot here, not an entity, and needs no marker
#define HLSF_MULTIMAN_THREAD	1

I64 HLMMFind(I64 ent)
{
	I64 i;

	for (i = 0; i < hl_mm_count; i++)
	{
		if (hl_mm[i].ent == ent)
			return i;
	}

	return -1;
}

U0 HLMMUse(I64 self, I64 activator)
{//CMultiManager::ManagerUse, triggers.cpp:429
	CHLEntity	*e = HLEntGet(self);
	I64			 m;
	I64			 r;
	I64			 oldest;
	I64			 i;

	if (!e)
		return;

	m = HLMMFind(self);
	if (m < 0)
		return;

	if (e->spawnflags & HLSF_MULTIMAN_THREAD)
	{
		//"In multiplayer games, clone the MM and execute in the clone (like a
		//thread) to allow multiple players to trigger the same multimanager".
		//Take a free run; with all four busy the oldest is displaced, which is
		//where this stops matching an unbounded clone chain
		r      = -1;
		oldest = 0;

		for (i = 0; i < HLENT_MM_THREADS; i++)
		{
			if (r < 0 && hl_mm[m].started[i] < 0.0)
				r = i;

			if (hl_mm[m].started[i] < hl_mm[m].started[oldest])
				oldest = i;
		}

		if (r < 0)
			r = oldest;
	}
	else
	{
		//"SetUse( NULL ); // disable use until all targets have fired",
		//triggers.cpp:449. A use arriving mid-cycle is dropped. ManagerThink
		//restores the use only once m_index has reached m_cTargets
		if (hl_mm[m].started[0] >= 0.0)
			return;

		r = 0;
	}

	hl_mm[m].fired[r]   = 0;
	hl_mm[m].started[r] = hl_ent_time;

	//one activator for the entity, where a clone carries its own m_hActivator.
	//Concurrent runs started by different activators all fire under the last
	//one. Single player has one activator, so the two agree there
	e->activator        = activator;

	HLEntSetThink(e, HLM_MULTI_MANAGER_TICK, hl_ent_time);
}

U0 HLMMTick(I64 self)
{//CMultiManager::ManagerThink, triggers.cpp:387. Walks every run in flight,
 //firing everything whose offset has come due
	CHLEntity	*e = HLEntGet(self);
	I64			 m;
	I64			 t;
	I64			 all;
	F64			 elapsed;
	F64			 due;
	F64			 soonest = -1.0;
	I64			 r;
	I64			 i;

	if (!e)
		return;

	m = HLMMFind(self);
	if (m < 0)
		return;

	//every target fired, as a mask over count bits
	all = (1 << hl_mm[m].count) - 1;

	for (r = 0; r < HLENT_MM_THREADS; r++)
	{
		if (hl_mm[m].started[r] < 0.0)
			goto qmmt_next_run;

		elapsed = hl_ent_time - hl_mm[m].started[r];

		for (i = 0; i < hl_mm[m].count; i++)
		{
			if (hl_mm[m].fired[r] & (1 << i))
				goto qmmt_next;

			if (hl_mm[m].delay[i] > elapsed)
			{
				//track the next one due so the think can be scheduled exactly.
				//Absolute, not an offset: two runs started at different times
				//have no common origin to compare offsets against
				due = hl_mm[m].started[r] + hl_mm[m].delay[i];

				if (soonest < 0.0 || due < soonest)
					soonest = due;

				goto qmmt_next;
			}

			hl_mm[m].fired[r] |= 1 << i;

			t = HLEntFindByTargetname(&hl_mm[m].name[i * 64], 0);

			while (t >= 0)
			{
				if (t != self && hl_entities[t].use_fn)
				{
					hl_entities[t].activator = e->activator;
					HLEntQueueCall(t, hl_entities[t].use_fn, e->activator,
						HLUSE_TOGGLE, 0.0, self);
				}

				t = HLEntFindByTargetname(&hl_mm[m].name[i * 64], t + 1);
			}

qmmt_next:
		}

		//"if ( m_index >= m_cTargets )". UTIL_Remove of a spent clone and the
		//SetUse that re-arms an original are the same act on a run: free it
		if (hl_mm[m].fired[r] == all)
			hl_mm[m].started[r] = -1.0;

qmmt_next_run:
	}

	if (soonest < 0.0)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	HLEntSetThink(e, HLM_MULTI_MANAGER_TICK, soonest);
}

//--- lights -----------------------------------------------------------------

U0 HLLightUse(I64 self, I64 use_type)
{//a switchable light toggles its style between "on" and "off" patterns
	CHLEntity *e = HLEntGet(self);
	Bool	   on;

	if (!e || e->style < 32)
		return;

	on = ToBool(e->toggle_state == HLTS_AT_TOP);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;
	else
		on = !on;

	if (on)
	{
		HLLightStyleSet(e->style, "m");
		e->toggle_state = HLTS_AT_TOP;
	}
	else
	{
		HLLightStyleSet(e->style, "a");
		e->toggle_state = HLTS_AT_BOTTOM;
	}
}

//--- breakable materials ----------------------------------------------------
//
// CBreakable::m_Material, func_break.h:19. The "material" key selects the shard
// noise on a hit, the burst on the break and the debris model.
//
// Shipped single-player and deathmatch maps: 759+207 wood, 542+77 metal,
// 251+21 glass, 173+1 ceiling tile, 104 cinder block, 89 rocks, 80+1 computer,
// 75+2 flesh, 26 unbreakable glass, 26 with no key at all.

#define HLMAT_GLASS			0
#define HLMAT_WOOD			1
#define HLMAT_METAL			2
#define HLMAT_FLESH			3
#define HLMAT_CINDERBLOCK	4
#define HLMAT_CEILINGTILE	5
#define HLMAT_COMPUTER		6
#define HLMAT_UNBREAKGLASS	7
#define HLMAT_ROCKS			8
#define HLMAT_NONE			9

Bool HLEntMatBreakable(I64 mat)
{//CBreakable::IsBreakable, func_break.cpp:760
	return ToBool(mat != HLMAT_UNBREAKGLASS);
}

U8 *HLEntMatShardSound(I64 mat)
{//CBreakable::DamageSound, func_break.cpp:356-430. One of the material's list,
 //played on a hit that does not kill the brush.
 //
 //A comparison chain, not a table: adjacent-literal concatenation truncates at
 //the first embedded NUL - see HLEntModelForClass.
	I64 n;

	//"if (material == matComputer && RANDOM_LONG(0,1)) material = matMetal",
	//func_break.cpp:376 - half a computer's hits sound like metal
	if (mat == HLMAT_COMPUTER && HLFxRandI(0, 1) != 0)
		mat = HLMAT_METAL;

	if (mat == HLMAT_GLASS || mat == HLMAT_UNBREAKGLASS ||
		mat == HLMAT_COMPUTER)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/glass1.wav";
		if (n == 2)	return "debris/glass2.wav";
		return "debris/glass3.wav";
	}

	if (mat == HLMAT_WOOD)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/wood1.wav";
		if (n == 2)	return "debris/wood2.wav";
		return "debris/wood3.wav";
	}

	if (mat == HLMAT_METAL)
	{
		//the SDK fills three slots and then picks over two, func_break.cpp:400
		//- metal2.wav is unreachable. Reproduced as written
		n = HLFxRandI(1, 2);
		if (n == 1)	return "debris/metal1.wav";
		return "debris/metal3.wav";
	}

	if (mat == HLMAT_FLESH)
	{
		n = HLFxRandI(1, 6);
		if (n == 1)	return "debris/flesh1.wav";
		if (n == 2)	return "debris/flesh2.wav";
		if (n == 3)	return "debris/flesh3.wav";
		if (n == 4)	return "debris/flesh5.wav";
		if (n == 5)	return "debris/flesh6.wav";
		return "debris/flesh7.wav";
	}

	if (mat == HLMAT_ROCKS || mat == HLMAT_CINDERBLOCK)
	{
		n = HLFxRandI(1, 3);
		if (n == 1)	return "debris/concrete1.wav";
		if (n == 2)	return "debris/concrete2.wav";
		return "debris/concrete3.wav";
	}

	//matCeilingTile and matNone have no shard list
	return NULL;
}

U8 *HLEntMatBreakSound(I64 mat)
{//CBreakable::Die's material switch, func_break.cpp:605-667
	if (mat == HLMAT_GLASS)
	{
		if (HLFxRandI(0, 1))	return "debris/bustglass2.wav";
		return "debris/bustglass1.wav";
	}

	if (mat == HLMAT_WOOD)
	{
		if (HLFxRandI(0, 1))	return "debris/bustcrate2.wav";
		return "debris/bustcrate1.wav";
	}

	if (mat == HLMAT_METAL || mat == HLMAT_COMPUTER)
	{
		if (HLFxRandI(0, 1))	return "debris/bustmetal2.wav";
		return "debris/bustmetal1.wav";
	}

	if (mat == HLMAT_FLESH)
	{
		if (HLFxRandI(0, 1))	return "debris/bustflesh2.wav";
		return "debris/bustflesh1.wav";
	}

	if (mat == HLMAT_ROCKS || mat == HLMAT_CINDERBLOCK)
	{
		if (HLFxRandI(0, 1))	return "debris/bustconcrete2.wav";
		return "debris/bustconcrete1.wav";
	}

	if (mat == HLMAT_CEILINGTILE)
		return "debris/bustceiling.wav";

	//matUnbreakableGlass and matNone fall out of the switch silent
	return NULL;
}

U0 HLEntSoundDyn(I64 self, U8 *path, I64 channel, F64 volume, I64 pitch)
{//EMIT_SOUND_DYN at the entity's own centre - HLEntSound with the volume and
 //pitch the break path varies, and on the brush's own channel rather than the
 //world's. entnum is index+1, the convention HLAI.ZC's speech uses
	CHLEntity	*e = HLEntGet(self);
	F64			 centre[3];
	I64			 i;

	if (!e || !path || !path[0])
		return;

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	HLSndPlayAt(path, centre, volume, HLENT_SND_ATTEN, self + 1, channel,
		pitch);
}

Bool HLEntIsBreakableBrush(CHLEntity *e)
{//HLBreakableDie is the death path for monsters as well - see the note at the
 //head of HLAI.ZC - and only the brush classes take material treatment
	if (!StrCompare(e->classname, "func_breakable"))
		return TRUE;

	return ToBool(!StrCompare(e->classname, "func_pushable"));
}

//--- damage -----------------------------------------------------------------
//
// CBaseEntity::TakeDamage, reduced to what the brush entities need. Monsters
// and the player go through their own paths.

#define HLDMG_TAKE_NO		0
#define HLDMG_TAKE_YES		1
#define HLDMG_TAKE_AIM		2	//only a direct hit, not splash

U0 HLEntTakeDamageType(I64 self, I64 attacker, F64 damage, I64 bits)
{//health down, and the Killed path once it runs out. bits is a HLDMG_* mask;
 //CBreakable::TakeDamage scales by it, func_break.cpp:550-559
	CHLEntity	*e = HLEntGet(self);
	Bool		 brush;
	I64			 pitch;

	if (!e || damage <= 0.0)
		return;

	if (e->takedamage == HLDMG_TAKE_NO)
		return;

	brush = HLEntIsBreakableBrush(e);

	if (brush)
	{
		//unbreakable glass absorbs everything, func_break.cpp:550
		if (!HLEntMatBreakable(e->material))
			return;

		//"Breakables take double damage from the crowbar", func_break.cpp:554
		if (bits & HLDMG_CLUB)
			damage *= 2.0;

		//a crossbow dart's poison counts for a tenth, func_break.cpp:558
		if (bits & HLDMG_POISON)
			damage *= 0.1;
	}

	e->health -= damage;

	if (e->health > 0.0)
	{
		//"Make a shard noise each time func breakable is hit", func_break.cpp:576
		if (brush)
		{
			//func_break.cpp:368-371: two hits in three at the recorded rate,
			//the third somewhere in 95..129
			pitch = HLPITCH_NORM;
			if (HLFxRandI(0, 2) == 0)
				pitch = 95 + HLFxRandI(0, 34);

			HLEntSoundDyn(self, HLEntMatShardSound(e->material),
				HLENT_CHAN_VOICE, HLFxRandF(0.75, 1.0), pitch);
		}

		return;
	}

	//The death path reads the mask and the overkill from the note: health is
	//clamped below, and HLDmgHurt lives in HLAI which compiles after this file.
	HLDmgNote(self, bits, e->health);

	//dead. the break is queued rather than run here so a chain of breakables
	//taking splash damage cannot recurse
	e->health    = 0.0;
	e->activator = attacker;

	HLEntQueueCall(self, HLM_BREAK_DIE, attacker, HLUSE_TOGGLE, 0.0);
}

U0 HLEntTakeDamage(I64 self, I64 attacker, F64 damage)
{//untyped damage. Callers that know the weapon use HLEntTakeDamageType
	HLEntTakeDamageType(self, attacker, damage, HLDMG_GENERIC);
}

U8 *HLEntMatGibModel(I64 mat)
{//CBreakable::Die's shard model, func_break.cpp:284-341
	if (mat == HLMAT_WOOD)
		return "models/woodgibs.mdl";

	if (mat == HLMAT_METAL)
		return "models/metalplategibs.mdl";

	if (mat == HLMAT_FLESH)
		return "models/fleshgibs.mdl";

	if (mat == HLMAT_CINDERBLOCK)
		return "models/cindergibs.mdl";

	if (mat == HLMAT_CEILINGTILE)
		return "models/ceilinggibs.mdl";

	if (mat == HLMAT_COMPUTER)
		return "models/computergibs.mdl";

	if (mat == HLMAT_ROCKS)
		return "models/rockgibs.mdl";

	//GLASS and UNBREAKGLASS share one set
	return "models/glassgibs.mdl";
}

U0 HLBreakableDie(I64 self)
{//CBreakable::Die - the material burst, then fire the target and stop existing
	CHLEntity	*e = HLEntGet(self);
	U8			*drop;
	F64			 centre[3];
	F64			 fvol;
	I64			 pitch;
	I64			 i;

	if (!e)
		return;

	if (HLEntIsBreakableBrush(e))
	{
		//func_break.cpp:591-593. 95..124, snapped to 100 across the middle
		pitch = 95 + HLFxRandI(0, 29);
		if (pitch > 97 && pitch < 103)
			pitch = 100;

		//"The more negative pev->health, the louder", func_break.cpp:599.
		//health is clamped to zero before the break is queued, so overkill no
		//longer reaches here and this is the 0.85..1.0 base alone
		fvol = HLFxRandF(0.85, 1.0);

		HLEntSoundDyn(self, HLEntMatBreakSound(e->material), HLENT_CHAN_VOICE,
			fvol, pitch);

		//TE_BREAKMODEL. The gib pool is aged on the render clock, so tS and
		//not hl_ent_time. Velocity is zero: expDirected needs the attack
		//direction, which the queued break no longer carries.
		HLGibSpawnDebris(e->absmin, e->size, NULL, 8,
			HLEntMatGibModel(e->material), tS);
	}
	else
	{
		//CHAN_STATIC, doors.cpp:619
		HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);
	}

	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);

	e->solid = HLSOLID_NOT;

	//"if ( m_iszSpawnObject ) CBaseEntity::Create(...)", func_break.cpp:748.
	//VecBModelOrigin is the brush centre, not pev->origin, which for a brush
	//entity sits at the map origin
	drop = HLEntSpawnObjectClass(e->spawn_object);

	if (drop)
	{
		for (i = 0; i < 3; i++)
			centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

		HLEntCreateNamed(drop, centre, e->angles, self);
	}

	//a breakable with a delay key deferred its fire onto its own think, so the
	//slot has to outlive the break - see HLM_AUTO_THINK
	if (e->think_fn == HLM_FIRE_TARGETS)
	{
		e->remove_after_fire = TRUE;
		return;
	}

	//CBaseEntity::UpdateOnRemove, subs.cpp:109. 204 func_breakable and 50
	//func_pushable carry a globalname; this is what keeps a smashed crate
	//smashed when the chapter loops back through the map
	HLEntGlobalNameDied(e);

	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

//--- trigger effects --------------------------------------------------------
//
// The effect on whatever touched the volume, beyond firing its target.

//CBaseTrigger::HurtTouch spawnflags, dlls/triggers.cpp:32-36. START_OFF is
//consumed by the spawn, the rest are read on touch
#define HLSF_HURT_TARGETONCE		1
#define HLSF_HURT_START_OFF		2
#define HLSF_HURT_NO_CLIENTS		8
#define HLSF_HURT_CLIENTONLYFIRE	16
#define HLSF_HURT_CLIENTONLYTOUCH	32

U0 HLHurtTouch(I64 self, I64 other)
{//CBaseTrigger::HurtTouch, dlls/triggers.cpp:914. The player is the only
 //toucher this port routes here, so the CLIENTONLYTOUCH and multiplayer
 //per-player masks collapse away and NO_CLIENTS means "never fires"
	CHLEntity	*e = HLEntGet(self);
	F64			 dmg;

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	//SF_TRIGGER_HURT_NO_CLIENTS, dlls/triggers.cpp:927
	if (e->spawnflags & HLSF_HURT_NO_CLIENTS)
		return;

	if (e->pain_finished > hl_ent_time)
		return;

	e->pain_finished = hl_ent_time + 0.5;

	//"fldmg = pev->dmg * 0.5; // 0.5 seconds worth of damage, pev->dmg is
	//damage/second", dlls/triggers.cpp:1001. The dmg key is a rate per second
	//and the trigger fires twice a second, so the half is not optional.
	//
	//The damagetype switch below that line is #if 0 in the shipped SDK, so
	//radiation and poison volumes deal their plain dmg rate like any other.
	dmg = e->dmg * 0.5;

	//a negative dmg heals - TakeHealth(-fldmg), dlls/triggers.cpp:1015
	if (dmg < 0.0)
	{
		hl_ent_player_health -= dmg;

		if (hl_ent_player_health > 100.0)
			hl_ent_player_health = 100.0;
	}
	else
		HLEntHurtPlayer(dmg);

	if (!e->target[0])
		return;

	//SF_TRIGGER_HURT_CLIENTONLYFIRE gates the target on the toucher being a
	//client; the player is the only toucher here, so it never blocks
	HLEntUseTargets(self, other, HLUSE_TOGGLE, 0.0);

	//SF_TRIGGER_HURT_TARGETONCE clears pev->target, dlls/triggers.cpp:1042
	if (e->spawnflags & HLSF_HURT_TARGETONCE)
		e->target[0] = 0;
}

U0 HLPushTouch(I64 self)
{//trigger_push. speed along the movedir, added to the toucher's velocity
 //rather than replacing it, so a conveyor and a jump compose
	CHLEntity *e = HLEntGet(self);
	F64		   speed;
	I64		   i;

	if (!e)
		return;

	speed = e->speed;
	if (speed == 0.0)
		speed = 100.0;

	for (i = 0; i < 3; i++)
		hl_ent_push_vel[i] = e->move_dir[i] * speed;

	hl_ent_push_pending = TRUE;
}

U0 HLTeleportTouch(I64 self)
{//trigger_teleport. the destination is an info_teleport_destination named by
 //the trigger's target, so this consumes the target rather than firing it
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*dst;
	I64			 t;

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	t = HLEntFindByTargetname(e->target, 0);
	if (t < 0)
		return;

	dst = &hl_entities[t];

	HLVecCopy(dst->origin, hl_ent_teleport_to);

	//HL drops the player to the destination's feet plus one unit of clearance
	hl_ent_teleport_to[2] -= HLPHYS_MINS_Z;
	hl_ent_teleport_to[2] += 1.0;

	hl_ent_teleport_pending = TRUE;
}

//--- rotating doors ---------------------------------------------------------
//
// CRotDoor. A func_door whose travel is in degrees about one axis instead of
// along a vector: the state machine below is HLDoor* with HLEntCalcMove swapped
// for HLEntCalcAngleMove.
//
// A separate set of methods rather than a flag inside the linear ones, because
// the arrival snaps angles; a wrong branch there snaps the origin to a stale
// finaldest instead.
//
// The axis spawnflag bits are the door's, 64 and 128, not func_rotating's 4 and
// 8. Sharing one table starts every door on the wrong axis.
#define HLSF_DOOR_ROTATE_BACKWARDS	2
#define HLSF_DOOR_ROTATE_Z			64		//roll, turns about world X
#define HLSF_DOOR_ROTATE_X			128		//pitch, turns about world Y

U0 HLRotDoorGoUp(I64 self, I64 activator)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->toggle_state == HLTS_GOING_UP || e->toggle_state == HLTS_AT_TOP)
		return;

	e->toggle_state = HLTS_GOING_UP;
	e->activator    = activator;

	//CHAN_STATIC, doors.cpp:576
	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	HLEntCalcAngleMove(e, e->angle2, e->speed, HLM_ROT_DOOR_HIT_TOP);
}

U0 HLRotDoorGoDown(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	e->toggle_state = HLTS_GOING_DOWN;

	//CHAN_STATIC, doors.cpp:576
	HLEntSound(self, e, HLEntDoorMoveSound(e->move_snd), HLCHAN_STATIC);

	HLEntCalcAngleMove(e, e->angle1, e->speed, HLM_ROT_DOOR_HIT_BOTTOM);
}

U0 HLRotDoorHitTop(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_TOP;

	//CHAN_STATIC, doors.cpp:619
	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);

	if (e->spawnflags & HLSF_DOOR_TOGGLE)
	{
		//doors.cpp:630
		if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
			HLDoorTouchLatch(e, TRUE);

		goto qrdht_fire;
	}

	if (e->wait < 0.0)
		goto qrdht_fire;

	HLEntSetThink(e, HLM_ROT_DOOR_GO_DOWN, hl_ent_time + e->wait);

qrdht_fire:
	HLEntUseTargets(self, e->activator, HLUSE_TOGGLE, 0.0);
}

U0 HLRotDoorHitBottom(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	e->toggle_state = HLTS_AT_BOTTOM;

	//doors.cpp:695
	if (!(e->spawnflags & HLSF_DOOR_USE_ONLY))
		HLDoorTouchLatch(e, TRUE);

	//CHAN_STATIC, doors.cpp:619
	HLEntSound(self, e, HLEntDoorStopSound(e->stop_snd), HLCHAN_STATIC);
}

Bool HLRotDoorUseLeaf(I64 self, I64 activator)
{//CBaseDoor::Use then DoorActivate on one swinging leaf, with no group fan
 //out. Same gate as HLDoorUseLeaf; CRotDoor inherits both methods
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return FALSE;

	if (e->toggle_state != HLTS_AT_BOTTOM &&
		!(e->toggle_state == HLTS_AT_TOP &&
		  (e->spawnflags & HLSF_DOOR_TOGGLE)))
		return FALSE;

	if (!HLEntMasterAllows(e))
		return FALSE;

	if (e->toggle_state == HLTS_AT_TOP)
	{
		HLRotDoorGoDown(self);
		return TRUE;
	}

	HLEntPlayLockSounds(self, e, FALSE, FALSE);

	HLRotDoorGoUp(self, activator);

	return TRUE;
}

U0 HLRotDoorTouch(I64 self, I64 activator)
{//CRotDoor inherits CBaseDoor::DoorTouch, doors.cpp:872 - same gate, same
 //latch, the swinging mover
	CHLEntity *e = HLEntGet(self);

	if (!HLDoorTouchAllows(self, e))
		return;

	if (HLRotDoorUseLeaf(self, activator))
		HLDoorTouchLatch(e, FALSE);
}

U0 HLRotDoorUse(I64 self, I64 activator)
{//CBaseDoor::Use - one leaf. HLDoorUseGroup carries the +use fan out for both
 //door classes
	HLRotDoorUseLeaf(self, activator);
}

//--- a blocked door ---------------------------------------------------------
//
// CBaseDoor::Blocked, reached through blocked_fn from HLEntFrame's mover pass.
// Both door classes share it; which one a leaf is comes off use_fn, as in
// HLM_DOOR_LEAF. Defined here rather than beside the other door methods
// because it drives the swinging movers as well.

U0 HLDoorReverse(I64 self)
{//turn one leaf around mid-travel
 //
 //the activator is whoever opened the door, not whoever is standing in it, so
 //it is carried through rather than replaced
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->use_fn == HLM_ROT_DOOR_USE)
	{
		if (e->toggle_state == HLTS_GOING_DOWN)
			HLRotDoorGoUp(self, e->activator);
		else
			HLRotDoorGoDown(self);

		return;
	}

	if (e->toggle_state == HLTS_GOING_DOWN)
		HLDoorGoUp(self, e->activator);
	else
		HLDoorGoDown(self);
}

U0 HLDoorBlocked(I64 self, I64 blocker)
{//CBaseDoor::Blocked. blocker is an entity index, -1 for the player, the
 //numbering HLAITargetIsPlayer uses
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	F64			 svel[3];
	F64			 savel[3];
	F64			 dv[3];
	F64			 da[3];
	Bool		 together;
	I64			 peer;
	I64			 j;

	if (!e)
		return;

	//dmg is per block. trigger_hurt reads the same field as a rate, which is
	//that class's own reading of it
	if (e->dmg > 0.0)
	{
		if (blocker < 0)
			HLEntHurtPlayer(e->dmg, HLDMG_CRUSH);
		else
			HLEntTakeDamageType(blocker, self, e->dmg, HLDMG_CRUSH);
	}

	//a negative wait never comes back, so the door squashes instead of
	//reversing
	if (e->wait < 0.0)
		return;

	//the travel this leaf was on, read before the reversal replaces it: the
	//peer test below is "was moving with me"
	HLVecCopy(e->velocity, svel);
	HLVecCopy(e->avelocity, savel);

	HLDoorReverse(self);

	//The group is by targetname only here. HLDoorGroupNext falls back to
	//touching bounds for an unnamed door; CBaseDoor::Blocked does not, and two
	//independent doors sharing a frame would reverse each other.
	if (!e->targetname[0])
		return;

	peer = HLDoorGroupNext(self, 0);

	while (peer >= 0)
	{
		o = HLEntGet(peer);

		if (!o || o->wait < 0.0)
			goto qdb_next;

		//A peer travelling with this leaf is realigned onto it, so a double
		//door does not reverse out of step.
		//
		//Two deviations from the SDK, which compares the peer's avelocity
		//against this door's velocity and reads its own velocity after the
		//reversal has already overwritten it. Either one alone leaves every
		//peer unaligned.
		together = TRUE;

		HLVecSub(o->velocity, svel, dv);
		HLVecSub(o->avelocity, savel, da);

		for (j = 0; j < 3; j++)
		{
			if (!HLIsZeroF(dv[j]) || !HLIsZeroF(da[j]))
				together = FALSE;
		}

		if (together)
		{
			if (o->use_fn == HLM_ROT_DOOR_USE)
			{
				HLVecCopy(e->angles, o->angles);
				HLVecSet(o->avelocity, 0.0, 0.0, 0.0);
			}
			else
			{
				HLVecCopy(e->origin, o->origin);
				HLVecSet(o->velocity, 0.0, 0.0, 0.0);
			}

			HLEntSetAbsBox(o);
		}

		//direct, not queued: both movers are defined above, and the realign
		//has to be the reversal's starting point. HLDoorReverse does not fan
		//out, so the group costs one pass
		HLDoorReverse(peer);

qdb_next:
		peer = HLDoorGroupNext(self, peer + 1);
	}
}

U0 HLPlatBlocked(I64 self, I64 blocker)
{//CFuncPlat::Blocked - a lift never crushes, it goes back where it came from
 //
 //One point of damage, not pev->dmg: a plat's dmg key is not a crush value
 //and the SDK hurts the blocker "a little" regardless of it
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (blocker < 0)
		HLEntHurtPlayer(1.0, HLDMG_CRUSH);
	else
		HLEntTakeDamageType(blocker, self, 1.0, HLDMG_CRUSH);

	//the travel is the door mover's, so the reversal is too. A plat blocked
	//while parked has no direction to reverse and is left alone
	if (e->toggle_state == HLTS_GOING_UP)
		HLDoorGoDown(self);
	else if (e->toggle_state == HLTS_GOING_DOWN)
		HLDoorGoUp(self, e->activator);
}

//how long a train waits before it can crush the same blocker again -
//CFuncTrain's m_flActivateFinished
#define HLENT_TRAIN_CRUSH_WAIT	0.5

U0 HLTrainBlocked(I64 self, I64 blocker)
{//CFuncTrain::Blocked - a train does not stop and does not reverse, it grinds
 //
 //CFuncTrackTrain::Blocked shares the damage and adds a shove away from the
 //train. The shove is not ported: a rider is already carried by base velocity
 //and anything else in the way is a monster this pass cannot push.
 //
 //The rate limit covers both classes. The SDK gates only func_train, because
 //its Blocked is reached once per touch; here the mover pass asks every tick,
 //and an ungated dmg 100 tram kills through a wall in three
	CHLEntity *e = HLEntGet(self);

	if (!e || e->dmg <= 0.0)
		return;

	if (hl_ent_time < e->pain_finished)
		return;

	e->pain_finished = hl_ent_time + HLENT_TRAIN_CRUSH_WAIT;

	if (blocker < 0)
		HLEntHurtPlayer(e->dmg, HLDMG_CRUSH);
	else
		HLEntTakeDamageType(blocker, self, e->dmg, HLDMG_CRUSH);
}

//--- func_rotating ----------------------------------------------------------
//
// CFuncRotating: fans, turbines, the odd rotating platform. Its own spawnflag
// table, which overlaps the door's numerically and means something else.
#define HLSF_ROTATE_INSTANT		1
#define HLSF_ROTATE_BACKWARDS	2
#define HLSF_ROTATE_Z_AXIS		4		//roll
#define HLSF_ROTATE_X_AXIS		8		//pitch
#define HLSF_ROTATE_ACCDCC		16
#define HLSF_ROTATE_HURT			32
#define HLSF_ROTATE_NOT_SOLID	64

//dlls/util.h:407-409. Radius selectors for the running noise, not booleans
#define HLSF_ROTATE_SMALLRADIUS	128
#define HLSF_ROTATE_MEDIUMRADIUS	256
#define HLSF_ROTATE_LARGERADIUS	512

U8 *HLEntFanSound(I64 n)
{//CFuncRotating::Precache. a comparison chain for the reason given in
 //HLEntModelForClass
	if (n == 1)		return "fans/fan1.wav";
	if (n == 2)		return "fans/fan2.wav";
	if (n == 3)		return "fans/fan3.wav";
	if (n == 4)		return "fans/fan4.wav";
	if (n == 5)		return "fans/fan5.wav";

	return NULL;
}

U0 HLFanVoiceTick(I64 self, CHLEntity *e)
{//One tick of a func_rotating's running noise. CFuncRotating::RampPitchVol,
 //dlls/bmodels.cpp:520, folded into HLSndFanLoop: the pitch and volume both
 //track current over target angular speed.
	F64	 cur;
	F64	 target;
	F64	 vol;
	F64	 centre[3];
	U8	*snd;
	I64	 j;

	if (self < 0 || self >= HLENT_MAX)
		return;

	snd = HLEntFanSound(e->snd_index);

	if (!snd)
	{
		HLSndFanStop(&hl_fan_voice[self], &hl_fan_pitch[self]);
		return;
	}

	//movedir is a unit axis, so |avelocity| and |speed| are the two magnitudes
	//RampPitchVol compares component by component
	cur    = HLVecLength(e->avelocity);
	target = HLEntAbsF(e->speed);

	//func_rotating's "volume" is 0-10, like ambient_generic's
	vol = e->volume;
	if (vol > 1.0)
		vol = vol / 10.0;
	if (vol <= 0.0 || vol > 1.0)
		vol = 1.0;

	for (j = 0; j < 3; j++)
		centre[j] = e->origin[j] + (e->mins[j] + e->maxs[j]) * 0.5;

	HLSndFanLoop(&hl_fan_voice[self], &hl_fan_pitch[self], snd, centre,
		vol, e->fan_atten, cur, target);
}

//--- ambient_generic --------------------------------------------------------
//
// CAmbientGeneric. The spawnflag bits are radius selectors, not booleans:
//
//   1   PLAYEVERYWHERE   ATTN_NONE, non positional
//   2   SMALLRADIUS      ATTN_IDLE   2.0
//   4   MEDIUMRADIUS     ATTN_STATIC 1.25
//   8   LARGERADIUS      ATTN_NORM   0.8
//   16  START_SILENT     waits for a trigger
//   32  NOT_LOOPING      one shot per trigger
//
// Reading bit 0 as START_SILENT and bit 1 as NOT_LOOPING drops every ambient a
// map marked PLAYEVERYWHERE or SMALLRADIUS, which is most of them.
#define HLSF_AMBIENT_EVERYWHERE		1
#define HLSF_AMBIENT_SMALLRADIUS		2
#define HLSF_AMBIENT_MEDIUMRADIUS	4
#define HLSF_AMBIENT_LARGERADIUS		8
#define HLSF_AMBIENT_START_SILENT	16
#define HLSF_AMBIENT_NOT_LOOPING		32

//SPEAKER_START_SILENT, dlls/util.h:386. A different entity and a different
//bit: "wait for trigger 'on' to start announcements"
#define HLSF_SPEAKER_START_SILENT	1

F64 HLAmbientVolume(CHLEntity *e)
{//"health" is 0-10.
	F64 vol = e->health / 10.0;

	if (vol <= 0.0)
		vol = 1.0;
	if (vol > 1.0)
		vol = 1.0;

	return vol;
}

F64 HLAmbientAtten(CHLEntity *e)
{//CAmbientGeneric::Spawn's m_flAttenuation ladder, first bit set wins.
	if (e->spawnflags & HLSF_AMBIENT_EVERYWHERE)
		return 0.0;
	if (e->spawnflags & HLSF_AMBIENT_SMALLRADIUS)
		return 2.0;
	if (e->spawnflags & HLSF_AMBIENT_MEDIUMRADIUS)
		return 1.25;
	if (e->spawnflags & HLSF_AMBIENT_LARGERADIUS)
		return 0.8;

	//No radius bit: ATTN_STATIC, the same as MEDIUMRADIUS.
	return 1.25;
}

U0 HLAmbientUse(I64 self, I64 use_type, F64 value)
{//CAmbientGeneric::ToggleUse, dlls/sound.cpp:512.
 //
 //A looping source is registered once at spawn and toggled in place.
 //HLSndAmbientRemove is not used: it swaps the last slot down over this one,
 //which renumbers every slot after it and discards the dynpitchvol_t the
 //envelopes and the LFO run out of.
 //
 //A non-looping source is issued directly. Registering it would leave it inert
 //- HLSndAmbientUpdate only plays entries whose active flag is set, and
 //HLSndAmbientToggle clears that for a one-shot.
	CHLEntity	*e = HLEntGet(self);
	F64			 centre[3];
	I64			 slot;
	I64			 i;
	Bool		 on;

	if (!e || !e->message[0])
		return;

	if (e->spawnflags & HLSF_AMBIENT_NOT_LOOPING)
	{
		//PLAYEVERYWHERE sounds are not positional; the mixer takes that as
		//attenuation 0, so the origin is only used for panning it ignores.
		for (i = 0; i < 3; i++)
			centre[i] = e->origin[i];

		HLSndPlayAt(e->message, centre, HLAmbientVolume(e),
			HLAmbientAtten(e), self + 1, HLENT_CHAN_VOICE);
		return;
	}

	slot = HLSndAmbientFind(e->message, e->origin);
	if (slot < 0)
		return;

	on = HLSndAmbientActive(slot);

	//"ignore if we're just turning something on that's already on"
	if (use_type == HLUSE_ON && on)
		return;
	if (use_type == HLUSE_OFF && !on)
		return;

	//"Directly change pitch if arg passed. Only works if sound is already
	//playing", sound.cpp:521. momentary_rot_button is the only sender
	if (use_type == HLUSE_SET)
	{
		if (on)
			HLSndAmbientSetPitch(slot, value);

		return;
	}

	HLSndAmbientToggle(slot, !on, hl_ent_time);
}

U0 HLSpeakerUse(I64 self, I64 use_type)
{//CSpeaker::ToggleUse, dlls/sound.cpp:1923. A pending announcement is cancelled,
 //no pending announcement starts one
	I64		slot = HLSndSpeakerSlotFor(self);
	Bool	active;

	if (slot < 0)
		return;

	active = HLSndSpeakerPending(slot);

	//"ignore if we're just turning something on that's already on, or turning
	//something off that's already off"
	if (use_type != HLUSE_TOGGLE)
	{
		if (active && use_type == HLUSE_ON)
			return;

		if (!active && use_type == HLUSE_OFF)
			return;
	}

	if (use_type == HLUSE_ON)
	{
		HLSndSpeakerSetNext(slot, hl_ent_time + 0.1);
		return;
	}

	if (use_type == HLUSE_OFF)
	{
		HLSndSpeakerSetNext(slot, 0.0);
		return;
	}

	HLSndSpeakerToggle(slot, hl_ent_time);
}

//CFuncRotating::SpinUp and SpinDown reschedule on a fixed tenth,
//dlls/bmodels.cpp:588 and :620. The step per think is movedir * speed *
//fanfriction, so the constant and the step size go together.
#define HLENT_ROTATE_STEP	0.1

U0 HLRotatingSpinUp(I64 self)
{//CFuncRotating::SpinUp, dlls/bmodels.cpp:585
	CHLEntity	*e = HLEntGet(self);
	F64			 target;
	Bool		 done;
	I64			 j;

	if (!e)
		return;

	for (j = 0; j < 3; j++)
		e->avelocity[j] += e->move_dir[j] * e->speed * e->fan_friction;

	//"if we've met or exceeded target speed" - per axis, against the same axis
	//of movedir * speed
	done = TRUE;

	for (j = 0; j < 3; j++)
	{
		target = e->move_dir[j] * e->speed;

		if (HLEntAbsF(e->avelocity[j]) < HLEntAbsF(target))
			done = FALSE;
	}

	if (done)
	{
		//"set speed in case we overshot"
		HLVecScale(e->move_dir, e->speed, e->avelocity);
		return;
	}

	HLEntSetThink(e, HLM_ROTATE_SPIN_UP, hl_ent_time + HLENT_ROTATE_STEP);
}

U0 HLRotatingSpinDown(I64 self)
{//CFuncRotating::SpinDown, dlls/bmodels.cpp:615
	CHLEntity	*e = HLEntGet(self);
	F64			 dir;
	Bool		 done;
	I64			 j;

	if (!e)
		return;

	for (j = 0; j < 3; j++)
		e->avelocity[j] -= e->move_dir[j] * e->speed * e->fan_friction;

	//the sign of the spin axis decides which way the crossing is tested
	dir = e->move_dir[2];

	if (e->move_dir[0] != 0.0)
		dir = e->move_dir[0];
	else if (e->move_dir[1] != 0.0)
		dir = e->move_dir[1];

	done = FALSE;

	if (dir > 0.0 && e->avelocity[0] <= 0.0 && e->avelocity[1] <= 0.0 &&
		e->avelocity[2] <= 0.0)
		done = TRUE;

	if (dir < 0.0 && e->avelocity[0] >= 0.0 && e->avelocity[1] >= 0.0 &&
		e->avelocity[2] >= 0.0)
		done = TRUE;

	if (done)
	{
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		return;
	}

	HLEntSetThink(e, HLM_ROTATE_SPIN_DOWN, hl_ent_time + HLENT_ROTATE_STEP);
}

U0 HLRotatingUse(I64 self, I64 use_type)
{//CFuncRotating::RotatingUse, dlls/bmodels.cpp:660
 //
 //toggle_state is the port's "is it meant to be running": the fan loop and the
 //next use both read it, and avelocity alone cannot answer while a ramp is
 //part way through.
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = ToBool(e->toggle_state == HLTS_AT_TOP);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;
	else
		on = !on;

	if (on)
		e->toggle_state = HLTS_AT_TOP;
	else
		e->toggle_state = HLTS_AT_BOTTOM;

	//SF_BRUSH_ACCDCC, bmodels.cpp:30: ease in and out over fanfriction rather
	//than snapping to speed
	if (e->spawnflags & HLSF_ROTATE_ACCDCC)
	{
		//"pev->nextthink = pev->ltime + 0.1": the first increment lands a tenth
		//after the press, not on it
		if (on)
			HLEntSetThink(e, HLM_ROTATE_SPIN_UP,
				hl_ent_time + HLENT_ROTATE_STEP);
		else
			HLEntSetThink(e, HLM_ROTATE_SPIN_DOWN,
				hl_ent_time + HLENT_ROTATE_STEP);

		return;
	}

	//a snap start cancels a ramp left running by a previous use
	HLEntSetThink(e, HLM_NONE, 0.0);

	if (on)
		HLVecScale(e->move_dir, e->speed, e->avelocity);
	else
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
}

//--- func_pendulum ----------------------------------------------------------
//
// CPendulum. Not a sine wave: the SDK integrates a constant angular
// acceleration towards the centre of the swing and clamps at maxspeed, so a
// pendulum overshoots and settles. Reproduced as an integrator.
#define HLSF_PENDULUM_SWING			2	//rope, hurts on touch
#define HLSF_PENDULUM_AUTO_RETURN	16

//the SDK reruns Swing on a fixed 0.1s think rather than every frame, and the
//integration constant is tuned to that step
#define HLENT_PENDULUM_STEP			0.1

U0 HLPendulumSwing(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 delta;

	if (!e)
		return;

	//distance of the current angle from the middle of the swing. accelerate
	//towards it, so the sign of delta is the sign of the force
	delta = HLEntAxisDelta(e, e->angles, e->angle2);

	if (delta > 0.0 && e->height > 0.0)
		e->momentary_frac -= e->height * HLENT_PENDULUM_STEP;
	else
		e->momentary_frac += e->height * HLENT_PENDULUM_STEP;

	//momentary_frac is the signed angular speed here; a pendulum is never also
	//a momentary button
	if (e->momentary_frac > e->speed)
		e->momentary_frac = e->speed;
	else if (e->momentary_frac < -e->speed)
		e->momentary_frac = -e->speed;

	HLVecScale(e->move_dir, e->momentary_frac, e->avelocity);

	//"damp" bleeds the swing away. absent means it never settles, which is what
	//machinery wants
	if (e->damp > 0.0)
		e->momentary_frac -= e->damp * e->momentary_frac * HLENT_PENDULUM_STEP;

	HLEntSetThink(e, HLM_PENDULUM_SWING, hl_ent_time + HLENT_PENDULUM_STEP);
}

U0 HLPendulumUse(I64 self)
{//a stopped pendulum starts, a swinging one freezes where it is
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->think_fn == HLM_PENDULUM_SWING)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
		return;
	}

	e->momentary_frac = 0.0;
	HLPendulumSwing(self);
}

//--- momentary_door / momentary_rot_button ----------------------------------
//
// The only classes in HL that carry a position rather than a state. The button
// turns while +use is held and passes its fraction to the door as USE_SET; the
// door parks proportionally, which is how the c1a3 pipe valves work.
//
// FCAP_CONTINUOUS_USE, buttons.cpp:888: the button turns for as long as IN_USE
// is down, at pev->speed degrees a second over m_flMoveDistance. HLEntUseInFront
// takes a held flag and re-fires this class every tick while the key is down.
// An edge press with no held follow-up still ratchets one step, so a shell that
// only delivers edges reaches the same end position in steps.
#define HLSF_MOMENTARY_DOOR		1	//"door hurts" / not solid, per class
#define HLENT_MOMENTARY_STEP		0.125

U0 HLMomentaryDoorUse(I64 self, I64 use_type, F64 value)
{//CMomentaryDoor::Use - only USE_SET means anything, everything else is a
 //button press arriving at a class that has no on/off
	CHLEntity	*e = HLEntGet(self);
	F64			 delta[3];

	if (!e || use_type != HLUSE_SET)
		return;

	if (value < 0.0)
		value = 0.0;
	if (value > 1.0)
		value = 1.0;

	e->momentary_frac = value;

	HLVecSub(e->position2, e->position1, delta);
	HLVecMA(e->position1, value, delta, e->origin);

	HLVecSet(e->velocity, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);
}

U0 HLMomentaryRotUse(I64 self, I64 activator, Bool held = FALSE)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 delta[3];
	F64			 step;
	Bool		 first;
	I64			 t;

	if (!e)
		return;

	e->activator = activator;

	//CMomentaryRotButton::UpdateSelf plays the cue on the 0->1 edge of
	//m_lastUsed, buttons.cpp:1029. A gap in the stamp is a released key
	first      = ToBool(hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP);
	e->use_last = hl_ent_time;

	step = HLENT_MOMENTARY_STEP;

	if (held)
	{
		//pev->speed degrees a second across m_flMoveDistance degrees of
		//travel, CMomentaryRotButton::Use. Below a degree of travel the
		//fraction is meaningless, so the ratchet stands in
		if (e->distance >= 1.0 && e->speed > 0.0)
			step = e->speed * hl_ent_frame_dt / e->distance;
	}

	e->momentary_frac += step;
	if (e->momentary_frac > 1.0)
		e->momentary_frac = 1.0;

	//interpolate the angle rather than spin to it: the fraction is the state,
	//and an in-flight angular move would fight the next press
	HLVecSub(e->angle2, e->angle1, delta);
	HLVecMA(e->angle1, e->momentary_frac, delta, e->angles);

	HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);

	if (first)
		HLEntSound(self, e, HLEntButtonSound(e->snd_index), HLCHAN_VOICE);

	//CMomentaryRotButton::UpdateTarget - the value reaches the target as a SET
	//with a magnitude, unlike every other class. SUB_UseTargets cannot carry
	//that, so the chain is walked here
	if (!e->target[0])
		return;

	t = HLEntFindByTargetname(e->target, 0);

	while (t >= 0)
	{
		if (t != self && hl_entities[t].use_fn)
		{
			hl_entities[t].activator = activator;
			HLEntQueueCall(t, hl_entities[t].use_fn, activator, HLUSE_SET,
				e->momentary_frac);
		}

		t = HLEntFindByTargetname(e->target, t + 1);
	}
}

//--- env_render -------------------------------------------------------------
//
// Copies its own render fields onto its target. The four mask bits mean "leave
// that field alone", so one env_render can fade a set of brushes without also
// recolouring them.
#define HLSF_RENDER_MASKFX		1
#define HLSF_RENDER_MASKAMT		2
#define HLSF_RENDER_MASKMODE		4
#define HLSF_RENDER_MASKCOLOR	8

U0 HLRenderUse(I64 self)
{//CRenderFxManager::Use, dlls/triggers.cpp:487. rendermode and renderamt reach
 //the raster: HLDrawSpan, HLDrawPolygon, HLDrawFace and HLDrawBrushModel all
 //take blend and amt, and HLRenderEntities defers a translucent brush model to
 //a sorted back-to-front pass
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*t;
	I64			 i;

	if (!e)
		return;

	i = HLEntFindByTargetname(e->target, 0);

	while (i >= 0)
	{
		t = &hl_entities[i];

		if (!(e->spawnflags & HLSF_RENDER_MASKFX))
			t->renderfx = e->renderfx;

		if (!(e->spawnflags & HLSF_RENDER_MASKAMT))
			t->renderamt = e->renderamt;

		if (!(e->spawnflags & HLSF_RENDER_MASKMODE))
			t->rendermode = e->rendermode;

		if (!(e->spawnflags & HLSF_RENDER_MASKCOLOR))
			HLVecCopy(e->rendercolor, t->rendercolor);

		i = HLEntFindByTargetname(e->target, i + 1);
	}
}

//--- env_sprite / env_glow / env_beam / env_laser ---------------------------
//
// All four are either showing or not, and the toggle is here.
//
// Beams draw: HLEntDrawBeams at the end of this file walks the entity list and
// calls HLDrawBeam per active one. Sprites draw too: HLRenderEntities defers
// env_sprite, env_glow and cycler_sprite to its translucent pass and calls
// HLSprDrawEntity per visible one.
#define HLSF_SPRITE_STARTON		1
#define HLSF_SPRITE_ONCE			2

//effects.h's SF_BEAM_*. The three texture bits (SHADEIN, SHADEOUT, DECALS) are
//recognised and unused: HLDrawBeam shades the ribbon uniformly
#define HLSF_BEAM_STARTON		1
#define HLSF_BEAM_TOGGLE			2
#define HLSF_BEAM_RANDOM			4
#define HLSF_BEAM_RING			8
#define HLSF_BEAM_SPARKSTART		16
#define HLSF_BEAM_SPARKEND		32
#define HLSF_BEAM_DECALS			64
#define HLSF_BEAM_SHADEIN		128
#define HLSF_BEAM_SHADEOUT		256

U0 HLSpriteUse(I64 self, I64 use_type)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (use_type == HLUSE_ON)
		e->visible = TRUE;
	else if (use_type == HLUSE_OFF)
		e->visible = FALSE;
	else
		e->visible = !e->visible;

	//SF_SPRITE_ONCE: CSprite::AnimateThink removes itself after one pass. no
	//per-sprite frame clock here, so the lifetime is frame count / framerate
	if (e->visible && (e->spawnflags & HLSF_SPRITE_ONCE) && e->spr)
	{
		if (e->framerate > 0.0)
			HLEntSetThink(e, HLM_REMOVE, hl_ent_time +
				ToF64(e->spr->num_frames) / e->framerate);
		else
			HLEntSetThink(e, HLM_REMOVE, hl_ent_time + 1.0);
	}
}

//--- env_message / game_text ------------------------------------------------
//
// env_message names an entry in valve/titles.txt; game_text carries the literal
// string. Both go to HLHudMsgShow, which is CHudMessage - position, two
// colours, fade in, fade out, hold and the three effects.
//
// HLEntTitleFind in HLEnt.ZC returns the block text alone and drops the layout
// directives, so an env_message routed through it drew in the HL font's own
// amber over the centreprint layout. HLEntTitleLook below reads the directives
// as well.
//
// The directive syntax, from the file's own header:
//
//     <dollar>position x y      0..1 per axis, -1 centres on that axis
//     <dollar>effect n          0 fade, 1 flicker, 2 scan out
//     <dollar>color r g b       the settled colour
//     <dollar>color2 r g b      effect 1's flash, effect 2's leading edge
//     <dollar>fadein s          effect 2 spends this per character
//     <dollar>fadeout s
//     <dollar>holdtime s
//     <dollar>fxtime s          how far the highlight lags the leading edge
//     NAME
//     {
//     text
//     }
//
// Directives are file scoped and latch: each applies to every message below it
// until overwritten. So the parse cannot seek to the name, it has to read from
// the top.
#define HLSF_MESSAGE_ONCE	1

//missing-title complaint budget, so a map with no titles.txt cannot fill the
//console
I64 hl_ent_title_misses = 0;

class CHLTitleMsg
{//client_textmessage_t, common/Sequence.h:17. a1/a2 are unused by the SDK's
 //own draw path and are not carried.
	I64	effect;
	I64	r1;
	I64	g1;
	I64	b1;
	I64	r2;
	I64	g2;
	I64	b2;
	F64	x;
	F64	y;
	F64	fadein;
	F64	fadeout;
	F64	holdtime;
	F64	fxtime;
};

U0 HLTitleDefaults(CHLTitleMsg *t)
{//What a message with no directive above it gets. White, centred, no effect.
	t->effect   = 0;
	t->r1       = 255;
	t->g1       = 255;
	t->b1       = 255;
	t->r2       = 255;
	t->g2       = 255;
	t->b2       = 255;
	t->x        = -1.0;
	t->y        = -1.0;
	t->fadein   = 0.0;
	t->fadeout  = 0.0;
	t->holdtime = 2.0;
	t->fxtime   = 0.0;
}

U8 *HLTitleTok(U8 *p, U8 *end, U8 *out, I64 max)
{//Next whitespace delimited token, returning the cursor past it. Stops at the
 //line end: a directive never continues onto the next line.
 //
 //The scan runs to the real delimiter; only the copy is capped.
	I64 k = 0;

	while (p < end && (*p == ' ' || *p == 9))
		p++;

	while (p < end && *p != ' ' && *p != 9 && *p != 10 && *p != 13)
	{
		if (k < max - 1)
		{
			out[k] = *p;
			k++;
		}

		p++;
	}

	out[k] = 0;

	return p;
}

U8 *HLTitleNum(U8 *p, U8 *end, F64 *v)
{//One number off the line. A missing token leaves the field alone.
	U8 tok[32];

	p = HLTitleTok(p, end, tok, 32);

	if (tok[0])
		*v = HLAtoF(tok);

	return p;
}

U0 HLTitleDirective(U8 *p, U8 *end, CHLTitleMsg *t)
{//p is at the character after the leading dollar.
	U8	tok[32];
	F64	a;
	F64	b;
	F64	c;

	p = HLTitleTok(p, end, tok, 32);

	if (!StrCompare(tok, "position"))
	{
		p = HLTitleNum(p, end, &t->x);
		    HLTitleNum(p, end, &t->y);
		return;
	}

	if (!StrCompare(tok, "effect"))
	{
		a = ToF64(t->effect);
		HLTitleNum(p, end, &a);
		t->effect = ToI64(a);
		return;
	}

	if (!StrCompare(tok, "color") || !StrCompare(tok, "color2"))
	{
		a = 255.0;
		b = 255.0;
		c = 255.0;

		p = HLTitleNum(p, end, &a);
		p = HLTitleNum(p, end, &b);
		    HLTitleNum(p, end, &c);

		if (!StrCompare(tok, "color"))
		{
			t->r1 = ClampI64(ToI64(a), 0, 255);
			t->g1 = ClampI64(ToI64(b), 0, 255);
			t->b1 = ClampI64(ToI64(c), 0, 255);
		}
		else
		{
			t->r2 = ClampI64(ToI64(a), 0, 255);
			t->g2 = ClampI64(ToI64(b), 0, 255);
			t->b2 = ClampI64(ToI64(c), 0, 255);
		}

		return;
	}

	if (!StrCompare(tok, "fadein"))
		HLTitleNum(p, end, &t->fadein);
	else if (!StrCompare(tok, "fadeout"))
		HLTitleNum(p, end, &t->fadeout);
	else if (!StrCompare(tok, "holdtime"))
		HLTitleNum(p, end, &t->holdtime);
	else if (!StrCompare(tok, "fxtime"))
		HLTitleNum(p, end, &t->fxtime);
}

Bool HLEntTitleLook(U8 *name, U8 *out, I64 max, CHLTitleMsg *t)
{//The engine's titles.txt loader: read every directive from the top, stop on
 //the message whose name line matches, return its block and the directive
 //state that reached it.
 //
 //Braces are compared as 0x7B/0x7D rather than as character literals: a lone
 //open-brace character literal unbalances this file for every brace-counting
 //tool that reads it.
	U8	*p;
	U8	*end;
	U8	*eol;
	U8	*s;
	U8	*le;
	I64	 len;
	I64	 n;
	Bool matched;

	if (!t)
		return FALSE;

	HLTitleDefaults(t);

	if (!out || max < 1)
		return FALSE;

	out[0] = 0;

	if (!name || !name[0])
		return FALSE;

	HLEntTitlesLoad;

	if (!hl_ent_titles)
		return FALSE;

	len = StrLen(name);
	p   = hl_ent_titles;
	end = hl_ent_titles + hl_ent_titles_size;

	while (p < end)
	{
		eol = p;
		while (eol < end && *eol != 10)
			eol++;

		//trim the CR of a DOS line ending and any trailing blanks
		le = eol;
		while (le > p && (le[-1] == 13 || le[-1] == ' ' || le[-1] == 9))
			le--;

		s = p;
		while (s < le && (*s == ' ' || *s == 9))
			s++;

		//cursor for the next line, set before any of the branches move p
		p = eol;
		if (p < end)
			p++;

		if (s >= le)
			goto qetl_next;

		if (s[0] == '/' && s + 1 < le && s[1] == '/')
			goto qetl_next;

		//0x24 is the dollar. Written as a number: the compiler's lexer opens a
		//DolDoc command on a raw one and swallows the rest of the file.
		if (s[0] == 0x24)
		{
			HLTitleDirective(s + 1, le, t);
			goto qetl_next;
		}

		//a stray brace outside a block
		if (s[0] == 0x7B || s[0] == 0x7D)
			goto qetl_next;

		//a name line. The whole line is the key, so C1A0_ must not match
		//C1A0_TRAINRIDE
		matched = FALSE;

		if (le - s == len && !StrNICompare(s, name, len))
			matched = TRUE;

		//every name is followed by a braced block; skip or take it, but never
		//fall through to read its text as directives
		while (p < end && *p != 0x7B)
			p++;

		if (p >= end)
			return FALSE;

		p++;

		while (p < end && *p != 10)
			p++;
		if (p < end)
			p++;

		n = 0;

		while (p < end && *p != 0x7D)
		{
			if (matched && *p != 13)
			{
				//HLHudMsgDraw breaks lines on the two character escape that
				//game_text carries, not on byte 10. A block's real newlines
				//are rewritten into it here.
				if (*p == 10)
				{
					if (n < max - 2)
					{
						out[n]     = '\\';
						out[n + 1] = 'n';
						n += 2;
					}
				}
				else if (n < max - 1)
				{
					out[n] = *p;
					n++;
				}
			}

			p++;
		}

		if (p < end)
			p++;

		if (!matched)
			goto qetl_next;

		//the block's last line ends with a newline before the closing brace,
		//which would place an empty trailing row
		while (n > 1 && out[n - 2] == '\\' && out[n - 1] == 'n')
			n -= 2;

		out[n] = 0;

		return ToBool(n > 0);

qetl_next:
	}

	return FALSE;
}

U0 HLMessageUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	CHLTitleMsg	 t;
	U8			 text[HLMSG_MAX_TEXT];

	if (!e || !e->message[0])
		return;

	//holdtime and the rest come from titles.txt, not from the entity: CMessage
	//has no timing keys at all - dlls/effects.cpp:2040
	if (HLEntTitleLook(e->message, text, HLMSG_MAX_TEXT, &t))
		HLHudMsgShow(text, t.effect, t.x, t.y,
			t.r1, t.g1, t.b1, t.r2, t.g2, t.b2,
			t.fadein, t.fadeout, t.holdtime, t.fxtime);
	else if (hl_ent_title_misses < 8)
	{
		//nothing is drawn; the miss is reported instead, capped
		hl_ent_title_misses++;
		"HLEnt: env_message '%s' not in titles.txt\n", e->message;
	}

	//SF_MESSAGE_ONCE
	if (e->spawnflags & HLSF_MESSAGE_ONCE)
		e->in_use = FALSE;
}

U0 HLGameTextUse(I64 self)
{//game_text's message is the text, escapes unprocessed - a literal backslash
 //then n, which HLHudMsgDraw breaks on.
 //
 //effect is 0. m_textParms.effect (maprules.cpp:271) selects flicker or
 //writeout over the plain fade; HLHudMsgShow stores the value in hl_msg_effect
 //and no draw path reads it, so all three render alike
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLHudMsgShow(e->message, 0, e->text_x, e->text_y,
		ToI64(e->text_color[0]), ToI64(e->text_color[1]),
		ToI64(e->text_color[2]),
		ToI64(e->text_color2[0]), ToI64(e->text_color2[1]),
		ToI64(e->text_color2[2]),
		e->fade_in, e->fade_out, e->hold_time, 0.25);
}

//--- env_fade / env_shake ---------------------------------------------------
//
// env_shake is a pure view effect and stays a pending request. env_fade goes
// straight to the HUD overlay: HLHudFadeSet owns the ramp, so the request no
// longer has to survive to the shell.
//
// pev->dmg_take is the duration and pev->dmg_save the hold time -
// dlls/effects.cpp:1920. SF_FADE_ONLYONE is single player irrelevant: there is
// one client either way.
#define HLSF_FADE_IN			1
#define HLSF_FADE_MODULATE	2

U0 HLFadeUse(I64 self)
{
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//kept for the save file, which carries the fade across a level change
	HLVecCopy(e->rendercolor, hl_ent_fade_color);
	hl_ent_fade_alpha    = e->renderamt;
	hl_ent_fade_duration = e->duration;
	hl_ent_fade_hold     = e->hold_time;
	hl_ent_fade_in       = ToBool(e->spawnflags & HLSF_FADE_IN);
	hl_ent_fade_pending  = FALSE;

	//SF_FADE_MODULATE is a multiply rather than a blend. The overlay blends;
	//no shipped single player map sets the bit.
	HLHudFadeSet(ToI64(e->rendercolor[0]), ToI64(e->rendercolor[1]),
		ToI64(e->rendercolor[2]), ToI64(e->renderamt),
		e->duration, e->hold_time, hl_ent_fade_in);
}

U0 HLShakeUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];

	if (!e)
		return;

	//radius 0 means everyone; past the radius there is nothing. tested against
	//the stashed origin - a think has no player argument
	if (e->radius > 0.0)
	{
		HLVecSub(hl_ent_player_org, e->origin, dist);

		if (HLVecLength(dist) > e->radius)
			return;
	}

	hl_ent_shake_amp     = e->amplitude;
	hl_ent_shake_freq    = e->frequency;
	hl_ent_shake_until   = hl_ent_time + e->duration;
	hl_ent_shake_pending = TRUE;
}

//--- the ending: strip, revert, endsection -----------------------------------
//
// The three classes c5a1 uses to close the game out. Placed here because
// CRevertSaved drives the fade overlay and the title layer above.

U0 HLStripUse(I64 self)
{//CStripWeapons::Use, player.cpp:4935. RemoveAllItems(FALSE): every weapon and
 //every round, the suit kept
	hl_ent_weaponstrip_pending = TRUE;
}

U0 HLRevertUse(I64 self)
{//CRevertSaved::Use, player.cpp:5017. UTIL_ScreenFadeAll then the message think
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLVecCopy(e->rendercolor, hl_ent_fade_color);
	hl_ent_fade_alpha    = e->renderamt;
	hl_ent_fade_duration = e->duration;
	hl_ent_fade_hold     = e->hold_time;
	hl_ent_fade_in       = FALSE;		//FFADE_OUT

	HLHudFadeSet(ToI64(e->rendercolor[0]), ToI64(e->rendercolor[1]),
		ToI64(e->rendercolor[2]), ToI64(e->renderamt),
		e->duration, e->hold_time, FALSE);

	HLEntSetThink(e, HLM_REVERT_MESSAGE,
		hl_ent_time + e->revert_message_time);
}

U0 HLRevertMessage(I64 self)
{//CRevertSaved::MessageThink and LoadThink, player.cpp:5025 and :5039, folded
 //into one method: the second visit is the load
 //
 //The reload needs a save system, which this port has no hook into. The request
 //is published and the shell decides what a revert means
	CHLEntity	*e = HLEntGet(self);
	CHLTitleMsg	 t;
	U8			 text[HLMSG_MAX_TEXT];
	F64			 gap;

	if (!e)
		return;

	if (e->message[0] && HLEntTitleLook(e->message, text, HLMSG_MAX_TEXT, &t))
		HLHudMsgShow(text, t.effect, t.x, t.y,
			t.r1, t.g1, t.b1, t.r2, t.g2, t.b2,
			t.fadein, t.fadeout, t.holdtime, t.fxtime);

	gap = e->revert_load_time - e->revert_message_time;

	if (gap > 0.0 && e->message[0])
	{
		//the message is cleared so the second visit falls through to the load
		e->message[0] = 0;
		HLEntSetThink(e, HLM_REVERT_MESSAGE, hl_ent_time + gap);
		return;
	}

	hl_ent_loadsaved_pending = TRUE;
	HLEntSetThink(e, HLM_NONE, 0.0);
}

//SF_ENDSECTION_USEONLY, triggers.cpp:1991
#define HLSF_ENDSECTION_USEONLY	1

U0 HLEndSection(I64 self)
{//CTriggerEndSection::EndSectionUse / EndSectionTouch, triggers.cpp:2004 and
 //:2035. The section name rides in "message" - the SDK stores it there rather
 //than in a member of its own, so it needs no save/restore
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (e->message[0])
	{
		HLStrCopy(hl_ent_endsection, e->message, 64);
		hl_ent_endsection_pending = TRUE;
	}

	//SetUse(NULL) / SetTouch(NULL) then UTIL_Remove: fires once
	e->use_fn   = HLM_NONE;
	e->touch_fn = HLM_NONE;
	e->in_use   = FALSE;
}

//--- env_beverage -----------------------------------------------------------
//
// CEnvBeverage, dlls/effects.cpp:2143. A soda machine: each use drops one can,
// and no second can until the first is taken. The SDK overloads pev->frags for
// "a can is waiting" and pev->health for the stock; toggle_state carries the
// first here, AT_TOP meaning a can is in the slot.

U0 HLBeverageUse(I64 self)
{//CEnvBeverage::Use, effects.cpp:2161
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*can;
	I64			 i;

	if (!e)
		return;

	if (e->toggle_state == HLTS_AT_TOP || e->health <= 0.0)
		return;

	i = HLEntCreateNamed("item_sodacan", e->origin, e->angles, self);

	if (i < 0)
		return;

	can = HLEntGet(i);

	//skin 6 is "random", effects.cpp:2170. Six flavours, 0..5
	if (e->skin == 6)
		can->skin = HLFxRandI(0, 5);
	else
		can->skin = e->skin;

	//CItemSoda::Spawn, effects.cpp:2222: not solid, no touch, until CanThink
	//half a second later
	can->solid    = HLSOLID_NOT;
	can->touch_fn = HLM_NONE;
	HLVecSet(can->mins, 0.0, 0.0, 0.0);
	HLVecSet(can->maxs, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(can);
	HLEntSetThink(can, HLM_SODA_THINK, hl_ent_time + 0.5);

	e->toggle_state = HLTS_AT_TOP;
	e->health -= 1.0;
}

U0 HLSodaThink(I64 self)
{//CItemSoda::CanThink, effects.cpp:2235. The can lands and becomes takeable
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//CHAN_WEAPON, effects.cpp:2237
	HLSndPlayAt("weapons/g_bounce3.wav", e->origin, 1.0, HLENT_SND_ATTEN,
		self + 1, HLCHAN_WEAPON);

	e->solid    = HLSOLID_TRIGGER;
	e->touch_fn = HLM_ITEM_TOUCH;

	HLVecSet(e->mins, -8.0, -8.0, 0.0);
	HLVecSet(e->maxs, 8.0, 8.0, 8.0);
	HLEntSetAbsBox(e);

	HLEntSetThink(e, HLM_NONE, 0.0);
}

//--- env_explosion ----------------------------------------------------------
//
// explode.h's SF_ENVEXPLOSION_*. The decal bit is parsed and ignored: there is
// no decal layer, so a scorch mark has nowhere to go.
#define HLSF_EXPLOSION_NODAMAGE	1
#define HLSF_EXPLOSION_REPEATABLE	2
#define HLSF_EXPLOSION_NOFIREBALL	4
#define HLSF_EXPLOSION_NOSMOKE		8
#define HLSF_EXPLOSION_NODECAL		16
#define HLSF_EXPLOSION_NOSPARKS	32

U0 HLExplosionSmoke(I64 self)
{//CEnvExplosion::Smoke - a second puff 0.3s behind the fireball, and the point
 //at which a non-repeatable explosion is removed
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLEntSetThink(e, HLM_NONE, 0.0);

	//TE_SMOKE at the sprite scale CEnvExplosion computed at spawn
	if (!(e->spawnflags & HLSF_EXPLOSION_NOSMOKE))
		HLFxSmoke(e->origin, e->scale, tS);

	//UTIL_Remove. In the SDK this is here rather than in Use, so a repeatable
	//explosion survives its own smoke
	if (!(e->spawnflags & HLSF_EXPLOSION_REPEATABLE))
		e->in_use = FALSE;
}

U0 HLExplosionUse(I64 self)
{//CEnvExplosion::Use. iMagnitude is the damage; the radius is 2.5x it, as
 //RadiusDamage is called
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];
	F64			 up[3];
	F64			 radius;
	F64			 len;
	F64			 damage;
	I64			 sparks;
	I64			 i;

	if (!e)
		return;

	//the SDK traces 40 units down and pulls the blast out of whatever it hits,
	//so a fireball on the floor is not half inside it. Not done here: the origin
	//is only used to place particles, which have no volume to sink into

	//TE_EXPLOSION at the scale computed at spawn. NOFIREBALL sends the same
	//message with a zero sprite scale, which here is the particle-free flag
	if (!(e->spawnflags & HLSF_EXPLOSION_NOFIREBALL))
		HLFxExplosion(e->origin, e->scale, 0, tS);
	else
		HLFxExplosion(e->origin, e->scale, 8, tS);	//TE_EXPLFLAG_NOPARTICLES

	//explode3. the SDK randomises over three variants
	HLSndPlayAt("weapons/explode3.wav", e->origin, 1.0, HLENT_SND_ATTEN, 0,
		HLENT_CHAN_MOVE);

	//spark_shower, RANDOM_LONG(0,3) of them, each scattered along the surface
	//normal the blast was traced against. There is no trace here, so they go up
	if (!(e->spawnflags & HLSF_EXPLOSION_NOSPARKS))
	{
		sparks = HLPartRandI(4);
		HLVecSet(up, 0.0, 0.0, 1.0);

		for (i = 0; i < sparks; i++)
			HLFxSparkShower(e->origin, up, tS);
	}

	if (e->spawnflags & HLSF_EXPLOSION_NODAMAGE)
		goto qeu_done;

	radius = e->magnitude * 2.5;
	if (radius <= 0.0)
		goto qeu_done;

	HLVecSub(hl_ent_player_org, e->origin, dist);
	len = HLVecLength(dist);

	if (len < radius)
	{
		//RadiusDamage's linear falloff. no trace to the target, so a wall
		//between the player and the blast does not shield them
		damage = e->magnitude * (1.0 - len / radius);
		HLEntHurtPlayer(damage, HLDMG_BLAST, e->origin);
	}

qeu_done:
	HLEntSetThink(e, HLM_EXPLOSION_SMOKE, hl_ent_time + 0.3);
}

//--- env_spark --------------------------------------------------------------
#define HLSF_SPARK_TOGGLE	32
#define HLSF_SPARK_START_ON	64

U8 *HLEntSparkSound(I64 n)
{//DoSpark picks one of six at random
	if (n == 1)		return "buttons/spark1.wav";
	if (n == 2)		return "buttons/spark2.wav";
	if (n == 3)		return "buttons/spark3.wav";
	if (n == 4)		return "buttons/spark4.wav";
	if (n == 5)		return "buttons/spark5.wav";

	return "buttons/spark6.wav";
}

U0 HLSparkThink(I64 self)
{//a spark, then reschedule at a random point inside MaxDelay
	CHLEntity	*e = HLEntGet(self);
	F64			 wait;

	if (!e)
		return;

	//DoSpark, buttons.cpp:554: RANDOM_FLOAT(0.25, 0.75) * 0.4
	HLSndPlayAt(HLEntSparkSound(HLPartRandI(6) + 1), e->origin,
		(0.25 + ToF64(HLPartRandI(100)) * 0.005) * 0.4,
		HLENT_SND_ATTEN, 0, 0);

	//UTIL_Sparks at the entity origin, util.cpp:1342: one TE_SPARKS point
	//burst. env_spark's "angle" key is not read by DoSpark; the axis-walking
	//burst belongs to CShower, explode.cpp:29
	HLFxSparks(e->origin, tS);

	wait = e->max_delay;
	if (wait <= 0.0)
		wait = 1.5;

	//0.1 .. MaxDelay, jittered
	HLEntSetThink(e, HLM_SPARK_THINK,
		hl_ent_time + 0.1 + ToF64(HLPartRandI(100)) * 0.01 * wait);
}

U0 HLSparkUse(I64 self, I64 use_type)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	//an untoggleable spark sparks once when fired
	if (!(e->spawnflags & HLSF_SPARK_TOGGLE))
	{
		HLSparkThink(self);
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	//"on" is whether it sparks after this use
	on = ToBool(e->think_fn != HLM_SPARK_THINK);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	if (on)
		HLEntSetThink(e, HLM_SPARK_THINK, hl_ent_time + 0.1);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

//--- env_bubbles ------------------------------------------------------------
//
// CBubbling. A brush volume that fizzes: TE_FIZZ fills the model's box with
// rising bubble sprites. There is no bubble sprite here, so the bubbles are
// particles in the palette's pale blue range, released across the brush and
// given an upward velocity.
//
// "current" is a horizontal drift, which the SDK smuggles to the client packed
// into rendercolor. Applied straight to the particle velocity here.
#define HLSF_BUBBLES_STARTOFF	1

U0 HLBubbleThink(I64 self)
{//CBubbling::FizzThink
	CHLEntity	*e = HLEntGet(self);
	F64			 wait;
	F64			 speed;
	I64			 count;

	if (!e)
		return;

	//m_density is the bubble count per fizz
	count = e->density;
	if (count < 1)
		count = 1;

	//"current", which CBubbling::Spawn packs into rendercolor for the client.
	//UTIL_Bubbles' own default is 8 when nothing is set
	speed = e->speed;
	if (speed <= 0.0)
		speed = 8.0;

	//the bubbles rise the height of the brush and are gone at the top of it,
	//which is where TE_FIZZ's water surface is
	HLFxBubbles(e->absmin, e->absmax, e->size[2], count, speed, tS);

	//"if ( m_frequency > 19 ) 0.5 else 2.5 - (0.1 * m_frequency)"
	if (e->frequency > 19)
		wait = 0.5;
	else
		wait = 2.5 - 0.1 * ToF64(e->frequency);

	HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + wait);
}

U0 HLBubbleUse(I64 self, I64 use_type)
{//CBubbling::Use - ShouldToggle against m_state, which is the think being armed
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = ToBool(e->think_fn != HLM_BUBBLE_THINK);

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	if (on)
		HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + 0.1);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

//--- env_smoker -------------------------------------------------------------
//
// CSmoker, in gargantua.cpp rather than effects.cpp - it exists for the
// gargantua's footfalls and is created at runtime there. A mapper-placed one
// works the same way: health is the puff count, dmg the horizontal spread and
// scale the sprite size.

U0 HLSmokerThink(I64 self)
{//CSmoker::Think - one puff, then count down
	CHLEntity	*e = HLEntGet(self);
	F64			 org[3];

	if (!e)
		return;

	//"origin.x + RANDOM_FLOAT(-pev->dmg, pev->dmg)" on x and y, z untouched
	org[0] = e->origin[0] + HLPartRand(e->dmg);
	org[1] = e->origin[1] + HLPartRand(e->dmg);
	org[2] = e->origin[2];

	//"RANDOM_LONG(pev->scale, pev->scale * 1.1)" is the sprite scale byte
	HLFxSmoke(org, e->scale + ToF64(HLPartRandI(11)) * 0.01 * e->scale, tS);

	e->health -= 1.0;

	if (e->health > 0.0)
		HLEntSetThink(e, HLM_SMOKER_THINK,
			hl_ent_time + 0.1 + ToF64(HLPartRandI(10)) * 0.01);
	else
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		e->in_use = FALSE;
	}
}

//--- env_funnel -------------------------------------------------------------
//
// CEnvFunnel. TE_LARGEFUNNEL: a cone of sprites falling in toward the origin,
// or thrown outward when SF_FUNNEL_REVERSE is set. Built here out of particles
// released on a ring 256 units up, aimed at or away from the origin.
//
// Fires once and removes itself, as the SDK's Use does.
#define HLSF_FUNNEL_REVERSE	1

U0 HLFunnelUse(I64 self)
{//CEnvFunnel::Use
	CHLEntity	*e = HLEntGet(self);
	CHLParticle	*p;
	F64			 dir[3];
	F64			 ang;
	F64			 rad;
	Bool		 reverse;
	I64			 i;

	if (!e)
		return;

	reverse = ToBool(e->spawnflags & HLSF_FUNNEL_REVERSE);

	for (i = 0; i < 128; i++)
	{
		p = HLPartAlloc(tS);
		if (!p)
			goto qfu_done;

		//a point on a ring of random radius, 256 units above the origin. The
		//funnel's mouth is wide and its throat is the entity
		ang = ToF64(HLPartRandI(360)) * HLDEG2RAD;
		rad = 32.0 + ToF64(HLPartRandI(224));

		p->org[0] = e->origin[0] + Cos(ang) * rad;
		p->org[1] = e->origin[1] + Sin(ang) * rad;
		p->org[2] = e->origin[2] + 100.0 + ToF64(HLPartRandI(156));

		HLVecSub(e->origin, p->org, dir);
		HLVecNormalize(dir);

		if (reverse)
			HLVecScale(dir, -1.0, dir);

		HLVecScale(dir, 80.0 + ToF64(HLPartRandI(120)), p->vel);

		p->type  = HLPT_STATIC;
		p->ramp  = 0.0;
		p->color = 254;		//flare6.spr is white
		p->die   = tS + 2.0;
	}

qfu_done:
	//SUB_Remove on the next think
	e->in_use = FALSE;
}

//--- env_blood --------------------------------------------------------------
//
// CBlood. A spray of blood at a point, at the player, or along the entity's
// own angle. SF_BLOOD_DECAL traces the spray and stains what it reaches.
#define HLSF_BLOOD_RANDOM	1
#define HLSF_BLOOD_STREAM	2
#define HLSF_BLOOD_PLAYER	4
#define HLSF_BLOOD_DECAL		8

U0 HLBloodUse(I64 self)
{//CBlood::Use - UTIL_BloodDrips, or UTIL_BloodStream for a jet
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 org[3];
	F64			 dir[3];
	F64			 zero[3];
	F64			 spot[3];
	I64			 amount;

	if (!e)
		return;

	//BloodPosition: SF_BLOOD_PLAYER sprays at the player's eye, jittered by 10
	//units on each axis
	if (e->spawnflags & HLSF_BLOOD_PLAYER)
	{
		org[0] = hl_ent_player_org[0] + HLPartRand(10.0);
		org[1] = hl_ent_player_org[1] + HLPartRand(10.0);
		org[2] = hl_ent_player_org[2] + HLPartRand(10.0);
	}
	else
		HLVecCopy(e->origin, org);

	//Direction: UTIL_RandomBloodVector for SF_BLOOD_RANDOM, otherwise the
	//entity's own movedir
	if (e->spawnflags & HLSF_BLOOD_RANDOM)
		HLFxRandomBloodVector(dir);
	else
		HLVecCopy(e->move_dir, dir);

	//"amount" is the blood volume, clamped to a byte by the temp entity
	amount = ToI64(e->blood_amount);

	if (amount < 1)
		amount = 1;
	if (amount > 255)
		amount = 255;

	//"UTIL_BloodStream( ..., (Color() == BLOOD_COLOR_RED) ? 70 : Color(), ... )"
	//- a red stream is sent as palette 70 rather than 247, which is the darker
	//arterial ramp
	if (e->spawnflags & HLSF_BLOOD_STREAM)
	{
		if (e->blood_color == HLBLOOD_RED)
			HLFxBloodStream(org, dir, 70, amount, tS);
		else
			HLFxBloodStream(org, dir, e->blood_color, amount, tS);
	}
	else
		HLFxBloodDrips(org, dir, e->blood_color, amount, tS);

	//SF_BLOOD_DECAL, effects.cpp:1820-1829: UTIL_TraceLine along the spray for
	//amount*2 units with ignore_monsters, and the mark goes on the surface it
	//reaches. A miss leaves nothing - the stain has no wall to sit on -
	//and UTIL_BloodDecalTrace takes brush models only (util.cpp:1243)
	if (e->spawnflags & HLSF_BLOOD_DECAL)
	{
		HLVecSet(zero, 0.0, 0.0, 0.0);
		HLVecMA(org, ToF64(amount) * 2.0, dir, spot);

		HLTraceEntity(hl_map, org, spot, zero, zero, 0, TRUE, &tr);

		if (tr.fraction < 1.0 && HLEntTraceDecalSurface(&tr))
			HLFxBloodDecal(tr.end_pos, tr.plane_normal, e->blood_color);
	}
}

//--- gibshooter / env_shooter -----------------------------------------------
//
// CGibShooter and CEnvShooter. Both throw m_iGibs gibs, one every m_flDelay,
// along the entity's angle scattered by m_flVariance.
//
// The gib pool in HLPart.ZC carries them: hl_gibs is a fixed table with its own
// bounce integrator, independent of hl_entities, so CreateGib maps onto
// HLGibAlloc/HLGibSpawn and the SDK's ShootThink transfers almost whole.
//
// env_shooter's "shootmodel" is parsed and unused - the pool draws hgibs.mdl or
// agibs.mdl and has no third model slot.
#define HLSF_GIBSHOOTER_REPEATABLE	1

U0 HLShooterThink(I64 self)
{//CGibShooter::ShootThink - one gib per think
	CHLEntity	*e = HLEntGet(self);
	CHLGib		*g;
	F64			 dir[3];
	F64			 wait;
	I64			 body;

	if (!e)
		return;

	//movedir scattered by m_flVariance on all three axes. The SDK builds the
	//scatter out of v_forward/v_right/v_up, which for an axial movedir is the
	//same as jittering the vector itself
	dir[0] = e->move_dir[0] + HLPartRand(e->gib_variance);
	dir[1] = e->move_dir[1] + HLPartRand(e->gib_variance);
	dir[2] = e->move_dir[2] + HLPartRand(e->gib_variance);

	HLVecNormalize(dir);

	//"avoid throwing random amounts of the 0th gib. (skull)"
	body = HLFxRandI(1, HLGIB_HUMAN_COUNT - 1);

	g = HLGibAlloc(tS);
	HLGibSpawn(g, e->origin, TRUE, body, HLBLOOD_RED, tS);

	HLVecScale(dir, e->gib_velocity, g->velocity);

	g->avelocity[0] = HLFxRandF(100.0, 200.0);
	g->avelocity[1] = HLFxRandF(100.0, 300.0);
	g->avelocity[2] = 0.0;

	//m_flGibLife with the SDK's +/- 5%
	g->die = tS + e->gib_life * HLFxRandF(0.95, 1.05);

	HLGibLimitVelocity(g);

	e->gib_left--;

	if (e->gib_left > 0)
	{
		wait = e->delay;
		if (wait <= 0.0)
			wait = 0.1;

		HLEntSetThink(e, HLM_SHOOTER_THINK, hl_ent_time + wait);
		return;
	}

	//exhausted: refill and stop, or remove
	HLEntSetThink(e, HLM_NONE, 0.0);

	if (e->spawnflags & HLSF_GIBSHOOTER_REPEATABLE)
		e->gib_left = e->gib_count;
	else
		e->in_use = FALSE;
}

U0 HLShooterUse(I64 self)
{//CGibShooter::Use - starts the think immediately
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//a shooter used again mid-burst restarts the count, as refilling m_iGibs
	//through Spawn would
	if (e->gib_left <= 0)
		e->gib_left = e->gib_count;

	HLEntSetThink(e, HLM_SHOOTER_THINK, hl_ent_time);
}

//--- env_laser --------------------------------------------------------------
//
// CLaser. Unlike env_beam it has a think: every 0.1s it traces from its origin
// to its target and damages whatever the line crosses, at pev->dmg per second.
//
// Not drawn. HLDraw.ZC has no line primitive - see HLEntSpawnBeam - so the laser
// is an invisible damage line. The state is complete: on/off, the endpoint, the
// width and the damage rate.

F64 HLEntPointSegDist(F64 *p, F64 *a, F64 *b)
{//distance from a point to the segment ab. The beam has no trace, so "is the
 //player in the beam" is this test against the player's centre
	F64 ab[3];
	F64 ap[3];
	F64 closest[3];
	F64 len2;
	F64 t;

	HLVecSub(b, a, ab);
	HLVecSub(p, a, ap);

	len2 = HLVecDot(ab, ab);

	if (len2 < 0.0001)
		return HLVecLength(ap);

	t = HLVecDot(ap, ab) / len2;

	if (t < 0.0)
		t = 0.0;
	if (t > 1.0)
		t = 1.0;

	HLVecMA(a, t, ab, closest);
	HLVecSub(p, closest, ap);

	return HLVecLength(ap);
}

U0 HLLaserThink(I64 self)
{//CLaser::StrikeThink into CBeam::BeamDamage. Damage is pev->dmg scaled by the
 //time since the last think, so the rate is per second whatever the tick is
	CHLEntity	*e = HLEntGet(self);
	F64			 end[3];
	F64			 dist;

	if (!e)
		return;

	//the endpoint is LaserTarget, resolved to an index at spawn. Without one the
	//laser is a zero length segment at its own origin
	if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_end].origin, end);
	else
		HLVecCopy(e->origin, end);

	if (e->damage > 0.0)
	{
		dist = HLEntPointSegDist(hl_ent_player_org, e->origin, end);

		//the beam's own half-width plus the player's: the SDK traces a line and
		//hits the player's box, which is 16 units across. BoltWidth is stored
		//in 0.1s of a unit (const.h:131), so the half-width is width * 0.05
		if (dist < e->beam_width * 0.05 + 16.0)
			HLEntHurtPlayer(e->damage * 0.1, HLDMG_ENERGYBEAM);
	}

	//DoSparks at the impact point, which is the endpoint since there is no trace
	if (e->spawnflags & HLSF_BEAM_SPARKEND)
		HLFxSparks(end, tS);

	HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time + 0.1);
}

U0 HLLaserUse(I64 self, I64 use_type)
{//CLaser::Use - ShouldToggle against IsOn, which is the EF_NODRAW bit. Here it
 //is the visible flag the beam already carries
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = !e->visible;

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	e->visible     = on;
	e->beam_active = on;

	if (on)
		HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time);
	else
		HLEntSetThink(e, HLM_NONE, 0.0);
}

U0 HLBeamUse(I64 self, I64 use_type)
{//CLightning::ToggleUse. Its own rather than the sprite's: SF_BEAM_TOGGLE is bit
 //1, which is SF_SPRITE_ONCE on a sprite, and the sprite path would read a
 //toggleable beam as a one-shot and remove it
	CHLEntity	*e = HLEntGet(self);
	Bool		 on;

	if (!e)
		return;

	on = !e->visible;

	if (use_type == HLUSE_ON)
		on = TRUE;
	else if (use_type == HLUSE_OFF)
		on = FALSE;

	e->visible     = on;
	e->beam_active = on;

	//"DoSparks( GetStartPos(), GetEndPos() )" when it comes on
	if (on && (e->spawnflags & HLSF_BEAM_SPARKSTART))
		HLFxSparks(e->origin, tS);
}

U0 HLBeamDamageThink(I64 self)
{//CLightning::DamageThink - env_beam's server-side damage, the same line test as
 //the laser's but between the two named endpoints
	CHLEntity	*e = HLEntGet(self);
	F64			 start[3];
	F64			 end[3];
	F64			 dist;

	if (!e)
		return;

	if (e->beam_start >= 0 && e->beam_start < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_start].origin, start);
	else
		HLVecCopy(e->origin, start);

	if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
		HLVecCopy(hl_entities[e->beam_end].origin, end);
	else
		HLVecCopy(e->origin, end);

	if (e->beam_active && e->damage > 0.0)
	{
		dist = HLEntPointSegDist(hl_ent_player_org, start, end);

		//BoltWidth is in 0.1s of a unit, const.h:131
		if (dist < e->beam_width * 0.05 + 16.0)
			HLEntHurtPlayer(e->damage * 0.1, HLDMG_ENERGYBEAM);
	}

	HLEntSetThink(e, HLM_BEAM_DAMAGE_THINK, hl_ent_time + 0.1);
}

//--- infodecal --------------------------------------------------------------
//
// CDecal, dlls/world.cpp:105. Nothing about a decal is baked at compile time:
// an unnamed one sprays itself on one think after the map spawns
// (world.cpp:125-129), a named one waits for its use (world.cpp:132-136).
//
// The "texture" key names a patch in decals.wad. DECAL_INDEX is an engine call
// over the whole archive; HLDecalName covers the gDecals subset only, which is
// 1050 of the 1925 infodecals in the shipped maps. A name outside it resolves
// to -1 and the entity is dropped, as CDecal::KeyValue does on a miss
// (world.cpp:191).
//
// SF_DECAL_NOTINDEATHMATCH gates a decal on gpGlobals->deathmatch. This port is
// single-player, so the bit never applies.

I64 HLDecalIndexByName(U8 *name)
{//DECAL_INDEX. The map spells the name with the masked-texture prefix and in
 //upper case; gDecals carries it lower case and without the prefix
	U8	*base;
	U8	*p;
	I64	 i;

	if (!name || !name[0])
		return -1;

	p = name;

	if (*p == 0x7B)
		p++;

	for (i = 0; i < HLDECAL_TEX_MAX; i++)
	{
		base = HLDecalName(i);

		if (base && !StrICompare(base, p))
			return i;
	}

	return -1;
}

U0 HLDecalPlace(I64 self)
{//CDecal::StaticDecal, world.cpp:165, and CDecal::TriggerDecal, world.cpp:139 -
 //the same trace and the same removal, so one body serves both
 //
 //The 10 unit diagonal probe is Valve's: an infodecal is authored a unit or two
 //off the face it belongs to, on no particular axis. UTIL_TraceLine with
 //ignore_monsters, so hull 0 - a hull 1 sweep stops when the 32x32x72 box
 //touches, which reports an impact up to half a hull diagonal off the wall.
 //
 //Probed in both directions. origin-(5,5,5) lies inside the brush for every
 //face whose normal runs along +x, +y or +z, and a trace that begins in solid
 //returns no plane.
 //
 //pfnStaticDecal (world.cpp:178) hands the engine pev->origin and the engine
 //finds the surface under it. There is no such lookup here, so the plane the
 //probe returns stands in for it and the origin is projected onto that plane:
 //the diagonal's own impact point sits up to 4 units to the side of the
 //authored position. The plane is taken from the impact point rather than
 //from trace.plane_dist, which the entity pass does not propagate for brush
 //entities.
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 start[3];
	F64			 end[3];
	F64			 zero[3];
	F64			 rel[3];
	F64			 spot[3];
	F64			 dist;

	if (!e)
		return;

	if (e->skin >= 0 && hl_map)
	{
		HLVecSet(zero, 0.0, 0.0, 0.0);

		HLVecSet(start, e->origin[0] - 5.0, e->origin[1] - 5.0,
			e->origin[2] - 5.0);
		HLVecSet(end, e->origin[0] + 5.0, e->origin[1] + 5.0,
			e->origin[2] + 5.0);

		HLTraceEntity(hl_map, start, end, zero, zero, 0, TRUE, &tr);

		if (!tr.hit || tr.fraction >= 1.0)
			HLTraceEntity(hl_map, end, start, zero, zero, 0, TRUE, &tr);

		if (tr.hit && tr.fraction < 1.0)
		{
			//onto the plane, then HLPHYS_EPSILON back off it, which is the
			//standoff every traced decal already carries: HLRecursiveHullCheck
			//backs its impact point out of solid before returning it
			HLVecSub(e->origin, tr.end_pos, rel);
			dist = HLVecDot(rel, tr.plane_normal) - HLPHYS_EPSILON;
			HLVecMA(e->origin, -dist, tr.plane_normal, spot);

			HLDecalAdd(spot, tr.plane_normal, e->skin);
		}
	}

	//SUB_Remove. The whole entity is one think
	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

//--- trigger_cdaudio / target_cdaudio ---------------------------------------
//
// CTriggerCDAudio::PlayTrack, dlls/triggers.cpp:728: PlayCDTrack((int)health),
// then remove. "health" is the overloaded track number, -1 meaning stop
// (triggers.cpp:797-801).
//
// HLMusicPlay reads valve/music/trackNN.wav. The shipped tree carries the Steam
// MP3 layout in valve/media instead, which HLSound.ZC cannot decode, so a cue
// finds no file and returns FALSE. The cue itself is real either way.

U0 HLCDAudioPlay(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	I64			 track;

	if (!e)
		return;

	track = ToI64(e->health);

	//"if ( iTrack < -1 || iTrack > 30 )", triggers.cpp:786
	if (track >= -1 && track <= 30)
	{
		if (track == -1)
			HLMusicFree();
		else
			HLMusicPlay(track, tS);
	}

	//PlayTrack clears the touch and removes; target_cdaudio's Play does the
	//same through CTargetCDAudio::Play, triggers.cpp:794
	e->touch_fn   = HLM_NONE;
	e->use_fn     = HLM_NONE;
	e->in_use     = FALSE;
	e->think_fn   = HLM_NONE;
	e->next_think = 0.0;
}

U0 HLCDAudioRadiusThink(I64 self)
{//CTargetCDAudio::Think, dlls/triggers.cpp:775. Polls at 0.5s and fires when
 //the player is inside "radius". The SDK stuffs that key into pev->scale
 //(triggers.cpp:753); the parser here has a radius field of its own
	CHLEntity	*e = HLEntGet(self);
	F64			 rel[3];

	if (!e)
		return;

	HLVecSub(hl_ent_player_org, e->origin, rel);

	if (HLVecLength(rel) <= e->radius)
	{
		HLCDAudioPlay(self);
		return;
	}

	HLEntSetThink(e, HLM_CDAUDIO_RADIUS, hl_ent_time + 0.5);
}

//--- monstermaker -----------------------------------------------------------
//
// CMonsterMaker, dlls/monstermaker.cpp:33. 331 makers across 52 shipped maps.
//
// Its three own keys - monstertype, monstercount, m_imaxlivechildren - are not
// in the generic key table, so the entity lump is re-scanned for maker blocks
// the way HLEntParseMultiManagers re-scans for multi_manager ones. The rest of
// the state (live count, ground plane, active flag) has no CHLEntity field
// either and lives beside it.
//
// Children are allocated above hl_num_entities, which the parse pass leaves as
// the parsed count while the table itself is HLENT_MAX slots wide and zeroed by
// CAlloc (HLEnt.ZC:792). Growing the count is what makes HLAIMonSync notice a
// new monster.
//
// Deviations from the SDK, both forced:
//
//   DeathNotice is a callback the child fires at its owner. Nothing here calls
//   it, so the live count is recounted from the entity table on each think
//   instead. Same result, one scan per maker per delay.
//
//   SF_MONSTER_FALL_TO_GROUND is an engine drop the child gets on spawn. There
//   is none here, so the child is placed on the traced ground plane directly.

#define HLSF_MAKER_START_ON		1
#define HLSF_MAKER_CYCLIC		4

//SF_MONSTERMAKER_MONSTERCLIP passes SF_MONSTER_HITMONSTERCLIP to the child.
//func_monsterclip is inert here, so the bit is recognised and unused
#define HLSF_MAKER_MONSTERCLIP	8

//makers per map. c3a1, the busiest, has 33. Headroom for children comes out of
//HLENT_MAX: the fullest single-player map parses 719 entities against 1024
#define HLMAKER_MAX	64

class CHLMonsterMaker
{
	I64		ent;				//owning entity index
	U8		monster[64];		//monstertype, a monster_* classname
	I64		num_monsters;		//m_cNumMonsters, what is left to make
	I64		max_live;			//m_iMaxLiveChildren, 0 = no ceiling
	I64		live;				//m_cLiveChildren
	F64		ground;				//m_flGround, 0 until the first make traces it
	Bool	active;				//m_fActive
};

CHLMonsterMaker	hl_maker[HLMAKER_MAX];
I64				hl_maker_count = 0;
I64				hl_maker_made  = 0;		//children spawned this map, for the report

U0 HLMakerReset()
{//globals are not zeroed and this table is walked by name lookup
	I64 i;

	for (i = 0; i < HLMAKER_MAX; i++)
	{
		hl_maker[i].ent          = -1;
		hl_maker[i].monster[0]   = 0;
		hl_maker[i].num_monsters = 0;
		hl_maker[i].max_live     = 0;
		hl_maker[i].live         = 0;
		hl_maker[i].ground       = 0.0;
		hl_maker[i].active       = FALSE;
	}

	hl_maker_count = 0;
	hl_maker_made  = 0;
}

I64 HLMakerFind(I64 ent)
{
	I64 i;

	for (i = 0; i < hl_maker_count; i++)
	{
		if (hl_maker[i].ent == ent)
			return i;
	}

	return -1;
}

I64 HLMakerCountLive(I64 owner)
{//DeathNotice's decrement, recovered by counting. A child keeps its slot and
 //its owner after it dies; health at or below zero is what HLAI reads as dead
	I64 n = 0;
	I64 i;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use && hl_entities[i].owner == owner &&
			hl_entities[i].ent_class == HLC_MONSTER &&
			hl_entities[i].health > 0.0)
			n++;
	}

	return n;
}

Bool HLMakerBoxClear(CHLEntity *e, F64 ground)
{//"don't build a stack of monsters", monstermaker.cpp:176-183. A 68 unit square
 //column from the ground up to the maker, tested against monsters and the player
	F64	mins[3];
	F64	maxs[3];
	I64	i;

	HLVecSet(mins, e->origin[0] - 34.0, e->origin[1] - 34.0, ground);
	HLVecSet(maxs, e->origin[0] + 34.0, e->origin[1] + 34.0, e->origin[2]);

	if (!hl_ent_player_dead &&
		hl_ent_player_org[0] + 16.0 > mins[0] &&
		hl_ent_player_org[0] - 16.0 < maxs[0] &&
		hl_ent_player_org[1] + 16.0 > mins[1] &&
		hl_ent_player_org[1] - 16.0 < maxs[1] &&
		hl_ent_player_org[2] + 72.0 > mins[2] &&
		hl_ent_player_org[2] < maxs[2])
		return FALSE;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use ||
			hl_entities[i].ent_class != HLC_MONSTER ||
			hl_entities[i].health <= 0.0)
			goto qmbc_next;

		if (hl_entities[i].absmax[0] > mins[0] &&
			hl_entities[i].absmin[0] < maxs[0] &&
			hl_entities[i].absmax[1] > mins[1] &&
			hl_entities[i].absmin[1] < maxs[1] &&
			hl_entities[i].absmax[2] > mins[2] &&
			hl_entities[i].absmin[2] < maxs[2])
			return FALSE;

qmbc_next:
	}

	return TRUE;
}

U0 HLMakerMakeMonster(I64 self)
{//CMonsterMaker::MakeMonster, monstermaker.cpp:158
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*c;
	CHLTrace	 tr;
	U8			*path;
	F64			 down[3];
	F64			 zero[3];
	I64			 mk;
	I64			 child;
	I64			 n;

	if (!e)
		return;

	mk = HLMakerFind(self);

	if (mk < 0)
		return;

	//CREATE_NAMED_ENTITY takes any class; the child path here is the monster
	//spawn only. Two makers in the shipped maps name ammo_357 instead
	if (StrNICompare(hl_maker[mk].monster, "monster_", 8))
		return;

	if (hl_maker[mk].max_live > 0)
	{
		hl_maker[mk].live = HLMakerCountLive(self);

		if (hl_maker[mk].live >= hl_maker[mk].max_live)
			return;
	}

	//"set altitude. Now that I'm activated, any breakables, etc should be out
	//from under me", monstermaker.cpp:168-173. Traced once and kept.
	//
	//UTIL_TraceLine with ignore_monsters, so hull 0: the child stands on this z
	//and its mins are at its feet. A hull 1 sweep reports where the player
	//origin would rest, 36 units above the floor
	if (hl_maker[mk].ground == 0.0 && hl_map)
	{
		HLVecSet(zero, 0.0, 0.0, 0.0);
		HLVecSet(down, e->origin[0], e->origin[1], e->origin[2] - 2048.0);
		HLTraceEntity(hl_map, e->origin, down, zero, zero, 0, TRUE, &tr);
		hl_maker[mk].ground = tr.end_pos[2];
	}

	if (!HLMakerBoxClear(e, hl_maker[mk].ground))
		return;

	if (hl_num_entities >= HLENT_MAX)
		return;

	child = hl_num_entities;
	c     = &hl_entities[child];

	//a slot above the parsed count has never been written: HLEnt.ZC CAllocs the
	//whole HLENT_MAX table on every map load, so everything not set here is
	//already zero. Only the members whose resting value is not zero are listed
	HLStrCopy(c->classname, hl_maker[mk].monster, 64);

	c->brush_model      = -1;
	c->owner            = self;
	c->activator        = -1;
	c->beam_start       = -1;
	c->beam_end         = -1;
	c->light_style      = -1;
	c->light_valid      = FALSE;
	c->anim_event_frame = -1;
	c->anim_loop        = TRUE;
	c->framerate        = 10.0;
	c->scale            = 1.0;
	c->volume           = 1.0;
	c->modifier         = 100.0;
	c->blood_color      = 247;
	c->text_x           = -1.0;
	c->text_y           = -1.0;
	c->trigger_mode     = HLUSE_TOGGLE;
	c->toggle_state     = HLTS_AT_BOTTOM;

	HLVecCopy(e->origin, c->origin);
	HLVecCopy(e->angles, c->angles);

	//no engine drop for SF_MONSTER_FALL_TO_GROUND: stand the child on the plane
	//the altitude trace already found
	if (hl_maker[mk].ground != 0.0)
		c->origin[2] = hl_maker[mk].ground;

	//"if I have a netname (overloaded), give the child monster that name as a
	//targetname", monstermaker.cpp:210
	if (e->netname[0])
		HLStrCopy(c->targetname, e->netname, 64);

	//the parts of the monster_ spawn branch a child needs. That branch is in
	//HLEntSpawnClass, which compiles after this function, so it cannot be
	//called; HLAIMonRegisterAll overwrites the hull and health per kind
	c->movetype   = HLMOVETYPE_STEP;
	c->solid      = HLSOLID_SLIDEBOX;
	c->ent_class  = HLC_MONSTER;
	c->takedamage = HLDMG_TAKE_YES;
	c->health     = 20.0;
	c->spawned    = TRUE;
	c->in_use     = TRUE;

	HLVecSet(c->mins, -16.0, -16.0, 0.0);
	HLVecSet(c->maxs, 16.0, 16.0, 72.0);
	HLEntSetAbsBox(c);

	//UTIL_PrecacheOther's model. A child with none is scenery to
	//HLAIMonRegisterAll and never gets an AI slot
	path = HLEntModelForClass(c->classname);

	if (path)
	{
		c->studio = HLStudioCacheGet(path);

		if (c->studio)
			HLEntInitBoneControllers(c);
	}

	//the count moves last: HLAIMonSync registers on the change and must not see
	//a half-built slot
	hl_num_entities++;
	hl_maker_made++;

	//"delay already overloaded for this entity, so can't call SUB_UseTargets",
	//monstermaker.cpp:196-200
	if (e->target[0])
		HLEntFireTargetsNamed(e->target, self, self, HLUSE_TOGGLE, 0.0);

	hl_maker[mk].live++;

	if (hl_maker[mk].num_monsters > 0)
	{
		n = hl_maker[mk].num_monsters - 1;
		hl_maker[mk].num_monsters = n;

		//"Disable this forever. Don't kill it because it still gets death
		//notices", monstermaker.cpp:219
		if (n == 0)
		{
			hl_maker[mk].active = FALSE;
			e->use_fn   = HLM_NONE;
			e->think_fn = HLM_NONE;
			e->next_think = 0.0;
		}
	}
}

//--- monsters carried across a changelevel ----------------------------------
//
// CChangeLevel::BuildChangeList, triggers.cpp:1594: everything inside a
// trigger_transition volume named for the landmark crosses with the player.
// The destination table is parsed at a fixed count, so a carried monster is
// re-created there from this record, by the monstermaker's own recipe.
// c0a0d's barney1 rides to c0a0e this way; c0a0e defines his scripts and no
// barney.
//
// RAM state, like hl_ent_carry_*: it spans exactly one in-process transition
// and is not save-file material.

#define HLENT_CARRYM_MAX	8

class CHLCarryMon
{
	U8	classname[64];
	U8	targetname[64];
	F64	org[3];				//relative to the OLD map's landmark
	F64	ang[3];
	F64	health;
	I64	spawnflags;
	I64	weapons;			//an hgrunt's loadout
	I64	body;				//a scientist's head
	Bool	follow;			//was following the player
};

CHLCarryMon	hl_ent_carrym[HLENT_CARRYM_MAX];
I64			hl_ent_carrym_count = 0;

Bool HLEntCarryMonInVolume(U8 *landmark, CHLEntity *o)
{//inside a trigger_transition named for the landmark; with no such volume,
 //near the landmark itself, standing in for the SDK's PVS test
	CHLEntity	*t;
	F64			 d[3];
	I64			 i;
	Bool		 found = FALSE;

	for (i = 0; i < hl_num_entities; i++)
	{
		t = &hl_entities[i];

		if (StrCompare(t->classname, "trigger_transition"))
			goto qcmv_next;

		if (StrICompare(t->targetname, landmark))
			goto qcmv_next;

		found = TRUE;

		if (o->origin[0] >= t->absmin[0] && o->origin[0] <= t->absmax[0] &&
			o->origin[1] >= t->absmin[1] && o->origin[1] <= t->absmax[1] &&
			o->origin[2] >= t->absmin[2] && o->origin[2] <= t->absmax[2])
			return TRUE;

qcmv_next:
	}

	if (found)
		return FALSE;

	i = HLEntFindByTargetname(landmark, 0);

	if (i < 0)
		return FALSE;

	HLVecSub(o->origin, hl_entities[i].origin, d);

	return ToBool(HLVecLength(d) < 400.0);
}

U0 HLEntCarryMonSpawn()
{//the far side: re-create each record beside the new map's landmark. Runs at
 //the tail of HLEntSpawnAll, after every parsed class, so a targetname the
 //destination already defines wins and the record is dropped
	CHLCarryMon	*cm;
	CHLEntity	*c;
	U8			*path;
	I64			 lm;
	I64			 n;
	I64			 i;

	if (hl_ent_carrym_count <= 0)
		return;

	lm = HLEntFindByTargetname(hl_ent_changelevel_landmark, 0);

	for (n = 0; n < hl_ent_carrym_count; n++)
	{
		cm = &hl_ent_carrym[n];

		if (lm < 0)
			goto qcms_next;

		//the destination's own copy wins
		if (cm->targetname[0] &&
			HLEntFindByTargetname(cm->targetname, 0) >= 0)
			goto qcms_next;

		if (hl_num_entities >= HLENT_MAX)
			goto qcms_next;

		//HLMakerMakeMonster's recipe. The slot has never been written - the
		//table is CAlloc'd per map - so only non-zero resting values are set
		c = &hl_entities[hl_num_entities];

		HLStrCopy(c->classname, cm->classname, 64);
		HLStrCopy(c->targetname, cm->targetname, 64);

		c->brush_model      = -1;
		c->owner            = -1;
		c->activator        = -1;
		c->beam_start       = -1;
		c->beam_end         = -1;
		c->light_style      = -1;
		c->light_valid      = FALSE;
		c->anim_event_frame = -1;
		c->anim_loop        = TRUE;
		c->framerate        = 10.0;
		c->scale            = 1.0;
		c->volume           = 1.0;
		c->modifier         = 100.0;
		c->blood_color      = 247;
		c->text_x           = -1.0;
		c->text_y           = -1.0;
		c->trigger_mode     = HLUSE_TOGGLE;
		c->toggle_state     = HLTS_AT_BOTTOM;
		c->spawnflags       = cm->spawnflags;
		c->weapons          = cm->weapons;
		c->body             = cm->body;
		c->follow_player    = cm->follow;

		HLVecAdd(hl_entities[lm].origin, cm->org, c->origin);
		HLVecCopy(cm->ang, c->angles);

		c->movetype   = HLMOVETYPE_STEP;
		c->solid      = HLSOLID_SLIDEBOX;
		c->ent_class  = HLC_MONSTER;
		c->takedamage = HLDMG_TAKE_YES;
		c->health     = cm->health;
		c->spawned    = TRUE;
		c->in_use     = TRUE;

		HLVecSet(c->mins, -16.0, -16.0, 0.0);
		HLVecSet(c->maxs, 16.0, 16.0, 72.0);
		HLEntSetAbsBox(c);

		path = HLEntModelForClass(c->classname);

		if (path)
		{
			c->studio = HLStudioCacheGet(path);

			if (c->studio)
				HLEntInitBoneControllers(c);
		}

		//count moves last: HLAIMonSync registers on the change and must not
		//see a half-built slot
		hl_num_entities++;

qcms_next:
	}

	hl_ent_carrym_count = 0;
}

U0 HLMakerThink(I64 self)
{//CMonsterMaker::MakerThink, monstermaker.cpp:270
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);

	HLMakerMakeMonster(self);
}

U0 HLMakerUse(I64 self, I64 use_type)
{//CyclicUse drops one child per fire, monstermaker.cpp:241. ToggleUse flips the
 //think on and off, monstermaker.cpp:249
	CHLEntity	*e = HLEntGet(self);
	I64			 mk;

	if (!e)
		return;

	mk = HLMakerFind(self);

	if (mk < 0)
		return;

	if (e->spawnflags & HLSF_MAKER_CYCLIC)
	{
		HLMakerMakeMonster(self);
		return;
	}

	//ShouldToggle: an explicit ON or OFF that matches the current state is a
	//no-op, and only a TOGGLE flips
	if (use_type == HLUSE_ON && hl_maker[mk].active)
		return;

	if (use_type == HLUSE_OFF && !hl_maker[mk].active)
		return;

	if (hl_maker[mk].active)
	{
		hl_maker[mk].active = FALSE;
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	hl_maker[mk].active = TRUE;
	HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time);
}

//--- env_global -------------------------------------------------------------
#define HLSF_GLOBAL_SET_SPAWN	1

U0 HLGlobalUse(I64 self, I64 use_type)
{//triggermode overrides the incoming use type, which is how one env_global can
 //be fired by a generic trigger and still mean "turn this ON"
	CHLEntity	*e = HLEntGet(self);
	I64			 mode;
	I64			 state;

	if (!e || !e->global_state[0])
		return;

	mode = e->trigger_mode;

	if (mode == HLUSE_OFF || mode == HLUSE_ON || mode == HLUSE_SET)
		use_type = mode;

	state = HLEntGlobalGet(e->global_state);

	if (use_type == HLUSE_ON)
		state = HLGLOBAL_ON;
	else if (use_type == HLUSE_OFF)
		state = HLGLOBAL_OFF;
	else if (use_type == HLUSE_SET)
		state = HLGLOBAL_DEAD;
	else if (state == HLGLOBAL_ON)
		state = HLGLOBAL_OFF;
	else
		state = HLGLOBAL_ON;

	HLEntGlobalSet(e->global_state, state);
}

//--- items ------------------------------------------------------------------
//
// CItem::ItemTouch. Single player, so nothing respawns: a taken item is gone.
//
// A failed pickup leaves the item in the world: a medkit walked over at full
// health stays for later.

//gSkillData, gamerules.cpp:287-290. The four amounts that vary with difficulty.
//HLSkillApply in HLGame.ZC overwrites them from valve/skill.cfg at map load;
//the figures here are the skill 1 fallback and stand if the file is missing.
//30 is the deathmatch suit charger, multiplay_gamerules.cpp:139.
//
//Globals, not defines, because HLGame.ZC compiles after this file and can only
//push. Assigned by HLEntSkillDefaults below, since a declaration initialiser on
//a global does not run in this compiler
F64		hl_ent_healthkit;		//sk_healthkit,      skill.cfg:344
F64		hl_ent_battery;			//sk_battery,        skill.cfg:336
F64		hl_ent_charge_health;	//sk_healthcharger,  skill.cfg:340
F64		hl_ent_charge_armor;	//sk_suitcharger,    skill.cfg:332

U0 HLEntSkillDefaults()
{//run once at build time, not per map: HLSkillApply pushes over these at map
 //load and a per-map reset here would undo it
	hl_ent_healthkit     = 15.0;
	hl_ent_battery       = 15.0;
	hl_ent_charge_health = 50.0;
	hl_ent_charge_armor  = 75.0;
}

HLEntSkillDefaults;

U0 HLItemTouch(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 took = FALSE;
	I64			 pitch;

	if (!e)
		return;

	if (!StrICompare(e->classname, "item_healthkit"))
	{
		//gSkillData.healthkitCapacity, healthkit.cpp:76
		if (hl_ent_player_health < HLENT_MAX_HEALTH)
		{
			hl_ent_player_health += hl_ent_healthkit;

			if (hl_ent_player_health > HLENT_MAX_HEALTH)
				hl_ent_player_health = HLENT_MAX_HEALTH;

			//CHAN_ITEM on the player, healthkit.cpp:82
			HLSndPlayAt("items/smallmedkit1.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, hl_ent_player + 1, HLCHAN_ITEM);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_battery"))
	{
		//CItemBattery::MyTouch, items.cpp:225-226: armour below the cap and
		//the suit bit set. Without the suit there is nothing to charge, and
		//the battery stays on the floor for after item_suit
		if (hl_ent_player_armor < HLENT_MAX_ARMOR && hl_ent_player_suit)
		{
			//gSkillData.batteryCapacity, items.cpp:231
			hl_ent_player_armor += hl_ent_battery;

			if (hl_ent_player_armor > HLENT_MAX_ARMOR)
				hl_ent_player_armor = HLENT_MAX_ARMOR;

			//CHAN_ITEM on the player, items.cpp:234
			HLSndPlayAt("items/gunpickup2.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, hl_ent_player + 1, HLCHAN_ITEM);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_suit"))
	{
		if (!hl_ent_player_suit)
		{
			hl_ent_player_suit = TRUE;

			//EMIT_SOUND_SUIT, util.cpp: CHAN_STATIC at the suitvolume cvar,
			//silent below 0.05, pitch 98..104 on a coin flip. The sample is a
			//sentence: SF_SUIT_SHORTLOGON picks the one-line HEV_A0, the
			//default is the full HEV_AAx boot chain, items.cpp:315-320
			if (hl_snd_suitvol > 0.05)
			{
				pitch = HLPITCH_NORM;
				if (HLPartRandI(2))
					pitch = 98 + HLPartRandI(7);

				if (e->spawnflags & 1)
					HLSndEmitDyn("!HEV_A0", e->origin, hl_snd_suitvol,
						HLATTN_NORM, hl_ent_player + 1, HLCHAN_STATIC, pitch);
				else
					HLSndEmitDyn("!HEV_AAx", e->origin, hl_snd_suitvol,
						HLATTN_NORM, hl_ent_player + 1, HLCHAN_STATIC, pitch);
			}

			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_longjump"))
	{
		//the module needs the suit, as in HL
		if (!hl_ent_player_longjump && hl_ent_player_suit)
		{
			hl_ent_player_longjump = TRUE;
			//CHAN_ITEM on the player, items.cpp:234
			HLSndPlayAt("items/gunpickup2.wav", e->origin, 1.0,
				HLENT_SND_ATTEN, hl_ent_player + 1, HLCHAN_ITEM);
			took = TRUE;
		}
	}
	else if (!StrICompare(e->classname, "item_sodacan"))
	{
		//CItemSoda::CanTouch, effects.cpp:2244. One point of health, and the
		//dispenser is told its slot is clear again
		hl_ent_player_health += 1.0;

		if (hl_ent_player_health > HLENT_MAX_HEALTH)
			hl_ent_player_health = HLENT_MAX_HEALTH;

		if (e->owner >= 0 && e->owner < hl_num_entities)
			hl_entities[e->owner].toggle_state = HLTS_AT_BOTTOM;

		took = TRUE;
	}
	else if (!StrICompare(e->classname, "item_antidote") ||
		!StrICompare(e->classname, "item_security"))
	{
		//CItemAntidote and CItemSecurity, items.cpp:261 and :285. Neither has
		//an effect in the shipped game beyond a message
		//CHAN_ITEM on the player, weapons.cpp:1391
		HLSndPlayAt("items/smallmedkit1.wav", e->origin, 1.0, HLENT_SND_ATTEN,
			hl_ent_player + 1, HLCHAN_ITEM);
		took = TRUE;
	}

	if (!took)
		return;

	HLEntUseTargets(self, hl_ent_player, HLUSE_TOGGLE, 0.0);

	//not touchable again either way, but the slot outlives a deferred fire -
	//see HLM_AUTO_THINK
	e->solid = HLSOLID_NOT;

	if (e->think_fn == HLM_FIRE_TARGETS)
		e->remove_after_fire = TRUE;
	else
		e->in_use = FALSE;
}

//--- chargers ---------------------------------------------------------------
//
// func_healthcharger and func_recharge. FCAP_CONTINUOUS_USE, h_battery.cpp:39
// and healthkit.cpp:113: one point every 0.1s while +use is down, stopping on
// release, on a full player, or on an empty pool.
//
// The think runs while HLChargerUse keeps stamping use_last. A shell that only
// delivers the key edge stamps once and the drain stops HLENT_USE_HOLD_GAP
// later; one that delivers a held key drains for as long as it is held.
//
// The range test stands in for the SDK's trace to the charger.
//
// The two pool sizes are hl_ent_charge_health and hl_ent_charge_armor, above
// HLItemTouch: they vary with difficulty and so cannot be defines.
#define HLENT_CHARGE_STEP		0.1		//seconds between points
#define HLENT_CHARGE_RANGE		72.0	//how far you can stand and still charge

U0 HLChargerThink(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	F64			 dist[3];
	Bool		 health;
	Bool		 full;

	if (!e)
		return;

	//by classname, not by a reused field: "style" and "sounds" already carry a
	//lightstyle and a sound index
	health = ToBool(!StrICompare(e->classname, "func_healthcharger"));

	//key released. CBasePlayer::PlayerUse re-Uses a continuous entity only
	//while pev->button carries IN_USE, player.cpp:1669
	if (hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	HLVecSub(hl_ent_player_org, e->origin, dist);

	if (HLVecLength(dist) > HLENT_CHARGE_RANGE)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	if (e->charge <= 0.0)
	{
		//CHAN_ITEM. CWallHealth::Use, healthkit.cpp:204, at volume 1.0;
		//CRecharge::Use, h_battery.cpp:126, at 0.85. Refusal plays once and
		//then the charger goes quiet.
		if (health)
			HLEntSound(self, e, "items/medshotno1.wav", HLCHAN_ITEM, 1.0);
		else
			HLEntSound(self, e, "items/suitchargeno1.wav", HLCHAN_ITEM, 0.85);

		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	full = FALSE;

	if (health)
	{
		if (hl_ent_player_health >= HLENT_MAX_HEALTH)
			full = TRUE;
		else
			hl_ent_player_health += 1.0;
	}
	else
	{
		if (hl_ent_player_armor >= HLENT_MAX_ARMOR)
			full = TRUE;
		else
			hl_ent_player_armor += 1.0;
	}

	if (full)
	{
		HLEntSetThink(e, HLM_NONE, 0.0);
		return;
	}

	e->charge -= 1.0;

	HLEntSetThink(e, HLM_CHARGER_THINK, hl_ent_time + HLENT_CHARGE_STEP);
}

U0 HLChargerUse(I64 self)
{
	CHLEntity	*e = HLEntGet(self);
	Bool		 first;
	Bool		 health;

	if (!e)
		return;

	health = ToBool(!StrICompare(e->classname, "func_healthcharger"));

	//a gap in the stamp means the key was released between this use and the
	//last, which is where the start cue belongs
	first       = ToBool(hl_ent_time - e->use_last > HLENT_USE_HOLD_GAP);
	e->use_last = hl_ent_time;

	if (e->charge <= 0.0)
	{
		//healthkit.cpp:204 and h_battery.cpp:126
		if (first && health)
			HLEntSound(self, e, "items/medshotno1.wav", HLCHAN_ITEM, 1.0);
		else if (first)
			HLEntSound(self, e, "items/suitchargeno1.wav", HLCHAN_ITEM, 0.85);

		return;
	}

	//the start cue only. the SDK loops for as long as it is charging; stopping
	//a loop needs a channel this side can reclaim.
	//healthkit.cpp:221 and h_battery.cpp:154, both CHAN_ITEM
	if (first)
	{
		if (health)
			HLEntSound(self, e, "items/medshot4.wav", HLCHAN_ITEM, 1.0);
		else
			HLEntSound(self, e, "items/suitchargeok1.wav", HLCHAN_ITEM, 0.85);
	}

	//already draining: the think owns the pacing, and re-entering it here
	//would give a point per tick instead of one every HLENT_CHARGE_STEP
	if (e->think_fn == HLM_CHARGER_THINK)
		return;

	HLChargerThink(self);
}

//--- Xen flora --------------------------------------------------------------
//
// dlls/xen.cpp. 184 instances across c4a1-c4a3: xen_plantlight 76, xen_hair 35,
// xen_spore_small 30, xen_tree 24, xen_spore_medium 15, xen_spore_large 4. All
// but 7 carry no "model" key, so the class table in HLEnt.ZC is what draws
// them.
//
// Every one is a CActAnimating and loops its idle. The port's studio playback
// derives the cycle from hl_ent_time - anim_start with anim_loop set, so a
// looping prop needs no think.
//
// Absent: CXenPLight's glow sprite child (xen.cpp:99, XEN_PLANT_GLOW_SPRITE on
// attachment 1) and CXenSporeLarge's five leg hulls (xen.cpp:527) - both create
// a second entity, and the entity table is fixed at parse time.

//25 damage, DMG_CRUSH|DMG_SLASH, CXenTree::HandleAnimEvent, xen.cpp:375
#define HLXEN_TREE_DAMAGE	25.0

//the attack take at framerate 1.0-1.4, xen.cpp:344. Stands in for
//GetActivity() == ACT_IDLE, which the SDK gates the next swing on
#define HLXEN_TREE_WAIT		1.5

U8 *HLEntXenTreeHitSound()
{//CXenTree::pAttackHitSounds, xen.cpp:316-321
	I64 n = HLFxRandI(0, 2);

	if (n == 0)
		return "zombie/claw_strike1.wav";

	if (n == 1)
		return "zombie/claw_strike2.wav";

	return "zombie/claw_strike3.wav";
}

U0 HLXenTreeTouch(I64 self)
{//CXenTree::Touch, xen.cpp:336, then the TREE_AE_ATTACK anim event, xen.cpp:355
 //
 //Deviation: the SDK's damage sweeps UTIL_EntitiesInBox over a 48x48x128
 //CXenTreeTrigger child parked 64 units along the tree's forward vector
 //(xen.cpp:311). Creating that child needs an entity slot and the table is
 //fixed at parse time, so the swing lands on the toucher instead. The
 //15-degree punchangle and the 100 unit shove are not applied: neither the
 //view punch nor a player velocity write is reachable from this file.
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//"if ( GetActivity() == ACT_IDLE )", xen.cpp:344 - one swing at a time
	if (e->pain_finished > hl_ent_time)
		return;

	e->pain_finished = hl_ent_time + HLXEN_TREE_WAIT;

	HLEntHurtPlayer(HLXEN_TREE_DAMAGE, HLDMG_CRUSH | HLDMG_SLASH, e->origin);

	//pAttackHitSounds, xen.cpp:316-321, CHAN_WEAPON
	HLEntSound(self, e, HLEntXenTreeHitSound(), HLCHAN_WEAPON, 1.0);
}

Bool HLEntCapsContinuousUse(CHLEntity *e)
{//FCAP_CONTINUOUS_USE: the class is Used every frame IN_USE is down rather
 //than once on the press, player.cpp:1669
 //
 //The wall chargers (h_battery.cpp:39, healthkit.cpp:113) and
 //momentary_rot_button unless SF_MOMENTARY_DOOR is set (buttons.cpp:886).
 //CPushable also carries it, func_break.cpp:790; pushing is a physics path
 //this port does not have
	if (e->use_fn == HLM_CHARGER_USE)
		return TRUE;

	//CPushable, func_break.cpp:790: the pull runs for as long as the key is
	//held, which is also what suppresses the push in Touch
	if (e->use_fn == HLM_PUSH_MOVE_USE)
		return TRUE;

	if (e->use_fn != HLM_MOMENTARY_USE)
		return FALSE;

	return ToBool(!(e->spawnflags & HLSF_MOMENTARY_DOOR));
}

//func_conveyor, dlls/bmodels.cpp:144-145
#define HLSF_CONVEYOR_VISUAL		1
#define HLSF_CONVEYOR_NOTSOLID	2

//--- func_pushable ----------------------------------------------------------
//
// CPushable, dlls/func_break.cpp:790. A crate the player shoves along the floor
// to climb on. Sharing func_breakable's branch left all of them nailed down.
//
// Two deviations from the SDK, both forced:
//
//   MOVETYPE_PUSHSTEP has no counterpart here - HLMOVETYPE_ stops at BOUNCE -
//   and the HLMOVETYPE_PUSH mover pass integrates velocity with no world
//   trace, which a crate would use to leave the map. A pushable is stepped by
//   HLEntPushableStep instead: gravity, a traced move, ground friction.
//
//   SOLID_BBOX is not collidable in this tree. HLClipToNativeBrushes clips only
//   entities whose solid is HLSOLID_BSP, so a pushable on SOLID_BBOX could be
//   walked through and not stood on. It keeps SOLID_BSP and its brush hull.
//
// Also absent: the "size" key's player-hull bboxes (func_break.cpp:860). The
// brush hull is what the trace and the draw already agree on.

#define HLSF_PUSH_BREAKABLE		128		//dlls/util.h:447
#define HLPUSH_MAX_FRICTION		399.0	//func_break.cpp:831
#define HLPUSH_BASE_SPEED		400.0	//m_maxSpeed = 400 - friction
#define HLPUSH_SOUND_GAP			0.7		//func_break.cpp:996

//sv_friction and its floor, PM_Friction. The engine runs MOVETYPE_PUSHSTEP
//through SV_Physics_Step, which applies ground friction the same way.
#define HLPUSH_FRICTION			4.0
#define HLPUSH_STOP_SPEED		100.0

//below this the crate is parked, so it does not creep for minutes after a shove
#define HLPUSH_MIN_SPEED			2.0

//1000 units^3 standard volume, func_break.cpp:922
#define HLPUSH_BUOY_SCALE		0.0005

U8 *HLPushableSound(I64 n)
{//CPushable::m_soundNames, func_break.cpp:817
	if (n == 1)		return "debris/pushbox2.wav";
	if (n == 2)		return "debris/pushbox3.wav";

	return "debris/pushbox1.wav";
}

Bool HLPushableInWater(CHLEntity *e)
{//pev->waterlevel on the crate. No entity here carries one, so the brush
 //centre is sampled directly
	F64 centre[3];
	I64 i;

	if (!hl_map)
		return FALSE;

	for (i = 0; i < 3; i++)
		centre[i] = e->origin[i] + (e->mins[i] + e->maxs[i]) * 0.5;

	return ToBool(HLPointContents(hl_map, centre) == HLCONTENTS_WATER);
}

U0 HLPushableMove(I64 self, Bool push)
{//CPushable::Move, func_break.cpp:919. pOther is always the player: nothing
 //else in this port shoves crates, so playerTouch is implied and the 0.25
 //monster factor is unreachable.
 //
 //push is the SDK's argument: 1 from Touch, 0 from Use, which is the pull.
	CHLEntity	*e = HLEntGet(self);
	F64			 factor;
	F64			 length;
	F64			 vx;
	F64			 vy;
	Bool		 wet;

	if (!e)
		return;

	wet = HLPushableInWater(e);

	//"Is entity standing on this pushable?" A rider only makes it bob
	if (hl_pm_onground != -1 && hl_ground_native == self)
	{
		if (wet)
			e->velocity[2] += hl_pm_vel[2] * 0.1;

		return;
	}

	//"Don't push away from jumping/falling players unless in water"
	if (hl_pm_onground == -1)
	{
		if (!wet)
			return;

		factor = 0.1;
	}
	else
		factor = 1.0;

	//"Always apply this if pushing, or if under the player's velocity"
	vx = e->velocity[0];
	vy = e->velocity[1];

	if (push || HLEntAbsF(vx) <
		HLEntAbsF(hl_pm_vel[0] - hl_pm_vel[0] * factor))
		e->velocity[0] = vx + hl_pm_vel[0] * factor;

	if (push || HLEntAbsF(vy) <
		HLEntAbsF(hl_pm_vel[1] - hl_pm_vel[1] * factor))
		e->velocity[1] = vy + hl_pm_vel[1] * factor;

	length = Sqrt(e->velocity[0] * e->velocity[0] +
				  e->velocity[1] * e->velocity[1]);

	if (length > e->push_max_speed && length > 0.0)
	{
		e->velocity[0] = e->velocity[0] * e->push_max_speed / length;
		e->velocity[1] = e->velocity[1] * e->push_max_speed / length;
	}

	//Deviation: "Match the player to our pushable's velocity" is dropped. The
	//player's velocity for this tick has already been written back by
	//HLPlayerMove - the touch pass runs after the move - and the crate is
	//SOLID_BSP, so the block that produced the touch already stopped them.

	//func_break.cpp:995. One scrape at most every 0.7s while the crate is
	//actually sliding on the ground
	if (hl_ent_time - e->push_snd_time <= HLPUSH_SOUND_GAP)
		return;

	e->push_snd_time = hl_ent_time;

	//The SDK's else branch is a STOP_SOUND on CHAN_WEAPON. A scrape here is a
	//one-shot half a second long with no handle to stop, and CPushable's own
	//StopSound is compiled out of the SDK (func_break.cpp:1012).
	if (length <= 0.0 || hl_pm_onground == -1)
		return;

	e->push_snd_last = HLPartRandI(3);

	HLEntSound(self, e, HLPushableSound(e->push_snd_last),
		HLCHAN_WEAPON, 0.5);
}

U0 HLPushableTouch(I64 self)
{//CPushable::Touch, func_break.cpp:910
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//"Don't push unless the player is not useing (pull)". use_last is the +use
	//stamp HLEntUseInFront leaves on this crate, standing in for IN_USE
	if (hl_ent_time - e->use_last <= HLENT_USE_HOLD_GAP)
		return;

	HLPushableMove(self, TRUE);
}

U0 HLPushableUse(I64 self, I64 activator)
{//CPushable::Use, func_break.cpp:895 - the +use pull
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//"if ( !pActivator || !pActivator->IsPlayer() )". A fired chain carries a
	//caller; HLEntUseInFront, which is the +use path, leaves it -1. That is the
	//only distinction available - hl_ent_player is 0, and so is worldspawn
	if (hl_ent_call_caller >= 0)
	{
		if (e->spawnflags & HLSF_PUSH_BREAKABLE)
			HLEntQueueCall(self, HLM_BREAK_DIE, activator, HLUSE_TOGGLE, 0.0);

		return;
	}

	e->use_last = hl_ent_time;

	//"if ( pActivator->pev->velocity != g_vecZero )"
	if (hl_pm_vel[0] == 0.0 && hl_pm_vel[1] == 0.0 && hl_pm_vel[2] == 0.0)
		return;

	HLPushableMove(self, FALSE);
}


//--- multisource ------------------------------------------------------------
//
// CMultiSource, dlls/buttons.cpp:169. An AND gate in front of a master check:
// every entity that targets it must have fired before a door naming it as
// master will open.
//
// Register, buttons.cpp:239, walks the map collecting the inputs. The SDK runs
// it from a think at spawn + 0.1, which lands after ED_LoadFromFile has built
// every entity. This port has no Activate phase, so the walk runs at the end of
// HLEntSpawnAll - the same point in the load, without the think.
//
// The satisfied state lives in toggle_state, where HLEntMasterAllows already
// reads it: AT_TOP is m_fActive.

#define HLSF_MULTI_INIT		1		//buttons.cpp:169
#define HLENT_MS_TARGETS	32		//MS_MAX_TARGETS, cbase.h:428
#define HLENT_MS_MAX		64		//multisources tracked per map

class CHLMultiSource
{
	I64		ent;						//owning entity index
	I64		count;						//m_iTotal
	I64		target[HLENT_MS_TARGETS];	//m_rgEntities, as entity indices
	Bool	fired[HLENT_MS_TARGETS];	//m_rgTriggered
};

CHLMultiSource	hl_ms[HLENT_MS_MAX];
I64				hl_ms_count = 0;

I64 HLMultiSourceSlot(I64 self)
{//the registration record for an entity index, -1 for none
	I64 i;

	for (i = 0; i < hl_ms_count; i++)
	{
		if (hl_ms[i].ent == self)
			return i;
	}

	return -1;
}

Bool HLMultiSourceTriggered(I64 self)
{//CMultiSource::IsTriggered, buttons.cpp:213
	CHLEntity	*e = HLEntGet(self);
	I64			 s;
	I64			 i;

	if (!e)
		return FALSE;

	//"Still initializing?" - the registration walk has not run yet
	if (e->spawnflags & HLSF_MULTI_INIT)
		return FALSE;

	s = HLMultiSourceSlot(self);

	//No record means no inputs were collected. IsTriggered's loop exits with
	//i == m_iTotal at zero, so an input-less multisource is satisfied; a map
	//that names one and targets it from nowhere is not meant to lock
	if (s >= 0)
	{
		for (i = 0; i < hl_ms[s].count; i++)
		{
			if (!hl_ms[s].fired[i])
				return FALSE;
		}
	}

	//m_globalstate: a cross-level lock is satisfied by its inputs and by a flag
	//an earlier map set
	if (e->global_state[0])
		return ToBool(HLEntGlobalGet(e->global_state) == HLGLOBAL_ON);

	return TRUE;
}

U0 HLMultiSourcePublish(I64 self)
{//IsTriggered's answer, into the field HLEntMasterAllows reads
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (HLMultiSourceTriggered(self))
		e->toggle_state = HLTS_AT_TOP;
	else
		e->toggle_state = HLTS_AT_BOTTOM;
}

U0 HLMultiSourceUse(I64 self, I64 activator, I64 caller)
{//CMultiSource::Use, buttons.cpp:182
	CHLEntity	*e = HLEntGet(self);
	I64			 s;
	I64			 i;
	I64			 use;

	if (!e)
		return;

	s = HLMultiSourceSlot(self);

	if (s >= 0 && caller >= 0)
	{
		for (i = 0; i < hl_ms[s].count; i++)
		{
			if (hl_ms[s].target[i] != caller)
				goto qms_next;

			//"a Use input to the multisource always toggles" - the useType is
			//deliberately ignored
			hl_ms[s].fired[i] = !hl_ms[s].fired[i];
			break;

qms_next:
		}
	}

	HLMultiSourcePublish(self);

	if (e->toggle_state != HLTS_AT_TOP)
		return;

	//USE_ON rather than USE_TOGGLE when a global state gates it, so a
	//cross-level lock cannot close what it just opened
	use = HLUSE_TOGGLE;
	if (e->global_state[0])
		use = HLUSE_ON;

	HLEntUseTargets(self, activator, use, 0.0);
}

U0 HLMultiSourceRegister(I64 self)
{//CMultiSource::Register, buttons.cpp:239
	CHLEntity	*e = HLEntGet(self);
	I64			 s;
	I64			 i;
	I64			 j;
	I64			 m;

	if (!e || !e->targetname[0])
		return;

	if (hl_ms_count >= HLENT_MS_MAX)
		return;

	s = hl_ms_count;
	hl_ms_count++;

	hl_ms[s].ent   = self;
	hl_ms[s].count = 0;

	//"search for all entities which target this multisource"
	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_ms[s].count >= HLENT_MS_TARGETS)
			goto qmsr_done;

		if (!hl_entities[i].in_use || i == self)
			goto qmsr_next;

		if (StrCompare(hl_entities[i].target, e->targetname))
			goto qmsr_next;

		hl_ms[s].target[hl_ms[s].count] = i;
		hl_ms[s].fired[hl_ms[s].count]  = FALSE;
		hl_ms[s].count++;

qmsr_next:
	}

	//The second pass: a multi_manager holds its targets as keys, not in
	//pev->target, so HasTarget is the only way to see them
	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_ms[s].count >= HLENT_MS_TARGETS)
			goto qmsr_done;

		if (!hl_entities[i].in_use || i == self)
			goto qmsr_mm_next;

		if (StrCompare(hl_entities[i].classname, "multi_manager"))
			goto qmsr_mm_next;

		m = HLMMFind(i);
		if (m < 0)
			goto qmsr_mm_next;

		for (j = 0; j < hl_mm[m].count; j++)
		{
			if (StrCompare(&hl_mm[m].name[j * 64], e->targetname))
				goto qmsr_key_next;

			hl_ms[s].target[hl_ms[s].count] = i;
			hl_ms[s].fired[hl_ms[s].count]  = FALSE;
			hl_ms[s].count++;
			goto qmsr_mm_next;

qmsr_key_next:
		}

qmsr_mm_next:
	}

qmsr_done:

	//SF_MULTI_INIT is cleared last: IsTriggered answers FALSE while it is set.
	//Subtracted rather than masked out - the bit is known to be set here
	if (e->spawnflags & HLSF_MULTI_INIT)
		e->spawnflags = e->spawnflags - HLSF_MULTI_INIT;

	HLMultiSourcePublish(self);
}

U0 HLMultiSourceRegisterAll()
{//every multisource in the map, once the spawn pass has built them all
	I64 i;

	hl_ms_count = 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qmsra_next;

		if (hl_entities[i].use_fn != HLM_MULTISOURCE_USE)
			goto qmsra_next;

		HLMultiSourceRegister(i);

qmsra_next:
	}
}

//--- trigger volumes that act on the player ---------------------------------

U0 HLConveyorTouch(I64 self)
{//func_conveyor. FL_CONVEYOR, dlls/bmodels.cpp:162: the engine folds
 //movedir * speed into pmove->basevelocity for whatever stands on the brush.
 //
 //hl_conveyor_velocity is that channel. Base velocity is added before the move
 //and subtracted after, so it neither accumulates nor survives stepping off;
 //HLEntTouchPlayer clears it beside hl_surface_friction, which has no event to
 //hang a restore on either.
	CHLEntity	*e = HLEntGet(self);
	F64			 speed;
	I64			 i;

	if (!e)
		return;

	//dlls/bmodels.cpp:170. Signed: CFuncConveyor::Use negates it to reverse
	//the belt
	speed = e->speed;
	if (speed == 0.0)
		speed = 100.0;

	for (i = 0; i < 3; i++)
		hl_conveyor_velocity[i] = e->move_dir[i] * speed;

	hl_conveyor_active = TRUE;
}

U0 HLFrictionTouch(I64 self)
{//func_friction. "modifier" is a percentage, 100 being normal
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	//hl_surface_friction belongs to HLClip.ZC, which reads it inside
	//PM_Friction. HLEntFrame puts it back to 1.0 every tick, so stepping off
	//the brush restores normal traction without the brush being told
	hl_surface_friction = e->modifier / 100.0;

	if (hl_surface_friction <= 0.0)
		hl_surface_friction = 0.05;
}

U0 HLGravityTouch(I64 self)
{//trigger_gravity. persistent, not per tick - see hl_ent_gravity
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	hl_ent_gravity = e->gravity;

	if (hl_ent_gravity <= 0.0)
		hl_ent_gravity = 1.0;
}

U0 HLChangeLevelTouch(I64 self)
{//trigger_changelevel. the map name and the landmark are posted for the shell
 //
 //the trigger takes itself out of use immediately: the request sits for several
 //ticks until the shell's loop drains it, and a brush trigger re-touches on
 //every one of them
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*car;
	CHLEntity	*o;
	CHLCarryMon	*cm;
	I64			 lm;
	I64			 ride;
	I64			 i;

	//cllog: every gate below is a stage, so a touch that fires and does nothing
	//is told apart from one that never fires
	hl_cl_touches++;
	hl_cl_stage = 1;

	if (!e)
		return;

	hl_cl_stage = 2;

	if (!HLEntMasterAllows(e))
		return;

	hl_cl_stage = 3;

	if (!e->next_map[0])
		return;

	hl_cl_stage = 4;

	if (hl_ent_changelevel_pending)
		return;

	hl_cl_stage = 5;

	HLStrCopy(hl_ent_changelevel, e->next_map, 64);
	HLStrCopy(hl_ent_changelevel_landmark, e->landmark, 64);
	hl_ent_changelevel_pending = TRUE;

	//The car the player is riding goes with them. See the hl_ent_carry_* note:
	//placement is stored relative to this map's landmark, because the two maps
	//share no world origin.
	hl_ent_carry_valid = FALSE;

	lm   = HLEntFindByTargetname(e->landmark, 0);
	ride = hl_ground_native;

	if (lm >= 0 && HLEntValid(ride))
	{
		car = &hl_entities[ride];

		if (car->ent_class == HLC_TRACKTRAIN)
		{
			HLVecSub(car->origin, hl_entities[lm].origin, hl_ent_carry_org);
			HLVecCopy(car->angles, hl_ent_carry_ang);
			//globalname is the transition identity, saverestore.cpp. targetname
			//is reused freely between maps; globalname is not.
			HLStrCopy(hl_ent_carry_name, car->global_name, 64);
			HLStrCopy(hl_ent_carry_path, car->target, 64);
			hl_ent_carry_speed = car->speed;
			hl_ent_carry_valid = TRUE;
		}
	}

	//live monsters inside the transition volume cross too - BuildChangeList,
	//triggers.cpp:1594. Recorded relative to this map's landmark and re-created
	//on the far side by HLEntCarryMonSpawn
	hl_ent_carrym_count = 0;

	if (lm >= 0)
	{
		for (i = 0; i < hl_num_entities; i++)
		{
			o = &hl_entities[i];

			if (!o->in_use || o->ent_class != HLC_MONSTER)
				goto qclt_next_mon;

			if (o->health <= 0.0)
				goto qclt_next_mon;

			if (hl_ent_carrym_count >= HLENT_CARRYM_MAX)
				goto qclt_next_mon;

			if (!HLEntCarryMonInVolume(e->landmark, o))
				goto qclt_next_mon;

			cm = &hl_ent_carrym[hl_ent_carrym_count];

			HLStrCopy(cm->classname, o->classname, 64);
			HLStrCopy(cm->targetname, o->targetname, 64);
			HLVecSub(o->origin, hl_entities[lm].origin, cm->org);
			HLVecCopy(o->angles, cm->ang);
			cm->health     = o->health;
			cm->spawnflags = o->spawnflags;
			cm->weapons    = o->weapons;
			cm->body       = o->body;
			cm->follow     = o->follow_player;

			hl_ent_carrym_count++;

qclt_next_mon:
		}
	}

	e->in_use = FALSE;
	e->solid  = HLSOLID_NOT;
}

U0 HLAutoSaveTouch(I64 self)
{//CTriggerSave::SaveTouch, triggers.cpp:1977
 //
 //Only the player touches this port's triggers, so the IsPlayer test has no
 //counterpart. The volume takes itself out of use on the first touch, as the
 //SDK's SetTouch(NULL)/UTIL_Remove does: the request sits until the shell's
 //loop drains it and a brush trigger re-touches on every tick until then
	CHLEntity *e = HLEntGet(self);

	if (!e)
		return;

	if (!HLEntMasterAllows(e))
		return;

	e->in_use = FALSE;
	e->solid  = HLSOLID_NOT;

	hl_ent_autosave_pending = TRUE;
}

U0 HLCorpseFall(I64 self)
{//CBaseMonster::CorpseFallThink, monsters.cpp:3246
 //
 //MonsterInitDead leaves the corpse on MOVETYPE_TOSS with a zero-size hull and
 //lets SV_Physics_Toss drop the origin until FL_ONGROUND. Nothing in this port
 //integrates MOVETYPE_TOSS for a CHLEntity, so the whole fall is one point
 //trace: with a zero box the toss endpoint is the first solid below the origin.
 //
 //Deferred half a second, as the SDK's think is, so every brush entity in the
 //map has spawned and is solid. 2 of the 144 shipped corpses come to rest on a
 //func_wall rather than on the world, both in c4a3.
 //
 //The sweep is 256 units. 143 of the 144 rest within 32 of the floor below
 //them; the exception is a c4a3 hevsuit over a 712 unit shaft, and a corpse
 //that finds nothing is left where the map put it rather than sunk by the full
 //sweep length.
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 zero[3];
	F64			 down[3];

	if (!e || !hl_map)
		return;

	HLVecSet(zero, 0.0, 0.0, 0.0);
	HLVecSet(down, e->origin[0], e->origin[1], e->origin[2] - 256.0);

	//ignore_monsters, so hull 0: the pose is authored with its lowest point at
	//the origin. Measured over every dead pose the four dead classes name, the
	//deepest sequence bbox reaches 3.9 units below it (hgrunt "deadside")
	HLTraceEntity(hl_map, e->origin, down, zero, zero, 0, TRUE, &tr);

	if (!tr.hit || tr.start_solid || tr.all_solid)
		return;

	HLVecCopy(tr.end_pos, e->origin);
	HLEntSetAbsBox(e);
}

//--- the dispatcher ---------------------------------------------------------
//
// The virtual call. Defined last, so every implementation above is visible;
// that is why methods are integers.

U0 HLEntCallMethod(I64 self, I64 method, I64 activator = -1,
	I64 use_type = HLUSE_TOGGLE, F64 value = 0.0)
{
	CHLEntity *e = HLEntGet(self);

	if (!e || method == HLM_NONE)
		return;

	switch (method)
	{
		case HLM_REMOVE:
			e->in_use = FALSE;
			e->solid  = HLSOLID_NOT;
			break;

		case HLM_FIRE_TARGETS:
			HLEntSetThink(e, HLM_NONE, 0.0);
			HLEntFireTargets(self, e->activator, use_type, value);

			//a fire-once entity that deferred through its delay is removed
			//HERE, not at the call site: see HLM_AUTO_THINK
			if (e->remove_after_fire)
			{
				HLEntGlobalNameDied(e);
				e->in_use = FALSE;
			}
			break;

		case HLM_MOVE_DONE:
			//arrival: stop, snap to the exact destination, then hand over to
			//whatever asked for the move. moving_angular keeps the two kinds
			//of move apart - an angular arrival must not snap the origin to a
			//finaldest left over from a previous linear move
			if (e->moving_angular)
			{
				HLVecCopy(e->finalangle, e->angles);
				HLVecSet(e->avelocity, 0.0, 0.0, 0.0);
				e->moving_angular = FALSE;

				//the rotating box is the orientation-independent radius, so it
				//is rebuilt even though the origin did not move
				HLEntSetAbsBox(e);
			}
			else
			{
				HLVecCopy(e->finaldest, e->origin);
				HLVecSet(e->velocity, 0.0, 0.0, 0.0);
				HLEntSetAbsBox(e);
			}

			HLEntSetThink(e, HLM_NONE, 0.0);
			HLEntCallMethod(self, e->move_done, activator, use_type, value);
			break;

		case HLM_DOOR_GO_UP:		HLDoorGoUp(self, activator);	break;
		case HLM_DOOR_GO_DOWN:		HLDoorGoDown(self);				break;
		case HLM_DOOR_HIT_TOP:		HLDoorHitTop(self);				break;
		case HLM_DOOR_HIT_BOTTOM:	HLDoorHitBottom(self);			break;
		case HLM_DOOR_USE:			HLDoorUse(self, activator);		break;
		case HLM_DOOR_GROUP:		HLDoorUseGroup(self, activator);	break;
		case HLM_DOOR_LEAF:
			//a leaf reached through its group. Whether it swings or slides is
			//the leaf's own business, so a mixed group works
			if (e->use_fn == HLM_ROT_DOOR_USE)
				HLRotDoorUseLeaf(self, activator);
			else
				HLDoorUseLeaf(self, activator);
			break;

		case HLM_DOOR_TOUCH:
			//Belt over the latch: a touch queued the tick the door started
			//moving still lands after the latch cleared touch_fn. The rest
			//states mirror the Use gate - AT_BOTTOM, or AT_TOP on a
			//NO_AUTO_RETURN door, whose touch DoorHitTop restores so a touch
			//can close it, doors.cpp:630
			if (e->toggle_state != HLTS_AT_BOTTOM &&
				!(e->toggle_state == HLTS_AT_TOP &&
				  (e->spawnflags & HLSF_DOOR_TOGGLE)))
				break;

			HLDoorTouch(self, activator);
			break;

		case HLM_DOOR_BLOCKED:		HLDoorBlocked(self, activator);	break;
		case HLM_PLAT_BLOCKED:		HLPlatBlocked(self, activator);	break;

		case HLM_BUTTON_USE:		HLButtonUse(self, activator);	break;
		case HLM_BUTTON_TOUCH:
			if (e->spawnflags & HLSF_BUTTON_TOUCH_ONLY)
				HLButtonUse(self, activator);
			break;
		case HLM_BUTTON_GO_UP:		HLButtonGoUp(self, activator);	break;
		case HLM_BUTTON_GO_DOWN:	HLButtonGoDown(self);			break;
		case HLM_BUTTON_HIT_TOP:	HLButtonHitTop(self);			break;
		case HLM_BUTTON_HIT_BOTTOM:	HLButtonHitBottom(self);		break;
		case HLM_BUTTON_RETURN:		HLButtonGoDown(self);			break;

		case HLM_TRAIN_NEXT:		HLTrainNext(self);				break;
		case HLM_TRAIN_WAIT:		HLTrainWait(self);				break;
		case HLM_TRAIN_USE:			HLTrainUse(self, use_type);		break;
		case HLM_TRAIN_START:		HLTrainNext(self);				break;
		case HLM_TRAIN_BLOCKED:		HLTrainBlocked(self, activator); break;
		case HLM_TRAIN_DEADEND:		HLTrackDeadEnd(self);			break;

		case HLM_TRACK_FIND:		HLTrackFind(self);				break;
		case HLM_TRACK_USE:			HLTrackUse(self, activator);	break;
		case HLM_TRACK_HIT_TOP:		HLTrackHitTop(self);			break;
		case HLM_TRACK_HIT_BOTTOM:	HLTrackHitBottom(self);			break;

		case HLM_CORPSE_FALL:		HLCorpseFall(self);				break;

		case HLM_TRIGGER_TOUCH:		HLTriggerTouch(self, activator); break;
		case HLM_TRIGGER_USE:		HLTriggerUse(self, activator);	break;
		case HLM_RELAY_USE:			HLTriggerUse(self, activator);	break;
		case HLM_TRIGGER_ENABLE:	HLTriggerToggleUse(self);		break;

		case HLM_AUTO_THINK:
			//trigger_auto fires once at level start and is then gone.
			//
			//The removal cannot happen here when the entity has a delay key:
			//HLEntUseTargets defers such a fire onto this entity's own think,
			//and HLEntFrame skips a think on an entity with in_use clear, so
			//clearing it in the same breath cancels the fire that was just
			//scheduled. c0a0's intro is two of these - the tram start at .3s
			//and the announcer lines at 1s - and both were lost.
			//
			//The SDK does not have the problem because SUB_UseTargets spawns a
			//separate DelayedUse entity to own the delay, so UTIL_Remove on the
			//trigger_auto leaves the pending fire alone. remove_after_fire is
			//that separate entity, folded into a flag.
			//the think is already disarmed: the dispatch loop clears it before
			//the method runs, as SV_RunThink does
			e->remove_after_fire = ToBool(e->spawnflags & HLSF_AUTO_FIREONCE);

			//"SUB_UseTargets(this, triggerType, 0)", CAutoTrigger::Think,
			//triggers.cpp:180. The type is the "triggerstate" key, not a
			//toggle: c0a0c and c0a0d start their trams from startspeed and
			//then send USE_ON, which ShouldToggle drops at a car already
			//running. Sent as a toggle it parks them instead.
			HLEntUseTargets(self, hl_ent_player, e->trigger_mode, 0.0);

			//fired immediately - no delay, so nothing is pending and the
			//HLM_FIRE_TARGETS branch will never run
			if (e->remove_after_fire && e->think_fn != HLM_FIRE_TARGETS)
				e->in_use = FALSE;
			break;

		case HLM_AMBIENT_USE:
			HLAmbientUse(self, use_type, value);
			break;
		case HLM_SPEAKER_USE:		HLSpeakerUse(self, use_type);	break;

		case HLM_MULTISOURCE_USE:
			HLMultiSourceUse(self, activator, hl_ent_call_caller);
			break;

		case HLM_MULTI_MANAGER_USE:	HLMMUse(self, activator);		break;
		case HLM_MULTI_MANAGER_TICK: HLMMTick(self);				break;

		case HLM_LIGHT_USE:			HLLightUse(self, use_type);		break;

		case HLM_SCRIPT_USE:
			//scripted_sequence lives in HLAI.ZC, which compiles after this
			//file, so the request is recorded and HLAIFrame picks it up on the
			//next tick. GOING_DOWN is "start requested" - a script has no
			//physical up and down
			if (e->toggle_state == HLTS_AT_BOTTOM)
			{
				e->activator    = activator;
				e->toggle_state = HLTS_GOING_DOWN;
			}
			break;

		case HLM_BREAK_DIE:			HLBreakableDie(self);			break;
		case HLM_HURT_TOUCH:		HLHurtTouch(self, activator);	break;
		case HLM_PUSH_TOUCH:		HLPushTouch(self);				break;
		case HLM_TELEPORT_TOUCH:	HLTeleportTouch(self);			break;

		case HLM_BREAK_USE:
			//a breakable fired rather than shot dies outright, which is how
			//SF_BREAK_TRIGGER_ONLY glass is broken by a script
			HLEntQueueCall(self, HLM_BREAK_DIE, activator, use_type, 0.0);
			break;

		case HLM_WALL_USE:
			//func_wall toggles its texture frame, which is how the SDK does
			//"switch the screen to the other image"
			e->frame = 1 - e->frame;
			break;

		//--- angular movers ---
		case HLM_ROT_DOOR_USE:		HLRotDoorUse(self, activator);	break;
		case HLM_ROT_DOOR_GO_UP:	HLRotDoorGoUp(self, activator);	break;
		case HLM_ROT_DOOR_GO_DOWN:	HLRotDoorGoDown(self);			break;
		case HLM_ROT_DOOR_HIT_TOP:	HLRotDoorHitTop(self);			break;
		case HLM_ROT_DOOR_HIT_BOTTOM: HLRotDoorHitBottom(self);		break;
		case HLM_ROT_DOOR_TOUCH:	HLRotDoorTouch(self, activator);break;
		case HLM_ROTATE_USE:		HLRotatingUse(self, use_type);	break;
		case HLM_ROTATE_SPIN_UP:	HLRotatingSpinUp(self);			break;
		case HLM_ROTATE_SPIN_DOWN:	HLRotatingSpinDown(self);		break;
		case HLM_PENDULUM_USE:		HLPendulumUse(self);			break;
		case HLM_PENDULUM_SWING:	HLPendulumSwing(self);			break;

		//--- the ending ---
		case HLM_CAMERA_USE:
			HLCameraUse(self, activator, use_type);
			break;
		case HLM_CAMERA_THINK:		HLCameraThink(self);			break;
		case HLM_STRIP_USE:			HLStripUse(self);				break;
		case HLM_REVERT_USE:		HLRevertUse(self);				break;
		case HLM_REVERT_MESSAGE:	HLRevertMessage(self);			break;
		case HLM_ENDSECTION:		HLEndSection(self);				break;
		case HLM_BEVERAGE_USE:		HLBeverageUse(self);			break;
		case HLM_SODA_THINK:		HLSodaThink(self);				break;

		//--- momentary ---
		//USE_SET is what CBasePlayer::PlayerUse sends a continuous-use class,
		//player.cpp:1675, and is how a held key is told from a press here
		case HLM_MOMENTARY_USE:
			HLMomentaryRotUse(self, activator,
				ToBool(use_type == HLUSE_SET));
			break;
		case HLM_MOMENTARY_DOOR_USE:
			HLMomentaryDoorUse(self, use_type, value);
			break;

		//--- effects ---
		case HLM_SPRITE_USE:		HLSpriteUse(self, use_type);	break;
		case HLM_BEAM_USE:			HLBeamUse(self, use_type);		break;
		case HLM_RENDER_USE:		HLRenderUse(self);				break;
		case HLM_MESSAGE_USE:		HLMessageUse(self);				break;
		case HLM_GAME_TEXT_USE:		HLGameTextUse(self);			break;
		case HLM_FADE_USE:			HLFadeUse(self);				break;
		case HLM_SHAKE_USE:			HLShakeUse(self);				break;
		case HLM_EXPLOSION_USE:		HLExplosionUse(self);			break;
		case HLM_EXPLOSION_SMOKE:	HLExplosionSmoke(self);			break;
		case HLM_SPARK_THINK:		HLSparkThink(self);				break;
		case HLM_SPARK_USE:			HLSparkUse(self, use_type);		break;
		case HLM_GLOBAL_USE:		HLGlobalUse(self, use_type);	break;

		case HLM_BUBBLE_USE:		HLBubbleUse(self, use_type);	break;
		case HLM_BUBBLE_THINK:		HLBubbleThink(self);			break;
		case HLM_SMOKER_THINK:		HLSmokerThink(self);			break;
		case HLM_FUNNEL_USE:		HLFunnelUse(self);				break;
		case HLM_BLOOD_USE:			HLBloodUse(self);				break;
		case HLM_SHOOTER_USE:		HLShooterUse(self);				break;
		case HLM_SHOOTER_THINK:		HLShooterThink(self);			break;
		case HLM_LASER_USE:			HLLaserUse(self, use_type);		break;
		case HLM_LASER_THINK:		HLLaserThink(self);				break;
		case HLM_BEAM_DAMAGE_THINK:	HLBeamDamageThink(self);		break;

		case HLM_DECAL_THINK:		HLDecalPlace(self);				break;
		case HLM_DECAL_USE:			HLDecalPlace(self);				break;
		case HLM_CDAUDIO_PLAY:		HLCDAudioPlay(self);			break;
		case HLM_CDAUDIO_RADIUS:	HLCDAudioRadiusThink(self);		break;
		case HLM_MAKER_USE:			HLMakerUse(self, use_type);		break;
		case HLM_MAKER_THINK:		HLMakerThink(self);				break;

		case HLM_SENTENCE_USE:
			//scripted_sentence lives in HLAI.ZC, which owns the sentence
			//scheduler and compiles after this file. GOING_DOWN is "requested",
			//as for scripted_sequence
			if (e->toggle_state == HLTS_AT_BOTTOM)
			{
				e->activator    = activator;
				e->toggle_state = HLTS_GOING_DOWN;
			}
			break;

		//--- items, chargers, player-affecting volumes ---
		case HLM_ITEM_TOUCH:		HLItemTouch(self);				break;
		case HLM_CHARGER_USE:		HLChargerUse(self);				break;
		case HLM_CHARGER_THINK:		HLChargerThink(self);			break;
		case HLM_CONVEYOR_TOUCH:	HLConveyorTouch(self);			break;
		case HLM_PUSH_MOVE_TOUCH:	HLPushableTouch(self);			break;
		case HLM_PUSH_MOVE_USE:		HLPushableUse(self, activator);	break;
		case HLM_FRICTION_TOUCH:	HLFrictionTouch(self);			break;
		case HLM_GRAVITY_TOUCH:		HLGravityTouch(self);			break;
		case HLM_CHANGELEVEL_TOUCH:	HLChangeLevelTouch(self);		break;
		case HLM_CHANGELEVEL_USE:	HLChangeLevelTouch(self);		break;
		case HLM_AUTOSAVE_TOUCH:	HLAutoSaveTouch(self);			break;
		case HLM_XEN_TREE_TOUCH:	HLXenTreeTouch(self);			break;

		default:
			break;
	}
}

//--- spawning ---------------------------------------------------------------
//
// LINK_ENTITY_TO_CLASS. a comparison chain rather than a table for the reason
// given in HLEntModelForClass.
//
// A spawn function sets the physics type, the collision box, the method IDs
// and, for a mover, the two positions it travels between.

U0 HLEntSpawnToggleBrush(CHLMap *map, CHLEntity *e)
{//shared front half of every brush mover
	HLEntSetMoveDir(e);
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_PUSH;
	e->solid    = HLSOLID_BSP;

	if (e->speed <= 0.0)
		e->speed = 100.0;
}

U0 HLEntSpawnDoor(CHLMap *map, CHLEntity *e)
{//func_door / func_water. position1 is where it was built, position2 is
 //that plus the travel along move_dir
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	HLVecCopy(e->origin, e->position1);

	//the door slides its own size along the movement axis, less "lip" - so a
	//lip of 8 leaves 8 units of the door showing when open
	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	//START_OPEN swaps the endpoints instead of moving the brush, so every
	//later "go up" still means "go to position2"
	if (e->spawnflags & HLSF_DOOR_START_OPEN)
	{
		HLVecCopy(e->position2, e->origin);
		HLVecCopy(e->position1, e->position2);
		HLVecCopy(e->origin, e->position1);
	}

	e->ent_class    = HLC_DOOR;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_DOOR_USE;
	e->touch_fn     = HLM_DOOR_TOUCH;
	e->blocked_fn   = HLM_DOOR_BLOCKED;

	if (e->wait == 0.0)
		e->wait = 3.0;

	//"special contents", CBaseDoor::Spawn, doors.cpp:291. A nonzero "skin" on a
	//door is the brush's contents value, not a model skin: the volume is a
	//liquid, the entity is SOLID_NOT, and nothing collides with it. All 174
	//shipped func_water carry one - 165 skin -3, 8 skin -4, 1 skin -1.
	//
	//Spawned SOLID_BSP a pool is a wall standing in the water's place: the
	//swimmer is pushed back out through the side face they entered by.
	//
	//SF_DOOR_SILENT is set alongside in the SDK. The same result comes from
	//clearing the two sound indices; index 0 is common/null.wav at every emit
	//site.
	if (e->skin != 0)
	{
		e->solid    = HLSOLID_NOT;
		e->move_snd = 0;
		e->stop_snd = 0;

		//point contents answers for the volume instead of the trace
		if (HLContentsLiquid(e->skin))
			HLWaterBrushAdd(map, e->brush_model, e->origin, e->skin);
	}
	else if (e->spawnflags & HLSF_DOOR_PASSABLE)
		e->solid = HLSOLID_NOT;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnButton(CHLMap *map, CHLEntity *e)
{
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	if (e->speed <= 0.0)
		e->speed = 40.0;

	HLVecCopy(e->origin, e->position1);

	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	e->ent_class    = HLC_BUTTON;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_BUTTON_USE;
	e->touch_fn     = HLM_BUTTON_TOUCH;

	if (e->wait == 0.0)
		e->wait = 1.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnTrain(CHLMap *map, CHLEntity *e, I64 cls)
{
	CHLEntity	*node;
	F64			 look[3];
	F64			 delta[3];
	F64			 best_d;
	F64			 d;
	I64			 first;
	I64			 lm;
	I64			 best;
	I64			 i;
	Bool		 carried = FALSE;

	HLEntSetBrushSize(map, e);

	e->movetype   = HLMOVETYPE_PUSH;
	e->solid      = HLSOLID_BSP;
	e->use_fn     = HLM_TRAIN_USE;
	e->blocked_fn = HLM_TRAIN_BLOCKED;
	e->ent_class  = cls;

	if (e->speed <= 0.0)
		e->speed = 100.0;

	//"m_speed = pev->speed", CFuncTrackTrain::Spawn, plats.cpp:1500. The key is
	//the maximum the car runs at; e->speed is pev->speed, which a path node
	//overwrites as the car passes. A track change restarts the car from this
	if (cls == HLC_TRACKTRAIN)
	{
		e->train_speed = e->speed;

		//"pev->speed = 0" on the next line of Spawn, plats.cpp:1494, then
		//CFuncTrackTrain::Find restores it from m_startSpeed (plats.cpp:1406).
		//pev->speed is the running/parked state CFuncTrackTrain::Use tests
		//(plats.cpp:1035), so a car left holding its "speed" key reads as
		//already running and the first Use stops it instead of starting it.
		//c0a0's tram carries speed 300 and no startspeed, and start_titles
		//Uses it 3.3 seconds in.
		e->speed = e->start_speed;
	}

	//DispatchRestore's global-entity merge, saverestore.cpp: this map's copy of
	//a car carried through the transition takes the carried placement, path node
	//and speed, positioned relative to this map's landmark. It replaces Find,
	//not adds to it - Find would park it at its own first node.
	if (cls == HLC_TRACKTRAIN && hl_ent_carry_valid && e->global_name[0] &&
		!StrICompare(e->global_name, hl_ent_carry_name))
	{
		lm = HLEntFindByTargetname(hl_ent_changelevel_landmark, 0);

		if (lm >= 0)
		{
			HLVecAdd(hl_entities[lm].origin, hl_ent_carry_org, e->origin);
			HLVecCopy(hl_ent_carry_ang, e->angles);
			HLStrCopy(e->target, hl_ent_carry_path, 64);

			e->speed       = hl_ent_carry_speed;
			e->start_speed = hl_ent_carry_speed;

			//CFuncTrackTrain::OverrideReset, plats.cpp:1339: after a level
			//transition the SDK re-derives m_ppath with NearestPath rather than
			//trusting the carried pointer. The carried NAME is the old map's
			//node, which the destination need not define - c0a0b hands
			//"lower36" to c0a0c, whose chain starts at lower37. A name that
			//does not resolve here parks the car on its first think, silently.
			//Adopt the nearest path_track inside NearestPath's 1024 radius.
			//Classname, not ent_class: spawn order has not reached the nodes.
			if (HLEntFindByTargetname(e->target, 0) < 0)
			{
				best   = -1;
				best_d = 1024.0;

				for (i = 0; i < hl_num_entities; i++)
				{
					if (!hl_entities[i].in_use ||
						StrCompare(hl_entities[i].classname, "path_track"))
						goto qst_next_node;

					if (!hl_entities[i].targetname[0])
						goto qst_next_node;

					HLVecSub(hl_entities[i].origin, e->origin, delta);
					d = HLVecLength(delta);

					if (d < best_d)
					{
						best_d = d;
						best   = i;
					}

qst_next_node:
				}

				if (best >= 0)
					HLStrCopy(e->target, hl_entities[best].targetname, 64);
			}

			//one destination per carry
			hl_ent_carry_valid = FALSE;
			carried            = TRUE;
		}
	}

	//CFuncTrackTrain::Find and CFuncTrain::Activate both snap the train onto its
	//first path node at spawn. Without it a train sits wherever its brush was
	//built, which for c0a0's tram is thousands of units from the track.
	//
	//Path nodes need not have spawned yet: the whole entity list is parsed
	//before any spawn function runs, so a targetname lookup resolves regardless
	//of spawn order.
	first = HLEntFindByTargetname(e->target, 0);

	if (first >= 0 && !carried)
	{
		node = &hl_entities[first];

		//where the train parks relative to the node differs by class:
		//
		//  func_train      the node marks where the brush's mins corner goes
		//  func_tracktrain the node is where the origin goes, plus m_height:
		//                  the brush is modelled around it and rotates there
		if (cls == HLC_TRACKTRAIN)
		{
			//"nextPos.z += m_height", plats.cpp:1389: the car rides m_height
			//above the rail the path_track chain is laid on, and Next samples
			//the track from the rail plane on the same offset
			HLVecCopy(node->origin, e->origin);
			e->origin[2] += e->height;

			//CFuncTrackTrain::Find, plats.cpp:1392: the spawn facing comes from
			//a point 100 units up the track, not from the first leg, so a car
			//parked on a curve starts aligned with the curve. Without it the
			//first tick of Next has to swing the whole error out.
			//
			//Sampled from the rail plane and lifted back, as the origin is
			HLVecCopy(node->origin, look);
			HLPathLookAhead(first, look, 100.0);
			look[2] += e->height;

			HLVecSub(look, e->origin, delta);

			if (!HLIsZeroF(delta[0]) || !HLIsZeroF(delta[1]))
				e->angles[1] =
					HLAngleNorm(Arg(delta[0], delta[1]) / HLDEG2RAD + 180.0);
		}
		else
		{
			e->origin[0] = node->origin[0] - e->mins[0];
			e->origin[1] = node->origin[1] - e->mins[1];
			e->origin[2] = node->origin[2] - e->mins[2];
		}
	}

	//func_train reads bit 2 as START_ON; a tracktrain reads it as FORWARDONLY
	//and starts on its own startspeed instead
	if (cls == HLC_TRAIN)
	{
		//START_ON, or nothing in the map can name it: an unnamed train with a
		//path is meant to be running
		if (e->spawnflags & HLSF_TRAIN_START_ON || !e->targetname[0])
			HLEntSetThink(e, HLM_TRAIN_START, hl_ent_time + 0.1);
	}
	else if (e->start_speed != 0.0)
	{
		//CFuncTrackTrain has no Activate. Spawn always thinks Find at +0.1
		//(plats.cpp:1521), Find sets pev->speed = m_startSpeed (plats.cpp:1406)
		//and Next parks at once when speed is 0 (plats.cpp:1166). So a
		//tracktrain self-starts iff startspeed is nonzero, named or not:
		//c0a0a's tram carries targetname "train" and startspeed 300 and nothing
		//in the map fires it.
		e->speed = e->start_speed;
		HLEntSetThink(e, HLM_TRAIN_START, hl_ent_time + 0.1);
	}

	HLEntSetAbsBox(e);
}

U0 HLEntSetupRotation(CHLEntity *e, I64 self)
{//CFuncPlatRot::SetupRotation, plats.cpp:544
 //
 //"rotation" is the travel in degrees about the axis the door spawnflags pick.
 //A named plat is built at m_end, which is where it rests; both c1a0b's and
 //c1a0c's elevator carry rotation 90 and a targetname, so the brush stands a
 //quarter turn off its authored angles for the whole map.
 //
 //Not HLEntSpawnRotBrush: that is HLMOVETYPE_PUSH plus a speed default and a
 //backwards bit, none of which a plat wants.
 //
 //angle1 and angle2 are kept raw, as the SDK's Vector arithmetic does. The
 //mover pass folds e->angles into [0, 360) while a plat travels, so a rotation
 //past a full turn - c4a1e's 360, -360 and 720 platforms - takes the residual
 //the short way round instead of spinning. Both resting states are still
 //exact: HLDoorHitTop and HLDoorHitBottom snap to these two triples.
	if (HLIsZeroF(e->rot_amount))
		return;

	HLEntAxisDir(e, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	HLVecCopy(e->angles, e->angle1);								//m_start
	HLVecMA(e->angle1, e->rot_amount, e->move_dir, e->angle2);		//m_end

	if (e->targetname[0])
		HLVecCopy(e->angle2, e->angles);

	//the brush is drawn and traced at an orientation now, so both sides have to
	//be told. HLEntSetAbsBox reads e->rotates and switches to the
	//orientation-independent radius
	e->rotates = TRUE;
	HLClipSetRotating(self, TRUE);

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnPlat(CHLMap *map, CHLEntity *e, I64 self, Bool rot = FALSE)
{//func_plat - a lift between two heights on the Z axis
 //
 //CFuncPlat derives the travel from the brush height when "height" is absent,
 //and rests at the top. rot is func_platrot, which turns through the travel
	HLEntSetBrushSize(map, e);

	e->movetype   = HLMOVETYPE_PUSH;
	e->solid      = HLSOLID_BSP;
	e->ent_class  = HLC_PLAT;
	e->use_fn     = HLM_DOOR_USE;
	e->touch_fn   = HLM_DOOR_TOUCH;
	e->blocked_fn = HLM_PLAT_BLOCKED;

	if (e->speed <= 0.0)
		e->speed = 150.0;

	//"if (m_flHeight != 0) m_vecPosition2.z = origin.z - m_flHeight; else
	//origin.z - size.z + 8", CFuncPlat::Setup, plats.cpp:297. Two facts the
	//door rule gets wrong here: the test is against zero, not against
	//positive, and the fallback carries no lip.
	//
	//3 of the 8 shipped plats carry a NEGATIVE height and all 3 are
	//func_platrot - c1a0b and c1a0c "ele_2" at -216, c4a1e "dn_3" at -976.
	//A negative height puts position2 ABOVE the origin: the lift rises from
	//its authored rest. Clamping it to a positive default sends all three the
	//wrong way and by the wrong distance
	HLVecCopy(e->origin, e->position1);
	HLVecCopy(e->origin, e->position2);

	if (!HLIsZeroF(e->height))
		e->position2[2] -= e->height;
	else
		e->position2[2] -= e->size[2] - 8.0;

	e->toggle_state = HLTS_AT_BOTTOM;

	if (e->wait == 0.0)
		e->wait = 3.0;

	HLEntSetAbsBox(e);

	//CFuncPlatRot::Spawn - CFuncPlat::Spawn first, then the rotation
	if (rot)
		HLEntSetupRotation(e, self);
}

U0 HLEntSpawnTrackChange(CHLMap *map, CHLEntity *e, I64 self)
{//CFuncTrackChange::Spawn, plats.cpp:1837. CFuncPlat::Setup, then
 //SetupRotation, then parked at one end with the other as m_targetState
	HLEntSetBrushSize(map, e);

	e->movetype   = HLMOVETYPE_PUSH;
	e->solid      = HLSOLID_BSP;
	e->use_fn     = HLM_TRACK_USE;
	e->blocked_fn = HLM_PLAT_BLOCKED;

	if (!StrCompare(e->classname, "func_trackautochange"))
		e->ent_class = HLC_TRACKAUTO;
	else
		e->ent_class = HLC_TRACKCHANGE;

	if (e->speed <= 0.0)
		e->speed = 150.0;

	//"m_vecPosition2.z = origin.z - size.z + 8", CFuncPlat::Setup, plats.cpp:301.
	//The plat rule, not the door's: no lip is involved
	HLVecCopy(e->origin, e->position1);
	HLVecCopy(e->origin, e->position2);

	if (e->height > 0.0)
		e->position2[2] -= e->height;
	else
		e->position2[2] -= e->size[2] - 8.0;

	//SF_TRACK_DONT_MOVE, plats.cpp:1840: the lift only turns. c2a1's "trackch"
	//is the one shipped instance, and it carries height 0 as well
	if (e->spawnflags & HLSF_TRACK_DONT_MOVE)
		e->position2[2] = e->origin[2];

	HLEntSetAbsBox(e);

	HLEntSetupRotation(e, self);

	e->track_top_ent    = -1;
	e->track_bottom_ent = -1;
	e->track_train_ent  = -1;
	e->track_code       = HLTRAIN_SAFE;
	e->track_use        = TRUE;

	//SF_TRACK_STARTBOTTOM, plats.cpp:1843. The SDK's bottom is position2 and
	//m_start, which this file rests at in HLTS_AT_TOP. c2a2b1 and c2a2e carry
	//the bit; the other four are built at the top
	if (e->spawnflags & HLSF_TRACK_STARTBOTTOM)
	{
		HLVecCopy(e->position2, e->origin);
		e->toggle_state = HLTS_AT_TOP;
		e->track_target = HLTS_AT_BOTTOM;

		if (e->rotates)
			HLVecCopy(e->angle1, e->angles);
	}
	else
	{
		HLVecCopy(e->position1, e->origin);
		e->toggle_state = HLTS_AT_BOTTOM;
		e->track_target = HLTS_AT_TOP;

		if (e->rotates)
			HLVecCopy(e->angle2, e->angles);
	}

	HLEntSetAbsBox(e);

	//"nextthink = ltime + 2.0; SetThink(Find)", plats.cpp:1855
	HLEntSetThink(e, HLM_TRACK_FIND, hl_ent_time + 2.0);
}

U0 HLEntSpawnTrigger(CHLMap *map, CHLEntity *e, Bool once)
{//brush triggers are invisible and non-solid but still tested for overlap
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_TRIGGER;

	//CBaseTrigger::InitTrigger: EF_NODRAW unless showtriggers is set. Without
	//it the renderer draws the trigger volume as a wall, texture and all -
	//AAATRIGGER and whatever else the mapper left on the brush.
	if (HLCvarGet("showtriggers") == 0.0)
		e->effects = e->effects | HLEF_NODRAW;
	e->touch_fn = HLM_TRIGGER_TOUCH;
	e->use_fn   = HLM_TRIGGER_USE;

	if (once)
		e->wait = -1.0;
	else if (e->wait == 0.0)
		e->wait = 0.2;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotBrush(CHLMap *map, CHLEntity *e, I64 self, I64 flag_roll,
	I64 flag_pitch)
{//shared front half of every angular brush mover
 //
 //not HLEntSpawnToggleBrush: that calls HLEntSetMoveDir, which reads the "angle"
 //key as a translation direction and zeroes angles[1] on the way out. For a
 //rotating brush the authored angles are its rest orientation.
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_PUSH;

	if (e->speed <= 0.0)
		e->speed = 100.0;

	HLEntAxisDir(e, flag_roll, flag_pitch);

	//"backwards" is bit 2 for every rotating class in HL
	if (e->spawnflags & HLSF_DOOR_ROTATE_BACKWARDS)
		HLVecScale(e->move_dir, -1.0, e->move_dir);

	//register with the collision side. opt in per entity: e->angles alone is not
	//a safe signal, since HLTrainNext writes yaw into angles[1] every frame as
	//bookkeeping and auto-detection would rotate every moving train's hull. The
	//renderer gates on HLClipIsRotating too, so draw and collide agree
	e->rotates = TRUE;
	HLClipSetRotating(self, TRUE);

	//after e->rotates, which the box depends on
	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotDoor(CHLMap *map, CHLEntity *e, I64 self)
{//func_door_rotating. CRotDoor: a func_door whose travel is in degrees
	F64 saved[3];

	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	//distance 0 cannot move. the SDK warns and leaves it stuck, which here seals
	//a doorway with a solid brush, so it defaults to 90 degrees
	if (e->distance == 0.0)
		e->distance = 90.0;

	HLVecCopy(e->angles, e->angle1);
	HLVecMA(e->angle1, e->distance, e->move_dir, e->angle2);

	if (e->spawnflags & HLSF_DOOR_PASSABLE)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//START_OPEN puts the door at angle2 and swaps the endpoints, so downstream
	//"go up" still means angle2. Same as the linear door's two positions
	if (e->spawnflags & HLSF_DOOR_START_OPEN)
	{
		HLVecCopy(e->angle1, saved);
		HLVecCopy(e->angle2, e->angles);
		HLVecCopy(saved, e->angle2);
		HLVecCopy(e->angles, e->angle1);
		HLVecScale(e->move_dir, -1.0, e->move_dir);
	}

	e->ent_class    = HLC_DOOR;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_ROT_DOOR_USE;
	e->touch_fn     = HLM_ROT_DOOR_TOUCH;
	e->blocked_fn   = HLM_DOOR_BLOCKED;

	if (e->wait == 0.0)
		e->wait = 3.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotButton(CHLMap *map, CHLEntity *e, I64 self)
{//CRotButton::Spawn, buttons.cpp:813. CBaseButton with m_fRotating set: the
 //same state machine, travelling through m_flMoveDistance degrees about the
 //axis the door spawnflags pick instead of along move_dir.
 //
 //36 ship across 22 maps, all with a real distance - 90 is the mode. The
 //valve wheels and levers of c1a4i, c2a2a, c3a2c and subtransit are these.
	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	//buttons.cpp:833. Bit 1 is NOTSOLID here, not SF_BUTTON_DONT_MOVE
	if (e->spawnflags & HLSF_ROTBUTTON_NOTSOLID)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	if (e->speed <= 0.0)
		e->speed = 40.0;

	if (e->wait == 0.0)
		e->wait = 1.0;

	//m_vecAngle1/m_vecAngle2, buttons.cpp:855. No START_OPEN swap: a button
	//has no such flag and the SDK builds it at rest
	HLVecCopy(e->angles, e->angle1);
	HLVecMA(e->angle1, e->distance, e->move_dir, e->angle2);

	e->ent_class    = HLC_BUTTON;
	e->toggle_state = HLTS_AT_BOTTOM;
	e->use_fn       = HLM_BUTTON_USE;
	e->touch_fn     = HLM_BUTTON_TOUCH;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnRotating(CHLMap *map, CHLEntity *e, I64 self)
{//func_rotating - fans and turbines. its own axis flag bits, 4 and 8, not the
 //door's 64 and 128
	HLEntSpawnRotBrush(map, e, self, HLSF_ROTATE_Z_AXIS, HLSF_ROTATE_X_AXIS);

	e->ent_class    = HLC_ROTATE;
	e->use_fn       = HLM_ROTATE_USE;
	e->toggle_state = HLTS_AT_BOTTOM;

	if (e->spawnflags & HLSF_ROTATE_NOT_SOLID)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//dlls/bmodels.cpp:376-390. The radius bits are not ambient_generic's, and
	//neither is the default: no bit set is ATTN_NORM here, ATTN_STATIC there
	e->fan_atten = HLATTN_NORM;

	if (e->spawnflags & HLSF_ROTATE_SMALLRADIUS)
		e->fan_atten = HLATTN_IDLE;
	else if (e->spawnflags & HLSF_ROTATE_MEDIUMRADIUS)
		e->fan_atten = HLATTN_STATIC;
	else if (e->spawnflags & HLSF_ROTATE_LARGERADIUS)
		e->fan_atten = HLATTN_NORM;

	//"prevent divide by zero if level designer forgets friction",
	//bmodels.cpp:390. The key was divided by 100 at parse
	if (e->fan_friction == 0.0)
		e->fan_friction = 1.0;

	//SF_BRUSH_ROTATE_INSTANT, or nothing in the map can name it: a fan with a
	//speed and no trigger is meant to be running. Instant, so the ramp is
	//skipped even under ACCDCC
	if ((e->spawnflags & HLSF_ROTATE_INSTANT) || !e->targetname[0])
	{
		e->toggle_state = HLTS_AT_TOP;
		HLVecScale(e->move_dir, e->speed, e->avelocity);
	}
}

U0 HLEntSpawnPendulum(CHLMap *map, CHLEntity *e, I64 self)
{//func_pendulum. CPendulum uses the door's axis bits, not the fan's
 //
 //fields reused rather than added, safe because a pendulum is never also one of
 //the classes that wants them:
 //
 //   height          the constant angular acceleration, speed^2 / 2*distance
 //   angle2          the centre of the swing, not an endpoint
 //   momentary_frac  the signed angular speed the integrator carries
	F64 dist;

	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	e->ent_class = HLC_ROTATE;
	e->use_fn    = HLM_PENDULUM_USE;

	if (e->spawnflags & HLSF_DOOR_PASSABLE)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	dist = HLEntAbsF(e->distance);

	//no distance means no swing. left inert rather than defaulted: a pendulum is
	//decoration, unlike a door that would seal a corridor
	if (dist < 0.0001)
		return;

	e->height = e->speed * e->speed / (2.0 * dist);

	HLVecCopy(e->angles, e->angle1);
	HLVecMA(e->angle1, e->distance * 0.5, e->move_dir, e->angle2);

	e->momentary_frac = 0.0;

	if ((e->spawnflags & HLSF_ROTATE_INSTANT) || !e->targetname[0])
		HLPendulumSwing(self);
}

U0 HLEntSpawnMomentaryRot(CHLMap *map, CHLEntity *e, I64 self)
{//momentary_rot_button - a valve wheel. see the deviation note on
 //HLMomentaryRotUse: each +use ratchets it one step, because +use is an edge
	HLEntSpawnRotBrush(map, e, self, HLSF_DOOR_ROTATE_Z, HLSF_DOOR_ROTATE_X);

	e->ent_class = HLC_ROTATE;
	e->use_fn    = HLM_MOMENTARY_USE;

	if (e->spawnflags & HLSF_MOMENTARY_DOOR)
		e->solid = HLSOLID_NOT;
	else
		e->solid = HLSOLID_BSP;

	//a negative distance turns the other way: the authored angles are then the
	//fully-open end, not the closed one
	if (e->distance < 0.0)
	{
		HLVecCopy(e->angles, e->angle2);
		HLVecMA(e->angle2, -e->distance, e->move_dir, e->angle1);
		HLVecCopy(e->angle1, e->angles);
	}
	else
	{
		HLVecCopy(e->angles, e->angle1);
		HLVecMA(e->angle1, e->distance, e->move_dir, e->angle2);
	}

	e->momentary_frac = 0.0;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnMomentaryDoor(CHLMap *map, CHLEntity *e)
{//momentary_door - a linear door parked proportionally by a USE_SET value
	F64 travel;

	HLEntSpawnToggleBrush(map, e);

	HLVecCopy(e->origin, e->position1);

	travel = HLEntAbsF(e->move_dir[0] * e->size[0]) +
			 HLEntAbsF(e->move_dir[1] * e->size[1]) +
			 HLEntAbsF(e->move_dir[2] * e->size[2]) - e->lip;

	HLVecMA(e->position1, travel, e->move_dir, e->position2);

	e->ent_class      = HLC_DOOR;
	e->use_fn         = HLM_MOMENTARY_DOOR_USE;
	e->momentary_frac = 0.0;

	//no touch and no ordinary use: a momentary door has no state to toggle, and
	//wiring it to HLM_DOOR_USE would make it snap fully open on a bump
	e->touch_fn = HLM_NONE;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnSprite(CHLEntity *e, Bool toggleable)
{//env_sprite / env_glow / cycler_sprite. the sprite itself was resolved by
 //HLEntLoadModels, which is the pass that owns "model key to loaded model"
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_NOT;
	e->ent_class = HLC_SPRITE;

	if (e->scale <= 0.0)
		e->scale = 1.0;

	if (!toggleable)
	{
		//env_glow and cycler_sprite have no Use - always visible
		e->visible = TRUE;
		return;
	}

	e->use_fn = HLM_SPRITE_USE;

	//SF_SPRITE_STARTON, or nothing in the map can name it: an unnamed sprite
	//waiting to be switched on waits forever, and HL1's flare and glow sprites
	//carry no targetname. Same rule as the unnamed scripted_sequence above
	e->visible = ToBool((e->spawnflags & HLSF_SPRITE_STARTON) ||
		!e->targetname[0]);
}

U0 HLEntSpawnBeam(CHLEntity *e)
{//env_beam / env_laser. the endpoints are targetnames, resolved to indices here
 //because the whole entity list is parsed before any spawn function runs
	e->movetype   = HLMOVETYPE_NONE;
	e->solid      = HLSOLID_NOT;
	e->ent_class  = HLC_BEAM;
	e->use_fn     = HLM_BEAM_USE;

	e->beam_start = HLEntFindByTargetname(e->beam_start_name, 0);
	e->beam_end   = HLEntFindByTargetname(e->beam_end_name, 0);

	//PRECACHE_MODEL( (char *)STRING(m_iszSpriteName) ), effects.cpp:466. The
	//draw pass runs off e->spr and must not touch the loader
	if (e->texture[0] && !e->spr)
		e->spr = HLEntSprCacheGet(e->texture);

	//env_laser fires from its own origin, so a missing start end is normal
	e->visible = ToBool((e->spawnflags & HLSF_BEAM_STARTON) ||
		!e->targetname[0]);

	e->beam_active = e->visible;

	//CLightning::ServerSide - a beam with no "life" is a permanent one the
	//server owns, and only that kind carries damage. m_active gates it, so the
	//think is armed whatever the state and tests the flag itself
	if (e->damage > 0.0 && e->beam_life == 0.0 &&
		!(e->spawnflags & HLSF_BEAM_RING))
		HLEntSetThink(e, HLM_BEAM_DAMAGE_THINK, hl_ent_time + 0.1);
}

U0 HLEntSpawnLaser(CHLEntity *e)
{//CLaser::Spawn, effects.cpp:960. Unlike env_beam it has a strike think of its
 //own, so it is a separate spawn rather than a flag on the beam one
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_NOT;
	e->ent_class = HLC_BEAM;
	e->use_fn    = HLM_LASER_USE;

	//LaserTarget, which the parser puts in the shared end-name field
	e->beam_start = -1;
	e->beam_end   = HLEntFindByTargetname(e->beam_end_name, 0);

	if (e->texture[0] && !e->spr)
		e->spr = HLEntSprCacheGet(e->texture);

	//"if ( pev->targetname && !(pev->spawnflags & SF_BEAM_STARTON) ) TurnOff()"
	e->visible = ToBool((e->spawnflags & HLSF_BEAM_STARTON) ||
		!e->targetname[0]);

	e->beam_active = e->visible;

	if (e->visible)
		HLEntSetThink(e, HLM_LASER_THINK, hl_ent_time + 0.1);
}

U0 HLEntSpawnBubbles(CHLMap *map, CHLEntity *e)
{//CBubbling::Spawn - a brush volume, never solid and never drawn
	HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;
	e->use_fn   = HLM_BUBBLE_USE;

	//"renderamt = 0 - the engine won't draw this model if this is set to 0 and
	//blending is on". The comment above says never drawn; nothing enforced it,
	//and the water volumes carry AAATRIGGER
	e->effects = e->effects | HLEF_NODRAW;

	HLEntSetAbsBox(e);

	//"if ( !(pev->spawnflags & SF_BUBBLES_STARTOFF) ) nextthink = time + 2.0"
	if (!(e->spawnflags & HLSF_BUBBLES_STARTOFF))
		HLEntSetThink(e, HLM_BUBBLE_THINK, hl_ent_time + 2.0);
}

U0 HLEntSpawnShooter(CHLEntity *e)
{//CGibShooter::Spawn, shared by env_shooter
	HLEntSetMoveDir(e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;
	e->use_fn   = HLM_SHOOTER_USE;

	//"if ( m_flDelay == 0 ) m_flDelay = 0.1" and "if ( m_flGibLife == 0 )
	//m_flGibLife = 25". The delay key is the gap between gibs here, not a fire
	//delay, so a shooter must never route through HLEntUseTargets' deferral
	if (e->delay == 0.0)
		e->delay = 0.1;

	if (e->gib_life == 0.0)
		e->gib_life = 25.0;

	if (e->gib_count < 1)
		e->gib_count = 1;

	e->gib_left = e->gib_count;
}

//CItem::Spawn's UTIL_SetSize, items.cpp:94, and the box HLWeaponPickup rebuilds
#define HLENT_ITEM_HALF		16.0
#define HLENT_ITEM_TOP		16.0

//SV_DropToFloor's sweep length
#define HLENT_DROP_DIST		256.0

Bool HLEntDropToFloor(CHLMap *map, CHLEntity *e, F64 *mins, F64 *maxs)
{//DROP_TO_FLOOR / SV_DropToFloor: sweep the box 256 units down and settle it
 //
 //Mappers place pickups roughly and the engine settles them at spawn. Measured
 //over the 125 shipped BSPs: of 2287 item_*, weapon_* and ammo_* entities, 1536
 //have world solid more than 2 units below their origin, most of them 8 to 24.
 //An undropped pickup's trigger box floats above the floor and the player walks
 //under it - which is why the HEV suit in t0a0 could not be taken.
 //
 //Deviation: CItem::Spawn removes an item whose drop fails (items.cpp:98). Here
 //a failed drop leaves the pickup where the mapper put it. The hull this trace
 //picks is 36 tall against the item's 16 (HLHullForSize), so a pickup in a low
 //niche reports all-solid where the engine's own hull choice does not, and
 //deleting it would cost more than the float does.
	CHLTrace	tr;
	F64			end[3];

	if (!map || !e)
		return FALSE;

	HLVecCopy(e->origin, end);
	end[2] -= HLENT_DROP_DIST;

	HLTraceEntity(map, e->origin, end, mins, maxs, 0, TRUE, &tr);

	if (tr.all_solid || tr.start_solid)
		return FALSE;

	//nothing within 256 units: "fell out of level"
	if (tr.fraction == 1.0)
		return FALSE;

	HLVecCopy(tr.end_pos, e->origin);

	return TRUE;
}

U0 HLEntSpawnItem(CHLEntity *e)
{//item_healthkit and friends
 //
 //HL spawns items MOVETYPE_TOSS and calls DROP_TO_FLOOR. There is no toss
 //integrator for non-player entities here; the drop is done once at spawn,
 //which is where the settled position comes from either way
	e->movetype  = HLMOVETYPE_NONE;
	e->solid     = HLSOLID_TRIGGER;
	e->ent_class = HLC_ITEM;
	e->touch_fn  = HLM_ITEM_TOUCH;

	//CItem::Spawn's UTIL_SetSize. an item has no brush model, so its bounds
	//would otherwise be a zero-size point at the origin
	HLVecSet(e->mins, -HLENT_ITEM_HALF, -HLENT_ITEM_HALF, 0.0);
	HLVecSet(e->maxs, HLENT_ITEM_HALF, HLENT_ITEM_HALF, HLENT_ITEM_TOP);

	//The DROP_TO_FLOOR that CItem::Spawn does here runs in a pass of its own
	//after every class function instead, so a pickup resting on a func_wall
	//lands on it and not on the floor below: HLClipToNativeBrushes only sees a
	//brush entity that has already spawned. See HLEntDropPickups
	HLEntSetAbsBox(e);
}

U0 HLEntSpawnXen(CHLEntity *e)
{//the xen_* flora, dlls/xen.cpp. Hulls and solidity per class; the model comes
 //off the class table in HLEnt.ZC, since 177 of the 184 name none
	e->movetype = HLMOVETYPE_NONE;

	//"pev->frame = RANDOM_FLOAT(0,255)" and framerate 0.7-1.4, xen.cpp:305 and
	//:539, so a stand of them does not pulse in lockstep. The port's cycle is
	//(hl_ent_time - anim_start) against the sequence, so a phase offset is a
	//backdated start
	e->seq        = 0;
	e->frame      = 0;
	e->anim_start = hl_ent_time - HLFxRandF(0.0, 4.0);
	e->anim_loop  = TRUE;
	e->anim_done  = FALSE;

	if (!StrCompare(e->classname, "xen_plantlight"))
	{
		//CXenPLight::Spawn, xen.cpp:90. SOLID_TRIGGER, and its Touch dims the
		//pod; the glow sprite is the visible half and is not created here
		e->solid = HLSOLID_TRIGGER;
		HLVecSet(e->mins, -80.0, -80.0, 0.0);
		HLVecSet(e->maxs, 80.0, 80.0, 32.0);
	}
	else if (!StrCompare(e->classname, "xen_hair"))
	{
		//CXenHair::Spawn, xen.cpp:195. SOLID_NOT
		e->solid = HLSOLID_NOT;
		HLVecSet(e->mins, -4.0, -4.0, 0.0);
		HLVecSet(e->maxs, 4.0, 4.0, 32.0);
	}
	else if (!StrCompare(e->classname, "xen_tree"))
	{
		//CXenTree::Spawn, xen.cpp:296
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;
		e->touch_fn   = HLM_XEN_TREE_TOUCH;
		HLVecSet(e->mins, -30.0, -30.0, 0.0);
		HLVecSet(e->maxs, 30.0, 30.0, 188.0);
	}
	else if (!StrCompare(e->classname, "xen_spore_small"))
	{
		//CXenSporeSmall::Spawn, xen.cpp:491
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;
		HLVecSet(e->mins, -16.0, -16.0, 0.0);
		HLVecSet(e->maxs, 16.0, 16.0, 64.0);
	}
	else if (!StrCompare(e->classname, "xen_spore_medium"))
	{
		//CXenSporeMed::Spawn, xen.cpp:497
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;
		HLVecSet(e->mins, -40.0, -40.0, 0.0);
		HLVecSet(e->maxs, 40.0, 40.0, 120.0);
	}
	else if (!StrCompare(e->classname, "xen_spore_large"))
	{
		//CXenSporeLarge::Spawn, xen.cpp:519. The five leg hulls beside it are
		//separate entities and are not created
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;
		HLVecSet(e->mins, -48.0, -48.0, 110.0);
		HLVecSet(e->maxs, 48.0, 48.0, 240.0);
	}
	else
	{
		//xen_hull and anything else in the family: drawn, not solid
		e->solid = HLSOLID_NOT;
		HLVecSet(e->mins, 0.0, 0.0, 0.0);
		HLVecSet(e->maxs, 0.0, 0.0, 0.0);
	}

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnCharger(CHLMap *map, CHLEntity *e, Bool health)
{//func_healthcharger / func_recharge - a solid wall unit operated with +use
	HLEntSetBrushSize(map, e);

	e->movetype  = HLMOVETYPE_PUSH;
	e->solid     = HLSOLID_BSP;
	e->ent_class = HLC_CHARGER;
	e->use_fn    = HLM_CHARGER_USE;

	//m_iJuice, healthkit.cpp:169 and h_battery.cpp:95. Taken at spawn, so a
	//charger keeps the pool it was built with for the map's life
	if (health)
		e->charge = hl_ent_charge_health;
	else
		e->charge = hl_ent_charge_armor;

	HLEntSetAbsBox(e);
}

U0 HLEntSpawnInert(CHLMap *map, CHLEntity *e, Bool hide = FALSE)
{//recognised, no behaviour. a brush entity still gets its bounds for a later
 //pass, and is never solid
 //
 //hide is for the classes whose own Spawn takes the model off the screen:
 //CFuncMonsterClip and CFuncMortarField set EF_NODRAW, CFuncTankControls sets
 //it too, and CTriggerVolume zeroes modelindex outright. The rest keep a
 //visible brush in HL - func_guntarget and func_trackchange are meant to be
 //seen - so this is per class rather than blanket
	if (e->brush_model >= 1)
		HLEntSetBrushSize(map, e);

	e->movetype = HLMOVETYPE_NONE;
	e->solid    = HLSOLID_NOT;

	if (hide && HLCvarGet("showtriggers") == 0.0)
		e->effects = e->effects | HLEF_NODRAW;
}

U0 HLEntSetSeqByName(CHLEntity *e, U8 *label)
{//pev->sequence = LookupSequence(label), and hold it
 //
 //a pose is a take of its own, not a loop: the body plays once and stays on
 //its last frame, which is what pev->framerate = 0 leaves in the SDK. A label
 //the model does not carry leaves the sequence alone rather than falling back
 //to sequence 0, which for scientist.mdl is the walk cycle
	I64 seq;

	if (!e->studio || !label || !label[0])
		return;

	seq = HLStudioSeqByName(e->studio, label);

	if (seq < 0)
		return;

	e->seq              = seq;
	e->frame            = 0;
	e->anim_start       = hl_ent_time;
	e->anim_loop        = FALSE;
	e->anim_done        = FALSE;
	e->anim_event_frame = -1;
}

U0 HLEntScientistHead(CHLEntity *e)
{//the head half of CScientist::Spawn, shared by the sitting and dead classes
 //
 //NUM_SCIENTIST_HEADS is 4 and a body of -1 asks for a random one. HEAD_LUTHER
 //is 2 and takes skin 1, so his hands match his face
	if (e->body == -1)
		e->body = HLPartRandI(4);

	if (e->body == 2)
		e->skin = 1;
	else
		e->skin = 0;
}

U0 HLEntSitScientistSeq(CHLEntity *e, I64 which)
{//SITTING_ANIM_*, scientist.cpp
 //
 //the SDK indexes off m_baseSequence = LookupSequence("sitlookleft") and
 //trusts the five to be contiguous. They are - 71 to 75 in scientist.mdl - but
 //each is looked up by its own name here, so a model that reorders them still
 //sits down. A chain, not a table of literals: adjacent string literals
 //concatenate by length on this compiler and collapse such a table to one
 //entry
	if (which <= 0)
	{
		HLEntSetSeqByName(e, "sitlookleft");
		return;
	}

	if (which == 1)
	{
		HLEntSetSeqByName(e, "sitlookright");
		return;
	}

	if (which == 2)
	{
		HLEntSetSeqByName(e, "sitscared");
		return;
	}

	if (which == 3)
	{
		HLEntSetSeqByName(e, "sitting2");
		return;
	}

	HLEntSetSeqByName(e, "sitting3");
}

U0 HLEntDeadPose(CHLEntity *e)
{//m_szPoses[m_iPose] for whichever dead class this is
 //
 //four tables, one per class, each in its own comparison chain for the reason
 //HLEntSitScientistSeq gives. CDeadScientist's index 3 is "dead_hang", which
 //the shipped scientist.mdl does not carry; the SDK complains and leaves the
 //model on sequence 0, and so does this
	I64 pose = e->pose;

	if (pose < 0)
		pose = 0;

	if (!StrCompare(e->classname, "monster_scientist_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "lying_on_back");
		if (pose == 1)	HLEntSetSeqByName(e, "lying_on_stomach");
		if (pose == 2)	HLEntSetSeqByName(e, "dead_sitting");
		if (pose == 3)	HLEntSetSeqByName(e, "dead_hang");
		if (pose == 4)	HLEntSetSeqByName(e, "dead_table1");
		if (pose == 5)	HLEntSetSeqByName(e, "dead_table2");
		if (pose >= 6)	HLEntSetSeqByName(e, "dead_table3");
		return;
	}

	if (!StrCompare(e->classname, "monster_barney_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "lying_on_back");
		if (pose == 1)	HLEntSetSeqByName(e, "lying_on_side");
		if (pose >= 2)	HLEntSetSeqByName(e, "lying_on_stomach");
		return;
	}

	if (!StrCompare(e->classname, "monster_hgrunt_dead"))
	{
		if (pose == 0)	HLEntSetSeqByName(e, "deadstomach");
		if (pose == 1)	HLEntSetSeqByName(e, "deadside");
		if (pose >= 2)	HLEntSetSeqByName(e, "deadsitting");
		return;
	}

	//CDeadHEV, which wears the player model
	if (pose == 0)	HLEntSetSeqByName(e, "deadback");
	if (pose == 1)	HLEntSetSeqByName(e, "deadsitting");
	if (pose == 2)	HLEntSetSeqByName(e, "deadstomach");
	if (pose >= 3)	HLEntSetSeqByName(e, "deadtable");
}

U0 HLEntSpawnDeadMonster(CHLEntity *e)
{//CBaseMonster::MonsterInitDead, plus the pose each dead class picks
 //
 //UTIL_SetSize(g_vecZero, g_vecZero): a corpse has no hull and blocks nothing,
 //which is why the box clip skips a zero-sized entity
	e->movetype   = HLMOVETYPE_TOSS;
	e->solid      = HLSOLID_BBOX;
	e->effects    = 0;
	e->takedamage = HLDMG_TAKE_YES;

	if (e->health <= 0.0)
		e->health = 8.0;

	e->max_health = e->health;

	HLVecSet(e->mins, 0.0, 0.0, 0.0);
	HLVecSet(e->maxs, 0.0, 0.0, 0.0);
	HLEntSetAbsBox(e);

	//"SetThink(CorpseFallThink); nextthink = time + 0.5", monsters.cpp:3280.
	//The delay is load-bearing here as it is there: the drop traces against
	//brush entities, and the ones later in the entity list have not spawned yet
	HLEntSetThink(e, HLM_CORPSE_FALL, hl_ent_time + 0.5);

	if (!StrCompare(e->classname, "monster_scientist_dead"))
		HLEntScientistHead(e);

	HLEntDeadPose(e);
}

I64 HLEntSpawnOne(CHLMap *map, I64 i)
{//returns 1 if the classname was recognised
	CHLEntity	*e = &hl_entities[i];
	I64			 slot;

	if (e->spawned)
		return 0;

	e->spawned = TRUE;

	//--- doors ---
	if (!StrCompare(e->classname, "func_door") ||
		!StrCompare(e->classname, "func_water"))
	{
		HLEntSpawnDoor(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "func_door_rotating"))
	{
		HLEntSpawnRotDoor(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "momentary_door"))
	{
		HLEntSpawnMomentaryDoor(map, e);
		return 1;
	}

	//--- buttons ---
	if (!StrCompare(e->classname, "func_button"))
	{
		HLEntSpawnButton(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "func_rot_button"))
	{
		HLEntSpawnRotButton(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "momentary_rot_button"))
	{
		HLEntSpawnMomentaryRot(map, e, i);
		return 1;
	}

	//--- rotating brushwork ---
	if (!StrCompare(e->classname, "func_rotating"))
	{
		HLEntSpawnRotating(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "func_pendulum"))
	{
		HLEntSpawnPendulum(map, e, i);
		return 1;
	}

	//--- trains ---
	if (!StrCompare(e->classname, "func_train") ||
		!StrCompare(e->classname, "func_tracktrain"))
	{
		if (!StrCompare(e->classname, "func_tracktrain"))
		{
			HLEntSpawnTrain(map, e, HLC_TRACKTRAIN);

			//The car turns, so its hull and its bounds turn. An axial hull on
			//a 288 by 150 car drops the rider through the deck past 22 degrees
			//of yaw; an axial box makes HLEntPlayerRides miss them at the ends
			//and the carry stops. Bank (the "bank" key) is not applied: HL
			//drives it through avelocity.z over several frames.
			HLClipSetRotating(i, TRUE);
			e->rotates = TRUE;

			//HLEntSpawnTrain already sized the box with rotates clear
			HLEntSetAbsBox(e);
		}
		else
			HLEntSpawnTrain(map, e, HLC_TRAIN);

		return 1;
	}

	if (!StrCompare(e->classname, "path_corner") ||
		!StrCompare(e->classname, "path_track"))
	{
		//pure data - a named point with a target and an optional wait
		e->movetype  = HLMOVETYPE_NONE;
		e->solid     = HLSOLID_NOT;
		e->ent_class = HLC_PATH;
		return 1;
	}

	if (!StrCompare(e->classname, "func_plat"))
	{
		HLEntSpawnPlat(map, e, i);
		return 1;
	}

	if (!StrCompare(e->classname, "func_platrot"))
	{
		HLEntSpawnPlat(map, e, i, TRUE);
		return 1;
	}

	//--- triggers ---
	if (!StrCompare(e->classname, "trigger_once"))
	{
		HLEntSpawnTrigger(map, e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_multiple"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_hurt"))
	{
		//CTriggerHurt::Spawn, dlls/triggers.cpp:808
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_HURT_TOUCH;

		//"if ( !FStringNull ( pev->targetname ) ) SetUse ( ToggleUse ); else
		//SetUse ( NULL )". A named hurt volume is switched on and off, never
		//used as a relay, so the generic trigger use must not stand
		if (e->targetname[0])
			e->use_fn = HLM_TRIGGER_ENABLE;
		else
			e->use_fn = HLM_NONE;

		//SF_TRIGGER_HURT_START_OFF, dlls/triggers.cpp:828
		if (e->spawnflags & HLSF_HURT_START_OFF)
			e->solid = HLSOLID_NOT;

		if (e->dmg == 0.0)
			e->dmg = 10.0;

		HLEntSetAbsBox(e);

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_push"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		HLEntSetMoveDir(e);
		e->touch_fn = HLM_PUSH_TOUCH;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_teleport"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_TELEPORT_TOUCH;

		//the target names the destination and is CONSUMED by the teleport, so
		//the generic use path must not also fire it
		e->use_fn = HLM_NONE;

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_relay"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_RELAY_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_changelevel"))
	{
		//a brush volume, not a point entity: it has a "model" and the player
		//crossing it is the trigger. Spawned as a relay it fires its target and
		//never changes level
		HLEntSpawnTrigger(map, e, TRUE);

		e->touch_fn = HLM_CHANGELEVEL_TOUCH;

		//USE_ONLY: fired by a script rather than walked into. c1a0's tram
		//transition is one of these
		e->use_fn = HLM_CHANGELEVEL_USE;

		return 1;
	}

	if (!StrCompare(e->classname, "trigger_gravity"))
	{
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_GRAVITY_TOUCH;
		return 1;
	}

	if (!StrCompare(e->classname, "trigger_auto"))
	{
		//fires once shortly after level start. CAutoTrigger::Precache sets
		//nextthink to time + 0.1 and nothing else: the fixed tenth lets the
		//rest of the map finish spawning.
		//
		//The delay key belongs to SUB_UseTargets, which defers the fire by it,
		//and is not part of this schedule. Scheduling the think at +delay as
		//well spent it twice: c0a0's announcer trigger has delay 1 and fired
		//at 2s, and every trigger_auto in the map ran a delay behind the
		//sequencing the mapper wrote
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		HLEntSetThink(e, HLM_AUTO_THINK, hl_ent_time + 0.1);
		return 1;
	}

	if (!StrCompare(e->classname, "multi_manager"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_MULTI_MANAGER_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "multisource"))
	{
		//CMultiSource::Spawn, buttons.cpp:186. Locked until every input has
		//fired; HLMultiSourceRegisterAll collects them once the spawn pass is
		//through and clears SF_MULTI_INIT
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->toggle_state = HLTS_AT_BOTTOM;
		e->use_fn       = HLM_MULTISOURCE_USE;
		e->spawnflags   = e->spawnflags | HLSF_MULTI_INIT;
		return 1;
	}

	//--- static brushwork ---
	if (!StrCompare(e->classname, "func_breakable"))
	{
		HLEntSetBrushSize(map, e);

		e->movetype   = HLMOVETYPE_PUSH;
		e->solid      = HLSOLID_BSP;
		e->ent_class  = HLC_WALL;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 1.0;

		//SF_BREAK_TRIGGER_ONLY. such a brush ignores damage entirely and only
		//goes when a script says so
		if (e->spawnflags & 1)
		{
			e->takedamage = HLDMG_TAKE_NO;
			e->use_fn     = HLM_BREAK_USE;
		}
		else
			e->use_fn = HLM_BREAK_USE;

		return 1;
	}

	if (!StrCompare(e->classname, "func_pushable"))
	{
		//CPushable::Spawn, dlls/func_break.cpp:820
		HLEntSetBrushSize(map, e);

		//SOLID_BBOX in the SDK; HLClipToNativeBrushes only clips HLSOLID_BSP,
		//and a pushable that is not solid can be neither pushed nor stood on
		e->solid     = HLSOLID_BSP;
		e->ent_class = HLC_PUSHABLE;
		e->use_fn    = HLM_PUSH_MOVE_USE;
		e->touch_fn  = HLM_PUSH_MOVE_TOUCH;

		//SF_PUSH_BREAKABLE splits the class: with it the crate is also a
		//CBreakable and takes damage, without it TakeDamage returns 1 and
		//nothing happens
		if (e->spawnflags & HLSF_PUSH_BREAKABLE)
		{
			e->takedamage = HLDMG_TAKE_YES;

			if (e->health <= 0.0)
				e->health = 1.0;
		}
		else
			e->takedamage = HLDMG_TAKE_NO;

		if (e->push_friction > HLPUSH_MAX_FRICTION)
			e->push_friction = HLPUSH_MAX_FRICTION;

		e->push_max_speed = HLPUSH_BASE_SPEED - e->push_friction;
		e->push_friction  = 0.0;

		//"Multiply by area of the box's cross-section", func_break.cpp:922
		e->push_buoyancy = e->push_buoyancy *
			(e->maxs[0] - e->mins[0]) * (e->maxs[1] - e->mins[1]) *
			HLPUSH_BUOY_SCALE;

		e->push_snd_time = 0.0;
		e->push_snd_last = 0;

		//"Pick up off of the floor", func_break.cpp:840
		e->origin[2] += 1.0;
		HLEntSetAbsBox(e);

		return 1;
	}

	if (!StrCompare(e->classname, "func_wall") ||
		!StrCompare(e->classname, "func_wall_toggle"))
	{
		HLEntSetBrushSize(map, e);
		e->movetype  = HLMOVETYPE_PUSH;
		e->solid     = HLSOLID_BSP;
		e->ent_class = HLC_WALL;
		e->use_fn    = HLM_WALL_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "func_illusionary"))
	{
		//CFuncIllusionary: drawn, and not solid. The one brush class that is
		//meant to be seen without being touched
		HLEntSetBrushSize(map, e);
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	if (!StrCompare(e->classname, "func_ladder"))
	{
		//CLadder::Precache. Not solid, and invisible unless showtriggers is
		//set - HL hides it with rendermode kRenderTransTexture and renderamt 0
		//rather than EF_NODRAW, which comes to the same thing for a renderer
		//that acts on the one bit. The climb itself is HLLadderFind and
		//HLPMLadderMove in HLClip.ZC, which match this classname against the
		//entity list on their own. func_ladder is also the single biggest source
		//of a mapper texture left on screen: 171 of them over 55 maps, all
		//AAATRIGGER
		HLEntSetBrushSize(map, e);
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		if (HLCvarGet("showtriggers") == 0.0)
			e->effects = e->effects | HLEF_NODRAW;

		return 1;
	}

	if (!StrCompare(e->classname, "func_conveyor"))
	{
		//CFuncConveyor::Spawn, dlls/bmodels.cpp:155. Solid, since the player
		//stands on the belt, and it pushes on touch. HLEntTouchPlayer
		//special-cases this touch_fn - a solid brush is not otherwise touch
		//tested
		HLEntSetBrushSize(map, e);
		HLEntSetMoveDir(e);

		e->movetype  = HLMOVETYPE_PUSH;
		e->solid     = HLSOLID_BSP;
		e->ent_class = HLC_WALL;
		e->touch_fn  = HLM_CONVEYOR_TOUCH;

		//SF_CONVEYOR_VISUAL: FL_CONVEYOR is not set, so the brush scrolls its
		//texture and carries nothing
		if (e->spawnflags & HLSF_CONVEYOR_VISUAL)
			e->touch_fn = HLM_NONE;

		//SF_CONVEYOR_NOTSOLID, bmodels.cpp:163
		if (e->spawnflags & HLSF_CONVEYOR_NOTSOLID)
			e->solid = HLSOLID_NOT;

		if (e->speed == 0.0)
			e->speed = 100.0;

		HLEntSetAbsBox(e);
		return 1;
	}

	if (!StrCompare(e->classname, "func_friction"))
	{
		//a volume, not a surface: HL implements "this floor is slippery" as a
		//trigger brush you walk through, which is why it has no visible model
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_FRICTION_TOUCH;
		e->use_fn   = HLM_NONE;
		return 1;
	}

	if (!StrCompare(e->classname, "func_healthcharger"))
	{
		HLEntSpawnCharger(map, e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "func_recharge"))
	{
		HLEntSpawnCharger(map, e, FALSE);
		return 1;
	}

	//--- items ---
	//
	//world_items is gone by now: HLEntParse rewrote its classname to the item
	//it stands for, so the model pass could resolve it. See CWorldItem::Spawn,
	//items.cpp:55
	if (!StrCompare(e->classname, "item_healthkit") ||
		!StrCompare(e->classname, "item_security") ||
		!StrCompare(e->classname, "item_battery") ||
		!StrCompare(e->classname, "item_suit") ||
		!StrCompare(e->classname, "item_longjump") ||
		!StrCompare(e->classname, "item_antidote"))
	{
		HLEntSpawnItem(e);
		return 1;
	}

	//weapon_* and ammo_* belong to HLWeapon.ZC, which walks the entity list
	//itself and rebuilds the pickup box from the origin. Recognised here, and
	//left non-solid and touch-less so both pickup paths cannot claim one item
	if (!StrNICompare(e->classname, "weapon_", 7) ||
		!StrNICompare(e->classname, "ammo_", 5))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		//CBasePlayerItem::FallInit, weapons.cpp:565, is MOVETYPE_TOSS and
		//lands the box the same way CItem::Spawn's DROP_TO_FLOOR does. The
		//pickup box HLWeaponPickup rebuilds is this origin plus
		//(-16,-16,0)..(16,16,16); the settle is HLEntDropPickups
		HLVecSet(e->mins, -HLENT_ITEM_HALF, -HLENT_ITEM_HALF, 0.0);
		HLVecSet(e->maxs, HLENT_ITEM_HALF, HLENT_ITEM_HALF, HLENT_ITEM_TOP);

		HLEntSetAbsBox(e);
		return 1;
	}

	//--- env_*: the effect family ---
	if (!StrCompare(e->classname, "env_sprite"))
	{
		HLEntSpawnSprite(e, TRUE);
		return 1;
	}

	if (!StrCompare(e->classname, "env_glow") ||
		!StrCompare(e->classname, "cycler_sprite"))
	{
		HLEntSpawnSprite(e, FALSE);
		return 1;
	}

	if (!StrCompare(e->classname, "env_beam") ||
		!StrCompare(e->classname, "env_lightning"))
	{
		HLEntSpawnBeam(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_laser"))
	{
		HLEntSpawnLaser(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_render"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_RENDER_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_message"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_MESSAGE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "game_text"))
	{
		//the only difference from env_message is where the words come from:
		//game_text's are already in "message", env_message's are a key into
		//titles.txt. Two methods rather than one classname test per fire
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_GAME_TEXT_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_fade"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_FADE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_shake"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_SHAKE_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_explosion"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_EXPLOSION_USE;

		//CEnvExplosion::Spawn's m_spriteScale, floored at 10. The scale field is
		//otherwise a sprite's, and env_explosion has no sprite
		e->scale = (e->magnitude - 50.0) * 0.6;

		if (e->scale < 10.0)
			e->scale = 10.0;

		return 1;
	}

	if (!StrCompare(e->classname, "env_spark"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_SPARK_USE;

		//the spark direction is the "angle" key. resolving it here is safe -
		//env_spark has no brushwork whose orientation could be lost
		HLEntSetMoveDir(e);

		if (e->max_delay <= 0.0)
			e->max_delay = 1.5;

		//SF_SPARK_START_ON, or a spark nothing can name. same rule as the
		//unnamed sprite
		if ((e->spawnflags & HLSF_SPARK_START_ON) || !e->targetname[0])
			HLEntSetThink(e, HLM_SPARK_THINK, hl_ent_time + 0.2 +
				ToF64(HLPartRandI(100)) * 0.01);

		return 1;
	}

	if (!StrCompare(e->classname, "env_bubbles"))
	{
		HLEntSpawnBubbles(map, e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_smoker"))
	{
		//CSmoker::Spawn thinks immediately. health is the puff count, dmg the
		//horizontal spread; a mapper-placed one usually leaves both empty,
		//since the class exists for the gargantua to create at runtime
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		if (e->health <= 0.0)
			e->health = 10.0;

		if (e->dmg <= 0.0)
			e->dmg = 8.0;

		HLEntSetThink(e, HLM_SMOKER_THINK, hl_ent_time + 0.1);
		return 1;
	}

	if (!StrCompare(e->classname, "env_funnel"))
	{
		//CEnvFunnel::Spawn - solid nothing, invisible, waits to be used
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_FUNNEL_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "env_blood"))
	{
		//CBlood::Spawn - SetMovedir, so the "angle" key is the spray direction
		HLEntSetMoveDir(e);

		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_BLOOD_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "gibshooter") ||
		!StrCompare(e->classname, "env_shooter"))
	{
		HLEntSpawnShooter(e);
		return 1;
	}

	if (!StrCompare(e->classname, "env_global"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_GLOBAL_USE;

		//SF_GLOBAL_SET_SPAWN: the initial state is applied on map load rather
		//than waiting to be triggered
		if ((e->spawnflags & HLSF_GLOBAL_SET_SPAWN) && e->global_state[0])
		{
			//only adds state: overwriting on every map load would undo a flag
			//an earlier map set
			if (HLEntGlobalGet(e->global_state) == HLGLOBAL_OFF)
				HLEntGlobalSet(e->global_state, e->initial_state);
		}

		return 1;
	}

	if (!StrCompare(e->classname, "env_sound"))
	{
		//pure data. HLEntFrame picks the nearest one containing the player and
		//publishes its roomtype - see hl_ent_roomtype
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	//--- cycler ---
	if (!StrCompare(e->classname, "cycler"))
	{
		//a studio model that changes animation when shot. HLEntLoadModels
		//resolved the "model" key, so it draws; the animation change needs
		//monster damage routing
		e->movetype   = HLMOVETYPE_NONE;
		e->solid      = HLSOLID_BBOX;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 80.0;

		return 1;
	}

	//--- scripts and actors ---
	if (!StrCompare(e->classname, "scripted_sentence"))
	{
		//speech without a sequence. HLAI.ZC owns the sentence scheduler and
		//compiles after this file, so this only posts the request, with the same
		//GOING_DOWN convention as scripted_sequence. HLAIFrame picks it up at
		//its HLC_SENTENCE branch, HLAI.ZC:8259.
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->ent_class    = HLC_SENTENCE;
		e->use_fn       = HLM_SENTENCE_USE;
		e->toggle_state = HLTS_AT_BOTTOM;

		return 1;
	}

	if (!StrCompare(e->classname, "scripted_sequence") ||
		!StrCompare(e->classname, "aiscripted_sequence"))
	{
		e->movetype     = HLMOVETYPE_NONE;
		e->solid        = HLSOLID_NOT;
		e->ent_class    = HLC_SCRIPT;
		e->use_fn       = HLM_SCRIPT_USE;
		e->toggle_state = HLTS_AT_BOTTOM;
		e->owner        = -1;

		//a script nothing can name runs as soon as the map does
		if (!e->targetname[0])
			e->toggle_state = HLTS_GOING_DOWN;

		return 1;
	}

	//CSittingScientist. A separate class from CScientist on the same model: it
	//never moves, never routes and never fights, so it takes no AI slot and
	//HLAIMonKindFor leaves it alone
	if (!StrCompare(e->classname, "monster_sitting_scientist"))
	{
		e->movetype   = HLMOVETYPE_STEP;
		e->solid      = HLSOLID_SLIDEBOX;
		e->ent_class  = HLC_MONSTER;
		e->takedamage = HLDMG_TAKE_YES;
		e->health     = 50.0;
		e->effects    = 0;

		//UTIL_SetSize(-14,-14,0)-(14,14,36) - a seated man, not a standing one
		HLVecSet(e->mins, -14.0, -14.0, 0.0);
		HLVecSet(e->maxs, 14.0, 14.0, 36.0);
		HLEntSetAbsBox(e);

		HLEntScientistHead(e);

		//pev->sequence = m_baseSequence + RANDOM_LONG(0,4): one of the five
		//sitting takes, which is the whole of this class's behaviour here.
		//SittingThink also turns the head and speaks; both need the talk
		//monster layer, which is not ported
		HLEntSitScientistSeq(e, HLPartRandI(5));

		return 1;
	}

	//the dead props: CDeadScientist, CDeadBarney, CDeadHGrunt and CDeadHEV.
	//Each is its own class over a pose table, indexed by the "pose" key
	if (!StrCompare(e->classname, "monster_scientist_dead") ||
		!StrCompare(e->classname, "monster_barney_dead") ||
		!StrCompare(e->classname, "monster_hgrunt_dead") ||
		!StrCompare(e->classname, "monster_hevsuit_dead"))
	{
		HLEntSpawnDeadMonster(e);
		return 1;
	}

	//CFurniture::Spawn, scripted.cpp:1251. Furniture is a prop a scripted
	//sequence may animate, not a monster: it never moves, never routes and is
	//not meant to be shootable or walkable-into as a man-sized box. MonsterInit
	//does not resize it, so it keeps the hull SET_MODEL gave it - which for
	//filecabinet.mdl, both shipped instances, is a point hull.
	//
	//Two instances ship, the c1a0 and c1a1f headcrab cabinets
	if (!StrCompare(e->classname, "monster_furniture"))
	{
		e->movetype   = HLMOVETYPE_NONE;
		e->solid      = HLSOLID_BBOX;
		e->ent_class  = HLC_MONSTER;
		e->takedamage = HLDMG_TAKE_AIM;
		e->effects    = 0;
		e->health     = 80000.0;
		e->max_health = e->health;
		e->seq        = 0;
		e->frame      = 0;

		HLVecSet(e->mins, 0.0, 0.0, 0.0);
		HLVecSet(e->maxs, 0.0, 0.0, 0.0);
		HLEntSetAbsBox(e);

		return 1;
	}

	//monsters are recognised so they get a class tag and stop counting as
	//unknown. their models were already resolved by HLEntLoadModels
	if (!StrNICompare(e->classname, "monster_", 8))
	{
		e->movetype   = HLMOVETYPE_STEP;
		e->solid      = HLSOLID_SLIDEBOX;
		e->ent_class  = HLC_MONSTER;
		e->takedamage = HLDMG_TAKE_YES;

		if (e->health <= 0.0)
			e->health = 20.0;

		//CScientist::Spawn picks a head for a body of -1, which one of c1a0's
		//scientists is authored with
		if (!StrCompare(e->classname, "monster_scientist"))
			HLEntScientistHead(e);

		//a hull, so the box clip has something to sweep against. The AI table
		//overwrites it per monster in HLAIMonRegisterAll; this is VEC_HUMAN_HULL
		//for the classes that never reach it
		if (e->size[0] <= 0.0)
		{
			HLVecSet(e->mins, -16.0, -16.0, 0.0);
			HLVecSet(e->maxs, 16.0, 16.0, 72.0);
			HLEntSetAbsBox(e);
		}

		//CGMan and the rest of the idle props: sequence 0 is a sensible idle in
		//gman.mdl (idle01) and roach.mdl (run), and monster_generic wears
		//whatever the mapper named, so nothing else needs choosing here
		return 1;
	}

	//--- sound ---
	if (!StrCompare(e->classname, "ambient_generic"))
	{
		//"message" is the wav path relative to sound/. "health" is the volume
		//on a 0-10 scale, not the 0-1 the mixer wants.
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_AMBIENT_USE;

		if (!e->message[0])
			return 1;

		//Registered whatever the spawnflags say. InitModulationParms derives
		//the starting active and looping state from START_SILENT and
		//NOT_LOOPING itself, and the modulation block has to exist before the
		//first trigger: HLAmbientUse toggles a slot rather than creating one.
		//
		//"health" is the volume key on a 0-10 scale. HLAmbientVolume folds an
		//absent key to full, which is the FGD default of 10.
		//
		//fadein/fadeout share fade_in/fade_out with env_fade - identical key
		//names, and no entity is both classes.
		//
		//c0a0's two announcer lines are spawnflags 49: EVERYWHERE plus
		//START_SILENT plus NOT_LOOPING, fired by a multi_manager.
		HLSndAmbientAddEx(e->origin, e->message, HLAmbientAtten(e),
			e->preset, ToI64(HLAmbientVolume(e) * 10.0),
			e->amb_pitch, e->amb_pitchstart, e->amb_spinup, e->amb_spindown,
			e->amb_volstart, ToI64(e->fade_in), ToI64(e->fade_out),
			e->amb_lfotype, e->amb_lforate, e->amb_lfomodpitch,
			e->amb_lfomodvol, e->amb_cspinup,
			ToBool(e->spawnflags & HLSF_AMBIENT_START_SILENT),
			ToBool(!(e->spawnflags & HLSF_AMBIENT_NOT_LOOPING)));

		return 1;
	}

	//--- lights ---
	if (!StrCompare(e->classname, "light") ||
		!StrCompare(e->classname, "light_spot") ||
		!StrCompare(e->classname, "light_environment"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;

		//only a light with a style is switchable; the rest were baked into
		//the lightmap by qrad and have nothing left to do at runtime
		if (e->style >= 32)
		{
			e->use_fn = HLM_LIGHT_USE;

			//SF_LIGHT_START_OFF
			if (e->spawnflags & 1)
			{
				HLLightStyleSet(e->style, "a");
				e->toggle_state = HLTS_AT_BOTTOM;
			}
			else
			{
				HLLightStyleSet(e->style, "m");
				e->toggle_state = HLTS_AT_TOP;
			}
		}

		return 1;
	}

	//worldspawn and the player starts carry no behaviour
	if (!StrCompare(e->classname, "info_teleport_destination") ||
		!StrCompare(e->classname, "info_landmark") ||
		!StrCompare(e->classname, "info_target") ||
		!StrCompare(e->classname, "info_intermission"))
	{
		//pure data - a named point something else aims at, teleports to, or
		//parks a camera on. info_target is a beam anchor
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		return 1;
	}

	if (!StrCompare(e->classname, "worldspawn") ||
		!StrCompare(e->classname, "info_player_start") ||
		!StrCompare(e->classname, "info_player_deathmatch") ||
		!StrCompare(e->classname, "info_player_coop") ||
		!StrCompare(e->classname, "info_node") ||
		!StrCompare(e->classname, "info_node_air"))
		return 1;

	//--- monstermaker ---
	if (!StrCompare(e->classname, "monstermaker"))
	{
		//CMonsterMaker::Spawn, dlls/monstermaker.cpp:103
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;

		slot = HLMakerFind(i);

		//no monstertype, or the block scan overflowed: nothing to make
		if (slot < 0)
			return 1;

		//the spawn pass runs at time zero and the think loop reads a next_think
		//of zero as disarmed, so a maker with no delay key needs a floor. Every
		//monstermaker in the shipped maps carries delay 1 or more
		if (e->delay <= 0.0)
			e->delay = 0.1;

		if (e->targetname[0])
		{
			e->use_fn = HLM_MAKER_USE;

			if (e->spawnflags & HLSF_MAKER_START_ON)
			{
				hl_maker[slot].active = TRUE;
				HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);
			}
		}
		else
		{
			//"no targetname, just start"
			hl_maker[slot].active = TRUE;
			HLEntSetThink(e, HLM_MAKER_THINK, hl_ent_time + e->delay);
		}

		return 1;
	}

	//--- infodecal ---
	if (!StrCompare(e->classname, "infodecal"))
	{
		//CDecal::Spawn, dlls/world.cpp:117
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;

		//CDecal::KeyValue, world.cpp:184: the texture name becomes pev->skin
		e->skin = HLDecalIndexByName(e->texture);

		//"if ( pev->skin < 0 ) REMOVE_ENTITY", world.cpp:119
		if (e->skin < 0)
		{
			e->in_use = FALSE;
			return 1;
		}

		//"the decal will spray itself on as soon as the world is done
		//spawning", world.cpp:127. Not at hl_ent_time: the spawn pass runs at
		//time zero and the think loop treats a next_think of zero as disarmed
		if (!e->targetname[0])
			HLEntSetThink(e, HLM_DECAL_THINK, hl_ent_time + 0.1);
		else
			e->use_fn = HLM_DECAL_USE;

		return 1;
	}

	//--- CD audio cues ---
	if (!StrCompare(e->classname, "trigger_cdaudio"))
	{
		//CTriggerCDAudio::Spawn is InitTrigger and nothing else,
		//dlls/triggers.cpp:686. The touch and the use both call PlayTrack
		HLEntSpawnTrigger(map, e, FALSE);
		e->touch_fn = HLM_CDAUDIO_PLAY;
		e->use_fn   = HLM_CDAUDIO_PLAY;
		return 1;
	}

	if (!StrCompare(e->classname, "target_cdaudio"))
	{
		//CTargetCDAudio::Spawn, dlls/triggers.cpp:765. The think is armed only
		//when a radius was authored; the rest are fired by name
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;
		e->use_fn   = HLM_CDAUDIO_PLAY;

		if (e->radius > 0.0)
			HLEntSetThink(e, HLM_CDAUDIO_RADIUS, hl_ent_time + 1.0);

		return 1;
	}

	//--- recognised, deliberately inert -------------------------------------
	//
	// Each of these needs a system that does not exist, not an entity. Claimed
	// here so HLEntReport's "not recognised" count means "a class nobody has
	// looked at".
	//
	// Grouped by what is missing:
	//
	//   a multiplayer drop box - weaponbox. CWeaponBox is created by
	//     CBasePlayer::PackDeadPlayerItems and by nothing a mapper places; the
	//     single player game never makes one. world_items is NOT here: HLEntParse
	//     renames it to the item its "type" names.
	//
	//   monster AI - func_monsterclip (solid to monsters only, so it must not be
	//     solid here or it walls the player in), trigger_monsterjump,
	//     info_bigmomma, func_mortar_field.
	//
	//   a mounted gun the player aims - func_tank and its controls/mortar/laser/
	//     rocket variants, func_guntarget. Nothing about the player-operated half
	//     needs the monster layer; the barrel, the traverse limits and the firing
	//     rate are the entity's own.
	//
	//   a save system hook - trigger_autosave, trigger_transition (marks which
	//     entities cross a changelevel).
	//
	//   CD audio - speaker, which is a sentence scheduler rather than a track
	//     cue and shares nothing with the two cdaudio classes above.
	//
	//   the xen_* organic props, which draw as studio models without their glow.
	if (!StrCompare(e->classname, "weaponbox") ||
		!StrCompare(e->classname, "info_bigmomma") ||
		!StrCompare(e->classname, "func_guntarget") ||
		!StrCompare(e->classname, "func_traincontrols"))
	{
		HLEntSpawnInert(map, e);
		return 1;
	}

	//The track lift, which carries a tracktrain between two path_track chains
	if (!StrCompare(e->classname, "func_trackchange") ||
		!StrCompare(e->classname, "func_trackautochange"))
	{
		HLEntSpawnTrackChange(map, e, i);
		return 1;
	}

	//CFuncMonsterClip::Spawn and CFuncMortarField::Spawn both set EF_NODRAW,
	//and CTriggerMonsterJump is a CBaseTrigger, so InitTrigger sets it there
	if (!StrCompare(e->classname, "func_monsterclip") ||
		!StrCompare(e->classname, "trigger_monsterjump") ||
		!StrCompare(e->classname, "func_mortar_field"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	//CFuncTankControls::Spawn sets EF_NODRAW; the guns themselves are the thing
	//the player looks at, so the prefix test must not catch the controls
	if (!StrCompare(e->classname, "func_tankcontrols"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	if (!StrNICompare(e->classname, "func_tank", 9))
	{
		HLEntSpawnInert(map, e);
		return 1;
	}

	if (!StrNICompare(e->classname, "xen_", 4))
	{
		HLEntSpawnXen(e);
		return 1;
	}

	//--- speaker ---
	//
	//CSpeaker::Spawn, dlls/sound.cpp:1823. The public address announcer. The
	//schedule and the sentence pick live in HLSound.ZC; this registers the
	//entity and routes its use.
	//
	//No ObjectCaps beyond CBaseEntity's, so HLEntUseInFront never reaches one:
	//a speaker answers a targetname and nothing else.
	if (!StrCompare(e->classname, "speaker"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects |= HLEF_NODRAW;
		e->use_fn   = HLM_SPEAKER_USE;

		//"SPEAKER with no Level/Sentence" - the SDK removes it on the next
		//think. HLSndSpeakerAdd refuses the same case and returns -1
		HLSndSpeakerAdd(e->origin, e->message, e->preset, e->health,
			ToBool(e->spawnflags & HLSF_SPEAKER_START_SILENT), hl_ent_time, i);

		return 1;
	}

	//CTriggerSave::Spawn, triggers.cpp:1965. InitTrigger and a touch, and the
	//touch removes the volume, so it is spawned fire-once
	if (!StrCompare(e->classname, "trigger_autosave"))
	{
		HLEntSpawnTrigger(map, e, TRUE);

		e->touch_fn = HLM_AUTOSAVE_TOUCH;

		//no CTriggerSave::Use. A save volume answers being walked into and
		//nothing else
		e->use_fn = HLM_NONE;

		return 1;
	}

	//trigger_transition marks which entities cross a changelevel. Nothing
	//reads its volume: the entity table is parsed from the BSP at a fixed
	//count, so the destination map has no slot to create a carried entity in.
	//The one entity that crosses is the ridden tracktrain, matched by
	//pev->globalname. CTriggerTransition::Spawn clears its modelindex, which
	//is what the NODRAW here stands in for
	if (!StrCompare(e->classname, "trigger_transition"))
	{
		HLEntSpawnInert(map, e, TRUE);
		return 1;
	}

	//--- the ending ---
	//
	//CTriggerCamera::Spawn, triggers.cpp:2208. MOVETYPE_NOCLIP, not solid, and
	//invisible: renderamt 0 with blending on is how the SDK hides it
	if (!StrCompare(e->classname, "trigger_camera"))
	{
		e->movetype   = HLMOVETYPE_NOCLIP;
		e->solid      = HLSOLID_NOT;
		e->effects    = e->effects | HLEF_NODRAW;
		e->use_fn     = HLM_CAMERA_USE;
		e->cam_path   = -1;
		e->cam_target = -1;

		e->cam_initial_speed = e->speed;

		if (e->cam_accel == 0.0)
			e->cam_accel = 500.0;

		if (e->cam_decel == 0.0)
			e->cam_decel = 500.0;

		return 1;
	}

	//CStripWeapons and CRevertSaved are both CPointEntity: no model, no bounds,
	//use only
	if (!StrCompare(e->classname, "player_weaponstrip"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_STRIP_USE;
		return 1;
	}

	if (!StrCompare(e->classname, "player_loadsaved"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->use_fn   = HLM_REVERT_USE;
		return 1;
	}

	//CTriggerEndSection::Spawn, triggers.cpp:2019. A brush volume; InitTrigger
	//hides it. SF_ENDSECTION_USEONLY withholds the touch
	if (!StrCompare(e->classname, "trigger_endsection"))
	{
		HLEntSpawnTrigger(map, e, FALSE);

		e->use_fn = HLM_ENDSECTION;

		if (!(e->spawnflags & HLSF_ENDSECTION_USEONLY))
			e->touch_fn = HLM_ENDSECTION;

		return 1;
	}

	//CEnvBeverage::Spawn, effects.cpp:2189
	if (!StrCompare(e->classname, "env_beverage"))
	{
		e->movetype = HLMOVETYPE_NONE;
		e->solid    = HLSOLID_NOT;
		e->effects  = e->effects | HLEF_NODRAW;
		e->use_fn   = HLM_BEVERAGE_USE;

		//"if ( pev->health == 0 ) pev->health = 10" - the stock of cans
		if (e->health == 0.0)
			e->health = 10.0;

		return 1;
	}

	return 0;
}

U0 HLEntParseMultiManagers(CHLMap *map)
{//a multi_manager's targets are its key names, with the delay as the value, so
 //the generic parser has no field list to match them against. re-scan the lump
 //for those blocks only
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[64];
	U8	 name[64];
	I64	 k;
	I64	 slot;
	I64	 ent;
	I64	 n;
	I64	 block;
	I64	 seen;

	hl_mm_count = 0;
	block       = 0;

	if (!map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_mm_count < HLENT_MM_SLOTS)
	{
		//No p++ here: qpmm_next_char below advances. Doing both stepped the
		//scan two bytes per non-brace character, so it saw every other byte
		//and missed any block opening on the wrong parity. Every
		//multi_manager in the game parsed as empty.
		if (*p != '{')
			goto qpmm_next_char;

		p++;
		slot          = hl_mm_count;
		hl_mm[slot].count = 0;
		name[0]       = 0;

		while (p < end && *p != '}')
		{
			//key
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			//The scan runs to the closing quote; only the copy is capped. A
			//scan that stops at the cap leaves p inside the string, and every
			//quote in the remainder reads as a delimiter. worldspawn's "wad"
			//value is 108 characters against a 64 byte buffer, so the first
			//block of every map desynchronises the parser and it reaches the
			//end of the lump without a closing brace.
			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					key[k] = *p;
					k++;
				}

				p++;
			}
			key[k] = 0;
			if (p < end)
				p++;

			//value
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					val[k] = *p;
					k++;
				}

				p++;
			}
			val[k] = 0;
			if (p < end)
				p++;

			if (!StrCompare(key, "classname"))
			{
				HLStrCopy(name, val, 64);
				goto qpmm_next_key;
			}

			//everything that is not one of the handful of real fields is a
			//target name
			if (!StrCompare(key, "targetname") ||
				!StrCompare(key, "origin") ||
				!StrCompare(key, "angle") ||
				!StrCompare(key, "angles") ||
				!StrCompare(key, "spawnflags") ||
				!StrCompare(key, "wait") ||
				!StrCompare(key, "model"))
				goto qpmm_next_key;

			//UTIL_StripToken, dlls/util.cpp:1631, called from
			//CMultiManager::KeyValue. A key is truncated at '#': the suffix is
			//how a mapper repeats one target at two delays, since the block
			//cannot carry the same key twice. 960 keys in the shipped maps
			//carry one, and unstripped every last one names nothing.
			for (k = 0; key[k] != 0; k++)
			{
				if (key[k] == '#')
				{
					key[k] = 0;
					goto qpmm_stripped;
				}
			}

qpmm_stripped:

			if (hl_mm[slot].count < HLENT_MM_MAX)
			{
				n = hl_mm[slot].count;
				HLStrCopy(&hl_mm[slot].name[n * 64], key, 64);
				hl_mm[slot].delay[n] = HLAtoF(val);
				hl_mm[slot].count    = n + 1;
			}

qpmm_next_key:
		}

		if (!StrCompare(name, "multi_manager"))
		{
			//Bind the Nth multi_manager block to the Nth multi_manager entity.
			//The lump and hl_entities are both in file order, so the counts
			//agree - but only if this count advances for every block, including
			//one with no target keys. Keying it off hl_mm_count instead skips
			//the empty block's entity and shifts every later manager onto the
			//wrong schedule.
			ent  = -1;
			seen = 0;

			for (n = 0; n < hl_num_entities; n++)
			{
				if (StrCompare(hl_entities[n].classname, "multi_manager"))
					goto qpmm_next_ent;

				if (seen == block)
				{
					ent = n;
					break;
				}

				seen++;

qpmm_next_ent:
			}

			block++;

			if (ent >= 0 && hl_mm[slot].count > 0)
			{
				hl_mm[slot].ent = ent;

				//every run free. A slot is reused across map loads
				for (k = 0; k < HLENT_MM_THREADS; k++)
				{
					hl_mm[slot].fired[k]   = 0;
					hl_mm[slot].started[k] = -1.0;
				}

				hl_mm_count++;
			}
		}

qpmm_next_char:
		if (p < end)
			p++;
	}
}

U0 HLEntParseMakers(CHLMap *map)
{//monstertype, monstercount and m_imaxlivechildren are CMonsterMaker's own
 //keys and are not in the generic field table, so the lump is re-scanned for
 //monstermaker blocks. Same scan and same block-to-entity binding as
 //HLEntParseMultiManagers above - read the notes there
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[64];
	U8	 name[64];
	U8	 monster[64];
	I64	 k;
	I64	 slot;
	I64	 ent;
	I64	 n;
	I64	 block;
	I64	 seen;
	I64	 count;
	I64	 max_live;

	HLMakerReset;
	block = 0;

	if (!map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end && hl_maker_count < HLMAKER_MAX)
	{
		if (*p != '{')
			goto qpmk_next_char;

		p++;
		name[0]    = 0;
		monster[0] = 0;
		count      = 0;
		max_live   = 0;

		while (p < end && *p != '}')
		{
			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					key[k] = *p;
					k++;
				}

				p++;
			}
			key[k] = 0;
			if (p < end)
				p++;

			while (p < end && *p != '"' && *p != '}')
				p++;
			if (p >= end || *p == '}')
				break;

			p++;
			k = 0;
			while (p < end && *p != '"')
			{
				if (k < 63)
				{
					val[k] = *p;
					k++;
				}

				p++;
			}
			val[k] = 0;
			if (p < end)
				p++;

			if (!StrCompare(key, "classname"))
				HLStrCopy(name, val, 64);
			else if (!StrCompare(key, "monstertype"))
				HLStrCopy(monster, val, 64);
			else if (!StrCompare(key, "monstercount"))
				count = ToI64(HLAtoF(val));
			else if (!StrCompare(key, "m_imaxlivechildren"))
				max_live = ToI64(HLAtoF(val));
		}

		if (!StrCompare(name, "monstermaker"))
		{
			ent  = -1;
			seen = 0;

			for (n = 0; n < hl_num_entities; n++)
			{
				if (StrCompare(hl_entities[n].classname, "monstermaker"))
					goto qpmk_next_ent;

				if (seen == block)
				{
					ent = n;
					break;
				}

				seen++;

qpmk_next_ent:
			}

			block++;

			if (ent >= 0 && monster[0])
			{
				slot = hl_maker_count;

				hl_maker[slot].ent          = ent;
				HLStrCopy(hl_maker[slot].monster, monster, 64);
				hl_maker[slot].num_monsters = count;
				hl_maker[slot].max_live     = max_live;
				hl_maker[slot].live         = 0;
				hl_maker[slot].ground       = 0.0;
				hl_maker[slot].active       = FALSE;

				hl_maker_count++;
			}
		}

qpmk_next_char:
		if (p < end)
			p++;
	}
}

//Bounded trace of the first entity events after a map loads, written to the
//log. A scripted opening either fires or it does not, and the console is the
//only place that can be observed from inside the VM.
#define HLENT_TRACE_MAX		512	//c0a0's opening alone is over forty events,
									//and 96 ran out before the 3.4s tram start
#define HLENT_TRACE_WINDOW	20.0	//seconds of game time

I64  hl_ent_trace_count = 0;
Bool hl_ent_trace_on    = FALSE;

//CFuncTrackTrain carries FL_ALWAYSTHINK, plats.cpp:995, so it dispatches at the
//server rate: 72 lines a second, which spends the whole budget in one and
//buries every other event behind "trace budget reached". An always-think class
//is logged on a state change only. -1 is "nothing logged for this slot yet".
I64 hl_ent_trace_sig[HLENT_MAX];

U0 HLEntTraceReset()
{
	I64 i;

	hl_ent_trace_count = 0;
	hl_ent_trace_on    = FALSE;

	for (i = 0; i < HLENT_MAX; i++)
		hl_ent_trace_sig[i] = -1;
}

I64 HLEntTraceSig(CHLEntity *e, I64 method)
{//method, current path node and speed, folded into one comparable value. Taken
 //modulo a prime: every arithmetic here is F64, and an unbounded rolling hash
 //over a 64 byte name runs past the mantissa
	I64 h = method;
	I64 i;

	for (i = 0; i < 64 && e->target[i] != 0; i++)
		h = (h * 31 + e->target[i]) % 1000003;

	return (h * 31 + ToI64(e->speed)) % 1000003;
}

Bool HLEntTraceChanged(I64 ent, CHLEntity *e, I64 method)
{//TRUE when this dispatch says something the last logged one did not.
 //
 //Only the always-think classes are filtered. A repeated think on anything else
 //is the kind of thing the trace exists to show - two on one entity are a
 //delayed fire behind an auto trigger, four are a bug
	I64 sig;

	if (!e || e->ent_class != HLC_TRACKTRAIN)
		return TRUE;

	if (ent < 0 || ent >= HLENT_MAX)
		return TRUE;

	sig = HLEntTraceSig(e, method);

	if (hl_ent_trace_sig[ent] == sig)
		return FALSE;

	hl_ent_trace_sig[ent] = sig;

	return TRUE;
}

U0 HLEntTrace(U8 *what, I64 ent, I64 method)
{//One line per dispatched event: who, what method, what class, what name.
 //
 //The method id is the whole point of the line. Two thinks on one entity are
 //a delayed fire behind an auto trigger; four are a bug, and without the id
 //they read the same
	CHLEntity	*e;
	U8			 line[192];

	if (!hl_ent_trace_on || hl_ent_trace_count >= HLENT_TRACE_MAX)
		return;

	if (hl_ent_time > HLENT_TRACE_WINDOW)
		return;

	e = HLEntGet(ent);

	if (!e)
		return;

	hl_ent_trace_count++;

	StrPrint(line, "ENT %6.2f %-6s m%-3d %3d %-22s \"%s\" -> \"%s\"\n",
		hl_ent_time, what, method, ent, e->classname, e->targetname,
		e->target);

	HLLog(line);
	"%s", line;

	if (hl_ent_trace_count == HLENT_TRACE_MAX)
	{
		HLLog("ENT trace budget reached\n");
		"ENT trace budget reached\n";
	}
}

//--- worldspawn startdark / gametitle ---------------------------------------
//
// Two keys the entity table does not carry. CWorld::KeyValue turns startdark
// into the engine cvar v_dark and gametitle into gDisplayTitle -
// dlls/world.cpp:702 and :718 - and CWorld::Spawn applies both at :648.
// gDisplayTitle reaches the client on the player's first spawn,
// dlls/player.cpp:4154.
//
// c0a0's worldspawn sets both. Without them the chapter opens on a lit world
// with no logo.
//
// The lump is re-scanned rather than the keys added to CHLEntity, the way
// HLEntParseMultiManagers does - read the notes there, in particular that the
// scan runs to the real delimiter and only the copy is capped.

U0 HLEntWorldStartup(CHLMap *map)
{
	CHLTitleMsg	 t;
	U8			*p;
	U8			*end;
	U8			 key[64];
	U8			 val[64];
	U8			 text[HLMSG_MAX_TEXT];
	I64			 k;
	Bool		 dark;
	Bool		 title;

	dark  = FALSE;
	title = FALSE;

	if (!map || !map->entities || map->entities_size <= 0)
		return;

	p   = map->entities;
	end = map->entities + map->entities_size;

	//worldspawn is the first block of the lump, always
	while (p < end && *p != '{')
		p++;

	if (p < end)
		p++;

	while (p < end && *p != '}')
	{
		while (p < end && *p != '"' && *p != '}')
			p++;
		if (p >= end || *p == '}')
			break;

		p++;
		k = 0;
		while (p < end && *p != '"')
		{
			if (k < 63)
			{
				key[k] = *p;
				k++;
			}

			p++;
		}
		key[k] = 0;
		if (p < end)
			p++;

		while (p < end && *p != '"' && *p != '}')
			p++;
		if (p >= end || *p == '}')
			break;

		p++;
		k = 0;
		while (p < end && *p != '"')
		{
			if (k < 63)
			{
				val[k] = *p;
				k++;
			}

			p++;
		}
		val[k] = 0;
		if (p < end)
			p++;

		if (!StrCompare(key, "startdark") && HLAtoF(val) != 0.0)
			dark = TRUE;
		else if (!StrCompare(key, "gametitle") && HLAtoF(val) != 0.0)
			title = TRUE;
	}

	if (dark)
	{
		//v_dark's own ramp is engine side and not in the SDK. Held at black
		//and released after three seconds, so a map that sets startdark and
		//never fires an env_fade still comes back. c0a0 fires one at 0.3s,
		//which replaces this.
		HLHudFadeSet(0, 0, 0, 255, 0.0, 3.0, FALSE);
	}

	if (title)
	{
		//GAMETITLE holds the logo's timing and colour; its block text is a
		//placeholder the SDK never draws - valve/titles.txt:518.
		if (HLEntTitleLook("GAMETITLE", text, HLMSG_MAX_TEXT, &t))
			HLHudTitleShow(t.r1, t.g1, t.b1, t.x, t.y,
				t.fadein, t.holdtime, t.fadeout);
	}
}

U0 HLEntDropPickups(CHLMap *map)
{//SV_DropToFloor over every item, weapon and ammo box, after the spawn pass
 //
 //Measured over the 125 shipped BSPs: 2287 item_*, weapon_* and ammo_* carry an
 //origin, and 1536 of them have world solid more than 2 units below it. The
 //engine settles them at spawn; without that the trigger box floats and the
 //player walks under the pickup.
	CHLEntity	*e;
	I64			 i;

	if (!hl_entities || !map)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->brush_model >= 1)
			goto qedp_next;

		if (e->ent_class != HLC_ITEM &&
			StrNICompare(e->classname, "weapon_", 7) &&
			StrNICompare(e->classname, "ammo_", 5))
			goto qedp_next;

		if (HLEntDropToFloor(map, e, e->mins, e->maxs))
			HLEntSetAbsBox(e);

qedp_next:
	}
}

I64 HLEntSpawnAll(CHLMap *map)
{//ED_LoadFromFile's second half: run every class function
	I64 i;
	I64 known = 0;

	hl_ent_time       = 0.0;
	hl_ent_thinks     = 0;
	hl_ent_player     = -1;
	hl_train_use_log  = 8;
	hl_ent_callq_head = 0;
	hl_ent_callq_tail = 0;
	hl_ent_callq_lost = 0;

	//ambients are re-registered by the spawn pass below, so the previous
	//map's must go first or they accumulate. Speakers are keyed by entity
	//index and carry the same hazard
	HLSndAmbientClear;
	HLSndSpeakerClear;

	//HLClip.ZC's rotation registry is indexed by entity slot and HLClipInit runs
	//at startup only. A slot that held a func_rotating in one map says nothing
	//about the next, and a stale flag traces an ordinary door through an
	//orientation it does not have
	HLClipRotatingReset;

	//Liquid brush entities are registered by the spawn pass below and would
	//otherwise accumulate across maps, answering point contents from the
	//previous map's brush models
	HLWaterBrushReset;

	//Looping train voices are indexed the same way and leak across a map change
	//for the same reason.
	HLTrainVoiceReset;

	//HLCvarInit runs at startup and this file compiles after it, so the ride
	//trace registers its own cvar here. HLConCvarCommand rejects names that are
	//not in the table, so without this `ridelog 1` reads as an unknown command.
	if (HLCvarIndex("ridelog") < 0)
		HLCvarDefine("ridelog", 0.0);

	//the changelevel capture, on the same terms
	if (HLCvarIndex("cllog") < 0)
		HLCvarDefine("cllog", 0.0);

	//Trace the opening seconds. Bounded by count and by game time, so it costs
	//nothing after the level has settled.
	HLEntTraceReset;
	hl_ent_trace_on = TRUE;

	//a fresh map means full health and no stale pending effect
	HLEntPlayerReset;

	//the missing-title complaint budget is per map, so a bad titles.txt is
	//reported on the map that needed it rather than once ever
	hl_ent_title_misses = 0;

	//no message from the previous map survives the load
	HLHudMsgClear;

	//startdark and gametitle, before anything can fire an env_fade over them
	HLEntWorldStartup(map);

	HLEntParseMultiManagers(map);

	//monstermaker keys, on the same terms and before the spawn pass reads them
	HLEntParseMakers(map);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qesa_next;

		//DispatchSpawn's global block, cbase.cpp:156, which runs before the
		//class function. A globalname the table already holds as GLOBAL_DEAD
		//was removed on an earlier visit and does not come back
		if (!HLEntGlobalNameSpawnAllows(&hl_entities[i], hl_map_name))
		{
			hl_entities[i].in_use  = FALSE;
			hl_entities[i].spawned = TRUE;
			goto qesa_next;
		}

		if (HLEntSpawnOne(map, i))
			known++;
		else
		{
			//unrecognised. left unspawned so the report counts it and a later
			//pass can claim it once the class exists
			hl_entities[i].spawned = FALSE;

			//ED_LoadFromFile removes an entity whose classname resolves to no
			//class, so nothing unrecognised is ever on screen in HL. Here the
			//slot survives to be counted, and a brush model on it would be
			//drawn with whatever the mapper left on the faces
			if (hl_entities[i].brush_model > 0)
				hl_entities[i].effects =
					hl_entities[i].effects | HLEF_NODRAW;
		}

qesa_next:
	}

	//CMultiSource::Register, buttons.cpp:239, deferred by the SDK to a think at
	//spawn + 0.1 so it sees a fully built map. This is that point: every class
	//function has run and every target field is final
	HLMultiSourceRegisterAll;

	//DROP_TO_FLOOR for every pickup, on the same terms: the brush entities a
	//pickup can rest on are solid only after their own class function has run
	HLEntDropPickups(map);

	//monsters carried through the changelevel, after every parsed class so a
	//targetname the destination defines wins over the record
	HLEntCarryMonSpawn;

	hl_ent_spawned = known;

	return known;
}

//--- the frame --------------------------------------------------------------

U0 HLEntDrainCalls()
{//dispatch everything queued, including anything queued BY the dispatch, up
 //to a budget. a target loop hits the budget instead of the stack
	I64 budget = HLENT_CALLQ_BUDGET;
	I64 ent;
	I64 method;
	I64 activator;
	I64 use_type;
	F64 value;

	while (hl_ent_callq_head != hl_ent_callq_tail && budget > 0)
	{
		ent       = hl_ent_callq[hl_ent_callq_head].ent;
		method    = hl_ent_callq[hl_ent_callq_head].method;
		activator = hl_ent_callq[hl_ent_callq_head].activator;
		use_type  = hl_ent_callq[hl_ent_callq_head].use_type;
		value     = hl_ent_callq[hl_ent_callq_head].value;

		//live for the duration of this one dispatch. A method that queues
		//further calls does not inherit it: those carry their own.
		hl_ent_call_caller = hl_ent_callq[hl_ent_callq_head].caller;

		hl_ent_callq_head = (hl_ent_callq_head + 1) % HLENT_CALLQ_MAX;

		HLEntTrace("use", ent, method);
		HLEntCallMethod(ent, method, activator, use_type, value);

		hl_ent_call_caller = -1;

		budget--;
	}

	if (!budget)
	{
		//a chain that will not settle. drop the rest, or it comes back next
		//frame and every frame after
		hl_ent_callq_head = hl_ent_callq_tail;
		"HLEnt: call budget exhausted, target loop?\n";
	}
}

Bool HLEntBoxOverlap(CHLEntity *e, F64 *mins, F64 *maxs)
{//world space AABB test against an entity's linked bounds
	if (maxs[0] < e->absmin[0] || mins[0] > e->absmax[0])
		return FALSE;
	if (maxs[1] < e->absmin[1] || mins[1] > e->absmax[1])
		return FALSE;
	if (maxs[2] < e->absmin[2] || mins[2] > e->absmax[2])
		return FALSE;

	return TRUE;
}

U0 HLEntRideLogTick(F64 *player_org)
{//one record of the pusher-carry state, emitted after the mover pass
 //
 //Placed there and not after the thinks: the think pass recomputes a
 //tracktrain's velocity and avelocity for the NEXT tick, and the record is of
 //what this tick applied.
 //
 //The cvar is the arming edge. Raising it allocates the ring, dropping it
 //writes the file.
	CHLEntity	*e;
	U8			 line[HLRIDE_WIDTH];
	U8			 part[HLRIDE_WIDTH];
	F64			 torg[3];
	F64			 tyaw	= 0.0;
	F64			 tavel	= 0.0;
	I64			 train	= -1;
	I64			 plat	= 0;
	I64			 hit	= 0;
	I64			 solid	= 0;
	I64			 i;
	Bool		 want;

	want = ToBool(HLCvarGet("ridelog") != 0.0);

	if (want != hl_ride_log)
	{
		if (want)
			HLRideLogArm;
		else
		{
			HLRideLogFlush;
			HLRideLogFree;
		}
	}

	if (!hl_ride_log || !player_org)
		return;

	//The first live tracktrain. c0a0's intro chain has one car at a time, and
	//the index is in the record for a map that does not.
	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use &&
			hl_entities[i].ent_class == HLC_TRACKTRAIN)
		{
			train = i;
			break;
		}
	}

	HLVecSet(torg, 0.0, 0.0, 0.0);

	if (train >= 0)
	{
		e = &hl_entities[train];

		HLVecCopy(e->origin, torg);
		tyaw  = e->angles[1];
		tavel = e->avelocity[1];
	}

	if (hl_platform_active)
		plat = 1;

	if (hl_ride_probe_hit)
		hit = 1;

	if (hl_ride_probe_solid)
		solid = 1;

	//Four prints appended in place: no call carries more arguments than the
	//tree's existing longest StrPrint.
	StrPrint(line,
		"%5d %7.2f og%2d gn%4d pc%1d hs%1d%1d",
		hl_ride_ticks, hl_ent_time, hl_pm_onground,
		hl_ground_native, hl_ride_probe_calls, hit, solid);

	StrPrint(part,
		" f%6.3f n%5.2f%5.2f%5.2f pn%4d",
		hl_ride_probe_frac, hl_ride_probe_nrm[0], hl_ride_probe_nrm[1],
		hl_ride_probe_nrm[2], hl_ride_probe_nat);

	HLStrCopy(line + StrLen(line), part, HLRIDE_WIDTH - StrLen(line));

	StrPrint(part,
		" |pa%1d rd%2d br%1d pv%7.1f%7.1f%7.1f av%7.2f pi%8.1f%8.1f",
		plat, hl_ride_rides, hl_ride_branch,
		hl_platform_velocity[0], hl_platform_velocity[1],
		hl_platform_velocity[2], hl_platform_avel_z,
		hl_platform_pivot[0], hl_platform_pivot[1]);

	HLStrCopy(line + StrLen(line), part, HLRIDE_WIDTH - StrLen(line));

	StrPrint(part,
		" |o%8.1f%8.1f%8.1f v%7.1f%7.1f%7.1f",
		player_org[0], player_org[1], player_org[2],
		hl_pm_vel[0], hl_pm_vel[1], hl_pm_vel[2]);

	HLStrCopy(line + StrLen(line), part, HLRIDE_WIDTH - StrLen(line));

	StrPrint(part,
		" |T%3d%8.1f%8.1f%8.1f y%6.1f a%7.2f",
		train, torg[0], torg[1], torg[2], tyaw, tavel);

	HLStrCopy(line + StrLen(line), part, HLRIDE_WIDTH - StrLen(line));

	HLRideLogPut(line);

	//Bounded staleness rather than a write per tick: the ring holds 14 seconds
	//and a 256 kB write at 72 Hz would dominate the frame.
	if (hl_ride_ticks % HLRIDE_FLUSH == 0)
		HLRideLogFlush;

	hl_ride_probe_calls = 0;
}

//--- changelevel capture ----------------------------------------------------
//
// See the hl_cl_* block near the top of this file for what the record is for.
// Placed here because the overlap test is HLEntBoxOverlap's, which is defined
// just above, and the record is emitted from HLEntTouchPlayer, which is below.

U0 HLClLogFree()
{
	if (hl_cl_buf)
		Free(hl_cl_buf);

	hl_cl_buf   = NULL;
	hl_cl_log   = FALSE;
	hl_cl_lines = 0;
	hl_cl_ticks = 0;
}

U0 HLClLogArm()
{
	HLClLogFree;

	hl_cl_buf = CAlloc(HLCL_LINES * HLCL_WIDTH);

	hl_cl_stage   = 0;
	hl_cl_touches = 0;

	hl_cl_log = ToBool(hl_cl_buf != NULL);
}

U0 HLClLogPut(U8 *s)
{//linear, not a ring: the interesting tick is the first one in the near band,
 //not the last one before the buffer fills
	if (!hl_cl_buf || hl_cl_lines >= HLCL_LINES)
		return;

	HLStrCopy(hl_cl_buf + hl_cl_lines * HLCL_WIDTH, s, HLCL_WIDTH);
	hl_cl_lines++;
}

U0 HLClLogFlush()
{//oldest record first, one write. The whole file is rewritten each time:
 //records are decimated, so this runs at a rate a redraw would not notice
	U8	*out;
	U8	*slot;
	I64	 len;
	I64	 n;
	I64	 i;

	if (!hl_cl_buf || !hl_disk_writes || hl_cl_lines <= 0)
		return;

	//the slack is the legend below, which runs to about 700 bytes
	out = CAlloc(hl_cl_lines * (HLCL_WIDTH + 1) + 2048);

	if (!out)
		return;

	StrPrint(out,
		"cllog. trigger_changelevel touch path, oldest first.\n"
		"  N T       tick index, hl_ent_time\n"
		"  e u s t   entity slot, in_use, solid (1 is TRIGGER), touch_fn\n"
		"  ov        player box overlaps the volume this tick\n"
		"  st        HLChangeLevelTouch's furthest stage: 0 never entered,\n"
		"            1 entity gone, 2 master denied, 3 no map key,\n"
		"            4 already pending, 5 posted\n"
		"  tc        HLChangeLevelTouch dispatches so far\n"
		"  pend      hl_ent_changelevel_pending\n"
		"  p         player origin\n"
		"  b         volume absmin then absmax\n"
		"  T gn      first live tracktrain origin, hl_ground_native\n\n");

	len = StrLen(out);

	for (i = 0; i < hl_cl_lines; i++)
	{
		slot = hl_cl_buf + i * HLCL_WIDTH;
		n    = StrLen(slot);

		MemCopy(out + len, slot, n);
		len += n;

		out[len] = '\n';
		len++;
	}

	out[len] = 0;

	FileWrite("::/Apps/HL1/CLLOG.TXT", out, len);
	Free(out);
}

U0 HLClLogTick(F64 *player_org)
{//one record per changelevel volume, emitted after the touch pass
 //
 //The volume is found by its touch method rather than by in_use, so a
 //retired one still appears. Both box tests are HLEntTouchPlayer's own: the
 //record states what that pass decided, not an approximation of it.
	CHLEntity	*e;
	U8			 line[HLCL_WIDTH];
	U8			 part[HLCL_WIDTH];
	F64			 pmins[3];
	F64			 pmaxs[3];
	F64			 nmins[3];
	F64			 nmaxs[3];
	F64			 torg[3];
	I64			 i;
	I64			 j;
	I64			 ov;
	I64			 pend;
	I64			 use;
	Bool		 band;
	Bool		 beat;
	Bool		 want;

	want = ToBool(HLCvarGet("cllog") != 0.0);

	if (want != hl_cl_log)
	{
		if (want)
			HLClLogArm;
		else
		{
			HLClLogFlush;
			HLClLogFree;
		}
	}

	if (!hl_cl_log || !player_org || !hl_entities)
		return;

	hl_cl_ticks++;

	beat = ToBool(hl_cl_ticks % HLCL_BEAT == 0);

	//the first live tracktrain. A car that parks short of the volume is the
	//other half of the answer, so its origin travels with every record
	HLVecSet(torg, 0.0, 0.0, 0.0);

	for (i = 0; i < hl_num_entities; i++)
	{
		if (hl_entities[i].in_use &&
			hl_entities[i].ent_class == HLC_TRACKTRAIN)
		{
			HLVecCopy(hl_entities[i].origin, torg);
			break;
		}
	}

	for (j = 0; j < 3; j++)
	{
		pmins[j] = player_org[j] + hl_player_mins[j];
		pmaxs[j] = player_org[j] + hl_player_maxs[j];

		nmins[j] = pmins[j] - HLCL_NEAR;
		nmaxs[j] = pmaxs[j] + HLCL_NEAR;
	}

	pend = 0;
	if (hl_ent_changelevel_pending)
		pend = 1;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (e->touch_fn != HLM_CHANGELEVEL_TOUCH)
			goto qcl_next;

		band = HLEntBoxOverlap(e, nmins, nmaxs);

		if (!band && !beat)
			goto qcl_next;

		ov = 0;
		if (HLEntBoxOverlap(e, pmins, pmaxs))
			ov = 1;

		use = 0;
		if (e->in_use)
			use = 1;

		StrPrint(line,
			"%5d %7.2f e%3d u%1d s%1d t%3d ov%1d st%1d tc%3d pend%1d",
			hl_cl_ticks, hl_ent_time, i, use, e->solid, e->touch_fn,
			ov, hl_cl_stage, hl_cl_touches, pend);

		StrPrint(part, " |p%8.1f%8.1f%8.1f |b%8.1f%8.1f%8.1f",
			player_org[0], player_org[1], player_org[2],
			e->absmin[0], e->absmin[1], e->absmin[2]);

		HLStrCopy(line + StrLen(line), part, HLCL_WIDTH - StrLen(line));

		StrPrint(part, "%8.1f%8.1f%8.1f |T%8.1f%8.1f%8.1f gn%4d",
			e->absmax[0], e->absmax[1], e->absmax[2],
			torg[0], torg[1], torg[2], hl_ground_native);

		HLStrCopy(line + StrLen(line), part, HLCL_WIDTH - StrLen(line));

		HLClLogPut(line);

qcl_next:
	}

	//Bounded staleness. Also on the pending edge: the shell tears the world
	//down on the next frame and the tick that posted must already be on disk
	if (pend || hl_cl_ticks % HLCL_BEAT == 0)
		HLClLogFlush;
}

Bool HLEntBoxInBrush(CHLMap *map, I64 self, F64 *borg, F64 *bang, F64 *org,
	F64 *mins, F64 *maxs)
{//is the box at org embedded in self's brush, that brush placed at borg/bang?
 //
 //SV_TestEntityPosition against one brush entity: the trace
 //HLClipToNativeBrushes runs for a move, with a zero length sweep. borg and
 //bang are arguments rather than read off the entity so the same brush can be
 //tested at its pre-step placement.
	CHLEntity	*e = HLEntGet(self);
	CHLTrace	 tr;
	F64			 eofs[3];
	I64			 ehull;
	I64			 j;

	if (!e || e->solid != HLSOLID_BSP)
		return FALSE;

	if (!HLMapValid(map, "HLEntBoxInBrush"))
		return FALSE;

	if (e->brush_model < 1 || e->brush_model >= map->num_models)
		return FALSE;

	ehull = HLHullForSize(mins, maxs);

	HLHullOffset(ehull, mins, eofs);
	for (j = 0; j < 3; j++)
		eofs[j] += borg[j];

	if (hl_brush_rotates[self])
		HLTraceHullRotated(map, e->brush_model, ehull, eofs, bang, org, org,
			&tr);
	else
		HLTraceHull(map, e->brush_model, ehull, eofs, org, org, &tr);

	return tr.start_solid;
}

Bool HLEntPlayerRides(CHLMap *map, I64 self, CHLEntity *e, F64 *borg, F64 *bang,
	F64 *player_org)
{//is the player standing on, or inside, this mover?
 //
 //Asked before the mover is stepped: riders are decided against the pre-step
 //placement borg/bang, as SV_PushMove does.
 //
 //SV_PushMove's first clause is ".groundentity == pusher", tested before any
 //box work: a rider standing on a deck is above the brush, not inside it, and
 //on a car turning under them the box test alone loses them for the tick the
 //feet cross the edge. hl_ground_native is PM_CatagorizePosition's answer from
 //the last move, which is the same generation of the flag SV_PushMove reads.
 //
 //Its second clause is the linked-bounds overlap AND SV_TestEntityPosition.
 //The overlap alone is not the test. For a rotating brush the bounds are the
 //orientation-independent radius (see HLEntSetAbsBox): c0a0b's
 //func_trackautochange is a 24x348x16 rail whose box is a 350-unit cube, which
 //reaches the tram deck 42 units above it and everything else in that volume.
	F64	 pmins[3];
	F64	 pmaxs[3];
	F64	 feet[3];
	I64	 i;
	I64	 branch = 3;	//ride trace: 1 ground clause, 2 box, 3 neither, 4 no player
	Bool got    = FALSE;

	if (!player_org)
	{
		branch = 4;
		goto qepr_done;
	}

	if (self >= 0 && hl_ground_native == self)
	{
		branch = 1;
		got    = TRUE;
		goto qepr_done;
	}

	for (i = 0; i < 3; i++)
	{
		pmins[i] = player_org[i] + hl_player_mins[i];
		pmaxs[i] = player_org[i] + hl_player_maxs[i];
	}

	//4 units of slack under the feet, so standing on a platform counts as riding
	//it. A fast mover steps further than one unit, so this is generous rather
	//than exact
	pmins[2] -= 4.0;

	//broad phase
	if (!HLEntBoxOverlap(e, pmins, pmaxs))
		goto qepr_done;

	//For a box solid the linked bounds are the volume, so the overlap is the
	//whole test. Every mover this port builds is HLSOLID_BSP, including the
	//pushable the SDK makes SOLID_BBOX.
	if (e->solid != HLSOLID_BSP)
	{
		branch = 2;
		got    = TRUE;
		goto qepr_done;
	}

	//SV_TestEntityPosition against the brush at its pre-step placement. Second
	//probe is the same box dropped by the slack above: standing on the deck is
	//clear at the player's own origin and solid four units under it.
	HLVecCopy(player_org, feet);
	feet[2] -= 4.0;

	if (HLEntBoxInBrush(map, self, borg, bang, player_org, hl_player_mins,
		hl_player_maxs) ||
		HLEntBoxInBrush(map, self, borg, bang, feet, hl_player_mins,
		hl_player_maxs))
	{
		branch = 2;
		got    = TRUE;
	}

qepr_done:
	//Recorded for the tracktrain only: the mover pass asks this of every pusher
	//in the table and a later one would overwrite the answer the record wants.
	if (e && e->ent_class == HLC_TRACKTRAIN)
		hl_ride_branch = branch;

	return got;
}

F64 HLEntYawStep(F64 newyaw, F64 oldyaw)
{//signed yaw a pusher turned through this tick, degrees in (-180, 180]
 //
 //Both angles are folded into [0, 360) by the mover pass, so the raw difference
 //wraps at the seam; the fold below is what makes 359 -> 1 a +2 step and not
 //-358
	F64 d;

	d = HLAngleNorm(newyaw - oldyaw);

	if (d > 180.0)
		d -= 360.0;

	return d;
}

U0 HLEntRotateAboutZ(F64 *pivot, F64 dyaw, F64 *p, F64 *out)
{//p rotated dyaw degrees about the vertical through pivot. SV_PushRotate's
 //rider displacement, yaw only: a brush mover's pitch and roll do not move a
 //rider's footprint, and only yaw feeds hl_platform_yaw_carry
 //
 //out may alias p
	F64 a;
	F64 s;
	F64 c;
	F64 dx;
	F64 dy;

	a = dyaw * HLDEG2RAD;
	s = Sin(a);
	c = Cos(a);

	dx = p[0] - pivot[0];
	dy = p[1] - pivot[1];

	out[2] = p[2];
	out[0] = pivot[0] + dx * c - dy * s;
	out[1] = pivot[1] + dx * s + dy * c;
}

//HLEntPushPlayer's answer
#define HLPUSHP_CLEAR		0	//the pusher's new position does not reach them
#define HLPUSHP_MOVED		1	//displaced by the pusher's delta
#define HLPUSHP_STUCK		2	//inside it and nowhere to go

I64 HLEntPushPlayer(CHLMap *map, I64 self, CHLEntity *e, F64 *oldorg,
	F64 *oldang, F64 *player_org)
{//SV_PushMove and SV_PushRotate's displacement half, for the player.
 //
 //The pusher has already stepped, from (oldorg, oldang) to (e->origin,
 //e->angles). Anything its new position occupies is carried by the rigid
 //transform between those two placements and re-tested; only a box that is
 //still solid after that counts as blocking.
 //
 //The transform is the pusher's own: the rider's offset from the pusher origin
 //is rotated by the tick's yaw step and re-planted on the new origin. With no
 //rotation that reduces to player_org + (e->origin - oldorg), which is
 //SV_PushMove's translation.
 //
 //Base velocity cannot stand in for this. The carry runs later in the tick,
 //inside the player's own move, and a box that is already inside a wall
 //resolves outward the wrong way - which is how a moving tram's rear wall swept
 //through the player and left them outside the car, while a stationary one was
 //solid and could not be left at all. On a curve the same wall sweeps through
 //an arc of radius |r|, which for a 288-long car reaches far past the player's
 //hull; translation alone leaves that box unresolved.
 //
 //A rider standing on the deck is above the brush, not inside it, and is not
 //displaced: the carry keeps that motion smooth.
	CHLTrace	tr;
	F64			want[3];
	F64			rel[3];
	F64			pivot[3];
	F64			pmins[3];
	F64			pmaxs[3];
	F64			dyaw;
	I64			j;

	if (!player_org || hl_ent_player < 0 || hl_ent_player_health <= 0.0)
		return HLPUSHP_CLEAR;

	//broad phase over the linked bounds: every moving pusher runs this every
	//tick, and the brush trace below is not free
	for (j = 0; j < 3; j++)
	{
		pmins[j] = player_org[j] + hl_player_mins[j];
		pmaxs[j] = player_org[j] + hl_player_maxs[j];
	}

	if (!HLEntBoxOverlap(e, pmins, pmaxs))
		return HLPUSHP_CLEAR;

	if (!HLEntBoxInBrush(map, self, e->origin, e->angles, player_org,
		hl_player_mins, hl_player_maxs))
		return HLPUSHP_CLEAR;

	//hl_brush_rotates gates the arc, not the angles: an entity whose clip is not
	//registered rotating traces against an axial hull, so its brushwork did not
	//turn under the player however its angles read
	dyaw = 0.0;
	if (hl_brush_rotates[self])
		dyaw = HLEntYawStep(e->angles[1], oldang[1]);

	//rel is the offset from the PRE-step origin, so the rotation is taken about
	//the pusher's own axis rather than about a point that has already moved
	for (j = 0; j < 3; j++)
		rel[j] = player_org[j] - oldorg[j];

	//rel is already relative, so the rotation is about zero and the new origin
	//is added after
	if (!HLIsZeroF(dyaw))
	{
		HLVecSet(pivot, 0.0, 0.0, 0.0);
		HLEntRotateAboutZ(pivot, dyaw, rel, rel);
	}

	for (j = 0; j < 3; j++)
		want[j] = e->origin[j] + rel[j];

	//relative to the pusher this is where they stood before the step, which was
	//clear. Still inside means the geometry deformed under them, or something
	//else put them there
	if (HLEntBoxInBrush(map, self, e->origin, e->angles, want,
		hl_player_mins, hl_player_maxs))
		return HLPUSHP_STUCK;

	//and the destination has to be clear of the world too: a player pressed
	//between the pusher and a wall is crushed, not moved through it
	HLTraceEntity(map, want, want, hl_player_mins, hl_player_maxs, 0, TRUE,
		&tr);

	if (tr.all_solid || tr.start_solid)
		return HLPUSHP_STUCK;

	HLVecCopy(want, player_org);

	return HLPUSHP_MOVED;
}

U0 HLEntCheckBlocked(CHLMap *map, I64 self, F64 *oldorg, F64 *oldang,
	Bool rides, F64 *player_org)
{//SV_PushMove's blocked case: the step this tick put a solid box inside the
 //mover, and the mover's blocked method decides what that costs
 //
 //"inside now and clear before", not "inside now". A mover retracting off
 //something already embedded in it is not blocked, and on the second test's
 //absence a reversed door blocks again every tick and never leaves.
 //
 //One blocker per tick: a second dispatch reverses a door straight back.
	CHLEntity	*e = HLEntGet(self);
	CHLEntity	*o;
	I64			 i;

	if (!e || e->blocked_fn == HLM_NONE)
		return;

	//a rider is carried by base velocity, not crushed - decided against the
	//pre-step position, as HLEntPlayerRides is
	if (player_org && hl_ent_player >= 0 && !rides &&
		hl_ent_player_health > 0.0)
	{
		if (HLEntBoxInBrush(map, self, e->origin, e->angles, player_org,
			hl_player_mins, hl_player_maxs) &&
			!HLEntBoxInBrush(map, self, oldorg, oldang, player_org,
			hl_player_mins, hl_player_maxs))
		{
			HLEntCallMethod(self, e->blocked_fn, -1, HLUSE_TOGGLE, 0.0);
			return;
		}
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		o = HLEntGet(i);

		if (i == self || !o || !o->in_use)
			goto qecb_next;

		//the box solids only: another brush entity is level geometry, and a
		//trigger is not an obstacle
		if (o->solid != HLSOLID_SLIDEBOX && o->solid != HLSOLID_BBOX)
			goto qecb_next;

		//a zero-sized box is a point entity that never had a hull set
		if (o->size[0] <= 0.0 || o->size[1] <= 0.0 || o->size[2] <= 0.0)
			goto qecb_next;

		//broad phase over the linked bounds before either brush trace
		if (!HLEntBoxOverlap(e, o->absmin, o->absmax))
			goto qecb_next;

		if (!HLEntBoxInBrush(map, self, e->origin, e->angles, o->origin,
			o->mins, o->maxs))
			goto qecb_next;

		if (HLEntBoxInBrush(map, self, oldorg, oldang, o->origin, o->mins,
			o->maxs))
			goto qecb_next;

		HLEntCallMethod(self, e->blocked_fn, i, HLUSE_TOGGLE, 0.0);
		return;

qecb_next:
	}
}

U0 HLEntPushableStep(CHLMap *map, I64 self, CHLEntity *e, F64 dt,
	F64 *player_org)
{//SV_Physics_Step for one crate: gravity, a traced move, ground friction.
 //
 //Traced with the crate itself taken out of the world - it is SOLID_BSP and
 //HLClipToNativeBrushes has no pass-entity argument, so it would report itself
 //start-solid every tick. nomonsters keeps the player out of the sweep: the
 //hull is the one the player is leaning on.
	CHLTrace	tr;
	F64			end[3];
	F64			left;
	F64			speed;
	F64			drop;
	F64			scale;
	F64			dot;
	I64			saved;
	I64			bump;
	I64			j;
	Bool		grounded;

	if (dt <= 0.0)
		return;

	//gravity first, so a crate shoved off a ledge falls this tick
	e->velocity[2] -= HLPHYS_GRAVITY * dt;

	if (HLIsZeroF(e->velocity[0]) && HLIsZeroF(e->velocity[1]) &&
		HLIsZeroF(e->velocity[2]))
		return;

	//Riders are decided against the pre-step position, as SV_PushMove does
	if (player_org && hl_ent_player >= 0)
	{
		if (HLEntPlayerRides(map, self, e, e->origin, e->angles, player_org))
		{
			hl_platform_active = TRUE;

			HLVecCopy(e->velocity, hl_platform_velocity);
			HLVecCopy(e->origin, hl_platform_pivot);
		}
	}

	saved    = e->solid;
	e->solid = HLSOLID_NOT;

	grounded = FALSE;
	left     = dt;

	//PM_FlyMove. One trace is not enough: gravity puts a downward component on
	//every step, so a single sweep stops on the floor at a fraction near zero
	//and takes the horizontal slide down with it - the crate would not move.
	for (bump = 0; bump < 4; bump++)
	{
		if (HLIsZeroF(e->velocity[0]) && HLIsZeroF(e->velocity[1]) &&
			HLIsZeroF(e->velocity[2]))
			goto qeps_moved;

		for (j = 0; j < 3; j++)
			end[j] = e->origin[j] + e->velocity[j] * left;

		HLTraceEntity(map, e->origin, end, e->mins, e->maxs, 0, TRUE, &tr);

		//embedded: leave it where it is rather than flinging it out
		if (tr.all_solid || tr.start_solid)
		{
			HLVecSet(e->velocity, 0.0, 0.0, 0.0);
			goto qeps_moved;
		}

		HLVecCopy(tr.end_pos, e->origin);

		left = left - left * tr.fraction;

		if (tr.fraction == 1.0)
			goto qeps_moved;

		//an upward face is a floor, the same 0.7 PM_CatagorizePosition uses
		if (tr.plane_normal[2] > 0.7)
			grounded = TRUE;

		//PM_ClipVelocity with no bounce: slide along the face it hit
		dot = e->velocity[0] * tr.plane_normal[0] +
			  e->velocity[1] * tr.plane_normal[1] +
			  e->velocity[2] * tr.plane_normal[2];

		for (j = 0; j < 3; j++)
			e->velocity[j] -= tr.plane_normal[j] * dot;
	}

qeps_moved:

	e->solid = saved;

	HLEntSetAbsBox(e);

	if (!grounded)
		return;

	//PM_Friction, on the horizontal only
	speed = Sqrt(e->velocity[0] * e->velocity[0] +
				 e->velocity[1] * e->velocity[1]);

	if (speed < HLPUSH_MIN_SPEED)
	{
		e->velocity[0] = 0.0;
		e->velocity[1] = 0.0;
		return;
	}

	drop = speed;
	if (drop < HLPUSH_STOP_SPEED)
		drop = HLPUSH_STOP_SPEED;

	drop = drop * HLPUSH_FRICTION * dt;

	scale = (speed - drop) / speed;
	if (scale < 0.0)
		scale = 0.0;

	e->velocity[0] = e->velocity[0] * scale;
	e->velocity[1] = e->velocity[1] * scale;
}

U0 HLEntFrame(CHLMap *map, F64 dt, F64 *player_org, F64 *player_ang = NULL)
{//one server tick of the entity world
 //
 //player_org is passed in rather than read from a global because the shell
 //owns it and compiles after this file. player_ang is the same for the view
 //angles, which trigger_camera copies under SF_CAMERA_PLAYER_POSITION
	CHLTrace	 sndtr;
	CHLEntity	*e;
	F64			 move[3];
	F64			 oldorg[3];
	F64			 oldang[3];
	F64			 dist[3];
	F64			 zero[3];
	F64			 eye[3];
	F64			 best;
	F64			 len;
	Bool		 rides;
	Bool		 linear;
	Bool		 angular;
	Bool		 found;
	I64			 room;
	I64			 think;
	I64			 pushed;
	I64			 i;
	I64			 j;

	if (!hl_entities || !map)
		return;

	hl_ent_time     += dt;
	hl_ent_frame_dt  = dt;

	//pending effects are per tick: a trigger the player has left must stop
	//pushing, and a stale teleport must not fire twice
	hl_ent_push_pending = FALSE;
	hl_ent_spin_pending = FALSE;

	//Cleared before the mover pass: stepping off a platform produces no event
	//to hang the reset on. Set and consumed within one tick - the movers write
	//it here and the player move reads it later in the same tick.
	hl_platform_active      = FALSE;
	hl_platform_avel_z      = 0.0;
	HLVecSet(hl_platform_velocity, 0.0, 0.0, 0.0);

	//ride trace: -1 is "the mover pass never asked", which a tracktrain that is
	//not moving this tick produces and a bug in the rider test does not
	hl_ride_rides     = -1;
	hl_ride_branch    = 0;

	//stash the origin for anything that runs later in the tick without one - a
	//charger metering out health, an env_shake testing its radius. See
	//hl_ent_player_org
	if (player_org)
		HLVecCopy(player_org, hl_ent_player_org);

	if (player_ang)
		HLVecCopy(player_ang, hl_ent_player_ang);

	//--- looping voices ---
	//
	//A tracktrain's running noise is re-aimed every tick, not per node: the
	//listener moves between nodes and the loop must follow it. A parked train
	//has no think scheduled, which is the signal to stop.
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (e->ent_class == HLC_TRACKTRAIN)
		{
			if (e->in_use && e->think_fn != HLM_NONE)
				HLTrainVoiceStart(i, e);
			else
				HLTrainVoiceStop(i);

			goto qef_next_voice;
		}

		//A fan's noise follows its angular speed, not a think: SpinUp and
		//SpinDown disarm themselves at the top and bottom of the ramp, and a
		//fan at full speed has no think at all.
		if (e->ent_class != HLC_ROTATE || e->use_fn != HLM_ROTATE_USE)
			goto qef_next_voice;

		if (e->in_use)
			HLFanVoiceTick(i, e);
		else
			HLSndFanStop(&hl_fan_voice[i], &hl_fan_pitch[i]);

qef_next_voice:
	}

	//--- movers ---
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->movetype != HLMOVETYPE_PUSH)
			goto qef_next_move;

		linear = !(HLIsZeroF(e->velocity[0]) && HLIsZeroF(e->velocity[1]) &&
			HLIsZeroF(e->velocity[2]));

		angular = !(HLIsZeroF(e->avelocity[0]) && HLIsZeroF(e->avelocity[1]) &&
			HLIsZeroF(e->avelocity[2]));

		if (!linear && !angular)
			goto qef_next_move;

		//the pre-step placement, for HLEntCheckBlocked's "clear before" test
		HLVecCopy(e->origin, oldorg);
		HLVecCopy(e->angles, oldang);

		//angles first and unconditionally: a fan or a swinging door has
		//avelocity and no velocity at all
		if (angular)
		{
			e->angles[0] += e->avelocity[0] * dt;
			e->angles[1] += e->avelocity[1] * dt;
			e->angles[2] += e->avelocity[2] * dt;

			//kept in range so a fan that has been spinning for an hour is not
			//feeding six-figure degrees into Cos/Sin, where the argument
			//reduction eats the precision the angle had left
			for (j = 0; j < 3; j++)
			{
				while (e->angles[j] >= 360.0)
					e->angles[j] -= 360.0;

				while (e->angles[j] < 0.0)
					e->angles[j] += 360.0;
			}
		}

		rides = FALSE;

		//riders are decided against the pre-step position, as SV_PushMove does.
		//
		//A pusher that only turns qualifies a rider by the ground clause alone.
		//HLEntPlayerRides' other clause ends in a brush trace, so a box inside a
		//turning brush is a crush case for HLEntCheckBlocked to price, not a
		//rider to exempt.
		if (player_org && hl_ent_player >= 0 &&
			(linear || hl_ground_native == i))
			rides = HLEntPlayerRides(map, i, e, oldorg, oldang, player_org);

		//ride trace
		if (hl_ride_log && e->ent_class == HLC_TRACKTRAIN)
		{
			hl_ride_rides = 0;

			if (rides)
				hl_ride_rides = 1;
		}

		//An angular-only step rebuilds nothing: a rotating brush's bounds are
		//the orientation-independent radius (see HLEntSetAbsBox), and a
		//non-rotating entity changing angles is a train's bookkeeping.
		if (linear)
		{
			move[0] = e->velocity[0] * dt;
			move[1] = e->velocity[1] * dt;
			move[2] = e->velocity[2] * dt;

			e->origin[0] += move[0];
			e->origin[1] += move[1];
			e->origin[2] += move[2];

			HLEntSetAbsBox(e);

			//a liquid door that travels carries its volume with it. 11 of the
			//174 shipped func_water carry a targetname and can be moved
			if (e->skin != 0 && e->ent_class == HLC_DOOR)
				HLWaterBrushMove(map, e->brush_model, e->origin);
		}

		//SV_PushMove and SV_PushRotate displace what the pusher has swept into
		//before either decides anything is blocking. player_org is the shell's
		//hl_origin and HLEntFrame runs ahead of the player's move, so the write
		//lands this tick.
		//
		//oldorg/oldang are the pre-step placement, which is the rigid transform
		//the rider is carried by. A turn is included, so a tram's rear wall
		//sweeping through an arc resolves here rather than at the blocked
		//method.
		pushed = HLEntPushPlayer(map, i, e, oldorg, oldang, player_org);

		//Inside it and nowhere to go. The rider exemption below is for a box
		//being carried, not a box being crushed, so the block test has to see
		//this one.
		if (pushed == HLPUSHP_STUCK)
			rides = FALSE;

		if (rides)
		{
			//The rider is carried by base velocity, not by writing its origin.
			//pm_shared adds basevelocity before the move and subtracts it
			//after, so the carry is clipped by the world like any other motion
			//and cannot fight the duck's 18-unit origin shift.
			hl_platform_active = TRUE;

			hl_platform_velocity[0] = e->velocity[0];
			hl_platform_velocity[1] = e->velocity[1];
			hl_platform_velocity[2] = e->velocity[2];

			HLVecCopy(e->origin, hl_platform_pivot);

			//SV_PushRotate's angular term, as a rate:
			//HLPMPlatformBaseVelocity evaluates v + w x r at the rider's own
			//position. Every mover in this port turns on avelocity, including
			//the tracktrain, whose yaw rate CFuncTrackTrain::Next writes as
			//vy * 10 (plats.cpp:1219).
			//
			//hl_platform_yaw_carry is derived from this in HLClip.ZC during the
			//player's own move, which runs after this pass in the same tick: the
			//view spin and the body displacement land on the same edge.
			hl_platform_avel_z = e->avelocity[1];
		}

		//A swinging door blocks too, so this is outside the linear branch. The
		//blocked method may reverse this mover and its group; a peer later in
		//the table then steps this tick on its new velocity, one tick ahead of
		//the leaf that reversed it.
		HLEntCheckBlocked(map, i, oldorg, oldang, rides, player_org);

qef_next_move:
	}

	//--- pushables ---------------------------------------------------------
	//
	// SV_Physics_Step's share. Separate from the mover pass above: that one
	// integrates velocity with no world trace, which is correct for a brush on
	// rails and would put a crate through a wall.
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_PUSHABLE)
			goto qef_next_push;

		HLEntPushableStep(map, i, e, dt, player_org);

qef_next_push:
	}

	//After the movers and before the thinks: the think pass recomputes a
	//tracktrain's velocity and avelocity for the next tick
	HLEntRideLogTick(player_org);

	//--- env_sound ---------------------------------------------------------
	//
	// CEnvSound::Think, dlls/sound.cpp:891. The nearest env_sound that is in
	// radius and has line of sight to the player wins; its roomtype goes to the
	// mixer through HLSndRoomtypeSet.
	//
	// The SDK runs this from each env_sound's own think against
	// FIND_CLIENT_IN_PVS and keeps m_pentSndLast per player. One pass over the
	// list per tick reaches the same answer: the nearest visible in-range entity.
	//
	// "we do not actually change the player's room_type until we have a new
	// valid room_type to change it to" (sound.cpp:920) - with no candidate the
	// previous room is held, not reset to dry.
	//
	// FEnvSoundInRange's water-boundary rejection is absent: HLTraceEntity
	// reports no fInOpen/fInWater pair.
	if (player_org)
	{
		best  = 0.0;
		room  = 0;
		found = FALSE;

		HLVecSet(zero, 0.0, 0.0, 0.0);

		//vecSpot2 = origin + view_ofs, sound.cpp:854
		HLVecCopy(player_org, eye);
		eye[2] += HLPHYS_VIEW_Z;

		for (i = 0; i < hl_num_entities; i++)
		{
			e = &hl_entities[i];

			if (!e->in_use || e->radius <= 0.0)
				goto qef_next_room;

			if (StrCompare(e->classname, "env_sound"))
				goto qef_next_room;

			HLVecSub(eye, e->origin, dist);
			len = HLVecLength(dist);

			if (len > e->radius)
				goto qef_next_room;

			//"found" rather than a non-zero roomtype: 0 is a legitimate value
			//("normal room"), so testing the value would let a farther
			//env_sound overwrite a nearer one
			if (found && len >= best)
				goto qef_next_room;

			//UTIL_TraceLine(vecSpot1, vecSpot2, ignore_monsters), sound.cpp:860.
			//Traced last, so the cheap radius and distance rejects run first
			HLTraceEntity(map, e->origin, eye, zero, zero, 0, TRUE, &sndtr);

			if (sndtr.fraction != 1.0)
				goto qef_next_room;

			best  = len;
			room  = e->roomtype;
			found = TRUE;

qef_next_room:
		}

		if (found)
		{
			hl_ent_roomtype = room;
			HLSndRoomtypeSet(room);
		}
	}

	//--- speaker -----------------------------------------------------------
	//
	// CSpeaker::SpeakerThink for every registered speaker. The announcer runs on
	// the entity clock, which a paused game stops.
	HLSndSpeakerUpdate(hl_ent_time);

	//--- thinks ---
	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->think_fn)
			goto qef_next_think;

		if (e->next_think <= 0.0 || e->next_think > hl_ent_time)
			goto qef_next_think;

		hl_ent_thinks++;

		//SV_RunThink clears nextthink BEFORE calling the think, and the order
		//is the whole contract: a method that reschedules wins, because its
		//HLEntSetThink runs after this; a method that reschedules nothing is
		//disarmed, and one that returns early - a bad index, a class that no
		//longer applies - cannot come back every tick forever.
		//
		//Clearing it after the call instead overwrites the new schedule with
		//"never"; leaving it to each method makes every method responsible for
		//disarming itself, and the one that forgets thinks on every tick until
		//the trace budget hides it.
		think = e->think_fn;

		e->think_fn   = HLM_NONE;
		e->next_think = 0.0;

		if (HLEntTraceChanged(i, e, think))
			HLEntTrace("think", i, think);

		HLEntCallMethod(i, think, e->activator, HLUSE_TOGGLE, 0.0);

qef_next_think:
	}

	HLEntDrainCalls();

	//CBasePlayer::PostThink, dlls/player.cpp:1979. One HEV line per call at most,
	//after the thinks that raise them
	HLEntCheckSuitUpdate;

	//CBasePlayer::PlayerDeathThink. Last, so a trigger that killed the player
	//this tick has already run and the death state machine starts on the tick
	//the damage landed rather than the one after
	HLEntPlayerDeathThink;
}

U0 HLEntTouchPlayer(F64 *player_org)
{//test the player against every trigger and touchable mover
	CHLEntity	*e;
	F64			 pmins[3];
	F64			 pmaxs[3];
	F64			 tmins[3];
	F64			 tmaxs[3];
	I64			 i;

	if (!hl_entities || !player_org)
		return;

	//friction belongs to HLClip.ZC and is read inside PM_Friction. Cleared
	//here rather than by func_friction, because stepping OFF a slippery brush
	//produces no event - there is nothing to hang the restore on. Cleared in
	//this pass and not in HLEntFrame: the movers run ahead of the move and the
	//clear would wipe the value HLFrictionTouch set on the previous tick
	//before PM_Friction ever read it.
	hl_surface_friction = 1.0;

	//The belt, on the same terms: stepping off a func_conveyor produces no
	//event, and a stale base velocity would carry the player forever
	HLVecSet(hl_conveyor_velocity, 0.0, 0.0, 0.0);
	hl_conveyor_active = FALSE;

	for (i = 0; i < 3; i++)
	{
		pmins[i] = player_org[i] + hl_player_mins[i];
		pmaxs[i] = player_org[i] + hl_player_maxs[i];

		//A solid brush is never overlapped: the move stops the player a trace
		//epsilon short of it, so an exact AABB test never reports contact.
		//SV_TouchLinks links against a box grown by 1 for the same reason.
		tmins[i] = pmins[i] - 1.0;
		tmaxs[i] = pmaxs[i] + 1.0;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->touch_fn)
			goto qetp_next;

		//a trigger volume is always tested; a solid entity only when its touch
		//should fire on a bump. A conveyor is solid and stood on, so its touch
		//fires too
		if (e->solid != HLSOLID_TRIGGER && e->touch_fn != HLM_DOOR_TOUCH &&
			e->touch_fn != HLM_ROT_DOOR_TOUCH &&
			e->touch_fn != HLM_BUTTON_TOUCH &&
			e->touch_fn != HLM_CONVEYOR_TOUCH &&
			e->touch_fn != HLM_XEN_TREE_TOUCH &&
			e->touch_fn != HLM_PUSH_MOVE_TOUCH)
			goto qetp_next;

		//the grown box for the solid classes only; a trigger volume is entered,
		//not bumped, and widening it would fire it a unit early
		if (e->solid == HLSOLID_TRIGGER)
		{
			if (!HLEntBoxOverlap(e, pmins, pmaxs))
				goto qetp_next;
		}
		else if (!HLEntBoxOverlap(e, tmins, tmaxs))
			goto qetp_next;

		//hl_ent_player is 0, which is also worldspawn's index, while
		//HLAITargetIsPlayer and HLDoorBlocked spell the player -1. A handler
		//that tests this activator for being the player reads worldspawn.
		HLEntQueueCall(i, e->touch_fn, hl_ent_player, HLUSE_TOGGLE, 0.0);

qetp_next:
	}

	HLEntDrainCalls();

	//after the drain: the record wants this tick's HLChangeLevelTouch stage,
	//and the queued call runs inside it
	HLClLogTick(player_org);
}

I64 HLEntUseInFront(F64 *player_org, F64 *forward, Bool held = FALSE)
{//the +use key: fire the nearest usable entity the player is looking at.
 //HL traces 64 units; the box test here is coarser but needs no trace
 //
 //held is CBasePlayer::PlayerUse's every-frame pass, player.cpp:1669: the key
 //is still down and only FCAP_CONTINUOUS_USE classes answer. The shell calls
 //this once on the press edge with held clear, then once a tick with it set
 //for as long as the key stays down
	CHLEntity	*e;
	F64			 probe[3];
	F64			 pmins[3];
	F64			 pmaxs[3];
	I64			 use_type;
	I64			 i;
	I64			 fired = 0;
	Bool		 found = FALSE;

	if (!hl_entities || !player_org || !forward)
		return 0;

	use_type = HLUSE_TOGGLE;
	if (held)
		use_type = HLUSE_SET;	//player.cpp:1675

	HLVecMA(player_org, 48.0, forward, probe);

	for (i = 0; i < 3; i++)
	{
		pmins[i] = probe[i] - 16.0;
		pmaxs[i] = probe[i] + 16.0;
	}

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || !e->use_fn)
			goto qeuf_next;

		//only classes the player operates by hand. A wall charger is reachable
		//no other way - nothing in a map targets one
		//FCAP_IMPULSE_USE. CBasePlatTrain grants it to func_plat, func_train
		//and func_door; CFuncTrackTrain does not - it carries
		//FCAP_DIRECTIONAL_USE, meaning the controls drive it, not a player
		//walking up to the car. Without this a tracktrain toggles on every
		//+use press, so the scripted tram can be started and stopped by hand.
		if (e->ent_class == HLC_TRACKTRAIN)
			goto qeuf_next;

		if (e->use_fn != HLM_DOOR_USE && e->use_fn != HLM_BUTTON_USE &&
			e->use_fn != HLM_TRAIN_USE && e->use_fn != HLM_ROT_DOOR_USE &&
			e->use_fn != HLM_CHARGER_USE && e->use_fn != HLM_MOMENTARY_USE &&
			e->use_fn != HLM_PUSH_MOVE_USE)
			goto qeuf_next;

		//a held key reaches only the continuous classes; a door would toggle
		//on every tick
		if (held && !HLEntCapsContinuousUse(e))
			goto qeuf_next;

		if (!HLEntBoxOverlap(e, pmins, pmaxs))
			goto qeuf_next;

		//same activator hazard as HLEntTouchPlayer: hl_ent_player is 0, the
		//-1 convention lives in HLAITargetIsPlayer and HLDoorBlocked
		//
		//The search stops at one entity, so a door is the one use path that
		//has to fan out over its group. Everything else reaching a door
		//already reaches every leaf; see the note above HLDoorGroupNext
		if (e->use_fn == HLM_DOOR_USE || e->use_fn == HLM_ROT_DOOR_USE)
			HLEntQueueCall(i, HLM_DOOR_GROUP, hl_ent_player, use_type, 0.0);
		else
			HLEntQueueCall(i, e->use_fn, hl_ent_player, use_type, 0.0);

		fired++;
		break;

qeuf_next:
	}

	HLEntDrainCalls();

	//CBasePlayer::PlayerUse, dlls/player.cpp:1666 and :1682. wpn_select when the
	//search found an object, wpn_denyselect when it found none. On the press edge
	//only: the held pass would otherwise click once a tick on a charger.
	//
	//The SDK's search is one pass over everything with FCAP_*_USE, and
	//CTalkMonster carries FCAP_IMPULSE_USE, so a scientist counts as an object
	//and answers with wpn_select. The use pass above sees no monster - they have
	//no use_fn - so the friend classes are probed here for the sound alone.
	//m_szFriends, talkmonster.cpp:53-58
	if (!held)
	{
		found = ToBool(fired > 0);

		if (!found)
		{
			for (i = 0; i < hl_num_entities; i++)
			{
				e = &hl_entities[i];

				if (!e->in_use || e->health <= 0.0)
					goto qeuf_next_friend;

				if (StrCompare(e->classname, "monster_barney") &&
					StrCompare(e->classname, "monster_scientist") &&
					StrCompare(e->classname, "monster_sitting_scientist"))
					goto qeuf_next_friend;

				if (!HLEntBoxOverlap(e, pmins, pmaxs))
					goto qeuf_next_friend;

				found = TRUE;
				break;

qeuf_next_friend:
			}
		}

		HLSndPlayerUse(found, player_org, hl_ent_player + 1);
	}

	return fired;
}

U0 HLEntDump(U8 *filter = NULL)
{//list the entity table, optionally filtered by a classname prefix: which
 //movers exist, what names them, and what they name in turn
	CHLEntity	*e;
	I64			 i;
	I64			 shown = 0;

	"$$LTBLUE$$%-22s %-18s %-18s %5s %5s$$FG$$\n",
		"classname", "targetname", "target", "flags", "state";

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use)
			goto qed_next;

		if (filter && StrNICompare(e->classname, filter, StrLen(filter)))
			goto qed_next;

		"%-22s %-18s %-18s %5d %5d\n",
			e->classname, e->targetname, e->target,
			e->spawnflags, e->toggle_state;

		shown++;

qed_next:
	}

	"%d shown of %d\n", shown, hl_num_entities;
}

U0 HLEntDrawBeams(CHLCanvas *c)
{//env_beam and env_laser. Endpoints resolve exactly as HLBeamDamageThink does:
 //a named entity's origin, or this entity's own where the name did not resolve
 //
 //Additive and depth tested, writing no depth, so this runs after the world and
 //entity passes. hl_r_beams is checked inside HLDrawBeam.
	CHLEntity	*e;
	CHLSpr		*sp;
	CHLSprFrame	*fr;
	F64			 start[3];
	F64			 end[3];
	I64			 lit;
	I64			 frame;
	I64			 i;

	if (!c || !hl_entities)
		return;

	for (i = 0; i < hl_num_entities; i++)
	{
		e = &hl_entities[i];

		if (!e->in_use || e->ent_class != HLC_BEAM || !e->beam_active)
			goto qedb_next;

		//the sprite is resolved in HLEntSpawnBeam; the frame path never loads
		sp = e->spr;

		if (!sp || sp->num_frames < 1 || !sp->palette)
			goto qedb_next;

		if (e->beam_start >= 0 && e->beam_start < hl_num_entities)
			HLVecCopy(hl_entities[e->beam_start].origin, start);
		else
			HLVecCopy(e->origin, start);

		if (e->beam_end >= 0 && e->beam_end < hl_num_entities)
			HLVecCopy(hl_entities[e->beam_end].origin, end);
		else
			HLVecCopy(e->origin, end);

		//CBeam takes its colour from pev->rendercolor and its brightness from
		//pev->renderamt, effects.h:126-133. Every one of the 803 env_beam and
		//env_laser entities in the shipped maps carries both keys, so there is
		//no default to invent; a zero brightness is a beam the mapper turned
		//down and it stays dark
		lit = ToI64(e->renderamt);

		if (lit < 0)
			lit = 0;
		else if (lit > 255)
			lit = 255;

		//"framestart", the starting texture frame. The beam holds it: CBeam
		//animates pev->frame only through the client, which this port has no
		//counterpart for. Clamped, since the key names a frame in the sprite
		//the mapper picked and nothing verifies the two agree
		frame = e->beam_frame;

		if (frame < 0)
			frame = 0;
		else if (frame >= sp->num_frames)
			frame = sp->num_frames - 1;

		fr = &sp->frames[frame];

		//BoltWidth and TextureScroll are stored in 0.1s, NoiseAmplitude in
		//0.01s - const.h:130-135. tS is the render clock: scroll and noise are
		//visual, not simulation
		HLDrawBeam(c, start, end, fr->pixels, sp->palette,
			fr->width, fr->height,
			e->beam_width * 0.1, e->beam_noise * 0.01, e->beam_scroll * 0.1,
			tS,
			ToI64(e->rendercolor[0]), ToI64(e->rendercolor[1]),
			ToI64(e->rendercolor[2]), lit);

qedb_next:
	}
}

U0 HLEntReport()
{//load time sanity dump
	I64 i;
	I64 movers   = 0;
	I64 triggers = 0;
	I64 unknown  = 0;
	I64 rotating = 0;
	I64 sprites  = 0;
	I64 items    = 0;

	for (i = 0; i < hl_num_entities; i++)
	{
		if (!hl_entities[i].in_use)
			goto qer_next;

		if (hl_entities[i].rotates)
			rotating++;

		if (hl_entities[i].spr)
			sprites++;

		if (hl_entities[i].ent_class == HLC_ITEM)
			items++;

		if (!hl_entities[i].spawned)
			unknown++;
		else if (hl_entities[i].movetype == HLMOVETYPE_PUSH)
			movers++;
		else if (hl_entities[i].solid == HLSOLID_TRIGGER)
			triggers++;

qer_next:
	}

	//hl_mm_count is filled by HLEntParseMultiManagers, which runs inside
	//HLEntSpawnAll. Reported from the parse pass it is always 0 and reads as a
	//failure that is not there.
	"HLEnt: %d entities, %d movers, %d triggers, %d multi_manager blocks\n",
		hl_num_entities, movers, triggers, hl_mm_count;

	"HLEnt: %d rotating brushes, %d sprites, %d items\n",
		rotating, sprites, items;

	if (hl_maker_count)
		"HLEnt: %d monstermakers, %d children spawned\n",
			hl_maker_count, hl_maker_made;

	if (unknown)
		"HLEnt: %d classnames not recognised (inert)\n", unknown;
}
