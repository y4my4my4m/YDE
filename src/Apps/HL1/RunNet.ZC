// RunNet.ZC - HL1 with networking. Run this instead of Run.ZC to play UDP.
//
// A separate entry point because the binding is compile-time: the compiler is
// single-pass, so UDPSocket must resolve when HLNetUdp.ZC is read. Picking
// Multiplayer from the menu is too late.
//
// The driver probe throws 'NODRIVER' with no supported NIC, and pulls in TCP,
// TLS, crypto and HTTP, so single player skips it.

Cd(__DIR__);;

#ifndef UDP_MAX_PORT
#include "::/Home/Net/Load"
Cd(__DIR__);;
#endif

#include "Run"
