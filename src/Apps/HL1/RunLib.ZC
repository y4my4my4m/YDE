// build everything except the app shell (HL1.ZC).
//
// the compiler is single-pass: a file can reference symbols only from an
// earlier one, so the include order below is load-bearing.

Cd(__DIR__);;

//one marker per include: ZealC compiles straight into memory, so a fault
//mid-build leaves no stack trace and the last marker printed is the unit in
//flight
"HL1 build (library only, no shell):\n";

"  .. HLFmt\n";
#include "HLFmt"
"  .. HLPak\n";
#include "HLPak"
"  .. HLWad3\n";
#include "HLWad3"
"  .. HLPal\n";
#include "HLPal"
"  .. HLMath\n";
#include "HLMath"
"  .. HLNet\n";
#include "HLNet"

//the net stack is not loaded here: the NIC probe throws with no supported card
//and drags in TCP/TLS/HTTP. RunNet.ZC loads it first, then this file.

"  .. HLNetUdp\n";
#include "HLNetUdp"
"  .. HLNetDgrm\n";
#include "HLNetDgrm"
"  .. HLDemo\n";
#include "HLDemo"
"  .. HLBSP\n";
#include "HLBSP"
"  .. HLVis\n";
#include "HLVis"
"  .. HLPhys\n";
#include "HLPhys"
"  .. HLDraw\n";
#include "HLDraw"
"  .. HLMDL\n";
#include "HLMDL"
"  .. HLStudio\n";
#include "HLStudio"
"  .. HLSpr\n";
#include "HLSpr"
"  .. HLHud\n";
#include "HLHud"
"  .. HLPart\n";
#include "HLPart"
//MP3 and Vorbis are in the system image, System/Audio/Lib
"  .. HLSound\n";
#include "HLSound"
"  .. HLWad\n";
#include "HLWad"
"  .. HLEnt\n";
#include "HLEnt"
"  .. HLProgs\n";
#include "HLProgs"
"  .. HLClip\n";
#include "HLClip"
"  .. HLBuiltin\n";
#include "HLBuiltin"
"  .. HLEntity\n";
#include "HLEntity"
"  .. HLAI\n";
#include "HLAI"
"  .. HLWeapon\n";
#include "HLWeapon"
"  .. HLGame\n";
#include "HLGame"
"  .. HLNetSv\n";
#include "HLNetSv"
"  .. HLSave\n";
#include "HLSave"
"  .. HLPlayer\n";
#include "HLPlayer"
"  .. HLSbar\n";
#include "HLSbar"
"  .. HLMenu\n";
#include "HLMenu"
"  .. HLTest\n";
#include "HLTest"

//HLTest is not run here: HL1 DocClears on startup. symbols stay live in this
//task, so run HLTest; from the prompt.
"\nType $$LTBLUE$$HLTest;$$FG$$ to run the data-layer self-check.\n";

"\nLibrary built. Type $$LTBLUE$$HLTest;$$FG$$ to run the data-layer check.\n";
