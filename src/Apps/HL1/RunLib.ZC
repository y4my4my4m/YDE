// RunLib.ZC - build EVERYTHING EXCEPT the app shell (HL1.ZC).
//
// A bisecting aid. If this builds clean and Run.ZC does not, the problem is
// in HL1.ZC; if this dies too, it is cumulative - size, symbol count, or
// something one of the library files does.
//
// Also the quickest way to get to HLTest; without starting the game.
//
// single-pass compiler: a file can only reference symbols from an earlier one,
// so this order is load-bearing
//
//   HLFmt  byte readers            (no deps)
//   HLPak  archive                 -> HLFmt
//   HLWad3 WAD3 texture archives   -> HLFmt, HLPak
//   HLPal  palette/colormap        -> HLPak
//   HLMath vectors, view basis     (no deps)
//   HLBSP  map loader              -> HLFmt, HLPak
//   HLVis  PVS + traversal         -> HLMath, HLBSP
//   HLPhys collision + movement    -> HLMath, HLBSP
//   HLDraw rasterizer              -> HLMath, HLBSP, HLPal, HLVis
//   HLMDL  alias models            -> HLDraw, HLBSP
//   HLStudio studio models (IDST)  -> HLDraw, HLBSP, HLPak
//   HLProgs QuakeC bytecode VM     -> HLFmt, HLPak, HLMath
//   HLBuiltin QuakeC engine calls  -> HLProgs, HLPhys, HLMDL
//   HLEnt  entity parse + models   -> HLMath, HLBSP, HLMDL, HLStudio
//   HLEntity native entity logic   -> HLEnt, HLClip, HLDraw
//   HLNetUdp real transport         -> HLNet (+ ::/Home/Net if loaded)
//   HLNetSv server datagram/client parse -> HLNet, HLNetUdp, HLProgs, HLGame, HLVis
//   HLTest self-checks             -> everything above
//   HL1 app shell               -> everything above

Cd(__DIR__);;

//one marker per include. ZealC is single-pass and compiles straight into
//memory, so a fault mid-build leaves no stack trace naming the file - the
//last marker printed is the unit that was in flight
"HL1 build (library only, no shell):\n";

"  .. HLFmt\n";
#include "HLFmt"
"  .. HLPak\n";
#include "HLPak"
"  .. HLWad3\n";
#include "HLWad3"
"  .. HLPal\n";
#include "HLPal"
"  .. HLMath\n";
#include "HLMath"
"  .. HLNet\n";
#include "HLNet"

// net stack is NOT loaded here - the NIC probe THROWS with no supported card,
// and drags in TCP/TLS/HTTP. RunNet.ZC loads it first, then this file; HLNetUdp
// builds real transport or stubs depending on what's already present.

"  .. HLNetUdp\n";
#include "HLNetUdp"
"  .. HLNetDgrm\n";
#include "HLNetDgrm"
"  .. HLDemo\n";
#include "HLDemo"
"  .. HLBSP\n";
#include "HLBSP"
"  .. HLVis\n";
#include "HLVis"
"  .. HLPhys\n";
#include "HLPhys"
"  .. HLDraw\n";
#include "HLDraw"
"  .. HLMDL\n";
#include "HLMDL"
"  .. HLStudio\n";
#include "HLStudio"
"  .. HLSpr\n";
#include "HLSpr"
"  .. HLHud\n";
#include "HLHud"
"  .. HLPart\n";
#include "HLPart"
"  .. HLSound\n";
#include "HLSound"
"  .. HLWad\n";
#include "HLWad"
"  .. HLEnt\n";
#include "HLEnt"
"  .. HLProgs\n";
#include "HLProgs"
"  .. HLClip\n";
#include "HLClip"
"  .. HLBuiltin\n";
#include "HLBuiltin"
"  .. HLEntity\n";
#include "HLEntity"
"  .. HLGame\n";
#include "HLGame"
"  .. HLNetSv\n";
#include "HLNetSv"
"  .. HLSave\n";
#include "HLSave"
"  .. HLPlayer\n";
#include "HLPlayer"
"  .. HLSbar\n";
#include "HLSbar"
"  .. HLMenu\n";
#include "HLMenu"
"  .. HLTest\n";
#include "HLTest"

//HLTest is not run here - HL1 DocClears on startup and wipes anything
//printed first. symbols stay live in this task, so run HLTest; from the
//prompt after quitting.
"\nType $$LTBLUE$$HLTest;$$FG$$ to run the data-layer self-check.\n";

"\nLibrary built. Type $$LTBLUE$$HLTest;$$FG$$ to run the data-layer check.\n";
