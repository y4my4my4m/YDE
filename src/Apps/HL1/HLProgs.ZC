// HLProgs.ZC - the QuakeC bytecode virtual machine
//
// progs.dat is a 60-byte header and six sections: statements, global defs,
// field defs, functions, string blob, global pool
//
// the pool is 32-bit cells and stays that way. a vector is three consecutive
// cells and QuakeC aliases them (.origin written, .origin_x read), so widening
// to F64 would silently break every vector access - convert only for math
//
// entity fields are one contiguous block at a fixed stride, the bytecode
// addresses them by byte offset from its start

#define HLPR_VERSION		6

//calling convention slots, three cells wide so a vector needs no special case
#define HLPR_OFS_RETURN	1
#define HLPR_OFS_PARM0	4
#define HLPR_PARM_STRIDE	3
#define HLPR_MAX_PARMS	8

#define HLPR_MAX_STACK	64		//call frames
#define HLPR_MAX_LOCALS	2048	//saved local cells across nested calls
#define HLPR_MAX_RUNAWAY	500000	//statements before assuming an infinite loop
#define HLPR_SOFT_RUNAWAY	50000	//statements before complaining, no abort
#define HLPR_STRING_HEAP	65536	//room to append map strings after the blob

//opcodes, in emit order
#define OP_DONE			0
#define OP_MUL_F		1
#define OP_MUL_V		2
#define OP_MUL_FV		3
#define OP_MUL_VF		4
#define OP_DIV_F		5
#define OP_ADD_F		6
#define OP_ADD_V		7
#define OP_SUB_F		8
#define OP_SUB_V		9
#define OP_EQ_F			10
#define OP_EQ_V			11
#define OP_EQ_S			12
#define OP_EQ_E			13
#define OP_EQ_FNC		14
#define OP_NE_F			15
#define OP_NE_V			16
#define OP_NE_S			17
#define OP_NE_E			18
#define OP_NE_FNC		19
#define OP_LE			20
#define OP_GE			21
#define OP_LT			22
#define OP_GT			23
#define OP_LOAD_F		24
#define OP_LOAD_V		25
#define OP_LOAD_S		26
#define OP_LOAD_ENT		27
#define OP_LOAD_FLD		28
#define OP_LOAD_FNC		29
#define OP_ADDRESS		30
#define OP_STORE_F		31
#define OP_STORE_V		32
#define OP_STORE_S		33
#define OP_STORE_ENT	34
#define OP_STORE_FLD	35
#define OP_STORE_FNC	36
#define OP_STOREP_F		37
#define OP_STOREP_V		38
#define OP_STOREP_S		39
#define OP_STOREP_ENT	40
#define OP_STOREP_FLD	41
#define OP_STOREP_FNC	42
#define OP_RETURN		43
#define OP_NOT_F		44
#define OP_NOT_V		45
#define OP_NOT_S		46
#define OP_NOT_ENT		47
#define OP_NOT_FNC		48
#define OP_IF			49
#define OP_IFNOT		50
#define OP_CALL0		51
#define OP_CALL8		59
#define OP_STATE		60
#define OP_GOTO			61
#define OP_AND			62
#define OP_OR			63
#define OP_BITAND		64
#define OP_BITOR		65

class CHLPrStatement
{
	I64	op;
	I64	a;
	I64	b;
	I64	c;
};

class CHLPrDef
{
	I64	type;
	I64	ofs;
	I64	name;		//offset into the string blob
};

class CHLPrFunction
{
	I64	first_statement;	//negative is a builtin, index -n
	I64	parm_start;
	I64	locals;
	I64	name;
	I64	file;
	I64	num_parms;
	U8	parm_size[HLPR_MAX_PARMS];
};

class CHLPrStack
{
	I64	statement;
	I64	function;
};

//--- loaded image ---
U8				*hl_pr_raw			= NULL;
I64				 hl_pr_raw_size		= 0;
CHLPrStatement	*hl_pr_statements	= NULL;
I64				 hl_pr_num_statements = 0;
CHLPrDef			*hl_pr_globaldefs	= NULL;
I64				 hl_pr_num_globaldefs = 0;
CHLPrDef			*hl_pr_fielddefs		= NULL;
I64				 hl_pr_num_fielddefs	= 0;
CHLPrFunction	*hl_pr_functions		= NULL;
I64				 hl_pr_num_functions	= 0;
U8				*hl_pr_strings		= NULL;	//owned, blob plus a runtime heap
I64				 hl_pr_strings_size	= 0;
I64				 hl_pr_string_alloc	= 0;	//next free byte in the heap

#define HLPR_TEMP_STR_LEN	32

I64				 hl_pr_temp_str		= 0;	//reusable scratch for ftos/vtos
U32				*hl_pr_globals		= NULL;	//raw 32-bit cells
I64				 hl_pr_num_globals	= 0;
I64				 hl_pr_entity_fields	= 0;

//--- entities ---
U8	*hl_pr_edicts		= NULL;		//contiguous field storage
I64	 hl_pr_edict_stride	= 0;		//bytes per entity
I64	 hl_pr_max_edicts	= 0;
I64	 hl_pr_num_edicts	= 0;
Bool *hl_pr_edict_free	= NULL;

//--- execution state ---
CHLPrStack	 hl_pr_stack[HLPR_MAX_STACK];
I64			 hl_pr_depth			= 0;
I64			 hl_pr_localstack[HLPR_MAX_LOCALS];
I64			 hl_pr_localdepth	= 0;
I64			 hl_pr_xfunction		= 0;
I64			 hl_pr_xstatement	= 0;
Bool		 hl_pr_trace			= FALSE;
Bool		 hl_pr_error			= FALSE;

//rate limited. these fire from inside the per-frame execution loop, and every
//console line allocates a document entry - an error repeating each tick eats
//the console heap and faults in the print path, far from the real cause
#define HLPR_MAX_REPORTS	8
I64	 hl_pr_errors	= 0;		//total, including suppressed
I64	 hl_pr_reported	= 0;		//how many actually printed
U8	 hl_pr_detail[128];			//scratch for a diagnostic string

U0 HLPrReport2(U8 *msg, U8 *detail)
{//one line, only while under the cap. logged too - console lines scroll away
 //and the window is torn down on exit
	U8 line[192];

	hl_pr_errors++;

	if (hl_pr_reported >= HLPR_MAX_REPORTS)
		return;

	hl_pr_reported++;

	if (detail)
		StrPrint(line, "HLProgs: %s (%s)\n", msg, detail);
	else
		StrPrint(line, "HLProgs: %s\n", msg);

	HLLog(line);

	if (hl_pr_reported == HLPR_MAX_REPORTS)
		HLLog("HLProgs: further errors suppressed\n");
}

//builtins live in a later file. ZealC is single-pass, so no forward reference
U0 (*hl_pr_builtin_call)(I64 num) = NULL;

//pr_argc. variadic builtins (bprint/sprint/dprint/centerprint) must use it -
//the OFS_PARM slots are never cleared, so scanning for a zero prints leftovers
I64 hl_pr_argc = 0;

//hot symbols, resolved by name at load - the global struct layout is a
//compiler detail that differs between QuakeC builds
I64 hl_ofs_self		= -1;
I64 hl_ofs_other		= -1;
I64 hl_ofs_world		= -1;
I64 hl_ofs_time		= -1;
I64 hl_ofs_frametime	= -1;
//intermission screen stats
I64 hl_ofs_total_secrets		= -1;
I64 hl_ofs_total_monsters	= -1;
I64 hl_ofs_found_secrets		= -1;
I64 hl_ofs_killed_monsters	= -1;
I64 hl_ofs_v_forward	= -1;
I64 hl_ofs_v_right	= -1;
I64 hl_ofs_v_up		= -1;
I64 hl_ofs_force_retouch	= -1;
I64 hl_ofs_deathmatch	= -1;
I64 hl_ofs_skill			= -1;
I64 hl_ofs_teamplay		= -1;
I64 hl_ofs_coop			= -1;
I64 hl_ofs_msg_entity	= -1;

I64 hl_fld_frame		= -1;
I64 hl_fld_nextthink	= -1;
I64 hl_fld_think		= -1;
I64 hl_fld_origin	= -1;
I64 hl_fld_angles	= -1;
I64 hl_fld_velocity	= -1;
I64 hl_fld_model		= -1;
I64 hl_fld_modelindex = -1;
I64 hl_fld_classname	= -1;
I64 hl_fld_mins		= -1;
I64 hl_fld_maxs		= -1;
I64 hl_fld_size		= -1;
I64 hl_fld_solid		= -1;
I64 hl_fld_movetype	= -1;
I64 hl_fld_flags		= -1;
I64 hl_fld_health	= -1;
I64 hl_fld_yaw_speed	= -1;
I64 hl_fld_ideal_yaw	= -1;
I64 hl_fld_enemy		= -1;
I64 hl_fld_owner		= -1;
I64 hl_fld_goalentity = -1;
I64 hl_fld_takedamage = -1;
I64 hl_fld_effects	= -1;
I64 hl_fld_skin		= -1;
I64 hl_fld_spawnflags	= -1;
I64 hl_fld_colormap	= -1;
I64 hl_fld_frags		= -1;	//deathmatch scoreboard
I64 hl_fld_ltime		= -1;
I64 hl_fld_touch		= -1;
I64 hl_fld_use		= -1;
I64 hl_fld_blocked	= -1;
I64 hl_fld_chain		= -1;	//findradius list, T_RadiusDamage walks it

//client fields, driven every frame
I64 hl_fld_v_angle		= -1;
I64 hl_fld_fixangle		= -1;
I64 hl_fld_button0		= -1;
I64 hl_fld_button1		= -1;
I64 hl_fld_button2		= -1;
I64 hl_fld_impulse		= -1;
I64 hl_fld_view_ofs		= -1;
