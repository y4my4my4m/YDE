// edict field vocabulary, without the bytecode
//
// game logic is native, in HLEntity.ZC; Half-Life ships no progs.dat, so the
// loader, the interpreter and the builtin dispatcher are gone. nothing
// allocates the edict pool, so every accessor below returns zero. what is left
// is the vocabulary the server side of HLNetSv.ZC speaks: the hl_fld_/hl_ofs_
// offsets, the field accessors, and hl_player_edict.
//
// the pool is 32-bit cells. a vector is three consecutive cells and the field
// offsets alias them (.origin written, .origin_x read), so widening to F64
// would break every vector access; convert only for math.
//
// entity fields are one contiguous block at a fixed stride, addressed by byte
// offset from its start.

U8	*hl_pr_strings		= NULL;
I64	 hl_pr_strings_size	= 0;
U32	*hl_pr_globals		= NULL;	//raw 32-bit cells
I64	 hl_pr_num_globals	= 0;
I64	 hl_pr_entity_fields	= 0;

U8	*hl_pr_edicts		= NULL;
I64	 hl_pr_edict_stride	= 0;
I64	 hl_pr_max_edicts	= 0;
I64	 hl_pr_num_edicts	= 0;


I64 hl_fld_frame		= -1;
I64 hl_fld_origin	= -1;
I64 hl_fld_angles	= -1;
I64 hl_fld_velocity	= -1;
I64 hl_fld_modelindex = -1;
I64 hl_fld_mins		= -1;
I64 hl_fld_maxs		= -1;
I64 hl_fld_solid		= -1;
I64 hl_fld_movetype	= -1;
I64 hl_fld_flags		= -1;
I64 hl_fld_health	= -1;
I64 hl_fld_owner		= -1;
I64 hl_fld_effects	= -1;
I64 hl_fld_skin		= -1;
I64 hl_fld_colormap	= -1;
I64 hl_fld_frags		= -1;

I64 hl_fld_v_angle		= -1;
I64 hl_fld_fixangle		= -1;
I64 hl_fld_button0		= -1;
I64 hl_fld_button2		= -1;
I64 hl_fld_impulse		= -1;
I64 hl_fld_view_ofs		= -1;
I64 hl_fld_items			= -1;
I64 hl_fld_weapon		= -1;
I64 hl_fld_weaponmodel	= -1;
I64 hl_fld_weaponframe	= -1;
I64 hl_fld_currentammo	= -1;
I64 hl_fld_deadflag		= -1;
I64 hl_fld_message		= -1;
I64 hl_fld_team			= -1;
I64 hl_fld_armorvalue	= -1;
I64 hl_fld_waterlevel	= -1;
I64 hl_fld_gravity		= -1;

I64 hl_fld_punchangle	= -1;
I64 hl_fld_dmg_take		= -1;
I64 hl_fld_dmg_save		= -1;
I64 hl_fld_dmg_inflictor	= -1;
I64 hl_fld_sounds	= -1;
I64 hl_fld_ammo_shells	= -1;
I64 hl_fld_ammo_nails	= -1;
I64 hl_fld_ammo_rockets	= -1;
I64 hl_fld_ammo_cells	= -1;

I64  hl_player_edict;
Bool hl_player_active;

U0 HLPlayerStateInit()
{
	hl_player_edict  = 0;
	hl_player_active = FALSE;
}

U8	 hl_change_map[64];
Bool hl_change_pending	= FALSE;

U8	 hl_gamedir_next[32];
Bool hl_gamedir_pending	= FALSE;

I64	 hl_ofs_serverflags	= -1;


F64 HLPrGetF(I64 ofs)
{
	U8 tmp[4];
	U32 v;

	if (ofs < 0 || ofs >= hl_pr_num_globals)
		return 0.0;

	v      = hl_pr_globals[ofs];
	tmp[0] = v & 0xFF;
	tmp[1] = (v >> 8) & 0xFF;
	tmp[2] = (v >> 16) & 0xFF;
	tmp[3] = (v >> 24) & 0xFF;

	return HLRdF32(tmp);
}

U8 *HLPrStr(I64 ofs)
{//string values are byte offsets into the blob
	if (ofs < 0 || ofs >= hl_pr_strings_size)
		return "";

	return hl_pr_strings + ofs;
}


I64 HLPrEdictNum(I64 ent_value)
{
	if (hl_pr_edict_stride <= 0)
		return 0;

	return ent_value / hl_pr_edict_stride;
}

F64 HLPrFieldF(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!hl_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= hl_pr_max_edicts)
		return 0.0;
	if (field_ofs < 0 || field_ofs >= hl_pr_entity_fields)
		return 0.0;

	p = hl_pr_edicts + ent_num * hl_pr_edict_stride + field_ofs * 4;

	return HLRdF32(p);
}

U0 HLPrSetFieldF(I64 ent_num, I64 field_ofs, F64 v)
{
	U8	*p;
	U32	 bits;

	if (!hl_pr_edicts)
		return;
	if (ent_num < 0 || ent_num >= hl_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= hl_pr_entity_fields)
		return;

	p    = hl_pr_edicts + ent_num * hl_pr_edict_stride + field_ofs * 4;
	bits = HLWrF32(v);

	p[0] = bits & 0xFF;
	p[1] = (bits >> 8) & 0xFF;
	p[2] = (bits >> 16) & 0xFF;
	p[3] = (bits >> 24) & 0xFF;
}

I64 HLPrFieldI(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (!hl_pr_edicts)
		return 0;
	if (ent_num < 0 || ent_num >= hl_pr_max_edicts)
		return 0;
	if (field_ofs < 0 || field_ofs >= hl_pr_entity_fields)
		return 0;

	p = hl_pr_edicts + ent_num * hl_pr_edict_stride + field_ofs * 4;

	return HLRdU32(p);
}


U0 HLPrFree()
{
	hl_pr_num_edicts = 0;
}
