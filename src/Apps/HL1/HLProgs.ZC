I64 HLPrSpawnEdict()
{//reuse a freed slot, otherwise extend the list
	I64 i;

	for (i = 1; i < hl_pr_num_edicts; i++)
	{
		if (hl_pr_edict_free[i])
		{
			hl_pr_edict_free[i] = FALSE;
			MemSet(hl_pr_edicts + i * hl_pr_edict_stride, 0, hl_pr_edict_stride);
			return i;
		}
	}

	if (hl_pr_num_edicts >= hl_pr_max_edicts)
	{
		HLPrReport2("out of edicts", NULL);
		return 0;
	}

	i = hl_pr_num_edicts;
	hl_pr_num_edicts++;
	hl_pr_edict_free[i] = FALSE;
	MemSet(hl_pr_edicts + i * hl_pr_edict_stride, 0, hl_pr_edict_stride);

	return i;
}

U0 HLPrFreeEdict(I64 num)
{
	if (num <= 0 || num >= hl_pr_max_edicts)
		return;

	MemSet(hl_pr_edicts + num * hl_pr_edict_stride, 0, hl_pr_edict_stride);
	hl_pr_edict_free[num] = TRUE;
}

U0 HLPrReport()
{
	"  version      %d\n", HLPR_VERSION;
	"  statements   %6d\n", hl_pr_num_statements;
	"  globaldefs   %6d\n", hl_pr_num_globaldefs;
	"  fielddefs    %6d\n", hl_pr_num_fielddefs;
	"  functions    %6d\n", hl_pr_num_functions;
	"  strings      %6d bytes\n", hl_pr_strings_size;
	"  globals      %6d cells\n", hl_pr_num_globals;
	"  entityfields %6d (stride %d bytes)\n", hl_pr_entity_fields,
		hl_pr_edict_stride;
}
