// camera, input and the screen <-> world transforms
//
// Overview.c. the record is also the client-to-host payload, so every field
// written here crosses the wire.
//
// input replaces SDL: keys come from kbd.down_bitmap, buttons and position
// from the mouse globals. Input_Pump's ll / lr last-state pair becomes the two
// file-scope Bools below. the cursor is canvas space, not window space, so
// OEMouseX / OEMouseY undo the scaled window blit. OEOverUpdate polls, so the
// button edge bits advance once per OEOverUpdate call.
//
// Overview_Update's must_randomize_mouse fuzz path is absent; upstream drives
// it from --must-randomize-mouse.
//
// Overview_GetRenderBox returns a Quad upstream and a COERect here. see
// OEOverGetRenderBox.

//Input_Pump ll / lr
Bool oe_over_lb_last = FALSE;
Bool oe_over_rb_last = FALSE;

#define OE_OVER_KEYS	18

U8 oe_over_key_char[OE_OVER_KEYS] = {
	'q', 'w', 'e', 'r', 't', 'a', 's', 'd', 'f', 'g',
	'z', 'x', 'c', 'v', 'b', '1', '2', '3'
};

U32 oe_over_key_mask[OE_OVER_KEYS] = {
	OEEV_KEY_Q, OEEV_KEY_W, OEEV_KEY_E, OEEV_KEY_R, OEEV_KEY_T,
	OEEV_KEY_A, OEEV_KEY_S, OEEV_KEY_D, OEEV_KEY_F, OEEV_KEY_G,
	OEEV_KEY_Z, OEEV_KEY_X, OEEV_KEY_C, OEEV_KEY_V, OEEV_KEY_B,
	OEEV_KEY_1, OEEV_KEY_2, OEEV_KEY_3
};

U0 OEOverMake(COEOverview *o, I64 xres, I64 yres)
{//Overview_Make: the record starts zeroed, so color and spectator are OECLR_BLU
	MemSet(o, 0, sizeof(COEOverview));
	o->xres = xres;
	o->yres = yres;
}

U32 OEOverEdge(Bool cur, Bool last, U32 held, U32 down, U32 up)
{
	U32 e = 0;

	if (cur)
	{
		e |= held;
	}
	if (cur && !last)
	{
		e |= down;
	}
	if (!cur && last)
	{
		e |= up;
	}
	return e;
}

//Input_Pump, UpdateMouse and UpdateKeys collapsed into one poll.
U0 OEOverPollInput(COEOverview *o)
{
	U32	 e  = 0;
	Bool lb = mouse.lb;
	Bool rb = mouse.rb;
	I64	 i;

	o->mouse_cursor.x = OEMouseX;
	o->mouse_cursor.y = OEMouseY;

	e |= OEOverEdge(lb, oe_over_lb_last, OEEV_MOUSE_L, OEEV_MOUSE_LD,
		OEEV_MOUSE_LU);
	e |= OEOverEdge(rb, oe_over_rb_last, OEEV_MOUSE_R, OEEV_MOUSE_RD,
		OEEV_MOUSE_RU);
	oe_over_lb_last = lb;
	oe_over_rb_last = rb;

	for (i = 0; i < OE_OVER_KEYS; i++)
	{
		if (Bt(kbd.down_bitmap, Char2ScanCode(oe_over_key_char[i])))
		{
			e |= oe_over_key_mask[i];
		}
	}
	//SC_SHIFT and SC_ALT are the left-hand keys, matching SDL_SCANCODE_LSHIFT
	//and SDL_SCANCODE_LALT.
	if (Bt(kbd.down_bitmap, SC_SHIFT))
	{
		e |= OEEV_KEY_LSHIFT;
	}
	if (Bt(kbd.down_bitmap, SC_ALT))
	{
		e |= OEEV_KEY_LALT;
	}
	if (Bt(kbd.down_bitmap, SC_TAB))
	{
		e |= OEEV_TAB;
	}

	o->event = e;
}

U0 OEOverUpdatePan(COEOverview *o)
{//UpdatePan
	if (o->event & OEEV_KEY_LALT)
	{
		return;
	}
	if (o->event & OEEV_KEY_W)
	{
		o->pan.y -= OE_SCROLL_SPEED;
	}
	if (o->event & OEEV_KEY_S)
	{
		o->pan.y += OE_SCROLL_SPEED;
	}
	if (o->event & OEEV_KEY_D)
	{
		o->pan.x += OE_SCROLL_SPEED;
	}
	if (o->event & OEEV_KEY_A)
	{
		o->pan.x -= OE_SCROLL_SPEED;
	}
}

U0 OEOverUpdateSelectionBox(COEOverview *o)
{//UpdateSelectionBox
	if (o->event & OEEV_MOUSE_LD)
	{
		OEPtCopy(&o->selection_box.a, &o->mouse_cursor);
	}
	OEPtCopy(&o->selection_box.b, &o->mouse_cursor);
}

U0 OEOverUpdate(COEOverview *o, COEGrid *g, U64 parity, I64 cycles,
	I64 queue_size, COEShare *share, I64 ping)
{//Overview_Update
	no_warn g;

	OEOverPollInput(o);
	OEOverUpdatePan(o);
	OEOverUpdateSelectionBox(o);
	o->parity     = parity;
	o->cycles     = cycles;
	o->queue_size = queue_size;
	MemCopy(&o->share, share, sizeof(COEShare));
	//ping -1 means the sampler has nothing new; the last value stands
	if (ping != -1)
	{
		o->ping = ping;
	}
}

//      +
//     /D\
//    /C H\      +--------+
//   /B G L\     |A B C D |
//  +A F K P+ -> |E F G H |
//   \E J O/     |I J K L |
//    \I N/      |M N O P |
//     \M/       +--------+
//      +
U0 OEOverIsoToCartRaw(COEOverview *o, COEGrid *g, COEPoint *out, COEPoint *iso)
{//Overview_IsoToCart with raw set: cart pixels, before the tile divide
	I64 x  = iso->x - o->xres / 2;
	I64 y  = -iso->y + o->yres / 2;
	I64 xx = x + o->pan.x;
	I64 yy = y - o->pan.y;
	I64 w  = g->tile_iso_width - 1;
	I64 h  = g->tile_iso_height - 1;
	I64 rx = xx * h + yy * w;
	I64 ry = yy * w - xx * h;

	//OEMapMake leaves the tile extents at zero when the terrain frame is
	//unreadable, and w or h of zero divides here.
	if (!w || !h)
	{
		OEPtSet(out, 0, 0);
		return;
	}
	out->x = (2 * rx + w * h * g->size) / (2 * w);
	out->y = (-2 * ry + w * h * g->size) / (4 * h);
}

U0 OEOverIsoToCart(COEOverview *o, COEGrid *g, COEPoint *out, COEPoint *iso)
{//Overview_IsoToCart with raw clear: tile indices
	I64 w = g->tile_iso_width - 1;
	I64 h = g->tile_iso_height - 1;

	OEOverIsoToCartRaw(o, g, out, iso);
	out->x = out->x / h;
	out->y = (2 * out->y) / w;
}

//                     +
//                    /D\
//  +--------+       /C H\
//  |A B C D |      /B G L\
//  |E F G H | --> +A F K P+
//  |I J K L |      \E J O/
//  |M N O P |       \I N/
//  +--------+        \M/
//                     +
U0 OEOverCartToIso(COEOverview *o, COEGrid *g, COEPoint *out, COEPoint *cart)
{//Overview_CartToIso
	I64 w  = g->tile_iso_width - 1;
	I64 h  = g->tile_iso_height - 1;
	I64 xx = (cart->y + cart->x) * (w / 2);
	I64 yy = (cart->y - cart->x) * (h / 2);
	I64 mx = xx + o->xres / 2;
	I64 my = yy + o->yres / 2;

	out->x = mx - (w / 2) * g->size - o->pan.x;
	out->y = my - (h / 2) - o->pan.y;
}

U0 OEOverIsoSnapTo(COEOverview *o, COEGrid *g, COEPoint *out, COEPoint *iso)
{//Overview_IsoSnapTo
	COEPoint cart;

	OEOverIsoToCart(o, g, &cart, iso);
	OEOverCartToIso(o, g, out, &cart);
}

//Overview_GetRenderBox projects the four screen corners into tile space; its
//only consumer, Quad_GetRenderPoints, then scans x over [c.x, b.x) and y over
//[a.y, d.y). the rect carries those bounds. the two-triangle test that trims
//the four diamond corners out of that scan is absent, so the box is a superset
//of upstream's point list.
U0 OEOverGetRenderBox(COEOverview *o, COEGrid *g, COERect *out, I64 border)
{
	COEPoint p;
	COEPoint a;
	COEPoint b;
	COEPoint c;
	COEPoint d;

	OEPtSet(&p, border, border);
	OEOverIsoToCart(o, g, &a, &p);
	OEPtSet(&p, o->xres - border, border);
	OEOverIsoToCart(o, g, &b, &p);
	OEPtSet(&p, border, o->yres - border);
	OEOverIsoToCart(o, g, &c, &p);
	OEPtSet(&p, o->xres - border, o->yres - border);
	OEOverIsoToCart(o, g, &d, &p);

	out->a.x = c.x;
	out->a.y = a.y;
	out->b.x = b.x;
	out->b.y = d.y;
}

I64 OEOverBoxArea(COERect *r)
{//Rect_GetArea
	return OEAbs(r->b.x - r->a.x) * OEAbs(r->b.y - r->a.y);
}

Bool OEOverIsSelectionBoxBigEnough(COEOverview *o)
{//Overview_IsSelectionBoxBigEnough
	return OEOverBoxArea(&o->selection_box) > OE_SELECT_BOX_MIN;
}

Bool OEOverUsedAction(COEOverview *o)
{//Overview_UsedAction
	return (o->event & (OEEV_MOUSE_LU | OEEV_MOUSE_RU)) != 0;
}

Bool OEOverIsSpectator(COEOverview *o)
{//Overview_IsSpectator
	return o->color == o->spectator;
}
