// DRS archive reader
//
// header (64 bytes): copyright[40], version[4], ftype[12], I32 table_count,
// I32 file_offset. table entry (12 bytes): ext[4], I32 file_info_offset,
// I32 num_files. file entry (12 bytes): I32 id, I32 data_offset, I32 size.
//
// the file entries follow the table headers contiguously in table order, so
// the index is one linear walk from offset 64.
//
// extensions are stored reversed: " pls" is slp, "anib" is bina, " vaw" wav.
//
// FileRead has no seek, so each archive stays resident whole: graphics.drs
// 26.6M, interfac.drs 11.8M, terrain.drs 4.6M.

#define OEDRS_HEADER	64
#define OEDRS_TABLE		12
#define OEDRS_FILE		12

#define OEDRS_MAXTABLE	8
#define OEDRS_PATH		64

class COEDrsFile
{
	I64 id;
	I64 off;
	I64 size;
};

class COEDrsTable
{
	U8			 ext[5];
	I64			 num_files;
	COEDrsFile	*file;
};

class COEDrs
{
	U8			 path[OEDRS_PATH];
	U8			*blob;
	I64			 blob_size;
	I64			 table_count;
	I64			 file_offset;
	COEDrsTable	 table[OEDRS_MAXTABLE];
	Bool		 loaded;
};

COEDrs oe_drs_graphics;
COEDrs oe_drs_interfac;
COEDrs oe_drs_terrain;
COEDrs oe_drs_sounds;

Bool OEDrsLoad(COEDrs *drs, U8 *path)
{
	I64 size = 0;
	I64 off;
	I64 i;
	I64 j;
	COEDrsTable *t;

	MemSet(drs, 0, sizeof(COEDrs));
	OEStrCopy(drs->path, path, OEDRS_PATH);

	drs->blob = FileRead(path, &size);
	if (!drs->blob)
	{
		"OpenEmpire: %s missing\n", path;
		return FALSE;
	}
	drs->blob_size = size;

	if (size < OEDRS_HEADER)
	{
		"OpenEmpire: %s truncated\n", path;
		return FALSE;
	}

	drs->table_count = OERdI32(drs->blob + 56);
	drs->file_offset = OERdI32(drs->blob + 60);

	if (drs->table_count < 1 || drs->table_count > OEDRS_MAXTABLE)
	{
		"OpenEmpire: %s has %d tables\n", path, drs->table_count;
		return FALSE;
	}

	off = OEDRS_HEADER;
	for (i = 0; i < drs->table_count; i++)
	{
		t = &drs->table[i];
		t->ext[0] = drs->blob[off + 0];
		t->ext[1] = drs->blob[off + 1];
		t->ext[2] = drs->blob[off + 2];
		t->ext[3] = drs->blob[off + 3];
		t->ext[4] = 0;
		t->num_files = OERdI32(drs->blob + off + 8);
		t->file = CAlloc(sizeof(COEDrsFile) * t->num_files);
		off += OEDRS_TABLE;
	}

	for (i = 0; i < drs->table_count; i++)
	{
		t = &drs->table[i];
		for (j = 0; j < t->num_files; j++)
		{
			t->file[j].id   = OERdI32(drs->blob + off);
			t->file[j].off  = OERdI32(drs->blob + off + 4);
			t->file[j].size = OERdI32(drs->blob + off + 8);
			off += OEDRS_FILE;
		}
	}

	drs->loaded = TRUE;
	return TRUE;
}

U0 OEDrsFree(COEDrs *drs)
{
	I64 i;

	for (i = 0; i < drs->table_count; i++)
	{
		if (drs->table[i].file)
			Free(drs->table[i].file);
		drs->table[i].file = NULL;
	}
	if (drs->blob)
		Free(drs->blob);
	drs->blob = NULL;
	drs->loaded = FALSE;
}

COEDrsFile *OEDrsEntry(COEDrs *drs, I64 table, I64 index)
{
	if (!drs->loaded || table < 0 || table >= drs->table_count)
		return NULL;
	if (index < 0 || index >= drs->table[table].num_files)
		return NULL;
	return &drs->table[table].file[index];
}

U8 *OEDrsData(COEDrs *drs, I64 table, I64 index, I64 *_size)
{
	COEDrsFile *f = OEDrsEntry(drs, table, index);

	if (_size)
		*_size = 0;
	if (!f)
		return NULL;
	if (f->off < 0 || f->off + f->size > drs->blob_size)
		return NULL;
	if (_size)
		*_size = f->size;
	return drs->blob + f->off;
}

I64 OEDrsNumFiles(COEDrs *drs, I64 table)
{
	if (!drs->loaded || table < 0 || table >= drs->table_count)
		return 0;
	return drs->table[table].num_files;
}

Bool OEDrsIsSlp(COEDrs *drs, I64 table)
{
	if (!drs->loaded || table < 0 || table >= drs->table_count)
		return FALSE;
	return StrCompare(drs->table[table].ext, " pls") == 0;
}

Bool OEDrsIsBin(COEDrs *drs, I64 table)
{
	if (!drs->loaded || table < 0 || table >= drs->table_count)
		return FALSE;
	return StrCompare(drs->table[table].ext, "anib") == 0;
}

//linear scan. the id lists are unsorted and only queried at load.
Bool OEDrsFind(COEDrs *drs, I64 id, I64 *_table, I64 *_index)
{
	I64 i;
	I64 j;

	for (i = 0; i < drs->table_count; i++)
	{
		for (j = 0; j < drs->table[i].num_files; j++)
		{
			if (drs->table[i].file[j].id == id)
			{
				*_table = i;
				*_index = j;
				return TRUE;
			}
		}
	}
	return FALSE;
}

Bool OEDrsMount(U8 *dir)
{
	U8 *path = MStrPrint("%s/graphics.drs", dir);
	Bool ok = TRUE;

	if (!OEDrsLoad(&oe_drs_graphics, path))
		ok = FALSE;
	Free(path);

	path = MStrPrint("%s/interfac.drs", dir);
	if (!OEDrsLoad(&oe_drs_interfac, path))
		ok = FALSE;
	Free(path);

	path = MStrPrint("%s/terrain.drs", dir);
	if (!OEDrsLoad(&oe_drs_terrain, path))
		ok = FALSE;
	Free(path);

	//openempire never opens sounds.drs. a missing one is not fatal here
	//either: the port falls silent rather than refusing to start.
	path = MStrPrint("%s/sounds.drs", dir);
	OEDrsLoad(&oe_drs_sounds, path);
	Free(path);

	return ok;
}

U0 OEDrsUnmount()
{
	OEDrsFree(&oe_drs_graphics);
	OEDrsFree(&oe_drs_interfac);
	OEDrsFree(&oe_drs_terrain);
	OEDrsFree(&oe_drs_sounds);
}
