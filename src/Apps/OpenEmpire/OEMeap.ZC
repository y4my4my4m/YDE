// growable point array and the A* min-heap
//
// Points.c and Meap.c. upstream returns these containers by value and
// reassigns at the call site; here each helper mutates through a pointer.

class COEPoints
{
	COEPoint	*point;
	I64			 count;
	I64			 max;
};

U0 OEPointsMake(COEPoints *p, I64 max)
{
	if (max < 1)
		max = 1;
	p->point = CAlloc(sizeof(COEPoint) * max);
	p->count = 0;
	p->max   = max;
}

U0 OEPointsFree(COEPoints *p)
{
	if (p->point)
		Free(p->point);
	p->point = NULL;
	p->count = 0;
	p->max   = 0;
}

U0 OEPointsAppend(COEPoints *p, COEPoint *pt)
{
	if (!p->point)
		OEPointsMake(p, 32);
	if (p->count == p->max)
	{
		p->max *= 2;
		p->point = ReAlloc(p->point, sizeof(COEPoint) * p->max);
	}
	p->point[p->count].x = pt->x;
	p->point[p->count].y = pt->y;
	p->count++;
}

U0 OEPointsCat(COEPoints *a, COEPoints *b)
{
	I64 i;

	for (i = 0; i < b->count; i++)
		OEPointsAppend(a, &b->point[i]);
}

//Points_Reverse builds a new array by draining the source from the back.
//in place is equivalent and drops the second allocation.
U0 OEPointsReverse(COEPoints *p)
{
	I64 i = 0;
	I64 j = p->count - 1;
	I64 tx;
	I64 ty;

	while (i < j)
	{
		tx = p->point[i].x;
		ty = p->point[i].y;
		p->point[i].x = p->point[j].x;
		p->point[i].y = p->point[j].y;
		p->point[j].x = tx;
		p->point[j].y = ty;
		i++;
		j--;
	}
}

U0 OEPointsStraight(COEPoints *p, COEPoint *a, COEPoint *b)
{
	OEPointsMake(p, 2);
	OEPointsAppend(p, a);
	OEPointsAppend(p, b);
}

// ------------------------------------------------------------------- meap

class COEStep
{
	COEPoint point;
	I64		 prio;
};

class COEMeap
{
	COEStep	*step;
	I64		 size;
	I64		 max;
};

U0 OEMeapMake(COEMeap *m)
{
	m->max  = 32;
	m->size = 0;
	m->step = CAlloc(sizeof(COEStep) * m->max);
}

U0 OEMeapFree(COEMeap *m)
{
	if (m->step)
		Free(m->step);
	m->step = NULL;
	m->size = 0;
	m->max  = 0;
}

//Heapify, recursion unrolled into the sift-down loop it always was
U0 OEMeapHeapify(COEMeap *m, I64 index)
{
	I64		l;
	I64		r;
	I64		small;
	COEStep	tmp;

	while (TRUE)
	{
		l     = 2 * index + 1;
		r     = 2 * index + 2;
		small = index;

		if (l < m->size && m->step[l].prio < m->step[small].prio)
			small = l;
		if (r < m->size && m->step[r].prio < m->step[small].prio)
			small = r;
		if (small == index)
			break;

		MemCopy(&tmp, &m->step[index], sizeof(COEStep));
		MemCopy(&m->step[index], &m->step[small], sizeof(COEStep));
		MemCopy(&m->step[small], &tmp, sizeof(COEStep));
		index = small;
	}
}

U0 OEMeapInsert(COEMeap *m, I64 prio, COEPoint *point)
{
	I64 index;
	I64 p;

	if (m->size == m->max)
	{
		m->max *= 2;
		m->step = ReAlloc(m->step, sizeof(COEStep) * m->max);
	}

	index = m->size;
	m->size++;
	while (index > 0)
	{
		p = (index - 1) / 2;
		if (prio > m->step[p].prio)
			break;
		MemCopy(&m->step[index], &m->step[p], sizeof(COEStep));
		index = p;
	}
	m->step[index].point.x = point->x;
	m->step[index].point.y = point->y;
	m->step[index].prio    = prio;
}

Bool OEMeapDelete(COEMeap *m, COEStep *out)
{
	if (!m->size)
		return FALSE;

	MemCopy(out, &m->step[0], sizeof(COEStep));
	m->size--;
	MemCopy(&m->step[0], &m->step[m->size], sizeof(COEStep));
	OEMeapHeapify(m, 0);
	return TRUE;
}
