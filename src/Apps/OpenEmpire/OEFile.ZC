// ------------------------------------------------------------ graphics rows

class COEGfxDef
{
	I64		 drs;			//file index within graphics.drs table 0
	I64		 prio;
	I64		 shift_x;		//render offset in tiles, added by Tile_GetGraphics
	I64		 shift_y;
	I64		 dim_x;			//footprint in tiles
	I64		 dim_y;
	I64		 type;
	I64		 max_speed;
	I64		 max_health;
	I64		 attack;
	I64		 width;			//collision width, melee reach
	I64		 action;
	I64		 upgrade;		//graphics id this morphs to on age up
	I64		 creator;		//type that trains or builds this
	Bool	 is_single_frame;
	Bool	 is_walkable;
	Bool	 is_multi_state;
	Bool	 is_inanimate;
	Bool	 is_resource;
	Bool	 can_expire;
	Bool	 is_detail;
};

