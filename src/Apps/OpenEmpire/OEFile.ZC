	{ 2, OE_PRIO_TERRAIN, FALSE},	//OETR_WATER_SHALLOW
	{ 3, OE_PRIO_TERRAIN,  TRUE},	//OETR_FARM_READY
	{ 4, OE_PRIO_TERRAIN,  TRUE},	//OETR_FARM_EXAUSTED
	{ 5, OE_PRIO_TERRAIN,  TRUE},	//OETR_GRASS_B
	{ 6, OE_PRIO_TERRAIN,  TRUE},	//OETR_GRASS_C
	{ 7, OE_PRIO_TERRAIN,  TRUE},	//OETR_GRASS_D
	{ 8, OE_PRIO_TERRAIN,  TRUE},	//OETR_GRASS_E
	{ 9, OE_PRIO_TERRAIN,  TRUE},	//OETR_DESERT
	{10, OE_PRIO_TERRAIN,  TRUE},	//OETR_GRASS_LEAVES
	{11, OE_PRIO_TERRAIN,  TRUE},	//OETR_WATER_GRASS
	{12, OE_PRIO_TERRAIN, FALSE},	//OETR_WATER_DEEP
	{13, OE_PRIO_TERRAIN, FALSE},	//OETR_WATER_NORMAL
	{14, OE_PRIO_TERRAIN,  TRUE},	//OETR_BEACH_SAND
	{15, OE_PRIO_TERRAIN,  TRUE},	//OETR_ROAD
	{16, OE_PRIO_TERRAIN,  TRUE},	//OETR_ROAD_WORN
	{17, OE_PRIO_TERRAIN,  TRUE},	//OETR_FARM_SOWN
	{18, OE_PRIO_TERRAIN,  TRUE},	//OETR_FARM_SPROUT
	{19, OE_PRIO_TERRAIN,  TRUE},	//OETR_FARM_GROWING
	{20, OE_PRIO_TERRAIN,  TRUE},	//OETR_ICE
};

// ------------------------------------------------------------ interfac rows

//file index within interfac.drs table 1. the rest of FILE_X_INTERFAC is
//constant across the table, prio at OE_PRIO_HIGHEST. row 0 is OEIF_NONE.
I64 oe_iface_drs[OEIF_COUNT + 1] = {
	-1,	//OEIF_NONE
	31,	//OEIF_BUILDING_ICONS
	32,	//OEIF_COMMAND_ICONS
	34,	//OEIF_TECH_ICONS
	35,	//OEIF_UNIT_ICONS
	65,	//OEIF_HUD_0
};

// ----------------------------------------------------------------- accessors

Bool OEGfxValid(I64 file)
{
	return file >= OEG_NONE && file < OEG_COUNT;
}

//Graphics_GetHeight
I64 OEGfxHeight(I64 file)
{
	if (!OEGfxValid(file))
	{
		return OE_PRIO_NONE;
	}
	return oe_gfx[file + 1].prio;
}

I64 OEGfxDrsId(I64 file)
{
	if (!OEGfxValid(file))
	{
		return -1;
	}
	return oe_gfx[file + 1].drs;
}

//Graphics_GetShift
U0 OEGfxShift(COEPoint *o, I64 file)
{
	if (!OEGfxValid(file))
	{
		OEPtSet(o, 0, 0);
		return;
	}
	OEPtSet(o, oe_gfx[file + 1].shift_x, oe_gfx[file + 1].shift_y);
}

//Graphics_GetGraphicsState
I64 OEGfxState(I64 file, I64 state)
{
	if (!OEGfxValid(file) || state < 0 || state >= OEST_COUNT)
	{
		return OEG_NONE;
	}
	return oe_gfx_state[(file + 1) * OEST_COUNT + state];
}

//Graphics_GetWalkable
Bool OEGfxIsWalkable(I64 file)
{
	if (!OEGfxValid(file))
	{
		return FALSE;
	}
	return oe_gfx[file + 1].is_walkable;
}

//Trait_Build
U0 OETraitBuild(COETrait *t, I64 file)
{
	COEGfxDef *d;

	if (!OEGfxValid(file))
	{
		OEPtSet(&t->dimensions, 0, 0);
		t->type            = OET_NONE;
		t->max_speed       = 0;
		t->max_health      = 0;
		t->attack          = 0;
		t->width           = 0;
		t->action          = OEACT_NONE;
		t->upgrade         = OEG_NONE;
		t->creator         = OET_NONE;
		t->is_single_frame = FALSE;
		t->is_walkable     = FALSE;
		t->is_multi_state  = FALSE;
		t->is_inanimate    = FALSE;
		t->is_resource     = FALSE;
		t->can_expire      = FALSE;
		t->is_detail       = FALSE;
		return;
	}
	d = &oe_gfx[file + 1];
	OEPtSet(&t->dimensions, d->dim_x, d->dim_y);
	t->type            = d->type;
	t->max_speed       = d->max_speed;
	t->max_health      = d->max_health;
	t->attack          = d->attack;
	t->width           = d->width;
	t->action          = d->action;
	t->upgrade         = d->upgrade;
	t->creator         = d->creator;
	t->is_single_frame = d->is_single_frame;
	t->is_walkable     = d->is_walkable;
	t->is_multi_state  = d->is_multi_state;
	t->is_inanimate    = d->is_inanimate;
	t->is_resource     = d->is_resource;
	t->can_expire      = d->can_expire;
	t->is_detail       = d->is_detail;
}

Bool OETerrValid(I64 terrain)
{
	return terrain >= OETR_NONE && terrain < OETR_COUNT;
}

//Terrain_GetHeight
I64 OETerrHeight(I64 terrain)
{
	if (!OETerrValid(terrain))
	{
		return OE_PRIO_NONE;
	}
	return oe_terr[terrain + 1].prio;
}

//Terrain_IsWalkable
Bool OETerrIsWalkable(I64 terrain)
{
	if (!OETerrValid(terrain))
	{
		return FALSE;
	}
	return oe_terr[terrain + 1].is_walkable;
}

I64 OETerrDrsId(I64 terrain)
{
	if (!OETerrValid(terrain))
	{
		return -1;
	}
	return oe_terr[terrain + 1].drs;
}

I64 OEIfaceDrsId(I64 iface)
{
	if (iface < OEIF_NONE || iface >= OEIF_COUNT)
	{
		return -1;
	}
	return oe_iface_drs[iface + 1];
}
