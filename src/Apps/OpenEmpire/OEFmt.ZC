// little-endian readers and shared scalar helpers
//
// ZealC postfix casts are no-ops; never overlay a class on raw file bytes.
//
// every quantity the simulation touches stays inside I32 range: openempire
// runs the sim on int32_t and a widened total would diverge from a peer that
// wrapped.

#define OE_I32_MIN	(-2147483648)
#define OE_I32_MAX	2147483647

U16 OERdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

U32 OERdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 OERdI32(U8 *p)
{
	I64 v = OERdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;

	return v;
}

I64 OEWrap32(I64 v)
{//two's complement truncation to I32, matching int32_t overflow on the peers
	v &= 0xFFFFFFFF;
	if (v & 0x80000000)
		v -= 0x100000000;
	return v;
}

U0 OEStrCopy(U8 *dst, U8 *src, I64 max)
{
	I64 i = 0;

	while (src[i] && i < max - 1)
	{
		dst[i] = src[i];
		i++;
	}
	dst[i] = 0;
}

I64 OEMin(I64 a, I64 b)
{
	if (a < b)
		return a;
	return b;
}

I64 OEMax(I64 a, I64 b)
{
	if (a > b)
		return a;
	return b;
}

I64 OEClamp(I64 v, I64 lo, I64 hi)
{
	if (v < lo)
		return lo;
	if (v > hi)
		return hi;
	return v;
}

I64 OEAbs(I64 v)
{
	if (v < 0)
		return -v;
	return v;
}

I64 OESqrt(I64 v)
{//integer Newton, mirrors Util_Sqrt. F64 Sqrt would diverge between peers.
	I64 x;
	I64 y;

	if (v <= 0)
		return 0;

	x = v;
	y = (x + 1) / 2;
	while (y < x)
	{
		x = y;
		y = (x + v / x) / 2;
	}
	return x;
}

//sim RNG. glibc rand() is not reproducible across peers, so the port carries
//its own: the ANSI C reference LCG, sampled from the high half like rand().
U32 oe_rand_state = 1;

U0 OESrand(U32 seed)
{
	oe_rand_state = seed;
}

I64 OERand()
{
	oe_rand_state = (oe_rand_state * 1103515245 + 12345) & 0x7FFFFFFF;
	return oe_rand_state;
}
