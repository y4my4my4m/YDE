// walkability grid and A*
//
// Field.c. one byte per tile, rebuilt every cycle by OEUnitsField before any
// unit steps, so a path sees the same obstruction set on every peer.
//
// the search is bounded at OEFIELD_MAX_TRIES: an unbounded search on an
// enclosed start eats the heap.

#define OEFIELD_WALKABLE	' '
#define OEFIELD_OBSTRUCT	'#'
#define OEFIELD_MAX_TRIES	100		//CONFIG_FIELD_MAX_PATHING_TRIES

class COEField
{
	U8	*object;
	I64	 size;
	I64	 area;
};

U0 OEFieldMake(COEField *f, I64 size)
{
	f->size   = size;
	f->area   = size * size;
	f->object = CAlloc(f->area);
}

U0 OEFieldFree(COEField *f)
{
	if (f->object)
		Free(f->object);
	f->object = NULL;
}

U0 OEFieldClear(COEField *f)
{
	MemSet(f->object, 0, f->area);
}

Bool OEFieldInBounds(COEField *f, COEPoint *p)
{
	return p->x >= 0 && p->x < f->size && p->y >= 0 && p->y < f->size;
}

I64 OEFieldGet(COEField *f, COEPoint *p)
{
	return f->object[p->x + p->y * f->size];
}

U0 OEFieldSet(COEField *f, COEPoint *p, I64 ch)
{
	if (OEFieldInBounds(f, p))
		f->object[p->x + p->y * f->size] = ch;
}

Bool OEFieldIsWalkable(COEField *f, COEPoint *p)
{
	if (!OEFieldInBounds(f, p))
		return FALSE;
	return OEFieldGet(f, p) == OEFIELD_WALKABLE;
}

I64 OEFieldHeuristic(COEPoint *a, COEPoint *b)
{//manhattan
	return OEAbs(a->x - b->x) + OEAbs(a->y - b->y);
}

//the eight neighbour deltas, in Field_PathAStar's order. a diagonal is only
//taken when both of its orthogonal components are clear, so units never cut
//a building corner.
I64 oe_field_dx[8] = {-1,  0,  1, -1,  1, -1,  0,  1};
I64 oe_field_dy[8] = { 1,  1,  1,  0,  0, -1, -1, -1};

//came_from is one Point per tile; -1,-1 marks unvisited.
U0 OEFieldConstruct(COEField *f, COEPoints *path, COEPoint *start,
	COEPoint *goal, COEPoint *came_from)
{
	COEPoint cur;
	I64		 guard = 0;

	OEPtCopy(&cur, goal);
	while (!OEPtEqual(&cur, start))
	{
		OEPointsAppend(path, &cur);
		OEPtCopy(&cur, &came_from[cur.x + cur.y * f->size]);
		if (cur.x < 0 || cur.y < 0)
			return;
		guard++;
		if (guard > f->area)
			return;
	}
	OEPointsAppend(path, start);
}

//returns an empty path when the goal is unreachable within the try budget.
U0 OEFieldPathAStar(COEField *f, COEPoints *out, COEPoint *start,
	COEPoint *goal)
{
	COEMeap		frontier;
	COEStep		cur;
	COEPoint	next;
	COEPoint	vert;
	COEPoint	horz;
	COEPoint   *came_from;
	I64		   *cost;
	I64			i;
	I64			tries;
	I64			new_cost;
	I64			old_cost;
	I64			prio;
	Bool		hit;

	out->point = NULL;
	out->count = 0;
	out->max   = 0;

	if (!OEFieldInBounds(f, goal))
		return;
	//a unit shut inside a building has no start tile; pathing from there
	//expands the whole map before it gives up.
	if (!OEFieldInBounds(f, start))
		return;

	OEMeapMake(&frontier);
	OEMeapInsert(&frontier, 0, start);

	came_from = CAlloc(sizeof(COEPoint) * f->area);
	cost      = CAlloc(sizeof(I64) * f->area);
	for (i = 0; i < f->area; i++)
	{
		came_from[i].x = -1;
		came_from[i].y = -1;
		cost[i] = -1;
	}
	cost[start->x + start->y * f->size] = 0;

	tries = 0;
	hit   = FALSE;
	while (frontier.size > 0)
	{
		if (!OEMeapDelete(&frontier, &cur))
			break;
		if (OEPtEqual(&cur.point, goal))
		{
			hit = TRUE;
			break;
		}
		if (tries > OEFIELD_MAX_TRIES)
			break;

		new_cost = cost[cur.point.x + cur.point.y * f->size] + 1;

		for (i = 0; i < 8; i++)
		{
			next.x = cur.point.x + oe_field_dx[i];
			next.y = cur.point.y + oe_field_dy[i];
			vert.x = cur.point.x + oe_field_dx[i];
			vert.y = cur.point.y;
			horz.x = cur.point.x;
			horz.y = cur.point.y + oe_field_dy[i];

			if (OEFieldIsWalkable(f, &next) && OEFieldIsWalkable(f, &vert) &&
				OEFieldIsWalkable(f, &horz))
			{
				old_cost = cost[next.x + next.y * f->size];
				if (old_cost == -1 || new_cost < old_cost)
				{
					cost[next.x + next.y * f->size] = new_cost;
					prio = OEFieldHeuristic(goal, &next) + new_cost;
					OEMeapInsert(&frontier, prio, &next);
					came_from[next.x + next.y * f->size].x = cur.point.x;
					came_from[next.x + next.y * f->size].y = cur.point.y;
				}
			}
		}
		tries++;
	}

	//Field_PathAStar runs Construct even when the frontier drains without
	//reaching the goal, and came_from[goal] is then -1,-1, which indexes
	//behind the array. constructing only on a hit is the deviation.
	if (hit)
	{
		OEPointsMake(out, 32);
		OEFieldConstruct(f, out, start, goal, came_from);
		//Construct walks goal to start; the mover wants start to goal
		OEPointsReverse(out);
	}

	OEMeapFree(&frontier);
	Free(came_from);
	Free(cost);
}
