// blendomatic.dat: terrain transition masks
//
// U32 nr_blending_modes, U32 nr_tiles, then per mode U32 tile_size,
// U8 tile_flags[nr_tiles], U8 tile_bit_mask[(nr_tiles + 1) * tile_size / 8],
// U8 tile_byte_mask[nr_tiles * tile_size].
//
// a byte mask is tile_size alpha bytes laid across the rows of the reference
// tile, not a rectangle: each row consumes only the opaque span of the DIRT
// diamond, from that row's left padding. the stored byte is 0..127, scaled to
// 0..255 by ConvertByteMask.
//
// upstream parses this and never applies it. the canvas is indexed, so the
// alpha is quantised to skip / half / solid: the shape of a transition, not
// its gradient.

#define OEBLEND_LO		85		//below this the outer terrain is not drawn
#define OEBLEND_HI		170		//above this it is drawn solid

class COEBlendMode
{
	U8	*flags;			//nr_tiles
	U8	*byte_mask;		//nr_tiles * tile_size
	I64	 tile_size;
};

class COEBlend
{
	COEBlendMode *mode;
	I64			  nr_modes;
	I64			  nr_tiles;
	I64			  w;			//reference tile extent
	I64			  h;
	I64			 *row_x;		//first opaque column per row
	I64			 *row_n;		//opaque run length per row
	I64			 *row_off;		//mask byte index at the start of each row
	Bool		  ok;
};

COEBlend oe_blend_dat;

//the span cache drops the SLP outline table, so the reference row extents are
//recovered from the decoded spans: a terrain diamond row is one solid run.
Bool OEBlendRefRows(COEBlend *b)
{
	COEFrame *f = OERegFrame(OEREG_TERRAIN, 0, OETerrDrsId(OETR_DIRT), 0);
	U8		 *s;
	I64		  row;
	I64		  i;
	I64		  sx;
	I64		  len;
	I64		  kind;
	I64		  lo;
	I64		  hi;

	if (!f)
	{
		return FALSE;
	}
	b->w     = f->w;
	b->h     = f->h;
	b->row_x = CAlloc(sizeof(I64) * f->h);
	b->row_n = CAlloc(sizeof(I64) * f->h);

	for (row = 0; row < f->h; row++)
	{
		b->row_x[row] = 0;
		b->row_n[row] = 0;
		if (f->row[row] >= 0)
		{
			i  = f->row[row];
			s  = f->span;
			lo = -1;
			hi = 0;
			while (TRUE)
			{
				sx = s[i] | (s[i + 1] << 8);
				if (sx == OESLP_ROW_END)
					break;
				len  = s[i + 2] | (s[i + 3] << 8);
				kind = s[i + 4];
				i += 5;
				if (lo < 0)
				{
					lo = sx;
				}
				if (sx + len > hi)
				{
					hi = sx + len;
				}
				if (kind != OESLP_KIND_SHADOW)
				{
					i += len;
				}
			}
			if (lo >= 0)
			{
				b->row_x[row] = lo;
				b->row_n[row] = hi - lo;
			}
		}
	}

	//prefix sum once: the mask index of a pixel is otherwise a walk over
	//every row above it, on every pixel of every blended tile.
	b->row_off = CAlloc(sizeof(I64) * f->h);
	lo = 0;
	for (row = 0; row < f->h; row++)
	{
		b->row_off[row] = lo;
		lo += b->row_n[row];
	}
	return TRUE;
}

Bool OEBlendLoad(U8 *dir)
{
	U8	*path = MStrPrint("%s/blendomatic.dat", dir);
	U8	*blob;
	I64	 size = 0;
	I64	 at;
	I64	 i;
	I64	 bits;
	I64	 bytes;

	MemSet(&oe_blend_dat, 0, sizeof(COEBlend));

	blob = FileRead(path, &size);
	Free(path);
	if (!blob || size < 8)
	{
		return FALSE;
	}

	oe_blend_dat.nr_modes = OERdU32(blob);
	oe_blend_dat.nr_tiles = OERdU32(blob + 4);
	if (oe_blend_dat.nr_modes < 1 || oe_blend_dat.nr_modes > 64 ||
		oe_blend_dat.nr_tiles < 1 || oe_blend_dat.nr_tiles > 256)
	{
		Free(blob);
		return FALSE;
	}

	if (!OEBlendRefRows(&oe_blend_dat))
	{
		Free(blob);
		return FALSE;
	}

	oe_blend_dat.mode = CAlloc(sizeof(COEBlendMode) * oe_blend_dat.nr_modes);
	at = 8;
	for (i = 0; i < oe_blend_dat.nr_modes; i++)
	{
		if (at + 4 > size)
		{
			Free(blob);
			return FALSE;
		}
		oe_blend_dat.mode[i].tile_size = OERdU32(blob + at);
		at += 4;

		oe_blend_dat.mode[i].flags = CAlloc(oe_blend_dat.nr_tiles);
		MemCopy(oe_blend_dat.mode[i].flags, blob + at, oe_blend_dat.nr_tiles);
		at += oe_blend_dat.nr_tiles;

		bits = ((oe_blend_dat.nr_tiles + 1) * oe_blend_dat.mode[i].tile_size) / 8;
		at += bits;

		bytes = oe_blend_dat.nr_tiles * oe_blend_dat.mode[i].tile_size;
		if (at + bytes > size)
		{
			Free(blob);
			return FALSE;
		}
		oe_blend_dat.mode[i].byte_mask = CAlloc(bytes);
		MemCopy(oe_blend_dat.mode[i].byte_mask, blob + at, bytes);
		at += bytes;
	}

	Free(blob);
	oe_blend_dat.ok = TRUE;
	return TRUE;
}

U0 OEBlendFree()
{
	I64 i;

	if (oe_blend_dat.mode)
	{
		for (i = 0; i < oe_blend_dat.nr_modes; i++)
		{
			if (oe_blend_dat.mode[i].flags)
				Free(oe_blend_dat.mode[i].flags);
			if (oe_blend_dat.mode[i].byte_mask)
				Free(oe_blend_dat.mode[i].byte_mask);
		}
		Free(oe_blend_dat.mode);
	}
	if (oe_blend_dat.row_x)
		Free(oe_blend_dat.row_x);
	if (oe_blend_dat.row_n)
		Free(oe_blend_dat.row_n);
	if (oe_blend_dat.row_off)
		Free(oe_blend_dat.row_off);
	MemSet(&oe_blend_dat, 0, sizeof(COEBlend));
}

//alpha at a pixel of one blend tile, 0..255. ConvertByteMask walks the mask
//bytes in row order over the opaque run of each row.
I64 OEBlendAlpha(I64 mode, I64 tile, I64 x, I64 y)
{
	COEBlendMode *m;
	I64			  index;
	I64			  amount;

	if (!oe_blend_dat.ok || mode < 0 || mode >= oe_blend_dat.nr_modes)
	{
		return 0;
	}
	if (tile < 0 || tile >= oe_blend_dat.nr_tiles)
	{
		return 0;
	}
	if (y < 0 || y >= oe_blend_dat.h)
	{
		return 0;
	}

	m     = &oe_blend_dat.mode[mode];
	index = oe_blend_dat.row_off[y];
	if (x < oe_blend_dat.row_x[y] ||
		x >= oe_blend_dat.row_x[y] + oe_blend_dat.row_n[y])
	{
		return 0;
	}
	index += x - oe_blend_dat.row_x[y];
	if (index < 0 || index >= m->tile_size)
	{
		return 0;
	}

	amount = m->byte_mask[tile * m->tile_size + index];
	if (amount > 127)
	{
		amount = 127;
	}
	return (255 * amount) / 127;
}
//blendomatic pass: the outer terrain drawn over the inner one through a
//per-pixel alpha mask. the canvas is indexed, so the alpha is quantised into
//skip / half / solid rather than mixed.
U0 OEBlitFrameMask(COEFrame *f, I64 x, I64 y, I64 z, I64 mode, I64 tile)
{
	I64	 ox = x - f->hx;
	I64	 oy = y - f->hy;
	I64	 row;
	I64	 i;
	I64	 sx;
	I64	 len;
	I64	 kind;
	I64	 px;
	I64	 py;
	I64	 p;
	I64	 j;
	I64	 v;
	I64	 a;
	U8	*s;

	if (!f || !f->span || !oe_screen)
		return;

	for (row = 0; row < f->h; row++)
	{
		py = oy + row;
		if (f->row[row] >= 0 && py >= 0 && py < oe_h)
		{
			i = f->row[row];
			s = f->span;
			while (TRUE)
			{
				sx = s[i] | (s[i + 1] << 8);
				if (sx == OESLP_ROW_END)
					break;
				len  = s[i + 2] | (s[i + 3] << 8);
				kind = s[i + 4];
				i += 5;

				if (kind != OESLP_KIND_SHADOW)
				{
					for (j = 0; j < len; j++)
					{
						px = ox + sx + j;
						a  = OEBlendAlpha(mode, tile, sx + j, row);
						if (px >= 0 && px < oe_w && a >= OEBLEND_LO)
						{
							p = py * OE_W_MAX + px;
							if (z >= oe_zbuf[p])
							{
								v = s[i + j];
								if (a < OEBLEND_HI)
								{
									v = oe_blend[v * OEPAL_COUNT +
										oe_screen[p]];
								}
								oe_screen[p] = v;
								oe_zbuf[p]   = z;
							}
						}
					}
					i += len;
				}
			}
		}
	}
}


