// the map: terrain table, tile lookups and the blend line list
//
// Map.c. the table below is Map.c's `test` array, value for value. Map.c
// writes it with single-letter macros:
//
//	A none			G grass_b		M water_grass	S farm_sown
//	B dirt			H grass_c		N water_deep	T farm_sprout
//	C grass_a		I grass_d		O water_normal	U farm_growing
//	D water_shallow	J grass_e		P beach_sand	V ice
//	E farm_ready	K desert		Q road
//	F farm_exausted	L grass_leaves	R road_worn
//
// 128 rows of 128, row major. only B and C occur: 14400 dirt, 1984 grass_a.
//
// Map.color, PopulateMiniMapColors' per-terrain averaged minimap colour, is
// not carried on COEMap.
//
// Vram_DrawMap draws the terrain tiles unblended, then runs a second pass
// that masks each blend line with a tile mask out of blendomatic.dat. that
// second pass is absent here: blendomatic.dat is not parsed and no mask
// blitter exists, so OEMapBlendLines builds the list and nothing reads it.
// two terrains meet on a hard edge.

#define OE_MAP_AREA	16384	//OE_MAP_SIZE * OE_MAP_SIZE

