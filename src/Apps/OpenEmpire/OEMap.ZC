};

class COEMap
{
	U8		*file;
	I64		 size;
	I64		 tile_width;
	I64		 tile_height;
	COEPoint middle;
};

Bool OEMapInBounds(COEMap *m, COEPoint *p)
{
	return p->x >= 0 && p->x < m->size && p->y >= 0 && p->y < m->size;
}

I64 OEMapGetTerrain(COEMap *m, COEPoint *p)
{//Map_GetTerrainFile
	if (!OEMapInBounds(m, p))
		return OETR_NONE;
	return m->file[p->x + p->y * m->size];
}

U0 OEMapSetTerrain(COEMap *m, COEPoint *p, I64 terrain)
{//Map_SetTerrainFile
	if (!OEMapInBounds(m, p))
		return;
	m->file[p->x + p->y * m->size] = terrain;
}

//Map_Make. the tile extent is the DIRT set's frame 0 in terrain.drs table 0;
//every terrain set in that table carries the same frame size.
Bool OEMapMake(COEMap *m)
{
	COEFrame *f;

	m->size        = OE_MAP_SIZE;
	m->tile_width  = 0;
	m->tile_height = 0;
	m->middle.x    = OE_MAP_SIZE / 2;
	m->middle.y    = OE_MAP_SIZE / 2;
	m->file        = MAlloc(OE_MAP_AREA);
	MemCopy(m->file, oe_map_test, OE_MAP_AREA);

	f = OERegFrame(OEREG_TERRAIN, 0, OETerrDrsId(OETR_DIRT), 0);
	if (!f)
		return FALSE;
	m->tile_width  = f->w;
	m->tile_height = f->h;
	return TRUE;
}

U0 OEMapFree(COEMap *m)
{
	if (m->file)
		Free(m->file);
	m->file = NULL;
}

//Tile_GetTerrain: the frame is picked by tile position, not by time, so a
//terrain set tiles without repeating over a sqrt(frames) period. truncating
//% yields a negative index off the left or top edge; upstream indexes behind
//the frame array there, this wraps.
I64 OEMapTerrainFrame(COEMap *m, COEPoint *p)
{
	COESlp *slp = OERegGet(OEREG_TERRAIN, 0, OETerrDrsId(OEMapGetTerrain(m, p)));
	I64		bound;
	I64		x;
	I64		y;

	if (!slp || !slp->ok)
		return 0;
	bound = OESqrt(slp->num_frames);
	if (bound < 1)
		return 0;

	x = p->x % bound;
	y = p->y % bound;
	if (x < 0)
		x += bound;
	if (y < 0)
		y += bound;
	return x + y * bound;
}

// -------------------------------------------------------------- blend lines
//
// Line.h and Lines.c. one line per (inner, outer) tile pair whose terrains
// blend; file is the inner terrain, which selects the mask set.

class COELine
{
	COEPoint inner;
	COEPoint outer;
	I64		 file;
};

class COELines
{
	COELine	*line;
	I64		 count;
	I64		 max;
};

U0 OELinesMake(COELines *l, I64 max)
{
	if (max < 1)
		max = 1;
	l->line  = CAlloc(sizeof(COELine) * max);
	l->count = 0;
	l->max   = max;
}

U0 OELinesFree(COELines *l)
{
	if (l->line)
		Free(l->line);
	l->line  = NULL;
	l->count = 0;
	l->max   = 0;
}

//Lines_Append asserts on overflow; growing keeps a blend list that outruns
//its estimate from aborting the frame.
U0 OELinesAppend(COELines *l, COEPoint *inner, COEPoint *outer, I64 file)
{
	COELine *e;

	if (!l->line)
		OELinesMake(l, 8);
	if (l->count == l->max)
	{
		l->max *= 2;
		l->line = ReAlloc(l->line, sizeof(COELine) * l->max);
	}
	e = &l->line[l->count];
	OEPtCopy(&e->inner, inner);
	OEPtCopy(&e->outer, outer);
	e->file = file;
	l->count++;
}

//Map_GetBlendBox: the neighbours of inner that a higher terrain bleeds over.
//the eight-neighbour box is walked in dx then dy order, which fixes the order
//the mask passes would run in.
U0 OEMapBlendBox(COEMap *m, COEPoints *out, COEPoint *inner)
{
	COEPoint delta;
	COEPoint outer;
	I64		 inner_tile = OEMapGetTerrain(m, inner);
	I64		 outer_tile;
	I64		 dx;
	I64		 dy;

	OEPointsMake(out, 8);
	for (dx = -1; dx <= 1; dx++)
	{
		for (dy = -1; dy <= 1; dy++)
		{
			OEPtSet(&delta, dx, dy);
			OEPtAdd(&outer, inner, &delta);
			if (!OEPtEqual(inner, &outer))
			{
				outer_tile = OEMapGetTerrain(m, &outer);
				if (outer_tile != OETR_NONE && inner_tile > outer_tile)
					OEPointsAppend(out, &outer);
			}
		}
	}
}

//Map_GetBlendLines over the tiles a frame renders
U0 OEMapBlendLines(COEMap *m, COELines *out, COEPoints *render)
{
	COEPoints  box;
	COEPoint  *inner;
	I64		   file;
	I64		   i;
	I64		   j;

	OELinesMake(out, 8 * render->count);
	for (i = 0; i < render->count; i++)
	{
		inner = &render->point[i];
		file  = OEMapGetTerrain(m, inner);
		OEMapBlendBox(m, &box, inner);
		for (j = 0; j < box.count; j++)
			OELinesAppend(out, inner, &box.point[j], file);
		OEPointsFree(&box);
	}
}

//Map_GetSlots: the eight player starts, E first then clockwise. the offset is
//middle minus the starting area, so on a 128 map the corners land one tile
//short of the edge.
I64 oe_map_slot_x[8] = { 1,  1,  0, -1, -1, -1,  0,  1};
I64 oe_map_slot_y[8] = { 0,  1,  1,  1,  0, -1, -1, -1};

U0 OEMapSlots(COEMap *m, COEPoints *out)
{
	COEPoint slot;
	I64		 dx = m->middle.x - OE_START_AREA_TILES;
	I64		 dy = m->middle.y - OE_START_AREA_TILES;
	I64		 i;

	OEPointsMake(out, 8);
	for (i = 0; i < 8; i++)
	{
		slot.x = m->middle.x + oe_map_slot_x[i] * dx;
		slot.y = m->middle.y + oe_map_slot_y[i] * dy;
		OEPointsAppend(out, &slot);
	}
}
