// JASC-PAL palettes out of interfac.drs, plus the ARGB and shade tables
//
// the palettes live in interfac.drs binary table 0 starting at file index 45
// (Palette.c Palette_Load). the payload is the plain JASC text form:
//
//	JASC-PAL
//	0100
//	256
//	R G B			x256
//
// palette entries 16..143 are the eight player-colour bands of 16. an SLP
// player-colour opcode emits a band-relative index; the blitter adds
// 16 * (color + 1) to land in the right band.
//
// shadows deviate from openempire, which paints palette index 0 (solid
// black). AoE2 darkens what is already on the canvas, so the port carries a
// darken LUT built by nearest-match against the palette, the same shape as
// devilution's light table.

#define OEPAL_BASE			45		//interfac.drs binary table 0 file index
#define OEPAL_COUNT			256
#define OEPAL_PLAYER_BAND	16		//entries per player colour
#define OEPAL_COLOR_COUNT	8

//index 255 never appears in Trial sprite data; the raster uses it as the
//transparent marker so a decoded frame stays one byte per pixel.
#define OEPAL_CLEAR			255

//shadow darkening, numerator over 256
#define OEPAL_SHADOW_NUM	112

U32	 oe_argb[OEPAL_COUNT];
U8	 oe_shade[OEPAL_COUNT];
U8	*oe_blend = NULL;		//[a * 256 + b] -> half of a over b
I64	 oe_pal_count = 0;
Bool oe_pal_loaded = FALSE;

//nearest palette entry to an arbitrary RGB. linear over the live entries;
//only the two startup tables call it.
I64 OEPalNearest(I64 r, I64 g, I64 b)
{
	I64 j;
	I64 dr;
	I64 dg;
	I64 db;
	I64 d;
	I64 best   = 0;
	I64 best_d = 0x7FFFFFFF;

	for (j = 0; j < oe_pal_count; j++)
	{
		dr = ((oe_argb[j] >> 16) & 0xFF) - r;
		dg = ((oe_argb[j] >>  8) & 0xFF) - g;
		db = ( oe_argb[j]        & 0xFF) - b;
		d  = dr * dr + dg * dg + db * db;
		if (d < best_d)
		{
			best_d = d;
			best   = j;
			if (!d)
				break;
		}
	}
	return best;
}

//text scan over the DRS blob. FileRead has no seek and the payload is not
//NUL-terminated, so every step is bounded by the entry size.
I64 OEPalSkipWS(U8 *p, I64 i, I64 n)
{
	while (i < n && (p[i] == ' ' || p[i] == '\t' || p[i] == '\r' || p[i] == '\n'))
		i++;
	return i;
}

I64 OEPalSkipTok(U8 *p, I64 i, I64 n)
{
	while (i < n && p[i] != ' ' && p[i] != '\t' && p[i] != '\r' && p[i] != '\n')
		i++;
	return i;
}

I64 OEPalReadInt(U8 *p, I64 *_i, I64 n)
{
	I64 i = OEPalSkipWS(p, *_i, n);
	I64 v = 0;

	while (i < n && p[i] >= '0' && p[i] <= '9')
	{
		v = v * 10 + (p[i] - '0');
		i++;
	}
	*_i = i;
	return v;
}

U0 OEPalMakeShade()
{//each colour scaled by OEPAL_SHADOW_NUM / 256, snapped back to the palette
	I64 i;
	I64 r;
	I64 g;
	I64 b;

	for (i = 0; i < OEPAL_COUNT; i++)
	{
		r = (((oe_argb[i] >> 16) & 0xFF) * OEPAL_SHADOW_NUM) >> 8;
		g = (((oe_argb[i] >>  8) & 0xFF) * OEPAL_SHADOW_NUM) >> 8;
		b = (( oe_argb[i]        & 0xFF) * OEPAL_SHADOW_NUM) >> 8;
		oe_shade[i] = OEPalNearest(r, g, b);
	}
}

//Vram.c Blend at alpha 0xFF/2. an indexed canvas cannot mix at blit time,
//so the half-and-half of every pair is precomputed and snapped once.
U0 OEPalMakeBlend()
{
	I64 a;
	I64 b;
	I64 r;
	I64 g;
	I64 bl;

	if (!oe_blend)
		oe_blend = CAlloc(OEPAL_COUNT * OEPAL_COUNT);

	for (a = 0; a < OEPAL_COUNT; a++)
	{
		for (b = 0; b < OEPAL_COUNT; b++)
		{
			r  = (((oe_argb[a] >> 16) & 0xFF) + ((oe_argb[b] >> 16) & 0xFF)) / 2;
			g  = (((oe_argb[a] >>  8) & 0xFF) + ((oe_argb[b] >>  8) & 0xFF)) / 2;
			bl = (( oe_argb[a]        & 0xFF) + ( oe_argb[b]        & 0xFF)) / 2;
			oe_blend[a * OEPAL_COUNT + b] = OEPalNearest(r, g, bl);
		}
	}
}

Bool OEPalLoad(I64 palette_offset)
{
	I64	 size = 0;
	U8	*p = OEDrsData(&oe_drs_interfac, 0, OEPAL_BASE + palette_offset, &size);
	I64	 i = 0;
	I64	 j;
	I64	 r;
	I64	 g;
	I64	 b;

	if (!p || size < 16)
	{
		"OpenEmpire: palette %d missing from interfac.drs\n", palette_offset;
		return FALSE;
	}

	i = OEPalSkipWS(p, i, size);		//JASC-PAL
	i = OEPalSkipTok(p, i, size);
	i = OEPalSkipWS(p, i, size);		//0100
	i = OEPalSkipTok(p, i, size);

	oe_pal_count = OEPalReadInt(p, &i, size);
	if (oe_pal_count < 1 || oe_pal_count > OEPAL_COUNT)
	{
		"OpenEmpire: palette count %d\n", oe_pal_count;
		return FALSE;
	}

	for (j = 0; j < OEPAL_COUNT; j++)
		oe_argb[j] = 0;

	for (j = 0; j < oe_pal_count; j++)
	{
		r = OEPalReadInt(p, &i, size);
		g = OEPalReadInt(p, &i, size);
		b = OEPalReadInt(p, &i, size);
		oe_argb[j] = 0xFF000000 | (r << 16) | (g << 8) | b;
	}

	OEPalMakeShade;
	OEPalMakeBlend;
	oe_pal_loaded = TRUE;
	return TRUE;
}

I64 OEPalPlayerBase(I64 color)
{//Scanline_Get: player_palette_index = 16 * (color + 1)
	return OEPAL_PLAYER_BAND * (color + 1);
}

U32 OEPalArgb(I64 index)
{
	if (index < 0 || index >= OEPAL_COUNT)
		return 0xFF000000;
	return oe_argb[index];
}
