#define OEIU_FEMALE_VILLAGER	16
#define OEIU_SPEARMAN			31
#define OEIU_SCOUT				64

#define OEIC_AGGRO_MOVE		6

// ---------------------------------------------------------------- buttons
//
// Buttons.c. base templates without upgrades; OEButtonUpgrade walks the tech
// tree over them.

class COEButton
{
	I64 icon_type;
	I64 index;
	I64 trigger;
};

class COEButtons
{
	COEButton	*button;
	I64			 count;
};

