//stable, town centre and command carry the same buttons in all three ages
#define OE_STABLE_COUNT		1
#define OE_TOWNCENTER_COUNT	3
#define OE_COMMAND_COUNT	1

COEButton oe_button_stable[OE_STABLE_COUNT] = {
	{OEICON_UNIT, OEIU_SCOUT, OETRG_NONE}
};

COEButton oe_button_towncenter[OE_TOWNCENTER_COUNT] = {
	{OEICON_UNIT, OEIU_MALE_VILLAGER,	OETRG_NONE},
	{OEICON_UNIT, OEIU_FEMALE_VILLAGER,	OETRG_NONE},
	{OEICON_TECH, OEIT_AGE_2,			OETRG_AGE_UP_2}
};

COEButton oe_button_command[OE_COMMAND_COUNT] = {
	{OEICON_COMMAND, OEIC_AGGRO_MOVE, OETRG_NONE}
};

U0 OEButtonNone(COEButton *b)
{
	b->icon_type = OEICON_NONE;
	b->index     = -1;
	b->trigger   = OETRG_NONE;
}

U0 OEButtonsSet(COEButtons *o, COEButton *button, I64 count)
{
	o->button = button;
	o->count  = count;
}

Bool OEButtonsIsCommandType(I64 type)
{
	return type == OET_MILITIA || type == OET_MAN_AT_ARMS ||
		type == OET_LONG_SWORDSMAN || type == OET_SCOUT ||
		type == OET_SPEARMAN || type == OET_PIKEMAN;
}

U0 OEButtonsFromMotive(COEButtons *o, COEMotive *m, I64 age)
{
	OEButtonsSet(o, NULL, 0);
	if (m->action == OEACT_BUILD)
	{
		if (age == OEAGE_1)
		{
			OEButtonsSet(o, oe_button_build_1, OE_BUILD_1_COUNT);
		}
		if (age == OEAGE_2)
		{
			OEButtonsSet(o, oe_button_build_2, OE_BUILD_2_COUNT);
		}
		if (age == OEAGE_3)
		{
			OEButtonsSet(o, oe_button_build_3, OE_BUILD_3_COUNT);
		}
	}
	if (m->action == OEACT_COMMAND && OEButtonsIsCommandType(m->type))
	{
		OEButtonsSet(o, oe_button_command, OE_COMMAND_COUNT);
	}
	if (m->action == OEACT_UNIT_TECH)
	{
		if (m->type == OET_BARRACKS)
		{
			if (age == OEAGE_1)
			{
				OEButtonsSet(o, oe_button_barracks_1, OE_BARRACKS_1_COUNT);
			}
			if (age == OEAGE_2)
			{
				OEButtonsSet(o, oe_button_barracks_2, OE_BARRACKS_2_COUNT);
			}
			if (age == OEAGE_3)
			{
				OEButtonsSet(o, oe_button_barracks_3, OE_BARRACKS_3_COUNT);
			}
		}
		if (m->type == OET_STABLE)
		{
			OEButtonsSet(o, oe_button_stable, OE_STABLE_COUNT);
		}
		if (m->type == OET_TOWN_CENTER)
		{
			OEButtonsSet(o, oe_button_towncenter, OE_TOWNCENTER_COUNT);
		}
	}
}

//Event_GetIndex: the icon grid keys, in Event.h declaration order
U32 oe_icon_key[OEEV_ICON_COUNT] = {
	OEEV_KEY_Q, OEEV_KEY_W, OEEV_KEY_E, OEEV_KEY_R, OEEV_KEY_T,
	OEEV_KEY_A, OEEV_KEY_S, OEEV_KEY_D, OEEV_KEY_F, OEEV_KEY_G,
	OEEV_KEY_Z, OEEV_KEY_X, OEEV_KEY_C, OEEV_KEY_V, OEEV_KEY_B
};

I64 OEEventGetIndex(U32 event)
{
	I64 i;

	if (!(event & OEEV_KEY_LALT))
	{
		return -1;
	}
	for (i = 0; i < OEEV_ICON_COUNT; i++)
	{
		if (event & oe_icon_key[i])
		{
			return i;
		}
	}
	return -1;
}

U0 OEButtonFromOverview(COEButton *o, COEOverview *ov)
{
	COEButtons	buttons;
	I64			index = OEEventGetIndex(ov->event);

	OEButtonsFromMotive(&buttons, &ov->share.motive, ov->share.status.age);
	if (index != -1 && buttons.button != NULL && index < buttons.count)
	{
		MemCopy(o, &buttons.button[index], sizeof(COEButton));
	}
	else
	{
		OEButtonNone(o);
	}
}

U0 OEButtonNext(COEButton *b, I64 trigger, I64 index)
{
	b->index   = index;
	b->trigger = trigger;
}

//Button_Upgrade. the indices reference the base buttons above.
U0 OEButtonUpgrade(COEButton *b, U64 bits)
{
	if (b->icon_type == OEICON_TECH)
	{
		if (b->index == OEIT_AGE_2 && OEBitsGet(bits, OETRG_AGE_UP_2))
		{
			OEButtonNext(b, OETRG_AGE_UP_3, OEIT_AGE_3);
		}
		if (b->index == OEIT_RESEARCH_MAN_AT_ARMS &&
			OEBitsGet(bits, OETRG_AGE_UP_3) &&
			OEBitsGet(bits, OETRG_UPGRADE_MILITIA))
		{
			OEButtonNext(b, OETRG_UPGRADE_MAN_AT_ARMS,
				OEIT_RESEARCH_LONG_SWORDSMAN);
		}
	}
	if (b->icon_type == OEICON_UNIT)
	{
		if (b->index == OEIU_MILITIA)
		{
			if (OEBitsGet(bits, OETRG_AGE_UP_2) &&
				OEBitsGet(bits, OETRG_UPGRADE_MILITIA))
			{
				OEButtonNext(b, OETRG_NONE, OEIU_MAN_AT_ARMS);
			}
			if (OEBitsGet(bits, OETRG_AGE_UP_3) &&
				OEBitsGet(bits, OETRG_UPGRADE_MAN_AT_ARMS))
			{
				OEButtonNext(b, OETRG_NONE, OEIU_LONG_SWORDSMAN);
			}
		}
		if (b->index == OEIU_SPEARMAN && OEBitsGet(bits, OETRG_AGE_UP_3) &&
			OEBitsGet(bits, OETRG_UPGRADE_SPEARMAN))
		{
			OEButtonNext(b, OETRG_NONE, OEIU_PIKEMAN);
		}
	}
}

