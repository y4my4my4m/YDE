//Parts_FromButton copies so every caller can free uniformly. the tables are
//never written, so the port points at them and there is nothing to free.
U0 OEPartsSet(COEParts *o, COEPart *part, I64 count)
{
	o->part  = part;
	o->count = count;
}

U0 OEPartsGetWayPointFlag(COEParts *o)
{
	OEPartsSet(o, oe_part_waypoint, 1);
}

U0 OEPartsGetRedArrows(COEParts *o)
{
	OEPartsSet(o, oe_part_red_arrows, 1);
}

U0 OEPartsGetSmoke(COEParts *o)
{
	OEPartsSet(o, oe_part_smoke, 1);
}

U0 OEPartsGetFire(COEParts *o)
{
	I64 pick = OERand() % 5;

	OEPartsSet(o, oe_part_fire_a, 1);
	if (pick == 1)
	{
		OEPartsSet(o, oe_part_fire_b, 1);
	}
	if (pick == 2)
	{
		OEPartsSet(o, oe_part_fire_c, 1);
	}
	if (pick == 3)
	{
		OEPartsSet(o, oe_part_fire_d, 1);
	}
	if (pick == 4)
	{
		OEPartsSet(o, oe_part_fire_e, 1);
	}
}

U0 OEPartsGetForestTree(COEParts *o)
{
	OEPartsSet(o, oe_part_forest_tree, 2);
}

U0 OEPartsGetStoneMine(COEParts *o)
{
	OEPartsSet(o, oe_part_stone_mine, 1);
}

U0 OEPartsGetGoldMine(COEParts *o)
{
	OEPartsSet(o, oe_part_gold_mine, 1);
}

U0 OEPartsGetBerryBush(COEParts *o)
{
	OEPartsSet(o, oe_part_berry_bush, 1);
}

U0 OEPartsBuildLookup(COEParts *o, I64 index, I64 age)
{
	OEPartsSet(o, NULL, 0);
	if (index == OEIB_BARRACKS)
	{
		if (age == OEAGE_1)
		{
			OEPartsSet(o, oe_part_barracks_1, 1);
		}
		if (age == OEAGE_2)
		{
			OEPartsSet(o, oe_part_barracks_2, 1);
		}
		if (age == OEAGE_3)
		{
			OEPartsSet(o, oe_part_barracks_3, 1);
		}
	}
	//no stable art exists in age one
	if (index == OEIB_STABLE)
	{
		if (age == OEAGE_2)
		{
			OEPartsSet(o, oe_part_stable_2, 1);
		}
		if (age == OEAGE_3)
		{
			OEPartsSet(o, oe_part_stable_3, 1);
		}
	}
	if (index == OEIB_MILL)
	{
		if (age == OEAGE_1)
		{
			OEPartsSet(o, oe_part_mill_1, 2);
		}
		if (age == OEAGE_2)
		{
			OEPartsSet(o, oe_part_mill_2, 3);
		}
		if (age == OEAGE_3)
		{
			OEPartsSet(o, oe_part_mill_3, 3);
		}
	}
	if (index == OEIB_HOUSE)
	{
		if (age == OEAGE_1)
		{
			OEPartsSet(o, oe_part_house_1, 1);
		}
		if (age == OEAGE_2)
		{
			OEPartsSet(o, oe_part_house_2, 1);
		}
		if (age == OEAGE_3)
		{
			OEPartsSet(o, oe_part_house_3, 1);
		}
	}
	if (index == OEIB_TOWN_CENTER)
	{
		if (age == OEAGE_1)
		{
			OEPartsSet(o, oe_part_towncenter_1, 8);
		}
		if (age == OEAGE_2)
		{
			OEPartsSet(o, oe_part_towncenter_2, 8);
		}
		if (age == OEAGE_3)
		{
			OEPartsSet(o, oe_part_towncenter_3, 8);
		}
	}
	if (index == OEIB_OUTPOST)
	{
		OEPartsSet(o, oe_part_outpost, 2);
	}
	if (index == OEIB_STONE_CAMP)
	{
		OEPartsSet(o, oe_part_stone_camp, 1);
	}
	if (index == OEIB_LUMBER_CAMP)
	{
		OEPartsSet(o, oe_part_lumber_camp, 1);
	}
	if (index == OEIB_CASTLE)
	{
		OEPartsSet(o, oe_part_castle, 2);
	}
}

U0 OEPartsUnitLookup(COEParts *o, I64 index)
{
	OEPartsSet(o, NULL, 0);
	if (index == OEIU_SPEARMAN)
	{
		OEPartsSet(o, oe_part_spearman, 1);
	}
	if (index == OEIU_PIKEMAN)
	{
		OEPartsSet(o, oe_part_pikeman, 1);
	}
	if (index == OEIU_SCOUT)
	{
		OEPartsSet(o, oe_part_scout, 1);
	}
	if (index == OEIU_MILITIA)
	{
		OEPartsSet(o, oe_part_militia, 1);
	}
	if (index == OEIU_MAN_AT_ARMS)
	{
		OEPartsSet(o, oe_part_man_at_arms, 1);
	}
	if (index == OEIU_LONG_SWORDSMAN)
	{
		OEPartsSet(o, oe_part_long_sword, 1);
	}
	if (index == OEIU_MALE_VILLAGER)
	{
		OEPartsSet(o, oe_part_villager_m, 1);
	}
	if (index == OEIU_FEMALE_VILLAGER)
	{
		OEPartsSet(o, oe_part_villager_f, 1);
	}
}

//every tech spawns the same tall flag, and the flag carries the trigger
U0 OEPartsFromButton(COEParts *o, COEButton *b, I64 age)
{
	OEPartsSet(o, NULL, 0);
	if (b->icon_type == OEICON_BUILD)
	{
		OEPartsBuildLookup(o, b->index, age);
	}
	if (b->icon_type == OEICON_UNIT)
	{
		OEPartsUnitLookup(o, b->index);
	}
	if (b->icon_type == OEICON_TECH)
	{
		OEPartsSet(o, oe_part_flag, 1);
	}
}

// ---------------------------------------------------------------- restore

class COERestore
{
	COEUnit	*unit;
	I64		 count;
	I64		 cycles;
	I64		 id_next;
	I64		 command_group_next;
	COEShare share[OECLR_COUNT];
	Bool	 is_success;
};

// -------------------------------------------------------------- container

U0 OEUnitsMake(COEUnits *us, I64 size, I64 max, I64 color)
{
	I64 area = size * size;
	I64 i;

	MemSet(us, 0, sizeof(COEUnits));
	us->size  = size;
	us->max   = max;
	us->color = color;
	us->unit  = CAlloc(sizeof(COEUnit) * max);
	us->stack = CAlloc(sizeof(COEStack) * area);
	for (i = 0; i < area; i++)
	{
		OEStackBuild(&us->stack[i], OE_STACK_INIT);
	}
	us->share[color].status.age    = OEAGE_1;
	us->share[color].motive.action = OEACT_NONE;
	us->share[color].motive.type   = OET_NONE;
}

U0 OEUnitsFree(COEUnits *us)
{
	I64 area = us->size * us->size;
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		OEPointsFree(&us->unit[i].path);
	}
	for (i = 0; i < area; i++)
	{
		OEStackFree(&us->stack[i]);
	}
	Free(us->stack);
	Free(us->unit);
	us->stack = NULL;
	us->unit  = NULL;
	us->count = 0;
}

Bool OEUnitsOutOfBounds(COEUnits *us, COEPoint *p)
{
	return p->x < 0 || p->y < 0 || p->x >= us->size || p->y >= us->size;
}

//Units_GetStackCart hands back a zeroed Stack out of bounds and every caller
//tests its reference for NULL. NULL out of bounds says the same thing.
COEStack *OEUnitsGetStackCart(COEUnits *us, COEPoint *p)
{
	if (OEUnitsOutOfBounds(us, p))
	{
		return NULL;
	}
	return &us->stack[p->x + p->y * us->size];
}

I64 OEUnitsGetStackCount(COEUnits *us, COEPoint *p)
{
	COEStack *s = OEUnitsGetStackCart(us, p);

	if (!s)
	{
		return 0;
	}
	return s->count;
}

U0 OEUnitsSafeStackAppend(COEUnits *us, COEUnit *u, COEPoint *cart)
{
	COEStack *s = OEUnitsGetStackCart(us, cart);

	if (s)
	{
		OEStackAppend(s, u);
	}
}

//an inanimate occupies every tile of its footprint
U0 OEUnitsProperStackAppend(COEUnits *us, COEUnit *u)
{
	COEPoint point;
	COEPoint cart;
	I64		 x;
	I64		 y;

	if (!u->trait.is_inanimate)
	{
		OEUnitsSafeStackAppend(us, u, &u->cart);
		return;
	}
	for (y = 0; y < u->trait.dimensions.y; y++)
	{
		for (x = 0; x < u->trait.dimensions.x; x++)
		{
			OEPtSet(&point, x, y);
			OEPtAdd(&cart, &point, &u->cart);
			OEUnitsSafeStackAppend(us, u, &cart);
		}
	}
}

U0 OEUnitsResetStacks(COEUnits *us)
{
	I64 area = us->size * us->size;
	I64 i;

	for (i = 0; i < area; i++)
	{
		us->stack[i].count = 0;
	}
}

U0 OEUnitsStackStacks(COEUnits *us)
{
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		OEUnitsProperStackAppend(us, &us->unit[i]);
	}
}

U0 OEUnitsManageStacks(COEUnits *us)
{
	OEUnitsResetStacks(us);
	OEUnitsStackStacks(us);
}

// ------------------------------------------------------------ walkability

Bool OEUnitsCanWalk(COEUnits *us, COEMap *map, COEPoint *p)
{
	COEStack *s = OEUnitsGetStackCart(us, p);

	if (!s)
	{
		return FALSE;
	}
	if (!OETerrIsWalkable(OEMapGetTerrain(map, p)))
	{
		return FALSE;
	}
	return OEStackIsWalkable(s);
}

Bool OEUnitsDimensionsBlock(COEUnits *us, COEUnit *u)
{
	COEStack *s;
	COEUnit	 *ref;
	COEPoint  offset;
	COEPoint  shift;
	I64		  x;
	I64		  y;
	I64		  i;
	Bool	  blocks;

	for (y = 0; y < u->trait.dimensions.y; y++)
	{
		for (x = 0; x < u->trait.dimensions.x; x++)
		{
			OEPtSet(&offset, x, y);
			OEPtAdd(&shift, &u->cart, &offset);
			s = OEUnitsGetStackCart(us, &shift);
			if (s)
			{
				for (i = 0; i < s->count; i++)
				{
					ref = s->unit[i];
					if (ref->trait.type == OET_FLAG &&
						u->trait.type == OET_FLAG)
					{
						return TRUE;
					}
					blocks = TRUE;
					//one animate over another is not a block
					if (!ref->trait.is_inanimate && !u->trait.is_inanimate)
					{
						blocks = FALSE;
					}
					//arrows and smoke are not a block
					if (ref->trait.can_expire)
					{
						blocks = FALSE;
					}
					//town centre detail takes an animate, but not a flag
					if (ref->trait.type == OET_TOWN_CENTER &&
						ref->trait.is_detail && !u->trait.is_inanimate &&
						u->trait.type != OET_FLAG)
					{
						blocks = FALSE;
					}
					if (blocks)
					{
						return TRUE;
					}
				}
			}
		}
	}
	return FALSE;
}

Bool OEUnitsCanBuild(COEUnits *us, COEMap *map, COEUnit *u)
{
	COEPoint offset;
	COEPoint cart;
	I64		 x;
	I64		 y;

	if (u->trait.can_expire)
	{
		return TRUE;
	}
	for (y = 0; y < u->trait.dimensions.y; y++)
	{
		for (x = 0; x < u->trait.dimensions.x; x++)
		{
			OEPtSet(&offset, x, y);
			OEPtAdd(&cart, &u->cart, &offset);
			if (OEUnitsDimensionsBlock(us, u))
			{
				return FALSE;
			}
			if (!OEUnitsCanWalk(us, map, &cart))
			{
				return FALSE;
			}
		}
	}
	return TRUE;
}

//the walkability grid is rebuilt from the unit footprints once a cycle,
//before any unit steps, so every peer paths against the same obstruction set
U0 OEUnitsField(COEUnits *us, COEMap *map, COEField *f)
{
	COEPoint point;
	I64		 row;
	I64		 col;

	for (row = 0; row < f->size; row++)
	{
		for (col = 0; col < f->size; col++)
		{
			OEPtSet(&point, col, row);
			if (OEUnitsCanWalk(us, map, &point))
			{
				OEFieldSet(f, &point, OEFIELD_WALKABLE);
			}
			else
			{
				OEFieldSet(f, &point, OEFIELD_OBSTRUCT);
			}
		}
	}
}

// -------------------------------------------------------------- selection

U0 OEUnitsUnSelectAll(COEUnits *us, I64 color)
{
	I64 i;

	us->share[color].select_count = 0;
	for (i = 0; i < us->count; i++)
	{
		OEUnitClearSelectedColor(&us->unit[i], color);
	}
}

U0 OEUnitsSelectAll(COEUnits *us, I64 color)
{
	COEUnit *u;
	I64		 i;

	us->share[color].select_count = 0;
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!OEUnitIsExempt(u) && u->color == color)
		{
			OEUnitSetSelectedColor(u, color);
			us->share[color].select_count++;
		}
	}
}

U0 OEUnitsSelectAllForAllColors(COEUnits *us)
{
	I64 i;

	for (i = 0; i < OECLR_COUNT; i++)
	{
		OEUnitsSelectAll(us, i);
	}
}

U0 OEUnitsRecountSelected(COEUnits *us, I64 color)
{
	COEUnit *u;
	I64		 i;

	us->share[color].select_count = 0;
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color)
		{
			us->share[color].select_count++;
		}
	}
}

// ----------------------------------------------------------------- append

COEUnit *OEUnitsLast(COEUnits *us)
{
	return &us->unit[us->count - 1];
}

//upstream aborts the process when the pool fills. both peers carry the same
//unit count, so both drop the same spawn and stay in step.
Bool OEUnitsAppend(COEUnits *us, COEUnit *u)
{
	if (us->count == us->max)
	{
		return FALSE;
	}
	MemCopy(&us->unit[us->count], u, sizeof(COEUnit));
	us->count++;
	return TRUE;
}

//the creator with the fewest children wins
COEUnit *OEUnitsFoundCreator(COEUnits *us, COEUnit *u, I64 color)
{
	COERect	 rect;
	COEUnit	*parent;
	COEUnit	*out   = NULL;
	I64		 min   = OE_I32_MAX;
	I64		 width = 2;
	I64		 j;

	for (j = 0; j < us->count; j++)
	{
		parent = &us->unit[j];
		if (OEUnitIsType(parent, color, u->trait.creator))
		{
			rect.a.x = parent->cart.x - width;
			rect.a.y = parent->cart.y - width;
			rect.b.x = parent->cart.x + width + parent->trait.dimensions.x;
			rect.b.y = parent->cart.y + width + parent->trait.dimensions.y;
			if (OERectContainsPoint(&rect, &u->cart) &&
				parent->child_count < min &&
				OEUnitIsSelectedByColor(parent, color) &&
				!parent->is_being_built)
			{
				out = parent;
				min = parent->child_count;
			}
		}
	}
	return out;
}

//SetChildren aims the child parent pointer at the spawn scratch, which
//upstream frees on return. it is retargeted at the appended parent here.
U0 OEUnitsBulkAppend(COEUnits *us, COEMap *map, COEUnit *temp, I64 color,
	I64 len, Bool ignore_collisions, Bool is_being_built)
{
	COEUnit *parent;
	COEUnit *first = NULL;
	COEUnit *last;
	I64		 i;

	if (!ignore_collisions)
	{
		for (i = 0; i < len; i++)
		{
			if (!OEUnitsCanBuild(us, map, &temp[i]))
			{
				return;
			}
		}
	}
	for (i = 0; i < len; i++)
	{
		if (temp[i].trait.creator != OET_NONE && is_being_built)
		{
			parent = OEUnitsFoundCreator(us, &temp[i], color);
			if (!parent)
			{
				return;
			}
			OEUnitSetParent(&temp[i], parent);
		}
		if (!OEUnitsAppend(us, &temp[i]))
		{
			return;
		}
		last = OEUnitsLast(us);
		if (i == 0)
		{
			first = last;
		}
		else if (temp[i].parent == temp)
		{
			last->parent = first;
		}
		OEUnitsProperStackAppend(us, last);
	}
}

//the first part of a list is the parent of the rest
U0 OEUnitsSetChildren(COEUnit *unit, I64 count)
{
	I64 i;

	if (count > 1)
	{
		unit[0].has_children = TRUE;
		for (i = 1; i < count; i++)
		{
			OEUnitSetParent(&unit[i], &unit[0]);
		}
	}
}

COEUnit *oe_spawn_temp = NULL;

U0 OEUnitsSpawnParts(COEUnits *us, COEPoint *cart, COEPoint *offset,
	COEGrid *g, I64 color, COEMap *map, Bool is_floating, COEParts *parts,
	Bool ignore_collisions, I64 trigger, Bool is_being_built)
{
	COEPoint cart_part;
	I64		 count = parts->count;
	I64		 i;

	if (count <= 0)
	{
		return;
	}
	if (count > OE_PARTS_MAX)
	{
		count = OE_PARTS_MAX;
	}
	if (!oe_spawn_temp)
	{
		oe_spawn_temp = CAlloc(sizeof(COEUnit) * OE_PARTS_MAX);
	}
	for (i = 0; i < count; i++)
	{
		OEPtAdd(&cart_part, cart, &parts->part[i].cart);
		OEUnitMake(&oe_spawn_temp[i], &cart_part, offset, g,
			parts->part[i].file, color, TRUE, is_floating, trigger,
			is_being_built);
	}
	OEUnitsSetChildren(oe_spawn_temp, count);
	OEUnitsBulkAppend(us, map, oe_spawn_temp, color, count,
		ignore_collisions, is_being_built);
}

// ---------------------------------------------------------------- pathing

class COEMag
{
	COEPoint point;
	I64		 mag;
};

//four sides of four tiles plus four corners, the ring around a 4x4
#define OE_APPROACH_SIDES	4
#define OE_APPROACH_MAX		20

//UTIL_SORT runs a comparator that never returns -1, so the reference order
//is whatever qsort settles on. insertion sort by magnitude is deterministic
//and yields the same four nearest tiles.
U0 OEUnitsGetNextBestInanimateCoord(COEUnits *us, COEUnit *u, COEGrid *g,
	COEField *f, COEPoint *out)
{
	COEMag	 mags[OE_APPROACH_MAX];
	COEMag	 tmp;
	COEUnit	*interest = u->interest;
	COEPoint shift;
	COEPoint cart;
	COEPoint cell;
	COEPoint diff;
	I64		 count = 0;
	I64		 width = 1;
	I64		 min;
	I64		 stacked;
	I64		 x;
	I64		 y;
	I64		 i;
	I64		 j;

	OEPtSet(out, -1, -1);
	for (x = -width; x < interest->trait.dimensions.x + width; x++)
	{
		for (y = -width; y < interest->trait.dimensions.y + width; y++)
		{
			if (x == -width || y == -width ||
				x == interest->trait.dimensions.x ||
				y == interest->trait.dimensions.y)
			{
				OEPtSet(&shift, x, y);
				OEPtAdd(&cart, &interest->cart, &shift);
				if (OEPtEqual(&u->cart, &cart))
				{
					OEPtCopy(out, &cart);
					return;
				}
				if (OEFieldIsWalkable(f, &cart) && count < OE_APPROACH_MAX)
				{
					OEGridCartToCell(g, &cell, &cart);
					OEPtSub(&diff, &u->cell, &cell);
					OEPtCopy(&mags[count].point, &cart);
					mags[count].mag = OEPtMag(&diff);
					count++;
				}
			}
		}
	}
	for (i = 1; i < count; i++)
	{
		MemCopy(&tmp, &mags[i], sizeof(COEMag));
		j   = i - 1;
		while (j >= 0 && mags[j].mag > tmp.mag)
		{
			MemCopy(&mags[j + 1], &mags[j], sizeof(COEMag));
			j--;
		}
		MemCopy(&mags[j + 1], &tmp, sizeof(COEMag));
	}
	//of the four nearest sides, take the tile carrying the fewest villagers.
	//upstream reads all four slots even when fewer were filled.
	min = OE_I32_MAX;
	for (i = 0; i < OE_APPROACH_SIDES && i < count; i++)
	{
		stacked = OEUnitsGetStackCount(us, &mags[i].point);
		if (stacked < min)
		{
			min = stacked;
			OEPtCopy(out, &mags[i].point);
		}
	}
}

U0 OEUnitsSetupGoal(COEUnits *us, COEUnit *u, COEGrid *g, COEField *f,
	Bool is_repath)
{
	if (u->interest->trait.is_inanimate)
	{
		//a repath would re-pick the approach tile while the crowd moves
		if (!is_repath)
		{
			OEUnitsGetNextBestInanimateCoord(us, u, g, f, &u->cart_goal);
			OEPtSet(&u->cart_grid_offset_goal, 0, 0);
		}
	}
	else
	{
		OEPtCopy(&u->cart_goal, &u->interest->cart);
		OEPtCopy(&u->cart_grid_offset_goal, &u->interest->cart_grid_offset);
		if (u->interest->color == u->color)
		{
			u->command_group = u->interest->command_group;
		}
	}
}

U0 OEUnitsFindPath(COEUnits *us, COEUnit *u, COEPoint *cart_goal,
	COEPoint *offset_goal, COEGrid *g, COEField *f, Bool is_repath)
{
	if (OEUnitIsExempt(u))
	{
		return;
	}
	if (u->interest)
	{
		OEUnitsSetupGoal(us, u, g, f, is_repath);
	}
	else
	{
		OEPtCopy(&u->cart_goal, cart_goal);
		OEPtCopy(&u->cart_grid_offset_goal, offset_goal);
	}
	OEUnitFreePath(u);
	u->has_direct = OEUnitHasDirectPath(u, g, f);
	if (u->has_direct)
	{
		OEPointsStraight(&u->path, &u->cart, &u->cart_goal);
	}
	else
	{
		OEFieldPathAStar(f, &u->path, &u->cart, &u->cart_goal);
	}
}

U0 OEUnitsRepath(COEUnits *us, COEUnit *u, COEGrid *g, COEField *f)
{
	if (!OEUnitIsExempt(u) && u->path_index_timer > OE_PATHING_TIMEOUT &&
		OEUnitHasPath(u))
	{
		OEUnitsFindPath(us, u, &u->cart_goal, &u->cart_grid_offset_goal, g,
			f, TRUE);
	}
}

//incremented once per cycle in OEUnitsCaretake
I64 oe_units_tick = 0;

U0 OEUnitsAdvanceBuildAnimate(COEUnits *us, COEUnit *u, COEGrid *g,
	COEField *f, Bool allowed_to_unlock_parent)
{
	if (oe_units_tick % OE_BUILD_DIVISOR)
	{
		return;
	}
	u->health++;
	if (u->health < u->trait.max_health)
	{
		return;
	}
	if (allowed_to_unlock_parent)
	{
		//a rallied creator hands its goal and its interest to the recruit
		if (u->parent->rally)
		{
			u->command_group = OEUnitGetCommandGroupNext();
			OEUnitSetInterest(u, u->parent->interest);
			OEUnitsFindPath(us, u, &u->parent->cart_goal,
				&u->parent->cart_grid_offset_goal, g, f, FALSE);
		}
		u->parent->child_lock_id = -1;
		u->parent->child_count--;
	}
	u->is_being_built   = FALSE;
	u->is_floating      = FALSE;
	u->has_parent_lock  = FALSE;
	OEUnitSetParent(u, NULL);
}

U0 OEUnitsPlantRallyPoint(COEUnits *us, COEUnit *u, COEMap *map, I64 color,
	COEPoint *cart_goal, COEPoint *offset_goal, COEGrid *g)
{
	COEParts parts;
	COEUnit	*rally;

	if (u->rally)
	{
		OEUnitFlag(u->rally);
	}
	OEPtCopy(&u->cart_goal, cart_goal);
	OEPtCopy(&u->cart_grid_offset_goal, offset_goal);
	OEPartsGetWayPointFlag(&parts);
	OEUnitsSpawnParts(us, cart_goal, offset_goal, g, color, map, FALSE,
		&parts, TRUE, OETRG_NONE, FALSE);
	if (us->count > 0)
	{
		rally = OEUnitsLast(us);
		OEUnitSetRally(u, rally);
		OEUnitSetParent(rally, u);
	}
}

U0 OEUnitsFindPathForSelected(COEUnits *us, COEMap *map, I64 color,
	COEPoint *cart_goal, COEPoint *offset_goal, COEGrid *g, COEField *f)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->color == color && OEUnitIsSelectedByColor(u, color))
		{
			if (u->trait.is_inanimate)
			{
				OEUnitsPlantRallyPoint(us, u, map, color, cart_goal,
					offset_goal, g);
			}
			else
			{
				u->command_group = OEUnitGetCommandGroupNext();
				OEUnitsFindPath(us, u, cart_goal, offset_goal, g, f, FALSE);
			}
		}
	}
}

U0 OEUnitsSetSelectedInterest(COEUnits *us, I64 color, COEUnit *interest)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color)
		{
			OEUnitSetInterest(u, interest);
		}
	}
}

U0 OEUnitsSetSelectedAggroMove(COEUnits *us, I64 color, Bool using_aggro_move)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color)
		{
			u->using_aggro_move = using_aggro_move;
		}
	}
}

U0 OEUnitsDisengageSelected(COEUnits *us, I64 color)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color)
		{
			u->is_engaged_in_melee = FALSE;
		}
	}
}

U0 OEUnitsPathSelectedToUnit(COEUnits *us, COEUnit *u, I64 color, COEGrid *g,
	COEMap *map, COEField *f)
{
	u->grid_flash_timer = 0;
	OEUnitsDisengageSelected(us, color);
	OEUnitsSetSelectedInterest(us, color, u);
	OEUnitsFindPathForSelected(us, map, color, &u->cart, &u->cart_grid_offset,
		g, f);
}

// ----------------------------------------------------------- screen space
//
// Overview.c and Rect.c. the overview layer is not written; these four live
// here until it is and move out unchanged.

Bool OEUnitsEvent(COEOverview *ov, U32 mask)
{
	return (ov->event & mask) != 0;
}


//Rect_CorrectOrientation, by min and max rather than by case
U0 OEUnitsRectCorrect(COERect *r, COERect *o)
{
	I64 ax = OEMin(r->a.x, r->b.x);
	I64 ay = OEMin(r->a.y, r->b.y);
	I64 bx = OEMax(r->a.x, r->b.x);
	I64 by = OEMax(r->a.y, r->b.y);

	OEPtSet(&o->a, ax, ay);
	OEPtSet(&o->b, bx, by);
}



// -------------------------------------------------------------- selecting

//Tile_Select, without the debug print
U0 OEUnitsSelectOne(COEUnit *u, I64 color)
{
	if (!OEUnitIsExempt(u) && !u->is_floating)
	{
		OEUnitSetSelectedColor(u, color);
	}
}

//Tiles_Get walks the z-sorted render list and probes the sprite alpha. there
//is no render list at this layer, so the pick runs over the cell stack under
//the cursor and the last non-detail entry wins, which is the unit the
//painter would have drawn on top.
COEUnit *OEUnitsPick(COEUnits *us, COEOverview *ov, COEGrid *g)
{
	COEPoint  cart;
	COEStack *s;
	COEUnit	 *ref;
	COEUnit	 *out = NULL;
	I64		  i;

	OEOverIsoToCart(ov, g, &cart, &ov->mouse_cursor);
	s = OEUnitsGetStackCart(us, &cart);
	if (!s)
	{
		return NULL;
	}
	for (i = 0; i < s->count; i++)
	{
		ref = s->unit[i];
		if (!OEUnitIsExempt(ref) && !ref->trait.is_detail)
		{
			out = ref;
		}
	}
	return out;
}

//Tiles_SelectWithBox. the tile hotspot is not available here, so the unit
//cart is projected instead; the sub-tile offset is dropped.
U0 OEUnitsSelectWithBox(COEUnits *us, COEOverview *ov, COEGrid *g)
{
	COERect	 box;
	COEPoint iso;
	COEUnit	*u;
	I64		 i;

	OEUnitsRectCorrect(&ov->selection_box, &box);
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!u->trait.is_inanimate && u->trait.type != OET_FLAG)
		{
			OEOverCartToIso(ov, g, &iso, &u->cart);
			if (OERectContainsPoint(&box, &iso))
			{
				OEUnitsSelectOne(u, ov->color);
			}
		}
	}
}

U0 OEUnitsSelectSimilar(COEUnits *us, COEUnit *similar, I64 color)
{
	COEUnit *u;
	I64		 i;
	Bool	 both_villagers;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		both_villagers = OEUnitIsVillager(u) && OEUnitIsVillager(similar);
		if ((u->trait.type == similar->trait.type || both_villagers) &&
			u->color == similar->color)
		{
			OEUnitsSelectOne(u, color);
		}
	}
}

U0 OEUnitsSelect(COEUnits *us, COEOverview *ov, COEGrid *g)
{
	COEUnit *pick;

	if (!OEUnitsEvent(ov, OEEV_MOUSE_LU) || OEUnitsEvent(ov, OEEV_KEY_LALT))
	{
		return;
	}
	OEUnitsUnSelectAll(us, ov->color);
	if (OEOverBoxArea(&ov->selection_box) > OE_SELECT_BOX_MIN)
	{
		OEUnitsSelectWithBox(us, ov, g);
	}
	else
	{
		pick = OEUnitsPick(us, ov, g);
		if (pick)
		{
			OEUnitsSelectOne(pick, ov->color);
			if (OEUnitsEvent(ov, OEEV_KEY_LSHIFT))
			{
				OEUnitsSelectSimilar(us, pick, ov->color);
			}
		}
	}
	OEUnitsRecountSelected(us, ov->color);
}

// ------------------------------------------------------------- commanding

//the trigger bits are read off units rather than the overview: a trigger
//lands faster than the overview round trip
U0 OEUnitsSpawnWithButton(COEUnits *us, COEOverview *ov, COEGrid *g,
	COEMap *map, COEButton *button, COEPoint *cart, Bool is_floating,
	Bool is_being_built)
{
	COEParts parts;
	COEPoint zero;

	OEPartsFromButton(&parts, button, ov->share.status.age);
	if (parts.count <= 0)
	{
		return;
	}
	if (OEBitsGet(us->share[ov->color].bits, button->trigger) ||
		OEBitsGet(us->share[ov->color].busy, button->trigger))
	{
		return;
	}
	OEPtSet(&zero, 0, 0);
	OEUnitsSpawnParts(us, cart, &zero, g, ov->color, map, is_floating,
		&parts, FALSE, button->trigger, is_being_built);
}

U0 OEUnitsUseIcon(COEUnits *us, COEOverview *ov, COEGrid *g, COEMap *map,
	Bool is_floating, Bool is_being_built)
{
	COEButton button;
	COEPoint  cart;

	OEOverIsoToCart(ov, g, &cart, &ov->mouse_cursor);
	OEButtonFromOverview(&button, ov);
	OEButtonUpgrade(&button, ov->share.bits);
	OEUnitsSpawnWithButton(us, ov, g, map, &button, &cart, is_floating,
		is_being_built);
}

U0 OEUnitsMoveToNewConstruction(COEUnits *us, COEOverview *ov, COEGrid *g,
	COEMap *map, COEField *f)
{
	COEPoint  cart;
	COEStack *s;
	COEUnit	 *ref;
	I64		  i;

	OEOverIsoToCart(ov, g, &cart, &ov->mouse_cursor);
	s = OEUnitsGetStackCart(us, &cart);
	if (!s)
	{
		return;
	}
	for (i = 0; i < s->count; i++)
	{
		ref = s->unit[i];
		if (!OEUnitIsExempt(ref))
		{
			OEUnitsPathSelectedToUnit(us, ref, ov->color, g, map, f);
			return;
		}
	}
}

U0 OEUnitsMoveTo(COEUnits *us, COEOverview *ov, COEGrid *g, COEMap *map,
	COEField *f)
{
	COEParts parts;
	COEPoint cart_goal;
	COEPoint cart_grid;
	COEPoint offset_goal;
	COEUnit	*pick = OEUnitsPick(us, ov, g);

	if (pick && !OEUnitIsExempt(pick) && !pick->is_floating)
	{
		OEUnitsPathSelectedToUnit(us, pick, ov->color, g, map, f);
		return;
	}
	OEUnitsDisengageSelected(us, ov->color);
	OEUnitsSetSelectedInterest(us, ov->color, NULL);
	OEOverIsoToCart(ov, g, &cart_goal, &ov->mouse_cursor);
	OEOverIsoToCartRaw(ov, g, &cart_grid, &ov->mouse_cursor);
	OEGridOffsetFromPoint(g, &offset_goal, &cart_grid);
	OEUnitsFindPathForSelected(us, map, ov->color, &cart_goal, &offset_goal,
		g, f);
	OEPartsGetRedArrows(&parts);
	OEUnitsSpawnParts(us, &cart_goal, &offset_goal, g, OECLR_GAIA, map,
		FALSE, &parts, FALSE, OETRG_NONE, FALSE);
}

U0 OEUnitsCommand(COEUnits *us, COEOverview *ov, COEGrid *g, COEMap *map,
	COEField *f)
{
	COEButton button;
	Bool	  using_aggro_move;

	if (ov->share.select_count <= 0)
	{
		return;
	}
	OEButtonFromOverview(&button, ov);
	//sound is local feedback: the sim runs every player's overview, so an
	//ungated play would sound each peer's orders on every machine. never
	//OESndPlayOneOf here - it draws from OERand and would desync the peers.
	if (OEUnitsEvent(ov, OEEV_MOUSE_LU) && button.icon_type == OEICON_BUILD)
	{
		OEUnitsMoveToNewConstruction(us, ov, g, map, f);
		if (ov->color == us->color)
		{
			OESndPlay(OESND_BUILD);
		}
	}
	if (OEUnitsEvent(ov, OEEV_MOUSE_RU))
	{
		if (ov->color == us->color)
		{
			OESndPlay(OESND_MOVE);
		}
		using_aggro_move = button.icon_type == OEICON_COMMAND &&
			button.index == OEIC_AGGRO_MOVE;
		OEUnitsMoveTo(us, ov, g, map, f);
		OEUnitsSetSelectedAggroMove(us, ov->color, using_aggro_move);
	}
	OEUnitIncrementCommandGroup;
}

U0 OEUnitsService(COEUnits *us, COEOverview *ov, COEGrid *g, COEMap *map,
	COEField *f)
{
	if (!OEUnitsEvent(ov, OEEV_MOUSE_LU) && !OEUnitsEvent(ov, OEEV_MOUSE_RU))
	{
		return;
	}
	OEUnitsSelect(us, ov, g);
	if (OEUnitsEvent(ov, OEEV_MOUSE_LU) && ov->color == us->color &&
		us->share[us->color].select_count > 0)
	{
		OESndPlay(OESND_CLICK);
	}
	//direct mode also arms the row on a bare letter once a selection exists,
	//so the modifier is only needed with nothing selected
	if (OEUnitsEvent(ov, OEEV_MOUSE_LU) &&
		(OEUnitsEvent(ov, OEEV_KEY_LALT) ||
		 (oe_opt_direct_keys && ov->share.select_count > 0)))
	{
		OEUnitsUseIcon(us, ov, g, map, FALSE, TRUE);
	}
	OEUnitsCommand(us, ov, g, map, f);
}

U0 OEUnitsPacketService(COEUnits *us, COEPacket *p, COEGrid *g, COEMap *map,
	COEField *f)
{
	I64 i;

	for (i = 0; i < OECLR_COUNT; i++)
	{
		OEUnitsService(us, &p->overview[i], g, map, f);
	}
}

// --------------------------------------------------------------- flocking

//a unit that is being followed carries a matching interest pointer on its
//follower. those are discarded, else enough followers push it forever.
U0 OEUnitsSeparateBoids(COEUnits *us, COEUnit *u, COEPoint *out)
{
	COEStack *s;
	COEUnit	 *other;
	COEPoint  shift;
	COEPoint  cart;
	COEPoint  force;
	I64		  width = 1;
	I64		  x;
	I64		  y;
	I64		  i;

	OEPtSet(out, 0, 0);
	if (OEUnitIsExempt(u))
	{
		return;
	}
	for (x = -width; x <= width; x++)
	{
		for (y = -width; y <= width; y++)
		{
			OEPtSet(&shift, x, y);
			OEPtAdd(&cart, &u->cart, &shift);
			s = OEUnitsGetStackCart(us, &cart);
			if (s)
			{
				for (i = 0; i < s->count; i++)
				{
					other = s->unit[i];
					if (!OEUnitCanAnimateClipAnimate(u, other) &&
						!(other->interest == u && other->color == u->color) &&
						!other->trait.is_inanimate)
					{
						OEUnitSeparate(u, other, &force);
						OEPtSub(out, out, &force);
					}
				}
			}
		}
	}
	OEPtDiv(out, out, OE_SEPARATION_DIVISOR);
}

U0 OEUnitsAlignBoids(COEUnits *us, COEUnit *u, COEPoint *out)
{
	COEStack *s;
	COEUnit	 *other;
	COEPoint  shift;
	COEPoint  cart;
	I64		  width = 1;
	I64		  x;
	I64		  y;
	I64		  i;

	OEPtSet(out, 0, 0);
	if (OEUnitIsExempt(u))
	{
		return;
	}
	for (x = -width; x <= width; x++)
	{
		for (y = -width; y <= width; y++)
		{
			OEPtSet(&shift, x, y);
			OEPtAdd(&cart, &u->cart, &shift);
			s = OEUnitsGetStackCart(us, &cart);
			if (s)
			{
				for (i = 0; i < s->count; i++)
				{
					other = s->unit[i];
					if (!(other->interest == u && other->color == u->color) &&
						!OEUnitIsExempt(other) &&
						OEUnitIsDifferent(u, other) &&
						OEUnitInPlatoon(u, other))
					{
						OEPtAdd(out, out, &other->velocity);
					}
				}
			}
		}
	}
	OEPtDiv(out, out, OE_ALIGN_DIVISOR);
}

#define OE_WALL_REPULSION	100

U0 OEUnitsWallPushBoids(COEUnits *us, COEUnit *u, COEMap *map, COEGrid *g,
	COEPoint *out)
{
	COEPoint n;
	COEPoint e;
	COEPoint s;
	COEPoint w;
	COEPoint offset;
	COEPoint probe;
	COEPoint push;
	I64		 border;

	OEPtSet(out, 0, 0);
	if (OEUnitIsExempt(u))
	{
		return;
	}
	OEPtSet(&n,  0, -1);
	OEPtSet(&e,  1,  0);
	OEPtSet(&s,  0,  1);
	OEPtSet(&w, -1,  0);
	OEGridCornerOffset(g, &offset, &u->cart_grid_offset);
	border = ((u->trait.width / 2) / OE_CELL_SIZE) / 2;

	OEPtAdd(&probe, &u->cart, &n);
	if (!OEUnitsCanWalk(us, map, &probe) && offset.y < border)
	{
		OEPtMul(&push, &s, OE_WALL_REPULSION);
		OEPtAdd(out, out, &push);
	}
	OEPtAdd(&probe, &u->cart, &w);
	if (!OEUnitsCanWalk(us, map, &probe) && offset.x < border)
	{
		OEPtMul(&push, &e, OE_WALL_REPULSION);
		OEPtAdd(out, out, &push);
	}
	OEPtAdd(&probe, &u->cart, &s);
	if (!OEUnitsCanWalk(us, map, &probe) &&
		offset.y > g->tile_cart_height - border)
	{
		OEPtMul(&push, &n, OE_WALL_REPULSION);
		OEPtAdd(out, out, &push);
	}
	OEPtAdd(&probe, &u->cart, &e);
	if (!OEUnitsCanWalk(us, map, &probe) &&
		offset.x > g->tile_cart_width - border)
	{
		OEPtMul(&push, &w, OE_WALL_REPULSION);
		OEPtAdd(out, out, &push);
	}
	u->was_wall_pushed = OEPtMag(out) > 0;
}

U0 OEUnitsCalculateBoidStressors(COEUnits *us, COEUnit *u, COEMap *map,
	COEGrid *g)
{
	COEPoint separation;
	COEPoint wall;
	COEPoint sum;

	if (OEUnitIsExempt(u))
	{
		return;
	}
	OEUnitsAlignBoids(us, u, &u->group_alignment);
	OEUnitsSeparateBoids(us, u, &separation);
	OEUnitsWallPushBoids(us, u, map, g, &wall);
	OEPtAdd(&sum, &u->group_alignment, &separation);
	OEPtAdd(&sum, &sum, &wall);
	OEPtSet(&u->stressors, 0, 0);
	if (OEPtMag(&sum) >= OE_STRESSOR_DEADZONE)
	{
		OEPtCopy(&u->stressors, &sum);
	}
}

//a platoon mate standing on a unit that has arrived stops too
U0 OEUnitsConditionallyStopBoids(COEUnits *us, COEUnit *u)
{
	COEStack *s;
	COEUnit	 *other;
	I64		  i;

	if (OEUnitIsExempt(u))
	{
		return;
	}
	s = OEUnitsGetStackCart(us, &u->cart);
	if (!s)
	{
		return;
	}
	for (i = 0; i < s->count; i++)
	{
		other = s->unit[i];
		if (!OEUnitIsExempt(other) && OEUnitIsDifferent(u, other) &&
			OEUnitHasNoPath(u) && OEUnitInPlatoon(u, other))
		{
			OEUnitFreePath(other);
		}
	}
}

U0 OEUnitsConditionallyStopAllBoids(COEUnits *us)
{
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		OEUnitsConditionallyStopBoids(us, &us->unit[i]);
	}
}

//paths do not cross the wire, so a restored unit repaths on its new peer
U0 OEUnitsFreeAllPathsForRecovery(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitHasPath(u))
		{
			u->must_repath_with_recover = TRUE;
		}
		OEUnitFreePath(u);
	}
}

// ----------------------------------------------------------------- debris

U0 OEUnitsSpamFire(COEUnits *us, COEUnit *u, COEGrid *g, COEMap *map)
{
	COEParts parts;
	COEPoint offset;
	COEPoint cart;
	COEPoint grid_offset;
	I64		 w = g->tile_cart_width;
	I64		 h = g->tile_cart_height;
	I64		 gx;
	I64		 gy;
	I64		 x;
	I64		 y;

	for (x = 0; x < u->trait.dimensions.x; x++)
	{
		for (y = 0; y < u->trait.dimensions.y; y++)
		{
			OEPtSet(&offset, x, y);
			OEPtAdd(&cart, &u->cart, &offset);
			//x is drawn before y, as upstream draws it
			gx = OERand() % w - w / 2;
			gy = OERand() % h - h / 2;
			OEPtSet(&grid_offset, gx, gy);
			OEPartsGetFire(&parts);
			OEUnitsSpawnParts(us, &cart, &grid_offset, g, OECLR_GAIA, map,
				FALSE, &parts, TRUE, OETRG_NONE, FALSE);
		}
	}
}

U0 OEUnitsSpamSmoke(COEUnits *us, COEUnit *u, COEGrid *g, COEMap *map)
{
	COEParts parts;
	COEPoint zero;
	COEPoint shift;
	COEPoint cart;
	I64		 x;
	I64		 y;

	OEPtSet(&zero, 0, 0);
	for (x = 0; x < u->trait.dimensions.x; x++)
	{
		for (y = 0; y < u->trait.dimensions.y; y++)
		{
			OEPtSet(&shift, x, y);
			OEPtAdd(&cart, &u->cart, &shift);
			OEPartsGetSmoke(&parts);
			OEUnitsSpawnParts(us, &cart, &zero, g, OECLR_GAIA, map, FALSE,
				&parts, TRUE, OETRG_NONE, FALSE);
		}
	}
}

U0 OEUnitsDisengageFrom(COEUnits *us, COEUnit *other)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->interest == other)
		{
			u->is_engaged_in_melee = FALSE;
			OEUnitSetInterest(u, NULL);
			OEUnitFreePath(u);
		}
	}
}

U0 OEUnitsFlagChildren(COEUnits *us, COEUnit *u)
{
	COEUnit *child;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		child = &us->unit[i];
		if (child->parent_id == u->id)
		{
			OEUnitFlag(child);
		}
	}
}

U0 OEUnitsFlag(COEUnits *us, COEUnit *u)
{
	OEUnitFlag(u);
	OEUnitsDisengageFrom(us, u);
	if (u->has_children)
	{
		OEUnitsFlagChildren(us, u);
	}
}

U0 OEUnitsFlagTheDead(COEUnits *us, COEGrid *g, COEMap *map)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!OEUnitIsExempt(u) && OEUnitIsDead(u))
		{
			OEUnitsFlag(us, u);
			if (!u->must_skip_debris && u->trait.is_inanimate)
			{
				OEUnitMakeRubble(u, g);
				OEUnitsSpamFire(us, u, g, map);
				OEUnitsSpamSmoke(us, u, g, map);
			}
		}
	}
}

U0 OEUnitsExpire(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->trait.can_expire &&
			u->state_timer == OEUnitGetLastExpireTick(u))
		{
			u->must_garbage_collect = TRUE;
		}
	}
}

// ---------------------------------------------------------------- engaging

COEUnit *OEUnitsGetClosestBoid(COEUnits *us, COEUnit *u, COEGrid *g)
{
	COEStack *s;
	COEUnit	 *other;
	COEUnit	 *closest = NULL;
	COEPoint  shift;
	COEPoint  cart;
	COEPoint  cell;
	COEPoint  diff;
	I64		  width = 2;
	I64		  min   = OE_I32_MAX;
	I64		  mag;
	I64		  x;
	I64		  y;
	I64		  i;

	for (x = -width; x <= width; x++)
	{
		for (y = -width; y <= width; y++)
		{
			OEPtSet(&shift, x, y);
			OEPtAdd(&cart, &u->cart, &shift);
			s = OEUnitsGetStackCart(us, &cart);
			if (s)
			{
				for (i = 0; i < s->count; i++)
				{
					other = s->unit[i];
					if (OEUnitAreEnemies(u, other))
					{
						OEPtCopy(&cell, &other->cell);
						if (other->trait.is_inanimate)
						{
							OEGridCartToCell(g, &cell, &cart);
						}
						OEPtSub(&diff, &cell, &u->cell);
						mag = OEPtMag(&diff);
						if (mag < min)
						{
							min     = mag;
							closest = other;
						}
					}
				}
			}
		}
	}
	return closest;
}

Bool OEUnitsInterestInRange(COEUnits *us, COEUnit *u)
{
	COEStack *s;
	COEPoint  shift;
	COEPoint  cart;
	I64		  width = 1;
	I64		  x;
	I64		  y;
	I64		  i;

	for (x = -width; x <= width; x++)
	{
		for (y = -width; y <= width; y++)
		{
			OEPtSet(&shift, x, y);
			OEPtAdd(&cart, &u->cart, &shift);
			s = OEUnitsGetStackCart(us, &cart);
			if (s)
			{
				for (i = 0; i < s->count; i++)
				{
					if (s->unit[i] == u->interest)
					{
						return TRUE;
					}
				}
			}
		}
	}
	return FALSE;
}

U0 OEUnitsEngageBoids(COEUnits *us, COEUnit *u, COEGrid *g)
{
	COEUnit *closest;

	if (OEUnitIsExempt(u) || u->is_state_locked)
	{
		return;
	}
	if (u->using_aggro_move)
	{
		closest = OEUnitsGetClosestBoid(us, u, g);
		//aggro move walks past resources and past flags
		if (closest && closest->trait.type != OET_FLAG &&
			!closest->trait.is_resource)
		{
			OEUnitSetInterest(u, closest);
			OEUnitUpdateCellInterestInanimate(u, g);
			OEUnitEngageWithMock(u, closest, g);
		}
		return;
	}
	if (u->interest && OEUnitsInterestInRange(us, u))
	{
		OEUnitUpdateCellInterestInanimate(u, g);
		OEUnitEngageWithMock(u, u->interest, g);
	}
}

U0 OEUnitsEngageAllBoids(COEUnits *us, COEGrid *g)
{
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		OEUnitsEngageBoids(us, &us->unit[i], g);
	}
}

// ------------------------------------------------------------- hard rules

//the pather works in time slices; a whole-array repath every cycle both
//costs more and looks worse
U0 OEUnitsRepathSomeBoids(COEUnits *us, COEGrid *g, COEField *f)
{
	I64 slice = us->count / OE_REPATH_SLICE_SIZE;
	I64 end;
	I64 i;

	if (!slice)
	{
		slice = us->count;
	}
	end = slice + us->repath_index;
	if (end > us->count)
	{
		end = us->count;
	}
	for (i = us->repath_index; i < end; i++)
	{
		OEUnitsRepath(us, &us->unit[i], g, f);
	}
	us->repath_index += slice;
	if (us->repath_index >= us->count)
	{
		us->repath_index = 0;
	}
}

U0 OEUnitsGather(COEStatus *status, COEResource *r)
{
	if (r->type == OET_FOOD)
	{
		status->food += r->amount;
	}
	if (r->type == OET_WOOD)
	{
		status->wood += r->amount;
	}
	if (r->type == OET_GOLD)
	{
		status->gold += r->amount;
	}
	if (r->type == OET_STONE)
	{
		status->stone += r->amount;
	}
}

U0 OEUnitsMeleeAllBoids(COEUnits *us, COEGrid *g)
{
	COEResource	 r;
	COEUnit		*u;
	I64			 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		OEUnitMelee(u, g, &r);
		if (r.type != OET_NONE)
		{
			OEUnitsGather(&us->share[u->color].status, &r);
		}
	}
}

U0 OEUnitsProcessHardRules(COEUnits *us, COEField *f, COEGrid *g)
{
	OEUnitsRepathSomeBoids(us, g, f);
	OEUnitsConditionallyStopAllBoids(us);
	OEUnitsEngageAllBoids(us, g);
	OEUnitsMeleeAllBoids(us, g);
}

//StressorThread then FlowThread, both fanned across cpu_count threads
//upstream. index order here, which fixes the order the stacks are read in.
U0 OEUnitsManagePathFinding(COEUnits *us, COEGrid *g, COEMap *map,
	COEField *f)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		OEUnitsCalculateBoidStressors(us, &us->unit[i], map, g);
	}
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!OEStateIsDead(u->state))
		{
			OEUnitFlow(u, g);
			OEUnitMove(u, g);
			if (!OEUnitsCanWalk(us, map, &u->cart))
			{
				OEUnitUndoMove(u, g);
			}
		}
	}
	OEUnitsProcessHardRules(us, f, g);
}

// ------------------------------------------------------------------ timers

U0 OEUnitsTick(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		u->state_timer++;
		u->dir_timer++;
		u->path_index_timer++;
		u->grid_flash_timer++;
		if (OEUnitFlashTimerTick(u))
		{
			u->is_flash_on ^= TRUE;
		}
		if (u->is_timing_to_collect)
		{
			u->garbage_collection_timer++;
		}
	}
}

U0 OEUnitsDecay(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->state == OEST_FALL &&
			u->state_timer == OEUnitGetLastFallTick(u))
		{
			OEUnitSetState(u, OEST_DECAY, TRUE);
			OEUnitClearSelectedAllColors(u);
		}
	}
}

U0 OEUnitsUpdateEntropy(COEUnits *us)
{
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		OEPtRand(&us->unit[i].entropy);
	}
}

// ------------------------------------------------------- garbage collection

U0 OEUnitsFlagGarbage(COEUnits *us)
{
	COEUnit *u;
	I64		 time;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->state == OEST_DECAY &&
			u->state_timer == OEUnitGetLastDecayTick(u))
		{
			u->must_garbage_collect = TRUE;
		}
		if (u->is_timing_to_collect)
		{
			time = OE_CLEANUP_RUBBLE;
			if (u->trait.type == OET_FIRE)
			{
				time = OE_CLEANUP_FIRE;
			}
			if (u->garbage_collection_timer == time)
			{
				u->must_garbage_collect = TRUE;
			}
		}
	}
}

//CompareByGarbage is not antisymmetric, so the surviving order is whatever
//qsort settles on. a stable partition keeps index order, which the parity
//hash depends on. the dropped unit owns its path; upstream truncates the
//count and leaks it.
U0 OEUnitsResize(COEUnits *us)
{
	I64 keep = 0;
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		if (us->unit[i].must_garbage_collect)
		{
			OEPointsFree(&us->unit[i].path);
		}
		else
		{
			if (keep != i)
			{
				MemCopy(&us->unit[keep], &us->unit[i], sizeof(COEUnit));
			}
			keep++;
		}
	}
	us->count = keep;
}

I64 *oe_sort_order = NULL;
I64 *oe_sort_temp  = NULL;
I64  oe_sort_max   = 0;

//bottom-up merge over an index array, then one in-place cycle walk. ids run
//ascending until a rubble swap or a restore breaks it, so the sort is
//needed, but the records only ever move once.
U0 OEUnitsSortById(COEUnits *us)
{
	COEUnit	 tmp;
	I64		*a;
	I64		*b;
	I64		*swap;
	I64		 n = us->count;
	I64		 w;
	I64		 lo;
	I64		 mid;
	I64		 hi;
	I64		 i;
	I64		 j;
	I64		 k;

	if (n < 2)
	{
		return;
	}
	if (oe_sort_max < n)
	{
		if (oe_sort_order)
		{
			Free(oe_sort_order);
		}
		if (oe_sort_temp)
		{
			Free(oe_sort_temp);
		}
		oe_sort_max   = n;
		oe_sort_order = CAlloc(sizeof(I64) * n);
		oe_sort_temp  = CAlloc(sizeof(I64) * n);
	}
	a = oe_sort_order;
	b = oe_sort_temp;
	for (i = 0; i < n; i++)
	{
		a[i] = i;
	}
	w = 1;
	while (w < n)
	{
		lo = 0;
		while (lo < n)
		{
			mid = lo + w;
			hi  = mid + w;
			if (mid > n)
			{
				mid = n;
			}
			if (hi > n)
			{
				hi = n;
			}
			i = lo;
			j = mid;
			k = lo;
			while (i < mid || j < hi)
			{
				if (j >= hi)
				{
					b[k] = a[i];
					i++;
				}
				else if (i >= mid)
				{
					b[k] = a[j];
					j++;
				}
				else if (us->unit[a[j]].id < us->unit[a[i]].id)
				{
					b[k] = a[j];
					j++;
				}
				else
				{
					b[k] = a[i];
					i++;
				}
				k++;
			}
			lo = hi;
		}
		swap = a;
		a    = b;
		b    = swap;
		w   *= 2;
	}
	//a maps destination to source; invert so the walk below can place a
	//record straight into its slot
	for (i = 0; i < n; i++)
	{
		b[a[i]] = i;
	}
	for (i = 0; i < n; i++)
	{
		while (b[i] != i)
		{
			j           = b[i];
			MemCopy(&tmp, &us->unit[i], sizeof(COEUnit));
			MemCopy(&us->unit[i], &us->unit[j], sizeof(COEUnit));
			MemCopy(&us->unit[j], &tmp, sizeof(COEUnit));
			k           = b[i];
			b[i]        = b[j];
			b[j]        = k;
		}
	}
}

COEUnit *OEUnitsSearchById(COEUnits *us, I64 id)
{
	I64 lo = 0;
	I64 hi = us->count - 1;
	I64 mid;

	while (lo <= hi)
	{
		mid = (lo + hi) / 2;
		if (us->unit[mid].id == id)
		{
			return &us->unit[mid];
		}
		if (us->unit[mid].id < id)
		{
			lo = mid + 1;
		}
		else
		{
			hi = mid - 1;
		}
	}
	return NULL;
}

U0 OEUnitsNullInterestPointers(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		u->interest = NULL;
		u->parent   = NULL;
		u->rally    = NULL;
	}
}

//interest, parent and rally never cross the wire; they are rebuilt from the
//id fields at the end of every cycle
U0 OEUnitsResetPointers(COEUnits *us)
{
	COEUnit *u;
	COEUnit *found;
	I64		 i;

	OEUnitsSortById(us);
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->interest_id != -1)
		{
			found = OEUnitsSearchById(us, u->interest_id);
			if (found)
			{
				u->interest = found;
			}
		}
		if (u->parent_id != -1)
		{
			found = OEUnitsSearchById(us, u->parent_id);
			if (found)
			{
				u->parent = found;
			}
		}
		if (u->rally_id != -1)
		{
			found = OEUnitsSearchById(us, u->rally_id);
			if (found)
			{
				u->rally = found;
			}
		}
	}
}

U0 OEUnitsRemoveGarbage(COEUnits *us)
{
	OEUnitsFlagGarbage(us);
	OEUnitsResize(us);
	OEUnitsNullInterestPointers(us);
	OEUnitsResetPointers(us);
}

// ---------------------------------------------------------------- motives

//Util_MaxIntIndex: strictly greater, so the first maximum wins and an all
//zero array yields index zero
I64 OEUnitsMaxIndex(I64 *array, I64 size)
{
	I64 max   = 0;
	I64 index = 0;
	I64 i;

	for (i = 0; i < size; i++)
	{
		if (array[i] > max)
		{
			max   = array[i];
			index = i;
		}
	}
	return index;
}

//the motive is the commonest action and type across the selection, offset by
//one so that the -1 of ACTION_NONE and TYPE_NONE lands on slot zero
I64 OEUnitsGetAction(COEUnits *us, I64 color)
{
	I64		 counts[OEACT_COUNT + 1];
	I64		 size = OEACT_COUNT + 1;
	COEUnit	*u;
	I64		 i;

	MemSet(counts, 0, sizeof(I64) * size);
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color &&
			!u->is_being_built)
		{
			counts[u->trait.action + 1]++;
		}
	}
	return OEUnitsMaxIndex(counts, size) - 1;
}

I64 OEUnitsGetType(COEUnits *us, I64 color)
{
	I64		 counts[OET_COUNT + 1];
	I64		 size = OET_COUNT + 1;
	COEUnit	*u;
	I64		 i;

	MemSet(counts, 0, sizeof(I64) * size);
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsSelectedByColor(u, color) && u->color == color)
		{
			counts[u->trait.type + 1]++;
		}
	}
	return OEUnitsMaxIndex(counts, size) - 1;
}

U0 OEUnitsUpdateAllMotives(COEUnits *us)
{
	I64 i;

	for (i = 0; i < OECLR_COUNT; i++)
	{
		us->share[i].motive.action = OEUnitsGetAction(us, i);
		us->share[i].motive.type   = OEUnitsGetType(us, i);
	}
}

I64 OEUnitsCountPopulation(COEUnits *us, I64 color)
{
	COEUnit *u;
	I64		 count = 0;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!OEUnitIsExempt(u) && !u->trait.is_inanimate && !u->is_floating &&
			u->color == color)
		{
			count++;
		}
	}
	return count;
}

U0 OEUnitsCountAllPopulations(COEUnits *us)
{
	I64 i;

	for (i = 0; i < OECLR_COUNT; i++)
	{
		us->share[i].status.population = OEUnitsCountPopulation(us, i);
	}
}

// --------------------------------------------------------------- triggers

U0 OEUnitsAppendMissing(COEUnits *us, COEUnit *u, COEGrid *g, I64 file)
{
	COEUnit	 missing;
	COEPoint zero;

	OEPtSet(&zero, 0, 0);
	OEUnitMake(&missing, &u->cart, &zero, g, file, u->color, FALSE, FALSE,
		OETRG_NONE, u->is_being_built);
	OEUnitSetParent(&missing, u);
	OEUnitsAppend(us, &missing);
}

//the age two mill art carries a shadow the age one art does not
U0 OEUnitsUpgradeInanimate(COEUnits *us, COEUnit *flag, COEGrid *g, I64 age)
{
	COEUnit *u;
	I64		 upgrade;
	I64		 i;

	us->share[flag->color].status.age = age;
	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->color == flag->color)
		{
			upgrade = u->trait.upgrade;
			if (upgrade != OEG_NONE && u->trait.is_inanimate)
			{
				if (u->file == OEG_AGE_1_MILL)
				{
					OEUnitsAppendMissing(us, u, g,
						OEG_AGE_2_WEST_EUROPE_MILL_SHADOW);
				}
				OEUnitPreservedUpgrade(u, g, upgrade);
			}
		}
	}
}

U0 OEUnitsUpgradeType(COEUnits *us, COEUnit *flag, COEGrid *g, I64 type)
{
	COEUnit *u;
	I64		 upgrade;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (OEUnitIsType(u, flag->color, type))
		{
			upgrade = u->trait.upgrade;
			if (upgrade != OEG_NONE)
			{
				OEUnitPreservedUpgrade(u, g, upgrade);
			}
		}
	}
}

//upstream marks the flag with is_triggered. the ABI carries no such field,
//so the share bit is the guard: it is set on the same pass and read on the
//next. only one trigger runs per cycle.
U0 OEUnitsTriggerTriggers(COEUnits *us, COEGrid *g)
{
	COEUnit *flag;
	I64		 trigger;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		flag    = &us->unit[i];
		trigger = flag->trigger;
		if (trigger != OETRG_NONE &&
			!OEBitsGet(us->share[flag->color].bits, trigger))
		{
			if (flag->is_being_built)
			{
				us->share[flag->color].busy =
					OEBitsSet(us->share[flag->color].busy, trigger);
			}
			else
			{
				us->share[flag->color].bits =
					OEBitsSet(us->share[flag->color].bits, trigger);
				if (trigger == OETRG_AGE_UP_2)
				{
					OEUnitsUpgradeInanimate(us, flag, g, OEAGE_2);
					return;
				}
				if (trigger == OETRG_AGE_UP_3)
				{
					OEUnitsUpgradeInanimate(us, flag, g, OEAGE_3);
					return;
				}
				//the three simple upgrades map one to one onto the first
				//types
				OEUnitsUpgradeType(us, flag, g, trigger);
				return;
			}
		}
	}
}

// ----------------------------------------------------------- construction

U0 OEUnitsCompleteInanimateConstruction(COEUnits *us, COEMap *map)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->trait.is_inanimate && u->health >= u->trait.max_health &&
			u->is_being_built)
		{
			OEUnitsDisengageFrom(us, u);
			u->is_being_built = FALSE;
			if (u->trait.type == OET_MILL)
			{
				OEUnitLayFarm(u, map);
			}
		}
	}
}

//a creator trains one recruit at a time; the lock names which one
U0 OEUnitsBuildAnimate(COEUnits *us, COEGrid *g, COEField *f)
{
	COEUnit *u;
	COEUnit *parent;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!u->trait.is_inanimate && u->is_being_built)
		{
			parent = u->parent;
			if (parent)
			{
				if (parent->child_lock_id == -1)
				{
					parent->child_lock_id = u->id;
					u->has_parent_lock    = TRUE;
				}
				if (parent->child_lock_id == u->id)
				{
					OEUnitsAdvanceBuildAnimate(us, u, g, f, TRUE);
				}
			}
			else
			{
				OEUnitsAdvanceBuildAnimate(us, u, g, f, FALSE);
			}
		}
	}
}

U0 OEUnitsPursue(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (!OEUnitIsExempt(u) && u->interest &&
			!u->interest->trait.is_inanimate)
		{
			OEPtCopy(&u->cart_goal, &u->interest->cart);
			OEPtCopy(&u->cart_grid_offset_goal,
				&u->interest->cart_grid_offset);
		}
	}
}

// ------------------------------------------------------------------ cycle

U0 OEUnitsCaretake(COEUnits *us, COEGrid *g, COEMap *map, COEField *f,
	Bool must_randomize_mouse)
{
	if (must_randomize_mouse)
	{
		OEUnitsSelectAllForAllColors(us);
	}
	OEUnitsUpdateEntropy(us);
	OEUnitsTick(us);
	oe_units_tick++;
	OEUnitsBuildAnimate(us, g, f);
	OEUnitsCompleteInanimateConstruction(us, map);
	OEUnitsManagePathFinding(us, g, map, f);
	OEUnitsUpdateAllMotives(us);
	OEUnitsDecay(us);
	OEUnitsExpire(us);
	OEUnitsFlagTheDead(us, g, map);
	OEUnitsRemoveGarbage(us);
	OEUnitsTriggerTriggers(us, g);
	OEUnitsManageStacks(us);
	OEUnitsPursue(us);
	OEUnitsCountAllPopulations(us);
}

U0 OEUnitsFloat(COEUnits *floats, COEUnits *us, COEOverview *ov, COEGrid *g,
	COEMap *map, COEMotive *motive)
{
	floats->count = 0;
	floats->share[floats->color].status.age =
		us->share[us->color].status.age;
	MemCopy(&floats->share[floats->color].motive, motive, sizeof(COEMotive));
	OEUnitsResetStacks(floats);
	if (OEUnitsEvent(ov, OEEV_KEY_LALT))
	{
		OEUnitsUseIcon(floats, ov, g, map, TRUE, FALSE);
	}
	OEUnitsStackStacks(floats);
}

// ----------------------------------------------------------------- parity
//
// the lockstep hash. every peer computes this at the end of a cycle and the
// host compares. unit->file is the port graphics id rather than the drs file
// id, which is consistent because both peers run this tree.

U0 OEUnitsResetTiled(COEUnits *us)
{
	I64 i;

	for (i = 0; i < us->count; i++)
	{
		us->unit[i].is_already_tiled = FALSE;
	}
}

U64 OEUnitsXor(COEUnits *us)
{
	COEUnit	  *u;
	COEStatus *status;
	U64		   parity = 0;
	U64		   flat;
	I64		   i;

	for (i = 0; i < us->count; i++)
	{
		u    = &us->unit[i];
		flat = OEPtFlatten(&u->cell);
		parity ^= flat + u->id + u->file + u->health;
	}
	for (i = 0; i < OECLR_COUNT; i++)
	{
		status = &us->share[i].status;
		parity ^= (status->age << 60) | (status->population << 48) |
			(status->food << 36) | (status->wood << 24) |
			(status->gold << 12) | status->stone;
	}
	return parity;
}

COEUnit *OEUnitsGetFirstTownCenter(COEUnits *us)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->color == us->color && u->trait.type == OET_TOWN_CENTER)
		{
			return u;
		}
	}
	return NULL;
}

U0 OEUnitsGetFirstTownCenterPan(COEUnits *us, COEGrid *g, COEPoint *out)
{
	COEPoint cart;
	COEUnit	*u = OEUnitsGetFirstTownCenter(us);

	OEPtSet(out, 0, 0);
	if (u)
	{
		OEUnitGetShift(u, &u->cart, &cart);
		OEGridCartToPan(g, out, &cart);
	}
}

// --------------------------------------------------------------- generate

U0 OEUnitsGenerateVillagers(COEUnits *us, COEMap *map, COEGrid *g,
	COEPoint *slot, I64 color)
{
	COEButton button;
	COEParts  villager;
	COEPoint  zero;
	COEPoint  shift;
	COEPoint  cart;
	I64		  i;

	button.icon_type = OEICON_UNIT;
	button.index     = OEIU_MALE_VILLAGER;
	button.trigger   = OETRG_NONE;
	OEPartsFromButton(&villager, &button, us->share[color].status.age);
	OEPtSet(&zero, 0, 0);
	for (i = 0; i < OE_START_VILLAGERS; i++)
	{
		OEPtSet(&shift, -2, 1 + i);
		OEPtAdd(&cart, slot, &shift);
		OEUnitsSpawnParts(us, &cart, &zero, g, color, map, FALSE, &villager,
			FALSE, OETRG_NONE, FALSE);
	}
}

#define OE_FACET_TREE	0
#define OE_FACET_GOLD	1
#define OE_FACET_STONE	2
#define OE_FACET_BERRY	3
#define OE_FACET_COUNT	8

class COEFacet
{
	COEPoint point;
	I64		 kind;
};

//eight facets at OE_START_TREE_TILES from the town centre. gold sits north,
//stone west and the berries north east; the rest is forest.
COEFacet oe_facet[OE_FACET_COUNT] = {
	{{ OE_START_TREE_TILES,  0                  }, OE_FACET_TREE},
	{{ 0,                    OE_START_TREE_TILES}, OE_FACET_TREE},
	{{ OE_START_TREE_TILES,  OE_START_TREE_TILES}, OE_FACET_TREE},
	{{ 0,                   -OE_START_TREE_TILES}, OE_FACET_GOLD},
	{{-OE_START_TREE_TILES,  0                  }, OE_FACET_STONE},
	{{-OE_START_TREE_TILES, -OE_START_TREE_TILES}, OE_FACET_TREE},
	{{-OE_START_TREE_TILES,  OE_START_TREE_TILES}, OE_FACET_TREE},
	{{ OE_START_TREE_TILES, -OE_START_TREE_TILES}, OE_FACET_BERRY}
};

U0 OEUnitsGenerateStartingResources(COEUnits *us, COEMap *map, COEGrid *g,
	COEPoint *slot)
{
	COEParts parts;
	COEPoint zero;
	COEPoint cart;
	COEPoint shift;
	I64		 spread = OE_START_TREE_RANDOM + 1;
	I64		 sx;
	I64		 sy;
	I64		 i;

	OEPtSet(&zero, 0, 0);
	for (i = 0; i < OE_FACET_COUNT; i++)
	{
		OEPartsGetForestTree(&parts);
		if (oe_facet[i].kind == OE_FACET_GOLD)
		{
			OEPartsGetGoldMine(&parts);
		}
		if (oe_facet[i].kind == OE_FACET_STONE)
		{
			OEPartsGetStoneMine(&parts);
		}
		if (oe_facet[i].kind == OE_FACET_BERRY)
		{
			OEPartsGetBerryBush(&parts);
		}
		OEPtAdd(&cart, slot, &oe_facet[i].point);
		sx = OERand() % spread;
		sy = OERand() % spread;
		OEPtSet(&shift, sx, sy);
		OEPtAdd(&cart, &cart, &shift);
		OEUnitsSpawnParts(us, &cart, &zero, g, OECLR_GAIA, map, FALSE,
			&parts, FALSE, OETRG_NONE, FALSE);
	}
}

//the spectator holds a colour slot but owns no town centre
U0 OEUnitsGenerateTownCenters(COEUnits *us, COEMap *map, COEGrid *g,
	I64 users, I64 spectator)
{
	COEButton button;
	COEParts  towncenter;
	COEPoints points;
	COEPoint  zero;
	COEPoint  slot;
	I64		  players = users - 1;
	I64		  index;
	I64		  i;

	if (players < 1)
	{
		return;
	}
	button.icon_type = OEICON_BUILD;
	button.index     = OEIB_TOWN_CENTER;
	button.trigger   = OETRG_NONE;
	OEPtSet(&zero, 0, 0);
	OEMapSlots(map, &points);
	for (i = 0; i < players; i++)
	{
		if (i != spectator)
		{
			OEPartsFromButton(&towncenter, &button,
				us->share[i].status.age);
			index = (i * points.count) / players;
			OEPtCopy(&slot, &points.point[index]);
			OEUnitsSpawnParts(us, &slot, &zero, g, i, map, FALSE,
				&towncenter, FALSE, OETRG_NONE, FALSE);
			OEUnitsGenerateVillagers(us, map, g, &slot, i);
			OEUnitsGenerateStartingResources(us, map, g, &slot);
		}
	}
	OEPointsFree(&points);
}

U0 OEUnitsGenerate(COEUnits *us, COEMap *map, COEGrid *g, I64 users,
	I64 spectator)
{
	if (users > 1)
	{
		OEUnitsGenerateTownCenters(us, map, g, users, spectator);
	}
}

// ---------------------------------------------------------------- restore

U0 OEUnitsPackRestore(COEUnits *us, I64 cycles, COERestore *out)
{
	I64 i;

	out->unit               = us->unit;
	out->count              = us->count;
	out->cycles             = cycles;
	out->id_next            = OEUnitGetIdNext();
	out->command_group_next = OEUnitGetCommandGroupNext();
	out->is_success         = TRUE;
	for (i = 0; i < OECLR_COUNT; i++)
	{
		MemCopy(&out->share[i], &us->share[i], sizeof(COEShare));
	}
}

U0 OEUnitsRestorePaths(COEUnits *us, COEGrid *g, COEField *f)
{
	COEUnit *u;
	I64		 i;

	for (i = 0; i < us->count; i++)
	{
		u = &us->unit[i];
		if (u->must_repath_with_recover)
		{
			OEUnitsFindPath(us, u, &u->cart_goal, &u->cart_grid_offset_goal,
				g, f, TRUE);
			u->must_repath_with_recover = FALSE;
		}
	}
}

//the wire carries no path, so the copied Points pointer belongs to the
//sender. OEUnitsFreeAllPathsForRecovery runs before the pack, which leaves
//it NULL, and clearing it here keeps a stale pointer out of the heap.
U0 OEUnitsUnpackRestore(COEUnits *us, COERestore *r)
{
	I64 i;

	if (!r->is_success)
	{
		"OpenEmpire: restore incomplete, short read\n";
		return;
	}
	us->count        = r->count;
	us->repath_index = 0;
	OEUnitSetIdNext(r->id_next);
	OEUnitSetCommandGroupNext(r->command_group_next);
	for (i = 0; i < us->count; i++)
	{
		MemCopy(&us->unit[i], &r->unit[i], sizeof(COEUnit));
		us->unit[i].path.point = NULL;
		us->unit[i].path.count = 0;
		us->unit[i].path.max   = 0;
	}
	for (i = 0; i < OECLR_COUNT; i++)
	{
		MemCopy(&us->share[i], &r->share[i], sizeof(COEShare));
	}
}

U0 OEUnitsApplyRestore(COEUnits *us, COERestore *r, COEGrid *g, COEField *f)
{
	I64 i;

	OEUnitsUnpackRestore(us, r);
	OEUnitsNullInterestPointers(us);
	OEUnitsResetPointers(us);
	OEUnitsManageStacks(us);
	OEUnitsEngageAllBoids(us, g);
	OEUnitsRestorePaths(us, g, f);
	for (i = 0; i < OECLR_COUNT; i++)
	{
		OEUnitsRecountSelected(us, i);
	}
}
