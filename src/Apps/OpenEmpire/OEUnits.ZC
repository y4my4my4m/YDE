// the unit container and the simulation cycle
//
// Units.c, plus the parts of Stack.c, Bits.c, Parts.c, Button.c and
// Buttons.c the cycle reaches into.
//
// upstream fans stressors, flow and the pointer rebuild across SDL threads.
// this runs them single threaded in index order, which removes a source of
// divergence rather than adding one.

// ------------------------------------------------------------------ stack

#define OE_STACK_INIT	8

U0 OEStackBuild(COEStack *s, I64 max)
{
	s->unit  = CAlloc(sizeof(COEUnit *) * max);
	s->count = 0;
	s->max   = max;
}

U0 OEStackFree(COEStack *s)
{
	if (s->unit)
	{
		Free(s->unit);
	}
	s->unit  = NULL;
	s->count = 0;
	s->max   = 0;
}

U0 OEStackAppend(COEStack *s, COEUnit *u)
{
	if (s->count == s->max)
	{
		s->max *= 2;
		s->unit = ReAlloc(s->unit, sizeof(COEUnit *) * s->max);
	}
	s->unit[s->count] = u;
	s->count++;
}

Bool OEStackIsWalkable(COEStack *s)
{
	I64 i;

	for (i = 0; i < s->count; i++)
	{
		if (!s->unit[i]->trait.is_walkable)
		{
			return FALSE;
		}
	}
	return TRUE;
}

// ------------------------------------------------------------------- bits

U64 OEBitsSet(U64 bits, I64 trigger)
{
	if (trigger == OETRG_NONE)
	{
		return bits;
	}
	return bits | (1 << trigger);
}

Bool OEBitsGet(U64 bits, I64 trigger)
{
	if (trigger == OETRG_NONE)
	{
		return FALSE;
	}
	return (bits >> trigger) & 1;
}

// ------------------------------------------------------------------ icons
//
// Icon.h. the values index the interfac icon sheets, so they are sparse and
// stay as they are. OEType numbers the icon types from zero, so a cleared
// button needs an explicit none.

#define OEICON_NONE		-1

#define OEIB_BARRACKS		2
#define OEIB_CASTLE			7
#define OEIB_MILL			19
#define OEIB_STABLE			23
