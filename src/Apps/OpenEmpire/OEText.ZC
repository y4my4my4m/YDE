//Video_Make's two Text_Build colours, snapped to the loaded palette. call
//after OEPalLoad.
I64 oe_text_red    = 0;
I64 oe_text_yellow = 0;

U0 OETextInit()
{
	oe_text_red    = OEPalNearest(0xFF, 0x00, 0x00);
	oe_text_yellow = OEPalNearest(0xFF, 0xFF, 0x00);
}

I64 OETextWidth(U8 *s, I64 scale)
{
	I64 n = 0;

	if (!s)
	{
		return 0;
	}
	while (s[n])
	{
		n++;
	}
	return n * OETEXT_W * scale;
}

U0 OETextPut(I64 x, I64 y, U8 *s, I64 index, I64 scale)
{
	I64 i = 0;
	I64 ch;
	I64 base;
	I64 row;
	I64 col;
	I64 bits;
	I64 px;
	I64 py;
	I64 sx;
	I64 sy;

	if (!s || scale < 1)
	{
		return;
	}

	while (s[i])
	{
		ch = s[i];
		if (ch >= OETEXT_FIRST && ch <= OETEXT_LAST)
		{
			base = (ch - OETEXT_FIRST) * OETEXT_ROWS;
			for (row = 0; row < OETEXT_ROWS; row++)
			{
				bits = oe_font[base + row];
				if (bits)
				{
					for (col = 0; col < OETEXT_COLS; col++)
					{
						if (bits & (0x80 >> col))
						{
							px = x + (i * OETEXT_W + col) * scale;
							py = y + row * scale;
							for (sy = 0; sy < scale; sy++)
							{
								for (sx = 0; sx < scale; sx++)
								{
									OEPlot(px + sx, py + sy, index,
										OE_PRIO_HIGHEST);
								}
							}
						}
					}
				}
			}
		}
		i++;
	}
}

//Text_Printf without the alpha, position and line arguments.
U0 OETextPrint(I64 x, I64 y, I64 index, I64 scale, U8 *fmt, ...)
{
	U8 buf[OETEXT_BUF];

	StrPrintJoin(buf, fmt, argc, argv);
	OETextPut(x, y, buf, index, scale);
}
