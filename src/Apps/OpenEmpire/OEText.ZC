	0x00,0x00,0xF8,0x00,0xF8,0x00,0x00,0x00,	//61
	0x40,0x20,0x10,0x08,0x10,0x20,0x40,0x00,	//62
	0x70,0x88,0x08,0x10,0x20,0x00,0x20,0x00,	//63
	0x70,0x88,0xB8,0xA8,0xB8,0x80,0x70,0x00,	//64
