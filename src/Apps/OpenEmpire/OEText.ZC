// bitmap text into the 8bpp canvas
//
// Text.c opens TerminusTTF through SDL_ttf twice in Video_Make: 24 px at
// 0x00FF0000 and 12 px at 0x00FFFF00. there is no TTF rasteriser here, so the
// two sizes become integer scales of one fixed cell font and the two colours
// become palette indices.
//
// cell format: ASCII 32..126, eight bytes per glyph, one byte per row, bit 7
// the leftmost column. ink occupies columns 0..4; columns 5..7 are always
// clear and carry the inter-glyph gap. rows 0..6 hold the cap height, row 7
// the descenders of g j p q y and the underscore.
//
// glyphs land through OEPlot at OE_PRIO_HIGHEST, above every sprite layer.
// OEClear resets the priority plane each frame and no two glyph cells of one
// string contest a pixel.
//
// Text_Puts' newline split and the five POSITION_* anchors are absent.
// callers place each line; OETextWidth measures.

#define OETEXT_W		6		//advance per glyph, scale 1
#define OETEXT_H		8		//cell height and line advance, scale 1
#define OETEXT_FIRST	32
#define OETEXT_LAST		126
#define OETEXT_GLYPHS	95		//OETEXT_LAST - OETEXT_FIRST + 1
#define OETEXT_ROWS		8		//bytes per glyph
#define OETEXT_COLS		8		//bits per row
#define OETEXT_BUF		256		//StrPrintJoin does not bound a supplied dst

//glyph n is ASCII OETEXT_FIRST + n; the trailing number is that code point.
U8 oe_font[OETEXT_GLYPHS * OETEXT_ROWS] = {
	0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,	//32
	0x20,0x20,0x20,0x20,0x20,0x00,0x20,0x00,	//33
	0x50,0x50,0x00,0x00,0x00,0x00,0x00,0x00,	//34
	0x50,0x50,0xF8,0x50,0xF8,0x50,0x50,0x00,	//35
	0x20,0x78,0xA0,0x70,0x28,0xF0,0x20,0x00,	//36
	0xC8,0xC8,0x10,0x20,0x40,0x98,0x98,0x00,	//37
	0x60,0x90,0xA0,0x40,0xA8,0x90,0x68,0x00,	//38
	0x20,0x20,0x00,0x00,0x00,0x00,0x00,0x00,	//39
	0x10,0x20,0x40,0x40,0x40,0x20,0x10,0x00,	//40
	0x40,0x20,0x10,0x10,0x10,0x20,0x40,0x00,	//41
	0x00,0x20,0xA8,0x70,0xA8,0x20,0x00,0x00,	//42
	0x00,0x20,0x20,0xF8,0x20,0x20,0x00,0x00,	//43
	0x00,0x00,0x00,0x00,0x00,0x30,0x30,0x20,	//44
	0x00,0x00,0x00,0xF8,0x00,0x00,0x00,0x00,	//45
	0x00,0x00,0x00,0x00,0x00,0x60,0x60,0x00,	//46
	0x08,0x08,0x10,0x20,0x40,0x80,0x80,0x00,	//47
	0x70,0x88,0x98,0xA8,0xC8,0x88,0x70,0x00,	//48
	0x20,0x60,0x20,0x20,0x20,0x20,0x70,0x00,	//49
	0x70,0x88,0x08,0x10,0x20,0x40,0xF8,0x00,	//50
	0xF8,0x10,0x30,0x08,0x08,0x88,0x70,0x00,	//51
	0x10,0x30,0x50,0x90,0xF8,0x10,0x10,0x00,	//52
