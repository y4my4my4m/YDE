// data-layer self check
//
// the expected numbers come from utils/drstool.py, which reads the archives
// on the host and decodes SLP rows straight out of openempire Scanline_Get:
//
//	python3 utils/drstool.py sums src/Apps/OpenEmpire/Data 6
//
// the sum is over palette indices of every opaque pixel at player colour 0.
// span kinds are folded back to what Scanline_Get would have produced, so a
// shadow counts as index 0 here even though the blitter darkens instead.

class COESumRef
{
	I64 which;
	I64 table;
	I64 file;
	I64 frames;
	I64 px;
	U32 sum;
};

#define OETEST_REFS		18

COESumRef oe_test_ref[OETEST_REFS] = {
	{OEREG_TERRAIN,  0, 0, 100, 235300, 26093118},
	{OEREG_TERRAIN,  0, 1, 100, 235300, 44395105},
	{OEREG_TERRAIN,  0, 2, 100, 235300, 44942994},
	{OEREG_TERRAIN,  0, 3,  36,  84708,  9527932},
	{OEREG_TERRAIN,  0, 4,  36,  84708,  8864291},
	{OEREG_TERRAIN,  0, 5, 100, 235300, 33067797},
	{OEREG_GRAPHICS, 0, 0,  50,  40667,  2015906},
	{OEREG_GRAPHICS, 0, 1,  50,  44377,  2306380},
	{OEREG_GRAPHICS, 0, 2,  52,  42564,  2111062},
	{OEREG_GRAPHICS, 0, 3,  25,   9497,   889776},
	{OEREG_GRAPHICS, 0, 4,  50,  33320,  1456502},
	{OEREG_GRAPHICS, 0, 5,   1,  36647,  2896163},
	{OEREG_INTERFAC, 1, 0,   1, 480000, 76337685},
	{OEREG_INTERFAC, 1, 1,   1, 480000, 79235081},
	{OEREG_INTERFAC, 1, 2,   1, 480000, 79188664},
	{OEREG_INTERFAC, 1, 3,   1,  26685,    11340},
	{OEREG_INTERFAC, 1, 4,   1,  20000,  3799400},
	{OEREG_INTERFAC, 1, 5,   1, 480000, 61376026}
};

//walks the decoded spans of one archive and reproduces the reference sum
U0 OETestSum(COESlp *slp, I64 *_px, U32 *_sum)
{
	I64		  fi;
	I64		  row;
	I64		  i;
	I64		  sx;
	I64		  len;
	I64		  kind;
	I64		  j;
	I64		  px  = 0;
	U32		  sum = 0;
	U8		 *s;
	COEFrame *f;

	for (fi = 0; fi < slp->num_frames; fi++)
	{
		f = &slp->frame[fi];
		if (f->span)
		{
			for (row = 0; row < f->h; row++)
			{
				if (f->row[row] >= 0)
				{
					i = f->row[row];
					s = f->span;
					while (TRUE)
					{
						sx = s[i] | (s[i + 1] << 8);
						if (sx == OESLP_ROW_END)
							break;
						len  = s[i + 2] | (s[i + 3] << 8);
						kind = s[i + 4];
						i += 5;

						for (j = 0; j < len; j++)
						{
							px++;
							//Scanline_Get emits index 0 for a shadow and
							//base + byte for player colour, at colour 0
							if (kind == OESLP_KIND_PLAYER)
								sum += s[i + j] + OEPalPlayerBase(0);
							else if (kind == OESLP_KIND_NORMAL)
								sum += s[i + j];
						}

						if (kind != OESLP_KIND_SHADOW)
							i += len;
					}
				}
			}
		}
	}

	*_px  = px;
	*_sum = sum & 0xFFFFFFFF;
}

U8 *OETestDrsName(I64 which)
{
	if (which == OEREG_GRAPHICS)
		return "graphics";
	if (which == OEREG_INTERFAC)
		return "interfac";
	return "terrain";
}

I64 OETestAssets()
{
	I64			 i;
	I64			 px;
	I64			 fail = 0;
	U32			 sum;
	U32			 psum = 0;
	COESlp		*slp;
	COESumRef	*r;

	"\n$$LTBLUE$$OpenEmpire data-layer check$$FG$$\n";

	if (!oe_drs_graphics.loaded || !oe_drs_interfac.loaded ||
		!oe_drs_terrain.loaded)
	{
		"  $$RED$$archives not mounted$$FG$$\n";
		return 1;
	}

	"  graphics.drs tables=%d files=%d\n", oe_drs_graphics.table_count,
		OEDrsNumFiles(&oe_drs_graphics, 0);
	"  interfac.drs tables=%d files=%d\n", oe_drs_interfac.table_count,
		OEDrsNumFiles(&oe_drs_interfac, 0) + OEDrsNumFiles(&oe_drs_interfac, 1) +
		OEDrsNumFiles(&oe_drs_interfac, 2);
	"  terrain.drs  tables=%d files=%d\n", oe_drs_terrain.table_count,
		OEDrsNumFiles(&oe_drs_terrain, 0);
	"  sounds.drs   files=%d\n", OEDrsNumFiles(&oe_drs_sounds, 0);

	for (i = 0; i < OEPAL_COUNT; i++)
		psum += oe_argb[i] & 0xFFFFFF;
	psum &= 0xFFFFFFFF;
	if (oe_pal_count == 256 && psum == 1967087977)
		"  palette      $$GREEN$$ok$$FG$$   count=%d sum=%u\n", oe_pal_count, psum;
	else
	{
		"  palette      $$RED$$BAD$$FG$$  count=%d sum=%u want 1967087977\n",
			oe_pal_count, psum;
		fail++;
	}

	for (i = 0; i < OETEST_REFS; i++)
	{
		r   = &oe_test_ref[i];
		slp = OERegGet(r->which, r->table, r->file);
		if (!slp || !slp->ok)
		{
			"  %-8s t%d f%-2d $$RED$$missing$$FG$$\n",
				OETestDrsName(r->which), r->table, r->file;
			fail++;
		}
		else
		{
			OETestSum(slp, &px, &sum);
			if (slp->num_frames == r->frames && px == r->px && sum == r->sum)
			{
				"  %-8s t%d f%-2d $$GREEN$$ok$$FG$$   frames=%-4d px=%-7d sum=%u\n",
					OETestDrsName(r->which), r->table, r->file,
					slp->num_frames, px, sum;
			}
			else
			{
				"  %-8s t%d f%-2d $$RED$$BAD$$FG$$  frames=%d/%d px=%d/%d sum=%u/%u\n",
					OETestDrsName(r->which), r->table, r->file,
					slp->num_frames, r->frames, px, r->px, sum, r->sum;
				fail++;
			}
		}
	}

	return fail;
}

I64 OETestPath()
{
	COEField	field;
	COEPoints	path;
	COEPoint	a;
	COEPoint	b;
	I64			i;
	I64			fail = 0;

	"\n$$LTBLUE$$path check$$FG$$\n";

	OEFieldMake(&field, 16);
	OEFieldClear(&field);
	for (i = 0; i < field.area; i++)
		field.object[i] = OEFIELD_WALKABLE;

	//a wall across the middle with one gap
	for (i = 0; i < 15; i++)
	{
		a.x = i;
		a.y = 8;
		OEFieldSet(&field, &a, OEFIELD_OBSTRUCT);
	}

	OEPtSet(&a, 1, 1);
	OEPtSet(&b, 1, 14);
	OEFieldPathAStar(&field, &path, &a, &b);

	if (path.count > 1 && path.point[0].x == a.x && path.point[0].y == a.y &&
		path.point[path.count - 1].x == b.x &&
		path.point[path.count - 1].y == b.y)
		"  around wall  $$GREEN$$ok$$FG$$   steps=%d\n", path.count;
	else
	{
		"  around wall  $$RED$$BAD$$FG$$  steps=%d\n", path.count;
		fail++;
	}
	OEPointsFree(&path);

	//sealing the gap makes the goal unreachable
	a.x = 15;
	a.y = 8;
	OEFieldSet(&field, &a, OEFIELD_OBSTRUCT);
	OEPtSet(&a, 1, 1);
	OEFieldPathAStar(&field, &path, &a, &b);
	if (!path.count)
		"  sealed       $$GREEN$$ok$$FG$$   no path\n";
	else
	{
		"  sealed       $$RED$$BAD$$FG$$  steps=%d\n", path.count;
		fail++;
	}
	OEPointsFree(&path);

	OEFieldFree(&field);
	return fail;
}

I64 OETestGrid()
{
	COEPoint cart;
	COEPoint iso;
	COEPoint back;
	I64		 i;
	I64		 fail = 0;

	"\n$$LTBLUE$$grid check$$FG$$\n";

	//the iso transform halves y, so only even cart points round trip
	for (i = -64; i <= 64; i += 2)
	{
		OEPtSet(&cart, i, -i);
		OEPtToIso(&iso, &cart);
		OEPtToCart(&back, &iso);
		if (!OEPtEqual(&back, &cart))
		{
			"  round trip   $$RED$$BAD$$FG$$  (%d,%d) -> (%d,%d) -> (%d,%d)\n",
				cart.x, cart.y, iso.x, iso.y, back.x, back.y;
			fail++;
			break;
		}
	}
	if (!fail)
		"  round trip   $$GREEN$$ok$$FG$$\n";

	return fail;
}

U0 OETest()
{
	I64 fail = 0;

	fail += OETestAssets;
	fail += OETestGrid;
	fail += OETestPath;

	if (!fail)
		"\n$$GREEN$$all checks passed$$FG$$\n\n";
	else
		"\n$$RED$$%d check(s) failed$$FG$$\n\n", fail;
}
