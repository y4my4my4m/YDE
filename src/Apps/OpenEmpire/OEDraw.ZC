// 8bpp canvas, the span blitter and the window blit
//
// game code writes palette indices into oe_screen and a priority byte into
// oe_zbuf. openempire keeps priority in the alpha byte of an ARGB texture,
// which an indexed canvas cannot carry, so the two planes are parallel here.
//
// the row stride is the constant OE_W_MAX, never oe_w; oe_w and oe_h are the
// active canvas size and only clip.

#define OE_W_MAX	1600
#define OE_H_MAX	1200
#define OE_W_DEF	1024
#define OE_H_DEF	768

//File.h FILE_PRIO_*. the z byte, not a draw order: the painter's sort puts
//tiles in order and this only decides which layer may overwrite which.
#define OE_PRIO_NONE		0
#define OE_PRIO_TERRAIN		1
#define OE_PRIO_SHADOW		2
#define OE_PRIO_DECAY		3
#define OE_PRIO_BUILDING	4
#define OE_PRIO_UNIT		5
#define OE_PRIO_HIGHEST		255

U8	*oe_screen = NULL;
U8	*oe_zbuf   = NULL;
I64	 oe_w      = OE_W_DEF;
I64	 oe_h      = OE_H_DEF;
Bool oe_ready  = FALSE;

//window-space rectangle the canvas last landed in, for mouse mapping
I64	 oe_blit_x = 0;
I64	 oe_blit_y = 0;
I64	 oe_blit_w = OE_W_DEF;
I64	 oe_blit_h = OE_H_DEF;
Bool oe_opt_fit = FALSE;

Bool OEDrawInit()
{
	if (!oe_screen)
		oe_screen = CAlloc(OE_W_MAX * OE_H_MAX);
	if (!oe_zbuf)
		oe_zbuf = CAlloc(OE_W_MAX * OE_H_MAX);
	return oe_screen != NULL && oe_zbuf != NULL;
}

U0 OEDrawFree()
{
	if (oe_screen)
		Free(oe_screen);
	if (oe_zbuf)
		Free(oe_zbuf);
	oe_screen = NULL;
	oe_zbuf   = NULL;
}

U0 OEClear(I64 index)
{
	I64 y;

	if (!oe_screen)
		return;
	for (y = 0; y < oe_h; y++)
	{
		MemSet(oe_screen + y * OE_W_MAX, index, oe_w);
		MemSet(oe_zbuf   + y * OE_W_MAX, 0, oe_w);
	}
}

U0 OESetSize(I64 w, I64 h)
{
	oe_w = OEClamp(w, 320, OE_W_MAX);
	oe_h = OEClamp(h, 240, OE_H_MAX);
}

//TransferTilePixel: strictly greater, so a layer never overdraws its own
//priority. terrain is drawn after units for that reason - it only reaches
//pixels no sprite claimed.
U0 OEPlot(I64 x, I64 y, I64 index, I64 z)
{
	I64 p;

	if (x < 0 || x >= oe_w || y < 0 || y >= oe_h)
		return;
	p = y * OE_W_MAX + x;
	if (z <= oe_zbuf[p])
		return;
	oe_screen[p] = index;
	oe_zbuf[p]   = z;
}

//overlays (selection ellipses, health bars, boxes, cursor) sit above
//anything below OE_PRIO_DECAY and stamp OE_PRIO_HIGHEST.
U0 OEPlotUI(I64 x, I64 y, I64 index)
{
	I64 p;

	if (x < 0 || x >= oe_w || y < 0 || y >= oe_h)
		return;
	p = y * OE_W_MAX + x;
	if (oe_zbuf[p] >= OE_PRIO_DECAY)
		return;
	oe_screen[p] = index;
	oe_zbuf[p]   = OE_PRIO_HIGHEST;
}

U0 OEFillRect(I64 x, I64 y, I64 w, I64 h, I64 index, I64 z)
{
	I64 xi;
	I64 yi;

	for (yi = y; yi < y + h; yi++)
		for (xi = x; xi < x + w; xi++)
			OEPlot(xi, yi, index, z);
}

U0 OEDrawRect(I64 x, I64 y, I64 w, I64 h, I64 index, I64 z)
{
	I64 i;

	for (i = 0; i < w; i++)
	{
		OEPlot(x + i, y, index, z);
		OEPlot(x + i, y + h - 1, index, z);
	}
	for (i = 0; i < h; i++)
	{
		OEPlot(x, y + i, index, z);
		OEPlot(x + w - 1, y + i, index, z);
	}
}

U0 OEDrawLine(I64 x0, I64 y0, I64 x1, I64 y1, I64 index, I64 z)
{//Bresenham
	I64 dx = OEAbs(x1 - x0);
	I64 dy = -OEAbs(y1 - y0);
	I64 sx = -1;
	I64 sy = -1;
	I64 err;
	I64 e2;

	if (x0 < x1)
		sx = 1;
	if (y0 < y1)
		sy = 1;
	err = dx + dy;

	while (TRUE)
	{
		OEPlot(x0, y0, index, z);
		if (x0 == x1 && y0 == y1)
			break;
		e2 = 2 * err;
		if (e2 >= dy)
		{
			err += dy;
			x0  += sx;
		}
		if (e2 <= dx)
		{
			err += dx;
			y0  += sy;
		}
	}
}

// ---------------------------------------------------------- span blitter
//
// x,y is where the frame's hotspot lands. spans carry the kind recorded at
// decode: NORMAL writes the stored index, PLAYER adds the colour band base,
// SHADOW darkens whatever the canvas already holds through oe_shade.

U0 OEBlitFrame(COEFrame *f, I64 x, I64 y, I64 color, I64 z, Bool flip,
	Bool floating)
{
	I64	 base = OEPalPlayerBase(color);
	I64	 ox   = x - f->hx;
	I64	 oy   = y - f->hy;
	I64	 row;
	I64	 i;
	I64	 sx;
	I64	 len;
	I64	 kind;
	I64	 px;
	I64	 py;
	I64	 p;
	I64	 j;
	I64	 v;
	I64	 under;
	U8	*s;

	if (!f || !f->span || !oe_screen)
		return;

	//a flipped frame pivots about the hotspot, not the left edge
	if (flip)
		ox = x - (f->w - 1 - f->hx);

	for (row = 0; row < f->h; row++)
	{
		py = oy + row;
		if (f->row[row] >= 0 && py >= 0 && py < oe_h)
		{
			i = f->row[row];
			s = f->span;

			while (TRUE)
			{
				sx = s[i] | (s[i + 1] << 8);
				if (sx == OESLP_ROW_END)
					break;
				len  = s[i + 2] | (s[i + 3] << 8);
				kind = s[i + 4];
				i += 5;

				for (j = 0; j < len; j++)
				{
					if (flip)
						px = ox + f->w - 1 - (sx + j);
					else
						px = ox + sx + j;

					if (px >= 0 && px < oe_w)
					{
						p     = py * OE_W_MAX + px;
						under = oe_zbuf[p];
						if (z > under)
						{
							if (kind == OESLP_KIND_SHADOW)
								v = oe_shade[oe_screen[p]];
							else
							{
								v = s[i + j];
								if (kind == OESLP_KIND_PLAYER)
									v += base;
								v &= 0xFF;
								//TransferTilePixel: half over a building,
								//over a shadow, or when this tile floats
								if (under == OE_PRIO_BUILDING ||
									under == OE_PRIO_SHADOW || floating)
									v = oe_blend[v * OEPAL_COUNT + oe_screen[p]];
							}
							oe_screen[p] = v;
							oe_zbuf[p]   = z;
						}
					}
				}

				if (kind != OESLP_KIND_SHADOW)
					i += len;
			}
		}
	}
}

//outline pass: the silhouette an occluded unit shows through a building.
U0 OEBlitFrameFlat(COEFrame *f, I64 x, I64 y, I64 index, I64 z, Bool flip)
{
	I64	 ox = x - f->hx;
	I64	 oy = y - f->hy;
	I64	 row;
	I64	 i;
	I64	 sx;
	I64	 len;
	I64	 kind;
	I64	 px;
	I64	 py;
	I64	 j;
	U8	*s;

	if (!f || !f->span || !oe_screen)
		return;

	if (flip)
		ox = x - (f->w - 1 - f->hx);

	for (row = 0; row < f->h; row++)
	{
		py = oy + row;
		if (f->row[row] >= 0 && py >= 0 && py < oe_h)
		{
			i = f->row[row];
			s = f->span;

			while (TRUE)
			{
				sx = s[i] | (s[i + 1] << 8);
				if (sx == OESLP_ROW_END)
					break;
				len  = s[i + 2] | (s[i + 3] << 8);
				kind = s[i + 4];
				i += 5;

				if (kind != OESLP_KIND_SHADOW)
				{
					for (j = 0; j < len; j++)
					{
						if (flip)
							px = ox + f->w - 1 - (sx + j);
						else
							px = ox + sx + j;
						OEPlot(px, py, index, z);
					}
					i += len;
				}
			}
		}
	}
}

// ------------------------------------------------------------ window blit

U0 OEBlitFit(CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w, I64 dst_h)
{
	U8	*src;
	U32	*dst;
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 pitch = dc->width_internal;

	if (dst_w < 1 || dst_h < 1)
		return;

	sx_step = (oe_w << 16) / dst_w;
	sy_step = (oe_h << 16) / dst_h;

	for (y = 0; y < dst_h; y++)
	{
		py = dst_y + y;
		if (py >= 0 && py < dc->height)
		{
			sy = (y * sy_step) >> 16;
			if (sy >= oe_h)
				sy = oe_h - 1;

			src = oe_screen + sy * OE_W_MAX;
			dst = dc->body + py * pitch;
			sxf = 0;

			for (x = 0; x < dst_w; x++)
			{
				if (dst_x + x >= 0 && dst_x + x < dc->width)
					dst[dst_x + x] = oe_argb[src[sxf >> 16]];
				sxf += sx_step;
			}
		}
	}
}

U0 OEDrawIt(CTask *task, CDC *dc)
{
	I64 w;
	I64 h;
	I64 bw;
	I64 bh;

	no_warn task;

	if (!oe_ready || !oe_screen || !oe_pal_loaded)
		return;

	w = dc->width;
	h = dc->height;

	if (oe_opt_fit)
	{
		bw = w;
		bh = h;
	}
	else
	{
		bw = w;
		bh = (w * oe_h) / oe_w;
		if (bh > h)
		{
			bh = h;
			bw = (h * oe_w) / oe_h;
		}
	}

	oe_blit_x = (w - bw) / 2;
	oe_blit_y = (h - bh) / 2;
	oe_blit_w = bw;
	oe_blit_h = bh;

	OEBlitFit(dc, oe_blit_x, oe_blit_y, bw, bh);
}

I64 OEMouseX()
{
	I64 mx = mouse.pos.x - Fs->pix_left - Fs->scroll_x;
	I64 v;

	if (oe_blit_w < 1)
		return 0;
	v = ((mx - oe_blit_x) * oe_w) / oe_blit_w;
	return OEClamp(v, 0, oe_w - 1);
}

I64 OEMouseY()
{
	I64 my = mouse.pos.y - Fs->pix_top - Fs->scroll_y;
	I64 v;

	if (oe_blit_h < 1)
		return 0;
	v = ((my - oe_blit_y) * oe_h) / oe_blit_h;
	return OEClamp(v, 0, oe_h - 1);
}
