// integer point maths and the cart / iso / cell / tile transforms
//
// ZealC has no struct return, so every Point.c constructor becomes a write
// through an out pointer. aliasing the output with an input is safe: each
// helper reads both inputs before it writes.
//
// coordinate spaces, after Point.c and Grid.c:
//	cart	pixel space, axis aligned, what the simulation integrates in
//	iso		screen space, cart rotated 45 degrees and halved in y
//	cell	cart scaled by OE_CELL_SIZE, the pathing lattice
//	tile	map indices, cart divided by tile_cart_width / _height
//
// division truncates toward zero on both x86 idiv and C, so the negative
// halves of the iso transform round the same way as the reference.

#define OE_CELL_SIZE	100		//CONFIG_GRID_CELL_SIZE

class COEPoint
{
	I64 x;
	I64 y;
};

U0 OEPtSet(COEPoint *o, I64 x, I64 y)
{
	o->x = x;
	o->y = y;
}

U0 OEPtCopy(COEPoint *o, COEPoint *a)
{
	o->x = a->x;
	o->y = a->y;
}

Bool OEPtEqual(COEPoint *a, COEPoint *b)
{
	return a->x == b->x && a->y == b->y;
}

Bool OEPtIsZero(COEPoint *a)
{
	return !a->x && !a->y;
}

U0 OEPtAdd(COEPoint *o, COEPoint *a, COEPoint *b)
{
	I64 x = a->x + b->x;
	I64 y = a->y + b->y;

	o->x = x;
	o->y = y;
}

U0 OEPtSub(COEPoint *o, COEPoint *a, COEPoint *b)
{
	I64 x = a->x - b->x;
	I64 y = a->y - b->y;

	o->x = x;
	o->y = y;
}

U0 OEPtMul(COEPoint *o, COEPoint *a, I64 n)
{
	I64 x = a->x * n;
	I64 y = a->y * n;

	o->x = x;
	o->y = y;
}

U0 OEPtDiv(COEPoint *o, COEPoint *a, I64 n)
{
	I64 x;
	I64 y;

	if (!n)
		n = 1;
	x = a->x / n;
	y = a->y / n;
	o->x = x;
	o->y = y;
}

U0 OEPtToIso(COEPoint *o, COEPoint *cart)
{
	I64 x = cart->x + cart->y;
	I64 y = -(cart->x - cart->y) / 2;

	o->x = x;
	o->y = y;
}

U0 OEPtToCart(COEPoint *o, COEPoint *iso)
{
	I64 x = -(2 * iso->y - iso->x) / 2;
	I64 y =  (2 * iso->y + iso->x) / 2;

	o->x = x;
	o->y = y;
}

I64 OEPtMag(COEPoint *a)
{
	return OESqrt(a->x * a->x + a->y * a->y);
}

U0 OEPtNormalize(COEPoint *o, COEPoint *a, I64 normal)
{
	I64 mag = OEPtMag(a);

	OEPtMul(o, a, normal);
	OEPtDiv(o, o, mag);
}

//Point_Slope: approaches 1 as x goes to zero
I64 OEPtSlope(COEPoint *a)
{
	if (!a->x)
		return a->y;
	return a->y / a->x;
}

Bool OEPtIsEven(COEPoint *a)
{
	return !(a->x % 2) && !(a->y % 2);
}

U64 OEPtFlatten(COEPoint *a)
{
	return ((a->y & 0xFFFFFFFF) << 32) | (a->x & 0xFFFFFFFF);
}

U0 OEPtRand(COEPoint *o)
{
	I64 x = OERand();
	I64 y = OERand();

	o->x = x;
	o->y = y;
}

// -------------------------------------------------------------------- grid

class COEGrid
{
	I64		 size;				//map edge in tiles
	I64		 tile_iso_width;
	I64		 tile_iso_height;
	I64		 tile_cart_width;
	I64		 tile_cart_height;
	COEPoint tile_cart_mid;
};

U0 OEGridMake(COEGrid *g, I64 size, I64 tile_iso_width, I64 tile_iso_height)
{//Grid_Make: the cart tile extent falls out of unprojecting the iso diamond
	COEPoint iso;
	COEPoint a;
	COEPoint b;
	COEPoint c;

	g->size            = size;
	g->tile_iso_width  = tile_iso_width;
	g->tile_iso_height = tile_iso_height;

	OEPtSet(&iso, 0, -tile_iso_height / 2);
	OEPtToCart(&a, &iso);
	OEPtSet(&iso, 0, tile_iso_height / 2);
	OEPtToCart(&b, &iso);
	OEPtSet(&iso, tile_iso_width / 2, 0);
	OEPtToCart(&c, &iso);

	g->tile_cart_width  = c.x - b.x;
	g->tile_cart_height = c.y - a.y;
	g->tile_cart_mid.x  = g->tile_cart_width / 2;
	g->tile_cart_mid.y  = g->tile_cart_height / 2;
}

U0 OEGridPoint(COEGrid *g, COEPoint *o, COEPoint *tile)
{//Grid_GetGridPoint: tile index to the cart centre of that tile
	I64 x = tile->x * g->tile_cart_width;
	I64 y = tile->y * g->tile_cart_height;

	o->x = x + g->tile_cart_mid.x;
	o->y = y + g->tile_cart_mid.y;
}

U0 OEGridPointOffset(COEGrid *g, COEPoint *o, COEPoint *tile, COEPoint *offset)
{
	OEGridPoint(g, o, tile);
	OEPtAdd(o, o, offset);
}

U0 OEGridOffsetFromPoint(COEGrid *g, COEPoint *o, COEPoint *cart)
{//Grid_GetOffsetFromGridPoint
	I64 x = cart->x % g->tile_cart_width;
	I64 y = cart->y % g->tile_cart_height;

	o->x = x - g->tile_cart_mid.x;
	o->y = y - g->tile_cart_mid.y;
}

U0 OEGridCellToCart(COEGrid *g, COEPoint *o, COEPoint *cell)
{
	I64 x = (cell->x / OE_CELL_SIZE) / g->tile_cart_width;
	I64 y = (cell->y / OE_CELL_SIZE) / g->tile_cart_height;

	o->x = x;
	o->y = y;
}

U0 OEGridCartToCell(COEGrid *g, COEPoint *o, COEPoint *cart)
{
	I64 w = OE_CELL_SIZE * g->tile_cart_width;
	I64 h = OE_CELL_SIZE * g->tile_cart_height;

	o->x = w * cart->x + w / 2;
	o->y = h * cart->y + h / 2;
}

U0 OEGridCellToOffset(COEGrid *g, COEPoint *o, COEPoint *cell)
{
	I64 x = (cell->x / OE_CELL_SIZE) % g->tile_cart_width;
	I64 y = (cell->y / OE_CELL_SIZE) % g->tile_cart_height;

	o->x = x - g->tile_cart_mid.x;
	o->y = y - g->tile_cart_mid.y;
}

U0 OEGridCornerOffset(COEGrid *g, COEPoint *o, COEPoint *offset)
{
	OEPtAdd(o, offset, &g->tile_cart_mid);
}

U0 OEGridOffsetToCell(COEPoint *o, COEPoint *offset)
{
	OEPtMul(o, offset, OE_CELL_SIZE);
}

U0 OEGridCentre(COEGrid *g, COEPoint *o)
{
	o->x = (g->size * g->tile_cart_width) / 2;
	o->y = (g->size * g->tile_cart_height) / 2;
}

U0 OEGridPanToCart(COEGrid *g, COEPoint *o, COEPoint *pan)
{
	COEPoint cart;
	COEPoint centre;

	OEPtToCart(&cart, pan);
	OEGridCentre(g, &centre);
	OEPtAdd(&cart, &cart, &centre);
	o->x = cart.x / g->tile_cart_width;
	o->y = cart.y / g->tile_cart_height;
}

U0 OEGridCartToPan(COEGrid *g, COEPoint *o, COEPoint *cart)
{
	COEPoint scaled;
	COEPoint centre;

	scaled.x = cart->x * g->tile_cart_width;
	scaled.y = cart->y * g->tile_cart_height;
	OEGridCentre(g, &centre);
	OEPtSub(&scaled, &scaled, &centre);
	OEPtToIso(o, &scaled);
}

U0 OEGridRubbleShift(COEGrid *g, COEPoint *o)
{
	o->x = 0;
	o->y = -g->tile_cart_mid.y / 2;
}
