// main task and the client cycle
//
// mirrors main.c Play, with the socket pair replaced by OELocalExchange.
// the loop body is the same either way: build the field, hash the world,
// publish the overview, drain the packet ring, step the simulation, draw.
//
// OEUnitsGenerateTownCenters treats the last colour as the spectator and
// gives it nothing, so a solo game asks for two slots and occupies the
// first. the second never connects.

#define OE_DATA_DIR		"::/Apps/OpenEmpire/Data"

#define OE_SOLO_USERS		2
#define OE_SOLO_SPECTATOR	1
#define OE_SOLO_COLOR		OECLR_BLU

COEUnits	oe_units;
COEUnits	oe_floats;
COEMap		oe_map;
COEGrid		oe_grid;
COEField	oe_field;
COEOverview	oe_over;
COEPacket	oe_packet;

Bool oe_quit   = FALSE;
I64	 oe_cycles = 0;
Bool oe_built  = FALSE;

Bool OELoad()
{
	"OpenEmpire: mounting %s\n", OE_DATA_DIR;
	if (!OEDrsMount(OE_DATA_DIR))
	{
		"OpenEmpire: $$RED$$data missing$$FG$$. Copy the Age of Empires II\n";
		"Trial Data directory to %s and retry.\n", OE_DATA_DIR;
		return FALSE;
	}

	if (!OEPalLoad(0))
	{
		return FALSE;
	}

	OERegInit;
	if (!OEDrawInit)
	{
		return FALSE;
	}
	OETextInit;
	OEVideoInit;
	OESndInit;

	if (!OEMapMake(&oe_map))
	{
		"OpenEmpire: $$RED$$terrain extents unreadable$$FG$$\n";
		return FALSE;
	}

	OEGridMake(&oe_grid, oe_map.size, oe_map.tile_width, oe_map.tile_height);
	OEFieldMake(&oe_field, oe_map.size);

	"OpenEmpire: map %dx%d tile %dx%d\n", oe_map.size, oe_map.size,
		oe_map.tile_width, oe_map.tile_height;
	return TRUE;
}

//the world is built on New Game, not at load, so the title screen can be
//reached without one and a second New Game starts from a fresh seed.
U0 OEWorldFree()
{
	if (!oe_built)
	{
		return;
	}
	OEUnitsFree(&oe_floats);
	OEUnitsFree(&oe_units);
	oe_built = FALSE;
}

U0 OEWorldMake()
{
	OEWorldFree;

	OEUnitsMake(&oe_units, oe_grid.size, OE_UNITS_MAX, OE_SOLO_COLOR);
	OEUnitsMake(&oe_floats, oe_grid.size, OE_UNITS_FLOAT_BUFFER,
		OE_SOLO_COLOR);

	OEOverMake(&oe_over, oe_w, oe_h);
	oe_over.color     = OE_SOLO_COLOR;
	oe_over.users     = OE_SOLO_USERS;
	oe_over.spectator = OE_SOLO_SPECTATOR;

	//the seed is drawn once, before the first cycle, and every peer of a
	//match replays from it. Util_Srand(overview.seed) in main.c.
	oe_over.seed = counts.jiffies & 0xFFFF;
	OESrand(oe_over.seed);

	OEUnitsGenerate(&oe_units, &oe_map, &oe_grid, OE_SOLO_USERS,
		OE_SOLO_SPECTATOR);
	OEUnitsGetFirstTownCenterPan(&oe_units, &oe_grid, &oe_over.pan);

	OEPacketsMake;
	OELocalStart(oe_over.seed);
	oe_cycles = 0;
	oe_built  = TRUE;
}

U0 OECycle()
{
	COEPacket dequeued;
	U64		  parity;
	I64		  t0 = counts.jiffies;
	I64		  dt;

	OEFieldClear(&oe_field);
	OEUnitsField(&oe_units, &oe_map, &oe_field);

	parity = OEUnitsXor(&oe_units);
	OEOverUpdate(&oe_over, &oe_grid, parity, oe_cycles, OEPacketsSize,
		&oe_units.share[oe_units.color], 0);

	OELocalExchange(&oe_over, &oe_packet);
	if (oe_packet.turn > 0 && oe_packet.is_stable)
	{
		OEPacketsQueue(&oe_packet);
	}

	OEPacketsClearStale(oe_cycles);
	while (OEPacketsMustExecute(oe_cycles))
	{
		if (!OEPacketsDequeue(&dequeued))
		{
			break;
		}
		OEUnitsPacketService(&oe_units, &dequeued, &oe_grid, &oe_map,
			&oe_field);
	}

	OEUnitsCaretake(&oe_units, &oe_grid, &oe_map, &oe_field, FALSE);
	oe_cycles++;

	OEUnitsFloat(&oe_floats, &oe_units, &oe_over, &oe_grid, &oe_map,
		&oe_units.share[oe_units.color].motive);

	OEVideoDraw(&oe_units, &oe_floats, &oe_map, &oe_grid, &oe_over);
	dt = counts.jiffies - t0;
	OEVideoRender(&oe_units, &oe_over, &oe_map, dt, oe_cycles, 0);

	if (OEKeyEdge(SC_ESC, &oe_k_esc))
	{
		oe_menu_sel = 0;
		oe_state    = OEMS_PAUSE;
	}
}

//the pause page draws over the last game frame, so the world stays visible
//behind it. the sim does not step while paused.
U0 OEFrame()
{
	if (oe_state == OEMS_TITLE)
	{
		OEMenuDrawTitle;
		OEMenuInputTitle;
	}
	else if (oe_state == OEMS_OPTIONS)
	{
		OEMenuDrawOptions;
		OEMenuInputOptions;
	}
	else if (oe_state == OEMS_PAUSE)
	{
		OEMenuDrawPause;
		OEMenuInputPause;
		if (oe_state == OEMS_TITLE)
		{
			OEWorldFree;
		}
	}
	else if (oe_state == OEMS_GAME)
	{
		if (oe_menu_new)
		{
			oe_menu_new = FALSE;
			OEWorldMake;
		}
		if (oe_built)
		{
			OECycle;
		}
		else
		{
			oe_state = OEMS_TITLE;
		}
	}
}

U0 OpenEmpire()
{
	if (!OELoad)
	{
		return;
	}

	oe_quit     = FALSE;
	oe_state    = OEMS_TITLE;
	oe_menu_sel = 0;
	oe_ready    = TRUE;
	Fs->draw_it = &OEDrawIt;

	//DE.ZC DEBarRebuild lists only tasks carrying DISPLAYf_SHOW; set after
	//draw_it.
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinMax;
	WinFocus;

	while (!oe_quit)
	{
		OEFrame;
		if (oe_state == OEMS_QUIT)
		{
			oe_quit = TRUE;
		}
		Sleep(OE_LOOP_SPEED_MS);
	}

	oe_ready = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);

	OEWorldFree;
	OEFieldFree(&oe_field);
	OEMapFree(&oe_map);
	OESndFree;
	OEDrawFree;
	OEDrsUnmount;
}
