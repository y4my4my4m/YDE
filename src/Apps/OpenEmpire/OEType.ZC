#define OET_KNIGHT			11
#define OET_GOLD_MINE		12
#define OET_STONE_MINE		13
#define OET_MINING_CAMP		14
#define OET_MILL			15
#define OET_LUMBER_CAMP		16
#define OET_CASTLE			17
#define OET_BARRACKS		18
#define OET_STABLE			19
#define OET_HOUSE			20
#define OET_RUBBLE			21
#define OET_SCOUT			22
#define OET_LONG_SWORDSMAN	23
