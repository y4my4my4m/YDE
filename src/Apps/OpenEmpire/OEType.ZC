//
// one bit per control, in Event.h's declaration order so Event_GetIndex
// keeps its meaning.

#define OEEV_MOUSE_L		0x00000001
#define OEEV_MOUSE_R		0x00000002
#define OEEV_MOUSE_LD		0x00000004
#define OEEV_MOUSE_LU		0x00000008
#define OEEV_MOUSE_RD		0x00000010
#define OEEV_MOUSE_RU		0x00000020
#define OEEV_KEY_Q			0x00000040
#define OEEV_KEY_W			0x00000080
#define OEEV_KEY_E			0x00000100
#define OEEV_KEY_R			0x00000200
#define OEEV_KEY_T			0x00000400
#define OEEV_KEY_A			0x00000800
#define OEEV_KEY_S			0x00001000
#define OEEV_KEY_D			0x00002000
#define OEEV_KEY_F			0x00004000
#define OEEV_KEY_G			0x00008000
#define OEEV_KEY_Z			0x00010000
#define OEEV_KEY_X			0x00020000
#define OEEV_KEY_C			0x00040000
#define OEEV_KEY_V			0x00080000
#define OEEV_KEY_B			0x00100000
#define OEEV_KEY_1			0x00200000
#define OEEV_KEY_2			0x00400000
#define OEEV_KEY_3			0x00800000
#define OEEV_KEY_LSHIFT		0x01000000
#define OEEV_KEY_LALT		0x02000000
#define OEEV_TAB			0x04000000

//the fifteen icon-grid keys, in Event_GetIndex order
#define OEEV_ICON_COUNT		15

