// ----------------------------------------------------------------- status

class COEStatus
{
	I64 food;
	I64 gold;
	I64 stone;
	I64 wood;
	I64 population;
	I64 age;
};

class COEMotive
{
	I64 action;
	I64 type;
};

class COEResource
{
	I64 type;
	I64 amount;
};

//Bits/busy are research-completed and in-progress masks, one bit per
//trigger.
class COEShare
{
	COEStatus status;
	COEMotive motive;
	U64		  bits;
	U64		  busy;
	I64		  select_count;
};

// ------------------------------------------------------------------ trait
//
// Trait_Build reads these out of the FILE_X_GRAPHICS table for a Graphics
// id. cached on the unit so the table is consulted once per spawn.

class COETrait
{
	COEPoint dimensions;	//footprint in tiles
	I64		 type;
	I64		 max_speed;
	I64		 max_health;
	I64		 attack;
	I64		 width;			//collision width, melee reach
	I64		 action;
	I64		 upgrade;		//graphics id this morphs to on age up
	I64		 creator;		//type that trains or builds this
	Bool	 is_single_frame;
	Bool	 is_walkable;
	Bool	 is_multi_state;
	Bool	 is_inanimate;
	Bool	 is_resource;
	Bool	 can_expire;
	Bool	 is_detail;
};

// ------------------------------------------------------------------- unit

class COEUnit
{
	//identity and lifecycle
	I64		 id;
	I64		 command_group;
	I64		 parent_id;
	I64		 rally_id;
	I64		 interest_id;
	I64		 child_lock_id;
	I64		 child_count;
	I64		 garbage_collection_timer;

	//position and motion
	COEPoint cell;
	COEPoint cell_last;
	COEPoint cart;
	COEPoint cart_grid_offset;
	COEPoint cart_goal;
	COEPoint cart_grid_offset_goal;
	COEPoint cell_interest_inanimate;
	COEPoint velocity;

	//steering
	COEPoint group_alignment;
	COEPoint stressors;
	COEPoint entropy;
	I64		 entropy_static;

	//pathing
	COEPoints path;
	I64		 path_index;
	I64		 path_index_timer;

	//combat and state
	I64		 state;
	I64		 state_timer;
	I64		 dir;
	I64		 dir_timer;
	I64		 health;
	I64		 attack_frames_per_dir;
	I64		 fall_frames_per_dir;
	I64		 decay_frames_per_dir;
	I64		 expire_frames;

	//graphics
	I64		 file;			//graphics id
	I64		 color;
	I64		 trigger;
	I64		 grid_flash_timer;
	COETrait trait;

	//selection, one bit per colour
	U64		 is_selected_by;

	//flags
	Bool	 is_floating;
	Bool	 is_being_built;
	Bool	 must_garbage_collect;
	Bool	 is_state_locked;
	Bool	 is_engaged_in_melee;
	Bool	 was_wall_pushed;
	Bool	 has_direct;
	Bool	 has_children;
	Bool	 has_parent_lock;
	Bool	 must_skip_debris;
	Bool	 must_repath_with_recover;
	Bool	 using_aggro_move;
	Bool	 is_flash_on;
	Bool	 is_already_tiled;
	Bool	 is_timing_to_collect;

	//resolved at the end of a cycle from the *_id fields; never serialised
	COEUnit	*interest;
	COEUnit	*parent;
	COEUnit	*rally;
};

//per-cell occupancy list
class COEStack
{
	COEUnit	**unit;
	I64		  count;
	I64		  max;
};

class COEUnits
{
	COEUnit	 *unit;
	COEStack *stack;		//size * size cells
	COEShare  share[OECLR_COUNT];
	I64		  color;
	I64		  count;
	I64		  max;
	I64		  size;			//grid edge, OE_MAP_SIZE
	I64		  repath_index;
};

// --------------------------------------------------------------- overview
//
// the camera and input record. this is also the client to host payload.

class COERect
{
	COEPoint a;
	COEPoint b;
};

class COEOverview
{
	U64			parity;
	COEPoint	pan;
	COERect		selection_box;
	COEPoint	mouse_cursor;
	U32			event;
	I64			color;
	I64			spectator;
	COEShare	share;
	I64			xres;
	I64			yres;
	I64			cycles;
	I64			queue_size;
	I64			ping;
	I64			seed;
	I64			users;
};

// ----------------------------------------------------------------- packet
//
// host to client. carries one overview slot per colour: the host only fills
// a slot for a client that acted this turn.

class COEPacket
{
	COEOverview	overview[OECLR_COUNT];
	I64			turn;
	I64			exec_cycle;
	I64			client_id;
	I64			users_connected;
	I64			users;
	I64			seed;
	I64			control;
	Bool		is_stable;
	Bool		is_out_of_sync;
	Bool		game_running;
};

Bool OEStateIsDead(I64 state)
{
	return state == OEST_FALL || state == OEST_DECAY;
}

U0 OEResourceNone(COEResource *r)
{
	r->type   = OET_NONE;
	r->amount = 0;
}

//Direction_Fix: NE, E and SE are the mirror of NW, W and SW.
I64 OEDirFix(I64 dir, Bool *_flip)
{
	*_flip = FALSE;
	if (dir == OEDIR_NE)
	{
		*_flip = TRUE;
		return OEDIR_NW;
	}
	if (dir == OEDIR_E)
	{
		*_flip = TRUE;
		return OEDIR_W;
	}
	if (dir == OEDIR_SE)
	{
		*_flip = TRUE;
		return OEDIR_SW;
	}
	return dir;
}

//Direction_GetCart: octant of a cartesian velocity, by slope sign
I64 OEDirGetCart(COEPoint *p)
{
	I64 slope;

	if (!p->x && !p->y)
		return OEDIR_S;

	slope = OEPtSlope(p);
	if (p->x >= 0 && p->y >= 0)
	{
		if (slope > 1)
			return OEDIR_S;
		return OEDIR_SE;
	}
	if (p->x < 0 && p->y >= 0)
	{
		if (slope < -1)
			return OEDIR_S;
		return OEDIR_SW;
	}
	if (p->x < 0 && p->y < 0)
	{
		if (slope > 1)
			return OEDIR_N;
		return OEDIR_NW;
	}
	if (slope < -1)
		return OEDIR_N;
	return OEDIR_NE;
}

//Direction_CartToIso: the 45 degree rotation into screen space
I64 oe_dir_iso[OEDIR_COUNT] = {
	OEDIR_SE, OEDIR_S, OEDIR_SW, OEDIR_W,
	OEDIR_NW, OEDIR_N, OEDIR_NE, OEDIR_E
};

I64 OEDirCartToIso(I64 dir)
{
	if (dir < 0 || dir >= OEDIR_COUNT)
		return OEDIR_S;
	return oe_dir_iso[dir];
}
