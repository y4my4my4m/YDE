// -------------------------------------------------------------- direction
//
// SLP art carries five directions; the other three are the horizontal
// mirror of SW, W and NW.

#define OEDIR_S		0
#define OEDIR_SW	1
#define OEDIR_W		2
#define OEDIR_NW	3
#define OEDIR_N		4
#define OEDIR_NE	5
#define OEDIR_E		6
#define OEDIR_SE	7
#define OEDIR_COUNT	8

#define OEDIR_NOT_MIRRORED	5	//CONFIG_DIRECTION_COUNT_NOT_MIRRORED

