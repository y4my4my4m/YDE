// shared enumerations and the core simulation records
//
// this file is the ABI every later file binds to: nothing below it may
// change a field order or a constant value without the whole tree agreeing.
//
// openempire spells these as C enums in Type.h, State.h, Action.h,
// Motive.h, Trigger.h, Age.h, Color.h, Resource.h, Direction.h, Share.h,
// Status.h and Event.h. the numbering here is theirs, value for value,
// because Trigger indices map 1:1 onto the first three Type entries and the
// Direction tables index by ordinal.
//
// Event is a 27-bit bitfield upstream. ZealC bitfield packing is not worth
// relying on for something that crosses a socket, so it is one U32 with
// explicit masks.
//
// record layouts are NOT upstream's. the C build and this port never talk to
// each other - both peers of a ZealOS match run this code - so the wire
// format is whatever is declared here, and fields are ordered for the
// packer rather than to mirror C padding.

// ------------------------------------------------------------------- type

#define OET_NONE			-1
//simple upgradeable types, 1:1 with the first three triggers
#define OET_MILITIA			0
#define OET_MAN_AT_ARMS		1
#define OET_SPEARMAN		2
#define OET_VILLAGER_MALE	3
#define OET_VILLAGER_FEMALE	4
