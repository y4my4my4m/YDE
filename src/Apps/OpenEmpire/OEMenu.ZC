// title screen, options and the pause menu
//
// no counterpart upstream: WaitInLobby polls the server until every client
// has connected and cannot be entered offline.

#define OEMS_TITLE		0
#define OEMS_OPTIONS	1
#define OEMS_GAME		2
#define OEMS_PAUSE		3
#define OEMS_QUIT		4

#define OEMENU_ROW_H	20
#define OEMENU_SCALE	2

I64	 oe_state     = OEMS_TITLE;
I64	 oe_menu_sel  = 0;
Bool oe_menu_new  = FALSE;		//the game world needs building

Bool oe_k_up    = FALSE;
Bool oe_k_down  = FALSE;
Bool oe_k_left  = FALSE;
Bool oe_k_right = FALSE;
Bool oe_k_enter = FALSE;
Bool oe_k_esc   = FALSE;
Bool oe_k_zin   = FALSE;
Bool oe_k_zout  = FALSE;

//canvas sizes offered by the options page. 4:3 first, then 16:10 and 16:9.
//OE_W_MAX / OE_H_MAX cap the back buffer at 1600x1200.
#define OEMENU_RES_N	9
I64 oe_menu_res_w[OEMENU_RES_N] = {
	 800, 1024, 1280, 1600,
	1280, 1440,
	1280, 1366, 1600
};
I64 oe_menu_res_h[OEMENU_RES_N] = {
	 600,  768,  960, 1200,
	 800,  900,
	 720,  768,  900
};
I64 oe_menu_res_i = 1;

//zoom has no upstream counterpart. the world is drawn at one scale and the
//span blitter cannot resample a sprite, so zoom changes how many world pixels
//the canvas holds and OEBlitFit stretches them to the window: fewer pixels is
//a larger picture. the HUD scales with it, as it would at a lower resolution.
#define OEZOOM_MIN		50
#define OEZOOM_MAX		200
#define OEZOOM_STEP		10

I64 oe_zoom_pct   = 100;
I64 oe_wheel_prev = 0;

U0 OEZoomApply()
{
	I64 w = (oe_menu_res_w[oe_menu_res_i] * 100) / oe_zoom_pct;
	I64 h = (oe_menu_res_h[oe_menu_res_i] * 100) / oe_zoom_pct;

	OESetSize(w, h);
}

//mouse.pos.z only advances after WinMouseUpdate and drops notches
I64 OEWheelDz()
{
	I64 z  = mouse_hard.pos.z;
	I64 dz = z - oe_wheel_prev;

	if (dz)
		oe_wheel_prev = z;
	return dz;
}

U0 OEZoomStep(I64 dir)
{
	oe_zoom_pct = OEClamp(oe_zoom_pct + dir * OEZOOM_STEP, OEZOOM_MIN,
		OEZOOM_MAX);
	OEZoomApply;
}

U8 *OEMenuAspect(I64 w, I64 h)
{
	I64 r = (w * 100) / h;

	if (r > 173 && r < 182)
	{
		return "16:9";
	}
	if (r > 155 && r < 165)
	{
		return "16:10";
	}
	if (r > 128 && r < 140)
	{
		return "4:3";
	}
	return "";
}

Bool OEKeyEdge(I64 sc, Bool *held)
{
	Bool cur = Bt(kbd.down_bitmap, sc);

	if (cur && !*held)
	{
		*held = TRUE;
		return TRUE;
	}
	if (!cur)
	{
		*held = FALSE;
	}
	return FALSE;
}

I64 OEMenuInk(I64 r, I64 g, I64 b)
{
	if (!oe_pal_loaded)
	{
		return 0;
	}
	return OEPalNearest(r, g, b);
}

U0 OEMenuRow(I64 row, I64 sel, U8 *text)
{
	I64 ink = OEMenuInk(190, 175, 140);
	I64 x;
	I64 y = oe_h / 2 - 40 + row * OEMENU_ROW_H * OEMENU_SCALE;

	if (row == sel)
	{
		ink = OEMenuInk(255, 235, 130);
	}
	x = (oe_w - OETextWidth(text, OEMENU_SCALE)) / 2;
	OETextPut(x, y, text, ink, OEMENU_SCALE);
	if (row == sel)
	{
		OETextPut(x - 3 * OETEXT_W * OEMENU_SCALE, y, ">", ink, OEMENU_SCALE);
	}
}

U0 OEMenuTitle(U8 *text)
{
	I64 ink = OEMenuInk(240, 220, 160);
	I64 x   = (oe_w - OETextWidth(text, 3)) / 2;

	OETextPut(x, oe_h / 2 - 120, text, ink, 3);
}

//arrow or mouse-wheel style row movement, wrapping at both ends
U0 OEMenuStep(I64 count)
{
	if (OEKeyEdge(SC_CURSOR_UP, &oe_k_up))
	{
		oe_menu_sel--;
	}
	if (OEKeyEdge(SC_CURSOR_DOWN, &oe_k_down))
	{
		oe_menu_sel++;
	}
	if (oe_menu_sel < 0)
	{
		oe_menu_sel = count - 1;
	}
	if (oe_menu_sel >= count)
	{
		oe_menu_sel = 0;
	}
}

#define OEMENU_TITLE_N	3

U0 OEMenuDrawTitle()
{
	OEClear(0);
	OEMenuTitle("OPEN EMPIRE");
	OEMenuRow(0, oe_menu_sel, "NEW GAME");
	OEMenuRow(1, oe_menu_sel, "OPTIONS");
	OEMenuRow(2, oe_menu_sel, "QUIT");
}

U0 OEMenuInputTitle()
{
	OEMenuStep(OEMENU_TITLE_N);
	if (OEKeyEdge(SC_ENTER, &oe_k_enter))
	{
		if (!oe_menu_sel)
		{
			oe_menu_new = TRUE;
			oe_state    = OEMS_GAME;
		}
		else if (oe_menu_sel == 1)
		{
			oe_menu_sel = 0;
			oe_state    = OEMS_OPTIONS;
		}
		else
		{
			oe_state = OEMS_QUIT;
		}
	}
}

#define OEMENU_OPT_N	5

U0 OEMenuDrawOptions()
{
	U8 *line;

	OEClear(0);
	OEMenuTitle("OPTIONS");

	line = MStrPrint("RESOLUTION  %d x %d  %s", oe_menu_res_w[oe_menu_res_i],
		oe_menu_res_h[oe_menu_res_i],
		OEMenuAspect(oe_menu_res_w[oe_menu_res_i],
			oe_menu_res_h[oe_menu_res_i]));
	OEMenuRow(0, oe_menu_sel, line);
	Free(line);

	if (oe_snd_on)
	{
		OEMenuRow(1, oe_menu_sel, "SOUND       ON");
	}
	else
	{
		OEMenuRow(1, oe_menu_sel, "SOUND       OFF");
	}

	//the mixer takes 0..256; the row reads as a percentage
	line = MStrPrint("VOLUME      %d%%", (oe_snd_vol * 100) / 256);
	OEMenuRow(2, oe_menu_sel, line);
	Free(line);

	if (oe_opt_direct_keys)
	{
		OEMenuRow(3, oe_menu_sel, "HOTKEYS     DIRECT");
	}
	else
	{
		OEMenuRow(3, oe_menu_sel, "HOTKEYS     ALT");
	}

	OEMenuRow(4, oe_menu_sel, "BACK");
}

U0 OEMenuInputOptions()
{
	Bool left  = OEKeyEdge(SC_CURSOR_LEFT, &oe_k_left);
	Bool right = OEKeyEdge(SC_CURSOR_RIGHT, &oe_k_right);

	OEMenuStep(OEMENU_OPT_N);

	if (!oe_menu_sel && (left || right))
	{
		if (right)
		{
			oe_menu_res_i++;
		}
		else
		{
			oe_menu_res_i--;
		}
		if (oe_menu_res_i < 0)
		{
			oe_menu_res_i = OEMENU_RES_N - 1;
		}
		if (oe_menu_res_i >= OEMENU_RES_N)
		{
			oe_menu_res_i = 0;
		}
		OEZoomApply;
	}

	if (oe_menu_sel == 2)
	{
		if (right)
		{
			oe_snd_vol = OEMin(oe_snd_vol + 16, 256);
		}
		if (left)
		{
			oe_snd_vol = OEMax(oe_snd_vol - 16, 0);
		}
	}

	if (OEKeyEdge(SC_ENTER, &oe_k_enter))
	{
		if (oe_menu_sel == 1)
		{
			oe_snd_on = !oe_snd_on;
			if (!oe_snd_on)
			{
				OESndStopAll;
			}
		}
		else if (oe_menu_sel == 3)
		{
			oe_opt_direct_keys = !oe_opt_direct_keys;
		}
		else if (oe_menu_sel == 4)
		{
			oe_menu_sel = 0;
			oe_state    = OEMS_TITLE;
		}
	}
}

#define OEMENU_PAUSE_N	3

//the pause page sits over the live frame, so it needs its own ground: text
//alone against terrain and sprites is unreadable. the panel is drawn through
//oe_shade twice, which darkens what is under it rather than replacing it.
U0 OEMenuPanel(I64 x, I64 y, I64 w, I64 h)
{
	I64 xi;
	I64 yi;
	I64 p;
	I64 edge = OEMenuInk(210, 190, 140);

	for (yi = y; yi < y + h; yi++)
	{
		if (yi >= 0 && yi < oe_h)
		{
			for (xi = x; xi < x + w; xi++)
			{
				if (xi >= 0 && xi < oe_w)
				{
					p = yi * OE_W_MAX + xi;
					oe_screen[p] = oe_shade[oe_shade[oe_screen[p]]];
					oe_zbuf[p]   = OE_PRIO_HIGHEST;
				}
			}
		}
	}
	OEDrawRect(x, y, w, h, edge, OE_PRIO_HIGHEST);
}

U0 OEMenuDrawPause()
{
	I64 w = 340;
	I64 h = 200;

	OEMenuPanel((oe_w - w) / 2, oe_h / 2 - 140, w, h);
	OEMenuTitle("PAUSED");
	OEMenuRow(0, oe_menu_sel, "RESUME");
	OEMenuRow(1, oe_menu_sel, "OPTIONS");
	OEMenuRow(2, oe_menu_sel, "QUIT TO TITLE");
}

U0 OEMenuInputPause()
{
	OEMenuStep(OEMENU_PAUSE_N);
	if (OEKeyEdge(SC_ENTER, &oe_k_enter))
	{
		if (!oe_menu_sel)
		{
			oe_state = OEMS_GAME;
		}
		else if (oe_menu_sel == 1)
		{
			oe_menu_sel = 0;
			oe_state    = OEMS_OPTIONS;
		}
		else
		{
			oe_menu_sel = 0;
			oe_state    = OEMS_TITLE;
		}
	}
}
