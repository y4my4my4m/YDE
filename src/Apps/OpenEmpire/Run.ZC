// build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier
// one, so the include order below is load-bearing.
//
// OEMeap precedes OEType because COEUnit embeds a COEPoints path, and
// OEType precedes everything that names a unit or a packet.

Cd(__DIR__);;

#include "OEFmt"
#include "OEDrs"
#include "OEPal"
#include "OESlp"
#include "OESnd"
#include "OEGrid"
#include "OEMeap"
#include "OEType"
#include "OEField"
#include "OEDraw"
#include "OEText"
#include "OEOver"
#include "OEFile"
#include "OEMap"
#include "OEBlend"
#include "OEUnit"
#include "OEUnits"
#include "OENet"
#include "OEVideo"
#include "OEMenu"
#include "OETest"
#include "OpenEmpire"

//spawned rather than run in the terminal task: a task gets its own heap, so
//a stray render write cannot reach the compiler CCompCtrl or the lexer's
//document.
Spawn(&OpenEmpire, NULL, "OpenEmpire");

"\n$$LTBLUE$$WASD$$FG$$ pans, left-click selects, right-click commands, $$LTBLUE$$ESC$$FG$$ quits.\n";
"Type $$LTBLUE$$OETest;$$FG$$ to run the data-layer self-check.\n";
