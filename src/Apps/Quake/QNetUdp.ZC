// QNetUdp.ZC - the real transport under the loopback link.
//
// ZealOS already has everything below this file: RTL8139 and E1000 drivers,
// Ethernet, ARP, IPV4 and a UDP socket layer with bind/recvfrom. So there is no
// netstack and no driver to write here - only the Quake-shaped transport that
// sits on top, which is the same two operations the loopback link provides:
// hand over a whole message, take back a whole message.
//
// The net stack is NOT part of the kernel. It is loaded on demand by running
// ::/Home/Net/Start, so Quake has to compile whether or not it is present -
// hence the #ifdef. ZealOS keeps #defines system-wide once a file has been
// included, so UDP_MAX_PORT existing IS the test for "the UDP layer is loaded".
//
// Datagram boundaries line up exactly with what the protocol wants. A Quake
// message is already sized to fit one datagram (MAX_DATAGRAM), delivery is
// unreliable and unordered by design, and the delta encoding is measured from
// the baseline rather than the last packet - so a dropped datagram costs one
// frame of smoothness and never desynchronises anything.

#define QNET_PORT_DEFAULT	26000	//the original's port

I64		q_udp_port		= QNET_PORT_DEFAULT;
U32		q_udp_peer_ip	= 0;		//who we are talking to, 0 = nobody
U32		q_udp_from_ip	= 0;		//sender of the datagram just received
Bool	q_udp_ready		= FALSE;	//socket open and bound
Bool	q_udp_server	= FALSE;	//TRUE when hosting
I64		q_udp_sent		= 0;
I64		q_udp_recvd		= 0;
I64		q_udp_errors	= 0;
I64		q_udp_unresolved = 0;	//sends skipped because the peer MAC is unknown
U8		q_udp_status[96];

#ifdef UDP_MAX_PORT

CUDPSocket			*q_udp_socket	= NULL;
CSocketAddressIPV4	*q_udp_bind		= NULL;

Bool QNetUdpOpen(I64 port)
{//Open and bind. Both ends bind the same port, as the original does.
	if (q_udp_ready)
		return TRUE;

	//NO DHCP FROM HERE. Calling NetConfigure was a mistake: on a link with no
	//DHCP server - which is exactly a QEMU socket link between two guests -
	//DHCP DISCOVER retries to exhaustion and stalls the game for seconds before
	//failing anyway. An address is a prerequisite, not something to go hunting
	//for mid-game. `qip` sets one statically, `netdhcp` asks a real server.
	//ORDER MATTERS and the message says so: the socket is bound to this
	//machine's address, so there has to BE one before host or connect can run.
	if (!ipv4_globals.local_ip)
	{
		QStrCopy(q_udp_status,
			"set ip first: qip 10.0.0.2, THEN connect", 96);
		return FALSE;
	}

	q_udp_socket = UDPSocket(AF_INET);
	if (!q_udp_socket)
	{
		QStrCopy(q_udp_status, "UDPSocket failed", 96);
		return FALSE;
	}

	q_udp_bind = CAlloc(sizeof(CSocketAddressIPV4));

	//Ports go on the wire big endian; the socket layer does not swap for us.
	q_udp_bind->family	= AF_INET;
	q_udp_bind->port	= EndianU16(port);

	//BOUND TO INADDR_ANY, NOT TO OUR OWN ADDRESS.
	//
	//UDPHandler locates the receiving socket with
	//    UDPTreeNodeQueueIPV4Find(packet->source_ip_address, node)
	//- it matches the bound address against the SOURCE of the arriving packet,
	//not the destination. Binding our own address therefore matches nothing a
	//peer ever sends us, and every datagram is dropped with "address is not in
	//node queue". UDPChat gets away with binding the REMOTE address for exactly
	//this reason, which only works when you know your one peer in advance.
	//
	//A server does not know its clients ahead of time, so it binds the wildcard
	//and takes the INADDR_ANY fallback in that same lookup, which accepts any
	//source.
	q_udp_bind->address.address	= INADDR_ANY;

	if (UDPSocketBind(q_udp_socket, q_udp_bind) == -1)
	{
		QStrCopy(q_udp_status, "UDPSocketBind failed", 96);
		Free(q_udp_bind);
		q_udp_bind = NULL;
		UDPSocketClose(q_udp_socket);
		q_udp_socket = NULL;
		return FALSE;
	}

	//NON-BLOCKING, and this is the load-bearing part. UDPSocketReceiveFrom
	//returns -1 immediately when the queue is empty and no timeout is set;
	//with a timeout it SLEEPS, which in a frame loop would stall rendering
	//for as long as the peer stays quiet.
	q_udp_socket->receive_timeout_ms = 0;

	q_udp_port  = port;
	q_udp_ready = TRUE;
	q_udp_sent  = 0;
	q_udp_recvd = 0;

	StrPrint(q_udp_status, "bound to port %d", port);

	return TRUE;
}

U0 QNetUdpClose()
{
	if (!q_udp_ready)
		return;

	if (q_udp_socket)
		UDPSocketClose(q_udp_socket);

	if (q_udp_bind)
		Free(q_udp_bind);

	q_udp_socket = NULL;
	q_udp_bind   = NULL;
	q_udp_ready  = FALSE;
	q_udp_server = FALSE;
	q_udp_peer_ip = 0;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip)
{//One Quake message, one datagram to dest_ip. NEVER BLOCKS.
	U8	*payload;
	I64	 de_index;

	if (!q_udp_ready || !dest_ip || m->len < 1 || m->overflowed)
		return FALSE;

	//Ethernet MTU. No IP fragmentation on this stack - oversized datagrams
	//vanish. Entity updates are capped at QNET_MAX_DATAGRAM; this is the belt.
	if (m->len > 1472)
		return FALSE;

	//THE PEER'S MAC MUST ALREADY BE KNOWN.
	//
	//IPV4AddressMACGet resolves a cache miss by sending an ARP request and then
	//sleeping in 10ms steps for up to 500ms, four times over - two seconds of
	//blocking inside a send. Called from the frame loop that is exactly what it
	//sounds like: the game grinds to a crawl, and since the address never
	//resolves anyway not one datagram is transmitted.
	//
	//So the cache is consulted first and the send is simply skipped on a miss.
	//Resolution happens once, deliberately, in QNetUdpResolvePeer.
	if (!ARPCacheFind(dest_ip))
	{
		q_udp_unresolved++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		dest_ip, q_udp_port, m->len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, m->data, m->len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpSend(CQMsg *m)
{//To the latched peer. Listen-server remotes use QNetUdpSendTo(slot.ip).
	return QNetUdpSendTo(m, q_udp_peer_ip);
}

Bool QNetUdpRecv(CQMsg *out)
{//Take one datagram, if one is waiting. Never blocks.
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (!q_udp_ready)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));

	got = UDPSocketReceiveFrom(q_udp_socket, out->data, QNET_MAX_MSG, &from);
	if (got < 1)
		return FALSE;

	QMsgClear(out);
	out->len = got;

	//WHO SENT IT is reported every time, not just the first time. With several
	//clients the sender is what decides which of them the message belongs to,
	//so latching only the first address would attribute everyone's moves to
	//whoever spoke first.
	if (from.family == AF_INET)
	{
		v4 = &from;

		/*	sockaddr IPv4 is NETWORK byte order (BE). Quake, ARPCache, and
			UDPPacketAllocate all want HOST order (LE, first octet in the low
			byte) - the same layout QConParseIPV4 / IPV4AddressParse produce.

			The UDP stack stores EndianU32(packet->source_ip_address) into
			from_address, and packet->source_ip_address is already LE, so the
			value here is BE. Taking it raw made the listen server latch a
			byte-swapped peer: ARPCacheFind missed (cache key is LE from
			IPV4Handler), QNetUdpSend skipped every reply, svc_serverinfo
			never left the host, and the joining client sat in the menu
			forever while netstat still showed the slot from QSvAddClient. */
		q_udp_from_ip = EndianU32(v4->address.address);

		//A listen server still has no address to reply to until someone speaks,
		//which is what makes "host" work with no prior configuration.
		if (!q_udp_peer_ip)
			q_udp_peer_ip = q_udp_from_ip;
	}
	else
		q_udp_from_ip = 0;

	q_udp_recvd++;

	return TRUE;
}

Bool QNetUdpAvailable()
{
	return TRUE;
}

#else

//Net stack not loaded at compile time. The transport still has to EXIST,
//because the menu and the shell reference it either way - it simply reports
//that it cannot run, rather than silently pretending to connect.

Bool QNetUdpOpen(I64 port)
{
	QStrCopy(q_udp_status,
		"net stack not loaded - run ::/Home/Net/Start, then rebuild", 96);

	return FALSE;
}

U0 QNetUdpClose()
{
}

Bool QNetUdpSend(CQMsg *m)
{
	return FALSE;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip)
{
	return FALSE;
}

Bool QNetUdpRecv(CQMsg *out)
{
	return FALSE;
}

Bool QNetUdpAvailable()
{
	return FALSE;
}

#endif

U0 QNetUdpInit()
{//Globals are not zeroed.
	q_udp_port    = QNET_PORT_DEFAULT;
	q_udp_peer_ip = 0;
	q_udp_from_ip = 0;
	q_udp_ready   = FALSE;
	q_udp_server  = FALSE;
	q_udp_sent       = 0;
	q_udp_recvd      = 0;
	q_udp_errors     = 0;
	q_udp_unresolved = 0;

	if (QNetUdpAvailable())
		QStrCopy(q_udp_status, "udp available", 96);
	else
		QStrCopy(q_udp_status, "udp not compiled in", 96);
}

U0 QNetUdpSetPeer(U32 ip)
{
	q_udp_peer_ip = ip;
}

#ifdef UDP_MAX_PORT

Bool QNetUdpPeerResolved()
{//Is the peer's hardware address known? Cheap, and never sends anything.
	if (!q_udp_peer_ip)
		return FALSE;

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

U0 QNetUdpArpProbe()
{//Ask who the peer is WITHOUT waiting for the answer.
 //
 //ARPSend returns immediately; the reply is picked up by ARPHandler and lands
 //in the cache on its own. That makes this safe to call from the frame loop,
 //unlike IPV4AddressMACGet which sleeps until it gets an answer. It also means
 //a client whose server was not up yet recovers by itself once it appears.
	if (!q_udp_ready || !q_udp_peer_ip)
		return;

	ARPSend(ARP_REQUEST,
		ethernet_globals.ethernet_broadcast,
		EthernetMACGet,
		ipv4_globals.local_ip_be,
		ethernet_globals.ethernet_null,
		EndianU32(q_udp_peer_ip));
}

Bool QNetUdpResolvePeer()
{//Resolve the peer's MAC ONCE, from a menu or console command where a two
 //second stall is acceptable. Everything after this can send without blocking.
 //
 //This is also the honest reachability test: if ARP does not answer here, the
 //other machine is not on the wire, and no amount of Quake protocol will help.
	U8 *mac = NULL;

	if (!q_udp_ready || !q_udp_peer_ip)
		return FALSE;

	if (ARPCacheFind(q_udp_peer_ip))
		return TRUE;

	IPV4AddressMACGet(q_udp_peer_ip, &mac);

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

#else

U0 QNetUdpArpProbe()
{
}

Bool QNetUdpPeerResolved()
{
	return FALSE;
}

Bool QNetUdpResolvePeer()
{
	return FALSE;
}

#endif

#ifdef UDP_MAX_PORT

U32 QNetLocalIP()
{
	return ipv4_globals.local_ip;
}

U0 QNetDhcp()
{//Explicit, and only ever on request.
	NetConfigure;

	if (ipv4_globals.local_ip)
		StrPrint(q_udp_status, "dhcp ok: %d.%d.%d.%d",
			ipv4_globals.local_ip & 255,
			(ipv4_globals.local_ip >> 8) & 255,
			(ipv4_globals.local_ip >> 16) & 255,
			(ipv4_globals.local_ip >> 24) & 255);
	else
		QStrCopy(q_udp_status, "dhcp failed - no server? use qip", 96);
}

Bool QNetUdpSetLocalIP(U32 ip)
{//Static address, for a link with no DHCP server on it - which is exactly what
 //two QEMU guests joined by -netdev socket are. ARP still works on that link,
 //so an address and a subnet are all the stack is missing.
	U32 got;

	if (!ip)
	{
		QStrCopy(q_udp_status, "qip: could not parse that address", 96);
		return FALSE;
	}

	IPV4AddressSet(ip);

	//A /24 with no router: everything is on-link, so nothing is ever forwarded
	//to a gateway that does not exist.
	IPV4SubnetSet(0, 0x00FFFFFF);

	//READ BACK what the stack actually holds rather than echoing what was asked
	//for. If IPV4AddressSet did not take, saying "static ip x" anyway would be
	//a lie, and the next failure would look like a different problem.
	got = ipv4_globals.local_ip;

	StrPrint(q_udp_status, "ip now %d.%d.%d.%d",
		got & 255, (got >> 8) & 255, (got >> 16) & 255, (got >> 24) & 255);

	return ToBool(got == ip);
}

Bool QNetAutoIP(U32 server_ip)
{//Pick a static address when the link has nobody to hand one out.
 //
 //A direct VM-to-VM link has no DHCP server, so an address has to come from
 //somewhere - and making the player supply one by hand before every session is
 //a step that is easy to miss and gives a failure that looks like the network
 //is broken. Hosting takes .1 on a private /24; joining takes a neighbouring
 //address on the SERVER's /24, so the two are on the same wire by construction.
 //
 //`qip` still overrides this, and anything already configured - by DHCP or by
 //hand - is left alone.
	U32 ip;
	U32 last;

	if (ipv4_globals.local_ip)
		return TRUE;

	if (!server_ip)
		//FIRST octet in the LOW byte, matching IPV4AddressParse. Packing it
		//the other way round yields 1.0.0.10, which binds without complaint
		//and then never reaches anyone.
		ip = 10 | (0 << 8) | (0 << 16) | (1 << 24);	//10.0.0.1, host
	else
	{
		//Neighbour of the server on its own subnet. The top three octets are
		//kept; only the host part moves, and away from .0 and .255.
		last = (server_ip >> 24) & 255;

		if (last >= 253)
			last -= 1;
		else
			last += 1;

		ip = (server_ip & 0x00FFFFFF) | (last << 24);
	}

	return QNetUdpSetLocalIP(ip);
}

#else

Bool QNetAutoIP(U32 server_ip)
{
	return FALSE;
}

U32 QNetLocalIP()
{
	return 0;
}

U0 QNetDhcp()
{
	QStrCopy(q_udp_status, "no net stack - run RunNet.ZC", 96);
}

Bool QNetUdpSetLocalIP(U32 ip)
{
	return FALSE;
}

#endif
