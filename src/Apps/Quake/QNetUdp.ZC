// QNetUdp.ZC - udp transport, same two ops as the loopback link
//
// the net stack isn't in the kernel, RunNet.ZC loads it. UDP_MAX_PORT defined
// is the test for that, hence the #ifdef - quake must still compile without it

#define QNET_PORT_DEFAULT	26000

//limited broadcast. the only address a slist query can use - neither end knows
//the other exists yet, so there is nothing to unicast to (Datagram_SearchForHosts)
#define QNET_BROADCAST_IP	0xFFFFFFFF

I64		q_udp_port		= QNET_PORT_DEFAULT;
U32		q_udp_peer_ip	= 0;		//peer address, 0 = none
U32		q_udp_from_ip	= 0;		//sender of the datagram just received
I64		q_udp_from_port	= QNET_PORT_DEFAULT;	//sender port, ironwail is ephemeral
Bool	q_udp_ready		= FALSE;	//socket open and bound
Bool	q_udp_server	= FALSE;	//hosting
I64		q_udp_sent		= 0;
I64		q_udp_recvd		= 0;
I64		q_udp_errors	= 0;
I64		q_udp_unresolved = 0;	//sends skipped, peer mac unknown
Bool	q_dhcp_failed	= FALSE;	//don't re-stall on a link with no dhcp server
U8		q_udp_status[96];

#ifdef UDP_MAX_PORT

CUDPSocket			*q_udp_socket	= NULL;
CSocketAddressIPV4	*q_udp_bind		= NULL;

Bool QNetUdpOpen(I64 port)
{//both ends bind the same port, as the original does
	if (q_udp_ready)
		return TRUE;

	//no dhcp here, it retries to exhaustion and stalls the frame loop on a link
	//with no server. qip sets an address statically, netdhcp asks for one
	if (!ipv4_globals.local_ip)
	{
		QStrCopy(q_udp_status,
			"set ip first: qip 10.0.0.2, THEN connect", 96);
		return FALSE;
	}

	q_udp_socket = UDPSocket(AF_INET);
	if (!q_udp_socket)
	{
		QStrCopy(q_udp_status, "UDPSocket failed", 96);
		return FALSE;
	}

	q_udp_bind = CAlloc(sizeof(CSocketAddressIPV4));

	//ports go on the wire big endian, the socket layer doesn't swap
	q_udp_bind->family	= AF_INET;
	q_udp_bind->port	= EndianU16(port);

	//INADDR_ANY, not the local address: UDPHandler matches the bound address
	//against the packet SOURCE, so the local one matches nothing a peer sends
	q_udp_bind->address.address	= INADDR_ANY;

	if (UDPSocketBind(q_udp_socket, q_udp_bind) == -1)
	{
		QStrCopy(q_udp_status, "UDPSocketBind failed", 96);
		Free(q_udp_bind);
		q_udp_bind = NULL;
		UDPSocketClose(q_udp_socket);
		q_udp_socket = NULL;
		return FALSE;
	}

	//must be non blocking. with a timeout set UDPSocketReceiveFrom SLEEPS, and
	//the frame loop stalls for as long as the peer stays quiet
	q_udp_socket->receive_timeout_ms = 0;

	q_udp_port  = port;
	q_udp_ready = TRUE;
	q_udp_sent  = 0;
	q_udp_recvd = 0;

	StrPrint(q_udp_status, "bound to port %d", port);

	return TRUE;
}

U0 QNetUdpClose()
{
	if (!q_udp_ready)
		return;

	if (q_udp_socket)
		UDPSocketClose(q_udp_socket);

	if (q_udp_bind)
		Free(q_udp_bind);

	q_udp_socket = NULL;
	q_udp_bind   = NULL;
	q_udp_ready  = FALSE;
	q_udp_server = FALSE;
	q_udp_peer_ip = 0;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip, I64 dest_port=0)
{//NET_SendPacket - one message, one datagram, never blocks
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !dest_ip || m->len < 1 || m->overflowed)
		return FALSE;

	//ethernet mtu. no ip fragmentation on this stack, oversized datagrams just
	//vanish. entity updates are already capped at QNET_MAX_DATAGRAM
	if (m->len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	//cache only, IPV4AddressMACGet blocks 2s on a miss. resolution belongs in
	//QNetUdpResolvePeer, not the frame loop
	if (!ARPCacheFind(dest_ip))
	{
		q_udp_unresolved++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		dest_ip, dport, m->len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, m->data, m->len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpSend(CQMsg *m)
{//to the latched peer, listen server remotes use QNetUdpSendTo(slot.ip)
	return QNetUdpSendTo(m, q_udp_peer_ip);
}

Bool QNetUdpSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port=0)
{//raw NETFLAG framed bytes, dest_port 0 means QNET_PORT_DEFAULT
 //
 //ironwail CCREQ comes from an ephemeral port, so CTL Accept must reply there
 //and not to 26000, which is the local bind, not the client socket
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !dest_ip || !data || len < 1)
		return FALSE;

	if (len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	if (!ARPCacheFind(dest_ip))
	{
		q_udp_unresolved++;
		return FALSE;
	}

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		dest_ip, dport, len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpSendRawBroadcast(U8 *data, I64 len, I64 dest_port=0)
{//raw NETFLAG framed bytes to the whole subnet, for the slist query only
 //
 //no ARPCacheFind here and none is possible: 255.255.255.255 is never in the
 //cache. IPV4AddressMACGet short circuits that address to
 //ethernet_globals.ethernet_broadcast and returns at once, so unlike a unicast
 //miss this costs no stall
 //
 //source port stays q_udp_port, that is where the CCREP has to come back to
	U8	*payload;
	I64	 de_index;
	I64	 dport;

	if (!q_udp_ready || !data || len < 1)
		return FALSE;

	if (len > 1472)
		return FALSE;

	dport = dest_port;
	if (dport < 1 || dport > 65535)
		dport = QNET_PORT_DEFAULT;

	de_index = UDPPacketAllocate(&payload, ipv4_globals.local_ip, q_udp_port,
		QNET_BROADCAST_IP, dport, len);

	if (de_index < 0)
	{
		q_udp_errors++;
		return FALSE;
	}

	MemCopy(payload, data, len);
	UDPPacketFinish(de_index);

	q_udp_sent++;

	return TRUE;
}

Bool QNetUdpRecv(CQMsg *out)
{//one datagram if one is waiting, never blocks
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (!q_udp_ready)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));

	got = UDPSocketReceiveFrom(q_udp_socket, out->data, QNET_MAX_MSG, &from);
	if (got < 1)
		return FALSE;

	QMsgClear(out);
	out->len = got;

	//report the sender every time. with several clients the address is what
	//decides whose message this is, latch it once and everyone's moves land
	//on whoever spoke first
	if (from.family == AF_INET)
	{
		v4 = &from;

		/*	sockaddr ipv4 is network order. quake, ARPCache and
			UDPPacketAllocate all want host order, first octet in the low
			byte, the layout IPV4AddressParse produces.

			taken raw the listen server latches a byte swapped peer:
			ARPCacheFind misses, every reply is skipped, and the joining
			client sits in the menu while netstat still shows its slot. */
		q_udp_from_ip = EndianU32(v4->address.address);

		//a listen server has nobody to reply to until someone speaks, which is
		//what lets host work with no prior configuration
		if (!q_udp_peer_ip)
			q_udp_peer_ip = q_udp_from_ip;

		q_udp_from_port = EndianU16(v4->port);
		if (q_udp_from_port < 1)
			q_udp_from_port = QNET_PORT_DEFAULT;
	}
	else
	{
		q_udp_from_ip = 0;
		q_udp_from_port = QNET_PORT_DEFAULT;
	}

	q_udp_recvd++;

	return TRUE;
}

Bool QNetUdpRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{//raw bytes for QNetDgrm framing, never blocks
	CSocketAddressStorage	from;
	CSocketAddressIPV4		*v4;
	I64						 got;

	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;

	if (!q_udp_ready || !buf || max < 1)
		return FALSE;

	MemSet(&from, 0, sizeof(CSocketAddressStorage));

	got = UDPSocketReceiveFrom(q_udp_socket, buf, max, &from);
	if (got < 1)
		return FALSE;

	if (out_len)
		*out_len = got;

	if (from.family == AF_INET)
	{
		v4 = &from;
		q_udp_from_ip = EndianU32(v4->address.address);
		//sockaddr port is network order
		q_udp_from_port = EndianU16(v4->port);
		if (q_udp_from_port < 1)
			q_udp_from_port = QNET_PORT_DEFAULT;
		if (!q_udp_peer_ip)
			q_udp_peer_ip = q_udp_from_ip;
	}
	else
	{
		q_udp_from_ip = 0;
		q_udp_from_port = QNET_PORT_DEFAULT;
	}

	if (from_ip)
		*from_ip = q_udp_from_ip;

	q_udp_recvd++;

	return TRUE;
}

Bool QNetUdpAvailable()
{
	return TRUE;
}

#else

//no net stack at compile time. the transport still has to exist, the menu and
//the shell reference it either way. it reports, it does not fake a connect

Bool QNetUdpOpen(I64 port)
{
	QStrCopy(q_udp_status,
		"net stack not loaded - run ::/Home/Net/Start, then rebuild", 96);

	return FALSE;
}

U0 QNetUdpClose()
{
}

Bool QNetUdpSend(CQMsg *m)
{
	return FALSE;
}

Bool QNetUdpSendTo(CQMsg *m, U32 dest_ip, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpSendRawTo(U8 *data, I64 len, U32 dest_ip, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpSendRawBroadcast(U8 *data, I64 len, I64 dest_port=0)
{
	return FALSE;
}

Bool QNetUdpRecv(CQMsg *out)
{
	return FALSE;
}

Bool QNetUdpRecvRaw(U8 *buf, I64 max, I64 *out_len, U32 *from_ip)
{
	if (out_len)
		*out_len = 0;
	if (from_ip)
		*from_ip = 0;
	return FALSE;
}

Bool QNetUdpAvailable()
{
	return FALSE;
}

#endif

U0 QNetUdpInit()
{//globals aren't zeroed
	//only exists in the net stack build, referencing it outside this guard
	//breaks the single player only build outright
#ifdef UDP_MAX_PORT
	q_udp_bind = NULL;
#endif

	q_udp_port    = QNET_PORT_DEFAULT;
	q_dhcp_failed = FALSE;
	q_udp_peer_ip = 0;
	q_udp_from_ip = 0;
	q_udp_from_port = QNET_PORT_DEFAULT;
	q_udp_ready   = FALSE;
	q_udp_server  = FALSE;
	q_udp_sent       = 0;
	q_udp_recvd      = 0;
	q_udp_errors     = 0;
	q_udp_unresolved = 0;

	if (QNetUdpAvailable())
		QStrCopy(q_udp_status, "udp available", 96);
	else
		QStrCopy(q_udp_status, "udp not compiled in", 96);
}

U0 QNetUdpSetPeer(U32 ip)
{
	q_udp_peer_ip = ip;
}

#ifdef UDP_MAX_PORT

Bool QNetUdpPeerResolved()
{//cache lookup only, sends nothing
	if (!q_udp_peer_ip)
		return FALSE;

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

U0 QNetUdpArpProbe()
{//ask who the peer is without waiting for the answer
 //
 //ARPSend returns immediately and ARPHandler puts the reply in the cache, so
 //this is frame loop safe where IPV4AddressMACGet is not. a client whose
 //server wasn't up yet also recovers by itself once it appears
	if (!q_udp_ready || !q_udp_peer_ip)
		return;

	ARPSend(ARP_REQUEST,
		ethernet_globals.ethernet_broadcast,
		EthernetMACGet,
		ipv4_globals.local_ip_be,
		ethernet_globals.ethernet_null,
		EndianU32(q_udp_peer_ip));
}

Bool QNetUdpResolvePeer()
{//resolve the peer mac once, from a menu or console command where a two second
 //stall is fine. everything after this sends without blocking
 //
 //also the honest reachability test: no arp answer means the other machine
 //isn't on the wire
	U8 *mac = NULL;

	if (!q_udp_ready || !q_udp_peer_ip)
		return FALSE;

	if (ARPCacheFind(q_udp_peer_ip))
		return TRUE;

	IPV4AddressMACGet(q_udp_peer_ip, &mac);

	return ToBool(ARPCacheFind(q_udp_peer_ip) != NULL);
}

Bool QNetUdpEnsureArp(U32 ip)
{//block until the dest mac is known, CTL Accept must not drop on a cold cache
	U8 *mac = NULL;

	if (!ip)
		return FALSE;
	if (ARPCacheFind(ip))
		return TRUE;

	IPV4AddressMACGet(ip, &mac);
	return ToBool(ARPCacheFind(ip) != NULL);
}

#else

U0 QNetUdpArpProbe()
{
}

Bool QNetUdpPeerResolved()
{
	return FALSE;
}

Bool QNetUdpResolvePeer()
{
	return FALSE;
}

Bool QNetUdpEnsureArp(U32 ip)
{
	return FALSE;
}

#endif

#ifdef UDP_MAX_PORT

U32 QNetLocalIP()
{//in the SAME byte order as everything else in this port
 //
 //ipv4_globals keeps two copies. local_ip is conventional host order, first
 //octet in the HIGH byte. every address the quake layer handles - what
 //QConParseIPV4 builds, what QNetUdpSetPeer and the arp cache take, and the
 //from_ip a packet arrives with - is the other way round, first octet LOW,
 //and that is exactly what local_ip_be holds.
 //
 //returning the raw local_ip printed and ADVERTISED our address reversed:
 //10.0.2.15 went out as 15.2.0.10, so a client that trusts the address in
 //CCREP_SERVER_INFO connected to nothing. typing the address by hand worked
 //because that path never touched this value
	return ipv4_globals.local_ip_be;
}

U0 QNetDhcp()
{//explicit, only ever on request
	//NetConfigure retries DISCOVER for seconds and a direct link has nothing to
	//discover, so remember the failure and keep the menu responsive
	if (q_dhcp_failed)
	{
		QStrCopy(q_udp_status, "dhcp already failed - use qip", 96);
		return;
	}

	NetConfigure;

	if (ipv4_globals.local_ip)
		StrPrint(q_udp_status, "dhcp ok: %d.%d.%d.%d",
			ipv4_globals.local_ip & 255,
			(ipv4_globals.local_ip >> 8) & 255,
			(ipv4_globals.local_ip >> 16) & 255,
			(ipv4_globals.local_ip >> 24) & 255);
	else
	{
		q_dhcp_failed = TRUE;
		QStrCopy(q_udp_status, "dhcp failed - no server? use qip", 96);
	}
}

Bool QNetUdpSetLocalIP(U32 ip)
{//static address for a link with no dhcp server, which two qemu guests joined
 //by -netdev socket are. arp works there, only address and subnet are missing
	U32 got;

	if (!ip)
	{
		QStrCopy(q_udp_status, "qip: could not parse that address", 96);
		return FALSE;
	}

	IPV4AddressSet(ip);

	//a /24 with no router, everything on-link, nothing forwarded to a gateway
	//that doesn't exist
	IPV4SubnetSet(0, 0x00FFFFFF);

	//read back what the stack holds, don't echo what was asked for. if the set
	//didn't take, the next failure looks like a different problem
	got = ipv4_globals.local_ip;

	StrPrint(q_udp_status, "ip now %d.%d.%d.%d",
		got & 255, (got >> 8) & 255, (got >> 16) & 255, (got >> 24) & 255);

	return ToBool(got == ip);
}

Bool QNetAutoIP(U32 server_ip)
{//pick a static address when the link has nobody to hand one out
 //
 //hosting takes .1 on a private /24, joining takes a neighbour on the server's
 //own /24, so both ends are on the same wire by construction
 //
 //qip still overrides, and anything already configured is left alone
	U32 ip;
	U32 last;

	if (ipv4_globals.local_ip)
		return TRUE;

	if (!server_ip)
		//first octet in the LOW byte, matching IPV4AddressParse. the other way
		//round is 1.0.0.10, which binds fine and reaches nobody
		ip = 10 | (0 << 8) | (0 << 16) | (1 << 24);	//10.0.0.1, host
	else
	{
		//keep the top three octets, move only the host part, away from
		//.0 and .255
		last = (server_ip >> 24) & 255;

		if (last >= 253)
			last -= 1;
		else
			last += 1;

		ip = (server_ip & 0x00FFFFFF) | (last << 24);
	}

	return QNetUdpSetLocalIP(ip);
}

#else

Bool QNetAutoIP(U32 server_ip)
{
	return FALSE;
}

U32 QNetLocalIP()
{
	return 0;
}

U0 QNetDhcp()
{
	QStrCopy(q_udp_status, "no net stack - run RunNet.ZC", 96);
}

Bool QNetUdpSetLocalIP(U32 ip)
{
	return FALSE;
}

#endif
