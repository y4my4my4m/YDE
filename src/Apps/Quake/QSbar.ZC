// QSbar.ZC - the status bar.
//
// Rebuilt from the game's own art rather than drawn as text: SBAR and IBAR are
// 320x24 strips, the big digits are 24x24 pictures (NUM_ for health, ANUM_ for
// ammo), and the ammo/armor icons and player faces are separate lumps.
//
// The bar is 320 wide, which is exactly the canvas width, so it sits flush at
// the bottom with no scaling. Everything is drawn INSIDE the indexed canvas so
// it goes through the same palette as the world.

#define QSBAR_H			24
#define QSBAR_DIGIT_W	24
#define QSBAR_LINES		2		//IBAR (inventory) above SBAR (status)

//Item bit flags QuakeC keeps in .items, used to pick armor and ammo icons.
#define QIT_SHOTGUN			1
#define QIT_SUPER_SHOTGUN	2
#define QIT_NAILGUN			4
#define QIT_SUPER_NAILGUN	8
#define QIT_GRENADE_LAUNCHER 16
#define QIT_ROCKET_LAUNCHER	32
#define QIT_LIGHTNING		64
#define QIT_ARMOR1			8192
#define QIT_ARMOR2			16384
#define QIT_ARMOR3			32768
#define QIT_INVISIBILITY	524288
#define QIT_INVULNERABILITY	1048576
#define QIT_SUIT			2097152
#define QIT_QUAD			4194304

Bool q_sbar_ready = FALSE;

CQPic q_pic_sbar;
CQPic q_pic_ibar;
CQPic q_pic_backtile;	//gfx.wad "backtile", the fill beside the bar
CQPic q_pic_nums[10];
CQPic q_pic_anums[10];
CQPic q_pic_minus;
CQPic q_pic_faces[5];
CQPic q_pic_face_pain[5];
CQPic q_pic_armor[3];
CQPic q_pic_ammo[4];

U0 QSbarInit()
{//Resolve every picture once. A missing lump leaves a zeroed CQPic, and the
 //blit already ignores those, so partial art degrades instead of faulting.
	U8	name[24];
	I64	i;

	q_sbar_ready = FALSE;

	QWadPic("SBAR", &q_pic_sbar);
	QWadPic("IBAR", &q_pic_ibar);
	QWadPic("BACKTILE", &q_pic_backtile);
	QWadPic("NUM_MINUS", &q_pic_minus);

	for (i = 0; i < 10; i++)
	{
		StrPrint(name, "NUM_%d", i);
		QWadPic(name, &q_pic_nums[i]);

		StrPrint(name, "ANUM_%d", i);
		QWadPic(name, &q_pic_anums[i]);
	}

	//Faces run FACE1 (healthy) to FACE5 (nearly dead), each with a _P pain
	//variant shown briefly after taking damage.
	for (i = 0; i < 5; i++)
	{
		StrPrint(name, "FACE%d", i + 1);
		QWadPic(name, &q_pic_faces[i]);

		StrPrint(name, "FACE_P%d", i + 1);
		QWadPic(name, &q_pic_face_pain[i]);
	}

	for (i = 0; i < 3; i++)
	{
		StrPrint(name, "SB_ARMOR%d", i + 1);
		QWadPic(name, &q_pic_armor[i]);
	}

	QWadPic("SB_SHELLS", &q_pic_ammo[0]);
	QWadPic("SB_NAILS",  &q_pic_ammo[1]);
	QWadPic("SB_ROCKET", &q_pic_ammo[2]);
	QWadPic("SB_CELLS",  &q_pic_ammo[3]);

	q_sbar_ready = ToBool(q_pic_sbar.pixels != NULL);
}

U0 QSbarNumber(CQCanvas *c, I64 x, I64 y, I64 value, I64 digits, Bool alt)
{//Right-aligned big number, the way the original lays out health and ammo.
 //Values are clamped to what the field can show rather than overflowing into
 //the neighbouring element.
	U8		str[16];
	CQPic	*pic;
	I64		 len;
	I64		 i;
	I64		 ch;
	I64		 draw_x;

	if (value > 999)
		value = 999;
	if (value < -99)
		value = -99;

	StrPrint(str, "%d", value);
	len = StrLen(str);

	//Right align inside the field.
	draw_x = x + (digits - len) * QSBAR_DIGIT_W;

	for (i = 0; i < len; i++)
	{
		ch = str[i];

		if (ch == '-')
			pic = &q_pic_minus;
		else if ('0' <= ch <= '9')
		{
			if (alt)
				pic = &q_pic_anums[ch - '0'];
			else
				pic = &q_pic_nums[ch - '0'];
		}
		else
			pic = NULL;

		if (pic)
			QPicDraw(c, pic, draw_x + i * QSBAR_DIGIT_W, y);
	}
}

I64 QSbarFaceIndex(I64 health)
{//FACE1 is healthy, FACE5 is nearly dead.
	if (health >= 100)	return 0;
	if (health >= 80)	return 1;
	if (health >= 60)	return 2;
	if (health >= 40)	return 3;

	return 4;
}

Bool QIsBreak(U8 *s, I64 i)
{//TRUE if a line break starts at s[i].
 //
 //Two forms have to be accepted. A real newline byte is what a compiled string
 //should hold, but the message text was arriving with a literal BACKSLASH
 //followed by 'n' - the escape unprocessed - and printing that as two glyphs is
 //exactly what showed up on screen. Handling both costs one comparison and does
 //not care which layer failed to translate it.
	if (s[i] == '\n')
		return TRUE;

	//0x5C is backslash. Written as a number so the character never has to be
	//escaped in this source.
	if (s[i] == 0x5C && s[i + 1] == 'n')
		return TRUE;

	return FALSE;
}

U0 QSbarCenterPrint(CQCanvas *c)
{//Draw the pending centerprint message, wrapped on its own newlines.
 //
 //QuakeC embeds line breaks in these strings, so a single QStrDraw would run
 //them together and off the edge of the screen.
	U8	line[64];
	I64 i = 0;
	I64 n = 0;
	I64 y;
	I64 rows = 1;
	I64 k;

	if (!q_center_text[0] || tS > q_center_until)
		return;

	//Count the rows first so the block can be vertically centred.
	for (k = 0; q_center_text[k]; k++)
	{
		if (QIsBreak(q_center_text, k))
			rows++;
	}

	y = c->height / 4 - rows * QCHAR_H / 2;
	if (y < QCHAR_H)
		y = QCHAR_H;

	while (TRUE)
	{
		if (q_center_text[i] == 0 || QIsBreak(q_center_text, i))
		{
			line[n] = 0;
			if (n)
				QStrDrawCenter(c, y, line);

			y += QCHAR_H;
			n  = 0;

			if (!q_center_text[i])
				return;

			//A two-character escape consumes an extra byte.
			if (q_center_text[i] != '\n')
				i++;
		}
		else if (n < 63)
		{
			line[n] = q_center_text[i];
			n++;
		}

		i++;
	}
}

U0 QSbarIntermission(CQCanvas *c, F64 level_time)
{//The end-of-level screen: elapsed time, secrets and kills.
 //
 //QuakeC has already parked the camera at an info_intermission and it keeps
 //running its own IntermissionThink, which watches button0 and moves on when
 //the player fires. So this only draws - it must not swallow input, or the
 //player would be stuck on this screen forever.
	U8	line[80];
	I64 mins;
	I64 secs;
	I64 y;

	if (!q_intermission)
		return;

	//The finale is a wall of text rather than a stat sheet.
	if (q_finale)
	{
		if (q_finale_text[0])
			QStrDrawCenter(c, c->height / 3, q_finale_text);
		else
			QStrDrawCenter(c, c->height / 3, "episode complete");

		QStrDrawCenter(c, c->height / 3 + QCHAR_H * 4, "press fire to continue");
		return;
	}

	mins = ToI64(level_time) / 60;
	secs = ToI64(level_time) % 60;

	y = c->height / 4;

	QStrDrawCenter(c, y, "level complete");
	y += QCHAR_H * 3;

	StrPrint(line, "time      %2d:%02d", mins, secs);
	QStrDrawCenter(c, y, line);
	y += QCHAR_H * 2;

	if (q_ofs_found_secrets >= 0 && q_ofs_total_secrets >= 0)
	{
		StrPrint(line, "secrets   %2d/%2d",
			ToI64(QPrGetF(q_ofs_found_secrets)),
			ToI64(QPrGetF(q_ofs_total_secrets)));
		QStrDrawCenter(c, y, line);
		y += QCHAR_H * 2;
	}

	if (q_ofs_killed_monsters >= 0 && q_ofs_total_monsters >= 0)
	{
		StrPrint(line, "monsters  %2d/%2d",
			ToI64(QPrGetF(q_ofs_killed_monsters)),
			ToI64(QPrGetF(q_ofs_total_monsters)));
		QStrDrawCenter(c, y, line);
		y += QCHAR_H * 2;
	}

	QStrDrawCenter(c, y + QCHAR_H, "press fire to continue");
}

U0 QSbarTileClear(CQCanvas *c)
{//SCR_TileClear: the border around a shrunken view. At viewsize 100 the rect
 //fills the canvas and none of this draws.
	I64 bottom = c->height - QSBAR_H;

	if (!q_sbar_ready)
		return;

	if (c->vx > 0)
	{
		QPicTile(c, &q_pic_backtile, 0, 0, c->vx, bottom);
		QPicTile(c, &q_pic_backtile, c->vx + c->vw, 0,
			c->width - (c->vx + c->vw), bottom);
	}

	if (c->vy > 0)
	{
		QPicTile(c, &q_pic_backtile, c->vx, 0, c->vw, c->vy);
		QPicTile(c, &q_pic_backtile, c->vx, c->vy + c->vh, c->vw,
			bottom - (c->vy + c->vh));
	}
}

U0 QSbarDraw(CQCanvas *c)
{//Draw the whole bar along the bottom of the canvas.
	CQPic	*icon;
	I64		 top;
	I64		 bx;
	I64		 health;
	I64		 armor;
	I64		 ammo;
	I64		 items;
	I64		 face;
	F64		 view;

	if (!q_sbar_ready || !q_player_active)
		return;

	//SCR_CalcRefdef's sb_lines. 120 hides the bar outright, 110 keeps the
	//status row but drops the inventory row above it.
	view = QCvarGet("viewsize");
	if (view >= 120.0)
		return;

	health = ToI64(QPlayerHealth);
	armor  = ToI64(QPlayerArmor);
	ammo   = ToI64(QPlayerAmmo);
	items  = ToI64(QPrFieldF(q_player_edict, q_fld_items));

	top = c->height - QSBAR_H;

	//The bar art is a fixed 320 wide. At higher resolutions the original
	//centres it along the bottom rather than stretching, so every element is
	//offset by the same base.
	bx = (c->width - q_pic_sbar.width) / 2;
	if (bx < 0)
		bx = 0;

	//Sbar_Draw tiles the strip first when the screen is wider than the art,
	//so the space either side of the bar carries the backdrop rather than
	//whatever the last frame left there.
	if (c->width > q_pic_sbar.width)
		QPicTile(c, &q_pic_backtile, 0, top - QSBAR_H, c->width,
			QSBAR_H * 2);

	//--- status line ---
	QPicDraw(c, &q_pic_sbar, bx, top);

	//Armor: the icon shows which grade is held, and is hidden entirely when
	//there is none, exactly as the original does.
	if (items & QIT_ARMOR3)
		icon = &q_pic_armor[2];
	else if (items & QIT_ARMOR2)
		icon = &q_pic_armor[1];
	else if (items & QIT_ARMOR1)
		icon = &q_pic_armor[0];
	else
		icon = NULL;

	if (icon && armor > 0)
	{
		QPicDraw(c, icon, bx + 0, top);
		QSbarNumber(c, bx + 24, top, armor, 3, FALSE);
	}

	//Face and health.
	face = QSbarFaceIndex(health);
	if (q_pic_faces[face].pixels)
		QPicDraw(c, &q_pic_faces[face], bx + 112, top);
	QSbarNumber(c, bx + 136, top, health, 3, FALSE);

	//Ammo: which icon depends on the weapon currently selected.
	icon = NULL;
	if (items & (QIT_SHOTGUN | QIT_SUPER_SHOTGUN))
		icon = &q_pic_ammo[0];
	if (items & (QIT_NAILGUN | QIT_SUPER_NAILGUN))
		icon = &q_pic_ammo[1];
	if (items & (QIT_GRENADE_LAUNCHER | QIT_ROCKET_LAUNCHER))
		icon = &q_pic_ammo[2];
	if (items & QIT_LIGHTNING)
		icon = &q_pic_ammo[3];

	if (icon)
		QPicDraw(c, icon, bx + 224, top);

	QSbarNumber(c, bx + 248, top, ammo, 3, TRUE);
}

U0 QSbarFill(CQCanvas *c, I64 x, I64 y, I64 w, I64 h, I64 color)
{//Draw_Fill: solid palette rect for scoreboard color bars.
	I64	 i;
	I64	 j;
	I64	 yy;
	I64	 xx;
	U8	*row;

	if (!c || !c->pixels || w < 1 || h < 1)
		return;

	color = color & 255;
	for (j = 0; j < h; j++)
	{
		yy = y + j;
		if (yy >= 0 && yy < c->height)
		{
			row = c->pixels + yy * c->width;
			for (i = 0; i < w; i++)
			{
				xx = x + i;
				if (xx >= 0 && xx < c->width)
					row[xx] = color;
			}
		}
	}
}

I64 QSbarColorForMap(I64 m)
{//Sbar_ColorForMap: player color nibble -> palette index.
	return (m & 255) + 8;
}

U0 QSbarDrawScoreboard(CQCanvas *c)
{//Sbar_DeathmatchOverlay (TAB). Ranking by frags, shirt/pants bars, name.
	I64		fragsort[QSV_MAX_CLIENTS];
	I64		n;
	I64		i;
	I64		j;
	I64		k;
	I64		tmp;
	I64		x;
	I64		y;
	I64		top;
	I64		bottom;
	I64		f;
	U8		line[40];

	if (!c)
		return;
	if (QCvarGet("deathmatch") == 0.0)
		return;

	n = 0;
	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (q_scores[i].active && q_scores[i].name[0])
		{
			fragsort[n] = i;
			n++;
		}
	}
	if (n < 1)
		return;

	for (i = 0; i < n; i++)
	{
		for (j = 0; j < n - 1 - i; j++)
		{
			if (q_scores[fragsort[j]].frags < q_scores[fragsort[j + 1]].frags)
			{
				tmp = fragsort[j];
				fragsort[j] = fragsort[j + 1];
				fragsort[j + 1] = tmp;
			}
		}
	}

	QStrDrawCenterAlt(c, 8, "FRAGS");

	x = (c->width - 200) / 2;
	if (x < 8)
		x = 8;
	y = 28;

	for (i = 0; i < n; i++)
	{
		k = fragsort[i];

		top    = q_scores[k].colors & 0xF0;
		bottom = (q_scores[k].colors & 15) << 4;
		top    = QSbarColorForMap(top);
		bottom = QSbarColorForMap(bottom);

		QSbarFill(c, x, y, 40, 4, top);
		QSbarFill(c, x, y + 4, 40, 4, bottom);

		f = q_scores[k].frags;
		StrPrint(line, "%3d", f);
		QStrDraw(c, x + 8, y, line);
		QStrDraw(c, x + 64, y, q_scores[k].name);

		y += 10;
	}
}
