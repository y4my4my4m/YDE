// QTest.ZC - staged self checks
//
// a wrong F32 decode gives geometry that looks plausible and is subtly warped,
// so run in-guest and print numbers to compare against the host

U0 QTestFmt()
{//known bit patterns through the binary32 decoder
	U8  buf[4];
	F64 v;

	"$$LTBLUE$$--- QFmt ---$$FG$$\n";

	//1.0f = 0x3F800000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x80; buf[3] = 0x3F;
	v = QRdF32(buf);
	"  1.0        -> %8.5f  %s\n", v, "expect 1.00000";

	//-2.5f = 0xC0200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0xC0;
	v = QRdF32(buf);
	"  -2.5       -> %8.5f  %s\n", v, "expect -2.50000";

	//0.15625f = 0x3E200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0x3E;
	v = QRdF32(buf);
	"  0.15625    -> %8.5f  %s\n", v, "expect 0.15625";

	//0.0f
	buf[0] = 0; buf[1] = 0; buf[2] = 0; buf[3] = 0;
	v = QRdF32(buf);
	"  0.0        -> %8.5f  %s\n", v, "expect 0.00000";

	//FFFFFFFF must come back -1 signed, 4294967295 raw
	buf[0] = 0xFF; buf[1] = 0xFF; buf[2] = 0xFF; buf[3] = 0xFF;
	"  I32 of FFFFFFFF -> %d  expect -1\n", QRdI32(buf);

	//0x00000180 = 384
	buf[0] = 0x80; buf[1] = 0x01; buf[2] = 0x00; buf[3] = 0x00;
	"  I32 of 00000180 -> %d  expect 384\n", QRdI32(buf);
	"  U16 of 0180     -> %d  expect 384\n", QRdU16(buf);

	//0xFF9C = -100 signed
	buf[0] = 0x9C; buf[1] = 0xFF;
	"  I16 of FF9C     -> %d  expect -100\n", QRdI16(buf);
}

U0 QTestPal()
{
	"$$LTBLUE$$--- QPal ---$$FG$$\n";

	if (!QPalLoad)
	{
		"  palette load FAILED\n";
		return;
	}

	//0 is black in the id palette, 15 the brightest grey
	"  loaded, colormap %s\n", "present";
	"  pal[0]   = %08X\n", qpal_argb[0];
	"  pal[15]  = %08X\n", qpal_argb[15];
	"  pal[255] = %08X\n", qpal_argb[255];
	"  colormap[0][0] = %d  colormap[63][0] = %d\n",
		qpal_colormap[0], qpal_colormap[63 * 256];
}

U0 QTestMap(U8 *mapname)
{
	CQMap *map;
	F64    lo[3];
	F64    hi[3];
	I64    i;
	I64    j;
	I64    solid = 0;

	"$$LTBLUE$$--- BSP %s ---$$FG$$\n", mapname;

	map = QBSPLoad(mapname);
	if (!map)
		return;

	QBSPReport(map);

	//cheapest end to end check on the F32 decoder, a broken mantissa or
	//exponent shows up as absurd extents
	for (j = 0; j < 3; j++)
	{
		lo[j] = 999999.0;
		hi[j] = -999999.0;
	}

	for (i = 0; i < map->num_vertices; i++)
	{
		for (j = 0; j < 3; j++)
		{
			if (map->vertices[i].pt[j] < lo[j])
				lo[j] = map->vertices[i].pt[j];
			if (map->vertices[i].pt[j] > hi[j])
				hi[j] = map->vertices[i].pt[j];
		}
	}

	"  vert bounds  x %8.1f .. %8.1f\n", lo[0], hi[0];
	"               y %8.1f .. %8.1f\n", lo[1], hi[1];
	"               z %8.1f .. %8.1f\n", lo[2], hi[2];

	for (i = 0; i < map->num_leafs; i++)
	{
		if (map->leafs[i].contents == QCONTENTS_SOLID)
			solid++;
	}
	"  solid leafs  %d of %d\n", solid, map->num_leafs;

	//real names prove the miptex walk landed on real headers
	"  textures:";
	for (i = 0; i < 5 && i < map->num_textures; i++)
		" %s(%dx%d)", map->textures[i].name, map->textures[i].width,
			map->textures[i].height;
	"\n";

	//model 0 is worldspawn, it should span the level
	if (map->num_models > 0)
	{
		"  model0 mins  %8.1f %8.1f %8.1f\n",
			map->models[0].mins[0], map->models[0].mins[1], map->models[0].mins[2];
		"  model0 maxs  %8.1f %8.1f %8.1f\n",
			map->models[0].maxs[0], map->models[0].maxs[1], map->models[0].maxs[2];
	}

	QBSPFree(map);
}

I64 QTestFlag(Bool b)
{//GOTCHA: ToI64 on a Bool reads the seven bytes past it, which is where the
 //1819242241 attack flag came from. branch, don't cast
	if (b)
		return 1;

	return 0;
}

U0 QTestNetDelta()
{//a wrong mask bit still makes a well formed message carrying the wrong field,
 //and the client accumulates that error forever
	CQMsg		m;
	CQEntState	now;
	CQEntState	was;
	F64			mv[3];
	I64			bits;

	"$$LTBLUE$$--- QNet delta ---$$FG$$\n";

	QNetStatesClear;
	QMsgClear(&m);

	QNetStateClear(&was);
	QNetStateClear(&now);

	//one axis and the frame, nothing else may go on the wire
	now.origin[0] = 64.0;
	now.frame     = 3;

	QNetWriteEntityUpdate(&m, 12, &now, &was);
	"  moved x + frame -> %d bytes  %s\n", m.len,
		"expect 5: mask, num, frame, coord lo, coord hi";

	//high bit set on the first byte, stripped before the mask goes on, same as
	//the client message loop does
	bits = QMsgReadByte(&m);
	"  signal bit  -> %8d  %s\n", QTestFlag(ToBool(bits & QU_SIGNAL)), "expect 1";
	bits &= 127;

	if (QNetReadEntityUpdate(&m, bits))
	{
		"  client x    -> %8.3f  %s\n", q_net_cl[12].origin[0], "expect 64.000";
		"  client frame-> %8d  %s\n", q_net_cl[12].frame,       "expect 3";
		"  client y    -> %8.3f  %s\n", q_net_cl[12].origin[1], "expect 0.000";
		"  client model-> %8d  %s\n", q_net_cl[12].modelindex,  "expect 0";
	}
	else
		"  delta       -> FAILED to apply\n";

	//an entity matching its baseline still costs mask + number, two bytes. in
	//nq that pair IS the still-visible signal, suppress it and an idle entity
	//looks like one that left the pvs
	QMsgClear(&m);
	QNetWriteEntityUpdate(&m, 12, &was, &was);
	"  unchanged   -> %d bytes  %s\n", m.len, "expect 2: mask, num";

	//below a tenth of a unit no origin bit, the coord format can't represent
	//the difference anyway
	QMsgClear(&m);
	QNetStateClear(&now);
	now.origin[0] = 0.05;
	QNetWriteEntityUpdate(&m, 12, &now, &was);
	bits = QMsgReadByte(&m) & 127;
	"  0.05 move   -> origin bit %d  %s\n",
		QTestFlag(ToBool(bits & QU_ORIGIN1)), "expect 0";

	QMsgClear(&m);
	QNetStateClear(&now);
	now.origin[0] = 0.5;
	QNetWriteEntityUpdate(&m, 12, &now, &was);
	bits = QMsgReadByte(&m) & 127;
	"  0.50 move   -> origin bit %d  %s\n",
		QTestFlag(ToBool(bits & QU_ORIGIN1)), "expect 1";

	//above 255 the entity number switches to the long form
	QMsgClear(&m);
	QNetStateClear(&now);
	now.origin[2] = -8.0;
	QNetWriteEntityUpdate(&m, 300, &now, &was);
	bits = QMsgReadByte(&m) & 127;
	if (bits & QU_MOREBITS)
		bits |= QMsgReadByte(&m) << 8;
	"  ent 300     -> longentity %d  %s\n", QTestFlag(ToBool(bits & QU_LONGENTITY)),
		"expect 1";

	//--- codecs added for svc_time and svc_clientdata ---
	QMsgClear(&m);
	QMsgWriteFloat(&m, 12.5);
	QMsgWriteChar(&m, -7);
	QMsgWriteChar(&m, 120);
	QMsgWriteLong(&m, -3);

	"  float       -> %8.3f  %s\n", QMsgReadFloat(&m),  "expect 12.500";
	"  char neg    -> %8d  %s\n", QMsgReadChar(&m),     "expect -7";
	"  char pos    -> %8d  %s\n", QMsgReadChar(&m),     "expect 120";
	"  long neg    -> %8d  %s\n", QMsgReadLong(&m),     "expect -3";

	//--- upstream: clc_move round trip ---
	//
	//client encoder into the server decoder, no shared state between them.
	//entity 0 so the reader touches no edict. stock layout, no trailing coords
	QNetInit;
	QNetClientClear;

	QVecSet(mv, 10.0, 20.0, 30.0);
	QNetClientSendMove(mv, 400.0, -200.0, 0.0, TRUE, FALSE, 5, 0.0);

	if (QNetServerGetMessage(&m))
	{
		m.read    = 0;
		m.badread = FALSE;

		//byte + float + 3 angles + 3 shorts + buttons + impulse = 16
		"  clc_move len-> %8d  %s\n", m.len, "expect 16 (stock, no origin)";

		"  clc byte    -> %8d  %s\n", QMsgReadByte(&m), "expect 3 (clc_move)";

		if (QNetServerReadMove(&m, 0, 0.0))
		{
			"  move fwd    -> %8.1f  %s\n", q_net_move_cmd[0], "expect 400.0";
			"  move side   -> %8.1f  %s\n", q_net_move_cmd[1], "expect -200.0";
			"  move attack -> %8d  %s\n", QTestFlag(q_net_move_attack), "expect 1";
			"  move jump   -> %8d  %s\n", QTestFlag(q_net_move_jump),   "expect 0";
			"  move impulse-> %8d  %s\n", q_net_move_impulse,       "expect 5";

			//angles only survive to 256 steps per turn, so 20 degrees
			//comes back as the nearest step
			"  move yaw    -> %8.2f  %s\n", q_net_move_angles[1],
				"expect ~19.69 (256 steps/turn)";

			"  move unread -> %8d  %s\n", m.len - m.read, "expect 0";
		}
		else
			"  clc_move    -> FAILED to read\n";
	}
	else
		"  clc_move    -> NOT QUEUED\n";

	//CL_ParseUpdate seeds from the baseline on first sight, without that an
	//entity arrives with modelindex 0 and never draws
	QNetStatesClear;
	q_net_baseline[40].modelindex = 9;
	q_net_baseline[40].origin[0]  = 100.0;

	QMsgClear(&m);
	QNetStateClear(&now);
	now.modelindex = 9;
	now.origin[0]  = 100.0;
	now.frame      = 2;
	QNetWriteEntityUpdate(&m, 40, &now, &q_net_baseline[40]);

	bits = QMsgReadByte(&m) & 127;
	QNetReadEntityUpdate(&m, bits);
	"  seeded model-> %8d  %s\n", q_net_cl[40].modelindex, "expect 9";
	"  seeded x    -> %8.3f  %s\n", q_net_cl[40].origin[0], "expect 100.000";
	"  seeded frame-> %8d  %s\n", q_net_cl[40].frame,       "expect 2";
}

U0 QTestDgrmHdr()
{//winquake datagram headers are big endian U32 pairs, CTL is one word, DATA
 //reliable is flags|length then sequence
	U8	 buf[8];
	U32	 word;
	U32	 flags;
	U32	 len;
	U32	 seq;

	"$$LTBLUE$$--- QNet dgrm hdr ---$$FG$$\n";

	//CTL: NETFLAG_CTL | payload length, 4 byte header
	word = QNETFLAG_CTL | 12;
	QNetWriteBigLong(buf, word);
	word = QNetReadBigLong(buf);
	flags = word & ~QNETFLAG_LENGTH_MASK;
	len   = word & QNETFLAG_LENGTH_MASK;
	"  ctl flags  -> %08X  %s\n", flags, "expect 80000000";
	"  ctl length -> %8d  %s\n", len, "expect 12";

	//DATA|EOM reliable: 8 byte header, flags|length then sequence
	seq  = 42;
	word = QNETFLAG_DATA | QNETFLAG_EOM | 100;
	QNetWriteBigLong(buf, word);
	QNetWriteBigLong(buf + 4, seq);
	word = QNetReadBigLong(buf);
	seq  = QNetReadBigLong(buf + 4);
	flags = word & ~QNETFLAG_LENGTH_MASK;
	len   = word & QNETFLAG_LENGTH_MASK;
	"  data flags -> %08X  %s\n", flags, "expect 00090000";
	"  data len   -> %8d  %s\n", len, "expect 100";
	"  data seq   -> %8d  %s\n", seq, "expect 42";

	//BigLong is its own inverse
	word = QNetBigLong(QNetBigLong(0x12345678));
	"  biglong    -> %08X  %s\n", word, "expect 12345678";
}

U0 QTestDgrmFrame()
{//framing with no nic. encode on sock a, process on b through QNetDgrmProcess,
 //the same path Recv takes after demux
	CQNetSock	*a;
	CQNetSock	*b;
	CQMsg		m;
	CQMsg		out;
	U8			 pkt[QNET_MAX_DATAGRAM + QNET_HEADERSIZE];
	I64			 packet_len;
	I64			 ret;
	U32			 word;
	U32			 flags;
	U32			 len;
	U32			 seq;

	"$$LTBLUE$$--- QNet dgrm frame ---$$FG$$\n";

	a = &q_net_socks[0];
	b = &q_net_socks[1];
	QNetSockClear(a);
	QNetSockClear(b);
	a->active = TRUE;
	a->ip     = 0x0200000A;	//10.0.0.2 host order
	b->active = TRUE;
	b->ip     = 0x0100000A;	//10.0.0.1

	//mirrors the QNetDgrmSendUnreliable header layout
	QMsgClear(&m);
	QMsgWriteByte(&m, 7);
	QMsgWriteLong(&m, 0x11223344);
	packet_len = QNET_HEADERSIZE + m.len;
	QNetWriteBigLong(pkt, packet_len | QNETFLAG_UNRELIABLE);
	QNetWriteBigLong(pkt + 4, a->unrel_send_seq++);
	MemCopy(pkt + QNET_HEADERSIZE, m.data, m.len);

	word  = QNetReadBigLong(pkt);
	flags = word & ~QNETFLAG_LENGTH_MASK;
	len   = word & QNETFLAG_LENGTH_MASK;
	seq   = QNetReadBigLong(pkt + 4);
	"  unrel flags-> %08X  %s\n", flags, "expect 00100000";
	"  unrel len  -> %8d  %s\n", len, "expect 13";
	"  unrel seq  -> %8d  %s\n", seq, "expect 0";

	ret = QNetDgrmProcess(b, pkt, packet_len, &out);
	"  unrel ret  -> %8d  %s\n", ret, "expect 2";
	"  unrel byte -> %8d  %s\n", out.data[0], "expect 7";
	"  unrel long -> %08X  %s\n",
		out.data[1] | (out.data[2] << 8) | (out.data[3] << 16) | (out.data[4] << 24),
		"expect 11223344";

	//single chunk DATA|EOM, the ack may fail with no nic
	QMsgClear(&m);
	QMsgWriteByte(&m, QSVC_NOP);
	QMsgWriteString(&m, "hi");
	MemCopy(a->send_msg, m.data, m.len);
	a->send_len    = m.len;
	a->send_offset = 0;
	a->can_send    = FALSE;
	packet_len = QNET_HEADERSIZE + m.len;
	QNetWriteBigLong(pkt, packet_len | QNETFLAG_DATA | QNETFLAG_EOM);
	QNetWriteBigLong(pkt + 4, a->send_seq++);
	MemCopy(pkt + QNET_HEADERSIZE, a->send_msg, m.len);

	ret = QNetDgrmProcess(b, pkt, packet_len, &out);
	"  rel ret    -> %8d  %s\n", ret, "expect 1";
	"  rel svc    -> %8d  %s\n", out.data[0], "expect 1";
	"  b recv_seq -> %8d  %s\n", b->recv_seq, "expect 1";

	QNetSockClear(a);
	"  clear send -> %8d  %s\n", a->can_send, "expect 1";

	QNetDgrmInit;
}

U0 QTestNet()
{//round trip the wire codecs. these formats are shared with demo files and
 //other clients, an off by one in the scaling isn't a local matter
	CQMsg	m;
	U8		str[32];
	F64		f;
	I64		i;

	"$$LTBLUE$$--- QNet ---$$FG$$\n";

	QNetInit;
	QMsgClear(&m);

	QMsgWriteByte(&m, 200);
	QMsgWriteShort(&m, -1234);
	QMsgWriteLong(&m, 0x12345678);

	//coords quantise to eighths, so 12.5 survives exactly and this stays a test
	//of the codec, not of rounding
	QMsgWriteCoord(&m, 12.5);
	QMsgWriteCoord(&m, -300.25);

	//256 steps per turn, so 90 degrees is exactly 64
	QMsgWriteAngle(&m, 90.0);
	QMsgWriteString(&m, "hello");

	"  wrote %d bytes, overflowed %d  %s\n", m.len, m.overflowed,
		"expect 0 overflow";

	i = QMsgReadByte(&m);
	"  byte       -> %10d  %s\n", i, "expect 200";

	i = QMsgReadShort(&m);
	"  short      -> %10d  %s\n", i, "expect -1234";

	i = QMsgReadLong(&m);
	"  long       -> %10X  %s\n", i, "expect 12345678";

	f = QMsgReadCoord(&m);
	"  coord      -> %10.4f  %s\n", f, "expect 12.5000";

	f = QMsgReadCoord(&m);
	"  coord      -> %10.4f  %s\n", f, "expect -300.2500";

	f = QMsgReadAngle(&m);
	"  angle      -> %10.4f  %s\n", f, "expect 90.0000";

	QMsgReadString(&m, str, 32);
	"  string     -> '%s'  %s\n", str, "expect 'hello'";

	"  badread    -> %10d  %s\n", m.badread, "expect 0";

	//overread must be caught, not walk off the buffer
	QMsgReadLong(&m);
	"  overread   -> badread %d  %s\n", m.badread, "expect 1";

	//loopback must deliver a whole message unchanged
	QMsgClear(&q_net_send);
	QMsgWriteByte(&q_net_send, QSVC_TIME);
	QMsgWriteCoord(&q_net_send, 64.0);

	if (QNetSendToClient(&q_net_send) && QNetGetMessage(&m))
	{
		i = QMsgReadByte(&m);
		f = QMsgReadCoord(&m);
		"  loopback   -> svc %d coord %6.1f  %s\n", i, f, "expect svc 7 / 64.0";
	}
	else
		"  loopback   -> FAILED to round-trip\n";

	QTestDgrmHdr;
	QTestDgrmFrame;
	QTestNetDelta;
}

U0 QTest()
{
	"\n$$GREEN$$===== Quake data layer self-test =====$$FG$$\n\n";

	QPakInit;
	if (!QPakMount("::/Apps/Quake/id1/PAK0.PAK"))
	{
		"Cannot continue without PAK0.PAK\n";
		return;
	}

	QTestFmt;
	QTestNet;
	QTestPal;
	QTestMap("maps/e1m1.bsp");

	"\n$$GREEN$$===== done =====$$FG$$\n";
}
