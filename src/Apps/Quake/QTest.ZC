// QTest.ZC - staged self-checks.
//
// The renderer is worthless if the byte readers are wrong, and a wrong F32
// decode produces geometry that looks plausible but is subtly warped. These
// checks run in-guest and print numbers that can be compared against the host.

U0 QTestFmt()
{//Known bit patterns through the binary32 decoder.
	U8  buf[4];
	F64 v;

	"$$LTBLUE$$--- QFmt ---$$FG$$\n";

	//1.0f = 0x3F800000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x80; buf[3] = 0x3F;
	v = QRdF32(buf);
	"  1.0        -> %8.5f  %s\n", v, "expect 1.00000";

	//-2.5f = 0xC0200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0xC0;
	v = QRdF32(buf);
	"  -2.5       -> %8.5f  %s\n", v, "expect -2.50000";

	//0.15625f = 0x3E200000
	buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x20; buf[3] = 0x3E;
	v = QRdF32(buf);
	"  0.15625    -> %8.5f  %s\n", v, "expect 0.15625";

	//0.0f
	buf[0] = 0; buf[1] = 0; buf[2] = 0; buf[3] = 0;
	v = QRdF32(buf);
	"  0.0        -> %8.5f  %s\n", v, "expect 0.00000";

	//Integer readers. 0xFFFFFFFF must come back as -1 signed, 4294967295 raw.
	buf[0] = 0xFF; buf[1] = 0xFF; buf[2] = 0xFF; buf[3] = 0xFF;
	"  I32 of FFFFFFFF -> %d  expect -1\n", QRdI32(buf);

	//0x00000180 = 384
	buf[0] = 0x80; buf[1] = 0x01; buf[2] = 0x00; buf[3] = 0x00;
	"  I32 of 00000180 -> %d  expect 384\n", QRdI32(buf);
	"  U16 of 0180     -> %d  expect 384\n", QRdU16(buf);

	//0xFF9C = -100 signed
	buf[0] = 0x9C; buf[1] = 0xFF;
	"  I16 of FF9C     -> %d  expect -100\n", QRdI16(buf);
}

U0 QTestPal()
{
	"$$LTBLUE$$--- QPal ---$$FG$$\n";

	if (!QPalLoad)
	{
		"  palette load FAILED\n";
		return;
	}

	//Index 0 is black in the id palette; index 15 is the brightest grey.
	"  loaded, colormap %s\n", "present";
	"  pal[0]   = %08X\n", qpal_argb[0];
	"  pal[15]  = %08X\n", qpal_argb[15];
	"  pal[255] = %08X\n", qpal_argb[255];
	"  colormap[0][0] = %d  colormap[63][0] = %d\n",
		qpal_colormap[0], qpal_colormap[63 * 256];
}

U0 QTestMap(U8 *mapname)
{
	CQMap *map;
	F64    lo[3];
	F64    hi[3];
	I64    i;
	I64    j;
	I64    solid = 0;

	"$$LTBLUE$$--- BSP %s ---$$FG$$\n", mapname;

	map = QBSPLoad(mapname);
	if (!map)
		return;

	QBSPReport(map);

	//Vertex bounds are the cheapest end-to-end check on the F32 decoder: a
	//broken mantissa or exponent shows up immediately as absurd extents.
	for (j = 0; j < 3; j++)
	{
		lo[j] = 999999.0;
		hi[j] = -999999.0;
	}

	for (i = 0; i < map->num_vertices; i++)
	{
		for (j = 0; j < 3; j++)
		{
			if (map->vertices[i].pt[j] < lo[j])
				lo[j] = map->vertices[i].pt[j];
			if (map->vertices[i].pt[j] > hi[j])
				hi[j] = map->vertices[i].pt[j];
		}
	}

	"  vert bounds  x %8.1f .. %8.1f\n", lo[0], hi[0];
	"               y %8.1f .. %8.1f\n", lo[1], hi[1];
	"               z %8.1f .. %8.1f\n", lo[2], hi[2];

	for (i = 0; i < map->num_leafs; i++)
	{
		if (map->leafs[i].contents == QCONTENTS_SOLID)
			solid++;
	}
	"  solid leafs  %d of %d\n", solid, map->num_leafs;

	//First few texture names prove the miptex walk landed on real headers.
	"  textures:";
	for (i = 0; i < 5 && i < map->num_textures; i++)
		" %s(%dx%d)", map->textures[i].name, map->textures[i].width,
			map->textures[i].height;
	"\n";

	//Worldspawn model 0 should span the whole level.
	if (map->num_models > 0)
	{
		"  model0 mins  %8.1f %8.1f %8.1f\n",
			map->models[0].mins[0], map->models[0].mins[1], map->models[0].mins[2];
		"  model0 maxs  %8.1f %8.1f %8.1f\n",
			map->models[0].maxs[0], map->models[0].maxs[1], map->models[0].maxs[2];
	}

	QBSPFree(map);
}

U0 QTest()
{
	"\n$$GREEN$$===== Quake data layer self-test =====$$FG$$\n\n";

	QPakInit;
	if (!QPakMount("::/Apps/Quake/id1/PAK0.PAK"))
	{
		"Cannot continue without PAK0.PAK\n";
		return;
	}

	QTestFmt;
	QTestPal;
	QTestMap("maps/e1m1.bsp");

	"\n$$GREEN$$===== done =====$$FG$$\n";
}
