// Run.ZC - build and launch entry point.
//
// ZealC compiles in a single pass, so include order is load-bearing: a file
// may only reference symbols defined in an earlier one.
//
//   QFmt  byte readers            (no deps)
//   QPak  archive                 -> QFmt
//   QPal  palette/colormap        -> QPak
//   QMath vectors, view basis     (no deps)
//   QBSP  map loader              -> QFmt, QPak
//   QVis  PVS + traversal         -> QMath, QBSP
//   QPhys collision + movement    -> QMath, QBSP
//   QDraw rasterizer              -> QMath, QBSP, QPal, QVis
//   QMDL  alias models            -> QDraw, QBSP
//   QProgs QuakeC bytecode VM     -> QFmt, QPak, QMath
//   QBuiltin QuakeC engine calls  -> QProgs, QPhys, QMDL
//   QEnt  entities + spawning     -> QMath, QBSP, QMDL
//   QNetUdp real transport         -> QNet (+ ::/Home/Net if loaded)
//   QNetSv server datagram/client parse -> QNet, QNetUdp, QProgs, QGame, QVis
//   QTest self-checks             -> everything above
//   Quake app shell               -> everything above

Cd(__DIR__);;

#include "QFmt"
#include "QPak"
#include "QPal"
#include "QMath"
#include "QNet"

// The net stack is NOT pulled in here. Loading it costs a NIC probe that
// THROWS when nothing supported is present, plus the whole TCP/TLS/HTTP tree,
// and single player needs none of it. RunNet.ZC in this directory loads it and
// then this file; QNetUdp.ZC compiles to working code or to stubs depending on
// whether it is already there.

#include "QNetUdp"
#include "QNetDgrm"
#include "QDemo"
#include "QBSP"
#include "QVis"
#include "QPhys"
#include "QDraw"
#include "QMDL"
#include "QPart"
#include "QSound"
#include "QWad"
#include "QProgs"
#include "QClip"
#include "QBuiltin"
#include "QEnt"
#include "QGame"
#include "QNetSv"
#include "QSave"
#include "QPlayer"
#include "QSbar"
#include "QMenu"
#include "QTest"
#include "Quake"

Quake;

//QTest is deliberately NOT run here. Quake calls DocClear on startup, so
//anything printed beforehand is wiped before it can be read. The symbols stay
//compiled into this task, so run the self-check from the prompt after quitting:
//
//    QTest;
//
//It prints the data-layer numbers to compare against README.md.
"\nType $$LTBLUE$$QTest;$$FG$$ to run the data-layer self-check.\n";
