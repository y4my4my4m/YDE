// QBuiltin.ZC - the engine services QuakeC calls into.
//
// A QuakeC function whose first_statement is negative is a builtin: the
// negated value is its number. The shareware image references 65 of them in
// the range 1..78.
//
// Arguments arrive in the reserved parameter cells and results go in the
// return cell. Anything not implemented is a deliberate no-op that returns
// zero rather than an error, so an unimplemented service degrades the game
// instead of halting the VM mid-frame.

#define QBI_MAX_PRECACHE	256

//NOTE: this must be a function, not a #define. ZealC's #define substitutes a
//bare token only - it has no parameters - so a function-like macro parses its
//"(n)" as code and fails with "Invalid class".

CQMap	*q_bi_map		= NULL;		//set by the app before the VM runs
Bool	 q_bi_dprint	= FALSE;	//QuakeC debug output is noisy; off by default

//These MUST be cleared explicitly at init. The JIT does not zero globals, so
//an unassigned slot holds heap garbage - and freeing the precache walks every
//slot, which turns that garbage into a wild Free().
U8		*q_precache_model[QBI_MAX_PRECACHE];

//Backing storage for the reserved world entry and its "*N" submodel names -
//the precache table holds borrowed pointers and these must outlive the map.
U8		 q_world_model_name[96];
U8		 q_submodel_names[QBI_MAX_PRECACHE * 8];
CQMdl	*q_precache_mdl[QBI_MAX_PRECACHE];
CQMap	*q_precache_bsp[QBI_MAX_PRECACHE];	//external .bsp models
I64		 q_precache_model_count = 0;
U8		*q_precache_sound[QBI_MAX_PRECACHE];
I64		 q_precache_sound_count = 0;

//Trace result globals, resolved by name at init.
I64 q_ofs_trace_allsolid	= -1;
I64 q_ofs_trace_startsolid	= -1;
I64 q_ofs_trace_fraction	= -1;
I64 q_ofs_trace_endpos		= -1;
I64 q_ofs_trace_plane_normal = -1;
I64 q_ofs_trace_plane_dist	= -1;
I64 q_ofs_trace_ent			= -1;
I64 q_ofs_trace_inopen		= -1;
I64 q_ofs_trace_inwater		= -1;

U8 q_bi_err_line[256];

//--- cvars -----------------------------------------------------------------
//
//QuakeC reads engine console variables through the cvar builtin, and progs.dat
//queries exactly ten of them: registered, skill, deathmatch, coop, teamplay,
//samelevel, noexit, fraglimit, timelimit and temp1. Returning a hardcoded 0 for
//all of them is what produced the shareware nag - trigger_onlyregistered_touch
//tests cvar("registered") and prints the "you'll never know what awaits you"
//text when it reads false, no matter which PAKs are actually present.

#define QCVAR_MAX	32

class CQCvar
{
	U8	name[24];
	F64	value;
};

CQCvar	q_cvars[QCVAR_MAX];
I64		q_cvar_count = 0;

U0 QCvarDefine(U8 *name, F64 value)
{
	if (q_cvar_count >= QCVAR_MAX)
		return;

	QStrCopy(q_cvars[q_cvar_count].name, name, 24);
	q_cvars[q_cvar_count].value = value;
	q_cvar_count++;
}

I64 QCvarIndex(U8 *name)
{
	I64 i;

	for (i = 0; i < q_cvar_count; i++)
		if (!StrICompare(q_cvars[i].name, name))
			return i;

	return -1;
}

F64 QCvarGet(U8 *name)
{//Unknown names read as 0, which is how Cvar_VariableValue behaves.
	I64 i = QCvarIndex(name);

	if (i < 0)
		return 0.0;

	return q_cvars[i].value;
}

U0 QCvarSet(U8 *name, F64 value)
{//Setting a name that does not exist creates it, as Cvar_Set does for
 //cvar_set from progs.
	I64 i = QCvarIndex(name);

	if (i < 0)
		QCvarDefine(name, value);
	else
		q_cvars[i].value = value;
}

U0 QCvarInit()
{//The original's own registration defaults.
	q_cvar_count = 0;

	QCvarDefine("r_ambient",	0.0);
	QCvarDefine("ambient_level", 0.3);
	QCvarDefine("ambient_fade", 100.0);
	QCvarDefine("viewsize",		100.0);
	QCvarDefine("registered",	0.0);
	QCvarDefine("skill",		1.0);
	QCvarDefine("deathmatch",	0.0);
	QCvarDefine("coop",			0.0);
	QCvarDefine("teamplay",		0.0);
	QCvarDefine("samelevel",	0.0);
	QCvarDefine("noexit",		0.0);
	QCvarDefine("fraglimit",	0.0);
	QCvarDefine("timelimit",	0.0);
	QCvarDefine("temp1",		0.0);
	QCvarDefine("developer",	0.0);

	//NOT an original Quake cvar - cheats in NQ are plain commands (god, noclip,
	//fly, give, impulse 9) with no gate in front of them. Registered anyway
	//because it is the first thing anyone types, and a cvar that reads back is
	//less confusing than "unknown command" for something that sounds standard.
	QCvarDefine("sv_cheats",	1.0);

	//Draw entities from the CLIENT's reconstructed table rather than from the
	//server's edicts. Off by default while the two paths are being compared.
	QCvarDefine("cl_netdraw",	0.0); // host draws edicts; guest forces wire path

	QCvarDefine("sv_gravity",	800.0);
}

//--- helpers ---------------------------------------------------------------

I64 QBiArg(I64 n)
{//Global offset of argument n. Each slot is three cells wide so a vector fits
 //without a special case.
	return QPR_OFS_PARM0 + n * QPR_PARM_STRIDE;
}

F64 QBiArgF(I64 n)
{
	return QPrGetF(QBiArg(n));
}

I64 QBiArgI(I64 n)
{
	return QPrGetI(QBiArg(n));
}

U0 QBiArgV(I64 n, F64 *out)
{
	QPrGetV(QBiArg(n), out);
}

U8 *QBiArgS(I64 n)
{
	return QPrStr(QPrGetI(QBiArg(n)));
}

I64 QBiArgEnt(I64 n)
{
	return QPrEdictNum(QPrGetI(QBiArg(n)));
}

U0 QBiRetF(F64 v)
{
	QPrSetF(QPR_OFS_RETURN, v);
}

U0 QBiRetV(F64 *v)
{
	QPrSetV(QPR_OFS_RETURN, v);
}

U0 QBiRetEnt(I64 num)
{
	QPrSetI(QPR_OFS_RETURN, QPrEdictValue(num));
}

U0 QBiGetFieldV(I64 ent, I64 fld, F64 *out)
{
	out[0] = QPrFieldF(ent, fld);
	out[1] = QPrFieldF(ent, fld + 1);
	out[2] = QPrFieldF(ent, fld + 2);
}

U0 QBiSetFieldV(I64 ent, I64 fld, F64 *v)
{
	QPrSetFieldF(ent, fld, v[0]);
	QPrSetFieldF(ent, fld + 1, v[1]);
	QPrSetFieldF(ent, fld + 2, v[2]);
}

U0 QBiPrecacheWorld(CQMap *map, U8 *mapname)
{//SV_SpawnServer's fixed reservation: slot 1 is the world, slots 2..N are its
 //inline submodels "*1".."*(n-1)", before any QuakeC spawn can precache
 //anything else.
 //
 //Order is not cosmetic. A real client builds its model table straight from
 //this list and loads entry 1 as the world, then resolves "*N" against the
 //submodels that world registered. Filling the table lazily from whichever
 //setmodel ran first can put "*1" at index 1, and the client then fails with
 //"Model *1 not found" because no world has been loaded to resolve it against.
	I64	 i;
	I64	 n;
	U8	*s;

	if (!mapname || !mapname[0])
		return;

	q_precache_model[0]    = NULL;
	q_precache_mdl[0]      = NULL;
	q_precache_model_count = 1;

	//Slot 1: the world. Copied, since the caller's buffer is reused per map.
	QStrCopy(q_world_model_name, mapname, 96);
	q_precache_model[1] = q_world_model_name;
	q_precache_mdl[1]   = NULL;
	q_precache_model_count = 2;

	if (!map)
		return;

	//q_precache_model is the smaller of the two tables, so it sets the bound.
	n = map->num_models;
	if (n > QBI_MAX_PRECACHE - 2)
		n = QBI_MAX_PRECACHE - 2;

	for (i = 1; i < n; i++)
	{
		if (q_precache_model_count >= QBI_MAX_PRECACHE)
			break;

		s = q_submodel_names + (i - 1) * 8;
		StrPrint(s, "*%d", i);

		q_precache_model[q_precache_model_count] = s;
		q_precache_mdl[q_precache_model_count]   = NULL;
		q_precache_bmodel[q_precache_model_count] = i;
		q_precache_model_count++;
	}
}

//--- external brush models --------------------------------------------------
//
// Ammo boxes, health boxes and the exploding crate are not alias models: they
// are whole .bsp files inside the PAK, loaded with setmodel("maps/b_shell0.bsp").
// Handling only "*N" submodels and ".mdl" meant every one of them loaded as
// nothing - invisible, and with no bounding box for droptofloor to stand on,
// which is where the "Bonus item fell out of level" flood came from.

#define QBSP_CACHE_MAX	24
#define QBSP_NAME_MAX	64

U8		 q_bsp_cache_name[QBSP_CACHE_MAX * QBSP_NAME_MAX];
CQMap	*q_bsp_cache_map[QBSP_CACHE_MAX];
I64		 q_bsp_cache_count = 0;

Bool QBiIsBspName(U8 *name)
{
	I64 n;

	if (!name || name[0] == '*')
		return FALSE;

	n = StrLen(name);
	if (n < 5)
		return FALSE;

	return ToBool(!StrICompare(name + n - 4, ".bsp"));
}

CQMap *QBiBspCacheGet(U8 *name)
{//One copy of each external brush model, loaded on first request.
	I64 i;

	if (!QBiIsBspName(name))
		return NULL;

	for (i = 0; i < q_bsp_cache_count; i++)
	{
		if (!StrICompare(&q_bsp_cache_name[i * QBSP_NAME_MAX], name))
			return q_bsp_cache_map[i];
	}

	if (q_bsp_cache_count >= QBSP_CACHE_MAX)
		return NULL;

	i = q_bsp_cache_count;
	QStrCopy(&q_bsp_cache_name[i * QBSP_NAME_MAX], name, QBSP_NAME_MAX);
	q_bsp_cache_map[i] = QBSPLoad(name);
	q_bsp_cache_count++;

	return q_bsp_cache_map[i];
}

U0 QBiBspCacheFree()
{//Released with the map. Nothing else may free these.
	I64 i;

	for (i = 0; i < q_bsp_cache_count; i++)
	{
		if (q_bsp_cache_map[i])
			QBSPFree(q_bsp_cache_map[i]);

		q_bsp_cache_map[i] = NULL;
		q_bsp_cache_name[i * QBSP_NAME_MAX] = 0;
	}

	q_bsp_cache_count = 0;
}

I64 QBiPrecacheModel(U8 *name)
{//Index 0 means "no model", so real entries start at 1.
	I64 i;

	for (i = 1; i < q_precache_model_count; i++)
	{
		if (!StrCompare(q_precache_model[i], name))
			return i;
	}

	if (q_precache_model_count >= QBI_MAX_PRECACHE)
		return 0;

	if (!q_precache_model_count)
	{
		//Reserve slot 0 as "no model", and make sure it is explicitly empty
		//rather than left at whatever the global happened to contain.
		q_precache_model[0] = NULL;
		q_precache_mdl[0]   = NULL;
		q_precache_model_count = 1;
	}

	i = q_precache_model_count;
	q_precache_model_count++;

	q_precache_model[i] = name;
	q_precache_mdl[i]   = NULL;

	//Brush models ("*N") live in the map; only alias models load here.
	if (name[0] != '*' && StrLen(name) > 4 &&
		!StrICompare(name + StrLen(name) - 4, ".mdl"))
		q_precache_mdl[i] = QMdlCacheGet(name);

	//An external .bsp is a brush model in its own file.
	q_precache_bsp[i] = QBiBspCacheGet(name);

	//Record which BSP brush model this slot refers to, if any. Collision needs
	//that translation: .modelindex is this slot, not the BSP model number.
	if (name[0] == '*' && i < QCLIP_MAX_PRECACHE)
		q_precache_bmodel[i] = ToI64(QAtoF(name + 1));

	return i;
}

CQMdl *QBiFindModel(U8 *name)
{//Look up an already-precached alias model. Used by the view-model renderer,
 //which learns the weapon's name from QuakeC rather than loading it itself.
	I64 i;

	if (!name || !name[0])
		return NULL;

	for (i = 1; i < q_precache_model_count; i++)
	{
		if (q_precache_model[i] && !StrICompare(q_precache_model[i], name))
			return q_precache_mdl[i];
	}

	return NULL;
}

//--- static entities -------------------------------------------------------
//
// makestatic() takes an entity that will never move, think or be touched again
// (torches, gibs that have settled, decorative models) and hands it to the
// client permanently. The edict is then freed, which is the point: a large map
// would otherwise burn hundreds of edict slots on scenery.
//
// So the drawable state is copied out here and the edict released.

#define QBI_MAX_STATIC	256

class CQStaticEnt
{
	CQMdl	*mdl;
	F64		 origin[3];
	F64		 angles[3];
	I64		 frame;
};

CQStaticEnt	q_static_ent[QBI_MAX_STATIC];
I64			q_static_count = 0;

U0 QBiStaticClear()
{
	q_static_count = 0;
}

#define QMSG_BROADCAST	0
#define QMSG_ONE		1
#define QMSG_ALL		2
#define QMSG_INIT		3

CQMsg *QBiWriteDest()
{//WriteDest(). Argument 0 of every Write* builtin names the destination.
 //MSG_ONE reads msg_entity, which QuakeC assigns before writing.
	I64 dest;
	I64 entnum;

	dest = ToI64(QBiArgF(0));

	switch (dest)
	{
		case QMSG_BROADCAST:
			return &q_sv_datagram;

		case QMSG_ONE:
			if (q_ofs_msg_entity < 0)
				return NULL;
			entnum = QPrGetI(q_ofs_msg_entity);
			entnum = QPrEdictNum(entnum);
			if (entnum < 1 || entnum > QSV_MAX_CLIENTS)
				return NULL;	//WriteDest: not a client
			return &q_sv_client_msg[entnum - 1];

		case QMSG_ALL:
			return &q_sv_reliable_datagram;

		case QMSG_INIT:
			return &q_sv_signon;
	}

	return NULL;
}

Bool QBiWireRoom(CQMsg *m, I64 need)
{//sv.datagram is capped at the unreliable datagram size; the reliable buffers
 //may run to MAX_MSGLEN because they are chunked before they go out.
	I64 cap;

	if (!m)
		return FALSE;

	if (m == &q_sv_datagram)
		cap = QNET_MAX_DATAGRAM;
	else
		cap = QNET_MAX_MSG;

	return ToBool(m->len < cap - need);
}

U0 QBiWireByte(CQMsg *m, I64 value)
{
	if (!QBiWireRoom(m, 4))
		return;
	QMsgWriteByte(m, value);
}

U0 QBiWireChar(CQMsg *m, I64 value)
{
	if (!QBiWireRoom(m, 4))
		return;
	QMsgWriteChar(m, value);
}

U0 QBiWireCoord(CQMsg *m, F64 value)
{
	if (!QBiWireRoom(m, 4))
		return;
	QMsgWriteCoord(m, value);
}

U0 QBiWireShort(CQMsg *m, I64 value)
{
	if (!QBiWireRoom(m, 4))
		return;
	QMsgWriteShort(m, value);
}

U0 QBiWireLong(CQMsg *m, I64 value)
{
	if (!QBiWireRoom(m, 8))
		return;
	QMsgWriteLong(m, value);
}

U0 QBiWireAngle(CQMsg *m, F64 value)
{
	if (!QBiWireRoom(m, 4))
		return;
	QMsgWriteAngle(m, value);
}

U0 QBiWireString(CQMsg *m, U8 *str)
{
	if (!QBiWireRoom(m, 64))
		return;
	QMsgWriteString(m, str);
}


U0 QBiParticleWire(F64 *org, F64 *dir, I64 color, I64 count)
{//PF_particle's other half: svc_particle on sv.datagram. Played locally only,
 //so a remote client saw no blood, no sparks and no gunshot puffs at all.
	I64 j;
	I64 d;

	if (count > 255)
		count = 255;
	if (count < 0)
		count = 0;

	QBiWireByte(&q_sv_datagram, QSVC_PARTICLE);
	for (j = 0; j < 3; j++)
		QBiWireCoord(&q_sv_datagram, org[j]);

	//Direction is sent as a signed byte in 1/16ths, so it clamps hard.
	for (j = 0; j < 3; j++)
	{
		d = ToI64(dir[j] * 16.0);
		if (d > 127)
			d = 127;
		if (d < -128)
			d = -128;
		QBiWireByte(&q_sv_datagram, d & 255);
	}

	QBiWireByte(&q_sv_datagram, color);
	QBiWireByte(&q_sv_datagram, count);
}

CQMsg *QBiClientMsg(I64 ent)
{//The reliable channel belonging to a client edict, or NULL for the local one.
 //Edicts 1..maxclients are reserved per slot, so the slot IS ent - 1.
	I64 slot;

	if (ent <= 0 || ent == q_player_edict)
		return NULL;

	slot = ent - 1;
	if (slot < 0 || slot >= QSV_MAX_CLIENTS)
		return NULL;

	return &q_sv_client_msg[slot];
}

U0 QBiMakeStatic()
{//Builtin 69.
	CQStaticEnt	*se;
	I64			 ent = QBiArgEnt(0);
	I64			 idx;
	I64			 j;

	if (ent <= 0)
		return;

	if (q_static_count < QBI_MAX_STATIC)
	{
		se  = &q_static_ent[q_static_count];
		idx = ToI64(QPrFieldF(ent, q_fld_modelindex));

		se->mdl = NULL;
		if (idx > 0 && idx < q_precache_model_count)
			se->mdl = q_precache_mdl[idx];

		for (j = 0; j < 3; j++)
		{
			se->origin[j] = QPrFieldF(ent, q_fld_origin + j);
			se->angles[j] = QPrFieldF(ent, q_fld_angles + j);
		}

		se->frame = ToI64(QPrFieldF(ent, q_fld_frame));

		//Only models are drawable here; a static entity with no model would
		//occupy a slot for nothing.
		if (se->mdl)
			q_static_count++;
	}

	//svc_spawnstatic into sv.signon, so a joining client is told about the
	//torches and gibs during prespawn. They are never sent again: a static
	//entity has no edict on the client and cannot be updated.
	idx = ToI64(QPrFieldF(ent, q_fld_modelindex));
	if (idx > 0)
	{
		QBiWireByte(&q_sv_signon, QSVC_SPAWNSTATIC);
		QBiWireByte(&q_sv_signon, idx);
		QBiWireByte(&q_sv_signon, ToI64(QPrFieldF(ent, q_fld_frame)));

		if (q_fld_colormap >= 0)
			QBiWireByte(&q_sv_signon,
				ToI64(QPrFieldF(ent, q_fld_colormap)));
		else
			QBiWireByte(&q_sv_signon, 0);

		if (q_fld_skin >= 0)
			QBiWireByte(&q_sv_signon, ToI64(QPrFieldF(ent, q_fld_skin)));
		else
			QBiWireByte(&q_sv_signon, 0);

		for (j = 0; j < 3; j++)
		{
			QBiWireCoord(&q_sv_signon, QPrFieldF(ent, q_fld_origin + j));
			QBiWireAngle(&q_sv_signon, QPrFieldF(ent, q_fld_angles + j));
		}
	}

	//Freed either way - that is what makestatic means.
	QPrFreeEdict(ent);
}

U0 QBiFreePrecache()
{
	//The brush-model translation table is per-map too.
	QClipPrecacheReset;

	I64 i;

	for (i = 0; i < q_precache_model_count; i++)
	{
		if (q_precache_mdl[i])
		{
			//The cache owns these; freeing here would be a double free.
			q_precache_mdl[i] = NULL;
		}
	}

	q_precache_model_count = 0;
	q_precache_sound_count = 0;
}

U0 QBiSetMinMaxSize(I64 ent, F64 *mins, F64 *maxs)
{
	F64 size[3];

	QBiSetFieldV(ent, q_fld_mins, mins);
	QBiSetFieldV(ent, q_fld_maxs, maxs);
	QVecSub(maxs, mins, size);
	QBiSetFieldV(ent, q_fld_size, size);
}

F64 QSvFlagF(Bool b)
{//A Bool widened to the 1.0/0.0 QuakeC tests against.
	if (b)
		return 1.0;
	return 0.0;
}

U0 QBiStoreTrace(CQTrace *tr, I64 hit_ent)
{//Publish a trace into the globals QuakeC reads afterwards.
	QPrSetF(q_ofs_trace_allsolid, ToF64(tr->all_solid));
	QPrSetF(q_ofs_trace_startsolid, ToF64(tr->start_solid));
	QPrSetF(q_ofs_trace_fraction, tr->fraction);
	QPrSetV(q_ofs_trace_endpos, tr->end_pos);
	QPrSetV(q_ofs_trace_plane_normal, tr->plane_normal);
	QPrSetF(q_ofs_trace_plane_dist, tr->plane_dist);
	QPrSetI(q_ofs_trace_ent, QPrEdictValue(hit_ent));
	//visible() rejects a sight line that crossed both, which is what stops a
	//monster tracking the player through the surface of a pool. Hardcoding
	//these to zero disabled that test entirely.
	QPrSetF(q_ofs_trace_inopen, QSvFlagF(tr->in_open));
	QPrSetF(q_ofs_trace_inwater, QSvFlagF(tr->in_water));
}

//--- temp entities ---------------------------------------------------------
//
// Explosions, blood and sparks are broadcast as network messages rather than
// spawned directly: QuakeC writes a SVC_TEMPENTITY byte, an effect type, then
// the coordinates. There is no network here, so the writes are reassembled
// into an effect and handed straight to the particle system.

#define QSVC_TEMPENTITY		23
#define QSVC_INTERMISSION	30
#define QSVC_FINALE			31
#define QSVC_CUTSCENE		34

//--- intermission and finale -----------------------------------------------
//
// QuakeC ends a level by broadcasting svc_intermission, or svc_finale followed
// by a string for the episode-ending text. The camera is already parked by
// QuakeC (it moves the player to an info_intermission and sets .fixangle), so
// all the engine owes is the overlay and leaving input alone - QuakeC's own
// IntermissionThink watches button0 and exits when the player fires.
Bool q_intermission	= FALSE;
Bool q_finale		= FALSE;
U8	 q_finale_text[256];

U0 QBiIntermissionClear()
{
	q_intermission   = FALSE;
	q_finale         = FALSE;
	q_finale_text[0] = 0;
}

#define QTE_SPIKE			0
#define QTE_SUPERSPIKE		1
#define QTE_GUNSHOT			2
#define QTE_EXPLOSION		3
#define QTE_TAREXPLOSION	4
#define QTE_LIGHTNING1		5
#define QTE_LIGHTNING2		6
#define QTE_WIZSPIKE		7
#define QTE_KNIGHTSPIKE		8
#define QTE_LIGHTNING3		9
#define QTE_LAVASPLASH		10
#define QTE_TELEPORT		11

#define QMSG_IDLE			0
#define QMSG_WANT_TYPE		1
#define QMSG_WANT_COORDS	2
#define QMSG_WANT_BEAM_ENT	3
#define QMSG_WANT_BEAM		4
#define QMSG_WANT_TEXT		5

//Beams are drawn bright: they are self-illuminated in the original.
#define QBEAM_LIGHT			240

//Movement diagnostics. If failures dominate, the step geometry is refusing
//legal moves; if successes dominate while monsters still grind into walls,
//the steering choice is wrong. The two cases need opposite fixes, so they are
//counted rather than guessed at.
I64 q_move_ok	= 0;
I64 q_move_fail	= 0;
I64 q_yaw_reports = 0;
U8  q_yaw_line[128];

//FL_ONGROUND. Declared here because the move step sets it directly, and the
//physics pass keys gravity off it.
#define QFL_ONGROUND_MOVE	512
#define QFL_SWIM_			2		//defs.qc: FL_SWIM
#define QFL_FLY_			1		//defs.qc: FL_FLY

//Solidity values. Declared here as well as in the game layer because this file
//is compiled first and traceline needs them.
#define QBI_SOLID_NOT		0
#define QBI_SOLID_TRIGGER	1
#define QBI_SOLID_BBOX		2
#define QBI_SOLID_SLIDEBOX	3
#define QBI_SOLID_BSP		4

I64 q_msg_state	= QMSG_IDLE;
I64 q_msg_type	= 0;
I64 q_msg_axis	= 0;
F64 q_msg_org[3];
F64 q_msg_end[3];
I64 q_te_count	= 0;

U0 QBiRicochet(F64 *org)
{//CL_ParseTEnt's impact sound: mostly the metallic tink, occasionally one of
 //three ricochets. `if (rand() % 5)` means the tink wins four times in five.
	I64 r;

	if (QPartRandI(5))
	{
		QSndPlayAt("weapons/tink1.wav", org, 1.0, 1.0);
		return;
	}

	r = QPartRandI(4);

	if (r == 1)
		QSndPlayAt("weapons/ric1.wav", org, 1.0, 1.0);
	else if (r == 2)
		QSndPlayAt("weapons/ric2.wav", org, 1.0, 1.0);
	else
		QSndPlayAt("weapons/ric3.wav", org, 1.0, 1.0);
}

U0 QBiTempEntity(I64 type, F64 *org)
{//Turn a decoded temp entity into particles AND SOUND.
 //
 //The sounds here are not optional decoration - they are the only place several
 //of them exist. QuakeC never plays the explosion: GrenadeExplode writes a
 //TE_EXPLOSION and nothing else, and CL_ParseTEnt is what turns that into
 //weapons/r_exp3.wav. Nor does progs precache the file; CL_InitTEnts does. So
 //with the temp entity handled as particles only, rockets and grenades detonate
 //in complete silence, which is exactly what happened.
	F64 zero[3];

	QVecSet(zero, 0.0, 0.0, 0.0);
	q_te_count++;

	switch (type)
	{
		case QTE_EXPLOSION:
		case QTE_TAREXPLOSION:
			QPartExplosion(org, tS);
			//The flash that lights the room, using the original's figures.
			QDlightAdd(org, 350.0, 0.5, 300.0, tS);
			QSndPlayAt("weapons/r_exp3.wav", org, 1.0, 1.0);
			break;

		case QTE_GUNSHOT:
			//Colour 0 is the dark-to-grey ramp: a puff of wall debris. No sound;
			//the firing weapon already made one.
			QPartEffect(org, zero, 0, 20, tS);
			break;

		case QTE_SPIKE:
			QPartEffect(org, zero, 0, 10, tS);
			QBiRicochet(org);
			break;

		case QTE_SUPERSPIKE:
			QPartEffect(org, zero, 0, 20, tS);
			QBiRicochet(org);
			break;

		//These two have their OWN colours and counts, not the nail's. 20 is the
		//green ramp for the Scrag's spit and 226 the orange for the Death
		//Knight's, which is why their impacts read as different weapons.
		case QTE_WIZSPIKE:
			QPartEffect(org, zero, 20, 30, tS);
			QSndPlayAt("wizard/hit.wav", org, 1.0, 1.0);
			break;

		case QTE_KNIGHTSPIKE:
			QPartEffect(org, zero, 226, 20, tS);
			QSndPlayAt("hknight/hit.wav", org, 1.0, 1.0);
			break;

		case QTE_LAVASPLASH:
			QPartLavaSplash(org, tS);
			break;

		case QTE_TELEPORT:
			QPartTeleport(org, tS);
			break;

		default:
			//Beams (the lightning types) need a line renderer, not particles.
			break;
	}
}

//--- lightning beams -------------------------------------------------------
//
// TE_LIGHTNING1/2/3 carry an entity index and TWO points rather than the single
// point every other temp entity uses, which is why they had to be skipped
// before: feeding six coordinates into a three-coordinate parser would have
// produced garbage positions for the following effect too.
//
// The original renders a beam by tiling its bolt model along the vector every
// 30 units, with a random roll per segment so it looks like it is crackling.

#define QBI_MAX_BEAMS	16
#define QBEAM_SEGMENT	30.0
#define QBEAM_LIFE		0.2		//seconds, matching the original

class CQBeam
{
	F64		 start[3];
	F64		 end[3];
	F64		 die_time;
	CQMdl	*mdl;
};

CQBeam	q_beam[QBI_MAX_BEAMS];
I64		q_beam_count = 0;

U0 QBiBeamsClear()
{
	q_beam_count = 0;
}

U0 QBiBeamAdd(I64 type, F64 *start, F64 *end, F64 time)
{//Record a beam. Beams are short lived, so the oldest is recycled when full.
	CQBeam	*b;
	U8		*name;
	I64		 i;
	I64		 slot = -1;

	if (type == QTE_LIGHTNING1)
		name = "progs/bolt.mdl";
	else if (type == QTE_LIGHTNING2)
		name = "progs/bolt2.mdl";
	else
		name = "progs/bolt3.mdl";

	//Prefer an expired slot.
	for (i = 0; i < q_beam_count; i++)
	{
		if (q_beam[i].die_time <= time)
		{
			slot = i;
			break;
		}
	}

	if (slot < 0)
	{
		if (q_beam_count < QBI_MAX_BEAMS)
		{
			slot = q_beam_count;
			q_beam_count++;
		}
		else
			slot = 0;
	}

	b = &q_beam[slot];
	QVecCopy(start, b->start);
	QVecCopy(end, b->end);
	b->die_time = time + QBEAM_LIFE;
	b->mdl      = QBiFindModel(name);
}

U0 QBiDrawBeams(CQCanvas *c, F64 time)
{//Tile each live beam's model along its length.
	CQBeam	*b;
	F64		 dir[3];
	F64		 org[3];
	F64		 ang[3];
	F64		 len;
	I64		 i;
	I64		 seg;
	I64		 steps;

	for (i = 0; i < q_beam_count; i++)
	{
		b = &q_beam[i];

		if (b->die_time <= time || !b->mdl)
			goto qb_next;

		QVecSub(b->end, b->start, dir);
		len = QVecLength(dir);

		if (len < 1.0)
			goto qb_next;

		QVecScale(dir, 1.0 / len, dir);

		//Pitch and yaw point the segment down the beam; the roll is random so
		//consecutive segments do not line up into a smooth tube.
		QVecToAngles(dir, ang);

		steps = ToI64(len / QBEAM_SEGMENT) + 1;
		QVecCopy(b->start, org);

		for (seg = 0; seg < steps; seg++)
		{
			ang[2] = ToF64(RandU32() % 360);

			QMdlDrawAngles(c, b->mdl, 0, org, ang, QBEAM_LIGHT);

			org[0] += dir[0] * QBEAM_SEGMENT;
			org[1] += dir[1] * QBEAM_SEGMENT;
			org[2] += dir[2] * QBEAM_SEGMENT;
		}

qb_next:
	}
}

//--- centerprint -----------------------------------------------------------
//
// The message a trigger shows in the middle of the screen: "you need the silver
// key", the skill signs in start.bsp, and so on. SUB_UseTargets calls this and
// then plays misc/talk.wav, which is why the sound was arriving with nothing
// visible to explain it.
//
// Dismissal is purely TIME based in the original - scr_centertime, default 2.0
// seconds, counted down every frame in SCR_CheckDrawCenterString. There is no
// key or click that clears it.
//
// So a message that never goes away means it is being RE-SENT, not that the
// timer is broken: a trigger_multiple re-fires every .wait seconds for as long
// as something stands inside it, and a player stuck in one gets the message
// refreshed forever.
#define QCENTER_TIME	2.0

U8  q_center_text[256];
F64 q_center_until	= 0.0;

//--- localcmd ---------------------------------------------------------------
//
// QuakeC pushes console commands at the engine through this, and single-player
// DEATH depends on it: respawn() is
//
//     void() respawn = { ... localcmd ("restart\n"); };
//
// so with this builtin a no-op the whole death cycle stalls. PlayerDeathThink
// correctly reaches DEAD_RESPAWNABLE and calls respawn(), the string goes
// nowhere, and the player stays dead on the floor forever.
//
// Only the commands QuakeC actually issues are honoured; anything else is
// reported once so an unhandled command is visible rather than silent.
Bool q_restart_pending	= FALSE;
I64  q_localcmd_reports	= 0;

U0 QBiLocalCmd(U8 *cmd)
{
	if (!cmd || !cmd[0])
		return;

	//"restart" reloads the current map from scratch. That is what the original
	//does on a single-player death: same level, fresh start, no carried items.
	if (!StrNICompare(cmd, "restart", 7))
	{
		q_restart_pending = TRUE;
		return;
	}

	//The map change QuakeC uses on level exit goes through the changelevel
	//builtin, not here, so this is only reached for commands we do not model.
	if (q_localcmd_reports < 8)
	{
		q_localcmd_reports++;
		"QBi: unhandled localcmd '%s'\n", cmd;
	}
}

U0 QBiCenterClear()
{
	q_center_text[0] = 0;
	q_center_until   = 0.0;
}

U0 QBiCenterPrint(I64 ent, U8 *str)
{//PF_centerprint. Argument 0 names the client; ignoring it put a remote
 //player's key/objective message on the host's screen instead of theirs.
	CQMsg *m;

	if (!str || !str[0])
		return;

	m = QBiClientMsg(ent);
	if (m)
	{
		QBiWireByte(m, QSVC_CENTERPRINT);
		QBiWireString(m, str);
		return;
	}

	QStrCopy(q_center_text, str, 256);
	q_center_until = tS + QCENTER_TIME;
}

//--- checkclient ------------------------------------------------------------
//
//PF_checkclient. Monsters call this to decide whether a player is worth
//noticing. Returning one fixed edict made every monster in the level hunt the
//same body regardless of where it was, so the cycle and the PVS test below are
//both load-bearing.

//MAX_MAP_LEAFS is 8192 in BSP29, so one PVS row never exceeds 1024 bytes.
#define QBI_MAX_LEAFS	8192
#define QBI_PVS_BYTES	(QBI_MAX_LEAFS / 8)
#define QBI_FL_NOTARGET	128

U8	 q_checkpvs[QBI_PVS_BYTES];
I64	 q_sv_lastcheck		= 1;
F64	 q_sv_lastchecktime	= 0.0;

I64 QBiNewCheckClient(I64 check)
{//PF_newcheckclient: step to the next live client and cache its PVS row.
	I64 i;
	I64 leaf;
	F64 org[3];
	F64 ofs[3];

	if (check < 1)
		check = 1;
	if (check > QSV_MAX_CLIENTS)
		check = QSV_MAX_CLIENTS;

	if (check == QSV_MAX_CLIENTS)
		i = 1;
	else
		i = check + 1;

	while (TRUE)
	{
		if (i == QSV_MAX_CLIENTS + 1)
			i = 1;

		if (i == check)
			break;			//nothing else to look at

		if (!q_pr_edict_free[i] && QPrFieldF(i, q_fld_health) > 0.0)
		{
			if (q_fld_flags < 0 ||
				!(ToI64(QPrFieldF(i, q_fld_flags)) & QBI_FL_NOTARGET))
				break;
		}

		i++;
	}

	//Cache the PVS as seen from that client's eyes, not its feet.
	QBiGetFieldV(i, q_fld_origin, org);
	if (q_fld_view_ofs >= 0)
	{
		QBiGetFieldV(i, q_fld_view_ofs, ofs);
		org[0] += ofs[0];
		org[1] += ofs[1];
		org[2] += ofs[2];
	}

	leaf = -1;
	if (q_bi_map)
		leaf = QVisLeafForPoint(q_bi_map, org);

	if (leaf >= 0 && leaf < q_bi_map->num_leafs)
		QVisDecompress(q_bi_map, q_bi_map->leafs[leaf].vis_offset,
			q_checkpvs, QBI_PVS_BYTES);
	else
		MemSet(q_checkpvs, 0xFF, QBI_PVS_BYTES);

	return i;
}

U0 QBiCheckClient()
{
	I64 ent;
	I64 self;
	I64 leaf;
	I64 l;
	F64 view[3];
	F64 ofs[3];
	F64 now;

	if (q_ofs_self < 0 || q_fld_health < 0 || !q_pr_edict_free)
	{
		QBiRetEnt(0);
		return;
	}

	now = QPrGetF(q_ofs_time);

	//One new pick per 0.1s, shared by every monster that asks this frame.
	if (now - q_sv_lastchecktime >= 0.1)
	{
		q_sv_lastcheck     = QBiNewCheckClient(q_sv_lastcheck);
		q_sv_lastchecktime = now;
	}

	ent = q_sv_lastcheck;
	if (q_pr_edict_free[ent] || QPrFieldF(ent, q_fld_health) <= 0.0)
	{
		QBiRetEnt(q_player_edict);
		return;
	}

	self = QPrEdictNum(QPrGetI(q_ofs_self));
	QBiGetFieldV(self, q_fld_origin, view);
	if (q_fld_view_ofs >= 0)
	{
		QBiGetFieldV(self, q_fld_view_ofs, ofs);
		view[0] += ofs[0];
		view[1] += ofs[1];
		view[2] += ofs[2];
	}

	//Leaf 0 is the solid leaf, so PVS bit 0 belongs to leaf 1.
	l = -1;
	if (q_bi_map)
	{
		leaf = QVisLeafForPoint(q_bi_map, view);
		if (leaf >= 0 && leaf < q_bi_map->num_leafs)
			l = leaf - 1;
	}

	if (l < 0 || l >= QBI_MAX_LEAFS ||
		!(q_checkpvs[l >> 3] & (1 << (l & 7))))
	{
		QBiRetEnt(0);		//world: cannot possibly see the check entity
		return;
	}

	QBiRetEnt(ent);
}

I64 QBiSoundIndex(U8 *sample)
{//1-based index into the sound precache (protocol: byte sound_num). 0 = miss.
	I64 i;

	if (!sample || !sample[0])
		return 0;

	for (i = 0; i < q_precache_sound_count; i++)
	{
		if (q_precache_sound[i] && !StrCompare(q_precache_sound[i], sample))
			return i + 1;
	}

	return 0;
}

U0 QBiAmbientSignon(F64 *pos, U8 *sample, F64 vol, F64 attenuation)
{//PF_ambientsound's other half: svc_spawnstaticsound into sv.signon, so a
 //joining client starts the same water and torch loops the host already has.
	I64 num;
	I64 j;

	num = QBiSoundIndex(sample);
	if (num < 1)
		return;

	QBiWireByte(&q_sv_signon, QSVC_SPAWNSTATICSOUND);
	for (j = 0; j < 3; j++)
		QBiWireCoord(&q_sv_signon, pos[j]);
	QBiWireByte(&q_sv_signon, num);
	QBiWireByte(&q_sv_signon, ToI64(vol * 255.0));
	QBiWireByte(&q_sv_signon, ToI64(attenuation * 64.0));
}

U0 QSvStartSound(I64 ent, I64 channel, U8 *sample, I64 volume, F64 attenuation)
{//SV_StartSound -> svc_sound on sv.datagram. Local play is caller's job.
	I64 sound_num;
	I64 field_mask;
	I64 packed;
	F64 org[3];
	F64 mins[3];
	F64 maxs[3];
	I64 j;

	if (!sample || !sample[0])
		return;
	if (q_sv_datagram.len > QNET_MAX_DATAGRAM - 16)
		return;

	sound_num = QBiSoundIndex(sample);
	if (sound_num < 1)
		return;

	if (volume < 0)
		volume = 0;
	if (volume > 255)
		volume = 255;
	if (attenuation < 0.0)
		attenuation = 0.0;
	if (attenuation > 4.0)
		attenuation = 4.0;
	if (channel < 0)
		channel = 0;
	if (channel > 7)
		channel = 7;
	if (ent < 0)
		ent = 0;

	packed = (ent << 3) | channel;

	field_mask = 0;
	if (volume != QSND_DEFAULT_VOL)
		field_mask |= QSND_VOLUME;
	if (attenuation != QSND_DEFAULT_ATTEN)
		field_mask |= QSND_ATTENUATION;

	QMsgWriteByte(&q_sv_datagram, QSVC_SOUND);
	QMsgWriteByte(&q_sv_datagram, field_mask);
	if (field_mask & QSND_VOLUME)
		QMsgWriteByte(&q_sv_datagram, volume);
	if (field_mask & QSND_ATTENUATION)
		QMsgWriteByte(&q_sv_datagram, ToI64(attenuation * 64.0));
	QMsgWriteShort(&q_sv_datagram, packed);
	QMsgWriteByte(&q_sv_datagram, sound_num);

	QBiGetFieldV(ent, q_fld_origin, org);
	QBiGetFieldV(ent, q_fld_mins, mins);
	QBiGetFieldV(ent, q_fld_maxs, maxs);
	for (j = 0; j < 3; j++)
		org[j] += 0.5 * (mins[j] + maxs[j]);

	for (j = 0; j < 3; j++)
		QMsgWriteCoord(&q_sv_datagram, org[j]);
}

U0 QBiWriteByte(CQMsg *m, I64 value)
{//Emits to the routed destination, and drives the local reassembly state
 //machine so the host sees its own temp entities without a round trip.
	QBiWireByte(m, value);

	if (q_msg_state == QMSG_IDLE)
	{
		if (value == QSVC_TEMPENTITY)
			q_msg_state = QMSG_WANT_TYPE;
		else if (value == QSVC_INTERMISSION)
			q_intermission = TRUE;
		else if (value == QSVC_FINALE || value == QSVC_CUTSCENE)
		{
			//The text arrives as the next WriteString.
			q_intermission   = TRUE;
			q_finale         = TRUE;
			q_finale_text[0] = 0;
			q_msg_state      = QMSG_WANT_TEXT;
		}
		return;
	}

	if (q_msg_state == QMSG_WANT_TYPE)
	{
		q_msg_type = value;
		q_msg_axis = 0;

		//A beam carries an entity index and then SIX coordinates - a start and
		//an end - where every other effect carries three.
		if (q_msg_type == QTE_LIGHTNING1 || q_msg_type == QTE_LIGHTNING2 ||
			q_msg_type == QTE_LIGHTNING3)
			q_msg_state = QMSG_WANT_BEAM_ENT;
		else
			q_msg_state = QMSG_WANT_COORDS;
	}
}

U0 QBiWriteString(CQMsg *m, U8 *str)
{//Only the finale text is consumed locally; the wire copy always goes out.
	QBiWireString(m, str);

	if (q_msg_state == QMSG_WANT_TEXT)
	{
		if (str)
			QStrCopy(q_finale_text, str, 256);
		q_msg_state = QMSG_IDLE;
	}
}

U0 QBiWriteEntity(CQMsg *m, I64 value)
{//A beam's owning entity. Not used for placement - the coordinates that follow
 //carry that - but it has to be consumed so the coordinates land correctly.
	QBiWireShort(m, value);

	if (q_msg_state == QMSG_WANT_BEAM_ENT)
		q_msg_state = QMSG_WANT_BEAM;
}

U0 QBiWriteCoord(CQMsg *m, F64 value)
{
	QBiWireCoord(m, value);

	if (q_msg_state == QMSG_WANT_BEAM)
	{
		//Six coordinates: start then end.
		if (q_msg_axis < 3)
			q_msg_org[q_msg_axis] = value;
		else if (q_msg_axis < 6)
			q_msg_end[q_msg_axis - 3] = value;

		q_msg_axis++;

		if (q_msg_axis >= 6)
		{
			QBiBeamAdd(q_msg_type, q_msg_org, q_msg_end, tS);
			q_msg_state = QMSG_IDLE;
		}

		return;
	}

	if (q_msg_state != QMSG_WANT_COORDS)
		return;

	if (q_msg_axis < 3)
	{
		q_msg_org[q_msg_axis] = value;
		q_msg_axis++;
	}

	if (q_msg_axis >= 3)
	{
		QBiTempEntity(q_msg_type, q_msg_org);
		q_msg_state = QMSG_IDLE;
	}
}

//--- individual builtins ---------------------------------------------------

U0 QBiMakeVectors()
{
	F64 angles[3];
	F64 forward[3];
	F64 right[3];
	F64 up[3];

	QBiArgV(0, angles);
	QAngleVectors(angles, forward, right, up);

	QPrSetV(q_ofs_v_forward, forward);
	QPrSetV(q_ofs_v_right, right);
	QPrSetV(q_ofs_v_up, up);
}

U0 QBiSetOrigin()
{
	I64 ent = QBiArgEnt(0);
	F64 org[3];

	QBiArgV(1, org);
	QBiSetFieldV(ent, q_fld_origin, org);
}

U0 QBiSetModel()
{
	I64 ent  = QBiArgEnt(0);
	U8 *name = QBiArgS(1);
	I64 idx  = QBiPrecacheModel(name);
	I64 bm;
	F64 mins[3];
	F64 maxs[3];

	QPrSetFieldI(ent, q_fld_model, QPrGetI(QBiArg(1)));
	QPrSetFieldF(ent, q_fld_modelindex, ToF64(idx));

	//An external .bsp carries its own bounds in its worldmodel entry. Without
	//this the entity keeps a zero-sized box, which is what made droptofloor
	//fail for every ammo and health box on the map.
	if (idx > 0 && idx < QBI_MAX_PRECACHE && q_precache_bsp[idx])
	{
		QVecCopy(q_precache_bsp[idx]->models[0].mins, mins);
		QVecCopy(q_precache_bsp[idx]->models[0].maxs, maxs);
		QBiSetMinMaxSize(ent, mins, maxs);
		return;
	}

	//A brush model takes its bounds straight from the BSP.
	if (name[0] == '*' && q_bi_map)
	{
		bm = ToI64(QAtoF(name + 1));
		if (0 <= bm < q_bi_map->num_models)
		{
			QVecCopy(q_bi_map->models[bm].mins, mins);
			QVecCopy(q_bi_map->models[bm].maxs, maxs);
			QBiSetMinMaxSize(ent, mins, maxs);
		}
	}
}

U0 QBiSetSize()
{
	I64 ent = QBiArgEnt(0);
	F64 mins[3];
	F64 maxs[3];

	QBiArgV(1, mins);
	QBiArgV(2, maxs);
	QBiSetMinMaxSize(ent, mins, maxs);
}

U0 QBiTraceEnt(I64 ent, F64 *start, F64 *end, CQTrace *tr)
{//Sweep an entity's OWN box against the world and every solid entity.
 //
 //SV_Move with the mover's mins/maxs, which is what droptofloor, movestep and
 //the AI's floor check all use. Tracing the world alone - which these did -
 //makes brush entities invisible to the AI: a monster walks through a closed
 //door, and a platform is not a floor it can stand on.
	F64 mins[3];
	F64 maxs[3];
	I64 j;

	for (j = 0; j < 3; j++)
	{
		mins[j] = QPrFieldF(ent, q_fld_mins + j);
		maxs[j] = QPrFieldF(ent, q_fld_maxs + j);
	}

	QTraceEntity(q_bi_map, start, end, mins, maxs, ent, FALSE, tr);
}

U0 QBiTraceLine()
{//traceline(v1, v2, nomonsters, ignore).
 //
 //PF_traceline is simply
 //
 //    SV_Move (v1, vec3_origin, vec3_origin, v2, nomonsters, ent)
 //
 //so it clips against the world AND every solid entity, and it does so with a
 //ZERO-SIZED box - a genuine point trace through hull 0.
 //
 //This used to trace the world through hull 1 and then hand-test only BBOX and
 //SLIDEBOX entities with a ray/box check. Two things fell out of that. Brush
 //entities were never tested at all, so a monster's line of sight passed
 //straight through platforms and doors - it could see and shoot the player
 //through a lift floor. And tracing a point through hull 1 reports the world 16
 //units early in every direction, which is the wrong geometry for a bullet.
 //
 //Going through QTraceEntity fixes both and removes the duplicate logic: the
 //nomonsters flag, the pass entity and the owner exemptions are all handled
 //there, exactly as SV_ClipToLinks handles them.
	CQTrace	tr;
	F64		v1[3];
	F64		v2[3];
	F64		zero[3];
	I64		ignore;
	Bool	nomonsters;

	QBiArgV(0, v1);
	QBiArgV(1, v2);
	nomonsters = ToBool(QBiArgF(2) != 0.0);
	ignore     = QBiArgEnt(3);

	QVecSet(zero, 0.0, 0.0, 0.0);

	if (!q_bi_map)
	{
		//No map: report a clean miss rather than leaving the trace globals at
		//whatever the previous call left behind.
		QTraceInit(&tr, v2);
		tr.all_solid = FALSE;
		QBiStoreTrace(&tr, 0);
		return;
	}

	QTraceEntity(q_bi_map, v1, v2, zero, zero, ignore, nomonsters, &tr);

	//trace_ent is the entity struck, or the world when nothing was.
	if (tr.ent > 0)
		QBiStoreTrace(&tr, tr.ent);
	else
		QBiStoreTrace(&tr, 0);
}

U0 QBiPointContents()
{
	F64 p[3];
	I64 c = QCONTENTS_EMPTY;

	QBiArgV(0, p);

	if (q_bi_map)
		c = QHullPointContents(q_bi_map, q_bi_map->models[0].head_node[1], p);

	QBiRetF(ToF64(c));
}

U0 QBiDropToFloor()
{//Drop the entity up to 256 units and report whether it landed.
	I64		ent = QPrEdictNum(QPrGetI(q_ofs_self));
	CQTrace	tr;
	F64		start[3];
	F64		end[3];

	QBiGetFieldV(ent, q_fld_origin, start);
	QVecCopy(start, end);
	end[2] -= 256.0;

	if (!q_bi_map)
	{
		QBiRetF(0.0);
		return;
	}

	QBiTraceEnt(ent, start, end, &tr);

	if (tr.fraction == 1.0 || tr.all_solid)
		QBiRetF(0.0);
	else
	{
		QBiSetFieldV(ent, q_fld_origin, tr.end_pos);

		//SV_LinkEdict after the move. Without it absmin/absmax still describe
		//where the item was BEFORE it dropped, and every box test - including
		//the touch that picks it up - runs against the stale bounds.
		QGameLinkEdict(ent);

		//PF_droptofloor also marks the entity as resting on what it hit.
		//SUB_regen and the AI's floor checks both read these back.
		if (q_fld_flags >= 0)
			QPrSetFieldF(ent, q_fld_flags,
				ToF64(ToI64(QPrFieldF(ent, q_fld_flags)) | QFL_ONGROUND_MOVE));

		if (q_fld_groundentity >= 0 && tr.ent >= 0)
			QPrSetFieldI(ent, q_fld_groundentity, QPrEdictValue(tr.ent));

		QBiRetF(1.0);
	}
}

Bool QBiCheckBottomEnt(I64 ent)
{//SV_CheckBottom. Is there real floor under the whole box, or only under part
 //of it? This is what stops a monster walking off a ledge - and what stops it
 //walking into deep water, because water is not solid and the corner test
 //falls through to the trace, which then finds no floor within a step.
	CQTrace	tr;
	F64		org[3];
	F64		mins[3];
	F64		maxs[3];
	F64		zero[3];
	F64		start[3];
	F64		stop[3];
	F64		mid;
	F64		bottom;
	I64		x;
	I64		y;
	I64		j;

	if (!q_bi_map)
		return TRUE;

	QBiGetFieldV(ent, q_fld_origin, org);
	QBiGetFieldV(ent, q_fld_mins, mins);
	QBiGetFieldV(ent, q_fld_maxs, maxs);

	for (j = 0; j < 3; j++)
	{
		mins[j] += org[j];
		maxs[j] += org[j];
	}

	QVecSet(zero, 0.0, 0.0, 0.0);

	//Fast out: solid world under all four corners means there is nothing to
	//worry about.
	start[2] = mins[2] - 1.0;
	for (x = 0; x <= 1; x++)
	{
		for (y = 0; y <= 1; y++)
		{
			if (x)	start[0] = maxs[0];
			else	start[0] = mins[0];
			if (y)	start[1] = maxs[1];
			else	start[1] = mins[1];

			if (QHullPointContents(q_bi_map,
					q_bi_map->models[0].head_node[1], start) !=
				QCONTENTS_SOLID)
				goto qcb_real;
		}
	}

	return TRUE;

qcb_real:
	//The midpoint must find floor within two step heights.
	start[2] = mins[2];
	start[0] = (mins[0] + maxs[0]) * 0.5;
	start[1] = (mins[1] + maxs[1]) * 0.5;
	QVecCopy(start, stop);
	stop[2] = start[2] - QPHYS_STEPSIZE * 2.0;

	QTraceEntity(q_bi_map, start, stop, zero, zero, ent, TRUE, &tr);

	if (tr.fraction == 1.0)
		return FALSE;

	mid    = tr.end_pos[2];
	bottom = mid;

	//And every corner must be within one step of that midpoint, or the box is
	//hanging over an edge.
	for (x = 0; x <= 1; x++)
	{
		for (y = 0; y <= 1; y++)
		{
			if (x)	start[0] = maxs[0];
			else	start[0] = mins[0];
			if (y)	start[1] = maxs[1];
			else	start[1] = mins[1];

			stop[0] = start[0];
			stop[1] = start[1];

			QTraceEntity(q_bi_map, start, stop, zero, zero, ent, TRUE, &tr);

			if (tr.fraction != 1.0 && tr.end_pos[2] > bottom)
				bottom = tr.end_pos[2];

			if (tr.fraction == 1.0 ||
				mid - tr.end_pos[2] > QPHYS_STEPSIZE)
				return FALSE;
		}
	}

	return TRUE;
}

Bool QBiMoveStep(I64 ent, F64 yaw, F64 dist)
{//Walk an entity one step along a heading.
 //
 //This does NOT sweep horizontally toward the destination. The original
 //projects straight to the destination raised by one step height, then traces
 //DOWNWARD looking for floor. Walls are rejected because a destination inside
 //geometry makes that downward trace start solid, and ledges are rejected
 //because it finds no floor within two step heights.
 //
 //The horizontal sweep this replaced refused essentially every move (measured:
 //0 succeeded, 1554 blocked), because a trace starting one step height above a
 //monster's origin is already inside the expanded collision hull.
	CQTrace	tr;
	F64		origin[3];
	F64		neworg[3];
	F64		end[3];
	F64		rad;
	F64		dz;
	I64		flags;
	I64		enemy;
	I64		attempt;

	if (!q_bi_map)
		return FALSE;

	QBiGetFieldV(ent, q_fld_origin, origin);
	rad = yaw * QDEG2RAD;

	flags = ToI64(QPrFieldF(ent, q_fld_flags));

	//Swimmers and fliers do not step: they move freely in three dimensions and
	//nudge themselves toward their target's height. Treating them as walkers
	//meant a fish had to find floor within two step heights to move at all.
	if (flags & (QFL_SWIM_ | QFL_FLY_))
	{
		enemy = 0;
		if (q_fld_enemy >= 0)
			enemy = QPrEdictNum(QPrFieldI(ent, q_fld_enemy));

		for (attempt = 0; attempt < 2; attempt++)
		{
			neworg[0] = origin[0] + Cos(rad) * dist;
			neworg[1] = origin[1] + Sin(rad) * dist;
			neworg[2] = origin[2];

			//First attempt closes the height gap to the enemy; the second
			//tries the same move flat, in case the climb was what blocked it.
			if (attempt == 0 && enemy > 0)
			{
				dz = origin[2] - QPrFieldF(enemy, q_fld_origin + 2);
				if (dz > 40.0)
					neworg[2] -= 8.0;
				if (dz < 30.0)
					neworg[2] += 8.0;
			}

			QBiTraceEnt(ent, origin, neworg, &tr);

			if (tr.fraction == 1.0)
			{
				//A swimmer must not leave the water it lives in.
				if ((flags & QFL_SWIM_) &&
					QHullPointContents(q_bi_map,
						q_bi_map->models[0].head_node[1], tr.end_pos) ==
					QCONTENTS_EMPTY)
					return FALSE;

				QBiSetFieldV(ent, q_fld_origin, tr.end_pos);
				QGameLinkEdict(ent);
				return TRUE;
			}

			if (enemy <= 0)
				break;
		}

		return FALSE;
	}

	//Destination, lifted so ordinary steps and thresholds are cleared.
	neworg[0] = origin[0] + Cos(rad) * dist;
	neworg[1] = origin[1] + Sin(rad) * dist;
	neworg[2] = origin[2] + QPHYS_STEPSIZE;

	QVecCopy(neworg, end);
	end[2] -= QPHYS_STEPSIZE * 2.0;

	QBiTraceEnt(ent, neworg, end, &tr);

	if (tr.all_solid)
		return FALSE;

	//Starting inside solid means the lift put it into a ceiling; retry from
	//the unlifted height before giving up.
	if (tr.start_solid)
	{
		neworg[2] -= QPHYS_STEPSIZE;
		QBiTraceEnt(ent, neworg, end, &tr);

		if (tr.all_solid || tr.start_solid)
			return FALSE;
	}

	//Nothing underneath within two step heights: walking there would be
	//stepping off a ledge.
	if (tr.fraction == 1.0)
		return FALSE;

	if (tr.plane_normal[2] < 0.7)
		return FALSE;			//too steep to stand on

	QBiSetFieldV(ent, q_fld_origin, tr.end_pos);

	//SV_CheckBottom. The downward trace above only proves SOMETHING is under
	//the destination; this proves the whole box is supported. Skipping it let
	//a monster walk out over a ledge - and down into deep water, where the
	//corner test finds no solid and the trace finds no floor within a step.
	if (!QBiCheckBottomEnt(ent))
	{
		QBiSetFieldV(ent, q_fld_origin, origin);
		return FALSE;
	}

	//It is standing on something now, so gravity must stop pulling it down.
	flags = ToI64(QPrFieldF(ent, q_fld_flags));
	QPrSetFieldF(ent, q_fld_flags, ToF64(flags | QFL_ONGROUND_MOVE));
	QGameLinkEdict(ent);

	return TRUE;
}

U0 QBiWalkMove()
{//walkmove(yaw, dist) - move along an explicit heading.
	I64 ent = QPrEdictNum(QPrGetI(q_ofs_self));

	QBiRetF(ToF64(QBiMoveStep(ent, QBiArgF(0), QBiArgF(1))));
}

U0 QBiMoveToGoal()
{//movetogoal(dist) - head toward goalentity, steering around obstacles.
 //
 //NOTE the signature: movetogoal takes ONLY a distance. It is not walkmove
 //with a different name, and treating its distance as a yaw makes every
 //monster march along the same meaningless heading into the nearest wall.
	I64	ent		= QPrEdictNum(QPrGetI(q_ofs_self));
	F64	dist	= QBiArgF(0);
	I64	goal;
	F64	origin[3];
	F64	gorigin[3];
	F64	d[3];
	F64	ideal;
	F64	turn;
	I64	i;

	if (!q_bi_map)
	{
		QBiRetF(0.0);
		return;
	}

	QBiGetFieldV(ent, q_fld_origin, origin);
	goal = QPrEdictNum(QPrFieldI(ent, q_fld_goalentity));

	if (goal > 0 && goal < q_pr_num_edicts && !q_pr_edict_free[goal])
	{
		QBiGetFieldV(goal, q_fld_origin, gorigin);
		QVecSub(gorigin, origin, d);

		if (d[0] == 0.0 && d[1] == 0.0)
			ideal = QPrFieldF(ent, q_fld_ideal_yaw);
		else
		{
			ideal = Arg(d[0], d[1]) / QDEG2RAD;
			if (ideal < 0.0)
				ideal += 360.0;
		}
	}
	else
		ideal = QPrFieldF(ent, q_fld_ideal_yaw);

	//Straight at the goal first, then progressively wider detours to either
	//side. This is what lets a monster round a corner instead of stalling
	//against it.
	for (i = 0; i < 5; i++)
	{
		switch (i)
		{
			case 0:	turn = 0.0;		break;
			case 1:	turn = 45.0;	break;
			case 2:	turn = -45.0;	break;
			case 3:	turn = 90.0;	break;
			default: turn = -90.0;	break;
		}

		if (QBiMoveStep(ent, QAngleNorm(ideal + turn), dist))
		{
			//Face the way it actually managed to go, so ChangeYaw turns the
			//body to match and the walk animation reads correctly.
			QPrSetFieldF(ent, q_fld_ideal_yaw, QAngleNorm(ideal + turn));
			q_move_ok++;
			QBiRetF(1.0);
			return;
		}
	}

	q_move_fail++;

	//Boxed in. Reporting failure lets the AI pick a new goal rather than
	//continuing to shuffle against the obstruction.
	QBiRetF(0.0);
}

U0 QBiChangeYaw()
{//Turn toward ideal_yaw at yaw_speed, taking the shorter way around.
	I64 ent		= QPrEdictNum(QPrGetI(q_ofs_self));
	F64 current	= QAngleNorm(QPrFieldF(ent, q_fld_angles + 1));
	F64 ideal	= QPrFieldF(ent, q_fld_ideal_yaw);
	F64 speed	= QPrFieldF(ent, q_fld_yaw_speed);
	F64 move;

	if (current == ideal)
		return;

	move = ideal - current;

	if (ideal > current)
	{
		if (move >= 180.0)
			move -= 360.0;
	}
	else
	{
		if (move <= -180.0)
			move += 360.0;
	}

	if (move > 0.0)
	{
		if (move > speed)
			move = speed;
	}
	else
	{
		if (move < -speed)
			move = -speed;
	}

	QPrSetFieldF(ent, q_fld_angles + 1, QAngleNorm(current + move));

	//One-shot sample of the turn state. If yaw_speed is 0 the monster can
	//never turn; if ideal_yaw never changes the AI is not tracking its enemy;
	//if both look right but the model still faces wrong, the fault is in how
	//the model is rotated at draw time. Three different fixes.
	if (q_yaw_reports < 3)
	{
		q_yaw_reports++;
		StrPrint(q_yaw_line,
			"yaw: %s cur=%.0f ideal=%.0f speed=%.0f -> %.0f\n",
			QPrStr(QPrFieldI(ent, q_fld_classname)),
			current, ideal, speed, QAngleNorm(current + move));
		QLog(q_yaw_line);
	}
}

//find() diagnostics.
//
//SUB_UseTargets and LinkDoors both walk entities with
//    do { t = find(t, field, value); if (!t) return; ... } while (1);
//which ONLY terminates because find resumes AFTER the entity handed to it. If
//it ever returns the same entity twice, those loops never end - and that is the
//shape of both freezes seen so far (talk.wav plays from SUB_UseTargets, and the
//door runaway is door_go_up -> SUB_UseTargets).
//
//So consecutive calls that fail to advance are counted, and the first few are
//logged with what went in and what came out.
#define QFIND_MAX_REPORTS	12
I64 q_find_last_start	= -1;
I64 q_find_last_result	= -1;
I64 q_find_repeats		= 0;
I64 q_find_reports		= 0;
U8  q_find_line[160];

U0 QBiFind()
{//Linear scan from a start entity for a string field match.
	I64  start = QBiArgEnt(0);
	I64  fld   = QPrGetI(QBiArg(1));
	U8  *match = QBiArgS(2);
	I64  found = 0;
	I64  i;
	U8  *s;

	for (i = start + 1; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
		{
			s = QPrStr(QPrFieldI(i, fld));
			if (s[0] && !StrCompare(s, match))
			{
				found = i;
				goto qf_done;
			}
		}
	}

qf_done:
	//Same start and same answer as last time means a caller's walk is not
	//progressing.
	if (start == q_find_last_start && found == q_find_last_result && found != 0)
		q_find_repeats++;
	else
		q_find_repeats = 0;

	if (q_find_repeats == 8 && q_find_reports < QFIND_MAX_REPORTS)
	{
		q_find_reports++;

		StrPrint(q_find_line,
			"find: NOT ADVANCING start=%d -> %d field=%d match='%s'\n",
			start, found, fld, match);
		QLog(q_find_line);
		QPrStackDump;
		QLogFlush;
	}

	q_find_last_start  = start;
	q_find_last_result = found;

	QBiRetEnt(found);
}

U0 QBiFindRadius()
{//PF_findradius: return a .chain-linked list of every solid edict whose BOX
 //CENTRE lies inside the sphere. T_RadiusDamage / GrenadeExplode walk that
 //list - returning only the first hit (old behaviour) made splash damage a
 //no-op except on a lucky first entity.
	F64 org[3];
	F64 rad;
	F64 eorg[3];
	F64 mins[3];
	F64 maxs[3];
	F64 d[3];
	I64 i;
	I64 j;
	I64 chain;

	QBiArgV(0, org);
	rad = QBiArgF(1);
	chain = 0;		//world terminates the list, as in the original

	if (q_fld_chain < 0)
	{
		QBiRetEnt(0);
		return;
	}

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qfr_next;

		if (QPrFieldF(i, q_fld_solid) == 0.0)
			goto qfr_next;

		QBiGetFieldV(i, q_fld_origin, eorg);
		QBiGetFieldV(i, q_fld_mins, mins);
		QBiGetFieldV(i, q_fld_maxs, maxs);

		for (j = 0; j < 3; j++)
			eorg[j] = eorg[j] + (mins[j] + maxs[j]) * 0.5;

		QVecSub(eorg, org, d);
		if (QVecLength(d) > rad)
			goto qfr_next;

		QPrSetFieldI(i, q_fld_chain, QPrEdictValue(chain));
		chain = i;

qfr_next:
	}

	QBiRetEnt(chain);
}

U0 QBiNextEnt()
{
	I64 i = QBiArgEnt(0) + 1;

	while (i < q_pr_num_edicts)
	{
		if (!q_pr_edict_free[i])
		{
			QBiRetEnt(i);
			return;
		}
		i++;
	}

	QBiRetEnt(0);
}

U0 QBiVecToYaw()
{
	F64 v[3];
	F64 yaw;

	QBiArgV(0, v);

	if (v[0] == 0.0 && v[1] == 0.0)
		yaw = 0.0;
	else
	{
		yaw = Arg(v[0], v[1]) / QDEG2RAD;
		if (yaw < 0.0)
			yaw += 360.0;
	}

	QBiRetF(yaw);
}

U0 QBiVecToAngles()
{
	F64 v[3];
	F64 out[3];

	QBiArgV(0, v);
	QVecToAngles(v, out);
	QBiRetV(out);
}

U0 QBiVtos()
{//PF_vtos: "%5.1f %5.1f %5.1f". Returning the null string made every dprint
 //that reports a position - "Bonus item fell out of level at " chief among
 //them - stop dead right where the numbers should be.
	F64 v[3];
	U8  buf[64];

	QBiArgV(0, v);
	StrPrint(buf, "%5.1f %5.1f %5.1f", v[0], v[1], v[2]);

	QPrSetI(QPR_OFS_RETURN, QPrTempString(buf));
}

U0 QBiFtos()
{//PF_ftos: whole numbers print as integers, everything else as %5.1f.
	F64 v = QBiArgF(0);
	U8  buf[32];

	if (v == ToF64(ToI64(v)))
		StrPrint(buf, "%d", ToI64(v));
	else
		StrPrint(buf, "%5.1f", v);

	QPrSetI(QPR_OFS_RETURN, QPrTempString(buf));
}

U0 QBiSpawn()
{
	QBiRetEnt(QPrSpawnEdict);
}

U0 QBiRemove()
{
	QPrFreeEdict(QBiArgEnt(0));
}

//Text QuakeC printed, waiting for the console to collect it. The console lives
//in QMenu.ZC, which is compiled after this file, so the text is parked here and
//drained from there - the same arrangement the fov and cheat requests use.
//
//This matters more than it looks: W_ChangeWeapon answers a weapon key you have
//no weapon for with sprint("no weapon.\n"), and W_SetCurrentAmmo with "not
//enough ammo.". With those going nowhere, pressing 5 for a weapon you do not
//own is indistinguishable from the key not working at all.
#define QBI_PRINT_MAX	1024

U8	q_bi_print_buf[QBI_PRINT_MAX];
I64	q_bi_print_len = 0;

U0 QBiPrintAppend(U8 *s)
{
	I64 n;

	if (!s)
		return;

	n = StrLen(s);

	//Dropped rather than truncated mid-line: a half line in the console is worse
	//than a missing one.
	if (q_bi_print_len + n + 1 >= QBI_PRINT_MAX)
		return;

	MemCopy(q_bi_print_buf + q_bi_print_len, s, n);
	q_bi_print_len += n;
	q_bi_print_buf[q_bi_print_len] = 0;
}

//Commands QuakeC pushed at the client with stuffcmd, waiting to be executed.
//
//stuffcmd is Cbuf_AddText: the text is a CONSOLE COMMAND, run on the client as
//if typed. It is not decoration - "bf" is V_BonusFlash_f, and QuakeC fires it
//for every item pickup and on every tick of a powerup running out. With the
//builtin stubbed there was no pickup flash at all, and a Ring of Shadows could
//fade with no warning whatsoever.
#define QBI_STUFF_MAX	512

U8	q_bi_stuff_buf[QBI_STUFF_MAX];
I64	q_bi_stuff_len = 0;

U0 QBiStuffCmd(I64 ent, U8 *s)
{//stuffcmd(client, text). Argument 0 names WHICH client runs it, and ignoring
 //it meant every "bf" QuakeC aimed at a player fired on the host instead - so
 //the host flashed when a remote picked something up.
	I64 n;
	I64 slot;

	if (!s || !s[0])
		return;

	//Remote client: svc_stufftext on its own reliable channel.
	if (ent > 0 && ent != q_player_edict)
	{
		slot = ent - 1;		//edicts 1..maxclients are reserved per slot
		if (slot >= 0 && slot < QSV_MAX_CLIENTS)
		{
			QBiWireByte(&q_sv_client_msg[slot], QSVC_STUFFTEXT);
			QBiWireString(&q_sv_client_msg[slot], s);
		}
		return;
	}

	n = StrLen(s);

	if (q_bi_stuff_len + n + 1 >= QBI_STUFF_MAX)
		return;

	MemCopy(q_bi_stuff_buf + q_bi_stuff_len, s, n);
	q_bi_stuff_len += n;
	q_bi_stuff_buf[q_bi_stuff_len] = 0;
}

U0 QBiPrint(I64 first_arg, I64 dest = 0)
{//bprint/sprint/dprint all funnel here.
 //dest: 0 = this machine only (dprint), 1 = every client (bprint), or a client
 //edict for sprint. Printing everything locally meant a remote player's private
 //messages appeared on the host and never reached them.
	I64		 i;
	I64		 argc = q_pr_argc;
	CQMsg	*m;

	//BOUNDED BY THE ACTUAL ARGUMENT COUNT, not by hunting for a zero slot.
	//
	//The OFS_PARM globals keep whatever the previous call left in them, so
	//`sprint(other, "You got ")` would happily go on to print the sound name a
	//sound() call had passed moments earlier - producing lines like
	//"You got player/death2.wav shells" and obituaries with names run together.
	//PF_VarString stops at pr_argc for exactly this reason.
	if (argc > QPR_MAX_PARMS)
		argc = QPR_MAX_PARMS;

	//sprint to a remote client: svc_print on its own channel, and nowhere else.
	m = QBiClientMsg(dest);
	if (m)
	{
		QBiWireByte(m, QSVC_PRINT);
		for (i = first_arg; i < argc; i++)
			QBiWireString(m, QBiArgS(i));
		return;
	}

	//bprint reaches everyone THROUGH THE PROTOCOL, including this machine: the
	//listen server's own client parses svc_print like any other. Printing it
	//locally as well is what made every join and every obituary appear twice.
	if (dest == 1)
	{
		QBiWireByte(&q_sv_reliable_datagram, QSVC_PRINT);
		for (i = first_arg; i < argc; i++)
			QBiWireString(&q_sv_reliable_datagram, QBiArgS(i));
		return;
	}

	for (i = first_arg; i < argc; i++)
	{
		QBiPrintAppend(QBiArgS(i));

		if (q_bi_dprint)
			"%s", QBiArgS(i);
	}
}

//--- dispatch --------------------------------------------------------------

U0 QBiDispatch(I64 num)
{
	F64		v[3];
	F64		a[3];
	F64		bmax[3];
	I64		ent;
	CQTrace	bi_trace;

	switch (num)
	{
		case 1:		QBiMakeVectors;		break;
		case 2:		QBiSetOrigin;		break;
		case 3:		QBiSetModel;		break;
		case 4:		QBiSetSize;			break;

		case 6:		break;				//break: debugger hook, ignored

		case 7:		QBiRetF(ToF64(RandU32 & 0xFFFF) / 65536.0);	break;

		case 8:
			//sound(entity, channel, sample, volume, attenuation). Play local
			//AND write svc_sound so remotes hear it (SV_StartSound).
			ent = QBiArgEnt(0);
			QBiGetFieldV(ent, q_fld_origin, v);

			//A brush entity's origin is often 0,0,0 with the geometry offset
			//by its bounds, so doors would otherwise all sound like they are
			//at the map origin. Use the box centre instead.
			QBiGetFieldV(ent, q_fld_mins, a);
			if (a[0] != 0.0 || a[1] != 0.0 || a[2] != 0.0)
			{
				QBiGetFieldV(ent, q_fld_maxs, bmax);
				v[0] += (a[0] + bmax[0]) * 0.5;
				v[1] += (a[1] + bmax[1]) * 0.5;
				v[2] += (a[2] + bmax[2]) * 0.5;
			}

			QSndPlayAt(QBiArgS(2), v, QBiArgF(3), QBiArgF(4),
				ent, ToI64(QBiArgF(1)));
			QSvStartSound(ent, ToI64(QBiArgF(1)), QBiArgS(2),
				ToI64(QBiArgF(3) * 255.0), QBiArgF(4));
			break;

		case 9:
			QBiArgV(0, v);
			QVecNormalize(v);
			QBiRetV(v);
			break;

		case 10:
		case 11:
			//PF_objerror prints the offending edict and then Host_Errors, so
			//this is never benign - dump who and where instead of one opaque
			//line. The edict is deliberately NOT freed, unlike the original:
			//ED_Free here would delete the door and take the whole chain with
			//it.
			"QuakeC error: %s\n", QBiArgS(0);
			StrPrint(q_bi_err_line, "QuakeC error: %s\n", QBiArgS(0));
			QLog(q_bi_err_line);
			QPrChainDump;
			QPrStackDump;
			QLogFlush;
			q_pr_error = TRUE;
			break;

		case 12:
			QBiArgV(0, v);
			QBiRetF(QVecLength(v));
			break;

		case 13:	QBiVecToYaw;		break;
		case 14:	QBiSpawn;			break;
		case 15:	QBiRemove;			break;
		case 16:	QBiTraceLine;		break;

		case 17:	QBiCheckClient;		break;	//checkclient

		case 18:	QBiFind;			break;

		case 19:	//precache_sound
		case 76:
			if (q_precache_sound_count < QBI_MAX_PRECACHE)
			{
				q_precache_sound[q_precache_sound_count] = QBiArgS(0);
				q_precache_sound_count++;
			}
			QPrSetI(QPR_OFS_RETURN, QPrGetI(QBiArg(0)));
			break;

		case 20:	//precache_model
		case 75:
			QBiPrecacheModel(QBiArgS(0));
			QPrSetI(QPR_OFS_RETURN, QPrGetI(QBiArg(0)));
			break;

		case 21:	//stuffcmd(client, text) - Cbuf_AddText on the client.
			QBiStuffCmd(QBiArgEnt(0), QBiArgS(1));
			break;
		case 22:	QBiFindRadius;		break;
		case 23:	QBiPrint(0, 1);					break;	//bprint: everyone
		case 24:	QBiPrint(1, QBiArgEnt(0));		break;	//sprint: one client
		case 25:	QBiPrint(0);					break;	//dprint: local only
		case 26:	QBiFtos;			break;

		case 27:	QBiVtos;			break;	//vtos
		case 28:	break;				//coredump
		case 29:	q_pr_trace = TRUE;	break;
		case 30:	q_pr_trace = FALSE;	break;
		case 31:	break;				//eprint

		case 32:	QBiWalkMove;		break;
		case 34:	QBiDropToFloor;		break;
		case 35:	QLightStyleSet(ToI64(QBiArgF(0)), QBiArgS(1));	break;

		case 36:	QBiRetF(Round(QBiArgF(0)));	break;
		case 37:	QBiRetF(Floor(QBiArgF(0)));	break;
		case 38:	QBiRetF(Ceil(QBiArgF(0)));	break;

		case 40:
			//checkbottom(entity): is there floor under it? Answering "yes"
			//unconditionally tells the AI every ledge is safe to walk off.
			ent = QBiArgEnt(0);
			QBiGetFieldV(ent, q_fld_origin, v);
			QVecCopy(v, bmax);
			bmax[2] -= QPHYS_STEPSIZE * 2.0;

			if (!q_bi_map)
				QBiRetF(1.0);
			else
			{
				QBiTraceEnt(ent, v, bmax, &bi_trace);
				QBiRetF(ToF64(bi_trace.fraction < 1.0));
			}
			break;
		case 41:	QBiPointContents;	break;
		case 43:	QBiRetF(Abs(QBiArgF(0)));	break;

		case 44:
			//aim(entity, speed): the direction the shooter is actually facing.
			//
			//This used to hand back the v_forward global, which belongs to
			//whichever entity last called makevectors - usually a monster.
			//Shots then flew along someone else's heading instead of the
			//player's, which reads as firing off into the air.
			ent = QPrEdictNum(QPrGetI(q_ofs_self));
			QBiGetFieldV(ent, q_fld_v_angle, a);

			//Clients aim along v_angle; anything without one uses its body
			//angles instead.
			if (a[0] == 0.0 && a[1] == 0.0 && a[2] == 0.0)
				QBiGetFieldV(ent, q_fld_angles, a);

			QAngleVectors(a, v, NULL, NULL);
			QBiRetV(v);
			break;

		case 45:	QBiRetF(QCvarGet(QBiArgS(0)));	break;	//cvar
		case 46:	QBiLocalCmd(QBiArgS(0));	break;	//localcmd
		case 47:	QBiNextEnt;			break;
		case 48:	//particle(origin, dir, color, count)
			QBiArgV(0, v);
			QBiArgV(1, a);
			QPartEffect(v, a, ToI64(QBiArgF(2)), ToI64(QBiArgF(3)), tS);
			QBiParticleWire(v, a, ToI64(QBiArgF(2)), ToI64(QBiArgF(3)));
			break;
		case 49:	QBiChangeYaw;		break;
		case 51:	QBiVecToAngles;		break;

		//Network message writers: byte and coordinate writers also feed the
		//local temp-entity reassembler so the host sees its own effects.
		case 52:	QBiWriteByte(QBiWriteDest, ToI64(QBiArgF(1)));	break;
		case 53:	QBiWriteByte(QBiWriteDest, ToI64(QBiArgF(1)));	break;
		case 54:	QBiWireShort(QBiWriteDest, ToI64(QBiArgF(1)));	break;
		case 55:	QBiWireLong(QBiWriteDest, ToI64(QBiArgF(1)));	break;
		case 56:	QBiWriteCoord(QBiWriteDest, QBiArgF(1));		break;
		case 57:	QBiWireAngle(QBiWriteDest, QBiArgF(1));			break;
		case 58:	QBiWriteString(QBiWriteDest, QBiArgS(1));		break;
		case 59:	QBiWriteEntity(QBiWriteDest, QBiArgEnt(1));		break;

		case 67:	QBiMoveToGoal;		break;	//movetogoal(dist)

		case 68:
		case 77:
			QPrSetI(QPR_OFS_RETURN, QPrGetI(QBiArg(0)));	break;	//precache_file

		case 69:	QBiMakeStatic;		break;
		case 70:
			//changelevel(mapname). Recorded, not acted on: tearing the world
			//down from inside a running think would free the bytecode that is
			//still executing. The app services this between frames.
			QStrCopy(q_change_map, QBiArgS(0), 64);
			q_change_pending = TRUE;
			break;
		case 72:	//cvar_set(name, value). The value arrives as a string.
			QCvarSet(QBiArgS(0), QAtoF(QBiArgS(1)));
			break;
		case 73:	QBiCenterPrint(QBiArgEnt(0), QBiArgS(1));	break;
		case 74:
			//ambientsound(pos, sample, volume, attenuation). Registered as a
			//permanent looping source rather than played once at load.
			QBiArgV(0, v);
			QSndAmbientAdd(v, QBiArgS(1), QBiArgF(2), QBiArgF(3));
			QBiAmbientSignon(v, QBiArgS(1), QBiArgF(2), QBiArgF(3));
			break;

		case 78:	break;				//setspawnparms

		default:
			//Unknown builtins return zero rather than stopping the VM.
			QPrSetI(QPR_OFS_RETURN, 0);
			break;
	}
}

U0 QBiInit()
{//Install the dispatcher and resolve the trace globals.
	I64 i;

	//Clear the precache tables before anything can walk them. Without this the
	//teardown pass frees heap garbage and takes the process with it.
	for (i = 0; i < QBI_MAX_PRECACHE; i++)
	{
		q_precache_model[i] = NULL;
		q_precache_mdl[i]   = NULL;
		q_precache_sound[i] = NULL;
	}
	q_precache_model_count = 0;
	q_precache_sound_count = 0;

	//The precache->BSP-model table is part of the same state and MUST be reset
	//with it. Leaving it holding the previous map's mapping while the indices
	//are reassigned from zero makes QClipBrushModel return -1 for real brush
	//entities, and a brush entity with no model number is skipped by collision
	//entirely - so doors stop being solid and the player walks through them.
	QClipPrecacheReset;

	q_pr_builtin_call = &QBiDispatch;

	q_ofs_trace_allsolid		= QPrFindGlobal("trace_allsolid");
	q_ofs_trace_startsolid		= QPrFindGlobal("trace_startsolid");
	q_ofs_trace_fraction		= QPrFindGlobal("trace_fraction");
	q_ofs_trace_endpos			= QPrFindGlobal("trace_endpos");
	q_ofs_trace_plane_normal	= QPrFindGlobal("trace_plane_normal");
	q_ofs_trace_plane_dist		= QPrFindGlobal("trace_plane_dist");
	q_ofs_trace_ent				= QPrFindGlobal("trace_ent");
	q_ofs_trace_inopen			= QPrFindGlobal("trace_inopen");
	q_ofs_trace_inwater			= QPrFindGlobal("trace_inwater");
}
