// QDraw.ZC - 8bpp span rasterizer.
//
// Rendering happens in a private 8-bit indexed buffer and only becomes
// truecolor at blit time. That is not nostalgia: lighting is a table lookup
// into the colormap (index, shade) -> index, so keeping indices all the way
// through costs one byte per pixel and no per-pixel multiply.
//
// Pipeline per face:
//   world verts -> camera space (+ texture coords) -> near clip -> project
//   -> scanline fill with perspective-correct texture and lightmap lookup.
//
// Perspective correction currently divides per pixel. That is the honest slow
// version; the marked span loop is the thing to subdivide every 8-16 pixels
// and then hand-write in assembly once the output is known good.

#define QSCR_W			320
#define QSCR_H			240
#define QMAX_POLY_VERTS	64
#define QNEAR_CLIP		4.0		//world units in front of the eye

//Pixels between exact perspective divides. 16 keeps the interpolation error
//below a texel at normal viewing distances while cutting the divide count by
//the same factor.
#define QSPAN_SUB		16

class CQPolyVert
{
	F64	cam[3];		//x right, y up, z forward
	F64	s;			//texture coords in texel units
	F64	t;
};

class CQScreenVert
{
	F64	x;
	F64	y;
	F64	inv_z;
	F64	s_over_z;
	F64	t_over_z;
};

class CQCanvas
{
	U8	*pixels;		//width * height palette indices
	F64	*depth;			//1/z, larger is nearer
	I64	 width;
	I64	 height;

	//View state for the frame being drawn.
	F64	 origin[3];
	F64	 forward[3];
	F64	 right[3];
	F64	 up[3];
	F64	 x_scale;
	F64	 y_scale;
	F64	 center_x;
	F64	 center_y;

	//SCR_CalcRefdef's r_refdef.vrect. viewsize below 100 shrinks the 3D view
	//inside the canvas; everything outside it is left alone so the border and
	//the status bar show through.
	I64	 vx;
	I64	 vy;
	I64	 vw;
	I64	 vh;

	I64	 faces_drawn;
	I64	 spans_drawn;
};

//--- turbulent surfaces ----------------------------------------------------
//
// Water, slime, lava and teleporters scroll their texture through a sine warp.
// R_InitTurb builds one table and D_DrawTurbulent8Span indexes it with the
// OTHER axis, so s is displaced by a function of t and vice versa - that cross
// coupling is what makes it swirl instead of merely sliding.
//
//     sturb = ((s + turb[(t>>16) & (CYCLE-1)]) >> 16) & 63
//     tturb = ((t + turb[(s>>16) & (CYCLE-1)]) >> 16) & 63
//
// The table is AMP + sin(i*2pi/CYCLE)*AMP with AMP = 8 texels, and the phase
// advances at SPEED per second. Turbulent textures are always 64x64, which is
// where the & 63 comes from.
#define QTURB_CYCLE		128
#define QTURB_AMP		8.0
#define QTURB_SPEED		20.0

F64 q_turb_table[QTURB_CYCLE];
I64 q_turb_phase = 0;

U0 QTurbInit()
{//R_InitTurb.
	I64 i;

	for (i = 0; i < QTURB_CYCLE; i++)
		q_turb_table[i] = QTURB_AMP +
			Sin(ToF64(i) * 2.0 * pi / ToF64(QTURB_CYCLE)) * QTURB_AMP;
}

U0 QTurbFrame(F64 time)
{//Advance the scroll. cl.time*SPEED, wrapped to the table.
	q_turb_phase = ToI64(time * QTURB_SPEED) & (QTURB_CYCLE - 1);
}

//--- dynamic lights --------------------------------------------------------
//
// Muzzle flashes, explosions, and the glow a rocket carries with it. These are
// not in the compiled lightmap - they move - so they are added to a face's
// light at draw time, which is what R_AddDynamicLights does.
//
// A light is projected onto the surface's plane, and each luxel is brightened by
// how far it is from that impact point, using the original's cheap approximation
// of distance (larger axis plus half the smaller) rather than a square root.

#define QMAX_DLIGHTS		32
#define QDLIGHT_MINLIGHT	4.0

class CQDlight
{
	F64	origin[3];
	F64	radius;
	F64	die;			//absolute time it expires
	F64	decay;			//radius lost per second
	F64	min_light;
};

CQDlight	q_dlight[QMAX_DLIGHTS];
I64			q_dlight_count = 0;

U0 QDlightClear()
{
	q_dlight_count = 0;
}

U0 QDlightAdd(F64 *origin, F64 radius, F64 life, F64 decay, F64 time)
{//Register a light. The oldest slot is recycled when full, since these are all
 //short lived and losing the stalest one is unnoticeable.
	CQDlight	*d;
	I64			 slot = -1;
	I64			 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= time)
		{
			slot = i;
			break;
		}
	}

	if (slot < 0)
	{
		if (q_dlight_count < QMAX_DLIGHTS)
		{
			slot = q_dlight_count;
			q_dlight_count++;
		}
		else
			slot = 0;
	}

	d = &q_dlight[slot];
	QVecCopy(origin, d->origin);
	d->radius    = radius;
	d->die       = time + life;
	d->decay     = decay;
	d->min_light = QDLIGHT_MINLIGHT;
}

U0 QDlightUpdate(F64 dt, F64 time)
{//Shrink live lights and drop expired ones.
	I64 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= time)
			goto qdl_next;

		q_dlight[i].radius -= dt * q_dlight[i].decay;
		if (q_dlight[i].radius < 0.0)
			q_dlight[i].die = 0.0;

qdl_next:
	}
}

Bool QDlightsActive(F64 time)
{//Cheap gate: most frames have none at all.
	I64 i;

	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die > time && q_dlight[i].radius > 0.0)
			return TRUE;
	}

	return FALSE;
}

//--- animated light styles -------------------------------------------------
//
// A style is a string of letters sampled at 10Hz: 'a' is black, 'm' is normal
// brightness, 'z' is roughly double. R_AnimateLight turns the current letter
// into a scale, and a face's lightmap is the sum of one block per style it
// references, each scaled by that style's current value.
//
// Unlit faces and faces whose styles are all steady take the fast path and use
// the map's lightmap data directly; only animated faces get recombined.

#define QMAX_LIGHTSTYLES	64
#define QLIGHTSTYLE_LEN		64
#define QLIGHTSTYLE_NORMAL	256		//value used when a style has no string

//What a STEADY style resolves to. Worldspawn sets style 0 to "m", and 'm' is
//the 13th letter, so ('m'-'a')*22 = 264 - NOT 256.
//
//This matters more than 3% suggests. The fast path skipped recombining only
//when a style's value was exactly 256, so with style 0 sitting at 264 the fast
//path never triggered and EVERY face in the world went through the recombine.
//Any error in that path therefore hit the entire level at once.
#define QLIGHT_UNITY		264
#define QLIGHT_SCRATCH		4096	//one face's lightmap block, generously

//Used when no lit surface can be found under a model. Matches what entities
//were unconditionally drawn at before any of this existed.
#define QLIGHT_FALLBACK		170

U8	q_lightstyle[QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN];
I64	q_lightstyle_value[QMAX_LIGHTSTYLES];
U8	q_light_scratch[QLIGHT_SCRATCH];
U8	q_light_black[QLIGHT_SCRATCH];	//an unlit face's lightmap: all zeros

//Counters, so it is possible to tell whether the recombine path is even active
//rather than guessing from a screenshot.
I64	q_light_acc[QLIGHT_SCRATCH];	//per-luxel accumulator, 8 bits of fraction
Bool q_dlight_any	= FALSE;		//any live dynamic light this frame
I64	q_light_fast	= 0;
I64	q_light_slow	= 0;
I64	q_light_clamped	= 0;

//R_PushDlights bookkeeping. The frame counter is what makes a face's marks
//self-expiring: a face carrying last frame's number has no lights on it now.
I64 q_dlight_frame	= 0;
I64 q_ambient_light	= 0;		//r_refdef.ambientlight

F64 q_light_time = 0.0;		//time the current frame is being drawn at
F64 q_light_last = 0.0;		//previous frame's time, for the dynamic-light decay

U0 QLightInit()
{//Globals are not zeroed here, so every style starts explicitly steady.
	I64 i;

	MemSet(q_light_black, 0, QLIGHT_SCRATCH);

	q_dlight_any  = FALSE;
	q_dlight_count = 0;
	q_dlight_frame = 0;
	q_ambient_light = 0;
	q_light_last  = 0.0;
	q_light_time  = 0.0;

	for (i = 0; i < QMAX_LIGHTSTYLES; i++)
	{
		q_lightstyle[i * QLIGHTSTYLE_LEN] = 0;
		q_lightstyle_value[i]             = QLIGHTSTYLE_NORMAL;
	}
}

U0 QLightStyleSet(I64 style, U8 *str)
{//The lightstyle builtin. QuakeC calls this at spawn for every switchable and
 //flickering light in the map.
	if (style < 0 || style >= QMAX_LIGHTSTYLES || !str)
		return;

	QStrCopy(&q_lightstyle[style * QLIGHTSTYLE_LEN], str, QLIGHTSTYLE_LEN);
}

U0 QLightFrame(F64 time)
{//Per-frame light bookkeeping: expire and shrink dynamic lights, and cache
 //whether any survive so the per-face path can skip them cheaply.
 //
 //The delta is tracked here rather than passed in: dynamic lights decay in real
 //time, independently of the fixed server step.
	F64 dt = time - q_light_last;

	q_light_last = time;

	//A long stall (a level load) must not decay everything at once.
	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	q_light_time = time;
	QDlightUpdate(dt, time);
	q_dlight_any = QDlightsActive(time);
}

U0 QLightAnimate(F64 time)
{//Advance every style to the letter for this moment. R_AnimateLight.
	U8	*str;
	I64	 frame = ToI64(time * 10.0);
	I64	 len;
	I64	 i;
	I64	 k;

	for (i = 0; i < QMAX_LIGHTSTYLES; i++)
	{
		str = &q_lightstyle[i * QLIGHTSTYLE_LEN];
		len = StrLen(str);

		if (!len)
		{
			q_lightstyle_value[i] = QLIGHTSTYLE_NORMAL;
			goto ql_next;
		}

		k = frame % len;
		if (k < 0)
			k = 0;

		//'a'..'z' maps to 0..550 in steps of 22.
		q_lightstyle_value[i] = (str[k] - 'a') * 22;

ql_next:
	}
}

U0 QMarkLights(CQMap *map, CQDlight *light, I64 bit, I64 node_index)
{//R_MarkLights. Walk the BSP and flag every face the light's sphere can reach,
 //descending only the side(s) it actually straddles.
	CQNode	*node;
	CQPlane	*plane;
	CQFace	*f;
	F64		 dist;
	I64		 i;

	if (node_index < 0 || node_index >= map->num_nodes)
		return;

	node = &map->nodes[node_index];

	if (node->plane_num < 0 || node->plane_num >= map->num_planes)
		return;

	plane = &map->planes[node->plane_num];
	dist  = QVecDot(light->origin, plane->normal) - plane->dist;

	//Entirely on one side: only that child can be lit.
	if (dist > light->radius)
	{
		QMarkLights(map, light, bit, node->children[0]);
		return;
	}
	if (dist < -light->radius)
	{
		QMarkLights(map, light, bit, node->children[1]);
		return;
	}

	for (i = 0; i < node->num_faces; i++)
	{
		if (node->first_face + i < 0 ||
			node->first_face + i >= map->num_faces)
			goto qml_next;

		f = &map->faces[node->first_face + i];

		//First light to reach this face this frame resets the mask.
		if (f->dlight_frame != q_dlight_frame)
		{
			f->dlight_bits  = 0;
			f->dlight_frame = q_dlight_frame;
		}

		f->dlight_bits |= bit;

qml_next:
	}

	QMarkLights(map, light, bit, node->children[0]);
	QMarkLights(map, light, bit, node->children[1]);
}

U0 QPushDlights(CQMap *map, F64 time)
{//R_PushDlights, once per frame before anything is drawn.
	I64 i;

	q_dlight_frame++;

	if (!map || !map->nodes || map->num_nodes < 1)
		return;

	for (i = 0; i < q_dlight_count && i < QMAX_DLIGHTS; i++)
	{
		if (q_dlight[i].die <= time || q_dlight[i].radius <= 0.0)
			goto qpd_next;

		QMarkLights(map, &q_dlight[i], 1 << i, 0);

qpd_next:
	}
}

U0 QLightAddDynamic(CQMap *map, CQFace *f, I64 lm_w, I64 lm_h, F64 time)
{//Fold every dynamic light touching this face into the accumulator.
 //R_AddDynamicLights.
	CQDlight	*d;
	CQPlane		*plane;
	CQTexInfo	*ti;
	F64			 impact[3];
	F64			 local_s;
	F64			 local_t;
	F64			 dist;
	F64			 rad;
	F64			 minlight;
	F64			 sd;
	F64			 td;
	F64			 adist;
	I64			 lnum;
	I64			 sx;
	I64			 ty;
	I64			 j;

	//Indices straight out of the BSP, used here to FORM POINTERS. An out of
	//range one yields a wild address rather than a wrong colour, so they are
	//checked before being trusted.
	if (f->plane_num < 0 || f->plane_num >= map->num_planes)
		return;
	if (f->tex_info < 0 || f->tex_info >= map->num_texinfo)
		return;

	plane = &map->planes[f->plane_num];
	ti    = &map->texinfo[f->tex_info];

	for (lnum = 0; lnum < q_dlight_count; lnum++)
	{
		//R_MarkLights already decided which lights reach this face; anything
		//not in the mask cannot touch it and is skipped without a trace.
		if (!(f->dlight_bits & (1 << lnum)))
			goto qad_next;

		d = &q_dlight[lnum];

		if (d->die <= time || d->radius <= 0.0)
			goto qad_next;

		//How far the light sits off this face's plane. A face on the back side
		//has its normal flipped, so the sign has to follow.
		dist = QVecDot(d->origin, plane->normal) - plane->dist;
		if (f->side)
			dist = -dist;

		rad = d->radius;
		if (dist < 0.0)
			rad -= -dist;
		else
			rad -= dist;

		minlight = d->min_light;
		if (rad < minlight)
			goto qad_next;

		minlight = rad - minlight;

		//Project the light onto the surface.
		for (j = 0; j < 3; j++)
		{
			if (f->side)
				impact[j] = d->origin[j] + plane->normal[j] * dist;
			else
				impact[j] = d->origin[j] - plane->normal[j] * dist;
		}

		local_s = QVecDot(impact, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		local_t = QVecDot(impact, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		for (ty = 0; ty < lm_h; ty++)
		{
			td = local_t - ToF64(ty * 16);
			if (td < 0.0)
				td = -td;

			for (sx = 0; sx < lm_w; sx++)
			{
				sd = local_s - ToF64(sx * 16);
				if (sd < 0.0)
					sd = -sd;

				//The original's cheap distance: the larger axis plus half the
				//smaller, rather than a square root per luxel.
				if (sd > td)
					adist = sd + td * 0.5;
				else
					adist = td + sd * 0.5;

				if (adist < minlight)
					q_light_acc[ty * lm_w + sx] +=
						ToI64((rad - adist) * 256.0);
			}
		}

qad_next:
	}
}

U8 *QLightFaceMap(CQMap *map, CQFace *f, I64 lm_w, I64 lm_h, F64 time)
{//The lightmap to render this face with: its compiled lighting, scaled by the
 //current value of each style it uses, plus any dynamic lights on it.
 //
 //Returns the map's own data untouched whenever nothing is animated and no
 //dynamic light reaches the face, so the common case costs one comparison
 //rather than a per-texel recombine.
	U8	*base;
	I64	 size = lm_w * lm_h;
	I64	 count;
	I64	 acc;
	I64	 scale;
	I64	 i;
	I64	 j;
	Bool dyn;

	//Only a map with NO light data at all renders fullbright - that is
	//R_BuildLightMap's !lightdata case. A face without samples in a LIT map is
	//one the light compiler decided nothing reaches, and blocklights stays at
	//the zeros it was cleared to: the face renders black. Handing these back
	//as "no lightmap" made every unlit ceiling and cavity glow at full
	//brightness instead.
	if (!map->lightdata)
		return NULL;
	if (f->light_offset < 0)
	{
		//A rocket or muzzle flash still lands on an unlit face - the zeros
		//are only the base the dynamic pass accumulates over.
		if (q_dlight_any && f->dlight_frame == q_dlight_frame &&
			f->dlight_bits != 0 && size > 0 && size <= QLIGHT_SCRATCH)
		{
			for (i = 0; i < size; i++)
				q_light_acc[i] = 0;

			QLightAddDynamic(map, f, lm_w, lm_h, time);

			for (i = 0; i < size; i++)
			{
				acc = q_light_acc[i] / QLIGHT_UNITY;
				if (acc > 255)
					acc = 255;
				if (acc < 0)
					acc = 0;
				q_light_scratch[i] = acc;
			}

			return q_light_scratch;
		}

		return q_light_black;
	}

	if (q_ambient_light < 0)
		q_ambient_light = 0;
	if (q_ambient_light > 255)
		q_ambient_light = 255;

	base = map->lightdata + f->light_offset;

	//How many styles this face actually uses. 255 terminates the list, and any
	//index outside the table would read past it, so that ends the list too.
	count = 0;
	while (count < 4 && f->styles[count] != 255 &&
		f->styles[count] < QMAX_LIGHTSTYLES)
		count++;

	if (!count)
		return base;

	if (size <= 0 || size > QLIGHT_SCRATCH)
		return base;

	//Marked by R_MarkLights this frame, rather than "some light exists".
	dyn = ToBool(q_dlight_any && f->dlight_frame == q_dlight_frame &&
			f->dlight_bits != 0);

	//One steady style and no dynamic light means the whole recombine is a
	//no-op, so hand back the map's own data.
	//Ambient has to be added to every luxel, so it rules out the fast path.
	if (!dyn && !q_ambient_light && count == 1 &&
		q_lightstyle_value[f->styles[0]] == QLIGHT_UNITY)
	{
		q_light_fast++;
		return base;
	}

	//Every style adds another block of the same size after the first, so the
	//multi-style read is longer than the caller's single-block bounds check.
	if (f->light_offset + count * size > map->lightdata_size)
		return base;

	q_light_slow++;

	//Accumulate at 8 bits of fraction so dynamic lights can be added before
	//anything is rounded or clamped.
	for (i = 0; i < size; i++)
	{
		//R_BuildLightMap clears to the ambient level before adding any
		//lightmap, so an unlit corner still reads at r_ambient rather than
		//black. Expressed in the accumulator's units.
		acc = q_ambient_light * QLIGHT_UNITY;

		for (j = 0; j < count; j++)
		{
			scale = q_lightstyle_value[f->styles[j]];
			//NOT ToI64(): base[] is a U8, an INTEGER. ToI64 is the F64->I64
			//intrinsic, so it would reinterpret the byte's value as a
			//double's bit pattern and yield garbage. A U8 already widens.
			acc  += base[j * size + i] * scale;
		}

		q_light_acc[i] = acc;
	}

	if (dyn)
		QLightAddDynamic(map, f, lm_w, lm_h, time);

	for (i = 0; i < size; i++)
	{
		//Divided by what a STEADY style resolves to, not by 256.
		//
		//Using 256 made an ordinary face come out 264/256 = 3% brighter than
		//its compiled lighting, which is enough to drive every luxel above 248
		//into the clamp and flatten the bright end of the whole level. Dividing
		//by 264 makes a steady face exactly neutral, and leaves a flickering
		//style genuinely brighter or darker than neutral as intended.
		acc = q_light_acc[i] / QLIGHT_UNITY;

		if (acc > 255)
		{
			acc = 255;
			q_light_clamped++;
		}
		if (acc < 0)
			acc = 0;

		q_light_scratch[i] = acc;
	}

	return q_light_scratch;
}

I64 QLightPoint(CQMap *map, F64 *point)
{//How brightly lit a spot in the world is, by sampling the lightmap of the
 //surface below it. R_LightPoint.
 //
 //Alias models have no lightmap of their own, so this is what makes a monster
 //standing in shadow render dark and one under a lamp render bright, instead of
 //every model being drawn at the same flat value regardless of where it stands.
	F64		  end[3];
	F64		  dl[3];
	F64		  add;
	CQTrace	  tr;
	CQFace	 *f;
	CQTexInfo *ti;
	CQLeaf	 *leaf;
	F64		  s_coord;
	F64		 t_coord;
	I64		 ds;
	I64		 dt;
	I64		 lm_w;
	I64		 lm_h;
	I64		 i;
	I64		 node;
	I64		 best = -1;

	if (!map || !map->lightdata)
		return QLIGHT_FALLBACK;

	//Straight down, far enough to clear any room height.
	QVecCopy(point, end);
	end[2] -= 2048.0;

	QTraceMove(map, point, end, &tr);

	if (!tr.hit || tr.fraction == 1.0)
		return QLIGHT_FALLBACK;

	//The trace gives a position but not which face was struck, so the face is
	//found by testing the leaf's surfaces for one containing the impact.
	node = QVisLeafForPoint(map, tr.end_pos);
	if (node <= 0 || node >= map->num_leafs)
		return QLIGHT_FALLBACK;

	leaf = &map->leafs[node];

	for (i = 0; i < leaf->num_marksurfaces; i++)
	{
		f = &map->faces[map->marksurfaces[leaf->first_marksurface + i]];

		if (f->light_offset < 0)
			goto qlp_next;

		//Texture axes live on the texinfo, not the face.
		ti      = &map->texinfo[f->tex_info];
		s_coord = QVecDot(tr.end_pos, &ti->vecs[0]) + ti->vecs[3] - f->mins_s;
		t_coord = QVecDot(tr.end_pos, &ti->vecs[4]) + ti->vecs[7] - f->mins_t;

		if (s_coord < 0.0 || t_coord < 0.0)
			goto qlp_next;
		if (s_coord > ToF64(f->extent_s) || t_coord > ToF64(f->extent_t))
			goto qlp_next;

		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;
		ds   = ToI64(s_coord) / 16;
		dt   = ToI64(t_coord) / 16;

		if (ds < 0)   ds = 0;
		if (dt < 0)   dt = 0;
		if (ds >= lm_w) ds = lm_w - 1;
		if (dt >= lm_h) dt = lm_h - 1;

		if (f->light_offset + dt * lm_w + ds >= map->lightdata_size)
			goto qlp_next;

		//Same reason as above: this is a U8, so no ToI64.
		best = map->lightdata[f->light_offset + dt * lm_w + ds];
		break;

qlp_next:
	}

	if (best < 0)
		best = QLIGHT_FALLBACK;

	//Dynamic lights reach models too, added as radius-minus-distance from the
	//model's origin. R_DrawAliasModel does exactly this before handing the
	//value to the shading setup - without it a rocket lights the walls it flies
	//past but leaves the monster standing next to it unlit.
	for (i = 0; i < q_dlight_count; i++)
	{
		if (q_dlight[i].die <= q_light_time || q_dlight[i].radius <= 0.0)
			goto qlp_dl_next;

		QVecSub(point, q_dlight[i].origin, dl);
		add = q_dlight[i].radius - QVecLength(dl);

		if (add > 0.0)
			best += ToI64(add);

qlp_dl_next:
	}

	//Clamped so a nearby light does not wash the model out completely. The
	//original caps the ambient term for the same reason.
	if (best > 128)
		best = 128;

	//Keep models from going completely black in unlit corners.
	if (best < 24)
		best = 24;

	return best;
}

CQCanvas *QDrawNew(I64 w, I64 h)
{//The render target is allocated at whatever size is asked for. Cost scales
 //with the pixel count, so this is the main performance dial: 640x480 is four
 //times the work of 320x240.
	CQCanvas *c = CAlloc(sizeof(CQCanvas));

	if (w < 64)		w = 64;
	if (h < 64)		h = 64;
	if (w > 1920)	w = 1920;
	if (h > 1200)	h = 1200;

	c->width  = w;
	c->height = h;

	//Full canvas until SCR_CalcRefdef says otherwise.
	c->vx = 0;
	c->vy = 0;
	c->vw = w;
	c->vh = h;
	c->pixels = CAlloc(w * h);
	c->depth  = CAlloc(w * h * sizeof(F64));

	return c;
}

U0 QDrawFree(CQCanvas *c)
{
	if (!c)
		return;

	if (c->pixels)	Free(c->pixels);
	if (c->depth)	Free(c->depth);

	Free(c);
}

U0 QDrawClear(CQCanvas *c, I64 color_index)
{
	MemSet(c->pixels, color_index, c->width * c->height);
	MemSet(c->depth, 0, c->width * c->height * sizeof(F64));
	c->faces_drawn = 0;
	c->spans_drawn = 0;
}

U0 QDrawSetViewRect(CQCanvas *c, F64 viewsize, I64 sbar_h)
{//SCR_CalcRefdef. viewsize 100 and up fills the width; below that the view
 //shrinks proportionally and is centred in the space above the status bar.
	F64 size;
	I64 avail;

	if (viewsize < 30.0)	viewsize = 30.0;
	if (viewsize > 120.0)	viewsize = 120.0;

	//At 110 and above the bar is gone, so the view gets the whole height.
	if (viewsize >= 110.0)
		sbar_h = 0;

	size = viewsize;
	if (size > 100.0)
		size = 100.0;
	size = size / 100.0;

	avail = c->height - sbar_h;

	c->vw = ToI64(ToF64(c->width) * size);
	c->vh = ToI64(ToF64(c->height) * size);

	if (c->vw < 96)
		c->vw = 96;
	if (c->vh > avail)
		c->vh = avail;
	if (c->vh < 64)
		c->vh = 64;

	c->vx = (c->width - c->vw) / 2;
	c->vy = (avail - c->vh) / 2;

	if (c->vx < 0)	c->vx = 0;
	if (c->vy < 0)	c->vy = 0;
}

U0 QDrawSetView(CQCanvas *c, F64 *origin, F64 *angles, F64 fov_x)
{//Derive the projection scales from the horizontal field of view. The
 //vertical scale reuses x_scale so pixels stay square.
	F64 half = fov_x * 0.5 * QDEG2RAD;

	QVecCopy(origin, c->origin);
	QAngleVectors(angles, c->forward, c->right, c->up);

	//Centred on the VIEW RECT, not the canvas: a shrunken view must stay
	//centred in its own window rather than aiming at the middle of the screen.
	c->center_x = ToF64(c->vx) + ToF64(c->vw) * 0.5;
	c->center_y = ToF64(c->vy) + ToF64(c->vh) * 0.5;
	c->x_scale  = ToF64(c->vw) * 0.5 / Tan(half);
	c->y_scale  = c->x_scale;
}

F64 QDrawFovY(F64 fov_x, I64 width, I64 height)
{//Matching vertical fov for square pixels, in degrees.
	F64 half = fov_x * 0.5 * QDEG2RAD;
	F64 t    = Tan(half) * ToF64(height) / ToF64(width);

	return ATan(t) * 2.0 / QDEG2RAD;
}

I64 QDrawClipNear(CQPolyVert *in, I64 count, CQPolyVert *out)
{//Sutherland-Hodgman against z = QNEAR_CLIP. Everything else is handled by
 //clamping at scan time, so this is the only clip plane that must be exact -
 //without it a vertex behind the eye projects to a wild coordinate.
	I64 i;
	I64 j;
	I64 n = 0;
	F64 d1;
	F64 d2;
	F64 frac;

	for (i = 0; i < count; i++)
	{
		j  = (i + 1) % count;
		d1 = in[i].cam[2] - QNEAR_CLIP;
		d2 = in[j].cam[2] - QNEAR_CLIP;

		if (d1 >= 0.0)
		{
			if (n < QMAX_POLY_VERTS)
			{
				MemCopy(&out[n], &in[i], sizeof(CQPolyVert));
				n++;
			}
		}

		//Crossing the plane in either direction contributes one new vertex.
		if ((d1 >= 0.0) != (d2 >= 0.0))
		{
			if (n < QMAX_POLY_VERTS && (d1 - d2) != 0.0)
			{
				frac = d1 / (d1 - d2);
				out[n].cam[0] = in[i].cam[0] + frac * (in[j].cam[0] - in[i].cam[0]);
				out[n].cam[1] = in[i].cam[1] + frac * (in[j].cam[1] - in[i].cam[1]);
				out[n].cam[2] = in[i].cam[2] + frac * (in[j].cam[2] - in[i].cam[2]);
				out[n].s      = in[i].s + frac * (in[j].s - in[i].s);
				out[n].t      = in[i].t + frac * (in[j].t - in[i].t);
				n++;
			}
		}
	}

	return n;
}

F64 QLightBilinear(U8 *lightmap, I64 lm_w, I64 lm_h, F64 ls, F64 lt)
{//One lightmap sample with the four neighbours blended.
 //
 //Quake's software renderer interpolates lighting across each surface block
 //(the lightleftstep/lightstep machinery in R_DrawSurfaceBlock8). Taking the
 //nearest luxel instead makes every 16-texel cell a flat slab of one value
 //with a hard edge against its neighbours - which reads as one stair tread
 //being lit while the one beside it is black.
	I64 lx0, ly0, lx1, ly1;
	F64 fs, ft;
	F64 top, bot;

	if (ls < 0.0)	ls = 0.0;
	if (lt < 0.0)	lt = 0.0;

	lx0 = ToI64(Floor(ls));
	ly0 = ToI64(Floor(lt));
	fs  = ls - ToF64(lx0);
	ft  = lt - ToF64(ly0);

	lx1 = lx0 + 1;
	ly1 = ly0 + 1;

	lx0 = ClampI64(lx0, 0, lm_w - 1);
	lx1 = ClampI64(lx1, 0, lm_w - 1);
	ly0 = ClampI64(ly0, 0, lm_h - 1);
	ly1 = ClampI64(ly1, 0, lm_h - 1);

	top = ToF64(lightmap[ly0 * lm_w + lx0]) * (1.0 - fs) +
		  ToF64(lightmap[ly0 * lm_w + lx1]) * fs;
	bot = ToF64(lightmap[ly1 * lm_w + lx0]) * (1.0 - fs) +
		  ToF64(lightmap[ly1 * lm_w + lx1]) * fs;

	return top * (1.0 - ft) + bot * ft;
}

I64 QTextureAnimation(CQMap *map, I64 miptex, I64 frame, F64 time)
{//R_TextureAnimation. Walks the ring until it finds the frame covering the
 //current tick, having first swapped to the alternate chain if the entity
 //asked for it.
	CQTexture	*base;
	I64			 idx;
	I64			 rel;
	I64			 count;

	if (miptex < 0 || miptex >= map->num_textures)
		return -1;

	idx  = miptex;
	base = &map->textures[idx];

	//.frame selects the alternate sequence - a pressed button, an open door.
	if (frame && base->alt_anims >= 0 &&
		base->alt_anims < map->num_textures)
	{
		idx  = base->alt_anims;
		base = &map->textures[idx];
	}

	if (!base->anim_total)
		return idx;

	rel = ToI64(time * 10.0) % base->anim_total;
	if (rel < 0)
		rel += base->anim_total;

	count = 0;
	while (base->anim_min > rel || base->anim_max <= rel)
	{
		idx = base->anim_next;
		if (idx < 0 || idx >= map->num_textures)
			break;

		base = &map->textures[idx];

		//A malformed ring must not hang the renderer.
		count++;
		if (count > 100)
			break;
	}

	//Returned as an INDEX: ZealC pointer subtraction is not reliably scaled by
	//the element size, and the caller needs the number anyway to key the cache.
	return idx;
}

//--- surface cache ----------------------------------------------------------
//
// D_CacheSurface. Quake does NOT light a wall pixel by pixel every frame: it
// builds the surface's texture with its lighting already folded in, once, at
// the mip it is being drawn at, and then the span loop is a plain texture
// fetch. A surface that has not moved and whose lighting has not changed is
// simply reused next frame.
//
// The cache is keyed on the mip AND on a lighting key, so an animated style or
// a dynamic light rebuilds the surface while a static wall never does.

#define QSURF_SLOTS			512
#define QSURF_BUDGET		6291456		//6MB of lit surfaces

class CQSurfCache
{
	U8	*pixels;
	I64	 bytes;			//allocated size, which may exceed w*h after a rebuild
	I64	 w;
	I64	 h;
	I64	 mip;
	I64	 face;			//face index owning this slot, -1 when free
	I64	 frame;			//last frame it was used, for eviction
	I64	 light_key;		//lighting state it was built from
	I64	 texture;		//which animation frame it was built from
};

CQSurfCache	 q_surf[QSURF_SLOTS];
I64			*q_face_surf	= NULL;		//face index -> slot, -1 for none
I64			 q_face_surf_n	= 0;
CQMap		*q_surf_map		= NULL;
I64			 q_surf_bytes	= 0;
I64			 q_surf_frame	= 0;
I64			 q_surf_builds	= 0;
I64			 q_surf_hits	= 0;

U0 QSurfCacheInit()
{//Globals are NOT zeroed. Every pointer in this table is handed to Free() the
 //first time a map is loaded, so a garbage one faults inside the allocator -
 //nowhere near here, and only once a game is actually started.
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		q_surf[i].pixels    = NULL;
		q_surf[i].bytes     = 0;
		q_surf[i].w         = 0;
		q_surf[i].h         = 0;
		q_surf[i].face      = -1;
		q_surf[i].frame     = -1;
		q_surf[i].mip       = -1;
		q_surf[i].light_key = -1;
		q_surf[i].texture   = -1;
	}

	q_face_surf   = NULL;
	q_face_surf_n = 0;
	q_surf_map    = NULL;
	q_surf_bytes  = 0;
	q_surf_frame  = 0;
	q_surf_builds = 0;
	q_surf_hits   = 0;
}

U0 QSurfCacheFlush()
{//Drop everything. Called on map change and whenever the palette changes.
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (q_surf[i].pixels)
			Free(q_surf[i].pixels);

		q_surf[i].pixels    = NULL;
		q_surf[i].bytes     = 0;
		q_surf[i].face      = -1;
		q_surf[i].frame     = -1;
		q_surf[i].mip       = -1;
		q_surf[i].light_key = -1;
		q_surf[i].texture   = -1;
	}

	if (q_face_surf)
	{
		for (i = 0; i < q_face_surf_n; i++)
			q_face_surf[i] = -1;
	}

	q_surf_bytes = 0;
}

U0 QSurfCacheSetMap(CQMap *map)
{//One slot table per map. Face indices are only meaningful within a map, so
 //the mapping has to be thrown away with it.
	if (map == q_surf_map)
		return;

	QSurfCacheFlush;

	if (q_face_surf)
	{
		Free(q_face_surf);
		q_face_surf   = NULL;
		q_face_surf_n = 0;
	}

	q_surf_map = map;

	if (map && map->num_faces > 0)
	{
		q_face_surf_n = map->num_faces;
		q_face_surf   = MAlloc(q_face_surf_n * sizeof(I64));
		MemSet(q_face_surf, 0xFF, q_face_surf_n * sizeof(I64));
	}
}

Bool QSurfCacheRelease()
{//Free the least recently used slot that actually HOLDS memory, and say
 //whether anything was released.
 //
 //Only slots that hold memory qualify. Returning the first unowned slot frees
 //nothing for an empty one, and the caller's "release until it fits" loop then
 //spins on the same slot forever.
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (!q_surf[i].pixels)
			goto qsr_next;

		//In use this frame: it is about to be drawn.
		if (q_surf[i].frame == q_surf_frame)
			goto qsr_next;

		if (q_surf[i].frame < best_frame)
		{
			best_frame = q_surf[i].frame;
			best       = i;
		}

qsr_next:
	}

	if (best < 0)
		return FALSE;

	if (q_face_surf && q_surf[best].face >= 0 &&
		q_surf[best].face < q_face_surf_n)
		q_face_surf[q_surf[best].face] = -1;

	q_surf_bytes -= q_surf[best].bytes;
	Free(q_surf[best].pixels);

	q_surf[best].pixels    = NULL;
	q_surf[best].bytes     = 0;
	q_surf[best].face      = -1;
	q_surf[best].frame     = -1;
	q_surf[best].mip       = -1;
	q_surf[best].light_key = -1;

	return TRUE;
}

I64 QSurfCacheEvict()
{//A slot to build into: a free one, or the least recently used.
	I64 best = -1;
	I64 best_frame = I64_MAX;
	I64 i;

	for (i = 0; i < QSURF_SLOTS; i++)
	{
		if (q_surf[i].face < 0)
			return i;

		if (q_surf[i].frame < best_frame)
		{
			best_frame = q_surf[i].frame;
			best       = i;
		}
	}

	if (best < 0)
		return -1;

	//Never take a slot already used this frame.
	if (q_surf[best].frame == q_surf_frame)
		return -1;

	if (q_face_surf && q_surf[best].face >= 0 &&
		q_surf[best].face < q_face_surf_n)
		q_face_surf[q_surf[best].face] = -1;

	q_surf[best].face = -1;

	return best;
}

I64 QTexWrap(I64 v, I64 n)
{//Tile a texture coordinate into 0..n-1 for ANY n.
 //
 //A Quake texture's dimensions are multiples of SIXTEEN, not powers of two -
 //96x64 and 192x128 are both ordinary sizes. Masking with (n - 1) is only a
 //wrap when n is a power of two; on 96 the mask is 95, which is not a
 //contiguous run of low bits at all, so coordinates fold back on themselves
 //and the texture repeats in fragments. R_DrawSurface avoids this by wrapping
 //with an explicit compare and reset rather than a mask.
 //
 //The power-of-two case is still masked, because that is most textures and
 //the mask costs one instruction against a division.
	if (n < 1)
		return 0;

	if (!(n & (n - 1)))
		return v & (n - 1);

	v = v % n;
	if (v < 0)
		v += n;

	return v;
}

I64 QSurfLightKey(CQFace *f)
{//What the cached lighting was built from. Any change here means rebuild.
	I64 key = 0;
	I64 j;

	for (j = 0; j < 4; j++)
	{
		if (f->styles[j] == 255)
			break;
		if (f->styles[j] < QMAX_LIGHTSTYLES)
			key = key * 31 + q_lightstyle_value[f->styles[j]];
	}

	key = key * 31 + q_ambient_light;

	//A face under a dynamic light is rebuilt every frame it is marked, and once
	//more on the frame the light leaves it.
	if (f->dlight_frame == q_dlight_frame && f->dlight_bits)
		key = key * 31 + q_dlight_frame + 1;

	return key;
}

U8 *QSurfCacheGet(CQMap *map, CQFace *f, I64 face_index, CQTexture *tex,
	I64 mip, U8 *lightmap, I64 lm_w, I64 lm_h, I64 *_cw, I64 *_ch,
	I64 tex_key = 0)
{//R_DrawSurface: the face's texture with its lighting already applied, at the
 //mip it is about to be drawn at. NULL means "not cached, light it per pixel".
	CQSurfCache	*sc;
	U8			*texels;
	U8			*out;
	I64			 slot;
	I64			 cw, ch;
	I64			 tw, th;
	I64			 need;
	I64			 key;
	I64			 u, v;
	I64			 tx, ty;
	I64			 s0, t0;
	I64			 mins_s_i, mins_t_i;
	I64			 texel;
	I64			 light;
	I64			 shade;
	F64			 lightv;

	//The slot table is indexed by face number within ONE map. An external brush
	//model has its own face numbering, so caching it here would hand back a
	//world surface with the same index.
	if (map != q_surf_map)
		return NULL;

	if (!q_face_surf || face_index < 0 || face_index >= q_face_surf_n)
		return NULL;

	texels = tex->texels[mip];
	tw     = tex->width >> mip;
	th     = tex->height >> mip;

	if (!texels || tw <= 0 || th <= 0)
		return NULL;

	cw = (f->extent_s >> mip) + 1;
	ch = (f->extent_t >> mip) + 1;

	if (cw <= 0 || ch <= 0)
		return NULL;

	need = cw * ch;
	if (need > QSURF_BUDGET / 4)
		return NULL;			//absurdly large surface, not worth caching

	key  = QSurfLightKey(f);
	slot = q_face_surf[face_index];

	if (slot >= 0 && slot < QSURF_SLOTS)
	{
		sc = &q_surf[slot];

		if (sc->face == face_index && sc->mip == mip &&
			sc->light_key == key && sc->texture == tex_key && sc->pixels)
		{
			sc->frame = q_surf_frame;
			*_cw = sc->w;
			*_ch = sc->h;
			q_surf_hits++;
			return sc->pixels;
		}
	}
	else
	{
		slot = QSurfCacheEvict;
		if (slot < 0)
			return NULL;
	}

	sc = &q_surf[slot];

	//Grow only. A surface bounces between mips as the player walks, and
	//reallocating both ways would churn the heap for no gain.
	if (sc->bytes < need)
	{
		//Release until it fits, and give up the moment nothing more can be
		//released rather than spinning.
		while (q_surf_bytes + need - sc->bytes > QSURF_BUDGET)
		{
			if (!QSurfCacheRelease)
				break;
		}

		//Still over budget with nothing left to free: draw it the slow way
		//this frame instead of growing the heap without limit.
		if (q_surf_bytes + need - sc->bytes > QSURF_BUDGET)
			return NULL;

		if (sc->pixels)
		{
			q_surf_bytes -= sc->bytes;
			Free(sc->pixels);
			sc->pixels = NULL;
			sc->bytes  = 0;
		}

		sc->pixels = MAlloc(need);
		if (!sc->pixels)
		{
			sc->bytes = 0;
			return NULL;
		}

		sc->bytes = need;
		q_surf_bytes += need;
	}

	out      = sc->pixels;
	mins_s_i = ToI64(f->mins_s);
	mins_t_i = ToI64(f->mins_t);

	for (v = 0; v < ch; v++)
	{
		t0 = v << mip;
		ty = QTexWrap((mins_t_i + t0) >> mip, th);

		for (u = 0; u < cw; u++)
		{
			s0 = u << mip;
			tx = QTexWrap((mins_s_i + s0) >> mip, tw);

			texel = texels[ty * tw + tx];

			if (lightmap && lm_w > 0 && lm_h > 0)
			{
				lightv = QLightBilinear(lightmap, lm_w, lm_h,
							ToF64(s0) / 16.0, ToF64(t0) / 16.0);
				light  = ClampI64(ToI64(lightv), 0, 255);
			}
			else
				light = 255;

			shade = ClampI64((255 - light) >> 2, 0, QPAL_SHADES - 1);

			if (texel >= QPAL_FULLBRIGHT)
				out[v * cw + u] = texel;
			else
				out[v * cw + u] = qpal_colormap[shade * QPAL_COLORS + texel];
		}
	}

	sc->w         = cw;
	sc->h         = ch;
	sc->mip       = mip;
	sc->face      = face_index;
	sc->frame     = q_surf_frame;
	sc->light_key = key;
	sc->texture   = tex_key;

	q_face_surf[face_index] = slot;
	q_surf_builds++;

	*_cw = cw;
	*_ch = ch;

	return out;
}

U0 QDrawSpan(CQCanvas *c, I64 y, I64 x1, I64 x2,
	F64 iz1, F64 soz1, F64 toz1, F64 iz2, F64 soz2, F64 toz2,
	CQTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U8 *surf = NULL, I64 sw = 0, I64 sh = 0)
{//Fill one horizontal run. HOT LOOP: this is the function to subdivide and
 //then rewrite in assembly. Everything else runs a few thousand times a
 //frame; this runs a few hundred thousand.
	U8	*row;
	U8	*texels;
	F64	*zrow;
	F64	 span;
	F64	 d_iz;
	F64	 d_soz;
	F64	 d_toz;
	F64	 iz;
	F64	 soz;
	F64	 toz;
	F64	 z;
	F64	 s;
	F64	 t;
	F64	 ws;
	F64	 wt;
	Bool	 turb;
	I64	 x;
	I64	 tw;
	I64	 th;
	I64	 tx;
	I64	 ty;
	F64	 lightv;
	F64	 dlight;
	F64	 light_e;
	I64	 light;
	I64	 shade;
	I64	 texel;
	I64	 xe;
	I64	 n;
	I64	 mins_s_i;
	I64	 mins_t_i;
	F64	 iz_e;
	F64	 soz_e;
	F64	 toz_e;
	F64	 s_e;
	F64	 t_e;
	F64	 ds;
	F64	 dt;
	Bool clamp_tex;

	//Clipped to the VIEW RECT, not the canvas: anything outside it belongs to
	//the border or the status bar.
	if (y < c->vy || y >= c->vy + c->vh)
		return;

	//Clamp horizontally, carrying the interpolants with the clamp.
	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz  = (iz2 - iz1) / span;
	d_soz = (soz2 - soz1) / span;
	d_toz = (toz2 - toz1) / span;

	if (x1 < c->vx)
	{
		iz1  += d_iz * ToF64(c->vx - x1);
		soz1 += d_soz * ToF64(c->vx - x1);
		toz1 += d_toz * ToF64(c->vx - x1);
		x1 = c->vx;
	}

	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;

	if (x1 >= x2)
		return;

	//Mip selection. The BSP ships four levels per texture, each half the size
	//of the last; using the smaller ones on distant surfaces removes the
	//shimmer of point sampling and is faster, because far-away geometry then
	//walks a texture small enough to stay in cache.
	if (mip < 0)
		mip = 0;
	if (mip > 3)
		mip = 3;

	while (mip > 0 && !tex->texels[mip])
		mip--;

	//A cached surface already holds the texture with its lighting folded in and
	//is addressed in SURFACE space, so it needs neither the wrap nor the
	//colormap below.
	if (surf && sw > 0 && sh > 0)
	{
		texels = surf;
		tw     = sw;
		th     = sh;
	}
	else
	{
		texels = tex->texels[mip];
		tw     = tex->width >> mip;
		th     = tex->height >> mip;
	}

	if (tw <= 0 || th <= 0 || !texels)
		return;

	mins_s_i = ToI64(mins_s);
	mins_t_i = ToI64(mins_t);

	clamp_tex = tex->clamp;

	//Turbulent surfaces never mip: the warp is defined in level-0 texels, and
	//the original draws them through a dedicated span loop with no mip at all.
	turb = tex->is_turb;
	if (turb)
		mip = 0;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;

	iz  = iz1;
	soz = soz1;
	toz = toz1;

	//Exact texture coordinates at the start of the run.
	if (iz != 0.0)
	{
		z = 1.0 / iz;
		s = soz * z;
		t = toz * z;
	}
	else
	{
		s = 0.0;
		t = 0.0;
	}

	x = x1;

	//Perspective correction is exact only at the ends of each short block; in
	//between, s and t are stepped linearly. Over 16 pixels the error is well
	//under a texel, and it turns one divide per pixel into one per block.
	while (x < x2)
	{
		xe = x + QSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		//Interpolants at the far end of this block.
		iz_e  = iz + d_iz * ToF64(n);
		soz_e = soz + d_soz * ToF64(n);
		toz_e = toz + d_toz * ToF64(n);

		if (iz_e != 0.0)
		{
			z   = 1.0 / iz_e;
			s_e = soz_e * z;
			t_e = toz_e * z;
		}
		else
		{
			s_e = s;
			t_e = t;
		}

		ds = (s_e - s) / ToF64(n);
		dt = (t_e - t) / ToF64(n);

		//Light is interpolated across the block exactly like s and t: sampled
		//at both ends and stepped between, which is one bilinear fetch per
		//block rather than per pixel.
		if (lightmap && lm_w > 0 && lm_h > 0)
		{
			lightv  = QLightBilinear(lightmap, lm_w, lm_h,
						(s - mins_s) / 16.0, (t - mins_t) / 16.0);
			light_e = QLightBilinear(lightmap, lm_w, lm_h,
						(s_e - mins_s) / 16.0, (t_e - mins_t) / 16.0);
			dlight  = (light_e - lightv) / ToF64(n);
		}
		else
		{
			lightv = ToF64(flat_light);
			dlight = 0.0;
		}

		while (x < xe)
		{
			//Depth test first: a rejected pixel costs only the adds below.
			if (iz > zrow[x])
			{
			//Floor rather than ToI64: ToI64 truncates toward zero, which lands
			//on the wrong texel for negative coordinates and leaves a
			//one-texel seam wherever s or t crosses 0.
			//
			//s and t stay in level-0 texel space and are shifted down to the
			//chosen mip here, so the lightmap lookup below - which needs the
			//unshifted values - is unaffected.
			if (surf)
			{
				//Surface space: one cache texel per drawn texel at this mip.
				tx = ClampI64((ToI64(Floor(s)) - mins_s_i) >> mip, 0, tw - 1);
				ty = ClampI64((ToI64(Floor(t)) - mins_t_i) >> mip, 0, th - 1);
			}
			else if (turb)
			{
				//Cross-coupled sine warp. Each axis is displaced by a table
				//lookup indexed with the OTHER axis, which is what swirls it.
				ws = s + q_turb_table[(ToI64(Floor(t)) + q_turb_phase) &
						(QTURB_CYCLE - 1)];
				wt = t + q_turb_table[(ToI64(Floor(s)) + q_turb_phase) &
						(QTURB_CYCLE - 1)];

				tx = ToI64(Floor(ws)) >> mip;
				ty = ToI64(Floor(wt)) >> mip;
			}
			else
			{
				tx = ToI64(Floor(s)) >> mip;
				ty = ToI64(Floor(t)) >> mip;
			}

			if (surf)
			{
				//Already clamped above.
			}
			else if (clamp_tex)
			{
				//Model skin: arbitrary size, never tiles.
				tx = ClampI64(tx, 0, tw - 1);
				ty = ClampI64(ty, 0, th - 1);
			}
			else
			{
				//World texture: tiles, at whatever size it happens to be.
				tx = QTexWrap(tx, tw);
				ty = QTexWrap(ty, th);
			}

			texel = texels[ty * tw + tx];

			if (surf)
				row[x] = texel;			//lit when the surface was built
			else
			{
				light = ClampI64(ToI64(lightv), 0, 255);

				//Colormap row 0 is brightest, row 63 is darkest.
				shade = (255 - light) >> 2;
				shade = ClampI64(shade, 0, QPAL_SHADES - 1);

				if (texel >= QPAL_FULLBRIGHT)
					row[x] = texel;		//fullbrights ignore lighting
				else
					row[x] = qpal_colormap[shade * QPAL_COLORS + texel];
			}

			zrow[x] = iz;
			}

			s      += ds;
			t      += dt;
			lightv += dlight;
			iz     += d_iz;
			x++;
		}

		//Resync to the exact values rather than carrying stepping error into
		//the next block.
		iz  = iz_e;
		soz = soz_e;
		toz = toz_e;
		s   = s_e;
		t   = t_e;
	}

	c->spans_drawn++;
}

U0 QDrawPolygon(CQCanvas *c, CQScreenVert *v, I64 count,
	CQTexture *tex, U8 *lightmap, I64 lm_w, I64 lm_h,
	F64 mins_s, F64 mins_t, I64 flat_light, I64 mip,
	U8 *surf = NULL, I64 sw = 0, I64 sh = 0)
{//Scanline fill of a convex polygon. For each row every edge is intersected
 //and the extreme hits become the span. O(edges) per row, but after clipping
 //there are rarely more than eight edges, and it sidesteps the bookkeeping
 //(and the winding-order bugs) of an active edge table.
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 sozl;
	F64	 sozr;
	F64	 tozl;
	F64	 tozr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 sozi;
	F64	 tozi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;
		sozl  = 0.0;
		sozr  = 0.0;
		tozl  = 0.0;
		tozr  = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			//Half-open test so a shared vertex is not counted twice.
			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);
				sozi = v[i].s_over_z + frac * (v[j].s_over_z - v[i].s_over_z);
				tozi = v[i].t_over_z + frac * (v[j].t_over_z - v[i].t_over_z);

				if (!found)
				{
					xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi; sozl = sozi; tozl = tozi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi; sozr = sozi; tozr = tozi;
					}
				}
			}
		}

		if (found && xr > xl)
		{
			QDrawSpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)),
				izl, sozl, tozl, izr, sozr, tozr,
				tex, lightmap, lm_w, lm_h, mins_s, mins_t, flat_light, mip,
				surf, sw, sh);
		}
	}
}

//--- sky -------------------------------------------------------------------
//
// A sky texture is 256x128 carrying two stacked 128x128 layers: the RIGHT half
// is the solid starfield, the LEFT half is the cloud layer where palette index
// 0 means "see through to the layer behind". Drawing it as one ordinary tiling
// texture shows both halves side by side, which is not sky.
//
// Sky is also not textured by surface position. It is textured by the
// direction from the eye through each pixel, so it behaves as if infinitely
// far away and does not slide as the player walks. The direction is flattened
// vertically and rescaled onto a fixed-radius dome, then the two layers are
// sampled at different scroll speeds to give the parallax drift.

#define QSKY_LAYER		128		//each layer is 128x128
#define QSKY_MASK		127
#define QSKY_DOME		378.0	//dome radius the direction is rescaled onto
#define QSKY_FLATTEN	3.0		//vertical squash, so the sky reads as a ceiling
#define QSKY_SPEED_BG	8.0		//starfield drift, units/sec
#define QSKY_SPEED_FG	16.0	//clouds drift twice as fast, giving parallax

F64 q_sky_time = 0.0;

//Underwater view distortion, set by the app from the player's water level.
//Amount is in source pixels of sideways shear; zero disables the whole path.
F64 q_warp_amount = 0.0;
F64 q_warp_time   = 0.0;

U0 QDrawSkySpan(CQCanvas *c, I64 y, I64 x1, I64 x2, F64 iz1, F64 iz2,
	CQTexture *tex)
{//Per pixel: build the view ray, warp it onto the dome, sample both layers.
 //The ray varies linearly across the span, so it is stepped rather than
 //rebuilt; only the rescale needs a square root.
	U8	*row;
	U8	*texels;
	F64	*zrow;
	F64	 dir[3];
	F64	 step[3];
	F64	 sxf;
	F64	 syf;
	F64	 vx;
	F64	 vy;
	F64	 vz;
	F64	 len;
	F64	 scale;
	F64	 dx;
	F64	 dy;
	F64	 span;
	F64	 d_iz;
	F64	 iz;
	F64	 bg;
	F64	 fg;
	I64	 x;
	I64	 tw;
	I64	 s1;
	I64	 t1;
	I64	 s2;
	I64	 t2;
	I64	 texel;
	I64	 cloud;
	I64	 i;
	I64	 xe;
	I64	 n;
	F64	 dx_e;
	F64	 dy_e;
	F64	 ddx;
	F64	 ddy;

	//Clipped to the VIEW RECT, not the canvas: anything outside it belongs to
	//the border or the status bar.
	if (y < c->vy || y >= c->vy + c->vh)
		return;

	span = ToF64(x2 - x1);
	if (span <= 0.0)
		return;

	d_iz = (iz2 - iz1) / span;

	if (x1 < 0)
	{
		iz1 += d_iz * ToF64(-x1);
		x1 = c->vx;
	}
	if (x2 > c->vx + c->vw)
		x2 = c->vx + c->vw;
	if (x1 >= x2)
		return;

	tw     = tex->width;
	texels = tex->texels[0];
	if (!texels || tw < 2 * QSKY_LAYER || tex->height < QSKY_LAYER)
		return;

	//Ray through the first pixel, and the per-pixel increment along it.
	sxf = (ToF64(x1) - c->center_x) / c->x_scale;
	syf = (c->center_y - ToF64(y)) / c->y_scale;

	for (i = 0; i < 3; i++)
	{
		dir[i]  = c->forward[i] + c->right[i] * sxf + c->up[i] * syf;
		step[i] = c->right[i] / c->x_scale;
	}

	bg = q_sky_time * QSKY_SPEED_BG;
	fg = q_sky_time * QSKY_SPEED_FG;

	row  = c->pixels + y * c->width;
	zrow = c->depth + y * c->width;
	iz   = iz1;

	//The dome warp costs a square root and a divide, so it is evaluated only
	//at block boundaries and interpolated between, exactly like the textured
	//span path. The sky is smooth and distant, so the error is invisible.
	vx  = dir[0];
	vy  = dir[1];
	vz  = dir[2] * QSKY_FLATTEN;
	len = Sqrt(vx * vx + vy * vy + vz * vz);
	if (len > 0.0)
	{
		scale = QSKY_DOME / len;
		dx    = vx * scale;
		dy    = vy * scale;
	}
	else
	{
		dx = 0.0;
		dy = 0.0;
	}

	x = x1;

	while (x < x2)
	{
		xe = x + QSPAN_SUB;
		if (xe > x2)
			xe = x2;
		n = xe - x;

		//Ray at the far end of this block, warped exactly.
		vx  = dir[0] + step[0] * ToF64(n);
		vy  = dir[1] + step[1] * ToF64(n);
		vz  = (dir[2] + step[2] * ToF64(n)) * QSKY_FLATTEN;
		len = Sqrt(vx * vx + vy * vy + vz * vz);

		if (len > 0.0)
		{
			scale = QSKY_DOME / len;
			dx_e  = vx * scale;
			dy_e  = vy * scale;
		}
		else
		{
			dx_e = dx;
			dy_e = dy;
		}

		ddx = (dx_e - dx) / ToF64(n);
		ddy = (dy_e - dy) / ToF64(n);

		while (x < xe)
		{
			if (iz > zrow[x])
			{
				//Clouds sit in front; index 0 there lets the starfield show.
				s2    = ToI64(Floor(fg + dx)) & QSKY_MASK;
				t2    = ToI64(Floor(fg + dy)) & QSKY_MASK;
				cloud = texels[t2 * tw + s2];

				if (cloud)
					texel = cloud;
				else
				{
					s1    = ToI64(Floor(bg + dx)) & QSKY_MASK;
					t1    = ToI64(Floor(bg + dy)) & QSKY_MASK;
					texel = texels[t1 * tw + s1 + QSKY_LAYER];
				}

				//Sky is emissive: never shaded by the colormap.
				row[x]  = texel;
				zrow[x] = iz;
			}

			dx += ddx;
			dy += ddy;
			iz += d_iz;
			x++;
		}

		dir[0] += step[0] * ToF64(n);
		dir[1] += step[1] * ToF64(n);
		dir[2] += step[2] * ToF64(n);
		dx      = dx_e;
		dy      = dy_e;
	}

	c->spans_drawn++;
}

U0 QDrawSkyPolygon(CQCanvas *c, CQScreenVert *v, I64 count, CQTexture *tex)
{//Same edge walk as the textured path, but only depth is interpolated: the
 //texture comes from the view ray instead of from surface coordinates.
	F64	 y_min = 1.0e30;
	F64	 y_max = -1.0e30;
	F64	 xl;
	F64	 xr;
	F64	 izl;
	F64	 izr;
	F64	 ya;
	F64	 yb;
	F64	 frac;
	F64	 xi;
	F64	 izi;
	F64	 yc;
	I64	 i;
	I64	 j;
	I64	 y;
	I64	 y0;
	I64	 y1;
	Bool found;

	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		if (v[i].y < y_min)
			y_min = v[i].y;
		if (v[i].y > y_max)
			y_max = v[i].y;
	}

	y0 = ToI64(Ceil(y_min));
	y1 = ToI64(Floor(y_max));

	if (y0 < c->vy)
		y0 = c->vy;
	if (y1 >= c->vy + c->vh)
		y1 = c->vy + c->vh - 1;

	for (y = y0; y <= y1; y++)
	{
		yc    = ToF64(y);
		found = FALSE;
		xl    = 0.0;
		xr    = 0.0;
		izl   = 0.0;
		izr   = 0.0;

		for (i = 0; i < count; i++)
		{
			j  = (i + 1) % count;
			ya = v[i].y;
			yb = v[j].y;

			if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc))
			{
				frac = (yc - ya) / (yb - ya);
				xi   = v[i].x + frac * (v[j].x - v[i].x);
				izi  = v[i].inv_z + frac * (v[j].inv_z - v[i].inv_z);

				if (!found)
				{
					xl = xi; izl = izi;
					xr = xi; izr = izi;
					found = TRUE;
				}
				else
				{
					if (xi < xl)
					{
						xl = xi; izl = izi;
					}
					if (xi > xr)
					{
						xr = xi; izr = izi;
					}
				}
			}
		}

		if (found && xr > xl)
			QDrawSkySpan(c, y, ToI64(Ceil(xl)), ToI64(Ceil(xr)), izl, izr, tex);
	}
}

U0 QDrawFace(CQCanvas *c, CQMap *map, I64 face_index, F64 *offset = NULL,
	I64 ent_frame = 0)
{//Transform, clip, project and fill one BSP face.
 //
 //`offset` translates the face in world space, which is what lets a BRUSH MODEL
 //follow its entity. A submodel's vertices are authored at the position the
 //level designer put the brush, and a door that opens is an entity whose .origin
 //moves away from that authored spot - so drawing the raw vertices renders every
 //door, plate and platform permanently shut no matter what the game logic and
 //the collision hulls are doing. NULL means the world itself, which never moves.
 //
 //The texture coordinates are computed from the UNSHIFTED position: the texture
 //is fixed to the brush, so a moving door slides its geometry without dragging
 //its texture along the surface.
	CQFace		*f  = &map->faces[face_index];
	CQTexInfo	*ti;
	CQTexture	*tex;
	CQPolyVert	 poly[QMAX_POLY_VERTS];
	CQPolyVert	 clipped[QMAX_POLY_VERTS];
	CQScreenVert scr[QMAX_POLY_VERTS];
	CQVertex	*wv;
	U8			*lightmap = NULL;
	U8			*surf = NULL;
	I64			 sw = 0;
	I64			 sh = 0;
	F64			 rel[3];
	F64			 inv_z;
	I64			 n = 0;
	I64			 count;
	I64			 lm_w = 0;
	I64			 lm_h = 0;
	I64			 i;
	I64			 e;
	I64			 anim_tex;
	I64			 mip;
	F64			 near_z;
	F64			 ratio;
	F64		   shifted[3];

	if (f->num_edges < 3 || f->num_edges > QMAX_POLY_VERTS)
		return;

	ti = &map->texinfo[f->tex_info];
	if (ti->miptex < 0 || ti->miptex >= map->num_textures)
		return;

	//R_TextureAnimation: the miptex names the FIRST frame of a sequence, not
	//the one to draw. ent_frame picks the alternate chain, which is how a
	//button reads as lit while it is held.
	anim_tex = QTextureAnimation(map, ti->miptex, ent_frame, q_light_time);
	if (anim_tex < 0)
		return;

	tex = &map->textures[anim_tex];
	if (!tex->texels[0] || tex->width <= 0 || tex->height <= 0)
		return;

	//Gather the face outline. A negative surfedge means the edge runs the
	//other way, so its second vertex is the leading one.
	for (i = 0; i < f->num_edges; i++)
	{
		e = map->surfedges[f->first_edge + i];
		if (e >= 0)
			wv = &map->vertices[map->edges[e].v[0]];
		else
			wv = &map->vertices[map->edges[-e].v[1]];

		//Texture coords come from the world position, before the view moves.
		poly[n].s = QVecDot(wv->pt, &ti->vecs[0]) + ti->vecs[3];
		poly[n].t = QVecDot(wv->pt, &ti->vecs[4]) + ti->vecs[7];

		if (offset)
		{
			QVecAdd(wv->pt, offset, shifted);
			QVecSub(shifted, c->origin, rel);
		}
		else
			QVecSub(wv->pt, c->origin, rel);
		poly[n].cam[0] = QVecDot(rel, c->right);
		poly[n].cam[1] = QVecDot(rel, c->up);
		poly[n].cam[2] = QVecDot(rel, c->forward);
		n++;
	}

	count = QDrawClipNear(poly, n, clipped);
	if (count < 3)
		return;

	for (i = 0; i < count; i++)
	{
		inv_z = 1.0 / clipped[i].cam[2];

		//Screen y grows downward, camera y grows up.
		scr[i].x = c->center_x + clipped[i].cam[0] * c->x_scale * inv_z;
		scr[i].y = c->center_y - clipped[i].cam[1] * c->y_scale * inv_z;

		//Interpolating s/z and t/z (not s and t) is what makes the texture
		//track the surface instead of swimming across it.
		scr[i].inv_z    = inv_z;
		scr[i].s_over_z = clipped[i].s * inv_z;
		scr[i].t_over_z = clipped[i].t * inv_z;
	}

	if (f->light_offset >= 0 && f->light_offset < map->lightdata_size)
	{
		lm_w = f->extent_s / 16 + 1;
		lm_h = f->extent_t / 16 + 1;
		if (f->light_offset + lm_w * lm_h <= map->lightdata_size)
			lightmap = QLightFaceMap(map, f, lm_w, lm_h, q_light_time);
		else
		{
			lm_w = 0;
			lm_h = 0;
		}
	}

	if (tex->is_sky)
		QDrawSkyPolygon(c, scr, count, tex);
	else
	{
		//Pick a mip from how far the nearest part of the surface is, measured
		//relative to the projection scale so the choice holds at any
		//resolution: a wall that fills the screen at 320 wide must not drop to
		//a blurrier level just because the render target grew.
		near_z = 1.0e30;
		for (i = 0; i < count; i++)
		{
			if (clipped[i].cam[2] < near_z)
				near_z = clipped[i].cam[2];
		}

		ratio = near_z / c->x_scale;

		if (ratio < 0.5)
			mip = 0;
		else if (ratio < 1.5)
			mip = 1;
		else if (ratio < 4.0)
			mip = 2;
		else
			mip = 3;

		//D_CacheSurface. A turbulent surface warps its coordinates every frame
		//and a sky is drawn by direction, so neither can be cached; everything
		//else is built once and reused until its mip or lighting changes.
		if (!tex->is_turb && !tex->clamp)
			surf = QSurfCacheGet(map, f, face_index, tex, mip,
					lightmap, lm_w, lm_h, &sw, &sh, anim_tex);

		//Unlit faces (anything the compiler left without a lightmap) render
		//fullbright, matching how they look in the original.
		QDrawPolygon(c, scr, count, tex, lightmap, lm_w, lm_h,
			f->mins_s, f->mins_t, 255, mip, surf, sw, sh);
	}

	c->faces_drawn++;
}

U0 QDrawWorld(CQCanvas *c, CQMap *map, CQVisState *vs)
{//Faces arrive front-to-back, so the depth test rejects most overdraw.
	I64 i;

	for (i = 0; i < vs->face_count; i++)
		QDrawFace(c, map, vs->face_list[i]);
}

U0 QDrawBrushModel(CQCanvas *c, CQMap *map, I64 model_index,
	F64 *origin = NULL, I64 ent_frame = 0)
{//Draw a BSP submodel (door, platform, button) by walking its face range.
 //These are not in the PVS, so every face is submitted and the depth buffer
 //sorts it out.
 //
 //`origin` is the owning entity's position. It MUST be passed for anything that
 //moves: without it the geometry stays at the spot the brush was authored at, so
 //a door opens as far as the game logic and the collision hulls are concerned
 //while remaining visibly shut.
	CQModel *m;
	I64		 i;

	if (model_index < 0 || model_index >= map->num_models)
		return;

	m = &map->models[model_index];

	for (i = 0; i < m->num_faces; i++)
	{
		if (m->first_face + i < map->num_faces)
			QDrawFace(c, map, m->first_face + i, origin, ent_frame);
	}
}

U0 QDrawFadeScreen(CQCanvas *c)
{//Dim the finished frame so a menu can be read over it. Draw_FadeScreen.
 //
 //This is how the original shows its menu DURING a game: the world stays on
 //screen, darkened, rather than being replaced by the console artwork. M_Draw
 //only falls back to conback when the console is actually down.
 //
 //The dim is a dither, not a blend, because 8bpp palette indices cannot be
 //averaged: one pixel in four survives and the rest go to black, and the
 //surviving column shifts on alternate rows so the pattern reads as a screen
 //door rather than as stripes.
	U8	*row;
	I64	 x;
	I64	 y;
	I64	 t;
	I64	 step;

	//THE PATTERN IS DEFINED IN 320x200 PIXELS.
	//
	//Draw_FadeScreen works on screen pixels, and the original's screen is 320
	//wide. Applying the same one-in-four mask to a 640 or 1024 wide canvas makes
	//the holes half or a third the size they should be, and a dither that fine
	//stops reading as a screen door - it turns into a flat dark wash with a
	//faint moire over it. Scaling the cell keeps the effect the same APPARENT
	//size at any render resolution.
	step = c->width / 320;
	if (step < 1)
		step = 1;

	for (y = 0; y < c->height; y++)
	{
		row = c->pixels + y * c->width;

		//(y & 1) << 1 alternates the kept column between 0 and 2.
		t = ((y / step) & 1) << 1;

		for (x = 0; x < c->width; x++)
		{
			if (((x / step) & 3) != t)
				row[x] = 0;
		}
	}
}

U0 QDrawBlitFit(CQCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 dst_w,
	I64 dst_h)
{//Stretch the indexed canvas into an arbitrary destination rectangle.
 //
 //Integer-only scaling made higher resolutions display SMALLER: 320x240 fits a
 //1280x720 window three times over, but 640x480 only fits once, so raising the
 //render resolution shrank the picture. Stepping the source with a fixed-point
 //accumulator lets any render size fill the same rectangle.
	U8	*src;
	U32	*dst;
	I64	 sx_step;
	I64	 sy_step;
	I64	 sxf;
	I64	 sy;
	I64	 x;
	I64	 y;
	I64	 py;
	I64	 warp;
	I64	 sx;
	I64	 pitch = dc->width_internal;

	if (dst_w < 1 || dst_h < 1)
		return;

	//16.16 fixed point. Parenthesised because shifts bind tighter than divide
	//in this compiler, which otherwise reorders these silently.
	sx_step = (c->width << 16) / dst_w;
	sy_step = (c->height << 16) / dst_h;

	for (y = 0; y < dst_h; y++)
	{
		py = dst_y + y;
		if (py < 0 || py >= dc->height)
			goto qbf_next_row;

		sy = (y * sy_step) >> 16;
		if (sy >= c->height)
			sy = c->height - 1;

		src = c->pixels + sy * c->width;
		dst = dc->body + py * pitch;

		//Underwater warp: shear each row sideways along a travelling sine.
		//Done here rather than in the renderer because it is a view-space
		//effect on the finished image, which is also how the original applies
		//it - and doing it at blit time costs one sine per row.
		if (q_warp_amount > 0.0)
		{
			warp = ToI64(Sin(ToF64(sy) * 0.06 + q_warp_time * 3.0) *
				q_warp_amount);
			sxf = warp << 16;
		}
		else
			sxf = 0;

		for (x = 0; x < dst_w; x++)
		{
			//The warp can push the source off either edge, so clamp rather
			//than wrap - wrapping would tear the image across the screen.
			sx = sxf >> 16;
			if (sx < 0)
				sx = 0;
			if (sx >= c->width)
				sx = c->width - 1;

			if (dst_x + x >= 0 && dst_x + x < dc->width)
				dst[dst_x + x] = qpal_argb[src[sx]];

			sxf += sx_step;
		}

qbf_next_row:
	}
}

U0 QDrawBlit(CQCanvas *c, CDC *dc, I64 dst_x, I64 dst_y, I64 scale)
{//Expand the indexed buffer into the truecolor CDC, magnifying by an integer
 //factor. Palette lookup happens exactly once per source pixel.
	U8	*src;
	U32	*dst;
	U32	 color;
	I64	 x;
	I64	 y;
	I64	 sx;
	I64	 sy;
	I64	 px;
	I64	 py;
	I64	 pitch = dc->width_internal;

	for (y = 0; y < c->height; y++)
	{
		src = c->pixels + y * c->width;
		for (sy = 0; sy < scale; sy++)
		{
			py = dst_y + y * scale + sy;
			if (py < 0 || py >= dc->height)
				break;

			dst = dc->body + py * pitch;

			for (x = 0; x < c->width; x++)
			{
				color = qpal_argb[src[x]];
				px    = dst_x + x * scale;

				for (sx = 0; sx < scale; sx++)
				{
					if (px + sx >= 0 && px + sx < dc->width)
						dst[px + sx] = color;
				}
			}
		}
	}
}
