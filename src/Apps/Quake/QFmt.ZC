// QFmt.ZC - little-endian byte readers for on-disk Quake structures.
//
// These exist because ZealC arithmetic is F64-only and its postfix casts are
// no-ops, so a class must NEVER be overlaid on raw file bytes the way the
// original C engine does. Every on-disk field gets pulled out explicitly and
// 32-bit floats get widened to F64 by bit surgery (exact, no FP math).

U16 QRdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

I64 QRdI16(U8 *p)
{//Sign-extended 16-bit. BSP edge/vertex indices are unsigned, but several
 //lumps (texinfo, clipnodes) store signed shorts.
	I64 v = p[0] | (p[1] << 8);

	if (v & 0x8000)
		v -= 0x10000;

	return v;
}

U32 QRdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 QRdI32(U8 *p)
{//Sign-extended 32-bit.
	I64 v = QRdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;

	return v;
}

F64 QRdF32(U8 *p)
{//IEEE-754 binary32 -> F64. Done by rebuilding the double's bit pattern
 //instead of doing arithmetic: the widening is exact and needs no pow().
	U32 b   = QRdU32(p);
	I64 sgn = b >> 31;
	I64 exp = (b >> 23) & 0xFF;
	I64 man = b & 0x7FFFFF;
	I64 d;
	F64 r;

	if (!exp)
		d = sgn << 63;			//zero, or a denormal, which rounds to zero
	else if (exp == 255)
		d = sgn << 63;			//inf/NaN never appear in valid map data
	else
		d = (sgn << 63) | ((exp + 896) << 52) | (man << 29);	//896 = 1023-127

	MemCopy(&r, &d, 8);

	return r;
}

U32 QWrF32(F64 v)
{//F64 -> IEEE-754 binary32 bits. The inverse of QRdF32, needed because the
 //QuakeC global pool is 32-bit cells that must be written back in place.
 //Rounds to nearest; underflow becomes zero and overflow becomes infinity.
	I64 bits;
	I64 sgn;
	I64 exp;
	I64 man;

	MemCopy(&bits, &v, 8);

	sgn = (bits >> 63) & 1;
	exp = (bits >> 52) & 0x7FF;
	man = bits & 0xFFFFFFFFFFFFF;

	if (!exp)
		return sgn << 31;			//zero or a denormal, flushed to zero

	if (exp == 0x7FF)
		return (sgn << 31) | 0x7F800000;	//inf/NaN -> inf

	exp -= 896;						//rebias 1023 -> 127

	if (exp <= 0)
		return sgn << 31;			//underflows binary32

	if (exp >= 255)
		return (sgn << 31) | 0x7F800000;

	//Round to nearest on the bit below the 23-bit mantissa.
	man += 0x10000000;
	if (man > 0xFFFFFFFFFFFFF)
	{
		//Rounding carried into the exponent.
		man = 0;
		exp++;
		if (exp >= 255)
			return (sgn << 31) | 0x7F800000;
	}

	return (sgn << 31) | (exp << 23) | (man >> 29);
}

U0 QRdVec(U8 *p, F64 *out)
{//Three consecutive binary32s -> F64[3].
	out[0] = QRdF32(p);
	out[1] = QRdF32(p + 4);
	out[2] = QRdF32(p + 8);
}

U0 QStrCopy(U8 *dst, U8 *src, I64 max)
{//Bounded copy. The kernel has no StrNCopy, and map values can be far longer
 //than the fixed fields they are read into.
	I64 i = 0;

	if (max <= 0)
		return;

	while (i < max - 1 && src[i])
	{
		dst[i] = src[i];
		i++;
	}

	dst[i] = 0;
}

//--- diagnostics -----------------------------------------------------------
// Quake calls DocClear when its window opens, which wipes anything printed
// during startup, and a crash takes the console with it. So progress is also
// accumulated here and flushed to a file that survives both.

#define QLOG_MAX	8192

//Console echo, off by default. The log FILE is the record that matters; the
//echo exists only for the rare case where the console is readable at the time.
Bool q_log_echo = FALSE;

U8	 q_log_buf[QLOG_MAX];
I64	 q_log_len = 0;

U0 QLogReset()
{
	q_log_len     = 0;
	q_log_buf[0]  = 0;
}

U0 QLog(U8 *s)
{//Append one preformatted line. Callers build the text with StrPrint first.
	I64 n = StrLen(s);

	if (q_log_len + n + 1 >= QLOG_MAX)
		return;

	MemCopy(q_log_buf + q_log_len, s, n);
	q_log_len += n;
	q_log_buf[q_log_len] = 0;

	//NOT echoed to the console.
	//
	//Lines also went to the terminal's DolDoc document. With a map
	//loaded that is hundreds of entries, and it is the only thing here that
	//scales with "a map was loaded" while touching state the OS owns rather than
	//state this app owns - which is exactly the correlation behind crashing on
	//quit only after playing.
	//
	//Two known hazards live on that path. A runtime string containing a raw
	//dollar sign (0x24) is taken as a DolDoc command and can swallow document
	//structure; and the document is being appended to from a task whose heap is
	//about to be torn down. The log file is the authoritative record anyway - it
	//survives the window closing, which the console does not.
	//
	//NOTE: the character named above must never appear literally in this source,
	//not even inside a comment. The compiler's own lexer reads dollar pairs at
	//DolDoc level before tokenising, so one stray occurrence swallows everything
	//up to the next one - across file boundaries - and surfaces as a syntax
	//error in a completely unrelated file further down the include chain.
	if (q_log_echo)
		"%s", s;
}

//Disk writes can be switched off at runtime with the `diskwrite 0` console
//command. Quitting has crashed inside the shell, but ONLY after a map has been
//loaded, and the log written on the way out is the one thing on that path that
//both touches the disk and grows with "a map was loaded". Turning it off is a
//clean bisect: if quitting stops crashing with writes disabled, the fault is on
//the FileWrite path; if it still crashes, that whole theory is dead and the
//remaining suspects are the teardown Frees.
Bool q_disk_writes = TRUE;

U0 QLogFlush()
{//Written eagerly so a later crash still leaves the evidence on disk.
	if (!q_disk_writes)
		return;

	if (q_log_len > 0)
		FileWrite("::/Apps/Quake/QUAKELOG.TXT", q_log_buf, q_log_len);
}

F64 QAtoF(U8 *s)
{//Small self-contained decimal parser, used for map entity values and for the
 //"*N" brush-model references in QuakeC. Keeping it local avoids depending on
 //kernel string-to-float behaviour.
	F64  sign  = 1.0;
	F64  value = 0.0;
	F64  scale = 0.1;
	I64  i     = 0;

	while (s[i] == ' ' || s[i] == '\t')
		i++;

	if (s[i] == '-')
	{
		sign = -1.0;
		i++;
	}
	else if (s[i] == '+')
		i++;

	while ('0' <= s[i] <= '9')
	{
		value = value * 10.0 + ToF64(s[i] - '0');
		i++;
	}

	if (s[i] == '.')
	{
		i++;
		while ('0' <= s[i] <= '9')
		{
			value += ToF64(s[i] - '0') * scale;
			scale *= 0.1;
			i++;
		}
	}

	return sign * value;
}

U0 QParseVec(U8 *s, F64 *out)
{//"480 -352 88" -> three F64s.
	U8  tok[64];
	I64 i = 0;
	I64 n = 0;
	I64 k;

	out[0] = 0.0;
	out[1] = 0.0;
	out[2] = 0.0;

	while (s[i] && n < 3)
	{
		while (s[i] == ' ' || s[i] == '\t')
			i++;

		k = 0;
		while (s[i] && s[i] != ' ' && s[i] != '\t' && k < 63)
		{
			tok[k] = s[i];
			k++;
			i++;
		}
		tok[k] = 0;

		if (k > 0)
		{
			out[n] = QAtoF(tok);
			n++;
		}
	}
}

U0 QRdName(U8 *p, U8 *out, I64 max)
{//Copy a fixed-width, NUL-padded on-disk name into a NUL-terminated buffer.
	I64 i = 0;

	while (i < max - 1 && p[i])
	{
		out[i] = p[i];
		i++;
	}

	out[i] = 0;
}
