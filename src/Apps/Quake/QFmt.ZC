// QFmt.ZC - little-endian byte readers for on-disk Quake structures.
//
// These exist because ZealC arithmetic is F64-only and its postfix casts are
// no-ops, so we can NEVER overlay a class on raw file bytes the way the
// original C engine does. Every on-disk field gets pulled out explicitly and
// 32-bit floats get widened to F64 by bit surgery (exact, no FP math).

U16 QRdU16(U8 *p)
{
	return p[0] | (p[1] << 8);
}

I64 QRdI16(U8 *p)
{//Sign-extended 16-bit. BSP edge/vertex indices are unsigned, but several
 //lumps (texinfo, clipnodes) store signed shorts.
	I64 v = p[0] | (p[1] << 8);

	if (v & 0x8000)
		v -= 0x10000;

	return v;
}

U32 QRdU32(U8 *p)
{
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 QRdI32(U8 *p)
{//Sign-extended 32-bit.
	I64 v = QRdU32(p);

	if (v & 0x80000000)
		v -= 0x100000000;

	return v;
}

F64 QRdF32(U8 *p)
{//IEEE-754 binary32 -> F64. Done by rebuilding the double's bit pattern
 //instead of doing arithmetic: the widening is exact and needs no pow().
	U32 b   = QRdU32(p);
	I64 sgn = b >> 31;
	I64 exp = (b >> 23) & 0xFF;
	I64 man = b & 0x7FFFFF;
	I64 d;
	F64 r;

	if (!exp)
		d = sgn << 63;			//zero, or a denormal we round to zero
	else if (exp == 255)
		d = sgn << 63;			//inf/NaN never appear in valid map data
	else
		d = (sgn << 63) | ((exp + 896) << 52) | (man << 29);	//896 = 1023-127

	MemCopy(&r, &d, 8);

	return r;
}

U0 QRdVec(U8 *p, F64 *out)
{//Three consecutive binary32s -> F64[3].
	out[0] = QRdF32(p);
	out[1] = QRdF32(p + 4);
	out[2] = QRdF32(p + 8);
}

U0 QRdName(U8 *p, U8 *out, I64 max)
{//Copy a fixed-width, NUL-padded on-disk name into a NUL-terminated buffer.
	I64 i = 0;

	while (i < max - 1 && p[i])
	{
		out[i] = p[i];
		i++;
	}

	out[i] = 0;
}
