// QGame.ZC - drives the QuakeC VM: spawning, per-frame thinking, drawing.
//
// The map's entity text is the input to the game, not just scenery data. Each
// block becomes an entity whose fields are filled from the key/value pairs,
// after which the QuakeC spawn function named by its classname runs. That is
// what turns "monster_army" from a string into a soldier with a model, a
// bounding box and a think schedule.
//
// Once spawned, entities are advanced by running any think function whose
// nextthink has come due. That single mechanism is what animates monsters,
// opens doors and bobs items.

#define QGAME_MAX_EDICTS	600
#define QGAME_FRAME_TIME	0.1		//QuakeC assumes 10Hz thinking
#define QGAME_LIGHT			170		//flat shade until models sample lightmaps

//QuakeC value types, as emitted in the def tables.
#define QTYPE_VOID		0
#define QTYPE_STRING	1
#define QTYPE_FLOAT		2
#define QTYPE_VECTOR	3
#define QTYPE_ENTITY	4
#define QTYPE_FIELD		5
#define QTYPE_FUNCTION	6
#define QTYPE_POINTER	7

Bool q_game_active	= FALSE;
F64	 q_game_time	= 0.0;
I64	 q_game_spawned	= 0;
I64	 q_game_thinks	= 0;

//Inventory carried between levels. QuakeC stores it in parm1..parm16 via
//SetChangeParms; reloading the bytecode resets the global pool, so the values
//have to be held on the engine side across the transition.
#define QGAME_MAX_PARMS	16
F64	 q_saved_parms[QGAME_MAX_PARMS];
F64	 q_saved_serverflags	= 0.0;
Bool q_have_saved_parms		= FALSE;

I64 QGameFindFieldDef(U8 *name, I64 *_type)
{//Field defs carry the type, which decides how a map value is converted.
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
		{
			if (_type)
				*_type = q_pr_fielddefs[i].type & 0x7FFF;	//high bit is a flag
			return q_pr_fielddefs[i].ofs;
		}
	}

	if (_type)
		*_type = QTYPE_VOID;

	return -1;
}

Bool QGameSetField(I64 ent, U8 *key, U8 *value)
{//Convert one map key/value onto an entity field.
	I64 ftype;
	I64 ofs;
	F64 v[3];
	I64 fn;

	ofs = QGameFindFieldDef(key, &ftype);
	if (ofs < 0)
		return FALSE;

	switch (ftype)
	{
		case QTYPE_FLOAT:
			QPrSetFieldF(ent, ofs, QAtoF(value));
			break;

		case QTYPE_VECTOR:
			QParseVec(value, v);
			QPrSetFieldF(ent, ofs, v[0]);
			QPrSetFieldF(ent, ofs + 1, v[1]);
			QPrSetFieldF(ent, ofs + 2, v[2]);
			break;

		case QTYPE_STRING:
			//Map strings are not in the compiled blob, so they are copied into
			//the runtime string heap first.
			QPrSetFieldI(ent, ofs, QPrNewString(value));
			break;

		case QTYPE_ENTITY:
			QPrSetFieldI(ent, ofs, QPrEdictValue(ToI64(QAtoF(value))));
			break;

		case QTYPE_FUNCTION:
			fn = QPrFindFunction(value);
			if (fn < 0)
				fn = 0;
			QPrSetFieldI(ent, ofs, fn);
			break;

		default:
			return FALSE;
	}

	return TRUE;
}

I64 QGameSpawnEntities(CQMap *map)
{//Walk the entity text, build each entity, then run its spawn function.
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[160];
	U8	 classname[64];
	I64	 ent;
	I64	 k;
	I64	 fn;
	I64	 spawned = 0;
	Bool first    = TRUE;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end)
	{
		if (*p == '{')
		{
			//The first block is worldspawn, which owns entity 0.
			if (first)
			{
				ent   = 0;
				first = FALSE;
			}
			else
				ent = QPrSpawnEdict;

			classname[0] = 0;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 63)
				{
					key[k] = *p;
					k++;
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 159)
				{
					val[k] = *p;
					k++;
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					QStrCopy(classname, val, 64);

				QGameSetField(ent, key, val);
			}

			if (classname[0])
			{
				//The spawn function shares the classname. Anything without one
				//(lights, path corners) is data only and is simply left alone.
				fn = QPrFindFunction(classname);
				if (fn > 0)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(ent));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(fn);
					spawned++;

					if (q_pr_error)
					{
						"QGame: error spawning %s\n", classname;
						q_pr_error = FALSE;
					}
				}
			}
		}

		if (p < end)
			p++;
	}

	return spawned;
}

//--- entity physics --------------------------------------------------------
//
// Think functions decide what an entity WANTS to do; physics is what actually
// moves it. Without this pass a rocket gets a velocity, animates, and expires
// on schedule while hanging motionless in the air - and doors never travel.
//
// Each entity's .movetype selects the rule, exactly as the original server
// does. The important distinction is between things that simply translate
// (NOCLIP, PUSH), things that fall (TOSS, BOUNCE, STEP), and things that must
// report a collision to QuakeC so it can explode them (FLYMISSILE).

#define QMOVETYPE_NONE			0
#define QMOVETYPE_ANGLENOCLIP	1
#define QMOVETYPE_ANGLECLIP		2
#define QMOVETYPE_WALK			3
#define QMOVETYPE_STEP			4
#define QMOVETYPE_FLY			5
#define QMOVETYPE_TOSS			6
#define QMOVETYPE_PUSH			7
#define QMOVETYPE_NOCLIP		8
#define QMOVETYPE_FLYMISSILE	9
#define QMOVETYPE_BOUNCE		10

#define QSOLID_NOT_			0
#define QSOLID_TRIGGER_		1
#define QSOLID_BBOX_		2
#define QSOLID_SLIDEBOX_	3
#define QSOLID_BSP_			4

#define QPHYS_SV_GRAVITY	800.0
#define QFL_ONGROUND_		512

U0 QGameCallTouch(I64 self_ent, I64 other_ent)
{//Run an entity's touch function with the pair the original would pass.
	I64 fn = QPrFieldI(self_ent, q_fld_touch);

	if (fn <= 0 || fn >= q_pr_num_functions)
		return;

	QPrSetI(q_ofs_self, QPrEdictValue(self_ent));
	QPrSetI(q_ofs_other, QPrEdictValue(other_ent));
	QPrExecute(fn);
	q_pr_error = FALSE;
}

I64 QGameEntityAt(I64 mover, F64 *point)
{//Which solid entity, if any, contains this point. Only the world is traced
 //geometrically, so this is what lets a rocket hit a monster at all.
	F64 eorg[3];
	F64 emins[3];
	F64 emaxs[3];
	I64 i;
	I64 j;
	I64 solid;
	I64 owner;
	Bool inside;

	owner = QPrEdictNum(QPrFieldI(mover, q_fld_owner));

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == mover)
			goto qe_next;

		//A rocket must not detonate on the player who fired it.
		if (i == owner)
			goto qe_next;

		solid = ToI64(QPrFieldF(i, q_fld_solid));
		if (solid != QSOLID_BBOX_ && solid != QSOLID_SLIDEBOX_)
			goto qe_next;

		eorg[0] = QPrFieldF(i, q_fld_origin);
		eorg[1] = QPrFieldF(i, q_fld_origin + 1);
		eorg[2] = QPrFieldF(i, q_fld_origin + 2);

		inside = TRUE;
		for (j = 0; j < 3; j++)
		{
			emins[j] = eorg[j] + QPrFieldF(i, q_fld_mins + j);
			emaxs[j] = eorg[j] + QPrFieldF(i, q_fld_maxs + j);

			if (point[j] < emins[j] || point[j] > emaxs[j])
				inside = FALSE;
		}

		if (inside)
			return i;

qe_next:
	}

	return -1;
}

U0 QGamePhysicsEntity(I64 ent, F64 dt)
{//One entity, one tick.
	CQTrace	tr;
	F64		origin[3];
	F64		velocity[3];
	F64		avelocity[3];
	F64		end[3];
	F64		grav;
	I64		movetype;
	I64		hit;
	I64		j;

	movetype = ToI64(QPrFieldF(ent, q_fld_movetype));

	//The player is moved by the engine's own player code, and NONE means the
	//entity is deliberately static.
	if (movetype == QMOVETYPE_NONE || movetype == QMOVETYPE_WALK ||
		ent == q_player_edict)
		return;

	for (j = 0; j < 3; j++)
	{
		origin[j]    = QPrFieldF(ent, q_fld_origin + j);
		velocity[j]  = QPrFieldF(ent, q_fld_velocity + j);
		avelocity[j] = QPrFieldF(ent, q_fld_avelocity + j);
	}

	//Spinning applies to everything that has an angular velocity - it is what
	//makes rockets and gibs tumble.
	if (avelocity[0] != 0.0 || avelocity[1] != 0.0 || avelocity[2] != 0.0)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_angles + j,
				QAngleNorm(QPrFieldF(ent, q_fld_angles + j) +
					avelocity[j] * dt));
	}

	if (movetype == QMOVETYPE_ANGLENOCLIP || movetype == QMOVETYPE_ANGLECLIP)
		return;		//angles only, no translation

	//Gravity, scaled by the entity's own multiplier where it has one.
	if (movetype == QMOVETYPE_TOSS || movetype == QMOVETYPE_BOUNCE ||
		movetype == QMOVETYPE_STEP)
	{
		grav = QPrFieldF(ent, q_fld_gravity);
		if (grav <= 0.0)
			grav = 1.0;

		//A STEP entity resting on the floor should not accumulate fall speed.
		if (movetype != QMOVETYPE_STEP ||
			!(ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_ONGROUND_))
			velocity[2] -= QPHYS_SV_GRAVITY * grav * dt;
	}

	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);
		return;
	}

	QVecMA(origin, dt, velocity, end);

	//NOCLIP and PUSH pass through geometry: PUSH is how doors and platforms
	//travel, and they are meant to move through their own brush volume.
	if (movetype == QMOVETYPE_NOCLIP || movetype == QMOVETYPE_PUSH)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_origin + j, end[j]);

		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);

		//Brush movers run their think on their own local clock.
		if (movetype == QMOVETYPE_PUSH && q_fld_ltime >= 0)
			QPrSetFieldF(ent, q_fld_ltime, QPrFieldF(ent, q_fld_ltime) + dt);

		return;
	}

	//Everything else sweeps against the world.
	QTraceMove(q_bi_map, origin, end, &tr);

	//Did it pass through a solid entity on the way?
	hit = QGameEntityAt(ent, tr.end_pos);

	for (j = 0; j < 3; j++)
		QPrSetFieldF(ent, q_fld_origin + j, tr.end_pos[j]);

	if (tr.fraction < 1.0 || hit >= 0)
	{
		if (movetype == QMOVETYPE_BOUNCE)
		{
			//Reflect and lose energy; QuakeC stops the entity itself once it
			//is slow enough.
			QClipVelocity(velocity, tr.plane_normal, 1.5, velocity);
			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);
		}
		else if (movetype == QMOVETYPE_TOSS || movetype == QMOVETYPE_STEP)
		{
			//Slide along the surface and mark it grounded when it lands flat.
			QClipVelocity(velocity, tr.plane_normal, 1.0, velocity);
			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);

			if (tr.plane_normal[2] > 0.7)
				QPrSetFieldF(ent, q_fld_flags,
					ToF64(ToI64(QPrFieldF(ent, q_fld_flags)) | QFL_ONGROUND_));
		}
		else
		{
			//FLY and FLYMISSILE just stop; the touch handler decides what that
			//means, which for a rocket is exploding.
			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, 0.0);
		}

		//Tell QuakeC about the collision. Touching the world is entity 0,
		//which is exactly what the missile code expects.
		if (hit >= 0)
		{
			QGameCallTouch(ent, hit);
			QGameCallTouch(hit, ent);
		}
		else
			QGameCallTouch(ent, 0);
	}
	else
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);
	}
}

U0 QGameRunPhysics(F64 dt)
{//Move every entity that has a movetype. Entities can be removed by a touch
 //handler mid-pass, so the free flag is rechecked each step.
	I64 i;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
			QGamePhysicsEntity(i, dt);
	}
}

U0 QGameRunThinks()
{//Run every think that has come due. Entities can spawn or free others while
 //this runs, so the bound is re-read each iteration.
	I64 i;
	I64 think;
	F64 nextthink;

	i = 0;
	while (i < q_pr_num_edicts)
	{
		if (!q_pr_edict_free[i])
		{
			nextthink = QPrFieldF(i, q_fld_nextthink);

			if (nextthink > 0.0 && nextthink <= q_game_time)
			{
				//Clear before calling: the think usually reschedules itself,
				//and clearing afterwards would discard that.
				QPrSetFieldF(i, q_fld_nextthink, 0.0);

				think = QPrFieldI(i, q_fld_think);
				if (think > 0 && think < q_pr_num_functions)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(think);
					q_game_thinks++;

					if (q_pr_error)
						q_pr_error = FALSE;
				}
			}
		}

		i++;
	}
}

U0 QGameFrame(F64 dt)
{//Advance game time and run one round of thinking.
	I64 fn;

	if (!q_game_active)
		return;

	q_game_time += dt;

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, dt);

	fn = QPrFindFunction("StartFrame");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, 0);
		QPrExecute(fn);
		if (q_pr_error)
			q_pr_error = FALSE;
	}

	//Physics before thinks, matching the server order: an entity moves, its
	//touch handlers fire, and only then does its think decide what happens
	//next. Reversing this makes rockets explode a tick late.
	QGameRunPhysics(dt);
	QGameRunThinks;
}

U0 QGameSaveParms()
{//Ask QuakeC to pack the inventory into parm1..parm16, then keep a copy.
 //SetChangeParms decides how much ammo and which weapons survive, so the game
 //logic owns the rules and the engine only carries the result.
	I64	fn;
	I64	ofs;
	I64	i;
	F64	value;

	q_have_saved_parms = FALSE;

	if (!q_game_active || q_player_edict <= 0)
		return;

	fn = QPrFindFunction("SetChangeParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		q_saved_parms[i] = 0.0;
		ofs = q_ofs_parms[i];

		if (ofs >= 0)
		{
			//Via a temp rather than storing the call result straight into the
			//array slot: this compiler computes the slot address before
			//evaluating the call, which can lose the store.
			value = QPrGetF(ofs);
			q_saved_parms[i] = value;
		}
	}

	//serverflags tracks which episode runes have been collected.
	if (q_ofs_serverflags >= 0)
	{
		value = QPrGetF(q_ofs_serverflags);
		q_saved_serverflags = value;
	}

	q_have_saved_parms = TRUE;
}

U0 QGameRestoreParms()
{//Push the carried inventory back into the freshly loaded bytecode, before
 //the player spawns. ClientConnect reads these to rebuild the loadout.
	I64	ofs;
	I64	i;

	if (!q_have_saved_parms)
		return;

	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		ofs = q_ofs_parms[i];
		if (ofs >= 0)
			QPrSetF(ofs, q_saved_parms[i]);
	}

	if (q_ofs_serverflags >= 0)
		QPrSetF(q_ofs_serverflags, q_saved_serverflags);
}

Bool QGameInit(CQMap *map)
{//Load the bytecode, wire the builtins, and populate the world.
	I64 fn;

	q_game_active  = FALSE;
	q_game_time    = 1.0;		//QuakeC treats time 0 as "never scheduled"
	q_game_thinks  = 0;
	q_game_spawned = 0;

	if (!QPrLoad("progs.dat", QGAME_MAX_EDICTS))
		return FALSE;

	QPrCacheOffsets;
	QBiInit;
	q_bi_map = map;

	//Required symbols. Without these the image is not stock QuakeC and
	//running it would fault in confusing ways.
	if (q_ofs_self < 0 || q_ofs_time < 0 || q_fld_nextthink < 0 ||
		q_fld_think < 0)
	{
		"QGame: progs.dat is missing required symbols\n";
		return FALSE;
	}

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, QGAME_FRAME_TIME);

	//Reserve the client slot BEFORE any map entity spawns. QuakeC assumes the
	//clients occupy the edicts immediately after the world, and several
	//lookups depend on it.
	q_player_edict = QPrSpawnEdict;

	//Inventory carried in from the previous level, restored before anything
	//spawns so worldspawn and ClientConnect both see it.
	QGameRestoreParms;

	//main() is a no-op in stock QuakeC but is called for completeness.
	fn = QPrFindFunction("main");
	if (fn > 0)
	{
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	q_game_spawned = QGameSpawnEntities(map);
	q_game_active  = TRUE;

	"QGame: %d entities spawned, %d edicts live\n",
		q_game_spawned, q_pr_num_edicts;

	return TRUE;
}

U0 QGameShutdown()
{
	q_game_active = FALSE;
	q_bi_map      = NULL;
	QBiFreePrecache;
	QPrFree;
}

U0 QGameDrawEntities(CQCanvas *c, CQMap *map, F64 *view_origin, F64 max_dist)
{//Draw every live entity that has a model.
	F64		eorg[3];
	F64		eang[3];
	F64		d[3];
	CQMdl	*mdl;
	I64		 i;
	I64		 idx;
	I64		 frame;
	I64		 bm;
	U8		*name;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qg_next;

		//Never draw the player's own body in first person. QuakeC gives the
		//client progs/player.mdl so other players and demos can see it, but
		//from inside the head it just wraps the camera in geometry.
		if (i == q_player_edict)
			goto qg_next;

		idx = ToI64(QPrFieldF(i, q_fld_modelindex));
		if (idx <= 0 || idx >= q_precache_model_count)
			goto qg_next;

		eorg[0] = QPrFieldF(i, q_fld_origin);
		eorg[1] = QPrFieldF(i, q_fld_origin + 1);
		eorg[2] = QPrFieldF(i, q_fld_origin + 2);

		QVecSub(eorg, view_origin, d);
		if (QVecLength(d) > max_dist)
			goto qg_next;

		name = q_precache_model[idx];

		//Brush models are part of the map geometry and draw through the face
		//path; only alias models go through the triangle path.
		if (name[0] == '*')
		{
			bm = ToI64(QAtoF(name + 1));
			if (bm > 0)
				QDrawBrushModel(c, map, bm);
			goto qg_next;
		}

		mdl = q_precache_mdl[idx];
		if (!mdl)
			goto qg_next;

		eang[0] = QPrFieldF(i, q_fld_angles);
		eang[1] = QPrFieldF(i, q_fld_angles + 1);
		eang[2] = QPrFieldF(i, q_fld_angles + 2);

		frame = ToI64(QPrFieldF(i, q_fld_frame));
		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		QMdlDraw(c, mdl, frame, eorg, eang[1], QGAME_LIGHT);

qg_next:
	}
}
