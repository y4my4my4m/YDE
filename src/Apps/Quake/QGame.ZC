// QGame.ZC - drives the QuakeC VM: spawning, per-frame thinking, drawing.
//
// The map's entity text is the input to the game, not just scenery data. Each
// block becomes an entity whose fields are filled from the key/value pairs,
// after which the QuakeC spawn function named by its classname runs. That is
// what turns "monster_army" from a string into a soldier with a model, a
// bounding box and a think schedule.
//
// Once spawned, entities are advanced by running any think function whose
// nextthink has come due. That single mechanism is what animates monsters,
// opens doors and bobs items.

#define QGAME_MAX_EDICTS	600
#define QGAME_FRAME_TIME	0.1		//QuakeC assumes 10Hz thinking
#define QGAME_LIGHT			170		//fallback when no lit surface is found
#define QGAME_STATIC_DIST	2000.0	//static props are range limited like entities

//QuakeC value types, as emitted in the def tables.
#define QTYPE_VOID		0
#define QTYPE_STRING	1
#define QTYPE_FLOAT		2
#define QTYPE_VECTOR	3
#define QTYPE_ENTITY	4
#define QTYPE_FIELD		5
#define QTYPE_FUNCTION	6
#define QTYPE_POINTER	7

Bool q_game_active	= FALSE;
F64	 q_game_time	= 0.0;
I64	 q_game_spawned	= 0;
I64	 q_game_thinks	= 0;

//Inventory carried between levels. QuakeC stores it in parm1..parm16 via
//SetChangeParms; reloading the bytecode resets the global pool, so the values
//have to be held on the engine side across the transition.
#define QGAME_MAX_PARMS	16
F64	 q_saved_parms[QGAME_MAX_PARMS];
F64	 q_saved_serverflags	= 0.0;
Bool q_have_saved_parms		= FALSE;
Bool q_world_warned			= FALSE;

I64 QGameFindFieldDef(U8 *name, I64 *_type)
{//Field defs carry the type, which decides how a map value is converted.
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
		{
			if (_type)
				*_type = q_pr_fielddefs[i].type & 0x7FFF;	//high bit is a flag
			return q_pr_fielddefs[i].ofs;
		}
	}

	if (_type)
		*_type = QTYPE_VOID;

	return -1;
}

Bool QGameSetField(I64 ent, U8 *key, U8 *value)
{//Convert one map key/value onto an entity field.
	I64 ftype;
	I64 ofs;
	F64 v[3];
	I64 fn;
	U8	anglebuf[64];

	//The "angle" hack, exactly as ED_ParseEdict does it.
	//
	//Maps overwhelmingly write a single yaw as `"angle" "90"`, but progs.dat has
	//no field called `angle` - only the vector `angles`. Without this rewrite the
	//lookup below fails and the key is silently DROPPED, so every entity in every
	//map spawns facing due east.
	//
	//That is not a cosmetic problem. SetMovedir reads self.angles to work out
	//which way a door or platform travels, so zeroed angles send every one of
	//them east regardless of how the level was built. The magic values -1 and -2
	//(move up / move down) are passed straight through here; SetMovedir is the
	//thing that interprets them.
	if (!StrCompare(key, "angle"))
	{
		StrPrint(anglebuf, "0 %s 0", value);
		key   = "angles";
		value = anglebuf;
	}

	ofs = QGameFindFieldDef(key, &ftype);
	if (ofs < 0)
		return FALSE;

	switch (ftype)
	{
		case QTYPE_FLOAT:
			QPrSetFieldF(ent, ofs, QAtoF(value));
			break;

		case QTYPE_VECTOR:
			QParseVec(value, v);
			QPrSetFieldF(ent, ofs, v[0]);
			QPrSetFieldF(ent, ofs + 1, v[1]);
			QPrSetFieldF(ent, ofs + 2, v[2]);
			break;

		case QTYPE_STRING:
			//Map strings are not in the compiled blob, so they are copied into
			//the runtime string heap first.
			QPrSetFieldI(ent, ofs, QPrNewString(value));
			break;

		case QTYPE_ENTITY:
			QPrSetFieldI(ent, ofs, QPrEdictValue(ToI64(QAtoF(value))));
			break;

		case QTYPE_FUNCTION:
			fn = QPrFindFunction(value);
			if (fn < 0)
				fn = 0;
			QPrSetFieldI(ent, ofs, fn);
			break;

		default:
			return FALSE;
	}

	return TRUE;
}

//defs.qc spawnflags reserved by the engine for entity filtering.
#define QSPAWNFLAG_NOT_EASY			256
#define QSPAWNFLAG_NOT_MEDIUM		512
#define QSPAWNFLAG_NOT_HARD			1024
#define QSPAWNFLAG_NOT_DEATHMATCH	2048

Bool QGameInhibitEntity(I64 ent)
{//ED_LoadFromFile: does this entity belong in the game being started?
	I64 flags;
	I64 skill;

	//Entity 0 is worldspawn and is not optional.
	if (ent <= 0 || q_fld_spawnflags < 0)
		return FALSE;

	flags = ToI64(QPrFieldF(ent, q_fld_spawnflags));

	if (QCvarGet("deathmatch") != 0.0)
		return ToBool(flags & QSPAWNFLAG_NOT_DEATHMATCH);

	//current_skill is the clamped integer, not the raw cvar - skill 3 uses the
	//hard set, and anything above or below is pulled into range first.
	skill = ToI64(QCvarGet("skill") + 0.5);
	skill = ClampI64(skill, 0, 3);

	if (skill == 0 && (flags & QSPAWNFLAG_NOT_EASY))
		return TRUE;
	if (skill == 1 && (flags & QSPAWNFLAG_NOT_MEDIUM))
		return TRUE;
	if (skill >= 2 && (flags & QSPAWNFLAG_NOT_HARD))
		return TRUE;

	return FALSE;
}

I64 QGameSpawnEntities(CQMap *map)
{//Walk the entity text, build each entity, then run its spawn function.
	U8	*p;
	U8	*end;
	U8	 key[64];
	U8	 val[160];
	U8	 classname[64];
	U8	 line[128];
	I64	 inhibited = 0;
	I64	 ent;
	I64	 k;
	I64	 fn;
	I64	 spawned = 0;
	Bool first    = TRUE;

	if (!map->entities || map->entities_size <= 0)
		return 0;

	p   = map->entities;
	end = map->entities + map->entities_size;

	while (p < end)
	{
		if (*p == '{')
		{
			//The first block is worldspawn, which owns entity 0.
			if (first)
			{
				ent   = 0;
				first = FALSE;
			}
			else
				ent = QPrSpawnEdict;

			classname[0] = 0;
			p++;

			while (p < end && *p != '}')
			{
				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 63)
				{
					key[k] = *p;
					k++;
					p++;
				}
				key[k] = 0;
				if (p < end)
					p++;

				while (p < end && *p != '"' && *p != '}')
					p++;
				if (p >= end || *p == '}')
					break;

				p++;
				k = 0;
				while (p < end && *p != '"' && k < 159)
				{
					val[k] = *p;
					k++;
					p++;
				}
				val[k] = 0;
				if (p < end)
					p++;

				if (!StrCompare(key, "classname"))
					QStrCopy(classname, val, 64);

				QGameSetField(ent, key, val);
			}

			//ED_LoadFromFile's inhibit test. The map carries EVERY entity for
			//every skill; the engine is what throws away the ones that do not
			//belong in this game. Skipping it spawned all of them at once, so
			//easy played with the hard monster set and the extra hard-only
			//pickups were there too.
			if (QGameInhibitEntity(ent))
			{
				//Name what is being dropped. "It removed too much" and "the
				//map really does not have that on this skill" look identical
				//from in front of the screen.
				if (inhibited < 24 && classname[0])
				{
					StrPrint(line, "  inhibit %s (spawnflags %d)\n",
						classname,
						ToI64(QPrFieldF(ent, q_fld_spawnflags)));
					QLog(line);
				}

				QPrFreeEdict(ent);
				inhibited++;
				goto qge_next_ent;
			}

			if (classname[0])
			{
				//The spawn function shares the classname. Anything without one
				//(lights, path corners) is data only and is simply left alone.
				fn = QPrFindFunction(classname);
				if (fn > 0)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(ent));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(fn);
					spawned++;

					if (q_pr_error)
					{
						"QGame: error spawning %s\n", classname;
						q_pr_error = FALSE;
					}

					//The world must stay non-damageable. If a spawn function
					//just made it damageable, that function ran with self
					//pointing at entity 0 instead of its own entity - which is
					//how the world ends up being "killed" later. Name it and
					//repair the invariant rather than letting it poison the
					//rest of the level.
					if (QPrFieldF(0, q_fld_takedamage) != 0.0)
					{
						StrPrint(line, "QGame: %s corrupted world.takedamage\n",
							classname);
						QLog(line);

						QPrSetFieldF(0, q_fld_takedamage, 0.0);
						QPrSetFieldF(0, q_fld_health, 0.0);
					}
				}
			}

qge_next_ent:
		}

		if (p < end)
			p++;
	}

	if (inhibited)
	{
		StrPrint(line, "QGame: %d entities inhibited by skill/deathmatch\n",
			inhibited);
		QLog(line);
	}

	return spawned;
}

//--- entity physics --------------------------------------------------------
//
// Think functions decide what an entity WANTS to do; physics is what actually
// moves it. Without this pass a rocket gets a velocity, animates, and expires
// on schedule while hanging motionless in the air - and doors never travel.
//
// Each entity's .movetype selects the rule, exactly as the original server
// does. The important distinction is between things that simply translate
// (NOCLIP, PUSH), things that fall (TOSS, BOUNCE, STEP), and things that must
// report a collision to QuakeC so it can explode them (FLYMISSILE).

#define QMOVETYPE_NONE			0
#define QMOVETYPE_ANGLENOCLIP	1
#define QMOVETYPE_ANGLECLIP		2
#define QMOVETYPE_WALK			3
#define QMOVETYPE_STEP			4
#define QMOVETYPE_FLY			5
#define QMOVETYPE_TOSS			6
#define QMOVETYPE_PUSH			7
#define QMOVETYPE_NOCLIP		8
#define QMOVETYPE_FLYMISSILE	9
#define QMOVETYPE_BOUNCE		10

#define QPHYS_SV_GRAVITY	800.0
#define QFL_ONGROUND_		512
#define QFL_CLIENT			8
#define QFL_ITEM_			256


U0 QGameLinkAll()
{//Refresh every live entity's bounds. Called once per frame before thinking,
 //so anything that moved last frame is measured correctly this frame.
	I64 i;

	for (i = 0; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
			QGameLinkEdict(i);
	}
}

U0 QGameCallTouch(I64 self_ent, I64 other_ent)
{//Run an entity's touch function with the pair the original would pass.
	I64 fn;

	//The world has no touch behaviour, and asking it to run one is how the
	//world ends up as "self" inside damage code that was never meant to see it.
	if (self_ent <= 0)
		return;

	//The original only dispatches touch for entities that are actually solid.
	//Without this, entities that have switched themselves off (a trigger sets
	//solid to SOLID_NOT the moment it fires) keep receiving impacts.
	if (QPrFieldF(self_ent, q_fld_solid) == ToF64(QSOLID_NOT_))
		return;

	fn = QPrFieldI(self_ent, q_fld_touch);

	if (fn <= 0 || fn >= q_pr_num_functions)
		return;

	QPrSetI(q_ofs_self, QPrEdictValue(self_ent));
	QPrSetI(q_ofs_other, QPrEdictValue(other_ent));
	QPrExecute(fn);
	q_pr_error = FALSE;
}

U0 QGamePhysicsEntity(I64 ent, F64 dt)
{//One entity, one tick.
	CQTrace	tr;
	F64		origin[3];
	F64		velocity[3];
	F64		avelocity[3];
	F64		end[3];
	F64		emins[3];
	F64		emaxs[3];
	F64		grav;
	I64		movetype;
	I64		hit;
	I64		j;
	I64		solid;
	Bool	ground_ok;

	movetype = ToI64(QPrFieldF(ent, q_fld_movetype));

	//Dispatch by MOVETYPE, exactly as SV_Physics_Client does - not by "is this
	//the player".
	//
	//A WALK player is moved by the engine's own player code, so it is skipped
	//here. But PlayerDie sets movetype to TOSS, and at that point the corpse
	//belongs to SV_Physics_Toss like any other falling object. Skipping the
	//player unconditionally left the dead body running WALK physics forever,
	//which - now that impacts fire touch functions - re-triggered whatever it
	//was resting on every frame, looping that entity's sound.
	if (movetype == QMOVETYPE_NONE || movetype == QMOVETYPE_WALK)
		return;

	for (j = 0; j < 3; j++)
	{
		origin[j]    = QPrFieldF(ent, q_fld_origin + j);
		velocity[j]  = QPrFieldF(ent, q_fld_velocity + j);
		avelocity[j] = QPrFieldF(ent, q_fld_avelocity + j);
	}

	//Spinning applies to everything that has an angular velocity - it is what
	//makes rockets and gibs tumble.
	if (avelocity[0] != 0.0 || avelocity[1] != 0.0 || avelocity[2] != 0.0)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_angles + j,
				QAngleNorm(QPrFieldF(ent, q_fld_angles + j) +
					avelocity[j] * dt));
	}

	if (movetype == QMOVETYPE_ANGLENOCLIP || movetype == QMOVETYPE_ANGLECLIP)
		return;		//angles only, no translation

	//An entity already at rest on the floor is finished: SV_Physics_Toss and
	//SV_Physics_Step both return before gravity and before the sweep when
	//FL_ONGROUND is set.
	//
	//Skipping only the gravity is not enough.
	//Nothing here applies friction, so a corpse kept the sideways velocity it
	//died with and slid away across the floor and off into the air forever.
	if (movetype == QMOVETYPE_TOSS || movetype == QMOVETYPE_BOUNCE ||
		movetype == QMOVETYPE_STEP)
	{
		if (ToBool(ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_ONGROUND_))
			return;

		//Gravity, scaled by the entity's own multiplier where it has one.
		grav = QPrFieldF(ent, q_fld_gravity);
		if (grav <= 0.0)
			grav = 1.0;

		velocity[2] -= QPHYS_SV_GRAVITY * grav * dt;
	}

	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);
		return;
	}

	QVecMA(origin, dt, velocity, end);

	//NOCLIP and PUSH pass through geometry: PUSH is how doors and platforms
	//travel, and they are meant to move through their own brush volume.
	if (movetype == QMOVETYPE_NOCLIP || movetype == QMOVETYPE_PUSH)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_origin + j, end[j]);

		QPrSetFieldF(ent, q_fld_velocity + 2, velocity[2]);

		//Brush movers run their think on their own local clock.
		if (movetype == QMOVETYPE_PUSH && q_fld_ltime >= 0)
			QPrSetFieldF(ent, q_fld_ltime, QPrFieldF(ent, q_fld_ltime) + dt);

		return;
	}

	//Everything else sweeps against the world AND every solid entity, so the
	//impact point is where it really hit rather than where the world stopped it.
	for (j = 0; j < 3; j++)
	{
		emins[j] = QPrFieldF(ent, q_fld_mins + j);
		emaxs[j] = QPrFieldF(ent, q_fld_maxs + j);
	}

	//Same MOVE_NOMONSTERS rule SV_PushEntity applies: TRIGGER and NOT entities
	//clip against brush models only. Without it a dropped backpack (which is
	//SOLID_TRIGGER) lands on the corpse it fell out of and hangs in the air.
	solid = ToI64(QPrFieldF(ent, q_fld_solid));

	QTraceEntity(q_bi_map, origin, end, emins, emaxs, ent,
		ToBool(solid == QSOLID_TRIGGER_ || solid == QSOLID_NOT_), &tr);
	hit = tr.ent;

	for (j = 0; j < 3; j++)
		QPrSetFieldF(ent, q_fld_origin + j, tr.end_pos[j]);

	if (tr.fraction < 1.0 || hit >= 0)
	{
		if (movetype == QMOVETYPE_BOUNCE || movetype == QMOVETYPE_TOSS ||
			movetype == QMOVETYPE_STEP)
		{
			//Bouncing entities (gibs, grenades) reflect and lose energy;
			//everything else just slides along the surface.
			if (movetype == QMOVETYPE_BOUNCE)
				QClipVelocity(velocity, tr.plane_normal, 1.5, velocity);
			else
				QClipVelocity(velocity, tr.plane_normal, 1.0, velocity);

			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);

			//Landing flat brings it to REST, not merely to grounded. The
			//original zeroes both velocity and angular velocity here, which is
			//what stops a corpse sliding away on the momentum it died with. A
			//bouncing entity is exempt until it has slowed, so grenades still
			//bounce a few times before settling.
			//A STEP entity may only take ground from a brush surface, the same
			//gate SV_FlyMove applies - that is the mechanism by which nothing
			//in the original can stand on a monster. TOSS and BOUNCE have no
			//such gate in SV_Physics_Toss, so a gib really can settle on a
			//corpse.
			if (movetype == QMOVETYPE_STEP && tr.ent > 0 &&
				ToI64(QPrFieldF(tr.ent, q_fld_solid)) != QSOLID_BSP_)
				ground_ok = FALSE;
			else
				ground_ok = TRUE;

			if (tr.plane_normal[2] > 0.7 && ground_ok &&
				(movetype != QMOVETYPE_BOUNCE || velocity[2] < 60.0))
			{
				QPrSetFieldF(ent, q_fld_flags,
					ToF64(ToI64(QPrFieldF(ent, q_fld_flags)) | QFL_ONGROUND_));

				//WHICH entity it landed on has to be recorded, not merely that
				//it landed. SV_PushMove decides who rides a platform by
				//comparing .groundentity against the pusher, so a corpse or a
				//dropped backpack that never sets the field is left behind when
				//the lift moves - and since FL_ONGROUND is set, gravity is
				//skipped and the body hangs in the air exactly where the lift
				//abandoned it. Hitting the world traces as -1 here but is edict
				//0 to QuakeC.
				if (q_fld_groundentity >= 0)
				{
					if (tr.ent > 0)
						QPrSetFieldI(ent, q_fld_groundentity,
							QPrEdictValue(tr.ent));
					else
						QPrSetFieldI(ent, q_fld_groundentity,
							QPrEdictValue(0));
				}

				for (j = 0; j < 3; j++)
				{
					QPrSetFieldF(ent, q_fld_velocity + j, 0.0);
					QPrSetFieldF(ent, q_fld_avelocity + j, 0.0);
				}
			}
		}
		else
		{
			//FLY and FLYMISSILE just stop; the touch handler decides what that
			//means, which for a rocket is exploding.
			for (j = 0; j < 3; j++)
				QPrSetFieldF(ent, q_fld_velocity + j, 0.0);
		}

		//Tell QuakeC about the collision. Touching the world is entity 0,
		//which is exactly what the missile code expects.
		if (hit >= 0)
		{
			QGameCallTouch(ent, hit);
			QGameCallTouch(hit, ent);
		}
		else
			QGameCallTouch(ent, 0);
	}
	else
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_velocity + j, velocity[j]);
	}
}

#define QGAME_MAX_PUSHED	256

I64 q_pushed_ent[QGAME_MAX_PUSHED];
F64 q_pushed_from[QGAME_MAX_PUSHED * 3];

U0 QGamePushMove(I64 pusher, F64 movetime)
{//Translate a door or platform and carry, or crush, whatever is in its way.
 //Ported from SV_PushMove.
 //
 //A pusher is the world as far as riders are concerned, so it moves first and
 //then anything found inside its new volume is shoved by the same offset. If a
 //rider cannot be shoved clear, the WHOLE move is rolled back - pusher and
 //every entity moved so far - and the pusher's .blocked is called. That
 //rollback is the mechanism behind a door reversing rather than
 //quietly passing through, and behind a crusher doing damage.
	F64  move[3];
	F64  mins[3];
	F64  maxs[3];
	F64  pushorig[3];
	F64  entorig[3];
	F64  velocity[3];
	CQTrace tr;
	I64  num_pushed = 0;
	I64  i;
	I64  j;
	I64  movetype;
	I64  solid;
	I64  blocked_fn;
	I64  ground;
	Bool overlaps;

	for (j = 0; j < 3; j++)
		velocity[j] = QPrFieldF(pusher, q_fld_velocity + j);

	//Standing still: just advance its clock.
	if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
	{
		QPrSetFieldF(pusher, q_fld_ltime,
			QPrFieldF(pusher, q_fld_ltime) + movetime);
		return;
	}


	for (j = 0; j < 3; j++)
	{
		move[j]     = velocity[j] * movetime;
		pushorig[j] = QPrFieldF(pusher, q_fld_origin + j);
		mins[j]     = QPrFieldF(pusher, q_fld_absmin + j) + move[j];
		maxs[j]     = QPrFieldF(pusher, q_fld_absmax + j) + move[j];
	}

	//Move the pusher to its final position first.
	for (j = 0; j < 3; j++)
		QPrSetFieldF(pusher, q_fld_origin + j, pushorig[j] + move[j]);

	QPrSetFieldF(pusher, q_fld_ltime,
		QPrFieldF(pusher, q_fld_ltime) + movetime);
	QGameLinkEdict(pusher);

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == pusher)
			goto qpm_next;

		movetype = ToI64(QPrFieldF(i, q_fld_movetype));
		if (movetype == QMOVETYPE_PUSH || movetype == QMOVETYPE_NONE ||
			movetype == QMOVETYPE_NOCLIP)
			goto qpm_next;

		//Anything standing ON the pusher rides it unconditionally. Otherwise it
		//only matters if it ends up inside the pusher's new volume.
		ground = QPrEdictNum(QPrFieldI(i, q_fld_groundentity));

		if (!(ToI64(QPrFieldF(i, q_fld_flags)) & QFL_ONGROUND_) ||
			ground != pusher)
		{
			overlaps = TRUE;
			for (j = 0; j < 3; j++)
			{
				if (QPrFieldF(i, q_fld_absmin + j) >= maxs[j] ||
					QPrFieldF(i, q_fld_absmax + j) <= mins[j])
					overlaps = FALSE;
			}

			if (!overlaps)
				goto qpm_next;

			if (QTestEntityPosition(q_bi_map, i) < 0)
				goto qpm_next;
		}

		//Riders other than the player lose their ground contact while carried.
		if (movetype != QMOVETYPE_WALK)
			QPrSetFieldF(i, q_fld_flags,
				ToF64(ToI64(QPrFieldF(i, q_fld_flags)) & ~QFL_ONGROUND_));

		for (j = 0; j < 3; j++)
			entorig[j] = QPrFieldF(i, q_fld_origin + j);

		if (num_pushed < QGAME_MAX_PUSHED)
		{
			q_pushed_ent[num_pushed] = i;
			for (j = 0; j < 3; j++)
				q_pushed_from[num_pushed * 3 + j] = entorig[j];
			num_pushed++;
		}

		//The pusher is made non-solid for the shove so the rider is not
		//immediately blocked by the very thing carrying it.
		solid = ToI64(QPrFieldF(pusher, q_fld_solid));
		QPrSetFieldF(pusher, q_fld_solid, ToF64(QSOLID_NOT_));

		QPushEntity(q_bi_map, i, move, &tr);

		QPrSetFieldF(pusher, q_fld_solid, ToF64(solid));
		QGameLinkEdict(i);

		//Still stuck in the pusher, so this move cannot happen.
		if (QTestEntityPosition(q_bi_map, i) >= 0)
		{
			//A zero-width entity cannot block anything.
			if (QPrFieldF(i, q_fld_mins + 0) == QPrFieldF(i, q_fld_maxs + 0))
				goto qpm_next;

			//Corpses and triggers get flattened out of the way instead of
			//stopping the door, which is what keeps bodies from jamming it.
			solid = ToI64(QPrFieldF(i, q_fld_solid));
			if (solid == QSOLID_NOT_ || solid == QSOLID_TRIGGER_)
			{
				QPrSetFieldF(i, q_fld_mins + 0, 0.0);
				QPrSetFieldF(i, q_fld_mins + 1, 0.0);
				for (j = 0; j < 3; j++)
					QPrSetFieldF(i, q_fld_maxs + j,
						QPrFieldF(i, q_fld_mins + j));
				QGameLinkEdict(i);
				goto qpm_next;
			}

			//Put the rider back.
			for (j = 0; j < 3; j++)
				QPrSetFieldF(i, q_fld_origin + j, entorig[j]);
			QGameLinkEdict(i);

			//Put the pusher back and un-advance its clock.
			for (j = 0; j < 3; j++)
				QPrSetFieldF(pusher, q_fld_origin + j, pushorig[j]);
			QPrSetFieldF(pusher, q_fld_ltime,
				QPrFieldF(pusher, q_fld_ltime) - movetime);
			QGameLinkEdict(pusher);

			//Let QuakeC decide what being blocked means: a door reverses, a
			//crusher does damage. With no handler it simply waits.
			blocked_fn = QPrFieldI(pusher, q_fld_blocked);
			if (blocked_fn > 0 && blocked_fn < q_pr_num_functions)
			{
				QPrSetI(q_ofs_self, QPrEdictValue(pusher));
				QPrSetI(q_ofs_other, QPrEdictValue(i));
				QPrExecute(blocked_fn);
				q_pr_error = FALSE;
			}

			//Undo everything already carried this move.
			for (j = 0; j < num_pushed; j++)
			{
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 0,
					q_pushed_from[j * 3 + 0]);
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 1,
					q_pushed_from[j * 3 + 1]);
				QPrSetFieldF(q_pushed_ent[j], q_fld_origin + 2,
					q_pushed_from[j * 3 + 2]);
				QGameLinkEdict(q_pushed_ent[j]);
			}

			return;
		}

qpm_next:
	}
}

U0 QGamePhysicsPusher(I64 ent, F64 dt)
{//Doors, platforms and buttons.
 //
 //These run on their OWN clock. SUB_CalcMove schedules their next think as
 //ltime + traveltime, not time + traveltime, so a think loop that compares
 //nextthink against game time either fires them at the wrong moment or never
 //fires them at all - which is why doors would not open.
 //
 //So the local clock is advanced by the move, and the think is run when that
 //clock crosses the scheduled moment.
	F64 old_ltime;
	F64 thinktime;
	F64 movetime;
	F64 avelocity[3];
	I64 think;
	I64 j;

	old_ltime = QPrFieldF(ent, q_fld_ltime);
	thinktime = QPrFieldF(ent, q_fld_nextthink);

	//Move only as far as the scheduled think, so it lands exactly on time.
	//
	//NOTE THE ABSENCE of a `thinktime > 0` guard - SV_Physics_Pusher has none,
	//and that omission matters. With no think scheduled, nextthink is 0,
	//so `0 < ltime + dt` is TRUE and movetime becomes `0 - ltime`, which clamps
	//to zero: an idle pusher does not move AND its local clock does not advance.
	//
	//Adding the guard, which is the obvious-looking thing to do, sends an idle
	//pusher down the `else` branch instead and advances it by a full step every
	//frame. Its ltime then runs ahead of the schedule its own think times are
	//expressed in, so when something finally does set nextthink = ltime + delay
	//the comparison against a drifted clock fires at the wrong moment - or never.
	if (thinktime < old_ltime + dt)
	{
		movetime = thinktime - old_ltime;
		if (movetime < 0.0)
			movetime = 0.0;
	}
	else
		movetime = dt;

	if (movetime > 0.0)
	{
		for (j = 0; j < 3; j++)
			avelocity[j] = QPrFieldF(ent, q_fld_avelocity + j);

		//Rotation is applied directly; only translation can shove anything.
		for (j = 0; j < 3; j++)
		{
			if (avelocity[j] != 0.0)
				QPrSetFieldF(ent, q_fld_angles + j,
					QAngleNorm(QPrFieldF(ent, q_fld_angles + j) +
						avelocity[j] * movetime));
		}

		QGamePushMove(ent, movetime);
	}

	//Think when the local clock reaches the scheduled time.
	if (thinktime > old_ltime && thinktime <= QPrFieldF(ent, q_fld_ltime))
	{
		QPrSetFieldF(ent, q_fld_nextthink, 0.0);

		think = QPrFieldI(ent, q_fld_think);
		if (think > 0 && think < q_pr_num_functions)
		{
			QPrSetI(q_ofs_self, QPrEdictValue(ent));
			QPrSetI(q_ofs_other, 0);
			QPrExecute(think);
			q_pr_error = FALSE;
			q_game_thinks++;
		}
	}
}

U0 QGameRunPhysics(F64 dt)
{//Move every entity that has a movetype. Entities can be removed by a touch
 //handler mid-pass, so the free flag is rechecked each step.
	I64 i;
	I64 movetype;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qrp_next;

		movetype = ToI64(QPrFieldF(i, q_fld_movetype));

		//Pushers own their think scheduling, so they are handled separately
		//and skipped by the ordinary think pass.
		if (movetype == QMOVETYPE_PUSH)
			QGamePhysicsPusher(i, dt);
		else
			QGamePhysicsEntity(i, dt);

qrp_next:
	}
}

U0 QGameTouchTriggersFor(I64 client)
{//Touch triggers overlapping one client edict. Used for REMOTE players after
 //their origin is snapped - QGameFrame's touch pass still sees last frame's
 //position, so items/doors would never fire under their feet.
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	k;
	I64	touch;
	Bool overlap;

	if (client <= 0 || q_pr_edict_free[client])
		return;

	for (k = 0; k < 3; k++)
	{
		amins[k] = QPrFieldF(client, q_fld_absmin + k);
		amaxs[k] = QPrFieldF(client, q_fld_absmax + k);
	}

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == client)
			goto qgtf_next;

		if (ToI64(QPrFieldF(i, q_fld_solid)) != QSOLID_TRIGGER_)
			goto qgtf_next;

		touch = QPrFieldI(i, q_fld_touch);
		if (touch <= 0 || touch >= q_pr_num_functions)
			goto qgtf_next;

		overlap = TRUE;
		for (k = 0; k < 3; k++)
		{
			bmins[k] = QPrFieldF(i, q_fld_absmin + k);
			bmaxs[k] = QPrFieldF(i, q_fld_absmax + k);
			if (amins[k] > bmaxs[k] || amaxs[k] < bmins[k])
				overlap = FALSE;
		}

		if (!overlap)
			goto qgtf_next;

		QPrSetI(q_ofs_self, QPrEdictValue(i));
		QPrSetI(q_ofs_other, QPrEdictValue(client));
		QPrExecute(touch);
		q_pr_error = FALSE;

		//Teleporters relocate the client mid-pass.
		QGameLinkEdict(client);
		for (k = 0; k < 3; k++)
		{
			amins[k] = QPrFieldF(client, q_fld_absmin + k);
			amaxs[k] = QPrFieldF(client, q_fld_absmax + k);
		}

qgtf_next:
	}
}

U0 QGameTouchTriggersAll()
{//Fire trigger touches for every non-client entity against every trigger.
 //SV_TouchLinks, without the area tree.
	F64	amins[3];
	F64	amaxs[3];
	F64	bmins[3];
	F64	bmaxs[3];
	I64	i;
	I64	j;
	I64	k;
	I64	touch;
	Bool overlap;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i] || i == q_player_edict)
			goto qtt_next;

		if (ToI64(QPrFieldF(i, q_fld_solid)) != QSOLID_TRIGGER_)
			goto qtt_next;

		touch = QPrFieldI(i, q_fld_touch);
		if (touch <= 0 || touch >= q_pr_num_functions)
			goto qtt_next;

		for (k = 0; k < 3; k++)
		{
			amins[k] = QPrFieldF(i, q_fld_absmin + k);
			amaxs[k] = QPrFieldF(i, q_fld_absmax + k);
		}

		for (j = 1; j < q_pr_num_edicts; j++)
		{
			if (q_pr_edict_free[j] || j == i)
				goto qtt_inner;

			//Only things that can be touched, and never another trigger.
			if (ToI64(QPrFieldF(j, q_fld_solid)) == QSOLID_TRIGGER_ ||
				ToI64(QPrFieldF(j, q_fld_solid)) == QSOLID_NOT_)
				goto qtt_inner;

			overlap = TRUE;
			for (k = 0; k < 3; k++)
			{
				bmins[k] = QPrFieldF(j, q_fld_absmin + k);
				bmaxs[k] = QPrFieldF(j, q_fld_absmax + k);

				if (bmins[k] > amaxs[k] || bmaxs[k] < amins[k])
					overlap = FALSE;
			}

			if (!overlap)
				goto qtt_inner;

			QPrSetI(q_ofs_self, QPrEdictValue(i));
			QPrSetI(q_ofs_other, QPrEdictValue(j));
			QPrExecute(touch);
			q_pr_error = FALSE;

qtt_inner:
		}

qtt_next:
	}
}

U0 QGameForceRetouch()
{//Re-link every entity and re-run trigger touches for a frame or two.
 //
 //spawn_tdeath sets force_retouch = 2 so that a telefrag catches things that
 //are not moving: an entity resting inside a newly spawned trigger would never
 //be noticed otherwise, because touches normally only fire when something
 //MOVES. SV_Physics honours it by calling SV_LinkEdict with touch_triggers set
 //on every edict, then decrementing.
 //
 //Without it, teleporting onto an occupied destination silently fails to
 //telefrag whoever is standing there.
	I64 retouch;
	I64 i;

	if (q_ofs_force_retouch < 0)
		return;

	retouch = ToI64(QPrGetF(q_ofs_force_retouch));
	if (retouch <= 0)
		return;

	//Bounds are re-derived first: a trigger spawned this frame has none yet.
	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (!q_pr_edict_free[i])
			QGameLinkEdict(i);
	}

	QGameTouchTriggersAll;

	QPrSetF(q_ofs_force_retouch, ToF64(retouch - 1));
}

U0 QGameRunThinks()
{//Run every think that has come due. Entities can spawn or free others while
 //this runs, so the bound is re-read each iteration.
	I64 i;
	I64 think;
	I64 flags;
	F64 nextthink;
	U8  wline[128];

	i = 0;
	while (i < q_pr_num_edicts)
	{
		//Pushers were already thought about by the physics pass, on their own
		//local clock. Running them here as well would fire the think twice.
		//FL_CLIENT thinks run after PlayerPostThink (QSvRunEntityThink /
		//QPlayerRunThink) - same order as SV_Physics_Client.
		flags = 0;
		if (!q_pr_edict_free[i])
			flags = ToI64(QPrFieldF(i, q_fld_flags));

		if (!q_pr_edict_free[i] &&
			ToI64(QPrFieldF(i, q_fld_movetype)) != QMOVETYPE_PUSH &&
			!(flags & QFL_CLIENT))
		{
			nextthink = QPrFieldF(i, q_fld_nextthink);

			if (nextthink > 0.0 && nextthink <= q_game_time)
			{
				//Clear before calling: the think usually reschedules itself,
				//and clearing afterwards would discard that.
				QPrSetFieldF(i, q_fld_nextthink, 0.0);

				think = QPrFieldI(i, q_fld_think);
				if (think > 0 && think < q_pr_num_functions)
				{
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, 0);
					QPrExecute(think);
					q_game_thinks++;

					if (q_pr_error)
						q_pr_error = FALSE;

					//Same invariant check as at spawn, but for think
					//functions. Whichever entity's think leaves the world
					//damageable is the one running with self pointing at
					//entity 0, and it is reported once so the log names it
					//instead of drowning in the consequences.
					if (QPrFieldF(0, q_fld_takedamage) != 0.0)
					{
						if (!q_world_warned)
						{
							StrPrint(wline,
								"QGame: think of %s corrupted world.takedamage\n",
								QPrStr(QPrFieldI(i, q_fld_classname)));
							QLog(wline);
							q_world_warned = TRUE;
						}

						QPrSetFieldF(0, q_fld_takedamage, 0.0);
						QPrSetFieldF(0, q_fld_health, 0.0);
					}
				}
			}
		}

		i++;
	}
}

U0 QGameFrame(F64 dt)
{//Advance game time and run one round of thinking.
	I64 fn;

	if (!q_game_active)
		return;

	q_game_time += dt;

	//SV_SpawnServer publishes the game-mode globals. They must be explicitly
	//zero for single player: CheatCommand - which is what impulse 9 runs - opens
	//with `if (deathmatch || coop) return;`, so a non-zero value there makes the
	//give-all cheat silently do nothing.
	if (q_ofs_deathmatch >= 0)
		QPrSetF(q_ofs_deathmatch, QCvarGet("deathmatch"));
	if (q_ofs_coop >= 0)
		QPrSetF(q_ofs_coop, QCvarGet("coop"));

	//`skill` sits outside pr_global_struct - it is at global offset 349 in
	//progs.dat, and progs never writes it - so the engine has to publish it by
	//name, which is what ED_FindGlobal is for. Left at 0 every monster behaves
	//as if the game were on Easy.
	if (q_ofs_skill >= 0)
		QPrSetF(q_ofs_skill, QCvarGet("skill"));

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, dt);

	fn = QPrFindFunction("StartFrame");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, 0);
		QPrExecute(fn);
		if (q_pr_error)
			q_pr_error = FALSE;
	}

	//Bounds first: everything that reads absmin/absmax this frame must see
	//values that match where entities actually are.
	QGameLinkAll;

	//Physics before thinks, matching the server order: an entity moves, its
	//touch handlers fire, and only then does its think decide what happens
	//next. Reversing this makes rockets explode a tick late.
	//Honoured before the physics pass, as SV_Physics does.
	QGameForceRetouch;

	QGameRunPhysics(dt);
	QGameRunThinks;
}

U0 QGameSaveParms()
{//Ask QuakeC to pack the inventory into parm1..parm16, then keep a copy.
 //SetChangeParms decides how much ammo and which weapons survive, so the game
 //logic owns the rules and the engine only carries the result.
	I64	fn;
	I64	ofs;
	I64	i;
	F64	value;

	q_have_saved_parms = FALSE;

	if (!q_game_active || q_player_edict <= 0)
		return;

	fn = QPrFindFunction("SetChangeParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		q_saved_parms[i] = 0.0;
		ofs = q_ofs_parms[i];

		if (ofs >= 0)
		{
			//Via a temp rather than storing the call result straight into the
			//array slot: this compiler computes the slot address before
			//evaluating the call, which can lose the store.
			value = QPrGetF(ofs);
			q_saved_parms[i] = value;
		}
	}

	//serverflags tracks which episode runes have been collected.
	if (q_ofs_serverflags >= 0)
	{
		value = QPrGetF(q_ofs_serverflags);
		q_saved_serverflags = value;
	}

	q_have_saved_parms = TRUE;
}

U0 QGameClearParms()
{//Drop any carried inventory so the next spawn is a genuine fresh start.
 //A death restart must NOT hand the player back the items they died with.
	q_have_saved_parms = FALSE;
}

U0 QGameRestoreParms()
{//Push the carried inventory back into the freshly loaded bytecode, before
 //the player spawns. ClientConnect reads these to rebuild the loadout.
	I64	ofs;
	I64	i;

	if (!q_have_saved_parms)
		return;

	for (i = 0; i < QGAME_MAX_PARMS; i++)
	{
		ofs = q_ofs_parms[i];
		if (ofs >= 0)
			QPrSetF(ofs, q_saved_parms[i]);
	}

	if (q_ofs_serverflags >= 0)
		QPrSetF(q_ofs_serverflags, q_saved_serverflags);
}

Bool QGameInit(CQMap *map, Bool spawn_entities = TRUE)
{//Load the bytecode, wire the builtins, and populate the world.
 //
 //spawn_entities is FALSE when a savegame is about to supply the entity state:
 //the bytecode and builtins still have to come up, but running the spawn
 //functions would build a fresh world that the restore then has to overwrite -
 //and any side effects they had (precaches aside) would linger.
	I64 fn;
	I64 i;
	I64 ent;

	q_game_active  = FALSE;
	q_game_time    = 1.0;		//QuakeC treats time 0 as "never scheduled"
	q_game_thinks  = 0;
	q_game_spawned = 0;

	if (!QPrLoad("progs.dat", QGAME_MAX_EDICTS))
		return FALSE;

	QPrCacheOffsets;
	QBiInit;
	q_bi_map = map;

	//Before any spawn function runs: slot 1 = world, 2..N = its submodels.
	QBiPrecacheWorld(map, q_map_name);

	//Required symbols. Without these the image is not stock QuakeC and
	//running it would fault in confusing ways.
	if (q_ofs_self < 0 || q_ofs_time < 0 || q_fld_nextthink < 0 ||
		q_fld_think < 0)
	{
		"QGame: progs.dat is missing required symbols\n";
		return FALSE;
	}

	QPrSetF(q_ofs_time, q_game_time);
	QPrSetF(q_ofs_frametime, QGAME_FRAME_TIME);

	//RESERVE EVERY CLIENT EDICT BEFORE ANY MAP ENTITY SPAWNS.
	//
	//SV_SpawnServer does:
	//    sv.num_edicts = svs.maxclients + 1;
	//    for (i = 0; i < svs.maxclients; i++)
	//        svs.clients[i].edict = EDICT_NUM(i + 1);
	//so clients are always edicts 1..maxclients and map entities start after
	//them. That is not decoration: .colormap is the edict number, and a client
	//uses it as cl.scores[colormap - 1], so a player living at edict 11 with
	//maxclients 4 is not representable on the wire at all.
	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		ent = QPrSpawnEdict;

		if (i == 0)
			q_player_edict = ent;
	}

	//Inventory carried in from the previous level, restored before anything
	//spawns so worldspawn and ClientConnect both see it.
	QGameRestoreParms;

	//main() is a no-op in stock QuakeC but is called for completeness.
	fn = QPrFindFunction("main");
	if (fn > 0)
	{
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	if (spawn_entities)
		q_game_spawned = QGameSpawnEntities(map);
	else
	{
		//A savegame still needs the precache lists, which the spawn functions
		//would normally build. They are restored from the file instead.
		q_game_spawned = 0;
	}

	//The world must never be damageable. QuakeC relies on that to bail out of
	//T_Damage early; if it ever gets through, the world is "killed", and since
	//entity 0 has no death function that surfaces as a null-function call on
	//every hit. Enforcing the invariant here is cheap and matches what the
	//original guarantees by construction.
	QPrSetFieldF(0, q_fld_takedamage, 0.0);
	QPrSetFieldF(0, q_fld_health, 0.0);
	QPrSetFieldF(0, q_fld_solid, ToF64(QSOLID_BSP_));

	q_game_active  = TRUE;

	"QGame: %d entities spawned, %d edicts live\n",
		q_game_spawned, q_pr_num_edicts;

	return TRUE;
}

U0 QGameShutdown()
{
	q_game_active = FALSE;
	q_bi_map      = NULL;

	//Per-map state, all of which points at things about to be freed or refers
	//to entities that will not exist in the next map.
	//Breadcrumbed for the same reason the outer teardown is: a fault in any of
	//these lands inside the allocator, where the backtrace names Free and
	//nothing else. The last line written identifies the step.
	QLog("  shutdown: statics\n");	QLogFlush;
	QBiStaticClear;
	QBiBeamsClear;
	QBiIntermissionClear;
	QBiCenterClear;

	QLog("  shutdown: lights/ambients\n");	QLogFlush;
	QDlightClear;
	QSndAmbientClear;
	QLightInit;

	QLog("  shutdown: precache\n");	QLogFlush;
	QBiFreePrecache;

	QLog("  shutdown: bsp models\n");	QLogFlush;
	QBiBspCacheFree;

	QLog("  shutdown: progs\n");	QLogFlush;
	QPrFree;

	QLog("  shutdown: ok\n");	QLogFlush;
}

U0 QGameDrawStatics(CQCanvas *c, CQMap *map)
{//Static entities are not edicts any more, so they are drawn from their own
 //list. Lit from the world like any other model.
	CQStaticEnt	*se;
	F64			 d[3];
	I64			 i;

	for (i = 0; i < q_static_count; i++)
	{
		se = &q_static_ent[i];

		if (!se->mdl)
			goto qds_next;

		QVecSub(se->origin, c->origin, d);
		if (QVecLength(d) > QGAME_STATIC_DIST)
			goto qds_next;

		QMdlDraw(c, se->mdl, se->frame, se->origin, se->angles[1],
			QLightPoint(map, se->origin));

qds_next:
	}
}

//Entity effect flags, from the protocol. QuakeC sets .effects and the client
//turns them into light.
#define QEF_BRIGHTFIELD		1
#define QEF_MUZZLEFLASH		2
#define QEF_BRIGHTLIGHT		4
#define QEF_DIMLIGHT		8

U0 QGameEntityLights(F64 time)
{//Turn .effects into dynamic lights, once per frame.
 //
 //A rocket carries its own glow, a firing weapon flashes, and both move, so
 //none of this can come from the compiled lightmap. The lights are re-added
 //every frame with a lifetime of roughly one frame, which is how the original
 //keeps them pinned to a moving entity.
	F64 org[3];
	I64 effects;
	I64 i;
	I64 j;

	if (q_fld_effects < 0)
		return;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qel_next;

		effects = ToI64(QPrFieldF(i, q_fld_effects));
		if (!effects)
			goto qel_next;

		for (j = 0; j < 3; j++)
			org[j] = QPrFieldF(i, q_fld_origin + j);

		if (effects & QEF_MUZZLEFLASH)
		{
			//The flash sits in front of the eye, not at the feet.
			org[2] += 16.0;
			QDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.1, 0.0, time);
			org[2] -= 16.0;

			//The SERVER clears this bit after showing it once, which is what
			//makes it a FLASH. QuakeC only ever sets it - it has no idea when
			//the frame ended - so leaving the clear out means the light never
			//goes away: fire once and the muzzle flash is stuck on for the rest
			//of the level, permanently re-lighting every surface near the
			//player. SV_WriteEntitiesToClient does this in the original.
			QPrSetFieldF(i, q_fld_effects,
				ToF64(effects & ~QEF_MUZZLEFLASH));
		}

		if (effects & QEF_BRIGHTLIGHT)
		{
			org[2] += 16.0;
			QDlightAdd(org, 400.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);
			org[2] -= 16.0;
		}

		if (effects & QEF_DIMLIGHT)
			QDlightAdd(org, 200.0 + ToF64(RandU32 & 31), 0.05, 0.0, time);

qel_next:
	}
}

//QFL_CLIENT is defined with the physics flags above.

#define QPL_MINS_XY		-16.0
#define QPL_MAXS_XY		16.0
#define QPL_MINS_Z		-24.0
#define QPL_MAXS_Z		32.0
#define QPL_VIEW_OFS_Z	22.0

U0 QEdictSetVec(I64 ent, I64 fld, F64 x, F64 y, F64 z)
{
	QPrSetFieldF(ent, fld, x);
	QPrSetFieldF(ent, fld + 1, y);
	QPrSetFieldF(ent, fld + 2, z);
}

Bool QClientSpawnAt(I64 ent, F64 *origin, F64 *angles, U8 *player_name)
{//Outfit ANY edict as a client. The local player is just the first one.
 //
 //Split out of QPlayerSpawn so a second, remote client can be given a body
 //through the identical QuakeC path - SetNewParms, ClientConnect,
 //PutClientInServer - rather than a parallel one that would drift from it.
 //
 //player_name goes into .netname BEFORE ClientConnect so the join bprint
 //shows the setup-page name instead of a blank/default.
	I64  fn;
	U8  *netname;

	if (ent <= 0)
		return FALSE;

	if (!player_name || !player_name[0])
		netname = "player";
	else
		netname = player_name;

	QEdictSetVec(ent, q_fld_origin, origin[0], origin[1], origin[2]);
	QEdictSetVec(ent, q_fld_angles, 0.0, angles[1], 0.0);
	QEdictSetVec(ent, q_fld_v_angle, 0.0, angles[1], 0.0);
	QEdictSetVec(ent, q_fld_velocity, 0.0, 0.0, 0.0);
	QEdictSetVec(ent, q_fld_mins, QPL_MINS_XY, QPL_MINS_XY, QPL_MINS_Z);
	QEdictSetVec(ent, q_fld_maxs, QPL_MAXS_XY, QPL_MAXS_XY, QPL_MAXS_Z);
	QEdictSetVec(ent, q_fld_view_ofs, 0.0, 0.0, QPL_VIEW_OFS_Z);

	QPrSetFieldF(ent, q_fld_flags, ToF64(QFL_CLIENT));
	QPrSetFieldI(ent, q_fld_classname, QPrNewString("player"));
	QPrSetFieldI(ent, q_fld_netname, QPrNewString(netname));

	fn = QPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
		return FALSE;

	QPrSetI(q_ofs_self, QPrEdictValue(ent));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	//PutClientInServer can wipe runtime fields; pin the join name again so
	//later bprints (frags, obituaries) still see it.
	QPrSetFieldI(ent, q_fld_netname, QPrNewString(netname));

	//PutClientInServer picks the spawn point, so the caller adopts what it
	//chose rather than the position it was handed.
	origin[0] = QPrFieldF(ent, q_fld_origin);
	origin[1] = QPrFieldF(ent, q_fld_origin + 1);
	origin[2] = QPrFieldF(ent, q_fld_origin + 2);

	return TRUE;
}

U0 QGameDrawEntities(CQCanvas *c, CQMap *map, F64 *view_origin, F64 max_dist)
{//Draw every live entity that has a model.
	F64		eorg[3];
	F64		eang[3];
	F64		d[3];
	CQMdl	*mdl;
	I64		 i;
	I64		 idx;
	I64		 frame;
	I64		 bm;
	I64		 top;
	I64		 bottom;
	I64		 cmap;
	U8		*name;
	U8		*mstr;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			goto qg_next;

		//Never draw the player's own body in first person. QuakeC gives the
		//client progs/player.mdl so other players and demos can see it, but
		//from inside the head it just wraps the camera in geometry.
		if (i == q_player_edict)
			goto qg_next;

		idx = ToI64(QPrFieldF(i, q_fld_modelindex));
		if (idx <= 0 || idx >= q_precache_model_count)
			goto qg_next;

		//THE MODEL STRING MUST BE CHECKED TOO, not just the index.
		//
		//QuakeC hides a picked-up item with `self.model = string_null`, which
		//leaves .modelindex untouched - only setmodel writes that. Testing the
		//index alone leaves collected powerups and weapons standing in the
		//world. SV_WriteEntitiesToClient rejects on both for this reason:
		//    if (!ent->v.modelindex || !pr_strings[ent->v.model])
		mstr = QPrStr(QPrFieldI(i, q_fld_model));
		if (!mstr || !mstr[0])
			goto qg_next;

		eorg[0] = QPrFieldF(i, q_fld_origin);
		eorg[1] = QPrFieldF(i, q_fld_origin + 1);
		eorg[2] = QPrFieldF(i, q_fld_origin + 2);

		name = q_precache_model[idx];

		//Brush models are part of the map geometry and draw through the face
		//path; only alias models go through the triangle path.
		//
		//The ORIGIN has to go with it. A door's submodel vertices sit where the
		//brush was authored, and opening the door moves the entity away from
		//that spot - so omitting the origin renders every door and platform
		//permanently shut while the logic and collision happily move on
		//without it.
		//
		//Handled BEFORE the distance cull, and deliberately not subject to it.
		//A brush entity's .origin is an OFFSET from where its brushes were
		//authored, not a position - it is usually 0, and e1m1's water lift sits
		//at (0,0,-400) once it parks at the bottom. Measuring that offset
		//against the view culled the lift whenever the player was anywhere but
		//the map origin: the geometry vanished while its collision stayed, so
		//walking into it read as being crushed by something invisible. The
		//original culls these by PVS and frustum, never by distance.
		if (name[0] == '*')
		{
			bm = QClipBrushModel(idx);
			if (bm > 0)
				//.frame on a brush entity selects the alternate texture
				//chain: a button lit while pressed, a door with its lamp on.
				QDrawBrushModel(c, map, bm, eorg,
					ToI64(QPrFieldF(i, q_fld_frame)));
			goto qg_next;
		}

		//An external .bsp (an ammo box, a health box, the exploding crate) is a
		//brush model living in its own file. Its origin IS a real position, so
		//unlike a submodel it is drawn shifted to where the entity stands.
		if (idx > 0 && idx < QBI_MAX_PRECACHE && q_precache_bsp[idx])
		{
			QVecSub(eorg, view_origin, d);
			if (QVecLength(d) > max_dist)
				goto qg_next;

			QDrawBrushModel(c, q_precache_bsp[idx], 0, eorg,
				ToI64(QPrFieldF(i, q_fld_frame)));
			goto qg_next;
		}

		//Alias models ARE point entities, so their origin is a real position and
		//a distance reject is meaningful.
		QVecSub(eorg, view_origin, d);
		if (QVecLength(d) > max_dist)
			goto qg_next;

		eang[0] = QPrFieldF(i, q_fld_angles);
		eang[1] = QPrFieldF(i, q_fld_angles + 1);
		eang[2] = QPrFieldF(i, q_fld_angles + 2);

		if (!StrICompare(name, "progs/player.mdl"))
		{
			cmap = 0;
			if (q_fld_colormap >= 0)
				cmap = ToI64(QPrFieldF(i, q_fld_colormap));

			//.colormap is a client number; the colours live in the scoreboard.
			QSvColorsForColormap(cmap, &top, &bottom);
			mdl = QMdlPreviewGet(top, bottom);
		}
		else
			mdl = q_precache_mdl[idx];

		if (!mdl)
			goto qg_next;

		frame = ToI64(QPrFieldF(i, q_fld_frame));
		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		//Lit from the surface underneath rather than a flat constant, so a
		//monster in shadow renders dark and one under a lamp renders bright.
		QMdlDraw(c, mdl, frame, eorg, eang[1], QLightPoint(map, eorg));

qg_next:
	}
}
