// QPlayer.ZC - the player as a QuakeC client entity.
//
// Until now the player was a camera with collision, invisible to the game
// logic. Nothing could see them, no trigger could fire, no item could be
// picked up. This makes the player a real edict so QuakeC treats them as a
// client:
//
//   spawn   ClientConnect then PutClientInServer, which gives the player
//           health, a weapon and the spawn inventory.
//   frame   push input and position into the edict, run PlayerPreThink, move,
//           run PlayerPostThink, then read back anything QuakeC changed.
//
// Reading state back matters: QuakeC owns health, weapons and teleports, so
// the engine must accept its answer rather than assume it still owns the
// player's position.

//Entity flags and solidity values used by the touch pass. QFL_CLIENT lives in
//QGame.ZC, next to the client spawn that sets it.
#define QFL_ONGROUND	512
#define QFL_WATERJUMP	2048

#define QSOLID_NOT		0
#define QSOLID_TRIGGER	1

#define QDEAD_NO		0

//The player's collision box. These are the sizes hull 1 was expanded by, so
//they must agree with the hull the physics traces against.
Bool q_player_active	= FALSE;
I64	 q_player_touches	= 0;

U0 QPlayerSetVec(I64 fld, F64 x, F64 y, F64 z)
{
	QPrSetFieldF(q_player_edict, fld, x);
	QPrSetFieldF(q_player_edict, fld + 1, y);
	QPrSetFieldF(q_player_edict, fld + 2, z);
}

Bool QPlayerSpawn(F64 *origin, F64 *angles)
{//Hand the reserved edict to QuakeC and let it outfit the player.
	I64 fn;

	q_player_active  = FALSE;
	q_player_touches = 0;

	if (q_player_edict <= 0)
		return FALSE;

	//Minimum state PutClientInServer expects to find already present.
	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_angles, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_velocity, 0.0, 0.0, 0.0);
	QPlayerSetVec(q_fld_mins, QPL_MINS_XY, QPL_MINS_XY, QPL_MINS_Z);
	QPlayerSetVec(q_fld_maxs, QPL_MAXS_XY, QPL_MAXS_XY, QPL_MAXS_Z);
	QPlayerSetVec(q_fld_view_ofs, 0.0, 0.0, QPL_VIEW_OFS_Z);

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(QFL_CLIENT));
	QPrSetFieldI(q_player_edict, q_fld_classname, QPrNewString("player"));
	QPrSetFieldI(q_player_edict, q_fld_netname, QPrNewString("player"));

	//SetNewParms fills the spawn-parameter globals that ClientConnect reads.
	fn = QPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
	{
		"QPlayer: PutClientInServer missing\n";
		return FALSE;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	//PutClientInServer picks a spawn point itself, so the engine adopts the
	//position it chose rather than the one we guessed from the entity list.
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	q_player_active = TRUE;

	//PutClientInServer is what assigns th_die = PlayerDie. If it aborted part
	//way through - and a VM error does abort mid-function - the player has no
	//death function, so dying calls a null function and the death sequence
	//never runs: health goes negative and nothing else happens.
	if (q_fld_th_die >= 0 && !QPrFieldI(q_player_edict, q_fld_th_die))
		QLog("player: WARNING th_die unset, death will not work\n");

	return TRUE;
}

Bool QPlayerBoxTouches(I64 ent, F64 *org)
{//Axis-aligned overlap of the player's box against an entity's absolute box.
	F64 emins[3];
	F64 emaxs[3];
	F64 pmins[3];
	F64 pmaxs[3];
	F64 eorg[3];
	I64 i;

	eorg[0] = QPrFieldF(ent, q_fld_origin);
	eorg[1] = QPrFieldF(ent, q_fld_origin + 1);
	eorg[2] = QPrFieldF(ent, q_fld_origin + 2);

	for (i = 0; i < 3; i++)
	{
		emins[i] = eorg[i] + QPrFieldF(ent, q_fld_mins + i);
		emaxs[i] = eorg[i] + QPrFieldF(ent, q_fld_maxs + i);
	}

	pmins[0] = org[0] + QPL_MINS_XY;
	pmins[1] = org[1] + QPL_MINS_XY;
	pmins[2] = org[2] + QPL_MINS_Z;
	pmaxs[0] = org[0] + QPL_MAXS_XY;
	pmaxs[1] = org[1] + QPL_MAXS_XY;
	pmaxs[2] = org[2] + QPL_MAXS_Z;

	for (i = 0; i < 3; i++)
	{
		if (pmins[i] > emaxs[i] || pmaxs[i] < emins[i])
			return FALSE;
	}

	return TRUE;
}

U0 QPlayerTouchTriggers(F64 *org, F64 *velocity)
{//Fire the touch function of every trigger the player is standing in. This is
 //what opens doors, picks up items and runs teleporters.
	I64 i;
	I64 touch;
	I64 j;

	//Publish the CURRENT position onto the edict before anything is touched.
	//
	//This is the other half of the read-back below, and leaving it out caused
	//the player to be dragged backwards every single step. The sequence was:
	//pre-think copied the origin onto the edict, the engine then MOVED the
	//player, and the read-back after each touch pulled the edict's now-stale
	//origin back over the new one. Any trigger did it - a skill sign or a
	//message, not just a teleporter - because the read-back is unconditional.
	//
	//Writing first also makes the touch tests agree: QuakeC's own box checks
	//read .origin and .absmin/.absmax, so a stale edict would have triggers
	//firing for where the player used to be.
	for (j = 0; j < 3; j++)
	{
		QPrSetFieldF(q_player_edict, q_fld_origin + j, org[j]);
		QPrSetFieldF(q_player_edict, q_fld_velocity + j, velocity[j]);
	}

	QGameLinkEdict(q_player_edict);

	i = 1;
	while (i < q_pr_num_edicts)
	{
		if (!q_pr_edict_free[i] && i != q_player_edict)
		{
			if (QPrFieldF(i, q_fld_solid) == ToF64(QSOLID_TRIGGER))
			{
				touch = QPrFieldI(i, q_fld_touch);

				if (touch > 0 && touch < q_pr_num_functions &&
					QPlayerBoxTouches(i, org))
				{
					//Touch runs on the trigger, with the player as "other".
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, QPrEdictValue(q_player_edict));
					QPrExecute(touch);
					q_pr_error = FALSE;
					q_player_touches++;

					//A touch can MOVE the player - that is exactly what a
					//teleporter is - so the engine must adopt the new position
					//immediately. Without this the post-think pushes the old
					//origin straight back over it, the player is returned to
					//where they started, and the trigger fires again next tick:
					//teleporting endlessly to the same spot.
					//
					//Safe to read unconditionally ONLY because the edict was
					//given the current position above; otherwise this reverts
					//the move that just happened.
					org[0] = QPrFieldF(q_player_edict, q_fld_origin);
					org[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
					org[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

					//Teleporters set a launch velocity as well as a position.
					velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
					velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
					velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

					//A relocation changes the bounds too, so later triggers in
					//this same pass test against the new position.
					QGameLinkEdict(q_player_edict);
				}
			}
		}

		i++;
	}
}

Bool QPlayerWaterJump(F64 *velocity, F64 game_time)
{//Service an in-progress water jump, and report whether one is running.
 //
 //The engine owns the END of a water jump, not just the start. QuakeC sets the
 //flag and an upward velocity; the engine must clear it once the player is out
 //of the liquid or the safety timeout expires, and meanwhile drive the
 //horizontal motion from movedir.
 //
 //Honouring the flag without ever clearing it means gravity is skipped
 //FOREVER - the player rises and never comes down. That is exactly what the
 //flag does when the clearing half is missing.
	I64 flags;

	if (!q_player_active)
		return FALSE;

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));

	if (!(flags & QFL_WATERJUMP))
		return FALSE;

	//Out of the water, or the safety net expired: the jump is over.
	if (QPrFieldF(q_player_edict, q_fld_waterlevel) == 0.0 ||
		game_time > QPrFieldF(q_player_edict, q_fld_teleport_time))
	{
		QPrSetFieldF(q_player_edict, q_fld_flags,
			ToF64(flags & ~QFL_WATERJUMP));
		QPrSetFieldF(q_player_edict, q_fld_teleport_time, 0.0);
		return FALSE;
	}

	//While it runs, the horizontal push comes from movedir - the ledge normal
	//QuakeC recorded when it decided the player could climb out.
	velocity[0] = QPrFieldF(q_player_edict, q_fld_movedir);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_movedir + 1);

	return TRUE;
}

U0 QPlayerWater(I64 level, I64 type)
{//Publish liquid depth. QuakeC keys swimming, drowning, the water-entry
 //splash and the screen tint off these two fields.
	if (!q_player_active)
		return;

	QPrSetFieldF(q_player_edict, q_fld_waterlevel, ToF64(level));
	QPrSetFieldF(q_player_edict, q_fld_watertype, ToF64(type));
}

U0 QPlayerPreThink(F64 *origin, F64 *velocity, F64 *angles, Bool on_ground,
	Bool attack, Bool jump, I64 impulse)
{//Publish the engine's view of the player, then let QuakeC react to it.
	I64 fn;
	I64 flags;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//angles is yaw-only for the body; v_angle carries the full view including
	//pitch, which is what the weapon code aims along.
	QPlayerSetVec(q_fld_angles, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, angles[0], angles[1], angles[2]);

	//CRITICAL: preserve the flags QuakeC owns and only touch the two bits the
	//engine is responsible for. Overwriting the whole field destroys
	//FL_JUMPRELEASED - the bit that stops jump from re-triggering while the
	//key is held - along with FL_INWATER, FL_WATERJUMP and FL_GODMODE.
	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags |= QFL_CLIENT;

	if (on_ground)
		flags |= QFL_ONGROUND;
	else
		flags &= ~QFL_ONGROUND;

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	QPrSetFieldF(q_player_edict, q_fld_button0, ToF64(attack));
	QPrSetFieldF(q_player_edict, q_fld_button2, ToF64(jump));
	//ONLY WHEN NON-ZERO, matching `if (i) ent->v.impulse = i;` in
	//SV_ReadClientMove. ImpulseCommands is what clears the field, and it runs in
	//post-think - so a tick that carries no impulse must leave a pending one
	//alone instead of wiping it. It also means the upstream clc_move path and
	//this one cannot clobber each other.
	if (impulse)
		QPrSetFieldF(q_player_edict, q_fld_impulse, ToF64(impulse));

	fn = QPrFindFunction("PlayerPreThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//CRITICAL: read the velocity back. PlayerPreThink is where PlayerJump
	//runs, and it adds the jump impulse straight onto the entity's velocity.
	//Without this the engine keeps its own stale copy, moves with it, and the
	//post-think push then overwrites the entity - so the jump is applied and
	//discarded within the same tick and the player never leaves the ground.
	velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
	velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

	//QuakeC can also teleport or shove the player during pre-think.
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	//.impulse is DELIBERATELY NOT CLEARED HERE.
	//
	//ImpulseCommands - which is what actually switches weapons and runs the
	//cheats - is reached from PlayerPOSTthink, via W_WeaponFrame. Clearing the
	//field at the end of pre-think wiped every impulse before the only code that
	//reads it ever ran, which is why the number keys, the scroll wheel and
	//`impulse 9` all did nothing.
	//
	//Nor does the original engine clear it: SV_ReadClientMove only ever SETS it
	//from the move message, and ImpulseCommands ends with `self.impulse = 0`
	//once it has acted. The field is written fresh every tick above - with 0
	//when nothing was pressed - so it cannot latch either way.
}

U0 QPlayerPostThink(F64 *origin, F64 *velocity, F64 *angles)
{//Run the post-move logic, then accept whatever QuakeC decided.
	I64  fn;
	F64  fixangle;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	fn = QPrFindFunction("PlayerPostThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//QuakeC owns teleports and knockback, so its position wins.
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
	velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

	//fixangle is how a teleporter tells the engine to snap the view.
	fixangle = QPrFieldF(q_player_edict, q_fld_fixangle);
	if (fixangle != 0.0)
	{
		angles[0] = QPrFieldF(q_player_edict, q_fld_angles);
		angles[1] = QPrFieldF(q_player_edict, q_fld_angles + 1);
		angles[2] = QPrFieldF(q_player_edict, q_fld_angles + 2);
		QPrSetFieldF(q_player_edict, q_fld_fixangle, 0.0);
	}
}

F64 QPlayerHealth()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_health);
}

F64 QPlayerArmor()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_armorvalue);
}

F64 QPlayerAmmo()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_currentammo);
}

F64 QPlayerViewHeight()
{//The eye height QuakeC currently wants. cl.viewheight.
 //
 //This is NOT a constant. QuakeC owns .view_ofs and changes it: PlayerDie sets
 //it to '0 0 -8' so the camera drops to the floor as the body falls, and it
 //moves for crouching in liquid too. Hardcoding 22 meant the view stayed at
 //standing height through the whole death sequence, so dying looked like the
 //player simply stopped rather than collapsing.
	if (!q_player_active || q_player_edict <= 0 || q_fld_view_ofs < 0)
		return QPL_VIEW_OFS_Z;

	return QPrFieldF(q_player_edict, q_fld_view_ofs + 2);
}

Bool QPlayerDead()
{
	if (!q_player_active)
		return FALSE;

	return ToBool(QPrFieldF(q_player_edict, q_fld_deadflag) != ToF64(QDEAD_NO)
		|| QPlayerHealth <= 0.0);
}

Bool QPlayerWalking()
{//TRUE while the player entity is still MOVETYPE_WALK.
 //
 //The engine only owns the player's movement in that state. PlayerDie switches
 //to MOVETYPE_TOSS, and from then on the corpse is an ordinary falling object
 //handled by the entity physics pass - which is exactly how SV_Physics_Client
 //dispatches it.
	if (!q_player_active || q_player_edict <= 0)
		return TRUE;

	return ToBool(ToI64(QPrFieldF(q_player_edict, q_fld_movetype)) ==
		QMOVETYPE_WALK);
}

Bool QPlayerFrozen()
{//TRUE when the engine must ignore movement input entirely.
 //
 //SV_ClientThink returns early on exactly these two conditions, BEFORE it reads
 //the move: a MOVETYPE_NONE player (intermission parks the client that way) and
 //a player at or below zero health. Both have to be honoured here or a corpse
 //walks around under player control.
	I64 movetype;

	if (!q_player_active || q_player_edict <= 0)
		return FALSE;

	movetype = ToI64(QPrFieldF(q_player_edict, q_fld_movetype));
	if (movetype == QMOVETYPE_NONE)
		return TRUE;

	return ToBool(QPlayerHealth <= 0.0);
}

U8 *QPlayerWeaponModel()
{//The view model QuakeC currently wants shown, e.g. "progs/v_shot.mdl".
	I64 s;

	if (!q_player_active)
		return NULL;

	s = QPrFieldI(q_player_edict, q_fld_weaponmodel);
	if (!s)
		return NULL;

	return QPrStr(s);
}

I64 QPlayerWeaponFrame()
{
	if (!q_player_active)
		return 0;

	return ToI64(QPrFieldF(q_player_edict, q_fld_weaponframe));
}
