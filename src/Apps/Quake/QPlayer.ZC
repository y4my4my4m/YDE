// QPlayer.ZC - the player as a QuakeC client entity.
//
// Until now the player was a camera with collision, invisible to the game
// logic. Nothing could see them, no trigger could fire, no item could be
// picked up. This makes the player a real edict so QuakeC treats them as a
// client:
//
//   spawn   ClientConnect then PutClientInServer, which gives the player
//           health, a weapon and the spawn inventory.
//   frame   push input and position into the edict, run PlayerPreThink, move,
//           run PlayerPostThink, then read back anything QuakeC changed.
//
// Reading state back matters: QuakeC owns health, weapons and teleports, so
// the engine must accept its answer rather than assume it still owns the
// player's position.

//Entity flags and solidity values used by the touch pass.
#define QFL_CLIENT		8
#define QFL_ONGROUND	512

#define QSOLID_NOT		0
#define QSOLID_TRIGGER	1

#define QDEAD_NO		0

//The player's collision box. These are the sizes hull 1 was expanded by, so
//they must agree with the hull the physics traces against.
#define QPL_MINS_XY		-16.0
#define QPL_MAXS_XY		16.0
#define QPL_MINS_Z		-24.0
#define QPL_MAXS_Z		32.0
#define QPL_VIEW_OFS_Z	22.0

Bool q_player_active	= FALSE;
I64	 q_player_touches	= 0;

U0 QPlayerSetVec(I64 fld, F64 x, F64 y, F64 z)
{
	QPrSetFieldF(q_player_edict, fld, x);
	QPrSetFieldF(q_player_edict, fld + 1, y);
	QPrSetFieldF(q_player_edict, fld + 2, z);
}

Bool QPlayerSpawn(F64 *origin, F64 *angles)
{//Hand the reserved edict to QuakeC and let it outfit the player.
	I64 fn;

	q_player_active  = FALSE;
	q_player_touches = 0;

	if (q_player_edict <= 0)
		return FALSE;

	//Minimum state PutClientInServer expects to find already present.
	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_angles, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_velocity, 0.0, 0.0, 0.0);
	QPlayerSetVec(q_fld_mins, QPL_MINS_XY, QPL_MINS_XY, QPL_MINS_Z);
	QPlayerSetVec(q_fld_maxs, QPL_MAXS_XY, QPL_MAXS_XY, QPL_MAXS_Z);
	QPlayerSetVec(q_fld_view_ofs, 0.0, 0.0, QPL_VIEW_OFS_Z);

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(QFL_CLIENT));
	QPrSetFieldI(q_player_edict, q_fld_classname, QPrNewString("player"));
	QPrSetFieldI(q_player_edict, q_fld_netname, QPrNewString("player"));

	//SetNewParms fills the spawn-parameter globals that ClientConnect reads.
	fn = QPrFindFunction("SetNewParms");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("ClientConnect");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	fn = QPrFindFunction("PutClientInServer");
	if (fn <= 0)
	{
		"QPlayer: PutClientInServer missing\n";
		return FALSE;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;

	//PutClientInServer picks a spawn point itself, so the engine adopts the
	//position it chose rather than the one we guessed from the entity list.
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	q_player_active = TRUE;

	return TRUE;
}

Bool QPlayerBoxTouches(I64 ent, F64 *org)
{//Axis-aligned overlap of the player's box against an entity's absolute box.
	F64 emins[3];
	F64 emaxs[3];
	F64 pmins[3];
	F64 pmaxs[3];
	F64 eorg[3];
	I64 i;

	eorg[0] = QPrFieldF(ent, q_fld_origin);
	eorg[1] = QPrFieldF(ent, q_fld_origin + 1);
	eorg[2] = QPrFieldF(ent, q_fld_origin + 2);

	for (i = 0; i < 3; i++)
	{
		emins[i] = eorg[i] + QPrFieldF(ent, q_fld_mins + i);
		emaxs[i] = eorg[i] + QPrFieldF(ent, q_fld_maxs + i);
	}

	pmins[0] = org[0] + QPL_MINS_XY;
	pmins[1] = org[1] + QPL_MINS_XY;
	pmins[2] = org[2] + QPL_MINS_Z;
	pmaxs[0] = org[0] + QPL_MAXS_XY;
	pmaxs[1] = org[1] + QPL_MAXS_XY;
	pmaxs[2] = org[2] + QPL_MAXS_Z;

	for (i = 0; i < 3; i++)
	{
		if (pmins[i] > emaxs[i] || pmaxs[i] < emins[i])
			return FALSE;
	}

	return TRUE;
}

U0 QPlayerTouchTriggers(F64 *org)
{//Fire the touch function of every trigger the player is standing in. This is
 //what opens doors, picks up items and runs teleporters.
	I64 i;
	I64 touch;

	i = 1;
	while (i < q_pr_num_edicts)
	{
		if (!q_pr_edict_free[i] && i != q_player_edict)
		{
			if (QPrFieldF(i, q_fld_solid) == ToF64(QSOLID_TRIGGER))
			{
				touch = QPrFieldI(i, q_fld_touch);

				if (touch > 0 && touch < q_pr_num_functions &&
					QPlayerBoxTouches(i, org))
				{
					//Touch runs on the trigger, with the player as "other".
					QPrSetI(q_ofs_self, QPrEdictValue(i));
					QPrSetI(q_ofs_other, QPrEdictValue(q_player_edict));
					QPrExecute(touch);
					q_pr_error = FALSE;
					q_player_touches++;
				}
			}
		}

		i++;
	}
}

U0 QPlayerWater(I64 level, I64 type)
{//Publish liquid depth. QuakeC keys swimming, drowning, the water-entry
 //splash and the screen tint off these two fields.
	if (!q_player_active)
		return;

	QPrSetFieldF(q_player_edict, q_fld_waterlevel, ToF64(level));
	QPrSetFieldF(q_player_edict, q_fld_watertype, ToF64(type));
}

U0 QPlayerPreThink(F64 *origin, F64 *velocity, F64 *angles, Bool on_ground,
	Bool attack, Bool jump, I64 impulse)
{//Publish the engine's view of the player, then let QuakeC react to it.
	I64 fn;
	I64 flags;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	//angles is yaw-only for the body; v_angle carries the full view including
	//pitch, which is what the weapon code aims along.
	QPlayerSetVec(q_fld_angles, 0.0, angles[1], 0.0);
	QPlayerSetVec(q_fld_v_angle, angles[0], angles[1], angles[2]);

	//CRITICAL: preserve the flags QuakeC owns and only touch the two bits the
	//engine is responsible for. Overwriting the whole field destroys
	//FL_JUMPRELEASED - the bit that stops jump from re-triggering while the
	//key is held - along with FL_INWATER, FL_WATERJUMP and FL_GODMODE.
	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags |= QFL_CLIENT;

	if (on_ground)
		flags |= QFL_ONGROUND;
	else
		flags &= ~QFL_ONGROUND;

	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	QPrSetFieldF(q_player_edict, q_fld_button0, ToF64(attack));
	QPrSetFieldF(q_player_edict, q_fld_button2, ToF64(jump));
	QPrSetFieldF(q_player_edict, q_fld_impulse, ToF64(impulse));

	fn = QPrFindFunction("PlayerPreThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//An impulse is a one-shot request; leaving it set would re-trigger the
	//weapon switch on every following frame.
	QPrSetFieldF(q_player_edict, q_fld_impulse, 0.0);
}

U0 QPlayerPostThink(F64 *origin, F64 *velocity, F64 *angles)
{//Run the post-move logic, then accept whatever QuakeC decided.
	I64  fn;
	F64  fixangle;

	if (!q_player_active)
		return;

	QPlayerSetVec(q_fld_origin, origin[0], origin[1], origin[2]);
	QPlayerSetVec(q_fld_velocity, velocity[0], velocity[1], velocity[2]);

	fn = QPrFindFunction("PlayerPostThink");
	if (fn > 0)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(fn);
		q_pr_error = FALSE;
	}

	//QuakeC owns teleports and knockback, so its position wins.
	origin[0] = QPrFieldF(q_player_edict, q_fld_origin);
	origin[1] = QPrFieldF(q_player_edict, q_fld_origin + 1);
	origin[2] = QPrFieldF(q_player_edict, q_fld_origin + 2);

	velocity[0] = QPrFieldF(q_player_edict, q_fld_velocity);
	velocity[1] = QPrFieldF(q_player_edict, q_fld_velocity + 1);
	velocity[2] = QPrFieldF(q_player_edict, q_fld_velocity + 2);

	//fixangle is how a teleporter tells the engine to snap the view.
	fixangle = QPrFieldF(q_player_edict, q_fld_fixangle);
	if (fixangle != 0.0)
	{
		angles[0] = QPrFieldF(q_player_edict, q_fld_angles);
		angles[1] = QPrFieldF(q_player_edict, q_fld_angles + 1);
		angles[2] = QPrFieldF(q_player_edict, q_fld_angles + 2);
		QPrSetFieldF(q_player_edict, q_fld_fixangle, 0.0);
	}
}

F64 QPlayerHealth()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_health);
}

F64 QPlayerArmor()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_armorvalue);
}

F64 QPlayerAmmo()
{
	if (!q_player_active)
		return 0.0;

	return QPrFieldF(q_player_edict, q_fld_currentammo);
}

Bool QPlayerDead()
{
	if (!q_player_active)
		return FALSE;

	return ToBool(QPrFieldF(q_player_edict, q_fld_deadflag) != ToF64(QDEAD_NO)
		|| QPlayerHealth <= 0.0);
}

U8 *QPlayerWeaponModel()
{//The view model QuakeC currently wants shown, e.g. "progs/v_shot.mdl".
	I64 s;

	if (!q_player_active)
		return NULL;

	s = QPrFieldI(q_player_edict, q_fld_weaponmodel);
	if (!s)
		return NULL;

	return QPrStr(s);
}

I64 QPlayerWeaponFrame()
{
	if (!q_player_active)
		return 0;

	return ToI64(QPrFieldF(q_player_edict, q_fld_weaponframe));
}
