// QProgs.ZC - the QuakeC bytecode virtual machine.
//
// progs.dat is a compiled bytecode image: a 60-byte header followed by six
// sections (statements, global defs, field defs, functions, a string blob and
// the global pool). Validated against the shareware image, where every section
// ends exactly where the next begins.
//
// The global pool is an array of 32-BIT cells and that width is load-bearing:
// a vector is three consecutive cells, and QuakeC aliases them (writing
// .origin then reading .origin_x). So the pool is kept as raw 32-bit storage
// and converted to F64 only for arithmetic. Storing it as F64 would silently
// break every vector access.
//
// Entity fields live in one contiguous block with a fixed stride, because the
// bytecode addresses them by byte offset from the start of that block.

#define QPR_VERSION		6

//Reserved global slots the calling convention uses. A return value or a
//parameter is three cells wide so a vector fits without a special case.
#define QPR_OFS_RETURN	1
#define QPR_OFS_PARM0	4
#define QPR_PARM_STRIDE	3
#define QPR_MAX_PARMS	8

#define QPR_MAX_STACK	64		//call frames
#define QPR_MAX_LOCALS	2048	//saved local cells across nested calls
#define QPR_MAX_RUNAWAY	500000	//statements before assuming an infinite loop
#define QPR_SOFT_RUNAWAY	50000	//statements before saying so, without aborting
#define QPR_STRING_HEAP	65536	//room to append map strings after the blob

//Opcodes, in the order the compiler emits them.
#define OP_DONE			0
#define OP_MUL_F		1
#define OP_MUL_V		2
#define OP_MUL_FV		3
#define OP_MUL_VF		4
#define OP_DIV_F		5
#define OP_ADD_F		6
#define OP_ADD_V		7
#define OP_SUB_F		8
#define OP_SUB_V		9
#define OP_EQ_F			10
#define OP_EQ_V			11
#define OP_EQ_S			12
#define OP_EQ_E			13
#define OP_EQ_FNC		14
#define OP_NE_F			15
#define OP_NE_V			16
#define OP_NE_S			17
#define OP_NE_E			18
#define OP_NE_FNC		19
#define OP_LE			20
#define OP_GE			21
#define OP_LT			22
#define OP_GT			23
#define OP_LOAD_F		24
#define OP_LOAD_V		25
#define OP_LOAD_S		26
#define OP_LOAD_ENT		27
#define OP_LOAD_FLD		28
#define OP_LOAD_FNC		29
#define OP_ADDRESS		30
#define OP_STORE_F		31
#define OP_STORE_V		32
#define OP_STORE_S		33
#define OP_STORE_ENT	34
#define OP_STORE_FLD	35
#define OP_STORE_FNC	36
#define OP_STOREP_F		37
#define OP_STOREP_V		38
#define OP_STOREP_S		39
#define OP_STOREP_ENT	40
#define OP_STOREP_FLD	41
#define OP_STOREP_FNC	42
#define OP_RETURN		43
#define OP_NOT_F		44
#define OP_NOT_V		45
#define OP_NOT_S		46
#define OP_NOT_ENT		47
#define OP_NOT_FNC		48
#define OP_IF			49
#define OP_IFNOT		50
#define OP_CALL0		51
#define OP_CALL8		59
#define OP_STATE		60
#define OP_GOTO			61
#define OP_AND			62
#define OP_OR			63
#define OP_BITAND		64
#define OP_BITOR		65

class CQPrStatement
{
	I64	op;
	I64	a;
	I64	b;
	I64	c;
};

class CQPrDef
{
	I64	type;
	I64	ofs;
	I64	name;		//offset into the string blob
};

class CQPrFunction
{
	I64	first_statement;	//negative means it is a builtin, index -n
	I64	parm_start;
	I64	locals;
	I64	name;
	I64	file;
	I64	num_parms;
	U8	parm_size[QPR_MAX_PARMS];
};

class CQPrStack
{
	I64	statement;
	I64	function;
};

//--- loaded image ---
U8				*q_pr_raw			= NULL;
I64				 q_pr_raw_size		= 0;
CQPrStatement	*q_pr_statements	= NULL;
I64				 q_pr_num_statements = 0;
CQPrDef			*q_pr_globaldefs	= NULL;
I64				 q_pr_num_globaldefs = 0;
CQPrDef			*q_pr_fielddefs		= NULL;
I64				 q_pr_num_fielddefs	= 0;
CQPrFunction	*q_pr_functions		= NULL;
I64				 q_pr_num_functions	= 0;
U8				*q_pr_strings		= NULL;	//owned: blob plus a runtime heap
I64				 q_pr_strings_size	= 0;
I64				 q_pr_string_alloc	= 0;	//next free byte in the heap

#define QPR_TEMP_STR_LEN	32

I64				 q_pr_temp_str		= 0;	//reusable scratch for ftos/vtos
U32				*q_pr_globals		= NULL;	//raw 32-bit cells
I64				 q_pr_num_globals	= 0;
I64				 q_pr_entity_fields	= 0;

//--- entities ---
U8	*q_pr_edicts		= NULL;		//contiguous field storage
I64	 q_pr_edict_stride	= 0;		//bytes per entity
I64	 q_pr_max_edicts	= 0;
I64	 q_pr_num_edicts	= 0;
Bool *q_pr_edict_free	= NULL;

//--- execution state ---
CQPrStack	 q_pr_stack[QPR_MAX_STACK];
I64			 q_pr_depth			= 0;
I64			 q_pr_localstack[QPR_MAX_LOCALS];
I64			 q_pr_localdepth	= 0;
I64			 q_pr_xfunction		= 0;
I64			 q_pr_xstatement	= 0;
Bool		 q_pr_trace			= FALSE;
Bool		 q_pr_error			= FALSE;

//Error reporting is RATE LIMITED. These messages fire from inside the
//per-frame execution loop, so an error that repeats every tick prints
//thousands of lines a second; each one allocates a document entry, and the
//console eventually exhausts its heap and faults inside the print path. The
//crash then looks like it comes from somewhere else entirely.
#define QPR_MAX_REPORTS	8
I64	 q_pr_errors	= 0;		//total, including suppressed
I64	 q_pr_reported	= 0;		//how many were actually printed
U8	 q_pr_detail[128];			//scratch for building a diagnostic string

U0 QPrReport2(U8 *msg, U8 *detail)
{//One diagnostic line, printed only while under the cap.
 //
 //Also written to the log: console lines scroll away and the window is torn
 //down on exit, so the log is the only place these survive to be read.
	U8 line[192];

	q_pr_errors++;

	if (q_pr_reported >= QPR_MAX_REPORTS)
		return;

	q_pr_reported++;

	if (detail)
		StrPrint(line, "QProgs: %s (%s)\n", msg, detail);
	else
		StrPrint(line, "QProgs: %s\n", msg);

	QLog(line);

	if (q_pr_reported == QPR_MAX_REPORTS)
		QLog("QProgs: further errors suppressed\n");
}

//Builtins live in a later file, so they are reached through a pointer that is
//installed at init. A direct call would be a forward reference, which this
//single-pass compiler cannot resolve.
U0 (*q_pr_builtin_call)(I64 num) = NULL;

//How many arguments the CALL opcode actually passed - pr_argc in the original.
//Variadic builtins (bprint/sprint/dprint/centerprint) MUST use this: the
//OFS_PARM slots are never cleared between calls, so scanning them until a zero
//turns up prints leftovers from whatever was called before.
I64 q_pr_argc = 0;

//Hot symbol offsets, resolved by name once at load. Looking these up by name
//rather than assuming a struct layout keeps this working across QuakeC builds.
I64 q_ofs_self		= -1;
I64 q_ofs_other		= -1;
I64 q_ofs_world		= -1;
I64 q_ofs_time		= -1;
I64 q_ofs_frametime	= -1;
//Level statistics, shown on the intermission screen.
I64 q_ofs_total_secrets		= -1;
I64 q_ofs_total_monsters	= -1;
I64 q_ofs_found_secrets		= -1;
I64 q_ofs_killed_monsters	= -1;
I64 q_ofs_v_forward	= -1;
I64 q_ofs_v_right	= -1;
I64 q_ofs_v_up		= -1;
I64 q_ofs_force_retouch	= -1;
I64 q_ofs_deathmatch	= -1;
I64 q_ofs_skill			= -1;
I64 q_ofs_coop			= -1;

I64 q_fld_frame		= -1;
I64 q_fld_nextthink	= -1;
I64 q_fld_think		= -1;
I64 q_fld_origin	= -1;
I64 q_fld_angles	= -1;
I64 q_fld_velocity	= -1;
I64 q_fld_model		= -1;
I64 q_fld_modelindex = -1;
I64 q_fld_classname	= -1;
I64 q_fld_mins		= -1;
I64 q_fld_maxs		= -1;
I64 q_fld_size		= -1;
I64 q_fld_solid		= -1;
I64 q_fld_movetype	= -1;
I64 q_fld_flags		= -1;
I64 q_fld_health	= -1;
I64 q_fld_yaw_speed	= -1;
I64 q_fld_ideal_yaw	= -1;
I64 q_fld_enemy		= -1;
I64 q_fld_owner		= -1;
I64 q_fld_goalentity = -1;
I64 q_fld_takedamage = -1;
I64 q_fld_effects	= -1;
I64 q_fld_skin		= -1;
I64 q_fld_colormap	= -1;
I64 q_fld_frags		= -1;	//deathmatch scoreboard
I64 q_fld_ltime		= -1;
I64 q_fld_touch		= -1;
I64 q_fld_use		= -1;
I64 q_fld_blocked	= -1;
I64 q_fld_chain		= -1;	//findradius linked list (T_RadiusDamage walks it)

//Client fields. QuakeC drives the player through these every frame.
I64 q_fld_v_angle		= -1;
I64 q_fld_fixangle		= -1;
I64 q_fld_button0		= -1;
I64 q_fld_button1		= -1;
I64 q_fld_button2		= -1;
I64 q_fld_impulse		= -1;
I64 q_fld_view_ofs		= -1;
I64 q_fld_items			= -1;
I64 q_fld_weapon		= -1;
I64 q_fld_weaponmodel	= -1;
I64 q_fld_weaponframe	= -1;
I64 q_fld_currentammo	= -1;
I64 q_fld_max_health	= -1;
I64 q_fld_deadflag		= -1;
I64 q_fld_netname		= -1;
I64 q_fld_team			= -1;
I64 q_fld_armorvalue	= -1;
I64 q_fld_waterlevel	= -1;
I64 q_fld_watertype		= -1;
I64 q_fld_avelocity		= -1;
I64 q_fld_gravity		= -1;
I64 q_fld_groundentity	= -1;

//Engine-maintained bounds. QuakeC READS these constantly (FireBullets aims
//from absmin_z, T_RadiusDamage and findradius measure with them) but never
//writes them - the server recomputes them whenever an entity moves.
I64 q_fld_absmin		= -1;
I64 q_fld_punchangle	= -1;
I64 q_fld_dmg_take		= -1;
I64 q_fld_dmg_save		= -1;
I64 q_fld_dmg_inflictor	= -1;
I64 q_fld_style		= -1;
I64 q_fld_sounds	= -1;
I64 q_fld_ammo_shells	= -1;
I64 q_fld_ammo_nails	= -1;
I64 q_fld_ammo_rockets	= -1;
I64 q_fld_ammo_cells	= -1;
I64 q_fld_absmax		= -1;
I64 q_fld_movedir		= -1;
I64 q_fld_teleport_time	= -1;
I64 q_fld_th_die		= -1;

//The player's edict. Reserved before map entities spawn so it always lands in
//the client slot QuakeC expects, and read by checkclient so monsters can find
//the player at all.
I64  q_player_edict		= 0;
Bool q_player_active	= FALSE;	//with edict: QNetSv needs both before QPlayer.ZC

//Level transition request. The changelevel builtin cannot tear the world down
//from inside a running think - it would free the bytecode currently
//executing - so it only records the request here and the app services it
//between frames. Declared this early so the builtin layer can set it without
//calling forward into the game layer.
U8	 q_change_map[64];
Bool q_change_pending	= FALSE;

//Offsets of parm1..parm16, resolved once at load. Looking these up by
//building "parm%d" strings inside a loop every level change is both slower
//and more fragile than resolving them here.
#define QPR_MAX_PARM_GLOBALS	16
I64	 q_ofs_parms[QPR_MAX_PARM_GLOBALS];
I64	 q_ofs_serverflags	= -1;

//--- cell access -----------------------------------------------------------
// Every read converts a 32-bit cell up to F64; every write converts back.

F64 QPrGetF(I64 ofs)
{
	U8 tmp[4];
	U32 v;

	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0.0;

	v      = q_pr_globals[ofs];
	tmp[0] = v & 0xFF;
	tmp[1] = (v >> 8) & 0xFF;
	tmp[2] = (v >> 16) & 0xFF;
	tmp[3] = (v >> 24) & 0xFF;

	return QRdF32(tmp);
}

U0 QPrSetF(I64 ofs, F64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = QWrF32(v);
}

I64 QPrGetI(I64 ofs)
{//Cells holding entity numbers, string offsets and function indices are read
 //as integers, not floats.
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return 0;

	return q_pr_globals[ofs];
}

U0 QPrSetI(I64 ofs, I64 v)
{
	if (ofs < 0 || ofs >= q_pr_num_globals)
		return;

	q_pr_globals[ofs] = v & 0xFFFFFFFF;
}

U0 QPrGetV(I64 ofs, F64 *out)
{
	out[0] = QPrGetF(ofs);
	out[1] = QPrGetF(ofs + 1);
	out[2] = QPrGetF(ofs + 2);
}

U0 QPrSetV(I64 ofs, F64 *v)
{
	QPrSetF(ofs, v[0]);
	QPrSetF(ofs + 1, v[1]);
	QPrSetF(ofs + 2, v[2]);
}

U8 *QPrStr(I64 ofs)
{//String values are byte offsets into the blob.
	if (ofs < 0 || ofs >= q_pr_strings_size)
		return "";

	return q_pr_strings + ofs;
}

//--- entity access ---------------------------------------------------------
// Entity values are byte offsets into the edict block, so entity 0 (the world)
// is offset 0 and the bytecode's own pointer arithmetic works unchanged.

I64 QPrEdictNum(I64 ent_value)
{
	if (q_pr_edict_stride <= 0)
		return 0;

	return ent_value / q_pr_edict_stride;
}

I64 QPrEdictValue(I64 num)
{
	return num * q_pr_edict_stride;
}

F64 QPrFieldF(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0.0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0.0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdF32(p);
}

U0 QPrSetFieldF(I64 ent_num, I64 field_ofs, F64 v)
{
	U8	*p;
	U32	 bits;

	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	bits = QWrF32(v);

	p[0] = bits & 0xFF;
	p[1] = (bits >> 8) & 0xFF;
	p[2] = (bits >> 16) & 0xFF;
	p[3] = (bits >> 24) & 0xFF;
}

I64 QPrFieldI(I64 ent_num, I64 field_ofs)
{
	U8 *p;

	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return 0;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return 0;

	p = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;

	return QRdU32(p);
}

U0 QPrSetFieldI(I64 ent_num, I64 field_ofs, I64 v)
{
	U8 *p;

	if (ent_num < 0 || ent_num >= q_pr_max_edicts)
		return;
	if (field_ofs < 0 || field_ofs >= q_pr_entity_fields)
		return;

	p    = q_pr_edicts + ent_num * q_pr_edict_stride + field_ofs * 4;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

//Raw byte-offset access, used by the pointer opcodes.
F64 QPrPtrGetF(I64 byte_ofs)
{
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0.0;

	return QRdF32(q_pr_edicts + byte_ofs);
}

U0 QPrPtrSetI(I64 byte_ofs, I64 v)
{
	U8 *p;

	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return;

	p    = q_pr_edicts + byte_ofs;
	p[0] = v & 0xFF;
	p[1] = (v >> 8) & 0xFF;
	p[2] = (v >> 16) & 0xFF;
	p[3] = (v >> 24) & 0xFF;
}

I64 QPrPtrGetI(I64 byte_ofs)
{
	if (byte_ofs < 0 || byte_ofs + 4 > q_pr_max_edicts * q_pr_edict_stride)
		return 0;

	return QRdU32(q_pr_edicts + byte_ofs);
}

U0 QPrPtrSetF(I64 byte_ofs, F64 v)
{
	QPrPtrSetI(byte_ofs, QWrF32(v));
}

//--- symbol lookup ---------------------------------------------------------
// Looked up by name rather than by hardcoded offset: the layout of the global
// struct is a compiler detail and differs between QuakeC builds.

I64 QPrFindGlobal(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_globaldefs[i].name), name))
			return q_pr_globaldefs[i].ofs;
	}

	return -1;
}

I64 QPrFindField(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		if (!StrCompare(QPrStr(q_pr_fielddefs[i].name), name))
			return q_pr_fielddefs[i].ofs;
	}

	return -1;
}

I64 QPrFindFunction(U8 *name)
{
	I64 i;

	for (i = 0; i < q_pr_num_functions; i++)
	{
		if (!StrCompare(QPrStr(q_pr_functions[i].name), name))
			return i;
	}

	return -1;
}

//--- loading ---------------------------------------------------------------

U0 QPrFree()
{
	if (q_pr_statements)	Free(q_pr_statements);
	if (q_pr_globaldefs)	Free(q_pr_globaldefs);
	if (q_pr_fielddefs)		Free(q_pr_fielddefs);
	if (q_pr_functions)		Free(q_pr_functions);
	if (q_pr_globals)		Free(q_pr_globals);
	if (q_pr_strings)		Free(q_pr_strings);
	if (q_pr_edicts)		Free(q_pr_edicts);
	if (q_pr_edict_free)	Free(q_pr_edict_free);
	if (q_pr_raw)			Free(q_pr_raw);

	q_pr_statements		= NULL;
	q_pr_globaldefs		= NULL;
	q_pr_fielddefs		= NULL;
	q_pr_functions		= NULL;
	q_pr_globals		= NULL;
	q_pr_strings		= NULL;
	q_pr_string_alloc	= 0;
	q_pr_temp_str		= 0;
	q_pr_edicts			= NULL;
	q_pr_edict_free		= NULL;
	q_pr_raw			= NULL;
	q_pr_num_edicts		= 0;
	q_pr_depth			= 0;
	q_pr_localdepth		= 0;
	q_pr_error			= FALSE;
}

Bool QPrLoad(U8 *name, I64 max_edicts)
{
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 ofs_statements;
	I64	 ofs_globaldefs;
	I64	 ofs_fielddefs;
	I64	 ofs_functions;
	I64	 ofs_strings;
	I64	 ofs_globals;
	I64	 i;
	I64	 j;

	QPrFree;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QProgs: %s not found\n", name;
		return FALSE;
	}

	if (size < 60 || QRdI32(d) != QPR_VERSION)
	{
		"QProgs: %s is not a version %d image\n", name, QPR_VERSION;
		Free(d);
		return FALSE;
	}

	q_pr_raw      = d;
	q_pr_raw_size = size;

	ofs_statements       = QRdI32(d + 8);
	q_pr_num_statements  = QRdI32(d + 12);
	ofs_globaldefs       = QRdI32(d + 16);
	q_pr_num_globaldefs  = QRdI32(d + 20);
	ofs_fielddefs        = QRdI32(d + 24);
	q_pr_num_fielddefs   = QRdI32(d + 28);
	ofs_functions        = QRdI32(d + 32);
	q_pr_num_functions   = QRdI32(d + 36);
	ofs_strings          = QRdI32(d + 40);
	q_pr_strings_size    = QRdI32(d + 44);
	ofs_globals          = QRdI32(d + 48);
	q_pr_num_globals     = QRdI32(d + 52);
	q_pr_entity_fields   = QRdI32(d + 56);

	//--- statements: op, then three signed operands ---
	q_pr_statements = CAlloc(q_pr_num_statements * sizeof(CQPrStatement));
	for (i = 0; i < q_pr_num_statements; i++)
	{
		rec = d + ofs_statements + i * 8;
		q_pr_statements[i].op = QRdU16(rec);

		//Signed: jump operands are relative and go backwards for loops.
		q_pr_statements[i].a = QRdI16(rec + 2);
		q_pr_statements[i].b = QRdI16(rec + 4);
		q_pr_statements[i].c = QRdI16(rec + 6);
	}

	//--- defs ---
	q_pr_globaldefs = CAlloc(q_pr_num_globaldefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_globaldefs; i++)
	{
		rec = d + ofs_globaldefs + i * 8;
		q_pr_globaldefs[i].type = QRdU16(rec);
		q_pr_globaldefs[i].ofs  = QRdU16(rec + 2);
		q_pr_globaldefs[i].name = QRdI32(rec + 4);
	}

	q_pr_fielddefs = CAlloc(q_pr_num_fielddefs * sizeof(CQPrDef));
	for (i = 0; i < q_pr_num_fielddefs; i++)
	{
		rec = d + ofs_fielddefs + i * 8;
		q_pr_fielddefs[i].type = QRdU16(rec);
		q_pr_fielddefs[i].ofs  = QRdU16(rec + 2);
		q_pr_fielddefs[i].name = QRdI32(rec + 4);
	}

	//--- functions ---
	q_pr_functions = CAlloc(q_pr_num_functions * sizeof(CQPrFunction));
	for (i = 0; i < q_pr_num_functions; i++)
	{
		rec = d + ofs_functions + i * 36;
		q_pr_functions[i].first_statement = QRdI32(rec);
		q_pr_functions[i].parm_start      = QRdI32(rec + 4);
		q_pr_functions[i].locals          = QRdI32(rec + 8);
		//rec + 12 is a profile counter, unused here.
		q_pr_functions[i].name            = QRdI32(rec + 16);
		q_pr_functions[i].file            = QRdI32(rec + 20);
		q_pr_functions[i].num_parms       = QRdI32(rec + 24);
		for (j = 0; j < QPR_MAX_PARMS; j++)
			q_pr_functions[i].parm_size[j] = rec[28 + j];
	}

	//--- strings ---
	//The blob is copied into a larger owned buffer so map entity values
	//(classnames, targets) can be appended at runtime. QuakeC string values
	//are offsets into this space, so anything handed to the VM must live here.
	q_pr_strings_size = q_pr_strings_size + QPR_STRING_HEAP;
	q_pr_strings      = CAlloc(q_pr_strings_size);
	MemCopy(q_pr_strings, d + ofs_strings, QRdI32(d + 44));
	q_pr_string_alloc = QRdI32(d + 44);

	q_pr_globals = CAlloc(q_pr_num_globals * 4);
	for (i = 0; i < q_pr_num_globals; i++)
		q_pr_globals[i] = QRdU32(d + ofs_globals + i * 4);

	//--- entities ---
	q_pr_edict_stride = q_pr_entity_fields * 4;
	q_pr_max_edicts   = max_edicts;
	q_pr_edicts       = CAlloc(q_pr_max_edicts * q_pr_edict_stride);
	q_pr_edict_free   = CAlloc(q_pr_max_edicts * sizeof(Bool));
	q_pr_num_edicts   = 1;		//entity 0 is always the world

	for (i = 0; i < q_pr_max_edicts; i++)
		q_pr_edict_free[i] = TRUE;
	q_pr_edict_free[0] = FALSE;

	return TRUE;
}

//--- execution -------------------------------------------------------------

U0 QPrChainDump()
{//Print self and the .enemy chain hanging off it.
 //
 //Several QuakeC loops walk a circular .enemy list and stop when they arrive
 //back at where they started - door_fire pairs doors that way. If that list is
 //not actually circular, or does not include the starting entity, the loop
 //never ends. Printing the chain says which of those it is, and whether the
 //links are even being stored.
	U8	line[192];
	I64	self_ent;
	I64	ent;
	I64	i;

	if (q_ofs_self < 0 || q_fld_enemy < 0)
		return;

	self_ent = QPrEdictNum(QPrGetI(q_ofs_self));

	StrPrint(line, "  self=%d (%s) owner=%d enemy=%d\n", self_ent,
		QPrStr(QPrFieldI(self_ent, q_fld_classname)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_owner)),
		QPrEdictNum(QPrFieldI(self_ent, q_fld_enemy)));
	QLog(line);

	//Walk the chain. If it closes back onto self within a few links it is
	//well formed; if it runs to the cap it is either long or genuinely cyclic
	//somewhere that excludes self.
	ent = self_ent;
	for (i = 0; i < 12; i++)
	{
		ent = QPrEdictNum(QPrFieldI(ent, q_fld_enemy));

		StrPrint(line, "    chain[%d] -> %d (%s)\n", i, ent,
			QPrStr(QPrFieldI(ent, q_fld_classname)));
		QLog(line);

		if (ent == 0 || ent == self_ent)
			return;
	}

	QLog("    chain did not close within 12 links\n");
}

U0 QPrStackDump()
{//Print the QuakeC call chain, outermost first. Used when a runaway loop or a
 //bad call aborts execution - the abort site alone rarely identifies the cause.
	U8	line[128];
	I64 i;
	I64 f;

	for (i = 0; i < q_pr_depth; i++)
	{
		f = q_pr_stack[i].function;
		if (f > 0 && f < q_pr_num_functions)
		{
			StrPrint(line, "  stack[%d] %s\n", i,
				QPrStr(q_pr_functions[f].name));
			QLog(line);
		}
	}

	if (q_pr_xfunction > 0 && q_pr_xfunction < q_pr_num_functions)
	{
		StrPrint(line, "  stack[%d] %s <- aborted here\n", q_pr_depth,
			QPrStr(q_pr_functions[q_pr_xfunction].name));
		QLog(line);
	}

	QPrChainDump;
	QLogFlush;
}

U0 QPrEnterFunction(I64 fnum)
{//Push the caller, save the callee's locals, then copy the arguments in.
	CQPrFunction	*f = &q_pr_functions[fnum];
	I64				 i;
	I64				 j;
	I64				 o;
	I64				 c;

	if (q_pr_depth >= QPR_MAX_STACK)
	{
		QPrReport2("call stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	q_pr_stack[q_pr_depth].statement = q_pr_xstatement;
	q_pr_stack[q_pr_depth].function  = q_pr_xfunction;
	q_pr_depth++;

	//QuakeC locals are statically allocated, so recursion works only if the
	//previous occupant of those cells is saved and restored.
	c = f->locals;
	if (q_pr_localdepth + c > QPR_MAX_LOCALS)
	{
		QPrReport2("local stack overflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	for (i = 0; i < c; i++)
	{
		q_pr_localstack[q_pr_localdepth] = QPrGetI(f->parm_start + i);
		q_pr_localdepth++;
	}

	//Arguments arrive in the reserved parameter cells.
	o = f->parm_start;
	for (i = 0; i < f->num_parms; i++)
	{
		for (j = 0; j < f->parm_size[i]; j++)
		{
			QPrSetI(o, QPrGetI(QPR_OFS_PARM0 + i * QPR_PARM_STRIDE + j));
			o++;
		}
	}

	q_pr_xfunction  = fnum;
	q_pr_xstatement = f->first_statement - 1;	//the loop pre-increments
}

U0 QPrLeaveFunction()
{
	CQPrFunction	*f;
	I64				 i;
	I64				 c;

	if (q_pr_depth <= 0)
	{
		QPrReport2("call stack underflow", NULL);
		q_pr_error = TRUE;
		return;
	}

	f = &q_pr_functions[q_pr_xfunction];
	c = f->locals;

	//Restore in reverse: the save loop pushed them forwards.
	for (i = c - 1; i >= 0; i--)
	{
		q_pr_localdepth--;
		QPrSetI(f->parm_start + i, q_pr_localstack[q_pr_localdepth]);
	}

	q_pr_depth--;
	q_pr_xfunction  = q_pr_stack[q_pr_depth].function;
	q_pr_xstatement = q_pr_stack[q_pr_depth].statement;
}

//A single function can be watched by index: every entry logs self and the door
//chain it can see. LinkDoors is the case this exists for - it opens with
//`if (self.enemy) return;`, so a SECOND entry that gets past that guard is
//proof either the think fired twice or the .enemy link never landed, and the
//two are told apart by whether enemy reads back non-zero here.
I64 q_pr_watch_fn		= 0;
I64 q_pr_watch_calls	= 0;
U8  q_pr_watch_line[192];

#define QPR_WATCH_MAX_REPORTS	24

U0 QPrWatchReport(I64 fnum)
{
	if (q_pr_watch_calls >= QPR_WATCH_MAX_REPORTS)
		return;

	q_pr_watch_calls++;

	StrPrint(q_pr_watch_line, "watch: %s entry #%d\n",
		QPrStr(q_pr_functions[fnum].name), q_pr_watch_calls);
	QLog(q_pr_watch_line);
	QPrChainDump;
	QLogFlush;
}

U0 QPrExecute(I64 fnum)
{//Run a QuakeC function to completion.
	CQPrStatement	*st;
	CQPrFunction	*newf;
	F64				 va[3];
	F64				 vb[3];
	F64				 vc[3];
	F64				 fa;
	F64				 fb;
	I64				 exit_depth;
	I64				 entry_local;
	I64				 runaway = 0;
	I64				 op;
	I64				 i;
	I64				 ptr;
	I64				 ent;
	I64				 fld;
	I64				 newfnum;
	I64				 caller;

	if (fnum <= 0 || fnum >= q_pr_num_functions)
		return;

	q_pr_error  = FALSE;
	exit_depth  = q_pr_depth;
	entry_local = q_pr_localdepth;

	//Frame 0 of the stack is whatever q_pr_xfunction happened to hold from the
	//PREVIOUS execution, because EnterFunction pushes the current function
	//before switching. Left stale it shows a bogus outermost frame in every
	//abort dump - which is exactly how a chain of three frames read as four and
	//looked like recursion that was not happening.
	q_pr_xfunction = 0;

	if (q_pr_watch_fn > 0 && fnum == q_pr_watch_fn)
		QPrWatchReport(fnum);

	QPrEnterFunction(fnum);

	while (TRUE)
	{
		runaway++;
		//A loop can stall the frame badly without ever reaching the runaway
		//cap. Reported ONCE per execute at a fraction of the limit, so the
		//"stuck but nothing in the log" case still leaves a trace.
		if (runaway == QPR_SOFT_RUNAWAY)
		{
			QPrReport2("slow execute in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			QPrStackDump;
		}

		if (runaway > QPR_MAX_RUNAWAY)
		{
			QPrReport2("runaway loop in",
				QPrStr(q_pr_functions[q_pr_xfunction].name));

			//Naming the innermost function is not enough to find the cause: a
			//runaway is usually a loop whose exit condition never becomes true,
			//and the loop lives further UP the stack than wherever the counter
			//happened to trip. Dump the whole chain, deepest last.
			QPrStackDump;

			q_pr_error = TRUE;
			goto qpr_abort;
		}

		if (q_pr_error)
			goto qpr_abort;

		q_pr_xstatement++;

		if (q_pr_xstatement < 0 || q_pr_xstatement >= q_pr_num_statements)
		{
			QPrReport2("statement out of range",
				QPrStr(q_pr_functions[q_pr_xfunction].name));
			q_pr_error = TRUE;
			goto qpr_abort;
		}

		st = &q_pr_statements[q_pr_xstatement];
		op = st->op;

		switch (op)
		{
			case OP_DONE:
			case OP_RETURN:
				//A bare DONE returns nothing; the operand cells are safe to
				//copy regardless because they are always in range.
				QPrSetI(QPR_OFS_RETURN, QPrGetI(st->a));
				QPrSetI(QPR_OFS_RETURN + 1, QPrGetI(st->a + 1));
				QPrSetI(QPR_OFS_RETURN + 2, QPrGetI(st->a + 2));

				QPrLeaveFunction;
				if (q_pr_depth == exit_depth)
					return;
				break;

			//--- arithmetic ---
			case OP_MUL_F:
				QPrSetF(st->c, QPrGetF(st->a) * QPrGetF(st->b));
				break;
			case OP_MUL_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, va[0] * vb[0] + va[1] * vb[1] + va[2] * vb[2]);
				break;
			case OP_MUL_FV:
				fa = QPrGetF(st->a);
				QPrGetV(st->b, vb);
				QVecScale(vb, fa, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_MUL_VF:
				QPrGetV(st->a, va);
				fb = QPrGetF(st->b);
				QVecScale(va, fb, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_DIV_F:
				fb = QPrGetF(st->b);
				if (fb == 0.0)
					QPrSetF(st->c, 0.0);
				else
					QPrSetF(st->c, QPrGetF(st->a) / fb);
				break;
			case OP_ADD_F:
				QPrSetF(st->c, QPrGetF(st->a) + QPrGetF(st->b));
				break;
			case OP_ADD_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QVecAdd(va, vb, vc);
				QPrSetV(st->c, vc);
				break;
			case OP_SUB_F:
				QPrSetF(st->c, QPrGetF(st->a) - QPrGetF(st->b));
				break;
			case OP_SUB_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QVecSub(va, vb, vc);
				QPrSetV(st->c, vc);
				break;

			//--- comparison ---
			case OP_EQ_F:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) == QPrGetF(st->b)));
				break;
			case OP_EQ_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] == vb[0] && va[1] == vb[1] &&
					va[2] == vb[2]));
				break;
			case OP_EQ_S:
				QPrSetF(st->c, ToF64(!StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b)))));
				break;
			case OP_EQ_E:
			case OP_EQ_FNC:
				QPrSetF(st->c, ToF64(QPrGetI(st->a) == QPrGetI(st->b)));
				break;
			case OP_NE_F:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) != QPrGetF(st->b)));
				break;
			case OP_NE_V:
				QPrGetV(st->a, va);
				QPrGetV(st->b, vb);
				QPrSetF(st->c, ToF64(va[0] != vb[0] || va[1] != vb[1] ||
					va[2] != vb[2]));
				break;
			case OP_NE_S:
				QPrSetF(st->c, ToF64(ToBool(StrCompare(QPrStr(QPrGetI(st->a)),
					QPrStr(QPrGetI(st->b))))));
				break;
			case OP_NE_E:
			case OP_NE_FNC:
				QPrSetF(st->c, ToF64(QPrGetI(st->a) != QPrGetI(st->b)));
				break;
			case OP_LE:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) <= QPrGetF(st->b)));
				break;
			case OP_GE:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) >= QPrGetF(st->b)));
				break;
			case OP_LT:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) < QPrGetF(st->b)));
				break;
			case OP_GT:
				QPrSetF(st->c, ToF64(QPrGetF(st->a) > QPrGetF(st->b)));
				break;

			//--- field loads: a is the entity, b the field index ---
			case OP_LOAD_F:
			case OP_LOAD_S:
			case OP_LOAD_ENT:
			case OP_LOAD_FLD:
			case OP_LOAD_FNC:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				break;
			case OP_LOAD_V:
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, QPrFieldI(ent, fld));
				QPrSetI(st->c + 1, QPrFieldI(ent, fld + 1));
				QPrSetI(st->c + 2, QPrFieldI(ent, fld + 2));
				break;

			case OP_ADDRESS:
				//Produces a byte offset into the edict block.
				ent = QPrEdictNum(QPrGetI(st->a));
				fld = QPrGetI(st->b);
				QPrSetI(st->c, ent * q_pr_edict_stride + fld * 4);
				break;

			//--- global stores ---
			case OP_STORE_F:
			case OP_STORE_S:
			case OP_STORE_ENT:
			case OP_STORE_FLD:
			case OP_STORE_FNC:
				QPrSetI(st->b, QPrGetI(st->a));
				break;
			case OP_STORE_V:
				QPrSetI(st->b, QPrGetI(st->a));
				QPrSetI(st->b + 1, QPrGetI(st->a + 1));
				QPrSetI(st->b + 2, QPrGetI(st->a + 2));
				break;

			//--- pointer stores ---
			case OP_STOREP_F:
			case OP_STOREP_S:
			case OP_STOREP_ENT:
			case OP_STOREP_FLD:
			case OP_STOREP_FNC:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				break;
			case OP_STOREP_V:
				ptr = QPrGetI(st->b);
				QPrPtrSetI(ptr, QPrGetI(st->a));
				QPrPtrSetI(ptr + 4, QPrGetI(st->a + 1));
				QPrPtrSetI(ptr + 8, QPrGetI(st->a + 2));
				break;

			//--- logic ---
			case OP_NOT_F:
				//Written as an explicit comparison against 0.0, NOT as `!x`.
				//
				//`!` applied to an F64 does not behave like C here, and this
				//one opcode carries an enormous amount of QuakeC logic:
				//  if (!self.yaw_speed) self.yaw_speed = 20;  -> monsters that
				//    can never turn, because the assignment is skipped
				//  if (!targ.takedamage) return;              -> the world
				//    becomes damageable and gets "killed"
				//  if (!self.speed) self.speed = 100;         -> doors with
				//    zero speed, a divide by zero in SUB_CalcMove, and a think
				//    rescheduled at zero delay that locks the frame
				//All three were the same bug.
				if (QPrGetF(st->a) == 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_V:
				QPrGetV(st->a, va);
				if (va[0] == 0.0 && va[1] == 0.0 && va[2] == 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_S:
				//Same reasoning: no `!` on values that came from the pool.
				i = QPrGetI(st->a);
				if (!i)
					QPrSetF(st->c, 1.0);
				else if (QPrStr(i)[0] == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_FNC:
				//`!a->function` in the original: an integer test, matching the
				//way a function reference is stored.
				if (!QPrGetI(st->a))
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_NOT_ENT:
				//Only the world counts as "no entity".
				if (QPrEdictNum(QPrGetI(st->a)) == 0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_AND:
				//ToBool takes an I64, so handing it an F64 passes raw bits
				//rather than converting. Compare against 0.0 directly.
				if (QPrGetF(st->a) != 0.0 && QPrGetF(st->b) != 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_OR:
				if (QPrGetF(st->a) != 0.0 || QPrGetF(st->b) != 0.0)
					QPrSetF(st->c, 1.0);
				else
					QPrSetF(st->c, 0.0);
				break;
			case OP_BITAND:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) &
					ToI64(QPrGetF(st->b))));
				break;
			case OP_BITOR:
				QPrSetF(st->c, ToF64(ToI64(QPrGetF(st->a)) |
					ToI64(QPrGetF(st->b))));
				break;

			//--- flow. Jumps are relative and the loop pre-increments. ---
			//The branch tests read the operand as a RAW INT, not as a float.
			//
			//    case OP_IF:    if (a->_int) ...
			//    case OP_IFNOT: if (!a->_int) ...
			//
			//That distinction is load-bearing and this file has already been
			//burned by it once, in OP_NOT_F. These conditions are handed values
			//of every type - floats from comparisons, but also entity, string
			//and function references, which are stored as small integers. A
			//float test agrees with an int test for most bit patterns but NOT
			//for all of them: negative zero compares equal to 0.0 while its
			//_int is non-zero, and any value the float unit canonicalises on
			//load can shift too.
			//
			//Reading the int is what the original does, costs nothing, and
			//removes the whole class of divergence rather than the one case
			//that happened to be noticed.
			case OP_IF:
				if (QPrGetI(st->a))
					q_pr_xstatement += st->b - 1;
				break;
			case OP_IFNOT:
				if (!QPrGetI(st->a))
					q_pr_xstatement += st->b - 1;
				break;
			case OP_GOTO:
				q_pr_xstatement += st->a - 1;
				break;

			case OP_STATE:
				//Animation step: show frame a now, and run think b one tenth
				//of a second from now. This is what drives every monster and
				//door animation, so it must be exact.
				ent = QPrEdictNum(QPrGetI(q_ofs_self));
				QPrSetFieldF(ent, q_fld_frame, QPrGetF(st->a));
				QPrSetFieldF(ent, q_fld_nextthink, QPrGetF(q_ofs_time) + 0.1);
				QPrSetFieldI(ent, q_fld_think, QPrGetI(st->b));
				break;

			default:
				//--- calls: opcodes CALL0..CALL8 encode the argument count ---
				if (OP_CALL0 <= op <= OP_CALL8)
				{
					newfnum = QPrGetI(st->a);
					if (newfnum <= 0 || newfnum >= q_pr_num_functions)
					{
						//Name the caller AND the entity it was acting on.
						//"Killed" calling a null th_die tells us a death
						//function is missing, but not on what - and the
						//classname is what identifies the culprit.
						//Include the entity NUMBER and its damage state. If the
						//number is genuinely 0 the world really is the target;
						//if it is garbage that merely floors to 0, the fault is
						//a corrupted self rather than a damage-routing bug -
						//and those need opposite fixes.
						//Name the CALLER as well. "Killed" reaching the world
						//with takedamage 0 should be impossible via T_Damage,
						//which gates on exactly that - so knowing who invoked
						//it separates a bad damage path from a bad gate.
						ent = QPrEdictNum(QPrGetI(q_ofs_self));

						if (q_pr_depth > 0)
							caller = q_pr_stack[q_pr_depth - 1].function;
						else
							caller = 0;

						StrPrint(q_pr_detail, "%s<-%s self=%s #%d dmg=%d mt=%d",
							QPrStr(q_pr_functions[q_pr_xfunction].name),
							QPrStr(q_pr_functions[caller].name),
							QPrStr(QPrFieldI(ent, q_fld_classname)),
							ent,
							ToI64(QPrFieldF(ent, q_fld_takedamage)),
							ToI64(QPrFieldF(ent, q_fld_movetype)));

						QPrReport2("call to null function from", q_pr_detail);
						q_pr_error = TRUE;
						goto qpr_abort;
					}

					newf = &q_pr_functions[newfnum];

					if (newf->first_statement < 0)
					{
						//Builtin: the index is the negated first statement.
						q_pr_argc = op - OP_CALL0;

						if (q_pr_builtin_call)
							q_pr_builtin_call(-newf->first_statement);
					}
					else
						QPrEnterFunction(newfnum);
				}
				else
				{
					QPrReport2("unknown opcode in",
						QPrStr(q_pr_functions[q_pr_xfunction].name));
					q_pr_error = TRUE;
					goto qpr_abort;
				}
				break;
		}
	}

qpr_abort:
	//An aborted execution MUST put the stacks back where it found them.
	//Returning without unwinding leaks a call frame per error, and since the
	//callers simply clear the flag and continue, the depth ratchets upward
	//until it hits the ceiling - at which point every later think, touch and
	//builtin fails too. One bad function then looks like the whole VM dying.
	q_pr_depth      = exit_depth;
	q_pr_localdepth = entry_local;
}

I64 QPrTempString(U8 *s)
{//The single reusable scratch string, as PF_ftos/PF_vtos use. Deliberately NOT
 //a fresh heap allocation: ftos is called from loops, and appending every
 //result would exhaust the string heap within a level.
	I64 len;

	if (!q_pr_temp_str)
	{
		if (q_pr_string_alloc + QPR_TEMP_STR_LEN > q_pr_strings_size)
			return 0;

		q_pr_temp_str      = q_pr_string_alloc;
		q_pr_string_alloc += QPR_TEMP_STR_LEN;
	}

	if (!s)
		s = "";

	len = StrLen(s);
	if (len > QPR_TEMP_STR_LEN - 1)
		len = QPR_TEMP_STR_LEN - 1;

	MemCopy(q_pr_strings + q_pr_temp_str, s, len);
	q_pr_strings[q_pr_temp_str + len] = 0;

	return q_pr_temp_str;
}

I64 QPrNewString(U8 *s)
{//Append a runtime string to the heap and return its offset. Used for map
 //entity values, which are not present in the compiled blob.
	I64 len = StrLen(s);
	I64 ofs;

	if (q_pr_string_alloc + len + 1 > q_pr_strings_size)
	{
		QPrReport2("string heap full", NULL);
		return 0;
	}

	ofs = q_pr_string_alloc;
	MemCopy(q_pr_strings + ofs, s, len);
	q_pr_strings[ofs + len] = 0;
	q_pr_string_alloc += len + 1;

	return ofs;
}

