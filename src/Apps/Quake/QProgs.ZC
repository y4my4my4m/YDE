	q_fld_th_die		= QPrFindField("th_die");
	q_fld_ltime			= QPrFindField("ltime");

	//Spawn parameters, resolved by explicit name rather than a built string.
	q_ofs_parms[0]  = QPrFindGlobal("parm1");
	q_ofs_parms[1]  = QPrFindGlobal("parm2");
	q_ofs_parms[2]  = QPrFindGlobal("parm3");
	q_ofs_parms[3]  = QPrFindGlobal("parm4");
	q_ofs_parms[4]  = QPrFindGlobal("parm5");
	q_ofs_parms[5]  = QPrFindGlobal("parm6");
	q_ofs_parms[6]  = QPrFindGlobal("parm7");
	q_ofs_parms[7]  = QPrFindGlobal("parm8");
	q_ofs_parms[8]  = QPrFindGlobal("parm9");
	q_ofs_parms[9]  = QPrFindGlobal("parm10");
	q_ofs_parms[10] = QPrFindGlobal("parm11");
	q_ofs_parms[11] = QPrFindGlobal("parm12");
	q_ofs_parms[12] = QPrFindGlobal("parm13");
	q_ofs_parms[13] = QPrFindGlobal("parm14");
	q_ofs_parms[14] = QPrFindGlobal("parm15");
	q_ofs_parms[15] = QPrFindGlobal("parm16");

	q_ofs_serverflags = QPrFindGlobal("serverflags");
	q_ofs_force_retouch = QPrFindGlobal("force_retouch");
	q_ofs_deathmatch	= QPrFindGlobal("deathmatch");
	q_ofs_skill			= QPrFindGlobal("skill");
	q_ofs_coop			= QPrFindGlobal("coop");

	//Armed on LinkDoors while the "cross connected doors" objerror on e1m1 is
	//being tracked down. e1m1 has exactly two double-door pairs and produces
	//exactly two of those errors, which is what a second LinkDoors entry per
	//master door would produce - and only if the .enemy guard failed to stop it.
	q_pr_watch_fn    = QPrFindFunction("LinkDoors");
	q_pr_watch_calls = 0;
}

I64 QPrSpawnEdict()
{//Reuse a freed slot if there is one, otherwise extend the list.
	I64 i;

	for (i = 1; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
		{
			q_pr_edict_free[i] = FALSE;
			MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);
			return i;
		}
	}

	if (q_pr_num_edicts >= q_pr_max_edicts)
	{
		QPrReport2("out of edicts", NULL);
		return 0;
	}

	i = q_pr_num_edicts;
	q_pr_num_edicts++;
	q_pr_edict_free[i] = FALSE;
	MemSet(q_pr_edicts + i * q_pr_edict_stride, 0, q_pr_edict_stride);

	return i;
}

U0 QPrFreeEdict(I64 num)
{
	if (num <= 0 || num >= q_pr_max_edicts)
		return;

	MemSet(q_pr_edicts + num * q_pr_edict_stride, 0, q_pr_edict_stride);
	q_pr_edict_free[num] = TRUE;
}

U0 QPrReport()
{
	"  version      %d\n", QPR_VERSION;
	"  statements   %6d\n", q_pr_num_statements;
	"  globaldefs   %6d\n", q_pr_num_globaldefs;
	"  fielddefs    %6d\n", q_pr_num_fielddefs;
	"  functions    %6d\n", q_pr_num_functions;
	"  strings      %6d bytes\n", q_pr_strings_size;
	"  globals      %6d cells\n", q_pr_num_globals;
	"  entityfields %6d (stride %d bytes)\n", q_pr_entity_fields,
		q_pr_edict_stride;
}
