// QSound.ZC - WAV loading and sound effects.
//
// The AC97 driver already provides a 4-stream software mixer and a
// fire-and-forget one-shot queue (AudioSFXPlay), so nothing here mixes audio.
// This layer only has to turn a PAK'd WAV into the 48kHz stereo frames that
// mixer expects, and decide how loud it should be.
//
// Format reality of the shareware data: 188 of the 190 sounds are 8-BIT mono
// at 11025Hz, the other two are 16-bit at 22050Hz. Handling only 16-bit (as
// the browser's WAV path does) would play almost nothing, so 8-bit unsigned
// is the important case, not the edge case.
//
// Decoding everything up front would cost about 47MB, so sounds are decoded on
// first use and kept in a bounded cache. Gameplay reuses a small working set,
// so this stays far below the budget in practice.

#define QSND_MAX_CACHE		256
//Storing at native rate cut the footprint by roughly 4x, and the whole
//shareware sound set now fits comfortably. Still bounded, and exceeding it is
//reported rather than silently failing every later load.
#define QSND_CACHE_BUDGET	16777216	//16MB of decoded audio
#define QSND_RATE			48000		//the mixer's fixed output rate
#define QSND_CLIP_DIST		1000.0		//attenuation reaches silence here

//Diagnostics for the "nothing is audible" case.
#define QSND_MAX_REPORTS	64
I64 q_snd_reports	= 0;
I64 q_snd_silent	= 0;
U8  q_snd_line[160];

class CQSound
{
	U8	 name[64];
	U32	*frames;		//stereo L16 | R16 << 16, at the file's OWN rate
	I64	 count;
	I64	 rate;			//samples per second of the stored data
};

CQSound	 q_snd_cache[QSND_MAX_CACHE];
I64		 q_snd_count	= 0;
I64		 q_snd_bytes	= 0;
Bool	 q_snd_enabled	= TRUE;

//Quake's own volume, 0..1. Scales what THIS app mixes; the AC97 master belongs
//to the system and is left alone, so the OS volume still applies on top.
F64		 q_snd_master	= 0.8;
I64		 q_snd_played	= 0;
I64		 q_snd_dropped	= 0;

//Volume scaling needs a copy, since the cached frames are shared and the
//mixer consumes whatever it is handed. Grown on demand, reused every play.

//Where the player is listening from, refreshed each frame by the app.
F64		 q_snd_listener[3];
F64		 q_snd_right[3];		//listener_right, for stereo separation

//--- channels ---------------------------------------------------------------
//
// SND_PickChannel. Quake does NOT simply play every sound that is asked for:
// it keeps eight dynamic channels, and a sound from an entity replaces the one
// already playing on that entity's channel. That is why firing a shotgun fast
// sounds like one weapon rather than a pile of overlapping copies, and why a
// monster cannot drown out the player.
//
// Without it every request took a fresh voice out of the mixer's 24, so the
// same event stacked on itself and got progressively louder and muddier.

#define QSND_DYNAMIC_CHANNELS	8

class CQSndChan
{
	I64	entnum;
	I64	entchannel;
	I64	voice;			//mixer handle, -1 when free
	F64	origin[3];
	F64	master_vol;		//0..1 before distance and pan
	F64	dist_mult;		//attenuation / QSND_CLIP_DIST
	Bool fixed;			//origin is a fixed point, not an entity to follow
};

CQSndChan	q_snd_chan[QSND_DYNAMIC_CHANNELS];
I64			q_snd_viewent = 0;

U0 QSndChannelsClear()
{
	I64 i;

	for (i = 0; i < QSND_DYNAMIC_CHANNELS; i++)
	{
		q_snd_chan[i].entnum     = 0;
		q_snd_chan[i].entchannel = 0;
		q_snd_chan[i].voice      = -1;
		q_snd_chan[i].master_vol = 0.0;
		q_snd_chan[i].dist_mult  = 0.0;
		q_snd_chan[i].fixed      = TRUE;
		QVecSet(q_snd_chan[i].origin, 0.0, 0.0, 0.0);
	}
}

U0 QSndSpatialize(CQSndChan *ch, I64 *_l, I64 *_r)
{//SND_Spatialize: distance attenuation plus left/right separation from the dot
 //with the listener's right vector.
	F64 dir[3];
	F64 dist;
	F64 dot;
	F64 lscale;
	F64 rscale;
	F64 vol;

	vol = ch->master_vol * q_snd_master;

	//Anything coming from the view entity is always full volume and centred -
	//your own weapon must not pan or fade.
	if (ch->entnum == q_snd_viewent && q_snd_viewent != 0)
	{
		*_l = ToI64(vol * ToF64(AUDIO_VOL_UNITY));
		*_r = *_l;
		return;
	}

	QVecSub(ch->origin, q_snd_listener, dir);
	dist = QVecLength(dir);

	if (dist > 0.0001)
	{
		dir[0] /= dist;
		dir[1] /= dist;
		dir[2] /= dist;
	}

	dist = dist * ch->dist_mult;
	dot  = QVecDot(q_snd_right, dir);

	rscale = 1.0 + dot;
	lscale = 1.0 - dot;

	*_l = ToI64(vol * (1.0 - dist) * lscale * ToF64(AUDIO_VOL_UNITY));
	*_r = ToI64(vol * (1.0 - dist) * rscale * ToF64(AUDIO_VOL_UNITY));

	if (*_l < 0)	*_l = 0;
	if (*_r < 0)	*_r = 0;
}

I64 QSndPickChannel(I64 entnum, I64 entchannel)
{//The channel this sound should take, stealing one if need be.
	I64 i;
	I64 first_to_die = -1;

	for (i = 0; i < QSND_DYNAMIC_CHANNELS; i++)
	{
		//Channel 0 (CHAN_AUTO) never overrides anything.
		if (entchannel != 0 && q_snd_chan[i].entnum == entnum &&
			(q_snd_chan[i].entchannel == entchannel || entchannel == -1))
		{
			first_to_die = i;
			break;
		}

		//Free slots first.
		if (!AudioSFXPlaying(q_snd_chan[i].voice))
		{
			first_to_die = i;
			break;
		}

		//Never let another entity's sound take the player's own channel.
		if (q_snd_chan[i].entnum == q_snd_viewent && entnum != q_snd_viewent)
			goto qsp_next;

		if (first_to_die < 0)
			first_to_die = i;

qsp_next:
	}

	if (first_to_die < 0)
		return -1;

	if (AudioSFXPlaying(q_snd_chan[first_to_die].voice))
		AudioSFXStop(q_snd_chan[first_to_die].voice);

	q_snd_chan[first_to_die].voice = -1;

	return first_to_die;
}

U0 QSndUpdate()
{//S_Update: re-aim every live channel as the listener moves. A three second
 //sound started across the room must fade and pan as you walk past it.
	CQSndChan *ch;
	I64 i;
	I64 l;
	I64 r;

	for (i = 0; i < QSND_DYNAMIC_CHANNELS; i++)
	{
		ch = &q_snd_chan[i];

		if (!AudioSFXPlaying(ch->voice))
		{
			ch->voice = -1;
			goto qsu_next;
		}

		QSndSpatialize(ch, &l, &r);
		AudioSFXVoiceVolSet(ch->voice, l, r);

qsu_next:
	}
}

U0 QSndInit()
{//Globals are not zeroed by the JIT, and this table gets walked and freed.
	I64 i;

	for (i = 0; i < QSND_MAX_CACHE; i++)
	{
		q_snd_cache[i].name[0] = 0;
		q_snd_cache[i].frames  = NULL;
		q_snd_cache[i].count   = 0;
	}

	q_snd_count         = 0;
	q_snd_bytes         = 0;
	q_snd_played        = 0;
	q_snd_dropped       = 0;

	QVecSet(q_snd_listener, 0.0, 0.0, 0.0);
	QVecSet(q_snd_right, 0.0, 1.0, 0.0);
	QSndChannelsClear;
}

U0 QSndFree()
{
	I64 i;

	//CRITICAL ORDER: voices reference the cached PCM directly, so every voice
	//must be silenced before any of it is released. AudioSFXStopAll also waits
	//out any mix pass already in flight.
	AudioSFXStopAll;

	for (i = 0; i < QSND_MAX_CACHE; i++)
	{
		if (q_snd_cache[i].frames)
		{
			Free(q_snd_cache[i].frames);
			q_snd_cache[i].frames = NULL;
		}
		q_snd_cache[i].name[0] = 0;
		q_snd_cache[i].count   = 0;
	}

	q_snd_count        = 0;
	q_snd_bytes        = 0;
}

I64 QSndDecodeWav(U8 *raw, I64 size, U32 **_frames, I64 *_rate)
{//RIFF/WAVE -> stereo frames AT THE FILE'S OWN RATE. Returns the frame count,
 //0 on failure. Walks the chunk list rather than assuming a 44-byte header,
 //because some files carry extra chunks before the data.
 //
 //Deliberately does NOT resample. Quake's effects are 11025Hz 8-bit mono, and
 //converting them to 48kHz stereo on load inflates them about SEVENTEEN times -
 //one source byte becomes 4.35 frames of 4 bytes. That exhausted the decoded
 //audio budget after a handful of files, and every sound loaded afterwards
 //failed outright: ambience (precached first) played while every monster,
 //weapon and door sound silently did not.
 //
 //The mixer resamples per voice instead, which is where a real engine does it.
	U8	*p;
	U8	*end;
	U8	*data     = NULL;
	I64	 chunk;
	I64	 channels = 1;
	I64	 rate     = 11025;
	I64	 bits     = 8;
	I64	 dsize    = 0;
	I64	 in_count;
	I64	 out_count;
	I64	 i;
	I64	 src;
	I64	 l;
	I64	 r;
	U32	*out;

	*_frames = NULL;

	if (size < 44 || MemCompare(raw, "RIFF", 4) || MemCompare(raw + 8, "WAVE", 4))
		return 0;

	p   = raw + 12;
	end = raw + size;

	while (p + 8 <= end)
	{
		chunk = QRdU32(p + 4);

		//A truncated final chunk is clamped rather than trusted.
		if (chunk < 0 || p + 8 + chunk > end)
			chunk = end - (p + 8);

		if (!MemCompare(p, "fmt ", 4) && chunk >= 16)
		{
			channels = QRdU16(p + 10);
			rate     = QRdU32(p + 12);
			bits     = QRdU16(p + 22);
		}
		else if (!MemCompare(p, "data", 4))
		{
			data  = p + 8;
			dsize = chunk;
		}

		//Chunks are word aligned, so an odd size carries a pad byte.
		p += 8 + chunk + (chunk & 1);
	}

	if (!data || channels < 1 || rate < 1 || dsize < 1)
		return 0;
	if (bits != 8 && bits != 16)
		return 0;

	if (bits == 8)
		in_count = dsize / channels;
	else
		in_count = dsize / (channels * 2);

	if (in_count < 1)
		return 0;

	out_count = in_count;
	out       = MAlloc(out_count * sizeof(U32));

	for (i = 0; i < out_count; i++)
	{
		src = i;

		if (bits == 8)
		{
			//8-bit WAV is UNSIGNED with 128 as silence.
			l = (data[src * channels] - 128) << 8;
			if (channels > 1)
				r = (data[src * channels + 1] - 128) << 8;
			else
				r = l;
		}
		else
		{
			l = QRdI16(data + src * channels * 2);
			if (channels > 1)
				r = QRdI16(data + (src * channels + 1) * 2);
			else
				r = l;
		}

		out[i] = (l & 0xFFFF) | (r << 16);
	}

	*_frames = out;

	if (_rate)
		*_rate = rate;

	return out_count;
}

CQSound *QSndLoad(U8 *name)
{//Fetch from cache, decoding on first use.
	CQSound	*s;
	U8		*raw;
	U8		 path[128];
	I64		 size   = 0;
	I64		 count;
	I64		 rate;
	U32		*frames = NULL;
	I64		 i;

	for (i = 0; i < q_snd_count; i++)
	{
		if (!StrICompare(q_snd_cache[i].name, name))
		{
			//A cached miss is remembered too, so a missing file is not
			//re-read from the archive on every single play.
			if (!q_snd_cache[i].frames)
				return NULL;
			return &q_snd_cache[i];
		}
	}

	if (q_snd_count >= QSND_MAX_CACHE || q_snd_bytes >= QSND_CACHE_BUDGET)
	{
		//Say so. This used to return NULL indistinguishably from a missing
		//file, so a full cache looked exactly like a decode failure.
		if (q_snd_reports < QSND_MAX_REPORTS)
		{
			q_snd_reports++;
			StrPrint(q_snd_line,
				"snd: CACHE FULL (%d entries, %d bytes) - %s not loaded\n",
				q_snd_count, q_snd_bytes, name);
			QLog(q_snd_line);
		}
		return NULL;
	}

	//QuakeC passes names relative to the sound directory.
	StrPrint(path, "sound/%s", name);

	raw = QPakData(path, &size);
	rate = QSND_RATE;
	if (raw)
		count = QSndDecodeWav(raw, size, &frames, &rate);
	else
		count = 0;

	s = &q_snd_cache[q_snd_count];
	QStrCopy(s->name, name, 64);
	s->frames = frames;
	s->count  = count;
	s->rate   = rate;
	q_snd_count++;

	if (frames)
	{
		q_snd_bytes += count * sizeof(U32);
		return s;
	}

	return NULL;
}

//--- music -----------------------------------------------------------------
//
// Quake's music is CD AUDIO - redbook tracks on the physical disc, not data in
// the PAK. Confirmed rather than assumed: neither PAK0 nor PAK1 contains a
// single music or track entry. So there is nothing to extract, and playing it
// "from the pak anyway" is not possible.
//
// What every modern source port does instead is read the ripped tracks from a
// music directory beside the PAKs, which is what this does:
//
//     ::/Apps/Quake/id1/music/track02.wav ... track11.wav
//
// Track numbering starts at 2 because track 1 on the CD is the data track.
// A map asks for its track through worldspawn's `sounds` field, which the
// server sends as svc_cdtrack - exactly the path the original uses to tell the
// client which track to spin up.
//
// WAV only for now. A pure-ZealC MP3 decoder does exist in Apps/ZealAmp, but it
// is not part of the system image, so depending on it here would make Quake
// fail to compile unless ZealAmp had been loaded first - the same constraint
// the net stack has. Whole-file decoding also makes size matter: a three minute
// 44.1kHz stereo track is over 30MB decoded, so 22050Hz mono is the sensible
// thing to supply.

#define QMUSIC_MAX_BYTES	(48 * 1024 * 1024)

U32		*q_music_frames	= NULL;
I64		 q_music_count	= 0;
I64		 q_music_rate	= QSND_RATE;
I64		 q_music_track	= 0;
Bool	 q_music_playing = FALSE;
I64		 q_music_voice	= -1;		//the voice the track is on, -1 when silent
F64		 q_music_ends	= 0.0;
F64		 q_music_volume	= 0.7;
U8		 q_music_status[64];

U0 QMusicFree()
{
	if (q_music_frames)
		Free(q_music_frames);

	q_music_frames  = NULL;
	q_music_count   = 0;
	q_music_playing = FALSE;
	if (q_music_voice >= 0)
	{
		AudioSFXStop(q_music_voice);
		q_music_voice = -1;
	}
	q_music_track   = 0;
}

Bool QMusicLoad(I64 track)
{//Read and decode one track. FALSE if there is no file for it.
	U8	 path[96];
	U8	*raw;
	I64	 size  = 0;
	I64	 rate  = QSND_RATE;
	U32	*frames = NULL;
	I64	 count;

	QMusicFree;

	StrPrint(path, "::/Apps/Quake/id1/music/track%02d.wav", track);

	raw = FileRead(path, &size);
	if (!raw)
	{
		StrPrint(q_music_status, "no track%02d.wav", track);
		return FALSE;
	}

	count = QSndDecodeWav(raw, size, &frames, &rate);
	Free(raw);

	if (count < 1 || !frames)
	{
		StrPrint(q_music_status, "track%02d.wav undecodable", track);
		return FALSE;
	}

	q_music_frames = frames;
	q_music_count  = count;
	q_music_rate   = rate;
	q_music_track  = track;

	StrPrint(q_music_status, "track%02d %dHz %ds", track, rate,
		count / rate);

	return TRUE;
}

U0 QMusicStart(F64 now)
{//Hand the buffer to a voice and note when it will run out.
	if (!q_music_frames || q_music_count < 1 || !q_snd_enabled)
		return;

	//STOP THE PREVIOUS COPY FIRST. Retriggering without this left the old
	//voice running, so every restart added another overlapping copy of the
	//track until the whole 24 voice pool was music and nothing else could be
	//heard - which is the sound that never stops.
	if (q_music_voice >= 0)
		AudioSFXStop(q_music_voice);

	q_music_voice = AudioSFXPlayRef(q_music_frames, q_music_count, q_music_rate,
		ToI64(q_music_volume * q_snd_master * ToF64(AUDIO_VOL_UNITY)),
		ToI64(q_music_volume * q_snd_master * ToF64(AUDIO_VOL_UNITY)));

	//Kept as a backstop only; whether the voice is still running is the real
	//test, and a predicted end time drifts.
	q_music_ends    = now + ToF64(q_music_count) / ToF64(q_music_rate);
	q_music_playing = TRUE;
}

Bool QMusicPlay(I64 track, F64 now)
{
	if (track < 2)
	{
		QMusicFree;
		return FALSE;
	}

	//Already spinning this one - a level reload should not restart the music,
	//which is what the original's CDAudio_Play does with the same check.
	if (q_music_playing && q_music_track == track)
		return TRUE;

	if (!QMusicLoad(track))
		return FALSE;

	QMusicStart(now);

	return TRUE;
}

U0 QMusicUpdate(F64 now)
{//Retrigger once the track has actually finished. Asking the mixer beats
 //predicting from the length: a prediction that runs early stacks copies, and
 //one that runs late leaves a gap.
	if (!q_music_playing || !q_music_frames)
		return;

	if (q_music_voice >= 0 && AudioSFXPlaying(q_music_voice))
		return;

	QMusicStart(now);
}

U0 QSndPlayAt(U8 *name, F64 *origin, F64 volume, F64 attenuation,
	I64 entnum = 0, I64 entchannel = 0)
{//S_StartSound. entnum/entchannel decide which channel this takes and what it
 //replaces; passing 0 for both means CHAN_AUTO from the world, which never
 //overrides anything.
	CQSound		*s;
	CQSndChan	*ch;
	I64			 chan;
	I64			 vol_l;
	I64			 vol_r;
	F64			 gain;
	I64			 stream;

	if (!q_snd_enabled || !name || !name[0])
		return;

	s = QSndLoad(name);

	//Log the first handful of requests with what became of them. "no monster
	//sounds" has three very different causes - never requested, failed to load,
	//or attenuated to silence - and they need opposite fixes.
	if (q_snd_reports < QSND_MAX_REPORTS)
	{
		q_snd_reports++;

		if (!s || !s->frames || s->count < 1)
			StrPrint(q_snd_line, "snd: %s FAILED TO LOAD\n", name);
		else
			StrPrint(q_snd_line, "snd: %s ok (%d frames)\n", name, s->count);

		QLog(q_snd_line);
	}

	if (!s || !s->frames || s->count < 1)
		return;

	gain = volume;
	if (gain > 1.0)
		gain = 1.0;

	chan = QSndPickChannel(entnum, entchannel);
	if (chan < 0)
	{
		q_snd_dropped++;
		return;
	}

	ch = &q_snd_chan[chan];
	ch->entnum     = entnum;
	ch->entchannel = entchannel;
	ch->master_vol = gain;

	//dist_mult is attenuation over the nominal clip distance, so a sound with
	//attenuation 0 never fades at all - which is how pickups and music work.
	ch->dist_mult = attenuation / QSND_CLIP_DIST;

	if (origin)
		QVecCopy(origin, ch->origin);
	else
	{
		QVecCopy(q_snd_listener, ch->origin);
		ch->dist_mult = 0.0;
	}

	QSndSpatialize(ch, &vol_l, &vol_r);

	//S_StartSound gives up here rather than burning a channel on something
	//nobody can hear.
	if (vol_l <= 0 && vol_r <= 0)
	{
		q_snd_silent++;
		ch->voice = -1;
		return;
	}

	//Played by REFERENCE straight out of the cache, with the volume handed to
	//the mixer instead of baked into a copy.
	//
	//This used to scale every sample into a scratch buffer and hand that over,
	//which meant one full copy of the PCM per play AND a single shared scratch
	//buffer - so only one sound could be in flight through it. The cache never
	//evicts, so the frames stay valid for the life of the map; QSndFree stops
	//all voices before releasing them.
	stream = AudioSFXPlayRef(s->frames, s->count, s->rate, vol_l, vol_r);
	ch->voice = stream;

	//A busy moment drops the sound rather than queueing it. Counted so the cost
	//is visible instead of mysterious.
	if (stream < 0)
	{
		q_snd_dropped++;

		//Name the losers: a dropped sound is indistinguishable from one that
		//was never requested unless it says so.
		if (q_snd_reports < QSND_MAX_REPORTS)
		{
			q_snd_reports++;
			StrPrint(q_snd_line, "snd: %s DROPPED (no free voice)\n", name);
			QLog(q_snd_line);
		}
	}
	else
		q_snd_played++;
}

//--- looping ambient sounds ------------------------------------------------
//
// ambientsound() places a permanent looping source: wind, water, torches. The
// mixer here has only four streams and no loop flag, so a source cannot simply
// be started and left running.
//
// Instead every source is remembered, and each frame the loudest few are
// re-triggered as their previous instance runs out. Deliberately capped well
// below the stream count so gunfire is never starved by ambience.

#define QSND_MAX_AMBIENT	64
//Ambient voices.
//
//This was cut to 1 as a workaround when the mixer had only four buffered
//streams and a two-second ambience loop held one for its whole length. With a
//proper voice bank in the driver that constraint is gone, so ambience can run
//at a useful count again.
#define QSND_AMBIENT_VOICES	3

class CQAmbient
{
	F64	 origin[3];
	U8	 name[64];
	F64	 volume;
	F64	 attenuation;
	F64	 next_time;		//when this source may be re-triggered
	F64	 duration;
};

CQAmbient	q_ambient[QSND_MAX_AMBIENT];
I64			q_ambient_count = 0;

U0 QSndAmbientClear()
{
	q_ambient_count = 0;
}

U0 QSndAmbientAdd(F64 *origin, U8 *name, F64 volume, F64 attenuation)
{//Register a looping source. Called once per ambient entity at map load.
	CQAmbient	*a;
	CQSound		*snd;

	if (q_ambient_count >= QSND_MAX_AMBIENT || !name || !name[0])
		return;

	snd = QSndLoad(name);
	if (!snd || snd->count < 1)
		return;

	a = &q_ambient[q_ambient_count];

	QVecCopy(origin, a->origin);
	QStrCopy(a->name, name, 64);
	a->volume      = volume;
	a->attenuation = attenuation;
	a->next_time   = 0.0;
	a->duration    = ToF64(snd->count) / ToF64(snd->rate);

	//A source shorter than this would re-trigger every few frames and eat the
	//whole mixer, so treat it as at least a reasonable loop length.
	if (a->duration < 0.25)
		a->duration = 0.25;

	q_ambient_count++;
}

U0 QSndAmbientUpdate(F64 time)
{//Keep the nearest ambient sources playing.
	CQAmbient	*a;
	F64			 d[3];
	F64			 dist;
	F64			 gain;
	F64			 best_gain;
	I64			 best;
	I64			 voices;
	I64			 i;
	Bool		 used[QSND_MAX_AMBIENT];

	for (i = 0; i < q_ambient_count; i++)
		used[i] = FALSE;

	for (voices = 0; voices < QSND_AMBIENT_VOICES; voices++)
	{
		best      = -1;
		best_gain = 0.0;

		//Pick the loudest source that is due to be re-triggered.
		for (i = 0; i < q_ambient_count; i++)
		{
			a = &q_ambient[i];

			if (used[i] || time < a->next_time)
				goto qa_next;

			gain = a->volume;

			if (a->attenuation > 0.0)
			{
				QVecSub(a->origin, q_snd_listener, d);
				dist = QVecLength(d);
				gain = gain * (1.0 - dist * a->attenuation / QSND_CLIP_DIST);
			}

			if (gain > best_gain)
			{
				best_gain = gain;
				best      = i;
			}

qa_next:
		}

		if (best < 0)
			return;			//nothing audible is waiting

		a = &q_ambient[best];
		used[best]   = TRUE;
		a->next_time = time + a->duration;

		//Each ambient source is its own "entity" on a fixed channel, so a
		//re-trigger replaces its own previous instance instead of stacking.
		QSndPlayAt(a->name, a->origin, a->volume, a->attenuation,
			-(best + 1), 1);
	}
}

U0 QSndListener(F64 *origin, F64 *right = NULL)
{//S_Update's listener. `right` is what separates left from right - without it
 //every sound sits dead centre no matter where it is.
	QVecCopy(origin, q_snd_listener);

	if (right)
		QVecCopy(right, q_snd_right);
}
