// QPal.ZC - palette and colormap.
//
// Quake renders into an 8bpp buffer and resolves colour at the very end, so
// two tables matter:
//
//   gfx/palette.lmp   768 bytes, 256 RGB triples.
//   gfx/colormap.lmp  64 shade rows of 256 bytes. Row r maps a palette index
//                     to the index that colour becomes at light level r, so
//                     lighting is a table lookup instead of a multiply.
//
// This tree's CDC is truecolor (U32 0x00RRGGBB), so we also precompute the
// palette expanded to 32-bit for the final blit.

#define QPAL_COLORS			256
#define QPAL_SHADES			64
#define QPAL_FULLBRIGHT		224		//indices >= this ignore lighting

U8	 qpal_rgb[QPAL_COLORS * 3];
U32	 qpal_argb[QPAL_COLORS];
U8	*qpal_colormap = NULL;
Bool qpal_loaded = FALSE;

Bool QPalLoad()
{//Pull both tables out of the mounted archives.
	U8  *p;
	I64  size = 0;
	I64  i;

	qpal_loaded   = FALSE;
	qpal_colormap = NULL;

	p = QPakData("gfx/palette.lmp", &size);
	if (!p || size < QPAL_COLORS * 3)
	{
		"QPal: gfx/palette.lmp missing or short\n";
		return FALSE;
	}
	MemCopy(qpal_rgb, p, QPAL_COLORS * 3);

	for (i = 0; i < QPAL_COLORS; i++)
	{
		qpal_argb[i] = (qpal_rgb[i * 3] << 16) |
					   (qpal_rgb[i * 3 + 1] << 8) |
						qpal_rgb[i * 3 + 2];
	}

	p = QPakData("gfx/colormap.lmp", &size);
	if (!p || size < QPAL_COLORS * QPAL_SHADES)
	{
		"QPal: gfx/colormap.lmp missing or short\n";
		return FALSE;
	}

	//Borrowed: the archive stays mounted for the life of the program.
	qpal_colormap = p;
	qpal_loaded   = TRUE;

	return TRUE;
}

U32 QPalColor(I64 index)
{//Palette index -> 0x00RRGGBB for the truecolor framebuffer.
	return qpal_argb[index & 255];
}

//--- screen tint -----------------------------------------------------------
//
// Submerging, taking damage and picking items up all wash the screen with a
// colour. There is no way to blend 8bpp indices - averaging index 10 and 14
// gives an unrelated colour - so the blend is folded into the PALETTE instead,
// which is exactly how the original does it. Rebuilding 256 entries is cheap
// and only happens when the tint actually changes.

I64	 q_tint_r	= 0;
I64	 q_tint_g	= 0;
I64	 q_tint_b	= 0;
I64	 q_tint_a	= 0;		//0 = no tint, 255 = fully the tint colour

U0 QPalSetTint(I64 r, I64 g, I64 b, I64 a)
{
	I64 i;
	I64 sr;
	I64 sg;
	I64 sb;

	a = ClampI64(a, 0, 255);

	//Nothing to do if the wash has not changed since last frame.
	if (r == q_tint_r && g == q_tint_g && b == q_tint_b && a == q_tint_a)
		return;

	q_tint_r = r;
	q_tint_g = g;
	q_tint_b = b;
	q_tint_a = a;

	for (i = 0; i < QPAL_COLORS; i++)
	{
		sr = qpal_rgb[i * 3];
		sg = qpal_rgb[i * 3 + 1];
		sb = qpal_rgb[i * 3 + 2];

		//Linear blend toward the tint colour. Parenthesised against the
		//shift-before-multiply precedence trap.
		sr = sr + ((r - sr) * a) / 255;
		sg = sg + ((g - sg) * a) / 255;
		sb = sb + ((b - sb) * a) / 255;

		qpal_argb[i] = (ClampI64(sr, 0, 255) << 16) |
					   (ClampI64(sg, 0, 255) << 8) |
						ClampI64(sb, 0, 255);
	}
}
