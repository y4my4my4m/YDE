// QPal.ZC - palette and colormap.
//
// Quake renders into an 8bpp buffer and resolves colour at the very end, so
// two tables matter:
//
//   gfx/palette.lmp   768 bytes, 256 RGB triples.
//   gfx/colormap.lmp  64 shade rows of 256 bytes. Row r maps a palette index
//                     to the index that colour becomes at light level r, so
//                     lighting is a table lookup instead of a multiply.
//
// This tree's CDC is truecolor (U32 0x00RRGGBB), so it also precomputes the
// palette expanded to 32-bit for the final blit.

#define QPAL_COLORS			256
#define QPAL_SHADES			64
#define QPAL_FULLBRIGHT		224		//indices >= this ignore lighting

U8	 qpal_rgb[QPAL_COLORS * 3];
U32	 qpal_argb[QPAL_COLORS];
U8	*qpal_colormap = NULL;
Bool qpal_loaded = FALSE;

Bool QPalLoad()
{//Pull both tables out of the mounted archives.
	U8  *p;
	I64  size = 0;
	I64  i;

	qpal_loaded   = FALSE;
	qpal_colormap = NULL;

	p = QPakData("gfx/palette.lmp", &size);
	if (!p || size < QPAL_COLORS * 3)
	{
		"QPal: gfx/palette.lmp missing or short\n";
		return FALSE;
	}
	MemCopy(qpal_rgb, p, QPAL_COLORS * 3);

	for (i = 0; i < QPAL_COLORS; i++)
	{
		qpal_argb[i] = (qpal_rgb[i * 3] << 16) |
					   (qpal_rgb[i * 3 + 1] << 8) |
						qpal_rgb[i * 3 + 2];
	}

	p = QPakData("gfx/colormap.lmp", &size);
	if (!p || size < QPAL_COLORS * QPAL_SHADES)
	{
		"QPal: gfx/colormap.lmp missing or short\n";
		return FALSE;
	}

	//Borrowed: the archive stays mounted for the life of the program.
	qpal_colormap = p;
	qpal_loaded   = TRUE;

	return TRUE;
}

U32 QPalColor(I64 index)
{//Palette index -> 0x00RRGGBB for the truecolor framebuffer.
	return qpal_argb[index & 255];
}

//--- screen tint -----------------------------------------------------------
//
// Submerging, taking damage and picking items up all wash the screen with a
// colour. There is no way to blend 8bpp indices - averaging index 10 and 14
// gives an unrelated colour - so the blend is folded into the PALETTE instead,
// which is exactly how the original does it. Rebuilding 256 entries is cheap
// and only happens when the tint actually changes.

I64	 q_tint_r	= 0;
I64	 q_tint_g	= 0;
I64	 q_tint_b	= 0;
I64	 q_tint_a	= 0;		//0 = no tint, 255 = fully the tint colour

//--- gamma -----------------------------------------------------------------
//
// The original applies gamma by rebuilding the palette it hands the video
// hardware, which is exactly the right place for it here too: every pixel in the
// engine is a palette index, so a ramp on the 256 palette entries costs nothing
// per frame and covers the whole frame including the HUD and menus.
//
// 1.0 is untouched. Lower values brighten (the original's slider works the same
// way round), so the useful span is roughly 0.5 to 1.0.
#define QGAMMA_MIN	0.5
#define QGAMMA_MAX	1.0

F64 q_gamma			= 1.0;
U8	q_gamma_ramp[256];
Bool q_gamma_dirty	= TRUE;

U0 QPalBuildGammaRamp()
{//ramp[v] = 255 * (v/255) ^ gamma
	F64 g = q_gamma;
	F64 v;
	I64 i;

	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	for (i = 0; i < 256; i++)
	{
		if (g == 1.0)
			q_gamma_ramp[i] = i;
		else
		{
			v = Pow(ToF64(i) / 255.0, g) * 255.0;
			q_gamma_ramp[i] = ClampI64(ToI64(v + 0.5), 0, 255);
		}
	}

	q_gamma_dirty = FALSE;
}

U0 QPalRebuild()
{//Recompute the display palette from the current tint and gamma.
	I64 i;
	I64 sr;
	I64 sg;
	I64 sb;
	I64 r = q_tint_r;
	I64 g = q_tint_g;
	I64 b = q_tint_b;
	I64 a = q_tint_a;

	if (q_gamma_dirty)
		QPalBuildGammaRamp;

	for (i = 0; i < QPAL_COLORS; i++)
	{
		sr = qpal_rgb[i * 3];
		sg = qpal_rgb[i * 3 + 1];
		sb = qpal_rgb[i * 3 + 2];

		//Linear blend toward the tint colour. Parenthesised against the
		//shift-before-multiply precedence trap.
		sr = sr + ((r - sr) * a) / 255;
		sg = sg + ((g - sg) * a) / 255;
		sb = sb + ((b - sb) * a) / 255;

		//Gamma last, so it applies to the finished colour rather than being
		//undone by the tint blend.
		sr = q_gamma_ramp[ClampI64(sr, 0, 255)];
		sg = q_gamma_ramp[ClampI64(sg, 0, 255)];
		sb = q_gamma_ramp[ClampI64(sb, 0, 255)];

		qpal_argb[i] = (sr << 16) | (sg << 8) | sb;
	}
}

U0 QPalSetGamma(F64 g)
{
	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	if (g == q_gamma)
		return;

	q_gamma       = g;
	q_gamma_dirty = TRUE;

	//Apply NOW rather than waiting for something else to dirty the palette.
	//The tint is only touched by the in-game water/damage path, so a gamma
	//change made from the menu is otherwise not visible until a map is
	//running - which is exactly where you cannot judge it.
	QPalRebuild;
}

U0 QPalSetTint(I64 r, I64 g, I64 b, I64 a)
{//Set the underwater/damage wash. Rebuilds only when something changed.
	a = ClampI64(a, 0, 255);

	if (r == q_tint_r && g == q_tint_g && b == q_tint_b && a == q_tint_a &&
		!q_gamma_dirty)
		return;

	q_tint_r = r;
	q_tint_g = g;
	q_tint_b = b;
	q_tint_a = a;

	QPalRebuild;
}
