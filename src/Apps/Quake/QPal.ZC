// QPal.ZC - palette and colormap
//
//   gfx/palette.lmp   768 bytes, 256 RGB triples
//   gfx/colormap.lmp  64 shade rows of 256 bytes, row r maps an index to what
//                     that colour becomes at light level r
//
// NOTE: this tree's CDC is truecolor, so the palette is also kept expanded
// to 0x00RRGGBB for the blit

#define QPAL_COLORS			256
#define QPAL_SHADES			64
#define QPAL_FULLBRIGHT		224		//indices >= this ignore lighting

U8	 qpal_rgb[QPAL_COLORS * 3];
U32	 qpal_argb[QPAL_COLORS];
U8	*qpal_colormap = NULL;
Bool qpal_loaded = FALSE;

Bool QPalLoad()
{//pull both tables out of the mounted paks
	U8  *p;
	I64  size = 0;
	I64  i;

	qpal_loaded   = FALSE;
	qpal_colormap = NULL;

	p = QPakData("gfx/palette.lmp", &size);
	if (!p || size < QPAL_COLORS * 3)
	{
		"QPal: gfx/palette.lmp missing or short\n";
		return FALSE;
	}
	MemCopy(qpal_rgb, p, QPAL_COLORS * 3);

	for (i = 0; i < QPAL_COLORS; i++)
	{
		qpal_argb[i] = (qpal_rgb[i * 3] << 16) |
					   (qpal_rgb[i * 3 + 1] << 8) |
						qpal_rgb[i * 3 + 2];
	}

	p = QPakData("gfx/colormap.lmp", &size);
	if (!p || size < QPAL_COLORS * QPAL_SHADES)
	{
		"QPal: gfx/colormap.lmp missing or short\n";
		return FALSE;
	}

	//borrowed, the pak stays mounted for the life of the program
	qpal_colormap = p;
	qpal_loaded   = TRUE;

	return TRUE;
}

U32 QPalColor(I64 index)
{//palette index to 0x00RRGGBB
	return qpal_argb[index & 255];
}

//--- screen tint -----------------------------------------------------------
//
// 8bpp indices can't be blended - averaging index 10 and 14 gives an unrelated
// colour - so the wash is folded into the palette, as the original does

I64	 q_tint_r	= 0;
I64	 q_tint_g	= 0;
I64	 q_tint_b	= 0;
I64	 q_tint_a	= 0;		//0 = no tint, 255 = fully the tint colour

//--- gamma -----------------------------------------------------------------
//
// applied by rebuilding the palette, so it costs nothing per frame and covers
// the HUD and menus too
//
// 1.0 is untouched, lower brightens - same sense as the original's slider
#define QGAMMA_MIN	0.5
#define QGAMMA_MAX	1.0

F64 q_gamma			= 1.0;
U8	q_gamma_ramp[256];
Bool q_gamma_dirty	= TRUE;

U0 QPalBuildGammaRamp()
{//ramp[v] = 255 * (v/255) ^ gamma
	F64 g = q_gamma;
	F64 v;
	I64 i;

	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	for (i = 0; i < 256; i++)
	{
		if (g == 1.0)
			q_gamma_ramp[i] = i;
		else
		{
			v = Pow(ToF64(i) / 255.0, g) * 255.0;
			q_gamma_ramp[i] = ClampI64(ToI64(v + 0.5), 0, 255);
		}
	}

	q_gamma_dirty = FALSE;
}

U0 QPalRebuild()
{//rebuild the display palette from tint and gamma
	I64 i;
	I64 sr;
	I64 sg;
	I64 sb;
	I64 r = q_tint_r;
	I64 g = q_tint_g;
	I64 b = q_tint_b;
	I64 a = q_tint_a;

	if (q_gamma_dirty)
		QPalBuildGammaRamp;

	for (i = 0; i < QPAL_COLORS; i++)
	{
		sr = qpal_rgb[i * 3];
		sg = qpal_rgb[i * 3 + 1];
		sb = qpal_rgb[i * 3 + 2];

		//blend toward the tint, parenthesised against ZealC precedence
		sr = sr + ((r - sr) * a) / 255;
		sg = sg + ((g - sg) * a) / 255;
		sb = sb + ((b - sb) * a) / 255;

		//gamma last, or the tint blend undoes it
		sr = q_gamma_ramp[ClampI64(sr, 0, 255)];
		sg = q_gamma_ramp[ClampI64(sg, 0, 255)];
		sb = q_gamma_ramp[ClampI64(sb, 0, 255)];

		qpal_argb[i] = (sr << 16) | (sg << 8) | sb;
	}
}

U0 QPalSetGamma(F64 g)
{
	if (g < QGAMMA_MIN)	g = QGAMMA_MIN;
	if (g > QGAMMA_MAX)	g = QGAMMA_MAX;

	if (g == q_gamma)
		return;

	q_gamma       = g;
	q_gamma_dirty = TRUE;

	//apply now - only the in-game water/damage path dirties the palette,
	//so a menu gamma change wouldn't show until a map was running
	QPalRebuild;
}

U0 QPalSetTint(I64 r, I64 g, I64 b, I64 a)
{//underwater/damage wash, rebuilds only on change
	a = ClampI64(a, 0, 255);

	if (r == q_tint_r && g == q_tint_g && b == q_tint_b && a == q_tint_a &&
		!q_gamma_dirty)
		return;

	q_tint_r = r;
	q_tint_g = g;
	q_tint_b = b;
	q_tint_a = a;

	QPalRebuild;
}
