// QMDL.ZC - alias model (.mdl) loading and drawing.
//
// Layout, all little-endian, validated against the shareware models:
//   84-byte header ("IDPO", version 6, a scale/translate pair used to unpack
//   vertices, skin size, and the vertex/triangle/frame counts)
//   skins        - either one raw skin_w*skin_h image, or a group of them
//   texcoords    - per vertex: onseam flag, s, t (integers in skin pixels)
//   triangles    - per triangle: faces-front flag, three vertex indices
//   frames       - per frame: bounds, a 16-char name, and one packed vertex
//                  per model vertex
//
// Vertices are stored as three bytes plus a normal index and unpack as
// scale * packed + translate, which is why the header carries those.

#define QMDL_MAGIC		0x4F504449	//"IDPO" little-endian
#define QMDL_VERSION	6
#define QMDL_MAX_TRIS	4096

class CQMdlTexCoord
{
	I64	on_seam;
	I64	s;
	I64	t;
};

class CQMdlTri
{
	I64	faces_front;
	I64	vert[3];
};

class CQMdlFrame
{
	U8	 name[16];
	U8	*verts;		//num_verts * 4 bytes, borrowed from the file buffer
};

class CQMdl
{
	U8				*raw;
	I64				 raw_size;

	F64				 scale[3];
	F64				 translate[3];

	I64				 skin_width;
	I64				 skin_height;
	I64				 num_skins;
	I64				 num_verts;
	I64				 num_tris;
	I64				 num_frames;

	CQMdlTexCoord	*tc;
	CQMdlTri		*tris;
	CQMdlFrame		*frames;

	CQTexture		 skin;		//wraps the first skin for the rasterizer
};

U0 QMdlFree(CQMdl *m)
{
	if (!m)
		return;

	if (m->tc)		Free(m->tc);
	if (m->tris)	Free(m->tris);
	if (m->frames)	Free(m->frames);
	if (m->raw)		Free(m->raw);

	Free(m);
}

CQMdl *QMdlLoad(U8 *name)
{
	CQMdl	*m;
	U8		*d;
	I64		 size = 0;
	I64		 p;
	I64		 i;
	I64		 j;
	I64		 group;
	I64		 sub;
	I64		 skin_bytes;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QMdl: %s not found\n", name;
		return NULL;
	}

	if (size < 84 || QRdU32(d) != QMDL_MAGIC || QRdI32(d + 4) != QMDL_VERSION)
	{
		"QMdl: %s is not an IDPO version 6 model\n", name;
		Free(d);
		return NULL;
	}

	m           = CAlloc(sizeof(CQMdl));
	m->raw      = d;
	m->raw_size = size;

	QRdVec(d + 8, m->scale);
	QRdVec(d + 20, m->translate);

	m->num_skins   = QRdI32(d + 48);
	m->skin_width  = QRdI32(d + 52);
	m->skin_height = QRdI32(d + 56);
	m->num_verts   = QRdI32(d + 60);
	m->num_tris    = QRdI32(d + 64);
	m->num_frames  = QRdI32(d + 68);

	if (m->num_verts <= 0 || m->num_tris <= 0 || m->num_frames <= 0 ||
		m->skin_width <= 0 || m->skin_height <= 0)
	{
		"QMdl: %s has degenerate counts\n", name;
		QMdlFree(m);
		return NULL;
	}

	skin_bytes = m->skin_width * m->skin_height;
	p          = 84;

	//--- skins: keep the first, skip the rest ---
	for (i = 0; i < m->num_skins; i++)
	{
		if (p + 4 > size)
		{
			QMdlFree(m);
			return NULL;
		}

		group = QRdI32(d + p);
		p += 4;

		if (group)
		{
			//Animated skin group: count, then per-skin intervals, then images.
			sub = QRdI32(d + p);
			p += 4 + sub * 4;
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += sub * skin_bytes;
		}
		else
		{
			if (i == 0 && p + skin_bytes <= size)
				m->skin.texels[0] = d + p;
			p += skin_bytes;
		}
	}

	m->skin.width  = m->skin_width;
	m->skin.height = m->skin_height;
	m->skin.clamp  = TRUE;		//skins are not power-of-two and never tile
	QRdName(name, m->skin.name, 16);

	if (!m->skin.texels[0])
	{
		"QMdl: %s has no usable skin\n", name;
		QMdlFree(m);
		return NULL;
	}

	//--- texture coordinates ---
	if (p + m->num_verts * 12 > size)
	{
		QMdlFree(m);
		return NULL;
	}

	m->tc = CAlloc(m->num_verts * sizeof(CQMdlTexCoord));
	for (i = 0; i < m->num_verts; i++)
	{
		m->tc[i].on_seam = QRdI32(d + p);
		m->tc[i].s       = QRdI32(d + p + 4);
		m->tc[i].t       = QRdI32(d + p + 8);
		p += 12;
	}

	//--- triangles ---
	if (p + m->num_tris * 16 > size)
	{
		QMdlFree(m);
		return NULL;
	}

	m->tris = CAlloc(m->num_tris * sizeof(CQMdlTri));
	for (i = 0; i < m->num_tris; i++)
	{
		m->tris[i].faces_front = QRdI32(d + p);
		for (j = 0; j < 3; j++)
			m->tris[i].vert[j] = QRdI32(d + p + 4 + j * 4);
		p += 16;
	}

	//--- frames ---
	m->frames = CAlloc(m->num_frames * sizeof(CQMdlFrame));
	for (i = 0; i < m->num_frames; i++)
	{
		if (p + 4 > size)
			break;

		group = QRdI32(d + p);
		p += 4;

		if (group)
		{
			//Frame group: count, bounds, intervals, then the subframes. Only
			//the first subframe is kept; interpolation comes later.
			sub = QRdI32(d + p);
			p += 4 + 8 + sub * 4;

			if (sub > 0 && p + 24 + m->num_verts * 4 <= size)
			{
				QRdName(d + p + 8, m->frames[i].name, 16);
				m->frames[i].verts = d + p + 24;
			}
			p += sub * (24 + m->num_verts * 4);
		}
		else
		{
			if (p + 24 + m->num_verts * 4 > size)
				break;

			QRdName(d + p + 8, m->frames[i].name, 16);
			m->frames[i].verts = d + p + 24;
			p += 24 + m->num_verts * 4;
		}
	}

	return m;
}

I64 QMdlFrameByName(CQMdl *m, U8 *name)
{//Frames carry names like "axrun1"; returns -1 when absent.
	I64 i;

	for (i = 0; i < m->num_frames; i++)
	{
		if (!StrICompare(m->frames[i].name, name))
			return i;
	}

	return -1;
}

U0 QMdlDrawView(CQCanvas *c, CQMdl *m, I64 frame, F64 fwd, F64 rgt, F64 up,
	F64 scale, I64 light)
{//Draw a first-person weapon model, locked to the screen rather than placed
 //in the world.
 //
 //View models are built in the same axes as world models (x forward, y left,
 //z up) sitting at the origin, so vertices go straight into camera space
 //without any world transform:
 //
 //   camera x (right)   = -model y      (model y points left)
 //   camera y (up)      =  model z
 //   camera z (forward) =  model x
 //
 //Because it sits a few units from the eye, its 1/z is large and it wins the
 //depth test against world geometry naturally - no special-casing needed.
	CQMdlFrame		*fr;
	CQMdlTri		*tri;
	CQPolyVert		 poly[3];
	CQPolyVert		 clipped[QMAX_POLY_VERTS];
	CQScreenVert	 scr[QMAX_POLY_VERTS];
	U8				*vp;
	F64				 local[3];
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr = &m->frames[frame];
	if (!fr->verts)
		return;

	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				//Bailing out here must also skip the draw. Leaving the loop
				//with poly[] half filled would render a triangle built from
				//this triangle's new vertices and the PREVIOUS triangle's
				//stale ones, which smears a long polygon across the screen.
				valid = FALSE;
				break;
			}

			vp       = fr->verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			//Scaling before the offset shrinks the weapon without moving it
			//closer to the eye. That matters: the model extends back past the
			//eye, and geometry sitting near the clip plane projects enormous,
			//which is what makes an unscaled weapon fill the screen.
			poly[j].cam[0] = -local[1] * scale + rgt;
			poly[j].cam[1] =  local[2] * scale + up;
			poly[j].cam[2] =  local[0] * scale + fwd;

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;
		}

		if (!valid)
			goto qvm_next;

		count = QDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
			}

			QDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light);
		}

qvm_next:
	}
}

U0 QMdlDraw(CQCanvas *c, CQMdl *m, I64 frame, F64 *origin, F64 yaw,
	I64 light)
{//Draw one frame at a world position, rotated about the vertical axis.
	CQMdlFrame		*fr;
	CQMdlTri		*tri;
	CQPolyVert		 poly[3];
	CQPolyVert		 clipped[QMAX_POLY_VERTS];
	CQScreenVert	 scr[QMAX_POLY_VERTS];
	U8				*vp;
	F64				 world[3];
	F64				 local[3];
	F64				 rel[3];
	F64				 sy;
	F64				 cy;
	F64				 inv_z;
	F64				 su;
	F64				 tv;
	I64				 count;
	I64				 i;
	I64				 j;
	I64				 vi;
	I64				 half_skin;
	Bool			 valid;

	if (!m || frame < 0 || frame >= m->num_frames)
		return;

	fr = &m->frames[frame];
	if (!fr->verts)
		return;

	sy        = Sin(yaw * QDEG2RAD);
	cy        = Cos(yaw * QDEG2RAD);
	half_skin = m->skin_width / 2;

	for (i = 0; i < m->num_tris; i++)
	{
		tri   = &m->tris[i];
		valid = TRUE;

		for (j = 0; j < 3; j++)
		{
			vi = tri->vert[j];
			if (vi < 0 || vi >= m->num_verts)
			{
				//Must skip the draw as well - see QMdlDrawView.
				valid = FALSE;
				break;
			}

			//Unpack: three bytes scaled and offset by the header's pair.
			vp       = fr->verts + vi * 4;
			local[0] = ToF64(vp[0]) * m->scale[0] + m->translate[0];
			local[1] = ToF64(vp[1]) * m->scale[1] + m->translate[1];
			local[2] = ToF64(vp[2]) * m->scale[2] + m->translate[2];

			//Yaw rotation, then translate into the world.
			world[0] = local[0] * cy - local[1] * sy + origin[0];
			world[1] = local[0] * sy + local[1] * cy + origin[1];
			world[2] = local[2] + origin[2];

			su = ToF64(m->tc[vi].s);
			tv = ToF64(m->tc[vi].t);

			//A back-facing triangle using a seam vertex reads from the right
			//half of the skin; without this the seam column smears.
			if (!tri->faces_front && m->tc[vi].on_seam)
				su += ToF64(half_skin);

			poly[j].s = su;
			poly[j].t = tv;

			QVecSub(world, c->origin, rel);
			poly[j].cam[0] = QVecDot(rel, c->right);
			poly[j].cam[1] = QVecDot(rel, c->up);
			poly[j].cam[2] = QVecDot(rel, c->forward);
		}

		if (!valid)
			goto qm_next;

		count = QDrawClipNear(poly, 3, clipped);
		if (count >= 3)
		{
			for (j = 0; j < count; j++)
			{
				inv_z = 1.0 / clipped[j].cam[2];
				scr[j].x = c->center_x + clipped[j].cam[0] * c->x_scale * inv_z;
				scr[j].y = c->center_y - clipped[j].cam[1] * c->y_scale * inv_z;
				scr[j].inv_z    = inv_z;
				scr[j].s_over_z = clipped[j].s * inv_z;
				scr[j].t_over_z = clipped[j].t * inv_z;
			}

			QDrawPolygon(c, scr, count, &m->skin, NULL, 0, 0, 0.0, 0.0, light);
		}

qm_next:
	}
}
