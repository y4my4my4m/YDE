// QMath.ZC - vector helpers and the view basis.
//
// vectors are plain F64[3] so they live on the stack, no allocation.
// world is x east, y north, z up. angles are (pitch, yaw, roll) degrees,
// pitch positive looking DOWN.
//
// NOTE: pi is a kernel #define, readable but never usable as an identifier

#define QDEG2RAD	(pi / 180.0)

U0 QVecCopy(F64 *src, F64 *dst)
{
	dst[0] = src[0];
	dst[1] = src[1];
	dst[2] = src[2];
}

U0 QVecSet(F64 *v, F64 x, F64 y, F64 z)
{
	v[0] = x;
	v[1] = y;
	v[2] = z;
}

U0 QVecAdd(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[0] + b[0];
	dst[1] = a[1] + b[1];
	dst[2] = a[2] + b[2];
}

U0 QVecSub(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[0] - b[0];
	dst[1] = a[1] - b[1];
	dst[2] = a[2] - b[2];
}

U0 QVecScale(F64 *v, F64 s, F64 *dst)
{
	dst[0] = v[0] * s;
	dst[1] = v[1] * s;
	dst[2] = v[2] * s;
}

U0 QVecMA(F64 *base, F64 s, F64 *dir, F64 *dst)
{//dst = base + s * dir
	dst[0] = base[0] + s * dir[0];
	dst[1] = base[1] + s * dir[1];
	dst[2] = base[2] + s * dir[2];
}

F64 QVecDot(F64 *a, F64 *b)
{
	return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
}

U0 QVecCross(F64 *a, F64 *b, F64 *dst)
{
	dst[0] = a[1] * b[2] - a[2] * b[1];
	dst[1] = a[2] * b[0] - a[0] * b[2];
	dst[2] = a[0] * b[1] - a[1] * b[0];
}

F64 QVecLength(F64 *v)
{
	return Sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
}

F64 QVecNormalize(F64 *v)
{//returns the old length, leaves a zero vector alone
	F64 len = QVecLength(v);
	F64 inv;

	if (len > 0.0)
	{
		inv = 1.0 / len;
		v[0] *= inv;
		v[1] *= inv;
		v[2] *= inv;
	}

	return len;
}

U0 QVecToAngles(F64 *v, F64 *out)
{//vectoangles - direction to (pitch, yaw, roll) degrees.
 //shared by the QuakeC builtin and the beam renderer, which orients
 //lightning segments along the bolt.
	F64 yaw;
	F64 pitch;
	F64 fwd;

	if (v[0] == 0.0 && v[1] == 0.0)
	{
		yaw = 0.0;
		if (v[2] > 0.0)
			pitch = 90.0;
		else
			pitch = 270.0;
	}
	else
	{
		yaw = Arg(v[0], v[1]) / QDEG2RAD;
		if (yaw < 0.0)
			yaw += 360.0;

		fwd   = Sqrt(v[0] * v[0] + v[1] * v[1]);
		pitch = Arg(fwd, v[2]) / QDEG2RAD;
		if (pitch < 0.0)
			pitch += 360.0;
	}

	//pitch first, NOT negated. PF_vectoangles normalises a negative pitch by
	//adding 360, it does not flip the sign - and the alias transform already
	//inverts pitch when it draws. negating here as well cancelled that out and
	//left every model built from a direction vector pitched the wrong way:
	//visible on an enforcer bolt fired up or down, hidden on a level beam
	out[0] = pitch;
	out[1] = yaw;
	out[2] = 0.0;
}

U0 QAngleVectors(F64 *angles, F64 *forward, F64 *right, F64 *up)
{//view basis from (pitch, yaw, roll) degrees, any output may be NULL
	F64 a;
	F64 sp;
	F64 cp;
	F64 sy;
	F64 cy;
	F64 sr;
	F64 cr;

	a  = angles[0] * QDEG2RAD;
	sp = Sin(a);
	cp = Cos(a);

	a  = angles[1] * QDEG2RAD;
	sy = Sin(a);
	cy = Cos(a);

	a  = angles[2] * QDEG2RAD;
	sr = Sin(a);
	cr = Cos(a);

	if (forward)
	{
		forward[0] = cp * cy;
		forward[1] = cp * sy;
		forward[2] = -sp;
	}

	if (right)
	{
		right[0] = -sr * sp * cy + cr * sy;
		right[1] = -sr * sp * sy - cr * cy;
		right[2] = -sr * cp;
	}

	if (up)
	{
		up[0] = cr * sp * cy + sr * sy;
		up[1] = cr * sp * sy - sr * cy;
		up[2] = cr * cp;
	}
}

F64 QAngleNorm(F64 a)
{//fold into [0, 360)
	while (a >= 360.0)
		a -= 360.0;
	while (a < 0.0)
		a += 360.0;

	return a;
}

I64 QBoxOnPlaneSide(F64 *mins, F64 *maxs, F64 *normal, F64 dist)
{//1 = in front, 2 = behind, 3 = straddling.
 //only the two extreme corners along the normal matter, not all eight.
	F64 near_d = 0.0;
	F64 far_d  = 0.0;
	I64 i;
	I64 side   = 0;

	for (i = 0; i < 3; i++)
	{
		if (normal[i] < 0.0)
		{
			far_d  += normal[i] * mins[i];
			near_d += normal[i] * maxs[i];
		}
		else
		{
			far_d  += normal[i] * maxs[i];
			near_d += normal[i] * mins[i];
		}
	}

	if (far_d >= dist)
		side = 1;
	if (near_d < dist)
		side |= 2;

	return side;
}
