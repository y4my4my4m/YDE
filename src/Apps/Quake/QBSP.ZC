// QBSP.ZC - loader for version 29 BSP maps.
//
// The file is a 4-byte version followed by 15 (offset, length) lump pointers.
// Every record is decoded field-by-field into F64-based structs rather than
// being pointed at in place: on-disk vectors are binary32 and ZealC only does
// F64 arithmetic, so an overlay would silently read garbage.
//
// Widening roughly doubles the geometry footprint (e1m1 lands near 2MB of
// structs against a 1.3MB file), which is a fine trade for correctness.

#define QLUMP_ENTITIES		0
#define QLUMP_PLANES		1
#define QLUMP_MIPTEX		2
#define QLUMP_VERTICES		3
#define QLUMP_VISIBILITY	4
#define QLUMP_NODES			5
#define QLUMP_TEXINFO		6
#define QLUMP_FACES			7
#define QLUMP_LIGHTING		8
#define QLUMP_CLIPNODES		9
#define QLUMP_LEAFS			10
#define QLUMP_MARKSURFACES	11
#define QLUMP_EDGES			12
#define QLUMP_SURFEDGES		13
#define QLUMP_MODELS		14
#define QLUMP_COUNT			15

#define QBSP_VERSION		29

//Leaf contents values. Everything except EMPTY is a solid or a fluid volume.
#define QCONTENTS_EMPTY		-1
#define QCONTENTS_SOLID		-2
#define QCONTENTS_WATER		-3
#define QCONTENTS_SLIME		-4
#define QCONTENTS_LAVA		-5
#define QCONTENTS_SKY		-6

class CQPlane
{
	F64	normal[3];
	F64	dist;
	I64	type;		//0-2 = axial on x/y/z, 3+ = general case
};

class CQVertex
{
	F64	pt[3];
};

class CQEdge
{
	I64	v[2];
};

class CQNode
{
	I64	plane_num;
	I64	children[2];	//>= 0 is a node index, < 0 is ~(leaf index)
	F64	mins[3];
	F64	maxs[3];
	I64	first_face;
	I64	num_faces;
};

class CQLeaf
{
	I64	contents;
	I64	vis_offset;		//byte offset into the compressed PVS, -1 if none
	F64	mins[3];
	F64	maxs[3];
	I64	first_marksurface;
	I64	num_marksurfaces;
	U8	ambient[4];
};

class CQClipNode
{//Collision tree. Separate from the render tree: the compiler pre-expands
 //these by the player's bounding box, so collision is a POINT trace through
 //the matching hull rather than a box sweep.
	I64	plane_num;
	I64	children[2];	//>= 0 is a clipnode index, < 0 is a contents value
};

class CQTexInfo
{
	F64	vecs[8];		//two rows of (s.x s.y s.z s.offset)
	I64	miptex;
	I64	flags;
};

class CQFace
{
	I64	plane_num;
	I64	side;			//0 = face is on the plane's front, 1 = back
	I64	first_edge;		//index into the surfedge list
	I64	num_edges;
	I64	tex_info;
	U8	styles[4];
	I64	light_offset;	//byte offset into the lighting lump, -1 if unlit

	//Derived at load time by QBSPCalcSurfaceExtents.
	F64	mins_s;
	F64	mins_t;
	I64	extent_s;
	I64	extent_t;
};

class CQModel
{
	F64	mins[3];
	F64	maxs[3];
	F64	origin[3];
	I64	head_node[4];
	//Root of the SYNTHESISED hull 0, built by QBSPMakeHull0. head_node[0] is a
	//render-node index and must stay that way - the visibility walk and the
	//point-contents lookup both use it as one.
	I64	hull0_head;
	I64	vis_leafs;
	I64	first_face;
	I64	num_faces;
};

class CQTexture
{
	U8	 name[16];
	I64	 width;
	I64	 height;
	U8	*texels[4];		//four mip levels, borrowed from the map buffer

	//World textures are power-of-two and tile, so the rasterizer wraps them
	//with a cheap AND. Model skins are arbitrary sizes (296x194 and the like)
	//and never tile, so they must be clamped instead - masking a non-power-of-
	//two width scrambles the image.
	Bool clamp;

	//Sky textures are 256x128 holding two stacked 128x128 layers, and are
	//drawn by direction from the eye rather than by surface coordinates.
	Bool is_sky;
};

class CQMap
{
	U8			*raw;			//owned copy of the whole file
	I64			 raw_size;

	CQPlane		*planes;
	I64			 num_planes;
	CQVertex	*vertices;
	I64			 num_vertices;
	CQEdge		*edges;
	I64			 num_edges;
	I64			*surfedges;		//signed; negative means traverse the edge backwards
	I64			 num_surfedges;
	CQNode		*nodes;
	I64			 num_nodes;
	CQClipNode	*clipnodes;
	I64			 num_clipnodes;
	CQLeaf		*leafs;
	I64			 num_leafs;
	CQTexInfo	*texinfo;
	I64			 num_texinfo;
	CQFace		*faces;
	I64			 num_faces;
	I64			*marksurfaces;
	I64			 num_marksurfaces;
	CQModel		*models;
	I64			 num_models;
	CQTexture	*textures;
	I64			 num_textures;

	U8			*visdata;		//run-length encoded PVS
	I64			 visdata_size;
	U8			*lightdata;
	I64			 lightdata_size;
	U8			*entities;		//NUL-terminated key/value text
	I64			 entities_size;
};

I64 q_map_bad_reports = 0;

Bool QMapValid(CQMap *map, U8 *who)
{//Reject a map pointer that cannot possibly be real, and say where from.
 //
 //A stale or corrupted CQMap* dereferences to a NON-CANONICAL address, which
 //the CPU reports as a General Protection fault rather than a page fault - so
 //it lands in the debugger with no log and no clue which caller was at fault.
 //Checking the pointer costs a compare and turns that into one line naming the
 //site, which is the difference between a reproducible bug and a screenshot.
	I64 addr = map;

	//Canonical user addresses only. The tell for this class of corruption is a
	//value with high bits set, e.g. F000FF53F000FF53.
	if (map && addr >= 0x1000 && addr < 0x0000800000000000)
		return TRUE;

	if (q_map_bad_reports < 8)
	{
		q_map_bad_reports++;
		"QBSP: bad map pointer 0x%X from %s\n", addr, who;
	}

	return FALSE;
}

U0 QBSPFree(CQMap *map)
{
	if (!map)
		return;

	if (map->planes)		Free(map->planes);
	if (map->vertices)		Free(map->vertices);
	if (map->edges)			Free(map->edges);
	if (map->surfedges)		Free(map->surfedges);
	if (map->nodes)			Free(map->nodes);
	if (map->clipnodes)		Free(map->clipnodes);
	if (map->leafs)			Free(map->leafs);
	if (map->texinfo)		Free(map->texinfo);
	if (map->faces)			Free(map->faces);
	if (map->marksurfaces)	Free(map->marksurfaces);
	if (map->models)		Free(map->models);
	if (map->textures)		Free(map->textures);
	if (map->raw)			Free(map->raw);

	Free(map);
}

U0 QBSPCalcSurfaceExtents(CQMap *map, CQFace *f)
{//Project the face's verts through its texture axes to get the lightmap grid
 //size. Quake stores lightmaps at one luxel per 16 texels, so the extents are
 //snapped outward to a 16-texel boundary.
	CQTexInfo	*ti = &map->texinfo[f->tex_info];
	CQVertex	*v;
	F64			 mins[2];
	F64			 maxs[2];
	F64			 val;
	I64			 i;
	I64			 j;
	I64			 e;
	I64			 bmins;
	I64			 bmaxs;

	mins[0] = 999999.0;
	mins[1] = 999999.0;
	maxs[0] = -999999.0;
	maxs[1] = -999999.0;

	for (i = 0; i < f->num_edges; i++)
	{
		e = map->surfedges[f->first_edge + i];
		if (e >= 0)
			v = &map->vertices[map->edges[e].v[0]];
		else
			v = &map->vertices[map->edges[-e].v[1]];

		for (j = 0; j < 2; j++)
		{
			val = v->pt[0] * ti->vecs[j * 4] +
				  v->pt[1] * ti->vecs[j * 4 + 1] +
				  v->pt[2] * ti->vecs[j * 4 + 2] +
				  ti->vecs[j * 4 + 3];

			if (val < mins[j])
				mins[j] = val;
			if (val > maxs[j])
				maxs[j] = val;
		}
	}

	//Snap to the 16-texel lightmap grid.
	bmins = ToI64(Floor(mins[0] / 16.0));
	bmaxs = ToI64(Ceil(maxs[0] / 16.0));
	f->mins_s   = bmins * 16.0;
	f->extent_s = (bmaxs - bmins) * 16;

	bmins = ToI64(Floor(mins[1] / 16.0));
	bmaxs = ToI64(Ceil(maxs[1] / 16.0));
	f->mins_t   = bmins * 16.0;
	f->extent_t = (bmaxs - bmins) * 16;
}

U0 QBSPLoadTextures(CQMap *map, U8 *lump, I64 lump_len)
{//The miptex lump is a count, a table of per-texture offsets (-1 = missing),
 //then 40-byte texture headers each followed by four mip levels of 8bpp
 //texels. Texel pointers borrow from the map buffer; nothing extra is copied.
	CQTexture	*t;
	U8			*p;
	I64			 count;
	I64			 ofs;
	I64			 i;
	I64			 j;

	map->textures     = NULL;
	map->num_textures = 0;

	if (lump_len < 4)
		return;

	count = QRdI32(lump);
	if (count <= 0 || 4 + count * 4 > lump_len)
		return;

	map->textures     = CAlloc(count * sizeof(CQTexture));
	map->num_textures = count;

	for (i = 0; i < count; i++)
	{
		t   = &map->textures[i];
		ofs = QRdI32(lump + 4 + i * 4);

		t->clamp = FALSE;		//world textures tile

		//A -1 offset means the map references a texture it does not embed.
		if (ofs < 0 || ofs + 40 > lump_len)
		{
			t->name[0] = 0;
			t->width   = 0;
			t->height  = 0;
			for (j = 0; j < 4; j++)
				t->texels[j] = NULL;
		}
		else
		{
			p = lump + ofs;
			QRdName(p, t->name, 16);
			t->width  = QRdU32(p + 16);
			t->height = QRdU32(p + 20);

			//Sky surfaces are identified purely by a "sky" name prefix.
			t->is_sky = !StrNICompare(t->name, "sky", 3);

			for (j = 0; j < 4; j++)
			{
				t->texels[j] = NULL;
				if (t->width > 0 && t->height > 0)
				{
					I64 mo = QRdU32(p + 24 + j * 4);
					if (mo > 0 && ofs + mo < lump_len)
						t->texels[j] = p + mo;
				}
			}
		}
	}
}

U0 QBSPMakeHull0(CQMap *map)
{//Build a point-sized clipping hull from the render tree. Mod_MakeHull0.
 //
 //Hull 1 and hull 2 are pre-expanded clipnode trees the compiler produced for
 //man-sized and monster-sized boxes. There is no hull 0 in the file: a POINT
 //trace - a rocket, a gib, a spike - is supposed to use the render tree, and the
 //original converts it into clipnode form so the same walker can handle it.
 //
 //The conversion is one clipnode per render node with the same plane, except
 //that a child pointing at a LEAF becomes that leaf's CONTENTS value, since the
 //clipnode walker signals solidity through negative children rather than by
 //following a leaf index.
 //
 //The result is appended to the clipnode array so nothing else has to know it is
 //synthetic; only the child indices need rebasing.
	CQClipNode	*grown;
	CQClipNode	*cn;
	I64			 base = map->num_clipnodes;
	I64			 total;
	I64			 child;
	I64			 leaf;
	I64			 i;
	I64			 j;

	if (map->num_nodes < 1)
		return;

	total = base + map->num_nodes;
	grown = CAlloc(total * sizeof(CQClipNode));

	if (base > 0)
		MemCopy(grown, map->clipnodes, base * sizeof(CQClipNode));

	for (i = 0; i < map->num_nodes; i++)
	{
		cn            = &grown[base + i];
		cn->plane_num = map->nodes[i].plane_num;

		for (j = 0; j < 2; j++)
		{
			child = map->nodes[i].children[j];

			if (child < 0)
			{
				//~(leaf index) in the render tree. Emit the leaf's contents,
				//which is what the clipnode walker expects to find.
				leaf = -1 - child;

				if (leaf >= 0 && leaf < map->num_leafs)
					cn->children[j] = map->leafs[leaf].contents;
				else
					cn->children[j] = QCONTENTS_SOLID;
			}
			else
				cn->children[j] = base + child;
		}
	}

	if (map->clipnodes)
		Free(map->clipnodes);

	map->clipnodes     = grown;
	map->num_clipnodes = total;

	//Every model's hull-0 root, rebased into the appended range.
	for (i = 0; i < map->num_models; i++)
	{
		if (map->models[i].head_node[0] >= 0)
			map->models[i].hull0_head = base + map->models[i].head_node[0];
		else
			map->models[i].hull0_head = -1;
	}
}

CQMap *QBSPLoad(U8 *name)
{//Read a map out of the mounted archives and decode every lump.
	CQMap		*map;
	CQFace		*f;
	CQLeaf		*l;
	CQNode		*n;
	CQTexInfo	*ti;
	CQModel		*m;
	U8			*d;
	U8			*rec;
	I64			 size = 0;
	I64			 lump_offset[QLUMP_COUNT];
	I64			 lump_length[QLUMP_COUNT];
	I64			 i;
	I64			 j;
	I64			 c;

	d = QPakLoad(name, &size);
	if (!d)
	{
		"QBSP: %s not found\n", name;
		return NULL;
	}

	if (size < 4 + QLUMP_COUNT * 8)
	{
		"QBSP: %s is too small to be a map\n", name;
		Free(d);
		return NULL;
	}

	if (QRdI32(d) != QBSP_VERSION)
	{
		"QBSP: %s is version %d, expected %d\n", name, QRdI32(d), QBSP_VERSION;
		Free(d);
		return NULL;
	}

	for (i = 0; i < QLUMP_COUNT; i++)
	{
		lump_offset[i] = QRdI32(d + 4 + i * 8);
		lump_length[i] = QRdI32(d + 8 + i * 8);

		if (lump_offset[i] < 0 || lump_length[i] < 0 ||
			lump_offset[i] + lump_length[i] > size)
		{
			"QBSP: %s lump %d is out of range\n", name, i;
			Free(d);
			return NULL;
		}
	}

	map           = CAlloc(sizeof(CQMap));
	map->raw      = d;
	map->raw_size = size;

	//--- planes: normal[3], dist, type ---
	c = lump_length[QLUMP_PLANES] / 20;
	map->num_planes = c;
	map->planes     = CAlloc(c * sizeof(CQPlane));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_PLANES] + i * 20;
		QRdVec(rec, map->planes[i].normal);
		map->planes[i].dist = QRdF32(rec + 12);
		map->planes[i].type = QRdI32(rec + 16);
	}

	//--- vertices ---
	c = lump_length[QLUMP_VERTICES] / 12;
	map->num_vertices = c;
	map->vertices     = CAlloc(c * sizeof(CQVertex));
	for (i = 0; i < c; i++)
		QRdVec(d + lump_offset[QLUMP_VERTICES] + i * 12, map->vertices[i].pt);

	//--- edges: a pair of unsigned vertex indices ---
	c = lump_length[QLUMP_EDGES] / 4;
	map->num_edges = c;
	map->edges     = CAlloc(c * sizeof(CQEdge));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_EDGES] + i * 4;
		map->edges[i].v[0] = QRdU16(rec);
		map->edges[i].v[1] = QRdU16(rec + 2);
	}

	//--- surfedges: signed edge references ---
	c = lump_length[QLUMP_SURFEDGES] / 4;
	map->num_surfedges = c;
	map->surfedges     = CAlloc(c * sizeof(I64));
	for (i = 0; i < c; i++)
		map->surfedges[i] = QRdI32(d + lump_offset[QLUMP_SURFEDGES] + i * 4);

	//--- texinfo: two 4-component texture axes, then miptex + flags ---
	c = lump_length[QLUMP_TEXINFO] / 40;
	map->num_texinfo = c;
	map->texinfo     = CAlloc(c * sizeof(CQTexInfo));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_TEXINFO] + i * 40;
		ti  = &map->texinfo[i];
		for (j = 0; j < 8; j++)
			ti->vecs[j] = QRdF32(rec + j * 4);
		ti->miptex = QRdI32(rec + 32);
		ti->flags  = QRdI32(rec + 36);
	}

	//--- nodes: negative children are ~(leaf index) ---
	c = lump_length[QLUMP_NODES] / 24;
	map->num_nodes = c;
	map->nodes     = CAlloc(c * sizeof(CQNode));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_NODES] + i * 24;
		n   = &map->nodes[i];
		n->plane_num   = QRdI32(rec);
		n->children[0] = QRdI16(rec + 4);
		n->children[1] = QRdI16(rec + 6);
		for (j = 0; j < 3; j++)
		{
			n->mins[j] = ToF64(QRdI16(rec + 8 + j * 2));
			n->maxs[j] = ToF64(QRdI16(rec + 14 + j * 2));
		}
		n->first_face = QRdU16(rec + 20);
		n->num_faces  = QRdU16(rec + 22);
	}

	//--- clipnodes: plane index plus two shorts ---
	c = lump_length[QLUMP_CLIPNODES] / 8;
	map->num_clipnodes = c;
	map->clipnodes     = CAlloc(c * sizeof(CQClipNode));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_CLIPNODES] + i * 8;
		map->clipnodes[i].plane_num   = QRdI32(rec);
		map->clipnodes[i].children[0] = QRdI16(rec + 4);
		map->clipnodes[i].children[1] = QRdI16(rec + 6);
	}

	//--- leafs ---
	c = lump_length[QLUMP_LEAFS] / 28;
	map->num_leafs = c;
	map->leafs     = CAlloc(c * sizeof(CQLeaf));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_LEAFS] + i * 28;
		l   = &map->leafs[i];
		l->contents   = QRdI32(rec);
		l->vis_offset = QRdI32(rec + 4);
		for (j = 0; j < 3; j++)
		{
			l->mins[j] = ToF64(QRdI16(rec + 8 + j * 2));
			l->maxs[j] = ToF64(QRdI16(rec + 14 + j * 2));
		}
		l->first_marksurface = QRdU16(rec + 20);
		l->num_marksurfaces  = QRdU16(rec + 22);
		for (j = 0; j < 4; j++)
			l->ambient[j] = rec[24 + j];
	}

	//--- marksurfaces: leaf -> face indirection ---
	c = lump_length[QLUMP_MARKSURFACES] / 2;
	map->num_marksurfaces = c;
	map->marksurfaces     = CAlloc(c * sizeof(I64));
	for (i = 0; i < c; i++)
		map->marksurfaces[i] = QRdU16(d + lump_offset[QLUMP_MARKSURFACES] + i * 2);

	//--- faces ---
	c = lump_length[QLUMP_FACES] / 20;
	map->num_faces = c;
	map->faces     = CAlloc(c * sizeof(CQFace));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_FACES] + i * 20;
		f   = &map->faces[i];
		f->plane_num  = QRdU16(rec);
		f->side       = QRdU16(rec + 2);
		f->first_edge = QRdI32(rec + 4);
		f->num_edges  = QRdU16(rec + 8);
		f->tex_info   = QRdU16(rec + 10);
		for (j = 0; j < 4; j++)
			f->styles[j] = rec[12 + j];
		f->light_offset = QRdI32(rec + 16);
	}

	//--- models: worldspawn is 0, the rest are doors/plats/etc ---
	c = lump_length[QLUMP_MODELS] / 64;
	map->num_models = c;
	map->models     = CAlloc(c * sizeof(CQModel));
	for (i = 0; i < c; i++)
	{
		rec = d + lump_offset[QLUMP_MODELS] + i * 64;
		m   = &map->models[i];
		QRdVec(rec, m->mins);
		QRdVec(rec + 12, m->maxs);
		QRdVec(rec + 24, m->origin);
		for (j = 0; j < 4; j++)
			m->head_node[j] = QRdI32(rec + 36 + j * 4);
		m->vis_leafs  = QRdI32(rec + 52);
		m->first_face = QRdI32(rec + 56);
		m->num_faces  = QRdI32(rec + 60);
	}

	//--- borrowed byte lumps ---
	map->visdata       = d + lump_offset[QLUMP_VISIBILITY];
	map->visdata_size  = lump_length[QLUMP_VISIBILITY];
	map->lightdata     = d + lump_offset[QLUMP_LIGHTING];
	map->lightdata_size = lump_length[QLUMP_LIGHTING];
	map->entities      = d + lump_offset[QLUMP_ENTITIES];
	map->entities_size = lump_length[QLUMP_ENTITIES];

	QBSPLoadTextures(map, d + lump_offset[QLUMP_MIPTEX], lump_length[QLUMP_MIPTEX]);

	//Surface extents need vertices, edges, surfedges and texinfo in place.
	for (i = 0; i < map->num_faces; i++)
		QBSPCalcSurfaceExtents(map, &map->faces[i]);

	//Synthesise the point-sized hull now that nodes, leafs and models are all
	//loaded. It appends to the clipnode array, so nothing may hold a clipnode
	//pointer across this call.
	QBSPMakeHull0(map);

	return map;
}

U0 QBSPReport(CQMap *map)
{//Load-time sanity dump.
	if (!map)
	{
		"QBSP: no map\n";
		return;
	}

	"  planes       %6d\n", map->num_planes;
	"  vertices     %6d\n", map->num_vertices;
	"  edges        %6d\n", map->num_edges;
	"  surfedges    %6d\n", map->num_surfedges;
	"  nodes        %6d\n", map->num_nodes;
	"  leafs        %6d\n", map->num_leafs;
	"  texinfo      %6d\n", map->num_texinfo;
	"  faces        %6d\n", map->num_faces;
	"  marksurfaces %6d\n", map->num_marksurfaces;
	"  models       %6d\n", map->num_models;
	"  textures     %6d\n", map->num_textures;
	"  visdata      %6d bytes\n", map->visdata_size;
	"  lightdata    %6d bytes\n", map->lightdata_size;
	"  entities     %6d bytes\n", map->entities_size;
}
