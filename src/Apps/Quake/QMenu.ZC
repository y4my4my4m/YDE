// QMenu.ZC - main menu, console, and the game state machine.
//
// The interface is engine-side, not QuakeC: the menu is assembled from the
// pictures shipped in the PAK (mainmenu, ttl_main, the qplaque spine, and the
// six-frame animated cursor), and the console draws over conback with the
// CONCHARS font. Everything renders into the indexed canvas so it goes
// through the game palette like the world does.

#define QST_MENU		0
#define QST_PLAYING		1
#define QST_CONSOLE		2

//Rows in the main menu picture, in the order they are drawn.
#define QMENU_SINGLE	0
#define QMENU_MULTI		1
#define QMENU_OPTIONS	2
#define QMENU_HELP		3
#define QMENU_QUIT		4
#define QMENU_ROWS		5

//Layout of gfx/mainmenu.lmp: the rows are 20 pixels apart starting at y=32
//within the picture, which is drawn at x=72.
#define QMENU_X			72
#define QMENU_Y			32
#define QMENU_ROW_H		20
#define QMENU_CURSOR_X	54

#define QCON_LINES		24
#define QCON_WIDTH		40
#define QCON_HEIGHT		128		//console drops down this far

//Which page the menu is showing.
#define QPAGE_MAIN		0
#define QPAGE_OPTIONS	1
#define QPAGE_NOTICE	2

//Options rows.
#define QOPT_SENS		0
#define QOPT_VOLUME		1
#define QOPT_RES		2
#define QOPT_FULLSCREEN	3
#define QOPT_GAMMA		4
#define QOPT_BACK		5
#define QOPT_ROWS		6

//Selectable render resolutions. These are the render target size, not the
//window size - the result is centred and integer-scaled to fit whatever
//window it lands in. Software rasterising costs scale with the pixel count,
//so this is the performance dial: 640x480 is four times the work of 320x240.
#define QRES_COUNT		5
I64 q_res_w[QRES_COUNT] = {320, 400, 512, 640, 800};
I64 q_res_h[QRES_COUNT] = {240, 300, 384, 480, 600};

I64		q_state			= QST_MENU;
I64		q_menu_row		= 0;
I64		q_menu_page		= QPAGE_MAIN;
I64		q_opt_row		= 0;
Bool	q_menu_ingame	= FALSE;	//TRUE once a map is running, enables Resume
Bool	q_quit_request	= FALSE;
U8		q_notice[64];

//Live settings the options page edits. Kept here rather than as constants in
//the app so the menu can actually change them at runtime.
F64		q_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		q_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		q_opt_res			= 0;		//index into q_res_w / q_res_h
Bool	q_opt_fullscreen	= TRUE;
F64		q_opt_gamma			= 1.0;		//1.0 = untouched, lower is brighter
Bool	q_res_dirty			= FALSE;	//set when the app must rebuild the canvas

CQPic	q_pic_mainmenu;
CQPic	q_pic_ttlmain;
CQPic	q_pic_qplaque;
CQPic	q_pic_conback;
CQPic	q_pic_sp_menu;
CQPic	q_pic_cursor[6];

//Console scrollback. Plain fixed-size rows: the console is a diagnostic
//surface, not a text editor.
U8		q_con_text[QCON_LINES * QCON_WIDTH];
I64		q_con_line		= 0;
Bool	q_con_ready		= FALSE;

//Menu feedback sounds, matching S_LocalSound's use in the original:
//  menu1 - moving the highlight
//  menu2 - entering a page or confirming
//  menu3 - changing a value
//Played from the listener with zero attenuation so they are always full volume
//regardless of where the player happens to be standing.
#define QMSND_MOVE		"misc/menu1.wav"
#define QMSND_ENTER		"misc/menu2.wav"
#define QMSND_VALUE		"misc/menu3.wav"

//--- preferences ------------------------------------------------------------
//
// Written next to the game data as plain text, one "key value" per line. Text
// rather than a struct dump so it stays readable and survives a field being
// added or removed - an unknown key is skipped and a missing one keeps its
// default.
//
// This file is per-machine state, not source. It is in .gitignore.
#define QCFG_PATH	"QUAKECFG.TXT"

U0 QCfgSave()
{//Write the current options out. Called whenever one changes.
	U8 buf[512];

	StrPrint(buf,
		"sensitivity %d\n"
		"volume %d\n"
		"res %d\n"
		"fullscreen %d\n"
		"gamma %d\n",
		ToI64(q_opt_sensitivity * 1000.0),
		q_opt_volume,
		q_opt_res,
		ToI64(q_opt_fullscreen),
		ToI64(q_opt_gamma * 1000.0));

	//Values are stored as thousandths so the file holds no floating point text,
	//which would need a parser this build does not have.
	FileWrite(QCFG_PATH, buf, StrLen(buf));
}

I64 QCfgValue(U8 *line)
{//The integer after the first space, or 0.
	I64 i = 0;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	return Str2I64(line + i);
}

U0 QCfgLoad()
{//Read the options back. Anything missing or unparsable keeps its default.
	U8	*raw;
	U8	 line[128];
	I64	 size = 0;
	I64	 i    = 0;
	I64	 n;
	I64	 v;

	raw = FileRead(QCFG_PATH, &size);
	if (!raw)
		return;

	while (i < size)
	{
		//Copy one line out, bounded.
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 127)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qcl_next;

		v = QCfgValue(line);

		if (!StrNICompare(line, "sensitivity ", 12))
			q_opt_sensitivity = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "volume ", 7))
			q_opt_volume = ClampI64(v, 0, 100);
		else if (!StrNICompare(line, "res ", 4))
			q_opt_res = ClampI64(v, 0, QRES_COUNT - 1);
		else if (!StrNICompare(line, "fullscreen ", 11))
			q_opt_fullscreen = ToBool(v);
		else if (!StrNICompare(line, "gamma ", 6))
			q_opt_gamma = ToF64(v) / 1000.0;

qcl_next:
	}

	Free(raw);

	//Clamp anything a hand-edited file could have put out of range, then push
	//the values that own hardware state.
	if (q_opt_sensitivity < 0.02)	q_opt_sensitivity = 0.02;
	if (q_opt_sensitivity > 0.60)	q_opt_sensitivity = 0.60;

	AC97MasterVolumeSet(q_opt_volume);
	QPalSetGamma(q_opt_gamma);
}

//The menu is authored for a 320x200 screen. Everything with a fixed
//coordinate is offset by this so the page stays together as one block instead
//of some parts hugging the left edge while the artwork centres itself.
//M_DrawPic in the original adds exactly the same term.
#define QMENU_VW	320

//Slider widget, drawn with the conchars slider pieces exactly as M_DrawSlider
//does: 128 is the left cap, 129 the repeated trough, 130 the right cap, and 131
//the handle. A range of 0..1 positions the handle across the trough.
#define QSLIDER_CELLS	10

U0 QMenuBackdrop(CQCanvas *c)
{//What sits behind a menu page.
 //
 //M_Draw's own rule: with a game running the world stays visible and is dimmed,
 //so the menu reads as an overlay and the player can see what they are going
 //back to. Only outside a game - or with the console down - does the console
 //artwork fill the screen.
	if (q_menu_ingame)
	{
		QDrawFadeScreen(c);
		return;
	}

	MemSet(c->pixels, 0, c->width * c->height);

	if (q_pic_conback.pixels)
		QPicDrawFill(c, &q_pic_conback);
}

U0 QMenuSlider(CQCanvas *c, I64 x, I64 y, F64 range)
{
	I64 i;

	if (range < 0.0)	range = 0.0;
	if (range > 1.0)	range = 1.0;

	QCharDraw(c, x - QCHAR_W, y, 128);

	for (i = 0; i < QSLIDER_CELLS; i++)
		QCharDraw(c, x + i * QCHAR_W, y, 129);

	QCharDraw(c, x + QSLIDER_CELLS * QCHAR_W, y, 130);

	QCharDraw(c, x + ToI64((QSLIDER_CELLS - 1) * QCHAR_W * range), y, 131);
}

I64 QMenuXOfs(CQCanvas *c)
{
	I64 ofs = (c->width - QMENU_VW) / 2;

	if (ofs < 0)
		ofs = 0;

	return ofs;
}

U0 QMenuSound(U8 *name)
{
	QSndPlayAt(name, q_snd_listener, 1.0, 0.0);
}

U0 QMenuInit()
{
	U8	name[24];
	I64	i;

	QPicLoad("gfx/mainmenu.lmp", &q_pic_mainmenu);
	QPicLoad("gfx/ttl_main.lmp", &q_pic_ttlmain);
	QPicLoad("gfx/qplaque.lmp", &q_pic_qplaque);
	QPicLoad("gfx/conback.lmp", &q_pic_conback);
	QPicLoad("gfx/sp_menu.lmp", &q_pic_sp_menu);

	for (i = 0; i < 6; i++)
	{
		StrPrint(name, "gfx/menudot%d.lmp", i + 1);
		QPicLoad(name, &q_pic_cursor[i]);
	}

	for (i = 0; i < QCON_LINES * QCON_WIDTH; i++)
		q_con_text[i] = 0;

	q_con_line     = 0;
	q_con_ready    = TRUE;
	q_state        = QST_MENU;
	q_menu_row     = 0;
	q_menu_ingame  = FALSE;
	q_quit_request = FALSE;
}

U0 QConPrint(U8 *s)
{//Append a line to the console scrollback, wrapping at the bottom.
	I64 i = 0;
	U8 *row;

	if (!q_con_ready)
		return;

	row = q_con_text + (q_con_line % QCON_LINES) * QCON_WIDTH;

	while (s[i] && i < QCON_WIDTH - 1)
	{
		row[i] = s[i];
		i++;
	}
	row[i] = 0;

	q_con_line++;
}

//--- console input ---------------------------------------------------------
//
// CharGet and KeyGet both BLOCK, which would stall the render loop, so typing
// is driven from the same non-blocking scancode polling the game uses. Each
// key needs its own edge detection or one press repeats for every frame it is
// held - at ~190fps that is a screenful of characters per tap.

#define QCON_INPUT_MAX	62

U8	 q_con_input[QCON_INPUT_MAX + 2];
I64	 q_con_input_len	= 0;
U8	 q_key_prev[256];
Bool q_con_want_noclip	= FALSE;	//console asked for a noclip toggle
Bool q_con_want_quit	= FALSE;

//Characters the console accepts. Enough for map names and commands.
U8 *q_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ._-/";

U0 QConInputReset()
{
	I64 i;

	for (i = 0; i < 256; i++)
		q_key_prev[i] = 0;

	q_con_input[0]   = 0;
	q_con_input_len  = 0;
	q_con_want_noclip = FALSE;
	q_con_want_quit   = FALSE;
}

Bool QConKeyEdge(I64 sc)
{//TRUE only on the frame a key goes down.
	Bool down;
	Bool was;

	if (sc <= 0 || sc >= 256)
		return FALSE;

	down = ToBool(Bt(kbd.down_bitmap, sc));
	was  = ToBool(q_key_prev[sc]);

	if (down)
		q_key_prev[sc] = 1;
	else
		q_key_prev[sc] = 0;

	return ToBool(down && !was);
}

//--- console command helpers ------------------------------------------------

//FL_ bits from the original's defs.qc.
#define QFL_GODMODE_	64
#define QFL_NOTARGET_	128

F64  q_con_fov_want	= 0.0;	//non-zero = console asked for a new fov
Bool q_con_want_save	= FALSE;
Bool q_con_want_load	= FALSE;
Bool q_con_save_ok		= TRUE;

U0 QConCheatFlag(I64 bit, U8 *name)
{//XOR a flag bit on the player and report the new state. Host_God_f's shape.
	U8	msg[64];
	I64	flags;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags = flags ^ bit;
	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	if (flags & bit)
		StrPrint(msg, "%s ON", name);
	else
		StrPrint(msg, "%s OFF", name);

	QConPrint(msg);
}

U0 QConRunPlayerFunc(U8 *name)
{//Call a QuakeC function with self = the player, the way the host commands do.
	I64 fn = QPrFindFunction(name);

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	if (fn <= 0)
	{
		QConPrint("no such QuakeC function");
		return;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;
}

U0 QConImpulse(I64 n)
{//Host_Impulse_f: set .impulse and let QuakeC consume it next think.
	U8 msg[48];

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	QPrSetFieldF(q_player_edict, q_fld_impulse, ToF64(n));
	StrPrint(msg, "impulse %d", n);
	QConPrint(msg);
}

U0 QConGive(U8 *args)
{//Host_Give_f. First character selects what, the number that follows is the
 //amount; a digit gives the matching weapon by setting its .items bit.
	U8	msg[64];
	I64	v = 0;
	I64	i = 0;
	I64	items;
	U8	what;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	what = args[0];

	//Skip to the number, if there is one.
	while (args[i] && args[i] != ' ')
		i++;
	while (args[i] == ' ')
		i++;
	if (args[i])
		v = Str2I64(args + i);

	if ('2' <= what <= '8')
	{
		//IT_SHOTGUN << (n - 2), the original's own expression. IT_SHOTGUN is 1.
		items = ToI64(QPrFieldF(q_player_edict, q_fld_items));
		items = items | (1 << (what - '2'));
		QPrSetFieldF(q_player_edict, q_fld_items, ToF64(items));
		StrPrint(msg, "gave weapon %c", what);
	}
	else if (what == 's' && q_fld_ammo_shells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_shells, ToF64(v));
		StrPrint(msg, "shells %d", v);
	}
	else if (what == 'n' && q_fld_ammo_nails >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_nails, ToF64(v));
		StrPrint(msg, "nails %d", v);
	}
	else if (what == 'r' && q_fld_ammo_rockets >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_rockets, ToF64(v));
		StrPrint(msg, "rockets %d", v);
	}
	else if (what == 'c' && q_fld_ammo_cells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_cells, ToF64(v));
		StrPrint(msg, "cells %d", v);
	}
	else if (what == 'h')
	{
		QPrSetFieldF(q_player_edict, q_fld_health, ToF64(v));
		StrPrint(msg, "health %d", v);
	}
	else
		StrPrint(msg, "give: s n r c h or 2-8");

	QConPrint(msg);
}

U0 QConStatus()
{//Host_Status_f, reduced to what a single-player build can report.
	U8 msg[96];

	StrPrint(msg, "map %s", q_map_name);
	QConPrint(msg);

	StrPrint(msg, "edicts %d  time %4.1f", q_pr_num_edicts, q_game_time);
	QConPrint(msg);

	if (q_player_active)
	{
		StrPrint(msg, "health %d  armor %d  ammo %d",
			ToI64(QPlayerHealth), ToI64(QPlayerArmor), ToI64(QPlayerAmmo));
		QConPrint(msg);
	}
}

U0 QConExec(U8 *line)
{//A small command set. Unknown input is echoed rather than silently ignored,
 //so a typo is visibly a typo.
	U8 msg[80];

	if (!line[0])
		return;

	StrPrint(msg, "]%s", line);
	QConPrint(msg);

	//--- level control ---
	if (!StrNICompare(line, "map ", 4))
	{
		QStrCopy(q_change_map, line + 4, 64);
		q_change_pending = TRUE;
		return;
	}

	if (!StrNICompare(line, "changelevel ", 12))
	{
		QStrCopy(q_change_map, line + 12, 64);
		q_change_pending = TRUE;
		return;
	}

	if (!StrICompare(line, "restart"))
	{
		//Same command QuakeC's respawn() issues on a single-player death.
		q_restart_pending = TRUE;
		return;
	}

	//--- movement cheats. Host_Noclip_f and Host_Fly_f swap the movetype; the
	//--- engine's own flycam stands in for noclip here since QuakeC's player
	//--- movement is driven from this side.
	if (!StrICompare(line, "noclip"))
	{
		q_con_want_noclip = TRUE;
		QConPrint("noclip toggled");
		return;
	}

	if (!StrICompare(line, "fly"))
	{
		q_con_want_noclip = TRUE;
		QConPrint("fly mode toggled");
		return;
	}

	//--- flag cheats, exactly as Host_God_f and Host_Notarget_f do it: XOR the
	//--- bit and report the resulting state.
	if (!StrICompare(line, "god"))
	{
		QConCheatFlag(QFL_GODMODE_, "godmode");
		return;
	}

	if (!StrICompare(line, "notarget"))
	{
		QConCheatFlag(QFL_NOTARGET_, "notarget");
		return;
	}

	if (!StrICompare(line, "kill"))
	{
		QConRunPlayerFunc("ClientKill");
		return;
	}

	//--- impulse: QuakeC consumes .impulse once, which is how every weapon
	//--- switch and cheat code in the game is delivered.
	if (!StrNICompare(line, "impulse ", 8))
	{
		QConImpulse(Str2I64(line + 8));
		return;
	}

	if (!StrNICompare(line, "give ", 5))
	{
		QConGive(line + 5);
		return;
	}

	if (!StrNICompare(line, "fov ", 4))
	{
		//q_fov lives in the app shell, which is compiled AFTER this file, so the
		//value is requested rather than written directly.
		q_con_fov_want = ToF64(Str2I64(line + 4));
		if (q_con_fov_want < 30.0)	q_con_fov_want = 30.0;
		if (q_con_fov_want > 130.0)	q_con_fov_want = 130.0;
		StrPrint(msg, "fov %d", ToI64(q_con_fov_want));
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "save"))
	{
		if (q_con_save_ok)
			QConPrint("saved");
		else
			QConPrint("save failed");
		q_con_want_save = TRUE;
		return;
	}

	if (!StrICompare(line, "load"))
	{
		q_con_want_load = TRUE;
		return;
	}

	if (!StrICompare(line, "status"))
	{
		QConStatus;
		return;
	}

	if (!StrICompare(line, "version"))
	{
		QConPrint("Quake shareware data, engine written for ZealOS");
		return;
	}

	if (!StrICompare(line, "quit"))
	{
		q_con_want_quit = TRUE;
		return;
	}

	if (!StrICompare(line, "help"))
	{
		QConPrint("map <n>  changelevel <n>  restart  save  load");
		QConPrint("god  notarget  noclip  fly  kill");
		QConPrint("impulse <n>  give <s|n|r|c|h|1-8> <v>  fov <n>");
		QConPrint("status  version  quit");
		return;
	}

	QConPrint("unknown command");
}

U0 QConInput()
{//Poll one frame of typing.
	I64 i;
	I64 sc;
	I64 ch;

	//Printable characters.
	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_con_input_len < QCON_INPUT_MAX)
		{
			q_con_input[q_con_input_len] = ch;
			q_con_input_len++;
			q_con_input[q_con_input_len] = 0;
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_con_input_len > 0)
	{
		q_con_input_len--;
		q_con_input[q_con_input_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		QConExec(q_con_input);
		q_con_input[0]  = 0;
		q_con_input_len = 0;
	}
}

U0 QConDraw(CQCanvas *c)
{//Console slides over the top of whatever is behind it.
	I64	 i;
	I64	 line;
	I64	 y;
	I64	 con_h;
	U8	*row;

	//The console drops over the top FRACTION of the screen, so its height has to
	//scale with the render target rather than being a fixed 128 pixels - at
	//640x480 a fixed slice covers a quarter of the view and leaves the 320-wide
	//background stopping part way across.
	con_h = c->height / 2;
	if (con_h < QCON_HEIGHT)
		con_h = QCON_HEIGHT;

	if (q_pic_conback.pixels)
		QPicDrawFillPart(c, &q_pic_conback, con_h);

	//Oldest visible line first, so new text appears at the bottom.
	y = 4;
	for (i = QCON_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qc_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0] && y + QCHAR_H < con_h)
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qc_next:
	}

	//Prompt with the line being typed and a blinking caret.
	QStrDraw(c, 8, con_h - QCHAR_H - 2, "]");
	QStrDraw(c, 8 + QCHAR_W, con_h - QCHAR_H - 2, q_con_input);

	if (ToI64(tS * 3.0) & 1)
		QStrDraw(c, 8 + QCHAR_W * (q_con_input_len + 1),
			con_h - QCHAR_H - 2, "_");
}

U0 QOptDraw(CQCanvas *c)
{//Options page. Values are shown as text next to each label.
	U8	line[64];
	I64	y = 60;
	I64	i;
	I64	mx;

	QMenuBackdrop(c);

	mx = QMenuXOfs(c);

	QStrDrawCenter(c, 24, "OPTIONS");

	QStrDraw(c, mx + 64, y, "mouse speed");
	QMenuSlider(c, mx + 220, y,
		(q_opt_sensitivity - 0.02) / (0.60 - 0.02));

	QStrDraw(c, mx + 64, y + 16, "sound volume");
	QMenuSlider(c, mx + 220, y + 16, ToF64(q_opt_volume) / 100.0);

	StrPrint(line, "resolution    %dx%d",
		q_res_w[q_opt_res], q_res_h[q_opt_res]);
	QStrDraw(c, mx + 64, y + 32, line);

	if (q_opt_fullscreen)
		StrPrint(line, "screen        fullscreen");
	else
		StrPrint(line, "screen        windowed");
	QStrDraw(c, mx + 64, y + 48, line);

	//The bar fills as the picture brightens, which reads the right way round -
	//the underlying exponent goes the other way.
	QStrDraw(c, mx + 64, y + 64, "brightness");
	QMenuSlider(c, mx + 220, y + 64,
		(QGAMMA_MAX - q_opt_gamma) / (QGAMMA_MAX - QGAMMA_MIN));

	QStrDraw(c, mx + 64, y + 80, "back");

	//A simple caret marks the row; the spinning cursor belongs to the main
	//page and would be oversized here.
	i = y + q_opt_row * 16;
	QStrDraw(c, mx + 48, i, ">");

	QStrDrawCenter(c, c->height - 20, "left/right change, enter selects");
}

U0 QNoticeDraw(CQCanvas *c)
{//A plain message page, used for the parts of the menu the shareware build
 //genuinely cannot offer.
	QMenuBackdrop(c);

	QStrDrawCenter(c, 90, q_notice);
	QStrDrawCenter(c, c->height - 20, "press enter or escape");
}

U0 QMenuDraw(CQCanvas *c)
{//The main menu: title banner, the spine plaque, the options picture, and the
 //spinning cursor beside the highlighted row.
	I64 frame;
	I64 x;
	I64 y;

	if (q_menu_page == QPAGE_OPTIONS)
	{
		QOptDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_NOTICE)
	{
		QNoticeDraw(c);
		return;
	}

	//A dark backdrop so the menu reads over whatever was last rendered.
	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, QMenuXOfs(c) + 16, 4);

	//Centred within the VIRTUAL box, not the canvas. Mixing the two is what
	//made the plaque and the menu overlap at high resolutions: the plaque was
	//placed in the virtual box while the artwork centred itself on the whole
	//screen, so they drifted apart as the canvas grew.
	if (q_pic_ttlmain.pixels)
		QPicDraw(c, &q_pic_ttlmain,
			QMenuXOfs(c) + (QMENU_VW - q_pic_ttlmain.width) / 2, 4);

	//x=72 is where the original puts the item block.
	if (q_pic_mainmenu.pixels)
		QPicDraw(c, &q_pic_mainmenu, QMenuXOfs(c) + 72, QMENU_Y);

	//The cursor animates at 10Hz through its six frames, which is what gives
	//it the familiar pulsing look.
	frame = ToI64(tS * 10.0) % 6;
	x     = QMenuXOfs(c) + 72 - 18;
	y     = QMENU_Y + q_menu_row * QMENU_ROW_H - 4;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);

	if (q_menu_ingame)
		QStrDrawCenter(c, c->height - 20, "ESC resumes the game");
	else
		QStrDrawCenter(c, c->height - 20, "arrows move, enter selects");
}

Bool QOptKey(I64 sc)
{//Options navigation. Left/right adjust, enter activates, escape returns.
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row--;
		if (q_opt_row < 0)
			q_opt_row = QOPT_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row++;
		if (q_opt_row >= QOPT_ROWS)
			q_opt_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_AdjustSliders plays this once for any value change.
		QMenuSound(QMSND_VALUE);

		switch (q_opt_row)
		{
			case QOPT_SENS:
				if (sc == SC_CURSOR_LEFT)
					q_opt_sensitivity -= 0.02;
				else
					q_opt_sensitivity += 0.02;

				if (q_opt_sensitivity < 0.02)
					q_opt_sensitivity = 0.02;
				if (q_opt_sensitivity > 0.60)
					q_opt_sensitivity = 0.60;
				break;

			case QOPT_VOLUME:
				if (sc == SC_CURSOR_LEFT)
					q_opt_volume -= 10;
				else
					q_opt_volume += 10;

				q_opt_volume = ClampI64(q_opt_volume, 0, 100);
				AC97MasterVolumeSet(q_opt_volume);
				break;

			case QOPT_RES:
				if (sc == SC_CURSOR_LEFT)
					q_opt_res--;
				else
					q_opt_res++;

				q_opt_res = ClampI64(q_opt_res, 0, QRES_COUNT - 1);

				//The render target cannot be reallocated from here: the
				//compositor may be mid-blit. The app rebuilds it between
				//frames when it sees this flag.
				q_res_dirty = TRUE;
				break;

			case QOPT_FULLSCREEN:
				q_opt_fullscreen = !q_opt_fullscreen;
				q_res_dirty      = TRUE;
				break;

			case QOPT_GAMMA:
				//LEFT darkens, which shrinks the bar. M_AdjustSliders does
				//`gamma -= dir * 0.05` with dir = -1 for left, so left RAISES
				//the exponent - and a higher exponent is a darker picture. The
				//bar shows (max - gamma), so both move together.
				if (sc == SC_CURSOR_LEFT)
					q_opt_gamma += 0.05;
				else
					q_opt_gamma -= 0.05;

				if (q_opt_gamma < QGAMMA_MIN)
					q_opt_gamma = QGAMMA_MIN;
				if (q_opt_gamma > QGAMMA_MAX)
					q_opt_gamma = QGAMMA_MAX;

				QPalSetGamma(q_opt_gamma);
				break;

			default:
				break;
		}

		//Any change is written straight out; there is no "apply" step.
		QCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_opt_row == QOPT_BACK)
			q_menu_page = QPAGE_MAIN;
		return TRUE;
	}

	return FALSE;
}

Bool QMenuKey(I64 sc, Bool *_start_game)
{//Drive the menu from a scancode. Returns TRUE if the key was consumed.
	*_start_game = FALSE;

	if (q_menu_page == QPAGE_NOTICE)
	{
		if (sc == SC_ENTER)
		{
			QMenuSound(QMSND_ENTER);
			q_menu_page = QPAGE_MAIN;
			return TRUE;
		}
		return FALSE;
	}

	if (q_menu_page == QPAGE_OPTIONS)
		return QOptKey(sc);

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row--;
		if (q_menu_row < 0)
			q_menu_row = QMENU_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row++;
		if (q_menu_row >= QMENU_ROWS)
			q_menu_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		switch (q_menu_row)
		{
			case QMENU_SINGLE:
				*_start_game = TRUE;
				break;

			case QMENU_OPTIONS:
				q_menu_page = QPAGE_OPTIONS;
				q_opt_row   = 0;
				break;

			case QMENU_MULTI:
				//Honest rather than silent: there is no network layer, so
				//multiplayer cannot work no matter what the row implies.
				QStrCopy(q_notice, "no network support in this build", 64);
				q_menu_page = QPAGE_NOTICE;
				break;

			case QMENU_HELP:
				QStrCopy(q_notice, "shareware episode: e1m1 - e1m8", 64);
				q_menu_page = QPAGE_NOTICE;
				break;

			case QMENU_QUIT:
				q_quit_request = TRUE;
				break;

			default:
				break;
		}
		return TRUE;
	}

	return FALSE;
}
