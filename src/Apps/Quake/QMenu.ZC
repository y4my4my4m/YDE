// QMenu.ZC - main menu, console, and the game state machine.
//
// The interface is engine-side, not QuakeC: the menu is assembled from the
// pictures shipped in the PAK (mainmenu, ttl_main, the qplaque spine, and the
// six-frame animated cursor), and the console draws over conback with the
// CONCHARS font. Everything renders into the indexed canvas so it goes
// through the game palette like the world does.

#define QST_MENU		0
#define QST_PLAYING		1
#define QST_CONSOLE		2

//Rows in the main menu picture, in the order they are drawn.
#define QMENU_SINGLE	0
#define QMENU_MULTI		1
#define QMENU_OPTIONS	2
#define QMENU_HELP		3
#define QMENU_QUIT		4
#define QMENU_ROWS		5

//Layout of gfx/mainmenu.lmp: the rows are 20 pixels apart starting at y=32
//within the picture, which is drawn at x=72.
#define QMENU_X			72
#define QMENU_Y			32
#define QMENU_ROW_H		20
#define QMENU_CURSOR_X	54

#define QCON_LINES		24
#define QCON_WIDTH		40
#define QCON_HEIGHT		128		//console drops down this far

//Which page the menu is showing.
#define QPAGE_MAIN		0
#define QPAGE_OPTIONS	1
#define QPAGE_NOTICE	2
#define QPAGE_MULTI		3
#define QPAGE_SETUP		4
#define QPAGE_HELP		5
#define QPAGE_LANCONFIG	6

//M_LanConfig: the original's "JOIN GAME - TCP/IP" page. Address typed here
//rather than in the console, which is where it belongs.
#define QLAN_ADDRESS	0
#define QLAN_JOIN		1
#define QLAN_BACK		2
#define QLAN_ROWS		3

//M_Help has NUM_HELP_PAGES 6, and gfx/help0.lmp .. help5.lmp are present in
//PAK0 - the shareware and registered releases ship the same six. The pages ARE
//the ordering information, which is why the menu row is called HELP/ORDERING in
//both versions: the label lives in gfx/mainmenu.lmp, not in any version check.
#define QHELP_PAGES		6

//Rows on the multiplayer page, in the original's order.
//The first three MUST match the order baked into gfx/mp_menu.lmp: JOIN A GAME,
//NEW GAME, SETUP. The last two are ours and draw in the small font underneath.
#define QMP_JOIN		0
#define QMP_NEW			1
#define QMP_SETUP		2
#define QMP_MAP			3
#define QMP_BACK		4
#define QMP_ROWS		5

//Rows on the setup page. The original also has a "accept changes" row; here the
//values apply as they are edited, so there is nothing to accept.
#define QSET_NAME		0
#define QSET_TOP		1
#define QSET_BOTTOM		2
#define QSET_BACK		3
#define QSET_ROWS		4

//Options rows.
#define QOPT_SENS		0
#define QOPT_VOLUME		1
#define QOPT_RES		2
#define QOPT_FULLSCREEN	3
#define QOPT_GAMMA		4
#define QOPT_GUNCLIP	5
#define QOPT_BACK		6
#define QOPT_ROWS		7

//Selectable render resolutions. These are the render target size, not the
//window size - the result is centred and integer-scaled to fit whatever
//window it lands in. Software rasterising costs scale with the pixel count,
//so this is the performance dial: 640x480 is four times the work of 320x240.
#define QRES_COUNT		5
I64 q_res_w[QRES_COUNT] = {320, 400, 512, 640, 800};
I64 q_res_h[QRES_COUNT] = {240, 300, 384, 480, 600};

I64		q_state			= QST_MENU;
I64		q_menu_row		= 0;
I64		q_menu_page		= QPAGE_MAIN;
I64		q_opt_row		= 0;
Bool	q_menu_ingame	= FALSE;	//TRUE once a map is running, enables Resume
Bool	q_quit_request	= FALSE;
U8		q_notice[64];
I64		q_mp_row		= 0;

//Which deathmatch level "new game" starts on. The original puts this on a Game
//Options page; one row here does the same job. dm1-dm6 ship in PAK1, so the
//list is only reachable on a registered install - the shareware PAK has none of
//them, and restarting the current single-player map instead (which is what this
//used to do) drops you into a level with no deathmatch spawns at all.
I64		q_mp_map		= 2;	//dm3 is the usual choice

//dm1-dm6 live in PAK1, so they exist only on a registered install - the same
//split M_NetStart_Change encodes when it offers six episodes to a registered
//copy and two to the shareware one. Shareware deathmatch was played on the
//episode maps, so that is the fallback rather than a list of missing files.
U8 *q_mp_maps[6] = {"dm1", "dm2", "dm3", "dm4", "dm5", "dm6"};
U8 *q_mp_maps_sw[6] = {"e1m1", "e1m2", "e1m3", "e1m4", "e1m5", "e1m6"};

U8 *QMPMapName(I64 i)
{
	if (QCvarGet("registered") != 0.0)
		return q_mp_maps[i];

	return q_mp_maps_sw[i];
}
I64		q_set_row		= 0;

//Player identity. The original keeps these as the `name` and `color` client
//commands and ships them to the server as stringcmds; they are held here and
//published on the wire at signon.
U8		q_setup_name[16];
I64		q_setup_top		= 0;	//shirt, 0-13
I64		q_setup_bottom	= 0;	//trousers, 0-13
Bool	q_setup_editing	= FALSE;
Bool	q_setup_ate_enter = FALSE;

//The join page's address field.
I64		q_lan_row		= 0;
U8		q_lan_addr[24];
Bool	q_lan_editing	= FALSE;
I64		q_lan_len		= 0;
Bool	q_lan_ate_enter	= FALSE;
I64		q_setup_len		= 0;

//Set when the multiplayer page asks for a deathmatch listen server. The app
//shell starts the map, since it owns the world.
Bool	q_mp_start_dm	= FALSE;

//Live settings the options page edits. Kept here rather than as constants in
//the app so the menu can actually change them at runtime.
F64		q_opt_sensitivity	= 0.12;		//degrees of view per mouse count
I64		q_opt_volume		= 80;		//0-100, pushed straight to the mixer
I64		q_opt_res			= 0;		//index into q_res_w / q_res_h
Bool	q_opt_fullscreen	= TRUE;
F64		q_opt_gamma			= 1.0;		//1.0 = untouched, lower is brighter

//FALSE draws the weapon into the depth buffer like every other model, which is
//what the SOFTWARE renderer does - press against a wall and the gun sinks into
//it. TRUE reproduces GLQuake's glDepthRange(0, 0.3), which squeezes the weapon
//into the near end of the range so it never intersects anything. Most people
//remember the GL behaviour, so it is offered rather than assumed.
Bool	q_opt_gunclip		= FALSE;
Bool	q_res_dirty			= FALSE;	//set when the app must rebuild the canvas

CQPic	q_pic_mainmenu;
CQPic	q_pic_ttlmain;
CQPic	q_pic_qplaque;
CQPic	q_pic_conback;
CQPic	q_pic_help[QHELP_PAGES];
I64		q_help_page = 0;
CQPic	q_pic_sp_menu;
CQPic	q_pic_cursor[6];
CQPic	q_pic_p_multi;		//MULTIPLAYER title plaque
CQPic	q_pic_mp_menu;		//the three multiplayer rows, as artwork
CQPic	q_pic_p_option;		//OPTIONS title plaque
CQPic	q_pic_menuplyr;		//the setup page's player portrait

//Console scrollback. Plain fixed-size rows: the console is a diagnostic
//surface, not a text editor.
U8		q_con_text[QCON_LINES * QCON_WIDTH];

//When each scrollback line was printed. Con_DrawNotify shows the most recent
//few at the top of the screen for con_notifytime seconds - that is where every
//"You got the..." pickup message appears in the original, and without it those
//messages exist only inside a console nobody has open.
F64		q_con_time[QCON_LINES];

#define QCON_NOTIFY_LINES	4
#define QCON_NOTIFY_TIME	3.0
I64		q_con_line		= 0;
Bool	q_con_ready		= FALSE;

//Menu feedback sounds, matching S_LocalSound's use in the original:
//  menu1 - moving the highlight
//  menu2 - entering a page or confirming
//  menu3 - changing a value
//Played from the listener with zero attenuation so they are always full volume
//regardless of where the player happens to be standing.
#define QMSND_MOVE		"misc/menu1.wav"
#define QMSND_ENTER		"misc/menu2.wav"
#define QMSND_VALUE		"misc/menu3.wav"

//--- preferences ------------------------------------------------------------
//
// Written next to the game data as plain text, one "key value" per line. Text
// rather than a struct dump so it stays readable and survives a field being
// added or removed - an unknown key is skipped and a missing one keeps its
// default.
//
// This file is per-machine state, not source. It is in .gitignore.
#define QCFG_PATH	"QUAKECFG.TXT"

U0 QSetupDefaults()
{//Globals are not zeroed, and QCfgLoad runs before QMenuInit - so the defaults
 //have to be in place before the file is read, or a config with no name line
 //leaves the buffer holding whatever was in memory.
	QStrCopy(q_setup_name, "player", 16);
	q_setup_top     = 0;
	q_setup_bottom  = 0;
	q_setup_editing   = FALSE;
	q_setup_ate_enter = FALSE;
	q_setup_len       = 6;

	QStrCopy(q_lan_addr, "10.0.0.1", 24);
	q_lan_len       = 8;
	q_lan_row       = 0;
	q_lan_editing   = FALSE;
	q_lan_ate_enter = FALSE;
	q_mp_start_dm   = FALSE;
	q_mp_row        = 0;
	q_set_row       = 0;
}

U0 QCfgSave()
{//Write the current options out. Called whenever one changes.
	U8 buf[512];

	StrPrint(buf,
		"sensitivity %d\n"
		"volume %d\n"
		"res %d\n"
		"fullscreen %d\n"
		"gamma %d\n"
		"gunclip %d\n"
		"topcolor %d\n"
		"bottomcolor %d\n"
		"name %s\n",
		ToI64(q_opt_sensitivity * 1000.0),
		q_opt_volume,
		q_opt_res,
		ToI64(q_opt_fullscreen),
		ToI64(q_opt_gamma * 1000.0),
		ToI64(q_opt_gunclip),
		q_setup_top,
		q_setup_bottom,
		q_setup_name);

	//Values are stored as thousandths so the file holds no floating point text,
	//which would need a parser this build does not have.
	if (!q_disk_writes)
		return;

	FileWrite(QCFG_PATH, buf, StrLen(buf));
}

I64 QCfgValue(U8 *line)
{//The integer after the first space, or 0.
	I64 i = 0;

	while (line[i] && line[i] != ' ')
		i++;
	while (line[i] == ' ')
		i++;

	return Str2I64(line + i);
}

U0 QCfgLoad()
{//Read the options back. Anything missing or unparsable keeps its default.
	U8	*raw;
	U8	 line[128];
	I64	 size = 0;
	I64	 i    = 0;
	I64	 n;
	I64	 v;

	raw = FileRead(QCFG_PATH, &size);
	if (!raw)
		return;

	while (i < size)
	{
		//Copy one line out, bounded.
		n = 0;
		while (i < size && raw[i] != '\n' && raw[i] != '\r' && n < 127)
		{
			line[n] = raw[i];
			n++;
			i++;
		}
		line[n] = 0;

		while (i < size && (raw[i] == '\n' || raw[i] == '\r'))
			i++;

		if (!n)
			goto qcl_next;

		v = QCfgValue(line);

		if (!StrNICompare(line, "sensitivity ", 12))
			q_opt_sensitivity = ToF64(v) / 1000.0;
		else if (!StrNICompare(line, "volume ", 7))
			q_opt_volume = ClampI64(v, 0, 100);
		else if (!StrNICompare(line, "res ", 4))
			q_opt_res = ClampI64(v, 0, QRES_COUNT - 1);
		else if (!StrNICompare(line, "gunclip ", 8))
			q_opt_gunclip = ToBool(v != 0);
		else if (!StrNICompare(line, "topcolor ", 9))
			q_setup_top = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "bottomcolor ", 12))
			q_setup_bottom = ClampI64(v, 0, 13);
		else if (!StrNICompare(line, "name ", 5))
			QStrCopy(q_setup_name, line + 5, 16);
		else if (!StrNICompare(line, "fullscreen ", 11))
			q_opt_fullscreen = ToBool(v);
		else if (!StrNICompare(line, "gamma ", 6))
			q_opt_gamma = ToF64(v) / 1000.0;

qcl_next:
	}

	Free(raw);

	//Clamp anything a hand-edited file could have put out of range, then push
	//the values that own hardware state.
	if (q_opt_sensitivity < 0.02)	q_opt_sensitivity = 0.02;
	if (q_opt_sensitivity > 0.60)	q_opt_sensitivity = 0.60;

	//Scale our own mix rather than the AC97 master: that register is system
	//wide, so writing it made Quake's slider move the whole machine's volume
	//and override whatever the desktop was set to.
	q_snd_master = ToF64(q_opt_volume) / 100.0;
	QPalSetGamma(q_opt_gamma);
}

//The menu is authored for a 320x200 screen. Everything with a fixed
//coordinate is offset by this so the page stays together as one block instead
//of some parts hugging the left edge while the artwork centres itself.
//M_DrawPic in the original adds exactly the same term.
#define QMENU_VW	320

//Slider widget, drawn with the conchars slider pieces exactly as M_DrawSlider
//does: 128 is the left cap, 129 the repeated trough, 130 the right cap, and 131
//the handle. A range of 0..1 positions the handle across the trough.
#define QSLIDER_CELLS	10

U0 QMenuBackdrop(CQCanvas *c)
{//What sits behind a menu page.
 //
 //M_Draw's own rule: with a game running the world stays visible and is dimmed,
 //so the menu reads as an overlay and the player can see what they are going
 //back to. Only outside a game - or with the console down - does the console
 //artwork fill the screen.
	if (q_menu_ingame)
	{
		QDrawFadeScreen(c);
		return;
	}

	MemSet(c->pixels, 0, c->width * c->height);

	if (q_pic_conback.pixels)
		QPicDrawFill(c, &q_pic_conback);
}

U0 QMenuSlider(CQCanvas *c, I64 x, I64 y, F64 range)
{
	I64 i;

	if (range < 0.0)	range = 0.0;
	if (range > 1.0)	range = 1.0;

	QCharDraw(c, x - QCHAR_W, y, 128);

	for (i = 0; i < QSLIDER_CELLS; i++)
		QCharDraw(c, x + i * QCHAR_W, y, 129);

	QCharDraw(c, x + QSLIDER_CELLS * QCHAR_W, y, 130);

	QCharDraw(c, x + ToI64((QSLIDER_CELLS - 1) * QCHAR_W * range), y, 131);
}

I64 QMenuXOfs(CQCanvas *c)
{
	I64 ofs = (c->width - QMENU_VW) / 2;

	if (ofs < 0)
		ofs = 0;

	return ofs;
}

U0 QMenuSound(U8 *name)
{
	QSndPlayAt(name, q_snd_listener, 1.0, 0.0);
}

U0 QMenuInit()
{
	U8	name[24];
	I64	i;

	QPicLoad("gfx/mainmenu.lmp", &q_pic_mainmenu);
	QPicLoad("gfx/ttl_main.lmp", &q_pic_ttlmain);
	QPicLoad("gfx/qplaque.lmp", &q_pic_qplaque);
	QPicLoad("gfx/conback.lmp", &q_pic_conback);

	for (i = 0; i < QHELP_PAGES; i++)
	{
		StrPrint(name, "gfx/help%d.lmp", i);
		QPicLoad(name, &q_pic_help[i]);
	}
	QPicLoad("gfx/sp_menu.lmp", &q_pic_sp_menu);
	QPicLoad("gfx/p_multi.lmp", &q_pic_p_multi);
	QPicLoad("gfx/mp_menu.lmp", &q_pic_mp_menu);
	QPicLoad("gfx/p_option.lmp", &q_pic_p_option);
	QPicLoad("gfx/menuplyr.lmp", &q_pic_menuplyr);

	for (i = 0; i < 6; i++)
	{
		StrPrint(name, "gfx/menudot%d.lmp", i + 1);
		QPicLoad(name, &q_pic_cursor[i]);
	}

	for (i = 0; i < QCON_LINES; i++)
		q_con_time[i] = -1000.0;

	for (i = 0; i < QCON_LINES * QCON_WIDTH; i++)
		q_con_text[i] = 0;

	q_con_line     = 0;
	q_con_ready    = TRUE;
	q_state        = QST_MENU;
	q_menu_row     = 0;
	q_menu_ingame  = FALSE;
	q_quit_request = FALSE;
}

U0 QConPrint(U8 *s)
{//Append to the console scrollback, WRAPPING rather than truncating.
 //
 //The console is 40 columns. Silently dropping the tail of a longer line hides
 //exactly the information worth reading - the netstat mismatch count vanished
 //this way, and QuakeC's own sprint output is not width-aware either. Anything
 //over the limit continues on the next line instead.
	I64	 i = 0;
	I64	 n;
	U8	*row;

	if (!q_con_ready)
		return;

	//An empty string still costs a blank line, which is what a caller printing
	//"" is asking for.
	while (TRUE)
	{
		row = q_con_text + (q_con_line % QCON_LINES) * QCON_WIDTH;
		n   = 0;

		while (s[i] && n < QCON_WIDTH - 1)
		{
			row[n] = s[i];
			n++;
			i++;
		}

		row[n] = 0;
		q_con_time[q_con_line % QCON_LINES] = tS;
		q_con_line++;

		if (!s[i])
			return;
	}
}

//--- console input ---------------------------------------------------------
//
// CharGet and KeyGet both BLOCK, which would stall the render loop, so typing
// is driven from the same non-blocking scancode polling the game uses. Each
// key needs its own edge detection or one press repeats for every frame it is
// held - at ~190fps that is a screenful of characters per tap.

#define QCON_INPUT_MAX	62

U8	 q_con_input[QCON_INPUT_MAX + 2];
I64	 q_con_input_len	= 0;
U8	 q_key_prev[256];

//messagemode (Y): chat prompt without opening console. Matches Key_Message.
Bool q_msg_mode		= FALSE;
Bool q_msg_team		= FALSE;
U8	 q_chat_buf[32];
I64	 q_chat_len		= 0;

Bool q_con_want_noclip	= FALSE;	//console asked for a noclip toggle
Bool q_con_want_quit	= FALSE;

//Characters the console accepts. Enough for map names and commands.
//Printable keys, one entry per SCANCODE. The minus key is deliberately absent:
//it carries both '-' and '_', and since this table is walked by character and
//mapped to a scancode with Char2ScanCode, whichever of the two came first always
//won - which is why typing sv_cheats produced sv-cheats. That key is handled
//separately below, where the shift state can be consulted.
U8 *q_con_charset = "abcdefghijklmnopqrstuvwxyz0123456789 ./";

U0 QConInputReset()
{
	I64 i;

	for (i = 0; i < 256; i++)
		q_key_prev[i] = 0;

	q_con_input[0]   = 0;
	q_con_input_len  = 0;
	q_con_want_noclip = FALSE;
	q_con_want_quit   = FALSE;
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

Bool QConKeyEdge(I64 sc)
{//TRUE only on the frame a key goes down.
	Bool down;
	Bool was;

	if (sc <= 0 || sc >= 256)
		return FALSE;

	down = ToBool(Bt(kbd.down_bitmap, sc));
	was  = ToBool(q_key_prev[sc]);

	if (down)
		q_key_prev[sc] = 1;
	else
		q_key_prev[sc] = 0;

	return ToBool(down && !was);
}

//--- console command helpers ------------------------------------------------

//FL_ bits from the original's defs.qc.
#define QFL_GODMODE_	64
#define QFL_NOTARGET_	128

F64  q_con_fov_want	= 0.0;	//non-zero = console asked for a new fov
Bool q_con_want_save	= FALSE;
Bool q_con_want_load	= FALSE;
Bool q_con_save_ok		= TRUE;

//The mismatch count is produced by the app shell, which is compiled after this
//file, so the console reads a copy the shell publishes rather than the counter
//itself.
I64 q_net_mismatch_report = 0;
U8  q_con_net_line[128];

U0 QConDrainProgs()
{//Move whatever QuakeC printed into the console, one line per newline.
	U8	line[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (q_bi_print_len < 1)
		return;

	for (i = 0; i < q_bi_print_len; i++)
	{
		c = q_bi_print_buf[i];

		if (c == '\n' || n >= 126)
		{
			line[n] = 0;
			if (n > 0)
				QConPrint(line);
			n = 0;
		}

		if (c != '\n')
		{
			line[n] = c;
			n++;
		}
	}

	//A final fragment with no newline is still shown. QuakeC does not always
	//terminate its lines, and holding the tail back until the next print would
	//stall it indefinitely.
	if (n > 0)
	{
		line[n] = 0;
		QConPrint(line);
	}

	q_bi_print_len    = 0;
	q_bi_print_buf[0] = 0;
}

U32 QConParseIPV4(U8 *s)
{//Dotted quad to a host-order U32. 0 means unparsable.
	I64 part[4];
	I64 n = 0;
	I64 v;
	I64 digits;
	I64 i = 0;

	while (n < 4)
	{
		v      = 0;
		digits = 0;

		while (s[i] >= '0' && s[i] <= '9')
		{
			v = v * 10 + (s[i] - '0');
			digits++;
			i++;

			if (v > 255)
				return 0;
		}

		if (!digits)
			return 0;

		part[n] = v;
		n++;

		if (n < 4)
		{
			if (s[i] != '.')
				return 0;
			i++;
		}
	}

	//Anything trailing means it was not a bare address.
	if (s[i] && s[i] != ' ')
		return 0;

	//IPV4PacketAllocate takes the address in the same layout ipv4_globals holds
	//it, which is little-endian host order with the first octet in the LOW byte.
	return part[0] | (part[1] << 8) | (part[2] << 16) | (part[3] << 24);
}

U0 QConConnect(U8 *args)
{
	U8	msg[96];
	U32	ip;
	U32	me;

	if (!QNetUdpAvailable())
	{
		QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
		return;
	}

	ip = QConParseIPV4(args);
	if (!ip)
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	//An address is chosen automatically when the link has no DHCP server, which
	//is the normal case for a direct VM-to-VM cable. `qip` overrides it.
	QNetAutoIP(ip);

	if (!QNetUdpOpen(QNET_PORT_DEFAULT))
	{
		QConPrint(q_udp_status);
		return;
	}

	q_udp_server = FALSE;
	QNetDgrmInit;
	QNetUdpSetPeer(ip);

	//Report BOTH ends. "connecting to X" alone hides the most common mistake,
	//which is the two machines sharing an address.
	//Resolve the server's MAC HERE, where a stall is acceptable, so the frame
	//loop never has to. This doubles as the reachability test: no ARP reply
	//means the other machine is not on the wire at all.
	if (!QNetUdpResolvePeer)
	{
		QConPrint("no arp reply - is the other vm up and on this link?");
		return;
	}

	//Ask to join immediately rather than waiting for the retry tick.
	QNetClientSendConnect(q_setup_name, q_setup_top, q_setup_bottom);

	me = QNetLocalIP();

	StrPrint(msg, "me %d.%d.%d.%d -> server %d.%d.%d.%d",
		me & 255, (me >> 8) & 255, (me >> 16) & 255, (me >> 24) & 255,
		ip & 255, (ip >> 8) & 255, (ip >> 16) & 255, (ip >> 24) & 255);
	QConPrint(msg);
}

Bool QConCvarCommand(U8 *line)
{//Cvar_Command. TRUE when the line named a cvar, whether it set or reported it.
	U8	name[24];
	U8	out[64];
	I64	i = 0;
	I64	j;

	while (line[i] && line[i] != ' ' && i < 23)
	{
		name[i] = line[i];
		i++;
	}
	name[i] = 0;

	//UNKNOWN NAMES ARE REJECTED, unlike QCvarSet which creates on demand. A
	//typo silently becoming a new cvar would report success for a setting that
	//does nothing at all.
	if (QCvarIndex(name) < 0)
		return FALSE;

	j = i;
	while (line[j] == ' ')
		j++;

	if (!line[j])
	{
		StrPrint(out, "\"%s\" is \"%4.2f\"", name, QCvarGet(name));
		QConPrint(out);
		return TRUE;
	}

	QCvarSet(name, QAtoF(line + j));

	StrPrint(out, "%s set to %4.2f", name, QCvarGet(name));
	QConPrint(out);

	return TRUE;
}

U0 QConCvar(U8 *args)
{//"name value" sets, bare "name" reports. Cvar_Command does exactly this.
	U8	 name[24];
	U8	 line[64];
	I64	 i = 0;
	I64	 j;

	while (args[i] && args[i] != ' ' && i < 23)
	{
		name[i] = args[i];
		i++;
	}
	name[i] = 0;

	if (!name[0])
		return;

	j = i;
	while (args[j] == ' ')
		j++;

	if (!args[j])
	{
		StrPrint(line, "\"%s\" is \"%5.2f\"", name, QCvarGet(name));
		QConPrint(line);
		return;
	}

	QCvarSet(name, QAtoF(args + j));
	StrPrint(line, "%s set to %5.2f", name, QCvarGet(name));
	QConPrint(line);
}

U0 QConCheatFlag(I64 bit, U8 *name)
{//XOR a flag bit on the player and report the new state. Host_God_f's shape.
	U8	msg[64];
	I64	flags;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	flags = ToI64(QPrFieldF(q_player_edict, q_fld_flags));
	flags = flags ^ bit;
	QPrSetFieldF(q_player_edict, q_fld_flags, ToF64(flags));

	if (flags & bit)
		StrPrint(msg, "%s ON", name);
	else
		StrPrint(msg, "%s OFF", name);

	QConPrint(msg);
}

U0 QConRunPlayerFunc(U8 *name)
{//Call a QuakeC function with self = the player, the way the host commands do.
	I64 fn = QPrFindFunction(name);

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	if (fn <= 0)
	{
		QConPrint("no such QuakeC function");
		return;
	}

	QPrSetI(q_ofs_self, QPrEdictValue(q_player_edict));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;
}

//Host_Impulse_f sets cl.impulse, which the NEXT move message carries; it does
//not poke the edict. Writing the field directly here was pointless - the input
//block overwrites .impulse every tick - so the request is queued for that block
//to deliver instead, and it survives exactly one tick.
I64 q_con_impulse_want = 0;

U0 QConImpulse(I64 n)
{//Host_Impulse_f.
	U8 msg[48];

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	q_con_impulse_want = n;
	StrPrint(msg, "impulse %d", n);
	QConPrint(msg);
}

U0 QConGive(U8 *args)
{//Host_Give_f. First character selects what, the number that follows is the
 //amount; a digit gives the matching weapon by setting its .items bit.
	U8	msg[64];
	I64	v = 0;
	I64	i = 0;
	I64	items;
	U8	what;

	if (!q_player_active || q_player_edict <= 0)
	{
		QConPrint("no player");
		return;
	}

	what = args[0];

	//Skip to the number, if there is one.
	while (args[i] && args[i] != ' ')
		i++;
	while (args[i] == ' ')
		i++;
	if (args[i])
		v = Str2I64(args + i);

	if ('2' <= what <= '8')
	{
		//IT_SHOTGUN << (n - 2), the original's own expression. IT_SHOTGUN is 1.
		items = ToI64(QPrFieldF(q_player_edict, q_fld_items));
		items = items | (1 << (what - '2'));
		QPrSetFieldF(q_player_edict, q_fld_items, ToF64(items));
		StrPrint(msg, "gave weapon %c", what);
	}
	else if (what == 's' && q_fld_ammo_shells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_shells, ToF64(v));
		StrPrint(msg, "shells %d", v);
	}
	else if (what == 'n' && q_fld_ammo_nails >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_nails, ToF64(v));
		StrPrint(msg, "nails %d", v);
	}
	else if (what == 'r' && q_fld_ammo_rockets >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_rockets, ToF64(v));
		StrPrint(msg, "rockets %d", v);
	}
	else if (what == 'c' && q_fld_ammo_cells >= 0)
	{
		QPrSetFieldF(q_player_edict, q_fld_ammo_cells, ToF64(v));
		StrPrint(msg, "cells %d", v);
	}
	else if (what == 'h')
	{
		QPrSetFieldF(q_player_edict, q_fld_health, ToF64(v));
		StrPrint(msg, "health %d", v);
	}
	else
		StrPrint(msg, "give: s n r c h or 2-8");

	QConPrint(msg);
}

U0 QConStatus()
{//Host_Status_f, reduced to what a single-player build can report.
	U8 msg[96];

	StrPrint(msg, "map %s", q_map_name);
	QConPrint(msg);

	StrPrint(msg, "edicts %d  time %4.1f", q_pr_num_edicts, q_game_time);
	QConPrint(msg);

	if (q_player_active)
	{
		StrPrint(msg, "health %d  armor %d  ammo %d",
			ToI64(QPlayerHealth), ToI64(QPlayerArmor), ToI64(QPlayerAmmo));
		QConPrint(msg);
	}
}

Bool q_con_want_bf = FALSE;

U0 QConExec(U8 *line)
{//A small command set. Unknown input is echoed rather than silently ignored,
 //so a typo is visibly a typo.
	U8  msg[80];
	U8 *role;
	U32 myip;
	I64 si;
	I64 e;
	CQNetSock *sock;

	if (!line[0])
		return;

	StrPrint(msg, "]%s", line);
	QConPrint(msg);

	//--- level control ---
	if (!StrNICompare(line, "map ", 4))
	{
		QStrCopy(q_change_map, line + 4, 64);
		q_change_pending = TRUE;
		return;
	}

	if (!StrNICompare(line, "changelevel ", 12))
	{
		QStrCopy(q_change_map, line + 12, 64);
		q_change_pending = TRUE;
		return;
	}

	//netstat - what the client/server split is actually doing. Not an original
	//command; `net_stats` in the original is close.
	if (!StrICompare(line, "netstat"))
	{
		//Kept inside 40 columns each. The mismatch count gets a line of its own
		//because it is the one number that decides whether the client's
		//reconstruction can be trusted to draw from.
		StrPrint(q_con_net_line, "net: %d ents, %d bytes, %d parsed",
			q_net_num_ents, q_net_datagram.len, q_net_parsed);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: MISMATCHED %d, dropped %d",
			q_net_mismatch_report, q_net_dropped);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: hp %d ar %d am %d wp %d",
			q_cl.health, q_cl.armorvalue, q_cl.currentammo, q_cl.weapon);
		QConPrint(q_con_net_line);

		StrPrint(q_con_net_line, "net: %d clients connected",
			q_sv_client_count);
		QConPrint(q_con_net_line);

		//Host diagnosis: where is each remote body right now?
		if (q_udp_ready && q_udp_server)
		{
			for (si = 0; si < QSV_MAX_CLIENTS; si++)
			{
				if (!q_sv_clients[si].active || q_sv_clients[si].local)
					goto ns_next;

				e = q_sv_clients[si].edict;
				if (e > 0)
					StrPrint(q_con_net_line,
						"net: remote[%d] edict %d at %.0f %.0f %.0f mdl %d",
						si, e,
						q_sv_clients[si].origin[0],
						q_sv_clients[si].origin[1],
						q_sv_clients[si].origin[2],
						ToI64(QPrFieldF(e, q_fld_modelindex)));
				else
					StrPrint(q_con_net_line,
						"net: remote[%d] edict 0 (not spawned)", si);
				QConPrint(q_con_net_line);

				sock = QNetDgrmSock(si);
				if (sock && sock->active)
				{
					StrPrint(q_con_net_line,
						"net: remote[%d] udp %d.%d.%d.%d:%d signon %d",
						si,
						sock->ip & 255, (sock->ip >> 8) & 255,
						(sock->ip >> 16) & 255, (sock->ip >> 24) & 255,
						sock->port, q_sv_clients[si].signon);
					QConPrint(q_con_net_line);
				}

ns_next:
			}
		}

		StrPrint(q_con_net_line, "net: moves %d/%d ping %4.1fms",
			q_net_moves_sent, q_net_moves_read, q_net_move_ping * 1000.0);
		QConPrint(q_con_net_line);

		QConPrint(q_udp_status);

		myip = QNetLocalIP();
		StrPrint(q_con_net_line, "udp: local ip %d.%d.%d.%d",
			myip & 255, (myip >> 8) & 255,
			(myip >> 16) & 255, (myip >> 24) & 255);
		QConPrint(q_con_net_line);

		if (q_udp_ready)
		{
			if (q_udp_server)
				role = "hosting";
			else
				role = "joined";

			StrPrint(q_con_net_line, "udp: %s peer %d.%d.%d.%d",
				role,
				q_udp_peer_ip & 255, (q_udp_peer_ip >> 8) & 255,
				(q_udp_peer_ip >> 16) & 255, (q_udp_peer_ip >> 24) & 255);
			QConPrint(q_con_net_line);

			StrPrint(q_con_net_line, "udp: %d sent %d recvd %d err %d unresolved",
				q_udp_sent, q_udp_recvd, q_udp_errors, q_udp_unresolved);
			QConPrint(q_con_net_line);

			if (q_udp_peer_ip)
			{
				if (QNetUdpPeerResolved)
					QConPrint("udp: peer mac RESOLVED");
				else
				{
					StrPrint(q_con_net_line,
						"udp: peer mac UNRESOLVED, %d sends skipped",
						q_udp_unresolved);
					QConPrint(q_con_net_line);
				}
			}
		}
		return;
	}

	//qip <a.b.c.d> - static address, for a link with no DHCP server. Two QEMU
	//guests wired together with -netdev socket are exactly that case.
	if (!StrNICompare(line, "qip ", 4))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC, not Run.ZC");
			return;
		}

		//The status line is printed either way: on failure it now says WHICH
		//failure, rather than leaving whatever the last operation set.
		QNetUdpSetLocalIP(QConParseIPV4(line + 4));
		QConPrint(q_udp_status);
		return;
	}

	//netdhcp - ask a DHCP server for an address. Only useful on a link that has
	//one; a direct VM-to-VM link does not, and this will simply time out there.
	if (!StrICompare(line, "netdhcp"))
	{
		if (!QNetUdpAvailable())
		{
			QConPrint("no net stack - run RunNet.ZC");
			return;
		}

		QConPrint("dhcp: asking, this may take a few seconds...");
		QNetDhcp;
		QConPrint(q_udp_status);
		return;
	}

	//stairlog 1 - record every step-up attempt and whether it was kept.
	if (!StrNICompare(line, "stairlog ", 9))
	{
		q_stair_log     = ToBool(Str2I64(line + 9) != 0);
		q_stair_reports = 0;

		if (q_stair_log)
			QConPrint("stair logging ON - see QUAKELOG.TXT");
		else
			QConPrint("stair logging off");
		return;
	}

	//bf - V_BonusFlash_f. QuakeC stuffs this at the client for every pickup and
	//while a powerup runs out, so it arrives far more often than it is typed.
	if (!StrICompare(line, "bf"))
	{
		q_con_want_bf = TRUE;
		return;
	}

	//music <n> / music stop - CDAudio_Play and CDAudio_Stop.
	if (!StrNICompare(line, "music ", 6))
	{
		if (!StrICompare(line + 6, "stop"))
		{
			QMusicFree;
			AudioSFXStopAll;
			QConPrint("music stopped");
		}
		else
		{
			QMusicPlay(Str2I64(line + 6), tS);
			QConPrint(q_music_status);
		}
		return;
	}

	//connect <ip> - Host_Connect_f. Parses dotted quad itself rather than going
	//through PresentationToNetwork, so this file compiles with no net stack.
	if (!StrNICompare(line, "connect ", 8))
	{
		QConConnect(line + 8);
		return;
	}

	//Bare `connect` with no argument used to fall through to the cvar lookup and
	//come back as "unknown command", which reads as the command not existing.
	if (!StrICompare(line, "connect"))
	{
		QConPrint("usage: connect 10.0.0.1");
		return;
	}

	if (!StrICompare(line, "disconnect"))
	{
		QNetUdpClose;
		q_cl_viewent = 0;
		QConPrint("disconnected");
		return;
	}

	//say / say_team / tell - Host_Say_f via Cmd_ForwardToServer (clc_stringcmd).
	//Listen host: console pauses the server tick, so Host_Say runs here directly
	//(same function the stringcmd path uses). Guest: forward over UDP.
	if (!StrNICompare(line, "say_team ", 9))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 9, TRUE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say_team\", not connected");
		return;
	}
	if (!StrICompare(line, "say_team"))
	{
		QConPrint("usage: say_team <text>");
		return;
	}
	if (!StrNICompare(line, "say ", 4))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostSay(QSvFindLocalSlot, line + 4, FALSE);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"say\", not connected");
		return;
	}
	if (!StrICompare(line, "say"))
	{
		QConPrint("usage: say <text>");
		return;
	}
	if (!StrNICompare(line, "tell ", 5))
	{
		if (q_udp_ready && !q_udp_server)
			QNetClientSendStringCmd(line);
		else if (q_game_active)
		{
			QHostTell(QSvFindLocalSlot, line + 5);
			QConDrainProgs;
		}
		else
			QConPrint("Can't \"tell\", not connected");
		return;
	}
	if (!StrICompare(line, "tell"))
	{
		QConPrint("usage: tell <name> <text>");
		return;
	}

	if (!StrICompare(line, "host"))
	{
		//SLIRP/Ironwail: prefer DHCP (10.0.2.15). AutoIP 10.0.0.1 is for
		//socket MP only and breaks hostfwd replies.
		if (!QNetLocalIP)
			QNetDhcp;
		if (!QNetLocalIP)
			QNetAutoIP(0);

		if (QNetUdpOpen(QNET_PORT_DEFAULT))
		{
			q_udp_server = TRUE;
			QNetDgrmInit;
			QConPrint(q_udp_status);
			QConPrint("hosting - clients may connect to this ip");
		}
		else
			QConPrint(q_udp_status);
		return;
	}

	//diskwrite 0|1 - suppress every write this app makes, for bisecting the
	//crash on quit. Not an original command.
	if (!StrNICompare(line, "diskwrite ", 10))
	{
		q_disk_writes = ToBool(Str2I64(line + 10) != 0);
		if (q_disk_writes)
			QConPrint("disk writes enabled");
		else
			QConPrint("disk writes DISABLED");
		return;
	}

	//Cvars: `name value` sets, `name` reports - the behaviour of an unmatched
	//token in Cmd_ExecuteString, which falls through to Cvar_Command.
	if (!StrNICompare(line, "set ", 4))
	{
		QConCvar(line + 4);
		return;
	}

	if (!StrICompare(line, "restart"))
	{
		//Same command QuakeC's respawn() issues on a single-player death.
		q_restart_pending = TRUE;
		return;
	}

	//--- movement cheats. Host_Noclip_f and Host_Fly_f swap the movetype; the
	//--- engine's own flycam stands in for noclip here since QuakeC's player
	//--- movement is driven from this side.
	if (!StrICompare(line, "noclip"))
	{
		q_con_want_noclip = TRUE;
		QConPrint("noclip toggled");
		return;
	}

	if (!StrICompare(line, "fly"))
	{
		q_con_want_noclip = TRUE;
		QConPrint("fly mode toggled");
		return;
	}

	//--- flag cheats, exactly as Host_God_f and Host_Notarget_f do it: XOR the
	//--- bit and report the resulting state.
	if (!StrICompare(line, "god"))
	{
		QConCheatFlag(QFL_GODMODE_, "godmode");
		return;
	}

	if (!StrICompare(line, "notarget"))
	{
		QConCheatFlag(QFL_NOTARGET_, "notarget");
		return;
	}

	if (!StrICompare(line, "kill"))
	{
		QConRunPlayerFunc("ClientKill");
		return;
	}

	//--- impulse: QuakeC consumes .impulse once, which is how every weapon
	//--- switch and cheat code in the game is delivered.
	if (!StrNICompare(line, "impulse ", 8))
	{
		QConImpulse(Str2I64(line + 8));
		return;
	}

	if (!StrNICompare(line, "give ", 5))
	{
		QConGive(line + 5);
		return;
	}

	if (!StrNICompare(line, "fov ", 4))
	{
		//q_fov lives in the app shell, which is compiled AFTER this file, so the
		//value is requested rather than written directly.
		q_con_fov_want = ToF64(Str2I64(line + 4));
		if (q_con_fov_want < 30.0)	q_con_fov_want = 30.0;
		if (q_con_fov_want > 130.0)	q_con_fov_want = 130.0;
		StrPrint(msg, "fov %d", ToI64(q_con_fov_want));
		QConPrint(msg);
		return;
	}

	if (!StrICompare(line, "save"))
	{
		if (q_con_save_ok)
			QConPrint("saved");
		else
			QConPrint("save failed");
		q_con_want_save = TRUE;
		return;
	}

	if (!StrICompare(line, "load"))
	{
		q_con_want_load = TRUE;
		return;
	}

	if (!StrICompare(line, "status"))
	{
		QConStatus;
		return;
	}

	if (!StrICompare(line, "version"))
	{
		QConPrint("Quake shareware data, engine written for ZealOS");
		return;
	}

	if (!StrICompare(line, "quit"))
	{
		q_con_want_quit = TRUE;
		return;
	}

	if (!StrICompare(line, "help"))
	{
		QConPrint("map <n>  changelevel <n>  restart  save  load");
		QConPrint("god  notarget  noclip  fly  kill");
		QConPrint("impulse <n>  give <s|n|r|c|h|1-8> <v>  fov <n>");
		QConPrint("say <text>  say_team <text>  tell <name> <text>");
		QConPrint("status  version  quit");
		return;
	}

	//LAST RESORT: a bare `name value` is a cvar assignment, and `name` alone
	//reports it. Cmd_ExecuteString does exactly this - it looks for a command,
	//then falls through to Cvar_Command - which is why the original has no
	//`set` keyword at all. Without the fallthrough every cvar had to be spelled
	//`set deathmatch 1`, and typing what the original accepts got "unknown
	//command".
	if (QConCvarCommand(line))
		return;

	QConPrint("unknown command");
}

U0 QMsgModeBegin(Bool team)
{//Con_MessageMode_f / Con_MessageMode2_f.
	q_msg_mode  = TRUE;
	q_msg_team  = team;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeCancel()
{
	q_msg_mode  = FALSE;
	q_msg_team  = FALSE;
	q_chat_buf[0] = 0;
	q_chat_len    = 0;
}

U0 QMsgModeInput()
{//Key_Message: type into chat_buffer, Enter sends say / say_team.
 //After QConExec - HolyC is single-pass.
	I64	 i;
	I64	 sc;
	U8	 ch;
	U8	 cmd[48];

	if (!q_msg_mode)
		return;

	if (QConKeyEdge(SC_ESC))
	{
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		if (q_chat_len > 0)
		{
			if (q_msg_team)
				StrPrint(cmd, "say_team %s", q_chat_buf);
			else
				StrPrint(cmd, "say %s", q_chat_buf);
			QConExec(cmd);
		}
		QMsgModeCancel;
		return;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_chat_len > 0)
	{
		q_chat_len--;
		q_chat_buf[q_chat_len] = 0;
		return;
	}

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);
		if (QConKeyEdge(sc) && q_chat_len < 31)
		{
			q_chat_buf[q_chat_len] = ch;
			q_chat_len++;
			q_chat_buf[q_chat_len] = 0;
		}
		i++;
	}

	if (QConKeyEdge(Char2ScanCode('-')) && q_chat_len < 31)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			q_chat_buf[q_chat_len] = '_';
		else
			q_chat_buf[q_chat_len] = '-';
		q_chat_len++;
		q_chat_buf[q_chat_len] = 0;
	}
}

U0 QConDrainStuff()
{//Run whatever QuakeC pushed with stuffcmd, one command per newline. This is
 //Cbuf_Execute, and going through the ordinary console executor is the point -
 //stuffcmd text IS console text, so anything the console understands works.
	U8	cmd[128];
	I64	n = 0;
	I64	i;
	U8	c;

	if (q_bi_stuff_len < 1)
		return;

	for (i = 0; i < q_bi_stuff_len; i++)
	{
		c = q_bi_stuff_buf[i];

		if (c == '\n' || c == ';' || n >= 126)
		{
			cmd[n] = 0;
			if (n > 0)
				QConExec(cmd);
			n = 0;
		}

		if (c != '\n' && c != ';')
		{
			cmd[n] = c;
			n++;
		}
	}

	if (n > 0)
	{
		cmd[n] = 0;
		QConExec(cmd);
	}

	q_bi_stuff_len    = 0;
	q_bi_stuff_buf[0] = 0;
}

U0 QConInput()
{//Poll one frame of typing.
	I64 i;
	I64 sc;
	I64 ch;

	//Printable characters.
	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_con_input_len < QCON_INPUT_MAX)
		{
			q_con_input[q_con_input_len] = ch;
			q_con_input_len++;
			q_con_input[q_con_input_len] = 0;
		}

		i++;
	}

	//The minus key, resolved by shift: '_' when held, '-' when not. One edge
	//check for the key, so the two characters cannot fight over it.
	if (QConKeyEdge(Char2ScanCode('-')) && q_con_input_len < QCON_INPUT_MAX)
	{
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			q_con_input[q_con_input_len] = '_';
		else
			q_con_input[q_con_input_len] = '-';

		q_con_input_len++;
		q_con_input[q_con_input_len] = 0;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_con_input_len > 0)
	{
		q_con_input_len--;
		q_con_input[q_con_input_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		QConExec(q_con_input);
		q_con_input[0]  = 0;
		q_con_input_len = 0;
	}
}

U0 QConDrawNotify(CQCanvas *c)
{//Con_DrawNotify: the newest few lines, top left, while they are still fresh.
 //Drawn only when the console itself is NOT down, exactly as the original does
 //- otherwise the same text would appear twice.
	I64	 i;
	I64	 line;
	I64	 y = 0;
	I64	 x;
	U8	*row;
	U8	 prompt[16];

	if (!q_con_ready)
		return;

	for (i = QCON_NOTIFY_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qcn_next;

		if (tS - q_con_time[line % QCON_LINES] > QCON_NOTIFY_TIME)
			goto qcn_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0])
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qcn_next:
	}

	//messagemode prompt under notify lines (Con_DrawNotify key_message branch).
	if (q_msg_mode)
	{
		if (q_msg_team)
			StrPrint(prompt, "say_team:");
		else
			StrPrint(prompt, "say:");
		QStrDraw(c, 8, y, prompt);
		x = 8 + StrLen(prompt) * QCHAR_W;
		QStrDraw(c, x, y, q_chat_buf);
		if ((ToI64(tS * 4.0) & 1) == 0)
			QStrDraw(c, x + q_chat_len * QCHAR_W, y, "_");
	}
}

U0 QConDraw(CQCanvas *c)
{//Console slides over the top of whatever is behind it.
	I64	 i;
	I64	 line;
	I64	 y;
	I64	 con_h;
	U8	*row;

	//The console drops over the top FRACTION of the screen, so its height has to
	//scale with the render target rather than being a fixed 128 pixels - at
	//640x480 a fixed slice covers a quarter of the view and leaves the 320-wide
	//background stopping part way across.
	con_h = c->height / 2;
	if (con_h < QCON_HEIGHT)
		con_h = QCON_HEIGHT;

	if (q_pic_conback.pixels)
		QPicDrawFillPart(c, &q_pic_conback, con_h);

	//Oldest visible line first, so new text appears at the bottom.
	y = 4;
	for (i = QCON_LINES; i > 0; i--)
	{
		line = q_con_line - i;
		if (line < 0)
			goto qc_next;

		row = q_con_text + (line % QCON_LINES) * QCON_WIDTH;
		if (row[0] && y + QCHAR_H < con_h)
		{
			QStrDraw(c, 8, y, row);
			y += QCHAR_H;
		}

qc_next:
	}

	//Prompt with the line being typed and a blinking caret.
	QStrDraw(c, 8, con_h - QCHAR_H - 2, "]");
	QStrDraw(c, 8 + QCHAR_W, con_h - QCHAR_H - 2, q_con_input);

	if (ToI64(tS * 3.0) & 1)
		QStrDraw(c, 8 + QCHAR_W * (q_con_input_len + 1),
			con_h - QCHAR_H - 2, "_");
}

U0 QMenuPlaque(CQCanvas *c, CQPic *title)
{//The furniture every submenu shares: the QUAKE spine and a title plaque,
 //placed the way M_Multiplayer_Draw and friends place them.
	I64 mx = QMenuXOfs(c);

	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, mx + 16, 4);

	if (title && title->pixels)
		QPicDraw(c, title, mx + (QMENU_VW - title->width) / 2, 4);
}

U0 QMenuCursor(CQCanvas *c, I64 x, I64 y)
{//The same six-frame 10Hz cursor the main menu uses.
	I64 frame = ToI64(tS * 10.0) % 6;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);
}

U0 QOptDraw(CQCanvas *c)
{//Options page. Values are shown as text next to each label.
	U8	line[64];
	I64	y = 60;
	I64	i;
	I64	mx;

	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_option);

	QStrDrawAlt(c, mx + 64, y, "mouse speed");
	QMenuSlider(c, mx + 220, y,
		(q_opt_sensitivity - 0.02) / (0.60 - 0.02));

	QStrDrawAlt(c, mx + 64, y + 16, "sound volume");
	QMenuSlider(c, mx + 220, y + 16, ToF64(q_opt_volume) / 100.0);

	StrPrint(line, "resolution    %dx%d",
		q_res_w[q_opt_res], q_res_h[q_opt_res]);
	QStrDrawAlt(c, mx + 64, y + 32, line);

	if (q_opt_fullscreen)
		StrPrint(line, "screen        fullscreen");
	else
		StrPrint(line, "screen        windowed");
	QStrDrawAlt(c, mx + 64, y + 48, line);

	//The bar fills as the picture brightens, which reads the right way round -
	//the underlying exponent goes the other way.
	QStrDrawAlt(c, mx + 64, y + 64, "brightness");
	QMenuSlider(c, mx + 220, y + 64,
		(QGAMMA_MAX - q_opt_gamma) / (QGAMMA_MAX - QGAMMA_MIN));

	//The gun-clipping row names the two renderers rather than saying on/off,
	//because "gun clipping off" reads as a bug rather than a choice.
	if (q_opt_gunclip)
		QStrDrawAlt(c, mx + 64, y + 80, "gun depth      gl (no clip)");
	else
		QStrDrawAlt(c, mx + 64, y + 80, "gun depth      software");

	QStrDrawAlt(c, mx + 64, y + 96, "back");

	//A simple caret marks the row; the spinning cursor belongs to the main
	//page and would be oversized here.
	i = y + q_opt_row * 16;
	QStrDrawAlt(c, mx + 48, i, ">");

	QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

U0 QNoticeDraw(CQCanvas *c)
{//A plain message page, used for the parts of the menu the shareware build
 //genuinely cannot offer.
	QMenuBackdrop(c);

	QStrDrawCenterAlt(c, 90, q_notice);
	QStrDrawCenterAlt(c, c->height - 20, "press enter or escape");
}

U0 QHelpDraw(CQCanvas *c)
{//M_Help_Draw: one full-screen picture per page, nothing else on it.
	CQPic *p = &q_pic_help[q_help_page];

	QMenuBackdrop(c);

	//The pages are authored at 320x200, so they are centred in the virtual box
	//rather than stretched - the same treatment the other menu artwork gets.
	if (p->pixels)
		QPicDraw(c, p, QMenuXOfs(c) + (QMENU_VW - p->width) / 2, 4);
	else
		QStrDrawCenterAlt(c, 90, "help pages not found in pak");

	QStrDrawCenterAlt(c, c->height - 20, "left/right pages, escape exits");
}

Bool QHelpKey(I64 sc)
{
	if (sc == SC_CURSOR_LEFT)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page--;
		if (q_help_page < 0)
			q_help_page = QHELP_PAGES - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_RIGHT || sc == SC_ENTER)
	{
		QMenuSound(QMSND_MOVE);
		q_help_page++;
		if (q_help_page >= QHELP_PAGES)
			q_help_page = 0;
		return TRUE;
	}

	return FALSE;
}

U0 QLanDraw(CQCanvas *c)
{//M_LanConfig_Draw: a title, an address field, and a JOIN row.
	U8	line[64];
	I64	mx = QMenuXOfs(c);
	I64	y  = 56;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawCenterAlt(c, 40, "join game - tcp/ip");

	QStrDrawAlt(c, mx + 56, y, "address");

	//The box is drawn as a plain field; the original uses M_DrawTextBox, which
	//needs the box tiles assembled from gfx/box_*.lmp.
	if (q_lan_editing)
		StrPrint(line, "%s_", q_lan_addr);
	else
		StrPrint(line, "%s", q_lan_addr);

	QStrDrawAlt(c, mx + 144, y, line);

	QStrDrawAlt(c, mx + 56, y + 24, "join game");
	QStrDrawAlt(c, mx + 56, y + 40, "back");

	if (q_lan_row == QLAN_ADDRESS)		QMenuCursor(c, mx + 40, y - 4);
	else if (q_lan_row == QLAN_JOIN)	QMenuCursor(c, mx + 40, y + 20);
	else								QMenuCursor(c, mx + 40, y + 36);

	if (q_lan_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type the address, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "enter selects, escape returns");
}

U0 QLanInput()
{//Typing an address. Digits and dots only, so the field cannot hold something
 //the parser will reject.
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_lan_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];

		if ((ch >= '0' && ch <= '9') || ch == '.')
		{
			sc = Char2ScanCode(ch);

			if (QConKeyEdge(sc) && q_lan_len < 23)
			{
				q_lan_addr[q_lan_len] = ch;
				q_lan_len++;
				q_lan_addr[q_lan_len] = 0;
			}
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_lan_len > 0)
	{
		q_lan_len--;
		q_lan_addr[q_lan_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_lan_editing   = FALSE;
		q_lan_ate_enter = TRUE;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QLanKey(I64 sc)
{
	if (q_lan_editing)
		return TRUE;

	//Same swallow as the setup name field: the ENTER that ended editing must
	//not be seen again here, or the field re-opens immediately.
	if (q_lan_ate_enter)
	{
		q_lan_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row--;
		if (q_lan_row < 0)
			q_lan_row = QLAN_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_lan_row++;
		if (q_lan_row >= QLAN_ROWS)
			q_lan_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_lan_row == QLAN_ADDRESS)
		{
			q_lan_editing = TRUE;
			q_lan_len     = StrLen(q_lan_addr);
		}
		else if (q_lan_row == QLAN_JOIN)
		{
			//Exactly what typing `connect <addr>` does, so there is one join
			//path rather than two that can drift apart.
			QConConnect(q_lan_addr);
			q_menu_page = QPAGE_MAIN;
		}
		else
			q_menu_page = QPAGE_MULTI;

		return TRUE;
	}

	return FALSE;
}

U0 QMultiDraw(CQCanvas *c)
{//M_Multiplayer_Draw. The rows are ARTWORK - gfx/mp_menu.lmp - not text in the
 //small console font, which is why this page looked nothing like the rest of
 //the menu.
	U8	line[64];
	I64	mx = QMenuXOfs(c);

	QMenuPlaque(c, &q_pic_p_multi);

	//JOIN A GAME / NEW GAME / SETUP arrive as one image at x=72, y=32, on the
	//original's 20 pixel row pitch.
	if (q_pic_mp_menu.pixels)
		QPicDraw(c, &q_pic_mp_menu, mx + 72, QMENU_Y);

	//The level row has no artwork - it lives on the Game Options page in the
	//original - so it keeps the small font, below the picture.
	StrPrint(line, "level          %s", QMPMapName(q_mp_map));
	QStrDrawAlt(c, mx + 72, QMENU_Y + 3 * QMENU_ROW_H, line);
	QStrDrawAlt(c, mx + 72, QMENU_Y + 4 * QMENU_ROW_H, "back");

	QMenuCursor(c, mx + 72 - 18, QMENU_Y + q_mp_row * QMENU_ROW_H - 4);

	//Say plainly what does and does not work. "join" needs a UDP socket, which
	//this build has no driver for; "new game" runs a real deathmatch server that
	//the local client connects to over the loopback link.
	if (QNetUdpAvailable())
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game hosts on this machine");
		QStrDrawCenterAlt(c, c->height - 20, "join: console, then connect <ip>");
	}
	else
	{
		QStrDrawCenterAlt(c, c->height - 30, "new game runs a local deathmatch");
		QStrDrawCenterAlt(c, c->height - 20, "network play: run RunNet.ZC");
	}
}

U0 QSetupDraw(CQCanvas *c)
{
	CQMdl	*preview;
	U8		 line[64];
	F64		 porg[3];
	F64		 pang[3];
	F64		 veye[3];
	F64		 vang[3];
	I64		 mx = QMenuXOfs(c);
	I64		 y  = 40;

	QMenuPlaque(c, &q_pic_p_multi);

	QStrDrawAlt(c, mx + 32, y, "your name");
	if (q_setup_editing)
	{
		StrPrint(line, "%s_", q_setup_name);
		QStrDrawAlt(c, mx + 32, y + 8, line);
	}
	else
		QStrDrawAlt(c, mx + 32, y + 8, q_setup_name);

	StrPrint(line, "shirt colour    %d", q_setup_top);
	QStrDrawAlt(c, mx + 32, y + 32, line);

	StrPrint(line, "trouser colour  %d", q_setup_bottom);
	QStrDrawAlt(c, mx + 32, y + 48, line);

	QStrDrawAlt(c, mx + 32, y + 72, "back");

	//The rotating player model, as the original's setup page shows. It is drawn
	//through the ordinary world path with a synthetic camera rather than as a
	//sprite, so the colours on it are the real translated skin the other players
	//would see - not an approximation of it.
	preview = QMdlPreviewGet(q_setup_top, q_setup_bottom);
	if (preview)
	{
		//The model draws through the ordinary world path, so it needs a camera
		//and a clean depth buffer. Both live on the canvas and still hold
		//whatever the last rendered frame left there - without the clear, world
		//geometry that is no longer on screen still wins the depth test and eats
		//the model.
		QVecSet(veye, 0.0, 0.0, 0.0);
		QVecSet(vang, 0.0, 0.0, 0.0);
		QDrawSetView(c, veye, vang, 90.0);

		MemSet(c->depth, 0, c->width * c->height * sizeof(F64));

		//Down +x from the eye, offset right so it sits beside the text, and
		//spun by the clock the way the original's setup page turns it.
		QVecSet(porg, 76.0, -26.0, -22.0);
		QVecSet(pang, 0.0, QAngleNorm(tS * 60.0), 0.0);

		QMdlDrawAngles(c, preview, 0, porg, pang, 176);
	}

	if (q_set_row == QSET_NAME)			QStrDrawAlt(c, mx + 16, y,      ">");
	else if (q_set_row == QSET_TOP)		QStrDrawAlt(c, mx + 16, y + 32, ">");
	else if (q_set_row == QSET_BOTTOM)	QStrDrawAlt(c, mx + 16, y + 48, ">");
	else								QStrDrawAlt(c, mx + 16, y + 72, ">");

	if (q_setup_editing)
		QStrDrawCenterAlt(c, c->height - 20, "type a name, enter when done");
	else
		QStrDrawCenterAlt(c, c->height - 20, "left/right change, enter selects");
}

Bool QMultiKey(I64 sc)
{
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row--;
		if (q_mp_row < 0)
			q_mp_row = QMP_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_mp_row++;
		if (q_mp_row >= QMP_ROWS)
			q_mp_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		if (q_mp_row == QMP_MAP)
		{
			QMenuSound(QMSND_VALUE);

			if (sc == SC_CURSOR_RIGHT)	q_mp_map++;
			else						q_mp_map--;

			if (q_mp_map > 5)	q_mp_map = 0;
			if (q_mp_map < 0)	q_mp_map = 5;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_mp_row == QMP_MAP)
			return TRUE;

		if (q_mp_row == QMP_JOIN)
		{
			if (QNetUdpAvailable())
			{
				q_menu_page = QPAGE_LANCONFIG;
				q_lan_row   = 0;
				return TRUE;
			}

			//Only reachable without a net stack, since the page above returns.
			QStrCopy(q_notice, "quit and run RunNet.ZC for network play", 64);
			q_menu_page = QPAGE_NOTICE;
		}
		else if (q_mp_row == QMP_NEW)
		{
			//Hosting binds the socket so a remote client has something to reach.
			//It is NOT fatal if it fails - a local deathmatch still runs over
			//the loopback link, which is what the original calls a listen server
			//with nobody connected.
			if (QNetUdpAvailable())
			{
				//DHCP first (QEMU user/SLIRP). AutoIP 10.0.0.1 only if no DHCP
				//-- that address is for Zeal socket MP, not Ironwail hostfwd.
				if (!QNetLocalIP)
					QNetDhcp;
				if (!QNetLocalIP)
					QNetAutoIP(0);

				if (QNetUdpOpen(QNET_PORT_DEFAULT))
				{
					q_udp_server = TRUE;
					QNetDgrmInit;
				}
			}

			//A real deathmatch server. `deathmatch` is a cvar the game logic
			//reads through the progs global of the same name, so setting it
			//here genuinely changes how the QuakeC world behaves - weapons stay
			//put when picked up, items respawn, and CheatCommand refuses to run.
			QCvarSet("deathmatch", 1.0);
			QCvarSet("coop", 0.0);

			//The chosen level, not a restart of whatever was already loaded.
			QStrCopy(q_change_map, QMPMapName(q_mp_map), 64);
			q_change_pending = TRUE;
			q_mp_start_dm    = TRUE;
		}
		else if (q_mp_row == QMP_SETUP)
		{
			q_menu_page = QPAGE_SETUP;
			q_set_row   = 0;
		}
		else
			q_menu_page = QPAGE_MAIN;

		return TRUE;
	}

	return FALSE;
}

U0 QSetupInput()
{//Typing a player name. Same charset and same edge detection the console uses.
	I64 i;
	I64 sc;
	I64 ch;

	if (!q_setup_editing)
		return;

	i = 0;
	while (q_con_charset[i])
	{
		ch = q_con_charset[i];
		sc = Char2ScanCode(ch);

		if (QConKeyEdge(sc) && q_setup_len < 15)
		{
			q_setup_name[q_setup_len] = ch;
			q_setup_len++;
			q_setup_name[q_setup_len] = 0;
		}

		i++;
	}

	if (QConKeyEdge(SC_BACKSPACE) && q_setup_len > 0)
	{
		q_setup_len--;
		q_setup_name[q_setup_len] = 0;
	}

	if (QConKeyEdge(SC_ENTER))
	{
		q_setup_editing = FALSE;
		q_setup_ate_enter = TRUE;
		QCfgSave;
		QMenuSound(QMSND_ENTER);
	}
}

Bool QSetupKey(I64 sc)
{

	//While the name is being typed every key belongs to QSetupInput, which polls
	//the keyboard directly the way the console does. The menu only ever receives
	//the handful of scancodes the shell forwards, so letters could never arrive
	//through this path.
	if (q_setup_editing)
		return TRUE;

	//The ENTER that FINISHED editing must not be seen again here. Both this and
	//QSetupInput look at the same physical key press, so without swallowing it
	//the row handler below immediately re-entered edit mode - which made the
	//name field impossible to leave except by backing out of the whole page.
	if (q_setup_ate_enter)
	{
		q_setup_ate_enter = FALSE;

		if (sc == SC_ENTER)
			return TRUE;
	}

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row--;
		if (q_set_row < 0)
			q_set_row = QSET_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_set_row++;
		if (q_set_row >= QSET_ROWS)
			q_set_row = 0;
		return TRUE;
	}

	//14 colours, which is what the colormap's player-shirt range holds.
	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		if (q_set_row == QSET_TOP || q_set_row == QSET_BOTTOM)
		{
			QMenuSound(QMSND_VALUE);

			if (q_set_row == QSET_TOP)
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_top++;
				else						q_setup_top--;

				if (q_setup_top > 13)	q_setup_top = 0;
				if (q_setup_top < 0)	q_setup_top = 13;
			}
			else
			{
				if (sc == SC_CURSOR_RIGHT)	q_setup_bottom++;
				else						q_setup_bottom--;

				if (q_setup_bottom > 13)	q_setup_bottom = 0;
				if (q_setup_bottom < 0)		q_setup_bottom = 13;
			}

			QCfgSave;
		}
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_set_row == QSET_NAME)
		{
			q_setup_editing = TRUE;
			q_setup_len     = StrLen(q_setup_name);
		}
		else if (q_set_row == QSET_BACK)
		{
			QCfgSave;
			q_menu_page = QPAGE_MULTI;
		}

		return TRUE;
	}

	return FALSE;
}

U0 QMenuDraw(CQCanvas *c)
{//The main menu: title banner, the spine plaque, the options picture, and the
 //spinning cursor beside the highlighted row.
	I64 frame;
	I64 x;
	I64 y;

	if (q_menu_page == QPAGE_OPTIONS)
	{
		QOptDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_NOTICE)
	{
		QNoticeDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_HELP)
	{
		QHelpDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_LANCONFIG)
	{
		QLanDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_MULTI)
	{
		QMultiDraw(c);
		return;
	}

	if (q_menu_page == QPAGE_SETUP)
	{
		QSetupDraw(c);
		return;
	}

	//A dark backdrop so the menu reads over whatever was last rendered.
	QMenuBackdrop(c);

	if (q_pic_qplaque.pixels)
		QPicDraw(c, &q_pic_qplaque, QMenuXOfs(c) + 16, 4);

	//Centred within the VIRTUAL box, not the canvas. Mixing the two is what
	//made the plaque and the menu overlap at high resolutions: the plaque was
	//placed in the virtual box while the artwork centred itself on the whole
	//screen, so they drifted apart as the canvas grew.
	if (q_pic_ttlmain.pixels)
		QPicDraw(c, &q_pic_ttlmain,
			QMenuXOfs(c) + (QMENU_VW - q_pic_ttlmain.width) / 2, 4);

	//x=72 is where the original puts the item block.
	if (q_pic_mainmenu.pixels)
		QPicDraw(c, &q_pic_mainmenu, QMenuXOfs(c) + 72, QMENU_Y);

	//The cursor animates at 10Hz through its six frames, which is what gives
	//it the familiar pulsing look.
	frame = ToI64(tS * 10.0) % 6;
	x     = QMenuXOfs(c) + 72 - 18;
	y     = QMENU_Y + q_menu_row * QMENU_ROW_H - 4;

	if (q_pic_cursor[frame].pixels)
		QPicDraw(c, &q_pic_cursor[frame], x, y);

	if (q_menu_ingame)
		QStrDrawCenterAlt(c, c->height - 20, "ESC resumes the game");
	else
		QStrDrawCenterAlt(c, c->height - 20, "arrows move, enter selects");
}

Bool QOptKey(I64 sc)
{//Options navigation. Left/right adjust, enter activates, escape returns.
	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row--;
		if (q_opt_row < 0)
			q_opt_row = QOPT_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_opt_row++;
		if (q_opt_row >= QOPT_ROWS)
			q_opt_row = 0;
		return TRUE;
	}

	if (sc == SC_CURSOR_LEFT || sc == SC_CURSOR_RIGHT)
	{
		//M_AdjustSliders plays this once for any value change.
		QMenuSound(QMSND_VALUE);

		switch (q_opt_row)
		{
			case QOPT_SENS:
				if (sc == SC_CURSOR_LEFT)
					q_opt_sensitivity -= 0.02;
				else
					q_opt_sensitivity += 0.02;

				if (q_opt_sensitivity < 0.02)
					q_opt_sensitivity = 0.02;
				if (q_opt_sensitivity > 0.60)
					q_opt_sensitivity = 0.60;
				break;

			case QOPT_VOLUME:
				if (sc == SC_CURSOR_LEFT)
					q_opt_volume -= 10;
				else
					q_opt_volume += 10;

				q_opt_volume = ClampI64(q_opt_volume, 0, 100);
				q_snd_master = ToF64(q_opt_volume) / 100.0;
				break;

			case QOPT_RES:
				if (sc == SC_CURSOR_LEFT)
					q_opt_res--;
				else
					q_opt_res++;

				q_opt_res = ClampI64(q_opt_res, 0, QRES_COUNT - 1);

				//The render target cannot be reallocated from here: the
				//compositor may be mid-blit. The app rebuilds it between
				//frames when it sees this flag.
				q_res_dirty = TRUE;
				break;

			case QOPT_FULLSCREEN:
				q_opt_fullscreen = !q_opt_fullscreen;
				q_res_dirty      = TRUE;
				break;

			case QOPT_GAMMA:
				//LEFT darkens, which shrinks the bar. M_AdjustSliders does
				//`gamma -= dir * 0.05` with dir = -1 for left, so left RAISES
				//the exponent - and a higher exponent is a darker picture. The
				//bar shows (max - gamma), so both move together.
				if (sc == SC_CURSOR_LEFT)
					q_opt_gamma += 0.05;
				else
					q_opt_gamma -= 0.05;

				if (q_opt_gamma < QGAMMA_MIN)
					q_opt_gamma = QGAMMA_MIN;
				if (q_opt_gamma > QGAMMA_MAX)
					q_opt_gamma = QGAMMA_MAX;

				QPalSetGamma(q_opt_gamma);
				break;

			case QOPT_GUNCLIP:
				q_opt_gunclip = !q_opt_gunclip;
				break;

			default:
				break;
		}

		//Any change is written straight out; there is no "apply" step.
		QCfgSave;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		if (q_opt_row == QOPT_BACK)
			q_menu_page = QPAGE_MAIN;
		return TRUE;
	}

	return FALSE;
}

Bool QMenuKey(I64 sc, Bool *_start_game)
{//Drive the menu from a scancode. Returns TRUE if the key was consumed.
	*_start_game = FALSE;

	if (q_menu_page == QPAGE_NOTICE)
	{
		if (sc == SC_ENTER)
		{
			QMenuSound(QMSND_ENTER);
			q_menu_page = QPAGE_MAIN;
			return TRUE;
		}
		return FALSE;
	}

	if (q_menu_page == QPAGE_OPTIONS)
		return QOptKey(sc);

	if (q_menu_page == QPAGE_HELP)
		return QHelpKey(sc);

	if (q_menu_page == QPAGE_LANCONFIG)
		return QLanKey(sc);

	if (q_menu_page == QPAGE_MULTI)
		return QMultiKey(sc);

	if (q_menu_page == QPAGE_SETUP)
		return QSetupKey(sc);

	if (sc == SC_CURSOR_UP)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row--;
		if (q_menu_row < 0)
			q_menu_row = QMENU_ROWS - 1;
		return TRUE;
	}

	if (sc == SC_CURSOR_DOWN)
	{
		QMenuSound(QMSND_MOVE);
		q_menu_row++;
		if (q_menu_row >= QMENU_ROWS)
			q_menu_row = 0;
		return TRUE;
	}

	if (sc == SC_ENTER)
	{
		QMenuSound(QMSND_ENTER);

		switch (q_menu_row)
		{
			case QMENU_SINGLE:
				//RESUME if a single-player game is already running, but START
				//OVER if the running game is a deathmatch. Only flipping the
				//state back left `deathmatch` at 1 and the dm map loaded, so
				//"single player" dropped you into the same deathmatch - the
				//cvar governs how QuakeC spawns and respawns everything, so it
				//has to be cleared before the world is built, not after.
				if (QCvarGet("deathmatch") != 0.0 ||
					QCvarGet("coop") != 0.0)
				{
					QCvarSet("deathmatch", 0.0);
					QCvarSet("coop", 0.0);

					QStrCopy(q_change_map, "start", 64);
					q_change_pending = TRUE;
				}

				*_start_game = TRUE;
				break;

			case QMENU_OPTIONS:
				q_menu_page = QPAGE_OPTIONS;
				q_opt_row   = 0;
				break;

			case QMENU_MULTI:
				q_menu_page = QPAGE_MULTI;
				q_mp_row    = 0;
				break;

			case QMENU_HELP:
				//The real help/ordering screens, not a caption invented here.
				//The old text also asserted a shareware episode range on a
				//registered install, which was simply wrong.
				q_menu_page = QPAGE_HELP;
				q_help_page = 0;
				break;

			case QMENU_QUIT:
				q_quit_request = TRUE;
				break;

			default:
				break;
		}
		return TRUE;
	}

	return FALSE;
}
