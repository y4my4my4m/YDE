// QPhys.ZC - player movement and collision against the clipnode hulls.
//
// The BSP compiler stores three collision trees. Hull 0 is the point hull used
// for rendering; hulls 1 and 2 are the render geometry already grown outward
// by a player-sized and a monster-sized box. Because the growing is baked in,
// collision is a POINT trace through the matching hull, not a box sweep. That
// is why nothing here carries the player's bounding box around.
//
// The trace recursion, like the render traversal, is DIRECT self-recursion.
// Routing a recursive call through a forward-declared helper miscompiles on
// this compiler, so the split case calls the function itself on both sides.

#define QCONTENTS_NODE		0		//not a leaf value; only children are

#define QPHYS_GRAVITY		800.0
#define QPHYS_MAXSPEED		320.0
#define QPHYS_ACCEL			10.0
#define QPHYS_AIRACCEL		0.7
#define QPHYS_FRICTION		4.0
#define QPHYS_STOPSPEED		100.0
#define QPHYS_JUMP			270.0
#define QPHYS_STEPSIZE		18.0
#define QPHYS_MAXCLIP		5
#define QPHYS_EPSILON		0.03125	//1/32, matches the compiler's precision
#define QPHYS_OVERCLIP		1.0

//The player box, needed for sampling liquid depth. These agree with the sizes
//hull 1 was pre-expanded by.
#define QPHYS_MINS_Z		-24.0
#define QPHYS_MAXS_Z		32.0
#define QPHYS_VIEW_Z		22.0

#define QPHYS_WATERFRICTION	4.0
#define QPHYS_WATERSPEED	0.7		//swimming is slower than running
#define QPHYS_WATERSINK		60.0	//drift down when not actively swimming

class CQTrace
{
	Bool all_solid;		//the whole sweep was inside solid
	Bool start_solid;	//the sweep began inside solid
	F64	 fraction;		//how far along the move we got, 0..1
	F64	 end_pos[3];
	F64	 plane_normal[3];
	F64	 plane_dist;
	Bool hit;			//a plane was struck
};

I64 QHullPointContents(CQMap *map, I64 num, F64 *p)
{//Walk the clipnode tree until a negative (contents) child appears.
	CQClipNode	*node;
	CQPlane		*plane;
	F64			 d;

	while (num >= 0)
	{
		if (num >= map->num_clipnodes)
			return QCONTENTS_SOLID;

		node  = &map->clipnodes[num];
		plane = &map->planes[node->plane_num];

		//Axial planes are the common case and skip the dot product.
		if (plane->type < 3)
			d = p[plane->type] - plane->dist;
		else
			d = QVecDot(p, plane->normal) - plane->dist;

		if (d < 0.0)
			num = node->children[1];
		else
			num = node->children[0];
	}

	return num;
}

Bool QRecursiveHullCheck(CQMap *map, I64 num, F64 p1f, F64 p2f,
	F64 *p1, F64 *p2, CQTrace *trace)
{//Sweep a point from p1 to p2. Returns FALSE once the move is blocked.
 //Direct self-recursion only - see the file header.
	CQClipNode	*node;
	CQPlane		*plane;
	F64			 t1;
	F64			 t2;
	F64			 frac;
	F64			 midf;
	F64			 mid[3];
	I64			 side;
	I64			 i;

	//--- leaf ---
	if (num < 0)
	{
		if (num != QCONTENTS_SOLID)
		{
			trace->all_solid = FALSE;
			return TRUE;
		}

		trace->start_solid = TRUE;
		return TRUE;
	}

	if (num >= map->num_clipnodes)
		return FALSE;

	node  = &map->clipnodes[num];
	plane = &map->planes[node->plane_num];

	if (plane->type < 3)
	{
		t1 = p1[plane->type] - plane->dist;
		t2 = p2[plane->type] - plane->dist;
	}
	else
	{
		t1 = QVecDot(p1, plane->normal) - plane->dist;
		t2 = QVecDot(p2, plane->normal) - plane->dist;
	}

	//Wholly on one side: no split needed.
	if (t1 >= 0.0 && t2 >= 0.0)
		return QRecursiveHullCheck(map, node->children[0], p1f, p2f, p1, p2,
			trace);
	if (t1 < 0.0 && t2 < 0.0)
		return QRecursiveHullCheck(map, node->children[1], p1f, p2f, p1, p2,
			trace);

	//--- split: stop just short of the plane so the point never lands on it ---
	if (t1 < 0.0)
		frac = (t1 + QPHYS_EPSILON) / (t1 - t2);
	else
		frac = (t1 - QPHYS_EPSILON) / (t1 - t2);

	if (frac < 0.0)
		frac = 0.0;
	if (frac > 1.0)
		frac = 1.0;

	midf = p1f + (p2f - p1f) * frac;
	for (i = 0; i < 3; i++)
		mid[i] = p1[i] + frac * (p2[i] - p1[i]);

	if (t1 < 0.0)
		side = 1;
	else
		side = 0;

	//Near side first: if it blocks, the far side is unreachable.
	if (!QRecursiveHullCheck(map, node->children[side], p1f, midf, p1, mid,
			trace))
		return FALSE;

	//Far side is open, so the move continues into it.
	if (QHullPointContents(map, node->children[side ^ 1], mid) !=
			QCONTENTS_SOLID)
		return QRecursiveHullCheck(map, node->children[side ^ 1], midf, p2f,
			mid, p2, trace);

	//Started inside solid and never got out: no usable impact.
	if (trace->all_solid)
		return FALSE;

	//Impact. The stored normal always faces back along the move.
	if (side)
	{
		QVecScale(plane->normal, -1.0, trace->plane_normal);
		trace->plane_dist = -plane->dist;
	}
	else
	{
		QVecCopy(plane->normal, trace->plane_normal);
		trace->plane_dist = plane->dist;
	}

	trace->fraction = midf;
	QVecCopy(mid, trace->end_pos);
	trace->hit = TRUE;

	return FALSE;
}

U0 QTraceMove(CQMap *map, F64 *start, F64 *end, CQTrace *trace)
{//Sweep the player's origin through hull 1.
	I64 head = map->models[0].head_node[1];

	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	QVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	QVecCopy(end, trace->end_pos);

	QRecursiveHullCheck(map, head, 0.0, 1.0, start, end, trace);
}

U0 QClipVelocity(F64 *v, F64 *normal, F64 overbounce, F64 *out)
{//Remove the component of v heading into the plane, so the move slides.
	F64 backoff = QVecDot(v, normal) * overbounce;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		out[i] = v[i] - normal[i] * backoff;

		//Nudge off zero to stop the player creeping back into the surface.
		if (out[i] > -QPHYS_EPSILON && out[i] < QPHYS_EPSILON)
			out[i] = 0.0;
	}
}

Bool QSlideMove(CQMap *map, F64 *origin, F64 *velocity, F64 dt)
{//Move, and on each impact slide along the surface and keep going with the
 //time that is left. Returns TRUE if anything was hit.
	CQTrace	trace;
	F64		end[3];
	F64		time_left = dt;
	F64		clipped[3];
	I64		bump;
	Bool	blocked = FALSE;

	for (bump = 0; bump < QPHYS_MAXCLIP; bump++)
	{
		if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
			break;

		QVecMA(origin, time_left, velocity, end);
		QTraceMove(map, origin, end, &trace);

		if (trace.all_solid)
		{
			//Stuck inside geometry: drop all motion rather than tunnel out.
			QVecSet(velocity, 0.0, 0.0, 0.0);
			return TRUE;
		}

		if (trace.fraction > 0.0)
			QVecCopy(trace.end_pos, origin);

		if (trace.fraction == 1.0)
			break;

		blocked    = TRUE;
		time_left -= time_left * trace.fraction;

		QClipVelocity(velocity, trace.plane_normal, QPHYS_OVERCLIP, clipped);
		QVecCopy(clipped, velocity);
	}

	return blocked;
}

Bool QCheckGround(CQMap *map, F64 *origin)
{//Probe a short distance down. A near-flat impact counts as standing.
	CQTrace trace;
	F64		down[3];

	QVecCopy(origin, down);
	down[2] -= 1.0;

	QTraceMove(map, origin, down, &trace);

	if (trace.fraction == 1.0 || !trace.hit)
		return FALSE;

	//0.7 is roughly a 45 degree limit: steeper than that is a wall, not floor.
	return ToBool(trace.plane_normal[2] > 0.7);
}

U0 QStepMove(CQMap *map, F64 *origin, F64 *velocity, F64 dt, Bool on_ground)
{//Try the move flat. If it was blocked, retry from one step height up and
 //settle back down, which is what lets the player walk up stairs without
 //jumping. The better of the two results wins.
	F64		orig_pos[3];
	F64		orig_vel[3];
	F64		flat_pos[3];
	F64		flat_vel[3];
	F64		up_pos[3];
	F64		down[3];
	CQTrace	trace;
	Bool	blocked;
	F64		flat_dist;
	F64		step_dist;
	F64		d[3];

	QVecCopy(origin, orig_pos);
	QVecCopy(velocity, orig_vel);

	blocked = QSlideMove(map, origin, velocity, dt);

	if (!blocked || !on_ground)
		return;

	//Remember where the flat attempt ended up.
	QVecCopy(origin, flat_pos);
	QVecCopy(velocity, flat_vel);

	//Second attempt, lifted by one step.
	QVecCopy(orig_pos, up_pos);
	up_pos[2] += QPHYS_STEPSIZE;

	//Refuse the step if the raised position is itself inside geometry.
	QTraceMove(map, orig_pos, up_pos, &trace);
	if (trace.fraction < 1.0)
		return;

	QVecCopy(up_pos, origin);
	QVecCopy(orig_vel, velocity);
	QSlideMove(map, origin, velocity, dt);

	//Settle back onto the floor.
	QVecCopy(origin, down);
	down[2] -= QPHYS_STEPSIZE;
	QTraceMove(map, origin, down, &trace);

	if (trace.plane_normal[2] < 0.7 && trace.hit)
	{
		//Landed on something too steep to stand on: keep the flat result.
		QVecCopy(flat_pos, origin);
		QVecCopy(flat_vel, velocity);
		return;
	}

	QVecCopy(trace.end_pos, origin);

	//Keep whichever attempt covered more horizontal ground.
	QVecSub(flat_pos, orig_pos, d);
	flat_dist = d[0] * d[0] + d[1] * d[1];
	QVecSub(origin, orig_pos, d);
	step_dist = d[0] * d[0] + d[1] * d[1];

	if (flat_dist > step_dist)
	{
		QVecCopy(flat_pos, origin);
		QVecCopy(flat_vel, velocity);
	}
}

U0 QAccelerate(F64 *velocity, F64 *wishdir, F64 wishspeed, F64 accel, F64 dt)
{//Add speed along wishdir, but never past wishspeed in that direction.
	F64 current = QVecDot(velocity, wishdir);
	F64 add     = wishspeed - current;
	F64 amount;

	if (add <= 0.0)
		return;

	amount = accel * dt * wishspeed;
	if (amount > add)
		amount = add;

	QVecMA(velocity, amount, wishdir, velocity);
}

U0 QFriction(F64 *velocity, F64 dt)
{//Slow the player down, using a floor speed so stopping stays crisp.
	F64 speed = Sqrt(velocity[0] * velocity[0] + velocity[1] * velocity[1] +
					 velocity[2] * velocity[2]);
	F64 control;
	F64 drop;
	F64 newspeed;

	if (speed < 0.1)
	{
		velocity[0] = 0.0;
		velocity[1] = 0.0;
		return;
	}

	if (speed < QPHYS_STOPSPEED)
		control = QPHYS_STOPSPEED;
	else
		control = speed;

	drop     = control * QPHYS_FRICTION * dt;
	newspeed = speed - drop;

	if (newspeed < 0.0)
		newspeed = 0.0;

	newspeed /= speed;

	velocity[0] *= newspeed;
	velocity[1] *= newspeed;
	velocity[2] *= newspeed;
}

I64 QWaterLevelGet(CQMap *map, F64 *origin, I64 *_watertype)
{//How deep the player is standing in liquid, 0 (dry) to 3 (fully under).
 //Sampled at the feet, the waist and the eyes, which is what QuakeC's
 //swimming, drowning and screen-tint logic all key off.
	F64 point[3];
	I64 contents;
	I64 level = 0;

	if (_watertype)
		*_watertype = QCONTENTS_EMPTY;

	//Feet: just above the bottom of the bounding box.
	QVecCopy(origin, point);
	point[2] = origin[2] + QPHYS_MINS_Z + 1.0;

	contents = QHullPointContents(map, map->models[0].head_node[0], point);
	if (contents > QCONTENTS_SOLID || contents == QCONTENTS_EMPTY)
	{
		//Empty or solid at the feet means not in liquid at all.
		if (contents != QCONTENTS_WATER && contents != QCONTENTS_SLIME &&
			contents != QCONTENTS_LAVA)
			return 0;
	}

	if (contents != QCONTENTS_WATER && contents != QCONTENTS_SLIME &&
		contents != QCONTENTS_LAVA)
		return 0;

	level = 1;
	if (_watertype)
		*_watertype = contents;

	//Waist.
	point[2] = origin[2] + (QPHYS_MINS_Z + QPHYS_MAXS_Z) * 0.5;
	contents = QHullPointContents(map, map->models[0].head_node[0], point);
	if (contents == QCONTENTS_WATER || contents == QCONTENTS_SLIME ||
		contents == QCONTENTS_LAVA)
	{
		level = 2;

		//Eyes: fully submerged, which is what gates swimming and drowning.
		point[2] = origin[2] + QPHYS_VIEW_Z;
		contents = QHullPointContents(map, map->models[0].head_node[0], point);
		if (contents == QCONTENTS_WATER || contents == QCONTENTS_SLIME ||
			contents == QCONTENTS_LAVA)
			level = 3;
	}

	return level;
}

U0 QWaterMove(CQMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, F64 dt)
{//Swimming: no ground, no gravity, and drag in every direction. wishdir here
 //is the full 3D view direction, so looking up swims up.
	F64 speed;
	F64 newspeed;
	F64 drop;

	speed = QVecLength(velocity);
	if (speed > 0.0)
	{
		drop     = speed * QPHYS_WATERFRICTION * dt;
		newspeed = speed - drop;
		if (newspeed < 0.0)
			newspeed = 0.0;
		QVecScale(velocity, newspeed / speed, velocity);
	}

	//Water moves you slower than land, and a slight downward drift keeps the
	//player sinking when they stop swimming rather than hovering.
	QAccelerate(velocity, wishdir, wishspeed * QPHYS_WATERSPEED, QPHYS_ACCEL, dt);

	if (wishspeed < 1.0)
		velocity[2] -= QPHYS_WATERSINK * dt;

	QSlideMove(map, origin, velocity, dt);
}

U0 QPlayerMove(CQMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, Bool jump, F64 dt, Bool *_on_ground, I64 water_level)
{//One tick of player movement.
	Bool on_ground;

	//Swimming replaces the whole walking model: no ground contact, no gravity.
	if (water_level >= 2)
	{
		QWaterMove(map, origin, velocity, wishdir, wishspeed, dt);
		if (_on_ground)
			*_on_ground = FALSE;
		return;
	}

	on_ground = QCheckGround(map, origin);

	if (on_ground)
	{
		QFriction(velocity, dt);
		QAccelerate(velocity, wishdir, wishspeed, QPHYS_ACCEL, dt);

		if (jump)
		{
			velocity[2] = QPHYS_JUMP;
			on_ground   = FALSE;
		}
		else if (velocity[2] < 0.0)
			velocity[2] = 0.0;		//stop gravity accumulating while standing
	}
	else
	{
		//Air control is deliberately weak.
		QAccelerate(velocity, wishdir, wishspeed, QPHYS_AIRACCEL, dt);
		velocity[2] -= QPHYS_GRAVITY * dt;
	}

	QStepMove(map, origin, velocity, dt, on_ground);

	if (_on_ground)
		*_on_ground = on_ground;
}
