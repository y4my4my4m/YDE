// QPhys.ZC - player movement and collision against the clipnode hulls.
//
// The BSP compiler stores three collision trees. Hull 0 is the point hull used
// for rendering; hulls 1 and 2 are the render geometry already grown outward
// by a player-sized and a monster-sized box. Because the growing is baked in,
// collision is a POINT trace through the matching hull, not a box sweep. That
// is why nothing here carries the player's bounding box around.
//
// The trace recursion, like the render traversal, is DIRECT self-recursion.
// Routing a recursive call through a forward-declared helper miscompiles on
// this compiler, so the split case calls the function itself on both sides.

#define QCONTENTS_NODE		0		//not a leaf value; only children are

#define QPHYS_GRAVITY		800.0
#define QPHYS_MAXSPEED		320.0
#define QPHYS_ACCEL			10.0
#define QPHYS_AIRACCEL		0.7
#define QPHYS_FRICTION		4.0
#define QPHYS_STOPSPEED		100.0
#define QPHYS_JUMP			270.0
#define QPHYS_STEPSIZE		18.0
#define QPHYS_MAXCLIP		5
#define QPHYS_EPSILON		0.03125	//1/32, matches the compiler's precision
#define QPHYS_OVERCLIP		1.0

//The player box, needed for sampling liquid depth. These agree with the sizes
//hull 1 was pre-expanded by.
#define QPHYS_MINS_Z		-24.0
#define QPHYS_MAXS_Z		32.0
#define QPHYS_VIEW_Z		22.0

#define QPHYS_WATERFRICTION	4.0
#define QPHYS_WATERSPEED	0.7		//swimming is slower than running
#define QPHYS_WATERSINK		60.0	//drift down when not actively swimming

class CQTrace
{
	Bool all_solid;		//the whole sweep was inside solid
	Bool start_solid;	//the sweep began inside solid
	F64	 fraction;		//how far along the move we got, 0..1
	F64	 end_pos[3];
	F64	 plane_normal[3];
	F64	 plane_dist;
	Bool hit;			//a plane was struck
};

I64 QHullPointContents(CQMap *map, I64 num, F64 *p)
{//Walk the clipnode tree until a negative (contents) child appears.
	CQClipNode	*node;
	CQPlane		*plane;
	F64			 d;

	while (num >= 0)
	{
		if (num >= map->num_clipnodes)
			return QCONTENTS_SOLID;

		node  = &map->clipnodes[num];
		plane = &map->planes[node->plane_num];

		//Axial planes are the common case and skip the dot product.
		if (plane->type < 3)
			d = p[plane->type] - plane->dist;
		else
			d = QVecDot(p, plane->normal) - plane->dist;

		if (d < 0.0)
			num = node->children[1];
		else
			num = node->children[0];
	}

	return num;
}

Bool QRecursiveHullCheck(CQMap *map, I64 num, F64 p1f, F64 p2f,
	F64 *p1, F64 *p2, CQTrace *trace)
{//Sweep a point from p1 to p2. Returns FALSE once the move is blocked.
 //Direct self-recursion only - see the file header.
	CQClipNode	*node;
	CQPlane		*plane;
	F64			 t1;
	F64			 t2;
	F64			 frac;
	F64			 midf;
	F64			 mid[3];
	I64			 side;
	I64			 i;

	//--- leaf ---
	if (num < 0)
	{
		if (num != QCONTENTS_SOLID)
		{
			trace->all_solid = FALSE;
			return TRUE;
		}

		trace->start_solid = TRUE;
		return TRUE;
	}

	if (num >= map->num_clipnodes)
		return FALSE;

	node  = &map->clipnodes[num];
	plane = &map->planes[node->plane_num];

	if (plane->type < 3)
	{
		t1 = p1[plane->type] - plane->dist;
		t2 = p2[plane->type] - plane->dist;
	}
	else
	{
		t1 = QVecDot(p1, plane->normal) - plane->dist;
		t2 = QVecDot(p2, plane->normal) - plane->dist;
	}

	//Wholly on one side: no split needed.
	if (t1 >= 0.0 && t2 >= 0.0)
		return QRecursiveHullCheck(map, node->children[0], p1f, p2f, p1, p2,
			trace);
	if (t1 < 0.0 && t2 < 0.0)
		return QRecursiveHullCheck(map, node->children[1], p1f, p2f, p1, p2,
			trace);

	//--- split: stop just short of the plane so the point never lands on it ---
	if (t1 < 0.0)
		frac = (t1 + QPHYS_EPSILON) / (t1 - t2);
	else
		frac = (t1 - QPHYS_EPSILON) / (t1 - t2);

	if (frac < 0.0)
		frac = 0.0;
	if (frac > 1.0)
		frac = 1.0;

	midf = p1f + (p2f - p1f) * frac;
	for (i = 0; i < 3; i++)
		mid[i] = p1[i] + frac * (p2[i] - p1[i]);

	if (t1 < 0.0)
		side = 1;
	else
		side = 0;

	//Near side first: if it blocks, the far side is unreachable.
	if (!QRecursiveHullCheck(map, node->children[side], p1f, midf, p1, mid,
			trace))
		return FALSE;

	//Far side is open, so the move continues into it.
	if (QHullPointContents(map, node->children[side ^ 1], mid) !=
			QCONTENTS_SOLID)
		return QRecursiveHullCheck(map, node->children[side ^ 1], midf, p2f,
			mid, p2, trace);

	//Started inside solid and never got out: no usable impact.
	if (trace->all_solid)
		return FALSE;

	//Impact. The stored normal always faces back along the move.
	if (side)
	{
		QVecScale(plane->normal, -1.0, trace->plane_normal);
		trace->plane_dist = -plane->dist;
	}
	else
	{
		QVecCopy(plane->normal, trace->plane_normal);
		trace->plane_dist = plane->dist;
	}

	trace->fraction = midf;
	QVecCopy(mid, trace->end_pos);
	trace->hit = TRUE;

	return FALSE;
}

U0 QTraceMove(CQMap *map, F64 *start, F64 *end, CQTrace *trace)
{//Sweep the player's origin through hull 1.
	I64 head = map->models[0].head_node[1];

	trace->all_solid   = TRUE;
	trace->start_solid = FALSE;
	trace->fraction    = 1.0;
	trace->hit         = FALSE;
	trace->plane_dist  = 0.0;
	QVecSet(trace->plane_normal, 0.0, 0.0, 0.0);
	QVecCopy(end, trace->end_pos);

	QRecursiveHullCheck(map, head, 0.0, 1.0, start, end, trace);
}

F64  q_old_origin[3];		//last origin known to be in open space
I64  q_stuck_reports = 0;	//capped so a stuck frame can't flood the console

Bool QTestPlayerPosition(CQMap *map, F64 *origin)
{//TRUE when the player box at this origin is embedded in solid.
	CQTrace trace;

	QTraceMove(map, origin, origin, &trace);
	return trace.all_solid;
}

U0 QCheckStuck(CQMap *map, F64 *origin)
{//Push the player back out of solid geometry.
 //
 //Without this, being embedded in solid is PERMANENT: the slide move sees
 //all_solid, zeroes velocity and returns with the origin untouched, so the
 //next frame is identically stuck and the player can never move again. Doors
 //and teleporters are the two things that relocate or shove the player, which
 //is exactly how that state gets entered.
 //
 //Same recovery order the original uses: first retry the last origin known to
 //be open, then search outward one unit at a time and upward 18 - far enough
 //to clear a step, small enough not to teleport anyone through a wall.
	F64 org[3];
	I64 i;
	I64 j;
	I64 z;

	if (!QTestPlayerPosition(map, origin))
	{
		QVecCopy(origin, q_old_origin);
		return;
	}

	QVecCopy(origin, org);

	QVecCopy(q_old_origin, origin);
	if (!QTestPlayerPosition(map, origin))
		return;

	for (z = 0; z < 18; z++)
	{
		for (i = -1; i <= 1; i++)
		{
			for (j = -1; j <= 1; j++)
			{
				origin[0] = org[0] + ToF64(i);
				origin[1] = org[1] + ToF64(j);
				origin[2] = org[2] + ToF64(z);

				if (!QTestPlayerPosition(map, origin))
					return;
			}
		}
	}

	//Nothing open nearby. Restore the original spot so at least the view is
	//where the player expects, and say so - silently freezing is worse.
	QVecCopy(org, origin);

	if (q_stuck_reports < 8)
	{
		q_stuck_reports++;
		"QPhys: player stuck at %.0f %.0f %.0f\n", org[0], org[1], org[2];
	}
}

U0 QClipVelocity(F64 *v, F64 *normal, F64 overbounce, F64 *out)
{//Remove the component of v heading into the plane, so the move slides.
	F64 backoff = QVecDot(v, normal) * overbounce;
	I64 i;

	for (i = 0; i < 3; i++)
	{
		out[i] = v[i] - normal[i] * backoff;

		//Nudge off zero to stop the player creeping back into the surface.
		if (out[i] > -QPHYS_EPSILON && out[i] < QPHYS_EPSILON)
			out[i] = 0.0;
	}
}

//Quake allows 5 clip planes before it gives up on finding a way out.
#define QPHYS_MAXPLANES		5

//Return bits from QFlyMove, same meaning as SV_FlyMove's.
#define QBLOCK_FLOOR		1
#define QBLOCK_WALL		2

I64 QFlyMove(CQMap *map, F64 *origin, F64 *velocity, F64 dt, Bool *_ground)
{//Sweep the player through the world, sliding along whatever is hit, and report
 //what got in the way. A faithful port of SV_FlyMove.
 //
 //The important part is that every plane hit during the move is REMEMBERED. It
 //is not enough to clip against each surface as it arrives: in a corner, the
 //second clip undoes the first, the two fight, and the velocity is ground down
 //to nothing - which is what made the player snag on edges and wedge into
 //corners. So a direction is chosen that parallels ALL the planes collected so
 //far; failing that, two planes are crossed to slide along their crease, and
 //three or more is a genuine dead end where stopping is correct.
 //
 //Ground contact is decided HERE, from the plane the move actually landed on,
 //rather than by a separate downward probe. That is the original's arrangement
 //and it is self-consistent: the same trace that stops the fall reports the
 //floor. Standing still works because gravity is applied before every move, so
 //there is always a downward component to find the floor with.
	CQTrace	trace;
	F64		planes[QPHYS_MAXPLANES * 3];
	F64		primal[3];
	F64		original[3];
	F64		new_vel[3];
	F64		end[3];
	F64		dir[3];
	F64		time_left = dt;
	F64		d;
	I64		numplanes = 0;
	I64		blocked   = 0;
	I64		bump;
	I64		i;
	I64		j;
	Bool	ok;
	Bool	found;

	QVecCopy(velocity, primal);
	QVecCopy(velocity, original);

	for (bump = 0; bump < QPHYS_MAXCLIP; bump++)
	{
		if (velocity[0] == 0.0 && velocity[1] == 0.0 && velocity[2] == 0.0)
			break;

		QVecMA(origin, time_left, velocity, end);
		QTraceMove(map, origin, end, &trace);

		if (trace.all_solid)
		{
			//Embedded in geometry. QCheckStuck is what recovers from this.
			QVecSet(velocity, 0.0, 0.0, 0.0);
			return QBLOCK_FLOOR | QBLOCK_WALL;
		}

		if (trace.fraction > 0.0)
		{
			//Ground was covered, so the planes collected before this point no
			//longer constrain anything.
			QVecCopy(trace.end_pos, origin);
			QVecCopy(velocity, original);
			numplanes = 0;
		}

		if (trace.fraction == 1.0)
			break;

		//0.7 is about a 45 degree limit: flatter than that is floor.
		if (trace.plane_normal[2] > 0.7)
		{
			blocked |= QBLOCK_FLOOR;
			if (_ground)
				*_ground = TRUE;
		}

		if (trace.plane_normal[2] == 0.0)
			blocked |= QBLOCK_WALL;

		time_left -= time_left * trace.fraction;

		if (numplanes >= QPHYS_MAXPLANES)
		{
			QVecSet(velocity, 0.0, 0.0, 0.0);
			return QBLOCK_FLOOR | QBLOCK_WALL;
		}

		QVecCopy(trace.plane_normal, &planes[numplanes * 3]);
		numplanes++;

		//Look for a slide direction that runs along every plane hit.
		found = FALSE;
		i     = 0;

		while (i < numplanes && !found)
		{
			QClipVelocity(original, &planes[i * 3], 1.0, new_vel);

			ok = TRUE;
			for (j = 0; j < numplanes; j++)
			{
				if (j != i && QVecDot(new_vel, &planes[j * 3]) < 0.0)
					ok = FALSE;
			}

			if (ok)
				found = TRUE;
			else
				i++;
		}

		if (found)
			QVecCopy(new_vel, velocity);
		else
		{
			if (numplanes != 2)
			{
				QVecSet(velocity, 0.0, 0.0, 0.0);
				return QBLOCK_FLOOR | QBLOCK_WALL;
			}

			//Slide along the crease where the two planes meet.
			QVecCross(planes, &planes[3], dir);
			d = QVecDot(dir, velocity);
			QVecScale(dir, d, velocity);
		}

		//If sliding has turned the move back against where it started, stop.
		//Without this the player gets flung backwards out of tight corners.
		if (QVecDot(velocity, primal) <= 0.0)
		{
			QVecSet(velocity, 0.0, 0.0, 0.0);
			return blocked;
		}
	}

	return blocked;
}

Bool QSlideMove(CQMap *map, F64 *origin, F64 *velocity, F64 dt)
{//Move and slide, discarding the detail of what was hit.
	return ToBool(QFlyMove(map, origin, velocity, dt, NULL) != 0);
}


{//Probe downward for a floor. A near-flat impact counts as standing.
 //
 //The probe distance matters more than it looks: this result becomes
 //FL_ONGROUND, and QuakeC refuses to jump without it. A 1-unit probe misses
 //whenever a move leaves the player resting a fraction above the surface, and
 //the symptom is jumping that works, then silently stops.
	CQTrace trace;
	F64		down[3];

	QVecCopy(origin, down);

	QTraceMove(map, origin, down, &trace);

	//Standing inside the floor (after a hard landing) still counts as ground;
	//treating it as airborne would strand the player unable to jump.
	if (trace.start_solid)
		return TRUE;

	if (trace.fraction == 1.0 || !trace.hit)
		return FALSE;

	//0.7 is roughly a 45 degree limit: steeper than that is a wall, not floor.
	return ToBool(trace.plane_normal[2] > 0.7);
}

U0 QPushMove(CQMap *map, F64 *origin, F64 *push, CQTrace *trace)
{//Shift the player by a fixed offset, stopping at whatever is in the way.
 //SV_PushEntity, minus the entity linking we have no use for here.
	F64 end[3];

	QVecAdd(origin, push, end);
	QTraceMove(map, origin, end, trace);
	QVecCopy(trace->end_pos, origin);
}

U0 QWalkMove(CQMap *map, F64 *origin, F64 *velocity, F64 dt, Bool old_ground,
	Bool *_ground)
{//Walk, climbing steps where a step is what blocked the move. Ported from
 //SV_WalkMove.
 //
 //The step-up is NOT attempted speculatively. It runs only when the plain move
 //actually hit a wall, and only when the player was already on the ground -
 //that second condition is what stops them climbing walls mid-jump.
 //
 //It is also not a "try both and keep the better one" choice, which is what
 //this used to do. The step result is kept only if the move DOWN afterwards
 //lands on real floor; otherwise the flat move is restored. Near a wall-slope
 //junction the stepped move can end up on a face too steep to stand on, and
 //keeping it there is what let the player hop up surfaces they should slide
 //off, and snag on others.
	F64		oldorg[3];
	F64		oldvel[3];
	F64		nosteporg[3];
	F64		nostepvel[3];
	F64		upmove[3];
	F64		downmove[3];
	CQTrace	downtrace;
	CQTrace	tr;
	I64		clip;
	Bool	flat_ground = FALSE;
	Bool	step_ground = FALSE;

	QVecCopy(origin, oldorg);
	QVecCopy(velocity, oldvel);

	clip = QFlyMove(map, origin, velocity, dt, &flat_ground);

	//Nothing wall-like stopped it, so there is no step to climb.
	if ((clip & QBLOCK_WALL) == 0)
	{
		if (_ground)
			*_ground = flat_ground;
		return;
	}

	//No stairs while airborne.
	if (!old_ground)
	{
		if (_ground)
			*_ground = flat_ground;
		return;
	}

	//Keep the un-stepped result so it can be restored.
	QVecCopy(origin, nosteporg);
	QVecCopy(velocity, nostepvel);

	//Back to the start, lift by a step, and retry the move horizontally.
	QVecCopy(oldorg, origin);

	QVecSet(upmove, 0.0, 0.0, QPHYS_STEPSIZE);
	QVecSet(downmove, 0.0, 0.0, -QPHYS_STEPSIZE + oldvel[2] * dt);

	QPushMove(map, origin, upmove, &tr);

	velocity[0] = oldvel[0];
	velocity[1] = oldvel[1];
	velocity[2] = 0.0;

	clip = QFlyMove(map, origin, velocity, dt, &step_ground);

	//Settle back down onto whatever is below.
	QPushMove(map, origin, downmove, &downtrace);

	if (downtrace.plane_normal[2] > 0.7)
	{
		if (_ground)
			*_ground = TRUE;
	}
	else
	{
		//Did not land on ground worth standing on: discard the step entirely.
		QVecCopy(nosteporg, origin);
		QVecCopy(nostepvel, velocity);

		if (_ground)
			*_ground = flat_ground;
	}
}


U0 QAccelerate(F64 *velocity, F64 *wishdir, F64 wishspeed, F64 accel, F64 dt)
{//Add speed along wishdir, but never past wishspeed in that direction.
	F64 current = QVecDot(velocity, wishdir);
	F64 add     = wishspeed - current;
	F64 amount;

	if (add <= 0.0)
		return;

	amount = accel * dt * wishspeed;
	if (amount > add)
		amount = add;

	QVecMA(velocity, amount, wishdir, velocity);
}

U0 QFriction(F64 *velocity, F64 dt)
{//Slow the player down, using a floor speed so stopping stays crisp.
	F64 speed = Sqrt(velocity[0] * velocity[0] + velocity[1] * velocity[1] +
					 velocity[2] * velocity[2]);
	F64 control;
	F64 drop;
	F64 newspeed;

	if (speed < 0.1)
	{
		velocity[0] = 0.0;
		velocity[1] = 0.0;
		return;
	}

	if (speed < QPHYS_STOPSPEED)
		control = QPHYS_STOPSPEED;
	else
		control = speed;

	drop     = control * QPHYS_FRICTION * dt;
	newspeed = speed - drop;

	if (newspeed < 0.0)
		newspeed = 0.0;

	newspeed /= speed;

	velocity[0] *= newspeed;
	velocity[1] *= newspeed;
	velocity[2] *= newspeed;
}

I64 QPointContents(CQMap *map, F64 *p)
{//What kind of volume is this point in: empty, solid, water, slime or lava.
 //
 //This walks the RENDER node tree and reads the leaf's contents. Hull 0 is
 //that tree - it is NOT a clipnode hull. Feeding head_node[0] to the clipnode
 //walker indexes a completely different array and returns nonsense, which is
 //why liquids were never detected: no lava damage, no drowning, no tint.
	CQNode	*node;
	CQPlane	*plane;
	I64		 num;
	F64		 d;

	num = map->models[0].head_node[0];

	while (num >= 0)
	{
		if (num >= map->num_nodes)
			return QCONTENTS_SOLID;

		node  = &map->nodes[num];
		plane = &map->planes[node->plane_num];

		if (plane->type < 3)
			d = p[plane->type] - plane->dist;
		else
			d = QVecDot(p, plane->normal) - plane->dist;

		if (d < 0.0)
			num = node->children[1];
		else
			num = node->children[0];
	}

	//A negative child is ~(leaf index), and the leaf carries the contents.
	num = -1 - num;
	if (num < 0 || num >= map->num_leafs)
		return QCONTENTS_SOLID;

	return map->leafs[num].contents;
}

I64 QWaterLevelGet(CQMap *map, F64 *origin, I64 *_watertype)
{//How deep the player is standing in liquid, 0 (dry) to 3 (fully under).
 //Sampled at the feet, the waist and the eyes, which is what QuakeC's
 //swimming, drowning and screen-tint logic all key off.
	F64 point[3];
	I64 contents;
	I64 level = 0;

	if (_watertype)
		*_watertype = QCONTENTS_EMPTY;

	//Feet: just above the bottom of the bounding box.
	QVecCopy(origin, point);
	point[2] = origin[2] + QPHYS_MINS_Z + 1.0;

	contents = QPointContents(map, point);
	if (contents > QCONTENTS_SOLID || contents == QCONTENTS_EMPTY)
	{
		//Empty or solid at the feet means not in liquid at all.
		if (contents != QCONTENTS_WATER && contents != QCONTENTS_SLIME &&
			contents != QCONTENTS_LAVA)
			return 0;
	}

	if (contents != QCONTENTS_WATER && contents != QCONTENTS_SLIME &&
		contents != QCONTENTS_LAVA)
		return 0;

	level = 1;
	if (_watertype)
		*_watertype = contents;

	//Waist.
	point[2] = origin[2] + (QPHYS_MINS_Z + QPHYS_MAXS_Z) * 0.5;
	contents = QPointContents(map, point);
	if (contents == QCONTENTS_WATER || contents == QCONTENTS_SLIME ||
		contents == QCONTENTS_LAVA)
	{
		level = 2;

		//Eyes: fully submerged, which is what gates swimming and drowning.
		point[2] = origin[2] + QPHYS_VIEW_Z;
		contents = QPointContents(map, point);
		if (contents == QCONTENTS_WATER || contents == QCONTENTS_SLIME ||
			contents == QCONTENTS_LAVA)
			level = 3;
	}

	return level;
}

U0 QWaterMove(CQMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, F64 dt)
{//Swimming: no ground, no gravity, and drag in every direction. wishdir here
 //is the full 3D view direction, so looking up swims up.
	F64 speed;
	F64 newspeed;
	F64 drop;

	speed = QVecLength(velocity);
	if (speed > 0.0)
	{
		drop     = speed * QPHYS_WATERFRICTION * dt;
		newspeed = speed - drop;
		if (newspeed < 0.0)
			newspeed = 0.0;
		QVecScale(velocity, newspeed / speed, velocity);
	}

	//Water moves you slower than land, and a slight downward drift keeps the
	//player sinking when they stop swimming rather than hovering.
	QAccelerate(velocity, wishdir, wishspeed * QPHYS_WATERSPEED, QPHYS_ACCEL, dt);

	if (wishspeed < 1.0)
		velocity[2] -= QPHYS_WATERSINK * dt;

	QSlideMove(map, origin, velocity, dt);
}

U0 QPlayerMove(CQMap *map, F64 *origin, F64 *velocity, F64 *wishdir,
	F64 wishspeed, Bool jump, F64 dt, Bool *_on_ground, I64 water_level,
	Bool waterjump)
{//One tick of player movement.
	Bool on_ground;

	//Clamp to sv_maxspeed, as SV_AirMove does. Without this the requested speed
	//went through untouched, so the run key asked for 800 units/sec and got it.
	if (wishspeed > QPHYS_MAXSPEED)
		wishspeed = QPHYS_MAXSPEED;

	//Water jump: QuakeC's CheckWaterJump decides the player can climb out and
	//sets the flag plus an upward velocity. The engine's part is to stop
	//interfering - no gravity, no friction, no ground check - and simply carry
	//the motion until the flag clears. Applying gravity here would drag the
	//player straight back into the pool.
	if (waterjump)
	{
		QSlideMove(map, origin, velocity, dt);
		if (_on_ground)
			*_on_ground = FALSE;
		return;
	}

	//Swimming replaces the whole walking model: no ground contact, no gravity.
	if (water_level >= 2)
	{
		QWaterMove(map, origin, velocity, wishdir, wishspeed, dt);
		if (_on_ground)
			*_on_ground = FALSE;
		return;
	}

	//Ground state comes from the PREVIOUS move, exactly as SV_ClientThink reads
	//FL_ONGROUND before touching anything. There is no downward probe any more:
	//the move itself reports the floor it lands on, so the trace that stops the
	//fall and the flag that says "standing" can never disagree.
	//
	//The old probe was a 2-unit look-down run before the move. At high frame
	//rates a jump lifts the player less than that in a single step, so the probe
	//kept finding floor and the jump never left the ground - one of several
	//symptoms of deciding ground contact separately from the move.
	on_ground = FALSE;
	if (_on_ground)
		on_ground = *_on_ground;

	//User input first: friction and acceleration, per SV_AirMove.
	if (on_ground)
	{
		QFriction(velocity, dt);
		QAccelerate(velocity, wishdir, wishspeed, QPHYS_ACCEL, dt);

		//Only reached without the VM; QuakeC's PlayerJump owns this otherwise.
		if (jump)
		{
			velocity[2] = QPHYS_JUMP;
			on_ground   = FALSE;
		}
	}
	else
	{
		//Air control is deliberately weak.
		QAccelerate(velocity, wishdir, wishspeed, QPHYS_AIRACCEL, dt);
	}

	//Then gravity, then the move - SV_Physics_Client's order.
	//
	//Gravity is applied even when standing, and that is what makes standing
	//work at all: it guarantees a downward component for the move to find the
	//floor with. It cannot accumulate, because clipping against the floor plane
	//removes the component heading into it.
	velocity[2] -= QPHYS_GRAVITY * dt;

	QWalkMove(map, origin, velocity, dt, on_ground, &on_ground);

	if (_on_ground)
		*_on_ground = on_ground;
}
