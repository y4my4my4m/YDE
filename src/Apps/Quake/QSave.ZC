// QSave.ZC - saving and restoring a game in progress.
//
// The original writes a text .sav: every entity field printed by name, parsed
// back on load. That format depends on ftos-style float printing and a matching
// tokenizer, neither of which exists here, and round-tripping floats through
// decimal text loses precision that physics state cannot afford.
//
// So this writes its own BINARY container instead. It is not interchangeable
// with id's .sav files - a deliberate trade - but it captures strictly more
// state and cannot lose anything in conversion.
//
// What has to be captured is everything the VM cannot rebuild:
//   - the global pool, which holds QuakeC's own variables
//   - the entity field block and the free list
//   - the STRING HEAP, because map keys were appended to it at load and any
//     entity field holding one of those strings is an offset into it
//   - the precache lists, because .modelindex is an index INTO them and would
//     otherwise point at a different model after reload
//   - light styles, carried-over inventory, and the engine-side player state
//
// Reloading runs the map and bytecode up but NOT the spawn functions, then
// overwrites the world with what was saved.

#define QSAVE_MAGIC		0x56535A51	//"QZSV" little-endian
#define QSAVE_VERSION	1

class CQSaveHeader
{
	U32	magic;
	U32	version;
	U8	mapname[96];
	F64	game_time;
	F64	origin[3];
	F64	velocity[3];
	F64	angles[3];
	I64	on_ground;
	I64	water_level;
	I64	water_type;
	I64	num_edicts;
	I64	edict_stride;
	I64	num_globals;
	I64	strings_size;
	I64	string_alloc;
	I64	num_models;
	I64	num_sounds;
	F64	saved_parms[QGAME_MAX_PARMS];
	F64	saved_serverflags;
};

U8 *QSaveAppend(U8 *dst, U8 *src, I64 bytes)
{//Copy a block forward through the buffer and hand back the new write point.
	MemCpy(dst, src, bytes);
	return dst + bytes;
}

Bool QSaveWrite(U8 *path, U8 *mapname, F64 game_time, F64 *origin,
	F64 *velocity, F64 *angles, Bool on_ground, I64 water_level,
	I64 water_type)
{//Serialise the whole live world to one file.
	CQSaveHeader	 hdr;
	U8				*buf;
	U8				*p;
	I64				 total;
	I64				 edict_bytes;
	I64				 ofs;
	I64				 i;
	I64				 j;

	if (!q_game_active || !q_pr_edicts)
	{
		"QSave: no game in progress\n";
		return FALSE;
	}

	MemSet(&hdr, 0, sizeof(CQSaveHeader));

	hdr.magic        = QSAVE_MAGIC;
	hdr.version      = QSAVE_VERSION;
	QStrCopy(hdr.mapname, mapname, 96);
	hdr.game_time    = game_time;
	hdr.on_ground    = ToI64(on_ground);
	hdr.water_level  = water_level;
	hdr.water_type   = water_type;
	hdr.num_edicts   = q_pr_num_edicts;
	hdr.edict_stride = q_pr_edict_stride;
	hdr.num_globals  = q_pr_num_globals;
	hdr.strings_size = q_pr_strings_size;
	hdr.string_alloc = q_pr_string_alloc;
	hdr.num_models   = q_precache_model_count;
	hdr.num_sounds   = q_precache_sound_count;

	for (j = 0; j < 3; j++)
	{
		hdr.origin[j]   = origin[j];
		hdr.velocity[j] = velocity[j];
		hdr.angles[j]   = angles[j];
	}

	for (j = 0; j < QGAME_MAX_PARMS; j++)
		hdr.saved_parms[j] = q_saved_parms[j];
	hdr.saved_serverflags = q_saved_serverflags;

	edict_bytes = q_pr_num_edicts * q_pr_edict_stride;

	total = sizeof(CQSaveHeader)
		+ q_pr_num_globals * 4
		+ edict_bytes
		+ q_pr_num_edicts			//one free flag per edict
		+ q_pr_strings_size
		+ QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN
		+ (q_precache_model_count + q_precache_sound_count) * 8;

	buf = MAlloc(total);
	p   = buf;

	p = QSaveAppend(p, &hdr, sizeof(CQSaveHeader));
	p = QSaveAppend(p, q_pr_globals, q_pr_num_globals * 4);
	p = QSaveAppend(p, q_pr_edicts, edict_bytes);

	//Bool is wider than a byte here, so the free list is packed down.
	for (i = 0; i < q_pr_num_edicts; i++)
	{
		if (q_pr_edict_free[i])
			p[0] = 1;
		else
			p[0] = 0;
		p++;
	}

	p = QSaveAppend(p, q_pr_strings, q_pr_strings_size);
	p = QSaveAppend(p, q_lightstyle, QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN);

	//Precache names as OFFSETS into the string heap rather than copies of the
	//text. The whole heap is in this file already, so an offset is exact and
	//cannot drift from what the entities' string fields point at.
	for (i = 0; i < q_precache_model_count; i++)
	{
		ofs = 0;
		if (q_precache_model[i])
			ofs = q_precache_model[i] - q_pr_strings;
		MemCpy(p, &ofs, 8);
		p += 8;
	}

	for (i = 0; i < q_precache_sound_count; i++)
	{
		ofs = 0;
		if (q_precache_sound[i])
			ofs = q_precache_sound[i] - q_pr_strings;
		MemCpy(p, &ofs, 8);
		p += 8;
	}

	if (FileWrite(path, buf, total) < 1)
	{
		"QSave: could not write %s\n", path;
		Free(buf);
		return FALSE;
	}

	Free(buf);

	"QSave: wrote %s (%d bytes, %d edicts)\n", path, total, q_pr_num_edicts;
	return TRUE;
}

//Loading happens in two halves, because the map has to be brought up between
//them and only the app shell knows how to do that.
//
//QSaveReadHeader reads the file and reports which map is needed; the shell
//loads it; QSaveRestore then pours the saved state into the fresh world.
U8	*q_save_buf		= NULL;
I64	 q_save_size	= 0;
CQSaveHeader q_save_hdr;

U0 QSaveDiscard()
{
	if (q_save_buf)
	{
		Free(q_save_buf);
		q_save_buf = NULL;
	}
	q_save_size = 0;
}

Bool QSaveReadHeader(U8 *path, U8 *_mapname)
{//Load the file into memory and hand back the map it belongs to.
	I64 size = 0;

	QSaveDiscard;

	q_save_buf = FileRead(path, &size);
	if (!q_save_buf)
	{
		"QSave: %s not found\n", path;
		return FALSE;
	}

	q_save_size = size;

	if (size < sizeof(CQSaveHeader))
	{
		"QSave: %s is truncated\n", path;
		QSaveDiscard;
		return FALSE;
	}

	MemCpy(&q_save_hdr, q_save_buf, sizeof(CQSaveHeader));

	if (q_save_hdr.magic != QSAVE_MAGIC ||
		q_save_hdr.version != QSAVE_VERSION)
	{
		"QSave: %s is not a version %d save\n", path, QSAVE_VERSION;
		QSaveDiscard;
		return FALSE;
	}

	QStrCopy(_mapname, q_save_hdr.mapname, 96);
	return TRUE;
}

Bool QSaveRestore(F64 *_game_time, F64 *origin, F64 *velocity, F64 *angles,
	Bool *_on_ground, I64 *_water_level, I64 *_water_type)
{//Overwrite the freshly loaded world with the saved one.
	CQSaveHeader	*hdr = &q_save_hdr;
	U8				*p;
	I64				 edict_bytes;
	I64				 ofs;
	I64				 i;
	I64				 j;

	if (!q_save_buf)
		return FALSE;

	//The layouts must agree exactly, or the field block would be misread. They
	//can only differ if the bytecode changed under the save.
	if (hdr->edict_stride != q_pr_edict_stride ||
		hdr->num_globals != q_pr_num_globals ||
		hdr->strings_size != q_pr_strings_size)
	{
		"QSave: save does not match this progs.dat\n";
		QSaveDiscard;
		return FALSE;
	}

	if (hdr->num_edicts < 1 || hdr->num_edicts > q_pr_max_edicts)
	{
		"QSave: edict count out of range\n";
		QSaveDiscard;
		return FALSE;
	}

	edict_bytes = hdr->num_edicts * hdr->edict_stride;
	p           = q_save_buf + sizeof(CQSaveHeader);

	MemCpy(q_pr_globals, p, hdr->num_globals * 4);
	p += hdr->num_globals * 4;

	MemCpy(q_pr_edicts, p, edict_bytes);
	p += edict_bytes;

	for (i = 0; i < hdr->num_edicts; i++)
	{
		q_pr_edict_free[i] = ToBool(p[0]);
		p++;
	}

	q_pr_num_edicts = hdr->num_edicts;

	//The string heap carries every map key string the entities point into.
	MemCpy(q_pr_strings, p, hdr->strings_size);
	p += hdr->strings_size;
	q_pr_string_alloc = hdr->string_alloc;

	MemCpy(q_lightstyle, p, QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN);
	p += QMAX_LIGHTSTYLES * QLIGHTSTYLE_LEN;

	//Rebuild the precache lists in index order. Re-precaching by name returns
	//the same indices and reloads each model through the shared cache, so every
	//.modelindex still refers to the model it did when the game was saved.
	for (i = 0; i < hdr->num_models; i++)
	{
		MemCpy(&ofs, p, 8);
		p += 8;

		if (i > 0 && ofs > 0 && ofs < q_pr_strings_size)
			QBiPrecacheModel(QPrStr(ofs));
	}

	for (i = 0; i < hdr->num_sounds; i++)
	{
		MemCpy(&ofs, p, 8);
		p += 8;

		if (ofs > 0 && ofs < q_pr_strings_size &&
			q_precache_sound_count < QBI_MAX_PRECACHE)
		{
			q_precache_sound[q_precache_sound_count] = QPrStr(ofs);
			q_precache_sound_count++;
		}
	}

	for (j = 0; j < QGAME_MAX_PARMS; j++)
		q_saved_parms[j] = hdr->saved_parms[j];
	q_saved_serverflags = hdr->saved_serverflags;
	q_have_saved_parms  = TRUE;

	for (j = 0; j < 3; j++)
	{
		origin[j]   = hdr->origin[j];
		velocity[j] = hdr->velocity[j];
		angles[j]   = hdr->angles[j];
	}

	*_game_time   = hdr->game_time;
	*_on_ground   = ToBool(hdr->on_ground);
	*_water_level = hdr->water_level;
	*_water_type  = hdr->water_type;

	//QuakeC's own clock has to agree with the restored time or every scheduled
	//think would fire at once, or never.
	QPrSetF(q_ofs_time, hdr->game_time);
	q_game_time = hdr->game_time;

	//Bounding boxes are derived state; rebuild them rather than trusting them.
	QGameLinkAll;

	"QSave: restored %d edicts at t=%.1f\n", q_pr_num_edicts, hdr->game_time;

	QSaveDiscard;
	return TRUE;
}
