// QPart.ZC - particle effects.
//
// Almost every visible effect in Quake (explosions, blood, sparks, teleport
// fog) is not spawned by the "particle" builtin. It is broadcast as a
// TEMP ENTITY inside a network message, assembled by the Write* builtins.
// With those stubbed out the game runs but is completely silent visually,
// which is why nothing appeared before.
//
// Particles are drawn as single points, depth tested against the world so
// they correctly disappear behind geometry.

#define QPART_MAX		2048
#define QPART_GRAVITY	-40.0	//particles fall slower than players

//Particle behaviours, matching how the originals animate.
#define QPT_STATIC		0
#define QPT_GRAV		1
#define QPT_FIRE		2		//ramps up the colour table then dies
#define QPT_EXPLODE		3
#define QPT_BLOB		4

class CQParticle
{
	F64	org[3];
	F64	vel[3];
	F64	die;
	F64	ramp;
	I64	color;
	I64	type;
};

CQParticle	q_particles[QPART_MAX];
I64			q_part_count	= 0;
I64			q_part_drawn	= 0;

//Colour ramps for fire and explosion particles: an index walks along these as
//the particle ages, so it cools from bright yellow down to dark red.
I64 q_ramp_fire[8]		= {0x6f, 0x6e, 0x6d, 0x6c, 0x6b, 0x6a, 0x68, 0x66};
I64 q_ramp_explode[8]	= {0x6f, 0x6d, 0x6b, 0x69, 0x67, 0x65, 0x63, 0x61};

U0 QPartInit()
{//Globals are not zeroed by the JIT, and this array is walked every frame.
	I64 i;

	for (i = 0; i < QPART_MAX; i++)
	{
		q_particles[i].die   = 0.0;
		q_particles[i].type  = QPT_STATIC;
		q_particles[i].color = 0;
		q_particles[i].ramp  = 0.0;
		QVecSet(q_particles[i].org, 0.0, 0.0, 0.0);
		QVecSet(q_particles[i].vel, 0.0, 0.0, 0.0);
	}

	q_part_count = 0;
	q_part_drawn = 0;
}

F64 QPartRand(F64 range)
{//Symmetric random in [-range, range].
	return (ToF64(RandU32 & 0xFFFF) / 32768.0 - 1.0) * range;
}

I64 QPartRandI(I64 n)
{
	if (n <= 0)
		return 0;

	return RandU32 % n;
}

CQParticle *QPartAlloc(F64 now)
{//Reuse the first dead slot. Returns NULL when saturated, which simply means
 //a busy moment drops some sparks rather than stalling.
	I64 i;

	for (i = 0; i < QPART_MAX; i++)
	{
		if (q_particles[i].die <= now)
		{
			if (i >= q_part_count)
				q_part_count = i + 1;
			return &q_particles[i];
		}
	}

	return NULL;
}

U0 QPartExplosion(F64 *org, F64 now)
{//A ball of fire particles, half rising and half falling.
	CQParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < 512; i++)
	{
		p = QPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 5.0;
		p->color = q_ramp_explode[0];
		p->ramp  = ToF64(QPartRandI(4));

		if (i & 1)
			p->type = QPT_EXPLODE;
		else
			p->type = QPT_FIRE;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(QPartRandI(32) - 16);
			p->vel[j] = QPartRand(256.0);
		}
	}
}

U0 QPartEffect(F64 *org, F64 *dir, I64 color, I64 count, F64 now)
{//The generic burst used for blood, gunshots and impacts. The colour is
 //snapped to an 8-entry group and randomised inside it, which is how the
 //originals get their speckled look.
	CQParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < count; i++)
	{
		p = QPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 0.1 * ToF64(QPartRandI(5));
		p->color = (color & ~7) + QPartRandI(8);
		p->type  = QPT_GRAV;
		p->ramp  = 0.0;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(QPartRandI(16) - 8);
			if (dir)
				p->vel[j] = dir[j] * 15.0 + QPartRand(150.0);
			else
				p->vel[j] = QPartRand(150.0);
		}
	}
}

U0 QPartLavaSplash(F64 *org, F64 now)
{//The wide upward fountain used when something big dies.
	CQParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;

	for (i = -16; i < 16; i++)
	{
		for (j = -16; j < 16; j++)
		{
			p = QPartAlloc(now);
			if (!p)
				return;

			p->die   = now + 2.0 + ToF64(QPartRandI(64)) / 64.0;
			p->color = 224 + QPartRandI(8);
			p->type  = QPT_BLOB;
			p->ramp  = 0.0;

			dir[0] = ToF64(j * 8 + QPartRandI(8));
			dir[1] = ToF64(i * 8 + QPartRandI(8));
			dir[2] = 256.0;

			p->org[0] = org[0] + dir[0];
			p->org[1] = org[1] + dir[1];
			p->org[2] = org[2] + ToF64(QPartRandI(64));

			QVecNormalize(dir);
			vel = 50.0 + ToF64(QPartRandI(64));
			QVecScale(dir, vel, p->vel);
		}
	}
}

U0 QPartTeleport(F64 *org, F64 now)
{//A hollow box of rising sparks.
	CQParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;
	I64			 k;

	for (i = -16; i < 16; i += 4)
	{
		for (j = -16; j < 16; j += 4)
		{
			for (k = -24; k < 32; k += 4)
			{
				p = QPartAlloc(now);
				if (!p)
					return;

				p->die   = now + 0.2 + ToF64(QPartRandI(8)) / 64.0;
				p->color = 7 + QPartRandI(8);
				p->type  = QPT_STATIC;
				p->ramp  = 0.0;

				p->org[0] = org[0] + ToF64(i) + ToF64(QPartRandI(4));
				p->org[1] = org[1] + ToF64(j) + ToF64(QPartRandI(4));
				p->org[2] = org[2] + ToF64(k) + ToF64(QPartRandI(4));

				dir[0] = ToF64(j * 8);
				dir[1] = ToF64(i * 8);
				dir[2] = ToF64(k * 8);

				QVecNormalize(dir);
				vel = 50.0 + ToF64(QPartRandI(64));
				QVecScale(dir, vel, p->vel);
			}
		}
	}
}

//--- entity trails ---------------------------------------------------------
//
// R_RocketTrail. The trail is laid along the segment an entity moved since the
// last frame, one particle every three units, so it is speed independent - a
// fast rocket leaves the same density as a slow one. Which trail is chosen
// comes from the model header's flags word.

#define QTRAIL_ROCKET	0
#define QTRAIL_SMOKE	1
#define QTRAIL_BLOOD	2
#define QTRAIL_TRACER	3
#define QTRAIL_SLIGHT	4		//zombie gib: sparser blood
#define QTRAIL_TRACER2	5
#define QTRAIL_VOOR		6

//Per-entity trail memory for the edict render path. CL_RelinkEntities keeps
//the previous position on the client entity itself; the QuakeC path has no
//such record, because the edict only ever holds where the entity IS.
#define QTRAIL_MAX_ENTS	1024

F64	 q_trail_org[QTRAIL_MAX_ENTS * 3];
Bool q_trail_valid[QTRAIL_MAX_ENTS];

U0 QPartTrailReset()
{//Globals are not zeroed, and a slot carried across a map load would lay a
 //trail from the old level's coordinates to the new one's.
	I64 i;

	for (i = 0; i < QTRAIL_MAX_ENTS; i++)
	{
		q_trail_valid[i]        = FALSE;
		q_trail_org[i * 3]      = 0.0;
		q_trail_org[i * 3 + 1]  = 0.0;
		q_trail_org[i * 3 + 2]  = 0.0;
	}
}

U0 QPartTrail(F64 *start, F64 *end, I64 type, F64 now)
{
	CQParticle	*p;
	F64			 vec[3];
	F64			 pos[3];
	F64			 len;
	I64			 step;
	I64			 j;

	QVecCopy(start, pos);
	QVecSub(end, start, vec);
	len = QVecLength(vec);

	if (len < 0.01)
		return;

	//A teleport or a respawn moves an entity an arbitrary distance in one
	//frame; drawing that as a trail paints a line across the level.
	if (len > 1000.0)
		return;

	QVecScale(vec, 1.0 / len, vec);

	//Blood is laid at a third the density, as the original does.
	step = 3;
	if (type == QTRAIL_SLIGHT)
		step = 6;

	while (len > 0.0)
	{
		len -= ToF64(step);

		p = QPartAlloc(now);
		if (!p)
			return;

		QVecSet(p->vel, 0.0, 0.0, 0.0);
		p->ramp = 0.0;
		p->type = QPT_STATIC;
		p->die  = now + 2.0;

		switch (type)
		{
			case QTRAIL_ROCKET:
				//Fire ramp, drifting upward as it cools.
				p->die   = now + 2.0;
				p->type  = QPT_FIRE;
				p->ramp  = ToF64(QPartRandI(4));
				p->color = q_ramp_fire[ClampI64(ToI64(p->ramp), 0, 7)];
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + QPartRand(3.0);
				break;

			case QTRAIL_SMOKE:
				p->die   = now + 2.0;
				p->type  = QPT_FIRE;
				p->ramp  = ToF64(QPartRandI(4)) + 2.0;
				p->color = q_ramp_fire[ClampI64(ToI64(p->ramp), 0, 7)];
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + QPartRand(3.0);
				break;

			case QTRAIL_BLOOD:
			case QTRAIL_SLIGHT:
				//Blood falls. The palette's blood range is 67..70.
				p->die   = now + 2.0;
				p->type  = QPT_GRAV;
				p->color = 67 + QPartRandI(4);
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + QPartRand(3.0);
				break;

			case QTRAIL_TRACER:
			case QTRAIL_TRACER2:
				p->die   = now + 0.5;
				p->type  = QPT_STATIC;
				if (type == QTRAIL_TRACER)
					p->color = 52 + (QPartRandI(2) << 1);
				else
					p->color = 230 + (QPartRandI(2) << 1);
				QVecCopy(pos, p->org);
				break;

			default:
				//TRAIL_VOOR - the Vore's purple spit.
				p->die   = now + 0.3;
				p->color = 9 * 16 + 8 + QPartRandI(4);
				for (j = 0; j < 3; j++)
					p->org[j] = pos[j] + QPartRand(16.0);
				break;
		}

		QVecMA(pos, ToF64(step), vec, pos);
	}
}

U0 QPartEntityTrail(I64 slot, F64 *org, I64 flags, F64 now)
{//CL_RelinkEntities' trail dispatch. The model header's flags word decides
 //which trail an entity leaves; the segment runs from where it was when it
 //was last drawn to where it is now.
	F64 *prev;

	if (slot < 0 || slot >= QTRAIL_MAX_ENTS || !flags)
		return;

	prev = q_trail_org + slot * 3;

	if (q_trail_valid[slot])
	{
		if (flags & QEF_ROCKET)
			QPartTrail(prev, org, QTRAIL_ROCKET, now);
		else if (flags & QEF_GRENADE)
			QPartTrail(prev, org, QTRAIL_SMOKE, now);
		else if (flags & QEF_GIB)
			QPartTrail(prev, org, QTRAIL_BLOOD, now);
		else if (flags & QEF_ZOMGIB)
			QPartTrail(prev, org, QTRAIL_SLIGHT, now);
		else if (flags & QEF_TRACER)
			QPartTrail(prev, org, QTRAIL_TRACER, now);
		else if (flags & QEF_TRACER2)
			QPartTrail(prev, org, QTRAIL_TRACER2, now);
		else if (flags & QEF_TRACER3)
			QPartTrail(prev, org, QTRAIL_VOOR, now);
	}

	QVecCopy(org, prev);
	q_trail_valid[slot] = TRUE;
}

U0 QPartUpdate(F64 dt, F64 now)
{//Age every live particle and advance its colour ramp.
	CQParticle	*p;
	I64			 i;
	I64			 idx;

	for (i = 0; i < q_part_count; i++)
	{
		p = &q_particles[i];

		if (p->die <= now)
			goto qp_next;

		QVecMA(p->org, dt, p->vel, p->org);

		switch (p->type)
		{
			case QPT_FIRE:
				//Ramps at 5Hz through the fire table, then expires.
				p->ramp += dt * 5.0;
				idx = ToI64(p->ramp);
				if (idx >= 6)
					p->die = now;
				else
					p->color = q_ramp_fire[ClampI64(idx, 0, 7)];
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			case QPT_EXPLODE:
				p->ramp += dt * 10.0;
				idx = ToI64(p->ramp);
				if (idx >= 8)
					p->die = now;
				else
					p->color = q_ramp_explode[ClampI64(idx, 0, 7)];
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			case QPT_GRAV:
			case QPT_BLOB:
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			default:
				break;
		}

qp_next:
	}
}

U0 QPartDraw(CQCanvas *c, F64 now)
{//Project each live particle and plot a depth-tested point.
	CQParticle	*p;
	F64			 rel[3];
	F64			 cam[3];
	F64			 inv_z;
	F64			 sx;
	F64			 sy;
	I64			 i;
	I64			 x;
	I64			 y;
	I64			 px;
	I64			 py;
	I64			 size;
	I64			 izi;
	I64			 pix_shift;
	I64			 pix_min;
	I64			 pix_max;

	q_part_drawn = 0;

	//D_DrawParticle sizing, from d_init.c's D_SetupFrame. A particle is a
	//SQUARE BLOCK whose side comes straight from 1/z, so it grows as it nears
	//the eye instead of staying a speck - that is what makes an explosion read
	//as a cloud rather than static.
	//
	//All three bounds scale with the viewport width, which is what keeps the
	//APPARENT size constant across resolutions: at 320 wide a particle runs
	//1..4 pixels, at 640 it runs 2..8 and covers the same part of the screen.
	pix_shift = 8 - ToI64(ToF64(c->width) / 320.0 + 0.5);
	pix_min   = c->width / 320;
	if (pix_min < 1)
		pix_min = 1;
	pix_max = ToI64(ToF64(c->width) / 80.0 + 0.5);
	if (pix_max < 1)
		pix_max = 1;

	for (i = 0; i < q_part_count; i++)
	{
		p = &q_particles[i];

		if (p->die <= now)
			goto qd_next;

		QVecSub(p->org, c->origin, rel);
		cam[2] = QVecDot(rel, c->forward);

		//Behind the eye, or close enough to be inside it.
		if (cam[2] < QNEAR_CLIP)
			goto qd_next;

		cam[0] = QVecDot(rel, c->right);
		cam[1] = QVecDot(rel, c->up);

		inv_z = 1.0 / cam[2];
		sx    = c->center_x + cam[0] * c->x_scale * inv_z;
		sy    = c->center_y - cam[1] * c->y_scale * inv_z;

		x = ToI64(sx);
		y = ToI64(sy);

		//izi is the original's fixed-point 1/z: zi * 0x8000. The shift then
		//turns it into a pixel count, so the whole size curve is one shift of
		//the reciprocal depth the projection already produced.
		izi  = ToI64(inv_z * 32768.0);
		size = izi >> pix_shift;

		if (size < pix_min)
			size = pix_min;
		else if (size > pix_max)
			size = pix_max;

		for (py = y; py < y + size; py++)
		{
			if (py < 0 || py >= c->height)
				goto qd_skip_row;

			for (px = x; px < x + size; px++)
			{
				if (px >= 0 && px < c->width)
				{
					if (inv_z > c->depth[py * c->width + px])
					{
						c->pixels[py * c->width + px] = p->color;
						c->depth[py * c->width + px]  = inv_z;
					}
				}
			}

qd_skip_row:
		}

		q_part_drawn++;

qd_next:
	}
}
