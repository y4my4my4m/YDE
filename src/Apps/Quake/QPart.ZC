// QPart.ZC - particle effects.
//
// Almost every visible effect in Quake (explosions, blood, sparks, teleport
// fog) is not spawned by the "particle" builtin. It is broadcast as a
// TEMP ENTITY inside a network message, assembled by the Write* builtins.
// With those stubbed out the game runs but is completely silent visually,
// which is why nothing appeared before.
//
// Particles are drawn as single points, depth tested against the world so
// they correctly disappear behind geometry.

#define QPART_MAX		2048
#define QPART_GRAVITY	-40.0	//particles fall slower than players

//Particle behaviours, matching how the originals animate.
#define QPT_STATIC		0
#define QPT_GRAV		1
#define QPT_FIRE		2		//ramps up the colour table then dies
#define QPT_EXPLODE		3
#define QPT_BLOB		4

class CQParticle
{
	F64	org[3];
	F64	vel[3];
	F64	die;
	F64	ramp;
	I64	color;
	I64	type;
};

CQParticle	q_particles[QPART_MAX];
I64			q_part_count	= 0;
I64			q_part_drawn	= 0;

//Colour ramps for fire and explosion particles: an index walks along these as
//the particle ages, so it cools from bright yellow down to dark red.
I64 q_ramp_fire[8]		= {0x6f, 0x6e, 0x6d, 0x6c, 0x6b, 0x6a, 0x68, 0x66};
I64 q_ramp_explode[8]	= {0x6f, 0x6d, 0x6b, 0x69, 0x67, 0x65, 0x63, 0x61};

U0 QPartInit()
{//Globals are not zeroed by the JIT, and this array is walked every frame.
	I64 i;

	for (i = 0; i < QPART_MAX; i++)
	{
		q_particles[i].die   = 0.0;
		q_particles[i].type  = QPT_STATIC;
		q_particles[i].color = 0;
		q_particles[i].ramp  = 0.0;
		QVecSet(q_particles[i].org, 0.0, 0.0, 0.0);
		QVecSet(q_particles[i].vel, 0.0, 0.0, 0.0);
	}

	q_part_count = 0;
	q_part_drawn = 0;
}

F64 QPartRand(F64 range)
{//Symmetric random in [-range, range].
	return (ToF64(RandU32 & 0xFFFF) / 32768.0 - 1.0) * range;
}

I64 QPartRandI(I64 n)
{
	if (n <= 0)
		return 0;

	return RandU32 % n;
}

CQParticle *QPartAlloc(F64 now)
{//Reuse the first dead slot. Returns NULL when saturated, which simply means
 //a busy moment drops some sparks rather than stalling.
	I64 i;

	for (i = 0; i < QPART_MAX; i++)
	{
		if (q_particles[i].die <= now)
		{
			if (i >= q_part_count)
				q_part_count = i + 1;
			return &q_particles[i];
		}
	}

	return NULL;
}

U0 QPartExplosion(F64 *org, F64 now)
{//A ball of fire particles, half rising and half falling.
	CQParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < 512; i++)
	{
		p = QPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 5.0;
		p->color = q_ramp_explode[0];
		p->ramp  = ToF64(QPartRandI(4));

		if (i & 1)
			p->type = QPT_EXPLODE;
		else
			p->type = QPT_FIRE;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(QPartRandI(32) - 16);
			p->vel[j] = QPartRand(256.0);
		}
	}
}

U0 QPartEffect(F64 *org, F64 *dir, I64 color, I64 count, F64 now)
{//The generic burst used for blood, gunshots and impacts. The colour is
 //snapped to an 8-entry group and randomised inside it, which is how the
 //originals get their speckled look.
	CQParticle	*p;
	I64			 i;
	I64			 j;

	for (i = 0; i < count; i++)
	{
		p = QPartAlloc(now);
		if (!p)
			return;

		p->die   = now + 0.1 * ToF64(QPartRandI(5));
		p->color = (color & ~7) + QPartRandI(8);
		p->type  = QPT_GRAV;
		p->ramp  = 0.0;

		for (j = 0; j < 3; j++)
		{
			p->org[j] = org[j] + ToF64(QPartRandI(16) - 8);
			if (dir)
				p->vel[j] = dir[j] * 15.0 + QPartRand(150.0);
			else
				p->vel[j] = QPartRand(150.0);
		}
	}
}

U0 QPartLavaSplash(F64 *org, F64 now)
{//The wide upward fountain used when something big dies.
	CQParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;

	for (i = -16; i < 16; i++)
	{
		for (j = -16; j < 16; j++)
		{
			p = QPartAlloc(now);
			if (!p)
				return;

			p->die   = now + 2.0 + ToF64(QPartRandI(64)) / 64.0;
			p->color = 224 + QPartRandI(8);
			p->type  = QPT_BLOB;
			p->ramp  = 0.0;

			dir[0] = ToF64(j * 8 + QPartRandI(8));
			dir[1] = ToF64(i * 8 + QPartRandI(8));
			dir[2] = 256.0;

			p->org[0] = org[0] + dir[0];
			p->org[1] = org[1] + dir[1];
			p->org[2] = org[2] + ToF64(QPartRandI(64));

			QVecNormalize(dir);
			vel = 50.0 + ToF64(QPartRandI(64));
			QVecScale(dir, vel, p->vel);
		}
	}
}

U0 QPartTeleport(F64 *org, F64 now)
{//A hollow box of rising sparks.
	CQParticle	*p;
	F64			 dir[3];
	F64			 vel;
	I64			 i;
	I64			 j;
	I64			 k;

	for (i = -16; i < 16; i += 4)
	{
		for (j = -16; j < 16; j += 4)
		{
			for (k = -24; k < 32; k += 4)
			{
				p = QPartAlloc(now);
				if (!p)
					return;

				p->die   = now + 0.2 + ToF64(QPartRandI(8)) / 64.0;
				p->color = 7 + QPartRandI(8);
				p->type  = QPT_STATIC;
				p->ramp  = 0.0;

				p->org[0] = org[0] + ToF64(i) + ToF64(QPartRandI(4));
				p->org[1] = org[1] + ToF64(j) + ToF64(QPartRandI(4));
				p->org[2] = org[2] + ToF64(k) + ToF64(QPartRandI(4));

				dir[0] = ToF64(j * 8);
				dir[1] = ToF64(i * 8);
				dir[2] = ToF64(k * 8);

				QVecNormalize(dir);
				vel = 50.0 + ToF64(QPartRandI(64));
				QVecScale(dir, vel, p->vel);
			}
		}
	}
}

U0 QPartUpdate(F64 dt, F64 now)
{//Age every live particle and advance its colour ramp.
	CQParticle	*p;
	I64			 i;
	I64			 idx;

	for (i = 0; i < q_part_count; i++)
	{
		p = &q_particles[i];

		if (p->die <= now)
			goto qp_next;

		QVecMA(p->org, dt, p->vel, p->org);

		switch (p->type)
		{
			case QPT_FIRE:
				//Ramps at 5Hz through the fire table, then expires.
				p->ramp += dt * 5.0;
				idx = ToI64(p->ramp);
				if (idx >= 6)
					p->die = now;
				else
					p->color = q_ramp_fire[ClampI64(idx, 0, 7)];
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			case QPT_EXPLODE:
				p->ramp += dt * 10.0;
				idx = ToI64(p->ramp);
				if (idx >= 8)
					p->die = now;
				else
					p->color = q_ramp_explode[ClampI64(idx, 0, 7)];
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			case QPT_GRAV:
			case QPT_BLOB:
				p->vel[2] += QPART_GRAVITY * dt;
				break;

			default:
				break;
		}

qp_next:
	}
}

U0 QPartDraw(CQCanvas *c, F64 now)
{//Project each live particle and plot a depth-tested point.
	CQParticle	*p;
	F64			 rel[3];
	F64			 cam[3];
	F64			 inv_z;
	F64			 sx;
	F64			 sy;
	I64			 i;
	I64			 x;
	I64			 y;
	I64			 px;
	I64			 py;
	I64			 size;

	q_part_drawn = 0;

	for (i = 0; i < q_part_count; i++)
	{
		p = &q_particles[i];

		if (p->die <= now)
			goto qd_next;

		QVecSub(p->org, c->origin, rel);
		cam[2] = QVecDot(rel, c->forward);

		//Behind the eye, or close enough to be inside it.
		if (cam[2] < QNEAR_CLIP)
			goto qd_next;

		cam[0] = QVecDot(rel, c->right);
		cam[1] = QVecDot(rel, c->up);

		inv_z = 1.0 / cam[2];
		sx    = c->center_x + cam[0] * c->x_scale * inv_z;
		sy    = c->center_y - cam[1] * c->y_scale * inv_z;

		x = ToI64(sx);
		y = ToI64(sy);

		//Nearby particles cover more than one pixel, which keeps explosions
		//readable instead of dissolving into single specks up close.
		if (cam[2] < 128.0)
			size = 2;
		else
			size = 1;

		for (py = y; py < y + size; py++)
		{
			if (py < 0 || py >= c->height)
				goto qd_skip_row;

			for (px = x; px < x + size; px++)
			{
				if (px >= 0 && px < c->width)
				{
					if (inv_z > c->depth[py * c->width + px])
					{
						c->pixels[py * c->width + px] = p->color;
						c->depth[py * c->width + px]  = inv_z;
					}
				}
			}

qd_skip_row:
		}

		q_part_drawn++;

qd_next:
	}
}
