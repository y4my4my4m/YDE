// QWad.ZC - Draw_PicFromWad, 2d art from WAD2 lumps and .lmp files
//
//   gfx.wad    163 lumps - SBAR/IBAR, the big HUD digits, icons, faces, and
//              CONCHARS, a 128x128 atlas of 8x8 glyphs used for all text
//   gfx/*.lmp  standalone pictures - menu art, console backdrop, banners
//
// both are 8bpp palette indices in a (width, height, pixels) layout,
// index 255 transparent
//
// everything draws into the 320x240 indexed canvas, not the host window - the
// interface has to go through the same palette as the world

#define QWAD_MAX_LUMPS	256
#define QPIC_TRANSPARENT 255
#define QCHAR_W			8
#define QCHAR_H			8

class CQPic
{
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from the archive; never freed here
};

class CQWadLump
{
	U8	 name[20];
	U8	*data;
	I64	 size;
};

CQWadLump	q_wad_lumps[QWAD_MAX_LUMPS];
I64			q_wad_count		= 0;
U8			*q_conchars		= NULL;		//128x128 glyph atlas
Bool		 q_wad_ready	= FALSE;

U0 QWadInit()
{//globals aren't zeroed, clear first
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 count;
	I64	 table;
	I64	 pos;
	I64	 dsize;
	I64	 i;

	for (i = 0; i < QWAD_MAX_LUMPS; i++)
	{
		q_wad_lumps[i].name[0] = 0;
		q_wad_lumps[i].data    = NULL;
		q_wad_lumps[i].size    = 0;
	}

	q_wad_count  = 0;
	q_conchars   = NULL;
	q_wad_ready  = FALSE;

	d = QPakData("gfx.wad", &size);
	if (!d || size < 12 || MemCompare(d, "WAD2", 4))
	{
		"QWad: gfx.wad missing or not WAD2\n";
		return;
	}

	count = QRdI32(d + 4);
	table = QRdI32(d + 8);

	if (count < 1 || table < 0 || table + count * 32 > size)
	{
		"QWad: gfx.wad directory is out of range\n";
		return;
	}

	for (i = 0; i < count && q_wad_count < QWAD_MAX_LUMPS; i++)
	{
		rec   = d + table + i * 32;
		pos   = QRdI32(rec);
		dsize = QRdI32(rec + 4);

		if (pos < 0 || pos + dsize > size)
			goto qw_next;

		QRdName(rec + 16, q_wad_lumps[q_wad_count].name, 17);
		q_wad_lumps[q_wad_count].data = d + pos;
		q_wad_lumps[q_wad_count].size = dsize;

		//CONCHARS is raw 128x128, no width/height header
		if (!StrICompare(q_wad_lumps[q_wad_count].name, "CONCHARS"))
			q_conchars = d + pos;

		q_wad_count++;

qw_next:
	}

	q_wad_ready = TRUE;
}

Bool QWadPic(U8 *name, CQPic *out)
{//Draw_PicFromWad
	I64 i;

	out->width  = 0;
	out->height = 0;
	out->pixels = NULL;

	for (i = 0; i < q_wad_count; i++)
	{
		if (!StrICompare(q_wad_lumps[i].name, name))
		{
			if (q_wad_lumps[i].size < 8)
				return FALSE;

			out->width  = QRdI32(q_wad_lumps[i].data);
			out->height = QRdI32(q_wad_lumps[i].data + 4);
			out->pixels = q_wad_lumps[i].data + 8;

			if (out->width < 1 || out->height < 1 ||
				out->width * out->height + 8 > q_wad_lumps[i].size)
			{
				out->pixels = NULL;
				return FALSE;
			}

			return TRUE;
		}
	}

	return FALSE;
}

Bool QPicLoad(U8 *path, CQPic *out)
{//Draw_CachePic - standalone gfx/*.lmp
	U8	*d;
	I64	 size = 0;

	out->width  = 0;
	out->height = 0;
	out->pixels = NULL;

	d = QPakData(path, &size);
	if (!d || size < 8)
		return FALSE;

	out->width  = QRdI32(d);
	out->height = QRdI32(d + 4);
	out->pixels = d + 8;

	if (out->width < 1 || out->height < 1 ||
		out->width * out->height + 8 > size)
	{
		out->pixels = NULL;
		return FALSE;
	}

	return TRUE;
}

U0 QPicDrawFillPart(CQCanvas *c, CQPic *pic, I64 height)
{//stretch to canvas width but only height rows, sampling the bottom of the
 //source so the lower edges line up - the console dropping down
	U8	*src;
	U8	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (height > c->height)
		height = c->height;
	if (height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / height;

	sy_fp = 0;
	for (py = 0; py < height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = src[sx_fp >> 16];
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 QPicDrawFill(CQCanvas *c, CQPic *pic)
{//stretch over the whole canvas
 //
 //menu art is 320x200 and the target can be any size, drawing it native left
 //the rest of the screen black
 //
 //16.16 fixed point, nearest sample - no filtering, keeps the look
 //16.16 fixed point stepping, nearest sample - no filtering, to keep the look.
	U8	*src;
	U8	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / c->height;

	sy_fp = 0;
	for (py = 0; py < c->height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = src[sx_fp >> 16];
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 QPicTile(CQCanvas *c, CQPic *pic, I64 x, I64 y, I64 w, I64 h)
{//Draw_TileClear - aligned to the screen, not the rect, so adjacent calls
 //line up seamlessly
	U8	*row;
	U8	*src;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (x < 0)			{ w += x; x = 0; }
	if (y < 0)			{ h += y; y = 0; }
	if (x + w > c->width)	w = c->width - x;
	if (y + h > c->height)	h = c->height - y;

	if (w < 1 || h < 1)
		return;

	for (py = y; py < y + h; py++)
	{
		row = c->pixels + py * c->width;
		sy  = py % pic->height;
		src = pic->pixels + sy * pic->width;

		for (px = x; px < x + w; px++)
		{
			sx = px % pic->width;
			row[px] = src[sx];
		}
	}
}

U0 QPicDraw(CQCanvas *c, CQPic *pic, I64 x, I64 y)
{//Draw_Pic - index 255 transparent, no depth test, always on top
	U8	*src;
	U8	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qp_next_row;

		src = pic->pixels + sy * pic->width;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < pic->width; sx++)
		{
			px = x + sx;
			if (px < 0 || px >= c->width)
				goto qp_next_col;

			texel = src[sx];
			if (texel != QPIC_TRANSPARENT)
				dst[px] = texel;

qp_next_col:
		}

qp_next_row:
	}
}

U0 QPicDrawPart(CQCanvas *c, CQPic *pic, I64 x, I64 y, I64 sub_x, I64 sub_w)
{//Draw_TransPicTranslate - the status bar is cut out of the 320-wide SBAR
 //and IBAR strips, so the source stride stays the full picture width
	U8	*src;
	U8	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels || sub_w < 1)
		return;

	if (sub_x < 0)
		sub_x = 0;
	if (sub_x + sub_w > pic->width)
		sub_w = pic->width - sub_x;
	if (sub_w < 1)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qpp_next_row;

		src = pic->pixels + sy * pic->width + sub_x;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < sub_w; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel != QPIC_TRANSPARENT)
					dst[px] = texel;
			}
		}

qpp_next_row:
	}
}

U0 QCharDraw(CQCanvas *c, I64 x, I64 y, I64 ch)
{//Draw_Character - 16x16 grid, index 0 transparent so text sits over the
 //world without a box behind it
	U8	*src;
	U8	*dst;
	I64	 row;
	I64	 col;
	I64	 sx;
	I64	 sy;
	I64	 py;
	I64	 px;
	U8	 texel;

	//only 32 is skipped - CONCHARS carries real glyphs below it, the small gold
	//digits at 18..27 that the inventory bar ammo counts use, plus menu arrows
	if (!q_conchars || ch == 32 || ch < 0)
		return;

	ch &= 255;
	row = (ch >> 4) * QCHAR_H;
	col = (ch & 15) * QCHAR_W;

	for (sy = 0; sy < QCHAR_H; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qc_next_row;

		src = q_conchars + (row + sy) * 128 + col;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < QCHAR_W; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel)
					dst[px] = texel;
			}
		}

qc_next_row:
	}
}

U0 QStrDraw(CQCanvas *c, I64 x, I64 y, U8 *s)
{
	I64 i = 0;

	while (s[i])
	{
		QCharDraw(c, x + i * QCHAR_W, y, s[i]);
		i++;
	}
}

U0 QStrDrawAlt(CQCanvas *c, I64 x, I64 y, U8 *s)
{//M_Print - every character with 128 added
 //
 //CONCHARS holds two 128-glyph sets, plain for the console and gold in the
 //upper half, M_PrintWhite is the exception
	I64 i = 0;

	while (s[i])
	{
		QCharDraw(c, x + i * QCHAR_W, y, s[i] + 128);
		i++;
	}
}

U0 QStrDrawCenter(CQCanvas *c, I64 y, U8 *s)
{
	QStrDraw(c, (c->width - StrLen(s) * QCHAR_W) / 2, y, s);
}

U0 QStrDrawCenterAlt(CQCanvas *c, I64 y, U8 *s)
{
	QStrDrawAlt(c, (c->width - StrLen(s) * QCHAR_W) / 2, y, s);
}
