// QWad.ZC - 2D picture assets: WAD2 lumps, .lmp files, and the console font.
//
// Two containers hold everything the interface is made of:
//
//   gfx.wad    163 lumps - the status bar (SBAR/IBAR), the big HUD digits
//              (NUM_/ANUM_), ammo and armor icons, the player faces, and
//              CONCHARS, a 128x128 atlas of 8x8 glyphs used for all text.
//   gfx/*.lmp  standalone pictures - the menu art, the console backdrop, the
//              loading and pause banners.
//
// Both store 8bpp indices into the game palette, and both use a plain
// (width, height, pixels) layout. Index 255 is transparent.
//
// Everything here draws into the 320x240 indexed canvas, NOT the host window.
// The interface has to live at the game's resolution
// and go through the same palette as the world, or it looks pasted on.

#define QWAD_MAX_LUMPS	256
#define QPIC_TRANSPARENT 255
#define QCHAR_W			8
#define QCHAR_H			8

class CQPic
{
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from the archive; never freed here
};

class CQWadLump
{
	U8	 name[20];
	U8	*data;
	I64	 size;
};

CQWadLump	q_wad_lumps[QWAD_MAX_LUMPS];
I64			q_wad_count		= 0;
U8			*q_conchars		= NULL;		//128x128 glyph atlas
Bool		 q_wad_ready	= FALSE;

U0 QWadInit()
{//Index gfx.wad. Globals are not zeroed by the JIT, so clear first.
	U8	*d;
	U8	*rec;
	I64	 size = 0;
	I64	 count;
	I64	 table;
	I64	 pos;
	I64	 dsize;
	I64	 i;

	for (i = 0; i < QWAD_MAX_LUMPS; i++)
	{
		q_wad_lumps[i].name[0] = 0;
		q_wad_lumps[i].data    = NULL;
		q_wad_lumps[i].size    = 0;
	}

	q_wad_count  = 0;
	q_conchars   = NULL;
	q_wad_ready  = FALSE;

	d = QPakData("gfx.wad", &size);
	if (!d || size < 12 || MemCompare(d, "WAD2", 4))
	{
		"QWad: gfx.wad missing or not WAD2\n";
		return;
	}

	count = QRdI32(d + 4);
	table = QRdI32(d + 8);

	if (count < 1 || table < 0 || table + count * 32 > size)
	{
		"QWad: gfx.wad directory is out of range\n";
		return;
	}

	for (i = 0; i < count && q_wad_count < QWAD_MAX_LUMPS; i++)
	{
		rec   = d + table + i * 32;
		pos   = QRdI32(rec);
		dsize = QRdI32(rec + 4);

		if (pos < 0 || pos + dsize > size)
			goto qw_next;

		QRdName(rec + 16, q_wad_lumps[q_wad_count].name, 17);
		q_wad_lumps[q_wad_count].data = d + pos;
		q_wad_lumps[q_wad_count].size = dsize;

		//CONCHARS is raw 128x128 glyph data with no width/height header.
		if (!StrICompare(q_wad_lumps[q_wad_count].name, "CONCHARS"))
			q_conchars = d + pos;

		q_wad_count++;

qw_next:
	}

	q_wad_ready = TRUE;
}

Bool QWadPic(U8 *name, CQPic *out)
{//Look up a WAD lump as a picture.
	I64 i;

	out->width  = 0;
	out->height = 0;
	out->pixels = NULL;

	for (i = 0; i < q_wad_count; i++)
	{
		if (!StrICompare(q_wad_lumps[i].name, name))
		{
			if (q_wad_lumps[i].size < 8)
				return FALSE;

			out->width  = QRdI32(q_wad_lumps[i].data);
			out->height = QRdI32(q_wad_lumps[i].data + 4);
			out->pixels = q_wad_lumps[i].data + 8;

			if (out->width < 1 || out->height < 1 ||
				out->width * out->height + 8 > q_wad_lumps[i].size)
			{
				out->pixels = NULL;
				return FALSE;
			}

			return TRUE;
		}
	}

	return FALSE;
}

Bool QPicLoad(U8 *path, CQPic *out)
{//Load a standalone gfx/*.lmp picture straight out of the PAK.
	U8	*d;
	I64	 size = 0;

	out->width  = 0;
	out->height = 0;
	out->pixels = NULL;

	d = QPakData(path, &size);
	if (!d || size < 8)
		return FALSE;

	out->width  = QRdI32(d);
	out->height = QRdI32(d + 4);
	out->pixels = d + 8;

	if (out->width < 1 || out->height < 1 ||
		out->width * out->height + 8 > size)
	{
		out->pixels = NULL;
		return FALSE;
	}

	return TRUE;
}

U0 QPicDrawFillPart(CQCanvas *c, CQPic *pic, I64 height)
{//Stretch a picture across the full canvas WIDTH but only `height` rows,
 //sampling the bottom of the source so its lower edge lines up with the bottom
 //of the drawn area. Used for the console background dropping down the screen.
	U8	*src;
	U8	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (height > c->height)
		height = c->height;
	if (height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / height;

	sy_fp = 0;
	for (py = 0; py < height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = src[sx_fp >> 16];
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 QPicDrawFill(CQCanvas *c, CQPic *pic)
{//Stretch a picture over the WHOLE canvas.
 //
 //The menu background is a 320x200 image and the render target can be any size.
 //Drawing it at its native size left the rest of the screen black, which is what
 //made the menu look wrong at anything above 320x240. The original stretches its
 //console background across the full height for the same reason.
 //
 //16.16 fixed point stepping, nearest sample - no filtering, to keep the look.
	U8	*src;
	U8	*dst;
	I64	 sx_fp;
	I64	 sy_fp;
	I64	 step_x;
	I64	 step_y;
	I64	 px;
	I64	 py;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	step_x = (pic->width  << 16) / c->width;
	step_y = (pic->height << 16) / c->height;

	sy_fp = 0;
	for (py = 0; py < c->height; py++)
	{
		src = pic->pixels + (sy_fp >> 16) * pic->width;
		dst = c->pixels + py * c->width;

		sx_fp = 0;
		for (px = 0; px < c->width; px++)
		{
			dst[px] = src[sx_fp >> 16];
			sx_fp  += step_x;
		}

		sy_fp += step_y;
	}
}

U0 QPicTile(CQCanvas *c, CQPic *pic, I64 x, I64 y, I64 w, I64 h)
{//Draw_TileClear: repeat a picture across a rectangle, aligned to the screen
 //rather than to the rectangle so adjacent calls line up seamlessly.
	U8	*row;
	U8	*src;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;

	if (!pic || !pic->pixels || pic->width < 1 || pic->height < 1)
		return;

	if (x < 0)			{ w += x; x = 0; }
	if (y < 0)			{ h += y; y = 0; }
	if (x + w > c->width)	w = c->width - x;
	if (y + h > c->height)	h = c->height - y;

	if (w < 1 || h < 1)
		return;

	for (py = y; py < y + h; py++)
	{
		row = c->pixels + py * c->width;
		sy  = py % pic->height;
		src = pic->pixels + sy * pic->width;

		for (px = x; px < x + w; px++)
		{
			sx = px % pic->width;
			row[px] = src[sx];
		}
	}
}

U0 QPicDraw(CQCanvas *c, CQPic *pic, I64 x, I64 y)
{//Blit an 8bpp picture, skipping transparent pixels. Interface art bypasses
 //the depth buffer entirely: it is always on top.
	U8	*src;
	U8	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qp_next_row;

		src = pic->pixels + sy * pic->width;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < pic->width; sx++)
		{
			px = x + sx;
			if (px < 0 || px >= c->width)
				goto qp_next_col;

			texel = src[sx];
			if (texel != QPIC_TRANSPARENT)
				dst[px] = texel;

qp_next_col:
		}

qp_next_row:
	}
}

U0 QPicDrawPart(CQCanvas *c, CQPic *pic, I64 x, I64 y, I64 sub_x, I64 sub_w)
{//Draw a horizontal slice of a picture. The status bar is assembled from
 //pieces of the 320-wide SBAR and IBAR strips, so the source stride stays the
 //full picture width while only a window of columns is copied.
	U8	*src;
	U8	*dst;
	I64	 px;
	I64	 py;
	I64	 sx;
	I64	 sy;
	U8	 texel;

	if (!pic || !pic->pixels || sub_w < 1)
		return;

	if (sub_x < 0)
		sub_x = 0;
	if (sub_x + sub_w > pic->width)
		sub_w = pic->width - sub_x;
	if (sub_w < 1)
		return;

	for (sy = 0; sy < pic->height; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qpp_next_row;

		src = pic->pixels + sy * pic->width + sub_x;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < sub_w; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel != QPIC_TRANSPARENT)
					dst[px] = texel;
			}
		}

qpp_next_row:
	}
}

U0 QCharDraw(CQCanvas *c, I64 x, I64 y, I64 ch)
{//One glyph from the 16x16 grid in CONCHARS. Index 0 is transparent there,
 //which is what lets text sit over the world without a box behind it.
	U8	*src;
	U8	*dst;
	I64	 row;
	I64	 col;
	I64	 sx;
	I64	 sy;
	I64	 py;
	I64	 px;
	U8	 texel;

	if (!q_conchars || ch <= 32)
		return;

	ch &= 255;
	row = (ch >> 4) * QCHAR_H;
	col = (ch & 15) * QCHAR_W;

	for (sy = 0; sy < QCHAR_H; sy++)
	{
		py = y + sy;
		if (py < 0 || py >= c->height)
			goto qc_next_row;

		src = q_conchars + (row + sy) * 128 + col;
		dst = c->pixels + py * c->width;

		for (sx = 0; sx < QCHAR_W; sx++)
		{
			px = x + sx;
			if (px >= 0 && px < c->width)
			{
				texel = src[sx];
				if (texel)
					dst[px] = texel;
			}
		}

qc_next_row:
	}
}

U0 QStrDraw(CQCanvas *c, I64 x, I64 y, U8 *s)
{
	I64 i = 0;

	while (s[i])
	{
		QCharDraw(c, x + i * QCHAR_W, y, s[i]);
		i++;
	}
}

U0 QStrDrawAlt(CQCanvas *c, I64 x, I64 y, U8 *s)
{//M_Print, which draws every character with 128 ADDED to it.
 //
 //CONCHARS holds two complete 128-glyph sets: the plain one used for console
 //text, and a gold one in the upper half. The menu uses the gold set, and
 //M_PrintWhite is the exception rather than the rule. Drawing menu labels
 //through QStrDraw put them in the console's grey, which is why the menu text
 //never matched the artwork sitting next to it.
	I64 i = 0;

	while (s[i])
	{
		QCharDraw(c, x + i * QCHAR_W, y, s[i] + 128);
		i++;
	}
}

U0 QStrDrawCenter(CQCanvas *c, I64 y, U8 *s)
{
	QStrDraw(c, (c->width - StrLen(s) * QCHAR_W) / 2, y, s);
}

U0 QStrDrawCenterAlt(CQCanvas *c, I64 y, U8 *s)
{
	QStrDrawAlt(c, (c->width - StrLen(s) * QCHAR_W) / 2, y, s);
}
