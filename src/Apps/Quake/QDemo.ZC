// QDemo.ZC - .dem playback.
//
// A demo file is a recorded SERVER-TO-CLIENT stream, nothing more: an ASCII CD
// track number terminated by a newline, then, repeated to the end of the file,
//
//     I32   message length
//     F32   viewangles[3]
//     U8    data[length]        one server message, byte for byte
//
// So playback is not a separate mode of the game - it is the ordinary client
// parser fed from a file instead of a socket, which is exactly how
// CL_ReadDemoMessage works. The map comes up because svc_serverinfo is in the
// stream like any other command.

#define QDEMO_MAX_NAME	64

U8	*q_demo_data	= NULL;		//whole file, owned here
I64	 q_demo_size	= 0;
I64	 q_demo_pos		= 0;
Bool q_demo_playing	= FALSE;
Bool q_demo_loop	= FALSE;	//startup attract loop, not a single playdemo
I64	 q_demo_track	= 0;
F64	 q_demo_angles[3];
U8	 q_demo_name[QDEMO_MAX_NAME];

//The attract cycle the original plays behind the menu.
U8 *q_demo_loop_names[3];
I64 q_demo_loop_index = 0;

U0 QDemoInit()
{//Globals are not zeroed, and q_demo_data is handed to Free.
	q_demo_data       = NULL;
	q_demo_size       = 0;
	q_demo_pos        = 0;
	q_demo_playing    = FALSE;
	q_demo_loop       = FALSE;
	q_demo_track      = 0;
	q_demo_name[0]    = 0;
	q_demo_loop_index = 0;

	QVecSet(q_demo_angles, 0.0, 0.0, 0.0);

	q_demo_loop_names[0] = "demo1.dem";
	q_demo_loop_names[1] = "demo2.dem";
	q_demo_loop_names[2] = "demo3.dem";
}

U0 QDemoStop()
{//CL_StopPlayback.
	if (q_demo_data)
		Free(q_demo_data);

	q_demo_data    = NULL;
	q_demo_size    = 0;
	q_demo_pos     = 0;
	q_demo_playing = FALSE;
}

Bool QDemoStart(U8 *name, Bool loop = FALSE)
{//CL_PlayDemo_f. The name may arrive with or without its extension.
	U8	 path[QDEMO_MAX_NAME + 16];
	I64	 size = 0;
	I64	 n;

	QDemoStop;

	if (!name || !name[0])
		return FALSE;

	QStrCopy(path, name, QDEMO_MAX_NAME);
	n = StrLen(path);
	if (n < 4 || StrICompare(path + n - 4, ".dem"))
		StrPrint(path, "%s.dem", name);

	q_demo_data = QPakLoad(path, &size);
	if (!q_demo_data || size < 2)
	{
		QDemoStop;
		return FALSE;
	}

	q_demo_size = size;
	q_demo_pos  = 0;

	//The CD track is an ASCII number on its own line. It is consumed whether
	//or not anything plays it, because the messages start after it.
	q_demo_track = 0;
	while (q_demo_pos < q_demo_size && q_demo_data[q_demo_pos] != '\n')
	{
		if ('0' <= q_demo_data[q_demo_pos] <= '9')
			q_demo_track = q_demo_track * 10 +
				(q_demo_data[q_demo_pos] - '0');
		q_demo_pos++;
	}
	q_demo_pos++;		//step over the newline itself

	QStrCopy(q_demo_name, path, QDEMO_MAX_NAME);
	q_demo_playing = TRUE;
	q_demo_loop    = loop;

	QVecSet(q_demo_angles, 0.0, 0.0, 0.0);

	return TRUE;
}

Bool QDemoNextInLoop()
{//Step the attract cycle. FALSE when none of them will load, so the caller
 //can give up rather than retrying every frame.
	I64 tries;

	for (tries = 0; tries < 3; tries++)
	{
		q_demo_loop_index++;
		if (q_demo_loop_index > 2)
			q_demo_loop_index = 0;

		if (QDemoStart(q_demo_loop_names[q_demo_loop_index], TRUE))
			return TRUE;
	}

	return FALSE;
}

Bool QDemoReadMessage(CQMsg *m)
{//CL_ReadDemoMessage's file half: pull the next message into `m`.
 //FALSE at the end of the file, or on anything malformed.
	I64 len;
	I64 j;

	if (!q_demo_playing || !q_demo_data)
		return FALSE;

	//Length plus three angles must be present before the payload.
	if (q_demo_pos + 16 > q_demo_size)
		return FALSE;

	len = QRdI32(q_demo_data + q_demo_pos);
	q_demo_pos += 4;

	for (j = 0; j < 3; j++)
	{
		q_demo_angles[j] = QRdF32(q_demo_data + q_demo_pos);
		q_demo_pos += 4;
	}

	if (len < 0 || len > QNET_MAX_MSG)
		return FALSE;
	if (q_demo_pos + len > q_demo_size)
		return FALSE;

	QMsgClear(m);
	MemCopy(m->data, q_demo_data + q_demo_pos, len);
	m->len = len;

	q_demo_pos += len;

	return TRUE;
}
