// QDemo.ZC - .dem playback.
//
// a demo is a recorded server-to-client stream. ASCII cd track + newline,
// then repeated to EOF:
//
//     I32   message length
//     F32   viewangles[3]
//     U8    data[length]        one server message, byte for byte
//
// not a separate game mode - the normal client parser fed from a file instead
// of a socket, same as CL_ReadDemoMessage. the map comes up because
// svc_serverinfo is in the stream like any other command.

#define QDEMO_MAX_NAME	64


U8	*q_demo_data	= NULL;		//whole file, owned here
I64	 q_demo_size	= 0;
I64	 q_demo_pos		= 0;
Bool q_demo_playing	= FALSE;
Bool q_demo_loop	= FALSE;	//startup attract loop, not a single playdemo
I64	 q_demo_track	= 0;
F64	 q_demo_angles[3];

//playback clock. cl.time vs cl.mtime[0] is what paces the demo at its
//recorded speed instead of the render rate.
F64	 q_demo_clock	= 0.0;
F64	 q_demo_last_t	= 0.0;
Bool q_demo_timed	= FALSE;	//clock seeded from the first post-signon message
U8	 q_demo_name[QDEMO_MAX_NAME];

//attract cycle played behind the menu
U8 *q_demo_loop_names[3];
I64 q_demo_loop_index = 0;

//during playback the demo IS the server - no local QuakeC, entities from the
//client tables, camera on the recorded view entity. same shape as being
//someone else's client, so one predicate covers both.
#define QClientMode	(q_demo_playing || (q_udp_ready && !q_udp_server))

U0 QDemoInit()
{//globals aren't zeroed, and q_demo_data gets Freed
	q_demo_data       = NULL;
	q_demo_size       = 0;
	q_demo_pos        = 0;
	q_demo_playing    = FALSE;
	q_demo_loop       = FALSE;
	q_demo_track      = 0;
	q_demo_name[0]    = 0;
	q_demo_loop_index = 0;
	q_demo_clock      = 0.0;
	q_demo_last_t     = 0.0;
	q_demo_timed      = FALSE;

	QVecSet(q_demo_angles, 0.0, 0.0, 0.0);

	q_demo_loop_names[0] = "demo1.dem";
	q_demo_loop_names[1] = "demo2.dem";
	q_demo_loop_names[2] = "demo3.dem";
}

U0 QDemoStop()
{//CL_StopPlayback
	if (q_demo_data)
		Free(q_demo_data);

	q_demo_data    = NULL;
	q_demo_size    = 0;
	q_demo_pos     = 0;
	q_demo_playing = FALSE;
}

Bool QDemoStart(U8 *name, Bool loop = FALSE)
{//CL_PlayDemo_f, name may or may not carry .dem
	U8	 path[QDEMO_MAX_NAME + 16];
	I64	 size = 0;
	I64	 n;

	QDemoStop;

	if (!name || !name[0])
		return FALSE;

	QStrCopy(path, name, QDEMO_MAX_NAME);
	n = StrLen(path);
	if (n < 4 || StrICompare(path + n - 4, ".dem"))
		StrPrint(path, "%s.dem", name);

	q_demo_data = QPakLoad(path, &size);
	if (!q_demo_data || size < 2)
	{
		QDemoStop;
		return FALSE;
	}

	q_demo_size = size;
	q_demo_pos  = 0;

	//cd track is ASCII on its own line, consume it either way -
	//the messages start after it
	q_demo_track = 0;
	while (q_demo_pos < q_demo_size && q_demo_data[q_demo_pos] != '\n')
	{
		if ('0' <= q_demo_data[q_demo_pos] <= '9')
			q_demo_track = q_demo_track * 10 +
				(q_demo_data[q_demo_pos] - '0');
		q_demo_pos++;
	}
	q_demo_pos++;		//newline

	QStrCopy(q_demo_name, path, QDEMO_MAX_NAME);
	q_demo_playing = TRUE;
	q_demo_loop    = loop;
	q_demo_clock   = 0.0;
	q_demo_last_t  = 0.0;
	q_demo_timed   = FALSE;

	QVecSet(q_demo_angles, 0.0, 0.0, 0.0);

	return TRUE;
}

Bool QDemoNextInLoop()
{//step the attract cycle, FALSE when none load so the caller can stop
 //retrying every frame
	I64 tries;

	//CL_NextDemo plays demos[cls.demonum] and THEN advances - advancing
	//first opens the cycle on demo2
	for (tries = 0; tries < 3; tries++)
	{
		if (q_demo_loop_index < 0 || q_demo_loop_index > 2)
			q_demo_loop_index = 0;

		if (QDemoStart(q_demo_loop_names[q_demo_loop_index], TRUE))
		{
			q_demo_loop_index++;
			return TRUE;
		}

		q_demo_loop_index++;
	}

	return FALSE;
}

Bool QDemoReadMessage(CQMsg *m)
{//CL_ReadDemoMessage file half, FALSE at eof or on anything malformed
	I64 len;
	I64 j;

	if (!q_demo_playing || !q_demo_data)
		return FALSE;

	//len + 3 angles must be there before the payload
	if (q_demo_pos + 16 > q_demo_size)
		return FALSE;

	len = QRdI32(q_demo_data + q_demo_pos);
	q_demo_pos += 4;

	for (j = 0; j < 3; j++)
	{
		q_demo_angles[j] = QRdF32(q_demo_data + q_demo_pos);
		q_demo_pos += 4;
	}

	if (len < 0 || len > QNET_MAX_MSG)
		return FALSE;
	if (q_demo_pos + len > q_demo_size)
		return FALSE;

	QMsgClear(m);
	MemCopy(m->data, q_demo_data + q_demo_pos, len);
	m->len = len;

	q_demo_pos += len;

	return TRUE;
}
