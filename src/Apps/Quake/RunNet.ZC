// RunNet.ZC - Quake WITH networking.
//
// Run this instead of Run.ZC to play over UDP. It loads ZealOS's net stack
// first, so that by the time QNetUdp.ZC is compiled the UDP layer exists and
// the real transport is built rather than the stubs.
//
// It is a separate entry point rather than a runtime choice because the
// binding is a COMPILE-TIME one. ZealC is a single-pass compiler: a call to
// UDPSocket has to resolve when QNetUdp.ZC is read, so the stack must already
// be loaded at that moment. Selecting Multiplayer from the menu is far too
// late - the code that would use it has long since been compiled.
//
// Loading it is not free either, which is why single player does not: the
// driver probe THROWS 'NODRIVER' when the machine has no supported NIC, and
// the tree brings in TCP, TLS, crypto and HTTP along the way.

Cd(__DIR__);;

#ifndef UDP_MAX_PORT
#include "::/Home/Net/Load"
Cd(__DIR__);;
#endif

#include "Run"
