// QSpr.ZC - IDSP sprite models.
//
// third model class after brush and alias. carries the effects with no
// geometry - explosion fireball (progs/s_explod.spr), bubbles, glows.
//
// 36-byte header then one record per frame:
//
//     "IDSP", version 1, type, boundingradius, maxwidth, maxheight,
//     numframes, beamlength, synctype
//
//     per frame: group flag; then origin[2], width, height and width*height
//     palette indices. a group carries a count and intervals first.
//
// palette index 255 is transparent - every sprite is a rect with most of it
// cut away, and that cutout is the shape.

#define QSPR_MAX_FRAMES	64
#define QSPR_TRANSPARENT	255

class CQSprFrame
{
	I64	 origin_x;		//texel offset from centre
	I64	 origin_y;
	I64	 width;
	I64	 height;
	U8	*pixels;		//borrowed from raw
};

class CQSpr
{
	U8			 name[64];
	U8			*raw;			//owned
	I64			 type;
	I64			 max_width;
	I64			 max_height;
	I64			 num_frames;
	F64			 interval;		//seconds per frame, grouped sprites
	CQSprFrame	 frames[QSPR_MAX_FRAMES];
};

CQSpr *QSprLoad(U8 *name)
{//load one sprite from the paks
	CQSpr	*sp;
	U8		*d;
	I64		 size = 0;
	I64		 p;
	I64		 i;
	I64		 group;
	I64		 sub;
	I64		 w;
	I64		 h;

	d = QPakLoad(name, &size);
	if (!d || size < 36)
	{
		if (d)
			Free(d);
		return NULL;
	}

	if (d[0] != 'I' || d[1] != 'D' || d[2] != 'S' || d[3] != 'P')
	{
		Free(d);
		return NULL;
	}

	sp = CAlloc(sizeof(CQSpr));
	sp->raw = d;
	QStrCopy(sp->name, name, 64);

	sp->type       = QRdI32(d + 8);
	sp->max_width  = QRdI32(d + 16);
	sp->max_height = QRdI32(d + 20);
	sp->num_frames = QRdI32(d + 24);
	sp->interval   = 0.1;

	if (sp->num_frames < 1 || sp->num_frames > QSPR_MAX_FRAMES)
	{
		Free(d);
		Free(sp);
		return NULL;
	}

	p = 36;

	for (i = 0; i < sp->num_frames; i++)
	{
		if (p + 4 > size)
			break;

		group = QRdI32(d + p);
		p += 4;

		//groups carry their own count and interval table. only subframe 0 is
		//kept - s_explod.spr is a plain sequence driven by QuakeC .frame.
		if (group)
		{
			if (p + 4 > size)
				break;

			sub = QRdI32(d + p);
			p += 4;

			if (sub > 0 && p + 4 <= size)
				sp->interval = QRdF32(d + p);

			if (sp->interval <= 0.0)
				sp->interval = 0.1;

			p += sub * 4;
		}

		if (p + 16 > size)
			break;

		sp->frames[i].origin_x = QRdI32(d + p);
		sp->frames[i].origin_y = QRdI32(d + p + 4);
		w = QRdI32(d + p + 8);
		h = QRdI32(d + p + 12);
		p += 16;

		if (w < 1 || h < 1 || p + w * h > size)
			break;

		sp->frames[i].width  = w;
		sp->frames[i].height = h;
		sp->frames[i].pixels = d + p;

		p += w * h;
	}

	return sp;
}

U0 QSprFree(CQSpr *sp)
{
	if (!sp)
		return;

	if (sp->raw)
		Free(sp->raw);

	Free(sp);
}

U0 QSprDraw(CQCanvas *c, CQSpr *sp, I64 frame, F64 *origin, I64 light)
{//R_DrawSpriteModel - camera-facing quad built from the VIEW axes, not the
 //sprite's own. always flat-on, so texels step in screen space and one 1/z
 //serves the whole quad.
	CQSprFrame	*fr;
	U8			*row;
	F64			*zrow;
	F64			 rel[3];
	F64			 cam_x;
	F64			 cam_y;
	F64			 cam_z;
	F64			 inv_z;
	F64			 sx;
	F64			 sy;
	F64			 half_w;
	F64			 half_h;
	I64			 x0, x1, y0, y1;
	I64			 x, y;
	I64			 tx, ty;
	I64			 texel;
	I64			 shade;

	if (!sp || frame < 0 || frame >= sp->num_frames)
		return;

	fr = &sp->frames[frame];
	if (!fr->pixels || fr->width < 1 || fr->height < 1)
		return;

	//to camera space, same as the world transform
	QVecSub(origin, c->origin, rel);
	cam_x = QVecDot(rel, c->right);
	cam_y = QVecDot(rel, c->up);
	cam_z = QVecDot(rel, c->forward);

	if (cam_z < 1.0)
		return;

	inv_z = 1.0 / cam_z;

	sx = c->center_x + cam_x * c->x_scale * inv_z;
	sy = c->center_y - cam_y * c->y_scale * inv_z;

	//frame origin is a texel offset from centre
	half_w = ToF64(fr->width) * 0.5 * c->x_scale * inv_z;
	half_h = ToF64(fr->height) * 0.5 * c->y_scale * inv_z;

	sx += ToF64(fr->origin_x + fr->width / 2) * c->x_scale * inv_z;
	sy -= ToF64(fr->origin_y - fr->height / 2) * c->y_scale * inv_z;

	x0 = ToI64(Ceil(sx - half_w));
	x1 = ToI64(Ceil(sx + half_w));
	y0 = ToI64(Ceil(sy - half_h));
	y1 = ToI64(Ceil(sy + half_h));

	if (x0 < c->vx)					x0 = c->vx;
	if (y0 < c->vy)					y0 = c->vy;
	if (x1 > c->vx + c->vw)			x1 = c->vx + c->vw;
	if (y1 > c->vy + c->vh)			y1 = c->vy + c->vh;

	if (x1 <= x0 || y1 <= y0)
		return;

	shade = ClampI64((255 - light) >> 2, 0, QPAL_SHADES - 1);

	for (y = y0; y < y1; y++)
	{
		row  = c->pixels + y * c->width;
		zrow = c->depth + y * c->width;

		ty = ToI64((ToF64(y) - (sy - half_h)) / (half_h * 2.0) *
				ToF64(fr->height));
		ty = ClampI64(ty, 0, fr->height - 1);

		for (x = x0; x < x1; x++)
		{
			if (inv_z <= zrow[x])
				goto qsd_next;

			tx = ToI64((ToF64(x) - (sx - half_w)) / (half_w * 2.0) *
					ToF64(fr->width));
			tx = ClampI64(tx, 0, fr->width - 1);

			texel = fr->pixels[ty * fr->width + tx];

			//255 is the cutout
			if (texel == QSPR_TRANSPARENT)
				goto qsd_next;

			if (texel >= QPAL_FULLBRIGHT)
				row[x] = texel;
			else
				row[x] = qpal_colormap[shade * QPAL_COLORS + texel];

			zrow[x] = inv_z;

qsd_next:
		}
	}
}
