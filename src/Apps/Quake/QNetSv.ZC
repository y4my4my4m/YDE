// QNetSv.ZC - the server's outgoing datagram and the client's parse of it.
//
// This is the actual client/server split. Everything up to now read the QuakeC
// world directly to draw it; here the server SERIALISES that world into a
// message and the client reconstructs it from the bytes alone. The loopback
// link carries it, so single player runs the same path a network game would -
// which is the point. A bug that only shows up over a wire shows up here too.
//
// Split out from QNet.ZC because these functions need the q_fld_* field
// bindings, and QNet.ZC is compiled before QProgs.ZC. QNet.ZC holds the pure
// wire codecs, which depend on nothing.
//
// Ported from SV_SendClientDatagram, SV_WriteClientdataToMessage,
// SV_WriteEntitiesToClient, SV_CreateBaseline and CL_ParseServerMessage.

//Bits in svc_clientdata. SU_ITEMS is always set in practice, but the bit is
//still sent because the client reads the mask before the fields.
#define QSU_VIEWHEIGHT		1
#define QSU_IDEALPITCH		2
#define QSU_PUNCH1			4
#define QSU_PUNCH2			8
#define QSU_PUNCH3			16
#define QSU_VELOCITY1		32
#define QSU_VELOCITY2		64
#define QSU_VELOCITY3		128
#define QSU_ITEMS			512
#define QSU_ONGROUND		1024
#define QSU_INWATER			2048
#define QSU_WEAPONFRAME		4096
#define QSU_ARMOR			8192
#define QSU_WEAPON			16384

#define QDEFAULT_VIEWHEIGHT	22.0

//What the client knows about ITSELF. The entity tables carry everything else,
//but the player's own state arrives through svc_clientdata instead, because the
//client needs it at full precision for the view and the status bar.
class CQClientState
{
	F64	 view_height;
	F64	 punchangle[3];
	F64	 velocity[3];
	I64	 items;
	Bool on_ground;
	Bool in_water;
	I64	 weaponframe;
	I64	 armorvalue;
	I64	 weaponmodel;
	I64	 health;
	I64	 currentammo;
	I64	 ammo_shells;
	I64	 ammo_nails;
	I64	 ammo_rockets;
	I64	 ammo_cells;
	I64	 weapon;

	//Set by svc_setangle and svc_time respectively.
	F64	 view_angles[3];
	Bool angles_forced;
	F64	 time;

	I64	 stats_received;
};

CQClientState	q_cl;
CQMsg			q_net_datagram;		//the server's outgoing message
CQMsg			q_net_recv;			//the client's receive buffer
CQMsg			q_net_recv_c2s;		//the server's receive buffer
U8				q_net_cmd_line[128];

//Set by the client when the server has told it which level to load. The app
//shell acts on it, since it owns map loading.
Bool	q_net_join_pending = FALSE;
U8		q_net_join_map[64];
CQMsg			q_net_udp_in;		//datagram staging before it joins the queue

//Upstream counters and the last move the server read. Declared here rather than
//beside the move code because QNetClientClear below resets them.
//Who the client believes it is. Arrives over the wire like everything else.
U8		q_cl_name[24];
I64		q_cl_cdtrack	= 0;	//track the server asked for, 0 = none
I64		q_cl_top	= 0;
I64		q_cl_bottom	= 0;
I64		q_cl_viewent	= 0;	//edict to hide in first person (svc_setview)

I64		q_net_moves_sent = 0;
I64		q_net_moves_read = 0;
F64		q_net_move_angles[3];
F64		q_net_move_cmd[3];		//forward, side, up
Bool	q_net_move_attack	= FALSE;
Bool	q_net_move_jump		= FALSE;
I64		q_net_move_impulse	= 0;
F64		q_net_move_ping		= 0.0;

//svc_damage arrives on the client but the screen blend that shows it lives in
//the app shell, which is compiled later. Parked here and picked up there.
Bool	q_net_damage_pending = FALSE;
I64		q_net_damage_save	 = 0;
I64		q_net_damage_take	 = 0;
F64		q_net_damage_from[3];
I64				q_net_dropped = 0;	//datagrams the link refused
I64				q_net_parsed  = 0;	//messages the client consumed

//Server client slots must be declared BEFORE QNetServerFrame, which gates UDP
//entity floods on seen_move. HolyC has no forward refs for these.
#define QSV_MAX_CLIENTS		4
#define QSV_TIMEOUT			10.0	//silence AFTER first clc_move
#define QSV_CONNECT_GRACE	90.0	//map load: connect done, moves not yet

class CQSvClient
{
	I64		edict;
	U32		ip;			//0 for the local client
	Bool	active;
	Bool	local;
	Bool	seen_move;	//FALSE until first clc_move - do not use move-timeout yet

	//Setup-page shirt/trousers (0-13). Packed into .colormap for the wire.
	I64		top;
	I64		bottom;
	U8		name[32];	//Host_Say / scoreboard; set at connect/spawn

	//The last move read for this client, held until its tick runs.
	F64		angles[3];
	F64		cmd[3];		//forward, side, up
	Bool	attack;
	Bool	jump;
	I64		impulse;
	F64		last_msg;

	//The engine's own copy of where this client is, the same pair the local
	//player keeps in the app shell.
	F64		origin[3];
	F64		velocity[3];
	Bool	on_ground;
};

CQSvClient	q_sv_clients[QSV_MAX_CLIENTS];
I64			q_sv_client_count = 0;

U0 QNetClientClear()
{//Globals are not zeroed, so every field is set explicitly.
	I64 i;

	q_cl.view_height = QDEFAULT_VIEWHEIGHT;

	for (i = 0; i < 3; i++)
	{
		q_cl.punchangle[i]  = 0.0;
		q_cl.velocity[i]    = 0.0;
		q_cl.view_angles[i] = 0.0;
	}

	q_cl.items          = 0;
	q_cl.on_ground      = FALSE;
	q_cl.in_water       = FALSE;
	q_cl.weaponframe    = 0;
	q_cl.armorvalue     = 0;
	q_cl.weaponmodel    = 0;
	q_cl.health         = 0;
	q_cl.currentammo    = 0;
	q_cl.ammo_shells    = 0;
	q_cl.ammo_nails     = 0;
	q_cl.ammo_rockets   = 0;
	q_cl.ammo_cells     = 0;
	q_cl.weapon         = 0;
	q_cl.angles_forced  = FALSE;
	q_cl.time           = 0.0;
	q_cl.stats_received = 0;

	q_cl_name[0] = 0;
	q_cl_top     = 0;
	q_cl_bottom  = 0;
	q_cl_cdtrack = 0;
	//Keep q_cl_viewent: join path parses SETVIEW before QLoadMap, and
	//QLoadMap calls this clear. Wiping it made the guest draw its own body.

	q_net_dropped = 0;
	q_net_parsed  = 0;

	q_net_damage_pending = FALSE;
	q_net_damage_save    = 0;
	q_net_damage_take    = 0;
	QVecSet(q_net_damage_from, 0.0, 0.0, 0.0);

	q_net_moves_sent = 0;
	q_net_moves_read = 0;
	q_net_move_ping  = 0.0;
	QVecSet(q_net_move_angles, 0.0, 0.0, 0.0);
	QVecSet(q_net_move_cmd, 0.0, 0.0, 0.0);
	q_net_move_attack  = FALSE;
	q_net_move_jump    = FALSE;
	q_net_move_impulse = 0;
}

//--- capturing an entity's visible state -----------------------------------

U0 QNetCaptureState(I64 ent, CQEntState *st)
{//Everything svc_update can carry, and nothing else. The fields NOT here -
 //health, velocity, think times - are server-side truth the client never sees,
 //which is precisely why this is a serialisation boundary rather than a copy.
	I64 j;

	for (j = 0; j < 3; j++)
	{
		st->origin[j] = QPrFieldF(ent, q_fld_origin + j);
		st->angles[j] = QPrFieldF(ent, q_fld_angles + j);
	}

	st->modelindex = ToI64(QPrFieldF(ent, q_fld_modelindex));
	st->frame      = ToI64(QPrFieldF(ent, q_fld_frame));
	st->colormap   = ToI64(QPrFieldF(ent, q_fld_colormap));
	st->skin       = ToI64(QPrFieldF(ent, q_fld_skin));
	st->effects    = ToI64(QPrFieldF(ent, q_fld_effects));
	st->step       = ToBool(ToI64(QPrFieldF(ent, q_fld_movetype)) ==
						QMOVETYPE_STEP);
	st->active     = TRUE;
}

Bool QNetEntityVisible(I64 ent)
{//An entity with no model index, or whose .model string is empty, is invisible
 //and is never sent - SV_WriteEntitiesToClient rejects on exactly those two.
 //The second test is not redundant: removing a model sets the string without
 //clearing the index.
	U8 *name;
	I64 idx;

	idx = ToI64(QPrFieldF(ent, q_fld_modelindex));
	if (idx == 0)
		return FALSE;

	name = QPrStr(QPrFieldI(ent, q_fld_model));
	if (!name || !name[0])
	{
		//Remote clients sometimes keep a valid index after PutClientInServer
		//while .model is still 0 - that alone used to drop them from every
		//datagram, so the host's loopback never described the guest.
		if (ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_CLIENT)
			return TRUE;
		return FALSE;
	}

	return TRUE;
}

//--- baselines -------------------------------------------------------------

U0 QNetWriteBaselines(CQMsg *m)
{//SV_CreateBaseline: one svc_spawnbaseline per entity that exists at map load,
 //recorded on BOTH sides. The server keeps it to delta against; the client
 //keeps it as the starting state for any entity it later hears about.
	CQEntState	*b;
	I64			 i;

	for (i = 1; i < q_pr_num_edicts && i < QNET_MAX_ENTS; i++)
	{
		if (q_pr_edict_free[i] || !QNetEntityVisible(i))
			goto qnb_next;

		b = &q_net_baseline[i];
		QNetCaptureState(i, b);

		//The client's own baseline table is filled directly rather than by
		//parsing what was just written. Over a real socket the parse is the
		//only path; on loopback both ends share this address space, and the
		//round trip is exercised by QTest instead of on every map load.
		MemCopy(&q_net_cl[i], b, sizeof(CQEntState));
		q_net_cl[i].active = FALSE;

		QMsgWriteByte(m, QSVC_SPAWNBASELINE);
		QMsgWriteShort(m, i);
		QMsgWriteByte(m, b->modelindex);
		QMsgWriteByte(m, b->frame);
		QMsgWriteByte(m, b->colormap);
		QMsgWriteByte(m, b->skin);
		QMsgWriteCoord(m, b->origin[0]);
		QMsgWriteAngle(m, b->angles[0]);
		QMsgWriteCoord(m, b->origin[1]);
		QMsgWriteAngle(m, b->angles[1]);
		QMsgWriteCoord(m, b->origin[2]);
		QMsgWriteAngle(m, b->angles[2]);

		if (i >= q_net_num_ents)
			q_net_num_ents = i + 1;

qnb_next:
	}

	//The original splits the signon across several buffers for exactly this
	//reason. One buffer is enough for the id maps - e1m1's baselines come to a
	//few thousand bytes - but the limit is real and a silent truncation here
	//would leave entities with no baseline to delta against.
	if (m->overflowed)
	{
		QLog("net: BASELINES OVERFLOWED - signon truncated\n");
		QLogFlush;
	}
}

U0 QNetWriteIdentity(CQMsg *m, I64 ent, U8 *name, I64 top, I64 bottom)
{//svc_updatename and svc_updatecolors, the pair that carries who a player is.
 //
 //Both are signon messages in the original, sent once per client. The colours
 //pack into one byte - shirt in the high nibble, trousers in the low - which is
 //the same layout the colormap generator expects, and is why there are fourteen
 //of each and not sixteen.
	if (ent <= 0)
		return;

	//.netname is deliberately NOT written. QuakeC string values are byte offsets
	//into the immutable string blob loaded from progs.dat, and there is no
	//scratch-string allocator to place a runtime name in it - the same gap that
	//leaves ftos stubbed. Nothing reads .netname yet either: it exists for
	//obituaries, which need a working ftos to print anyway. The name still goes
	//on the wire, where it is the client's own copy that matters.

	QMsgWriteByte(m, QSVC_UPDATENAME);
	QMsgWriteByte(m, 0);			//client number; there is one
	QMsgWriteString(m, name);

	QMsgWriteByte(m, QSVC_UPDATECOLORS);
	QMsgWriteByte(m, 0);
	QMsgWriteByte(m, ((top & 15) << 4) | (bottom & 15));
}

U0 QNetWriteCDTrack(CQMsg *m)
{//SV_SpawnServer writes svc_cdtrack from WORLDSPAWN's .sounds field - that is
 //how a map says which CD track belongs to it, and the byte is sent twice
 //because the protocol carries a track for the game and one for a looping
 //ambient source that nothing ever used.
	I64 track = 0;

	if (q_fld_sounds >= 0)
		track = ToI64(QPrFieldF(0, q_fld_sounds));

	QMsgWriteByte(m, QSVC_CDTRACK);
	QMsgWriteByte(m, track);
	QMsgWriteByte(m, track);
}

//--- the client's own state ------------------------------------------------

U0 QNetWriteClientdata(CQMsg *m, I64 ent)
{//SV_WriteClientdataToMessage.
	F64	 inflictor_org[3];
	I64	 inflictor;
	I64	 bits = 0;
	I64	 items;
	I64	 dmg_take;
	I64	 dmg_save;
	I64	 j;

	//Damage first, and it CONSUMES the fields: dmg_take and dmg_save are a
	//one-frame signal from QuakeC, and leaving them set replays the same hit
	//every frame - which is what pinned the red flash on permanently.
	dmg_take = ToI64(QPrFieldF(ent, q_fld_dmg_take));
	dmg_save = ToI64(QPrFieldF(ent, q_fld_dmg_save));

	if (dmg_take || dmg_save)
	{
		inflictor = QPrEdictNum(QPrFieldI(ent, q_fld_dmg_inflictor));

		//The blow is reported as coming from the CENTRE of the inflictor's box,
		//not its origin - for a brush model the origin is usually nowhere near
		//the thing that hit you.
		for (j = 0; j < 3; j++)
			inflictor_org[j] = QPrFieldF(inflictor, q_fld_origin + j) +
				0.5 * (QPrFieldF(inflictor, q_fld_mins + j) +
					   QPrFieldF(inflictor, q_fld_maxs + j));

		QMsgWriteByte(m, QSVC_DAMAGE);
		QMsgWriteByte(m, dmg_save);
		QMsgWriteByte(m, dmg_take);
		for (j = 0; j < 3; j++)
			QMsgWriteCoord(m, inflictor_org[j]);

		QPrSetFieldF(ent, q_fld_dmg_take, 0.0);
		QPrSetFieldF(ent, q_fld_dmg_save, 0.0);
	}

	//.fixangle is also consumed. QuakeC sets it when it teleports or respawns
	//the player, and it means "stop using the client's aim for one frame".
	if (q_fld_fixangle >= 0 && QPrFieldF(ent, q_fld_fixangle) != 0.0)
	{
		QMsgWriteByte(m, QSVC_SETANGLE);
		for (j = 0; j < 3; j++)
			QMsgWriteAngle(m, QPrFieldF(ent, q_fld_angles + j));

		QPrSetFieldF(ent, q_fld_fixangle, 0.0);
	}

	if (QPrFieldF(ent, q_fld_view_ofs + 2) != QDEFAULT_VIEWHEIGHT)
		bits |= QSU_VIEWHEIGHT;

	//SU_IDEALPITCH is never set: it needs SV_SetIdealPitch, which exists only to
	//drive the original's look-spring on slopes. Nothing else reads it.

	//The sigils ride in the HIGH bits of items so the status bar can draw them
	//without a second field. Without this the four runes never appear.
	items = ToI64(QPrFieldF(ent, q_fld_items));
	if (q_ofs_serverflags >= 0)
		items |= ToI64(QPrGetF(q_ofs_serverflags)) << 28;

	bits |= QSU_ITEMS;

	if (ToI64(QPrFieldF(ent, q_fld_flags)) & QFL_ONGROUND_)
		bits |= QSU_ONGROUND;

	if (QPrFieldF(ent, q_fld_waterlevel) >= 2.0)
		bits |= QSU_INWATER;

	for (j = 0; j < 3; j++)
	{
		if (QPrFieldF(ent, q_fld_punchangle + j) != 0.0)
			bits |= QSU_PUNCH1 << j;
		if (QPrFieldF(ent, q_fld_velocity + j) != 0.0)
			bits |= QSU_VELOCITY1 << j;
	}

	if (QPrFieldF(ent, q_fld_weaponframe) != 0.0)	bits |= QSU_WEAPONFRAME;
	if (QPrFieldF(ent, q_fld_armorvalue) != 0.0)	bits |= QSU_ARMOR;
	if (QPrFieldF(ent, q_fld_weapon) != 0.0)		bits |= QSU_WEAPON;

	QMsgWriteByte(m, QSVC_CLIENTDATA);
	QMsgWriteShort(m, bits);

	if (bits & QSU_VIEWHEIGHT)
		QMsgWriteChar(m, ToI64(QPrFieldF(ent, q_fld_view_ofs + 2)));

	for (j = 0; j < 3; j++)
	{
		if (bits & (QSU_PUNCH1 << j))
			QMsgWriteChar(m, ToI64(QPrFieldF(ent, q_fld_punchangle + j)));

		//Velocity is sent in SIXTEENTHS, which is why other players' movement
		//looks slightly steppy in the original.
		if (bits & (QSU_VELOCITY1 << j))
			QMsgWriteChar(m, ToI64(QPrFieldF(ent, q_fld_velocity + j) / 16.0));
	}

	QMsgWriteLong(m, items);

	if (bits & QSU_WEAPONFRAME)
		QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_weaponframe)));
	if (bits & QSU_ARMOR)
		QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_armorvalue)));
	if (bits & QSU_WEAPON)
		QMsgWriteByte(m,
			QBiPrecacheModel(QPrStr(QPrFieldI(ent, q_fld_weaponmodel))));

	//Health is a SHORT: it goes negative on death and the status bar shows it.
	QMsgWriteShort(m, ToI64(QPrFieldF(ent, q_fld_health)));
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_currentammo)));
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_ammo_shells)));
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_ammo_nails)));
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_ammo_rockets)));
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_ammo_cells)));

	//standard_quake: the weapon is a bit FIELD in the mission packs and a plain
	//number in Quake itself. This is Quake.
	QMsgWriteByte(m, ToI64(QPrFieldF(ent, q_fld_weapon)));
}

//--- the entity sweep ------------------------------------------------------

Bool QNetWriteOneEntity(CQMsg *m, I64 i, I64 client_ent, CQVisState *vis)
{//TRUE if written (or skipped as not visible). FALSE if the datagram is full.
	CQEntState	 now;
	F64			 eorg[3];
	I64			 leaf;
	I64			 j;
	I64			 flags;

	if (q_pr_edict_free[i])
		return TRUE;

	if (i != client_ent)
	{
		if (!QNetEntityVisible(i))
			return TRUE;

		//Never PVS-cull clients. A player just outside the leaf set used to
		//vanish from the listen-server's own loopback datagram AND from any
		//peer whose eyes were in a different cluster - the guest saw the host
		//(no PVS on the remote datagram) but the host never saw the guest.
		flags = ToI64(QPrFieldF(i, q_fld_flags));
		if (!(flags & QFL_CLIENT) && vis && vis->pvs)
		{
			for (j = 0; j < 3; j++)
				eorg[j] = QPrFieldF(i, q_fld_origin + j);

			leaf = QVisLeafForPoint(vis->map, eorg);

			if (leaf > 0)
			{
				leaf--;
				if (!(vis->pvs[leaf >> 3] & (1 << (leaf & 7))))
					return TRUE;
			}
		}
	}

	//Cap to one Ethernet frame - see QNET_MAX_DATAGRAM.
	if (QNET_MAX_DATAGRAM - m->len < 16)
		return FALSE;

	QNetCaptureState(i, &now);
	QNetWriteEntityUpdate(m, i, &now, &q_net_baseline[i]);

	MemCopy(&q_net_sent[i], &now, sizeof(CQEntState));

	if (i >= q_net_num_ents)
		q_net_num_ents = i + 1;

	return TRUE;
}

U0 QNetWriteEntities(CQMsg *m, I64 client_ent, CQVisState *vis)
{//SV_WriteEntitiesToClient.
 //
 //Players first so a full datagram still carries every body. Fat world updates
 //used to fill the buffer before the remote client's high edict number, so
 //neither end ever saw the other player on the wire.
	I64 i;
	I64 flags;

	//Pass 1: every live client body (and the view client).
	for (i = 1; i < q_pr_num_edicts && i < QNET_MAX_ENTS; i++)
	{
		if (q_pr_edict_free[i])
			goto qne_p1;

		flags = ToI64(QPrFieldF(i, q_fld_flags));
		if (i != client_ent && !(flags & QFL_CLIENT))
			goto qne_p1;

		if (!QNetWriteOneEntity(m, i, client_ent, vis))
		{
			QLog("net: packet overflow, entities dropped\n");
			return;
		}

qne_p1:
	}

	//Pass 2: everything else.
	for (i = 1; i < q_pr_num_edicts && i < QNET_MAX_ENTS; i++)
	{
		if (q_pr_edict_free[i])
			goto qne_p2;

		flags = ToI64(QPrFieldF(i, q_fld_flags));
		if (i == client_ent || (flags & QFL_CLIENT))
			goto qne_p2;

		if (!QNetWriteOneEntity(m, i, client_ent, vis))
		{
			QLog("net: packet overflow, entities dropped\n");
			return;
		}

qne_p2:
	}
}

Bool QNetBuildClientDatagram(I64 client_ent, CQVisState *vis, F64 time)
{//Fill q_net_datagram for ONE client's eyes. Caller sends it.
	QMsgClear(&q_net_datagram);

	//svc_time comes FIRST and is what advances the client's clock. Everything
	//after it is understood to describe that moment.
	QMsgWriteByte(&q_net_datagram, QSVC_TIME);
	QMsgWriteFloat(&q_net_datagram, time);

	QNetWriteClientdata(&q_net_datagram, client_ent);
	QNetWriteEntities(&q_net_datagram, client_ent, vis);

	//An overflowed datagram is DISCARDED whole, not truncated. The original
	//does the same: a partial message would resynchronise the reader mid-field
	//and every byte after it would be misread.
	if (q_net_datagram.overflowed)
	{
		q_net_dropped++;
		return FALSE;
	}

	return TRUE;
}

Bool QNetServerFrame(I64 client_ent, F64 time)
{//SV_SendClientMessages: one datagram PER client. Building a single packet for
 //the local player and copying it to UDP was the invisibility bug - the host
 //body is skipped as client_ent, so the guest never received it.
 //
 //PVS arg dropped: MP builds every datagram with NULL vis so remotes are never
 //culled from the host eye (see QNetBuildClientDatagram calls below).
	I64		i;
	I64		ent;
	Bool	ok;

	ok = TRUE;

	//Local (or solo) client - loopback. No PVS: a listen host must see every
	//remote body in its own client tables, and PVS was dropping the guest from
	//the only datagram the host ever parses.
	if (!QNetBuildClientDatagram(client_ent, NULL, time))
		ok = FALSE;
	else if (!QNetSendToClient(&q_net_datagram))
	{
		q_net_dropped++;
		ok = FALSE;
	}

	//Each remote gets a datagram built for THEIR edict so they receive the host
	//body and their own clientdata. No PVS for remotes yet.
	if (q_udp_ready && q_udp_server)
	{
		for (i = 0; i < QSV_MAX_CLIENTS; i++)
		{
			if (!q_sv_clients[i].active || q_sv_clients[i].local)
				goto qsf_next;

			ent = q_sv_clients[i].edict;
			if (ent <= 0)
				goto qsf_next;

			//Do not blast until the peer has finished loading and sent a move.
			//Flooding their UDP queue during QChangeLevel was the hard freeze.
			if (!q_sv_clients[i].seen_move)
				goto qsf_next;

			if (!QNetBuildClientDatagram(ent, NULL, time))
			{
				ok = FALSE;
				goto qsf_next;
			}

			if (!QNetUdpSendTo(&q_net_datagram, q_sv_clients[i].ip))
				ok = FALSE;

qsf_next:
		}
	}

	return ok;
}

U0 QNetPrintStrip(U8 *dst, U8 *src, I64 max)
{//Con_Printf colour prefixes (1/2) are not glyphs - drop leading set byte.
	I64 i;
	I64 j;

	if (!dst || max < 2)
		return;

	dst[0] = 0;
	if (!src)
		return;

	i = 0;
	if (src[0] == 1 || src[0] == 2)
		i = 1;

	j = 0;
	while (src[i] && j < max - 1)
	{
		dst[j] = src[i];
		j++;
		i++;
	}
	dst[j] = 0;
}

//--- the client's parse ----------------------------------------------------

U0 QNetParseClientdata(CQMsg *m)
{//CL_ParseClientdata, reading the fields back in exactly the order written.
	I64 bits = QMsgReadShort(m) & 0xFFFF;
	I64 j;

	if (bits & QSU_VIEWHEIGHT)
		q_cl.view_height = ToF64(QMsgReadChar(m));
	else
		q_cl.view_height = QDEFAULT_VIEWHEIGHT;

	if (bits & QSU_IDEALPITCH)
		QMsgReadChar(m);		//parsed and discarded; nothing here reads it

	//A field absent from the mask is ZERO, not "unchanged". svc_clientdata is a
	//full snapshot of the player every frame, unlike the entity deltas.
	for (j = 0; j < 3; j++)
	{
		if (bits & (QSU_PUNCH1 << j))
			q_cl.punchangle[j] = ToF64(QMsgReadChar(m));
		else
			q_cl.punchangle[j] = 0.0;

		if (bits & (QSU_VELOCITY1 << j))
			q_cl.velocity[j] = ToF64(QMsgReadChar(m)) * 16.0;
		else
			q_cl.velocity[j] = 0.0;
	}

	q_cl.items     = QMsgReadLong(m);
	q_cl.on_ground = ToBool((bits & QSU_ONGROUND) != 0);
	q_cl.in_water  = ToBool((bits & QSU_INWATER) != 0);

	if (bits & QSU_WEAPONFRAME)
		q_cl.weaponframe = QMsgReadByte(m);
	else
		q_cl.weaponframe = 0;

	if (bits & QSU_ARMOR)
		q_cl.armorvalue = QMsgReadByte(m);
	else
		q_cl.armorvalue = 0;

	if (bits & QSU_WEAPON)
		q_cl.weaponmodel = QMsgReadByte(m);
	else
		q_cl.weaponmodel = 0;

	q_cl.health       = QMsgReadShort(m);
	q_cl.currentammo  = QMsgReadByte(m);
	q_cl.ammo_shells  = QMsgReadByte(m);
	q_cl.ammo_nails   = QMsgReadByte(m);
	q_cl.ammo_rockets = QMsgReadByte(m);
	q_cl.ammo_cells   = QMsgReadByte(m);
	q_cl.weapon       = QMsgReadByte(m);
}

U0 QNetParseBaseline(CQMsg *m)
{
	CQEntState	*b;
	I64			 num = QMsgReadShort(m);

	if (num < 1 || num >= QNET_MAX_ENTS)
		return;

	b = &q_net_baseline[num];

	b->modelindex = QMsgReadByte(m);
	b->frame      = QMsgReadByte(m);
	b->colormap   = QMsgReadByte(m);
	b->skin       = QMsgReadByte(m);
	b->origin[0]  = QMsgReadCoord(m);
	b->angles[0]  = QMsgReadAngle(m);
	b->origin[1]  = QMsgReadCoord(m);
	b->angles[1]  = QMsgReadAngle(m);
	b->origin[2]  = QMsgReadCoord(m);
	b->angles[2]  = QMsgReadAngle(m);
	b->effects    = 0;
	b->step       = FALSE;
	b->active     = FALSE;

	if (num >= q_net_num_ents)
		q_net_num_ents = num + 1;
}

Bool QNetClientParse(CQMsg *m)
{//CL_ParseServerMessage: read commands until the message runs out.
 //
 //The loop is bounded by the message length rather than by a terminator, and an
 //unrecognised opcode ABORTS rather than skipping. There is no way to know how
 //many bytes an unknown command occupies, so continuing would misread
 //everything after it - the original calls Host_Error here for the same reason.
	U8	line[128];
	U8	shown[128];
	I64	cmd;
	I64	i;

	m->read   = 0;
	m->badread = FALSE;

	while (TRUE)
	{
		if (m->read >= m->len)
			return TRUE;

		cmd = QMsgReadByte(m);
		if (m->badread)
			return FALSE;

		//THE HIGH BIT IS AN ENTITY UPDATE, not an opcode. Every svc_ command is
		//under 128, so the top bit is free to mean "the rest of this byte is a
		//delta mask". This is the single most load-bearing bit in the protocol.
		if (cmd & 128)
		{
			if (!QNetReadEntityUpdate(m, cmd & 127))
				return FALSE;

			goto qnp_next;
		}

		switch (cmd)
		{
			case QSVC_NOP:
				break;

			case QSVC_PRINT:
				//CL_ParseServerMessage: Con_Printf("%s", MSG_ReadString()).
				QMsgReadString(m, line, 128);
				QNetPrintStrip(shown, line, 128);
				QBiPrintAppend(shown);
				break;

			case QSVC_TIME:
				//svc_time comes before the updates it describes, so stamping
				//from here is what lets those updates carry the right time.
				q_cl.time     = QMsgReadFloat(m);
				q_net_msgtime = q_cl.time;
				break;

			case QSVC_CLIENTDATA:
				QNetParseClientdata(m);
				break;

			case QSVC_SPAWNBASELINE:
				QNetParseBaseline(m);
				break;

			case QSVC_SERVERINFO:
				QMsgReadLong(m);			//protocol
				QMsgReadByte(m);			//maxclients
				QMsgReadByte(m);			//gametype
				QMsgReadString(m, q_net_join_map, 64);

				//The shell loads it; this is only the parse.
				if (q_net_join_map[0])
					q_net_join_pending = TRUE;
				break;

			case QSVC_SETVIEW:
				q_cl_viewent = QMsgReadShort(m);
				break;

			case QSVC_SIGNONNUM:
				QMsgReadByte(m);
				break;

			case QSVC_CDTRACK:
				q_cl_cdtrack = QMsgReadByte(m);
				QMsgReadByte(m);		//the unused loop track
				break;

			case QSVC_UPDATENAME:
				QMsgReadByte(m);		//client number
				QMsgReadString(m, q_cl_name, 16);
				break;

			case QSVC_UPDATECOLORS:
				QMsgReadByte(m);		//client number
				i = QMsgReadByte(m);
				q_cl_top    = (i >> 4) & 15;
				q_cl_bottom = i & 15;
				break;

			case QSVC_SETANGLE:
				for (i = 0; i < 3; i++)
					q_cl.view_angles[i] = QMsgReadAngle(m);
				q_cl.angles_forced = TRUE;
				break;

			case QSVC_DAMAGE:
				//The blend itself is owned by the app shell's cshift code; this
				//only has to consume the right number of bytes.
				q_net_damage_save = QMsgReadByte(m);
				q_net_damage_take = QMsgReadByte(m);
				for (i = 0; i < 3; i++)
					q_net_damage_from[i] = QMsgReadCoord(m);
				q_net_damage_pending = TRUE;
				break;

			case QSVC_UPDATESTAT:
				QMsgReadByte(m);
				QMsgReadLong(m);
				q_cl.stats_received++;
				break;

			case QSVC_DISCONNECT:
				return TRUE;

			default:
				StrPrint(line, "net: unknown svc %d at byte %d\n",
					cmd, m->read - 1);
				QLog(line);
				QLogFlush;
				return FALSE;
		}

		if (m->badread)
			return FALSE;

qnp_next:
	}

	return TRUE;
}

U0 QSvCallPlayerFunc(I64 ent, U8 *name)
{//Run a named QuakeC function with self set to this client.
	I64 fn = QPrFindFunction(name);

	if (fn <= 0 || ent <= 0)
		return;

	QPrSetI(q_ofs_self, QPrEdictValue(ent));
	QPrSetI(q_ofs_other, 0);
	QPrExecute(fn);
	q_pr_error = FALSE;
}

U0 QSvClientPrintf(I64 slot, U8 *s)
{//SV_ClientPrintf: svc_print to one client (host.c).
 //
 //Local client has no separate reliable stream - park in the QuakeC print
 //buffer so QConDrainProgs shows it. Remotes get a dedicated datagram.
	U8	shown[128];
	CQMsg	*m;

	if (slot < 0 || slot >= QSV_MAX_CLIENTS || !q_sv_clients[slot].active)
		return;
	if (!s || !s[0])
		return;

	if (q_sv_clients[slot].local)
	{
		QNetPrintStrip(shown, s, 128);
		QBiPrintAppend(shown);
		return;
	}

	if (!q_udp_ready || !q_sv_clients[slot].ip)
		return;

	m = &q_net_send;
	QMsgClear(m);
	QMsgWriteByte(m, QSVC_PRINT);
	QMsgWriteString(m, s);
	QNetUdpSendTo(m, q_sv_clients[slot].ip);
}

U0 QSvBroadcastPrintf(U8 *s)
{//SV_BroadcastPrintf - every active client.
	I64 i;

	if (!s || !s[0])
		return;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
		if (q_sv_clients[i].active)
			QSvClientPrintf(i, s);
}

I64 QSvFindLocalSlot()
{
	I64 i;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
		if (q_sv_clients[i].active && q_sv_clients[i].local)
			return i;

	return -1;
}

U0 QHostSay(I64 from_slot, U8 *msg, Bool teamonly)
{//Host_Say from host_cmd.c. Formats "\1name: text\n" and SV_ClientPrintf
 //each spawned client. teamonly honours teamplay like the original.
	U8	 text[64];
	U8	 body[64];
	U8	*p;
	U8	*nm;
	I64	 i;
	I64	 j;
	I64	 room;
	I64	 from_team;
	I64	 to_team;
	I64	 n;

	if (from_slot < 0 || from_slot >= QSV_MAX_CLIENTS ||
		!q_sv_clients[from_slot].active)
		return;
	if (!msg)
		return;

	//Cmd_Args may be quote-wrapped.
	p = msg;
	while (*p == ' ')
		p++;
	if (*p == '"')
	{
		p++;
		n = StrLen(p);
		if (n > 0 && p[n - 1] == '"')
		{
			MemCopy(body, p, n - 1);
			body[n - 1] = 0;
			p = body;
		}
	}
	if (!p[0])
		return;

	nm = q_sv_clients[from_slot].name;
	if (!nm[0])
		nm = "player";

	//Colour set 1, then "name: ".
	text[0] = 1;
	StrPrint(text + 1, "%s: ", nm);

	j = StrLen(text);
	room = 62 - j;
	if (room < 1)
		return;

	n = StrLen(p);
	if (n > room)
		n = room;

	MemCopy(text + j, p, n);
	j += n;
	text[j] = '\n';
	j++;
	text[j] = 0;

	from_team = 0;
	if (q_fld_team >= 0 && q_sv_clients[from_slot].edict > 0)
		from_team = ToI64(QPrFieldF(q_sv_clients[from_slot].edict, q_fld_team));

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (!q_sv_clients[i].active || q_sv_clients[i].edict <= 0)
			goto qhs_next;

		if (teamonly && QCvarGet("teamplay") != 0.0)
		{
			to_team = 0;
			if (q_fld_team >= 0)
				to_team = ToI64(QPrFieldF(q_sv_clients[i].edict, q_fld_team));
			if (to_team != from_team)
				goto qhs_next;
		}

		QSvClientPrintf(i, text);

qhs_next:
	}

	//Sys_Printf - server log without the colour byte.
	QNetPrintStrip(body, text, 64);
	QLog(body);
}

U0 QHostTell(I64 from_slot, U8 *line)
{//Host_Tell_f: whisper to one client by name. "tell name message..."
	U8	 text[64];
	U8	 target[32];
	U8	*p;
	U8	*nm;
	I64	 i;
	I64	 j;
	I64	 n;
	I64	 room;
	I64	 dest;

	if (from_slot < 0 || from_slot >= QSV_MAX_CLIENTS ||
		!q_sv_clients[from_slot].active)
		return;
	if (!line)
		return;

	while (*line == ' ')
		line++;

	j = 0;
	while (line[0] && line[0] != ' ' && j < 31)
	{
		target[j] = line[0];
		j++;
		line++;
	}
	target[j] = 0;

	while (*line == ' ')
		line++;
	if (!target[0] || !line[0])
		return;

	dest = -1;
	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (!q_sv_clients[i].active)
			goto qht_next;
		if (!StrICompare(q_sv_clients[i].name, target))
		{
			dest = i;
			break;
		}
qht_next:
	}

	if (dest < 0)
		return;

	nm = q_sv_clients[from_slot].name;
	if (!nm[0])
		nm = "player";

	StrPrint(text, "%s: ", nm);
	j = StrLen(text);
	room = 62 - j;
	p = line;
	if (*p == '"')
	{
		p++;
		n = StrLen(p);
		if (n > 0 && p[n - 1] == '"')
			n--;
	}
	else
		n = StrLen(p);

	if (n > room)
		n = room;
	MemCopy(text + j, p, n);
	j += n;
	text[j] = '\n';
	j++;
	text[j] = 0;

	QSvClientPrintf(dest, text);
	QSvClientPrintf(from_slot, text);
}

U0 QNetClientSendStringCmd(U8 *s)
{//Cmd_ForwardToServer: whole command line as clc_stringcmd.
	if (!q_net_active || !s || !s[0])
		return;

	QMsgClear(&q_net_cmd);
	QMsgWriteByte(&q_net_cmd, QCLC_STRINGCMD);
	QMsgWriteString(&q_net_cmd, s);

	//Joined guest: UDP only (thin client has no useful loopback server).
	if (q_udp_ready && !q_udp_server)
	{
		QNetUdpSend(&q_net_cmd);
		return;
	}

	//Listen host / solo: loopback, same path as clc_move.
	QNetSendToServer(&q_net_cmd);
}

U0 QSvRunEntityThink(I64 ent)
{//SV_Physics_Client's think half: player_shot / player_run frame chains.
 //Must run AFTER PlayerPostThink, or the shot pose never advances.
	I64 think;
	F64 nextthink;

	if (ent <= 0 || q_pr_edict_free[ent])
		return;

	nextthink = QPrFieldF(ent, q_fld_nextthink);
	if (nextthink <= 0.0 || nextthink > q_game_time)
		return;

	QPrSetFieldF(ent, q_fld_nextthink, 0.0);
	think = QPrFieldI(ent, q_fld_think);
	if (think > 0 && think < q_pr_num_functions)
	{
		QPrSetI(q_ofs_self, QPrEdictValue(ent));
		QPrSetI(q_ofs_other, 0);
		QPrExecute(think);
		q_pr_error = FALSE;
		q_game_thinks++;
	}
}

U0 QNetSyncLocalFromClient()
{//Thin-client HUD/death/viewweapon: svc_clientdata is truth. Local edict stays
 //at spawn health otherwise, so the guest never saw damage or died.
	if (!q_player_active || q_player_edict <= 0)
		return;
	if (!(q_udp_ready && !q_udp_server))
		return;

	if (q_fld_health >= 0)
		QPrSetFieldF(q_player_edict, q_fld_health, ToF64(q_cl.health));
	if (q_fld_armorvalue >= 0)
		QPrSetFieldF(q_player_edict, q_fld_armorvalue, ToF64(q_cl.armorvalue));
	if (q_fld_currentammo >= 0)
		QPrSetFieldF(q_player_edict, q_fld_currentammo, ToF64(q_cl.currentammo));
	if (q_fld_ammo_shells >= 0)
		QPrSetFieldF(q_player_edict, q_fld_ammo_shells, ToF64(q_cl.ammo_shells));
	if (q_fld_ammo_nails >= 0)
		QPrSetFieldF(q_player_edict, q_fld_ammo_nails, ToF64(q_cl.ammo_nails));
	if (q_fld_ammo_rockets >= 0)
		QPrSetFieldF(q_player_edict, q_fld_ammo_rockets, ToF64(q_cl.ammo_rockets));
	if (q_fld_ammo_cells >= 0)
		QPrSetFieldF(q_player_edict, q_fld_ammo_cells, ToF64(q_cl.ammo_cells));
	if (q_fld_weapon >= 0)
		QPrSetFieldF(q_player_edict, q_fld_weapon, ToF64(q_cl.weapon));
	if (q_fld_weaponframe >= 0)
		QPrSetFieldF(q_player_edict, q_fld_weaponframe, ToF64(q_cl.weaponframe));
	if (q_fld_items >= 0)
		QPrSetFieldF(q_player_edict, q_fld_items, ToF64(q_cl.items));
	if (q_fld_view_ofs >= 0)
		QPrSetFieldF(q_player_edict, q_fld_view_ofs + 2, q_cl.view_height);
}

//--- server client slots ---------------------------------------------------
//
// A listen server has one LOCAL client - the person at the keyboard, whose
// moves arrive over the loopback link - and room for remote ones that arrive as
// datagrams. Both kinds get a real player edict through the same QuakeC path,
// because a client the game logic cannot see is not a player: it would not be
// hit by rockets, would trigger nothing, and would not appear in anyone else's
// entity updates.
// Decl/defs of CQSvClient / QSV_* live near the top (QNetServerFrame needs them).

U0 QSvClientsClear()
{//Globals are not zeroed.
	I64 i;
	I64 j;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		q_sv_clients[i].edict     = 0;
		q_sv_clients[i].ip        = 0;
		q_sv_clients[i].active    = FALSE;
		q_sv_clients[i].local     = FALSE;
		q_sv_clients[i].seen_move = FALSE;
		q_sv_clients[i].attack    = FALSE;
		q_sv_clients[i].jump      = FALSE;
		q_sv_clients[i].impulse   = 0;
		q_sv_clients[i].last_msg  = 0.0;
		q_sv_clients[i].on_ground = FALSE;

		for (j = 0; j < 3; j++)
		{
			q_sv_clients[i].angles[j]   = 0.0;
			q_sv_clients[i].cmd[j]      = 0.0;
			q_sv_clients[i].origin[j]   = 0.0;
			q_sv_clients[i].velocity[j] = 0.0;
		}
	}

	q_sv_client_count = 0;
}

I64 QSvFindClient(U32 ip)
{//Slot for a sender address, or -1. The local client owns ip 0.
	I64 i;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
		if (q_sv_clients[i].active && q_sv_clients[i].ip == ip)
			return i;

	return -1;
}

I64 QSvAddClient(U32 ip, Bool local, I64 edict, F64 now)
{//Take a free slot. Remote clients are NOT spawned yet - that waits for the
 //"connect <name>" stringcmd so .netname is set before ClientConnect bprints.
 //-1 if the server is full.
	F64	org[3];
	F64	ang[3];
	I64	i;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (q_sv_clients[i].active)
			goto qsv_next;

		QVecSet(org, 0.0, 0.0, 0.0);
		QVecSet(ang, 0.0, 0.0, 0.0);

		//LOCAL client already has the reserved player edict.
		//REMOTE: leave edict 0 until connect names them.
		if (local && edict > 0)
		{
			org[0] = QPrFieldF(edict, q_fld_origin);
			org[1] = QPrFieldF(edict, q_fld_origin + 1);
			org[2] = QPrFieldF(edict, q_fld_origin + 2);
		}
		else if (!local)
			edict = 0;
		else if (edict <= 0)
			return -1;

		q_sv_clients[i].edict     = edict;
		q_sv_clients[i].ip        = ip;
		q_sv_clients[i].active    = TRUE;
		q_sv_clients[i].local     = local;
		q_sv_clients[i].seen_move = FALSE;
		q_sv_clients[i].last_msg  = now;
		q_sv_clients[i].top       = 0;
		q_sv_clients[i].bottom    = 0;
		q_sv_clients[i].name[0]   = 0;

		QVecCopy(org, q_sv_clients[i].origin);
		QVecSet(q_sv_clients[i].velocity, 0.0, 0.0, 0.0);

		q_sv_client_count++;

		return i;

qsv_next:
	}

	return -1;
}

U0 QSvApplyClientColors(I64 ent, I64 top, I64 bottom)
{//Pack shirt/trousers into .colormap. QNetCaptureState sends it; draw paths
 //remap player.mdl skins from the same byte.
	if (ent <= 0 || q_fld_colormap < 0)
		return;

	top    = top & 15;
	bottom = bottom & 15;
	QPrSetFieldF(ent, q_fld_colormap, ToF64((top << 4) | bottom));
}

U0 QSvEnsureClientModel(I64 ent)
{//PutClientInServer should setmodel(progs/player.mdl). If it aborted early the
 //body has no alias model: QGameDrawEntities silently skips (mdl == NULL) and
 //the host never sees the guest. Force the player model.
	I64 idx;
	U8 *name;

	if (ent <= 0)
		return;

	idx  = ToI64(QPrFieldF(ent, q_fld_modelindex));
	name = QPrStr(QPrFieldI(ent, q_fld_model));

	//Need BOTH a live alias slot AND a non-empty .model string. Index alone
	//left EntityVisible returning FALSE and the guest off every datagram.
	if (idx > 0 && idx < q_precache_model_count && q_precache_mdl[idx] &&
		name && name[0])
		return;

	idx = QBiPrecacheModel("progs/player.mdl");
	if (idx <= 0)
		return;

	QPrSetFieldF(ent, q_fld_modelindex, ToF64(idx));
	QPrSetFieldI(ent, q_fld_model, QPrNewString("progs/player.mdl"));
}

U0 QSvDrawRemoteClients(CQCanvas *c, CQMap *map, F64 *view_origin)
{//Listen-server belt: draw every remote body with player.mdl even if the
 //edict's modelindex path failed. Guest already sees the host via wire.
	CQMdl		*mdl;
	CQEntState	*cl;
	F64			 eorg[3];
	F64			 d[3];
	I64			 i;
	I64			 ent;
	I64			 frame;
	I64			 top;
	I64			 bottom;
	I64			 cmap;
	F64			 yaw;
	Bool		 have;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (!q_sv_clients[i].active || q_sv_clients[i].local)
			goto qdr_next;

		ent = q_sv_clients[i].edict;
		if (ent <= 0)
			goto qdr_next;

		QSvEnsureClientModel(ent);

		have = FALSE;
		top    = q_sv_clients[i].top;
		bottom = q_sv_clients[i].bottom;

		//Prefer the loopback-reconstructed state (same bytes the guest draws
		//the host from). Falls back to the edict / slot if the datagram
		//dropped this body.
		if (ent < QNET_MAX_ENTS)
		{
			cl = &q_net_cl[ent];
			if (cl->active && cl->msgtime >= q_cl.time - 0.5)
			{
				QVecCopy(cl->origin, eorg);
				frame = cl->frame;
				yaw   = cl->angles[1];
				cmap  = cl->colormap;
				top   = (cmap >> 4) & 15;
				bottom = cmap & 15;
				have  = TRUE;
			}
		}

		if (!have)
		{
			eorg[0] = QPrFieldF(ent, q_fld_origin);
			eorg[1] = QPrFieldF(ent, q_fld_origin + 1);
			eorg[2] = QPrFieldF(ent, q_fld_origin + 2);

			//Edict never moved - use the slot copy QSvRunClients maintains.
			if (eorg[0] == 0.0 && eorg[1] == 0.0 && eorg[2] == 0.0)
			{
				eorg[0] = q_sv_clients[i].origin[0];
				eorg[1] = q_sv_clients[i].origin[1];
				eorg[2] = q_sv_clients[i].origin[2];
			}

			frame = ToI64(QPrFieldF(ent, q_fld_frame));
			yaw   = QPrFieldF(ent, q_fld_angles + 1);
			if (q_fld_colormap >= 0)
			{
				cmap = ToI64(QPrFieldF(ent, q_fld_colormap));
				top    = (cmap >> 4) & 15;
				bottom = cmap & 15;
			}
		}

		mdl = QMdlPreviewGet(top, bottom);
		if (!mdl)
			mdl = QMdlCacheGet("progs/player.mdl");
		if (!mdl)
			goto qdr_next;

		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		QVecSub(eorg, view_origin, d);
		if (QVecLength(d) > 10000.0)
			goto qdr_next;

		//Skip only when sitting exactly on the camera (same spawn, backface
		//culled into invisibility). Nudge the draw copy up a hair so a shared
		//spawn pad still shows a body.
		if (QVecLength(d) < 1.0)
			eorg[2] = eorg[2] + 8.0;

		QMdlDraw(c, mdl, frame, eorg, yaw, QLightPoint(map, eorg));

qdr_next:
	}
}

Bool QSvSpawnRemote(I64 slot, U8 *name, I64 top=0, I64 bottom=0)
{//Give a deferred remote slot its body, named before ClientConnect runs.
	F64 org[3];
	F64 ang[3];
	I64 edict;
	U8  join_name[32];

	if (slot < 0 || slot >= QSV_MAX_CLIENTS || !q_sv_clients[slot].active)
		return FALSE;
	if (q_sv_clients[slot].local || q_sv_clients[slot].edict > 0)
		return TRUE;

	//MUST copy off the caller's buffer. Connect parse passes q_net_cmd_line+ni;
	//StrPrint into that same line would overlap and corrupt the name.
	if (!name || !name[0])
		QStrCopy(join_name, "player", 32);
	else
	{
		MemCopy(join_name, name, 31);
		join_name[31] = 0;
	}

	QVecSet(org, 0.0, 0.0, 0.0);
	QVecSet(ang, 0.0, 0.0, 0.0);

	edict = QPrSpawnEdict;
	if (edict <= 0)
		return FALSE;

	//Deathmatch rules (DM spawn pads, weapon stay) must be live BEFORE
	//PutClientInServer picks a spot - otherwise both bodies share
	//info_player_start and the host stands inside the guest (backface-culled).
	if (q_ofs_deathmatch >= 0)
		QPrSetF(q_ofs_deathmatch, QCvarGet("deathmatch"));

	if (!QClientSpawnAt(edict, org, ang, join_name))
	{
		QPrFreeEdict(edict);
		return FALSE;
	}

	QSvEnsureClientModel(edict);
	q_sv_clients[slot].top    = top & 15;
	q_sv_clients[slot].bottom = bottom & 15;
	QStrCopy(q_sv_clients[slot].name, join_name, 32);
	QSvApplyClientColors(edict, q_sv_clients[slot].top, q_sv_clients[slot].bottom);
	QGameLinkEdict(edict);

	q_sv_clients[slot].edict = edict;
	QVecCopy(org, q_sv_clients[slot].origin);

	StrPrint(q_net_cmd_line,
		"net: remote spawn edict %d at %.0f %.0f %.0f\n",
		edict, org[0], org[1], org[2]);
	QLog(q_net_cmd_line);
	QLogFlush;

	//Engine-side announce so the join name is visible even when QuakeC's
	//bprint(self.netname) got an empty string offset (QBiPrint stops on 0).
	StrPrint(q_net_cmd_line, "%s entered the game\n", join_name);
	QSvBroadcastPrintf(q_net_cmd_line);

	return TRUE;
}

U0 QSvDropClient(I64 slot)
{//SV_DropClient. The body is removed, or it stands in the level forever.
	if (slot < 0 || slot >= QSV_MAX_CLIENTS || !q_sv_clients[slot].active)
		return;

	if (!q_sv_clients[slot].local && q_sv_clients[slot].edict > 0)
		QPrFreeEdict(q_sv_clients[slot].edict);

	q_sv_clients[slot].active = FALSE;
	q_sv_clients[slot].edict  = 0;
	q_sv_client_count--;
}

U0 QSvCheckTimeouts(F64 now)
{//A client that has stopped sending moves is gone. Without this its body stays
 //standing in the level being shot at forever.
 //
 //Do NOT apply the short timeout before the first clc_move: after svc_serverinfo
 //the guest loads the map and is silent for many seconds. A 3s cut there dropped
 //the body while the guest still thought it had joined.
	I64 i;
	F64 limit;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (!q_sv_clients[i].active || q_sv_clients[i].local)
			goto qsv_to_next;

		if (q_sv_clients[i].seen_move)
			limit = QSV_TIMEOUT;
		else
			limit = QSV_CONNECT_GRACE;

		if (now - q_sv_clients[i].last_msg > limit)
		{
			QLog("net: client timed out\n");
			QSvDropClient(i);
		}

qsv_to_next:
	}
}

//--- signon ----------------------------------------------------------------
//
// "connect" opening a socket is not joining a game. In the original the client
// sends a connection request, the server answers with svc_serverinfo naming the
// level, and only then does the client load that map and start playing. Without
// that exchange the client sits in its menu forever - its game loop never runs,
// so it never transmits, and the server never hears from it.

#define QNET_PROTOCOL	15		//NET_PROTOCOL_VERSION

U0 QNetClientSendConnect(U8 *name, I64 top=0, I64 bottom=0)
{//Connection request carrying the setup-page name + shirt/trousers colours.
	U8 line[64];

	if (!q_udp_ready || q_udp_server || !q_udp_peer_ip)
		return;

	if (!name || !name[0])
		name = "player";

	StrPrint(line, "connect %s %d %d", name, top & 15, bottom & 15);

	QMsgClear(&q_net_cmd);
	QMsgWriteByte(&q_net_cmd, QCLC_STRINGCMD);
	QMsgWriteString(&q_net_cmd, line);

	QNetUdpSend(&q_net_cmd);
}

U0 QNetSendServerInfo(I64 slot)
{//svc_serverinfo, answering a connection request.
 //
 //DEVIATION: the original follows the level name with the full model and sound
 //precache lists, and the client builds its tables from them. Both ends here
 //load the same map from the same PAK, so their precache tables come out
 //identical by construction - and sending several hundred strings would need
 //the signon splitting across datagrams, which is the only reason the original
 //has multiple signon buffers.
	I64 edict;

	edict = 0;
	if (slot >= 0 && slot < QSV_MAX_CLIENTS)
		edict = q_sv_clients[slot].edict;

	QMsgClear(&q_net_send);

	QMsgWriteByte(&q_net_send, QSVC_SERVERINFO);
	QMsgWriteLong(&q_net_send, QNET_PROTOCOL);
	QMsgWriteByte(&q_net_send, QSV_MAX_CLIENTS);
	QMsgWriteByte(&q_net_send, 1);				//gametype: deathmatch
	QMsgWriteString(&q_net_send, q_map_name);

	//Tell the guest which edict is THEIR body so first-person can hide it and
	//entity updates for everyone else stay on screen.
	if (edict > 0)
	{
		QMsgWriteByte(&q_net_send, QSVC_SETVIEW);
		QMsgWriteShort(&q_net_send, edict);
	}

	QMsgWriteByte(&q_net_send, QSVC_SIGNONNUM);
	QMsgWriteByte(&q_net_send, 1);

	if (!QNetUdpSend(&q_net_send))
	{
		//Usually ARP miss on a byte-swapped peer IP - see QNetUdpRecv.
		QLog("net: svc_serverinfo send FAILED - client will stay in menu\n");
		QLogFlush;
	}
}

Bool QNetServerExecStringCmd(I64 slot, U8 *line)
{//SV_ReadClientMessage clc_stringcmd allowlist (sv_user.c) + connect.
 //Returns TRUE if the command was recognised.
	I64 ni;
	I64 nj;
	I64 nk;
	I64 ctop;
	I64 cbot;
	U8  cname[32];

	if (!line)
		return FALSE;

	//--- connect <name> [top] [bottom] ---
	if (!StrNICompare(line, "connect", 7) &&
		(line[7] == 0 || line[7] == ' '))
	{
		ni = 7;
		ctop = 0;
		cbot = 0;
		cname[0] = 0;

		while (line[ni] == ' ')
			ni++;

		nj = 0;
		while (line[ni] && line[ni] != ' ' && nj < 31)
		{
			cname[nj] = line[ni];
			nj++;
			ni++;
		}
		cname[nj] = 0;

		while (line[ni] == ' ')
			ni++;
		if (line[ni] >= '0' && line[ni] <= '9')
		{
			ctop = 0;
			while (line[ni] >= '0' && line[ni] <= '9')
			{
				ctop = ctop * 10 + (line[ni] - '0');
				ni++;
			}
			ctop = ctop & 15;
		}

		while (line[ni] == ' ')
			ni++;
		if (line[ni] >= '0' && line[ni] <= '9')
		{
			cbot = 0;
			while (line[ni] >= '0' && line[ni] <= '9')
			{
				cbot = cbot * 10 + (line[ni] - '0');
				ni++;
			}
			cbot = cbot & 15;
		}

		if (slot >= 0)
		{
			if (q_sv_clients[slot].edict <= 0)
			{
				if (cname[0])
					QSvSpawnRemote(slot, cname, ctop, cbot);
				else
					QSvSpawnRemote(slot, "player", ctop, cbot);

				QNetSendServerInfo(slot);
			}
			else
			{
				nk = q_sv_clients[slot].edict;
				QMsgClear(&q_net_send);
				QMsgWriteByte(&q_net_send, QSVC_SETVIEW);
				QMsgWriteShort(&q_net_send, nk);
				QNetUdpSend(&q_net_send);
			}
		}
		return TRUE;
	}

	//--- say / say_team (Host_Say_f / Host_Say_Team_f) ---
	if (!StrNICompare(line, "say_team", 8) &&
		(line[8] == 0 || line[8] == ' '))
	{
		ni = 8;
		while (line[ni] == ' ')
			ni++;
		QHostSay(slot, line + ni, TRUE);
		return TRUE;
	}

	if (!StrNICompare(line, "say", 3) &&
		(line[3] == 0 || line[3] == ' '))
	{
		ni = 3;
		while (line[ni] == ' ')
			ni++;
		QHostSay(slot, line + ni, FALSE);
		return TRUE;
	}

	//--- tell <name> <msg> (Host_Tell_f) ---
	if (!StrNICompare(line, "tell", 4) &&
		(line[4] == 0 || line[4] == ' '))
	{
		ni = 4;
		while (line[ni] == ' ')
			ni++;
		QHostTell(slot, line + ni);
		return TRUE;
	}

	return FALSE;
}

//--- upstream: the client's move ------------------------------------------
//
//The other half of the protocol. Until now the app shell wrote the player's
//buttons and view angles straight onto the edict; here the client SENDS them and
//the server reads them back off the wire, which is what CL_SendMove and
//SV_ReadClientMove do. It is the path a second player would arrive on.

U0 QNetClientSendMove(F64 *view_angles, F64 forward, F64 side, F64 up,
	Bool attack, Bool jump, I64 impulse, F64 time, F64 *origin=NULL)
{//CL_SendMove. origin (when set) is where THIS client believes it stands -
 //the listen host parks remote bodies there so it can see/shoot them.
	I64 bits = 0;

	if (!q_net_active)
		return;

	QMsgClear(&q_net_cmd);

	QMsgWriteByte(&q_net_cmd, QCLC_MOVE);

	//The client's timestamp is echoed so the SERVER can measure the round trip.
	//It is the client's clock, not the server's, and is never used as a time.
	QMsgWriteFloat(&q_net_cmd, time);

	QMsgWriteAngle(&q_net_cmd, view_angles[0]);
	QMsgWriteAngle(&q_net_cmd, view_angles[1]);
	QMsgWriteAngle(&q_net_cmd, view_angles[2]);

	//Move intent goes as SHORTS in units per second, not as a direction: the
	//server applies the player's angles to them itself.
	QMsgWriteShort(&q_net_cmd, ToI64(forward));
	QMsgWriteShort(&q_net_cmd, ToI64(side));
	QMsgWriteShort(&q_net_cmd, ToI64(up));

	if (attack)	bits |= 1;
	if (jump)	bits |= 2;
	QMsgWriteByte(&q_net_cmd, bits);

	QMsgWriteByte(&q_net_cmd, impulse);

	//Trailing origin - our clients always send it. Without this the host's
	//server-side hull walk left remote bodies in the void while the guest's
	//predicted camera stood next to the host (guest saw host; host saw air).
	if (origin)
	{
		QMsgWriteCoord(&q_net_cmd, origin[0]);
		QMsgWriteCoord(&q_net_cmd, origin[1]);
		QMsgWriteCoord(&q_net_cmd, origin[2]);
	}

	//A joined client sends its move to the REMOTE server, and also to its own
	//loopback queue - NOT one or the other.
	//
	//Returning early after the UDP send was wrong: this client still runs a
	//local world to render from, and that local server reads its input off the
	//loopback queue. Skipping it left the local simulation with no input at all,
	//which shows up as moves 0/0 and an empty datagram while the game visibly
	//keeps playing. Once the renderer draws purely from the client tables this
	//local half goes away, and with it the double send.
	if (q_udp_ready && !q_udp_server)
	{
		if (QNetUdpSend(&q_net_cmd))
			q_net_moves_sent++;

		QNetSendToServer(&q_net_cmd);
		return;
	}

	//Counted here too, or a listen server reports "0 sent" while happily
	//feeding its own local client - which reads as the send path being dead.
	if (QNetSendToServer(&q_net_cmd))
		q_net_moves_sent++;
}

Bool QNetServerReadMove(CQMsg *m, I64 ent, F64 server_time, I64 slot = -1)
{//SV_ReadClientMove. The clc_move byte has already been consumed.
	I64 bits;
	I64 imp;
	I64 j;
	F64 org[3];

	q_net_move_ping = server_time - QMsgReadFloat(m);

	for (j = 0; j < 3; j++)
		q_net_move_angles[j] = QMsgReadAngle(m);

	q_net_move_cmd[0] = ToF64(QMsgReadShort(m));
	q_net_move_cmd[1] = ToF64(QMsgReadShort(m));
	q_net_move_cmd[2] = ToF64(QMsgReadShort(m));

	bits = QMsgReadByte(m);
	imp  = QMsgReadByte(m);

	if (m->badread)
		return FALSE;

	q_net_move_attack = ToBool(bits & 1);
	q_net_move_jump   = ToBool((bits & 2) != 0);

	//IMPULSE IS ONLY OVERWRITTEN WHEN NON-ZERO - if (i) ent->v.impulse = i.
	//The server does not clear it on a move that carries none, because
	//ImpulseCommands is what clears it, and that runs in PlayerPostThink. A
	//move arriving in between must not wipe the pending request.
	if (imp)
	{
		q_net_move_impulse = imp;
		if (ent > 0 && q_fld_impulse >= 0)
			QPrSetFieldF(ent, q_fld_impulse, ToF64(imp));
	}

	if (ent > 0)
	{
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_v_angle + j, q_net_move_angles[j]);

		if (q_net_move_attack)
			QPrSetFieldF(ent, q_fld_button0, 1.0);
		else
			QPrSetFieldF(ent, q_fld_button0, 0.0);

		if (q_net_move_jump)
			QPrSetFieldF(ent, q_fld_button2, 1.0);
		else
			QPrSetFieldF(ent, q_fld_button2, 0.0);
	}

	//Park the move on the sender's slot. Its tick applies it; doing it here
	//would run one client's input inside another's read.
	if (slot >= 0)
	{
		QVecCopy(q_net_move_angles, q_sv_clients[slot].angles);
		QVecCopy(q_net_move_cmd, q_sv_clients[slot].cmd);
		q_sv_clients[slot].attack   = q_net_move_attack;
		q_sv_clients[slot].jump     = q_net_move_jump;
		q_sv_clients[slot].last_msg = server_time;
		q_sv_clients[slot].seen_move = TRUE;

		if (imp)
			q_sv_clients[slot].impulse = imp;
	}

	//Trailing client origin (6 bytes). Snap REMOTE bodies to it so the host
	//draws/shoots where the guest's predicted camera actually is.
	if (m->read + 6 <= m->len)
	{
		org[0] = QMsgReadCoord(m);
		org[1] = QMsgReadCoord(m);
		org[2] = QMsgReadCoord(m);

		if (!m->badread && slot >= 0 && !q_sv_clients[slot].local)
		{
			QVecCopy(org, q_sv_clients[slot].origin);

			if (ent > 0)
			{
				for (j = 0; j < 3; j++)
					QPrSetFieldF(ent, q_fld_origin + j, org[j]);
				QGameLinkEdict(ent);
			}
		}
	}

	q_net_moves_read++;

	return TRUE;
}

Bool QNetParseFromClient(CQMsg *in, I64 slot, F64 server_time)
{//One client's message, whatever the transport was.
	I64 cmd;
	I64 ent = 0;

	if (slot >= 0 && slot < QSV_MAX_CLIENTS)
		q_sv_clients[slot].last_msg = server_time;

	if (slot >= 0)
		ent = q_sv_clients[slot].edict;

	in->read    = 0;
	in->badread = FALSE;

	while (in->read < in->len)
	{
		cmd = QMsgReadByte(in);
		if (in->badread)
			return FALSE;

		switch (cmd)
		{
			case QCLC_NOP:
				break;

			case QCLC_MOVE:
				if (!QNetServerReadMove(in, ent, server_time, slot))
					return FALSE;
				break;

			case QCLC_DISCONNECT:
				if (slot >= 0)
					QSvDropClient(slot);
				return TRUE;

			case QCLC_STRINGCMD:
				QMsgReadString(in, q_net_cmd_line, 128);
				//sv_user.c allowlist: connect / say / say_team / tell / ...
				QNetServerExecStringCmd(slot, q_net_cmd_line);
				break;

			default:
				return FALSE;
		}
	}

	return TRUE;
}

Bool QNetServerReadClient(I64 ent, F64 server_time)
{//SV_RunClients' read half: drain whatever the clients sent us.
	CQMsg	*in = &q_net_recv_c2s;
	I64		 cmd;
	I64		 slot;
	I64		 local_slot;

	local_slot = QSvFindLocalSlot;

	//Remote moves are pulled into the SAME queue the local client writes to, so
	//the parse below cannot tell them apart - which is the point. The first
	//datagram to arrive also fixes the peer address, so hosting needs no prior
	//configuration: whoever speaks first becomes the client.
	//REMOTE clients are parsed here, per sender, rather than being folded into
	//the local queue. Their moves belong to their own bodies, and a datagram
	//from an address with no slot yet IS the connection request - a listen
	//server has nothing else to go on.
	if (q_udp_ready && q_udp_server)
	{
		while (QNetUdpRecv(&q_net_udp_in))
		{
			slot = QSvFindClient(q_udp_from_ip);

			if (slot < 0 && q_udp_from_ip)
			{
				slot = QSvAddClient(q_udp_from_ip, FALSE, 0, server_time);

				if (slot >= 0)
				{
					StrPrint(q_net_cmd_line,
						"net: client %d.%d.%d.%d joined as edict %d\n",
						q_udp_from_ip & 255, (q_udp_from_ip >> 8) & 255,
						(q_udp_from_ip >> 16) & 255,
						(q_udp_from_ip >> 24) & 255,
						q_sv_clients[slot].edict);
					QLog(q_net_cmd_line);
					QLogFlush;
				}
			}

			if (slot >= 0)
			{
				//Ensure the reply path has a MAC before we try svc_serverinfo.
				//IPV4Handler usually cached it on ingress; probe covers a miss.
				if (!QNetUdpPeerResolved)
					QNetUdpArpProbe;

				QNetParseFromClient(&q_net_udp_in, slot, server_time);
			}
		}
	}

	while (QNetServerGetMessage(in))
	{
		in->read    = 0;
		in->badread = FALSE;

		while (in->read < in->len)
		{
			cmd = QMsgReadByte(in);
			if (in->badread)
				return FALSE;

			switch (cmd)
			{
				case QCLC_NOP:
					break;

				case QCLC_MOVE:
					if (!QNetServerReadMove(in, ent, server_time))
						return FALSE;
					break;

				case QCLC_DISCONNECT:
					return TRUE;

				case QCLC_STRINGCMD:
					//Cmd_ExecuteString(s, src_client) for the local loopback
					//client - Host_Say arrives here via Cmd_ForwardToServer.
					QMsgReadString(in, q_net_cmd_line, 128);
					QNetServerExecStringCmd(local_slot, q_net_cmd_line);
					break;

				default:
					return FALSE;
			}
		}
	}

	return TRUE;
}

U0 QSvRunClients(F64 dt, F64 now)
{//SV_RunClients for the REMOTE clients only - the local one is driven by the
 //app shell, which owns the keyboard and the view.
 //
 //Remote ORIGIN comes from the client's clc_move (see QNetServerReadMove).
 //Angles/buttons still drive aim and W_WeaponFrame via the QuakeC thinks.
	F64	ang[3];
	I64	ent;
	I64	i;
	I64	j;
	I64	flags;

	for (i = 0; i < QSV_MAX_CLIENTS; i++)
	{
		if (!q_sv_clients[i].active || q_sv_clients[i].local)
			goto qsr_next;

		ent = q_sv_clients[i].edict;
		if (ent <= 0)
			goto qsr_next;

		QSvEnsureClientModel(ent);

		//The body angles carry yaw only; v_angle carries the full view, which
		//is what the weapon code aims along.
		QVecCopy(q_sv_clients[i].angles, ang);

		QPrSetFieldF(ent, q_fld_angles, 0.0);
		QPrSetFieldF(ent, q_fld_angles + 1, ang[1]);
		QPrSetFieldF(ent, q_fld_angles + 2, 0.0);

		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_v_angle + j, ang[j]);

		//QuakeC tests if (self.button0) as a float. Write 1.0/0.0 explicitly.
		if (q_sv_clients[i].attack)
			QPrSetFieldF(ent, q_fld_button0, 1.0);
		else
			QPrSetFieldF(ent, q_fld_button0, 0.0);

		if (q_sv_clients[i].jump)
			QPrSetFieldF(ent, q_fld_button2, 1.0);
		else
			QPrSetFieldF(ent, q_fld_button2, 0.0);

		if (q_sv_clients[i].impulse)
		{
			QPrSetFieldF(ent, q_fld_impulse,
				ToF64(q_sv_clients[i].impulse));
			q_sv_clients[i].impulse = 0;
		}

		//Preserve QuakeC-owned flag bits; only refresh CLIENT + ONGROUND.
		flags = ToI64(QPrFieldF(ent, q_fld_flags));
		flags |= QFL_CLIENT;
		if (q_sv_clients[i].on_ground)
			flags |= QFL_ONGROUND_;
		else
			flags &= ~QFL_ONGROUND_;
		QPrSetFieldF(ent, q_fld_flags, ToF64(flags));

		//Publish client origin before thinks so tracelines aim from the right spot.
		for (j = 0; j < 3; j++)
			QPrSetFieldF(ent, q_fld_origin + j, q_sv_clients[i].origin[j]);
		QGameLinkEdict(ent);

		//Items/doors/teleporters: touch AFTER the snap. QGameFrame already ran
		//with last frame's remote origin, so pickups never fired under guests.
		QGameTouchTriggersFor(ent);

		//PlayerPreThink then PlayerPostThink. Origin already snapped from the
		//client's clc_move - do NOT re-walk the hull here. Server-side
		//QPlayerMove was parking remotes in the void while the guest's predicted
		//camera stood next to the host.
		QSvCallPlayerFunc(ent, "PlayerPreThink");
		QSvCallPlayerFunc(ent, "PlayerPostThink");

		//Frame chains (player_shot1 -> player_run) live on .think/.nextthink.
		//Original runs them in SV_Physics_Client AFTER ClientThink; doing them
		//only in QGameRunThinks (before PostThink) left remotes stuck on the
		//first attack frame while still able to fire.
		QSvRunEntityThink(ent);

		//PostThink may have teleported / knocked; adopt what QuakeC decided.
		for (j = 0; j < 3; j++)
		{
			q_sv_clients[i].origin[j]   = QPrFieldF(ent, q_fld_origin + j);
			q_sv_clients[i].velocity[j] = QPrFieldF(ent, q_fld_velocity + j);
		}

		QGameLinkEdict(ent);

qsr_next:
	}

	QSvCheckTimeouts(now);
}

//--- drawing from the client's own tables -----------------------------------

U0 QNetDrawEntities(CQCanvas *c, CQMap *map, F64 *view_origin, F64 max_dist,
	I64 client_ent)
{//The same job as QGameDrawEntities, from the CLIENT's reconstruction instead
 //of the server's world.
 //
 //This is the actual point of the whole exercise. Everything drawn here came
 //off the wire: an origin that survived the eighth-unit coord format, an angle
 //quantised to 256 steps of a turn, a frame and skin carried in single bytes.
 //Nothing reads a q_fld_* field, so a remote client - which has no edicts at
 //all - can run this identical code.
 //
 //Selected with the cl_netdraw cvar rather than replacing the world path
 //outright, so the two can be compared side by side on a running game. The
 //differences that show up are the protocol's own precision limits, and seeing
 //them is the point.
	CQEntState	*e;
	F64			 eorg[3];
	F64			 d[3];
	CQMdl		*mdl;
	I64			 i;
	I64			 frame;
	I64			 bm;
	I64			 top;
	I64			 bottom;
	U8			*name;

	for (i = 1; i < q_net_num_ents && i < QNET_MAX_ENTS; i++)
	{
		e = &q_net_cl[i];

		//Not active means the server has never described it - out of the PVS,
		//or never existed. Either way the client cannot draw what it was not
		//told about, which is exactly the behaviour a real client has.
		if (!e->active)
			goto qnd_next;

		//NOT IN A RECENT MESSAGE means not visible. Exact != against q_cl.time
		//failed whenever two datagrams arrived in one frame: the later svc_time
		//moved q_cl.time and every entity from the earlier packet vanished for
		//that frame - including the other player. A short grace matches the
		//spirit of CL_RelinkEntities without the one-frame wipe.
		if (e->msgtime < q_cl.time - 0.1)
			goto qnd_next;

		if (i == client_ent)
			goto qnd_next;

		if (e->modelindex <= 0 || e->modelindex >= q_precache_model_count)
			goto qnd_next;

		QVecCopy(e->origin, eorg);
		name = q_precache_model[e->modelindex];

		//Brush models, and as on the server path they are not distance-culled:
		//the origin is an offset, not a position.
		if (name[0] == '*')
		{
			bm = QClipBrushModel(e->modelindex);
			if (bm > 0)
				QDrawBrushModel(c, map, bm, eorg);
			goto qnd_next;
		}

		QVecSub(eorg, view_origin, d);
		if (QVecLength(d) > max_dist)
			goto qnd_next;

		//Player skins carry shirt/trousers in .colormap (see QSvApplyClientColors).
		if (!StrICompare(name, "progs/player.mdl"))
		{
			top    = (e->colormap >> 4) & 15;
			bottom = e->colormap & 15;
			mdl    = QMdlPreviewGet(top, bottom);
		}
		else
			mdl = q_precache_mdl[e->modelindex];

		if (!mdl)
			goto qnd_next;

		frame = e->frame;
		if (frame < 0 || frame >= mdl->num_frames)
			frame = 0;

		QMdlDraw(c, mdl, frame, eorg, e->angles[1], QLightPoint(map, eorg));

qnd_next:
	}
}

I64 QNetVerify(I64 client_ent)
{//Count entities whose reconstructed state does not match the server's world.
 //
 //This is the whole justification for routing single player through the
 //protocol: the client's copy was built ONLY from bytes, so any disagreement
 //here is a real encode/decode fault rather than a rendering opinion. The
 //tolerance is an eighth of a unit plus a hair, which is the coord format's own
 //resolution - anything tighter would report quantisation as corruption.
	CQEntState	*c;
	F64			 d;
	I64			 bad = 0;
	I64			 i;
	I64			 j;

	for (i = 1; i < q_pr_num_edicts && i < QNET_MAX_ENTS; i++)
	{
		if (q_pr_edict_free[i] || i == client_ent)
			goto qnv_next;

		if (!QNetEntityVisible(i))
			goto qnv_next;

		c = &q_net_cl[i];
		if (!c->active)
			goto qnv_next;		//never sent: out of the PVS, not a mismatch

		//Nor is an entity the latest message did not mention. Its stored state
		//is legitimately stale, and comparing it against a server entity that
		//has since moved would report a mismatch for the protocol working
		//exactly as intended - which would make this counter useless.
		if (c->msgtime != q_cl.time)
			goto qnv_next;

		if (c->modelindex != ToI64(QPrFieldF(i, q_fld_modelindex)))
		{
			bad++;
			goto qnv_next;
		}

		for (j = 0; j < 3; j++)
		{
			d = c->origin[j] - QPrFieldF(i, q_fld_origin + j);
			if (d < 0.0)
				d = -d;

			if (d > 0.13)
			{
				bad++;
				goto qnv_next;
			}
		}

qnv_next:
	}

	return bad;
}

Bool QNetClientFrame()
{//Drain every message the link has for us. More than one can arrive per frame.
	CQMsg	*in = &q_net_recv;
	Bool	 ok  = TRUE;
	I64		 n;

	while (QNetGetMessage(in))
	{
		q_net_parsed++;
		if (!QNetClientParse(in))
			ok = FALSE;
	}

	//A client that JOINED a remote server has no loopback traffic at all - its
	//world arrives entirely as datagrams. Cap how many we chew per call so a
	//backlog cannot stall the frame forever.
	if (q_udp_ready && !q_udp_server)
	{
		n = 0;
		while (n < 16 && QNetUdpRecv(in))
		{
			n++;
			q_net_parsed++;
			if (!QNetClientParse(in))
				ok = FALSE;
		}
	}

	return ok;
}
