// Quake.ZC - application shell: window, input, frame loop.
//
// Rendering happens on this task and the blit happens in the draw_it callback
// on the window manager task. That callback must never block (it drives the
// whole compositor), so it only ever copies pixels.

//cl_forwardspeed and cl_forwardspeed * cl_movespeedkey, the original's own
//defaults. The run figure exceeds sv_maxspeed (320) on purpose: the move code
//clamps it, which is what makes diagonal movement no faster than straight.
#define QMOVE_SPEED		200.0	//world units per second
#define QMOVE_FAST		400.0
#define QPITCH_LIMIT	89.0
//New Game starts in start.bsp, not the first level. That is how the original
//works: skill is chosen by walking into one of three corridors and the episode
//by entering a slipgate, so the difficulty and episode selection are part of
//the world rather than a menu page.
#define QDEFAULT_MAP	"maps/start.bsp"

//Entities are not in the PVS, so they are range-limited instead. 2000 units
//covers a large room without submitting the whole level's triangles.
#define QENT_DRAW_DIST	2000.0
#define QENT_LIGHT		170		//flat shade until models sample the lightmap

#define QVIEW_HEIGHT	22.0	//eye height above the player origin

//Server tick.
//
//The game clock is driven by the OS jiffy counter (JIFFY_FREQ, 1000Hz), NOT by
//how fast we happen to render. Rendering speed must not change how the world
//behaves: the original runs one server frame per accepted host frame at a
//capped rate, and 72Hz reproduces the cadence its physics and QuakeC timings
//were tuned against.
//
//Jiffies rather than tS because it is the kernel's own monotonic tick - one
//integer increment per millisecond, immune to any frame pacing.
#define QSERVER_HZ			72.0
#define QSERVER_STEP		(1.0 / QSERVER_HZ)
#define QSERVER_MAX_CATCHUP	4

//View-model placement: world-space offsets from the eye, in Quake units.
//
//The view model sits AT the eye, not out in front of it. Its own vertices
//already place the weapon correctly relative to the viewpoint - the original
//copies the view origin straight into the model entity and adds nothing but
//bob. Pushing it forward instead makes it shrink away into the distance and
//read as a world prop lying on the floor.
#define QVM_FORWARD		0.0
#define QVM_RIGHT		0.0
#define QVM_UP			0.0
#define QVM_LIGHT		200		//weapons read brighter than world entities

CQMap		*q_map		= NULL;
CQVisState	*q_vis		= NULL;
CQCanvas	*q_canvas	= NULL;

F64	 q_origin[3];		//player origin, what physics moves
F64	 q_view[3];			//eye position, origin plus the view height
F64	 q_velocity[3];
F64	 q_angles[3];
Bool q_on_ground	= FALSE;
Bool q_noclip		= FALSE;
I64	 q_water_level	= 0;
I64	 q_water_type	= 0;
I64	 q_water_last	= 0;	//water level last frame, for surface crossings
F64	 q_fov			= 90.0;
I64	 q_blit_w		= 320;
I64	 q_blit_h		= 240;
I64	 q_blit_x		= 0;
I64	 q_blit_y		= 0;
Bool q_draw_entities = TRUE;
I64	 q_ent_drawn	= 0;
Bool q_ready		= FALSE;
F64	 q_fps			= 0.0;
I64	 q_frame_count	= 0;

U8 *QMoveModeName()
{
	if (q_noclip)
		return "NOCLIP";
	if (q_on_ground)
		return "ground";

	return "air";
}

U0 QDrawIt(CTask *task, CDC *dc)
{//Runs on the window manager task: copy only, no work.
 //Every pointer this touches is cleared before the owning task frees it, so
 //the guard below is what keeps teardown from pulling memory out from under
 //an in-flight blit.
	if (!q_ready || !q_canvas || !q_vis)
		return;

	QDrawBlitFit(q_canvas, dc, q_blit_x, q_blit_y, q_blit_w, q_blit_h);

	if (q_opt_show_stats)
	{
		dc->color = ColorRGB(255, 255, 0);
		GrPrint(dc, 8, 8, "%3.0f fps  faces %4d  spans %5d",
			q_fps, q_canvas->faces_drawn, q_canvas->spans_drawn);
		GrPrint(dc, 8, 24, "pos %6.0f %6.0f %6.0f  yaw %3.0f  leaf %d  %s",
			q_origin[0], q_origin[1], q_origin[2], q_angles[1],
			q_vis->view_leaf, QMoveModeName);
		GrPrint(dc, 8, 40, "edicts %d  thinks %d  touches %d  t %4.1f",
			q_pr_num_edicts, q_game_thinks, q_player_touches, q_game_time);
		GrPrint(dc, 8, 56, "WASD, space jump, mouse1 attack, 1-8 weapon, ~ console, ESC menu");
	}

	//Health, armor and ammo are deliberately NOT printed here any more. The
	//real status bar draws them inside the canvas from the game's own art, at
	//the game's own resolution, through the game's own palette.
}

U0 QRenderEntities()
{//Brush entities first (they are part of the architecture), then the alias
 //models. Everything is depth tested, so order is a performance detail rather
 //than a correctness one.
	CQEntity *e;
	F64		  dist[3];
	I64		  i;

	q_ent_drawn = 0;

	//Model 0 is the world itself and is already drawn by the PVS path.
	for (i = 0; i < q_num_entities; i++)
	{
		e = &q_entities[i];

		if (e->brush_model > 0)
		{
			QDrawBrushModel(q_canvas, q_map, e->brush_model);
			q_ent_drawn++;
		}
	}

	for (i = 0; i < q_num_entities; i++)
	{
		e = &q_entities[i];

		if (e->mdl)
		{
			//Cheap distance reject before touching the triangles at all.
			QVecSub(e->origin, q_origin, dist);
			if (QVecLength(dist) < QENT_DRAW_DIST)
			{
				QMdlDraw(q_canvas, e->mdl, e->frame, e->origin,
					e->angles[1], QENT_LIGHT);
				q_ent_drawn++;
			}
		}
	}
}

//--- view bob and roll -----------------------------------------------------
//
// Both are cosmetic and VIEW-ONLY. They are applied to a copy of the angles
// used for rendering, never to q_angles itself: that feeds .v_angle, and
// leaning it would make the player's aim lean with the camera.

#define QBOB_AMOUNT		0.02	//bob per unit of horizontal speed
#define QBOB_CYCLE		0.6		//seconds for a full step cycle
#define QBOB_UP			0.5		//fraction of the cycle spent rising
#define QROLL_ANGLE		2.0		//degrees of lean at full strafe
#define QROLL_SPEED		200.0	//strafe speed at which the lean maxes out

F64 q_bob_time = 0.0;

F64 QViewBob()
{//Vertical head movement while walking.
	F64 cycle;
	F64 bob;
	F64 speed;

	//Airborne means no footfalls, so no bob.
	if (!q_on_ground)
		return 0.0;

	q_bob_time = tS;

	cycle = q_bob_time - ToF64(ToI64(q_bob_time / QBOB_CYCLE)) * QBOB_CYCLE;
	cycle /= QBOB_CYCLE;

	//Rise and fall occupy different fractions of the cycle, which is what
	//gives the footstep its uneven, weighted feel.
	if (cycle < QBOB_UP)
		cycle = pi * cycle / QBOB_UP;
	else
		cycle = pi + pi * (cycle - QBOB_UP) / (1.0 - QBOB_UP);

	//Proportional to speed across the ground only - falling must not bob.
	speed = Sqrt(q_velocity[0] * q_velocity[0] +
				 q_velocity[1] * q_velocity[1]);

	bob = speed * QBOB_AMOUNT;
	bob = bob * 0.3 + bob * 0.7 * Sin(cycle);

	if (bob > 4.0)
		bob = 4.0;
	if (bob < -7.0)
		bob = -7.0;

	return bob;
}

F64 QViewRoll(F64 *angles, F64 *velocity)
{//Lean into a strafe, proportional to sideways speed.
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 side;
	F64 sign;

	QAngleVectors(angles, fwd, rgt, upv);
	side = QVecDot(velocity, rgt);

	if (side < 0.0)
	{
		sign = -1.0;
		side = -side;
	}
	else
		sign = 1.0;

	if (side < QROLL_SPEED)
		side = side * QROLL_ANGLE / QROLL_SPEED;
	else
		side = QROLL_ANGLE;

	return side * sign;
}

U0 QLiquidView()
{//Screen wash and view warp for whatever the eye is submerged in, plus the
 //one-shot sounds for crossing the surface.
 //
 //The tint values are the originals': lava burns orange, slime is a dark
 //green, water a murky brown. They are folded into the palette rather than
 //blended per pixel, because 8bpp indices cannot be averaged.
	I64 r = 0;
	I64 g = 0;
	I64 b = 0;
	I64 a = 0;

	//Only a submerged EYE tints the view; wading to the waist does not.
	if (q_water_level >= 3)
	{
		switch (q_water_type)
		{
			case QCONTENTS_LAVA:
				r = 255; g = 80;  b = 0;  a = 150;
				break;
			case QCONTENTS_SLIME:
				r = 0;   g = 25;  b = 5;  a = 150;
				break;
			default:
				r = 130; g = 80;  b = 50; a = 128;
				break;
		}

		q_warp_amount = 4.0;
	}
	else
		q_warp_amount = 0.0;

	q_warp_time = tS;
	QPalSetTint(r, g, b, a);

	//Surface crossings. Compared against the previous frame so each transition
	//fires exactly once rather than every frame while submerged.
	if (q_water_level > 0 && q_water_last == 0)
	{
		if (q_water_type == QCONTENTS_LAVA)
			QSndPlayAt("player/inlava.wav", q_view, 1.0, 0.0);
		else if (q_water_type == QCONTENTS_SLIME)
			QSndPlayAt("player/slimbrn2.wav", q_view, 1.0, 0.0);
		else
			QSndPlayAt("player/inh2o.wav", q_view, 1.0, 0.0);
	}
	else if (q_water_level == 0 && q_water_last > 0)
		QSndPlayAt("misc/outwater.wav", q_view, 1.0, 0.0);

	q_water_last = q_water_level;
}

U0 QRenderFrame()
{//One full frame into the private canvas.
	F64		 forward[3];
	F64		 right[3];
	F64		 up[3];
	F64		 fov_y;
	F64		 vm_org[3];
	F64		 view_angles[3];
	CQMdl	*vm_mdl;

	QAngleVectors(q_angles, forward, right, up);
	fov_y = QDrawFovY(q_fov, q_canvas->width, q_canvas->height);

	//Drives the two sky layers' scroll.
	q_sky_time = tS;

	//The eye rides above the player origin, plus the walk bob.
	//
	//Bob is proportional to horizontal speed and rides a cycle, so it grows
	//with running and stops when standing still. Roll leans the view into a
	//strafe. Both are VIEW-only: they must not touch q_angles, because that
	//feeds v_angle and would make the player's shots lean too.
	QVecCopy(q_origin, q_view);
	q_view[2] += QVIEW_HEIGHT + QViewBob;

	QVecCopy(q_angles, view_angles);
	view_angles[2] = QViewRoll(q_angles, q_velocity);

	//Sounds attenuate from wherever the player is listening.
	QSndListener(q_view);

	//Liquid wash, view warp and surface sounds.
	QLiquidView;

	QDrawClear(q_canvas, 0);
	QDrawSetView(q_canvas, q_view, view_angles, q_fov);
	QVisBuildList(q_vis, q_view, forward, right, up, q_fov, fov_y);
	QDrawWorld(q_canvas, q_map, q_vis);

	if (q_draw_entities)
	{
		//With the VM running, entities come from the QuakeC world. The static
		//list is only used when the bytecode failed to load.
		if (q_game_active)
			QGameDrawEntities(q_canvas, q_map, q_view, QENT_DRAW_DIST);
		else
			QRenderEntities;
	}

	//Particles are depth tested, so they sit correctly among the geometry.
	QPartDraw(q_canvas, tS);

	//The weapon goes last, on top of everything. QuakeC owns which model and
	//which frame, so switching weapons and firing animate for free.
	if (q_player_active && !QPlayerDead)
	{
		vm_mdl = QBiFindModel(QPlayerWeaponModel);
		if (vm_mdl)
		{
			//Placed in the WORLD just in front of the eye and drawn through
			//the ordinary model path, rather than mapped by hand into camera
			//space. The world path is the one every other model already
			//renders correctly through, so the weapon inherits its rotation,
			//clipping and texturing instead of needing its own version of all
			//three.
			//SCREEN-LOCKED, not placed in the world.
			//
			//The original copies the view angles onto the view model entity, so
			//the model turns by exactly the amount the camera turns and the two
			//rotations cancel: the weapon appears welded to the screen and never
			//swings as you aim. Reproducing that by rotating the model and then
			//viewing it through the camera means getting both conventions to
			//agree perfectly - and a sign difference on pitch shows up as the
			//gun tilting when you look up and down.
			//
			//Mapping the model straight into camera space makes the cancellation
			//exact by construction, with no angles involved at all.
			QMdlDrawView(q_canvas, vm_mdl, QPlayerWeaponFrame,
				QVM_FORWARD, QVM_RIGHT, QVM_UP + QViewBob, 1.0, QVM_LIGHT);
		}
	}

	//The status bar goes over everything, including the weapon.
	QSbarDraw(q_canvas);

	//Console last of all, dropped over the top of the finished frame.
	if (q_state == QST_CONSOLE)
		QConDraw(q_canvas);
}

U0 QCenterView(CTask *task)
{//Fit the canvas to the window, preserving aspect ratio and centring the
 //result. Every render resolution therefore fills the same area of screen -
 //raising it adds detail rather than shrinking the picture.
	I64 w = task->pix_width;
	I64 h = task->pix_height;
	I64 cw;
	I64 ch;

	if (!q_canvas)
		return;

	cw = q_canvas->width;
	ch = q_canvas->height;

	//Widest fit that still leaves the height inside the window.
	q_blit_w = w;
	q_blit_h = (w * ch) / cw;

	if (q_blit_h > h)
	{
		q_blit_h = h;
		q_blit_w = (h * cw) / ch;
	}

	if (q_blit_w < 1) q_blit_w = 1;
	if (q_blit_h < 1) q_blit_h = 1;

	q_blit_x = (w - q_blit_w) / 2;
	q_blit_y = (h - q_blit_h) / 2;
}

U0 QApplyVideo()
{//Rebuild the render target at the selected resolution and resize the window.
 //
 //The canvas is read by the compositor through draw_it, so it cannot simply be
 //freed and replaced: the same drain-before-free ordering that teardown needs
 //applies here too, or a resolution change frees memory mid-blit.
	CQCanvas *old;
	I64		  w = q_res_w[q_opt_res];
	I64		  h = q_res_h[q_opt_res];

	q_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);

	old      = q_canvas;
	q_canvas = NULL;
	QDrawFree(old);

	q_canvas = QDrawNew(w, h);

	//Fullscreen fills the display; windowed sizes the window to the render
	//target so it lands close to 1:1 with a little room for the border.
	if (q_opt_fullscreen)
		WinMax;
	else
	{
		WinHorz(2, 2 + (w / FONT_WIDTH));
		WinVert(2, 2 + (h / FONT_HEIGHT));
	}

	QCenterView(Fs);

	Fs->draw_it = &QDrawIt;
	q_res_dirty = FALSE;
}

Bool QLoadMap(U8 *mapname)
{
	I64 ent_count;
	I64 mdl_count;
	U8  line[256];

	if (q_vis)
	{
		QVisFree(q_vis);
		q_vis = NULL;
	}
	if (q_map)
	{
		QBSPFree(q_map);
		q_map = NULL;
	}

	q_map = QBSPLoad(mapname);
	if (!q_map)
		return FALSE;

	q_vis = QVisNew(q_map);

	//Order matters: models resolve against the parsed list, and the spawn
	//point is found in it too. These must not be folded into one print, since
	//argument evaluation order would not guarantee the sequence.
	ent_count = QEntParse(q_map);
	mdl_count = QEntLoadModels;

	StrPrint(line, "map %s: %d entities, %d static models\n",
		mapname, ent_count, mdl_count);
	QLog(line);

	//Bring up the QuakeC world. If the bytecode is unavailable the game falls
	//back to the static entity list, which still renders but never thinks.
	if (QGameInit(q_map))
	{
		StrPrint(line, "QuakeC: %d spawn functions ran, %d edicts live\n",
			q_game_spawned, q_pr_num_edicts);
		QLog(line);
	}
	else
		QLog("QuakeC: FAILED to load - entities will be static\n");

	//Hand the player to QuakeC. PutClientInServer chooses the spawn point, so
	//q_origin is replaced by whatever the game logic decided.
	if (q_game_active)
	{
		if (QPlayerSpawn(q_origin, q_angles))
		{
			StrPrint(line, "player: edict %d, health %3.0f\n",
				q_player_edict, QPlayerHealth);
			QLog(line);
		}
		else
			QLog("player: FAILED to spawn as a client\n");
	}

	//Flushed here, before the window opens, so the load report survives even
	//if the game faults later.
	QLogFlush;
	"Quake: %d entities, %d alias models\n", ent_count, mdl_count;

	QVecSet(q_velocity, 0.0, 0.0, 0.0);
	q_on_ground = FALSE;

	if (!QEntFindPlayerStart(q_map, q_origin, q_angles))
	{
		//No spawn point: fall back to the centre of the world bounds.
		//The centre of the world bounds is very likely inside geometry, so
		//start in noclip rather than trapping the player in a wall.
		"Quake: no info_player_start, using model bounds (noclip on)\n";
		q_noclip = TRUE;
		q_origin[0] = (q_map->models[0].mins[0] + q_map->models[0].maxs[0]) * 0.5;
		q_origin[1] = (q_map->models[0].mins[1] + q_map->models[0].maxs[1]) * 0.5;
		q_origin[2] = (q_map->models[0].mins[2] + q_map->models[0].maxs[2]) * 0.5;
		QVecSet(q_angles, 0.0, 0.0, 0.0);
	}

	//Seed the unstick fallback. Globals are not zeroed here, so leaving this
	//uninitialised would let the first stuck frame warp the player to garbage.
	QVecCopy(q_origin, q_old_origin);

	return TRUE;
}

Bool QChangeLevel(U8 *mapname)
{//Tear the world down and bring up the next map, carrying the player's
 //inventory across. Runs between frames, never inside a think.
	U8 path[96];
	U8 line[160];

	//Ask QuakeC to pack the inventory BEFORE anything is freed.
	QGameSaveParms;

	QGameShutdown;
	QEntFree;

	if (q_vis)
	{
		QVisFree(q_vis);
		q_vis = NULL;
	}
	if (q_map)
	{
		QBSPFree(q_map);
		q_map = NULL;
	}

	//QuakeC passes a bare map name; the archive stores full paths.
	if (!StrNICompare(mapname, "maps/", 5))
		QStrCopy(path, mapname, 96);
	else
		StrPrint(path, "maps/%s.bsp", mapname);

	if (!QLoadMap(path))
	{
		StrPrint(line, "changelevel: %s failed to load\n", path);
		QLog(line);
		return FALSE;
	}

	//Carried-over motion state would otherwise persist into the new level:
	//stale velocity keeps shoving the player, and a stale water level makes
	//the move code swim on dry land - which reads as being frozen in place.
	QVecSet(q_velocity, 0.0, 0.0, 0.0);
	q_water_level  = 0;
	q_water_type   = 0;
	q_on_ground    = FALSE;
	q_world_warned = FALSE;

	if (q_game_active)
		QPlayerSpawn(q_origin, q_angles);

	//The previous map's origin is meaningless here, and the unstick fallback
	//would otherwise drag the player back to it.
	QVecCopy(q_origin, q_old_origin);

	StrPrint(line, "changelevel: spawned at %.0f %.0f %.0f\n",
		q_origin[0], q_origin[1], q_origin[2]);
	QLog(line);

	StrPrint(line, "changelevel -> %s\n", path);
	QLog(line);
	QConPrint(line);
	QLogFlush;

	return TRUE;
}

U0 QGameLoop()
{
	F64  forward[3];
	F64  right[3];
	F64  up[3];
	F64  move[3];
	F64  speed;
	F64  now;
	F64  last;
	F64  dt;
	F64  fps_time;
	I64  sc_w		= Char2ScanCode('w');
	I64  sc_a		= Char2ScanCode('a');
	I64  sc_s		= Char2ScanCode('s');
	I64  sc_d		= Char2ScanCode('d');
	I64  sc_jump	= Char2ScanCode(' ');	//no SC_SPACE define exists
	I64  sc_tilde	= Char2ScanCode('`');
	I64  dx;
	I64  dy;
	I64  fps_frames   = 0;
	I64  impulse      = 0;
	I64  i            = 0;
	I64  menu_sc      = 0;
	I64  last_menu_sc = 0;
	Bool attack       = FALSE;
	Bool esc_held     = FALSE;
	Bool start_game   = FALSE;
	Bool tilde_held   = FALSE;
	F64  srv_accum    = 0.0;
	I64  srv_steps    = 0;

	//Game time comes from the kernel tick, not from frame timing.
	last     = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
	fps_time = last;

	while (TRUE)
	{
		now  = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
		dt   = now - last;
		last = now;

		//A long stall (first frame, or a map load) must not launch the camera.
		if (dt > 0.1)
			dt = 0.1;

		//Video changes are serviced FIRST, before any state branch can jump
		//past them: the menu path ends in a goto to the bottom of the loop,
		//and the menu is exactly where they are requested.
		if (q_res_dirty)
			QApplyVideo;

		//--- tilde drops the console, as in the original ---
		if (Bt(kbd.down_bitmap, sc_tilde))
		{
			if (!tilde_held)
			{
				tilde_held = TRUE;

				if (q_state == QST_CONSOLE)
					q_state = QST_PLAYING;
				else if (q_state == QST_PLAYING)
				{
					q_state = QST_CONSOLE;

					//Clear edge state, or keys held as the console opens
					//register as fresh presses.
					QConInputReset;
				}
			}
		}
		else
			tilde_held = FALSE;

		//--- ESC toggles the menu; quitting is a menu choice ---
		if (Bt(kbd.down_bitmap, SC_ESC))
		{
			if (!esc_held)
			{
				esc_held = TRUE;

				if (q_state == QST_PLAYING)
					q_state = QST_MENU;
				else if (q_menu_page != QPAGE_MAIN)
					q_menu_page = QPAGE_MAIN;	//back out of a submenu first
				else if (q_menu_ingame)
					q_state = QST_PLAYING;
			}
		}
		else
			esc_held = FALSE;

		//--- console: typing owns the keyboard, world keeps running ---
		if (q_state == QST_CONSOLE)
		{
			QConInput;

			if (q_con_want_noclip)
			{
				q_noclip = !q_noclip;
				QVecSet(q_velocity, 0.0, 0.0, 0.0);
				q_con_want_noclip = FALSE;
			}

			if (q_con_want_quit)
				break;

			QPartUpdate(dt, tS);
			QCenterView(Fs);
			QRenderFrame;
			q_ready = TRUE;

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//--- menu: no world simulation, just navigation ---
		if (q_state == QST_MENU)
		{
			menu_sc = 0;
			if (Bt(kbd.down_bitmap, SC_CURSOR_UP))		menu_sc = SC_CURSOR_UP;
			if (Bt(kbd.down_bitmap, SC_CURSOR_DOWN))	menu_sc = SC_CURSOR_DOWN;
			if (Bt(kbd.down_bitmap, SC_CURSOR_LEFT))	menu_sc = SC_CURSOR_LEFT;
			if (Bt(kbd.down_bitmap, SC_CURSOR_RIGHT))	menu_sc = SC_CURSOR_RIGHT;
			if (Bt(kbd.down_bitmap, SC_ENTER))			menu_sc = SC_ENTER;

			//Edge trigger, or a held arrow runs the whole list.
			if (menu_sc && menu_sc != last_menu_sc)
			{
				if (QMenuKey(menu_sc, &start_game))
				{
					if (start_game)
					{
						q_menu_ingame = TRUE;
						q_state       = QST_PLAYING;
					}
				}
			}
			last_menu_sc = menu_sc;

			if (q_quit_request)
				break;

			QMenuDraw(q_canvas);
			QCenterView(Fs);
			q_ready = TRUE;

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//--- mouse: read deltas AND buttons before the reset clears them ---
		dx     = mouse_hard.raw_data.x;
		dy     = mouse_hard.raw_data.y;
		attack = ToBool(mouse_hard.raw_bttns[0]);
		MouseRawReset;

		q_angles[1] -= ToF64(dx) * q_opt_sensitivity;
		q_angles[0] += ToF64(dy) * q_opt_sensitivity;

		if (q_angles[0] > QPITCH_LIMIT)
			q_angles[0] = QPITCH_LIMIT;
		if (q_angles[0] < -QPITCH_LIMIT)
			q_angles[0] = -QPITCH_LIMIT;

		q_angles[1] = QAngleNorm(q_angles[1]);

		//Number keys request a weapon switch. QuakeC consumes an impulse once.
		impulse = 0;
		for (i = 1; i <= 8; i++)
		{
			if (Bt(kbd.down_bitmap, Char2ScanCode('0' + i)))
				impulse = i;
		}

		//--- movement wish direction ---
		QAngleVectors(q_angles, forward, right, up);
		QVecSet(move, 0.0, 0.0, 0.0);

		if (Bt(kbd.down_bitmap, sc_w))
			QVecAdd(move, forward, move);
		if (Bt(kbd.down_bitmap, sc_s))
			QVecSub(move, forward, move);
		if (Bt(kbd.down_bitmap, sc_d))
			QVecAdd(move, right, move);
		if (Bt(kbd.down_bitmap, sc_a))
			QVecSub(move, right, move);

		//Run by default, shift to walk. The original ships the opposite way
		//round, but its own default config raises cl_forwardspeed to the run
		//figure, so always-running IS how the game is played.
		if (Bt(kbd.down_bitmap, SC_SHIFT))
			speed = QMOVE_SPEED;
		else
			speed = QMOVE_FAST;

		if (q_noclip)
		{
			//Free flight, for getting unstuck and inspecting geometry.
			QVecSet(q_velocity, 0.0, 0.0, 0.0);
			if (QVecLength(move) > 0.0)
			{
				QVecNormalize(move);
				QVecMA(q_origin, speed * dt, move, q_origin);
			}
		}
		else
		{
			q_water_level = QWaterLevelGet(q_map, q_origin, &q_water_type);
			QPlayerWater(q_water_level, q_water_type);

			//Out of water the wish direction is flattened so looking up does
			//not drive the player into the floor. Swimming keeps the vertical
			//component, which is how looking up makes you rise.
			if (q_water_level < 2)
				move[2] = 0.0;

			if (QVecLength(move) > 0.0)
				QVecNormalize(move);
		}

		//--- server frames at a FIXED rate ---
		//
		//The original caps its host loop and runs exactly ONE server frame per
		//accepted frame, so PreThink, the move and PostThink all advance at a
		//bounded, consistent rate. Driving them at render rate instead (190Hz
		//here) over-runs everything by nearly 3x: jumps integrate differently,
		//and anything QuakeC does per-call happens far too often.
		//
		//So the server steps at a fixed interval and rendering runs free. The
		//catch-up is capped, or a stall would fire a burst of frames at once.
		srv_accum += dt;
		srv_steps  = 0;

		while (srv_accum >= QSERVER_STEP && srv_steps < QSERVER_MAX_CATCHUP)
		{
			//Before anything else, make sure the player is not embedded in
			//solid. A teleport or a door can leave them there, and the slide
			//move alone can never recover from it.
			//Tell the collision code which edict is doing the moving, so the
			//player's own box is not treated as an obstacle by their own move.
			q_move_pass = q_player_edict;

			if (!q_noclip && q_map)
				QCheckStuck(q_map, q_origin);

			if (q_game_active)
			{
				QPlayerPreThink(q_origin, q_velocity, q_angles, q_on_ground,
					attack, ToBool(Bt(kbd.down_bitmap, sc_jump)), impulse);

				//QuakeC owns jumping while the VM is live: PlayerJump has
				//already set the vertical velocity during pre-think.
				if (!q_noclip)
					QPlayerMove(q_map, q_origin, q_velocity, move, speed,
						FALSE, QSERVER_STEP, &q_on_ground, q_water_level,
						QPlayerWaterJump(q_velocity, q_game_time));

				QGameFrame(QSERVER_STEP);
				QPlayerTouchTriggers(q_origin, q_velocity);
				QPlayerPostThink(q_origin, q_velocity, q_angles);
			}
			else if (!q_noclip)
			{
				//No bytecode loaded, so the engine owns jumping.
				QPlayerMove(q_map, q_origin, q_velocity, move, speed,
					ToBool(Bt(kbd.down_bitmap, sc_jump)), QSERVER_STEP,
					&q_on_ground, q_water_level, FALSE);
			}

			srv_accum -= QSERVER_STEP;
			srv_steps++;
		}

		//A long stall must not leave a backlog that replays later.
		if (srv_accum > QSERVER_STEP)
			srv_accum = 0.0;

		//Particles age on the render clock, not the game clock.
		QPartUpdate(dt, tS);

		QCenterView(Fs);
		QRenderFrame;
		q_ready = TRUE;

		q_frame_count++;
		fps_frames++;
		if (now - fps_time >= 0.5)
		{
			q_fps      = ToF64(fps_frames) / (now - fps_time);
			fps_frames = 0;
			fps_time   = now;
		}

		//A level change is requested from inside a think, so it is serviced
		//here, between frames, once nothing is executing.
		if (q_change_pending)
		{
			q_change_pending = FALSE;
			QChangeLevel(q_change_map);
		}

		LBts(&Fs->task_flags, TASKf_IDLE);
		Yield;
		LBtr(&Fs->task_flags, TASKf_IDLE);

ql_next_frame:
	}
}

U0 Quake(U8 *mapname = QDEFAULT_MAP)
{
	CQCanvas	*canvas			= NULL;
	CQVisState	*vis			= NULL;
	CQMap		*map			= NULL;
	Bool		 raw_was_on		= FALSE;
	Bool		 final_active	= FALSE;
	I64			 final_edicts	= 0;
	I64			 final_thinks	= 0;
	I64			 final_models	= 0;
	I64			 final_snd		= 0;
	I64			 final_drop		= 0;
	I64			 final_move_ok	= 0;
	I64			 final_move_fail = 0;
	I64			 final_errors	= 0;
	F64			 final_time		= 0.0;
	U8			 line[256];

	QLogReset;

	QPakInit;
	QSndInit;
	QPartInit;
	QClipInit;

	if (!QPakMount("::/Apps/Quake/id1/PAK0.PAK"))
	{
		"Quake: PAK0.PAK not found. See ::/Apps/Quake/README.md\n";
		return;
	}

	if (!QPalLoad)
	{
		"Quake: palette load failed\n";
		return;
	}

	//Interface art: gfx.wad (status bar, digits, icons, font) plus the
	//standalone gfx/*.lmp menu pictures.
	QWadInit;
	QSbarInit;
	QMenuInit;

	if (!QLoadMap(mapname))
	{
		"Quake: could not load %s\n", mapname;
		return;
	}

	q_canvas = QDrawNew(q_res_w[q_opt_res], q_res_h[q_opt_res]);
	q_ready  = FALSE;

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		AutoComplete;
		WinBorder;
		WinMax;
		DocCursor;
		DocClear;

		QCenterView(Fs);

		//Raw mode gives relative deltas and stops clicks reaching the window
		//manager. It must be turned back off on every exit path.
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;

		Fs->draw_it = &QDrawIt;

		QGameLoop;
	}
	catch
		PutExcept;

	//--- teardown ---
	//QDrawIt runs on the window manager task and the blit is long, so the
	//compositor is very often executing inside it. Detaching the callback is
	//NOT enough on its own: an already-entered QDrawIt keeps running. So stop
	//it drawing, detach, let the in-flight call drain, and only then free.
	q_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(100);

	//Clear each global before releasing it, so even a late QDrawIt sees NULL
	//rather than a dangling pointer.
	canvas   = q_canvas;
	q_canvas = NULL;
	vis      = q_vis;
	q_vis    = NULL;
	map      = q_map;
	q_map    = NULL;

	if (!raw_was_on)
		MouseRaw(FALSE);

	SettingsPop;
	MenuPop;

	//Capture the VM stats before shutdown clears them. Startup messages are
	//wiped by DocClear when the window opens, so this summary printed after
	//the game exits is the only way to actually read them.
	final_active  = q_game_active;
	final_edicts  = q_pr_num_edicts;
	final_thinks  = q_game_thinks;
	final_time    = q_game_time;
	final_models  = q_precache_model_count;

	final_snd      = q_snd_played;
	final_drop     = q_snd_dropped;
	final_move_ok  = q_move_ok;
	final_move_fail = q_move_fail;
	final_errors    = q_pr_errors;

	//Teardown is breadcrumbed and flushed after every step. This has crashed
	//twice and been mis-diagnosed twice, so the log is written as we go: the
	//LAST line in QUAKELOG.TXT names the step that was running when it died,
	//which turns an opaque fault into a one-line answer.
	QLog("teardown: begin\n");
	QLogFlush;

	//The QuakeC world holds precached models and points at the map, so it is
	//torn down before the map itself.
	QGameShutdown;
	QLog("teardown: QGameShutdown ok\n");
	QLogFlush;

	QSndFree;
	QLog("teardown: QSndFree ok\n");
	QLogFlush;

	//Entities hold alias models that borrow nothing from the map, but they are
	//released first so nothing outlives the map it was spawned from.
	QEntFree;
	QLog("teardown: QEntFree ok\n");
	QLogFlush;

	QDrawFree(canvas);
	QLog("teardown: QDrawFree ok\n");
	QLogFlush;

	QVisFree(vis);
	QLog("teardown: QVisFree ok\n");
	QLogFlush;

	QBSPFree(map);
	QLog("teardown: QBSPFree ok\n");
	QLogFlush;

	StrPrint(line, "exit: %d frames rendered\n", q_frame_count);
	QLog(line);

	if (final_active)
	{
		StrPrint(line, "QuakeC: %d edicts, %d models precached\n",
			final_edicts, final_models);
		QLog(line);
		StrPrint(line, "QuakeC: %d thinks over %4.1f s of game time\n",
			final_thinks, final_time);
		QLog(line);

		//Only four mixer streams exist, so drops are expected in a firefight.
		//A zero played count means the audio path never worked at all.
		StrPrint(line, "sound: %d played, %d dropped (4 streams)\n",
			final_snd, final_drop);
		QLog(line);

		//Which way this leans says what is wrong with the monsters: mostly
		//failures means legal moves are being refused, mostly successes means
		//they are moving happily in the wrong direction.
		StrPrint(line, "monster moves: %d ok, %d blocked\n",
			final_move_ok, final_move_fail);
		QLog(line);

		//Total VM errors, including the ones the console suppressed. A large
		//number here with a healthy think count means errors are being
		//survived; a large number with a low think count means they are not.
		StrPrint(line, "QuakeC errors: %d\n", final_errors);
		QLog(line);

		//Spawning but never thinking is a different fault from failing to
		//spawn at all, so it is called out rather than left to be inferred.
		if (final_thinks == 0)
			QLog("QuakeC: WARNING - nothing ever thought. Check nextthink.\n");
	}
	else
		QLog("QuakeC: did not load - entities were static\n");

	QLogFlush;
	"\nLog written to ::/Apps/Quake/QUAKELOG.TXT\n";
}
