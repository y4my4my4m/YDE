// Quake.ZC - application shell: window, input, frame loop.
//
// Rendering happens on this task and the blit happens in the draw_it callback
// on the window manager task. That callback must never block (it drives the
// whole compositor), so it only ever copies pixels.

//cl_forwardspeed and cl_forwardspeed * cl_movespeedkey, the original's own
//defaults. The run figure exceeds sv_maxspeed (320) on purpose: the move code
//clamps it, which is what makes diagonal movement no faster than straight.
#define QMOVE_SPEED		200.0	//world units per second
#define QMOVE_FAST		400.0
#define QPITCH_LIMIT	89.0
//New Game starts in start.bsp, not the first level. That is how the original
//works: skill is chosen by walking into one of three corridors and the episode
//by entering a slipgate, so the difficulty and episode selection are part of
//the world rather than a menu page.
#define QDEFAULT_MAP	"maps/start.bsp"

//Entities are not in the PVS, so they are range-limited instead. 2000 units
//covers a large room without submitting the whole level's triangles.
#define QENT_DRAW_DIST	2000.0
#define QENT_LIGHT		170		//flat shade until models sample the lightmap

#define QVIEW_HEIGHT	22.0	//eye height above the player origin

//Server tick.
//
//The game clock is driven by the OS jiffy counter (JIFFY_FREQ, 1000Hz), NOT by
//the render rate. Rendering speed must not change how the world
//behaves: the original runs one server frame per accepted host frame at a
//capped rate, and 72Hz reproduces the cadence its physics and QuakeC timings
//were tuned against.
//
//Jiffies rather than tS because it is the kernel's own monotonic tick - one
//integer increment per millisecond, immune to any frame pacing.
#define QSERVER_HZ			72.0
#define QSERVER_STEP		(1.0 / QSERVER_HZ)
#define QSERVER_MAX_CATCHUP	4

//View-model placement: world-space offsets from the eye, in Quake units.
//
//The view model sits AT the eye, not out in front of it. Its own vertices
//already place the weapon correctly relative to the viewpoint - the original
//copies the view origin straight into the model entity and adds nothing but
//bob. Pushing it forward instead makes it shrink away into the distance and
//read as a world prop lying on the floor.
#define QVM_FORWARD		0.0
#define QVM_RIGHT		0.0
#define QVM_UP			0.0
#define QVM_LIGHT		200		//weapons read brighter than world entities

//q_map declared in QBSP.ZC (needed by QNetSv before this file).
CQVisState	*q_vis		= NULL;
CQCanvas	*q_canvas	= NULL;

F64	 q_origin[3];		//player origin, what physics moves
F64	 q_view[3];			//eye position, origin plus the view height
F64	 q_velocity[3];
F64	 q_angles[3];
Bool q_on_ground	= FALSE;
Bool q_noclip		= FALSE;
I64	 q_water_level	= 0;
I64	 q_water_type	= 0;
I64	 q_water_last	= 0;	//water level last frame, for surface crossings
F64	 q_fov			= 90.0;
I64	 q_blit_w		= 320;
I64	 q_blit_h		= 240;
I64	 q_blit_x		= 0;
I64	 q_blit_y		= 0;
Bool q_draw_entities = TRUE;
I64	 q_ent_drawn	= 0;
Bool q_ready		= FALSE;
F64	 q_fps			= 0.0;
I64	 q_frame_count	= 0;

Bool q_loading = FALSE;		//SCR_BeginLoadingPlaque / scr_drawloading

U0 QDrawIt(CTask *task, CDC *dc)
{//Runs on the window manager task: copy only, no work.
 //Every pointer this touches is cleared before the owning task frees it, so
 //the guard below is what keeps teardown from pulling memory out from under
 //an in-flight blit.
	//A map load BLOCKS the game task, so the frame loop cannot paint the
	//plaque itself - but this runs on the window manager task and keeps going
	//throughout. q_vis is NULL for the whole load, which is exactly why the
	//check below would otherwise leave the previous level frozen on screen.
	if (q_loading && q_ready && q_canvas)
	{
		QDrawBlitFit(q_canvas, dc, q_blit_x, q_blit_y, q_blit_w, q_blit_h);
		return;
	}

	if (!q_ready || !q_canvas || !q_vis)
		return;

	QDrawBlitFit(q_canvas, dc, q_blit_x, q_blit_y, q_blit_w, q_blit_h);


	//Health, armor and ammo are deliberately NOT printed here any more. The
	//real status bar draws them inside the canvas from the game's own art, at
	//the game's own resolution, through the game's own palette.
}

U0 QRenderEntities()
{//Brush entities first (they are part of the architecture), then the alias
 //models. Everything is depth tested, so order is a performance detail rather
 //than a correctness one.
	CQEntity *e;
	F64		  dist[3];
	I64		  i;

	q_ent_drawn = 0;

	//Model 0 is the world itself and is already drawn by the PVS path.
	for (i = 0; i < q_num_entities; i++)
	{
		e = &q_entities[i];

		if (e->brush_model > 0)
		{
			QDrawBrushModel(q_canvas, q_map, e->brush_model, e->origin);
			q_ent_drawn++;
		}
	}

	for (i = 0; i < q_num_entities; i++)
	{
		e = &q_entities[i];

		if (e->mdl)
		{
			//Cheap distance reject before touching the triangles at all.
			QVecSub(e->origin, q_origin, dist);
			if (QVecLength(dist) < QENT_DRAW_DIST)
			{
				QMdlDraw(q_canvas, e->mdl, e->frame, e->origin,
					e->angles[1], QLightPoint(q_map, e->origin));
				q_ent_drawn++;
			}
		}
	}
}

//--- stuck detector --------------------------------------------------------
//
// "I get stuck and nothing is in the log" needs its own signal. Wanting to move
// and not moving is measurable: if the player is asking for motion and the
// origin has not changed across several server steps, something is refusing the
// move, and the interesting part is WHAT.
#define QSTUCK_STEPS	12		//consecutive refused steps before reporting
#define QSTUCK_REPORTS	4

F64 q_stuck_org[3];
I64 q_stuck_steps	= 0;
I64 q_stuck_said	= 0;
U8  q_stuck_line[192];

U0 QStuckInit()
{
	QVecSet(q_stuck_org, 0.0, 0.0, 0.0);
	q_stuck_steps = 0;
	q_stuck_said  = 0;
}

U0 QStuckCheck(F64 *wishdir, F64 wishspeed)
{//Called once per server step, after the move.
	F64		d[3];
	F64		probe[3];
	CQTrace	tr;
	I64		blocker;

	//Not trying to go anywhere, so standing still is correct.
	if (wishspeed <= 0.0 ||
		(wishdir[0] == 0.0 && wishdir[1] == 0.0 && wishdir[2] == 0.0))
	{
		q_stuck_steps = 0;
		QVecCopy(q_origin, q_stuck_org);
		return;
	}

	QVecSub(q_origin, q_stuck_org, d);

	if (QVecLength(d) > 0.5)
	{
		q_stuck_steps = 0;
		QVecCopy(q_origin, q_stuck_org);
		return;
	}

	q_stuck_steps++;

	if (q_stuck_steps != QSTUCK_STEPS || q_stuck_said >= QSTUCK_REPORTS)
		return;

	//Walking straight into a wall legitimately does not move the player, so a
	//refused move is only interesting when the sweep is CLEAR. Reporting the
	//blocked case as well made the detector fire constantly against ordinary
	//geometry and buried the cases that matter.
	QVecMA(q_origin, 4.0, wishdir, probe);
	QTracePlayer(q_map, q_origin, probe, &tr);

	if (tr.fraction < 1.0)
	{
		//Something really is in the way - a wall, a door, a button. Standing
		//against it and not moving is correct, not stuck, so this is not worth
		//a line either way. Only a REFUSED move with a clear sweep is a bug.
		q_stuck_steps = 0;
		return;
	}

	q_stuck_said++;

	blocker = -1;
	if (q_game_active && q_player_edict > 0)
		blocker = QTestEntityPosition(q_map, q_player_edict);

	StrPrint(q_stuck_line,
		"stuck: at %.0f %.0f %.0f vel %.0f %.0f %.0f ground=%d water=%d\n",
		q_origin[0], q_origin[1], q_origin[2],
		q_velocity[0], q_velocity[1], q_velocity[2],
		q_on_ground, q_water_level);
	QLog(q_stuck_line);

	if (blocker < 0)
		QLog("stuck: player position is CLEAR - the move is being refused\n");
	else if (blocker == 0)
		QLog("stuck: player is embedded in the WORLD\n");
	else
	{
		StrPrint(q_stuck_line, "stuck: embedded in edict %d (%s)\n", blocker,
			QPrStr(QPrFieldI(blocker, q_fld_classname)));
		QLog(q_stuck_line);
	}

	//Knowing the position is clear is not enough - the question is what stops
	//the SWEEP. Repeat the move the player is asking for and report the trace
	//that refuses it: how far it got, the plane it hit, and which entity owns
	//that plane (-1 being the world).
	QVecMA(q_origin, 4.0, wishdir, probe);
	QTracePlayer(q_map, q_origin, probe, &tr);

	StrPrint(q_stuck_line,
		"stuck: probe frac=%.3f solid=%d/%d hit=%d ent=%d n=%.2f %.2f %.2f\n",
		tr.fraction, tr.all_solid, tr.start_solid, tr.hit, tr.ent,
		tr.plane_normal[0], tr.plane_normal[1], tr.plane_normal[2]);
	QLog(q_stuck_line);

	if (tr.ent > 0)
	{
		StrPrint(q_stuck_line, "stuck: blocked by edict %d (%s) solid=%d\n",
			tr.ent, QPrStr(QPrFieldI(tr.ent, q_fld_classname)),
			ToI64(QPrFieldF(tr.ent, q_fld_solid)));
		QLog(q_stuck_line);

		//The blocker's OWN geometry, so a phantom collision is provable rather
		//than inferred. If the player is nowhere near these bounds then the
		//trace is being run against the wrong submodel, and the brush number it
		//resolved to is printed for exactly that comparison.
		StrPrint(q_stuck_line,
			"stuck:   bmodel=%d org %.0f %.0f %.0f  mins %.0f %.0f %.0f  maxs %.0f %.0f %.0f\n",
			QClipBrushModel(ToI64(QPrFieldF(tr.ent, q_fld_modelindex))),
			QPrFieldF(tr.ent, q_fld_origin + 0),
			QPrFieldF(tr.ent, q_fld_origin + 1),
			QPrFieldF(tr.ent, q_fld_origin + 2),
			QPrFieldF(tr.ent, q_fld_mins + 0),
			QPrFieldF(tr.ent, q_fld_mins + 1),
			QPrFieldF(tr.ent, q_fld_mins + 2),
			QPrFieldF(tr.ent, q_fld_maxs + 0),
			QPrFieldF(tr.ent, q_fld_maxs + 1),
			QPrFieldF(tr.ent, q_fld_maxs + 2));
		QLog(q_stuck_line);
	}

	QLogFlush;
}

//--- cshifts ----------------------------------------------------------------
//
// V_UpdatePalette blends FOUR independent colour shifts into the palette, not
// one. Only the liquid one was wired up here, so taking damage, picking
// something up and holding a powerup all looked identical - nothing happened.
//
//   CONTENTS - what the eye is submerged in (already handled by QLiquidView)
//   DAMAGE   - red, driven by how much was just taken, decaying at 150/sec
//   BONUS    - the pale yellow item-pickup flash, decaying at 100/sec
//   POWERUP  - held item: quad blue, invulnerability red, suit green
//
// Each is a destination colour plus a percentage, and they are applied in
// sequence so a hit while underwater reads as both.
#define QCS_DAMAGE_RATE		150.0
#define QCS_BONUS_RATE		100.0

//Powerup bits from the original's defs.qc.
//
//These were wrong, and wrong in the worst possible way: 4096 is IT_AXE, which
//the player ALWAYS has, so the invulnerability tint was applied on every single
//frame and the screen simply stayed red once anything tinted it.
//
//    IT_AXE             4096
//    IT_SUPERHEALTH    16384
//    IT_KEY1          131072
//    IT_KEY2          262144
//    IT_INVISIBILITY  524288
//    IT_INVULNERABILITY 1048576
//    IT_SUIT          2097152
//    IT_QUAD          4194304
#define QIT_INVISIBILITY	524288
#define QIT_INVULNERABILITY	1048576
#define QIT_SUIT			2097152
#define QIT_QUAD			4194304

F64 q_cs_dmg_pct	= 0.0;
F64 q_cs_bonus_pct	= 0.0;

U0 QCShiftInit()
{
	q_cs_dmg_pct   = 0.0;
	q_cs_bonus_pct = 0.0;
}

U0 QCShiftDamage(F64 count)
{//V_ParseDamage: percent += 3*count, clamped to 150.
	q_cs_dmg_pct += 3.0 * count;

	if (q_cs_dmg_pct < 0.0)
		q_cs_dmg_pct = 0.0;
	if (q_cs_dmg_pct > 150.0)
		q_cs_dmg_pct = 150.0;
}

U0 QCShiftBonus()
{//V_BonusFlash: the pickup flash is a fixed colour at 50 percent.
	q_cs_bonus_pct = 50.0;
}

U0 QCShiftUpdate(F64 dt)
{//Decay both flashes. The original uses host_frametime for exactly this.
	q_cs_dmg_pct -= dt * QCS_DAMAGE_RATE;
	if (q_cs_dmg_pct < 0.0)
		q_cs_dmg_pct = 0.0;

	q_cs_bonus_pct -= dt * QCS_BONUS_RATE;
	if (q_cs_bonus_pct < 0.0)
		q_cs_bonus_pct = 0.0;
}

U0 QCShiftBlend(I64 *_r, I64 *_g, I64 *_b, I64 *_a)
{//Fold the damage, bonus and powerup shifts on top of whatever the liquid
 //shift already produced, and hand back a single tint.
 //
 //Blended in place rather than summed: each shift moves the running colour a
 //percentage of the way towards its own, which is what V_UpdatePalette does
 //when it accumulates them one after another.
	F64 r = ToF64(*_r);
	F64 g = ToF64(*_g);
	F64 b = ToF64(*_b);
	F64 a = ToF64(*_a);
	I64 items = 0;
	F64 pct;

	//V_CalcPowerupCshift reads cl.items, which svc_clientdata carries every
	//frame. Reading the server's edict instead left every powerup tint dead
	//during playback and on a remote client, where no such edict exists.
	if (QClientMode)
		items = q_cl.items;
	else if (q_player_active && q_player_edict > 0 && q_fld_items >= 0)
		items = ToI64(QPrFieldF(q_player_edict, q_fld_items));

	//Powerups first, so a hit taken while quadded still reads red on top.
	//
	//ONE shift, not several: V_CalcPowerupCshift is an if/else chain, and the
	//order below is its order. Invulnerability is yellow (255 255 0), not red -
	//the red seen when taking the pentagram is the DAMAGE shift, which
	//is a separate one applied after this.
	pct = 0.0;
	if (items & QIT_QUAD)
	{
		b = b + (255.0 - b) * 0.30;  r = r * 0.70;  g = g * 0.70;
		pct = 30.0;
	}
	else if (items & QIT_SUIT)
	{
		g = g + (255.0 - g) * 0.20;  r = r * 0.80;  b = b * 0.80;
		pct = 20.0;
	}
	else if (items & QIT_INVISIBILITY)
	{
		//100 percent: the ring washes the whole screen to flat grey.
		r = 100.0;  g = 100.0;  b = 100.0;
		pct = 100.0;
	}
	else if (items & QIT_INVULNERABILITY)
	{
		r = r + (255.0 - r) * 0.30;
		g = g + (255.0 - g) * 0.30;
		b = b * 0.70;
		pct = 30.0;
	}

	if (pct > a)
		a = pct;

	//The pickup flash: 215 186 69.
	if (q_cs_bonus_pct > 0.0)
	{
		pct = q_cs_bonus_pct / 100.0;
		r   = r + (215.0 - r) * pct;
		g   = g + (186.0 - g) * pct;
		b   = b + (69.0  - b) * pct;
		if (q_cs_bonus_pct > a)
			a = q_cs_bonus_pct;
	}

	//Damage last and reddest.
	if (q_cs_dmg_pct > 0.0)
	{
		pct = q_cs_dmg_pct / 100.0;
		if (pct > 1.0)
			pct = 1.0;
		r = r + (255.0 - r) * pct;
		g = g * (1.0 - pct);
		b = b * (1.0 - pct);
		if (q_cs_dmg_pct > a)
			a = q_cs_dmg_pct;
	}

	if (a > 255.0)
		a = 255.0;

	*_r = ClampI64(ToI64(r), 0, 255);
	*_g = ClampI64(ToI64(g), 0, 255);
	*_b = ClampI64(ToI64(b), 0, 255);
	*_a = ClampI64(ToI64(a), 0, 255);
}

//--- weapon punch and damage kick ------------------------------------------
//
// Two separate effects, both VIEW-ONLY and applied to a copy of the angles:
//
//   punchangle - QuakeC sets .punchangle when a weapon fires (the shotgun uses
//                -2 pitch), giving the recoil snap.
//   damage kick - V_ParseDamage turns a hit into a roll and pitch kick whose
//                direction depends on where the damage came from, so being shot
//                from the left throws the view differently than from the front.
//
// The original's own cvar defaults for the kick.
#define QKICK_ROLL		0.6
#define QKICK_PITCH		0.6
#define QKICK_TIME		0.5

F64 q_dmg_roll		= 0.0;
F64 q_dmg_pitch		= 0.0;
F64 q_dmg_time		= 0.0;
F64 q_punch[3];
F64 q_dmg_last		= 0.0;	//dmg_take+dmg_save seen last frame
I64 q_con_return_state = QST_PLAYING;	//state the console was opened from

//Entities whose reconstructed client state disagreed with the server's world on
//the last tick. Should be 0; anything else is an encode or decode fault.
I64 q_net_mismatch = 0;

//When the last connection request went out, so it can be repeated.
F64 q_join_last_try = 0.0;
U8  q_join_line[96];
F64 q_heap_check_last = 0.0;
U8  q_heap_check_line[48];

F64 q_tick_log_last = 0.0;
I64 q_tick_log_n    = 0;
U8  q_tick_line[160];

U0 QViewKickInit()
{
	q_dmg_roll  = 0.0;
	q_dmg_pitch = 0.0;
	q_dmg_time  = 0.0;
	q_dmg_last  = 0.0;
	QVecSet(q_punch, 0.0, 0.0, 0.0);
}

U0 QViewKickUpdate(F64 dt)
{//Pick up a new punch or hit, and decay what is already running.
	F64 from[3];
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 dir[3];
	F64 take;
	F64 count;
	F64 side;
	F64 len;
	I64 inflictor;
	I64 items;
	I64 j;

	if (!q_player_active || q_player_edict <= 0)
	{
		QViewKickInit;
		return;
	}

	//--- weapon punch ---
	//
	//Read straight off the edict, with no local decay or latching: the field
	//IS the current kick. DropPunchAngle shortens it every client think, which
	//is where the recovery happens, so a fresh shot simply overwrites it and
	//every weapon kicks the same way.
	if (q_fld_punchangle >= 0)
	{
		for (j = 0; j < 3; j++)
			q_punch[j] = QPrFieldF(q_player_edict, q_fld_punchangle + j);
	}

	//--- damage kick ---
	//
	//Thin client: QuakeC never writes local dmg_take. svc_damage parks the hit
	//in q_net_damage_* (V_ParseDamage's inputs) - honour that here.
	if (q_net_damage_pending)
	{
		count = ToF64(q_net_damage_take) + ToF64(q_net_damage_save);
		if (count < 10.0)
			count = 10.0;
		if (count > 255.0)
			count = 255.0;

		QCShiftDamage(count);

		QVecSub(q_net_damage_from, q_origin, dir);
		len = QVecLength(dir);
		if (len > 0.0)
		{
			QVecScale(dir, 1.0 / len, dir);
			QAngleVectors(q_angles, fwd, rgt, upv);
			side        = QVecDot(dir, rgt);
			q_dmg_roll  = count * side * QKICK_ROLL;
			side        = QVecDot(dir, fwd);
			q_dmg_pitch = count * side * QKICK_PITCH;
			q_dmg_time  = QKICK_TIME;
		}

		q_net_damage_pending = FALSE;
		q_net_damage_take    = 0;
		q_net_damage_save    = 0;
	}
	else if (q_fld_dmg_take >= 0 && q_fld_dmg_save >= 0)
	{
		count = QPrFieldF(q_player_edict, q_fld_dmg_take) +
				QPrFieldF(q_player_edict, q_fld_dmg_save);

		//Only a CHANGE counts as a fresh hit; the fields persist between frames.
		if (count > 0.0 && count != q_dmg_last)
		{
			if (count < 10.0)
				count = 10.0;

			//Upper bound comes from the PROTOCOL, not from a clamp in the view
			//code. V_ParseDamage reads armour and blood as two BYTES and forms
			//count = blood*0.5 + armor*0.5, so it can never exceed 255 however
			//much damage was actually dealt. Reading the fields directly, as
			//this does, has no such ceiling - a large hit would throw the camera
			//much further than the original ever could.
			if (count > 255.0)
				count = 255.0;

			//Same event drives the red screen flash. V_ParseDamage does the
			//kick and the cshift together from this one message.
			QCShiftDamage(count);

			inflictor = 0;
			if (q_fld_dmg_inflictor >= 0)
				inflictor = QPrEdictNum(
					QPrFieldI(q_player_edict, q_fld_dmg_inflictor));

			if (inflictor > 0)
			{
				for (j = 0; j < 3; j++)
					from[j] = QPrFieldF(inflictor, q_fld_origin + j);

				QVecSub(from, q_origin, dir);
				len = QVecLength(dir);

				if (len > 0.0)
				{
					QVecScale(dir, 1.0 / len, dir);
					QAngleVectors(q_angles, fwd, rgt, upv);

					//Where the damage came from decides which way the view is
					//thrown: sideways damage rolls it, frontal damage pitches.
					side        = QVecDot(dir, rgt);
					q_dmg_roll  = count * side * QKICK_ROLL;

					side        = QVecDot(dir, fwd);
					q_dmg_pitch = count * side * QKICK_PITCH;

					q_dmg_time  = QKICK_TIME;
				}
			}
		}

		q_dmg_last = count;

		//SV_WriteClientdataToMessage CLEARS these after sending them, so they
		//describe one frame's damage and nothing more. Left standing they
		//describe the last hit forever, which makes an identical second hit
		//register as no change at all and produce no flash or kick.
		if (count > 0.0)
		{
			QPrSetFieldF(q_player_edict, q_fld_dmg_take, 0.0);
			QPrSetFieldF(q_player_edict, q_fld_dmg_save, 0.0);
			q_dmg_last = 0.0;
		}
	}

	//Thin client: punchangle arrives in clientdata, not on the local edict.
	//The host has already decayed it, so this is the value to use as-is.
	if (q_udp_ready && !q_udp_server)
	{
		for (j = 0; j < 3; j++)
			q_punch[j] = q_cl.punchangle[j];
	}

	if (q_dmg_time > 0.0)
	{
		q_dmg_time -= dt;
		if (q_dmg_time < 0.0)
			q_dmg_time = 0.0;
	}

	//Pickup flash. QuakeC signals this with a stuffcmd of "bf" in the original,
	//which needs a command layer to receive; watching .items GAIN a bit is the
	//same event from this side and needs nothing extra.
	//Inferring the bonus flash from the items bitmask changing does not work:
	//was a guess, and it was wrong in both directions: it missed pickups that
	//sets no new bit (health, ammo already held) and it cannot fire while
	//a powerup was running out, since fading changes no bits at all. QuakeC says
	//when to flash by stuffing "bf", and that is now honoured directly.

	QCShiftUpdate(dt);
}

//Idle drift. V_AddIdle: three independent sine waves that make the view
//breathe when standing still.
//
//v_idlescale is 0 in stock Quake, so this is OFF by default and porting it
//faithfully means porting a no-op. The cvar values are the original's, and the
//scale is exposed so it can be turned on - but leaving it at 0 is what matches
//the game, and that is why it stays there.
#define QIDLE_ROLL_CYCLE	0.5
#define QIDLE_PITCH_CYCLE	1.0
#define QIDLE_YAW_CYCLE		2.0
#define QIDLE_ROLL_LEVEL	0.1
#define QIDLE_PITCH_LEVEL	0.3
#define QIDLE_YAW_LEVEL		0.3

F64 q_idle_scale = 0.0;		//v_idlescale

U0 QViewAddIdle(F64 *angles)
{
	if (q_idle_scale == 0.0)
		return;

	angles[2] += q_idle_scale * Sin(tS * QIDLE_ROLL_CYCLE) * QIDLE_ROLL_LEVEL;
	angles[0] += q_idle_scale * Sin(tS * QIDLE_PITCH_CYCLE) * QIDLE_PITCH_LEVEL;
	angles[1] += q_idle_scale * Sin(tS * QIDLE_YAW_CYCLE) * QIDLE_YAW_LEVEL;
}

U0 QViewApplyKick(F64 *angles)
{//Fold every view-only angle effect into a copy of the angles.
	F64 frac;

	angles[0] += q_punch[0];
	angles[1] += q_punch[1];
	angles[2] += q_punch[2];

	if (q_dmg_time > 0.0)
	{
		frac = q_dmg_time / QKICK_TIME;
		angles[2] += frac * q_dmg_roll;
		angles[0] += frac * q_dmg_pitch;
	}

	QViewAddIdle(angles);
}

//--- view bob and roll -----------------------------------------------------
//
// Both are cosmetic and VIEW-ONLY. They are applied to a copy of the angles
// used for rendering, never to q_angles itself: that feeds .v_angle, and
// leaning it would make the player's aim lean with the camera.

#define QBOB_AMOUNT		0.02	//bob per unit of horizontal speed
#define QBOB_CYCLE		0.6		//seconds for a full step cycle
#define QBOB_UP			0.5		//fraction of the cycle spent rising
#define QROLL_ANGLE		2.0		//degrees of lean at full strafe
#define QROLL_SPEED		200.0	//strafe speed at which the lean maxes out

F64 q_bob_time	= 0.0;	//accumulated walking time, NOT wall-clock time
F64 q_bob_value	= 0.0;	//last computed bob, held while airborne
F64 q_bob_prev	= 0.0;	//real time of the previous update

U0 QViewBobUpdate()
{//Recompute the head bob. Called ONCE per frame. V_CalcBob.
 //
 //Three things here are easy to get subtly wrong, and all three were:
 //
 //  1. Airborne HOLDS the previous value rather than returning zero. The
 //     original does `if (onground == -1) return bob;`. Snapping to zero puts a
 //     visible jolt in the view on every jump and every step off a ledge.
 //
 //  2. The cycle runs on ACCUMULATED walking time, not wall-clock time. The
 //     original increments bobtime only after the airborne early-out, so the
 //     cycle pauses in mid-air and resumes where it left off. Driving it from
 //     absolute time instead makes the phase jump on landing, so footfalls
 //     land at the wrong point of the step.
 //
 //  3. It must be computed once per frame. This is read twice - once for the
 //     eye and once for the weapon - and advancing the clock inside the reader
 //     stepped the cycle at double rate.
	F64 cycle;
	F64 bob;
	F64 speed;
	F64 dt;

	dt         = tS - q_bob_prev;
	q_bob_prev = tS;

	//A level load must not dump a huge delta into the cycle.
	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	//Airborne means no footfalls: keep the last value.
	if (!q_on_ground)
		return;

	q_bob_time += dt;

	cycle = q_bob_time - ToF64(ToI64(q_bob_time / QBOB_CYCLE)) * QBOB_CYCLE;
	cycle /= QBOB_CYCLE;

	//Rise and fall occupy different fractions of the cycle, which is what
	//gives the footstep its uneven, weighted feel.
	if (cycle < QBOB_UP)
		cycle = pi * cycle / QBOB_UP;
	else
		cycle = pi + pi * (cycle - QBOB_UP) / (1.0 - QBOB_UP);

	//Proportional to speed across the ground only - falling must not bob.
	speed = Sqrt(q_velocity[0] * q_velocity[0] +
				 q_velocity[1] * q_velocity[1]);

	bob = speed * QBOB_AMOUNT;
	bob = bob * 0.3 + bob * 0.7 * Sin(cycle);

	if (bob > 4.0)
		bob = 4.0;
	if (bob < -7.0)
		bob = -7.0;

	q_bob_value = bob;
}

F64 QViewBob()
{//The bob for this frame. Read-only - QViewBobUpdate owns the clock.
	return q_bob_value;
}

F64 q_view_oldz	= 0.0;	//eye height being caught up to after a step
F64 q_step_prev	= 0.0;

F64 QViewStepOffset()
{//Smooth the view over stair steps. V_CalcRefdef.
 //
 //Walking up stairs teleports the origin up a whole step - as much as 18 units
 //at once - and putting the camera straight there makes every step a jolt. The
 //eye instead chases the new height at 80 units/sec, never lagging more than
 //12 behind, so a staircase reads as a climb rather than a series of hops.
 //
 //Only upward moves are smoothed. Falling must be immediate, or the ground
 //would appear to come up to meet the player.
	F64 dt = tS - q_step_prev;

	q_step_prev = tS;

	if (dt < 0.0 || dt > 0.25)
		dt = 0.0;

	if (!q_on_ground || q_origin[2] - q_view_oldz <= 0.0)
	{
		q_view_oldz = q_origin[2];
		return 0.0;
	}

	q_view_oldz += dt * 80.0;

	if (q_view_oldz > q_origin[2])
		q_view_oldz = q_origin[2];
	if (q_origin[2] - q_view_oldz > 12.0)
		q_view_oldz = q_origin[2] - 12.0;

	return q_view_oldz - q_origin[2];
}

F64 QViewRoll(F64 *angles, F64 *velocity)
{//Lean into a strafe, proportional to sideways speed.
	F64 fwd[3];
	F64 rgt[3];
	F64 upv[3];
	F64 side;
	F64 sign;

	QAngleVectors(angles, fwd, rgt, upv);
	side = QVecDot(velocity, rgt);

	if (side < 0.0)
	{
		sign = -1.0;
		side = -side;
	}
	else
		sign = 1.0;

	if (side < QROLL_SPEED)
		side = side * QROLL_ANGLE / QROLL_SPEED;
	else
		side = QROLL_ANGLE;

	return side * sign;
}


U0 QLiquidView()
{//Screen wash and view warp for whatever the eye is submerged in, plus the
 //one-shot sounds for crossing the surface.
 //
 //The tint values are the originals': lava burns orange, slime is a dark
 //green, water a murky brown. They are folded into the palette rather than
 //blended per pixel, because 8bpp indices cannot be averaged.
	I64 r = 0;
	I64 g = 0;
	I64 b = 0;
	I64 a = 0;

	//Only a submerged EYE tints the view; wading to the waist does not.
	if (q_water_level >= 3)
	{
		switch (q_water_type)
		{
			case QCONTENTS_LAVA:
				r = 255; g = 80;  b = 0;  a = 150;
				break;
			case QCONTENTS_SLIME:
				r = 0;   g = 25;  b = 5;  a = 150;
				break;
			default:
				r = 130; g = 80;  b = 50; a = 128;
				break;
		}

		q_warp_amount = 4.0;
	}
	else
		q_warp_amount = 0.0;

	q_warp_time = tS;

	//Damage, pickup and powerup shifts go on top of the liquid one, so a single
	//tint carries all four.
	QCShiftBlend(&r, &g, &b, &a);

	QPalSetTint(r, g, b, a);

	//Surface crossings. Compared against the previous frame so each transition
	//fires exactly once rather than every frame while submerged.
	if (q_water_level > 0 && q_water_last == 0)
	{
		if (q_water_type == QCONTENTS_LAVA)
			QSndPlayAt("player/inlava.wav", q_view, 1.0, 0.0);
		else if (q_water_type == QCONTENTS_SLIME)
			QSndPlayAt("player/slimbrn2.wav", q_view, 1.0, 0.0);
		else
			QSndPlayAt("player/inh2o.wav", q_view, 1.0, 0.0);
	}
	else if (q_water_level == 0 && q_water_last > 0)
		QSndPlayAt("misc/outwater.wav", q_view, 1.0, 0.0);

	q_water_last = q_water_level;
}

U0 QRenderFrame()
{//One full frame into the private canvas.
	F64		 forward[3];
	F64		 right[3];
	F64		 up[3];
	F64		 fov_y;
	F64		 vm_org[3];
	F64		 view_angles[3];
	F64		 saved_idle;
	CQMdl	*vm_mdl;
	F64		 vm_depth;
	F64		 snd_fwd[3];
	F64		 snd_right[3];
	I64		 skip_ent;
	I64		 vm_frame;
	Bool	 vm_show;

	QAngleVectors(q_angles, forward, right, up);
	fov_y = QDrawFovY(q_fov, q_canvas->width, q_canvas->height);

	//Drives the two sky layers' scroll.
	q_sky_time = tS;

	//The eye rides above the player origin, plus the walk bob.
	//
	//Bob is proportional to horizontal speed and rides a cycle, so it grows
	//with running and stops when standing still. Roll leans the view into a
	//strafe. Both are VIEW-only: they must not touch q_angles, because that
	//feeds v_angle and would make the player's shots lean too.
	//
	//Updated exactly ONCE per frame, here, because it is read twice below -
	//for the eye and again for the weapon.
	QViewBobUpdate;

	QVecCopy(q_origin, q_view);

	//The step offset is negative while catching up, so it pulls the eye DOWN
	//towards where it was. The weapon needs no separate handling: it is drawn
	//in camera space, so it already follows the eye.
	//Eye height comes from QuakeC's .view_ofs, not a constant - it drops on
	//death and shifts in liquid. QVIEW_HEIGHT is only the fallback for when no
	//player entity exists yet.
	if (q_game_active)
		q_view[2] += QPlayerViewHeight + QViewBob + QViewStepOffset;
	else
		q_view[2] += QVIEW_HEIGHT + QViewBob + QViewStepOffset;

	//Nudge the eye off any exact plane. The original does this because a water
	//surface can vanish when the viewpoint sits precisely on its node line.
	q_view[0] += 1.0 / 32.0;
	q_view[1] += 1.0 / 32.0;
	q_view[2] += 1.0 / 32.0;

	QVecCopy(q_angles, view_angles);

	//V_CalcIntermissionRefdef: the parked camera gets V_AddIdle with
	//v_idlescale forced to 1 - a slow breathing sway - and none of the
	//gameplay view motion: no velocity roll, no kicks, no bob.
	if (q_intermission)
	{
		saved_idle   = q_idle_scale;
		q_idle_scale = 1.0;
		view_angles[2] = 0.0;
		QViewAddIdle(view_angles);
		q_idle_scale = saved_idle;
	}
	else
	{
		view_angles[2] = QViewRoll(q_angles, q_velocity);

		//Weapon recoil and damage kicks, on the render copy only.
		QViewApplyKick(view_angles);
	}

	//The dead view lies on its side. V_CalcRefdef sets roll to 80 and returns
	//early once health reaches zero, which is what makes death read as
	//collapsing rather than just freezing in place.
	if (q_game_active && QPlayerDead)
		view_angles[2] = 80.0;

	//Sounds attenuate from wherever the player is listening, and separate left
	//from right along the listener's right vector.
	QAngleVectors(view_angles, snd_fwd, snd_right, NULL);
	QSndListener(q_view, snd_right);

	//The listener's own body is always full volume and centred, so the mixer needs
	//which entity that is.
	if (QClientMode)
		q_snd_viewent = q_cl_viewent;
	else
		q_snd_viewent = q_player_edict;

	//S_Update: re-aim everything still playing.
	QSndUpdate;

	//Light styles step at 10Hz off the game clock, and ambient sources are
	//re-triggered as their previous instance runs out.
	QLightAnimate(q_game_time);
	QTurbFrame(tS);

	//Entity lights are refreshed BEFORE the frame's light bookkeeping, so a
	//muzzle flash added this frame is live for this frame's drawing.
	if (q_game_active)
		QGameEntityLights(tS);

	QLightFrame(tS);

	//R_PushDlights: decide which faces each live light reaches, once, before
	//anything is drawn. Doing it per face at draw time meant a light lit
	//whatever happened to be tested rather than what it actually reached.
	q_ambient_light = ToI64(QCvarGet("r_ambient"));
	QPushDlights(q_map, tS);

	//One surface-cache generation per frame: entries touched this frame are
	//the ones that must not be evicted out from under the drawing below.
	QSurfCacheSetMap(q_map);
	q_surf_frame++;

	QSndAmbientUpdate(q_game_time);

	//S_UpdateAmbientSounds: the compiled per-leaf wind and water. Passed the
	//leaf and the cvars because QSound.ZC compiles before both.
	if (QMapValid(q_map, "QSndLeafAmbients"))
		QSndLeafAmbients(q_map, QVisLeafForPoint(q_map, q_view),
			QCvarGet("ambient_level"), QCvarGet("ambient_fade"), tS);

	//Liquid wash, view warp and surface sounds.
	QLiquidView;

	QDrawClear(q_canvas, 0);
	//SCR_CalcRefdef before the projection, so the view rect it picks is what
	//the projection centres on.
	QDrawSetViewRect(q_canvas, QCvarGet("viewsize"), 24);
	QDrawSetView(q_canvas, q_view, view_angles, q_fov);

	//NO WORLD, NO WORLD RENDER. There are two windows where these are absent:
	//between a changelevel releasing the old map and the new one arriving, and
	//after a changelevel that failed outright. A demo reaches both, because its
	//svc_serverinfo changes the level from inside the stream - so the frame
	//loop keeps running while the map it draws is gone.
	if (!QMapValid(q_map, "QRenderFrame") || !q_vis)
	{
		QSbarDraw(q_canvas);
		return;
	}

	QVisBuildList(q_vis, q_view, forward, right, up, q_fov, fov_y);
	QDrawWorld(q_canvas, q_map, q_vis);

	if (q_draw_entities)
	{
		//With the VM running, entities come from the QuakeC world. During
		//playback there is no world at all, and the stream IS the entity list -
		//so the wire path serves both. Falling through to the map's own entity
		//lump instead drew everything the compiler left in it, triggers
		//included, which is where the bare TRIGGER texture came from: a real
		//client is never told about a trigger, because InitTrigger clears its
		//modelindex before the server ever sends one.
		if (q_game_active || QClientMode)
		{
			//HOST keeps drawing from edicts so the remote body (spawned by
			//QSvSpawnRemote) is always visible. GUEST has no copy of the host
			//player in its edict table - force the wire path, and never skip
			//edict 1 (both ends use it for "the player").
			if (QClientMode)
			{
				//svc_setview names this client's body on the host. Fall back to 0 (draw
				//everyone) only if the host forgot to send it.
				skip_ent = q_cl_viewent;
				//No distance cull on the wire path for MP - DM spawns on e1m1
				//are often >2000 apart, and that alone hid both players.
				QNetDrawEntities(q_canvas, q_map, q_view, 10000.0,
					skip_ent);
			}
			else if (QCvarGet("cl_netdraw") != 0.0)
				QNetDrawEntities(q_canvas, q_map, q_view, QENT_DRAW_DIST,
					q_player_edict);
			else if (q_udp_ready && q_udp_server)
			{
				//Host MP: remote bodies are ordinary edicts with player.mdl
				//(QSvRunClients guarantees the model), so the normal path draws
				//them. Drawing them a second time from the client slots put two
				//bodies in the same place.
				QGameDrawEntities(q_canvas, q_map, q_view, 10000.0);
			}
			else
				QGameDrawEntities(q_canvas, q_map, q_view, QENT_DRAW_DIST);
			QGameDrawStatics(q_canvas, q_map);
			//CL_UpdateTEnts re-anchors our own bolt before drawing.
			if (q_udp_ready && !q_udp_server || q_demo_playing)
				QBiBeamsFollow(q_cl_viewent);
			else
				QBiBeamsFollow(q_player_edict);

			QBiDrawBeams(q_canvas, tS);
		}
		else
			QRenderEntities;
	}

	//Particles are depth tested, so they sit correctly among the geometry.
	QPartDraw(q_canvas, tS);

	//The weapon goes last, on top of everything. QuakeC owns which model and
	//which frame, so switching weapons and firing animate for free.
	//
	//Hidden at intermission: execute_changelevel zeroes the player's
	//modelindex and parks the camera at an info_intermission, so the view is a
	//spectator shot of the level rather than a first-person one.
	//Sbar/V_CalcRefdef read cl.stats, not the server's edict, so a client with
	//no QuakeC world still carries a weapon. cl.stats[STAT_HEALTH] is what
	//decides "dead" there - QPlayerDead would read an edict that does not
	//exist and hide the gun for the whole of every demo.
	if (QClientMode)
		vm_show = ToBool(q_cl.health > 0 && !q_intermission);
	else
		vm_show = ToBool(q_player_active && !QPlayerDead && !q_intermission);

	if (vm_show)
	{
		vm_mdl = NULL;
		vm_frame = QPlayerWeaponFrame;

		//Thin client: weaponmodel on the wire is a precache index, not a
		//QuakeC string. Prefer that so the viewgun tracks the host.
		if (QClientMode && q_cl.weaponmodel > 0 &&
			q_cl.weaponmodel < q_precache_model_count)
		{
			vm_mdl   = q_precache_mdl[q_cl.weaponmodel];
			vm_frame = q_cl.weaponframe;
		}

		if (!vm_mdl)
			vm_mdl = QBiFindModel(QPlayerWeaponModel);

		if (vm_mdl)
		{
			//SCREEN-LOCKED, not placed in the world.
			//
			//The original copies the view angles onto the view model entity, so
			//the model turns by exactly the amount the camera turns and the two
			//rotations cancel: the weapon appears welded to the screen and never
			//swings with the aim. Mapping the model straight into camera space
			//makes that cancellation exact by construction - no angles, and no
			//sign convention to get wrong.
			//
			//BOB IS FORWARD, NOT VERTICAL. V_CalcRefdef gives the eye
			//`viewheight + bob` and the gun `viewheight + bob` as well, so the
			//two rise and fall TOGETHER and the gun has no vertical motion
			//relative to the screen at all. Its only relative movement is
			//
			//    view->origin[i] += forward[i] * bob * 0.4;
			//
			//a slight push toward and away from the eye. Adding bob to the
			//camera's UP axis instead - which is what this did - invents a
			//vertical bob the original does not have.
			//1.0 leaves the weapon in the world's depth range, which is what
			//the software renderer does and why it sinks into walls. 1/0.3 is
			//GLQuake's depth-range compression, chosen in the options menu.
			if (q_opt_gunclip)
				vm_depth = 1.0 / 0.3;
			else
				vm_depth = 1.0;

			QMdlDrawView(q_canvas, vm_mdl, vm_frame,
				QVM_FORWARD + QViewBob * 0.4, QVM_RIGHT, QVM_UP,
				1.0, QVM_LIGHT, vm_depth);
		}
	}

	//Trigger messages, then the intermission overlay on top of them.
	QSbarCenterPrint(q_canvas);
	QSbarIntermission(q_canvas, q_game_time);

	//The status bar goes over everything, including the weapon.
	//The status bar goes too - the overlay replaces it entirely.
	if (!q_intermission)
	{
		QSbarTileClear(q_canvas);
		QSbarDraw(q_canvas);
	}

	//TAB deathmatch scoreboard (SCR_DrawScoreboard / Sbar_DeathmatchOverlay).
	if (q_scoreboard_show)
		QSbarDrawScoreboard(q_canvas);

	//Console last of all, dropped over the top of the finished frame. With it
	//closed, the recent lines still show briefly at the top left - which is how
	//pickup messages reach the player. messagemode prompt draws in notify.
	if (q_state == QST_CONSOLE)
		QConDraw(q_canvas);
	else
		QConDrawNotify(q_canvas);
}

U0 QCenterView(CTask *task)
{//Fit the canvas to the window, preserving aspect ratio and centring the
 //result. Every render resolution therefore fills the same area of screen -
 //raising it adds detail rather than shrinking the picture.
	I64 w = task->pix_width;
	I64 h = task->pix_height;
	I64 cw;
	I64 ch;

	if (!q_canvas)
		return;

	cw = q_canvas->width;
	ch = q_canvas->height;

	//Widest fit that still leaves the height inside the window.
	q_blit_w = w;
	q_blit_h = (w * ch) / cw;

	if (q_blit_h > h)
	{
		q_blit_h = h;
		q_blit_w = (h * cw) / ch;
	}

	if (q_blit_w < 1) q_blit_w = 1;
	if (q_blit_h < 1) q_blit_h = 1;

	q_blit_x = (w - q_blit_w) / 2;
	q_blit_y = (h - q_blit_h) / 2;
}

U0 QApplyVideo()
{//Rebuild the render target at the selected resolution and resize the window.
 //
 //The canvas is read by the compositor through draw_it, so it cannot simply be
 //freed and replaced: the same drain-before-free ordering that teardown needs
 //applies here too, or a resolution change frees memory mid-blit.
	CQCanvas *old;
	I64		  w = q_res_w[q_opt_res];
	I64		  h = q_res_h[q_opt_res];

	q_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(60);

	old      = q_canvas;
	q_canvas = NULL;
	QDrawFree(old);

	q_canvas = QDrawNew(w, h);

	//Fullscreen fills the display; windowed sizes the window to the render
	//target so it lands close to 1:1 with a little room for the border.
	if (q_opt_fullscreen)
		WinMax;
	else
	{
		WinHorz(2, 2 + (w / FONT_WIDTH));
		WinVert(2, 2 + (h / FONT_HEIGHT));
	}

	QCenterView(Fs);

	Fs->draw_it = &QDrawIt;
	q_res_dirty = FALSE;
}

Bool QLoadMap(U8 *mapname)
{
	I64 ent_count;
	I64 mdl_count;
	U8  line[256];

	if (q_vis)
	{
		QVisFree(q_vis);
		q_vis = NULL;
	}
	if (q_map)
	{
		QBSPFree(q_map);
		q_map = NULL;
	}

	q_map = QBSPLoad(mapname);
	if (!q_map)
		return FALSE;

	QStrCopy(q_map_name, mapname, 96);

	//Trail memory is keyed by edict number, which the next map reuses for
	//entirely different entities.
	QPartTrailReset;

	q_vis = QVisNew(q_map);

	//Order matters: models resolve against the parsed list, and the spawn
	//point is found in it too. These must not be folded into one print, since
	//argument evaluation order would not guarantee the sequence.
	ent_count = QEntParse(q_map);
	mdl_count = QEntLoadModels;

	QHeapCheck("after QBSPLoad");

	StrPrint(line, "map %s: %d entities, %d static models\n",
		mapname, ent_count, mdl_count);
	QLog(line);

	//makestatic and ambientsound write into sv.signon while the map's spawn
	//functions run, so it has to be empty before the world comes up.
	QSvClearSignon;

	//Playback is driven entirely by the recorded server stream, which carries
	//its own baselines, entity updates and view state. Bringing up QuakeC here
	//would spawn a second, live world - complete with a player at the map's
	//start point - and the two would fight over every edict. That is exactly
	//what "playdemo just drops me into the level" looks like.
	if (q_demo_playing)
	{
		//Any world left over from a previous map still holds edicts and
		//precache slots that the demo's own numbering would collide with.
		QGameShutdown;

		QNetStatesClear;
		QNetClientClear;
	}

	//Bring up the QuakeC world. If the bytecode is unavailable the game falls
	//back to the static entity list, which still renders but never thinks.
	else if (QGameInit(q_map))
	{
		StrPrint(line, "QuakeC: %d spawn functions ran, %d edicts live\n",
			q_game_spawned, q_pr_num_edicts);
		QLog(line);

		//Baselines are part of the SIGNON, not the per-frame datagram: they are
		//sent once, after the world has spawned and before any update, because
		//every later delta is measured from them. Sending them late would leave
		//the client differencing against zeroes.
		QNetStatesClear;
		QNetClientClear;

		//The person at the keyboard is client 0, holding the edict QuakeC has
		//already outfitted. Registering them in the same table the remote
		//clients use is what keeps "how many players are here" a single
		//question with a single answer.
		QSvClientsClear;
		QSvAddClient(0, TRUE, q_player_edict, q_game_time);

		QMsgClear(&q_net_send);

		//Identity goes in the same signon buffer as the baselines, BEFORE it is
		//handed over - writing after the send left the name and colours sitting
		//in a buffer nobody read, and the client kept its defaults.
		QNetWriteIdentity(&q_net_send, 0, q_setup_name,
			q_setup_top, q_setup_bottom);

		//SV_CreateBaseline: captured ONCE, into sv.signon, after the world has
		//spawned. Every client - the local one here and any later joiner -
		//replays the same bytes, so they all delta from the same reference.
		QNetWriteBaselines(&q_sv_signon);
		QMsgAppendIfRoom(&q_net_send, &q_sv_signon, QNET_MAX_MSG);

		QNetSendToClient(&q_net_send);
		QNetClientFrame;

		StrPrint(line, "net: %d baselines, %d bytes signon, name '%s'\n",
			q_net_num_ents, q_net_send.len, q_cl_name);
		QLog(line);
	}
	else
		QLog("QuakeC: FAILED to load - entities will be static\n");

	//Hand the player to QuakeC. PutClientInServer chooses the spawn point, so
	//q_origin is replaced by whatever the game logic decided.
	if (q_game_active)
	{
		if (QPlayerSpawn(q_origin, q_angles, q_setup_name))
		{
			//Slot state first: .colormap is the client number, which
			//QSvApplyClientColors resolves by looking the edict up in the slot
			//table. Applying colours before the slot owns the edict leaves the
			//host with colormap 0 and no translation on remote clients.
			if (q_sv_clients[0].active && q_sv_clients[0].local)
			{
				q_sv_clients[0].top    = q_setup_top & 15;
				q_sv_clients[0].bottom = q_setup_bottom & 15;
				QStrCopy(q_sv_clients[0].name, q_setup_name, 32);
			}

			//Shirt/trousers from the setup page - remotes see these via colormap.
			QSvApplyClientColors(q_player_edict, q_setup_top, q_setup_bottom);

			StrPrint(line, "player: edict %d, health %3.0f\n",
				q_player_edict, QPlayerHealth);
			QLog(line);
		}
		else
			QLog("player: FAILED to spawn as a client\n");
	}

	//Flushed here, before the window opens, so the load report survives even
	//if the game faults later.
	QLogFlush;
	"Quake: %d entities, %d alias models\n", ent_count, mdl_count;

	QVecSet(q_velocity, 0.0, 0.0, 0.0);
	q_on_ground = FALSE;

	if (!QEntFindPlayerStart(q_map, q_origin, q_angles))
	{
		//No spawn point: fall back to the centre of the world bounds.
		//The centre of the world bounds is very likely inside geometry, so
		//start in noclip rather than trapping the player in a wall.
		"Quake: no info_player_start, using model bounds (noclip on)\n";
		q_noclip = TRUE;
		q_origin[0] = (q_map->models[0].mins[0] + q_map->models[0].maxs[0]) * 0.5;
		q_origin[1] = (q_map->models[0].mins[1] + q_map->models[0].maxs[1]) * 0.5;
		q_origin[2] = (q_map->models[0].mins[2] + q_map->models[0].maxs[2]) * 0.5;
		QVecSet(q_angles, 0.0, 0.0, 0.0);
	}

	//Seed the unstick fallback. Globals are not zeroed here, so leaving this
	//uninitialised would let the first stuck frame warp the player to garbage.
	QVecCopy(q_origin, q_old_origin);

	return TRUE;
}

#define QSAVE_PATH	"QSAVE1.SAV"

Bool QSaveGame()
{//Quicksave. One slot: there is no save menu to pick others with.
	return QSaveWrite(QSAVE_PATH, q_map_name, q_game_time, q_origin,
		q_velocity, q_angles, q_on_ground, q_water_level, q_water_type);
}

Bool QLoadGame()
{//Bring up the map named in the save, then pour the saved world into it.
 //
 //The spawn functions are deliberately NOT run: they would build a fresh world
 //that the restore has to overwrite anyway, and their side effects would linger
 //on top of the restored state.
	U8 mapname[96];
	U8 line[160];

	if (!QSaveReadHeader(QSAVE_PATH, mapname))
		return FALSE;

	QGameShutdown;
	QEntFree;

	if (q_vis)
	{
		QVisFree(q_vis);
		q_vis = NULL;
	}
	if (q_map)
	{
		QBSPFree(q_map);
		q_map = NULL;
	}

	if (!QLoadMap(mapname))
	{
		StrPrint(line, "load: %s failed to load\n", mapname);
		QLog(line);
		QSaveDiscard;
		return FALSE;
	}

	QSvClearSignon;

	if (!QGameInit(q_map, FALSE))
	{
		QLog("load: progs.dat failed to come up\n");
		QSaveDiscard;
		return FALSE;
	}

	if (!QSaveRestore(&q_game_time, q_origin, q_velocity, q_angles,
		&q_on_ground, &q_water_level, &q_water_type))
	{
		QLog("load: restore failed\n");
		return FALSE;
	}

	//A restored world is a NEW world as far as the protocol is concerned, so it
	//gets fresh baselines. Reusing the previous map's would delta every entity
	//against a reference that no longer describes it.
	QNetStatesClear;
	QNetClientClear;
	QMsgClear(&q_net_send);
	QNetWriteBaselines(&q_sv_signon);
	QMsgAppendIfRoom(&q_net_send, &q_sv_signon, QNET_MAX_MSG);
	QNetSendToClient(&q_net_send);
	QNetClientFrame;

	//Derived state that must agree with the restored origin.
	QVecCopy(q_origin, q_old_origin);
	q_world_warned = FALSE;
	QBiIntermissionClear;

	StrPrint(line, "load: %s at %.0f %.0f %.0f\n", mapname,
		q_origin[0], q_origin[1], q_origin[2]);
	QLog(line);
	QConPrint(line);
	QLogFlush;

	return TRUE;
}

Bool QChangeLevel(U8 *mapname)
{//Tear the world down and bring up the next map, carrying the player's
 //inventory across. Runs between frames, never inside a think.
	U8 path[96];
	U8 line[160];

	//Ask QuakeC to pack the inventory BEFORE anything is freed.
	QGameSaveParms;

	QGameShutdown;
	QEntFree;

	if (q_vis)
	{
		QVisFree(q_vis);
		q_vis = NULL;
	}
	if (q_map)
	{
		QBSPFree(q_map);
		q_map = NULL;
	}

	//SCR_BeginLoadingPlaque: paint the plaque ONCE, before anything is freed,
	//and leave it up for the whole load.
	if (q_canvas)
	{
		QDrawClear(q_canvas, 0);
		if (q_pic_conback.pixels)
			QPicDrawFill(q_canvas, &q_pic_conback);
		QSbarLoadingPlaque(q_canvas);
		q_loading = TRUE;
	}

	//QuakeC passes a bare map name; the archive stores full paths.
	if (!StrNICompare(mapname, "maps/", 5))
		QStrCopy(path, mapname, 96);
	else
		StrPrint(path, "maps/%s.bsp", mapname);

	if (!QLoadMap(path))
	{
		q_loading = FALSE;
		StrPrint(line, "changelevel: %s failed to load\n", path);
		QLog(line);
		return FALSE;
	}

	q_loading = FALSE;

	//Carried-over motion state persists into the new level otherwise:
	//stale velocity keeps shoving the player, and a stale water level makes
	//the move code swim on dry land - which reads as being frozen in place.
	QVecSet(q_velocity, 0.0, 0.0, 0.0);
	q_water_level  = 0;
	q_water_type   = 0;
	q_on_ground    = FALSE;
	q_world_warned = FALSE;

	//NO SECOND SPAWN. QLoadMap has already run SetNewParms, ClientConnect and
	//PutClientInServer for this level; doing it again re-ran ClientConnect,
	//which is what printed "entered the game" twice on every changelevel.
	//The colours still need reapplying, because the slot table was rebuilt.
	if (q_game_active)
	{
		QSvApplyClientColors(q_player_edict, q_setup_top, q_setup_bottom);
		if (q_sv_clients[0].active && q_sv_clients[0].local)
		{
			q_sv_clients[0].top    = q_setup_top & 15;
			q_sv_clients[0].bottom = q_setup_bottom & 15;
			QStrCopy(q_sv_clients[0].name, q_setup_name, 32);
		}
	}

	//The previous map's origin is meaningless here, and the unstick fallback
	//drags the player back to it otherwise.
	QVecCopy(q_origin, q_old_origin);

	StrPrint(line, "changelevel: spawned at %.0f %.0f %.0f\n",
		q_origin[0], q_origin[1], q_origin[2]);
	QLog(line);

	StrPrint(line, "changelevel -> %s\n", path);
	QLog(line);
	QConPrint(line);
	QLogFlush;

	return TRUE;
}

U0 QClientPrecacheRebuild()
{//CL_ParseServerInfo's precache resolution, deferred to just after the map
 //load it depends on. The serverinfo lists are replayed into the builtin
 //tables IN WIRE ORDER, so every modelindex and sound number in the stream
 //lands on the same entry it referred to on the server.
	U8	*name;
	I64	 j;

	QBiFreePrecache;

	//Slot 0 is "no model"; entry 1, the world, is the map itself and is
	//already loaded - resolving it through the external-BSP cache would load
	//the whole map a second time.
	q_precache_model[0]    = NULL;
	q_precache_mdl[0]      = NULL;
	q_precache_model_count = 1;

	for (j = 0; j < q_cl_model_count; j++)
	{
		name = q_cl_model_names + j * QCL_PRECACHE_NAME;
		if (j == 0)
		{
			QStrCopy(q_world_model_name, name, 96);
			q_precache_model[1] = q_world_model_name;
			q_precache_mdl[1]   = NULL;
			q_precache_model_count = 2;
		}
		else
			QBiPrecacheModel(name);
	}

	for (j = 0; j < q_cl_sound_count; j++)
		q_precache_sound[j] = q_cl_sound_names + j * QCL_PRECACHE_NAME;
	q_precache_sound_count = q_cl_sound_count;

	StrPrint(q_join_line, "client: %d models, %d sounds precached\n",
		q_precache_model_count, q_precache_sound_count);
	QLog(q_join_line);
}

U0 QInputDrain()
{//Consume queued keyboard messages.
 //
 //Quake reads the keyboard as RAW STATE through kbd.down_bitmap - the menu, the
 //console and the game all do - and never calls MessageGet. But the window
 //still receives a MESSAGE_KEY_DOWN/UP pair for every keystroke, and nothing
 //takes them off the queue, so an entire session's worth of WASD, jump and
 //weapon keys sits there.
 //
 //When the app returns, the terminal drains that backlog AS TYPED INPUT. The
 //shell then hands whatever it reassembles to the compiler: a mangled line like
 //"ww`map e1m1" is the visible form, and a pointer built from that garbage
 //faulting inside ExeCmdLine is the crash. It happens with no typing at all,
 //because the game's own keys are the input.
 //
 //Bounded rather than unbounded: a frame should never hold many, and a runaway
 //loop here would hang the game rather than crash it later.
	I64 ch;
	I64 sc;
	I64 guard = 0;

	while (guard < 64 && KeyScan(&ch, &sc))
		guard++;
}

U0 QInputDrainAll()
{//The same drain, but for EXIT, where it has to finish the job.
 //
 //QInputDrain is capped at 64 per call because it runs inside the frame loop
 //and a runaway there would hang the game. That cap is exactly wrong on the
 //way out: a session leaves thousands of queued key messages, one drain of 64
 //clears a rounding error's worth, and the shell reassembles the rest as a
 //command line - which is the fault inside ExeCmdLine.
 //
 //Drained until the queue actually reports empty, with a ceiling far above any
 //real backlog so a broken queue still cannot spin forever. Repeated a few
 //times because messages can still be posted between passes.
	I64 ch;
	I64 sc;
	I64 guard;
	I64 pass;

	for (pass = 0; pass < 4; pass++)
	{
		guard = 0;
		while (guard < 65536 && KeyScan(&ch, &sc))
			guard++;

		//Nothing left on this pass means nothing is still arriving.
		if (!guard)
			break;

		//Let anything mid-post land before the next sweep.
		Sleep(10);
	}
}

U0 QGameLoop()
{
	F64  forward[3];
	F64  right[3];
	F64  up[3];
	F64  move[3];
	F64  speed;
	F64  net_fwd;
	F64  net_side;
	F64  now;
	F64  last;
	F64  dt;
	F64  fps_time;
	I64  sc_w		= Char2ScanCode('w');
	I64  sc_a		= Char2ScanCode('a');
	I64  sc_s		= Char2ScanCode('s');
	I64  sc_d		= Char2ScanCode('d');
	I64  sc_jump	= Char2ScanCode(' ');	//no SC_SPACE define exists
	I64  sc_tilde	= Char2ScanCode('`');
	I64  sc_minus	= Char2ScanCode('-');
	I64  sc_equals	= Char2ScanCode('=');
	I64  sc_y		= Char2ScanCode('y');
	I64  sc_u		= Char2ScanCode('u');
	I64  dx;
	I64  dy;
	I64  fps_frames   = 0;
	I64  impulse      = 0;
	I64  impulse_down = 0;	//number key held this frame, 0 = none
	I64  impulse_last = 0;	//and the previous frame, for the edge
	I64  i            = 0;
	I64  menu_sc      = 0;
	I64  last_menu_sc = 0;
	Bool attack       = FALSE;
	Bool esc_held     = FALSE;
	Bool start_game   = FALSE;
	Bool tilde_held   = FALSE;
	I64  wheel_dz     = 0;
	Bool save_held    = FALSE;
	Bool size_held    = FALSE;
	Bool load_held    = FALSE;
	Bool q_load_request = FALSE;
	F64  srv_accum    = 0.0;
	I64  srv_steps    = 0;

	//Game time comes from the kernel tick, not from frame timing.
	last     = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
	fps_time = last;

	while (TRUE)
	{
		now  = ToF64(counts.jiffies) / ToF64(JIFFY_FREQ);
		dt   = now - last;
		last = now;

		//A long stall (first frame, or a map load) must not launch the camera.
		if (dt > 0.1)
			dt = 0.1;

		//Video changes are serviced FIRST, before any state branch can jump
		//past them: the menu path ends in a goto to the bottom of the loop,
		//and the menu is exactly where they are requested.
		if (q_res_dirty)
			QApplyVideo;

		//Keep the message queue empty. Left to accumulate, the shell replays
		//the whole session's keystrokes as a command line on exit.
		QInputDrain;

		//--- F2 saves, F3 loads ---
		//
		//The original reaches these through menu pages; there is only one slot
		//here, so they are bound directly to the keys its menu uses.
		//--- viewsize: default.cfg binds "-" to sizedown and "=" to sizeup ---
		//
		//SCR_SizeUp_f / SCR_SizeDown_f step by 10 and clamp to 30..120. The
		//tiers matter: at 110 the inventory row goes, at 120 the whole status
		//bar does.
		//
		//Binds only apply when the keyboard belongs to the GAME. While the
		//console or a chat line is open the same keys are text - typing an
		//underscore must not resize the screen.
		if (q_state == QST_CONSOLE || q_msg_mode || q_state == QST_MENU)
			size_held = TRUE;		//swallow the edge, act on nothing
		else if (Bt(kbd.down_bitmap, sc_minus))
		{
			if (!size_held)
			{
				size_held = TRUE;
				QCvarSet("viewsize", QCvarGet("viewsize") - 10.0);
				if (QCvarGet("viewsize") < 30.0)
					QCvarSet("viewsize", 30.0);
			}
		}
		else if (Bt(kbd.down_bitmap, sc_equals))
		{
			if (!size_held)
			{
				size_held = TRUE;
				QCvarSet("viewsize", QCvarGet("viewsize") + 10.0);
				if (QCvarGet("viewsize") > 120.0)
					QCvarSet("viewsize", 120.0);
			}
		}
		else
			size_held = FALSE;

		if (Bt(kbd.down_bitmap, SC_F2))
		{
			if (!save_held)
			{
				save_held = TRUE;
				if (q_game_active)
					QSaveGame;
			}
		}
		else
			save_held = FALSE;

		if (Bt(kbd.down_bitmap, SC_F3))
		{
			if (!load_held)
			{
				load_held = TRUE;
				//Deferred: reloading tears down the world, and this runs
				//between frames rather than inside one.
				q_load_request = TRUE;
			}
		}
		else
			load_held = FALSE;

		//The Single Player menu page cannot call these itself: QMenu.ZC
		//compiles before both, and loading tears the world down mid-frame.
		if (q_menu_save_req)
		{
			q_menu_save_req = FALSE;
			if (q_game_active)
				QSaveGame;
		}

		if (q_menu_load_req)
		{
			q_menu_load_req = FALSE;
			q_load_request  = TRUE;
		}

		if (q_load_request)
		{
			q_load_request = FALSE;
			QLoadGame;
			goto ql_next_frame;
		}

		//--- joining: the client must run the network OUTSIDE the game loop ---
		//
		//A client that has not joined yet is sitting in the menu, so the
		//in-game tick never runs - and that is exactly when it needs to be
		//transmitting its connection request and listening for the reply. The
		//request is repeated because a datagram can simply be lost and there is
		//nothing else to retry it.
		//Keep poking the host while the map loads. Once menu_ingame flips TRUE
		//the old path stopped sending connect, so last_msg went stale during
		//QLoadGame and the host's timeout killed the body mid-join.
		if (q_udp_ready && !q_udp_server &&
			(!q_menu_ingame || q_change_pending || !q_game_active))
		{
			if (tS - q_join_last_try > 1.0)
			{
				q_join_last_try = tS;

				if (!QNetUdpPeerResolved)
					QNetUdpArpProbe;

				QNetClientSendConnect(q_setup_name, q_setup_top, q_setup_bottom);
			}

			QNetClientFrame;
		}

		//A demo is a server stream and has to be pumped whatever the UI is
		//doing, which is why Host_Frame calls CL_ReadFromServer
		//unconditionally. The console and menu states below both jump to the
		//end of the frame, and the in-game tick that used to carry this call
		//is skipped during playback - so without a pump here the stream is
		//never read at all.
		if (q_demo_playing)
		{
			//The map FIRST. svc_serverinfo names the level and everything
			//after it - baselines, entity updates - describes that world, so
			//reading further before the load would fill the client tables and
			//then have the changelevel clear them.
			if (q_change_pending)
			{
				q_change_pending = FALSE;
				if (QChangeLevel(q_change_map))
					QClientPrecacheRebuild;
				else
				{
					QLog("demo: level failed to load, stopping\n");
					q_demo_loop = FALSE;
					QDemoStop;
				}
			}

			QNetClientFrame;

			//The camera tracks the view entity HERE, not only in the play
			//tick: with the menu open the tick is skipped, and the world
			//would render dimmed behind the menu from whatever the view
			//globals last held.
			if (q_demo_playing)
			{
				if (q_cl_viewent > 0 && q_cl_viewent < QNET_MAX_ENTS)
					QVecCopy(q_net_cl[q_cl_viewent].origin, q_origin);
				QVecCopy(q_demo_angles, q_angles);
			}

			//Playback that ends - cleanly or not - leaves a map on screen with
			//no QuakeC behind it and no stream feeding it, which is not a state
			//anything can be done from. The menu is where the attract loop came
			//from, so it is where a finished demo goes back to.
			if (!q_demo_playing && !q_game_active)
			{
				//A changelevel the stream requested and did not live to see
				//must die with it. Left set, the generic service at the bottom
				//of the frame loads the map as a REAL game and spawns the
				//player into what was meant to be an attract loop.
				q_change_pending = FALSE;

				q_menu_ingame = FALSE;
				q_menu_page   = QPAGE_MAIN;
				q_state       = QST_MENU;
			}
		}

		//The server named a level: load it, then continue stock signon
		//(prespawn -> spawn -> begin). Do NOT enter play until signon 4.
		if (q_net_join_pending)
		{
			q_net_join_pending = FALSE;

			//A level named by a stream that has since died must die with it.
			//Acting on it here is how a failed attract demo turned into a
			//REAL game: the pending map fell through to the ordinary
			//changelevel service, which spawns a live player.
			if (q_demo_playing || (q_udp_ready && !q_udp_server))
			{
				//QGameLoop has no scratch line buffer of its own - `line` belongs
				//to Quake() - so the message is built in the join buffer's own
				//scratch rather than borrowing a name that is not in scope here.
				if (q_demo_playing)
					StrPrint(q_join_line, "demo: %s, level %s\n",
						q_demo_name, q_net_join_map);
				else
					StrPrint(q_join_line, "net: joining, server level %s\n",
						q_net_join_map);
				QLog(q_join_line);

				//Same landing for both: the recorded stream and a live server
				//each name the level in svc_serverinfo. One difference - a demo
				//rolling to its next level must not close a menu the player is
				//browsing. M_Draw keeps the menu over the attract loop; only a
				//LIVE join forces the view to the world.
				QStrCopy(q_change_map, q_net_join_map, 64);
				q_change_pending = TRUE;
				q_menu_ingame    = TRUE;
				if (!q_demo_playing || q_state != QST_MENU)
					q_state = QST_PLAYING;
			}
		}

		//--- tilde drops the console, as in the original ---
		if (Bt(kbd.down_bitmap, sc_tilde))
		{
			if (!tilde_held)
			{
				tilde_held = TRUE;

				//Con_ToggleConsole_f opens the console from ANY key_dest, the
				//menu included - the earlier version only opened it from
				//QST_PLAYING, which is why it did nothing at the main menu.
				//Closing it goes back to the game when connected, and to the
				//main menu when not, rather than always to the game.
				if (q_state == QST_CONSOLE)
				{
					if (q_menu_ingame)
						q_state = QST_PLAYING;
					else
					{
						q_state     = QST_MENU;
						q_menu_page = QPAGE_MAIN;
					}
				}
				else
				{
					q_state = QST_CONSOLE;

					//Clear edge state, or keys held as the console opens
					//register as fresh presses.
					QConInputReset;
				}
			}
		}
		else
			tilde_held = FALSE;

		//--- messagemode (Y) / messagemode2 (U); TAB scoreboard ---
		q_scoreboard_show = FALSE;
		if (q_state == QST_PLAYING && !q_msg_mode)
		{
			//QConKeyEdge so the opening press is not typed into the chat.
			if (QConKeyEdge(sc_y))
				QMsgModeBegin(FALSE);
			else if (QConKeyEdge(sc_u))
				QMsgModeBegin(TRUE);

			if (Bt(kbd.down_bitmap, SC_TAB))
				q_scoreboard_show = TRUE;
		}

		//--- ESC toggles the menu; quitting is a menu choice ---
		if (Bt(kbd.down_bitmap, SC_ESC))
		{
			if (!esc_held)
			{
				esc_held = TRUE;

				//Every one of these that ARRIVES at a menu page sets
				//m_entersound in the original, which M_Draw then plays as
				//misc/menu2.wav. Backing out was silent here, which is the
				//one piece of menu feedback that was missing.
				if (q_msg_mode)
					QMsgModeCancel;
				else if (q_state == QST_PLAYING)
				{
					q_state = QST_MENU;
					QMenuSound(QMSND_ENTER);
				}
				else if (q_state == QST_CONSOLE)
				{
					//Key_Console passes ESC straight to M_ToggleMenu_f.
					q_state     = QST_MENU;
					q_menu_page = QPAGE_MAIN;
					QMenuSound(QMSND_ENTER);
				}
				else if (q_menu_page != QPAGE_MAIN)
				{
					q_menu_page = QPAGE_MAIN;	//back out of a submenu first
					QMenuSound(QMSND_ENTER);
				}
				else if (q_menu_ingame)
					q_state = QST_PLAYING;
			}
		}
		else
			esc_held = FALSE;

		//--- console: typing owns the keyboard, world keeps running ---
		if (q_state == QST_CONSOLE)
		{
			QConInput;

			if (q_con_want_noclip)
			{
				q_noclip = !q_noclip;
				QVecSet(q_velocity, 0.0, 0.0, 0.0);
				q_con_want_noclip = FALSE;
			}

			//Console requests that touch app-shell state, applied here because
			//this file is compiled after the console.
			if (q_con_fov_want != 0.0)
			{
				q_fov          = q_con_fov_want;
				q_con_fov_want = 0.0;
			}

			if (q_con_want_save)
			{
				q_con_want_save = FALSE;
				q_con_save_ok   = QSaveGame;
			}

			if (q_con_want_load)
			{
				q_con_want_load = FALSE;
				q_load_request  = TRUE;
			}

			if (q_con_want_quit)
				break;

			//NO early-out here. Rendering and jumping to the next frame
			//which skipped the whole server tick - so opening the console
			//stopped the WORLD, not just this player. On a listen server that
			//also froze every remote client, because QSvRunClients,
			//QNetServerReadClient and QNetServerFrame all live in that tick.
			//The local player is held still by the input gate below instead.
		}

		//--- console opened from the MENU: no world to render behind it ---
		//
		//The console normally draws at the end of QRenderFrame, which needs a
		//map. Opened from the title screen there is none, so the menu artwork
		//stands in as the backdrop - which is also what the original shows when
		//the console is down outside a game.
		if (q_state == QST_CONSOLE && !q_menu_ingame)
		{
			QMenuDraw(q_canvas);
			QConDraw(q_canvas);
			QCenterView(Fs);
			q_ready = TRUE;

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//--- menu: no world simulation, just navigation ---
		if (q_state == QST_MENU)
		{
			menu_sc = 0;
			if (Bt(kbd.down_bitmap, SC_CURSOR_UP))		menu_sc = SC_CURSOR_UP;
			if (Bt(kbd.down_bitmap, SC_CURSOR_DOWN))	menu_sc = SC_CURSOR_DOWN;
			if (Bt(kbd.down_bitmap, SC_CURSOR_LEFT))	menu_sc = SC_CURSOR_LEFT;
			if (Bt(kbd.down_bitmap, SC_CURSOR_RIGHT))	menu_sc = SC_CURSOR_RIGHT;
			if (Bt(kbd.down_bitmap, SC_ENTER))			menu_sc = SC_ENTER;

			//The name editor polls the keyboard itself, so it runs before the
			//scancode dispatch and swallows the frame when it is active.
			QSetupInput;
			QLanInput;

			//Edge trigger, or a held arrow runs the whole list.
			if (menu_sc && menu_sc != last_menu_sc && !q_setup_editing &&
				!q_lan_editing)
			{
				if (QMenuKey(menu_sc, &start_game))
				{
					if (start_game)
					{
						//cls.demonum = -1: choosing anything cancels the
						//attract loop, and the demo must stop before the
						//world it was driving is replaced.
						QDemoStop;
						q_demo_loop = FALSE;

						q_menu_ingame = TRUE;
						q_state       = QST_PLAYING;
					}
				}
			}
			last_menu_sc = menu_sc;

			//Multiplayer -> New Game. The cvar is already set; the map has to be
			//restarted so the QuakeC world respawns with deathmatch active -
			//items behave differently from the moment they spawn, so flipping it
			//on a running level would leave the existing ones wrong.
			if (q_mp_start_dm)
			{
				//The map switch itself is already queued by the menu; this only
				//has to leave the menu so the change is serviced by the frame
				//loop the way a changelevel from QuakeC would be.
				q_mp_start_dm = FALSE;
				q_menu_ingame = TRUE;
				q_state       = QST_PLAYING;
			}

			if (q_quit_request)
				break;

			//With a game running, render the frozen world first so the menu
			//has something to dim. QMenuBackdrop applies the fade dither over
			//it; without this pass there is nothing underneath and the fade
			//would darken last frame's leftovers or plain black.
			if (q_menu_ingame && q_map && q_vis)
				QRenderFrame;

			QMenuDraw(q_canvas);
			QCenterView(Fs);
			q_ready = TRUE;

			LBts(&Fs->task_flags, TASKf_IDLE);
			Yield;
			LBtr(&Fs->task_flags, TASKf_IDLE);
			goto ql_next_frame;
		}

		//--- mouse: read deltas AND the wheel before the reset clears them ---
		//
		//Drained even while typing, so the deltas do not pile up and lurch the
		//view the moment the console closes - they are simply discarded.
		dx = mouse_hard.raw_data.x;
		dy = mouse_hard.raw_data.y;

		//The WHEEL comes from raw_data.z, which accumulates and is cleared by
		//the reset below, so it is already a per-frame delta. mouse.pos.z is
		//not usable here: raw mode never updates it.
		wheel_dz = mouse_hard.raw_data.z;

		//FIRE is the latch OR the level, and it needs both.
		//
		//raw_bttns is accumulated with |= and cleared every frame, so it only
		//reads set on a frame where the mouse actually sent a packet - and a
		//PS/2 mouse sends nothing while a button is held still. On its own,
		//holding fire only registered while the mouse was also moving, which is
		//why automatic weapons fired only when aiming around.
		//
		//bttns is the LEVEL, which answers "is it down now". The kernel only
		//maintains it in raw mode with the Mouse.ZC change that accompanies
		//this, so on a kernel built before that it stays FALSE forever - reading
		//it alone meant no shooting at all. Taking either source keeps a stale
		//kernel working exactly as it did while a rebuilt one holds fire
		//properly, and neither can produce a false positive: the level is
		//cleared on entry below.
		attack = ToBool(mouse_hard.raw_bttns[0] || mouse_hard.bttns[0]);

		MouseRawReset;

		//Typing owns the keyboard and mouse: the player holds still, but the
		//server keeps running for everyone else.
		if (q_state != QST_PLAYING || q_msg_mode)
		{
			dx       = 0;
			dy       = 0;
			wheel_dz = 0;
			attack   = FALSE;
		}

		//During an intermission the view belongs to the info_intermission
		//spot the server parked it at - V_CalcIntermissionRefdef reads the
		//entity's angles every frame, so the mouse has no say until play
		//resumes.
		if (q_intermission)
		{
			dx = 0;
			dy = 0;
		}

		//m_pitch carries the INVERT setting in its sign, as the original does.
		//Normalised against the default so the mouse-speed slider stays the
		//thing that sets magnitude.
		q_angles[1] -= ToF64(dx) * q_opt_sensitivity;
		if (QCvarGet("m_pitch") < 0.0)
			q_angles[0] -= ToF64(dy) * q_opt_sensitivity;
		else
			q_angles[0] += ToF64(dy) * q_opt_sensitivity;

		if (q_angles[0] > QPITCH_LIMIT)
			q_angles[0] = QPITCH_LIMIT;
		if (q_angles[0] < -QPITCH_LIMIT)
			q_angles[0] = -QPITCH_LIMIT;

		q_angles[1] = QAngleNorm(q_angles[1]);

		//Number keys request a weapon switch. EDGE TRIGGERED, because an impulse
		//is a one-shot event, not a state: the original's +impulse binding fires
		//once on the key going down and CL_SendMove zeroes in_impulse straight
		//after transmitting it. Sampling the held state instead re-sent the same
		//impulse every tick, which is harmless for a direct weapon select but
		//makes the cycle impulses unusable.
		impulse      = 0;
		impulse_down = 0;

		for (i = 1; i <= 8; i++)
		{
			if (Bt(kbd.down_bitmap, Char2ScanCode('0' + i)))
			{
				impulse_down = i;
				if (i != impulse_last)
					impulse = i;
			}
		}

		impulse_last = impulse_down;

		//Wheel cycles weapons. The original has no wheel binding - it predates
		//the convention - but it exposes the two impulses such a binding would
		//use, so this drives the game's own commands rather than inventing a
		//path: 10 is next weapon, 12 is previous.
		if (wheel_dz > 0)
			impulse = 10;
		else if (wheel_dz < 0)
			impulse = 12;



		//--- movement wish direction ---
		QAngleVectors(q_angles, forward, right, up);
		QVecSet(move, 0.0, 0.0, 0.0);
		//Stock clc_move shorts are view-relative (forwardmove/sidemove/upmove).
		net_fwd  = 0.0;
		net_side = 0.0;

		//messagemode and the console both own the keyboard - no walk while
		//typing. The world still ticks; only this player's input is dropped.
		if (q_msg_mode || q_state == QST_CONSOLE)
		{
			if (q_msg_mode)
				QMsgModeInput;
			impulse = 0;
			attack  = FALSE;
		}
		//A DEAD player has no input. SV_ClientThink bails out on both of these
		//before reading the move at all:
		//    if (movetype == MOVETYPE_NONE) return;
		//    if (health <= 0) return;
		//Without it the corpse keeps walking around under player control while
		//health counts further and further below zero.
		else if (q_game_active && QPlayerFrozen)
		{
			//MOVEMENT only. The buttons must still reach QuakeC: once dead,
			//PlayerDeathThink waits for every button to be RELEASED and then for
			//one to be pressed again before it will respawn. Swallowing the
			//attack button here would leave the player permanently dead.
			//
			//SV_ClientThink works the same way round - it returns before reading
			//the move, but the buttons were already delivered.
			impulse = 0;
		}
		else
		{
			if (Bt(kbd.down_bitmap, sc_w))
			{
				QVecAdd(move, forward, move);
				net_fwd += 1.0;
			}
			if (Bt(kbd.down_bitmap, sc_s))
			{
				QVecSub(move, forward, move);
				net_fwd -= 1.0;
			}
			if (Bt(kbd.down_bitmap, sc_d))
			{
				QVecAdd(move, right, move);
				net_side += 1.0;
			}
			if (Bt(kbd.down_bitmap, sc_a))
			{
				QVecSub(move, right, move);
				net_side -= 1.0;
			}
		}

		//cl_forwardspeed IS the always-run setting - the Options page and the
		//original's own config both work by changing it rather than by keeping
		//a separate flag. Shift is the speed key and swaps whichever way it is
		//set, so it walks when running and runs when walking.
		speed = QCvarGet("cl_forwardspeed");
		if (speed < QMOVE_SPEED)
			speed = QMOVE_SPEED;

		if (Bt(kbd.down_bitmap, SC_SHIFT))
		{
			if (speed >= QMOVE_FAST)
				speed = QMOVE_SPEED;
			else
				speed = QMOVE_FAST;
		}

		if (q_noclip)
		{
			//Free flight, for getting unstuck and inspecting geometry.
			QVecSet(q_velocity, 0.0, 0.0, 0.0);
			if (QVecLength(move) > 0.0)
			{
				QVecNormalize(move);
				QVecMA(q_origin, speed * dt, move, q_origin);
			}
		}
		else
		{
			q_water_level = QWaterLevelGet(q_map, q_origin, &q_water_type);
			QPlayerWater(q_water_level, q_water_type);

			//Out of water the wish direction is flattened so looking up does
			//not drive the player into the floor. Swimming keeps the vertical
			//component, which is how looking up produces lift.
			if (q_water_level < 2)
				move[2] = 0.0;

			if (QVecLength(move) > 0.0)
				QVecNormalize(move);
		}

		//A console `impulse N` is delivered AFTER the input suppression above,
		//never before it. Host_Impulse_f queues cl.impulse for the next move
		//whatever the keyboard is pointing at, and typing the command
		//necessarily leaves the console open on that frame - so an earlier
		//assignment is cleared again on the way past and the cheat does
		//nothing.
		if (q_con_impulse_want)
		{
			impulse            = q_con_impulse_want;
			q_con_impulse_want = 0;
		}

		//Only while hunting: `heapcheck 1` in the console. The sweep walks
		//every live allocation, which is far too much to do per second during
		//normal play.
		if (q_heap_check_on && tS - q_heap_check_last > 1.0)
		{
			q_heap_check_last = tS;
			StrPrint(q_heap_check_line, "in game f%d", q_frame_count);
			QHeapCheck(q_heap_check_line);
		}

		//--- server frames at a FIXED rate ---
		//
		//The original caps its host loop and runs exactly ONE server frame per
		//accepted frame, so PreThink, the move and PostThink all advance at a
		//bounded, consistent rate. Driving them at render rate instead (190Hz
		//here) over-runs everything by nearly 3x: jumps integrate differently,
		//and anything QuakeC does per-call happens far too often.
		//
		//So the server steps at a fixed interval and rendering runs free. The
		//catch-up is capped, or a stall would fire a burst of frames at once.
		//Once a second, from the FRAME loop rather than the tick, so it still
		//reports when the tick itself is being skipped. Answers directly why a
		//remote stops moving while the host has the console open: if these
		//lines keep coming but rem_org stops changing, the tick runs and the
		//moves are not arriving; if the lines stop, the tick is being gated.
		if (q_net_active && q_udp_server && tS - q_tick_log_last > 1.0)
		{
			q_tick_log_last = tS;

			if (q_tick_log_n < 120)
			{
				q_tick_log_n++;

				StrPrint(q_tick_line,
					"tick: state %d act %d self %d rem %d org(%.0f %.0f) "
					"mv(%.0f %.0f) sig %d\n",
					q_state, QSvFlagI(q_game_active), q_player_edict,
					q_sv_clients[1].edict,
					q_sv_clients[1].origin[0], q_sv_clients[1].origin[1],
					q_sv_clients[1].cmd[0], q_sv_clients[1].cmd[1],
					q_sv_clients[1].signon);
				QLog(q_tick_line);
				QLogFlush;
			}
		}

		srv_accum += dt;
		srv_steps  = 0;

		while (srv_accum >= QSERVER_STEP && srv_steps < QSERVER_MAX_CATCHUP)
		{
			//Before anything else, make sure the player is not embedded in
			//solid. A teleport or a door can leave them there, and the slide
			//move alone can never recover from it.
			//QCheckStuck traces before QPlayerMove has set the pass entity, so
			//it needs one here. QPlayerMove saves and restores it around every
			//move, which is what keeps a remote client's move from writing its
			//origin onto whichever edict moved last.
			q_move_pass = q_player_edict;

			if (!q_noclip && q_map)
				QCheckStuck(q_map, q_origin);


			//DEMO PLAYBACK OWNS THE FRAME.
			//
			//A demo is a recorded server stream, so there is no local player to
			//simulate: no input, no move, no think. Vanilla has no client-side
			//prediction either - V_CalcRefdef puts the view on
			//cl_entities[cl.viewentity] - and the angles are the three floats
			//recorded beside every demo message. Running the normal tick as well
			//left the local player walking around under the demo's camera.
			if (q_demo_playing)
			{
				if (q_cl_viewent > 0 && q_cl_viewent < QNET_MAX_ENTS)
					QVecCopy(q_net_cl[q_cl_viewent].origin, q_origin);

				QVecCopy(q_demo_angles, q_angles);
				QVecSet(q_velocity, 0.0, 0.0, 0.0);
				q_on_ground = TRUE;
			}
			else if (q_game_active)
			{
				//--- upstream: the client's move goes over the wire ------------
				//
				//CL_SendMove then SV_ReadClientMove. The view angles, the two
				//buttons and the impulse now reach the edict by being SERIALISED
				//and read back, not by being written across - so the input path
				//is a real client/server boundary too, and a second player would
				//arrive down exactly this route.
				//
				//The move vector itself is sent and read back for the ping and
				//for symmetry, but the engine still applies its own copy: the
				//server-side move would have to reconstruct the wish direction
				//from angles the way SV_ClientThink does, and that swap belongs
				//with the renderer flip rather than here.
				if (q_net_active)
				{
					//Stock: CL_SendMove only after SIGNONS (4). Listen host
					//never walks UDP signon -- q_cl_signon stays 0.
					if (!q_udp_ready || q_udp_server || q_cl_signon >= 4)
					{
						QNetClientSendMove(q_angles,
							net_fwd * speed, net_side * speed, 0.0,
							attack, ToBool(Bt(kbd.down_bitmap, sc_jump)),
							impulse, q_game_time);
					}

					QNetServerReadClient(q_player_edict, q_game_time);
				}

				//SV_ClientThink opens with this, so the kick from the last
				//shot has recovered a little before the frame is built.
				QDropPunchAngle(q_player_edict, QSERVER_STEP);

				QPlayerPreThink(q_origin, q_velocity, q_angles, q_on_ground,
					attack, ToBool(Bt(kbd.down_bitmap, sc_jump)), impulse);

				//CONSUMED, because this loop can run several catch-up ticks for
				//one rendered frame. The original carries an impulse in a single
				//move message, so exactly one server frame ever sees it; leaving
				//it set here would hand the same key press to ImpulseCommands
				//two or three times and cycle straight past the weapon asked for.
				impulse = 0;

				//QuakeC owns jumping while the VM is live: PlayerJump has
				//already set the vertical velocity during pre-think.
				//Only a MOVETYPE_WALK player is moved from here. Once dead the
				//movetype becomes TOSS and the entity physics pass owns the
				//corpse, which is how SV_Physics_Client splits it. Left running,
				//WALK physics on a corpse re-fires the touch of whatever it
				//rests on every frame - looping that entity's sound.
				if (!q_noclip && QPlayerWalking)
					QPlayerMove(q_map, q_origin, q_velocity, move, speed,
						FALSE, QSERVER_STEP, &q_on_ground, q_water_level,
						QPlayerWaterJump(q_velocity, q_game_time), q_angles,
						q_player_edict);

				//Publish what the player is standing on. QuakeC and the pusher
				//code both read .groundentity, and a platform only carries
				//riders it can identify.
				if (q_player_edict > 0 && q_fld_groundentity >= 0)
					QPrSetFieldI(q_player_edict, q_fld_groundentity,
						QPrEdictValue(q_ground_entity));

				//THIN CLIENT: a joined guest must NOT run the full world think
				//pass. It already loads the map locally (monsters, items, the
				//lot) and simulating that ON TOP of parsing the host's entity
				//storm is what froze the guest while the host's netstat kept
				//climbing. World picture comes from the wire via QNetClientFrame
				//+ cl_netdraw; local motion is still predicted below.
				//PUBLISH THE POST-MOVE POSITION BEFORE THE PUSHERS RUN.
				//
				//PlayerPreThink wrote the PRE-move origin, and QPlayerMove has
				//since moved the engine's own copy without touching the edict.
				//A pusher therefore tested the player where they were last
				//tick, and - worse - anything it pushed was thrown away below,
				//because the edict was only adopted back for a corpse. A plat
				//could never move the player out of its way, so it stayed
				//blocked, fired .blocked every frame (plat_crush) and never
				//completed its travel: instant crush damage from a lift that
				//appears not to move. In the original sv_player->v.origin IS
				//the position, so no such gap exists.
				if (q_game_active && q_player_edict > 0)
				{
					for (i = 0; i < 3; i++)
					{
						QPrSetFieldF(q_player_edict, q_fld_origin + i,
							q_origin[i]);
						QPrSetFieldF(q_player_edict, q_fld_velocity + i,
							q_velocity[i]);
					}
				}

				//The local world does not run while a demo plays - the stream
				//already contains everything that happened.
				if (!QClientMode)
					QGameFrame(QSERVER_STEP);

				//Adopt whatever the physics pass did to the body - a corpse
				//falling, or a platform carrying/shoving a live player. Since
				//the edict was published immediately above, any difference here
				//is exactly what the pusher applied.
				if (q_game_active && q_player_edict > 0)
				{
					for (i = 0; i < 3; i++)
					{
						q_origin[i]   = QPrFieldF(q_player_edict,
											q_fld_origin + i);
						q_velocity[i] = QPrFieldF(q_player_edict,
											q_fld_velocity + i);
					}
				}

				QPlayerTouchTriggers(q_origin, q_velocity);
				QPlayerPostThink(q_origin, q_velocity, q_angles,
					q_on_ground, q_water_level, q_water_type);
				//Local player frame chains - same as remotes in QSvRunClients.
				if (q_player_edict > 0)
					QSvRunEntityThink(q_player_edict);
				QStuckCheck(move, speed);

				//Anything QuakeC printed this tick goes to the console, and
				//anything it stuffed at the client gets executed.
				QConDrainProgs;
				QConDrainStuff;

				if (q_con_want_bf)
				{
					q_con_want_bf = FALSE;
					QCShiftBonus;
				}

				//Music has no loop flag in the mixer, so it is retriggered when
				//the track runs out.
				QMusicUpdate(tS);

				//--- the client/server boundary --------------------------------
				//
				//The world is now settled for this tick, which is exactly where
				//SV_SendClientDatagram runs. The server serialises it and the
				//local client rebuilds its copy from the bytes.
				//
				//The RENDERER still reads the world directly. Flipping it over to
				//the client's tables is the last step and a separate one: this
				//pass has to be proved to reconstruct the world correctly first,
				//which is what QNetVerify measures - and it can only measure it
				//while a known-good reference is still there to compare against.
				if (q_net_active && q_player_edict > 0)
				{
					if (q_udp_ready && q_udp_server)
						QSvRunClients(QSERVER_STEP, q_game_time);

					//Host builds the datagram; guest only drains the wire.
					if (q_udp_server || !q_udp_ready)
						QNetServerFrame(q_player_edict, q_game_time);

					QNetClientFrame;

					//Guest: HUD / death / viewweapon follow host clientdata.
					QNetSyncLocalFromClient;

					//svc_print / Host_Say may have arrived this tick - show now.
					QConDrainProgs;

					if (q_udp_server || !q_udp_ready)
					{
						q_net_mismatch        = QNetVerify(q_player_edict);
						q_net_mismatch_report = q_net_mismatch;
					}
				}

				//AFTER the wire: guest hit kick reads q_net_damage_pending from
				//svc_damage parsed above. Host still gets dmg_* from the edict.
				QViewKickUpdate(QSERVER_STEP);

				//Keep the OS responsive under catch-up bursts.
				if (q_udp_ready && !q_udp_server)
					Yield;
			}
			else if (!q_noclip)
			{
				//No bytecode loaded, so the engine owns jumping.
				QPlayerMove(q_map, q_origin, q_velocity, move, speed,
					ToBool(Bt(kbd.down_bitmap, sc_jump)), QSERVER_STEP,
					&q_on_ground, q_water_level, FALSE, q_angles,
					q_player_edict);
			}

			srv_accum -= QSERVER_STEP;
			srv_steps++;
		}

		//A long stall must not leave a backlog that replays later.
		if (srv_accum > QSERVER_STEP)
			srv_accum = 0.0;

		//Particles age on the render clock, not the game clock.
		QPartUpdate(dt, tS);

		QCenterView(Fs);
		QRenderFrame;
		q_ready = TRUE;

		q_frame_count++;
		fps_frames++;
		if (now - fps_time >= 0.5)
		{
			q_fps      = ToF64(fps_frames) / (now - fps_time);
			fps_frames = 0;
			fps_time   = now;
		}

		//A level change is requested from inside a think, so it is serviced
		//here, between frames, once nothing is executing.
		//A death restart reloads the SAME map with no carried inventory. Handled
		//before the level change so the two cannot both fire in one frame.
		if (q_restart_pending)
		{
			q_restart_pending = FALSE;
			QGameClearParms;
			QChangeLevel(q_map_name);
			goto ql_next_frame;
		}

		//Never during playback: the demo pump owns its own changelevels, and
		//this copy would service one without the client precache rebuild.
		if (q_change_pending && !q_demo_playing)
		{
			q_change_pending = FALSE;
			QChangeLevel(q_change_map);

			//Guest: after map load, reply to signonnum 1 with "prespawn".
			if (q_udp_ready && !q_udp_server && q_net_need_prespawn)
			{
				q_net_need_prespawn = FALSE;
				QLog("net: cl -> prespawn (map loaded)\n");
				QLogFlush;
				QNetClientSendStringCmd("prespawn");
			}
		}

		LBts(&Fs->task_flags, TASKf_IDLE);
		Yield;
		LBtr(&Fs->task_flags, TASKf_IDLE);

ql_next_frame:
	}
}

U0 QDocCursorPark()
{//Put the terminal's document cursor back at the END of the document.
 //
 //Quake calls DocClear on startup and then prints a great deal - the load
 //report, the exit summary - into the terminal's own document. That leaves the
 //cursor wherever the last write or the last mouse click put it, which for a
 //DolDoc terminal is a real editing position, not a prompt.
 //
 //Anything the user types afterwards is then inserted INTO existing document
 //text rather than appended at the prompt, so a typed command comes out merged
 //with whatever was on that line: "map e1m1" becomes something like
 //"ww`map e1m1". The shell hands that to the compiler, which either reports an
 //undefined identifier or dereferences a pointer built from the mangled text
 //and faults inside ExeCmdLine - a crash that looks like it belongs to Quake
 //but happens after Quake has fully exited.
 //
 //Parking the cursor at the tail is the same idiom the doc utilities use.
	CDoc *doc;
	Bool  unlock;

	doc = Fs->put_doc;
	if (!doc)
		return;

	unlock = DocLock(doc);

	doc->cur_entry = &doc->head;
	doc->cur_col   = 0;

	if (unlock)
		DocUnlock(doc);
}

U0 Quake(U8 *mapname = QDEFAULT_MAP)
{
	CQCanvas	*canvas			= NULL;
	CQVisState	*vis			= NULL;
	CQMap		*map			= NULL;
	Bool		 raw_was_on		= FALSE;
	Bool		 demo_boot		= FALSE;
	Bool		 final_active	= FALSE;
	I64			 final_edicts	= 0;
	I64			 final_thinks	= 0;
	I64			 final_models	= 0;
	I64			 final_snd		= 0;
	I64			 final_drop		= 0;
	I64			 final_move_ok	= 0;
	I64			 final_move_fail = 0;
	I64			 final_errors	= 0;
	F64			 final_time		= 0.0;
	U8			 line[256];
	U8			 pakname[64];
	I64			 i;

	QLogReset;

	//The FIRST thing done, before a single allocation of ours. If this already
	//reports corruption then it did not come from here, and the check itself
	//or the caller's state is what needs looking at.
	QHeapCheck("entry");

	QPakInit;
	QSndInit;
	QPartInit;
	QClipInit;
	//Every pointer below is handed to Free() during teardown, and ZealC does
	//not honour a declaration initialiser on a global. One that is never
	//assigned before then - the music buffer when no track played, the save
	//buffer when nothing was loaded - is freed as garbage, which faults inside
	//the allocator with no reference to this code anywhere in the trace.
	q_music_frames     = NULL;
	q_music_count      = 0;
	q_music_rate       = QSND_RATE;
	q_music_track      = 0;
	q_save_buf         = NULL;
	q_mdl_preview      = NULL;
	q_mdl_preview_skin = NULL;
	q_vis              = NULL;
	q_map              = NULL;
	q_entities         = NULL;
	q_num_entities     = 0;

	QMdlCacheInit;
	QBiBspCacheInit;
	QSurfCacheInit;
	QMusicReset;
	QPlayerStateInit;
	QDemoInit;
	QConHistoryInit;
	QLightInit;
	QTurbInit;
	QNetInit;
	QNetUdpInit;
	QNetStatesClear;
	QSetupDefaults;
	QCfgLoad;
	QViewKickInit;
	QCShiftInit;
	QStuckInit;

	//Cvars once, before anything can read them - NOT in QBiInit, which runs
	//again on every map load and would throw away "registered" and "skill".
	QCvarInit;

	//Mount PAK0, PAK1, PAK2... until one is missing, the way
	//COM_AddGameDirectory walks pak%i. Mounting only PAK0 left the registered
	//game's 85 extra files - episodes 2 through 4, their models and sounds, and
	//gfx/pop.lmp - unreachable. PAK0 is byte-identical between the shareware
	//and registered releases, so PAK0 alone can never tell the two apart.
	if (!QPakMount("::/Apps/Quake/id1/PAK0.PAK"))
	{
		"Quake: PAK0.PAK not found. See ::/Apps/Quake/README.md\n";
		return;
	}

	i = 1;
	while (i < QPAK_MAX_PAKS)
	{
		StrPrint(pakname, "::/Apps/Quake/id1/PAK%d.PAK", i);
		if (!FileFind(pakname))
			break;
		if (!QPakMount(pakname))
			break;
		i++;
	}

	//COM_AddGameDirectory for a MOD. A gamedir's archives mount AFTER id1's,
	//and QPakFind searches newest first, so a mod overrides by shadowing file
	//names - including progs.dat, which is how a total conversion replaces the
	//game logic outright.
	if (q_game_dir[0])
	{
		StrPrint(pakname, "::/Apps/Quake/%s/PAK0.PAK", q_game_dir);
		if (FileFind(pakname) && QPakMount(pakname))
		{
			i = 1;
			while (i < QPAK_MAX_PAKS)
			{
				StrPrint(pakname, "::/Apps/Quake/%s/PAK%d.PAK",
					q_game_dir, i);
				if (!FileFind(pakname))
					break;
				if (!QPakMount(pakname))
					break;
				i++;
			}
		}

		StrPrint(pakname, "Quake: gamedir %s\n", q_game_dir);
		"%s", pakname;
	}

	//COM_CheckRegistered: the presence of gfx/pop.lmp IS the registration test.
	//trigger_onlyregistered_touch reads cvar("registered"), so without this the
	//full game still prints the shareware "you'll never know what awaits you"
	//message at every episode gate.
	if (QPakFind("gfx/pop.lmp"))
	{
		QCvarSet("registered", 1.0);
		"Quake: registered version.\n";
	}
	else
		"Quake: shareware version.\n";

	if (!QPalLoad)
	{
		"Quake: palette load failed\n";
		return;
	}

	//Interface art: gfx.wad (status bar, digits, icons, font) plus the
	//standalone gfx/*.lmp menu pictures.
	QWadInit;
	QSbarInit;
	QMenuInit;

	//A stock boot loads NO playable map. quake.rc's startdemos supplies the
	//world - each demo names its own level in svc_serverinfo - and the menu
	//needs none at all. Loading one here spun up QuakeC and put a live player
	//in it, which is why the game opened already being played. The direct load
	//remains only as the fallback for a boot with the attract loop disabled or
	//no demos to run.
	demo_boot = FALSE;
	if (QCvarGet("demoloop") != 0.0)
		demo_boot = QDemoNextInLoop;

	if (demo_boot)
		QLog("demo: attract loop started\n");
	else if (!QLoadMap(mapname))
	{
		"Quake: could not load %s\n", mapname;
		return;
	}

	//Explicit, not initialisers: a global's declaration initialiser is not
	//honoured, so both are whatever the loader left in memory until set.
	q_state       = QST_MENU;
	q_menu_ingame = FALSE;

	q_canvas = QDrawNew(q_res_w[q_opt_res], q_res_h[q_opt_res]);
	q_ready  = FALSE;

	//Checkpoints. The heap is intact at startup by definition, so the first of
	//these that reports corruption brackets where it happened.
	QHeapCheck("startup");

	MenuPush(
		"File {"
		"  Exit(,CH_ESC);"
		"}"
	);
	SettingsPush;

	try
	{
		Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_FOCUS -
						  WIF_SELF_GRAB_SCROLL - WIF_FOCUS_TASK_MENU;
		AutoComplete;
		WinBorder;
		WinMax;
		DocCursor;
		DocClear;

		QCenterView(Fs);

		//Raw mode gives relative deltas and stops clicks reaching the window
		//manager. It must be turned back off on every exit path.
		raw_was_on = MouseRaw(TRUE);
		MouseRawReset;

		Fs->draw_it = &QDrawIt;

		//The wheel needs no baseline now: raw_data.z is a delta that the frame
		//loop's own MouseRawReset clears, not an absolute position. Anything
		//accumulated before the loop starts is discarded here so entering the
		//game cannot arrive as one large scroll.
		MouseRawReset;

		//The button LEVELS are cleared too. MouseRawReset does not touch them,
		//so a click landing just before raw mode was entered would read as
		//fire held down on the first frame.
		mouse_hard.bttns[0] = FALSE;
		mouse_hard.bttns[1] = FALSE;
		mouse_hard.bttns[2] = FALSE;

		QGameLoop;
	}
	catch
		PutExcept;

	//--- teardown ---
	//QDrawIt runs on the window manager task and the blit is long, so the
	//compositor is very often executing inside it. Detaching the callback is
	//NOT enough on its own: an already-entered QDrawIt keeps running. So stop
	//it drawing, detach, let the in-flight call drain, and only then free.
	q_ready     = FALSE;
	Fs->draw_it = NULL;
	Sleep(100);

	//Clear each global before releasing it, so even a late QDrawIt sees NULL
	//rather than a dangling pointer.
	canvas   = q_canvas;
	q_canvas = NULL;
	vis      = q_vis;
	q_vis    = NULL;
	map      = q_map;
	q_map    = NULL;

	if (!raw_was_on)
		MouseRaw(FALSE);

	SettingsPop;
	MenuPop;

	//Capture the VM stats before shutdown clears them. Startup messages are
	//wiped by DocClear when the window opens, so this summary printed after
	//the game exits is the only way to actually read them.
	final_active  = q_game_active;
	final_edicts  = q_pr_num_edicts;
	final_thinks  = q_game_thinks;
	final_time    = q_game_time;
	final_models  = q_precache_model_count;

	final_snd      = q_snd_played;
	final_drop     = q_snd_dropped;
	final_move_ok  = q_move_ok;
	final_move_fail = q_move_fail;
	final_errors    = q_pr_errors;

	//Teardown is breadcrumbed and flushed after every step, so the last line in
	//QUAKELOG.TXT names the step that was running if it faults.
	QHeapCheck("teardown");

	QLog("teardown: begin\n");
	QLogFlush;

	//The QuakeC world holds precached models and points at the map, so it is
	//torn down before the map itself.
	QGameShutdown;
	QLog("teardown: QGameShutdown ok\n");
	QLogFlush;

	QMusicFree;
	QSndFree;
	QLog("teardown: QSndFree ok\n");
	QLogFlush;

	//The socket outlives the app if it is not closed - it is registered with the
	//net stack, not with this task.
	QNetUdpClose;
	QMdlPreviewFree;
	QLog("teardown: net/preview ok\n");
	QLogFlush;

	//Entities hold alias models that borrow nothing from the map, but they are
	//released first so nothing outlives the map it was spawned from.
	QEntFree;
	QLog("teardown: QEntFree ok\n");
	QLogFlush;

	//The surface cache holds up to 512 lit-surface blocks and a slot table
	//sized to the map's face count. Both are allocated during rendering, so a
	//session that never left the menu has none of it - and neither had any of
	//it ever been released.
	QSurfCacheFlush;
	QSurfCacheSetMap(NULL);
	QLog("teardown: QSurfCacheFlush ok\n");
	QLogFlush;

	QDrawFree(canvas);
	QLog("teardown: QDrawFree ok\n");
	QLogFlush;

	QVisFree(vis);
	QLog("teardown: QVisFree ok\n");
	QLogFlush;

	QBSPFree(map);
	QLog("teardown: QBSPFree ok\n");

	//Last, because the precache and the static entity list both point into it.
	QMdlCacheFree;
	QLog("teardown: QMdlCacheFree ok\n");
	QLogFlush;

	StrPrint(line, "exit: %d frames rendered\n", q_frame_count);
	QLog(line);

	if (final_active)
	{
		StrPrint(line, "QuakeC: %d edicts, %d models precached\n",
			final_edicts, final_models);
		QLog(line);
		StrPrint(line, "QuakeC: %d thinks over %4.1f s of game time\n",
			final_thinks, final_time);
		QLog(line);

		//Only four mixer streams exist, so drops are expected in a firefight.
		//A zero played count means the audio path never worked at all.
		StrPrint(line, "sound: %d played, %d dropped (4 streams)\n",
			final_snd, final_drop);
		QLog(line);




		//Total VM errors, including the ones the console suppressed. A large
		//number here with a healthy think count means errors are being
		//survived; a large number with a low think count means they are not.
		StrPrint(line, "QuakeC errors: %d\n", final_errors);
		QLog(line);

		//Spawning but never thinking is a different fault from failing to
		//spawn at all, so it is called out rather than left to be inferred.
		if (final_thinks == 0)
			QLog("QuakeC: WARNING - nothing ever thought. Check nextthink.\n");
	}
	else
		QLog("QuakeC: did not load - entities were static\n");

	//Written LAST so the file distinguishes "died during teardown" from "died
	//on the way out of the function". Everything above this line completing and
	//this line missing means the fault is after all of our own cleanup.
	QHeapCheck("returning");

	QLog("teardown: returning\n");
	QLogFlush;

	"\nLog written to ::/Apps/Quake/QUAKELOG.TXT\n";

	//Anything queued during teardown must not reach the shell either, and the
	//cursor is parked only once nothing further will write to the document.
	QInputDrainAll;
	QDocCursorPark;

	//THIS IS WHY EXITING FAULTED IN ExeCmdLine.
	//
	//The shell is part way through ExeCmdLine executing the line that started
	//this program, and its lexer holds cur_entry pointing at an entry in the
	//terminal document. Each iteration it rebuilds the task title by walking
	//from that entry:
	//
	//    doc_e = cc->lex_include_stack->cur_entry;
	//    while (doc_e != doc && ptr2 < ptr3)
	//        switch (doc_e->type_u8) ...
	//
	//DocClear in the setup above removes every entry in that document, so the
	//pointer the shell is holding refers to memory that has been handed back.
	//The walk then reads a freed entry, and the fault address is whatever
	//happened to be reused - deterministic, and nowhere near this code.
	//
	//The walk only runs while title_src is TTS_CUR_LEX. Locking the title
	//skips it entirely, and ExeCmdLine restores the previous value when its
	//own loop finishes, so the scope is exactly the remaining iterations.
	Fs->title_src = TTS_LOCKED_CONST;

	//Settle before handing the task back. The window manager, the mixer and
	//the block cache all run on their own tasks and may still hold work that
	//refers to this one - the compositor in particular is detached above but
	//an already-entered callback finishes on its own schedule.
	Sleep(200);

}
