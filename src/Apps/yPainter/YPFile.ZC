//Disk formats. Depends on YPDef, YPImage, YPBrush, YPTool.
//
//.YPT is the native layered format (see CYPFileHdr in YPImage). Import goes
//through the stock decoders; export writes uncompressed 32-bit TGA and the
//flat screen-sized .GR32 the 32BitPaint demo reads.

U0 YPExtGet(U8 *filename, U8 *dst)
{//Uppercased extension, empty when the name has none.
	I64 i = StrLen(filename) - 1, j = 0;

	dst[0] = 0;
	while (i >= 0 && filename[i] != '.' && filename[i] != '/')
		i--;
	if (i < 0 || filename[i] != '.')
		return;
	i++;
	while (filename[i] && j < 15)
	{
		if ('a' <= filename[i] <= 'z')
			dst[j] = filename[i] - 'a' + 'A';
		else
			dst[j] = filename[i];
		i++;
		j++;
	}
	dst[j] = 0;
}

U32 *YPDCToARGB(CDC *dc, I64 *_w, I64 *_h)
{//Stock decoders hand back a CDC: 0x00RRGGBB body, PIXF_TRANSPARENT for holes.
	I64  x, y, w, h;
	U32 *out, p;

	if (!dc)
		return NULL;
	w = dc->width;
	h = dc->height;
	out = MAlloc(w * h * sizeof(U32));
	for (y = 0; y < h; y++)
		for (x = 0; x < w; x++)
		{
			p = dc->body[y * dc->width_internal + x];
			if (p == PIXF_TRANSPARENT)
				out[y * w + x] = 0;
			else
				out[y * w + x] = 0xFF000000 | (p & 0x00FFFFFF);
		}
	*_w = w;
	*_h = h;

	return out;
}

U32 *YPLoadImageARGB(U8 *filename, I64 *_w, I64 *_h)
{//Returns a MAlloced 0xAARRGGBB buffer, or NULL.
	U8	 ext[16];
	CDC *dc = NULL;
	U32 *px;

	YPExtGet(filename, ext);

	if (!StrCompare(ext, "PNG"))
	{
		px = PNGReadRGBA(filename, _w, _h);
		if (px)
			return px;
		dc = PNGRead(filename);
	}
	else if (!StrCompare(ext, "JPG") || !StrCompare(ext, "JPEG"))
		dc = JPGRead(filename);
	else if (!StrCompare(ext, "WEBP"))
		dc = WEBPRead(filename);
	else if (!StrCompare(ext, "GIF"))
		dc = GIFRead(filename);
	else if (!StrCompare(ext, "TGA"))
		dc = TGARead(filename);
	else
		return NULL;

	if (!dc)
		return NULL;
	px = YPDCToARGB(dc, _w, _h);
	DCDel(dc);

	return px;
}

Bool YPImportImage(U8 *filename, Bool resize_doc)
{//Places the image at the top left of a new layer above the active one.
	I64  w, h, x, y, cw, ch, at;
	U32 *px = YPLoadImageARGB(filename, &w, &h);
	U8	 name[YP_NAME_LEN];

	if (!px)
		return FALSE;

	YPUndoPushDoc("Import");
	if (resize_doc)
		YPDocResize(w, h);

	YPSetName(name, filename);
	at = YPLayerAdd(name, yp.cur);
	if (at < 0)
	{
		Free(px);
		return FALSE;
	}
	yp.cur = at;

	cw = MinI64(w, yp.doc_w);
	ch = MinI64(h, yp.doc_h);
	for (y = 0; y < ch; y++)
		for (x = 0; x < cw; x++)
			yp.layer[at].px[y * yp.doc_w + x] = px[y * w + x];

	Free(px);
	YPDirtyAll;
	yp.modified = TRUE;

	return TRUE;
}

Bool YPSaveYPT(U8 *filename)
{
	I64  size;
	U8	*buf = YPDocSerialize(&size);
	Bool ok;

	ok = FileWrite(filename, buf, size) > 0;
	Free(buf);
	if (ok)
	{
		StrCopy(yp.file, filename);
		yp.modified = FALSE;
	}

	return ok;
}

Bool YPLoadYPT(U8 *filename)
{
	I64  size = 0;
	U8	*buf = FileRead(filename, &size);
	Bool ok;

	if (!buf)
		return FALSE;
	ok = YPDocDeserialize(buf, size);
	Free(buf);
	if (ok)
	{
		StrCopy(yp.file, filename);
		yp.modified = FALSE;
		YPUndoClear;
	}

	return ok;
}

U0 YPFlattenTo(U32 *dst)
{//Composite every visible layer into a doc-sized 0xAARRGGBB buffer.
	YPDirtyAll;
	YPCompositeFlush;
	MemCopy(dst, yp.comp, yp.doc_w * yp.doc_h * sizeof(U32));
}

Bool YPExportTGA(U8 *filename)
{//Uncompressed 32-bit BGRA, top-left origin.
	I64  w = yp.doc_w, h = yp.doc_h, i, n = w * h, size;
	U8	*buf, *p;
	U32 *flat, c;
	Bool ok;

	size = 18 + n * 4;
	buf = CAlloc(size);
	buf[2]	= 2;			//uncompressed truecolor
	buf[12] = w & 0xFF;
	buf[13] = w >> 8 & 0xFF;
	buf[14] = h & 0xFF;
	buf[15] = h >> 8 & 0xFF;
	buf[16] = 32;			//bits per pixel
	buf[17] = 0x28;			//8 alpha bits, origin top-left

	flat = MAlloc(n * sizeof(U32));
	YPFlattenTo(flat);

	p = buf + 18;
	for (i = 0; i < n; i++)
	{
		c = flat[i];
		*p++ = c	   & 0xFF;	//B
		*p++ = c >> 8  & 0xFF;	//G
		*p++ = c >> 16 & 0xFF;	//R
		*p++ = c >> 24 & 0xFF;	//A
	}

	ok = FileWrite(filename, buf, size) > 0;
	Free(flat);
	Free(buf);

	return ok;
}

Bool YPExportGR32(U8 *filename)
{//Screen-sized raw 0x00RRGGBB, the layout 32BitPaint.ZC reads back.
	I64  sw = sys_framebuffer_width, x, y, cw, ch, n = yp.doc_w * yp.doc_h;
	U32 *fb, *flat, c;
	Bool ok;

	fb = MAlloc(text.buffer_size);
	MemSetU32(fb, WHITE32, text.buffer_size / sizeof(U32));
	flat = MAlloc(n * sizeof(U32));
	YPFlattenTo(flat);

	cw = MinI64(yp.doc_w, sw);
	ch = MinI64(yp.doc_h, text.buffer_size / sizeof(U32) / sw);
	for (y = 0; y < ch; y++)
		for (x = 0; x < cw; x++)
		{
			c = flat[y * yp.doc_w + x];
			//Composite over the white page: .GR32 carries no alpha.
			fb[y * sw + x] = YPOver(0xFFFFFFFF, c, 255) & 0x00FFFFFF;
		}

	ok = FileWrite(filename, fb, text.buffer_size) > 0;
	Free(flat);
	Free(fb);

	return ok;
}

Bool YPImportGR32(U8 *filename)
{//Screen-sized raw pixels; the whole frame becomes one opaque layer.
	I64  size = 0, sw = sys_framebuffer_width, sh, x, y, at;
	U32 *fb = FileRead(filename, &size);

	if (!fb)
		return FALSE;
	sh = size / sizeof(U32) / sw;
	if (sh < 1)
	{
		Free(fb);
		return FALSE;
	}

	YPUndoPushDoc("Load GR32");
	at = YPLayerAdd("GR32", yp.cur);
	if (at < 0)
	{
		Free(fb);
		return FALSE;
	}
	yp.cur = at;
	for (y = 0; y < MinI64(sh, yp.doc_h); y++)
		for (x = 0; x < MinI64(sw, yp.doc_w); x++)
			yp.layer[at].px[y * yp.doc_w + x] =
				0xFF000000 | (fb[y * sw + x] & 0x00FFFFFF);

	Free(fb);
	YPDirtyAll;
	yp.modified = TRUE;

	return TRUE;
}
