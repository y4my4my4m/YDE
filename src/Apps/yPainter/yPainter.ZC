//yPainter app shell: menu, input dispatch, main loop. Depends on every other
//YP file.
//
//Run: ExeFile("::/Apps/yPainter/Run");  (or the YDE start menu)
//F1 in the app lists the keys.

I64  yp_shape_save;
Bool yp_aa_save;
I64  yp_move_x0, yp_move_y0;
Bool yp_move_drag;
I64  yp_sc_space;	//no SC_ define for space; derived from CH_SPACE

Bool YPHeld(I64 sc)
{
	return Bt(kbd.down_bitmap, sc) != 0;
}

Bool YPSpaceHeld()
{
	return YPHeld(yp_sc_space);
}

Bool YPAltHeld()
{
	return YPHeld(SC_ALT);
}

Bool YPShiftHeld()
{
	return YPHeld(SC_SHIFT);
}

U0 YPInit()
{//ZealC leaves file-scope storage as whatever was in the heap, so everything
//this app reads before writing has to be set here.
	YPNamesInit;
	YPZoomTableInit;
	MemSet(&yp, 0, sizeof(CYPGlobals));
	yp_shape_save = YPS_ROUND;
	yp_aa_save	  = TRUE;
	yp_move_x0	  = 0;
	yp_move_y0	  = 0;
	yp_move_drag  = FALSE;
	yp_undo_bytes = 0;
	yp_sc_space   = Char2ScanCode(CH_SPACE);

	yp.c_bg 	= ColorRGB(0x10, 0x12, 0x18);
	yp.c_panel	= ColorRGB(0x1E, 0x21, 0x2B);
	yp.c_edge	= ColorRGB(0x3A, 0x40, 0x50);
	yp.c_hi 	= ColorRGB(0xE8, 0xEC, 0xF4);
	yp.c_text	= ColorRGB(0xD8, 0xDE, 0xEA);
	yp.c_dim	= ColorRGB(0x8A, 0x93, 0xA6);
	yp.c_accent = ColorRGB(0x3C, 0xA6, 0xFF);
	yp.c_btn	= ColorRGB(0x2A, 0x2F, 0x3C);
	yp.c_btn_hi = ColorRGB(0x38, 0x3F, 0x50);
	yp.c_sel	= ColorRGB(0x2C, 0x3E, 0x58);
	yp.c_chk1	= ColorRGB(0x66, 0x66, 0x66);
	yp.c_chk2	= ColorRGB(0x99, 0x99, 0x99);

	yp.tool 	 = YPT_BRUSH;
	yp.tool_prev = YPT_BRUSH;
	yp.shape	 = YPS_ROUND;
	yp.size 	 = 24;
	yp.hardness  = 60;
	yp.opacity	 = 255;
	yp.flow 	 = 255;
	yp.spacing	 = 5;
	yp.anti_alias = TRUE;
	yp.fill_tol   = 24;
	yp.fill_shapes = FALSE;
	yp.sample_merged = TRUE;
	yp.has_last   = FALSE;
	yp.panels	 = TRUE;
	yp.zoom_i	 = 6;
	yp.zoom_num  = 1;
	yp.zoom_den  = 1;
	yp.stamp_dirty = TRUE;

	yp.fg = 0xFF202028;
	yp.bg = 0xFFFFFFFF;
	YPRGB2HSV(yp.fg, &yp.hue, &yp.sat, &yp.val);

	yp.swatch[0]  = 0xFF000000;
	yp.swatch[1]  = 0xFFFFFFFF;
	yp.swatch[2]  = 0xFF3FA9F5;
	yp.swatch[3]  = 0xFF7FD0FF;
	yp.swatch[4]  = 0xFFB8E4FF;
	yp.swatch[5]  = 0xFFE8F6FF;
	yp.swatch[6]  = 0xFF1B6EA8;
	yp.swatch[7]  = 0xFF0E3F63;
	yp.swatch[8]  = 0xFF6FA85A;
	yp.swatch[9]  = 0xFF9CC96E;
	yp.swatch[10] = 0xFF4A7A3C;
	yp.swatch[11] = 0xFF2C4F27;
	yp.swatch[12] = 0xFFE8DCC0;
	yp.swatch[13] = 0xFFCBB894;
	yp.swatch[14] = 0xFFA08A66;
	yp.swatch[15] = 0xFF6E5B42;
	yp.swatch[16] = 0xFFF2C97A;
	yp.swatch[17] = 0xFFE08A4C;
	yp.swatch[18] = 0xFFB4503C;
	yp.swatch[19] = 0xFF6E2C33;
	yp.swatch[20] = 0xFFCFD8E3;
	yp.swatch[21] = 0xFF97A3B5;
	yp.swatch[22] = 0xFF5C6678;
	yp.swatch[23] = 0xFF2E3542;

	StrCopy(yp.dir, "::/Home/");
	StrCopy(yp.file, "");
	YPStatus("F1 for keys");

	YPDocNew(GR_WIDTH, GR_HEIGHT - 120);
	YPStampBuild;
	YPUndoClear;
}

U0 YPMenuPush()
{//Native ZealOS pull-down menu. Entry names lex as identifiers, so no spaces.
	MenuPush("File {"
			 "  New(MESSAGE_CMD,YPM_NEW);"
			 "  Open(MESSAGE_CMD,YPM_OPEN);"
			 "  Save(MESSAGE_CMD,YPM_SAVE);"
			 "  SaveAs(MESSAGE_CMD,YPM_SAVEAS);"
			 "  OpenImage(MESSAGE_CMD,YPM_IMPORT);"
			 "  ImportAsLayer(MESSAGE_CMD,YPM_IMPORT_LAYER);"
			 "  OpenGR32(MESSAGE_CMD,YPM_OPEN_GR32);"
			 "  ExportTGA(MESSAGE_CMD,YPM_EXPORT_TGA);"
			 "  ExportGR32(MESSAGE_CMD,YPM_EXPORT_GR32);"
			 "  Exit(MESSAGE_CMD,YPM_EXIT);"
			 "}"
			 "Edit {"
			 "  Undo(MESSAGE_CMD,YPM_UNDO);"
			 "  Redo(MESSAGE_CMD,YPM_REDO);"
			 "  ClearLayer(MESSAGE_CMD,YPM_CLEAR);"
			 "  FillForeground(MESSAGE_CMD,YPM_FILLFG);"
			 "  FillBackground(MESSAGE_CMD,YPM_FILLBG);"
			 "  SwapColors(MESSAGE_CMD,YPM_SWAPCOL);"
			 "}"
			 "Layer {"
			 "  New(MESSAGE_CMD,YPM_LAYER_NEW);"
			 "  Duplicate(MESSAGE_CMD,YPM_LAYER_DUP);"
			 "  Delete(MESSAGE_CMD,YPM_LAYER_DEL);"
			 "  MoveUp(MESSAGE_CMD,YPM_LAYER_UP);"
			 "  MoveDown(MESSAGE_CMD,YPM_LAYER_DOWN);"
			 "  MergeDown(MESSAGE_CMD,YPM_LAYER_MERGE);"
			 "  Flatten(MESSAGE_CMD,YPM_LAYER_FLATTEN);"
			 "  Rename(MESSAGE_CMD,YPM_LAYER_RENAME);"
			 "  ToggleVisible(MESSAGE_CMD,YPM_LAYER_HIDE);"
			 "  AlphaLock(MESSAGE_CMD,YPM_LAYER_ALPHALOCK);"
			 "  ClipToBelow(MESSAGE_CMD,YPM_LAYER_CLIP);"
			 "  Blend {"
			 "    Normal(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_NORMAL);"
			 "    Multiply(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_MULTIPLY);"
			 "    Screen(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_SCREEN);"
			 "    Overlay(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_OVERLAY);"
			 "    Darken(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_DARKEN);"
			 "    Lighten(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_LIGHTEN);"
			 "    Add(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_ADD);"
			 "    Subtract(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_SUBTRACT);"
			 "    Difference(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_DIFFERENCE);"
			 "    Dodge(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_DODGE);"
			 "    Burn(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_BURN);"
			 "    HardLight(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_HARDLIGHT);"
			 "    SoftLight(MESSAGE_CMD,YPM_LAYER_BLEND+YPB_SOFTLIGHT);"
			 "  }"
			 "}"
			 "Image {"
			 "  Resize(MESSAGE_CMD,YPM_IMG_RESIZE);"
			 "  FlipHorizontal(MESSAGE_CMD,YPM_IMG_FLIPH);"
			 "  FlipVertical(MESSAGE_CMD,YPM_IMG_FLIPV);"
			 "  Blur(MESSAGE_CMD,YPM_IMG_BLUR);"
			 "  HueSaturation(MESSAGE_CMD,YPM_IMG_HSV);"
			 "  Brightness(MESSAGE_CMD,YPM_IMG_BRIGHT);"
			 "  Desaturate(MESSAGE_CMD,YPM_IMG_DESAT);"
			 "  Invert(MESSAGE_CMD,YPM_IMG_INVERT);"
			 "}"
			 "View {"
			 "  ZoomIn(MESSAGE_CMD,YPM_VIEW_IN);"
			 "  ZoomOut(MESSAGE_CMD,YPM_VIEW_OUT);"
			 "  FitToWindow(MESSAGE_CMD,YPM_VIEW_FIT);"
			 "  ActualSize(MESSAGE_CMD,YPM_VIEW_1_1);"
			 "  Center(MESSAGE_CMD,YPM_VIEW_CENTER);"
			 "  TogglePanels(MESSAGE_CMD,YPM_VIEW_PANELS);"
			 "}"
			 "Brush {"
			 "  NextShape(MESSAGE_CMD,YPM_BRUSH_SHAPE);"
			 "  Bigger(MESSAGE_CMD,YPM_BRUSH_BIGGER);"
			 "  Smaller(MESSAGE_CMD,YPM_BRUSH_SMALLER);"
			 "  Harder(MESSAGE_CMD,YPM_BRUSH_HARDER);"
			 "  Softer(MESSAGE_CMD,YPM_BRUSH_SOFTER);"
			 "  FillShapes(MESSAGE_CMD,YPM_BRUSH_FILL);"
			 "  AntiAlias(MESSAGE_CMD,YPM_BRUSH_AA);"
			 "  SampleMerged(MESSAGE_CMD,YPM_BRUSH_MERGED);"
			 "}"
			 "Help {"
			 "  Keys(MESSAGE_CMD,YPM_HELP_KEYS);"
			 "  About(MESSAGE_CMD,YPM_HELP_ABOUT);"
			 "}");
	LBtr(&Fs->win_inhibit, WIf_FOCUS_TASK_MENU);
}

U0 YPHelpKeys()
{
	PopUpOk("$$LTCYAN$$yPainter keys$$FG$$\n\n"
			"$$GREEN$$B$$FG$$ brush   $$GREEN$$N$$FG$$ pencil  "
			"$$GREEN$$E$$FG$$ eraser  $$GREEN$$G$$FG$$ fill\n"
			"$$GREEN$$I$$FG$$ picker  $$GREEN$$L$$FG$$ line    "
			"$$GREEN$$U$$FG$$ rect    $$GREEN$$O$$FG$$ ellipse\n"
			"$$GREEN$$R$$FG$$ gradient  $$GREEN$$V$$FG$$ move  "
			"$$GREEN$$H$$FG$$ pan\n\n"
			"$$GREEN$$[ ]$$FG$$ size   $$GREEN$${ }$$FG$$ hardness  "
			"$$GREEN$$P$$FG$$ next tip\n"
			"$$GREEN$$X$$FG$$ swap colors    $$GREEN$$D$$FG$$ default colors\n"
			"$$GREEN$$F$$FG$$ fill shapes    $$GREEN$$A$$FG$$ antialias  "
			"$$GREEN$$S$$FG$$ sample merged\n\n"
			"$$YELLOW$$Hold SPACE$$FG$$ and drag to pan the canvas\n"
			"$$YELLOW$$Hold ALT$$FG$$ (or right-click) to pick a colour\n"
			"$$YELLOW$$Hold SHIFT$$FG$$ to draw a line from the last stroke,\n"
			"  or to lock a shape square and a line to 45 degrees\n"
			"$$YELLOW$$Wheel$$FG$$ pans, $$YELLOW$$Ctrl-wheel$$FG$$ zooms, "
			"$$YELLOW$$Shift-wheel$$FG$$ resizes the tip\n\n"
			"$$BLUE$$+ -$$FG$$ zoom   $$BLUE$$0$$FG$$ fit   $$BLUE$$1$$FG$$ actual size\n"
			"$$BLUE$$TAB$$FG$$ hide panels   $$BLUE$$DEL$$FG$$ clear layer\n"
			"$$BLUE$$PGUP/PGDN$$FG$$ select layer\n"
			"$$BLUE$$CTRL-Z$$FG$$ undo  $$BLUE$$CTRL-Y$$FG$$ redo\n"
			"$$BLUE$$CTRL-N/O/S$$FG$$ new, open, save\n"
			"$$BLUE$$CTRL-SHIFT-N$$FG$$ add layer  $$BLUE$$CTRL-E$$FG$$ merge down\n"
			"$$BLUE$$CTRL-G$$FG$$ clip layer to the one below\n\n"
			"$$RED$$SHIFT-ESC$$FG$$ quits.");
}

U0 YPFileNew()
{
	U8	*sw, *sh;
	I64  w, h;

	sw = PopUpGetStr("Width in pixels:");
	if (!sw)
		return;
	sh = PopUpGetStr("Height in pixels:");
	if (!sh)
	{
		Free(sw);
		return;
	}
	w = Str2I64(sw);
	h = Str2I64(sh);
	Free(sw);
	Free(sh);
	if (w < 1 || h < 1)
		return;

	YPDocNew(w, h);
	YPUndoClear;
	yp.need_fit = TRUE;
	StrCopy(yp.file, "");
	yp.modified = FALSE;
	YPViewFit;
	YPStatus("New %dx%d", yp.doc_w, yp.doc_h);
}

U0 YPFileSaveAs()
{
	U8 *tmp = PopUpFileName(yp.dir), *name;

	if (!tmp)
		return;
	name = ExtChange(tmp, "YPT");
	Free(tmp);
	if (YPSaveYPT(name))
		YPStatus("Saved %s", name);
	else
		YPStatus("Save failed");
	Free(name);
}

U0 YPFileSave()
{
	if (!yp.file[0])
	{
		YPFileSaveAs;
		return;
	}
	if (YPSaveYPT(yp.file))
		YPStatus("Saved %s", yp.file);
	else
		YPStatus("Save failed");
}

U0 YPFileOpen()
{
	U8 *f = PopUpPickFile(yp.dir);

	if (!f)
		return;
	if (YPLoadYPT(f))
	{
		YPViewFit;
		YPStatus("Loaded %s", f);
	}
	else
		YPStatus("Not a .YPT file");
	Free(f);
}

U0 YPFileImport(Bool as_layer)
{
	U8 *f = PopUpPickFile(yp.dir);

	if (!f)
		return;
	if (YPImportImage(f, !as_layer))
	{
		if (!as_layer)
			YPViewFit;
		YPStatus("Imported %s", f);
	}
	else
		YPStatus("Cannot decode %s", f);
	Free(f);
}

U0 YPFileOpenGR32()
{
	U8 *f = PopUpPickFile(yp.dir);

	if (!f)
		return;
	if (YPImportGR32(f))
		YPStatus("Loaded %s", f);
	else
		YPStatus("Cannot read %s", f);
	Free(f);
}

U0 YPFileExport(Bool tga)
{
	U8 *tmp = PopUpFileName(yp.dir), *name;
	Bool ok;

	if (!tmp)
		return;
	if (tga)
		name = ExtChange(tmp, "TGA");
	else
		name = ExtChange(tmp, "GR32");
	Free(tmp);

	if (tga)
		ok = YPExportTGA(name);
	else
		ok = YPExportGR32(name);
	if (ok)
		YPStatus("Exported %s", name);
	else
		YPStatus("Export failed");
	Free(name);
}

U0 YPImageResize()
{
	U8	*sw, *sh;
	I64  w, h;

	sw = PopUpGetStr("New width:");
	if (!sw)
		return;
	sh = PopUpGetStr("New height:");
	if (!sh)
	{
		Free(sw);
		return;
	}
	w = Str2I64(sw);
	h = Str2I64(sh);
	Free(sw);
	Free(sh);
	if (w < 1 || h < 1)
		return;

	YPUndoPushDoc("Resize");
	YPDocResize(w, h);
	YPViewFit;
	yp.modified = TRUE;
}

U0 YPImageBlur()
{
	U8	*s = PopUpGetStr("Blur radius in pixels:");
	I64  r;

	if (!s)
		return;
	r = Str2I64(s);
	Free(s);
	if (r < 1)
		return;
	YPStatus("Blurring...");
	YPLayerBlur(r);
	YPStatus("Blurred radius %d", ClampI64(r, 1, 200));
}

U0 YPImageHSV()
{
	U8	*sh, *ss;
	I64  dh, ds;

	sh = PopUpGetStr("Hue shift in degrees (-180..180):");
	if (!sh)
		return;
	ss = PopUpGetStr("Saturation change in percent (-100..100):");
	if (!ss)
	{
		Free(sh);
		return;
	}
	dh = Str2I64(sh);
	ds = Str2I64(ss);
	Free(sh);
	Free(ss);
	YPLayerAdjustHSV(dh, ds, 0);
	YPStatus("Hue %+d, saturation %+d%%", dh, ds);
}

U0 YPImageBright()
{
	U8	*s = PopUpGetStr("Brightness change in percent (-100..100):");
	I64  dv;

	if (!s)
		return;
	dv = Str2I64(s);
	Free(s);
	YPLayerAdjustHSV(0, 0, dv);
	YPStatus("Brightness %+d%%", dv);
}

U0 YPLayerRename()
{
	U8 *s = PopUpGetStr("Layer name:");

	if (!s)
		return;
	YPUndoPushDoc("Rename");
	YPSetName(yp.layer[yp.cur].name, s);
	Free(s);
	yp.modified = TRUE;
}

U0 YPZoomStep(I64 d)
{
	YPZoomSet(yp.zoom_i + d, yp.view_w / 2, yp.view_h / 2);
}

U0 YPMenuCmd(I64 cmd)
{
	I64 i;

	if (YPM_LAYER_BLEND <= cmd < YPM_LAYER_BLEND + YPB_COUNT)
	{
		YPUndoPushDoc("Blend");
		yp.layer[yp.cur].blend = cmd - YPM_LAYER_BLEND;
		YPDirtyAll;
		yp.modified = TRUE;
		return;
	}

	switch (cmd)
	{
		case YPM_NEW:			YPFileNew;					break;
		case YPM_OPEN:			YPFileOpen; 				break;
		case YPM_SAVE:			YPFileSave; 				break;
		case YPM_SAVEAS:		YPFileSaveAs;				break;
		case YPM_IMPORT:		YPFileImport(FALSE);		break;
		case YPM_IMPORT_LAYER:	YPFileImport(TRUE); 		break;
		case YPM_EXPORT_TGA:	YPFileExport(TRUE); 		break;
		case YPM_EXPORT_GR32:	YPFileExport(FALSE);		break;
		case YPM_EXIT:			yp.quit = TRUE; 			break;

		case YPM_OPEN_GR32:
			YPFileOpenGR32;
			break;

		case YPM_UNDO:
			if (YPUndo)
				YPStatus("Undo");
			else
				YPStatus("Nothing to undo");
			break;

		case YPM_REDO:
			if (YPRedo)
				YPStatus("Redo");
			else
				YPStatus("Nothing to redo");
			break;

		case YPM_CLEAR:  	YPLayerClear;				break;
		case YPM_FILLFG: 	YPLayerFillAll(yp.fg);		break;
		case YPM_FILLBG: 	YPLayerFillAll(yp.bg);		break;

		case YPM_SWAPCOL:
			i = yp.fg;
			yp.fg = yp.bg;
			yp.bg = i;
			YPColorSet(yp.fg);
			break;

		case YPM_LAYER_NEW:
			YPUndoPushDoc("New layer");
			i = YPLayerAdd("Layer", yp.cur);
			if (i >= 0)
			{
				yp.cur = i;
				YPDirtyAll;
				yp.modified = TRUE;
			}
			else
				YPStatus("Layer limit reached");
			break;

		case YPM_LAYER_DUP:
			YPUndoPushDoc("Duplicate");
			i = YPLayerDup(yp.cur);
			if (i >= 0)
			{
				yp.cur = i;
				YPDirtyAll;
				yp.modified = TRUE;
			}
			break;

		case YPM_LAYER_DEL:
			if (yp.layer_n < 2)
			{
				YPStatus("Cannot delete the last layer");
				break;
			}
			YPUndoPushDoc("Delete layer");
			YPLayerRemove(yp.cur);
			YPDirtyAll;
			yp.modified = TRUE;
			break;

		case YPM_LAYER_UP:
			if (yp.cur < yp.layer_n - 1)
			{
				YPUndoPushDoc("Move layer");
				YPLayerSwap(yp.cur, yp.cur + 1);
				yp.cur++;
				YPDirtyAll;
				yp.modified = TRUE;
			}
			break;

		case YPM_LAYER_DOWN:
			if (yp.cur > 0)
			{
				YPUndoPushDoc("Move layer");
				YPLayerSwap(yp.cur, yp.cur - 1);
				yp.cur--;
				YPDirtyAll;
				yp.modified = TRUE;
			}
			break;

		case YPM_LAYER_MERGE:
			if (yp.cur < 1)
			{
				YPStatus("Nothing below to merge into");
				break;
			}
			YPUndoPushDoc("Merge down");
			YPLayerMergeDown(yp.cur);
			YPDirtyAll;
			yp.modified = TRUE;
			break;

		case YPM_LAYER_FLATTEN:
			YPUndoPushDoc("Flatten");
			YPFlatten;
			YPDirtyAll;
			yp.modified = TRUE;
			break;

		case YPM_LAYER_RENAME:		YPLayerRename;			break;

		case YPM_LAYER_HIDE:
			yp.layer[yp.cur].visible = !yp.layer[yp.cur].visible;
			YPDirtyAll;
			break;

		case YPM_LAYER_ALPHALOCK:
			yp.layer[yp.cur].alpha_lock = !yp.layer[yp.cur].alpha_lock;
			break;

		case YPM_LAYER_CLIP:
			if (!yp.cur)
			{
				YPStatus("The bottom layer has nothing to clip to");
				break;
			}
			yp.layer[yp.cur].clip = !yp.layer[yp.cur].clip;
			if (yp.layer[yp.cur].clip)
				YPStatus("Clipped to %s", yp.layer[yp.cur - 1].name);
			else
				YPStatus("Clipping released");
			YPDirtyAll;
			yp.modified = TRUE;
			break;

		case YPM_IMG_RESIZE:	YPImageResize;				break;
		case YPM_IMG_BLUR:		YPImageBlur;				break;
		case YPM_IMG_HSV:		YPImageHSV; 				break;
		case YPM_IMG_BRIGHT:	YPImageBright;				break;
		case YPM_IMG_DESAT: 	YPLayerDesaturate;			break;
		case YPM_IMG_INVERT:	YPLayerInvert;				break;

		case YPM_IMG_FLIPH:
			YPUndoPushDoc("Flip H");
			YPFlipH;
			yp.modified = TRUE;
			break;

		case YPM_IMG_FLIPV:
			YPUndoPushDoc("Flip V");
			YPFlipV;
			yp.modified = TRUE;
			break;

		case YPM_VIEW_IN:		YPZoomStep(1); 				break;
		case YPM_VIEW_OUT:		YPZoomStep(-1);				break;
		case YPM_VIEW_FIT:		YPViewFit;					break;

		case YPM_VIEW_1_1:
			YPZoomSet(6, yp.view_w / 2, yp.view_h / 2);
			break;

		case YPM_VIEW_CENTER:	YPViewCenter;				break;

		case YPM_VIEW_PANELS:
			yp.panels = !yp.panels;
			break;

		case YPM_BRUSH_SHAPE:
			YPBrushShapeSet((yp.shape + 1) % YPS_COUNT);
			YPStatus("Tip: %s", yp_shape_name[yp.shape]);
			break;

		case YPM_BRUSH_FILL:
			yp.fill_shapes = !yp.fill_shapes;
			if (yp.fill_shapes)
				YPStatus("Shapes filled");
			else
				YPStatus("Shapes outlined");
			break;

		case YPM_BRUSH_AA:
			yp.anti_alias = !yp.anti_alias;
			yp.stamp_dirty = TRUE;
			YPStampBuild;
			if (yp.anti_alias)
				YPStatus("Antialias on");
			else
				YPStatus("Antialias off");
			break;

		case YPM_BRUSH_MERGED:
			yp.sample_merged = !yp.sample_merged;
			if (yp.sample_merged)
				YPStatus("Sample merged");
			else
				YPStatus("Sample active layer");
			break;

		case YPM_BRUSH_BIGGER:	YPBrushSizeSet(yp.size + 1);		break;
		case YPM_BRUSH_SMALLER: YPBrushSizeSet(yp.size - 1);		break;
		case YPM_BRUSH_HARDER:	YPBrushHardnessSet(yp.hardness + 5);break;
		case YPM_BRUSH_SOFTER:	YPBrushHardnessSet(yp.hardness - 5);break;

		case YPM_HELP_KEYS: 	YPHelpKeys; 				break;

		case YPM_HELP_ABOUT:
			PopUpOk("$$LTCYAN$$yPainter$$FG$$\n\n"
					"Layered 32-bit paint for ZealOS.\n"
					"Truecolor layers, 13 blend modes, per-pixel alpha.\n\n"
					"Native format .YPT, exports .TGA and .GR32.");
			break;
	}
}

U0 YPToolSet(I64 t)
{
	if (t == yp.tool)
		return;
	yp.tool_prev = yp.tool;
	yp.tool = ClampI64(t, 0, YPT_COUNT - 1);
	YPStatus("%s", yp_tool_name[yp.tool]);
}

U0 YPPencilPush()
{//Pencil is the brush with an aliased single-pixel-edge tip.
	yp_shape_save = yp.shape;
	yp_aa_save	  = yp.anti_alias;
	yp.shape	  = YPS_PIXEL;
	yp.anti_alias = FALSE;
	yp.stamp_dirty = TRUE;
	YPStampBuild;
}

U0 YPPencilPop()
{
	yp.shape	  = yp_shape_save;
	yp.anti_alias = yp_aa_save;
	yp.stamp_dirty = TRUE;
	YPStampBuild;
}

U0 YPSliderApply(I64 id, I64 mx)
{
	switch (id)
	{
		case YPDRAG_SIZE:
			YPBrushSizeSet(YPSliderVal(yp_sl[id], mx, YP_SIZE_MIN,
									   YP_SIZE_MAX));
			break;
		case YPDRAG_HARD:
			YPBrushHardnessSet(YPSliderVal(yp_sl[id], mx, 0, 100));
			break;
		case YPDRAG_OPAC:
			yp.opacity = YPSliderVal(yp_sl[id], mx, 0, 255);
			break;
		case YPDRAG_FLOW:
			yp.flow = YPSliderVal(yp_sl[id], mx, 1, 255);
			break;
		case YPDRAG_SPACE:
			yp.spacing = YPSliderVal(yp_sl[id], mx, 1, 200);
			break;
		case YPDRAG_TOL:
			yp.fill_tol = YPSliderVal(yp_sl[id], mx, 0, 255);
			break;
		case YPDRAG_LOPAC:
			yp.layer[yp.cur].opacity = YPSliderVal(yp_sl[id], mx, 0, 255);
			YPDirtyAll;
			yp.modified = TRUE;
			break;
	}
}

U0 YPColorDrag(I64 id, I64 mx, I64 my)
{
	I64 *r = yp_sl[id];

	if (id == YPDRAG_SV)
	{
		yp.sat = ClampI64(mx - r[0], 0, r[2] - 1) / (r[2] - 1.0);
		yp.val = 1.0 - ClampI64(my - r[1], 0, r[3] - 1) / (r[3] - 1.0);
	}
	else
		yp.hue = 360.0 * ClampI64(my - r[1], 0, r[3] - 1) / (r[3] - 1.0);
	YPColorFromHSV;
	yp_sv_dirty = TRUE;
}

U0 YPNavClick(I64 mx, I64 my)
{//Centres the view on the clicked point of the thumbnail.
	I64 x = yp.px0 + 8, y = yp.nav_y + 4, sw, sh, dx, dy;

	if (yp.doc_w * YP_THUMB_H > yp.doc_h * YP_THUMB_W)
	{
		sw = YP_THUMB_W;
		sh = yp.doc_h * YP_THUMB_W / yp.doc_w;
	}
	else
	{
		sh = YP_THUMB_H;
		sw = yp.doc_w * YP_THUMB_H / yp.doc_h;
	}
	if (sw < 1 || sh < 1)
		return;

	dx = ClampI64(mx - x, 0, sw - 1) * yp.doc_w / sw;
	dy = ClampI64(my - y, 0, sh - 1) * yp.doc_h / sh;
	yp.pan_x = dx - (yp.view_w / 2) * yp.zoom_den / yp.zoom_num;
	yp.pan_y = dy - (yp.view_h / 2) * yp.zoom_den / yp.zoom_num;
	YPViewFull;
}

U0 YPToolbarClick(I64 mx, I64 my)
{
	I64 i, col, row, bx, by, y0 = yp.py0 + 4, sw = 22, t;

	for (i = 0; i < YPT_COUNT; i++)
	{
		col = i & 1;
		row = i >> 1;
		bx = 3 + col * (YP_TB_BTN + 2);
		by = y0 + row * (YP_TB_BTN + 2);
		if (bx <= mx < bx + YP_TB_BTN && by <= my < by + YP_TB_BTN)
		{
			YPToolSet(i);
			return;
		}
	}

	by = y0 + ((YPT_COUNT + 1) >> 1) * (YP_TB_BTN + 2) + 8;
	if (by <= my < by + sw + 10)
	{
		t = yp.fg;
		yp.fg = yp.bg;
		yp.bg = t;
		YPColorSet(yp.fg);
	}
}

U0 YPLayerBtnClick(I64 mx)
{
	I64 x = yp.px0 + 6, i, bx;

	for (i = 0; i < 6; i++)
	{
		bx = x + 62 + i * 24;
		if (bx <= mx < bx + 22)
		{
			switch (i)
			{
				case 0: YPMenuCmd(YPM_LAYER_NEW);	break;
				case 1: YPMenuCmd(YPM_LAYER_DUP);	break;
				case 2: YPMenuCmd(YPM_LAYER_DEL);	break;
				case 3: YPMenuCmd(YPM_LAYER_UP);	break;
				case 4: YPMenuCmd(YPM_LAYER_DOWN);	break;
				case 5: YPMenuCmd(YPM_LAYER_MERGE); break;
			}
			return;
		}
	}
}

U0 YPLayerListClick(I64 mx, I64 my, Bool right)
{
	I64 x = yp.px0 + 6, ry = yp.lay_y + yp_lay_list, i, li;

	i = (my - ry) / yp_row_h;
	if (i < 0)
		return;
	li = yp.layer_n - 1 - i - yp.lay_scroll;
	if (li < 0 || li >= yp.layer_n)
		return;

	if (x + 3 <= mx < x + 16)
	{
		yp.layer[li].visible = !yp.layer[li].visible;
		YPDirtyAll;
		return;
	}
	if (right)
	{
		yp.cur = li;
		YPLayerRename;
		return;
	}
	yp.cur = li;
}

U0 YPPanBegin()
{
	yp.pan_drag = TRUE;
	yp.pan_ox = yp.pan_x;
	yp.pan_oy = yp.pan_y;
	yp.pan_mx = yp.mx;
	yp.pan_my = yp.my;
}

U0 YPPickAt(I64 dx, I64 dy)
{
	YPColorSet(YPSample(ClampI64(dx, 0, yp.doc_w - 1),
						ClampI64(dy, 0, yp.doc_h - 1), yp.sample_merged));
}

Bool YPStrokeToolAt(I64 dx, I64 dy, Bool erase)
{//Shift continues from where the last stroke ended, so segments can be chained
//into a straight polyline. Returns TRUE when it drew instead of starting a
//drag-able stroke.
	if (yp.has_last && YPShiftHeld())
	{
		YPToolLine(yp.last_x, yp.last_y, dx, dy, yp.fg, erase);
		yp.last_x = dx;
		yp.last_y = dy;
		return TRUE;
	}
	YPStrokeBegin(dx, dy, yp.fg, erase);

	return FALSE;
}

U0 YPCanvasDown(Bool right)
{
	I64 dx = yp.dx, dy = yp.dy;

	//Modifiers outrank the selected tool.
	if (YPSpaceHeld())
	{
		YPPanBegin;
		return;
	}
	if (right || YPAltHeld())
	{
		YPPickAt(dx, dy);
		return;
	}

	switch (yp.tool)
	{
		case YPT_BRUSH:
			YPStrokeToolAt(dx, dy, FALSE);
			break;

		case YPT_PENCIL:
			YPPencilPush;
			if (YPStrokeToolAt(dx, dy, FALSE))
				YPPencilPop;
			break;

		case YPT_ERASER:
			YPStrokeToolAt(dx, dy, TRUE);
			break;

		case YPT_FILL:
			if (yp.in_doc)
			{
				YPFloodFill(dx, dy, yp.fg, yp.fill_tol, yp.sample_merged,
							FALSE);
				YPStatus("Filled");
			}
			break;

		case YPT_PICKER:
			if (yp.in_doc)
				YPPickAt(dx, dy);
			break;

		case YPT_LINE:
		case YPT_RECT:
		case YPT_ELLIPSE:
		case YPT_GRADIENT:
			yp.dragging = TRUE;
			yp.drag_x0 = dx;
			yp.drag_y0 = dy;
			yp.drag_x1 = dx;
			yp.drag_y1 = dy;
			break;

		case YPT_MOVE:
			yp_move_drag = TRUE;
			yp_move_x0 = dx;
			yp_move_y0 = dy;
			break;

		case YPT_PAN:
			YPPanBegin;
			break;
	}
}

U0 YPMouseDown(I64 mx, I64 my, Bool right)
{
	I64 r = YPHitTest(mx, my), i, x, y, sx, sy;

	yp.mx = mx;
	yp.my = my;

	if (YPDRAG_SIZE <= r <= YPDRAG_TOL || r == YPDRAG_LOPAC)
	{
		yp.slider = r;
		YPSliderApply(r, mx);
		return;
	}
	if (r == YPDRAG_SV || r == YPDRAG_HUE)
	{
		yp.slider = r;
		YPColorDrag(r, mx, my);
		return;
	}

	switch (r)
	{
		case YPR_CANVAS:
			YPCanvasDown(right);
			break;

		case YPR_TOOLBAR:
			YPToolbarClick(mx, my);
			break;

		case YPR_OPTIONS:
			if (mx < 90)
			{
				YPBrushShapeSet((yp.shape + 1) % YPS_COUNT);
				YPStatus("Tip: %s", yp_shape_name[yp.shape]);
			}
			break;

		case YPR_NAV:
			YPNavClick(mx, my);
			break;

		case YPR_SWATCH:
			x = yp.px0 + 8;
			y = yp.col_y + YP_SV_H + yp_btn_h + 12;
			for (i = 0; i < YP_SWATCHES; i++)
			{
				sx = x + (i % 8) * 24;
				sy = y + (i / 8) * 18;
				if (sx <= mx < sx + 22 && sy <= my < sy + 16)
				{
					if (right)
						yp.swatch[i] = yp.fg;
					else
						YPColorSet(yp.swatch[i]);
					return;
				}
			}
			//Below the swatch grid sit the foreground and background chips.
			y = yp.col_y + YP_SV_H + 6;
			if (y <= my < y + yp_btn_h)
			{
				if (x <= mx < x + 30)
					YPColorSet(yp.fg);
				else if (x + 34 <= mx < x + 64)
				{
					i = yp.fg;
					yp.fg = yp.bg;
					yp.bg = i;
					YPColorSet(yp.fg);
				}
			}
			break;

		case YPR_LAYERBTN:
			YPLayerBtnClick(mx);
			break;

		case YPR_BLEND:
			if (right)
				yp.layer[yp.cur].alpha_lock = !yp.layer[yp.cur].alpha_lock;
			else
			{
				yp.layer[yp.cur].blend =
					(yp.layer[yp.cur].blend + 1) % YPB_COUNT;
				YPDirtyAll;
				yp.modified = TRUE;
			}
			break;

		case YPR_LAYERS:
			YPLayerListClick(mx, my, right);
			break;
	}
}

U0 YPMouseUp()
{
	if (yp.drawing)
	{
		yp.last_x = yp.stroke_x;
		yp.last_y = yp.stroke_y;
		yp.has_last = TRUE;
		YPStrokeEnd;
		if (yp.tool == YPT_PENCIL)
			YPPencilPop;
	}

	if (yp.dragging)
	{
		yp.dragging = FALSE;
		switch (yp.tool)
		{
			case YPT_LINE:
				YPToolLine(yp.drag_x0, yp.drag_y0, yp.drag_x1, yp.drag_y1,
						   yp.fg, FALSE);
				break;
			case YPT_RECT:
				YPToolRect(yp.drag_x0, yp.drag_y0, yp.drag_x1, yp.drag_y1,
						   yp.fg, FALSE, yp.fill_shapes);
				break;
			case YPT_ELLIPSE:
				YPToolEllipse(yp.drag_x0, yp.drag_y0, yp.drag_x1, yp.drag_y1,
							  yp.fg, FALSE, yp.fill_shapes);
				break;
			case YPT_GRADIENT:
				YPToolGradient(yp.drag_x0, yp.drag_y0, yp.drag_x1, yp.drag_y1,
							   yp.fg, yp.bg, yp.fill_shapes);
				break;
		}
		yp.modified = TRUE;
	}

	if (yp_move_drag)
	{
		yp_move_drag = FALSE;
		if (yp.dx != yp_move_x0 || yp.dy != yp_move_y0)
		{
			YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Move");
			YPLayerOffset(yp.dx - yp_move_x0, yp.dy - yp_move_y0);
		}
	}

	yp.slider	= YPDRAG_NONE;
	yp.pan_drag = FALSE;
}

U0 YPDragConstrain()
{//Shift locks a line to 45 degree steps and a rect or ellipse to square.
//tan(22.5 degrees) is 0.414, the half-angle that splits an axis lock from a
//diagonal one.
	I64 dx = yp.drag_x1 - yp.drag_x0,
		dy = yp.drag_y1 - yp.drag_y0, a;

	if (!yp.drag_shift)
		return;

	if (yp.tool == YPT_LINE || yp.tool == YPT_GRADIENT)
	{
		if (AbsI64(dy) * 1000 < AbsI64(dx) * 414)
			dy = 0;
		else if (AbsI64(dx) * 1000 < AbsI64(dy) * 414)
			dx = 0;
		else
		{
			a = MaxI64(AbsI64(dx), AbsI64(dy));
			if (dx < 0)
				dx = -a;
			else
				dx = a;
			if (dy < 0)
				dy = -a;
			else
				dy = a;
		}
	}
	else
	{
		a = MaxI64(AbsI64(dx), AbsI64(dy));
		if (dx < 0)
			dx = -a;
		else
			dx = a;
		if (dy < 0)
			dy = -a;
		else
			dy = a;
	}

	yp.drag_x1 = yp.drag_x0 + dx;
	yp.drag_y1 = yp.drag_y0 + dy;
}

U0 YPPollMouse()
{
	I64 mx = mouse.pos.x - Fs->pix_left - Fs->scroll_x,
		my = mouse.pos.y - Fs->pix_top  - Fs->scroll_y;

	yp.mx = mx;
	yp.my = my;
	yp.mod_pan	= YPSpaceHeld;
	yp.mod_pick = YPAltHeld;
	yp.region = YPHitTest(mx, my);
	//The hit test only fills dx/dy inside the canvas; a stroke that leaves the
	//viewport still needs live document coordinates.
	yp.dx = YPV2DX(mx - yp.cx);
	yp.dy = YPV2DY(my - yp.cy);

	if (yp.slider == YPDRAG_SV || yp.slider == YPDRAG_HUE)
		YPColorDrag(yp.slider, mx, my);
	else if (yp.slider)
		YPSliderApply(yp.slider, mx);
	else if (yp.drawing)
		YPStrokeTo(yp.dx, yp.dy);
	else if (yp.dragging)
	{
		yp.drag_x1 = yp.dx;
		yp.drag_y1 = yp.dy;
		yp.drag_shift = YPShiftHeld;
		YPDragConstrain;
	}
	else if (yp.pan_drag)
	{
		yp.pan_x = yp.pan_ox - (mx - yp.pan_mx) * yp.zoom_den / yp.zoom_num;
		yp.pan_y = yp.pan_oy - (my - yp.pan_my) * yp.zoom_den / yp.zoom_num;
		YPViewFull;
	}
}

U0 YPWheelPoll()
{//mouse.pos.z accumulates notches; the change since the last look is the delta.
	I64  z = mouse.pos.z, d;
	Bool ctrl, shift;

	if (z == yp.wheel_last)
		return;
	d = ClampI64(z - yp.wheel_last, -8, 8);
	yp.wheel_last = z;
	yp.need_fit = FALSE;
	ctrl  = Bt(kbd.down_bitmap, SC_CTRL) != 0;
	shift = Bt(kbd.down_bitmap, SC_SHIFT) != 0;

	if (yp.region == YPR_LAYERS)
	{
		yp.lay_scroll = MaxI64(0, yp.lay_scroll - d);
		return;
	}
	if (ctrl)
	{
		YPZoomSet(yp.zoom_i + d, yp.mx - yp.cx, yp.my - yp.cy);
		return;
	}
	if (shift)
	{
		YPBrushSizeSet(yp.size + d);
		return;
	}
	yp.pan_y -= d * 48 * yp.zoom_den / yp.zoom_num;
	YPViewFull;
}

U0 YPKeyChar(I64 ch)
{
	switch (ch)
	{
		case 'b': YPToolSet(YPT_BRUSH); 	break;
		case 'n': YPToolSet(YPT_PENCIL);	break;
		case 'e': YPToolSet(YPT_ERASER);	break;
		case 'g': YPToolSet(YPT_FILL);		break;
		case 'i': YPToolSet(YPT_PICKER);	break;
		case 'l': YPToolSet(YPT_LINE);		break;
		case 'u': YPToolSet(YPT_RECT);		break;
		case 'o': YPToolSet(YPT_ELLIPSE);	break;
		case 'r': YPToolSet(YPT_GRADIENT);	break;
		case 'v': YPToolSet(YPT_MOVE);		break;
		case 'h': YPToolSet(YPT_PAN);		break;

		case 'x': YPMenuCmd(YPM_SWAPCOL);	break;

		case 'd':
			yp.fg = 0xFF000000;
			yp.bg = 0xFFFFFFFF;
			YPColorSet(yp.fg);
			break;

		case 'a': YPMenuCmd(YPM_BRUSH_AA);		break;
		case 'p': YPMenuCmd(YPM_BRUSH_SHAPE);	break;
		case 'f': YPMenuCmd(YPM_BRUSH_FILL);	break;
		case 's': YPMenuCmd(YPM_BRUSH_MERGED);	break;

		case '[': YPBrushSizeSet(yp.size - MaxI64(1, yp.size / 10)); break;
		case ']': YPBrushSizeSet(yp.size + MaxI64(1, yp.size / 10)); break;
		case '{': YPBrushHardnessSet(yp.hardness - 5);	break;
		case '}': YPBrushHardnessSet(yp.hardness + 5);	break;

		case '+':
		case '=': YPZoomStep(1);			break;
		case '-': YPZoomStep(-1);			break;
		case '0': YPViewFit;				break;
		case '1': YPMenuCmd(YPM_VIEW_1_1);	break;

		case CH_CTRLZ: YPMenuCmd(YPM_UNDO); 		break;
		case CH_CTRLY: YPMenuCmd(YPM_REDO); 		break;
		case CH_CTRLN:
			//Shift-Ctrl-N adds a layer; Ctrl-A stays free for Select All.
			if (YPShiftHeld)
				YPMenuCmd(YPM_LAYER_NEW);
			else
				YPMenuCmd(YPM_NEW);
			break;
		case CH_CTRLO: YPMenuCmd(YPM_OPEN); 		break;
		case CH_CTRLS: YPMenuCmd(YPM_SAVE); 		break;
		case CH_CTRLE: YPMenuCmd(YPM_LAYER_MERGE);	break;
		case CH_CTRLG: YPMenuCmd(YPM_LAYER_CLIP);	break;

		case '\t':
			yp.panels = !yp.panels;
			break;

		case CH_ESC:
			if (yp.drawing)
			{
				YPStrokeCancel;
				if (yp.tool == YPT_PENCIL)
					YPPencilPop;
			}
			yp.dragging = FALSE;
			yp_move_drag = FALSE;
			break;

		case CH_SHIFT_ESC:
			yp.quit = TRUE;
			break;
	}
}

U0 YPKeyScan(I64 sc)
{
	switch (sc)
	{
		case SC_F1:
			YPHelpKeys;
			break;

		case SC_DELETE:
			YPLayerClear;
			break;

		case SC_CURSOR_LEFT:
			yp.pan_x -= 32 * yp.zoom_den / yp.zoom_num;
			YPViewFull;
			break;
		case SC_CURSOR_RIGHT:
			yp.pan_x += 32 * yp.zoom_den / yp.zoom_num;
			YPViewFull;
			break;
		case SC_CURSOR_UP:
			yp.pan_y -= 32 * yp.zoom_den / yp.zoom_num;
			YPViewFull;
			break;
		case SC_CURSOR_DOWN:
			yp.pan_y += 32 * yp.zoom_den / yp.zoom_num;
			YPViewFull;
			break;

		case SC_PAGE_UP:
			if (yp.cur < yp.layer_n - 1)
				yp.cur++;
			break;
		case SC_PAGE_DOWN:
			if (yp.cur > 0)
				yp.cur--;
			break;
	}
}

public U0 yPainter()
{
	I64 msg, a1, a2, cols, vx0, vy0, vx1, vy1;

	YPInit;

	SettingsPush;
	StrCopy(Fs->task_title, "yPainter");
	//Row 0 stays clear: that is where the pull-down menu drops in, and the
	//title bar sits one row above the content.
	cols = MinI64(TEXT_COLS - 2, 160);
	Fs->win_width = cols;
	WinHorz(0, cols);
	Fs->win_height = TEXT_ROWS - 4;
	WinVert(2, TEXT_ROWS - 3);
	WinFocus;
	DocCursor(OFF);
	DocClear;
	//Without these the window manager holds the click for a double-click timer,
	//which shows up as lag at the start of every stroke.
	Fs->win_inhibit |= WIF_FOCUS_TASK_MS_L_D | WIF_FOCUS_TASK_MS_R_D;
	YPMenuPush;

	YPGfxInit;
	//WinHorz/WinVert set the window in text cells; pix_width and pix_height
	//only catch up on the window manager's next pass. Fitting against the
	//stale values centres the canvas for the wrong viewport.
	Refresh;
	yp.need_fit = TRUE;
	YPLayout(Fs->pix_width, Fs->pix_height);
	YPViewSize(yp.cw, yp.ch);
	YPViewFit;
	YPCompositeFlush;
	YPViewPaint(0, 0, yp.view_w, yp.view_h);
	yp.dirty_view = FALSE;
	YPSVBuild;
	YPNavBuild;
	//Set last: draw_it must never see a half-built panel.
	Fs->draw_it = &YPDrawIt;

	while (!yp.quit)
	{
		while (msg = MessageScan(&a1, &a2))
			switch (msg)
			{
				case MESSAGE_MS_L_DOWN:
					yp.need_fit = FALSE;
					YPMouseDown(a1, a2, FALSE);
					break;
				case MESSAGE_MS_L_UP:
					YPMouseUp;
					break;
				case MESSAGE_MS_R_DOWN:
					yp.need_fit = FALSE;
					YPMouseDown(a1, a2, TRUE);
					break;
				case MESSAGE_MS_R_UP:
					YPMouseUp;
					break;
				case MESSAGE_KEY_DOWN:
					yp.need_fit = FALSE;
					if (a1)
						YPKeyChar(a1);
					else
						YPKeyScan(a2.u8[0]);
					break;
				case MESSAGE_CMD:
					YPMenuCmd(a1);
					break;
			}

		YPLayout(Fs->pix_width, Fs->pix_height);
		//Until the first input, keep recentring as the viewport settles.
		if (YPViewSize(yp.cw, yp.ch) && yp.need_fit)
			YPViewFit;
		YPPollMouse;
		YPWheelPoll;

		if (yp.cd_x0 < yp.cd_x1 && yp.cd_y0 < yp.cd_y1)
		{
			vx0 = yp.cd_x0;
			vy0 = yp.cd_y0;
			vx1 = yp.cd_x1;
			vy1 = yp.cd_y1;
			YPCompositeFlush;
			//A pending full repaint already covers this rect.
			if (!yp.dirty_view)
				YPViewBlitRect(vx0, vy0, vx1, vy1);
			yp.nav_tick++;
		}
		if (yp.dirty_view)
		{
			YPViewPaint(0, 0, yp.view_w, yp.view_h);
			yp.dirty_view = FALSE;
		}

		//The navigator is a whole-document resample; a few frames of lag on it
		//is cheaper than doing it inside a stroke.
		if (yp.nav_tick)
		{
			yp.nav_tick = 0;
			YPNavBuild;
		}
		if (yp_sv_dirty || yp.hue != yp_sv_hue)
			YPSVBuild;

		Sleep(10);
	}

	Fs->draw_it = NULL;
	Sleep(40);
	MenuPop;
	YPUndoClear;
	YPLayerFreeAll;
	Free(yp.comp);
	Free(yp.grp);
	Free(yp.snap);
	Free(yp.acc);
	Free(yp.stamp);
	yp.comp = NULL;
	yp.grp	= NULL;
	yp.snap = NULL;
	yp.acc	= NULL;
	yp.stamp = NULL;
	DCDel(yp.view);
	DCDel(yp.nav);
	DCDel(yp.lthumb);
	DCDel(yp_sv);
	DCDel(yp_hue);
	yp.view = NULL;
	yp.nav	= NULL;
	yp.lthumb = NULL;
	yp_sv = NULL;
	yp_hue = NULL;
	DocCursor(ON);
	DocClear;
	SettingsPop;
	"yPainter closed.\n";
}
