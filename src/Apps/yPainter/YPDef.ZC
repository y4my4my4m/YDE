//yPainter data model. No dependencies on the other YP files.
//
//Pixel format: layers, the composite and undo snapshots all hold 0xAARRGGBB
//with straight (non-premultiplied) alpha. CDC bodies hold 0x00RRGGBB, where
//0xFF000000 (PIXF_TRANSPARENT) means transparent. Conversion happens only in
//YPViewBlit.

#define YP_MAX_LAYERS		48
#define YP_MAX_UNDO 		40
#define YP_NAME_LEN 		28
#define YP_SWATCHES 		24
#define YP_MAX_DIM			4096
#define YP_THUMB_W			196
#define YP_THUMB_H			136

//Blend modes, in menu order.
#define YPB_NORMAL			0
#define YPB_MULTIPLY		1
#define YPB_SCREEN			2
#define YPB_OVERLAY 		3
#define YPB_DARKEN			4
#define YPB_LIGHTEN 		5
#define YPB_ADD 			6
#define YPB_SUBTRACT		7
#define YPB_DIFFERENCE		8
#define YPB_DODGE			9
#define YPB_BURN			10
#define YPB_HARDLIGHT		11
#define YPB_SOFTLIGHT		12
#define YPB_COUNT			13

//Tools.
#define YPT_BRUSH			0
#define YPT_PENCIL			1
#define YPT_ERASER			2
#define YPT_FILL			3
#define YPT_PICKER			4
#define YPT_LINE			5
#define YPT_RECT			6
#define YPT_ELLIPSE 		7
#define YPT_GRADIENT		8
#define YPT_MOVE			9
#define YPT_PAN 			10
#define YPT_SEL_RECT		11
#define YPT_SEL_LASSO		12
#define YPT_SEL_POLY		13
#define YPT_COUNT			14

//Selection combine modes, chosen by the modifier held at drag start.
#define YPSEL_REPLACE		0
#define YPSEL_ADD			1
#define YPSEL_SUB			2

//Brush tip shapes.
#define YPS_ROUND			0
#define YPS_SOFT			1
#define YPS_SQUARE			2
#define YPS_SPRAY			3
#define YPS_CALLIG			4
#define YPS_PIXEL			5
#define YPS_COUNT			6

//Undo record kinds.
#define YPU_PIX 			0	//rect of one layer
#define YPU_DOC 			1	//whole document, for structural edits

//UI regions returned by YPHitTest.
#define YPR_NONE			0
#define YPR_CANVAS			1
#define YPR_TOOLBAR 		2
#define YPR_OPTIONS 		3
#define YPR_NAV 			4
#define YPR_SV				5
#define YPR_HUE 			6
#define YPR_SWATCH			7
#define YPR_LAYERS			8
#define YPR_STATUS			9
#define YPR_LAYERBTN		10
#define YPR_FGBG			11
#define YPR_OPACITY 		12
#define YPR_BLEND			13

//Menu command ids.
#define YPM_NEW 			100
#define YPM_OPEN			101
#define YPM_SAVE			102
#define YPM_SAVEAS			103
#define YPM_IMPORT			104
#define YPM_IMPORT_LAYER	108
#define YPM_OPEN_GR32		109
#define YPM_EXPORT_TGA		105
#define YPM_EXPORT_GR32 	106
#define YPM_EXIT			107

#define YPM_UNDO			120
#define YPM_REDO			121
#define YPM_CLEAR			122
#define YPM_FILLFG			123
#define YPM_FILLBG			124
#define YPM_SWAPCOL 		125

#define YPM_LAYER_NEW		140
#define YPM_LAYER_DUP		141
#define YPM_LAYER_DEL		142
#define YPM_LAYER_UP		143
#define YPM_LAYER_DOWN		144
#define YPM_LAYER_MERGE 	145
#define YPM_LAYER_FLATTEN	146
#define YPM_LAYER_RENAME	147
#define YPM_LAYER_ALPHALOCK 148
#define YPM_LAYER_HIDE		149
#define YPM_LAYER_OPACITY	150
#define YPM_LAYER_BLEND 	151	//..163, one per YPB_
#define YPM_LAYER_CLIP		164

#define YPM_IMG_RESIZE		170
#define YPM_IMG_FLIPH		171
#define YPM_IMG_FLIPV		172
#define YPM_IMG_BLUR		173
#define YPM_IMG_HSV 		174
#define YPM_IMG_BRIGHT		175
#define YPM_IMG_INVERT		176
#define YPM_IMG_DESAT		177

#define YPM_VIEW_IN 		190
#define YPM_VIEW_OUT		191
#define YPM_VIEW_FIT		192
#define YPM_VIEW_1_1		193
#define YPM_VIEW_CENTER 	194
#define YPM_VIEW_PANELS 	195
#define YPM_VIEW_GRID		196

#define YPM_BRUSH_SHAPE 	210
#define YPM_BRUSH_BIGGER	211
#define YPM_BRUSH_SMALLER	212
#define YPM_BRUSH_HARDER	213
#define YPM_BRUSH_SOFTER	214
#define YPM_BRUSH_FILL		215
#define YPM_BRUSH_AA		216
#define YPM_BRUSH_MERGED	217

#define YPM_SEL_ALL 		240
#define YPM_SEL_NONE		241
#define YPM_SEL_INVERT		242
#define YPM_SEL_RECT		243
#define YPM_SEL_LASSO		244
#define YPM_SEL_POLY		245

#define YPM_HELP_KEYS		230
#define YPM_HELP_ABOUT		231

class CYPLayer
{
	U32 	*px; 			//doc_w * doc_h, 0xAARRGGBB
	U8		 name[YP_NAME_LEN];
	I64 	 blend;
	I64 	 opacity;		//0..255
	Bool	 visible;
	Bool	 alpha_lock;	//stroke cannot add alpha, only recolor
	Bool	 clip;			//masked by the alpha of the base layer below
	Bool	 pad[5];
};

class CYPUndo
{
	I64 	 kind;
	I64 	 layer;
	I64 	 x, y, w, h;
	U32 	*px; 			//YPU_PIX: w * h saved pixels
	U8		*doc;			//YPU_DOC: serialized document
	I64 	 doc_size;
	U8		 label[YP_NAME_LEN];
};

class CYPGlobals
{
	//Document
	I64 		 doc_w, doc_h;
	CYPLayer	 layer[YP_MAX_LAYERS];
	I64 		 layer_n;
	I64 		 cur;			//active layer index, 0 is bottom
	U32 		*comp;			//doc_w * doc_h composite, 0xAARRGGBB
	U32 		*grp;			//scratch for one run of clipped layers
	Bool		 comp_all;		//composite is stale everywhere
	I64 		 cd_x0, cd_y0, cd_x1, cd_y1;	//composite dirty rect, exclusive hi

	//View
	CDC 		*view;			//canvas viewport bitmap, window-content coords
	CDC 		*nav;			//navigator thumbnail
	CDC 		*lthumb;		//scratch for one layer-panel thumbnail
	I64 		 view_w, view_h;
	I64 		 zoom_i;		//index into yp_zoom_num / yp_zoom_den
	I64 		 zoom_num, zoom_den;
	I64 		 pan_x, pan_y;	//doc pixel at canvas top-left, in doc coords
	Bool		 panels;		//right panel and toolbar visible
	Bool		 dirty_view;
	Bool		 need_fit;		//refit while the window geometry is still settling
	Bool		 grid;			//pixel grid, shown once magnified enough

	//Window geometry, recomputed every frame from task->pix_width/height
	I64 		 win_w, win_h;
	I64 		 cx, cy, cw, ch;		//canvas viewport rect
	I64 		 px0, py0, pw, ph;		//right panel rect
	I64 		 nav_y, col_y, lay_y;	//right panel section tops

	//Brush
	I64 		 shape;
	I64 		 size;			//tip diameter in doc pixels
	I64 		 hardness;		//0..100
	I64 		 opacity;		//0..255, stroke ceiling
	I64 		 flow;			//0..255, per-stamp deposit
	I64 		 spacing;		//percent of size between stamps
	Bool		 anti_alias;
	U8			*stamp; 		//stamp_d * stamp_d coverage mask, 0..255
	I64 		 stamp_d;
	Bool		 stamp_dirty;

	//Stroke state. snap is the whole layer as it was before the stroke; acc is
	//per-pixel stroke coverage. Every stamp recomputes the layer from the two,
	//so overlapping stamps in one stroke do not compound.
	Bool		 drawing;
	I64 		 stroke_layer;
	I64 		 stroke_x, stroke_y;	//last stamped doc position
	F64 		 stroke_carry;			//distance since the last stamp
	U32 		*snap;
	U8			*acc;
	I64 		 ax0, ay0, ax1, ay1;	//stroke bounds, exclusive hi
	U32 		 stroke_col;
	Bool		 stroke_erase;

	//Shape tools drag state
	Bool		 dragging;
	I64 		 drag_x0, drag_y0, drag_x1, drag_y1;
	Bool		 drag_shift, drag_alt;

	//Tool
	I64 		 tool, tool_prev;
	I64 		 fill_tol;		//0..255 flood fill tolerance
	Bool		 fill_shapes;	//rect and ellipse draw solid, not outlined
	Bool		 sample_merged; //picker and fill read the composite
	I64 		 last_x, last_y;	//end of the last stroke, for shift-click
	Bool		 has_last;

	//Selection. sel is doc-sized 0..255 coverage; every tool that deposits
	//colour multiplies its own coverage by it, so one mask clips them all.
	U8			*sel;
	Bool		 has_sel;
	I64 		 sx0, sy0, sx1, sy1;	//selection bounds, exclusive hi
	Bool		 sel_dirty; 			//outline segments need rebuilding
	I64 		 sel_mode;				//YPSEL_*, latched at drag start
	I64 		 ants;					//marching-ants animation phase

	//Color
	U32 		 fg, bg;		//0xAARRGGBB
	F64 		 hue, sat, val;
	U32 		 swatch[YP_SWATCHES];

	//Interaction. Held modifiers are sampled once per loop so the renderer can
	//show the cursor the next click will act as.
	Bool		 mod_pan, mod_pick;
	I64 		 region;		//YPR_* under the mouse
	I64 		 mx, my;		//mouse in window-content coords
	I64 		 dx, dy;		//mouse in doc coords
	Bool		 in_doc;
	I64 		 wheel_last;
	Bool		 pan_drag;
	I64 		 pan_ox, pan_oy, pan_mx, pan_my;
	I64 		 lay_scroll;
	I64 		 slider;		//YPR_* currently being dragged, 0 if none
	Bool		 quit;
	I64 		 nav_tick;

	//Undo
	CYPUndo 	 undo[YP_MAX_UNDO];
	I64 		 undo_n, undo_pos;

	//Files
	U8			 file[STR_LEN];
	U8			 dir[STR_LEN];
	Bool		 modified;
	U8			 status[STR_LEN];

	//Chrome colors, built once in YPInit
	CColorROPU32 c_bg, c_panel, c_edge, c_hi, c_text, c_dim, c_accent,
				 c_btn, c_btn_hi, c_chk1, c_chk2, c_sel;
} yp;

U8 *yp_blend_name[YPB_COUNT];
U8 *yp_tool_name[YPT_COUNT];
U8 *yp_shape_name[YPS_COUNT];

U0 YPNamesInit()
{//ZealC ignores declaration initialisers on globals.
	yp_blend_name[YPB_NORMAL]		= "Normal";
	yp_blend_name[YPB_MULTIPLY] 	= "Multiply";
	yp_blend_name[YPB_SCREEN]		= "Screen";
	yp_blend_name[YPB_OVERLAY]		= "Overlay";
	yp_blend_name[YPB_DARKEN]		= "Darken";
	yp_blend_name[YPB_LIGHTEN]		= "Lighten";
	yp_blend_name[YPB_ADD]			= "Add";
	yp_blend_name[YPB_SUBTRACT] 	= "Subtract";
	yp_blend_name[YPB_DIFFERENCE]	= "Difference";
	yp_blend_name[YPB_DODGE]		= "Dodge";
	yp_blend_name[YPB_BURN] 		= "Burn";
	yp_blend_name[YPB_HARDLIGHT]	= "HardLight";
	yp_blend_name[YPB_SOFTLIGHT]	= "SoftLight";

	yp_tool_name[YPT_BRUSH] 		= "Brush";
	yp_tool_name[YPT_PENCIL]		= "Pencil";
	yp_tool_name[YPT_ERASER]		= "Eraser";
	yp_tool_name[YPT_FILL]			= "Fill";
	yp_tool_name[YPT_PICKER]		= "Picker";
	yp_tool_name[YPT_LINE]			= "Line";
	yp_tool_name[YPT_RECT]			= "Rect";
	yp_tool_name[YPT_ELLIPSE]		= "Ellipse";
	yp_tool_name[YPT_GRADIENT]		= "Gradient";
	yp_tool_name[YPT_MOVE]			= "Move";
	yp_tool_name[YPT_PAN]			= "Pan";
	yp_tool_name[YPT_SEL_RECT]		= "SelRect";
	yp_tool_name[YPT_SEL_LASSO]		= "Lasso";
	yp_tool_name[YPT_SEL_POLY]		= "Polygon";

	yp_shape_name[YPS_ROUND]		= "Round";
	yp_shape_name[YPS_SOFT] 		= "Soft";
	yp_shape_name[YPS_SQUARE]		= "Square";
	yp_shape_name[YPS_SPRAY]		= "Spray";
	yp_shape_name[YPS_CALLIG]		= "Calligraphy";
	yp_shape_name[YPS_PIXEL]		= "Pixel";
}

I64 YPAlpha(U32 p)
{
	return p >> 24 & 0xFF;
}

I64 YPRed(U32 p)
{
	return p >> 16 & 0xFF;
}

I64 YPGreen(U32 p)
{
	return p >> 8 & 0xFF;
}

I64 YPBlue(U32 p)
{
	return p & 0xFF;
}

U32 YPARGB(I64 a, I64 r, I64 g, I64 b)
{
	return (a & 0xFF) << 24 | (r & 0xFF) << 16 | (g & 0xFF) << 8 | (b & 0xFF);
}

CColorROPU32 YPPen(U32 argb)
{//Truecolor pen from a document pixel, alpha discarded.
	return ROPF_TRUE_COLOR | (argb & 0x00FFFFFF);
}

U0 YPRGB2HSV(U32 argb, F64 *_h, F64 *_s, F64 *_v)
{//h in [0,360), s and v in [0,1].
	F64 r = YPRed(argb)   / 255.0,
		g = YPGreen(argb) / 255.0,
		b = YPBlue(argb)  / 255.0,
		mx, mn, d;

	mx = r;
	if (g > mx)
		mx = g;
	if (b > mx)
		mx = b;
	mn = r;
	if (g < mn)
		mn = g;
	if (b < mn)
		mn = b;
	d = mx - mn;

	*_v = mx;
	if (mx <= 0.0)
		*_s = 0.0;
	else
		*_s = d / mx;

	if (d <= 0.0)
		*_h = 0.0;
	else if (mx == r)
		*_h = 60.0 * (g - b) / d;
	else if (mx == g)
		*_h = 60.0 * ((b - r) / d + 2.0);
	else
		*_h = 60.0 * ((r - g) / d + 4.0);

	while (*_h < 0.0)
		*_h += 360.0;
	while (*_h >= 360.0)
		*_h -= 360.0;
}

U32 YPHSV2RGB(F64 h, F64 s, F64 v)
{//Returns an opaque 0xFFRRGGBB.
	F64 c, x, m, r, g, b;
	I64 sector;

	while (h < 0.0)
		h += 360.0;
	while (h >= 360.0)
		h -= 360.0;
	if (s < 0.0)
		s = 0.0;
	if (s > 1.0)
		s = 1.0;
	if (v < 0.0)
		v = 0.0;
	if (v > 1.0)
		v = 1.0;

	c = v * s;
	sector = ToI64(h / 60.0);
	x = c * (1.0 - Abs(h / 60.0 - 2.0 * ToI64(h / 120.0) - 1.0));
	m = v - c;

	switch (sector)
	{
		case 0:  r = c; g = x; b = 0; break;
		case 1:  r = x; g = c; b = 0; break;
		case 2:  r = 0; g = c; b = x; break;
		case 3:  r = 0; g = x; b = c; break;
		case 4:  r = x; g = 0; b = c; break;
		default: r = c; g = 0; b = x; break;
	}

	return YPARGB(255, ToI64((r + m) * 255.0 + 0.5),
					   ToI64((g + m) * 255.0 + 0.5),
					   ToI64((b + m) * 255.0 + 0.5));
}

U0 YPStatus(U8 *fmt, ...)
{
	U8 *buf = StrPrintJoin(NULL, fmt, argc, argv);

	if (StrLen(buf) >= STR_LEN)
		buf[STR_LEN - 1] = 0;
	StrCopy(yp.status, buf);
	Free(buf);
}
