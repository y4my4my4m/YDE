
#define YP_TOOL_W		58
#define YP_PANEL_W		212
#define YP_TB_BTN		26
#define YP_SV_W 		148
#define YP_SV_H 		104
#define YP_HUE_W		18
#define YP_LT_W			24	//layer row thumbnail
#define YP_LT_H			17
#define YP_CHECK		8	//checkerboard square, view pixels

//Draggable widget ids. YPHitTest returns these in place of a YPR_*: the
//ranges must not overlap.
#define YPDRAG_NONE 	0
#define YPDRAG_SIZE 	32
#define YPDRAG_HARD 	33
#define YPDRAG_OPAC 	34
#define YPDRAG_FLOW 	35
#define YPDRAG_SPACE	36
#define YPDRAG_TOL		37
#define YPDRAG_SV		38
#define YPDRAG_HUE		39
#define YPDRAG_LOPAC	40
#define YPDRAG_COUNT	41

I64  yp_sl[YPDRAG_COUNT][4];	//x, y, w, h per draggable
CDC *yp_sv;
CDC *yp_hue;
F64  yp_sv_hue;
Bool yp_sv_dirty;

//Text inset inside a chrome box is constant at both 8 and 16 cell heights:
//4 in a button, 6 in the status bar, 8 in a layer row, 9 in the options bar.
I64 yp_opt_h, yp_status_h, yp_row_h, yp_btn_h,
	yp_lay_op, yp_lay_bl, yp_lay_list;

U0 YPMetricsInit()
{
	yp_opt_h	= FONT_HEIGHT + 18;
	yp_status_h = FONT_HEIGHT + 12;
	yp_row_h	= FONT_HEIGHT + 16;
	yp_btn_h	= FONT_HEIGHT + 8;
	yp_lay_op	= yp_btn_h + 10;
	yp_lay_bl	= yp_lay_op + yp_btn_h + 4;
	yp_lay_list = yp_lay_bl + yp_btn_h + 6;
}

I64 yp_zoom_num[15];
I64 yp_zoom_den[15];
I64 yp_zoom_n;

U0 YPZoomTableInit()
{
	I64 i = 0;

	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 8;
	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 6;
	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 4;
	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 3;
	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 2;
	yp_zoom_num[i] = 2;  yp_zoom_den[i++] = 3;
	yp_zoom_num[i] = 1;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 2;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 3;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 4;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 6;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 8;  yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 12; yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 16; yp_zoom_den[i++] = 1;
	yp_zoom_num[i] = 32; yp_zoom_den[i++] = 1;
	yp_zoom_n = i;
}

I64 YPD2VX(I64 dx)
{
	return (dx - yp.pan_x) * yp.zoom_num / yp.zoom_den;
}

I64 YPD2VY(I64 dy)
{
	return (dy - yp.pan_y) * yp.zoom_num / yp.zoom_den;
}

I64 YPV2DX(I64 vx)
{//Integer division truncates toward zero; negatives are biased down a whole
//view pixel to keep the mapping monotonic across the origin.
	if (vx < 0)
		return yp.pan_x + (vx - yp.zoom_num + 1) * yp.zoom_den / yp.zoom_num;

	return yp.pan_x + vx * yp.zoom_den / yp.zoom_num;
}

I64 YPV2DY(I64 vy)
{
	if (vy < 0)
		return yp.pan_y + (vy - yp.zoom_num + 1) * yp.zoom_den / yp.zoom_num;

	return yp.pan_y + vy * yp.zoom_den / yp.zoom_num;
}

U0 YPViewFull()
{
	yp.dirty_view = TRUE;
}

U0 YPViewPaint(I64 vx0, I64 vy0, I64 vx1, I64 vy1)
{
	I64  vx, vy, dx, dy, i, j, n, blk, dxp, dyp, f,
		 den = yp.zoom_den, num = yp.zoom_num,
		 a, r, g, b, idx, stride;
	U32  c, *row;
	Bool grid, edge_row, edge_col, edge;

	if (!yp.view)
		return;
	stride = yp.view->width_internal;

	vx0 = ClampI64(vx0, 0, yp.view_w);
	vy0 = ClampI64(vy0, 0, yp.view_h);
	vx1 = ClampI64(vx1, 0, yp.view_w);
	vy1 = ClampI64(vy1, 0, yp.view_h);

	blk = 1;
	if (num < den)
		blk = (den + num - 1) / num;

	grid = yp.grid && num >= 4 * den;

	for (vy = vy0; vy < vy1; vy++)
	{
		row = &yp.view->body[vy * stride];
		dy = YPV2DY(vy);
		dyp = YPV2DY(vy - 1);
		edge_row = grid && dy != dyp;
		dxp = YPV2DX(vx0 - 1);
		for (vx = vx0; vx < vx1; vx++)
		{
			dx = YPV2DX(vx);
			edge_col = grid && dx != dxp;
			edge = edge_row || edge_col;
			dxp = dx;
			if (dx < 0 || dy < 0 || dx >= yp.doc_w || dy >= yp.doc_h)
			{
				row[vx] = 0x141620;
				goto blit_next;
			}

			if (blk > 1)
			{
				a = 0;
				r = 0;
				g = 0;
				b = 0;
				n = 0;
				for (j = 0; j < blk; j++)
					for (i = 0; i < blk; i++)
						if (dx + i < yp.doc_w && dy + j < yp.doc_h)
						{
							c = yp.comp[(dy + j) * yp.doc_w + dx + i];
							a += c >> 24 & 0xFF;
							r += c >> 16 & 0xFF;
							g += c >> 8  & 0xFF;
							b += c		 & 0xFF;
							n++;
						}
				if (!n)
					n = 1;
				a /= n;
				r /= n;
				g /= n;
				b /= n;
			}
			else
			{
				c = yp.comp[dy * yp.doc_w + dx];
				a = c >> 24 & 0xFF;
				r = c >> 16 & 0xFF;
				g = c >> 8	& 0xFF;
				b = c		& 0xFF;
			}

			if (a < 255)
			{
				if (((vx / YP_CHECK) + (vy / YP_CHECK)) & 1)
					idx = 0x66;
				else
					idx = 0x99;
				r = (r * a + idx * (255 - a)) / 255;
				g = (g * a + idx * (255 - a)) / 255;
				b = (b * a + idx * (255 - a)) / 255;
			}

			if (edge)
			{
				f = 30;
				if ((edge_row && !(dy & 7)) || (edge_col && !(dx & 7)))
					f = 55;
				if (299 * r + 587 * g + 114 * b > 128000)
				{
					r -= r * f / 100;
					g -= g * f / 100;
					b -= b * f / 100;
				}
				else
				{
					r += (255 - r) * f / 100;
					g += (255 - g) * f / 100;
					b += (255 - b) * f / 100;
				}
			}

			row[vx] = (r << 16) | (g << 8) | b;
blit_next:
			;
		}
	}
}

U0 YPViewBlitRect(I64 dx0, I64 dy0, I64 dx1, I64 dy1)
{
	YPViewPaint(YPD2VX(dx0) - 1, YPD2VY(dy0) - 1,
				YPD2VX(dx1) + 2, YPD2VY(dy1) + 2);
}

Bool YPViewSize(I64 w, I64 h)
{
	if (w < 1)
		w = 1;
	if (h < 1)
		h = 1;
	if (yp.view && yp.view_w == w && yp.view_h == h)
		return FALSE;
	DCDel(yp.view);
	yp.view = DCNew(w, h);
	yp.view->flags |= DCF_NO_TRANSPARENTS;
	yp.view_w = w;
	yp.view_h = h;
	YPViewFull;

	return TRUE;
}

U0 YPZoomSet(I64 i, I64 anchor_vx, I64 anchor_vy)
{
	I64 ax, ay;

	i = ClampI64(i, 0, yp_zoom_n - 1);
	ax = YPV2DX(anchor_vx);
	ay = YPV2DY(anchor_vy);
	yp.zoom_i	= i;
	yp.zoom_num = yp_zoom_num[i];
	yp.zoom_den = yp_zoom_den[i];
	yp.pan_x = ax - anchor_vx * yp.zoom_den / yp.zoom_num;
	yp.pan_y = ay - anchor_vy * yp.zoom_den / yp.zoom_num;
	YPViewFull;
}

U0 YPViewCenter()
{
	I64 nx = yp.doc_w / 2 - (yp.view_w / 2) * yp.zoom_den / yp.zoom_num,
		ny = yp.doc_h / 2 - (yp.view_h / 2) * yp.zoom_den / yp.zoom_num;

	if (nx == yp.pan_x && ny == yp.pan_y)
		return;
	yp.pan_x = nx;
	yp.pan_y = ny;
	YPViewFull;
}

U0 YPViewFit()
{
	I64 i, best = 0, w, h;

	for (i = 0; i < yp_zoom_n; i++)
	{
		w = yp.doc_w * yp_zoom_num[i] / yp_zoom_den[i];
		h = yp.doc_h * yp_zoom_num[i] / yp_zoom_den[i];
		if (w <= yp.view_w && h <= yp.view_h)
			best = i;
	}
	yp.zoom_i	= best;
	yp.zoom_num = yp_zoom_num[best];
	yp.zoom_den = yp_zoom_den[best];
	YPViewCenter;
}

U0 YPNavBuild()
{
	I64 x, y, dx, dy, a, r, g, b, sw, sh;
	U32 c;

	if (!yp.nav)
		return;
	if (yp.doc_w * YP_THUMB_H > yp.doc_h * YP_THUMB_W)
	{
		sw = YP_THUMB_W;
		sh = yp.doc_h * YP_THUMB_W / yp.doc_w;
	}
	else
	{
		sh = YP_THUMB_H;
		sw = yp.doc_w * YP_THUMB_H / yp.doc_h;
	}
	if (sw < 1)
		sw = 1;
	if (sh < 1)
		sh = 1;

	for (y = 0; y < YP_THUMB_H; y++)
		for (x = 0; x < YP_THUMB_W; x++)
		{
			if (x >= sw || y >= sh)
				yp.nav->body[y * yp.nav->width_internal + x] = 0x1A1D28;
			else
			{
				dx = x * yp.doc_w / sw;
				dy = y * yp.doc_h / sh;
				c = yp.comp[dy * yp.doc_w + dx];
				a = c >> 24 & 0xFF;
				r = ((c >> 16 & 0xFF) * a + 0x50 * (255 - a)) / 255;
				g = ((c >> 8  & 0xFF) * a + 0x50 * (255 - a)) / 255;
				b = ((c 	  & 0xFF) * a + 0x50 * (255 - a)) / 255;
				yp.nav->body[y * yp.nav->width_internal + x] =
					(r << 16) | (g << 8) | b;
			}
		}
}

U0 YPSVBuild()
{
	I64 x, y;
	U32 c;

	if (!yp_sv || !yp_hue)
		return;

	for (y = 0; y < YP_SV_H; y++)
		for (x = 0; x < YP_SV_W; x++)
		{
			c = YPHSV2RGB(yp.hue, x / (YP_SV_W - 1.0),
						  1.0 - y / (YP_SV_H - 1.0));
			yp_sv->body[y * yp_sv->width_internal + x] = c & 0x00FFFFFF;
		}

	for (y = 0; y < YP_SV_H; y++)
	{
		c = YPHSV2RGB(360.0 * y / (YP_SV_H - 1.0), 1.0, 1.0);
		for (x = 0; x < YP_HUE_W; x++)
			yp_hue->body[y * yp_hue->width_internal + x] = c & 0x00FFFFFF;
	}

	yp_sv_hue = yp.hue;
	yp_sv_dirty = FALSE;
}

U0 YPGfxInit()
{//A DC allocated in draw_it belongs to the window manager task's heap.
	YPMetricsInit;
	yp_sv	  = NULL;
	yp_hue	  = NULL;
	yp_sv_hue = -1.0;
	yp_sv_dirty = TRUE;
	MemSet(yp_sl, 0, sizeof(yp_sl));

	yp.nav = DCNew(YP_THUMB_W, YP_THUMB_H);
	yp.nav->flags |= DCF_NO_TRANSPARENTS;
	yp.lthumb = DCNew(YP_LT_W, YP_LT_H);
	yp.lthumb->flags |= DCF_NO_TRANSPARENTS;
	yp_sv = DCNew(YP_SV_W, YP_SV_H);
	yp_sv->flags |= DCF_NO_TRANSPARENTS;
	yp_hue = DCNew(YP_HUE_W, YP_SV_H);
	yp_hue->flags |= DCF_NO_TRANSPARENTS;
}

U0 YPColorFromHSV()
{
	yp.fg = YPHSV2RGB(yp.hue, yp.sat, yp.val);
}

U0 YPColorSet(U32 argb)
{
	yp.fg = 0xFF000000 | (argb & 0x00FFFFFF);
	YPRGB2HSV(yp.fg, &yp.hue, &yp.sat, &yp.val);
	yp_sv_dirty = TRUE;
}

U0 YPLayout(I64 w, I64 h)
{
	I64 px, py, y, i, lab, step;

	yp.win_w = w;
	yp.win_h = h;

	if (yp.panels)
	{
		yp.cx = YP_TOOL_W;
		yp.cw = w - YP_TOOL_W - YP_PANEL_W;
		yp.px0 = w - YP_PANEL_W;
		yp.pw = YP_PANEL_W;
	}
	else
	{
		yp.cx = 0;
		yp.cw = w;
		yp.px0 = w;
		yp.pw = 0;
	}
	yp.cy = yp_opt_h;
	yp.ch = h - yp_opt_h - yp_status_h;
	yp.py0 = yp_opt_h;
	yp.ph = yp.ch;
	if (yp.cw < 16)
		yp.cw = 16;
	if (yp.ch < 16)
		yp.ch = 16;

	yp.nav_y = yp.py0;
	yp.col_y = yp.nav_y + YP_THUMB_H + 12;
	yp.lay_y = yp.col_y + YP_SV_H + yp_btn_h + 74;
	if (yp.lay_y > yp.py0 + yp.ph - yp_lay_list - 2 * yp_row_h)
		yp.lay_y = MaxI64(yp.py0 + 24,
						  yp.py0 + yp.ph - yp_lay_list - 2 * yp_row_h);

	MemSet(yp_sl, 0, sizeof(yp_sl));

	y = (yp_opt_h - yp_btn_h) / 2;
	lab = 4 * FONT_WIDTH + 2;
	step = lab + 62 + 4 + 4 * FONT_WIDTH + 8;
	px = 6 + 12 * FONT_WIDTH + 8;
	i = YPDRAG_SIZE;
	while (i <= YPDRAG_TOL && px + step < w)
	{
		yp_sl[i][0] = px + lab;
		yp_sl[i][1] = y;
		yp_sl[i][2] = 62;
		yp_sl[i][3] = yp_btn_h;
		px += step;
		i++;
	}

	if (!yp.panels)
		return;

	px = yp.px0 + 8;
	py = yp.col_y;
	yp_sl[YPDRAG_SV][0] = px;
	yp_sl[YPDRAG_SV][1] = py;
	yp_sl[YPDRAG_SV][2] = YP_SV_W;
	yp_sl[YPDRAG_SV][3] = YP_SV_H;
	yp_sl[YPDRAG_HUE][0] = px + YP_SV_W + 6;
	yp_sl[YPDRAG_HUE][1] = py;
	yp_sl[YPDRAG_HUE][2] = YP_HUE_W;
	yp_sl[YPDRAG_HUE][3] = YP_SV_H;

	yp_sl[YPDRAG_LOPAC][0] = yp.px0 + 62;
	yp_sl[YPDRAG_LOPAC][1] = yp.lay_y + yp_lay_op;
	yp_sl[YPDRAG_LOPAC][2] = YP_PANEL_W - 106;
	yp_sl[YPDRAG_LOPAC][3] = yp_btn_h - 2;
}

Bool YPInRect(I64 x, I64 y, I64 *r)
{
	if (!r[2] || !r[3])
		return FALSE;

	return r[0] <= x < r[0] + r[2] && r[1] <= y < r[1] + r[3];
}


U0 YPFillR(CDC *dc, I64 x, I64 y, I64 w, I64 h, CColorROPU32 col)
{
	if (w <= 0 || h <= 0)
		return;
	dc->color = col;
	GrRect(dc, x, y, w, h);
}

U0 YPFrameR(CDC *dc, I64 x, I64 y, I64 w, I64 h, CColorROPU32 col)
{
	if (w <= 0 || h <= 0)
		return;
	dc->color = col;
	GrRect(dc, x, y, w, 1);
	GrRect(dc, x, y + h - 1, w, 1);
	GrRect(dc, x, y, 1, h);
	GrRect(dc, x + w - 1, y, 1, h);
}

U0 YPSlider(CDC *dc, I64 *r, I64 val, I64 lo, I64 hi, Bool hot)
{
	I64 fill;

	if (!r[2])
		return;
	YPFillR(dc, r[0], r[1], r[2], r[3], yp.c_btn);
	if (hi > lo)
		fill = (val - lo) * (r[2] - 2) / (hi - lo);
	else
		fill = 0;
	YPFillR(dc, r[0] + 1, r[1] + 1, fill, r[3] - 2, yp.c_accent);
	if (hot)
		YPFrameR(dc, r[0], r[1], r[2], r[3], yp.c_hi);
	else
		YPFrameR(dc, r[0], r[1], r[2], r[3], yp.c_edge);
}

I64 YPSliderVal(I64 *r, I64 mx, I64 lo, I64 hi)
{
	I64 t;

	if (r[2] < 3)
		return lo;
	t = (mx - r[0] - 1) * (hi - lo) / (r[2] - 2) + lo;

	return ClampI64(t, lo, hi);
}

U0 YPToolIcon(CDC *dc, I64 tool, I64 x, I64 y, I64 s)
{
	I64 cx = x + s / 2, cy = y + s / 2, q = s / 4, t;

	switch (tool)
	{
		case YPT_BRUSH:
			GrLine(dc, x + 5, y + s - 6, cx + 2, y + 5);
			GrLine(dc, x + 7, y + s - 5, cx + 4, y + 6);
			GrRect(dc, x + 4, y + s - 7, 4, 3);
			break;

		case YPT_PENCIL:
			GrLine(dc, x + 5, y + s - 5, x + s - 6, y + 4);
			GrLine(dc, x + 6, y + s - 4, x + s - 5, y + 5);
			GrRect(dc, x + 4, y + s - 6, 3, 3);
			break;

		case YPT_ERASER:
			GrRect(dc, x + 5, cy - 2, s - 10, 6);
			GrLine(dc, x + 5, cy - 2, x + 9, cy - 6);
			GrLine(dc, x + s - 5, cy - 2, x + s - 1 - 4, cy - 6);
			break;

		case YPT_FILL:
			GrRect(dc, x + 5, cy - 4, s - 12, 8);
			GrLine(dc, x + s - 6, cy - 6, x + s - 6, cy + 1);
			GrLine(dc, x + s - 6, cy + 2, x + s - 8, cy + 6);
			break;

		case YPT_PICKER:
			GrLine(dc, x + 5, y + s - 5, x + s - 7, y + 6);
			GrRect(dc, x + s - 9, y + 4, 5, 5);
			break;

		case YPT_LINE:
			GrLine(dc, x + 5, y + s - 6, x + s - 5, y + 5);
			break;

		case YPT_RECT:
			GrRect(dc, x + 5, cy - q, s - 10, 2 * q);
			YPFillR(dc, x + 6, cy - q + 1, s - 12, 2 * q - 2, yp.c_btn);
			break;

		case YPT_ELLIPSE:
			GrEllipse(dc, cx, cy, s / 2 - 5, s / 2 - 5);
			break;

		case YPT_GRADIENT:
			GrRect(dc, x + 5, cy - q, s - 10, 2 * q);
			break;

		case YPT_MOVE:
			GrLine(dc, cx, y + 5, cx, y + s - 5);
			GrLine(dc, x + 5, cy, x + s - 5, cy);
			GrLine(dc, cx - 3, y + 8, cx, y + 5);
			GrLine(dc, cx + 3, y + 8, cx, y + 5);
			break;

		case YPT_PAN:
			GrRect(dc, cx - 4, cy - 2, 8, 7);
			GrRect(dc, cx - 2, cy - 7, 3, 6);
			break;

		case YPT_SEL_RECT:
			for (t = x + 5; t < x + s - 5; t += 4)
			{
				GrRect(dc, t, cy - 6, 2, 1);
				GrRect(dc, t, cy + 5, 2, 1);
			}
			for (t = cy - 6; t < cy + 6; t += 4)
			{
				GrRect(dc, x + 5, t, 1, 2);
				GrRect(dc, x + s - 6, t, 1, 2);
			}
			break;

		case YPT_SEL_LASSO:
			GrEllipse(dc, cx, cy - 1, s / 2 - 6, s / 2 - 8);
			GrLine(dc, cx - 3, cy + 5, cx - 6, cy + 9);
			break;

		case YPT_SEL_POLY:
			GrLine(dc, x + 5, y + s - 6, cx - 1, y + 5);
			GrLine(dc, cx - 1, y + 5, x + s - 5, cy);
			GrLine(dc, x + s - 5, cy, x + 5, y + s - 6);
			break;
	}
}

U0 YPDrawOptions(CDC *dc)
{
	I64 w = yp.win_w, ot = (yp_opt_h - FONT_HEIGHT) / 2;

	YPFillR(dc, 0, 0, w, yp_opt_h, yp.c_panel);
	YPFillR(dc, 0, yp_opt_h - 1, w, 1, yp.c_edge);

	dc->color = yp.c_text;
	GrPrint(dc, 6, ot, "%s", yp_shape_name[yp.shape]);

	if (yp_sl[YPDRAG_SIZE][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_SIZE][0] - 4 * FONT_WIDTH - 2, ot, "Size");
		YPSlider(dc, yp_sl[YPDRAG_SIZE], yp.size, YP_SIZE_MIN, YP_SIZE_MAX,
				 yp.slider == YPDRAG_SIZE);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_SIZE][0] + 66, ot, "%d", yp.size);
	}
	if (yp_sl[YPDRAG_HARD][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_HARD][0] - 4 * FONT_WIDTH - 2, ot, "Hard");
		YPSlider(dc, yp_sl[YPDRAG_HARD], yp.hardness, 0, 100,
				 yp.slider == YPDRAG_HARD);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_HARD][0] + 66, ot, "%d", yp.hardness);
	}
	if (yp_sl[YPDRAG_OPAC][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_OPAC][0] - 4 * FONT_WIDTH - 2, ot, "Opac");
		YPSlider(dc, yp_sl[YPDRAG_OPAC], yp.opacity, 0, 255,
				 yp.slider == YPDRAG_OPAC);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_OPAC][0] + 66, ot, "%d", yp.opacity);
	}
	if (yp_sl[YPDRAG_FLOW][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_FLOW][0] - 4 * FONT_WIDTH - 2, ot, "Flow");
		YPSlider(dc, yp_sl[YPDRAG_FLOW], yp.flow, 1, 255,
				 yp.slider == YPDRAG_FLOW);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_FLOW][0] + 66, ot, "%d", yp.flow);
	}
	if (yp_sl[YPDRAG_SPACE][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_SPACE][0] - 4 * FONT_WIDTH - 2, ot, "Spc ");
		YPSlider(dc, yp_sl[YPDRAG_SPACE], yp.spacing, 1, 200,
				 yp.slider == YPDRAG_SPACE);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_SPACE][0] + 66, ot, "%d", yp.spacing);
	}
	if (yp_sl[YPDRAG_TOL][2])
	{
		dc->color = yp.c_dim;
		GrPrint(dc, yp_sl[YPDRAG_TOL][0] - 4 * FONT_WIDTH - 2, ot, "Tol ");
		YPSlider(dc, yp_sl[YPDRAG_TOL], yp.fill_tol, 0, 255,
				 yp.slider == YPDRAG_TOL);
		dc->color = yp.c_text;
		GrPrint(dc, yp_sl[YPDRAG_TOL][0] + 66, ot, "%d", yp.fill_tol);
	}
}

U0 YPDrawToolbar(CDC *dc)
{
	I64 i, bx, by, col, row, y0 = yp.py0 + 4, sw = 22;

	YPFillR(dc, 0, yp.py0, YP_TOOL_W, yp.ph, yp.c_panel);
	YPFillR(dc, YP_TOOL_W - 1, yp.py0, 1, yp.ph, yp.c_edge);

	for (i = 0; i < YPT_COUNT; i++)
	{
		col = i & 1;
		row = i >> 1;
		bx = 3 + col * (YP_TB_BTN + 2);
		by = y0 + row * (YP_TB_BTN + 2);
		if (i == yp.tool)
		{
			YPFillR(dc, bx, by, YP_TB_BTN, YP_TB_BTN, yp.c_accent);
			YPFrameR(dc, bx, by, YP_TB_BTN, YP_TB_BTN, yp.c_hi);
			dc->color = yp.c_bg;
		}
		else
		{
			YPFillR(dc, bx, by, YP_TB_BTN, YP_TB_BTN, yp.c_btn);
			YPFrameR(dc, bx, by, YP_TB_BTN, YP_TB_BTN, yp.c_edge);
			dc->color = yp.c_text;
		}
		YPToolIcon(dc, i, bx, by, YP_TB_BTN);
	}

	by = y0 + ((YPT_COUNT + 1) >> 1) * (YP_TB_BTN + 2) + 8;
	YPFillR(dc, 16, by + 10, sw, sw, YPPen(yp.bg));
	YPFrameR(dc, 16, by + 10, sw, sw, yp.c_edge);
	YPFillR(dc, 6, by, sw, sw, YPPen(yp.fg));
	YPFrameR(dc, 6, by, sw, sw, yp.c_hi);

	by += sw + 22;
	YPFillR(dc, 6, by, 46, 46, yp.c_btn);
	YPFrameR(dc, 6, by, 46, 46, yp.c_edge);
	dc->color = YPPen(yp.fg);
	if (yp.size <= 2)
		GrRect(dc, 28, by + 22, 2, 2);
	else
		GrEllipse(dc, 29, by + 23, MinI64(yp.size, 40) / 2, MinI64(yp.size, 40) / 2);
	dc->color = yp.c_dim;
	GrPrint(dc, 8, by + 50, "%d", yp.size);
}

U0 YPDrawNav(CDC *dc)
{
	I64 x = yp.px0 + 8, y = yp.nav_y + 4, vx, vy, vw, vh, sw, sh;

	YPFrameR(dc, x - 1, y - 1, YP_THUMB_W + 2, YP_THUMB_H + 2, yp.c_edge);
	if (yp.nav)
		GrBlot(dc, x, y, yp.nav);

	if (yp.doc_w * YP_THUMB_H > yp.doc_h * YP_THUMB_W)
	{
		sw = YP_THUMB_W;
		sh = yp.doc_h * YP_THUMB_W / yp.doc_w;
	}
	else
	{
		sh = YP_THUMB_H;
		sw = yp.doc_w * YP_THUMB_H / yp.doc_h;
	}

	vx = ClampI64(yp.pan_x * sw / yp.doc_w, 0, sw);
	vy = ClampI64(yp.pan_y * sh / yp.doc_h, 0, sh);
	vw = ClampI64(YPV2DX(yp.view_w) * sw / yp.doc_w - vx, 1, sw - vx);
	vh = ClampI64(YPV2DY(yp.view_h) * sh / yp.doc_h - vy, 1, sh - vy);
	YPFrameR(dc, x + vx, y + vy, vw, vh, yp.c_hi);
}

U0 YPDrawColor(CDC *dc)
{
	I64 x = yp.px0 + 8, y = yp.col_y, i, sx, sy, cw = 22, ch = 16, r;

	if (yp_sv)
	{
		GrBlot(dc, x, y, yp_sv);
		YPFrameR(dc, x - 1, y - 1, YP_SV_W + 2, YP_SV_H + 2, yp.c_edge);
		GrBlot(dc, x + YP_SV_W + 6, y, yp_hue);
		YPFrameR(dc, x + YP_SV_W + 5, y - 1, YP_HUE_W + 2, YP_SV_H + 2,
				 yp.c_edge);
	}

	sx = x + ToI64(yp.sat * (YP_SV_W - 1));
	sy = y + ToI64((1.0 - yp.val) * (YP_SV_H - 1));
	dc->color = ColorRGB(0, 0, 0);
	GrEllipse(dc, sx, sy, 5, 5);
	dc->color = ColorRGB(255, 255, 255);
	GrEllipse(dc, sx, sy, 4, 4);
	r = y + ToI64(yp.hue / 360.0 * (YP_SV_H - 1));
	YPFrameR(dc, x + YP_SV_W + 4, r - 2, YP_HUE_W + 4, 5,
			 ColorRGB(255, 255, 255));

	y += YP_SV_H + 6;
	YPFillR(dc, x, y, 30, yp_btn_h, YPPen(yp.fg));
	YPFrameR(dc, x, y, 30, yp_btn_h, yp.c_hi);
	YPFillR(dc, x + 34, y, 30, yp_btn_h, YPPen(yp.bg));
	YPFrameR(dc, x + 34, y, 30, yp_btn_h, yp.c_edge);
	dc->color = yp.c_text;
	GrPrint(dc, x + 72, y + (yp_btn_h - FONT_HEIGHT) / 2, "%06X",
			yp.fg & 0x00FFFFFF);

	y += yp_btn_h + 6;
	for (i = 0; i < YP_SWATCHES; i++)
	{
		sx = x + (i % 8) * (cw + 2);
		sy = y + (i / 8) * (ch + 2);
		YPFillR(dc, sx, sy, cw, ch, YPPen(yp.swatch[i]));
		YPFrameR(dc, sx, sy, cw, ch, yp.c_edge);
	}
}

U0 YPLayerThumb(CDC *dc, I64 li, I64 x, I64 y)
{
	I64 tx, ty, dx, dy, a, r, g, b, idx, w = YP_LT_W, h = YP_LT_H;
	U32 c;

	if (!yp.lthumb)
		return;

	for (ty = 0; ty < h; ty++)
		for (tx = 0; tx < w; tx++)
		{
			dx = tx * yp.doc_w / w;
			dy = ty * yp.doc_h / h;
			c = yp.layer[li].px[dy * yp.doc_w + dx];
			a = c >> 24 & 0xFF;
			if (((tx >> 2) + (ty >> 2)) & 1)
				idx = 0x50;
			else
				idx = 0x38;
			r = ((c >> 16 & 0xFF) * a + idx * (255 - a)) / 255;
			g = ((c >> 8  & 0xFF) * a + idx * (255 - a)) / 255;
			b = ((c 	  & 0xFF) * a + idx * (255 - a)) / 255;
			yp.lthumb->body[ty * yp.lthumb->width_internal + tx] =
				(r << 16) | (g << 8) | b;
		}

	GrBlot(dc, x, y, yp.lthumb);
	YPFrameR(dc, x - 1, y - 1, w + 2, h + 2, yp.c_edge);
}

U0 YPDrawLayers(CDC *dc)
{
	I64 		x = yp.px0 + 6, y = yp.lay_y, i, ry, bx, rows, li,
				lw = YP_PANEL_W - 12,
				bt = (yp_btn_h - FONT_HEIGHT) / 2,	//text inset in a button
				rt = (yp_row_h - 2 - FONT_HEIGHT) / 2;
	CYPLayer   *l;
	U8			bl[8];

	YPFillR(dc, yp.px0, y - 4, YP_PANEL_W, 1, yp.c_edge);
	dc->color = yp.c_dim;
	GrPrint(dc, x, y + bt, "LAYERS");

	for (i = 0; i < 6; i++)
	{
		bx = x + 7 * FONT_WIDTH + 6 + i * 24;
		YPFillR(dc, bx, y, 22, yp_btn_h, yp.c_btn);
		YPFrameR(dc, bx, y, 22, yp_btn_h, yp.c_edge);
		dc->color = yp.c_text;
		switch (i)
		{
			case 0: GrPrint(dc, bx + 8, y + bt, "+");  break;
			case 1: GrPrint(dc, bx + 3, y + bt, "Dp"); break;
			case 2: GrPrint(dc, bx + 8, y + bt, "-");  break;
			case 3: GrPrint(dc, bx + 8, y + bt, "^");  break;
			case 4: GrPrint(dc, bx + 8, y + bt, "v");  break;
			case 5: GrPrint(dc, bx + 3, y + bt, "Mg"); break;
		}
	}

	l = &yp.layer[yp.cur];
	dc->color = yp.c_dim;
	GrPrint(dc, x, y + yp_lay_op + bt, "Op");
	YPSlider(dc, yp_sl[YPDRAG_LOPAC], l->opacity, 0, 255,
			 yp.slider == YPDRAG_LOPAC);
	dc->color = yp.c_text;
	GrPrint(dc, yp.px0 + YP_PANEL_W - 38, y + yp_lay_op + bt, "%3d",
			l->opacity);

	YPFillR(dc, x, y + yp_lay_bl, lw, yp_btn_h, yp.c_btn);
	YPFrameR(dc, x, y + yp_lay_bl, lw, yp_btn_h, yp.c_edge);
	dc->color = yp.c_text;
	GrPrint(dc, x + 4, y + yp_lay_bl + bt, "%s", yp_blend_name[l->blend]);
	if (l->alpha_lock)
	{
		dc->color = yp.c_accent;
		GrPrint(dc, x + lw - 3 * FONT_WIDTH, y + yp_lay_bl + bt, "AL");
	}

	ry = y + yp_lay_list;
	rows = (yp.py0 + yp.ph - ry) / yp_row_h;
	if (rows < 1)
		rows = 1;
	yp.lay_scroll = ClampI64(yp.lay_scroll, 0,
							 MaxI64(0, yp.layer_n - rows));

	for (i = 0; i < rows; i++)
	{
		li = yp.layer_n - 1 - i - yp.lay_scroll;
		if (li < 0)
			break;
		l = &yp.layer[li];

		if (li == yp.cur)
			YPFillR(dc, x, ry, lw, yp_row_h - 2, yp.c_sel);
		else
			YPFillR(dc, x, ry, lw, yp_row_h - 2, yp.c_panel);

		YPFrameR(dc, x + 3, ry + (yp_row_h - 13) / 2, 11, 11, yp.c_edge);
		if (l->visible)
			YPFillR(dc, x + 5, ry + (yp_row_h - 9) / 2, 7, 7, yp.c_accent);

		YPLayerThumb(dc, li, x + 20, ry + (yp_row_h - 2 - YP_LT_H) / 2);

		if (l->clip && li > 0)
		{
			dc->color = yp.c_accent;
			GrLine(dc, x + 47, ry + 4, x + 47, ry + yp_row_h - 8);
			GrLine(dc, x + 47, ry + yp_row_h - 8, x + 51, ry + yp_row_h - 8);
		}

		dc->color = yp.c_text;
		GrPrint(dc, x + 54, ry + rt, "%s", l->name);
		bl[0] = yp_blend_name[l->blend][0];
		bl[1] = yp_blend_name[l->blend][1];
		bl[2] = 0;
		dc->color = yp.c_dim;
		GrPrint(dc, x + lw - 7 * FONT_WIDTH, ry + rt, "%s %3d", bl,
				l->opacity * 100 / 255);

		ry += yp_row_h;
	}
}

U0 YPDrawStatus(CDC *dc)
{
	I64 y = yp.win_h - yp_status_h, st = (yp_status_h - FONT_HEIGHT) / 2;
	U8	m;

	YPFillR(dc, 0, y, yp.win_w, yp_status_h, yp.c_panel);
	YPFillR(dc, 0, y, yp.win_w, 1, yp.c_edge);

	dc->color = yp.c_text;
	if (yp.in_doc)
		GrPrint(dc, 6, y + st, "%4d,%-4d", yp.dx, yp.dy);
	else
		GrPrint(dc, 6, y + st, "   -,-   ");

	dc->color = yp.c_dim;
	if (yp.zoom_den == 1)
		GrPrint(dc, 90, y + st, "%dx", yp.zoom_num);
	else
		GrPrint(dc, 90, y + st, "%d/%d", yp.zoom_num, yp.zoom_den);
	GrPrint(dc, 140, y + st, "%dx%d", yp.doc_w, yp.doc_h);
	GrPrint(dc, 230, y + st, "%s", yp_tool_name[yp.tool]);
	GrPrint(dc, 300, y + st, "L%d/%d", yp.cur + 1, yp.layer_n);

	if (yp.modified)
		m = '*';
	else
		m = ' ';
	dc->color = yp.c_text;
	GrPrint(dc, 380, y + st, "%c%s", m, yp.status);
}

//On-canvas cursors are drawn twice, black one pixel proud then white.

U0 YPGhostLine(CDC *dc, I64 x0, I64 y0, I64 x1, I64 y1)
{
	dc->color = ColorRGB(0, 0, 0);
	GrLine(dc, x0, y0 + 1, x1, y1 + 1);
	GrLine(dc, x0 + 1, y0, x1 + 1, y1);
	dc->color = ColorRGB(255, 255, 255);
	GrLine(dc, x0, y0, x1, y1);
}

U0 YPGhostFrame(CDC *dc, I64 x, I64 y, I64 w, I64 h)
{
	YPFrameR(dc, x - 1, y - 1, w + 2, h + 2, ColorRGB(0, 0, 0));
	YPFrameR(dc, x + 1, y + 1, w - 2, h - 2, ColorRGB(0, 0, 0));
	YPFrameR(dc, x, y, w, h, ColorRGB(255, 255, 255));
}

U0 YPGhostEllipse(CDC *dc, I64 x, I64 y, I64 rx, I64 ry)
{
	dc->color = ColorRGB(0, 0, 0);
	GrEllipse(dc, x, y, rx + 1, ry + 1);
	if (rx > 1 && ry > 1)
		GrEllipse(dc, x, y, rx - 1, ry - 1);
	dc->color = ColorRGB(255, 255, 255);
	GrEllipse(dc, x, y, rx, ry);
}

U0 YPRectG(CDC *dc, I64 x, I64 y, I64 w, I64 h, I64 g)
{
	GrRect(dc, x - g, y - g, w + 2 * g, h + 2 * g);
}

U0 YPHandShape(CDC *dc, I64 x, I64 y, Bool grab, I64 g)
{
	if (grab)
	{
		YPRectG(dc, x - 6, y - 3, 13, 10, g);
		YPRectG(dc, x - 6, y - 6, 3, 4, g);
		YPRectG(dc, x - 2, y - 7, 3, 5, g);
		YPRectG(dc, x + 2, y - 7, 3, 5, g);
		YPRectG(dc, x + 6, y - 6, 3, 4, g);
		YPRectG(dc, x - 9, y - 1, 4, 5, g);
	}
	else
	{
		YPRectG(dc, x - 6, y - 2, 13, 9, g);
		YPRectG(dc, x - 6, y - 9, 3, 8, g);
		YPRectG(dc, x - 2, y - 11, 3, 10, g);
		YPRectG(dc, x + 2, y - 10, 3, 9, g);
		YPRectG(dc, x + 6, y - 8, 3, 7, g);
		YPRectG(dc, x - 9, y - 1, 4, 6, g);
	}
}

U0 YPCursorHand(CDC *dc, I64 x, I64 y, Bool grab)
{
	dc->color = ColorRGB(0, 0, 0);
	YPHandShape(dc, x, y, grab, 1);
	dc->color = ColorRGB(255, 255, 255);
	YPHandShape(dc, x, y, grab, 0);
}

U0 YPAntsRun(CDC *dc, I64 x0, I64 y0, I64 x1, I64 y1)
{//Dash one axis-aligned run in window coords, alternating black and white
//in 4-pixel steps offset by the animation phase.
	I64 len, t, e, ph = yp.ants, horiz = y0 == y1;

	if (horiz)
		len = x1 - x0;
	else
		len = y1 - y0;
	if (len <= 0)
		return;

	for (t = 0; t < len; t += 4)
	{
		e = MinI64(t + 4, len);
		if (((t + ph) >> 2) & 1)
			dc->color = ColorRGB(0, 0, 0);
		else
			dc->color = ColorRGB(255, 255, 255);
		if (horiz)
			GrRect(dc, x0 + t, y0, e - t, 1);
		else
			GrRect(dc, x0, y0 + t, 1, e - t);
	}
}

U0 YPDrawAnts(CDC *dc)
{
	I64 i, x0, y0, x1, y1, cx1 = yp.cx + yp.cw, cy1 = yp.cy + yp.ch;

	if (!yp.has_sel)
		return;

	for (i = 0; i < yp_seg_n; i++)
	{
		x0 = yp.cx + YPD2VX(yp_seg[i][0]);
		y0 = yp.cy + YPD2VY(yp_seg[i][1]);
		x1 = yp.cx + YPD2VX(yp_seg[i][2]);
		y1 = yp.cy + YPD2VY(yp_seg[i][3]);
		if (x1 >= yp.cx && x0 <= cx1 && y1 >= yp.cy && y0 <= cy1)
		{
			x0 = ClampI64(x0, yp.cx, cx1);
			y0 = ClampI64(y0, yp.cy, cy1);
			x1 = ClampI64(x1, yp.cx, cx1);
			y1 = ClampI64(y1, yp.cy, cy1);
			YPAntsRun(dc, x0, y0, x1, y1);
		}
	}
}

U0 YPDrawPolyPreview(CDC *dc, Bool to_cursor)
{
	I64 i, x0, y0, x1, y1;

	if (yp_poly_n < 1)
		return;
	for (i = 0; i + 1 < yp_poly_n; i++)
	{
		x0 = yp.cx + YPD2VX(yp_poly_x[i]);
		y0 = yp.cy + YPD2VY(yp_poly_y[i]);
		x1 = yp.cx + YPD2VX(yp_poly_x[i + 1]);
		y1 = yp.cy + YPD2VY(yp_poly_y[i + 1]);
		YPGhostLine(dc, x0, y0, x1, y1);
	}
	if (to_cursor)
	{
		x0 = yp.cx + YPD2VX(yp_poly_x[yp_poly_n - 1]);
		y0 = yp.cy + YPD2VY(yp_poly_y[yp_poly_n - 1]);
		YPGhostLine(dc, x0, y0, yp.mx, yp.my);
		x1 = yp.cx + YPD2VX(yp_poly_x[0]);
		y1 = yp.cy + YPD2VY(yp_poly_y[0]);
		YPGhostFrame(dc, x1 - 3, y1 - 3, 7, 7);
	}
}

U0 YPDrawCanvasOverlay(CDC *dc)
{
	I64 x0, y0, x1, y1, t, r;

	if (yp.tool == YPT_SEL_POLY && yp_poly_n)
	{
		YPDrawPolyPreview(dc, TRUE);
		return;
	}
	if (yp.dragging && yp.tool == YPT_SEL_LASSO)
	{
		YPDrawPolyPreview(dc, FALSE);
		return;
	}

	if (yp.dragging)
	{
		x0 = yp.cx + YPD2VX(yp.drag_x0);
		y0 = yp.cy + YPD2VY(yp.drag_y0);
		x1 = yp.cx + YPD2VX(yp.drag_x1);
		y1 = yp.cy + YPD2VY(yp.drag_y1);
		x0 = ClampI64(x0, yp.cx, yp.cx + yp.cw - 1);
		y0 = ClampI64(y0, yp.cy, yp.cy + yp.ch - 1);
		x1 = ClampI64(x1, yp.cx, yp.cx + yp.cw - 1);
		y1 = ClampI64(y1, yp.cy, yp.cy + yp.ch - 1);

		switch (yp.tool)
		{
			case YPT_LINE:
			case YPT_GRADIENT:
				YPGhostLine(dc, x0, y0, x1, y1);
				break;

			case YPT_SEL_RECT:
			case YPT_RECT:
				if (x0 > x1)
				{
					t = x0;
					x0 = x1;
					x1 = t;
				}
				if (y0 > y1)
				{
					t = y0;
					y0 = y1;
					y1 = t;
				}
				YPGhostFrame(dc, x0, y0, x1 - x0 + 1, y1 - y0 + 1);
				break;

			case YPT_ELLIPSE:
				YPGhostEllipse(dc, (x0 + x1) / 2, (y0 + y1) / 2,
							   MaxI64(AbsI64(x1 - x0) / 2, 1),
							   MaxI64(AbsI64(y1 - y0) / 2, 1));
				break;
		}
		return;
	}

	if (yp.pan_drag)
	{
		YPCursorHand(dc, yp.mx, yp.my, TRUE);
		return;
	}
	if (yp.region != YPR_CANVAS)
		return;
	if (yp.mod_pan || yp.tool == YPT_PAN)
	{
		YPCursorHand(dc, yp.mx, yp.my, FALSE);
		return;
	}
	if (!yp.in_doc)
		return;

	if (yp.mod_pick || yp.tool == YPT_PICKER)
	{
		YPGhostLine(dc, yp.mx - 6, yp.my + 6, yp.mx + 4, yp.my - 4);
		YPGhostFrame(dc, yp.mx + 3, yp.my - 8, 6, 6);
		return;
	}
	if (yp.tool == YPT_MOVE)
		return;

	r = yp.size * yp.zoom_num / yp.zoom_den / 2;
	if (r < 2)
	{
		YPGhostLine(dc, yp.mx - 5, yp.my, yp.mx - 2, yp.my);
		YPGhostLine(dc, yp.mx + 2, yp.my, yp.mx + 5, yp.my);
		YPGhostLine(dc, yp.mx, yp.my - 5, yp.mx, yp.my - 2);
		YPGhostLine(dc, yp.mx, yp.my + 2, yp.mx, yp.my + 5);
	}
	else
		YPGhostEllipse(dc, yp.mx, yp.my, r, r);
}

U0 YPDrawIt(CTask *task, CDC *dc)
{
	if (!yp.view || task->pix_width != yp.win_w ||
		task->pix_height != yp.win_h)
		return;

	GrBlot(dc, yp.cx, yp.cy, yp.view);
	YPDrawAnts(dc);
	YPDrawCanvasOverlay(dc);
	YPDrawOptions(dc);
	if (yp.panels)
	{
		YPFillR(dc, yp.px0, yp.py0, yp.pw, yp.ph, yp.c_panel);
		YPFillR(dc, yp.px0, yp.py0, 1, yp.ph, yp.c_edge);
		YPDrawToolbar(dc);
		YPDrawNav(dc);
		YPDrawColor(dc);
		YPDrawLayers(dc);
	}
	YPDrawStatus(dc);
}

I64 YPHitTest(I64 x, I64 y)
{//Returns a YPR_*; sets yp.dx/dy when the point is over the canvas.
	I64 i;

	yp.in_doc = FALSE;

	if (y >= yp.win_h - yp_status_h)
		return YPR_STATUS;
	if (y < yp_opt_h)
	{
		for (i = YPDRAG_SIZE; i <= YPDRAG_TOL; i++)
			if (YPInRect(x, y, yp_sl[i]))
				return i;
		return YPR_OPTIONS;
	}
	if (yp.panels && x < YP_TOOL_W)
		return YPR_TOOLBAR;

	if (yp.cx <= x < yp.cx + yp.cw && yp.cy <= y < yp.cy + yp.ch)
	{
		yp.dx = YPV2DX(x - yp.cx);
		yp.dy = YPV2DY(y - yp.cy);
		yp.in_doc = 0 <= yp.dx < yp.doc_w && 0 <= yp.dy < yp.doc_h;
		return YPR_CANVAS;
	}

	if (!yp.panels || x < yp.px0)
		return YPR_NONE;

	if (YPInRect(x, y, yp_sl[YPDRAG_SV]))
		return YPDRAG_SV;
	if (YPInRect(x, y, yp_sl[YPDRAG_HUE]))
		return YPDRAG_HUE;
	if (YPInRect(x, y, yp_sl[YPDRAG_LOPAC]))
		return YPDRAG_LOPAC;
	if (y < yp.nav_y + YP_THUMB_H + 8)
		return YPR_NAV;
	if (y < yp.lay_y)
		return YPR_SWATCH;
	if (y < yp.lay_y + yp_lay_op)
		return YPR_LAYERBTN;
	if (y < yp.lay_y + yp_lay_list)
		return YPR_BLEND;

	return YPR_LAYERS;
}
