// Run.ZC - build and launch entry point.
//
// single-pass compiler: a file can only reference symbols from an earlier
// one, so this order is load-bearing
//
//   YPDef    constants, layer/document classes, colour maths  (no deps)
//   YPImage  blend modes, compositing, .YPT body, undo        -> YPDef
//   YPBrush  tip generation, stroke accumulation              -> YPDef, YPImage
//   YPTool   fill, shapes, gradient, move                     -> +YPBrush
//   YPFile   disk formats and image import                    -> +YPTool
//   YPUI     layout, rendering, hit testing                   -> +YPFile
//   yPainter menu, input dispatch, main loop                  -> everything

Cd(__DIR__);;

#include "YPDef"
#include "YPImage"
#include "YPBrush"
#include "YPTool"
#include "YPFile"
#include "YPUI"
#include "yPainter"

yPainter;
