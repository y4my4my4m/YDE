
#define YP_SIZE_MIN 	1
#define YP_SIZE_MAX 	256

U0 YPStampBuild()
{
	I64 d = ClampI64(yp.size, YP_SIZE_MIN, YP_SIZE_MAX), i, j, cov, dens;
	F64 c, r, ri, dx, dy, rx, ry, dist, t, hard;

	if (yp.stamp_d != d)
	{
		Free(yp.stamp);
		yp.stamp = MAlloc(d * d);
		yp.stamp_d = d;
	}

	c	 = (d - 1) / 2.0;
	r	 = d / 2.0;
	hard = ClampI64(yp.hardness, 0, 100) / 100.0;
	if (yp.shape == YPS_SOFT)
		hard *= 0.25;
	ri = r * hard;

	for (j = 0; j < d; j++)
		for (i = 0; i < d; i++)
		{
			dx = i - c;
			dy = j - c;

			switch (yp.shape)
			{
				case YPS_SQUARE:
					dist = Abs(dx);
					if (Abs(dy) > dist)
						dist = Abs(dy);
					break;

				case YPS_CALLIG:
					//Nib is a 4:1 ellipse rotated 45 degrees.
					rx = (dx + dy) * 0.70710678;
					ry = (dy - dx) * 0.70710678;
					dist = Sqrt(rx * rx + 16.0 * ry * ry);
					break;

				default:
					dist = Sqrt(dx * dx + dy * dy);
			}

			if (yp.shape == YPS_PIXEL)
			{
				if (dist <= r - 0.5)
					cov = 255;
				else
					cov = 0;
			}
			else if (dist <= ri)
				cov = 255;
			else if (dist >= r)
				cov = 0;
			else
			{
				t = (r - dist) / (r - ri);
				cov = ToI64(255.0 * t * t * (3.0 - 2.0 * t));
			}

			if (yp.shape == YPS_SPRAY && cov)
			{
				dens = cov * cov / 255;
				if ((RandU16 & 0xFF) < dens)
					cov = 255;
				else
					cov = 0;
			}

			if (!yp.anti_alias && yp.shape != YPS_SPRAY)
			{
				if (cov >= 128)
					cov = 255;
				else
					cov = 0;
			}

			yp.stamp[j * d + i] = ClampI64(cov, 0, 255);
		}

	yp.stamp_dirty = FALSE;
}

U0 YPStrokeFlushRect(I64 x0, I64 y0, I64 x1, I64 y1)
{
	I64 		x, y, row, idx, a, cov, sa, oa, i, num,
				op = ClampI64(yp.opacity, 0, 255), w = yp.doc_w,
				sc[3], dc[3];
	U32 		s, col = yp.stroke_col;
	I64 		cr = col >> 16 & 0xFF,
				cg = col >> 8  & 0xFF,
				cb = col	   & 0xFF;
	CYPLayer   *l = &yp.layer[yp.stroke_layer];
	Bool		lock = l->alpha_lock;

	x0 = ClampI64(x0, 0, w);
	x1 = ClampI64(x1, 0, w);
	y0 = ClampI64(y0, 0, yp.doc_h);
	y1 = ClampI64(y1, 0, yp.doc_h);

	for (y = y0; y < y1; y++)
	{
		row = y * w;
		for (x = x0; x < x1; x++)
		{
			idx = row + x;
			cov = yp.acc[idx];
			if (yp.has_sel)
				cov = cov * yp.sel[idx] / 255;
			s	= yp.snap[idx];
			if (!cov)
			{
				l->px[idx] = s;
				goto flush_next;
			}
			a = cov * op / 255;
			sa = s >> 24 & 0xFF;

			if (yp.stroke_erase)
			{
				l->px[idx] = ((sa * (255 - a) / 255) << 24) |
							 (s & 0x00FFFFFF);
				goto flush_next;
			}

			if (lock)
			{
				if (!sa)
					l->px[idx] = s;
				else
				{
					dc[0] = s >> 16 & 0xFF;
					dc[1] = s >> 8	& 0xFF;
					dc[2] = s		& 0xFF;
					l->px[idx] = (sa << 24) |
						(((dc[0] + (cr - dc[0]) * a / 255) & 0xFF) << 16) |
						(((dc[1] + (cg - dc[1]) * a / 255) & 0xFF) << 8) |
						 ((dc[2] + (cb - dc[2]) * a / 255) & 0xFF);
				}
				goto flush_next;
			}

			if (a >= 255)
			{
				l->px[idx] = 0xFF000000 | (col & 0x00FFFFFF);
				goto flush_next;
			}
			if (!sa)
			{
				l->px[idx] = (a << 24) | (col & 0x00FFFFFF);
				goto flush_next;
			}

			sc[0] = cr;
			sc[1] = cg;
			sc[2] = cb;
			dc[0] = s >> 16 & 0xFF;
			dc[1] = s >> 8	& 0xFF;
			dc[2] = s		& 0xFF;
			oa = a + sa - (a * sa / 255);
			for (i = 0; i < 3; i++)
			{
				num = a * 255 * sc[i] + (255 - a) * sa * dc[i];
				sc[i] = ClampI64(num / (255 * oa), 0, 255);
			}
			l->px[idx] = (oa << 24) | (sc[0] << 16) | (sc[1] << 8) | sc[2];
flush_next:
			;
		}
	}
}

U0 YPStampAt(I64 cx, I64 cy)
{
	I64 d = yp.stamp_d, ox, oy, x0, y0, x1, y1, x, y, cov, add, ai,
		flow = ClampI64(yp.flow, 1, 255), w = yp.doc_w;
	U8 *a;

	if (yp.shape == YPS_SPRAY)
		YPStampBuild;

	ox = cx - d / 2;
	oy = cy - d / 2;
	x0 = MaxI64(ox, 0);
	y0 = MaxI64(oy, 0);
	x1 = MinI64(ox + d, w);
	y1 = MinI64(oy + d, yp.doc_h);
	if (x0 >= x1 || y0 >= y1)
		return;

	for (y = y0; y < y1; y++)
		for (x = x0; x < x1; x++)
		{
			cov = yp.stamp[(y - oy) * d + (x - ox)];
			if (cov)
			{
				a = &yp.acc[y * w + x];
				if (flow >= 255)
				{
					if (cov > *a)
						*a = cov;
				}
				else
				{
					add = cov * flow / 255;
					ai = *a + (add * (255 - *a) / 255);
					*a = ClampI64(ai, 0, 255);
				}
			}
		}

	if (x0 < yp.ax0)
		yp.ax0 = x0;
	if (y0 < yp.ay0)
		yp.ay0 = y0;
	if (x1 > yp.ax1)
		yp.ax1 = x1;
	if (y1 > yp.ay1)
		yp.ay1 = y1;

	YPStrokeFlushRect(x0, y0, x1, y1);
	YPDirty(x0, y0, x1, y1);
}

U0 YPStrokeOpen(U32 col, Bool erase)
{
	I64 n = yp.doc_w * yp.doc_h;

	yp.stroke_layer = yp.cur;
	yp.stroke_col	= col;
	yp.stroke_erase = erase;
	MemCopy(yp.snap, yp.layer[yp.cur].px, n * sizeof(U32));
	MemSet(yp.acc, 0, n);
	yp.ax0 = I64_MAX;
	yp.ay0 = I64_MAX;
	yp.ax1 = I64_MIN;
	yp.ay1 = I64_MIN;
	yp.stroke_carry = 0.0;
	yp.drawing = TRUE;
	if (yp.stamp_dirty)
		YPStampBuild;
}

U0 YPAccCover(I64 x, I64 y, I64 cov)
{
	I64 idx;

	if (x < 0 || y < 0 || x >= yp.doc_w || y >= yp.doc_h || cov <= 0)
		return;
	idx = y * yp.doc_w + x;
	if (cov > yp.acc[idx])
		yp.acc[idx] = MinI64(cov, 255);
	if (x < yp.ax0)
		yp.ax0 = x;
	if (y < yp.ay0)
		yp.ay0 = y;
	if (x + 1 > yp.ax1)
		yp.ax1 = x + 1;
	if (y + 1 > yp.ay1)
		yp.ay1 = y + 1;
}

U0 YPAccCommit()
{
	if (yp.ax0 >= yp.ax1 || yp.ay0 >= yp.ay1)
		return;
	YPStrokeFlushRect(yp.ax0, yp.ay0, yp.ax1, yp.ay1);
	YPDirty(yp.ax0, yp.ay0, yp.ax1, yp.ay1);
}

U0 YPStrokeBegin(I64 x, I64 y, U32 col, Bool erase)
{
	if (yp.drawing)
		return;
	if (!yp.layer[yp.cur].visible)
		YPStatus("Layer %d is hidden", yp.cur + 1);

	YPStrokeOpen(col, erase);
	YPStampAt(x, y);
	yp.stroke_x = x;
	yp.stroke_y = y;
}

U0 YPStrokeTo(I64 x, I64 y)
{
	F64 dx, dy, dist, step, travelled = 0.0, need, t;

	if (!yp.drawing)
		return;
	dx = x - yp.stroke_x;
	dy = y - yp.stroke_y;
	dist = Sqrt(dx * dx + dy * dy);
	if (dist <= 0.0)
		return;

	step = yp.stamp_d * ClampI64(yp.spacing, 1, 400) / 100.0;
	if (step < 1.0)
		step = 1.0;

	while (yp.stroke_carry + (dist - travelled) >= step)
	{
		need = step - yp.stroke_carry;
		travelled += need;
		t = travelled / dist;
		YPStampAt(yp.stroke_x + ToI64(dx * t), yp.stroke_y + ToI64(dy * t));
		yp.stroke_carry = 0.0;
	}
	yp.stroke_carry += dist - travelled;
	yp.stroke_x = x;
	yp.stroke_y = y;
}

U0 YPStrokeEnd(U8 *label="Stroke")
{
	if (!yp.drawing)
		return;
	yp.drawing = FALSE;
	if (yp.ax0 >= yp.ax1 || yp.ay0 >= yp.ay1)
		return;
	YPUndoPushPix(yp.stroke_layer, yp.ax0, yp.ay0,
				  yp.ax1 - yp.ax0, yp.ay1 - yp.ay0, label, yp.snap);
	yp.modified = TRUE;
}

U0 YPStrokeCancel()
{
	if (!yp.drawing)
		return;
	yp.drawing = FALSE;
	if (yp.ax0 < yp.ax1 && yp.ay0 < yp.ay1)
	{
		MemCopy(yp.layer[yp.stroke_layer].px, yp.snap,
				yp.doc_w * yp.doc_h * sizeof(U32));
		YPDirty(yp.ax0, yp.ay0, yp.ax1, yp.ay1);
	}
}

U0 YPBrushSizeSet(I64 n)
{
	yp.size = ClampI64(n, YP_SIZE_MIN, YP_SIZE_MAX);
	yp.stamp_dirty = TRUE;
	YPStampBuild;
}

U0 YPBrushHardnessSet(I64 n)
{
	yp.hardness = ClampI64(n, 0, 100);
	yp.stamp_dirty = TRUE;
	YPStampBuild;
}

U0 YPBrushShapeSet(I64 n)
{
	yp.shape = ClampI64(n, 0, YPS_COUNT - 1);
	yp.stamp_dirty = TRUE;
	YPStampBuild;
}
