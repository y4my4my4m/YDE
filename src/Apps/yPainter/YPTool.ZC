//Tools that are not plain brush strokes: flood fill, shapes, gradient, move.
//Depends on YPDef, YPImage, YPBrush.
//
//Everything that deposits the foreground colour writes coverage into yp.acc
//and commits through YPStrokeFlushRect, so opacity, alpha lock and the eraser
//behave identically across tools.

U32 YPOver(U32 dst, U32 src, I64 a)
{//Straight-alpha source-over at coverage a (0..255).
	I64 sa = ((src >> 24 & 0xFF) * a / 255), da, oa, i, num, sc[3], dc[3];

	if (!sa)
		return dst;
	da = dst >> 24 & 0xFF;
	if (!da)
		return (sa << 24) | (src & 0x00FFFFFF);
	if (sa >= 255)
		return 0xFF000000 | (src & 0x00FFFFFF);

	sc[0] = src >> 16 & 0xFF;
	sc[1] = src >> 8  & 0xFF;
	sc[2] = src		  & 0xFF;
	dc[0] = dst >> 16 & 0xFF;
	dc[1] = dst >> 8  & 0xFF;
	dc[2] = dst		  & 0xFF;
	oa = sa + da - (sa * da / 255);
	for (i = 0; i < 3; i++)
	{
		num = sa * 255 * sc[i] + (255 - sa) * da * dc[i];
		sc[i] = ClampI64(num / (255 * oa), 0, 255);
	}

	return (oa << 24) | (sc[0] << 16) | (sc[1] << 8) | sc[2];
}

U32 YPMix(U32 a, U32 b, I64 t)
{//All four channels of a toward b by t/255.
	I64 i, ca, cb, o = 0;

	if (t <= 0)
		return a;
	if (t >= 255)
		return b;
	for (i = 0; i < 4; i++)
	{
		ca = a >> (8 * i) & 0xFF;
		cb = b >> (8 * i) & 0xFF;
		o |= ((ca + (cb - ca) * t / 255) & 0xFF) << (8 * i);
	}

	return o;
}

I64 YPSelCov(I64 idx)
{//Coverage by flat index; 255 everywhere when no selection is active.
	if (!yp.has_sel)
		return 255;

	return yp.sel[idx];
}

U32 YPSample(I64 x, I64 y, Bool merged)
{
	if (x < 0 || y < 0 || x >= yp.doc_w || y >= yp.doc_h)
		return 0;
	if (merged)
		return yp.comp[y * yp.doc_w + x];

	return yp.layer[yp.cur].px[y * yp.doc_w + x];
}

Bool YPColorNear(U32 a, U32 b, I64 tol)
{//Largest per-channel difference, alpha included.
	I64 d, t;

	d = AbsI64((a >> 24 & 0xFF) - (b >> 24 & 0xFF));
	t = AbsI64((a >> 16 & 0xFF) - (b >> 16 & 0xFF));
	if (t > d)
		d = t;
	t = AbsI64((a >> 8 & 0xFF) - (b >> 8 & 0xFF));
	if (t > d)
		d = t;
	t = AbsI64((a & 0xFF) - (b & 0xFF));
	if (t > d)
		d = t;

	return d <= tol;
}

U0 YPFloodFill(I64 sx, I64 sy, U32 col, I64 tol, Bool merged, Bool erase)
{//Scanline flood over the sampled surface; coverage lands on the active layer.
	I64  w = yp.doc_w, h = yp.doc_h, n = w * h,
		 sp = 0, idx, x, y, x1, x2, i;
	U32  target;
	U8	*seen;
	I64 *stack;
	U32 *src;

	if (sx < 0 || sy < 0 || sx >= w || sy >= h)
		return;
	if (merged)
		src = yp.comp;
	else
		src = yp.layer[yp.cur].px;
	target = src[sy * w + sx];

	//A pixel can be queued once from the row above and once from the row below
	//before its span marks it seen, so the stack needs room for 2n.
	seen  = CAlloc(n);
	stack = MAlloc((2 * n + 16) * sizeof(I64));
	stack[sp++] = sy * w + sx;

	YPStrokeOpen(col, erase);

	while (sp)
	{
		idx = stack[--sp];
		y = idx / w;
		x = idx - y * w;
		if (seen[idx] || !YPColorNear(src[idx], target, tol))
			goto flood_next;

		x1 = x;
		while (x1 > 0 && !seen[y * w + x1 - 1] &&
			   YPColorNear(src[y * w + x1 - 1], target, tol))
			x1--;
		x2 = x;
		while (x2 < w - 1 && !seen[y * w + x2 + 1] &&
			   YPColorNear(src[y * w + x2 + 1], target, tol))
			x2++;

		for (i = x1; i <= x2; i++)
		{
			seen[y * w + i] = 1;
			YPAccCover(i, y, 255);
		}

		if (y > 0)
			for (i = x1; i <= x2; i++)
				if (!seen[(y - 1) * w + i] &&
					YPColorNear(src[(y - 1) * w + i], target, tol))
					stack[sp++] = (y - 1) * w + i;
		if (y < h - 1)
			for (i = x1; i <= x2; i++)
				if (!seen[(y + 1) * w + i] &&
					YPColorNear(src[(y + 1) * w + i], target, tol))
					stack[sp++] = (y + 1) * w + i;
flood_next:
		;
	}

	Free(seen);
	Free(stack);
	YPAccCommit;
	YPStrokeEnd("Fill");
}

U0 YPPathBegin(I64 x, I64 y)
{
	YPStampAt(x, y);
	yp.stroke_x = x;
	yp.stroke_y = y;
	yp.stroke_carry = 0.0;
}

U0 YPToolLine(I64 x0, I64 y0, I64 x1, I64 y1, U32 col, Bool erase)
{
	YPStrokeOpen(col, erase);
	YPPathBegin(x0, y0);
	YPStrokeTo(x1, y1);
	YPStrokeEnd("Line");
}

U0 YPToolRect(I64 x0, I64 y0, I64 x1, I64 y1, U32 col, Bool erase, Bool fill)
{
	I64 x, y, t;

	if (x0 > x1)
	{
		t = x0;
		x0 = x1;
		x1 = t;
	}
	if (y0 > y1)
	{
		t = y0;
		y0 = y1;
		y1 = t;
	}

	YPStrokeOpen(col, erase);
	if (fill)
	{
		for (y = y0; y <= y1; y++)
			for (x = x0; x <= x1; x++)
				YPAccCover(x, y, 255);
		YPAccCommit;
	}
	else
	{
		YPPathBegin(x0, y0);
		YPStrokeTo(x1, y0);
		YPStrokeTo(x1, y1);
		YPStrokeTo(x0, y1);
		YPStrokeTo(x0, y0);
	}
	YPStrokeEnd("Rect");
}

U0 YPToolEllipse(I64 x0, I64 y0, I64 x1, I64 y1, U32 col, Bool erase, Bool fill)
{
	F64 cx = (x0 + x1) / 2.0, cy = (y0 + y1) / 2.0,
		rx = Abs(x1 - x0) / 2.0, ry = Abs(y1 - y0) / 2.0,
		nx, ny, d, edge, cov, a, step;
	I64 x, y, bx0, by0, bx1, by1, steps, i;

	if (rx < 0.5)
		rx = 0.5;
	if (ry < 0.5)
		ry = 0.5;

	YPStrokeOpen(col, erase);

	if (fill)
	{
		bx0 = ToI64(cx - rx) - 1;
		by0 = ToI64(cy - ry) - 1;
		bx1 = ToI64(cx + rx) + 1;
		by1 = ToI64(cy + ry) + 1;
		//Edge width in normalized units, so the falloff is one screen pixel.
		if (rx < ry)
			edge = 1.0 / rx;
		else
			edge = 1.0 / ry;

		for (y = by0; y <= by1; y++)
			for (x = bx0; x <= bx1; x++)
			{
				nx = (x + 0.5 - cx) / rx;
				ny = (y + 0.5 - cy) / ry;
				d = Sqrt(nx * nx + ny * ny);
				cov = (1.0 - d) / edge + 0.5;
				if (cov > 1.0)
					cov = 1.0;
				if (!yp.anti_alias)
				{
					if (cov >= 0.5)
						cov = 1.0;
					else
						cov = 0.0;
				}
				if (cov > 0.0)
					YPAccCover(x, y, ToI64(cov * 255.0));
			}
		YPAccCommit;
	}
	else
	{
		if (rx > ry)
			steps = ToI64(rx * 8.0);
		else
			steps = ToI64(ry * 8.0);
		steps = ClampI64(steps, 24, 2048);
		step = 6.28318530718 / steps;
		YPPathBegin(ToI64(cx + rx), ToI64(cy));
		for (i = 1; i <= steps; i++)
		{
			a = i * step;
			YPStrokeTo(ToI64(cx + rx * Cos(a)), ToI64(cy + ry * Sin(a)));
		}
	}
	YPStrokeEnd("Ellipse");
}

U0 YPToolGradient(I64 x0, I64 y0, I64 x1, I64 y1, U32 c0, U32 c1, Bool radial)
{//Writes colour directly: the acc path carries a single colour only.
	I64 		x, y, idx, a, i, ch0[4], ch1[4], cc[4], op;
	F64 		dx = x1 - x0, dy = y1 - y0, len2, t, len;
	U32 		col;
	CYPLayer   *l = &yp.layer[yp.cur];

	len2 = dx * dx + dy * dy;
	if (len2 < 1.0)
		return;
	len = Sqrt(len2);
	op = ClampI64(yp.opacity, 0, 255);

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Gradient");

	ch0[0] = c0 >> 24 & 0xFF;
	ch0[1] = c0 >> 16 & 0xFF;
	ch0[2] = c0 >> 8  & 0xFF;
	ch0[3] = c0		  & 0xFF;
	ch1[0] = c1 >> 24 & 0xFF;
	ch1[1] = c1 >> 16 & 0xFF;
	ch1[2] = c1 >> 8  & 0xFF;
	ch1[3] = c1		  & 0xFF;

	for (y = 0; y < yp.doc_h; y++)
		for (x = 0; x < yp.doc_w; x++)
		{
			if (radial)
				t = Sqrt((x - x0) * (x - x0) + (y - y0) * (y - y0)) / len;
			else
				t = ((x - x0) * dx + (y - y0) * dy) / len2;
			if (t < 0.0)
				t = 0.0;
			if (t > 1.0)
				t = 1.0;

			for (i = 0; i < 4; i++)
				cc[i] = ch0[i] + ToI64((ch1[i] - ch0[i]) * t);
			col = (cc[0] << 24) | (cc[1] << 16) | (cc[2] << 8) | cc[3];

			idx = y * yp.doc_w + x;
			a = op;
			if (l->alpha_lock)
				a = op * (l->px[idx] >> 24 & 0xFF) / 255;
			if (yp.has_sel)
				a = a * yp.sel[idx] / 255;
			if (a)
				l->px[idx] = YPOver(l->px[idx], col, a);
		}

	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerOffset(I64 dx, I64 dy)
{//Shift the active layer; vacated pixels become transparent.
	I64  w = yp.doc_w, h = yp.doc_h, x, y, sx, sy;
	U32 *nb;

	if (!dx && !dy)
		return;
	nb = CAlloc(w * h * sizeof(U32));
	for (y = 0; y < h; y++)
	{
		sy = y - dy;
		if (0 <= sy < h)
			for (x = 0; x < w; x++)
			{
				sx = x - dx;
				if (0 <= sx < w)
					nb[y * w + x] = yp.layer[yp.cur].px[sy * w + sx];
			}
	}
	MemCopy(yp.layer[yp.cur].px, nb, w * h * sizeof(U32));
	Free(nb);
	YPDirtyAll;
	yp.modified = TRUE;
}

//Selection. The mask is doc-sized coverage; the outline is cached as merged
//axis-aligned document-space segments so the marching ants cost a few hundred
//draw calls a frame instead of one per boundary pixel.

#define YP_POLY_MAX 	4096
#define YP_SEG_MAX		8192

I64 yp_poly_x[YP_POLY_MAX];
I64 yp_poly_y[YP_POLY_MAX];
I64 yp_poly_n;

I32 yp_seg[YP_SEG_MAX][4];	//x0, y0, x1, y1 in document coords
I64 yp_seg_n;

U0 YPPolyReset()
{
	yp_poly_n = 0;
}

U0 YPPolyAdd(I64 x, I64 y)
{//Consecutive duplicates carry no shape and would only cost fill work.
	if (yp_poly_n >= YP_POLY_MAX)
		return;
	if (yp_poly_n && yp_poly_x[yp_poly_n - 1] == x &&
		yp_poly_y[yp_poly_n - 1] == y)
		return;
	yp_poly_x[yp_poly_n] = x;
	yp_poly_y[yp_poly_n] = y;
	yp_poly_n++;
}

U0 YPSelApply(I64 x, I64 y, I64 cov, I64 mode)
{
	I64 idx, v;

	if (x < 0 || y < 0 || x >= yp.doc_w || y >= yp.doc_h)
		return;
	idx = y * yp.doc_w + x;
	if (mode == YPSEL_SUB)
		v = yp.sel[idx] - cov;
	else if (mode == YPSEL_ADD)
		v = yp.sel[idx] + cov;
	else
		v = cov;
	yp.sel[idx] = ClampI64(v, 0, 255);
}

U0 YPSelBounds()
{//Recompute the bounding box and whether anything is selected at all.
	I64 x, y, w = yp.doc_w, row;

	yp.sx0 = I64_MAX;
	yp.sy0 = I64_MAX;
	yp.sx1 = I64_MIN;
	yp.sy1 = I64_MIN;

	for (y = 0; y < yp.doc_h; y++)
	{
		row = y * w;
		for (x = 0; x < w; x++)
			if (yp.sel[row + x])
			{
				if (x < yp.sx0)
					yp.sx0 = x;
				if (y < yp.sy0)
					yp.sy0 = y;
				if (x + 1 > yp.sx1)
					yp.sx1 = x + 1;
				if (y + 1 > yp.sy1)
					yp.sy1 = y + 1;
			}
	}

	yp.has_sel = yp.sx0 < yp.sx1 && yp.sy0 < yp.sy1;
	if (!yp.has_sel)
	{
		yp.sx0 = 0;
		yp.sy0 = 0;
		yp.sx1 = 0;
		yp.sy1 = 0;
	}
	yp.sel_dirty = TRUE;
}

Bool YPSelIn(I64 x, I64 y)
{
	if (x < 0 || y < 0 || x >= yp.doc_w || y >= yp.doc_h)
		return FALSE;

	return yp.sel[y * yp.doc_w + x] >= 128;
}

U0 YPSegAdd(I64 x0, I64 y0, I64 x1, I64 y1)
{
	if (yp_seg_n >= YP_SEG_MAX)
		return;
	yp_seg[yp_seg_n][0] = x0;
	yp_seg[yp_seg_n][1] = y0;
	yp_seg[yp_seg_n][2] = x1;
	yp_seg[yp_seg_n][3] = y1;
	yp_seg_n++;
}

U0 YPSelOutline()
{//Merge runs of boundary edges into whole segments. A rectangular selection
//comes out as four.
	I64 x, y, w = yp.doc_w, h = yp.doc_h, run;

	yp_seg_n = 0;
	if (!yp.has_sel)
	{
		yp.sel_dirty = FALSE;
		return;
	}

	//Horizontal edges live on row boundaries, between (x, y-1) and (x, y).
	for (y = 0; y <= h; y++)
	{
		x = 0;
		while (x < w)
		{
			if (YPSelIn(x, y) != YPSelIn(x, y - 1))
			{
				run = x;
				while (x < w && YPSelIn(x, y) != YPSelIn(x, y - 1))
					x++;
				YPSegAdd(run, y, x, y);
			}
			else
				x++;
		}
	}

	//Vertical edges on column boundaries, between (x-1, y) and (x, y).
	for (x = 0; x <= w; x++)
	{
		y = 0;
		while (y < h)
		{
			if (YPSelIn(x, y) != YPSelIn(x - 1, y))
			{
				run = y;
				while (y < h && YPSelIn(x, y) != YPSelIn(x - 1, y))
					y++;
				YPSegAdd(x, run, x, y);
			}
			else
				y++;
		}
	}

	yp.sel_dirty = FALSE;
}

U0 YPSelNone()
{
	MemSet(yp.sel, 0, yp.doc_w * yp.doc_h);
	yp.has_sel = FALSE;
	yp.sx0 = 0;
	yp.sy0 = 0;
	yp.sx1 = 0;
	yp.sy1 = 0;
	yp.sel_dirty = TRUE;
}

U0 YPSelAll()
{
	MemSet(yp.sel, 255, yp.doc_w * yp.doc_h);
	yp.has_sel = TRUE;
	yp.sx0 = 0;
	yp.sy0 = 0;
	yp.sx1 = yp.doc_w;
	yp.sy1 = yp.doc_h;
	yp.sel_dirty = TRUE;
}

U0 YPSelInvert()
{
	I64 i, n = yp.doc_w * yp.doc_h;

	for (i = 0; i < n; i++)
		yp.sel[i] = 255 - yp.sel[i];
	YPSelBounds;
}

U0 YPSelRect(I64 x0, I64 y0, I64 x1, I64 y1, I64 mode)
{
	I64 x, y, t;

	if (x0 > x1)
	{
		t = x0;
		x0 = x1;
		x1 = t;
	}
	if (y0 > y1)
	{
		t = y0;
		y0 = y1;
		y1 = t;
	}
	if (mode == YPSEL_REPLACE)
		MemSet(yp.sel, 0, yp.doc_w * yp.doc_h);

	for (y = y0; y <= y1; y++)
		for (x = x0; x <= x1; x++)
			YPSelApply(x, y, 255, mode);
	YPSelBounds;
}

U0 YPSelPoly(I64 mode)
{//Even-odd scanline fill of the collected point list, sampled at pixel
//centres so a thin sliver does not vanish.
	I64  i, j, y, x, n = yp_poly_n, xs[64], xn, t,
		 y0 = I64_MAX, y1 = I64_MIN;
	F64  fy, xi;

	if (n < 3)
		return;
	if (mode == YPSEL_REPLACE)
		MemSet(yp.sel, 0, yp.doc_w * yp.doc_h);

	for (i = 0; i < n; i++)
	{
		if (yp_poly_y[i] < y0)
			y0 = yp_poly_y[i];
		if (yp_poly_y[i] > y1)
			y1 = yp_poly_y[i];
	}
	y0 = ClampI64(y0, 0, yp.doc_h - 1);
	y1 = ClampI64(y1, 0, yp.doc_h - 1);

	for (y = y0; y <= y1; y++)
	{
		fy = y + 0.5;
		xn = 0;
		for (i = 0; i < n; i++)
		{
			j = i + 1;
			if (j == n)
				j = 0;
			//Half-open in y so a vertex shared by two edges counts once.
			if ((yp_poly_y[i] <= fy) != (yp_poly_y[j] <= fy))
			{
				xi = yp_poly_x[i] + (fy - yp_poly_y[i]) *
					 (yp_poly_x[j] - yp_poly_x[i]) /
					 (yp_poly_y[j] - yp_poly_y[i]);
				if (xn < 64)
					xs[xn++] = ToI64(xi);
			}
		}
		//Insertion sort: crossing counts are tiny and usually already ordered.
		for (i = 1; i < xn; i++)
		{
			t = xs[i];
			j = i - 1;
			while (j >= 0 && xs[j] > t)
			{
				xs[j + 1] = xs[j];
				j--;
			}
			xs[j + 1] = t;
		}
		for (i = 0; i + 1 < xn; i += 2)
			for (x = xs[i]; x <= xs[i + 1]; x++)
				YPSelApply(x, y, 255, mode);
	}

	YPSelBounds;
}

I64 YPSelAt(I64 x, I64 y)
{//Selection coverage at a document pixel; 255 everywhere when none is active.
	if (!yp.has_sel)
		return 255;
	if (x < 0 || y < 0 || x >= yp.doc_w || y >= yp.doc_h)
		return 0;

	return yp.sel[y * yp.doc_w + x];
}

U0 YPBoxPass(U32 *src, U32 *dst, I64 r, Bool horiz)
{//One box pass over premultiplied 0xAARRGGBB. Edge samples are clamped, so the
//window count stays 2r+1 everywhere and no divide-by-count is needed per pixel.
	I64  w = yp.doc_w, h = yp.doc_h, lines, len, stride, li, i, o,
		 sa, sr, sg, sb, cnt = 2 * r + 1, add, sub;
	U32  c;

	if (horiz)
	{
		lines = h;
		len = w;
		stride = 1;
	}
	else
	{
		lines = w;
		len = h;
		stride = w;
	}

	for (li = 0; li < lines; li++)
	{
		if (horiz)
			o = li * w;
		else
			o = li;

		sa = 0;
		sr = 0;
		sg = 0;
		sb = 0;
		for (i = -r; i <= r; i++)
		{
			c = src[o + ClampI64(i, 0, len - 1) * stride];
			sa += c >> 24 & 0xFF;
			sr += c >> 16 & 0xFF;
			sg += c >> 8  & 0xFF;
			sb += c 	  & 0xFF;
		}

		for (i = 0; i < len; i++)
		{
			dst[o + i * stride] = ((sa / cnt) << 24) | ((sr / cnt) << 16) |
								  ((sg / cnt) << 8) | (sb / cnt);
			sub = ClampI64(i - r, 0, len - 1);
			add = ClampI64(i + r + 1, 0, len - 1);
			c = src[o + sub * stride];
			sa -= c >> 24 & 0xFF;
			sr -= c >> 16 & 0xFF;
			sg -= c >> 8  & 0xFF;
			sb -= c 	  & 0xFF;
			c = src[o + add * stride];
			sa += c >> 24 & 0xFF;
			sr += c >> 16 & 0xFF;
			sg += c >> 8  & 0xFF;
			sb += c 	  & 0xFF;
		}
	}
}

U0 YPLayerBlur(I64 radius)
{//Three box passes approximate a gaussian. Blurring runs on premultiplied
//colour, otherwise the transparent pixels' colour bleeds into the edge and
//soft borders darken.
	I64  n = yp.doc_w * yp.doc_h, i, a, pass;
	U32 *a1, *a2, c, out;
	CYPLayer *l = &yp.layer[yp.cur];

	radius = ClampI64(radius, 1, 200);
	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Blur");

	a1 = MAlloc(n * sizeof(U32));
	a2 = MAlloc(n * sizeof(U32));

	for (i = 0; i < n; i++)
	{
		c = l->px[i];
		a = c >> 24 & 0xFF;
		a1[i] = (a << 24) | (((c >> 16 & 0xFF) * a / 255) << 16) |
				(((c >> 8 & 0xFF) * a / 255) << 8) | ((c & 0xFF) * a / 255);
	}

	for (pass = 0; pass < 3; pass++)
	{
		YPBoxPass(a1, a2, radius, TRUE);
		YPBoxPass(a2, a1, radius, FALSE);
	}

	for (i = 0; i < n; i++)
	{
		c = a1[i];
		a = c >> 24 & 0xFF;
		if (!a)
			out = 0;
		else
			out = (a << 24) |
				(ClampI64((c >> 16 & 0xFF) * 255 / a, 0, 255) << 16) |
				(ClampI64((c >> 8  & 0xFF) * 255 / a, 0, 255) << 8) |
				 ClampI64((c 	   & 0xFF) * 255 / a, 0, 255);
		l->px[i] = YPMix(l->px[i], out, YPSelCov(i));
	}

	Free(a1);
	Free(a2);
	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerAdjustHSV(I64 dh, I64 ds, I64 dv)
{//dh in degrees, ds and dv in percent of the existing value.
	I64  n = yp.doc_w * yp.doc_h, i, a;
	F64  hh, ss, vv;
	U32  c;
	CYPLayer *l = &yp.layer[yp.cur];

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Hue/Sat");

	for (i = 0; i < n; i++)
	{
		c = l->px[i];
		a = c >> 24 & 0xFF;
		if (a && YPSelCov(i))
		{
			YPRGB2HSV(c, &hh, &ss, &vv);
			hh += dh;
			ss *= (100 + ds) / 100.0;
			vv *= (100 + dv) / 100.0;
			l->px[i] = (a << 24) |
					   (YPMix(c, YPHSV2RGB(hh, ss, vv), YPSelCov(i)) &
						0x00FFFFFF);
		}
	}

	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerInvert()
{
	I64  n = yp.doc_w * yp.doc_h, i;
	U32  c;
	CYPLayer *l = &yp.layer[yp.cur];

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Invert");
	for (i = 0; i < n; i++)
	{
		c = l->px[i];
		l->px[i] = YPMix(c, (c & 0xFF000000) | (~c & 0x00FFFFFF), YPSelCov(i));
	}
	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerDesaturate()
{//Rec.601 luma.
	I64  n = yp.doc_w * yp.doc_h, i, g;
	U32  c;
	CYPLayer *l = &yp.layer[yp.cur];

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Desaturate");
	for (i = 0; i < n; i++)
	{
		c = l->px[i];
		g = (299 * (c >> 16 & 0xFF) + 587 * (c >> 8 & 0xFF) +
			 114 * (c & 0xFF)) / 1000;
		l->px[i] = YPMix(c, (c & 0xFF000000) | (g << 16) | (g << 8) | g,
						 YPSelCov(i));
	}
	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerClear()
{
	I64 i, n = yp.doc_w * yp.doc_h, a;

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Clear");
	if (!yp.has_sel)
		MemSetU32(yp.layer[yp.cur].px, 0, n);
	else
		for (i = 0; i < n; i++)
		{
			//Partial coverage erases proportionally rather than all or nothing.
			a = yp.layer[yp.cur].px[i] >> 24 & 0xFF;
			a = a * (255 - yp.sel[i]) / 255;
			yp.layer[yp.cur].px[i] = (a << 24) |
									 (yp.layer[yp.cur].px[i] & 0x00FFFFFF);
		}
	YPDirtyAll;
	yp.modified = TRUE;
}

U0 YPLayerFillAll(U32 col)
{
	I64 		i, n = yp.doc_w * yp.doc_h, a;
	CYPLayer   *l = &yp.layer[yp.cur];

	YPUndoPushPix(yp.cur, 0, 0, yp.doc_w, yp.doc_h, "Fill");
	if (!yp.has_sel)
		YPLayerFillRect(l, 0, 0, yp.doc_w, yp.doc_h, col);
	else
		for (i = 0; i < n; i++)
		{
			a = yp.sel[i];
			if (l->alpha_lock)
				a = a * (l->px[i] >> 24 & 0xFF) / 255;
			if (a)
				l->px[i] = YPOver(l->px[i], col, a);
		}
	YPDirtyAll;
	yp.modified = TRUE;
}
