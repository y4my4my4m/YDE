//Reads .MOD (ProTracker 4/6/8/n channel, 31- and 15-sample variants), its own
//YTK3 songs and yTracker 1 YTK2 files. Samples import from 8- or 16-bit PCM
//WAV. Timing, effects and period handling follow the Amiga model; see TrMix.

public U0 yTracker()
{
	I64 msg, a1, a2, cols, rows, left, top;
	I64 ord, pat, row;

	TrDataInit;
	MemSet(&tr, 0, sizeof(CTrGlobals));
	tr.master		= 128;
	tr.interp		= TRUE;
	tr.octave		= 4;
	tr.inst			= TRI_PULSE1;
	tr.vol_default	= 48;
	tr.step_add		= 1;
	tr.edit			= TRUE;
	tr.follow		= TRUE;
	tr.mix_idle		= TRUE;
	tr.scope_mode	= TR_SCOPE_SPLIT;
	tr.preview_ch	= -1;	//Zero is a real channel; nothing is auditioning.
	tr.roll_snap	= 1;
	tr.roll_ghosts	= TRUE;
	tr.roll_edit	= FALSE;
	tr.sel_r0		= -1;
	//File-scope arrays are garbage until something fills them.
	MemSet(tr_undo, 0, sizeof(tr_undo));
	tr.undo_n		= 0;
	tr.clip_rows	= 0;
	tr.win_task		= Fs;
	StrCopy(tr.file, "~/TrackerSong.DAT");
//"~" resolves through blkdev.home_dir; "::" is the boot drive and always
//resolves.
	StrCopy(tr.dir_song, "::/Home/");
	StrCopy(tr.dir_smp, "::/Home/");
	TrConfigLoad;
	tr.stream = AudioAvailableOutputStreamGet();
	if (tr.stream < 0)
		tr.stream = 0;

	TrSongNew(4, 8, 64);
	TrStatus("F1 help  F10 load song or .MOD  F11 load .WAV into slot %02X",
			 tr.inst);

	SettingsPush;
	StrCopy(Fs->task_title, "yTracker");
	cols = MinI64(TEXT_COLS - 2, 132);
	rows = MinI64(TEXT_ROWS - 2, 74);
	left = (TEXT_COLS - cols) / 2;
	top  = (TEXT_ROWS - rows) / 2;
	Fs->win_width = cols;
	WinHorz(left, left + cols);
	Fs->win_height = rows;
	WinVert(top, top + rows - 1);
	WinFocus;
	DocCursor(OFF);
	DocClear;
	Fs->win_inhibit |= WIF_FOCUS_TASK_MS_L_D | WIF_FOCUS_TASK_MS_R_D;
	Fs->draw_it = &TrDrawIt;
	TrMenuPush;

	tr.play_task = Spawn(&TrPlayTask, , "yTracker Mixer", 1);

	while (!tr.quit)
	{
		while (msg = MessageScan(&a1, &a2))
			switch (msg)
			{
				case MESSAGE_MS_L_DOWN:
					TrClick(a1, a2);
					break;
				case MESSAGE_MS_R_DOWN:
					TrRightClick(a1, a2);
					break;
				case MESSAGE_KEY_DOWN:
					tr.pane = TR_PANE_NONE;
					if (a1)
						TrKeyChar(a1, a2);
					else
						TrKeyScan(a2.u8[0], a2);
					break;
				case MESSAGE_CMD:
					TrMenuCmd(a1);
					break;
			}
		TrWheelPoll;
		TrMenuSync;
		if (tr.playing && tr.follow && TrMarkNow(&ord, &pat, &row))
		{
			tr.cur_pat		= pat;
			tr.order_sel	= ord;
			tr.cur_row		= ClampI64(row, 0, TrCurRows() - 1);
		}
		Sleep(20);
	}

	//The mixer task and the pane windows read song data: they go before the
	//heap objects do.
	TrPaneWinCloseAll;
	TrUndoFreeAll;
	tr.playing = FALSE;
	Sleep(40);
	if (TaskValidate(tr.play_task))
		Kill(tr.play_task);
	FifoI64Flush(audio.output[tr.stream].data);
	Fs->draw_it = NULL;
	MenuPop;
	TrSongFreeAll;
	DocCursor(ON);
	DocClear;
	SettingsPop;
	"yTracker closed.\n";
}
