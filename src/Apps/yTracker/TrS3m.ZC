//Little-endian throughout.
//
//Layout:
//    0x00   28  title
//    0x1C    1  0x1A
//    0x1D    1  type, 0x10 = ST3 module
//    0x20    2  order count
//    0x22    2  instrument count
//    0x24    2  pattern count
//    0x26    2  flags
//    0x28    2  created-with tracker version
//    0x2A    2  file format version, 1 = signed PCM, 2 = unsigned
//    0x2C    4  "SCRM"
//    0x30    1  global volume, 0..64
//    0x31    1  initial speed
//    0x32    1  initial tempo
//    0x33    1  master volume, low 7 bits mixing volume, bit 7 stereo
//    0x34    1  ultra-click removal
//    0x35    1  default panning flag, 252 = pan table present
//    0x36    8  reserved
//    0x3E    2  special parapointer
//    0x40   32  channel settings, 0xFF = slot unused
//    0x60      order list, ord_num bytes
//              instrument parapointers, ins_num words
//              pattern parapointers, pat_num words
//              pan table, 32 bytes, only when byte 0x35 is 252
//
//A parapointer is a 16-bit paragraph number: file offset = value * 16. Value 0
//means absent - an empty pattern or an unused instrument slot.
//
//Instrument header, 80 bytes:
//    0x00    1  type, 1 = PCM, 2+ = Adlib
//    0x01   12  DOS filename
//    0x0D    1  sample pointer, high byte
//    0x0E    1  sample pointer, low byte
//    0x0F    1  sample pointer, mid byte
//    0x10    4  length in frames
//    0x14    4  loop begin
//    0x18    4  loop end, exclusive
//    0x1C    1  volume 0..64
//    0x1E    1  pack, 0 = raw PCM, 4 = ModPlug ADPCM
//    0x1F    1  flags, bit0 loop, bit1 stereo, bit2 16-bit
//    0x20    4  C2SPD, the Hz of C-4 despite the name
//    0x30   28  name
//    0x4C    4  "SCRS", Adlib uses "SCRI"
//
//S3M has no instrument layer: instrument N is sample N, so tr_inst[] stays
//NULL and TrInstSample maps identity.
//
//Pitch is always Amiga-style. Every S3M period is normalised so C-4 is
//8363 Hz, hence TR_CLOCK_8363 rather than the real PAL rate MOD uses.

#define TRS3M_HDR		0x60
#define TRS3M_INS_HDR	80

I64 TrS3mProbe(U8 *raw, I64 size)
{//Channel count, or 0 if this is not an S3M. The count is the highest used
//slot plus one; the settings array is never compacted because pattern data
//indexes by slot.
	I64 i, ch = 0;

	if (size < TRS3M_HDR)
		return 0;
	if (MemCompare(raw + 0x2C, "SCRM", 4))
		return 0;
	if (raw[0x1D] != 0x10)
		return 0;
	for (i = 0; i < 32; i++)
		if (raw[0x40 + i] != 0xFF)
			ch = i + 1;
	if (ch < 1 || ch > TR_MAX_CHANNELS)
		return 0;

	return ch;
}

I64 TrS3mNote(I64 b)
{//Octave in the high nibble, semitone in the low: engine note = oct*12+sem+1,
//note 1 = C-0. 0xFF empty, 0xFE hard cut.
	I64 sem, n;

	if (b == 0xFF)
		return 0;
	if (b == 0xFE)
		return TR_NOTE_CUT;
	sem = b & 0x0F;
	if (sem > 11)
		return 0;
	n = (b / 16) * 12 + sem + 1;
	if (n < 1 || n > TR_NOTES)
		return 0;

	return n;
}

I64 TrS3mEffect(I64 cmd, I64 *_param)
{//Command byte 1..26 = A..Z, translated into the engine's TRX_* space.
//Unrecognised commands store no effect rather than a wrong one.
	I64 row, pan;

	switch (cmd)
	{
		case 1:		return TRX_SET_SPEED;			//A
		case 2:		return TRX_POS_JUMP;			//B
		case 3:									//C
			//S3M stores the break row as a plain byte. The engine's
			//TRX_PAT_BREAK handler decodes MOD-style BCD, so re-encode.
			row = ClampI64(*_param, 0, 63);
			*_param = (row / 10) * 16 + row % 10;
			return TRX_PAT_BREAK;
		case 4:		return TRX_VOLSLIDE;			//D
		case 5:		return TRX_PORTA_DOWN;			//E
		case 6:		return TRX_PORTA_UP;			//F
		case 7:		return TRX_TONE_PORTA;			//G
		case 8:		return TRX_VIBRATO;				//H
		case 9:		return TRX_TREMOR;				//I
		case 10:	return TRX_ARPEGGIO;			//J
		case 11:	return TRX_VIB_VOLSLIDE;		//K
		case 12:	return TRX_PORTA_VOLSLIDE;		//L
		case 13:	return TRX_CHANNEL_VOL;			//M
		case 14:	return TRX_CHANNEL_VOLSLIDE;	//N
		case 15:	return TRX_OFFSET;				//O
		case 16:	return TRX_PAN_SLIDE;			//P
		case 17:	return TRX_MULTI_RETRIG;		//Q
		case 18:	return TRX_TREMOLO;				//R
		case 19:
			//S. The parameter passes through: the engine's extended handler
			//reads the high nibble as the subcommand, matching S3M's Sxy.
			return TRX_EXTENDED;
		case 20:	return TRX_SET_TEMPO;			//T
		case 21:	return TRX_FINE_VIBRATO;		//U
		case 22:	return TRX_GLOBAL_VOL;			//V
		case 23:	return TRX_GLOBAL_VOLSLIDE;		//W
		case 24:								//X
			//S3M pans 0x00..0x80; TRX_SET_PAN takes 0..255. 0xA4 is surround,
			//unsupported here and played centred.
			pan = *_param & 0xFF;
			if (pan == 0xA4)
				pan = 128;
			else if (pan >= 0x80)
				pan = 255;
			else
				pan = pan * 2;
			*_param = pan;
			return TRX_SET_PAN;
		case 25:	return TRX_PANBRELLO;			//Y
	}
	//Z is a MIDI macro, and 0 is no effect at all.
	*_param = 0;

	return 0;
}

Bool TrS3mLoad(U8 *raw, I64 size)
{//Replaces the whole song. Returns FALSE without touching state on reject.
	I64	 ch, i, j, p, row, q, limit, what, cn;
	I64	 ord_num, ins_num, pat_num, ffv, dp_flag;
	I64	 n_ins, n_pat, olen, v, gv, mv, speed, bpm;
	I64	 ins_base, pat_base, pan_base, pp, off, doff;
	I64	 type, pack, flags, len, lb, le, ll, c2spd, vol, bps;
	I64	 note, ins, volb, cmd, info, eff, param, avail, pan;
	U8	*sh;
	I16	*d;
	CTrCell	*cell;

	ch = TrS3mProbe(raw, size);
	if (ch < 1)
		return FALSE;

	ord_num	= TrRdU16LE(raw + 0x20);
	ins_num	= TrRdU16LE(raw + 0x22);
	pat_num	= TrRdU16LE(raw + 0x24);
	ffv		= TrRdU16LE(raw + 0x2A);
	gv		= raw[0x30];
	speed	= raw[0x31];
	bpm		= raw[0x32];
	mv		= raw[0x33] & 0x7F;
	dp_flag	= raw[0x35];

	//Array bases follow the declared counts, not the clamped ones, or every
	//later array is misaligned. Each element is bounds-checked at read.
	ins_base = TRS3M_HDR + ord_num;
	pat_base = ins_base + ins_num * 2;
	pan_base = pat_base + pat_num * 2;

	n_ins = ClampI64(ins_num, 0, TR_MAX_SAMPLES - 1);
	n_pat = ClampI64(pat_num, 0, TR_MAX_PATTERNS);

	TrSongFreeAll;
	MemSet(&tr_song, 0, sizeof(CTrSong));
	tr_song.channels		= ch;
	tr_song.n_patterns		= n_pat;
	tr_song.n_instruments	= n_ins;
	tr_song.linear			= FALSE;
	tr_song.fine_slides = TRUE;	//Dxy carries DFx / DxF fine forms.
	tr_song.clock			= TR_CLOCK_8363;
	tr_song.restart			= 0;
	tr_song.global_vol		= ClampI64(gv * 2, 0, 128);
	//Header mixing volume is 0..127, default 48. Doubled into the engine's
	//0..128 range.
	tr_song.mix_vol			= ClampI64(mv * 2, 16, 128);
	if (speed < 1)
		speed = 6;
	if (bpm < 32)
		bpm = 125;
	tr_song.speed	= speed;
	tr_song.bpm		= bpm;

	//Title: 28 bytes, NUL padded. Control bytes become spaces.
	for (i = 0; i < 28; i++)
	{
		v = raw[i];
		if (!v)
			break;
		if (v < 32)
			v = 32;
		tr_song.title[i] = v;
	}
	tr_song.title[i] = 0;

	//Order list. 0xFE is a skip marker, 0xFF ends the song; both are compacted
	//out so the engine never sees them.
	olen = 0;
	for (i = 0; i < ord_num; i++)
	{
		if (TRS3M_HDR + i >= size)
			break;
		v = raw[TRS3M_HDR + i];
		if (v == 0xFF)
			break;
		if (v != 0xFE && olen < TR_ORDER_MAX)
		{
			tr_song.order[olen] = v;
			olen++;
		}
	}
	tr_song.order_len = olen;

	//Instruments. Slot numbering is 1-based and matches the file.
	for (i = 1; i <= n_ins; i++)
	{
		pp	= 0;
		off	= 0;
		if (ins_base + (i - 1) * 2 + 2 <= size)
			pp = TrRdU16LE(raw + ins_base + (i - 1) * 2);
		off = pp * 16;
		if (pp && off + TRS3M_INS_HDR <= size)
		{
			sh		= raw + off;
			type	= sh[0];
			pack	= sh[0x1E];
			flags	= sh[0x1F];
			len		= TrRdU32LE(sh + 0x10);
			lb		= TrRdU32LE(sh + 0x14);
			le		= TrRdU32LE(sh + 0x18);
			vol		= ClampI64(sh[0x1C], 0, 64);
			c2spd	= ClampI64(TrRdU32LE(sh + 0x20), 1, 999999);

			//Sample pointer: high byte at 0x0D, low at 0x0E, mid at 0x0F.
			//offset = (b[1] << 4) | (b[2] << 12) | (b[0] << 20).
			doff = sh[0x0D] * 0x100000 + sh[0x0E] * 0x10 + sh[0x0F] * 0x1000;

			bps = 1;
			if (flags & 4)
				bps = 2;

			//Adlib instruments carry no PCM. ADPCM packing is not decoded;
			//the slot stays silent rather than playing the compressed bytes.
			if (type != 1 || pack)
				len = 0;
			//Truncated PCM degrades to a shorter sample. Stereo stores the whole
			//left channel then the whole right; this loader takes the left.
			if (doff < 1 || doff >= size)
				len = 0;
			else
			{
				avail = (size - doff) / bps;
				if (len > avail)
					len = avail;
			}

			if (len >= 1 && TrSampleAlloc(i, len))
			{
				d = tr_smp[i].data;
				for (j = 0; j < len; j++)
				{
					if (bps == 2)
					{//16-bit little-endian.
						v = TrRdU16LE(raw + doff + j * 2);
						if (ffv == 1)
						{
							if (v > 32767)
								v -= 65536;
						}
						else
							v -= 32768;	//ffv 2: unsigned, silence at 0x8000.
					}
					else
					{
						v = raw[doff + j];
						if (ffv == 1)
						{
							if (v > 127)
								v -= 256;
						}
						else
							v -= 128;	//ffv 2: unsigned, silence at 0x80.
						//Multiply, not shift: v is signed here.
						v = v * 256;
					}
					d[j] = v;
				}
				//loop_end is exclusive.
				if ((flags & 1) && le > lb && lb < len)
				{
					ll = le - lb;
					if (lb + ll > len)
						ll = len - lb;
					if (ll > 1)
					{
						tr_smp[i].loop_start	= lb;
						tr_smp[i].loop_len		= ll;
						tr_smp[i].loop_type		= TR_LOOP_FWD;
					}
				}
			}
			//TrSampleAlloc clears the slot, so the header fields land after it.
			tr_smp[i].volume	= vol;
			tr_smp[i].pan		= 128;
			tr_smp[i].finetune	= 0;	//S3M tunes by C2SPD alone.
			tr_smp[i].rel_note	= 0;
			tr_smp[i].c5speed	= c2spd;
			//C2SPD is the rate of C-4; TrC5StepMul takes a C-5 rate.
			tr_smp[i].step_mul	= TrC5StepMul(c2spd * 2);
			for (j = 0; j < TR_SMP_NAME - 1 && sh[0x30 + j]; j++)
				tr_smp[i].name[j] = sh[0x30 + j];
			tr_smp[i].name[j] = 0;
			if (tr_smp[i].data)
				TrSampleGuard(&tr_smp[i]);
		}
	}

	//Patterns. Always 64 rows; the packed length word is unreliable in real
	//files, so decoding runs until 64 end-of-row markers and uses the length
	//only to bound the read against the end of the buffer.
	for (p = 0; p < n_pat; p++)
	{
		if (!TrPatternAlloc(p, 64))
		{//Out of memory. Keep the patterns that landed.
			n_pat = p;
			break;
		}
		pp = 0;
		if (pat_base + p * 2 + 2 <= size)
			pp = TrRdU16LE(raw + pat_base + p * 2);
		off = pp * 16;
		if (pp && off + 2 <= size)
		{
			limit = off + 2 + TrRdU16LE(raw + off);
			if (limit > size)
				limit = size;
			q	= off + 2;
			row	= 0;
			while (row < 64 && q < limit)
			{
				what = raw[q];
				q++;
				if (!what)
					row++;
				else
				{
					cn		= what & 0x1F;
					note	= 0xFF;
					ins		= 0;
					volb	= 0xFF;
					cmd		= 0;
					info	= 0;
					//Fields always advance q, even past the bound, so a
					//truncated pattern stops rather than desynchronising.
					if (what & 0x20)
					{
						if (q + 2 <= limit)
						{
							note	= raw[q];
							ins		= raw[q + 1];
						}
						q += 2;
					}
					if (what & 0x40)
					{
						if (q < limit)
							volb = raw[q];
						q++;
					}
					if (what & 0x80)
					{
						if (q + 2 <= limit)
						{
							cmd		= raw[q];
							info	= raw[q + 1];
						}
						q += 2;
					}
					//Channels beyond the count are parsed to keep the byte
					//stream aligned, then discarded: TrCell returns NULL.
					cell = TrCell(p, cn, row);
					if (cell)
					{
						cell->note	= TrS3mNote(note);
						cell->inst	= ins;
						param		= info;
						eff			= TrS3mEffect(cmd, &param);
						cell->eff	= eff;
						cell->param	= param;
						cell->volcmd	= TRV_NONE;
						cell->volparam	= 0;
						if (volb <= 64)
						{
							cell->volcmd	= TRV_SET;
							cell->volparam	= volb;
						}
						else if (volb < 128)
						{//Out of range; ST3 clamps to full.
							cell->volcmd	= TRV_SET;
							cell->volparam	= 64;
						}
						else if (volb <= 192)
						{//ModPlug panning extension, 128..192 = pan 0..64.
							cell->volcmd	= TRV_SET_PAN;
							cell->volparam	= volb - 128;
						}
					}
				}
			}
		}
	}
	tr_song.n_patterns = n_pat;

	TrMasterDefault;
	//Stereo pan is 56 left / 200 right on a 0..255 scale, not hard panned.
	//Adlib slots stay centred and ignore the pan table. Master volume bit 7
	//marks the file mono; ignored.
	TrChanPanDefault(TRUE);
	for (i = 0; i < ch; i++)
	{
		v = raw[0x40 + i];
		if (v != 0xFF)
		{
			type = v & 0x7F;
			if (type < 8)
				pan = 56;
			else if (type < 16)
				pan = 200;
			else
				pan = 128;
			if (dp_flag == 252 && type < 16 && pan_base + i + 1 <= size)
			{
				v = raw[pan_base + i];
				//Bit 5 marks the low nibble as a valid pan 0..15.
				if (v & 0x20)
					pan = ((v & 0x0F) * 256 + 8) / 15;
			}
			tr_chan_pan[i] = ClampI64(pan, 0, 255);
		}
	}
	TrChansInit;

	return TRUE;
}
