//TrUI.ZC - editor drawing and input. Depends on TrDef, TrSmp, TrMix, TrMod,
//TrFile.

#define TR_CELL_W	108		//13 glyphs plus a gap.
#define TR_CELL_H	12
#define TR_GRID_X	40
//The grid starts where the scope and the channel headers end. The seek bar
//used to sit between them; it now pins to the bottom of the window, so the
//grid reclaims that space.
#define TR_GRID_Y	138
//Pane geometry. Every dimension is a multiple of the 8x8 text cell, because a
//window is sized in cells: a pane 470 wide asks for 59 cells, gets 472 pixels,
//and leaves a 2-pixel strip down the right that the pane never draws.
#define TR_PANE_H		336
#define TR_PANE_W_HELP	472
#define TR_PANE_W_INST	424
#define TR_PANE_W_ORDER	304
#define TR_ED_W			472
#define TR_ED_H			336

//Panes live in their own windows, at the end of this file; the menu and the
//function keys reach them from here.
extern U0 TrPaneWinToggle(I64 kind);

#define TR_SCOPE_Y	46
#define TR_SCOPE_H	64
#define TR_SEEK_H	10
#define TR_SEEK_PAD	4		//Gap between the seek bar and the window edge.
//Header button that swaps the pattern grid for the piano roll. Sits just left
//of the right-aligned status flags, clear of the song title.
#define TR_VIEWBTN_W	56

//Glyph offset and width of each cursor sub-column inside a cell.
I64 tr_col_x[TR_COLS] = {0, 4, 5, 7, 8, 10, 11, 12};
I64 tr_col_w[TR_COLS] = {3, 1, 1, 1, 1, 1, 1, 1};

I64 tr_view_rows = 32;
I64 tr_view_chs	 = 4;
//Window width the last draw used. Click handling runs on the app task and has
//no CTask to ask, and tr.win_task is not guaranteed set.
I64 tr_view_w	 = 1024;
I64 tr_view_h	 = 768;

I64 TrSeekY()
{//Pinned to the bottom of the window rather than to a fixed offset.
	return tr_view_h - TR_SEEK_H - TR_SEEK_PAD;
}

I64 TrViewBtnX()
{//The status flags start at w - 260; this sits to their left. A fixed offset
//would land on the song title, which runs from x 96.
	return tr_view_w - 260 - 72;
}

//Header toggles. They already read as buttons, so they behave as ones: each
//is drawn whether it is on or off, lit when on and dim when off, and takes a
//click. Drawing them only when set made them unreachable by mouse - there was
//nothing to click to turn one back on.
#define TR_FLAG_EDIT	0
#define TR_FLAG_FOLLOW	1
#define TR_FLAG_INTERP	2
#define TR_FLAG_COUNT	3

I64 tr_flag_x[TR_FLAG_COUNT] = {0, 144, 204};
I64 tr_flag_w[TR_FLAG_COUNT] = {40, 56, 56};

I64 TrFlagAt(I64 mx, I64 my)
{//Which header toggle the pointer is on, -1 for none.
	I64 i, x0 = tr_view_w - 260;

	if (my >= 18)
		return -1;
	for (i = 0; i < TR_FLAG_COUNT; i++)
		if (x0 + tr_flag_x[i] - 3 <= mx <
			x0 + tr_flag_x[i] + tr_flag_w[i])
			return i;

	return -1;
}

U0 TrFlagToggle(I64 i)
{
	switch (i)
	{
		case TR_FLAG_EDIT:		tr.edit		= !tr.edit;		break;
		case TR_FLAG_FOLLOW:	tr.follow	= !tr.follow;	break;
		case TR_FLAG_INTERP:	tr.interp	= !tr.interp;	break;
	}
}

//One glyph per volume-column command, indexed by TRV_*.
U8 *tr_volcmd_letters = ".vdufeSPpLRGHh";

//Pull-down menu commands. Every entry sends MESSAGE_CMD rather than a
//synthesised keystroke: the letter keys here are a piano keyboard, so a menu
//item bound to a character would enter a note.
#define TRM_NEW			1
#define TRM_LOAD		2
#define TRM_SAVE		3
#define TRM_LOADSMP		4
#define TRM_EXIT		5
#define TRM_PLAY_SONG	6
#define TRM_PLAY_PAT	7
#define TRM_STOP		8
#define TRM_FOLLOW		9
#define TRM_EDIT		10
#define TRM_INS_ROW		11
#define TRM_DEL_ROW		12
#define TRM_CLR_CELL	13
#define TRM_PANE_INST	14
#define TRM_PANE_ORDER	15
#define TRM_PANE_HELP	16
#define TRM_INTERP		17
#define TRM_PAT_PREV	18
#define TRM_PAT_NEXT	19
#define TRM_MUTE		20
#define TRM_HELPDOC	21
#define TRM_KEYS		22
#define TRM_PANE_MACRO	23
#define TRM_PANE_WAVE	24
#define TRM_VIEW_ROLL	25
#define TRM_VIEW_ARR	26
#define TRM_VIEW_GRID	27

U8 TrHexDigit(I64 v)
{
	v &= 0x0F;
	if (v < 10)
		return '0' + v;

	return 'A' + v - 10;
}

U0 TrStatus(U8 *fmt, ...)
{//The compositor reads tr.status from another task, so stage the whole field
//and copy it in one pass: a partial StrCopy can leave it unterminated.
	U8	 tmp[128];
	U8	*s = StrPrintJoin(NULL, fmt, argc, argv);

	MemSet(tmp, 0, sizeof(tmp));
	if (StrLen(s) >= sizeof(tmp))
		s[sizeof(tmp) - 1] = 0;
	StrCopy(tmp, s);
	MemCopy(tr.status, tmp, sizeof(tmp));
	Free(s);
}

Bool TrEnsurePattern(I64 p)
{
	if (p < 0 || p >= TR_MAX_PATTERNS)
		return FALSE;
	if (tr_pat[p])
		return TRUE;
	if (!TrPatternAlloc(p, 64))
		return FALSE;
	if (p >= tr_song.n_patterns)
		tr_song.n_patterns = p + 1;

	return TRUE;
}

I64 TrCurRows()
{
	I64 r = tr_pat_rows[ClampI64(tr.cur_pat, 0, TR_MAX_PATTERNS - 1)];

	if (r < 1)
		return 64;

	return r;
}

U0 TrCellText(CTrCell *c, U8 *buf)
{//Fixed 13-glyph layout: "C-4 01 40 A08". Empty fields read as dots.
	I64 i;

	for (i = 0; i < 13; i++)
		buf[i] = '.';
	buf[3]	= ' ';
	buf[6]	= ' ';
	buf[9]	= ' ';
	buf[13]	= 0;
	if (!c)
		return;
	if (c->note == TR_NOTE_OFF)
	{
		buf[0] = '^';
		buf[1] = '^';
		buf[2] = '-';
	}
	else if (c->note)
	{
		buf[0] = tr_note_names[(c->note - 1) % 12 * 2];
		buf[1] = tr_note_names[(c->note - 1) % 12 * 2 + 1];
		buf[2] = '0' + (c->note - 1) / 12;
	}
	if (c->inst)
	{
		buf[4] = TrHexDigit(c->inst >> 4);
		buf[5] = TrHexDigit(c->inst);
	}
	if (c->volcmd == TRV_SET)
	{
		buf[7] = TrHexDigit(c->volparam >> 4);
		buf[8] = TrHexDigit(c->volparam);
	}
	else if (c->volcmd)
	{//Slides and the other column commands show as a letter plus one digit.
		buf[7] = tr_volcmd_letters[ClampI64(c->volcmd, 0, TRV_PITCH_DOWN)];
		buf[8] = TrHexDigit(c->volparam);
	}
	if (c->eff || c->param)
	{
		buf[10] = TrHexDigit(c->eff);
		buf[11] = TrHexDigit(c->param >> 4);
		buf[12] = TrHexDigit(c->param);
	}
}

I64 TrScopeStart(I64 span)
{//Read index the display starts at: the first rising zero crossing of the sum
//inside the part of the ring the display does not reach.
//
//scope_pos free-running means every frame begins at a different point in the
//waveform, so the trace never stands still: at one sample per column it reads
//as a picket fence that reshuffles each frame rather than as a wave. Anchoring
//to a zero crossing is what a hardware scope's trigger does, and it is what
//makes the shape legible.
	I64 i, lim = TR_SCOPE_N - span, a, b;
	I64 m = TR_SCOPE_N - 1;

	for (i = 1; i < lim; i++)
	{
		a = tr.scope[(tr.scope_pos + i - 1) & m] +
			tr.scope_r[(tr.scope_pos + i - 1) & m];
		b = tr.scope[(tr.scope_pos + i) & m] +
			tr.scope_r[(tr.scope_pos + i) & m];
		if (a < 0 <= b)
			return tr.scope_pos + i;
	}

	//Silence, or a waveform that never crosses inside the search window.
	return tr.scope_pos;
}

U0 TrScopeTrace(CDC *dc, I64 x0, I64 n, I64 mid, I16 *buf, I16 *buf2,
				I64 half, I64 y0, I64 y1, I64 start, I64 step)
{//One channel as a connected trace. Each column contributes its mean, joined
//to the previous column's, plus a vertical span covering that column's
//minimum to maximum.
//
//The line is what makes it a wave. A span alone leaves a 1-pixel mark per
//column wherever a column covers only a frame or two, and consecutive marks
//sit at unrelated heights, so the trace reads as loose dots rather than a
//waveform. The span alone also cannot be rectified into an envelope without
//losing the sign, which is the shape.
//
//buf2 non-NULL averages the two, which is the mono sum.
	I64 col, i, i0, lo, hi, v, sum, y, prev = mid, m = TR_SCOPE_N - 1;

	for (col = 0; col < n; col++)
	{
		i0	= start + col * step;
		lo	= 32767;
		hi	= -32768;
		sum	= 0;
		for (i = i0; i < i0 + step; i++)
		{
			v = buf[i & m];
			if (buf2)
				v = (v + buf2[i & m]) / 2;
			sum += v;
			if (v < lo)
				lo = v;
			if (v > hi)
				hi = v;
		}
		y	= ClampI64(mid - sum / step * half / 32768, y0, y1);
		lo	= ClampI64(mid - lo * half / 32768, y0, y1);
		hi	= ClampI64(mid - hi * half / 32768, y0, y1);
		if (lo > hi)
			GrRect(dc, x0 + col, hi, 1, lo - hi);
		if (col)
			GrLine(dc, x0 + col - 1, prev, x0 + col, y);
		prev = y;
	}
}

U0 TrScopeOver(CDC *dc, I64 x0, I64 n, I64 mid, I64 half, I64 y0, I64 y1,
			   I64 start, I64 step)
{//Both channels superimposed on one axis, each its own trace.
//
//Where the channels agree the traces sit on each other and one colour shows;
//that IS the picture, since agreeing is what the signal does. Where they part
//the two lines separate and both colours appear. Rectifying to a magnitude
//instead turns every cycle into a hump and the whole thing into a row of
//filled blobs.
	dc->color = de_theme.accent2;
	TrScopeTrace(dc, x0, n, mid, tr.scope_r, NULL, half, y0, y1, start, step);
	//Left last: the two coincide often enough that the order decides which
	//colour a centred mix reads as, and left is the primary accent.
	dc->color = de_theme.accent;
	TrScopeTrace(dc, x0, n, mid, tr.scope, NULL, half, y0, y1, start, step);
}

U0 TrDrawScope(CDC *dc, I64 w)
{//Three modes, cycled by clicking the box.
//
//    split   left lane above right lane, each in its own colour
//    mono    the sum across the full height
//    over    both superimposed on one axis, one trace each
	I64 mid = TR_SCOPE_Y + TR_SCOPE_H / 2, n = w - 28;
	I64 q = TR_SCOPE_H / 4, half, step, span, start;

	dc->color = de_theme.panel;
	GrRect(dc, 12, TR_SCOPE_Y, w - 24, TR_SCOPE_H);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, TR_SCOPE_Y, w - 24, 1);
	GrRect(dc, 12, TR_SCOPE_Y + TR_SCOPE_H - 1, w - 24, 1);
	if (n < 2)
		return;
	//Whole frames per column, so a column always covers a run of the signal
	//and never repeats one sample across several columns.
	step	= MaxI64(1, TR_SCOPE_SPAN / n);
	span	= step * n;
	start	= TrScopeStart(span);
	if (tr.scope_mode == TR_SCOPE_MONO || tr.scope_mode == TR_SCOPE_OVER)
	{
		dc->color = de_theme.panel_edge;
		GrRect(dc, 12, mid, w - 24, 1);
		half = TR_SCOPE_H / 2 - 2;
		if (tr.scope_mode == TR_SCOPE_MONO)
		{
			dc->color = de_theme.accent;
			TrScopeTrace(dc, 14, n, mid, tr.scope, tr.scope_r, half,
						TR_SCOPE_Y + 1, TR_SCOPE_Y + TR_SCOPE_H - 2,
						start, step);
		}
		else
			TrScopeOver(dc, 14, n, mid, half, TR_SCOPE_Y + 1,
						TR_SCOPE_Y + TR_SCOPE_H - 2, start, step);
		if (tr.scope_mode == TR_SCOPE_MONO)
		{
			dc->color = de_theme.text_dim;
			GrPrint(dc, 16, TR_SCOPE_Y + 2, "MONO");
		}
		else
		{//Both traces share the axis, so the labels are a colour key rather
		//than a statement about which half is which.
			dc->color = de_theme.accent;
			GrPrint(dc, 16, TR_SCOPE_Y + 2, "L");
			dc->color = de_theme.accent2;
			GrPrint(dc, 26, TR_SCOPE_Y + 2, "R");
		}
		return;
	}
	//Split. Each lane gets its own zero line and half the amplitude.
	half = q - 2;
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, TR_SCOPE_Y + q, w - 24, 1);
	GrRect(dc, 12, mid, w - 24, 1);
	GrRect(dc, 12, TR_SCOPE_Y + q * 3, w - 24, 1);
	dc->color = de_theme.accent;
	TrScopeTrace(dc, 14, n, TR_SCOPE_Y + q, tr.scope, NULL, half,
				TR_SCOPE_Y + 1, mid - 1, start, step);
	dc->color = de_theme.accent2;
	TrScopeTrace(dc, 14, n, TR_SCOPE_Y + q * 3, tr.scope_r, NULL, half,
				mid + 1, TR_SCOPE_Y + TR_SCOPE_H - 2, start, step);
	dc->color = de_theme.text_dim;
	GrPrint(dc, 16, TR_SCOPE_Y + 2, "L");
	GrPrint(dc, 16, mid + 2, "R");
}




U0 TrDrawSeek(CDC *dc, I64 w, I64 play_ord, I64 play_row, I64 play_pat)
{//Song position across the order list. Each order gets an equal slice, and
//the row inside the playing order fills its slice, so the bar advances
//smoothly rather than jumping once per pattern.
	I64	 i, x0, x1, n = tr_song.order_len, rows, frac, cur, bw = w - 24;
	U8	 buf[64];

	dc->color = de_theme.panel;
	GrRect(dc, 12, TrSeekY(), bw, TR_SEEK_H);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, TrSeekY(), bw, 1);
	GrRect(dc, 12, TrSeekY() + TR_SEEK_H - 1, bw, 1);
	if (n < 1)
		return;

	//Order boundaries, so the bar doubles as a map of the song.
	if (n <= bw / 3)
		for (i = 1; i < n; i++)
		{
			x0 = 12 + i * bw / n;
			dc->color = de_theme.panel_edge;
			GrRect(dc, x0, TrSeekY() + 2, 1, TR_SEEK_H - 4);
		}

	cur = play_ord;
	if (cur < 0)
		cur = tr.order_sel;			//Stopped: show where play would start.
	cur = ClampI64(cur, 0, n - 1);
	x0 = 12 + cur * bw / n;
	x1 = 12 + (cur + 1) * bw / n;
	if (play_ord >= 0 && play_row >= 0)
	{//Fill the slice in proportion to the row inside the playing pattern.
		rows = tr_pat_rows[ClampI64(play_pat, 0, TR_MAX_PATTERNS - 1)];
		if (rows < 1)
			rows = 64;
		frac = (x1 - x0) * ClampI64(play_row, 0, rows - 1) / rows;
	}
	else
		frac = 0;

	dc->color = de_theme.bttn_focus;
	GrRect(dc, 12, TrSeekY() + 1, x0 - 12, TR_SEEK_H - 2);
	dc->color = de_theme.accent;
	GrRect(dc, x0, TrSeekY() + 1, MaxI64(2, frac), TR_SEEK_H - 2);

	dc->color = de_theme.text_dim;
	StrPrint(buf, "%03d/%03d", cur, n);
	GrPrint(dc, w - 12 - 8 * StrLen(buf), TrSeekY() + 1, "%s", buf);
}

U0 TrPaneFrame(CDC *dc, I64 x, I64 y, I64 w)
{//Fill and a one-pixel outline, inside the window's own border.
	dc->color = de_theme.panel;
	GrRect(dc, x, y, w, TR_PANE_H);
	dc->color = de_theme.accent;
	GrRect(dc, x, y, w, 1);
	GrRect(dc, x, y + TR_PANE_H - 1, w, 1);
	GrRect(dc, x, y, 1, TR_PANE_H);
	GrRect(dc, x + w - 1, y, 1, TR_PANE_H);
}

U0 TrDrawPaneHelp(CDC *dc, I64 x, I64 y)
{
	I64 h = 20;

	TrPaneFrame(dc, x, y, TR_PANE_W_HELP);
	GrPrint(dc, x + 12, y + 6, "YTRACKER KEYS");
	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + h,		"Arrows        move cursor by sub-column");
	GrPrint(dc, x + 12, y + h + 13,	"Tab / Sh-Tab  next / previous channel");
	GrPrint(dc, x + 12, y + h + 26,	"Ctrl-Lt/Rt    channel   Ctrl-Up/Dn  pattern");
	GrPrint(dc, x + 12, y + h + 39,	"Sh-Up/Dn      instrument   Sh-Lt/Rt  octave");
	GrPrint(dc, x + 12, y + h + 52,	"PgUp / PgDn   move 16 rows  Home/End  ends");
	GrPrint(dc, x + 12, y + h + 65,	"ZSXDCVGBHNJM  notes, lower octave");
	GrPrint(dc, x + 12, y + h + 78,	"Q2W3ER5T6Y7U  notes, upper octave");
	GrPrint(dc, x + 12, y + h + 91,	"1             note off      0  clear cell");
	GrPrint(dc, x + 12, y + h + 104,"0-9 A-F       hex digits in the other columns");
	GrPrint(dc, x + 12, y + h + 117,"Ins / Del     insert / delete row in channel");
	GrPrint(dc, x + 12, y + h + 130,"Backspace     clear cell");
	GrPrint(dc, x + 12, y + h + 143,"Space         play / stop song");
	GrPrint(dc, x + 12, y + h + 156,"Enter         play pattern from cursor row");
	GrPrint(dc, x + 12, y + h + 169,"F1 F2 F3      help / instruments / order");
	GrPrint(dc, x + 12, y + h + 182,"F4 F7 F12     interpolate / follow / edit");
	GrPrint(dc, x + 12, y + h + 195,"F5 F6 F8      play song / play pattern / stop");
	GrPrint(dc, x + 12, y + h + 208,"F9 F10        save song / load song or .MOD");
	GrPrint(dc, x + 12, y + h + 221,"F11           load .WAV into current slot");
	GrPrint(dc, x + 12, y + h + 234,"- =           previous / next pattern");
	GrPrint(dc, x + 12, y + h + 247,"[ ]           tempo      ; '  speed (ticks)");
	GrPrint(dc, x + 12, y + h + 260,", .           master gain down / up");
	GrPrint(dc, x + 12, y + h + 273,"Click cell    move cursor   click CHn  mute");
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + h + 292, "F1 closes this - ESC quits YTracker");
}

U0 TrWaveInto(CDC *dc, I64 x, I64 y, I64 w, I64 h, I64 smp)
{//The sample's shape drawn INTO an existing box, in whatever colour the
//caller set and over whatever is already there. A note bar is a box the
//length of the note holding one sample, which is what a DAW draws an audio
//clip as; the difference is that the sample repeats rather than running once.
	CTrSample	*s;
	I64			 col, i, i0, i1, lo, hi, v, mid = y + h / 2, step;

	if (smp < 1 || smp >= TR_MAX_SAMPLES || w < 2 || h < 3)
		return;
	s = &tr_smp[smp];
	if (!s->data || s->len < 2)
		return;
	for (col = 0; col < w; col++)
	{
		i0 = col * s->len / w;
		i1 = (col + 1) * s->len / w;
		if (i1 <= i0)
			i1 = i0 + 1;
		if (i1 > s->len)
			i1 = s->len;
		lo	 = 32767;
		hi	 = -32768;
		//Bounded work per column: every frame of a long sample buys nothing
		//at one pixel across.
		step = 1 + (i1 - i0) / 32;
		for (i = i0; i < i1; i += step)
		{
			v = s->data[i];
			if (v < lo)
				lo = v;
			if (v > hi)
				hi = v;
		}
		lo = ClampI64(mid - lo * (h / 2 - 1) / 32768, y, y + h - 1);
		hi = ClampI64(mid - hi * (h / 2 - 1) / 32768, y, y + h - 1);
		GrRect(dc, x + col, hi, 1, MaxI64(1, lo - hi));
	}
}

U0 TrDrawWave(CDC *dc, I64 x, I64 y, I64 w, I64 h, I64 smp)
{//The selected sample's waveform, min and max per column so a long sample
//shows its envelope rather than whichever frames the stride happened to land
//on. Loop bounds are marked, since where a sample loops is most of what you
//need to see when picking one.
	CTrSample	*s;
	I64			 col, i, i0, i1, lo, hi, v, mid = y + h / 2, lx;

	dc->color = de_theme.win_bg;
	GrRect(dc, x, y, w, h);
	if (smp < 1 || smp >= TR_MAX_SAMPLES)
		return;
	s = &tr_smp[smp];
	if (!s->data || s->len < 2 || w < 4 || h < 4)
		return;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x, mid, w, 1);
	dc->color = de_theme.accent;
	for (col = 0; col < w; col++)
	{
		i0 = col * s->len / w;
		i1 = (col + 1) * s->len / w;
		if (i1 <= i0)
			i1 = i0 + 1;
		if (i1 > s->len)
			i1 = s->len;
		lo = 32767;
		hi = -32768;
		//Stride long samples: every frame of a 100k sample buys nothing at
		//one pixel per column.
		for (i = i0; i < i1; i += 1 + (i1 - i0) / 64)
		{
			v = s->data[i];
			if (v < lo)
				lo = v;
			if (v > hi)
				hi = v;
		}
		lo = mid - lo * (h / 2 - 1) / 32768;
		hi = mid - hi * (h / 2 - 1) / 32768;
		GrRect(dc, x + col, hi, 1, MaxI64(1, lo - hi));
	}
	if (s->loop_len > 1 && s->loop_type != TR_LOOP_NONE)
	{
		dc->color = de_theme.accent2;
		lx = x + s->loop_start * w / s->len;
		GrRect(dc, ClampI64(lx, x, x + w - 1), y, 1, h);
		lx = x + (s->loop_start + s->loop_len) * w / s->len;
		GrRect(dc, ClampI64(lx, x, x + w - 1), y, 1, h);
	}
}

U0 TrDrawPaneInst(CDC *dc, I64 x, I64 y)
{
	I64	 i, row = 0, top, n;
	U8	 buf[STR_LEN];

	TrPaneFrame(dc, x, y, TR_PANE_W_INST);
	GrPrint(dc, x + 10, y + 6, "INSTRUMENTS - up/down select, F11 loads a WAV");

	top = ClampI64(tr.inst - 11, 1, TR_MAX_SAMPLES - 22);
	for (i = top; i < top + 22 && i < TR_MAX_SAMPLES; i++)
	{
		if (i == tr.inst)
		{
			dc->color = de_theme.bttn_focus;
			GrRect(dc, x + 6, y + 22 + row * 13 - 1, 408, 12);
			dc->color = de_theme.accent;
		}
		else if (tr_smp[i].data)
			dc->color = de_theme.text;
		else
			dc->color = de_theme.text_dim;
		if (tr_smp[i].data)
		{
			n = tr_smp[i].len;
			if (tr_smp[i].loop_len > 1)
				StrPrint(buf, "%02X %-22s %6d v%02d ft %2d loop", i,
						 tr_smp[i].name, n, tr_smp[i].volume,
						 tr_smp[i].finetune);
			else
				StrPrint(buf, "%02X %-22s %6d v%02d ft %2d", i,
						 tr_smp[i].name, n, tr_smp[i].volume,
						 tr_smp[i].finetune);
		}
		else
			StrPrint(buf, "%02X %-22s      -", i, "(empty)");
		GrPrint(dc, x + 10, y + 22 + row * 13, "%s", buf);
		row++;
	}
	TrDrawWave(dc, x + 6, y + 314, 408, 12, tr.inst);
}

U0 TrDrawPaneOrder(CDC *dc, I64 x, I64 y)
{
	I64	 i, row = 0, top;
	U8	 buf[STR_LEN];

	TrPaneFrame(dc, x, y, TR_PANE_W_ORDER);
	GrPrint(dc, x + 10, y + 6, "ORDER - Ins adds, Del removes, -/= sets pattern");

	top = ClampI64(tr.order_sel - 11, 0, TR_ORDER_MAX - 22);
	for (i = top; i < top + 22 && i < tr_song.order_len; i++)
	{
		if (i == tr.order_sel)
		{
			dc->color = de_theme.bttn_focus;
			GrRect(dc, x + 6, y + 22 + row * 13 - 1, 288, 12);
			dc->color = de_theme.accent;
		}
		else
			dc->color = de_theme.text;
		StrPrint(buf, "%03d   pattern %02X", i, tr_song.order[i]);
		GrPrint(dc, x + 10, y + 22 + row * 13, "%s", buf);
		row++;
	}
	if (!tr_song.order_len)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x + 10, y + 22, "(empty - Ins appends the current pattern)");
	}
}

U8 *tr_macro_names[TR_MACRO_COUNT] = {"Volume", "Arpeggio", "Pitch", "Duty",
									  "Hi-pitch"};
U8 *tr_arp_modes[3] = {"absolute", "fixed", "relative"};

//Geometry shared by the macro and wavetable editors.
#define TR_ED_GX	16		//Graph inset from the pane edge.
#define TR_ED_GY	64
#define TR_ED_GH	180

I64 TrMacroRange(I64 which, I64 *_lo)
{//Value range per macro type. Volume is the engine's 0..64; arpeggio and
//pitch are signed; duty indexes a bank. Hi-pitch shares pitch's range and
//differs only in the scale the mixer applies to it.
	switch (which)
	{
		case TR_MACRO_ARP:
			*_lo = -48;
			return 48;
		case TR_MACRO_PITCH:
		case TR_MACRO_HIPITCH:
			*_lo = -64;
			return 64;
		case TR_MACRO_DUTY:
			*_lo = 0;
			return TR_WAVE_SLOTS - 1;
	}
	*_lo = 0;

	return 64;
}

CTrMacro *TrMacroCur()
{//Macro under the editor cursor, allocating the instrument if needed.
	CTrInst *ins;

	if (tr.inst < 1 || tr.inst >= TR_MAX_INSTRUMENTS)
		return NULL;
	ins = tr_inst[tr.inst];
	if (!ins)
		ins = TrInstAlloc(tr.inst);
	if (!ins)
		return NULL;

	return &ins->macro[ClampI64(tr.macro_sel, 0, TR_MACRO_COUNT - 1)];
}

U0 TrDrawPaneMacro(CDC *dc, I64 x, I64 y)
{
	CTrMacro *m = TrMacroCur();
	I64		  i, lo, hi, span, w, bx, bh, zero, v, n;
	U8		  buf[STR_LEN];

	TrPaneFrame(dc, x, y, TR_ED_W);
	GrPrint(dc, x + 12, y + 6, "MACRO EDITOR - instrument %02X", tr.inst);
	if (!m)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x + 12, y + 24, "No instrument slot selected.");
		return;
	}

	hi = TrMacroRange(tr.macro_sel, &lo);
	span = hi - lo;
	if (span < 1)
		span = 1;

	//Type strip: the selected macro is highlighted, the rest dim.
	for (i = 0; i < TR_MACRO_COUNT; i++)
	{
		if (i == tr.macro_sel)
			dc->color = de_theme.accent;
		else if (tr_inst[tr.inst]->macro[i].len > 0)
			dc->color = de_theme.text;
		else
			dc->color = de_theme.text_dim;
		GrPrint(dc, x + 12 + i * 72, y + 24, "%s", tr_macro_names[i]);
	}

	dc->color = de_theme.text_dim;
	if (tr.macro_sel == TR_MACRO_ARP)
		StrPrint(buf, "len %2d  loop %2d  release %2d  mode %s",
				 m->len, m->loop, m->release,
				 tr_arp_modes[ClampI64(m->mode, 0, 2)]);
	else
		StrPrint(buf, "len %2d  loop %2d  release %2d", m->len, m->loop,
				 m->release);
	GrPrint(dc, x + 12, y + 42, "%s", buf);

	//Graph. One column per step, bar drawn from the zero line.
	n = m->len;
	if (n < 1)
		n = 1;
	w  = (TR_ED_W - 2 * TR_ED_GX) / TR_MACRO_LEN;
	if (w < 1)
		w = 1;
	zero = y + TR_ED_GY + TR_ED_GH * hi / span;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY, TR_MACRO_LEN * w, TR_ED_GH);
	GrRect(dc, x + TR_ED_GX, zero, TR_MACRO_LEN * w, 1);

	for (i = 0; i < TR_MACRO_LEN; i++)
	{
		bx = x + TR_ED_GX + i * w;
		if (i >= m->len)
		{//Past the end: nothing plays here.
			dc->color = de_theme.panel;
			GrRect(dc, bx, y + TR_ED_GY, w - 1, TR_ED_GH);
		}
		else
		{
			v  = ClampI64(m->val[i], lo, hi);
			bh = (v - lo) * TR_ED_GH / span;
			if (bh < 1)
				bh = 1;
			if (i == tr.macro_step)
				dc->color = de_theme.accent;
			else
				dc->color = de_theme.bttn_focus;
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH - bh, w - 1, bh);
		}
		//Loop and release markers sit under their step.
		if (i == m->loop)
		{
			dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH + 2, w - 1, 3);
		}
		if (i == m->release)
		{
			dc->color = ColorRGB(0xF0, 0x9A, 0x50);
			GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH + 6, w - 1, 3);
		}
	}

	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 14,
			"step %02d = %d", tr.macro_step,
			m->val[ClampI64(tr.macro_step, 0, TR_MACRO_LEN - 1)]);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 30,
			"Left/Right step   Up/Down value   Shift for big steps");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 44,
			"Tab macro   Ins/Del length   L loop   R release   M mode");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 58,
			"Click or drag in the graph to draw.  F4 closes.");
	dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 74, "green = loop point");
	dc->color = ColorRGB(0xF0, 0x9A, 0x50);
	GrPrint(dc, x + 190, y + TR_ED_GY + TR_ED_GH + 74, "orange = release");
}

U0 TrDrawPaneWave(CDC *dc, I64 x, I64 y)
{
	I64	 i, w, bx, bh, slot;
	U8	 buf[STR_LEN];

	TrPaneFrame(dc, x, y, TR_ED_W);

	slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
	GrPrint(dc, x + 12, y + 6, "WAVETABLE EDITOR - table %02d of %d", slot,
			TR_WAVE_SLOTS);
	dc->color = de_theme.text_dim;
	StrPrint(buf, "%d steps, 0..%d, rendered into sample slot %02X",
			 TR_WAVE_STEPS, TR_WAVE_MAX, tr_wave_slot[slot]);
	GrPrint(dc, x + 12, y + 24, "%s", buf);

	w = (TR_ED_W - 2 * TR_ED_GX) / TR_WAVE_STEPS;
	if (w < 1)
		w = 1;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY, TR_WAVE_STEPS * w, TR_ED_GH);
	GrRect(dc, x + TR_ED_GX, y + TR_ED_GY + TR_ED_GH / 2,
		   TR_WAVE_STEPS * w, 1);

	for (i = 0; i < TR_WAVE_STEPS; i++)
	{
		bx = x + TR_ED_GX + i * w;
		bh = (tr_wave[slot].step[i] + 1) * TR_ED_GH / (TR_WAVE_MAX + 1);
		if (i == tr.wave_step)
			dc->color = de_theme.accent;
		else
			dc->color = de_theme.bttn_focus;
		GrRect(dc, bx, y + TR_ED_GY + TR_ED_GH - bh, w - 1, bh);
	}

	dc->color = de_theme.text;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 14, "step %02d = %2d",
			tr.wave_step, tr_wave[slot].step[ClampI64(tr.wave_step, 0,
													  TR_WAVE_STEPS - 1)]);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 30,
			"Left/Right step   Up/Down value   Tab next table");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 44,
			"Click or drag to draw.  Set an instrument's bank to Wave and");
	GrPrint(dc, x + 12, y + TR_ED_GY + TR_ED_GH + 58,
			"point its Duty macro at this table.  Shift-F4 closes.");
}


//Piano roll geometry. Time runs left to right in rows, pitch bottom to top.
#define TR_ROLL_X		56		//Keyboard gutter width.
#define TR_ROLL_KEYH	9		//Default pixels per semitone.
#define TR_ROLL_COLW	14		//Default pixels per row.
#define TR_ARR_X		196		//Arrangement lane-name gutter and mixer strip.
//Mixer strip inside the gutter: a volume fader with the channel's peak level
//behind it, and a pan slider. Both edit tr_chan_vol / tr_chan_pan, which the
//mixer reads when a channel starts a note, so they are the same controls the
//module's own C and 8xx effects write.
#define TR_MIX_X		4		//Left inset from TR_GRID_X.
#define TR_MIX_VW		96		//Volume fader width.
#define TR_MIX_PW		56		//Pan slider width.
#define TR_MIX_H		7		//Bar height.
#define TR_MIX_Y		15		//Top inset within the lane.
#define TR_MIX_RW		28		//Pan readout width.
//Pan snaps to centre inside this many units of 255. A slider a couple of
//pixels wide per unit cannot be put back to dead centre by hand, and centre
//is the value that matters.
#define TR_MIX_SNAP		20
#define TR_ARR_LANEH	26		//Default lane height.
#define TR_ARR_CLIPW	40		//Default clip width.
//Zoom bounds. Clip width, lane height, row width and key height are stored in
//tr rather than fixed, so both views zoom.
#define TR_ARR_LANEH_MIN 10
#define TR_ARR_LANEH_MAX 80
#define TR_ARR_CLIPW_MIN 8
#define TR_ARR_CLIPW_MAX 160
#define TR_ROLL_KEYH_MIN 4
#define TR_ROLL_KEYH_MAX 28
#define TR_ROLL_COLW_MIN 4
#define TR_ROLL_COLW_MAX 48

U0 TrZoomInit()
{//Zero means never set. A file-scope struct holds garbage until something
//fills it, so this runs before anything reads a zoom field.
	if (tr.arr_zx < TR_ARR_CLIPW_MIN || tr.arr_zx > TR_ARR_CLIPW_MAX)
		tr.arr_zx = TR_ARR_CLIPW;
	if (tr.arr_zy < TR_ARR_LANEH_MIN || tr.arr_zy > TR_ARR_LANEH_MAX)
		tr.arr_zy = TR_ARR_LANEH;
	if (tr.roll_zx < TR_ROLL_COLW_MIN || tr.roll_zx > TR_ROLL_COLW_MAX)
		tr.roll_zx = TR_ROLL_COLW;
	if (tr.roll_zy < TR_ROLL_KEYH_MIN || tr.roll_zy > TR_ROLL_KEYH_MAX)
		tr.roll_zy = TR_ROLL_KEYH;
}


I64 tr_roll_keys = 24;			//Semitones visible, set by the last draw.

Bool TrRollBlack(I64 note)
{//note 1 is C-0, so the pitch class is (note - 1) % 12.
	I64 pc = (note - 1) % 12;

	return pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
}

I64 TrRollNoteAt(I64 my)
{//Screen row to note. The roll draws high pitches at the top.
	I64 k;

	TrZoomInit;
	k = (my - TR_GRID_Y) / tr.roll_zy;

	if (k < 0 || k >= tr_roll_keys)
		return 0;

	return tr.roll_top + tr_roll_keys - 1 - k;
}

I64 TrRollRowAt(I64 mx)
{
	TrZoomInit;
	if (mx < TR_ROLL_X + TR_GRID_X)
		return -1;

	return tr.view_top + (mx - TR_ROLL_X - TR_GRID_X) / tr.roll_zx;
}

//Attribute panel across the bottom of the roll. A cell carries an instrument,
//a volume, an effect and a parameter as well as a pitch, and the roll draws
//only the pitch; without this the only way to reach the rest is the grid.
#define TR_RP_H			22		//Panel height.
#define TR_RP_FW		84		//Field width.

U8 *TrOnOff(Bool b)
{
	if (b)
		return "on";

	return "off";
}

I64 TrRollPanelY()
{//Sits directly above the seek bar.
	return TrSeekY() - TR_RP_H;
}

U8 *tr_roll_field_name[TR_RF_COUNT] = {"INST", "VOL", "EFF", "PARAM"};

I64 TrRollSnapX()
{//Left edge of the snap box, just past the four value fields.
	return TR_GRID_X + TR_RF_COUNT * TR_RP_FW + 8;
}

I64 TrRollGhostX()
{//Right of the snap box.
	return TR_GRID_X + TR_RF_COUNT * TR_RP_FW + 64;
}

Bool TrRollGhostHit(I64 mx, I64 my)
{
	if (my < TrRollPanelY() || my >= TrRollPanelY() + TR_RP_H)
		return FALSE;

	return TrRollGhostX() <= mx < TrRollGhostX() + 52;
}

Bool TrRollSnapHit(I64 mx, I64 my)
{//Whether the pointer is on the snap box. It sits in the same strip as the
//value fields, so it takes a click the same way rather than hiding behind a
//key nobody would guess.
	if (my < TrRollPanelY() || my >= TrRollPanelY() + TR_RP_H)
		return FALSE;

	return TrRollSnapX() <= mx < TrRollSnapX() + 48;
}

U0 TrRollSnapCycle()
{//Off, 2, 4, 8, 16, and back to off.
	if (tr.roll_snap < 2)
		tr.roll_snap = 2;
	else if (tr.roll_snap >= 16)
		tr.roll_snap = 1;
	else
		tr.roll_snap = tr.roll_snap * 2;
}

I64 TrRollFieldAt(I64 mx, I64 my)
{//Which panel field the pointer is over, -1 for none.
	I64 i;

	if (my < TrRollPanelY() || my >= TrRollPanelY() + TR_RP_H)
		return -1;
	i = (mx - TR_GRID_X) / TR_RP_FW;
	if (mx < TR_GRID_X || i < 0 || i >= TR_RF_COUNT)
		return -1;

	return i;
}

I64 TrRollFieldValue(CTrCell *c, I64 field)
{//The cell's value for one panel field.
	if (!c)
		return 0;
	switch (field)
	{
		case TR_RF_INST:	return c->inst;
		case TR_RF_VOL:
			if (c->volcmd == TRV_SET)
				return c->volparam;
			return -1;			//Empty, not zero: the two sound different.
		case TR_RF_EFF:		return c->eff;
		case TR_RF_PARAM:	return c->param;
	}

	return 0;
}

U0 TrRollFieldSet(CTrCell *c, I64 field, I64 v)
{//Write one panel field back into the cell.
	if (!c)
		return;
	switch (field)
	{
		case TR_RF_INST:
			c->inst = ClampI64(v, 0, TR_MAX_SAMPLES - 1);
			break;
		case TR_RF_VOL:
			if (v < 0)
				c->volcmd = TRV_NONE;
			else
			{
				c->volcmd	= TRV_SET;
				c->volparam	= ClampI64(v, 0, 64);
			}
			break;
		case TR_RF_EFF:
			c->eff = ClampI64(v, 0, TRX_COUNT - 1);
			break;
		case TR_RF_PARAM:
			c->param = ClampI64(v, 0, 255);
			break;
	}
}

U0 TrDrawRollPanel(CDC *dc, I64 w)
{//The selected cell's attributes, one field per box. Clicking a box selects
//it; hex digits then type into it, the way the grid's columns work.
	I64		 i, x, y = TrRollPanelY(), v;
	CTrCell	*c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
	U8		 buf[32];

	dc->color = de_theme.panel;
	GrRect(dc, 12, y, w - 24, TR_RP_H);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 12, y, w - 24, 1);
	for (i = 0; i < TR_RF_COUNT; i++)
	{
		x = TR_GRID_X + i * TR_RP_FW;
		if (i == tr.roll_field)
		{
			//Lit only while the panel actually has the keyboard, so the
			//highlight means "typing lands here" rather than "last clicked".
			if (tr.roll_edit)
				dc->color = de_theme.accent2;
			else
				dc->color = de_theme.bttn_focus;
			GrRect(dc, x - 2, y + 2, TR_RP_FW - 6, TR_RP_H - 5);
		}
		dc->color = de_theme.text_dim;
		GrPrint(dc, x, y + 3, "%s", tr_roll_field_name[i]);
		v = TrRollFieldValue(c, i);
		if (!c || !c->note)
			StrCopy(buf, "--");
		else if (v < 0)
			StrCopy(buf, "..");	//Volume column empty: the note keeps its own.
		else
			StrPrint(buf, "%02X", v);
		if (i == tr.roll_field)
			dc->color = de_theme.accent;
		else
			dc->color = de_theme.text;
		GrPrint(dc, x, y + 12, "%s", buf);
	}
	//Snap and selection state, where the eye already is.
	x = TrRollSnapX();
	dc->color = de_theme.bttn;
	GrRect(dc, x - 4, y + 2, 48, TR_RP_H - 5);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x, y + 3, "SNAP");
	dc->color = de_theme.text;
	if (tr.roll_snap > 1)
		GrPrint(dc, x, y + 12, "%d", tr.roll_snap);
	else
		GrPrint(dc, x, y + 12, "off");
	x = TrRollGhostX();
	dc->color = de_theme.bttn;
	GrRect(dc, x - 4, y + 2, 52, TR_RP_H - 5);
	dc->color = de_theme.text_dim;
	GrPrint(dc, x, y + 3, "GHOST");
	if (tr.roll_ghosts)
		dc->color = de_theme.accent;
	GrPrint(dc, x, y + 12, "%s", TrOnOff(tr.roll_ghosts));
	if (tr.sel_r0 >= 0)
	{
		dc->color = de_theme.accent2;
		GrPrint(dc, x + 60, y + 3, "SELECTED");
		GrPrint(dc, x + 60, y + 12, "%d rows %d notes",
				tr.sel_r1 - tr.sel_r0 + 1, tr.sel_n1 - tr.sel_n0 + 1);
	}
}

//How much of a note's right end grabs its tail rather than the note itself.
//A whole row is far too much: at one row long that IS the note, so a short
//note could only ever be resized, never moved. A DAW uses a few pixels.
#define TR_ROLL_GRIP	6

Bool TrRollAtTail(I64 mx, I64 bar, I64 len)
{//Whether a click at mx lands on the note's resize grip.
	I64 x0, wide;

	TrZoomInit;
	x0	 = TR_GRID_X + TR_ROLL_X + (bar - tr.view_top) * tr.roll_zx;
	wide = len * tr.roll_zx;
	//Never let the grip eat more than a third of a short note, or the same
	//problem comes back at a smaller size.
	return mx >= x0 + wide - MinI64(TR_ROLL_GRIP, MaxI64(1, wide / 3));
}

U0 TrRollSelClear()
{
	tr.sel_band = FALSE;
	tr.sel_r0 = -1;
	tr.sel_r1 = -1;
	tr.sel_n0 = 0;
	tr.sel_n1 = 0;
}

Bool TrRollSelHas(I64 row, I64 note)
{//Whether a note at this row and pitch is inside the selection.
	if (tr.sel_r0 < 0)
		return FALSE;

	return tr.sel_r0 <= row <= tr.sel_r1 && tr.sel_n0 <= note <= tr.sel_n1;
}

U0 TrRollSelSet(I64 r0, I64 n0, I64 r1, I64 n1)
{//Normalised, so a band dragged up or left reads the same as one dragged
//down or right.
	tr.sel_r0 = MinI64(r0, r1);
	tr.sel_r1 = MaxI64(r0, r1);
	tr.sel_n0 = MinI64(n0, n1);
	tr.sel_n1 = MaxI64(n0, n1);
}

U0 TrUndoPush(Bool force=FALSE)
{//Snapshot before a destructive edit. Oldest falls off the end.
//
//Edits close together in time collapse into ONE snapshot, the way
//DocCaptureUndo does it (src/System/DolDoc/DocFile.ZC:287-300). Typing a
//value is several keystrokes and a drag is many moves; one snapshot each is
//what an undo step should be, and without this a sixteen-deep ring is spent
//in a single gesture. force takes a snapshot regardless, for the start of a
//gesture that is about to make many changes.
	I64	 i, size = 0, now = TSCGet;
	U8	*buf;

	if (!force && tr.undo_n > 0 &&
		now < tr.undo_stamp + counts.time_stamp_freq)
		return;
	buf = TrSongToBuf(&size);
	if (!buf)
		return;
	tr.undo_stamp = now;
	if (tr.undo_n >= TR_UNDO)
	{
		Free(tr_undo[0]);
		for (i = 0; i < TR_UNDO - 1; i++)
		{
			tr_undo[i]		= tr_undo[i + 1];
			tr_undo_size[i]	= tr_undo_size[i + 1];
		}
		tr.undo_n = TR_UNDO - 1;
	}
	tr_undo[tr.undo_n]		= buf;
	tr_undo_size[tr.undo_n]	= size;
	tr.undo_n++;
}

U0 TrUndoPop()
{//Restore the newest snapshot. The mixer reads the song every block, so it
//has to be parked before the heap under it is replaced.
	I64	 size;
	U8	*buf;

	if (tr.undo_n < 1)
	{
		TrStatus("Nothing to undo");
		return;
	}
	tr.undo_n--;
	buf		= tr_undo[tr.undo_n];
	size	= tr_undo_size[tr.undo_n];
	tr_undo[tr.undo_n] = NULL;
	TrMixSuspend;
	TrSongLoadYTK3(buf, size);
	TrMixResume;
	Free(buf);
	TrRollSelClear;
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
	TrStatus("Undo, %d left", tr.undo_n);
}

U0 TrUndoFreeAll()
{
	I64 i;

	for (i = 0; i < TR_UNDO; i++)
	{
		if (tr_undo[i])
			Free(tr_undo[i]);
		tr_undo[i] = NULL;
	}
	tr.undo_n = 0;
}

U0 TrRollCopy()
{//Copy the selected rows. Cells outside the selected pitch band are left
//blank, so a copy of one voice out of a chord stays one voice.
	I64		 r, n;
	CTrCell	*c;

	if (tr.sel_r0 < 0)
		return;
	n = MinI64(tr.sel_r1 - tr.sel_r0 + 1, TR_CLIP_ROWS);
	MemSet(tr_clip, 0, sizeof(tr_clip));
	for (r = 0; r < n; r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, tr.sel_r0 + r);
		if (c && TrRollSelHas(tr.sel_r0 + r, c->note))
			MemCopy(&tr_clip[r], c, sizeof(CTrCell));
	}
	tr.clip_rows = n;
	tr.clip_note = tr.sel_n0;
	TrStatus("Copied %d rows", n);
}

U0 TrRollPaste()
{//Paste at the cursor, transposed by the distance between the pitch it was
//cut at and the pitch under the cursor's selection. Pasting onto the same
//band is therefore an exact copy.
	I64		 r, n, by = 0;
	CTrCell	*c;

	if (tr.clip_rows < 1)
	{
		TrStatus("Clipboard is empty");
		return;
	}
	TrUndoPush;
	if (tr.sel_r0 >= 0)
		by = tr.sel_n0 - tr.clip_note;
	for (r = 0; r < tr.clip_rows; r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row + r);
		if (c && tr_clip[r].note)
		{
			MemCopy(c, &tr_clip[r], sizeof(CTrCell));
			n = c->note + by;
			if (1 <= c->note <= TR_NOTES && 1 <= n <= TR_NOTES)
				c->note = n;
		}
	}
	TrStatus("Pasted %d rows", tr.clip_rows);
}

#define TR_PICK_MAX		64		//Entries a pick list will show.

U0 TrRollPickInst(CTrCell *c)
{//Choose the cell's instrument from a list of what the song actually holds.
//A number is not a name, and the instrument list is the one place the names
//live; typing 1F blind is only reasonable once you know what 1F is.
	I64	 i, n = 0, pick, slot[TR_PICK_MAX];
	U8	*buf, *p;

	if (!c)
		return;
	buf = MAlloc(TR_PICK_MAX * 48 + 2);
	if (!buf)
		return;
	p = buf;
	for (i = 1; i < TR_MAX_SAMPLES && n < TR_PICK_MAX; i++)
	{
		//Anything playable: an instrument record, or a bare sample where the
		//format has no instrument layer.
		if (i < TR_MAX_INSTRUMENTS && tr_inst[i] || tr_smp[i].data)
		{
			slot[n] = i;
			n++;
			if (i < TR_MAX_INSTRUMENTS && tr_inst[i] && tr_inst[i]->name[0])
				StrPrint(p, "%02X %s", i, tr_inst[i]->name);
			else if (tr_smp[i].name[0])
				StrPrint(p, "%02X %s", i, tr_smp[i].name);
			else
				StrPrint(p, "%02X", i);
			p += StrLen(p) + 1;
		}
	}
	*p = 0;			//PopUpPickList ends on the empty entry.
	if (!n)
	{
		Free(buf);
		TrStatus("No instruments to pick from");
		return;
	}
	pick = PopUpPickList(buf);
	Free(buf);
	//The pop-up took the focus with it.
	if (TaskValidate(tr.win_task))
		WinFocus(tr.win_task);
	if (0 <= pick < n)
	{
		TrUndoPush;
		TrRollFieldSet(c, TR_RF_INST, slot[pick]);
		TrStatus("Instrument %02X", slot[pick]);
	}
}

I64 TrRollSnap(I64 row)
{//Quantise a row to the snap grid. Snap 1 leaves it alone.
	if (tr.roll_snap < 2)
		return row;

	return row / tr.roll_snap * tr.roll_snap;
}

U0 TrRollSelDelete()
{//Clear every selected note. The selection survives, so a mistake can be
//re-selected rather than re-dragged.
	I64		 r;
	CTrCell	*c;

	if (tr.sel_r0 < 0)
		return;
	for (r = tr.sel_r0; r <= tr.sel_r1 && r < TrCurRows(); r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, r);
		if (c && TrRollSelHas(r, c->note))
			MemSet(c, 0, sizeof(CTrCell));
	}
}

U0 TrRollSelTranspose(I64 by)
{//Move every selected note by a number of semitones. Notes that would leave
//the range are left where they are rather than clamped into a pile at the
//end.
	I64		 r, n;
	CTrCell	*c;

	if (tr.sel_r0 < 0)
		return;
	for (r = tr.sel_r0; r <= tr.sel_r1 && r < TrCurRows(); r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, r);
		if (c && TrRollSelHas(r, c->note))
		{
			n = c->note + by;
			if (1 <= n <= TR_NOTES)
				c->note = n;
		}
	}
	tr.sel_n0 = ClampI64(tr.sel_n0 + by, 1, TR_NOTES);
	tr.sel_n1 = ClampI64(tr.sel_n1 + by, 1, TR_NOTES);
}

U0 TrChanLabel(I64 ch, U8 *dst, I64 cap)
{//What to show beside CH01. A channel NAME when the format carries one, which
//only FTM does; otherwise the name of whatever last sounded on the channel,
//which is the nearest answer the other formats can give to "what is this".
//
//Taken from the last thing triggered rather than from what is audible right
//now, so the label holds still between notes instead of blinking out at every
//gap.
	CTrChan	*c;
	U8		*s = NULL;
	I64		 n;

	dst[0] = 0;
	if (ch < 0 || ch >= TR_MAX_VOICES || cap < 2)
		return;
	if (ch < TR_MAX_CHANNELS && tr_chan_name[ch][0])
		s = tr_chan_name[ch];
	else
	{
		c = &tr_ch[ch];
		//The instrument names the voice; the sample only names the waveform
		//under it, so it is the fallback.
		if (0 < c->inst < TR_MAX_INSTRUMENTS && tr_inst[c->inst] &&
			tr_inst[c->inst]->name[0])
			s = tr_inst[c->inst]->name;
		else if (0 < c->smp_idx < TR_MAX_SAMPLES && tr_smp[c->smp_idx].name[0])
			s = tr_smp[c->smp_idx].name;
	}
	if (!s)
		return;
	//No bounded StrCopy in this kernel, so the clamp is done here.
	n = StrLen(s);
	if (n > cap - 1)
		n = cap - 1;
	MemCopy(dst, s, n);
	dst[n] = 0;
	//MOD and S3M pad their names with spaces, and IT with anything at all
	//past the terminator. Trailing blanks would push the label off centre and
	//draw a box of nothing.
	n = StrLen(dst);
	while (n > 0 && dst[n - 1] <= CH_SPACE)
	{
		n--;
		dst[n] = 0;
	}
}

I64 TrCellInst(CTrCell *c)
{//Which instrument to sound a cell with. Its own, or the editor's when the
//cell carries none.
	if (c && c->inst)
		return c->inst;

	return tr.inst;
}

I64 TrRollLen(I64 pat, I64 ch, I64 row, I64 rows)
{//How long the note at this row sounds: until the next note, note-off or cut
//on the same channel. That is what a note's length IS in a tracker; there is
//no stored duration.
	CTrCell	*c;
	I64		 r, n = 1;

	for (r = row + 1; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && c->note)
			break;
		n++;
	}

	return n;
}

I64 TrRollNoteRow(I64 pat, I64 ch, I64 row, I64 note, I64 rows)
{//Row of the note whose block covers this row at this pitch, or -1. A note's
//block runs from its own row until the next note event, so this walks back
//to the nearest note and checks it is the right pitch and still sounding.
	CTrCell	*c;
	I64		 r;

	for (r = row; r >= 0; r--)
	{
		c = TrCell(pat, ch, r);
		if (c && c->note)
		{
			if (c->note != note)
				return -1;		//A different note owns this stretch.
			if (r + TrRollLen(pat, ch, r, rows) <= row)
				return -1;
			return r;
		}
	}

	return -1;
}

U0 TrRollSetLen(I64 pat, I64 ch, I64 row, I64 len, I64 rows)
{//Give the note at row the length len by placing a note-off after it. A cell
//stores no duration, so length IS the gap to the next event; writing one is
//the only way to shorten a note.
//
//A note can never grow past the next note on its channel. Sweeping the whole
//dragged span would clear note-offs belonging to LATER notes and silently
//change their lengths too, so the reach stops at the first real note and the
//drag simply refuses to go further.
	CTrCell	*c;
	I64		 r, end, wall = rows;

	if (len < 1)
		len = 1;
	for (r = row + 1; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && c->note && c->note != TR_NOTE_OFF && c->note != TR_NOTE_CUT)
		{
			wall = r;
			break;
		}
	}
	end = MinI64(row + len, wall);
	//Clear the note-off this note owned, so dragging longer works. Bounded by
	//the wall, so no other note's ending is touched.
	for (r = row + 1; r < end; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && (c->note == TR_NOTE_OFF || c->note == TR_NOTE_CUT) && !c->inst)
			MemSet(c, 0, sizeof(CTrCell));
	}
	if (end >= rows || end >= wall)
		return;		//Butts against the next note: its own start ends this one.
	c = TrCell(pat, ch, end);
	if (c && !c->note)
		c->note = TR_NOTE_OFF;
}

U0 TrRollBand(I64 row0, I64 note0)
{//Shift-drag on the roll sweeps a selection. Polls for the same reason the
//other drags do: MS_MOVE delivery is not guaranteed and a blocking wait
//would hang the app.
	I64	 msg, a1, a2, row, note, guard = 0;
	Bool done = FALSE;

	TrRollSelSet(row0, note0, row0, note0);
	tr.sel_band = TRUE;
	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard	= 0;
			row		= ClampI64(TrRollRowAt(a1), 0, TrCurRows() - 1);
			note	= ClampI64(TrRollNoteAt(a2), 1, TR_NOTES);
			TrRollSelSet(row0, note0, row, note);
		}
	}
	//Release takes the box away; what it caught stays lit.
	tr.sel_band = FALSE;
}

U0 TrRollSelMove(I64 row0, I64 note0)
{//Drag every selected note together. Each step restores the channel as it was
//before the gesture and re-lays the selection at the current offset, rather
//than nudging cells one row at a time: a row holds one note, so an
//incremental shift would have notes overwrite each other halfway across and
//the result would depend on the direction the pointer travelled.
	CTrCell	*orig, *c, *d;
	I64		 msg, a1, a2, rows = TrCurRows(), row, note, r, dr, dn, guard = 0;
	I64		 r0 = tr.sel_r0, r1 = tr.sel_r1, n0 = tr.sel_n0, n1 = tr.sel_n1;
	Bool	 done = FALSE;

	orig = MAlloc(rows * sizeof(CTrCell));
	if (!orig)
		return;
	for (r = 0; r < rows; r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, r);
		if (c)
			MemCopy(&orig[r], c, sizeof(CTrCell));
	}
	TrUndoPush(TRUE);
	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard	= 0;
			row		= TrRollSnap(TrRollRowAt(a1));
			note	= TrRollNoteAt(a2);
			dr		= row - row0;
			dn		= note - note0;
			//Keep the whole block on the pattern and in range; clamping each
			//note on its own would collapse a chord onto one pitch.
			dr = ClampI64(dr, -r0, rows - 1 - r1);
			dn = ClampI64(dn, 1 - n0, TR_NOTES - n1);
			for (r = 0; r < rows; r++)
			{
				c = TrCell(tr.cur_pat, tr.cur_ch, r);
				if (c)
					MemCopy(c, &orig[r], sizeof(CTrCell));
			}
			//Lift the selection out, then drop it at the offset.
			for (r = r0; r <= r1 && r < rows; r++)
				if (n0 <= orig[r].note <= n1)
				{
					c = TrCell(tr.cur_pat, tr.cur_ch, r);
					if (c)
						MemSet(c, 0, sizeof(CTrCell));
				}
			for (r = r0; r <= r1 && r < rows; r++)
				if (n0 <= orig[r].note <= n1)
				{
					d = TrCell(tr.cur_pat, tr.cur_ch, r + dr);
					if (d)
					{
						MemCopy(d, &orig[r], sizeof(CTrCell));
						d->note = ClampI64(orig[r].note + dn, 1, TR_NOTES);
					}
				}
			TrRollSelSet(r0 + dr, n0 + dn, r1 + dr, n1 + dn);
		}
	}
	Free(orig);
	TrPreviewStop;
}

U0 TrRollDrag(I64 row0, I64 note0, Bool resize)
{//Hold the button to move a note or drag its tail.
//
//Polls rather than blocking on MessageGet: whether this window is delivered
//MS_MOVE depends on how it was spawned, and a blocking wait for a message
//that never comes would hang the app. The guard caps the wait at about ten
//seconds, so the worst case is a stall and a click that behaved like a click.
	CTrCell	*src, *dst;
	CTrCell	 held;
	I64		 msg, a1, a2, rows = TrCurRows(), row, note, len;
	I64		 last_row, last_note, guard = 0;
	Bool	 done = FALSE;

	src = TrCell(tr.cur_pat, tr.cur_ch, row0);
	if (!src || !src->note)
		return;
	//Before the gesture, not during it: the drag makes many edits and they
	//are one undo step.
	TrUndoPush(TRUE);
	MemCopy(&held, src, sizeof(CTrCell));
	len			= TrRollLen(tr.cur_pat, tr.cur_ch, row0, rows);
	last_row	= row0;
	last_note	= note0;
	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard	= 0;
			//Snap both the tail and the move, so a quantised note keeps a
			//quantised length.
			row		= TrRollSnap(TrRollRowAt(a1));
			note	= TrRollNoteAt(a2);
			if (resize)
			{
				if (last_row <= row < rows)
					TrRollSetLen(tr.cur_pat, tr.cur_ch, last_row,
								 row - last_row + 1, rows);
			}
			else if (0 <= row < rows && 1 <= note <= TR_NOTES &&
					 (row != last_row || note != last_note))
			{//Lift the cell, drop it on the new row, keep the length.
				src = TrCell(tr.cur_pat, tr.cur_ch, last_row);
				dst = TrCell(tr.cur_pat, tr.cur_ch, row);
				//A row carries one note per channel, so there is nowhere for
				//a second to go: landing on an occupied row overwrites what
				//is there, and the next step of the drag then blanks it. A
				//pointer swept across the pattern erased everything it
				//passed. The drag sticks against a note instead.
				//
				//A note-off or cut is an ENDING, not a note, and belongs to
				//whatever precedes it; moving over one is fine.
				if (dst && dst->note && dst->note != TR_NOTE_OFF &&
					dst->note != TR_NOTE_CUT && row != last_row)
					dst = NULL;
				if (src && dst)
				{
					if (last_row != row)
						MemSet(src, 0, sizeof(CTrCell));
					MemCopy(dst, &held, sizeof(CTrCell));
					dst->note	= note;
					//Dragging across pitches sounds each one, so the roll can
					//be played by ear rather than read.
					if (note != last_note)
						TrPreview(note, TrCellInst(dst), tr.vol_default);
					last_row	= row;
					last_note	= note;
					tr.cur_row	= row;
					TrRollSetLen(tr.cur_pat, tr.cur_ch, row, len, rows);
				}
			}
		}
	}
	//Releasing ends the audition. Both roll click paths come through here, so
	//this one stop covers the click, the hold and the drag; the guard
	//timeout exits the same way.
	TrPreviewStop;
}

//Arrangement geometry: lanes stack downward, order positions run rightward.
I64 tr_arr_lanes = 8;			//Lanes visible, set by the last draw.
I64 tr_arr_cols	 = 16;

U0 TrMixStrip(CDC *dc, I64 x, I64 y, I64 ch)
{//One channel strip. Drawn only when the lane is tall enough to hold it.
	I64 n, px, vx = x + TR_MIX_X, py = x + TR_MIX_X + TR_MIX_VW + 8;

	//Volume groove, peak behind, fader fill in front. The peak sits behind so
	//a channel that is playing reads as a lit fader rather than a second bar
	//competing for the same space.
	dc->color = de_theme.panel_edge;
	GrRect(dc, vx, y, TR_MIX_VW, TR_MIX_H);
	n = ClampI64(tr_ch[ch].peak * TR_MIX_VW / 32768, 0, TR_MIX_VW);
	if (n > 0)
	{
		dc->color = de_theme.accent_dim;
		GrRect(dc, vx, y, n, TR_MIX_H);
	}
	n = ClampI64(tr_chan_gain[ch] * TR_MIX_VW / 64, 0, TR_MIX_VW);
	if (tr_ch[ch].mute)
		dc->color = de_theme.text_dim;
	else
		dc->color = de_theme.accent;
	GrRect(dc, vx, y + TR_MIX_H - 3, n, 3);

	//Pan: centre tick, handle, and the offset in words. 0 is no shift.
	dc->color = de_theme.panel_edge;
	GrRect(dc, py, y + 2, TR_MIX_PW, 3);
	dc->color = de_theme.text_dim;
	GrRect(dc, py + TR_MIX_PW / 2, y, 1, TR_MIX_H);
	px = ClampI64((tr_chan_pan_ofs[ch] + 128) * (TR_MIX_PW - 4) / 255, 0,
				  TR_MIX_PW - 4);
	n = tr_chan_pan_ofs[ch];
	if (n)
		dc->color = de_theme.accent2;
	else
		dc->color = de_theme.text_dim;
	GrRect(dc, py + px, y, 4, TR_MIX_H);
	//Scaled to 0..64 so it reads as a throw rather than as a raw pan byte.
	if (n < 0)
		GrPrint(dc, py + TR_MIX_PW + 4, y, "L%02d", -n * 64 / 128);
	else if (n > 0)
		GrPrint(dc, py + TR_MIX_PW + 4, y, "R%02d", n * 64 / 128);
	else
		GrPrint(dc, py + TR_MIX_PW + 4, y, "C");
}

Bool TrMixStripHit(I64 mx, I64 my, I64 ch, I64 lane_y)
{//Set volume or pan from a click inside the strip. Returns whether the click
//landed on either control; the caller falls back to mute otherwise.
	I64 y = lane_y + TR_MIX_Y, vx = TR_GRID_X + TR_MIX_X;
	I64 py = vx + TR_MIX_VW + 8, n;

	if (ch < 0 || ch >= TR_MAX_VOICES || tr.arr_zy < TR_MIX_Y + TR_MIX_H + 2)
		return FALSE;
	if (my < y || my >= y + TR_MIX_H)
		return FALSE;
	if (vx <= mx < vx + TR_MIX_VW)
	{
		tr_chan_gain[ch] = ClampI64((mx - vx) * 64 / TR_MIX_VW, 0, 64);
		return TRUE;
	}
	if (py <= mx < py + TR_MIX_PW)
	{
		n = ClampI64((mx - py) * 255 / (TR_MIX_PW - 4) - 128, -128, 127);
		if (-TR_MIX_SNAP < n < TR_MIX_SNAP)
			n = 0;
		tr_chan_pan_ofs[ch] = n;
		return TRUE;
	}

	return FALSE;
}

U0 TrChanSolo(I64 ch)
{//Solo, as a toggle against the current mute state. Already-soloed means
//every other channel is muted and this one is not, and the way out of that is
//to unmute everything rather than to mute this one.
	I64	 i;
	Bool soloed = TRUE;

	if (ch < 0 || ch >= tr_song.channels)
		return;
	for (i = 0; i < tr_song.channels; i++)
		if (tr_ch[i].mute == (i == ch))
			soloed = FALSE;
	for (i = 0; i < tr_song.channels; i++)
		tr_ch[i].mute = !soloed && i != ch;
}

U0 TrMixDrag(I64 ch, I64 lane_y)
{//Hold a fader. Same poll-with-guard shape as the clip drag: MS_MOVE is not
//guaranteed, so a blocking wait would hang the app. The y stays pinned to the
//row the drag started on, so sliding off the strip vertically does not drop
//it, which is what a fader does.
	I64	 msg, a1, a2, guard = 0, y = lane_y + TR_MIX_Y;
	Bool done = FALSE;

	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard = 0;
			TrMixStripHit(a1, y, ch, lane_y);
		}
	}
}

I64 TrArrLaneAt(I64 my)
{
	I64 k;

	TrZoomInit;
	k = (my - TR_GRID_Y) / tr.arr_zy;

	if (k < 0 || k >= tr_arr_lanes)
		return -1;

	return tr.arr_top + k;
}

I64 TrArrPosAt(I64 mx)
{
	TrZoomInit;
	if (mx < TR_GRID_X + TR_ARR_X)
		return -1;

	return tr.arr_left + (mx - TR_GRID_X - TR_ARR_X) / tr.arr_zx;
}

I64 TrArrNotes(I64 pat, I64 ch)
{//How many notes a clip holds. Drawn as a fill level so a lane reads as
//activity at a glance rather than as a wall of identical boxes.
	I64		 r, n = 0, rows;
	CTrCell	*c;

	if (pat < 0 || pat >= TR_MAX_PATTERNS || !tr_pat[pat])
		return 0;
	rows = tr_pat_rows[pat];
	for (r = 0; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && 1 <= c->note <= TR_NOTES)
			n++;
	}

	return n;
}

I64 TrArrClipSample(I64 pat, I64 ch)
{//The one sample a clip plays, or 0 if it plays more than one. Drawing a
//waveform for a clip that mixes samples would be picking one arbitrarily and
//calling it the clip's shape.
	CTrCell	*c;
	I64		 r, rows, smp, note, only = 0;

	if (pat < 0 || pat >= TR_MAX_PATTERNS || !tr_pat[pat])
		return 0;
	rows = tr_pat_rows[pat];
	for (r = 0; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && 1 <= c->note <= TR_NOTES)
		{
			smp = TrInstSample(TrCellInst(c), c->note, &note);
			if (smp > 0)
			{
				if (!only)
					only = smp;
				else if (only != smp)
					return 0;
			}
		}
	}

	return only;
}

U0 TrArrClipDraw(CDC *dc, I64 pat, I64 ch, I64 x, I64 y, I64 w, I64 h)
{//One clip's contents. Notes are placed by pitch within the range the clip
//actually uses, not the full 120, so a bass part fills its box rather than
//hugging the floor.
	CTrCell	*c;
	I64		 r, rows, lo = TR_NOTES, hi = 1, n = 0, span, px, py, pw;

	if (pat < 0 || pat >= TR_MAX_PATTERNS || !tr_pat[pat] || w < 2 || h < 2)
		return;
	rows = tr_pat_rows[pat];
	for (r = 0; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && 1 <= c->note <= TR_NOTES)
		{
			if (c->note < lo)
				lo = c->note;
			if (c->note > hi)
				hi = c->note;
			n++;
		}
	}
	if (!n)
		return;
	if (h < 8)
	{//Too short to place a pitch: show how busy it is instead.
		n = ClampI64(n * h / MaxI64(1, rows / 2), 1, h);
		dc->color = de_theme.accent;
		GrRect(dc, x, y + h - n, w, n);
		return;
	}
	span = hi - lo;
	if (span < 1)
		span = 1;
	pw = MaxI64(1, w / MaxI64(1, rows));
	dc->color = de_theme.accent;
	for (r = 0; r < rows; r++)
	{
		c = TrCell(pat, ch, r);
		if (c && 1 <= c->note <= TR_NOTES)
		{
			px = x + r * w / rows;
			py = y + h - 1 - (c->note - lo) * (h - 1) / span;
			GrRect(dc, px, py, pw, 1);
		}
	}
}

U0 TrArrSet(I64 pos, I64 ch, I64 pat)
{//Point one lane at one pattern for one order position. Writing the shared
//value clears the override, so a song only carries an arrangement where it
//actually differs.
	if (pos < 0 || pos >= TR_ORDER_MAX || ch < 0 || ch >= TR_MAX_CHANNELS)
		return;
	if (pat == tr_song.order[pos])
		tr_order_ch[pos][ch] = TR_ORDER_FOLLOW;
	else
		tr_order_ch[pos][ch] = ClampI64(pat, 0, TR_MAX_PATTERNS - 1);
}

U0 TrArrDrag(I64 pos0, I64 ch0, Bool clone)
{//Hold to drag a clip to another position or lane. Polls rather than blocking
//for the same reason the roll's drag does: MS_MOVE delivery is not guaranteed
//and a blocking wait would hang the app.
//
//Clips are aliases: two positions holding the same pattern number are one
//pattern, and editing either edits both. clone copies the pattern first, so
//the dragged copy is independent and the source keeps playing what it did.
	I64	 msg, a1, a2, pos, ch, pat, guard = 0;
	I64	 last_pos = pos0, last_ch = ch0;
	Bool done = FALSE, moved = FALSE;

	pat = TrPatternForOrderCh(pos0, ch0);
	if (clone)
		pat = TrPatternClone(pat);
	while (!done && guard < 1000)
	{
		msg = MessageScan(&a1, &a2);
		if (!msg)
		{
			Sleep(10);
			guard++;
		}
		else if (msg == MESSAGE_MS_L_UP)
			done = TRUE;
		else if (msg == MESSAGE_MS_MOVE)
		{
			guard	= 0;
			pos		= TrArrPosAt(a1);
			ch		= TrArrLaneAt(a2);
			if (0 <= pos < tr_song.order_len && 0 <= ch < tr_song.channels &&
				(pos != last_pos || ch != last_ch))
			{
				//Vacate the old cell, then claim the new one. A clone never
				//vacates the cell it started from: that one keeps the
				//original and only the copy travels.
				if (!clone || last_pos != pos0 || last_ch != ch0)
					TrArrSet(last_pos, last_ch, tr_song.order[last_pos]);
				moved = TRUE;
				TrArrSet(pos, ch, pat);
				last_pos		= pos;
				last_ch			= ch;
				tr.order_sel	= pos;
				tr.arr_ch		= ch;
			}
		}
	}
	//A ctrl-click that never moved un-aliases the clip where it sits, which
	//is the only way to make one position of a repeated pattern editable on
	//its own.
	if (clone && !moved)
		TrArrSet(pos0, ch0, pat);
}

U0 TrDrawArr(CDC *dc, I64 w, I64 play_ord)
{//Channels as lanes down the screen, the order list as time across it. Each
//clip names the pattern that lane plays at that position; the tracker grid
//shows the same song read the other way round.
	I64	 lane, col, ch, pos, x, y, pat, n;
	U8	 buf[16];

	TrZoomInit;
	tr_arr_lanes = ClampI64((TrSeekY() - TR_GRID_Y - 4) / tr.arr_zy,
							1, TR_MAX_CHANNELS);
	tr_arr_cols	 = ClampI64((w - TR_GRID_X - TR_ARR_X - 8) / tr.arr_zx,
							1, TR_ORDER_MAX);
	tr.arr_ch	 = ClampI64(tr.arr_ch, 0, tr_song.channels - 1);
	if (tr.arr_ch < tr.arr_top)
		tr.arr_top = tr.arr_ch;
	if (tr.arr_ch >= tr.arr_top + tr_arr_lanes)
		tr.arr_top = tr.arr_ch - tr_arr_lanes + 1;
	tr.arr_top	= ClampI64(tr.arr_top, 0,
						   MaxI64(0, tr_song.channels - tr_arr_lanes));
	if (tr.order_sel < tr.arr_left)
		tr.arr_left = tr.order_sel;
	if (tr.order_sel >= tr.arr_left + tr_arr_cols)
		tr.arr_left = tr.order_sel - tr_arr_cols + 1;
	tr.arr_left	= ClampI64(tr.arr_left, 0,
						   MaxI64(0, tr_song.order_len - tr_arr_cols));

	dc->color = de_theme.accent;
	GrPrint(dc, 12, TR_GRID_Y - 14, "arrangement");

	//Position ruler.
	for (col = 0; col < tr_arr_cols; col++)
	{
		pos = tr.arr_left + col;
		if (pos >= tr_song.order_len)
			break;
		x = TR_GRID_X + TR_ARR_X + col * tr.arr_zx;
		if (pos == play_ord && tr.playing)
			dc->color = de_theme.accent2;
		else if (pos == tr.order_sel)
			dc->color = de_theme.text;
		else
			dc->color = de_theme.text_dim;
		GrPrint(dc, x + 2, TR_GRID_Y - 14, "%02X", pos);
	}

	for (lane = 0; lane < tr_arr_lanes; lane++)
	{
		ch = tr.arr_top + lane;
		if (ch >= tr_song.channels)
			break;
		y = TR_GRID_Y + lane * tr.arr_zy;
		//Lane header: name, mute state, selection.
		if (ch == tr.arr_ch)
			dc->color = de_theme.bttn_focus;
		else
			dc->color = de_theme.panel;
		GrRect(dc, TR_GRID_X, y, TR_ARR_X - 2, tr.arr_zy - 2);
		if (tr_ch[ch].mute)
			dc->color = de_theme.text_dim;
		else
			dc->color = de_theme.text;
		StrPrint(buf, "CH%02d", ch + 1);
		GrPrint(dc, TR_GRID_X + 4, y + 4, "%s", buf);
		TrChanLabel(ch, buf, 16);
		if (buf[0])
		{
			dc->color = de_theme.text_dim;
			GrPrint(dc, TR_GRID_X + 44, y + 4, "%s", buf);
		}
		//The strip needs a row of its own below the name. A lane zoomed
		//shorter than that keeps the name and loses the faders.
		if (tr.arr_zy >= TR_MIX_Y + TR_MIX_H + 2)
			TrMixStrip(dc, TR_GRID_X, y + TR_MIX_Y, ch);
		else if (tr_ch[ch].mute)
		{
			dc->color = de_theme.text_dim;
			GrPrint(dc, TR_GRID_X + 100, y + 4, "mute");
		}

		for (col = 0; col < tr_arr_cols; col++)
		{
			pos = tr.arr_left + col;
			if (pos >= tr_song.order_len)
				break;
			x	= TR_GRID_X + TR_ARR_X + col * tr.arr_zx;
			pat	= TrPatternForOrderCh(pos, ch);
			//A clip that differs from the shared order is the arrangement
			//doing something, so it reads in the secondary accent.
			if (tr_order_ch[pos][ch] != TR_ORDER_FOLLOW)
				dc->color = de_theme.accent2_dim;
			else
				dc->color = de_theme.panel;
			GrRect(dc, x + 1, y + 1, tr.arr_zx - 3, tr.arr_zy - 4);
			//The clip's own notes, pitch against time inside the box, the
			//way a DAW previews a MIDI clip. Below about 12 pixels of lane
			//there is no room to place a pitch, so it falls back to a
			//density bar, which still shows where the music is.
			TrArrClipDraw(dc, pat, ch, x + 1, y + 2, tr.arr_zx - 3,
						  tr.arr_zy - 5);
			//A lane playing one sample throughout is an audio clip in all
			//but name, so it gets drawn as one. Mixed-sample clips keep the
			//pitch preview above, which says more about them than any one
			//waveform would.
			if (tr.arr_zy >= 34 && tr.arr_zx >= 24)
			{
				n = TrArrClipSample(pat, ch);
				if (n > 0)
				{
					dc->color = de_theme.accent_dim;
					TrWaveInto(dc, x + 2, y + tr.arr_zy - 14,
							   tr.arr_zx - 5, 10, n);
				}
			}
			if (pos == tr.order_sel && ch == tr.arr_ch)
			{
				dc->color = de_theme.text;
				GrRect(dc, x, y, tr.arr_zx - 1, 1);
				GrRect(dc, x, y + tr.arr_zy - 3, tr.arr_zx - 1, 1);
			}
			dc->color = de_theme.text;
			GrPrint(dc, x + 4, y + 6, "%02X", pat);
		}
	}

	//Playhead down the whole arrangement.
	if (tr.playing && tr.arr_left <= play_ord < tr.arr_left + tr_arr_cols)
	{
		dc->color = de_theme.accent2;
		GrRect(dc, TR_GRID_X + TR_ARR_X +
			   (play_ord - tr.arr_left) * tr.arr_zx, TR_GRID_Y, 2,
			   tr_arr_lanes * tr.arr_zy);
	}
}

U0 TrRollCenter()
{//Put the cursor's note, or the first note in the channel, in the middle.
	CTrCell	*c;
	I64		 r, note = 0, rows = TrCurRows();

	c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
	if (c && 1 <= c->note <= TR_NOTES)
		note = c->note;
	else
		for (r = 0; r < rows && !note; r++)
		{
			c = TrCell(tr.cur_pat, tr.cur_ch, r);
			if (c && 1 <= c->note <= TR_NOTES)
				note = c->note;
		}
	if (!note)
		note = 49;			//C-4, the middle of the written range.
	tr.roll_top = ClampI64(note - tr_roll_keys / 2, 1,
						   MaxI64(1, TR_NOTES - tr_roll_keys));
}

Bool TrArrKey(I64 sc, Bool shift)
{//Keys the arrangement view claims. Returns TRUE when it consumed one, so
//the pattern editor never sees it. No ctrl: cloning a clip is a ctrl-DRAG,
//handled on the mouse path.
	I64 pat;

	if (tr.view_mode != TR_VIEW_ARR)
		return FALSE;
	switch (sc)
	{
		case SC_CURSOR_UP:
			tr.arr_ch = ClampI64(tr.arr_ch - 1, 0, tr_song.channels - 1);
			return TRUE;
		case SC_CURSOR_DOWN:
			tr.arr_ch = ClampI64(tr.arr_ch + 1, 0, tr_song.channels - 1);
			return TRUE;
		case SC_CURSOR_LEFT:
			tr.order_sel = ClampI64(tr.order_sel - 1, 0,
									MaxI64(0, tr_song.order_len - 1));
			return TRUE;
		case SC_CURSOR_RIGHT:
			tr.order_sel = ClampI64(tr.order_sel + 1, 0,
									MaxI64(0, tr_song.order_len - 1));
			return TRUE;
		case SC_PAGE_UP:
			//Change which pattern the selected clip plays.
			pat = TrPatternForOrderCh(tr.order_sel, tr.arr_ch);
			TrArrSet(tr.order_sel, tr.arr_ch,
					 ClampI64(pat + 1, 0, TR_MAX_PATTERNS - 1));
			return TRUE;
		case SC_PAGE_DOWN:
			pat = TrPatternForOrderCh(tr.order_sel, tr.arr_ch);
			TrArrSet(tr.order_sel, tr.arr_ch,
					 ClampI64(pat - 1, 0, TR_MAX_PATTERNS - 1));
			return TRUE;
		case SC_DELETE:
			//Back to whatever the shared order list says.
			tr_order_ch[tr.order_sel][tr.arr_ch] = TR_ORDER_FOLLOW;
			return TRUE;
		case SC_HOME:
			//Zoom, for anyone without a wheel. Shift takes the vertical.
			TrZoomInit;
			if (shift)
				tr.arr_zy = ClampI64(tr.arr_zy + 4, TR_ARR_LANEH_MIN,
									 TR_ARR_LANEH_MAX);
			else
				tr.arr_zx = ClampI64(tr.arr_zx + 8, TR_ARR_CLIPW_MIN,
									 TR_ARR_CLIPW_MAX);
			return TRUE;
		case SC_END:
			TrZoomInit;
			if (shift)
				tr.arr_zy = ClampI64(tr.arr_zy - 4, TR_ARR_LANEH_MIN,
									 TR_ARR_LANEH_MAX);
			else
				tr.arr_zx = ClampI64(tr.arr_zx - 8, TR_ARR_CLIPW_MIN,
									 TR_ARR_CLIPW_MAX);
			return TRUE;
	}

	return FALSE;
}

U0 TrWheel(I64 d, Bool shift, Bool ctrl)
{//One wheel notch. Plain scrolls, Shift moves the other axis, Ctrl zooms,
//which is what a DAW binds them to.
//
//Every scroll case negates d; the zoom cases do not. mouse.pos.z counts the
//other way from what the scroll axes here want, but zoom already reads the
//way round it should, so the sign is per case rather than applied once to d.
//roll_top is the LOWEST note drawn, so it moves opposite the others to scroll
//the view the same way.
	TrZoomInit;
	if (tr.view_mode == TR_VIEW_ARR)
	{
		if (ctrl)
		{
			if (shift)
				tr.arr_zy = ClampI64(tr.arr_zy + d * 2, TR_ARR_LANEH_MIN,
									 TR_ARR_LANEH_MAX);
			else
				tr.arr_zx = ClampI64(tr.arr_zx + d * 4, TR_ARR_CLIPW_MIN,
									 TR_ARR_CLIPW_MAX);
		}
		else if (shift)
			tr.order_sel = ClampI64(tr.order_sel + d, 0,
									MaxI64(0, tr_song.order_len - 1));
		else
			tr.arr_ch = ClampI64(tr.arr_ch + d, 0, tr_song.channels - 1);
		return;
	}
	if (tr.view_mode == TR_VIEW_ROLL)
	{
		if (ctrl)
		{
			if (shift)
				tr.roll_zy = ClampI64(tr.roll_zy + d, TR_ROLL_KEYH_MIN,
									  TR_ROLL_KEYH_MAX);
			else
				tr.roll_zx = ClampI64(tr.roll_zx + d * 2, TR_ROLL_COLW_MIN,
									  TR_ROLL_COLW_MAX);
		}
		else if (shift)
			tr.cur_row = ClampI64(tr.cur_row + d * 4, 0, TrCurRows() - 1);
		else
			tr.roll_top = ClampI64(tr.roll_top - d, 1,
								   MaxI64(1, TR_NOTES - tr_roll_keys));
		return;
	}
	//Pattern grid: rows, or channels with Shift.
	if (shift)
		tr.cur_ch = ClampI64(tr.cur_ch + d, 0, tr_song.channels - 1);
	else
		tr.cur_row = ClampI64(tr.cur_row + d * 4, 0, TrCurRows() - 1);
}

U0 TrWheelPoll()
{//No message carries the wheel: mouse.pos.z ACCUMULATES it, so the change
//since the last look is the notch count. Called from the app loop.
	I64	 z = mouse.pos.z, d;
	Bool shift, ctrl;

	if (z == tr.wheel_last)
		return;
	d = z - tr.wheel_last;
	tr.wheel_last = z;
	shift = Bt(kbd.down_bitmap, SC_SHIFT) != 0;
	ctrl  = Bt(kbd.down_bitmap, SC_CTRL) != 0;
	TrWheel(ClampI64(d, -8, 8), shift, ctrl);
}

U0 TrViewSet(I64 mode)
{//One song, three readings of it: the grid is cells, the arrangement is which
//pattern each lane plays when, the roll is pitch against time. Nothing is
//converted; each draws the same patterns.
	tr.view_mode = mode;
	if (mode == TR_VIEW_ROLL)
		TrRollCenter;
}

U0 TrViewToggle()
{//Cycle grid, arrangement, roll. The header button names the next one.
	if (tr.view_mode == TR_VIEW_GRID)
		TrViewSet(TR_VIEW_ARR);
	else if (tr.view_mode == TR_VIEW_ARR)
		TrViewSet(TR_VIEW_ROLL);
	else
		TrViewSet(TR_VIEW_GRID);
}

U0 TrDrawRoll(CDC *dc, I64 w, I64 play_row, I64 play_pat)
{//The current pattern and channel as pitch against time. Same cells as the
//grid: this is a second reading of the song, not a second copy of it.
	I64		 rows = TrCurRows(), i, k, r, note, x, y, len, cols;
	CTrCell	*c;
	U8		 buf[16];
	Bool	 lit;

	TrZoomInit;
	tr_roll_keys = ClampI64((TrRollPanelY() - TR_GRID_Y - 4) / tr.roll_zy,
							4, TR_NOTES);
	cols = ClampI64((w - TR_GRID_X - TR_ROLL_X - 8) / tr.roll_zx, 1,
					TR_MAX_ROWS);
	//Follow the tracker cursor so switching views keeps your place.
	if (tr.cur_row < tr.view_top)
		tr.view_top = tr.cur_row;
	if (tr.cur_row >= tr.view_top + cols)
		tr.view_top = tr.cur_row - cols + 1;
	tr.view_top = ClampI64(tr.view_top, 0, MaxI64(0, rows - cols));
	tr.roll_top = ClampI64(tr.roll_top, 1, TR_NOTES - tr_roll_keys);

	StrPrint(buf, "CH%02d", tr.cur_ch + 1);
	dc->color = de_theme.accent;
	GrPrint(dc, 12, TR_GRID_Y - 14, "%s  piano roll", buf);

	//Keyboard gutter and the lane stripes it labels.
	for (k = 0; k < tr_roll_keys; k++)
	{
		note = tr.roll_top + tr_roll_keys - 1 - k;
		y	 = TR_GRID_Y + k * tr.roll_zy;
		if (TrRollBlack(note))
			dc->color = de_theme.win_bg;
		else
			dc->color = de_theme.panel;
		GrRect(dc, TR_GRID_X, y, w - TR_GRID_X - 8, tr.roll_zy - 1);
		if (TrRollBlack(note))
			dc->color = de_theme.panel_edge;
		else
			dc->color = de_theme.text_dim;
		GrRect(dc, TR_GRID_X, y, TR_ROLL_X - 2, tr.roll_zy - 1);
		//Octave boundaries carry the label; anything closer is unreadable.
		if ((note - 1) % 12 == 0)
		{
			dc->color = de_theme.text;
			GrPrint(dc, TR_GRID_X + 2, y, "C%d", (note - 1) / 12);
		}
	}

	//Bar lines every four rows, in the secondary accent every sixteen.
	for (r = 0; r < cols; r++)
	{
		i = tr.view_top + r;
		x = TR_GRID_X + TR_ROLL_X + r * tr.roll_zx;
		if (i % 4 == 0)
		{
			if (i % 16 == 0)
				dc->color = de_theme.accent2_dim;
			else
				dc->color = de_theme.panel_edge;
			GrRect(dc, x, TR_GRID_Y, 1, tr_roll_keys * tr.roll_zy);
		}
	}

	//Ghost notes: every other channel, dimmed. A single-channel roll hides the
	//harmony you are writing against, which is the main thing a DAW view is
	//for. Not clickable; the current channel owns the pointer. On a crowded
	//song they are noise rather than context, so they switch off.
	for (i = 0; i < tr_song.channels && tr.roll_ghosts; i++)
	{
		if (i != tr.cur_ch)
		for (r = tr.view_top; r < rows && r < tr.view_top + cols; r++)
		{
			c = TrCell(tr.cur_pat, i, r);
			note = 0;
			if (c)
				note = c->note;
			if (1 <= note <= TR_NOTES &&
				tr.roll_top <= note < tr.roll_top + tr_roll_keys)
			{
				len = TrRollLen(tr.cur_pat, i, r, rows);
				if (r + len > tr.view_top + cols)
					len = tr.view_top + cols - r;
				x = TR_GRID_X + TR_ROLL_X + (r - tr.view_top) * tr.roll_zx;
				y = TR_GRID_Y + (tr.roll_top + tr_roll_keys - 1 - note) *
					tr.roll_zy;
				dc->color = de_theme.panel_edge;
				GrRect(dc, x + 1, y + tr.roll_zy / 2 - 1,
					   len * tr.roll_zx - 2, 2);
			}
		}
	}

	//Follow keeps the sounding pitch on screen. The roll scrolls in pitch as
	//well as time, so a part that climbs out of view is otherwise invisible
	//however well the playhead tracks it.
	if (tr.playing && tr.follow && play_pat == tr.cur_pat)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, play_row);
		if (c && 1 <= c->note <= TR_NOTES &&
			!(tr.roll_top + 1 <= c->note < tr.roll_top + tr_roll_keys - 1))
			tr.roll_top = ClampI64(c->note - tr_roll_keys / 2, 1,
								   MaxI64(1, TR_NOTES - tr_roll_keys));
	}

	//Notes. A cell holds a pitch, not a duration, so the block runs to
	//whatever ends it.
	for (r = 0; r < rows; r++)
	{
		c = TrCell(tr.cur_pat, tr.cur_ch, r);
		note = 0;
		if (c)
			note = c->note;
		if (1 <= note <= TR_NOTES && tr.view_top <= r < tr.view_top + cols &&
			tr.roll_top <= note < tr.roll_top + tr_roll_keys)
		{
			len	= TrRollLen(tr.cur_pat, tr.cur_ch, r, rows);
			//A note is sounding while the playhead is anywhere inside it, not
			//only on the row that started it. Tested against the unclipped
			//length, since the clip below is only about what fits on screen.
			lit = tr.playing && play_pat == tr.cur_pat &&
				  r <= play_row < r + len;
			if (r + len > tr.view_top + cols)
				len = tr.view_top + cols - r;
			x	= TR_GRID_X + TR_ROLL_X + (r - tr.view_top) * tr.roll_zx;
			y	= TR_GRID_Y + (tr.roll_top + tr_roll_keys - 1 - note) *
				  tr.roll_zy;
			//One meaning for one colour: selected, playing and the cursor all
			//read as the highlight, everything else as the dim accent.
			if (lit || r == tr.cur_row || TrRollSelHas(r, note))
				dc->color = de_theme.accent;
			else
				dc->color = de_theme.accent_dim;
			GrRect(dc, x + 1, y + 1, len * tr.roll_zx - 2, tr.roll_zy - 3);
			//The sample the note actually plays, drawn into the bar. Below
			//about twenty pixels there is no shape to see, so it is skipped
			//rather than drawn as noise.
			if (len * tr.roll_zx >= 20 && tr.roll_zy >= 8)
			{
				k = TrInstSample(TrCellInst(c), note, &i);
				dc->color = de_theme.win_bg;
				TrWaveInto(dc, x + 2, y + 2, len * tr.roll_zx - 4,
						   tr.roll_zy - 5, k);
			}
			if (c->inst)
			{
				dc->color = de_theme.win_bg;
				GrPrint(dc, x + 2, y - 1, "%02X", c->inst);
			}
		}
	}

	//Marquee, over the notes and only while the button is down. ZealOS has no
	//alpha, so the wash is every other SCANLINE across the whole box: at one
	//pixel of pitch it reads as a tint rather than as the grating a per-cell
	//pattern made of it. The border is solid, so the edge stays crisp against
	//the half-covered middle.
	if (tr.sel_band && tr.sel_r0 >= 0)
	{
		i = TR_GRID_X + TR_ROLL_X +
			(MaxI64(tr.sel_r0, tr.view_top) - tr.view_top) * tr.roll_zx;
		k = TR_GRID_X + TR_ROLL_X +
			(MinI64(tr.sel_r1, tr.view_top + cols - 1) - tr.view_top + 1) *
			tr.roll_zx;
		//Note numbers grow upward, so the HIGH note gives the TOP edge.
		y = TR_GRID_Y + (tr.roll_top + tr_roll_keys - 1 -
						 MinI64(tr.sel_n1, tr.roll_top + tr_roll_keys - 1)) *
			tr.roll_zy;
		len = TR_GRID_Y + (tr.roll_top + tr_roll_keys -
						   MaxI64(tr.sel_n0, tr.roll_top)) * tr.roll_zy;
		if (k > i && len > y)
		{
			dc->color = de_theme.accent2_dim;
			for (r = y; r < len; r += 2)
				GrRect(dc, i, r, k - i, 1);
			dc->color = de_theme.accent2;
			GrRect(dc, i, y, k - i, 1);
			GrRect(dc, i, len - 1, k - i, 1);
			GrRect(dc, i, y, 1, len - y);
			GrRect(dc, k - 1, y, 1, len - y);
		}
	}

	TrDrawRollPanel(dc, w);

	//Playhead, then the edit cursor.
	if (tr.playing && play_pat == tr.cur_pat &&
		tr.view_top <= play_row < tr.view_top + cols)
	{
		dc->color = de_theme.accent2;
		GrRect(dc, TR_GRID_X + TR_ROLL_X +
			   (play_row - tr.view_top) * tr.roll_zx, TR_GRID_Y, 2,
			   tr_roll_keys * tr.roll_zy);
	}
	if (tr.view_top <= tr.cur_row < tr.view_top + cols)
	{
		dc->color = de_theme.text;
		GrRect(dc, TR_GRID_X + TR_ROLL_X +
			   (tr.cur_row - tr.view_top) * tr.roll_zx,
			   TR_GRID_Y + tr_roll_keys * tr.roll_zy, tr.roll_zx, 2);
	}
}

U0 TrDrawIt(CTask *task, CDC *dc)
{
	I64	 ch, row, col, x, y, i, v, n, gx;
	I64	 w = task->pix_width, h = task->pix_height;
	I64	 play_ord = -1, play_pat = -1, play_row = -1;
	I64	 rows = TrCurRows();
	CTrCell	*c;
	U8	 buf[256], fld[8];

	dc->color = de_theme.win_bg;
	GrRect(dc, 0, 0, w, h);
	if (tr.busy)
	{//Patterns and samples are being replaced; nothing here is safe to read.
		dc->color = de_theme.text;
		GrPrint(dc, 12, 12, "loading...");
		return;
	}

	tr_view_w	 = w;
	tr_view_h	 = h;
	tr_view_chs	 = ClampI64((w - TR_GRID_X - 8) / TR_CELL_W, 1, TR_MAX_CHANNELS);
	//The grid stops above the seek bar, which now owns the bottom strip.
	tr_view_rows = ClampI64((TrSeekY() - TR_GRID_Y - 4) / TR_CELL_H,
							4, TR_MAX_ROWS);

	if (tr.playing)
		TrMarkNow(&play_ord, &play_pat, &play_row);

	//Header.
	dc->color = de_theme.accent;
	GrPrint(dc, 12, 6, "YTRACKER");
	dc->color = de_theme.text;
	GrPrint(dc, 96, 6, "%s", tr_song.title);
	dc->color = de_theme.text_dim;
	if (*tr.status)
		GrPrint(dc, 12, 18, "%s", tr.status);

	dc->color = de_theme.text;
	StrPrint(buf, "BPM %3d  Spd %2d  Pat %02X/%02X  Row %02X/%02X  Ord %03d/%03d  "
				  "Ch %d  Oct %d  Ins %02X  Gain %3d",
			 tr_song.bpm, tr_song.speed, tr.cur_pat, tr_song.n_patterns - 1,
			 tr.cur_row, rows - 1, tr.order_sel, tr_song.order_len,
			 tr_song.channels, tr.octave, tr.inst, tr.master);
	GrPrint(dc, 12, 30, "%s", buf);
	x = w - 260;
	if (tr.edit)
	{
		dc->color = ColorRGB(0xF0, 0x70, 0x70);
		GrPrint(dc, x, 6, "EDIT");
	}
	else
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, x, 6, "VIEW");
	}
	{
		//Clickable: says what it switches to, so there is always a visible way
		//back from either view.
		dc->color = de_theme.bttn;
		GrRect(dc, TrViewBtnX() - 4, 2, TR_VIEWBTN_W, 14);
		dc->color = de_theme.accent2;
		if (tr.view_mode == TR_VIEW_GRID)
			GrPrint(dc, TrViewBtnX(), 6, "[ARR ]");
		else if (tr.view_mode == TR_VIEW_ARR)
			GrPrint(dc, TrViewBtnX(), 6, "[ROLL]");
		else
			GrPrint(dc, TrViewBtnX(), 6, "[GRID]");
	}
	if (tr.playing)
	{
		dc->color = de_theme.accent;
		if (tr.pat_mode)
			GrPrint(dc, x + 48, 6, "PLAY PAT");
		else
			GrPrint(dc, x + 48, 6, "PLAY SONG");
	}
	//Always drawn, lit or dim, so each is a target as well as a readout.
	if (tr.follow)
		dc->color = de_theme.accent;
	else
		dc->color = de_theme.text_dim;
	GrPrint(dc, x + tr_flag_x[TR_FLAG_FOLLOW], 6, "FOLLOW");
	if (tr.interp)
		dc->color = de_theme.accent;
	else
		dc->color = de_theme.text_dim;
	GrPrint(dc, x + tr_flag_x[TR_FLAG_INTERP], 6, "INTERP");

	TrDrawScope(dc, w);
	TrDrawSeek(dc, w, play_ord, play_row, play_pat);

	//Channel headers: name, mute state, VU. Grid only. The arrangement gives
	//every lane a strip carrying the same three things, and the roll names
	//its single channel in its own header; both also put a ruler on this row.
	gx = TR_GRID_X;
	for (i = 0; i < tr_view_chs && tr.view_mode == TR_VIEW_GRID; i++)
	{
		ch = tr.view_ch + i;
		if (ch < tr_song.channels)
		{
			x = gx + i * TR_CELL_W;
			if (tr_ch[ch].mute)
			{
				dc->color = de_theme.text_dim;
				GrPrint(dc, x, TR_GRID_Y - 26, "CH%02d MUTE", ch + 1);
			}
			else
			{
				//Two prints, not one: the number identifies the channel and
				//the label only describes it, so the label sits back in the
				//dim text the arrangement lanes already use for it.
				dc->color = de_theme.text;
				GrPrint(dc, x, TR_GRID_Y - 26, "CH%02d", ch + 1);
				//Eight glyphs of label fit beside "CH01 " in a cell column.
				TrChanLabel(ch, buf, 9);
				if (buf[0])
				{
					dc->color = de_theme.text_dim;
					GrPrint(dc, x + 5 * FONT_WIDTH, TR_GRID_Y - 26, "%s",
							buf);
				}
			}
			v = ClampI64(tr_ch[ch].peak * 96 / 32768, 0, 96);
			dc->color = de_theme.panel;
			GrRect(dc, x, TR_GRID_Y - 14, 96, 5);
			if (v > 0)
			{
				dc->color = de_theme.accent;
				GrRect(dc, x, TR_GRID_Y - 14, v, 5);
			}
		}
	}

	if (tr.view_mode == TR_VIEW_ARR)
	{//Lanes and clips: the order list read as an arrangement.
		TrDrawArr(dc, w, play_ord);
		TrDrawSeek(dc, w, play_ord, play_row, play_pat);
		return;
	}
	if (tr.view_mode == TR_VIEW_ROLL)
	{//Same pattern, drawn as pitch against time.
		TrDrawRoll(dc, w, play_row, play_pat);
		TrDrawSeek(dc, w, play_ord, play_row, play_pat);
		return;
	}

	//Keep the cursor, or the playhead in follow mode, on screen.
		tr.view_top = tr.cur_row;
	if (tr.cur_row >= tr.view_top + tr_view_rows)
		tr.view_top = tr.cur_row - tr_view_rows + 1;
	tr.view_top = ClampI64(tr.view_top, 0, MaxI64(0, rows - tr_view_rows));
	if (tr.cur_ch < tr.view_ch)
		tr.view_ch = tr.cur_ch;
	if (tr.cur_ch >= tr.view_ch + tr_view_chs)
		tr.view_ch = tr.cur_ch - tr_view_chs + 1;
	tr.view_ch = ClampI64(tr.view_ch, 0,
						  MaxI64(0, tr_song.channels - tr_view_chs));

	for (row = 0; row < tr_view_rows; row++)
	{
		n = tr.view_top + row;
		if (n < rows)
		{
			y = TR_GRID_Y + row * TR_CELL_H;
			if (n == play_row && play_pat == tr.cur_pat)
			{
				dc->color = de_theme.bttn_focus;
				GrRect(dc, 8, y - 1, w - 16, TR_CELL_H - 1);
			}
			//Beat rows in the secondary accent so the bar lines read without
			//counting; the DE's Settings panel sets the hue.
			if (n % 16 == 0)
			{
				dc->color = de_theme.accent2;
				GrRect(dc, 8, y - 1, w - 16, 1);
			}
			if (n % 4)
				dc->color = de_theme.text_dim;
			else if (n % 16)
				dc->color = de_theme.accent2_dim;
			else
				dc->color = de_theme.accent2;
			GrPrint(dc, 12, y, "%02X", n);
			for (i = 0; i < tr_view_chs; i++)
			{
				ch = tr.view_ch + i;
				if (ch < tr_song.channels)
				{
					x = gx + i * TR_CELL_W;
					c = TrCell(tr.cur_pat, ch, n);
					TrCellText(c, buf);
					if (ch == tr.cur_ch && n == tr.cur_row)
					{//Highlight the whole cell, then the active sub-column.
						dc->color = de_theme.panel;
						GrRect(dc, x - 2, y - 1, 108, TR_CELL_H - 1);
						col = ClampI64(tr.cur_col, 0, TR_COLS - 1);
						if (tr.edit)
							dc->color = ColorRGB(0xF0, 0x70, 0x70);
						else
							dc->color = de_theme.accent;
						GrRect(dc, x + tr_col_x[col] * FONT_WIDTH - 1, y - 1,
							   tr_col_w[col] * FONT_WIDTH + 1, TR_CELL_H - 1);
						dc->color = ColorRGB(0x10, 0x14, 0x1E);
						GrPrint(dc, x, y, "%s", buf);
					}
					else if (tr_ch[ch].mute)
					{
						dc->color = de_theme.text_dim;
						GrPrint(dc, x, y, "%s", buf);
					}
					else
					{//Colour the columns so effects stand out from notes.
						if (c && c->note)
							dc->color = ColorRGB(0xC8, 0xDC, 0xFF);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf, 3);
						fld[3] = 0;
						GrPrint(dc, x, y, "%s", fld);
						if (c && c->inst)
							dc->color = ColorRGB(0x6B, 0xE8, 0x8A);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 4, 2);
						fld[2] = 0;
						GrPrint(dc, x + 4 * FONT_WIDTH, y, "%s", fld);
						if (c && c->volcmd)
							dc->color = ColorRGB(0xF2, 0xD9, 0x60);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 7, 2);
						fld[2] = 0;
						GrPrint(dc, x + 7 * FONT_WIDTH, y, "%s", fld);
						if (c && (c->eff || c->param))
							dc->color = ColorRGB(0xF0, 0x9A, 0x50);
						else
							dc->color = de_theme.text_dim;
						MemCopy(fld, buf + 10, 3);
						fld[3] = 0;
						GrPrint(dc, x + 10 * FONT_WIDTH, y, "%s", fld);
					}
				}
			}
		}
	}

}

I64 TrKeyNote(I64 key)
{//Two piano rows. -1 if the key is not a note.
	U8	*low = "zsxdcvgbhnjm", *high = "q2w3er5t6y7u";
	I64	 i;

	for (i = 0; low[i]; i++)
		if (key == low[i])
			return tr.octave * 12 + i + 1;
	for (i = 0; high[i]; i++)
		if (key == high[i])
			return (tr.octave + 1) * 12 + i + 1;

	return -1;
}

I64 TrKeyHex(I64 key)
{//-1 if the key is not a hex digit.
	if ('0' <= key <= '9')
		return key - '0';
	if ('a' <= key <= 'f')
		return key - 'a' + 10;
	if ('A' <= key <= 'F')
		return key - 'A' + 10;

	return -1;
}

U0 TrRowInsert(I64 ch)
{//Shift this channel down from the cursor; the last row falls off.
	I64		 r, rows = TrCurRows();
	CTrCell	*a, *b;

	if (!TrEnsurePattern(tr.cur_pat))
		return;
	for (r = rows - 1; r > tr.cur_row; r--)
	{
		a = TrCell(tr.cur_pat, ch, r);
		b = TrCell(tr.cur_pat, ch, r - 1);
		if (a && b)
			MemCopy(a, b, sizeof(CTrCell));
	}
	a = TrCell(tr.cur_pat, ch, tr.cur_row);
	if (a)
		MemSet(a, 0, sizeof(CTrCell));
}

U0 TrRowDelete(I64 ch)
{
	I64		 r, rows = TrCurRows();
	CTrCell	*a, *b;

	if (!tr_pat[tr.cur_pat])
		return;
	for (r = tr.cur_row; r < rows - 1; r++)
	{
		a = TrCell(tr.cur_pat, ch, r);
		b = TrCell(tr.cur_pat, ch, r + 1);
		if (a && b)
			MemCopy(a, b, sizeof(CTrCell));
	}
	a = TrCell(tr.cur_pat, ch, rows - 1);
	if (a)
		MemSet(a, 0, sizeof(CTrCell));
}

U0 TrMenuPane(I64 pane)
{
	TrPaneWinToggle(pane);
}

Bool TrEdKey(I64 key, I64 sc, I64 flags)
{//The macro and wavetable editors take the keyboard while open. Returns TRUE
//when the key was consumed, so the pattern editor never sees it and the note
//keys cannot enter notes behind an open editor.
	CTrMacro *m;
	I64		  lo, hi, step, big = 1, slot;
	Bool	  shift = (flags & SCF_SHIFT) != 0;

	if (tr.pane != TR_PANE_MACRO && tr.pane != TR_PANE_WAVE)
		return FALSE;
	if (shift)
		big = 8;

	if (tr.pane == TR_PANE_WAVE)
	{
		slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
		step = ClampI64(tr.wave_step, 0, TR_WAVE_STEPS - 1);
		switch (sc)
		{
			case SC_CURSOR_LEFT:
				tr.wave_step = (step + TR_WAVE_STEPS - 1) % TR_WAVE_STEPS;
				return TRUE;
			case SC_CURSOR_RIGHT:
				tr.wave_step = (step + 1) % TR_WAVE_STEPS;
				return TRUE;
			case SC_CURSOR_UP:
				tr_wave[slot].step[step] =
					ClampI64(tr_wave[slot].step[step] + big, 0, TR_WAVE_MAX);
				tr_wave[slot].used = TRUE;
				TrWaveRender(slot);
				return TRUE;
			case SC_CURSOR_DOWN:
				tr_wave[slot].step[step] =
					ClampI64(tr_wave[slot].step[step] - big, 0, TR_WAVE_MAX);
				tr_wave[slot].used = TRUE;
				TrWaveRender(slot);
				return TRUE;
		}
		if (key == '\t')
		{
			if (shift)
				tr.wave_sel = (slot + TR_WAVE_SLOTS - 1) % TR_WAVE_SLOTS;
			else
				tr.wave_sel = (slot + 1) % TR_WAVE_SLOTS;
			return TRUE;
		}
		//Digits type a value directly; hex covers the full 0..15 range.
		if (TrKeyHex(key) >= 0)
		{
			tr_wave[slot].step[step] = ClampI64(TrKeyHex(key), 0, TR_WAVE_MAX);
			tr_wave[slot].used = TRUE;
			TrWaveRender(slot);
			tr.wave_step = (step + 1) % TR_WAVE_STEPS;
			return TRUE;
		}
		return FALSE;
	}

	m = TrMacroCur();
	if (!m)
		return FALSE;
	hi	 = TrMacroRange(tr.macro_sel, &lo);
	step = ClampI64(tr.macro_step, 0, TR_MACRO_LEN - 1);
	switch (sc)
	{
		case SC_CURSOR_LEFT:
			tr.macro_step = (step + TR_MACRO_LEN - 1) % TR_MACRO_LEN;
			return TRUE;
		case SC_CURSOR_RIGHT:
			tr.macro_step = (step + 1) % TR_MACRO_LEN;
			return TRUE;
		case SC_CURSOR_UP:
			m->val[step] = ClampI64(m->val[step] + big, lo, hi);
			if (m->len <= step)
				m->len = step + 1;
			return TRUE;
		case SC_CURSOR_DOWN:
			m->val[step] = ClampI64(m->val[step] - big, lo, hi);
			if (m->len <= step)
				m->len = step + 1;
			return TRUE;
		case SC_INS:
			m->len = ClampI64(m->len + 1, 0, TR_MACRO_LEN);
			return TRUE;
		case SC_DELETE:
			m->len = ClampI64(m->len - 1, 0, TR_MACRO_LEN);
			if (m->loop >= m->len)
				m->loop = -1;
			if (m->release >= m->len)
				m->release = -1;
			return TRUE;
	}
	if (key == '\t')
	{
		if (shift)
			tr.macro_sel = (tr.macro_sel + TR_MACRO_COUNT - 1) %
						   TR_MACRO_COUNT;
		else
			tr.macro_sel = (tr.macro_sel + 1) % TR_MACRO_COUNT;
		return TRUE;
	}
	if (key == 'l' || key == 'L')
	{//Toggle the loop point on this step.
		if (m->loop == step)
			m->loop = -1;
		else
			m->loop = step;
		return TRUE;
	}
	if (key == 'r' || key == 'R')
	{
		if (m->release == step)
			m->release = -1;
		else
			m->release = step;
		return TRUE;
	}
	if (key == 'm' || key == 'M')
	{
		if (tr.macro_sel == TR_MACRO_ARP)
			m->mode = (m->mode + 1) % 3;
		return TRUE;
	}
	return FALSE;
}

U0 TrEdClick(I64 mx, I64 my, I64 x0, I64 y0)
{//Draw into whichever editor is open. Called on press and on drag. The origin
//is the pane's top left, which is its window's origin now rather than a fixed
//spot inside the main window.
	CTrMacro *m;
	I64		  gx = x0 + TR_ED_GX, gy = y0 + TR_ED_GY;
	I64		  i, w, lo, hi, v, slot;

	if (my < gy || my >= gy + TR_ED_GH)
		return;
	if (tr.pane == TR_PANE_WAVE)
	{
		w = (TR_ED_W - 2 * TR_ED_GX) / TR_WAVE_STEPS;
		if (w < 1)
			return;
		i = (mx - gx) / w;
		if (i < 0 || i >= TR_WAVE_STEPS)
			return;
		slot = ClampI64(tr.wave_sel, 0, TR_WAVE_SLOTS - 1);
		//Top of the graph is the maximum, so invert the pointer's y.
		v = (gy + TR_ED_GH - my) * (TR_WAVE_MAX + 1) / TR_ED_GH;
		tr_wave[slot].step[i]	= ClampI64(v, 0, TR_WAVE_MAX);
		tr_wave[slot].used		= TRUE;
		tr.wave_step			= i;
		TrWaveRender(slot);
		return;
	}
	if (tr.pane != TR_PANE_MACRO)
		return;
	m = TrMacroCur();
	if (!m)
		return;
	w = (TR_ED_W - 2 * TR_ED_GX) / TR_MACRO_LEN;
	if (w < 1)
		return;
	i = (mx - gx) / w;
	if (i < 0 || i >= TR_MACRO_LEN)
		return;
	hi = TrMacroRange(tr.macro_sel, &lo);
	v  = lo + (gy + TR_ED_GH - my) * (hi - lo) / TR_ED_GH;
	m->val[i]		= ClampI64(v, lo, hi);
	tr.macro_step	= i;
	if (m->len <= i)
		m->len = i + 1;
}

U0 TrRightClick(I64 mx, I64 my)
{//Right-click a channel solos it, and again releases every mute. The lane
//headers in the arrangement and the monitor row above the grid both name a
//channel, so both take it. In the roll it deletes the note under the pointer
//instead, which is what a DAW does and what the left button would otherwise
//have to overload.
	I64 gl, i, row, bar;
	CTrCell *cell;

	if (tr.view_mode == TR_VIEW_ARR && my >= TR_GRID_Y && my < TrSeekY())
	{
		gl = TrArrLaneAt(my);
		if (mx < TR_GRID_X + TR_ARR_X && 0 <= gl < tr_song.channels)
			TrChanSolo(gl);
		return;
	}
	if (tr.view_mode == TR_VIEW_ROLL)
	{
		//Over the note area: delete. Over the keyboard gutter, where there is
		//no note to point at: solo, as everywhere else.
		if (my >= TR_GRID_Y && my < TrSeekY() && mx >= TR_GRID_X + TR_ROLL_X)
		{
			row	= TrRollRowAt(mx);
			gl	= TrRollNoteAt(my);
			if (0 <= row < TrCurRows() && 1 <= gl <= TR_NOTES)
			{
				//Anywhere along the note, not only on the row that starts it.
				bar = TrRollNoteRow(tr.cur_pat, tr.cur_ch, row, gl,
									TrCurRows());
				if (bar < 0)
					return;
				cell = TrCell(tr.cur_pat, tr.cur_ch, bar);
				if (cell)
				{
					TrUndoPush(TRUE);
					MemSet(cell, 0, sizeof(CTrCell));
					tr.cur_row = bar;
				}
			}
			return;
		}
		TrChanSolo(tr.cur_ch);
		return;
	}
	//Grid: the monitor row, and the columns under it.
	if (my >= TR_GRID_Y - 30 && mx >= TR_GRID_X)
	{
		i = (mx - TR_GRID_X) / TR_CELL_W;
		gl = tr.view_ch + i;
		if (0 <= gl < tr_song.channels)
			TrChanSolo(gl);
	}
}

U0 TrClick(I64 mx, I64 my)
{
	I64		 i, row, col, gl, ord, bw, bar;
	CTrCell	*cell;

	//Header button, live in both views so there is always a way back.
	if (my < 18 && TrViewBtnX() - 4 <= mx < TrViewBtnX() - 4 + TR_VIEWBTN_W)
	{
		TrViewToggle;
		return;
	}
	//EDIT, FOLLOW and INTERP, which read as buttons and now are.
	i = TrFlagAt(mx, my);
	if (i >= 0)
	{
		TrFlagToggle(i);
		return;
	}

	//Scope: click cycles split lanes, mono sum, both over each other.
	if (TR_SCOPE_Y <= my < TR_SCOPE_Y + TR_SCOPE_H && mx >= 12)
	{
		tr.scope_mode = (tr.scope_mode + 1) % TR_SCOPE_MODES;
		TrConfigSave;
		return;
	}

	//Arrangement: a lane name mutes, a clip selects it and drags to another
	//position or lane. Dragging a clip writes the destination and clears the
	//source back to the shared order, which is what moving a clip means when
	//the arrangement is an override list.
	if (tr.view_mode == TR_VIEW_ARR && my >= TR_GRID_Y && my < TrSeekY())
	{
		gl = TrArrLaneAt(my);
		if (0 <= gl < tr_song.channels)
		{
			if (mx < TR_GRID_X + TR_ARR_X)
			{
				tr.arr_ch = gl;
				ord = TR_GRID_Y + (gl - tr.arr_top) * tr.arr_zy;
				if (mx < TR_GRID_X)
					return;
				if (TrMixStripHit(mx, my, gl, ord))
					TrMixDrag(gl, ord);
				else
					tr_ch[gl].mute = !tr_ch[gl].mute;
				return;
			}
			ord = TrArrPosAt(mx);
			if (0 <= ord < tr_song.order_len)
			{
				tr.arr_ch		= gl;
				tr.order_sel	= ord;
				tr.cur_ch		= gl;
				tr.cur_pat		= TrPatternForOrderCh(ord, gl);
				//Ctrl drags a copy instead of moving the alias.
				TrArrDrag(ord, gl, Bt(kbd.down_bitmap, SC_CTRL) != 0);
			}
		}
		return;
	}

	//Piano roll: a click places the current instrument's note at the pitch and
	//row under the pointer, and clicking a note again removes it. The cell is
	//the same one the grid edits.
	if (tr.view_mode == TR_VIEW_ROLL && my >= TrRollPanelY() &&
		my < TrRollPanelY() + TR_RP_H)
	{//Attribute panel: pick the field the digits will type into.
		if (TrRollSnapHit(mx, my))
		{
			TrRollSnapCycle;
			return;
		}
		if (TrRollGhostHit(mx, my))
		{
			tr.roll_ghosts = !tr.roll_ghosts;
			return;
		}
		i = TrRollFieldAt(mx, my);
		if (i >= 0)
		{
			tr.roll_field	= i;
			tr.roll_edit	= TRUE;
			//An instrument has a NAME, so it gets picked from the list
			//rather than typed as a number nobody has memorised. The other
			//three are numbers and nothing else, so they take digits.
			if (i == TR_RF_INST)
				TrRollPickInst(TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row));
		}
		return;
	}
	if (tr.view_mode == TR_VIEW_ROLL && my >= TR_GRID_Y &&
		my < TrRollPanelY())
	{
		row	= TrRollRowAt(mx);
		gl	= TrRollNoteAt(my);
		//Shift sweeps a selection instead of editing a note.
		if (Bt(kbd.down_bitmap, SC_SHIFT))
		{
			if (0 <= row < TrCurRows() && 1 <= gl <= TR_NOTES)
				TrRollBand(row, gl);
			return;
		}
		//Clicking the roll takes the keyboard back off the panel, so the
		//letter keys are piano keys again.
		tr.roll_edit = FALSE;
		//Inside the selection: drag the whole thing. Outside it: the click
		//drops the selection, the way clicking off one does in any editor.
		if (0 <= row < TrCurRows() && 1 <= gl <= TR_NOTES &&
			TrRollSelHas(row, gl) && tr.sel_r1 > tr.sel_r0)
		{
			TrRollSelMove(row, gl);
			return;
		}
		TrRollSelClear;
		if (0 <= row < TrCurRows() && 1 <= gl <= TR_NOTES)
		{
			//A click inside a sounding note grabs it; the note's own row moves
			//it, its last row drags the tail.
			bar = TrRollNoteRow(tr.cur_pat, tr.cur_ch, row, gl, TrCurRows());
			if (bar >= 0)
			{
				tr.cur_row = bar;
				cell = TrCell(tr.cur_pat, tr.cur_ch, bar);
				TrPreview(gl, TrCellInst(cell), tr.vol_default);
				TrRollDrag(bar, gl,
						   TrRollAtTail(mx, bar,
										TrRollLen(tr.cur_pat, tr.cur_ch, bar,
												  TrCurRows())));
				return;
			}
			cell = TrCell(tr.cur_pat, tr.cur_ch, row);
			if (cell)
			{
				TrUndoPush(TRUE);
				tr.cur_row = row;
				if (cell->note == gl)
					MemSet(cell, 0, sizeof(CTrCell));
				else
				{
					cell->note = gl;
					cell->inst = tr.inst;
					TrPreview(gl, tr.inst, tr.vol_default);
					//Drag straight out of the click to set the length.
					TrRollDrag(row, gl, TRUE);
				}
			}
		}
		return;
	}

	//Song position bar: seek to the order under the pointer. Seeking while
	//stopped moves the cursor there instead of starting playback.
	if (TrSeekY() <= my && my < TrSeekY() + TR_SEEK_H && tr_song.order_len > 0)
	{
		bw	= tr_view_w - 24;
		ord	= ClampI64((mx - 12) * tr_song.order_len / MaxI64(1, bw),
					   0, tr_song.order_len - 1);
		tr.order_sel	= ord;
		tr.cur_pat		= TrPatternForOrder(ord);
		tr.cur_row		= 0;
		tr.view_top		= 0;
		if (tr.playing)
		{
			tr.pat_mode = FALSE;
			TrPlayStart(ord, 0);
		}
		TrStatus("Order %03d, pattern %02X", ord, tr.cur_pat);
		return;
	}

	i = (mx - TR_GRID_X) / TR_CELL_W;
	if (i < 0 || i >= tr_view_chs)
		return;
	if (my >= TR_GRID_Y - 28 && my < TR_GRID_Y - 8)
	{//Channel header: toggle mute.
		i += tr.view_ch;
		if (i < tr_song.channels)
			tr_ch[i].mute = !tr_ch[i].mute;
		return;
	}
	if (my < TR_GRID_Y)
		return;
	row = (my - TR_GRID_Y) / TR_CELL_H;
	if (row < 0 || row >= tr_view_rows)
		return;
	if (tr.view_ch + i >= tr_song.channels)
		return;
	tr.cur_ch	= tr.view_ch + i;
	tr.cur_row	= ClampI64(tr.view_top + row, 0, TrCurRows() - 1);
	//Glyph index inside the cell picks the sub-column.
	gl = (mx - TR_GRID_X - i * TR_CELL_W) / FONT_WIDTH;
	for (col = TR_COLS - 1; col >= 0; col--)
		if (gl >= tr_col_x[col])
		{
			tr.cur_col = col;
			col = -1;
		}
}

U0 TrSaveAs()
{
	U8	 hdr[300];
	U8	*name;

	StrPrint(hdr, "Save song as (ENTER keeps %s):", tr.file);
	name = PopUpGetStr(hdr);
	WinFocus(tr.win_task);
	if (!name)
		return;
	if (*name)
	{
		StrCopy(tr.file, name);
		if (StrLen(tr.file) > 4 &&
			StrICompare(tr.file + StrLen(tr.file) - 4, ".DAT"))
			CatPrint(tr.file, ".DAT");
	}
	Free(name);
	if (TrSongSave(tr.file))
		TrStatus("Saved %s (%d bytes)", tr.file, TrSongSize());
	else if (!TrNameOk(tr.file))
	{
		TrStatus("Cannot save as %s", tr.file);
		PopUpOk("That name cannot be created.\n\n"
				"The file layer faults rather than erring on a name longer "
				"than 8 characters plus a 3 character extension, so saving "
				"screens it first. Existing long names still LOAD fine.");
		WinFocus(tr.win_task);
	}
	else
		TrStatus("Save failed - out of memory");
}

U0 TrLoadAs()
{
	I64	 kind;
	U8	*name = PopUpPickFile(tr.dir_song);

	WinFocus(tr.win_task);
	if (!name)
		return;
	//Remember where this came from, whatever the load then makes of it.
	TrDirOf(name, tr.dir_song, sizeof(tr.dir_song));
	TrConfigSave;
	//Snapshots of the outgoing song cannot be restored over the incoming one.
	TrUndoFreeAll;
	TrRollSelClear;
	TrMixSuspend;
	kind = TrLoadFile(name);
	switch (kind)
	{
		case 1:
			StrCopy(tr.file, name);
			TrStatus("Loaded YTK3 %s - %d ch, %d pat", name,
					 tr_song.channels, tr_song.n_patterns);
			break;
		case 2:
			TrStatus("Loaded MOD %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 3:
			TrStatus("Imported YTK2 %s", name);
			break;
		case 4:
			TrStatus("Loaded XM %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 5:
			TrStatus("Loaded IT %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 6:
			TrStatus("Loaded S3M %s - %d ch, %d pat, %d smp", name,
					 tr_song.channels, tr_song.n_patterns, TrSampleCount());
			break;
		case 7:
			TrStatus("Loaded FTM %s - %d ch, %d pat (2A03 only)", name,
					 tr_song.channels, tr_song.n_patterns);
			break;
		case -1:
			TrStatus("Could not read %s", name);
			PopUpOk("Could not read that file.\n\n"
					"The format is detected from the file's contents, not its "
					"extension, so this is the file layer refusing the name "
					"rather than an unsupported format. Names with spaces, "
					"'&' or a leading '~' are the usual cause; rename to "
					"letters, digits, '.', '-' and '_' and try again.");
			WinFocus(tr.win_task);
			break;
		default:
			//A failed parse can leave the song half torn down.
			if (!tr_pat[0])
				TrSongNew(4, 8, 64);
			TrStatus("%s is not a module this build recognises", name);
			PopUpOk("Unrecognised file.\n\n"
					"Reads .MOD, .XM, .S3M, .IT, .FTM and YTracker's own YTK3 "
					"and YTK2 songs. Detection is by content, so the extension "
					"does not matter.\n\n"
					"A file using a feature this build skips still loads; a "
					"file that reaches here matched none of the formats.");
			WinFocus(tr.win_task);
	}
	Free(name);
	tr.cur_pat	= 0;
	tr.cur_ch	= 0;
	tr.cur_row	= 0;
	tr.cur_col	= 0;
	tr.view_ch	= 0;
	tr.view_top	= 0;
	tr.order_sel = 0;
	TrMixResume;
}

U0 TrLoadSample()
{
	I64	 n, slot = tr.inst;
	U8	*name = PopUpPickFile(tr.dir_smp);

	WinFocus(tr.win_task);
	if (!name)
		return;
	TrDirOf(name, tr.dir_smp, sizeof(tr.dir_smp));
	TrConfigSave;
	TrMixSuspend;
	n = TrSampleLoadFile(slot, name);
	TrMixResume;
	if (n)
		TrStatus("Slot %02X: %s, %d frames", slot, tr_smp[slot].name, n);
	else
	{
		TrStatus("Not an 8/16-bit PCM WAV");
		PopUpOk("Need an uncompressed 8- or 16-bit PCM WAV.");
		WinFocus(tr.win_task);
	}
	Free(name);
}

U0 TrEditCell(I64 key)
{//Type into the cell under the cursor. Only reached in edit mode.
	CTrCell	*c;
	I64		 n, d;

	if (!TrEnsurePattern(tr.cur_pat))
		return;
	c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
	if (!c)
		return;

	if (key == CH_BACKSPACE)
	{
		MemSet(c, 0, sizeof(CTrCell));
		return;
	}

	if (tr.cur_col == TR_COL_NOTE)
	{
		if (key == '0')
		{
			MemSet(c, 0, sizeof(CTrCell));
			tr.cur_row = (tr.cur_row + 1) % TrCurRows();
			return;
		}
		if (key == '1')
		{
			c->note = TR_NOTE_OFF;
			c->inst = 0;
			tr.cur_row = (tr.cur_row + 1) % TrCurRows();
			return;
		}
		n = TrKeyNote(key);
		if (n >= 1 && n <= TR_NOTES)
		{
			c->note = n;
			c->inst = tr.inst;
			if (!c->volcmd)
			{
				c->volcmd  = TRV_SET;
				c->volparam = tr.vol_default;
			}
			TrPreview(n, tr.inst, tr.vol_default);
			tr.cur_row = (tr.cur_row + tr.step_add) % TrCurRows();
		}
		return;
	}

	d = TrKeyHex(key);
	if (d < 0)
		return;
	switch (tr.cur_col)
	{
		case TR_COL_INST1:	c->inst = (d << 4) | (c->inst & 0x0F);	break;
		case TR_COL_INST2:	c->inst = (c->inst & 0xF0) | d;			break;
		case TR_COL_VOL1:
			n = c->volparam;
			if (c->volcmd != TRV_SET)
				n = 0;
			n = (d << 4) | (n & 0x0F);
			c->volcmd  = TRV_SET;
			c->volparam = ClampI64(n, 0, 64);
			break;
		case TR_COL_VOL2:
			n = c->volparam;
			if (c->volcmd != TRV_SET)
				n = 0;
			n = (n & 0xF0) | d;
			c->volcmd  = TRV_SET;
			c->volparam = ClampI64(n, 0, 64);
			break;
		case TR_COL_EFF:	c->eff = d;								break;
		case TR_COL_PARAM1:	c->param = (d << 4) | (c->param & 0x0F);break;
		case TR_COL_PARAM2:	c->param = (c->param & 0xF0) | d;		break;
	}
	if (tr.cur_col == TR_COL_INST2 || tr.cur_col == TR_COL_VOL2 ||
		tr.cur_col == TR_COL_PARAM2)
		tr.cur_row = (tr.cur_row + tr.step_add) % TrCurRows();
	else
		tr.cur_col++;
	if (tr.cur_col >= TR_COLS)
		tr.cur_col = TR_COLS - 1;
}

U0 TrKeyScan(I64 sc, I64 flags)
{//Non-character keys. flags carries SCF_SHIFT / SCF_CTRL.
	I64	 rows = TrCurRows(), n;
	Bool shift = (flags & SCF_SHIFT) != 0, ctrl = (flags & SCF_CTRL) != 0;

	//F4 and F5 still toggle the editors, so they are not offered to it.
	if (sc != SC_F4 && TrEdKey(0, sc, flags))
		return;
	if (TrArrKey(sc, shift))
		return;

	switch (sc)
	{
		case SC_CURSOR_UP:
			if (shift)
				tr.inst = ClampI64(tr.inst + 1, 1, TR_MAX_SAMPLES - 1);
			else if (ctrl)
				tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			else if (tr.pane == TR_PANE_INST)
				tr.inst = ClampI64(tr.inst - 1, 1, TR_MAX_SAMPLES - 1);
			else if (tr.pane == TR_PANE_ORDER)
				tr.order_sel = MaxI64(0, tr.order_sel - 1);
			else
				tr.cur_row = (tr.cur_row + rows - 1) % rows;
			break;
		case SC_CURSOR_DOWN:
			if (shift)
				tr.inst = ClampI64(tr.inst - 1, 1, TR_MAX_SAMPLES - 1);
			else if (ctrl)
				tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			else if (tr.pane == TR_PANE_INST)
				tr.inst = ClampI64(tr.inst + 1, 1, TR_MAX_SAMPLES - 1);
			else if (tr.pane == TR_PANE_ORDER)
				tr.order_sel = MinI64(tr_song.order_len - 1, tr.order_sel + 1);
			else
				tr.cur_row = (tr.cur_row + 1) % rows;
			break;
		case SC_CURSOR_LEFT:
			if (shift)
				tr.octave = ClampI64(tr.octave - 1, 0, 6);
			else if (ctrl)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) % tr_song.channels;
			else
			{
				tr.cur_col--;
				if (tr.cur_col < 0)
				{
					tr.cur_col = TR_COLS - 1;
					tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) %
								tr_song.channels;
				}
			}
			break;
		case SC_CURSOR_RIGHT:
			if (shift)
				tr.octave = ClampI64(tr.octave + 1, 0, 6);
			else if (ctrl)
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			else
			{
				tr.cur_col++;
				if (tr.cur_col >= TR_COLS)
				{
					tr.cur_col = 0;
					tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
				}
			}
			break;
		case SC_TAB:
			//Reached only when Tab arrives without a character code; the
			//Ctrl-Tab view cycle lives in TrKeyChar, which is where a real
			//Tab press lands.
			if (shift)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) % tr_song.channels;
			else
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			tr.cur_col = 0;
			break;
		case SC_PAGE_UP:
			if (tr.view_mode == TR_VIEW_ROLL && ctrl)
			{
				tr.roll_top = ClampI64(tr.roll_top + 12, 1,
									   MaxI64(1, TR_NOTES - tr_roll_keys));
				break;
			}
			tr.cur_row = MaxI64(0, tr.cur_row - 16);
			break;
		case SC_PAGE_DOWN:
			if (tr.view_mode == TR_VIEW_ROLL && ctrl)
			{
				tr.roll_top = ClampI64(tr.roll_top - 12, 1,
									   MaxI64(1, TR_NOTES - tr_roll_keys));
				break;
			}
			tr.cur_row = MinI64(rows - 1, tr.cur_row + 16);
			break;
		case SC_HOME:
			tr.cur_row = 0;
			break;
		case SC_END:
			tr.cur_row = rows - 1;
			break;
		case SC_INS:
			if (tr.pane == TR_PANE_ORDER)
			{
				if (tr_song.order_len < TR_ORDER_MAX)
				{//MemCopy only runs forward, so shift by hand.
					tr.order_sel = ClampI64(tr.order_sel, 0, tr_song.order_len);
					for (n = tr_song.order_len; n > tr.order_sel; n--)
						tr_song.order[n] = tr_song.order[n - 1];
					tr_song.order[tr.order_sel] = tr.cur_pat;
					tr_song.order_len++;
				}
			}
			else
				TrRowInsert(tr.cur_ch);
			break;
		case SC_DELETE:
			//A roll selection is the thing being deleted, if there is one.
			if (tr.view_mode == TR_VIEW_ROLL && tr.sel_r0 >= 0)
			{
				TrUndoPush;
				TrRollSelDelete;
				break;
			}
			if (tr.pane == TR_PANE_ORDER)
			{
				if (tr_song.order_len > 0)
				{
					tr_song.order_len--;
					for (n = tr.order_sel; n < tr_song.order_len; n++)
						tr_song.order[n] = tr_song.order[n + 1];
					tr.order_sel = ClampI64(tr.order_sel, 0,
											MaxI64(0, tr_song.order_len - 1));
				}
			}
			else if (shift)
				TrRowDelete(tr.cur_ch);
			else
				TrEditCell(CH_BACKSPACE);
			break;
		case SC_F1:
			TrPaneWinToggle(TR_PANE_HELP);
			break;
		case SC_F2:
			TrPaneWinToggle(TR_PANE_INST);
			break;
		case SC_F3:
			TrPaneWinToggle(TR_PANE_ORDER);
			break;
		case SC_F4:
			//Shift picks the wavetable editor. Interpolation is a
			//set-and-forget switch and lives on the View menu now.
			if (shift)
				TrMenuPane(TR_PANE_WAVE);
			else
				TrMenuPane(TR_PANE_MACRO);
			break;
		case SC_F5:
			tr.pat_mode = FALSE;
			TrPlayStart(0, 0);
			break;
		case SC_F6:
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			break;
		case SC_F7:
			tr.follow = !tr.follow;
			break;
		case SC_F8:
			TrPlayStop;
			break;
		case SC_F9:
			TrSaveAs;
			break;
		case SC_F10:
			TrLoadAs;
			break;
		case SC_F11:
			TrLoadSample;
			break;
		case SC_F12:
			tr.edit = !tr.edit;
			break;
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
	tr.cur_col = ClampI64(tr.cur_col, 0, TR_COLS - 1);
	tr.cur_ch  = ClampI64(tr.cur_ch, 0, tr_song.channels - 1);
}

U0 TrKeyChar(I64 key, I64 flags)
{
	I64		 n, i;
	CTrCell	*c;

	//An open macro or wavetable editor consumes the keyboard: the piano keys
	//would otherwise enter notes into the pattern behind it.
	if (key != CH_ESC && key != CH_SHIFT_ESC && TrEdKey(key, 0, flags))
		return;

	//Undo is global; the roll clipboard is not.
	if (key == CH_CTRLZ)
	{
		TrUndoPop;
		return;
	}
	//Roll-only editing keys, claimed before the piano keys see them.
	if (tr.view_mode == TR_VIEW_ROLL)
	{
		if (key == CH_CTRLC)
		{
			TrRollCopy;
			return;
		}
		if (key == CH_CTRLV)
		{
			TrRollPaste;
			return;
		}
		if (key == 'q' || key == 'Q')
		{
			TrRollSnapCycle;
			return;
		}
		if ((key == 'g' || key == 'G') && !tr.roll_edit)
		{
			tr.roll_ghosts = !tr.roll_ghosts;
			return;
		}
		//A focused panel field takes the digits before the piano keys do:
		//A to F are note keys as well as hex, and note entry sees them first.
		if (tr.roll_edit)
		{
			n = TrKeyHex(key);
			if (n >= 0)
			{
				c = TrCell(tr.cur_pat, tr.cur_ch, tr.cur_row);
				if (c)
				{
					TrUndoPush;
					i = TrRollFieldValue(c, tr.roll_field);
					if (i < 0)
						i = 0;
					TrRollFieldSet(c, tr.roll_field, (i << 4 & 0xFF) | n);
				}
				return;
			}
			if (key == CH_ESC)
			{//Give the keyboard back rather than leaving the view.
				tr.roll_edit = FALSE;
				return;
			}
		}
		if (tr.sel_r0 >= 0 && (key == '+' || key == '='))
		{
			TrUndoPush;
			TrRollSelTranspose(1);
			return;
		}
		if (tr.sel_r0 >= 0 && (key == '-' || key == '_'))
		{
			TrUndoPush;
			TrRollSelTranspose(-1);
			return;
		}
		if (tr.sel_r0 >= 0 && (key == ']' || key == '}'))
		{
			TrRollSelTranspose(12);
			return;
		}
		if (tr.sel_r0 >= 0 && (key == '[' || key == '{'))
		{
			TrRollSelTranspose(-12);
			return;
		}
	}

	switch (key)
	{
		case '\t':
			//Tab arrives as a character, not as a bare scan code, so every
			//Tab binding lives here. The SC_TAB case in TrKeyScan never sees
			//one.
			if (flags & SCF_CTRL)
			{//Cycle grid, arrangement, roll.
				TrViewToggle;
				return;
			}
			if (flags & SCF_SHIFT)
				tr.cur_ch = (tr.cur_ch + tr_song.channels - 1) %
							tr_song.channels;
			else
				tr.cur_ch = (tr.cur_ch + 1) % tr_song.channels;
			tr.cur_col = 0;
			return;
		case ' ':
			if (tr.playing)
				TrPlayStop;
			else
			{
				tr.pat_mode = FALSE;
				TrPlayStart(tr.order_sel, 0);
			}
			return;
		case CH_ESC:
			//From the roll, Esc returns to the grid rather than quitting: one
			//key out of a mode is worth more than a second way to exit.
			if (tr.view_mode == TR_VIEW_ROLL)
			{
				tr.view_mode = TR_VIEW_GRID;
				return;
			}
			tr.quit = TRUE;
			return;
		case CH_SHIFT_ESC:
			tr.quit = TRUE;
			return;
		case '\n':
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			return;
		case '-':
			tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			if (tr.pane == TR_PANE_ORDER && tr_song.order_len)
				tr_song.order[tr.order_sel] = tr.cur_pat;
			return;
		case '=':
			tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			if (tr.pane == TR_PANE_ORDER && tr_song.order_len)
				tr_song.order[tr.order_sel] = tr.cur_pat;
			return;
		case '[':
			tr_song.bpm = ClampI64(tr_song.bpm - 1, 32, 255);
			return;
		case ']':
			tr_song.bpm = ClampI64(tr_song.bpm + 1, 32, 255);
			return;
		case ';':
			tr_song.speed = ClampI64(tr_song.speed - 1, 1, 31);
			return;
		case '\'':
			tr_song.speed = ClampI64(tr_song.speed + 1, 1, 31);
			return;
		case ',':
			//The tracker's own gain, separate from the DE's master volume and
			//remembered across song loads.
			tr.user_master	= ClampI64(tr.user_master - 8, 8, 256);
			tr.master		= tr.user_master;
			TrConfigSave;
			return;
		case '.':
			tr.user_master	= ClampI64(tr.user_master + 8, 8, 256);
			tr.master		= tr.user_master;
			TrConfigSave;
			return;
	}

	if (tr.edit)
		TrEditCell(key);
	else if (tr.cur_col == TR_COL_NOTE)
	{//Auditioning without editing.
		n = TrKeyNote(key);
		if (n >= 1 && n <= TR_NOTES)
			TrPreview(n, tr.inst, tr.vol_default);
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
}

U0 TrMenuPush()
{//Native ZealOS pull-down menu. Appears when the mouse reaches the top of the
//screen, or on the GUI key. Entry names are lexed as identifiers, so no spaces.
	MenuPush("File {"
			 "  New(MESSAGE_CMD,TRM_NEW);"
			 "  Load(MESSAGE_CMD,TRM_LOAD);"
			 "  SaveAs(MESSAGE_CMD,TRM_SAVE);"
			 "  LoadSample(MESSAGE_CMD,TRM_LOADSMP);"
			 "  Exit(MESSAGE_CMD,TRM_EXIT);"
			 "}"
			 "Play {"
			 "  Song(MESSAGE_CMD,TRM_PLAY_SONG);"
			 "  Pattern(MESSAGE_CMD,TRM_PLAY_PAT);"
			 "  Stop(MESSAGE_CMD,TRM_STOP);"
			 "  Follow(MESSAGE_CMD,TRM_FOLLOW);"
			 "}"
			 "Edit {"
			 "  EditMode(MESSAGE_CMD,TRM_EDIT);"
			 "  PrevPattern(MESSAGE_CMD,TRM_PAT_PREV);"
			 "  NextPattern(MESSAGE_CMD,TRM_PAT_NEXT);"
			 "  InsertRow(MESSAGE_CMD,TRM_INS_ROW);"
			 "  DeleteRow(MESSAGE_CMD,TRM_DEL_ROW);"
			 "  ClearCell(MESSAGE_CMD,TRM_CLR_CELL);"
			 "  MuteChannel(MESSAGE_CMD,TRM_MUTE);"
			 "}"
			 "View {"
			 "  PatternGrid(MESSAGE_CMD,TRM_VIEW_GRID);"
			 "  Arrangement(MESSAGE_CMD,TRM_VIEW_ARR);"
			 "  PianoRoll(MESSAGE_CMD,TRM_VIEW_ROLL);"
			 "  Instruments(MESSAGE_CMD,TRM_PANE_INST);"
			 "  Order(MESSAGE_CMD,TRM_PANE_ORDER);"
			 "  Macros(MESSAGE_CMD,TRM_PANE_MACRO);"
			 "  Wavetables(MESSAGE_CMD,TRM_PANE_WAVE);"
			 "  Interpolate(MESSAGE_CMD,TRM_INTERP);"
			 "}"
			 "Help {"
			 "  Manual(MESSAGE_CMD,TRM_HELPDOC);"
			 "  Keys(MESSAGE_CMD,TRM_KEYS);"
			 "}");
	//WIG_USER_TASK_DEFAULT does not inhibit the menu, but a task spawned with
	//the system default would. Clear it either way.
	LBtr(&Fs->win_inhibit, WIf_FOCUS_TASK_MENU);
}

U0 TrMenuCheck(U8 *path, Bool on)
{
	CMenuEntry *e = MenuEntryFind(Fs->cur_menu, path);

	if (e)
		e->checked = on;
}

U0 TrMenuSync()
{//Mirror the toggles into the menu so the check marks are not stale when it
//opens. Cheap enough to run every frame.
	TrMenuCheck("Play/Follow", tr.follow);
	TrMenuCheck("Edit/EditMode", tr.edit);
	TrMenuCheck("View/PatternGrid", tr.view_mode == TR_VIEW_GRID);
	TrMenuCheck("View/Arrangement", tr.view_mode == TR_VIEW_ARR);
	TrMenuCheck("View/PianoRoll", tr.view_mode == TR_VIEW_ROLL);
	TrMenuCheck("View/Interpolate", tr.interp);
	TrMenuCheck("View/Instruments", tr.pane == TR_PANE_INST);
	TrMenuCheck("View/Order", tr.pane == TR_PANE_ORDER);
	TrMenuCheck("View/Macros", tr.pane == TR_PANE_MACRO);
	TrMenuCheck("View/Wavetables", tr.pane == TR_PANE_WAVE);
	TrMenuCheck("Help/Keys", tr.pane == TR_PANE_HELP);
	TrMenuCheck("Edit/MuteChannel",
				tr_ch[ClampI64(tr.cur_ch, 0, TR_MAX_VOICES - 1)].mute);
}

U0 TrMenuCmd(I64 cmd)
{
	switch (cmd)
	{
		case TRM_NEW:
			TrMixSuspend;
			TrSongNew(4, 8, 64);
			TrMixResume;
			tr.cur_pat	= 0;
			tr.cur_row	= 0;
			tr.cur_ch	= 0;
			tr.order_sel = 0;
			TrStatus("New song: 4 channels, 8 patterns, 64 rows");
			break;
		case TRM_LOAD:		TrLoadAs;					break;
		case TRM_SAVE:		TrSaveAs;					break;
		case TRM_LOADSMP:	TrLoadSample;				break;
		case TRM_EXIT:		tr.quit = TRUE;				break;
		case TRM_PLAY_SONG:
			tr.pat_mode = FALSE;
			TrPlayStart(0, 0);
			break;
		case TRM_PLAY_PAT:
			tr.pat_mode = TRUE;
			TrPlayStart(tr.order_sel, tr.cur_row);
			break;
		case TRM_STOP:		TrPlayStop;					break;
		case TRM_FOLLOW:	tr.follow = !tr.follow;		break;
		case TRM_EDIT:		tr.edit = !tr.edit;			break;
		case TRM_INS_ROW:	TrRowInsert(tr.cur_ch);		break;
		case TRM_DEL_ROW:	TrRowDelete(tr.cur_ch);		break;
		case TRM_CLR_CELL:	TrEditCell(CH_BACKSPACE);	break;
		case TRM_PANE_INST:	TrMenuPane(TR_PANE_INST);	break;
		case TRM_PANE_ORDER: TrMenuPane(TR_PANE_ORDER);	break;
		case TRM_KEYS:		TrMenuPane(TR_PANE_HELP);	break;
		case TRM_PANE_MACRO: TrMenuPane(TR_PANE_MACRO);	break;
		case TRM_PANE_WAVE:	TrMenuPane(TR_PANE_WAVE);	break;
		case TRM_HELPDOC:
			//The manual is a DolDoc; open it in a pop-up editor the way
			//Psalmody opens its help, then take focus back.
			PopUpEd("::/Doc/YTracker.DD", Fs);
			WinFocus(tr.win_task);
			break;
		case TRM_INTERP:	tr.interp = !tr.interp;		break;
		case TRM_VIEW_GRID:	TrViewSet(TR_VIEW_GRID);	break;
		case TRM_VIEW_ARR:	TrViewSet(TR_VIEW_ARR);		break;
		case TRM_VIEW_ROLL:	TrViewSet(TR_VIEW_ROLL);	break;
		case TRM_PAT_PREV:
			tr.cur_pat = (tr.cur_pat + TR_MAX_PATTERNS - 1) % TR_MAX_PATTERNS;
			break;
		case TRM_PAT_NEXT:
			tr.cur_pat = (tr.cur_pat + 1) % TR_MAX_PATTERNS;
			break;
		case TRM_MUTE:
			if (0 <= tr.cur_ch < tr_song.channels)
				tr_ch[tr.cur_ch].mute = !tr_ch[tr.cur_ch].mute;
			break;
	}
	tr.cur_row = ClampI64(tr.cur_row, 0, TrCurRows() - 1);
}

/* ---------------- pane windows ---------------- */

//A window in ZealOS IS a task: there are no child windows, and the task list
//is the z-order the DE draws and the taskbar lists. A pane is therefore a
//Spawn()ed task that draws the same globals this one does - one address
//space, ring 0, so no message passing is needed to share the song.
//
//Panes only read and write scalar fields. Anything that frees or replaces
//song memory still goes through TrMixSuspend from the main task.

I64 tr_pane_w[TR_PANE_COUNT]	 = {0, TR_PANE_W_HELP, TR_PANE_W_INST,
									TR_PANE_W_ORDER, TR_ED_W, TR_ED_W};
U8 *tr_pane_title[TR_PANE_COUNT] = {"", "YTracker Help", "YTracker Instruments",
									"YTracker Order", "YTracker Macros",
									"YTracker Wavetable"};

U0 TrPaneDrawIt(CTask *task, CDC *dc)
{//The pane draws at its window's origin.
	I64 kind = task->user_data;

	switch (kind)
	{
		case TR_PANE_HELP:	TrDrawPaneHelp(dc, 0, 0);	break;
		case TR_PANE_INST:	TrDrawPaneInst(dc, 0, 0);	break;
		case TR_PANE_ORDER:	TrDrawPaneOrder(dc, 0, 0);	break;
		case TR_PANE_MACRO:	TrDrawPaneMacro(dc, 0, 0);	break;
		case TR_PANE_WAVE:	TrDrawPaneWave(dc, 0, 0);	break;
	}
}

U0 TrPaneWinTask()
{//One pane window. Reads its kind from the handoff the opener set, then
//clears it so the opener knows the task is up.
	I64	 kind = tr.pane_spawn, msg, a1, a2, cols, rows;
	CDoc *bdoc;
	Bool drag = FALSE;

	tr.pane_spawn = 0;
	if (kind < 1 || kind >= TR_PANE_COUNT)
		return;

	DocTermNew;	//a raw Spawn()ed task has no put/display doc of its own yet
	StrCopy(Fs->task_title, tr_pane_title[kind]);
	//Exactly the cells the pane covers. A window is sized in cells, and every
	//pane dimension is a multiple of one, so nothing is left over inside the
	//frame.
	cols = ClampI64(tr_pane_w[kind] / FONT_WIDTH, 8, TEXT_COLS - 2);
	rows = ClampI64(TR_PANE_H / FONT_HEIGHT, 4, TEXT_ROWS - 2);
	WinHorz(2 + kind * 2, 2 + kind * 2 + cols - 1);
	WinVert(3 + kind * 2, 3 + kind * 2 + rows - 1);
	//Frame only, and still draggable. WIF_SELF_BORDER does two jobs: it
	//suppresses the border doc, and it is what the window manager tests
	//before letting the top border be dragged (WinMgr.ZC:939). Inhibiting it
	//costs the drag handle. So the bit stays live and the border DOC is
	//emptied instead - the kernel frame and the drag both survive, and MENU,
	//the title and [X] have nothing left to paint.
	//
	//L_DOWN must also deliver instantly, skipping the double-click timeout,
	//or dragging in the macro editor drops its first press.
	//Built up from the terminal default rather than down from
	//WIG_TASK_DEFAULT: that one inhibits WIF_SELF_MS_L, which is what
	//click-to-focus rides on, and the macro editor is drawn with the mouse.
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT | WIF_FOCUS_TASK_MENU |
					  WIF_FOCUS_TASK_MS_L_D;
	Fs->user_data = kind;
	DocCursor(OFF);
	DocClear;
	//Hide the border doc, which is what paints MENU, the title and [X] over
	//the top border line. DocRecalcLib.ZC:240 draws it only when this flag is
	//clear, so setting it leaves the doc allocated and the pointer valid
	//while nothing of it reaches the screen.
	//
	//NOT DocClear: DocBorderNew builds every entry with +H, and DocClear
	//keeps hold entries unless asked otherwise, so clearing it does nothing.
	bdoc = DocBorder;
	if (bdoc)
		bdoc->flags |= DOCF_DONT_SHOW;
	Fs->draw_it = &TrPaneDrawIt;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinFocus;
	WinToTop;
	WinZBufUpdate;

	while (!tr.quit && !Bt(&tr.pane_close, kind))
	{
		while (msg = MessageScan(&a1, &a2))
			switch (msg)
			{
				case MESSAGE_MS_L_DOWN:
					//Taking a key or a click is what makes a pane the one the
					//keyboard branches in TrKeyScan act on.
					tr.pane = kind;
					if (kind == TR_PANE_MACRO || kind == TR_PANE_WAVE)
					{
						drag = TRUE;
						TrEdClick(a1, a2, 0, 0);
					}
					break;
				case MESSAGE_MS_L_UP:
					drag = FALSE;
					break;
				case MESSAGE_MS_MOVE:
					if (drag)
						TrEdClick(a1, a2, 0, 0);
					break;
				case MESSAGE_KEY_DOWN:
					//Closing a window is delivered as a keypress, not as a
					//Kill: the manager sends CH_SHIFT_ESC to the task whose
					//[X] was clicked (WinMgr.ZC:836-841). Handing that to the
					//shared key handler quits the whole tracker, since that
					//is what Shift-Esc means to the grid. Esc likewise. Both
					//close this pane and nothing else.
					if (a1 == CH_SHIFT_ESC || a1 == CH_ESC)
					{
						LBts(&tr.pane_close, kind);
						break;
					}
					//The other half of the same handler: a click on the
					//border's left end sends CH_CTRLM to open the pull-down
					//menu. These panes inhibit the menu, so it has nowhere to
					//go and must not reach the key handler either.
					if (a1 == CH_CTRLM)
						break;
					tr.pane = kind;
					if (a1)
						TrKeyChar(a1, a2);
					else
						TrKeyScan(a2.u8[0], a2);
					break;
			}
		Sleep(20);
	}

	Fs->draw_it = NULL;
	LBtr(&Fs->display_flags, DISPLAYf_SHOW);
	LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);
	Sleep(40);	//let the in-flight frame stop reading this task's DCs
	LBtr(&tr.pane_close, kind);
	tr.pane_task[kind] = NULL;
	if (tr.pane == kind)
		tr.pane = TR_PANE_NONE;
	DocCursor(ON);
	DocClear;
}

U0 TrPaneWinToggle(I64 kind)
{//Open the pane's window, or ask an open one to close. Closing is a flag the
//task polls rather than a Kill: the window manager may be mid-frame inside
//that task's draw, and killing it there leaves the z-buffer pointing at freed
//DCs.
	if (kind < 1 || kind >= TR_PANE_COUNT)
		return;
	if (TaskValidate(tr.pane_task[kind]))
	{
		LBts(&tr.pane_close, kind);
		return;
	}
	//No window of our own means the test harness, where a pane is state only
	//and the toggle just flips it.
	if (!TaskValidate(tr.win_task))
	{
		if (tr.pane == kind)
			tr.pane = TR_PANE_NONE;
		else
			tr.pane = kind;
		return;
	}
	tr.pane = kind;
	tr.pane_spawn		= kind;
	tr.pane_task[kind]	= Spawn(&TrPaneWinTask, NULL, tr_pane_title[kind], -1,
								tr.win_task);
	//The child clears the handoff once it has read it, so two opens in quick
	//succession cannot cross.
	while (tr.pane_spawn && TaskValidate(tr.pane_task[kind]))
		Sleep(1);
}

U0 TrPaneWinCloseAll()
{//Every pane window down before the song heap goes. They read tr_inst and
//tr_wave every frame.
	I64 i, guard = 0;

	for (i = 1; i < TR_PANE_COUNT; i++)
		if (TaskValidate(tr.pane_task[i]))
			LBts(&tr.pane_close, i);
	for (i = 1; i < TR_PANE_COUNT; i++)
		while (TaskValidate(tr.pane_task[i]) && guard < 200)
		{
			Sleep(10);
			guard++;
		}
	for (i = 1; i < TR_PANE_COUNT; i++)
		if (TaskValidate(tr.pane_task[i]))
		{
			Kill(tr.pane_task[i]);
			tr.pane_task[i] = NULL;
		}
	tr.pane = TR_PANE_NONE;
}
