// Inverse MDCT, window construction and overlap-add. Spec sections 1.3.2 and
// 4.3.1.
//
// Direct O(n*n/2) transform. At blocksize 2048 that is ~2M multiply-adds per
// block per channel; the FFT decomposition replaces it behind this same
// interface when speed matters.
//
// The inner sum steps its angle by a rotation recurrence rather than calling
// Cos per term - two multiplies instead of a transcendental.

#define VM_MAX_N		2048		//blocksize1
#define VM_MAX_CH		2

F64	vm_win_long[VM_MAX_N];			//blocksize1 slope, both halves derived
F64	vm_win_short[VM_MAX_N];
Bool vm_win_ready = FALSE;

F64	vm_lap[VM_MAX_CH * VM_MAX_N];	//right half of the previous block
I64	vm_lap_n = 0;					//its blocksize, 0 = no previous block

F64	vm_tmp[VM_MAX_N];

U0 VMWindowBuild(F64 *w, I64 n)
{//rising slope over n samples. spec 1.3.2 states the window over a full block
 //of 2n; taking only the rise puts 2n in the denominator here.
 //
 //  w[i] = sin(pi/2 * sin^2(pi/(2n) * (i + 0.5)))
 //
 //this satisfies Princen-Bradley, w[i]^2 + w[n-1-i]^2 = 1. using n instead of
 //2n makes the slope symmetric about its own centre, which does not.
	F64 s;
	I64 i;

	for (i = 0; i < n; i++)
	{
		s    = Sin(3.14159265358979323846 / ToF64(2 * n) * (ToF64(i) + 0.5));
		w[i] = Sin(1.57079632679489661923 * s * s);
	}
}

U0 VMInit()
{//declaration initialisers on globals are ignored
	I64 i;

	for (i = 0; i < VM_MAX_CH * VM_MAX_N; i++)
		vm_lap[i] = 0.0;

	vm_lap_n     = 0;
	vm_win_ready = FALSE;
}

U0 VMWindowsReady(I64 bs0, I64 bs1)
{//slopes are per blocksize and never change within a stream
	if (vm_win_ready)
		return;

	VMWindowBuild(vm_win_short, bs0 / 2);
	VMWindowBuild(vm_win_long, bs1 / 2);

	vm_win_ready = TRUE;
}

U0 VMImdct(F64 *spec, F64 *out, I64 n)
{//out[0..n-1] from spec[0..n/2-1].
 //
 //  out[i] = sum X[k] cos(pi/(n/2) * (i + 1/2 + n/4) * (k + 1/2))
 //
 //the k sum advances its angle by a constant step for a fixed i, so cos and
 //sin come from a rotation instead of a call per term
	I64 half = n / 2;
	I64 i;
	I64 k;
	F64 base;
	F64 step;
	F64 c;
	F64 s;
	F64 cs;
	F64 sn;
	F64 nc;
	F64 acc;
	F64 norm = 4.0 / ToF64(n);		//makes this the exact inverse of the
									//unnormalised forward transform; verified
									//by TDAC round trip

	for (i = 0; i < n; i++)
	{
		//angle of the k = 0 term, and the increment per k
		step = 3.14159265358979323846 / ToF64(half) *
			   (ToF64(i) + 0.5 + ToF64(n) / 4.0);
		base = step * 0.5;

		c  = Cos(base);
		s  = Sin(base);
		cs = Cos(step);
		sn = Sin(step);

		acc = 0.0;

		for (k = 0; k < half; k++)
		{
			acc += spec[k] * c;

			//rotate by step
			nc = c * cs - s * sn;
			s  = c * sn + s * cs;
			c  = nc;
		}

		out[i] = acc * norm;
	}
}

U0 VMWindowApply(F64 *v, I64 n, I64 bs0, I64 bs1, Bool blockflag,
	Bool prev_short, Bool next_short)
{//4.3.1. a long block beside a short one has a narrow slope and flat shoulders
	I64	 lws;
	I64	 lwe;
	I64	 rws;
	I64	 rwe;
	I64	 ln;
	I64	 rn;
	F64	*lw;
	F64	*rw;
	I64	 i;

	if (blockflag && prev_short)
	{
		lws = n / 4 - bs0 / 4;
		lwe = n / 4 + bs0 / 4;
		ln  = bs0 / 2;
		lw  = vm_win_short;
	}
	else
	{
		lws = 0;
		lwe = n / 2;
		ln  = n / 2;
		lw  = vm_win_long;
		if (!blockflag)
			lw = vm_win_short;
	}

	if (blockflag && next_short)
	{
		rws = n * 3 / 4 - bs0 / 4;
		rwe = n * 3 / 4 + bs0 / 4;
		rn  = bs0 / 2;
		rw  = vm_win_short;
	}
	else
	{
		rws = n / 2;
		rwe = n;
		rn  = n / 2;
		rw  = vm_win_long;
		if (!blockflag)
			rw = vm_win_short;
	}

	for (i = 0; i < lws; i++)
		v[i] = 0.0;

	for (i = lws; i < lwe; i++)
		v[i] = v[i] * lw[i - lws];

	//flat shoulder between the slopes stays as it is

	for (i = rws; i < rwe; i++)
		v[i] = v[i] * rw[rn - 1 - (i - rws)];

	for (i = rwe; i < n; i++)
		v[i] = 0.0;
}

I64 VMOverlap(F64 *v, I64 n, I64 ch, F64 *pcm)
{//add the previous block's tail to this block's head. returns the sample count
 //ready for output, zero on the very first block.
 //
 //consecutive block centres are (prev_n + n)/4 apart, so that is the hop. the
 //lap buffer holds the previous block's right half starting at its centre;
 //this block's sample 0 lands at (prev_n - n)/4 in those coordinates, negative
 //when this block is the longer one. windows are zero outside their slopes, so
 //a missing contribution on either side is a zero, not an error
	F64	*lap = vm_lap + ch * VM_MAX_N;
	I64	 half = n / 2;
	I64	 prev_half;
	I64	 off;
	I64	 hop;
	I64	 t;
	I64	 ci;
	F64	 acc;

	if (!vm_lap_n)
	{
		for (t = 0; t < half; t++)
			lap[t] = v[half + t];

		return 0;
	}

	prev_half = vm_lap_n / 2;
	off       = (vm_lap_n - n) / 4;
	hop       = (vm_lap_n + n) / 4;

	for (t = 0; t < hop; t++)
	{
		acc = 0.0;

		if (t < prev_half)
			acc += lap[t];

		ci = t - off;
		if (ci >= 0 && ci < half)
			acc += v[ci];

		pcm[t] = acc;
	}

	for (t = 0; t < half; t++)
		lap[t] = v[half + t];

	return hop;
}
