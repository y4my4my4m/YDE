// Vorbis decode probe. Walks the stack one layer at a time and prints where
// the signal dies. Run from the shell:  #include "::/Apps/ZealAmp/RunDebug"

Cd(__DIR__);;

U0 VDbgAbs(F64 *v, I64 n, F64 *peak)
{
	I64 i;
	F64 a;

	for (i = 0; i < n; i++)
	{
		a = v[i];
		if (a < 0.0)
			a = -a;
		if (a > *peak)
			*peak = a;
	}
}

Bool VDbgAnyNonZero(F64 *v, I64 n)
{
	I64 i;

	for (i = 0; i < n; i++)
		if (v[i] != 0.0)
			return TRUE;

	return FALSE;
}

U0 VDbgImdctCheck(I64 n)
{//VMImdct against VMImdctDirect on a fixed LCG input. Rand would make the
 //result unreproducible between runs.
	F64	*spec;
	F64	*a;
	F64	*b;
	I64	 seed = 1;
	I64	 i;
	F64	 d;
	F64	 peak = 0.0;
	F64	 diff = 0.0;

	spec = MAlloc(VM_MAX_N * sizeof(F64));
	a    = MAlloc(VM_MAX_N * sizeof(F64));
	b    = MAlloc(VM_MAX_N * sizeof(F64));

	for (i = 0; i < n / 2; i++)
	{
		seed    = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
		spec[i] = ToF64(seed % 20001) / 10000.0 - 1.0;
	}

	VMImdctDirect(spec, a, n);
	VMImdct(spec, b, n);

	for (i = 0; i < n; i++)
	{
		d = a[i];
		if (d < 0.0)
			d = -d;
		if (d > peak)
			peak = d;

		d = a[i] - b[i];
		if (d < 0.0)
			d = -d;
		if (d > diff)
			diff = d;
	}

	"    n %4d  peak %.9f  max|direct-fft| %.12f  ", n, peak, diff;

	if (diff < peak * 1.0e-9)
		"PASS\n";
	else
		"FAIL\n";

	Free(spec);
	Free(a);
	Free(b);
}

U0 VDbgRun(U8 *path)
{
	U8	*raw;
	I64	 size = 0;
	I64	 pk;
	I64	 got;
	I64	 packets = 0;
	Bool dumped  = FALSE;
	I64	 silent  = 0;
	I64	 i;
	F64	*pcm_l;
	F64	*pcm_r;
	F64	 peak_pcm   = 0.0;
	F64	 peak_l     = 0.0;
	F64	 peak_r     = 0.0;
	F64	 peak_floor = 0.0;
	F64	 peak_spec  = 0.0;
	I64	 slack;
	I64	 slack_min  = 1 << 30;
	I64	 slack_max  = -(1 << 30);
	I64	 slack_bad  = 0;
	I64	 over_tot   = 0;
	I64	 nz_l       = 0;
	I64	 nz_r       = 0;
	I64	 nd_l       = 0;
	I64	 nd_r       = 0;
	CVFloor1 *f;
	CVMapping *m;
	CVResidue *r;

	"\n=== vorbis probe: %s ===\n", path;

	//1. the static table. a zeroed one silences everything downstream
	"1. vf_db_tab[0]   = %.9f\n", vf_db_tab[0];
	"   vf_db_tab[128] = %.9f\n", vf_db_tab[128];
	"   vf_db_tab[255] = %.9f  (must be 1.0)\n", vf_db_tab[255];

	if (!FileFind(path))
	{
		"   FAIL: no such file\n";
		return;
	}

	raw = FileRead(path, &size);
	if (!raw)
	{
		"   FAIL: FileRead returned NULL\n";
		return;
	}
	"2. read %d bytes\n", size;

	OggFree;
	OggInit;
	VBFreeAll;
	VBInit;
	VSFreeAll;
	VSInit;
	VFInit;
	VMInit;

	ogg_src  = raw;
	ogg_size = size;

	if (!OggHeaders)
	{
		"   FAIL: OggHeaders rejected\n";
		Free(raw);
		return;
	}

	"3. %dHz %dch bs0 %d bs1 %d\n",
		ogg_rate, ogg_channels, ogg_blocksize0, ogg_blocksize1;
	"   books %d floors %d res %d map %d mode %d\n",
		vb_book_count, vs_floor_count, vs_residue_count,
		vs_mapping_count, vs_mode_count;

	//4. floor 0's xlist - garbage here means the setup header misparsed
	f = vs_floor[0];
	if (f)
		"4. floor0 mult %d values %d x[0..3] %d %d %d %d\n",
			f->mult, f->values, f->xlist[0], f->xlist[1],
			f->xlist[2], f->xlist[3];

	//4b. the imdct cosine table. built by VMCosReady, gated by vm_ct_half
	VMCosReady(VM_MAX_N / 2);
	VMWindowsReady(ogg_blocksize0, ogg_blocksize1);
	"4b. vm_ct_half   = %d  (must be %d)\n", vm_ct_half, VM_MAX_N / 2;
	"    vm_ct[0]     = %.9f  (must be 1.0)\n", vm_ct[0];
	"    vm_ct[1024]  = %.9f  (must be 0.707106781)\n", vm_ct[1024];
	"    vm_ct[2048]  = %.9f  (must be 0.0)\n", vm_ct[2048];
	"    vm_win_short[64] = %.9f  vm_win_long[512] = %.9f\n",
		vm_win_short[64], vm_win_long[512];

	//4b2. FFT imdct against the direct definition. PASS is a difference under
	//1e-9 of the peak; measured 1e-15 relative on the host
	"4b2. imdct fft vs direct\n";
	VDbgImdctCheck(256);
	VDbgImdctCheck(2048);

	//4c. mapping setup. a misparse here makes residue and coupling meaningless
	m = vs_mapping[0];
	if (m)
	{
		"4c. submaps %d coupling_steps %d\n", m->submaps, m->coupling_steps;
		"    mux[0] %d mux[1] %d  sub_floor[0] %d sub_residue[0] %d\n",
			m->mux[0], m->mux[1], m->sub_floor[0], m->sub_residue[0];
		if (m->coupling_steps > 0)
			"    mag[0] %d ang[0] %d  (must differ, both < %d)\n",
				m->mag[0], m->ang[0], ogg_channels;
	}

	r = vs_residue[0];
	if (r)
		"    res0 type %d begin %d end %d part_size %d class %d book %d\n",
			r->type, r->begin, r->end, r->part_size,
			r->classifications, r->classbook;

	pcm_l = MAlloc(VM_MAX_N * sizeof(F64));
	pcm_r = MAlloc(VM_MAX_N * sizeof(F64));

	//5. decode 60 packets, watching each stage's peak
	while (packets < 2000)
	{
		if (!OggNextPacket)
		{
			"   EOF after %d packets\n", packets;
			break;
		}

		if (!VADecode(pcm_l, pcm_r, &got))
		{
			"   FAIL: VADecode rejected packet %d\n", packets;
			break;
		}

		//a correct decode consumes the packet to the last byte. leftover is 0..7
		//padding bits; anything outside that means a codebook is handing back
		//the wrong symbol and the bit cursor has drifted
		slack = ogg_packet_len * 8 - ogg_bit_pos;
		if (slack < slack_min)	slack_min = slack;
		if (slack > slack_max)	slack_max = slack;
		if (slack > 7 || ogg_bit_over)
			slack_bad++;
		over_tot += ogg_bit_over;

		if (va_no_decode[0])	nd_l++;
		if (va_no_decode[1])	nd_r++;

		//va_floor and vr_v are the decoder's own scratch, sampled after the
		//call: floor curve, then the residue scaled by it
		VDbgAbs(va_floor, 512, &peak_floor);
		VDbgAbs(vr_v, 512, &peak_spec);

		if (got)
		{
			if (VDbgAnyNonZero(pcm_l, got))	nz_l++;
			if (VDbgAnyNonZero(pcm_r, got))	nz_r++;

			VDbgAbs(pcm_l, got, &peak_pcm);
			VDbgAbs(pcm_l, got, &peak_l);
			VDbgAbs(pcm_r, got, &peak_r);
			if (peak_pcm == 0.0)
				silent++;

			//first block with output, for a diff against a reference decoder
			if (!dumped && packets > 30)
			{
				"   pcm_l[0..7] ";
				for (i = 0; i < 8; i++)
					"%.9f ", pcm_l[i];
				"\n   pcm_r[0..7] ";
				for (i = 0; i < 8; i++)
					"%.9f ", pcm_r[i];
				"\n";
				dumped = TRUE;
			}
		}

		packets++;
	}

	"5. packets %d  last got %d  silent %d\n", packets, got, silent;
	"   peak floor curve = %.9f\n", peak_floor;
	"   peak spectrum    = %.9f\n", peak_spec;
	"   peak pcm         = %.9f\n", peak_pcm;
	//a real stereo mix keeps the channels within a few dB of each other
	"   peak L / peak R  = %.9f / %.9f\n", peak_l, peak_r;
	"6. leftover bits min %d max %d  bad on %d of %d packets, %d overruns\n",
		slack_min, slack_max, slack_bad, packets, over_tot;
	"   floor unused L %d R %d   nonzero pcm L %d R %d\n",
		nd_l, nd_r, nz_l, nz_r;

	"\n   verdict: ";
	if (slack_bad)
		"bit cursor drifts - a codebook decodes to the wrong symbol\n";
	else if (peak_floor == 0.0)
		"floor curve is zero - vf_db_tab or VFDecode\n";
	else if (peak_spec == 0.0)
		"floor ok, spectrum zero - residue or dot product\n";
	else if (peak_pcm == 0.0)
		"spectrum ok, pcm zero - VMImdct or window\n";
	else
		"decode produces audio; fault is downstream in the app\n";

	Free(pcm_l);
	Free(pcm_r);
	Free(raw);
	OggFree;
}

VDbgRun("::/Apps/QuakePlus/qbj3/music/track121.ogg");
