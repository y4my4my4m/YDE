// Floor 1 decode and curve synthesis. Spec sections 7.2.3 and 7.2.4.

#define VF_MAX_N		4096		//blocksize1 / 2, the widest curve

I64	vf_y[VS_MAX_XLIST];			//unpacked Y, packet order
I64	vf_fy[VS_MAX_XLIST];		//after neighbour prediction
Bool vf_step2[VS_MAX_XLIST];
I64	vf_order[VS_MAX_XLIST];		//xlist indices sorted by x

//amplitude lookup, 256 entries, indexed by Y * mult clamped to 255.
//NOT PRESENT: the spec gives this as a literal table and it has not been
//transcribed. Every curve is flat until it is.
F64	vf_db[256];
Bool vf_db_ready = FALSE;

U0 VFInit()
{//declaration initialisers on globals are ignored
	I64 i;

	for (i = 0; i < 256; i++)
		vf_db[i] = 1.0;

	vf_db_ready = FALSE;
}

I64 VFLowNeighbour(I64 *x, I64 n)
{//largest x[k] < x[n], k < n. -1 when none
	I64 best = -1;
	I64 i;

	for (i = 0; i < n; i++)
		if (x[i] < x[n] && (best < 0 || x[i] > x[best]))
			best = i;

	return best;
}

I64 VFHighNeighbour(I64 *x, I64 n)
{//smallest x[k] > x[n], k < n. -1 when none
	I64 best = -1;
	I64 i;

	for (i = 0; i < n; i++)
		if (x[i] > x[n] && (best < 0 || x[i] < x[best]))
			best = i;

	return best;
}

I64 VFRenderPoint(I64 x0, I64 y0, I64 x1, I64 y1, I64 x)
{//7.2.4, the integer line evaluation the predictor uses
	I64 dy  = y1 - y0;
	I64 adx = x1 - x0;
	I64 ady;
	I64 err;
	I64 off;

	if (adx < 1)
		return y0;

	ady = dy;
	if (ady < 0)
		ady = -ady;

	err = ady * (x - x0);
	off = err / adx;

	if (dy < 0)
		return y0 - off;

	return y0 + off;
}

U0 VFRenderLine(I64 x0, I64 y0, I64 x1, I64 y1, F64 *out, I64 n)
{//7.2.4. Bresenham, one output sample per x, scaled by the dB lookup
	I64 dy   = y1 - y0;
	I64 adx  = x1 - x0;
	I64 ady;
	I64 base;
	I64 sy;
	I64 err = 0;
	I64 x;
	I64 y   = y0;

	if (adx < 1)
		return;

	ady = dy;
	if (ady < 0)
		ady = -ady;

	base = dy / adx;

	if (dy < 0)
		sy = base - 1;
	else
		sy = base + 1;

	ady = ady - AbsI64(base) * adx;

	if (x0 < 0)
		x0 = 0;
	if (x1 > n)
		x1 = n;

	for (x = x0; x < x1; x++)
	{
		out[x] = vf_db[ClampI64(y, 0, 255)];

		err += ady;
		if (err >= adx)
		{
			err -= adx;
			y   += sy;
		}
		else
			y += base;
	}
}

Bool VFDecode(CVFloor1 *f, F64 *out, I64 n)
{//7.2.3 unpack then 7.2.4 synthesis. FALSE means the floor is unused this
 //frame and the channel is silent
	I64 range;
	I64 i;
	I64 j;
	I64 k;
	I64 cls;
	I64 cdim;
	I64 cbits;
	I64 csub;
	I64 cval;
	I64 bk;
	I64 offset;
	I64 low;
	I64 high;
	I64 pred;
	I64 val;
	I64 highroom;
	I64 lowroom;
	I64 room;
	I64 hx;
	I64 hy;
	I64 lx;
	I64 ly;
	I64 tmp;

	if (!OggGetBits(1))
		return FALSE;

	//mult 1..4 selects the Y range
	range = 256;
	if (f->mult == 2)	range = 128;
	if (f->mult == 3)	range = 86;
	if (f->mult == 4)	range = 64;

	vf_y[0] = OggGetBits(VBILog(range - 1));
	vf_y[1] = OggGetBits(VBILog(range - 1));
	offset  = 2;

	for (i = 0; i < f->partitions; i++)
	{
		cls   = f->part_class[i];
		cdim  = f->class_dims[cls];
		cbits = f->class_subs[cls];
		csub  = (1 << cbits) - 1;
		cval  = 0;

		if (cbits)
		{
			cval = VBDecodeScalar(vb_book[f->class_book[cls]]);
			if (cval < 0)
				return FALSE;
		}

		for (j = 0; j < cdim; j++)
		{
			bk    = f->sub_book[cls * 8 + (cval & csub)];
			cval  = cval >> cbits;

			if (bk >= 0)
			{
				vf_y[offset + j] = VBDecodeScalar(vb_book[bk]);
				if (vf_y[offset + j] < 0)
					return FALSE;
			}
			else
				vf_y[offset + j] = 0;
		}

		offset += cdim;
	}

	//neighbour prediction. a zero value means "on the predicted line"
	vf_step2[0] = TRUE;
	vf_step2[1] = TRUE;
	vf_fy[0]    = vf_y[0];
	vf_fy[1]    = vf_y[1];

	for (i = 2; i < f->values; i++)
	{
		low  = VFLowNeighbour(f->xlist, i);
		high = VFHighNeighbour(f->xlist, i);

		pred = VFRenderPoint(f->xlist[low], vf_fy[low],
					f->xlist[high], vf_fy[high], f->xlist[i]);

		val      = vf_y[i];
		highroom = range - pred;
		lowroom  = pred;

		if (highroom < lowroom)
			room = highroom * 2;
		else
			room = lowroom * 2;

		if (val)
		{
			vf_step2[low]  = TRUE;
			vf_step2[high] = TRUE;
			vf_step2[i]    = TRUE;

			if (val >= room)
			{
				if (highroom > lowroom)
					vf_fy[i] = val - lowroom + pred;
				else
					vf_fy[i] = pred - val + highroom - 1;
			}
			else
			{
				if (val & 1)
					vf_fy[i] = pred - ((val + 1) >> 1);
				else
					vf_fy[i] = pred + (val >> 1);
			}
		}
		else
		{
			vf_step2[i] = FALSE;
			vf_fy[i]    = pred;
		}
	}

	//sort the x positions; the curve is drawn between consecutive kept points
	for (i = 0; i < f->values; i++)
		vf_order[i] = i;

	for (i = 1; i < f->values; i++)
	{
		tmp = vf_order[i];
		j   = i - 1;

		while (j >= 0 && f->xlist[vf_order[j]] > f->xlist[tmp])
		{
			vf_order[j + 1] = vf_order[j];
			j--;
		}

		vf_order[j + 1] = tmp;
	}

	hx = 0;
	hy = 0;
	lx = 0;
	ly = vf_fy[vf_order[0]] * f->mult;

	for (i = 1; i < f->values; i++)
	{
		k = vf_order[i];

		if (!vf_step2[k])
			goto vfd_next;

		hx = f->xlist[k];
		hy = vf_fy[k] * f->mult;

		if (lx < n)
			VFRenderLine(lx, ly, hx, hy, out, n);

		lx = hx;
		ly = hy;

vfd_next:
	}

	//past the last point the curve holds its value
	if (lx < n)
		for (i = lx; i < n; i++)
			out[i] = vf_db[ClampI64(ly, 0, 255)];

	return TRUE;
}
