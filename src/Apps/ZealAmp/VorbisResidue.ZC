// Residue decode and inverse coupling. Spec sections 8.6.4 and 8.6.5.
//
// Type 2 decodes every channel of a submap as one interleaved vector, then
// de-interleaves. Types 0 and 1 decode each channel separately.

#define VR_MAX_CH			2
#define VR_MAX_N			4096		//blocksize1 / 2
#define VR_MAX_PARTS		2048

F64	vr_v[VR_MAX_CH * VR_MAX_N];			//per channel spectrum, n/2 each
F64	vr_flat[VR_MAX_CH * VR_MAX_N];		//type 2 interleaved scratch
I64	vr_class[VR_MAX_CH * VR_MAX_PARTS];

U0 VRClear(I64 ch, I64 n)
{
	I64 i;
	I64 total = ch * n;

	for (i = 0; i < total; i++)
		vr_v[i] = 0.0;
}

U0 VRPartition(CVBook *b, F64 *v, I64 offset, I64 size, I64 type)
{//one partition through one book. type 0 spreads a vector across the
 //partition with a stride; 1 and 2 write it flat
	I64 entry;
	I64 step;
	I64 i;
	I64 j;

	if (!b || b->dims < 1)
		return;

	if (!type)
	{
		step = size / b->dims;

		for (i = 0; i < step; i++)
		{
			entry = VBDecodeScalar(b);
			if (entry < 0)
				return;

			for (j = 0; j < b->dims; j++)
				v[offset + i + j * step] += b->mult[entry * b->dims + j];
		}

		return;
	}

	i = 0;
	while (i < size)
	{
		entry = VBDecodeScalar(b);
		if (entry < 0)
			return;

		for (j = 0; j < b->dims; j++)
		{
			if (i >= size)
				return;

			v[offset + i] += b->mult[entry * b->dims + j];
			i++;
		}
	}
}

Bool VRDecodeInto(CVResidue *r, F64 *v, I64 ch, I64 n, Bool *no_decode)
{//8.6.4. v holds ch vectors of n values, contiguous
	CVBook	*cb;
	I64		 limit_begin;
	I64		 limit_end;
	I64		 to_read;
	I64		 parts;
	I64		 classwords;
	I64		 pass;
	I64		 pc;
	I64		 i;
	I64		 j;
	I64		 k;
	I64		 temp;
	I64		 vqclass;
	I64		 vqbook;
	I64		 off;

	cb = vb_book[r->classbook];
	if (!cb || cb->dims < 1)
		return FALSE;

	limit_begin = r->begin;
	limit_end   = r->end;

	if (limit_begin > n)	limit_begin = n;
	if (limit_end > n)		limit_end = n;

	to_read = limit_end - limit_begin;
	if (to_read <= 0)
		return TRUE;

	parts = to_read / r->part_size;
	if (parts > VR_MAX_PARTS)
		return FALSE;

	classwords = cb->dims;

	for (pass = 0; pass < 8; pass++)
	{
		pc = 0;

		while (pc < parts)
		{
			if (!pass)
			{
				//one classbook entry packs classwords partition classes,
				//least significant first
				for (j = 0; j < ch; j++)
				{
					if (no_decode[j])
						goto vrd_next_ch;

					temp = VBDecodeScalar(cb);
					if (temp < 0)
						return FALSE;

					for (i = classwords - 1; i >= 0; i--)
					{
						if (pc + i < parts)
							vr_class[j * VR_MAX_PARTS + pc + i] =
								temp % r->classifications;

						temp = temp / r->classifications;
					}

vrd_next_ch:
				}
			}

			for (i = 0; i < classwords; i++)
			{
				if (pc >= parts)
					goto vrd_pass_done;

				for (j = 0; j < ch; j++)
				{
					if (no_decode[j])
						goto vrd_next_ch2;

					vqclass = vr_class[j * VR_MAX_PARTS + pc];
					vqbook  = r->book[vqclass * 8 + pass];

					if (vqbook < 0)
						goto vrd_next_ch2;

					off = limit_begin + pc * r->part_size;

					VRPartition(vb_book[vqbook], v + j * n, off,
						r->part_size, r->type);

vrd_next_ch2:
				}

				pc++;
			}

vrd_pass_done:
		}
	}

	return TRUE;
}

Bool VRDecode(CVResidue *r, I64 ch, I64 n, Bool *no_decode)
{//type 2 folds the channels into one vector before decoding, then splits it
	Bool	one[VR_MAX_CH];
	I64		i;
	I64		j;
	Bool	all_silent = TRUE;

	if (ch < 1 || ch > VR_MAX_CH || n > VR_MAX_N)
		return FALSE;

	if (r->type != 2)
		return VRDecodeInto(r, vr_v, ch, n, no_decode);

	for (i = 0; i < ch; i++)
		if (!no_decode[i])
			all_silent = FALSE;

	if (all_silent)
		return TRUE;

	for (i = 0; i < ch * n; i++)
		vr_flat[i] = 0.0;

	one[0] = FALSE;

	if (!VRDecodeInto(r, vr_flat, 1, ch * n, one))
		return FALSE;

	//de-interleave: sample i of channel j sits at i * ch + j
	for (i = 0; i < n; i++)
		for (j = 0; j < ch; j++)
			vr_v[j * n + i] += vr_flat[i * ch + j];

	return TRUE;
}

U0 VRInverseCouple(CVMapping *m, I64 n)
{//8.6.5, applied in reverse step order
	F64	*mg;
	F64	*an;
	F64	 a;
	F64	 b;
	I64	 i;
	I64	 j;

	for (i = m->coupling_steps - 1; i >= 0; i--)
	{
		mg = vr_v + m->mag[i] * n;
		an = vr_v + m->ang[i] * n;

		for (j = 0; j < n; j++)
		{
			if (mg[j] > 0.0)
			{
				if (an[j] > 0.0)
				{
					a = mg[j];
					b = mg[j] - an[j];
				}
				else
				{
					b = mg[j];
					a = mg[j] + an[j];
				}
			}
			else
			{
				if (an[j] > 0.0)
				{
					a = mg[j];
					b = mg[j] + an[j];
				}
				else
				{
					b = mg[j];
					a = mg[j] - an[j];
				}
			}

			mg[j] = a;
			an[j] = b;
		}
	}
}
