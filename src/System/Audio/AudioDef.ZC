//Audio device selection. One PCM sink is active at a time; the software mixer
//in Mixer.ZC is shared by every driver.
//
//Selection happens in AudioDev.ZC after all drivers are compiled in.

#define AUDIO_DEV_NONE	0
#define AUDIO_DEV_AC97	1
#define AUDIO_DEV_HDA	2
#define AUDIO_DEV_USB	3

//mixer output rate; sets each voice's resample step
#define QSND_MIX_RATE	48000

I64		audio_dev		= AUDIO_DEV_NONE;
Bool	audio_present	= FALSE;
I64		audio_volume	= 80;	//0-100 master, cached across driver selection

//0..256, applied in AudioOutputMix before the clamp. Set by drivers with no
//hardware volume register. AC97 drives its mixer register and leaves this at
//unity.
I64 audio_mix_vol = 256;

//installed by the active driver's init
U0 (*fp_audio_vol_set)(I64 pct) = NULL;
