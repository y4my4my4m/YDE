//Software mixer. Hardware independent; drivers call AudioOutputMix to fill one
//DMA buffer. Streams are CFifoI64s of U32 frames (L16|R16<<16, 48kHz).
//No device found -> audio_present=FALSE and every entry point no-ops.

#define AUDIO_MAX_STREAMS			4
#define AUDIO_STREAM_FIFO_FRAMES	262144 //~5.4s of 48kHz stereo per stream.

class CAudioStream
{
	CFifoI64 *data;
};

//sfx voices
//A voice REFERENCES the caller's PCM instead of copying it into a FIFO. The frames
//passed in must stay valid until playback finishes or AudioSFXStopAll is called.
#define AUDIO_MAX_SFX_VOICES	48
#define AUDIO_VOL_UNITY			256

class CAudioVoice
{
	U32	*frames;	//borrowed, NOT owned
	I64	 count;
	I64	 pos_fp;	//16.16 position into frames[]
	I64	 step_fp;	//16.16 source samples advanced per output sample
	I64	 vol_l;		//0..AUDIO_VOL_UNITY
	I64	 vol_r;
	I64	 serial;	//bumped on every allocation; see AudioSFXStop
	Bool active;

	//a looping voice never finishes on its own: at the end of the buffer the
	//position wraps instead of clearing 'active'
	Bool loop;
};

//handle = slot + serial. The serial must be checked too: the slot may already have
//been reused by the time a caller stops a voice.
#define AUDIO_VOICE_SHIFT	8

class CAudio
{
	CAudioStream output[AUDIO_MAX_STREAMS];
	I64			 output_frames[AUDIO_MAX_STREAMS];
	CAudioVoice	 voice[AUDIO_MAX_SFX_VOICES];
	I64			 voice_lock;
} audio;

//room DSP (GoldSrc / Xash SX_RoomFX, SFX bus only)
// env_sound publishes a roomtype; the closed HL engine ran SX_RoomFX on the SFX
// paint buffer. Streams (CD/MP3) stay dry.
// Presets from Xash rgsxpre[] (s_dsp.c), delays scaled to QSND_MIX_RATE wall time.
// Deviation: no modulation/xfade; one-pole LP instead of 3-tap average.

#define AUDIO_DSP_MONO_MAX	19200	//MAX_MONO_DELAY 0.4s @ 48k
#define AUDIO_DSP_RVB_MAX	4800	//MAX_REVERB_DELAY 0.1s
#define AUDIO_DSP_STE_MAX	4800	//MAX_STEREO_DELAY 0.1s
#define AUDIO_DSP_PRESETS	29

class CAudioDSPPreset
{//scaled Xash sx_preset_t at mix rate
	I64	 size;		//reverb delay samples
	I64	 refl;		//reverb feedback 0..255
	I64	 rvblp;
	I64	 delay;		//mono delay samples
	I64	 delay_fb;	//mono feedback 0..255
	I64	 dlylp;
	I64	 ste;		//stereo delay samples
	I64	 room_lp;	//global lowpass on dry+wet (water)
};

class CAudioDSPLine
{
	I64	*buf;
	I64	 max;
	I64	 len;		//active delay in samples
	I64	 in;
	I64	 out;
	I64	 fb;		//0..255
	I64	 lp;
	I64	 lp0;
};

CAudioDSPPreset	audio_dsp_pre[AUDIO_DSP_PRESETS];
CAudioDSPLine	audio_dsp_mono;
CAudioDSPLine	audio_dsp_rvb0;
CAudioDSPLine	audio_dsp_rvb1;
CAudioDSPLine	audio_dsp_ste;
I64				audio_dsp_mono_buf[AUDIO_DSP_MONO_MAX];
I64				audio_dsp_rvb0_buf[AUDIO_DSP_RVB_MAX];
I64				audio_dsp_rvb1_buf[AUDIO_DSP_RVB_MAX];
I64				audio_dsp_ste_buf[AUDIO_DSP_STE_MAX];
I64				audio_dsp_room	= 0;
Bool			audio_dsp_off	= FALSE;
Bool			audio_dsp_room_lp = FALSE;
I64				audio_dsp_glp0	= 0;

I64 AudioDSPClip16(I64 v)
{
	if (v >  32767)	return  32767;
	if (v < -32768)	return -32768;
	return v;
}

U0 AudioDSPLineClear(CAudioDSPLine *d)
{
	I64 i;

	for (i = 0; i < d->max; i++)
		d->buf[i] = 0;

	d->lp0 = 0;
}

U0 AudioDSPLineSetup(CAudioDSPLine *d, I64 samples, I64 fb, I64 lp)
{
	if (samples < 1)
		samples = 0;

	if (samples >= d->max)
		samples = d->max - 1;

	d->len = samples;
	d->fb  = fb;
	d->lp  = lp;

	AudioDSPLineClear(d);

	//out trails in by `len` samples; clearing these to zero leaves in==out.
	d->in = 0;

	if (samples > 0)
		d->out = d->max - samples;
	else
		d->out = 0;
}

U0 AudioDSPLineAdvance(CAudioDSPLine *d)
{
	d->in++;
	if (d->in >= d->max)
		d->in = 0;

	d->out++;
	if (d->out >= d->max)
		d->out = 0;
}

I64 AudioDSPLineTap(CAudioDSPLine *d, I64 vlr)
{//write vlr+feedback*tap into line; return stored value (Xash RVB path)
	I64 delay;
	I64 val;

	if (d->len < 1)
		return 0;

	delay = d->buf[d->out];
	val   = vlr + ((d->fb * delay) >> 8);
	val   = AudioDSPClip16(val);

	if (d->lp)
	{
		val    = (d->lp0 + val) >> 1;
		d->lp0 = val;
	}

	d->buf[d->in] = val;
	AudioDSPLineAdvance(d);
	return val;
}

U0 AudioDSPPresetsInit()
{//rgsxpre[], Xash s_dsp.c. Float delays -> samples at QSND_MIX_RATE.
 //Columns: size, refl, rvblp, delay, feedback, dlylp, left(ste)
	I64 i;

	for (i = 0; i < AUDIO_DSP_PRESETS; i++)
	{
		audio_dsp_pre[i].size     = 0;
		audio_dsp_pre[i].refl     = 0;
		audio_dsp_pre[i].rvblp    = 1;
		audio_dsp_pre[i].delay    = 0;
		audio_dsp_pre[i].delay_fb = 0;
		audio_dsp_pre[i].dlylp    = 0;
		audio_dsp_pre[i].ste      = 0;
		audio_dsp_pre[i].room_lp  = 0;
	}

	//1 generic
	audio_dsp_pre[1].delay = 3120;	audio_dsp_pre[1].delay_fb = 25;
	audio_dsp_pre[1].ste = 480;
	//2-4 metal
	audio_dsp_pre[2].delay = 960;	audio_dsp_pre[2].delay_fb = 191;	audio_dsp_pre[2].ste = 480;
	audio_dsp_pre[3].delay = 1440;	audio_dsp_pre[3].delay_fb = 198;	audio_dsp_pre[3].ste = 960;
	audio_dsp_pre[4].delay = 2880;	audio_dsp_pre[4].delay_fb = 196;	audio_dsp_pre[4].ste = 1440;
	//5-7 tunnel
	audio_dsp_pre[5].size = 2400; audio_dsp_pre[5].refl = 216; audio_dsp_pre[5].delay = 384;
	audio_dsp_pre[5].delay_fb = 244; audio_dsp_pre[5].dlylp = 1; audio_dsp_pre[5].ste = 480;
	audio_dsp_pre[6].size = 2400; audio_dsp_pre[6].refl = 224; audio_dsp_pre[6].delay = 480;
	audio_dsp_pre[6].delay_fb = 249; audio_dsp_pre[6].dlylp = 1; audio_dsp_pre[6].ste = 960;
	audio_dsp_pre[7].size = 2400; audio_dsp_pre[7].refl = 234; audio_dsp_pre[7].delay = 720;
	audio_dsp_pre[7].delay_fb = 253; audio_dsp_pre[7].dlylp = 1; audio_dsp_pre[7].ste = 1920;
	//8-10 chamber
	audio_dsp_pre[8].size = 2400;  audio_dsp_pre[8].refl = 214;  audio_dsp_pre[8].ste = 576;
	audio_dsp_pre[9].size = 2400;  audio_dsp_pre[9].refl = 229;  audio_dsp_pre[9].ste = 384;
	audio_dsp_pre[10].size = 2400; audio_dsp_pre[10].refl = 242; audio_dsp_pre[10].ste = 192;
	//11-13 bright (rvblp off)
	audio_dsp_pre[11].size = 2400; audio_dsp_pre[11].refl = 178; audio_dsp_pre[11].rvblp = 0; audio_dsp_pre[11].ste = 576;
	audio_dsp_pre[12].size = 2640; audio_dsp_pre[12].refl = 198; audio_dsp_pre[12].rvblp = 0; audio_dsp_pre[12].ste = 384;
	audio_dsp_pre[13].size = 2400; audio_dsp_pre[13].refl = 219; audio_dsp_pre[13].rvblp = 0; audio_dsp_pre[13].ste = 96;
	//14-16 water
	audio_dsp_pre[14].room_lp = 1; audio_dsp_pre[14].ste = 480;
	audio_dsp_pre[15].room_lp = 1; audio_dsp_pre[15].delay = 2880; audio_dsp_pre[15].delay_fb = 216;
	audio_dsp_pre[15].dlylp = 1; audio_dsp_pre[15].ste = 960;
	audio_dsp_pre[16].room_lp = 1; audio_dsp_pre[16].delay = 9600; audio_dsp_pre[16].delay_fb = 153;
	audio_dsp_pre[16].dlylp = 1; audio_dsp_pre[16].ste = 2400;
	//17-19 concrete
	audio_dsp_pre[17].size = 2400; audio_dsp_pre[17].refl = 204; audio_dsp_pre[17].delay_fb = 122;
	audio_dsp_pre[17].dlylp = 1; audio_dsp_pre[17].ste = 768;
	audio_dsp_pre[18].size = 2880; audio_dsp_pre[18].refl = 229; audio_dsp_pre[18].delay_fb = 132;
	audio_dsp_pre[18].dlylp = 1; audio_dsp_pre[18].ste = 480;
	audio_dsp_pre[19].size = 3360; audio_dsp_pre[19].refl = 239; audio_dsp_pre[19].delay = 14400;
	audio_dsp_pre[19].delay_fb = 153; audio_dsp_pre[19].dlylp = 1; audio_dsp_pre[19].ste = 384;
	//20-22 outside / big
	audio_dsp_pre[20].delay = 14400; audio_dsp_pre[20].delay_fb = 107; audio_dsp_pre[20].dlylp = 1;
	audio_dsp_pre[21].delay = 16800; audio_dsp_pre[21].delay_fb = 122; audio_dsp_pre[21].dlylp = 1;
	audio_dsp_pre[22].delay = 18240; audio_dsp_pre[22].delay_fb = 153; audio_dsp_pre[22].dlylp = 1;
	//23-25 cavern
	audio_dsp_pre[23].size = 2400; audio_dsp_pre[23].refl = 229; audio_dsp_pre[23].delay = 9600;
	audio_dsp_pre[23].delay_fb = 71;
	audio_dsp_pre[24].size = 3360; audio_dsp_pre[24].refl = 229; audio_dsp_pre[24].delay = 14400;
	audio_dsp_pre[24].delay_fb = 102;
	audio_dsp_pre[25].size = 4320; audio_dsp_pre[25].refl = 229; audio_dsp_pre[25].delay = 16800;
	audio_dsp_pre[25].delay_fb = 127;
	//26-28 weirdo
	audio_dsp_pre[26].size = 480;  audio_dsp_pre[26].refl = 229; audio_dsp_pre[26].rvblp = 0;
	audio_dsp_pre[26].ste = 2400;
	audio_dsp_pre[27].delay = 432; audio_dsp_pre[27].delay_fb = 254; audio_dsp_pre[27].dlylp = 1;
	audio_dsp_pre[27].ste = 1920;
	audio_dsp_pre[28].size = 48; audio_dsp_pre[28].refl = 254; audio_dsp_pre[28].rvblp = 0;
	audio_dsp_pre[28].delay = 9600; audio_dsp_pre[28].delay_fb = 204; audio_dsp_pre[28].dlylp = 1;
	audio_dsp_pre[28].ste = 2400;
}

U0 AudioDSPApplyRoom(I64 rt)
{
	CAudioDSPPreset *p;
	I64				 size2;

	if (rt < 0 || rt >= AUDIO_DSP_PRESETS)
		rt = 0;

	audio_dsp_room = rt;
	audio_dsp_glp0 = 0;

	if (rt == 0 || audio_dsp_off)
	{
		audio_dsp_mono.len = 0;
		audio_dsp_rvb0.len = 0;
		audio_dsp_rvb1.len = 0;
		audio_dsp_ste.len  = 0;
		audio_dsp_room_lp  = FALSE;
		AudioDSPLineClear(&audio_dsp_mono);
		AudioDSPLineClear(&audio_dsp_rvb0);
		AudioDSPLineClear(&audio_dsp_rvb1);
		AudioDSPLineClear(&audio_dsp_ste);
		return;
	}

	p = &audio_dsp_pre[rt];
	audio_dsp_room_lp = ToBool(p->room_lp);

	AudioDSPLineSetup(&audio_dsp_mono, p->delay, p->delay_fb, p->dlylp);
	AudioDSPLineSetup(&audio_dsp_rvb0, p->size, p->refl, p->rvblp);

	size2 = (p->size * 71) / 100;
	AudioDSPLineSetup(&audio_dsp_rvb1, size2, p->refl, p->rvblp);
	AudioDSPLineSetup(&audio_dsp_ste, p->ste, 0, 0);
}

public U0 AudioDSPRoomSet(I64 roomtype)
{//room_type cvar / env_sound. 0 = off.
	if (roomtype < 0 || roomtype >= AUDIO_DSP_PRESETS)
		roomtype = 0;

	if (roomtype == audio_dsp_room && !audio_dsp_off)
		return;

	AudioDSPApplyRoom(roomtype);
}

public U0 AudioDSPRoomOff(Bool off)
{//room_off. Non-zero disables DSP entirely.
	audio_dsp_off = off;
	AudioDSPApplyRoom(audio_dsp_room);
}

U0 AudioDSPProcess(I64 *_l, I64 *_r)
{//SX_RoomFX on one SFX sample pair: reverb + mono delay + stereo slap, in place.
	I64 l = *_l;
	I64 r = *_r;
	I64 vlr;
	I64 wet;
	I64 delay;
	I64 val;

	if (audio_dsp_off || audio_dsp_room == 0)
		return;

	vlr = (l + r) >> 1;

	//reverb: average of two delay lines, add quarter gain (Xash >>= 2 path)
	wet = 0;
	if (audio_dsp_rvb0.len > 0)
		wet += AudioDSPLineTap(&audio_dsp_rvb0, vlr);
	if (audio_dsp_rvb1.len > 0)
		wet += AudioDSPLineTap(&audio_dsp_rvb1, vlr);
	wet >>= 2;

	l = AudioDSPClip16(l + wet);
	r = AudioDSPClip16(r + wet);

	if (audio_dsp_mono.len > 0)
	{
		delay = audio_dsp_mono.buf[audio_dsp_mono.out];
		val   = vlr + ((audio_dsp_mono.fb * delay) >> 8);
		val   = AudioDSPClip16(val);

		if (audio_dsp_mono.lp)
		{
			val = (audio_dsp_mono.lp0 + val) >> 1;
			audio_dsp_mono.lp0 = val;
		}

		audio_dsp_mono.buf[audio_dsp_mono.in] = val;
		AudioDSPLineAdvance(&audio_dsp_mono);

		//Xash DLY path is >>= 2. Half gain when no reverb line is active.
		if (audio_dsp_rvb0.len < 1 && audio_dsp_rvb1.len < 1)
			val >>= 1;
		else
			val >>= 2;

		l = AudioDSPClip16(l + val);
		r = AudioDSPClip16(r + val);
	}

		//Deviation: Xash DLY_DoStereoDelay replaces paint->left with a delayed copy,
		//which collapses pan on an already spatialised bus. ste is skipped.

	if (audio_dsp_room_lp)
	{
		l = (audio_dsp_glp0 + l) >> 1;
		r = (audio_dsp_glp0 + r) >> 1;
		audio_dsp_glp0 = (l + r) >> 1;
	}

	*_l = l;
	*_r = r;
}

U0 AudioInit()
{
	I64 i;

	for (i = 0; i < AUDIO_MAX_STREAMS; i++)
		audio.output[i].data = FifoI64New(AUDIO_STREAM_FIFO_FRAMES, sys_task);

	audio.voice_lock = 0;
	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		audio.voice[i].active  = FALSE;
		audio.voice[i].frames  = NULL;
		audio.voice[i].serial  = 0;
		audio.voice[i].count   = 0;
		audio.voice[i].pos_fp  = 0;
		audio.voice[i].step_fp = 1 << 16;
		audio.voice[i].loop    = FALSE;
	}

	audio_dsp_mono.buf = audio_dsp_mono_buf;
	audio_dsp_mono.max = AUDIO_DSP_MONO_MAX;
	audio_dsp_rvb0.buf = audio_dsp_rvb0_buf;
	audio_dsp_rvb0.max = AUDIO_DSP_RVB_MAX;
	audio_dsp_rvb1.buf = audio_dsp_rvb1_buf;
	audio_dsp_rvb1.max = AUDIO_DSP_RVB_MAX;
	audio_dsp_ste.buf  = audio_dsp_ste_buf;
	audio_dsp_ste.max  = AUDIO_DSP_STE_MAX;

	AudioDSPPresetsInit;
	audio_dsp_room = 0;
	audio_dsp_off  = FALSE;
	AudioDSPApplyRoom(0);
}

public I64 AudioSFXPlayRef(U32 *frames, I64 count, I64 rate = QSND_MIX_RATE,
	I64 vol_l = AUDIO_VOL_UNITY, I64 vol_r = AUDIO_VOL_UNITY,
	Bool loop = FALSE)
{//Play frames WITHOUT copying, resampling rate -> mixer rate. Returns a handle,
 //or -1 if all voices are busy. The buffer must outlive playback; a looping voice
 //never frees itself.
	I64 i;
	I64 slot = -1;

	if (!frames || count < 1)
		return -1;

	if (rate < 1)
		rate = QSND_MIX_RATE;

	if (vol_l < 0)					vol_l = 0;
	if (vol_l > AUDIO_VOL_UNITY)	vol_l = AUDIO_VOL_UNITY;
	if (vol_r < 0)					vol_r = 0;
	if (vol_r > AUDIO_VOL_UNITY)	vol_r = AUDIO_VOL_UNITY;

	//task-only contention (the mixer is a task, not an interrupt), so a plain spin with Yield is safe
	while (LBts(&audio.voice_lock, 0))
		Yield;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		if (!audio.voice[i].active)
		{
			slot = i;
			break;
		}
	}

	if (slot >= 0)
	{
		audio.voice[slot].frames  = frames;
		audio.voice[slot].count   = count;
		audio.voice[slot].pos_fp  = 0;
		audio.voice[slot].step_fp = (rate << 16) / QSND_MIX_RATE;
		audio.voice[slot].vol_l   = vol_l;
		audio.voice[slot].vol_r   = vol_r;
		audio.voice[slot].loop    = loop;
		audio.voice[slot].serial++;

		//set LAST: the mixer reads this flag to decide whether the rest of the slot is meaningful
		audio.voice[slot].active = TRUE;

		slot |= audio.voice[slot].serial << AUDIO_VOICE_SHIFT;
	}

	LBtr(&audio.voice_lock, 0);

	return slot;
}

I64 AudioSFXSlotOf(I64 handle)
{//The slot a handle refers to, or -1 if that voice has already been reused.
	I64 slot;

	if (handle < 0)
		return -1;

	slot = handle & ((1 << AUDIO_VOICE_SHIFT) - 1);
	if (slot < 0 || slot >= AUDIO_MAX_SFX_VOICES)
		return -1;

	if (!audio.voice[slot].active)
		return -1;
	if (audio.voice[slot].serial != handle >> AUDIO_VOICE_SHIFT)
		return -1;

	return slot;
}

public U0 AudioSFXSetCount(I64 handle, I64 count)
{//Adjust a live voice's frame count. Decode-ahead callers start a voice before
 //the final length is known and trim it at stream end.
	I64 slot;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	slot = AudioSFXSlotOf(handle);
	if (slot >= 0 && count > 0)
		audio.voice[slot].count = count;

	LBtr(&audio.voice_lock, 0);
}

public Bool AudioSFXPlaying(I64 handle)
{//TRUE while this specific play is still running.
	return ToBool(AudioSFXSlotOf(handle) >= 0);
}

public U0 AudioSFXStop(I64 handle)
{
	I64 slot;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	slot = AudioSFXSlotOf(handle);
	if (slot >= 0)
	{
			//loop cleared before active, else the mixer re-arms the looping voice between the two writes
		audio.voice[slot].loop   = FALSE;
		audio.voice[slot].active = FALSE;
		audio.voice[slot].frames = NULL;
	}

	LBtr(&audio.voice_lock, 0);
}

public U0 AudioSFXVoiceVolSet(I64 handle, I64 vol_l, I64 vol_r)
{
	I64 slot;

	if (vol_l < 0)					vol_l = 0;
	if (vol_l > AUDIO_VOL_UNITY)	vol_l = AUDIO_VOL_UNITY;
	if (vol_r < 0)					vol_r = 0;
	if (vol_r > AUDIO_VOL_UNITY)	vol_r = AUDIO_VOL_UNITY;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	slot = AudioSFXSlotOf(handle);
	if (slot >= 0)
	{
		audio.voice[slot].vol_l = vol_l;
		audio.voice[slot].vol_r = vol_r;
	}

	LBtr(&audio.voice_lock, 0);
}

public U0 AudioSFXStopAll()
{//Silence every voice. Must be called BEFORE freeing any referenced PCM.
	I64 i;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
			//loop first, else a repeating voice re-arms in the mixer between these two writes
		audio.voice[i].loop   = FALSE;
		audio.voice[i].active = FALSE;
		audio.voice[i].frames = NULL;
	}

	LBtr(&audio.voice_lock, 0);

	//the mixer may still hold a frames pointer it already read; it runs every 1ms
	Sleep(4);
}

public I64 AudioSFXVoicesActive()
{//How many voices are playing.
	I64 i;
	I64 n = 0;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		if (audio.voice[i].active)
			n++;
	}

	return n;
}

public I64 AudioAvailableOutputStreamGet()
{//First idle output stream, or -1.
	I64 stream = 0;

	while (stream < AUDIO_MAX_STREAMS && FifoI64Count(audio.output[stream].data))
		stream++;
	if (stream > AUDIO_MAX_STREAMS - 1)
		return -1;

	return stream;
}

public I64 AudioSFXPlay(U32 *frames, I64 count)
{//Queue a one-shot buffer of U32 (L16|R16) 48kHz frames. Returns stream or -1.
	I64 i, stream = AudioAvailableOutputStreamGet;

	if (stream < 0)
		return stream;
	audio.output_frames[stream] = 0;
	for (i = 0; i < count; i++)
		FifoI64Ins(audio.output[stream].data, frames[i]);

	return stream;
}

//incremental streaming feed
//open, push frames one at a time, stop. AudioStreamPush returns FALSE when the
//fifo is full; the caller sleeps and retries.
public I64 AudioStreamOpen()
{//Grab a free output stream, cleared + ready to be fed. -1 if none free.
	I64 stream = AudioAvailableOutputStreamGet;

	if (stream >= 0)
	{
		audio.output_frames[stream] = 0;
		FifoI64Flush(audio.output[stream].data);
	}

	return stream;
}

public Bool AudioStreamPush(I64 stream, U32 frame)
{//Push one 48kHz L16|R16 frame if there is room. FALSE = fifo full (retry).
	if (stream < 0 || stream >= AUDIO_MAX_STREAMS)
		return FALSE;
	if (FifoI64Count(audio.output[stream].data) >= AUDIO_STREAM_FIFO_FRAMES - 8192)
		return FALSE;
	FifoI64Ins(audio.output[stream].data, frame);

	return TRUE;
}

public U0 AudioStreamStop(I64 stream)
{//Silence + release a streaming feed.
	if (0 <= stream < AUDIO_MAX_STREAMS)
		FifoI64Flush(audio.output[stream].data);
}

public U0 AudioToneTest(I64 ms=1500, I64 hz=440)
{//Queue a square-wave test tone on a free output stream.
	I64  i, frames = 48000 * ms / 1000, half = 24000 / hz;
	I16  s;
	U32 *buf;

	if (!audio_present)
		return;
	buf = MAlloc(frames * sizeof(U32));
	for (i = 0; i < frames; i++)
	{
		if (i / half & 1)
			s = 0x2000;
		else
			s = -0x2000;
		buf[i].i16[0] = s;
		buf[i].i16[1] = s;
	}
	AudioSFXPlay(buf, frames);
	Free(buf);
}

public U0 AudioMasterVolumeSet(I64 pct)
{//0 = mute, 100 = max. Cached even with no device, so a volume set before device
 //selection survives.
	audio_volume = ClampI64(pct, 0, 100);

	if (fp_audio_vol_set)
		(*fp_audio_vol_set)(audio_volume);
}

U0 AudioOutputMix(U32 *buf, I64 length)
{//Sum every live source into one hardware buffer. length is in BYTES.
 //  streams  - averaged
 //  voices   - summed then clamped
 //  room DSP - voice sum only (GoldSrc SX_RoomFX); streams dry
	CAudioVoice *vp;
	I64 i, j, acc_l, acc_r, acc_streams;
	I64 sfx_l, sfx_r;
	I64 sample;
	I64 vsamp;

	for (i = 0; i < length / 4; i++)
	{
		acc_l = 0;
		acc_r = 0;
		acc_streams = 0;
		for (j = 0; j < AUDIO_MAX_STREAMS; j++)
		{
			if (FifoI64Count(audio.output[j].data))
			{
				FifoI64Remove(audio.output[j].data, &sample);
				audio.output_frames[j]++;
				acc_streams++;
				acc_l += sample.i16[0];
				acc_r += sample.i16[1];
			}
		}

		if (acc_streams)
		{
			acc_l = ToI64(acc_l / Sqrt(acc_streams));
			acc_r = ToI64(acc_r / Sqrt(acc_streams));
		}

		sfx_l = 0;
		sfx_r = 0;

		for (j = 0; j < AUDIO_MAX_SFX_VOICES; j++)
		{
			vp = &audio.voice[j];

			if (vp->active && vp->frames && (vp->pos_fp >> 16) < vp->count)
			{
					//nearest source sample
				vsamp = vp->frames[vp->pos_fp >> 16];

				//PARENTHESISE: ZealC shift/multiply precedence differs from C
				sfx_l += (vsamp.i16[0] * vp->vol_l) / AUDIO_VOL_UNITY;
				sfx_r += (vsamp.i16[1] * vp->vol_r) / AUDIO_VOL_UNITY;

				vp->pos_fp += vp->step_fp;
				if ((vp->pos_fp >> 16) >= vp->count)
				{
					if (vp->loop)
					{
							//subtract the length, do not zero: carries the fractional
							//phase across the join. while, not if: one output step can
							//span a very short buffer more than once.
						while ((vp->pos_fp >> 16) >= vp->count)
							vp->pos_fp -= vp->count << 16;
					}
					else
						vp->active = FALSE;
				}
			}
		}

		//roomtype DSP on the SFX bus only - music/streams stay dry
		AudioDSPProcess(&sfx_l, &sfx_r);

		acc_l += sfx_l;
		acc_r += sfx_r;

		//before the clamp; clipping is not recoverable by later attenuation
		if (audio_mix_vol < 256)
		{
			acc_l = (acc_l * audio_mix_vol) >> 8;
			acc_r = (acc_r * audio_mix_vol) >> 8;
		}

		//clamp, do not wrap: a wrapped sum inverts the waveform
		if (acc_l >  32767)	acc_l =  32767;
		if (acc_l < -32768)	acc_l = -32768;
		if (acc_r >  32767)	acc_r =  32767;
		if (acc_r < -32768)	acc_r = -32768;

		buf[i].i16[0] = acc_l;
		buf[i].i16[1] = acc_r;
	}
}
