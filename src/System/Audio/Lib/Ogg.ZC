// Ogg container framing and the Vorbis identification header.
// Vorbis I spec, sections 4 and 5.
//
// Bits here are LSB first. MP3.ZC reads MSB first; the two are not
// interchangeable.

#define OGG_MAX_PAGE_SEGS	255
#define OGG_MAX_PACKET		(1024 * 1024)	//a setup header with big codebooks
#define OGG_HDR_MIN			27				//capture..segment count

//page header type bits
#define OGG_HDRF_CONTINUED	0x01
#define OGG_HDRF_BOS		0x02
#define OGG_HDRF_EOS		0x04

U8	*ogg_src		= NULL;		//whole file, borrowed - never freed here
I64	 ogg_size		= 0;
I64	 ogg_pos		= 0;		//byte offset of the next page to read

I64	 ogg_serial		= -1;		//the logical stream being decoded
Bool ogg_eos		= FALSE;

U8	*ogg_packet		= NULL;		//assembled packet, grows as needed
I64	 ogg_packet_len	= 0;
I64	 ogg_packet_cap	= 0;

//last page's granule is the total sample count
I64	 ogg_granule	= 0;
I64	 ogg_last_granule = 0;

//Vorbis identification header
I64	 ogg_rate		= 0;
I64	 ogg_channels	= 0;
I64	 ogg_bitrate_nom = 0;
I64	 ogg_blocksize0	= 0;
I64	 ogg_blocksize1	= 0;

//a page carries several packets, so the reader resumes mid-table
I64	 ogg_seg_i		= 0;		//next segment to consume
I64	 ogg_seg_n		= 0;		//segments on this page, 0 = none loaded
I64	 ogg_seg_tab	= 0;		//file offset of the segment table
I64	 ogg_seg_body	= 0;		//file offset of the next segment's data

//LSB-first bit reader over the current packet
I64	 ogg_bit_pos	= 0;		//bit offset from the packet start
I64	 ogg_bit_over	= 0;		//reads that hit the packet end, per packet

//the packet ran past OGG_MAX_PACKET and only its head was kept
Bool ogg_packet_trunc = FALSE;

U0 OggInit()
{//globals are not zeroed and a declaration initialiser is ignored
	ogg_src        = NULL;
	ogg_size       = 0;
	ogg_pos        = 0;
	ogg_serial     = -1;
	ogg_eos        = FALSE;
	ogg_packet     = NULL;
	ogg_packet_len = 0;
	ogg_packet_cap = 0;
	ogg_granule    = 0;
	ogg_last_granule = 0;
	ogg_seg_i      = 0;
	ogg_seg_n      = 0;
	ogg_seg_tab    = 0;
	ogg_seg_body   = 0;
	ogg_rate       = 0;
	ogg_channels   = 0;
	ogg_bitrate_nom = 0;
	ogg_blocksize0 = 0;
	ogg_blocksize1 = 0;
	ogg_bit_pos    = 0;
	ogg_bit_over   = 0;
	ogg_packet_trunc = FALSE;
}

U0 OggFree()
{
	if (ogg_packet)
		Free(ogg_packet);

	ogg_packet     = NULL;
	ogg_packet_len = 0;
	ogg_packet_cap = 0;
	ogg_src        = NULL;
}

Bool OggPacketRoom(I64 need)
{//setup headers run past 64K
	U8 *neu;

	if (need <= ogg_packet_cap)
		return TRUE;

	if (need > OGG_MAX_PACKET)
		return FALSE;

	neu = MAlloc(need);
	if (!neu)
		return FALSE;

	if (ogg_packet)
	{
		MemCopy(neu, ogg_packet, ogg_packet_len);
		Free(ogg_packet);
	}

	ogg_packet     = neu;
	ogg_packet_cap = need;

	return TRUE;
}

I64 OggRdU32(U8 *p)
{//little endian, as every field in the container is
	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
}

I64 OggRdU64(U8 *p)
{
	return OggRdU32(p) | (OggRdU32(p + 4) << 32);
}

Bool OggPageLoad()
{//ogg_pos advances past the whole page; the cursor walks it
	U8	*p;
	I64	 nsegs;
	I64	 body;
	I64	 hdr_type;
	I64	 serial;
	I64	 i;

	while (TRUE)
	{
		if (ogg_pos + OGG_HDR_MIN > ogg_size)
			return FALSE;

		p = ogg_src + ogg_pos;

		if (!(p[0] == 'O' && p[1] == 'g' && p[2] == 'g' && p[3] == 'S'))
		{
			ogg_pos++;
			goto opl_next;
		}

		hdr_type = p[5];
		serial   = OggRdU32(p + 14);
		nsegs    = p[26];

		if (ogg_pos + OGG_HDR_MIN + nsegs > ogg_size)
			return FALSE;

		body = 0;
		for (i = 0; i < nsegs; i++)
			body += p[27 + i];

		if (ogg_pos + OGG_HDR_MIN + nsegs + body > ogg_size)
			return FALSE;

		//first serial wins; chained files carry several
		if (ogg_serial < 0 && hdr_type & OGG_HDRF_BOS)
			ogg_serial = serial;

		if (ogg_serial >= 0 && serial != ogg_serial)
		{
			ogg_pos += OGG_HDR_MIN + nsegs + body;
			goto opl_next;
		}

		ogg_granule = OggRdU64(p + 6);
		if (ogg_granule != -1)
			ogg_last_granule = ogg_granule;

		if (hdr_type & OGG_HDRF_EOS)
			ogg_eos = TRUE;

		ogg_seg_tab  = ogg_pos + OGG_HDR_MIN;
		ogg_seg_body = ogg_seg_tab + nsegs;
		ogg_seg_n    = nsegs;
		ogg_seg_i    = 0;


		ogg_pos = ogg_seg_body + body;

		return TRUE;

opl_next:
	}
}

Bool OggNextPacket()
{//a packet ends at the first segment under 255; 255 means it continues.
 //spans pages, so the buffer appends
	I64 seg;

	ogg_packet_len = 0;
	ogg_bit_pos    = 0;
	ogg_bit_over   = 0;
	ogg_packet_trunc = FALSE;

	while (TRUE)
	{
		//no continue in ZealC
		if (ogg_seg_i >= ogg_seg_n)
		{
			if (!OggPageLoad)
				return FALSE;

			goto onp_next;
		}

		seg = ogg_src[ogg_seg_tab + ogg_seg_i];
		ogg_seg_i++;

		//an oversized packet is kept at its head, not rejected; the segment cursor
		//advances either way, so the stream stays in sync
		if (ogg_packet_len + seg > OGG_MAX_PACKET)
			ogg_packet_trunc = TRUE;
		else if (!OggPacketRoom(ogg_packet_len + seg))
			return FALSE;
		else
		{
			MemCopy(ogg_packet + ogg_packet_len, ogg_src + ogg_seg_body, seg);
			ogg_packet_len += seg;
		}

		ogg_seg_body += seg;

		if (seg < 255)
			return ToBool(ogg_packet_len > 0);

onp_next:
	}
}

I64 OggGetBits(I64 n)
{//LSB first, little endian across bytes
	I64 v = 0;
	I64 got = 0;
	I64 byte;
	I64 avail;
	I64 take;

	if (n <= 0)
		return 0;

	while (got < n)
	{
		byte = ogg_bit_pos >> 3;
		if (byte >= ogg_packet_len)
		{
			ogg_bit_over++;		//ran off the packet: caller checks length
			return v;
		}

		avail = 8 - (ogg_bit_pos & 7);
		take  = n - got;
		if (take > avail)
			take = avail;

		v |= ((ogg_packet[byte] >> (ogg_bit_pos & 7)) &
			  ((1 << take) - 1)) << got;

		ogg_bit_pos += take;
		got         += take;
	}

	return v;
}

Bool OggHeaderIdent()
{//4.2.2
	if (ogg_packet_len < 30)
		return FALSE;

	if (ogg_packet[0] != 1)
		return FALSE;
	if (ogg_packet[1] != 'v' || ogg_packet[2] != 'o' || ogg_packet[3] != 'r' ||
		ogg_packet[4] != 'b' || ogg_packet[5] != 'i' || ogg_packet[6] != 's')
		return FALSE;

	//vorbis_version must be 0
	if (OggRdU32(ogg_packet + 7))
		return FALSE;

	ogg_channels     = ogg_packet[11];
	ogg_rate         = OggRdU32(ogg_packet + 12);
	ogg_bitrate_nom  = OggRdU32(ogg_packet + 20);

	//blocksizes are log2, two nibbles
	ogg_blocksize0 = 1 << (ogg_packet[28] & 15);
	ogg_blocksize1 = 1 << ((ogg_packet[28] >> 4) & 15);

	//framing bit
	if (!(ogg_packet[29] & 1))
		return FALSE;

	if (ogg_channels < 1 || ogg_channels > 2)
		return FALSE;			//mono and stereo only
	if (ogg_rate < 1)
		return FALSE;
	if (ogg_blocksize0 < 64 || ogg_blocksize1 > 8192 ||
		ogg_blocksize0 > ogg_blocksize1)
		return FALSE;

	return TRUE;
}

I64 OggTotalSamples(U8 *raw, I64 size)
{//granule of the last page
	I64 i;

	for (i = size - OGG_HDR_MIN; i >= 0; i--)
		if (raw[i] == 'O' && raw[i + 1] == 'g' && raw[i + 2] == 'g' &&
			raw[i + 3] == 'S')
			return OggRdU64(raw + i + 6);

	return 0;
}

Bool OggOpen(U8 *raw, I64 size)
{//framing plus the identification header
	OggFree;
	OggInit;

	if (!raw || size < OGG_HDR_MIN)
		return FALSE;

	ogg_src  = raw;
	ogg_size = size;

	if (!OggNextPacket)
		return FALSE;

	return OggHeaderIdent;
}

//globals are not zeroed and the app calls FreeAll before Init; run at compile time
OggInit;
