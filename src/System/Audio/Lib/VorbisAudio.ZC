// Audio packet decode. Spec section 4.3. One submap per mapping only.

#define VA_MAX_CH		2

F64	va_floor[VA_MAX_CH * VM_MAX_N];		//curve, n/2 per channel
F64	va_block[VA_MAX_CH * VM_MAX_N];		//imdct output, n per channel
Bool va_no_decode[VA_MAX_CH];

I64	va_last_n = 0;						//blocksize of the packet just decoded

Bool VADecode(F64 *pcm_l, F64 *pcm_r, I64 *count)
{//decodes ogg_packet. *count is the samples now ready, zero on the first
 //audio packet since overlap-add has nothing to add to yet
	CVMode		*md;
	CVMapping	*m;
	I64			 mode;
	I64			 n;
	I64			 half;
	Bool		 blockflag;
	Bool		 prev_short = FALSE;
	Bool		 next_short = FALSE;
	I64			 i;
	I64			 j;
	I64			 ch;
	I64			 fl;
	I64			 out = 0;
	F64			*v;
	F64			*f;

	*count = 0;

	if (!ogg_packet_len)
		return FALSE;

	ogg_bit_pos = 0;

	//packet type bit: 0 is audio
	if (OggGetBits(1))
		return FALSE;

	mode = OggGetBits(VBILog(vs_mode_count - 1));
	if (mode < 0 || mode >= vs_mode_count)
		return FALSE;

	md        = &vs_mode[mode];
	blockflag = ToBool(md->blockflag);

	if (blockflag)
	{
		n = ogg_blocksize1;

		//window flags say whether the neighbouring block is the short one
		prev_short = ToBool(!OggGetBits(1));
		next_short = ToBool(!OggGetBits(1));
	}
	else
		n = ogg_blocksize0;

	if (n > VM_MAX_N)
		return FALSE;

	half = n / 2;
	ch   = ogg_channels;

	if (ch < 1 || ch > VA_MAX_CH)
		return FALSE;

	m = vs_mapping[md->mapping];
	if (!m || m->submaps != 1)
		return FALSE;

	VMWindowsReady(ogg_blocksize0, ogg_blocksize1);

	//floor curve per channel; a floor that declines to decode silences the channel
	for (i = 0; i < ch; i++)
	{
		f  = va_floor + i * VM_MAX_N;
		fl = m->sub_floor[m->mux[i]];

		if (fl < 0 || fl >= vs_floor_count || !vs_floor[fl])
			return FALSE;

		for (j = 0; j < half; j++)
			f[j] = 0.0;

		va_no_decode[i] = ToBool(!VFDecode(vs_floor[fl], f, half));
	}

	//4.3.2. a coupled pair decodes if either side does
	for (i = 0; i < m->coupling_steps; i++)
		if (!va_no_decode[m->mag[i]] || !va_no_decode[m->ang[i]])
		{
			va_no_decode[m->mag[i]] = FALSE;
			va_no_decode[m->ang[i]] = FALSE;
		}

	VRClear(ch, half);

	if (!VRDecode(vs_residue[m->sub_residue[0]], ch, half, va_no_decode))
		return FALSE;

	VRInverseCouple(m, half);

	//4.3.4. spectrum is the residue scaled by the floor curve
	for (i = 0; i < ch; i++)
	{
		//VRDecode packs channel rows at stride half, not VR_MAX_N
		v = vr_v + i * half;
		f = va_floor + i * VM_MAX_N;

		if (va_no_decode[i])
		{
			for (j = 0; j < half; j++)
				v[j] = 0.0;
		}
		else
		{
			for (j = 0; j < half; j++)
				v[j] = v[j] * f[j];
		}
	}

	for (i = 0; i < ch; i++)
	{
		//VRDecode packs channel rows at stride half, not VR_MAX_N
		v = vr_v + i * half;
		f = va_block + i * VM_MAX_N;

		VMImdct(v, f, n);
		VMWindowApply(f, n, ogg_blocksize0, ogg_blocksize1, blockflag,
			prev_short, next_short);
	}

	out = VMOverlap(va_block, n, 0, pcm_l);

	if (ch > 1)
		VMOverlap(va_block + VM_MAX_N, n, 1, pcm_r);

	vm_lap_n  = n;
	va_last_n = n;
	*count    = out;

	return TRUE;
}
