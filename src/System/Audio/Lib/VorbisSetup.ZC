// Vorbis I setup header past the codebooks. Spec sections 6 and 8.
//
// Floor 0 is not decoded: no encoder in use emits it.

#define VS_MAX_FLOORS		64
#define VS_MAX_RESIDUES		64
#define VS_MAX_MAPPINGS		64
#define VS_MAX_MODES		64
#define VS_MAX_PARTITIONS	32
#define VS_MAX_CLASSES		16
#define VS_MAX_XLIST		256
#define VS_MAX_SUBMAPS		16
#define VS_MAX_COUPLING		256

class CVFloor1
{
	I64	 partitions;
	I64	 part_class[VS_MAX_PARTITIONS];
	I64	 class_dims[VS_MAX_CLASSES];
	I64	 class_subs[VS_MAX_CLASSES];
	I64	 class_book[VS_MAX_CLASSES];
	I64	 sub_book[VS_MAX_CLASSES * 8];
	I64	 mult;
	I64	 rangebits;
	I64	 xlist[VS_MAX_XLIST];
	I64	 values;
};

class CVResidue
{
	I64	 type;
	I64	 begin;
	I64	 end;
	I64	 part_size;
	I64	 classifications;
	I64	 classbook;
	I64	 cascade[VS_MAX_CLASSES];
	I64	 book[VS_MAX_CLASSES * 8];
};

class CVMapping
{
	I64	 submaps;
	I64	 coupling_steps;
	I64	 mag[VS_MAX_COUPLING];
	I64	 ang[VS_MAX_COUPLING];
	I64	 mux[VS_MAX_COUPLING];
	I64	 sub_floor[VS_MAX_SUBMAPS];
	I64	 sub_residue[VS_MAX_SUBMAPS];
};

class CVMode
{
	I64	 blockflag;
	I64	 mapping;
};

CVFloor1	*vs_floor[VS_MAX_FLOORS];
I64			 vs_floor_type[VS_MAX_FLOORS];
I64			 vs_floor_count = 0;

CVResidue	*vs_residue[VS_MAX_RESIDUES];
I64			 vs_residue_count = 0;

CVMapping	*vs_mapping[VS_MAX_MAPPINGS];
I64			 vs_mapping_count = 0;

CVMode		 vs_mode[VS_MAX_MODES];
I64			 vs_mode_count = 0;

U0 VSInit()
{//declaration initialisers on globals are ignored
	I64 i;

	for (i = 0; i < VS_MAX_FLOORS; i++)
	{
		vs_floor[i]      = NULL;
		vs_floor_type[i] = -1;
	}
	for (i = 0; i < VS_MAX_RESIDUES; i++)
		vs_residue[i] = NULL;
	for (i = 0; i < VS_MAX_MAPPINGS; i++)
		vs_mapping[i] = NULL;
	for (i = 0; i < VS_MAX_MODES; i++)
	{
		vs_mode[i].blockflag = 0;
		vs_mode[i].mapping   = 0;
	}

	vs_floor_count   = 0;
	vs_residue_count = 0;
	vs_mapping_count = 0;
	vs_mode_count    = 0;
}

U0 VSFreeAll()
{
	I64 i;

	for (i = 0; i < VS_MAX_FLOORS; i++)
	{
		if (vs_floor[i])
			Free(vs_floor[i]);
		vs_floor[i]      = NULL;
		vs_floor_type[i] = -1;
	}
	for (i = 0; i < VS_MAX_RESIDUES; i++)
	{
		if (vs_residue[i])
			Free(vs_residue[i]);
		vs_residue[i] = NULL;
	}
	for (i = 0; i < VS_MAX_MAPPINGS; i++)
	{
		if (vs_mapping[i])
			Free(vs_mapping[i]);
		vs_mapping[i] = NULL;
	}

	vs_floor_count   = 0;
	vs_residue_count = 0;
	vs_mapping_count = 0;
	vs_mode_count    = 0;
}

Bool VSBookOK(I64 n)
{
	return ToBool(n >= 0 && n < vb_book_count && vb_book[n]);
}

Bool VSReadFloor1(CVFloor1 *f)
{//6.2.1
	I64 i;
	I64 j;
	I64 k;
	I64 maxclass = -1;
	I64 count;
	I64 bits;

	f->partitions = OggGetBits(5);
	if (f->partitions > VS_MAX_PARTITIONS)
		return FALSE;

	for (i = 0; i < f->partitions; i++)
	{
		f->part_class[i] = OggGetBits(4);
		if (f->part_class[i] >= VS_MAX_CLASSES)
			return FALSE;
		if (f->part_class[i] > maxclass)
			maxclass = f->part_class[i];
	}

	for (i = 0; i <= maxclass; i++)
	{
		f->class_dims[i] = OggGetBits(3) + 1;
		f->class_subs[i] = OggGetBits(2);

		if (f->class_subs[i])
		{
			f->class_book[i] = OggGetBits(8);
			if (!VSBookOK(f->class_book[i]))
				return FALSE;
		}
		else
			f->class_book[i] = -1;

		//subclass books are stored biased by one; -1 means no book
		for (j = 0; j < (1 << f->class_subs[i]); j++)
		{
			k = OggGetBits(8) - 1;
			f->sub_book[i * 8 + j] = k;

			if (k >= 0 && !VSBookOK(k))
				return FALSE;
		}
	}

	f->mult      = OggGetBits(2) + 1;
	f->rangebits = OggGetBits(4);

	//xlist starts with the two endpoints, then every partition's points
	f->xlist[0] = 0;
	f->xlist[1] = 1 << f->rangebits;
	count       = 2;

	for (i = 0; i < f->partitions; i++)
	{
		bits = f->class_dims[f->part_class[i]];

		for (j = 0; j < bits; j++)
		{
			if (count >= VS_MAX_XLIST)
				return FALSE;

			f->xlist[count] = OggGetBits(f->rangebits);
			count++;
		}
	}

	f->values = count;

	return TRUE;
}

Bool VSReadResidue(CVResidue *r)
{//6.3.1. types 0, 1 and 2 share a header
	I64 i;
	I64 j;
	I64 high;

	r->type = OggGetBits(16);
	if (r->type > 2)
		return FALSE;

	r->begin           = OggGetBits(24);
	r->end             = OggGetBits(24);
	r->part_size       = OggGetBits(24) + 1;
	r->classifications = OggGetBits(6) + 1;
	r->classbook       = OggGetBits(8);

	if (r->classifications > VS_MAX_CLASSES)
		return FALSE;
	if (!VSBookOK(r->classbook))
		return FALSE;
	if (r->end < r->begin)
		return FALSE;

	//cascade is a 5 bit low half plus an optional 3 bit high half
	for (i = 0; i < r->classifications; i++)
	{
		high = 0;
		j    = OggGetBits(3);

		if (OggGetBits(1))
			high = OggGetBits(5);

		r->cascade[i] = j | (high << 3);
	}

	for (i = 0; i < r->classifications; i++)
		for (j = 0; j < 8; j++)
		{
			if (r->cascade[i] & (1 << j))
			{
				r->book[i * 8 + j] = OggGetBits(8);
				if (!VSBookOK(r->book[i * 8 + j]))
					return FALSE;
			}
			else
				r->book[i * 8 + j] = -1;
		}

	return TRUE;
}

Bool VSReadMapping(CVMapping *m)
{//6.4.1
	I64 i;
	I64 bits;

	if (OggGetBits(16))
		return FALSE;			//mapping type 0 only

	if (OggGetBits(1))
		m->submaps = OggGetBits(4) + 1;
	else
		m->submaps = 1;

	if (m->submaps > VS_MAX_SUBMAPS)
		return FALSE;

	if (OggGetBits(1))
	{
		m->coupling_steps = OggGetBits(8) + 1;

		if (m->coupling_steps > VS_MAX_COUPLING)
			return FALSE;

		bits = VBILog(ogg_channels - 1);

		for (i = 0; i < m->coupling_steps; i++)
		{
			m->mag[i] = OggGetBits(bits);
			m->ang[i] = OggGetBits(bits);

			if (m->mag[i] == m->ang[i] ||
				m->mag[i] >= ogg_channels || m->ang[i] >= ogg_channels)
				return FALSE;
		}
	}
	else
		m->coupling_steps = 0;

	if (OggGetBits(2))
		return FALSE;			//reserved

	//channel to submap, only present when there is more than one
	for (i = 0; i < ogg_channels; i++)
	{
		if (m->submaps > 1)
		{
			m->mux[i] = OggGetBits(4);
			if (m->mux[i] >= m->submaps)
				return FALSE;
		}
		else
			m->mux[i] = 0;
	}

	for (i = 0; i < m->submaps; i++)
	{
		OggGetBits(8);			//unused time configuration
		m->sub_floor[i]   = OggGetBits(8);
		m->sub_residue[i] = OggGetBits(8);

		if (m->sub_floor[i] >= vs_floor_count ||
			m->sub_residue[i] >= vs_residue_count)
			return FALSE;
	}

	return TRUE;
}

Bool OggHeaderSetup()
{//8.6.2, after the codebooks
	I64 i;
	I64 n;

	if (ogg_packet_len < 7 || ogg_packet[0] != 5)
		return FALSE;
	if (ogg_packet[1] != 'v' || ogg_packet[2] != 'o' || ogg_packet[3] != 'r' ||
		ogg_packet[4] != 'b' || ogg_packet[5] != 'i' || ogg_packet[6] != 's')
		return FALSE;

	ogg_bit_pos = 7 * 8;

	if (!VBReadAll(OggGetBits(8) + 1))
		return FALSE;

	//time domain transforms: count, then that many zeroes
	n = OggGetBits(6) + 1;
	for (i = 0; i < n; i++)
		if (OggGetBits(16))
			return FALSE;

	n = OggGetBits(6) + 1;
	if (n > VS_MAX_FLOORS)
		return FALSE;

	for (i = 0; i < n; i++)
	{
		vs_floor_type[i] = OggGetBits(16);

		if (vs_floor_type[i] != 1)
			return FALSE;

		vs_floor[i] = CAlloc(sizeof(CVFloor1));
		if (!vs_floor[i] || !VSReadFloor1(vs_floor[i]))
			return FALSE;
	}
	vs_floor_count = n;

	n = OggGetBits(6) + 1;
	if (n > VS_MAX_RESIDUES)
		return FALSE;

	for (i = 0; i < n; i++)
	{
		vs_residue[i] = CAlloc(sizeof(CVResidue));
		if (!vs_residue[i] || !VSReadResidue(vs_residue[i]))
			return FALSE;
	}
	vs_residue_count = n;

	n = OggGetBits(6) + 1;
	if (n > VS_MAX_MAPPINGS)
		return FALSE;

	for (i = 0; i < n; i++)
	{
		vs_mapping[i] = CAlloc(sizeof(CVMapping));
		if (!vs_mapping[i] || !VSReadMapping(vs_mapping[i]))
			return FALSE;
	}
	vs_mapping_count = n;

	n = OggGetBits(6) + 1;
	if (n > VS_MAX_MODES)
		return FALSE;

	for (i = 0; i < n; i++)
	{
		vs_mode[i].blockflag = OggGetBits(1);
		OggGetBits(16);			//windowtype, must be 0
		OggGetBits(16);			//transformtype, must be 0
		vs_mode[i].mapping = OggGetBits(8);

		if (vs_mode[i].mapping >= vs_mapping_count)
			return FALSE;
	}
	vs_mode_count = n;

	//framing bit
	if (!OggGetBits(1))
		return FALSE;

	return TRUE;
}

Bool OggHeaders()
{//identification, comment, setup. the comment packet is metadata only
	if (!OggNextPacket || !OggHeaderIdent)
		return FALSE;

	if (!OggNextPacket)
		return FALSE;
	if (ogg_packet_len < 7 || ogg_packet[0] != 3)
		return FALSE;

	if (!OggNextPacket)
		return FALSE;

	return OggHeaderSetup;
}

//globals are not zeroed and the app calls FreeAll before Init. run once at
//compile time so the first FreeAll sees NULL, not stale boot memory
VSInit;
