//Boot-time output device selection. Runs after every driver is compiled in.
//
//Probe order is most-capable first. A driver that finds its class code but
//fails to initialise returns non-zero and the next one is tried.

//Resolved once in AudioDevInit; AudioUsbRecheck reuses them so a hotplug does
//not repeat the hash lookups.
I64 audio_usb_fill = 0;
I64 audio_usb_pres = 0;

//AudioOutputMix emits full scale; every driver applies master volume itself.
//The USB driver is kernel AOT and cannot reach audio_volume, so the hook is a
//wrapper that mixes then attenuates. 0..256, as HDAVolumeSet.
I64 audio_usb_vol = 256;

U0 AudioUsbFill(U32 *buf, I64 bytes)
{
	I64 i, n = bytes / 4;

	AudioOutputMix(buf, bytes);
	if (audio_usb_vol >= 256)
		return;
	for (i = 0; i < n; i++)
	{
		buf[i].i16[0] = (buf[i].i16[0] * audio_usb_vol) >> 8;
		buf[i].i16[1] = (buf[i].i16[1] * audio_usb_vol) >> 8;
	}
}

U0 AudioUsbVolumeSet(I64 pct)
{//fp_audio_vol_set for the USB path.
	audio_usb_vol = pct * 256 / 100;
}

public Bool AudioUsbRecheck()
{//Claim the USB device if one has appeared since boot. Safe to call repeatedly.
	if (!audio_usb_fill || !audio_usb_pres)
		return FALSE;
	if (audio_dev == AUDIO_DEV_USB)
		return TRUE;
	if (!CallInd(audio_usb_pres))
		return FALSE;

	audio_dev	  = AUDIO_DEV_USB;
	audio_present = TRUE;
	fp_audio_vol_set = &AudioUsbVolumeSet;
	AudioMasterVolumeSet(audio_volume);

	return TRUE;
}

U0 AudioDevInit()
{
	CHash	*h;
	I64		 fill, pres;

	AudioInit;

//USB audio lives in the kernel and cannot call the mixer directly, so the hook
//is installed here. Resolved by name: these sources must still compile on a
//kernel built before the USB audio driver existed. HashFind yields the address
//of a global, or a function's entry point.
	fill = 0;
	pres = 0;
	h = HashFind("fp_usb_audio_fill", Fs->hash_table, HTT_EXPORT_SYS_SYM);
	if (h)
		fill = h(CHashExport *)->val;
	h = HashFind("UsbAudioPresent", Fs->hash_table, HTT_FUN | HTT_EXPORT_SYS_SYM);
	if (h)
	{
		if (h->type & HTT_FUN)
			pres = h(CHashFun *)->exe_addr;
		else
			pres = h(CHashExport *)->val;
	}

	audio_usb_fill = fill;
	audio_usb_pres = pres;
	if (fill && pres)
	{
		*fill(U8 **) = &AudioUsbFill;
		if (AudioUsbRecheck)
		{
			"[Audio] USB audio device active.\n";
			return;
		}
	}

	if (!HDAInit)
		return;
	if (!AC97Init)
		return;

	audio_dev     = AUDIO_DEV_NONE;
	audio_present = FALSE;
	"[Audio] No supported device found; audio disabled.\n";
}

AudioDevInit;
