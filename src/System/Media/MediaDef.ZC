//Shared media types. Demuxers fill these; codecs and players read them.
//
//The engine is pull-based: an embedder owns its frame loop and its surface, so
//nothing here draws, spawns a task or touches the mixer.

#define MEDIA_TRACKS_MAX	8

//Track kinds, matching Matroska TrackType.
#define MEDIA_TRACK_NONE	0
#define MEDIA_TRACK_VIDEO	1
#define MEDIA_TRACK_AUDIO	2

#define MEDIA_CODEC_NONE	0
#define MEDIA_CODEC_VP8		1
#define MEDIA_CODEC_VP9		2
#define MEDIA_CODEC_VORBIS	3
#define MEDIA_CODEC_OPUS	4

#define MEDIA_CODEC_NAME_MAX	24

class CMediaTrack
{
	I64		 num;			//container track number, not the array index
	I64		 type;			//MEDIA_TRACK_*
	I64		 codec;			//MEDIA_CODEC_*
	U8		 codec_name[MEDIA_CODEC_NAME_MAX];
	U8		*codec_priv;	//borrowed from the source buffer, not owned
	I64		 codec_priv_len;

	I64		 width, height;	//video
	I64		 rate, channels;//audio
	Bool	 valid;
};

class CMediaPacket
{
	U8		*data;			//borrowed from the source buffer, not owned
	I64		 size;
	I64		 track;			//container track number
	F64		 time;			//seconds from the start of the stream
	Bool	 key;
};

class CMediaCtx
{
	U8			*buf;		//whole file, owned by the caller
	I64			 size;

	CMediaTrack	 track[MEDIA_TRACKS_MAX];
	I64			 track_count;

	F64			 duration;		//seconds, 0 when the container omits it
	I64			 timecode_scale;//nanoseconds per container tick

	//demuxer cursor
	I64			 pos;			//next element to read
	I64			 seg_end;
	I64			 clus_end;
	I64			 clus_time;		//cluster Timecode, in ticks
	Bool		 in_cluster;

	I64			 laced_skipped;	//blocks dropped for unsupported lacing
};

I64 MediaTrackFind(CMediaCtx *m, I64 type)
{//Index of the first track of a kind, or -1.
	I64 i;

	for (i = 0; i < m->track_count; i++)
		if (m->track[i].valid && m->track[i].type == type)
			return i;

	return -1;
}

I64 MediaTrackByNum(CMediaCtx *m, I64 num)
{
	I64 i;

	for (i = 0; i < m->track_count; i++)
		if (m->track[i].valid && m->track[i].num == num)
			return i;

	return -1;
}
