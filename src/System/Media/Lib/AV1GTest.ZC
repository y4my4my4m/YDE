	{
		"AV1GTest: av1C did not parse\n";
		return;
	}
	d = Av1DecOpen(&seq);
	if (!d)
	{
		"AV1GTest: Av1DecOpen failed\n";
		return;
	}
	r = Av1DecodeFrameObu(d, &seq, gt_tu, 3186);
	"AV1GTest: tile0 %d+%d host 0+3158, tiles %dx%d host 1x1, "
		"mi %dx%d host 80x60\n",
		d->tiles[0].offset, d->tiles[0].size,
		d->hdr.tile_cols, d->hdr.tile_rows,
		d->hdr.mi_cols, d->hdr.mi_rows;
	"AV1GTest: blocks %d host 405, tell %d host 25261, pos %d host 3158, "
		"rng %d host 59656\n",
		d->blocks, Av1MsacTell(&d->msac), d->msac.pos, d->msac.rng;
	GtCmp("mi_size", d->mi_sizes, gt_mi, 80, 60, d->mi_stride, d->sb_size4);
	GtCmp("y_mode", d->y_modes, gt_ym, 80, 60, d->mi_stride, d->sb_size4);
	GtCmp("uv_mode", d->uv_modes, gt_uv, 80, 60, d->mi_stride, d->sb_size4);
	GtCmp("tx_size", d->tx_sizes, gt_tx, 80, 60, d->mi_stride, d->sb_size4);
	if (r != 1)
		"AV1GTest: frame gives %d, host gives 1 (%s)\n", r, Av1Why(r);
	else
		"AV1GTest: frame ok, %d tile(s)\n", r;
	Av1DecClose(d);
}

Main;
