U0 GtCmp(U8 *what, U8 *got, U8 *want, I64 cols, I64 rows, I64 stride,
		  I64 sb4)
{//Superblock major, which is decode order. Row major reports a later
//superblock ahead of a row this one has not written yet.
	I64 sbr, sbc, r, c, i;

	for (sbr = 0; sbr < rows; sbr += sb4)
		for (sbc = 0; sbc < cols; sbc += sb4)
			for (r = sbr; r < sbr + sb4 && r < rows; r++)
				for (c = sbc; c < sbc + sb4 && c < cols; c++)
				{
					i = r * stride + c;
					if (got[i] != want[i])
					{
						"AV1GTest: %s differs at mi_row %d mi_col %d, "
							"sb %d,%d: %d host %d\n",
							what, r, c, sbr / sb4, sbc / sb4, got[i], want[i];
						return;
					}
				}
	"AV1GTest: %s matches over %d by %d\n", what, cols, rows;
}

U0 Main()
{
	CAv1Msac	m;
	CAv1Seq		seq;
	CAv1Dec		*d;
	U16			cdf[12 * 20], *pool;
	I64			i, p, r, h, n, bad = -1;

	MemCopy(cdf, gt_cdf, 12 * 20 * sizeof(U16));
	Av1MsacInit(&m, gt_buf, 512, TRUE);
	for (i = 0; i < 3000; i++)
	{
		p = gt_pick[i];
		if (gt_op[i] == 1)
			r = Av1ReadBool(&m);
		else if (gt_op[i] == 2)
			r = Av1ReadLiteral(&m, gt_arg[i]);
		else if (gt_op[i] == 3)
			r = Av1ReadBoolProb(&m, gt_arg[i] << 11);
		else
			r = Av1ReadSymbol(&m, cdf + p * 20, gt_nsyms[p]);
		if (r != gt_ret[i] || m.rng != gt_rng[i] ||
			m.cnt != gt_cnt[i] || m.dif != gt_dif[i])
		{
			bad = i;
			"symbol %d op %d: ret %d/%d rng %d/%d cnt %d/%d dif %X/%X\n",
				i, gt_op[i], r, gt_ret[i], m.rng, gt_rng[i], m.cnt, gt_cnt[i],
				m.dif, gt_dif[i];
			break;
		}
	}
	if (bad >= 0)
	{
		"AV1GTest: msac FAILS at %d\n", bad;
		return;
	}
	"AV1GTest: msac %d symbols match\n", 3000;

