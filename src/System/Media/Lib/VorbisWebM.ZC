//Vorbis carried by Matroska.
//
//The audio packets are byte-identical to the Ogg ones; only the framing differs, so
//they are injected with OggPacketSet and decoded by VADecode unchanged.
//
//CodecPrivate packs the three setup headers with Xiph lacing:
//  byte 0   packet count - 1, always 2
//  then     length of header 0, then header 1, each as a run of 0xFF bytes
//           followed by a byte < 0xFF, summed
//  then     the three headers back to back; header 2 runs to the end

I64 VwXiphLen(U8 *b, I64 len, I64 *_pos)
{//One Xiph-laced length. Returns -1 when it runs off the end.
	I64 v = 0, p = *_pos;

	while (p < len && b[p] == 0xFF)
	{
		v += 0xFF;
		p++;
	}
	if (p >= len)
		return -1;
	v += b[p];
	p++;
	*_pos = p;

	return v;
}

public Bool MediaVorbisInit(CMediaTrack *t)
{//Parse CodecPrivate and run the three headers through the Vorbis setup.
	U8	*b;
	I64	 len, pos = 1, l0, l1, l2, base;

	if (!t || t->codec != MEDIA_CODEC_VORBIS || !t->codec_priv)
		return FALSE;

	b   = t->codec_priv;
	len = t->codec_priv_len;
	if (len < 3 || b[0] != 2)
		return FALSE;

	l0 = VwXiphLen(b, len, &pos);
	l1 = VwXiphLen(b, len, &pos);
	if (l0 < 1 || l1 < 1)
		return FALSE;

	base = pos;
	l2   = len - base - l0 - l1;
	if (l2 < 1 || base + l0 + l1 > len)
		return FALSE;

	OggFree;
	OggInit;
	VSFreeAll;
	VSInit;

	if (!OggPacketSet(b + base, l0) || !OggHeaderIdent)
		return FALSE;

	//comment header, metadata only
	if (!OggPacketSet(b + base + l0, l1) || ogg_packet[0] != 3)
		return FALSE;

	if (!OggPacketSet(b + base + l0 + l1, l2) || !OggHeaderSetup)
		return FALSE;

	return ToBool(ogg_rate > 0 && ogg_channels > 0);
}

public Bool MediaVorbisDecode(CMediaPacket *p, F64 *pcm_l, F64 *pcm_r,
							  I64 *_count)
{//One Matroska block -> PCM. *_count is 0 on the first packet: overlap-add has
//nothing to add to yet.
	*_count = 0;
	if (!p || !p->data || p->size < 1)
		return FALSE;
	if (!OggPacketSet(p->data, p->size))
		return FALSE;

	return VADecode(pcm_l, pcm_r, _count);
}
