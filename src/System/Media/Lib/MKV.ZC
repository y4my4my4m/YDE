//Matroska/WebM demuxer (EBML). Reads Info, Tracks and Cluster; hands back one
//frame per call. Nothing is copied: packets point into the caller's buffer.
//
//Element layout is ID (vint, marker kept) + size (vint, marker stripped) + data.
//Unknown size is every value bit set, and means "to the end of the parent".

#define EBML_HDR			0x1A45DFA3
#define MKV_SEGMENT			0x18538067
#define MKV_INFO			0x1549A966
#define MKV_TIMECODE_SCALE	0x2AD7B1
#define MKV_DURATION		0x4489
#define MKV_TRACKS			0x1654AE6B
#define MKV_TRACK_ENTRY		0xAE
#define MKV_TRACK_NUMBER	0xD7
#define MKV_TRACK_TYPE		0x83
#define MKV_CODEC_ID		0x86
#define MKV_CODEC_PRIVATE	0x63A2
#define MKV_VIDEO			0xE0
#define MKV_PIXEL_WIDTH		0xB0
#define MKV_PIXEL_HEIGHT	0xBA
#define MKV_AUDIO			0xE1
#define MKV_SAMPLE_FREQ		0xB5
#define MKV_CHANNELS		0x9F
#define MKV_CLUSTER			0x1F43B675
#define MKV_TIMECODE		0xE7
#define MKV_SIMPLE_BLOCK	0xA3
#define MKV_BLOCK_GROUP		0xA0
#define MKV_BLOCK			0xA1

//SimpleBlock flags
#define MKV_BF_KEY			0x80
#define MKV_BF_LACING		0x06

I64 MkvVint(U8 *b, I64 pos, I64 end, I64 *_len, Bool keep_marker)
{//One EBML variable-length integer. Returns -1 and *_len 0 when malformed.
	I64 first, mask, len, val, i;

	*_len = 0;
	if (pos >= end)
		return -1;

	first = b[pos];
	if (!first)
		return -1;			//more than 8 length bits

	mask = 0x80;
	len  = 1;
	while (!(first & mask))
	{
		mask >>= 1;
		len++;
	}

	if (pos + len > end)
		return -1;

	if (keep_marker)
		val = first;
	else
		val = first & (mask - 1);

	for (i = 1; i < len; i++)
		val = (val << 8) | b[pos + i];

	*_len = len;

	return val;
}

Bool MkvSizeUnknown(I64 val, I64 len)
{//Every value bit set: 7 bits per byte after the marker.
	return ToBool(val == (1 << (7 * len)) - 1);
}

I64 MkvUInt(U8 *b, I64 pos, I64 size)
{//Big-endian unsigned of 1..8 bytes.
	I64 v = 0, i;

	if (size < 1 || size > 8)
		return 0;
	for (i = 0; i < size; i++)
		v = (v << 8) | b[pos + i];

	return v;
}

F64 MkvFloat(U8 *b, I64 pos, I64 size)
{//Matroska floats are 4 or 8 byte big-endian IEEE. binary32 is widened to a
//binary64 pattern rather than converted, so no FPU cast is needed.
	I64	 bits = MkvUInt(b, pos, size), sign, exp, man;
	F64	 f;
	I64	*fp = &f;

	if (size == 4)
	{
		sign = (bits >> 31) & 1;
		exp  = (bits >> 23) & 0xFF;
		man  = bits & 0x7FFFFF;
		if (!exp || exp == 0xFF)
			return 0.0;		//zero, subnormal, inf and NaN are not useful here
		bits = (sign << 63) | ((exp - 127 + 1023) << 52) | (man << 29);
	}
	else if (size != 8)
		return 0.0;

	*fp = bits;

	return f;
}

I64 MkvCodecId(U8 *name)
{
	if (!StrCompare(name, "V_VP8"))		return MEDIA_CODEC_VP8;
	if (!StrCompare(name, "V_VP9"))		return MEDIA_CODEC_VP9;
	if (!StrCompare(name, "V_MJPEG"))	return MEDIA_CODEC_MJPEG;
	if (!StrCompare(name, "A_VORBIS"))	return MEDIA_CODEC_VORBIS;
	if (!StrCompare(name, "A_OPUS"))	return MEDIA_CODEC_OPUS;

	return MEDIA_CODEC_NONE;
}

U0 MkvParseTrackEntry(CMediaCtx *m, I64 pos, I64 end)
{
	CMediaTrack	*t;
	I64			 id, size, il, sl, sub, sube, n;

	if (m->track_count >= MEDIA_TRACKS_MAX)
		return;

	t = &m->track[m->track_count];
	MemSet(t, 0, sizeof(CMediaTrack));

	while (pos < end)
	{
		id = MkvVint(m->buf, pos, end, &il, TRUE);
		if (il < 1)
			return;
		size = MkvVint(m->buf, pos + il, end, &sl, FALSE);
		if (sl < 1 || size < 0 || pos + il + sl + size > end)
			return;
		pos += il + sl;

		switch (id)
		{
			case MKV_TRACK_NUMBER:
				t->num = MkvUInt(m->buf, pos, size);
				break;
			case MKV_TRACK_TYPE:
				t->type = MkvUInt(m->buf, pos, size);
				break;
			case MKV_CODEC_ID:
				n = size;
				if (n > MEDIA_CODEC_NAME_MAX - 1)
					n = MEDIA_CODEC_NAME_MAX - 1;
				MemCopy(t->codec_name, m->buf + pos, n);
				t->codec_name[n] = 0;
				t->codec = MkvCodecId(t->codec_name);
				break;
			case MKV_CODEC_PRIVATE:
				t->codec_priv     = m->buf + pos;
				t->codec_priv_len = size;
				break;

			case MKV_VIDEO:
				sub  = pos;
				sube = pos + size;
				while (sub < sube)
				{
					id = MkvVint(m->buf, sub, sube, &il, TRUE);
					if (il < 1)
						break;
					n = MkvVint(m->buf, sub + il, sube, &sl, FALSE);
					if (sl < 1 || n < 0)
						break;
					sub += il + sl;
					if (id == MKV_PIXEL_WIDTH)
						t->width = MkvUInt(m->buf, sub, n);
					else if (id == MKV_PIXEL_HEIGHT)
						t->height = MkvUInt(m->buf, sub, n);
					sub += n;
				}
				break;

			case MKV_AUDIO:
				sub  = pos;
				sube = pos + size;
				while (sub < sube)
				{
					id = MkvVint(m->buf, sub, sube, &il, TRUE);
					if (il < 1)
						break;
					n = MkvVint(m->buf, sub + il, sube, &sl, FALSE);
					if (sl < 1 || n < 0)
						break;
					sub += il + sl;
					if (id == MKV_SAMPLE_FREQ)
						t->rate = ToI64(MkvFloat(m->buf, sub, n));
					else if (id == MKV_CHANNELS)
						t->channels = MkvUInt(m->buf, sub, n);
					sub += n;
				}
				break;
		}
		pos += size;
	}

	t->valid = TRUE;
	m->track_count++;
}

U0 MkvParseTracks(CMediaCtx *m, I64 pos, I64 end)
{
	I64 id, size, il, sl;

	while (pos < end)
	{
		id = MkvVint(m->buf, pos, end, &il, TRUE);
		if (il < 1)
			return;
		size = MkvVint(m->buf, pos + il, end, &sl, FALSE);
		if (sl < 1 || size < 0 || pos + il + sl + size > end)
			return;
		pos += il + sl;
		if (id == MKV_TRACK_ENTRY)
			MkvParseTrackEntry(m, pos, pos + size);
		pos += size;
	}
}

U0 MkvParseInfo(CMediaCtx *m, I64 pos, I64 end)
{
	I64 id, size, il, sl;
	F64 dur = 0.0;

	while (pos < end)
	{
		id = MkvVint(m->buf, pos, end, &il, TRUE);
		if (il < 1)
			return;
		size = MkvVint(m->buf, pos + il, end, &sl, FALSE);
		if (sl < 1 || size < 0 || pos + il + sl + size > end)
			return;
		pos += il + sl;
		if (id == MKV_TIMECODE_SCALE)
			m->timecode_scale = MkvUInt(m->buf, pos, size);
		else if (id == MKV_DURATION)
			dur = MkvFloat(m->buf, pos, size);
		pos += size;
	}

	if (dur > 0.0)
		m->duration = dur * ToF64(m->timecode_scale) / 1000000000.0;
}

public Bool MkvOpen(CMediaCtx *m, U8 *buf, I64 size)
{//Read the header, Info and Tracks. Clusters are walked lazily by MkvNext.
	I64 id, esize, il, sl, pos, end, estart;

	MemSet(m, 0, sizeof(CMediaCtx));
	m->buf            = buf;
	m->size           = size;
	m->timecode_scale = 1000000;	//Matroska default, 1ms

	if (!buf || size < 8)
		return FALSE;

	id = MkvVint(buf, 0, size, &il, TRUE);
	if (il < 1 || id != EBML_HDR)
		return FALSE;
	esize = MkvVint(buf, il, size, &sl, FALSE);
	if (sl < 1 || esize < 0)
		return FALSE;

	pos = il + sl + esize;
	id  = MkvVint(buf, pos, size, &il, TRUE);
	if (il < 1 || id != MKV_SEGMENT)
		return FALSE;
	esize = MkvVint(buf, pos + il, size, &sl, FALSE);
	if (sl < 1)
		return FALSE;

	pos += il + sl;
	if (esize < 0 || MkvSizeUnknown(esize, sl))
		end = size;
	else
	{
		end = pos + esize;
		if (end > size)
			end = size;
	}
	m->seg_end = end;
	m->pos     = pos;

	//Top level of the Segment. Clusters are left for MkvNext.
	while (pos < end)
	{
		estart = pos;
		id = MkvVint(buf, pos, end, &il, TRUE);
		if (il < 1)
			break;
		esize = MkvVint(buf, pos + il, end, &sl, FALSE);
		if (sl < 1)
			break;
		pos += il + sl;
		if (esize < 0 || pos + esize > end)
			esize = end - pos;

		if (id == MKV_INFO)
			MkvParseInfo(m, pos, pos + esize);
		else if (id == MKV_TRACKS)
			MkvParseTracks(m, pos, pos + esize);
		else if (id == MKV_CLUSTER)
		{//Hand the whole element to MkvNext, header included: it is what opens
		 //the cluster and reads its Timecode.
			pos = estart;
			break;
		}

		pos += esize;
	}

	m->pos       = pos;
	m->start_pos = pos;

	return ToBool(m->track_count > 0);
}

public U0 MkvRewind(CMediaCtx *m)
{//Back to the first cluster. There is no cue index, so a seek decodes forward
//from here.
	if (!m)
		return;
	m->pos        = m->start_pos;
	m->in_cluster = FALSE;
	m->clus_end   = 0;
	m->clus_time  = 0;
}

Bool MkvBlockPacket(CMediaCtx *m, I64 pos, I64 end, Bool simple,
					CMediaPacket *pkt)
{//Block/SimpleBlock payload -> one packet. FALSE when it must be skipped.
	I64 track, vl, tc, flags;

	track = MkvVint(m->buf, pos, end, &vl, FALSE);
	if (vl < 1 || pos + vl + 3 > end)
		return FALSE;
	pos += vl;

	tc = (m->buf[pos] << 8) | m->buf[pos + 1];
	if (tc & 0x8000)
		tc -= 0x10000;		//signed, relative to the cluster
	flags = m->buf[pos + 2];
	pos += 3;

	if (flags & MKV_BF_LACING)
	{//Xiph, fixed and EBML lacing all pack several frames in one block
		m->laced_skipped++;
		return FALSE;
	}

	pkt->data  = m->buf + pos;
	pkt->size  = end - pos;
	pkt->track = track;
	pkt->time  = ToF64(m->clus_time + tc) * ToF64(m->timecode_scale) /
				 1000000000.0;
	if (simple)
		pkt->key = ToBool(flags & MKV_BF_KEY);
	else
		pkt->key = TRUE;	//BlockGroup without ReferenceBlock is a keyframe

	return ToBool(pkt->size > 0);
}

public Bool MkvNext(CMediaCtx *m, CMediaPacket *pkt)
{//Next frame in stream order. FALSE at end of stream.
	I64 id, size, il, sl, sub, sube, bid, bsize;

	while (TRUE)
	{
		if (m->in_cluster && m->pos >= m->clus_end)
			m->in_cluster = FALSE;

		if (m->pos >= m->seg_end)
			return FALSE;

		id = MkvVint(m->buf, m->pos, m->seg_end, &il, TRUE);
		if (il < 1)
			return FALSE;
		size = MkvVint(m->buf, m->pos + il, m->seg_end, &sl, FALSE);
		if (sl < 1)
			return FALSE;
		m->pos += il + sl;
		if (size < 0 || m->pos + size > m->seg_end)
			size = m->seg_end - m->pos;

		if (id == MKV_CLUSTER)
		{
			m->in_cluster = TRUE;
			m->clus_end   = m->pos + size;
			m->clus_time  = 0;
		}
		else if (id == MKV_TIMECODE && m->in_cluster)
		{
			m->clus_time = MkvUInt(m->buf, m->pos, size);
			m->pos += size;
		}
		else if (id == MKV_SIMPLE_BLOCK && m->in_cluster)
		{
			sub  = m->pos;
			sube = m->pos + size;
			m->pos += size;
			if (MkvBlockPacket(m, sub, sube, TRUE, pkt))
				return TRUE;
		}
		else if (id == MKV_BLOCK_GROUP && m->in_cluster)
		{
			sub  = m->pos;
			sube = m->pos + size;
			m->pos += size;
			while (sub < sube)
			{
				bid = MkvVint(m->buf, sub, sube, &il, TRUE);
				if (il < 1)
					break;
				bsize = MkvVint(m->buf, sub + il, sube, &sl, FALSE);
				if (sl < 1 || bsize < 0)
					break;
				sub += il + sl;
				if (bid == MKV_BLOCK)
				{
					if (MkvBlockPacket(m, sub, sub + bsize, FALSE, pkt))
						return TRUE;
				}
				sub += bsize;
			}
		}
		else
			m->pos += size;
	}

	return FALSE;
}

public U0 MkvRep(CMediaCtx *m)
{//Track table and cursor state.
	CMediaTrack	*t;
	I64			 i;

	"Matroska: %d track(s), %.2fs, tick %dns\n",
		m->track_count, m->duration, m->timecode_scale;
	for (i = 0; i < m->track_count; i++)
	{
		t = &m->track[i];
		"  %d: \"%s\"", t->num, t->codec_name;
		if (t->type == MEDIA_TRACK_VIDEO)
			"  video %dx%d", t->width, t->height;
		else if (t->type == MEDIA_TRACK_AUDIO)
			"  audio %dHz %dch", t->rate, t->channels;
		if (!t->codec)
			"  UNSUPPORTED";
		"\n";
	}
	if (m->laced_skipped)
		"  %d laced block(s) skipped\n", m->laced_skipped;
}
