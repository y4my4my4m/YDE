//H.264 8x8 intra prediction, extracted from ffmpeg's
//libavcodec/h264pred_template.c by utils/h264pred8.py. Do not edit.
//
//t holds the sixteen filtered samples above the block, l the eight
//to its left, lt the corner. DC and the availability rules are in
//H264.ZC; these are the modes that only rearrange edge samples.

U0 H264Pred8x8(U8 *dst, I64 st, I64 mode, I64 *t, I64 *l, I64 lt)
{
	if (mode == 0)
	{//pred8x8l_vertical
		dst[0 * st + 0] = t[0];
		dst[0 * st + 1] = t[1];
		dst[0 * st + 2] = t[2];
		dst[0 * st + 3] = t[3];
		dst[0 * st + 4] = t[4];
		dst[0 * st + 5] = t[5];
		dst[0 * st + 6] = t[6];
		dst[0 * st + 7] = t[7];
		dst[1 * st + 0] = t[0];
		dst[1 * st + 1] = t[1];
		dst[1 * st + 2] = t[2];
		dst[1 * st + 3] = t[3];
		dst[1 * st + 4] = t[4];
		dst[1 * st + 5] = t[5];
		dst[1 * st + 6] = t[6];
		dst[1 * st + 7] = t[7];
		dst[2 * st + 0] = t[0];
		dst[2 * st + 1] = t[1];
		dst[2 * st + 2] = t[2];
		dst[2 * st + 3] = t[3];
		dst[2 * st + 4] = t[4];
		dst[2 * st + 5] = t[5];
		dst[2 * st + 6] = t[6];
		dst[2 * st + 7] = t[7];
		dst[3 * st + 0] = t[0];
		dst[3 * st + 1] = t[1];
		dst[3 * st + 2] = t[2];
		dst[3 * st + 3] = t[3];
		dst[3 * st + 4] = t[4];
		dst[3 * st + 5] = t[5];
		dst[3 * st + 6] = t[6];
		dst[3 * st + 7] = t[7];
		dst[4 * st + 0] = t[0];
		dst[4 * st + 1] = t[1];
		dst[4 * st + 2] = t[2];
		dst[4 * st + 3] = t[3];
		dst[4 * st + 4] = t[4];
		dst[4 * st + 5] = t[5];
		dst[4 * st + 6] = t[6];
		dst[4 * st + 7] = t[7];
		dst[5 * st + 0] = t[0];
		dst[5 * st + 1] = t[1];
		dst[5 * st + 2] = t[2];
		dst[5 * st + 3] = t[3];
		dst[5 * st + 4] = t[4];
		dst[5 * st + 5] = t[5];
		dst[5 * st + 6] = t[6];
		dst[5 * st + 7] = t[7];
		dst[6 * st + 0] = t[0];
		dst[6 * st + 1] = t[1];
		dst[6 * st + 2] = t[2];
		dst[6 * st + 3] = t[3];
		dst[6 * st + 4] = t[4];
		dst[6 * st + 5] = t[5];
		dst[6 * st + 6] = t[6];
		dst[6 * st + 7] = t[7];
		dst[7 * st + 0] = t[0];
		dst[7 * st + 1] = t[1];
		dst[7 * st + 2] = t[2];
		dst[7 * st + 3] = t[3];
		dst[7 * st + 4] = t[4];
		dst[7 * st + 5] = t[5];
		dst[7 * st + 6] = t[6];
		dst[7 * st + 7] = t[7];
	}
	else if (mode == 1)
	{//pred8x8l_horizontal
		dst[0 * st + 0] = l[0];
		dst[0 * st + 1] = l[0];
		dst[0 * st + 2] = l[0];
		dst[0 * st + 3] = l[0];
		dst[0 * st + 4] = l[0];
		dst[0 * st + 5] = l[0];
		dst[0 * st + 6] = l[0];
		dst[0 * st + 7] = l[0];
		dst[1 * st + 0] = l[1];
		dst[1 * st + 1] = l[1];
		dst[1 * st + 2] = l[1];
		dst[1 * st + 3] = l[1];
		dst[1 * st + 4] = l[1];
		dst[1 * st + 5] = l[1];
		dst[1 * st + 6] = l[1];
		dst[1 * st + 7] = l[1];
		dst[2 * st + 0] = l[2];
		dst[2 * st + 1] = l[2];
		dst[2 * st + 2] = l[2];
		dst[2 * st + 3] = l[2];
		dst[2 * st + 4] = l[2];
		dst[2 * st + 5] = l[2];
		dst[2 * st + 6] = l[2];
		dst[2 * st + 7] = l[2];
		dst[3 * st + 0] = l[3];
		dst[3 * st + 1] = l[3];
		dst[3 * st + 2] = l[3];
		dst[3 * st + 3] = l[3];
		dst[3 * st + 4] = l[3];
		dst[3 * st + 5] = l[3];
		dst[3 * st + 6] = l[3];
		dst[3 * st + 7] = l[3];
		dst[4 * st + 0] = l[4];
		dst[4 * st + 1] = l[4];
		dst[4 * st + 2] = l[4];
		dst[4 * st + 3] = l[4];
		dst[4 * st + 4] = l[4];
		dst[4 * st + 5] = l[4];
		dst[4 * st + 6] = l[4];
		dst[4 * st + 7] = l[4];
		dst[5 * st + 0] = l[5];
		dst[5 * st + 1] = l[5];
		dst[5 * st + 2] = l[5];
		dst[5 * st + 3] = l[5];
		dst[5 * st + 4] = l[5];
		dst[5 * st + 5] = l[5];
		dst[5 * st + 6] = l[5];
		dst[5 * st + 7] = l[5];
		dst[6 * st + 0] = l[6];
		dst[6 * st + 1] = l[6];
		dst[6 * st + 2] = l[6];
		dst[6 * st + 3] = l[6];
		dst[6 * st + 4] = l[6];
		dst[6 * st + 5] = l[6];
		dst[6 * st + 6] = l[6];
		dst[6 * st + 7] = l[6];
		dst[7 * st + 0] = l[7];
		dst[7 * st + 1] = l[7];
		dst[7 * st + 2] = l[7];
		dst[7 * st + 3] = l[7];
		dst[7 * st + 4] = l[7];
		dst[7 * st + 5] = l[7];
		dst[7 * st + 6] = l[7];
		dst[7 * st + 7] = l[7];
	}
	else if (mode == 3)
	{//pred8x8l_down_left
		dst[0 * st + 0] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[1 * st + 0] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[0 * st + 1] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[2 * st + 0] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[1 * st + 1] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[0 * st + 2] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[3 * st + 0] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[2 * st + 1] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[1 * st + 2] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[0 * st + 3] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[4 * st + 0] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[3 * st + 1] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[2 * st + 2] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[1 * st + 3] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[0 * st + 4] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[5 * st + 0] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[4 * st + 1] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[3 * st + 2] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[2 * st + 3] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[1 * st + 4] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[0 * st + 5] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
		dst[6 * st + 0] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[5 * st + 1] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[4 * st + 2] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[3 * st + 3] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[2 * st + 4] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[1 * st + 5] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[0 * st + 6] = (t[6] + 2*t[7] + t[8] + 2) >> 2;
		dst[7 * st + 0] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[6 * st + 1] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[5 * st + 2] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[4 * st + 3] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[3 * st + 4] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[2 * st + 5] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[1 * st + 6] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[0 * st + 7] = (t[7] + 2*t[8] + t[9] + 2) >> 2;
		dst[7 * st + 1] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[6 * st + 2] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[5 * st + 3] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[4 * st + 4] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[3 * st + 5] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[2 * st + 6] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[1 * st + 7] = (t[8] + 2*t[9] + t[10] + 2) >> 2;
		dst[7 * st + 2] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[6 * st + 3] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[5 * st + 4] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[4 * st + 5] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[3 * st + 6] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[2 * st + 7] = (t[9] + 2*t[10] + t[11] + 2) >> 2;
		dst[7 * st + 3] = (t[10] + 2*t[11] + t[12] + 2) >> 2;
		dst[6 * st + 4] = (t[10] + 2*t[11] + t[12] + 2) >> 2;
		dst[5 * st + 5] = (t[10] + 2*t[11] + t[12] + 2) >> 2;
		dst[4 * st + 6] = (t[10] + 2*t[11] + t[12] + 2) >> 2;
		dst[3 * st + 7] = (t[10] + 2*t[11] + t[12] + 2) >> 2;
		dst[7 * st + 4] = (t[11] + 2*t[12] + t[13] + 2) >> 2;
		dst[6 * st + 5] = (t[11] + 2*t[12] + t[13] + 2) >> 2;
		dst[5 * st + 6] = (t[11] + 2*t[12] + t[13] + 2) >> 2;
		dst[4 * st + 7] = (t[11] + 2*t[12] + t[13] + 2) >> 2;
		dst[7 * st + 5] = (t[12] + 2*t[13] + t[14] + 2) >> 2;
		dst[6 * st + 6] = (t[12] + 2*t[13] + t[14] + 2) >> 2;
		dst[5 * st + 7] = (t[12] + 2*t[13] + t[14] + 2) >> 2;
		dst[7 * st + 6] = (t[13] + 2*t[14] + t[15] + 2) >> 2;
		dst[6 * st + 7] = (t[13] + 2*t[14] + t[15] + 2) >> 2;
		dst[7 * st + 7] = (t[14] + 3*t[15] + 2) >> 2;
	}
	else if (mode == 4)
	{//pred8x8l_down_right
		dst[7 * st + 0] = (l[7] + 2*l[6] + l[5] + 2) >> 2;
		dst[6 * st + 0] = (l[6] + 2*l[5] + l[4] + 2) >> 2;
		dst[7 * st + 1] = (l[6] + 2*l[5] + l[4] + 2) >> 2;
		dst[5 * st + 0] = (l[5] + 2*l[4] + l[3] + 2) >> 2;
		dst[6 * st + 1] = (l[5] + 2*l[4] + l[3] + 2) >> 2;
		dst[7 * st + 2] = (l[5] + 2*l[4] + l[3] + 2) >> 2;
		dst[4 * st + 0] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[5 * st + 1] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[6 * st + 2] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[7 * st + 3] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[3 * st + 0] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[4 * st + 1] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[5 * st + 2] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[6 * st + 3] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[7 * st + 4] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[2 * st + 0] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[3 * st + 1] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[4 * st + 2] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[5 * st + 3] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[6 * st + 4] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[7 * st + 5] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[1 * st + 0] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[2 * st + 1] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[3 * st + 2] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[4 * st + 3] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[5 * st + 4] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[6 * st + 5] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[7 * st + 6] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[0 * st + 0] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[1 * st + 1] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[2 * st + 2] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[3 * st + 3] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[4 * st + 4] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[5 * st + 5] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[6 * st + 6] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[7 * st + 7] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[0 * st + 1] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[1 * st + 2] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[2 * st + 3] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[3 * st + 4] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[4 * st + 5] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[5 * st + 6] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[6 * st + 7] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[0 * st + 2] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[1 * st + 3] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[2 * st + 4] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[3 * st + 5] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[4 * st + 6] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[5 * st + 7] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[0 * st + 3] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[1 * st + 4] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[2 * st + 5] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[3 * st + 6] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[4 * st + 7] = (t[1] + 2*t[2] + t[3] + 2) >> 2;
		dst[0 * st + 4] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[1 * st + 5] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[2 * st + 6] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[3 * st + 7] = (t[2] + 2*t[3] + t[4] + 2) >> 2;
		dst[0 * st + 5] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[1 * st + 6] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[2 * st + 7] = (t[3] + 2*t[4] + t[5] + 2) >> 2;
		dst[0 * st + 6] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[1 * st + 7] = (t[4] + 2*t[5] + t[6] + 2) >> 2;
		dst[0 * st + 7] = (t[5] + 2*t[6] + t[7] + 2) >> 2;
	}
	else if (mode == 5)
	{//pred8x8l_vertical_right
		dst[6 * st + 0] = (l[5] + 2*l[4] + l[3] + 2) >> 2;
		dst[7 * st + 0] = (l[6] + 2*l[5] + l[4] + 2) >> 2;
		dst[4 * st + 0] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[6 * st + 1] = (l[3] + 2*l[2] + l[1] + 2) >> 2;
		dst[5 * st + 0] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[7 * st + 1] = (l[4] + 2*l[3] + l[2] + 2) >> 2;
		dst[2 * st + 0] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[4 * st + 1] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[6 * st + 2] = (l[1] + 2*l[0] + lt + 2) >> 2;
		dst[3 * st + 0] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[5 * st + 1] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[7 * st + 2] = (l[2] + 2*l[1] + l[0] + 2) >> 2;
		dst[1 * st + 0] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[3 * st + 1] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[5 * st + 2] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[7 * st + 3] = (l[0] + 2*lt + t[0] + 2) >> 2;
		dst[0 * st + 0] = (lt + t[0] + 1) >> 1;
		dst[2 * st + 1] = (lt + t[0] + 1) >> 1;
		dst[4 * st + 2] = (lt + t[0] + 1) >> 1;
		dst[6 * st + 3] = (lt + t[0] + 1) >> 1;
		dst[1 * st + 1] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[3 * st + 2] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[5 * st + 3] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[7 * st + 4] = (lt + 2*t[0] + t[1] + 2) >> 2;
		dst[0 * st + 1] = (t[0] + t[1] + 1) >> 1;
		dst[2 * st + 2] = (t[0] + t[1] + 1) >> 1;
		dst[4 * st + 3] = (t[0] + t[1] + 1) >> 1;
		dst[6 * st + 4] = (t[0] + t[1] + 1) >> 1;
		dst[1 * st + 2] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[3 * st + 3] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[5 * st + 4] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[7 * st + 5] = (t[0] + 2*t[1] + t[2] + 2) >> 2;
		dst[0 * st + 2] = (t[1] + t[2] + 1) >> 1;
		dst[2 * st + 3] = (t[1] + t[2] + 1) >> 1;
		dst[4 * st + 4] = (t[1] + t[2] + 1) >> 1;
		dst[6 * st + 5] = (t[1] + t[2] + 1) >> 1;
