//AV1 decoder. Spec section numbers refer to the AV1 Bitstream & Decoding
//Process Specification, version 1.0.0 with Errata 1.
//
//Layout is bottom up because the compiler is single pass: primitives, then
//headers, then the block layer, then the OBU dispatcher last of all.

#define AV1_OBU_SEQUENCE_HEADER		1
#define AV1_OBU_TEMPORAL_DELIMITER	2
#define AV1_OBU_FRAME_HEADER		3
#define AV1_OBU_TILE_GROUP			4
#define AV1_OBU_METADATA			5
#define AV1_OBU_FRAME				6
#define AV1_OBU_REDUNDANT_FRAME_HEADER 7
#define AV1_OBU_TILE_LIST			8
#define AV1_OBU_PADDING				15

#define AV1_KEY_FRAME				0
#define AV1_INTER_FRAME				1
#define AV1_INTRA_ONLY_FRAME		2
#define AV1_SWITCH_FRAME			3

#define AV1_OPS_MAX					32
#define AV1_SELECT_SCREEN_CONTENT_TOOLS	2
#define AV1_SELECT_INTEGER_MV		2

/***** bit reader, 4.10 *****/

class CAv1Bits
{//MSB first over a byte buffer. pos and end are bit counts.
	U8		*buf;
	I64		 pos, end;
	Bool	 eof;
};

U0 Av1BitsInit(CAv1Bits *b, U8 *buf, I64 size)
{
	b->buf = buf;
	b->pos = 0;
	b->end = size * 8;
	b->eof = FALSE;
}

I64 Av1F(CAv1Bits *b, I64 n)
{//f(n), 4.10.2.
	I64 v = 0, i;

	for (i = 0; i < n; i++)
	{
		if (b->pos >= b->end)
		{
			b->eof = TRUE;
			return v;
		}
		v = v << 1 | (b->buf[b->pos >> 3] >> (7 - (b->pos & 7)) & 1);
		b->pos++;
	}

	return v;
}

I64 Av1Su(CAv1Bits *b, I64 n)
{//su(n), 4.10.6: two's complement in n bits.
	I64 v = Av1F(b, n), mask = 1 << (n - 1);

	if (v & mask)
		v -= 1 << n;

	return v;
}

I64 Av1Ns(CAv1Bits *b, I64 n)
{//ns(n), 4.10.4: no analogue in VP8, VP9 or H.264. Values below the split
//point cost one bit less than the rest.
	I64 w = 0, x = n, m, v, extra;

	if (n < 1)
		return 0;
	while (x)
	{
		x = x >> 1;
		w++;
	}
	m = (1 << w) - n;
	v = Av1F(b, w - 1);
	if (v < m)
		return v;
	extra = Av1F(b, 1);

	return (v << 1) - m + extra;
}

I64 Av1Le(CAv1Bits *b, I64 n)
{//le(n), 4.10.7: little endian bytes, byte aligned.
	I64 t = 0, i, byte;

	for (i = 0; i < n; i++)
	{
		byte = Av1F(b, 8);
		t   |= byte << (i * 8);
	}

	return t;
}

I64 Av1Uvlc(CAv1Bits *b)
{//uvlc(), 4.10.3.
	I64 zeros = 0, value;

	while (TRUE)
	{
		if (Av1F(b, 1))
			break;
		zeros++;
		if (zeros >= 32 || b->eof)
			return 0xFFFFFFFF;
	}
	value = Av1F(b, zeros);

	return value + (1 << zeros) - 1;
}

U0 Av1ByteAlign(CAv1Bits *b)
{//5.3.5. OBU_FRAME and OBU_TILE_GROUP align here instead of taking
//trailing_bits, which 5.3.1 excludes them from.
	while (b->pos & 7)
		Av1F(b, 1);
}

I64 Av1FloorLog2(I64 x)
{
	I64 s = 0;

	while (x)
	{
		x = x >> 1;
		s++;
	}

	return s - 1;
}

/***** sequence header, 5.5 *****/

class CAv1Seq
{
	Bool	 valid;
	I64		 seq_profile;
	Bool	 still_picture, reduced_still_picture_header;
	Bool	 timing_info_present, decoder_model_info_present;
	Bool	 initial_display_delay_present, equal_picture_interval;
	I64		 num_units_in_display_tick, time_scale, num_ticks_per_picture;
	I64		 buffer_delay_length, num_units_in_decoding_tick;
	I64		 buffer_removal_time_length, frame_presentation_time_length;
	I64		 operating_points_cnt;
	I64		 operating_point_idc[AV1_OPS_MAX], seq_level_idx[AV1_OPS_MAX];
	I64		 seq_tier[AV1_OPS_MAX];
	Bool	 decoder_model_present_for_op[AV1_OPS_MAX];
	I64		 frame_width_bits, frame_height_bits;
	I64		 max_frame_width, max_frame_height;
	Bool	 frame_id_numbers_present;
	I64		 delta_frame_id_length, additional_frame_id_length;
	Bool	 use_128x128_superblock, enable_filter_intra;
	Bool	 enable_intra_edge_filter, enable_interintra_compound;
	Bool	 enable_masked_compound, enable_warped_motion, enable_dual_filter;
	Bool	 enable_order_hint, enable_jnt_comp, enable_ref_frame_mvs;
	I64		 force_screen_content_tools, force_integer_mv;
	I64		 order_hint_bits;
	Bool	 enable_superres, enable_cdef, enable_restoration;
	//color_config, 5.5.2
	Bool	 mono_chrome, color_range, separate_uv_delta_q;
	I64		 color_primaries, transfer_characteristics, matrix_coefficients;
	I64		 subsampling_x, subsampling_y, chroma_sample_position;
	I64		 bit_depth, num_planes;
	Bool	 film_grain_params_present;
	I64		 operating_point_idc_sel;
};

U0 Av1TimingInfo(CAv1Bits *b, CAv1Seq *s)
{//5.5.3.
	s->num_units_in_display_tick = Av1F(b, 32);
	s->time_scale                = Av1F(b, 32);
	s->equal_picture_interval    = ToBool(Av1F(b, 1));
	if (s->equal_picture_interval)
		s->num_ticks_per_picture = Av1Uvlc(b) + 1;
}

U0 Av1DecoderModelInfo(CAv1Bits *b, CAv1Seq *s)
{//5.5.4.
	s->buffer_delay_length             = Av1F(b, 5) + 1;
	s->num_units_in_decoding_tick      = Av1F(b, 32);
	s->buffer_removal_time_length      = Av1F(b, 5) + 1;
	s->frame_presentation_time_length  = Av1F(b, 5) + 1;
}

U0 Av1OperatingParams(CAv1Bits *b, CAv1Seq *s)
{//5.5.5. Parsed for its bits; the values drive no decoding here.
	Av1F(b, s->buffer_delay_length);
	Av1F(b, s->buffer_delay_length);
	Av1F(b, 1);
}

U0 Av1ColorConfig(CAv1Bits *b, CAv1Seq *s)
{//5.5.2.
	Bool	high_bitdepth = ToBool(Av1F(b, 1)), twelve_bit = FALSE;
	Bool	desc;

	s->bit_depth = 8;
	if (s->seq_profile == 2 && high_bitdepth)
	{
		twelve_bit   = ToBool(Av1F(b, 1));
		s->bit_depth = 10;
		if (twelve_bit)
			s->bit_depth = 12;
	}
	else if (s->seq_profile <= 2 && high_bitdepth)
		s->bit_depth = 10;
	s->mono_chrome = FALSE;
	if (s->seq_profile != 1)
		s->mono_chrome = ToBool(Av1F(b, 1));
	s->num_planes = 3;
	if (s->mono_chrome)
		s->num_planes = 1;
	s->color_primaries          = 2;		//CP_UNSPECIFIED
	s->transfer_characteristics = 2;		//TC_UNSPECIFIED
	s->matrix_coefficients      = 2;		//MC_UNSPECIFIED
	desc = ToBool(Av1F(b, 1));
	if (desc)
	{
		s->color_primaries          = Av1F(b, 8);
		s->transfer_characteristics = Av1F(b, 8);
		s->matrix_coefficients      = Av1F(b, 8);
	}
	s->subsampling_x          = 1;
	s->subsampling_y          = 1;
	s->chroma_sample_position = 0;
	s->separate_uv_delta_q    = FALSE;
	if (s->mono_chrome)
	{
		s->color_range = ToBool(Av1F(b, 1));

		return;
	}
	if (s->color_primaries == 1 && s->transfer_characteristics == 13 &&
		s->matrix_coefficients == 0)
	{//sRGB
		s->color_range   = TRUE;
		s->subsampling_x = 0;
		s->subsampling_y = 0;
	}
	else
	{
		s->color_range = ToBool(Av1F(b, 1));
		if (!s->seq_profile)
		{
			s->subsampling_x = 1;
			s->subsampling_y = 1;
		}
		else if (s->seq_profile == 1)
		{
			s->subsampling_x = 0;
			s->subsampling_y = 0;
		}
		else if (s->bit_depth == 12)
		{
			s->subsampling_x = Av1F(b, 1);
			s->subsampling_y = 0;
			if (s->subsampling_x)
				s->subsampling_y = Av1F(b, 1);
		}
		else
		{
			s->subsampling_x = 1;
			s->subsampling_y = 0;
		}
		if (s->subsampling_x && s->subsampling_y)
			s->chroma_sample_position = Av1F(b, 2);
	}
	s->separate_uv_delta_q = ToBool(Av1F(b, 1));
}

Bool Av1ParseSeqHeader(CAv1Seq *s, U8 *buf, I64 size)
{//5.5.1.
	CAv1Bits	 b;
	I64			 i, n;
	Bool		 seq_choose_screen, seq_choose_integer_mv;
	Bool		 initial_display_delay_for_op;

	MemSet(s, 0, sizeof(CAv1Seq));
	Av1BitsInit(&b, buf, size);
	s->seq_profile   = Av1F(&b, 3);
	if (s->seq_profile > 2)
		return FALSE;
	s->still_picture = ToBool(Av1F(&b, 1));
	s->reduced_still_picture_header = ToBool(Av1F(&b, 1));
	if (s->reduced_still_picture_header)
	{
		s->operating_points_cnt   = 1;
		s->operating_point_idc[0] = 0;
		s->seq_level_idx[0]       = Av1F(&b, 5);
	}
	else
	{
		s->timing_info_present = ToBool(Av1F(&b, 1));
		if (s->timing_info_present)
		{
			Av1TimingInfo(&b, s);
			s->decoder_model_info_present = ToBool(Av1F(&b, 1));
			if (s->decoder_model_info_present)
				Av1DecoderModelInfo(&b, s);
		}
		s->initial_display_delay_present = ToBool(Av1F(&b, 1));
		s->operating_points_cnt          = Av1F(&b, 5) + 1;
		if (s->operating_points_cnt > AV1_OPS_MAX)
			return FALSE;
		for (i = 0; i < s->operating_points_cnt; i++)
		{
			s->operating_point_idc[i] = Av1F(&b, 12);
			s->seq_level_idx[i]       = Av1F(&b, 5);
			s->seq_tier[i]            = 0;
			if (s->seq_level_idx[i] > 7)
				s->seq_tier[i] = Av1F(&b, 1);
			if (s->decoder_model_info_present)
			{
				s->decoder_model_present_for_op[i] = ToBool(Av1F(&b, 1));
				if (s->decoder_model_present_for_op[i])
					Av1OperatingParams(&b, s);
			}
			if (s->initial_display_delay_present)
			{
				initial_display_delay_for_op = ToBool(Av1F(&b, 1));
				if (initial_display_delay_for_op)
					Av1F(&b, 4);
			}
		}
	}
	//choose_operating_point() is system dependent; the first is taken.
	s->operating_point_idc_sel = s->operating_point_idc[0];
	s->frame_width_bits        = Av1F(&b, 4) + 1;
	s->frame_height_bits       = Av1F(&b, 4) + 1;
	s->max_frame_width         = Av1F(&b, s->frame_width_bits) + 1;
	s->max_frame_height        = Av1F(&b, s->frame_height_bits) + 1;
	s->frame_id_numbers_present = FALSE;
	if (!s->reduced_still_picture_header)
		s->frame_id_numbers_present = ToBool(Av1F(&b, 1));
	if (s->frame_id_numbers_present)
	{
		s->delta_frame_id_length      = Av1F(&b, 4) + 2;
		s->additional_frame_id_length = Av1F(&b, 3) + 1;
	}
	s->use_128x128_superblock   = ToBool(Av1F(&b, 1));
	s->enable_filter_intra      = ToBool(Av1F(&b, 1));
	s->enable_intra_edge_filter = ToBool(Av1F(&b, 1));
	if (s->reduced_still_picture_header)
	{
		s->force_screen_content_tools = AV1_SELECT_SCREEN_CONTENT_TOOLS;
		s->force_integer_mv           = AV1_SELECT_INTEGER_MV;
		s->order_hint_bits            = 0;
	}
	else
	{
		s->enable_interintra_compound = ToBool(Av1F(&b, 1));
		s->enable_masked_compound     = ToBool(Av1F(&b, 1));
		s->enable_warped_motion       = ToBool(Av1F(&b, 1));
		s->enable_dual_filter         = ToBool(Av1F(&b, 1));
		s->enable_order_hint          = ToBool(Av1F(&b, 1));
		if (s->enable_order_hint)
		{
			s->enable_jnt_comp      = ToBool(Av1F(&b, 1));
			s->enable_ref_frame_mvs = ToBool(Av1F(&b, 1));
		}
		seq_choose_screen = ToBool(Av1F(&b, 1));
		if (seq_choose_screen)
			s->force_screen_content_tools = AV1_SELECT_SCREEN_CONTENT_TOOLS;
		else
			s->force_screen_content_tools = Av1F(&b, 1);
		s->force_integer_mv = AV1_SELECT_INTEGER_MV;
		if (s->force_screen_content_tools > 0)
		{
			seq_choose_integer_mv = ToBool(Av1F(&b, 1));
			if (!seq_choose_integer_mv)
				s->force_integer_mv = Av1F(&b, 1);
		}
		s->order_hint_bits = 0;
		if (s->enable_order_hint)
			s->order_hint_bits = Av1F(&b, 3) + 1;
	}
	s->enable_superres    = ToBool(Av1F(&b, 1));
	s->enable_cdef        = ToBool(Av1F(&b, 1));
	s->enable_restoration = ToBool(Av1F(&b, 1));
	Av1ColorConfig(&b, s);
	s->film_grain_params_present = ToBool(Av1F(&b, 1));
	if (b.eof)
		return FALSE;
	s->valid = TRUE;

	return TRUE;
}

/***** open bitstream units, 5.3 *****/

class CAv1Obu
{
	I64		 type, temporal_id, spatial_id;
	I64		 size;				//payload bytes, excluding the header
	I64		 offset;			//payload start in the buffer
	Bool	 has_size;
};

I64 Av1Leb128(U8 *buf, I64 size, I64 pos, I64 *_used)
{//4.10.5. Up to eight bytes, seven bits each, low group first.
	I64 value = 0, i, byte;

	*_used = 0;
	for (i = 0; i < 8; i++)
	{
		if (pos + i >= size)
			return -1;
		byte   = buf[pos + i];
		value |= (byte & 0x7F) << (i * 7);
		if (!(byte & 0x80))
		{
			*_used = i + 1;

			return value;
		}
	}

	return -1;
}

Bool Av1ObuAt(CAv1Obu *o, U8 *buf, I64 size, I64 pos, I64 *_next)
{//5.3.1 and 5.3.2. A unit with no size field runs to the end of the buffer,
//which is what a container hands over.
	CAv1Bits	b;
	I64			used, hdr;

	MemSet(o, 0, sizeof(CAv1Obu));
	if (pos >= size)
		return FALSE;
	Av1BitsInit(&b, buf + pos, size - pos);
	if (Av1F(&b, 1))
		return FALSE;					//obu_forbidden_bit
	o->type     = Av1F(&b, 4);
	o->has_size = FALSE;
	hdr         = 1;
	if (Av1F(&b, 1))
	{//obu_extension_flag
		o->temporal_id = Av1F(&b, 3);
		o->spatial_id  = Av1F(&b, 2);
		Av1F(&b, 3);
		hdr = 2;
	}
	o->has_size = ToBool(Av1F(&b, 1));
	Av1F(&b, 1);						//obu_reserved_1bit
	if (b.eof)
		return FALSE;
	o->offset = pos + hdr;
	if (o->has_size)
	{
		o->size = Av1Leb128(buf, size, pos + hdr, &used);
		if (o->size < 0)
			return FALSE;
		o->offset += used;
	}
	else
		o->size = size - pos - hdr;
	if (o->offset + o->size > size)
		return FALSE;
	*_next = o->offset + o->size;

	return TRUE;
}

Bool Av1ObuDrop(CAv1Seq *s, CAv1Obu *o)
{//5.3.1: units outside the chosen operating point are discarded.
	I64 idc = s->operating_point_idc_sel;

	if (!idc || !o->temporal_id && !o->spatial_id)
		return FALSE;
	if (o->type != AV1_OBU_FRAME && o->type != AV1_OBU_FRAME_HEADER &&
		o->type != AV1_OBU_TILE_GROUP)
		return FALSE;
	if (!(idc >> o->temporal_id & 1))
		return TRUE;

	return ToBool(!(idc >> (o->spatial_id + 8) & 1));
}

/***** frame header, 5.9 *****/

#define AV1_NUM_REF_FRAMES			8
#define AV1_REFS_PER_FRAME			7
#define AV1_PRIMARY_REF_NONE		7
#define AV1_TOTAL_REFS_PER_FRAME	8
#define AV1_SUPERRES_DENOM_BITS		3
#define AV1_SUPERRES_DENOM_MIN		9
#define AV1_SUPERRES_NUM			8
#define AV1_MAX_TILE_WIDTH			4096
#define AV1_MAX_TILE_AREA			9437184		//4096 * 2304
#define AV1_MAX_TILE_COLS			64
#define AV1_MAX_TILE_ROWS			64
#define AV1_MAX_SEGMENTS			8
#define AV1_SEG_LVL_MAX				8
#define AV1_SEG_LVL_REF_FRAME		5
#define AV1_RESTORATION_TILESIZE_MAX 256
#define AV1_RESTORE_NONE			0
#define AV1_RESTORE_WIENER			1
#define AV1_RESTORE_SGRPROJ			2
#define AV1_RESTORE_SWITCHABLE		3
#define AV1_ONLY_4X4				0
#define AV1_TX_MODE_LARGEST			1
#define AV1_TX_MODE_SELECT			2

//5.9.14. Feature 5 is REF_FRAME, 6 SKIP, 7 GLOBALMV; the last two are flags
//and carry no value.
U8 av1_seg_feature_bits[AV1_SEG_LVL_MAX]   = {8, 6, 6, 6, 6, 3, 0, 0};
U8 av1_seg_feature_signed[AV1_SEG_LVL_MAX] = {1, 1, 1, 1, 1, 0, 0, 0};
I64 av1_seg_feature_max[AV1_SEG_LVL_MAX]   = {255, 63, 63, 63, 63, 7, 0, 0};
//5.9.20: the coded value is not the restoration type.
U8 av1_remap_lr_type[4] = {AV1_RESTORE_NONE, AV1_RESTORE_SWITCHABLE,
						   AV1_RESTORE_WIENER, AV1_RESTORE_SGRPROJ};

class CAv1Frame
{
	I64		 frame_type;
	Bool	 frame_is_intra, show_frame, showable_frame, error_resilient;
	Bool	 disable_cdf_update, allow_screen_content_tools;
	Bool	 force_integer_mv, frame_size_override, allow_intrabc;
	Bool	 disable_frame_end_update_cdf;
	I64		 order_hint, primary_ref_frame, refresh_frame_flags;
	I64		 frame_width, frame_height, upscaled_width;
	I64		 render_width, render_height;
	I64		 superres_denom, mi_cols, mi_rows;
	//tile_info
	Bool	 uniform_tile_spacing;
	I64		 tile_cols, tile_rows, tile_cols_log2, tile_rows_log2;
	I64		 mi_col_starts[AV1_MAX_TILE_COLS + 1];
	I64		 mi_row_starts[AV1_MAX_TILE_ROWS + 1];
	I64		 context_update_tile_id, tile_size_bytes;
	//quantization_params
	I64		 base_q_idx, delta_q_y_dc, delta_q_u_dc, delta_q_u_ac;
	I64		 delta_q_v_dc, delta_q_v_ac;
	Bool	 using_qmatrix;
	I64		 qm_y, qm_u, qm_v;
	//segmentation_params
	Bool	 segmentation_enabled, segmentation_update_map;
	Bool	 segmentation_temporal_update;
	U8		 feature_enabled[AV1_MAX_SEGMENTS * AV1_SEG_LVL_MAX];
	I64		 feature_data[AV1_MAX_SEGMENTS * AV1_SEG_LVL_MAX];
	Bool	 seg_id_pre_skip;
	I64		 last_active_seg_id;
	Bool	 coded_lossless, all_lossless;
	I64		 lossless[AV1_MAX_SEGMENTS];
	//delta_q / delta_lf
	Bool	 delta_q_present, delta_lf_present, delta_lf_multi;
	I64		 delta_q_res, delta_lf_res;
	//loop_filter_params
	I64		 loop_filter_level[4], loop_filter_sharpness;
	Bool	 loop_filter_delta_enabled;
	I64		 loop_filter_ref_deltas[AV1_TOTAL_REFS_PER_FRAME];
	I64		 loop_filter_mode_deltas[2];
	//cdef_params
	I64		 cdef_damping, cdef_bits;
	I64		 cdef_y_pri[8], cdef_y_sec[8], cdef_uv_pri[8], cdef_uv_sec[8];
	//lr_params
	I64		 frame_restoration_type[3], loop_restoration_size[3];
	I64		 lr_type[3];			//coded, before av1_remap_lr_type
	Bool	 uses_lr;
	I64		 tx_mode;
	Bool	 reduced_tx_set;
};

I64 Av1TileLog2(I64 blkSize, I64 target)
{//5.9.16: the smallest k with blkSize << k >= target.
	I64 k = 0;

	while ((blkSize << k) < target)
		k++;

	return k;
}

I64 Av1Clip3(I64 lo, I64 hi, I64 v)
{
	if (v < lo)
		return lo;
	if (v > hi)
		return hi;

	return v;
}

I64 Av1ReadDeltaQ(CAv1Bits *b)
{//5.9.13.
	if (Av1F(b, 1))
		return Av1Su(b, 7);

	return 0;
}

U0 Av1SuperresParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.8. The denominator is read even when superres is refused later, or
//every following field is misplaced.
	Bool use_superres = FALSE;

	if (s->enable_superres)
		use_superres = ToBool(Av1F(b, 1));
	f->superres_denom = AV1_SUPERRES_NUM;
	if (use_superres)
		f->superres_denom = Av1F(b, AV1_SUPERRES_DENOM_BITS) +
							AV1_SUPERRES_DENOM_MIN;
	f->upscaled_width = f->frame_width;
	f->frame_width    = (f->upscaled_width * AV1_SUPERRES_NUM +
						 (f->superres_denom >> 1)) / f->superres_denom;
}

U0 Av1ComputeImageSize(CAv1Frame *f)
{//5.9.9.
	f->mi_cols = 2 * ((f->frame_width + 7) >> 3);
	f->mi_rows = 2 * ((f->frame_height + 7) >> 3);
}

U0 Av1FrameSize(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.5.
	if (f->frame_size_override)
	{
		f->frame_width  = Av1F(b, s->frame_width_bits) + 1;
		f->frame_height = Av1F(b, s->frame_height_bits) + 1;
	}
	else
	{
		f->frame_width  = s->max_frame_width;
		f->frame_height = s->max_frame_height;
	}
	Av1SuperresParams(b, s, f);
	Av1ComputeImageSize(f);
}

U0 Av1RenderSize(CAv1Bits *b, CAv1Frame *f)
{//5.9.6.
	f->render_width  = f->upscaled_width;
	f->render_height = f->frame_height;
	if (Av1F(b, 1))
	{
		f->render_width  = Av1F(b, 16) + 1;
		f->render_height = Av1F(b, 16) + 1;
	}
}

U0 Av1TileInfo(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.15. Both spacing modes. The uniform branch derives the boundaries from
//one log2 count; the explicit branch reads each width with ns(), which is why
//that primitive exists at all.
	I64 sbCols, sbRows, sbShift, sbSize, maxTileWidthSb, maxTileAreaSb;
	I64 minLog2TileCols, maxLog2TileCols, maxLog2TileRows, minLog2Tiles;
	I64 minLog2TileRows, widestTileSb, maxTileHeightSb;
	I64 i, startSb, sizeSb, maxWidth, maxHeight, tileWidthSb, tileHeightSb;

	sbShift = 4;
	if (s->use_128x128_superblock)
		sbShift = 5;
	sbCols = (f->mi_cols + (1 << sbShift) - 1) >> sbShift;
	sbRows = (f->mi_rows + (1 << sbShift) - 1) >> sbShift;
	sbSize = sbShift + 2;
	maxTileWidthSb  = AV1_MAX_TILE_WIDTH >> sbSize;
	maxTileAreaSb   = AV1_MAX_TILE_AREA >> (2 * sbSize);
	minLog2TileCols = Av1TileLog2(maxTileWidthSb, sbCols);
	maxLog2TileCols = Av1TileLog2(1, sbCols);
	if (maxLog2TileCols > AV1_MAX_TILE_COLS)
		maxLog2TileCols = AV1_MAX_TILE_COLS;
	maxLog2TileRows = Av1TileLog2(1, sbRows);
	minLog2Tiles    = Av1TileLog2(maxTileAreaSb, sbRows * sbCols);
	if (minLog2Tiles < minLog2TileCols)
		minLog2Tiles = minLog2TileCols;

	f->uniform_tile_spacing = ToBool(Av1F(b, 1));
	if (f->uniform_tile_spacing)
	{
		f->tile_cols_log2 = minLog2TileCols;
		while (f->tile_cols_log2 < maxLog2TileCols)
		{
			if (!Av1F(b, 1))				//increment_tile_cols_log2
				break;
			f->tile_cols_log2++;
		}
		tileWidthSb = (sbCols + (1 << f->tile_cols_log2) - 1) >>
					  f->tile_cols_log2;
		i = 0;
		startSb = 0;
		while (startSb < sbCols)
		{
			f->mi_col_starts[i] = startSb << sbShift;
			i++;
			startSb += tileWidthSb;
		}
		f->mi_col_starts[i] = f->mi_cols;
		f->tile_cols        = i;

		minLog2TileRows = minLog2Tiles - f->tile_cols_log2;
		if (minLog2TileRows < 0)
			minLog2TileRows = 0;
		f->tile_rows_log2 = minLog2TileRows;
		while (f->tile_rows_log2 < maxLog2TileRows)
		{
			if (!Av1F(b, 1))				//increment_tile_rows_log2
				break;
			f->tile_rows_log2++;
		}
		tileHeightSb = (sbRows + (1 << f->tile_rows_log2) - 1) >>
					   f->tile_rows_log2;
		i = 0;
		startSb = 0;
		while (startSb < sbRows)
		{
			f->mi_row_starts[i] = startSb << sbShift;
			i++;
			startSb += tileHeightSb;
		}
		f->mi_row_starts[i] = f->mi_rows;
		f->tile_rows        = i;
	}
	else
	{
		widestTileSb = 0;
		startSb      = 0;
		i            = 0;
		while (startSb < sbCols)
		{
			f->mi_col_starts[i] = startSb << sbShift;
			maxWidth            = sbCols - startSb;
			if (maxWidth > maxTileWidthSb)
				maxWidth = maxTileWidthSb;
			sizeSb  = Av1Ns(b, maxWidth) + 1;
			if (sizeSb > widestTileSb)
				widestTileSb = sizeSb;
			startSb += sizeSb;
			i++;
			if (i >= AV1_MAX_TILE_COLS)
				break;
		}
		f->mi_col_starts[i] = f->mi_cols;
		f->tile_cols        = i;
		f->tile_cols_log2   = Av1TileLog2(1, f->tile_cols);

		if (minLog2Tiles > 0)
			maxTileAreaSb = (sbRows * sbCols) >> (minLog2Tiles + 1);
		else
			maxTileAreaSb = sbRows * sbCols;
		maxTileHeightSb = maxTileAreaSb / widestTileSb;
		if (maxTileHeightSb < 1)
			maxTileHeightSb = 1;
		startSb = 0;
		i       = 0;
		while (startSb < sbRows)
		{
			f->mi_row_starts[i] = startSb << sbShift;
			maxHeight           = sbRows - startSb;
			if (maxHeight > maxTileHeightSb)
				maxHeight = maxTileHeightSb;
			sizeSb   = Av1Ns(b, maxHeight) + 1;
			startSb += sizeSb;
			i++;
			if (i >= AV1_MAX_TILE_ROWS)
				break;
		}
		f->mi_row_starts[i] = f->mi_rows;
		f->tile_rows        = i;
		f->tile_rows_log2   = Av1TileLog2(1, f->tile_rows);
	}
	f->context_update_tile_id = 0;
	f->tile_size_bytes        = 4;
	if (f->tile_cols_log2 > 0 || f->tile_rows_log2 > 0)
	{
		f->context_update_tile_id =
			Av1F(b, f->tile_rows_log2 + f->tile_cols_log2);
		f->tile_size_bytes = Av1F(b, 2) + 1;
	}
}

U0 Av1QuantizationParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.12.
	Bool diff_uv_delta = FALSE;

	f->base_q_idx   = Av1F(b, 8);
	f->delta_q_y_dc = Av1ReadDeltaQ(b);
	f->delta_q_u_dc = 0;
	f->delta_q_u_ac = 0;
	f->delta_q_v_dc = 0;
	f->delta_q_v_ac = 0;
	if (s->num_planes > 1)
	{
		if (s->separate_uv_delta_q)
			diff_uv_delta = ToBool(Av1F(b, 1));
		f->delta_q_u_dc = Av1ReadDeltaQ(b);
		f->delta_q_u_ac = Av1ReadDeltaQ(b);
		if (diff_uv_delta)
		{
			f->delta_q_v_dc = Av1ReadDeltaQ(b);
			f->delta_q_v_ac = Av1ReadDeltaQ(b);
		}
		else
		{
			f->delta_q_v_dc = f->delta_q_u_dc;
			f->delta_q_v_ac = f->delta_q_u_ac;
		}
	}
	f->using_qmatrix = ToBool(Av1F(b, 1));
	if (f->using_qmatrix)
	{
		f->qm_y = Av1F(b, 4);
		f->qm_u = Av1F(b, 4);
		f->qm_v = f->qm_u;
		if (s->separate_uv_delta_q)
			f->qm_v = Av1F(b, 4);
	}
}

U0 Av1SegmentationParams(CAv1Bits *b, CAv1Frame *f)
{//5.9.14.
	I64		i, j, k, bits, limit, value, clipped;
	Bool	update_data;

	f->segmentation_enabled = ToBool(Av1F(b, 1));
	if (f->segmentation_enabled)
	{
		update_data = TRUE;
		if (f->primary_ref_frame == AV1_PRIMARY_REF_NONE)
		{
			f->segmentation_update_map      = TRUE;
			f->segmentation_temporal_update = FALSE;
		}
		else
		{
			f->segmentation_update_map = ToBool(Av1F(b, 1));
			if (f->segmentation_update_map)
				f->segmentation_temporal_update = ToBool(Av1F(b, 1));
			update_data = ToBool(Av1F(b, 1));
		}
		if (update_data)
			for (i = 0; i < AV1_MAX_SEGMENTS; i++)
				for (j = 0; j < AV1_SEG_LVL_MAX; j++)
				{
					k       = i * AV1_SEG_LVL_MAX + j;
					value   = 0;
					clipped = 0;
					f->feature_enabled[k] = Av1F(b, 1);
					if (f->feature_enabled[k])
					{
						bits  = av1_seg_feature_bits[j];
						limit = av1_seg_feature_max[j];
						if (av1_seg_feature_signed[j])
						{
							value   = Av1Su(b, 1 + bits);
							clipped = Av1Clip3(-limit, limit, value);
						}
						else
						{
							value   = Av1F(b, bits);
							clipped = Av1Clip3(0, limit, value);
						}
					}
					f->feature_data[k] = clipped;
				}
	}
	f->seg_id_pre_skip    = FALSE;
	f->last_active_seg_id = 0;
	for (i = 0; i < AV1_MAX_SEGMENTS; i++)
		for (j = 0; j < AV1_SEG_LVL_MAX; j++)
			if (f->feature_enabled[i * AV1_SEG_LVL_MAX + j])
			{
				f->last_active_seg_id = i;
				if (j >= AV1_SEG_LVL_REF_FRAME)
					f->seg_id_pre_skip = TRUE;
			}
}

U0 Av1DeltaQParams(CAv1Bits *b, CAv1Frame *f)
{//5.9.17.
	f->delta_q_res     = 0;
	f->delta_q_present = FALSE;
	if (f->base_q_idx > 0)
		f->delta_q_present = ToBool(Av1F(b, 1));
	if (f->delta_q_present)
		f->delta_q_res = Av1F(b, 2);
}

U0 Av1DeltaLfParams(CAv1Bits *b, CAv1Frame *f)
{//5.9.18.
	f->delta_lf_present = FALSE;
	f->delta_lf_res     = 0;
	f->delta_lf_multi   = FALSE;
	if (!f->delta_q_present)
		return;
	if (!f->allow_intrabc)
		f->delta_lf_present = ToBool(Av1F(b, 1));
	if (f->delta_lf_present)
	{
		f->delta_lf_res   = Av1F(b, 2);
		f->delta_lf_multi = ToBool(Av1F(b, 1));
	}
}

U0 Av1LoopFilterParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.11.
	I64 i;

	if (f->coded_lossless || f->allow_intrabc)
	{
		f->loop_filter_level[0] = 0;
		f->loop_filter_level[1] = 0;
		f->loop_filter_ref_deltas[0] = 1;
		f->loop_filter_ref_deltas[1] = 0;
		f->loop_filter_ref_deltas[2] = 0;
		f->loop_filter_ref_deltas[3] = 0;
		f->loop_filter_ref_deltas[4] = -1;
		f->loop_filter_ref_deltas[5] = 0;
		f->loop_filter_ref_deltas[6] = -1;
		f->loop_filter_ref_deltas[7] = -1;
		f->loop_filter_mode_deltas[0] = 0;
		f->loop_filter_mode_deltas[1] = 0;

		return;
	}
	f->loop_filter_level[0] = Av1F(b, 6);
	f->loop_filter_level[1] = Av1F(b, 6);
	if (s->num_planes > 1)
		if (f->loop_filter_level[0] || f->loop_filter_level[1])
		{
			f->loop_filter_level[2] = Av1F(b, 6);
			f->loop_filter_level[3] = Av1F(b, 6);
		}
	f->loop_filter_sharpness     = Av1F(b, 3);
	f->loop_filter_delta_enabled = ToBool(Av1F(b, 1));
	if (!f->loop_filter_delta_enabled)
		return;
	if (!Av1F(b, 1))					//loop_filter_delta_update
		return;
	for (i = 0; i < AV1_TOTAL_REFS_PER_FRAME; i++)
		if (Av1F(b, 1))					//update_ref_delta
			f->loop_filter_ref_deltas[i] = Av1Su(b, 7);
	for (i = 0; i < 2; i++)
		if (Av1F(b, 1))					//update_mode_delta
			f->loop_filter_mode_deltas[i] = Av1Su(b, 7);
}

U0 Av1CdefParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.19.
	I64 i, n;

	if (f->coded_lossless || f->allow_intrabc || !s->enable_cdef)
	{
		f->cdef_bits     = 0;
		f->cdef_y_pri[0] = 0;
		f->cdef_y_sec[0] = 0;
		f->cdef_uv_pri[0] = 0;
		f->cdef_uv_sec[0] = 0;
		f->cdef_damping  = 3;

		return;
	}
	f->cdef_damping = Av1F(b, 2) + 3;
	f->cdef_bits    = Av1F(b, 2);
	n = 1 << f->cdef_bits;
	for (i = 0; i < n; i++)
	{
		f->cdef_y_pri[i] = Av1F(b, 4);
		f->cdef_y_sec[i] = Av1F(b, 2);
		//The coded 3 means 4: strength 3 is not representable in two bits.
		if (f->cdef_y_sec[i] == 3)
			f->cdef_y_sec[i]++;
		if (s->num_planes > 1)
		{
			f->cdef_uv_pri[i] = Av1F(b, 4);
			f->cdef_uv_sec[i] = Av1F(b, 2);
			if (f->cdef_uv_sec[i] == 3)
				f->cdef_uv_sec[i]++;
		}
	}
}

U0 Av1LrParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.20.
	I64		i, lr_type, shift, uv_shift;
	Bool	uses_chroma_lr = FALSE;

	f->uses_lr = FALSE;
	if (f->all_lossless || f->allow_intrabc || !s->enable_restoration)
	{
		f->frame_restoration_type[0] = AV1_RESTORE_NONE;
		f->frame_restoration_type[1] = AV1_RESTORE_NONE;
		f->frame_restoration_type[2] = AV1_RESTORE_NONE;

		return;
	}
	for (i = 0; i < s->num_planes; i++)
	{
		lr_type       = Av1F(b, 2);
		f->lr_type[i] = lr_type;
		f->frame_restoration_type[i] = av1_remap_lr_type[lr_type];
		if (f->frame_restoration_type[i] != AV1_RESTORE_NONE)
		{
			f->uses_lr = TRUE;
			if (i > 0)
				uses_chroma_lr = TRUE;
		}
	}
	if (!f->uses_lr)
		return;
	if (s->use_128x128_superblock)
		shift = Av1F(b, 1) + 1;
	else
	{
		shift = Av1F(b, 1);
		if (shift)
			shift += Av1F(b, 1);
	}
	f->loop_restoration_size[0] = AV1_RESTORATION_TILESIZE_MAX >> (2 - shift);
	uv_shift = 0;
	if (s->subsampling_x && s->subsampling_y && uses_chroma_lr)
		uv_shift = Av1F(b, 1);
	f->loop_restoration_size[1] = f->loop_restoration_size[0] >> uv_shift;
	f->loop_restoration_size[2] = f->loop_restoration_size[0] >> uv_shift;
}

U0 Av1ReadTxMode(CAv1Bits *b, CAv1Frame *f)
{//5.9.21.
	if (f->coded_lossless)
	{
		f->tx_mode = AV1_ONLY_4X4;

		return;
	}
	f->tx_mode = AV1_TX_MODE_LARGEST;
	if (Av1F(b, 1))
		f->tx_mode = AV1_TX_MODE_SELECT;
}

I64 Av1GetQIndex(CAv1Frame *f, I64 segmentId)
{//7.12.2 with ignoreDeltaQ set: segment feature 0 is SEG_LVL_ALT_Q.
	I64 data, qindex;

	if (f->segmentation_enabled &&
		f->feature_enabled[segmentId * AV1_SEG_LVL_MAX])
	{
		data   = f->feature_data[segmentId * AV1_SEG_LVL_MAX];
		qindex = f->base_q_idx + data;

		return Av1Clip3(0, 255, qindex);
	}

	return f->base_q_idx;
}

U0 Av1LosslessArray(CAv1Frame *f)
{//5.9.2: CodedLossless holds only when every segment is lossless and no
//quantiser delta can move it.
	I64 i, qindex;

	f->coded_lossless = TRUE;
	for (i = 0; i < AV1_MAX_SEGMENTS; i++)
	{
		qindex        = Av1GetQIndex(f, i);
		f->lossless[i] = ToI64(!qindex && !f->delta_q_y_dc &&
							   !f->delta_q_u_ac && !f->delta_q_u_dc &&
							   !f->delta_q_v_ac && !f->delta_q_v_dc);
		if (!f->lossless[i])
			f->coded_lossless = FALSE;
	}
	f->all_lossless = ToBool(f->coded_lossless &&
							 f->frame_width == f->upscaled_width);
}

U0 Av1FilmGrainParams(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.30. Parsed for its bits only: synthesis is not implemented, and the
//parameters sit at the end of the header, so skipping the read is safe only
//when the whole element is absent.
	I64		i, num_y = 0, num_cb = 0, num_cr = 0, lag, pos_luma, pos_chroma;
	Bool	chroma_from_luma = FALSE;

	if (!s->film_grain_params_present || !f->show_frame && !f->showable_frame)
		return;
	if (!Av1F(b, 1))					//apply_grain
		return;
	Av1F(b, 16);						//grain_seed
	//update_grain is only coded on an inter frame; an intra frame always
	//carries its own parameters.
	num_y = Av1F(b, 4);
	for (i = 0; i < num_y; i++)
	{
		Av1F(b, 8);
		Av1F(b, 8);
	}
	if (!s->mono_chrome)
		chroma_from_luma = ToBool(Av1F(b, 1));
	if (s->mono_chrome || chroma_from_luma ||
		s->subsampling_x == 1 && s->subsampling_y == 1 && !num_y)
	{
		num_cb = 0;
		num_cr = 0;
	}
	else
	{
		num_cb = Av1F(b, 4);
		for (i = 0; i < num_cb; i++)
		{
			Av1F(b, 8);
			Av1F(b, 8);
		}
		num_cr = Av1F(b, 4);
		for (i = 0; i < num_cr; i++)
		{
			Av1F(b, 8);
			Av1F(b, 8);
		}
	}
	Av1F(b, 2);							//grain_scaling_minus_8
	lag        = Av1F(b, 2);
	pos_luma   = 2 * lag * (lag + 1);
	pos_chroma = pos_luma;
	if (num_y)
	{
		pos_chroma = pos_luma + 1;
		for (i = 0; i < pos_luma; i++)
			Av1F(b, 8);
	}
	if (chroma_from_luma || num_cb)
		for (i = 0; i < pos_chroma; i++)
			Av1F(b, 8);
	if (chroma_from_luma || num_cr)
		for (i = 0; i < pos_chroma; i++)
			Av1F(b, 8);
	Av1F(b, 2);							//ar_coeff_shift_minus_6
	Av1F(b, 2);							//grain_scale_shift
	if (num_cb)
	{
		Av1F(b, 8);
		Av1F(b, 8);
		Av1F(b, 9);
	}
	if (num_cr)
	{
		Av1F(b, 8);
		Av1F(b, 8);
		Av1F(b, 9);
	}
	Av1F(b, 1);							//overlap_flag
	Av1F(b, 1);							//clip_to_restricted_range
}

I64 Av1UncompressedHeader(CAv1Bits *b, CAv1Seq *s, CAv1Frame *f)
{//5.9.2, intra path only. Returns 0 on success, negative to refuse.
	I64		i, id_len = 0, all_frames = (1 << AV1_NUM_REF_FRAMES) - 1;
	Bool	buffer_removal_time_present;

	MemSet(f, 0, sizeof(CAv1Frame));
	if (s->frame_id_numbers_present)
		id_len = s->additional_frame_id_length + s->delta_frame_id_length;
	if (s->reduced_still_picture_header)
	{
		f->frame_type     = AV1_KEY_FRAME;
		f->frame_is_intra = TRUE;
		f->show_frame     = TRUE;
	}
	else
	{
		if (Av1F(b, 1))
			return -1;					//show_existing_frame is not handled
		f->frame_type     = Av1F(b, 2);
		f->frame_is_intra = ToBool(f->frame_type == AV1_INTRA_ONLY_FRAME ||
								   f->frame_type == AV1_KEY_FRAME);
		f->show_frame     = ToBool(Av1F(b, 1));
		if (f->show_frame && s->decoder_model_info_present &&
			!s->equal_picture_interval)
			Av1F(b, s->frame_presentation_time_length);
		if (f->show_frame)
			f->showable_frame = ToBool(f->frame_type != AV1_KEY_FRAME);
		else
			f->showable_frame = ToBool(Av1F(b, 1));
		if (f->frame_type == AV1_SWITCH_FRAME ||
			f->frame_type == AV1_KEY_FRAME && f->show_frame)
			f->error_resilient = TRUE;
		else
			f->error_resilient = ToBool(Av1F(b, 1));
	}
	if (!f->frame_is_intra)
		return -2;						//inter prediction is not implemented
	f->disable_cdf_update = ToBool(Av1F(b, 1));
	if (s->force_screen_content_tools == AV1_SELECT_SCREEN_CONTENT_TOOLS)
		f->allow_screen_content_tools = ToBool(Av1F(b, 1));
	else
		f->allow_screen_content_tools = ToBool(s->force_screen_content_tools);
	if (f->allow_screen_content_tools)
	{
		if (s->force_integer_mv == AV1_SELECT_INTEGER_MV)
			Av1F(b, 1);
	}
	f->force_integer_mv = TRUE;			//always so on an intra frame
	if (s->frame_id_numbers_present)
		Av1F(b, id_len);
	if (f->frame_type == AV1_SWITCH_FRAME)
		f->frame_size_override = TRUE;
	else if (!s->reduced_still_picture_header)
		f->frame_size_override = ToBool(Av1F(b, 1));
	f->order_hint = Av1F(b, s->order_hint_bits);
	f->primary_ref_frame = AV1_PRIMARY_REF_NONE;
	if (s->decoder_model_info_present)
	{
		buffer_removal_time_present = ToBool(Av1F(b, 1));
		if (buffer_removal_time_present)
			for (i = 0; i < s->operating_points_cnt; i++)
				if (s->decoder_model_present_for_op[i])
					Av1F(b, s->buffer_removal_time_length);
	}
	if (f->frame_type == AV1_SWITCH_FRAME ||
		f->frame_type == AV1_KEY_FRAME && f->show_frame)
		f->refresh_frame_flags = all_frames;
	else
		f->refresh_frame_flags = Av1F(b, 8);
	if (f->refresh_frame_flags != all_frames &&
		f->error_resilient && s->enable_order_hint)
		for (i = 0; i < AV1_NUM_REF_FRAMES; i++)
			Av1F(b, s->order_hint_bits);
	Av1FrameSize(b, s, f);
	Av1RenderSize(b, f);
	if (f->allow_screen_content_tools && f->upscaled_width == f->frame_width)
		f->allow_intrabc = ToBool(Av1F(b, 1));
	if (s->reduced_still_picture_header || f->disable_cdf_update)
		f->disable_frame_end_update_cdf = TRUE;
	else
		f->disable_frame_end_update_cdf = ToBool(Av1F(b, 1));
	Av1TileInfo(b, s, f);
	Av1QuantizationParams(b, s, f);
	Av1SegmentationParams(b, f);
	Av1DeltaQParams(b, f);
	Av1DeltaLfParams(b, f);
	Av1LosslessArray(f);
	Av1LoopFilterParams(b, s, f);
	Av1CdefParams(b, s, f);
	Av1LrParams(b, s, f);
	Av1ReadTxMode(b, f);
	//frame_reference_mode, skip_mode_params, allow_warped_motion and
	//global_motion_params all read nothing on an intra frame.
	f->reduced_tx_set = ToBool(Av1F(b, 1));
	Av1FilmGrainParams(b, s, f);
	if (b->eof)
		return -3;
	if (f->using_qmatrix)
		return -4;						//quantizer matrices are not carried
	if (f->superres_denom != AV1_SUPERRES_NUM)
		return -5;						//superres upscaling is not implemented
	if (f->allow_intrabc)
		return -6;						//intra block copy is not implemented

	return 0;
}

/***** multi symbol arithmetic decoder, 8.2 *****/
//Transcribed from libaom's aom_dsp/entdec.c, which is the normative form the
//spec's pseudo code describes. The window is 32 bits, as od_ec_window is
//uint32_t there; everything is masked back to 32 because ZealC arithmetic is
//64 bit.

#define AV1_EC_WINDOW			32
#define AV1_EC_PROB_SHIFT		6
#define AV1_EC_MIN_PROB			4
#define AV1_CDF_PROB_TOP		32768
#define AV1_EC_LOTS_OF_BITS		0x4000
#define AV1_WINDOW_MASK			0xFFFFFFFF

class CAv1Msac
{
	U8		*buf;
	I64		 pos, end;			//byte cursor and one past the last byte
	I64		 dif, rng, cnt;
	I64		 tell_offs;
	Bool	 allow_update;		//disable_cdf_update inverts this
};

U0 Av1MsacRefill(CAv1Msac *m)
{//od_ec_dec_refill. Past the end the window takes zero bits, and cnt is
//parked at a large value so the test is not repeated.
	I64 s = AV1_EC_WINDOW - 9 - (m->cnt + 15);

	while (s >= 0 && m->pos < m->end)
	{
		m->dif = (m->dif ^ (m->buf[m->pos] << s)) & AV1_WINDOW_MASK;
		m->cnt += 8;
		s      -= 8;
		m->pos++;
	}
	if (m->pos >= m->end)
	{
		m->tell_offs += AV1_EC_LOTS_OF_BITS - m->cnt;
		m->cnt        = AV1_EC_LOTS_OF_BITS;
	}
}

U0 Av1MsacInit(CAv1Msac *m, U8 *buf, I64 size, Bool allow_update)
{//od_ec_dec_init.
	m->buf          = buf;
	m->pos          = 0;
	m->end          = size;
	m->dif          = (1 << (AV1_EC_WINDOW - 1)) - 1;
	m->rng          = 0x8000;
	m->cnt          = -15;
	m->tell_offs    = 10 - (AV1_EC_WINDOW - 8);
	m->allow_update = allow_update;
	Av1MsacRefill(m);
}

I64 Av1MsacNorm(CAv1Msac *m, I64 dif, I64 rng, I64 ret)
{//od_ec_dec_normalize. Shifting in ones rather than zeros is what the
//(dif + 1) << d then minus one does.
	I64 d = 15 - Av1FloorLog2(rng);

	m->cnt -= d;
	m->dif  = (((dif + 1) << d) - 1) & AV1_WINDOW_MASK;
	m->rng  = rng << d;
	if (m->cnt < 0)
		Av1MsacRefill(m);

	return ret;
}

I64 Av1ReadSymbol(CAv1Msac *m, U16 *icdf, I64 nsyms)
{//od_ec_decode_cdf_q15 then update_cdf. icdf holds 32768 - cdf, and icdf
//[nsyms] is the adaptation counter rather than a probability.
	I64 c, u, v, ret = -1, r = m->rng, n = nsyms - 1;
	I64 i, rate, count;

	c = m->dif >> (AV1_EC_WINDOW - 16);
	v = r;
	while (TRUE)
	{
		u    = v;
		ret++;
		v    = ((r >> 8) * (icdf[ret] >> AV1_EC_PROB_SHIFT)) >>
			   (7 - AV1_EC_PROB_SHIFT);
		v   += AV1_EC_MIN_PROB * (n - ret);
		if (c >= v)
			break;
	}
	r = u - v;
	Av1MsacNorm(m, m->dif - (v << (AV1_EC_WINDOW - 16)), r, ret);
	if (!m->allow_update)
		return ret;
	//update_cdf: 4 + (count >> 4) + (nsyms > 3) is the spec's
	//3 + (count > 15) + (count > 31) + Min(FloorLog2(N), 2) folded down.
	count = icdf[nsyms];
	rate  = 4 + (count >> 4);
	if (nsyms > 3)
		rate++;
	for (i = 0; i < nsyms - 1; i++)
		if (i < ret)
			icdf[i] += (AV1_CDF_PROB_TOP - icdf[i]) >> rate;
		else
			icdf[i] -= icdf[i] >> rate;
	if (count < 32)
		icdf[nsyms] = count + 1;

	return ret;
}

I64 Av1ReadBoolProb(CAv1Msac *m, I64 f)
{//od_ec_decode_bool_q15, with an explicit probability and no adaptation.
	I64 v, vw, ret = 1, r = m->rng, rnew, dif = m->dif;

	v    = ((r >> 8) * (f >> AV1_EC_PROB_SHIFT)) >> (7 - AV1_EC_PROB_SHIFT);
	v   += AV1_EC_MIN_PROB;
	vw   = v << (AV1_EC_WINDOW - 16);
	rnew = v;
	if (dif >= vw)
	{
		rnew = r - v;
		dif -= vw;
		ret  = 0;
	}

	return Av1MsacNorm(m, dif, rnew, ret);
}

I64 Av1ReadBool(CAv1Msac *m)
{//L(1): one bit at even odds, which is 1 << 14 in Q15.
	return Av1ReadBoolProb(m, 1 << 14);
}

I64 Av1ReadLiteral(CAv1Msac *m, I64 n)
{//L(n), most significant bit first.
	I64 v = 0, i;

	for (i = 0; i < n; i++)
		v = v << 1 | Av1ReadBool(m);

	return v;
}

I64 Av1MsacTell(CAv1Msac *m)
{//od_ec_dec_tell: bytes drawn into the window, less the bits of it that are
//still unconsumed.
	return m->pos * 8 - m->cnt + m->tell_offs;
}

Bool Av1MsacExitOk(CAv1Msac *m, I64 size)
{//8.2.4 exit_symbol, as libaom checks it in
//check_trailing_bits_after_symbol_coder plus aom_reader_has_overflowed. The
//tile ends on a one bit followed by zeros to the end of the tile, and must
//not have been read past. A decoder fault desynchronises the arithmetic
//state, and from there this is indistinguishable from a corrupt tile, so it
//catches decoder bugs and not only damaged streams.
	I64 bits = Av1MsacTell(m), bytes, last, pattern, i;

	bytes = (bits + 7) >> 3;
	if (bytes > size)
		return FALSE;					//read past the end of the tile
	if (bytes < 1)
		return FALSE;
	last    = m->buf[bytes - 1];
	pattern = 128 >> ((bits - 1) & 7);
	if ((last & (2 * pattern - 1)) != pattern)
		return FALSE;					//no stop bit where the tile ended
	for (i = bytes; i < size; i++)
		if (m->buf[i])
			return FALSE;				//padding must be zero

	return TRUE;
}

/***** tile group, 5.11.1 *****/

class CAv1Tile
{
	I64		 num;				//tile index within the frame
	I64		 row, col;
	I64		 offset, size;		//tile data within the OBU payload
	I64		 mi_row_start, mi_row_end, mi_col_start, mi_col_end;
};

I64 Av1TileGroup(CAv1Bits *b, CAv1Frame *f, U8 *buf, I64 sz,
				 CAv1Tile *out, I64 max_out)
{//5.11.1. Splits one tile group OBU into its tiles without decoding them.
//Returns the number found, or negative when the sizes do not tile the OBU.
	I64		start_bit = b->pos, header_bytes, idx, k;
	I64		num_tiles = f->tile_cols * f->tile_rows;
	I64		tg_start = 0, tg_end = num_tiles - 1, tile_bits;
	I64		i, tile_size, pos;
	Bool	present = FALSE, last;

	if (num_tiles < 1)
		return -1;
	if (num_tiles > 1)
		present = ToBool(Av1F(b, 1));
	if (num_tiles > 1 && present)
	{
		tile_bits = f->tile_cols_log2 + f->tile_rows_log2;
		tg_start  = Av1F(b, tile_bits);
		tg_end    = Av1F(b, tile_bits);
	}
	Av1ByteAlign(b);
	header_bytes = (b->pos - start_bit) >> 3;
	pos          = header_bytes;
	sz          -= header_bytes;
	if (tg_start < 0 || tg_end >= num_tiles || tg_start > tg_end)
		return -2;
	for (i = tg_start; i <= tg_end; i++)
	{
		last = ToBool(i == tg_end);
		if (last)
			tile_size = sz;
		else
		{
			if (sz < f->tile_size_bytes)
				return -3;
			//le(TileSizeBytes) is byte aligned and little endian.
			tile_size = 0;
			for (k = 0; k < f->tile_size_bytes; k++)
				tile_size |= buf[pos + k] << (k * 8);
			tile_size++;
			pos += f->tile_size_bytes;
			sz  -= f->tile_size_bytes;
		}
		if (tile_size < 1 || tile_size > sz)
			return -4;
		idx = i - tg_start;
		if (idx >= max_out)
			return -5;
		out[idx].num    = i;
		out[idx].row    = i / f->tile_cols;
		out[idx].col    = i % f->tile_cols;
		out[idx].offset = pos;
		out[idx].size   = tile_size;
		out[idx].mi_row_start = f->mi_row_starts[out[idx].row];
		out[idx].mi_row_end   = f->mi_row_starts[out[idx].row + 1];
		out[idx].mi_col_start = f->mi_col_starts[out[idx].col];
		out[idx].mi_col_end   = f->mi_col_starts[out[idx].col + 1];
		pos += tile_size;
		sz  -= tile_size;
	}
	if (sz)
		return -6;						//the tiles do not fill the OBU

	return tg_end - tg_start + 1;
}

/***** container entry *****/

public Bool Av1ParseConfig(CAv1Seq *s, U8 *cfg, I64 size)
{//av1C, the AV1 Codec Configuration Record an MP4 av01 sample entry carries.
//Four bytes of fixed fields, then configOBUs, which hold the sequence header.
	CAv1Obu	o;
	I64		pos = 4, next;

	if (!cfg || size < 4)
		return FALSE;
	if (!(cfg[0] & 0x80))
		return FALSE;					//marker
	if ((cfg[0] & 0x7F) != 1)
		return FALSE;					//version
	while (pos < size)
	{
		if (!Av1ObuAt(&o, cfg, size, pos, &next))
			return FALSE;
		if (o.type == AV1_OBU_SEQUENCE_HEADER)
			return Av1ParseSeqHeader(s, cfg + o.offset, o.size);
		pos = next;
	}

	return FALSE;
}

/***** CDF context, 8.4 *****/

class CAv1Cdf
{//One live copy of every default table, adapted in place. A tile takes its
//own copy at init_symbol and the frame keeps the one from
//context_update_tile_id, 7.4.
	U16	*c;
};

Bool Av1CdfOpen(CAv1Cdf *f)
{
	f->c = CAlloc(AV1_CDF_TOTAL * sizeof(U16));

	return ToBool(f->c != NULL);
}

U0 Av1CdfClose(CAv1Cdf *f)
{
	if (!f)
		return;
	Free(f->c);
	f->c = NULL;
}

U0 Av1CdfReset(CAv1Cdf *f)
{//5.9.2: a key frame has PRIMARY_REF_NONE, so every context starts from the
//defaults and load_cdfs never runs.
	Av1CdfInit(f->c);
}

U0 Av1CdfCopy(CAv1Cdf *dst, CAv1Cdf *src)
{
	MemCopy(dst->c, src->c, AV1_CDF_TOTAL * sizeof(U16));
}
