//H.264 / AVC (ITU-T H.264). Parameter sets and slice headers; no decoding yet.
//
//MP4 carries NAL units length-prefixed, with the sequence and picture
//parameter sets in the avcC record rather than in band. Annex B start codes
//are what Matroska and raw streams use instead.

#define H264_NAL_SLICE		1
#define H264_NAL_IDR		5
#define H264_NAL_SEI		6
#define H264_NAL_SPS		7
#define H264_NAL_PPS		8
#define H264_NAL_AUD		9

//Slice types, both the plain and the "all slices in this picture" forms.
#define H264_SLICE_P		0
#define H264_SLICE_B		1
#define H264_SLICE_I		2
#define H264_SLICE_SP		3
#define H264_SLICE_SI		4

class CH264Bits
{//RBSP bit reader. The buffer has already had emulation prevention removed.
	U8		*buf;
	I64		 pos, end;		//bit position, bit count
	Bool	 eof;
};

class CH264SPS
{
	Bool	 valid;
	I64		 id, profile, level, constraint;
	I64		 chroma_format;
	Bool	 separate_colour;
	I64		 bit_depth_luma, bit_depth_chroma;
	Bool	 scaling_matrix;
	I64		 log2_max_frame_num;
	I64		 poc_type, log2_max_poc_lsb;
	Bool	 delta_pic_order_always_zero;
	I64		 offset_for_non_ref_pic, offset_for_top_to_bottom;
	I64		 poc_cycle_len;
	I64		 max_ref_frames;
	Bool	 gaps_allowed;
	I64		 mb_width, mb_height;		//macroblocks
	Bool	 frame_mbs_only, mb_adaptive, direct_8x8;
	Bool	 cropping;
	I64		 crop_left, crop_right, crop_top, crop_bottom;
	I64		 width, height;				//cropped, in pixels
	Bool	 vui;
};

class CH264PPS
{
	Bool	 valid;
	I64		 id, sps_id;
	Bool	 cabac, bottom_field_order;
	I64		 slice_groups;
	I64		 ref_idx_l0, ref_idx_l1;
	Bool	 weighted_pred;
	I64		 weighted_bipred;
	I64		 init_qp, init_qs, chroma_qp_off, chroma_qp_off2;
	Bool	 deblock_control, constrained_intra, redundant_pic_cnt;
	Bool	 transform_8x8;
};

class CH264Slice
{
	I64		 nal_type, nal_ref_idc;
	I64		 first_mb, type, pps_id, frame_num;
	Bool	 field_pic, bottom_field;
	I64		 idr_pic_id, poc_lsb, delta_poc_bottom;
	I64		 ref_count[2], cabac_init;
	I64		 qp, disable_deblock, alpha_off, beta_off;
	//ref_pic_list_modification, list 0: op 0 subtracts, op 1 adds.
	I64		 reorder_count, reorder_op[16], reorder_arg[16];
	Bool	 direct_spatial;
	Bool	 long_term;			//an op or a marking this decoder refuses
	Bool	 mmco_forget, mmco_reset, mmco_adaptive;
	//dec_ref_pic_marking commands. Only op 1 is kept: it names a short term
	//picture by PicNum and releases it.
	I64		 mmco_count, mmco_arg[16];
	I64		 header_bits;		//where the slice data begins
};

#define H264_SPS_MAX	8
#define H264_PPS_MAX	32

class CH264Ctx
{//Real streams number their parameter sets from zero; ids past these are
//refused rather than sized for.
	CH264SPS	 sps[H264_SPS_MAX];
	CH264PPS	 pps[H264_PPS_MAX];
	I64			 nal_len_size;		//1, 2 or 4, from avcC
	U8			*rbsp;				//scratch for the unescaped payload
	I64			 rbsp_cap;
};

/***** bit reader *****/

U0 H264BitsInit(CH264Bits *b, U8 *buf, I64 size)
{
	b->buf = buf;
	b->pos = 0;
	b->end = size * 8;
	b->eof = FALSE;
}

I64 H264Read(CH264Bits *b, I64 n)
{
	I64 v = 0, byte, shift;

	while (n)
	{
		if (b->pos >= b->end)
		{
			b->eof = TRUE;
			return v;
		}
		byte  = b->pos >> 3;
		shift = 7 - (b->pos & 7);
		v = v << 1 | (b->buf[byte] >> shift) & 1;
		b->pos++;
		n--;
	}

	return v;
}

I64 H264ReadUE(CH264Bits *b)
{//Exp-Golomb: leading zeros give the length of the value that follows.
	I64 zeros = 0;

	while (!H264Read(b, 1))
	{
		zeros++;
		if (zeros > 32 || b->eof)
		{
			b->eof = TRUE;
			return 0;
		}
	}
	if (!zeros)
		return 0;

	return (1 << zeros) - 1 + H264Read(b, zeros);
}

Bool H264MoreData(CH264Bits *b)
{//more_rbsp_data(): the stop bit is the last set bit of the payload, and only
//zero padding follows it.
	I64 i;

	for (i = b->end - 1; i >= 0; i--)
		if (b->buf[i >> 3] >> (7 - (i & 7)) & 1)
			return ToBool(b->pos < i);

	return FALSE;
}

I64 H264ReadSE(CH264Bits *b)
{//Signed Exp-Golomb: 1, -1, 2, -2 ... interleaved.
	I64 v = H264ReadUE(b);

	if (v & 1)
		return (v + 1) >> 1;

	return -(v >> 1);
}

public I64 H264Rbsp(CH264Ctx *c, U8 *nal, I64 size)
{//Strip emulation prevention bytes: 00 00 03 xx means the 03 is not data.
	I64 i, n = 0, zeros = 0;

	if (c->rbsp_cap < size)
	{
		Free(c->rbsp);
		c->rbsp     = MAlloc(size + 16);
		c->rbsp_cap = size + 16;
	}
	for (i = 0; i < size; i++)
	{
		if (zeros >= 2 && nal[i] == 3)
			zeros = 0;
		else
		{
			if (!nal[i])
				zeros++;
			else
				zeros = 0;
			c->rbsp[n] = nal[i];
			n++;
		}
	}

	return n;
}

/***** parameter sets *****/

U0 H264ScalingList(CH264Bits *b, I64 n)
{
	I64 i, last = 8, next = 8, delta;

	for (i = 0; i < n; i++)
	{
		if (next)
		{
			delta = H264ReadSE(b);
			next  = (last + delta + 256) % 256;
		}
		if (next)
			last = next;
	}
}

U0 H264ScalingMatrix(CH264Bits *b, I64 n)
{
	I64 i, size;

	for (i = 0; i < n; i++)
		if (H264Read(b, 1))
		{
			size = 16;
			if (i >= 6)
				size = 64;
			H264ScalingList(b, size);
		}
}

Bool H264ParseSPS(CH264Ctx *c, U8 *nal, I64 size)
{
	CH264Bits	 b;
	CH264SPS	 s;
	I64			 n, i, sub_w = 1, sub_h = 1;

	MemSet(&s, 0, sizeof(CH264SPS));
	H264BitsInit(&b, nal, size);
	H264Read(&b, 8);					//NAL header, already classified
	s.profile    = H264Read(&b, 8);
	s.constraint = H264Read(&b, 8);
	s.level      = H264Read(&b, 8);
	s.id         = H264ReadUE(&b);
	if (s.id >= H264_SPS_MAX)
		return FALSE;

	s.chroma_format    = 1;
	s.bit_depth_luma   = 8;
	s.bit_depth_chroma = 8;
	if (s.profile == 100 || s.profile == 110 || s.profile == 122 ||
		s.profile == 244 || s.profile == 44  || s.profile == 83  ||
		s.profile == 86  || s.profile == 118 || s.profile == 128 ||
		s.profile == 138 || s.profile == 139 || s.profile == 134 ||
		s.profile == 135)
	{
		s.chroma_format = H264ReadUE(&b);
		if (s.chroma_format == 3)
			s.separate_colour = ToBool(H264Read(&b, 1));
		s.bit_depth_luma   = H264ReadUE(&b) + 8;
		s.bit_depth_chroma = H264ReadUE(&b) + 8;
		H264Read(&b, 1);				//qpprime_y_zero_transform_bypass_flag
		s.scaling_matrix = ToBool(H264Read(&b, 1));
		if (s.scaling_matrix)
		{
			n = 8;
			if (s.chroma_format == 3)
				n = 12;
			H264ScalingMatrix(&b, n);
		}
	}
	s.log2_max_frame_num = H264ReadUE(&b) + 4;
	s.poc_type           = H264ReadUE(&b);
	if (!s.poc_type)
		s.log2_max_poc_lsb = H264ReadUE(&b) + 4;
	else if (s.poc_type == 1)
	{
		s.delta_pic_order_always_zero = ToBool(H264Read(&b, 1));
		s.offset_for_non_ref_pic      = H264ReadSE(&b);
		s.offset_for_top_to_bottom    = H264ReadSE(&b);
		s.poc_cycle_len               = H264ReadUE(&b);
		for (i = 0; i < s.poc_cycle_len; i++)
			H264ReadSE(&b);
	}
	s.max_ref_frames = H264ReadUE(&b);
	if (s.max_ref_frames > 16)
		s.max_ref_frames = 16;		//A.3.1: the DPB never holds more.
	s.gaps_allowed   = ToBool(H264Read(&b, 1));
	s.mb_width       = H264ReadUE(&b) + 1;
	s.mb_height      = H264ReadUE(&b) + 1;
	s.frame_mbs_only = ToBool(H264Read(&b, 1));
	if (!s.frame_mbs_only)
		s.mb_adaptive = ToBool(H264Read(&b, 1));
	s.direct_8x8 = ToBool(H264Read(&b, 1));
	s.cropping   = ToBool(H264Read(&b, 1));
	if (s.cropping)
	{
		s.crop_left   = H264ReadUE(&b);
		s.crop_right  = H264ReadUE(&b);
		s.crop_top    = H264ReadUE(&b);
		s.crop_bottom = H264ReadUE(&b);
	}
	s.vui = ToBool(H264Read(&b, 1));
	if (b.eof)
		return FALSE;

	//A field-coded stream stores half a frame per map unit.
	s.height = s.mb_height * 16;
	if (!s.frame_mbs_only)
		s.height *= 2;
	s.width = s.mb_width * 16;
	if (s.chroma_format == 1)
	{
		sub_w = 2;
		sub_h = 2;
	}
	else if (s.chroma_format == 2)
		sub_w = 2;
	if (s.cropping)
	{
		s.width  -= (s.crop_left + s.crop_right) * sub_w;
		s.height -= (s.crop_top + s.crop_bottom) * sub_h;
		if (!s.frame_mbs_only)
			s.height -= (s.crop_top + s.crop_bottom) * sub_h;
	}
	s.valid = TRUE;
	MemCopy(&c->sps[s.id], &s, sizeof(CH264SPS));

	return TRUE;
}

Bool H264ParsePPS(CH264Ctx *c, U8 *nal, I64 size)
{
	CH264Bits	 b;
	CH264PPS	 p;
	CH264SPS	*sps;
	I64			 n;

	MemSet(&p, 0, sizeof(CH264PPS));
	H264BitsInit(&b, nal, size);
	H264Read(&b, 8);
	p.id     = H264ReadUE(&b);
	p.sps_id = H264ReadUE(&b);
	if (p.id >= H264_PPS_MAX || p.sps_id >= H264_SPS_MAX)
		return FALSE;
	p.cabac              = ToBool(H264Read(&b, 1));
	p.bottom_field_order = ToBool(H264Read(&b, 1));
	p.slice_groups       = H264ReadUE(&b) + 1;
	if (p.slice_groups > 1)
		return FALSE;			//Slice groups (FMO) are not supported.
	p.ref_idx_l0     = H264ReadUE(&b) + 1;
	p.ref_idx_l1     = H264ReadUE(&b) + 1;
	p.weighted_pred  = ToBool(H264Read(&b, 1));
	p.weighted_bipred = H264Read(&b, 2);
	p.init_qp        = H264ReadSE(&b) + 26;
	p.init_qs        = H264ReadSE(&b) + 26;
	p.chroma_qp_off  = H264ReadSE(&b);
	p.deblock_control    = ToBool(H264Read(&b, 1));
	p.constrained_intra  = ToBool(H264Read(&b, 1));
	p.redundant_pic_cnt  = ToBool(H264Read(&b, 1));
	//The trailing fields are present only in the longer form.
	if (H264MoreData(&b))
	{
		p.transform_8x8 = ToBool(H264Read(&b, 1));
		if (H264Read(&b, 1))
		{
			sps = &c->sps[p.sps_id];
			n = 2;
			if (p.transform_8x8)
			{
				n = 2 + 2;
				if (sps->valid && sps->chroma_format == 3)
					n = 2 + 6;
			}
			H264ScalingMatrix(&b, 6 + n);
		}
		p.chroma_qp_off2 = H264ReadSE(&b);
	}
	else
		p.chroma_qp_off2 = p.chroma_qp_off;
	if (b.eof)
		return FALSE;
	p.valid = TRUE;
	MemCopy(&c->pps[p.id], &p, sizeof(CH264PPS));

	return TRUE;
}

U0 H264RefListMod(CH264Bits *b, CH264Slice *sl, Bool keep)
{//ref_pic_list_modification(): a list of ops ended by 3.
	I64 op, arg;

	if (!H264Read(b, 1))
		return;
	while (TRUE)
	{
		op = H264ReadUE(b);
		if (op == 3 || b->eof)
			return;
		arg = H264ReadUE(b);
		if (op == 2)
			sl->long_term = TRUE;	//long term references are not kept
		if (keep && op < 2 && sl->reorder_count < 16)
		{
			sl->reorder_op[sl->reorder_count]  = op;
			sl->reorder_arg[sl->reorder_count] = arg;
			sl->reorder_count++;
		}
	}
}

U0 H264PredWeightTable(CH264Bits *b, CH264Slice *sl, CH264SPS *s)
{
	I64 i, j, chroma = 0;

	if (s->chroma_format && !s->separate_colour)
		chroma = 1;
	H264ReadUE(b);						//luma_log2_weight_denom
	if (chroma)
		H264ReadUE(b);					//chroma_log2_weight_denom
	for (j = 0; j < 2; j++)
	{
		if (j && sl->type != H264_SLICE_B)
			return;
		for (i = 0; i < sl->ref_count[j]; i++)
		{
			if (H264Read(b, 1))
			{
				H264ReadSE(b);
				H264ReadSE(b);
			}
			if (chroma && H264Read(b, 1))
			{
				H264ReadSE(b);
				H264ReadSE(b);
				H264ReadSE(b);
				H264ReadSE(b);
			}
		}
	}
}

U0 H264RefPicMarking(CH264Bits *b, CH264Slice *sl)
{//dec_ref_pic_marking(): IDRs carry two flags, others a command list.
	I64 op, arg;

	if (sl->nal_type == H264_NAL_IDR)
	{
		H264Read(b, 1);				//no_output_of_prior_pics_flag
		H264Read(b, 1);				//long_term_reference_flag
		return;
	}
	if (!H264Read(b, 1))				//adaptive_ref_pic_marking_mode_flag
		return;
	sl->mmco_adaptive = TRUE;
	while (TRUE)
	{
		op = H264ReadUE(b);
		if (!op || b->eof)
			return;
		if (op == 1 || op == 3)
		{
			arg = H264ReadUE(b);
			if (op == 1 && sl->mmco_count < 16)
			{
				sl->mmco_arg[sl->mmco_count] = arg;
				sl->mmco_count++;
			}
		}
		if (op == 2)
			H264ReadUE(b);
		if (op == 3 || op == 6)
			H264ReadUE(b);
		if (op == 4)
			H264ReadUE(b);
		//Only the sliding window and a full reset are honoured; anything that
		//names a long term picture is refused rather than decoded wrongly.
		if (op == 2 || op == 3 || op == 4 || op == 6)
			sl->long_term = TRUE;
		if (op == 1)
			sl->mmco_forget = TRUE;
		if (op == 5)
		{
			sl->mmco_reset = TRUE;
			return;
		}
	}
}

public Bool H264ParseSliceHeader(CH264Ctx *c, U8 *nal, I64 size,
							 CH264Slice *sl)
{//Enough of the header to identify the picture; the rest is decoding state.
	CH264Bits	 b;
	CH264PPS	*p;
	CH264SPS	*s;
	I64			 hdr, n0, n1;

	MemSet(sl, 0, sizeof(CH264Slice));
	H264BitsInit(&b, nal, size);
	hdr          = H264Read(&b, 8);
	sl->nal_type = hdr & 0x1F;
	sl->nal_ref_idc = (hdr >> 5) & 3;
	sl->first_mb = H264ReadUE(&b);
	sl->type     = H264ReadUE(&b);
	if (sl->type > 4)
		sl->type -= 5;			//"all slices of this type" form
	sl->pps_id = H264ReadUE(&b);
	if (sl->pps_id >= H264_PPS_MAX)
		return FALSE;
	p = &c->pps[sl->pps_id];
	if (!p->valid)
		return FALSE;
	s = &c->sps[p->sps_id];
	if (!s->valid)
		return FALSE;

	sl->frame_num = H264Read(&b, s->log2_max_frame_num);
	if (!s->frame_mbs_only)
	{
		sl->field_pic = ToBool(H264Read(&b, 1));
		if (sl->field_pic)
			sl->bottom_field = ToBool(H264Read(&b, 1));
	}
	if (sl->nal_type == H264_NAL_IDR)
		sl->idr_pic_id = H264ReadUE(&b);
	if (!s->poc_type)
	{
		sl->poc_lsb = H264Read(&b, s->log2_max_poc_lsb);
		if (p->bottom_field_order && !sl->field_pic)
			sl->delta_poc_bottom = H264ReadSE(&b);
	}
	else if (s->poc_type == 1 && !s->delta_pic_order_always_zero)
	{
		H264ReadSE(&b);
		if (p->bottom_field_order && !sl->field_pic)
			H264ReadSE(&b);
	}
	if (p->redundant_pic_cnt)
		H264ReadUE(&b);

	if (sl->type == H264_SLICE_B)
		sl->direct_spatial = ToBool(H264Read(&b, 1));
	n0 = p->ref_idx_l0;
	n1 = p->ref_idx_l1;
	if (sl->type == H264_SLICE_P || sl->type == H264_SLICE_SP ||
		sl->type == H264_SLICE_B)
		if (H264Read(&b, 1))
		{//num_ref_idx_active_override
			n0 = H264ReadUE(&b) + 1;
			if (sl->type == H264_SLICE_B)
				n1 = H264ReadUE(&b) + 1;
		}
	sl->ref_count[0] = n0;
	sl->ref_count[1] = n1;

	//Reference picture list modification, then the weight table and the
	//marking commands: all skipped, but their bits have to be walked to reach
	//the quantiser.
	if (sl->type != H264_SLICE_I && sl->type != H264_SLICE_SI)
		H264RefListMod(&b, sl, TRUE);
	if (sl->type == H264_SLICE_B)
		H264RefListMod(&b, sl, FALSE);
	if ((p->weighted_pred && (sl->type == H264_SLICE_P ||
							  sl->type == H264_SLICE_SP)) ||
		(p->weighted_bipred == 1 && sl->type == H264_SLICE_B))
		H264PredWeightTable(&b, sl, s);
	if (sl->nal_ref_idc)
		H264RefPicMarking(&b, sl);
	if (p->cabac && sl->type != H264_SLICE_I && sl->type != H264_SLICE_SI)
		sl->cabac_init = H264ReadUE(&b);
	sl->qp = p->init_qp + H264ReadSE(&b);
	if (sl->type == H264_SLICE_SP || sl->type == H264_SLICE_SI)
	{
		if (sl->type == H264_SLICE_SP)
			H264Read(&b, 1);			//sp_for_switch_flag
		H264ReadSE(&b);					//slice_qs_delta
	}
	if (p->deblock_control)
	{
		sl->disable_deblock = H264ReadUE(&b);
		if (sl->disable_deblock != 1)
		{
			sl->alpha_off = H264ReadSE(&b) * 2;
			sl->beta_off  = H264ReadSE(&b) * 2;
		}
	}
	sl->header_bits = b.pos;

	return ToBool(!b.eof);
}

/***** stream layer *****/

public CH264Ctx *H264Open()
{
	CH264Ctx *c = CAlloc(sizeof(CH264Ctx));

	c->nal_len_size = 4;

	return c;
}

public U0 H264Close(CH264Ctx *c)
{
	if (!c)
		return;
	Free(c->rbsp);
	Free(c);
}

public Bool H264ParseAvcC(CH264Ctx *c, U8 *cfg, I64 size)
{//AVCDecoderConfigurationRecord: the parameter sets live here, not in band.
	I64 i, n, len, pos = 5;

	if (!cfg || size < 7)
		return FALSE;
	c->nal_len_size = (cfg[4] & 3) + 1;
	n = cfg[pos] & 0x1F;
	pos++;
	for (i = 0; i < n && pos + 2 <= size; i++)
	{
		len = cfg[pos] << 8 | cfg[pos + 1];
		pos += 2;
		if (pos + len > size)
			return FALSE;
		H264ParseSPS(c, c->rbsp, H264Rbsp(c, cfg + pos, len));
		pos += len;
	}
	if (pos >= size)
		return FALSE;
	n = cfg[pos];
	pos++;
	for (i = 0; i < n && pos + 2 <= size; i++)
	{
		len = cfg[pos] << 8 | cfg[pos + 1];
		pos += 2;
		if (pos + len > size)
			return FALSE;
		H264ParsePPS(c, c->rbsp, H264Rbsp(c, cfg + pos, len));
		pos += len;
	}

	return TRUE;
}

public CH264SPS *H264ActiveSPS(CH264Ctx *c)
{//The first parameter set the stream defines; enough to size a frame.
	I64 i;

	for (i = 0; i < H264_SPS_MAX; i++)
		if (c->sps[i].valid)
			return &c->sps[i];

	return NULL;
}

I64 H264Peek(CH264Bits *b, I64 n)
{//Next n bits without consuming, zero padded past the end.
	I64 save = b->pos, avail = b->end - b->pos, v;
	Bool eof = b->eof;

	if (avail < 0)
		avail = 0;
	if (avail > n)
		avail = n;
	v = H264Read(b, avail) << (n - avail);
	b->pos = save;
	b->eof = eof;

	return v;
}

I64 H264MatchVLC(CH264Bits *b, U8 *len, U8 *bits, I64 n)
{
	I64 i, l, peek = H264Peek(b, 16);

	for (i = 0; i < n; i++)
	{
		l = len[i];
		if (l < 1 || l > 16)
			goto next_code;
		if (peek >> (16 - l) == bits[i])
		{
			H264Read(b, l);
			return i;
		}
next_code:;
	}

	return -1;
}

I64 H264CoeffToken(CH264Bits *b, I64 nc, I64 *_ones)
{//Returns total_coeff, with trailing ones through _ones. nc is the predicted
//count from the neighbouring blocks; -1 selects the chroma DC table.
	I64 tab, idx;

	*_ones = 0;
	if (nc < 0)
	{
		idx = H264MatchVLC(b, h264_chroma_dc_token_len,
						   h264_chroma_dc_token_bits, 20);
		if (idx < 0)
			return -1;
		*_ones = idx & 3;
		return idx >> 2;
	}
	if (nc < 2)
		tab = 0;
	else if (nc < 4)
		tab = 1;
	else if (nc < 8)
		tab = 2;
	else
		tab = 3;			//Fixed length, but the table carries it too.
	idx = H264MatchVLC(b, h264_coeff_token_len + tab * 68,
					   h264_coeff_token_bits + tab * 68, 68);
	if (idx < 0)
		return -1;
	*_ones = idx & 3;

	return idx >> 2;
}

I64 H264TotalZeros(CH264Bits *b, I64 total_coeff, Bool chroma_dc)
{
	I64 idx;

	if (chroma_dc)
	{
		idx = H264MatchVLC(b, h264_chroma_dc_zeros_len + (total_coeff - 1) * 4,
						   h264_chroma_dc_zeros_bits + (total_coeff - 1) * 4, 4);
		if (idx < 0)
			return -1;
		return idx;
	}
	idx = H264MatchVLC(b, h264_total_zeros_len + (total_coeff - 1) * 16,
					   h264_total_zeros_bits + (total_coeff - 1) * 16, 16);
	if (idx < 0)
		return -1;

	return idx;
}

I64 H264RunBefore(CH264Bits *b, I64 zeros_left)
{
	I64 idx, n = zeros_left;

	if (n > 7)
		n = 7;
	idx = H264MatchVLC(b, h264_run_len + (n - 1) * 16,
					   h264_run_bits + (n - 1) * 16, 16);
	if (idx < 0)
		return -1;

	return idx;
}

I64 H264Levels(CH264Bits *b, I64 total, I64 ones, I64 *level)
{//Level magnitudes and signs, in reverse scan order. Returns FALSE on a
//malformed prefix.
	I64 i, suffix_len = 0, prefix, sz, code, val, zeros;

	if (total > 10 && ones < 3)
		suffix_len = 1;
	for (i = 0; i < total; i++)
	{
		if (i < ones)
		{
			if (H264Read(b, 1))
				level[i] = -1;
			else
				level[i] = 1;
			goto next_level;
		}
		prefix = 0;
		while (!H264Read(b, 1))
		{
			prefix++;
			if (prefix > 32 || b->eof)
				return FALSE;
		}
		sz = suffix_len;
		if (prefix == 14 && !suffix_len)
			sz = 4;
		else if (prefix >= 15)
			sz = prefix - 3;
		code = 0;
		if (prefix < 15)
			code = prefix << suffix_len;
		else
			code = 15 << suffix_len;
		if (sz)
			code += H264Read(b, sz);
		if (prefix >= 15 && !suffix_len)
			code += 15;
		if (prefix >= 16)
			code += (1 << (prefix - 3)) - 4096;
		if (i == ones && ones < 3)
			code += 2;
		if (code & 1)
			val = -((code + 1) >> 1);
		else
			val = (code + 2) >> 1;
		level[i] = val;
		if (!suffix_len)
			suffix_len = 1;
		zeros = val;
		if (zeros < 0)
			zeros = -zeros;
		if (zeros > (3 << (suffix_len - 1)) && suffix_len < 6)
			suffix_len++;
next_level:;
	}

	return TRUE;
}

I64 H264Residual(CH264Bits *b, I64 nc, I64 max_coeff, I16 *block, U8 *scan)
{//One block into raster positions through scan[]. Returns the coefficient
//count, or -1 if the bitstream does not decode.
	I64 level[16], run[16];
	I64 total, ones, zeros_left, i, pos, r;
	Bool chroma_dc = ToBool(max_coeff == 4);

	total = H264CoeffToken(b, nc, &ones);
	if (total < 0 || total > max_coeff || ones > total)
		return -1;
	if (!total)
		return 0;
	if (!H264Levels(b, total, ones, level))
		return -1;

	zeros_left = 0;
	if (total < max_coeff)
	{
		zeros_left = H264TotalZeros(b, total, chroma_dc);
		if (zeros_left < 0)
			return -1;
	}
	for (i = 0; i < total - 1; i++)
	{
		r = 0;
		if (zeros_left > 0)
		{
			r = H264RunBefore(b, zeros_left);
			if (r < 0)
				return -1;
		}
		run[i]      = r;
		zeros_left -= r;
	}
	run[total - 1] = zeros_left;

	//Levels arrive highest frequency first; walk back down the scan.
	pos = total - 1;
	for (i = 0; i < total; i++)
		pos += run[i];
	for (i = 0; i < total; i++)
	{
		if (pos < 0 || pos >= max_coeff)
			return -1;
		block[scan[pos]] = level[i];
		pos -= run[i] + 1;
	}

	return total;
}

/***** CABAC *****/

#define H264_CABAC_CTXS	1024

class CH264Cabac
{//Arithmetic decoder of 9.3.3.2, one context state per index.
	U8	*buf;
	I64	 pos, end;			//bit position of the next renormalisation bit
	I64	 range, offset;
	U8	 state[H264_CABAC_CTXS];
	U8	 mps[H264_CABAC_CTXS];
};

I64 H264CabacBit1(CH264Cabac *c)
{
	I64 b;

	if (c->pos >= c->end)
		return 0;
	b = c->buf[c->pos >> 3] >> (7 - (c->pos & 7)) & 1;
	c->pos++;

	return b;
}

U0 H264CabacEngine(CH264Cabac *c, I64 bit_pos)
{//9.3.1.2. Context states are left alone: I_PCM restarts the engine only.
	I64 i;

	c->pos    = (bit_pos + 7) & -8;
	c->range  = 510;
	c->offset = 0;
	for (i = 0; i < 9; i++)
		c->offset = c->offset << 1 | H264CabacBit1(c);
}

U0 H264CabacStart(CH264Cabac *c, U8 *buf, I64 size, I64 bit_pos, I64 qp,
				  Bool p_slice, I64 init_idc)
{//bit_pos is where the slice data begins; cabac_alignment_one_bit rounds it up
//to a byte boundary.
	I64 i, m, n, pre, off = 0;

	c->buf = buf;
	c->end = size * 8;
	if (qp < 0)
		qp = 0;
	if (qp > 51)
		qp = 51;
	if (init_idc > 2)
		init_idc = 2;
	if (init_idc < 0)
		init_idc = 0;
	off = init_idc * H264_CABAC_CTXS * 2;
	for (i = 0; i < H264_CABAC_CTXS; i++)
	{
		m = h264_cabac_init_i[i * 2];
		n = h264_cabac_init_i[i * 2 + 1];
		if (p_slice)
		{
			m = h264_cabac_init_pb[off + i * 2];
			n = h264_cabac_init_pb[off + i * 2 + 1];
		}
		pre = ((m * qp) >> 4) + n;
		if (pre < 1)
			pre = 1;
		if (pre > 126)
			pre = 126;
		if (pre <= 63)
		{
			c->state[i] = 63 - pre;
			c->mps[i]   = 0;
		}
		else
		{
			c->state[i] = pre - 64;
			c->mps[i]   = 1;
		}
	}
	H264CabacEngine(c, bit_pos);
}

U0 H264CabacRenorm(CH264Cabac *c)
{
	while (c->range < 256)
	{
		c->range  <<= 1;
		c->offset   = c->offset << 1 | H264CabacBit1(c);
	}
}

I64 H264CabacDec(CH264Cabac *c, I64 ctx)
{//DecodeDecision.
	I64 s = c->state[ctx], lps, bin;

	lps = h264_cabac_range_lps[s * 4 + ((c->range >> 6) & 3)];
	c->range -= lps;
	if (c->offset >= c->range)
	{
		bin         = 1 - c->mps[ctx];
		c->offset  -= c->range;
		c->range    = lps;
		if (!s)
			c->mps[ctx] = 1 - c->mps[ctx];
		c->state[ctx] = h264_cabac_trans_lps[s];
	}
	else
	{
		bin           = c->mps[ctx];
		c->state[ctx] = h264_cabac_trans_mps[s];
	}
	H264CabacRenorm(c);

	return bin;
}

I64 H264CabacBypass(CH264Cabac *c)
{
	c->offset = c->offset << 1 | H264CabacBit1(c);
	if (c->offset >= c->range)
	{
		c->offset -= c->range;
		return 1;
	}

	return 0;
}

I64 H264CabacTerm(CH264Cabac *c)
{//Non zero at the end of a slice, or on an I_PCM macroblock.
	c->range -= 2;
	if (c->offset >= c->range)
		return 1;
	H264CabacRenorm(c);

	return 0;
}

/***** macroblock layer, I slices *****/

//16 luma DC, 16 luma AC blocks, 8 chroma DC, 8 chroma AC blocks.
#define H264_BLK_COEFFS	(16 + 256 + 8 + 128)

#define H264_MB_NONE	0
#define H264_MB_I4X4	1
#define H264_MB_I16X16	2
#define H264_MB_IPCM	3
#define H264_MB_INTER	4
#define H264_MB_SKIP	5
#define H264_MB_DIRECT	6	//B_Direct_16x16

#define H264_REFS_MAX	24
//Deepest reorder the player will hold. Every held picture costs a frame
//buffer and a frame of seek latency; no B pyramid in the wild nests past 4.
#define H264_PLAY_REORDER_MAX	8

class CH264Frame
{
	U8		*pic[3];
	I64		 stride[3];
	//Two prediction lists: a B partition can reference both. List 1 stays
	//empty on I and P pictures, and a colocated lookup reads both.
	I16		*mvx, *mvy, *mvx1, *mvy1;
	I8		*refidx, *refidx1;
	I64		 frame_num, poc;
	//Picture order counts of the lists this picture was decoded with, indexed
	//list * H264_REFS_MAX + i. Temporal direct names a picture through the
	//colocated picture's list and has to find it in this slice's list 0.
	I64		 ref_poc[2 * H264_REFS_MAX], ref_pcount[2];
	//epoch counts IDRs, because picture order count restarts at one and the
	//output queue orders by (epoch, poc).
	I64		 epoch;
	Bool	 used;			//held as a reference
	Bool	 held;			//queued for display
};

class CH264Dec
{
	CH264Ctx	*ctx;
	CH264SPS	*sps;
	CH264PPS	*pps;
	CH264Slice	 sl;
	CH264Bits	 b;
	I64			 mb_w, mb_h, mb_x, mb_y;
	I64			 qp, slice_id;
	//Per 4x4 block across the picture: coefficient counts feed the next
	//block's nC, intra modes feed the next block's mode prediction.
	U8			*nnz, *nnz_c[2], *modes;
	U8			*mb_slice;			//which slice owns each macroblock
	U8			*mb_qp;				//quantiser, for the loop filter
	//CABAC neighbour context. mb_kind is 0 outside a slice, then I4x4, I16x16
	//or I_PCM; mb_cbp packs coded block flags the way ffmpeg's cbp_table does:
	//bits 0-3 luma 8x8, 4-5 chroma pattern, 6-7 chroma DC, 8 luma DC.
	U8			*mb_kind, *mb_cmode, *mb_tx8;
	U16			*mb_cbp;
	CH264Cabac	 cabac;
	I64			 last_qp_delta;
	U8			*mb_deblock;		//disable_deblocking_filter_idc
	U8			*blk_direct;		//per 4x4: predicted by direct mode
	I8			*mb_a, *mb_b;		//slice alpha and beta offsets
	I64			 i16_mode, chroma_mode, cbp;
	Bool		 tx8x8;
	I16			 blk[H264_BLK_COEFFS];
	I64			 mbs;
	U8			*pic[3];			//the current picture's planes
	I64			 stride[3];
	CH264Frame	 frame[H264_REFS_MAX];
	CH264Frame	*cur;
	CH264Frame	*ref0[H264_REFS_MAX];	//list 0 for this slice
	I64			 ref0_count;
	I64			 poc, poc_msb, poc_lsb_prev, frame_num_prev;
	CH264Frame	*ref1[H264_REFS_MAX];
	I64			 ref1_count;
	//Motion state, one entry per 4x4 block of the picture. Aliases the
	//current frame's arrays; _1 is prediction list 1.
	I16			*mvx, *mvy, *mvx1, *mvy1;	//quarter pel
	I8			*refidx, *refidx1;			//-1 where the list is unused
	//Motion vector differences, for CABAC context. One pair per list: the
	//context for a list 1 difference counts its neighbours' list 1 differences.
	I16			*mvdx, *mvdy, *mvdx1, *mvdy1;
	I64			 reorder;			//pictures the player holds for display order
	I64			 store_gen;			//bumped whenever the frame store is rebuilt
	//Second prediction of a bi-predicted partition, before averaging.
	U8			 mc_y[256], mc_c[2][64];
};

U0 H264DecFree(CH264Dec *d)
{
	I64 i, p;

	Free(d->nnz);
	Free(d->nnz_c[0]);
	Free(d->nnz_c[1]);
	Free(d->modes);
	Free(d->mb_slice);
	Free(d->mb_qp);
	Free(d->mb_kind);
	Free(d->mb_cmode);
	Free(d->mb_tx8);
	Free(d->mb_cbp);
	Free(d->mb_deblock);
	Free(d->blk_direct);
	d->blk_direct = NULL;
	Free(d->mb_a);
	Free(d->mb_b);
	Free(d->mvdx);
	Free(d->mvdy);
	Free(d->mvdx1);
	Free(d->mvdy1);
	d->mvdx = NULL;
	d->mvdy = NULL;
	d->mvdx1 = NULL;
	d->mvdy1 = NULL;
	for (i = 0; i < H264_REFS_MAX; i++)
	{
		for (p = 0; p < 3; p++)
		{
			Free(d->frame[i].pic[p]);
			d->frame[i].pic[p] = NULL;
		}
		Free(d->frame[i].mvx);
		Free(d->frame[i].mvy);
		Free(d->frame[i].refidx);
		Free(d->frame[i].mvx1);
		Free(d->frame[i].mvy1);
		Free(d->frame[i].refidx1);
		d->frame[i].mvx     = NULL;
		d->frame[i].mvy     = NULL;
		d->frame[i].refidx  = NULL;
		d->frame[i].mvx1    = NULL;
		d->frame[i].mvy1    = NULL;
		d->frame[i].refidx1 = NULL;
		d->frame[i].used   = FALSE;
		d->frame[i].held   = FALSE;
	}
	d->nnz        = NULL;
	d->nnz_c[0]   = NULL;
	d->nnz_c[1]   = NULL;
	d->modes      = NULL;
	d->mb_slice   = NULL;
	d->mb_qp      = NULL;
	d->mb_kind    = NULL;
	d->mb_cmode   = NULL;
	d->mb_tx8     = NULL;
	d->mb_cbp     = NULL;
	d->mb_deblock = NULL;
	d->mb_a       = NULL;
	d->mb_b       = NULL;
	d->mvx        = NULL;
	d->mvy        = NULL;
	d->refidx     = NULL;
	d->cur        = NULL;
	d->ref0_count = 0;
}

Bool H264DecSize(CH264Dec *d, CH264SPS *s)
{
	I64 i, p, n, blocks;

	if (d->nnz && d->mb_w == s->mb_width && d->mb_h == s->mb_height)
		return TRUE;
	H264DecFree(d);
	d->mb_w = s->mb_width;
	d->mb_h = s->mb_height;
	blocks  = d->mb_w * 4 * d->mb_h * 4;
	d->nnz        = CAlloc(blocks);
	d->nnz_c[0]   = CAlloc(d->mb_w * 2 * d->mb_h * 2);
	d->nnz_c[1]   = CAlloc(d->mb_w * 2 * d->mb_h * 2);
	d->modes      = CAlloc(blocks);
	d->mb_slice   = CAlloc(d->mb_w * d->mb_h);
	d->mb_qp      = CAlloc(d->mb_w * d->mb_h);
	d->mb_kind    = CAlloc(d->mb_w * d->mb_h);
	d->mb_cmode   = CAlloc(d->mb_w * d->mb_h);
	d->mb_tx8     = CAlloc(d->mb_w * d->mb_h);
	d->mb_cbp     = CAlloc(d->mb_w * d->mb_h * sizeof(U16));
	d->mb_deblock = CAlloc(d->mb_w * d->mb_h);
	d->blk_direct = CAlloc(blocks);
	d->mb_a       = CAlloc(d->mb_w * d->mb_h);
	d->mb_b       = CAlloc(d->mb_w * d->mb_h);
	d->mvdx       = CAlloc(blocks * sizeof(I16));
	d->mvdy       = CAlloc(blocks * sizeof(I16));
	d->mvdx1      = CAlloc(blocks * sizeof(I16));
	d->mvdy1      = CAlloc(blocks * sizeof(I16));
	d->stride[0]  = d->mb_w * 16;
	d->stride[1]  = d->mb_w * 8;
	d->stride[2]  = d->mb_w * 8;
	//One frame per reference, one being built, one for the picture that just
	//finished, and one per picture the player is holding to put B pictures back
	//into display order. H264FrameFree excludes d->cur, and a non-reference B
	//holds that slot without being marked used, so it occupies no reference
	//slot either.
	n = s->max_ref_frames + d->reorder + 2;
	if (n > H264_REFS_MAX)
	{//The store is the authority. Holding fewer pictures costs display order
	//on a stream that reorders very deeply; running short of buffers stops
	//decoding altogether.
		d->reorder = H264_REFS_MAX - s->max_ref_frames - 2;
		if (d->reorder < 0)
			d->reorder = 0;
		n = s->max_ref_frames + d->reorder + 2;
	}
	if (n < 2)
		n = 2;
	if (n > H264_REFS_MAX)
		n = H264_REFS_MAX;
	d->store_gen++;
	for (i = 0; i < n; i++)
	{
		for (p = 0; p < 3; p++)
		{
			d->frame[i].stride[p] = d->stride[p];
			if (!p)
				d->frame[i].pic[p] = CAlloc(d->stride[0] * d->mb_h * 16);
			else
				d->frame[i].pic[p] = CAlloc(d->stride[1] * d->mb_h * 8);
			if (!d->frame[i].pic[p])
				return FALSE;
		}
		d->frame[i].mvx     = CAlloc(blocks * sizeof(I16));
		d->frame[i].mvy     = CAlloc(blocks * sizeof(I16));
		d->frame[i].refidx  = CAlloc(blocks);
		d->frame[i].mvx1    = CAlloc(blocks * sizeof(I16));
		d->frame[i].mvy1    = CAlloc(blocks * sizeof(I16));
		d->frame[i].refidx1 = CAlloc(blocks);
		if (!d->frame[i].mvx || !d->frame[i].mvy || !d->frame[i].refidx ||
			!d->frame[i].mvx1 || !d->frame[i].mvy1 || !d->frame[i].refidx1)
			return FALSE;
	}

	return ToBool(d->nnz && d->modes && d->mb_slice && d->mb_qp && d->mb_kind &&
				  d->mb_cmode && d->mb_tx8 && d->mb_cbp && d->mvdx && d->mvdy &&
				  d->mvdx1 && d->mvdy1 && d->blk_direct);
}

CH264Frame *H264FrameFree(CH264Dec *d)
{
	I64 i;

	for (i = 0; i < H264_REFS_MAX; i++)
		if (d->frame[i].pic[0] && !d->frame[i].used && !d->frame[i].held &&
			&d->frame[i] != d->cur)
			return &d->frame[i];

	return NULL;
}

U0 H264RefsClear(CH264Dec *d)
{
	I64 i;

	for (i = 0; i < H264_REFS_MAX; i++)
		d->frame[i].used = FALSE;
}

public U0 H264DecReset(CH264Dec *d)
{//A seek can land on an I picture that is not an IDR, which clears nothing.
//The picture order count predictors would then be read across the seek and
//8.2.1.1's wrap test can bump poc_msb by a whole cycle, so output order goes
//wrong on the first pictures after it.
	if (!d)
		return;
	H264RefsClear(d);
	d->cur           = NULL;
	d->poc_msb       = 0;
	d->poc_lsb_prev  = 0;
	d->frame_num_prev = 0;
	d->ref0_count    = 0;
	d->ref1_count    = 0;
}

/***** reference pictures *****/

I64 H264FrameNumWrap(CH264Dec *d, CH264Frame *f, I64 max_frame_num)
{//8.2.4.1: a reference ahead of the current frame_num belongs to the previous
//cycle.
	if (f->frame_num > d->cur->frame_num)
		return f->frame_num - max_frame_num;

	return f->frame_num;
}

U0 H264PocCompute(CH264Dec *d, CH264SPS *s, CH264Slice *sl)
{//8.2.1.1 and 8.2.1.3.
	I64 max_lsb = 1 << s->log2_max_poc_lsb, msb;

	if (s->poc_type == 2)
	{
		d->poc = 2 * sl->frame_num;
		if (!sl->nal_ref_idc)
			d->poc--;
		d->cur->poc = d->poc;
		return;
	}
	if (sl->nal_type == H264_NAL_IDR)
	{
		d->poc_msb      = 0;
		d->poc_lsb_prev = 0;
	}
	msb = d->poc_msb;
	if (sl->poc_lsb < d->poc_lsb_prev &&
		d->poc_lsb_prev - sl->poc_lsb >= max_lsb / 2)
		msb = d->poc_msb + max_lsb;
	else if (sl->poc_lsb > d->poc_lsb_prev &&
			 sl->poc_lsb - d->poc_lsb_prev > max_lsb / 2)
		msb = d->poc_msb - max_lsb;
	d->poc      = msb + sl->poc_lsb;
	d->cur->poc = d->poc;
	if (sl->nal_ref_idc)
	{
		d->poc_msb      = msb;
		d->poc_lsb_prev = sl->poc_lsb;
	}
}

U0 H264RefSort(CH264Frame **list, I64 *key, I64 n, Bool ascending)
{
	CH264Frame	*f;
	I64			 i, j, best, v;

	for (i = 0; i < n; i++)
	{
		best = i;
		for (j = i + 1; j < n; j++)
			if (ascending && key[j] < key[best] ||
				!ascending && key[j] > key[best])
				best = j;
		f           = list[i];
		list[i]     = list[best];
		list[best]  = f;
		v           = key[i];
		key[i]      = key[best];
		key[best]   = v;
	}
}

U0 H264RefListBuildB(CH264Dec *d)
{//8.2.4.2.3: list 0 is the past by falling POC then the future by rising,
//list 1 the other way about.
	CH264Frame	*bef[H264_REFS_MAX], *aft[H264_REFS_MAX], *f;
	I64			 kb[H264_REFS_MAX], ka[H264_REFS_MAX];
	I64			 i, nb = 0, na = 0;

	for (i = 0; i < H264_REFS_MAX; i++)
	{
		f = &d->frame[i];
		if (!f->used || f == d->cur)
			goto next_b;
		if (f->poc < d->poc)
		{
			bef[nb] = f;
			kb[nb]  = f->poc;
			nb++;
		}
		else
		{
			aft[na] = f;
			ka[na]  = f->poc;
			na++;
		}
next_b:;
	}
	H264RefSort(bef, kb, nb, FALSE);
	H264RefSort(aft, ka, na, TRUE);
	for (i = 0; i < nb; i++)
		d->ref0[i] = bef[i];
	for (i = 0; i < na; i++)
		d->ref0[nb + i] = aft[i];
	d->ref0_count = nb + na;
	for (i = 0; i < na; i++)
		d->ref1[i] = aft[i];
	for (i = 0; i < nb; i++)
		d->ref1[na + i] = bef[i];
	d->ref1_count = na + nb;
	if (d->ref1_count > 1 && d->ref0_count == d->ref1_count)
	{//The lists must differ when they hold the same pictures.
		for (i = 0; i < d->ref0_count; i++)
			if (d->ref0[i] != d->ref1[i])
				return;
		f          = d->ref1[0];
		d->ref1[0] = d->ref1[1];
		d->ref1[1] = f;
	}
}

U0 H264RefListBuild(CH264Dec *d, I64 max_frame_num)
{//8.2.4.2: short term references, descending PicNum.
	CH264Frame	*f;
	I64			 i, j, best, n = 0, num[H264_REFS_MAX], v;

	for (i = 0; i < H264_REFS_MAX; i++)
	{
		f = &d->frame[i];
		if (!f->used || f == d->cur)
			goto next_ref;
		d->ref0[n] = f;
		num[n]     = H264FrameNumWrap(d, f, max_frame_num);
		n++;
next_ref:;
	}
	for (i = 0; i < n; i++)
	{
		best = i;
		for (j = i + 1; j < n; j++)
			if (num[j] > num[best])
				best = j;
		f            = d->ref0[i];
		d->ref0[i]   = d->ref0[best];
		d->ref0[best] = f;
		v            = num[i];
		num[i]       = num[best];
		num[best]    = v;
	}
	d->ref0_count = n;
}

U0 H264RefListReorder(CH264Dec *d, CH264Slice *sl, I64 max_frame_num)
{//8.2.4.3, short term entries only.
	CH264Frame	*f;
	I64			 i, j, pred = d->cur->frame_num, pic, op;

	for (i = 0; i < sl->reorder_count; i++)
	{
		op = sl->reorder_op[i];
		if (!op)
			pred -= sl->reorder_arg[i] + 1;
		else
			pred += sl->reorder_arg[i] + 1;
		if (pred < 0)
			pred += max_frame_num;
		if (pred >= max_frame_num)
			pred -= max_frame_num;
		pic = pred;
		if (pic > d->cur->frame_num)
			pic -= max_frame_num;
		for (j = i; j < d->ref0_count; j++)
			if (H264FrameNumWrap(d, d->ref0[j], max_frame_num) == pic)
			{
				f = d->ref0[j];
				while (j > i)
				{
					d->ref0[j] = d->ref0[j - 1];
					j--;
				}
				d->ref0[i] = f;
				j = d->ref0_count;
			}
	}
}

U0 H264RefMmco(CH264Dec *d, CH264Slice *sl, I64 max_frame_num)
{//8.2.5.4.1: memory_management_control_operation 1 releases the short term
//picture whose PicNum is CurrPicNum - (difference_of_pic_nums_minus1 + 1).
//A B pyramid needs this: x264 marks a reference B unused as soon as the
//pictures that depend on it are decoded, and the sliding window would drop a
//different picture.
	CH264Frame	*f;
	I64			 i, j, pic, cur = d->cur->frame_num;

	for (i = 0; i < sl->mmco_count; i++)
	{
		pic = cur - (sl->mmco_arg[i] + 1);
		if (pic < 0)
			pic += max_frame_num;
		for (j = 0; j < H264_REFS_MAX; j++)
		{
			f = &d->frame[j];
			if (f->used && f != d->cur && f->frame_num == pic)
				f->used = FALSE;
		}
	}
	d->cur->used = TRUE;
}

U0 H264RefStore(CH264Dec *d, I64 max_ref_frames, I64 max_frame_num)
{//8.2.5.3 sliding window.
	CH264Frame	*f, *old;
	I64			 i, n = 0, worst, v;

	for (i = 0; i < H264_REFS_MAX; i++)
		if (d->frame[i].used && &d->frame[i] != d->cur)
			n++;
	while (n >= max_ref_frames && n > 0)
	{
		old   = NULL;
		worst = 0;
		for (i = 0; i < H264_REFS_MAX; i++)
		{
			f = &d->frame[i];
			if (!f->used || f == d->cur)
				goto next_old;
			v = H264FrameNumWrap(d, f, max_frame_num);
			if (!old || v < worst)
			{
				old   = f;
				worst = v;
			}
next_old:;
		}
		if (!old)
			break;
		old->used = FALSE;
		n--;
	}
	d->cur->used = TRUE;
}

I64 H264Blk4x4X(I64 blk)
{//Luma 4x4 blocks are numbered in Z order within the macroblock.
	return (blk & 1) + 2 * ((blk & 4) >> 2);
}

I64 H264Blk4x4Y(I64 blk)
{
	return ((blk & 2) >> 1) + 2 * ((blk & 8) >> 3);
}

Bool H264NeighbourOk(CH264Dec *d, I64 mb_x, I64 mb_y)
{//Only within the current slice: a neighbour in another slice does not exist
//for prediction.
	if (mb_x < 0 || mb_y < 0 || mb_x >= d->mb_w || mb_y >= d->mb_h)
		return FALSE;

	return ToBool(d->mb_slice[mb_y * d->mb_w + mb_x] == d->slice_id);
}

I64 H264NcAt(CH264Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 scale)
{//Coefficient count of the block at (x, y) if its macroblock is available.
	if (x < 0 || y < 0)
		return -1;
	if (!H264NeighbourOk(d, x / scale, y / scale))
		return -1;

	return plane[y * stride + x];
}

I64 H264Nc(CH264Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 scale)
{//nC is the mean of the left and above counts, or whichever exists.
	I64 a  = H264NcAt(d, plane, stride, x - 1, y, scale);
	I64 bb = H264NcAt(d, plane, stride, x, y - 1, scale);

	if (a >= 0 && bb >= 0)
		return (a + bb + 1) >> 1;
	if (a >= 0)
		return a;
	if (bb >= 0)
		return bb;

	return 0;
}

I64 H264PredIntraMode(CH264Dec *d, I64 x4, I64 y4)
{//The smaller of the neighbouring modes; DC when either is missing.
	I64 stride = d->mb_w * 4, a = -1, bb = -1;

	if (x4 > 0 && H264NeighbourOk(d, (x4 - 1) / 4, y4 / 4))
		a = d->modes[y4 * stride + x4 - 1];
	if (y4 > 0 && H264NeighbourOk(d, x4 / 4, (y4 - 1) / 4))
		bb = d->modes[(y4 - 1) * stride + x4];
	if (a < 0 || bb < 0)
		return 2;					//DC
	if (a < bb)
		return a;

	return bb;
}

I64 H264Clip(I64 v)
{
	if (v < 0)
		return 0;
	if (v > 255)
		return 255;

	return v;
}

I64 H264ZOf(I64 x, I64 y)
{//Inverse of H264Blk4x4X/Y.
	return (x & 1) | (y & 1) << 1 | (x & 2) << 1 | (y & 2) << 2;
}

/***** motion compensation *****/

I64 H264ClampI(I64 v, I64 n)
{
	if (v < 0)
		return 0;
	if (v >= n)
		return n - 1;

	return v;
}

U8 *H264McWindow(U8 *win, U8 *ref, I64 ref_st, I64 pw, I64 ph, I64 xi, I64 yi,
				 I64 ww, I64 wh, I64 *_st)
{
	I64 x, y, sy;

	if (xi >= 0 && yi >= 0 && xi + ww <= pw && yi + wh <= ph)
	{
		*_st = ref_st;

		return ref + yi * ref_st + xi;
	}
	for (y = 0; y < wh; y++)
	{
		sy = H264ClampI(yi + y, ph);
		for (x = 0; x < ww; x++)
			win[y * ww + x] = ref[sy * ref_st + H264ClampI(xi + x, pw)];
	}
	*_st = ww;

	return win;
}

U0 H264McLuma(U8 *dst, I64 dst_st, U8 *ref, I64 ref_st, I64 pw, I64 ph,
			  I64 x0, I64 y0, I64 bw, I64 bh, I64 mvx, I64 mvy)
{//8.4.2.2.1. b is the horizontal half sample, h the vertical, j the centre.
	U8	 win[21 * 21];
	I16	 mid[21 * 16];			//unrounded horizontal filter, for the centre
	I64	 fx = mvx & 3, fy = mvy & 3, st, x, y, v, j, hh;
	I64	 xi = x0 + (mvx >> 2) - 2, yi = y0 + (mvy >> 2) - 2;
	I64	 ww = bw + 5, wh = bh + 5;
	U8	*s = H264McWindow(win, ref, ref_st, pw, ph, xi, yi, ww, wh, &st);
	U8	*p;
	I16	*m;

	if (!fx && !fy)
	{
		for (y = 0; y < bh; y++)
			for (x = 0; x < bw; x++)
				dst[y * dst_st + x] = s[(y + 2) * st + x + 2];
		return;
	}
	if (!fy)
	{//a b c
		for (y = 0; y < bh; y++)
			for (x = 0; x < bw; x++)
			{
				p = s + (y + 2) * st + x + 2;
				v = H264Clip((p[-2] - 5 * p[-1] + 20 * p[0] + 20 * p[1] -
							  5 * p[2] + p[3] + 16) >> 5);
				if (fx != 2)
					v = (p[fx >> 1] + v + 1) >> 1;
				dst[y * dst_st + x] = v;
			}
		return;
	}
	if (!fx)
	{//d h n
		for (y = 0; y < bh; y++)
			for (x = 0; x < bw; x++)
			{
				p = s + (y + 2) * st + x + 2;
				v = H264Clip((p[-2 * st] - 5 * p[-st] + 20 * p[0] +
							  20 * p[st] - 5 * p[2 * st] + p[3 * st] +
							  16) >> 5);
				if (fy != 2)
					v = (p[(fy >> 1) * st] + v + 1) >> 1;
				dst[y * dst_st + x] = v;
			}
		return;
	}
	if (fx != 2 && fy != 2)
	{//e g p r: the two half samples either side of the diagonal
		for (y = 0; y < bh; y++)
			for (x = 0; x < bw; x++)
			{
				p = s + (y + 2 + (fy >> 1)) * st + x + 2;
				v = H264Clip((p[-2] - 5 * p[-1] + 20 * p[0] + 20 * p[1] -
							  5 * p[2] + p[3] + 16) >> 5);
				p = s + (y + 2) * st + x + 2 + (fx >> 1);
				hh = H264Clip((p[-2 * st] - 5 * p[-st] + 20 * p[0] +
							   20 * p[st] - 5 * p[2 * st] + p[3 * st] +
							   16) >> 5);
				dst[y * dst_st + x] = (v + hh + 1) >> 1;
			}
		return;
	}

	for (y = 0; y < wh; y++)
		for (x = 0; x < bw; x++)
		{
			p = s + y * st + x + 2;
			mid[y * bw + x] = p[-2] - 5 * p[-1] + 20 * p[0] + 20 * p[1] -
							  5 * p[2] + p[3];
		}
	for (y = 0; y < bh; y++)
		for (x = 0; x < bw; x++)
		{
			m = mid + y * bw + x;
			j = H264Clip((m[0] - 5 * m[bw] + 20 * m[2 * bw] + 20 * m[3 * bw] -
						  5 * m[4 * bw] + m[5 * bw] + 512) >> 10);
			v = j;
			if (fx == 2 && fy != 2)
			{//f q
				m = mid + (y + 2 + (fy >> 1)) * bw + x;
				v = (j + H264Clip((m[0] + 16) >> 5) + 1) >> 1;
			}
			else if (fy == 2 && fx != 2)
			{//i k
				p  = s + (y + 2) * st + x + 2 + (fx >> 1);
				hh = H264Clip((p[-2 * st] - 5 * p[-st] + 20 * p[0] +
							   20 * p[st] - 5 * p[2 * st] + p[3 * st] +
							   16) >> 5);
				v  = (j + hh + 1) >> 1;
			}
			dst[y * dst_st + x] = v;
		}
}

U0 H264McChroma(U8 *dst, I64 dst_st, U8 *ref, I64 ref_st, I64 pw, I64 ph,
				I64 x0, I64 y0, I64 bw, I64 bh, I64 mvx, I64 mvy)
{//Eighth pel bilinear, 8.4.2.2.2.
	U8	 win[10 * 10];
	I64	 xi = x0 + (mvx >> 3), yi = y0 + (mvy >> 3);
	I64	 dx = mvx & 7, dy = mvy & 7, st, x, y;
	U8	*s = H264McWindow(win, ref, ref_st, pw, ph, xi, yi, bw + 1, bh + 1,
						  &st);
	U8	*p;

	if (!dx && !dy)
	{
		for (y = 0; y < bh; y++)
			for (x = 0; x < bw; x++)
				dst[y * dst_st + x] = s[y * st + x];
		return;
	}
	for (y = 0; y < bh; y++)
		for (x = 0; x < bw; x++)
		{
			p = s + y * st + x;
			dst[y * dst_st + x] = ((8 - dx) * (8 - dy) * p[0] +
								   dx * (8 - dy) * p[1] +
								   (8 - dx) * dy * p[st] +
								   dx * dy * p[st + 1] + 32) >> 6;
		}
}

/***** macroblock layer, P slices *****/

I64 H264MvAt(CH264Dec *d, I64 x4, I64 y4, I64 zcur, I64 list,
			 I64 *_mvx, I64 *_mvy)
{//-2 when the block does not exist, -1 when it exists but does not predict
//from this list: only the first substitutes another neighbour. zcur is the
//asking partition's Z index.
	I64 stride = d->mb_w * 4, i;

	*_mvx = 0;
	*_mvy = 0;
	if (x4 < 0 || y4 < 0 || x4 >= stride || y4 >= d->mb_h * 4)
		return -2;
	if (!H264NeighbourOk(d, x4 >> 2, y4 >> 2))
		return -2;
	if (x4 >> 2 == d->mb_x && y4 >> 2 == d->mb_y &&
		H264ZOf(x4 & 3, y4 & 3) >= zcur)
		return -2;					//inside this macroblock, not decoded yet
	i = y4 * stride + x4;
	if (list)
	{
		if (d->refidx1[i] < 0)
			return -1;
		*_mvx = d->mvx1[i];
		*_mvy = d->mvy1[i];

		return d->refidx1[i];
	}
	if (d->refidx[i] < 0)
		return -1;
	*_mvx = d->mvx[i];
	*_mvy = d->mvy[i];

	return d->refidx[i];
}

I64 H264Median(I64 a, I64 b, I64 c)
{
	if (a > b)
	{
		if (b > c)
			return b;
		if (a > c)
			return c;
		return a;
	}
	if (a > c)
		return a;
	if (b > c)
		return c;

	return b;
}

U0 H264MvPred(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 ref,
			  I64 part, I64 list, I64 *_mvx, I64 *_mvy)
{//8.4.1.3. part is 0 for a whole macroblock, 1 and 2 for the halves of a 16x8,
//3 and 4 for the halves of an 8x16.
	I64 ra, rb, rc, ax, ay, bx, by, cx, cy, n, z;

	z  = H264ZOf(x4 & 3, y4 & 3);
	ra = H264MvAt(d, x4 - 1, y4, z, list, &ax, &ay);
	rb = H264MvAt(d, x4, y4 - 1, z, list, &bx, &by);
	rc = H264MvAt(d, x4 + bw4, y4 - 1, z, list, &cx, &cy);
	if (rc == -2)
		rc = H264MvAt(d, x4 - 1, y4 - 1, z, list, &cx, &cy);
	if (rb == -2 && rc == -2 && ra != -2)
	{//Only the left neighbour exists: it stands in for the other two.
		rb = ra;
		rc = ra;
		bx = ax;
		by = ay;
		cx = ax;
		cy = ay;
	}
	if (part == 1 && rb == ref)
	{
		*_mvx = bx;
		*_mvy = by;
		return;
	}
	if (part == 2 && ra == ref)
	{
		*_mvx = ax;
		*_mvy = ay;
		return;
	}
	if (part == 3 && ra == ref)
	{
		*_mvx = ax;
		*_mvy = ay;
		return;
	}
	if (part == 4 && rc == ref)
	{
		*_mvx = cx;
		*_mvy = cy;
		return;
	}
	n = 0;
	if (ra == ref)
		n++;
	if (rb == ref)
		n++;
	if (rc == ref)
		n++;
	if (n == 1)
	{//Exactly one neighbour uses this reference; it is the prediction.
		if (ra == ref)
		{
			*_mvx = ax;
			*_mvy = ay;
		}
		else if (rb == ref)
		{
			*_mvx = bx;
			*_mvy = by;
		}
		else
		{
			*_mvx = cx;
			*_mvy = cy;
		}
		return;
	}
	*_mvx = H264Median(ax, bx, cx);
	*_mvy = H264Median(ay, by, cy);
}

U0 H264MvSet(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4, I64 ref,
			 I64 mvx, I64 mvy, I64 dx, I64 dy, I64 list)
{//mvd is shared: only one list is parsed at a time, and its difference is the
//context the next one reads.
	I64 stride = d->mb_w * 4, x, y, i;

	for (y = 0; y < bh4; y++)
		for (x = 0; x < bw4; x++)
		{
			i = (y4 + y) * stride + x4 + x;
			if (list)
			{
				d->refidx1[i] = ref;
				d->mvx1[i]    = mvx;
				d->mvy1[i]    = mvy;
			}
			else
			{
				d->refidx[i] = ref;
				d->mvx[i]    = mvx;
				d->mvy[i]    = mvy;
			}
			if (list)
			{
				d->mvdx1[i] = dx;
				d->mvdy1[i] = dy;
			}
			else
			{
				d->mvdx[i] = dx;
				d->mvdy[i] = dy;
			}
		}
}

U0 H264MvClearMb(CH264Dec *d)
{//Both lists start unused. A frame's motion arrays outlive the picture they
//were filled for, so without this list 1 holds whatever the previous occupant
//of the buffer wrote, and a colocated lookup into a P picture reports list 1
//in use.
	I64 stride = d->mb_w * 4, x, y;

	H264MvSet(d, d->mb_x * 4, d->mb_y * 4, 4, 4, -1, 0, 0, 0, 0, 0);
	H264MvSet(d, d->mb_x * 4, d->mb_y * 4, 4, 4, -1, 0, 0, 0, 0, 1);
	for (y = 0; y < 4; y++)
		for (x = 0; x < 4; x++)
			d->blk_direct[(d->mb_y * 4 + y) * stride + d->mb_x * 4 + x] = 0;
}

U0 H264McBlock(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4, I64 ref,
			   I64 mvx, I64 mvy, I64 list, I64 w0)
{//w0 below zero writes the prediction. Otherwise it blends into what is
//already there with weight w0 on that and 64 - w0 on this, 8.4.2.3.2; w0 of 32
//is the plain (a + b + 1) >> 1.
	CH264Frame	*f;
	I64			 pw = d->mb_w * 16, ph = d->mb_h * 16, pl, x, y, n;
	U8			*dst, *tmp;

	if (list)
	{
		if (!d->ref1_count)
			return;
		if (ref < 0 || ref >= d->ref1_count)
			ref = 0;
		f = d->ref1[ref];
	}
	else
	{
		if (!d->ref0_count)
			return;
		if (ref < 0 || ref >= d->ref0_count)
			ref = 0;
		f = d->ref0[ref];
	}
	if (w0 < 0)
	{
		H264McLuma(d->pic[0] + y4 * 4 * d->stride[0] + x4 * 4, d->stride[0],
				   f->pic[0], f->stride[0], pw, ph, x4 * 4, y4 * 4,
				   bw4 * 4, bh4 * 4, mvx, mvy);
		for (pl = 0; pl < 2; pl++)
			H264McChroma(d->pic[1 + pl] + y4 * 2 * d->stride[1 + pl] + x4 * 2,
						 d->stride[1 + pl], f->pic[1 + pl], f->stride[1 + pl],
						 pw >> 1, ph >> 1, x4 * 2, y4 * 2, bw4 * 2, bh4 * 2,
						 mvx, mvy);
		return;
	}
	H264McLuma(d->mc_y, 16, f->pic[0], f->stride[0], pw, ph, x4 * 4, y4 * 4,
			   bw4 * 4, bh4 * 4, mvx, mvy);
	dst = d->pic[0] + y4 * 4 * d->stride[0] + x4 * 4;
	for (y = 0; y < bh4 * 4; y++)
		for (x = 0; x < bw4 * 4; x++)
		{
			n = dst[y * d->stride[0] + x] * w0 +
				d->mc_y[y * 16 + x] * (64 - w0) + 32;
			dst[y * d->stride[0] + x] = h264_clip8[(n >> 6) + 384];
		}
	for (pl = 0; pl < 2; pl++)
	{
		tmp = d->mc_c[pl];
		H264McChroma(tmp, 8, f->pic[1 + pl], f->stride[1 + pl],
					 pw >> 1, ph >> 1, x4 * 2, y4 * 2, bw4 * 2, bh4 * 2,
					 mvx, mvy);
		dst = d->pic[1 + pl] + y4 * 2 * d->stride[1 + pl] + x4 * 2;
		for (y = 0; y < bh4 * 2; y++)
			for (x = 0; x < bw4 * 2; x++)
			{
				n = dst[y * d->stride[1 + pl] + x] * w0 +
					tmp[y * 8 + x] * (64 - w0) + 32;
				dst[y * d->stride[1 + pl] + x] = h264_clip8[(n >> 6) + 384];
			}
	}
}

I64 H264BiWeight(CH264Dec *d, I64 ref0, I64 ref1)
{//8.4.2.3.1 implicit weights, the weight on list 0. weighted_bipred_idc of 2
//derives them from picture order counts; anything else averages.
	I64 p0, p1, tb, td, tx, dsf;

	if (d->pps->weighted_bipred != 2)
		return 32;
	if (ref0 < 0 || ref0 >= d->ref0_count || ref1 < 0 || ref1 >= d->ref1_count)
		return 32;
	p0 = d->ref0[ref0]->poc;
	p1 = d->ref1[ref1]->poc;
	td = p1 - p0;
	if (td < -128)
		td = -128;
	if (td > 127)
		td = 127;
	if (!td)
		return 32;
	tb = d->poc - p0;
	if (tb < -128)
		tb = -128;
	if (tb > 127)
		tb = 127;
	tx  = (16384 + (AbsI64(td) >> 1)) / td;
	dsf = (tb * tx + 32) >> 8;
	if (dsf < -64 || dsf > 128)
		return 32;

	return 64 - dsf;
}

U0 H264SkipMv(CH264Dec *d, I64 *_mvx, I64 *_mvy)
{//8.4.1.1.
	I64 x4 = d->mb_x * 4, y4 = d->mb_y * 4, ra, rb, ax, ay, bx, by;

	*_mvx = 0;
	*_mvy = 0;
	ra = H264MvAt(d, x4 - 1, y4, 0, 0, &ax, &ay);
	rb = H264MvAt(d, x4, y4 - 1, 0, 0, &bx, &by);
	if (ra == -2 || rb == -2)
		return;
	if (!ra && !ax && !ay)
		return;
	if (!rb && !bx && !by)
		return;
	H264MvPred(d, x4, y4, 4, 0, 0, 0, _mvx, _mvy);
}

Bool H264ResidualLuma(CH264Dec *d, I64 cbp_luma, Bool i16)
{//DC first for I_16x16, then the AC or full blocks the pattern selects.
	I64	 stride = d->mb_w * 4, blk, x4, y4, nc, n, off;
	I64	 max = 16, start = 0;

	if (i16)
	{
		x4 = d->mb_x * 4;
		y4 = d->mb_y * 4;
		nc = H264Nc(d, d->nnz, stride, x4, y4, 4);
		if (H264Residual(&d->b, nc, 16, d->blk, h264_zigzag4) < 0)
			return FALSE;
		max   = 15;
		start = 1;
	}
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		if (!(cbp_luma & 1 << (blk >> 2)))
		{
			d->nnz[y4 * stride + x4] = 0;
			goto next_luma;
		}
		nc  = H264Nc(d, d->nnz, stride, x4, y4, 4);
		off = 16 + blk * 16;
		n   = H264Residual(&d->b, nc, max, d->blk + off, h264_zigzag4 + start);
		if (n < 0)
			return FALSE;
		d->nnz[y4 * stride + x4] = n;
next_luma:;
	}

	return TRUE;
}

Bool H264ResidualChroma(CH264Dec *d, I64 cbp_chroma)
{
	I64	 stride = d->mb_w * 2, pl, blk, x2, y2, nc, n, off;

	if (!cbp_chroma)
	{
		for (pl = 0; pl < 2; pl++)
			for (blk = 0; blk < 4; blk++)
			{
				x2 = d->mb_x * 2 + (blk & 1);
				y2 = d->mb_y * 2 + ((blk >> 1) & 1);
				d->nnz_c[pl][y2 * stride + x2] = 0;
			}
		return TRUE;
	}
	//Chroma DC is a 2x2 block per plane, coded with its own token table.
	for (pl = 0; pl < 2; pl++)
	{
		off = 16 + 256 + pl * 4;
		if (H264Residual(&d->b, -1, 4, d->blk + off, h264_chroma_dc_scan) < 0)
			return FALSE;
	}
	for (pl = 0; pl < 2; pl++)
		for (blk = 0; blk < 4; blk++)
		{
			x2 = d->mb_x * 2 + (blk & 1);
			y2 = d->mb_y * 2 + ((blk >> 1) & 1);
			if (cbp_chroma < 2)
			{
				d->nnz_c[pl][y2 * stride + x2] = 0;
				goto next_chroma;
			}
			nc  = H264Nc(d, d->nnz_c[pl], stride, x2, y2, 2);
			off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
			n   = H264Residual(&d->b, nc, 15, d->blk + off, h264_zigzag4 + 1);
			if (n < 0)
				return FALSE;
			d->nnz_c[pl][y2 * stride + x2] = n;
next_chroma:;
		}

	return TRUE;
}

/***** reconstruction *****/

I64 H264ChromaQP(CH264Dec *d, I64 plane)
{
	I64 q = d->qp + d->pps->chroma_qp_off;

	if (plane)
		q = d->qp + d->pps->chroma_qp_off2;
	if (q < 0)
		q = 0;
	if (q > 51)
		q = 51;

	return h264_chroma_qp[q];
}

I64 H264Scale(I64 qp, I64 pos)
{//normAdjust4x4 by position parity: both even, mixed, both odd. The flat
//weight scale of 16 and the transform's rounding cancel in H264Idct4x4.
	I64 idx = (pos & 1) + (pos >> 2 & 1);

	return h264_dequant4_init[qp % 6 * 3 + idx] << (qp / 6);
}

I64 H264ScaleDC(I64 qp)
{//dequant4_coeff[qp][0] as ffmpeg builds it: 16 * normAdjust << (qp / 6 + 2).
	return h264_dequant4_init[qp % 6 * 3] << (qp / 6 + 6);
}

Bool H264Blk4Avail(CH264Dec *d, I64 bx, I64 by, I64 blk)
{//Whether the 4x4 luma block at picture block coordinates (bx, by) is already
//reconstructed and usable for prediction.
	I64 mx = bx >> 2, my = by >> 2;

	if (bx < 0 || by < 0 || mx >= d->mb_w || my >= d->mb_h)
		return FALSE;
	if (mx == d->mb_x && my == d->mb_y)
		return ToBool(H264ZOf(bx & 3, by & 3) < blk);
	if (my > d->mb_y || my == d->mb_y && mx > d->mb_x)
		return FALSE;

	return H264NeighbourOk(d, mx, my);
}

U0 H264Idct4x4(U8 *dst, I64 stride, I16 *blk)
{//ffmpeg ff_h264_idct_add_c, rows then columns.
	I64 t[16], i, z0, z1, z2, z3, x, y;

	for (i = 0; i < 16; i++)
		t[i] = blk[i];
	t[0] += 32;
	for (y = 0; y < 4; y++)
	{
		z0 = t[4 * y] + t[4 * y + 2];
		z1 = t[4 * y] - t[4 * y + 2];
		z2 = (t[4 * y + 1] >> 1) - t[4 * y + 3];
		z3 = t[4 * y + 1] + (t[4 * y + 3] >> 1);
		t[4 * y]     = z0 + z3;
		t[4 * y + 1] = z1 + z2;
		t[4 * y + 2] = z1 - z2;
		t[4 * y + 3] = z0 - z3;
	}
	for (i = 0; i < 4; i++)
	{
		z0 = t[i] + t[i + 8];
		z1 = t[i] - t[i + 8];
		z2 = (t[i + 4] >> 1) - t[i + 12];
		z3 = t[i + 4] + (t[i + 12] >> 1);
		x = i;
		dst[x]              = H264Clip(dst[x]              + ((z0 + z3) >> 6));
		dst[stride + x]     = H264Clip(dst[stride + x]     + ((z1 + z2) >> 6));
		dst[2 * stride + x] = H264Clip(dst[2 * stride + x] + ((z1 - z2) >> 6));
		dst[3 * stride + x] = H264Clip(dst[3 * stride + x] + ((z0 - z3) >> 6));
	}
}

U0 H264LumaDC(CH264Dec *d)
{//4x4 Hadamard over the DC coefficients, scattered into the AC blocks.
	I64 qmul = H264ScaleDC(d->qp), t[16], i, a, b, c, e, x, y;

	for (y = 0; y < 4; y++)
	{
		a = d->blk[4 * y]     + d->blk[4 * y + 3];
		b = d->blk[4 * y + 1] + d->blk[4 * y + 2];
		c = d->blk[4 * y + 1] - d->blk[4 * y + 2];
		e = d->blk[4 * y]     - d->blk[4 * y + 3];
		t[4 * y]     = a + b;
		t[4 * y + 1] = e + c;
		t[4 * y + 2] = a - b;
		t[4 * y + 3] = e - c;
	}
	for (x = 0; x < 4; x++)
	{
		a = t[x]     + t[x + 12];
		b = t[x + 4] + t[x + 8];
		c = t[x + 4] - t[x + 8];
		e = t[x]     - t[x + 12];
		for (y = 0; y < 4; y++)
		{
			if (!y)
				i = a + b;
			else if (y == 1)
				i = e + c;
			else if (y == 2)
				i = a - b;
			else
				i = e - c;
			d->blk[16 + H264ZOf(x, y) * 16] = (i * qmul + 128) >> 8;
		}
	}
}

U0 H264ChromaDC(CH264Dec *d, I64 pl)
{//2x2 Hadamard, into the DC of the plane's four 4x4 blocks.
	I64	 qmul = H264ScaleDC(H264ChromaQP(d, pl));
	I16	*dc = d->blk + 16 + 256 + pl * 4;
	I64	 a = dc[0] + dc[1], b = dc[0] - dc[1];
	I64	 c = dc[2] + dc[3], e = dc[2] - dc[3], off = 16 + 256 + 8 + pl * 64;

	d->blk[off]      = ((a + c) * qmul) >> 7;
	d->blk[off + 16] = ((b + e) * qmul) >> 7;
	d->blk[off + 32] = ((a - c) * qmul) >> 7;
	d->blk[off + 48] = ((b - e) * qmul) >> 7;
}

I64 H264EdgeT(I64 *t, I64 tl, I64 k)
{//p[k, -1], with k of -1 giving the corner sample.
	if (k < 0)
		return tl;

	return t[k];
}

I64 H264EdgeL(I64 *l, I64 tl, I64 k)
{//p[-1, k].
	if (k < 0)
		return tl;

	return l[k];
}

U0 H264Intra4x4(CH264Dec *d, I64 blk, I64 mode)
{
	I64		 st = d->stride[0];
	I64		 bx = d->mb_x * 4 + H264Blk4x4X(blk);
	I64		 by = d->mb_y * 4 + H264Blk4x4Y(blk);
	U8		*dst = d->pic[0] + by * 4 * st + bx * 4;
	I64		 t[8], l[4], tl = 128, i, x, y, v, z, s;
	Bool	 lok = H264Blk4Avail(d, bx - 1, by, blk);
	Bool	 tok = H264Blk4Avail(d, bx, by - 1, blk);
	Bool	 trok = H264Blk4Avail(d, bx + 1, by - 1, blk);
	Bool	 tlok = H264Blk4Avail(d, bx - 1, by - 1, blk);

	for (i = 0; i < 8; i++)
		t[i] = 128;
	for (i = 0; i < 4; i++)
		l[i] = 128;
	if (tok)
		for (i = 0; i < 4; i++)
			t[i] = dst[i - st];
	if (trok)
		for (i = 4; i < 8; i++)
			t[i] = dst[i - st];
	else
		for (i = 4; i < 8; i++)
			t[i] = t[3];
	if (lok)
		for (i = 0; i < 4; i++)
			l[i] = dst[i * st - 1];
	if (tlok)
		tl = dst[-st - 1];

	if (mode == 2)
	{//DC over whichever edges exist.
		s = 0;
		if (lok && tok)
		{
			for (i = 0; i < 4; i++)
				s += t[i] + l[i];
			v = (s + 4) >> 3;
		}
		else if (lok)
		{
			for (i = 0; i < 4; i++)
				s += l[i];
			v = (s + 2) >> 2;
		}
		else if (tok)
		{
			for (i = 0; i < 4; i++)
				s += t[i];
			v = (s + 2) >> 2;
		}
		else
			v = 128;
	}
	for (y = 0; y < 4; y++)
		for (x = 0; x < 4; x++)
		{
			if (!mode)
				v = t[x];
			else if (mode == 1)
				v = l[y];
			else if (mode == 3)
			{
				if (x == 3 && y == 3)
					v = (t[6] + 3 * t[7] + 2) >> 2;
				else
					v = (t[x + y] + 2 * t[x + y + 1] + t[x + y + 2] + 2) >> 2;
			}
			else if (mode == 4)
			{
				if (x > y)
					v = (H264EdgeT(t, tl, x - y - 2) +
						2 * H264EdgeT(t, tl, x - y - 1) + t[x - y] + 2) >> 2;
				else if (x < y)
					v = (H264EdgeL(l, tl, y - x - 2) +
						2 * H264EdgeL(l, tl, y - x - 1) + l[y - x] + 2) >> 2;
				else
					v = (t[0] + 2 * tl + l[0] + 2) >> 2;
			}
			else if (mode == 5)
			{
				z = 2 * x - y;
				if (z >= 0 && !(z & 1))
					v = (H264EdgeT(t, tl, x - (y >> 1) - 1) +
						t[x - (y >> 1)] + 1) >> 1;
				else if (z >= 0)
					v = (H264EdgeT(t, tl, x - (y >> 1) - 2) +
						2 * H264EdgeT(t, tl, x - (y >> 1) - 1) +
						t[x - (y >> 1)] + 2) >> 2;
				else if (z == -1)
					v = (l[0] + 2 * tl + t[0] + 2) >> 2;
				else
					v = (H264EdgeL(l, tl, y - 1) + 2 * H264EdgeL(l, tl, y - 2) +
						H264EdgeL(l, tl, y - 3) + 2) >> 2;
			}
			else if (mode == 6)
			{
				z = 2 * y - x;
				if (z >= 0 && !(z & 1))
					v = (H264EdgeL(l, tl, y - (x >> 1) - 1) +
						l[y - (x >> 1)] + 1) >> 1;
				else if (z >= 0)
					v = (H264EdgeL(l, tl, y - (x >> 1) - 2) +
						2 * H264EdgeL(l, tl, y - (x >> 1) - 1) +
						l[y - (x >> 1)] + 2) >> 2;
				else if (z == -1)
					v = (l[0] + 2 * tl + t[0] + 2) >> 2;
				else
					v = (H264EdgeT(t, tl, x - 1) + 2 * H264EdgeT(t, tl, x - 2) +
						H264EdgeT(t, tl, x - 3) + 2) >> 2;
			}
			else if (mode == 7)
			{
				if (!(y & 1))
					v = (t[x + (y >> 1)] + t[x + (y >> 1) + 1] + 1) >> 1;
				else
					v = (t[x + (y >> 1)] + 2 * t[x + (y >> 1) + 1] +
						t[x + (y >> 1) + 2] + 2) >> 2;
			}
			else if (mode == 8)
			{
				z = x + 2 * y;
				if (z > 5)
					v = l[3];
				else if (z == 5)
					v = (l[2] + 3 * l[3] + 2) >> 2;
				else if (!(z & 1))
					v = (l[y + (x >> 1)] + l[y + (x >> 1) + 1] + 1) >> 1;
				else
					v = (l[y + (x >> 1)] + 2 * l[y + (x >> 1) + 1] +
						l[y + (x >> 1) + 2] + 2) >> 2;
			}
			dst[y * st + x] = H264Clip(v);
		}
}

U0 H264Intra16x16(CH264Dec *d, I64 mode)
{
	I64		 st = d->stride[0];
	U8		*dst = d->pic[0] + d->mb_y * 16 * st + d->mb_x * 16;
	I64		 i, x, y, v, s = 0, a, b, c, hh = 0, vv = 0;
	Bool	 lok = H264NeighbourOk(d, d->mb_x - 1, d->mb_y);
	Bool	 tok = H264NeighbourOk(d, d->mb_x, d->mb_y - 1);

	//A mode whose edge is missing is not a legal stream; predict DC rather
	//than read outside the picture.
	if (!mode && !tok || mode == 1 && !lok || mode == 3 && !(lok && tok))
		mode = 2;
	if (!mode)
	{
		for (y = 0; y < 16; y++)
			for (x = 0; x < 16; x++)
				dst[y * st + x] = dst[x - st];
		return;
	}
	if (mode == 1)
	{
		for (y = 0; y < 16; y++)
			for (x = 0; x < 16; x++)
				dst[y * st + x] = dst[y * st - 1];
		return;
	}
	if (mode == 2)
	{
		if (lok && tok)
		{
			for (i = 0; i < 16; i++)
				s += dst[i - st] + dst[i * st - 1];
			v = (s + 16) >> 5;
		}
		else if (tok)
		{
			for (i = 0; i < 16; i++)
				s += dst[i - st];
			v = (s + 8) >> 4;
		}
		else if (lok)
		{
			for (i = 0; i < 16; i++)
				s += dst[i * st - 1];
			v = (s + 8) >> 4;
		}
		else
			v = 128;
		for (y = 0; y < 16; y++)
			for (x = 0; x < 16; x++)
				dst[y * st + x] = v;
		return;
	}
	for (i = 0; i < 8; i++)
	{
		hh += (i + 1) * (dst[8 + i - st] - dst[6 - i - st]);
		vv += (i + 1) * (dst[(8 + i) * st - 1] - dst[(6 - i) * st - 1]);
	}
	a = 16 * (dst[15 * st - 1] + dst[15 - st]);
	b = (5 * hh + 32) >> 6;
	c = (5 * vv + 32) >> 6;
	for (y = 0; y < 16; y++)
		for (x = 0; x < 16; x++)
			dst[y * st + x] = H264Clip((a + b * (x - 7) + c * (y - 7) + 16) >> 5);
}

U0 H264IntraChroma(CH264Dec *d, I64 pl, I64 mode)
{
	I64		 st = d->stride[1 + pl];
	U8		*dst = d->pic[1 + pl] + d->mb_y * 8 * st + d->mb_x * 8;
	I64		 i, x, y, v, s, a, b, c, hh = 0, vv = 0, bx, by;
	Bool	 lok = H264NeighbourOk(d, d->mb_x - 1, d->mb_y);
	Bool	 tok = H264NeighbourOk(d, d->mb_x, d->mb_y - 1);

	if (mode == 1 && !lok || mode == 2 && !tok || mode == 3 && !(lok && tok))
		mode = 0;
	if (mode == 1)
	{
		for (y = 0; y < 8; y++)
			for (x = 0; x < 8; x++)
				dst[y * st + x] = dst[y * st - 1];
		return;
	}
	if (mode == 2)
	{
		for (y = 0; y < 8; y++)
			for (x = 0; x < 8; x++)
				dst[y * st + x] = dst[x - st];
		return;
	}
	if (mode == 3)
	{
		for (i = 0; i < 4; i++)
		{
			hh += (i + 1) * (dst[4 + i - st] - dst[2 - i - st]);
			vv += (i + 1) * (dst[(4 + i) * st - 1] - dst[(2 - i) * st - 1]);
		}
		a = 16 * (dst[7 * st - 1] + dst[7 - st]);
		b = (34 * hh + 32) >> 6;
		c = (34 * vv + 32) >> 6;
		for (y = 0; y < 8; y++)
			for (x = 0; x < 8; x++)
				dst[y * st + x] =
					H264Clip((a + b * (x - 3) + c * (y - 3) + 16) >> 5);
		return;
	}
	//DC, per 4x4 block: the corner blocks prefer the edge that faces them.
	for (by = 0; by < 2; by++)
		for (bx = 0; bx < 2; bx++)
		{
			s = 0;
			if (bx == by)
			{
				if (lok && tok)
				{
					for (i = 0; i < 4; i++)
						s += dst[bx * 4 + i - st] + dst[(by * 4 + i) * st - 1];
					v = (s + 4) >> 3;
					goto chroma_fill;
				}
			}
			else if (bx)
			{
				if (tok)
				{
					for (i = 0; i < 4; i++)
						s += dst[bx * 4 + i - st];
					v = (s + 2) >> 2;
					goto chroma_fill;
				}
			}
			else
			{
				if (lok)
				{
					for (i = 0; i < 4; i++)
						s += dst[(by * 4 + i) * st - 1];
					v = (s + 2) >> 2;
					goto chroma_fill;
				}
			}
			if (tok)
			{
				for (i = 0; i < 4; i++)
					s += dst[bx * 4 + i - st];
				v = (s + 2) >> 2;
			}
			else if (lok)
			{
				for (i = 0; i < 4; i++)
					s += dst[(by * 4 + i) * st - 1];
				v = (s + 2) >> 2;
			}
			else
				v = 128;
chroma_fill:
			for (y = 0; y < 4; y++)
				for (x = 0; x < 4; x++)
					dst[(by * 4 + y) * st + bx * 4 + x] = v;
		}
}

/***** 8x8 transform *****/

I64 H264Scale8(I64 qp, I64 pos)
{//dequant8_coeff as ffmpeg builds it: the flat weight scale of 16 times
//normAdjust8x8, shifted by qp / 6. Its table is stored transposed, so the
//position is transposed back before the class is looked up.
	I64 x = (pos >> 3) | ((pos & 7) << 3);
	I64 idx = h264_dequant8_init_scan[((x >> 1) & 12) | (x & 3)];

	return (h264_dequant8_init[qp % 6 * 6 + idx] << 4) << (qp / 6);
}

U0 H264Dequant8(I16 *blk, I64 qp)
{
	I64 i, v, sh = qp / 6, r = qp % 6 * 6, s[6], x;

	for (i = 0; i < 6; i++)
		s[i] = (h264_dequant8_init[r + i] << 4) << sh;
	for (i = 0; i < 64; i++)
	{
		if (blk[i])
		{
			x = (i >> 3) | ((i & 7) << 3);
			v = blk[i] * s[h264_dequant8_init_scan[((x >> 1) & 12) | (x & 3)]];
			blk[i] = (v + 32) >> 6;
		}
	}
}

U0 H264Idct8x8(U8 *dst, I64 stride, I16 *blk)
{//ffmpeg ff_h264_idct8_add_c. Rows first, then columns: the odd terms round
//through >>1 and >>2, so running the passes the other way round is not the
//same transform.
	I64 t[64], i, x, a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5;
	I64 b6, b7;

	for (i = 0; i < 64; i++)
		t[i] = blk[i];
	t[0] += 32;
	for (i = 0; i < 8; i++)
	{
		x  = i * 8;
		a0 = t[x] + t[x + 4];
		a2 = t[x] - t[x + 4];
		a4 = (t[x + 2] >> 1) - t[x + 6];
		a6 = (t[x + 6] >> 1) + t[x + 2];
		b0 = a0 + a6;
		b2 = a2 + a4;
		b4 = a2 - a4;
		b6 = a0 - a6;
		a1 = -t[x + 3] + t[x + 5] - t[x + 7] - (t[x + 7] >> 1);
		a3 =  t[x + 1] + t[x + 7] - t[x + 3] - (t[x + 3] >> 1);
		a5 = -t[x + 1] + t[x + 7] + t[x + 5] + (t[x + 5] >> 1);
		a7 =  t[x + 3] + t[x + 5] + t[x + 1] + (t[x + 1] >> 1);
		b1 = (a7 >> 2) + a1;
		b3 = a3 + (a5 >> 2);
		b5 = (a3 >> 2) - a5;
		b7 = a7 - (a1 >> 2);
		t[x]     = b0 + b7;
		t[x + 7] = b0 - b7;
		t[x + 1] = b2 + b5;
		t[x + 6] = b2 - b5;
		t[x + 2] = b4 + b3;
		t[x + 5] = b4 - b3;
		t[x + 3] = b6 + b1;
		t[x + 4] = b6 - b1;
	}
	for (i = 0; i < 8; i++)
	{
		a0 = t[i] + t[i + 32];
		a2 = t[i] - t[i + 32];
		a4 = (t[i + 16] >> 1) - t[i + 48];
		a6 = (t[i + 48] >> 1) + t[i + 16];
		b0 = a0 + a6;
		b2 = a2 + a4;
		b4 = a2 - a4;
		b6 = a0 - a6;
		a1 = -t[i + 24] + t[i + 40] - t[i + 56] - (t[i + 56] >> 1);
		a3 =  t[i + 8]  + t[i + 56] - t[i + 24] - (t[i + 24] >> 1);
		a5 = -t[i + 8]  + t[i + 56] + t[i + 40] + (t[i + 40] >> 1);
		a7 =  t[i + 24] + t[i + 40] + t[i + 8]  + (t[i + 8]  >> 1);
		b1 = (a7 >> 2) + a1;
		b3 = a3 + (a5 >> 2);
		b5 = (a3 >> 2) - a5;
		b7 = a7 - (a1 >> 2);
		dst[i]              = H264Clip(dst[i]              + ((b0 + b7) >> 6));
		dst[stride + i]     = H264Clip(dst[stride + i]     + ((b2 + b5) >> 6));
		dst[2 * stride + i] = H264Clip(dst[2 * stride + i] + ((b4 + b3) >> 6));
		dst[3 * stride + i] = H264Clip(dst[3 * stride + i] + ((b6 + b1) >> 6));
		dst[4 * stride + i] = H264Clip(dst[4 * stride + i] + ((b6 - b1) >> 6));
		dst[5 * stride + i] = H264Clip(dst[5 * stride + i] + ((b4 - b3) >> 6));
		dst[6 * stride + i] = H264Clip(dst[6 * stride + i] + ((b2 - b5) >> 6));
		dst[7 * stride + i] = H264Clip(dst[7 * stride + i] + ((b0 - b7) >> 6));
	}
}

U0 H264Intra8x8(CH264Dec *d, I64 i8, I64 mode)
{//8.3.2.2. The edge samples are low pass filtered first.
	I64		 st = d->stride[0];
	I64		 bx = d->mb_x * 4 + (i8 & 1) * 2, by = d->mb_y * 4 + (i8 >> 1) * 2;
	U8		*dst = d->pic[0] + by * 4 * st + bx * 4;
	I64		 t[16], l[8], lt = 128, top[16], left[8], corner = 128, i, x, y, v, s;
	I64		 z = i8 * 4;
	Bool	 lok = H264Blk4Avail(d, bx - 1, by, z);
	Bool	 tok = H264Blk4Avail(d, bx, by - 1, z);
	Bool	 trok = H264Blk4Avail(d, bx + 2, by - 1, z);
	Bool	 tlok = H264Blk4Avail(d, bx - 1, by - 1, z);

	for (i = 0; i < 16; i++)
		top[i] = 128;
	for (i = 0; i < 8; i++)
		left[i] = 128;
	if (tok)
		for (i = 0; i < 8; i++)
			top[i] = dst[i - st];
	if (trok)
		for (i = 8; i < 16; i++)
			top[i] = dst[i - st];
	else
		for (i = 8; i < 16; i++)
			top[i] = top[7];
	if (lok)
		for (i = 0; i < 8; i++)
			left[i] = dst[i * st - 1];
	if (tlok)
		corner = dst[-st - 1];

	if (tlok)
		l[0] = (corner + 2 * left[0] + left[1] + 2) >> 2;
	else
		l[0] = (left[0] + 2 * left[0] + left[1] + 2) >> 2;
	for (i = 1; i < 7; i++)
		l[i] = (left[i - 1] + 2 * left[i] + left[i + 1] + 2) >> 2;
	l[7] = (left[6] + 3 * left[7] + 2) >> 2;

	if (tlok)
		t[0] = (corner + 2 * top[0] + top[1] + 2) >> 2;
	else
		t[0] = (top[0] + 2 * top[0] + top[1] + 2) >> 2;
	for (i = 1; i < 7; i++)
		t[i] = (top[i - 1] + 2 * top[i] + top[i + 1] + 2) >> 2;
	if (trok)
	{
		t[7] = (top[8] + 2 * top[7] + top[6] + 2) >> 2;
		for (i = 8; i < 15; i++)
			t[i] = (top[i - 1] + 2 * top[i] + top[i + 1] + 2) >> 2;
		t[15] = (top[14] + 3 * top[15] + 2) >> 2;
	}
	else
	{
		t[7] = (top[7] + 2 * top[7] + top[6] + 2) >> 2;
		for (i = 8; i < 16; i++)
			t[i] = top[7];			//the unfiltered sample, as ffmpeg has it
	}
	lt = (left[0] + 2 * corner + top[0] + 2) >> 2;

	//Vertical, down left and vertical left need the row above; horizontal and
	//horizontal up the column to the left; the diagonals through the corner
	//need both. Anything else predicts DC.
	if (mode == 3 || mode == 7)
	{
		if (!tok)
			mode = 2;
	}
	else if (mode == 1 || mode == 8)
	{
		if (!lok)
			mode = 2;
	}
	else if (!mode)
	{
		if (!tok)
			mode = 2;
	}
	else if (mode != 2 && !(lok && tok))
		mode = 2;
	if (mode == 2)
	{//DC over whichever edges exist.
		s = 0;
		if (lok && tok)
		{
			for (i = 0; i < 8; i++)
				s += l[i] + t[i];
			v = (s + 8) >> 4;
		}
		else if (lok)
		{
			for (i = 0; i < 8; i++)
				s += l[i];
			v = (s + 4) >> 3;
		}
		else if (tok)
		{
			for (i = 0; i < 8; i++)
				s += t[i];
			v = (s + 4) >> 3;
		}
		else
			v = 128;
		for (y = 0; y < 8; y++)
			for (x = 0; x < 8; x++)
				dst[y * st + x] = v;
		return;
	}
	H264Pred8x8(dst, st, mode, t, l, lt);
}

U0 H264Dequant(I16 *blk, I64 qp, I64 start)
{
	I64 i, sh = qp / 6, r = qp % 6 * 3, s0, s1, s2;

	s0 = h264_dequant4_init[r] << sh;
	s1 = h264_dequant4_init[r + 1] << sh;
	s2 = h264_dequant4_init[r + 2] << sh;
	for (i = start; i < 16; i++)
	{
		if (blk[i])
		{
			r = (i & 1) + (i >> 2 & 1);
			if (!r)
				blk[i] = blk[i] * s0;
			else if (r == 1)
				blk[i] = blk[i] * s1;
			else
				blk[i] = blk[i] * s2;
		}
	}
}

U0 H264ReconLuma(CH264Dec *d, I64 mb_type, I64 cbp_luma)
{
	I64	 st = d->stride[0], blk, x4, y4, mode, stride = d->mb_w * 4;
	U8	*dst;

	if (mb_type)
	{
		H264Intra16x16(d, d->i16_mode);
		H264LumaDC(d);
	}
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		if (!mb_type)
		{
			mode = d->modes[y4 * stride + x4];
			H264Intra4x4(d, blk, mode);
		}
		dst = d->pic[0] + y4 * 4 * st + x4 * 4;
		if (mb_type)
		{
			if (cbp_luma & 1 << (blk >> 2))
				H264Dequant(d->blk + 16 + blk * 16, d->qp, 1);
			H264Idct4x4(dst, st, d->blk + 16 + blk * 16);
		}
		else if (cbp_luma & 1 << (blk >> 2))
		{
			H264Dequant(d->blk + 16 + blk * 16, d->qp, 0);
			H264Idct4x4(dst, st, d->blk + 16 + blk * 16);
		}
	}
}

U0 H264ReconLuma8(CH264Dec *d, I64 cbp_luma)
{
	I64	 st = d->stride[0], stride = d->mb_w * 4, i8, mode, x4, y4;
	U8	*dst;

	for (i8 = 0; i8 < 4; i8++)
	{
		x4   = d->mb_x * 4 + (i8 & 1) * 2;
		y4   = d->mb_y * 4 + (i8 >> 1) * 2;
		mode = d->modes[y4 * stride + x4];
		H264Intra8x8(d, i8, mode);
		if (!(cbp_luma & 1 << i8))
			goto next_8x8;
		H264Dequant8(d->blk + 16 + i8 * 64, d->qp);
		dst = d->pic[0] + y4 * 4 * st + x4 * 4;
		H264Idct8x8(dst, st, d->blk + 16 + i8 * 64);
next_8x8:;
	}
}

U0 H264ReconChroma(CH264Dec *d, I64 cbp_chroma)
{
	I64	 pl, blk, st, qp, off;
	U8	*dst;

	for (pl = 0; pl < 2; pl++)
	{
		H264IntraChroma(d, pl, d->chroma_mode);
		if (!cbp_chroma)
			goto next_plane;
		H264ChromaDC(d, pl);
		st = d->stride[1 + pl];
		qp = H264ChromaQP(d, pl);
		for (blk = 0; blk < 4; blk++)
		{
			off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
			if (cbp_chroma > 1)
				H264Dequant(d->blk + off, qp, 1);
			dst = d->pic[1 + pl] + (d->mb_y * 8 + (blk >> 1) * 4) * st +
				  d->mb_x * 8 + (blk & 1) * 4;
			H264Idct4x4(dst, st, d->blk + off);
		}
next_plane:;
	}
}

/***** macroblock layer, CABAC *****/

//Context bases per residual category: 0 luma DC, 1 luma AC, 2 luma 4x4,
//3 chroma DC, 4 chroma AC.
I64 H264CabacSigBase(I64 cat)
{
	I64 b[6];

	b[0] = 105;
	b[1] = 120;
	b[2] = 134;
	b[3] = 149;
	b[4] = 152;
	b[5] = 402;

	return b[cat];
}

I64 H264CabacLastBase(I64 cat)
{
	I64 b[6];

	b[0] = 166;
	b[1] = 181;
	b[2] = 195;
	b[3] = 210;
	b[4] = 213;
	b[5] = 417;

	return b[cat];
}

I64 H264CabacAbsBase(I64 cat)
{
	I64 b[6];

	b[0] = 227;
	b[1] = 237;
	b[2] = 247;
	b[3] = 257;
	b[4] = 266;
	b[5] = 426;

	return b[cat];
}

I64 H264CabacCbfBase(I64 cat)
{
	I64 b[6];

	b[0] = 85;
	b[1] = 89;
	b[2] = 93;
	b[3] = 97;
	b[4] = 101;
	b[5] = 1012;

	return b[cat];
}

I64 H264MbCbp(CH264Dec *d, I64 mb_x, I64 mb_y, Bool intra)
{//A neighbour outside the slice reads as 0x7CF for an intra macroblock and
//0x00F for an inter one.
	if (!H264NeighbourOk(d, mb_x, mb_y))
	{
		if (intra)
			return 0x7CF;

		return 0x00F;
	}

	return d->mb_cbp[mb_y * d->mb_w + mb_x];
}

I64 H264CabacIntraType(CH264Dec *d, I64 base, Bool i_slice)
{//ffmpeg decode_cabac_intra_mb_type. An I slice takes a neighbour context for
//the first bin and shifts the rest by two.
	CH264Cabac	*c = &d->cabac;
	I64			 ctx = 0, t, one = 0, sb = base;
	I64			 i = d->mb_y * d->mb_w + d->mb_x, k;

	if (i_slice)
	{
		one = 1;
		sb  = base + 2;
		if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y))
		{
			k = d->mb_kind[i - 1];
			if (k == H264_MB_I16X16 || k == H264_MB_IPCM)
				ctx++;
		}
		if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1))
		{
			k = d->mb_kind[i - d->mb_w];
			if (k == H264_MB_I16X16 || k == H264_MB_IPCM)
				ctx++;
		}
	}
	if (!H264CabacDec(c, base + ctx))
		return 0;					//I_NxN
	if (H264CabacTerm(c))
		return 25;					//I_PCM

	t  = 1;
	t += 12 * H264CabacDec(c, sb + 1);
	if (H264CabacDec(c, sb + 2))
		t += 4 + 4 * H264CabacDec(c, sb + 2 + one);
	t += 2 * H264CabacDec(c, sb + 3 + one);
	t += H264CabacDec(c, sb + 3 + 2 * one);

	return t;
}

I64 H264CabacMbType(CH264Dec *d)
{
	return H264CabacIntraType(d, 3, TRUE);
}

I64 H264CabacTx8(CH264Dec *d)
{
	I64 ctx = 0, i = d->mb_y * d->mb_w + d->mb_x;

	if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y) && d->mb_tx8[i - 1])
		ctx++;
	if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1) && d->mb_tx8[i - d->mb_w])
		ctx++;

	return H264CabacDec(&d->cabac, 399 + ctx);
}

I64 H264CabacIntraMode(CH264Dec *d, I64 pred)
{
	CH264Cabac	*c = &d->cabac;
	I64			 mode;

	if (H264CabacDec(c, 68))
		return pred;
	mode  = H264CabacDec(c, 69);
	mode += 2 * H264CabacDec(c, 69);
	mode += 4 * H264CabacDec(c, 69);
	if (mode >= pred)
		mode++;

	return mode;
}

I64 H264CabacChromaMode(CH264Dec *d)
{
	CH264Cabac	*c = &d->cabac;
	I64			 ctx = 0, i = d->mb_y * d->mb_w + d->mb_x;

	if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y) && d->mb_cmode[i - 1])
		ctx++;
	if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1) && d->mb_cmode[i - d->mb_w])
		ctx++;
	if (!H264CabacDec(c, 64 + ctx))
		return 0;
	if (!H264CabacDec(c, 64 + 3))
		return 1;
	if (!H264CabacDec(c, 64 + 3))
		return 2;

	return 3;
}

I64 H264CabacCbpLuma(CH264Dec *d, Bool intra)
{
	CH264Cabac	*c = &d->cabac;
	I64			 a = H264MbCbp(d, d->mb_x - 1, d->mb_y, intra);
	I64			 b = H264MbCbp(d, d->mb_x, d->mb_y - 1, intra), cbp = 0, ctx;

	ctx  = ToI64(!(a & 0x02)) + 2 * ToI64(!(b & 0x04));
	cbp += H264CabacDec(c, 73 + ctx);
	ctx  = ToI64(!(cbp & 0x01)) + 2 * ToI64(!(b & 0x08));
	cbp += H264CabacDec(c, 73 + ctx) << 1;
	ctx  = ToI64(!(a & 0x08)) + 2 * ToI64(!(cbp & 0x01));
	cbp += H264CabacDec(c, 73 + ctx) << 2;
	ctx  = ToI64(!(cbp & 0x04)) + 2 * ToI64(!(cbp & 0x02));
	cbp += H264CabacDec(c, 73 + ctx) << 3;

	return cbp;
}

I64 H264CabacCbpChroma(CH264Dec *d, Bool intra)
{
	CH264Cabac	*c = &d->cabac;
	I64			 a = (H264MbCbp(d, d->mb_x - 1, d->mb_y, intra) >> 4) & 3;
	I64			 b = (H264MbCbp(d, d->mb_x, d->mb_y - 1, intra) >> 4) & 3, ctx = 0;

	if (a > 0)
		ctx++;
	if (b > 0)
		ctx += 2;
	if (!H264CabacDec(c, 77 + ctx))
		return 0;
	ctx = 4;
	if (a == 2)
		ctx++;
	if (b == 2)
		ctx += 2;

	return 1 + H264CabacDec(c, 77 + ctx);
}

U0 H264CabacQpDelta(CH264Dec *d)
{
	CH264Cabac	*c = &d->cabac;
	I64			 val, ctx = 2;

	if (!H264CabacDec(c, 60 + ToI64(d->last_qp_delta != 0)))
	{
		d->last_qp_delta = 0;
		return;
	}
	val = 1;
	while (H264CabacDec(c, 60 + ctx))
	{
		ctx = 3;
		val++;
		if (val > 102)
			break;
	}
	if (val & 1)
		val = (val + 1) >> 1;
	else
		val = -((val + 1) >> 1);
	d->last_qp_delta = val;
	d->qp = (d->qp + val + 52) % 52;
}

I64 H264CabacCbf(CH264Dec *d, I64 cat, I64 nza, I64 nzb)
{//coded_block_flag. The caller resolves the two neighbouring flags.
	I64 ctx = 0;

	if (nza)
		ctx++;
	if (nzb)
		ctx += 2;

	return H264CabacDec(&d->cabac, H264CabacCbfBase(cat) + ctx);
}

I64 H264CabacResidual(CH264Dec *d, I64 cat, I16 *blk, U8 *scan, I64 max_coeff)
{//Levels arrive highest frequency first. Returns the coefficient count.
	CH264Cabac	*c = &d->cabac;
	I64			 sig = H264CabacSigBase(cat), last = H264CabacLastBase(cat);
	I64			 abs = H264CabacAbsBase(cat), sctx, lctx;
	I64			 idx[64], count = 0, i, node = 0, level, j, k, bits;
	I64			 ctx, trans1[8], transg[8], ctx1[8], ctxg[8];

	//node ctx: 0..3 while every level so far is one, 4..7 after a larger one.
	ctx1[0] = 1;	ctx1[1] = 2;	ctx1[2] = 3;	ctx1[3] = 4;
	ctx1[4] = 0;	ctx1[5] = 0;	ctx1[6] = 0;	ctx1[7] = 0;
	ctxg[0] = 5;	ctxg[1] = 5;	ctxg[2] = 5;	ctxg[3] = 5;
	ctxg[4] = 6;	ctxg[5] = 7;	ctxg[6] = 8;	ctxg[7] = 9;
	trans1[0] = 1;	trans1[1] = 2;	trans1[2] = 3;	trans1[3] = 3;
	trans1[4] = 4;	trans1[5] = 5;	trans1[6] = 6;	trans1[7] = 7;
	transg[0] = 4;	transg[1] = 4;	transg[2] = 4;	transg[3] = 4;
	transg[4] = 5;	transg[5] = 6;	transg[6] = 7;	transg[7] = 7;

	for (i = 0; i < max_coeff - 1; i++)
	{//An 8x8 block shares contexts between positions; the others map one to one.
		sctx = i;
		lctx = i;
		if (cat == 5)
		{
			sctx = h264_cabac_sig8x8[i];
			lctx = h264_cabac_last8x8[i];
		}
		if (H264CabacDec(c, sig + sctx))
		{
			idx[count] = i;
			count++;
			if (H264CabacDec(c, last + lctx))
			{
				i = max_coeff;
				goto sig_done;
			}
		}
	}
	if (i == max_coeff - 1)
	{
		idx[count] = i;
		count++;
	}
sig_done:
	if (!count)
		return 0;

	i = count;
	while (i)
	{
		i--;
		j   = scan[idx[i]];
		ctx = abs + ctx1[node];
		if (!H264CabacDec(c, ctx))
		{
			node  = trans1[node];
			level = 1;
		}
		else
		{
			level = 2;
			ctx   = abs + ctxg[node];
			node  = transg[node];
			while (level < 15 && H264CabacDec(c, ctx))
				level++;
			if (level >= 15)
			{//Exp-Golomb suffix in bypass mode.
				bits = 0;
				while (H264CabacBypass(c) && bits < 23)
					bits++;
				level = 1;
				for (k = 0; k < bits; k++)
					level = level + level + H264CabacBypass(c);
				level += 14;
			}
		}
		if (H264CabacBypass(c))
			level = -level;
		blk[j] = level;
	}

	return count;
}

I64 H264NzAt(CH264Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 scale,
			 Bool intra)
{//A block that does not exist counts as coded for an intra macroblock and as
//uncoded for an inter one.
	if (x < 0 || y < 0 || !H264NeighbourOk(d, x / scale, y / scale))
		return ToI64(intra);

	return ToI64(plane[y * stride + x] != 0);
}

U0 H264ReconLumaRes(CH264Dec *d, I64 cbp_luma)
{
	I64	 st = d->stride[0], blk, x4, y4;
	U8	*dst;

	for (blk = 0; blk < 16; blk++)
	{
		if (!(cbp_luma & 1 << (blk >> 2)))
			goto next_res;
		x4  = d->mb_x * 4 + H264Blk4x4X(blk);
		y4  = d->mb_y * 4 + H264Blk4x4Y(blk);
		dst = d->pic[0] + y4 * 4 * st + x4 * 4;
		H264Dequant(d->blk + 16 + blk * 16, d->qp, 0);
		H264Idct4x4(dst, st, d->blk + 16 + blk * 16);
next_res:;
	}
}

U0 H264ReconLuma8Res(CH264Dec *d, I64 cbp_luma)
{
	I64	 st = d->stride[0], i8, x4, y4;
	U8	*dst;

	for (i8 = 0; i8 < 4; i8++)
	{
		if (!(cbp_luma & 1 << i8))
			goto next_res8;
		x4  = d->mb_x * 4 + (i8 & 1) * 2;
		y4  = d->mb_y * 4 + (i8 >> 1) * 2;
		dst = d->pic[0] + y4 * 4 * st + x4 * 4;
		H264Dequant8(d->blk + 16 + i8 * 64, d->qp);
		H264Idct8x8(dst, st, d->blk + 16 + i8 * 64);
next_res8:;
	}
}

U0 H264ReconChromaRes(CH264Dec *d, I64 cbp_chroma)
{
	I64	 pl, blk, st, qp, off;
	U8	*dst;

	if (!cbp_chroma)
		return;
	for (pl = 0; pl < 2; pl++)
	{
		H264ChromaDC(d, pl);
		st = d->stride[1 + pl];
		qp = H264ChromaQP(d, pl);
		for (blk = 0; blk < 4; blk++)
		{
			off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
			if (cbp_chroma > 1)
				H264Dequant(d->blk + off, qp, 1);
			dst = d->pic[1 + pl] + (d->mb_y * 8 + (blk >> 1) * 4) * st +
				  d->mb_x * 8 + (blk & 1) * 4;
			H264Idct4x4(dst, st, d->blk + off);
		}
	}
}

Bool H264ResidualPCabac(CH264Dec *d, I64 cbp_luma, I64 cbp_chroma)
{//No luma DC, and an 8x8 block carries no coded block flag in 4:2:0.
	I64	 stride = d->mb_w * 4, cstride = d->mb_w * 2;
	I64	 i = d->mb_y * d->mb_w + d->mb_x;
	I64	 blk, t, x4, y4, x2, y2, nza, nzb, off, n, pl;

	if (d->tx8x8)
	{
		for (t = 0; t < 4; t++)
		{
			if (!(cbp_luma & 1 << t))
				goto next_p8;
			n = H264CabacResidual(d, 5, d->blk + 16 + t * 64, h264_zigzag8, 64);
			for (blk = 0; blk < 4; blk++)
			{
				x4 = d->mb_x * 4 + H264Blk4x4X(t * 4 + blk);
				y4 = d->mb_y * 4 + H264Blk4x4Y(t * 4 + blk);
				d->nnz[y4 * stride + x4] = n;
			}
next_p8:;
		}
	}
	else
		for (blk = 0; blk < 16; blk++)
		{
			if (!(cbp_luma & 1 << (blk >> 2)))
				goto next_p4;
			x4  = d->mb_x * 4 + H264Blk4x4X(blk);
			y4  = d->mb_y * 4 + H264Blk4x4Y(blk);
			nza = H264NzAt(d, d->nnz, stride, x4 - 1, y4, 4, FALSE);
			nzb = H264NzAt(d, d->nnz, stride, x4, y4 - 1, 4, FALSE);
			off = 16 + blk * 16;
			if (H264CabacCbf(d, 2, nza, nzb))
				d->nnz[y4 * stride + x4] =
					H264CabacResidual(d, 2, d->blk + off, h264_zigzag4, 16);
next_p4:;
		}

	if (cbp_chroma)
		for (pl = 0; pl < 2; pl++)
		{
			nza = ToI64((H264MbCbp(d, d->mb_x - 1, d->mb_y, FALSE) & 0x40 << pl) != 0);
			nzb = ToI64((H264MbCbp(d, d->mb_x, d->mb_y - 1, FALSE) & 0x40 << pl) != 0);
			if (!H264CabacCbf(d, 3, nza, nzb))
				goto next_pdc;
			off = 16 + 256 + pl * 4;
			n   = H264CabacResidual(d, 3, d->blk + off, h264_chroma_dc_scan, 4);
			if (n)
				d->mb_cbp[i] |= 0x40 << pl;
next_pdc:;
		}
	if (cbp_chroma > 1)
		for (pl = 0; pl < 2; pl++)
			for (blk = 0; blk < 4; blk++)
			{
				x2  = d->mb_x * 2 + (blk & 1);
				y2  = d->mb_y * 2 + ((blk >> 1) & 1);
				nza = H264NzAt(d, d->nnz_c[pl], cstride, x2 - 1, y2, 2, FALSE);
				nzb = H264NzAt(d, d->nnz_c[pl], cstride, x2, y2 - 1, 2, FALSE);
				off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
				if (H264CabacCbf(d, 4, nza, nzb))
					d->nnz_c[pl][y2 * cstride + x2] =
						H264CabacResidual(d, 4, d->blk + off,
										  h264_zigzag4 + 1, 15);
			}

	return TRUE;
}

Bool H264MbIntraCavlc(CH264Dec *d, I64 mb_type)
{
	CH264Bits	*b = &d->b;
	I64			 stride = d->mb_w * 4, t, blk, x4, y4, pred, mode;
	I64			 cbp_luma = 0, cbp_chroma = 0, i, n;
	U8			*src;

	H264MvSet(d, d->mb_x * 4, d->mb_y * 4, 4, 4, -1, 0, 0, 0, 0, 0);
	if (mb_type > 25)
		return FALSE;
	MemSet(d->blk, 0, H264_BLK_COEFFS * sizeof(I16));
	i = d->mb_y * d->mb_w + d->mb_x;
	d->mb_slice[i]   = d->slice_id;
	d->mb_deblock[i] = d->sl.disable_deblock;
	d->mb_a[i]       = d->sl.alpha_off;
	d->mb_b[i]       = d->sl.beta_off;
	d->mb_qp[i]      = d->qp;
	d->mb_kind[i]    = H264_MB_I4X4;

	if (mb_type == 25)
	{//I_PCM: byte aligned samples, no residual coding at all.
		b->pos = (b->pos + 7) & -8;
		n = 256 + 2 * 64;
		if (b->pos + n * 8 > b->end)
			return FALSE;
		src = b->buf + (b->pos >> 3);
		b->pos += n * 8;
		for (i = 0; i < 16; i++)
			MemCopy(d->pic[0] + (d->mb_y * 16 + i) * d->stride[0] +
				   d->mb_x * 16, src + i * 16, 16);
		for (t = 0; t < 2; t++)
			for (i = 0; i < 8; i++)
				MemCopy(d->pic[1 + t] + (d->mb_y * 8 + i) * d->stride[1 + t] +
					   d->mb_x * 8, src + 256 + t * 64 + i * 8, 8);
		d->mb_qp[d->mb_y * d->mb_w + d->mb_x] = 0;
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->nnz[y4 * stride + x4] = 16;
			d->modes[y4 * stride + x4] = 2;
		}
		return TRUE;
	}

	d->tx8x8 = FALSE;
	if (!mb_type)
	{//I_NxN: a prediction mode per 4x4 (or 8x8) block.
		if (d->pps->transform_8x8)
			d->tx8x8 = ToBool(H264Read(b, 1));
		n = 16;
		if (d->tx8x8)
			n = 4;
		for (i = 0; i < n; i++)
		{
			blk = i;
			if (d->tx8x8)
				blk = i * 4;
			x4   = d->mb_x * 4 + H264Blk4x4X(blk);
			y4   = d->mb_y * 4 + H264Blk4x4Y(blk);
			pred = H264PredIntraMode(d, x4, y4);
			mode = pred;
			if (!H264Read(b, 1))
			{
				mode = H264Read(b, 3);
				if (mode >= pred)
					mode++;
			}
			if (d->tx8x8)
			{//One mode covers the four 4x4 blocks of an 8x8.
				for (t = 0; t < 4; t++)
				{
					x4 = d->mb_x * 4 + H264Blk4x4X(blk + t);
					y4 = d->mb_y * 4 + H264Blk4x4Y(blk + t);
					d->modes[y4 * stride + x4] = mode;
				}
			}
			else
				d->modes[y4 * stride + x4] = mode;
		}
	}
	else
	{//I_16x16 packs the prediction mode and the pattern into the type.
		t = mb_type - 1;
		d->i16_mode = t & 3;
		cbp_chroma  = (t / 4) % 3;
		if (t >= 12)
			cbp_luma = 15;
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->modes[y4 * stride + x4] = 2;
		}
	}
	d->chroma_mode = H264ReadUE(b);
	if (d->chroma_mode > 3)
		return FALSE;

	if (!mb_type)
	{
		n = H264ReadUE(b);
		if (n > 47)
			return FALSE;
		d->cbp     = h264_golomb_to_intra_cbp[n];
		cbp_luma   = d->cbp & 15;
		cbp_chroma = d->cbp >> 4;
	}

	if (cbp_luma || cbp_chroma || mb_type)
	{
		d->qp += H264ReadSE(b);
		d->qp = (d->qp + 52) % 52;
		d->mb_qp[d->mb_y * d->mb_w + d->mb_x] = d->qp;
		if (!H264ResidualLuma(d, cbp_luma, ToBool(mb_type)))
			return FALSE;
		if (!H264ResidualChroma(d, cbp_chroma))
			return FALSE;
	}
	else
	{
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->nnz[y4 * stride + x4] = 0;
		}
		H264ResidualChroma(d, 0);
	}
	if (b->eof)
		return FALSE;
	if (d->tx8x8)
		return FALSE;			//8x8 transform reconstruction is absent.
	H264ReconLuma(d, mb_type, cbp_luma);
	H264ReconChroma(d, cbp_chroma);

	return TRUE;
}

Bool H264MbIntraCabac(CH264Dec *d, I64 mb_type)
{
	I64	 stride = d->mb_w * 4, cstride = d->mb_w * 2;
	I64	 i = d->mb_y * d->mb_w + d->mb_x;
	I64	 t, blk, x4, y4, x2, y2, pred, mode, n, pl, off, nza, nzb;
	I64	 cbp_luma = 0, cbp_chroma = 0, cbp = 0, bits;
	U8	*src;

	MemSet(d->blk, 0, H264_BLK_COEFFS * sizeof(I16));
	d->mb_slice[i]   = d->slice_id;
	d->mb_deblock[i] = d->sl.disable_deblock;
	d->mb_a[i]       = d->sl.alpha_off;
	d->mb_b[i]       = d->sl.beta_off;
	d->mb_qp[i]      = d->qp;
	d->mb_cmode[i]   = 0;
	d->mb_cbp[i]     = 0;
	//Cleared first: blocks of this macroblock are each other's neighbours, and
	//a block the pattern skips must read as uncoded.
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		d->nnz[y4 * stride + x4] = 0;
	}
	for (pl = 0; pl < 2; pl++)
		for (blk = 0; blk < 4; blk++)
		{
			x2 = d->mb_x * 2 + (blk & 1);
			y2 = d->mb_y * 2 + ((blk >> 1) & 1);
			d->nnz_c[pl][y2 * cstride + x2] = 0;
		}

	H264MvSet(d, d->mb_x * 4, d->mb_y * 4, 4, 4, -1, 0, 0, 0, 0, 0);
	if (mb_type == 25)
	{//I_PCM: samples byte aligned in the bitstream, then the engine restarts.
		d->mb_kind[i] = H264_MB_IPCM;
		d->mb_cbp[i]  = 0x7CF;
		d->mb_qp[i]   = 0;
		bits = d->cabac.pos;
		n    = 256 + 2 * 64;
		if (((bits + 7) & -8) + n * 8 > d->cabac.end)
			return FALSE;
		src = d->cabac.buf + (((bits + 7) & -8) >> 3);
		for (t = 0; t < 16; t++)
			MemCopy(d->pic[0] + (d->mb_y * 16 + t) * d->stride[0] +
					d->mb_x * 16, src + t * 16, 16);
		for (pl = 0; pl < 2; pl++)
			for (t = 0; t < 8; t++)
				MemCopy(d->pic[1 + pl] + (d->mb_y * 8 + t) * d->stride[1 + pl] +
						d->mb_x * 8, src + 256 + pl * 64 + t * 8, 8);
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->nnz[y4 * stride + x4]   = 16;
			d->modes[y4 * stride + x4] = 2;
		}
		for (pl = 0; pl < 2; pl++)
			for (blk = 0; blk < 4; blk++)
			{
				x2 = d->mb_x * 2 + (blk & 1);
				y2 = d->mb_y * 2 + ((blk >> 1) & 1);
				d->nnz_c[pl][y2 * cstride + x2] = 16;
			}
		H264CabacEngine(&d->cabac, ((bits + 7) & -8) + n * 8);
		d->last_qp_delta = 0;

		return TRUE;
	}

	d->tx8x8    = FALSE;
	d->mb_tx8[i] = 0;
	if (!mb_type)
	{
		d->mb_kind[i] = H264_MB_I4X4;
		if (d->pps->transform_8x8)
		{
			d->tx8x8     = ToBool(H264CabacTx8(d));
			d->mb_tx8[i] = d->tx8x8;
		}
		n = 16;
		if (d->tx8x8)
			n = 4;
		for (t = 0; t < n; t++)
		{
			blk = t;
			if (d->tx8x8)
				blk = t * 4;
			x4   = d->mb_x * 4 + H264Blk4x4X(blk);
			y4   = d->mb_y * 4 + H264Blk4x4Y(blk);
			pred = H264PredIntraMode(d, x4, y4);
			mode = H264CabacIntraMode(d, pred);
			if (!d->tx8x8)
			{
				d->modes[y4 * stride + x4] = mode;
				goto next_mode;
			}
			for (n = 0; n < 4; n++)
			{
				x4 = d->mb_x * 4 + H264Blk4x4X(blk + n);
				y4 = d->mb_y * 4 + H264Blk4x4Y(blk + n);
				d->modes[y4 * stride + x4] = mode;
			}
			n = 4;
next_mode:;
		}
	}
	else
	{
		d->mb_kind[i] = H264_MB_I16X16;
		t = mb_type - 1;
		d->i16_mode = t & 3;
		cbp_chroma  = (t / 4) % 3;
		if (t >= 12)
			cbp_luma = 15;
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->modes[y4 * stride + x4] = 2;
		}
	}
	d->chroma_mode = H264CabacChromaMode(d);
	d->mb_cmode[i] = d->chroma_mode;

	if (!mb_type)
	{
		cbp_luma   = H264CabacCbpLuma(d, TRUE);
		cbp_chroma = H264CabacCbpChroma(d, TRUE);
	}
	cbp = cbp_luma | cbp_chroma << 4;
	d->mb_cbp[i] = cbp;

	if (!cbp_luma && !cbp_chroma && !mb_type)
	{
		d->last_qp_delta = 0;
		goto mb_recon;
	}
	H264CabacQpDelta(d);
	d->mb_qp[i] = d->qp;

	if (mb_type)
	{//Luma DC, then the AC blocks the pattern selects.
		nza = ToI64((H264MbCbp(d, d->mb_x - 1, d->mb_y, TRUE) & 0x100) != 0);
		nzb = ToI64((H264MbCbp(d, d->mb_x, d->mb_y - 1, TRUE) & 0x100) != 0);
		if (H264CabacCbf(d, 0, nza, nzb))
		{
			n = H264CabacResidual(d, 0, d->blk, h264_zigzag4, 16);
			if (n)
				d->mb_cbp[i] |= 0x100;
		}
	}
	if (d->tx8x8)
	{//One 64 coefficient block per 8x8, always coded when the pattern says so.
		for (t = 0; t < 4; t++)
		{
			if (!(cbp_luma & 1 << t))
				goto next_8x8;
			n = H264CabacResidual(d, 5, d->blk + 16 + t * 64, h264_zigzag8, 64);
			for (blk = 0; blk < 4; blk++)
			{
				x4 = d->mb_x * 4 + H264Blk4x4X(t * 4 + blk);
				y4 = d->mb_y * 4 + H264Blk4x4Y(t * 4 + blk);
				d->nnz[y4 * stride + x4] = n;
			}
next_8x8:;
		}
		goto luma_done;
	}
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		if (!(cbp_luma & 1 << (blk >> 2)))
			goto next_luma;
		nza = H264NzAt(d, d->nnz, stride, x4 - 1, y4, 4, TRUE);
		nzb = H264NzAt(d, d->nnz, stride, x4, y4 - 1, 4, TRUE);
		off = 16 + blk * 16;
		if (mb_type)
		{
			if (H264CabacCbf(d, 1, nza, nzb))
				d->nnz[y4 * stride + x4] =
					H264CabacResidual(d, 1, d->blk + off, h264_zigzag4 + 1, 15);
		}
		else
		{
			if (H264CabacCbf(d, 2, nza, nzb))
				d->nnz[y4 * stride + x4] =
					H264CabacResidual(d, 2, d->blk + off, h264_zigzag4, 16);
		}
next_luma:;
	}
luma_done:

	if (cbp_chroma)
	{//Chroma DC per plane, then the AC blocks when the pattern says 2.
		for (pl = 0; pl < 2; pl++)
		{
			nza = ToI64((H264MbCbp(d, d->mb_x - 1, d->mb_y, TRUE) & 0x40 << pl) != 0);
			nzb = ToI64((H264MbCbp(d, d->mb_x, d->mb_y - 1, TRUE) & 0x40 << pl) != 0);
			if (!H264CabacCbf(d, 3, nza, nzb))
				goto next_cdc;
			off = 16 + 256 + pl * 4;
			n   = H264CabacResidual(d, 3, d->blk + off, h264_chroma_dc_scan, 4);
			if (n)
				d->mb_cbp[i] |= 0x40 << pl;
next_cdc:;
		}
	}
	if (cbp_chroma > 1)
		for (pl = 0; pl < 2; pl++)
			for (blk = 0; blk < 4; blk++)
			{
				x2  = d->mb_x * 2 + (blk & 1);
				y2  = d->mb_y * 2 + ((blk >> 1) & 1);
				nza = H264NzAt(d, d->nnz_c[pl], cstride, x2 - 1, y2, 2, TRUE);
				nzb = H264NzAt(d, d->nnz_c[pl], cstride, x2, y2 - 1, 2, TRUE);
				off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
				if (H264CabacCbf(d, 4, nza, nzb))
					d->nnz_c[pl][y2 * cstride + x2] =
						H264CabacResidual(d, 4, d->blk + off,
										  h264_zigzag4 + 1, 15);
			}

mb_recon:
	if (d->tx8x8)
		H264ReconLuma8(d, cbp_luma);
	else
		H264ReconLuma(d, mb_type, cbp_luma);
	H264ReconChroma(d, cbp_chroma);

	return TRUE;
}

/***** deblocking filter *****/

I64 H264ClipTc(I64 v, I64 tc)
{
	if (v < -tc)
		return -tc;
	if (v > tc)
		return tc;

	return v;
}

U0 H264FilterLuma(U8 *pix, I64 xs, I64 ys, I64 alpha, I64 beta, I64 tc0)
{//ffmpeg h264_loop_filter_luma, four samples of one edge. bS below 4: one
//sample either side moves, two when the neighbouring sample is flat enough.
	I64 d, p0, p1, p2, q0, q1, q2, tc, delta;

	if (tc0 < 0)
		return;
	for (d = 0; d < 4; d++)
	{
		p0 = pix[-xs];
		p1 = pix[-2 * xs];
		p2 = pix[-3 * xs];
		q0 = pix[0];
		q1 = pix[xs];
		q2 = pix[2 * xs];
		if (AbsI64(p0 - q0) < alpha && AbsI64(p1 - p0) < beta &&
			AbsI64(q1 - q0) < beta)
		{
			tc = tc0;
			if (AbsI64(p2 - p0) < beta)
			{
				if (tc0)
					pix[-2 * xs] = p1 + H264ClipTc(
						((p2 + ((p0 + q0 + 1) >> 1)) >> 1) - p1, tc0);
				tc++;
			}
			if (AbsI64(q2 - q0) < beta)
			{
				if (tc0)
					pix[xs] = q1 + H264ClipTc(
						((q2 + ((p0 + q0 + 1) >> 1)) >> 1) - q1, tc0);
				tc++;
			}
			delta = H264ClipTc(((q0 - p0) * 4 + (p1 - q1) + 4) >> 3, tc);
			pix[-xs] = H264Clip(p0 + delta);
			pix[0]   = H264Clip(q0 - delta);
		}
		pix += ys;
	}
}

U0 H264FilterLumaIntra(U8 *pix, I64 xs, I64 ys, I64 alpha, I64 beta)
{//bS 4: up to three samples either side move.
	I64 d, p0, p1, p2, p3, q0, q1, q2, q3;

	for (d = 0; d < 4; d++)
	{
		p0 = pix[-xs];
		p1 = pix[-2 * xs];
		p2 = pix[-3 * xs];
		q0 = pix[0];
		q1 = pix[xs];
		q2 = pix[2 * xs];
		if (AbsI64(p0 - q0) < alpha && AbsI64(p1 - p0) < beta &&
			AbsI64(q1 - q0) < beta)
		{
			if (AbsI64(p0 - q0) < (alpha >> 2) + 2)
			{
				if (AbsI64(p2 - p0) < beta)
				{
					p3 = pix[-4 * xs];
					pix[-xs]     = (p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3;
					pix[-2 * xs] = (p2 + p1 + p0 + q0 + 2) >> 2;
					pix[-3 * xs] = (2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3;
				}
				else
					pix[-xs] = (2 * p1 + p0 + q1 + 2) >> 2;
				if (AbsI64(q2 - q0) < beta)
				{
					q3 = pix[3 * xs];
					pix[0]      = (p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3;
					pix[xs]     = (p0 + q0 + q1 + q2 + 2) >> 2;
					pix[2 * xs] = (2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3;
				}
				else
					pix[0] = (2 * q1 + q0 + p1 + 2) >> 2;
			}
			else
			{
				pix[-xs] = (2 * p1 + p0 + q1 + 2) >> 2;
				pix[0]   = (2 * q1 + q0 + p1 + 2) >> 2;
			}
		}
		pix += ys;
	}
}

U0 H264FilterChroma(U8 *pix, I64 xs, I64 ys, I64 alpha, I64 beta, I64 tc)
{
	I64 d, p0, p1, q0, q1, delta;

	if (tc <= 0)
		return;
	for (d = 0; d < 2; d++)
	{
		p0 = pix[-xs];
		p1 = pix[-2 * xs];
		q0 = pix[0];
		q1 = pix[xs];
		if (AbsI64(p0 - q0) < alpha && AbsI64(p1 - p0) < beta &&
			AbsI64(q1 - q0) < beta)
		{
			delta = H264ClipTc(((q0 - p0) * 4 + (p1 - q1) + 4) >> 3, tc);
			pix[-xs] = H264Clip(p0 + delta);
			pix[0]   = H264Clip(q0 - delta);
		}
		pix += ys;
	}
}

U0 H264FilterChromaIntra(U8 *pix, I64 xs, I64 ys, I64 alpha, I64 beta)
{
	I64 d, p0, p1, q0, q1;

	for (d = 0; d < 2; d++)
	{
		p0 = pix[-xs];
		p1 = pix[-2 * xs];
		q0 = pix[0];
		q1 = pix[xs];
		if (AbsI64(p0 - q0) < alpha && AbsI64(p1 - p0) < beta &&
			AbsI64(q1 - q0) < beta)
		{
			pix[-xs] = (2 * p1 + p0 + q1 + 2) >> 2;
			pix[0]   = (2 * q1 + q0 + p1 + 2) >> 2;
		}
		pix += ys;
	}
}

I64 H264QPIndex(I64 qp, I64 off)
{
	I64 i = qp + off;

	if (i < 0)
		return 0;
	if (i > 51)
		return 51;

	return i;
}

U0 H264FilterEdge(CH264Dec *d, I64 plane, I64 px, I64 py, I64 dir, I64 qp,
				  I64 *bs, I64 a_off, I64 b_off)
{//dir 0 is a vertical edge. bs is per group of four luma samples, two chroma.
	I64	 st = d->stride[plane], xs = 1, ys = st, k, step = 4;
	I64	 ia = H264QPIndex(qp, a_off), ib = H264QPIndex(qp, b_off);
	I64	 alpha = h264_alpha[ia], beta = h264_beta[ib], tc0;
	U8	*pix = d->pic[plane] + py * st + px;

	if (!alpha || !beta)
		return;
	if (dir)
	{
		xs = st;
		ys = 1;
	}
	if (plane)
		step = 2;
	for (k = 0; k < 4; k++)
	{
		if (!bs[k])
			goto next_group;
		if (bs[k] >= 4)
		{//tc0 carries a column per strength 1..3 only.
			if (!plane)
				H264FilterLumaIntra(pix, xs, ys, alpha, beta);
			else
				H264FilterChromaIntra(pix, xs, ys, alpha, beta);
			goto next_group;
		}
		tc0 = h264_tc0[ia * 4 + bs[k]];
		if (!plane)
			H264FilterLuma(pix, xs, ys, alpha, beta, tc0);
		else
			H264FilterChroma(pix, xs, ys, alpha, beta, tc0 + 1);
next_group:
		pix += step * ys;
	}
}

Bool H264MbIsIntra(CH264Dec *d, I64 i)
{
	return ToBool(d->mb_kind[i] && d->mb_kind[i] <= H264_MB_IPCM);
}

CH264Frame *H264EdgeRef(CH264Dec *d, I64 i, I64 list)
{//The picture a block predicts from, NULL where the list is unused. Two lists
//can name the same picture through different indices, so 8.7.2.1 compares
//pictures rather than indices.
	I64 r;

	if (list)
	{
		r = d->refidx1[i];
		if (r < 0 || r >= d->ref1_count)
			return NULL;

		return d->ref1[r];
	}
	r = d->refidx[i];
	if (r < 0 || r >= d->ref0_count)
		return NULL;

	return d->ref0[r];
}

Bool H264MvFar(I64 ax, I64 ay, I64 bx, I64 by)
{
	return ToBool(AbsI64(ax - bx) >= 4 || AbsI64(ay - by) >= 4);
}

Bool H264EdgeMotion(CH264Dec *d, I64 i, I64 j, Bool bi)
{//8.7.2.1: strength 1 when the two blocks disagree about reference or motion.
//A bi predicted pair that names the same two pictures in opposite lists is
//compared both ways round.
	CH264Frame	*a0 = H264EdgeRef(d, i, 0), *b0 = H264EdgeRef(d, j, 0);
	CH264Frame	*a1, *b1;
	Bool		 v;

	v = ToBool(a0 != b0);
	if (!v && a0)
		v = H264MvFar(d->mvx[i], d->mvy[i], d->mvx[j], d->mvy[j]);
	if (!bi)
		return v;
	a1 = H264EdgeRef(d, i, 1);
	b1 = H264EdgeRef(d, j, 1);
	if (!v)
		v = ToBool(a1 != b1 ||
				   H264MvFar(d->mvx1[i], d->mvy1[i], d->mvx1[j], d->mvy1[j]));
	if (!v)
		return FALSE;
	if (a0 != b1 || a1 != b0)
		return TRUE;

	return ToBool(H264MvFar(d->mvx[i], d->mvy[i], d->mvx1[j], d->mvy1[j]) ||
				  H264MvFar(d->mvx1[i], d->mvy1[i], d->mvx[j], d->mvy[j]));
}

U0 H264EdgeStrength(CH264Dec *d, I64 x4, I64 y4, I64 dir, I64 *bs)
{//8.7.2.1, inter blocks: coefficients, then reference and motion.
	I64		stride = d->mb_w * 4, k, i, j;
	Bool	bi = ToBool(d->sl.type == H264_SLICE_B);

	for (k = 0; k < 4; k++)
	{
		if (dir)
		{
			i = y4 * stride + x4 + k;
			j = i - stride;
		}
		else
		{
			i = (y4 + k) * stride + x4;
			j = i - 1;
		}
		if (d->nnz[i] || d->nnz[j])
		{
			bs[k] = 2;
			goto next_bs;
		}
		bs[k] = 0;
		if (H264EdgeMotion(d, i, j, bi))
			bs[k] = 1;
next_bs:;
	}
}

U0 H264FilterMb(CH264Dec *d, I64 mb_x, I64 mb_y)
{//8.7.2.1. Intra either side is strength 4 across a macroblock edge, 3 inside.
	I64 i = mb_y * d->mb_w + mb_x, qp = d->mb_qp[i], nqp = qp;
	I64 a = d->mb_a[i], b = d->mb_b[i];
	I64 dir, edge, pl, ni, eqp, cqp, off, bs[4], k, x4, y4;

	if (d->mb_deblock[i] == 1)
		return;
	for (dir = 0; dir < 2; dir++)
		for (edge = 0; edge < 4; edge++)
		{
			eqp = qp;
			ni  = i;
			if (edge & 1 && d->mb_tx8[i])
				goto next_edge;
			if (!edge)
			{
				ni = i - 1;
				if (dir)
					ni = i - d->mb_w;
				if (!dir && !mb_x || dir && !mb_y)
					goto next_edge;
				if (d->mb_deblock[i] == 2 && d->mb_slice[ni] != d->mb_slice[i])
					goto next_edge;
				nqp = d->mb_qp[ni];
				eqp = (qp + nqp + 1) >> 1;
			}
			x4 = mb_x * 4;
			y4 = mb_y * 4;
			if (dir)
				y4 += edge;
			else
				x4 += edge;
			if (H264MbIsIntra(d, i) || H264MbIsIntra(d, ni))
			{
				k = 3;
				if (!edge)
					k = 4;
				bs[0] = k;
				bs[1] = k;
				bs[2] = k;
				bs[3] = k;
			}
			else
				H264EdgeStrength(d, x4, y4, dir, bs);
			if (!bs[0] && !bs[1] && !bs[2] && !bs[3])
				goto next_edge;
			if (dir)
				H264FilterEdge(d, 0, mb_x * 16, mb_y * 16 + edge * 4, 1, eqp,
							   bs, a, b);
			else
				H264FilterEdge(d, 0, mb_x * 16 + edge * 4, mb_y * 16, 0, eqp,
							   bs, a, b);
			//Chroma is filtered on every second luma edge.
			if (edge & 1)
				goto next_edge;
			for (pl = 0; pl < 2; pl++)
			{
				off = d->pps->chroma_qp_off;
				if (pl)
					off = d->pps->chroma_qp_off2;
				cqp = h264_chroma_qp[H264QPIndex(qp, off)];
				if (!edge)
					cqp = (cqp + h264_chroma_qp[H264QPIndex(nqp, off)] + 1) >> 1;
				if (dir)
					H264FilterEdge(d, 1 + pl, mb_x * 8, mb_y * 8 + edge * 2, 1,
								   cqp, bs, a, b);
				else
					H264FilterEdge(d, 1 + pl, mb_x * 8 + edge * 2, mb_y * 8, 0,
								   cqp, bs, a, b);
			}
next_edge:;
		}
}
I64 H264CabacSkip(CH264Dec *d)
{//mb_skip_flag: the context counts neighbours that were not skipped.
	I64 ctx = 0, i = d->mb_y * d->mb_w + d->mb_x;

	if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y) &&
		d->mb_kind[i - 1] != H264_MB_SKIP)
		ctx++;
	if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1) &&
		d->mb_kind[i - d->mb_w] != H264_MB_SKIP)
		ctx++;

	return H264CabacDec(&d->cabac, 11 + ctx);
}

I64 H264CabacMbTypeP(CH264Dec *d)
{//0..4 are the P types, 5 and above an intra type offset by five, which is
//the numbering the CAVLC form uses too.
	CH264Cabac	*c = &d->cabac;
	I64			 t;

	if (H264CabacDec(c, 14))
		return H264CabacIntraType(d, 17, FALSE) + 5;
	if (!H264CabacDec(c, 15))
		return 3 * H264CabacDec(c, 16);
	t = H264CabacDec(c, 17);

	return 2 - t;
}

I64 H264CabacSubType(CH264Dec *d)
{//0 8x8, 1 8x4, 2 4x8, 3 4x4.
	CH264Cabac *c = &d->cabac;

	if (H264CabacDec(c, 21))
		return 0;
	if (!H264CabacDec(c, 22))
		return 1;
	if (H264CabacDec(c, 23))
		return 2;

	return 3;
}

I64 H264BlkDirect(CH264Dec *d, I64 x4, I64 y4)
{
	I64 stride = d->mb_w * 4;

	if (x4 < 0 || y4 < 0 || x4 >= stride || y4 >= d->mb_h * 4)
		return 0;

	return d->blk_direct[y4 * stride + x4];
}

I64 H264CabacRefIdx(CH264Dec *d, I64 x4, I64 y4, I64 list)
{//9.3.3.1.1.6. In a B slice a neighbour predicted by direct mode does not
//count, whatever its reference index.
	I64		ctx = 0, ref = 0, ra, rb, z, mx, my;
	Bool	b = ToBool(d->sl.type == H264_SLICE_B);

	z  = H264ZOf(x4 & 3, y4 & 3);
	ra = H264MvAt(d, x4 - 1, y4, z, list, &mx, &my);
	rb = H264MvAt(d, x4, y4 - 1, z, list, &mx, &my);
	if (ra > 0 && !(b && H264BlkDirect(d, x4 - 1, y4)))
		ctx++;
	if (rb > 0 && !(b && H264BlkDirect(d, x4, y4 - 1)))
		ctx += 2;
	while (H264CabacDec(&d->cabac, 54 + ctx))
	{
		ref++;
		ctx = (ctx >> 2) + 4;
		if (ref >= 32)
			return 0;
	}

	return ref;
}

I64 H264CabacMvd(CH264Dec *d, I64 base, I64 amvd)
{//9.3.2.3, the mvd magnitude in a unary prefix and a bypass suffix.
	CH264Cabac	*c = &d->cabac;
	I64			 ctx = 0, mvd, k;

	if (amvd >= 3)
		ctx = 1;
	if (amvd > 32)
		ctx = 2;
	if (!H264CabacDec(c, base + ctx))
		return 0;
	mvd = 1;
	ctx = 3;
	while (mvd < 9 && H264CabacDec(c, base + ctx))
	{
		if (mvd < 4)
			ctx++;
		mvd++;
	}
	if (mvd >= 9)
	{
		k = 3;
		while (H264CabacBypass(c) && k < 20)
		{
			mvd += 1 << k;
			k++;
		}
		while (k)
		{
			k--;
			mvd += H264CabacBypass(c) << k;
		}
	}
	if (H264CabacBypass(c))
		return -mvd;

	return mvd;
}

I64 H264MvdAt(CH264Dec *d, I64 x4, I64 y4, I64 zcur, Bool vert, I64 list)
{//Magnitude of a neighbouring difference, zero where the block does not exist
//or has not been decoded yet.
	I64 stride = d->mb_w * 4, mx, my, i = y4 * stride + x4;

	if (H264MvAt(d, x4, y4, zcur, list, &mx, &my) == -2)
		return 0;
	if (list)
	{
		if (vert)
			return AbsI64(d->mvdy1[i]);

		return AbsI64(d->mvdx1[i]);
	}
	if (vert)
		return AbsI64(d->mvdy[i]);

	return AbsI64(d->mvdx[i]);
}

I64 H264MvdSum(CH264Dec *d, I64 x4, I64 y4, Bool vert, I64 list)
{//The context for a motion vector difference counts the neighbouring ones.
	I64 z = H264ZOf(x4 & 3, y4 & 3);

	return H264MvdAt(d, x4 - 1, y4, z, vert, list) +
		   H264MvdAt(d, x4, y4 - 1, z, vert, list);
}

I64 H264ReadTE(CH264Bits *b, I64 count)
{//te(v) over count values: nothing at all for one, one inverted bit for two,
//ue(v) beyond that.
	if (count <= 1)
		return 0;
	if (count == 2)
		return 1 - H264Read(b, 1);

	return H264ReadUE(b);
}

U0 H264MbPart(CH264Dec *d, Bool cabac, I64 x4, I64 y4, I64 bw4, I64 bh4,
			  I64 part, I64 ref)
{//One motion partition: the difference is read, added to the prediction, and
//the block is fetched from its reference.
	I64 px, py, dx, dy;

	H264MvPred(d, x4, y4, bw4, ref, part, 0, &px, &py);
	if (cabac)
	{
		dx = H264CabacMvd(d, 40, H264MvdSum(d, x4, y4, FALSE, 0));
		dy = H264CabacMvd(d, 47, H264MvdSum(d, x4, y4, TRUE, 0));
	}
	else
	{
		dx = H264ReadSE(&d->b);
		dy = H264ReadSE(&d->b);
	}
	H264MvSet(d, x4, y4, bw4, bh4, ref, px + dx, py + dy, dx, dy, 0);
	H264McBlock(d, x4, y4, bw4, bh4, ref, px + dx, py + dy, 0, -1);
}

/***** macroblock layer, B slices *****/

I64 H264CabacSkipB(CH264Dec *d)
{//mb_skip_flag for B, ctxIdxOffset 24. The context counts neighbours that were
//not skipped; B_Direct_16x16 is coded, so it counts. mb_type below asks a
//different question and counts neighbours that were not direct at all.
	I64 ctx = 0, i = d->mb_y * d->mb_w + d->mb_x;

	if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y) &&
		d->mb_kind[i - 1] != H264_MB_SKIP)
		ctx++;
	if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1) &&
		d->mb_kind[i - d->mb_w] != H264_MB_SKIP)
		ctx++;

	return H264CabacDec(&d->cabac, 24 + ctx);
}

I64 H264CabacMbTypeB(CH264Dec *d)
{//9.3.3.1.1.3, ctxIdxOffset 27. Returns 0..22, or an intra type offset by 23.
	CH264Cabac	*c = &d->cabac;
	I64			 ctx = 0, bits, i = d->mb_y * d->mb_w + d->mb_x;

	//The context counts neighbours that predicted something other than direct;
	//B_Skip is direct too.
	if (H264NeighbourOk(d, d->mb_x - 1, d->mb_y) &&
		d->mb_kind[i - 1] != H264_MB_SKIP &&
		d->mb_kind[i - 1] != H264_MB_DIRECT)
		ctx++;
	if (H264NeighbourOk(d, d->mb_x, d->mb_y - 1) &&
		d->mb_kind[i - d->mb_w] != H264_MB_SKIP &&
		d->mb_kind[i - d->mb_w] != H264_MB_DIRECT)
		ctx++;

	if (!H264CabacDec(c, 27 + ctx))
		return 0;					//B_Direct_16x16
	if (!H264CabacDec(c, 27 + 3))
		return 1 + H264CabacDec(c, 27 + 5);
	bits =  H264CabacDec(c, 27 + 4) << 3;
	bits |= H264CabacDec(c, 27 + 5) << 2;
	bits |= H264CabacDec(c, 27 + 5) << 1;
	bits |= H264CabacDec(c, 27 + 5);
	if (bits < 8)
		return bits + 3;
	if (bits == 13)
		return H264CabacIntraType(d, 32, FALSE) + 23;
	if (bits == 14)
		return 11;
	if (bits == 15)
		return 22;
	bits = (bits << 1) | H264CabacDec(c, 27 + 5);

	return bits - 4;
}

I64 H264CabacSubTypeB(CH264Dec *d)
{//9.3.3.1.1.3, ctxIdxOffset 36. Returns 0..12.
	CH264Cabac	*c = &d->cabac;
	I64			 t;

	if (!H264CabacDec(c, 36))
		return 0;					//B_Direct_8x8
	if (!H264CabacDec(c, 37))
		return 1 + H264CabacDec(c, 39);
	t = 3;
	if (H264CabacDec(c, 38))
	{
		if (H264CabacDec(c, 39))
			return 11 + H264CabacDec(c, 39);
		t += 4;
	}
	t += 2 * H264CabacDec(c, 39);
	t += H264CabacDec(c, 39);

	return t;
}

I64 H264MinPositive(I64 a, I64 b)
{//8.4.1.2.2: the smaller when both are references, otherwise whichever is.
	if (a >= 0 && b >= 0)
	{
		if (a < b)
			return a;
		return b;
	}
	if (a > b)
		return a;

	return b;
}

I64 H264RefAt(CH264Dec *d, I64 x4, I64 y4, I64 list)
{//Reference index of a neighbouring block, -1 when it does not predict from
//this list or does not exist.
	I64 stride = d->mb_w * 4;

	if (x4 < 0 || y4 < 0 || x4 >= stride || y4 >= d->mb_h * 4)
		return -1;
	if (!H264NeighbourOk(d, x4 >> 2, y4 >> 2))
		return -1;
	if (list)
		return d->refidx1[y4 * stride + x4];

	return d->refidx[y4 * stride + x4];
}

U0 H264ColAt(CH264Dec *d, I64 x4, I64 y4, I64 *_cx, I64 *_cy)
{//direct_8x8_inference_flag samples the colocated motion at the corner 4x4 of
//the 8x8 the block sits in, so a macroblock reads blocks 0, 3, 12 and 15.
	*_cx = x4;
	*_cy = y4;
	if (!d->sps->direct_8x8)
		return;
	*_cx = (x4 & ~3) + 3 * ((x4 & 3) >> 1);
	*_cy = (y4 & ~3) + 3 * ((y4 & 3) >> 1);
}

I64 H264ColToList0(CH264Dec *d, CH264Frame *col, I64 list, I64 ref)
{//8.4.1.2.3: the colocated block names its reference through the lists the
//colocated picture was decoded with; the same picture has to be found in this
//slice's list 0.
	I64 i, poc;

	if (ref < 0 || ref >= col->ref_pcount[list])
		return 0;
	poc = col->ref_poc[list * H264_REFS_MAX + ref];
	for (i = 0; i < d->ref0_count; i++)
		if (d->ref0[i]->poc == poc)
			return i;

	return 0;
}

I64 H264ClipI8(I64 v)
{
	if (v < -128)
		return -128;
	if (v > 127)
		return 127;

	return v;
}

U0 H264DirectTemporal(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4)
{//8.4.1.2.3. List 1 is always the colocated picture; list 0 is whatever the
//colocated block pointed at, with the vector scaled by the ratio of the two
//picture order count distances.
	CH264Frame	*col;
	I64			 stride = d->mb_w * 4, x, y, ci, cx, cy;
	I64			 cl, cr, mvcx, mvcy, r0, tb, td, tx, dsf, m0x, m0y;

	if (!d->ref1_count || !d->ref0_count)
		return;
	col = d->ref1[0];
	for (y = 0; y < bh4; y++)
		for (x = 0; x < bw4; x++)
		{
			H264ColAt(d, x4 + x, y4 + y, &cx, &cy);
			ci   = cy * stride + cx;
			cl   = 0;
			cr   = -1;
			mvcx = 0;
			mvcy = 0;
			if (col->refidx)
			{
				if (col->refidx[ci] >= 0)
				{
					cr   = col->refidx[ci];
					mvcx = col->mvx[ci];
					mvcy = col->mvy[ci];
				}
				else if (col->refidx1[ci] >= 0)
				{
					cl   = 1;
					cr   = col->refidx1[ci];
					mvcx = col->mvx1[ci];
					mvcy = col->mvy1[ci];
				}
			}
			r0 = 0;
			if (cr >= 0)
				r0 = H264ColToList0(d, col, cl, cr);
			if (r0 >= d->ref0_count)
				r0 = 0;
			m0x = mvcx;
			m0y = mvcy;
			td  = H264ClipI8(col->poc - d->ref0[r0]->poc);
			if (td)
			{
				tb  = H264ClipI8(d->poc - d->ref0[r0]->poc);
				tx  = (16384 + (AbsI64(td) >> 1)) / td;
				dsf = (tb * tx + 32) >> 6;
				if (dsf < -1024)
					dsf = -1024;
				if (dsf > 1023)
					dsf = 1023;
				m0x = (dsf * mvcx + 128) >> 8;
				m0y = (dsf * mvcy + 128) >> 8;
			}
			d->blk_direct[(y4 + y) * stride + x4 + x] = 1;
			H264MvSet(d, x4 + x, y4 + y, 1, 1, r0, m0x, m0y, 0, 0, 0);
			H264MvSet(d, x4 + x, y4 + y, 1, 1, 0, m0x - mvcx, m0y - mvcy,
					  0, 0, 1);
		}
}

U0 H264DirectSpatial(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4)
{//8.4.1.2.2. One reference pair for the whole macroblock, then a per 4x4
//override where the colocated block barely moved.
	CH264Frame	*col;
	I64			 mx0 = 0, my0 = 0, mx1 = 0, my1 = 0;
	I64			 r0, r1, bx4 = d->mb_x * 4, by4 = d->mb_y * 4;
	I64			 stride = d->mb_w * 4, x, y, ci, cx, cy, cx2, cy2;
	Bool		 zero = FALSE, colzero;

	//Neighbour C is above and to the right; when it does not exist D, above
	//and to the left, stands in. 8.4.1.3.2, the same substitution the motion
	//vector prediction makes.
	cx = bx4 + 4;
	cy = by4 - 1;
	if (cx >= stride || !H264NeighbourOk(d, cx >> 2, cy >> 2) || cy < 0)
	{
		cx = bx4 - 1;
		cy = by4 - 1;
	}
	r0 = H264MinPositive(H264RefAt(d, bx4 - 1, by4, 0),
		 H264MinPositive(H264RefAt(d, bx4, by4 - 1, 0),
						 H264RefAt(d, cx, cy, 0)));
	r1 = H264MinPositive(H264RefAt(d, bx4 - 1, by4, 1),
		 H264MinPositive(H264RefAt(d, bx4, by4 - 1, 1),
						 H264RefAt(d, cx, cy, 1)));
	if (r0 < 0 && r1 < 0)
	{
		r0   = 0;
		r1   = 0;
		zero = TRUE;
	}
	if (!zero)
	{
		if (r0 >= 0)
			H264MvPred(d, bx4, by4, 4, r0, 0, 0, &mx0, &my0);
		if (r1 >= 0)
			H264MvPred(d, bx4, by4, 4, r1, 0, 1, &mx1, &my1);
	}

	//Long term references are refused outright, so the colocated picture is
	//short term whenever it exists and no extra test is needed.
	col = NULL;
	if (d->ref1_count)
		col = d->ref1[0];
	for (y = 0; y < bh4; y++)
		for (x = 0; x < bw4; x++)
		{
			d->blk_direct[(y4 + y) * stride + x4 + x] = 1;
			colzero = FALSE;
			if (col && col->refidx)
			{
				H264ColAt(d, x4 + x, y4 + y, &cx2, &cy2);
				ci = cy2 * stride + cx2;
				//8.4.1.2.1: the colocated block's motion is its list 0 unless
				//list 0 is unused, and then its list 1. A colocated picture
				//that is itself a B has blocks of both kinds.
				if (col->refidx[ci] < 0)
				{
					if (!col->refidx1[ci] && AbsI64(col->mvx1[ci]) <= 1 &&
						AbsI64(col->mvy1[ci]) <= 1)
						colzero = TRUE;
				}
				else if (!col->refidx[ci] && AbsI64(col->mvx[ci]) <= 1 &&
						 AbsI64(col->mvy[ci]) <= 1)
					colzero = TRUE;
			}
			if (r0 < 0)
				H264MvSet(d, x4 + x, y4 + y, 1, 1, -1, 0, 0, 0, 0, 0);
			else if (colzero && !r0)
				H264MvSet(d, x4 + x, y4 + y, 1, 1, 0, 0, 0, 0, 0, 0);
			else
				H264MvSet(d, x4 + x, y4 + y, 1, 1, r0, mx0, my0, 0, 0, 0);
			if (r1 < 0)
				H264MvSet(d, x4 + x, y4 + y, 1, 1, -1, 0, 0, 0, 0, 1);
			else if (colzero && !r1)
				H264MvSet(d, x4 + x, y4 + y, 1, 1, 0, 0, 0, 0, 0, 1);
			else
				H264MvSet(d, x4 + x, y4 + y, 1, 1, r1, mx1, my1, 0, 0, 1);
		}
}

U0 H264Direct(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4)
{
	if (d->sl.direct_spatial)
		H264DirectSpatial(d, x4, y4, bw4, bh4);
	else
		H264DirectTemporal(d, x4, y4, bw4, bh4);
}

U0 H264DirectMc(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4)
{//Fetch what H264DirectSpatial decided, one 4x4 at a time: neighbouring
//blocks of a direct partition can hold different vectors.
	I64	 stride = d->mb_w * 4, x, y, i, w0;

	for (y = 0; y < bh4; y++)
		for (x = 0; x < bw4; x++)
		{
			i  = (y4 + y) * stride + x4 + x;
			w0 = -1;
			if (d->refidx[i] >= 0)
			{
				H264McBlock(d, x4 + x, y4 + y, 1, 1, d->refidx[i],
							d->mvx[i], d->mvy[i], 0, -1);
				w0 = H264BiWeight(d, d->refidx[i], d->refidx1[i]);
			}
			if (d->refidx1[i] >= 0)
				H264McBlock(d, x4 + x, y4 + y, 1, 1, d->refidx1[i],
							d->mvx1[i], d->mvy1[i], 1, w0);
		}
}

I64 H264RefIdxB(CH264Dec *d, Bool cabac, I64 x4, I64 y4, I64 bw4, I64 bh4,
				I64 nrefs, I64 list, I64 use)
{//A single active reference carries no bits: te() is empty and CABAC codes
//nothing at all. The index is stored before the next one is read, because the
//context for that one counts this partition.
	I64 ref = -1;

	if (use)
	{
		ref = 0;
		if (nrefs > 1)
		{
			if (cabac)
				ref = H264CabacRefIdx(d, x4, y4, list);
			else
				ref = H264ReadTE(&d->b, nrefs);
		}
	}
	H264MvSet(d, x4, y4, bw4, bh4, ref, 0, 0, 0, 0, list);

	return ref;
}

U0 H264MbMvdB(CH264Dec *d, Bool cabac, I64 x4, I64 y4, I64 bw4, I64 bh4,
			  I64 part, I64 ref, I64 list)
{//One list of one partition. 7.3.5.1 reads every list 0 difference before any
//list 1 difference, so prediction and fetch cannot be done in one pass.
	I64 px, py, dx, dy;

	if (ref < 0)
	{
		H264MvSet(d, x4, y4, bw4, bh4, -1, 0, 0, 0, 0, list);
		return;
	}
	H264MvPred(d, x4, y4, bw4, ref, part, list, &px, &py);
	if (cabac)
	{
		dx = H264CabacMvd(d, 40, H264MvdSum(d, x4, y4, FALSE, list));
		dy = H264CabacMvd(d, 47, H264MvdSum(d, x4, y4, TRUE, list));
	}
	else
	{
		dx = H264ReadSE(&d->b);
		dy = H264ReadSE(&d->b);
	}
	H264MvSet(d, x4, y4, bw4, bh4, ref, px + dx, py + dy, dx, dy, list);
}

U0 H264McPartB(CH264Dec *d, I64 x4, I64 y4, I64 bw4, I64 bh4)
{//Fetch whatever the two lists were given; the second averages into the first.
	I64	 i = y4 * d->mb_w * 4 + x4, w0 = -1;

	if (d->refidx[i] >= 0)
	{
		H264McBlock(d, x4, y4, bw4, bh4, d->refidx[i], d->mvx[i], d->mvy[i],
					0, -1);
		w0 = H264BiWeight(d, d->refidx[i], d->refidx1[i]);
	}
	if (d->refidx1[i] >= 0)
		H264McBlock(d, x4, y4, bw4, bh4, d->refidx1[i], d->mvx1[i], d->mvy1[i],
					1, w0);
}

Bool H264DecodeMbB(CH264Dec *d, Bool cabac, Bool skip)
{//One B macroblock. B_Skip and B_Direct_16x16 carry no motion of their own.
	I64	 stride = d->mb_w * 4, i = d->mb_y * d->mb_w + d->mb_x;
	I64	 mb_type, sub[4], r0[4], r1[4], x4, y4, blk, n, t;
	I64	 cbp_luma = 0, cbp_chroma = 0;
	I64	 n0 = d->sl.ref_count[0], n1 = d->sl.ref_count[1];
	I64	 shape, parts, m0, m1, x, y, bw, bh, sx, sy, np;

	d->mb_slice[i]   = d->slice_id;
	d->mb_deblock[i] = d->sl.disable_deblock;
	d->mb_a[i]       = d->sl.alpha_off;
	d->mb_b[i]       = d->sl.beta_off;
	d->mb_qp[i]      = d->qp;
	d->mb_cmode[i]   = 0;
	d->mb_cbp[i]     = 0;
	d->mb_tx8[i]     = 0;
	d->tx8x8         = FALSE;
	MemSet(d->blk, 0, H264_BLK_COEFFS * sizeof(I16));
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		d->nnz[y4 * stride + x4]  = 0;
		d->mvdx[y4 * stride + x4] = 0;
		d->mvdy[y4 * stride + x4] = 0;
		d->mvdx1[y4 * stride + x4] = 0;
		d->mvdy1[y4 * stride + x4] = 0;
		d->modes[y4 * stride + x4] = 2;
	}
	for (t = 0; t < 2; t++)
		for (blk = 0; blk < 4; blk++)
			d->nnz_c[t][(d->mb_y * 2 + (blk >> 1)) * (d->mb_w * 2) +
						d->mb_x * 2 + (blk & 1)] = 0;

	if (skip)
	{
		d->mb_kind[i] = H264_MB_SKIP;
		H264Direct(d, d->mb_x * 4, d->mb_y * 4, 4, 4);
		H264DirectMc(d, d->mb_x * 4, d->mb_y * 4, 4, 4);
		d->last_qp_delta = 0;

		return TRUE;
	}

	if (cabac)
		mb_type = H264CabacMbTypeB(d);
	else
		mb_type = H264ReadUE(&d->b);
	if (mb_type >= 23)
	{
		d->mb_kind[i] = H264_MB_I4X4;
		if (cabac)
			return H264MbIntraCabac(d, mb_type - 23);

		return H264MbIntraCavlc(d, mb_type - 23);
	}
	if (mb_type < 0)
		return FALSE;
	shape = h264_b_mb_shape[mb_type];
	parts = h264_b_mb_parts[mb_type];
	m0    = h264_b_mb_l0[mb_type];
	m1    = h264_b_mb_l1[mb_type];
	d->mb_kind[i] = H264_MB_INTER;
	if (!shape)
		d->mb_kind[i] = H264_MB_DIRECT;

	for (n = 0; n < 4; n++)
	{
		r0[n] = -1;
		r1[n] = -1;
		sub[n] = 0;
	}
	if (shape == 4)
		for (n = 0; n < 4; n++)
		{
			if (cabac)
				sub[n] = H264CabacSubTypeB(d);
			else
				sub[n] = H264ReadUE(&d->b);
			if (sub[n] > 12)
				return FALSE;
		}

	//7.3.5.1 and 7.3.5.2 read every list 0 field of the macroblock before any
	//list 1 field: all ref_idx_l0, then all ref_idx_l1, then all mvd_l0, then
	//all mvd_l1. Interleaving them per partition is identical for a single
	//16x16 and wrong for everything else.
	for (t = 0; t < 2; t++)
		for (n = 0; n < parts; n++)
		{
			x4 = d->mb_x * 4;
			y4 = d->mb_y * 4;
			if (shape == 2)
				y4 += n * 2;
			else if (shape == 3)
				x4 += n * 2;
			else if (shape == 4)
			{
				x4 += (n & 1) * 2;
				y4 += (n >> 1) * 2;
			}
			bw = 4;
			bh = 4;
			if (shape == 2)
				bh = 2;
			else if (shape == 3)
				bw = 2;
			else if (shape == 4)
			{
				bw = 2;
				bh = 2;
			}
			if (shape == 4)
			{
				if (!sub[n])
					goto next_ref;
				m0 = h264_b_sub_l0[sub[n]];
				m1 = h264_b_sub_l1[sub[n]];
				if (!t)
					r0[n] = H264RefIdxB(d, cabac, x4, y4, bw, bh, n0, 0,
										m0 & 1);
				else
					r1[n] = H264RefIdxB(d, cabac, x4, y4, bw, bh, n1, 1,
										m1 & 1);
				goto next_ref;
			}
			if (!t)
				r0[n] = H264RefIdxB(d, cabac, x4, y4, bw, bh, n0, 0,
									m0 & (1 << n));
			else
				r1[n] = H264RefIdxB(d, cabac, x4, y4, bw, bh, n1, 1,
									m1 & (1 << n));
next_ref:;
		}

	if (!shape)
	{//B_Direct_16x16
		H264Direct(d, d->mb_x * 4, d->mb_y * 4, 4, 4);
		H264DirectMc(d, d->mb_x * 4, d->mb_y * 4, 4, 4);
	}
	else if (shape != 4)
	{
		for (t = 0; t < 2; t++)
			for (n = 0; n < parts; n++)
			{
				x4 = d->mb_x * 4;
				y4 = d->mb_y * 4;
				bw = 4;
				bh = 4;
				np = 0;
				if (shape == 2)
				{
					y4 += n * 2;
					bh  = 2;
					np  = 1 + n;
				}
				else if (shape == 3)
				{
					x4 += n * 2;
					bw  = 2;
					np  = 3 + n;
				}
				if (!t)
					H264MbMvdB(d, cabac, x4, y4, bw, bh, np, r0[n], 0);
				else
					H264MbMvdB(d, cabac, x4, y4, bw, bh, np, r1[n], 1);
			}
		for (n = 0; n < parts; n++)
		{
			x4 = d->mb_x * 4;
			y4 = d->mb_y * 4;
			bw = 4;
			bh = 4;
			if (shape == 2)
			{
				y4 += n * 2;
				bh  = 2;
			}
			else if (shape == 3)
			{
				x4 += n * 2;
				bw  = 2;
			}
			H264McPartB(d, x4, y4, bw, bh);
		}
	}
	else
	{//B_8x8: the same two passes, walked over every sub partition.
		//A direct sub partition is derived before any difference is read, so
		//the sub partitions that follow predict from its vectors.
		for (n = 0; n < 4; n++)
			if (!sub[n])
				H264Direct(d, d->mb_x * 4 + (n & 1) * 2,
						   d->mb_y * 4 + (n >> 1) * 2, 2, 2);
		for (t = 0; t < 2; t++)
			for (n = 0; n < 4; n++)
			{
				sx = d->mb_x * 4 + (n & 1) * 2;
				sy = d->mb_y * 4 + (n >> 1) * 2;
				if (!sub[n])
					goto next_mvd;
				bw = 2;
				bh = 2;
				if (h264_b_sub_shape[sub[n]] == 2)
					bh = 1;
				else if (h264_b_sub_shape[sub[n]] == 3)
					bw = 1;
				else if (h264_b_sub_shape[sub[n]] == 4)
				{
					bw = 1;
					bh = 1;
				}
				for (y = 0; y < 2; y += bh)
					for (x = 0; x < 2; x += bw)
					{
						if (!t)
							H264MbMvdB(d, cabac, sx + x, sy + y, bw, bh, 0,
									   r0[n], 0);
						else
							H264MbMvdB(d, cabac, sx + x, sy + y, bw, bh, 0,
									   r1[n], 1);
					}
next_mvd:;
			}
		for (n = 0; n < 4; n++)
		{
			sx = d->mb_x * 4 + (n & 1) * 2;
			sy = d->mb_y * 4 + (n >> 1) * 2;
			if (!sub[n])
			{
				H264DirectMc(d, sx, sy, 2, 2);
				goto next_mc;
			}
			bw = 2;
			bh = 2;
			if (h264_b_sub_shape[sub[n]] == 2)
				bh = 1;
			else if (h264_b_sub_shape[sub[n]] == 3)
				bw = 1;
			else if (h264_b_sub_shape[sub[n]] == 4)
			{
				bw = 1;
				bh = 1;
			}
			for (y = 0; y < 2; y += bh)
				for (x = 0; x < 2; x += bw)
					H264McPartB(d, sx + x, sy + y, bw, bh);
next_mc:;
		}
	}

	if (cabac)
	{
		cbp_luma   = H264CabacCbpLuma(d, FALSE);
		cbp_chroma = H264CabacCbpChroma(d, FALSE);
	}
	else
	{
		n = H264ReadUE(&d->b);
		if (n > 47)
			return FALSE;
		cbp_luma   = h264_golomb_to_inter_cbp[n] & 15;
		cbp_chroma = h264_golomb_to_inter_cbp[n] >> 4;
	}
	d->mb_cbp[i] = cbp_luma | cbp_chroma << 4;
	if (!cbp_luma && !cbp_chroma)
	{
		d->last_qp_delta = 0;

		return TRUE;
	}
	if (cabac)
	{
		if (d->pps->transform_8x8 && cbp_luma)
		{
			d->tx8x8     = ToBool(H264CabacTx8(d));
			d->mb_tx8[i] = d->tx8x8;
		}
		H264CabacQpDelta(d);
	}
	else
	{
		if (d->pps->transform_8x8 && cbp_luma)
			return FALSE;			//CAVLC 8x8 residuals are not implemented
		d->qp = (d->qp + H264ReadSE(&d->b) + 52) % 52;
	}
	d->mb_qp[i] = d->qp;

	if (cabac)
	{
		if (!H264ResidualPCabac(d, cbp_luma, cbp_chroma))
			return FALSE;
	}
	else if (!H264ResidualLuma(d, cbp_luma, FALSE) ||
			 !H264ResidualChroma(d, cbp_chroma))
		return FALSE;

	if (d->tx8x8)
		H264ReconLuma8Res(d, cbp_luma);
	else
		H264ReconLumaRes(d, cbp_luma);
	H264ReconChromaRes(d, cbp_chroma);

	return TRUE;
}

Bool H264DecodeMbP(CH264Dec *d, Bool cabac, Bool skip)
{//One P macroblock. Skipped macroblocks carry no residual and predict with the
//motion of their neighbours.
	I64	 stride = d->mb_w * 4, i = d->mb_y * d->mb_w + d->mb_x;
	I64	 mb_type, sub[4], ref[4], x4, y4, blk, n, t;
	Bool ref0_only;
	I64	 cbp_luma = 0, cbp_chroma = 0, mvx, mvy, nrefs = d->sl.ref_count[0];
	I64	 x, y, bw, bh, np;

	d->mb_slice[i]   = d->slice_id;
	d->mb_deblock[i] = d->sl.disable_deblock;
	d->mb_a[i]       = d->sl.alpha_off;
	d->mb_b[i]       = d->sl.beta_off;
	d->mb_qp[i]      = d->qp;
	d->mb_cmode[i]   = 0;
	d->mb_cbp[i]     = 0;
	d->mb_tx8[i]     = 0;
	d->tx8x8         = FALSE;
	MemSet(d->blk, 0, H264_BLK_COEFFS * sizeof(I16));
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		d->nnz[y4 * stride + x4]  = 0;
		d->mvdx[y4 * stride + x4] = 0;
		d->mvdy[y4 * stride + x4] = 0;
		d->mvdx1[y4 * stride + x4] = 0;
		d->mvdy1[y4 * stride + x4] = 0;
		d->modes[y4 * stride + x4] = 2;
	}
	for (t = 0; t < 2; t++)
		for (blk = 0; blk < 4; blk++)
			d->nnz_c[t][(d->mb_y * 2 + (blk >> 1)) * (d->mb_w * 2) +
						d->mb_x * 2 + (blk & 1)] = 0;

	if (skip)
	{
		d->mb_kind[i] = H264_MB_SKIP;
		H264SkipMv(d, &mvx, &mvy);
		H264MvSet(d, d->mb_x * 4, d->mb_y * 4, 4, 4, 0, mvx, mvy, 0, 0, 0);
		H264McBlock(d, d->mb_x * 4, d->mb_y * 4, 4, 4, 0, mvx, mvy, 0, -1);
		d->last_qp_delta = 0;

		return TRUE;
	}

	if (cabac)
		mb_type = H264CabacMbTypeP(d);
	else
		mb_type = H264ReadUE(&d->b);
	if (mb_type >= 5)
	{
		d->mb_kind[i] = H264_MB_I4X4;
		if (cabac)
			return H264MbIntraCabac(d, mb_type - 5);

		return H264MbIntraCavlc(d, mb_type - 5);
	}
	d->mb_kind[i] = H264_MB_INTER;
	ref0_only = FALSE;
	if (mb_type == 4)
	{//P_8x8ref0: every partition uses reference zero, and none is coded.
		mb_type   = 3;
		ref0_only = TRUE;
	}

	//Reference indices first, then the differences, as the standard orders
	//the macroblock layer.
	for (n = 0; n < 4; n++)
		ref[n] = 0;
	if (!mb_type)
		np = 1;
	else if (mb_type == 3)
		np = 4;
	else
		np = 2;
	if (mb_type == 3)
		for (n = 0; n < 4; n++)
		{//Every sub type first: the standard reads the four of them together.
			if (cabac)
				sub[n] = H264CabacSubType(d);
			else
				sub[n] = H264ReadUE(&d->b);
			if (sub[n] > 3)
				return FALSE;
		}
	if (nrefs > 1 && !ref0_only)
		for (n = 0; n < np; n++)
		{
			x4 = d->mb_x * 4;
			y4 = d->mb_y * 4;
			if (mb_type == 1)
				y4 += n * 2;
			else if (mb_type == 2)
				x4 += n * 2;
			else if (mb_type == 3)
			{
				x4 += (n & 1) * 2;
				y4 += (n >> 1) * 2;
			}
			if (cabac)
				ref[n] = H264CabacRefIdx(d, x4, y4, 0);
			else
				ref[n] = H264ReadTE(&d->b, nrefs);
					t = 4;
			if (mb_type == 1)
				t = 2;
			if (mb_type == 1)
				H264MvSet(d, x4, y4, 4, 2, ref[n], 0, 0, 0, 0, 0);
			else if (mb_type == 2)
				H264MvSet(d, x4, y4, 2, 4, ref[n], 0, 0, 0, 0, 0);
			else
				H264MvSet(d, x4, y4, 2, 2, ref[n], 0, 0, 0, 0, 0);
		}

	if (!mb_type)
		H264MbPart(d, cabac, d->mb_x * 4, d->mb_y * 4, 4, 4, 0, ref[0]);
	else if (mb_type == 1)
		for (n = 0; n < 2; n++)
			H264MbPart(d, cabac, d->mb_x * 4, d->mb_y * 4 + n * 2, 4, 2,
					   1 + n, ref[n]);
	else if (mb_type == 2)
		for (n = 0; n < 2; n++)
			H264MbPart(d, cabac, d->mb_x * 4 + n * 2, d->mb_y * 4, 2, 4,
					   3 + n, ref[n]);
	else
	{//P_8x8: each quarter carries its own partitioning.
		for (n = 0; n < 4; n++)
		{
			bw = 2;
			bh = 2;
			if (sub[n] == 1)
				bh = 1;
			if (sub[n] == 2)
				bw = 1;
			if (sub[n] == 3)
			{
				bw = 1;
				bh = 1;
			}
			for (y = 0; y < 2; y += bh)
				for (x = 0; x < 2; x += bw)
					H264MbPart(d, cabac,
							   d->mb_x * 4 + (n & 1) * 2 + x,
							   d->mb_y * 4 + (n >> 1) * 2 + y,
							   bw, bh, 0, ref[n]);
		}
	}

	if (cabac)
	{
		cbp_luma   = H264CabacCbpLuma(d, FALSE);
		cbp_chroma = H264CabacCbpChroma(d, FALSE);
	}
	else
	{
		n = H264ReadUE(&d->b);
		if (n > 47)
			return FALSE;
		cbp_luma   = h264_golomb_to_inter_cbp[n] & 15;
		cbp_chroma = h264_golomb_to_inter_cbp[n] >> 4;
	}
	d->mb_cbp[i] = cbp_luma | cbp_chroma << 4;
	if (!cbp_luma && !cbp_chroma)
	{
		d->last_qp_delta = 0;

		return TRUE;
	}
	if (cabac)
	{
		if (d->pps->transform_8x8 && cbp_luma)
		{
			d->tx8x8     = ToBool(H264CabacTx8(d));
			d->mb_tx8[i] = d->tx8x8;
		}
		H264CabacQpDelta(d);
	}
	else
	{
		if (d->pps->transform_8x8 && cbp_luma)
			return FALSE;			//CAVLC 8x8 residuals are not implemented
		d->qp = (d->qp + H264ReadSE(&d->b) + 52) % 52;
	}
	d->mb_qp[i] = d->qp;

	if (cabac)
	{
		if (!H264ResidualPCabac(d, cbp_luma, cbp_chroma))
			return FALSE;
	}
	else if (!H264ResidualLuma(d, cbp_luma, FALSE) ||
			 !H264ResidualChroma(d, cbp_chroma))
		return FALSE;

	if (d->tx8x8)
		H264ReconLuma8Res(d, cbp_luma);
	else
		H264ReconLumaRes(d, cbp_luma);
	H264ReconChromaRes(d, cbp_chroma);

	return TRUE;
}

Bool H264DecodeMbI(CH264Dec *d)
{
	return H264MbIntraCavlc(d, H264ReadUE(&d->b));
}

Bool H264DecodeMbICabac(CH264Dec *d)
{
	return H264MbIntraCabac(d, H264CabacMbType(d));
}

public U0 H264DecPicEnd(CH264Dec *d)
{//The finished picture joins the short term references if the stream marks it.
	if (!d->cur || !d->sps || !d->sl.nal_ref_idc)
		return;
	//8.2.5.1: adaptive marking replaces the sliding window, it does not
	//supplement it.
	if (d->sl.mmco_adaptive)
		H264RefMmco(d, &d->sl, 1 << d->sps->log2_max_frame_num);
	else
		H264RefStore(d, d->sps->max_ref_frames, 1 << d->sps->log2_max_frame_num);
}

public U0 H264DecFilter(CH264Dec *d)
{//Runs once the whole picture is decoded.
	I64 x, y;

	if (!d->pic[0])
		return;
	for (y = 0; y < d->mb_h; y++)
		for (x = 0; x < d->mb_w; x++)
			H264FilterMb(d, x, y);
}

public CH264Dec *H264DecOpen(CH264Ctx *c)
{
	CH264Dec *d = CAlloc(sizeof(CH264Dec));

	d->ctx = c;

	return d;
}

public U0 H264DecClose(CH264Dec *d)
{
	if (!d)
		return;
	H264DecFree(d);
	Free(d);
}

public I64 H264DecodeSlice(CH264Dec *d, U8 *rbsp, I64 size)
{//Returns the bits left over: a correct CAVLC parse stops on the
//rbsp_stop_one_bit, so anything but 0..7 means the walk went wrong. Negative
//on a rejected slice.
	CH264Ctx	*c = d->ctx;
	I64			 addr, left, i, skip_run = 0;
	Bool		 p_slice, b_slice, skip, pending = FALSE;

	if (!H264ParseSliceHeader(c, rbsp, size, &d->sl))
		return -1;
	if (d->sl.type != H264_SLICE_I && d->sl.type != H264_SLICE_P &&
		d->sl.type != H264_SLICE_B)
		return -2;					//SI and SP are not implemented.
	if (d->sl.long_term)
		return -7;					//Long term references are not kept.
	d->pps = &c->pps[d->sl.pps_id];
	d->sps = &c->sps[d->pps->sps_id];
	if (!H264DecSize(d, d->sps))
		return -4;
	if (d->pps->transform_8x8 && !d->pps->cabac)
		return -6;					//CAVLC 8x8 residuals are not implemented.

	//The header parse left the reader positioned at the slice data.
	H264BitsInit(&d->b, rbsp, size);
	H264ParseSliceHeader(c, rbsp, size, &d->sl);
	d->b.pos = d->sl.header_bits;

	if (d->sl.first_mb == 0)
	{//A new picture: take a frame that is not held as a reference.
		if (d->sl.nal_type == H264_NAL_IDR || d->sl.mmco_reset)
			H264RefsClear(d);
		d->cur = H264FrameFree(d);
		if (!d->cur)
			return -4;
		d->cur->frame_num = d->sl.frame_num;
		for (i = 0; i < 3; i++)
			d->pic[i] = d->cur->pic[i];
		d->mvx     = d->cur->mvx;
		d->mvy     = d->cur->mvy;
		d->refidx  = d->cur->refidx;
		d->mvx1    = d->cur->mvx1;
		d->mvy1    = d->cur->mvy1;
		d->refidx1 = d->cur->refidx1;
		H264PocCompute(d, d->sps, &d->sl);
		MemSet(d->mb_slice, 0xFF, d->mb_w * d->mb_h);
		d->slice_id = 0;
	}
	if (!d->cur)
		return -4;
	d->slice_id++;
	//A B slice orders both lists by picture order count, 8.2.4.2.3; P orders
	//list 0 by frame number.
	if (d->sl.type == H264_SLICE_B)
		H264RefListBuildB(d);
	else
		H264RefListBuild(d, 1 << d->sps->log2_max_frame_num);
	H264RefListReorder(d, &d->sl, 1 << d->sps->log2_max_frame_num);
	//8.2.4.2: a list holds num_ref_idx_lX_active entries once modification is
	//done. The count decides whether list 1 gets the 8.2.4.2.3 swap.
	if (d->sl.type != H264_SLICE_I && d->ref0_count > d->sl.ref_count[0])
		d->ref0_count = d->sl.ref_count[0];
	if (d->sl.type == H264_SLICE_B && d->ref1_count > d->sl.ref_count[1])
		d->ref1_count = d->sl.ref_count[1];
	for (i = 0; i < d->ref0_count; i++)
		d->cur->ref_poc[i] = d->ref0[i]->poc;
	for (i = 0; i < d->ref1_count; i++)
		d->cur->ref_poc[H264_REFS_MAX + i] = d->ref1[i]->poc;
	d->cur->ref_pcount[0] = d->ref0_count;
	d->cur->ref_pcount[1] = d->ref1_count;
	if (d->sl.type == H264_SLICE_P && !d->ref0_count)
		return -8;					//No reference to predict from.
	if (d->sl.type == H264_SLICE_B && (!d->ref0_count || !d->ref1_count))
		return -8;
	d->qp            = d->sl.qp;
	d->mbs           = 0;
	d->last_qp_delta = 0;
	addr             = d->sl.first_mb;

	b_slice = ToBool(d->sl.type == H264_SLICE_B);
	//p_slice gates the inter path; a B slice takes it too and branches inside.
	p_slice = ToBool(d->sl.type == H264_SLICE_P || b_slice);
	if (d->pps->cabac)
	{//No trailing bit walk: the arithmetic decoder ends the slice itself.
		H264CabacStart(&d->cabac, rbsp, size, d->sl.header_bits, d->sl.qp,
					   p_slice, d->sl.cabac_init);
		while (addr < d->mb_w * d->mb_h)
		{
			d->mb_x = addr % d->mb_w;
			d->mb_y = addr / d->mb_w;
			H264MvClearMb(d);
			if (p_slice)
			{
				if (b_slice)
				{
					skip = ToBool(H264CabacSkipB(d));
					if (!H264DecodeMbB(d, TRUE, skip))
						return -5;
				}
				else
				{
					skip = ToBool(H264CabacSkip(d));
					if (!H264DecodeMbP(d, TRUE, skip))
						return -5;
				}
			}
			else if (!H264DecodeMbICabac(d))
				return -5;
			d->mbs++;
			addr++;
			if (H264CabacTerm(&d->cabac))
				break;
		}

		return 0;
	}

	while (addr < d->mb_w * d->mb_h)
	{
		d->mb_x = addr % d->mb_w;
		d->mb_y = addr / d->mb_w;
		H264MvClearMb(d);
		if (p_slice && !pending)
		{//mb_skip_run precedes each coded macroblock.
			skip_run = H264ReadUE(&d->b);
			pending  = TRUE;
		}
		if (p_slice && skip_run > 0)
		{
			skip_run--;
			if (b_slice)
			{
				if (!H264DecodeMbB(d, FALSE, TRUE))
					return -5;
			}
			else if (!H264DecodeMbP(d, FALSE, TRUE))
				return -5;
		}
		else if (p_slice)
		{
			pending = FALSE;
			if (b_slice)
			{
				if (!H264DecodeMbB(d, FALSE, FALSE))
					return -5;
			}
			else if (!H264DecodeMbP(d, FALSE, FALSE))
				return -5;
		}
		else if (!H264DecodeMbI(d))
			return -5;
		d->mbs++;
		addr++;
		//more_rbsp_data(): a slice ends at the stop bit and its padding. A
		//skip run still owed macroblocks outlives the last coded bit.
		if (skip_run > 0)
			goto next_mb;
		left = d->b.end - d->b.pos;
		for (i = d->b.end - 1; i > d->b.pos; i--)
			if (rbsp[i >> 3] >> (7 - (i & 7)) & 1)
				break;
		if (i <= d->b.pos)
			break;
next_mb:;
	}

	left = d->b.end - d->b.pos;
	for (i = d->b.end - 1; i >= 0; i--)
		if (rbsp[i >> 3] >> (7 - (i & 7)) & 1)
		{//Trailing bits: the stop bit is the last set bit in the payload.
			left = i - d->b.pos;
			break;
		}

	return left;
}

/***** playback *****/

class CH264Play
{
	CH264Ctx	*ctx;
	CH264Dec	*dec;
	U32			*argb;			//reused between pictures; the caller borrows it
	I64			 argb_pixels;
	I64			 w, h;
	Bool		 got;			//a picture has been decoded
	//B pictures arrive in decode order. Pictures are pinned here until enough
	//are in hand that the next one in display order is known; reorder of zero
	//hands each picture straight back, which is what a stream without B
	//pictures wants.
	CH264Frame	*out;
	F64			 out_time;
	I64			 out_w, out_h;
	I64			 reorder, epoch, qn, gen;
	CH264Frame	*q[H264_REFS_MAX];
	F64			 qt[H264_REFS_MAX];
	//A picture is converted up to reorder access units after it was decoded,
	//by which time the active SPS may describe a different size.
	I64			 qw[H264_REFS_MAX], qh[H264_REFS_MAX];
};

public CH264Play *H264PlayOpen()
{
	CH264Play *p = CAlloc(sizeof(CH264Play));

	p->ctx = H264Open();
	p->dec = H264DecOpen(p->ctx);
	if (!p->ctx || !p->dec)
	{
		H264DecClose(p->dec);
		H264Close(p->ctx);
		Free(p);
		return NULL;
	}

	return p;
}

public U0 H264PlayClose(CH264Play *p)
{
	if (!p)
		return;
	H264DecClose(p->dec);
	H264Close(p->ctx);
	Free(p->argb);
	Free(p);
}

public Bool H264PlayConfig(CH264Play *p, U8 *cfg, I64 size)
{//The avcC record from the container.
	if (!p)
		return FALSE;

	return H264ParseAvcC(p->ctx, cfg, size);
}

U0 MediaYuvArgb(U32 *argb, U8 *py, U8 *pu, U8 *pv, I64 sy, I64 su, I64 sv,
				I64 w, I64 h, I64 ssx, I64 ssy)
{//BT.601 studio range luma and chroma to full range ARGB, eight fractional
//bits. Chroma is read once per run of 1 << ssx luma samples and held down 1 <<
//ssy rows; pu and pv are NULL on a monochrome source, which leaves grey. The
//AV1 player shares this, which is why it sits here rather than beside either
//caller: h264_clip8 is the nearest clamp table and H264Tables.ZC is the file
//before this one.
	U8	*ly, *lu, *lv;
	I64	 x, y, c, i, n, cy, cu, cv, rr, gg, bb, r, g, b;

	for (y = 0; y < h; y++)
	{
		ly = py + y * sy;
		i  = y * w;
		if (!pu || !pv)
		{
			for (x = 0; x < w; x++)
			{
				cy = 298 * (ly[x] - 16) + 128;
				r  = h264_clip8[(cy >> 8) + 384];
				argb[i + x] = 0xFF000000 | r << 16 | r << 8 | r;
			}
			goto next_row;
		}
		lu = pu + (y >> ssy) * su;
		lv = pv + (y >> ssy) * sv;
		x  = 0;
		c  = 0;
		while (x < w)
		{
			cu = lu[c] - 128;
			cv = lv[c] - 128;
			rr = 409 * cv + 128;
			gg = -100 * cu - 208 * cv + 128;
			bb = 516 * cu + 128;
			n  = x + (1 << ssx);
			if (n > w)
				n = w;
			while (x < n)
			{
				cy = 298 * (ly[x] - 16);
				r  = h264_clip8[((cy + rr) >> 8) + 384];
				g  = h264_clip8[((cy + gg) >> 8) + 384];
				b  = h264_clip8[((cy + bb) >> 8) + 384];
				argb[i + x] = 0xFF000000 | r << 16 | g << 8 | b;
				x++;
			}
			c++;
		}
next_row:;
		if (!(y & 63))
			Yield;
	}
}

U32 *H264ToArgb(CH264Play *p, CH264Frame *f, I64 w, I64 h)
{
	U32	*argb = p->argb;

	if (p->argb_pixels < w * h)
	{//Grown once, then kept: a picture a frame is a lot of heap churn.
		Free(p->argb);
		p->argb        = MAlloc(w * h * sizeof(U32));
		p->argb_pixels = w * h;
		argb           = p->argb;
	}
	if (!argb)
		return NULL;
	MediaYuvArgb(argb, f->pic[0], f->pic[1], f->pic[2], f->stride[0],
				 f->stride[1], f->stride[2], w, h, 1, 1);

	return argb;
}

public Bool H264Playable(U8 *cfg, I64 size)
{//Whether an avcC record describes a stream the decoder handles.
	CH264Ctx	*c = H264Open();
	Bool		 ok = FALSE;
	I64			 i;

	if (!c)
		return FALSE;
	if (H264ParseAvcC(c, cfg, size))
		for (i = 0; i < H264_PPS_MAX; i++)
			if (c->pps[i].valid &&
				!(c->pps[i].transform_8x8 && !c->pps[i].cabac))
			{
				ok = TRUE;
				i  = H264_PPS_MAX;
			}
	H264Close(c);

	return ok;
}

public U0 H264PlaySetReorder(CH264Play *p, I64 n)
{//How many pictures to hold before the first is displayable. Must be set
//before the first frame: the frame store is sized once. H264DecSize lowers it
//again if the references leave no room, and the queue reads it back from
//there rather than keeping a second copy.
	if (!p)
		return;
	if (n < 0)
		n = 0;
	//No B pyramid in the wild nests this deep, and every held picture is a
	//whole frame buffer plus a frame of seek latency.
	if (n > H264_PLAY_REORDER_MAX)
		n = H264_PLAY_REORDER_MAX;
	p->dec->reorder = n;
}

U0 H264PlayPush(CH264Play *p, F64 time, I64 w, I64 h)
{//The finished picture joins the output queue, pinned so the frame store will
//not hand its buffer out again. A picture already in the queue is never
//pushed twice: H264PlayPop unpins whatever it replaces, so a duplicate would
//unpin the picture it is installing.
	CH264Frame *f = p->dec->cur;

	if (!f || f->held || p->qn >= H264_REFS_MAX)
		return;
	f->held      = TRUE;
	f->epoch     = p->epoch;
	p->q[p->qn]  = f;
	p->qt[p->qn] = time;
	p->qw[p->qn] = w;
	p->qh[p->qn] = h;
	p->qn++;
}

Bool H264PlayPop(CH264Play *p)
{//Lowest (epoch, poc) in the queue becomes the picture to present, and the one
//it replaces is unpinned.
	I64 i, best = -1;

	if (p->qn < 1)
		return FALSE;
	for (i = 0; i < p->qn; i++)
	{
		if (best < 0)
			best = i;
		else if (p->q[i]->epoch < p->q[best]->epoch ||
				 (p->q[i]->epoch == p->q[best]->epoch &&
				  p->q[i]->poc < p->q[best]->poc))
			best = i;
	}
	if (p->out && p->out != p->q[best])
		p->out->held = FALSE;
	p->out      = p->q[best];
	p->out_time = p->qt[best];
	p->out_w    = p->qw[best];
	p->out_h    = p->qh[best];
	for (i = best; i < p->qn - 1; i++)
	{
		p->q[i]  = p->q[i + 1];
		p->qt[i] = p->qt[i + 1];
		p->qw[i] = p->qw[i + 1];
		p->qh[i] = p->qh[i + 1];
	}
	p->qn--;
	p->got = TRUE;

	return TRUE;
}

public Bool H264PlayFlush(CH264Play *p)
{//End of stream: the queue still holds the last pictures.
	if (!p)
		return FALSE;

	return H264PlayPop(p);
}

public F64 H264PlayOutTime(CH264Play *p)
{
	if (!p)
		return 0.0;

	return p->out_time;
}

U0 H264PlayEmpty(CH264Play *p)
{//Unpin everything queued. The decoder keeps its state.
	I64 i;

	for (i = 0; i < p->qn; i++)
		p->q[i]->held = FALSE;
	p->qn = 0;
	if (p->out)
		p->out->held = FALSE;
	p->out = NULL;
	p->got = FALSE;
}

public U0 H264PlayReset(CH264Play *p)
{//A seek invalidates display order, so the queue is dropped rather than
//drained, and the picture order count predictors go with it.
	if (!p)
		return;
	H264PlayEmpty(p);
	H264DecReset(p->dec);
	p->gen = p->dec->store_gen;
}

public Bool H264PlayDecodeRaw(CH264Play *p, U8 *data, I64 size, F64 time)
{//One access unit, length prefixed as MP4 stores it, into the decoder's
//planes. No colour conversion. FALSE when nothing decoded, and also when the
//picture is held to settle display order.
	CH264SPS	*s;
	U8			*d;
	CH264Frame	*prev;
	I64			 off = 0, i, nlen, nal, rl, n = 0;
	Bool		 idr = FALSE;

	prev = p->dec->cur;

	if (!p || !data || size < 1)
		return FALSE;
	while (off + p->ctx->nal_len_size <= size)
	{
		nlen = 0;
		for (i = 0; i < p->ctx->nal_len_size; i++)
			nlen = nlen << 8 | data[off + i];
		off += p->ctx->nal_len_size;
		if (nlen < 1 || off + nlen > size)
			break;
		d   = data + off;
		nal = d[0] & 0x1F;
		if (nal == H264_NAL_SPS || nal == H264_NAL_PPS)
		{
			rl = H264Rbsp(p->ctx, d, nlen);
			if (nal == H264_NAL_SPS)
				H264ParseSPS(p->ctx, p->ctx->rbsp, rl);
			else
				H264ParsePPS(p->ctx, p->ctx->rbsp, rl);
		}
		else if (nal == H264_NAL_SLICE || nal == H264_NAL_IDR)
		{
			if (nal == H264_NAL_IDR)
				idr = TRUE;
			rl = H264Rbsp(p->ctx, d, nlen);
			if (H264DecodeSlice(p->dec, p->ctx->rbsp, rl) >= 0)
				n++;
		}
		off += nlen;
	}
	if (!n)
		return FALSE;
	H264DecFilter(p->dec);
	H264DecPicEnd(p->dec);
	Yield;
	s = H264ActiveSPS(p->ctx);
	if (!s)
		return FALSE;
	p->w = s->width;
	p->h = s->height;
	if (p->gen != p->dec->store_gen)
	{//The frame store was rebuilt under the queue: those buffers are freed and
	//the pointers into them are stale.
		p->qn = 0;
		p->out = NULL;
		p->got = FALSE;
		p->gen = p->dec->store_gen;
	}
	if (p->dec->cur == prev)
		return FALSE;				//no picture started; nothing to queue
	if (idr)
		p->epoch++;
	H264PlayPush(p, time, p->w, p->h);
	if (p->qn <= p->dec->reorder)
		return FALSE;

	return H264PlayPop(p);
}

public U32 *H264PlayArgb(CH264Play *p, I64 *_w, I64 *_h)
{
	*_w = 0;
	*_h = 0;
	if (!p || !p->got || !p->out)
		return NULL;
	*_w = p->out_w;
	*_h = p->out_h;

	return H264ToArgb(p, p->out, p->out_w, p->out_h);
}

public U32 *H264PlayDecode(CH264Play *p, U8 *data, I64 size, I64 *_w, I64 *_h)
{//One access unit. NULL when nothing in it decodes.
	*_w = 0;
	*_h = 0;
	if (!H264PlayDecodeRaw(p, data, size, 0.0))
		return NULL;

	return H264PlayArgb(p, _w, _h);
}
