//H.264 / AVC (ITU-T H.264). Parameter sets and slice headers; no decoding yet.
//
//MP4 carries NAL units length-prefixed, with the sequence and picture
//parameter sets in the avcC record rather than in band. Annex B start codes
//are what Matroska and raw streams use instead.

#define H264_NAL_SLICE		1
#define H264_NAL_IDR		5
#define H264_NAL_SEI		6
#define H264_NAL_SPS		7
#define H264_NAL_PPS		8
#define H264_NAL_AUD		9

//Slice types, both the plain and the "all slices in this picture" forms.
#define H264_SLICE_P		0
#define H264_SLICE_B		1
#define H264_SLICE_I		2
#define H264_SLICE_SP		3
#define H264_SLICE_SI		4

class CH264Bits
{//RBSP bit reader. The buffer has already had emulation prevention removed.
	U8		*buf;
	I64		 pos, end;		//bit position, bit count
	Bool	 eof;
};

class CH264SPS
{
	Bool	 valid;
	I64		 id, profile, level, constraint;
	I64		 chroma_format;
	Bool	 separate_colour;
	I64		 bit_depth_luma, bit_depth_chroma;
	Bool	 scaling_matrix;
	I64		 log2_max_frame_num;
	I64		 poc_type, log2_max_poc_lsb;
	Bool	 delta_pic_order_always_zero;
	I64		 offset_for_non_ref_pic, offset_for_top_to_bottom;
	I64		 poc_cycle_len;
	I64		 max_ref_frames;
	Bool	 gaps_allowed;
	I64		 mb_width, mb_height;		//macroblocks
	Bool	 frame_mbs_only, mb_adaptive, direct_8x8;
	Bool	 cropping;
	I64		 crop_left, crop_right, crop_top, crop_bottom;
	I64		 width, height;				//cropped, in pixels
	Bool	 vui;
};

class CH264PPS
{
	Bool	 valid;
	I64		 id, sps_id;
	Bool	 cabac, bottom_field_order;
	I64		 slice_groups;
	I64		 ref_idx_l0, ref_idx_l1;
	Bool	 weighted_pred;
	I64		 weighted_bipred;
	I64		 init_qp, init_qs, chroma_qp_off, chroma_qp_off2;
	Bool	 deblock_control, constrained_intra, redundant_pic_cnt;
	Bool	 transform_8x8;
};

class CH264Slice
{
	I64		 nal_type, nal_ref_idc;
	I64		 first_mb, type, pps_id, frame_num;
	Bool	 field_pic, bottom_field;
	I64		 idr_pic_id, poc_lsb, delta_poc_bottom;
	I64		 ref_count[2], cabac_init;
	I64		 qp, disable_deblock, alpha_off, beta_off;
	I64		 header_bits;		//where the slice data begins
};

#define H264_SPS_MAX	8
#define H264_PPS_MAX	32

class CH264Ctx
{//Real streams number their parameter sets from zero; ids past these are
//refused rather than sized for.
	CH264SPS	 sps[H264_SPS_MAX];
	CH264PPS	 pps[H264_PPS_MAX];
	I64			 nal_len_size;		//1, 2 or 4, from avcC
	U8			*rbsp;				//scratch for the unescaped payload
	I64			 rbsp_cap;
};

/***** bit reader *****/

U0 H264BitsInit(CH264Bits *b, U8 *buf, I64 size)
{
	b->buf = buf;
	b->pos = 0;
	b->end = size * 8;
	b->eof = FALSE;
}

I64 H264Read(CH264Bits *b, I64 n)
{
	I64 v = 0, byte, shift;

	while (n)
	{
		if (b->pos >= b->end)
		{
			b->eof = TRUE;
			return v;
		}
		byte  = b->pos >> 3;
		shift = 7 - (b->pos & 7);
		v = v << 1 | (b->buf[byte] >> shift) & 1;
		b->pos++;
		n--;
	}

	return v;
}

I64 H264ReadUE(CH264Bits *b)
{//Exp-Golomb: leading zeros give the length of the value that follows.
	I64 zeros = 0;

	while (!H264Read(b, 1))
	{
		zeros++;
		if (zeros > 32 || b->eof)
		{
			b->eof = TRUE;
			return 0;
		}
	}
	if (!zeros)
		return 0;

	return (1 << zeros) - 1 + H264Read(b, zeros);
}

I64 H264ReadSE(CH264Bits *b)
{//Signed Exp-Golomb: 1, -1, 2, -2 ... interleaved.
	I64 v = H264ReadUE(b);

	if (v & 1)
		return (v + 1) >> 1;

	return -(v >> 1);
}

public I64 H264Rbsp(CH264Ctx *c, U8 *nal, I64 size)
{//Strip emulation prevention bytes: 00 00 03 xx means the 03 is not data.
	I64 i, n = 0, zeros = 0;

	if (c->rbsp_cap < size)
	{
		Free(c->rbsp);
		c->rbsp     = MAlloc(size + 16);
		c->rbsp_cap = size + 16;
	}
	for (i = 0; i < size; i++)
	{
		if (zeros >= 2 && nal[i] == 3)
			zeros = 0;
		else
		{
			if (!nal[i])
				zeros++;
			else
				zeros = 0;
			c->rbsp[n] = nal[i];
			n++;
		}
	}

	return n;
}

/***** parameter sets *****/

U0 H264ScalingList(CH264Bits *b, I64 n)
{//Read and discard: the values matter only once residuals are decoded.
	I64 i, last = 8, next = 8, delta;

	for (i = 0; i < n; i++)
	{
		if (next)
		{
			delta = H264ReadSE(b);
			next  = (last + delta + 256) % 256;
		}
		if (next)
			last = next;
	}
}

U0 H264ScalingMatrix(CH264Bits *b, I64 n)
{
	I64 i, size;

	for (i = 0; i < n; i++)
		if (H264Read(b, 1))
		{
			size = 16;
			if (i >= 6)
				size = 64;
			H264ScalingList(b, size);
		}
}

Bool H264ParseSPS(CH264Ctx *c, U8 *nal, I64 size)
{
	CH264Bits	 b;
	CH264SPS	 s;
	I64			 n, i, sub_w = 1, sub_h = 1;

	MemSet(&s, 0, sizeof(CH264SPS));
	H264BitsInit(&b, nal, size);
	H264Read(&b, 8);					//NAL header, already classified
	s.profile    = H264Read(&b, 8);
	s.constraint = H264Read(&b, 8);
	s.level      = H264Read(&b, 8);
	s.id         = H264ReadUE(&b);
	if (s.id >= H264_SPS_MAX)
		return FALSE;

	s.chroma_format    = 1;
	s.bit_depth_luma   = 8;
	s.bit_depth_chroma = 8;
	if (s.profile == 100 || s.profile == 110 || s.profile == 122 ||
		s.profile == 244 || s.profile == 44  || s.profile == 83  ||
		s.profile == 86  || s.profile == 118 || s.profile == 128 ||
		s.profile == 138 || s.profile == 139 || s.profile == 134 ||
		s.profile == 135)
	{
		s.chroma_format = H264ReadUE(&b);
		if (s.chroma_format == 3)
			s.separate_colour = ToBool(H264Read(&b, 1));
		s.bit_depth_luma   = H264ReadUE(&b) + 8;
		s.bit_depth_chroma = H264ReadUE(&b) + 8;
		H264Read(&b, 1);				//qpprime_y_zero_transform_bypass_flag
		s.scaling_matrix = ToBool(H264Read(&b, 1));
		if (s.scaling_matrix)
		{
			n = 8;
			if (s.chroma_format == 3)
				n = 12;
			H264ScalingMatrix(&b, n);
		}
	}
	s.log2_max_frame_num = H264ReadUE(&b) + 4;
	s.poc_type           = H264ReadUE(&b);
	if (!s.poc_type)
		s.log2_max_poc_lsb = H264ReadUE(&b) + 4;
	else if (s.poc_type == 1)
	{
		s.delta_pic_order_always_zero = ToBool(H264Read(&b, 1));
		s.offset_for_non_ref_pic      = H264ReadSE(&b);
		s.offset_for_top_to_bottom    = H264ReadSE(&b);
		s.poc_cycle_len               = H264ReadUE(&b);
		for (i = 0; i < s.poc_cycle_len; i++)
			H264ReadSE(&b);
	}
	s.max_ref_frames = H264ReadUE(&b);
	s.gaps_allowed   = ToBool(H264Read(&b, 1));
	s.mb_width       = H264ReadUE(&b) + 1;
	s.mb_height      = H264ReadUE(&b) + 1;
	s.frame_mbs_only = ToBool(H264Read(&b, 1));
	if (!s.frame_mbs_only)
		s.mb_adaptive = ToBool(H264Read(&b, 1));
	s.direct_8x8 = ToBool(H264Read(&b, 1));
	s.cropping   = ToBool(H264Read(&b, 1));
	if (s.cropping)
	{
		s.crop_left   = H264ReadUE(&b);
		s.crop_right  = H264ReadUE(&b);
		s.crop_top    = H264ReadUE(&b);
		s.crop_bottom = H264ReadUE(&b);
	}
	s.vui = ToBool(H264Read(&b, 1));
	if (b.eof)
		return FALSE;

	//A field-coded stream stores half a frame per map unit.
	s.height = s.mb_height * 16;
	if (!s.frame_mbs_only)
		s.height *= 2;
	s.width = s.mb_width * 16;
	if (s.chroma_format == 1)
	{
		sub_w = 2;
		sub_h = 2;
	}
	else if (s.chroma_format == 2)
		sub_w = 2;
	if (s.cropping)
	{
		s.width  -= (s.crop_left + s.crop_right) * sub_w;
		s.height -= (s.crop_top + s.crop_bottom) * sub_h;
		if (!s.frame_mbs_only)
			s.height -= (s.crop_top + s.crop_bottom) * sub_h;
	}
	s.valid = TRUE;
	MemCopy(&c->sps[s.id], &s, sizeof(CH264SPS));

	return TRUE;
}

Bool H264ParsePPS(CH264Ctx *c, U8 *nal, I64 size)
{
	CH264Bits	 b;
	CH264PPS	 p;
	CH264SPS	*sps;
	I64			 n;

	MemSet(&p, 0, sizeof(CH264PPS));
	H264BitsInit(&b, nal, size);
	H264Read(&b, 8);
	p.id     = H264ReadUE(&b);
	p.sps_id = H264ReadUE(&b);
	if (p.id >= H264_PPS_MAX || p.sps_id >= H264_SPS_MAX)
		return FALSE;
	p.cabac              = ToBool(H264Read(&b, 1));
	p.bottom_field_order = ToBool(H264Read(&b, 1));
	p.slice_groups       = H264ReadUE(&b) + 1;
	if (p.slice_groups > 1)
		return FALSE;			//Slice groups (FMO) are not supported.
	p.ref_idx_l0     = H264ReadUE(&b) + 1;
	p.ref_idx_l1     = H264ReadUE(&b) + 1;
	p.weighted_pred  = ToBool(H264Read(&b, 1));
	p.weighted_bipred = H264Read(&b, 2);
	p.init_qp        = H264ReadSE(&b) + 26;
	p.init_qs        = H264ReadSE(&b) + 26;
	p.chroma_qp_off  = H264ReadSE(&b);
	p.deblock_control    = ToBool(H264Read(&b, 1));
	p.constrained_intra  = ToBool(H264Read(&b, 1));
	p.redundant_pic_cnt  = ToBool(H264Read(&b, 1));
	//The trailing fields are present only in the longer form.
	if (b.pos + 8 < b.end)
	{
		p.transform_8x8 = ToBool(H264Read(&b, 1));
		if (H264Read(&b, 1))
		{
			sps = &c->sps[p.sps_id];
			n = 2;
			if (p.transform_8x8)
			{
				n = 2 + 2;
				if (sps->valid && sps->chroma_format == 3)
					n = 2 + 6;
			}
			H264ScalingMatrix(&b, 6 + n);
		}
		p.chroma_qp_off2 = H264ReadSE(&b);
	}
	else
		p.chroma_qp_off2 = p.chroma_qp_off;
	if (b.eof)
		return FALSE;
	p.valid = TRUE;
	MemCopy(&c->pps[p.id], &p, sizeof(CH264PPS));

	return TRUE;
}

U0 H264RefListMod(CH264Bits *b)
{//ref_pic_list_modification(): a list of ops ended by 3.
	I64 op;

	if (!H264Read(b, 1))
		return;
	while (TRUE)
	{
		op = H264ReadUE(b);
		if (op == 3 || b->eof)
			return;
		H264ReadUE(b);
	}
}

U0 H264PredWeightTable(CH264Bits *b, CH264Slice *sl, CH264SPS *s)
{
	I64 i, j, chroma = 0;

	if (s->chroma_format && !s->separate_colour)
		chroma = 1;
	H264ReadUE(b);						//luma_log2_weight_denom
	if (chroma)
		H264ReadUE(b);					//chroma_log2_weight_denom
	for (j = 0; j < 2; j++)
	{
		if (j && sl->type != H264_SLICE_B)
			return;
		for (i = 0; i < sl->ref_count[j]; i++)
		{
			if (H264Read(b, 1))
			{
				H264ReadSE(b);
				H264ReadSE(b);
			}
			if (chroma && H264Read(b, 1))
			{
				H264ReadSE(b);
				H264ReadSE(b);
				H264ReadSE(b);
				H264ReadSE(b);
			}
		}
	}
}

U0 H264RefPicMarking(CH264Bits *b, CH264Slice *sl)
{//dec_ref_pic_marking(): IDRs carry two flags, others a command list.
	I64 op;

	if (sl->nal_type == H264_NAL_IDR)
	{
		H264Read(b, 1);				//no_output_of_prior_pics_flag
		H264Read(b, 1);				//long_term_reference_flag
		return;
	}
	if (!H264Read(b, 1))				//adaptive_ref_pic_marking_mode_flag
		return;
	while (TRUE)
	{
		op = H264ReadUE(b);
		if (!op || b->eof)
			return;
		if (op == 1 || op == 3)
			H264ReadUE(b);
		if (op == 2)
			H264ReadUE(b);
		if (op == 3 || op == 6)
			H264ReadUE(b);
		if (op == 4)
			H264ReadUE(b);
		if (op == 5)
			return;
	}
}

public Bool H264ParseSliceHeader(CH264Ctx *c, U8 *nal, I64 size,
							 CH264Slice *sl)
{//Enough of the header to identify the picture; the rest is decoding state.
	CH264Bits	 b;
	CH264PPS	*p;
	CH264SPS	*s;
	I64			 hdr, n0, n1;

	MemSet(sl, 0, sizeof(CH264Slice));
	H264BitsInit(&b, nal, size);
	hdr          = H264Read(&b, 8);
	sl->nal_type = hdr & 0x1F;
	sl->nal_ref_idc = (hdr >> 5) & 3;
	sl->first_mb = H264ReadUE(&b);
	sl->type     = H264ReadUE(&b);
	if (sl->type > 4)
		sl->type -= 5;			//"all slices of this type" form
	sl->pps_id = H264ReadUE(&b);
	if (sl->pps_id >= H264_PPS_MAX)
		return FALSE;
	p = &c->pps[sl->pps_id];
	if (!p->valid)
		return FALSE;
	s = &c->sps[p->sps_id];
	if (!s->valid)
		return FALSE;

	sl->frame_num = H264Read(&b, s->log2_max_frame_num);
	if (!s->frame_mbs_only)
	{
		sl->field_pic = ToBool(H264Read(&b, 1));
		if (sl->field_pic)
			sl->bottom_field = ToBool(H264Read(&b, 1));
	}
	if (sl->nal_type == H264_NAL_IDR)
		sl->idr_pic_id = H264ReadUE(&b);
	if (!s->poc_type)
	{
		sl->poc_lsb = H264Read(&b, s->log2_max_poc_lsb);
		if (p->bottom_field_order && !sl->field_pic)
			sl->delta_poc_bottom = H264ReadSE(&b);
	}
	else if (s->poc_type == 1 && !s->delta_pic_order_always_zero)
	{
		H264ReadSE(&b);
		if (p->bottom_field_order && !sl->field_pic)
			H264ReadSE(&b);
	}
	if (p->redundant_pic_cnt)
		H264ReadUE(&b);

	if (sl->type == H264_SLICE_B)
		H264Read(&b, 1);				//direct_spatial_mv_pred_flag
	n0 = p->ref_idx_l0;
	n1 = p->ref_idx_l1;
	if (sl->type == H264_SLICE_P || sl->type == H264_SLICE_SP ||
		sl->type == H264_SLICE_B)
		if (H264Read(&b, 1))
		{//num_ref_idx_active_override
			n0 = H264ReadUE(&b) + 1;
			if (sl->type == H264_SLICE_B)
				n1 = H264ReadUE(&b) + 1;
		}
	sl->ref_count[0] = n0;
	sl->ref_count[1] = n1;

	//Reference picture list modification, then the weight table and the
	//marking commands: all skipped, but their bits have to be walked to reach
	//the quantiser.
	if (sl->type != H264_SLICE_I && sl->type != H264_SLICE_SI)
		H264RefListMod(&b);
	if (sl->type == H264_SLICE_B)
		H264RefListMod(&b);
	if ((p->weighted_pred && (sl->type == H264_SLICE_P ||
							  sl->type == H264_SLICE_SP)) ||
		(p->weighted_bipred == 1 && sl->type == H264_SLICE_B))
		H264PredWeightTable(&b, sl, s);
	if (sl->nal_ref_idc)
		H264RefPicMarking(&b, sl);
	if (p->cabac && sl->type != H264_SLICE_I && sl->type != H264_SLICE_SI)
		sl->cabac_init = H264ReadUE(&b);
	sl->qp = p->init_qp + H264ReadSE(&b);
	if (sl->type == H264_SLICE_SP || sl->type == H264_SLICE_SI)
	{
		if (sl->type == H264_SLICE_SP)
			H264Read(&b, 1);			//sp_for_switch_flag
		H264ReadSE(&b);					//slice_qs_delta
	}
	if (p->deblock_control)
	{
		sl->disable_deblock = H264ReadUE(&b);
		if (sl->disable_deblock != 1)
		{
			sl->alpha_off = H264ReadSE(&b) * 2;
			sl->beta_off  = H264ReadSE(&b) * 2;
		}
	}
	sl->header_bits = b.pos;

	return ToBool(!b.eof);
}

/***** stream layer *****/

public CH264Ctx *H264Open()
{
	CH264Ctx *c = CAlloc(sizeof(CH264Ctx));

	c->nal_len_size = 4;

	return c;
}

public U0 H264Close(CH264Ctx *c)
{
	if (!c)
		return;
	Free(c->rbsp);
	Free(c);
}

public Bool H264ParseAvcC(CH264Ctx *c, U8 *cfg, I64 size)
{//AVCDecoderConfigurationRecord: the parameter sets live here, not in band.
	I64 i, n, len, pos = 5;

	if (!cfg || size < 7)
		return FALSE;
	c->nal_len_size = (cfg[4] & 3) + 1;
	n = cfg[pos] & 0x1F;
	pos++;
	for (i = 0; i < n && pos + 2 <= size; i++)
	{
		len = cfg[pos] << 8 | cfg[pos + 1];
		pos += 2;
		if (pos + len > size)
			return FALSE;
		H264ParseSPS(c, c->rbsp, H264Rbsp(c, cfg + pos, len));
		pos += len;
	}
	if (pos >= size)
		return FALSE;
	n = cfg[pos];
	pos++;
	for (i = 0; i < n && pos + 2 <= size; i++)
	{
		len = cfg[pos] << 8 | cfg[pos + 1];
		pos += 2;
		if (pos + len > size)
			return FALSE;
		H264ParsePPS(c, c->rbsp, H264Rbsp(c, cfg + pos, len));
		pos += len;
	}

	return TRUE;
}

public CH264SPS *H264ActiveSPS(CH264Ctx *c)
{//The first parameter set the stream defines; enough to size a frame.
	I64 i;

	for (i = 0; i < H264_SPS_MAX; i++)
		if (c->sps[i].valid)
			return &c->sps[i];

	return NULL;
}

I64 H264Peek(CH264Bits *b, I64 n)
{//Next n bits without consuming, zero padded past the end.
	I64 save = b->pos, v;
	Bool eof = b->eof;

	v = H264Read(b, n);
	b->pos = save;
	b->eof = eof;

	return v;
}

I64 H264MatchVLC(CH264Bits *b, U8 *len, U8 *bits, I64 n)
{//Index of the code that matches, or -1. Codes are at most 16 bits.
	I64 i, l, peek = H264Peek(b, 16);

	for (i = 0; i < n; i++)
	{
		l = len[i];
		if (l < 1 || l > 16)
			goto next_code;
		if (peek >> (16 - l) == bits[i])
		{
			H264Read(b, l);
			return i;
		}
next_code:;
	}

	return -1;
}

I64 H264CoeffToken(CH264Bits *b, I64 nc, I64 *_ones)
{//Returns total_coeff, with trailing ones through _ones. nc is the predicted
//count from the neighbouring blocks; -1 selects the chroma DC table.
	I64 tab, idx;

	*_ones = 0;
	if (nc < 0)
	{
		idx = H264MatchVLC(b, h264_chroma_dc_token_len,
						   h264_chroma_dc_token_bits, 20);
		if (idx < 0)
			return -1;
		*_ones = idx & 3;
		return idx >> 2;
	}
	if (nc < 2)
		tab = 0;
	else if (nc < 4)
		tab = 1;
	else if (nc < 8)
		tab = 2;
	else
		tab = 3;			//Fixed length, but the table carries it too.
	idx = H264MatchVLC(b, h264_coeff_token_len + tab * 68,
					   h264_coeff_token_bits + tab * 68, 68);
	if (idx < 0)
		return -1;
	*_ones = idx & 3;

	return idx >> 2;
}

I64 H264TotalZeros(CH264Bits *b, I64 total_coeff, Bool chroma_dc)
{
	I64 idx;

	if (chroma_dc)
	{
		idx = H264MatchVLC(b, h264_chroma_dc_zeros_len + (total_coeff - 1) * 4,
						   h264_chroma_dc_zeros_bits + (total_coeff - 1) * 4, 4);
		if (idx < 0)
			return -1;
		return idx;
	}
	idx = H264MatchVLC(b, h264_total_zeros_len + (total_coeff - 1) * 16,
					   h264_total_zeros_bits + (total_coeff - 1) * 16, 16);
	if (idx < 0)
		return -1;

	return idx;
}

I64 H264RunBefore(CH264Bits *b, I64 zeros_left)
{
	I64 idx, n = zeros_left;

	if (n > 7)
		n = 7;
	idx = H264MatchVLC(b, h264_run_len + (n - 1) * 16,
					   h264_run_bits + (n - 1) * 16, 16);
	if (idx < 0)
		return -1;

	return idx;
}

I64 H264Levels(CH264Bits *b, I64 total, I64 ones, I64 *level)
{//Level magnitudes and signs, in reverse scan order. Returns FALSE on a
//malformed prefix.
	I64 i, suffix_len = 0, prefix, sz, code, val, zeros;

	if (total > 10 && ones < 3)
		suffix_len = 1;
	for (i = 0; i < total; i++)
	{
		if (i < ones)
		{
			if (H264Read(b, 1))
				level[i] = -1;
			else
				level[i] = 1;
			goto next_level;
		}
		prefix = 0;
		while (!H264Read(b, 1))
		{
			prefix++;
			if (prefix > 32 || b->eof)
				return FALSE;
		}
		sz = suffix_len;
		if (prefix == 14 && !suffix_len)
			sz = 4;
		else if (prefix >= 15)
			sz = prefix - 3;
		code = 0;
		if (prefix < 15)
			code = prefix << suffix_len;
		else
			code = 15 << suffix_len;
		if (sz)
			code += H264Read(b, sz);
		if (prefix >= 15 && !suffix_len)
			code += 15;
		if (prefix >= 16)
			code += (1 << (prefix - 3)) - 4096;
		if (i == ones && ones < 3)
			code += 2;
		if (code & 1)
			val = -((code + 1) >> 1);
		else
			val = (code + 2) >> 1;
		level[i] = val;
		if (!suffix_len)
			suffix_len = 1;
		zeros = val;
		if (zeros < 0)
			zeros = -zeros;
		if (zeros > (3 << (suffix_len - 1)) && suffix_len < 6)
			suffix_len++;
next_level:;
	}

	return TRUE;
}

I64 H264Residual(CH264Bits *b, I64 nc, I64 max_coeff, I16 *block, U8 *scan)
{//One block into raster positions through scan[]. Returns the coefficient
//count, or -1 if the bitstream does not decode.
	I64 level[16], run[16];
	I64 total, ones, zeros_left, i, pos, r;
	Bool chroma_dc = ToBool(max_coeff == 4);

	total = H264CoeffToken(b, nc, &ones);
	if (total < 0 || total > max_coeff || ones > total)
		return -1;
	if (!total)
		return 0;
	if (!H264Levels(b, total, ones, level))
		return -1;

	zeros_left = 0;
	if (total < max_coeff)
	{
		zeros_left = H264TotalZeros(b, total, chroma_dc);
		if (zeros_left < 0)
			return -1;
	}
	for (i = 0; i < total - 1; i++)
	{
		r = 0;
		if (zeros_left > 0)
		{
			r = H264RunBefore(b, zeros_left);
			if (r < 0)
				return -1;
		}
		run[i]      = r;
		zeros_left -= r;
	}
	run[total - 1] = zeros_left;

	//Levels arrive highest frequency first; walk back down the scan.
	pos = total - 1;
	for (i = 0; i < total; i++)
		pos += run[i];
	for (i = 0; i < total; i++)
	{
		if (pos < 0 || pos >= max_coeff)
			return -1;
		block[scan[pos]] = level[i];
		pos -= run[i] + 1;
	}

	return total;
}

/***** macroblock layer, I slices *****/

#define H264_MB_NONE	0
#define H264_MB_I4X4	1
#define H264_MB_I16X16	2
#define H264_MB_IPCM	3

class CH264Dec
{
	CH264Ctx	*ctx;
	CH264SPS	*sps;
	CH264PPS	*pps;
	CH264Slice	 sl;
	CH264Bits	 b;
	I64			 mb_w, mb_h, mb_x, mb_y;
	I64			 qp, slice_id;
	//Per 4x4 block across the picture: coefficient counts feed the next
	//block's nC, intra modes feed the next block's mode prediction.
	U8			*nnz, *nnz_c[2], *modes;
	U8			*mb_slice;			//which slice owns each macroblock
	I64			 i16_mode, chroma_mode, cbp;
	Bool		 tx8x8;
	I16			 blk[16 * 25];
	I64			 mbs;
};

U0 H264DecFree(CH264Dec *d)
{
	Free(d->nnz);
	Free(d->nnz_c[0]);
	Free(d->nnz_c[1]);
	Free(d->modes);
	Free(d->mb_slice);
	d->nnz      = NULL;
	d->nnz_c[0] = NULL;
	d->nnz_c[1] = NULL;
	d->modes    = NULL;
	d->mb_slice = NULL;
}

Bool H264DecSize(CH264Dec *d, CH264SPS *s)
{
	if (d->nnz && d->mb_w == s->mb_width && d->mb_h == s->mb_height)
		return TRUE;
	H264DecFree(d);
	d->mb_w = s->mb_width;
	d->mb_h = s->mb_height;
	d->nnz      = CAlloc(d->mb_w * 4 * d->mb_h * 4);
	d->nnz_c[0] = CAlloc(d->mb_w * 2 * d->mb_h * 2);
	d->nnz_c[1] = CAlloc(d->mb_w * 2 * d->mb_h * 2);
	d->modes    = CAlloc(d->mb_w * 4 * d->mb_h * 4);
	d->mb_slice = CAlloc(d->mb_w * d->mb_h);

	return ToBool(d->nnz && d->modes && d->mb_slice);
}

I64 H264Blk4x4X(I64 blk)
{//Luma 4x4 blocks are numbered in Z order within the macroblock.
	return (blk & 1) + 2 * ((blk & 4) >> 2);
}

I64 H264Blk4x4Y(I64 blk)
{
	return ((blk & 2) >> 1) + 2 * ((blk & 8) >> 3);
}

Bool H264NeighbourOk(CH264Dec *d, I64 mb_x, I64 mb_y)
{//Only within the current slice: a neighbour in another slice does not exist
//for prediction.
	if (mb_x < 0 || mb_y < 0 || mb_x >= d->mb_w || mb_y >= d->mb_h)
		return FALSE;

	return ToBool(d->mb_slice[mb_y * d->mb_w + mb_x] == d->slice_id);
}

I64 H264NcAt(CH264Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 scale)
{//Coefficient count of the block at (x, y) if its macroblock is available.
	if (x < 0 || y < 0)
		return -1;
	if (!H264NeighbourOk(d, x / scale, y / scale))
		return -1;

	return plane[y * stride + x];
}

I64 H264Nc(CH264Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 scale)
{//nC is the mean of the left and above counts, or whichever exists.
	I64 a  = H264NcAt(d, plane, stride, x - 1, y, scale);
	I64 bb = H264NcAt(d, plane, stride, x, y - 1, scale);

	if (a >= 0 && bb >= 0)
		return (a + bb + 1) >> 1;
	if (a >= 0)
		return a;
	if (bb >= 0)
		return bb;

	return 0;
}

I64 H264PredIntraMode(CH264Dec *d, I64 x4, I64 y4)
{//The smaller of the neighbouring modes; DC when either is missing.
	I64 stride = d->mb_w * 4, a = -1, bb = -1;

	if (x4 > 0 && H264NeighbourOk(d, (x4 - 1) / 4, y4 / 4))
		a = d->modes[y4 * stride + x4 - 1];
	if (y4 > 0 && H264NeighbourOk(d, x4 / 4, (y4 - 1) / 4))
		bb = d->modes[(y4 - 1) * stride + x4];
	if (a < 0 || bb < 0)
		return 2;					//DC
	if (a < bb)
		return a;

	return bb;
}

Bool H264ResidualLuma(CH264Dec *d, I64 cbp_luma, Bool i16)
{//DC first for I_16x16, then the AC or full blocks the pattern selects.
	I64	 stride = d->mb_w * 4, blk, x4, y4, nc, n, off;
	I64	 max = 16, start = 0;

	if (i16)
	{
		x4 = d->mb_x * 4;
		y4 = d->mb_y * 4;
		nc = H264Nc(d, d->nnz, stride, x4, y4, 4);
		if (H264Residual(&d->b, nc, 16, d->blk, h264_zigzag4) < 0)
			return FALSE;
		max   = 15;
		start = 1;
	}
	for (blk = 0; blk < 16; blk++)
	{
		x4 = d->mb_x * 4 + H264Blk4x4X(blk);
		y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
		if (!(cbp_luma & 1 << (blk >> 2)))
		{
			d->nnz[y4 * stride + x4] = 0;
			goto next_luma;
		}
		nc  = H264Nc(d, d->nnz, stride, x4, y4, 4);
		off = 16 + blk * 16;
		n   = H264Residual(&d->b, nc, max, d->blk + off, h264_zigzag4 + start);
		if (n < 0)
			return FALSE;
		d->nnz[y4 * stride + x4] = n;
next_luma:;
	}

	return TRUE;
}

Bool H264ResidualChroma(CH264Dec *d, I64 cbp_chroma)
{
	I64	 stride = d->mb_w * 2, pl, blk, x2, y2, nc, n, off;
	U8	 dc_scan[4];

	dc_scan[0] = 0;
	dc_scan[1] = 1;
	dc_scan[2] = 2;
	dc_scan[3] = 3;
	if (!cbp_chroma)
	{
		for (pl = 0; pl < 2; pl++)
			for (blk = 0; blk < 4; blk++)
			{
				x2 = d->mb_x * 2 + (blk & 1);
				y2 = d->mb_y * 2 + ((blk >> 1) & 1);
				d->nnz_c[pl][y2 * stride + x2] = 0;
			}
		return TRUE;
	}
	//Chroma DC is a 2x2 block per plane, coded with its own token table.
	for (pl = 0; pl < 2; pl++)
	{
		off = 16 + 256 + pl * 4;
		if (H264Residual(&d->b, -1, 4, d->blk + off, dc_scan) < 0)
			return FALSE;
	}
	for (pl = 0; pl < 2; pl++)
		for (blk = 0; blk < 4; blk++)
		{
			x2 = d->mb_x * 2 + (blk & 1);
			y2 = d->mb_y * 2 + ((blk >> 1) & 1);
			if (cbp_chroma < 2)
			{
				d->nnz_c[pl][y2 * stride + x2] = 0;
				goto next_chroma;
			}
			nc  = H264Nc(d, d->nnz_c[pl], stride, x2, y2, 2);
			off = 16 + 256 + 8 + (pl * 4 + blk) * 16;
			n   = H264Residual(&d->b, nc, 15, d->blk + off, h264_zigzag4 + 1);
			if (n < 0)
				return FALSE;
			d->nnz_c[pl][y2 * stride + x2] = n;
next_chroma:;
		}

	return TRUE;
}

Bool H264DecodeMbI(CH264Dec *d)
{//One I macroblock: type, prediction modes, coded block pattern, residual.
	CH264Bits	*b = &d->b;
	I64			 stride = d->mb_w * 4, mb_type, t, blk, x4, y4, pred, mode;
	I64			 cbp_luma = 0, cbp_chroma = 0, i, n;

	mb_type = H264ReadUE(b);
	if (mb_type > 25)
		return FALSE;
	MemSet(d->blk, 0, sizeof(d->blk));

	if (mb_type == 25)
	{//I_PCM: byte aligned samples, no residual coding at all.
		b->pos = (b->pos + 7) & -8;
		n = 256 + 2 * 64;
		if (b->pos + n * 8 > b->end)
			return FALSE;
		b->pos += n * 8;
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->nnz[y4 * stride + x4] = 16;
			d->modes[y4 * stride + x4] = 2;
		}
		d->mb_slice[d->mb_y * d->mb_w + d->mb_x] = d->slice_id;
		return TRUE;
	}

	d->tx8x8 = FALSE;
	if (!mb_type)
	{//I_NxN: a prediction mode per 4x4 (or 8x8) block.
		if (d->pps->transform_8x8)
			d->tx8x8 = ToBool(H264Read(b, 1));
		n = 16;
		if (d->tx8x8)
			n = 4;
		for (i = 0; i < n; i++)
		{
			blk = i;
			if (d->tx8x8)
				blk = i * 4;
			x4   = d->mb_x * 4 + H264Blk4x4X(blk);
			y4   = d->mb_y * 4 + H264Blk4x4Y(blk);
			pred = H264PredIntraMode(d, x4, y4);
			mode = pred;
			if (!H264Read(b, 1))
			{
				mode = H264Read(b, 3);
				if (mode >= pred)
					mode++;
			}
			if (d->tx8x8)
			{//One mode covers the four 4x4 blocks of an 8x8.
				for (t = 0; t < 4; t++)
				{
					x4 = d->mb_x * 4 + H264Blk4x4X(blk + t);
					y4 = d->mb_y * 4 + H264Blk4x4Y(blk + t);
					d->modes[y4 * stride + x4] = mode;
				}
			}
			else
				d->modes[y4 * stride + x4] = mode;
		}
	}
	else
	{//I_16x16 packs the prediction mode and the pattern into the type.
		t = mb_type - 1;
		d->i16_mode = t & 3;
		cbp_chroma  = (t / 4) % 3;
		if (t >= 12)
			cbp_luma = 15;
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->modes[y4 * stride + x4] = 2;
		}
	}
	d->chroma_mode = H264ReadUE(b);
	if (d->chroma_mode > 3)
		return FALSE;

	if (!mb_type)
	{
		n = H264ReadUE(b);
		if (n > 47)
			return FALSE;
		d->cbp     = h264_golomb_to_intra_cbp[n];
		cbp_luma   = d->cbp & 15;
		cbp_chroma = d->cbp >> 4;
	}
	d->mb_slice[d->mb_y * d->mb_w + d->mb_x] = d->slice_id;

	if (cbp_luma || cbp_chroma || mb_type)
	{
		d->qp += H264ReadSE(b);
		d->qp = (d->qp + 52) % 52;
		if (!H264ResidualLuma(d, cbp_luma, ToBool(mb_type)))
			return FALSE;
		if (!H264ResidualChroma(d, cbp_chroma))
			return FALSE;
	}
	else
	{
		for (blk = 0; blk < 16; blk++)
		{
			x4 = d->mb_x * 4 + H264Blk4x4X(blk);
			y4 = d->mb_y * 4 + H264Blk4x4Y(blk);
			d->nnz[y4 * stride + x4] = 0;
		}
		H264ResidualChroma(d, 0);
	}

	return ToBool(!b->eof);
}

public CH264Dec *H264DecOpen(CH264Ctx *c)
{
	CH264Dec *d = CAlloc(sizeof(CH264Dec));

	d->ctx = c;

	return d;
}

public U0 H264DecClose(CH264Dec *d)
{
	if (!d)
		return;
	H264DecFree(d);
	Free(d);
}

public I64 H264DecodeSlice(CH264Dec *d, U8 *rbsp, I64 size)
{//Header then every macroblock of the slice. Returns the number of bits left
//over: a correct parse stops on the rbsp_stop_one_bit, so anything but 0..7
//means the walk went wrong. Negative on a rejected slice.
	CH264Ctx	*c = d->ctx;
	I64			 addr, left, i;

	if (!H264ParseSliceHeader(c, rbsp, size, &d->sl))
		return -1;
	if (d->sl.type != H264_SLICE_I)
		return -2;					//Only I slices decode so far.
	d->pps = &c->pps[d->sl.pps_id];
	d->sps = &c->sps[d->pps->sps_id];
	if (d->pps->cabac)
		return -3;					//CABAC is not implemented.
	if (!H264DecSize(d, d->sps))
		return -4;

	//The header parse left the reader positioned at the slice data.
	H264BitsInit(&d->b, rbsp, size);
	H264ParseSliceHeader(c, rbsp, size, &d->sl);
	d->b.pos = d->sl.header_bits;

	if (d->sl.first_mb == 0)
	{
		MemSet(d->mb_slice, 0xFF, d->mb_w * d->mb_h);
		d->slice_id = 0;
	}
	d->slice_id++;
	d->qp   = d->sl.qp;
	d->mbs  = 0;
	addr    = d->sl.first_mb;

	while (addr < d->mb_w * d->mb_h)
	{
		d->mb_x = addr % d->mb_w;
		d->mb_y = addr / d->mb_w;
		if (!H264DecodeMbI(d))
			return -5;
		d->mbs++;
		addr++;
		//more_rbsp_data(): a slice ends at the stop bit and its padding.
		left = d->b.end - d->b.pos;
		for (i = d->b.end - 1; i > d->b.pos; i--)
			if (rbsp[i >> 3] >> (7 - (i & 7)) & 1)
				break;
		if (i <= d->b.pos)
			break;
	}

	left = d->b.end - d->b.pos;
	for (i = d->b.end - 1; i >= 0; i--)
		if (rbsp[i >> 3] >> (7 - (i & 7)) & 1)
		{//Trailing bits: the stop bit is the last set bit in the payload.
			left = i - d->b.pos;
			break;
		}

	return left;
}
