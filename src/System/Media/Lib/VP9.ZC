	t0a = ((in[0 * stride] + in[4 * stride]) * 11585 + (1 << 13)) >> 14;
	t1a = ((in[0 * stride] - in[4 * stride]) * 11585 + (1 << 13)) >> 14;
	t2a = (in[2 * stride] *  6270 - in[6 * stride] * 15137 + (1 << 13)) >> 14;
	t3a = (in[2 * stride] * 15137 + in[6 * stride] *  6270 + (1 << 13)) >> 14;
	t4a = (in[1 * stride] *  3196 - in[7 * stride] * 16069 + (1 << 13)) >> 14;
	t5a = (in[5 * stride] * 13623 - in[3 * stride] *  9102 + (1 << 13)) >> 14;
	t6a = (in[5 * stride] *  9102 + in[3 * stride] * 13623 + (1 << 13)) >> 14;
	t7a = (in[1 * stride] * 16069 + in[7 * stride] *  3196 + (1 << 13)) >> 14;
	t0  = t0a + t3a;
	t1  = t1a + t2a;
	t2  = t1a - t2a;
	t3  = t0a - t3a;
	t4  = t4a + t5a;
	t5a = t4a - t5a;
	t7  = t7a + t6a;
	t6a = t7a - t6a;
	t5  = ((t6a - t5a) * 11585 + (1 << 13)) >> 14;
	t6  = ((t6a + t5a) * 11585 + (1 << 13)) >> 14;
	out[0] = t0 + t7;
	out[1] = t1 + t6;
	out[2] = t2 + t5;
	out[3] = t3 + t4;
	out[4] = t3 - t4;
	out[5] = t2 - t5;
	out[6] = t1 - t6;
	out[7] = t0 - t7;
