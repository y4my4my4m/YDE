U0 Vp9Iadst8(I64 *in, I64 stride, I64 *out)
{
	I64 t0, t0a, t1, t1a, t2, t2a, t3, t3a, t4, t4a, t5, t5a, t6, t6a, t7, t7a;
	t0a = 16305 * in[7 * stride] +  1606 * in[0 * stride];
	t1a =  1606 * in[7 * stride] - 16305 * in[0 * stride];
	t2a = 14449 * in[5 * stride] +  7723 * in[2 * stride];
	t3a =  7723 * in[5 * stride] - 14449 * in[2 * stride];
	t4a = 10394 * in[3 * stride] + 12665 * in[4 * stride];
	t5a = 12665 * in[3 * stride] - 10394 * in[4 * stride];
	t6a =  4756 * in[1 * stride] + 15679 * in[6 * stride];
	t7a = 15679 * in[1 * stride] -  4756 * in[6 * stride];
