	t1 = (t1a + t5a + (1 << 13)) >> 14;
	t2 = (t2a + t6a + (1 << 13)) >> 14;
	t3 = (t3a + t7a + (1 << 13)) >> 14;
	t4 = (t0a - t4a + (1 << 13)) >> 14;
	t5 = (t1a - t5a + (1 << 13)) >> 14;
	t6 = (t2a - t6a + (1 << 13)) >> 14;
	t7 = (t3a - t7a + (1 << 13)) >> 14;
