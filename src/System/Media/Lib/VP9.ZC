	t15  = t15a * 13623 + t14a *  9102;
	t0   = t0a + t4a;
	t1   = t1a + t5a;
	t2   = t2a + t6a;
	t3   = t3a + t7a;
	t4   = t0a - t4a;
	t5   = t1a - t5a;
	t6   = t2a - t6a;
	t7   = t3a - t7a;
	t8a  = ((1 << 13) + t8  + t12) >> 14;
	t9a  = ((1 << 13) + t9  + t13) >> 14;
	t10a = ((1 << 13) + t10 + t14) >> 14;
	t11a = ((1 << 13) + t11 + t15) >> 14;
	t12a = ((1 << 13) + t8  - t12) >> 14;
	t13a = ((1 << 13) + t9  - t13) >> 14;
	t14a = ((1 << 13) + t10 - t14) >> 14;
	t15a = ((1 << 13) + t11 - t15) >> 14;
	t4a  = t4 * 15137 + t5 *  6270;
	t5a  = t4 *  6270 - t5 * 15137;
	t6a  = t7 * 15137 - t6 *  6270;
	t7a  = t7 *  6270 + t6 * 15137;
	t12  = t12a * 15137 + t13a *  6270;
	t13  = t12a *  6270 - t13a * 15137;
	t14  = t15a * 15137 - t14a *  6270;
	t15  = t15a *  6270 + t14a * 15137;
	out[ 0] =   t0 + t2;
	out[15] = -(t1 + t3);
	t2a	 =   t0 - t2;
	t3a	 =   t1 - t3;
	out[ 3] = -(((1 << 13) + t4a + t6a) >> 14);
	out[12] =   ((1 << 13) + t5a + t7a) >> 14;
	t6	  =   ((1 << 13) + t4a - t6a) >> 14;
	t7	  =   ((1 << 13) + t5a - t7a) >> 14;
	out[ 1] = -(t8a + t10a);
	out[14] =   t9a + t11a;
	t10	 =   t8a - t10a;
	t11	 =   t9a - t11a;
	out[ 2] =   ((1 << 13) + t12 + t14) >> 14;
	out[13] = -(((1 << 13) + t13 + t15) >> 14);
	t14a	=   ((1 << 13) + t12 - t14) >> 14;
	t15a	=   ((1 << 13) + t13 - t15) >> 14;
	out[ 7] = (-(t2a  + t3a)  * 11585  + (1 << 13)) >> 14;
	out[ 8] = ( (t2a  - t3a)  * 11585  + (1 << 13)) >> 14;
	out[ 4] = ( (t7   + t6)   * 11585  + (1 << 13)) >> 14;
	out[11] = ( (t7   - t6)   * 11585  + (1 << 13)) >> 14;
	out[ 6] = ( (t11  + t10)  * 11585  + (1 << 13)) >> 14;
	out[ 9] = ( (t11  - t10)  * 11585  + (1 << 13)) >> 14;
	out[ 5] = (-(t14a + t15a) * 11585  + (1 << 13)) >> 14;
	out[10] = ( (t14a - t15a) * 11585  + (1 << 13)) >> 14;
}

U0 Vp9Idct32(I64 *in, I64 stride, I64 *out)
{
	I64 t0a  = ((in[0 * stride] + in[16 * stride]) * 11585		 + (1 << 13)) >> 14;
	I64 t1a  = ((in[0 * stride] - in[16 * stride]) * 11585		 + (1 << 13)) >> 14;
	I64 t2a  = (in[8 * stride] *  6270 - in[24 * stride] * 15137 + (1 << 13)) >> 14;
	I64 t3a  = (in[8 * stride] * 15137 + in[24 * stride] *  6270 + (1 << 13)) >> 14;
	I64 t4a  = (in[4 * stride] *  3196 - in[28 * stride] * 16069 + (1 << 13)) >> 14;
	I64 t7a  = (in[4 * stride] * 16069 + in[28 * stride] *  3196 + (1 << 13)) >> 14;
	I64 t5a  = (in[20 * stride] * 13623 - in[12 * stride] *  9102 + (1 << 13)) >> 14;
	I64 t6a  = (in[20 * stride] *  9102 + in[12 * stride] * 13623 + (1 << 13)) >> 14;
	I64 t8a  = (in[2 * stride] *  1606 - in[30 * stride] * 16305 + (1 << 13)) >> 14;
	I64 t15a = (in[2 * stride] * 16305 + in[30 * stride] *  1606 + (1 << 13)) >> 14;
	I64 t9a  = (in[18 * stride] * 12665 - in[14 * stride] * 10394 + (1 << 13)) >> 14;
	I64 t14a = (in[18 * stride] * 10394 + in[14 * stride] * 12665 + (1 << 13)) >> 14;
	I64 t10a = (in[10 * stride] *  7723 - in[22 * stride] * 14449 + (1 << 13)) >> 14;
	I64 t13a = (in[10 * stride] * 14449 + in[22 * stride] *  7723 + (1 << 13)) >> 14;
	I64 t11a = (in[26 * stride] * 15679 - in[6 * stride] *  4756 + (1 << 13)) >> 14;
	I64 t12a = (in[26 * stride] *  4756 + in[6 * stride] * 15679 + (1 << 13)) >> 14;
	I64 t16a = (in[1 * stride] *   804 - in[31 * stride] * 16364 + (1 << 13)) >> 14;
	I64 t31a = (in[1 * stride] * 16364 + in[31 * stride] *   804 + (1 << 13)) >> 14;
	I64 t17a = (in[17 * stride] * 12140 - in[15 * stride] * 11003 + (1 << 13)) >> 14;
	I64 t30a = (in[17 * stride] * 11003 + in[15 * stride] * 12140 + (1 << 13)) >> 14;
	I64 t18a = (in[9 * stride] *  7005 - in[23 * stride] * 14811 + (1 << 13)) >> 14;
	I64 t29a = (in[9 * stride] * 14811 + in[23 * stride] *  7005 + (1 << 13)) >> 14;
	I64 t19a = (in[25 * stride] * 15426 - in[7 * stride] *  5520 + (1 << 13)) >> 14;
	I64 t28a = (in[25 * stride] *  5520 + in[7 * stride] * 15426 + (1 << 13)) >> 14;
	I64 t20a = (in[5 * stride] *  3981 - in[27 * stride] * 15893 + (1 << 13)) >> 14;
	I64 t27a = (in[5 * stride] * 15893 + in[27 * stride] *  3981 + (1 << 13)) >> 14;
	I64 t21a = (in[21 * stride] * 14053 - in[11 * stride] *  8423 + (1 << 13)) >> 14;
	I64 t26a = (in[21 * stride] *  8423 + in[11 * stride] * 14053 + (1 << 13)) >> 14;
	I64 t22a = (in[13 * stride] *  9760 - in[19 * stride] * 13160 + (1 << 13)) >> 14;
	I64 t25a = (in[13 * stride] * 13160 + in[19 * stride] *  9760 + (1 << 13)) >> 14;
	I64 t23a = (in[29 * stride] * 16207 - in[3 * stride] *  2404 + (1 << 13)) >> 14;
	I64 t24a = (in[29 * stride] *  2404 + in[3 * stride] * 16207 + (1 << 13)) >> 14;
	I64 t0  = t0a  + t3a;
	I64 t1  = t1a  + t2a;
	I64 t2  = t1a  - t2a;
	I64 t3  = t0a  - t3a;
	I64 t4  = t4a  + t5a;
	I64 t5  = t4a  - t5a;
	I64 t6  = t7a  - t6a;
	I64 t7  = t7a  + t6a;
	I64 t8  = t8a  + t9a;
	I64 t9  = t8a  - t9a;
	I64 t10 = t11a - t10a;
	I64 t11 = t11a + t10a;
	I64 t12 = t12a + t13a;
	I64 t13 = t12a - t13a;
	I64 t14 = t15a - t14a;
	I64 t15 = t15a + t14a;
	I64 t16 = t16a + t17a;
	I64 t17 = t16a - t17a;
	I64 t18 = t19a - t18a;
	I64 t19 = t19a + t18a;
	I64 t20 = t20a + t21a;
	I64 t21 = t20a - t21a;
	I64 t22 = t23a - t22a;
	I64 t23 = t23a + t22a;
	I64 t24 = t24a + t25a;
	I64 t25 = t24a - t25a;
	I64 t26 = t27a - t26a;
	I64 t27 = t27a + t26a;
	I64 t28 = t28a + t29a;
	I64 t29 = t28a - t29a;
	I64 t30 = t31a - t30a;
	I64 t31 = t31a + t30a;
	t5a  = ((t6 - t5) * 11585			 + (1 << 13)) >> 14;
	t6a  = ((t6 + t5) * 11585			 + (1 << 13)) >> 14;
	t9a  = (  t14 *  6270 - t9  * 15137  + (1 << 13)) >> 14;
	t14a = (  t14 * 15137 + t9  *  6270  + (1 << 13)) >> 14;
	t10a = (-(t13 * 15137 + t10 *  6270) + (1 << 13)) >> 14;
	t13a = (  t13 *  6270 - t10 * 15137  + (1 << 13)) >> 14;
	t17a = (  t30 *  3196 - t17 * 16069  + (1 << 13)) >> 14;
	t30a = (  t30 * 16069 + t17 *  3196  + (1 << 13)) >> 14;
	t18a = (-(t29 * 16069 + t18 *  3196) + (1 << 13)) >> 14;
	t29a = (  t29 *  3196 - t18 * 16069  + (1 << 13)) >> 14;
	t21a = (  t26 * 13623 - t21 *  9102  + (1 << 13)) >> 14;
	t26a = (  t26 *  9102 + t21 * 13623  + (1 << 13)) >> 14;
	t22a = (-(t25 *  9102 + t22 * 13623) + (1 << 13)) >> 14;
	t25a = (  t25 * 13623 - t22 *  9102  + (1 << 13)) >> 14;
	t0a  = t0   + t7;
	t1a  = t1   + t6a;
	t2a  = t2   + t5a;
	t3a  = t3   + t4;
	t4a  = t3   - t4;
	t5   = t2   - t5a;
	t6   = t1   - t6a;
	t7a  = t0   - t7;
	t8a  = t8   + t11;
	t9   = t9a  + t10a;
	t10  = t9a  - t10a;
	t11a = t8   - t11;
	t12a = t15  - t12;
	t13  = t14a - t13a;
	t14  = t14a + t13a;
	t15a = t15  + t12;
	t16a = t16  + t19;
	t17  = t17a + t18a;
	t18  = t17a - t18a;
	t19a = t16  - t19;
	t20a = t23  - t20;
	t21  = t22a - t21a;
	t22  = t22a + t21a;
	t23a = t23  + t20;
	t24a = t24  + t27;
	t25  = t25a + t26a;
	t26  = t25a - t26a;
	t27a = t24  - t27;
	t28a = t31  - t28;
	t29  = t30a - t29a;
	t30  = t30a + t29a;
	t31a = t31  + t28;
	t10a = ((t13  - t10)  * 11585		   + (1 << 13)) >> 14;
	t13a = ((t13  + t10)  * 11585		   + (1 << 13)) >> 14;
	t11  = ((t12a - t11a) * 11585		   + (1 << 13)) >> 14;
	t12  = ((t12a + t11a) * 11585		   + (1 << 13)) >> 14;
	t18a = (  t29  *  6270 - t18  * 15137  + (1 << 13)) >> 14;
	t29a = (  t29  * 15137 + t18  *  6270  + (1 << 13)) >> 14;
	t19  = (  t28a *  6270 - t19a * 15137  + (1 << 13)) >> 14;
	t28  = (  t28a * 15137 + t19a *  6270  + (1 << 13)) >> 14;
	t20  = (-(t27a * 15137 + t20a *  6270) + (1 << 13)) >> 14;
	t27  = (  t27a *  6270 - t20a * 15137  + (1 << 13)) >> 14;
	t21a = (-(t26  * 15137 + t21  *  6270) + (1 << 13)) >> 14;
	t26a = (  t26  *  6270 - t21  * 15137  + (1 << 13)) >> 14;
	t0   = t0a + t15a;
	t1   = t1a + t14;
	t2   = t2a + t13a;
	t3   = t3a + t12;
	t4   = t4a + t11;
	t5a  = t5  + t10a;
	t6a  = t6  + t9;
	t7   = t7a + t8a;
	t8   = t7a - t8a;
	t9a  = t6  - t9;
	t10  = t5  - t10a;
	t11a = t4a - t11;
	t12a = t3a - t12;
	t13  = t2a - t13a;
	t14a = t1a - t14;
	t15  = t0a - t15a;
	t16  = t16a + t23a;
	t17a = t17  + t22;
	t18  = t18a + t21a;
	t19a = t19  + t20;
	t20a = t19  - t20;
	t21  = t18a - t21a;
	t22a = t17  - t22;
	t23  = t16a - t23a;
	t24  = t31a - t24a;
	t25a = t30  - t25;
	t26  = t29a - t26a;
	t27a = t28  - t27;
	t28a = t28  + t27;
	t29  = t29a + t26a;
	t30a = t30  + t25;
	t31  = t31a + t24a;
	t20  = ((t27a - t20a) * 11585 + (1 << 13)) >> 14;
	t27  = ((t27a + t20a) * 11585 + (1 << 13)) >> 14;
	t21a = ((t26  - t21 ) * 11585 + (1 << 13)) >> 14;
	t26a = ((t26  + t21 ) * 11585 + (1 << 13)) >> 14;
	t22  = ((t25a - t22a) * 11585 + (1 << 13)) >> 14;
	t25  = ((t25a + t22a) * 11585 + (1 << 13)) >> 14;
	t23a = ((t24  - t23 ) * 11585 + (1 << 13)) >> 14;
	t24a = ((t24  + t23 ) * 11585 + (1 << 13)) >> 14;
	out[ 0] = t0   + t31;
	out[ 1] = t1   + t30a;
	out[ 2] = t2   + t29;
	out[ 3] = t3   + t28a;
	out[ 4] = t4   + t27;
	out[ 5] = t5a  + t26a;
	out[ 6] = t6a  + t25;
	out[ 7] = t7   + t24a;
	out[ 8] = t8   + t23a;
	out[ 9] = t9a  + t22;
	out[10] = t10  + t21a;
	out[11] = t11a + t20;
	out[12] = t12a + t19a;
	out[13] = t13  + t18;
	out[14] = t14a + t17a;
	out[15] = t15  + t16;
	out[16] = t15  - t16;
	out[17] = t14a - t17a;
	out[18] = t13  - t18;
	out[19] = t12a - t19a;
	out[20] = t11a - t20;
	out[21] = t10  - t21a;
	out[22] = t9a  - t22;
	out[23] = t8   - t23a;
	out[24] = t7   - t24a;
	out[25] = t6a  - t25;
	out[26] = t5a  - t26a;
	out[27] = t4   - t27;
	out[28] = t3   - t28a;
	out[29] = t2   - t29;
	out[30] = t1   - t30a;
	out[31] = t0   - t31;
}

U0 Vp9Txfm1D(Bool adst, I64 sz, I64 *in, I64 stride, I64 *out)
{
	if (adst)
	{
		if (sz == 4)
			Vp9Iadst4(in, stride, out);
		else if (sz == 8)
			Vp9Iadst8(in, stride, out);
		else
			Vp9Iadst16(in, stride, out);
		return;
	}
	if (sz == 4)
		Vp9Idct4(in, stride, out);
	else if (sz == 8)
		Vp9Idct8(in, stride, out);
	else if (sz == 16)
		Vp9Idct16(in, stride, out);
	else
		Vp9Idct32(in, stride, out);
}

U0 Vp9AddTxfm(CVp9Dec *d, U8 *dst, I64 stride, I16 *coef, I64 tx, I64 txtp)
{//Columns then rows, as libavcodec's itxfm_wrapper. The enum names the row
//transform first, the function names the column one, so the two swap here.
	I64	*in = d->tin, *tmp = d->ttmp, *out = d->tout;
	I64	 sz = 4 << tx, bits = 4, i, j;
	Bool col_adst, row_adst;

	if (tx == TX_8X8)
		bits = 5;
	else if (tx >= TX_16X16)
		bits = 6;
	col_adst = ToBool(txtp == DCT_ADST || txtp == ADST_ADST);
	row_adst = ToBool(txtp == ADST_DCT || txtp == ADST_ADST);
	if (tx == TX_32X32)
	{
		col_adst = FALSE;
		row_adst = FALSE;
	}

	for (i = 0; i < sz * sz; i++)
		in[i] = coef[i];
	for (i = 0; i < sz; i++)
		Vp9Txfm1D(col_adst, sz, in + i, sz, tmp + i * sz);
	for (i = 0; i < sz; i++)
	{
		Vp9Txfm1D(row_adst, sz, tmp + i, sz, out);
		for (j = 0; j < sz; j++)
			dst[j * stride + i] = Vp9Clip8(dst[j * stride + i] +
										   ((out[j] + (1 << (bits - 1))) >> bits));
	}
}

/***** reconstruction *****/

U0 Vp9IWht4(I64 *in, I64 stride, I64 *out, Bool pass2)
{//Lossless transform, RFC-free: see libavcodec iwht4_1d.
	I64 t0, t1, t2, t3, t4;

	t0 = in[0];
	t1 = in[3 * stride];
	t2 = in[stride];
	t3 = in[2 * stride];
	if (!pass2)
	{
		t0 >>= 2;
		t1 >>= 2;
		t2 >>= 2;
		t3 >>= 2;
	}
	t0 += t2;
	t3 -= t1;
	t4 = (t0 - t3) >> 1;
	t1 = t4 - t1;
	t2 = t4 - t2;
	t0 -= t1;
	t3 += t2;
	out[0] = t0;
	out[1] = t1;
	out[2] = t2;
	out[3] = t3;
}

U0 Vp9AddWht(U8 *dst, I64 stride, I16 *coef)
{
	I64	 i, j, in[16], tmp[16], out[4];

	for (i = 0; i < 16; i++)
		in[i] = coef[i];
	for (i = 0; i < 4; i++)
		Vp9IWht4(in + i, 4, tmp + i * 4, FALSE);
	for (i = 0; i < 4; i++)
	{
		Vp9IWht4(tmp + i, 4, out, TRUE);
		for (j = 0; j < 4; j++)
			dst[j * stride + i] = Vp9Clip8(dst[j * stride + i] + out[j]);
	}
}

U0 Vp9Edges(U8 *plane, I64 stride, I64 px, I64 py, I64 pw, I64 ph,
			I64 size, I64 mode, Bool have_top, Bool have_left, Bool have_right,
			U8 *abuf, U8 *l, I64 *_mode)
{//Fills abuf[1..] (the corner at abuf[0]) and l, and returns the mode the
//available edges allow. Mirrors check_intra_mode.
	U8	*a = abuf + 1;
	I64	 need, i, have_px, want;

	*_mode = vp9_mode_conv[mode * 4 + have_left * 2 + have_top];
	mode = *_mode;
	need = vp9_edge_need[mode];

	if (need & 2)
	{
		want = size;
		have_px = pw - px;
		if (have_top)
		{
			i = want;
			if (i > have_px)
				i = have_px;
			MemCopy(a, plane + (py - 1) * stride + px, i);
			if (i < want)
				MemSet(a + i, a[i - 1], want - i);
		}
		else
			MemSet(a, 127, want);
		if (need & 4)
		{
			if (have_left && have_top)
				a[-1] = plane[(py - 1) * stride + px - 1];
			else if (have_top)
				a[-1] = 129;
			else
				a[-1] = 127;
		}
		if (size == 4 && need & 8)
		{//4x4 is the only size that predicts from above-right.
			if (have_top && have_right && have_px >= 8)
				MemCopy(a + 4, plane + (py - 1) * stride + px + 4, 4);
			else
				MemSet(a + 4, a[3], 4);
		}
	}
	if (need & 1)
	{
		if (have_left)
		{
			have_px = ph - py;
			if (have_px > size)
				have_px = size;
			if (need & 16)
			{//HOR_UP reads the column top-first.
				for (i = 0; i < have_px; i++)
					l[i] = plane[(py + i) * stride + px - 1];
				for (i = have_px; i < size; i++)
					l[i] = l[have_px - 1];
			}
			else
			{
				for (i = 0; i < have_px; i++)
					l[size - 1 - i] = plane[(py + i) * stride + px - 1];
				for (i = have_px; i < size; i++)
					l[size - 1 - i] = l[size - have_px];
			}
		}
		else
			MemSet(l, 129, size);
	}
}

U0 Vp9ReconPlane(CVp9Dec *d, U8 *plane, I64 stride, I64 pw, I64 ph, I64 bx,
				 I64 by, I64 bw, I64 end_x, I64 end_y, I64 tx, I64 mode,
				 Bool sub8, Bool chroma, I16 *coef, I64 *eobs, I64 lossless)
{//One plane of one block: predict and add residual, transform block by
//transform block, in the order the coefficients were read.
	I64	 step = 1 << tx, size = 4 << tx, x, y, n = 0, off = 0, m, pm, txtp;
	I64	 ncoef = 16 << (tx * 2);
	U8	 abuf[80], l[64];
	U8	*dst;

	for (y = 0; y < end_y; y += step)
		for (x = 0; x < end_x; x += step)
		{
			dst = plane + (by + y * 4) * stride + bx + x * 4;
			m = mode;
			if (sub8)
				m = d->mode[(y & 1) * 2 + (x & 1)];
			Vp9Edges(plane, stride, bx + x * 4, by + y * 4, pw, ph, size, m,
					 ToBool(d->row || y), ToBool(d->col > d->tile_col_start || x),
					 ToBool(x < bw - 1), abuf, l, &pm);
			Vp9IntraPred(dst, stride, pm, size, abuf + 1, l);
			if (eobs[n])
			{
				if (lossless)
					Vp9AddWht(dst, stride, coef + off);
				else
				{//Chroma always takes the DCT; only luma follows the mode.
					txtp = DCT_DCT;
					if (!chroma)
						txtp = vp9_intra_txfm_type[m];
					Vp9AddTxfm(d, dst, stride, coef + off, tx, txtp);
				}
			}
			off += ncoef;
			n++;
		}
}

U0 Vp9ReconBlock(CVp9Dec *d)
{//Both planes of one block, in the order the coefficients were read.
	I64	 w4 = vp9_bwh_tab[26 + d->bs * 2] << 1;
	I64	 h4 = vp9_bwh_tab[26 + d->bs * 2 + 1] << 1;
	I64	 end_x = (d->cols - d->col) * 2, end_y = (d->rows - d->row) * 2;
	I64	 pl;

	if (end_x > w4)
		end_x = w4;
	if (end_y > h4)
		end_y = h4;

	Vp9ReconPlane(d, d->py, d->ys, d->cols * 8, d->rows * 8, d->col * 8,
				  d->row * 8, w4, end_x, end_y, d->tx, d->mode[0],
				  ToBool(d->bs > BS_8x8 && d->tx == TX_4X4), FALSE, d->blk,
				  d->eob_y, d->lossless);

	end_x >>= 1;
	end_y >>= 1;
	w4 >>= 1;
	for (pl = 0; pl < 2; pl++)
	{
		if (!pl)
			Vp9ReconPlane(d, d->pu, d->uvs, d->cols * 4, d->rows * 4,
						  d->col * 4, d->row * 4, w4, end_x, end_y, d->uvtx,
						  d->uvmode, FALSE, TRUE, d->blk + 4096,
						  d->eob_uv, d->lossless);
		else
			Vp9ReconPlane(d, d->pv, d->uvs, d->cols * 4, d->rows * 4,
						  d->col * 4, d->row * 4, w4, end_x, end_y, d->uvtx,
						  d->uvmode, FALSE, TRUE, d->blk + 4096 + 1024,
						  d->eob_uv + 64, d->lossless);
	}
}

/***** loop filter (VP9 spec par. 8.8) *****/
//
//Mirrors libvpx vp9_filter_block_plane_non420: masks per 8x8, vertical edges
//of a superblock first, then its horizontal ones. On a keyframe every block is
//intra, so the skip-this-edge cases never apply.

I64 Vp9ClipS8(I64 v)
{
	if (v < -128)
		return -128;
	if (v > 127)
		return 127;

	return v;
}

U0 Vp9Filter(U8 *dst, I64 E, I64 I, I64 H, I64 stridea, I64 strideb, I64 wd)
{
	I64	 i, p7, p6, p5, p4, p3, p2, p1, p0, q0, q1, q2, q3, q4, q5, q6, q7;
	I64	 f, f1, f2;
	Bool fm, flat8in, flat8out, hev;

	for (i = 0; i < 8; i++)
	{
		p3 = dst[strideb * -4];
		p2 = dst[strideb * -3];
		p1 = dst[strideb * -2];
		p0 = dst[strideb * -1];
		q0 = dst[0];
		q1 = dst[strideb];
		q2 = dst[strideb * 2];
		q3 = dst[strideb * 3];
		fm = ToBool(AbsI64(p3 - p2) <= I && AbsI64(p2 - p1) <= I &&
					AbsI64(p1 - p0) <= I && AbsI64(q1 - q0) <= I &&
					AbsI64(q2 - q1) <= I && AbsI64(q3 - q2) <= I &&
					AbsI64(p0 - q0) * 2 + (AbsI64(p1 - q1) >> 1) <= E);
		if (!fm)
			goto next_line;

		flat8out = FALSE;
		flat8in  = FALSE;
		if (wd >= 16)
		{
			p7 = dst[strideb * -8];
			p6 = dst[strideb * -7];
			p5 = dst[strideb * -6];
			p4 = dst[strideb * -5];
			q4 = dst[strideb * 4];
			q5 = dst[strideb * 5];
			q6 = dst[strideb * 6];
			q7 = dst[strideb * 7];
			flat8out = ToBool(AbsI64(p7 - p0) <= 1 && AbsI64(p6 - p0) <= 1 &&
							  AbsI64(p5 - p0) <= 1 && AbsI64(p4 - p0) <= 1 &&
							  AbsI64(q4 - q0) <= 1 && AbsI64(q5 - q0) <= 1 &&
							  AbsI64(q6 - q0) <= 1 && AbsI64(q7 - q0) <= 1);
		}
		if (wd >= 8)
			flat8in = ToBool(AbsI64(p3 - p0) <= 1 && AbsI64(p2 - p0) <= 1 &&
							 AbsI64(p1 - p0) <= 1 && AbsI64(q1 - q0) <= 1 &&
							 AbsI64(q2 - q0) <= 1 && AbsI64(q3 - q0) <= 1);

		if (wd >= 16 && flat8out && flat8in)
		{
			dst[strideb * -7] = (p7 * 7 + p6 * 2 + p5 + p4 + p3 + p2 + p1 + p0 +
								 q0 + 8) >> 4;
			dst[strideb * -6] = (p7 * 6 + p6 + p5 * 2 + p4 + p3 + p2 + p1 + p0 +
								 q0 + q1 + 8) >> 4;
			dst[strideb * -5] = (p7 * 5 + p6 + p5 + p4 * 2 + p3 + p2 + p1 + p0 +
								 q0 + q1 + q2 + 8) >> 4;
			dst[strideb * -4] = (p7 * 4 + p6 + p5 + p4 + p3 * 2 + p2 + p1 + p0 +
								 q0 + q1 + q2 + q3 + 8) >> 4;
			dst[strideb * -3] = (p7 * 3 + p6 + p5 + p4 + p3 + p2 * 2 + p1 + p0 +
								 q0 + q1 + q2 + q3 + q4 + 8) >> 4;
			dst[strideb * -2] = (p7 * 2 + p6 + p5 + p4 + p3 + p2 + p1 * 2 + p0 +
								 q0 + q1 + q2 + q3 + q4 + q5 + 8) >> 4;
			dst[strideb * -1] = (p7 + p6 + p5 + p4 + p3 + p2 + p1 + p0 * 2 +
								 q0 + q1 + q2 + q3 + q4 + q5 + q6 + 8) >> 4;
			dst[0]            = (p6 + p5 + p4 + p3 + p2 + p1 + p0 + q0 * 2 +
								 q1 + q2 + q3 + q4 + q5 + q6 + q7 + 8) >> 4;
			dst[strideb]      = (p5 + p4 + p3 + p2 + p1 + p0 + q0 + q1 * 2 +
								 q2 + q3 + q4 + q5 + q6 + q7 * 2 + 8) >> 4;
			dst[strideb * 2]  = (p4 + p3 + p2 + p1 + p0 + q0 + q1 + q2 * 2 +
								 q3 + q4 + q5 + q6 + q7 * 3 + 8) >> 4;
			dst[strideb * 3]  = (p3 + p2 + p1 + p0 + q0 + q1 + q2 + q3 * 2 +
								 q4 + q5 + q6 + q7 * 4 + 8) >> 4;
			dst[strideb * 4]  = (p2 + p1 + p0 + q0 + q1 + q2 + q3 + q4 * 2 +
								 q5 + q6 + q7 * 5 + 8) >> 4;
			dst[strideb * 5]  = (p1 + p0 + q0 + q1 + q2 + q3 + q4 + q5 * 2 +
								 q6 + q7 * 6 + 8) >> 4;
			dst[strideb * 6]  = (p0 + q0 + q1 + q2 + q3 + q4 + q5 + q6 * 2 +
								 q7 * 7 + 8) >> 4;
		}
		else if (wd >= 8 && flat8in)
		{
			dst[strideb * -3] = (p3 * 3 + p2 * 2 + p1 + p0 + q0 + 4) >> 3;
			dst[strideb * -2] = (p3 * 2 + p2 + p1 * 2 + p0 + q0 + q1 + 4) >> 3;
			dst[strideb * -1] = (p3 + p2 + p1 + p0 * 2 + q0 + q1 + q2 + 4) >> 3;
			dst[0]            = (p2 + p1 + p0 + q0 * 2 + q1 + q2 + q3 + 4) >> 3;
			dst[strideb]      = (p1 + p0 + q0 + q1 * 2 + q2 + q3 * 2 + 4) >> 3;
			dst[strideb * 2]  = (p0 + q0 + q1 + q2 * 2 + q3 * 3 + 4) >> 3;
		}
		else
		{
			hev = ToBool(AbsI64(p1 - p0) > H || AbsI64(q1 - q0) > H);
			if (hev)
			{
				f = Vp9ClipS8(p1 - q1);
				f = Vp9ClipS8(3 * (q0 - p0) + f);
			}
			else
				f = Vp9ClipS8(3 * (q0 - p0));
			f1 = f + 4;
			if (f1 > 127)
				f1 = 127;
			f1 >>= 3;
			f2 = f + 3;
			if (f2 > 127)
				f2 = 127;
			f2 >>= 3;
			dst[strideb * -1] = Vp9Clip8(p0 + f2);
			dst[0]            = Vp9Clip8(q0 - f1);
			if (!hev)
			{
				f = (f1 + 1) >> 1;
				dst[strideb * -2] = Vp9Clip8(p1 + f);
				dst[strideb]      = Vp9Clip8(q1 - f);
			}
		}
next_line:
		dst += stridea;
	}
}

U0 Vp9LfLimits(CVp9Dec *d, I64 lvl, I64 *_e, I64 *_i, I64 *_h)
{
	I64 lim = lvl, sh = d->filt_sharp;

	if (sh > 0)
	{
		lim >>= 1;
		if (sh > 4)
			lim >>= 1;
		if (lim > 9 - sh)
			lim = 9 - sh;
	}
	if (lim < 1)
		lim = 1;
	*_i = lim;
	*_e = 2 * (lvl + 2) + lim;
	*_h = lvl >> 4;
}

U0 Vp9LfEdge(CVp9Dec *d, U8 *plane, I64 stride, I64 x, I64 y, I64 lvl,
			 I64 wd, Bool vert)
{//One 8-sample edge segment.
	I64 e, i, h;

	Vp9LfLimits(d, lvl, &e, &i, &h);
	if (vert)
		Vp9Filter(plane + y * stride + x, e, i, h, stride, 1, wd);
	else
		Vp9Filter(plane + y * stride + x, e, i, h, 1, stride, wd);
}

U0 Vp9LfPlane(CVp9Dec *d, U8 *plane, I64 stride, I64 ss, I64 sbr, I64 sbc,
			  Bool uv)
{
	I64	 mi_row = sbr * 8, mi_col = sbc * 8, step = 1 << ss;
	I64	 r, c, mr, mc, idx, lvl, tx, x, y, wd;
	Bool border_c, border_r;

	for (r = 0; r < 8; r++)
	{
		mr = mi_row + r;
		if (mr >= d->rows || r & (step - 1))
			goto next_vrow;
		y = (mr * 8) >> ss;
		for (c = 0; c < 8; c++)
		{
			mc = mi_col + c;
			if (mc >= d->cols || c & (step - 1))
				goto next_vcol;
			idx = mr * d->cols + mc;
			lvl = d->lf_lvl[idx];
			if (!lvl)
				goto next_vcol;
			if (uv)
				tx = d->lf_uvtx[idx];
			else
				tx = d->lf_tx[idx];
			x = (mc * 8) >> ss;
			border_c = ToBool(ss && mc == d->cols - 1);
			wd = 0;
			if (tx == TX_32X32)
			{
				if (!((c >> ss) & 3))
					wd = 16;
			}
			else if (tx == TX_16X16)
			{
				if (!((c >> ss) & 1))
					wd = 16;
			}
			else if (tx == TX_8X8 || !((c >> ss) & 3))
				wd = 8;
			else
				wd = 4;
			if (wd == 16 && border_c)
				wd = 8;
			//The frame's left edge has no block edge, but its interior 4x4
			//edge is still filtered.
			if (wd && mc)
				Vp9LfEdge(d, plane, stride, x, y, lvl, wd, TRUE);
			if (!tx && !border_c)
				Vp9LfEdge(d, plane, stride, x + 4, y, lvl, 4, TRUE);
next_vcol:;
		}
next_vrow:;
	}

	for (r = 0; r < 8; r++)
	{
		mr = mi_row + r;
		if (mr >= d->rows || r & (step - 1))
			goto next_hrow;
		y = (mr * 8) >> ss;
		border_r = ToBool(ss && mr == d->rows - 1);
		for (c = 0; c < 8; c++)
		{
			mc = mi_col + c;
			if (mc >= d->cols || c & (step - 1))
				goto next_hcol;
			idx = mr * d->cols + mc;
			lvl = d->lf_lvl[idx];
			if (!lvl)
				goto next_hcol;
			if (uv)
				tx = d->lf_uvtx[idx];
			else
				tx = d->lf_tx[idx];
			x = (mc * 8) >> ss;
			wd = 0;
			if (tx == TX_32X32)
			{
				if (!((r >> ss) & 3))
					wd = 16;
			}
			else if (tx == TX_16X16)
			{
				if (!((r >> ss) & 1))
					wd = 16;
			}
			else if (tx == TX_8X8 || !((r >> ss) & 3))
				wd = 8;
			else
				wd = 4;
			if (wd == 16 && border_r)
				wd = 8;
			if (wd && mr)
				Vp9LfEdge(d, plane, stride, x, y, lvl, wd, FALSE);
			if (!tx && !border_r)
				Vp9LfEdge(d, plane, stride, x, y + 4, lvl, 4, FALSE);
next_hcol:;
		}
next_hrow:;
	}
}

U0 Vp9LoopFilter(CVp9Dec *d)
{
	I64 sbr, sbc;

	if (!d->filt_level)
		return;
	for (sbr = 0; sbr < d->sb_rows; sbr++)
		for (sbc = 0; sbc < d->sb_cols; sbc++)
		{
			Vp9LfPlane(d, d->py, d->ys, 0, sbr, sbc, FALSE);
			Vp9LfPlane(d, d->pu, d->uvs, 1, sbr, sbc, TRUE);
			Vp9LfPlane(d, d->pv, d->uvs, 1, sbr, sbc, TRUE);
		}
}

U0 Vp9DecodeBlock(CVp9Dec *d, I64 row, I64 col, I64 bl, I64 bp)
{
	I64 w4, h4, pl, n;

	d->row  = row;
	d->col  = col;
	d->row7 = row & 7;
	d->bs   = bl * 3 + bp;
	Vp9DecodeMode(d);

	w4 = vp9_bwh_tab[26 + d->bs * 2];
	h4 = vp9_bwh_tab[26 + d->bs * 2 + 1];
	d->uvtx = d->tx;
	if (w4 * 2 == (1 << d->tx) || h4 * 2 == (1 << d->tx))
		d->uvtx--;			//4:2:0 halves both dimensions

	if (!d->skip)
		Vp9DecodeCoeffs(d);
	else
	{
		MemSet(d->eob_y, 0, 256 * sizeof(I64));
		MemSet(d->eob_uv, 0, 128 * sizeof(I64));
		MemSet(d->a_ynnz + d->col * 2, 0, w4 * 2);
		MemSet(d->l_ynnz + d->row7 * 2, 0, h4 * 2);
		for (pl = 0; pl < 2; pl++)
		{
			MemSet(d->a_uvnnz + pl * d->a_cols + d->col, 0, w4);
			MemSet(d->l_uvnnz + pl * 8 + d->row7, 0, h4);
		}
	}
	Vp9ReconBlock(d);
	n = w4;
	if (n > d->cols - d->col)
		n = d->cols - d->col;
	for (pl = 0; pl < h4 && d->row + pl < d->rows; pl++)
	{
		MemSet(d->lf_lvl + (d->row + pl) * d->cols + d->col,
			   d->seg[d->seg_id].lflvl[0][0], n);
		MemSet(d->lf_tx + (d->row + pl) * d->cols + d->col, d->tx, n);
		MemSet(d->lf_uvtx + (d->row + pl) * d->cols + d->col, d->uvtx, n);
	}
	d->blocks++;
}

U0 Vp9DecodeSb(CVp9Dec *d, I64 row, I64 col, I64 bl)
{//Recursive quad split down to 8x8, then one more level inside the block.
	CVp8Br	*br = &d->tc;
	I64		 hbs = 4 >> bl, bp, c;
	U8		*p;

	c = (d->a_part[col] >> (3 - bl)) & 1 |
		((d->l_part[row & 7] >> (3 - bl)) & 1) << 1;
	p = vp9_kf_partition_probs + (bl * 4 + c) * 3;

	if (bl == 3)
	{
		bp = Vp9Tree(br, vp9_partition_tree, p);
		Vp9DecodeBlock(d, row, col, bl, bp);
		return;
	}
	if (col + hbs < d->cols)
	{
		if (row + hbs < d->rows)
		{
			bp = Vp9Tree(br, vp9_partition_tree, p);
			if (!bp)
				Vp9DecodeBlock(d, row, col, bl, bp);
			else if (bp == 1)
			{
				Vp9DecodeBlock(d, row, col, bl, bp);
				Vp9DecodeBlock(d, row + hbs, col, bl, bp);
			}
			else if (bp == 2)
			{
				Vp9DecodeBlock(d, row, col, bl, bp);
				Vp9DecodeBlock(d, row, col + hbs, bl, bp);
			}
			else
			{
				Vp9DecodeSb(d, row, col, bl + 1);
				Vp9DecodeSb(d, row, col + hbs, bl + 1);
				Vp9DecodeSb(d, row + hbs, col, bl + 1);
				Vp9DecodeSb(d, row + hbs, col + hbs, bl + 1);
			}
		}
		else if (Vp8Bit(br, p[1]))
		{
			Vp9DecodeSb(d, row, col, bl + 1);
			Vp9DecodeSb(d, row, col + hbs, bl + 1);
		}
		else
			Vp9DecodeBlock(d, row, col, bl, 1);
	}
	else if (row + hbs < d->rows)
	{
		if (Vp8Bit(br, p[2]))
		{
			Vp9DecodeSb(d, row, col, bl + 1);
			Vp9DecodeSb(d, row + hbs, col, bl + 1);
		}
		else
			Vp9DecodeBlock(d, row, col, bl, 2);
	}
	else
		Vp9DecodeSb(d, row, col, bl + 1);
}

Bool Vp9Alloc(CVp9Dec *d)
{
	I64 pad = d->cols + 16;

	if (d->a_cols == pad && d->a_part)
		return TRUE;
	Free(d->a_part);
	Free(d->a_skip);
	Free(d->a_tx);
	Free(d->a_ymode);
	Free(d->a_ynnz);
	Free(d->a_uvnnz);
	Free(d->seg_map);
	Free(d->blk);
	d->a_cols  = pad;
	d->a_part  = CAlloc(pad);
	d->a_skip  = CAlloc(pad);
	d->a_tx    = CAlloc(pad);
	d->a_ymode = CAlloc(pad * 2);
	d->a_ynnz  = CAlloc(pad * 2);
	d->a_uvnnz = CAlloc(pad * 2);
	d->seg_map = CAlloc(d->cols * d->rows + 64);
	Free(d->lf_lvl);
	Free(d->lf_tx);
	Free(d->lf_uvtx);
	d->lf_lvl  = CAlloc(d->cols * d->rows + 64);
	d->lf_tx   = CAlloc(d->cols * d->rows + 64);
	d->lf_uvtx = CAlloc(d->cols * d->rows + 64);
	d->blk     = MAlloc(6144 * sizeof(I16));
	Free(d->py);
	Free(d->pu);
	Free(d->pv);
	d->ys   = d->sb_cols * 64;
	d->ph   = d->sb_rows * 64;
	d->uvs  = d->ys / 2;
	d->uvph = d->ph / 2;
	d->py = CAlloc(d->ys * d->ph);
	d->pu = CAlloc(d->uvs * d->uvph);
	d->pv = CAlloc(d->uvs * d->uvph);

	return ToBool(d->a_part && d->blk && d->seg_map && d->py && d->pu && d->pv);
}

Bool Vp9DecodeTiles(CVp9Dec *d, U8 *data, I64 size)
{
	I64	 rows = 1 << d->log2_tile_rows, cols = 1 << d->log2_tile_cols;
	I64	 tr, tc, row, col, rs, re, cs, ce, tsize;

	MemSet(d->a_part, 0, d->a_cols);
	MemSet(d->a_skip, 0, d->a_cols);
	MemSet(d->a_tx, 0, d->a_cols);
	MemSet(d->a_ymode, 2, d->a_cols * 2);		//DC_PRED
	MemSet(d->a_ynnz, 0, d->a_cols * 2);
	MemSet(d->a_uvnnz, 0, d->a_cols * 2);
	d->blocks = 0;
	d->slack = 0;

	for (tr = 0; tr < rows; tr++)
	{
		rs = ((tr * d->sb_rows) >> d->log2_tile_rows) << 3;
		re = (((tr + 1) * d->sb_rows) >> d->log2_tile_rows) << 3;
		if (re > d->rows)
			re = d->rows;
		for (tc = 0; tc < cols; tc++)
		{
			cs = ((tc * d->sb_cols) >> d->log2_tile_cols) << 3;
			ce = (((tc + 1) * d->sb_cols) >> d->log2_tile_cols) << 3;
			if (ce > d->cols)
				ce = d->cols;

			if (tr == rows - 1 && tc == cols - 1)
				tsize = size;
			else
			{
				if (size < 4)
					return FALSE;
				tsize = data[0] << 24 | data[1] << 16 | data[2] << 8 | data[3];
				data += 4;
				size -= 4;
			}
			if (tsize > size || tsize < 1)
				return FALSE;
			Vp8BrInit(&d->tc, data, tsize);
			if (Vp8Bit(&d->tc, 128))
				return FALSE;		//Marker bit.
			d->tile_col_start = cs;

			for (row = rs; row < re; row += 8)
			{
				MemSet(d->l_part, 0, 8);
				MemSet(d->l_skip, 0, 8);
				MemSet(d->l_tx, 0, 8);
				MemSet(d->l_ymode, 2, 16);
				MemSet(d->l_ynnz, 0, 16);
				MemSet(d->l_uvnnz, 0, 16);
				for (col = cs; col < ce; col += 8)
					Vp9DecodeSb(d, row, col, 0);
				if (d->tc.eof)
					return FALSE;
				Yield;
			}
			d->slack += tsize - d->tc.pos;
			data += tsize;
			size -= tsize;
		}
	}

	return TRUE;
}

public Bool Vp9DecodeFrame(CVp9Dec *d, U8 *buf, I64 size)
{//Header, then every tile. Reconstruction is not implemented: this parses the
//frame and leaves the dequantised coefficients of the last block behind.
	I64 off;

	if (!Vp9FrameHeader(d, buf, size))
		return FALSE;
	if (!Vp9Alloc(d))
	{
		d->fail = 9;
		return FALSE;
	}
	off = d->uncompressed_size + d->header_size;
	if (!Vp9DecodeTiles(d, buf + off, size - off))
	{
		d->fail = 10;
		return FALSE;
	}
	Vp9LoopFilter(d);

	return TRUE;
}

/***** decoder context *****/

public CVp9Dec *Vp9CtxOpen()
{
	return CAlloc(sizeof(CVp9Dec));
}

public U0 Vp9CtxClose(CVp9Dec *d)
{
	if (!d)
		return;
	Free(d->argb);
	Free(d->a_part);
	Free(d->a_skip);
	Free(d->a_tx);
	Free(d->a_ymode);
	Free(d->a_ynnz);
	Free(d->a_uvnnz);
	Free(d->seg_map);
	Free(d->lf_lvl);
	Free(d->lf_tx);
	Free(d->lf_uvtx);
	Free(d->blk);
	Free(d->py);
	Free(d->pu);
	Free(d->pv);
	Free(d);
}

U32 *Vp9ToArgb(CVp9Dec *d)
{//BT.601, full frame. The buffer belongs to the decoder; the next frame
//overwrites it.
	U32	*argb;
	I64	 x, y, cy, cu, cv, r, g, b;

	if (d->argb_pixels < d->w * d->h)
	{
		Free(d->argb);
		d->argb        = MAlloc(d->w * d->h * sizeof(U32));
		d->argb_pixels = d->w * d->h;
	}
	argb = d->argb;
	if (!argb)
		return NULL;

	for (y = 0; y < d->h; y++)
	{
		for (x = 0; x < d->w; x++)
		{
			cy = 298 * (d->py[y * d->ys + x] - 16);
			cu = d->pu[(y >> 1) * d->uvs + (x >> 1)] - 128;
			cv = d->pv[(y >> 1) * d->uvs + (x >> 1)] - 128;
			r = Vp9Clip8((cy + 409 * cv + 128) >> 8);
			g = Vp9Clip8((cy - 100 * cu - 208 * cv + 128) >> 8);
			b = Vp9Clip8((cy + 516 * cu + 128) >> 8);
			argb[y * d->w + x] = 0xFF000000 | r << 16 | g << 8 | b;
		}
		if (!(y & 63))
			Yield;
	}

	return argb;
}

public Bool Vp9CtxDecodeRaw(CVp9Dec *d, U8 *buf, I64 size)
{//One frame into the decoder's planes, no colour conversion.
	if (!d || !buf || size < 3)
		return FALSE;

	return Vp9DecodeFrame(d, buf, size);
}

public Bool Vp9CtxShown(CVp9Dec *d)
{//An unshown frame updates references only.
	if (!d)
		return FALSE;
	return d->show;
}

public U32 *Vp9CtxArgb(CVp9Dec *d, I64 *out_w, I64 *out_h)
{//The last decoded frame in ARGB. NULL when it was a reference update. The
//buffer belongs to the decoder and is overwritten by the next conversion.
	*out_w = 0;
	*out_h = 0;
	if (!d || !d->show)
		return NULL;
	*out_w = d->w;
	*out_h = d->h;

	return Vp9ToArgb(d);
}

public U32 *Vp9CtxDecode(CVp9Dec *d, U8 *buf, I64 size, I64 *out_w, I64 *out_h)
{//One frame. NULL when the frame cannot be decoded or is not shown. Inter
//frames are rejected, so a stream decodes as its keyframes.
	*out_w = 0;
	*out_h = 0;
	if (!Vp9CtxDecodeRaw(d, buf, size))
		return NULL;

	return Vp9CtxArgb(d, out_w, out_h);
}
