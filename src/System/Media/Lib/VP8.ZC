//VP8 lossy decoder (RFC 6386). Keyframe/intra only; no loop filter, no inter
//prediction. Tables live in GrWEBPTables.ZC.
//
//Split out of GrWEBP.ZC so the still-image and video paths share one copy:
//ZealC has a single global symbol table.

#define VP8_MAXDIM		4000

/***** VP8 boolean decoder (RFC 6386 par. 7) *****/

class CVp8Br
{
	U8	*buf;
	I64	 pos, end;
	I64	 range, value, bit_count;
	Bool eof;
};

U0 Vp8BrInit(CVp8Br *br, U8 *buf, I64 size)
{
	br->buf = buf;
	br->pos = 0;
	br->end = size;
	br->range = 255;
	br->value = 0;
	br->bit_count = 0;
	br->eof = FALSE;
	if (size >= 1)
		br->value = buf[0] << 8;
	if (size >= 2)
		br->value |= buf[1];
	br->pos = 2;
}

I64 Vp8Bit(CVp8Br *br, I64 prob)
{
	I64 split = 1 + (((br->range - 1) * prob) >> 8);	//RFC 6386 par. 7.3
	I64 SPLIT = split << 8;
	I64 ret;

	if (br->value >= SPLIT)
	{
		ret = 1;
		br->range -= split;
		br->value -= SPLIT;
	}
	else
	{
		ret = 0;
		br->range = split;
	}
	while (br->range < 128)
	{
		br->value <<= 1;
		br->range <<= 1;
		br->bit_count++;
		if (br->bit_count == 8)
		{
			br->bit_count = 0;
			if (br->pos < br->end)
				br->value |= br->buf[br->pos];
			else
				br->eof = TRUE;
			br->pos++;
		}
	}
	return ret;
}

I64 Vp8Val(CVp8Br *br, I64 nbits)
{//MSB-first literal bits (prob 128).
	I64 v = 0;

	while (nbits--)
		v = v << 1 | Vp8Bit(br, 128);
	return v;
}

I64 Vp8SVal(CVp8Br *br, I64 nbits)
{//Value then sign bit.
	I64 v = Vp8Val(br, nbits);

	if (Vp8Bit(br, 128))
		return -v;
	return v;
}


#define VP8_BPS		32
//Scratch layout: Y at row 1 col 4 (so -1 row/col + 4 top-right bytes fit);
//U at row 20 col 4; V at row 20 col 20.
#define VP8_Y_OFF	(VP8_BPS * 1 + 4)
#define VP8_U_OFF	(VP8_BPS * 20 + 4)
#define VP8_V_OFF	(VP8_BPS * 20 + 20)

class CVp8Dec
{
	I64	 w, h, mb_w, mb_h;
	CVp8Br	 br;			//Partition 0.
	CVp8Br	 parts[8];
	I64	 num_parts;
	Bool use_segment, update_map, absolute_delta;
	I64	 seg_quant[4], seg_prob[3];
	Bool use_skip;
	I64	 skip_p;
	//Quant per segment: y1dc,y1ac, y2dc,y2ac, uvdc,uvac.
	I64	 qm[4][6];
	//Coeff probs [4][8][3][11].
	U8	*probs;
	//Per-MB state.
	U8	*intra_t;			//4 * mb_w.
	U8	 intra_l[4];
	U8	*nz_t;				//mb_w + 1 (entry 0 = left).
	U8	*nzdc_t;
	U8	 imodes[16];
	I64	 uvmode;
	Bool is_i4x4, skip;
	I64	 segment;
	I64	 coeffs[400];		//25 blocks max, 16 each (384 used).
	U8	*top_y, *top_u, *top_v;	//mb_w * 16 / 8 / 8.
	U8	*scratch;			//VP8_BPS * 40.
	U8	*py, *pu, *pv;
	I64	 ys, uvs;			//Strides.
	//Loop filter: header values, per-segment strength, and per-MB level plus
	//the inner-edge flag recorded during decode.
	Bool	 filt_simple;
	I64		 filt_level, filt_sharp;
	I64		 seg_filt[4];
	Bool	 lf_delta_en;
	I64		 lf_ref_delta[4], lf_mode_delta[4];
	U8		*mb_flevel, *mb_inner;
};

I64 Vp8Clip127(I64 v, I64 m)
{
	if (v < 0)
		return 0;
	if (v > m)
		return m;
	return v;
}

U0 Vp8ParseQuant(CVp8Dec *d)
{
	CVp8Br	*br = &d->br;
	I64	 base_q = Vp8Val(br, 7);
	I64	 dqy1_dc = 0, dqy2_dc = 0, dqy2_ac = 0, dquv_dc = 0, dquv_ac = 0;
	I64	 i, q;

	if (Vp8Bit(br, 128))
		dqy1_dc = Vp8SVal(br, 4);
	if (Vp8Bit(br, 128))
		dqy2_dc = Vp8SVal(br, 4);
	if (Vp8Bit(br, 128))
		dqy2_ac = Vp8SVal(br, 4);
	if (Vp8Bit(br, 128))
		dquv_dc = Vp8SVal(br, 4);
	if (Vp8Bit(br, 128))
		dquv_ac = Vp8SVal(br, 4);

	for (i = 0; i < 4; i++)
	{
		if (d->use_segment)
		{
			q = d->seg_quant[i];
			if (!d->absolute_delta)
				q += base_q;
		}
		else
			q = base_q;
		d->qm[i][0] = vp8_dc_q[Vp8Clip127(q + dqy1_dc, 127)];
		d->qm[i][1] = vp8_ac_q[Vp8Clip127(q, 127)];
		d->qm[i][2] = vp8_dc_q[Vp8Clip127(q + dqy2_dc, 127)] * 2;
		d->qm[i][3] = (vp8_ac_q[Vp8Clip127(q + dqy2_ac, 127)] * 101581) >> 16;
		if (d->qm[i][3] < 8)
			d->qm[i][3] = 8;
		d->qm[i][4] = vp8_dc_q[Vp8Clip127(q + dquv_dc, 117)];
		d->qm[i][5] = vp8_ac_q[Vp8Clip127(q + dquv_ac, 127)];
	}
}

I64 Vp8LargeVal(CVp8Br *br, U8 *p)
{
	I64 v, bit1, bit0, cat;
	U8 *tab;

	if (!Vp8Bit(br, p[3]))
	{
		if (!Vp8Bit(br, p[4]))
			v = 2;
		else
			v = 3 + Vp8Bit(br, p[5]);
	}
	else
	{
		if (!Vp8Bit(br, p[6]))
		{
			if (!Vp8Bit(br, p[7]))
				v = 5 + Vp8Bit(br, 159);
			else
			{
				v = 7 + 2 * Vp8Bit(br, 165);
				v += Vp8Bit(br, 145);
			}
		}
		else
		{
			bit1 = Vp8Bit(br, p[8]);
			bit0 = Vp8Bit(br, p[9 + bit1]);
			cat = 2 * bit1 + bit0;
			v = 0;
			if (cat == 0)
				tab = vp8_cat3;
			else if (cat == 1)
				tab = vp8_cat4;
			else if (cat == 2)
				tab = vp8_cat5;
			else
				tab = vp8_cat6;
			while (*tab)
			{
				v += v + Vp8Bit(br, *tab);
				tab++;
			}
			v += 3 + (8 << cat);
		}
	}
	return v;
}

I64 Vp8GetCoeffs(CVp8Br *br, U8 *probs, I64 type, I64 ctx, I64 dq0, I64 dq1,
				 I64 first, I64 *out)
{//probs = d->probs; band pointers computed via vp8_bands. Returns last nz + 1.
	I64	 n, v;
	U8	*p;

	p = probs + (type * 8 + vp8_bands[first]) * 33 + ctx * 11;
	n = first;
	while (n < 16)
	{
		if (!Vp8Bit(br, p[0]))
			return n;
		while (!Vp8Bit(br, p[1]))
		{
			n++;
			if (n == 16)
				return 16;
			p = probs + (type * 8 + vp8_bands[n]) * 33;
		}
		if (!Vp8Bit(br, p[2]))
		{
			v = 1;
			p = probs + (type * 8 + vp8_bands[n + 1]) * 33 + 1 * 11;
		}
		else
		{
			v = Vp8LargeVal(br, p);
			p = probs + (type * 8 + vp8_bands[n + 1]) * 33 + 2 * 11;
		}
		if (Vp8Bit(br, 128))
			v = -v;
		if (n > 0)
			out[vp8_zigzag[n]] = v * dq1;
		else
			out[vp8_zigzag[n]] = v * dq0;
		n++;
	}
	return 16;
}

U0 Vp8TransformWHT(I64 *in, I64 *out)
{
	I64 tmp[16], i, a0, a1, a2, a3, dc;

	for (i = 0; i < 4; i++)
	{
		a0 = in[0 + i] + in[12 + i];
		a1 = in[4 + i] + in[8 + i];
		a2 = in[4 + i] - in[8 + i];
		a3 = in[0 + i] - in[12 + i];
		tmp[0 + i] = a0 + a1;
		tmp[8 + i] = a0 - a1;
		tmp[4 + i] = a3 + a2;
		tmp[12 + i] = a3 - a2;
	}
	for (i = 0; i < 4; i++)
	{
		dc = tmp[0 + i * 4] + 3;
		a0 = dc + tmp[3 + i * 4];
		a1 = tmp[1 + i * 4] + tmp[2 + i * 4];
		a2 = tmp[1 + i * 4] - tmp[2 + i * 4];
		a3 = dc - tmp[3 + i * 4];
		out[0] = (a0 + a1) >> 3;
		out[16] = (a3 + a2) >> 3;
		out[32] = (a0 - a1) >> 3;
		out[48] = (a3 - a2) >> 3;
		out += 64;
	}
}

I64 Vp8Mul1(I64 a)
{
	return ((a * 20091) >> 16) + a;
}

I64 Vp8Mul2(I64 a)
{
	return (a * 35468) >> 16;
}

U8 Vp8Clip8(I64 v)
{
	if (v < 0)
		return 0;
	if (v > 255)
		return 255;
	return v;
}

U0 Vp8Transform(I64 *in, U8 *dst)
{//4x4 inverse DCT, adds to prediction in dst (stride VP8_BPS).
	I64 C[16], *tmp = C, i, a, b, c, d, dc;

	for (i = 0; i < 4; i++)
	{
		a = in[0] + in[8];
		b = in[0] - in[8];
		c = Vp8Mul2(in[4]) - Vp8Mul1(in[12]);
		d = Vp8Mul1(in[4]) + Vp8Mul2(in[12]);
		tmp[0] = a + d;
		tmp[1] = b + c;
		tmp[2] = b - c;
		tmp[3] = a - d;
		tmp += 4;
		in++;
	}
	tmp = C;
	for (i = 0; i < 4; i++)
	{
		dc = tmp[0] + 4;
		a = dc + tmp[8];
		b = dc - tmp[8];
		c = Vp8Mul2(tmp[4]) - Vp8Mul1(tmp[12]);
		d = Vp8Mul1(tmp[4]) + Vp8Mul2(tmp[12]);
		dst[0] = Vp8Clip8(dst[0] + ((a + d) >> 3));
		dst[1] = Vp8Clip8(dst[1] + ((b + c) >> 3));
		dst[2] = Vp8Clip8(dst[2] + ((b - c) >> 3));
		dst[3] = Vp8Clip8(dst[3] + ((a - d) >> 3));
		tmp++;
		dst += VP8_BPS;
	}
}

/***** VP8 intra predictors (dst stride VP8_BPS, edges at -1) *****/

U0 Vp8TrueMotion(U8 *dst, I64 size)
{
	U8	*top = dst - VP8_BPS;
	I64	 x, y, tl = top[-1];

	for (y = 0; y < size; y++)
	{
		for (x = 0; x < size; x++)
			dst[x] = Vp8Clip8(top[x] + dst[-1] - tl);
		dst += VP8_BPS;
	}
}

U0 Vp8PredNxN(U8 *dst, I64 mode, I64 size, I64 have_top, I64 have_left)
{//DC/TM/VE/HE + DC border variants for 16x16 and 8x8 blocks.
//mode: 0 DC, 1 TM, 2 VE, 3 HE (border handling folded in via have_*).
	I64	 x, y, dc, n;
	U8	*top = dst - VP8_BPS;

	switch (mode)
	{
		case 0:
			dc = 0;
			n = 0;
			if (have_top)
			{
				for (x = 0; x < size; x++)
					dc += top[x];
				n += size;
			}
			if (have_left)
			{
				for (y = 0; y < size; y++)
					dc += dst[y * VP8_BPS - 1];
				n += size;
			}
			if (n)
				dc = (dc + n / 2) / n;
			else
				dc = 0x80;
			for (y = 0; y < size; y++)
				for (x = 0; x < size; x++)
					dst[y * VP8_BPS + x] = dc;
			break;
		case 1:
			Vp8TrueMotion(dst, size);
			break;
		case 2:
			for (y = 0; y < size; y++)
				for (x = 0; x < size; x++)
					dst[y * VP8_BPS + x] = top[x];
			break;
		case 3:
			for (y = 0; y < size; y++)
				for (x = 0; x < size; x++)
					dst[y * VP8_BPS + x] = dst[y * VP8_BPS - 1];
			break;
	}
}

I64 Vp8Avg3(I64 a, I64 b, I64 c)
{
	return (a + 2 * b + c + 2) >> 2;
}

I64 Vp8Avg2(I64 a, I64 b)
{
	return (a + b + 1) >> 1;
}

U0 Vp8PredLuma4(U8 *dst, I64 mode)
{//10 4x4 sub-block modes. Edges valid (scratch keeps -1 row/col + TR).
	U8	*top = dst - VP8_BPS;
	I64	 x, y, dc;
	I64	 A, B, C, D, E, F, G, H, I, J, K, L, X;

	A = top[0]; B = top[1]; C = top[2]; D = top[3];
	E = top[4]; F = top[5]; G = top[6]; H = top[7];
	I = dst[-1]; J = dst[VP8_BPS - 1]; K = dst[2 * VP8_BPS - 1]; L = dst[3 * VP8_BPS - 1];
	X = top[-1];

	switch (mode)
	{
		case 0:	//B_DC_PRED
			dc = 4;
			for (x = 0; x < 4; x++)
				dc += top[x] + dst[x * VP8_BPS - 1];
			dc >>= 3;
			for (y = 0; y < 4; y++)
				for (x = 0; x < 4; x++)
					dst[y * VP8_BPS + x] = dc;
			break;
		case 1:	//B_TM_PRED
			Vp8TrueMotion(dst, 4);
			break;
		case 2:	//B_VE_PRED
			for (y = 0; y < 4; y++)
			{
				dst[y * VP8_BPS + 0] = Vp8Avg3(X, A, B);
				dst[y * VP8_BPS + 1] = Vp8Avg3(A, B, C);
				dst[y * VP8_BPS + 2] = Vp8Avg3(B, C, D);
				dst[y * VP8_BPS + 3] = Vp8Avg3(C, D, E);
			}
			break;
		case 3:	//B_HE_PRED
			for (x = 0; x < 4; x++)
			{
				dst[0 * VP8_BPS + x] = Vp8Avg3(X, I, J);
				dst[1 * VP8_BPS + x] = Vp8Avg3(I, J, K);
				dst[2 * VP8_BPS + x] = Vp8Avg3(J, K, L);
				dst[3 * VP8_BPS + x] = Vp8Avg3(K, L, L);
			}
			break;
		case 4:	//B_RD_PRED (down-right)
			dst[0 + 3 * VP8_BPS] = Vp8Avg3(J, K, L);
			dst[1 + 3 * VP8_BPS] = dst[0 + 2 * VP8_BPS] = Vp8Avg3(I, J, K);
			dst[2 + 3 * VP8_BPS] = dst[1 + 2 * VP8_BPS] = dst[0 + 1 * VP8_BPS] = Vp8Avg3(X, I, J);
			dst[3 + 3 * VP8_BPS] = dst[2 + 2 * VP8_BPS] = dst[1 + 1 * VP8_BPS] = dst[0] = Vp8Avg3(A, X, I);
			dst[3 + 2 * VP8_BPS] = dst[2 + 1 * VP8_BPS] = dst[1] = Vp8Avg3(B, A, X);
			dst[3 + 1 * VP8_BPS] = dst[2] = Vp8Avg3(C, B, A);
			dst[3] = Vp8Avg3(D, C, B);
			break;
		case 5:	//B_VR_PRED (vertical-right)
			dst[0] = dst[1 + 2 * VP8_BPS] = Vp8Avg2(X, A);
			dst[1] = dst[2 + 2 * VP8_BPS] = Vp8Avg2(A, B);
			dst[2] = dst[3 + 2 * VP8_BPS] = Vp8Avg2(B, C);
			dst[3] = Vp8Avg2(C, D);
			dst[0 + 3 * VP8_BPS] = Vp8Avg3(K, J, I);
			dst[0 + 2 * VP8_BPS] = Vp8Avg3(J, I, X);
			dst[0 + 1 * VP8_BPS] = dst[1 + 3 * VP8_BPS] = Vp8Avg3(I, X, A);
			dst[1 + 1 * VP8_BPS] = dst[2 + 3 * VP8_BPS] = Vp8Avg3(X, A, B);
			dst[2 + 1 * VP8_BPS] = dst[3 + 3 * VP8_BPS] = Vp8Avg3(A, B, C);
			dst[3 + 1 * VP8_BPS] = Vp8Avg3(B, C, D);
			break;
		case 6:	//B_LD_PRED (down-left)
			dst[0] = Vp8Avg3(A, B, C);
			dst[1] = dst[0 + 1 * VP8_BPS] = Vp8Avg3(B, C, D);
			dst[2] = dst[1 + 1 * VP8_BPS] = dst[0 + 2 * VP8_BPS] = Vp8Avg3(C, D, E);
			dst[3] = dst[2 + 1 * VP8_BPS] = dst[1 + 2 * VP8_BPS] = dst[0 + 3 * VP8_BPS] = Vp8Avg3(D, E, F);
			dst[3 + 1 * VP8_BPS] = dst[2 + 2 * VP8_BPS] = dst[1 + 3 * VP8_BPS] = Vp8Avg3(E, F, G);
			dst[3 + 2 * VP8_BPS] = dst[2 + 3 * VP8_BPS] = Vp8Avg3(F, G, H);
			dst[3 + 3 * VP8_BPS] = Vp8Avg3(G, H, H);
			break;
		case 7:	//B_VL_PRED (vertical-left)
			dst[0] = Vp8Avg2(A, B);
			dst[1] = dst[0 + 2 * VP8_BPS] = Vp8Avg2(B, C);
			dst[2] = dst[1 + 2 * VP8_BPS] = Vp8Avg2(C, D);
			dst[3] = dst[2 + 2 * VP8_BPS] = Vp8Avg2(D, E);
			dst[0 + 1 * VP8_BPS] = Vp8Avg3(A, B, C);
			dst[1 + 1 * VP8_BPS] = dst[0 + 3 * VP8_BPS] = Vp8Avg3(B, C, D);
			dst[2 + 1 * VP8_BPS] = dst[1 + 3 * VP8_BPS] = Vp8Avg3(C, D, E);
			dst[3 + 1 * VP8_BPS] = dst[2 + 3 * VP8_BPS] = Vp8Avg3(D, E, F);
			dst[3 + 2 * VP8_BPS] = Vp8Avg3(E, F, G);
			dst[3 + 3 * VP8_BPS] = Vp8Avg3(F, G, H);
			break;
		case 8:	//B_HD_PRED (horizontal-down)
			dst[0] = dst[2 + 1 * VP8_BPS] = Vp8Avg2(I, X);
			dst[0 + 1 * VP8_BPS] = dst[2 + 2 * VP8_BPS] = Vp8Avg2(J, I);
			dst[0 + 2 * VP8_BPS] = dst[2 + 3 * VP8_BPS] = Vp8Avg2(K, J);
			dst[0 + 3 * VP8_BPS] = Vp8Avg2(L, K);
			dst[3] = Vp8Avg3(A, B, C);
			dst[2] = Vp8Avg3(X, A, B);
			dst[1] = dst[3 + 1 * VP8_BPS] = Vp8Avg3(I, X, A);
			dst[1 + 1 * VP8_BPS] = dst[3 + 2 * VP8_BPS] = Vp8Avg3(X, I, J);
			dst[1 + 2 * VP8_BPS] = dst[3 + 3 * VP8_BPS] = Vp8Avg3(I, J, K);
			dst[1 + 3 * VP8_BPS] = Vp8Avg3(J, K, L);
			break;
		case 9:	//B_HU_PRED (horizontal-up)
			dst[0] = Vp8Avg2(I, J);
			dst[2] = dst[0 + 1 * VP8_BPS] = Vp8Avg2(J, K);
			dst[2 + 1 * VP8_BPS] = dst[0 + 2 * VP8_BPS] = Vp8Avg2(K, L);
			dst[1] = Vp8Avg3(I, J, K);
			dst[3] = dst[1 + 1 * VP8_BPS] = Vp8Avg3(J, K, L);
			dst[3 + 1 * VP8_BPS] = dst[1 + 2 * VP8_BPS] = Vp8Avg3(K, L, L);
			dst[2 + 2 * VP8_BPS] = dst[3 + 2 * VP8_BPS] = L;
			dst[0 + 3 * VP8_BPS] = dst[1 + 3 * VP8_BPS] = L;
			dst[2 + 3 * VP8_BPS] = dst[3 + 3 * VP8_BPS] = L;
			break;
	}
}

//4x4 sub-block offsets in the scratch (kScan, BPS=32; literal values -
//no expressions in ZealC global initializers).
U16 vp8_scan[16] = {
	0,   4,   8,   12,
	128, 132, 136, 140,
	256, 260, 264, 268,
	384, 388, 392, 396
};

U0 Vp8ParseIntraMode(CVp8Dec *d, I64 mb_x)
{
	CVp8Br	*br = &d->br;
	U8		*top = d->intra_t + 4 * mb_x;
	I64		 x, y, ymode;
	U8		*prob;

	if (d->update_map)
	{
		if (!Vp8Bit(br, d->seg_prob[0]))
			d->segment = Vp8Bit(br, d->seg_prob[1]);
		else
			d->segment = Vp8Bit(br, d->seg_prob[2]) + 2;
	}
	else
		d->segment = 0;
	if (d->use_skip)
		d->skip = Vp8Bit(br, d->skip_p);
	else
		d->skip = FALSE;

	d->is_i4x4 = !Vp8Bit(br, 145);
	if (!d->is_i4x4)
	{//16x16 mode: 0 DC, 1 TM, 2 VE, 3 HE (libwebp enum order).
		if (Vp8Bit(br, 156))
		{
			if (Vp8Bit(br, 128))
				ymode = 1;	//TM
			else
				ymode = 3;	//HE
		}
		else
		{
			if (Vp8Bit(br, 163))
				ymode = 2;	//VE
			else
				ymode = 0;	//DC
		}
		d->imodes[0] = ymode;
		for (x = 0; x < 4; x++)
		{
			top[x] = ymode;
			d->intra_l[x] = ymode;
		}
	}
	else
	{
		for (y = 0; y < 4; y++)
		{
			ymode = d->intra_l[y];
			for (x = 0; x < 4; x++)
			{
				prob = vp8_bmode_probs + (top[x] * 10 + ymode) * 9;
				if (!Vp8Bit(br, prob[0]))
					ymode = 0;
				else if (!Vp8Bit(br, prob[1]))
					ymode = 1;
				else if (!Vp8Bit(br, prob[2]))
					ymode = 2;
				else if (!Vp8Bit(br, prob[3]))
				{
					if (!Vp8Bit(br, prob[4]))
						ymode = 3;
					else if (!Vp8Bit(br, prob[5]))
						ymode = 4;
					else
						ymode = 5;
				}
				else
				{
					if (!Vp8Bit(br, prob[6]))
						ymode = 6;
					else if (!Vp8Bit(br, prob[7]))
						ymode = 7;
					else if (!Vp8Bit(br, prob[8]))
						ymode = 8;
					else
						ymode = 9;
				}
				top[x] = ymode;
				d->imodes[y * 4 + x] = ymode;
			}
			d->intra_l[y] = ymode;
		}
	}
	//UV mode.
	if (!Vp8Bit(br, 142))
		d->uvmode = 0;
	else if (!Vp8Bit(br, 114))
		d->uvmode = 2;
	else if (Vp8Bit(br, 183))
		d->uvmode = 1;
	else
		d->uvmode = 3;
}

U0 Vp8ParseResiduals(CVp8Dec *d, I64 mb_x, CVp8Br *tbr)
{//Fills d->coeffs (25 * 16); updates nz contexts.
	I64	 dc[16], i, x, y, ch, nz, ctx, first, type, l;
	I64	*dst = d->coeffs;
	I64	 tnz, lnz;
	I64	*q = d->qm[d->segment];
	U8	 nz_here, nz_left;

	MemSet(d->coeffs, 0, 384 * sizeof(I64));
	if (d->skip)
	{
		d->nz_t[1 + mb_x] = 0;
		d->nz_t[0] = 0;
		if (!d->is_i4x4)
		{
			d->nzdc_t[1 + mb_x] = 0;
			d->nzdc_t[0] = 0;
		}
		return;
	}

	if (!d->is_i4x4)
	{//Y2 (WHT) DC block.
		MemSet(dc, 0, sizeof(dc));
		ctx = d->nzdc_t[1 + mb_x] + d->nzdc_t[0];
		nz = Vp8GetCoeffs(tbr, d->probs, 1, ctx, q[2], q[3], 0, dc);
		if (nz > 0)
		{
			d->nzdc_t[1 + mb_x] = 1;
			d->nzdc_t[0] = 1;
		}
		else
		{
			d->nzdc_t[1 + mb_x] = 0;
			d->nzdc_t[0] = 0;
		}
		if (nz > 1)
			Vp8TransformWHT(dc, dst);
		else
		{
			i = (dc[0] + 3) >> 3;
			for (x = 0; x < 256; x += 16)
				dst[x] = i;
		}
		first = 1;
		type = 0;
	}
	else
	{
		first = 0;
		type = 3;
	}

	tnz = d->nz_t[1 + mb_x] & 0x0F;
	lnz = d->nz_t[0] & 0x0F;
	for (y = 0; y < 4; y++)
	{
		l = lnz & 1;
		for (x = 0; x < 4; x++)
		{
			ctx = l + (tnz & 1);
			nz = Vp8GetCoeffs(tbr, d->probs, type, ctx, q[0], q[1], first, dst);
			if (nz > first)
				l = 1;
			else
				l = 0;
			tnz = tnz >> 1 | l << 7;
			dst += 16;
		}
		tnz >>= 4;
		lnz = lnz >> 1 | l << 7;
	}
	nz_here = tnz;
	nz_left = lnz >> 4;

	for (ch = 0; ch < 4; ch += 2)
	{
		tnz = d->nz_t[1 + mb_x] >> (4 + ch);
		lnz = d->nz_t[0] >> (4 + ch);
		for (y = 0; y < 2; y++)
		{
			l = lnz & 1;
			for (x = 0; x < 2; x++)
			{
				ctx = l + (tnz & 1);
				nz = Vp8GetCoeffs(tbr, d->probs, 2, ctx, q[4], q[5], 0, dst);
				if (nz > 0)
					l = 1;
				else
					l = 0;
				tnz = tnz >> 1 | l << 3;
				dst += 16;
			}
			tnz >>= 2;
			lnz = lnz >> 1 | l << 5;
		}
		nz_here |= (tnz << 4) << ch;
		nz_left |= (lnz & 0xF0) << ch;
	}
	d->nz_t[1 + mb_x] = nz_here;
	d->nz_t[0] = nz_left;
}

U0 Vp8ReconstructMB(CVp8Dec *d, I64 mb_x, I64 mb_y)
{
	U8	*yd = d->scratch + VP8_Y_OFF;
	U8	*ud = d->scratch + VP8_U_OFF;
	U8	*vd = d->scratch + VP8_V_OFF;
	I64	 j, n, x, y, b, have_top = mb_y > 0, have_left = mb_x > 0;
	I64	 mode;
	U8	*dst;

	//Rotate in left samples from the previous MB.
	if (mb_x > 0)
	{
		for (j = -1; j < 16; j++)
			MemCopy(&yd[j * VP8_BPS - 4], &yd[j * VP8_BPS + 12], 4);
		for (j = -1; j < 8; j++)
		{
			MemCopy(&ud[j * VP8_BPS - 4], &ud[j * VP8_BPS + 4], 4);
			MemCopy(&vd[j * VP8_BPS - 4], &vd[j * VP8_BPS + 4], 4);
		}
	}
	else
	{//Leftmost block: 129 left column, 127/129 corners.
		for (j = 0; j < 16; j++)
			yd[j * VP8_BPS - 1] = 129;
		for (j = 0; j < 8; j++)
		{
			ud[j * VP8_BPS - 1] = 129;
			vd[j * VP8_BPS - 1] = 129;
		}
		if (mb_y > 0)
		{
			yd[-1 - VP8_BPS] = 129;
			ud[-1 - VP8_BPS] = 129;
			vd[-1 - VP8_BPS] = 129;
		}
	}
	if (mb_y == 0)
	{//Top row: 127s above (incl. corner + 4 top-right bytes).
		MemSet(yd - VP8_BPS - 1, 127, 16 + 4 + 1);
		MemSet(ud - VP8_BPS - 1, 127, 8 + 1);
		MemSet(vd - VP8_BPS - 1, 127, 8 + 1);
	}
	else
	{//Bring the top samples in from the row cache.
		MemCopy(yd - VP8_BPS, d->top_y + mb_x * 16, 16);
		MemCopy(ud - VP8_BPS, d->top_u + mb_x * 8, 8);
		MemCopy(vd - VP8_BPS, d->top_v + mb_x * 8, 8);
	}

	if (d->is_i4x4)
	{
		//Top-right 4 pixels.
		if (mb_y > 0)
		{
			if (mb_x >= d->mb_w - 1)
				MemSet(yd - VP8_BPS + 16, d->top_y[mb_x * 16 + 15], 4);
			else
				MemCopy(yd - VP8_BPS + 16, d->top_y + (mb_x + 1) * 16, 4);
		}
		//Sub-blocks 7, 11 and 15 read top[4..7] from outside the macroblock;
		//the top-right run is replicated on their rows. Mirrors
		//VP8ReconstructBlock.
		for (j = 0; j < 4; j++)
		{
			b = yd[-VP8_BPS + 16 + j];
			yd[3  * VP8_BPS + 16 + j] = b;
			yd[7  * VP8_BPS + 16 + j] = b;
			yd[11 * VP8_BPS + 16 + j] = b;
		}
		for (n = 0; n < 16; n++)
		{
			dst = yd + vp8_scan[n];
			Vp8PredLuma4(dst, d->imodes[n]);
			Vp8Transform(&d->coeffs[n * 16], dst);
		}
	}
	else
	{
		mode = d->imodes[0];
		Vp8PredNxN(yd, mode, 16, have_top, have_left);
		for (n = 0; n < 16; n++)
			Vp8Transform(&d->coeffs[n * 16], yd + vp8_scan[n]);
	}
	Vp8PredNxN(ud, d->uvmode, 8, have_top, have_left);
	Vp8PredNxN(vd, d->uvmode, 8, have_top, have_left);
	for (n = 0; n < 4; n++)
	{
		x = (n & 1) * 4;
		y = (n >> 1) * 4;
		Vp8Transform(&d->coeffs[(16 + n) * 16], ud + y * VP8_BPS + x);
		Vp8Transform(&d->coeffs[(20 + n) * 16], vd + y * VP8_BPS + x);
	}

	MemCopy(d->top_y + mb_x * 16, yd + 15 * VP8_BPS, 16);
	MemCopy(d->top_u + mb_x * 8, ud + 7 * VP8_BPS, 8);
	MemCopy(d->top_v + mb_x * 8, vd + 7 * VP8_BPS, 8);

	for (j = 0; j < 16; j++)
		MemCopy(d->py + (mb_y * 16 + j) * d->ys + mb_x * 16, yd + j * VP8_BPS, 16);
	for (j = 0; j < 8; j++)
	{
		MemCopy(d->pu + (mb_y * 8 + j) * d->uvs + mb_x * 8, ud + j * VP8_BPS, 8);
		MemCopy(d->pv + (mb_y * 8 + j) * d->uvs + mb_x * 8, vd + j * VP8_BPS, 8);
	}
}


//--- loop filter (RFC 6386 par. 15) ----------------------------------------
//
//Run over the whole frame after reconstruction. Per-MB level and the inner-edge
//flag are recorded during decode: filtering in place as each MB lands would
//read neighbours that are not final yet.

I64 Vp8S8(I64 v)
{//clamp to signed char
	if (v < -128)
		return -128;
	if (v > 127)
		return 127;

	return v;
}

I64 Vp8U8(I64 v)
{
	if (v < 0)
		return 0;
	if (v > 255)
		return 255;

	return v;
}

I64 Vp8Common(U8 *q0, I64 step, Bool use_outer)
{//RFC common_adjust. Returns the filter value used for the outer taps.
	I64 p1 = q0[-2 * step] - 128, p0 = q0[-step] - 128;
	I64 qq = q0[0] - 128, q1 = q0[step] - 128;
	I64 a, f, e;

	a = 0;
	if (use_outer)
		a = Vp8S8(p1 - q1);
	a = Vp8S8(a + 3 * (qq - p0));

	f = Vp8S8(a + 4) >> 3;
	e = Vp8S8(a + 3) >> 3;

	q0[0]     = Vp8U8(qq - f + 128);
	q0[-step] = Vp8U8(p0 + e + 128);

	return f;
}

Bool Vp8FilterYes(U8 *q0, I64 step, I64 ilim, I64 elim)
{
	I64 p3 = q0[-4 * step], p2 = q0[-3 * step], p1 = q0[-2 * step], p0 = q0[-step];
	I64 r0 = q0[0], r1 = q0[step], r2 = q0[2 * step], r3 = q0[3 * step];

	if (AbsI64(p0 - r0) * 2 + AbsI64(p1 - r1) / 2 > elim)
		return FALSE;

	return ToBool(AbsI64(p3 - p2) <= ilim && AbsI64(p2 - p1) <= ilim &&
				  AbsI64(p1 - p0) <= ilim && AbsI64(r3 - r2) <= ilim &&
				  AbsI64(r2 - r1) <= ilim && AbsI64(r1 - r0) <= ilim);
}

Bool Vp8Hev(U8 *q0, I64 step, I64 thresh)
{//high edge variance: a real edge, not ringing
	return ToBool(AbsI64(q0[-2 * step] - q0[-step]) > thresh ||
				  AbsI64(q0[step] - q0[0]) > thresh);
}

U0 Vp8FilterLine(U8 *q0, I64 step, Bool mb, I64 hev_t, I64 ilim, I64 elim)
{//One edge, one pixel run. q0 is the first sample after the edge.
	I64  p2, p1, p0, r0, r1, r2, w, a;
	Bool hv;

	if (!Vp8FilterYes(q0, step, ilim, elim))
		return;

	if (!mb)
	{//common_adjust takes hev as its use_outer_taps argument
		hv = Vp8Hev(q0, step, hev_t);
		a  = Vp8Common(q0, step, hv);
		if (!hv)
		{
			a = (a + 1) >> 1;
			q0[step]      = Vp8U8(q0[step] - a);
			q0[-2 * step] = Vp8U8(q0[-2 * step] + a);
		}
		return;
	}

	if (Vp8Hev(q0, step, hev_t))
	{
		Vp8Common(q0, step, TRUE);
		return;
	}

	p2 = q0[-3 * step] - 128;
	p1 = q0[-2 * step] - 128;
	p0 = q0[-step] - 128;
	r0 = q0[0] - 128;
	r1 = q0[step] - 128;
	r2 = q0[2 * step] - 128;

	w = Vp8S8(Vp8S8(p1 - r1) + 3 * (r0 - p0));

	a = (27 * w + 63) >> 7;
	a = Vp8S8(a);
	q0[0]     = Vp8U8(r0 - a + 128);
	q0[-step] = Vp8U8(p0 + a + 128);

	a = (18 * w + 63) >> 7;
	a = Vp8S8(a);
	q0[step]      = Vp8U8(r1 - a + 128);
	q0[-2 * step] = Vp8U8(p1 + a + 128);

	a = (9 * w + 63) >> 7;
	a = Vp8S8(a);
	q0[2 * step]  = Vp8U8(r2 - a + 128);
	q0[-3 * step] = Vp8U8(p2 + a + 128);
}

U0 Vp8SimpleLine(U8 *q0, I64 step, I64 elim)
{//RFC simple_segment. Luma only, no interior mask and no hev.
	if (AbsI64(q0[-step] - q0[0]) * 2 + AbsI64(q0[-2 * step] - q0[step]) / 2
		<= elim)
		Vp8Common(q0, step, TRUE);
}

U0 Vp8SimpleEdge(U8 *base, I64 step, I64 adv, I64 count, I64 elim)
{
	I64 i;

	for (i = 0; i < count; i++)
		Vp8SimpleLine(base + i * adv, step, elim);
}

U0 Vp8FilterEdge(U8 *base, I64 step, I64 adv, I64 count, Bool mb,
				 I64 hev_t, I64 ilim, I64 elim)
{//count lines across one edge. step crosses it, adv walks along it.
	I64 i;

	for (i = 0; i < count; i++)
		Vp8FilterLine(base + i * adv, step, mb, hev_t, ilim, elim);
}

U0 Vp8FilterMB(CVp8Dec *d, I64 mb_x, I64 mb_y, I64 level, Bool inner)
{
	U8	*y, *u, *v;
	I64	 ilim, hev_t, mbe, sbe, i;

	if (level < 1)
		return;

	ilim = level;
	if (d->filt_sharp)
	{
		if (d->filt_sharp > 4)
			ilim >>= 2;
		else
			ilim >>= 1;
		if (ilim > 9 - d->filt_sharp)
			ilim = 9 - d->filt_sharp;
	}
	if (ilim < 1)
		ilim = 1;

	hev_t = 0;
	if (level >= 40)
		hev_t = 2;
	else if (level >= 15)
		hev_t = 1;

	mbe = (level + 2) * 2 + ilim;
	sbe = level * 2 + ilim;

	y = d->py + mb_y * 16 * d->ys + mb_x * 16;
	u = d->pu + mb_y * 8 * d->uvs + mb_x * 8;
	v = d->pv + mb_y * 8 * d->uvs + mb_x * 8;

	if (d->filt_simple)
	{//luma only
		if (mb_x)
			Vp8SimpleEdge(y, 1, d->ys, 16, mbe);
		if (inner)
			for (i = 4; i < 16; i += 4)
				Vp8SimpleEdge(y + i, 1, d->ys, 16, sbe);
		if (mb_y)
			Vp8SimpleEdge(y, d->ys, 1, 16, mbe);
		if (inner)
			for (i = 4; i < 16; i += 4)
				Vp8SimpleEdge(y + i * d->ys, d->ys, 1, 16, sbe);
		return;
	}

	if (mb_x)
	{
		Vp8FilterEdge(y, 1, d->ys, 16, TRUE, hev_t, ilim, mbe);
		Vp8FilterEdge(u, 1, d->uvs, 8, TRUE, hev_t, ilim, mbe);
		Vp8FilterEdge(v, 1, d->uvs, 8, TRUE, hev_t, ilim, mbe);
	}
	if (inner)
	{
		for (i = 4; i < 16; i += 4)
			Vp8FilterEdge(y + i, 1, d->ys, 16, FALSE, hev_t, ilim, sbe);
		Vp8FilterEdge(u + 4, 1, d->uvs, 8, FALSE, hev_t, ilim, sbe);
		Vp8FilterEdge(v + 4, 1, d->uvs, 8, FALSE, hev_t, ilim, sbe);
	}

	if (mb_y)
	{
		Vp8FilterEdge(y, d->ys, 1, 16, TRUE, hev_t, ilim, mbe);
		Vp8FilterEdge(u, d->uvs, 1, 8, TRUE, hev_t, ilim, mbe);
		Vp8FilterEdge(v, d->uvs, 1, 8, TRUE, hev_t, ilim, mbe);
	}
	if (inner)
	{
		for (i = 4; i < 16; i += 4)
			Vp8FilterEdge(y + i * d->ys, d->ys, 1, 16, FALSE, hev_t, ilim, sbe);
		Vp8FilterEdge(u + 4 * d->uvs, d->uvs, 1, 8, FALSE, hev_t, ilim, sbe);
		Vp8FilterEdge(v + 4 * d->uvs, d->uvs, 1, 8, FALSE, hev_t, ilim, sbe);
	}
}

U0 Vp8LoopFilterFrame(CVp8Dec *d)
{
	I64 x, y, i;

	if (!d->filt_level || !d->mb_flevel)
		return;

	for (y = 0; y < d->mb_h; y++)
		for (x = 0; x < d->mb_w; x++)
		{
			i = y * d->mb_w + x;
			Vp8FilterMB(d, x, y, d->mb_flevel[i], ToBool(d->mb_inner[i]));
		}
}

U0 Vp8DecFree(CVp8Dec *d)
{//Per-frame buffers. d itself belongs to the caller.
	Free(d->probs);
	Free(d->intra_t);
	Free(d->nz_t);
	Free(d->nzdc_t);
	Free(d->top_y);
	Free(d->top_u);
	Free(d->top_v);
	Free(d->mb_flevel);
	Free(d->mb_inner);
	Free(d->scratch);
	Free(d->py);
	Free(d->pu);
	Free(d->pv);
}

U0 Vp8DecAlloc(CVp8Dec *d)
{//Planes and per-MB state, sized from mb_w/mb_h.
	d->top_y = MAlloc(d->mb_w * 16);
	d->top_u = MAlloc(d->mb_w * 8);
	d->top_v = MAlloc(d->mb_w * 8);
	d->scratch = MAlloc(VP8_BPS * 40);
	d->mb_flevel = CAlloc(d->mb_w * d->mb_h);
	d->mb_inner  = CAlloc(d->mb_w * d->mb_h);
	d->ys = d->mb_w * 16;
	d->uvs = d->mb_w * 8;
	d->py = MAlloc(d->ys * d->mb_h * 16);
	d->pu = MAlloc(d->uvs * d->mb_h * 8);
	d->pv = MAlloc(d->uvs * d->mb_h * 8);
}

Bool Vp8DecMBs(CVp8Dec *d)
{//Mode, residual and reconstruct for every MB, then the loop filter.
	CVp8Br	*tbr;
	I64		 mb_x, mb_y, t;

	for (mb_y = 0; mb_y < d->mb_h; mb_y++)
	{
		MemSet(d->intra_l, 0, 4);
		d->nz_t[0] = 0;
		d->nzdc_t[0] = 0;
		for (mb_x = 0; mb_x < d->mb_w; mb_x++)
		{
			Vp8ParseIntraMode(d, mb_x);
			//Residuals come from the row's token partition. Modes and
			//coefficients interleave per MB.
			tbr = &d->parts[mb_y & (d->num_parts - 1)];
			Vp8ParseResiduals(d, mb_x, tbr);
			Vp8ReconstructMB(d, mb_x, mb_y);
			if (d->mb_flevel)
			{//RFC 15.2: segment strength, then the intra-frame ref delta and
			 //the B_PRED mode delta.
				t = d->filt_level;
				if (d->use_segment)
				{
					if (d->absolute_delta)
						t = d->seg_filt[d->segment];
					else
						t += d->seg_filt[d->segment];
				}
				if (d->lf_delta_en)
				{
					t += d->lf_ref_delta[0];
					if (d->is_i4x4)
						t += d->lf_mode_delta[0];
				}
				t = Vp8Clip127(t, 63);
				d->mb_flevel[mb_y * d->mb_w + mb_x] = t;
				d->mb_inner[mb_y * d->mb_w + mb_x]  = ToBool(!d->skip || d->is_i4x4);
			}
		}
		if (d->br.eof)
			return FALSE;
		Yield;
	}

	Vp8LoopFilterFrame(d);

	return TRUE;
}

U32 *Vp8ToArgb(CVp8Dec *d)
{//BT.601, full frame.
	U32	*argb = MAlloc(d->w * d->h * sizeof(U32));
	I64	 x, y, cy, cu, cv, r, g, bl;

	//YUV420 -> ARGB (BT.601).
	for (y = 0; y < d->h; y++)
	{
		for (x = 0; x < d->w; x++)
		{
			cy = 298 * (d->py[y * d->ys + x] - 16);
			cu = d->pu[(y >> 1) * d->uvs + (x >> 1)] - 128;
			cv = d->pv[(y >> 1) * d->uvs + (x >> 1)] - 128;
			r = Vp8Clip8((cy + 409 * cv + 128) >> 8);
			g = Vp8Clip8((cy - 100 * cu - 208 * cv + 128) >> 8);
			bl = Vp8Clip8((cy + 516 * cu + 128) >> 8);
			argb[y * d->w + x] = 0xFF000000 | r << 16 | g << 8 | bl;
		}
		if (!(y & 63))
			Yield;
	}

	return argb;
}

U32 *Vp8DecodeKeyframeInto(CVp8Dec *d, U8 *buf, I64 size, I64 *out_w,
						   I64 *out_h)
{//VP8 keyframe payload -> ARGB (opaque). d is the caller's and is left holding
//the decoded planes; Vp8DecFree releases them.
	I64		 bits, part0_size, i, t, b, c, p, s, np;
	U8		*part_buf;
	I64		 part_left, psize;
	U32		*argb = NULL;

	if (size < 10)
		goto vp8_fail;
	bits = buf[0] | buf[1] << 8 | buf[2] << 16;
	if (bits & 1)
		goto vp8_fail;	//Not a keyframe.
	part0_size = bits >> 5;
	if (buf[3] != 0x9D || buf[4] != 0x01 || buf[5] != 0x2A)
		goto vp8_fail;
	d->w = (buf[6] | buf[7] << 8) & 0x3FFF;
	d->h = (buf[8] | buf[9] << 8) & 0x3FFF;
	if (!d->w || !d->h || d->w > VP8_MAXDIM || d->h > VP8_MAXDIM)
		goto vp8_fail;
	d->mb_w = (d->w + 15) >> 4;
	d->mb_h = (d->h + 15) >> 4;
	if (10 + part0_size > size)
		goto vp8_fail;

	Vp8BrInit(&d->br, buf + 10, part0_size);
	Vp8Bit(&d->br, 128);	//Color space.
	Vp8Bit(&d->br, 128);	//Clamping.

	d->seg_prob[0] = 255;
	d->seg_prob[1] = 255;
	d->seg_prob[2] = 255;
	d->absolute_delta = TRUE;
	d->use_segment = Vp8Bit(&d->br, 128);
	if (d->use_segment)
	{
		d->update_map = Vp8Bit(&d->br, 128);
		if (Vp8Bit(&d->br, 128))
		{//Update data.
			d->absolute_delta = Vp8Bit(&d->br, 128);
			for (s = 0; s < 4; s++)
			{
				if (Vp8Bit(&d->br, 128))
					d->seg_quant[s] = Vp8SVal(&d->br, 7);
				else
					d->seg_quant[s] = 0;
			}
			for (s = 0; s < 4; s++)
			{
				if (Vp8Bit(&d->br, 128))
					d->seg_filt[s] = Vp8SVal(&d->br, 6);
				else
					d->seg_filt[s] = 0;
			}
		}
		if (d->update_map)
			for (s = 0; s < 3; s++)
			{
				if (Vp8Bit(&d->br, 128))
					d->seg_prob[s] = Vp8Val(&d->br, 8);
				else
					d->seg_prob[s] = 255;
			}
	}
	else
		d->update_map = FALSE;

	d->filt_simple = Vp8Bit(&d->br, 128);
	d->filt_level  = Vp8Val(&d->br, 6);
	d->filt_sharp  = Vp8Val(&d->br, 3);
	d->lf_delta_en = Vp8Bit(&d->br, 128);
	if (d->lf_delta_en)
	{
		if (Vp8Bit(&d->br, 128))
		{//Deltas are sticky across frames; a keyframe starts from zero.
			for (i = 0; i < 4; i++)
				if (Vp8Bit(&d->br, 128))
					d->lf_ref_delta[i] = Vp8SVal(&d->br, 6);
			for (i = 0; i < 4; i++)
				if (Vp8Bit(&d->br, 128))
					d->lf_mode_delta[i] = Vp8SVal(&d->br, 6);
		}
	}

	np = 1 << Vp8Val(&d->br, 2);
	d->num_parts = np;
	part_buf = buf + 10 + part0_size;
	part_left = size - 10 - part0_size;
	if (part_left < 3 * (np - 1))
		goto vp8_fail;
	{
		U8	*sz = part_buf;
		U8	*start = part_buf + (np - 1) * 3;
		I64	 left = part_left - (np - 1) * 3;

		for (i = 0; i < np - 1; i++)
		{
			psize = sz[0] | sz[1] << 8 | sz[2] << 16;
			if (psize > left)
				psize = left;
			Vp8BrInit(&d->parts[i], start, psize);
			start += psize;
			left -= psize;
			sz += 3;
		}
		Vp8BrInit(&d->parts[np - 1], start, left);
	}

	Vp8ParseQuant(d);
	Vp8Bit(&d->br, 128);	//update_proba (keyframe: ignored).

	d->probs = MAlloc(4 * 8 * 3 * 11);
	for (t = 0; t < 4; t++)
		for (b = 0; b < 8; b++)
			for (c = 0; c < 3; c++)
				for (p = 0; p < 11; p++)
				{
					i = ((t * 8 + b) * 3 + c) * 11 + p;
					if (Vp8Bit(&d->br, vp8_coeff_update[i]))
						d->probs[i] = Vp8Val(&d->br, 8);
					else
						d->probs[i] = vp8_coeff_probs[i];
				}
	d->use_skip = Vp8Bit(&d->br, 128);
	if (d->use_skip)
		d->skip_p = Vp8Val(&d->br, 8);

	d->intra_t = MAlloc(4 * d->mb_w);
	MemSet(d->intra_t, 0, 4 * d->mb_w);	//B_DC_PRED.
	d->nz_t = CAlloc(d->mb_w + 1);
	d->nzdc_t = CAlloc(d->mb_w + 1);
	Vp8DecAlloc(d);
	if (!Vp8DecMBs(d))
		goto vp8_fail;

	argb   = Vp8ToArgb(d);
	*out_w = d->w;
	*out_h = d->h;

vp8_fail:;

	return argb;
}

public U32 *Vp8DecodeKeyframe(U8 *buf, I64 size, I64 *out_w, I64 *out_h)
{//One-shot: decode and release. WebP stills have no state to carry.
	CVp8Dec	*d = CAlloc(sizeof(CVp8Dec));
	U32		*argb;

	argb = Vp8DecodeKeyframeInto(d, buf, size, out_w, out_h);
	Vp8DecFree(d);
	Free(d);

	return argb;
}

//--- decoder context -------------------------------------------------------
//
//A still is one keyframe and needs no state; video needs the decoder, the
//reference planes and the coefficient probabilities to survive between frames.
//
//Inter prediction is not implemented: an inter frame is rejected, so a stream
//decodes as its keyframes. The reference planes are maintained regardless, so
//adding prediction does not disturb this bookkeeping.

#define VP8_REF_LAST	0
#define VP8_REF_GOLDEN	1
#define VP8_REF_ALTREF	2

class CVp8Ctx
{
	CVp8Dec	*d;
	U8		*ref_y[3], *ref_u[3], *ref_v[3];
	I64		 mb_w, mb_h, ys, uvs;
	Bool	 sized;
	I64		 frames, inter_skipped;
};

public CVp8Ctx *Vp8CtxOpen()
{
	return CAlloc(sizeof(CVp8Ctx));
}

U0 Vp8CtxRefFree(CVp8Ctx *c)
{
	I64 i;

	for (i = 0; i < 3; i++)
	{
		Free(c->ref_y[i]);
		Free(c->ref_u[i]);
		Free(c->ref_v[i]);
		c->ref_y[i] = NULL;
		c->ref_u[i] = NULL;
		c->ref_v[i] = NULL;
	}
	c->sized = FALSE;
}

public U0 Vp8CtxClose(CVp8Ctx *c)
{
	if (!c)
		return;
	Vp8CtxRefFree(c);
	if (c->d)
	{
		Vp8DecFree(c->d);
		Free(c->d);
	}
	Free(c);
}

Bool Vp8CtxSize(CVp8Ctx *c, CVp8Dec *d)
{//Reference planes follow the frame size; a size change drops them.
	I64 i, ysz, uvsz;

	if (c->sized && c->mb_w == d->mb_w && c->mb_h == d->mb_h)
		return TRUE;

	Vp8CtxRefFree(c);
	c->mb_w = d->mb_w;
	c->mb_h = d->mb_h;
	c->ys   = d->ys;
	c->uvs  = d->uvs;

	ysz  = d->ys * d->mb_h * 16;
	uvsz = d->uvs * d->mb_h * 8;
	for (i = 0; i < 3; i++)
	{
		c->ref_y[i] = CAlloc(ysz);
		c->ref_u[i] = CAlloc(uvsz);
		c->ref_v[i] = CAlloc(uvsz);
		if (!c->ref_y[i] || !c->ref_u[i] || !c->ref_v[i])
		{
			Vp8CtxRefFree(c);
			return FALSE;
		}
	}
	c->sized = TRUE;

	return TRUE;
}

U0 Vp8CtxRefStore(CVp8Ctx *c, CVp8Dec *d, I64 slot)
{
	MemCopy(c->ref_y[slot], d->py, d->ys * d->mb_h * 16);
	MemCopy(c->ref_u[slot], d->pu, d->uvs * d->mb_h * 8);
	MemCopy(c->ref_v[slot], d->pv, d->uvs * d->mb_h * 8);
}

public U32 *Vp8CtxDecode(CVp8Ctx *c, U8 *buf, I64 size, I64 *out_w, I64 *out_h)
{//One frame. NULL when the frame cannot be decoded; the context stays usable.
	CVp8Dec	*d;
	U32		*argb = NULL;
	I64		 bits;

	*out_w = 0;
	*out_h = 0;
	if (!c || !buf || size < 10)
		return NULL;

	bits = buf[0] | (buf[1] << 8) | (buf[2] << 16);
	if (bits & 1)
	{//Inter frame: no reference prediction yet.
		c->inter_skipped++;
		return NULL;
	}

	//A keyframe reallocates: mb_w/mb_h come from its own header.
	if (c->d)
	{
		Vp8DecFree(c->d);
		Free(c->d);
	}
	c->d = CAlloc(sizeof(CVp8Dec));
	argb = Vp8DecodeKeyframeInto(c->d, buf, size, out_w, out_h);
	if (!argb)
		return NULL;

	d = c->d;
	if (Vp8CtxSize(c, d))
	{//A keyframe refreshes every reference.
		Vp8CtxRefStore(c, d, VP8_REF_LAST);
		Vp8CtxRefStore(c, d, VP8_REF_GOLDEN);
		Vp8CtxRefStore(c, d, VP8_REF_ALTREF);
	}
	c->frames++;

	return argb;
}


