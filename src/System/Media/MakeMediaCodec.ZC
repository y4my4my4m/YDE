Cd(__DIR__);;
//Codecs are System libraries, not app-local: ZealC has a single global symbol
//table, and a per-app copy collides when two apps are loaded.
//
//Split from MakeMedia: Gr calls the VP8 decoder, so this half compiles ahead of
//Gr, while the container and audio glue need Audio and compile after it.
#include "MediaDef"
#include "Lib/VP8Tables"
#include "Lib/VP8"
Cd("..");;
