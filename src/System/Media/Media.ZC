//Container-level helpers over the demuxers.

public CMediaCtx *MediaOpen(U8 *filename)
{//Reads the whole file. Caller frees with MediaClose.
	CMediaCtx	*m = CAlloc(sizeof(CMediaCtx));
	U8			*buf;
	I64			 size = 0;

	buf = FileRead(filename, &size);
	if (!buf)
	{
		Free(m);
		return NULL;
	}
	if (!MkvOpen(m, buf, size))
	{
		Free(buf);
		Free(m);
		return NULL;
	}

	return m;
}

public U0 MediaClose(CMediaCtx *m)
{
	if (!m)
		return;
	Free(m->buf);
	Free(m);
}

public U0 MediaRep(U8 *filename)
{//Track table, then a full demux pass counting packets per kind.
	CMediaCtx	*m = MediaOpen(filename);
	CMediaPacket p;
	I64			 i, n = 0, vid = 0, aud = 0, keys = 0;

	if (!m)
	{
		"MediaRep: cannot open \"%s\".\n", filename;
		return;
	}

	MemSet(&p, 0, sizeof(CMediaPacket));
	MkvRep(m);

	while (MkvNext(m, &p))
	{
		n++;
		if (p.key)
			keys++;
		i = MediaTrackByNum(m, p.track);
		if (i >= 0)
		{
			if (m->track[i].type == MEDIA_TRACK_VIDEO)
				vid++;
			else if (m->track[i].type == MEDIA_TRACK_AUDIO)
				aud++;
		}
	}

	"packets %d  video %d  audio %d  key %d  last %.2fs\n",
		n, vid, aud, keys, p.time;
	if (m->laced_skipped)
		"%d laced block(s) skipped; Vorbis needs lacing support\n",
			m->laced_skipped;

	MediaClose(m);
}

public I64 MediaPlayAudio(U8 *filename)
{//Decode the whole Vorbis track and hand it to the mixer. Returns the voice
//handle, or -1. AudioSFXPlayRef resamples, so the file rate need not match.
	CMediaCtx	*m = MediaOpen(filename);
	CMediaPacket p;
	CMediaTrack	*t;
	F64			*pl, *pr;
	U32			*frames;
	I64			 ti, n, i, cap, count, got = 0, handle = -1;
	I64			 l, r;

	if (!m)
	{
		"MediaPlayAudio: cannot open \"%s\".\n", filename;
		return -1;
	}

	ti = MediaTrackFind(m, MEDIA_TRACK_AUDIO);
	if (ti < 0 || m->track[ti].codec != MEDIA_CODEC_VORBIS)
	{
		"MediaPlayAudio: no Vorbis track.\n";
		MediaClose(m);
		return -1;
	}
	t = &m->track[ti];

	if (!MediaVorbisInit(t))
	{
		"MediaPlayAudio: Vorbis headers rejected.\n";
		MediaClose(m);
		return -1;
	}

	//blocksize1 is the largest window a packet can produce
	n      = ogg_blocksize1;
	pl     = MAlloc(n * sizeof(F64));
	pr     = MAlloc(n * sizeof(F64));
	cap    = ogg_rate * 8;
	frames = MAlloc(cap * sizeof(U32));

	MemSet(&p, 0, sizeof(CMediaPacket));
	while (MkvNext(m, &p))
	{
		if (p.track != t->num)
			goto next_pkt;
		if (!MediaVorbisDecode(&p, pl, pr, &count))
			goto next_pkt;
		if (got + count > cap)
		{//grow rather than truncate: a long track is still one allocation
			cap    = (got + count) * 2;
			frames = ReAlloc(frames, cap * sizeof(U32));
			if (!frames)
				break;
		}
		for (i = 0; i < count; i++)
		{
			l = ToI64(pl[i] * 32767.0);
			if (t->channels > 1)
				r = ToI64(pr[i] * 32767.0);
			else
				r = l;
			if (l >  32767)	l =  32767;
			if (l < -32768)	l = -32768;
			if (r >  32767)	r =  32767;
			if (r < -32768)	r = -32768;
			frames[got + i] = (l & 0xFFFF) | (r << 16);
		}
		got += count;
next_pkt:;
	}

	"MediaPlayAudio: %d frames at %dHz, %d ch\n", got, ogg_rate, ogg_channels;
	if (got > 0)
		handle = AudioSFXPlayRef(frames, got, ogg_rate);

	Free(pl);
	Free(pr);
	MediaClose(m);

	//frames stays live: AudioSFXPlayRef does not copy
	return handle;
}

public CDC *MediaVideoNext(CMediaCtx *m, I64 track_num, F64 *_time)
{//Next decodable video frame, as a DC the caller owns and DCDels.
//
//Keyframes only: inter prediction is not implemented, so predicted frames are
//skipped rather than shown as garbage.
	CMediaPacket p;
	U32			*argb;
	CDC			*dc;
	I64			 w = 0, h = 0;

	*_time = 0.0;
	MemSet(&p, 0, sizeof(CMediaPacket));

	while (MkvNext(m, &p))
	{
		if (p.track != track_num || !p.key)
			goto next_frame;
		argb = Vp8DecodeKeyframe(p.data, p.size, &w, &h);
		if (!argb)
			goto next_frame;
		dc = WEBPArgbToDC(argb, w, h, FALSE, NULL);
		Free(argb);
		if (!dc)
			goto next_frame;
		*_time = p.time;

		return dc;
next_frame:;
	}

	return NULL;
}
