// YKD native GIF decoder (GIF87a / GIF89a, ANIMATED). Pure ZealC - no
// ELF, no FFI. LZW-decompresses the first image into palette indices, expands
// via the global/local colour table into a truecolor CDC. The transparent
// colour index (from a Graphic Control Extension) becomes PIXF_TRANSPARENT so
// GrBlot() sees through it. GIFReadAnim*() returns every frame with disposal
// applied; GIFRead/GIFReadBuf still hand back just frame #1 for static callers.
// API mirrors PNGReadBuf / JPGReadBuf. GIF uses LZW, NOT DEFLATE, so none of the
// Inflate.ZC machinery applies - this is a self-contained LZW.

#help_index "Graphics/GIF"

#define GIF_MAXDICT		4096
#define GIF_MAXDIM		2000	// sanity cap; real web GIFs are far smaller

I64 GifU16(U8 *p)
{ // little-endian 16-bit
	return p[0] | p[1] << 8;
}

I64 GifDeinterlaceRow(I64 y, I64 ih)
{ // sequential decoded-row index y -> actual destination row for a 4-pass
  // interlaced GIF.
	I64 p1 = (ih + 7) / 8;	// pass 1: rows 0,8,16,...
	I64 p2 = (ih + 3) / 8;	// pass 2: rows 4,12,20,...
	I64 p3 = (ih + 1) / 4;	// pass 3: rows 2,6,10,...

	if (y < p1)
		return y * 8;
	y -= p1;
	if (y < p2)
		return 4 + y * 8;
	y -= p2;
	if (y < p3)
		return 2 + y * 4;
	y -= p3;

	return 1 + y * 2;		// pass 4: rows 1,3,5,...
}

I64 GifLZW(U8 *data, I64 data_len, I64 min_cs, U8 *out, I64 out_max, CTask *mt)
{ // decode GIF LZW into index bytes. Returns the count written (<= out_max).
	I32	*pfx = MAlloc(GIF_MAXDICT * sizeof(I32), mt);	// dict: prefix code
	U8	*sfx = MAlloc(GIF_MAXDICT, mt);					// dict: suffix byte
	U8	*stk = MAlloc(GIF_MAXDICT, mt);					// reversed-string scratch
	I64	 clear = 1 << min_cs, end = clear + 1;
	I64	 cs = min_cs + 1, next = clear + 2;
	I64	 bitbuf = 0, bitcnt = 0, bp = 0;
	I64	 code, prev = -1, first = 0, oc = 0, sp, i, in_code;

	for (i = 0; i < clear; i++)
	{
		pfx[i] = -1;
		sfx[i] = i;
	}

	while (oc < out_max)
	{
		if (!(oc & 8191))
			Yield;						// big images: keep the decode task cooperative
		while (bitcnt < cs && bp < data_len)
		{
			bitbuf |= data[bp++] << bitcnt;
			bitcnt += 8;
		}
		if (bitcnt < cs)
			break;						// out of data
		code = bitbuf & ((1 << cs) - 1);
		bitbuf = bitbuf >> cs;
		bitcnt -= cs;

		if (code == clear)
		{
			cs	 = min_cs + 1;
			next = clear + 2;
			prev = -1;
		}
		else if (code == end)
			break;
		else if (prev < 0)
		{ // first code after a clear must be a literal
			out[oc++] = code & 0xFF;
			prev  = code;
			first = code;
		}
		else
		{
			if (code < next)
				in_code = code;
			else
				in_code = prev;			// KwKwK: emit prev's string + its first char

			sp = 0;
			i  = in_code;
			while (i >= 0 && sp < GIF_MAXDICT)
			{
				stk[sp++] = sfx[i];
				i = pfx[i];
			}
			if (sp < 1)
				break;					// corrupt
			first = stk[sp - 1];
			while (sp > 0 && oc < out_max)
				out[oc++] = stk[--sp];
			if (code >= next && oc < out_max)
				out[oc++] = first;		// the extra char for the KwKwK case

			if (next < GIF_MAXDICT)
			{
				pfx[next] = prev;
				sfx[next] = first;
				next++;
				if (next == (1 << cs) && cs < 12)
					cs++;
			}
			prev = code;
		}
	}

	Free(pfx);
	Free(sfx);
	Free(stk);

	return oc;
}

#define GIF_MAXFRAMES	512

public class CGifAnim
{ // A decoded animation. Every frame is a FULL logical-screen canvas with the
  // disposal already applied, so a player only has to blit frames[i] - it does
  // not need to know anything about GIF composition rules.
	I64	  count;
	I64	  width, height;
	I64	  loop_count;		// 0 = loop forever
	CDC	**frames;
	I64	 *delays;			// milliseconds per frame
};

public U0 GIFAnimDel(CGifAnim *anim)
{
	I64 i;

	if (!anim)
		return;
	if (anim->frames)
	{
		for (i = 0; i < anim->count; i++)
			if (anim->frames[i])
				DCDel(anim->frames[i]);
		Free(anim->frames);
	}
	if (anim->delays)
		Free(anim->delays);
	Free(anim);
}

U0 GifCanvasCopy(CDC *dst, CDC *src)
{ // straight copy between two same-size canvases
	I64 y;

	for (y = 0; y < src->height; y++)
		MemCopy(dst->body + y * dst->width_internal,
				src->body + y * src->width_internal,
				src->width * sizeof(U32));
}

U0 GifClearRect(CDC *dc, I64 x0, I64 y0, I64 rw, I64 rh)
{ // restore-to-background = punch the frame's rect back to transparent
	I64	 x, y;
	U32	*row;

	for (y = y0; y < y0 + rh; y++)
		if (0 <= y < dc->height)
		{
			row = dc->body + y * dc->width_internal;
			for (x = x0; x < x0 + rw; x++)
				if (0 <= x < dc->width)
					row[x] = PIXF_TRANSPARENT;
		}
}

public CGifAnim *GIFReadAnimBuf(U8 *buf, I64 size, CTask *mem_task=NULL,
								I64 max_frames=GIF_MAXFRAMES)
{ // Decode every frame of a GIF. NULL on error.
  // Frames are composited onto a persistent canvas exactly as the spec wants:
  // the PREVIOUS frame's disposal method is applied before the next frame is
  // drawn (0/1 leave as-is, 2 restore-to-background, 3 restore-to-previous),
  // then the canvas is snapshotted. That ordering is the whole trick - GIF
  // disposal describes what to do AFTER a frame has been shown.
	U8	*p = buf, *gct = NULL, *act, *lzw, *idx, *pal;
	CDC	*canvas = NULL, *saved = NULL, *snap;
	CGifAnim *anim;
	I64	 w, h, packed, gct_flag, gct_sz, c, label, len, lzw_len, npix, i, x, y, py;
	I64	 left, top, iw, ih, ipacked, lct_flag, interlace, lct_sz, min_cs, srcrow;
	I64	 trans_flag = 0, trans_idx = -1, act_n = 0;
	I64	 delay = 0, disposal = 0, n = 0;
	I64	 pend_disp = 0, pend_x = 0, pend_y = 0, pend_w = 0, pend_h = 0;
	U32	*row;

	if (size < 13 || buf[0] != 'G' || buf[1] != 'I' || buf[2] != 'F')
		return NULL;
	w = GifU16(buf + 6);
	h = GifU16(buf + 8);
	if (w < 1 || h < 1 || w > GIF_MAXDIM || h > GIF_MAXDIM)
		return NULL;
	if (max_frames < 1)
		max_frames = 1;
	if (max_frames > GIF_MAXFRAMES)
		max_frames = GIF_MAXFRAMES;

	packed	 = buf[10];
	gct_flag = packed >> 7 & 1;
	gct_sz	 = 2 << (packed & 7);
	p = buf + 13;
	if (gct_flag)
	{
		gct	 = p;
		p	+= gct_sz * 3;
	}

	anim = MAlloc(sizeof(CGifAnim), mem_task);
	anim->count		 = 0;
	anim->width		 = w;
	anim->height	 = h;
	anim->loop_count = 0;
	anim->frames	 = MAlloc(max_frames * sizeof(CDC *), mem_task);
	anim->delays	 = MAlloc(max_frames * sizeof(I64), mem_task);

	canvas = DCNew(w, h, mem_task);
	MemSetU32(canvas->body, PIXF_TRANSPARENT,
			  canvas->width_internal * canvas->height);

	while (p < buf + size && n < max_frames)
	{
		c = *p++;
		if (c == 0x3B)					// trailer
			break;
		if (c == 0x21)
		{ // extension. Application extensions (0xFF, e.g. NETSCAPE2.0) need no
		  // special case: the generic sub-block skipper below walks them.
			label = *p++;
			if (label == 0xF9)
			{ // graphic control: transparency, delay AND disposal
				len = *p++;
				if (len >= 4)
				{
					trans_flag = p[0] & 1;
					disposal   = p[0] >> 2 & 7;
					delay	   = GifU16(p + 1) * 10;	// 1/100s -> ms
					trans_idx  = p[3];
				}
				p += len;
			}
			while (p < buf + size && (len = *p++) != 0)
				p += len;
		}
		else if (c == 0x2C)
		{ // image descriptor
			left	 = GifU16(p);
			top		 = GifU16(p + 2);
			iw		 = GifU16(p + 4);
			ih		 = GifU16(p + 6);
			ipacked	 = p[8];
			p		+= 9;
			lct_flag  = ipacked >> 7 & 1;
			interlace = ipacked >> 6 & 1;
			lct_sz	  = 2 << (ipacked & 7);
			act	  = gct;
			act_n = gct_sz;
			if (lct_flag)
			{
				act	  = p;
				act_n = lct_sz;
				p	 += lct_sz * 3;
			}
			if (!act || iw < 1 || ih < 1 || iw > GIF_MAXDIM || ih > GIF_MAXDIM)
				break;
			min_cs = *p++;
			if (min_cs < 1 || min_cs > 8)	// spec max 8: indices fit a byte
				break;

			// concatenate the LZW data sub-blocks into one buffer
			lzw		= MAlloc(size, mem_task);
			lzw_len = 0;
			while (p < buf + size && (len = *p++) != 0)
			{
				if (lzw_len + len > size)
					break;
				MemCopy(lzw + lzw_len, p, len);
				lzw_len += len;
				p		+= len;
			}

			npix = iw * ih;
			idx	 = MAlloc(npix, mem_task);
			MemSet(idx, 0, npix);
			GifLZW(lzw, lzw_len, min_cs, idx, npix, mem_task);
			Free(lzw);

			// the PREVIOUS frame's disposal, applied now
			if (pend_disp == 2)
				GifClearRect(canvas, pend_x, pend_y, pend_w, pend_h);
			else if (pend_disp == 3 && saved)
				GifCanvasCopy(canvas, saved);
			// if THIS frame restores-to-previous, snapshot before drawing
			if (disposal == 3)
			{
				if (!saved)
					saved = DCNew(w, h, mem_task);
				GifCanvasCopy(saved, canvas);
			}

			for (y = 0; y < ih; y++)
			{
				if (interlace)
					py = GifDeinterlaceRow(y, ih);
				else
					py = y;
				if (top + py < h)
				{
					row	   = canvas->body + (top + py) * canvas->width_internal;
					srcrow = y * iw;
					for (x = 0; x < iw; x++)
						if (left + x < w)
						{
							i = idx[srcrow + x];
							if (!(trans_flag && i == trans_idx) && i < act_n)
							{//i >= palette size (corrupt): leave transparent
								pal			  = act + i * 3;
								row[left + x] = pal[0] << 16 | pal[1] << 8 | pal[2];
							}
						}
				}
			}
			Free(idx);

			snap = DCNew(w, h, mem_task);
			GifCanvasCopy(snap, canvas);
			anim->frames[n] = snap;
			anim->delays[n] = delay;
			n++;

			pend_disp = disposal;
			pend_x	  = left;
			pend_y	  = top;
			pend_w	  = iw;
			pend_h	  = ih;
			// GCE state is per-frame: it must not leak into the next one
			delay	   = 0;
			disposal   = 0;
			trans_flag = 0;
			trans_idx  = -1;
		}
		else
			break;						// unknown block type
	}

	anim->count = n;
	if (canvas)
		DCDel(canvas);
	if (saved)
		DCDel(saved);
	if (!n)
	{
		GIFAnimDel(anim);
		return NULL;
	}
	return anim;
}

public CGifAnim *GIFReadAnim(U8 *filename, CTask *mem_task=NULL,
							 I64 max_frames=GIF_MAXFRAMES)
{
	I64	 size;
	U8	*buf = FileRead(filename, &size);
	CGifAnim *a;

	if (!buf)
		return NULL;
	a = GIFReadAnimBuf(buf, size, mem_task, max_frames);
	Free(buf);

	return a;
}

public CDC *GIFReadBuf(U8 *buf, I64 size, CTask *mem_task=NULL)
{ // First frame only, as before - now a thin wrapper so there is exactly ONE
  // decode path and the static and animated cases cannot drift apart.
	CGifAnim *a = GIFReadAnimBuf(buf, size, mem_task, 1);
	CDC		 *dc;

	if (!a)
		return NULL;
	dc = a->frames[0];
	a->frames[0] = NULL;	// ownership passes to the caller
	GIFAnimDel(a);

	return dc;
}

public CDC *GIFRead(U8 *filename, CTask *mem_task=NULL)
{ // decode a .GIF file into a truecolor CDC. NULL on error.
	I64	 size;
	U8	*buf = FileRead(filename, &size);
	CDC	*dc;

	if (!buf)
		return NULL;
	dc = GIFReadBuf(buf, size, mem_task);
	Free(buf);

	return dc;
}
