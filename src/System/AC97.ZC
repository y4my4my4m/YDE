//YKD native AC'97 audio driver + software mixer.
//Ported from ZealAmp/erythros (Alec Murphy / y4my4m), adapted to the ZealOS
//kernel PCI API. Pure ZealC - no ELF, no FFI. Polling driven (no IRQs).
//
//QEMU needs: -device AC97,audiodev=<your audiodev>
//If no AC'97 device is found, everything no-ops safely (ac97.present=FALSE).
//
//Output path: streams are CFifoI64s of U32 frames (L16|R16<<16, 48kHz).
//AC97MixTask mixes all live streams into the hardware Buffer Descriptor List.

#define AC97_INT_IOC			(1 << 3)

#define AC97_BDL_BUF_SIZE		2044
#define AC97_MAX_BDLS			32
#define AC97_PCM_BUF_SIZE		2048
#define AC97_PCM_OUT			1

//Native Audio Mixer registers (U16)
#define AC97_RESET				0x00
#define AC97_MASTER_VOL			0x02
#define AC97_PCM_VOL			0x18

//Native Audio Bus Master registers
#define AC97_PCM_OUTPUT_REG_BOX	0x10
#define AC97_GLOBAL_CTL			0x2C

//NABM register box registers
#define AC97_BUFFER_DSC_ADDR	0x00
#define AC97_CURRENT_INDEX		0x04 //Buffer the hardware is playing RIGHT NOW.
#define AC97_LAST_VALID_ENTRY	0x05
#define AC97_TRANSFER_STS		0x06
#define AC97_BUFFER_CNT			0x0B

//How many buffers to keep queued ahead of the play cursor. Each buffer is
//AC97_BDL_BUF_SIZE/4 = 511 frames, about 10.6ms at 48kHz, so 4 buffers is
//roughly 42ms of latency. The mixer task polls every 1ms, so it has ample
//time to top the queue back up; going much lower risks underrun crackle,
//going higher is audible lag on game sound effects.
#define AC97_TARGET_LEAD		4

class CAC97PCIInfo
{
	U16 vendor_id, device_id;
	U32 bar[6];
};

class CAC97BDLEntry
{
	U32 addr;
	U16 length; //Samples - 1.
	U16 flags;
};

class CAC97BDL
{
	CAC97BDLEntry entries[AC97_MAX_BDLS];
};

class CAC97
{
	CAC97PCIInfo pci;
	CAC97BDL	*bdl;
	U16			 nam, nabm;
	I64			 volume; //0-100 master, cached.
	Bool		 present;
} ac97;

#define AUDIO_MAX_STREAMS			4
#define AUDIO_STREAM_FIFO_FRAMES	262144 //~5.4s of 48kHz stereo per stream.

class CAudioStream
{
	CFifoI64 *data;
};

//SFX voices.
//
//AC'97 hardware has exactly ONE PCM-Out DMA engine - there are no hardware
//voices to enable - so every AC'97 driver mixes in software, and the voice count
//is purely a software choice. This costs nothing on real hardware because it
//changes no hardware interaction at all: the same single DMA buffer is filled,
//just from more sources.
//
//A voice REFERENCES the caller's PCM rather than copying it into a FIFO, which
//is what makes many of them affordable: a FIFO stream is 2MB (one I64 slot per
//4-byte frame), while a voice is a few dozen bytes. The streams stay for
//continuous feeds - ZealAmp, Tracker, the browser's <audio> - which genuinely
//need buffering; one-shot effects do not.
//
//CONTRACT: the frames passed in must stay valid until playback finishes or
//AudioSFXStopAll is called. The caller owns that memory.
//The mixer's own output rate, used to work out each voice's resample step.
#define QSND_MIX_RATE			48000
#define AUDIO_MAX_SFX_VOICES	24
#define AUDIO_VOL_UNITY			256

class CAudioVoice
{
	U32	*frames;	//borrowed, NOT owned
	I64	 count;
	I64	 pos_fp;	//16.16 position into frames[]
	I64	 step_fp;	//16.16 source samples advanced per output sample
	I64	 vol_l;		//0..AUDIO_VOL_UNITY
	I64	 vol_r;
	I64	 serial;	//bumped on every allocation; see AudioSFXStop
	Bool active;

	//A looping voice never finishes on its own: at the end of the buffer the
	//position wraps instead of clearing `active`. Used for sustained sources
	//- wind, water, machinery - which are one short sample played forever
	//rather than a sound that has a natural end.
	Bool loop;
};

//A handle is slot + serial. The slot alone is not enough: by the time a caller
//asks to stop a voice it may already have finished and been handed to someone
//else, and stopping that one instead is a bug you hear rather than see.
#define AUDIO_VOICE_SHIFT	8

class CAudio
{
	CAudioStream output[AUDIO_MAX_STREAMS];
	I64			 output_frames[AUDIO_MAX_STREAMS];
	CAudioVoice	 voice[AUDIO_MAX_SFX_VOICES];
	I64			 voice_lock;
} audio;

U0 AudioInit()
{
	I64 i;

	for (i = 0; i < AUDIO_MAX_STREAMS; i++)
		audio.output[i].data = FifoI64New(AUDIO_STREAM_FIFO_FRAMES, sys_task);

	audio.voice_lock = 0;
	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		audio.voice[i].active  = FALSE;
		audio.voice[i].frames  = NULL;
		audio.voice[i].serial  = 0;
		audio.voice[i].count   = 0;
		audio.voice[i].pos_fp  = 0;
		audio.voice[i].step_fp = 1 << 16;
		audio.voice[i].loop    = FALSE;
	}
}

public I64 AudioSFXPlayRef(U32 *frames, I64 count, I64 rate = QSND_MIX_RATE,
	I64 vol_l = AUDIO_VOL_UNITY, I64 vol_r = AUDIO_VOL_UNITY,
	Bool loop = FALSE)
{//Play a buffer WITHOUT copying it, resampling from `rate` to the mixer's
 //output rate. Returns the voice, or -1 if all are busy. The buffer must
 //outlive playback - see the contract above.
 //
 //`loop` makes the voice repeat until it is stopped explicitly. It defaults
 //off, so every existing caller keeps the one-shot behaviour it was written
 //against; a looping voice also never frees itself, so whoever starts one owns
 //stopping it.
 //
 //Taking a rate here is what lets callers keep their audio at its native rate.
 //Game effects are 11025Hz; pre-converting them to the 48kHz output rate costs
 //over four times the memory for no gain in quality, since the conversion is
 //the same nearest-sample step either way.
	I64 i;
	I64 slot = -1;

	if (!frames || count < 1)
		return -1;

	if (rate < 1)
		rate = QSND_MIX_RATE;

	if (vol_l < 0)					vol_l = 0;
	if (vol_l > AUDIO_VOL_UNITY)	vol_l = AUDIO_VOL_UNITY;
	if (vol_r < 0)					vol_r = 0;
	if (vol_r > AUDIO_VOL_UNITY)	vol_r = AUDIO_VOL_UNITY;

	//Task-only contention (the mixer is a task, not an interrupt), so a plain
	//spin with Yield is safe here.
	while (LBts(&audio.voice_lock, 0))
		Yield;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		if (!audio.voice[i].active)
		{
			slot = i;
			break;
		}
	}

	if (slot >= 0)
	{
		audio.voice[slot].frames  = frames;
		audio.voice[slot].count   = count;
		audio.voice[slot].pos_fp  = 0;
		audio.voice[slot].step_fp = (rate << 16) / QSND_MIX_RATE;
		audio.voice[slot].vol_l   = vol_l;
		audio.voice[slot].vol_r   = vol_r;
		audio.voice[slot].loop    = loop;
		audio.voice[slot].serial++;

		//Set LAST: the mixer reads this flag to decide whether the rest of the
		//slot is meaningful.
		audio.voice[slot].active = TRUE;

		slot |= audio.voice[slot].serial << AUDIO_VOICE_SHIFT;
	}

	LBtr(&audio.voice_lock, 0);

	return slot;
}

I64 AudioSFXSlotOf(I64 handle)
{//The slot a handle refers to, or -1 if that voice has already been reused.
	I64 slot;

	if (handle < 0)
		return -1;

	slot = handle & ((1 << AUDIO_VOICE_SHIFT) - 1);
	if (slot < 0 || slot >= AUDIO_MAX_SFX_VOICES)
		return -1;

	if (!audio.voice[slot].active)
		return -1;
	if (audio.voice[slot].serial != handle >> AUDIO_VOICE_SHIFT)
		return -1;

	return slot;
}

public Bool AudioSFXPlaying(I64 handle)
{//TRUE while this specific play is still running.
	return ToBool(AudioSFXSlotOf(handle) >= 0);
}

public U0 AudioSFXStop(I64 handle)
{//Stop one voice. Used to take a channel away from a sound that is being
 //replaced, which is what Quake does when an entity retriggers the same one.
	I64 slot;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	slot = AudioSFXSlotOf(handle);
	if (slot >= 0)
	{
		//Cleared before `active` so a looping voice cannot be re-armed by the
		//mixer between the two writes.
		audio.voice[slot].loop   = FALSE;
		audio.voice[slot].active = FALSE;
		audio.voice[slot].frames = NULL;
	}

	LBtr(&audio.voice_lock, 0);
}

public U0 AudioSFXVoiceVolSet(I64 handle, I64 vol_l, I64 vol_r)
{//Re-aim a voice that is already playing. The listener moves while a sound is
 //still running, and a fixed pan set at trigger time drifts audibly wrong.
	I64 slot;

	if (vol_l < 0)					vol_l = 0;
	if (vol_l > AUDIO_VOL_UNITY)	vol_l = AUDIO_VOL_UNITY;
	if (vol_r < 0)					vol_r = 0;
	if (vol_r > AUDIO_VOL_UNITY)	vol_r = AUDIO_VOL_UNITY;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	slot = AudioSFXSlotOf(handle);
	if (slot >= 0)
	{
		audio.voice[slot].vol_l = vol_l;
		audio.voice[slot].vol_r = vol_r;
	}

	LBtr(&audio.voice_lock, 0);
}

public U0 AudioSFXStopAll()
{//Silence every voice. Must be called BEFORE freeing any referenced PCM.
	I64 i;

	while (LBts(&audio.voice_lock, 0))
		Yield;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		//loop first, or a repeating voice re-arms itself in the mixer between
		//this write and the next one and survives the shutdown.
		audio.voice[i].loop   = FALSE;
		audio.voice[i].active = FALSE;
		audio.voice[i].frames = NULL;
	}

	LBtr(&audio.voice_lock, 0);

	//The mixer may be part way through a buffer holding a pointer it already
	//read. It runs every millisecond, so this is comfortably long enough for
	//any in-flight pass to finish before the caller frees the samples.
	Sleep(4);
}

public I64 AudioSFXVoicesActive()
{//How many voices are playing. Useful for diagnosing dropped effects.
	I64 i;
	I64 n = 0;

	for (i = 0; i < AUDIO_MAX_SFX_VOICES; i++)
	{
		if (audio.voice[i].active)
			n++;
	}

	return n;
}

public I64 AudioAvailableOutputStreamGet()
{//First idle output stream, or -1.
	I64 stream = 0;

	while (stream < AUDIO_MAX_STREAMS && FifoI64Count(audio.output[stream].data))
		stream++;
	if (stream > AUDIO_MAX_STREAMS - 1)
		return -1;

	return stream;
}

public I64 AudioSFXPlay(U32 *frames, I64 count)
{//Queue a one-shot buffer of U32 (L16|R16) 48kHz frames. Returns stream or -1.
	I64 i, stream = AudioAvailableOutputStreamGet;

	if (stream < 0)
		return stream;
	audio.output_frames[stream] = 0;
	for (i = 0; i < count; i++)
		FifoI64Ins(audio.output[stream].data, frames[i]);

	return stream;
}

//Incremental streaming feed (browser <audio>): open a stream, push frames one at
//a time (respecting fifo space so a long song does not need a giant buffer),
//stop when done. AudioStreamPush returns FALSE when the fifo is full - the
//caller sleeps and retries. Complements AudioSFXPlay (which queues all at once).
public I64 AudioStreamOpen()
{//Grab a free output stream, cleared + ready to be fed. -1 if none free.
	I64 stream = AudioAvailableOutputStreamGet;

	if (stream >= 0)
	{
		audio.output_frames[stream] = 0;
		FifoI64Flush(audio.output[stream].data);
	}

	return stream;
}

public Bool AudioStreamPush(I64 stream, U32 frame)
{//Push one 48kHz L16|R16 frame if there is room. FALSE = fifo full (retry).
	if (stream < 0 || stream >= AUDIO_MAX_STREAMS)
		return FALSE;
	if (FifoI64Count(audio.output[stream].data) >= AUDIO_STREAM_FIFO_FRAMES - 8192)
		return FALSE;
	FifoI64Ins(audio.output[stream].data, frame);

	return TRUE;
}

public U0 AudioStreamStop(I64 stream)
{//Silence + release a streaming feed.
	if (0 <= stream < AUDIO_MAX_STREAMS)
		FifoI64Flush(audio.output[stream].data);
}

public U0 AC97ToneTest(I64 ms=1500, I64 hz=440)
{//Queue a square-wave test tone on a free output stream.
	I64  i, frames = 48000 * ms / 1000, half = 24000 / hz;
	I16  s;
	U32 *buf;

	if (!ac97.present)
		return;
	buf = MAlloc(frames * sizeof(U32));
	for (i = 0; i < frames; i++)
	{
		if (i / half & 1)
			s = 0x2000;
		else
			s = -0x2000;
		buf[i].i16[0] = s;
		buf[i].i16[1] = s;
	}
	AudioSFXPlay(buf, frames);
	Free(buf);
}

public U0 AC97MasterVolumeSet(I64 pct)
{//0 = mute, 100 = max.
	I64 att;

	ac97.volume = ClampI64(pct, 0, 100);
	if (!ac97.present)
		return;
	att = (100 - ac97.volume) * 31 / 100;
	if (!ac97.volume)
		OutU16(ac97.nam + AC97_MASTER_VOL, 0x8000); //Mute bit.
	else
		OutU16(ac97.nam + AC97_MASTER_VOL, att << 8 | att);
}

U0 AC97OutputMix(U32 *buf, I64 length)
{//Sum every live source into one hardware buffer.
 //
 //Two kinds of source, mixed differently on purpose:
 //  streams - buffered continuous feeds, averaged the way they always were so
 //            existing players sound exactly as before
 //  voices  - one-shot effects, SUMMED and then clamped, because averaging
 //            would make every effect quieter as more of them played, which is
 //            wrong for game audio: a second gunshot must not halve the first
	CAudioVoice *vp;
	I64 i, j, acc_l, acc_r, acc_streams;
	I64 sample;
	I64 vsamp;

	for (i = 0; i < length / 4; i++)
	{
		acc_l = 0;
		acc_r = 0;
		acc_streams = 0;
		for (j = 0; j < AUDIO_MAX_STREAMS; j++)
		{
			if (FifoI64Count(audio.output[j].data))
			{
				FifoI64Remove(audio.output[j].data, &sample);
				audio.output_frames[j]++;
				acc_streams++;
				acc_l += sample.i16[0];
				acc_r += sample.i16[1];
			}
		}

		if (acc_streams)
		{
			acc_l = ToI64(acc_l / Sqrt(acc_streams));
			acc_r = ToI64(acc_r / Sqrt(acc_streams));
		}

		for (j = 0; j < AUDIO_MAX_SFX_VOICES; j++)
		{
			vp = &audio.voice[j];

			if (vp->active && vp->frames && (vp->pos_fp >> 16) < vp->count)
			{
				//Nearest source sample. These are 11kHz effects played out of a
				//48kHz path, and the original resamples no better.
				vsamp = vp->frames[vp->pos_fp >> 16];

				//Parenthesised deliberately: shift and multiply precedence
				//differs from C here, so mixed arithmetic gets explicit
				//grouping rather than relying on it.
				acc_l += (vsamp.i16[0] * vp->vol_l) / AUDIO_VOL_UNITY;
				acc_r += (vsamp.i16[1] * vp->vol_r) / AUDIO_VOL_UNITY;

				vp->pos_fp += vp->step_fp;
				if ((vp->pos_fp >> 16) >= vp->count)
				{
					if (vp->loop)
					{
						//Subtract the buffer length rather than resetting to
						//zero: that carries the fractional phase across the
						//join, so the wrap does not quantise to a sample
						//boundary and click once per repeat. A while, not an
						//if, because one output step can span a very short
						//buffer more than once.
						while ((vp->pos_fp >> 16) >= vp->count)
							vp->pos_fp -= vp->count << 16;
					}
					else
						vp->active = FALSE;
				}
			}
		}

		//Clamp rather than wrap. Wrapping an overloaded sum inverts the
		//waveform and is heard as a loud crack.
		if (acc_l >  32767)	acc_l =  32767;
		if (acc_l < -32768)	acc_l = -32768;
		if (acc_r >  32767)	acc_r =  32767;
		if (acc_r < -32768)	acc_r = -32768;

		buf[i].i16[0] = acc_l;
		buf[i].i16[1] = acc_r;
	}
}


U0 AC97BufferFill()
{//Keep a small, BOUNDED number of buffers queued ahead of the play cursor.
 //
 //This used to fill exactly one buffer per call without ever looking at where
 //the hardware actually was. Whenever the card drained faster than the mixer
 //task refilled, the last-valid index slipped further and further ahead of the
 //play position, and the queue grew until it approached the whole 32-entry
 //ring - about 340ms of audio waiting to be heard. That is what made sound
 //effects arrive noticeably after the action that caused them.
 //
 //Reading the current index closes the loop: fill only until the lead reaches
 //the target, so latency stays fixed instead of drifting upward.
	I64  civ  = InU8(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_CURRENT_INDEX);
	I64  lvi  = InU8(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_LAST_VALID_ENTRY);
	I64  lead;
	I64  guard = 0;
	U32 *buf;

	civ &= AC97_MAX_BDLS - 1;
	lvi &= AC97_MAX_BDLS - 1;

	//Distance from the play cursor to the last valid buffer, around the ring.
	lead = (lvi - civ) & (AC97_MAX_BDLS - 1);

	//The guard bounds the work per call: without it a stalled or misreported
	//index could spin here filling the entire ring.
	while (lead < AC97_TARGET_LEAD && guard < AC97_MAX_BDLS)
	{
		//Same fill-then-advance order the working driver used: mix into the
		//entry the hardware reports as last-valid, then move the register on.
		buf = ac97.bdl->entries[lvi].addr;
		AC97OutputMix(buf, AC97_BDL_BUF_SIZE);

		lvi = (lvi + 1) & (AC97_MAX_BDLS - 1);
		OutU8(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_LAST_VALID_ENTRY, lvi);

		lead++;
		guard++;
	}
}

U0 AC97MixTask()
{
	U16 status;

	while (TRUE)
	{
		status = InU16(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_TRANSFER_STS);
		if (status & AC97_INT_IOC)
		{
			AC97BufferFill;
			OutU16(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_TRANSFER_STS, 0x1C);
		}
		Sleep(1);
	}
}

U0 AC97PCIInfoGet(I64 i, CAC97PCIInfo *pci)
{
	I64 j;

	pci->vendor_id = PCIReadU32(i.u8[2], i.u8[1], i.u8[0], 0x0) & 0xFFFF;
	pci->device_id = PCIReadU32(i.u8[2], i.u8[1], i.u8[0], 0x0) >> 16;
	for (j = 0; j < 6; j++)
		pci->bar[j] = PCIReadU32(i.u8[2], i.u8[1], i.u8[0], 0x10 + 0x04 * j);
}

I64 AC97Init()
{
	I64 i, j;

	ac97.present = FALSE;
	j = PCIClassFind(0x040100, 0); //Class 04=multimedia, 01=audio.
	if (j < 0)
	{
		"[AC'97] No audio device found; audio disabled.\n";
		return -1;
	}
	AC97PCIInfoGet(j, &ac97.pci);

	ac97.nam  = ac97.pci.bar[0] & 0xFFFFFF00;
	ac97.nabm = ac97.pci.bar[1] & 0xFFFFFF00;

	PCIWriteU8(j.u8[2], j.u8[1], j.u8[0], 0x4, 5); //Port IO on, MMIO off.

	OutU32(ac97.nabm + AC97_GLOBAL_CTL, 0x03);
	OutU16(ac97.nam + AC97_RESET, 0xFFFF);
	OutU16(ac97.nam + AC97_PCM_VOL, 0x0000); //PCM out: max.

	ac97.bdl = CAllocAligned(sizeof(CAC97BDL), 4096, sys_task->code_heap);
	for (i = 0; i < AC97_MAX_BDLS; i++)
	{
		ac97.bdl->entries[i].addr	= CAllocAligned(AC97_PCM_BUF_SIZE, 4096, sys_task->code_heap);
		ac97.bdl->entries[i].length	= AC97_BDL_BUF_SIZE / 2;
		ac97.bdl->entries[i].flags	= 1 << 15; //IOC.
	}
	OutU32(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_BUFFER_DSC_ADDR, ac97.bdl);

	ac97.present = TRUE;
	AC97MasterVolumeSet(80);

	OutU8(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_BUFFER_CNT, 0);
	AC97BufferFill;
	OutU8(ac97.nabm + AC97_PCM_OUTPUT_REG_BOX + AC97_BUFFER_CNT, 1);

	Spawn(&AC97MixTask, , "AC97 Mixer", 1);
	"[AC'97] Audio up: NAM 0x%04X NABM 0x%04X.\n", ac97.nam, ac97.nabm;

	return 0;
}

AudioInit;
AC97Init;
