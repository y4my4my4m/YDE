//YDE boot splash - dismissal only.
//
//Nothing here draws. ::/StartOS.ZC animates the splash into the framebuffer
//before the System compile and hangs YDEWireOverlay on
//gr.fp_final_screen_update ahead of the WinMgr's first frame, so the animation
//is continuous from kernel handover to desktop. This file holds only the
//takedown decision, which needs kbd/mouse state the boot path does not touch.

//Splash exits on input. A positive value adds a timeout in seconds for
//unattended boots; 0 waits forever.
#define YDE_SPLASH_SECS		0.0
#define YDE_SPLASH_SETTLE	2.0		//settle after boot, see YDESplashDismissTask

extern Bool yde_boot_done; //StartOS.ZC sets this once boot has finished.

U0 YDESplashDismissTask()
{//Sole path that takes the splash down.
	F64	 t0	  = yde_wire_t0, settled = 0.0;	//clock base set at kernel handover
	I64	 snap = kbd.count, hits = 0;
	Bool lb0  = mouse.lb, rb0 = mouse.rb, go = FALSE;

	while (yde_wire_up && !go)
	{
		if (!yde_boot_done || settled <= 0.0 || tS - settled < YDE_SPLASH_SETTLE)
		{//Re-baseline until boot is done and has settled. Input before that is
		//not the user: keys typed at the boot loader reach the kernel driver
		//only once it initialises, and the mouse reports garbage buttons until
		//its own init. Both land after this task starts, so a single sample at
		//entry baselines against a phantom press.
			if (yde_boot_done && settled <= 0.0)
				settled = tS;
			snap = kbd.count;
			lb0  = mouse.lb;
			rb0  = mouse.rb;
			hits = 0;
		}
		else
		{//Past the settle: boot is finished and the desktop behind the splash is
		//built, so input counts from here.
		//lb0/rb0 mean the button was already down at the baseline. Cleared on
		//release, never set on press, so a held click reads as down for every
		//poll it lasts; comparing against the previous poll yields one edge and
		//never reaches the two-poll threshold below.
			yde_wire_ready = TRUE;
			if (!mouse.lb)
				lb0 = FALSE;
			if (!mouse.rb)
				rb0 = FALSE;
			//Two consecutive polls: a one-frame glitch is not a press.
			if (kbd.count != snap || (mouse.lb && !lb0) || (mouse.rb && !rb0))
				hits++;
			else
				hits = 0;
			if (hits >= 2)
				go = TRUE;
		}
		if (YDE_SPLASH_SECS > 0.0 && tS - t0 >= YDE_SPLASH_SECS)
			go = TRUE;
		Sleep(33);
	}

	YDEWireRelease;
}

U0 YDESplashStart()
{//Overlay is already up; this only watches for the dismissal.
	Spawn(&YDESplashDismissTask, NULL, "YDE Splash");
}

YDESplashStart;
