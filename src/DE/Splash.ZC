//YDE boot splash. Run from StartOS.ZC once the WinMgr task exists.
//
//Composited over the finished frame by gr.fp_final_screen_update, so boot
//carries on underneath it: no waiting, no z-order fighting, no hidden windows.
//
//Two layers. The background gradient is rendered once. The logo is a real
//SPT_MESH sprite - the CD3I32 + CMeshTri layout ::/Apps/GrModels emits and the
//sprite editor edits - plotted by Sprite3 through the kernel 3D pipeline:
//DCMat4x4Set spins it, the depth buffer occludes it, dc->lighting shades it.
//Triangle colours are ColorRGB() pens, so the shading stays truecolor.
//
//Every colour derives from one hue, read from the saved YDE config.

DefineListLoad("YDE_MOTTOS",
	"Charter? What charter.\0"
	"640x480 was a suggestion.\0"
	"16 colors were not enough.\0"
	"No ELFs were harmed.\0"
	"Divine intellect, divine intuition.\0"
	"Ring-0 all the way down.\0"
	"Do you like the command line?\0");

#define YS_CFG			"::/Home/Config/YDE.CFG"
#define YS_HUE_DEFAULT	271		//YKD violet, same as DE/Theme.ZC.

#define YS_LW			640		//logo layer size, in pixels
#define YS_LH			320
//The logotype model lives in YDEMesh.ZC as a baked SPT_MESH sprite. MeshGen.ZC
//regenerates it from the cell grid, the way ::/Apps/GrModels regenerates its
//models; nothing here builds geometry.
#include "::/DE/YDEMesh"

CDC	 *yde_splash_dc		= NULL;		//Static full-screen background.
CDC	 *yde_logo_dc		= NULL;		//Front logo layer, read by the overlay.
CDC	 *yde_logo_back		= NULL;		//Back logo layer, written by the animator.
I64	  yde_logo_x		= 0;
I64	  yde_logo_y		= 0;
I64	  yde_hue			= YS_HUE_DEFAULT;
Bool  yde_splash_up		= FALSE;
U0	 (*yde_splash_old_hook)(CDC *dc) = NULL;

U8 *ys_sprite = NULL;		//YDEMesh.ZC sprite elems, fed to Sprite3

/* ---------------- colour ---------------- */

I64 YSHsv(I64 hue, I64 s, I64 v)
{//HSV to a packed 0xRRGGBB. hue 0..359, s/v 0..255. Integer math only.
//Same construction as DEHue2RGB, which does not exist yet at splash time.
	I64 r, g, b, i, f, p, q, t;

	hue = ClampI64(hue, 0, 359);
	i = hue / 60;
	f = hue % 60;
	p = v * (255 - s) / 255;
	q = v * (255 * 60 - s * f) / (255 * 60);
	t = v * (255 * 60 - s * (60 - f)) / (255 * 60);
	switch (i)
	{
		case 0:	 r = v; g = t; b = p; break;
		case 1:	 r = q; g = v; b = p; break;
		case 2:	 r = p; g = v; b = t; break;
		case 3:	 r = p; g = q; b = v; break;
		case 4:	 r = t; g = p; b = v; break;
		default: r = v; g = p; b = q; break;
	}

	return (r & 0xFF) << 16 | (g & 0xFF) << 8 | b & 0xFF;
}

I64 YSMix(I64 a, I64 b, I64 t)
{//Blend two packed colours; t/256 of b.
	I64 ar = a >> 16 & 0xFF, ag = a >> 8 & 0xFF, ab = a & 0xFF,
		br = b >> 16 & 0xFF, bg = b >> 8 & 0xFF, bb = b & 0xFF;

	return (ar + (br - ar) * t / 256) << 16 |
		   (ag + (bg - ag) * t / 256) << 8 |
		   (ab + (bb - ab) * t / 256);
}

I64 YSHueRead()
{//Accent hue from the saved desktop config, matched at line start. The DE is
//not compiled yet, so this parses the file DEConfigSave writes.
	I64	 size, hue = YS_HUE_DEFAULT;
	U8	*body, *p;

	if (!FileFind(YS_CFG))
		return hue;
	body = FileRead(YS_CFG, &size);
	if (!body)
		return hue;
	p = StrFind("hue ", body);
	while (p)
	{
		if (p == body || p[-1] == '\n')
		{
			hue = Str2I64(p + 4);
			p = NULL;
		}
		else
			p = StrFind("hue ", p + 1);
	}
	Free(body);

	return ClampI64(hue, 0, 359);
}

/* ---------------- mesh ---------------- */

U0 YSMeshRecolor(U8 *elems, I64 col)
{//The baked sprite carries a placeholder pen. Repainting every CMeshTri is what
//keeps the logo tracking the desktop accent without rebaking the model.
	CSpriteMeshU8s	*m = elems;
	CMeshTri		*t;
	I64				 i, nt = m->tri_count;

	t = elems + offset(CSpriteMeshU8s.u) + m->vertex_count * sizeof(CD3I32);
	for (i = 0; i < nt; i++)
		t[i].color = col;
}

U0 YSLighting(CDC *dc, CD3I32 *p1, CD3I32 *p2, CD3I32 *p3, CColorROPU32 color)
{//dc->lighting hook, replacing the palette path in DCLighting.
//
//The stock shader dithers because a 16-colour pen has nowhere to put an
//in-between tone. With truecolor there is no such limit, so this is a real
//three-term shading model evaluated per face: a warm key light, a cool fill
//from the opposite side so nothing goes flat black, and a depth cue that dims
//faces as they recede. Result is a continuous range of tones rather than one
//tone per face orientation.
	CD3I32	v1, v2;
	I64		nx, ny, nz, key, fill, r, g, b, depth;
	F64		d;

	v1.x = p1->x - p2->x;
	v1.y = p1->y - p2->y;
	v1.z = p1->z - p2->z;
	v2.x = p3->x - p2->x;
	v2.y = p3->y - p2->y;
	v2.z = p3->z - p2->z;
	nx = v1.y * v2.z - v1.z * v2.y;
	ny = v1.z * v2.x - v1.x * v2.z;
	nz = v1.x * v2.y - v1.y * v2.x;
	d = Sqrt(SqrI64(nx) + SqrI64(ny) + SqrI64(nz));
	if (d)
		d = 1 << 16 / d;			//normal scaled to length 65536, as DCLighting
	nx *= d;
	ny *= d;
	nz *= d;

	//Key from upper left front, fill from lower right behind. Both 0..65536.
	key  = (nx * dc->ls.x + ny * dc->ls.y + nz * dc->ls.z) >> 16;
	fill = -key;
	if (key < 0)
		key = 0;
	if (fill < 0)
		fill = 0;

	//Depth cue, so near faces read brighter than far ones. Quantized to 8-unit
	//steps: a quad's two triangles have different centroids, and without the
	//step they land on different tones and the quad splits along its diagonal.
	depth = ((p1->z + p2->z + p3->z) / 3 - dc->z) / 8 * 8;
	depth = 256 - ClampI64(depth, -136, 136) * 56 / 136;

	r = color >> 16 & 0xFF;
	g = color >> 8 & 0xFF;
	b = color & 0xFF;
	//Ambient 62, key warms toward white, fill tints cool and never reaches 0.
	r = 62 * r / 255 + 150 * r * key / 255 / 65536 + fill * 30 / 65536;
	g = 62 * g / 255 + 150 * g * key / 255 / 65536 + fill * 34 / 65536;
	b = 62 * b / 255 + 150 * b * key / 255 / 65536 + fill * 52 / 65536;
	r = ClampI64(r * depth / 256, 0, 255);
	g = ClampI64(g * depth / 256, 0, 255);
	b = ClampI64(b * depth / 256, 0, 255);
	dc->color = ColorRGB(r, g, b);
}

U0 YSLogoFrame(F64 t)
{//Redraw the logo layer into the back buffer, then publish it. The overlay
//reads the front pointer only, so a half-drawn frame is never composited.
	CDC	*dc = yde_logo_back;
	I64	 y, w = YS_LW;

	if (!dc || !yde_splash_dc || !ys_sprite)
		return;
	//Start from the matching slice of the static background.
	if (yde_logo_x + w > yde_splash_dc->width)
		w = yde_splash_dc->width - yde_logo_x;
	for (y = 0; y < dc->height; y++)
	{
		if (yde_logo_y + y < yde_splash_dc->height)
			MemCopy(dc->body + y * dc->width_internal,
					yde_splash_dc->body + (yde_logo_y + y) *
						yde_splash_dc->width_internal + yde_logo_x,
					w * sizeof(U32));
	}

	DCDepthBufReset(dc);
	Mat4x4IdentEqu(dc->r);
	Mat4x4RotY(dc->r, 0.46 * Sin(t * 0.75));
	Mat4x4RotX(dc->r, 0.16 * Sin(t * 0.47) + 0.10);
	DCMat4x4Set(dc, dc->r);
	dc->x = dc->width / 2;
	dc->y = dc->height / 2;
	dc->z = 500;
	Sprite3(dc, 0, 0, 0, ys_sprite);

	yde_logo_back = yde_logo_dc;
	yde_logo_dc   = dc;			//published last
}

/* ---------------- static background ---------------- */

U0 YDESplashRender()
{//Gradient, text and the mesh, built once.
	I64	 x, y, top, bot, c, ty;
	U32	*dst;
	U8	*motto = MStrPrint("%Z", RandU8 % DefineCount("YDE_MOTTOS"), "YDE_MOTTOS");

	yde_hue = YSHueRead();
	top = YSHsv(yde_hue + 12, 215, 26);
	bot = YSHsv(yde_hue - 26, 185, 92);

	yde_splash_dc = DCNew(GR_WIDTH, GR_HEIGHT, sys_task);
	yde_logo_x = (GR_WIDTH  - YS_LW) / 2;
	yde_logo_y = (GR_HEIGHT - YS_LH) / 2 - 34;
	if (yde_logo_x < 0)
		yde_logo_x = 0;
	if (yde_logo_y < 0)
		yde_logo_y = 0;

	//Flat vertical gradient, top to bottom.
	for (y = 0; y < GR_HEIGHT; y++)
	{
		c   = YSMix(top, bot, y * 256 / GR_HEIGHT);
		dst = yde_splash_dc->body + y * yde_splash_dc->width_internal;
		for (x = 0; x < GR_WIDTH; x++)
			dst[x] = c;
	}
	yde_splash_dc->flags |= DCF_NO_TRANSPARENTS;

	//Text sits below the logo layer so the animator never has to repaint it.
	ty = yde_logo_y + YS_LH + 6;
	if (ty > GR_HEIGHT - 60)
		ty = GR_HEIGHT - 60;
	yde_splash_dc->color = ColorRGB(0xE8, 0xEC, 0xF4);
	GrPrint(yde_splash_dc, (GR_WIDTH - StrLen(sys_os_version_str) * FONT_WIDTH) / 2,
			ty, "%s", sys_os_version_str);
	c = YSHsv(yde_hue, 80, 200);
	yde_splash_dc->color = ColorRGB(c >> 16 & 0xFF, c >> 8 & 0xFF, c & 0xFF);
	GrPrint(yde_splash_dc, (GR_WIDTH - StrLen(motto) * FONT_WIDTH) / 2,
			ty + 18, "%s", motto);
	c = YSHsv(yde_hue, 100, 120);
	yde_splash_dc->color = ColorRGB(c >> 16 & 0xFF, c >> 8 & 0xFF, c & 0xFF);
	GrPrint(yde_splash_dc, (GR_WIDTH - 21 * FONT_WIDTH) / 2, GR_HEIGHT - 40,
			"Any key skips the wait");

	Free(motto);

	//Logo layers last: YSLogoFrame samples the finished background.
	yde_logo_dc   = DCNew(YS_LW, YS_LH, sys_task);
	yde_logo_back = DCNew(YS_LW, YS_LH, sys_task);
	yde_logo_dc->flags   |= DCF_NO_TRANSPARENTS;
	yde_logo_back->flags |= DCF_NO_TRANSPARENTS;
	DCDepthBufAlloc(yde_logo_dc);
	DCDepthBufAlloc(yde_logo_back);
	yde_logo_dc->flags   |= DCF_TRANSFORMATION;
	yde_logo_back->flags |= DCF_TRANSFORMATION;
	yde_logo_dc->lighting   = &YSLighting;
	yde_logo_back->lighting = &YSLighting;
	c = YSHsv(yde_hue, 175, 245);
	ys_sprite = YDEMeshSprite();
	YSMeshRecolor(ys_sprite, ColorRGB(c >> 16 & 0xFF, c >> 8 & 0xFF, c & 0xFF));
	YSLogoFrame(0.0);
}

U0 YDESplashOverlay(CDC *dc)
{//gr.fp_final_screen_update: blit the background and the logo layer over the
//finished frame with raw row copies (no z-buffer clipping, so it covers
//literally everything), then chain to whatever hook we replaced.
	I64	  y, w = GR_WIDTH, lw;
	CDC	 *logo = yde_logo_dc;

	if (yde_splash_up && yde_splash_dc)
	{
		if (w > dc->width)
			w = dc->width;
		for (y = 0; y < GR_HEIGHT && y < dc->height; y++)
			MemCopy(dc->body + y * dc->width_internal,
					yde_splash_dc->body + y * yde_splash_dc->width_internal,
					w * sizeof(U32));
		if (logo)
		{
			lw = logo->width;
			if (yde_logo_x + lw > w)
				lw = w - yde_logo_x;
			for (y = 0; y < logo->height && yde_logo_y + y < dc->height; y++)
				MemCopy(dc->body + (yde_logo_y + y) * dc->width_internal + yde_logo_x,
						logo->body + y * logo->width_internal,
						lw * sizeof(U32));
		}
	}
	if (yde_splash_old_hook)
		(*yde_splash_old_hook)(dc);
}

extern Bool yde_boot_done; //StartOS.ZC sets this once boot has finished.

U0 YDESplashDismissTask()
{//Animate the logo and keep the overlay up until boot has actually finished
//(yde_boot_done) so no tail-end compile output leaks past it - or until the
//user hits a key/click, with a hard safety cap. Then remove the overlay and
//restore the old hook.
	F64	t0	 = tS;
	I64	snap = kbd.last_down_scan_code;
	CDC *a, *b;

	while (yde_splash_up && tS - t0 < 30.0)
	{
		YSLogoFrame(tS - t0);
		if (tS - t0 >= 2.5 && yde_boot_done)
		{//Shown at least briefly AND boot finished: let the freshly-spawned
		//terminal paint a frame, then clear.
			Sleep(600);
			break;
		}
		if (tS - t0 >= 1.0 && (kbd.last_down_scan_code != snap || mouse.lb || mouse.rb))
			break; //user skip, after a moment so a boot keypress does not count
		Sleep(33);
	}

	yde_splash_up = FALSE;
	gr.fp_final_screen_update = yde_splash_old_hook;
	yde_splash_old_hook = NULL;
	Sleep(80); //let the in-flight frame finish reading the DCs
	a = yde_logo_dc;
	b = yde_logo_back;
	yde_logo_dc	  = NULL;
	yde_logo_back = NULL;
	if (a)
		DCDel(a);
	if (b)
		DCDel(b);
	if (yde_splash_dc)
	{
		DCDel(yde_splash_dc);
		yde_splash_dc = NULL;
	}
	ys_sprite = NULL;	//embedded doc data, not ours to free
}

U0 YDESplashStart()
{//Render once, install the overlay hook, spawn the animator, and return so
//boot carries on underneath.
	if (yde_splash_up)
		return;
	YDESplashRender;
	yde_splash_old_hook		 = gr.fp_final_screen_update;
	yde_splash_up			 = TRUE;
	gr.fp_final_screen_update = &YDESplashOverlay;
	Spawn(&YDESplashDismissTask, NULL, "YDE Splash");
}

YDESplashStart;
