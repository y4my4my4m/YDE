//YDE boot splash - dismissal only.
//
//Nothing here draws. The splash has been running since before the System
//compile: ::/StartOS.ZC animates it straight into the framebuffer, then hangs
//YDEWireOverlay on gr.fp_final_screen_update before the WinMgr's first frame,
//so it is one continuous animation from the kernel handing over to the desktop.
//This file only decides when it comes down, which is DE policy, not kernel
//policy - and it is a separate file because that decision needs kbd/mouse
//state the boot path has no business touching.

//The splash exits on input only. Set a positive number of seconds here to add
//a timeout for unattended boots; 0 waits forever.
#define YDE_SPLASH_SECS		0.0
#define YDE_SPLASH_SETTLE	2.0		//settle after boot, see YDESplashDismissTask

extern Bool yde_boot_done; //StartOS.ZC sets this once boot has finished.

U0 YDESplashDismissTask()
{//Wait for the user. Nothing else takes the splash down.
	F64	 t0	  = yde_wire_t0, settled = 0.0;	//one clock since the kernel handed over
	I64	 snap = kbd.count, hits = 0;
	Bool lb0  = mouse.lb, rb0 = mouse.rb, go = FALSE;

	while (yde_wire_up && !go)
	{
		if (!yde_boot_done || settled <= 0.0 || tS - settled < YDE_SPLASH_SETTLE)
		{//Re-baseline until boot is done and has settled. Input seen before
		//that is not the user: keys typed at the boot loader only reach the
		//kernel driver once it initialises, and the mouse reports garbage
		//buttons until its own init. Both land well after this task starts, so
		//a single sample at entry sees a phantom press and clears instantly.
			if (yde_boot_done && settled <= 0.0)
				settled = tS;
			snap = kbd.count;
			lb0  = mouse.lb;
			rb0  = mouse.rb;
			hits = 0;
		}
		else
		{//Past the settle: boot is finished and the desktop behind the splash is
		//built, so the key is offered from here and input counts.
		//lb0/rb0 mean "was already down at the baseline". Cleared on release,
		//never set on press, so a real click reads as down for every poll it
		//lasts - comparing against the PREVIOUS poll instead would yield a
		//single edge and never reach the two-poll threshold below.
			yde_wire_ready = TRUE;
			if (!mouse.lb)
				lb0 = FALSE;
			if (!mouse.rb)
				rb0 = FALSE;
			//Two consecutive polls: a one-frame glitch is not a press.
			if (kbd.count != snap || (mouse.lb && !lb0) || (mouse.rb && !rb0))
				hits++;
			else
				hits = 0;
			if (hits >= 2)
				go = TRUE;
		}
		if (YDE_SPLASH_SECS > 0.0 && tS - t0 >= YDE_SPLASH_SECS)
			go = TRUE;
		Sleep(33);
	}

	YDEWireRelease;
}

U0 YDESplashStart()
{//The overlay is already up; just watch for the dismissal.
	Spawn(&YDESplashDismissTask, NULL, "YDE Splash");
}

YDESplashStart;
