//YDE core: shared globals, theme-independent helpers, window policy.
//
//The desktop is split across these files, in MakeDE include order:
//  DEDef     this file - CDEGlobals, hooks, colour helper
//  DEImage   decoders, file chooser, wallpaper
//  DEConfig  ::/Home/Config/YDE.CFG load and save
//  DEBar     taskbar: task buttons, volume, net, clock
//  DEDesk    desktop ctrl: LMB-hold stats, right-click menu
//  DE        DEStart / DEStop / DETaskMain
//  BootTerm  the boot terminal's open animation
//
//Wallpaper: a draw_it on sys_winmgr_task, z-clipped to uncovered cells.
//Taskbar: a CCtrl on sys_winmgr_task. The WinMgr dispatches ctrl clicks before
//window focus handling, so bar clicks never reach a window.
//Start menu: DE.ZC knows it only through de_menu_fp, set by StartMenu.ZC.

#define DE_SAVER_MINS_DEFAULT	15	//Screen saver idle timeout, minutes.
#define DE_GLASS_ALPHA_DEFAULT	230	//Glass opacity, 0..255.
#define DE_GLASS_BLUR_DEFAULT	8	//Frost radius in pixels.
#define DE_VOL_DEFAULT			90	//Master volume, 0..100.

//Bar height is a pixel target rounded up to whole cells; a fixed row count
//doubles the bar at 8x16.
#define DE_BAR_PIX			24
#define DE_BAR_ROWS			((DE_BAR_PIX + FONT_HEIGHT - 1) / FONT_HEIGHT)
#define DE_BAR_HEIGHT		(DE_BAR_ROWS * FONT_HEIGHT)
#define DE_BAR_TASKS_MAX	32
#define DE_BTTN_WIDTH		136
#define DE_CHIP_WIDTH		56

class CDEGlobals
{
	CDC		*wallpaper;
	CCtrl	*bar, *term_bttn;
	CTask	*task, *menu_task;
	U0		(*old_wall_paper)(CTask *task);
	CTask	*bar_tasks[DE_BAR_TASKS_MAX];
	I64		 bar_x0[DE_BAR_TASKS_MAX], bar_x1[DE_BAR_TASKS_MAX], bar_count;
	I64		 chip_x0, chip_x1;
	I64		 saved_vol;					//Volume before mute, for the toggle.
	Bool	 muted;						//Master mute state (widget + media key).
	I64		*media_vol, *media_mute;	//Kernel counters, or NULL on old kernels.
	I64		 vol_icon_x0, vol_icon_x1;	//Taskbar volume widget hit zones.
	I64		 vol_bar_x0, vol_bar_x1;
	I64		 clock_x0, clock_x1;		//Clock hit zone (click -> calendar).
	I64		 net_x0, net_x1;			//Network tray icon hit zone.
	F64		 cal_last;					//Debounce for clock -> calendar spawns.
	CTask	*cal_task;					//Open calendar; the clock toggles it.
	CTask	*ctx_task, *ctx_target;		//Right-click menu task + the task it acts on.
	CTask	*net_task;					//One-shot task that brings the net stack up.
	CCtrl	*desk;						//Desktop ctrl: LMB-hold stats, right-click menu.
	Bool	 stats_hold;				//LMB held on the desktop: stock stats instead of the image.
	Bool	 stats_enable;				//Whether the hold is enabled.
	CTask	*desk_menu_task;			//Desktop right-click menu task.
	F64		 desk_menu_last;			//Debounce for that menu.
	CTask	*min_tasks[DE_BAR_TASKS_MAX];//Windows minimized from the taskbar.
	I64		 min_count;
	U8		 wallpaper_path[256];		//Current wallpaper, remembered for config.
	Bool	 on, net_up, glass, cfg_dirty;
	I64		 glass_alpha;				//Glass opacity, 0..255. 255 = opaque.
	I64		 glass_blur;				//Frosted-glass radius in pixels, 0 = off.
	I64		 font_h;					//Cell height wanted at next boot, 8 or 16.
	CTask	*glass_deny;				//Focused task that draws doc graphics.
	Bool	 saver_on;					//Screen saver (the YDE demo) enabled.
	I64		 saver_mins;				//Idle minutes before it kicks in.
	Bool	 menu_close;				//Ask the start menu to close itself.
	F64		 menu_last;					//When it last closed, to debounce the chip.
} de;

//JIT globals are not zeroed. de.on gates DEStart.
MemSet(&de, 0, sizeof(CDEGlobals));

//StartMenu.ZC installs the drawn launcher panel here; DE.ZC needs no
//compile-time knowledge of it. NULL until that file compiles.
U0 (*de_menu_fp)(U8 *data) = NULL;
