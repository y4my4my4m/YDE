//WebM player. Decodes with the System media layer and owns only the window.

#define YV_CTRL_H		46
#define YV_BTN_W		24
#define YV_BTN_H		18
#define YV_PAD			10
#define YV_SEEK_STEP	5.0
#define YV_MIN_COLS		34

class CYVid
{
	CMediaCtx	*m;
	I64			 vtrack;
	CDC			*frame;			//published by the decode loop, read by draw_it
	CDC			*scaled;
	CCtrl		*cvid, *cbar;
	I64			 vw, vh;
	F64			 dur, cur, pts;
	Bool		 playing, quit, full, eof, dragging;
	//Ctrl callbacks run in the WinMgr's task: they record intent only, and the
	//decode loop acts on it in this task.
	Bool		 req_toggle, req_stop, req_full, req_seek;
	F64			 seek_to;
	U32			*pcm;
	I64			 pcm_count, pcm_rate, voice;
	F64			 clock0;
	I64			 cols, rows, win_l, win_t;
	I64			 vid_x, vid_y, vid_w, vid_h;
	U8			 name[STR_LEN];
} yv;

F64 YVNow()
{
	if (yv.playing)
		return tS - yv.clock0;

	return yv.cur;
}

U0 YVFrameSet(CDC *dc)
{
	CDC *old = yv.frame;

	yv.frame = dc;
	if (old)
	{
		Sleep(20);			//let an in-flight draw_it finish reading it
		DCDel(old);
	}
}

U0 YVAudioStop()
{
	if (yv.voice >= 0)
		AudioSFXStop(yv.voice);
	yv.voice = -1;
}

U0 YVAudioStart(F64 t)
{
	I64 off;

	YVAudioStop;
	if (!yv.pcm)
		return;
	off = ToI64(t * yv.pcm_rate);
	if (off < 0)
		off = 0;
	if (off >= yv.pcm_count)
		return;
	yv.voice = AudioSFXPlayRef(yv.pcm + off, yv.pcm_count - off, yv.pcm_rate);
}

Bool YVDecodeNext()
{//Next frame into yv.frame. FALSE at end of stream.
	CDC	*dc;
	F64	 t;

	dc = MediaVideoNext(yv.m, yv.m->track[yv.vtrack].num, &t);
	if (!dc)
	{
		yv.eof = TRUE;
		return FALSE;
	}
	yv.pts = t;
	YVFrameSet(dc);

	return TRUE;
}

U0 YVSeek(F64 t)
{//Matroska has no cue index here, so a backward seek rewinds and decodes
//forward from the first keyframe.
	CDC	*dc;
	F64	 pts;

	if (t < 0.0)
		t = 0.0;
	if (yv.dur > 0.0 && t > yv.dur)
		t = yv.dur;

	if (t < yv.pts)
	{
		MediaRewind(yv.m);
		yv.eof = FALSE;
	}
	while (!yv.eof)
	{
		dc = MediaVideoNext(yv.m, yv.m->track[yv.vtrack].num, &pts);
		if (!dc)
		{
			yv.eof = TRUE;
			break;
		}
		yv.pts = pts;
		if (pts >= t)
		{
			YVFrameSet(dc);
			break;
		}
		DCDel(dc);
	}

	yv.cur    = t;
	yv.clock0 = tS - t;
	if (yv.playing)
		YVAudioStart(t);
	else
		YVAudioStop;
}

U0 YVTogglePlay()
{
	yv.playing = !yv.playing;
	if (yv.playing)
	{
		if (yv.eof)
			YVSeek(0.0);
		yv.clock0 = tS - yv.cur;
		YVAudioStart(yv.cur);
	}
	else
	{
		yv.cur = tS - yv.clock0;
		YVAudioStop;
	}
}

U0 YVSetFull(Bool on)
{
	yv.full = on;
	if (on)
	{
		LBts(&Fs->display_flags, DISPLAYf_NO_BORDER);
		WinHorz(0, TEXT_COLS - 1);
		WinVert(0, TEXT_ROWS - 1);
	}
	else
	{
		LBtr(&Fs->display_flags, DISPLAYf_NO_BORDER);
		WinHorz(yv.win_l, yv.win_l + yv.cols - 1);
		WinVert(yv.win_t, yv.win_t + yv.rows - 1);
	}
	WinFocus;
	WinToTop;
	WinZBufUpdate;
}

U0 YVLayout(I64 w, I64 h)
{//Video rect centred above the transport strip; both become ctrl rects, which
//is what keeps the compositor's glass out of them.
	I64 aw = w, ah = h - YV_CTRL_H, sw, sh;

	if (ah < 16)
		ah = 16;
	sw = yv.vw;
	sh = yv.vh;
	if (sw > aw || sh > ah)
	{//Fit, keeping the aspect ratio.
		sw = aw;
		sh = yv.vh * aw / yv.vw;
		if (sh > ah)
		{
			sh = ah;
			sw = yv.vw * ah / yv.vh;
		}
	}
	yv.vid_w = sw;
	yv.vid_h = sh;
	yv.vid_x = (aw - sw) / 2;
	yv.vid_y = (ah - sh) / 2;

	if (yv.cvid)
	{
		yv.cvid->left   = yv.vid_x;
		yv.cvid->top    = yv.vid_y;
		yv.cvid->right  = yv.vid_x + sw - 1;
		yv.cvid->bottom = yv.vid_y + sh - 1;
	}
	if (yv.cbar)
	{
		yv.cbar->left   = 0;
		yv.cbar->top    = h - YV_CTRL_H;
		yv.cbar->right  = w - 1;
		yv.cbar->bottom = h - 1;
	}
	TaskDerivedValsUpdate;
}

CDC *YVScaleFrame(CDC *src)
{//Nearest neighbour into a cached DC. Returns src when no scaling is needed.
	I64	 x, y, sx;
	U32	*srow, *drow;

	if (yv.vid_w < 1 || yv.vid_h < 1 ||
		(yv.vid_w == src->width && yv.vid_h == src->height))
		return src;
	if (!yv.scaled || yv.scaled->width != yv.vid_w ||
		yv.scaled->height != yv.vid_h)
	{
		if (yv.scaled)
			DCDel(yv.scaled);
		yv.scaled = DCNew(yv.vid_w, yv.vid_h);
		if (!yv.scaled)
			return src;
	}
	for (y = 0; y < yv.vid_h; y++)
	{
		srow = src->body + (y * src->height / yv.vid_h) * src->width_internal;
		drow = yv.scaled->body + y * yv.scaled->width_internal;
		for (x = 0; x < yv.vid_w; x++)
		{
			sx = x * src->width / yv.vid_w;
			drow[x] = srow[sx];
		}
	}

	return yv.scaled;
}

U0 YVTimeStr(U8 *buf, F64 t)
{
	I64 s = ToI64(t);

	if (s < 0)
		s = 0;
	StrPrint(buf, "%02d:%02d", s / 60, s % 60);
}

U0 YVTriangle(CDC *dc, I64 x, I64 y, I64 sz, Bool left)
{
	I64 i;

	for (i = 0; i < sz; i++)
		if (left)
			GrLine(dc, x + sz - i, y + i, x + sz - i, y + 2 * sz - i - 1);
		else
			GrLine(dc, x + i, y + i, x + i, y + 2 * sz - i - 1);
}

U0 YVDrawBtn(CDC *dc, I64 x, I64 y, I64 kind)
{//0 play, 1 pause, 2 back, 3 forward, 4 fullscreen, 5 stop.
	I64 cx = x + YV_BTN_W / 2, cy = y + YV_BTN_H / 2;

	dc->color = de_theme.bttn;
	GrRect(dc, x, y, YV_BTN_W, YV_BTN_H);
	dc->color = de_theme.text;
	switch (kind)
	{
		case 0:
			YVTriangle(dc, cx - 4, cy - 5, 5, FALSE);
			break;
		case 1:
			GrRect(dc, cx - 4, cy - 5, 3, 10);
			GrRect(dc, cx + 1, cy - 5, 3, 10);
			break;
		case 2:
			YVTriangle(dc, cx - 6, cy - 5, 5, TRUE);
			GrRect(dc, cx + 3, cy - 5, 2, 10);
			break;
		case 3:
			YVTriangle(dc, cx - 1, cy - 5, 5, FALSE);
			GrRect(dc, cx - 5, cy - 5, 2, 10);
			break;
		case 4:
			GrRect(dc, cx - 7, cy - 5, 14, 2);
			GrRect(dc, cx - 7, cy + 3, 14, 2);
			GrRect(dc, cx - 7, cy - 5, 2, 10);
			GrRect(dc, cx + 5, cy - 5, 2, 10);
			break;
		case 5:
			GrRect(dc, cx - 4, cy - 4, 9, 9);
			break;
	}
}

U0 YVVidDraw(CDC *dc, CCtrl *c)
{//The frame only. Cells outside this rect stay empty, so the DE's compositor
//glasses them.
	CDC *f = yv.frame;			//one read: the swap is a single store

	if (f)
		GrBlot(dc, c->left, c->top, YVScaleFrame(f));
}

U0 YVBarDraw(CDC *dc, CCtrl *c)
{
	U8	*base;
	F64	 t = YVNow();
	I64	 x0 = c->left, y0 = c->top, w = c->right - c->left + 1;
	I64	 kx, fill, tx, room, bar_y = y0 + 8, btn_y = y0 + 22;
	U8	 buf[32], buf2[32];

	dc->color = de_theme.panel;
	GrRect(dc, x0, y0, w, YV_CTRL_H);

	fill = 0;
	if (yv.dur > 0.0)
		fill = ToI64((w - 2 * YV_PAD) * t / yv.dur);
	if (fill > w - 2 * YV_PAD)
		fill = w - 2 * YV_PAD;
	dc->color = de_theme.panel_edge;
	GrRect(dc, x0 + YV_PAD, bar_y, w - 2 * YV_PAD, 5);
	dc->color = de_theme.accent;
	GrRect(dc, x0 + YV_PAD, bar_y, fill, 5);
	kx = x0 + YV_PAD + fill;
	dc->color = de_theme.text;
	GrRect(dc, kx - 2, bar_y - 3, 5, 11);

	if (yv.playing)
		YVDrawBtn(dc, x0 + YV_PAD, btn_y, 1);
	else
		YVDrawBtn(dc, x0 + YV_PAD, btn_y, 0);
	YVDrawBtn(dc, x0 + YV_PAD + 1 * (YV_BTN_W + 6), btn_y, 5);
	YVDrawBtn(dc, x0 + YV_PAD + 2 * (YV_BTN_W + 6), btn_y, 2);
	YVDrawBtn(dc, x0 + YV_PAD + 3 * (YV_BTN_W + 6), btn_y, 3);
	YVDrawBtn(dc, x0 + w - YV_PAD - YV_BTN_W, btn_y, 4);

	tx = x0 + YV_PAD + 4 * (YV_BTN_W + 6) + 2;
	room = x0 + w - YV_PAD - YV_BTN_W - 8 - tx;
	YVTimeStr(buf, t);
	YVTimeStr(buf2, yv.dur);
	if (room >= 11 * FONT_WIDTH)
	{
		dc->color = de_theme.text;
		GrPrint(dc, tx, btn_y + 5, "%s / %s", buf, buf2);
		tx   += 12 * FONT_WIDTH;
		room -= 12 * FONT_WIDTH;
	}
	else if (room >= 5 * FONT_WIDTH)
	{
		dc->color = de_theme.text;
		GrPrint(dc, tx, btn_y + 5, "%s", buf);
		tx   += 6 * FONT_WIDTH;
		room -= 6 * FONT_WIDTH;
	}
	if (room >= 8 * FONT_WIDTH)
	{
		base = StrLastOcc(yv.name, "/");
		if (base)
			base++;
		else
			base = yv.name;
		dc->color = de_theme.text_dim;
		GrPrint(dc, tx, btn_y + 5, "%s", base);
	}
}

Bool YVBtnHit(I64 x, I64 y, I64 bx, I64 by)
{
	return ToBool(bx <= x < bx + YV_BTN_W && by <= y < by + YV_BTN_H);
}

U0 YVBarClick(CCtrl *c, I64 x, I64 y, Bool down)
{//Window pixel coordinates, the same space as c->left/c->top. Runs in the
//WinMgr's ctrl pass, so nothing here decodes or resizes a window.
	I64	 x0 = c->left, w = c->right - c->left + 1;
	I64	 bar_x = x0 + YV_PAD, bar_w = w - 2 * YV_PAD;
	I64	 bar_y = c->top + 8, btn_y = c->top + 22, i;

	if (yv.dragging)
	{
		if (!down && bar_w > 0)
		{
			yv.dragging = FALSE;
			yv.seek_to  = ToF64(x - bar_x) * yv.dur / bar_w;
			yv.req_seek = TRUE;
		}
		return;
	}
	if (!down)
		return;

	if (yv.dur > 0.0 && bar_y - 6 <= y < bar_y + 11)
	{
		yv.dragging = TRUE;
		return;
	}
	if (!(btn_y <= y < btn_y + YV_BTN_H))
		return;
	if (YVBtnHit(x, y, x0 + w - YV_PAD - YV_BTN_W, btn_y))
	{
		yv.req_full = TRUE;
		return;
	}
	i = (x - x0 - YV_PAD) / (YV_BTN_W + 6);
	if (!YVBtnHit(x, y, x0 + YV_PAD + i * (YV_BTN_W + 6), btn_y))
		return;
	switch (i)
	{
		case 0:
			yv.req_toggle = TRUE;
			break;
		case 1:
			yv.req_stop = TRUE;
			break;
		case 2:
			yv.seek_to  = YVNow() - YV_SEEK_STEP;
			yv.req_seek = TRUE;
			break;
		case 3:
			yv.seek_to  = YVNow() + YV_SEEK_STEP;
			yv.req_seek = TRUE;
			break;
	}
}

U0 YVKey(I64 ch, I64 sc)
{
	switch (ch)
	{
		case CH_ESC:
			if (yv.full)
				YVSetFull(FALSE);
			else
				yv.quit = TRUE;
			return;
		case CH_SPACE:
			YVTogglePlay;
			return;
		case 'f':
		case 'F':
			YVSetFull(!yv.full);
			return;
	}
	switch (sc.u8[0])
	{
		case SC_CURSOR_LEFT:
			YVSeek(YVNow() - YV_SEEK_STEP);
			break;
		case SC_CURSOR_RIGHT:
			YVSeek(YVNow() + YV_SEEK_STEP);
			break;
		case SC_HOME:
			YVSeek(0.0);
			break;
	}
}

public U0 DEPlayVideo(U8 *filename=NULL)
{
	U8		*pick = NULL;
	I64		 ti, msg, a1, a2, max_rows;
	F64		 now;

	if (!filename)
	{
		pick = DEPickFile("::/Home/Videos/", "Open Video");
		if (!pick)
			return;
		filename = pick;
	}

	MemSet(&yv, 0, sizeof(CYVid));
	yv.voice = -1;
	yv.m = MediaOpen(filename);
	if (!yv.m)
	{
		PopUpOk("Not a Matroska/WebM stream.");
		if (pick)
			Free(pick);
		return;
	}

	ti = MediaTrackFind(yv.m, MEDIA_TRACK_VIDEO);
	if (ti < 0 || (yv.m->track[ti].codec != MEDIA_CODEC_VP8 &&
				   yv.m->track[ti].codec != MEDIA_CODEC_VP9 &&
				   yv.m->track[ti].codec != MEDIA_CODEC_MJPEG))
	{
		PopUpOk("No playable video track.\n\nVP8, VP9 and MJPEG decode; "
				"H.264 and AV1 do not yet.");
		MediaClose(yv.m);
		if (pick)
			Free(pick);
		return;
	}
	yv.vtrack = ti;
	yv.dur    = yv.m->duration;
	yv.vw     = yv.m->track[ti].width;
	yv.vh     = yv.m->track[ti].height;
	StrCopy(yv.name, filename);

	if (!YVDecodeNext)
	{
		PopUpOk("No decodable frame in this file.");
		MediaClose(yv.m);
		if (pick)
			Free(pick);
		return;
	}
	if (yv.vw < 16 || yv.vh < 16)
	{
		yv.vw = yv.frame->width;
		yv.vh = yv.frame->height;
	}

	max_rows = TEXT_ROWS - DE_BAR_ROWS;
	yv.cols = (yv.vw + FONT_WIDTH - 1) / FONT_WIDTH;
	yv.rows = (yv.vh + YV_CTRL_H + FONT_HEIGHT - 1) / FONT_HEIGHT;
	if (yv.cols < YV_MIN_COLS)
		yv.cols = YV_MIN_COLS;		//the transport row sets the floor
	if (yv.cols > TEXT_COLS)
		yv.cols = TEXT_COLS;
	if (yv.rows > max_rows)
		yv.rows = max_rows;

	yv.win_l = MaxI64(1, (TEXT_COLS - yv.cols) / 2);
	yv.win_t = MaxI64(1, (max_rows - yv.rows) / 2);
	YVLayout(yv.cols * FONT_WIDTH, yv.rows * FONT_HEIGHT);

	if (!DocPut)
		DocTermNew;		//a raw Spawn()ed task has no display doc yet
	StrCopy(Fs->task_title, "yVideo");
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT | WIF_FOCUS_TASK_MENU |
					  WIF_FOCUS_TASK_MS_L_D;
	WinHorz(yv.win_l, yv.win_l + yv.cols - 1);
	WinVert(yv.win_t, yv.win_t + yv.rows - 1);
	DocCursor(OFF);
	DocClear;

	yv.cvid = CAlloc(sizeof(CCtrl));
	yv.cvid->win_task = Fs;
	yv.cvid->flags    = CTRLF_SHOW;
	yv.cvid->type     = CTRLT_GENERIC;
	yv.cvid->draw_it  = &YVVidDraw;
	QueueInsert(yv.cvid, Fs->last_ctrl);

	yv.cbar = CAlloc(sizeof(CCtrl));
	yv.cbar->win_task   = Fs;
	yv.cbar->flags      = CTRLF_SHOW | CTRLF_CAPTURE_LEFT_MS;
	yv.cbar->type       = CTRLT_GENERIC;
	yv.cbar->draw_it    = &YVBarDraw;
	yv.cbar->left_click = &YVBarClick;
	QueueInsert(yv.cbar, Fs->last_ctrl);
	YVLayout(yv.cols * FONT_WIDTH, yv.rows * FONT_HEIGHT);

	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinFocus;
	WinToTop;
	WinZBufUpdate;

	yv.pcm = MediaDecodeAudio(filename, &yv.pcm_count, &yv.pcm_rate);
	yv.playing = TRUE;
	yv.clock0  = tS;
	YVAudioStart(0.0);

	while (!yv.quit)
	{
		YVLayout(Fs->pix_width, Fs->pix_height);

		while (msg = MessageScan(&a1, &a2))
			if (msg == MESSAGE_KEY_DOWN)
				YVKey(a1, a2);

		if (yv.req_toggle)
		{
			yv.req_toggle = FALSE;
			YVTogglePlay;
		}
		if (yv.req_stop)
		{
			yv.req_stop = FALSE;
			yv.playing  = FALSE;
			YVSeek(0.0);
		}
		if (yv.req_full)
		{
			yv.req_full = FALSE;
			YVSetFull(!yv.full);
		}
		if (yv.req_seek)
		{
			yv.req_seek = FALSE;
			YVSeek(yv.seek_to);
		}

		if (yv.playing && !yv.dragging)
		{
			now = tS - yv.clock0;
			yv.cur = now;
			while (!yv.eof && yv.pts <= now)
				if (!YVDecodeNext)
					break;
			if (yv.eof && (yv.dur <= 0.0 || now >= yv.dur))
			{
				yv.playing = FALSE;
				yv.cur = yv.dur;
				YVAudioStop;
			}
		}
		Sleep(4);
	}

	YVAudioStop;
	QueueRemove(yv.cvid);
	QueueRemove(yv.cbar);
	Free(yv.cvid);
	Free(yv.cbar);
	yv.cvid = NULL;
	yv.cbar = NULL;
	LBtr(&Fs->display_flags, DISPLAYf_NO_BORDER);
	LBtr(&Fs->display_flags, DISPLAYf_SHOW);
	LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);
	Sleep(40);
	YVFrameSet(NULL);
	if (yv.scaled)
		DCDel(yv.scaled);
	DocCursor(ON);
	DocClear;

	Free(yv.pcm);
	MediaClose(yv.m);
	if (pick)
		Free(pick);
}
