//WebM player. Decodes with the System media layer and owns only the window.
//
//Video is keyframe-only until VP8 inter prediction lands, so a file with a
//normal GOP shows one frame per keyframe interval. Audio plays in full.

#define YVID_HEAD	24

CDC		*yv_frame	 = NULL;	//swapped by the decode loop, read by draw_it
U8		 yv_name[STR_LEN];
F64		 yv_time	 = 0.0;
F64		 yv_dur		 = 0.0;
I64		 yv_shown	 = 0;

U0 YVDrawIt(CTask *task, CDC *dc)
{
	CDC	*f;
	I64	 x, y;

	dc->color = de_theme.win_bg;
	GrRect(dc, 0, 0, task->pix_width, task->pix_height);

	f = yv_frame;			//one read: the swap below is a single store
	if (f)
	{
		x = (task->pix_width - f->width) / 2;
		y = YVID_HEAD + (task->pix_height - YVID_HEAD - f->height) / 2;
		GrBlot(dc, x, y, f);
	}

	dc->color = de_theme.text;
	GrPrint(dc, 4, 4, "%s   %.1f / %.1fs   %d frame(s)   Esc closes",
			yv_name, yv_time, yv_dur, yv_shown);
}

U0 YVFrameSet(CDC *dc)
{//Publish a frame and retire the previous one.
	CDC *old = yv_frame;

	yv_frame = dc;
	if (old)
	{
		Sleep(20);		//let an in-flight draw_it finish reading it
		DCDel(old);
	}
}

public U0 DEPlayVideo(U8 *filename=NULL)
{
	CMediaCtx	*m;
	CDC			*dc;
	U8			*pick = NULL;
	F64			 t0, t;
	I64			 ti, audio, msg, a1, a2;
	Bool		 done = FALSE;

	if (!filename)
	{
		pick = PopUpPickFile("::/Home/Videos/");
		if (!pick)
			return;
		filename = pick;
	}

	m = MediaOpen(filename);
	if (!m)
	{
		PopUpOk("Not a Matroska/WebM stream.");
		if (pick)
			Free(pick);
		return;
	}

	ti = MediaTrackFind(m, MEDIA_TRACK_VIDEO);
	if (ti < 0 || (m->track[ti].codec != MEDIA_CODEC_VP8 &&
				   m->track[ti].codec != MEDIA_CODEC_MJPEG))
	{
		PopUpOk("No VP8 or MJPEG video track.\n\nVP9 is a different codec.");
		MediaClose(m);
		if (pick)
			Free(pick);
		return;
	}

	yv_frame = NULL;
	yv_time  = 0.0;
	yv_shown = 0;
	yv_dur   = m->duration;
	StrCopy(yv_name, filename);

	DocTermNew;
	StrCopy(Fs->task_title, "yVideo");
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT | WIF_FOCUS_TASK_MENU;
	LBts(&Fs->display_flags, DISPLAYf_NO_BORDER);
	WinHorz(0, TEXT_COLS - 1);
	WinVert(0, TEXT_ROWS - DE_BAR_ROWS - 1);
	DocCursor(OFF);
	DocClear;
	Fs->draw_it = &YVDrawIt;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinFocus;
	WinToTop;
	WinZBufUpdate;

	audio = MediaPlayAudio(filename);
	t0    = tS;

	while (!done)
	{
		dc = MediaVideoNext(m, m->track[ti].num, &t);
		if (!dc)
			break;

		//Presentation time is absolute from the start of the stream.
		while (tS - t0 < t && !done)
		{
			while (msg = MessageScan(&a1, &a2))
				if (msg == MESSAGE_KEY_DOWN && a1 == CH_ESC)
					done = TRUE;
			Sleep(2);
		}

		YVFrameSet(dc);
		yv_time = t;
		yv_shown++;
	}

	while (!done && tS - t0 < yv_dur)
	{
		while (msg = MessageScan(&a1, &a2))
			if (msg == MESSAGE_KEY_DOWN && a1 == CH_ESC)
				done = TRUE;
		Sleep(10);
	}

	if (audio >= 0)
		AudioSFXStop(audio);

	Fs->draw_it = NULL;
	LBtr(&Fs->display_flags, DISPLAYf_SHOW);
	LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);
	Sleep(40);
	YVFrameSet(NULL);
	DocCursor(ON);
	DocClear;

	MediaClose(m);
	if (pick)
		Free(pick);
}
