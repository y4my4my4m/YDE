//Boot terminal: one centred window that grows to full height once the splash
//clears. StartOS.ZC declares boot_term_fp before either the DE or /Home
//compiles; installing the hook here keeps HomeSys.ZC working with no desktop.

#define BOOT_TERM_COLS	96
#define BOOT_TERM_ROWS	52
#define BOOT_TERM_SEED	2		//rows it opens at
#define BOOT_TERM_STEPS	14

extern Bool yde_boot_done;		//StartOS.ZC sets this once boot has finished.
extern U0 (*boot_term_fp)(CTask *task);

CTask *boot_term_task = NULL;

I64 DEBootTermLeft()
{
	I64 l = (TEXT_COLS - BOOT_TERM_COLS) / 2;

	if (l < 1)
		l = 1;

	return l;
}

I64 DEBootTermTop()
{//Top row of the finished window. The animation grows out from its middle.
	I64 t = (TEXT_ROWS - BOOT_TERM_ROWS) / 2;

	if (t < 1)
		t = 1;

	return t;
}

U0 DEBootTermOpenTask()
{//Own task: StartUpTasks is on the boot path and must not sleep for a second.
	CTask	*t = boot_term_task;
	I64		 i, top, bot, mid;
	F64		 t0 = tS;

	top = DEBootTermTop();
	bot = top + BOOT_TERM_ROWS - 1;
	mid = top + BOOT_TERM_ROWS / 2;

	while (!yde_boot_done && tS - t0 < 60.0)
		Sleep(50);
	Sleep(900);	//the splash clears about 700ms after yde_boot_done

	if (!TaskValidate(t))
		return;
	for (i = 1; i <= BOOT_TERM_STEPS; i++)
	{
		WinVert(mid - (mid - top) * i / BOOT_TERM_STEPS,
				mid + (bot - mid) * i / BOOT_TERM_STEPS, t);
		Sleep(18);
	}
	WinVert(top, bot, t);
	WinToTop(t);
	WinFocus(t);
	WinZBufUpdate;
}

U0 DEBootTerm(CTask *user)
{//Called from HomeSys.ZC through boot_term_fp with the terminal it spawned.
	I64 l = DEBootTermLeft(), mid = DEBootTermTop() + BOOT_TERM_ROWS / 2;

	boot_term_task = user;
	WinHorz(l, l + BOOT_TERM_COLS - 1, user);
	WinVert(mid - BOOT_TERM_SEED / 2, mid + BOOT_TERM_SEED / 2, user);
	WinToTop(user);
	Spawn(&DEBootTermOpenTask, NULL, "Term Open");
}

U0 DEBootTermInstall()
{//File-scope assignments do not run in ZealC; a bare call statement does.
	boot_term_fp = &DEBootTerm;
}

DEBootTermInstall;
