//yViewer - YDE image viewer. Every format DEImageRead decodes: PNG, JPG, GIF, WEBP, TGA.
//
//Single view scales to fit; gallery is a scrolling thumbnail grid. The grid is
//sized from the window, so it reflows on resize and on <CTRL-F>. Thumbnails
//exist only for the rows on screen and are dropped as they scroll off - a whole
//directory of them runs to tens of megabytes.
//
//Run with DEViewImage; or DEViewImage("::/path/File.PNG");

#define DEV_MAX			512		//files catalogued per directory
#define DEV_NAME_LEN	64
#define DEV_HEAD		20		//header strip, pixels
#define DEV_WIN_COLS	104		//default window, cells
#define DEV_WIN_ROWS	40
#define DEV_CELL_W		168		//default cell size; +/- adjusts, the grid divides the window
#define DEV_CELL_H		148
#define DEV_CELL_MIN	72
#define DEV_CELL_MAX	340
#define DEV_BAR_W		10		//scrollbar width, pixels
#define DEV_MAX_COLS	8
#define DEV_MAX_ROWS	6
#define DEV_VIS			(DEV_MAX_COLS * DEV_MAX_ROWS)
#define DEV_LABEL		14		//label strip inside a cell, pixels

class CDEViewer
{
	U8	  dir[192];
	U8	  name[DEV_MAX * DEV_NAME_LEN];
	I64	  n, cur;
	CDC	 *img;					//decode of the current file, unscaled
	CDC	 *fit;					//img scaled to the window, NULL at 1:1
	CDC	 *show;					//Pointer DEViewDrawIt reads; swapped, never cleared
	CDC	 *thumb[DEV_VIS];		//thumbnails for the rows on screen
	I64	  thumb_id[DEV_VIS];	//file index each thumb holds, -1 = empty
	I64	  cols, rows;			//grid, derived from the window
	I64	  cell_w, cell_h;		//thumbnail cell size; +/- adjusts it
	I64	  top_row;				//first row drawn; scroll position
	Bool  gallery, one_to_one, full;
	I64	  sv_left, sv_right, sv_top, sv_bottom;	//geometry before fullscreen
	I64	  last_w, last_h;		//window size the layout was built for
	I64	  last_z;				//mouse wheel
	Bool  dragging;				//scrollbar held
	U8	  status[128];
} de_view;

U8 *DEViewName(I64 i)
{//Row of the flat name table.
	return &de_view.name[i * DEV_NAME_LEN];
}

U8 *DEViewPath(I64 i)
{//Caller frees.
	return MStrPrint("%s/%s", de_view.dir, DEViewName(i));
}

Bool DEViewIsImage(U8 *name)
{
	U8 *ext = name + StrLen(name);

	while (ext > name && ext[-1] != '.')
		ext--;

	return !StrICompare(ext, "PNG") || !StrICompare(ext, "JPG") ||
		   !StrICompare(ext, "JPEG") || !StrICompare(ext, "GIF") ||
		   !StrICompare(ext, "WEBP") || !StrICompare(ext, "TGA");
}

U0 DEViewScan(U8 *dir)
{//Catalogue every image in dir.
	CDirEntry	*de, *tmp;
	U8			*mask;

	StrCopy(de_view.dir, dir);
	de_view.dir[191] = 0;
	de_view.n = 0;
	mask = MStrPrint("%s/*", dir);
	de = FilesFind(mask, FUF_JUST_FILES);
	Free(mask);
	tmp = de;
	while (tmp && de_view.n < DEV_MAX)
	{
		if (DEViewIsImage(tmp->name))
		{
			StrCopy(DEViewName(de_view.n), tmp->name);
			DEViewName(de_view.n)[DEV_NAME_LEN - 1] = 0;
			de_view.n++;
		}
		tmp = tmp->next;
	}
	DirTreeDel(de);
}

CDC *DEViewScaleFit(CDC *src, I64 cw, I64 ch)
{//Scale down to fit cw x ch, keeping aspect. NULL if it already fits.
	I64 s;

	if (src->width <= cw && src->height <= ch)
		return NULL;
	s = MinI64(cw * 1000 / src->width, ch * 1000 / src->height);

	return DEDCScaleNew(src, MaxI64(1, src->width * s / 1000),
							 MaxI64(1, src->height * s / 1000));
}

U0 DEViewDropFit()
{
	if (de_view.fit)
	{
		DCDel(de_view.fit);
		de_view.fit = NULL;
	}
}

U0 DEViewDropThumbs()
{
	I64 i;

	for (i = 0; i < DEV_VIS; i++)
	{
		if (de_view.thumb[i])
			DCDel(de_view.thumb[i]);
		de_view.thumb[i] = NULL;
		de_view.thumb_id[i] = -1;
	}
}

/* ---------------- layout ---------------- */

I64 DEViewRowCount()
{
	if (!de_view.cols)
		return 0;

	return (de_view.n + de_view.cols - 1) / de_view.cols;
}

U0 DEViewGrid()
{//Grid from the window, not the other way round. Called on every size change.
	de_view.cols = ClampI64((Fs->pix_width - DEV_BAR_W) / de_view.cell_w, 1, DEV_MAX_COLS);
	de_view.rows = ClampI64((Fs->pix_height - DEV_HEAD) / de_view.cell_h, 1, DEV_MAX_ROWS);
	de_view.last_w = Fs->pix_width;
	de_view.last_h = Fs->pix_height;
}

U0 DEViewClampScroll()
{//Keep the scroll inside the list and the cursor on screen.
	I64 total = DEViewRowCount(), cur_row;

	if (de_view.top_row > total - de_view.rows)
		de_view.top_row = total - de_view.rows;
	if (de_view.top_row < 0)
		de_view.top_row = 0;
	if (!de_view.cols)
		return;
	cur_row = de_view.cur / de_view.cols;
	if (cur_row < de_view.top_row)
		de_view.top_row = cur_row;
	if (cur_row >= de_view.top_row + de_view.rows)
		de_view.top_row = cur_row - de_view.rows + 1;
}

/* ---------------- decode ---------------- */

U0 DEViewShowSet(CDC *img, CDC *fit)
{//Publish a decoded image. The drawer reads de_view.show and nothing else, so
//one store swaps the frame; the old DCs are freed a frame later, once any
//in-flight GrBlot has finished with them. draw_it stays attached; a detach
//blanks the window for the length of the decode.
	CDC *old_img = de_view.img, *old_fit = de_view.fit;

	if (fit)
		de_view.show = fit;
	else
		de_view.show = img;
	de_view.img = img;
	de_view.fit = fit;
	Sleep(40);
	if (old_fit)
		DCDel(old_fit);
	if (old_img)
		DCDel(old_img);
}

U0 DEViewRefit()
{//Window changed size: rescale what is already decoded. No file read.
	CDC *fit;

	if (!de_view.img)
		return;
	if (de_view.one_to_one)
		fit = NULL;
	else
		fit = DEViewScaleFit(de_view.img, Fs->pix_width, Fs->pix_height - DEV_HEAD);
	if (fit)
		de_view.show = fit;
	else
		de_view.show = de_view.img;
	if (de_view.fit)
	{
		Sleep(40);
		DCDel(de_view.fit);
	}
	de_view.fit = fit;
}

U0 DEViewLoad()
{//Decode the current file and publish it.
	CDC	*img = NULL, *fit = NULL;
	U8	*path;

	if (de_view.n)
	{
		path = DEViewPath(de_view.cur);
		img = DEImageRead(path, Fs);
		if (img)
			StrPrint(de_view.status, "%s   %d/%d   %dx%d", DEViewName(de_view.cur),
					 de_view.cur + 1, de_view.n, img->width, img->height);
		else
			StrPrint(de_view.status, "%s   %d/%d   cannot decode",
					 DEViewName(de_view.cur), de_view.cur + 1, de_view.n);
		Free(path);
	}
	else
		StrPrint(de_view.status, "No images in %s", de_view.dir);
	if (img && !de_view.one_to_one)
		fit = DEViewScaleFit(img, Fs->pix_width, Fs->pix_height - DEV_HEAD);
	if (!img)
		de_view.show = NULL;
	DEViewShowSet(img, fit);
}

U0 DEViewThumbs()
{//Thumbnails for the rows on screen. Entries already decoded are kept where
//they are, so scrolling one row decodes one row instead of a whole screenful.
	I64	 first, last, i, j, slot, cw, ch, tw, th, ndrop = 0;
	CDC	*img, *keep[DEV_VIS], *drop[DEV_VIS];
	I64	 keep_id[DEV_VIS];
	U8	*path;

	if (!de_view.cols || !de_view.rows)
		return;
	first = de_view.top_row * de_view.cols;
	last  = MinI64(de_view.n, first + de_view.cols * de_view.rows);
	cw = (Fs->pix_width - DEV_BAR_W) / de_view.cols;
	ch = (Fs->pix_height - DEV_HEAD) / de_view.rows;
	tw = cw - 12;
	th = ch - DEV_LABEL - 12;
	if (tw < 8 || th < 8)
		return;

	for (i = 0; i < DEV_VIS; i++)
	{
		keep[i] = NULL;
		keep_id[i] = -1;
	}
	//Re-slot what is still visible, drop the rest.
	for (i = 0; i < DEV_VIS; i++)
	{
		j = de_view.thumb_id[i];
		if (de_view.thumb[i] && first <= j < last)
		{
			slot = j - first;
			keep[slot] = de_view.thumb[i];
			keep_id[slot] = j;
		}
		else if (de_view.thumb[i])
			drop[ndrop++] = de_view.thumb[i];
	}
	//Swap wholesale: every store lands a valid pointer, so a frame drawn
	//mid-swap mixes old and new thumbs rather than reading a freed DC.
	for (i = 0; i < DEV_VIS; i++)
	{
		de_view.thumb[i] = keep[i];
		de_view.thumb_id[i] = keep_id[i];
	}
	if (ndrop)
	{
		Sleep(40);
		for (i = 0; i < ndrop; i++)
			DCDel(drop[i]);
	}
	//Decode whatever the scroll just exposed.
	for (j = first; j < last; j++)
	{//ZealC has no `continue` - invert the guard instead.
		slot = j - first;
		if (!de_view.thumb[slot])
		{
			path = DEViewPath(j);
			img = DEImageRead(path, Fs);
			Free(path);
			if (img)
			{
				de_view.thumb_id[slot] = j;
				de_view.thumb[slot] = DEViewScaleFit(img, tw, th);
				if (!de_view.thumb[slot])
					de_view.thumb[slot] = DEDCScaleNew(img, img->width, img->height);
				DCDel(img);
			}
		}
	}
	if (de_view.n)
		StrPrint(de_view.status, "%s   %d/%d   gallery",
				 DEViewName(de_view.cur), de_view.cur + 1, de_view.n);
}

/* ---------------- draw ---------------- */

U0 DEViewDrawIt(CTask *task, CDC *dc)
{
	CDC	*show;
	I64	 i, j, first, cw, ch, cx, cy, tw, th, hw, total, bh, by;
	U8	*hint;
	U8	 label[DEV_NAME_LEN];

	dc->color = de_theme.win_bg;
	GrRect(dc, 0, 0, task->pix_width, task->pix_height);

	dc->color = de_theme.panel;
	GrRect(dc, 0, 0, task->pix_width, DEV_HEAD);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 0, DEV_HEAD - 1, task->pix_width, 1);
	dc->color = de_theme.text;
	GrPrint(dc, 6, (DEV_HEAD - FONT_HEIGHT) / 2, "%s", de_view.status);
	//Right-aligned off its own length, and drawn only when the status text
	//leaves room. A fixed column offset runs off narrow windows.
	hint = "arrows  G gallery  +/- size  W wall  F 1:1  CTRL-F full  O open  ESC";
	hw	 = StrLen(hint) * FONT_WIDTH;
	if (hw + StrLen(de_view.status) * FONT_WIDTH + 24 > task->pix_width)
	{
		hint = "G gallery  W wall  CTRL-F full  O open  ESC";
		hw	 = StrLen(hint) * FONT_WIDTH;
	}
	if (hw + StrLen(de_view.status) * FONT_WIDTH + 24 <= task->pix_width)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, task->pix_width - hw - 6, (DEV_HEAD - FONT_HEIGHT) / 2, "%s", hint);
	}

	if (de_view.gallery)
	{
		if (!de_view.cols || !de_view.rows)
			return;
		cw	  = (task->pix_width - DEV_BAR_W) / de_view.cols;
		ch	  = (task->pix_height - DEV_HEAD) / de_view.rows;
		first = de_view.top_row * de_view.cols;
		for (i = 0; i < de_view.cols * de_view.rows; i++)
		{
			j  = first + i;
			cx = (i % de_view.cols) * cw;
			cy = DEV_HEAD + (i / de_view.cols) * ch;
			if (j < de_view.n)
			{
				if (j == de_view.cur)
					dc->color = de_theme.bttn_focus;
				else
					dc->color = de_theme.bttn;
				GrRect(dc, cx + 2, cy + 2, cw - 4, ch - 4);
				if (de_view.thumb[i])
				{
					tw = de_view.thumb[i]->width;
					th = de_view.thumb[i]->height;
					GrBlot(dc, cx + (cw - tw) / 2,
							   cy + 6 + (ch - DEV_LABEL - 6 - th) / 2, de_view.thumb[i]);
				}
				if (j == de_view.cur)
					dc->color = de_theme.accent;
				else
					dc->color = de_theme.text_dim;
				//Truncated to the cell width; a long name spills into the next column.
				StrCopy(label, DEViewName(j));
				if (StrLen(label) > (cw - 12) / FONT_WIDTH)
					label[MaxI64(0, (cw - 12) / FONT_WIDTH)] = 0;
				GrPrint(dc, cx + 6, cy + ch - DEV_LABEL, "%s", label);
			}
		}
		//Scrollbar: only when the list is taller than the grid.
		total = DEViewRowCount();
		if (total > de_view.rows)
		{
			dc->color = de_theme.panel;
			GrRect(dc, task->pix_width - DEV_BAR_W, DEV_HEAD, DEV_BAR_W,
				   task->pix_height - DEV_HEAD);
			bh = MaxI64(16, (task->pix_height - DEV_HEAD) * de_view.rows / total);
			by = DEV_HEAD + (task->pix_height - DEV_HEAD - bh) * de_view.top_row /
				 (total - de_view.rows);
			dc->color = de_theme.accent;
			GrRect(dc, task->pix_width - DEV_BAR_W, by, DEV_BAR_W, bh);
		}
		return;
	}

	show = de_view.show;	//one read: the swap in DEViewShowSet is a single store
	if (show)
		GrBlot(dc, (task->pix_width - show->width) / 2,
				   DEV_HEAD + (task->pix_height - DEV_HEAD - show->height) / 2, show);
}

U0 DEViewRefresh()
{//Reflow for the current window size. The single view rescales only; a
//re-decode per resize frame makes a border drag crawl.
	DEViewGrid;
	DEViewClampScroll;
	if (de_view.gallery)
		DEViewThumbs;
	else
		DEViewRefit;
	Fs->draw_it = &DEViewDrawIt;
}

/* ---------------- navigation ---------------- */

U0 DEViewStep(I64 d)
{
	if (!de_view.n)
		return;
	de_view.cur = (de_view.cur + d + de_view.n) % de_view.n;
	if (de_view.gallery)
	{
		DEViewClampScroll;
		DEViewThumbs;
	}
	else
		DEViewLoad;
	Fs->draw_it = &DEViewDrawIt;
}

U0 DEViewScroll(I64 rows)
{//Wheel and PGUP/PGDN in gallery mode: move the window, leave the cursor.
	I64 total = DEViewRowCount();

	if (!de_view.gallery || total <= de_view.rows)
		return;
	de_view.top_row = ClampI64(de_view.top_row + rows, 0, total - de_view.rows);
	DEViewThumbs;
	Fs->draw_it = &DEViewDrawIt;
}

U0 DEViewSetGallery(Bool on)
{
	de_view.gallery = on;
	if (on)
	{
		DEViewGrid;
		DEViewClampScroll;
		DEViewThumbs;
	}
	else
		DEViewLoad;
	Fs->draw_it = &DEViewDrawIt;
}

U0 DEViewBarTo(I64 y)
{//Map a y inside the scrollbar to a top row, centring the thumb on the cursor.
	I64 total = DEViewRowCount(), span = Fs->pix_height - DEV_HEAD, bh;

	if (total <= de_view.rows || span <= 0)
		return;
	bh = MaxI64(16, span * de_view.rows / total);
	y  = y - DEV_HEAD - bh / 2;
	if (span - bh <= 0)
		return;
	de_view.top_row = ClampI64(y * (total - de_view.rows) / (span - bh),
							   0, total - de_view.rows);
	DEViewThumbs;
	Fs->draw_it = &DEViewDrawIt;
}

Bool DEViewOnBar(I64 x, I64 y)
{
	return de_view.gallery && y >= DEV_HEAD && x >= Fs->pix_width - DEV_BAR_W &&
		   DEViewRowCount() > de_view.rows;
}

U0 DEViewCellSize(I64 d)
{//Bigger or smaller thumbnails. The grid follows, so this is a zoom.
	de_view.cell_w = ClampI64(de_view.cell_w + d, DEV_CELL_MIN, DEV_CELL_MAX);
	de_view.cell_h = ClampI64(de_view.cell_h + d * DEV_CELL_H / DEV_CELL_W,
							  DEV_CELL_MIN, DEV_CELL_MAX);
	DEViewDropThumbs();		//every thumb was scaled for the old cell
	DEViewRefresh;
}

I64 DEViewHit(I64 x, I64 y)
{//File index under a window-relative point, -1 for none.
	I64 cw, ch, col, row;

	if (!de_view.gallery || y < DEV_HEAD || !de_view.cols || !de_view.rows)
		return -1;
	if (x >= Fs->pix_width - DEV_BAR_W)
		return -1;			//scrollbar, not a cell
	cw	= (Fs->pix_width - DEV_BAR_W) / de_view.cols;
	ch	= (Fs->pix_height - DEV_HEAD) / de_view.rows;
	col = x / cw;
	row = (y - DEV_HEAD) / ch;
	if (col < 0 || col >= de_view.cols || row < 0 || row >= de_view.rows)
		return -1;
	col = (de_view.top_row + row) * de_view.cols + col;
	if (col >= de_view.n)
		return -1;

	return col;
}

U0 DEViewClick(I64 x, I64 y)
{//Select; clicking the already-selected cell opens it. Not a double click:
//WIF_FOCUS_TASK_MS_L_D delivers L-DOWN instantly and never raises
//MESSAGE_MS_L_D_DOWN.
	I64 hit;

	if (DEViewOnBar(x, y))
	{//Grab: the drag is carried by mouse.lb in the poll loop below.
		de_view.dragging = TRUE;
		DEViewBarTo(y);
		return;
	}
	hit = DEViewHit(x, y);
	if (hit < 0)
		return;
	if (hit == de_view.cur)
	{
		de_view.cur = hit;
		DEViewSetGallery(FALSE);
		return;
	}
	de_view.cur = hit;
	StrPrint(de_view.status, "%s   %d/%d   gallery",
			 DEViewName(de_view.cur), de_view.cur + 1, de_view.n);
	Fs->draw_it = &DEViewDrawIt;
}

/* ---------------- window ---------------- */

U0 DEViewWindow(Bool max)
{//Centred by default. Bordered either way, so it stays clear of the taskbar.
	I64 cols, rows, l, t;

	if (max)
	{
		WinMax;
		return;
	}
	cols = MinI64(DEV_WIN_COLS, TEXT_COLS - 4);
	rows = MinI64(DEV_WIN_ROWS, TEXT_ROWS - 5);
	l = MaxI64(1, (TEXT_COLS - cols) / 2);
	t = MaxI64(2, (TEXT_ROWS - rows) / 2);
	WinHorz(l, l + cols - 1);
	WinVert(t, t + rows - 1);
}

U0 DEViewFullscreen(Bool on)
{//Whole screen, over the taskbar. WinVert only keeps bordered windows above
//the reserved rows, so the border has to go first; the taskbar ctrl is hidden
//because the WinMgr draws it after the window layer.
	if (on == de_view.full)
		return;
	de_view.full = on;
	if (on)
	{
		de_view.sv_left	  = Fs->win_left;
		de_view.sv_right  = Fs->win_right;
		de_view.sv_top	  = Fs->win_top;
		de_view.sv_bottom = Fs->win_bottom;
		if (de.on && de.bar)
			de.bar->flags &= ~CTRLF_SHOW;
		WinBorder(OFF);
		WinHorz(0, TEXT_COLS - 1);
		WinVert(0, TEXT_ROWS - 1);
	}
	else
	{
		WinBorder(ON);
		WinHorz(de_view.sv_left, de_view.sv_right);
		WinVert(de_view.sv_top, de_view.sv_bottom);
		if (de.on && de.bar)
			de.bar->flags |= CTRLF_SHOW;
	}
	WinZBufUpdate;
	DEViewRefresh;
}

U0 DEViewSetWallpaper()
{
	U8 *path;

	if (!de_view.n)
		return;
	path = DEViewPath(de_view.cur);
	DEWallpaperLoad(path);
	Free(path);
	de.cfg_dirty = TRUE;
	StrPrint(de_view.status, "%s   set as wallpaper", DEViewName(de_view.cur));
}

U0 DEViewOpenDir(U8 *picked)
{//Recatalogue around a picked file and select it.
	U8	*dir = StrNew(picked), *slash;
	I64	 i;

	slash = dir + StrLen(dir);
	while (slash > dir && slash[-1] != '/')
		slash--;
	if (slash > dir)
		slash[-1] = 0;
	DEViewScan(dir);
	de_view.cur = 0;
	for (i = 0; i < de_view.n; i++)
		if (!StrICompare(DEViewName(i), slash))
			de_view.cur = i;
	Free(dir);
}

U0 DEViewKey(I64 ch, I64 sc, Bool *_done, Bool *_max)
{
	U8 *open;

	switch (ch)
	{
		case 0:
			switch (sc.u8[0])
			{
				case SC_CURSOR_RIGHT:
					DEViewStep(1);
					break;
				case SC_CURSOR_LEFT:
					DEViewStep(-1);
					break;
				case SC_CURSOR_DOWN:
					if (de_view.gallery)
						DEViewStep(de_view.cols);
					else
						DEViewStep(1);
					break;
				case SC_CURSOR_UP:
					if (de_view.gallery)
						DEViewStep(-de_view.cols);
					else
						DEViewStep(-1);
					break;
				case SC_PAGE_DOWN:
					if (de_view.gallery)
						DEViewScroll(de_view.rows);
					else
						DEViewStep(1);
					break;
				case SC_PAGE_UP:
					if (de_view.gallery)
						DEViewScroll(-de_view.rows);
					else
						DEViewStep(-1);
					break;
				case SC_HOME:
					DEViewStep(-de_view.cur);
					break;
				case SC_END:
					DEViewStep(de_view.n - 1 - de_view.cur);
					break;
			}
			break;
		case CH_CTRLF:
			DEViewFullscreen(!de_view.full);
			break;
		case '+':
		case '=':
			if (de_view.gallery)
				DEViewCellSize(24);
			break;
		case '-':
		case '_':
			if (de_view.gallery)
				DEViewCellSize(-24);
			break;
		case 'g':
		case 'G':
			DEViewSetGallery(!de_view.gallery);
			break;
		case '\n':
			if (de_view.gallery)
				DEViewSetGallery(FALSE);
			break;
		case 'f':
		case 'F':
			de_view.one_to_one = !de_view.one_to_one;
			if (!de_view.gallery)
			{//Rescale what is decoded; the file has not changed.
				DEViewRefit;
				Fs->draw_it = &DEViewDrawIt;
			}
			break;
		case 'm':
		case 'M':
			if (de_view.full)
				break;			//<CTRL-F> owns the geometry while it is on
			*_max = !*_max;
			DEViewWindow(*_max);
			DEViewDropThumbs();	//sized to the old window
			DEViewRefresh;
			break;
		case 'w':
		case 'W':
			DEViewSetWallpaper;
			break;
		case 'o':
		case 'O':
			Fs->draw_it = NULL;
			Sleep(30);
			open = DEPickFile(de_view.dir, "Select Image");
			if (open)
			{
				DEViewOpenDir(open);
				Free(open);
				DEViewDropThumbs();
			}
			DEViewSetGallery(FALSE);
			break;
		case CH_ESC:
		case CH_SHIFT_ESC:
			if (de_view.full)
				DEViewFullscreen(FALSE);
			else if (de_view.gallery)
				DEViewSetGallery(FALSE);
			else
				*_done = TRUE;
			break;
	}
}

public U0 DEViewImage(U8 *filename=NULL)
{
	U8	*pick = NULL;
	I64	 msg, a1, a2, dz, old_inhibit;
	Bool done = FALSE, max = FALSE;

	MemSet(&de_view, 0, sizeof(CDEViewer));
	DEViewDropThumbs();		//thumb_id starts at -1, not 0

	if (!filename)
		filename = pick = DEPickFile("::/DE", "Select Image");
	if (!filename)
		return;
	DEViewOpenDir(filename);

	SettingsPush;
	old_inhibit = Fs->win_inhibit;
	StrCopy(Fs->task_title, "yViewer");
	WinBorder(ON);			//WinBorder's default arg is OFF, not a toggle
	DEViewWindow(FALSE);	//centred; M maximises, CTRL-F fullscreens
	//L-DOWN delivers without waiting on the double-click timeout, so a gallery
	//click lands on the press. See DEViewClick.
	Fs->win_inhibit = old_inhibit | WIF_FOCUS_TASK_MS_L_D;
	WinFocus;
	WinToTop;
	WinZBufUpdate;
	DocCursor(OFF);
	DocClear;

	de_view.last_z = mouse.pos.z;
	de_view.cell_w = DEV_CELL_W;
	de_view.cell_h = DEV_CELL_H;
	DEViewGrid;
	DEViewLoad;
	Fs->draw_it = &DEViewDrawIt;

	while (!done)
	{
		while (msg = MessageScan(&a1, &a2))
		{
			switch (msg)
			{
				case MESSAGE_KEY_DOWN:
					DEViewKey(a1, a2, &done, &max);
					break;
				case MESSAGE_MS_L_DOWN:
					DEViewClick(a1, a2);
					break;
			}
			if (done)
				break;
		}

		if (de_view.dragging)
		{
			if (mouse.lb)
				DEViewBarTo(mouse.pos.y - Fs->pix_top - Fs->scroll_y);
			else
				de_view.dragging = FALSE;
		}

		dz = mouse.pos.z - de_view.last_z;
		de_view.last_z = mouse.pos.z;
		if (dz && Fs == sys_focus_task)
		{
			if (de_view.gallery)
				DEViewScroll(-dz);
			else
				DEViewStep(-dz);
		}

		//The window can be resized under us: reflow rather than draw the old
		//grid into the new size.
		if (Fs->pix_width != de_view.last_w || Fs->pix_height != de_view.last_h)
			DEViewRefresh;

		Sleep(20);
	}

	if (de_view.full)
		DEViewFullscreen(FALSE);
	Fs->draw_it = NULL;
	de_view.show = NULL;
	Sleep(50);				//let the in-flight frame stop reading the DCs
	DEViewDropThumbs();
	DEViewDropFit();
	if (de_view.img)
	{
		DCDel(de_view.img);
		de_view.img = NULL;
	}
	Free(pick);
	Fs->win_inhibit = old_inhibit;
	DocClear;
	SettingsPop;
}
