//YDE desktop ctrl. Covers everything above the taskbar. The WinMgr only runs
//a task's ctrls when that task is the topmost window under the cursor, so
//these fire on bare desktop only.

U0 DEDeskClick(CCtrl *c, I64 x, I64 y, Bool down)
{//CTRLF_CAPTURE_LEFT_MS: called every frame while the button is down on bare
//desktop, then once with down = FALSE. Holding re-arms the stock stats
//wallpaper (DEStart retired it) and DEWallpaperDraw drops the image, so the
//text underneath shows through for as long as the button is held.
	no_warn c;
	no_warn x;
	no_warn y;
	if (!de.stats_enable)
		return;
	if (down)
	{
		if (!de.stats_hold)
		{
			de.stats_hold	 = TRUE;
			gr.fp_wall_paper = de.old_wall_paper;
		}
	}
	else if (de.stats_hold)
	{
		de.stats_hold	 = FALSE;
		gr.fp_wall_paper = NULL;
	}
}

U0 DEDeskMenuTask()
{//Desktop right-click menu, in its own task so the WinMgr never blocks.
//Entries that live in later-included files are launched by runtime string:
//DE.ZC compiles before Settings.ZC, so &DESettings would not resolve.
	U8	*file;
	I64	 i = PopUpPickList("Settings\0New Terminal\0File Manager\0"
						   "Task Manager\0Wallpaper...\0");

	switch (i)
	{
		case 0:
			//PopUp with no parent = run and exit, so Settings closes its whole
			//task when it is dismissed instead of leaving a terminal behind.
			PopUp("DESettings;");
			break;
		case 1:
			User;
			break;
		case 2:
			User("FileMgr;\n");
			break;
		case 3:
			User("TaskRep;\n");
			break;
		case 4:
			file = DEPickFile("::/DE", "Select Image");
			if (file)
			{
				DEWallpaperLoad(file);
				Free(file);
				de.cfg_dirty = TRUE;
			}
			break;
	}
	de.desk_menu_task = NULL;
}

U0 DEDeskRightClick(CCtrl *c, I64 x, I64 y, Bool down)
{
	no_warn c;
	no_warn x;
	no_warn y;
	if (!down)
		return;
	if (!TaskValidate(de.desk_menu_task) && tS - de.desk_menu_last > 0.3)
	{
		de.desk_menu_last = tS;
		de.desk_menu_task = Spawn(&DEDeskMenuTask, NULL, "DE Desktop Menu");
	}
}
