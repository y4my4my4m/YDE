//YDE Image Viewer. Every format DEImageRead decodes: PNG, JPG, GIF, WEBP, TGA.
//
//Single view scales to fit; gallery is a thumbnail grid. Thumbnails cover the
//visible page only and are freed when the page moves - a whole directory of
//them runs to tens of megabytes.
//
//Run with DEViewImage; or DEViewImage("::/path/File.PNG");

#define DEV_MAX			512		//files catalogued per directory
#define DEV_NAME_LEN	64
#define DEV_COLS		4		//gallery grid
#define DEV_ROWS		3
#define DEV_PAGE		(DEV_COLS * DEV_ROWS)
#define DEV_HEAD		20		//header strip, pixels
#define DEV_WIN_COLS	104		//default window, cells
#define DEV_WIN_ROWS	40

class CDEViewer
{
	U8	  dir[192];
	U8	  name[DEV_MAX * DEV_NAME_LEN];
	I64	  n, cur;
	CDC	 *img;					//decode of the current file, unscaled
	CDC	 *fit;					//img scaled to the window, NULL at 1:1
	CDC	 *thumb[DEV_PAGE];		//visible gallery page
	I64	  thumb_page;			//page those thumbs belong to, -1 = none
	Bool  gallery, one_to_one;
	U8	  status[128];
} de_view;

U8 *DEViewName(I64 i)
{//Row of the flat name table.
	return &de_view.name[i * DEV_NAME_LEN];
}

U8 *DEViewPath(I64 i)
{//Caller frees.
	return MStrPrint("%s/%s", de_view.dir, DEViewName(i));
}

Bool DEViewIsImage(U8 *name)
{
	U8 *ext = name + StrLen(name);

	while (ext > name && ext[-1] != '.')
		ext--;

	return !StrICompare(ext, "PNG") || !StrICompare(ext, "JPG") ||
		   !StrICompare(ext, "JPEG") || !StrICompare(ext, "GIF") ||
		   !StrICompare(ext, "WEBP") || !StrICompare(ext, "TGA");
}

U0 DEViewScan(U8 *dir)
{//Catalogue every image in dir.
	CDirEntry	*de, *tmp;
	U8			*mask;

	StrCopy(de_view.dir, dir);
	de_view.dir[191] = 0;
	de_view.n = 0;
	mask = MStrPrint("%s/*", dir);
	de = FilesFind(mask, FUF_JUST_FILES);
	Free(mask);
	tmp = de;
	while (tmp && de_view.n < DEV_MAX)
	{
		if (DEViewIsImage(tmp->name))
		{
			StrCopy(DEViewName(de_view.n), tmp->name);
			DEViewName(de_view.n)[DEV_NAME_LEN - 1] = 0;
			de_view.n++;
		}
		tmp = tmp->next;
	}
	DirTreeDel(de);
}

CDC *DEViewScaleFit(CDC *src, I64 cw, I64 ch)
{//Scale down to fit cw x ch, keeping aspect. NULL if it already fits.
	I64 s;

	if (src->width <= cw && src->height <= ch)
		return NULL;
	s = MinI64(cw * 1000 / src->width, ch * 1000 / src->height);

	return DEDCScaleNew(src, MaxI64(1, src->width * s / 1000),
							 MaxI64(1, src->height * s / 1000));
}

U0 DEViewDropFit()
{
	if (de_view.fit)
	{
		DCDel(de_view.fit);
		de_view.fit = NULL;
	}
}

U0 DEViewDropThumbs()
{
	I64 i;

	for (i = 0; i < DEV_PAGE; i++)
		if (de_view.thumb[i])
		{
			DCDel(de_view.thumb[i]);
			de_view.thumb[i] = NULL;
		}
	de_view.thumb_page = -1;
}

U0 DEViewLoad()
{//Decode the current file and build its fitted copy. draw_it is detached
//first: it runs in the WinMgr and must not read a DC mid-swap.
	U8 *path;

	Fs->draw_it = NULL;
	Sleep(30);
	DEViewDropFit();
	if (de_view.img)
	{
		DCDel(de_view.img);
		de_view.img = NULL;
	}
	if (de_view.n)
	{
		path = DEViewPath(de_view.cur);
		de_view.img = DEImageRead(path, Fs);
		if (de_view.img)
			StrPrint(de_view.status, "%s   %d/%d   %dx%d", DEViewName(de_view.cur),
					 de_view.cur + 1, de_view.n, de_view.img->width, de_view.img->height);
		else
			StrPrint(de_view.status, "%s   %d/%d   cannot decode",
					 DEViewName(de_view.cur), de_view.cur + 1, de_view.n);
		Free(path);
	}
	else
		StrPrint(de_view.status, "No images in %s", de_view.dir);
	if (de_view.img && !de_view.one_to_one)
		de_view.fit = DEViewScaleFit(de_view.img, Fs->pix_width,
									 Fs->pix_height - DEV_HEAD);
}

U0 DEViewThumbs()
{//Thumbnails for the page the cursor sits on, if not already built.
	I64	 page = de_view.cur / DEV_PAGE, i, j, tw, th;
	CDC	*img;
	U8	*path;

	if (page == de_view.thumb_page)
		return;
	Fs->draw_it = NULL;
	Sleep(30);
	DEViewDropThumbs();
	tw = Fs->pix_width / DEV_COLS - 12;
	th = (Fs->pix_height - DEV_HEAD) / DEV_ROWS - 24;
	if (tw < 8 || th < 8)
		return;
	for (i = 0; i < DEV_PAGE; i++)
	{
		j = page * DEV_PAGE + i;
		if (j < de_view.n)
		{
			path = DEViewPath(j);
			img = DEImageRead(path, Fs);
			Free(path);
			if (img)
			{
				de_view.thumb[i] = DEViewScaleFit(img, tw, th);
				if (!de_view.thumb[i])
					de_view.thumb[i] = DEDCScaleNew(img, img->width, img->height);
				DCDel(img);
			}
		}
	}
	de_view.thumb_page = page;
	StrPrint(de_view.status, "%s   %d/%d   gallery",
			 DEViewName(de_view.cur), de_view.cur + 1, de_view.n);
}

U0 DEViewDrawIt(CTask *task, CDC *dc)
{
	CDC	*show;
	I64	 i, j, page, cw, ch, cx, cy, tw, th, hw;
	U8	*hint;
	U8	 label[DEV_NAME_LEN];

	dc->color = de_theme.win_bg;
	GrRect(dc, 0, 0, task->pix_width, task->pix_height);

	dc->color = de_theme.panel;
	GrRect(dc, 0, 0, task->pix_width, DEV_HEAD);
	dc->color = de_theme.panel_edge;
	GrRect(dc, 0, DEV_HEAD - 1, task->pix_width, 1);
	dc->color = de_theme.text;
	GrPrint(dc, 6, (DEV_HEAD - FONT_HEIGHT) / 2, "%s", de_view.status);
	//Right-aligned off its own length, and only when there is room left after
	//the status text - the fixed 48-column offset ran off narrow windows.
	hint = "arrows  G gallery  W wallpaper  F 1:1  M max  O open  ESC";
	hw	 = StrLen(hint) * FONT_WIDTH;
	if (hw + StrLen(de_view.status) * FONT_WIDTH + 24 > task->pix_width)
	{
		hint = "G gallery  W wall  F 1:1  M max  O open  ESC";
		hw	 = StrLen(hint) * FONT_WIDTH;
	}
	if (hw + StrLen(de_view.status) * FONT_WIDTH + 24 <= task->pix_width)
	{
		dc->color = de_theme.text_dim;
		GrPrint(dc, task->pix_width - hw - 6, (DEV_HEAD - FONT_HEIGHT) / 2, "%s", hint);
	}

	if (de_view.gallery)
	{
		cw	 = task->pix_width / DEV_COLS;
		ch	 = (task->pix_height - DEV_HEAD) / DEV_ROWS;
		page = de_view.cur / DEV_PAGE;
		for (i = 0; i < DEV_PAGE; i++)
		{
			j  = page * DEV_PAGE + i;
			cx = (i % DEV_COLS) * cw;
			cy = DEV_HEAD + (i / DEV_COLS) * ch;
			if (j < de_view.n)
			{
				if (j == de_view.cur)
					dc->color = de_theme.bttn_focus;
				else
					dc->color = de_theme.bttn;
				GrRect(dc, cx + 2, cy + 2, cw - 4, ch - 4);
				if (de_view.thumb[i])
				{
					tw = de_view.thumb[i]->width;
					th = de_view.thumb[i]->height;
					GrBlot(dc, cx + (cw - tw) / 2, cy + 6 + (ch - 26 - th) / 2,
						   de_view.thumb[i]);
				}
				if (j == de_view.cur)
					dc->color = de_theme.accent;
				else
					dc->color = de_theme.text_dim;
				GrPrint(dc, cx + 6, cy + ch - 14, "%s", DEViewName(j));
			}
		}
		return;
	}

	show = de_view.fit;
	if (!show)
		show = de_view.img;
	if (show)
		GrBlot(dc, (task->pix_width - show->width) / 2,
				   DEV_HEAD + (task->pix_height - DEV_HEAD - show->height) / 2, show);
}

U0 DEViewStep(I64 d)
{
	if (!de_view.n)
		return;
	de_view.cur = (de_view.cur + d + de_view.n) % de_view.n;
	if (de_view.gallery)
		DEViewThumbs;
	else
		DEViewLoad;
	Fs->draw_it = &DEViewDrawIt;
}

U0 DEViewSetWallpaper()
{
	U8 *path;

	if (!de_view.n)
		return;
	path = DEViewPath(de_view.cur);
	DEWallpaperLoad(path);
	Free(path);
	de.cfg_dirty = TRUE;
	StrPrint(de_view.status, "%s   set as wallpaper", DEViewName(de_view.cur));
}

U0 DEViewOpenDir(U8 *picked)
{//Recatalogue around a picked file and select it.
	U8	*dir = StrNew(picked), *slash;
	I64	 i;

	slash = dir + StrLen(dir);
	while (slash > dir && slash[-1] != '/')
		slash--;
	if (slash > dir)
		slash[-1] = 0;
	DEViewScan(dir);
	de_view.cur = 0;
	for (i = 0; i < de_view.n; i++)
		if (!StrICompare(DEViewName(i), slash))
			de_view.cur = i;
	Free(dir);
}

U0 DEViewWindow(Bool max)
{//Centred by default. Bordered either way, so it stays clear of the taskbar.
	I64 cols, rows, l, t;

	if (max)
	{
		WinMax;
		return;
	}
	cols = MinI64(DEV_WIN_COLS, TEXT_COLS - 4);
	rows = MinI64(DEV_WIN_ROWS, TEXT_ROWS - 5);
	l = MaxI64(1, (TEXT_COLS - cols) / 2);
	t = MaxI64(2, (TEXT_ROWS - rows) / 2);
	WinHorz(l, l + cols - 1);
	WinVert(t, t + rows - 1);
}

public U0 DEViewImage(U8 *filename=NULL)
{
	U8	*pick = NULL, *open;
	I64	 ch, sc;
	Bool done = FALSE, max = FALSE;

	MemSet(&de_view, 0, sizeof(CDEViewer));
	de_view.thumb_page = -1;

	if (!filename)
		filename = pick = DEPickFile("::/DE", "Select Image");
	if (!filename)
		return;
	DEViewOpenDir(filename);

	SettingsPush;
	StrCopy(Fs->task_title, "Image Viewer");
	WinBorder(ON);			//WinBorder's default arg is OFF, not a toggle
	DEViewWindow(FALSE);	//centred; M maximises
	WinFocus;
	WinToTop;
	WinZBufUpdate;
	DocCursor(OFF);
	DocClear;

	DEViewLoad;
	Fs->draw_it = &DEViewDrawIt;

	while (!done)
	{
		ch = KeyGet(&sc);
		switch (ch)
		{
			case 0:
				switch (sc.u8[0])
				{
					case SC_CURSOR_RIGHT:
						DEViewStep(1);
						break;
					case SC_CURSOR_LEFT:
						DEViewStep(-1);
						break;
					case SC_CURSOR_DOWN:
						if (de_view.gallery)
							DEViewStep(DEV_COLS);
						else
							DEViewStep(1);
						break;
					case SC_CURSOR_UP:
						if (de_view.gallery)
							DEViewStep(-DEV_COLS);
						else
							DEViewStep(-1);
						break;
					case SC_PAGE_DOWN:
						DEViewStep(DEV_PAGE);
						break;
					case SC_PAGE_UP:
						DEViewStep(-DEV_PAGE);
						break;
					case SC_HOME:
						DEViewStep(-de_view.cur);
						break;
					case SC_END:
						DEViewStep(de_view.n - 1 - de_view.cur);
						break;
				}
				break;
			case 'g':
			case 'G':
				de_view.gallery = !de_view.gallery;
				if (de_view.gallery)
					DEViewThumbs;
				else
					DEViewLoad;
				Fs->draw_it = &DEViewDrawIt;
				break;
			case '\n':
				if (de_view.gallery)
				{
					de_view.gallery = FALSE;
					DEViewLoad;
					Fs->draw_it = &DEViewDrawIt;
				}
				break;
			case 'f':
			case 'F':
				de_view.one_to_one = !de_view.one_to_one;
				if (!de_view.gallery)
				{
					DEViewLoad;
					Fs->draw_it = &DEViewDrawIt;
				}
				break;
			case 'w':
			case 'W':
				DEViewSetWallpaper;
				break;
			case 'o':
			case 'O':
				Fs->draw_it = NULL;
				Sleep(30);
				open = DEPickFile(de_view.dir, "Select Image");
				if (open)
				{
					DEViewOpenDir(open);
					Free(open);
					DEViewDropThumbs();
				}
				de_view.gallery = FALSE;
				DEViewLoad;
				Fs->draw_it = &DEViewDrawIt;
				break;
			case CH_ESC:
			case CH_SHIFT_ESC:
				if (de_view.gallery)
				{
					de_view.gallery = FALSE;
					DEViewLoad;
					Fs->draw_it = &DEViewDrawIt;
				}
				else
					done = TRUE;
				break;
		}
	}

	Fs->draw_it = NULL;
	Sleep(50);				//let the in-flight frame stop reading the DCs
	DEViewDropThumbs();
	DEViewDropFit();
	if (de_view.img)
	{
		DCDel(de_view.img);
		de_view.img = NULL;
	}
	Free(pick);
	DocClear;
	SettingsPop;
}
