//YDE imaging: format-agnostic decode, the file chooser, and the wallpaper.

CDC *DEDCScaleNew(CDC *src, I64 w, I64 h, CTask *mem_task=NULL)
{//Nearest-neighbor scale of a truecolor DC into a new DC. mem_task matters:
//DCs made from short-lived app tasks die with them.
	CDC *res = DCNew(w, h, mem_task);
	I64  x, y, sy;
	U32 *dst, *srow;

	for (y = 0; y < h; y++)
	{
		sy   = y * src->height / h;
		srow = src->body + sy * src->width_internal;
		dst  = res->body + y  * res->width_internal;
		for (x = 0; x < w; x++)
			dst[x] = srow[x * src->width / w];
	}
	res->flags |= DCF_NO_TRANSPARENTS;

	return res;
}

public CDC *DEImageRead(U8 *filename, CTask *mem_task=NULL)
{//Decode any image format the tree ships. Extension first, then every decoder
//in turn - the loaders sniff their own magic, so a wrong name still works.
	CDC	*img = NULL;
	U8	*ext = filename + StrLen(filename);

	while (ext > filename && ext[-1] != '.' && ext[-1] != '/')
		ext--;
	if (!StrICompare(ext, "PNG"))
		img = PNGRead(filename);
	else if (!StrICompare(ext, "JPG") || !StrICompare(ext, "JPEG"))
		img = JPGRead(filename, mem_task);
	else if (!StrICompare(ext, "GIF"))
		img = GIFRead(filename, mem_task);
	else if (!StrICompare(ext, "WEBP"))
		img = WEBPRead(filename, mem_task);
	else if (!StrICompare(ext, "TGA"))
		img = TGARead(filename, mem_task);
	if (!img)
		img = PNGRead(filename);
	if (!img)
		img = JPGRead(filename, mem_task);
	if (!img)
		img = GIFRead(filename, mem_task);
	if (!img)
		img = WEBPRead(filename, mem_task);
	if (!img)
		img = TGARead(filename, mem_task);

	return img;
}

#define DE_PICK_CTRLS_MAX	16

public U8 *DEPickFile(U8 *dir, U8 *title="Select File", I64 cols=64, I64 rows=34)
{//File chooser in the caller's task. PopUpPickFile spawns a server task whose
//window defaults to full screen. FileMgr's own SettingsPop restores to
//whatever geometry it found, so the caller's window is saved and put back by
//hand.
	U8		*res, *old_dir;
	CCtrl	*c, *hidden[DE_PICK_CTRLS_MAX];
	I64		 n_hidden = 0;
	//ZealC takes a function-pointer declarator at global or class scope but not
	//as a local: hold it as an integer.
	I64	 old_draw = Fs->draw_it;
	I64	 ol = Fs->win_left, orr = Fs->win_right, ot = Fs->win_top, ob = Fs->win_bottom;
	I64	 old_inhibit = Fs->win_inhibit;
	I64	 l, t;

	if (!DocPut)
		DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	old_dir		= DirCur;
	Fs->draw_it	= NULL;		//or the caller's widgets paint over the file list
	//CTRLF_SHOW gates both drawing and hit testing, so a ctrl left shown paints
	//over the list and takes the clicks meant for it.
	c = Fs->next_ctrl;
	while (c != &Fs->next_ctrl)
	{
		if (c->flags & CTRLF_SHOW && n_hidden < DE_PICK_CTRLS_MAX)
		{
			c->flags &= ~CTRLF_SHOW;
			hidden[n_hidden] = c;
			n_hidden++;
		}
		c = c->next;
	}
	//FileMgr picks rows from doc->cur_entry, which the WinMgr moves through
	//WinCursorPosSet on L-DOWN. WIG_TASK_DEFAULT (raw Spawn) sets WIF_SELF_MS_L,
	//which skips that block, and WIG_DBL_CLICK suppresses MS_L_D_UP, so clicks
	//select nothing and double-click never opens a dir. Widget tasks add
	//WIF_FOCUS_TASK_MS_L_D on top. Run with the terminal mask instead.
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT;
	l = MaxI64(1, (TEXT_COLS - cols) / 2);
	t = MaxI64(1, (TEXT_ROWS - rows) / 2);
	WinHorz(l, l + cols - 1);
	WinVert(t, t + rows - 1);
	StrCopy(Fs->task_title, title);
	DocCursor(ON);
	WinFocus;
	WinToTop;
	WinZBufUpdate;
	Cd(dir);
	res = FileMgr(FM_PICK_FILE, Fs);
	Cd(old_dir);
	Free(old_dir);
	WinHorz(ol, orr);
	WinVert(ot, ob);
	DocCursor(OFF);
	DocClear;
	Fs->draw_it = old_draw;
	Fs->win_inhibit = old_inhibit;
	while (n_hidden)
	{
		n_hidden--;
		hidden[n_hidden]->flags |= CTRLF_SHOW;
	}
	WinZBufUpdate;

	return res;
}

public U0 DESysLogShow(Bool on)
{//The DE wallpaper blots over every cell the z-buffer says is desktop, so a
//window that was never raised sits under it. Raising SysLog puts it in the
//z-order where the blot skips it.
	if (on)
	{
		LBts(&sys_task->display_flags, DISPLAYf_SHOW);
		WinToTop(sys_task);
		WinFocus(sys_task);
	}
	else
		LBtr(&sys_task->display_flags, DISPLAYf_SHOW);
	WinZBufUpdate;
}

U0 DEWallpaperDraw(CTask *task, CDC *dc)
{//Hung on sys_winmgr_task->draw_it, after the text layer. GrBlot() self-clips
//per pixel; this tests one z-buffer cell per 8x8 instead.
	CDC	*img = de.wallpaper;
	U16	*zb  = gr.win_z_buf;
	I64	 zn  = task->win_z_num;
	I64	 cx, cy, run, y, x0, w, cols = TEXT_COLS, rows = TEXT_ROWS;

	if (!img || de.stats_hold)
		return;
	if (!zb)
	{
		GrBlot(dc, 0, 0, img);
		return;
	}
	if (rows * FONT_HEIGHT > img->height)
		rows = img->height / FONT_HEIGHT;
	if (cols * FONT_WIDTH > img->width)
		cols = img->width / FONT_WIDTH;
	for (cy = 0; cy < rows; cy++)
	{
		cx = 0;
		while (cx < cols)
		{
			if (zn >= zb[cy * TEXT_COLS + cx])
			{
				run = cx;
				while (cx < cols && zn >= zb[cy * TEXT_COLS + cx])
					cx++;
				x0 = run * FONT_WIDTH;
				w  = (cx - run) * FONT_WIDTH;
				for (y = 0; y < FONT_HEIGHT; y++)
					MemCopy(dc->body + (cy * FONT_HEIGHT + y) * dc->width_internal + x0,
							img->body + (cy * FONT_HEIGHT + y) * img->width_internal + x0,
							w * sizeof(U32));
			}
			else
				cx++;
		}
	}
}

U0 DEWallpaperLoad(U8 *filename)
{//Image wallpaper, scaled to screen if needed. Procedural gradient fallback
//derived from the accent hue.
	CDC *png = DEImageRead(filename), *old = de.wallpaper;
	I64  x, y, top, bot, r, g, b;
	U32 *dst;

	if (filename && filename != de.wallpaper_path)
	{
		StrCopy(de.wallpaper_path, filename);
		de.wallpaper_path[255] = 0;
	}

	if (png)
	{//Always route through the scaler (1:1 = copy) so the final DC lives on the
	//system heap; callers may be short-lived app tasks.
		de.wallpaper = DEDCScaleNew(png, GR_WIDTH, GR_HEIGHT, sys_task);
		DCDel(png);
	}
	else
	{
		//DEColorLerp is defined further down and the compiler is single pass,
		//so the blend is spelled out here.
		//Both endpoints stay on the accent hue; the ramp is saturation and value
		//only.
		top = DEHue2RGB(de_theme.hue, 220, 24) & 0xFFFFFF;
		bot = DEHue2RGB(de_theme.hue, 165, 120) & 0xFFFFFF;
		de.wallpaper = DCNew(GR_WIDTH, GR_HEIGHT, sys_task);
		for (y = 0; y < GR_HEIGHT; y++)
		{
			r = (top >> 16 & 0xFF) + ((bot >> 16 & 0xFF) - (top >> 16 & 0xFF)) * y / GR_HEIGHT;
			g = (top >> 8 & 0xFF)  + ((bot >> 8 & 0xFF)  - (top >> 8 & 0xFF))  * y / GR_HEIGHT;
			b = (top & 0xFF)       + ((bot & 0xFF)       - (top & 0xFF))       * y / GR_HEIGHT;
			dst = de.wallpaper->body + y * de.wallpaper->width_internal;
			for (x = 0; x < GR_WIDTH; x++)
				dst[x] = r << 16 | g << 8 | b;
		}
		de.wallpaper->flags |= DCF_NO_TRANSPARENTS;
	}
	de.wallpaper->flags |= DCF_NO_TRANSPARENTS;
	gr.translucent_bg = de.wallpaper; //Blend base for translucent windows.
	if (old)
	{
		Sleep(50); //Let any in-flight compositor frame drop the old pointer.
		DCDel(old);
	}
}
