//YDE settings file. Plain key=value text the user can hand-edit; reloaded
//at the end of DEStart so it overrides the built-in defaults.

#define DE_CFG_DIR		"::/Home/Config"
#define DE_CFG_PATH		"::/Home/Config/YDE.CFG"

U0 DEConfigSave()
{//Called after any settings change.
	U8 *buf;

	if (!de.on || !DriveIsWritable)
		return;
	DirMake(DE_CFG_DIR);
	buf = MStrPrint(
		"# YDE desktop settings - edit freely, reloaded on boot.\n"
		"hue %d\n"
		"hue2 %d\n"
		"chrome %d\n"
		"flatmenu %d\n"
		"glass %d\n"
		"glassa %d\n"
		"glassblur %d\n"
		"syslog %d\n"
		"volume %d\n"
		"muted %d\n"
		"saver %d\n"
		"stats %d\n"
		"saverm %d\n"
		"font %d\n"
		"wallpaper %s\n",
		de_theme.hue,
		de_theme.hue2,
		gr.tc_chrome != 0,
		gr.tc_flat_menu != 0,
		de.glass != 0,
		de.glass_alpha,
		de.glass_blur,
		Bt(&sys_task->display_flags, DISPLAYf_SHOW) != 0,
		audio_volume,
		de.muted != 0,
		de.saver_on != 0,
		de.stats_enable != 0,
		de.saver_mins,
		de.font_h,
		de.wallpaper_path);
	FileWrite(DE_CFG_PATH, buf, StrLen(buf));
	Free(buf);
}

I64 DEConfigValI64(U8 *body, U8 *key, I64 default)
{//Read "key <int>" from the config text; default if missing.
	U8	*p = StrFind(key, body);
	I64	 klen = StrLen(key);

	while (p)
	{//Match only at line start followed by whitespace (avoid substring hits).
		if ((p == body || p[-1] == '\n') && (p[klen] == ' ' || p[klen] == '\t'))
			return Str2I64(p + klen + 1);
		p = StrFind(key, p + 1);
	}

	return default;
}

U0 DEConfigValStr(U8 *body, U8 *key, U8 *out, I64 out_sz)
{//Read "key <rest-of-line>" into out; out untouched if missing.
	U8	*p = StrFind(key, body), *e;
	I64	 klen = StrLen(key), n;

	while (p)
	{
		if ((p == body || p[-1] == '\n') && (p[klen] == ' ' || p[klen] == '\t'))
		{
			p += klen + 1;
			e = p;
			while (*e && *e != '\r' && *e != '\n')
				e++;
			n = e - p;
			if (n > out_sz - 1)
				n = out_sz - 1;
			MemCopy(out, p, n);
			out[n] = 0;
			return;
		}
		p = StrFind(key, p + 1);
	}
}

Bool DEConfigLoad()
{//Apply saved settings from DE_CFG_PATH. Returns TRUE if a config existed.
//Called near the end of DEStart, so it overrides the built-in defaults.
	I64	 size, hue, vol;
	U8	*body = FileRead(DE_CFG_PATH, &size);
	U8	 wall[256];

	if (!body)
		return FALSE;

	hue = DEConfigValI64(body, "hue", de_theme.hue);
	DEThemeAccentSet(hue);
	DEThemeAccent2Set(DEConfigValI64(body, "hue2", de_theme.hue2));

	if (DEConfigValI64(body, "chrome", 1))
		GuiChromeTrueColor(de_theme.accent, ColorRGB(0x0A, 0x10, 0x1A), de_theme.accent_dim);
	else
		GuiChromePalette;

	GuiMenuBarModern(DEConfigValI64(body, "flatmenu", 0) != 0);

	de.glass = DEConfigValI64(body, "glass", 0) != 0;
	de.glass_alpha = ClampI64(DEConfigValI64(body, "glassa", DE_GLASS_ALPHA_DEFAULT),
							  40, 255);
	de.glass_blur = ClampI64(DEConfigValI64(body, "glassblur", 0), 0, 32);
	GlassBlur(de.glass_blur);
	if (!de.glass)
		WinOpaque;

	DESysLogShow(DEConfigValI64(body, "syslog", 0) != 0);
	de.stats_enable = DEConfigValI64(body, "stats", 1) != 0;

	vol = DEConfigValI64(body, "volume", audio_volume);
	de.muted = DEConfigValI64(body, "muted", 0) != 0;
	if (de.muted)
	{
		de.saved_vol = vol;
		AudioMasterVolumeSet(0);
	}
	else
		AudioMasterVolumeSet(vol);

	//Saver defaults match DEStart's: on, 15 minutes. Configs written before
	//these keys existed inherit the default rather than off.
	//Applied at boot by StartOS.ZC, before the cell size is frozen; a change
	//here needs a reboot.
	de.font_h = DEConfigValI64(body, "font", KFONT_HEIGHT);
	de.saver_mins = DEConfigValI64(body, "saverm", DE_SAVER_MINS_DEFAULT);
	if (de.saver_mins < 1)
		de.saver_mins = 1;
	de.saver_on = DEConfigValI64(body, "saver", 1) != 0;
	if (de.saver_on)
		YDESaverOn(de.saver_mins * 60);	//re-arm the watcher on boot

	wall[0] = 0;
	DEConfigValStr(body, "wallpaper", wall, sizeof(wall));
	if (wall[0] && StrCompare(wall, de.wallpaper_path))
		DEWallpaperLoad(wall);

	Free(body);
	return TRUE;
}
