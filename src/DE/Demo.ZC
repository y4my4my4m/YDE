//YDE Demo - "DIVINE INTELLECT". A demoscene-style intro for YDE, the Y Desktop
//Environment for ZealOS, and the engine behind the optional screen saver.
//Two acts: a clean vector intro, then a japanese-cyberpunk glitch act.
//
//Run it:      YDEDemo;            (any key / mouse move exits)
//Screensaver: YDESaverOn(120);    (idle seconds; YDESaverOff to stop)
//
//HOW IT DRAWS
//Like ::/DE/Splash.ZC, this paints through gr.fp_final_screen_update - a hook
//the Window Manager calls with the finished frame, so we cover everything
//without fighting z-order or hiding windows.
//
//The hook must stay cheap (it runs on the WinMgr's frame path), so it only
//blits. All rendering happens in a separate task into yd_buf, an offscreen
//U32 buffer at HALF screen resolution, upscaled 2x on blit. Half res is both
//the speed budget (a full-screen phosphor-decay pass at 1280x720 is 921K
//pixels every frame) and the look - chunky pixels are the point.
//
//Everything is drawn with YDAdd(), a saturating ADDITIVE blend straight into
//dc->body (U32 0x00RRGGBB, truecolor tree). Additive is what makes the rest
//work: overlapping thin lines bloom to white, and the three chromatic-
//aberration passes recombine to white only where they align.
//
//CHROMATIC ABERRATION is real, not a post-filter: each frame projects the
//mesh three times at slightly different focal lengths - red wide, green
//nominal, blue narrow - each drawn into its own colour channel. Geometry near
//the centre lands on itself and reads white; toward the edges the channels
//separate into red/cyan fringes, exactly like a cheap lens. Cost is 3x the
//line drawing, which is why the meshes stay low-poly.
//
//PHOSPHOR DECAY: the buffer is never cleared, only scaled by 3/4 each frame
//(two shifts, no divide), so every moving vertex drags a fading trail.

#define YD_W			(GR_WIDTH / 2)		//offscreen buffer is half-res,
#define YD_H			(GR_HEIGHT / 2)		//blitted 2x - see YDOverlay
#define YD_MAXV			512
#define YD_MAXE			1200
#define YD_STARS		220
#define YD_SCENES		5	//act one: clean vector
#define YD_GSCENES		4	//act two: glitch cyberpunk
#define YD_SCENE_SECS	11.0

U32	 *yd_buf	= NULL;		//YD_W * YD_H offscreen, 0x00RRGGBB
U32	 *yd_row	= NULL;		//one upscaled destination row (2 * YD_W)
Bool  yd_up		= FALSE;	//overlay installed
Bool  yd_stop	= FALSE;	//ask the render task to wind down
Bool  yd_saver_on	= FALSE;
I64	  yd_saver_secs	= 120;
U0	(*yd_old_hook)(CDC *dc) = NULL;

//Mesh: plain global arrays rather than a class, so nothing large lands on a
//task stack. Rebuilt in place whenever the scene changes.
F64 yd_vx[YD_MAXV], yd_vy[YD_MAXV], yd_vz[YD_MAXV];	//model space
F64 yd_rx[YD_MAXV], yd_ry[YD_MAXV], yd_rz[YD_MAXV];	//after rotation
I16 yd_ea[YD_MAXE], yd_eb[YD_MAXE];
I64 yd_px[YD_MAXV], yd_py[YD_MAXV];		//projected screen coords, per pass
Bool yd_ok[YD_MAXV];					//vertex survived the near-plane clip
I64 yd_nv = 0, yd_ne = 0;
I64 yd_mesh_id = -1;	//which mesh is currently built

F64 yd_sx[YD_STARS], yd_sy[YD_STARS], yd_sz[YD_STARS];

U32 *yd_tmp = NULL;		//one scratch row for the glitch pass. Deliberately NOT
						//yd_row: that one belongs to the WinMgr blit thread.
I64	 yd_frame = 0;
Bool yd_glitching = FALSE;	//act two: apply YDGlitch after the scene draws

//Katakana, 8x8, one U64 per glyph, bit (py * 8 + px) - the same packing as
//text.font, so YDKata is YDText with a different table. These were BAKED from
//this tree's own ::/System/Gr/CJK.TTF (Sawarabi, OFL) at 11px and hand-checked
//for legibility at 8x8, not hand-drawn.
#define YD_KATA_N	46
U64 yd_kata[YD_KATA_N] = {
	0x03040408386840FF, 0x080808080B0C1060, 0x0C30204141C1FF08, 0x00FF080808087F00,
	0x21262C3830FF2020, 0xC386848C88FF0808, 0x0808087FC8087F08, 0x0618102061427E04,
	0x060810302123FE04, 0x407F404040407F00, 0x1830222222FF2222, 0x0718302042C10007,
	0xC16334181020203F, 0xFC04042445BFE404, 0x0618302042434180, 0x020C1830794742FC,
	0x07040808FF08081F, 0x071830204049CD04, 0x0204080808FF007F, 0x020202623E060202,
	0x0304080808FF0808, 0x00FF000000007F00, 0x034638182C22407F, 0x0888CB3E18207F08,
	0x0306081810202060, 0x0080406121223212, 0x7E010101073D6101, 0x030E18306040407F,
	0x00804020311A0C00, 0x0C88C9494B08FF08, 0x003010081E2360C0, 0x780700300F00300F,
	0xC37F422206040408, 0x03C64C3818362020, 0x0078040404FF0404, 0x080404244447FA02,
	0x00FF10302020203F, 0x407F4040407F4040, 0x0C3020407F00003F, 0x1C30604242424242,
	0x3051939292121212, 0x0719214101010101, 0x417F41414141417F, 0x000C306040818181,
	0x00061830207F4040, 0x070C102060408201};

#define YD_COLS		(YD_W / 8)
F64 yd_rain_y[YD_COLS];		//head position, in cells
F64 yd_rain_sp[YD_COLS];	//fall speed
I64 yd_rain_hue[YD_COLS];	//0 cyan, 1 magenta, 2 white-hot

/* ---------------- pixel layer ---------------- */

U0 YDAdd(I64 x, I64 y, I64 r, I64 g, I64 b)
{//Saturating additive blend of one pixel. Clipped.
	U32 *p;
	I64	 c, nr, ng, nb;

	if (x < 0 || y < 0 || x >= YD_W || y >= YD_H)
		return;
	p  = yd_buf + y * YD_W + x;
	c  = *p;
	nr = (c >> 16 & 0xFF) + r;
	ng = (c >> 8 & 0xFF) + g;
	nb = (c & 0xFF) + b;
	if (nr > 255)
		nr = 255;
	if (ng > 255)
		ng = 255;
	if (nb > 255)
		nb = 255;
	*p = (nr << 16) + (ng << 8) + nb;	//parenthesised: << binds looser than +
}

U0 YDFade()
{//Phosphor decay: buf *= 3/4 via two masked shifts, no divide, no clear.
	I64	 i, n = YD_W * YD_H;
	U32	 c;

	for (i = 0; i < n; i++)
	{
		c = yd_buf[i];
		if (c)
			yd_buf[i] = (c >> 1 & 0x7F7F7F) + (c >> 2 & 0x3F3F3F);
	}
}

U0 YDLine(I64 x1, I64 y1, I64 x2, I64 y2, I64 r, I64 g, I64 b)
{//Additive Bresenham. Bails on absurd spans so a vertex behind the camera
//cannot turn into a million-pixel scanline.
	I64 dx, dy, sx, sy, err, e2;

	dx = x2 - x1;
	if (dx < 0)
		dx = -dx;
	dy = y2 - y1;
	if (dy < 0)
		dy = -dy;
	if (dx > 4 * YD_W || dy > 4 * YD_H)
		return;
	sx = -1;
	if (x1 < x2)
		sx = 1;
	sy = -1;
	if (y1 < y2)
		sy = 1;
	err = dx - dy;
	while (TRUE)
	{
		YDAdd(x1, y1, r, g, b);
		if (x1 == x2 && y1 == y2)
			break;
		e2 = 2 * err;
		if (e2 > -dy)
		{
			err -= dy;
			x1 += sx;
		}
		if (e2 < dx)
		{
			err += dx;
			y1 += sy;
		}
	}
}

U0 YDText(I64 x, I64 y, U8 *st, I64 sc, I64 r, I64 g, I64 b)
{//System-font text, pixel-upscaled by sc, drawn additively.
	I64 i, px, py, qx, qy;
	U64 bits;

	for (i = 0; st[i]; i++)
	{
		bits = text.font[st[i]];
		for (py = 0; py < FONT_HEIGHT; py++)
			for (px = 0; px < FONT_WIDTH; px++)
				if (bits >> (py * 8 + px) & 1)
					for (qy = 0; qy < sc; qy++)
						for (qx = 0; qx < sc; qx++)
							YDAdd(x + (i * FONT_WIDTH + px) * sc + qx,
								  y + py * sc + qy, r, g, b);
	}
}

U0 YDKata(I64 x, I64 y, I64 gi, I64 sc, I64 r, I64 g, I64 b)
{//One katakana glyph from yd_kata, same bit packing as the system font.
	I64 px, py, qx, qy;
	U64 bits;

	if (gi < 0)
		gi = -gi;
	bits = yd_kata[gi % YD_KATA_N];
	for (py = 0; py < 8; py++)
		for (px = 0; px < 8; px++)
			if (bits >> (py * 8 + px) & 1)
				for (qy = 0; qy < sc; qy++)
					for (qx = 0; qx < sc; qx++)
						YDAdd(x + px * sc + qx, y + py * sc + qy, r, g, b);
}

U0 YDTextCA(I64 cx, I64 y, U8 *st, I64 sc, I64 amt)
{//Centred text with the same red/blue split as the geometry.
	I64 w = StrLen(st) * FONT_WIDTH * sc, x = cx - w / 2;

	YDText(x - amt, y, st, sc, 200, 0, 0);
	YDText(x + amt, y, st, sc, 0, 0, 200);
	YDText(x, y, st, sc, 90, 200, 130);
}

/* ---------------- act 2: glitch ---------------- */

U0 YDGlitch(I64 amount)
{//Datamosh pass, run over the finished frame in act 2 only.
//Three cheap artefacts: horizontal slice displacement (the "torn VHS" look),
//a red/blue channel tear on one band, and scanline darkening.
	I64 k, y, x, sx, y0, h, dx;
	U32 *row;

	if (!yd_tmp)
		return;

	//1. slice displacement - `amount` independent torn bands
	for (k = 0; k < amount; k++)
	{
		y0 = RandU16 % YD_H;
		h  = 3 + RandU16 % 18;
		dx = RandU16 % 61 - 30;
		if (y0 + h > YD_H)
			h = YD_H - y0;
		for (y = y0; y < y0 + h; y++)
		{
			row = yd_buf + y * YD_W;
			MemCopy(yd_tmp, row, YD_W * sizeof(U32));
			for (x = 0; x < YD_W; x++)
			{//wrap, so a torn slice reads as displaced signal, not black
				sx = x - dx;
				while (sx < 0)
					sx += YD_W;
				row[x] = yd_tmp[sx % YD_W];
			}
		}
	}

	//2. channel tear: shift only the red component of one band
	y0 = RandU16 % YD_H;
	h  = 2 + RandU16 % 10;
	dx = RandU16 % 17 - 8;
	if (y0 + h > YD_H)
		h = YD_H - y0;
	for (y = y0; y < y0 + h; y++)
	{
		row = yd_buf + y * YD_W;
		MemCopy(yd_tmp, row, YD_W * sizeof(U32));
		for (x = 0; x < YD_W; x++)
		{
			sx = x - dx;
			while (sx < 0)
				sx += YD_W;
			row[x] = (row[x] & 0x00FFFF) + (yd_tmp[sx % YD_W] & 0xFF0000);
		}
	}

	//3. scanlines
	for (y = 1; y < YD_H; y += 2)
	{
		row = yd_buf + y * YD_W;
		for (x = 0; x < YD_W; x++)
			row[x] = (row[x] >> 1 & 0x7F7F7F) + (row[x] >> 2 & 0x3F3F3F);
	}
}

U0 YDRainInit()
{
	I64 i;

	for (i = 0; i < YD_COLS; i++)
	{
		yd_rain_y[i]  = ToF64(RandU16 % (YD_H / 8)) - ToF64(YD_H / 8);
		yd_rain_sp[i] = 8.0 + ToF64(RandU16 % 26);
		yd_rain_hue[i] = RandU16 % 10;
	}
}

U0 YDRain(F64 dt, I64 tail)
{//Katakana downpour. Head is white-hot, tail fades cyan (or magenta on a few
//columns) - the CRT bloom comes free from the additive blend.
	I64 i, k, row, gi, v, r, g, b;

	for (i = 0; i < YD_COLS; i++)
	{
		yd_rain_y[i] += dt * yd_rain_sp[i];
		if (yd_rain_y[i] > ToF64(YD_H / 8 + tail))
		{
			yd_rain_y[i]   = -ToF64(RandU16 % 20);
			yd_rain_sp[i]  = 8.0 + ToF64(RandU16 % 26);
			yd_rain_hue[i] = RandU16 % 10;
		}
		for (k = 0; k < tail; k++)
		{
			row = ToI64(yd_rain_y[i]) - k;
			if (0 <= row < YD_H / 8)
			{//on-screen cells only (ZealC has no `continue`)
				v = 210 - k * 210 / tail;
				if (v < 0)
					v = 0;
				//glyph churns over time: a static column reads as a decal
				gi = i * 7 + row * 13 + yd_frame / 5;
				if (!k)
				{
					r = 200;
					g = 255;
					b = 230;	//white-hot head
				}
				else if (!yd_rain_hue[i])
				{
					r = v * 3 / 4;
					g = v / 5;
					b = v;		//magenta column
				}
				else
				{
					r = v / 6;
					g = v;
					b = v * 4 / 5;	//cyan-green
				}
				YDKata(i * 8, row * 8, gi, 1, r, g, b);
			}
		}
	}
}

/* ---------------- mesh builders ---------------- */

U0 YDEdgeAdd(I64 a, I64 b)
{
	if (yd_ne >= YD_MAXE)
		return;
	yd_ea[yd_ne] = a;
	yd_eb[yd_ne] = b;
	yd_ne++;
}

U0 YDEdgesByLen(F64 target)
{//Connect every vertex pair whose separation is ~target. Cheaper to write and
//far less error-prone than transcribing an edge table for a solid.
	I64 i, j;
	F64 dx, dy, dz, d2, lo = target * target * 0.85, hi = target * target * 1.15;

	yd_ne = 0;
	for (i = 0; i < yd_nv; i++)
		for (j = i + 1; j < yd_nv; j++)
		{
			dx = yd_vx[i] - yd_vx[j];
			dy = yd_vy[i] - yd_vy[j];
			dz = yd_vz[i] - yd_vz[j];
			d2 = dx * dx + dy * dy + dz * dz;
			if (lo < d2 < hi)
				YDEdgeAdd(i, j);
		}
}

U0 YDVert(F64 x, F64 y, F64 z)
{
	if (yd_nv >= YD_MAXV)
		return;
	yd_vx[yd_nv] = x;
	yd_vy[yd_nv] = y;
	yd_vz[yd_nv] = z;
	yd_nv++;
}

U0 YDMeshCube()
{//F64 loop vars throughout: YDVert takes F64, and an implicit I64->F64 at a
//call site is exactly the class of silent no-op this tree has been bitten by.
	F64 i, j, k;

	yd_nv = 0;
	for (i = -1.0; i <= 1.0; i += 2.0)
		for (j = -1.0; j <= 1.0; j += 2.0)
			for (k = -1.0; k <= 1.0; k += 2.0)
				YDVert(i, j, k);
	YDEdgesByLen(2.0);
}

U0 YDMeshIco()
{//Icosahedron: (0, +-1, +-p) and its two cyclic permutations. Edge length 2.
	F64 p = 1.6180339887;
	F64 a, b;

	yd_nv = 0;
	for (a = -1.0; a <= 1.0; a += 2.0)
		for (b = -1.0; b <= 1.0; b += 2.0)
		{
			YDVert(0.0, a, b * p);
			YDVert(a, b * p, 0.0);
			YDVert(b * p, 0.0, a);
		}
	YDEdgesByLen(2.0);
}

U0 YDMeshTorus()
{
	I64 nu = 20, nv = 10, i, j;
	F64 R = 1.5, r = 0.55, u, v, cu, su, cv, sv;

	yd_nv = 0;
	yd_ne = 0;
	for (i = 0; i < nu; i++)
		for (j = 0; j < nv; j++)
		{
			u  = 2 * pi * ToF64(i) / ToF64(nu);
			v  = 2 * pi * ToF64(j) / ToF64(nv);
			cu = Cos(u);
			su = Sin(u);
			cv = Cos(v);
			sv = Sin(v);
			YDVert((R + r * cv) * cu, (R + r * cv) * su, r * sv);
		}
	for (i = 0; i < nu; i++)
		for (j = 0; j < nv; j++)
		{//ring-to-ring and around-the-ring, both wrapping
			YDEdgeAdd(i * nv + j, ((i + 1) % nu) * nv + j);
			YDEdgeAdd(i * nv + j, i * nv + (j + 1) % nv);
		}
}

U0 YDMeshGrid(F64 phase)
{//Sine terrain. Rebuilt every frame so it undulates - it is only ~380 verts.
	I64 nx = 22, nz = 16, i, j;
	F64 x, z;

	yd_nv = 0;
	yd_ne = 0;
	for (j = 0; j < nz; j++)
		for (i = 0; i < nx; i++)
		{
			x = ToF64(i - nx / 2) * 0.34;
			z = ToF64(j - nz / 2) * 0.42;
			YDVert(x, 0.55 * Sin(x * 1.6 + phase) * Cos(z * 1.2 - phase * 0.7) - 0.7, z);
		}
	for (j = 0; j < nz; j++)
		for (i = 0; i < nx; i++)
		{
			if (i + 1 < nx)
				YDEdgeAdd(j * nx + i, j * nx + i + 1);
			if (j + 1 < nz)
				YDEdgeAdd(j * nx + i, (j + 1) * nx + i);
		}
}

U0 YDBox(F64 x0, F64 y0, F64 z0, F64 x1, F64 y1, F64 z1)
{//Axis-aligned wireframe box appended to the current mesh: 8 verts, 12 edges.
	I64 b = yd_nv;

	YDVert(x0, y0, z0);	YDVert(x1, y0, z0);
	YDVert(x1, y1, z0);	YDVert(x0, y1, z0);
	YDVert(x0, y0, z1);	YDVert(x1, y0, z1);
	YDVert(x1, y1, z1);	YDVert(x0, y1, z1);
	if (yd_nv != b + 8)
		return;	//pool ran out mid-box; do not emit dangling edges
	YDEdgeAdd(b + 0, b + 1);	YDEdgeAdd(b + 1, b + 2);
	YDEdgeAdd(b + 2, b + 3);	YDEdgeAdd(b + 3, b + 0);
	YDEdgeAdd(b + 4, b + 5);	YDEdgeAdd(b + 5, b + 6);
	YDEdgeAdd(b + 6, b + 7);	YDEdgeAdd(b + 7, b + 4);
	YDEdgeAdd(b + 0, b + 4);	YDEdgeAdd(b + 1, b + 5);
	YDEdgeAdd(b + 2, b + 6);	YDEdgeAdd(b + 3, b + 7);
}

U0 YDMeshTorii()
{//Torii gate. Y is DOWN in this pipeline, so the roof is negative Y.
	yd_nv = 0;
	yd_ne = 0;
	YDBox(-1.30, -1.05, -0.10,  -1.02,  1.30, 0.10);	//left pillar
	YDBox( 1.02, -1.05, -0.10,   1.30,  1.30, 0.10);	//right pillar
	YDBox(-1.75, -1.32, -0.16,   1.75, -1.05, 0.16);	//kasagi (top beam)
	YDBox(-1.45, -0.62, -0.12,   1.45, -0.44, 0.12);	//nuki (lower beam)
	YDBox(-0.10, -1.05, -0.10,   0.10, -0.62, 0.10);	//gakuzuka (centre post)
}

I64 yd_city_seed = 12345;

I64 YDRnd()
{//Deterministic LCG: the skyline must be stable frame to frame, and RandU16
//would reshuffle every building on every rebuild.
	yd_city_seed = (yd_city_seed * 1103515245 + 12345) & 0x7FFFFFFF;
	return yd_city_seed >> 8;
}

#define YD_CITY_SPAN	18.0
#define YD_GROUND		1.30	//Y is down: this is the street plane

U0 YDMeshCity(F64 phase)
{//Neon skyline scrolling toward the camera, over a synthwave ground grid.
//Rebuilt per frame, so the depth wrap is just arithmetic on `phase` - there is
//no per-building state to keep.
	I64 i, n = 18, b;
	F64 x, z, h, w, gz;

	yd_nv = 0;
	yd_ne = 0;
	yd_city_seed = 987654321;	//reseed: identical skyline every frame

	//ground grid: rails running away from us...
	for (i = -4; i <= 4; i++)
	{
		b = yd_nv;
		YDVert(ToF64(i) * 1.5, YD_GROUND, 0.5);
		YDVert(ToF64(i) * 1.5, YD_GROUND, YD_CITY_SPAN);
		YDEdgeAdd(b, b + 1);
	}
	//...and rungs sliding toward us, so the ground reads as motion
	for (i = 0; i < 12; i++)
	{
		gz = ToF64(i) * 1.5 - phase;
		while (gz < 0.5)
			gz += 18.0;
		b = yd_nv;
		YDVert(-6.0, YD_GROUND, gz);
		YDVert(6.0, YD_GROUND, gz);
		YDEdgeAdd(b, b + 1);
	}

	for (i = 0; i < n; i++)
	{
		x = ToF64(YDRnd() % 1000) / 1000.0 * 11.0 - 5.5;
		if (-1.1 < x < 1.1)
			x += 2.2;	//keep a corridor down the middle to fly through
		h = 0.9 + ToF64(YDRnd() % 1000) / 1000.0 * 3.0;
		w = 0.18 + ToF64(YDRnd() % 1000) / 1000.0 * 0.28;
		z = ToF64(YDRnd() % 1000) / 1000.0 * YD_CITY_SPAN;
		z = z - phase;
		while (z < 0.5)
			z += YD_CITY_SPAN;	//recycle behind the far plane
		YDBox(x - w, YD_GROUND - h, z - w, x + w, YD_GROUND, z + w);
	}
}

/* ---------------- 3D ---------------- */

U0 YDRotate(F64 ax, F64 ay, F64 az)
{
	I64 i;
	F64 sa = Sin(ax), ca = Cos(ax);
	F64 sb = Sin(ay), cb = Cos(ay);
	F64 sc = Sin(az), cc = Cos(az);
	F64 x, y, z, x1, y1, z1;

	for (i = 0; i < yd_nv; i++)
	{
		x = yd_vx[i];
		y = yd_vy[i];
		z = yd_vz[i];
		y1 = y * ca - z * sa;	//X
		z1 = y * sa + z * ca;
		x1 = x * cb + z1 * sb;	//Y
		z  = z1 * cb - x * sb;
		x  = x1 * cc - y1 * sc;	//Z
		y  = x1 * sc + y1 * cc;
		yd_rx[i] = x;
		yd_ry[i] = y;
		yd_rz[i] = z;
	}
}

U0 YDDrawChan(F64 dist, F64 focal, I64 r, I64 g, I64 b)
{//Perspective-project the rotated mesh at one focal length and stroke its
//edges into one colour channel. Called three times per frame with slightly
//different focals - that difference IS the chromatic aberration.
	I64 i, a, e, x1, y1, x2, y2;
	F64 z, cx = YD_W / 2, cy = YD_H / 2;
	//px/py/ok are globals, not locals: 512 verts would put ~9K on a task
	//stack, three times per frame.

	for (i = 0; i < yd_nv; i++)
	{
		z = yd_rz[i] + dist;
		if (z < 0.25)
		{
			yd_ok[i] = FALSE;
			yd_px[i] = 0;
			yd_py[i] = 0;
		}
		else
		{
			yd_ok[i] = TRUE;
			yd_px[i] = ToI64(cx + yd_rx[i] * focal / z);
			yd_py[i] = ToI64(cy + yd_ry[i] * focal / z);
		}
	}
	for (e = 0; e < yd_ne; e++)
	{
		i = yd_ea[e];
		a = yd_eb[e];
		if (yd_ok[i] && yd_ok[a])
		{//ZealC has no `continue` - invert the guard instead
			x1 = yd_px[i];
			y1 = yd_py[i];
			x2 = yd_px[a];
			y2 = yd_py[a];
			YDLine(x1, y1, x2, y2, r, g, b);
		}
	}
}

U0 YDDrawCA(F64 dist, F64 focal, F64 amt, I64 bright)
{//Three passes, one per channel, focal spread by amt.
	YDDrawChan(dist, focal * (1.0 + amt), bright, 0, 0);
	YDDrawChan(dist, focal, 0, bright, 0);
	YDDrawChan(dist, focal * (1.0 - amt), 0, 0, bright);
}

/* ---------------- starfield ---------------- */

U0 YDStarsInit()
{
	I64 i;

	for (i = 0; i < YD_STARS; i++)
	{
		yd_sx[i] = ToF64(RandU16 % 4000) / 1000.0 - 2.0;
		yd_sy[i] = ToF64(RandU16 % 4000) / 1000.0 - 2.0;
		yd_sz[i] = ToF64(RandU16 % 6000) / 1000.0 + 0.2;
	}
}

U0 YDStars(F64 dt, F64 speed)
{//Classic receding starfield; nearer stars are brighter and streak more.
	I64 i, x, y, x2, y2, v;
	F64 z, cx = YD_W / 2, cy = YD_H / 2, f = 260.0;

	for (i = 0; i < YD_STARS; i++)
	{
		yd_sz[i] -= dt * speed;
		if (yd_sz[i] < 0.2)
		{
			yd_sx[i] = ToF64(RandU16 % 4000) / 1000.0 - 2.0;
			yd_sy[i] = ToF64(RandU16 % 4000) / 1000.0 - 2.0;
			yd_sz[i] = 6.0;
		}
		z = yd_sz[i];
		x = ToI64(cx + yd_sx[i] * f / z);
		y = ToI64(cy + yd_sy[i] * f / z);
		v = ToI64(200.0 / (z + 0.4));
		if (v > 200)
			v = 200;
		if (v < 12)
			v = 12;
		//short streak toward the vanishing point = motion blur for free
		x2 = ToI64(cx + yd_sx[i] * f / (z + dt * speed));
		y2 = ToI64(cy + yd_sy[i] * f / (z + dt * speed));
		YDLine(x, y, x2, y2, v * 3 / 4, v * 4 / 5, v);
	}
}

/* ---------------- scroller ---------------- */

U8 *yd_scroll_msg =
	"YDE  -  THE Y DESKTOP ENVIRONMENT FOR ZEALOS  ...  WRITTEN IN PURE ZEALC: "
	"NO ELF, NO FFI, NO LIBC, RING 0 ALL THE WAY DOWN  ...  TRUECOLOR "
	"FRAMEBUFFER, A WEB BROWSER WITH ITS OWN JAVASCRIPT ENGINE, AND A COMPILER "
	"THAT REBUILDS THE WHOLE SYSTEM AT EVERY BOOT  ...  IN MEMORY OF TERRY A. "
	"DAVIS, 1969-2018, WHO WROTE AN ENTIRE OPERATING SYSTEM BY HIMSELF AND "
	"CALLED IT A TEMPLE  ...  AN IDIOT ADMIRES COMPLEXITY, A GENIUS ADMIRES "
	"SIMPLICITY  ...  GREETINGS TO EVERYONE STILL WRITING THEIR OWN OS IN 2026 "
	" ...  ";

U0 YDScroller(F64 t)
{//Sine-warped bottom scroller, one character at a time so each can ride its
//own point on the wave.
	I64	 n = StrLen(yd_scroll_msg), i, cw = FONT_WIDTH * 2, x, y;
	U8	 ch[2];
	F64	 base = ToF64(YD_W + 40) - t * 78.0;
	F64	 total = ToF64(n * cw + YD_W + 80);
	F64	 pos;

	ch[1] = 0;
	//Wrap the base ONCE per frame. Left to the per-character loop, an hour of
	//screen-saver uptime means base is ~ -280000 and every glyph re-adds
	//`total` dozens of times, every frame.
	while (base < -total)
		base += total;
	for (i = 0; i < n; i++)
	{
		pos = base + ToF64(i * cw);
		while (pos < ToF64(-cw))
			pos += total;	//wrap so the banner is endless
		x = ToI64(pos);
		if (-cw <= x <= YD_W)
		{//only glyphs actually on screen (ZealC has no `continue`)
			y = ToI64(ToF64(YD_H - 34) + 9.0 * Sin(t * 2.6 + ToF64(i) * 0.32));
			ch[0] = yd_scroll_msg[i];
			YDText(x, y, ch, 2, 120, 90, 30);
			YDText(x, y - 1, ch, 2, 60, 150, 200);
		}
	}
}

/* ---------------- scenes ---------------- */

Bool YDSceneVector(I64 sc, F64 t, F64 lt, F64 pulse)
{//ACT ONE: clean vector intro. Returns FALSE if sc is out of range.
	F64 amt, dist;
	I64 cx = YD_W / 2;

	switch (sc)
	{
		case 0:	//icosahedron, gentle
			if (yd_mesh_id != 0)
			{
				YDMeshIco;
				yd_mesh_id = 0;
			}
			YDRotate(t * 0.5, t * 0.73, t * 0.21);
			dist = 4.8 + 1.0 * Sin(t * 0.7);
			YDDrawCA(dist, 235.0, 0.012 + 0.010 * pulse, 150);
			YDTextCA(cx, 30, "YDE", 6, 2);
			YDTextCA(cx, 78, "DIVINE INTELLECT", 2, 1);
			break;

		case 1:	//cube, hard aberration, tumbling in close
			if (yd_mesh_id != 1)
			{
				YDMeshCube;
				yd_mesh_id = 1;
			}
			YDRotate(t * 1.1, t * 0.8, t * 0.6);
			dist = 4.2 + 1.8 * Sin(lt * 0.9);
			amt	 = 0.030 + 0.026 * pulse;
			YDDrawCA(dist, 210.0, amt, 170);
			YDTextCA(cx, 30, "ZEALC ONLY", 3, 3);
			YDTextCA(cx, 66, "NO ELF   NO FFI   NO EXCUSES", 2, 1);
			break;

		case 2:	//torus
			if (yd_mesh_id != 2)
			{
				YDMeshTorus;
				yd_mesh_id = 2;
			}
			//Fixed tilt + single-axis spin: tumbling on all three axes kept
			//catching the ring edge-on, where a torus just reads as a pill.
			YDRotate(0.65 + 0.30 * Sin(t * 0.45), t * 0.35, 0);
			dist = 4.6 + 0.7 * Sin(t * 0.55);
			YDDrawCA(dist, 250.0, 0.014 + 0.012 * pulse, 130);
			YDTextCA(cx, 30, "ZEALOS", 4, 2);
			YDTextCA(cx, 72, "COMPILES ITSELF AT EVERY BOOT", 2, 1);
			break;

		case 3:	//flying over sine terrain
			YDMeshGrid(t * 1.7);	//rebuilt per frame: it has to move
			yd_mesh_id = 3;
			YDRotate(0.62, t * 0.10, 0);
			YDDrawCA(3.4, 230.0, 0.016 + 0.014 * pulse, 120);
			YDTextCA(cx, 26, "TEMPLEOS", 4, 2);
			YDTextCA(cx, 68, "640x480  16 COLORS  BY DESIGN", 2, 1);
			break;

		case 4:	//tribute: fast spin, pulls away
			if (yd_mesh_id != 4)
			{
				YDMeshIco;
				yd_mesh_id = 4;
			}
			YDRotate(t * 1.6, t * 1.9, t * 0.9);
			dist = 4.2 + lt * 0.30;
			YDDrawCA(dist, 230.0, 0.010 + 0.030 * pulse, 160);
			YDTextCA(cx, 28, "TERRY A. DAVIS", 3, 2);
			YDTextCA(cx, 64, "1969 - 2018", 2, 1);
			YDTextCA(cx, YD_H / 2 + 96, "AN IDIOT ADMIRES COMPLEXITY", 1, 1);
			YDTextCA(cx, YD_H / 2 + 110, "A GENIUS ADMIRES SIMPLICITY", 1, 1);
			break;

		default:
			//Unreachable (sc is % YD_SCENES), but a HolyC switch throws on an
			//unmatched value and this runs unattended as a screen saver.
			return FALSE;
	}
	return TRUE;
}

U0 YDBanner(I64 cx, I64 y, I64 n, I64 seed, I64 sc)
{//A row of katakana, centred - act 2's equivalent of a title card.
	I64 i, x0 = cx - n * 8 * sc / 2;

	for (i = 0; i < n; i++)
		YDKata(x0 + i * 8 * sc, y, seed + i * 5 + yd_frame / 7, sc,
			   40, 190, 210);
}

U0 YDSceneGlitch(I64 sc, F64 t, F64 lt, F64 pulse)
{//ACT TWO: japanese cyberpunk. Same 3D pipeline, but the palette goes
//neon, katakana replaces the vector titles, and every frame gets torn up by
//YDGlitch on the way out.
	F64 dist;
	I64 cx = YD_W / 2, bright;

	switch (sc)
	{
		case 0:	//pure downpour
			YDRain(0.033, 16);
			YDBanner(cx, 22, 7, 3, 3);
			YDTextCA(cx, YD_H - 74, "ZEALOS", 3, 2);
			break;

		case 1:	//torii gate standing in the rain
			YDRain(0.033, 12);
			if (yd_mesh_id != 11)
			{
				YDMeshTorii;
				yd_mesh_id = 11;
			}
			YDRotate(0.06 * Sin(t * 0.5), 0.45 * Sin(t * 0.31), 0);
			dist = 4.6 + 0.5 * Sin(t * 0.4);
			//magenta/cyan rather than white: neon, not phosphor
			YDDrawChan(dist, 250.0 * 1.03, 220, 0, 0);
			YDDrawChan(dist, 250.0, 0, 60, 0);
			YDDrawChan(dist, 250.0 * 0.97, 0, 0, 230);
			YDBanner(cx, 20, 6, 17, 2);
			break;

		case 2:	//flying the neon skyline
			YDMeshCity(t * 2.6);
			yd_mesh_id = 12;
			YDRotate(0.10 + 0.05 * Sin(t * 0.6), 0.08 * Sin(t * 0.42), 0);
			bright = ToI64(110.0 + 60.0 * pulse);
			//Camera distance ADDS to world Z, so a large value pushes the whole
			//city to the far plane. Keep it small and let the near buildings
			//blow past the edge of frame.
			YDDrawChan(0.8, 245.0 * 1.02, bright, 0, bright / 3);
			YDDrawChan(0.8, 245.0, 0, bright / 2, bright);
			YDBanner(cx, 18, 9, 31, 2);
			YDTextCA(cx, YD_H - 76, "ELECTRIC TEMPLE", 2, 2);
			break;

		case 3:	//sign-off slab
			YDRain(0.033, 9);
			if (yd_mesh_id != 13)
			{
				YDMeshCube;
				yd_mesh_id = 13;
			}
			YDRotate(t * 0.9, t * 1.3, t * 0.5);
			dist = 3.4 + 1.2 * Sin(lt * 0.7);
			YDDrawCA(dist, 215.0, 0.045 + 0.030 * pulse, 150);
			YDBanner(cx, 16, 11, 5, 2);
			YDTextCA(cx, YD_H / 2 - 8, "YDE", 6, 3);
			YDTextCA(cx, YD_H / 2 + 40, "FOR ZEALOS", 2, 1);
			break;

		default:
			break;
	}
}

U0 YDScene(F64 t)
{//Act one runs its five scenes, then act two takes over for four, then it
//repeats. One full pass of the vector intro before the style switches, which
//is what makes the change land as a reveal rather than random.
	I64 idx = ToI64(t / YD_SCENE_SECS) % (YD_SCENES + YD_GSCENES);
	F64 lt	= t - ToF64(ToI64(t / YD_SCENE_SECS)) * YD_SCENE_SECS;
	F64 pulse = 0.5 + 0.5 * Sin(t * 3.1);	//stands in for a beat

	if (idx < YD_SCENES)
	{
		yd_glitching = FALSE;
		YDSceneVector(idx, t, lt, pulse);
	}
	else
	{
		yd_glitching = TRUE;
		YDSceneGlitch(idx - YD_SCENES, t, lt, pulse);
	}
}

/* ---------------- overlay + task ---------------- */

U0 YDOverlay(CDC *dc)
{//WinMgr frame hook: blit only, 2x nearest upscale. Each source row is
//doubled once into yd_row, then MemCopy'd to both destination rows.
	I64	 y, x, dw = YD_W * 2;
	U32	*src, *d0;

	if (yd_up && yd_buf && yd_row)
	{
		if (dw > dc->width)
			dw = dc->width;
		for (y = 0; y < YD_H; y++)
		{
			if (2 * y + 1 >= dc->height)
				break;
			src = yd_buf + y * YD_W;
			for (x = 0; x < YD_W; x++)
			{
				yd_row[2 * x]	  = src[x];
				yd_row[2 * x + 1] = src[x];
			}
			d0 = dc->body + (2 * y) * dc->width_internal;
			MemCopy(d0, yd_row, dw * sizeof(U32));
			MemCopy(d0 + dc->width_internal, yd_row, dw * sizeof(U32));
		}
	}
	if (yd_old_hook)
		(*yd_old_hook)(dc);
}

U0 YDRenderTask()
{//Owns the animation and the teardown. Exits on any key or mouse activity.
	F64	 t0 = tS, t, prev = 0, dt;
	I64	 snap = kbd.last_down_scan_code;
	I64	 mx = mouse.pos.x, my = mouse.pos.y;

	while (!yd_stop)
	{
		t  = tS - t0;
		dt = t - prev;
		if (dt > 0.15)
			dt = 0.15;	//a long stall must not teleport the starfield
		prev = t;

		YDFade;
		if (!yd_glitching)
			YDStars(dt, 1.15);	//act two has rain instead of stars
		YDScene(t);
		YDScroller(t);
		if (yd_glitching)
		{//tear up the finished frame; heavier on the beat
			YDGlitch(1 + ToI64(2.5 * (0.5 + 0.5 * Sin(t * 3.1))));
		}
		yd_frame++;

		if (t > 0.7)
		{//grace period so the keypress that launched it does not close it
			if (kbd.last_down_scan_code != snap || mouse.lb || mouse.rb ||
				mouse.pos.x != mx || mouse.pos.y != my)
				break;
		}
		Sleep(28);	//~30fps target
	}

	yd_up = FALSE;
	gr.fp_final_screen_update = yd_old_hook;
	yd_old_hook = NULL;
	Sleep(80);	//let the in-flight frame finish reading the buffer
	if (yd_buf)
	{
		Free(yd_buf);
		yd_buf = NULL;
	}
	if (yd_row)
	{
		Free(yd_row);
		yd_row = NULL;
	}
	if (yd_tmp)
	{
		Free(yd_tmp);
		yd_tmp = NULL;
	}
	yd_mesh_id = -1;
}

public U0 YDEDemo()
{//Start the demo. Returns immediately; it runs in its own task.
	if (yd_up)
		return;
	yd_buf = MAlloc(YD_W * YD_H * sizeof(U32), sys_task);
	yd_row = MAlloc(YD_W * 2 * sizeof(U32), sys_task);
	yd_tmp = MAlloc(YD_W * sizeof(U32), sys_task);
	MemSet(yd_buf, 0, YD_W * YD_H * sizeof(U32));	//globals are not zeroed
	yd_nv = 0;
	yd_ne = 0;
	yd_mesh_id = -1;
	yd_frame = 0;
	yd_glitching = FALSE;
	YDStarsInit;
	YDRainInit;

	yd_stop		= FALSE;
	yd_old_hook	= gr.fp_final_screen_update;
	yd_up		= TRUE;
	gr.fp_final_screen_update = &YDOverlay;
	Spawn(&YDRenderTask, NULL, "YDE Demo");
}

/* ---------------- screen saver ---------------- */

U0 YDESaverTask()
{//Poll for idle. Any key, button or mouse movement resets the countdown.
	I64	 snap = kbd.last_down_scan_code;
	I64	 mx = mouse.pos.x, my = mouse.pos.y;
	F64	 idle0 = tS;

	while (yd_saver_on)
	{
		if (kbd.last_down_scan_code != snap || mouse.lb || mouse.rb ||
			mouse.pos.x != mx || mouse.pos.y != my)
		{
			snap  = kbd.last_down_scan_code;
			mx	  = mouse.pos.x;
			my	  = mouse.pos.y;
			idle0 = tS;
		}
		else if (!yd_up && tS - idle0 >= ToF64(yd_saver_secs))
			YDEDemo;
		Sleep(400);
	}
}

public U0 YDESaverOn(I64 secs=120)
{//Enable the screen saver after `secs` idle seconds.
	yd_saver_secs = secs;
	if (yd_saver_on)
		return;
	yd_saver_on = TRUE;
	Spawn(&YDESaverTask, NULL, "YDE Saver");
}

public U0 YDESaverOff()
{
	yd_saver_on = FALSE;
	yd_stop		= TRUE;
}
