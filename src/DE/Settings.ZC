//YKD Settings - DE-native widget app. Run with DESettings;
//(the launcher menu does it via a terminal task). <ESC> exits.
//Display resolution: VBE is set only at real-mode boot, so Apply patches
//::/Kernel/KStart16.ZC REQUESTED_SCREEN_* then BootHDIns + Reboot.

#define DE_SETTINGS_KSTART		"::/Kernel/KStart16.ZC"
#define DE_SETTINGS_BOOT_IN		"\n\nScale2Mem(0x80000,0x8000000)\nMountAHCIAuto\nCT\n\n"

//StartOS.ZC compiles ::/DE/MakeDE ahead of ~/MakeHome, and BootHDIns arrives
//with MakeHome's /System/Boot/MakeBoot, so the symbol does not exist at
//DE-compile time. Forward-declared as /System/Externs.ZC does; the address is
//patched when Boot compiles.
extern U0 BootHDIns(U8 drv_let=0);

Bool		 de_settings_done;
Bool		 de_settings_apply;
Bool		 de_settings_picked;
I64			 de_settings_pick_w;
I64			 de_settings_pick_h;
CDEWidget	*de_settings_res_lbl;
CDEWidget	*de_settings_saver_lbl;
I64			 de_settings_modes_w[VBE_MODES_NUM];
I64			 de_settings_modes_h[VBE_MODES_NUM];

U0 DESettingsHue(CDEWidget *wg)
{
	DEThemeAccentSet(wg->val);
	de.cfg_dirty = TRUE;
}

U0 DESettingsHue2(CDEWidget *wg)
{
	DEThemeAccent2Set(wg->val);
	de.cfg_dirty = TRUE;
}

U0 DESettingsChrome(CDEWidget *wg)
{
	if (wg->checked)
		GuiChromeTrueColor(de_theme.accent, ColorRGB(0x0A, 0x10, 0x1A), de_theme.accent_dim);
	else
		GuiChromePalette;
	de.cfg_dirty = TRUE;
}

U0 DESettingsMenuBar(CDEWidget *wg)
{
	GuiMenuBarModern(wg->checked);
	de.cfg_dirty = TRUE;
}

U0 DESettingsGlass(CDEWidget *wg)
{
	de.glass = wg->checked;
	if (!wg->checked)
		WinOpaque;
	de.cfg_dirty = TRUE;
}

U0 DESettingsGlassBlur(CDEWidget *wg)
{//Frosted glass. Radius is free: the blur uses running sums, so 4 costs the
//same as 32. See the numbers in GrScreen.ZC.
	de.glass_blur = wg->val;
	GlassBlur(de.glass_blur);
	de.cfg_dirty = TRUE;
}

U0 DESettingsGlassAlpha(CDEWidget *wg)
{//Live: the compositor reads gr.translucent_alpha every frame, so pushing it
//here shows the change under the cursor without waiting for a refocus.
	de.glass_alpha = ClampI64(wg->val, 40, 255);
	if (gr.translucent_task)
		gr.translucent_alpha = de.glass_alpha;
	de.cfg_dirty = TRUE;
}

U0 DESettingsStats(CDEWidget *wg)
{
	de.stats_enable = wg->checked;
	de.cfg_dirty = TRUE;
}

U0 DESettingsSysLog(CDEWidget *wg)
{
	DESysLogShow(wg->checked);
	de.cfg_dirty = TRUE;
}

CDEWidget *de_settings_font_lbl = NULL;

U0 DESettingsFont(CDEWidget *wg)
{//Cell height for the next boot. The running cell size is frozen into every
//compiled file, so this cannot take effect until reboot.
	if (de.font_h == 16)
		de.font_h = 8;
	else
		de.font_h = 16;
	de.cfg_dirty = TRUE;
	DEConfigSave;
	StrPrint(wg->text, "Font %dx%d", KFONT_WIDTH, de.font_h);
	if (de_settings_font_lbl)
	{
		if (de.font_h == FontH)
			StrPrint(de_settings_font_lbl->text, "Cell: %dx%d", FontW, FontH);
		else
			StrPrint(de_settings_font_lbl->text, "Cell: %dx%d -> %dx%d on reboot",
					 FontW, FontH, KFONT_WIDTH, de.font_h);
	}
}

U0 DESettingsPalette(CDEWidget *wg)
{//Own task: the editor runs its own key loop. PopUp with no parent closes the
//whole task when it exits instead of leaving a terminal behind.
	no_warn wg;
	PopUp("Cd(\"::/Home/PaletteEditor\");;ExeFile(\"Run\");");
}

U0 DESettingsPickWall(CDEWidget *wg)
{
	U8 *file = DEPickFile("::/DE", "Select Image");

	if (file)
	{//Any format DEImageRead handles: PNG, JPG, GIF, WEBP, TGA.
		DEWallpaperLoad(file);
		Free(file);
		de.cfg_dirty = TRUE;
	}
}

U0 DESettingsReloadWall(CDEWidget *wg)
{
	DEWallpaperLoad("::/DE/Wallpaper.PNG");
	de.cfg_dirty = TRUE;
}

U0 DESettingsGradient(CDEWidget *wg)
{//Load a name that never resolves -> procedural gradient fallback.
	DEWallpaperLoad("::/DE/NoSuchWallpaper.PNG");
	de.cfg_dirty = TRUE;
}

U0 DESettingsStopDE(CDEWidget *wg)
{
	de_settings_done = TRUE;
	DEStop;
}

U0 DESettingsExit(CDEWidget *wg)
{
	de_settings_done = TRUE;
}

U0 DESettingsVolume(CDEWidget *wg)
{
	DEVolApply(wg->val);
}

U8 *DESettingsBootSrcName()
{
	switch (sys_boot_src.u16[0])
	{
		case BOOT_SRC_ROM:			return "ROM";
		case BOOT_SRC_RAM:			return "RAM";
		case BOOT_SRC_HARDDRIVE:	return "Hard drive";
		case BOOT_SRC_DVD:			return "DVD";
		default:					return "Unknown";
	}
}

Bool DESettingsPatchLine(U8 **psrc, I64 *psize, U8 *prefix, U8 *newline)
{//Replace the full source line that starts with prefix.
	U8	*src = *psrc, *p, *eol, *out;
	I64	 pre, post, nlen, old_len;

	p = StrFind(prefix, src);
	if (!p)
		return FALSE;
	eol = p;
	while (*eol && *eol != '\n' && *eol != '\r')
		eol++;
	old_len = eol - p;
	nlen = StrLen(newline);
	pre = p - src;
	post = *psize - (eol - src);
	out = MAlloc(pre + nlen + post + 1);
	MemCopy(out, src, pre);
	MemCopy(out + pre, newline, nlen);
	MemCopy(out + pre + nlen, eol, post);
	out[pre + nlen + post] = 0;
	Free(src);
	*psrc = out;
	*psize = pre + nlen + post;

	return TRUE;
}

Bool DESettingsWriteRes(I64 w, I64 h)
{//Rewrite REQUESTED_SCREEN_* in KStart16.ZC. Returns TRUE on success.
	I64	 size;
	U8	*src, line[96];

	src = FileRead(DE_SETTINGS_KSTART, &size);
	if (!src)
		return FALSE;
	StrPrint(line, "REQUESTED_SCREEN_WIDTH:\t\tDU16\t%d;", w);
	if (!DESettingsPatchLine(&src, &size, "REQUESTED_SCREEN_WIDTH:", line))
	{
		Free(src);
		return FALSE;
	}
	StrPrint(line, "REQUESTED_SCREEN_HEIGHT:\tDU16\t%d;", h);
	if (!DESettingsPatchLine(&src, &size, "REQUESTED_SCREEN_HEIGHT:", line))
	{
		Free(src);
		return FALSE;
	}
	FileWrite(DE_SETTINGS_KSTART, src, size);
	Free(src);

	return TRUE;
}

U0 DESettingsPickRes(CDEWidget *wg)
{
	U8			 list[1024], *wp = list, item[48];
	I64			 i, sel, n = 0;
	CVideoInfo	*info;

	for (i = 0; i < VBE_MODES_NUM; i++)
	{
		info = &sys_framebuffer_list[i];
		if (info->height)
		{
			de_settings_modes_w[n] = info->width;
			de_settings_modes_h[n] = info->height;
			if (info->width == sys_framebuffer_width &&
				info->height == sys_framebuffer_height)
				StrPrint(item, "%d x %d (current)", info->width, info->height);
			else
				StrPrint(item, "%d x %d", info->width, info->height);
			StrCopy(wp, item);
			wp += StrLen(item) + 1;
			n++;
		}
	}
	*wp = 0;
	if (!n)
	{
		PopUpOk("\n  No VBE modes in sys_framebuffer_list.\n");
		return;
	}
	sel = PopUpPickList(list);
	if (sel < 0 || sel >= n)
		return;
	de_settings_pick_w = de_settings_modes_w[sel];
	de_settings_pick_h = de_settings_modes_h[sel];
	de_settings_picked = TRUE;
	if (de_settings_res_lbl)
		StrPrint(de_settings_res_lbl->text, "Selected: %d x %d",
				 de_settings_pick_w, de_settings_pick_h);
}

U0 DESettingsApplyRes(CDEWidget *wg)
{//Resolution needs a kernel rebuild; cell size is config only. Either can be
//pending, and both reboot.
	Bool res_chg = FALSE, font_chg = de.font_h != FontH;
	U8	 msg[192];

	no_warn wg;
	if (de_settings_picked && (de_settings_pick_w != sys_framebuffer_width ||
							   de_settings_pick_h != sys_framebuffer_height))
		res_chg = TRUE;

	if (!res_chg && !font_chg)
	{
		PopUpOk("\n  Nothing to apply.\n");
		return;
	}
	if (res_chg)
	{
		StrPrint(msg,
				 "\n  Set %d x %d?\n\n"
				 "  Patches KStart16, rebuilds Kernel\n"
				 "  via BootHDIns, then reboots.\n\n"
				 "  Continue?\n",
				 de_settings_pick_w, de_settings_pick_h);
		if (!PopUpNoYes(msg))
			return;
		DEConfigSave;			//carry a pending cell size through the rebuild
		de_settings_apply = TRUE;
		de_settings_done = TRUE;
		return;
	}
	StrPrint(msg, "\n  Cell %d x %d on next boot.\n\n  Reboot now?\n",
			 KFONT_WIDTH, de.font_h);
	if (!PopUpNoYes(msg))
		return;
	DEConfigSave;
	"$$PURPLE$$YDE Settings$$FG$$: rebooting...\n";
	Sleep(500);
	Reboot;
}

U0 DESettingsDoApply()
{//Called after widget teardown so BootHDIns can print normally.
	U8 drv;

	"\n$$PURPLE$$YDE Settings$$FG$$: writing %d x %d to %s...\n",
		de_settings_pick_w, de_settings_pick_h, DE_SETTINGS_KSTART;
	if (!DESettingsWriteRes(de_settings_pick_w, de_settings_pick_h))
	{
		PopUpOk("\n  Failed to patch KStart16.ZC.\n");
		return;
	}
	drv = blkdev.boot_drive_let;
	"$$PURPLE$$YDE Settings$$FG$$: BootHDIns('%C') - this takes a bit...\n", drv;
	In(DE_SETTINGS_BOOT_IN);
	try
		BootHDIns(drv);
	catch
	{
		PutExcept;
		PopUpOk("\n  BootHDIns failed - Kernel not installed.\n"
				"  Source was patched; fix compile errors,\n"
				"  then BootHDIns manually.\n");
		return;
	}
	"$$PURPLE$$YDE Settings$$FG$$: rebooting...\n";
	Sleep(500);
	Reboot;
}

U0 DESettingsSaver(CDEWidget *wg)
{//Toggle the demo screen saver.
	de.saver_on = wg->checked;
	if (de.saver_on)
		YDESaverOn(de.saver_mins * 60);
	else
		YDESaverOff;
	de.cfg_dirty = TRUE;
}

U0 DESettingsSaverMins(CDEWidget *wg)
{//Idle delay, in minutes.
	de.saver_mins = wg->val;
	if (de_settings_saver_lbl)
		StrPrint(de_settings_saver_lbl->text, "Starts after %d min idle",
				 de.saver_mins);
	if (de.saver_on)
		YDESaverOn(de.saver_mins * 60);	//retune the running watcher
	de.cfg_dirty = TRUE;
}

U0 DESettingsSaverTest(CDEWidget *wg)
{
	no_warn wg;
	YDEDemo;
}

public U0 DESettings()
{
	CDEWinCtx	*ctx;
	U8			 buf[STR_LEN];

	de_settings_done = FALSE;
	de_settings_apply = FALSE;
	de_settings_picked = FALSE;
	de_settings_pick_w = sys_framebuffer_width;
	de_settings_pick_h = sys_framebuffer_height;
	de_settings_res_lbl = NULL;
	de_settings_saver_lbl = NULL;

	ctx = DEWinInit("Settings", 432, 688);

	DELabel(ctx, 16, 12, "YDE Settings", TRUE);
	StrPrint(buf, "%dx%d truecolor, ZealOS core V%.02f", GR_WIDTH, GR_HEIGHT, sys_os_version);
	DELabel(ctx, 16, 26, buf);

	DEPanel(ctx, 12, 44, 408, 192);
	DELabel(ctx, 20, 50, "Appearance", TRUE);
	DESlider(ctx, 20, 64, 220, "Accent hue", 0, 359, de_theme.hue, &DESettingsHue);
	DESwatch(ctx, 256, 74, 60, 16, 0);
	DESlider(ctx, 20, 104, 220, "Secondary hue", 0, 359, de_theme.hue2,
			 &DESettingsHue2);
	DESwatch(ctx, 256, 114, 60, 16, 1);
	DECheck(ctx, 20, 144, "Truecolor window chrome", gr.tc_chrome, &DESettingsChrome);
	DECheck(ctx, 20, 162, "Modern title bars", gr.tc_flat_menu, &DESettingsMenuBar);
	DECheck(ctx, 20, 180, "Glass focused window", de.glass, &DESettingsGlass);
	DESlider(ctx, 250, 168, 160, "Opacity", 40, 255, de.glass_alpha,
			 &DESettingsGlassAlpha);
	DESlider(ctx, 250, 196, 160, "Blur", 0, 32, de.glass_blur,
			 &DESettingsGlassBlur);
	DECheck(ctx, 20, 198, "Show SysLog window",
			Bt(&sys_task->display_flags, DISPLAYf_SHOW), &DESettingsSysLog);
	DECheck(ctx, 20, 216, "Hold LMB on desktop for OS info", de.stats_enable,
			&DESettingsStats);

	DEPanel(ctx, 12, 244, 408, 60);
	DELabel(ctx, 20, 250, "Wallpaper", TRUE);
	DEButton(ctx, 20, 266, 130, 22, "Select Image...", &DESettingsPickWall);
	DEButton(ctx, 160, 266, 90,  22, "Reload",         &DESettingsReloadWall);
	DEButton(ctx, 260, 266, 100, 22, "Gradient",       &DESettingsGradient);

	DEPanel(ctx, 12, 312, 408, 44);
	DELabel(ctx, 20, 318, "Audio", TRUE);
	DESlider(ctx, 116, 318, 200, "Master volume", 0, 100, ac97.volume, &DESettingsVolume);

	DEPanel(ctx, 12, 364, 408, 88);
	DELabel(ctx, 20, 370, "Display", TRUE);
	StrPrint(buf, "Current: %d x %d", sys_framebuffer_width, sys_framebuffer_height);
	DELabel(ctx, 20, 386, buf);
	StrPrint(buf, "Selected: %d x %d", de_settings_pick_w, de_settings_pick_h);
	de_settings_res_lbl = DELabel(ctx, 20, 400, buf);
	if (de.font_h == FontH)
		StrPrint(buf, "Cell: %dx%d", FontW, FontH);
	else
		StrPrint(buf, "Cell: %dx%d -> %dx%d on reboot", FontW, FontH,
				 KFONT_WIDTH, de.font_h);
	de_settings_font_lbl = DELabel(ctx, 206, 400, buf);
	DEButton(ctx, 20, 420, 176, 22, "Choose resolution...", &DESettingsPickRes);
	DEButton(ctx, 206, 420, 130, 22, "Apply & Reboot",       &DESettingsApplyRes);
	StrPrint(buf, "Font %dx%d", KFONT_WIDTH, de.font_h);
	DEButton(ctx, 344, 420, 68, 22, buf, &DESettingsFont);

	DEPanel(ctx, 12, 460, 408, 76);
	DELabel(ctx, 20, 466, "Screen saver", TRUE);
	DECheck(ctx, 20, 482, "Enable (runs the YDE demo)", de.saver_on,
			&DESettingsSaver);
	StrPrint(buf, "Starts after %d min idle", de.saver_mins);
	de_settings_saver_lbl = DELabel(ctx, 20, 502, buf);
	DESlider(ctx, 252, 494, 150, "min", 1, 30, de.saver_mins,
			 &DESettingsSaverMins);
	DEButton(ctx, 20, 516, 90, 18, "Preview", &DESettingsSaverTest);

	DEPanel(ctx, 12, 544, 408, 80);
	DELabel(ctx, 20, 550, "System", TRUE);
	StrPrint(buf, "OS V%.02f   boot: %s", sys_os_version, DESettingsBootSrcName);
	DELabel(ctx, 20, 566, buf);
	StrPrint(buf, "FB 0x%X   %d x %d",
			 sys_framebuffer_addr, sys_framebuffer_width, sys_framebuffer_height);
	DELabel(ctx, 20, 580, buf);
	StrPrint(buf, "pitch %d   bpp %d   drive %C",
			 sys_framebuffer_pitch, sys_framebuffer_bpp, blkdev.boot_drive_let);
	DELabel(ctx, 20, 594, buf);

	DEButton(ctx, 130, 634, 150, 22, "Palette Editor...", &DESettingsPalette);
	DEButton(ctx, 12, 634, 100, 22, "Stop DE",    &DESettingsStopDE);
	DEButton(ctx, 320, 634, 100, 22, "Exit (ESC)", &DESettingsExit);

	while (!de_settings_done && DEWinPoll(ctx))
		Sleep(30);

	DEConfigSave;
	DEWinExit(ctx);
	if (de_settings_apply)
		DESettingsDoApply;
}
