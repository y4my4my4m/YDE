#define YS_CELL			17		//pixels per grid cell, model space
#define YS_DEPTH		26		//half extrusion depth, pixels
#define YS_MAXB			96		//extruded boxes; "YDE" merges down to about 20
#define YS_MAXV			(YS_MAXB * 8)
#define YS_MAXT			(YS_MAXB * 12)

//Logotype grid. The 8x8 system font is too thin to extrude - its Y leaves the
//arms one cell clear of the crossbar, which reads as a hole with depth.
#define YS_GW			9		//cells per glyph
#define YS_GH			12
#define YS_PITCH		10		//glyph origin spacing: one cell of air

U8 *ys_glyph[3] = {
	"##.....##"
	"##.....##"
	".##...##."
	".##...##."
	"..##.##.."
	"..#####.."
	"...###..."
	"...###..."
	"...###..."
	"...###..."
	"...###..."
	"...###...",

	"#######.."
	"########."
	"##....##."
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##....##."
	"########."
	"#######..",

	"#########"
	"#########"
	"##......."
	"##......."
	"##......."
	"#######.."
	"#######.."
	"##......."
	"##......."
	"##......."
	"#########"
	"#########"};


//Mesh state, same arrays every ZealOS mesh generator uses.
I64 ys_nb = 0;
I64 ys_bx0[YS_MAXB], ys_bx1[YS_MAXB], ys_by0[YS_MAXB], ys_by1[YS_MAXB];
I64 ys_face[24] = {0, 4, 6, 2,  1, 3, 7, 5,  0, 1, 5, 4,
				   2, 6, 7, 3,  0, 2, 3, 1,  4, 5, 7, 6};
I64			ys_nv = 0, ys_nt = 0;
CD3I32		ys_vert[YS_MAXV];
CMeshTri	ys_tri[YS_MAXT];
U8		   *ys_sprite = NULL;

/* ---------------- mesh ---------------- */

U0 YSRuns()
{//Sweep the grid into horizontal runs. A run directly under an identical run
//extends that box, so vertical strokes come out as slabs, not stacks of cubes.
	I64	 i, py, px, run, k, x0, x1, y0, y1;
	U8	*g;
	Bool merged;

	ys_nb = 0;
	for (i = 0; i < 3; i++)
	{
		g = ys_glyph[i];
		for (py = 0; py < YS_GH; py++)
		{
			px = 0;
			while (px < YS_GW)
			{
				if (g[py * YS_GW + px] == '#')
				{
					run = px;
					while (px < YS_GW && g[py * YS_GW + px] == '#')
						px++;
					x0 = i * YS_PITCH + run;
					x1 = i * YS_PITCH + px;
					y0 = py;
					y1 = py + 1;
					merged = FALSE;
					for (k = 0; k < ys_nb; k++)
						if (!merged && ys_bx0[k] == x0 && ys_bx1[k] == x1 &&
							ys_by1[k] == y0)
						{
							ys_by1[k] = y1;
							merged = TRUE;
						}
					if (!merged && ys_nb < YS_MAXB)
					{
						ys_bx0[ys_nb] = x0;
						ys_bx1[ys_nb] = x1;
						ys_by0[ys_nb] = y0;
						ys_by1[ys_nb] = y1;
						ys_nb++;
					}
				}
				else
					px++;
			}
		}
	}
}

U0 YSBoxEmit(I64 x0, I64 x1, I64 y0, I64 y1, I64 col)
{//One run becomes a box: 8 vertices, 12 triangles. Model space is pixels, Y
//down like the screen, +Z away from the eye.
	I64 base = ys_nv, i, f, a, b, c, d;

	if (ys_nv + 8 > YS_MAXV || ys_nt + 12 > YS_MAXT)
		return;
	for (i = 0; i < 8; i++)
	{
		if (i & 1)
			ys_vert[base + i].x = x1;
		else
			ys_vert[base + i].x = x0;
		if (i >> 1 & 1)
			ys_vert[base + i].y = y1;
		else
			ys_vert[base + i].y = y0;
		if (i >> 2 & 1)
			ys_vert[base + i].z = YS_DEPTH;
		else
			ys_vert[base + i].z = -YS_DEPTH;
	}
	ys_nv += 8;
	for (f = 0; f < 6; f++)
	{
		a = base + ys_face[f * 4];
		b = base + ys_face[f * 4 + 1];
		c = base + ys_face[f * 4 + 2];
		d = base + ys_face[f * 4 + 3];
		ys_tri[ys_nt].color   = col;
		ys_tri[ys_nt].nums[0] = a;
		ys_tri[ys_nt].nums[1] = b;
		ys_tri[ys_nt].nums[2] = c;
		ys_nt++;
		ys_tri[ys_nt].color   = col;
		ys_tri[ys_nt].nums[0] = a;
		ys_tri[ys_nt].nums[1] = c;
		ys_tri[ys_nt].nums[2] = d;
		ys_nt++;
	}
}

U0 YSMeshBuild(I64 col)
{//Runs to a real mesh, then to an SPT_MESH sprite - the same byte layout the
//sprite editor and ::/Apps/GrModels emit, so this can be pasted into a DolDoc.
	I64	 i, cx, cy;
	U8	*dst;

	YSRuns;
	cx = (3 * YS_PITCH - 1) * YS_CELL / 2;
	cy = YS_GH * YS_CELL / 2;
	ys_nv = 0;
	ys_nt = 0;
	for (i = 0; i < ys_nb; i++)
		YSBoxEmit(ys_bx0[i] * YS_CELL - cx, ys_bx1[i] * YS_CELL - cx,
				  ys_by0[i] * YS_CELL - cy, ys_by1[i] * YS_CELL - cy, col);

	if (ys_sprite)
		Free(ys_sprite);
	ys_sprite = MAlloc(sizeof(CSpriteMeshU8s) + ys_nv * sizeof(CD3I32) +
					   ys_nt * sizeof(CMeshTri) + sprite_elem_base_sizes[SPT_END],
					   sys_task);
	dst = ys_sprite;
	*dst++ = SPT_MESH;
	*dst(I32 *)++ = ys_nv;
	*dst(I32 *)++ = ys_nt;
	MemCopy(dst, ys_vert, ys_nv * sizeof(CD3I32));
	dst += ys_nv * sizeof(CD3I32);
	MemCopy(dst, ys_tri, ys_nt * sizeof(CMeshTri));
	dst += ys_nt * sizeof(CMeshTri);
	*dst++ = SPT_END;
}


U0 YDEMeshBake()
{//Generate, then bake into a source file the way ::/Apps/GrModels does:
//DocSprite writes a sprite entry plus its binary block; DocSave serialises both.
	CDoc *doc = DocNew;
	U8	 *buf;
	I64	  size;

	YSMeshBuild(ColorRGB(0xFF, 0xFF, 0xFF));
	DocPrint(doc, "//YDE logotype mesh, baked by ::/DE/MeshGen.ZC.\n");
	DocPrint(doc, "//\n");
	DocPrint(doc, "//A stock SPT_MESH sprite: open it in the sprite editor to edit the model.\n");
	DocPrint(doc, "//Per-triangle colour here is a placeholder - YDESplashRender rewrites every\n");
	DocPrint(doc, "//CMeshTri from the desktop accent hue at load.\n\n");
	DocSprite(doc, ys_sprite, "$$SP,\"<1>\",BI=%d$$");
	DocPrint(doc, "\n\nU8 *YDEMeshSprite()\n{//Sprite elems for Sprite3.\n\treturn $$IB,\"<1>\",BI=1$$;\n}\n");
	buf = DocSave(doc, &size);
	FileWrite("::/DE/YDEMesh.ZC", buf, size);
	Free(buf);
	DocDel(doc);
	"MESHBAKE %d verts %d tris %d bytes\n", ys_nv, ys_nt, size;
}

//Not run on include: this is a tool. Cd("::/DE"); ExeFile("MeshGen");
//then YDEMeshBake; rewrites YDEMesh.ZC.
