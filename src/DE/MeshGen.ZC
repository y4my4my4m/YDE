//YDE logotype mesh generator. Bakes ::/DE/YDEMesh.ZC.
//
//Not part of the DE build - a tool, the way ::/Apps/GrModels is:
//  Cd("::/DE"); ExeFile("MeshGen"); YDEMeshBake;
//
//One sprite per letter so each can spin on its own axis. Each is centred on its
//own origin; Splash.ZC translates them apart at draw time.

#define YS_CELL			17		//pixels per grid cell, model space
#define YS_DEPTH		26		//half extrusion depth, pixels
#define YS_MAXB			64		//horizontal runs per letter
#define YS_MAXV			(YS_MAXB * 8)
#define YS_MAXT			(YS_MAXB * 12)

#define YS_GW			9		//cells per glyph
#define YS_GH			12

U8 *ys_glyph[3] = {
	"##.....##"
	"##.....##"
	".##...##."
	".##...##."
	"..##.##.."
	"..#####.."
	"...###..."
	"...###..."
	"...###..."
	"...###..."
	"...###..."
	"...###...",

	"#######.."
	"########."
	"##....##."
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##.....##"
	"##....##."
	"########."
	"#######..",

	"#########"
	"#########"
	"##......."
	"##......."
	"##......."
	"#######.."
	"#######.."
	"##......."
	"##......."
	"##......."
	"#########"
	"#########"};

//Box corner k: x = k & 1, y = k >> 1 & 1, z = k >> 2 & 1. Each face lists its
//four corners in perimeter order, split into two triangles wound outward.
I64 ys_face[24] = {0, 4, 6, 2,  1, 3, 7, 5,  0, 1, 5, 4,
				   2, 6, 7, 3,  0, 2, 3, 1,  4, 5, 7, 6};

I64 ys_nb = 0;
I64 ys_bx0[YS_MAXB], ys_bx1[YS_MAXB], ys_by0[YS_MAXB], ys_by1[YS_MAXB];

I64			ys_nv = 0, ys_nt = 0;
CD3I32		ys_vert[YS_MAXV];
CMeshTri	ys_tri[YS_MAXT];

U0 YSRuns(I64 li)
{//Sweep one glyph into horizontal runs. A run directly under an identical run
//extends that box, so vertical strokes come out as slabs, not stacks of cubes.
	I64	 py, px, run, k, x0, x1, y0, y1;
	U8	*g = ys_glyph[li];
	Bool merged;

	ys_nb = 0;
	for (py = 0; py < YS_GH; py++)
	{
		px = 0;
		while (px < YS_GW)
		{
			if (g[py * YS_GW + px] == '#')
			{
				run = px;
				while (px < YS_GW && g[py * YS_GW + px] == '#')
					px++;
				x0 = run;
				x1 = px;
				y0 = py;
				y1 = py + 1;
				merged = FALSE;
				for (k = 0; k < ys_nb; k++)
					if (!merged && ys_bx0[k] == x0 && ys_bx1[k] == x1 &&
						ys_by1[k] == y0)
					{
						ys_by1[k] = y1;
						merged = TRUE;
					}
				if (!merged && ys_nb < YS_MAXB)
				{
					ys_bx0[ys_nb] = x0;
					ys_bx1[ys_nb] = x1;
					ys_by0[ys_nb] = y0;
					ys_by1[ys_nb] = y1;
					ys_nb++;
				}
			}
			else
				px++;
		}
	}
}

U0 YSBoxEmit(I64 x0, I64 x1, I64 y0, I64 y1, I64 col)
{//One run becomes a box: 8 vertices, 12 triangles. Model space is pixels, Y
//down like the screen, +Z away from the eye.
	I64 base = ys_nv, i, f, a, b, c, d;

	if (ys_nv + 8 > YS_MAXV || ys_nt + 12 > YS_MAXT)
		return;
	for (i = 0; i < 8; i++)
	{
		if (i & 1)
			ys_vert[base + i].x = x1;
		else
			ys_vert[base + i].x = x0;
		if (i >> 1 & 1)
			ys_vert[base + i].y = y1;
		else
			ys_vert[base + i].y = y0;
		if (i >> 2 & 1)
			ys_vert[base + i].z = YS_DEPTH;
		else
			ys_vert[base + i].z = -YS_DEPTH;
	}
	ys_nv += 8;
	for (f = 0; f < 6; f++)
	{
		a = base + ys_face[f * 4];
		b = base + ys_face[f * 4 + 1];
		c = base + ys_face[f * 4 + 2];
		d = base + ys_face[f * 4 + 3];
		ys_tri[ys_nt].color   = col;
		ys_tri[ys_nt].nums[0] = a;
		ys_tri[ys_nt].nums[1] = b;
		ys_tri[ys_nt].nums[2] = c;
		ys_nt++;
		ys_tri[ys_nt].color   = col;
		ys_tri[ys_nt].nums[0] = a;
		ys_tri[ys_nt].nums[1] = c;
		ys_tri[ys_nt].nums[2] = d;
		ys_nt++;
	}
}

U8 *YSLetterSprite(I64 li, I64 col)
{//One glyph as an SPT_MESH sprite blob, centred on its own origin so a spin
//about Y turns it in place. Same byte layout ::/Apps/GrModels emits.
	I64	 i, cx = YS_GW * YS_CELL / 2, cy = YS_GH * YS_CELL / 2;
	U8	*res, *dst;

	YSRuns(li);
	ys_nv = 0;
	ys_nt = 0;
	for (i = 0; i < ys_nb; i++)
		YSBoxEmit(ys_bx0[i] * YS_CELL - cx, ys_bx1[i] * YS_CELL - cx,
				  ys_by0[i] * YS_CELL - cy, ys_by1[i] * YS_CELL - cy, col);

	res = MAlloc(sizeof(CSpriteMeshU8s) + ys_nv * sizeof(CD3I32) +
				 ys_nt * sizeof(CMeshTri) + sprite_elem_base_sizes[SPT_END]);
	dst = res;
	*dst++ = SPT_MESH;
	*dst(I32 *)++ = ys_nv;
	*dst(I32 *)++ = ys_nt;
	MemCopy(dst, ys_vert, ys_nv * sizeof(CD3I32));
	dst += ys_nv * sizeof(CD3I32);
	MemCopy(dst, ys_tri, ys_nt * sizeof(CMeshTri));
	dst += ys_nt * sizeof(CMeshTri);
	*dst++ = SPT_END;

	return res;
}

U0 YDEMeshBake()
{//Bake all three letters into one source file: sprite entries plus their binary
//blocks, exactly what the sprite editor would save.
	CDoc *doc = DocNew;
	U8	 *buf, *s1, *s2, *s3;
	I64	  size;

	s1 = YSLetterSprite(0, ColorRGB(0xFF, 0xFF, 0xFF));
	s2 = YSLetterSprite(1, ColorRGB(0xFF, 0xFF, 0xFF));
	s3 = YSLetterSprite(2, ColorRGB(0xFF, 0xFF, 0xFF));

	DocPrint(doc, "//YDE logotype mesh, baked by ::/DE/MeshGen.ZC.\n");
	DocPrint(doc, "//\n");
	DocPrint(doc, "//Three stock SPT_MESH sprites, one per letter, each centred on its own\n");
	DocPrint(doc, "//origin so it spins in place. Open them in the sprite editor to edit.\n");
	DocPrint(doc, "//Per-triangle colour is a placeholder - YDESplashRender repaints every\n");
	DocPrint(doc, "//CMeshTri from the desktop accent hue at load.\n\n");
	DocSprite(doc, s1, "$$SP,\"<1>\",BI=%d$$");
	DocPrint(doc, "\n");
	DocSprite(doc, s2, "$$SP,\"<2>\",BI=%d$$");
	DocPrint(doc, "\n");
	DocSprite(doc, s3, "$$SP,\"<3>\",BI=%d$$");
	DocPrint(doc, "\n\nU8 *YDEMeshY()\n{\n\treturn $$IB,\"<1>\",BI=1$$;\n}\n\n");
	DocPrint(doc, "U8 *YDEMeshD()\n{\n\treturn $$IB,\"<2>\",BI=2$$;\n}\n\n");
	DocPrint(doc, "U8 *YDEMeshE()\n{\n\treturn $$IB,\"<3>\",BI=3$$;\n}\n");

	buf = DocSave(doc, &size);
	FileWrite("::/DE/YDEMesh.ZC", buf, size);
	Free(buf);
	Free(s1);
	Free(s2);
	Free(s3);
	DocDel(doc);
	"MESHBAKE %d bytes\n", size;
}
