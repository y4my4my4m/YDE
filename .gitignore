# VM / build artifacts
build/*.iso
build/*.ISO
build/*.qcow2
build/*.vdi
build/*.vmdk
build/AUTO.ISO
build/limine/
zealbooter/bin/
zealbooter/obj/

# Temp files
*.MAP
src/Tmp/

# Zinc JS test actuals: written in the VM by JsTestRun for host-side diffing,
# and pulled back into src/ by "sync.sh repo". The .OUT expectations are the
# committed artifact; these are per-run output.
src/Home/Net/Programs/Zinc/Tests/*.GOT

# Quake game data (shareware PAK, redistributable but not source)
src/Apps/Quake/id1/*.PAK
src/Apps/Quake/id1/*.pak

# Quake per-machine state: preferences, savegames, and the debug log.
# None of this is source and all of it differs per user.
src/Apps/Quake/QUAKECFG.TXT
src/Apps/Quake/QUAKELOG.TXT
src/Apps/Quake/*.SAV

# Half-Life game data. Unlike the Quake shareware PAK none of this is
# redistributable, so the whole game directory stays out.
src/Apps/HL1/valve/
src/Apps/HL1/gearbox/
src/Apps/HL1/bshift/

# HL1 per-machine state.
src/Apps/HL1/HL1CFG.TXT
src/Apps/HL1/HL1LOG.TXT
src/Apps/HL1/*.SAV

# Diablo game data - user supplies their own CD image
src/Apps/Diablo1/DIABDAT.MPQ
src/Apps/Diablo1/*.mpq
