# VM / build artifacts
build/*.iso
build/*.ISO
build/*.qcow2
build/*.vdi
build/*.vmdk
build/limine/

!build/AUTO.ISO
zealbooter/bin/
zealbooter/obj/

# Temp files
*.MAP
src/Tmp/

## yTracker music files
src/Apps/yTracker/Examples/*

# Zinc JS test actuals: written in the VM by JsTestRun for host-side diffing,
# and pulled back into src/ by "sync.sh repo". The .OUT expectations are the
# committed artifact; these are per-run output.
src/Home/Net/Programs/Zinc/Tests/*.GOT

# Quake game data (shareware PAK, redistributable but not source)
src/Apps/Quake/id1/*.PAK
src/Apps/Quake/id1/*.pak

# Quake per-machine state: preferences, savegames, and the debug log.
# None of this is source and all of it differs per user.
src/Apps/Quake/QUAKECFG.TXT
src/Apps/Quake/QUAKELOG.TXT
src/Apps/Quake/*.SAV
src/Apps/Quake/**/*

# QuakePlus (ironwail-like updated Quake engine)
src/Apps/QuakePlus/QUAKECFG.TXT
src/Apps/QuakePlus/QUAKELOG.TXT
src/Apps/QuakePlus/*.SAV
src/Apps/QuakePlus/*.sav
src/Apps/QuakePlus/*.SAV.Z
src/Apps/QuakePlus/auto.sav
src/Apps/QuakePlus/*/
src/Apps/QuakePlus/*.kpf

# Half-Life game data. Unlike the Quake shareware PAK none of this is
# redistributable, so the whole game directory stays out.
src/Apps/HL1/valve/
src/Apps/HL1/gearbox/
src/Apps/HL1/bshift/

# HL1 per-machine state.
src/Apps/HL1/HL1CFG.TXT
src/Apps/HL1/HL1LOG.TXT
src/Apps/HL1/*.SAV

# Diablo game data
src/Apps/Diablo1/DIABDAT.MPQ
src/Apps/Diablo1/*.mpq

# UT99 retail game data
src/Apps/UT99/Maps/
src/Apps/UT99/Textures/
src/Apps/UT99/Sounds/
src/Apps/UT99/Music/
src/Apps/UT99/SystemLocalized/
src/Apps/UT99/System/*.u
src/Apps/UT99/System/*.ini
src/Apps/UT99/System/*.int
src/Apps/UT99/data/
src/Apps/UT99/UT99LOG.TXT
src/Apps/UT99/*.SAV

src/Apps/OpenEmpire/Data/
src/Apps/OpenEmpire/OELOG.TXT
src/Apps/OpenEmpire/*.SAV
